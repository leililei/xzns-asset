local function GetHeXieLevel()
    local hexieLevel = launcher.HeXieLevel or 0
    if launcher.IsWeiXin then
        hexieLevel = 1
    end
    if _G.AppSetting.IsArraigned then
        hexieLevel = 3
    end
    if launcher.HeXieLevel then
        launcher.HeXieLevel = hexieLevel
    end
    if hexieLevel > 0 then
        if type(_G.CS.ResPathReplace.IsReplace) == "boolean" then
            _G.CS.ResPathReplace.IsReplace = true
        end
    end
    return hexieLevel
end

---是否和谐
_G.AppSetting.HeXieLevel = GetHeXieLevel()

