---@class HotfixMain
_G.HotfixMain = {}
local HotfixMain = _G.HotfixMain

-- 需要被加载的热修复模块
local modules = {}

local function Start()
    --_G.LogError("HotfixMain start...")
    for _, v in ipairs(modules) do
        local hotfix_module = _G.reimport(v)
        hotfix_module.Register()
    end
end

local function Stop()
    --_G.LogError("HotfixMain stop...")
    for _, v in ipairs(modules) do
        local hotfix_module = require(v)
        hotfix_module.Unregister()
    end
end

