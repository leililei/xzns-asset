--[[
-- 全局消息系统
-- 模块实例销毁时，要自动移除消息监听，不移除的话不能自动清理监听
--]]
---@class Events : Singleton
---@field GetInstance fun():Events
---@field public message Messenger message对象实列
local Events = _G.BaseClass("Events", _G.Singleton)
_G.Events = Events

function Events:__init()
    self.message = _G.Messenger.New()
end

---AddListener 添加事件
---@param event string 事件key值
---@param func function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function Events:AddListener(event, func, obj)
    _G.Guard.NotNull(obj, "参数错误： self 为必传项")
    self.message:AddListener(event, func, obj)
end

---Broadcast 派发事件
---@param ... 参数数组
function Events:Broadcast(event, ...)
    self.message:Broadcast(event, ...)
end

---Broadcast 派发事件(慎重使用: 使用pcall调用捕获异常)
---@param ... 参数数组
function Events:PcallBroadcast(event, ...)
    self.message:PcallBroadcast(event, ...)
end

---RemoveListener 移除事件
---@param event string 事件key值
---@param func function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function Events:RemoveListener(event, func, obj)
    _G.Guard.NotNull(obj, "参数错误： self 为必传项")
    if self.message ~= nil then
        self.message:RemoveListener(event, func, obj)
    end
end

---RemoveListenerByType 移除一类事件
---@param event string 事件key值
function Events:RemoveListenerByType(event)
    if not self.message.events[event] then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("RemoveListenerByType no event " .. event)
        end
        return
    end
    self.message:RemoveListenerByType(event)
end

---移除当个对象上的所有监听事件
---@param obj string 事件key值
function Events:RemoveAllListenerByObj(obj)
    self.message:RemoveAllListenerByObj(obj)
end

function Events:Dispose()
    self.message:Cleanup()
    self.message = nil
end
