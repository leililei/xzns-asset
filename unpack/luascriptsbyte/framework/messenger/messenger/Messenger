--[[
-- 消息系统
-- 使用范例：
-- local Messenger = require "Messenger"
-- TestEventCenter:AddListener(Type, callback, self) --添加监听
-- TestEventCenter:Broadcast(Type, ...) --发送消息
-- TestEventCenter:RemoveListener(Type, callback, ...) --移除监听
-- TestEventCenter:Cleanup() --清理消息中心
-- 1、模块实例销毁时，要自动移除消息监听，不移除的话不能自动清理监听
--]]
---@class Messenger 事件类
local Messenger = _G.BaseClass("Messenger")
_G.Messenger = Messenger

function Messenger:__init()
    ---@field public events table 监听的事件
    self.events = {}
end

function Messenger:Dispose()
    self.events = nil
end

---AddListener 添加事件
---@param event string 事件key值
---@param handler function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function Messenger:AddListener(event, handler, obj)
    if not event or type(event) ~= "string" then
        print("event has to be string, " .. type(event) .. " not right.")
        return
    end

    if not handler or type(handler) ~= "function" then
        print("handler has to be function, " .. type(handler) .. " not right")
        return
    end

    if not self.events[event] then
        self.events[event] = {}
    end

    -- 去重
    for _, v in pairs(self.events[event]) do
        if v.obj == obj and v.handler == handler then
            print("Aready cotains listener : " .. tostring(event))
            return
        end
    end
    local handlers = {handler = handler, obj = obj}
    table.insert(self.events[event], handlers)
end

---是否有这个事件
function Messenger:HasListener(event, handler, obj)
    if not self.events[event] then
        return false
    end
    for _, v in pairs(self.events[event]) do
        if v.obj == obj and v.handler == handler then
            return true
        end
    end
    return false
end

---Broadcast 派发事件
---@param ... 参数数组
function Messenger:Broadcast(event, ...)
    local handlers = self.events[event]
    if handlers == nil then
        return
    end
    for _, v in pairs(handlers) do
        --assert(v.handler ~= nil)
        --if self:HasListener(event, v.handler, v.obj) then
        if (... ~= nil) then
            v.handler(v.obj, ...)
        else
            v.handler(v.obj)
        end
        --end
    end
end

---Broadcast 派发事件, 使用pacll进行异常处理
function Messenger:PcallBroadcast(event, ...)
    local handlers = self.events[event]
    if handlers == nil then
        return
    end
    --整体使用pcall好过每一个handler单独使用pcall
    local ok, message
    for _, v in pairs(handlers) do
        if v and v.handler then
            ok, message = pcall(v.handler, v.obj, ...)
            if not ok then
                print("Error:", message)
            end
        else
            print("exist invalid handler: " .. tostring(event))
        end
    end
end

---RemoveListener 移除事件
---@param event string 事件key值
---@param handler function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function Messenger:RemoveListener(event, handler, obj)
    local handlers = self.events[event]
    if handlers == nil then
        return
    end
    if _G.string.IsNullOrEmpty(event) then
        error("brocast " .. event .. " has no event.")
    else
        local IsNilObj = _G.IsNil(obj)
        for k, v in pairs(handlers) do
            if (IsNilObj or v.obj == obj) and v.handler == handler then
                handlers[k] = nil
                v.obj = nil
                return k
            end
        end
    end
end

---RemoveListenerByType 移除一类事件
---@param event string 事件key值
function Messenger:RemoveListenerByType(event)
    self.events[event] = nil
end

function Messenger:Cleanup()
    self.events = {}
end

return Messenger
