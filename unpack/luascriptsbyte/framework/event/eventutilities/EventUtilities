---根据自定义的枚举值创建枚举表值
---@param enumvaluetb table @枚举值表
---@return table @初始化BaseEventEnum所需的枚举值Table的值
function CreateEventEnumValueTable(enumvaluetb)
	local valuetable = {}
	for i, v in ipairs(enumvaluetb) do
		--强制限定枚举值是字符串，方便调试查看
		valuetable[v] = v
	end
	return valuetable
end

---打印输出枚举类型的信息
---@param enumtable BaseEventEnum @枚举类
function PrintEventEnumTable(enumtable)
	print("枚举类型 = " .. enumtable.__cname)
	for k, v in pairs(enumtable.EnumValue) do
		print("[" .. k .. "] = " .. v)
	end
end
