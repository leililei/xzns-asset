print("EventListener.lua")

require "IRecycle"

---@class EventListener @事件监听数据抽象
local EventListener = _G.BaseClass("EventListener", _G.IRecycle)
---@field public EventType string @监听枚举类型
EventListener.EventType = nil
---@field public Event string @监听枚举事件
EventListener.Event = nil
---@field public Handler function @监听事件回调
EventListener.Handler = nil
---@field public Obj BaseClass @监听事件回调对象
EventListener.Obj = nil
---@field public IsOnce boolean @是否只监听一次
EventListener.IsOnce = nil

---事件监听数据构造函数
---@param eventtype string @枚举类型
---@param event string @枚举事件
---@param handler function @事件回调方法
---@param obj table @事件回调所属对象
---@param isonce boolean @是否只监听一次
function EventListener:__init(eventtype, event, handler, obj, isonce)
    -- print("EventListener:__init()")
    -- print("eventtype = ", eventtype)
    -- print("event = ", event)
    -- print("handler = ", handler)
    -- print("obj = ", obj)
    -- print("isonce = ", isonce)
    self.EventType = eventtype
    self.Event = event
    self.Handler = handler
    self.Obj = obj
    self.IsOnce = isonce
end

---EventListener出池构造函数
---@param eventtype string @枚举类型
---@param event string @枚举事件
---@param handler function @事件回调方法
---@param obj table @事件回调所属对象
---@param isonce boolean @是否只监听一次
function EventListener:OnInit(eventtype, event, handler, obj, isonce)
    self.EventType = eventtype
    self.Event = event
    self.Handler = handler
    self.Obj = obj
    self.IsOnce = isonce
end

---EventListener进池析构函数
function EventListener:OnDispose()
    self.EventType = nil
    self.Event = nil
    self.Handler = nil
    self.Obj = nil
    self.IsOnce = nil
end

---@type EventListener
_G.EventListener = EventListener

return EventListener
