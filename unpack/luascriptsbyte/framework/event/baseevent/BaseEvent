require "EventListener"

---@class BaseEvent @事件类型基类抽象
---@field protected EventsListener table @事件监听Map
local BaseEvent = _G.BaseClass("BaseEvent")
BaseEvent.EventsListener = nil

---BaseEvent构造函数
function BaseEvent:__init(...)
    self.EventsListener = {}
end

---添加事件监听
---@param enumclass BaseEvent @枚举类
---@param event string @枚举事件
---@param handler function @事件回调方法
---@param obj table @事件回调所属对象(默认值nil)
---@param isonce boolean @是否只监听一次(默认值false)
---@return boolean @是否监听事件成功
function BaseEvent:AddListener(enumclass, event, handler, obj, isonce)
    assert(
        enumclass and event and handler,
        string.format("枚举类或枚举事件和事件回调不允许传空，监听事件失败enumclass:%s event:%s handler:%s!", enumclass, event, handler)
    )
    --参数默认值
    obj = obj or nil
    isonce = isonce or false
    if not _G.IsClass(enumclass, _G.BaseEventEnum) then
        print("传递了无效的枚举类，监听事件失败!")
        return false
    elseif (not _G.IsString(event)) or (not _G.IsFunction(handler)) then
        print("传递了无效的枚举事件或无效的回调方法!")
        return false
    end
    --print_table(self.EventsListener)
    -- 检查是否重复监听
    if self.EventsListener[enumclass.__cname] and self.EventsListener[enumclass.__cname][event] then
        for k, v in pairs(self.EventsListener[enumclass.__cname][event]) do
            if v.Handler == handler and v.Obj == obj then
                -- 事件监听允许修改是否监听只监听数据但不允许重复监听
                if v.IsOnce ~= isonce then
                    print(
                        "已监听事件类型 : ",
                        enumclass.__cname,
                        " 事件 : ",
                        event,
                        "，修改监听从IsOnce : ",
                        v.IsOnce,
                        "到",
                        isonce,
                        "!"
                    )
                    v.IsOnce = isonce
                    return false
                else
                    print("重复监听事件类型 : ", enumclass.__cname, " 事件 : ", event, " IsOnce : ", v.IsOnce, "，监听失败!")
                    return false
                end
            end
        end
    end

    if not self.EventsListener[enumclass.__cname] then
        self.EventsListener[enumclass.__cname] = {}
    end
    if not self.EventsListener[enumclass.__cname][event] then
        self.EventsListener[enumclass.__cname][event] = {}
    end

    -- 监听对应事件
    local eventlistener =
        _G.ObjectPool:GetInstance():Pop(_G.EventListener, enumclass.__cname, event, handler, obj, isonce)
    table.insert(self.EventsListener[enumclass.__cname][event], eventlistener)
    --print("监听事件类型 : ", enumclass.__cname, " 事件 : ", event, " IsOnce : ", isonce, "，监听成功!")
    return true
end

---分发事件
---@param enumclass BaseEvent @枚举类
---@param event string @枚举事件
---@param ... any @事件参数
function BaseEvent:DispatchEvent(enumclass, event, ...)
    assert(enumclass and event, "枚举类或枚举事件不允许传空，分发事件失败!")
    --print("BaseEvent:DispatchEvent(", enumclass.__cname, ",", event, ..., ")")
    if not _G.IsClass(enumclass, _G.BaseEventEnum) then
        print("传递了无效的枚举类，分发事件失败!")
        return false
    elseif (not _G.IsString(event)) then
        print("传递了无效的枚举事件，分发事件失败!")
        return false
    end
    if self.EventsListener[enumclass.__cname] and self.EventsListener[enumclass.__cname][event] then
        local eventlisteners = self.EventsListener[enumclass.__cname][event]
        local eventlisnterlength = #eventlisteners
        -- local needremove = false
        for i = eventlisnterlength, 1, -1 do
            if eventlisteners[i].Obj then
                eventlisteners[i].Handler(eventlisteners[i].Obj, ...)
            else
                eventlisteners[i].Handler(...)
            end
            if eventlisteners[i] ~= nil and eventlisteners[i].IsOnce then
                --print("移除单次监听事件: ", "枚举类型: ", enumclass.__cname, "枚举事件: ", eventlisteners[i].Event, "监听回调: ", eventlisteners[i].Obj, eventlisteners[i].Handler)
                _G.ObjectPool:GetInstance():Push(eventlisteners[i])
                table.remove(eventlisteners, i)
            --print("移除单次监听事件后监听长度:", #eventlisteners)

            -- local neweventlistenerlength = #eventlisteners
            -- if neweventlistenerlength == 0 then
            --     needremove = true
            -- end
            end
        end
    -- if needremove then
    --     print("枚举类型: ", enumclass.__cname, "枚举事件: ", event, "不再有有效监听,清除Event:", event, "监听表!")
    --     self.EventsListener[enumclass.__cname][event] = nil
    -- end
    end
    return true
end

---判定是否已经监听特定事件
---@param enumclass BaseEvent @枚举类
---@param event string @枚举事件
---@param handler function @事件回调方法
---@param obj table @事件回调所属对象(默认值nil)
---@return boolean @是否已监听指定事件
function BaseEvent:HasListener(enumclass, event, handler, obj)
    assert(
        enumclass and event and handler,
        string.format("枚举类:%s或枚举事件:%s和事件回调:%s不允许传空，判定事件监听失败!", enumclass.__cname, event, handler)
    )
    obj = obj or nil
    --print("枚举信息:", "enumclass.__cname = ", enumclass.__cname, " event = ", event)
    if not _G.IsClass(enumclass, _G.BaseEventEnum) then
        print("传递了无效的枚举类，判定事件监听失败!")
        return false
    elseif (not _G.IsString(event)) or (not _G.IsFunction(handler)) then
        print("传递了无效的枚举事件或无效的回调方法，判定监听事件失败!")
        return false
    end
    if self.EventsListener[enumclass.__cname] and self.EventsListener[enumclass.__cname][event] then
        for k, v in pairs(self.EventsListener[enumclass.__cname][event]) do
            if v.Handler == handler and v.Obj == obj then
                return true
            end
        end
    end
    return false
end

---移除事件监听
---@param enumclass BaseEvent @枚举类
---@param event string @枚举事件
---@param handler function @事件回调方法
---@param obj table @事件回调所属对象(默认值nil)
---@return boolean @是否移除事件监听成功
function BaseEvent:RemoveListener(enumclass, event, handler, obj)
    assert(enumclass and event, "枚举类或枚举事件不允许传空，移除事件失败!")
    --参数默认值
    obj = obj or nil
    --print("BaseEvent:RemoveListener(", enumclass.__cname, event, ")")
    if not _G.IsClass(enumclass, _G.BaseEventEnum) then
        print("传递了无效的枚举类，移除事件失败!")
        return false
    elseif (not _G.IsString(event)) then
        print("传递了无效的枚举事件，移除事件失败!")
        return false
    end
    if self.EventsListener[enumclass.__cname] and self.EventsListener[enumclass.__cname][event] then
        -- if needremove then
        --     print("枚举类型: ", enumclass.__cname, "枚举事件: ", event, "不再有有效监听,清除Event:", event, "监听表!")
        --     self.EventsListener[enumclass.__cname][event] = nil
        -- end
        local eventlisteners = self.EventsListener[enumclass.__cname][event]
        local eventlisnterlength = #eventlisteners
        -- local needremove = false
        for i = eventlisnterlength, 1, -1 do
            ---@type EventListener
            local eventlistener = eventlisteners[i]
            if eventlistener.Obj == obj and eventlistener.Handler == handler then
                --print("移除监听事件: ", eventlistener.Event, "监听对象: ", eventlistener.Obj, "监听回调:", eventlistener.Handler)
                _G.ObjectPool:GetInstance():Push(eventlistener)
                table.remove(eventlisteners, i)
            --print("移除监听事件后监听长度:", #eventlisteners)

            -- local neweventlistenerlength = #eventlisteners
            -- if neweventlistenerlength == 0 then
            --     needremove = true
            -- end
            end
        end
    else
        print("未监听枚举类型:", enumclass.__cname, "枚举事件:", event, ",移除监听失败!")
    end
end

---清除所有事件监听
function BaseEvent:RemoveAllListeners()
    --print("BaseEvent:RemoveAllListeners()")
    self.EventsListener = {}
end

---打印所有事件监听信息
function BaseEvent:printAllEventsLisntener()
    print("BaseEvent:printAllEventsLisntener()")
    for k, v in pairs(self.EventsListener) do
        for k2, v2 in pairs(v) do
            print("事件类型:", k, " 事件: ", k2)
            for i, v3 in ipairs(v2) do
                ---@type EventListener
                local eventlistener = v3
                print(
                    "已监听事件: ",
                    eventlistener.Event,
                    "监听对象: ",
                    eventlistener.Obj,
                    "监听回调: ",
                    eventlistener.Handler,
                    "是否只监听一次: ",
                    eventlistener.IsOnce
                )
            end
        end
    end
end

function BaseEvent:Dispose()
    self:RemoveAllListeners()
end

---@type BaseEvent
_G.BaseEvent = BaseEvent

---@type BaseEvent
return BaseEvent
