--懒加载
_G.require = require "lazyRequire"

if _G.AppSetting.IS_EDITOR then
    _G.CS.XLuaManager.LuaReimport = function(filename)
        local old_content
        local old_view
        local viewname
        if package.loaded[filename] then
            -- 把旧的模块保存起来
            old_content = package.loaded[filename]
            -- 然后package.loaded[filename]赋空
            package.loaded[filename] = nil
            viewname = Component.CheckView(filename)
            if nil ~= viewname then
                -- 把旧的模块保存起来
                old_view = package.loaded[viewname]
                -- 然后package.loaded[filename]赋空
                package.loaded[viewname] = nil
            end
        end

        -- xpcall下执行require
        local ok, err = pcall(require, filename)
        if not ok then
            --热更失败，将旧值赋回去
            print("hotfix fail, err msg ", err)
            package.loaded[filename] = old_content
            return false
        end
        if nil ~= viewname then
            ok, err = pcall(require, viewname)
            if not ok then
                --热更失败，将旧值赋回去
                print("hotfix fail, err msg ", err)
                package.loaded[viewname] = old_view
                return false
            end
        end

        return true
    end
end

function _G.CollectGarbageLua()
    if _G.AppSetting.DEBUG then
        _G.Log("<color=red><size=25>" .. "全局GC调用>>>>>>>>>>" .. "</size></color>")
    end
    _G.CS.ResourceLoad.ResourceManager.Instance:ReleaseInIdle()
    collectgarbage("collect")
end

