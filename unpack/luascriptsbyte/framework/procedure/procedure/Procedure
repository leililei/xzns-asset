---@class Procedure 流程控制
---@field public fsm Fsm 状态机实例
---@field public initial string 初始流程
---@field public final string 结束流程
---@field public pros table 流程数据
---@field public change_handler function 流程改变回调
---@field public final_handler function 最终流程回调
local Procedure = _G.BaseClass("Procedure")
_G.Procedure = Procedure

function Procedure:__init()
    self.fsm = _G.Fsm.New()
    self.initial = ""
    self.final = ""
    self.pros = {}
    self.change_handler = nil
    self.final_handler = nil
end

function Procedure:Dispose()
    self.fsm:Dispose()
    self.initial = nil
    self.final = nil
    self.pros = nil
    self.change_handler = nil
    self.final_handler = nil
end

---StartInitialize 初始化状态机
---@param initial string 初始流程
---@param final string 结束流程
---@param pros table 流程数据
---@param change_handler function 流程改变回调
---@param final_handler function 最终流程回调
function Procedure:StartInitialize(initial, final, pros, change_handler, final_handler)
    self.initial = initial
    self.final = final
    self.pros = pros
    self.change_handler = change_handler
    self.final_handler = final_handler

    for _, v in pairs(self.pros) do
        v.name = v.from
    end
    table.insert(self.pros, {name = final, from = final})

    local par = {
        -- 初始流程
        initial = self.initial,
        -- 流程数据
        events = self.pros,
        --final = self.final,
        -- callbacks
        callbacks = {
            onchangestate = _G.handler(self, self.ChangeHandler)
        }
    }
    self.fsm:setupState(par)
end

---DoProcedure 执行流程
---@param pro string 执行流程状态值
function Procedure:DoProcedure(pro)
    return self.fsm:doEvent(pro)
end

---IsFinishedProcedure 当前当前流程如果是最终流程，则返回true
function Procedure:IsFinishedProcedure()
    return self:IsProcedure(self.final)
end

---IsProcedure 获取当前流程是否是参数procedure流程
---@param pro string 执行流程状态值
function Procedure:IsProcedure(pro)
    return self.fsm:isState(pro)
end

---GetProcedure 获取当前流程
function Procedure:GetProcedure()
    return self.fsm:getState()
end

---ChangeHandler 切换流程回调事件
---@param event table 返回的状态table
function Procedure:ChangeHandler(event)
    if not _G.IsNil(self.change_handler) then
        self.change_handler(event)
    end

    if self:IsFinishedProcedure() then
        if not _G.IsNil(self.final_handler) then
            self.final_handler(event)
        end
    end
end

--endregion
