---GetTable
---@param key string
---@param isNotRoleKey boolean 默认/false 加上角色uid  (true 登陆界面历史账号 不需要角色uid为key)
---@return table
function PlayerPrefsManager.GetTable(key, isNotRoleKey)
    if nil == isNotRoleKey then
        isNotRoleKey = false
    end
    if not isNotRoleKey then
        key = GetKey(key)
    end
    _G.Guard.NotEmptyOrNull(key)
    local readStr = WXPlayerPrefs.GetString(key)
    local tbl
    if readStr and readStr ~= "" then
        local ret, errMessage = pcall(json.decode, readStr)
        if ret ~= false then
            tbl = errMessage
        else
            return nil
        end
    else
        return nil
    end

    local tb2 = {}
    if tbl then
        for index, value in ipairs(tbl) do
            if value and #value >= 2 and value[1] ~= nil and value[2] ~= nil then
                tb2[value[1]] = value[2]
            end
        end
    end

    if tbl and tb2 then
        return tb2
    end
    return nil
end

---SetTable
---@param key string
---@param value table
---@param isNotRoleKey boolean 默认/false 加上角色uid  (true 登陆界面历史账号 不需要角色uid为key)
function PlayerPrefsManager.SetTable(key, value, isNotRoleKey)
    if nil == isNotRoleKey then
        isNotRoleKey = false
    end
    if not isNotRoleKey then
        key = GetKey(key)
    end
    _G.Guard.NotEmptyOrNull(key)
    local tb = {}
    if value then
        for k, v in pairs(value) do
            table.insert(tb, {k, v})
        end
    end
    local ret, errMessage = pcall(json.encode, tb)
    if ret ~= false then
        WXPlayerPrefs.SetString(key, errMessage)
    end
end

---HasKey
---@param key string
---@return boolean
function PlayerPrefsManager.HasKey(key, isNotRoleKey)
