---@class PlayerPrefsManager 本地数据读写管理器,调用Unity PlayerPrefs API中的接口
_G.PlayerPrefsManager = {}
local PlayerPrefsManager = _G.PlayerPrefsManager

local WXPlayerPrefs = _G.CS.WechatGameCore.PlayerPrefs

--新增UID作为key值,区别PC上不同账号的数据
local function GetKey(key)
    if _G.PlayerModel and _G.PlayerModel:GetInstance().role_uid then
        key = key .. _G.tostring(_G.PlayerModel:GetInstance().role_uid)
        if _G.AppSetting.IS_EDITOR then
            _G.PlayerModel:GetInstance():AddPrefsKey(key)
        end
    end
    return key
end

---GetFloat
---@param key string
---@return number
function PlayerPrefsManager.GetFloat(key, isNotRoleKey)
    if not isNotRoleKey then
        key = GetKey(key)
    end
    _G.Guard.NotEmptyOrNull(key)
    return WXPlayerPrefs.GetFloat(key)
end

---SetFloat
---@param key string
---@param value number
function PlayerPrefsManager.SetFloat(key, value, isNotRoleKey)
    if not isNotRoleKey then
        key = GetKey(key)
    end
    _G.Guard.NotEmptyOrNull(key)
    WXPlayerPrefs.SetFloat(key, value)
end

---GetInt
---@param key string
---@param default number 如果key无记录 则返回该默认参数
---@return number
function PlayerPrefsManager.GetInt(key, default, isNotRoleKey)
    if default == nil then
        default = 0
    end
    if not isNotRoleKey then
        key = GetKey(key)
    end
    _G.Guard.NotEmptyOrNull(key)
    return WXPlayerPrefs.GetInt(key, default)
end

---SetInt
---@param key string
---@param value number
function PlayerPrefsManager.SetInt(key, value, isNotRoleKey)
    if not isNotRoleKey then
        key = GetKey(key)
    end
    _G.Guard.NotEmptyOrNull(key)
    WXPlayerPrefs.SetInt(key, value)
end

