---@class BaseGameProxy : Singleton 通信基类
---@field private MessageListenerMap table<string, function> @消息监听Map(单个模块类默认一个消息只有一个响应方法)
local BaseGameProxy = _G.BaseClass("BaseGameProxy", _G.Singleton)
BaseGameProxy.OriginSend = {}
BaseGameProxy.OriginReceive = {}
BaseGameProxy.MessageListenerMap = nil

---类的构造函数
function BaseGameProxy:__init()
    self.MessageListenerMap = {}
    self.Call = {}
    self:AddMessageListeners()
    -- 单机版本
    self.numberID = 0

    if _G.AppSetting.DEBUG then
        _G.LogWarning("[BaseGameProxy] init")
    end
end

---发送请求
---@param netMapItem NetMapItem 通信协议数据
---@param pbData table PB数据
---@param callOK function 完成回调
---@return number 流水号
function BaseGameProxy:Access(netMapItem, pbData, callOK)
    self.numberID = self.numberID + 1

    local cmd = netMapItem.Cmd
    if callOK ~= nil and self.MessageListenerMap[cmd] ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("[BaseGameProxy] Access " .. cmd .. " 流水号 = " .. self.numberID)
        end

        local cmd = self.MessageListenerMap[cmd]
        local netData = cmd.CallBack(pbData)
        coroutine.start(_G.handler(self, self.ProxyCallBack), callOK, self.numberID, netData, cmd.CallWaitTime, nil)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("Can't find msgid " .. cmd)
        end
    end

    return self.numberID
end

function BaseGameProxy:ProxyCallBack(callOK, id, param, waitTime, error)
    if waitTime ~= nil then
        _G.coroutine.waitforseconds(waitTime)
    else
        _G.coroutine.waitforseconds(0.1)
    end

    if _G.AppSetting.DEBUG then
        _G.LogWarning("[BaseGameProxy] ProxyCallBack 流水号 = " .. id)
    end
    callOK(id, param, error)
end

---返回一个通用的发送空PB
---@return public.EmptyPB 返回一个通用的发送空PB
function BaseGameProxy:GetEmptyPB()
    local pbData = {}
    pbData.reserved = ""
    return pbData
end

---添加所有后端主动推的网络消息监听接口(子类重写)
function BaseGameProxy:AddMessageListeners()
end

---添加指定网络消息监听
---@param cmd string @消息CMD
---@param receavData function @返回消息
function BaseGameProxy:AddMessageListener(cmd, receavData)
    if self.MessageListenerMap[cmd] ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(string.format("__cname:%s覆盖监听消息:%s!", self.__cname, cmd))
        end
    end
    self.MessageListenerMap[cmd] = receavData
end

---移除指定网络消息监听
---@param cmd string @消息CMD
---@return boolean @是否移除消息成功
function BaseGameProxy:RemoveMessageListener(cmd)
    if self.MessageListenerMap[cmd] ~= nil then
        self.MessageListenerMap[cmd] = nil
        return true
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("__cname:%s未监听消息:%s,移除监听失败!", self.__cname, cmd))
        end
        return false
    end
end

---移除所有网络消息监听
function BaseGameProxy:RemoveAllMessageListeners()
    --for k, v in pairs(self.MessageListenerMap) do
    --EventsSingleton:RemoveListener(k, v, self)
    --end
end

---类的析构函数
function BaseGameProxy:Dispose()
    self:RemoveAllMessageListeners()
    self.MessageListenerMap = {}
    self.Call = nil
    BaseGameProxy.OriginSend = {}
    BaseGameProxy.OriginReceive = {}
end

---@type BaseMessage
_G.BaseGameProxy = BaseGameProxy
---@type BaseMessage
return BaseGameProxy
