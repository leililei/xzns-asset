---@field CmdDic table<number,NetSendData> 执行通信时，接收到服务器数据的响应函数字典
local NetPortDic = ReceiveMsgManagerCsListener.NetPortDic

---@field BroadcastDic table<int,string> 服务器推送响应的PB解析字典,用于本地缓存快速查找
local NetPushDic = {}

---FindProtoPushMsg 通过PBCmd找到对应的服务器推送解析cmd的所有信息
---@param cmd int
---@return net_map
local function FindProtoPushMsg(cmd)
    if NetPushDic[cmd] then
        return NetPushDic[cmd]
    end

    for _, v in pairs(_G.ConfigManager.net_map) do
        if v.PBCmd == cmd then
            NetPushDic[cmd] = v
            return v
        end
    end
    _G.LogFatal("Dont Find this Push Cmd:          " .. cmd)
end

---是否为充值成功推送
---@param cmd int
---@return boolean
local function IsCashPushMsg(cmd)
    local protocol = _G.ConfigManager.net_map.store_cash
    return protocol and cmd == protocol.PBCmd
end

