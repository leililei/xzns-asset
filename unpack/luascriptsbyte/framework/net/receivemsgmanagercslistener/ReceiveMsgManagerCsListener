---CSCallLuaReciveNetSend 接收返回消息时的回调,使用Cmd和流水号验证
---@param PBcmd int
---@param port number 流水号
---@param bytes string Proto信息正文
---@param sign int 表示connect表示，多连接的时候用
function ReceiveMsgManagerCsListener.CSCallLuaReciveNetSend(PBcmd, port, bytes, sign)
    if sign ~= _G.Net.sign then
        if _G.AppSetting.DEBUG then
            _G.Log("收到了上一个消息sign为  " .. sign .. "    当前消息为  sign为   " .. _G.Net.sign .. "    流水号为   " .. port)
        end
        return
    end
    --用cmd为0 port为0 表示连接成功
    if PBcmd == 0 and port == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("收到服务器连接成功消息   当前消息 sign 为   " .. sign .. "      时间为     " .. _G.Time.realtimeSinceStartup)
        end
        _G.Net.CloseTimer()
        _G.Net.SetLoginState(true)
        _G.Events:GetInstance():Broadcast(_G.eYKNetEvent.ConnectSuccessComplete)
        return
    end
    -- -1 表示推送  在断线过程中，不接受推送
    if port == -1 then
        if _G.GameNetTipsManager:GetInstance().mIsReconnectDataSending then
            return
        else
            _G.ReceiveMsgManagerCsListener.CSCallLuaReciveNetPush(PBcmd, bytes)
        end
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log(PBcmd, "当前Pbcmd")
    end

    ---@type NetSendData sendData
    local sendData = NetPortDic[port]
    if sendData then
        --- NetPortDic 清理发送的数据
        NetPortDic[port] = nil
        ---65501 固定错误id
        if PBcmd == 65501 then
            -- 系统错误提示
            -- _G.PopWindowManager:GetInstance():ShowAllTips(1001,_G.ConfigManager.tips_system_cfg[errorPB.code].content)
            local errorNet
            if _G.AppSetting.DEBUG then
                for _, v in pairs(_G.ConfigManager.net_map) do
                    if v.PBCmd == 65501 then
                        errorNet = v
                        break
                    end
                end
                local errorPB = assert(pb.decode(errorNet.ReceivePB, bytes))
                _G.LogError(
                    errorPB,
                    string.format(
                        "<color=#FF0000><size=26>接收</size></color>>> 流水号：%s  <color=cyan><size=26>%s</size></color>  error: %s cmd : %s \n\n",
                        port,
                        errorNet.Cmd,
                        _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[errorPB.code].content),
                        sendData.pbMap.Cmd
                    )
                )
                --镇魂街ZHJ-31230 【主任务】beta_0.2.0_jttw贪玩三测ZHJ-32870
                --【客户端】容错提示隐藏
                if 3703 ~= errorPB.code then
                    _G.PopWindowManager:GetInstance():ShowAllTips(
                        1001,
                        _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[errorPB.code].content)
                    )
                end
            end
            -- 这里直接抛出发送的cmd，用去取消蒙版，其实，这里的弹窗应该返回登录界面
            _G.Events:GetInstance():Broadcast(_G.eYKNetEvent.ReceiveMsg, sendData.pbMap.Cmd, port)
        elseif sendData.cmd == _G.Net.pingCmd then
            if _G.AppSetting.DEBUG then
                _G.Log("收到了心跳包", "<color=red>" .. "流水号 " .. port .. "</color>")
            end
        else
            local npbcmd
            if PBcmd == 65500 then
                npbcmd = sendData.pbMap.ReceivePB
            elseif PBcmd == sendData.pbMap.Cmd then
                npbcmd = sendData.pbMap.ReceivePB
            else
                for _, v in pairs(_G.ConfigManager.net_map) do
                    if v.PBCmd == PBcmd then
                        npbcmd = v.ReceivePB
                        break
                    end
                end
            end

            if _G.AppSetting.DEBUG then
                _G.Log(npbcmd, "准备解析消息>>>>>>>>>>>>>>>>>>")
            end
            local rePB = assert(pb.decode(npbcmd, bytes))
            if _G.AppSetting.DEBUG then
                _G.Log(
                    rePB,
                    string.format(
                        "<color=#00FF7F>收到消息</color>>> 流水号：%s  <color=cyan>%s</color>   消息sign  %s     消息时间为   %s\n\n",
                        port,
                        npbcmd,
                        sign,
                        _G.Time.realtimeSinceStartup
                    )
                )
            end
            ReceiveMsgManagerCsListener.MsgInfo = sendData.pbMap.Key
            -- 这里修改为消息处理完毕后，清理蒙版，而不是还没有处理完成清掉蒙版
            _G.Events:GetInstance():Broadcast(_G.eYKNetEvent.ReceiveMsg, npbcmd, port)
            _G.Events:GetInstance():Broadcast(_G.eGuideEvent.WaitFo, sendData.pbMap.PBCmd)
            if sendData.func then
                sendData.func(port, rePB, nil, sendData.pbMap.PBCmd)
            end
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(PBcmd .. "流水号    " .. port, "消息列表中未找到指定协议>>>>>>")
        end
        _G.Events:GetInstance():Broadcast(_G.eYKNetEvent.ReceiveMsg, PBcmd, port)
    end
end

CS.DataAccess.ReceiveSendHandler = ReceiveMsgManagerCsListener.CSCallLuaReciveNetSend

---CSCallLuaReciveNetPush 接收到服务器推送时的响应，注册于C#侧静态委托的Lua响应
---@param cmd int Cmd 为pbcmd，为真正传输消息的cmd
---@param bytes string
function ReceiveMsgManagerCsListener.CSCallLuaReciveNetPush(cmd, bytes)
    local msg = FindProtoPushMsg(cmd)
    local msgcmd = msg.Cmd
    if _G.AppSetting.DEBUG then
        _G.Log(string.format("<color=#00BFFF>接收服务器推送    Cmd：%s  </color>", msg.Cmd))
    end
    local decodeKey = msg.ReceivePB
    local luaTable = pb.decode(decodeKey, bytes)
    if nil == luaTable then
        if _G.AppSetting.DEBUG then
            _G.LogError(msgcmd, "推送消息异常")
        end
    end
    if _G.AppSetting.DEBUG then
        _G.Log(luaTable, "服务器推送消息内容>>>>>>")
    end
    -- SaveOrginData(cmd, "服务器推送", luaTable)
    if IsCashPushMsg(cmd) then
        -- 充值推送消息
        _G.Events:GetInstance():Broadcast(_G.MallCash.StateChange, luaTable)
    else
        ---派发事件，由各模块监听处响应
        _G.Events:GetInstance():Broadcast(msgcmd, luaTable)
    end
end

function ReceiveMsgManagerCsListener.ClearNetPortDic()
    if NetPortDic ~= nil then
        for i, _ in pairs(NetPortDic) do
            NetPortDic[i] = nil
        end
    end
end

