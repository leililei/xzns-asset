---@return public.c2s_common_empty 返回一个通用的发送空PB
function BaseGameNet:GetEmptyPB()
    -- local pbData = {}
    -- pbData.req = ""
    -- return pbData
    return ""
end

---添加所有后端主动推的网络消息监听接口(子类重写)
function BaseGameNet:AddMessageListeners()
end

---添加指定网络消息监听
---@param cmd string @消息CMD
---@param func function @消息回调
function BaseGameNet:AddMessageListener(cmd, func)
    if self.MessageListenerMap[cmd] ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(string.format("__cname:%s覆盖监听消息:%s!", self.__cname, cmd))
        end
        EventsSingleton:RemoveListener(cmd, self.MessageListenerMap[cmd], self)
    end
    self.MessageListenerMap[cmd] = func
    EventsSingleton:AddListener(cmd, func, self)
end

---移除指定网络消息监听
---@param cmd string @消息CMD
---@return boolean @是否移除消息成功
function BaseGameNet:RemoveMessageListener(cmd)
    if self.MessageListenerMap[cmd] ~= nil then
        self.MessageListenerMap[cmd] = nil
        return true
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("__cname:%s未监听消息:%s,移除监听失败!", self.__cname, cmd))
        end
        return false
    end
end

---移除所有网络消息监听
function BaseGameNet:RemoveAllMessageListeners()
    if self.MessageListenerMap then
        for k, v in pairs(self.MessageListenerMap) do
            EventsSingleton:RemoveListener(k, v, self)
        end
    end
end

---类的析构函数
function BaseGameNet:Dispose()
    self:RemoveAllMessageListeners()
    self.MessageListenerMap = {}
    self.Call = nil
    BaseGameNet.OriginSend = {}
    --BaseGameNet.OriginReceive = {}
end

---初始
function BaseGameNet:StartUp()
end

---@type BaseMessage
return BaseGameNet
