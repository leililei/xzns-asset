---超时检测
function _G.Net.UpdateMessage()
    ---@type  table<number,NetSendData>
    local netPort = ReceiveMsgManagerCsListener.GetAllNetSendData()
    if netPort ~= nil then
        local nowTime = GetNowTime()
        local istimeOut
        for _, k in pairs(netPort) do
            if k.timeOut < nowTime then
                istimeOut = true

                if _G.AppSetting.DEBUG then
                    _G.Log(
                        "当前超时消息   sign 为    " ..
                            k.sign .. "<color=red>" .. "流水号为  " .. k.sn .. "  当前时间为   " .. nowTime .. "</color>"
                    )
                end
                break
            end
        end
        if istimeOut then
            _G.Events:GetInstance():Broadcast(_G.eYKNetEvent.ConnectedDis, mIp, mPort)
        end
    end
end

---CloseAllConnects 关闭所有连接
function _G.Net.CloseAllConnects()
    if _G.AppSetting.DEBUG then
        _G.Log("关闭所有连接")
    end
    _G.Net.CloseAllTimer()
    isConnectNet = false
    isReceiveLogin = false

    if _G.AppSetting.DEBUG then
        _G.Log(" 设置了当前 isConnectNet false  ")
    end
    _G.Net.sign = 0
    connect = nil
    ---CS.GameNetBase.isReCounecting = true
    ---CS.GameNetBase.isCounectEd = false
    _G.CS.ErlConnectFactory.GetInstance():closeAllConnects()
    --这里极低的可能性有消息没有处理，默认超时就什么消息也没有收到
    -- CS.DataAccess.getInstance().clear()
    --清除消息
    ReceiveMsgManagerCsListener:ClearNetPortDic()
end

---ShowErrorTips 显示提示
---@param msgType string 返回状态
---@param content number 返回数据
function _G.Net.ShowErrorTips(msgType, content)
    if content == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(msgType, "msgType报错且content为nil,叫后台处理")
        end
        return
    end

    if msgType == "err" then
        --普通错误提示
        if type(content) == "table" then
            _G.Events:GetInstance():Broadcast(_G.eMessageNames.NetReceiveMsgError, content[1])
        else
            _G.Events:GetInstance():Broadcast(_G.eMessageNames.NetReceiveMsgError, content[0].ValueString)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("不支持的错误类型:" .. msgType)
        end
    end
end

---关闭socket超时连接监听
function _G.Net.CloseTimer()
    if timer then
        timer:Stop()
        timer = nil
    end
end

---清除所有的timer
function _G.Net.CloseAllTimer()
    if timer then
        timer:Stop()
        timer = nil
    end
    if HeartPortTimer then
        HeartPortTimer:Stop()
        HeartPortTimer = nil
    end
    if outTimeTimer then
        outTimeTimer:Stop()
        outTimeTimer = nil
    end
end
