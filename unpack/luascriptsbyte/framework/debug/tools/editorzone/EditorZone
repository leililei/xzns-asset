_G.EditorZone =
    _G.EditorZone or
    {
        Value = {}
    }

local EditorZone = _G.EditorZone

local function Mydump(_value, description)
    local fileName = description
    local value = _G.DeepCopy(_value)
    local _str

    local result = {}
    local function _v(v)
        if type(v) == "string" then
            v = '"' .. v .. '"'
        end

        if type(v) == "number" then
            v = "" .. v .. ""
        end

        if type(v) == "function" then
            return nil
        end

        if type(v) == "userdata" then
            return nil
        end

        return tostring(v)
    end

    local function _dump(value_, description_, indent, nest, keylen)
        description_ = description_ or string.format("return %s", fileName or "value")
        local spc = ""

        if type(keylen) == "number" then
            if type(_v(description_)) == "string" then
                spc = string.rep(" ", keylen - string.len(_v(description_)))
            end
        end

        if type(value_) ~= "table" then
            local keyType = type(description_)
            if keyType == "number" then
                if _v(description_) and _v(value_) then
                    result[#result + 1] = string.format("%s[%s]%s = %s,", indent, _v(description_), spc, _v(value_))
                end
            elseif keyType == "string" then
                if _v(description_) and _v(value_) then
                    local key = "[" .. _v(description_) .. "]"
                    result[#result + 1] = string.format("%s%s%s = %s,", indent, key, spc, _v(value_))
                end
            end
        else
            result[#result + 1] = string.format("%s[%s] = {", indent, _v(description_))
            local indent2 = indent .. "    "
            local keys = {}
            local keylen_ = 0
            local values = {}
            for k, v in pairs(value_) do
                keys[#keys + 1] = k
                local vk = _v(k)
                if type(vk) == "string" then
                    local vk1 = string.len(vk)
                    if vk1 > keylen_ then
                        keylen_ = vk1
                    end
                end

                values[k] = v
            end
            table.sort(
                keys,
                function(a, b)
                    if type(a) == "number" and type(b) == "number" then
                        return a < b
                    else
                        return tostring(a) < tostring(b)
                    end
                end
            )

            for _, k in pairs(keys) do
                _dump(values[k], k, indent2, nest + 1, keylen_)
            end
            result[#result + 1] = string.format("%s},", indent)
        end
    end
    _dump(value, description, "", 1)
    _str = table.concat(result, "\n")
    return _str
end

function EditorZone.Dofile(filePath)
    if filePath then
        dofile(filePath)
    end
end

function EditorZone:Get(k)
    if not self.Value[k] then
        error(k .. "is nil")
    end
    return self.Value[k]
end

function _G.GetEditorValue(k)
    return EditorZone:Get(k)
end

function _G.DumpInFile(tbl, description)
    if (_G.AppSetting.DEBUG) then
        if _G.AppSetting.DEBUG then
            _G.Log(debug.traceback("<color=blue>" .. "dumpInFile    " .. description .. "</color>", 2))
        end
        local text = Mydump(_G.DeepCopy(tbl), description)
        local path = _G.CS.UnityEngine.Application.dataPath
        path = _G.string.replace(path, "Assets", "Logs") .. "/"
        local savePath = path .. description .. ".lua"

        _G.CS.AorIO.WriteAllText(savePath, text)
    end
end

print("<color=red><size=20>" .. "EditorZone:  loaded  " .. "</size></color>")
