local function Mydump(_value, description)
    local fileName = description
    local value = _value
    local _str

    local result = {}
    local function _v(v)
        if type(v) == "string" then
            if not string.find(v, "local") then
                v = '"' .. v .. '"'
            end
        end

        if type(v) == "number" then
            v = "" .. v .. ""
        end

        if type(v) == "function" then
            return nil
        end

        if type(v) == "userdata" then
            return nil
        end

        return tostring(v)
    end

    local function _dump(value_, description_, indent, nest, keylen)
        description_ = description_ or string.format("return %s", fileName or "value")
        local spc = ""

        if type(keylen) == "number" then
            if type(_v(description_)) == "string" then
                spc = string.rep(" ", keylen - string.len(_v(description_)))
            end
        end

        if type(value_) ~= "table" then
            local keyType = type(description_)
            if keyType == "number" then
                if _v(description_) and _v(value_) then
                    result[#result + 1] = string.format("%s[%s]%s = %s,", indent, _v(description_), spc, _v(value_))
                end
            elseif keyType == "string" then
                if _v(description_) and _v(value_) then
                    local key = "[" .. _v(description_) .. "]"
                    result[#result + 1] = string.format("%s%s%s = %s,", indent, key, spc, _v(value_))
                end
            end
        else
            -- result[#result + 1] = string.format("%s},", indent)
            local var = _v(description_)
            if string.find(var, "local") then
                result[#result + 1] = string.format("%s%s = {", indent, _v(description_))
            else
                result[#result + 1] = string.format("%s[%s] = {", indent, _v(description_))
            end

            local indent2 = indent .. "    "
            local keys = {}
            local keylen_ = 0
            local values = {}
            for k, v in pairs(value_) do
                keys[#keys + 1] = k
                local vk = _v(k)
                if type(vk) == "string" then
                    local vk1 = string.len(vk)
                    if vk1 > keylen_ then
                        keylen_ = vk1
                    end
                end

                values[k] = v
            end
            table.sort(
                keys,
                function(a, b)
                    if type(a) == "number" and type(b) == "number" then
                        return a < b
                    else
                        return tostring(a) < tostring(b)
                    end
                end
            )

            for _, k in pairs(keys) do
                _dump(values[k], k, indent2, nest + 1, keylen_)
            end

            if string.find(var, "local") then
                result[#result + 1] = string.format("%s}", indent)
            else
                result[#result + 1] = string.format("%s},", indent)
            end
        end
    end

    local writeKey = string.format("local %s", fileName or "value")

    _dump(value, writeKey, "", 1)
    _str = table.concat(result, "\n")

    _str = _str .. "\n" .. "return " .. description
    return _str
end

local function DumpInFile(tbl, description)
    local UnNormalPoints = {}
    for key, value in pairs(tbl.UsablePoints) do
        if value.Speed and value.Speed ~= 1 then
            UnNormalPoints[key] = value
        end
    end
    tbl.UnNormalPoints = UnNormalPoints
    tbl.UsablePoints = nil

    if _G.AppSetting.DEBUG then
        _G.Log(debug.traceback("<color=red>" .. "生成地图数据Table    " .. description .. "</color>", 2))
    end
    local old = Mydump(tbl, description)
    local text = class_Desc .. old
    -- path = string.gsub(path, "Assets", "Logs") .. "/"
    local savePath = path .. description .. ".lua"

    local res, tbl1 = _G.serpent.load(old)
    if res and tbl1 then
        MapDataEditorTools.WriteDataVerify(tbl1)
    end

    CS.AorIO.WriteAllText(savePath, text)
end

function MapDataEditorTools.Write(data)
    DumpInFile(data, "MapData_" .. data.Sid)
end

function MapDataEditorTools.WriteDataVerify(tbl)
    require("TableUtil")
    local table = _G.table
    local printTbl = {
        UnNormalPoints = table.count(tbl.UnNormalPoints)
    }

    local WorldPointInfo = {}
    for _, t in pairs(tbl.WorldPointInfo) do
        for key, value in pairs(t) do
            if not WorldPointInfo[key] then
                WorldPointInfo[key] = 0
            end
            WorldPointInfo[key] = WorldPointInfo[key] + #value
        end
    end
    printTbl.WorldPointInfo = WorldPointInfo

    local WorldItemDatas = {}
    for key, value in pairs(tbl.WorldItemDatas) do
        WorldItemDatas[key] = #value
    end
    printTbl.WorldItemDatas = WorldItemDatas

    print(_G.serpent.output(printTbl))
end
