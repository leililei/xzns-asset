-- log的开放等级
_G.eLogLevel = {
    All = 0xFFFFFFFF,
    Debug = 0x1 | 0x2 | 0x4 | 0x8,
    Info = 0x2 | 0x4 | 0x8,
    Warning = 0x4 | 0x8,
    Error = 0x8,
    Off = 0x0
}
local CS = _G.CS

---普通级Unity打印
---@param context string 内容
---@param description string 说明
function _G.Log(context, description)
    if _G.AppSetting.LogLevel < 0 or (_G.AppSetting.LogLevel >= _G.eLogLevel.Debug) then
        CS.YoukiaCore.Log.Debug(debug.traceback(_G.dump(context, description), 2))
    end
end

