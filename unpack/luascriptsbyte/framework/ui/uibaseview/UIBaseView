---@class UIBaseView:Component 所有UI VIEW层的基类
local UIBaseView = _G.BaseClass("UIBaseView", _G.Component)
_G.UIBaseView = UIBaseView

function UIBaseView:__init()
    --- 回收池 界面关闭回收入池   _G.ePoolType.UIItem
    self.PoolsDelArr = {}
    self.go_table = nil
    self.viewName = nil
    self.ResList = {}
    self.ResRefList = {}
    self.ResLoadCompleteCall = nil
    self.ResCount = 0
    if self.OnDelayTimeUpdate ~= nil and type(self.OnDelayTimeUpdate) == "function" then
        self._delaySecondHandle = _G.TimerManager:GetInstance():GetTimer(1, self.OnDelaySecond, self, false)
        self._delaySecondHandle:Start()
    end
end

function UIBaseView:Dispose()
    if self._delaySecondHandle ~= nil then
        self._delaySecondHandle:Stop()
    end
    if self.cot_ResLoad ~= nil then
        _G.coroutine.stopwaiting(self.cot_ResLoad)
        self.cot_ResLoad = nil
    end
    self.go_table = nil
    self.viewName = nil
    self.ResList = nil
    self.ResLoadCompleteCall = nil
    self.ResCount = nil
    self.OnDelayTimeUpdate = nil
    self._delaySecondHandle = nil
    self.PoolsDelArr = nil
end

---SetBind 获取物体的go_table，并设置和关键字标记对象的对应表
---@param obj GameObject|Transform
function UIBaseView:SetBind(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self:AddComponent(obj, self)
    self.cot_ResLoad = _G.coroutine.start(_G.handler(self, self.ResLoad))
end

---添加需要加载资源到列表
---@param name string 资源使用时名字
---@param type UIResType 资源加载使用方式
---@param resPath string 资源路径
---@param cfg string 特效资源需要的配置表
---@param parent UnityEngine.Transform 父节点
function UIBaseView:AddResToList(name, type, resPath, cfg, parent)
    if _G.IsNil(self.ResList) or self:IsNil() then
        return
    end
    self.ResList[name] = {name = name, type = type, resPath = resPath, cfg = cfg, parent = parent}
end

---加载资源
function UIBaseView:ResLoad()
    self.ResCount = 0
    if _G.table.isEmptyOrNil(self.ResList) then
        if self.ResLoadCompleteCall ~= nil then
            self.ResLoadCompleteCall()
        end
        return
    end

    for _, v in pairs(self.ResList) do
        if v.type == _G.UIResType.pool then
            if v.resPath ~= nil and v.resPath ~= "" then
                _G.PoolsManager:GetInstance():Spawn(
                    v.resPath,
                    _G.ePoolType.UIItem,
                    v.parent,
                    _G.handlerbind(self, self.ResLoadComplete, v)
                )
            else
                self:ResLoadComplete({}, {}, v)
            end
        elseif v.type == _G.UIResType.eff then
            if v.cfg and v.cfg.Name then
                _G.UIUtils.LoadEffectByCfg(v.cfg, v.parent, _G.handlerbind(self, self.ResLoadComplete, v))
            else
                self:ResLoadComplete({}, {}, v)
            end
        elseif v.type == _G.UIResType.texture then
            if v.resPath ~= nil and v.resPath ~= "" then
                _G.ResourcesManager:GetInstance():LoadTexture(
                    v.resPath,
                    _G.handlerbind(self, self.ResLoadComplete, v),
                    self
                )
            else
                self:ResLoadComplete({}, {}, v)
            end
        end
    end
end

---加载资源完成
function UIBaseView:ResLoadComplete(tran, resRef, data)
    if _G.IsNil(self.ResList) or self:IsNil() then
        _G.DestroyObject(tran)
    else
        self.ResCount = self.ResCount + 1
        self.ResList[data.name] = tran
        self.ResRefList[data.name] = resRef
        if self.ResCount == _G.table.count(self.ResList) then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
            if self.ResLoadCompleteCall ~= nil then
                self.ResLoadCompleteCall()
            end
        end
    end
end

---OnDelaySecond 延时销毁
function UIBaseView:OnDelaySecond()
    if self.cot_ResLoad ~= nil then
        _G.coroutine.stopwaiting(self.cot_ResLoad)
        self.cot_ResLoad = nil
    end
    if self._delaySecondHandle ~= nil then
        self:OnDelayTimeUpdate()
    end
end

function UIBaseView:OnStartClose()
end

---关闭UI
function UIBaseView:Close()
    if self.PoolsDelArr ~= nil then
        for i = #self.PoolsDelArr, 1, -1 do
            if _G.IsNil(self.PoolsDelArr[i]) == false then
                _G.PoolsManager:GetInstance():Despawn(self.PoolsDelArr[i], _G.ePoolType.UIItem)
            end
        end
        self.PoolsDelArr = nil
    end

    if self.ResRefList ~= nil then
        for _, v in pairs(self.ResRefList) do
            if (v ~= nil and v.Release ~= nil) then
                v:Release()
            end
        end
        self.ResRefList = nil
    end

    if self.ResList ~= nil then
        for _, v in pairs(self.ResList) do
            if _G.IsNil(v) == false then
                _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.UIItem)
            end
        end
        self.ResList = nil
    end

    if self.cot_ResLoad ~= nil then
        _G.coroutine.stopwaiting(self.cot_ResLoad)
        self.cot_ResLoad = nil
    end
    if self._delaySecondHandle ~= nil then
        self._delaySecondHandle:Stop()
        self._delaySecondHandle = nil
    end

    _G.UIManager:GetInstance():CloseWindow(self.viewName)
end

---显示UI
function UIBaseView:Show()
    _G.UIManager:GetInstance():ShowWindow(self.viewName)
end

---隐藏UI
function UIBaseView:Hide()
    _G.UIManager:GetInstance():HideWindow(self.viewName)
end

function UIBaseView:EscClose()
    -- body
    --先不做强制关闭，可能导致功能异常
    --self:Close()
end

---true 界面已经关闭 被释放
function UIBaseView:IsNil()
    return self.go_table == nil
end

return UIBaseView
--endregion
