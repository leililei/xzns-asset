function UIManager:SetWorldSceneHideTimes(times)
    worldSceneHideTimes = worldSceneHideTimes + times
    if worldSceneHideTimes < 0 then
        worldSceneHideTimes = 0
    end
end

---获取窗口对象(lua对象，不一定有GameObject)
---@param ui_name string
---@return UIWindow
function UIManager:GetWindow(ui_name)
    local target = self.windows[ui_name]
    if nil == target then
        return nil
    end
    return target
end

---是否存在此窗口(lua对象判定)
---@param ui_name string
function UIManager:IsExitWindow(ui_name)
    local wind = self:GetWindowCtrl(ui_name)
    local is_exit = wind ~= nil and true or false
    return is_exit, self:GetWindow(ui_name)
end

---是否激活此窗口(是否显示)
---@param ui_name string
function UIManager:IsActiveWindow(ui_name)
    local wind = self:GetWindow(ui_name)
    if nil == wind then
        return false
    end
    return wind.Active, wind
end

---是否加载界面(是否有GameObject)
---@param ui_name string 界面名称
---@return boolean|UIWindow 是否加载|窗口对象
function UIManager:IsLoadedWindow(ui_name)
    local wind = self:GetWindow(ui_name)
    if nil == wind then
        return false
    end
    return wind.gameObject ~= nil, wind
end

---HideWindow 隐藏此窗口
---@param ui_name string
function UIManager:HideWindow(ui_name)
    if _G.AppSetting.DEBUG then
        if ui_name == _G.ConfigManager.ui_cfg.ShadowView.Name or ui_name == _G.ConfigManager.ui_cfg.ShadowTopView.Name then
            --or target.Name == _G.ConfigManager.ui_cfg.GameNetTipsView.Name
            _G.Log(ui_name, "<color=red><size=18>" .. "隐藏掉遮罩界面，查看是否正常" .. "</size></color>")
        end
    end
    local wind = self:GetWindow(ui_name)
    if nil ~= wind then
        wind.Active = false
        if not _G.IsNil(wind.gameObject) then
            if wind.gameObject:GetActiveSelf() == 1 then
                wind.gameObject:SetActiveE(0)
                ShowWorldScene(wind)
                _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIHide, ui_name)
            end
        end
    end
end

---ShowWindow 显示此窗口
---@param ui_name string
function UIManager:ShowWindow(ui_name)
    if _G.AppSetting.DEBUG then
        if ui_name == _G.ConfigManager.ui_cfg.ShadowView.Name or ui_name == _G.ConfigManager.ui_cfg.ShadowTopView.Name then
            --or target.Name == _G.ConfigManager.ui_cfg.GameNetTipsView.Name
            _G.Log(ui_name, "<color=red><size=18>" .. "显示出遮罩界面，查看是否正常" .. "</size></color>")
        end
    end
    local wind = self:GetWindow(ui_name)
    if nil ~= wind then
        wind.Active = true
        if not _G.IsNil(wind.gameObject) then
            if wind.gameObject:GetActiveSelf() == 0 then
                wind.gameObject:SetActiveE(1)
                HideWorldScene(wind)
                _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIShow, ui_name)
            end
        end
    end
end

---OpenWindowDynamicCfg 动态配置窗口是否要显隐主城
---@param ui_name string
---@param dynamicCfg DynamicCfg
function UIManager:OpenWindowDynamicCfg(ui_name, dynamicCfg, ...)
    ---检测资源是否下载
    if not self:CheckIsDownloadUI(ui_name) then
        return
    end
    ---@type UIWindow
    local target = self:GetWindow(ui_name)
    if nil == target then
        local window = _G.UIWindow.New()
        self.windows[ui_name] = window
        target = InitWindow(ui_name, window, ...)
    else
        local config = _G.ConfigManager.ui_cfg[ui_name]
        assert(config, "未找到窗口对应配置！ : " .. ui_name)
        if not target.View and config.View then
            target.View = require(config.View).New(...)
        end
    end
    if dynamicCfg.HideWorld ~= nil then
        target.HideWorld = dynamicCfg.HideWorld
    else
        target.HideWorld = _G.ConfigManager.ui_cfg[ui_name].HideWorld
    end
    target.View.viewName = ui_name
    InnerOpenWindow(self, target, ...)
    return target
end

---OpenWindow 打开窗口
---@param ui_name string
function UIManager:OpenWindow(ui_name, ...)
    ---检测资源是否下载
    if not self:CheckIsDownloadUI(ui_name) then
        return
    end
    local TreasureMapModel = require "TreasureMapModel":GetInstance()
    if TreasureMapModel:GetRunning() and not TreasureMapIgonreUI[ui_name] then
        local args = _G.SafePack(...)
        TreasureMapModel:SetRunning(false)
        _G.PopWindowManager:GetInstance():ShowAllTips(890301, nil,
            function()
                local data = _G.SafeUnpack(args)
                return self:OpenWindowExtra(ui_name, data)
            end,
            function()
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
                TreasureMapModel:VipTreasure()
            end)
    else
        return self:OpenWindowExtra(ui_name, ...)
    end
end

function UIManager:OpenWindowExtra(ui_name, ...)
    local target = self:GetWindow(ui_name)
    if nil == target then
        local window = _G.UIWindow.New()
        self.windows[ui_name] = window
        target = InitWindow(ui_name, window, ...)
    else
        local config = _G.ConfigManager.ui_cfg[ui_name]
        assert(config, "未找到窗口对应配置！ : " .. ui_name)
        if not target.View and config.View then
            target.View = require(config.View).New(...)
        end
    end
    target.HideWorld = _G.ConfigManager.ui_cfg[ui_name].HideWorld
    target.View.viewName = ui_name
    InnerOpenWindow(self, target, ...)
    return target
end

function UIManager:CheckIsDownloadUI(ui_name)
    if
        _G.ConfigManager.ui_cfg[ui_name].Not_Down == 0 and
        not _G.DownloadPlayManager:GetInstance():IsFunctionResourcesExit()
    then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DownloadResourceView.Name)
        return false
    end
    return true
end

---CloseAllWindows 关闭所有窗口
function UIManager:CloseAllWindows()
    self.JumpInfo = {}
    for _, v in pairs(self.windows) do
        InnerCloseWindow(self, v)
    end
end

---CloseWindowsByLayer 关闭对应层级的窗口
---@param ... {_G.UILayers.xx}
function UIManager:CloseWindowsByLayer(...)
    local param = { ... }
    for i = 1, #param do
        if param[i].layerName == _G.UILayers.NormalLayer.layerName then
            self.JumpInfo = {}
        end
    end
    for _, v in pairs(self.windows) do
        local layer = v.Layer
        for i = 1, #param do
            if layer.OrderInLayer == param[i].OrderInLayer then
                InnerCloseWindow(self, v)
            end
        end
    end
end

function UIManager:HideWindowsByLayer(...)
    local param = { ... }
    for _, v in pairs(self.windows) do
        local layer = v.Layer
        for i = 1, #param do
            if layer.OrderInLayer == param[i].OrderInLayer then
                self:HideWindow(v.Name)
            end
        end
    end
end

---SwitchSceneCloseWindows 切换场景关闭windows
---@param excludeWindows? table<string,boolean> 排除的窗口
function UIManager:SwitchSceneCloseWindows(excludeWindows)
    self.JumpInfo = {}
    local isIgnore, isDontDestroy
    for _, v in pairs(self.windows) do
        isIgnore = _IgnoreUi[v.Name] or excludeWindows and excludeWindows[v.Name]
        if not isIgnore then
            isDontDestroy = _DontDestroyUi[v.Name]
            if not isDontDestroy then
                ---引导界面即不删除也不隐藏
                local layer = v.Layer
                if
                    layer.OrderInLayer ~= _G.UILayers.LoadingLayer.OrderInLayer and
                    layer.OrderInLayer ~= _G.UILayers.DownloadPlayLayer.OrderInLayer
                then
                    --只要不是loading层的都删掉(之前是只有scenelayer和normallayer)
                    InnerCloseWindow(self, v)
                end
            else
                self:HideWindow(v.Name)
            end
        end
    end

    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.UIItem)
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.UIEffect)
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
end

---获取所有窗口实例
function UIManager:GetAllWindows()
    return self.windows
end

---CloseWindow 关闭窗口
---@param ui_name string
function UIManager:CloseWindow(ui_name)
    local target = self:GetWindow(ui_name)
    if nil == target then
        return
    end
    local jumpShowWindowName = self.JumpInfo[ui_name]
    if jumpShowWindowName ~= nil then
        self.JumpInfo[ui_name] = nil
    end
    if ui_name == _G.ConfigManager.ui_cfg.LoadingView.Name then
        --- 让loading界面的假进度条走完
        target.View:CloseViewFun(
            function()
                InnerCloseWindow(self, target)
            end
        )
    else
        InnerCloseWindow(self, target)
    end
    ---界面关闭时清理一次资源
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.UIItem)
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.UIEffect)
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
    --_G.ResourcesManager:GetInstance():UnloadUnusedAssets()
    if jumpShowWindowName ~= nil then
        _G.UIManager:GetInstance():ShowWindow(jumpShowWindowName)
        _G.Events:GetInstance():Broadcast(_G.eJumpShowWindow.JumpShowWindow, jumpShowWindowName)
    end
end

