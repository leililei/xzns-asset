InnerOpenWindow = function(self, target)
    _G.assert(target, "target is null")
    target.CreateTime = _G.Time.realtimeSinceStartup
    target.IsCanDestory = false
    if (target.Active) then
        if _G.AppSetting.DEBUG then
            _G.Log(target.Name, "当前界面重复打开")
        end
        return
    end
    if _G.AppSetting.DEBUG then
        if
            target.Name == _G.ConfigManager.ui_cfg.ShadowView.Name or
            target.Name == _G.ConfigManager.ui_cfg.ShadowTopView.Name
        then
            --or target.Name == _G.ConfigManager.ui_cfg.GameNetTipsView.Name
            _G.Log(target.Name, "<color=red><size=18>" .. "打开遮罩界面，查看是否正常" .. "</size></color>")
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.StartOpenUI, target.Name)
    target.Active = true

    SetTargetOrder(self, target)

    ---注：这里判断界面存在后进行了一些数据重置或者配置设定意义不大，目前UIManager界面关闭即销毁，没有缓存，这里改为如果面板已存直接将面板
    ---显示出来即可，去掉不必要的设置开销

    -- 是否存在路径
    local has_loaded = (not _G.IsNil(target.View)) and (not _G.IsNil(target.gameObject))
    -- 是否为已载资源
    --已加载
    if has_loaded then
        local go = target.gameObject
        go:SetActiveE(1)

        _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIOpened, target.Name)
    elseif not target.IsLoading then
        target.IsLoading = true

        if target.Name ~= _G.ConfigManager.ui_cfg.ShadowView.Name and self.isShowShadow then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
        end

        --print("加载开始" .. target.Name .. os.clock())
        _G.ResLoadingManager:GetInstance():Start(target.Name)
        local parentLayer = self:GetUILayerTrans(target.Layer.Name)
        _G.PoolsManager:GetInstance():Spawn(
            target.PrefabPath,
            _G.ePoolType.Default,
            parentLayer,
            function(go)
                _G.ResLoadingManager:GetInstance():Finish(target.Name)
                --print("加载结束" .. target.Name .. os.clock())
                local CloseShadowViewFun = function()
                    ---  关闭遮罩
                    if target.Name ~= _G.ConfigManager.ui_cfg.ShadowView.Name and self.isShowShadow then
                        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                    end
                end
                if target.View == nil then
                    _G.DestroyObject(go)
                    CloseShadowViewFun()
                    return
                end

                _G.Guard.NotNull(go, "Asset load err : " .. target.PrefabPath)
                go:SetLocalPositionToZero()
                go:SetLocalScaleToOne()
                go:SetRectOffSetToZero()

                go:SetName(target.Name)
                target.gameObject = go
                --AddVague(target)
                AddGlow(target)

                local gr = go:GetComponentE(typeof(CS.AorGraphicRaycaster))
                if _G.IsNil(gr) then
                    _G.LogFatal(_G.string.format("%s 自行添加 AorGraphicRaycaster", target.Name))
                end

                target.IsLoading = false
                if not _G.iskindof(target.View, "Component") then
                    _G.LogFatal("必须继承Component组件" .. target.Name)
                end
                SetCanvasOrder(go, target)
                target.View:SetBind(go)
                if target.BgMusic > 0 then
                    if _G.AppSetting.DEBUG then
                        _G.Log(target.Name, "<color=red>" .. "播放UI背景音乐 打开界面界面名" .. "</color>")
                    end
                    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, target.BgMusic)
                end
                if not target.Active then
                    --self:HideWindow(target.Name)  
                    --还没有走真实的加worldSceneHideTimes计数, 此处不要去减worldSceneHideTimes
                    --View:SetBind()中可能调用CloseWindow导致target.gameObject被Destroy
                    if not _G.IsNil(go) then 
                        go:SetActiveE(0)
                    end
                    _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIHide, target.Name)
                else
                    HideWorldScene(target)
                    _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIOpened, target.Name)
                end

                CloseShadowViewFun()
            end
        )
    end
end

InnerDestroyWindow = function(self, ui_name, target)
    if not _G.IsNil(target.gameObject) then
        _G.DestroyObject(target.gameObject)
    end
    target.View = nil
    target.gameObject = nil
    self.windows[ui_name] = nil
end

InitWindow = function(ui_name, window, ...)
    local config = _G.ConfigManager.ui_cfg[ui_name]
    _G.assert(config, "未找到" .. ui_name .. "窗口对应配置！")
    window.Name = ui_name
    if config.View then
        window.View = _G.require(config.View).New(...)
    end
    window.Layer = config.Layer
    window.Active = false
    window.PrefabPath = config.PrefabPath
    window.Full = config.Full
    window.BgMusic = config.audio
    window.Vague = config.Vague
    window.Glow = config.Glow
    return window
end

ShowWorldScene = function(target)
    if target.HideWorld then
        worldSceneHideTimes = worldSceneHideTimes - 1
        if worldSceneHideTimes == 0 then
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        elseif worldSceneHideTimes < 0 then
            worldSceneHideTimes = 0
        end
    end
end

HideWorldScene = function(target)
    if target.HideWorld then
        if worldSceneHideTimes == 0 then
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
        end
        worldSceneHideTimes = worldSceneHideTimes + 1
    end
end
