---GetUILayerTrans 获取UILayer根节点
---@param layerName string
---@return UnityEngine.Transform transform
function UIManager:GetUILayerTrans(layerName)
    local layer
    if (layerName == _G.UILayers.SceneLayer.Name) then
        if not self.SceneLayer then
            self.SceneLayer = _G.FindObject("SceneLayer")
        end
        layer = self.SceneLayer
    elseif (layerName == _G.UILayers.NormalLayer.Name) then
        if not self.NormalLayer then
            self.NormalLayer = _G.FindObject("NormalLayer")
        end
        layer = self.NormalLayer
    elseif (layerName == _G.UILayers.InfoLayer.Name) then
        if not self.InfoLayer then
            self.InfoLayer = _G.FindObject("InfoLayer")
            --  设置Canvs 防止特效获取UIroot节点层级 显示异常
            local canvas = self.InfoLayer:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            if _G.IsNil(canvas) or _G.IsNil(canvas.sortingOrder) then
                canvas = self.InfoLayer:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            end
            --- 设置它的canvas深度
            canvas.overrideSorting = true
            canvas.additionalShaderChannels = CS.UnityEngine.AdditionalCanvasShaderChannels.TexCoord1
            canvas.sortingOrder = _G.UILayers.InfoLayer.OrderInLayer
        end
        layer = self.InfoLayer
    elseif (layerName == _G.UILayers.TopLayer.Name) then
        if not self.TopLayer then
            self.TopLayer = _G.FindObject("TopLayer")
        end
        layer = self.TopLayer
    elseif (layerName == _G.UILayers.MaskTipsLayer.Name) then
        if not self.MaskTipsLayer then
            self.MaskTipsLayer = _G.FindObject("MaskTipsLayer")
        end
        layer = self.MaskTipsLayer
    elseif (layerName == _G.UILayers.LoadingLayer.Name) then
        if not self.LoadingLayer then
            self.LoadingLayer = _G.FindObject("LoadingLayer")
        end
        layer = self.LoadingLayer
    elseif (layerName == _G.UILayers.DownloadPlayLayer.Name) then
        if not self.DownloadPlayLayer then
            self.DownloadPlayLayer = _G.FindObject("DownloadPlayLayer")
        end
        layer = self.DownloadPlayLayer
    elseif (layerName == _G.UILayers.ThreeDLayer.Name) then
        if not self.ThreeDLayer then
            self.ThreeDLayer = _G.FindObject("ThreeDLayer")
        end
        layer = self.ThreeDLayer
    end
    return layer
end

---GetWindowView 获取对应窗口的View
---@param ui_name string
function UIManager:GetWindowCtrl(ui_name)
    local target = self:GetWindow(ui_name)
    if nil ~= target then
        if not target.View or _G.IsNil(target.View.gameObject) then
            return nil
        end
        return target.View
    end
    return nil
end

---改变界面order值
---@param ui_name string 界面名称
---@param order number UI深度
---@param ignoreOrderChange boolean 是否忽略UIParticleOrderChange组件
function UIManager:ChangeCanvasOrder(ui_name, order, ignoreOrderChange)
    local target = self:GetWindow(ui_name)
    if target == nil or _G.IsNil(target.gameObject) then
        return
    end
    target.LayerSorting = order
    local canvas = target.gameObject:GetComponentE(_G.typeof(_G.Canvas))
    if _G.IsNil(canvas) then
        _G.LogFatal(_G.string.format("%s 自行添加Canvas组件", target.Name))
        return
    end
    -- 设置它的canvas深度
    canvas.overrideSorting = true
    canvas.additionalShaderChannels = _G.CS.UnityEngine.AdditionalCanvasShaderChannels.TexCoord1
    local layersorting = canvas.sortingOrder
    canvas.sortingOrder = order
    order = layersorting - order
    -- 设置Renderer的sortingOrder
    local renders = target.gameObject:GetComponentsInChildrenE(_G.typeof(_G.Renderer), 1)
    local len = renders.Length - 1
    for i = 0, len do
        local render = renders[i]
        -- 如果ignoreOrderChange=true, 忽略UIParticleOrderChange组件下的节点
        if not ignoreOrderChange or not render:GetComponentInParent(_G.typeof(_G.CS.UIParticleOrderChange)) then
            render.sortingOrder = render.sortingOrder - order
        end
    end
    -- 设置预制体ui的Canvas
    local allComponents = target.gameObject:GetComponentsInChildrenE(_G.typeof(_G.Canvas), 1)
    local len1 = allComponents.Length - 1
    for i = 1, len1 do
        local child = allComponents[i]
        child.sortingOrder = child.sortingOrder - order
    end
end

function UIManager:ChangeCanvasOrderByTransform(trans, order)
    -- 设置Renderer的sortingOrder
    local renders = trans:GetComponentsInChildrenE(_G.typeof(_G.Renderer), 1)
    local len = renders.Length - 1
    for i = 0, len do
        local render = renders[i]
        render.sortingOrder = render.sortingOrder + order
    end
    -- 设置预制体ui的Canvas
    local allComponents = trans:GetComponentsInChildrenE(_G.typeof(_G.Canvas), 1)
    local len1 = allComponents.Length - 1
    for i = 0, len1 do
        local child = allComponents[i]
        child.sortingOrder = child.sortingOrder + order
    end
end

---获取顶层Window
function UIManager:GetTopWindowByLayer(layerName)
    local list = {}
    for _, w in pairs(self.windows) do
        -- 要求层级相同并且是激活的面板
        if w.Layer.Name == layerName and w.gameObject and w.gameObject:GetActiveSelf() == 1 then
            if
                w.Name ~= "GameNetTipsView" and w.Name ~= "CacheCommonAtlasView" and w.Name ~= "HUDView" and
                w.Name ~= "ShadowView" and
                w.Name ~= "ShadowTopView" and
                w.Name ~= "ChatDefultRootView" and
                w.Name ~= "FloatTipsView" and
                w.Name ~= "ChapterObjectTagView" and
                w.Name ~= "BattleDamageRankView" and
                w.Name ~= "QuickUseTipView" and
                w.Name ~= "FloatMessagesView"
            then
                table.insert(list, w)
            end
        end
    end
    if #list < 1 then
        return nil
    else
        table.sort(
            list,
            function(a, b)
                if a.LayerSorting > b.LayerSorting then
                    return true
                elseif a.LayerSorting == b.LayerSorting then
                    if a.CreateTime > b.CreateTime then
                        return true
                    end
                end
                return false
            end
        )
        return list[1]
    end
end

