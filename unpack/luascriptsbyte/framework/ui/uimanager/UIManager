InnerGetTopWindowByLayer = function(self, target)
    local list = {}
    for _, w in pairs(self.windows) do
        if w.Name ~= target.Name and w.Layer == target.Layer and w.Active then
            table.insert(list, w.LayerSorting)
        end
    end
    if #list < 1 then
        return nil
    else
        local sortingOrder = 0
        for _, value in ipairs(list) do
            if value > sortingOrder then
                sortingOrder = value
            end
        end
        return sortingOrder
    end
end

InnerCloseWindow = function(self, target)
    assert(target)

    if target.View.OnStartClose then
        target.View:OnStartClose()
    end

    if target.Active then
        target.Active = false
        target.DestroyTime = _G.Time.realtimeSinceStartup
        target.IsCanDestory = true
        target.View = nil
        if not _G.IsNil(target.gameObject) then
            target.gameObject:SetActiveE(0)
        end
        RemoveGlow(target)
    end

    if _G.AppSetting.DEBUG then
        if
            target.Name == _G.ConfigManager.ui_cfg.ShadowView.Name or
            target.Name == _G.ConfigManager.ui_cfg.ShadowTopView.Name
        then
            --or target.Name == _G.ConfigManager.ui_cfg.GameNetTipsView.Name
            _G.Log(target.Name, "<color=red><size=18>" .. "关闭遮罩界面，查看是否正常" .. "</size></color>")
        end
    end

    local layer = target.Layer

    InnerDestroyWindow(self, target.Name, target)

    _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.StartCloseUI, target.Name)
    ShowWorldScene(target)

    _G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIClosed, target.Name)

    local topWin = self:GetTopWindowByLayer(layer.Name)
    if topWin then
        if topWin.BgMusic > 0 then
            if _G.AppSetting.DEBUG then
                _G.Log(topWin.Name, "<color=red>" .. "播放UI背景音乐 界面关闭检测到最上面存在带音乐的界面名" .. "</color>")
            end
            if topWin.Name == "MainView" then --检测前台战斗中并播放关卡bgm
                if _G.MainManager:GetInstance():IsFighting() and _G.MainManager:GetInstance():IsToggledAfkWindow(true) then
                    local mId = require("AfkModel"):GetInstance():GetCurMonsterID()
                    local mCfg = _G.ConfigManager.monster_group_cfg[mId]
                    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, mCfg and mCfg.audio or topWin.BgMusic)
                end
            else
                _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, topWin.BgMusic)
            end
        end
    else
        if target.BgMusic > 0 then
            local scene = _G.WorldManager:GetInstance().CurrentWorld
            if scene then
                _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, scene.Cfg.audio)
            end
        end
    end
end

SetTargetOrder = function(self, target)
    local topWindowLayerSorting = InnerGetTopWindowByLayer(self, target)
    local layersorting
    if nil == topWindowLayerSorting then
        layersorting = target.Layer.OrderInLayer
    else
        layersorting = topWindowLayerSorting + 50
    end
    target.LayerSorting = layersorting
end

SetCanvasOrder = function(tran, target)
    local canvas = tran:GetComponentE(_G.typeof(_G.Canvas))
    if _G.IsNil(canvas) then
        _G.LogFatal(string.format("%s 自行添加Canvas组件", target.Name))
        return
    end
    local sortingOrderDic = {}
    -- 设置它的canvas深度
    canvas.overrideSorting = true
    canvas.additionalShaderChannels = _G.CS.UnityEngine.AdditionalCanvasShaderChannels.TexCoord1
    local layersorting = target.LayerSorting
    canvas.sortingOrder = 0
    -- sortingOrderDic[canvas:GetInstanceIDE()] = layersorting
    -- 设置预制体ui的Canvas
    local oneSort
    local canvasList = tran:GetComponentsInChildrenE(_G.typeof(_G.Canvas), 1)
    for i = 0, canvasList.Length - 1 do
        oneSort = canvasList[i].sortingOrder
        canvasList[i].sortingOrder = layersorting + oneSort
        sortingOrderDic[canvasList[i]:GetInstanceIDE()] = layersorting + oneSort
    end
    --设置一次所有的
    local renders = canvas:GetComponentsInChildrenE(_G.typeof(_G.Renderer), 1)
    local len = renders.Length - 1
    local canvasInstanceID
    for i = 0, len do
        local render = renders[i]
        canvas, canvasInstanceID = render:GetComponentInParentE(_G.typeof(_G.Canvas), 1)
        if sortingOrderDic[canvasInstanceID] then
            render.sortingOrder = render.sortingOrder + sortingOrderDic[canvasInstanceID]
        end
    end
end

