--[[
-- 可更新脚本，等效于带有Unity侧Update、LateUpdate、FixedUpdate函数
-- 1、虽然支持Update、LateUpdate、FixedUpdate更新，但能不用就不用---不要定义这些函数即可，用太多可能对性能有影响
-- 2、使用Time获取时间相关信息，如：Time.deltaTime，Time.fixedDeltaTime，Time.frameCount等
--]]
local Updatable = _G.BaseClass("Updatable")
_G.Updatable = Updatable

-- 添加更新函数
local function AddUpdate(self)
	if self.Update ~= nil then
		self.__update_handle = _G.BindCallback(self, self.Update)
		_G.UpdateManager:GetInstance():AddUpdate(self.__update_handle)
	end
	if self.LateUpdate ~= nil then
		self.__lateupdate_handle = _G.BindCallback(self, self.LateUpdate)
		_G.UpdateManager:GetInstance():AddLateUpdate(self.__lateupdate_handle)
	end
	if self.FixedUpdate ~= nil then
		self.__fixedupdate_handle = _G.BindCallback(self, self.FixedUpdate)
		_G.UpdateManager:GetInstance():AddFixedUpdate(self.__fixedupdate_handle)
	end
end

-- 注销更新函数
local function RemoveUpdate(self)
	if self.__update_handle ~= nil then
		_G.UpdateManager:GetInstance():RemoveUpdate(self.__update_handle)
		self.__update_handle = nil
	end
	if self.__lateupdate_handle ~= nil then
		_G.UpdateManager:GetInstance():RemoveLateUpdate(self.__lateupdate_handle)
		self.__lateupdate_handle = nil
	end
	if self.__fixedupdate_handle ~= nil then
		_G.UpdateManager:GetInstance():RemoveFixedUpdate(self.__fixedupdate_handle)
		self.__fixedupdate_handle = nil
	end
end

-- 构造函数
local function __init(self)
	self:EnableUpdate(true)
end

-- 析构函数
local function Dispose(self)
	self:EnableUpdate(false)
end

-- 是否启用更新
local function EnableUpdate(self, enable)
	RemoveUpdate(self)
	if enable then
		AddUpdate(self)
	end
end

Updatable.__init = __init
Updatable.Dispose = Dispose
Updatable.EnableUpdate = EnableUpdate

return Updatable
