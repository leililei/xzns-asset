--- Core.CoroutineManager
local CS = _G.CS
local UE = CS.UnityEngine

---@type UnityEngine.MonoBehaviour
local MonoBehaviour = CS.Launcher.Inst

local coroutine = _G.coroutine
local util = require("CorUtil")

---启动协程
---@return UnityEngine.Coroutine
function coroutine.start(...)
    --"协程开启"
    return MonoBehaviour:StartCoroutine(util.cs_generator(...))
end

---停止协程
---@param coroutine UnityEngine.Coroutine @coroutine
function coroutine.stopwaiting(coroutine)
    --"协程关闭"
    return MonoBehaviour:StopCoroutine(coroutine)
end

---等待几秒
---@param seconds number @seconds
function coroutine.waitforseconds(seconds)
    --"协程等待秒数"
    coroutine.yield(UE.WaitForSeconds(seconds))
end

---等待帧结束(lateUpdate之后，注意：coroutine.yield 在lateUpdate之前，update之后)
function coroutine.waitforendofframe()
    --"协程等待WaitForEndOfFrame"
    coroutine.yield(UE.WaitForEndOfFrame())
end
