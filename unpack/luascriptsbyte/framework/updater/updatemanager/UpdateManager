--[[
-- 更新管理，负责Unity侧Update、LateUpdate、FixedUpdate对Lua脚本的调用
-- 1、别直接用tolua的UpdateBeat、LateUpdateBeat、FixedUpdateBeat，所有需要以上三个更新函数的脚本，都从这里注册。
-- 2、tolua的event没有使用weak表，直接使用tolua的更新系统会导致脚本被event持有引用而无法释放---除非每次都记得手动去释放
--]]
-----@class UpdateManager:Singleton
-----@field GetInstance fun():UpdateManager
-----@field ui_message_center Messenger  Messenger 实例
-----@field __update_handle function
-----@field __lateupdate_handle function
-----@field __fixedupdate_handle function
local UpdateManager = _G.BaseClass("UpdateManager", _G.Singleton)
_G.UpdateManager = UpdateManager

local UpdateMsgName = "Update"
local LateUpdateMsgName = "LateUpdateMsgName"
local FixedUpdateMsgName = "FixedUpdateMsgName"

---@field UpdateHandle function Update回调
local function UpdateHandle(self)
    self.ui_message_center:Broadcast(UpdateMsgName)
end

---@field LateUpdateHandle function LateUpdate回调
local function LateUpdateHandle(self)
    self.ui_message_center:Broadcast(LateUpdateMsgName)
end

---@field FixedUpdateHandle function FixedUpdate回调
local function FixedUpdateHandle(self)
    self.ui_message_center:Broadcast(FixedUpdateMsgName)
end

function UpdateManager:__init()
    self.ui_message_center = _G.Messenger.New()
    self.__update_handle = _G.UpdateBeat:CreateListener(UpdateHandle, self)
    self.__lateupdate_handle = _G.LateUpdateBeat:CreateListener(LateUpdateHandle, self)
    self.__fixedupdate_handle = _G.FixedUpdateBeat:CreateListener(FixedUpdateHandle, self)
    _G.UpdateBeat:AddListener(self.__update_handle)
    _G.LateUpdateBeat:AddListener(self.__lateupdate_handle)
    _G.FixedUpdateBeat:AddListener(self.__fixedupdate_handle)
end

function UpdateManager:Dispose()
    -- self:Cleanup()
    if self.__update_handle ~= nil then
        _G.UpdateBeat:RemoveListener(self.__update_handle)
        self.__update_handle = nil
    end
    if self.__lateupdate_handle ~= nil then
        _G.LateUpdateBeat:RemoveListener(self.__lateupdate_handle)
        self.__lateupdate_handle = nil
    end
    if self.__fixedupdate_handle ~= nil then
        _G.FixedUpdateBeat:RemoveListener(self.__fixedupdate_handle)
        self.__fixedupdate_handle = nil
    end
    self.ui_message_center = nil
end

---AddUpdate 添加Update更新
---@param e_listener function 想要添加的方法
function UpdateManager:AddUpdate(e_listener, obj)
    self.ui_message_center:AddListener(UpdateMsgName, e_listener, obj)
end

---HasUpdate 添加Update更新
---@param e_listener function 添加的方法是否已存在
function UpdateManager:HasUpdate(e_listener, obj)
    return self.ui_message_center:HasListener(UpdateMsgName, e_listener, obj)
end

---AddLateUpdate 添加LateUpdate更新
---@param e_listener function 想要添加的方法
function UpdateManager:AddLateUpdate(e_listener, obj)
    self.ui_message_center:AddListener(LateUpdateMsgName, e_listener, obj)
end

---AddFixedUpdate 添加FixedUpdate更新
---@param e_listener function 想要添加的方法
function UpdateManager:AddFixedUpdate(e_listener, obj)
    self.ui_message_center:AddListener(FixedUpdateMsgName, e_listener, obj)
end

function UpdateManager:HasFixedUpdate(e_listener, obj)
    return self.ui_message_center:HasListener(FixedUpdateMsgName, e_listener, obj)
end

---RemoveUpdate 移除Update更新
---@param e_listener function 想要移除的方法
function UpdateManager:RemoveUpdate(e_listener, obj)
    self.ui_message_center:RemoveListener(UpdateMsgName, e_listener, obj)
end

---RemoveLateUpdate 移除LateUpdate更新
---@param e_listener function 想要移除的方法
function UpdateManager:RemoveLateUpdate(e_listener, obj)
    self.ui_message_center:RemoveListener(LateUpdateMsgName, e_listener, obj)
end

---RemoveFixedUpdate 移除FixedUpdate更新
---@param e_listener function 想要移除的方法
function UpdateManager:RemoveFixedUpdate(e_listener, obj)
    self.ui_message_center:RemoveListener(FixedUpdateMsgName, e_listener, obj)
end

return UpdateManager
