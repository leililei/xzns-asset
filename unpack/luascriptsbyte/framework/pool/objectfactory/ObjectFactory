---@class ObjectFactory
---@generic T
---@field private createCallback fun():T
---@field private activeCallback fun(t:T):void
---@field private releaseCallback fun(t:T):void
---@field private validate fun(t:T):boolena
---@field private lstActive T[]
---@field private lstRelease T[]
local ObjectFactory = _G.BaseClass("ObjectFactory")

function ObjectFactory:__init(create, active, release, validate)
    self.createCallback = create
    self.activeCallback = active
    self.releaseCallback = release
    self.validate = validate
end

---回收所有实例对象
---@return void
function ObjectFactory:ReleaseAll()
    if not self.lstActive then
        return
    end
    local lstActive = self.lstActive
    self.lstActive = nil

    if not self.lstRelease then
        self.lstRelease = {}
    end
    for _, item in ipairs(lstActive) do
        if not self.validate or self.validate(item) then
            if self.releaseCallback then
                self.releaseCallback(item)
            end
            table.insert(self.lstRelease, item)
        end
    end
end

---回收一个实例对象
---@return void
function ObjectFactory:Release(item)
    if not item then
        return
    end

    if self.lstActive then
        for i = #self.lstActive, 1, -1 do
            if item == self.lstActive[i] then
                table.remove(self.lstActive, i)
                break
            end
        end
    end

    if self.releaseCallback then
        self.releaseCallback(item)
    end
    if not self.lstRelease then
        self.lstRelease = {}
    end
    table.insert(self.lstRelease, item)
end

---获取一个实例对象
---@return T
function ObjectFactory:Get()
    ---@type T
    local item
    if self.lstRelease then
        while (not item and #self.lstRelease > 0) do
            item = table.remove(self.lstRelease, 1)
            if self.validate and not self.validate(item) then
                item = nil
            end
        end
    end

    if not item then
        item = self.createCallback()
    end

    if self.activeCallback then
        self.activeCallback(item)
    end
    if not self.lstActive then
        self.lstActive = {}
    end
    table.insert(self.lstActive, item)

    return item
end

---获取使用中的实例对象数量
---@return number
function ObjectFactory:GetActiveCount()
    if not self.lstActive then
        return 0
    end
    return #self.lstActive
end

return ObjectFactory
