---对list进行排序
---@generic T
---@param list T[]
---@param sortFun (fun(item:T):number) | "function(item) end"
---默认降序排序
function _G.SortList(list, sortFun)
    local listData = {}
    for i = 1, #list do
        local item = list[i]
        listData[i] = {
            item = item,
            sorts = {sortFun(item)}
            --参数检查?
        }
    end
    table.sort(
        listData,
        function(a, b)
            for i = 1, #a.sorts do
                local as = a.sorts[i]
                local bs = b.sorts[i]
                if (as ~= bs) then
                    return as > bs
                end
            end
            return false
        end
    )
    for i = 1, #listData do
        list[i] = listData[i].item
    end
end

---比较器方法([可变参数]返回值允许number丶boolean), 可变参数必需返回固定数量的参数
---@alias CompareFunction fun(value: T): ...
---@alias CompareFunctionParams {expr:CompareFunction<T>, type: "DESC"|"AES", params:table<any, ...>} @DESC降序排序, ASC升序排序
---@alias CompareData {value: T, params: ..., count: number}

---冒泡排序(table.sort使用快速排序, 比较值相同时无法按照输入顺序来输出)
---通用方法效率较慢(性能敏感场景不应使用)
---@generic T
---@param list T[]
---@param expressions CompareFunction|CompareFunctionParams|(CompareFunction|CompareFunctionParams)[]   @比较器方法,默认DESC降序排序
---@sample 使用示例
--- 示例1: 直接返回多个参数并进行降序排序(默认)
---_G.BubbleSortList(list, function(v) return v.num1, v.num2 end)
--- 示例2: 直接返回多个参数, 并指定进行升序排序
---_G.BubbleSortList(list, {expr = function(v) return v.num1, v.num2 end, type = "ASC"})
--- 示例3: 返回一个expression数组, 每个数组分开返回参数并指定排序方式
---_G.BubbleSortList(
---    list,
---    {
---        {expr = function(v) return v.num1 end, type = "ASC"},
---        {expr = function(v) return v.num2 end, type = "DESC"},
---    }
---)
function _G.BubbleSortList(list, expressions)
    if not list then
        return
    end
    --成员数量
    local len = #list

    ---比较器方法参数
    ---@type CompareFunctionParams<T>[]
    local compareParams = {}
    if type(expressions) == "function" then
        table.insert(compareParams, {expr = expressions, type = "DESC"})
    elseif #expressions == 0 then
        table.insert(compareParams, expressions)
    else
        for _, expression in ipairs(expressions) do
            if type(expression) == "function" then
                table.insert(compareParams, {expr = expression, type = "DESC"})
            else
                table.insert(compareParams, expression)
            end
        end
    end
    for _, compare in ipairs(compareParams) do
        if not compare.params then
            compare.params = {}
        end
    end

    ---执行冒泡排序
    ---@type CompareData
    local a, b
    local swap, aParams, bParams
    for i = 1, len do
        for j = i + 1, len do
            a, b = list[i], list[j]
            swap = false
            for _, compare in ipairs(compareParams) do
                --获取参数
                aParams, bParams = compare.params[a], compare.params[b]
                if not aParams then
                    aParams = table.pack(compare.expr(a))
                    compare.params[a] = aParams
                end
                if not bParams then
                    bParams = table.pack(compare.expr(b))
                    compare.params[b] = bParams
                end
                --比较参数
                for k = 1, #aParams do
                    local acp, bcp = aParams[k], bParams[k]
                    if acp < bcp and compare.type == "DESC" or acp > bcp and compare.type ~= "DESC" then
                        swap = true
                        break
                    end
                end
                if swap then
                    break
                end
            end
            --执行交换
            if swap then
                local temp = list[i]
                list[i] = list[j]
                list[j] = temp
            end
        end
    end
end

