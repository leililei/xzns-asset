---CSCallLuaLoad 映射到C#侧的静态委托，不会在Lua侧调用
---@param goInstID number 被触碰的对象GameObject InstanceID
---@param isEnter boolean 是否进入
---@param tarGoInstId number 主角的GameObject InstanceID
---@param tarObj number 主角的GameObject
function _G.WorldCsListener.CSCallTriggerLuaLoad(goInstID, isEnter, tarGoInstId, tarObj)
    local fun = _G.WorldCsListener.TriggerDic[goInstID]
    local tarLuaGo, world
    world = _G.WorldManager:GetInstance():GetCurWorld()
    if world then
        ---@type BaseItem 主动触发物体
        tarLuaGo = world.AllWorldItemsByInstId[tarGoInstId]
    end

    if fun ~= nil and tarLuaGo ~= nil then
        fun(isEnter, tarGoInstId, tarObj, tarLuaGo)
    end
end

