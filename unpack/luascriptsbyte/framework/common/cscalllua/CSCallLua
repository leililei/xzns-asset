--region 动画播放
_G.AnimatorPlayEndCallback = {
    callDic = {}
}
function _G.AnimatorPlayEndCallback.CSCallLuaPlayEnd(goInstID, name)
    local events = _G.AnimatorPlayEndCallback.callDic[goInstID]
    if events and #events > 0 then
        for i = 1, #events do
            if events[i] then
                events[i](name)
            end
        end
    end
end
_G.CS.RoleAnimatorController.playAnimatorEndCallBack = _G.AnimatorPlayEndCallback.CSCallLuaPlayEnd
function _G.AnimatorPlayEndCallback.AddCallback(goInstID, callback)
    if not _G.AnimatorPlayEndCallback.callDic[goInstID] then
        _G.AnimatorPlayEndCallback.callDic[goInstID] = {}
    end
    _G.table.insert(_G.AnimatorPlayEndCallback.callDic[goInstID], callback)
end

function _G.AnimatorPlayEndCallback.RemoveCallback(goInstID, callback)
    if not _G.AnimatorPlayEndCallback.callDic[goInstID] or #_G.AnimatorPlayEndCallback.callDic[goInstID] <= 0 then
        return
    end
    if not callback then
        _G.AnimatorPlayEndCallback.callDic[goInstID] = nil
    else
        for i = 1, #_G.AnimatorPlayEndCallback.callDic[goInstID] do
            if _G.AnimatorPlayEndCallback.callDic[goInstID][i] == callback then
                _G.table.remove(_G.AnimatorPlayEndCallback.callDic[goInstID], i)
                break
            end
        end
    end
end
