--region ComponentListener
---@class ComponentListener 用来优化LuaBehaviour 对Component 函数的多次获取和调用产生的开销
_G.ComponentCsListener = {
    ---@field public dic table<number,table> luaObj对象字典
    dic = {},
    onEnable = {}
}

---AddCSCalls 将lua对象与unity object 进行绑定
---@param guide number obj InstanceID
---@param clas table lua对象
---@return table lua对象
function _G.ComponentCsListener.AddCSCalls(guide, clas)
    _G.ComponentCsListener.dic[guide] = clas
    return clas
end

function _G.ComponentCsListener.Awake(guide)
    local cals = _G.ComponentCsListener.dic[guide]
    _G.Guard.NotNull(cals, "Component 对应对象为null ")
    if (not _G.IsNil(cals.Awake) and type(cals.Awake) == "function") then
        cals:Awake()
    end
    if (not _G.IsNil(cals.OnCreate) and type(cals.OnCreate) == "function") then
        cals:OnCreate(_G.SafeUnpack(cals.__parame))
    end
end

function _G.ComponentCsListener.OnEnable(guide)
    local cals = _G.ComponentCsListener.dic[guide]
    --Guard.NotNull(cals,"Component 对应对象为null ")
    if
        (not _G.IsNil(cals.OnEnable) and not _G.ComponentCsListener.onEnable[guide] and
            type(cals.OnEnable) == "function")
     then
        _G.ComponentCsListener.onEnable[guide] = true
        cals:OnEnable()
    else
        if _G.AppSetting.DEBUG then
            _G.LogWarning("OnEnable... classname=" .. cals.__cname)
        end
    end
end

function _G.ComponentCsListener.Start(guide)
    local cals = _G.ComponentCsListener.dic[guide]
    --Guard.NotNull(cals,"Component 对应对象为null ")
    if (not _G.IsNil(cals.Start) and type(cals.Start) == "function") then
        cals:Start()
    else
        if _G.AppSetting.DEBUG then
            _G.LogWarning("Start... classname=" .. cals.__cname)
        end
    end
end

function _G.ComponentCsListener.OnDisable(guide)
    _G.ComponentCsListener.onEnable[guide] = nil
    local cals = _G.ComponentCsListener.dic[guide]
    --Guard.NotNull(cals,"Component 对应对象为null ")
    if (not _G.IsNil(cals.OnDisable) and type(cals.OnDisable) == "function") then
        cals:OnDisable()
    else
        if _G.AppSetting.DEBUG then
            _G.LogWarning("OnDisable... classname=" .. cals.__cname)
        end
    end
end

function _G.ComponentCsListener.OnDestroy(guide)
    local cals = _G.ComponentCsListener.dic[guide]
    _G.Guard.NotNull(cals, "Component 对应对象为null ")
    if cals ~= nil then
        -- Dipose
        cals:RemoveAllListener()
        if (not _G.IsNil(cals.OnDestroy) and type(cals.OnDestroy) == "function") then
            cals:OnDestroy()
        end
        cals:Dispose()
    end
    _G.ComponentCsListener.dic[guide] = nil
end

CS.luaComponent.luaAwake = _G.ComponentCsListener.Awake
CS.luaComponent.luaOnEnable = _G.ComponentCsListener.OnEnable
CS.luaComponent.luaStart = _G.ComponentCsListener.Start
CS.luaComponent.luaDisable = _G.ComponentCsListener.OnDisable
CS.luaComponent.luaOnDestory = _G.ComponentCsListener.OnDestroy
--endregion

