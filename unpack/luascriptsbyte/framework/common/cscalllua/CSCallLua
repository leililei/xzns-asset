--region EventSystems.EventTrigger
---@class EventTriggerCsListener UGUI事件系统绑定事件
local EventTriggerCsListener = {}
_G.EventTriggerCsListener = EventTriggerCsListener

---@param _eventTriggerHelpAddUnityEventDic table<number,table> 保存的响应函数字典
local _eventTriggerHelpAddUnityEventDic = {}

---@param _GetEventTriggerId function 将获取到C#的EventTriggerType枚举状态转变为int值
local _GetEventTriggerId = CS.EventTriggerCsListener.GetEventTriggerId

---@param _AddUnityEvent function 将获取到C#的EventTriggerType枚举状态转变为int值
local _AddUnityEvent = CS.EventTriggerCsListener.AddUnityEvent
local _SetEventTriggerListenerEvent = CS.EventTriggerCsListener.SetEventTriggerListenerEvent
local _GetEventTriggerListenerEvent = CS.EventTriggerCsListener.GetEventTriggerListenerEvent

CS.EventTriggerCsListener._pointerEventDataEvent = function(goId, eventTriggerId, pointerEventData)
    local eventList = _eventTriggerHelpAddUnityEventDic[goId]
    local typelist = eventList[eventTriggerId]
    if (not typelist) then
        return
    end
    for _, v in ipairs(typelist) do
        v(pointerEventData)
    end
end

CS.EventTriggerCsListener._baseEventDataEvent = function(goId, eventTriggerId, baseEventData)
    local eventList = _eventTriggerHelpAddUnityEventDic[goId]
    local typelist = eventList[eventTriggerId]
    if (not typelist) then
        return
    end
    for _, v in ipairs(typelist) do
        v(baseEventData)
    end
end

CS.EventTriggerCsListener._objectDestroyEvent = function(goId)
    _eventTriggerHelpAddUnityEventDic[goId] = nil
end

function EventTriggerCsListener.ToEventList(goId)
    local eventList = _eventTriggerHelpAddUnityEventDic[goId]
    if (not eventList) then
        eventList = {}
        _eventTriggerHelpAddUnityEventDic[goId] = eventList
    end
    return eventList
end

---给EventTrigger添加事件
---@param go GameObject trigger组件节点
---@param triggerType UnityEngine.EventSystems.EventTriggerType 枚举类型
---@param event UnityAction<BaseEventData>
function EventTriggerCsListener.AddUnityEvent(go, eventTriggerType, event)
    local goId = go:GetInstanceIDE()
    local eventTriggerId = _GetEventTriggerId(eventTriggerType)
    local eventList = _eventTriggerHelpAddUnityEventDic[goId]
    if (not eventList) then
        eventList = {}
        _eventTriggerHelpAddUnityEventDic[goId] = eventList
    end
    local typelist = eventList[eventTriggerId]
    if (not typelist) then
        typelist = {}
        eventList[eventTriggerId] = typelist
    end
    table.insert(typelist, event)
    _AddUnityEvent(goId, go, eventTriggerId)
end

---SetUnityEvent 设置对应类型的事件, 不重复
---@param go GameObject trigger组件节点
---@param triggerType UnityEngine.EventSystems.EventTriggerType 枚举类型
---@param event UnityAction<BaseEventData>
function EventTriggerCsListener.SetUnityEvent(go, eventTriggerType, event)
    local goId = go:GetInstanceIDE()
    local eventTriggerId = _GetEventTriggerId(eventTriggerType)
    local eventList = EventTriggerCsListener.ToEventList(goId)
    if (not eventList[eventTriggerId]) then
        _AddUnityEvent(goId, go, eventTriggerId)
    end
    eventList[eventTriggerId] = {event}
end

---RemoveUnityEventAll 取消对应类型的事件
---@param go GameObject GameObject
function EventTriggerCsListener.RemoveUnityEventAll(go)
    local goId = go:GetInstanceIDE()
    _eventTriggerHelpAddUnityEventDic[goId] = nil
    --_G.LogError("当前剩余个数:" .. table.count(_eventTriggerHelpAddUnityEventDic))
end

---@class eEventTriggerType EventTriggerType枚举,对应UnityEngine.EventSystems.EventTriggerType 枚举
local eEventTriggerType = {
    onClick = 0,
    onDown = 1,
    onEnter = 2,
    onExit = 3,
    onUp = 4,
    onSelect = 5,
    onUpdateSelect = 6,
    onDeSelect = 7,
    onDragBegin = 8,
    onDrag = 9,
    onDragEnd = 10,
    onDrop = 11,
    onScroll = 12,
    onMove = 13,
    onLongPress = 14,
    onDoubleClick = 15
}
_G.eEventTriggerType = eEventTriggerType

---SetEventTriggerListenerEvent 对EventTriggerListener 进行扩展, 可以通过RemoveUnityEventAll进行移除
---@param go GameObject
---@param eventTriggerType eEventTriggerType枚举
---@param event function
---@param penetrate boolean 是否穿透
function EventTriggerCsListener.SetEventTriggerListenerEvent(go, eventTriggerType, event, penetrate)
    local goId = go:GetInstanceIDE()
    local eventList = EventTriggerCsListener.ToEventList(goId)
    if (not eventList[eventTriggerType]) then
        _SetEventTriggerListenerEvent(goId, go, eventTriggerType, penetrate)
    end
    eventList[eventTriggerType] = {
        function(baseEventData)
            event(go, baseEventData)
        end
    }
end

function EventTriggerCsListener.GetEventTriggerListenerEvent(go)
    return _GetEventTriggerListenerEvent(go)
end

---GetUnityEventTrigger 获取对象上的EventTrigger对象（没有则添加）
---@param gameObject GameObject
function EventTriggerCsListener.GetUnityEventTrigger(gameObject)
    local eventTrigger = gameObject:GetComponentE(typeof(CS.UnityEngine.EventSystems.EventTrigger))
    if _G.IsNil(eventTrigger) then
        eventTrigger = gameObject:AddComponent(typeof(CS.UnityEngine.EventSystems.EventTrigger))
    end
    return eventTrigger
end
