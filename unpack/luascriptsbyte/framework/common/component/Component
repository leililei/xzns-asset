---@class Component lua组件类
---@field public Components [][] 绑定组件集
---@field public transform Transform 物体对应的transform
---@field public gameObject GameObject 物体对应的gameObject
---@field public CachListener table 事件监听绑定成员的方法
local Component = _G.BaseClass("Component")
_G.Component = Component

---记录打开过的界面
local OpenedViewRecords = {}

---记录打开过的界面对应父
local OpenedViewParent = {}

---AddListener 添加事件监听
---@param msgName string 事件Key值
---@param callBack function 事件回调
---@param obj table 包含回调的table
local AddListener = function(msgName, callBack, obj)
    _G.Events:GetInstance():AddListener(msgName, callBack, obj)
end

---AddListener 添加事件监听
---@param msgName string 事件Key值
---@param callBack function 事件回调
---@param obj table 包含回调的table
local RemoveListener = function(msgName, callBack, obj)
    _G.Events:GetInstance():RemoveListener(msgName, callBack, obj)
end

function Component:__init()
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.transform = nil
    self.gameObject = nil
    self.CacheListener = {}
end

function Component:Dispose()
    self.Components = nil
    self.transform = nil
    self.gameObject = nil
    self.CacheListener = nil
end

function Component:Awake()
end

function Component:OnCreate()
end

function Component:OnEnable()
end

function Component:Start()
end

function Component:OnDisable()
end

function Component:OnDestroy()
end

---为GameObject添加lua组件
---@param bindTager GameObject 绑定的GameObject
---@param class Component  lua实例化类
---@return Component 实例化类
function Component:AddComponent(bindTager, class)
    _G.Guard.AssertException(_G.iskindof(class, "Component"), "未继承Component")
    -- behaviour 记录数据是否存在
    local cl = self:GetComponent(bindTager, class)
    -- 检测组件是否已经添加过
    if _G.IsNil(cl) then
        local obj = bindTager
        _G.ComponentCsListener.AddCSCalls(obj:GetInstanceIDE(), class)
        -- 添加缓存到本地集合中
        self.Components[bindTager] = self.Components[bindTager] or {}
        self.Components[bindTager][class.__cname] = class
        class.gameObject = bindTager
        class.transform = bindTager
        --赋值
        cl = class

        if nil == OpenedViewRecords[class.__cname] then
            OpenedViewRecords[class.__cname] = class.__cname
        end

        if _G.AppSetting.IS_EDITOR then
            if nil == OpenedViewParent[class.__cname] then
                OpenedViewParent[class.__cname] = self.__cname
            end
        end

        _G.CS.LuaBehaviour.AddLuaBehaviour(obj, class.__cname)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("组件 %s 被重复添加", class.__cname))
        end
    end
    return cl
end

---GetComponent 获取GameObject中挂载的lua组件
---@param bindTager GameObject 绑定的GameObject
---@param class Component  lua组件类
---@return  Component 实例化类 或nil
function Component:GetComponent(bindTager, class)
    local tager = self.Components[bindTager]
    if tager ~= nil and tager[class.__cname] then
        return tager[class.__cname]
    end
    return nil
end

---AddListener 添加事件监听
---@param msgName string 事件Key值
---@param callBack function 事件回调，必须是成员方法
function Component:AddListener(msgName, callBack)
    if not self.CacheListener[msgName] then
        self.CacheListener[msgName] = {}
    end

    if not _G.table.indexof(self.CacheListener[msgName], callBack) then
        table.insert(self.CacheListener[msgName], callBack)
        AddListener(msgName, callBack, self)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("单个事件重复添加同一个响应")
        end
    end
end

---RemoveListener 取消事件监听
---@param msgName string 事件Key值
---@param callBack function 事件回调，必须是成员方法
function Component:RemoveListener(msgName, callBack)
    if self.CacheListener then
        local funcList = self.CacheListener[msgName]
        if funcList then
            local index
            for i, v in ipairs(funcList) do
                if v == callBack then
                    index = i
                    break
                end
            end

            if index then
                RemoveListener(msgName, callBack, self)
                table.remove(funcList, index)
            end
        end
    end
end

---RemoveAllListener 取消所有事件监听
function Component:RemoveAllListener()
    if self.CacheListener then
        for msgName, funcList in pairs(self.CacheListener) do
            for _, v in ipairs(funcList) do
                RemoveListener(msgName, v, self)
            end
            funcList = {}
        end
    end
end

---释放打开过的界面
function Component.ALLDispose()
    for k, _ in pairs(OpenedViewRecords) do
        package.loaded[k] = nil
        OpenedViewRecords[k] = nil
    end
end

---返回上层界面
function Component.CheckView(component)
    return OpenedViewParent[component]
end

return Component
