local logEnabled = true

--[[
-- 静态类：只读：避免访问错误，访问控制仅在调试模式下生效
--]]
---ConstClass 静态类：只读：避免访问错误，访问控制仅在调试模式下生效
---@param classname string 类名
---@param inptTable table 类名
---@return table 返回的对象
function _G.ConstClass(classname, inptTable)
    if _G.AppSetting.DEBUG and _G.AppSetting.IS_EDITOR then
        setmetatable(
            inptTable,
            {
                __cname = classname,
                __index = function(t, key) ---为了组合详细日志我们从堆栈中提取关键数据
                    if not _G.AppSetting.DEBUG or not logEnabled then
                        return
                    end

                    local tb = _G.debug.traceback()
                    local string = _G.string
                    ---判断是否从网络消息块过来
                    local isFormNet = string.contains(tb, "Net")
                    ---提取读取配置的当前行
                    local contents = string.split(tb, "\n")
                    local method = string.trim(contents[3])
                    local mat = getmetatable(t)
                    local classnamel = mat and mat.__cname or "nil"
                    ---跟网络有关就多打印出网络块信息
                    if isFormNet and _G.ReceiveMsgManagerCsListener.MsgInfo then
                        -- _G.LogWarning(string.format(
                        --     "未找到id: %s >>> %s >>> %s >>> %s >>> %s",
                        --     tostring(key),
                        --     classnamel,
                        --     os.date("%Y-%m-%d-%H:%M:%S", os.time()),
                        --     method,
                        --     _G.ReceiveMsgManagerCsListener.MsgInfo
                        -- ))
                    end
                end
            }
        )
        return _G.readOnlyEasy(inptTable)
    end
    return inptTable
end

---设置const class日志开关
---@param enabled boolean 开关
function _G.SetConstClassLog(enabled)
    if not _G.AppSetting.isShowCfgErrorLog then
        logEnabled = enabled
    else
        logEnabled = true
    end
end
