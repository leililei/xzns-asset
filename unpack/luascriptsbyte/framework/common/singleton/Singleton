--[[
-- 单例类
--]]
---@class Singleton
---@field GetInstance fun():Singleton
local Singleton = _G.BaseClass("Singleton")

---@param SingCatchTab table 储存的所有单列的对象
local SingCatchTab = {}

---ALLDispose 释放所有的单列对象
function Singleton.ALLDispose()
    for k, _ in pairs(SingCatchTab) do
        if not _G.IsNil(SingCatchTab[k].Dispose) and false ~= SingCatchTab[k].Dispose then
            SingCatchTab[k]:Dispose()
        end
        package.loaded[k] = nil
        SingCatchTab[k] = nil
    end
end

function Singleton:__init()
    assert(rawget(self._class_type, "Instance") == nil, self._class_type.__cname .. " to create singleton twice!")
    rawset(self._class_type, "Instance", self)
    -- SingCatchTab[self._class_type.__cname] = self
end

function Singleton:Dispose()
    rawset(self._class_type, "Instance", nil)
    package.loaded[self._class_type.__cname] = nil
    SingCatchTab[self._class_type.__cname] = nil
end

-- 只是用于启动模块, 启动模块的需要从 SingCatchTab 移除
function Singleton:Startup()
end

function Singleton:inheritSign()
    SingCatchTab[self.__cname] = self
end

-- function Singleton.
---GetInstance 取得一个单列对象，不要重写这个方法
---@return table 单列对象
function Singleton:GetInstance()
    local ins = rawget(self, "Instance")
    if ins ~= nil then
        return ins
    end
    --ZHJH-8802【神器】穿戴神器后无法通过点击icon打开tips
    --lazyRequire存在以下问题, 将导致实例重复构建:
    --1. 执行local model1 = require(modelName), 此时是lazyRequire并未真实require, model1是table壳对象
    --2. 执行model1.xxxx, 访问模块的"静态"变量或方法(不调用GetInstance进行实例化), 触发真实require
    --3. 执行require(modelName):GetInstance(), 此时require返回的是真实的模块对象, 调用GetInstance将Instance字段存储在真实模块对象上, table壳对象上没有Instance字段
    --4. 执行model1:GetInstance(), model1壳对象再次进行实例化
    --
    --lazyRequire壳table -> require真实table -> require真实table:GetInstance() -> lazyRequire壳table:GetInstance()报错
    --反之, 先调用lazyRequire壳table:GetInstance()则不会报错, 因为在__init中会将Instance写入真实table中

    --构建实例对象
    ins = self.Instance
    if ins == nil or ins == false or not ins._class_type or ins._class_type.__cname ~= self.__cname then
        ins = self.New()
        SingCatchTab[self.__cname] = ins
    end
    assert(ins ~= nil)
    rawset(self, "Instance", ins)
    return ins
end

_G.Singleton = Singleton
return Singleton
