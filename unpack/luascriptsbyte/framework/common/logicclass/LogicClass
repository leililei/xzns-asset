--[[
-- 逻辑类（处理逻辑层需要重置的类）
--]]
---@class LogicClass
---@field GetInstance fun():LogicClass
local LogicClass = _G.BaseClass("LogicClass")

---@param LogicCatchTab table 储存的所有对象
local LogicCatchTab = {}

---ALLDispose 释放所有的类对象
function LogicClass.ALLDispose()
    for k, _ in pairs(LogicCatchTab) do
        if LogicCatchTab[k].Dispose and not _G.IsNil(LogicCatchTab[k].Dispose) then
            LogicCatchTab[k]:Dispose()
        end
        package.loaded[k] = nil
        LogicCatchTab[k] = nil
    end
end

function LogicClass:__init()
    --LogicCatchTab[self._class_type.__cname] = self
end

function LogicClass:inheritSign()
    LogicCatchTab[self.__cname] = self
end

function LogicClass:Dispose()
    --LogicCatchTab[self._class_type.__cname] = nil
end

_G.LogicClass = LogicClass
return LogicClass
