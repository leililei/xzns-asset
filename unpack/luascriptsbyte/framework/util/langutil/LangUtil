---@type LanguagePackage

local Language = "CN"

---@class LangUtil    多语言工具
_G.LangUtil = {}

---@type LangUtil
local LangUtil = _G.LangUtil

local isReplace

---取得程序本地化字段
---@param item LanguagePackage_Item
---@return string 本地化字段Value
function LangUtil.GetLangPackValue(item, ...)
    local key
    if type(item) == "table" then
        key = item.Key
    elseif type(item) == "string" then
        key = tonumber(item)
    elseif type(item) == "number" then
        key = item
    end

    local value
    ---高频被使用的接口，避免使用safepack，会大量参生内存碎片
    --local args = _G.SafePack(...)
    local argsture = ... ~= nil

    if key ~= nil and key ~= 0 then
        if isReplace==nil then
            isReplace = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.languageReplace)
        end
        if isReplace then
            value = _G.ConfigManager.language_repalce_cfg[key]
        end
      
        if not value then
            value = _G.ConfigManager.language_package_cfg[key]
        end
    end

    if value then
        --if args.n > 0 then
        if argsture then
            --_G.SafeUnpack(args))
            if _G.AppSetting.DEBUG then
                local args = _G.SafePack(...)
                local num = _G.GameUtil.GetStringCharNum(value)
                if num ~= args.n then
                    _G.LogError(key, "当前语言id对应填充参数数量异常")
                    return value
                end
            end
            return string.format(value, ...)
        else
            return value
        end
    end

    return tostring(key)
end

---取得程序本地化字段,不会因为参数数量不匹配而阻断,代价是额外的计算量，有隐患时使用
---@param item LanguagePackage_Item
---@return string 本地化字段Value
function LangUtil.SafeGetLangPackValue(item, ...)
    local key
    if type(item) == "table" then
        key = item.Key
    elseif type(item) == "string" then
        key = tonumber(item)
    elseif type(item) == "number" then
        key = item
    end

    local value
    ---高频被使用的接口，避免使用safepack，会大量参生内存碎片
    --local args = _G.SafePack(...)
    local argsture = ... ~= nil

    if key ~= nil and key ~= 0 then
        value = _G.ConfigManager.language_package_cfg[key]
    end

    if value then
        --if args.n > 0 then
        if argsture then
            --_G.SafeUnpack(args))
            local args = _G.SafePack(...)
            local num = _G.GameUtil.GetStringCharNum(value)
            if _G.AppSetting.DEBUG and num ~= args.n then
                _G.LogError(key, "当前语言id对应填充参数数量异常:" .. _G.table.concat(args, ", "))
            end
            if num > args.n then
                return value
            end
            return string.format(value, ...)
        else
            return value
        end
    end

    return tostring(key)
end

---尝试取得本地化字段
---@param item table key
---@return string 本地化字段Value
function LangUtil.TryGetLangValue(item, ...)
    local value_pack
    value_pack = LangUtil.GetLangPackValue(item, ...)
    if value_pack then
        return value_pack
    end

    if value_pack == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(item, "  is nil")
        end
        return
    end

    if value_pack then
        if _G.AppSetting.DEBUG then
            _G.LogError("   程序和策划配置表存在同样的key", item)
        end
    end
end
---@field GetLangPackValue function 取得程序本地化字段
_G.GetLangPackValue = LangUtil.GetLangPackValue

---@field GetLangPackValue function 取得程序本地化字段
_G.SafeGetLangPackValue = LangUtil.SafeGetLangPackValue

---@field TryGetLangValue function 尝试取得本地化字段
_G.TryGetLangValue = LangUtil.TryGetLangValue
