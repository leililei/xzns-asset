--[[
-- Lua全局工具类，全部定义为全局函数、变量
-- 1、SafePack和SafeUnpack会被大量使用，到时候看需要需要做记忆表降低GC
--]]
local unpack = _G.unpack or table.unpack

-- 解决原生pack的nil截断问题，SafePack与SafeUnpack要成对使用
function _G.SafePack(...)
    local params = {...}
    params.n = select("#", ...)
    return params
end

-- 解决原生unpack的nil截断问题，SafePack与SafeUnpack要成对使用
function _G.SafeUnpack(safe_pack_tb)
    return unpack(safe_pack_tb, 1, safe_pack_tb.n)
end

-- 对两个SafePack的表执行连接
function _G.ConcatSafePack(safe_pack_l, safe_pack_r)
    local concat = {}
    for i = 1, safe_pack_l.n do
        concat[i] = safe_pack_l[i]
    end
    for i = 1, safe_pack_r.n do
        concat[safe_pack_l.n + i] = safe_pack_r[i]
    end
    concat.n = safe_pack_l.n + safe_pack_r.n
    return concat
end

--合并传入参数
function _G.handlerbind(obj, method, ...)
    local params
    if nil ~= ... then
        params = _G.SafePack(...)
    end
    return function(...)
        local params1
        if nil ~= ... then
            params1 = _G.SafePack(...)
        end

        local args
        if params and params1 then
            args = _G.ConcatSafePack(params1, params)
        elseif params then
            args = params
        elseif params1 then
            args = params1
        else
            return method(obj)
        end
        return method(obj, _G.SafeUnpack(args))
    end
end

--[[
将 Lua 对象及其方法包装为一个匿名函数
@param mixed obj Lua 对象
@param function method 对象方法
@return function
]]
function _G.handler(obj, method)
    return function(...)
        return method(obj, ...)
    end
end

-- 闭包绑定
function _G.Bind(self, func, ...)
    assert(self == nil or type(self) == "table")
    assert(func ~= nil and type(func) == "function")
    local params
    if self == nil then
        params = _G.SafePack(...)
    else
        params = _G.SafePack(self, ...)
    end
    return function(...)
        local args = _G.ConcatSafePack(params, _G.SafePack(...))
        func(_G.SafeUnpack(args))
    end
end

-- 回调绑定
-- 重载形式：
-- 1、成员函数、私有函数绑定：BindCallback(obj, callback, ...)
-- 2、闭包绑定：BindCallback(callback, ...)
function _G.BindCallback(...)
    local bindFunc = nil
    local params = _G.SafePack(...)
    assert(params.n >= 1, "BindCallback : error params count!")
    if type(params[1]) == "table" and type(params[2]) == "function" then
        bindFunc = _G.Bind(...)
    elseif type(params[1]) == "function" then
        bindFunc = _G.Bind(nil, ...)
    else
        error("BindCallback : error params list!")
    end
    return bindFunc
end

-- 将字符串转换为boolean值
function _G.ToBoolean(s)
    local transform_map = {
        ["true"] = true,
        ["false"] = false,
        ["TRUE"] = true,
        ["FALSE"] = false
    }
    s = _G.string.lower(s)
    return transform_map[s]
end

-- 深拷贝对象(慎用，最好不用)
function _G.DeepCopy(object)
    local lookup_table = {}
    local function _copy(_object)
        if type(_object) ~= "table" then
            return _object
        elseif lookup_table[_object] then
            return lookup_table[_object]
        end
        local new_table = {}
        lookup_table[_object] = new_table
        for index, value in pairs(_object) do
            new_table[_copy(index)] = _copy(value)
        end
        return setmetatable(new_table, getmetatable(_object))
    end
    return _copy(object)
end

---深拷贝配置table
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function _G.DeepCopyCfgTable(object)
    if not _G.AppSetting.DEBUG then
        return _G.DeepCopy(object)
    end
    local function _copy(_object)
        if type(_object) ~= "table" then
            return _object
        end
        local new_table = {}
        for i = 1, #_object do
            new_table[i] = _copy(_object[i])
        end
        return new_table
    end
    return _copy(object)
end

