--延时一定时间（秒），执行方法
seconds延时时间
func 延时后执行的函数
ignoreTimeScale 是否忽略TimeScale
--]]
function _G.DelayDo(seconds, func)
    local cor
    cor =
        _G.coroutine.start(
        function()
            _G.coroutine.waitforseconds(seconds)
            if (func) then
                func()
            end
            _G.coroutine.stopwaiting(cor)
        end
    )

    return cor
end

