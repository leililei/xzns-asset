---移除富文本标签符号"<"和">"
---@param text string               @原始输入文本
---@param fill string|boolean       @string:需要填充的符号, true:填充"*"号, false表示不填充
---@return string
function string.removeRichTextSpecal(text, fill)
    if not fill then
        fill = ""
    elseif type(fill) == "boolean" then
        fill = "*"
    end
    text = string.replace(text, "<", fill)
    text = string.replace(text, ">", fill)
    return text
end

--- 获取字符的字节数
local function getByteCount(char)
    local byte = string.byte(char)
    if byte >= 0 and byte <= 127 then
        return 1
    elseif byte >= 192 and byte <= 223 then
        return 2
    elseif byte >= 224 and byte <= 239 then
        return 3
    elseif byte >= 240 and byte <= 247 then
        return 4
    end
end

---字符串utf8长度
---@param str string
---@return number
function string.utf8len(str)
    local _, count = string.gsub(str, '[^\128-\193]', '')
    return count
end

--- 基于字符的安全截取函数
function string.utf8sub(str, startChar, numChars)
    local startIndex = 1
    local numBytes = #str
    local currentIndex = 1
    local charCount = 0

    while currentIndex <= numBytes do
        if charCount + 1 >= startChar then
            break
        end
        local byteCount = getByteCount(string.sub(str, currentIndex, currentIndex))
        currentIndex = currentIndex + byteCount
        charCount = charCount + 1
    end

    startIndex = currentIndex
    local endIndex = startIndex

    while currentIndex <= numBytes do
        if charCount >= startChar + numChars - 1 then
            break
        end
        local byteCount = getByteCount(string.sub(str, currentIndex, currentIndex))
        currentIndex = currentIndex + byteCount
        charCount = charCount + 1
        endIndex = currentIndex - 1
    end

    return string.sub(str, startIndex, endIndex)
end

---模拟C#中的System.Text.RegularExpressions.Regex.Unescape，微信小游戏不支持该方法
function string.regexUnescape(input)
    if not input then return nil end

    local result = {}
    local i = 1
    local len = #input

    while i <= len do
        local c = input:sub(i, i)

        if c == '\\' and i < len then
            local nextChar = input:sub(i + 1, i + 1)

            -- 处理已知的转义序列
            if nextChar == 'a' then
                table.insert(result, '\a')
                i = i + 2
            elseif nextChar == 'b' then
                table.insert(result, '\b')
                i = i + 2
            elseif nextChar == 'f' then
                table.insert(result, '\f')
                i = i + 2
            elseif nextChar == 'n' then
                table.insert(result, '\n')
                i = i + 2
            elseif nextChar == 'r' then
                table.insert(result, '\r')
                i = i + 2
            elseif nextChar == 't' then
                table.insert(result, '\t')
                i = i + 2
            elseif nextChar == 'v' then
                table.insert(result, '\v')
                i = i + 2
            elseif nextChar == '\\' then
                table.insert(result, '\\')
                i = i + 2
            elseif nextChar == '"' then
                table.insert(result, '"')
                i = i + 2
            elseif nextChar == '\'' then
                table.insert(result, '\'')
                i = i + 2
            else
                -- 处理八进制转义序列 (如 \123)
                if nextChar:match('%d') then
                    local octalStr = ''
                    local j = i + 1
                    while j <= len and j <= i + 3 and input:sub(j, j):match('%d') do
                        octalStr = octalStr .. input:sub(j, j)
                        j = j + 1
                    end

                    if #octalStr > 0 then
                        local octalNum = tonumber(octalStr, 8)
                        if octalNum then
                            table.insert(result, string.char(octalNum))
                            i = j
                        else
                            table.insert(result, c)
                            i = i + 1
                        end
                    else
                        table.insert(result, c)
                        i = i + 1
                    end
                else
                    -- 处理十六进制转义序列 (如 \x20)
                    if nextChar == 'x' and i + 2 <= len then
                        local hexStr = input:sub(i + 2, i + 3)
                        if hexStr:match('^%x%x$') then
                            local hexNum = tonumber(hexStr, 16)
                            if hexNum then
                                table.insert(result, string.char(hexNum))
                                i = i + 4
                            else
                                table.insert(result, c)
                                i = i + 1
                            end
                        else
                            table.insert(result, c)
                            i = i + 1
                        end
                    else
                        -- 处理 Unicode 转义序列 (如 \u0020)
                        if nextChar == 'u' and i + 5 <= len then
                            local uniStr = input:sub(i + 2, i + 5)
                            if uniStr:match('^%x%x%x%x$') then
                                local uniNum = tonumber(uniStr, 16)
                                if uniNum then
                                    -- Lua 5.3+ 支持 Unicode 字符
                                    if _VERSION >= "Lua 5.3" then
                                        table.insert(result, utf8.char(uniNum))
                                    else
                                        -- 对于旧版 Lua，只能处理基本 ASCII
                                        if uniNum <= 127 then
                                            table.insert(result, string.char(uniNum))
                                        else
                                            table.insert(result, '?')
                                        end
                                    end
                                    i = i + 6
                                else
                                    table.insert(result, c)
                                    i = i + 1
                                end
                            else
                                table.insert(result, c)
                                i = i + 1
                            end
                        else
                            -- 未知转义序列，保留原样
                            table.insert(result, c)
                            table.insert(result, nextChar)
                            i = i + 2
                        end
                    end
                end
            end
        else
            table.insert(result, c)
            i = i + 1
        end
    end
    return table.concat(result)
end

