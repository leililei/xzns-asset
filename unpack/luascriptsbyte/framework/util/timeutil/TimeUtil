---将时间转换成字符串 天时
---@param time number 时间
---@return string 展示字符串
function TimeUtil.TranslateDayForStrSix(time)
    local ctime = TimeUtil.GetDateTime(_G.PlayerModel:GetInstance():GetCreateRoleTime())
    local changeTime
    if ctime.hour < _G.TimeUtil.GAME_DAY_HOUR then
        changeTime =
            _G.TimeUtil.GAME_DAY_TIME - ctime.hour * SECOND_OF_HOUR - ctime.minute * SECOND_OF_MINUTE - ctime.second -
            SECOND_OF_DAY
    else
        changeTime =
            0 - (ctime.hour - _G.TimeUtil.GAME_DAY_HOUR) * SECOND_OF_HOUR - ctime.minute * SECOND_OF_MINUTE -
            ctime.second
    end
    local timeStr
    local t = TimeUtil.TranslateSecond(time + changeTime)
    local day = t.day
    local hour = t.hour > 0 and t.hour or 1
    if day > 0 then
        timeStr = _G.LangUtil.GetLangPackValue(90000011142, day, hour)
    else
        timeStr = _G.LangUtil.GetLangPackValue(90000011264, hour)
    end
    return timeStr
end

