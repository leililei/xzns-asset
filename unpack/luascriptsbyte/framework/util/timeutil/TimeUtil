        timeStr = _G.GetLangPackValue(90021800086, t.min, t.sec)
    else
        timeStr = t.sec .. _G.GetLangPackValue(90022500438)
    end
    return timeStr
end

---当前是第几天（6点为跨天，从2016年1月1日6时起开始计）
---@param time number 时间戳，不传则取当前时间
---@return number 第x天
function TimeUtil.GetTotalDayBy201611(time)
    time = time or GetNowUnixTime()
    return _G.math.floor((time - 1451577600 - GAME_DAY_TIME) / 86400) + 1
end

---当前距离第x天结束还差多久（如第2天结束为2016.1.3 06:00:00)
---@param endDay number 目标第x天
---@param now number 时间戳，不传则取当前时间
---@return number 时间戳
function TimeUtil.CalCountDownByEndTotalDay(endDay, now)
    now = now or GetNowUnixTime()
    local day = _G.math.floor((now - 1451577600 - GAME_DAY_TIME) / 86400) + 1
    if day > endDay then
        return 0
    else
        return (endDay - day + 1) * 86400 - (now - GAME_DAY_TIME + math.floor(ServerTimeZone * 3600)) % 86400
    end
end

---获取离线状态描述
function TimeUtil.GetOfflineStateDesc(time, colorOn, colorOff)
    colorOn = colorOn or "14874a"
    colorOff = colorOff or "341A13"
    local offlineDes
    if time > 0 then
        local left = _G.TimeUtil.GetServerUnixTime() - time
        if left < SECOND_OF_DAY then
            offlineDes = _G.LangUtil.GetLangPackValue(90021800065, math.max(math.floor(left / SECOND_OF_HOUR), 1))
        else
            offlineDes = _G.LangUtil.GetLangPackValue(90021800066, math.min(math.floor(left / SECOND_OF_DAY), 7))
        end
        offlineDes = _G.string.AddColor(offlineDes, colorOff)
    else
        offlineDes = _G.LangUtil.GetLangPackValue(90022500846)
        offlineDes = _G.string.AddColor(offlineDes, colorOn)
    end
    return offlineDes
end

