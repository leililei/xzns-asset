function TimeUtil.TranslateTime(time)
    local servertime = _G.TimeUtil.GetServerUnixTime()
    time = _G.TimeUtil.TranslateSecond(servertime - time)
    if time.day > 0 then
        time.day = time.day > 30 and 30 or time.day
        return _G.GetLangPackValue(90022100085, time.day)
    end
    if time.hour > 0 then
        if time.min > 0 then
            return _G.GetLangPackValue(90022100084, time.hour, time.min)
        else
            return _G.GetLangPackValue(90022100086, time.hour)
        end
    end
    time.min = time.min > 0 and time.min or 1
    return _G.GetLangPackValue(90022100083, time.min)
end

