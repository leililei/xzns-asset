function TimeUtil.CheckTheSameDay(time1, time2)
    return TimeUtil.GetIntervalDay(time1, time2) == 0
end

-- 检查两个时间是否为同一天依赖6点
function TimeUtil.CheckTheSameDayBySix(time1, time2)
