---将时间转换成字符串 天时/时分/分秒
---@param time number 时间
---@return number  Hour 剩余小时数
---@return boolean 是否打开计时器
---@return string 展示字符串
function TimeUtil.LeiJiZhaomuForStr(time)
    local timeStr
    local Hour = 0
    local openTimer = true
    local t = TimeUtil.TranslateSecond(time)
    if t.day > 0 then
        if t.day < 2 then
            Hour = t.hour + t.day * 24
        else
            openTimer = false
        end
        timeStr = _G.GetLangPackValue(90023800013, "   " .. _G.GetLangPackValue(90022010703, t.day))
    elseif t.hour > 0 then
        Hour = t.hour
        timeStr = _G.GetLangPackValue(90023800013, "   " .. _G.GetLangPackValue(90025500029, t.hour))
    else
        timeStr = _G.GetLangPackValue(90023800013, "   " .. _G.GetLangPackValue(90025500029, 1))
    end
    return Hour, openTimer, timeStr
end

---将具体的时间转换成时间戳
---@param t table 具体时间点(如果是key-value 则格式为 {year=2000,month = 10,day = 1,hour = 10,min = 0,sec = 0} 如果是array 则{year,month,day,hour,min,sec}) 除year外都可以为空 取默认值，month默认值1 day默认值1 hour、min、sec默认0
---@return number 时间戳
function TimeUtil.TranslateTimeForStamp(t)
    if not t.year and not t[1] then
        return 0
    end
    return TimeUtil.time(
        {
            year = t.year or t[1],
            month = t.month or t[2] or 1,
            day = t.day or t[3] or 1,
            hour = t.hour or t[4] or 0,
            min = t.min or t[5] or 0,
            sec = t.sec or t[6] or 0
        }
    )
end

