---转换秒 - 天时分秒
---@param second number 剩余时间
---@return table 转换后的时间
function TimeUtil.TranslateSecond(second, t)
    t = t or {}
    t.day = _G.Mathf.Floor(second / 86400)
    second = second - t.day * 86400
    t.hour = _G.Mathf.Floor(second / 3600)
    second = second - t.hour * 3600
    t.min = _G.Mathf.Floor(second / 60)
    second = second - t.min * 60
    t.sec = _G.Mathf.Floor(second)
    return t
end

