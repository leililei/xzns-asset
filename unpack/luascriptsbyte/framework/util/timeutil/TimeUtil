end

---获取6点的倒计时时间戳
function TimeUtil.GetSixClockTimer()
    -- return 60
    local num = _G.TimeUtil.GetServerUnixTime()
    num = _G.math.floor(num / 86400) + 1
    num = num * 86400 + _G.TimeUtil.GAME_DAY_TIME - math.floor(ServerTimeZone * 3600)
    num = num - _G.TimeUtil.GetServerUnixTime()
    if num < 0 then
        num = num + 86400
    end
    return num
end

---0时区时间戳转一个带时区时间戳
function TimeUtil.GetOneTimeByUTC(time)
    return time - math.floor(ServerTimeZone * 3600)
end

---获取一天内某点的倒计时时间戳
---@param hour number 几点
function TimeUtil.GetClockTimer(hour)
    local num = _G.TimeUtil.GetServerUnixTime()
    num = _G.math.floor(num / 86400) + 1
    num = num * 86400 + math.floor((hour - ServerTimeZone) * 3600)
    return num - _G.TimeUtil.GetServerUnixTime()
end

