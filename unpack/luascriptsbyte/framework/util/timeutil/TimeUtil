_G.TimeUtil = TimeUtil

local CS = _G.CS
local HOUR_OF_DAY = 24
local SECOND_OF_MINUTE = 60
local SECOND_OF_HOUR = 3600
local SECOND_OF_DAY = HOUR_OF_DAY * SECOND_OF_HOUR

local RawServerTimeZone = 0

---客户端时区和服务器时区(相对于UTC+00:00偏移的小时数)
local ClientTimeZone = 0
local ServerTimeZone = 0
---客户端与服务器时区偏移值(秒数)
local TimeZoneOffsetSeconds = 0
local TimeZoneOffset = {
    hour = 0,
    min = 0
}

---游戏业务跨天的时间点(小时)
local GAME_DAY_HOUR = 0
---游戏业务跨天的时间点(秒)
local GAME_DAY_TIME = GAME_DAY_HOUR * 3600
_G.TimeUtil.GAME_DAY_HOUR = GAME_DAY_HOUR
_G.TimeUtil.GAME_DAY_TIME = GAME_DAY_TIME

_G.TimeUtil.SECOND_OF_DAY = SECOND_OF_DAY
_G.TimeUtil.SECOND_OF_HOUR = SECOND_OF_HOUR

local GetNowUnixTime = CS.YoukiaCore.TimeKit.GetNowUnixTime

---时区值转UTC+00:00小时数偏移
---@param timeZone number 时区(可为负数, 800表示: UTC+08:00, 645表示: UTC+06:45)
---@return number
local function getUTCOffsetHour(timeZone)
    local less0 = timeZone < 0
    if less0 then
        timeZone = -timeZone --转为正数计算
    end

    local hour = math.floor(timeZone / 100)
    local min = timeZone % 100

    local offsetHour = hour + min / 60
    if less0 then
        offsetHour = -offsetHour
    end
    return offsetHour
end

---初始化时区信息
---@param serverTimeZone number 服务器时区(可为负数, 800表示: UTC+08:00, 645表示: UTC+06:45)
function TimeUtil.InitTimeZone(serverTimeZone)
    RawServerTimeZone = serverTimeZone
    ServerTimeZone = getUTCOffsetHour(serverTimeZone)
    ClientTimeZone = getUTCOffsetHour(tonumber(os.date("%z")))

    if _G.AppSetting.DEBUG then
        _G.Log(ServerTimeZone, "服务器时区")
        _G.Log(ClientTimeZone, "客户端时区")
    end

    TimeZoneOffsetSeconds = math.floor((ServerTimeZone - ClientTimeZone) * SECOND_OF_HOUR)
    TimeZoneOffset.hour = math.floor(TimeZoneOffsetSeconds / SECOND_OF_HOUR)
    TimeZoneOffset.min = math.floor((TimeZoneOffsetSeconds % SECOND_OF_HOUR) / SECOND_OF_MINUTE)

    if _G.AppSetting.DEBUG then
        _G.Log(
            string.format(
                "初始化服务器时区: %s, 本地时区: %s, 时区相差秒数: %s",
                serverTimeZone,
                tonumber(os.date("%z")),
                TimeZoneOffsetSeconds
            )
        )
    end
end

---获取客户端与服务器时区偏移值(秒数)
function TimeUtil.GetTimeZoneOff()
    return TimeZoneOffsetSeconds
end

---服务器时区
function TimeUtil.GetRawServerTimeZone()
    local fh = RawServerTimeZone > 0 and "+" or "-"
    local z = math.floor(math.abs(RawServerTimeZone) / 100)
    local y = math.abs(RawServerTimeZone) % 100
    return fh .. string.format("%02d:%02d", z, y)
end

---(服务器时区)获取当前时间戳
---@param date table|std.osdateparam?    [可选]时间格式
---@return number
function TimeUtil.time(date)
    return os.time(date) + TimeZoneOffsetSeconds
end

---(服务器时区)格式化时间, 返回包含日期和时间的字符串或表(foramt传参不同, 返回值不同)
---@param format string
---@param time number?    时间戳
---@return string|std.osdate
function TimeUtil.date(format, time)
    if time and time > 0 then
        time = time + TimeZoneOffsetSeconds
    else
        time = TimeUtil.time()
    end
    return os.date(format, time)
end

---(服务器时区转本地时区)获取当前时间戳
---@param date table|std.osdateparam?   [可选]时间格式
---@return number
function TimeUtil.timeReverse(date)
    return os.time(date) - TimeZoneOffsetSeconds
end

---(服务器时区转本地时区)格式化时间
---@param format string
---@param time number?    时间戳
function TimeUtil.dateReverse(format, time)
    if time then
        time = time - TimeZoneOffsetSeconds
    else
        time = TimeUtil.timeReverse()
    end
    return os.date(format, time)
end

---取得服务器时间戳
function TimeUtil.GetServerUnixTime()
    return GetNowUnixTime()
end

---往前追朔到某一天的零点, 单位秒数
---@return number
function TimeUtil.GetDayBegin(time)
    local timetable = TimeUtil.date("*t", time)
    timetable.hour = 0
    timetable.min = 0
    timetable.sec = 0

    return TimeUtil.timeReverse(timetable)
end

---往前追朔到某一天的6点, 单位秒数
---@return number
function TimeUtil.GetDayBySix(time)
    local timetable = TimeUtil.date("*t", time)
    if timetable.hour < _G.TimeUtil.GAME_DAY_HOUR then
        timetable = TimeUtil.date("*t", time - 86400)
    end
    timetable.hour = _G.TimeUtil.GAME_DAY_HOUR
    timetable.min = 0
    timetable.sec = 0

    return TimeUtil.timeReverse(timetable)
end

--当前是一天的第几秒
function TimeUtil.GetSecondsOfDay()
    local now = CS.YoukiaCore.TimeKit.GetNowUnixTime()
    local zero = TimeUtil.GetDayBegin(now)
    return now - zero
end

--当前是一天的第几秒 一天6点启始
function TimeUtil.GetSecondsOfDayOf6Hour()
    return TimeUtil.GetSecondsOfDay() - GAME_DAY_TIME
end

--获取间隔的天数
function TimeUtil.GetIntervalDay(timeBegin, tiemEnd)
    local dayBegTime1 = TimeUtil.GetDayBegin(timeBegin)
    local dayBegTime2 = TimeUtil.GetDayBegin(tiemEnd)
    return math.floor((math.abs(dayBegTime2 - dayBegTime1) + 1) / SECOND_OF_DAY)
end

--获取间隔的天数
function TimeUtil.GetIntervalDayBySix(timeBegin, tiemEnd)
    local dayBegTime1 = TimeUtil.GetDayBySix(timeBegin)
    local dayBegTime2 = TimeUtil.GetDayBySix(tiemEnd)
    return dayBegTime2 - dayBegTime1
end

--获取间隔的天数
function TimeUtil.GetIntervalDayBySix1(timeBegin, tiemEnd)
    local dayBegTime1 = TimeUtil.GetDayBySix(timeBegin)
    local dayBegTime2 = TimeUtil.GetDayBySix(tiemEnd)
    return math.floor((math.abs(dayBegTime2 - dayBegTime1) + 1) / SECOND_OF_DAY)
end

---获取间隔天数，和游戏业务跨天挂钩
---@param tb number 时间戳
---@param te number 时间戳
---@return number 间隔天数
function TimeUtil.GetInterValDayByGame(tb, te)
    local day = 0
    if tb > te then
        tb = tb + te
        te = tb - te
        tb = tb - te
    end
    local t1 = TimeUtil.date("*t", tb)
    local t2 = TimeUtil.date("*t", te)
    t1 = t1.hour * SECOND_OF_HOUR + t1.min * SECOND_OF_MINUTE + t1.sec
    t2 = t2.hour * SECOND_OF_HOUR + t2.min * SECOND_OF_MINUTE + t2.sec
    if t1 > t2 then
        if t2 >= GAME_DAY_TIME or t1 < GAME_DAY_TIME then
            day = day + 1
        end
    elseif t1 < t2 then
        if t1 < GAME_DAY_TIME and t2 >= GAME_DAY_TIME then
            day = day + 1
        end
    end
    t1 = te - tb
    t1 = _G.Mathf.Floor(t1 / SECOND_OF_DAY)
    day = day + t1
    return day
end

--将秒数转换为：00:00:00
function TimeUtil.TimeToString(time, flag)
    local sec = math.floor(time % SECOND_OF_MINUTE)
    local min = math.floor(time / 60) % 60
    local hour = math.floor(time / SECOND_OF_HOUR)
    local day = math.floor(time / SECOND_OF_DAY)
    if flag == 1 then
        return string.format("%02d:%02d:%02d", hour, min, sec)
    elseif flag == 2 then
        return string.format("%02d:%02d", min, sec)
    elseif flag == 3 then
        return string.format("%02d:%02d", hour, min)
    elseif flag == 4 then
        return string.format("%02d:%02d:%02d", day, hour, min)
    end
end

--%s时%s分%s秒或者%s分%s秒
function TimeUtil.TimeToStringHMS(time)
    local h = math.floor(time / 3600)
    local m = math.floor((time % 3600) / 60)
    local s = math.floor((time % 3600) % 60)
    if h > 0 then
        return _G.GetLangPackValue(90021800030, h, m, s)
    else
        return _G.GetLangPackValue(90021800086, m, s)
    end
end

