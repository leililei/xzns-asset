---判断是否存在
---@param audioTypeEnum string audioClip 的 Id
---@return path  路径
function AudioManager.IsHadAudioClip(audioTypeEnum)
    local path, count
    if audioTypeEnum > 0 then
        local cfg = _G.ConfigManager.audio_cfg[audioTypeEnum]
        if cfg then
            path = cfg.audio_res
            count = cfg.audio_Looptime
        end
    end
    return path, count
end

