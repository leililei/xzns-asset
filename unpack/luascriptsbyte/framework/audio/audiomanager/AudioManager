--region --------------------------------------对话系统 台词 音效--------

function AudioManager.Dialogue_PlayPath(path,BackRoundMusicSize)
    if _G.string.IsNullOrEmpty(path) then
        return
    end
    if timer then
        _G.coroutine.stopwaiting(timer)
        timer = nil
    end
    if BackRoundMusicSize ~= nil then
        _G.CS.FrameWork.AudioManager.Instance:PlaySound(path,function(AudioClip)
            local length = AudioClip.length
            AudioManager.SetMusicVolume(BackRoundMusicSize * CurMusicVolume)
            timer = _G.DelayDo(length,function()
                AudioManager.RestoreBackgroundMusic()
                timer = nil
            end)
        end)
    else
        _G.CS.FrameWork.AudioManager.Instance:PlaySound(path)
    end
end

function AudioManager.RefreshCurMusicVolume()
    CurMusicVolume = AudioManager.GetMusicVolume()
end

function AudioManager.RestoreBackgroundMusic()
    AudioManager.SetMusicVolume(CurMusicVolume)
end

function AudioManager.Dialogue_StopPath(path)
    if _G.string.IsNullOrEmpty(path) then
        return
    end
    _G.CS.FrameWork.AudioManager.Instance:StopSound(path)
end

---@param path string 音效地址
---@param key AudioSaveKey 音效储存关键字
function AudioManager.Dialogue_PlayPathWithKey(path, key)
    if _G.string.IsNullOrEmpty(path) then
        return
    end
    PlayPathKeys[key] = path
    _G.CS.FrameWork.AudioManager.Instance:PlaySound(path)
end

--endregion
---检测音效是否播放
function AudioManager.CheckIsPlay(path)
    if _G.string.IsNullOrEmpty(path) then
        return false
    end
    local strTb = string.split(path, "/")
    return _G.CS.FrameWork.AudioManager.Instance:CheckSoundIsPlay(strTb[#strTb])
end

---检测音效是否播放
---@param key AudioSaveKey
function AudioManager.CheckIsPlayWithKey(key)
    if _G.string.IsNullOrEmpty(key) or _G.string.IsNullOrEmpty(PlayPathKeys[key]) then
        return false
    end
    return AudioManager.CheckIsPlay(PlayPathKeys[key])
end

return AudioManager
