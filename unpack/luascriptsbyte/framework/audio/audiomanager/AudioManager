---通过audio_cfg播放音效
---@param sid number audio_cfg ID
function AudioManager.PlayAudioByAudioCfgID(sid, speed)
    local cfg
    if sid ~= 0 then
        cfg = _G.ConfigManager.audio_cfg[sid]
    end
    if not cfg then
        return
    end

    AudioManager.PlayAudio(cfg.audio_type, sid, speed, cfg.isLoop or false)
end

---CallLuaCSBattleReopenClick
function AudioManager.CallLuaCSPlayAudioByAudioCfgID(sid)
    AudioManager.PlayAudioByAudioCfgID(sid)
end

_G.CS.GameAudioManager.CallLuaCSPlayAudioByAudioCfgID = AudioManager.CallLuaCSPlayAudioByAudioCfgID

---获取音乐、音效
---@param audioType number 音乐、音效
---@param audioTypeEnum number 通用点击、点击切换、提示音效、页面切换、选中、界面弹出等
---@param isLoop boolean 音乐是否循环
function AudioManager.PlayAudio(audioType, audioTypeEnum, speed, isLoop, callback)
    if audioType == _G.AudioType.PlayMusic then
        AudioManager.PlayAudioMusic(audioTypeEnum, isLoop)
    elseif audioType == _G.AudioType.PlaySound then
        AudioManager.PlayAudioSound(audioTypeEnum, speed, callback)
    end
end

---播放音效
---@param audioTypeEnum string  AudioClip 的 Id
function AudioManager.PlayAudioSound(audioTypeEnum, speed, callback)
    --
    if _G.AppSetting.DEBUG then
        _G.Log(audioTypeEnum, "<color=red>" .. "音频id" .. "</color>")
    end
    local path, count = AudioManager.IsHadAudioClip(audioTypeEnum)
    if path then
        if _G.AppSetting.DEBUG then
            _G.Log(path, "<color=red>" .. "音频地址" .. "</color>")
        end
        _G.CS.FrameWork.AudioManager.Instance:PlaySound(
            path,
            function(AudioClip)
                local length = AudioClip.length
                if callback then
                    _G.DelayDo(
                        length,
                        function()
                            callback()
                        end
                    )
                end
                return AudioClip
            end,
            1,
            nil,
            speed or 1,
            count
        )
    end
end

---播放背景音乐
function AudioManager.PlayAudioMusic(audioTypeEnum, isLoop)
    if isLoop == nil then
        isLoop = true
    end

    if _G.AppSetting.DEBUG then
        _G.Log(audioTypeEnum, "<color=red>" .. "音频id" .. "</color>")
    end
    local path = AudioManager.IsHadAudioClip(audioTypeEnum)
    if not path then
        return
    end

    AudioManager.endPath = path

    if _G.AppSetting.DEBUG then
        _G.Log(path, "<color=red>" .. "音频地址" .. "</color>")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(pathIng, "<color=red>" .. "音频地址" .. "</color>")
    end
    if path then
        if _G.CS.FrameWork.AudioManager.Instance:IsPlaying() then
            if pathIng ~= path then
                if _G.AppSetting.DEBUG then
                    _G.Log(_G.CS.FrameWork.AudioManager.Instance:IsSame(path))
                end
                if not _G.CS.FrameWork.AudioManager.Instance:IsSame(path) then
                    pathIng = path
                    _G.CS.FrameWork.AudioManager.Instance:FadeOutlMusic(
                        2,
                        function()
                            pathIng = ""
                            AudioManager.MusicID = audioTypeEnum
                            _G.CS.FrameWork.AudioManager.Instance:PlayfadeinMusic(AudioManager.endPath, 1, isLoop)
                        end
                    )
                else
                    if _G.AppSetting.DEBUG then
                        _G.Log(path, "音乐重了")
                    end
                end
            end
        else
            AudioManager.MusicID = audioTypeEnum
            _G.CS.FrameWork.AudioManager.Instance:PlayfadeinMusic(AudioManager.endPath, 1, isLoop)
        end
    end
end

---淡出背景音乐
function AudioManager.FadeOutlMusic()
    if _G.CS.FrameWork.AudioManager.Instance:IsPlaying() then
        _G.CS.FrameWork.AudioManager.Instance:FadeOutlMusic(
            2,
            function()
                pathIng = ""
            end
        )
    end
end

