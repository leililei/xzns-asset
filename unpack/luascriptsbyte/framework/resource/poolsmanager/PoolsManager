---@param callback fun(obj:UnityEngine.Transform) 加载物体后的回调
function PoolsManager:Spawn(resPath, poolType, parent, callback)
    assert(
        resPath ~= nil and type(resPath) == "string" and #resPath > 0,
        string.format('PoolsManager: can not spawn, resPath "%s".', resPath)
    )
    local _poolName = self:GetPoolName(poolType)
    --local _pool = self:GetPool(_poolName)
    --_G.PoolsManagerCsListener.AddCalls(resPath, callback)

    CSPoolsManager:LoadObjectFromPool(
        resPath,
        parent,
        function(path, trans)
            if callback then
                callback(trans, path)
            end
        end,
        _poolName
    )

    --if (_pool ~= nil) then
