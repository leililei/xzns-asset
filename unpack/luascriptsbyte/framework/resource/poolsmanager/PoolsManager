--- DestoryPool 删除指定对象池子
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
function PoolsManager:DestoryPool(poolType)
    local _poolName = self:GetPoolName(poolType)
    return CSPoolsManager:DestroyPool(_poolName)
end

--- DestoryAllPool 删除所有对象池子
function PoolsManager:DestoryAllPool()
    for key, value in pairs(_G.ePoolType) do
        local _poolName = self:GetPoolName(value)
        CSPoolsManager:DestroyPool(_poolName)
    end
end

--- Preload 预加载
---@param resPath string 对象路径
---@param callback function 加载后的回调
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
---@param poolType modifyPosition 是否改变位置
---@param poolType maxCount 缓存最大数量，当这个值大于池中数量，则创建一个
function PoolsManager:Preload(resPath, callback, poolType, modifyPosition, maxCount)
    modifyPosition = modifyPosition or true
    maxCount = maxCount or 1
    CSPoolsManager:CacheObjToPool(
        resPath,
        function(obj)
            if callback then
                callback(obj)
            end
        end,
        poolType,
        modifyPosition,
        maxCount
    )
end

--- Spawn 从对象池取出对象
---@param resPath string 对象路径
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
