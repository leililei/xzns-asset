---GetPrefabPool 获取对应资源的资源池
---@param resPath string 资源路径
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
function PoolsManager:GetPrefabPool(resPath, poolType)
    assert(
        resPath ~= nil and type(resPath) == "string" and #resPath > 0,
        string.format('PoolsManager: can not spawn, resPath "%s".', resPath)
    )

    local _poolName = self:GetPoolName(poolType)
    local _pool = self:GetPool(_poolName)
    return _pool:GetPrefabPool(resPath)
end

--创建对应的资源池
--"cfg": 资源池配置信息
--[[
"mode": eDespawnMode 回收模式类型
"resPath": 资源路径(必填)
"poolType": 对象池类型,参见ePoolType，默认Default
"preloaded": 启用预加载,false启用,默认启用
"preloadAmount": 预加载资源数量,默认1
"preloadTime": 启用随时间预加载,true启用,默认不启用
"preloadFrames": 预加载所有资源,所需的总帧数,默认2
"preloadDelay": 延迟几秒执行预加载,默认0
"limitInstances": 启用实例数量限制,true启用,默认不启用
"limitAmount": 限制的实例数量,默认100
"limitFIFO": 启用该设置会导致,新将要生成的实例将使用第一个生成的实例,true启用,默认不启用
"cullDespawned": 启用筛选生成功能,true启用,默认不启用
"cullAbove": 筛选功能保持的实例总数量(生成的+卸载的)
"cullDelay": 筛选前等待的时间(以秒为单位)。
这是从队列的总计数(生成的+卸载的)大于上面的"cullAbove"时开始计时的。
一旦触发，计时器将重复执行，直到计数低于"上面的筛选"
"cullMaxPerPass": 每次筛选等待时间,删除的最大实例数量
 example:
        CreatePrefabPool({
            resPath = resPath,
            poolType = _poolName,
            preloaded = true,
            cullDespawned = true,
            cullAbove = 0,
            cullDelay = 10,
            cullMaxPerPass = 100
            })
]]
---CreatePrefabPool 创建对象池
---@param cfg pool_setting
---@param callback function
function PoolsManager:CreatePrefabPool(cfg, callback)
    local _resPath = cfg.resPath
    assert(
        _resPath ~= nil and type(_resPath) == "string" and #_resPath > 0,
        string.format('PoolsManager: can not spawn, resPath "%s".', _resPath)
    )
    local _poolName = self:GetPoolName(cfg.poolType)
    local _pool = self:GetPool(_poolName)
    local _prefabPool = CS.PathologicalGames.PrefabPool(_resPath)
    if cfg.mode ~= nil then
        assert(
            type(cfg.mode) == "number",
            string.format('PoolsManager: create prefab mode faild, "%s" type is not "%s".', "mode", "number")
        )
        _prefabPool.mode = cfg.mode
    end

    if cfg.preloaded ~= nil then
        assert(
            type(cfg.preloaded) == "boolean",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "preloaded", "boolean")
        )
        _prefabPool.preloaded = cfg.preloaded
    end

    if cfg.preloadAmount ~= nil then
        assert(
            type(cfg.preloadAmount) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "preloaded", "number")
        )
        _prefabPool.preloadAmount = cfg.preloadAmount
    end

    if cfg.preloadTime ~= nil then
        assert(
            type(cfg.preloadTime) == "boolean",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "preloadTime", "boolean")
        )
        _prefabPool.preloadTime = cfg.preloadTime
    end

    if cfg.preloadFrames ~= nil then
        assert(
            type(cfg.preloadFrames) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "preloadFrames", "number")
        )
        _prefabPool.preloadFrames = cfg.preloadFrames
    end

    if cfg.preloadDelay ~= nil then
        assert(
            type(cfg.preloadDelay) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "preloadDelay", "number")
        )
        _prefabPool.preloadDelay = cfg.preloadDelay
    end

    if cfg.limitInstances ~= nil then
        assert(
            type(cfg.limitInstances) == "boolean",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "limitInstances", "boolean")
        )
        _prefabPool.limitInstances = cfg.limitInstances
    end

    if cfg.limitAmount ~= nil then
        assert(
            type(cfg.limitAmount) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "limitAmount", "number")
        )
        _prefabPool.limitAmount = cfg.limitAmount
    end

    if cfg.limitFIFO ~= nil then
        assert(
            type(cfg.limitFIFO) == "boolean",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "limitFIFO", "boolean")
        )
        _prefabPool.limitFIFO = cfg.limitFIFO
    end

    if cfg.cullDespawned ~= nil then
        assert(
            type(cfg.cullDespawned) == "boolean",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "cullDespawned", "boolean")
        )
        _prefabPool.cullDespawned = cfg.cullDespawned
    end

    if cfg.cullAbove ~= nil then
        assert(
            type(cfg.cullAbove) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "cullAbove", "number")
        )
        _prefabPool.cullAbove = cfg.cullAbove
    end

    if cfg.cullDelay ~= nil then
        assert(
            type(cfg.cullDelay) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "cullDelay", "number")
        )
        _prefabPool.cullDelay = cfg.cullDelay
    end

    if cfg.cullMaxPerPass ~= nil then
        assert(
            type(cfg.cullMaxPerPass) == "number",
            string.format('PoolsManager: create prefab pool faild, "%s" type is not "%s".', "cullMaxPerPass", "number")
        )
        _prefabPool.cullMaxPerPass = cfg.cullMaxPerPass
    end

    if cfg.isUsedBasePrefab ~= nil then
        assert(
            type(cfg.isUsedBasePrefab) == "boolean",
            string.format(
                'PoolsManager: create prefab pool faild, "%s" type is not "%s".',
                "isUsedBasePrefab",
                "boolean"
            )
        )
        _prefabPool.isUsedBasePrefab = cfg.isUsedBasePrefab
    end

    -- 调用c#
    --if isPreload then
    if (_pool ~= nil) then
        _pool:LoadPrefabPool(_prefabPool, callback)
    end
    --end
end

function PoolsManager:isCSPoolsManagerNil()
    return _G.IsNil(CSPoolsManager)
end

function PoolsManager:Dispose()
    CSPoolsManager:DestoryAll()
end

return PoolsManager
