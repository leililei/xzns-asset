    Deactivate = 0,
    Move = 1,
    Scale = 2
}
_G.eDespawnMode = eDespawnMode

setmetatable(
    ePoolType,
    {
        __newindex = function()
            error('PoolsManager: can not dynamic modify "ePoolType".', 2)
        end
    }
)

local CSPoolsManager

function PoolsManager:__init()
    CSPoolsManager = CS.FrameWork.FPoolManager.Instance
    -- 默认创建的池子
    for _, value in pairs(ePoolType) do
        self:CreatePool(value)
    end
end

--- GetPoolName 对象池名字获取
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
function PoolsManager:GetPoolName(poolType)
    if not poolType == nil then
        return ePoolType.Default
    end
    assert(ePoolType[poolType] ~= nil, "PoolsManager: pool type is undefined.")
    return poolType
end

--- CreatePool 创建对象池子
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
function PoolsManager:CreatePool(poolType)
    local _poolName = self:GetPoolName(poolType)
    CSPoolsManager:CreatePool(_poolName)
    --self.pools[_poolName] = _pool
