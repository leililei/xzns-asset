-- 只提供异步接口
-- 所有lua 层脚本都只能从这里获取接口,保证接口统一性
---@class ResourcesManager:Singleton
---@field GetInstance fun():ResourcesManager
local ResourcesManager = _G.BaseClass("ResourcesManager", _G.Singleton)
_G.ResourcesManager = ResourcesManager

local CS = _G.CS
-- local ResourceManagerCsListener
local CSAssetBundleManager

function ResourcesManager:__init()
    CSAssetBundleManager = CS.FrameWork.AssetBundleManager.Instance
end

---LoadGameObjAsync 异步加载Asset并实例化：回调形式
---@param path string @资源路径
---@param callback function @回调方法
---@param parent Transform 父级节点
---@param ... callback 的参数数组
---@return GameObject
function ResourcesManager:LoadGameObjAsync(path, callback, parent, ...)
    assert(path ~= nil and type(path) == "string" and #path > 0, "path err : " .. path)
    assert(callback ~= nil and type(callback) == "function", "Need to provide a function as callback")
    local args = _G.SafePack(nil, ...)
    _G.ResourceManagerCsListener.AddCalls(
        path,
        function(_transform)
            if _G.IsNil(_transform) then
                if _G.AppSetting.DEBUG then
                    _G.LogError("Asset load err : " .. path)
                end
            else
                args[1] = _transform
                callback(_G.SafeUnpack(args))
            end
        end
    )
    CSAssetBundleManager:LoadPrefabInstance(path, parent)
end

local AssetProcess = function(path, callback, object)
    assert(object, "object 绑定对象不能为空")
    assert(path ~= nil and type(path) == "string" and #path > 0, "path err : " .. path)
    assert(callback ~= nil and type(callback) == "function", "Need to provide a function as callback")
    _G.ResourceManagerCsListener.AddCalls(
        path,
        function(asset, resRef)
            if _G.IsNil(asset) then
                if _G.AppSetting.DEBUG then
                    _G.LogError("Asset load err : " .. path)
                end
            else
                callback(asset, resRef)
            end
        end
    )
end

function ResourcesManager:LoadTexture(path, callback, object)
    AssetProcess(path, callback, object)
    CSAssetBundleManager:LoadTexture(path)
end

function ResourcesManager:LoadMaterial(path, callback, object)
    AssetProcess(path, callback, object)
    CSAssetBundleManager:LoadMaterial(path)
end

function ResourcesManager:LoadAnimationClip(path, callback, object)
    AssetProcess(path, callback, object)
    CSAssetBundleManager:LoadAnimationClip(path)
end

function ResourcesManager:LoadAudioClip(path, callback, object)
    AssetProcess(path, callback, object)
    CSAssetBundleManager:LoadAudioClip(path)
end

function ResourcesManager:LoadText(path, callback, object)
    AssetProcess(path, callback, object)
    CSAssetBundleManager:LoadText(path)
end

function ResourcesManager:LoadScriptableObject(path, callback, object)
    AssetProcess(path, callback, object)
    CSAssetBundleManager:LoadScriptableObject(path)
end

---GameObjInstant 实例化GameObj
---@return GameObject
function ResourcesManager:GameObjInstant(obj, parent)
    if nil ~= obj then
        return CSAssetBundleManager:InstantGameObj(obj, parent)
    end
end

---UnloadUnusedAssets 清理未使用资源
function ResourcesManager:UnloadUnusedAssets()
    CSAssetBundleManager:UnloadUnusedAssets(nil)
end
