local BaseWorld = require "BaseWorld"
---@class SimpleWorld:BaseWorld 小场景
---@field public AllWorldItems WorldBaseItem[] 场景中所有的显示对象
---@field public Procedure Procedure 场景加载状态机
---@field public Transform UnityEngine.Transform Transform
---@field public GameObject UnityEngine.GameObject GameObject
---@field public ItemRoot UnityEngine.Transform ItemRoot
---@field public Cfg SceneCfg_Item
local SimpleWorld = _G.BaseClass("SimpleWorld", BaseWorld)

---初始化主角
---@param callback function 完成回调
function SimpleWorld:InitPlayer(op)
    local mself = self
    local function endCall()
        -- mself.WorldPlayer:InitFootShadow()
        op.option = _G.Opearation.Close
    end
    self:InitPlayerBySid(endCall, 0)
end

---初始化场景物件
---@param op Opearation 状态
function SimpleWorld:InitObjs(op)
    local _datas = self.ItemDataList
    if #_datas <= 0 then
        op.option = _G.Opearation.Close
        return
    end
    local index = 0
    ---@param item WorldBaseItem item
    local cb = function(item)
        self.AllWorldItems[item.Uid] = item
        -- if item.Cfg.Type1 ~= _G.WorldItemType.Barrier then
        --     item:InitFootShadow()
        -- end
        index = index + 1
        if index >= #_datas then
            op.option = _G.Opearation.Close
        end
    end
    ---@type WorldItemDataItem value
    for _, value in pairs(_datas) do
        local itemType = value.ItemType
        local item = self:CreateWorldItem(itemType, value, cb)
        if item and item.Init then
            item:Init()
        end
    end
end

function SimpleWorld:InstPlayer()
    local isInitPlayer = false
    local sids = _G.ChapterRoomManager:GetInstance():GetSceneRunPlayer()
    if not sids or sids == 0 then
        return
    end
    self.WorldPlayer:SetModelPath(nil, sids, require "CardCommentManager":GetInstance():GetCfgs(sids).ModelPathLow)
    self.AllWorldItems[self.WorldPlayer.Uid] = self.WorldPlayer
end

function SimpleWorld:InstAllItem()
    self:InstPlayer()
    BaseWorld.InstAllItem(self)
end
-----释放主角
function SimpleWorld:DisablePlayer()
    if self.WorldPlayer then
        self.WorldPlayer:OnExitWorld()
    end
end
-----显示主角
function SimpleWorld:EnablePlayer()
    if self.WorldPlayer then
        self.WorldPlayer:OnEnterWorld()
    end
end
function SimpleWorld:ShowOrHideAllItem(show)
    if show then
        self:InstPlayer()
    end
    BaseWorld.ShowOrHideAllItem(self, show)
    if not show then
        self.AllWorldItems[self.WorldPlayer.Uid] = nil
    end
end

-----进入世界
function SimpleWorld:EnterWorld(immediately)
    self:InstWorld()
    self:InstAllItem()
    self:Visible(true, false, false)
    self:InitObjectAlphaCheck()
    self:StartObjectAlphaCheck()
    self:OnChangeWorldOver()
    self:ChangeCameraBattle()
    self:OpenShadowPlane(true)
    if immediately then
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    end
end
---切换探索镜头
function SimpleWorld:ChangeCameraBattle()
    local searchCameraStr = self.Cfg.Camera_Type2
    if _G.string.IsNullOrEmpty(searchCameraStr) then --判定是否有战斗相机配置数据
        return
    end
    local num = tonumber(string.match(searchCameraStr, "%d+"))
    self.WorldSetting:ChangeCameraParams("Cameras/" .. searchCameraStr .. "/Camera", num)
end
---打开投影
function SimpleWorld:OpenShadowPlane(open)
    self.WorldSetting:OpenShadowPlane(open and 1 or 0)
end

