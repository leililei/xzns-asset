---初始化名称缩放
function SimpleWorld:InitTitleScaleData()
    ---头顶名称的缩放范围
    self.titleScaleRange = _G.ConfigManager.discrete_cfg[103507]
    local titleScaleOneDis = self.titleScaleRange[2][2]
    local titleScaleOneFov = 45
    local pi = 3.1416 / 180
    titleScaleOneDis =
        titleScaleOneDis * Mathf.Tan(titleScaleOneFov * pi) /
        Mathf.Tan(_G.GraphicsManager.Instance.MainCamera.fieldOfView * pi)
    self.titleScaleRange = _G.DeepCopyCfgTable(self.titleScaleRange[1])
    self.titleScaleRange[1] = titleScaleOneDis / self.titleScaleRange[1] * 100
    self.titleScaleRange[2] = titleScaleOneDis / self.titleScaleRange[2] * 100
    if self.titleScaleRange[1] > self.titleScaleRange[2] then
        titleScaleOneDis = self.titleScaleRange[1]
        self.titleScaleRange[1] = self.titleScaleRange[2]
        self.titleScaleRange[2] = titleScaleOneDis
    end
end

