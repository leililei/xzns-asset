---@class GhostManager : Singleton 幽灵场景管理类
---@field public DoorSid number 下个场景的传送门sid
local GhostManager = _G.BaseClass("GhostManager", _G.Singleton)
---@return GhostManager GhostManager
local table = _G.table
local city_display_cfg = _G.ConfigManager.city_display_cfg
function GhostManager:GetInstance()
    return self.super.GetInstance(self)
end
function GhostManager:__init(obj)
    self:CreateRoot(obj.GameObject)
end
---设置幽灵父节点
function GhostManager:CreateRoot(go)
    local _obj = _G.GameObject()
    _obj:SetName("AllGhostRoot")
    self.GhostRoot = _obj
    self.GhostRoot:SetParentE(go)
    self:Init()
end
function GhostManager:Dispose()
    self.GhostRoot = nil
    self.curWorld = nil
    self.AllGhostList = nil
end
function GhostManager:Init()
    local startPos
    self.curWorld = _G.WorldManager:GetInstance():GetCurWorld()
    if not self.AllGhostList then
        self.AllGhostList = {}
        for i = 1, #city_display_cfg do
            if city_display_cfg[i].type == 1 then
                local startPosList = _G.DeepCopyCfgTable(city_display_cfg[i].birthplace)
                for j = 1, city_display_cfg[i].num do
                    startPos = table.remove(startPosList, _G.math.random(1, #startPosList))
                    local item_data = _G.WorldItemData.New()
                    item_data.InitPoint = {
                        [1] = {
                            ["p_x"] = startPos[1],
                            ["p_y"] = 1,
                            ["p_z"] = startPos[2],
                            ["r_x"] = 0,
                            ["r_y"] = 0,
                            ["r_z"] = 0
                        }
                    }
                    item_data.IsMove = true
                    item_data.IsInShadow = false
                    item_data.IsHidden = false
                    item_data.EnterFightId = 0
                    item_data.ResPath = ""
                    item_data.EventId = 0
                    item_data.index = j
                    item_data.way = i
                    item_data.Uid = i * 100 + j
                    local info = {}
                    info.itemType = _G.WorldItemType.Ghost
                    info.uid = i * 100 + j
                    info.GhostRoot = self.GhostRoot
                    info.callback = function(_item)
                        self.curWorld.AllWorldItems[i * 100 + j] = _item
                        self.AllGhostList[i * 100 + j] = _item
                        _item:EnterWorld()
                    end
                    local item = require("WorldGhostItem").New(info, item_data, self.curWorld)
                    item:Init()
                end
            end
        end
    end
end
return GhostManager
