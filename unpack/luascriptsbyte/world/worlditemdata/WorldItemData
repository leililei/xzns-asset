---@class WorldItemData	世界物体的数据本地数据
---@field public InitPoint table<string,Int2>   起始位置集合<RouteID, 位置> 当为随机时,肯定有多个初始位置
---@field public IsMove boolean IsMove
---@field public IsInShadow boolean 是否在阴影中
---@field public ItemType WorldItemType 物件类型
---@field public Name string 名称
---@field public RoutePoints table<string, table<Int2[]>>  前端移动点位集合<RouteID, 移动点位集合>  当不可移动时,没有值;当可移动时,至少有一条移动路线
---@field public Sid number 表id
---@field public ResPath string 资源路径
---@field public Uid number Uid
local WorldItemData = _G.BaseClass("WorldItemData")
_G.WorldItemData = WorldItemData

---构造函数
function WorldItemData:__init()
    self.ResPath = ""
    self.Uid = 0
end
---析构函数
function WorldItemData:Dispose()
    self.Uid = nil
    self.ResPath = nil
end

---克隆本地配置数据
---@param itemData itemData 世界物体表数据
function WorldItemData:CloneData(itemData)
    for key, value in pairs(itemData) do
        self[key] = value
    end
end
---函数功能注释
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function WorldItemData:DynamicData()
end

return WorldItemData
