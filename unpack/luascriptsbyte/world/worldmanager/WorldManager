---进入世界场景
---@param sid number 世界Sid
---@param callback function 打开场景prefab后的回调
---@param doorSid number 下个场景的传送门sid
---@param doneCall function 关闭加载界面后的回调
---@param cacheSids table 需要缓存的场景sid数组
---@param immediately boolean 是否立即切换(不用镜头移动)
function WorldManager:EnterWorld(sid, callback, doorSid, doneCall, cacheSids, immediately)
    if self.Running then
        return
    end
    -- 防止重复加载同一场景
    if self.curSceneSid and self.curSceneSid == sid then
        if callback then
            callback()
        end
        return
    end
    self.enterImmediately = immediately
    -- if self.curSceneSid ~= nil and self.curSceneSid > 0 then
    --     local cfg = _G.ConfigManager.scene_cfg
    --     if cfg[self.curSceneSid] ~= nil and cfg[self.curSceneSid].Scene_Type == _G.SceneType.MainWorld then
    -- _G.PlayerModel:GetInstance():WritePosRecord(
    --     self.curSceneSid,
    --     self:GetCurWorldPlayer().Transform:GetPosition()
    -- )
    --     end
    -- end
    self.lastSceneSid = self.curSceneSid
    if immediately then
        self:HideLastScene()
    end
    self.curSceneSid = sid
    self.LoadedCallBack = callback
    self.DoneCallback = doneCall
    self.cacheSids = cacheSids or {sid}
    self.Running = true
    --切场景把角色位置重置
    _G.PlayerModel:GetInstance():ResetPos()
    _G.Events:GetInstance():Broadcast(_G.eScene.EnterWorldStart)
    self.DoorSid = doorSid
    self.stopCoProgress = _G.coroutine.start(_G.handler(self, self.CoProgressSwitchWorld))
end
