end
---对比当前世界类型
---@type SceneType 世界类型 _G.SceneType.Section
---@return boolean 和当前世界场景类型是否一致
function WorldManager:CheckSceneType(SceneType)
    if _G.IsNil(self.CurrentWorld) then
        return false
    end
    return self.CurrentWorld.Cfg.Scene_Type == SceneType
end

---对比当前场景的类型
---新增的一个函数，将类型赋值改到更前面，保证世界物体使用判定时更准确
function WorldManager:CheckCurSceneType(SceneType)
    if nil == self.CurSceneType then
        return false
    end
    return self.CurSceneType == SceneType
end
---获取当前世界场景是否显示
---@return boolean 是否显示
function WorldManager:GetCurWorldShow()
    if self.CurrentWorld then
        local cfg = _G.ConfigManager.scene_cfg[self.CurrentWorld.Sid]
        if cfg.WorldType == _G.WorldType.MainWorld then
            return _G.UIManager:GetInstance():IsActiveWindow(cfg.Res)
        else
            return self.CurrentWorld.GameObject:GetActiveSelf() == 1
        end
    end
    return false
end
