---@param visible boolean
function WorldManager:SetCurrentWorldVisible(visible)
    if not _G.AppSetting.IsloadScence and self.CurrentWorld then
        self:SetBaseViewVisible(visible)
        return
    end
    if _G.AppSetting.DEBUG then
        _G.Log("WorldManager:SetCurrentWorldVisible")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(visible, "是否显示主城")
    end

    if self.CurrentWorld then
        if visible then
            self:LoadScenceStory(
                function()
                    self.CurrentWorld:Visible(visible)
                    self:SetBaseViewVisible(visible)
                end
            )
        else
            self.CurrentWorld:Visible(visible)
            self:SetBaseViewVisible(visible)
        end
    end
end
