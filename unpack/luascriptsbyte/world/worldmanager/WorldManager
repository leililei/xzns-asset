---@return WorldManager WorldManager
function WorldManager:GetInstance()
    return self.super.GetInstance(self)
end
function WorldManager:__init()
    self.CurrentWorld = nil
    self.CurSceneType = nil
    self.curSceneSid = 0
    self.lastSceneSid = 0
    self.LoadedCallBack = nil
    self.Running = false
    --缓存世界场景
    self.cacheWorld = {}
    self.curSceneRes = ""
    self.curSceneParent = nil
    self.curItemParent = nil
    self.roleParent = nil
    self.mainSceneSid = 300
end
function WorldManager:Dispose()
    self.CurrentWorld = nil
    self.CurSceneType = nil
    self.curSceneSid = nil
    self.lastSceneSid = nil
    self.LoadedCallBack = nil
    self.Running = nil
    --缓存世界场景
    self.cacheWorld = nil
    self.curSceneRes = nil
    self.curSceneParent = nil
    self.curItemParent = nil
    if not _G.IsNil(self.roleParent) then
        self.roleParent:DestroyObject()
    end
    self.roleParent = nil
    if not _G.IsNil(self.curSceneResTrans) then
        self.curSceneResTrans:DestroyObject()
    end
    self.curSceneResTrans = nil
    self.mainSceneSid = nil
end

