---加载第一次进入主城剧情
function WorldManager:OnLoadJoinStory()
    local storyArr = self.CurrentWorld.Cfg.city_story
    if _G.type(storyArr) == "table" then
        local storyId = storyArr[1]
        if storyId then
            ---如果配置了检测条件
            local _t = storyArr[2]
            local _v = storyArr[3]

            local isJoin1 = _G.StoryUtilities.HasStoryIDSavedUID(storyId)
            if storyId > 0 and isJoin1 == false and self.CurrentWorld.Cfg.Scene_Type == _G.SceneType.MainWorld then
                if _t == nil or (_t and _G.GlobalConditionManager.CheckCondition(_t, _v) == false) then
                    -- 镇魂街ZHJ-24609 alpha_ft BUG合集ZHJ-20830
                    --【放置副本】在章节结束时，有低概率出现循环播放剧情
                    local hasQueueStoryID =
                        _G.MainManager:GetInstance():HasMainFunQueueByStoryID(
                        _G.MainViewShowOrder.OneMainScence,
                        storyId
                    )
                    ---同剧情id不添加了
                    if not hasQueueStoryID then
                        ---@type MainOpenViewFunItem
                        local MainOpenViewFunItem = {}
                        MainOpenViewFunItem.OpenViewFun = function()
                            _G.AutomaticPlayStory.PlayStoryByID(storyId, MainOpenViewFunItem.CallFun)
                        end
                        MainOpenViewFunItem.StoryID = storyId
                        _G.MainManager:GetInstance():AddMainFunQueue(
                            MainOpenViewFunItem,
                            _G.MainViewShowOrder.OneMainScence
                        )
                    end
                    return
                end
            end
        end
    end
end

---世界加载显示 全部完成
function WorldManager:InitWorldOver()
    self:ShowView()
    self:OnMainViewOpened()
end
---展示界面
function WorldManager:ShowView()
    local uimanager = _G.UIManager:GetInstance()
    local active, wind = uimanager:IsActiveWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if wind then
        if not active then
            uimanager:ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        end
        wind.View:UpdateView()
    end
    active, wind = uimanager:IsActiveWindow(_G.ConfigManager.ui_cfg.HUDView.Name)
    if not active then
        uimanager:ShowWindow(_G.ConfigManager.ui_cfg.HUDView.Name)
    end
end
---主界面加载完成
function WorldManager:OnMainViewOpened()
    if self.Running == false then
        return
    end
    self.Running = false
    if self.stopCoProgress then
        _G.coroutine.stopwaiting(self.stopCoProgress)
        self.stopCoProgress = nil
    end
    _G.Events:GetInstance():Broadcast(_G.eScene.EnterWorldOver)
    if self.LoadedCallBack ~= nil then
        self.LoadedCallBack()
        self.LoadedCallBack = nil
    else
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        if self.DoneCallback then
            self.DoneCallback()
            self.DoneCallback = nil
        end
    end
end
