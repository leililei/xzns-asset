---切换场景
---@param toSceneSid number 目标场景sid
---@param callback function 切换完成回调(参数boolean 是否切换成功)
---@param toDoorSid number 目标传送门sid
function WorldManager:SwitchScene(toSceneSid, callback, toDoorSid)
    local swithFunc = function()
        _G.PlayerModel:GetInstance():SetCurCitySid(toSceneSid)
        _G.WorldManager:GetInstance():EnterWorld(
            toSceneSid,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
                if callback then
                    callback(true)
                end
            end,
            toDoorSid
        )
    end
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        local pos = 0
        if toDoorSid then
            local cfg = _G.require(_G.ConfigManager.scene_cfg[toSceneSid].TiledResLua)
            local doors = cfg.WorldItemDatas.Door
            if doors and #doors > 0 then
                for i = 1, #doors do
                    if doors[i].Sid == toDoorSid then
                        pos =
                            _G.WorldUtils.PosToPoint(
                            {x = doors[i].InitPoint[1].p_x, z = doors[i].InitPoint[1].p_z},
                            cfg.BaseInfo
                        )
                        break
                    end
                end
            end
        end
        WorldNet:GetInstance():SwitchScene(
            toSceneSid,
            pos,
            function(msg)
                if msg.ack == 1 then
                    self.otherPlayerInfo = msg.users
                    swithFunc()
                else
                    if callback then
                        callback(false)
                    end
                end
            end
        )
    else
        swithFunc()
    end
end
