---@param name string 场景预设名
---@return UnityEngine.Transform 场景实例
function WorldManager:GetSceneGameObj(name)
    local trans
    if not _G.IsNil(self.curSceneParent) then
        trans = self.curSceneParent:FindE(name)
    end
    if _G.IsNil(trans) then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到场景资源 name = " .. name, "WorldManager:GetSceneGameObj")
        end
    end
    return trans
end
-----回收场景GameObject
