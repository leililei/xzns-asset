--region 协程加载场景
-----加载主界面
function WorldManager:CoLoadView()
    local uimanager = _G.UIManager:GetInstance()
    local open, view, name
    local SociatyManager = require("SociatyManager"):GetInstance()
    ---公会的特殊处理一下
    if self.curSceneSid == SociatyManager.ScenceId then
        SociatyManager:AndGoSociaty()
        name = _G.ConfigManager.ui_cfg.SociatyMainView.Name
    else
        name = _G.ConfigManager.ui_cfg.MainView.Name
    end
    open, view = uimanager:IsLoadedWindow(name)
    if not open then
        view = uimanager:OpenWindow(name)
        while _G.IsNil(view.gameObject) do
            _G.coroutine.waitforendofframe()
        end
    end
    open, view = uimanager:IsLoadedWindow(_G.ConfigManager.ui_cfg.HUDView.Name)
    if not open then
        view = uimanager:OpenWindow(_G.ConfigManager.ui_cfg.HUDView.Name)
        while _G.IsNil(view.gameObject) do
            _G.coroutine.waitforendofframe()
        end
    end
    open, view = uimanager:IsLoadedWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    if not open then
        view = uimanager:OpenWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
        while _G.IsNil(view.gameObject) do
            _G.coroutine.waitforendofframe()
        end
    end
    uimanager:HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)

    open, view = uimanager:IsLoadedWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
    if not open then
        view = uimanager:OpenWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
        while _G.IsNil(view.gameObject) do
            _G.coroutine.waitforendofframe()
        end
    end
    uimanager:HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
end
-----加载当前场景的系列场景资源和物件资源
function WorldManager:CoLoadScenes()
    local isCache = false
    local cfg = _G.ConfigManager.scene_cfg[self.curSceneSid]
    self.curSceneRes = cfg.Res
    if cfg.Scene_Type == _G.SceneType.MainWorld then
        local window = _G.UIManager:GetInstance():OpenWindow(cfg.Res)
        while _G.IsNil(window.View.gameObject) do
            _G.coroutine.waitforendofframe()
        end
        window.View.gameObject:SetSiblingIndexE(0)
        _G.UIManager:GetInstance():ChangeCanvasOrder(cfg.Res, 0)
        self.curSceneResTrans = window.View
    else
        if _G.AppSetting.IsloadScence then
            _G.PoolsManager:GetInstance():Spawn(
                cfg.Res,
                _G.ePoolType.World,
                nil,
                function(trans)
                    self.curSceneResTrans = trans
                    self.curSceneParent = trans:FindE("scene")
                    self.curItemParent = trans:FindE("obj")
                    if _G.IsNil(self.roleParent) then
                        self.roleParent = _G.GameObject("roleParent")
                    end
                    local num = self.curSceneParent:GetChildCountE()
                    if num > 0 then
                        for i = 1, num do
                            local childScene = self.curSceneParent:GetChildE(i - 1)
                            local walk = childScene:FindE("Static/walk")
                            if walk then
                                local walkBC = walk:GetComponentE(typeof(CS.UnityEngine.BoxCollider))
                                if IsNil(walkBC) then
                                    walk:AddComponentE(typeof(CS.UnityEngine.BoxCollider))
                                end
                            end
                        end
                    end
                    self.curSceneParent:SetChildrenActiveNumber(0)
                    trans:SetActiveE(0)
                    isCache = true
                end
            )
            while not isCache do
                _G.coroutine.waitforendofframe()
            end
        end
    end
end
-----缓存同系列的场景
function WorldManager:CoCacheWorlds()
    local sid
    if not _G.AppSetting.IsloadScence then
        sid = self.mainSceneSid
        if not self.cacheWorld[sid] and self:CheckSceneSameRes(sid) then --已经缓存的 和不同类型的场景不缓存
            local world = self:CreateWorldBySid(sid)
            self.cacheWorld[sid] = world
            while not world.IsInitOver do
                _G.coroutine.waitforendofframe()
            end
        end
        return
    end
    if self.cacheSids or #self.cacheSids > 0 then
        for i = 1, #self.cacheSids do
            sid = self.cacheSids[i]
            if not self.cacheWorld[sid] and self:CheckSceneSameRes(sid) then --已经缓存的 和不同类型的场景不缓存
                local world = self:CreateWorldBySid(sid)
                self.cacheWorld[sid] = world
                while not world.IsInitOver do
                    _G.coroutine.waitforendofframe()
                end
            end
        end
    end
    self.cacheSids = nil
end
-----缓存同系列场景中的物件
function WorldManager:CoCacheSceneItems()
    if not _G.AppSetting.IsloadScence then
        return
    end
    local items = {}
    for _, world in pairs(self.cacheWorld) do
        local data = world:GetItemsData()
        for sid, num in pairs(data) do
            local cfg = _G.ConfigManager.object_world_cfg[sid]
            if not _G.string.IsNullOrEmpty(cfg.Res) then
                if not items[cfg.Res] then
                    items[cfg.Res] = num
                elseif items[cfg.Res] < num then
                    items[cfg.Res] = num
                end
            end
        end
    end
    local loadDone = false
    local Instantiate = function(name, num)
        for i = 1, num do
            local obj = _G.InstantiateObject(self:GetItemGameObj(name), self.curItemParent)
            obj:SetName(name)
        end
        loadDone = true
    end
    local index = 0
    local count = 0
    local spawn = function(path, num)
        local callback = function()
            index = index + 1
            if index >= count then
                loadDone = true
            end
        end
        for i = 1, num do
            _G.PoolsManager:GetInstance():Preload(path, callback, _G.ePoolType.World)
        end
    end
    if _G.table.isEmptyOrNil(items) then
        loadDone = true
    else
        for res, num in pairs(items) do
            if _G.string.find(res, "/") then
                count = count + num
                spawn(res, num)
            else
                Instantiate(res, num - 1)
            end
        end
    end
    while not loadDone do
        _G.coroutine.waitforendofframe()
    end
end
-----缓存主角
function WorldManager:CoPlayer()
    if not _G.AppSetting.IsloadScence then
        return
    end
    local res = {}
    local sid = _G.PlayerModel:GetInstance():GetRoleSid()
    _G.table.insert(res, require "CardCommentManager":GetInstance():GetCfgs(sid).ModelPathLow)
    local index = 1
    local doneCall
    doneCall = function()
        index = index + 1
        if index <= #res then
            _G.PoolsManager:GetInstance():Preload(res[index], doneCall, _G.ePoolType.World)
        end
    end
    _G.PoolsManager:GetInstance():Preload(res[index], doneCall, _G.ePoolType.World)
    while index <= #res do
        _G.coroutine.yield()
    end
end
---开始协程加载世界场景
function WorldManager:CoProgressSwitchWorld()
    local isCache = self:CheckSceneSameRes(self.curSceneSid) and (self.cacheWorld[self.curSceneSid] and true or false)
    if not isCache then --优先打开loading界面
        local loading_window = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        while (_G.IsNil(loading_window.View)) do
            _G.coroutine.yield()
        end
        -- 等待loading 加载完成
        while (_G.IsNil(loading_window.View.gameObject)) do
            _G.coroutine.yield()
        end
    end
    --关闭除loading界面和常驻界面以外的所有界面
    _G.UIManager:GetInstance():SwitchSceneCloseWindows()
    if self.CurrentWorld then
        self.CurrentWorld:LeaveWorld()
        if
            self.CurrentWorld.Cfg.WorldType == _G.WorldType.MainWorld or
                self.CurrentWorld.Cfg.WorldType == _G.WorldType.SingleWorld or
                self.CurrentWorld.Cfg.SceneName == _G.ConfigManager.scene_cfg[self.curSceneSid].SceneName
         then
            self.CurrentWorld:DespawnWorld()
        end
    end
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
    if not isCache then --加载场景资源
        _G.coroutine.waitforendofframe()
        --清理缓存
        self:ClearCache()
        _G.coroutine.waitforendofframe()
        _G.TimerManager:GetInstance():GetTimer(1, _G.CollectGarbageLua, self, true):Start()
        self:CoLoadScenes()
        self:CoCacheWorlds()
        self:CoCacheSceneItems()
    -- self:CoPlayer()
    end
    self.CurrentWorld = self.cacheWorld[self.curSceneSid]
    local done = false
    if _G.AppSetting.IsloadScence then
        if self.CurrentWorld.Sid == 801 then
            done = true
        else
            self.CurrentWorld:InitOtherPlayer(
                function()
                    done = true
                end,
                self.otherPlayerInfo
            )
        end
    else
        done = true
    end

    while not done do
        _G.coroutine.waitforendofframe()
    end
    if _G.AppSetting.IsloadScence then
        _G.WorldItemManager:GetInstance():OnLoadObjectComplete()
        self.CurrentWorld:EnterWorld(self.enterImmediately)
        self.enterImmediately = nil
        -- self:SetPlayerPosition()
        if not isCache then
            self:CoLoadView()
        end
    else
        self:CoLoadView()
    end

    -- if self.CurrentWorld.Cfg.Scene_Type == _G.SceneType.MainWorld then --主城 缓存挂机资源
    --     require("AfkBattleManager"):GetInstance():CoCacheAfkRes()
    -- end
    _G.coroutine.waitforendofframe()
    if self.CurrentWorld and self.CurrentWorld.Cfg.audio > 0 then
        _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.CurrentWorld.Cfg.audio)
    end
    _G.TimerManager:GetInstance():GetTimer(0.5, self.HideLastScene, self, true):Start()
    self:OnComplete()
end
---添加其他的玩家信息
---@param msg scene.i_scene_user
function WorldManager:AddOtherInfo(msg)
    if not self.otherPlayerInfo then
        self.otherPlayerInfo = {}
    end
    _G.table.insert(self.otherPlayerInfo, msg)
end
---移除其他玩家信息
---@param msg scene.i_scene_user
function WorldManager:RemoveOtherInfo(msg)
    if not self.otherPlayerInfo then
        self.otherPlayerInfo = {}
    end
    for i, v in pairs(self.otherPlayerInfo) do
        if v.role_uid == msg.role_uid then
            self:AddOfflinePlayerInfo(v)
            _G.table.remove(self.otherPlayerInfo, i)
            break
        end
    end
end
---增加离线玩家数据
---@param msg scene.i_scene_user
