--- 检测 afk 关卡完成剧情
---@return number nil/剧情id
function WorldManager:CheckAfkAfterAwardStoryID()
    local preCfg = require("AfkModel"):GetInstance():GetPreviousSectionCfg()
    if preCfg ~= nil then
        local AfterAwardStoryID = preCfg.AfterAwardStoryID
        if AfterAwardStoryID > 0 and _G.StoryUtilities.HasStoryIDSavedUID(AfterAwardStoryID) == false then
            return AfterAwardStoryID
        end
    end
    return nil
end
---加载 AFK 完成关卡剧情
function WorldManager:OnLoadAfterAwardStoryID()
    local storyId = self:CheckAfkAfterAwardStoryID()
    if storyId ~= nil and self.CurrentWorld.Cfg.Scene_Type == _G.SceneType.MainWorld then
        -- 镇魂街ZHJ-24609 alpha_ft BUG合集ZHJ-20830
        --【放置副本】在章节结束时，有低概率出现循环播放剧情
        local hasQueueStoryID =
            _G.MainManager:GetInstance():HasMainFunQueueByStoryID(_G.MainViewShowOrder.AfterAwardStoryID, storyId)
        ---同剧情id不添加了
        if not hasQueueStoryID then
            ---@type MainOpenViewFunItem
            local MainOpenViewFunItem = {}
            MainOpenViewFunItem.OpenViewFun = function()
                _G.AutomaticPlayStory.PlayStoryByID(storyId, MainOpenViewFunItem.CallFun)
            end
            MainOpenViewFunItem.StoryID = storyId
            _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.AfterAwardStoryID)
        end
        return
    end
end

