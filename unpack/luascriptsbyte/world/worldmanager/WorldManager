-----清理缓存
function WorldManager:ClearCache()
    self.curSceneParent = nil
    self.curItemParent = nil
    self.curSceneRes = ""
    self.CurrentWorld = nil
    self.CurSceneType = nil
    for key, value in pairs(self.cacheWorld) do
        if key ~= self.curSceneSid then
            value:Dispose()
        end
    end
    self.cacheWorld = {}
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.World)
    if not _G.IsNil(self.curSceneResTrans) then
        self.curSceneResTrans:DestroyObject()
    end
    self.curSceneResTrans = nil
    self.curSceneParent = nil
    self.curItemParent = nil
    if not _G.IsNil(self.roleParent) then
        self.roleParent:DisposeChildren()
    end
end

---通过sid创建世界对象
---@param sid number 世界Sid
---@return BaseWorld | MainWorld | SimpleWorld 世界Class
function WorldManager:CreateWorldBySid(sid)
    local worldType = _G.ConfigManager.scene_cfg[sid].WorldType
    self.CurSceneType = _G.ConfigManager.scene_cfg[sid].Scene_Type
    if (worldType == _G.WorldType.MainWorld) then
        -- return require("MainWorld").New(sid)
        return require("Main2DWorld").New(sid)
    elseif (worldType == _G.WorldType.SimpleWorld) then
        return require("SimpleWorld").New(sid)
    elseif (worldType == _G.WorldType.SingleWorld) then
        return require("SingleWorld").New(sid)
    else
        return require("BaseWorld").New(sid)
    end
end
