---登录后进入场景回调
---@param 变量名 变量类型 中文描述
function WorldManager:OnLoginEnterScene(msg)
    _G.GameNetTipsManager:GetInstance().isSendEnterScence = true
    self.otherPlayerInfo = {}
    self.offlinePlayerInfo = {}
    local model = _G.PlayerModel:GetInstance()
    model:SetCurCitySid(msg.map_id)
    model:SetServerLine(msg.line)
    if
        not self.curSceneSid or self.curSceneSid == 0 or self.curSceneSid == 299 or self.curSceneSid == 801 or
            _G.ConfigManager.scene_cfg[self.curSceneSid].WorldType == _G.WorldType.SimpleWorld or
            --副本中不切场景
            msg.map_id == self.curSceneSid
     then
        require("ServerLineManager"):GetInstance():InitData(self.onLoginEnterSceneCall)
    else --服务器和本地所在场景不一致，以服务器为准
        if self.curSceneSid == 600 then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyMainView.View)
        end
        self:EnterWorld(
            msg.map_id,
            function()
                if self.curSceneSid ~= 600 then
                    require("ServerLineManager"):GetInstance():InitData(self.onLoginEnterSceneCall)
                else
                    self.onLoginEnterSceneCall()
                end

                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
            end
        )
    end
end
---重新进入当前场景回调
---@param msg table 进入场景回调
function WorldManager:OnReEnterSceneCall(msg)
    if msg.ack ~= 1 then
        if self.onReEnterSceneCall then
            self.onReEnterSceneCall(false)
            self.onReEnterSceneCall = nil
        end
        return
    end
    _G.GameNetTipsManager:GetInstance().isSendEnterScence = true
    local model = _G.PlayerModel:GetInstance()
    model:SetCurCitySid(msg.map_id)
    model:SetServerLine(msg.line)
    if not self.curSceneSid or self.curSceneSid == 0 or msg.map_id == self.curSceneSid then
        self:GetCurWorld():ClearOtherPlayer()
        self:GetCurWorld():InitOtherPlayer(
            function()
                if self.onReEnterSceneCall then
                    self.onReEnterSceneCall(true)
                    self.onReEnterSceneCall = nil
                end
            end,
            msg.users
        )
    else --服务器和本地所在场景不一致，以服务器为准
        self:EnterWorld(
            msg.map_id,
            function()
                self:GetCurWorld():ClearOtherPlayer()
                self:GetCurWorld():InitOtherPlayer(
                    function()
                        if self.onReEnterSceneCall then
                            self.onReEnterSceneCall(true)
                            self.onReEnterSceneCall = nil
                        end
                    end,
                    msg.users
                )
            end
        )
    end
end
---退出当前场景
function WorldManager:ExitCurrentWorld()
    if self.CurrentWorld and self.CurrentWorld.WorldPlayer then
        self.CurrentWorld.WorldPlayer:ForceMoveInterrupt()
        _G.Events:GetInstance():Broadcast(_G.eScene.ExitWorld)
    end
    self.curSceneSid = 0
end
-----检测场景资源是否是同类型资源
---@param sid number 场景sid
---@return boolean 是否是同类型资源
function WorldManager:CheckSceneSameRes(sid)
    if _G.string.IsNullOrEmpty(self.curSceneRes) then
        return false
    end
    local cfg = _G.ConfigManager.scene_cfg[sid]
    if cfg.Res == self.curSceneRes then
        return true
    end
    return false
end
