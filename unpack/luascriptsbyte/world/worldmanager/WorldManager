---回收角色
function WorldManager:DespawnRoleParent()
    if self.roleParent then
        for i = self.roleParent:GetChildCountE() - 1, 0, -1 do
            _G.PoolsManager:GetInstance():Despawn(self.roleParent:GetChildE(i), _G.ePoolType.World)
        end
    end
end
