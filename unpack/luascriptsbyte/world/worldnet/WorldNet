local base = require("BaseGameNet")
---@class WorldNet : BaseGameNet	中文描述
local WorldNet = _G.BaseClass("WorldNet", base)

---@return WorldNet WorldNet
function WorldNet:GetInstance()
    return base.GetInstance(self)
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function WorldNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function WorldNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    if callback then
        self.Call[port] = callback
    end
end
---获取所有分线数据
---@param call function 回调
function WorldNet:GetAllLines(call)
    self:Access(_G.ConfigManager.net_map.game_scene_state, self:GetEmptyPB(), call)
end
---进入场景
---@param callback function 完成回调
---@param sid number 所在场景ID
---@param line number 所在分线
function WorldNet:EnterScene(callback, sid, line)
    self:Access(
        _G.ConfigManager.net_map.game_scene_enter,
        {
            dest_scene_sid = sid or 0,
            dest_scene_line = line or 0
        },
        callback
    )
end
---切换场景
---@param sid number 场景sid
---@param pos number 传送位置
---@param callback function 完成回调
function WorldNet:SwitchScene(sid, pos, callback)
    self:Access(_G.ConfigManager.net_map.game_scene_switch, {dest_scene_sid = sid, dest_scene_point = pos}, callback)
end
---切换分线
---@param line number 分线id
---@param pos number 传送位置
---@param callback function 完成回调
function WorldNet:SwitchLine(line, pos, callback)
    self:Access(
        _G.ConfigManager.net_map.game_scene_line,
        {dest_scene_line = line, dest_scene_point = pos or 0},
        callback
    )
end
local sendpostab = {start_point = 0, end_point = 0}
---发送玩家移动点请求
---@param startpos number 初始位置
---@param endpos number 结束位置
---@param callback function 完成回调
function WorldNet:SendMovePointsData(startpos, endpos, callback)
    sendpostab.start_point = startpos
    sendpostab.end_point = endpos
    -- 当进入场景后才能发送移动消息
    if GameNetTipsManager:GetInstance().isSendEnterScence then
        self:Access(_G.ConfigManager.net_map.game_scene_move, sendpostab, callback)
    end
end

---获取其他玩家信息
---@param callback function 完成回调
function WorldNet:GetOtherPlayerData(callback)
    self:Access(_G.ConfigManager.net_map.game_scene_get_all_info, self:GetEmptyPB(), callback)
end

---获取世界物件信息
---@param callback function 完成回调
function WorldNet:GetWorldObjectInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_object_info, self:GetEmptyPB(), callback)
end
---打开世界场景宝箱
---@param sid number 宝箱sid
---@param callback function 完成回调
function WorldNet:OpenWorldBox(sid, callback)
    self:Access(_G.ConfigManager.net_map.game_object_box, {sid = sid}, callback)
end

---播放闲置动画
---@param sid number 动画sid
function WorldNet:PlayeStandAction(sid, callback)
    self:Access(
        _G.ConfigManager.net_map.game_scene_action,
        {action = {interger = sid, type = _G.WorldManager.OtherPlayerActionType.action}},
        callback
    )
end
---@type WorldNet
_G.WorldNet = WorldNet
return WorldNet
