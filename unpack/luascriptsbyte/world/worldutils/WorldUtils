---根据数据计算当前所在的位置
---@return UnityEngine.Vector3 创建位置
---@return boolean 是否正在移动
function WorldUtils.CaculateLocalPos(start_point, end_point, start_time, speed)
    local localPos
    local isMove = false
    if start_time == 0 then
        --初始创建玩家 or 传送玩家
        if end_point == 0 then
            --初始创建 or 切场景
            localPos =
                _G.WorldUtils.PointToPos(_G.WorldManager:GetInstance():GetCurWorld().Data.BaseInfo.PlayerPoint, true)
        else
            --当前场景传送玩家
            localPos = _G.WorldUtils.PointToPos(end_point, true)
        end
    elseif end_point == start_point then
        localPos = _G.WorldUtils.PointToPos(end_point, true)
    else
        --根据数据计算当前所在位置
        local curServerTime = _G.TimeUtil.GetServerUnixTime()
        local startPos = _G.WorldUtils.PointToPos(start_point, true)
        local endPos = _G.WorldUtils.PointToPos(end_point, true)
        local navMeshPath = _G.CS.UnityEngine.AI.NavMeshPath()
        local isArrival, isTooClose =
            _G.CS.UnityObjectExtends.CalculatePathByPos(
            startPos.x,
            startPos.y,
            startPos.z,
            endPos.x,
            endPos.y,
            endPos.z,
            navMeshPath
        )
        if isArrival then
            if not isTooClose then
                local distance = speed * (curServerTime - start_time)
                local index = 1
                local dis = 0
                local index = 1
                for i = 1, navMeshPath.corners.Length - 1 do
                    dis = _G.Vector3.Distance(navMeshPath.corners[index - 1], navMeshPath.corners[index])
                    if dis >= distance then
                        break
                    end
                    index = index + 1
                    distance = distance - dis
                end
                if index < navMeshPath.corners.Length then
                    startPos = navMeshPath.corners[index - 1]
                    localPos = {x = 0, y = 0, z = 0}
                    localPos.x = startPos.x + (navMeshPath.corners[index].x - startPos.x) * distance / dis
                    localPos.z = startPos.z + (navMeshPath.corners[index].z - startPos.z) * distance / dis
                    localPos.y = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting:GetY(localPos.x, localPos.z)
                    isMove = true
                else
                    localPos = endPos
                end
            else
                localPos = endPos
            end
        else
            local x, y, z = _G.CS.UnityObjectExtends.FixedPath(endPos.x, endPos.y, endPos.z)
            localPos = {x = x, y = y, z = z}
        end
    end
    return localPos, isMove
end
---@type WorldUtils
return WorldUtils
