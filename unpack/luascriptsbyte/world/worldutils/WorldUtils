local WorldData = require "WorldData"

_G.WorldUtils = {}

---@class WorldUtils
local WorldUtils = _G.WorldUtils

--region 标记转换

---UV转换标记
---@param u number u
---@param v number v
---@return number 点位标记Point
function WorldUtils.UVToPoint(u, v)
    return _G.bit.bor(_G.bit.blshift(u, 16), v)
end

---标记转换UV
---@param point number 标记
---@return number,number UV
function WorldUtils.PointToUV(point)
    local u = _G.bit.blogic_rshift(point, 16)
    local v = _G.bit.band(point, 65535)
    return u, v
end

function WorldUtils.PosToUV(localPos)
    local baseInfo = _G.WorldManager:GetInstance():GetCurWorld().Data.BaseInfo
    local size = baseInfo.BoxSize
    local u = _G.Mathf.Ceil((localPos.x + baseInfo.Width) / size)
    local v = _G.Mathf.Ceil((localPos.z + baseInfo.Height) / size)
    return u, v
end

---坐标转换标记
---@param localPos UnityEngine.Vector3 局部坐标
---@param baseInfo table 地图配置基础数据(nil则取当前场景配置)
---@return number 点位标记Point
function WorldUtils.PosToPoint(localPos, baseInfo)
    if not baseInfo then
        baseInfo = _G.WorldManager:GetInstance():GetCurWorld()
        if not baseInfo then
            return -1
        end
        baseInfo = baseInfo.Data.BaseInfo
    end
    if localPos.x + baseInfo.Width < 0 or localPos.z + baseInfo.Height < 0 then
        return -1
    end
    local size = baseInfo.BoxSize
    localPos.x = _G.Mathf.Ceil((localPos.x + baseInfo.Width) / size)
    localPos.z = _G.Mathf.Ceil((localPos.z + baseInfo.Height) / size)
    return _G.WorldUtils.UVToPoint(localPos.x, localPos.z)
end

function WorldUtils.PosToPointXZ(x, z)
    local baseInfo = _G.WorldManager:GetInstance():GetCurWorld().Data.BaseInfo
    if x + baseInfo.Width < 0 or z + baseInfo.Height < 0 then
        return -1
    end
    local size = baseInfo.BoxSize
    x = _G.Mathf.Ceil((x + baseInfo.Width) / size)
    z = _G.Mathf.Ceil((z + baseInfo.Height) / size)
    return _G.WorldUtils.UVToPoint(x, z)
end

---标记转换局部坐标
---@param point number 标记
---@param isY boolean 是否计算Y值
---@return UnityEngine.Vector3 局部坐标
function WorldUtils.PointToPos(point, isY)
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    local baseInfo = world.Data.BaseInfo
    local u, v = _G.WorldUtils.PointToUV(point)
    local pos = {x = 0, y = 0, z = 0}
    pos.x = u * baseInfo.BoxSize - baseInfo.Width
    pos.z = v * baseInfo.BoxSize - baseInfo.Height
    if isY then
        pos.y = world.WorldSetting:GetY(pos.x, pos.z)
    end
    return pos
end

---更新指定世界对象的提示
---@param uid number @对象UID
---@return boolean @是否更新成功
function WorldUtils.UpdateWorldItemTip(uid)
    local world = _G.WorldManager:GetInstance():GetCurWorld()

    if world ~= nil then
        local worlditem = world:GetItemInfo(uid)
        if worlditem ~= nil then
            local tiptype = WorldUtils.GetWorldItemTipType(uid)
            --暂时只支持NPC头顶提示
            if worlditem.ItemType == _G.WorldItemType.NPC then
                worlditem:CreateTaskSign(tiptype)
            end
            return true
        else
            return false
        end
    else
        return false
    end
end

