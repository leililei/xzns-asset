function WorldUtils.IsWorldItemHasIdleDialogue(worlditem, uid)
    if worlditem == nil then
        return WorldData.EWorldItemTipType.None
    end
    ---如果是有对话的npc 提示一次对话后消失
    if
        worlditem.Cfg.Params[1] == 2 and worlditem.Cfg.ClickParams[1] ~= nil and
            WorldUtils.HasIdleDialogueIsSave(uid, worlditem.Cfg.ClickParams[1]) == false
     then
        return WorldData.EWorldItemTipType.DialogueTip
    end
    if uid == 300070001 then
        return WorldData.EWorldItemTipType.orangeMarvel
    end
    return WorldData.EWorldItemTipType.None
end

function WorldUtils.GetIdleDialogueSavedKey(npcuid, dialogueid)
    return "IdleDialogue" .. _G.PlayerModel:GetInstance().role_uid .. npcuid .. dialogueid
end
function WorldUtils.HasIdleDialogueIsSave(npcuid, dialogueid)
    assert(npcuid, "不允许传空的 npcuid 来判定本地是否已播放!")
    assert(dialogueid, "不允许传空的 dialogueid 来判定本地是否已播放!")
    local key = WorldUtils.GetIdleDialogueSavedKey(npcuid, dialogueid)
    local SavedInt = _G.PlayerPrefsManager.GetInt(key)
    return SavedInt ~= 0
end

function WorldUtils.SetIdleDialogueSaved(npcuid, dialogueid)
    assert(npcuid, "不允许传空的 IdleDialogue 来判定本地是否已播放!")
    assert(dialogueid, "不允许传空的 IdleDialogue 来判定本地是否已播放!")
    local key = WorldUtils.GetIdleDialogueSavedKey(npcuid, dialogueid)
    _G.PlayerPrefsManager.SetInt(key, 1)
end

---判定一个点是否在多边形内
---@param p UnityEngine.Vector3 @待检测点
---@param ptPolygon UnityEngine.Vector3[] @待检测点
function WorldUtils.PointInPolygon(p, ptPolygon)
    local nCross = 0
    local nCount = #ptPolygon - 1
    for i = 1, nCount do
        local p1 = ptPolygon[i]
        --当前节点
        local p2 = ptPolygon[(i + 1)]
        --下一个节点

        -- 求解 y=p.y 与 p1p2 的交点
        local flag = true
        if p1.z == p2.z then
            -- p1p2 与 y=p0.y平行
            flag = false
        end
        if (p.z < math.min(p1.z, p2.z)) then
            -- 交点在p1p2延长线上
            flag = false
        end
        if (p.z >= math.max(p1.z, p2.z)) then
            -- 交点在p1p2延长线上
            flag = false
        end
        if (flag) then
            -- 从P发射一条水平射线 求交点的 X 坐标 -----
            -- 原理: ((p2.y-p1.y)/(p2.x-p1.x))=((y-p1.y)/(x-p1.x))
            --直线k值相等 交点y=p.y
            local x = (p.z - p1.z) * (p2.x - p1.x) / (p2.z - p1.z) + p1.x
            if x > p.x then
                nCross = nCross + 1 --只统计单边交点
            end
        end
    end
    -- 单边交点为偶数，点在多边形之外
    return (nCross % 2 == 1)
end
