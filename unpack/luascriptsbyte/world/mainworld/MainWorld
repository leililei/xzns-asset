---临时（动态读取数据（怪物得数据）（恶灵入侵））
function MainWorld:LoadData()
    if self.Cfg.TiledResLua == nil or self.Cfg.TiledResLua == "" then
        return
    end
    base.LoadData(self)
    ---恶灵入侵
    if self.Cfg.Sid == 801 then
        local itype = "Dungones"
        local datas = require "MonsterSiegeManager":GetInstance():DynamicCreateModel()
        for _, itemData in pairs(datas) do
            local wid = _G.WorldItemData.New()
            wid:CloneData(itemData)
            wid.ItemType = _G.WorldItemType[itype]
            table.insert(self.ItemDataList, wid)
        end
    end
end
---初始化其他玩家
---@param callback function 完成回调
---@param others table 其他玩家信息
function MainWorld:InitOtherPlayer(callback, others)
    ---@param args scene.ReplyGetOtherPlayer
    self:RemoveRepeatOthers(others)
    local function CallBack(args)
        local initdonecall = function()
            self:InitRobot(callback)
        end
        local count = args.all_other_user and #args.all_other_user or 0
        if count < 1 then
            initdonecall()
        else
            local endindex = 1
            local WorldPlayerData = _G.WorldPlayerData
            for i = 1, count do
                local data = WorldPlayerData.New()
                data:ResolvPlayerData(args.all_other_user[i])
                local info =
                    base.CreatePlayerBaseData(
                    self,
                    data,
                    function(item)
                        self.AllWorldItems[item.ItemData.role_uid] = item
                        endindex = endindex + 1
                        if endindex > count then
                            initdonecall()
                        end
                    end
                )
                local player = WorldOtherPlayerItem.New(info, data, self)
                player:Init()
            end
        end
    end
    CallBack({all_other_user = others or {}})
end

function MainWorld:RemoveRepeatOthers(others)
    if others and #others then
        local uids = {}
        local muid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for i = #others, 1, -1 do
            if muid == others[i].role_uid then
                _G.table.remove(others, i)
            else
                if uids[others[i].role_uid] then
                    _G.table.remove(others, i)
                else
                    uids[others[i].role_uid] = true
                end
            end
        end
    end
end

function MainWorld:InstOtherPlayerItem()
    local roleuid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local playerDataType = _G.WorldItemDataType.Player
    for _, value in pairs(self.AllWorldItems) do
        if value.DataType == playerDataType then
            if value.Uid ~= roleuid then
                value:SetDisplayParams({IsHideShadow = true})
                value:OnEnterWorld()
            end
        end
    end
end
---创建其他玩家
---@param other otherplayerdata 其他玩家数据
---@function
function MainWorld:CreateOtherPlayer(other, callback)
    if self.robotManager then
        self.robotManager:RemoveOfflinePlayer(other.role_uid)
    end

    local player = self.AllWorldItems[other.role_uid]
    if self.Cfg.Sid == 600 then
        if player then
            base.RemoveWorldItems(self, other.role_uid)
            player = nil
        elseif self.Cfg.display_screen <= _G.table.count(self.AllWorldItems) then
            for _, v in pairs(self.AllWorldItems) do
                if v.isCopy then
                    base.RemoveWorldItems(self, v.Uid)
                    break
                end
            end
        end
    end
    if self.Cfg.Sid == 801 then
        return
    end
    ---@type WorldOtherPlayerItem player
    if not player then
        local data = _G.WorldPlayerData.New()
        data:ResolvPlayerData(other)
        ---@param item WorldOtherPlayerItem
        local info =
            base.CreatePlayerBaseData(
            self,
            data,
            function(item)
                item:SetDisplayParams({IsHideShadow = true})
                item:OnEnterWorld()
                self.AllWorldItems[item.ItemData.role_uid] = item
                if callback then
                    callback()
                end
            end
        )
        player = WorldOtherPlayerItem.New(info, data, self)
        player:Init()
    end
end
local actionFunc = {
    [_G.WorldManager.OtherPlayerActionType.action] = function(player, data)
        if not data.integer or data.integer <= 0 then
            return
        end
        local cfg = _G.ConfigManager.character_special_cfg[data.integer]
        if cfg then
            player:PlayeStandAction(cfg.display_xiuxian)
        end
    end,
    [_G.WorldManager.OtherPlayerActionType.role] = function(player, data, self)
        if self.setTransparentEffectIds and self.setTransparentEffectIds[player.Uid] then
            self.CommonEff:StopRoleTransparentEffect(player.ObjectMod)
            self.setTransparentEffectIds[player.Uid] = nil
        end
        player:ChangeCityRole(data.integer)
    end,
    [_G.WorldManager.OtherPlayerActionType.title] = function(player, data)
        player:ChangeTitle(data.integer, data.end_time)
    end,
    [_G.WorldManager.OtherPlayerActionType.name] = function(player, data)
        player:ChangeName(data.str)
    end,
    [_G.WorldManager.OtherPlayerActionType.effect] = function(player, data)
        player:ChangeEffect(data.integer, data.end_time)
    end,
    [_G.WorldManager.OtherPlayerActionType.hell] = function(player, data)
        player:UpdateHell(data.integer)
    end
}
---其他玩家播放动作
---@param all_other_user scene_msg.i_scene_action_events[] 其他播放动作的玩家
function MainWorld:OtherPlayerPlayerAction(all_other_user)
    local ActionCfgs = _G.ConfigManager.character_special_cfg
    for _, value in ipairs(all_other_user) do
        ---@type WorldOtherPlayerItem player
        local player = self.AllWorldItems[value.role_uid]
        if player and player._class_type.__cname == "WorldOtherPlayerItem" then
            actionFunc[value.type](player, value, self)
        -- local cfg = ActionCfgs[value.action_id]
        -- if cfg then
        --     player:PlayeStandAction(cfg.display_xiuxian)
        -- end
        end
    end
end
---移动某个玩家
---@param uid number
---@param passPoint number[]
function MainWorld:MoveOtherPlayer(uid, end_point)
    ---@type WorldOtherPlayerItem 变量名
    local player = self.AllWorldItems[uid]
    if player and player._class_type.__cname == "WorldOtherPlayerItem" then
        player:UpdateMovePosition(end_point)
    end
end
function MainWorld:InitGhost()
    if self.Cfg.Sid == 300 then
        ---ZHJ-17328【客户端】主城幽灵循环表现功能---
        if not self.GhostManager then
            self.GhostManager = require "GhostManager".New(self)
        end
    end
end
function MainWorld:InitRobot(callback)
    --TODO:当前公会场景和主城场景用的同一个对象，所以加了这个判定
    if self.Cfg.Sid == 300 then
        self.robotManager = require("RobotManager").New(self)
        self.robotManager:InitRobot(callback)
    else
        callback()
    end
end
-----进入世界
function MainWorld:EnterWorld()
    self:InstWorld()
    self:InstAllItem()
    self:Visible(true)
    if not self.Cfg.LockMainCamera then
        self.WorldSetting.SceneCamera:Look(self.WorldPlayer.Transform)
        ---公会场景只能水平移动
        if self.Cfg.Sid == 600 then
            self.WorldSetting.SceneCamera:SetHorizontal(true, 6, -6)
        end
        self:InitGhost()
        self.WorldSetting.SceneCamera:UpdatePos(true)
        self:InitObjectAlphaCheck()
        self:StartObjectAlphaCheck()
    end
    self:OnChangeWorldOver()
    self:ChangeCameraBattle()
    _G.WorldManager:GetInstance():AddPushEventListener()
    self:StartCheckFPS()
end
-----离开世界
function MainWorld:LeaveWorld()
    self:CloseSceneView()
    base.LeaveWorld(self)
    if self.GhostManager then
        self.GhostManager:Dispose()
    end
    if self.robotManager then
        self.robotManager:Dispose()
        self.robotManager = nil
    end
    _G.WorldManager:GetInstance():RemovePushEventListener()
    self:StopCheckFPS()
    self:DisposeFPSCheck()
end

function MainWorld:CloseSceneView()
    if self.Cfg.Sid == 801 then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
    end
end

---清理其他玩家
function MainWorld:ClearOtherPlayer()
    local playerUid = self.WorldPlayer.Uid
    local uids = {}
    local insert = _G.table.insert
    for uid, value in pairs(self.AllWorldItems) do
        if value.DataType == _G.WorldItemDataType.Player then
            if uid ~= playerUid then
                insert(uids, uid)
            end
        end
    end
    for i = 1, #uids do
        self:RemoveWorldItems(uids[i])
    end
end

function MainWorld:RemoveWorldItems(uid)
    ---公会镜像玩家
    local item = self.AllWorldItems[uid]
    if self.Cfg.Sid == 600 then
        if item then
            if not item.isCopy and item.OpenSociatyTimer then
                item:OpenSociatyTimer()
            else
                base.RemoveWorldItems(self, uid)
            end
        end
    else
        base.RemoveWorldItems(self, uid)
    end
    if self.robotManager then
        self.robotManager:AddOfflinePlayer(uid)
    end
end

--region FPS检测
local checkFPSTipsID = 200305
local vaildFPSNum = 0.1
---初始化FPS检测
function MainWorld:InitFPSCheck()
    if not self.checkFPSNum then
        self.checkFPSNum = _G.ConfigManager.discrete_cfg[103508][1]
        self.checkFPSTime = self.checkFPSNum[2]
        self.checkFPSNum = self.checkFPSNum[1]
        self.checkFPSNum = 1 / self.checkFPSNum
        _G.Events:GetInstance():AddListener(_G.eSetting.ImageQualityChange, self.OnQualityChanged, self)
    end
    self.curCheckFPSTime = 0
end
function MainWorld:DisposeFPSCheck()
    _G.Events:GetInstance():RemoveListener(_G.eGuideEvent.GuideEnd, self.OnGuideEnd, self)
    _G.Events:GetInstance():RemoveListener(_G.GuideStoryStart.StoryEnd, self.OnStoryPlayEnd, self)
end
---启动FPS检测
function MainWorld:StartCheckFPS()
    if not _G.PopWindowManager:GetInstance():CheckToggleWindow(checkFPSTipsID, true) then --勾选了不在提示
        return
    end
    self:InitFPSCheck()
    local curQuality = _G.SystemSettingManager:GetInstance():GetCurImage()
    if curQuality == _G.ImageQuality.Low then --最低画质
        return
    end
    _G.UpdateManager:GetInstance():AddUpdate(self.UpdateFPSCheck, self)
end
---停止FPS检测
function MainWorld:StopCheckFPS()
    _G.UpdateManager:GetInstance():RemoveUpdate(self.UpdateFPSCheck, self)
end
---每帧刷新FPS检测
function MainWorld:UpdateFPSCheck()
    if _G.IsNil(self.SceneObject) or self.SceneObject:GetActiveSelf() == 0 then
        return
    end
    local Time = _G.Time
    if Time.unscaledDeltaTime > vaildFPSNum then --卡顿的无效帧
        return
    end
    if Time.unscaledDeltaTime > self.checkFPSNum then
        self.curCheckFPSTime = self.curCheckFPSTime + Time.deltaTime
        if self.curCheckFPSTime >= self.checkFPSTime then
            self:OpenTipsView()
            self:StopCheckFPS()
        end
    else
        self.curCheckFPSTime = 0
    end
end
---打开FPS提示框
function MainWorld:OpenTipsView()
    local nowStory = _G.StoryManager:GetInstance():GetNowStory()
    if nowStory ~= nil and nowStory.CurrentAutoStory ~= nil and nowStory.CurrentAutoStory.CurrentStory ~= nil then
        _G.Events:GetInstance():AddListener(_G.GuideStoryStart.StoryEnd, self.OnStoryPlayEnd, self)
        return
    end
    if _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing then --引导
        _G.Events:GetInstance():AddListener(_G.eGuideEvent.GuideEnd, self.OnGuideEnd, self)
        return
    end
    _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
        checkFPSTipsID,
        function()
            local SystemSettingManagerIns = _G.SystemSettingManager:GetInstance()
            local curQuality = SystemSettingManagerIns:GetCurImage()
            SystemSettingManagerIns:SetImageQ(curQuality + 1)
            _G.PopWindowManager:GetInstance():ShowAllTips(200306)
        end,
        _G.handler(self, self.StartCheckFPS),
        nil,
        true
    )
end
---当剧情或者引导结束调用
function MainWorld:OnStoryPlayEnd()
    _G.Events:GetInstance():RemoveListener(_G.GuideStoryStart.StoryEnd, self.OnStoryPlayEnd, self)
    --延迟一帧打开界面，防止接着播剧情或者引导
    _G.TimerManager:GetInstance():GetTimer(1, self.OpenTipsView, self, true, true):Start()
end
function MainWorld:OnGuideEnd()
    _G.Events:GetInstance():RemoveListener(_G.eGuideEvent.GuideEnd, self.OnGuideEnd, self)
    --延迟一帧打开界面，防止接着播剧情或者引导
    _G.TimerManager:GetInstance():GetTimer(1, self.OpenTipsView, self, true, true):Start()
end
---当画质更改时调用
---@param quality _G.ImageQuality 画质
function MainWorld:OnQualityChanged(quality)
    if quality == _G.ImageQuality.Low then --最低画质
        self:StopCheckFPS()
        return
    end
    self:StartCheckFPS()
end

---初始化所有物件
function MainWorld:InstAllItem()
    for k, value in pairs(self.AllWorldItems) do
        value:SetDisplayParams({IsHideShadow = true})
    end
    base.InstAllItem(self)
end

--endregion

return MainWorld
