---@type WorldManager 场景中其他玩家有操作网络事件推送处理
local NetPushHandler = _G.WorldManager
local Events = _G.Events

---添加服务器推送事件监听
function NetPushHandler:AddPushEventListener()
    self.HandlerList = {
        move_events = _G.handler(self, self.OnMoveEventsHandler),
        action_events = _G.handler(self, self.OnPlayActionHandler),
        user_events = _G.handler(self, self.OnUserActionHandler)
    }
    Events:GetInstance():AddListener(_G.ConfigManager.net_map.scene_events.Cmd, self.ReceivePushEventHandler, self)
    Events:GetInstance():AddListener(_G.ConfigManager.net_map.scene_exit.Cmd, self.ReceivePushSceneExit, self)
end

---取消服务器推送事件监听
function NetPushHandler:RemovePushEventListener()
    Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.scene_events.Cmd, self.ReceivePushEventHandler, self)
    Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.scene_exit.Cmd, self.ReceivePushSceneExit, self)
end

---服务器推送事件处理
---@param msg scene_msg.SceneEvents
function NetPushHandler:ReceivePushEventHandler(msg)
    if not table.isEmptyOrNil(msg) then
        for funcName, value in pairs(msg) do
            if self.HandlerList[funcName] then
                self.HandlerList[funcName](value)
            end
        end
    end
end
function NetPushHandler:ReceivePushSceneExit()
    self:ReEnterScene()
end
---服务器推送其他玩家移动处理
---@param moveEvents scene_msg.MoveEvent[]
function NetPushHandler:OnMoveEventsHandler(moveEvents)
    if not self.CurrentWorld then
        _G.LogFatal("self.CurrentWorld is nil")
        return
    end

    if self.CurrentWorld.MoveOtherPlayer then
        for i = #moveEvents, 1, -1 do
            if moveEvents[i].role_uid ~= _G.PlayerModel:GetInstance().role_uid then
                self.CurrentWorld:MoveOtherPlayer(moveEvents[i].role_uid, moveEvents[i].end_point) --同步其他玩家移动数据修改，去掉移动路径改为终点信息同步
            end
        end
    end
end
function NetPushHandler:OnUserActionHandler(events)
    local mUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    if not self.CurrentWorld then
        for i = #events, 1, -1 do
            local ruid = events[i].role_uid
            if ruid ~= mUid then
                if events[i].role_name then
                    self.RemoveOfflinePlayer(ruid)
                else
                    self.AddOfflinePlayer(ruid)
                end
            end
        end
        --_G.LogFatal("self.CurrentWorld is nil")
        return
    end
    local uids = {}
    local removeAt = _G.table.remove
    local uid = nil
    for i = #events, 1, -1 do
        uid = events[i].role_uid
        if uid == mUid then
            -- removeAt(events, i)
            events[i] = false
        else
            if uids[uid] then
                events[i] = false
                events[uids[uid]] = false
                -- removeAt(events, i)
                -- removeAt(events, uids[uid])
                uids[uid] = nil
            else
                uids[uid] = i
            end
        end
    end
    for i = 1, #events do
        if events[i] then
            if events[i].role_name then
                self.CurrentWorld:CreateOtherPlayer(events[i])
                _G.WorldManager:GetInstance():AddOtherInfo(events[i])
            else
                self.CurrentWorld:RemoveWorldItems(events[i].role_uid)
                _G.WorldManager:GetInstance():RemoveOtherInfo(events[i])
            end
        end
    end
end
---服务器推送其他玩家播放动作
---@param actionEvents scene_msg.i_scene_action_events
function NetPushHandler:OnPlayActionHandler(actionEvents)
    if not self.CurrentWorld then
        _G.LogFatal("self.CurrentWorld is nil")
        return
    end
    local count = #actionEvents
    local tb = {}
    for i = count, 1, -1 do
        if actionEvents[i].role_uid and actionEvents[i].role_uid ~= _G.PlayerModel:GetInstance().role_uid then
            _G.table.insert(tb, actionEvents[i])
        end
    end
    if #tb > 0 then
        if self.CurrentWorld.OtherPlayerPlayerAction then
            self.CurrentWorld:OtherPlayerPlayerAction(tb)
        end
    end
end
