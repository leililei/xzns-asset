---@class CommonDropItemEffect	中文描述
local CommonDropItemEffect = _G.BaseClass("CommonDropItemEffect")

---类的构造函数
function CommonDropItemEffect:__init()
end

---类的析构函数
function CommonDropItemEffect:Dispose()
end

--region物品掉落表现
local dropType = {
    weapon = 1,
    shield = 1,
    item = 1,
    box = 1,
    gold = 2
}
local dropEffect = {
    {
        "Drop_Performance_01",
        "Drop_Performance_02",
        "Drop_Performance_03",
        "Drop_Performance_04",
        "Drop_Performance_05"
    },
    {
        "Drop_Performance_06"
    }
}
local awardEffectDiscreteID = 100213
function CommonDropItemEffect:ShowEffectCallback(trans)
    if self.close then
        _G.UIUtils.RemoveEffect(trans)
        return
    end
    if self.showAwardEffectDoneCall then
        self.showAwardEffectDoneCall()
        self.showAwardEffectDoneCall = nil
    end
    if self.effects[self.posIndex][1] == dropType.gold then
        local pos = self.curShowEffectPos[self.posIndex]
        trans:SetLocalPosition(pos.x, pos.y, pos.z)
    else
        trans:SetLocalPosition(self.targetPos.x, self.targetPos.y, self.targetPos.z)
        self.effectTrans[trans] = self.curShowEffectPos[self.posIndex]
        if self.coMoveProgress == nil then
            self.coMoveProgress = coroutine.start(_G.handler(self, self.CoMove))
        end
    end
    self.posIndex = self.posIndex - 1
end
function CommonDropItemEffect:ShowEffectEndCall()
    if self.close then
        return
    end
    -- self.showEffectEndCount = self.showEffectEndCount - 1
    -- if self.showEffectEndCount == 0 then
    --     if self.showAwardEffectDoneCall then
    --         self.showAwardEffectDoneCall()
    --         self.showAwardEffectDoneCall = nil
    --     end
    -- end
    self:Close()
end
function CommonDropItemEffect:ShowAward(item, callback)
    if not _G.table.isEmptyOrNil(item) then
        local storageManager = _G.StorageManager:GetInstance()
        self.effectCount = 0
        self.effectTrans = {}
        self.showAwardEffectDoneCall = callback
        -- self.showGoldEffect = false
        local itemType = 0
        local itemColor = {}
        local cfg = nil
        local effects = {}
        local num = 0
        for i = 1, #item do
            itemType = storageManager:CheckSidType(item[i][1])
            if itemType == _G.StorageType.Equipment then
                cfg = _G.ConfigManager.equipment_cfg[item[i][1]]
                itemColor =
                    cfg and
                    (cfg.parts == _G.EquipmentPart.Weapon and {dropType.weapon, cfg.grade} or
                        {dropType.shield, cfg.grade}) or
                    {-1, -1}
            elseif itemType == _G.StorageType.ResProp then
                if item[i][1] == _G.ResPropID.Coin then --金币
                    -- self.showGoldEffect = true
                    -- num = num + item[i][2]
                    -- itemColor = {-1, -1}
                else
                    cfg = _G.ConfigManager.currency_type_cfg[item[i][1]]
                    if cfg then
                        itemColor = {dropType.item, cfg.Quality > 0 and cfg.Quality or 1}
                    end
                end
            elseif itemType == _G.StorageType.Card then
                itemColor = {-1, -1}
            else
                cfg = _G.ConfigManager.item_cfg[item[i][1]]
                if cfg then
                    if cfg.Type1 < _G.ItemCfgType.EquipmentMatrial then
                        itemColor = {-1, -1}
                    elseif cfg.Type1 < _G.ItemCfgType.FixedAwardBox then
                        itemColor = {dropType.item, cfg.Quality}
                    else
                        itemColor = {-1, -1}
                    end
                else
                    itemColor = {-1, -1}
                end
            end
            if #itemColor > 0 and itemColor[1] >= 0 then
                _G.table.insert(effects, itemColor)
            end
        end
        -- if self.showGoldEffect then
        --     if self.goldNum then
        num = self.goldNum or 0
        --     else
        --         local max = _G.ConfigManager.discrete_cfg[awardEffectDiscreteID][3][1]
        --         num = _G.Mathf.Ceil(num / _G.ConfigManager.discrete_cfg[awardEffectDiscreteID][2][1])
        --         num = num > max and max or num
        --     end
        for i = 1, num do
            _G.table.insert(effects, {dropType.gold, 1})
        end
        -- end
        self.effects = {}
        for i = #effects, 1, -1 do
            num = _G.Mathf.Random(1, i)
            _G.table.insert(self.effects, _G.table.remove(effects, num))
        end
        self.effectCount = #self.effects
        self.posIndex = self.effectCount
        if self.effectCount == 0 then
            if callback then
                callback()
            end
            return
        end
        self.showEffectEndCount = self.effectCount
        self:InitAwardDropPos(self.effectCount)
        self:ShowDropEffect()
    else
        if callback then
            callback()
        end
    end
end
function CommonDropItemEffect:ShowDropEffect()
    self.showDropEffectTimer =
        _G.TimerManager:GetInstance():GetTimer(
        _G.ConfigManager.discrete_cfg[awardEffectDiscreteID][1][1] / self.effectCount,
        self.ShowDropEffectCall,
        self,
        false,
        false,
        true
    )
    self.showDropEffectTimer:Start()
end
function CommonDropItemEffect:CoMove()
    local time = _G.ConfigManager.discrete_cfg[awardEffectDiscreteID][5][1]
    local speeds = {}
    local instanceID = 0
    local x, y, z
    local tempPos = _G.Vector3.unity_vector3.zero
    local Distance = _G.Vector3.Distance
    while self.showEffectEndCount > 0 do
        for trans, pos in pairs(self.effectTrans) do
            if not _G.IsNil(trans) then
                instanceID = trans:GetInstanceIDE()
                if not speeds[instanceID] then
                    x, y, z = trans:GetLocalPosition()
                    tempPos.x = x
                    tempPos.y = y
                    tempPos.z = z
                    speeds[instanceID] = Distance(pos, tempPos)
                end
                trans:SetLocalPosition(trans:SetMoveDirect(pos.x, pos.y, pos.z, speeds[instanceID], 1))
            end
        end
        _G.coroutine.waitforendofframe()
    end
end
function CommonDropItemEffect:ShowDropEffectCall()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world == nil then
        if self.showDropEffectTimer then
            self.showDropEffectTimer:Stop()
            self.showDropEffectTimer = nil
        end
        return
    end
    local effectRoot = world.GameObject
    local itemColor = self.effects[self.effectCount]
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[dropEffect[itemColor[1]][itemColor[2]]],
        effectRoot,
        _G.handler(self, self.ShowEffectCallback),
        _G.handler(self, self.ShowEffectEndCall)
    )
    self.effectCount = self.effectCount - 1
    if self.effectCount == 0 then
        if self.showDropEffectTimer then
            self.showDropEffectTimer:Stop()
            self.showDropEffectTimer = nil
        end
        return
    end
end
local effectSpacePos = 0.2
local effectActionRadius = 0
---获取掉落位置
---@param num number 数量
function CommonDropItemEffect:InitAwardDropPos(num)
    self.curShowEffectPos = {}
    local x, z
    local effectRadius = _G.ConfigManager.discrete_cfg[awardEffectDiscreteID][4][1]
    local range = _G.Mathf.Floor(effectRadius * 10 / effectSpacePos)
    local arRange = _G.Mathf.Floor(effectActionRadius * 10 / effectSpacePos)
    local dirright = {x = 0, z = 0}
    local dirforward = {x = 0, z = 0}
    for i = 1, num do
        x = _G.Mathf.Random(0, range)
        if x <= arRange then
            z = _G.Mathf.Random(arRange + 1, range)
        else
            z = _G.Mathf.Random(0, range)
        end
        x = x * 0.1 * effectSpacePos * (_G.Mathf.Random(1, 2) * 2 - 3)
        dirright.x = x * self.right.x
        dirright.z = x * self.right.z
        z = z * 0.1 * effectSpacePos
        dirforward.x = z * self.forward.x
        dirforward.z = z * self.forward.z
        _G.table.insert(
            self.curShowEffectPos,
            {
                x = self.targetPos.x + dirright.x + dirforward.x,
                y = self.targetPos.y,
                z = self.targetPos.z + dirright.z + dirforward.z
            }
        )
    end
end
--endregion

--region对外接口
---关闭显示
function CommonDropItemEffect:Close()
    if self.showDropEffectTimer then
        self.showDropEffectTimer:Stop()
        self.showDropEffectTimer = nil
    end
    if self.coMoveProgress then
        coroutine.stopwaiting(self.coMoveProgress)
        self.coMoveProgress = nil
    end
    self.effectTrans = {}
    self.close = true
end
---显示掉落表现
---@param data table 奖励数组(通过StorageManager.MergeAward方法合并后的数据)
---@param trans UnityEngine.Transform 显示的目标物体(取坐标和朝向)
---@param callback function 结束回调
---@param goldnum number 金币堆数
function CommonDropItemEffect:ShowByArray(item, trans, callback, goldnum)
    local x, y, z = trans:GetPosition()
    self.targetPos = {x = x, y = y, z = z}
    x, y, z = trans:GetForward()
    self.forward = {x = x, y = y, z = z}
    self.targetPos.x = self.targetPos.x + x
    self.targetPos.z = self.targetPos.z + z
    x, y, z = trans:GetRight()
    self.right = {x = x, y = y, z = z}
    self.goldNum = (goldnum and goldnum > 0) and goldnum or nil
    self:ShowAward(item, callback)
end
--endregion

return CommonDropItemEffect
