local CardCommentManager =require "CreateOtherPlayer"
---@class WorldPlayerData 世界场景中其他玩家的数据
---@field rolePath string 资源路径
---@field role_uid number 玩家UID
---@field role_name string 玩家名字
---@field loc number 玩家坐标
---@field Lv number 等级
---@field vipLv number vip等级
---@field DataType WorldItemDataType 物体或者玩家类型
_G.WorldPlayerData = _G.BaseClass("WorldPlayerData")
local WorldPlayerData = _G.WorldPlayerData

---类的构造函数
function WorldPlayerData:__init()
    self.rolePath = _G.ConfigManager.card_cfg[114200000].ModelPathLow
    self.role_uid = 0
    self.role_name = ""
    self.Lv = 1
    self.vipLv = 0
    self.DataType = _G.WorldItemDataType.Player
end
---类的析构函数
function WorldPlayerData:Dispose()
    self.rolePath = nil
    self.role_uid = nil
    self.role_name = nil
    self.Lv = nil
    self.vipLv = nil
    self.DataType = nil
    self.skin = nil
    self.title = nil
    self.circle = nil
    self.hell_id = nil
end
---构建一个主角的数据
function WorldPlayerData:SetPlayerSelfData()
    local pd = _G.PlayerModel:GetInstance()
    self.role_uid = pd:GetPlayerUid()
    self.role_name = pd.role_name
    self.MoveSpeed = 5
    --玩家移动起始点
    self.start_point = pd.start_point or 0
    --玩家移动结束点
    self.end_point = pd.end_point or 0
    --玩家移动起始时间戳
    self.start_time = pd.start_time or 0
end
---解析其他玩家数据
---@param pd scene_pb.SimpleUser 玩家数据
function WorldPlayerData:ResolvPlayerData(pd)
    self.role_uid = pd.role_uid
    self.role_name = pd.role_name
    self.MoveSpeed = 5
    --玩家移动起始点
    self.start_point = pd.start_point
    --玩家移动结束点
    self.end_point = pd.end_point
    --玩家移动起始时间戳
    self.start_time = pd.start_time
    self.skin = pd.skin or 114200000
    self.title = pd.title
    self.circle = pd.circle
    self.hell_id = pd.hell_id
    ---@type card_cfg
    local cfg = require "CardCommentManager":GetInstance():GetCfgs(self.skin)
    self.rolePath = cfg and cfg.ModelPathLow or self.rolePath
end

-----设置随从数据
---@param  sid number 卡牌sid
function WorldPlayerData:SetFollowerData(sid, pos)
    self.role_uid = sid
    self.sid = sid
    ---@type card_cfg
    local cfg = sid ~= 0 and _G.ConfigManager.card_cfg[sid] or nil
    self.rolePath = cfg and cfg.ModelPathLow or self.rolePath
    self.role_name = cfg and cfg.Name or ""
    self.LocalPos = pos
    local pd = _G.PlayerModel:GetInstance()
    self.MoveSpeed = pd.speed
end
return WorldPlayerData
