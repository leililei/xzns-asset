---@class DialogueAction	中文描述
local DialogueAction = _G.BaseClass("DialogueAction", _G.AINode)
_G.DialogueAction = DialogueAction

---类的启动函数
function DialogueAction:OnStart()
    self.Cfg = nil
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
    local pos = self.Item.Transform:GetPosition()
    self.OldPos = _G.Vector3(pos.x, pos.y, pos.z)
end

---@param id number 对话id
---@param worldid number 找场景中的谁对话id
function DialogueAction:OnData(...)
    local param = {...}
    self.Cfg = _G.ConfigManager.ai_dialogue_cfg[param[1]]
    self.OtherItem = require("WorldItemManager"):GetInstance():GetItemByUid(param[2])
end

---当条件成立时会调用
function DialogueAction:OnUpdate()
    if not self.Item.Runing then
        --("对话")
        self.Item.Runing = true
        local pPos = self.OtherItem.Transform:GetPosition()

        ---有点就走
        local goPos = _G.GameUtil.GetAroundPoint(self.Item.NavNodes, pPos, 8, 2, 2)
        if nil ~= goPos then
            local goSuccess =
                self.Item:GotoPoint(
                goPos,
                function()
                    self.Index = 1
                    self:DoDialogue(self.Cfg.Content[self.Index])
                end
            )
            if not goSuccess then
                self.Item.Runing = false
            end
        else
            self.Item.Runing = false
        end
    end

    return _G.NodeStatus.Success
end

function DialogueAction:DoDialogue(Content)
    local type = Content[1]
    local desc = Content[2]
    local pos
    if type == "Self" then
        pos = self.Item.Transform:GetPosition()
        local hudinfo = _G.HUDUtilities.CreateDefaultHudInfo()
        hudinfo.HudCfg.ResPath = _G.HUDData.ConstHudResData.DialogueHUDRes
        hudinfo.HudCfg.Content = desc
        hudinfo.WorldPosition = {pos.x, pos.y - 2, pos.z}
        hudinfo.BindTransform = self.Item.Transform
        hudinfo.HudCfg.FlowBindTarget = true
        hudinfo.HudCfg.Duration = 3
        _G.HUDUtilities.ShowHUDWith3DPos(hudinfo)
    elseif type == "Target" then
        pos = self.OtherItem.Transform:GetPosition()
        local hudinfo = _G.HUDUtilities.CreateDefaultHudInfo()
        hudinfo.HudCfg.ResPath = _G.HUDData.ConstHudResData.DialogueHUDRes
        hudinfo.HudCfg.Content = desc
        hudinfo.WorldPosition = {pos.x, pos.y - 2, pos.z}
        hudinfo.BindTransform = self.OtherItem.Transform
        hudinfo.HudCfg.FlowBindTarget = true
        hudinfo.HudCfg.Duration = 3
        _G.HUDUtilities.ShowHUDWith3DPos(hudinfo)
    end
    _G.DelayDo(
        3,
        function()
            self.Index = self.Index + 1
            if self.Index <= #self.Cfg.Content then
                self:DoDialogue(self.Cfg.Content[self.Index])
            else
                self.Item:GotoPoint(
                    self.OldPos,
                    function()
                        self.Item.Runing = false
                    end
                )
            end
        end
    )
end

---类的析构函数
function DialogueAction:Dispose()
end
