---@class LinedFollowAction    中文描述
local LinedFollowAction = _G.BaseClass("LinedFollowAction", _G.AINode)
_G.LinedFollowAction = LinedFollowAction

---类的启动函数
function LinedFollowAction:OnStart()
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
    self.Item.MoveSpeed = 1
    self.NeedChangePos = true
end

---@param id number 要跟随的对象id
---@param offx number 相对被跟随者的坐标差x方向
---@param offz number 相对被跟随者的坐标差z方向
function LinedFollowAction:OnData(...)
    local param = {...}
    self.FollowedId = param[1]
    self.OffX = param[2]
    self.OffZ = param[3]
    if self.FollowedId > 0 then
        self.FollowedItem = require("WorldItemManager"):GetInstance():GetItemByUid(self.FollowedId)
    else
        -- self.FollowedItem = require("WorldItemManager"):GetInstance():GetItemByUid(_G.PlayerModel:GetInstance().role_uid)
        self.FollowedItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    end
end

function LinedFollowAction:OnUpdate()
    if not self.Item.Runing then
        ---如果需要更新位置
        if self.NeedChangePos then
            --("位置调整")
            self.Item.MoveSpeed = 5
            self.Item.Runing = true
            self.Ry = _G.math.floor(self.FollowedItem.Transform.eulerAngles.y)
            self:GotoPos(
                self.FollowedItem.Transform:GetPosition(),
                function(str)
                    if str == "error" then
                        self.Item:PlayAnimByName("Idle")
                    else
                        --("位置调整完成")
                        self.NeedChangePos = false
                        self.Item.MoveSpeed = 1
                    end
                    self.Item.Runing = false
                end
            )
        else
            if _G.math.abs(self.Ry - _G.math.floor(self.FollowedItem.Transform.eulerAngles.y)) > 45 then
                --("需要位置调整")
                self.NeedChangePos = true
                return
            end
            --("跟随ing")
            local pos = self.FollowedItem.Transform:GetPosition()
            local ePos = _G.Vector3(pos.x + self.OffX, pos.y, pos.z + self.OffZ)
            local x, z =
                GetOffValue(ePos.x, ePos.z, pos.x, pos.z, _G.math.floor(self.FollowedItem.Transform.eulerAngles.y))
            local y = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting:GetY(x, z)
            self.Item.Transform:SetPosition(x, y, z)
            self.Item.Transform:LookAt(self.FollowedItem.Transform)
            self.Item:PlayAnimByName("Run")
        end
    end
    return _G.NodeStatus.Success
end

---去一个点
function LinedFollowAction:GotoPos(pos, back)
    local ePos = _G.Vector3(pos.x + self.OffX, pos.y, pos.z + self.OffZ)
    local x, z = GetOffValue(ePos.x, ePos.z, pos.x, pos.z, _G.math.floor(self.FollowedItem.Transform.eulerAngles.y))
    local y = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting:GetY(x, z)
    local isNode = _G.CS.UnityObjectExtends.CalculatePath(self.Item.Transform, x, y, z, self.Item.NavNodes)
    if isNode then
        local goSuccess =
            self.Item:GotoPoint(
            _G.Vector3(x, y, z),
            function()
                if back then
                    back()
                end
            end
        )
        if not goSuccess then
            if back then
                back("error")
            end
        end
    else
        if back then
            back("error")
        end
    end
end

---类的析构函数
function LinedFollowAction:Dispose()
end
