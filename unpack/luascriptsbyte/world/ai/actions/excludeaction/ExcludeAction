---@class ExcludeAction    中文描述
local ExcludeAction = _G.BaseClass("ExcludeAction", _G.AINode)
_G.ExcludeAction = ExcludeAction

---类的启动函数
function ExcludeAction:OnStart()
    self.R = 0
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
end

---@param r number 距离
function ExcludeAction:OnData(...)
    local param = {...}
    self.R = param[1]
end

---当条件成立时会调用
function ExcludeAction:OnUpdate()
    if not self.Item.Runing then
        --("排斥")
        self.Item.AIState = _G.AIActionType.Exclude
        self.Item.Runing = true
        ---以玩家为中心
        local pPos = _G.WorldManager:GetInstance():GetCurWorldPlayer().Transform:GetPosition()
        ---玩家半径外找一个点
        ---有点就走
        local goPos = _G.GameUtil.GetAroundPoint(self.Item.NavNodes, pPos, 8, self.R + 3, self.R + 1)
        if nil ~= goPos then
            --todo 行动区域限制
            local points = self.Item.RoutePoints
            local isInPolygon = _G.WorldUtils.PointInPolygon(goPos, points)
            if isInPolygon then
                local goSuccess =
                    self.Item:GotoPoint(
                    goPos,
                    function()
                        self.Item.Runing = false
                    end,
                    4
                )
                if not goSuccess then
                    self.Item.Runing = false
                end
            else
                self.Item.Runing = false
            end
        else
            self.Item.Runing = false
        end
    end

    return _G.NodeStatus.Success
end

---类的析构函数
function ExcludeAction:Dispose()
end
