---@class PatrolAction    中文描述
local PatrolAction = _G.BaseClass("PatrolAction", _G.AINode)
_G.PatrolAction = PatrolAction

---类的启动函数
function PatrolAction:OnStart()
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
end

---@param distance number 距离
---@param speed number 速度
function PatrolAction:OnData(...)
    local param = {...}
    self.R = param[1]
    self.MoveSpeed = param[2]
end

function PatrolAction:OnUpdate()
    if not self.Item.Runing then
        self.Item.AIState = _G.AIActionType.Patrol
        --("巡逻")
        self.Item.Runing = true
        local pPos = self.Item.Transform:GetPosition()
        ---自身半径外找一个点
        local goPos = _G.GameUtil.GetAroundPoint(self.Item.NavNodes, pPos, 8, self.R)
        ---有点就走
        if nil ~= goPos then
            --todo 行动区域限制
            local points = self.Item.RoutePoints
            local isInPolygon = _G.WorldUtils.PointInPolygon(goPos, points)
            if isInPolygon then
                local goSuccess =
                    self.Item:GotoPoint(
                    goPos,
                    function()
                        local yc = _G.math.random(4, 8)
                        --延时进入下段
                        _G.DelayDo(
                            yc,
                            function()
                                self.Item.Runing = false
                            end
                        )
                    end,
                    self.MoveSpeed
                )
                if not goSuccess then
                    self.Item.Runing = false
                end
            else
                self.Item.Runing = false
            end
        else
            self.Item.Runing = false
        end
    end
    return _G.NodeStatus.Success
end

---类的析构函数
function PatrolAction:Dispose()
end
