---@class FollowAction	中文描述
local FollowAction = _G.BaseClass("FollowAction", _G.AINode)
_G.FollowAction = FollowAction

---类的启动函数
function FollowAction:OnStart()
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
    self.FollowedItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    self.IsHasNavMeshAgent = false
    self.ItemObj = self.Item.Transform
    self.Nma = self.ItemObj:GetComponentE(_G.typeof(_G.NavMeshAgent))
    if _G.IsNil(self.Nma) then
        self.Nma = self.ItemObj:AddComponentE(_G.typeof(_G.NavMeshAgent))
    else
        self.IsHasNavMeshAgent = true
    end
end

---@param id number 要跟随的对象id
---@param offx number 相对被跟随者的坐标差x方向
---@param offz number 相对被跟随者的坐标差z方向
function FollowAction:OnData(...)
    self.FollowedItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
end

function FollowAction:OnUpdate()
    if self.Item.Runing then
        return
    end
    self.Item.Runing = true
    self.Item.AIState = _G.AIActionType.Follow

    local pos = self.FollowedItem.Transform:GetPosition()
    local ePos = _G.Vector3(pos.x, pos.y, pos.z - 1)
    local x, z = GetOffValue(ePos.x, ePos.z, pos.x, pos.z, _G.math.floor(self.FollowedItem.Transform.eulerAngles.y))
    local y = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting:GetY(x, z)
    local isNode = _G.CS.UnityObjectExtends.CalculatePath(self.Item.Transform, x, y, z, self.Item.NavNodes)
    if isNode then
        local goSuccess =
            self.Item:GotoPoint(
            _G.Vector3(x, y, z),
            function()
                self.Item.Runing = false
                self.Item.AIState = _G.AIActionType.None
            end
        )
        if not goSuccess then
            self.Item.Runing = false
            self.Item.AIState = _G.AIActionType.None
        end
    else
        self.Item.Runing = false
        self.Item.AIState = _G.AIActionType.None
    end
    return _G.NodeStatus.Success
end

---类的析构函数
function FollowAction:Dispose()
    if not self.IsHasNavMeshAgent then
        _G.DestroyObject(self.Nma)
    end
    self.Item:StopGoto()
    self.Item:PlayAnimByName("Idle")
    self.Item.AIState = _G.AIActionType.None
    self.Item.Runing = false
end
