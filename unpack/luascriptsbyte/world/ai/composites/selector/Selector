---@class Selector	中文描述
---@field CurrentChildIndex number 当前检测索引
---@field ExecutionStatus NodeStatus 节点状态
local Selector = _G.BaseClass("Selector", _G.AIComposite)
_G.Selector = Selector

---类的构造函数
function Selector:__init()
    self.CurrentChildIndex = 0
    self.ExecutionStatus = _G.NodeStatus.Inactive
end

---获取当前索引
function Selector:CurrentChildIndex()
    return self.CurrentChildIndex
end

---可否执行（条件成立与否）
function Selector:CanExecute()
    return self.CurrentChildIndex <= #self.ChildList and self.ExecutionStatus ~= _G.NodeStatus.Success
end

---执行时检测条件
function Selector:OnChildExecuted(childStatus)
    self.CurrentChildIndex = self.CurrentChildIndex + 1
    self.ExecutionStatus = childStatus
end

---中止条件判断
function Selector:OnConditionalAbort(childIndex)
    self.CurrentChildIndex = childIndex
    self.ExecutionStatus = _G.NodeStatus.Inactive
end

---结束
function Selector:OnEnd()
    _G.AIComposite.OnEnd(self)
    self.CurrentChildIndex = 0
    self.ExecutionStatus = _G.NodeStatus.Inactive
end

---类的析构函数
function Selector:Dispose()
    _G.AIComposite.Dispose(self)
end
