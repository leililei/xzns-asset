---@class Sequence	中文描述
---@field CurrentChildIndex number 当前检测索引
---@field ExecutionStatus NodeStatus 节点状态
local Sequence = _G.BaseClass("Sequence", _G.AIComposite)
_G.Sequence = Sequence

---类的构造函数
function Sequence:__init()
    self.CurrentChildIndex = 0
    self.ExecutionStatus = _G.NodeStatus.Inactive
end

---获取当前索引
function Sequence:CurrentChildIndex()
    return self.CurrentChildIndex
end

---可否执行（条件成立与否）
function Sequence:CanExecute()
    return self.CurrentChildIndex <= #self.ChildList and self.ExecutionStatus ~= _G.NodeStatus.Failure
end

---执行时检测条件
function Sequence:OnChildExecuted(childStatus)
    self.CurrentChildIndex = self.CurrentChildIndex + 1
    self.ExecutionStatus = childStatus
end

---中止条件判断
function Sequence:OnConditionalAbort(childIndex)
    self.CurrentChildIndex = childIndex
    self.ExecutionStatus = _G.NodeStatus.Inactive
end

---结束
function Sequence:OnEnd()
    _G.AIComposite.OnEnd(self)
    self.CurrentChildIndex = 0
    self.ExecutionStatus = _G.NodeStatus.Inactive
end

---类的析构函数
function Sequence:Dispose()
    _G.AIComposite.Dispose(self)
end
