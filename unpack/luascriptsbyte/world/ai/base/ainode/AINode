---@field Parent AIComposite 当前节点的父节点
---@field Type AINodeType 当前节点类型复合或者叶子
local AINode = _G.BaseClass("AINode")
_G.AINode = AINode

---类的构造函数
---@param id number 绑定的对象的唯一id
---@param parent AIComposite 当前节点的父节点
function AINode:__init(id, parent)
    self.Id = id and id or 0
    self.Parent = parent
    self.Type = _G.AINodeType.Node
    self:OnStart()
end

