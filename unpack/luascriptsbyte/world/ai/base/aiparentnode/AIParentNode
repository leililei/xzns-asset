---@class AIParentNode
---@field ChildList table 子节点列表
local AIParentNode = _G.BaseClass("AIParentNode", _G.AINode)
_G.AIParentNode = AIParentNode

---类的构造函数
function AIParentNode:__init()
    self.ChildList = {}
    self.Type = _G.AINodeType.Composites
end

---添加子点数据
function AIParentNode:AddChild(task)
    _G.table.insert(self.ChildList, task)
    task.Parent = self
end

---可否执行（条件成立与否）
function AIParentNode:CanExecute()
end

---执行时检测条件
function AIParentNode:OnChildExecuted(childStatus)
end

---中止条件判断
function AIParentNode:OnConditionalAbort(childIndex)
end

---结束
function AIParentNode:OnEnd()
    for i = 1, #self.ChildList do
        self.ChildList[i]:OnEnd()
    end
end

---类的析构函数
function AIParentNode:Dispose()
    for i = 1, #self.ChildList do
        self.ChildList[i]:Dispose()
    end
end
