---@class DialogueConditional	中文描述
local DialogueConditional = _G.BaseClass("DialogueConditional", _G.AINode)
_G.DialogueConditional = DialogueConditional

---类的构造函数
function DialogueConditional:OnStart()
    self.R = 0
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
    self.Player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    self.Item.Runing = false
end

---@param r number 距离
function DialogueConditional:OnData(...)
    local param = {...}
    self.R = param[1]
end

---此处作为行为触发的条件检测
function DialogueConditional:OnUpdate()
    ---检测玩家与AI目标的的距离
    local distance = _G.Vector3.Distance(self.Item.Transform:GetPosition(), self.Player.Transform:GetPosition())
    if distance < self.R then
        return _G.NodeStatus.Success
    end

    return _G.NodeStatus.Failure
end

---类的析构函数
function DialogueConditional:Dispose()
end
