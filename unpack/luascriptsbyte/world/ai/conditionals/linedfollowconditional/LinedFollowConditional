---@class LinedFollowConditional	中文描述
local LinedFollowConditional = _G.BaseClass("LinedFollowConditional", _G.AINode)
_G.LinedFollowConditional = LinedFollowConditional

---类的构造函数
function LinedFollowConditional:OnStart()
    ---这个值外围控制，暂时放这里
    self.Ld = true
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
end

function LinedFollowConditional:OnUpdate()
    ---是否列队
    if self.Ld then
        if self.Item.Runing and self.Item.AIState ~= _G.AIActionType.Follow then
            self.Item:StopGoto()
            self.Item.AIState = _G.AIActionType.Follow
            self.Item.Runing = false
        end
        return _G.NodeStatus.Success
    end

    return _G.NodeStatus.Failure
end

---类的析构函数
function LinedFollowConditional:Dispose()
end
