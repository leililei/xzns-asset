---@class FollowConditional	中文描述
local FollowConditional = _G.BaseClass("FollowConditional", _G.AINode)
_G.FollowConditional = FollowConditional

---类的构造函数
function FollowConditional:OnStart()
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
    self.FollowedItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    self.Item.Runing = false
end

---@param distance number 距离
function FollowConditional:OnData(...)
    local param = {...}
    self.R = 2.5
    --param[1]
end

function FollowConditional:OnUpdate()
    ---是否在移动中
    if not self.Item.Runing then
        local distance =
            _G.Vector3.Distance(self.Item.Transform:GetPosition(), self.FollowedItem.Transform:GetPosition())
        if distance > self.R then
            return _G.NodeStatus.Success
        end
    end

    return _G.NodeStatus.Failure
end

---类的析构函数
function FollowConditional:Dispose()
end
