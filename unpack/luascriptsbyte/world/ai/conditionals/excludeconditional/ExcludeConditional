---@class ExcludeConditional	中文描述
local ExcludeConditional = _G.BaseClass("ExcludeConditional", _G.AINode)
_G.ExcludeConditional = ExcludeConditional

---类的构造函数
function ExcludeConditional:OnStart()
    self.R = 0
    self.Item = require("WorldItemManager"):GetInstance():GetItemByUid(self.Id)
    self.Player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    self.Item.Runing = false
end

---@param r number 距离
function ExcludeConditional:OnData(...)
    local param = {...}
    self.R = param[1]
end

---此处作为行为触发的条件检测
function ExcludeConditional:OnUpdate()
    ---检测玩家与AI目标的的距离
    local distance = _G.Vector3.Distance(self.Item.Transform:GetPosition(), self.Player.Transform:GetPosition())
    if distance < self.R then
        if self.Item.Runing and self.Item.AIState ~= _G.AIActionType.Exclude then
            self.Item:StopGoto()
            self.Item.AIState = _G.AIActionType.Exclude
            self.Item.Runing = false
        end
        return _G.NodeStatus.Success
    end

    return _G.NodeStatus.Failure
end

---类的析构函数
function ExcludeConditional:Dispose()
end
