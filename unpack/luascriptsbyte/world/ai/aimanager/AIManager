---@class AIManager : Singleton    中文描述
local AIManager = _G.BaseClass("AIManager", _G.Singleton)
_G.AIManager = AIManager

---@return AIManager AIManager
function AIManager:GetInstance()
    return self.super.GetInstance(self)
end

---添加节点
local AddAINodeById
---根据配置创建
local CreateNodeByCfg
---创建行为
local CreateAction

---创建行为树
function AIManager:CreateAI()
end

---单独对场景中的人物加上AI
---@param nodeId number AI节点id
---@param id number 世界物体唯一id
function AIManager:AddAI(nodeId, id)
    local hasTree = false
    for _, v in _G.pairs(self.AITreeList) do
        if v.Id == id then
            hasTree = true
            break
        end
    end
    if not hasTree then
        AddAINodeById(self, nodeId, id)

        if _G.AppSetting.DEBUG then
            _G.Log("添加物体>>" .. id .. "<<AI", "<color=red>" .. ">>>" .. "</color>")
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("该物体已存在行为树！")
        end
    end
    if not self.UpdateAI.started then
        self.UpdateAI:Start()
    end
end

---清除某个物体AI
---@param id number 世界物体唯一id
function AIManager:ClearAI(id)
    if #self.AITreeList > 0 then
        for k, v in _G.pairs(self.AITreeList) do
            if v.Id == id then
                v:Dispose()
                _G.table.remove(self.AITreeList, k)
                break
            end
        end
        if #self.AITreeList <= 0 then
            ---计时器开着就关
            if self.UpdateAI.started then
                self.UpdateAI:Pause()
            end
        end

        if _G.AppSetting.DEBUG then
            _G.Log("清除物体>>" .. id .. "<<AI", "<color=red>" .. ">>>" .. "</color>")
        end
    else
        if _G.AppSetting.DEBUG then
            _G.Log("没有AI了大哥", "<color=red>" .. ">>>" .. "</color>")
        end
    end
end

---@param nodeId number AICompositeConfig配置对应的树型根节点
---@param id number 世界物体唯一id
AddAINodeById = function(self, nodeId, id)
    local item = require("WorldItemManager"):GetInstance():GetItemByUid(id)
    if not item then
        if _G.AppSetting.DEBUG then
            _G.LogError("场景中未找到AI目标>>>>>" .. id)
        end
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("树型结构开始", "<color=red>" .. ">>>" .. "</color>")
    end
    CreateNodeByCfg(nodeId, id, self.AITreeList, true)

    if _G.AppSetting.DEBUG then
        _G.Log("树型结构结束", "<color=red>" .. ">>>" .. "</color>")
    end
end

---@param nodeId number ai_composite_cfg配置对应的树型根节点id
---@param id number 世界物体唯一id
---@param parent table 树型根/父节点
---@param isRoot boolean 是否为根
CreateNodeByCfg = function(nodeId, id, parent, isRoot)
    ---@type ai_composite_cfg_Item aicCfg
    local aicCfg = _G.ConfigManager.ai_composite_cfg[nodeId]
    local cs
    if aicCfg.Type1 == _G.AICompositeType.Selector then
        if _G.AppSetting.DEBUG then
            _G.Log("Selector")
        end
        cs = _G.Selector.New()
    elseif aicCfg.Type1 == _G.AICompositeType.Sequence then
        if _G.AppSetting.DEBUG then
            _G.Log("Sequence")
        end
        cs = _G.Sequence.New()
    end
    cs.Id = id
    if isRoot then
        _G.table.insert(parent, cs)
    else
        parent:AddChild(cs)
    end
    if #aicCfg.TreeStructure > 0 then
        for i = 1, #aicCfg.TreeStructure do
            local onek = aicCfg.TreeStructure[i]
            local type = onek[1]
            local childId = onek[2]
            ---叶节点创建条件和行为
            if type == _G.AINodeType.Node then
                CreateAction(childId, id, cs)
            else
                ---复合节点继续生成树型
                CreateNodeByCfg(childId, id, cs, false)
            end
        end
    end
end

---@param nodeId number AICompositeConfig配置对应的树型根节点id
---@param id number 世界物体唯一id
---@param parent table 树型根/父节点
CreateAction = function(nodeId, id, parent)
    ---@type ai_action_cfg_Item action
    local action = _G.ConfigManager.ai_action_cfg[nodeId]
    if action.Action == _G.AIActionType.Exclude then
        if _G.AppSetting.DEBUG then
            _G.Log("ExcludeConditional")
        end

        if _G.AppSetting.DEBUG then
            _G.Log("ExcludeAction")
        end
        local tc = _G.ExcludeConditional.New(id, parent)
        tc:OnData(action.Distance)
        local ta = _G.ExcludeAction.New(id, parent)
        ta:OnData(action.Distance)
        parent:AddChild(tc)
        parent:AddChild(ta)
    elseif action.Action == _G.AIActionType.Dialogue then
        if _G.AppSetting.DEBUG then
            _G.Log("DialogueConditional")
        end

        if _G.AppSetting.DEBUG then
            _G.Log("DialogueAction")
        end
        local tc = _G.DialogueConditional.New(id, parent)
        tc:OnData(action.Distance)
        local ta = _G.DialogueAction.New(id, parent)
        ta:OnData(action.AIDialogueId, action.TargetId)
        parent:AddChild(tc)
        parent:AddChild(ta)
    elseif action.Action == _G.AIActionType.Patrol then
        if _G.AppSetting.DEBUG then
            _G.Log("PatrolConditional")
        end

        if _G.AppSetting.DEBUG then
            _G.Log("PatrolAction")
        end
        local tc = _G.PatrolConditional.New(id, parent)
        local ta = _G.PatrolAction.New(id, parent)
        ta:OnData(action.Distance, action.Speed)
        parent:AddChild(tc)
        parent:AddChild(ta)
    elseif action.Action == _G.AIActionType.LinedFollow then
        if _G.AppSetting.DEBUG then
            _G.Log("LinedFollowConditional")
        end

        if _G.AppSetting.DEBUG then
            _G.Log("LinedFollowAction")
        end
        local tc = _G.LinedFollowConditional.New(id, parent)
        local ta = _G.LinedFollowAction.New(id, parent)
        ta:OnData(action.TargetId, action.OffX, action.OffZ)
        parent:AddChild(tc)
        parent:AddChild(ta)
    elseif action.Action == _G.AIActionType.Follow then
        if _G.AppSetting.DEBUG then
            _G.Log("FollowConditional")
        end

        if _G.AppSetting.DEBUG then
            _G.Log("FollowAction")
        end
        local tc = _G.FollowConditional.New(id, parent)
        tc:OnData(action.Distance)
        local ta = _G.FollowAction.New(id, parent)
        ta:OnData(action.TargetId, action.OffX, action.OffZ)
        parent:AddChild(tc)
        parent:AddChild(ta)
    end
end

---创建对象时,入口构造函数
function AIManager:__init()
    self.AITreeList = {}
    self.PauseList = {}
    ---每秒更新
    self.UpdateAI = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateAIFunction, self, false, true)
end

---开始AI
function AIManager:StartAI()
    ---计时器没有开就开
    if not self.UpdateAI.started then
        self.UpdateAI:Start()
    end
end

---暂停AI
function AIManager:Pause()
    if self.UpdateAI.started then
        self.UpdateAI:Pause()
    end
end

---停掉所有AI
function AIManager:ClearAllAI()
    ---计时器开着就关
    if self.UpdateAI.started then
        self.UpdateAI:Pause()
    end
    for _, v in _G.pairs(self.AITreeList) do
        v:Dispose()
    end
    self.AITreeList = {}
    self.PauseList = {}

    if _G.AppSetting.DEBUG then
        _G.Log("关闭AI", "<color=red>" .. ">>>" .. "</color>")
    end
end

---暂停某个AI
---@param id number 世界物体唯一id
function AIManager:PauseAIById(id)
    if _G.AppSetting.DEBUG then
        _G.Log("暂停一个AI>>>>" .. id)
    end
    local index = table.indexof(self.PauseList, id)
    if false == index then
        table.insert(self.PauseList, id)
    end
end

---开启某个AI
---@param id number 世界物体唯一id
function AIManager:StartAIById(id)
    if _G.AppSetting.DEBUG then
        _G.Log("开启一个AI>>>>" .. id)
    end
    local index = table.indexof(self.PauseList, id)
    if false ~= index then
        table.remove(self.PauseList, index)
    end
end

---更新AI
function AIManager:UpdateAIFunction()
    self:Composite()
end

---复合节点更新逻辑
function AIManager:Composite()
    for _, node in ipairs(self.AITreeList) do
        if false == table.indexof(self.PauseList, node.Id) then
            if node.Type1 == _G.AINodeType.Composites then
                self:DoComposite(node)
            else
                node:OnUpdate()
            end
            node:OnEnd()
        end
    end
end

---检测节点状态是否满足条件
function AIManager:DoComposite(composite)
    for _, node in ipairs(composite.ChildList) do
        if node.Type1 == _G.AINodeType.Composites then
            self:DoComposite(node)
        else
            local can = node:OnUpdate()
            if node.Parent then
                self:ChangeExecute(node.Parent, can)
            end
        end
        local isCanExe = composite:CanExecute()
        if not isCanExe then
            break
        end
    end
end

---同步父节点状态
function AIManager:ChangeExecute(node, can)
    node:OnChildExecuted(can)
    if node.Parent then
        self:ChangeExecute(node.Parent, node.ExecutionStatus)
    end
end

---销毁对象时,析构函数
function AIManager:Dispose()
end
