---设置世界是否可见(同步隐藏和显示物件)
---@param isVisible boolean
function BaseWorld:Visible(isVisible)
    if self.isEnterWorld == isVisible then
        return
    end
    self.isEnterWorld = isVisible
    if not _G.IsNil(self.GameObject) then
        self.GameObject:SetActiveE(isVisible and 1 or 0)
    end
    if isVisible then
        for _, value in pairs(self.AllWorldItems) do
            value:CheckMoveing()
        end
    end
    if not _G.WorldManager:GetInstance():CheckCurSceneType(_G.SceneType.MainWorld) then
        for _, value in pairs(self.AllWorldItems) do
            value:ShowOrHide(isVisible)
        end
    end
    -- if isVisible then
    --     if self.curPlayerState == false then
    --         self:EnablePlayer()
    --         self.curPlayerState = true
    --     end
    -- elseif self.curPlayerState ~= false then
    --     self.curPlayerState = false
    --     self:DisablePlayer()
    -- end
    if isVisible then
        self:StartObjectAlphaCheck()
    else
        self:StopObjectAlphaCheck()
    end
end
-----进入世界
function BaseWorld:EnterWorld(immediately)
    self.CameraPosBoxList = {}
    self:InstWorld()
    self:InstAllItem()
    self:Visible(true, false, false)

    if self.curPlayerState == false then
        self:EnablePlayer()
        self.curPlayerState = true
    end

    if not self.Cfg.LockMainCamera then
        self.WorldSetting.SceneCamera:Look(self.WorldPlayer.Transform)
        self.WorldSetting.SceneCamera:UpdatePos(true)
        self:InitObjectAlphaCheck()
        self:StartObjectAlphaCheck()
    end
    self:OnChangeWorldOver()
    self:ChangeCameraBattle()
end
-----离开世界
function BaseWorld:LeaveWorld()
    self:ClearObjectAlphaCheck()
    if self.curPlayerState ~= false then
        self.curPlayerState = false
        self:DisablePlayer()
    end
    for uid, value in pairs(self.AllWorldItems) do
        if uid ~= _G.PlayerModel:GetInstance().role_uid then
            value:OnExitWorld(true)
        end
    end
    self.battleCamera = nil
    self.normalCamera = nil
    self.CameraPosBoxList = nil
end
---回收场景GameObject
function BaseWorld:DespawnWorld()
    if not _G.IsNil(self.SceneObject) then
        _G.WorldManager:GetInstance():PutSceneGameObj(self.SceneObject)
        self.SceneObject = nil
    end
    self:Visible(false)
end
