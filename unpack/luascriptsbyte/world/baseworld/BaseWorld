local worldItemDic = {
    --基础物件
    [_G.WorldItemType.Obj] = "WorldBaseItem",
    --宝箱
    [_G.WorldItemType.Box] = "WorldBoxItem",
    --可破坏物
    [_G.WorldItemType.Fragile] = "WorldFragileItem",
    --技能特效触发器
    [_G.WorldItemType.Trigger] = "WorldSkillEffectItem",
    --传送门
    [_G.WorldItemType.Door] = "WorldDoorItem",
    --Npc
    [_G.WorldItemType.NPC] = "WorldNPCItem",
    --敌人
    [_G.WorldItemType.Enemy] = "WorldEnemyItem",
    --障碍物
    [_G.WorldItemType.Barrier] = "WorldBarrierItem",
    --千机事件对象
    [_G.WorldItemType.Dungones] = "WorldDungonesEventItem",
    --主城幽灵
    [_G.WorldItemType.Ghost] = "WorldGhostItem"
}
---获取对应的场景物件数据结构
---@param _world BaseWorld|MainWorld 世界
---@param item_type WorldItemType 类型
---@param item_data WorldItemData 物件数据
---@return WorldBaseItem|WorldBoxItem|WorldNPCItem|WorldDoorItem|WorldBarrierItem 场景物件数据
function BaseWorld:CreateWorldItem(item_type, item_data, call)
    if item_data.Sid == nil or item_data.Sid == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("[BaseWorld]CreateWorldItem sid is " .. (item_data.Sid and "0" or "nil"))
        end
        return
    end
    ---@type BaseItemParam tab
    local info = {}
    info.dataType = _G.WorldItemDataType.NomalItem
    info.itemType = item_type
    info.sid = item_data.Sid
    info.uid = item_data.Uid
    info.world = self
    info.callback = call
    info.cfg = _G.ConfigManager.object_world_cfg[item_data.Sid]
    local script = worldItemDic[item_type]
    if string.IsNullOrEmpty(script) then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到相关类型的世界对象 type=" .. item_type)
        end
        return require("WorldBaseItem").New(info, item_data, self)
    else
        local item = require(script).New(info, item_data, self)
        return item
    end
end
