---加载世界场景数据
function BaseWorld:LoadData()
    if self.Cfg.TiledResLua == nil or self.Cfg.TiledResLua == "" then
        return
    end
    self.Data = setmetatable({}, {__index = require(self.Cfg.TiledResLua)})
    local _datas = self.Data.WorldItemDatas

    ---引导特效模型判定数组
    --local guideROle = {707010549, 707010550, 700000168, 700000169, 700000170}
    local guideROle = {}
    ---无用角色临时使用代码屏蔽掉
    --local blockObj = {707020142, 707020143, 707020144, 707020145, 300070002}
    local blockObj = {}

    ---@type WorldItemDataItem value
    for itype, value in pairs(_datas) do
        for _, itemData in pairs(value) do
            local canCreate = true
            if false ~= table.indexof(guideROle, itemData.Uid) then
                local ccr = _G.StoryUtilities.HasStoryIDSavedUID(800000109)
                if ccr then
                    canCreate = false
                end
            end
            if false ~= table.indexof(blockObj, itemData.Uid) then
                canCreate = false
            end
            if canCreate then
                local wid = _G.WorldItemData.New()
                wid:CloneData(itemData)
                wid.ItemType = _G.WorldItemType[itype]
                table.insert(self.ItemDataList, wid)
            end
        end
    end
end
-----创建世界
function BaseWorld:CreateWorld()
    -- 初始化场景流程控制器
    local pros = {
        {from = ProcedureType.preload_loading, to = ProcedureType.instWorld},
        {from = ProcedureType.instWorld, to = ProcedureType.initObjs},
        {from = ProcedureType.initObjs, to = ProcedureType.initPlayer},
        {from = ProcedureType.initPlayer, to = ProcedureType.complete}
    }
    self:InitProcedure(ProcedureType.preload_loading, ProcedureType.complete, pros)
end
---检查状态并切换
---@param callback function
---@param state string
function BaseWorld:CheckState(callback, state)
    _G.coroutine.start(
        function()
            local op = _G.Opearation.New()
            callback(op)
            while op.option ~= _G.Opearation.Close do
                _G.coroutine.waitforendofframe()
            end
            self.Procedure:DoProcedure(state)
        end
    )
end
---场景流程变换回调
function BaseWorld:ChangeProcedureHandler(event)
    local to_state = event.name
    if to_state == ProcedureType.preload_loading then
        self:CheckState(_G.handler(self, self.LoadSceneEffect), ProcedureType.instWorld)
    elseif to_state == ProcedureType.instWorld then
        self:CheckState(_G.handler(self, self.CacheWorld), ProcedureType.initObjs)
    elseif to_state == ProcedureType.initObjs then
        self:CheckState(_G.handler(self, self.InitObjs), ProcedureType.initPlayer)
    elseif to_state == ProcedureType.initPlayer then
        self:CheckState(_G.handler(self, self.InitPlayer), ProcedureType.complete)
    elseif to_state == ProcedureType.complete then
        self:OnComplete()
    end
end
-----加载场景开始的特效
---@param op Opearation 状态
function BaseWorld:LoadSceneEffect(op)
    local count = #self.Cfg.StartEffect
    if count <= 0 then
        op.option = _G.Opearation.Close
    else
        local loadCount = 0
        local callback = function()
            loadCount = loadCount + 1
            if loadCount >= count then
                op.option = _G.Opearation.Close
            end
        end
        if self.Cfg.StartEffect and #self.Cfg.StartEffect > 0 then
            for i = 1, #self.Cfg.StartEffect do
                _G.UIUtils.CacheEffectByCfg(_G.ConfigManager.ui_effect_cfg[self.Cfg.StartEffect[i]], callback)
            end
        end
    end
end
---创建根节点
function BaseWorld:CacheWorld(op)
    local _obj = _G.GameObject()
    _obj:SetName(self.Cfg.Name)
    self.GameObject = _obj
    self:Visible(false)
    local _obj2 = _G.GameObject()
    _obj2:SetName("AllItemRoot")
    self.ItemRoot = _obj2
    self.ItemRoot:SetParentE(self.GameObject)
    local _obj3 = _G.GameObject()
    _obj3:SetName("AllTitleRoot")
    self.TitleRoot = _obj3
    self.TitleRoot:SetParentE(self.GameObject)
    _obj3:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    _obj3:SetLayer("3DUI")
    ---傻逼策划成天提一些要换包的需求还不让我换包
    if not _G.GameObject.Find("3DUIRoot") then
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/3DUIRoot",
            _G.ePoolType.World,
            nil,
            function(trans)
                local Canvas = trans:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                local camera_go_3D = _G.GameObject.Find("3DUICamera"):GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
                Canvas.worldCamera = camera_go_3D
            end
        )
    end
    op.option = _G.Opearation.Close
    _G.UpdateManager:GetInstance():AddUpdate(self.SortTitle, self)
    self.upTitleCount = 0
end
---名称排序
function BaseWorld:SortTitle()
    if self.upTitleCount < 5 then
        self.upTitleCount = self.upTitleCount + 1
        return
    end
    self.upTitleCount = 0
    self.TitleRoot:SortChildByZ()
end
---初始化场景物件
---@param op Opearation 状态
function BaseWorld:InitObjs(op)
    local _datas = self.ItemDataList
    if #_datas <= 0 then
        op.option = _G.Opearation.Close
        return
    end
    local index = 0
    ---@param item WorldBaseItem item
    local cb = function(item)
        self.AllWorldItems[item.Uid] = item
        index = index + 1
        if index >= #_datas then
            op.option = _G.Opearation.Close
        end
    end

    ---@type WorldItemDataItem value
    for _, value in pairs(_datas) do
        local itemType = value.ItemType
        local item = self:CreateWorldItem(itemType, value, cb)
        if item and item.Init then
            item:Init()
        end
    end
end
---初始化主角
---@param callback function 完成回调
function BaseWorld:InitPlayer(op)
    self:InitPlayerBySid(
        function()
            op.option = _G.Opearation.Close
        end,
        _G.PlayerModel:GetInstance():GetRoleSid()
    )
end
