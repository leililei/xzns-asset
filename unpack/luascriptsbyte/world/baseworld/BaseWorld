---加载世界场景
function BaseWorld:InstWorld()
    self.SceneObject = _G.WorldManager:GetInstance():GetSceneGameObj(self.Cfg.SceneName)
    self.SceneObject:SetParentE(self.GameObject)
    self.WorldSetting = self.SceneObject:GetComponentE(_G.typeof(_G.CS.WorldSetting))
    self.SceneObject:SetLocalPosition(self.Data.BaseInfo.OffSetX, 0, self.Data.BaseInfo.OffSetZ)
    self.SceneObject:SetActiveE(1)
    self.WorldSetting:Init()
    self.WorldPlayer.WorldCameraControl.CurrentBindCamera = self.WorldSetting.SceneCamera
    self.WorldPlayer.WorldCameraControl.CurrentBindCamera.DisablePositionSynchronization = self.Cfg.LockMainCamera

    local cameraPosBox = self:GetCanmeraPosBox()
    if cameraPosBox then
        cameraPosBox:AddComponentE(typeof(CS.WorldItemControl))
        local bc = cameraPosBox:GetComponentE(typeof(CS.UnityEngine.BoxCollider))
        local ide = cameraPosBox:GetInstanceIDE()
        _G.WorldCsListener.AddTriggerCall(ide, nil)
        self.AllWorldItemsByInstId[ide] = cameraPosBox
        _G.DelayFrameDo(
            function()
                bc.enabled = true
                cameraPosBox:SetLocalPosition(0, 0, -0.2)
            end
        )
    end
end

---获取相机碰撞体
function BaseWorld:GetCanmeraPosBox()
    local num = self.WorldSetting.SceneCamera:GetChildCountE()
    if num > 0 then
        local cameraPosBox = self.WorldSetting.SceneCamera:GetChildE(0)
        return cameraPosBox
    end
    return nil
end

