-----创建主角
---@param callback function 创建完成回调
---@param sid number 卡牌sid
function BaseWorld:InitPlayerBySid(callback, sid)
    local data = WorldPlayerData.New()
    data:SetPlayerSelfData()
    data.sid = sid
    data.rolePath = sid ~= 0 and require "CardCommentManager":GetInstance():GetCfgs(sid).ModelPathLow or ""
    local info =
        self:CreatePlayerBaseData(
        data,
        function(item)
            if callback then
                callback()
            end
            item.Transform:SetActiveE(not self.Cfg.HideSelfPlayer and 1 or 0)
        end
    )
    local player = require("WorldPlayerItem").New(info, data, self)
    self.AllWorldItems[player.Uid] = player
    self.WorldPlayer = player
    player:Init()
end
---切换世界结束
---隐藏主界面，播放特效
function BaseWorld:OnChangeWorldOver()
    if self.isPlayEffect then
        return
    end
    self.isPlayEffect = true
    if self.Cfg.StartEffect and #self.Cfg.StartEffect > 0 then
        self.StartEffectIndex = 1
        self:OnLoadEffect()
    else
        self.WorldSetting:EnableCameraAnimator(true)
    end
end
---加载特效
function BaseWorld:OnLoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[self.Cfg.StartEffect[self.StartEffectIndex]],
        self.SceneObject,
        nil,
        _G.handler(self, self.OnLoadEffectComplete)
    )
end
---响应特效播放完成
function BaseWorld:OnLoadEffectComplete()
    self.StartEffectIndex = self.StartEffectIndex + 1
    if self.StartEffectIndex > #self.Cfg.StartEffect then
        self.WorldSetting:EnableCameraAnimator(true)
    else
        self:OnLoadEffect()
    end
end

