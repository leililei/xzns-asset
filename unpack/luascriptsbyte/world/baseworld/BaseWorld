---创建玩家的基础构造信信息，其他玩家数据通用
---@param data WorldPlayerData 玩家数据信息
---@param callback function 创建玩家的后的回掉
---@return BaseItemParam
function BaseWorld:CreatePlayerBaseData(data, callback)
    local cfg = {}
    cfg.Res = data.rolePath
    ---@type BaseItemParam tab
    local info = {}
    info.dataType = _G.WorldItemDataType.Player
    info.uid = data.role_uid
    info.sid = data.sid
    info.cfg = cfg
    info.world = self
    info.callback = callback
