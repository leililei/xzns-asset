    local items = {}
    local sid = 0
    if self.ItemDataList and #self.ItemDataList > 0 then
        for i = 1, #self.ItemDataList do
            sid = self.ItemDataList[i].Sid
            if items[sid] then
                items[sid] = items[sid] + 1
            else
                items[sid] = 1
            end
        end
    end
    return items
