---从世界对象中删除
---@param uid number
function BaseWorld:RemoveWorldItems(uid)
    local item = self.AllWorldItems[uid]
    if item then
        if self.setTransparentEffectIds and self.setTransparentEffectIds[uid] then
            self.CommonEff:StopRoleTransparentEffect(item.ObjectMod)
            self.setTransparentEffectIds[uid] = nil
        end
        item:OnExitWorld()
        item:DisWorldItem()
        self.AllWorldItems[uid] = nil
        self:RemoveCameraPosBoxById(uid)
        self.setTransparentEffectIds[uid] = nil
        self.allItemDis[uid] = nil
    end
end

---从世界删除除角色外的对象
---@param uid number
function BaseWorld:RemoveWorldAllObjItems()
    local keys = {}
    for key, value in pairs(self.AllWorldItems) do
        if key ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
            table.insert(keys, key)
        end
    end
    for i = 1, #keys do
        self:RemoveWorldItems(keys[i])
    end
end

---从世界删除除角色外的对象
---@param uid number
function BaseWorld:RemoveWorldAllObjItemsButid(id)
    local keys = {}
    for key, value in pairs(self.AllWorldItems) do
        if key ~= _G.PlayerModel:GetInstance():GetPlayerUid() and value.ItemData.EventId ~= id then
            table.insert(keys, key)
        end
    end
    for i = 1, #keys do
        self:RemoveWorldItems(keys[i])
    end
end

