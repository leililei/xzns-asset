--region 生命周期
---@param sid number
function BaseWorld:__init(sid, progressCall)
    self.Procedure = _G.Procedure.New()
    self.IsInitOver = false
    self.Progress_call = progressCall
    self.Sid = sid
    self.GameObject = nil
    self.Data = nil
    self.WorldSetting = nil
    self.ItemRoot = nil
    self.WorldPlayer = nil
    self.SceneObject = nil
    self.Cfg = _G.ConfigManager.scene_cfg[self.Sid]
    self.ItemDataList = {}
    self.AllWorldItems = {}
    self.AllWorldItemsByInstId = {}
    self.CameraPosBoxList = {}
    --self.NpcPoss = {}
    self.CommonEff = _G.CS.EngineCenter.CommonEffect.Instance
    self.CommonEff:ReInit()
    self:Init()
end
---清理工作
function BaseWorld:Dispose()
    for k, value in pairs(self.AllWorldItems) do
        value:DisWorldItem()
    end
    self.CommonEff:Clear()
    self.ItemDataList = nil
    self.Procedure:Dispose()
    self.Procedure = nil
    --self.NpcPoss = nil
    self.CameraPosBoxList = nil
    self.AllWorldItemsByInstId = nil
    self.AllWorldItems = nil
    self.followPlayer = nil
    self.ItemRoot = nil
    if not _G.IsNil(self.GameObject) then
        _G.GameObject.Destroy(self.GameObject)
    end
    self.GameObject = nil
    self.SceneObject = nil
    self.Cfg = nil
    self.WorldPlayer = nil
    self.WorldSetting = nil
    self.Sid = nil
    self.Progress_call = nil
    self.IsInitOver = nil
    self.Data = nil
    self.curAllItemShow = nil
    _G.UpdateManager:GetInstance():RemoveUpdate(self.SortTitle, self)
end
--endregion

