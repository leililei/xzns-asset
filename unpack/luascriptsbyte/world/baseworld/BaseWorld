--region 物件透明度和显示检测处理
---初始化物件透明展示检测
function BaseWorld:InitObjectAlphaCheck()
    --检测物体透明度离散表ID
    local cfg = _G.ConfigManager.discrete_cfg[103502]
    local checkAlphaDisIndex = 1
    local checkAlphaIndexNear = 1
    local checkAlphaIndexFar = 2
    local checkAlphaValueIndex = 2
    self.checkAlphaDis = {
        near = cfg[checkAlphaDisIndex][checkAlphaIndexNear]
    }
    self.checkAlphaValue = {
        near = cfg[checkAlphaValueIndex][checkAlphaIndexNear],
        far = cfg[checkAlphaValueIndex][checkAlphaIndexFar]
    }
    --检测是否显示离散表ID
    cfg = _G.ConfigManager.discrete_cfg[103505]
    self.checkShowDis = cfg[1][1]
    self.checkAlphaValue.far = self.checkAlphaValue.far - self.checkAlphaValue.near
    self.allItemDis = {}
    self.setTransparentEffectIds = {}
    self:InitTitleScaleData()
end
---初始化名称缩放
function BaseWorld:InitTitleScaleData()
    ---头顶名称的缩放范围
    self.titleScaleRange = _G.ConfigManager.discrete_cfg[103507]
    local titleScaleOneDis = self.titleScaleRange[2][1]
    local titleScaleOneFov = 45
    local pi = 3.1416 / 180
    titleScaleOneDis =
        titleScaleOneDis * Mathf.Tan(titleScaleOneFov * pi) /
        Mathf.Tan(_G.GraphicsManager.Instance.MainCamera.fieldOfView * pi)
    self.titleScaleRange = _G.DeepCopyCfgTable(self.titleScaleRange[1])
    self.titleScaleRange[1] = titleScaleOneDis / self.titleScaleRange[1] * 100
    self.titleScaleRange[2] = titleScaleOneDis / self.titleScaleRange[2] * 100
    if self.titleScaleRange[1] > self.titleScaleRange[2] then
        titleScaleOneDis = self.titleScaleRange[1]
        self.titleScaleRange[1] = self.titleScaleRange[2]
        self.titleScaleRange[2] = titleScaleOneDis
    end
end
---清理物件透明展示检测
function BaseWorld:ClearObjectAlphaCheck()
    self:StopObjectAlphaCheck()
    self.checkAlphaDis = nil
    self.checkAlphaValue = nil
    self.allItemDis = nil
    if self.setTransparentEffectIds then
        for uid in pairs(self.setTransparentEffectIds) do
            self.CommonEff:StopRoleTransparentEffect(self.AllWorldItems[uid].ObjectMod)
        end
        self.setTransparentEffectIds = nil
    end
    self.alphaCheckUpdate = nil
    self.titleScaleOneDis = nil
    self.titleScaleRange = nil
end
function BaseWorld:ResetObjectAlphaEffect()
    if self.setTransparentEffectIds then
        for uid in pairs(self.setTransparentEffectIds) do
            self.CommonEff:StopRoleTransparentEffect(self.AllWorldItems[uid].ObjectMod)
            self.setTransparentEffectIds[uid] = nil
        end
    end
    if self.allItemDis then
        for uid in pairs(self.allItemDis) do
            self.allItemDis[uid] = nil
        end
    end
end
---开启物件透明展示检测
function BaseWorld:StartObjectAlphaCheck()
    if not self.isEnterWorld then
        return
    end
    if not self.checkAlphaDis then
        return
    end
    self.needCheckTag = true
    self.alphaCheckUpdate = self.alphaCheckUpdate or _G.handler(self, self.UpdateObjectAlpha)
    local updateInstance = _G.UpdateManager:GetInstance()
    if not updateInstance:HasUpdate(self.alphaCheckUpdate, self) then
        updateInstance:AddUpdate(self.alphaCheckUpdate, self)
    end
end
---关闭物件透明展示检测
function BaseWorld:StopObjectAlphaCheck()
    _G.UpdateManager:GetInstance():RemoveUpdate(self.alphaCheckUpdate, self)
end

---@param item BaseItem
function BaseWorld:AddCameraPosBoxItem(item)
    --LogError(#self.CameraPosBoxList, "添加前")
    if item.ObjectMod then
        item.ObjectMod:SetActiveE(1)
    end
    local isHas = false
    for _, v in ipairs(self.CameraPosBoxList) do
        if item.Uid == v.Uid then
            isHas = true
            break
        end
    end
    if not isHas then
        --LogError(item.Uid, "添加uid")
        table.insert(self.CameraPosBoxList, item)
    end
    --LogError(#self.CameraPosBoxList, "添加后")
end

---@param item BaseItem
function BaseWorld:RemoveCameraPosBoxItem(item)
    if item.ObjectMod then
        item.ObjectMod:SetActiveE(0)
    end
    --LogError(#self.CameraPosBoxList, "移除前")
    for k, v in ipairs(self.CameraPosBoxList) do
        if item.Uid == v.Uid then
            table.remove(self.CameraPosBoxList, k)
            --LogError(item.Uid, "删除uid")
            break
        end
    end
    --LogError(#self.CameraPosBoxList, "移除后")
end

function BaseWorld:RemoveCameraPosBoxById(uid)
    --LogError(#self.CameraPosBoxList, "移除前")
    for k, v in ipairs(self.CameraPosBoxList) do
        if uid == v.Uid then
            table.remove(self.CameraPosBoxList, k)
            --LogError(item.Uid, "删除uid")
            break
        end
    end
    --LogError(#self.CameraPosBoxList, "移除后")
end

local Abs = _G.Mathf.Abs
---玩家相对摄像机的Z坐标
local checkPlayerDisZ = 0
---玩家相对摄像机的Z坐标
--local checkPlayerDisX = 0
---物件相对于摄像机的X坐标
--local checkAlphaDisX = 0
---物件相对于摄像机的Z坐标
local checkAlphaDisZ = 0
function BaseWorld:UpdateObjectAlpha()
    if not self.isEnterWorld then
        return
    end
    if nil == self.CameraPosBoxList then
        return
    end
    --if self.WorldPlayer.CurMove then
    _, checkPlayerDisZ = self.WorldPlayer.Transform:GetPositionOnTarget(self.WorldSetting.SceneCamera)
    --self.WorldPlayer.CurMove = false
    --end

    for _, v in ipairs(self.CameraPosBoxList) do
        if v.ObjectMod then
            local uid = v.Uid
            -- if v.Cfg.Type1 == _G.WorldItemType.NPC then
            --     if nil == self.NpcPoss[uid] then
            --         local x, z = v.ObjectMod:GetPositionOnTarget(self.WorldSetting.SceneCamera)
            --         self.NpcPoss[uid] = {x, z}
            --         checkAlphaDisX = x
            --         checkAlphaDisZ = z
            --     else
            --         checkAlphaDisX = self.NpcPoss[uid][1]
            --         checkAlphaDisZ = self.NpcPoss[uid][2]
            --     end
            -- else
            _, checkAlphaDisZ = v.ObjectMod:GetPositionOnTarget(self.WorldSetting.SceneCamera)
            --end
            if checkPlayerDisZ < 0 then
                checkAlphaDisZ = checkAlphaDisZ * -1
                checkPlayerDisZ = checkPlayerDisZ * -1
            end
            if checkAlphaDisZ < self.checkAlphaDis.near then --距离过近
                if self.needCheckTag or not self.allItemDis[uid] or self.allItemDis[uid] >= self.checkAlphaDis.near then
                    self.allItemDis[uid] = checkAlphaDisZ
                end
                v:ShowOrHideChild(false)
            else
                if checkAlphaDisZ <= checkPlayerDisZ then --alpha范围内
                    if
                        self.needCheckTag or not self.allItemDis[uid] or
                            Abs(self.allItemDis[uid] - checkAlphaDisZ) >= 0.1
                     then
                        if not self.setTransparentEffectIds[uid] then
                            self.CommonEff:StartRoleTransparentEffect(v.ObjectMod, 1)
                            self.setTransparentEffectIds[uid] = true
                        end
                        self.allItemDis[uid] = checkAlphaDisZ
                        checkAlphaDisZ =
                            (checkAlphaDisZ - self.checkAlphaDis.near) / (checkPlayerDisZ - self.checkAlphaDis.near)
                        local alpha = self.checkAlphaValue.near + (self.checkAlphaValue.far * checkAlphaDisZ)
                        self.CommonEff:UpdateRoleTransparent(v.ObjectMod, alpha)
                        v:HideEffect(alpha < 0.9)
                        v:ShowOrHideChild(alpha > 0.1)
                    end
                else --距离远
                    if self.needCheckTag or not self.allItemDis[uid] or self.allItemDis[uid] < checkPlayerDisZ then
                        self.allItemDis[uid] = checkAlphaDisZ
                    end
                    if not self.setTransparentEffectIds[uid] then
                        self.CommonEff:StartRoleTransparentEffect(v.ObjectMod, 1)
                        self.setTransparentEffectIds[uid] = true
                    end
                    self.CommonEff:UpdateRoleTransparent(v.ObjectMod, 1)
                    v:ShowOrHideChild(true)
                end
            end
            v:UpdateTitlePos()
        end
    end
    self.WorldPlayer:CheckNewTitle()
    self.WorldPlayer:UpdateTitlePos()
    self.needCheckTag = false
end
function BaseWorld:CalculateTitleScale(dis)
    if dis <= 0 then
        return 1
    end
    if dis < self.titleScaleRange[1] then --距离过近
        return dis / self.titleScaleRange[1]
    elseif dis <= self.titleScaleRange[2] then --范围内
        return 1
    else --距离过远
        return dis / self.titleScaleRange[2]
    end
end
