---处理点击地表事件
---@param name string 点击物体名字
function BaseWorld:OnClick(tag, name, point)
    if tag == "Walk" then --点地板
        if self.Cfg.Scene_Type ~= _G.SceneType.Dungones then
            self.WorldPlayer:GotoPoint(point)
            _G.Events:GetInstance():Broadcast(_G.eNav.HideFlag, self.WorldPlayer.Uid)
            self.WorldPlayer:SetClickTarget(nil)
            -- else
            --
            if _G.AppSetting.DEBUG then
                _G.Log("千机黑刹场景不需要移动")
            end
        end
    elseif tag == "WorldObject" then --点物件
        local ID = _G.tonumber(name)
        local itemInfo = self:GetItemInfo(ID)
        if itemInfo and itemInfo.OnClick then
            _G.Events:GetInstance():Broadcast(_G.eGuideEvent.WorldObjRespond)
            self.WorldPlayer:SetClickTarget(ID)
            itemInfo:OnClick()
        end
    end
end
---获取对应ID的场景物体
