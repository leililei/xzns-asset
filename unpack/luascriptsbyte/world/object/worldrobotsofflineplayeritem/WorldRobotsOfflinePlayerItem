local base = require "WorldRobotsBasePlayerItem"
---@class WorldRobotsOfflinePlayerItem:WorldRobotsBasePlayerItem
local WorldRobotsOfflinePlayerItem = _G.BaseClass("WorldRobotsOfflinePlayerItem", base)
---类的构造函数
---@param data WorldPlayerData
function WorldRobotsOfflinePlayerItem:__init(info, data, world)
    self.Cfg = {
        Res = info.cfg.Res,
        name = data.role_name,
        title_effect = data.title and data.title.sid or 0,
        halo_effect =data.circle and data.circle.sid or 0
    }
    self.Uid = data.role_uid
end
function WorldRobotsOfflinePlayerItem:GotoPointSuc()
    _G.SystemSettingManager:GetInstance():OpenView(self.Uid)
end

return WorldRobotsOfflinePlayerItem
