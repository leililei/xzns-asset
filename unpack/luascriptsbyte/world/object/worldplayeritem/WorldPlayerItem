---初始化点光源
function WorldPlayerItem:InitLightPoint()
    local setting = _G.GetCurrentEnvironmentSetting()
    if setting and setting.MovePointLight then
        if not setting.MovePointLight.IsExcludeRole then
            setting.MovePointLight.IsExcludeRole = true
        end
        setting.MovePointLight:SetParentE(self.Transform, 0)
        self:SetLightPos(setting.MovePointLight.transform)
    end
end

function WorldPlayerItem:RemoveLight()
    local setting = _G.GetCurrentEnvironmentSetting()
    if setting and setting.MovePointLight then
        if not setting.MovePointLight.IsExcludeRole then
            setting.MovePointLight.IsExcludeRole = true
        end
        setting.MovePointLight:SetParentE(setting.MovePointLight.transform, 0)
    end
end

function WorldPlayerItem:SetLightPos(trans)
    if not _G.IsNil(trans) then
        if not _G.IsNil(self.RolePoint) and not _G.IsNil(self.RolePoint.Point_Head) then
            local x, y, z = self.RolePoint.Point_Head:GetPosition()
            local x1, y1, z1 = self.Transform:GetPosition()
            local s = trans:GetLocalScale()
            local pos = {}
            pos.x = 0
            pos.z = 0
            pos.y = (y - y1) * s
            trans:SetLocalPosition(pos.x, pos.y, pos.z)
        end
    end
end

