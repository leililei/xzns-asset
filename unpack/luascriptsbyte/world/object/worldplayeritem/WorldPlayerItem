--region 新增方法
-----设置锁定Transform 锁定后 不可改变朝向和位置
---@param lock boolean 状态:是否锁定
function WorldPlayerItem:SetTransformLock(lock)
    if (not self.lockTransform and not lock) or (lock == self.lockTransform) then
        return
    end
    self.lockTransform = lock
    self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    if not lock and self.MoveStep == 1 then
        if self.curMoveDir then
            _G.CS.UnityObjectExtends.SetRot(self.Transform, nil, self.curMoveDir, nil, false)
            self.curMoveDir = nil
        end
        self:Move(self.MoveStep)
    end
    if lock and self.isGoToPoint then
        self:NavInterruptMove(true)
    end
end

---设置位置
---@param posV3 UnityEngine.Vector3 玩家位置(空则用默认位置)
---@param angleV3 UnityEngine.Vector3 玩家朝向(空则用默认位置)
function WorldPlayerItem:SetInitPosition(posV3, angleV3, isFirst)
    if nil == isFirst then
        isFirst = false
    end
    if not posV3 then
        --设置玩家的位置。
        local data = self.ItemData
        posV3 = _G.WorldUtils.CaculateLocalPos(data.start_point, data.end_point, data.start_time, self.MoveSpeed)
    end
    ---首次随机并且只有luochajie
    if isFirst and _G.WorldManager:GetInstance().curSceneSid == 300 then
        self:SetRandomPos()
    else
        self.Transform:SetLocalPosition(posV3.x, posV3.y, posV3.z)
    end
    if angleV3 then
        self.Transform:SetLocalEulerAngles(angleV3.x, angleV3.y, angleV3.z)
    else
        --设置角色朝向
        local info = self.World.Data.BaseInfo
        self.Transform:SetEulerAngles(info.PlayerInitAngleX, info.PlayerInitAngleY, info.PlayerInitAngleZ)
    end
end

