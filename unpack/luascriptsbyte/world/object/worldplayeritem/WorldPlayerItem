---设置模型相关数据
---@param sid number 卡牌sid
function WorldPlayerItem:SetModelPath(uid, sid, path)
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        if uid ~= nil then
            self.Uid = uid
        end
    end
    self.Sid = sid
    if not _G.IsNil(self.Transform) then
        self.Transform:SetName(self.Uid)
    end
    self.Cfg.Res = path
    local names = _G.string.split(self.Cfg.Res, "/")
    self.ObjectModName = names[#names]
    self:InitStandActionName()
end

---更换模型
---@param uid number 卡牌uid
---@param sid number 卡牌sid
---@param path string 模型路径
---@param callback function 等待剧情行为加载回调
function WorldPlayerItem:ChangeModel(uid, sid, path, callback)
    if sid == 0 then
        self:OnExitWorld()
    else
        self:SetWaitExecuteCpCall(callback)
        self:StopStandActionTimer()
        self:SetModelPath(uid, sid, path)
        self:ClearObjectModel()
        self.Designation = nil
        base.OnEnterWorld(self)
        self.isChangeModel = true
    end
end

