local base = require "WorldBasePlayer"
---@class WorldPlayerItem : WorldBaseItem
---@field public MoveSendDuration number 当玩家移动时，和服务器通信的周期
---@field public PassedPoint number[] 通过的路径点List,二进制UV数据
---@field public WorldCameraControl WorldCameraControl 摄像机控制器
---@field public WalkTimer Timer 计时器，每self.MoveSendDuration秒和服务器进行一次通信
---@field public FixPoint number 错误移动时的玩家修复位置,二进制UV数据
---@field public IsSendMsg boolean 玩家移动是否和服务器通信
---@field private lastPos Vector3 玩家上一个时间节点的位置
---@field private targetPos Vector3 玩家移动的上一次目标点
---@field private targetPos Vector3 玩家移动的当前目标点
---@field private StandActionTimer Timer 更换休闲动作倒计时
---@field protected StandActionTime number 休闲动作的等待最长时间
---@field protected StandActionName table 所有的休闲待机
local WorldPlayerItem = _G.BaseClass("WorldPlayerItem", base)
_G.WorldPlayerItem = WorldPlayerItem
---@field private sendPosMinValue number 玩家移动的通信最小值
local sendPosMinValue = 1

---计算两个坐标的距离(X轴和Z轴的差值，数字向下取整)
---@param pos1 UnityEngine.Vector3 对应坐标点
---@param pos2 UnityEngine.Vector3 对应坐标点
---@return int|int X轴和Z轴的差值绝对值
local function CaculatePosDistance(pos1, pos2)
    local floor = _G.Mathf.Floor
    local abs = _G.Mathf.Abs
    return abs(floor(pos1.x) - floor(pos2.x)), abs(floor(pos1.z) - floor(pos2.z))
end

function WorldPlayerItem:__init()
    self.halo = _G.PlayerModel:GetInstance().halo
    self.title = _G.PlayerModel:GetInstance().title
end

function WorldPlayerItem:Dispose()
    _G.UpdateManager:GetInstance():RemoveUpdate(self.UpdateMoveFunction, self)
    self:SetTimerState(false)
    if self.WalkTimer then
        self.WalkTimer:Stop()
        self.WalkTimer = nil
    end
    self.WorldCameraControl = nil
    self.lockTransform = nil
    self.MoveSendDuration = nil
    self.IsSendMsg = nil
    self.lastPos = nil
    self.curTargetPos = nil
    self.walkVector3CurPos = nil
    self.walkVector3LastPos = nil
    self:StopStandActionTimer()
end

--region 创建与销毁
function WorldPlayerItem:Init()
    self.lockTransform = false
    self.MoveSpeed = self.ItemData.MoveSpeed
    self.MoveSendDuration = 1
    self.isChangeModel = true
    self.StandActionTime = _G.ConfigManager.discrete_cfg[103202]
    self.StandActionTime = self.StandActionTime and self.StandActionTime[1][1] or 30
    base.LoadObject(self, "CommonPrefab/World/PlayerRootPrefab")
    self:SetModelPath(self.Uid, self.Sid, self.Cfg.Res)
end

---初始化闲置动画
function WorldPlayerItem:InitStandActionName()
    self.StandActionName = {}
    self.StandActionCount = 0
    if self.ItemData.sid <= 0 then
        return
    end

    local cfg = require "CardCommentManager":GetInstance():CardData(self.Sid, false)
    -- local cfg = _G.ConfigManager.card_cfg[self.ItemData.sid]
    if cfg then
        for k, v in pairs(cfg.display_click) do
            self.StandActionCount = self.StandActionCount + 1
            self.StandActionName[self.StandActionCount] = {sid = self:GetActionSid(v), name = v}
        end
    end
end

---加载资源完成
function WorldPlayerItem:OnLoadResObjComplete()
    self.WorldCameraControl = self.Transform:AddComponentE(_G.typeof(_G.WorldCameraControl))
    --创建头顶标题
    if self.World.Cfg.IsDisplay then
        local name = "<color=#ffee9c>" .. self.ItemData.role_name .. "</color>"
        base.InitTitle(
            self,
            name,
            nil,
            function()
                self:UpdateHell()
                self:InitDesignation()
            end
        )
    end
    local baseinfo = self.World.Data.BaseInfo
    local pos = {x = 0, y = 0, z = 0}
    pos.x = baseinfo.PlayerInitPosX
    pos.y = baseinfo.PlayerInitPosY
    pos.z = baseinfo.PlayerInitPosZ
    self:SetInitPosition(pos, nil, true)
    base.OnLoadResObjComplete(self)
end

---更新名字
function WorldPlayerItem:UpdateTitleName(name)
    self.ItemData.role_name = name
    self.TitleTextName.text = "<color=#fff08d>" .. name .. "</color>"
    -- _G.GameUtil.ReBuildRTF(self.TitleTransform:FindE("@_trans_root/title"))
    local objTitle = self.TitleTransform:FindE("@_trans_root/title")
    ---@type UnityEngine.UI.ContentSizeFitter
    local contentSize = self.TitleTextName:GetComponentE(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    contentSize:SetLayoutHorizontal()
    ---@type UnityEngine.UI.HorizontalLayoutGroup 
    local layout = objTitle:GetComponentE(typeof(CS.UnityEngine.UI.HorizontalLayoutGroup))
    layout:SetLayoutHorizontal()

    self.IschangeTitle = true
end

---初始化称号
function WorldPlayerItem:InitDesignation()
    local id = self.title.sid
    if self.Designation then
        self.Designation.obj.obj_effect:RemoveAllChildren()
        self.Designation.title:SetActiveE(0)
    end
    if _G.IsNil(self.TitleTransform) then
        return
    end
    if id == 0 then
        return
    end
    local cfg = _G.ConfigManager.player_title_effect_cfg[id]
    if cfg then
        if not self.Designation then
            local go_table = _G.GetAutoGoTable(self.TitleTransform)
            self.Designation = {obj = go_table, title = go_table.aorrawimage_Title, type = cfg.type_title}
        else
            self.Designation.type = cfg.type_title
        end
        if self.Designation.type == 1 then
            self.Designation.title:LoadImage(
                cfg.title,
                function(trans)
                    self.Designation.title:SetNativeSize()
                end
            )
            self.Designation.title:SetActiveE(1)
        else
            self.Designation.title:SetActiveE(0)
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.Designation.obj.obj_effect,
                function(trans)
                    if _G.IsNil(self.TitleTransform) then
                        _G.DestroyObject(trans)
                        return
                    end
                    local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                    if not _G.IsNil(effScript) then
                        effScript:SetIsShow(true)
                    end
                    trans:SetLayerAndChild(30)
                    -- local x, y, z = self.Designation.title:GetPosition()
                    -- trans:SetPosition(x, y + 0.2, z)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035)
                end
            )
        end
    elseif self.Designation then
        self.Designation.title:SetActiveE(0)
        self.Designation.title:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035)
    end
end

---初始化光圈
function WorldPlayerItem:InitHalo()
    if self.World.Cfg.WorldType ~= _G.WorldType.MainWorld then
        return
    end
    local id = self.halo.sid
    if not _G.IsNil(self.Halo) then
        _G.DestroyObject(self.Halo)
    end
    if id == 0 then
        return
    end
    local cfg = _G.ConfigManager.player_halo_effect_cfg[id]
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.halo,
            _G.ePoolType.World,
            self.Transform,
            function(trans)
                if _G.IsNil(self.Transform) or _G.IsNil(self.ObjectMod) then
                    _G.DestroyObject(trans)
                    return
                end
                self.Halo = trans
                if cfg.type_halo == 2 then
                    trans:SetParentE(self.RolePoint.Point_Chest)
                else
                    if not _G.IsNil(self.RolePoint) and not _G.IsNil(self.RolePoint.Point_Shadow) then
                        trans:SetParentE(self.RolePoint.Point_Shadow)
                    else
                        trans:SetParentE(self.Transform)
                    end
                    trans:SetLocalPosition(0, 0.01, 0)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103901][1][1])
                end
                trans:SetEulerAngles(0, 0, 0)
                trans:AddComponentE(_G.typeof(_G.CS.KeepRotate))
                local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                if not _G.IsNil(effScript) then
                    effScript:SetIsShow(true)
                end
            end
        )
    end
end

