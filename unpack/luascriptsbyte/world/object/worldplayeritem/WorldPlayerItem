---玩家移动到某个指定点
---@param to UnityEngine.Vector3 对应坐标点
---@param gotoEnd function 到达对应坐标点后的回调
---@param speed number 速度
---@param stopdis number 停止范围(默认1)
---@return boolean|boolean 是否可达
function WorldPlayerItem:GotoPoint(to, gotoEnd, speed, stopdis, isClick)
    if self.lockTransform then
        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(_G.EModuleName.StoryModule, string.format(" 该角色 %s 被锁定 不能移动旋转!", self.Uid))
        end
        return
    end
    local isArrival, isTooClose = base.GotoPoint(self, to, gotoEnd, speed, stopdis, isClick)
    if isArrival and not isTooClose then --目标点可达并且不近
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerMoveStart, self.Uid)
        self.isGoToPoint = true
        if self.curTargetPos == nil then
            self.curTargetPos = _G.Vector3.unity_vector3.zero
        end
        self.curTargetPos.x = to.x
        self.curTargetPos.y = to.y
        self.curTargetPos.z = to.z
    end
    return isArrival, isTooClose
end

