    base.InitObjectModel(self, model)
    self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    self.IsSendMsg = self.World.Cfg.IsSendMsg
    if self.IsSendMsg then
        ---启动计时器
        self:SetTimerState(true)
    end
    ---添加Update
    self:StartUpdateMove()
    local x, y, z = self.Transform:GetLocalPosition()
    self:SavePassedPoint(x, y, z)
    if _G.WorldManager:GetInstance():GetCurWorld().Cfg.Scene_Type == _G.SceneType.Section then
        local data = require "CardCommentManager":GetInstance():CardData(self.Sid, false)
        local size = data.GlobalScale / 10000
        self:SetInitScale(size)
    elseif _G.WorldManager:GetInstance():GetCurWorld().Cfg.Scene_Type == _G.SceneType.MainWorld then
        self:SetInitScale(0.8)
    else
        self:SetInitScale(1)
    end
end

