---移动
---@param moveStep number 移动状态
---@param speed number 移动速度
function WorldPlayerItem:Move(moveStep, speed)
    if self.lockTransform then
        self.MoveStep = moveStep
        return
    end
    if moveStep == 0 then
        self.PlayAnimByName(self, _G.WorldManager.AnimNames.IDLE)
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerMoveEnd, self.Uid)
    else
        ---这里可能需要打断一下上次的动作(主要是非遥感寻路)
        self:StopGoto()
        if not speed then
            self:SetSpeed(5)
            --self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
            if self.World.Cfg.Scene_Type == _G.SceneType.MainWorld then
                local param = _G.ConfigManager.discrete_cfg[100003][1]
                if table.indexof(param, self.Sid) == false then
                    self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
                else
                    self.PlayAnimByName(self, _G.WorldManager.AnimNames.WALK)
                end
            elseif self.World.Cfg.Scene_Type == _G.SceneType.Section then
                self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
            elseif self.World.Cfg.Scene_Type == _G.SceneType.Sociaty then
                -- self:SetSpeed(3)
                -- self.PlayAnimByName(self, _G.WorldManager.AnimNames.WALK)
                self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
            else
                self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
            end
        else
            local aniName = self:GetAnimNameBySpeed(speed)
            self.PlayAnimByName(self, aniName)
            self:SetSpeed(speed)
        end
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerMoveStart, self.Uid)
    end
    self.MoveStep = moveStep
end

function WorldPlayerItem:ShowOrHide(show, force)
    base.ShowOrHide(self, show, force)
    if show and self.isChangeModel and not _G.IsNil(self.ObjectMod) and self.ObjectMod:GetctiveInHierarchy() == 1 then
        self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
        self.setTitlePosTimer = _G.TimerManager:GetInstance():GetTimer(2, self.SetTitlePos, self, true)
        self.setTitlePosTimer:Start()
        self.isChangeModel = false
    end
    if not show and self.MoveStep > 0 then
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerMoveEnd, self.Uid)
    end
end

---玩家移动
function WorldPlayerItem:UpdateMove()
    if self.lockTransform then
        return
    end
    if self.MoveStep ~= 0 then
        self.Transform:SetForwardPosition(self.MoveSpeed, 1, 1)
        _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerMoveing, self.Uid)
    end
end

---设置当前方向
---@param value number
function WorldPlayerItem:SetDirection(value)
    if self.lockTransform then
        self.curMoveDir = value
        return
    end
    _G.CS.UnityObjectExtends.SetRot(self.Transform, nil, value, nil, false)
end

---强制打断玩家所有移动操作,并停止计时器
function WorldPlayerItem:ForceMoveInterrupt()
    if self.WalkTimer then
        self.WalkTimer:Stop()
        self.WalkTimer = nil
    end
    _G.UpdateManager:GetInstance():RemoveUpdate(self.UpdateMoveFunction, self)
    _G.UpdateManager:GetInstance():RemoveUpdate(self.NavUpdateMove, self)
    self:Move(0)
end

---打断非遥感移动
---@param HideFlag boolean 强制隐藏寻路标记
function WorldPlayerItem:NavInterruptMove(HideFlag)
    if not _G.AppSetting.IsloadScence then
        return
    end
    ---打断目标点寻路，需要发送消息给服务器
    if self.curTargetPos and self.curTargetPos.x > -1000 and self.IsSendMsg then
        self.curTargetPos.x, self.curTargetPos.y, self.curTargetPos.z = self.Transform:GetLocalPosition()
        self:OnTimerOver(true)
        self.curTargetPos.x = -1000
        self.lastTargetPos = nil
    end

    self:Move(0)
    self.isGoToPoint = false
    _G.UpdateManager:GetInstance():RemoveUpdate(self.NavUpdateMove, self)
    if HideFlag then
        _G.Events:GetInstance():Broadcast(_G.eNav.HideFlag, self.Uid)
    else
        local navItem = _G.NavManager:GetInstance():GetNavItemByUid(self.Uid)
        if not navItem then
            _G.Events:GetInstance():Broadcast(_G.eNav.HideFlag, self.Uid)
        end
    end
    base.NavInterruptMove(self)
end

---寻路到点结束停止
function WorldPlayerItem:NavStepMoveOver()
    if self.curTargetPos then
        self.curTargetPos.x = -1000
    end
    self.lastTargetPos = nil
    base.NavStepMoveOver(self)
end

