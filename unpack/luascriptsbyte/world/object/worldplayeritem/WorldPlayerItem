function WorldPlayerItem:StartStandActionTimer()
    if self.StandActionCount <= 0 then
        return
    end
    if self.StandActionTimer then
        self:StopStandActionTimer()
    end
    self.StandActionTimer =
        _G.TimerManager:GetInstance():GetTimer(self.StandActionTime, self.PlayeIdleAnim, self, true, false, true)
    self.StandActionTimer:Start()
end

