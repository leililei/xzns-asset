--region 通信周期验证

---设置定时器状态
---@param isOn boolean
function WorldPlayerItem:SetTimerState(isOn)
    if isOn and not self.WalkTimer then
        self.WalkTimer =
            _G.TimerManager:GetInstance():GetTimer(
            self.MoveSendDuration,
            self.OnTimerOver,
            self,
            false,
            false,
            false,
            false
        )
        self.walkVector3LastPos = {x = 0, y = 0, z = 0}
        self.walkVector3CurPos = {x = 0, y = 0, z = 0}
    end

    if self.WalkTimer then
        if isOn ~= self.WalkTimer.started then
            if isOn == true then
                if not self.WalkTimer.started then
                    self.WalkTimer:Resume()
                else
                    self.WalkTimer:Start()
                end
            elseif isOn == false then
                self.WalkTimer:Pause()
                ---停止时，计时器剩余时间清零
                self.WalkTimer.left = self.MoveSendDuration
            end
        end
    end
end

local moveX, moveY, moveZ, start_point, end_point
---到达定时周期，清理点数据，和服务器通信
---@param compel boolean 强制发送
function WorldPlayerItem:OnTimerOver(compel)
    if self.sendMoveMsg then
        return
    end
    -- local pos1, pos2
    --判定遥感移动和目标点移动
    moveX, moveY, moveZ = self.Transform:GetLocalPosition()

    if self.curTargetPos and self.curTargetPos.x > -1000 then
        if self.lastTargetPos == self.curTargetPos then
            return
        end
        self.walkVector3LastPos.x = moveX
        self.walkVector3LastPos.y = moveY
        self.walkVector3LastPos.z = moveZ

        self.walkVector3CurPos.x = self.curTargetPos.x
        self.walkVector3CurPos.y = self.curTargetPos.y
        self.walkVector3CurPos.z = self.curTargetPos.z
        self.lastTargetPos = self.curTargetPos
    else
        self.walkVector3LastPos.x = self.lastPos.x
        self.walkVector3LastPos.y = self.lastPos.y
        self.walkVector3LastPos.z = self.lastPos.z

        self.walkVector3CurPos.x = moveX
        self.walkVector3CurPos.y = moveY
        self.walkVector3CurPos.z = moveZ
    end

    --计算移动是否需要通信
    start_point, end_point = CaculatePosDistance(self.walkVector3LastPos, self.walkVector3CurPos)
    if not compel and start_point < sendPosMinValue and end_point < sendPosMinValue then
        return
    end
    self.lastPos.x = moveX
    self.lastPos.y = moveY
    self.lastPos.z = moveZ
    end_point = _G.WorldUtils.PosToPoint(self.walkVector3CurPos)
    if end_point < 0 then
        return
    end
    start_point = _G.WorldUtils.PosToPoint(self.walkVector3LastPos)
    self.FixPoint = start_point
    self.sendMoveMsg = true
    --self.CurMove = true
    _G.WorldNet:GetInstance():SendMovePointsData(start_point, end_point, _G.handler(self, self.OnMoveSendEndCall))
end

---和服务器通信回调
---@param data public.ReplyOk 中文描述
function WorldPlayerItem:OnMoveSendEndCall(data)
    self.sendMoveMsg = false
    if data.ack ~= 1 then
        if not IsNil(self.Transform) then
            local pos = _G.WorldUtils.PointToPos(self.FixPoint, true)
            self.Transform:SetLocalPosition(pos.x, pos.y, pos.z)
        end
    end
end

---保存玩家走过的点
---@param x number 走过的点坐标X
---@param y number 走过的点坐标Y
---@param z number 走过的点坐标Z
function WorldPlayerItem:SavePassedPoint(x, y, z)
    if self.lastPos == nil then
        self.lastPos = {x = 0, y = 0, z = 0}
    end
    self.lastPos.x = x
    self.lastPos.y = y
    self.lastPos.z = z
end

