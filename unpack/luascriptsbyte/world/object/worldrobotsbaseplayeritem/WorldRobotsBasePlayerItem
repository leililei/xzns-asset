---机器人播放休闲动作的时间间隔 离散配置ID
local ROBOTPLAYIDLEDISCRETEID = 103202
---机器人统一缩放值
local ROBOTSCALEDISCRETEID = 103513
local ROBOTPLAYIDLETIMERANGE
local base = require "WorldBasePlayer"
---@class WorldRobotsBasePlayerItem	:WorldBasePlayer
local WorldRobotsBasePlayerItem = _G.BaseClass("WorldRobotsBasePlayerItem", base)
---机器人状态
local ROBOTSTATE = {
    none = 0,
    idle = 1,
    move = 2
}

---机器人播放休闲动作名称
local ROBOTIDLEANIMATOINNAME = "special_1"
local ROBOTSCALE
local moveX, moveY, moveZ
---求两点之间的距离平方
local distance = function(a, b)
    return (a[1] - b[1]) * (a[1] - b[1]) + (a[2] - b[2]) * (a[2] - b[2])
end

---类的构造函数
function WorldRobotsBasePlayerItem:__init(info, data, world)
    self.DataType = _G.WorldItemDataType.Player
    self.Uid = info.id
    self.Manager = data.manager
    if not ROBOTPLAYIDLETIMERANGE then
        ROBOTPLAYIDLETIMERANGE = _G.ConfigManager.discrete_cfg[ROBOTPLAYIDLEDISCRETEID][1]
        ROBOTSCALE = _G.ConfigManager.discrete_cfg[ROBOTSCALEDISCRETEID][1][1]
    end
    self.CurState = ROBOTSTATE.none
    self.IdleTime = 0
    self.PlayIdleAnimationTime = 0
    self.PathCfg = _G.ConfigManager.city_display_cfg[info.path]
    self.isRobot = true
end

---类的析构函数
function WorldRobotsBasePlayerItem:Dispose()
    self.Manager = nil
    self.CurState = nil
    self.IdleTime = nil
    self.PathCfg = nil
end

---加载资源完成
function WorldRobotsBasePlayerItem:OnLoadResObjComplete()
    local name = "<color=#ffffff>" .. self.Cfg.name .. "</color>"
    self.ItemData.role_name = name
    base.InitTitle(self, name, nil, _G.handler(self, self.InitDesignation))
    ---添加Update
    base.OnLoadResObjComplete(self)
end

function WorldRobotsBasePlayerItem:OnEnterWorld()
    self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    _G.UpdateManager:GetInstance():AddFixedUpdate(self.UpdateMove, self)
    base.OnEnterWorld(self)
    self:IdleState()
end

function WorldRobotsBasePlayerItem:OnExitWorld()
    if self.RobotTimer then
        self.RobotTimer:Stop()
        self.RobotTimer = nil
    end
    _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.UpdateMove, self)
    base.OnExitWorld(self)
end

function WorldRobotsBasePlayerItem:OnClick()
    ---点击其他玩家进行寻路 然后出现头像
    local isExit, target = _G.UIManager:GetInstance():IsLoadedWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    if isExit and player then
        player:GotoPoint(_G.Vector3.New(self.Transform:GetPosition()), _G.handler(self, self.GotoPointSuc))
    end
end

function WorldRobotsBasePlayerItem:GotoPointSuc()
    self.Manager:ShowRobotShowData(self)
end
---初始化位置
function WorldRobotsBasePlayerItem:InitPosition()
    local birthpos = self.PathCfg.birthplace
    local pos = birthpos[_G.Mathf.Random(1, #birthpos)]
    --TODO:根据距离计算当前出生点所在的路径位置
    self.CurTargetMoveIndex = 1
    local dis = distance(self.PathCfg.key_points[1], pos)
    local dis2
    for i = 2, #self.PathCfg.key_points do
        dis2 = distance(self.PathCfg.key_points[i], pos)
        if dis2 <= dis then
            self.CurTargetMoveIndex = i
            dis = dis2
        end
    end
    self.Transform:SetLocalPosition(pos[1], self.World.WorldSetting:GetY(pos[1], pos[2]), pos[2])
end
---创建模型
function WorldRobotsBasePlayerItem:CreateObjectModel()
    if self.loadModelObj or not _G.IsNil(self.ObjectMod) then
        return
    end
    if not _G.string.IsNullOrEmpty(self.Cfg.Res) then
        self.loadModelObj = true
        local loadfunc = function(tran)
            self.loadModelObj = nil
            if _G.IsNil(self.Transform) then
                tran:DestroyObject()
                return
            end
            self:InitObjectModel(tran)
            self.ObjectMod:SetLocalScaleXYZ(ROBOTSCALE)
            self.ObjectMod:SetActiveE(0)
        end
        local model_Path = self.Cfg.Res
        -- if _G.DownloadPlayManager:GetInstance():IsInRemotePackage(model_Path) then
        --     if not _G.DownloadPlayManager:GetInstance():IsABDownloaed(model_Path) then
        --         --策划给的id,默认模型显示
        --         model_Path = _G.ConfigManager.object_world_cfg[707010168].Res
        --     end
        -- end
        model_Path = _G.ConfigManager.object_world_cfg[707010168].Res
        require("CardInfoManager").GetRole(
            model_Path,
            _G.ePoolType.World,
            self.Transform,
            _G.RoleEffTypeEnum.Main,
            loadfunc
        )
    end
end
function WorldRobotsBasePlayerItem:SetEnable()
    self.Enable = self.ObjectModActive
    --self.curSetEnable
    if self.Enable then
        if self.CurState == ROBOTSTATE.move then
            self:PlayAnimByName(_G.WorldManager.AnimNames.MOVE)
        end
    end
end
function WorldRobotsBasePlayerItem:OnGameObjShow()
    if self.CurState == ROBOTSTATE.idle then
        self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    end
end
---添加效果
function WorldRobotsBasePlayerItem:AddCommonEffect()
    self:InitHalo()
end
---初始化称号
function WorldRobotsBasePlayerItem:InitDesignation()
    if self.Designation then
        self.Designation.obj.obj_effect:RemoveAllChildren()
    end
    local id = self.Cfg.title_effect
    if id == 0 then
        return
    end
    local cfg = _G.ConfigManager.player_title_effect_cfg[id]
    if cfg then
        local go_table = _G.GetAutoGoTable(self.TitleTransform)
        self.Designation = {obj = go_table, title = go_table.aorrawimage_Title, type = cfg.type_title}
        if cfg.type_title == 1 then
            go_table.aorrawimage_Title:SetActiveE(1)
            go_table.aorrawimage_Title:LoadImage(
                cfg.title,
                function(rawimage)
                    rawimage:SetNativeSize()
                end
            )
            go_table.aorrawimage_Title:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035)
        else
            self.Designation.title:SetActiveE(0)
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.Designation.obj.obj_effect,
                function(trans)
                    if _G.IsNil(self.TitleTransform) then
                        _G.DestroyObject(trans)
                        return
                    end
                    local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                    if not _G.IsNil(effScript) then
                        effScript:SetIsShow(true)
                    end
                    trans:SetLayerAndChild(30)
                    -- local x, y, z = self.Designation.title:GetPosition()
                    -- trans:SetPosition(x, y + 0.2, z)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035)
                end
            )
        end
    end
end
---初始化光圈
function WorldRobotsBasePlayerItem:InitHalo()
    local id = self.Cfg.halo_effect
    if id == 0 then
        return
    end
    local cfg = _G.ConfigManager.player_halo_effect_cfg[id]
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.halo,
            _G.ePoolType.World,
            self.Transform,
            function(trans)
                if _G.IsNil(self.Transform) or _G.IsNil(self.ObjectMod) then
                    _G.DestroyObject(trans)
                    return
                end
                if cfg.type_halo == 2 then
                    trans:SetParentE(self.RolePoint.Point_Chest)
                else
                    if not _G.IsNil(self.RolePoint) and not _G.IsNil(self.RolePoint.Point_Shadow) then
                        trans:SetParentE(self.RolePoint.Point_Shadow)
                    else
                        trans:SetParentE(self.Transform)
                    end
                    trans:SetLocalPosition(0, 0.01, 0)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103901][1][1])
                end
                trans:SetEulerAngles(0, 0, 0)
                trans:AddComponentE(_G.typeof(_G.CS.KeepRotate))
                local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                if not _G.IsNil(effScript) then
                    effScript:SetIsShow(true)
                end
            end
        )
    end
end
---玩家移动更新
function WorldRobotsBasePlayerItem:UpdateMove()
    if self.CurState ~= ROBOTSTATE.move then
        return
    end
    self.Transform:SetForwardPosition(self.MoveSpeed, 0, 1)
    moveX, moveY, moveZ = self.Transform:GetPosition()
    moveX = moveX - self.MoveTargetPosX
    moveZ = moveZ - self.MoveTargetPosZ
    if moveX * moveX + moveZ * moveZ < 0.25 then --0.25判定两点距离的平方值来判定是否到达目标点
        self.Transform:SetPosition(self.MoveTargetPosX, self.MoveTargetPosY, self.MoveTargetPosZ)
        self:IdleState()
    end
end

--region机器人行为控制
function WorldRobotsBasePlayerItem:IdleState()
    if self.CurState == ROBOTSTATE.idle then
        return
    end
    self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    self.CurState = ROBOTSTATE.idle
    local random = _G.Mathf.Random
    self.IdleTime = random(self.PathCfg.pause_time[1][1], self.PathCfg.pause_time[1][2])
    self.PlayIdleAnimationTime = random(ROBOTPLAYIDLETIMERANGE[1], ROBOTPLAYIDLETIMERANGE[2])
    if self.PlayIdleAnimationTime < self.IdleTime then --待机时长大于播放动作的时长，则需要播放待机动画
        self.RobotTimer =
            _G.TimerManager:GetInstance():GetTimer(self.PlayIdleAnimationTime, self.OnPlayAnimationCall, self, true)
    else
        self.RobotTimer = _G.TimerManager:GetInstance():GetTimer(self.IdleTime, self.MoveState, self, true)
    end
    self.RobotTimer:Start()
end
---播放动作计时回调
function WorldRobotsBasePlayerItem:OnPlayAnimationCall()
    _G.AnimatorPlayEndCallback.AddCallback(
        self.Transform:GetInstanceIDE(),
        _G.handler(self, self.OnPlayAnimationDoneCall)
    )
    self:PlayAnimByName(ROBOTIDLEANIMATOINNAME, true)
    self.RobotTimer =
        _G.TimerManager:GetInstance():GetTimer(self.IdleTime - self.PlayIdleAnimationTime, self.MoveState, self, true)
    self.RobotTimer:Start()
end
---动作播放完成回调
function WorldRobotsBasePlayerItem:OnPlayAnimationDoneCall()
    _G.AnimatorPlayEndCallback.RemoveCallback(self.Transform:GetInstanceIDE())
    if self.CurState == ROBOTSTATE.idle then
        self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    end
end
---移动状态
function WorldRobotsBasePlayerItem:MoveState()
    self.CurTargetMoveIndex = self.CurTargetMoveIndex + 1
    if self.CurTargetMoveIndex > #self.PathCfg.key_points then
        self.CurTargetMoveIndex = 1
    end
    self.MoveTargetPosX, self.MoveTargetPosY, self.MoveTargetPosZ = self.Transform:GetPosition()
    self.MoveTargetPosX = self.PathCfg.key_points[self.CurTargetMoveIndex][1]
    self.MoveTargetPosZ = self.PathCfg.key_points[self.CurTargetMoveIndex][2]
    self.Transform:SetDirection(self.MoveTargetPosX, self.MoveTargetPosY, self.MoveTargetPosZ, self.MoveSpeed)
    self.CurState = ROBOTSTATE.move
    self:PlayAnimByName(_G.WorldManager.AnimNames.MOVE)
end

function WorldRobotsBasePlayerItem:TriggerEvent(isEnter, tarInstId, tarObj)
    local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld():GetCanmeraPosBox()
    if sceneCamera then
        if tarInstId == sceneCamera:GetInstanceIDE() then
            self:ShowOrHideChild(isEnter)
            if isEnter then
                _G.WorldManager:GetInstance():GetCurWorld():AddCameraPosBoxItem(self)
            else
                _G.WorldManager:GetInstance():GetCurWorld():RemoveCameraPosBoxItem(self)
            end
        end
    end
end

function WorldRobotsBasePlayerItem:ShowOrHideChild(show)
    --self.curSetEnable = show

    if show then
        if not self.FootEffectActive and self.footEffect then
            self.footEffect:SetActiveE(1)
            self.FootEffectActive = true
        end
        if not self.TitleTransformActive and self.TitleTransform then
            self.TitleTransform:SetActiveE(1)
            self.TitleTransformActive = true
        end
        if not self.ObjectModActive and self.ObjectMod then
            self.ObjectMod:SetActiveE(1)
            self.ObjectModActive = true
            self:CheckMoveing()
        end
    else
        if self.FootEffectActive and self.footEffect then
            self.footEffect:SetActiveE(0)
            self.FootEffectActive = false
        end
        if self.TitleTransformActive and self.TitleTransform then
            self.TitleTransform:SetActiveE(0)
            self.TitleTransformActive = false
        end
        if self.ObjectModActive and self.ObjectMod then
            self.ObjectMod:SetActiveE(0)
            self.ObjectModActive = false
        end
    end
end

function WorldRobotsBasePlayerItem:CheckMoveing()
    self.AnimName = nil
    self:SetEnable()
end

--endregion
return WorldRobotsBasePlayerItem
