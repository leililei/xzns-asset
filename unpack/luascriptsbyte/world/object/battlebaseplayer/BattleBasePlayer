--region 动画
---播放指定名称的动画
---@param name string 动画name
---@param isEndCall boolean 结束是否回调
function BattleBasePlayer:PlayAnimByName(name, isEndCall)
    if self.AnimName then
        if self.AnimName == name then
            return
        end
    end
    if not name or name == "" then
        return
    end
    if _G.IsNil(self.AnimComponent) then
        return
    end
    if not self.Transform then
        return
    end
    if 0 == self.Transform:GetctiveInHierarchy() then
        return
    end
    self.AnimName = name
    self.AnimComponent:PlayForce(name, isEndCall or false)
end
--endregion

--region 子类重写
---添加效果
function BattleBasePlayer:AddCommonEffect()
    self:InitHalo()
end
---移除效果
function BattleBasePlayer:RemoveCommonEffect()
    if not _G.IsNil(self.ObjectMod) then
        self.World.CommonEff:SetSelectState(self.ObjectMod, false)
        --还原渲染状态
        local renders = self.ObjectMod:GetComponentsInChildren(_G.typeof(_G.Renderer))
        if not _G.IsNil(renders) then
            local len = renders.Length - 1
            for i = 0, len do
                local render = renders[i]
                if not _G.IsNil(render) and not _G.IsNil(render.sharedMaterial) then
                    render.sharedMaterial:SetFloat("_ShadowArea", 0)
                    render.shadowCastingMode = _G.CS.UnityEngine.Rendering.ShadowCastingMode.On
                end
            end
        end
    end
end
function BattleBasePlayer:ShowOrHide(show, force)
    if force then
        self.OriginalShowState = show
    end
    -- if show == self.curSetEnable then
    --     return
    -- end
    base.ShowOrHide(self, show and self.OriginalShowState)
    if not _G.IsNil(self.TitleTransform) then
        _G.GameUtil.SetActiveByCondition(self.TitleTransform, show and self.OriginalShowState)
    --self.curSetEnable)
    end
    if show and self.OriginalShowState then --self.curSetEnable then
        if self.ObjShowTimer then
            self.ObjShowTimer:Stop()
            self.ObjShowTimer = nil
        end
        self.ObjShowTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnGameObjShow, self, true, true):Start()
    else
        if self.ObjShowTimer then
            self.ObjShowTimer:Stop()
            self.ObjShowTimer = nil
        end
        self:OnGameObjHide()
    end
end
function BattleBasePlayer:OnGameObjShow()
end
function BattleBasePlayer:OnGameObjHide()
end
function BattleBasePlayer:Reset()
    if _G.IsNil(self.ObjectMod) then
        if not self.ItemData.IsHidden then
            self:OnEnterWorld()
        else
            self:OnExitWorld()
        end
    else
        self:ShowOrHide(not self.ItemData.IsHidden)
    end
end
function BattleBasePlayer:OnEnterWorld()
    self:InitPosition()
    self:CreateObjectModel()
end
-----退出世界时调用，由子类重写
function BattleBasePlayer:OnExitWorld()
    self:ClearObjectModel()
    base.OnExitWorld(self)
end
---清理item节点下的对象
function BattleBasePlayer:DisWorldItem()
    _G.NavManager:GetInstance():DeleteNavItemByUid(self.Uid, true)
    self:RemoveNavUpdateMove()
    self:RemoveUpdateMoveFunction()
    if self.Transform then
        _G.DestroyObject(self.Transform)
    end
    self:Dispose()
end

--endregion

--region获取节点和坐标
---获取子节点,以物体根节点为父级往下找，找不到就返回根节点
---@param path string 路径
function BattleBasePlayer:GetChildNode(path)
    if _G.IsNil(self.ObjectMod) then
        return self.Transform
    end
    if _G.string.IsNullOrEmpty(path) then
        return self.ObjectMod
    end
    local node = self.ObjectMod:FindE(path)
    if _G.IsNil(node) then
        node = self.ObjectMod
    end
    return node
end

---获取头顶点坐标
---@return number|number|number x,y,z
function BattleBasePlayer:GetHeadPoint()
    if _G.IsNil(self.RolePoint) then
        return nil
    end
    if _G.IsNil(self.RolePoint.Point_Hp) then
        if _G.IsNil(self.RolePoint.Point_Head) then
            return nil
        else
            return self.RolePoint.Point_Head:GetPosition()
        end
    end
    return self.RolePoint.Point_Hp:GetPosition()
end
--endregion

---更新地狱道头衔
function BattleBasePlayer:UpdateHell(id)
    local path = require "HellRoadManager":GetInstance():GetHellImage(id)
    local go_table = _G.GetAutoGoTable(self.TitleTransform)
    if _G.string.IsNullOrEmpty(path) then
        _G.GameUtil.SetActiveByCondition(go_table.aorrawimage_hell, false)
    else
        go_table.aorrawimage_hell:LoadImage(
            path,
            function(obj)
                obj:SetNativeSize()
                local x, y = obj:GetRectTransformSizeDelta()
                obj:SetRectTransformSize(x * 1.5, y * 1.5)
            end
        )
        _G.GameUtil.SetActiveByCondition(go_table.aorrawimage_hell, true)
    end
end

return BattleBasePlayer
