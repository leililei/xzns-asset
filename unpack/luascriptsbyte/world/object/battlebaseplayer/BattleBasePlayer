local BattleAudienceManager
local base = require "WorldBasePlayer"

---@class BattleBasePlayer	中文描述
---@field TitleTextName AorText
local BattleBasePlayer = _G.BaseClass("BattleBasePlayer", base)

---播放休闲动作名称
local ROBOTIDLEANIMATOINNAME = "victory_1"

---@param info BaseItemParam 类型
---@param data WorldItemData 数据
---@param world BaseWorld 所属世界
function BattleBasePlayer:__init(info, data, world)
    BattleAudienceManager = require "BattleAudienceManager"
    self.Cfg = {
        Res = info.modelPath,
        name = info.name,
        haloEffect = info.haloEffect,
        titleEffect = info.titleEffect,
        x = info.x,
        y = info.y,
        z = info.z
    }
    self.ItemData = {}
end

function BattleBasePlayer:Dispose()
    self.TitleTransform = nil
    self.ItemData = nil
    self.TitleTextName = nil
    self.RolePoint = nil
    if self.playAniTimer then
        self.playAniTimer:Stop()
    end
    self.playAniTimer = nil
    if self.playStandTimer then
        self.playStandTimer:Stop()
    end
    self.playStandTimer = nil
    self.TitleScaleRoot = nil
end

--region 加载和清理
function BattleBasePlayer:Init()
    self:LoadObject()
end
---初始化和加载根节点
---@param res_path string 根节点资源路径
function BattleBasePlayer:LoadObject()
    self.Transform = _G.GameObject("roleParent")
    self.Transform:SetName(self.Cfg.name)
    self.Transform:SetLocalPosition(self.Cfg.x, self.Cfg.y, self.Cfg.z)
    self.Transform:SetLocalScaleXYZ(0.8)
    self.Transform:SetParentE(BattleAudienceManager:GetInstance():GetModelRoot())
    self.Transform:LookAtE(0, 0, 0)
    --self:LoadResObj()
    self:CreateObjectModel()
end
-----加载配置资源节点
function BattleBasePlayer:LoadResObj()
    if self.Cfg and self.Cfg.Res and not _G.string.IsNullOrEmpty(self.Cfg.Res) then
        _G.PoolsManager:GetInstance():Spawn(
            self.Cfg.Res,
            _G.ePoolType.Audience,
            self.Transform,
            function(tran)
                self.ObjectMod = tran
                self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(self.Transform)
                self.AnimComponent:HandInit()
                self:OnLoadResObjComplete()
            end
        )
    else
        self:OnLoadResObjComplete()
    end
end

--region 创建
---加载资源完成
function BattleBasePlayer:OnLoadResObjComplete()
    local name = "<color=#ffffff>" .. self.Cfg.name .. "</color>"
    self.ItemData.role_name = name
    self:InitTitle(name, nil, nil)
end
---初始化头顶标题
---@param nameStr string 名字
function BattleBasePlayer:InitTitle(nameStr, resPath, callback)
    if true then
        if callback then
            callback()
        end
        return
    end
    local path = "CommonPrefab/World/Common_TitleWithDesignation"
    if resPath then
        path = resPath
    end
    self.TitleLoading = true
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Audience,
        BattleAudienceManager:GetInstance():GetHaloRoot(),
        function(title)
            local go_table = _G.GetAutoGoTable(title)
            self.TitleTransform = title
            self.TitleTransform:SetName(self.Uid)
            self.TitleTextName = go_table.aortext_TextName
            self.TitleScaleRoot = go_table.trans_root
            self.TitleTextName.text = nameStr
            self.TitleTextName.fontSize = 70
            self:SetTitlePos()
            self:UpdateTitlePos()
            if self.ItemData and self.ItemData.hell_id then
                self:UpdateHell(self.ItemData.hell_id)
            end
            self.TitleLoading = false
            if callback then
                callback()
            end
        end
    )
end

function BattleBasePlayer:UpdateTitlePos()
    if not self.titleDeltaY then
        return
    end
    self.titlePosX, self.titlePosY, self.titlePosZ = self.Transform:GetPosition()
    self.titlePosY = self.titlePosY + self.titleDeltaY
    self.TitleTransform:SetPosition(self.titlePosX, self.titlePosY, self.titlePosZ)
end

---获取头顶点坐标
---@return number|number|number x,y,z
function BattleBasePlayer:GetHeadPoint()
    if _G.IsNil(self.RolePoint) then
        return nil
    end
    if _G.IsNil(self.RolePoint.Point_Hp) then
        if _G.IsNil(self.RolePoint.Point_Head) then
            return nil
        else
            return self.RolePoint.Point_Head:GetPosition()
        end
    end
    return self.RolePoint.Point_Hp:GetPosition()
end
---获取名称Y轴偏移值
---@return number Y轴偏移值
function BattleBasePlayer:GetTitleDeltaY()
    return _G.ConfigManager.discrete_cfg[103503][1][1]
end
---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function BattleBasePlayer:SetTitlePos()
    if not _G.IsNil(self.TitleTransform) then
        local x, y, z = self:GetHeadPoint()
        if x then
            self.titleDeltaY = self:GetTitleDeltaY()
            -- local deltaY = self:GetTitleDeltaY()
            local x1, y1, z1 = self.Transform:GetPosition()
            local s = self.TitleTransform:GetLocalScale()
            -- local pos = {}
            -- pos.x = 0
            -- pos.z = 0
            self.titleDeltaY = (y - y1 + self.titleDeltaY) * s
            self.titlePosX = 0
            self.titlePosY = 0
            self.titlePosZ = 0
            -- self.TitleTransform:SetLocalPosition(pos.x, pos.y, pos.z)
            _G.BattleManager:GetInstance():LookAtBattleUICamera(self.TitleTransform, self.Transform)
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未找到名字挂载点 Point_Hp.请检测模型 " .. self.Uid)
            end
            self.TitleTransform:SetActiveE(0)
        end
    end
end

function BattleBasePlayer:InitObjectModel(model)
    self.ObjectMod = model
    if self.ItemData and self.ItemData.IsInShadow then
        _G.GraphicsManager.Instance:SetTargetDarken(self.ObjectMod, 1)
    end
    self.IdleEffetTrans = model:FindE("Bone077")
    self.ObjectMod:SetParentE(self.Transform)
    self.ObjectMod:SetLocalPosition(0, 0, 0)
    self.ObjectMod:SetLocalEulerAngles(0, 0, 0)
    self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(self.Transform, true)
    self.AnimComponent:HandInit()
    self.RolePoint = self.ObjectMod:GetComponentE(_G.typeof(_G.CS.RolePoint))
    self:ShowOrHide(not (self.ItemData and self.ItemData.IsHidden) or self.OriginalShowState)
    local random = _G.Mathf.Random(10, 20)
    self.playAniTimer = _G.TimerManager:GetInstance():GetTimer(random, self.PlayAni, self, true)
    self.playAniTimer:Start()

    if not self.TitleLoading then
        if _G.IsNil(self.TitleTransform) then
            self:CreateCurPlayerTitle()
        else
            self:AddCommonEffect()
        end
    end
end

function BattleBasePlayer:CreateCurPlayerTitle()
    if self.World.Cfg.IsDisplay then
        local name
        if self.ItemData.role_name then
            name = "<color=#ffee9c>" .. self.ItemData.role_name .. "</color>"
            self:InitTitle(
                name,
                nil,
                function()
                    _G.DelayFrameDo(_G.handler(self, self.SetTitlePos))
                    self:AddCommonEffect()
                end
            )
        end
    end
end

---隐藏绑定特效
function BattleBasePlayer:HideEffect(hide)
    if self.IdleEffetTrans then
        _G.GameUtil.SetActiveByCondition(self.IdleEffetTrans, not hide)
    end
end

---清理模型
function BattleBasePlayer:ClearObjectModel()
    if _G.IsNil(self.ObjectMod) then
        return
    end
    if not _G.IsNil(self.TitleTransform) then
        _G.DestroyImmediate(self.TitleTransform)
        self.TitleTransform = nil
    end
    if not _G.IsNil(self.ObjectMod) then
        _G.DestroyImmediate(self.ObjectMod)
        self.ObjectMod = nil
    end
    self.ObjectModActive = false
    self.TitleTransformActive = false
    self.FootEffectActive = false
end
---创建模型
function BattleBasePlayer:CreateObjectModel()
    if self.loadModelObj or not _G.IsNil(self.ObjectMod) then
        return
    end
    if self.Cfg and not _G.string.IsNullOrEmpty(self.Cfg.Res) then
        self.loadModelObj = true
        local loadfunc = function(tran)
            self.loadModelObj = nil
            if _G.IsNil(self.Transform) then
                tran:DestroyObject()
                return
            end
            self:InitObjectModel(tran)
            self:OnLoadResObjComplete()
        end
        if _G.string.contains(self.Cfg.Res, "/") then
            require("CardInfoManager").GetRole(
                self.Cfg.Res,
                _G.ePoolType.Audience,
                self.Transform,
                _G.RoleEffTypeEnum.Main,
                loadfunc
            )
        else
            local trans = _G.WorldManager:GetInstance():GetItemGameObj(self.Cfg.Res)
            loadfunc(trans)
        end
    end
end
--endregion

---播放动作
function BattleBasePlayer:PlayAni()
    if self.playAniTimer then
        self.playAniTimer:Stop()
    end
    if self.playStandTimer then
        self.playStandTimer:Stop()
    end
    self:PlayAnimByName(ROBOTIDLEANIMATOINNAME)
    local aniTime = self.AnimComponent:GetAniTime(ROBOTIDLEANIMATOINNAME)
    self.playStandTimer = _G.TimerManager:GetInstance():GetTimer(aniTime, self.PlayStand, self, true)
    self.playStandTimer:Start()
    local random = _G.Mathf.Random(10, 20)
    self.playAniTimer = _G.TimerManager:GetInstance():GetTimer(random, self.PlayAni, self, true)
    self.playAniTimer:Start()
end
function BattleBasePlayer:PlayStand()
    self:PlayAnimByName("stand_1")
end
---初始化称号
function BattleBasePlayer:InitDesignation()
    local id = self.Cfg.titleEffect
    if id == 0 then
        return
    end
    local cfg = _G.ConfigManager.player_title_effect_cfg[id]
    if cfg then
        local go_table = _G.GetAutoGoTable(self.TitleTransform)
        self.Designation = {obj = go_table, title = go_table.aorrawimage_Title, type = cfg.type_title}
        if cfg.type_title == 1 then
            go_table.aorrawimage_Title:SetActiveE(1)
            go_table.aorrawimage_Title:LoadImage(
                cfg.title,
                function(rawimage)
                    rawimage:SetNativeSize()
                end
            )
            go_table.aorrawimage_Title:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035)
        else
            go_table.aorrawimage_Title:SetActiveE(0)
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg[cfg.title],
                self.TitleTransform,
                function(trans)
                    if _G.IsNil(self.Transform) or _G.IsNil(self.ObjectMod) then
                        _G.UIUtils.RemoveEffect(trans)
                        return
                    end
                    local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                    if not _G.IsNil(effScript) then
                        effScript:SetIsShow(true)
                    end
                end
            )
        end
    end
end
---初始化光圈
function BattleBasePlayer:InitHalo()
    local id = self.Cfg.haloEffect
    if id == 0 then
        return
    end
    local cfg = _G.ConfigManager.player_halo_effect_cfg[id]
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.halo,
            _G.ePoolType.Audience,
            self.Transform,
            function(trans)
                if _G.IsNil(self.Transform) or _G.IsNil(self.ObjectMod) then
                    _G.DestroyObject(trans)
                    return
                end
                if cfg.type_halo == 2 then
                    trans:SetParentE(self.RolePoint.Point_Chest)
                else
                    if not _G.IsNil(self.RolePoint) and not _G.IsNil(self.RolePoint.Point_Shadow) then
                        trans:SetParentE(self.RolePoint.Point_Shadow)
                    else
                        trans:SetParentE(self.Transform)
                    end
                    trans:SetLocalPosition(0, 0.01, 0)
                    trans:SetLocalScaleXYZ(_G.ConfigManager.discrete_cfg[103901][1][1])
                end
                trans:SetEulerAngles(0, 0, 0)
                trans:AddComponentE(_G.typeof(_G.CS.KeepRotate))
                local effScript = trans:GetComponentE(_G.typeof(_G.CS.EffectLevel))
                if not _G.IsNil(effScript) then
                    effScript:SetIsShow(true)
                end
            end
        )
    end
end
