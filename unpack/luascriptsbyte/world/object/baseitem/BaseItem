--region 求交点
--两点连线到以后者点为圆心已知半径的圆的交点
---@param to UnityEngine.Vector3 对应坐标点
---@param radius number 半径
function BaseItem:GetClosestPointByTwoTarget(x, y, z, radius)
    local px, py, pz = _G.CS.UnityObjectExtends.GetClosestPointByTwoTarget(self.Transform, x, y, z, radius)
    return _G.Vector3.New(px, py, pz)
end
local defaultStopDisPow = 0.25
---玩家移动到某个指定点
---@param to UnityEngine.Vector3 对应坐标点
---@param gotoEnd function 到达对应坐标点后的回调
---@param speed number 速度
---@param stopdis number 停止范围(默认1)
---@return boolean|boolean 是否可达
function BaseItem:GotoPoint(to, gotoEnd, speed, stopdis, isClick)
    if nil == isClick then
        isClick = false
    end
    --TODO:这里应该区分是NavItem:DoNavByPosition调用还是GotoPoint直接调用
    self.stopDistance = (stopdis and stopdis >= defaultStopDisPow) and stopdis * stopdis or defaultStopDisPow
    self.curStopDistance = 0
    local isNode, isTooClose = _G.CS.UnityObjectExtends.CalculatePath(self.Transform, to.x, to.y, to.z, self.NavNodes)
    ---坐标差 <1              发现两对象重叠时  isNode返回false  无法进行相关处理
    transPostion.x, transPostion.y, transPostion.z = self.Transform:GetPosition()
    if isNode == false and _G.Vector3.DistancePow2(transPostion, to) < 1 then
        isNode = true
    end
    if isNode then
        if isTooClose == false then
            _G.NavManager:GetInstance():RegisterNavItemByUid(self, to)
            self.GotoEnd = gotoEnd
            self.NavNodeIndex = 1
            self.NavCorners = self.NavNodes.corners
            self.NavNodesLength = self.NavCorners.Length
            self:SetNavMoveState(speed)
            if not self.NavUpdateMove then
                self.NavUpdateMove = _G.handler(self, self.DoNavUpdateMove)
            end
            local updateInstance = _G.UpdateManager:GetInstance()
            if not updateInstance:HasUpdate(self.NavUpdateMove, self) then
                updateInstance:AddUpdate(self.NavUpdateMove, self)
            end
        else
            if gotoEnd then
                gotoEnd()
            end
        end
        return true, isTooClose
    else
        if not isClick then
            if gotoEnd then
                gotoEnd()
            end
        end
        self.NavNodes:ClearCorners()
        return false
    end
end
---设置自动寻路状态
---@param speed number 速度
function BaseItem:SetNavMoveState(speed)
    if not speed then
        speed = MAXMOVESPEED
    end
    --self:PlayAnimByName(_G.WorldManager.AnimNames.MOVE)
    self:SetSpeed(speed)
    self:PlayAnimByName(self:GetMoveAnimationName())

    if self.gotoPointTimer then
        self.gotoPointTimer:Stop()
        self.gotoPointTimer = nil
    end
    -- self.MoveStep = 1
end
---寻路到点结束停止
function BaseItem:NavStepMoveOver()
    self.MoveStep = 0
    self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    self:RemoveNavUpdateMove()
    self.gotoPointTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnNavStepMoveOverCall, self, true, true)
    self.gotoPointTimer:Start()
end
---寻路到点结束停止后判断是否达到可交互范围
function BaseItem:NavStepMoveOverPosCheck(playerPos, pos, call)
    if _G.Vector3.DistancePow2(playerPos, pos) < (self.stopDistance) then
        call()
    end
end
function BaseItem:OnNavStepMoveOverCall()
    if self.GotoEnd then
        self.GotoEnd()
    end
    _G.Events:GetInstance():Broadcast(_G.eNav.NavComplete, self.Uid)
    _G.NavManager:GetInstance():DeleteNavItemByUid(self.Uid, false)
end
---寻路移动Update
function BaseItem:DoNavUpdateMove()
    if self.NavNodeIndex >= self.NavNodesLength then
        self:NavStepMoveOver()
        return
    end
    local to = self.NavCorners[self.NavNodeIndex]
    moveToPostion.x = to.x
    moveToPostion.y = to.y
    moveToPostion.z = to.z
    local x, y, z = self.Transform:GetPosition()
    transPostion.x = x
    transPostion.y = y
    transPostion.z = z
    local dis = _G.Vector3.DistancePow2(transPostion, moveToPostion)
    if self.NavNodeIndex < self.NavNodesLength - 1 then
        self.curStopDistance = defaultStopDisPow
    else
        self.curStopDistance = self.stopDistance
    end
    if dis < self.curStopDistance then
        if self.curStopDistance <= defaultStopDisPow then
            self.Transform:SetPosition(moveToPostion.x, transPostion.y, moveToPostion.z)
        end
        self.NavNodeIndex = self.NavNodeIndex + 1
    else
        self.Transform:SetPosition(
            self.Transform:SetMoveDirect(moveToPostion.x, moveToPostion.y, moveToPostion.z, self.MoveSpeed, 1)
        )
        self.Transform:SetDirectionByDis(moveToPostion.x, moveToPostion.y, moveToPostion.z)
    end
end
---打断非遥感移动
function BaseItem:NavInterruptMove()
    self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    self.GotoEnd = nil
    self:RemoveNavUpdateMove()
end
---打断通过遥感移动
function BaseItem:StopGoto()
    self.GotoEnd = nil
    self:RemoveNavUpdateMove()
end
---获取是否移动
---@return boolean 是否跑动中
function BaseItem:GetMoveState()
    return self.AnimName and
        (self.AnimName == _G.WorldManager.AnimNames.MOVE or self.AnimName == _G.WorldManager.AnimNames.WALK)
end
function BaseItem:GetMoveAnimationName()
    if self.World.Cfg.Scene_Type == _G.SceneType.MainWorld then
        local param = _G.ConfigManager.discrete_cfg[100003][1]
        if table.indexof(param, self.Sid) == false then
            return _G.WorldManager.AnimNames.MOVE
        else
            return _G.WorldManager.AnimNames.WALK
        end
    elseif self.World.Cfg.Scene_Type == _G.SceneType.Section then
        return _G.WorldManager.AnimNames.MOVE
    elseif self.World.Cfg.Scene_Type == _G.SceneType.Sociaty then
        self:SetSpeed(3)
        return _G.WorldManager.AnimNames.WALK
    else
        return _G.WorldManager.AnimNames.MOVE
    end
end
