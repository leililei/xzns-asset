function BaseItem:SetEnable()
    if self.setEnableTimer then
        self.setEnableTimer:Stop()
        self.setEnableTimer = nil
    end
    self.Enable = self.Transform:GetActiveSelf() == 1
    -- self.curSetEnable
    if self.MoveStep == 1 then
        self:PlayAnimByName(self:GetMoveAnimationName())
    end

    self.BubblesIsOn = true
    if nil == self.Cnb then
        self.Cnb = _G.DelayDo(self.intervalsSecondsDefault, _G.handler(self, self.CheckNormalBubbles))
    end
end

function BaseItem:ShowOrHide(show)
    -- if show == self.curSetEnable then
    --     return
    -- end
    if _G.IsNil(self.Transform) then
        return
    end
    self.Transform:SetActiveE(show and 1 or 0)
    --self.curSetEnable = show
    if show then
        --延时一帧开启触发器
        if self.setEnableTimer then
            self.setEnableTimer:Stop()
            self.setEnableTimer = nil
        end
        self.setEnableTimer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEnable, self, true, true)
        self.setEnableTimer:Start()
    else
        self.AnimName = nil
        if self.setEnableTimer then
            self.setEnableTimer:Stop()
            self.setEnableTimer = nil
        end
        self.BubblesIsOn = false
        if self.Cnb then
            _G.coroutine.stopwaiting(self.Cnb)
            self.Cnb = nil
        end
        _G.HUDUtilities.DestroyHUDByUid(self.Uid)
        self:SetEnable()
    end
end

