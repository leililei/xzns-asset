---@field npcType number 默认0NPC 1玩家
---@field intervalArr number[] 间隔数组 [min,max] 方便设置临时气泡间隔(剧情行为)
---@class Params_PlayBubbles

---播放常态气泡
---@param hudid table 气泡组
---@param intervalid number  间隔 离散表id
---@param npc BaseItem obj
---@param Data Params_PlayBubbles
function BaseItem:CheckNormalBubbles(hudid, interval, npc, Data)
    if _G.IsNil(self) then
        return
    end
    if _G.IsNil(self.Cfg) then
        return
    end
    local bubblesArr = self.Cfg.default_bubbles_plot
    if _G.IsNil(bubblesArr) then
        return
    end
    Data = Data or {}
    local npcType = Data.npcType or 0
    local thudid = nil
    local t_interval
    local t_eventInterval
    local _intervalsSeconds
    local len
    if _G.IsNil(hudid) and self.BubblesIsOn then
        len = #bubblesArr
        if len <= 0 then
            return
        end
        if not self.RandomNum then
            self.RandomNum = _G.GetRandomNum(1, len)
        else
            local tmp = _G.GetRandomNum(1, len)
            if tmp == self.RandomNum then
                tmp = self.RandomNum + 1
                if tmp > len then
                    tmp = tmp % len
                end
            end
            self.RandomNum = tmp
        end
        thudid = bubblesArr[self.RandomNum]
    else
        if _G.IsNil(hudid) then
            return
        end
        len = #hudid
        if len <= 0 then
            return
        end

        local intervalArr = Data.intervalArr
        if intervalArr == nil then
            intervalArr = _G.ConfigManager.discrete_cfg[interval][1]
        end

        local time1 = intervalArr[1]
        local time2 = intervalArr[2]
        local RandomTime = _G.GetRandomNum(time1, time2)
        t_eventInterval = RandomTime

        local tmp = _G.GetRandomNum(1, len)
        if tmp == self.EventRandomNum then
            tmp = self.EventRandomNum + 1
            if tmp > len then
                tmp = tmp % len
            end
        end
        self.EventRandomNum = tmp
        thudid = hudid[self.EventRandomNum]
    end

    local hudInfo = _G.ConfigManager.hud_cfg[thudid]
    if _G.IsNil(hudInfo) then
        return
    end

    ---加上当前气泡持续时间
    if t_eventInterval then
        t_interval = t_eventInterval + hudInfo.Duration
    else
        if not self.intervalsSeconds[1] or not self.intervalsSeconds[2] then
            if _G.AppSetting.DEBUG then
                _G.LogError("策划没有正确配气泡间隔时间,discrete_cfg 100602")
            end
        end
        _intervalsSeconds = _G.GetRandomNum(self.intervalsSeconds[1], self.intervalsSeconds[2])
        t_interval = _intervalsSeconds + hudInfo.Duration
    end
    local UnixTime = _G.TimeUtil.GetServerUnixTime()
    self.BubblesUnixTime = UnixTime
    ---永久的常态气泡 不显示下次
    if hudInfo.Duration > 0 then
        ---下次气泡显示总间隔
        self.Cnb_Next =
            _G.DelayDo(
            t_interval,
            function()
                ---如果 气泡另外显示  就不执行
                if self.BubblesUnixTime ~= UnixTime then
                    return
                end
                self:CheckNormalBubbles(hudid, interval, npc, Data)
            end
        )
    end

    --如果没显示主界面  不显示常态气泡
    local IsActiveWindow, MainView = _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    ---怪物攻城
    local IsActiveWindow1, MainViewSiege =
        _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
    --该NPC 当前有气泡(交互产生等)  不显示常态气泡
    local isHave = _G.HUDUtilities.GetTagetIsHud(self.Uid)
    --自身没被隐藏 显示气泡
    if npc and self.Transform:GetctiveInHierarchy() == 1 then
        local uid = npc.Uid
        if npcType == 1 then
            ---0主角播放气泡
            uid = 0
        end
        _G.HUDUtilities.ShowHudID(thudid, nil, uid)
    elseif
        IsActiveWindow and MainView.gameObject and MainView.gameObject:GetctiveInHierarchy() == 1 and isHave == false and
            not _G.IsNil(self.Transform) and
            self.Transform:GetctiveInHierarchy() == 1
     then
        _G.HUDUtilities.ShowHudID(thudid, nil, self.Uid)
    elseif
        IsActiveWindow1 and MainViewSiege.gameObject and MainViewSiege.gameObject:GetctiveInHierarchy() == 1 and
            isHave == false and
            not _G.IsNil(self.Transform) and
            self.Transform:GetctiveInHierarchy() == 1
     then
        _G.HUDUtilities.ShowHudID(thudid, nil, self.Uid)
    end
end

---关闭气泡
function BaseItem:SetBubblesActive(isOn, hudid)
    if self.BubblesIsOn == true and isOn == false then
        self.BubblesIsOn = false
    elseif self.BubblesIsOn == false and isOn == true then
        self.BubblesIsOn = true
        self:CheckNormalBubbles(hudid)
    end
end

--endregion

function BaseItem:InitFootShadow()
    if self.footEffect then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.prf_fakeshadow,
        self.Transform,
        function(obj)
            if _G.IsNil(self.Transform) or not self.IsHideShadow then
                _G.DestroyObject(obj)
                return
            end
            obj:SetActiveE(0)
            self.footEffect = obj
        end
    )
end

function BaseItem:Reset()
end
--region 阴影
function BaseItem:InitSkinnedMeshRenderer()
    if _G.IsNil(self.ObjectMod) and not self.IsHideShadow then
        return
    end
    local tb = {}
    self.RendererTb = self.ObjectMod:GetComponentsInChildrenE(_G.typeof(_G.CS.UnityEngine.Renderer))
    for i = 1, self.RendererTb.Length do
        tb[i] = self.RendererTb[i - 1]
    end
    self.RendererTb = tb
    if self.initHideShadow then
        self:HideShadow(true)
        if
            self.ItemType == _G.WorldItemType.NPC or self.ItemType == _G.WorldItemType.Enemy or
                self.ItemType == _G.WorldItemType.Ghost or
                self.DataType == _G.WorldItemDataType.Player
         then
            self:InitFootShadow()
        end
    end
end
---隐藏影子
function BaseItem:HideShadow(force)
    if not self.RendererTb or (not force and self.IsHideShadow) then
        return
    end
    self.IsHideShadow = true
    for _, v in pairs(self.RendererTb) do
        v.shadowCastingMode = ShadowCastingMode.Off
    end
end
---显示影子
function BaseItem:ShowShadow(force)
    if not self.RendererTb or (not force and not self.IsHideShadow) then
        return
    end
    self.IsHideShadow = false
    for _, v in pairs(self.RendererTb) do
        v.shadowCastingMode = ShadowCastingMode.On
    end
    if not _G.IsNil(self.footEffect) then
        _G.DestroyObject(self.footEffect)
        self.footEffect = nil
    end
end

---设置显示参数
---@param params BaseItemDisplayParam
function BaseItem:SetDisplayParams(params)
    if not params then
        return
    end
    self.initHideShadow = params.IsHideShadow
end
--endregion

function BaseItem:CheckMoveing()
    if self.MoveStep == 1 then
        self.AnimName = nil
        self:PlayAnimByName(self:GetMoveAnimationName())
    end
end

return BaseItem
