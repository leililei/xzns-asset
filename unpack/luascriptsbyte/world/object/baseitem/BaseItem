---类的构造函数
---@param info BaseItemParam 类型
function BaseItem:__init(info, data, world)
    self.DataType = info.dataType and info.dataType or _G.WorldItemDataType.NomalItem
    self.Uid = info.uid
    self.Sid = info.sid
    self.Cfg = info.cfg
    self.InstID = nil
    self.Transform = nil
    self.FinishCallB = info.callback
    self.NavNodes = _G.CS.UnityEngine.AI.NavMeshPath()
    self.World = world or info.world
    self.MoveSpeed = MAXMOVESPEED
    self.MaxMoveSpeed = MAXMOVESPEED
    self.AnimName = nil
    self.MoveStep = 0
    self.DynamicTriggerNode = {}
    self.Enable = false
    self.ObjectModActive = false
    self.FootEffectActive = false
    self.TitleTransformActive = false
    self.TitleLoading = false
    self:BubblesInit()
end

---类的析构函数
function BaseItem:Dispose()
    self.DataType = nil
    self.Uid = nil
    self.Sid = nil
    self.Cfg = nil
    self.InstID = nil
    self.Transform = nil
    self.FinishCallB = nil
    self.NavNodes = nil
    self.World = nil
    self.MoveSpeed = nil
    self.AnimName = nil
    self.MoveStep = nil
    self.DynamicTriggerNode = nil
    self.Enable = nil
    self.NavNodesLength = nil
    self.NavCorners = nil
    self.NavNodeIndex = nil
    self.AnimComponent = nil
    self.ObjectMod = nil
    self.IdleEffetTrans = nil
    if self.gotoPointTimer then
        self.gotoPointTimer:Stop()
        self.gotoPointTimer = nil
    end
    self:BubblesInit(true)
    if self.setEnableTimer then
        self.setEnableTimer:Stop()
        self.setEnableTimer = nil
    end
end

---初始化
function BaseItem:Init()
    self:LoadObject(nil)
end

---检测一下那些物件是不用碰撞的
function BaseItem:CheckCollider(uid)
    for i = 1, 14 do
        if (100000000 + i) == uid then
            return true
        end
    end
    return false
end

--region 加载和清理
---初始化和加载根节点
---@param res_path string 根节点资源路径
function BaseItem:LoadObject(res_path)
    res_path = res_path and res_path or "CommonPrefab/World/ItemRootPrefab"
    _G.PoolsManager:GetInstance():Spawn(
        res_path,
        _G.ePoolType.World,
        self.World.ItemRoot,
        function(tran)
            self.Transform = tran
            self.InstID = tran:GetInstanceIDE()
            self.World.AllWorldItemsByInstId[self.InstID] = self
            self.Transform:SetName(self.Uid)
            if self:CheckCollider(self.Uid) then
                self.Transform:SetColliderEnable(0)
            else
                self.Transform:SetColliderEnable(self.Cfg.Click_type and 0 or 1)
            end
            self:LoadResObj()
        end
    )
end
-----加载配置资源节点
function BaseItem:LoadResObj()
    if self.Cfg and self.Cfg.Res and not _G.string.IsNullOrEmpty(self.Cfg.Res) then
        _G.PoolsManager:GetInstance():Spawn(
            self.Cfg.Res,
            _G.ePoolType.World,
            self.Transform,
            function(tran)
                self.ObjectMod = tran
                self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(self.Transform)
                self.AnimComponent:HandInit()
                self:OnLoadResObjComplete()
                self:InitSkinnedMeshRenderer()
                self.ObjectMod:SetActiveE(0)
            end
        )
    else
        self:OnLoadResObjComplete()
    end
end
---加载资源完成
function BaseItem:OnLoadResObjComplete()
    -- if _G.SystemSettingManager:GetInstance():GetImageQuality() == _G.ImageQuality.High then
    --     self.highLight = self.Transform:RequireComponentE(_G.typeof(_G.CS.HighlightableObject))
    -- end
    _G.WorldCsListener.AddTriggerCall(self.InstID, _G.handler(self, self.TriggerEvent))
    --self:InitSkinnedMeshRenderer()
    if self.FinishCallB ~= nil then
        self.FinishCallB(self)
    end
end

---清理item节点下的对象
function BaseItem:DisWorldItem()
    _G.NavManager:GetInstance():DeleteNavItemByUid(self.Uid, true)
    self:RemoveAllDynamicTriggerNode()
    self:RemoveNavUpdateMove()
    self:RemoveUpdateMoveFunction()
    _G.WorldCsListener.RemoveTriggerCall(self.InstID)
    if self.Transform then
        _G.DestroyObject(self.Transform)
    end
    self:Dispose()
end
