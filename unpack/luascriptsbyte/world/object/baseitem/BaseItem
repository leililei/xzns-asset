--region 动画
---播放指定名称的动画
---@param name string 动画name
---@param isEndCall boolean 结束是否回调
function BaseItem:PlayAnimByName(name, isEndCall)
    if self.AnimName then
        if self.AnimName == name then
            return
        end
    end
    if not name or name == "" then
        return
    end
    if _G.IsNil(self.AnimComponent) then
        return
    end
    if not self.Transform then
        return
    end
    if 0 == self.Transform:GetctiveInHierarchy() then
        return
    end
    self.AnimName = name
    self.AnimComponent:PlayForce(name, isEndCall or false)
end
---队列播放动画
---@param curname string 当前动画
---@param nextname string 下一个动画
function BaseItem:PlayAnimQueue(curname, nextname)
    if _G.string.IsNullOrEmpty(curname) then
        return
    end
    if _G.string.IsNullOrEmpty(nextname) then
        return
    end
    if _G.IsNil(self.AnimComponent) then
        return
    end
    if not self.Transform then
        return
    end
    if 0 == self.Transform:GetctiveInHierarchy() then
        return
    end
    self.AnimName = nextname
    self.AnimComponent:Queue(curname, nextname)
end
--endregion

--region 寻路移动相关
---启动移动
function BaseItem:StartUpdateMove()
    ---添加Update
    if not self.UpdateMoveFunction then
        self.UpdateMoveFunction = _G.handler(self, self.UpdateMove)
    end
    if not _G.UpdateManager:GetInstance():HasUpdate(self.UpdateMoveFunction, self) then
        _G.UpdateManager:GetInstance():AddUpdate(self.UpdateMoveFunction, self)
    end
end
---玩家移动
function BaseItem:UpdateMove()
    if self.MoveStep ~= 0 then
        self.Transform:SetForwardPosition(self.MoveSpeed, 1, 1)
    end
end
---移动
---@param moveStep number 移动状态
---@param speed number 速度
function BaseItem:Move(moveStep, speed)
    self.MoveStep = moveStep
    if moveStep == 0 then
        self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    else
        if not speed then
            self:PlayAnimByName(_G.WorldManager.AnimNames.MOVE)
        else
            local speedFloor = math.floor(speed)
            local aniName = self:GetAnimNameBySpeed(speedFloor)
            self:PlayAnimByName(aniName)
            self:SetSpeed(speed)
        end
    end
end
---设置speed
---@param speed number
function BaseItem:SetSpeed(speed)
    self.MoveSpeed = speed
end
---设置显示物体根节点状态
function BaseItem:SetActiveE(isactive)
    if self.Transform ~= nil and self.Transform:GetActiveSelf() == 1 ~= isactive and 1 or 0 then
        self.Transform:SetActiveE(isactive and 1 or 0)
        if isactive then
            self:StartUpdateMove()
        else
            self:RemoveUpdateMoveFunction()
        end
    end
end
---通过速度获取移动动画名称m并且设置速度
---@param speed number
function BaseItem:GetAnimNameBySpeed(speed)
    if speed <= 3 then
        return _G.WorldManager.AnimNames.WALK
    else
        return _G.WorldManager.AnimNames.MOVE
    end
end
