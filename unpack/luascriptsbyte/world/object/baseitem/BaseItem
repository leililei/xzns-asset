--region 常态气泡
function BaseItem:BubblesInit(isNil)
    if isNil then
        self.intervalsSeconds = nil
        self.intervalsSecondsDefault = nil

        if self.Cnb then
            _G.coroutine.stopwaiting(self.Cnb)
            self.Cnb = nil
        end
        if self.Cnb_Next then
            _G.coroutine.stopwaiting(self.Cnb_Next)
            self.Cnb_Next = nil
        end

        self.BubblesIsOn = nil
        self.BubblesUnixTime = nil
    else
        ---常态气泡间隔时间初始化
        self.intervalsSeconds = nil
        self.intervalsSecondsDefault = 1

        if not self.intervalsSeconds then
            local cfg = _G.ConfigManager.discrete_cfg[100602]
            self.intervalsSeconds = {cfg[1][1], cfg[1][2]} or {1, 1}
        end
    end
end
