end
--region 对触发器响应
local childTriggerCount = 2
---添加子触发器
function WorldBaseItem:AddTriggerComponent(callback)
    local loadTimes = 0
    local loadDoneFunc = function()
        loadTimes = loadTimes + 1
        if loadTimes >= childTriggerCount then
            if callback then
                callback()
            end
        end
    end
    if not self.TriggerComponent and self.Cfg.Radius > 0 then
        self:CreateSphereTriggerComponent(
            "LookAtPlayer",
            function(trigger)
                trigger:SetSphereColliderArgs(0, 0, 0, self.Cfg.Radius)
                trigger:SetTriggerEvent(_G.handler(self, self.NodeTriggerEvent))
                self.TriggerComponent = trigger
                loadDoneFunc()
            end
        )
    else
        loadDoneFunc()
    end
    if not self.ActionTriggerComponent and self.Cfg.ActionRadius > 0 then
        self:CreateSphereTriggerComponent(
            "ActionTrigger",
            function(trigger)
                trigger:SetSphereColliderArgs(0, 0, 0, self.Cfg.ActionRadius)
                trigger:SetTriggerEvent(_G.handler(self, self.NodeActionTriggerEvent))
                self.ActionTriggerComponent = trigger
                loadDoneFunc()
            end
        )
    else
        loadDoneFunc()
    end
end
---创建圆形触发器
---@param 变量名 name 触发器名称(节点展示名称)
---@param callback function 创建后的回调
function WorldBaseItem:CreateSphereTriggerComponent(name, callback)
    self:CreateTriggerComponent(
        name,
        require("TriggerNode").ColliderType.SphereCollider,
        {"WorldPlayerItem"},
        function(trigger)
            if callback then
                callback(trigger)
            end
            trigger:SetTriggerEnable(true)
        end
    )
end
-----创建子触发器
---@param 变量名 变量类型 中文描述
function WorldBaseItem:CreateTriggerComponent(name, colliderType, acceptItemType, callback)
    ---@type TriggerNodeCreateArgs
    local args = {}
    args.Name = name
    args.Parent = self
    args.ColliderType = colliderType
    args.AcceptItemType = acceptItemType
    args.CallBack = function(trigger)
        if callback then
            callback(trigger)
        end
    end
    require("TriggerNode").Create(args, self.World)
end
---设置子触发器开关
---@param enable boolean 开关
function WorldBaseItem:SetDynamicTriggerEnable(enable)
    for _, trigger in pairs(self.DynamicTriggerNode) do
        trigger:SetTriggerEnable(enable)
    end
end
---设置触发器开关
---@param enable boolean 开关
function WorldBaseItem:SetColliderEnable(enable)
