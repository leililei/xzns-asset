--region 特效相关加载
---特效加载回调
---@param trans UnityEngine.Transform 特效
function WorldBaseItem:LoadEffectCallback(trans)
    self.curLoadEffectTransTable[self.curLoadEffectNames[self.curLoadEffectIndex]] = trans
    self.curLoadEffectIndex = self.curLoadEffectIndex + 1
    if self.curLoadEffectIndex > #self.curLoadEffectNames then
        self.curLoadEffectCallback(_G.DeepCopy(self.curLoadEffectTransTable))
        self.curLoadEffectIndex = nil
        self.curLoadEffectTransTable = nil
        self.curLoadEffectNames = nil
        self.curLoadEffectRoots = nil
        self.curLoadEffectCallback = nil
    end
end
---加载特效
---@param names table 特效名字数组(ui_effect_cfg中key)
---@param roots table 特效挂在点数组
---@param callback function 加载返回
function WorldBaseItem:LoadEffects(names, roots, callback)
    if _G.table.isEmptyOrNil(names) then
        callback(nil)
        return
    end
    self.curLoadEffectIndex = 1
    self.curLoadEffectTransTable = {}
    self.curLoadEffectNames = names
    self.curLoadEffectRoots = roots or {}
    self.curLoadEffectCallback = callback
    for i = 1, #names do
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[self.curLoadEffectNames[i]],
            self:GetChildNode(self.curLoadEffectRoots[i]),
            _G.handler(self, self.LoadEffectCallback)
        )
    end
end
--endregion

--region初始化检测
---检测初始化状态表现
function WorldBaseItem:CheckInitState()
    if #self.Cfg.Action > 0 then
        self:PlayAnimByName(self.Cfg.Action[1])
    end
    if not self.curLoadEffectNames and _G.table.isEmptyOrNil(self.actionEffect1) then
        self:LoadEffects(
            self.Cfg.ActionEffect[ActionEffectInit],
            self.Cfg.EffectRoute[ActionEffectInit],
            function(effects)
                self.actionEffect1 = effects
            end
        )
    end
end

---检测交互的特效表现
function WorldBaseItem:CheckInteractionState(callback)
    self:LoadEffects(
        self.Cfg.ActionEffect[ActionEffectInteract],
        self.Cfg.EffectRoute[ActionEffectInteract],
        function(effects)
            if callback then
                callback(effects)
            end
        end
    )
end

---检测交互后的表现
---@param isEndCall boolean 结束是否回调
---@param endcall function 没有动画直接回调
function WorldBaseItem:CheckInteractionEndState(isEndCall, endcall)
    if self.Cfg.Action[ActionIdleEnd] then
        local name = self.Cfg.Action[ActionIdleEnd]
        self:PlayAnimByName(name, isEndCall)
    else
        self.Transform:SetActiveE(0)
        if isEndCall and endcall then
            endcall()
        end
    end
    if not self.curLoadEffectNames and _G.table.isEmptyOrNil(self.actionEffect3) then
        self:LoadEffects(
            self.Cfg.ActionEffect[ActionEffectInteracted],
            self.Cfg.EffectRoute[ActionEffectInteracted],
            function(effects)
                self.actionEffect3 = effects
            end
        )
    end
    if not _G.table.isEmptyOrNil(self.actionEffect1) then
        for key, value in pairs(self.actionEffect1) do
            _G.UIUtils.RemoveEffect(value, _G.ConfigManager.ui_effect_cfg[key].DispoeType)
        end
        self.actionEffect1 = nil
    end
end
--endregion

--region获取节点和坐标
---获取子节点,以物体根节点为父级往下找，找不到就返回根节点
---@param path string 路径
function WorldBaseItem:GetChildNode(path)
    if _G.IsNil(self.ObjectMod) then
        return self.Transform
    end
    if _G.string.IsNullOrEmpty(path) then
        return self.ObjectMod
    end
    local node = self.ObjectMod:FindE(path)
    if _G.IsNil(node) then
        node = self.ObjectMod
    end
    return node
end

---获取头顶点坐标
---@return number|number|number x,y,z
function WorldBaseItem:GetHeadPoint()
    if _G.IsNil(self.RolePoint) then
        return nil
    end
    if _G.IsNil(self.RolePoint.Point_Hp) then
        if _G.IsNil(self.RolePoint.Point_Head) then
            return nil
        else
            return self.RolePoint.Point_Head:GetPosition()
        end
    end
    return self.RolePoint.Point_Hp:GetPosition()
end
--endregion

---检测交互限制条件
---@param callback function 播完限制条件提示后的回调
---@return boolean 是否可交互
function WorldBaseItem:CheckLimitType(callback)
    if self.Cfg.LimitType and #self.Cfg.LimitType > 0 then
        local conditions = _G.DeepCopyCfgTable(self.Cfg.LimitType)
        local isReveal = true
        for i = 1, #conditions do
            local _t = _G.table.remove(conditions[i], 1)
            local resoult, tips, content = _G.GlobalConditionManager.CheckMainEventCondition(_t, conditions[i])
            if not resoult then
                if #self.Cfg.Prompt > 1 then
                    if self.Cfg.Prompt[1] == 2 then
                        tips = self.Cfg.Prompt[2] or tips
                        _G.PopWindowManager:GetInstance():ShowAllTips(tips, content)
                        if callback then
                            callback()
                        end
                    else
                        _G.AutomaticPlayStory.PlayStoryByID(self.Cfg.Prompt[2], callback)
                    end
                else
                    if callback then
                        callback()
                    end
                end
                return false
            end
        end
    end
    return true
end

