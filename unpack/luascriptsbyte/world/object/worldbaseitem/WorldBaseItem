---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function WorldBaseItem:SetTitlePos()
    if not _G.IsNil(self.TitleTransform) then
        local x, y, z = self:GetHeadPoint()
        if x then
            self.titleDeltaY = self:GetTitleDeltaY()
            local x1, y1, z1 = self.Transform:GetPosition()
            local s = self.TitleTransform:GetLocalScale()
            self.titleDeltaY = (y - y1 + self.titleDeltaY)
            self.titlePosX = 0
            self.titlePosY = 0
            self.titlePosZ = 0
            if self.World.WorldSetting then
                self.World.WorldSetting:TranLookAtCamera(self.TitleTransform, self.Transform)
            end
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未找到名字挂载点 Point_Hp.请检测模型 " .. self.Uid)
            end
            self.TitleTransform:SetActiveE(0)
        end
    end
end
