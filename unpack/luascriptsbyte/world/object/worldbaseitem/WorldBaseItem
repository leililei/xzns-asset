--region 配置移动
---初始化配置移动
function WorldBaseItem:InitCfgMove()
    if not self.ItemData.IsMove then
        return
    end
    if self.ItemData.RoutePoints[1] == nil then
        return
    end
    if self.AllNode and #self.AllNode > 0 then
        self.curCfgMoveIndex = 1
        return
    end
    self.AllNode = {}
    local points = self.ItemData.RoutePoints[1].Point
    for i = 1, #points do
        _G.table.insert(
            self.AllNode,
            {x = points[i].x, y = points[i].y, z = points[i].z, ani = points[i].ani, speed = points[i].speed}
        )
    end
    self.curCfgMoveIndex = 1
end
---停止配置移动
function WorldBaseItem:StopCfgMove()
    if not self.ItemData then
        return
    end
    if not self.ItemData.IsMove then
        return
    end
    if not self.AllNode or #self.AllNode <= 0 then
        return
    end
    self:Move(0)
end
---继续配置移动
function WorldBaseItem:ContinueCfgMove()
    if not self.ItemData then
        return
    end
    if not self.ItemData.IsMove then
        return
    end
    if not self.AllNode or #self.AllNode <= 0 then
        return
    end
    self.MoveSpeed = self.MaxMoveSpeed * self.AllNode[self.curCfgMoveIndex].speed
    self.cfgMoveDelay =
        self.Transform:SetDirection(
        self.AllNode[self.curCfgMoveIndex].x,
        self.AllNode[self.curCfgMoveIndex].y,
        self.AllNode[self.curCfgMoveIndex].z,
        self.MoveSpeed
    )
    self:Move(1, self.MoveSpeed)
end
---配置帧移动
function WorldBaseItem:UpdateMove()
    if self.MoveStep == 0 then
        return
    end
    if self.cfgMoveDelay and self.cfgMoveDelay <= 0 then
        self:Move(0)
        if _G.string.IsNullOrEmpty(self.AllNode[self.curCfgMoveIndex].ani) then
            self:OnCfgMoveAniPlayEnd(self.AllNode[self.curCfgMoveIndex].ani)
        else
            _G.AnimatorPlayEndCallback.AddCallback(
                _G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE(),
                _G.handler(self, self.OnCfgMoveAniPlayEnd)
            )
            self:PlayAnimByName(self.AllNode[self.curCfgMoveIndex].ani, true)
        end
    else
        self.cfgMoveDelay = self.cfgMoveDelay - _G.Time.deltaTime
        self.Transform:SetDirection(
            self.AllNode[self.curCfgMoveIndex].x,
            self.AllNode[self.curCfgMoveIndex].y,
            self.AllNode[self.curCfgMoveIndex].z,
            self.MoveSpeed
        )
        self.Transform:SetForwardPosition(self.MoveSpeed, 1, 1)
    end
end
---当配置移动动画播放完成
---@param name string 动画名称
function WorldBaseItem:OnCfgMoveAniPlayEnd(name)
    if name == self.AllNode[self.curCfgMoveIndex].ani then
        self.curCfgMoveIndex = self.curCfgMoveIndex + 1
        if self.curCfgMoveIndex > #self.AllNode then
            self.curCfgMoveIndex = 1
        end
        self.MoveSpeed = self.MaxMoveSpeed * self.AllNode[self.curCfgMoveIndex].speed
        self.cfgMoveDelay =
            self.Transform:SetDirection(
            self.AllNode[self.curCfgMoveIndex].x,
            self.AllNode[self.curCfgMoveIndex].y,
            self.AllNode[self.curCfgMoveIndex].z,
            self.MoveSpeed
        )
        self:Move(1, self.MoveSpeed)
    end
end
--endregion

return WorldBaseItem
