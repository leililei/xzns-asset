function WorldBaseItem:ShowOrHide(show, force)
    if force then
        self.OriginalShowState = show
    end
    -- if show == self.curSetEnable then
    --     return
    -- end
    base.ShowOrHide(self, show and self.OriginalShowState)
    if not _G.WorldManager:GetInstance():CheckCurSceneType(_G.SceneType.MainWorld) then
        if not _G.IsNil(self.TitleTransform) then
            _G.GameUtil.SetActiveByCondition(self.TitleTransform, show and self.OriginalShowState)
        end
    end
    if show and self.OriginalShowState then --self.curSetEnable then
        if self.ObjShowTimer then
            self.ObjShowTimer:Stop()
            self.ObjShowTimer = nil
        end
        self.ObjShowTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnGameObjShow, self, true, true):Start()
    else
        if self.ObjShowTimer then
            self.ObjShowTimer:Stop()
            self.ObjShowTimer = nil
        end
        self:OnGameObjHide()
    end
end
function WorldBaseItem:OnGameObjShow()
    if
        self.Cfg and #self.Cfg.InteractionIcon >= InteractionIconShowIndex and
            self.Cfg.InteractionIcon[InteractionIconShowIndex] > 0
     then
        local show, posy = self:GetShowTagData()
        if show then
            _G.Events:GetInstance():Broadcast(require("WorldItemManager").ItemEvent.showTag, self.Uid, true, posy or 0)
        end
    end
    self:ContinueCfgMove()
end
function WorldBaseItem:OnGameObjHide()
    if #self.Cfg.InteractionIcon >= InteractionIconShowIndex and self.Cfg.InteractionIcon[InteractionIconShowIndex] > 0 then
        _G.Events:GetInstance():Broadcast(require("WorldItemManager").ItemEvent.showTag, self.Uid, false)
    end
    self:StopCfgMove()
end
function WorldBaseItem:Reset()
    if _G.IsNil(self.ObjectMod) then
        if not self.ItemData.IsHidden then
            self:OnEnterWorld()
        else
            self:OnExitWorld()
        end
    else
        self:ShowOrHide(not self.ItemData.IsHidden)
    end
    self:InitCfgMove()
end
function WorldBaseItem:OnEnterWorld()
    if self.Cfg.Reveal_condition and #self.Cfg.Reveal_condition > 0 then
        local conditions = _G.DeepCopyCfgTable(self.Cfg.Reveal_condition)
        local isReveal = true
        for i = 1, #conditions do
            local _t = _G.table.remove(conditions[i], 1)
            if not _G.GlobalConditionManager.CheckMainEventCondition(_t, conditions[i]) then
                isReveal = false
                break
            end
        end
        if isReveal then
            self.OriginalShowState = self.Cfg.reveal
        end
    end
    self:InitPosition()
    self:InitCfgMove()
    self:CreateObjectModel()
end
-----退出世界时调用，由子类重写
function WorldBaseItem:OnExitWorld()
    self:ClearObjectModel()
    if not _G.table.isEmptyOrNil(self.actionEffect1) then
        for key, value in pairs(self.actionEffect1) do
            if _G.IsNil(value) == false then
                _G.UIUtils.RemoveEffect(value, _G.ConfigManager.ui_effect_cfg[key].DispoeType)
            end
        end
        self.actionEffect1 = nil
    end
    if not _G.table.isEmptyOrNil(self.actionEffect3) then
        for key, value in pairs(self.actionEffect3) do
            if _G.IsNil(value) == false then
                _G.UIUtils.RemoveEffect(value, _G.ConfigManager.ui_effect_cfg[key].DispoeType)
            end
        end
        self.actionEffect3 = nil
    end

    base.OnExitWorld(self)
end
