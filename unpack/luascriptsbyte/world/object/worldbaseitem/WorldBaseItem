    self.RandomNum = nil
    self.EventRandomNum = nil
    self.TitleTransform = nil
    self.ItemData = nil
    self.OriginalShowState = nil
    self.TitleTextName = nil
    self.TriggerComponent = nil
    self.RolePoint = nil
    self.actionEffect1 = nil
    self.actionEffect3 = nil
