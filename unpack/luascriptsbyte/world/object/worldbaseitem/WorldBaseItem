end
---注册一个Trigger节点
---@param triggerNode TriggerNode 根节点资源路径
function WorldBaseItem:AddDynamicTriggerNode(triggerNode)
    assert(triggerNode, "triggerNode == nil")
    if self.DynamicTriggerNode[triggerNode.Name] then
        return
    end
    self.DynamicTriggerNode[triggerNode.Name] = triggerNode
end
---移除所有子触发器
function WorldBaseItem:RemoveAllDynamicTriggerNode()
    for name, _ in pairs(self.DynamicTriggerNode) do
        assert(name, "name == nil")
        local triggerNode = self.DynamicTriggerNode[name]
        if triggerNode then
            triggerNode:DestroySelf()
            self.DynamicTriggerNode[name] = nil
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("triggerNode is nil       ", name)
            end
        end
    end
end
