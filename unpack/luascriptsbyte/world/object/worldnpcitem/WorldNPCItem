---根据状态给NPC添加提示标记
---@param tiptype EWorldItemTipType @提示类型2
function WorldNPCItem:CreateTaskSign(tiptype)
    if self.TaskTipType ~= tiptype then
        self.TaskTipType = tiptype
        self:RemoveTaskSign()
        local tiprespath = WorldData.EWorldItemTipResMap[tiptype]
        local nameTitleTF = self.TitleTransform
        if tiprespath ~= nil and nameTitleTF ~= nil then
            _G.PoolsManager:GetInstance():Spawn(
                tiprespath,
                _G.ePoolType.World,
                self.World:GetTitleRoot(),
                function(tran)
                    --- 防止创建中角色被销毁
                    if _G.IsNil(nameTitleTF) then
                        self:RemoveTaskSign()
                        return
                    end
                    self.TaskSign = tran
                    self.World.WorldSetting:TranLookAtCamera(self.TaskSign, self.Transform)
                    tran:SetLocalPosition(1000, 1000, 1000)
                end
            )
        end
    end
end

