---移除效果
function WorldNPCItem:RemoveCommonEffect()
    if not _G.IsNil(self.ObjectMod) then
        self.World.CommonEff:SetSelectState(self.ObjectMod, false)
        --还原渲染状态
        local renders = self.ObjectMod:GetComponentsInChildren(_G.typeof(_G.Renderer))
        if not _G.IsNil(renders) then
            local len = renders.Length - 1
            for i = 0, len do
                local render = renders[i]
                if not _G.IsNil(render) and not _G.IsNil(render.sharedMaterial) then
                    render.sharedMaterial:SetFloat("_ShadowArea", 0)
                    render.shadowCastingMode = _G.CS.UnityEngine.Rendering.ShadowCastingMode.On
                end
            end
        end
    end
end
