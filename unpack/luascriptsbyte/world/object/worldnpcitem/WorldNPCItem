function WorldNPCItem:NpcDoEvent()
    _G.WorldItemManager:GetInstance():CloseInteractedView(_G.WorldItemType.NPC, self.Transform)
    if self.triggerAction then
        return
    end
    self:StopCfgMove()
    local giftNpcUid = require "MainViewGiftModel":GetInstance():GetCurNpc()
    if self.Uid == giftNpcUid then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DialogueNewView.Name,
            function()
                WorldUtils.UpdateWorldItemTip(self.Uid)
            end
        )
        return
    end
    if not self:CheckLimitType(_G.handler(self, self.ContinueCfgMove)) then
        return
    end
    self:StopStandActionTimer()
    if self:CheckStandAction(self.AnimName) then
        base.PlayAnimByName(self, _G.WorldManager.AnimNames.IDLE)
    end

    local doaction = function()
        local ishave, t_RelativeDialogueTask = _G.TaskModule:GetInstance():GetNPCRelativeDoingTask(self.Uid)
        if t_RelativeDialogueTask ~= nil then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
            --- 延迟执行
            --- 否则  点击有任务的NPC 寻路到NPC 立马执行任务第一步寻路NPC  会导致之前的自动寻路不停止
            _G.DelayDo(
                0.02,
                function()
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                    _G.TaskModule:GetInstance():ExecuteTask(t_RelativeDialogueTask)
                end
            )
        else
            --执行NPC 行为前 先执行剧情
            local len = #self.Cfg.default_interaction_plot
            --有剧情   且交互类型不为6全局函数
            ---ZHJ-20054【主线副本】进入传送门的瞬间控制角色触碰巡逻NPC，控制角色位置错误
            if self.Cfg.Params[1] == NpcActionType.Dialogue then
                if require "ChapterModel":GetInstance():CheckDoingEvent() then
                    return
                else
                    require "ChapterModel":GetInstance():SetBehavioralPriority(true)
                end
            end
            if len > 0 and self.Cfg.Params[1] ~= NpcActionType.RoomEvent then
                local RandomIndex = _G.GetRandomNum(1, len)
                _G.AutomaticPlayStory.PlayStoryByID(
                    self.Cfg.default_interaction_plot[RandomIndex],
                    function()
                        ActionFunction[self.Cfg.Params[1]](self)
                    end
                )
            else
                ActionFunction[self.Cfg.Params[1]](self)
            end
        end
    end

    if _G.MainManager:GetInstance().isInMainView then
        doaction()
    elseif _G.WorldManager:GetInstance().curSceneSid == require("SociatyManager"):GetInstance().ScenceId then
        ActionFunction[self.Cfg.Params[1]](self)
    elseif
        not _G.MainManager:GetInstance().isInMainView and
            (_G.MainManager:GetInstance().mainView and _G.MainManager:GetInstance().mainView.isSection)
     then
        _G.coroutine.start(
            function()
                while not _G.MainManager:GetInstance().isInMainView do
                    _G.coroutine.yield()
                end
                doaction()
            end
        )
    end
end
function WorldNPCItem:NpcDoEventDone(success)
    if success then
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
        self:CheckInteractionState()
        self.isInteracted = true
        if not _G.string.IsNullOrEmpty(self.Cfg.Action[ActionInteractedAfter]) then
            _G.AnimatorPlayEndCallback.AddCallback(
                _G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE(),
                _G.handler(self, self.PlayInteractedActionEndCall)
            )
            self:PlayAnimByName(self.Cfg.Action[ActionInteractedAfter], true)
        else
            self:PlayInteractedActionEndCall()
        end
    end
    if self.ObjectMod then
        self.World.CommonEff:SetSelectState(self.ObjectMod, false)
    end
    self:ContinueCfgMove()
end
function WorldNPCItem:PlayInteractedActionEndCall()
    if _G.IsNil(self.ObjectMod) then
        return
    end
    self:CheckInteractionEndState()
end
--endregion

--region 内部调用方法

--设置看向某个场景中的物体
---@param uid number
function WorldNPCItem:LookAtItemByUid(uid)
    if not uid then
        local point = self.ItemData.InitPoint[1]
        self.Transform:SetLocalEulerAngles(point.r_x, point.r_y, point.r_z)
        return
    end
    local lookObj = _G.WorldItemManager:GetInstance():GetItemByUid(uid)
    if lookObj then
        local x, y, z = lookObj.Transform:GetPosition()
        local x1, y1 = self.Transform:GetPosition()
        local lookPos = _G.Vector3(x, y1, z)
        self.Transform:LookAt(lookPos)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("看向的物体不存在")
        end
    end
end

-----播放互动动画
function WorldNPCItem:PlayActionAnimation()
    require("AudioManager").PlayAudioByAudioCfgID(self.Cfg.InteractionAction_audio)

    if _G.string.IsNullOrEmpty(self.Cfg.InteractionAction) then
        return
    end
    self:PlayAnimByName(self.Cfg.InteractionAction)
end
--endregion

--region 播放idle动画

---停止闲置动画
function WorldNPCItem:StopStandActionTimer()
    if self.StandActionTimer then
        self.StandActionTimer:Stop()
        self.StandActionTimer = nil
    end
end
---开启播放下次闲置动画倒计时
function WorldNPCItem:StartStandActionTimer()
    if self.StandActionCount <= 0 then
        return
    end
    if self.StandActionTimer then
        self:StopStandActionTimer()
    end
    self.StandActionTimer =
        _G.TimerManager:GetInstance():GetTimer(
        _G.Mathf.Random(self.StandActionTime[1], self.StandActionTime[2]),
        self.PlayeIdleAnim,
        self,
        true,
        false,
        true
    )
    self.StandActionTimer:Start()
end

---播放闲置动画
function WorldNPCItem:PlayeIdleAnim()
    if not self then
        return
    end
    if not self.StandActionName then
        self:StopStandActionTimer()
        return
    end
    local index = _G.GetRandomNum(1, self.StandActionCount)
    local name = self.StandActionName[index].name
    if name then
        self:PlayAnimByName(name, true)
        _G.AnimatorPlayEndCallback.AddCallback(
            _G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE(),
            _G.handlerbind(self, self.PlayeIdleAnimCall, name)
        )
    end
    if self.IsPlayerEnter then
        local cfg = _G.ConfigManager.character_special_cfg[self.StandActionName[index].sid]
        if cfg and #cfg.acoustics > 0 and not _G.AudioManager.CheckIsPlayWithKey(_G.AudioSaveKey.Npc) then
            local path = cfg.acoustics[_G.GetRandomNum(1, #cfg.acoustics)]
            _G.AudioManager.Dialogue_PlayPathWithKey(path, _G.AudioSaveKey.Npc)
        end
    end
end

---播放其他闲置动画回调
function WorldNPCItem:PlayeIdleAnimCall(name)
    _G.AnimatorPlayEndCallback.RemoveCallback(_G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE())
    self.StandActionTimer = nil
    if self.AnimName == name then
        self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
    end
end

---播放动画
function WorldNPCItem:PlayAnimByName(name, isCallBack)
    if not name then
        return
    end
    self.super.super.PlayAnimByName(self, name, isCallBack)
    if name == _G.WorldManager.AnimNames.IDLE or name == _G.WorldManager.AnimNames.Stand then
        self:StartStandActionTimer()
    else
        self:StopStandActionTimer()
    end
end

---检测是否为idle动画
function WorldNPCItem:CheckStandAction(name)
    if self.StandActionCount <= 0 then
        return false
    end
    for _, v in pairs(self.StandActionName) do
        if v.name == name then
            return true
        end
    end
    return false
end

--endregion
return WorldNPCItem
