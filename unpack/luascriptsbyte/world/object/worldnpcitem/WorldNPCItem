--region 触发器
function WorldNPCItem:OnClick()
    local radius = 0
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    ---@param isNode boolean item是不是障碍物 有无寻路节点
    if player then
        self.triggerAction = false
        local isArrival, isTooClose =
            player:GotoPoint(
            _G.Vector3.New(self.Transform:GetPosition()),
            function()
                if not self.isInteracted then
                    self.NavStepMoveOverPosCheck(
                        player,
                        _G.Vector3.New(player.Transform:GetPosition()),
                        _G.Vector3.New(self.Transform:GetPosition()),
                        _G.handler(self, self.NpcDoEvent)
                    )
                end
            end,
            nil,
            self.Cfg.ActionRadius,
            true
        )
        if not isArrival and not isTooClose then
            local fun
            fun = function(param)
                radius = radius + param
                if not isArrival and not isTooClose then
                    local x, y, z = self.Transform:GetPosition()
                    local pos = player:GetClosestPointByTwoTarget(x, y, z, radius)
                    isArrival, isTooClose =
                        player:GotoPoint(
                        pos,
                        function()
                            if not self.isInteracted then
                                self:NpcDoEvent()
                            end
                        end,
                        nil,
                        self.Cfg.ActionRadius,
                        true
                    )
                end
                if isTooClose then
                    return
                end
                if isArrival or radius > self.Cfg.ActionRadius then
                    return
                else
                    fun(0.1)
                end
            end
            fun(0.1)
        end
        --点击NPC 不显示自动寻路
        _G.Events:GetInstance():Broadcast(_G.eNav.HideFlag, player.Uid)
    end
end

---子触发器碰撞
---@param isEnter boolean 是否是进入
---@param tarInstId number 碰撞到的物体InstId
---@param tarObj UnityEngine.GameObject 碰撞到的物体
---@param luaObj WorldBaseItem 碰撞到的物体Lua对象
function WorldNPCItem:NodeTriggerEvent(isEnter, tarInstId, tarObj, luaObj)
    if not self:CheckPlayerClickTarget() then
        return
    end
    self:SetPlayerClickTargetNil()
    if luaObj.Uid == _G.WorldManager:GetInstance():GetCurWorldPlayer().Uid then
        if self.Cfg.LookAtTarget then
            if isEnter then
                self:LookAtItemByUid(luaObj.Uid)
            else
                self:LookAtItemByUid()
            end
        end
        if #self.Cfg.shader_type > 0 and not self.isInteracted then
            if self.ObjectMod then
                local r = self.Cfg.shader_type[1] and self.Cfg.shader_type[1] or 255
                local g = self.Cfg.shader_type[2] and self.Cfg.shader_type[2] or 255
                local b = self.Cfg.shader_type[3] and self.Cfg.shader_type[3] or 255
                self.World.CommonEff:SetSelectState(self.ObjectMod, isEnter, r, g, b)
            end
        end
    end
end

-----行为触发
---@param isEnter boolean 是否是进入
---@param tarInstId number 碰撞到的物体InstId
---@param tarObj UnityEngine.GameObject 碰撞到的物体
---@param luaObj WorldBaseItem 碰撞到的物体Lua对象
function WorldNPCItem:NodeActionTriggerEvent(isEnter, tarInstId, tarObj, luaObj)
    -- if not self:CheckPlayerClickTarget() then
    --     return
    -- end
    self:SetPlayerClickTargetNil()
    if not isEnter then
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
        self:StartStandActionTimer()
    end
    if not self.Enable then
        return
    end
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    --和主角发生碰撞
    if tarInstId == player.InstID then
        if isEnter then
            self.IsPlayerEnter = true
            if self.Cfg.TriggerType == 1 then --靠近触发
                self:NpcDoEvent()
                self.triggerAction = true
                _G.EventManager:GetInstance():AddEventDoneListener(self.EventDoneLister, self)
            elseif self.Cfg.TriggerType == 2 then --交互触发
                if self:CheckInteractioned() then
                    _G.WorldItemManager:GetInstance():OpenInteractedView(
                        _G.WorldItemType.NPC,
                        function()
                            self.triggerAction = false
                            self:NpcDoEvent()
                            self.triggerAction = true
                        end,
                        self.Transform
                    )
                end
            end
        else
            self.IsPlayerEnter = false
            self.triggerAction = false
            _G.WorldItemManager:GetInstance():CloseInteractedView(_G.WorldItemType.NPC, self.Transform)
        end
    end
end

function WorldNPCItem:TriggerEvent(isEnter, tarInstId, tarObj)
    ---特殊处理一下公告版，要碰撞，但是不做显隐
    if self.Uid == 707010810 then
        return
    end
    local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld():GetCanmeraPosBox()
    if sceneCamera then
        if tarInstId == sceneCamera:GetInstanceIDE() then
            self:ShowOrHideChild(isEnter)
            if isEnter then
                _G.WorldManager:GetInstance():GetCurWorld():AddCameraPosBoxItem(self)
            else
                _G.WorldManager:GetInstance():GetCurWorld():RemoveCameraPosBoxItem(self)
            end
        end
