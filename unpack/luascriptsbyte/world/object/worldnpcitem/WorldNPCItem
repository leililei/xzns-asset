local NpcActionType = {
    None = 0,
    Bubble = 1,
    Dialogue = 2,
    -- Battle = 3,
    VIew = 4,
    -- HP = 5,
    RoomEvent = 6
}

local ActionFunction = {
    [NpcActionType.None] = function(self)
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
    end,
    ---头顶冒气泡
    [NpcActionType.Bubble] = function(self)
        local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        player:NavInterruptMove()
        local clickParams = self.Cfg.ClickParams
        if clickParams == nil or #clickParams == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError("头顶冒气泡 clickParams nil or zero length", "<color=red>" .. ">>>" .. "</color>")
            end
        else
            self:PlayActionAnimation()
            ---随机选择一个配置的气泡id
            _G.HUDUtilities.ShowHudID(_G.tonumber(clickParams[_G.GetRandomNum(1, #clickParams)]))
        end
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
        self:ContinueCfgMove()
    end,
    ---进行对话
    [NpcActionType.Dialogue] = function(self)
        local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        player:NavInterruptMove()
        local clickParams = self.Cfg.ClickParams
        if clickParams == nil or #clickParams == 0 then
            self:ContinueCfgMove()
            require "ChapterModel":GetInstance():SetBehavioralPriority(false)
        else
            self:PlayActionAnimation()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
            _G.StoryManager:GetInstance():PlayDialogueView(
                _G.tonumber(clickParams[1]),
                function()
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                    WorldUtils.SetIdleDialogueSaved(self.Uid, clickParams[1])
                    --通知头顶提示刷新
                    WorldUtils.UpdateWorldItemTip(self.Uid)
                    self:ContinueCfgMove()
                    require "ChapterModel":GetInstance():SetBehavioralPriority(false)
                    self.Dialogue = false
                end
            )
        end
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
    end,
    ---直接打开功能界面
    [NpcActionType.VIew] = function(self)
        local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        player:NavInterruptMove()
        local clickParams = _G.DeepCopyCfgTable(self.Cfg.ClickParams)
        if clickParams == nil or #clickParams == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("直接打开功能界面 clickParams nil or zero length", "<color=red>" .. ">>>" .. "</color>")
            end
            self:ContinueCfgMove()
        else
            self:PlayAnimByName()
            local name = _G.table.remove(clickParams, 1)
            local function OnViewOpen(self, vname)
                if name == vname then
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnViewOpen, self)
                    self:ContinueCfgMove()
                end
            end
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnViewOpen, self)
            if name == "AfkView" then
                if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Afk) then
                    local curSid = require "AfkModel":GetInstance():GetCurSection()
                    if require "AfkModel":GetInstance():CheckSectionIsEnd(curSid) then
                        _G.PopWindowManager:GetInstance():ShowAllTips(210108)
                        return
                    end
                    if not require "AfkModel":GetInstance():CheckNextSectionCondition(true) then
                        return
                    end
                    _G.Events:GetInstance():Broadcast(_G.eGuideEvent.WorldObjRespond)
                    require("AfkBattleManager"):GetInstance():EnterEmbattle()
                else
                    _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(_G.FunctionID.Afk)
                end
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                _G.UIManager:GetInstance():OpenWindow(name, clickParams)
            end
        end
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
    end,
    ---房间事件
    [NpcActionType.RoomEvent] = function(self)
        if self.isInteracted then
            self:ContinueCfgMove()
            _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
            return
        end
        self:PlayActionAnimation()
        _G.ChapterRoomManager:GetInstance():TriggerRoomEvent(
            self.ItemData.EnterFightId,
            _G.handler(self, self.NpcDoEventDone)
        )
    end
}

