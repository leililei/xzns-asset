---初始化
function WorldNPCItem:Init()
    self.triggerAction = false
    self.isInteracted = false

    base.LoadObject(self)
    self.TaskTipType = WorldData.EWorldItemTipType.None
    self.StandActionTime =
        _G.ConfigManager.discrete_cfg[103202][1][1] and _G.ConfigManager.discrete_cfg[103202][1] or {10, 20}
    self:InitStandActionName()
end

function WorldNPCItem:InitStandActionName()
    self.StandActionName = {}
    self.StandActionCount = 0
    local cfg = _G.ConfigManager.character_special_cfg
    if not _G.table.isEmptyOrNil(self.Cfg.display_xiuxian) then
        self.StandActionName = _G.DeepCopyCfgTable(self.Cfg.display_xiuxian)
        self.StandActionCount = #self.Cfg.display_xiuxian
        for i = 1, self.StandActionCount do
            local data = {sid = self.Cfg.display_xiuxian[i]}
            if cfg[data.sid] then
                data.name = cfg[data.sid].display_xiuxian
            end
            self.StandActionName[i] = data
        end
    end
end

function WorldNPCItem:Dispose()
    self.triggerAction = nil
    self.isInteracted = nil
    if self.NpcTimer then
        self.NpcTimer:Stop()
        self.NpcTimer = nil
    end
    self.TaskTipType = nil
    -- self.AllNode = nil
    self.TaskSign = nil
    self.FunctionSign = nil
    self.StandActionName = nil
    self:StopStandActionTimer()
    self.StandActionTime = nil
    _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
end

---加载资源完成
function WorldNPCItem:OnLoadResObjComplete()
    local name
    if self.Cfg then
        if self.Cfg.Name ~= 0 then
            name = _G.GetLangPackValue(self.Cfg.Name)
        end
    else
        if self.ItemData.Name then
            name = self.ItemData.Name
        end
    end
    if not _G.string.IsNullOrEmpty(name) then
        name = "<color=#98c1ff>" .. name .. "</color>"
        if self.Cfg.OverheadDescription > 0 then
            local tag = _G.GetLangPackValue(self.Cfg.OverheadDescription)
            if not _G.string.IsNullOrEmpty(tag) then
                name = tag .. "\n" .. name
            end
        end
        self.ItemData.role_name = name
        self:InitTitle(name)
    end
    --新增模型的缩放设置
    local scale = self.Cfg.Scale or 1
    self.Transform:SetLocalScaleXYZ(scale)
    if self.TitleTransform then
        scale = 1 / scale
        self.TitleTransform:SetLocalScaleXYZ(scale)
    end
    if not self.isInteracted then
        self:AddTriggerComponent(
            function()
                base.OnLoadResObjComplete(self)
            end
        )
    else
        base.OnLoadResObjComplete(self)
    end
end

