function WorldNPCItem:ShowOrHide(show, force)
    base.ShowOrHide(self, show, force)
    if not _G.IsNil(self.TaskSign) then
        _G.GameUtil.SetActiveByCondition(self.TaskSign, show)--self.curSetEnable)
    end
end

function WorldNPCItem:OnGameObjShow()
    if not self.ObjectMod then
        return
    end
    if not self.isInteracted and self.Cfg.Params[1] == NpcActionType.RoomEvent then --房间事件
        self.isInteracted = _G.ChapterRoomManager:GetInstance():CheckNpcEventDone(self.ItemData.EnterFightId)
    end
    if self.isInteracted then
        self:PlayInteractedActionEndCall()
    else
        self:CheckInitState()
    end
    ---开启闲置动作播放倒计时
    if not self.AnimComponent.animator then
        self:StopStandActionTimer()
    else
        self:StartStandActionTimer()
    end
    base.OnGameObjShow(self)
    if not _G.table.isEmptyOrNil(self.AllNode) then
        local WorldItemManagerIns = _G.WorldItemManager:GetInstance()
        WorldItemManagerIns:RegiestWorldItemEvent(ItemEvent.interactionBoxStart, self.StopCfgMove, self)
        WorldItemManagerIns:RegiestWorldItemEvent(ItemEvent.interactionBoxEnd, self.ContinueCfgMove, self)
    end
end

function WorldNPCItem:OnGameObjHide()
    self:StopStandActionTimer()
    base.OnGameObjHide(self)
    if not _G.table.isEmptyOrNil(self.AllNode) then
        local WorldItemManagerIns = _G.WorldItemManager:GetInstance()
        WorldItemManagerIns:UnRegiestWorldItemEvent(ItemEvent.interactionBoxStart, self.StopCfgMove, self)
        WorldItemManagerIns:UnRegiestWorldItemEvent(ItemEvent.interactionBoxEnd, self.ContinueCfgMove, self)
    end
end
function WorldNPCItem:OnEnterWorld()
    if not _G.IsNil(self.ObjectMod) then
        return
    end
    --更新头顶提示
    WorldUtils.UpdateWorldItemTip(self.Uid)
    ---添加Update
    self:StartUpdateMove()
    base.OnEnterWorld(self)
end

function WorldNPCItem:OnExitWorld(leaveWorld)
    _G.WorldItemManager:GetInstance():CloseInteractedView(_G.WorldItemType.NPC, self.Transform)
    base.OnExitWorld(self)
    if self.FightTipHud then
        self.FightTipHud:Destroy()
        self.FightTipHud = nil
    end
    if self.StandUpdateFunc then
        self.StandUpdateFunc:Stop()
        self.StandUpdateFunc = nil
    end
    self.TaskTipType = WorldData.EWorldItemTipType.None
    self:RemoveTaskSign()
    ---在切换场景移除回调
    _G.AnimatorPlayEndCallback.RemoveCallback(_G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE())
    if leaveWorld then
        _G.EventManager:GetInstance():RemoveEventDoneListener(self.EventDoneLister, self)
    end
end

