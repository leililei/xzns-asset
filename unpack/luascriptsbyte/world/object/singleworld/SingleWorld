function SingleWorld:ChangeCameraBattle(change)
    if _G.string.IsNullOrEmpty(self.Cfg.Camera_Type1) then --判定是否有战斗相机配置数据
        return
    end
    local fov
    local posx, posy, posz, rotationx, rotationy, rotationz, rotationw
    local fogSetting
    if not self.normalCamera then
        self.normalCamera =
            self.SceneObject:FindE("Cameras/" .. self.Cfg.Camera_Type2 .. "/Camera"):GetComponentE(
            _G.typeof(_G.CS.UnityEngine.Camera)
        )
    end
    if not self.battleCamera then
        self.battleCamera =
            self.SceneObject:FindE("Cameras/" .. self.Cfg.Camera_Type1 .. "/Camera"):GetComponentE(
            _G.typeof(_G.CS.UnityEngine.Camera)
        )
    end
    if change then
        fogSetting = self.battleCamera:GetComponentE(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentFogSetting))
        posx, posy, posz = self.battleCamera:GetPosition()
        rotationx, rotationy, rotationz, rotationw = self.battleCamera:GetRotation()
        fov = self.battleCamera.fieldOfView
    else
        fogSetting = self.normalCamera:GetComponentE(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentFogSetting))
        posx, posy, posz = self.normalCamera:GetPosition()
        rotationx, rotationy, rotationz, rotationw = self.normalCamera:GetRotation()
        fov = self.normalCamera.fieldOfView
    end
    if fogSetting then
        fogSetting:SetFog()
    end
    self.normalCamera:SetActiveE(not change and 1 or 0)
    self.battleCamera:SetActiveE(change and 1 or 0)
    --根据不同camera选择不同的后处理文件
    local battleCameraStr = change and self.Cfg.Camera_Type1 or self.Cfg.Camera_Type2
    local num = string.match(battleCameraStr, "%d+")
    local environment = self.SceneObject:FindE("Environment")
    for i = 1, environment:GetChildCountE() do
        local childName = environment:GetChildE(i - 1):GetName()
        if string.contains(childName, "Post Processing_") then
            if string.replace(childName, "Post Processing_", "") == num then
                environment:GetChildE(i - 1).gameObject:SetActiveE(1)
            else
                environment:GetChildE(i - 1).gameObject:SetActiveE(0)
            end
        end
    end
    self.WorldSetting.SceneCamera:SetCameraParams(posx, posy, posz, rotationx, rotationy, rotationz, rotationw, fov)
    self.WorldSetting.SceneCamera:UpdatePos(false)
end
return SingleWorld
