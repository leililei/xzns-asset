---清理模型
function WorldBasePlayer:ClearObjectModel()
    if _G.IsNil(self.ObjectMod) then
        return
    end
    self:ShowShadow()
    if self.ItemData and self.ItemData.IsInShadow then
        _G.GraphicsManager.Instance:SetTargetDarken(self.ObjectMod, 0)
    end
    self:RemoveCommonEffect()

    if not _G.IsNil(self.ObjectMod) then
        _G.DestroyImmediate(self.ObjectMod)
        self.ObjectMod = nil
    end

    if not _G.IsNil(self.TitleTransform) then
        _G.DestroyImmediate(self.TitleTransform)
        self.TitleTransform = nil
    end

    self.ObjectModActive = false
    self.TitleTransformActive = false
    self.FootEffectActive = false
end
---创建模型
function WorldBasePlayer:CreateObjectModel()
    if self.loadModelObj or not _G.IsNil(self.ObjectMod) then
        return
    end
    if self.Cfg and not _G.string.IsNullOrEmpty(self.Cfg.Res) then
        self.loadModelObj = true
        local loadfunc = function(tran)
            self.loadModelObj = nil
            if _G.IsNil(self.Transform) then
                tran:DestroyObject()
                return
            end
            self:InitObjectModel(tran)
        end
        local model_Path = self.Cfg.Res
        if _G.string.contains(model_Path, "/") then
            -- if _G.DownloadPlayManager:GetInstance():IsInRemotePackage(model_Path) then
            --     if not _G.DownloadPlayManager:GetInstance():IsABDownloaed(model_Path) then
            --         --策划给的id,默认模型显示
            --         model_Path = _G.ConfigManager.object_world_cfg[707010168].Res
            --     end
            -- end
            model_Path = _G.ConfigManager.object_world_cfg[707010168].Res
            require("CardInfoManager").GetRole(
                model_Path,
                _G.ePoolType.World,
                self.Transform,
                _G.RoleEffTypeEnum.Main,
                loadfunc
            )
            
        else
            local trans = _G.WorldManager:GetInstance():GetItemGameObj(model_Path)
            loadfunc(trans)
        end
    end
end
