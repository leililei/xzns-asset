function WorldBasePlayer:SetRandomPos()
    local posCfg = _G.ConfigManager.discrete_cfg[103506]
    local random = _G.Mathf.Random(1, #posCfg)
    local x, y, z =
        _G.CS.UnityObjectExtends.GetRandomPointByR(
        posCfg[random][1],
        posCfg[random][2],
        posCfg[random][3],
        posCfg[random][4]
    )
    self.Transform:SetLocalPosition(x, y, z)
end
---更新地狱道头衔
function WorldBasePlayer:UpdateHell(id)
    if _G.IsNil(self.TitleTransform) then
        return
    end
    local path = require "HellRoadManager":GetInstance():GetHellImage(id)
    local go_table = _G.GetAutoGoTable(self.TitleTransform)
    if _G.string.IsNullOrEmpty(path) then
        _G.GameUtil.SetActiveByCondition(go_table.aorrawimage_hell, false)
    else
        go_table.aorrawimage_hell:LoadImage(
            path,
            function(obj)
                obj:SetNativeSize()
                local x, y = obj:GetRectTransformSizeDelta()
                obj:SetRectTransformSize(x * 1.5, y * 1.5)
            end
        )
        _G.GameUtil.SetActiveByCondition(go_table.aorrawimage_hell, true)
    end
end

return WorldBasePlayer
