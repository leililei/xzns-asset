---移除效果
function WorldBasePlayer:RemoveCommonEffect()
    if not _G.IsNil(self.ObjectMod) then
        self.World.CommonEff:SetSelectState(self.ObjectMod, false)
        --还原渲染状态
        local renders = self.ObjectMod:GetComponentsInChildren(_G.typeof(_G.Renderer))
        if not _G.IsNil(renders) then
            local len = renders.Length - 1
            for i = 0, len do
                local render = renders[i]
                if not _G.IsNil(render) and not _G.IsNil(render.sharedMaterial) then
                    render.sharedMaterial:SetFloat("_ShadowArea", 0)
                    render.shadowCastingMode = _G.CS.UnityEngine.Rendering.ShadowCastingMode.On
                end
            end
        end
    end
end
function WorldBasePlayer:ShowOrHide(show, force)
    if force then
        self.OriginalShowState = show
    end
    -- if show == self.curSetEnable then
    --     return
    -- end
    base.ShowOrHide(self, show and self.OriginalShowState)
    if not _G.WorldManager:GetInstance():CheckCurSceneType(_G.SceneType.MainWorld) then
        if not _G.IsNil(self.TitleTransform) then
            _G.GameUtil.SetActiveByCondition(self.TitleTransform, show and self.OriginalShowState)
        --self.curSetEnable)
        end
    end
    if show and self.OriginalShowState then --self.curSetEnable then
        if self.ObjShowTimer then
            self.ObjShowTimer:Stop()
            self.ObjShowTimer = nil
        end
        self.ObjShowTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnGameObjShow, self, true, true):Start()
    else
        if self.ObjShowTimer then
            self.ObjShowTimer:Stop()
            self.ObjShowTimer = nil
        end
        self:OnGameObjHide()
    end
end
function WorldBasePlayer:OnGameObjShow()
end
function WorldBasePlayer:OnGameObjHide()
end
function WorldBasePlayer:Reset()
    if _G.IsNil(self.ObjectMod) then
        if not self.ItemData.IsHidden then
            self:OnEnterWorld()
        else
            self:OnExitWorld()
        end
    else
        self:ShowOrHide(not self.ItemData.IsHidden)
    end
end
function WorldBasePlayer:OnEnterWorld()
    self:InitPosition()
    self:CreateObjectModel()
end
-----退出世界时调用，由子类重写
function WorldBasePlayer:OnExitWorld()
    self:ClearObjectModel()
    base.OnExitWorld(self)
end
---清理item节点下的对象
function WorldBasePlayer:DisWorldItem()
    _G.NavManager:GetInstance():DeleteNavItemByUid(self.Uid, true)
    self:RemoveNavUpdateMove()
    self:RemoveUpdateMoveFunction()
    if self.Transform then
        _G.DestroyObject(self.Transform)
    end
    self:Dispose()
end
