local base = require "WorldBaseItem"

---@class WorldBarrierItem:WorldBaseItem	障碍物
---@field Cfg ObjectWorldCfg_Item 障碍物配置
---@field Enable boolean 可用
local WorldBarrierItem = _G.BaseClass("WorldBarrierItem", base)
local Barrier = {
    [1687602641] = true,
    [1687602642] = true,
    [1687602643] = true,
    [1687602644] = true
}
function WorldBarrierItem:OnLoadResObjComplete()
    self:SetTriggerEnable(false)
    local dicTab = self.ItemData.InitPoint
    local points = dicTab[1]
    local navObstacle = self.Transform:AddComponentE(_G.typeof(_G.CS.UnityEngine.AI.NavMeshObstacle))
    navObstacle.size = _G.Vector3(points.s_x, points.s_y, points.s_z)
    navObstacle.carving = true
    if Barrier[self.Uid] then
        self.OriginalShowState = false
    end
    base.OnLoadResObjComplete(self)
    self.Transform:SetColliderEnable(0)
end
function WorldBarrierItem:OnExitWorld()
end
function WorldBarrierItem:OnGameObjShow()
end
function WorldBarrierItem:OnGameObjHide()
end
function WorldBarrierItem:CreateObjectModel()
    self:ShowOrHide(true)
end
return WorldBarrierItem
