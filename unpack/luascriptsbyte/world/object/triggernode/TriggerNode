---@field Name string Trigger的名称
---@field Collider UnityEngine.BoxCollider|UnityEngine.CapsuleCollider|SphereCollider 自身的Collider
---@field AcceptItemType table<string,string> 可以接收触发的lua对象类型
---@field Parent WorldBaseItem 父节点
---@field ColliderType ColliderType
---@field CreateCallBack function
---@class TriggerNode:WorldBaseItem	子触发节点
local TriggerNode = _G.BaseClass("TriggerNode")

local CS = _G.CS
local typeof = _G.typeof
local iskindof = _G.iskindof

---@field SphereCollider CS.UnityEngine.SphereCollider
---@field CapsuleCollider CS.UnityEngine.CapsuleCollider
---@field BoxCollider CS.UnityEngine.BoxCollider
---@class ColliderType

TriggerNode.ColliderType = {
    SphereCollider = typeof(CS.UnityEngine.SphereCollider),
    CapsuleCollider = typeof(CS.UnityEngine.CapsuleCollider),
    BoxCollider = typeof(CS.UnityEngine.BoxCollider)
}

---@field Name string Trigger的名称
---@field Parent WorldBaseItem 父物体
---@field ResPath string 资源路径
---@field ColliderType ColliderType 触发类型
---@field AcceptItemType WorldPlayerItem|WorldNPCItem 可接收的触发对象类型,AcceptItemType为nil接收所有类型
---@field CallBack fun(trigger:TriggerNode) 创建结束后的回调，用于设置Collider参数
---@class TriggerNodeCreateArgs
function TriggerNode:__init()
    self.AcceptItemType = {}
end
function TriggerNode:Dispose()
    self.AcceptItemType = nil
end
---初始化
---@param args TriggerNodeCreateArgs 父节点
---@param accept table[] 可以接收的碰撞类型
function TriggerNode:Init(args, accept)
    for i = 1, #accept do
        self.AcceptItemType[accept[i]] = true
    end
    self:LoadNodeObject(args.ResPath, args.Parent.Transform)
end

--单纯的加入一个节点,具体什么功能由子类实现
---@param res_path string 根节点资源路径
---@param parent UnityEngine.Transform 父节点
function TriggerNode:LoadNodeObject(res_path, parent)
    res_path = res_path or "CommonPrefab/World/EmptyPoint"
    _G.PoolsManager:GetInstance():Spawn(
        res_path,
        _G.ePoolType.World,
        _G.IsNil(parent) and self.Transform or parent,
        function(tran)
            self.Transform = tran
            self.InstID = tran:GetInstanceIDE()
            self:OnLoadNodeObject()
        end
    )
end

function TriggerNode:OnLoadNodeObject()
    _G.WorldCsListener.AddTriggerCall(self.InstID, _G.handler(self, self.TriggerEvent))
    -- self.Transform:AddComponentE(typeof(CS.WorldItemControl))
    self.Collider = self.Transform:AddComponentE(self.AddColliderType)
    if self.CreateCallBack then
        self:CreateCallBack()
    end
    self.CreateCallBack = nil
end

--region Collider参数

---设置自身触发器开关
---@param isEnable boolean 开关
function TriggerNode:SetTriggerEnable(isEnable)
    self.Transform:SetColliderEnable(isEnable and 1 or 0)
end

---设置SphereCollider参数
---@param center UnityEngine.Vector3 center
---@param radius number radius
function TriggerNode:SetSphereColliderArgs(centerX, centerY, centerZ, radius)
    if self.AddColliderType ~= self.ColliderType.SphereCollider then
        if _G.AppSetting.DEBUG then
            _G.LogError("self.AddColliderType ~= self.ColliderType.SphereCollider")
        end
        return
    end
    self.Collider:SetSphereCollider(centerX, centerY, centerZ, radius)
end

---设置CapsuleCollider参数
---@param center UnityEngine.Vector3 center
---@param radius number radius
---@param height number height
function TriggerNode:SetCapsuleColliderArgs(centerX, centerY, centerZ, radius, height)
    if self.AddColliderType ~= self.ColliderType.CapsuleCollider then
        if _G.AppSetting.DEBUG then
            _G.LogError("self.AddColliderType ~= self.ColliderType.CapsuleCollider")
        end
        return
    end
    self.Collider:SetCapsuleCollider(centerX, centerY, centerZ, radius, height)
end

---设置BoxCollider参数
---@param center UnityEngine.Vector3 center
---@param size UnityEngine.Vector3 size
function TriggerNode:SetBoxColliderArgs(centerX, centerY, centerZ, sizeX, sizeY, sizeZ)
    if self.AddColliderType ~= self.ColliderType.BoxCollider then
        if _G.AppSetting.DEBUG then
            _G.LogError("self.AddColliderType ~= self.ColliderType.BoxCollider")
        end
        return
    end
    self.Collider:SetBoxCillder(centerX, centerY, centerZ, sizeX, sizeY, sizeZ)
end
--endregion

---设置父物体的响应
---@field callBack fun(isEnter:boolean,tarInstId:number,tarInstId:tarObj,luaObj:WorldBaseItem)
function TriggerNode:SetTriggerEvent(callBack)
    self.ParentNodeTriggerEvent = callBack or nil
end

---碰撞
---@param isEnter boolean 中文描述
---@param tarInstId number 碰撞到的物体InstId
---@param tarObj UnityEngine.GameObject 碰撞到的物体
---@param luaObj WorldBaseItem 碰撞到的物体Lua对象
function TriggerNode:TriggerEvent(isEnter, tarInstId, tarObj, luaObj)
    if next(self.AcceptItemType) == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=20>" .. "TriggerNode   没有固定响应对象类型 " .. "</size></color>")
        end
    else
        local __cname = luaObj.__cname
        if not self.AcceptItemType[__cname] then
            return
        end
        if self.ParentNodeTriggerEvent then
            self.ParentNodeTriggerEvent(isEnter, tarInstId, tarObj, luaObj)
        end
    end
end

function TriggerNode:DestroySelf()
    _G.PoolsManager:GetInstance():Despawn(self.Transform, _G.ePoolType.World)
    _G.WorldCsListener.RemoveTriggerCall(self.InstID)
end

---创建一个子触发器
---@param args TriggerNodeCreateArgs
---@return TriggerNode
function TriggerNode.Create(args, world)
    if args.Parent and iskindof(args.Parent, "BaseItem") then
        if args.Name == nil then
            _G.LogFatal("Name == nil")
        end
        if args.Parent.DynamicTriggerNode[args.Name] then
            _G.LogFatal("存在重复的名称")
        end
        local obj = TriggerNode.New()
        obj.Name = args.Name
        obj.AddColliderType = args.ColliderType
        obj.CreateCallBack = args.CallBack
        args.Parent:AddDynamicTriggerNode(obj)
        obj:Init(args, args.AcceptItemType)
        return obj
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("TriggerNode.Create Error")
        end
        return nil
    end
end

return TriggerNode
