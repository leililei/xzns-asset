---开始闲置动画计时器
function WorldOtherPlayerItem:StartStandActionTimer()
    if not self.StandActionCount or self.StandActionCount <= 0 then
        return
    end
    if self.StandActionTimer then
        self:StopStandActionTimer()
    end
    self.StandActionTimer =
        _G.TimerManager:GetInstance():GetTimer(
        _G.Mathf.Random(self.StandActionTime[1], self.StandActionTime[2]),
        self.PlayeIdleAnim,
        self,
        true,
        false,
        true
    )
    self.StandActionTimer:Start()
end

--region 公会定时移动
function WorldOtherPlayerItem:OpenSociatyTimer()
    self.isCopy = true
    if self.sociatyTimer then
        self.sociatyTimer:Stop()
        self.sociatyTimer = nil
    end
    self.posRange = _G.ConfigManager.discrete_cfg[101615]
    self.sociatyTimer =
        _G.TimerManager:GetInstance():GetTimer(
        _G.math.random(_G.ConfigManager.discrete_cfg[101616][1][1], _G.ConfigManager.discrete_cfg[101616][1][2]),
        self.SociatyMove,
        self,
        true,
        false,
        true
    )
    self.sociatyTimer:Start()
end
---开始进行移动
function WorldOtherPlayerItem:SociatyMove()
    local x, y, z = self.Transform:GetPosition()
    self:UpdateMovePosition(_G.WorldUtils.PosToPoint({x = x, y = y, z = z}))
    self.sociatyDelay =
        _G.math.random(_G.ConfigManager.discrete_cfg[101617][1][1], _G.ConfigManager.discrete_cfg[101617][1][2])
    while self.sociatyDelay > 0 do
        local endPos = self:GetNextPos(x, y, z)
        if endPos then
            x = endPos.x
            y = endPos.y
            z = endPos.z
            self:UpdateMovePosition(_G.WorldUtils.PosToPoint(endPos))
        end
    end
end

---获取下次移动的位置（公会使用）
function WorldOtherPlayerItem:GetNextPos(x, y, z)
    local math = _G.math
    local isMoveX = _G.math.random(0, 2) > 1 and true or false
    local isRight = math.abs(x - self.posRange[1][1]) < math.abs(x - self.posRange[2][1])
    local isUp = math.abs(x - self.posRange[1][3]) < math.abs(x - self.posRange[2][3])
    local endPos = {x = x, y = y, z = z}
    if isMoveX then
        local endValue = self.posRange[1][1]

        if isRight then
            endValue = self.posRange[2][1]
        end
        local offset = self.sociatyDelay * self.MoveSpeed
        local endZ = math.random(self.posRange[2][3] * 100, self.posRange[1][3] * 100) / 100
        local move = _G.Vector3.Distance(_G.Vector3.New(x, y, z), _G.Vector3(endValue, y, endZ))
        if move > offset then
            self.sociatyDelay = 0
            local angle = math.floor(math.atan(math.abs(endZ - z), math.abs(endValue - x)) / math.pi * 180)
            endPos.x = offset * math.cos(math.rad(angle)) + x
            endPos.z = offset * math.sin(math.rad(angle)) + z
            if isRight then
                endPos.x = x - offset * math.cos(math.rad(angle))
            else
                endPos.x = x + offset * math.cos(math.rad(angle))
            end
            if isUp then
                endPos.z = z - offset * math.sin(math.rad(angle))
            else
                endPos.z = z + offset * math.sin(math.rad(angle))
            end
            return endPos
        else
            self.sociatyDelay = self.sociatyDelay - move / self.MoveSpeed
            return {x = endValue, y = y, z = endZ}
        end
    else
        local endValue = self.posRange[1][3]
        if isUp then
            endValue = self.posRange[2][3]
        end
        local offset = self.sociatyDelay * self.MoveSpeed
        local endX = math.random(self.posRange[2][1] * 100, self.posRange[1][1] * 100) / 100
        local move = _G.Vector3.Distance(_G.Vector3.New(x, y, z), _G.Vector3(endX, y, endValue))
        if move > offset then
            self.sociatyDelay = 0
            local angle = math.floor(math.atan(math.abs(endValue - z), math.abs(endX - x)) / math.pi * 180)
            if isRight then
                endPos.x = x - offset * math.sin(math.rad(90 - angle))
            else
                endPos.x = x + offset * math.sin(math.rad(90 - angle))
            end
            if isUp then
                endPos.z = z - offset * math.cos(math.rad(90 - angle))
            else
                endPos.z = z + offset * math.cos(math.rad(90 - angle))
            end
            return endPos
        else
            self.sociatyDelay = self.sociatyDelay - move / self.MoveSpeed
            return {x = endX, y = y, z = endValue}
        end
    end
end

function WorldOtherPlayerItem:TriggerEvent(isEnter, tarInstId, tarObj)
    local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld():GetCanmeraPosBox()
    if sceneCamera then
        if tarInstId == sceneCamera:GetInstanceIDE() then
            self:ShowOrHideChild(isEnter)
            if isEnter then
                _G.WorldManager:GetInstance():GetCurWorld():AddCameraPosBoxItem(self)
            else
                _G.WorldManager:GetInstance():GetCurWorld():RemoveCameraPosBoxItem(self)
            end
        end
    end
end

function WorldOtherPlayerItem:ShowOrHideChild(show)
    --self.curSetEnable = show
    if show then
        if not self.FootEffectActive and self.footEffect then
            self.footEffect:SetActiveE(1)
            self.FootEffectActive = true
        end
        if not self.TitleTransformActive and self.TitleTransform then
            self.TitleTransform:SetActiveE(1)
            self.TitleTransformActive = true
        end
        if not self.ObjectModActive and self.ObjectMod then
            self.ObjectMod:SetActiveE(1)
            self.ObjectModActive = true
            base.CheckMoveing(self)
        end
    else
        if self.FootEffectActive and self.footEffect then
            self.footEffect:SetActiveE(0)
            self.FootEffectActive = false
        end
        if self.TitleTransformActive and self.TitleTransform then
            self.TitleTransform:SetActiveE(0)
            self.TitleTransformActive = false
        end
        if self.ObjectModActive and self.ObjectMod then
            self.ObjectMod:SetActiveE(0)
            self.ObjectModActive = false
        end
    end
end

