function WorldOtherPlayerItem:ShowOrHide(show, force)
    if show == true then
        --- 对话中 不显示其他玩家  防止新上线的玩家 显示出来
        local IdHide = _G.StoryManager:GetInstance():GetIdHideOtherPlayer()
        if IdHide == true then
            base.ShowOrHide(self, false)
            return
        end
    end
    base.ShowOrHide(self, show, force)
    if show and self.isChangeModel and self.Transform:GetctiveInHierarchy() == 1 then
        self:PlayAnimByName(_G.WorldManager.AnimNames.IDLE)
        self.setTitlePosTimer = _G.TimerManager:GetInstance():GetTimer(2, self.SetTitlePos, self, true)
        self.setTitlePosTimer:Start()
        self.isChangeModel = false
    end
end

function WorldOtherPlayerItem:OnGameObjShow()
    self:StartStandActionTimer()
    self:ChangeCityRole(self.changeSkinID)
    self:ChangeTitle(self.changeTitleID)
    self:ChangeEffect(self.changeCircleID)
    if self.isCopy then
        local x =
            _G.math.random(_G.ConfigManager.discrete_cfg[101615][2][1], _G.ConfigManager.discrete_cfg[101615][1][1])
        local z =
            _G.math.random(_G.ConfigManager.discrete_cfg[101615][2][3], _G.ConfigManager.discrete_cfg[101615][1][3])
        self.Transform:SetPosition(x, 0, z)
        self:OpenSociatyTimer()
    end
end

function WorldOtherPlayerItem:OnGameObjHide()
    self:StopStandActionTimer()
    if self.sociatyTimer then
        self.sociatyTimer:Stop()
        self.sociatyTimer = nil
    end
end

function WorldOtherPlayerItem:OnExitWorld()
    ---清除动画的回调
    _G.AnimatorPlayEndCallback.RemoveCallback(_G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE())
    base.OnExitWorld(self)
    _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.UpdateMove, self)
    if self.stopMoveToNextNodeCoroutine then
        coroutine.stopwaiting(self.stopMoveToNextNodeCoroutine)
        self.stopMoveToNextNodeCoroutine = nil
    end
    if self.stopMoveAllNodeCoroutine then
        coroutine.stopwaiting(self.stopMoveAllNodeCoroutine)
        self.stopMoveAllNodeCoroutine = nil
    end
    self:StopStandActionTimer()
    ---清除公会计时器
    if self.sociatyTimer then
        self.sociatyTimer:Stop()
        self.sociatyTimer = nil
    end
    if self.titleTimer then
        self.titleTimer:Stop()
        self.titleTimer = nil
    end
end

