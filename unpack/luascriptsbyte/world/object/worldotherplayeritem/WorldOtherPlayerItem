local base = require "WorldBasePlayer"

---@class WorldOtherPlayerItem:WorldBaseItem
---@field public MoveSendDuration number 当玩家移动时，和服务器通信的周期
---@field public WorldCameraControl WorldCameraControl 摄像机控制器
---@field public FixPoint number 错误移动时的玩家修复位置,二进制UV数据
---@field ItemData WorldPlayerData
---@field isCopy boolean 是否为镜像玩家(尽在)
local WorldOtherPlayerItem = _G.BaseClass("WorldOtherPlayerItem", base)

--region 创建与销毁
function WorldOtherPlayerItem:Init()
    self.MoveSpeed = self.ItemData.MoveSpeed
    self.AllNode = {}
    self.StandActionTime =
        _G.ConfigManager.discrete_cfg[103202][1][1] and _G.ConfigManager.discrete_cfg[103202][1] or {10, 20}
    self.isCopy = false
    self.isFirst = true
    self.isChangeModel = true
    self.DataType = _G.WorldItemDataType.Player
    base.Init(self)
end

function WorldOtherPlayerItem:Dispose()
    _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.UpdateMove, self)
    if self.stopMoveToNextNodeCoroutine then
        _G.coroutine.stopwaiting(self.stopMoveToNextNodeCoroutine)
        self.stopMoveToNextNodeCoroutine = nil
    end
    if self.stopMoveAllNodeCoroutine then
        _G.coroutine.stopwaiting(self.stopMoveAllNodeCoroutine)
        self.stopMoveAllNodeCoroutine = nil
    end
    self.AllNode = nil
    self:StopStandActionTimer()
end

---玩家进入刷新数据
---@param point number 格子
function WorldOtherPlayerItem:RefreshPostionOnEnter(point)
    local v3 = {x = 0, y = 0, z = 0}
    v3.x, v3.y, v3.z = self.Transform:GetLocalPosition()
    local nowPoint = _G.WorldUtils.PosToPoint(v3)
    if nowPoint == point then
        return
    end
    local newPos = _G.WorldUtils.PointToPos(point, true)
    self.Transform:SetLocalPosition(newPos.x, newPos.y, newPos.z)
end

---初始化闲置动画
function WorldOtherPlayerItem:InitStandActionName()
    self.StandActionName = {}
    self.StandActionCount = 0
    if self.ItemData.skin <= 0 then
        return
    end
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.ItemData.skin]
    if cfg then
        for k, v in pairs(cfg.display_click) do
            self.StandActionCount = self.StandActionCount + 1
            self.StandActionName[self.StandActionCount] = {sid = self:GetActionSid(v), name = v}
        end
    end
end
---获取动作sid
function WorldOtherPlayerItem:GetActionSid(name)
    local cfg = _G.ConfigManager.character_special_cfg
    for _, v in pairs(cfg) do
        if v.display_xiuxian == name then
            return v.id
        end
    end
    return nil
end

--endregion

function WorldOtherPlayerItem:InitPosition()
    --设置玩家的位置。
    local data = self.ItemData
    local pos, move = _G.WorldUtils.CaculateLocalPos(data.start_point, data.end_point, data.start_time, self.MoveSpeed)
    self.Transform:SetLocalPosition(pos.x, pos.y, pos.z)
    --判定是否开启移动
    if move then
        self:UpdateMovePosition(self.ItemData.end_point)
    elseif self.isFirst then
        self:SetRandomPos()
    end
    self.isFirst = nil
end

function WorldOtherPlayerItem:SetRandomPos()
    if _G.WorldManager:GetInstance():GetCurWorld().Cfg.Sid ~= 600 then
        base.SetRandomPos(self)
    else
        self.Transform:SetLocalPositionToZero()
    end
end

---添加效果
function WorldOtherPlayerItem:AddCommonEffect()
    self:UpdateEffect()
end

---移除动效
function WorldOtherPlayerItem:RemoveCommonEffect()
    if not _G.IsNil(self.Halo) then
        _G.DestroyObject(self.Halo)
        self.Halo = nil
    end
    if self.haloTimer then
        self.haloTimer:Stop()
        self.haloTimer = nil
    end
end

