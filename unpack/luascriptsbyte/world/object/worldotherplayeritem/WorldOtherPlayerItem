function WorldOtherPlayerItem:ChangeCityRole(id)
    -- if not self.curSetEnable then
    --     self.changeSkinID = id
    --     return
    -- end

    if not self.ObjectModActive then
        self.changeSkinID = id
        return
    end
    if not id or self.ItemData.skin == id then
        return
    end
    ---@type card_cfg
    local cfg = require "CardCommentManager":GetInstance():GetCfgs(id)
    if cfg then
        self.ItemData.skin = id
        self.ItemData.rolePath = cfg.ModelPathLow
        self:ClearObjectModel()
        self.Cfg.Res = cfg.ModelPathLow
        self.isChangeModel = true
        self:CreateObjectModel()
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到对应的模型配置 card_cfg   sid=" .. id)
        end
    end
end
