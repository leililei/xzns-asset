---@param moveStep number 移动状态
function WorldOtherPlayerItem:Move(moveStep)
    self.MoveStep = moveStep
    if moveStep == 0 then
        if self.stopMoveAllNodeCoroutine then
            coroutine.stopwaiting(self.stopMoveAllNodeCoroutine)
            self.stopMoveAllNodeCoroutine = nil
        end
        self.PlayAnimByName(self, _G.WorldManager.AnimNames.IDLE)
    else
        --self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
        if self.World.Cfg.Scene_Type == _G.SceneType.MainWorld then
            --todo 别的玩家设置动作
            -- local param = _G.ConfigManager.discrete_cfg[100003][1]
            -- if table.indexof(param, self.Sid) == false then
            --     self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
            -- else
            --     self.PlayAnimByName(self, _G.WorldManager.AnimNames.WALK)
            -- end
            self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
        elseif self.World.Cfg.Scene_Type == _G.SceneType.Section then
            self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
        elseif self.World.Cfg.Scene_Type == _G.SceneType.Sociaty then
            -- self:SetSpeed(3)
            self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
        else
            self.PlayAnimByName(self, _G.WorldManager.AnimNames.MOVE)
        end
    end
end
---@param end_point number 到达的点
---获取新的终点
function WorldOtherPlayerItem:UpdateMovePosition(end_point)
    local fPos, tPos
    if (#self.AllNode > 0) then
        fPos = self.AllNode[#self.AllNode].to
    else
        local v3 = {x = 0, y = 0, z = 0}
        v3.x, v3.y, v3.z = self.Transform:GetLocalPosition()
        fPos = v3
    end
    tPos = _G.WorldUtils.PointToPos(end_point, true)
    table.insert(
        self.AllNode,
        {
            from = fPos,
            to = tPos
        }
    )
    if #self.AllNode > 0 then
        if nil == self.stopMoveAllNodeCoroutine then
            self.stopMoveAllNodeCoroutine = coroutine.start(_G.handler(self, self.MoveAllNodeCoroutine))
        end
    end
end
---移动完所有的点
function WorldOtherPlayerItem:MoveAllNodeCoroutine()
    local Distance = _G.Vector3.Distance
    while #self.AllNode > 0 do
        local from = self.AllNode[1].from
        local to = self.AllNode[1].to
        local delay = Distance(from, to) / self.MoveSpeed
        self:NavDirection(to)
        self:Move(1)
        coroutine.waitforseconds(delay)
        table.remove(self.AllNode, 1)
    end
    self:Move(0)
    if self.isCopy then
        self:OpenSociatyTimer()
    end
end
---通过路线来设置方向
---@param to UnityEngine.Vector3
function WorldOtherPlayerItem:NavDirection(to)
    --是否有完整路线
    local isNode = _G.CS.UnityObjectExtends.CalculatePath(self.Transform, to.x, to.y, to.z, self.NavNodes)
    if isNode then
        if self.stopMoveToNextNodeCoroutine then
            coroutine.stopwaiting(self.stopMoveToNextNodeCoroutine)
            self.stopMoveToNextNodeCoroutine = nil
        end
        self.stopMoveToNextNodeCoroutine = coroutine.start(_G.handler(self, self.MoveToNextNodeCoroutine))
    else
        self.NavNodes:ClearCorners()
    end
end
---移动到指定位置方向
function WorldOtherPlayerItem:MoveToNextNodeCoroutine()
    local index = 1
    local corners = self.NavNodes.corners
    local len = corners.Length
    while index < len do
        local to = corners[index]
        local delay = self.Transform:SetDirection(to.x, to.y, to.z, self.MoveSpeed)
        coroutine.waitforseconds(delay)
        index = index + 1
    end
end
---玩家移动
function WorldOtherPlayerItem:UpdateMove()
    if self.MoveStep ~= 0 then
        self.Transform:SetForwardPosition(self.MoveSpeed, 1, 1)
    end
end
