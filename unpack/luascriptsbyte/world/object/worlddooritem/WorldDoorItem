local base = require "WorldBaseItem"
---@class WorldDoorItem:WorldBaseItem	传送门
---@field Cfg ObjectWorldCfg_Item 本传送门配置
---@field Enable boolean 可用
local WorldDoorItem = _G.BaseClass("WorldDoorItem", base)

local lockEffectIndex = {
    lockEffect = 1,
    unLockAniEffect = 2,
    normalEffect = 3
}

local ParamsIndex = {
    curSceneID = 3,
    toSceneID = 2,
    toDoorID = 1
}

---初始化
function WorldDoorItem:Init()
    base.Init(self)
end

function WorldDoorItem:Dispose()
    if not _G.IsNil(self.lockEffectObj) then
        self.lockEffectObj:DestroyObject()
        self.createLockEffectTag = nil
    end
    self.lockEffectObj = nil
end

function WorldDoorItem:OnLoadResObjComplete()
    self.Cfg = _G.ConfigManager.object_world_cfg[self.ItemData.Sid]
    if self.Cfg.Name ~= 0 then
        local name = _G.GetLangPackValue(self.Cfg.Name)
        self.ItemData.role_name = name
        self:InitTitle(name)
    end
    self:CreateNormalEffect()
    base.OnLoadResObjComplete(self)
end

function WorldDoorItem:OnEnterWorld()
    local Collider = self.Transform:GetComponentE(_G.typeof(_G.Collider))
    if nil ~= self.Cfg.ActionRadius and self.Cfg.ActionRadius ~= 0 then
        Collider.radius = self.Cfg.ActionRadius
    else
        Collider.radius = 0
    end
    if not _G.IsNil(self.normalEffectObj) then
        _G.GameUtil.SetActiveByCondition(self.normalEffectObj, true)
    end
    if self.createLockEffectTag then
        self:CreateLockEffect()
    end
    base.OnEnterWorld(self)
end
function WorldDoorItem:OnExitWorld()
    if not _G.IsNil(self.lockEffectObj) then
        self.lockEffectObj:DestroyObject()
    end
    base.OnExitWorld(self)
end

--region 锁定相关

---创建普通特效
function WorldDoorItem:CreateNormalEffect()
    if
        #self.Cfg.ActionEffect <= 0 or #self.Cfg.ActionEffect[1] < lockEffectIndex.normalEffect or
            _G.string.IsNullOrEmpty(self.Cfg.ActionEffect[1][lockEffectIndex.normalEffect])
     then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[self.Cfg.ActionEffect[1][lockEffectIndex.normalEffect]],
        self.Transform,
        function(trans)
            if _G.IsNil(self.Transform) then
                trans:DestroyObject()
                return
            end
            self.normalEffectObj = trans
            _G.GameUtil.SetActiveByCondition(self.normalEffectObj, _G.IsNil(self.lockEffectObj))
        end
    )
end

---创建锁定特效
function WorldDoorItem:CreateLockEffect()
    if
        #self.Cfg.ActionEffect <= 0 or #self.Cfg.ActionEffect[1] < lockEffectIndex.lockEffect or
            _G.string.IsNullOrEmpty(self.Cfg.ActionEffect[1][lockEffectIndex.lockEffect])
     then
        return
    end
    self.createLockEffectTag = true
    if not _G.IsNil(self.lockEffectObj) then
        self.lockEffectObj:SetActiveE(1)
        if not _G.IsNil(self.normalEffectObj) then
            _G.GameUtil.SetActiveByCondition(self.normalEffectObj, false)
        end
        return
    end
    if self.createLockEffEctIng then
        return
    end
    self.createLockEffEctIng = true
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[self.Cfg.ActionEffect[1][lockEffectIndex.lockEffect]],
        self.Transform,
        function(trans)
            self.createLockEffEctIng = nil
            if _G.IsNil(self.Transform) then
                trans:DestroyObject()
                return
            end
            self.lockEffectObj = trans
            if not _G.IsNil(self.normalEffectObj) then
                _G.GameUtil.SetActiveByCondition(self.normalEffectObj, false)
            end
        end
    )
end
-----播放解锁特效
function WorldDoorItem:PlayUnLockEffect()
    if
        #self.Cfg.ActionEffect <= 0 or #self.Cfg.ActionEffect[1] < lockEffectIndex.unLockAniEffect or
            _G.string.IsNullOrEmpty(self.Cfg.ActionEffect[1][lockEffectIndex.unLockAniEffect])
     then
        return
    end
    local cfg = _G.ConfigManager.ui_effect_cfg[self.Cfg.ActionEffect[1][lockEffectIndex.unLockAniEffect]]
    _G.UIUtils.LoadEffectByCfg(
        cfg,
        self.Transform,
        function()
            --传送门解锁音效
            require("AudioManager").PlayAudioByAudioCfgID(5002)
            if not _G.IsNil(self.lockEffectObj) then
                self.lockEffectObj:DestroyObject()
                self.createLockEffectTag = nil
            end
        end,
        function()
            if not _G.IsNil(self.normalEffectObj) then
                _G.GameUtil.SetActiveByCondition(self.normalEffectObj, true)
            end
        end
    )
end
--endregion

--region 触发
---触发事件
---@param isEnter boolean True：进入；False：离开
---@param tarInstId number 碰撞物体InstID
---@param tarObj UnityEngine.GameObject 碰撞物体
function WorldDoorItem:TriggerEvent(isEnter, tarInstId, tarObj)
    if not self:CheckPlayerClickTarget() then
        return
    end
    self:SetPlayerClickTargetNil()
    if not self.Enable then
        return
    end
    if isEnter then
        if tarInstId == _G.WorldManager:GetInstance():GetCurWorldPlayer().InstID then
            local sceneSid = self.Cfg.Params[ParamsIndex.curSceneID]
            local toSceneSid = self.Cfg.Params[ParamsIndex.toSceneID]
            local toDoorSid = self.Cfg.Params[ParamsIndex.toDoorID]
            if self.ItemData.EnterFightId and self.ItemData.EnterFightId > 0 then --房间传送
                ---如果当前已经存在正在交互的事件(目前仅针对巡逻机器人打开对话事件) 返回
                if require "ChapterModel":GetInstance():CheckDoingEvent() then
                    return
                end
                _G.ChapterRoomManager:GetInstance():ChangeRoom(self.ItemData.EnterFightId, toDoorSid)
                return
            else
                if toSceneSid == 0 or sceneSid == toSceneSid then -- 场景内传送
                    local doorModel = require("WorldItemManager"):GetInstance():GetModelByType(_G.WorldItemType.Door)
                    doorModel:OnPassDoor(toDoorSid)
                    --延时一帧开启触发器判定，避免在两个传送门之间来回传送
                    coroutine.start(
                        function()
                            _G.coroutine.waitforendofframe()
                            local doorModel =
                                require("WorldItemManager"):GetInstance():GetModelByType(_G.WorldItemType.Door)
                            doorModel:SetAllDoorItemEnable(true)
                        end
                    )
                    return
                end
            end
            if toSceneSid ~= 0 then --切场景
                if toDoorSid ~= 0 then --切到对应的传送点
                    _G.WorldManager:GetInstance():SwitchScene(toSceneSid, nil, toDoorSid)
                else --没有固定的传送点
                    _G.WorldManager:GetInstance():SwitchScene(toSceneSid)
                end
            end
        end
    end
end
-----点击函数
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function WorldDoorItem:OnClick()
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    player:GotoPoint(_G.Vector3.New(self.Transform:GetPosition()))
end
--endregion

return WorldDoorItem
