local WorldBaseItem = require "WorldBaseItem"
---@class WorldSkillEffectItem	中文描述
local WorldSkillEffectItem = _G.BaseClass("WorldSkillEffectItem", WorldBaseItem)

local colliderType = {
    sphere = 1,
    box = 2
}

---类的构造函数
function WorldSkillEffectItem:__init()
end

---类的析构函数
function WorldSkillEffectItem:Dispose()
end

function WorldSkillEffectItem:OnLoadResObjComplete()
    self:SetTriggerEnable(false)
    self.Transform:SetColliderEnable(0)
    self:OnEnterWorld()
end
function WorldSkillEffectItem:OnEnterWorld()
    self:InitPosition()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[self.Cfg.ActionEffect[1][1]],
        self.Transform,
        _G.handler(self, self.OnEffectCreate),
        _G.handler(self, self.OnEffectDispose)
    )
end
function WorldSkillEffectItem:OnEffectCreate()
    local delay = 2
    delay = self.Cfg.Params[delay]
    if delay and delay > 0 then
        self.delayTimer = _G.TimerManager:GetInstance():GetTimer(delay, self.Trigger, self, true)
        self.delayTimer:Start()
    else
        self:Trigger()
    end
end
function WorldSkillEffectItem:Trigger()
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    local x, y, z = player.Transform:GetPosition()
    local mx, my, mz = self.Transform:GetPosition()
    local ishurt = false
    local _type = 1
    local range = _G.tonumber(self.Cfg.ClickParams[1])
    if self.Cfg.Params[_type] == colliderType.sphere then
        if (x - mx) * (x - mx) + (z - mz) * (z - mz) <= range * range then
            ishurt = true
        end
    elseif self.Cfg.Params[_type] == colliderType.box then
        local ofx, ofy, ofz = self.Transform:GetRight()
        x = x - mx
        z = z - mz
        mx = x * ofx
        mz = z * ofz
        if (mx + mz) * (mx + mz) / (ofx * ofx + ofz * ofz) <= range * range then
            ofx, ofy, ofz = self.Transform:GetForward()
            mx = x * ofx
            mz = z * ofz
            my = _G.tonumber(self.Cfg.ClickParams[2])
            if (mx + mz) * (mx + mz) / (ofx * ofx + ofz * ofz) <= my * my then
                ishurt = true
            end
        end
    end
    if ishurt then
        -- player:SetTransformLock(true)
        -- _G.AnimatorPlayEndCallback.AddCallback(
        --     _G.IsNil(player.Transform) and 0 or player.Transform:GetInstanceIDE(),
        --     _G.handler(self, self.PlayHitActionEndCall)
        -- )
        -- player:PlayAnimByName("hit_1", true)
        _G.Events:GetInstance():Broadcast(_G.WorldItemManager.ItemEvent.skillEffectHurt)
    end
end
function WorldSkillEffectItem:PlayHitActionEndCall()
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    _G.AnimatorPlayEndCallback.RemoveCallback(
        _G.IsNil(player.Transform) and 0 or player.Transform:GetInstanceIDE(),
        _G.handler(self, self.PlayHitActionEndCall)
    )
    _G.WorldManager:GetInstance():GetCurWorldPlayer():SetTransformLock(false)
end
function WorldSkillEffectItem:OnEffectDispose()
    self.World:RemoveWorldItems(self.Uid)
end
function WorldSkillEffectItem:DisWorldItem()
    if self.delayTimer then
        self.delayTimer:Stop()
        self.delayTimer = nil
    end
    if not _G.IsNil(self.Transform) then
        _G.DestroyObject(self.Transform)
    end
    self:Dispose()
end

return WorldSkillEffectItem
