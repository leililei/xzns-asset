local base = require "WorldBaseItem"
---@class WorldGhostItem	中文描述
local WorldGhostItem = _G.BaseClass("WorldGhostItem", base)
local PrefabPath = {
    [1] = "Effect/Battle/FX_D_Scene/luochajie_effect/prefab/ef_youling_da",
    [2] = "Effect/Battle/FX_D_Scene/luochajie_effect/prefab/ef_youling_da_move",
    [3] = "Effect/Battle/FX_D_Scene/luochajie_effect/prefab/ef_youling_xiao",
    [4] = "Effect/Battle/FX_D_Scene/luochajie_effect/prefab/ef_youling_xiao_move"
}
local table = _G.table
local city_display_cfg = _G.ConfigManager.city_display_cfg
local GhostActionEnum = {HideAction = 1, IdleAction = 0}
---类的构造函数
---@field public HideMaxTime number 隐藏最大次数
---@field public HideDistance number 隐藏间隔
---@field public IdleMaxTime number 暂停最大次数
---@field public IdleTime number 暂停时间
---@field public IdleInterval number 暂停间隔
function WorldGhostItem:__init(info, data, world)
    self.GhostRoot = info.GhostRoot
    self:InitCfg()
    self:SetSpeedByCfg()
    self:SetRoutePoints(data.way)
end
function WorldGhostItem:SetSpeedByCfg()
    local moving_speeds = city_display_cfg[self.ItemData.way].moving_speed
    local moving_speed = math.random(1, #moving_speeds)
    self:SetSpeed(moving_speeds[moving_speed])
end
function WorldGhostItem:InitCfg()
    ---在出生点移动的路径index 区别于self.curCfgMoveIndex
    self.NewMoveIndex = 0
    self.GhostShow = false
    self.ActionQueue = {}
    self.isAction = false
    self.Cfg = {}
    self.Cfg.InteractionIcon = {}
    self.Cfg.Type1 = _G.WorldItemType.Ghost
    self.Cfg.hide_parameter = city_display_cfg[self.ItemData.way].hide_parameter
    self.HideMaxTime = self.Cfg.hide_parameter[2]
    self.HideMaxTime = self.Cfg.hide_parameter[2]
    self.HideDistance = self.Cfg.hide_parameter[1]
    self.HideInterval = self.Cfg.hide_parameter[3]
    self.Cfg.Idle_time = city_display_cfg[self.ItemData.way].pause_time
    self.IdleMaxTime = self.Cfg.Idle_time[3][1]
    self.IdleTime = self.Cfg.Idle_time[1]
    self.IdleInterval = self.Cfg.Idle_time[2][1]
    self:InitActionQueue()
end
---初始化幽灵行为队列 {消失==1,隐藏==0}
function WorldGhostItem:InitActionQueue()
    local _actionQueue = {}
    local actionCount = self.HideMaxTime + self.IdleMaxTime
    for i = 1, self.HideMaxTime do
        table.insert(_actionQueue, 1)
    end
    for i = 1, self.IdleMaxTime do
        table.insert(_actionQueue, 0)
    end
    local index
    local _actionCount = actionCount
    for i = 1, actionCount do
        index = math.random(1, _actionCount)
        table.insert(self.ActionQueue, table.remove(_actionQueue, index))
        _actionCount = _actionCount - 1
    end
end
---初始化
function WorldGhostItem:Init()
    self:LoadObject()
end
--region 加载和清理
---初始化和加载根节点
---@param res_path string 根节点资源路径
function WorldGhostItem:LoadObject()
    _G.PoolsManager:GetInstance():Spawn(
        "CommonPrefab/World/ItemRootPrefab",
        _G.ePoolType.World,
        self.GhostRoot,
        function(tran)
            self.Transform = tran
            self.InstID = tran:GetInstanceIDE()
            self.World.AllWorldItemsByInstId[self.InstID] = self
            self.Transform:SetName(self.Uid)
            --self.Transform:SetColliderEnable(0)
            self:LoadResObj()
        end
    )
end
-----加载配置资源节点
function WorldGhostItem:LoadResObj()
    local res_path = PrefabPath[_G.math.random(1, #PrefabPath)]
    _G.PoolsManager:GetInstance():Spawn(
        res_path,
        _G.ePoolType.World,
        self.Transform,
        function(tran)
            self.ObjectMod = tran
            self.ObjectMod:SetActiveE(0)
            self:OnLoadResObjComplete()
        end
    )
end
---根据幽灵出生点计算幽灵移动路径
---@param item_data WorldItemData
---@param lineIndex number 轨道id
---@return table[][] 路径keyPoint
function WorldGhostItem:SetRoutePoints(id)
    local startPos = self.ItemData.InitPoint
    local x = startPos[1].p_x
    local z = startPos[1].p_z
    local RoutePoints = {[1] = {Point = {}}}

    local key_points = _G.DeepCopyCfgTable(city_display_cfg[id].key_points)
    ---出生点是否在关键点上
    if x == key_points[1][1] then
        if z == key_points[1][2] then
            self.NewMoveIndex = 1
        elseif z == key_points[2][2] then
            self.NewMoveIndex = 2
        end
    elseif x == key_points[3][1] then
        if z == key_points[3][2] then
            self.NewMoveIndex = 3
        elseif z == key_points[4][2] then
            self.NewMoveIndex = 4
        end
    end
    if self.NewMoveIndex == 0 then
        if x == key_points[1][1] then
            self.NewMoveIndex = 2
        elseif x == key_points[3][1] then
            self.NewMoveIndex = 4
        elseif z == key_points[1][2] then
            self.NewMoveIndex = 1
        elseif z == key_points[2][2] then
            self.NewMoveIndex = 3
        end
    end
    for i = 1, #key_points do
        local Point = {}
        Point.x = key_points[i][1]
        Point.y = 1
        Point.z = key_points[i][2]
        if i == 1 then
            Point.forceHide = true
            Point.speed =
                math.abs(
                (key_points[#key_points][1] - key_points[1][1]) + (key_points[#key_points][2] - key_points[1][2])
            )
        else
            Point.forceHide = false
            Point.speed = self.MoveSpeed
        end
        table.insert(RoutePoints[1].Point, Point)
    end
    self.ItemData.RoutePoints = RoutePoints
end
---当配置移动动画播放完成
---@param name string 动画名称
function WorldGhostItem:OnCfgMoveAniPlayEnd(name)
    if name == self.AllNode[self.curCfgMoveIndex].ani then
        self.curCfgMoveIndex = self.curCfgMoveIndex + 1
        if self.curCfgMoveIndex > #self.AllNode then
            self.curCfgMoveIndex = 1
        end
        self.GhostShow = not self.AllNode[self.curCfgMoveIndex].forceHide
        self:SetSpeed(self.AllNode[self.curCfgMoveIndex].speed)
        self.cfgMoveDelay =
            self.Transform:SetDirection(
            self.AllNode[self.curCfgMoveIndex].x,
            self.AllNode[self.curCfgMoveIndex].y,
            self.AllNode[self.curCfgMoveIndex].z,
            self.MoveSpeed
        )
        self:Move(1, self.MoveSpeed)
    end
end

---配置帧移动
function WorldGhostItem:UpdateMove()
    self:StartGhostAction()
    if self.MoveStep == 0 then
        return
    end
    if self.cfgMoveDelay and self.cfgMoveDelay <= 0 then
        self:Move(0)
        self:OnCfgMoveAniPlayEnd(nil)
    else
        self.cfgMoveDelay = self.cfgMoveDelay - _G.Time.deltaTime
        self.Transform:SetDirection(
            self.AllNode[self.curCfgMoveIndex].x,
            self.AllNode[self.curCfgMoveIndex].y,
            self.AllNode[self.curCfgMoveIndex].z,
            self.MoveSpeed
        )
        self.Transform:SetForwardPosition(self.MoveSpeed, 0, 1)
    end
end

---设置显示物体根节点状态
---@param isShow number GhostActionEnum
---@param isEnd boolean
function WorldGhostItem:DoAction(GhostAcion, isEnd)
    if self.Transform ~= nil then
        if GhostAcion == GhostActionEnum.HideAction then
            self.GhostShow = isEnd
        elseif GhostAcion == GhostActionEnum.IdleAction then
            self.GhostShow = true
            self:Move(isEnd and 1 or 0)
        end
        if isEnd then
            self.isAction = false
        end
    end
end
---移除物体移动
function WorldGhostItem:RemoveUpdateMoveFunction()
    if self.UpdateMoveFunction then
        _G.UpdateManager:GetInstance():RemoveUpdate(self.UpdateMoveFunction, self)
        self.UpdateMoveFunction = nil
    end
end
--region 配置移动
---初始化配置移动
function WorldGhostItem:InitCfgMove()
    if not self.ItemData.IsMove then
        return
    end
    if self.ItemData.RoutePoints[1] == nil then
        return
    end
    if self.AllNode and #self.AllNode > 0 then
        if self.NewMoveIndex > 0 then
            self.curCfgMoveIndex = self.NewMoveIndex
        else
            self.curCfgMoveIndex = 1
        end
        return
    end
    self.AllNode = {}
    local points = self.ItemData.RoutePoints[1].Point
    for i = 1, #points do
        _G.table.insert(
            self.AllNode,
            {
                x = points[i].x,
                y = points[i].y,
                z = points[i].z,
                ani = points[i].ani,
                speed = points[i].speed,
                forceHide = points[i].forceHide
            }
        )
    end
    if self.NewMoveIndex > 0 then
        self.curCfgMoveIndex = self.NewMoveIndex
    else
        self.curCfgMoveIndex = 1
    end
end
---继续配置移动
function WorldGhostItem:ContinueCfgMove()
    if not self.ItemData then
        return
    end
    if not self.ItemData.IsMove then
        return
    end
    if not self.AllNode or #self.AllNode <= 0 then
        return
    end
    self:SetSpeed(self.AllNode[self.curCfgMoveIndex].speed)
    self.MoveSpeed = self.AllNode[self.curCfgMoveIndex].speed
    self.cfgMoveDelay =
        self.Transform:SetDirection(
        self.AllNode[self.curCfgMoveIndex].x,
        self.AllNode[self.curCfgMoveIndex].y,
        self.AllNode[self.curCfgMoveIndex].z,
        self.MoveSpeed
    )
    self:Move(1, self.MoveSpeed)
end
---初始化位置
function WorldGhostItem:InitPosition()
    if self.ItemData.IsMove and self.AllNode and #self.AllNode > 0 then
        return
    end
    local dicTab = self.ItemData.InitPoint
    ---@type CS.YoukiaCore.Int2 points
    local points = dicTab[1]
    if points ~= nil then
        self.Transform:SetPosition(points.p_x, points.p_y, points.p_z)
        self.Transform:SetLocalEulerAngles(points.r_x, points.r_y, points.r_z)
    end
end
function WorldGhostItem:ShowOrHide(show)
    if _G.IsNil(self.Transform) then
        return
    end
    if show then
        --self.curSetEnable = self.GhostShow
        self.Transform:SetActiveE(self.GhostShow and 1 or 0)
    else
        --self.curSetEnable = show
        self.Transform:SetActiveE(0)
    end
end
function WorldGhostItem:OnGameObjHide()
end
function WorldGhostItem:OnGameObjShow()
end
function WorldGhostItem:EnterWorld()
    local generation_time = city_display_cfg[self.ItemData.way].generation_time
    local showTime = math.random(generation_time[1], generation_time[2])
    self.CreateTimer = _G.TimerManager:GetInstance():GetTimer(showTime, self.OnEnterWorld, self, true, false, true)
    self.CreateTimer:Start()
end
function WorldGhostItem:OnEnterWorld()
    if self.CreateTimer ~= nil then
        self.CreateTimer:Stop()
        self.CreateTimer = nil
    end
    self:InitPosition()
    self:InitCfgMove()
    self:ContinueCfgMove()
    self:CreateObjectModel()
    self:StartUpdateMove()
end
--- 幽灵行为
---@return ForceStopMove boolean 是否强行打断移动
function WorldGhostItem:StartGhostAction()
    if self.isAction then
        if self.ActionDoDelay then
            if self.ActionDoDelay <= 0 then
                self:StopAction()
            else
                self.ActionDoDelay = self.ActionDoDelay - _G.Time.deltaTime
            end
        end
    else
        if #self.ActionQueue > 0 and not self.isAction then
            local curaction = table.remove(self.ActionQueue, 1)
            self.curAction = curaction
            self:ActionHandle()
        end
    end
end
function WorldGhostItem:ActionHandle()
    self:StartAction()
end
function WorldGhostItem:StartAction()
    if self.isAction then
        return
    end
    self.isAction = true
    local interval = self.curAction == 1 and self.HideInterval or self.IdleInterval
    self.ActionTimer = _G.DelayDo(interval, _G.handler(self, self.OnActionTime))
end
function WorldGhostItem:OnActionTime()
    self:DoAction(self.curAction)
    if self.curAction == 1 then
        self.ActionDoDelay = self.HideDistance / self.MoveSpeed
    else
        local IdleInterval = math.random(self.IdleTime[1], self.IdleTime[2])
        self.ActionDoDelay = IdleInterval
    end
end

function WorldGhostItem:StopAction()
    if self.ActionTimer then
        _G.coroutine.stopwaiting(self.ActionTimer)
        self.ActionTimer = nil
    end
    self.ActionDoDelay = nil
    self:DoAction(self.curAction, true)
end
--- 寻路移动相关
---启动移动
function WorldGhostItem:StartUpdateMove()
    ---添加Update
    if not self.UpdateMoveFunction then
        self.UpdateMoveFunction = _G.handler(self, self.UpdateMove)
    end
    if not _G.UpdateManager:GetInstance():HasUpdate(self.UpdateMoveFunction, self) then
        _G.UpdateManager:GetInstance():AddUpdate(self.UpdateMoveFunction, self)
    end
end

---清理模型
function WorldGhostItem:ClearObjectModel()
    if _G.IsNil(self.ObjectMod) then
        return
    end
    if self.ItemData.IsInShadow then
        _G.GraphicsManager.Instance:SetTargetDarken(self.ObjectMod, 0)
    end
    self:RemoveCommonEffect()

    if not _G.IsNil(self.ObjectMod) then
        _G.DestroyImmediate(self.ObjectMod)
        self.ObjectMod = nil
    end
    if not _G.IsNil(self.TitleTransform) then
        _G.DestroyImmediate(self.TitleTransform)
        self.TitleTransform = nil
    end

    self.ObjectModActive = false
    self.TitleTransformActive = false
    self.FootEffectActive = false
end
function WorldGhostItem:OnExitWorld()
    --self:Dispose()
end
function WorldGhostItem:ClearAllCortinueAndTimer()
    if self.ActionTimer ~= nil then
        _G.coroutine.stopwaiting(self.ActionTimer)
        self.ActionTimer = nil
    end
    if self.CreateTimer ~= nil then
        self.CreateTimer:Stop()
        self.CreateTimer = nil
    end
end
function WorldGhostItem:Dispose()
    self:ClearAllCortinueAndTimer()
    base.Dispose(self)
end
---清理item节点下的对象
function WorldGhostItem:DisWorldItem()
    _G.NavManager:GetInstance():DeleteNavItemByUid(self.Uid, true)
    self:RemoveAllDynamicTriggerNode()
    self:RemoveNavUpdateMove()
    self:RemoveUpdateMoveFunction()
    _G.WorldCsListener.RemoveTriggerCall(self.InstID)
    if self.Transform then
        _G.DestroyObject(self.Transform)
    end
    self:Dispose()
end

function WorldGhostItem:TriggerEvent(isEnter, tarInstId, tarObj)
    local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld():GetCanmeraPosBox()
    if sceneCamera then
        if tarInstId == sceneCamera:GetInstanceIDE() then
            self:ShowOrHideChild(isEnter)
            if isEnter then
                _G.WorldManager:GetInstance():GetCurWorld():AddCameraPosBoxItem(self)
            else
                _G.WorldManager:GetInstance():GetCurWorld():RemoveCameraPosBoxItem(self)
            end
        end
    end
end

function WorldGhostItem:ShowOrHideChild(show)
    --self.curSetEnable = show
    if show then
        if not self.FootEffectActive and self.footEffect then
            self.footEffect:SetActiveE(1)
            self.FootEffectActive = true
        end
        if not self.TitleTransformActive and self.TitleTransform then
            self.TitleTransform:SetActiveE(1)
            self.TitleTransformActive = true
        end
        if not self.ObjectModActive and self.ObjectMod then
            self.ObjectMod:SetActiveE(1)
            self.ObjectModActive = true
        end
    else
        if self.FootEffectActive and self.footEffect then
            self.footEffect:SetActiveE(0)
            self.FootEffectActive = false
        end
        if self.TitleTransformActive and self.TitleTransform then
            self.TitleTransform:SetActiveE(0)
            self.TitleTransformActive = false
        end
        if self.ObjectModActive and self.ObjectMod then
            self.ObjectMod:SetActiveE(0)
            self.ObjectModActive = false
        end
    end
end

return WorldGhostItem
