require "BaseDynamicDisplayCondition"
require "DynamicDisplayConditionData"

local DynamicDisplayConditionTypeScriptMap = _G.DynamicDisplayConditionTypeScriptMap

---@class DynamicDisplayConidtionUtilies @动态显示条件工具类
local DynamicDisplayConidtionUtilies = {}

---根据参数创建一个对应类型的动态显示条件(动态显示条件创建统一入口)
---@param owneritemuid number @动态显示条件所属对象UID
---@param dynamicdisplaytype EDynamicDisplayType @动态显示类型
---@param dynamicdiplayconditiontype EDynamicDisplayCondition @动态显示条件
---@param conditionparam string @动态显示条件详细参数
---@return BaseDynamicDisplayCondition @对应任务内容
function DynamicDisplayConidtionUtilies.CreateDynamicDisplayCondition(
    owneritemuid,
    dynamicdisplaytype,
    dynamicdiplayconditiontype,
    conditionparam)
    if _G.AppSetting.DEBUG then
        _G.Log(
            string.format(
                "DynamicDisplayConidtionUtilies.CreateDynamicDisplayCondition(%s, %s, %s, %s)",
                owneritemuid,
                dynamicdisplaytype,
                dynamicdiplayconditiontype,
                conditionparam
            )
        )
    end
    if DynamicDisplayConditionTypeScriptMap[dynamicdiplayconditiontype] ~= nil then
        local realtaskconditionscriptpath =
            string.format(
            "World.Object.DynamicDisplayCondition.%s",
            DynamicDisplayConditionTypeScriptMap[dynamicdiplayconditiontype]
        )

        if _G.AppSetting.DEBUG then
            _G.Log(
                string.format(
                    "世界物体UID:%s,动态显示类型:%s,动态显示条件类型:%s,脚本路径:%s!",
                    owneritemuid,
                    dynamicdisplaytype,
                    dynamicdiplayconditiontype,
                    realtaskconditionscriptpath
                )
            )
        end
        local realtaskcondition = require(realtaskconditionscriptpath)
        local realtaskconditioninstance =
            realtaskcondition.New(owneritemuid, dynamicdisplaytype, dynamicdiplayconditiontype, conditionparam)
        return realtaskconditioninstance
    else
        if _G.AppSetting.DEBUG then
            _G.Log(string.format("未定义的动态显示条件类型:%s,创建动态显示条件对象失败!", dynamicdiplayconditiontype))
        end
        return nil
    end
end

---@type DynamicDisplayConidtionUtilies @动态显示条件工具类
_G.DynamicDisplayConidtionUtilies = DynamicDisplayConidtionUtilies
---@type DynamicDisplayConidtionUtilies @动态显示条件工具类
return DynamicDisplayConidtionUtilies
