local BaseDynamicDisplayCondition = _G.BaseClass("BaseDynamicDisplayCondition")
BaseDynamicDisplayCondition.OwnerItemUID = nil
BaseDynamicDisplayCondition.DynamicDisplayType = nil
BaseDynamicDisplayCondition.DynamicDisplayConditionType = nil

---BaseDynamicDisplayCondition构造函数
---@param owneritemuid number @动态显示隐藏条件所属对象UID
---@param dynamicdisplaytype EDynamicDisplayType @动态显示类型
---@param dynamicdisplayconditiontype DynamicDisplayConditionType @动态显示条件类型
---@param conditionparams string @条件详细参数(上层统一传字符串，子类自行解析)
function BaseDynamicDisplayCondition:__init(
    owneritemuid,
    dynamicdisplaytype,
    dynamicdisplayconditiontype,
    conditionparams)
    print("BaseDynamicDisplayCondition:__init()")
    self.OwnerItemUID = owneritemuid
    self.DynamicDisplayType = dynamicdisplaytype
    self.DynamicDisplayConditionType = dynamicdisplayconditiontype
    self:ParseParam(conditionparams)
end

---解析条件参数(子类重现实现特定参数解析)
---@param conditionparams string @条件详细参数
function BaseDynamicDisplayCondition:ParseParam(conditionparams)
end

---检查显示隐藏条件(子类重写实现特定条件判定)
---@return boolean @任务条件是否满足
function BaseDynamicDisplayCondition:CheckCondition(...)
    return true
end

---@type BaseDynamicDisplayCondition @动态显示隐藏条件基类
_G.BaseDynamicDisplayCondition = BaseDynamicDisplayCondition

---@type BaseDynamicDisplayCondition
return BaseDynamicDisplayCondition
