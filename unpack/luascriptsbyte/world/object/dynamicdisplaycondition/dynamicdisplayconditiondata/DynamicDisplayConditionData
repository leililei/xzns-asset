---Note:
---所有动态显示条件类型以及动态显示条件类型和对应脚本的映射都定义在这里

---@class EDynamicDisplayType @动态显示类型
---@field DynamicShow number @动态显示
---@field DynamicHide number @动态隐藏
local EDynamicDisplayType = {
    DynamicShow = 0,
    DynamicHide = 1
}

---@type EDynamicDisplayType
_G.EDynamicDisplayType = EDynamicDisplayType

local EDynamicDisplayConditionSource = {
    "TaskSubmitedCondition",
    "StoryIDPlayedCondition"
}

---@class EDynamicDisplayCondition @动态显示类型定义
---@field TaskSubmitedCondition number @任务ID提交条件
---@field StoryIDPlayedCondition number @剧情ID已播放条件
_G.EDynamicDisplayCondition = _G.CreatEnumTable(EDynamicDisplayConditionSource, 0)

---Note:
---动态显示条件类型和对应脚本名的映射
---取名规则：EDynamicDisplayConditionSource里的对应定义)
---@class DynamicDisplayConditionScriptMap @任务条件类型与脚本名映射Map
local dynamicdisplayconditionscriptmap = {}
for k, v in pairs(_G.EDynamicDisplayCondition) do
    dynamicdisplayconditionscriptmap[v] = k
    -- print(string.format("动态显示条件类型:%d,动态显示条件对应脚本名:%s", v, dynamicdisplayconditionscriptmap[v]))
end
---@type DynamicDisplayConditionTypeScriptMap @任务类型与脚本名映射Map
_G.DynamicDisplayConditionTypeScriptMap = dynamicdisplayconditionscriptmap
