require "BaseDynamicDisplayCondition"

---@class TaskSubmitedCondition : BaseDynamicDisplayCondition @任务提交刷新显示条件
---@field TaskIdsSubmitedRequired number[] @要求已提交的任务ID列表
local TaskSubmitedCondition = _G.BaseClass("TaskSubmitedCondition", _G.BaseDynamicDisplayCondition)
TaskSubmitedCondition.TaskIdsSubmitedRequired = nil

---TaskSubmitedCondition构造函数
---@param owneritemuid number @动态显示隐藏条件所属对象UID
---@param dynamicdisplayconditiontype DynamicDisplayConditionType @动态显示条件类型
---@param conditionparams string @条件详细参数(上层统一传字符串，子类自行解析)
function TaskSubmitedCondition:__init(owneritemuid, dynamicdisplayconditiontype, conditionparams)
    _G.LogUtilities.Log(_G.EModuleName.TaskModule, "TaskSubmitedCondition:__init()")
end

---解析条件参数
---@param conditionparams string @条件详细参数
function TaskSubmitedCondition:ParseParam(conditionparams)
    self.TaskIdsSubmitedRequired = {}
    local taskssubmitedrequired = _G.string.split(conditionparams, "$")
    for k, v in ipairs(taskssubmitedrequired) do
        local taskidsubmitedrequired = tonumber(v)

        if _G.AppSetting.DEBUG then
            _G.Log(string.format("对象UID:%s动态显示任务提交条件ID:%s", self.OwnerItemUID, taskidsubmitedrequired))
        end
        table.insert(self.TaskIdsSubmitedRequired, taskidsubmitedrequired)
    end
end

---检查显示隐藏条件
---@return boolean @任务条件是否满足
function TaskSubmitedCondition:CheckCondition(...)
    for k, v in ipairs(self.TaskIdsSubmitedRequired) do
        if not _G.TaskModule:GetInstance():IsTaskIdSubmited(v) then
            if _G.AppSetting.DEBUG then
                _G.Log(string.format("任务ID:%s不符合任务ID提交条件,任务提交条件返回false!", v))
            end
            return false
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log("符合任务ID提交条件,任务提交条件返回true!")
    end
    return true
end

---@type TaskSubmitedCondition
return TaskSubmitedCondition
