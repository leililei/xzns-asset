local BesizerLineMove = _G.BaseClass("BesizerLineMove")
_G.BesizerLineMove = BesizerLineMove
local DeepCopy = _G.DeepCopy
local Vector3 = _G.Vector3

---@field public Target UnityEngine.Transform 移动的物体
---@field public BasePoint UnityEngine.Vector3[] 移动的路径点
---@field public Speed number 移动的speed
---@field public MoveEndCall function 移动的结束的回调
---@field public IsLoop boolean 是否循环移动
---@class BesizerMoveArgs 贝塞尔曲线移动函数参数

---@field public baseCount number 单次采样点计数
local baseCount = 50

local Ease = _G.CS.DG.Tweening.Ease

---创建一个零向量数组
---@param len number 中文描述
---@return UnityEngine.Vector3[] 中文描述
local function NewVector3Tbl(len)
    local tbl = {}
    for _ = 1, len do
        table.insert(tbl, Vector3.zero)
    end

    return tbl
end

---@param args BesizerMoveArgs 贝塞尔曲线移动函数参数
-- function BesizerLineMove:__init(target, point, speed, endCB)
function BesizerLineMove:__init(args)
    self.PassPoints = {}
    self.Target = args.Target
    self.BasePoint = args.BasePoint or {}
    self.Speed = args.Speed or 5
    self.Index = 0
    self.MoveEndCall = args.MoveEndCall or nil
    self.IsLoop = args.IsLoop

    if not self.Target then
        error("Target is nil")
    end

    if #self.BasePoint <= 0 then
        error("BasePoint is nil")
    end

    self:InitPoint()
    self.Tweener = self.Target:DOPath(self.PassPoints, 5):SetEase(Ease.Linear)

    if self.IsLoop then
        self.Tweener:SetLoops(-1)
    end

    if self.MoveEndCall then
        if self.IsLoop then
            self.Tweener:OnStepComplete(
                function()
                    self.MoveEndCall()
                end
            )
        else
            self.Tweener:OnComplete(
                function()
                    self.MoveEndCall()
                end
            )
        end
    end
end

