---初始化
function BesizerLineMove:InitPoint()
    local pointPos = NewVector3Tbl(#self.BasePoint)
    for index, value in ipairs(self.BasePoint) do
        pointPos[index] = value
    end
    self:GetTrackPoint(pointPos)
end

---根据设定节点 绘制指定的曲线
---@param track UnityEngine.Vector3[] 所有指定节点的信息
function BesizerLineMove:GetTrackPoint(track)
    local vector3s = self:PathControlPointGenerator(track)
    local SmoothAmount = #track * baseCount

    for i = 1, SmoothAmount do
        local pm = i / SmoothAmount
        local currPt = self:Interp(vector3s, pm)

        table.insert(self.PassPoints, currPt)
    end
end

---计算所有节点以及控制点坐标
---@param path UnityEngine.Vector3[] 所有节点的存储数组
---@return UnityEngine.Vector3
function BesizerLineMove:PathControlPointGenerator(path)
    local suppliedPath
    local vector3s
    suppliedPath = path
    local offset = 2
    vector3s = NewVector3Tbl(#suppliedPath + offset)

    for index, value in ipairs(suppliedPath) do
        vector3s[index + 1] = value
    end

    vector3s[1] = vector3s[2] + (vector3s[2] - vector3s[3])
    vector3s[#vector3s] = vector3s[#vector3s - 1] + (vector3s[#vector3s - 1] - vector3s[#vector3s - 2])

    if (vector3s[2] == vector3s[#vector3s - 1]) then
        local tmpLoopSpline = vector3s
        tmpLoopSpline[1] = tmpLoopSpline[#tmpLoopSpline - 2]
        tmpLoopSpline[#tmpLoopSpline] = tmpLoopSpline[3]
        vector3s = tmpLoopSpline
    end

    return vector3s
end

---计算曲线的任意点的位置
---@param pos UnityEngine.Vector3[]
---@param t number
---@return UnityEngine.Vector3
function BesizerLineMove:Interp(pos, t)
    local len = #pos - 3
    local currPt = math.min(math.floor(t * len), len - 1)
    local u = t * len - currPt
    currPt = currPt + 1

    local function ResetV3()
        local _a = DeepCopy(pos[currPt])
        local _b = DeepCopy(pos[currPt + 1])
        local _c = DeepCopy(pos[currPt + 2])
        local _d = DeepCopy(pos[currPt + 3])
        return _a, _b, _c, _d
    end

    local v1
    do
        local a, b, c, d = ResetV3()
        local _a = a:Mul(-1)
        local _b = b:Mul(3)
        local _c = c:Mul(-3)
        local _d = d

        v1 = _a:Add(_b)
        v1 = v1:Add(_c)
        v1 = v1:Add(_d)

        local _u = u * u * u
        v1 = v1:Mul(_u)
    end

    local v2
    do
        local a, b, c, d = ResetV3()
        local _a = a:Mul(2)
        local _b = b:Mul(-5)
        local _c = c:Mul(4)
        local _d = d:Mul(-1)
        local _u = u * u

        v2 = _a:Add(_b)
        v2 = v2:Add(_c)
        v2 = v2:Add(_d)

        v2 = v2:Mul(_u)
    end

    local v3
    do
        local a, _, c, _ = ResetV3()
        local _a = a:Mul(-1)
        v3 = _a:Add(c):Mul(u)
    end

    local v4
    do
        local _, b = ResetV3()
        v4 = b:Mul(2)
    end

    local target = v1:Add(v2):Add(v3):Add(v4)
    target = target:Mul(0.5)

    return target
end

