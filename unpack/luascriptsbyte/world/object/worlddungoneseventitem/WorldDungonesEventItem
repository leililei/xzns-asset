local base = require "WorldBaseItem"
---@class WorldDungonesEventItem	中文描述
local WorldDungonesEventItem = _G.BaseClass("WorldDungonesEventItem", base)

---类的构造函数
function WorldDungonesEventItem:__init(info, data)
end

---类的析构函数
function WorldDungonesEventItem:Dispose()
end

---初始化
function WorldDungonesEventItem:Init()
    base.LoadObject(self)
end

-----加载配置资源节点
function WorldDungonesEventItem:LoadResObj()
    base.InitPosition(self)
    base.CreateObjectModel(self)
    base.SetTriggerEnable(self, true)
    base.LoadResObj(self)
end

---加载资源完成
function WorldDungonesEventItem:OnLoadResObjComplete()
    self:AddTriggerComponent(
        function()
            local name
            if self.Cfg then
                if self.Cfg.Name ~= 0 then
                    name = _G.GetLangPackValue(self.Cfg.Name)
                end
            else
                if self.ItemData.Name then
                    name = self.ItemData.Name
                end
            end
            if name then
                self.ItemData.role_name = name
                self:InitTitle(name)
            end
            base.OnLoadResObjComplete(self)
        end
    )
end
---初始化头顶标题
---@param nameStr string 名字
function WorldDungonesEventItem:InitTitle(nameStr)
    _G.PoolsManager:GetInstance():Spawn(
        "CommonPrefab/World/Enemy_Title_NoEffect",
        _G.ePoolType.Default,
        self.World:GetTitleRoot(),
        function(title)
            local go_table = _G.GetAutoGoTable(title)
            self.TitleTransform = title
            self.TitleTextName = go_table.aortext_TextName
            self.TitleScaleRoot = go_table.trans_root
            self.TitleTextName.text = nameStr
            --self.TitleTransform:SetLocalPosition(1000, 1000, 1000)
            if self.Cfg.MonsterType == _G.HeroType.Elite then
                go_table.aorimage_title.SpriteName = "ui_jq_font_jingy"
            elseif self.Cfg.MonsterType == _G.HeroType.Boss then
                go_table.aorimage_title.SpriteName = "ui_jq_font_sl"
            else
                go_table.aorimage_title.SpriteName = "ui_jq_font_put"
            end
            if not self.titlePosY then
                self:SetTitlePos()
            end
            self.TitleTransform:SetActiveE(0)
        end
    )
end
---物体进入世界
function WorldDungonesEventItem:OnEnterWorld()
    _G.Events:GetInstance():AddListener(_G.WorldItemManager.ItemEvent.enemyBattleDone, self.OnEnemyBattleDone, self)
    --("怪物攻城，物体进入世界")
    base.OnEnterWorld(self)
end
---退出世界
function WorldDungonesEventItem:OnExitWorld()
    --("怪物攻城,退出世界")
    _G.Events:GetInstance():RemoveListener(_G.WorldItemManager.ItemEvent.enemyBattleDone, self.OnEnemyBattleDone, self)
    base.OnExitWorld(self)
end
function WorldDungonesEventItem:OnEnemyBattleDone(win, id)
    -- local sid = _G.ChapterRoomManager:GetInstance():GetRoomMonstergroupID(self.ItemData.EnterFightId)
    -- if sid == id then
    --     self:OnBattleEnd(true)
    -- end
    -- ("怪物攻城,战斗结束，播放死亡动画")
    if id == 10 then
        return
    end
    if win and self.ItemData.EnterFightId == id then
        self:OnBattleEnd(true)
        base.OnGameObjHide(self)
    end
end
function WorldDungonesEventItem:OnBattleEnd(success)
    if not success then
        return
    end
    _G.AnimatorPlayEndCallback.AddCallback(
        _G.IsNil(self.Transform) and 0 or self.Transform:GetInstanceIDE(),
        _G.handler(self, self.PlayDeathActionEndCall)
    )
    self:CheckInteractionEndState(true, _G.handler(self, self.PlayDeathActionEndCall))
end
---死亡动画
function WorldDungonesEventItem:PlayDeathActionEndCall()
    self.Transform:SetActiveE(0)
    self.TitleTransform:SetActiveE(0)
    _G.WorldManager:GetInstance():GetCurWorld():RemoveWorldItems(700000527 + self.ItemData.EnterFightId)
end
---交互 触发
function WorldDungonesEventItem:NodeActionTriggerEvent(isEnter, tarInstId, tarObj, luaObj)
    self.isEnter = false
    if isEnter then
        if self.isOpenView then
        else
            _G.WorldItemManager:GetInstance():OpenInteractedView(
                _G.WorldItemType.Enemy,
                function()
                    --("怪物攻城，回调方法")
                    -- self.triggerAction = false
                    -- self:NpcDoEvent()
                    -- self.triggerAction = true
                    require "MonsterSiegeManager":GetInstance():EnterEmbattle(self.ItemData.EnterFightId)
                end,
                self.Transform
            )
            self.isOpenView = true
        end
        self.isEnter = true
    else
        self.isOpenView = false
        _G.WorldItemManager:GetInstance():CloseInteractedView(_G.WorldItemType.Enemy, self.Transform)
    end
end
-----物件被点击时的调用方法
function WorldDungonesEventItem:OnClick()
    -- if self.isEnter then
    --
    if _G.AppSetting.DEBUG then
        _G.Log(self.ItemData.EnterFightId, "点击事件>>>>>>>>>>>>>>>>")
    end
    --     require "MonsterSiegeManager":GetInstance():EnterEmbattle(self.ItemData.EnterFightId)
    --     _G.WorldItemManager:GetInstance():CloseInteractedView(_G.WorldItemType.Enemy, self.Transform)
    -- end
    local radius = 0
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    ---@param isNode boolean item是不是障碍物 有无寻路节点
    if player then
        self.triggerAction = false
        local isArrival, isTooClose =
            player:GotoPoint(
            _G.Vector3.New(self.Transform:GetPosition()),
            function()
                if not self.isInteracted then
                    self.NavStepMoveOverPosCheck(
                        player,
                        _G.Vector3.New(player.Transform:GetPosition()),
                        _G.Vector3.New(self.Transform:GetPosition()),
                        _G.handler(self, self.NpcDoEvent)
                    )
                end
            end,
            nil,
            self.Cfg.ActionRadius
        )
        if not isArrival and not isTooClose then
            local fun
            fun = function(param)
                radius = radius + param
                if not isArrival and not isTooClose then
                    local x, y, z = self.Transform:GetPosition()
                    local pos = player:GetClosestPointByTwoTarget(x, y, z, radius)
                    isArrival, isTooClose =
                        player:GotoPoint(
                        pos,
                        function()
                            if not self.isInteracted then
                                self:NpcDoEvent()
                            end
                        end,
                        nil,
                        self.Cfg.ActionRadius
                    )
                end
                if isTooClose then
                    return
                end
                if isArrival or radius > self.Cfg.ActionRadius then
                    return
                else
                    fun(0.1)
                end
            end
            fun(0.1)
        end
        --点击NPC 不显示自动寻路
        _G.Events:GetInstance():Broadcast(_G.eNav.HideFlag, player.Uid)
    end
end
---停止闲置动画
function WorldDungonesEventItem:StopStandActionTimer()
    if self.StandActionTimer then
        self.StandActionTimer:Stop()
        self.StandActionTimer = nil
    end
end
---检测是否为idle动画
function WorldDungonesEventItem:CheckStandAction(name)
    if self.StandActionCount <= 0 then
        return false
    end
    for _, v in pairs(self.StandActionName) do
        if v.name == name then
            return true
        end
    end
    return false
end
function WorldDungonesEventItem:NpcDoEvent()
    _G.WorldItemManager:GetInstance():CloseInteractedView(_G.WorldItemType.NPC, self.Transform)
    if self.triggerAction then
        return
    end
    self:StopCfgMove()
    if not self:CheckLimitType(_G.handler(self, self.ContinueCfgMove)) then
        return
    end
    self:StopStandActionTimer()
    base.PlayAnimByName(self, _G.WorldManager.AnimNames.IDLE)
    require "MonsterSiegeManager":GetInstance():EnterEmbattle(self.ItemData.EnterFightId)

