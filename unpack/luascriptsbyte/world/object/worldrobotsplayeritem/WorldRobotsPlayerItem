local base = require "WorldRobotsBasePlayerItem"
---@class WorldRobotsPlayerItem	:WorldRobotsBasePlayerItem
local WorldRobotsPlayerItem = _G.BaseClass("WorldRobotsPlayerItem", base)
---类的构造函数
function WorldRobotsPlayerItem:__init(info, data, world)
    self.RobotCfg = _G.ConfigManager.scene_robot_cfg[info.id]
    self.Cfg = {
        Res = self.RobotCfg.model_path,
        name = _G.GetLangPackValue(self.RobotCfg.name),
        title_effect = self.RobotCfg.title_effect,
        halo_effect = self.RobotCfg.halo_effect
    }
end

--endregion
return WorldRobotsPlayerItem
