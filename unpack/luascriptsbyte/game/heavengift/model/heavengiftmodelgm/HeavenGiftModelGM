---检查红点方法 0代表活动开始互动，2代表活动即将结束红点
function HeavenGiftModelGM:CheckShowRedPoint()
    if _G.AppSetting.IsXzns then--星座增加当前免费礼包可领取时的红点
        local index = self:GetCurIndex()
        if index ~= 0 then
            if self.gifts then
                return self.gifts[index].price == 0 and 1 or 0
            end
        end
    end
    local value = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. self.curActivityClass:GetActivityID() .. "HeavenGiftRedPoint")
    if value == 0 or value == 2 then
        return 1
    else
        return 0
    end
end

---设置主界面定时器
function HeavenGiftModelGM:SetTimerTb(tb)
    self.MainTimerTb = tb
    self.residueTime = self:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    if self.residueTime < 600 then
        self.MainTimerTb.aortext_time:SetActiveE(1)
        self.MainTimerTb.aortext_time.text = _G.TimeUtil.TimeToString(self.residueTime,1)
    end
    self:StopMainTimer()
    self.MainTimer =
    _G.TimerManager:GetInstance():GetTimer(
            1,
            self.TimeCutDown,
            self,
            false,
            false,
            true
    )
    self.MainTimer:Start()
end

---定时器刷新方法
function HeavenGiftModelGM:TimeCutDown(elapsed)
    self.residueTime = self.residueTime - elapsed
    if self.residueTime <=0 or not self.MainTimerTb then
        self:StopMainTimer()
    end
    if self.residueTime <= 86400 then
        self.MainTimerTb.aortext_time:SetActiveE(1)
        if self.MainTimerTb.aorimage_icon.SpriteName =="ui_zjm_btn_yutiankuizeng1" then
            self.MainTimerTb.aorimage_icon.SpriteName = "ui_zjm_btn_yutiankuizeng"
        end
        self.MainTimerTb.aortext_time.text = _G.TimeUtil.TimeToString(math.ceil(self.residueTime),1)
        local value = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. self.curActivityClass:GetActivityID() .. "HeavenGiftRedPoint")
        if value < 2 then
            _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. self.curActivityClass:GetActivityID() .. "HeavenGiftRedPoint", 2)
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        end
    else
        if self.MainTimerTb.aorimage_icon.SpriteName =="ui_zjm_btn_yutiankuizeng" then
            self.MainTimerTb.aorimage_icon.SpriteName = "ui_zjm_btn_yutiankuizeng1"
        end
        self.MainTimerTb.aortext_time:SetActiveE(0)
    end
end

---关闭主界面定时器
function HeavenGiftModelGM:StopMainTimer()
    if self.MainTimer then
        self.MainTimer:Stop()
        self.MainTimer = nil
    end
end

---检测活动奖励是否领取完成
---@return boolean 活动奖励是否领完
function HeavenGiftModelGM:OnCheckActivityAwardDone()
    return #self.gifts > 0 and #self.gifts == #self.awards_sid
end

---拿到界面跳转index
function HeavenGiftModelGM:GetJumpIndex()
    local index = 0
    for i,v in ipairs(self.gifts) do
        if not _G.table.ContainsValue(self.awards_sid,v.sid) then
            index = math.ceil(i/2) -2
            break
        end
    end
    return index < 0 and 0 or index
end

