function HeavenGiftModelGM:BuyGiftSuc(data,callback,gift)
    if data.ack == 1 then
        if gift.consume_type > 0 then
            _G.StorageManager:GetInstance():ConsumeItem(gift.consume_type, 0, gift.price)
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        require "CommonTipManager".OpenCommonAwardView(data)
        if callback then
            callback()
        end
    end
end

---购买礼包
---@param sid number 礼包sid
function HeavenGiftModelGM:BuyGoods(sid,callback)
    ---@type activity_heavenly_gift.i_item 礼包
    local gift
    for i ,v in ipairs(self.gifts) do
        if v.sid == sid then
            gift = v
            break
        end
    end
    if gift then
        --是否超时
        local endTime = self:GetEndTime()
        if endTime >= _G.TimeUtil.GetServerUnixTime() then
            --判断是不是免费礼包
            if gift.price == 0 then
                self:GetAward(gift.sid, _G.handlerbind(self, self.BuyGiftSuc,callback,gift))
            else
                --购买类型判断
                if gift.consume_type == 0 then --人民币支付
                    self:BuyActiveGift(gift.price,self.curActivityClass.activityID,gift.sid)
                else --代币支付
                    --判断消耗
                    if _G.StorageManager:GetInstance():CheckItem(gift.consume_type,gift.price) then
                        self:GetAward(gift.sid, _G.handlerbind(self, self.BuyGiftSuc,callback,gift))
                    else
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, gift.consume_type)
                    end

                end
            end
        else
            _G.FloatTipsModel:GetInstance():Show(_G.GetLangPackValue(90030800001))
        end
    else
        _G.LogError("礼包不存在",sid)
    end
end

---添加购买id
