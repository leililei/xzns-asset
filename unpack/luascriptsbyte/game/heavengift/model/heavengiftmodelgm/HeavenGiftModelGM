---活动本身数据处理
---@param info activity.i_activity_self_info
function HeavenGiftModelGM:SetSelfData(info)
    if info.heavenly_gift == nil or info.heavenly_gift.items == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("配置信息为空", "御天馈赠")
        end
        return
    end
    ---礼包基础信息
    ---@type activity_heavenly_gift.i_item[]
    self.gifts = info.heavenly_gift.items

    ---购买信息
    ---@type number[]
    self.awards_sid = info.heavenly_gift.award_sid or {}
end

---获取礼包列表
---@return activity_heavenly_gift.i_item[]
function HeavenGiftModelGM:GetGiftsList()
    return self.gifts
end

---获取UI界面展示数据
function HeavenGiftModelGM:GetGiftsShowDataList()
    local gifts = self.gifts
    local showDatalist = {}
    local len = math.ceil(#gifts / 2)

    for i = 1,len do
        local data1 = gifts[(i-1)*2+1]
        local data2 = gifts[(i-1)*2+2]
        local data = {}
        if i%2 == 0 then
            data.node1 = data2
            data.node2 = data1
        else
            data.node1 = data1
            data.node2 = data2
        end
        showDatalist[i] = data
    end

    return showDatalist
end

