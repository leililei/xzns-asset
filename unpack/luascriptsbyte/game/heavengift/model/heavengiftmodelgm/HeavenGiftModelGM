---点击后刷新红点
function HeavenGiftModelGM:UpdateRedPoint()
    local value = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. self.curActivityClass:GetActivityID() .. "HeavenGiftRedPoint")
    if value == 0 then 
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. self.curActivityClass:GetActivityID() .. "HeavenGiftRedPoint", 1)
    elseif value == 2 then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. self.curActivityClass:GetActivityID() .. "HeavenGiftRedPoint", 3)
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end




function HeavenGiftModelGM:Dispose()
    self.gifts = {}
    self.awards_sid = {}
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    self.MainTimerTb = nil
    self.residueTime = 0
    base.Dispose(self)
end

