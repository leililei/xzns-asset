---获取当前可购买的礼包的sid
function HeavenGiftModelGM:GetCurIndex()
    for i = 1, #self.gifts do
        local data = self.gifts[i]
        if not self:CheckHasBuy(data.sid) then
            return i
        end
    end
    return 0
end

