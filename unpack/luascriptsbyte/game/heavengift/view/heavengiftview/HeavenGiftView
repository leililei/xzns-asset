---@class HeavenGiftView:UIBaseView
local HeavenGiftView = _G.BaseClass("HeavenGiftView", _G.UIBaseView)

local arrowPath = {
    [1] = "ui_ytkz_yh_ljt",
    [2] = "ui_ytkz_yh_hjt"
}

local bgPath = {
    free = "ImagesH5/hHeavenGift/ui_ytkz_yh_mfd",
    bought = "ImagesH5/hHeavenGift/ui_ytkz_yh_ffd",
    noBuy = "ImagesH5/hHeavenGift/ui_ytkz_yh_ffd"
}

function HeavenGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---@type HeavenGiftUIShowData[]
    self.giftList = {}
    self.buyList = {}
    ---@type ActivitySynGMActivity
    self.activityData = nil
    ---@type HeavenGiftModelGM
    self.typeClass = nil
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---@param activity ActivitySynGMActivity
function HeavenGiftView:OnCreate(activity)
    --获取数据
    self.activityData = activity
    self.itemList = {}
    self.arrowList = {}
    self.typeClass = self.activityData:GetActivityTypeCls()
    self.typeClass:UpdateRedPoint()
    self.giftList = self.typeClass:GetGiftsShowDataList()
    self.jumpIndex = self.typeClass:GetJumpIndex()
    self:UpdateView()
end

---刷新界面
function HeavenGiftView:UpdateView()
    self.activityEndTime = self.typeClass:GetEndTime()
    self:StopAllTimer()
    self:UpdateTime()
    self.nextUnlock = 0
    self.endTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.endTimer:Start()
    self.go_table.scrollloopvectical_listView:InitItemData(#self.giftList, _G.handler(self, self.RefreshList))
    self:ScrollToIndex()
end

---跳转index
function HeavenGiftView:ScrollToIndex()
    _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_listView:ScrollToIndex(self.jumpIndex)
        end
    )
end

---定时器方法
function HeavenGiftView:UpdateTime()
    local time = self.activityEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self:CloseView()
        return
    end
    local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_endTime.text = _G.GetLangPackValue(90030800005, "<color=#7bfb59>" .. str .. "</color>")
end

---更新箭头颜色
function HeavenGiftView:UpdateArrow(sid)
    local index = 0
    for k, v in pairs(self.giftList) do
        local node1 = k % 2 == 0 and v.node1.sid or v.node2.sid
        local node2 = k % 2 == 0 and v.node2.sid or v.node1.sid
        if node1 == sid then
            break
        end
        index = index + 1
        if node2 == sid then
            break
        end
        index = index + 1
    end
    if index % 2 == 0 then
        index = index + 2
    end
    self.nextUnlock = index // 2 + 1
    self.arrowList[index].SpriteName = arrowPath[1]
    self.arrowList[index + 1].SpriteName = arrowPath[2]
end

---GroupItem刷新方法
function HeavenGiftView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    --为了向下的箭头被压住 要对这个排序
    objGame:SetName(index)
    if not table.ContainsValue(self.itemList, objGame) then
        self.itemList[index] = objGame
    end
    for i = 1, #self.itemList do
        _G.SortList(
            self.itemList,
            function(a)
                return a:GetName()
            end
        )
        self.itemList[i]:SetSiblingIndexE(i)
    end

    local groupData = self.giftList[index + 1]
    local groupGoTable = _G.GetAutoGoTable(objGame)
    groupGoTable.obj_node1:SetActiveE(groupData.node1 and 1 or 0)
    groupGoTable.obj_node2:SetActiveE(groupData.node2 and 1 or 0)
    local hasIndex = #self.typeClass.awards_sid
    --arrow
    if groupData.node1 == nil or groupData.node2 == nil then
        groupGoTable.aorimage_arrowVer:SetActiveE(0)
        groupGoTable.aorimage_arrowHor:SetActiveE(0)
    else
        if index % 2 == 0 then
            local rotationy = 0
            local qt = Quaternion.Euler(0, 0, rotationy)
            groupGoTable.aorimage_arrowHor:SetLocalRotation(qt.x, qt.y, qt.z, qt.w)
            groupGoTable.aorimage_arrowVer:SetLocalPosition(147, -121, 0)
        else
            local rotationy = -180
            local qt = Quaternion.Euler(0, 0, rotationy)
            groupGoTable.aorimage_arrowHor:SetLocalRotation(qt.x, qt.y, qt.z, qt.w)
            groupGoTable.aorimage_arrowVer:SetLocalPosition(-150, -121, 0)
        end

        local node1 = index % 2 == 0 and groupData.node2.sid or groupData.node1.sid
        local node2 = index % 2 == 0 and groupData.node1.sid or groupData.node2.sid
        table.insert(self.arrowList, groupGoTable.aorimage_arrowHor)
        table.insert(self.arrowList, groupGoTable.aorimage_arrowVer)
        groupGoTable.aorimage_arrowVer.SpriteName = arrowPath[1]
        groupGoTable.aorimage_arrowHor.SpriteName = arrowPath[1]
        if self.nextUnlock == 0 or self.nextUnlock == index + 1 then
            if not self.typeClass:CheckHasBuy(node2) then
                self.nextUnlock = index + 1
                groupGoTable.aorimage_arrowHor.SpriteName = arrowPath[2]
            elseif not self.typeClass:CheckHasBuy(node1) then
                self.nextUnlock = index + 1
                groupGoTable.aorimage_arrowVer.SpriteName = arrowPath[2]
            end
        end

        groupGoTable.aorimage_arrowVer:SetActiveE(1)
        groupGoTable.aorimage_arrowHor:SetActiveE(1)
    end

    if index == #self.giftList - 1 then
        --特殊情况，最后一个两个都满的时候需要把向下的箭头隐藏
        groupGoTable.aorimage_arrowVer:SetActiveE(0)
    end

    groupGoTable.aorimage_arrowVer:SetNativeSize()
    groupGoTable.aorimage_arrowHor:SetNativeSize()

    --刷新item
    if groupData.node1 then
        self:RefreshItem(groupGoTable.obj_node1, groupData.node1, index)
    end
    if groupData.node2 then
        self:RefreshItem(groupGoTable.obj_node2, groupData.node2, index)
    end
end

---刷新item
---@param data activity_heavenly_gift.i_item
function HeavenGiftView:RefreshItem(obj, data, index)
    local itemNodeGoTable = _G.GetAutoGoTable(obj)
    local itemGoTable = _G.GetAutoGoTable(itemNodeGoTable.obj_item, _G.handlerbind(self, self.OnClick_item, data))
    itemGoTable.aortext_name.text = data.name
    --itemGoTable.aortext_discount.text = math.ceil(data.discount/10000).."%"
    local awardState

    if self.typeClass:CheckHasBuy(data.sid) then
        -- 买过了
        awardState = 1
    elseif data.pre_sid == 0 or self.typeClass:CheckHasBuy(data.pre_sid) then
        -- 没有买，但是可以买
        awardState = 2
    else
        -- 不能买
        awardState = 3
    end

    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(data.price)

    -- 背景
    if awardState == 1 then
        if finalPrice == 0 then
            itemGoTable.aorrawimage_bg:LoadImage(bgPath["free"])
        else
            itemGoTable.aorrawimage_bg:LoadImage(bgPath["bought"])
        end
    else
        if finalPrice == 0 then
            itemGoTable.aorrawimage_bg:LoadImage(bgPath["free"])
        else
            itemGoTable.aorrawimage_bg:LoadImage(bgPath["noBuy"])
        end
    end
    itemGoTable.aorimage_icon:SetActiveE(awardState == 3 and 1 or 0)
    itemGoTable.aorimage_douyin:SetActiveE(0)
    local color = { "C6D3F7", "351B0A" }
    if _G.AppSetting.IsXzns then
        color = { "351B0A", "351B0A" }
    end
    itemGoTable.aortext_price.color = finalPrice == 0 and _G.ColorTools.FormatColorByString(color[1]) or
        _G.ColorTools.FormatColorByString(color[2])

    --价格
    if awardState == 1 then
        itemGoTable.aorrawimage_icon:SetActiveE(0)
        itemGoTable.aortext_price.text = _G.GetLangPackValue(90000011046)
    elseif finalPrice == 0 then
        itemGoTable.aorrawimage_icon:SetActiveE(0)
        itemGoTable.aortext_price.text = _G.GetLangPackValue(90030800004)
    else
        if data.consume_type ~= 0 then
            itemGoTable.aorrawimage_icon:SetActiveE(1)
            --icon图片
            local path = _G.StorageManager:GetInstance():GetItemIcon(data.consume_type)
            itemGoTable.aorrawimage_icon:LoadImage(path)
            itemGoTable.aortext_price.text = data.price
        else
            itemGoTable.aorrawimage_icon:SetActiveE(0)

            _G.GameUtil.SetPriceByChannel(data.price, itemGoTable.aortext_price)
            itemGoTable.aorimage_douyin:SetActiveE(_G.GameUtil.IsNotPlatformSpecial() and 0 or 1)
        end
    end

    _G.GameUtil.AddDouYinIcon(itemGoTable.obj_price, false, nil, nil, nil, data.consume_type == 0 and finalPrice or 0)

    --道具
    itemGoTable.obj_awardlist:RemoveAllChildren()
    local awardCount = #data.award
    local go
    for i = 1, awardCount do
        go = _G.GetAutoGoTable(_G.InstantiateObject(itemGoTable.obj_award, itemGoTable.obj_awardlist))
        -- go = _G.InstantiateObject(itemGoTable.obj_award,itemGoTable.obj_awardlist)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { data.award[i].type[1],
              data.award[i].type[2] },
            go.obj_awardNode,
            function(itemlua, num)
                if itemlua.ShowNumText then
                    itemlua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                itemlua.gameObject:SetLocalScaleXYZ(0.85)
            end
        )
        if awardState == 1 then
            -- 买过了
            go.aorimage_lock:SetActiveE(1)
            go.aorimage_icon:SetActiveE(0)
            go.aorimage_over:SetActiveE(1)
        elseif awardState == 2 then
            -- 没有买，但是可以买
            go.aorimage_lock:SetActiveE(0)
            go.aorimage_icon:SetActiveE(0)
            go.aorimage_over:SetActiveE(0)
        elseif awardState == 3 then
            -- 不能买
            go.aorimage_lock:SetActiveE(0)
            go.aorimage_icon:SetActiveE(0)
            go.aorimage_over:SetActiveE(0)
        end
    end
end

---item点击事件
---@param data activity_heavenly_gift.i_item
function HeavenGiftView:OnClick_item(itemGoTable, isOn, data)
    if not self.typeClass:CheckHasBuy(data.sid) then
        if data.pre_sid ~= 0 then
            --判断前置礼包
            if self.typeClass:CheckHasBuy(data.pre_sid) then
                self.typeClass:BuyGoods(data.sid, _G.handlerbind(self, self.OnMallCashListener, data))
            else
                _G.FloatTipsModel:GetInstance():Show(_G.GetLangPackValue(90030800002))
            end
        else
            self.typeClass:BuyGoods(data.sid, _G.handlerbind(self, self.OnMallCashListener, data))
        end
    end
end

function HeavenGiftView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:CloseView()
    end
end

---购买礼包后刷新界面
---@param data activity_heavenly_gift.i_item
function HeavenGiftView:OnMallCashListener(data)
    self.typeClass:AddBuyId(data.sid)
    local jumpIndex = self.typeClass:GetJumpIndex()
    if self.jumpIndex + 2 <= jumpIndex then
        self.jumpIndex = jumpIndex
    end
    self.go_table.scrollloopvectical_listView:UpdateAllItem()
    self.go_table.scrollloopvectical_listView:ScrollToIndex(self.jumpIndex)
    if _G.AppSetting.IsXzns then
        require("RedPointManager"):GetInstance():RefreshNode(self.typeClass:GetRedpointIDByIndex(1))
    end
    self:UpdateArrow(data.sid)
end

function HeavenGiftView:StopAllTimer()
    if self.endTimer then
        self.endTimer:Stop()
        self.endTimer = nil
    end
end

function HeavenGiftView:EscClose()
    self:CloseView()
end

function HeavenGiftView:CloseView()
    ---@type HeavenGiftUIShowData[]
    self.giftList = {}
    self.buyList = {}
    ---@type ActivitySynGMActivity
    self.activityData = nil
    ---@type HeavenGiftModelGM
    self.typeClass = nil
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:StopAllTimer()
    self:Close()
end

function HeavenGiftView:OnDestroy()
    self:CloseView()
end

return HeavenGiftView
