local MTTarotManager = require "MTTarotManager"
---@class MTTarotSelectAwardList : Component	中文描述
---@field go_table SecretSelectView._obj_Item_GoTable
---@field awardList BaseAwardNewItem[]
local MTTarotSelectAwardList = _G.BaseClass("MTTarotSelectAwardList", _G.Component)

function MTTarotSelectAwardList:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function MTTarotSelectAwardList:OnCreate(data, chooseBack, TarotClass)
    self.data = data
    self.term = data.term
    self.chooseId = 0
    self.chooseBack = chooseBack
    self.TarotClass = TarotClass
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.StartCloseUI, self.StartCloseView, self)
    self:InitAwardList()
end

function MTTarotSelectAwardList:UpdateAward(data)
    self.data = data
    self.term = data.term
end

function MTTarotSelectAwardList:Show()
    local cycleBol, term = self.TarotClass:IsCycleAward(self.term)
    local txt = cycleBol and 90034541004 or 90031400007
    if cycleBol then
        if term == 1 then
            txt = 90034541008
        else
            txt = 90034541009
        end
        self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(txt)
    else
        self.go_table.aortext_title.text = _G.string.format(_G.LangUtil.GetLangPackValue(txt, term))
    end

    --_G.GameUtil.NumberToChinese(self.term)))
    self:ShowAwarList()
end

---更新奖励列表显示
function MTTarotSelectAwardList:ShowAwarList()
    --Log(self.data.big_award)
    for i = 1, 4 do
        if self.data.big_award[i] then
            local sid = self.data.big_award[i].award[1] == 0 and self.data.big_award[i].award[4] or self.data.big_award[i].award[1]
            local num = self.data.big_award[i].award[1] == 0 and self.data.big_award[i].award[5] or self.data.big_award[i].award[2]
            local data =
                _G.StorageManager:GetInstance():GetItemDataClass(
                    sid,
                    num
                )
            --Log(i)
            --Log(#self.awardList)
            self.awardList[i]:Show(data)

            local useTimes = self:GetUseTimes(sid, self.term)

            if (self.data.big_award[i].count - useTimes) > 0 then
                self.awardList[i].go_table.aortext_Num.text =
                    (self.data.big_award[i].count - useTimes) .. "/" .. self.data.big_award[i].count

                if i == 1 then
                    self.awardList[i]:ShowEffect(true, 0.8)
                end
            else
                self.awardList[i].go_table.aortext_Num.text =
                    "<color=red>" ..
                    (self.data.big_award[i].count - useTimes) .. "</color>/" .. self.data.big_award[i].count
            end

            _G.GameUtil.SetActiveByCondition(self.awardList[i].go_table.obj_suo, self.TarotClass.Info.term < self.term)
            _G.GameUtil.SetActiveByCondition(self.awardList[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(self.awardList[i].gameObject, false)
        end
    end

    local bigaward = self.TarotClass.Info.big_award or {}
    self:SetChoose(bigaward[1] == 0 and bigaward[4] or bigaward[1], self.TarotClass.Info.big_term)
end

function MTTarotSelectAwardList:GetUseTimes(sid, term)
    if self.TarotClass.Info.big_count then
        for i = 1, #self.TarotClass.Info.big_count do
            local id = self.TarotClass.Info.big_count[i].award[1] == 0 and self.TarotClass.Info.big_count[i].award[4] or self.TarotClass.Info.big_count[i].award[1]
            if sid == id and term == self.TarotClass.Info.big_count[i].term then
                return self.TarotClass.Info.big_count[i].count
            end
        end
    end
    return 0
end

---初始化奖励列表
function MTTarotSelectAwardList:InitAwardList()
    self.awardList = {}
    for i = 1, 4 do
        self.awardList[i] =
            require "BaseAwardNewItem".New(
                self.go_table["obj_award" .. i],
                _G.handlerbind(self, self.OnClickAward, i),
                72,
                nil,
                _G.handlerbind(self, self.OnLongAward, i)
            )
    end
end

function MTTarotSelectAwardList:OnClickAward(item, index)
    local useTimes = self:GetUseTimes(self.data.big_award[index].award[1] == 0 and self.data.big_award[index].award[4] or self.data.big_award[index].award[1], self.term)
    local cycleBol = self.TarotClass:CheckInCycle()
    if cycleBol and not self.TarotClass:IsCycleAward(self.term) then
        --LogError("循环阶段不能选普通阶段的奖励")
        _G.PopWindowManager:GetInstance():ShowAllTips(1160005)
        return
    end
    if useTimes >= self.data.big_award[index].count then
        --LogError("次数已使用完")
        _G.PopWindowManager:GetInstance():ShowAllTips(930104)
        return
    end
    if self.TarotClass.Info.term < self.term then
        --LogError("还未达到对应轮次，无法选择")
        _G.PopWindowManager:GetInstance():ShowAllTips(930105)
        return
    end
    local data = self.data.big_award[index]
    self.chooseBack(item.gameObject, data.award, self.term)
end

function MTTarotSelectAwardList:StartCloseView(name)
    if name == _G.ConfigManager.ui_cfg.CommonTipView.Name then
        for i = 1, #self.awardList do
            self.awardList[i]:OnUpPressBigAward()
        end
    end
end

function MTTarotSelectAwardList:OnLongAward(index)
    require("CommonTipManager"):GetInstance():OpenPropTip(self.gameObject, self.data.big_award[index].award[1] == 0 and self.data.big_award[index].award[4] or self.data.big_award[index].award[1])
end

function MTTarotSelectAwardList:SetChoose(id, term)
    for i = 1, #self.awardList do
        if self.awardList[i].data then
            _G.GameUtil.SetActiveByCondition(
                self.awardList[i].go_table.obj_choose,
                self.awardList[i].data.sid == id and self.term == term
            )
        end
    end
end

---销毁对象时,析构函数
function MTTarotSelectAwardList:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.StartCloseUI, self.StartCloseView, self)
end

function MTTarotSelectAwardList:OnClickBtn(go, isOn)
    -- body
end

return MTTarotSelectAwardList
