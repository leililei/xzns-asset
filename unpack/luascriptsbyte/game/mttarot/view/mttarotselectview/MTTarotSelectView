---@class MTTarotSelectView : UIBaseView	中文描述
---@field public go_table TarotSelectView_GoTable GoTable
---@field TarotClass TarotModel
---@field CurAward {sid, num} 当前奖励
---@field CurTerm number 当前轮次
---@field AwardList MTTarotSelectAwardList[]
local MTTarotSelectView = _G.BaseClass("MTTarotSelectView", _G.UIBaseView)

function MTTarotSelectView:Awake()
    self.itemList = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MTTarotSelectView:OnCreate(Callback, TarotClass)
    self.TarotClass = TarotClass
    if self.TarotClass then
        self.CurAward = self.TarotClass.Info.big_award or {}
        self.ChooseId = self.CurAward[1] or 0
        self.ChooseTerm = self.TarotClass.Info.big_term
        self.CurTerm = self.TarotClass.Info.term
        --LogError(self.TarotClass.Info.cfg_info.big_award)
        --self.BigTermAward = self.TarotClass.Info.cfg_info.big_award

        self.CommonToggle = _G.GetAutoGoTable(self.go_table.toggle_common)
        self.LoopToggle = _G.GetAutoGoTable(self.go_table.toggle_loop)

        self.BigTermAward = {}
        self.LoopTermAward = {}
        local bigitem
        local awards = self.TarotClass.Info.cfg_info.big_award
        for i = 1, #awards do
            local info = awards[i]
            local cycleBol, term = self.TarotClass:IsCycleAward(info.term)
            if not cycleBol then
                table.insert(self.BigTermAward, awards[i])
            else
                table.insert(self.LoopTermAward, awards[i])
            end
            if info.term == 25 then
                bigitem = info.big_award[1]
            end
        end

        local item = require "BaseAwardNewItem".New(self.go_table.obj_bigitem)
        item:ShowWithID(
            { bigitem.award[1], bigitem.award[2], bigitem.award[3], bigitem.award[4], bigitem.award[5] }
        )

        self.PreviewAward = self.TarotClass.Info.cfg_info.preview_award or {}
        self.BigCount = self.TarotClass.Info.big_count
        self.AwardList = {}
        self.Callback = Callback

        self:UpdateAward()
        self.go_table.scrollloopvectical_ItemList:InitItemData(#self.BigTermAward, _G.handler(self, self.RefreshItem))

        local choosescTerm = 1
        local choosescIndex = 1
        for i = 1, #self.BigTermAward do
            if self.CurTerm >= self.BigTermAward[i].term then
                if choosescTerm < self.BigTermAward[i].term then
                    choosescTerm = self.BigTermAward[i].term
                    choosescIndex = i
                end
            end
        end
        self.go_table.scrollloopvectical_ItemList:ScrollToIndex(choosescIndex - 1)


        self.go_table.scrollloopvectical_ItemListLoop:InitItemData(#self.LoopTermAward,
            _G.handler(self, self.RefreshItemLoop))

        if self.CurTerm < self.LoopTermAward[1].term then
            self.go_table.scrollloopvectical_ItemList:SetActiveE(1)
            self.go_table.scrollloopvectical_ItemListLoop:SetActiveE(0)

            self.go_table.aortext_tips_title.text = _G.GetLangPackValue(90034541005,
                self.LoopTermAward[1].term - self.CurTerm)
        else
            self.go_table.toggle_loop.isOn = true

            self.go_table.aortext_tips_title.text = _G.GetLangPackValue(90034541010)
        end

        self.GetAwardRound = 0 --
        if self.BigCount then
            for i = 1, #self.BigCount do
                if self.BigCount[i].term > self.GetAwardRound then
                    self.GetAwardRound = self.BigCount[i].term
                end
            end
        end

        -- self.go_table.scrollloophorizontal_PreviewAward:InitItemData(
        --     #self.PreviewAward,
        --     _G.handler(self, self.RefreshBigAward)
        -- )
        -- self.go_table.scrollloophorizontal_PreviewAward:ScrollToIndex(
        --     _G.Mathf.Floor(self.GetAwardRound / 5) > (#self.PreviewAward - 1) and (#self.PreviewAward - 1) or
        --         _G.Mathf.Floor(self.GetAwardRound / 5)
        -- )
        --self:InitBigAwardList()
    end
end

---刷新奖励
function MTTarotSelectView:RefreshBigAward(index, obj)
    if index < 0 then
        return
    end
    index = index + 1

    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.PreviewAward[index].award
    local array = { data[1], data[2], data[3], data[4], data[5] }

    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            array,
            tb.obj_Root,
            function(tran)
                if not tran then
                    return
                end
                self.itemList[instanceID].item = tran
                tran.gameObject:SetLocalScaleXYZ(0.75)
                tran.gameObject:SetLocalPosition(0, -11.5, 0)
                tran:ShowEffect()
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    else
        if self.itemList[instanceID].item then
            self.itemList[instanceID].item.gameObject:SetLocalScaleXYZ(0.75)
            self.itemList[instanceID].item.gameObject:SetLocalPosition(0, -11.5, 0)
            self.itemList[instanceID].item:ShowEffect()
            self.itemList[instanceID].item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    end

    tb.aortext_round.text = _G.string.format(_G.LangUtil.GetLangPackValue(90031400007, data[3]))
    --_G.GameUtil.NumberToChinese(data[3])))

    tb.obj_choose:SetActiveE(index <= _G.Mathf.Floor(self.GetAwardRound / 5) and 1 or 0)
end

---初始化奖励列表
function MTTarotSelectView:InitBigAwardList()
    for i = 1, #self.PreviewAward do
        if not self.ItemList[i] then
            item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Root)
            self.ItemList[i] = item
        end

        tb = _G.GetAutoGoTable(self.ItemList[i])
        local cfg = self.PreviewAward[i].award
        if cfg then
            tb.aortext_round.text = _G.string.format(_G.LangUtil.GetLangPackValue(90031400007, cfg[3]))
            --_G.GameUtil.NumberToChinese(cfg[3])))

            local array = { cfg[1], cfg[2], cfg[3], cfg[4], cfg[5] }
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                array,
                tb.obj_item,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.94)
                    tran.gameObject:SetLocalPosition(0, -11.5, 0)
                    tran:ShowEffect()
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    self.ItemList[i] = tran
                end
            )
        end
    end
end

---刷新奖励s
function MTTarotSelectView:RefreshItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.AwardList[instanceID]
    local awardData = self.BigTermAward[index + 1]
    if not item then
        item = self:AddComponent(obj,
            require "MTTarotSelectAwardList".New(awardData, _G.handler(self, self.OnClickItem), self.TarotClass))
        self.AwardList[instanceID] = item
    else
        self.AwardList[instanceID]:UpdateAward(awardData)
    end
    self.AwardList[instanceID]:Show()
end

function MTTarotSelectView:RefreshItemLoop(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.AwardList[instanceID]
    local awardData = self.LoopTermAward[index + 1]
    if not item then
        item = self:AddComponent(obj,
            require "MTTarotSelectAwardList".New(awardData, _G.handler(self, self.OnClickItem), self.TarotClass))
        self.AwardList[instanceID] = item
    else
        self.AwardList[instanceID]:UpdateAward(awardData)
    end
    self.AwardList[instanceID]:Show()
end

---点击奖励
function MTTarotSelectView:OnClickItem(go, award, term, weight)
    --self.go_table.scrollloopvectical_ItemList:UpdateItemSingle(self.curFloor - 1)
    local id = award[1] == 0 and award[4] or award[1]
    if id == self.ChooseId and term == self.ChooseTerm then
        --require "CommonTipManager":GetInstance():OpenTip(go, self.ChooseId)
        return
    end
    self.ChooseId = id
    self.ChooseTerm = term
    self.CurAward = award
    self:UpdateAward()
    for _, value in pairs(self.AwardList) do
        value:SetChoose(self.ChooseId, self.ChooseTerm)
    end
end

---更新奖励显示
function MTTarotSelectView:UpdateAward()
    if #self.CurAward <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, true)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, true)

    local cfg = _G.ConfigManager.item_cfg[self.ChooseId]
    if cfg then
        local showElement = cfg.Type1 == 6 or cfg.Type1 == 13 or cfg.Type1 == _G.ItemCfgType.PetChip
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, showElement)
        if showElement then
            self.go_table.aorimage_element.SpriteName = ColorType[cfg.Quality]
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, false)
    end

    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.CurAward[1] == 0 and self.CurAward[4] or self.CurAward[1]))
    _G.UIUtils.SetItemNum(self.go_table, self.CurAward[1] == 0 and self.CurAward[5] or self.CurAward[2])
    if not self.chooseAward then
        self.chooseAward = require "BaseAwardNewItem".New(self.go_table.obj_setItem, nil, 83)
    end
    local data = _G.StorageManager:GetInstance():GetItemDataClass(self.CurAward[1] == 0 and self.CurAward[4] or self.CurAward[1], self.CurAward[1] == 0 and self.CurAward[5] or self.CurAward[2])
    self.chooseAward:Show(data)
end

---按钮点击事件在这里派发
function MTTarotSelectView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        if #self.CurAward <= 0 then
            if _G.AppSetting.DEBUG then
                _G.Log("当前还未选择大奖")
            end
            return
        end
        local msg = {}
        msg.b_award = self.CurAward
        msg.activity_id = self.TarotClass.curActivityClass.activityID
        msg.term = self.ChooseTerm
        require "MTTarotNet":GetInstance():SetAward(
            msg,
            function()
                self.TarotClass.Info.big_award = self.CurAward
                self.TarotClass.Info.big_term = self.ChooseTerm
                if self.Callback then
                    self.Callback()
                end
                self:Close()
            end
        )
    elseif name == "$_toggle_common" then
        if _G.AppSetting.DEBUG then
            _G.Log("普通层")
        end

        _G.GameUtil.SetActiveByCondition(self.CommonToggle.aortext_label, not isOn)
        _G.GameUtil.SetActiveByCondition(self.CommonToggle.aortext_label1, isOn)

        if isOn then
            self.go_table.scrollloopvectical_ItemList:SetActiveE(1)
            self.go_table.scrollloopvectical_ItemListLoop:SetActiveE(0)
        end
    elseif name == "$_toggle_loop" then
        if _G.AppSetting.DEBUG then
            _G.Log("循环层")
        end

        _G.GameUtil.SetActiveByCondition(self.LoopToggle.aortext_label, not isOn)
        _G.GameUtil.SetActiveByCondition(self.LoopToggle.aortext_label1, isOn)

        if isOn then
            self.go_table.scrollloopvectical_ItemList:SetActiveE(0)
            self.go_table.scrollloopvectical_ItemListLoop:SetActiveE(1)
        end
    end
end

return MTTarotSelectView
