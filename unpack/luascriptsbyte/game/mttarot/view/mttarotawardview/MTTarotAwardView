local MTTarotManager = require "MTTarotManager"

---@class MTTarotAwardView : UIBaseView	中文描述
---@field public go_table MTTarotAwardViewView_GoTable GoTable
local MTTarotAwardView = _G.BaseClass("MTTarotAwardView", _G.UIBaseView)

function MTTarotAwardView:Awake()
    self.itemList = {}
    self.AwardDatas = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 奖池idp
function MTTarotAwardView:OnCreate(TarotClass)
    self.TarotClass = TarotClass

    -- 已经获得奖励的index
    self.GetAwardIndexList = {}
    self.GetAward = {}
    if self.TarotClass then
        for _,v in ipairs(self.TarotClass.Info.info) do
            if v.a_index > 0 then
                self.GetAwardIndexList[v.a_index] = 1
            end
        end

    end

    if self.TarotClass then
        local baseAward = self.TarotClass.Info.cfg_info.base_award
        for i = 1, #baseAward do
            local info = {}
            info.sid = baseAward[i].award[1] == 0 and baseAward[i].award[4] or baseAward[i].award[1]
            info.num = baseAward[i].award[1] == 0 and baseAward[i].award[5] or baseAward[i].award[2]
            if not (self.GetAwardIndexList[i + 1]) then
                info.weight = baseAward[i].weight
                self.weight = self.weight + info.weight
                table.insert(self.AwardDatas, info)
            else
                info.weight = 0
                table.insert(self.GetAward, info)
            end
        end

        if self.TarotClass.Info.big_award and #self.TarotClass.Info.big_award > 0 then
            local info = {}
            info.sid = self.TarotClass.Info.big_award[1] == 0 and self.TarotClass.Info.big_award[4] or self.TarotClass.Info.big_award[1]
            info.num = self.TarotClass.Info.big_award[1] == 0 and self.TarotClass.Info.big_award[5] or self.TarotClass.Info.big_award[2]
            info.Grand = true
            if not self.GetAwardIndexList[1] then
                info.weight = self.TarotClass.Info.big_w
                self.weight = self.weight + info.weight
                table.insert(self.AwardDatas, 1, info)
            else
                info.weight = 0
                table.insert(self.GetAward, 1, info)
            end
        end
    end

    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas + #self.GetAward, _G.handler(self, self.RefreshList))
end

---刷新显示
function MTTarotAwardView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local isGet
    local data
    if index + 1 > #self.AwardDatas then
        data = self.GetAward[index + 1 - #self.AwardDatas]
        isGet = true
    else
        data = self.AwardDatas[index + 1]
        isGet = false
    end
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid, data.num},
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(data.Grand)
        end
    )
    -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    if isGet then
        tb.aortext_probNum.text = "0.00%"
        tb.obj_gou:SetActiveE(1)
    else
        tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
        tb.obj_gou:SetActiveE(0)
    end
end

---点击奖励
function MTTarotAwardView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function MTTarotAwardView:OnClickBtn(go, isOn)
    self:Close()
end

function MTTarotAwardView:GetPerData(index)
    local weight = self.AwardDatas[index].weight / self.weight * 100
    weight = string.format("%.2f", weight)
    return weight
end

return MTTarotAwardView
