    _G.SetEventTrigger(self.go_table.aorbtn_bigaward, "onLongPress", _G.handler(self, self.OnLongPressBigAward))
    _G.SetEventTrigger(self.go_table.aorbtn_bigaward, "onUp", _G.handler(self, self.OnUpPressBigAward))
end

function MTTarotView:OnLongPressBigAward()
    if self.IsLong then
        return
    end
    local curAward = self.TarotClass.Info.big_award or {}
    if #curAward <= 0 then
        return
    end
    require("CommonTipManager"):GetInstance():OpenPropTip(self.gameObject, curAward[1] == 0 and curAward[4] or curAward[1])
    self.IsLong = true
end

function MTTarotView:OnUpPressBigAward()
    self.IsLong = false
end

