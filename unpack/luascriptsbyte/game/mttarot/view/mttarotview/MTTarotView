---按钮点击事件在这里派发
function MTTarotView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.ActionState == _G.TaortCardState.None then
            self:Close()
        end
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 126)
    elseif go == self.go_table.aorbtn_onekey then
        if self.TarotClass:GetCoinNum() <= 0 then
            --if _G.AppSetting.DEBUG then
            --LogError("代币不足")
            --end
            --_G.PopWindowManager:GetInstance():ShowAllTips(930103)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                self.TarotClass:GetCoinId()
            )
            return
        end

        local curAward = self.TarotClass.Info.big_award or {}
        if #curAward <= 0 then
            --if _G.AppSetting.DEBUG then
            --LogError("还未选择大奖")
            --end
            _G.PopWindowManager:GetInstance():ShowAllTips(930102)
            return
        end

        if self.GetBigAward then
            if _G.AppSetting.DEBUG then
                _G.Log("本轮大奖已开，点击传送进入下一轮")
            end
            return
        end

        if self.ActionState == _G.TaortCardState.OneKey then
            if _G.AppSetting.DEBUG then
                _G.Log("开牌中")
            end
            return
        end

        self.ActionState = _G.TaortCardState.OneKey

        local msg = {}
        msg.index = 0
        msg.activity_id = self.TarotClass.curActivityClass.activityID
        MTTarotNet:GetInstance():ChooseAward(
            msg,
            function(data)
                if data.ack == 1 then
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    self.OneKeyIndex = 1
                    self.OnKeyAwardItem = data
                    self.OnKeyCA = data.c_a
                    --require "MTTarotManager":GetInstance():AddCoin(-1 * #self.OnKeyCA)
                    self.TarotClass:AddCoin(- 1 * #self.OnKeyCA)
                    for i = 1, #self.OnKeyCA do
                        self.TarotClass:ChangeFaceByIndex(self.OnKeyCA[i].a_index, self.OnKeyCA[i].index)
                    end
                    self:DoOneKeyRecursion()

                    self.TarotClass:RefreshRedPoint()
                else
                    self.ActionState = _G.TaortCardState.None
                end
            end
        )
    elseif go == self.go_table.aorbtn_gift then
        _G.GlobalInterface.JumpActivityByGM(
            10014,
            self.TarotClass.curActivityClass:GetJumpType(self.TarotClass.curActivityClass.activityID)
        )
    elseif go == self.go_table.aorbtn_task then
        _G.GlobalInterface.JumpActivityByGM(
            10027,
            self.TarotClass.curActivityClass:GetJumpType(self.TarotClass.curActivityClass.ActivityID)
        )
    elseif go == self.go_table.aorbtn_tjackpot then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTTarotAwardView.Name, self.TarotClass)
    elseif go == self.go_table.aorbtn_bigaward then
        if self.ActionState ~= _G.TaortCardState.None or self.GetBigAward then
            if _G.AppSetting.DEBUG then
                _G.Log("已开出大奖或者操作中无法更换大奖")
            end
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.MTTarotSelectView.Name,
            _G.handler(self, self.UpdateBigAward),
            self.TarotClass
        )
    elseif go == self.go_table.aorbtn_csm or go == self.go_table.aorbtn_donext then
        self.ActionState = _G.TaortCardState.GotoNext
        local msg = {}
        msg.activity_id = self.TarotClass.curActivityClass.activityID
        MTTarotNet:GetInstance():Reset(msg, _G.handler(self, self.ResetGame))
    end
end

---一键翻牌递归函数
function MTTarotView:DoOneKeyRecursion()
    local face = self:GetFaceByIndex(self.OnKeyCA[self.OneKeyIndex].index)
    if self.OnKeyCA[self.OneKeyIndex].a_index == 1 then
        self.GetBigAward = true
    end
    face:OneKeyDoOne(
    --self.OnKeyAwardItem.award.item[self.OneKeyIndex],
    --self.OnKeyAwardItem.award.item可能为空
        nil,
        self.OnKeyCA[self.OneKeyIndex],
        function()
            self.OneKeyIndex = self.OneKeyIndex + 1
            if self.OneKeyIndex <= #self.OnKeyCA then
                self:DoOneKeyRecursion()
            else
                if not self.GetBigAward then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1160007)
                else
                    self:CreatePortal(true)
                end
                local bigAward = self.TarotClass:GetBaseAward(1)
                for i = 1, #self.OnKeyAwardItem.c_a do
                    if self.OnKeyAwardItem.c_a[i].a_index == 1 then
                        local bol = true
                        self.OnKeyAwardItem.award.item = self.OnKeyAwardItem.award.item or {}
                        --判断大奖跟item或者overflow里面哪个的sid和num都一样，放到奖励弹窗最前面
                        if self.OnKeyAwardItem.award.overflow then
                            for j = 1, #self.OnKeyAwardItem.award.overflow do
                                if
                                self.OnKeyAwardItem.award.overflow[j].type[1] == bigAward[1] and
                                    self.OnKeyAwardItem.award.overflow[j].type[2] == bigAward[2]
                                then
                                    local info = table.remove(self.OnKeyAwardItem.award.overflow, j)
                                    table.insert(self.OnKeyAwardItem.award.item, 1, info)
                                    bol = false
                                    break
                                end
                            end
                        end
                        if bol then
                            for j = 1, #self.OnKeyAwardItem.award.item do
                                if
                                self.OnKeyAwardItem.award.item[j].type[1] == bigAward[1] and
                                    self.OnKeyAwardItem.award.item[j].type[2] == bigAward[2]
                                then
                                    local info = table.remove(self.OnKeyAwardItem.award.item, j)
                                    table.insert(self.OnKeyAwardItem.award.item, 1, info)
                                    break
                                end
                            end
                        end
                        break
                    end
                end

                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    self.OnKeyAwardItem,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    true
                )
                self.OnKeyAwardItem = nil
                self.OnKeyCA = nil
                self.ActionState = _G.TaortCardState.None
            end
        end
    )
end

---获取对应索引的卡片
function MTTarotView:GetFaceByIndex(index)
    local len = #self.CardFaces
    for i = 1, len do
        if self.CardFaces[i].Index == index then
            return self.CardFaces[i]
        end
    end
end

---游戏重设
function MTTarotView:ResetGame()
    self:CreatePortal(false)
    self:GotoNext(
        function()
            _G.SortList(
                self.CardFaces,
                function(value)
                    return -value.Index
                end
            )
            local kvInfo = {}
            for i = 1, #self.CardFaces do
                local kv = {}
                kv.k = self.CardFaces[i].Index
                kv.v = self.CardFaces[i].FaceIndex
                table.insert(kvInfo, kv)
            end
            local msg = {}
            msg.activity_id = self.TarotClass.curActivityClass.activityID
            msg.info = kvInfo
            MTTarotNet:GetInstance():SetImage(msg, _G.handler(self, self.SetImageEnd))
        end
    )
end

---设置卡面
function MTTarotView:SetImageEnd()
    self.TarotClass:GetInfo(
        function()
            if _G.AppSetting.DEBUG then
                _G.Log("塔罗牌数据刷新完成")
            end
            -- local cycleFirstBol = self.TarotClass:CheckInCycleFirst()
            -- if cycleFirstBol then 
            --     self.TarotClass:FreshCycleData()
            -- end
            self:UpdateView()
            self.TarotClass.Info.big_award = nil
            self.GetBigAward = false
            self:UpdateBigAward()
            self.TarotClass:RefreshRedPoint()

            self.ActionState = _G.TaortCardState.None
        end
    )
end

---显示大奖信息
function MTTarotView:UpdateBigAward()
    if self.go_table.obj_add:GetActiveSelf() then
        if self.addeffect == nil then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_dianjitixing,
                self.go_table.obj_addeffect,
                function(obj)
                    if self.go_table == nil then
                        _G.DestroyObject(obj)
                        return
                    end
                    self.addeffect = obj
                end
            )
        end
    end
    local curAward = self.TarotClass.Info.big_award or {}
    if #curAward <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, true)
        if nil == self.BigAwardTipsEffect then
            --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.Ef_yindaodianji, self.go_table.obj_add)
            self.BigAwardTipsEffect = 1
        end
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, true)
    if nil == self.ItemEffect then
        self.ItemEffect = 1
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_BaseItemWithCount_cheng,
            self.go_table.obj_setItem,
            function(obj)
                self.ItemEffect = obj
            end
        )
    end

    local color = _G.StorageManager:GetInstance():GetItemQuality(curAward[1] == 0 and curAward[4] or curAward[1])
    self.go_table.aorimage_Color.SpriteName = _G.ItemBaseIconName[color]
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(curAward[1] == 0 and curAward[4] or curAward[1]))
    _G.UIUtils.SetItemNum(self.go_table, curAward[1] == 0 and curAward[5] or curAward[2])

    local cfg = _G.ConfigManager.item_cfg[curAward[1] == 0 and curAward[4] or curAward[1]]
    if cfg then
        local showElement = cfg.Type1 == 6 or cfg.Type1 == 13 or cfg.Type1 == _G.ItemCfgType.PetChip
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, showElement)
        if showElement then
            self.go_table.aorimage_element.SpriteName = ColorType[cfg.Quality]
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, false)
    end
end

function MTTarotView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return MTTarotView
