---初始化塔罗牌
function MTTarotView:InitCardFaces()
    local info = self.TarotClass.Info.info
    self.CardFaces = {}
    local csmIndex = 0
    local index = 1
    for j = 1, 5 do
        local len = self.go_table["obj_" .. j .. "p"]:GetChildCountE()
        for i = 1, len do
            local obj = self.go_table["obj_" .. j .. "p"]:GetChildE(i - 1)

            local face = self:AddComponent(obj, MTTarotCardFace.New(obj, info[index].index, info[index].image, self, self.TarotClass))

            if info[index].a_index == 1 then
                csmIndex = info[index].index
            end
            table.insert(self.CardFaces, face)
            index = index + 1
        end
    end

    if csmIndex > 0 then
        self.GetBigAward = true
        self:CreatePortal(true)
    end
end

---随机位置
function MTTarotView:RandomEndPos()
    local endPos = {}
    local allPos = {}
    local len = #self.CardFaces
    for i = 1, len do
        local facetemp = self.CardFaces[i]
        table.insert(allPos, facetemp)
    end
    for _ = 1, len do
        local num = _G.Mathf.Random(1, #allPos)
        table.insert(endPos, allPos[num])
        table.remove(allPos, num)
    end
    return endPos
end

---进入下一阶段
function MTTarotView:GotoNext(callBack)
    local aa = {}
    for _ = 1, 5 do
        local endPos = self:RandomEndPos()
        table.insert(aa, endPos)
    end

    local callIndex = 0
    local cc = {}
    local len = #self.CardFaces
    for i = 1, len do
        local bb = {}
        for j = 1, 5 do
            table.insert(bb, { aa[j][i].x, aa[j][i].y, aa[j][i].z, aa[j][i].Index })
        end
        table.insert(cc, bb)
    end
    for i = 1, #cc do
        local bb = cc[i]
        local face = self.CardFaces[i]
        face:GotoNext(
            bb,
            function()
                callIndex = callIndex + 1
                if callIndex >= len then
                    callBack()
                end
            end
        )
    end
end

---获取排行数据(排行榜已屏蔽)
function MTTarotView:OnGetRankInfo()
    MTTarotNet:GetInstance():GetRank(
        function(rankPb, delayRanks)
            ---@param selfRankPb rank.s2c_get_rank_num
            MTTarotNet:GetInstance():GetSelfRank(
                function(selfRankPb)
                    if selfRankPb.ack ~= 1 then
                        return
                    end
                    self:UpdateRank(rankPb, selfRankPb)
                end,
                self.TarotClass.curActivityClass.activityID,
                delayRanks
            )
        end,
        self.TarotClass.curActivityClass.activityID
    )
end

---刷新开牌排行榜展示(排行榜已屏蔽)
---@param rankPb rank.s2c_rank_activity_lucky_draw
---@param selfRankPb rank.s2c_get_rank_num
function MTTarotView:UpdateRank(rankPb, selfRankPb)
    ---@type DrawUpMainView._obj_myrankItem_GoTable
    local myGoTable = _G.GetAutoGoTable(self.go_table.obj_myrankItem)
    local playerModel = _G.PlayerModel:GetInstance()
    myGoTable.aortext_rankname.text = playerModel:GetName()
    local myRank = selfRankPb.index
    if myRank >= 1 and myRank <= 3 then
        myGoTable.aorimage_rankIcon:SetActiveE(1)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", myRank))
    elseif selfRankPb.value == 0 then
        myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(1)
    else
        myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aortext_rankscore.text = (myRank == 0 or myRank > 1000) and "1000+" or myRank
    end
    if rankPb and rankPb.ranks then
        self.rankInfo = rankPb
    else
        self.rankInfo = { ranks = {} }
    end
    if not self.rankScroll then
        self.go_table.scrollloopvectical_rankList:InitItemData(3, _G.handler(self, self.UpdateRankItem))
        self.rankScroll = self.go_table.scrollloopvectical_rankList
    else
        self.rankScroll:UpdateCount(3)
    end
end

--- (排行榜已屏蔽)
function MTTarotView:UpdateRankItem(csIndex, obj)
    if csIndex < 0 then
        return
    end
    local luaIndex = csIndex + 1
    ---@type DrawUpMainView._obj_rankItem_GoTable
    local goTable = _G.GetAutoGoTable(obj)
    local rankInfo = self.rankInfo.ranks[luaIndex]
    local posRank = luaIndex
    if posRank >= 1 and posRank <= 3 then
        goTable.aortext_rankscore:SetActiveE(0)
        goTable.aorimage_rankIcon:SetActiveE(1)
        goTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", posRank))
    else
        goTable.aorimage_rankIcon:SetActiveE(0)
        goTable.aortext_rankscore:SetActiveE(1)
        goTable.aortext_rankscore.text = _G.GetLangPackValue(90023300031, posRank)
    end
    if rankInfo and rankInfo.role_info and rankInfo.role_info.uid > 0 and rankInfo.rank == posRank then
        goTable.aortext_rankname.text = rankInfo.role_info.name
    else
        goTable.aortext_rankname.text = _G.GetLangPackValue(90022300109)
    end
end

---更新界面
function MTTarotView:UpdateView()
    -- self.go_table.aortext_condition.text = _G.GetLangPackValue(90029300043, self.TarotClass.Info.cfg_info.rank_con)
    self.go_table.aorimage_title:SetNativeSize()
    local cycleBol, term = self.TarotClass:IsCycleAward(self.TarotClass.Info.term)
    local txt = cycleBol and 90034541004 or 90031400007
    self.go_table.aortext_lc.text = _G.string.format(_G.LangUtil.GetLangPackValue(txt, term))
    self.go_table.aortext_downdesc.text = _G.GetLangPackValue(90031400010)
    self.EndTime = self.TarotClass:GetTime()
    if nil == self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self:UpdateTime(0)
end

---更新时间
function MTTarotView:UpdateTime(fix)
    if self.EndTime <= 0 then
        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90026100053)
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    else
        self.EndTime = self.EndTime - fix
        local time = string.format("%s<color=#96ce51>%s</color>", _G.LangUtil.GetLangPackValue(90022500595), _G.TimeUtil.TranslateSecondForStrSixVsSix(self.EndTime))
        self.go_table.aortext_time.text = time
    end
end

