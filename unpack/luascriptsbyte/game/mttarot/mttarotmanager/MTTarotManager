---获取五行招募累计GM数据
function MTTarotManager:GetData(activityID)
    if self.TarotClass and self.TarotClass[activityID] and self.self.TarotClass[activityID]:GetTime() > 0 then
        return self.TarotClass[activityID]
    end
    return nil
end

