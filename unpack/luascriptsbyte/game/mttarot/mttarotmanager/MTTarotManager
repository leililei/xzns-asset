function MTTarotManager:UIClosed(name)
    if name == _G.ConfigManager.ui_cfg.MTTarotPackView.Name then
        local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MTTarotPackView.Name)
