local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class MTTarotModel : ActivitySynTypeBase 塔罗牌
local MTTarotModel = _G.BaseClass("MTTarotModel", base)
--ui界面的塔罗牌总数，用来判断服务器拉的数据全不全
local MTCardNum = 22 

function MTTarotModel:__init(activity)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    base.__init(self, activity)
    self:RefreshRedPoint()
end

---进入活动主体
function MTTarotModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTTarotView.Name, self)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function MTTarotModel:OnActivityStateChanged(_, state)
    self:RefreshRedPoint()
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MTTarotView.Name)
        if view then
            view:Close()
        end
        --活动已关闭
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

function MTTarotModel:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.UpdateInitData)
    )
end
function MTTarotModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end

---获取GM数据
---@param info activity.i_activity_self_info
function MTTarotModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function MTTarotModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---获取活动代币id
function MTTarotModel:GetCoinId()
    return self.Info.cfg_info.coin_id
end

---获取活动代币数量
function MTTarotModel:GetCoinNum()
    for key, value in pairs(self.Info.coin_list) do 
        if value.k == self.Info.cfg_info.coin_id then 
            return value.v
        end
    end
    return 0
end

---初始化数据
---@param info activity.i_activity_self_info
function MTTarotModel:SetSelfData(info)
    self.Info = info.tarot1
    self.Info.coin_list = self.Info.coin_list or {{k = self.Info.cfg_info.coin_id, v = 0}}
    if _G.AppSetting.DEBUG then
        _G.Log(self.Info, "塔罗牌完整数据")
        _G.Log(self.Info.coin_list, "塔罗牌代币数量")
        _G.Log(self.Info.cfg_info.coin_id, "塔罗牌代币id")
    end
    require "MTTarotManager":GetInstance():SetData(self, self.curActivityClass.activityID)

    --如果不全就重新设置卡面数据
    if nil == self.Info.info or #self.Info.info < MTCardNum then
        local msg = {}
        local infokv = {}
        local drawInfo = {}
        for i = 1, 22 do
            local kv = {}
            kv.k = i
            kv.v = i
            table.insert(infokv, kv)
            local dinfo = {}
            dinfo.index = i
            dinfo.image = i
            dinfo.a_index = 0
            table.insert(drawInfo, dinfo)
        end
        msg.info = infokv
        msg.activity_id = self.curActivityClass.activityID
        self.Info.info = drawInfo
        require "MTTarotNet":GetInstance():SetImage(msg, function(...)
            self:GetInfo()
        end)
    end

    _G.SortList(
        self.Info.info,
        function(a)
            return -a.index
        end
    )

    self.SyTime = self:GetTime()
    if self.SyTime > 0 then
        self.SyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GoSyTime, self, false, false, true)
        self.SyTimer:Start()
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawFLOR.id)
    end

    if self.CallBack then
        self.CallBack()
        self.CallBack = nil
    end
end

function MTTarotModel:GoSyTime(elapsed)
    self.SyTime = self.SyTime - elapsed
    if self.SyTime <= 0 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
end

---剩余时间计算
function MTTarotModel:GetTime()
    local timeShengYu = 0
    if self.curActivityClass and self.curActivityClass.cfg then
        timeShengYu =
            self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time -
            _G.TimeUtil.GetServerUnixTime()
    end
    return timeShengYu
end

---增加代币
function MTTarotModel:AddCoin(num)
    local final = num
    for key, value in pairs(self.Info.coin_list) do 
        if value.k == self.Info.cfg_info.coin_id then 
            value.v = value.v + num
            final = value.v
        end
    end
    local tmp = {}
    _G.table.insert(tmp, self.Info.cfg_info.coin_id)
    _G.table.insert(tmp, num)
    _G.table.insert(tmp, final)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
    -- if num < 0 then 
    --     _G.StorageManager.ConsumeItem()
    -- end
    self:RefreshRedPoint()
end

---现在是否是循环阶段
function MTTarotModel:CheckInCycle(term)
    local term = term or self.Info.term
    local cycleIndex = #self.Info.cfg_info.big_award - 1
    return self.Info.cfg_info.big_award[cycleIndex].term <= term
end

---现在是否是循环阶段第一层
function MTTarotModel:CheckInCycleFirst(term)
    local term = term or self.Info.term
    local cycleIndex = #self.Info.cfg_info.big_award - 1
    return self.Info.cfg_info.big_award[cycleIndex].term == term
end

---清空循环轮次数
function MTTarotModel:FreshCycleData()
    local cycleIndex1 = #self.Info.cfg_info.big_award - 1
    local cycleIndex2 = #self.Info.cfg_info.big_award
    for k, v in pairs(self.TarotClass.Info.big_count) do 
        if v.term == self.Info.cfg_info.big_award[cycleIndex1].term or v.term == self.Info.cfg_info.big_award[cycleIndex2].term then 
            self.TarotClass.Info.big_count[k].count = 0
        end
    end
end

---是否是循环阶段
function MTTarotModel:IsCycleAward(term)
    local bol = self:CheckInCycle(term)
    if bol then 
        local cycleIndex = #self.Info.cfg_info.big_award - 1
        return true, term - self.Info.cfg_info.big_award[cycleIndex].term + 1
    else 
        return false, term
    end
end

---获取基础奖励数据
function MTTarotModel:GetBaseAward(aindex)
    if aindex == 1 then
        return self.Info.big_award
    else
        return self.Info.cfg_info.base_award[aindex - 1].award
    end
end

---获取大奖奖励数据
function MTTarotModel:GetBigAward(aindex)
    return self.Info.cfg_info.big_award[aindex]
end

---修改当前奖励
function MTTarotModel:ChangeFaceByIndex(aindex, index)
    for i = 1, #self.Info.info do
        if self.Info.info[i].index == index then
            self.Info.info[i].a_index = aindex
            break
        end
    end
end

function MTTarotModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    if self.SyTimer then
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
    base.Dispose(self)
end

---所有活动解析完成后运行
function MTTarotModel:LaterInitFunction()
    local redPointId = self:GetRedpointIDByIndex(1)
    local taskActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.curActivityClass:GetJumpType(self.curActivityClass.activityID), 1)
    if taskActivity then 
        require "RedPointManager":GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.MTTarotTask.id, taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
    local bpActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.curActivityClass:GetJumpType(self.curActivityClass.activityID))
    if bpActivity then 
        require "RedPointManager":GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.MTTarotTask.id, bpActivity:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.MTTarotTask.id)
end

---绑定子活动
function MTTarotModel:GetOtherActivityRedPointIds()
    return {10014}
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function MTTarotModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测活动条件（没开到大奖并且有券）
function MTTarotModel:CheckRedPoint()
    local isOpenBig = false
    local len = #self.Info.info
    for i = 1, len do
        if self.Info.info[i].a_index == 1 then
            isOpenBig = true
            break
        end
    end
    if not isOpenBig and self:GetCoinNum() > 0 then
        return 1
    end
    return 0
end

---刷新奖励红点
function MTTarotModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function MTTarotModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

return MTTarotModel
