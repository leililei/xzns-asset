---@class MTTarotPassTaskInfoData
local MTTarotPassTaskInfoData = _G.BaseClass("MTTarotPassTaskInfoData", _G.LogicClass)

function MTTarotPassTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function MTTarotPassTaskInfoData:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TarotPassTaskView.Name, self.curActivityClass)
end
---领取奖励
function MTTarotPassTaskInfoData:GetAward(ids, call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        { activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            local GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(
                self:GetJumpModelType(),
                self.curActivityClass:GetJumpType()
            )
            local ActivityID = GetJumpType:GetActivityID()
            local exp = 0
            local coin = 0
            for _, v in pairs(ids) do
                local task = self.activity:GetTaskData(v)
                if not msg.award or not msg.award.item then
                    msg.award = { item = {} }
                end
                -- if task.Cfg.other_award[2] then
                --     local coinId = require "TarotManager":GetInstance():GetCoinId(ActivityID)
                --     local tb = _G.StorageManager:GetInstance():SimulationAward(coinId, task.Cfg.other_award[2].num)
                --     if task.Cfg.other_award[2].num > 0 then
                --         _G.table.insert(msg.award.item, { type = tb })
                --         coin = coin + task.Cfg.other_award[2].num
                --     end
                -- end
                if task.Cfg.other_award[1] then
                    exp = exp + task.Cfg.other_award[1].num
                end

                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.activity:RefreshRedPoint()
            --require "MTTarotManager":GetInstance():AddCoin(coin, ActivityID)
            --加战令经验
            local battleActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10027,
                self.curActivityClass:GetJumpType(),
                self.curActivityClass:GetMainType()
            )
            if battleActivity then
                battleActivity:GetActivityTypeCls():AddExp(battleActivity:GetActivityID(), exp)
            end

            if call then
                call()
            end
        end
    )
end
function MTTarotPassTaskInfoData:GetJumpModelType()
    return 10068
end
return MTTarotPassTaskInfoData
