---获取排行信息
---@param pbData rank.c2s_rank_public PB数据
---@param callback function 完成回调
function MTTarotNet:GetRank(callback, activityId)
    ---前三排名最少抽卡数
    local rank3 = _G.ConfigManager.discrete_cfg[108603][1][1]

    local port =
        self:Access(
        _G.ConfigManager.net_map.game_rank_activity_tarot,
        {page = 1, id = activityId},
        _G.handler(self, self.Callback)
    )
    ---@param msg rank.s2c_rank_activity_lucky_draw
    self.Call[port] = function(msg)
        local delayRanks = 0
        msg.ranks = msg.ranks or {}
        for i = 1, #msg.ranks do
            local rankItem = msg.ranks[i]
            if i <= 3 and rankItem.value[1] < rank3 and delayRanks <= 0 then
                delayRanks = 4 - i
            end
            msg.ranks[i].rank = i + delayRanks
        end
        if callback then
            callback(msg, delayRanks)
        end
    end
end

---获取个人排名
---@param delayRanks number 延迟排名，不足200抽时不进前三，所以后续排名都需要后退
function MTTarotNet:GetSelfRank(callback, activityId, delayRanks)
    local port =
        self:Access(
        _G.ConfigManager.net_map.game_rank_get_rank_num,
        {type = activityId},
        _G.handler(self, self.Callback)
    )
    ---@param msg rank.s2c_get_rank_num
    self.Call[port] = function(msg)
        if msg.ack ~= 1 then
            return
        end
        local myScore = msg.value
        local myRank = msg.index
        ---前三排名最少抽卡数
        local rank3 = _G.ConfigManager.discrete_cfg[108603][1][1]
        if myScore < rank3 and myRank > 0 then
            msg.index = myRank + delayRanks
        end
        if callback then
            callback(msg)
        end
    end
end

