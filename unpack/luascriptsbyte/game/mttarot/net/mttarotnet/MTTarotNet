local base = require "BaseGameNet"

---@class MTTarotNet : BaseGameNet	通信协议
local MTTarotNet = _G.BaseClass("MTTarotNet", base)

---@return MTTarotNet MTTarotNet
function MTTarotNet:GetInstance()
