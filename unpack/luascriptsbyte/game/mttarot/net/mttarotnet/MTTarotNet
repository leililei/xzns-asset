end

---选择大奖
---@param pbData activity_tarot.c2s_set_award PB数据
---@param callback function 完成回调
function MTTarotNet:SetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_tarot1_set_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

