---获取一个文本弹幕实例
---@param type _G.LiaotianDanMuType
---@return FloatMessagesView._obj_text_GoTable
function FloatMessagesView:GetMessageTextItem(type)
    local item, releaseTextItems, activeTextItems
    if type == danmuType.afk then
        releaseTextItems = self.releaseTextItems
        activeTextItems = self.activeTextItems
    elseif type == danmuType.sociaty then
        releaseTextItems = self.sociatyreleaseTextItems
        activeTextItems = self.sociatyactiveTextItems
    end
    if #releaseTextItems > 0 then
        item = table.remove(releaseTextItems, 1)
    else
        local obj
        if type == danmuType.afk then
            obj = _G.InstantiateObject(self.go_table.obj_text, self.go_table.obj_afk)
        elseif type == danmuType.sociaty then
            obj = _G.InstantiateObject(self.go_table.obj_text, self.go_table.obj_sociaty)
        end
        item = _G.GetAutoGoTable(obj)
    end
    item.gameObject:SetActiveE(1)
    table.insert(activeTextItems, item)
    return item
end

---回收文本弹幕实例
---@param type _G.LiaotianDanMuType
---@param item FloatMessagesView._obj_text_GoTable
function FloatMessagesView:ReleaseMessageTextItem(item, type)
    item.transform:DOKill()
    item.gameObject:SetActiveE(0)
    local index, activeTextItems, releaseTextItems
    if type == danmuType.afk then
        activeTextItems = self.activeTextItems
        releaseTextItems = self.releaseTextItems
    elseif type == danmuType.sociaty then
        activeTextItems = self.sociatyactiveTextItems
        releaseTextItems = self.sociatyreleaseTextItems
    end
    index = utils.findIndex(activeTextItems, item)
    if index >= 1 then
        table.remove(activeTextItems, index)
    end
    table.insert(releaseTextItems, item)
end

---回收所有文本弹幕实例
function FloatMessagesView:ReleaseAllMessageTextItems()
    for _, item in ipairs(self.activeTextItems) do
        item.transform:DOKill()
        item.gameObject:SetActiveE(0)
        table.insert(self.releaseTextItems, item)
    end
    self.activeTextItems = {}
    for _, item in ipairs(self.sociatyactiveTextItems) do
        item.transform:DOKill()
        item.gameObject:SetActiveE(0)
        table.insert(self.sociatyreleaseTextItems, item)
    end
    self.sociatyactiveTextItems = {}
end

