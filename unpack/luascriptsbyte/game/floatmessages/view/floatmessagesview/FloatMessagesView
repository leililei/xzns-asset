--region =================新版 通用消息=====================
---@param IsClearAll boolean 是否需要清除之前的数据
---@param maxCount int 加载弹幕上限
---@param windowName string 窗口名
---@param args table 弹幕数据
function FloatMessagesView:GetDanmuList(args, maxCount, IsClearAll)
    if IsClearAll then
        self:ClearAllMessages()
    end
    self.IsNewCommonDanmu = true

    -- 激活了在主界面或者在公会界面 触发了功能弹幕以后又打开了公会或者主界面 return掉
    if (self.mainInAfk or self.mainInSociaty) and not IsClearAll then
        self.IsNewCommonDanmu = false
        self:ClearAllMessages()
        return
    end

    for i = 1, #args do
        self:CommonShowItem(args[i], maxCount * 10)
    end
end

---通用弹幕消息
function FloatMessagesView:CommonShowItem(args, maxCount)
    --- 强制走afk的分组显示 传入时就代表着此弹幕必须显示 所有判断在外界
    self.go_table.obj_afk:SetActiveE(1)

    if not self.enabled then
        return
    end
    local freeTD = self:GetFreeTrackData(danmuType.afk)
    if freeTD then
        --- 还用afk的type
        self:ShowMessageCommon(args, freeTD, danmuType.afk)
    else
        --缓存消息数据
        if not self.DanmuList then
            self.DanmuList = {}
        end
        table.insert(self.DanmuList, args)
        --消息数量超出上限
        if maxCount > 1 and #self.DanmuList > maxCount then
            table.remove(self.DanmuList, 1)
        end

        self:StartDistributeTimer(danmuType.afk)
    end
end

---新版 显示一条弹幕消息
--- 组装要传入的弹幕Item结构 content为数据 color为颜色 expressionPath 为表情路径 tag频道标签
--- name为玩家名 【除了表情弹幕 其他消息一律拼好content为数据再传】
function FloatMessagesView:ShowMessageCommon(args, trackData, Type)
    if not trackData then
        trackData = self:GetFreeTrackData(Type)
    end
    if not trackData then
        return
    end

    local item
    if args.expressionPath then
        --玩家表情
        local expressionPath = args.expressionPath
        item = self:GetMessageImageItem(Type)
        item.aorrawimage_image:LoadImage(expressionPath)
        item.obj_split:SetActiveE(1)
    elseif args.content then
        --文本消息
        local content = args.content
        -- if self.maxContentLength > 0 and _G.string.getStringCharCount(content) > self.maxContentLength then
        --     --文本长度限制
        --     content = _G.string.utf8sub(content, 1, self.maxContentLength) .. "..."
        -- end
        item = self:GetMessageTextItem(Type)
        item.aortext_content.text = args.content
        item.aorimage_Icon:SetActiveE(0)
        if args.atlas and args.icon then
            item.aorimage_Icon:LoadAtlasSprite(
                args.atlas, args.icon)
            item.aorimage_Icon:SetActiveE(1)
        end
        item.obj_split:SetActiveE(0)
    end

    --频道标签
    local tag = args.tag
    item.aortext_tag:SetActiveE(tag and #tag > 0 and 1 or 0)
    if tag then
        item.aortext_tag.text = tag
    end
    --玩家名称
    item.aortext_name:SetActiveE(args.name and 1 or 0)
    if args.name then
        item.aortext_name.text = args.name
    end

    item.msg = msg
    self:SetMessageTween(item, trackData, Type)
end

