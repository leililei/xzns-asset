---收到一条新消息
---@protected
---@param msg chat.i_chat
function FloatMessagesView:OnNewMessage(msg)
    if not self.enabled then
        return
    end
    --限制消息类型: 玩家消息丶系统消息丶玩家表情
    if msg.type ~= _G.ChatInfoType.chat and
        msg.type ~= _G.ChatInfoType.system and
        msg.type ~= _G.ChatInfoType.PlayerEmoji then
        return
    end
    --限制消息时间:
    if msg.time < self.time then
        return
    end
    --- 兼容 当有消息进入时 如果有新版通用弹幕消息在播放 返回
    if self.DanmuList then
        return
    end

    local freeTD = self:GetFreeTrackData(danmuType.afk)
    if freeTD then
        self:ShowMessage(msg, freeTD, danmuType.afk)
    else
        --缓存消息数据
        if not self.messages then
            self.messages = {}
        end
        table.insert(self.messages, msg)
        --消息数量超出上限
        if MessageMaxCount > 1 and #self.messages > MessageMaxCount then
            table.remove(self.messages, 1)
        end

        self:StartDistributeTimer(danmuType.afk)
    end

    if msg.channel == _G.ChatType.union and msg.type ~= _G.ChatInfoType.system then
        local freeSTD = self:GetFreeTrackData(danmuType.sociaty)
        if freeSTD then
            self:ShowMessage(msg, freeSTD, danmuType.sociaty)
        else
            --缓存消息数据
            if not self.sociatymessages then
                self.sociatymessages = {}
            end
            table.insert(self.sociatymessages, msg)
            --消息数量超出上限
            if SociatyMessagesMaxCount > 1 and #self.sociatymessages > SociatyMessagesMaxCount then
                table.remove(self.sociatymessages, 1)
            end
            self:StartDistributeTimer(danmuType.sociaty)
        end
    end
end

---@param msg chat.i_chat
function FloatMessagesView:OnNewMessageTestAppend10(msg)
    if msg.role_info and msg.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        ---@type chat.i_chat
        local copy = {}
        for k, v in pairs(msg) do
            copy[k] = v
        end
        copy.role_info.uid = 0
        msg = copy
    end
    for i = 1, 20 do
        _G.DelayDo(i * 0.5, function()
            if self:IsNil() then
                return
            end
            self:OnNewMessage(msg)
        end)
    end
end

---删除一条新消息
---@protected
---@param msg chat.p2c_del_chat
function FloatMessagesView:OnDelMessage(data)
    --因为收到的chat.i_chat消息中没有包含chat_id信息, 因此此处只能通过channel和玩家uid进行屏蔽(将屏蔽此玩家在目标频道的所有消息)
    --过滤缓存消息
    if self.messages then
        for i = #self.messages, 1, -1 do
            local msg = self.messages[i]
            if msg.role_info and msg.channel == data.channel and msg.role_info.uid == data.role_uid then
                table.remove(self.messages, i)
            end
        end
    end
    --处理显示中的节点信息
    if self.activeTextItems then
        for i = #self.activeTextItems, 1, -1 do
            ---@type chat.i_chat
            local msg = self.activeTextItems[i].msg
            if msg and msg.role_info and msg.channel == data.channel and msg.role_info.uid == data.role_uid then
                self:ReleaseMessageTextItem(self.activeTextItems[i], danmuType.afk)
            end
        end
    end
    if self.activeImageItems then
        for i = #self.activeImageItems, 1, -1 do
            ---@type chat.i_chat
            local msg = self.activeImageItems[i].msg
            if msg and msg.role_info and msg.channel == data.channel and msg.role_info.uid == data.role_uid then
                self:ReleaseMessageImageItem(self.activeImageItems[i], danmuType.afk)
            end
        end
    end
    if self.sociatymessages then
        for i = #self.sociatymessages, 1, -1 do
            local msg = self.sociatymessages[i]
            if msg.role_info and msg.channel == data.channel and msg.role_info.uid == data.role_uid then
                table.remove(self.sociatymessages, i)
            end
        end
    end
    --处理显示中的节点信息
    if self.sociatyactiveTextItems then
        for i = #self.sociatyactiveTextItems, 1, -1 do
            ---@type chat.i_chat
            local msg = self.sociatyactiveTextItems[i].msg
            if msg and msg.role_info and msg.channel == data.channel and msg.role_info.uid == data.role_uid then
                self:ReleaseMessageTextItem(self.sociatyactiveTextItems[i], danmuType.sociaty)
            end
        end
    end
    if self.sociatyactiveImageItems then
        for i = #self.sociatyactiveImageItems, 1, -1 do
            ---@type chat.i_chat
            local msg = self.sociatyactiveImageItems[i].msg
            if msg and msg.role_info and msg.channel == data.channel and msg.role_info.uid == data.role_uid then
                self:ReleaseMessageImageItem(self.sociatyactiveImageItems[i], danmuType.sociaty)
            end
        end
    end
end

---窗口变化事件
---@protected
---@return void
function FloatMessagesView:OnWindowChange()
    ---@type UIBaseView[]
    local windows = _G.UIManager:GetInstance():GetAllWindows()
    if not windows or _G.table.isEmptyOrNil(windows) then
        return
    end

    --仅在战斗页面/主页面放置中显示弹幕
    if not self.ignoreWindows then
        local cfgs = {
            _G.ConfigManager.ui_cfg.ShadowView,
            _G.ConfigManager.ui_cfg.ShadowTopView,
            _G.ConfigManager.ui_cfg.GameNetTipsView,
            _G.ConfigManager.ui_cfg.HUDView,
            _G.ConfigManager.ui_cfg.MainSceneView,
            _G.ConfigManager.ui_cfg.ResLoadingView,
            _G.ConfigManager.ui_cfg.ChatDefultRootView, --mini chat view
            _G.ConfigManager.ui_cfg.QuickUseTipView,
            _G.ConfigManager.ui_cfg.FloatTipsView,
            _G.ConfigManager.ui_cfg.FloatMessagesView,
            _G.ConfigManager.ui_cfg.BattleView,
            _G.ConfigManager.ui_cfg.SociatyMobaGuessView,
            _G.ConfigManager.ui_cfg.SociatyMobaBattleResultView,
            _G.ConfigManager.ui_cfg.SociatyMobaChatView,
            _G.ConfigManager.ui_cfg.SociatyMobaEmbattleFaceView,
            _G.ConfigManager.ui_cfg.ScrollerView,
        }
        ---忽略的View列表
        self.ignoreWindows = {}
        for _, cfg in pairs(cfgs) do
            if cfg then
                self.ignoreWindows[cfg.Name] = true
            end
        end
    end
    local isShow = true
    for _, view in pairs(windows) do
        if not self.ignoreWindows[view.Name] and view.Active then
            if view.Name == _G.ConfigManager.ui_cfg.MainView.Name then
                self.mainInAfk = _G.MainManager:GetInstance():IsToggledAfkWindow(false)
                self.mainInSociaty = _G.MainManager:GetInstance():IsToggledSociatyWindow(false)
                isShow = self.mainInAfk or self.mainInSociaty
            else
                isShow = false
            end
            if not isShow then
                break
            end
        end
    end
    self:SetShow(isShow)
end

