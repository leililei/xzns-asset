---二分查找服务器区间(数据源必需是有序排列)
---@param array number[][]
---@param serverId number 服务器ID
---@return number[]
local function findServerGroup(array, serverId)
    local left, right = 1, #array

    while left <= right do
        local mid = math.floor((left + right) / 2) --取中间位置

        local startId, endId = table.unpack(array[mid])
        if serverId >= startId and serverId <= endId then
            return array[mid]
        elseif serverId > endId then
            --目标在右半部分, 调整左边界
            left = mid + 1
        else
            --目标在左半部分, 调整右边界
            right = mid - 1
        end
    end
    return nil
end

---@class CommunityView : UIBaseView	中文描述
local CommunityView = _G.BaseClass("CommunityView", _G.UIBaseView)
local rewardCfgId = 100134

function CommunityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function CommunityView:OnCreate()
    self:LoadRewardCfg()
    --获取本服id
    local curServer = _G.ServerManager:GetInstance():GetCurServer()
    self:LoadQRImage(curServer and curServer.ServerID or 0)
end

---加载二维码图案
---@param serverId number 服务器ID
function CommunityView:LoadQRImage(serverId)
    local group = findServerGroup(SERVER_GROUP, serverId) or SERVER_GROUP[1]
    if not group then
        return
    end
    self.go_table.aorrawimage_pic.color = _G.Color.New(1, 1, 1, 0)
    self.go_table.aorrawimage_pic:LoadImage(
        "Images/GroupQR/server_qr_" .. group[1],
        function()
            if self:IsNil() then
                return
            end
            --do anything
        end
    )
end

---加载奖励配置
function CommunityView:LoadRewardCfg()
    local rewards = _G.ConfigManager.discrete_cfg[rewardCfgId]
    if _G.table.isEmptyOrNil(rewards) then
        _G.LogError("没有在全局表中找到对应id的条目,请检查配置!")
        _G.LogError(rewardCfgId, "相关sid")
    else
        for _, v in pairs(rewards) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                self.go_table.obj_awardRoot,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    if item.go_table then
                        item.go_table.obj_Root:SetLocalScale(0.85, 0.85, 0.85)
                    end
                end
            )
        end
    end
end

function CommunityView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    end
end

function CommunityView:CloseView()
    self:Close()
end

return CommunityView
