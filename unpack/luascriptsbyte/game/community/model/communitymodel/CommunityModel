local base = require "ActivitySynTypeBase"
---@class CommunityModel : ActivitySynTypeBase	中文描述
local CommunityModel = _G.BaseClass("CommunityModel", base)
---创建对象时,入口构造函数
function CommunityModel:__init()
end

---进入活动主体
function CommunityModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommunityView.Name)
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "CommunityView_time"
    _G.CS.UnityEngine.PlayerPrefs.SetInt(key, nowtime)
    self:RefreshRedPoint()
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function CommunityModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.CommunityView.Name
end
---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function CommunityModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end
function CommunityModel:CheckRedPoint()
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "CommunityView_time"
    if _G.CS.UnityEngine.PlayerPrefs.HasKey(key) then
        return 0
    else
        return 1
    end
end
---刷新奖励红点
function CommunityModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function CommunityModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
---销毁对象时,析构函数
function CommunityModel:Dispose()
end

return CommunityModel
