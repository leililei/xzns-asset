---当前奥义升级
function SociatyProfoundView:LevelUp()
    if SociatyProfoundModel:GetInstance():CheckPointIsMaxLv(self.curElement, self.curPoint) then
        return
    end
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    SociatyProfoundModel:GetInstance():TryBestUpLevel(
        self.curElement,
        self.curPoint,
        function()
            --[[self.lvUpEff:SetParentE(self.go_table["obj_skill" .. self.curPoint])
            self.lvUpEff:SetActiveE(0)
            self.lvUpEff:SetActiveE(1)
            self:RefreshArrayEff()]]
            local pre = SociatyProfoundModel:GetInstance():CheckPrePoint(self.curElement, self.curPoint)
            local isMax = SociatyProfoundModel:GetInstance():CheckPointIsMaxLv(self.curElement, self.curPoint)
            if self.levelUpEff then
                self.levelUpEff:SetActiveE(0)
                self.levelUpEff:SetActiveE(1)
            else
                _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_jueseshengji,
                        self.go_table.obj_eff,
                        function(trans)
                            self.levelUpEff = trans
                            trans:SetLocalPosition(0, 64, 0)
                            trans:SetLocalScaleXYZ(1)
                        end
                )
            end
            if isMax or not pre then
                self:ChangePoint(self.curPoint % 8 + 1)
            else
                self:UpdateSkillDetail()
            end
            self:UpdateProfound()
            local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(power, offset)
            end
        end
    )
end

function SociatyProfoundView:ResetAll()
    SociatyProfoundModel:GetInstance():ResetAll(
        self.curElement,
        function()
            self:ChangePoint(1, true)
            self:UpdateProfound()
            self:RefreshArrayEff()
        end
    )
end

---切换五行
function SociatyProfoundView:ChangeElement(eleType)
    if eleType == self.curElement then
        return
    end
    self.curElement = eleType
    self.go_table.aorimage_select:SetParentE(self.eleBtn[eleType])
    self.go_table.aorimage_select:SetSiblingIndexE(0)
    self:ChangePoint(SociatyProfoundModel:GetInstance():GetFirstChoosePoint(self.curElement), true)
    self:UpdateProfound()
end

---切换点位
function SociatyProfoundView:ChangePoint(index, force)
    if index == self.curPoint and not force then
        return
    end
    self.curPoint = index
    self:UpdateSkillDetail()
end

---设置属性
---@param prop AttributeClass
function SociatyProfoundView:ShowProp(attribute)
    local numStr, num, tb, key, showList, index
    local showProp = function(prop, startIndex, isPer)
        showList = {}
        for i, v in pairs(prop) do
            table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid})
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        for i = 1, #showList do
            key = showList[i].key
            index = startIndex + i
            if self.propItem[index] == nil then
                self.propItem[index] = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_propContent)
            end
            if self.propItem[index] then
                tb = _G.GetAutoGoTable(self.propItem[index])
                tb.aortext_Name.text = _G.AttrType[key].des
                tb.aorimage_icon.SpriteName = _G.AttrTypeIcon[key]
                num = prop[key]
                numStr = self:ToPropNum(key, num, isPer)
                tb.aortext_Num.text = "+" .. numStr
            end
        end
    end
    local prop = attribute:GetAttrByName(_G.AttCountType.other)
    showProp(prop, 0)
    local start = _G.table.count(prop)
    prop = attribute:GetAttrByName(_G.AttCountType.basePercent)
    showProp(prop, start, true)
end

---刷新奥义盘信息
function SociatyProfoundView:UpdateProfound()
    self:UpdateAllSkill()
    self.go_table.aorimage_element.SpriteName = EleIconName[self.curElement]
    --ZHJH-5585
    --self.go_table.aorimage_slider.fillAmount = SociatyProfoundModel:GetInstance():CalFillAmount(self.curElement)
    local sumLv = SociatyProfoundModel:GetInstance():GetElementSumLv(self.curElement)
    self.go_table.aortext_proLv.text = GetLangPackValue(ProfoundLv[self.curElement], sumLv)
    self.go_table.aortext_propTitle.text = GetLangPackValue(TitleText[self.curElement])
    self.go_table.aorbtn_reset:SetActiveE(SociatyProfoundModel:GetInstance():GetElementSumLv(self.curElement) > 0 and 1 or 0)
    local attribute = SociatyProfoundModel:GetInstance():GetAllAttribute(self.curElement)
    self:ShowProp(attribute)
end

function SociatyProfoundView:UpdateAllSkill()
    for i = 1, #self.skillPointItem do
        self.skillPointItem[i]:Show(self.curElement, i == self.curPoint, self.skillPointIcon[i])
    end
end

---刷新技能信息
function SociatyProfoundView:UpdateSkillDetail()
    local lv = SociatyProfoundModel:GetInstance():GetElementPointLv(self.curElement, self.curPoint)
    local maxLv = SociatyProfoundModel:GetInstance():GetPointMaxLv(self.curPoint)
    local isMaxLv = lv >= maxLv
    self.go_table.aorimage_skillIcon.SpriteName = self.skillPointIcon[self.curPoint]
    self.go_table.aorimage_isMaxLv:SetActiveE(isMaxLv and 1 or 0)
    self.go_table.aorimage_array1:SetActiveE(isMaxLv and 0 or 1)
    self.go_table.aortext_after1:SetActiveE(isMaxLv and 0 or 1)
    self.go_table.aorimage_array2:SetActiveE(isMaxLv and 0 or 1)
    self.go_table.aortext_after2:SetActiveE(isMaxLv and 0 or 1)

    local pre, tip = SociatyProfoundModel:GetInstance():CheckPrePoint(self.curElement, self.curPoint)
    --local other, tip1 = SociatyProfoundModel:GetInstance():CheckOtherProfound(self.curElement)
    local other = true
    --self.go_table.aorbtn_lvUp:SetActiveE((pre and other) and 1 or 0)
    -- self.go_table.aorbtn_lvUp:SetGray(isMaxLv)
    local lvNum, cost = SociatyProfoundModel:GetInstance():GetCanUpMaxLevel(self.curElement, self.curPoint)
    if lvNum == 0 then
        lvNum = 1
    end
    self.go_table.aortext_lvUp.text = GetLangPackValue(90021800244, lvNum)
    local isGray = (pre and other) or  isMaxLv
    if not isGray then
        self.go_table.aorbtn_lvUp:SetGray(true)
        self.go_table.aorbtn_lvUp:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString("A9A9A9")
        self.go_table.aortext_lvUp.color = _G.ColorTools.FormatColorByString("434343")
    else
        self.go_table.aorbtn_lvUp:SetGray(false)
        self.go_table.aorbtn_lvUp:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString("FFFFFF")
        self.go_table.aortext_lvUp.color = _G.ColorTools.FormatColorByString("8C2D14")
    end
    self.go_table.aortext_upTip:SetActiveE(isGray and 0 or 1)
    local preRome = self.curPoint == 1 and RomeNum[8] or RomeNum[self.curPoint - 1]
    self.go_table.aortext_upTip.text =
        pre and GetLangPackValue(90021800225, "") or GetLangPackValue(90021800224, preRome, tip)

    for _, v in pairs(self.costItem) do
        v:SetActiveE(0)
    end
    self.go_table.obj_consume:SetActiveE(isGray and 1 or 0)
    local id = self.curPoint * 1000 + lv
    local cfg = lv > 0 and guild_skill_cfg[id] or nil
    local nextCfg
    if not isMaxLv then
        nextCfg = guild_skill_cfg[id + 1]
        local material1 = cfg and cfg.material or {}
        local cost = SociatyProfoundModel:GetInstance():CalCostMaterial(material1, nextCfg.material)
        self.go_table.aortext_after1.text = lv + 1
        self.go_table.aortext_after2.text = self:GetPropStr(nextCfg, nextCfg.attribute[1])
        ---@type SociatyProfoundView._obj_costItem_GoTable
        local tb
        local index = 1
        local currency_type_cfg = ConfigManager.currency_type_cfg
        local color
        local resConsumeT = {}
        for k, v in pairs(cost) do
            if v > 0 then
                if self.costItem[index] == nil then
                    self.costItem[index] = _G.InstantiateObject(self.go_table.obj_costItem, self.go_table.obj_cost)
                end
                self.costItem[index]:SetActiveE(1)
                tb = GetAutoGoTable(self.costItem[index])
                tb.obj_iconItem:RemoveAllChildren()
                local cfg = { [1] = k, [2] = v }
--[[            tb.aorrawimage_icon:LoadImage(currency_type_cfg[k].icon)
                tb.aortext_num.text = v
                color = _G.StorageManager:GetInstance():CheckItem(k, v) and "52311C" or "ff5656"
                tb.aortext_num.color = _G.ColorTools.FormatColorByString(color)]]
                table.insert(resConsumeT, {k, false, v})
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        cfg,
                        tb.obj_iconItem,
                        function(item)
                            if _G.IsNil(tb.aorrawimage_icon) then
                                _G.DestroyObject(item.gameObject)
                                return
                            end
                            item.gameObject:SetLocalScaleXYZ(0.9)
                            if item.ShowNumText then
                                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                            end
                        end
                )

                if not _G.StorageManager:GetInstance():CheckItem(k, v) then
                    self.go_table.aorbtn_lvUp:SetGray(true)
                    self.go_table.aorbtn_lvUp:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString("A9A9A9")
                    self.go_table.aortext_lvUp.color = _G.ColorTools.FormatColorByString("434343")
                end

                index = index + 1
            end
        end
        if self.go_table.obj_consume:GetActiveSelf() == 1 then 
            if self.go_table.ResConsume == nil then
                ---@type Params_ConsumeCompont
                local data = {}
                data.showNow = true
                data.textColorType = 4
                self.go_table.ResConsume =
                    self:AddComponent(
                    self.go_table.obj_consume,
                    require("ConsumeCompont").New(
                        self.go_table.obj_consume,
                        resConsumeT,
                        nil,
                        nil,
                        true,
                        data
                    )
                )
            else 
                self.go_table.ResConsume:RestRs(resConsumeT)
            end
        end
    end
    self.go_table.aorbtn_lvUp:SetActiveE(isMaxLv and 0 or 1)
    self.go_table.obj_consume:SetActiveE(isMaxLv and 0 or 1)
    self.go_table.aorimage_Max:SetActiveE(isMaxLv and 1 or 0)

    local key = cfg and cfg.attribute[1] or nextCfg.attribute[1]
    self.go_table.aortext_name1.text = GetLangPackValue(90020300062)
    self.go_table.aortext_name2.text = _G.AttrType[key].des
    self.go_table.aortext_before1.text = lv
    self.go_table.aortext_before2.text = self:GetPropStr(cfg, key)
end

function SociatyProfoundView:GetPropStr(cfg, key)
    local num = cfg and _G.tonumber(cfg.attribute[3]) or 0
    local aType =
        cfg and (cfg.attribute[2] == "1" and _G.AttCountType.other or _G.tonumber(cfg.attribute[2])) or
        _G.AttCountType.other
    num = _G.AttributeClassManager:GetInstance():GetValueWithName(key, num, aType)
    local isPer = (cfg and cfg.attribute[2] == "2") and true or false
    return self:ToPropNum(key, num, isPer)
end

---属性数字转换
---@param key string 属性key
---@param num number 属性值
---@return string 属性值文本
function SociatyProfoundView:ToPropNum(key, num, isPer)
    local numStr
    if _G.AttrType[key].percentage == 1 or isPer then
        num = num * 100
        num = _G.GameUtil.FormatNum(num)
        numStr = _G.tostring(num) .. "%"
    else
        num = _G.math.floor(num)
        num = _G.GameUtil.NumberWY(num)
        numStr = _G.tostring(num)
    end
    return numStr
end

