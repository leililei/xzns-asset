---按钮点击事件在这里派发
function SociatyProfoundView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 102)
    elseif go == self.go_table.aorbtn_lvUp then
        self:LevelUp()
    elseif go == self.go_table.aorbtn_reset then
        _G.PopWindowManager:GetInstance():ShowAllTips(250307, nil, _G.handler(self, self.ResetAll))
    elseif go == self.go_table.aorbtn_thunder then
        self:ChangeElement(EleType.Thunder)
    elseif go == self.go_table.aorbtn_wind then
        self:ChangeElement(EleType.Wind)
    elseif go == self.go_table.aorbtn_water then
        self:ChangeElement(EleType.Water)
    elseif go == self.go_table.aorbtn_fire then
        self:ChangeElement(EleType.Fire)
    elseif go == self.go_table.aorbtn_earth then
        self:ChangeElement(EleType.Earth)
    elseif go == self.go_table.aorbtn_god then
        self:ChangeElement(EleType.God)
    elseif go == self.go_table.aorbtn_pupopClose then
        self.go_table.obj_levelUp:SetActiveE(0)
    end
end

