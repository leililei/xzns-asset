local base = require("BaseGameNet")

---@class SociatyProfoundNet : BaseGameNet	通信协议
local SociatyProfoundNet = _G.BaseClass("SociatyProfoundNet", base)
---@return SociatyProfoundNet SociatyProfoundNet
function SociatyProfoundNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function SociatyProfoundNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_mysteries_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---确认选择应援队伍
function SociatyProfoundNet:UpLevel(pbData, callback)
    local item = _G.ConfigManager.net_map.game_guild_mysteries_up_level
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---重置所有奥义等级
function SociatyProfoundNet:ResetAll(pbData, callback)
    --local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_mysteries_reset_level
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SociatyProfoundNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SociatyProfoundNet
