local SociatyProfoundModel = require("SociatyProfoundModel")

---@class SociatyProfoundSkillItem:Component  中文描述
---@field public go_table SociatyProfoundView._obj_skill1_GoTable
local SociatyProfoundSkillItem = _G.BaseClass("SociatyProfoundSkillItem", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

local RomeNum = {"I", "II", "III", "IV", "V", "VI", "VII", "VIII"}

---类的构造函数
---@field data ArenaPeakData
function SociatyProfoundSkillItem:OnCreate(point, callback)
    self.callback = callback
    self.point = point
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---显示点位
---@param element number 五行
---@param onChoose boolean 当前选择
function SociatyProfoundSkillItem:Show(element, onChoose, icon)
    local lv = SociatyProfoundModel:GetInstance():GetElementPointLv(element, self.point)
    local pre = SociatyProfoundModel:GetInstance():CheckPrePoint(element, self.point)

    local unlock = lv > 0
    self.go_table.aorimage_icon.SpriteName = icon
    self.go_table.aortext_index.text = _G.GetLangPackValue(90021800520) .. RomeNum[self.point]
    self.go_table.aortext_lv.text = (not pre and not unlock) and _G.GetLangPackValue(90022300040) or lv
    self.go_table.aorimage_bgChoose:SetActiveE(onChoose and 1 or 0)
    self.go_table.aorimage_light:SetActiveE(onChoose and 1 or 0)
    self.go_table.aorimage_bgNotChoose:SetActiveE(onChoose and 0 or 1)
    self.go_table.aorimage_bgNotChoose:SetGray(not unlock)
    self.go_table.aorimage_bgChoose:SetGray(not unlock)
    self.go_table.aorimage_icon:SetGray(not pre)
    self.go_table.aorimage_suo:SetActiveE((not pre and not unlock) and 1 or 0)
    self.go_table.aorimage_signbg:SetGray(not unlock)
end

---@private
function SociatyProfoundSkillItem:OnClickBtn(go, isOn)
    if self.callback then
        self.callback(self.point)
    end
end

---类的析构函数
function SociatyProfoundSkillItem:Dispose()
end

return SociatyProfoundSkillItem
