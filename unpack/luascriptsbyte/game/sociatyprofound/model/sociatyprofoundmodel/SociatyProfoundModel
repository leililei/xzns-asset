local SociatyProfoundNet = require("SociatyProfoundNet")

local base = _G.GameDataModelBase
---@class SociatyProfoundModel : GameDataModelBase
---@field data table 奥义数据
---@field pointMaxLv table 各节点最大等级
local SociatyProfoundModel = _G.BaseClass("SociatyProfoundModel", base)

---@return SociatyProfoundModel SociatyProfoundModel
function SociatyProfoundModel:GetInstance()
    return self.super.GetInstance(self)
end

local guild_skill_cfg = _G.ConfigManager.guild_skill_cfg
local DiscreteID = {
    LvDelta = 101624 --公会五行奥义总等级最大差值
}

---创建对象时,入口构造函数
function SociatyProfoundModel:__init()
    self.pointMaxLv = {}
    self.data = {}
    for i = 1, 6 do
        self.data[i] = { sumLv = 0, points = { 0, 0, 0, 0, 0, 0, 0, 0 } }
        self.data[i].attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    end
    local step = {}
    for _, v in pairs(guild_skill_cfg) do
        if self.pointMaxLv[v.type1] == nil then
            self.pointMaxLv[v.type1] = 0
        end
        if v.level > self.pointMaxLv[v.type1] then
            self.pointMaxLv[v.type1] = v.level
        end
        if v.type1 == 1 then
            step[v.pre_level[2]] = true
        end
    end
    self.circleStep = _G.table.KeyToTable(step)
    _G.table.sort(self.circleStep)
    -- _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnJoinSociaty, self)
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.BeKicked, self.OnQuitSociaty, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClock, self)
end

---从服务器拉取数据
function SociatyProfoundModel:GetDataFormServer()
    if require("SociatyModel"):GetInstance().SociatySelf then
        self:GetInfo()
    else
        self.super.ParseData(self)
    end
end

---获取信息
function SociatyProfoundModel:GetInfo(isJoin)
    SociatyProfoundNet:GetInstance():GetInfo(
        function(msg)
            self:ParseData(msg)
            if isJoin then
                self:OnJoinSociaty()
            end
        end
    )
end

---@param msg guild_mysteries.s2c_info
function SociatyProfoundModel:ParseData(msg)
    local profound = msg.guile_mysteries
    if profound then
        local element
        for _, v in pairs(profound) do
            element = self.data[v.elements]
            element.sumLv = v.all_level
            for _, pt in pairs(v.detail) do
                element.points[pt.k] = pt.v
            end
        end
    end
    self:UpdateAttibute()
    self.super.ParseData(self)
end

function SociatyProfoundModel:UpdateAttibute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local tonumber = _G.tonumber
    local cfg, lv, name, value, aType
    for i = 1, 6 do
        self.data[i].attribute = AttributeClassManager:GetAttribtueClass()
        for j = 1, 8 do
            lv = self.data[i].points[j]
            if lv > 0 then
                cfg = guild_skill_cfg[j * 1000 + lv]
                value = tonumber(cfg.attribute[3])
            else
                cfg = guild_skill_cfg[j * 1000 + 1]
                value = 0
            end
            name = cfg.attribute[1]
            aType = cfg.attribute[2] == "1" and _G.AttCountType.other or tonumber(cfg.attribute[2])
            self.data[i].attribute:AddValueByName(
                name,
                AttributeClassManager:GetValueWithName(name, value, aType),
                false,
                aType
            )
        end
    end
end

---检查前一点位是否满足要求
---@param element number 五行
---@param point number 点位
---@return boolean,number 是否满足，需求等级
function SociatyProfoundModel:CheckPrePoint(element, point)
    local nextLv = self.data[element].points[point] + 1
    if nextLv > self.pointMaxLv[point] then
        return false, ""
    end
    local cfg = guild_skill_cfg[point * 1000 + nextLv]
    local preLv = cfg.pre_level
    if self.data[element].points[preLv[1]] >= preLv[2] then
        return true, ""
    else
        return false, preLv[2]
    end
end

---检查其它奥义盘否满足要求
---@param element number 五行
function SociatyProfoundModel:CheckOtherProfound(element, lv)
    lv = lv or 1
    local stepDelta = _G.ConfigManager.discrete_cfg[DiscreteID.LvDelta][1][1]
    local maxDelta = _G.ConfigManager.discrete_cfg[DiscreteID.LvDelta][1][2]
    for k, v in pairs(self.data) do
        if k ~= element and self.data[element].sumLv + lv > maxDelta + v.sumLv - v.sumLv % stepDelta then
            local tipLv = self.data[element].sumLv - maxDelta
            return false, tipLv - tipLv % stepDelta + stepDelta
        end
    end
    return true, ""
end

---检查某五行的某点位是否达到最大等级
---@param element number 五行
---@param point number 点位
function SociatyProfoundModel:CheckPointIsMaxLv(element, point)
    return self.data[element].points[point] >= self.pointMaxLv[point]
end

---计算材料差（消耗）
---@param material1 table 当前等级累计材料 {{sid, num}}
---@param material2 table 下一等级累计材料
function SociatyProfoundModel:CalCostMaterial(material1, material2)
    local cost = {}
    for _, v in pairs(material1) do
        cost[v[1]] = v[2]
    end
    for _, v in pairs(material2) do
        if cost[v[1]] then
            cost[v[1]] = v[2] - cost[v[1]]
            if cost[v[1]] <= 0 then
                cost[v[1]] = nil
            end
        else
            cost[v[1]] = v[2]
        end
    end
    return cost
end

function SociatyProfoundModel:CheckEnoughMaterial(cost, openWay)
    for k, n in pairs(cost) do
        if not _G.StorageManager:GetInstance():CheckItem(k, n) then
            if openWay then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, k)
            end
            return false
        end
    end
    return true
end

---点位升级
---@param element number 五行
---@param point number 点位
---@param lvNum number 提升的等级数
---@param callback number 升级回调
function SociatyProfoundModel:UpLevel(element, point, lvNum, callback)
    local other, _ = self:CheckOtherProfound(element, lvNum)
    if not other then
        return
    end
    local curLv = self.data[element].points[point]
    if curLv + lvNum > self.pointMaxLv[point] then
        return
    end
    local pre, _ = self:CheckPrePoint(element, point)
    if not pre then
        return
    end
    local id = point * 1000 + curLv
    local material1 = curLv > 0 and guild_skill_cfg[id].material or {}
    local material2 = guild_skill_cfg[id + lvNum].material
    local cost = self:CalCostMaterial(material1, material2)
    if not self:CheckEnoughMaterial(cost, true) then
        return
    end
    self:OnUpLevel(element, point, lvNum, cost, callback)
end

---升到能升的最大等级
function SociatyProfoundModel:TryBestUpLevel(element, point, callback)
    local lvNum, cost = self:GetCanUpMaxLevel(element, point, true)
    if lvNum == 0 then
        return
    end
    _G.PlayerPrefsManager.SetInt("LastUpAoYi", element, false)
    self:OnUpLevel(element, point, lvNum, cost, callback)
end

---执行升级
function SociatyProfoundModel:OnUpLevel(element, point, lvNum, cost, callback)
    local pbData = { elements = element, pos = point, up = lvNum }
    SociatyProfoundNet:GetInstance():UpLevel(
        pbData,
        function(msg)
            if msg.ack == 1 then
                self.data[element].sumLv = self.data[element].sumLv + lvNum
                self.data[element].points[point] = self.data[element].points[point] + lvNum
                for sid, num in pairs(cost) do
                    _G.StorageManager:GetInstance():ConsumeItem(sid, 0, num)
                end
                self:UpdateAttibute()
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.SociatyProfound)
                -- _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
                if callback then
                    callback()
                end
            end
        end
    )
end

