---计算进度条(旧，弃)
---@param element number 五行
function SociatyProfoundModel:CalFillAmountByPre(element)
    if self.data[element].points[8] >= self.pointMaxLv[8] then
        return 0
    end
    local lvP1 = self.data[element].points[1]
    local step = 0
    for _, v in pairs(self.circleStep) do
        if lvP1 > v then
            step = v
        end
    end
    local num = 1
    for i = 2, 8 do
        if self.data[element].points[i] > step then
            num = i
        else
            break
        end
    end
    if num == 8 then
        num = num + 1
    end
    return (num - 1) / 8
end

---计算进度条
---@param element number 五行
function SociatyProfoundModel:CalFillAmount(element)
    local num = 1
    for i = 1, 8 do
        if self.data[element].points[i] > 0 then
            num = i
        else
            break
        end
    end
    if num == 8 then
        return 1
    end
    return (num - 1) / 8
end

---获取能提升到的最大等级
function SociatyProfoundModel:GetCanUpMaxLevel(element, point, openWay)
    local curLv = self.data[element].points[point]
    -- local minProLv = self:GetMinProfoundLevel(element)
    -- local stepDelta = _G.ConfigManager.discrete_cfg[DiscreteID.LvDelta][1][1]
    -- local maxDelta = _G.ConfigManager.discrete_cfg[DiscreteID.LvDelta][1][2]
    -- local delta = maxDelta + minProLv - minProLv % stepDelta - self.data[element].sumLv
    local delta = 10
    if delta > self.pointMaxLv[point] - curLv then
        delta = self.pointMaxLv[point] - curLv
    end
    if delta <= 0 then
        return 0, {}
    end
    -- if delta > 10 then
    -- delta = 10
    -- end
    local baseId = point * 1000 + curLv
    local curCfg = curLv > 0 and guild_skill_cfg[baseId] or { material = {} }
    local cfg, cost
    local lvNum = 0
    local finalCost = {}
    local oneCost = {}
    for i = 1, delta do
        cfg = guild_skill_cfg[baseId + i]
        if self.data[element].points[cfg.pre_level[1]] < cfg.pre_level[2] then
            break
        end
        cost = self:CalCostMaterial(curCfg.material, cfg.material)
        if not self:CheckEnoughMaterial(cost, i == 1 and openWay) then
            break
        end
        if i == 1 then
            oneCost = cost
        end
        finalCost = cost
        lvNum = i
    end
    if 0 < lvNum and lvNum < 10 then
        lvNum = 1
        finalCost = oneCost
    end
    return lvNum, finalCost
end

---获取最小奥义盘等级
---@param exceptEle number 不计算的元素
function SociatyProfoundModel:GetMinProfoundLevel(exceptEle)
    local minLv
    for k, v in pairs(self.data) do
        if k ~= exceptEle and (minLv == nil or v.sumLv < minLv) then
            minLv = v.sumLv
        end
    end
    return minLv or 0
end

---获取总等级
function SociatyProfoundModel:GetSumLv()
    local sumLv = 0
    for _, v in pairs(self.data) do
        sumLv = sumLv + v.sumLv
    end
    return sumLv
end

