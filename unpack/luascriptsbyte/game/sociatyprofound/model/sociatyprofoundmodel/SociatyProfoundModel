---获取某个五行的第一个前置满足的点位
---@param point number 点位
function SociatyProfoundModel:GetFirstChoosePoint(element)
    local point = 1
    for i = 1, 8 do
        if self:CheckPrePoint(element, i) then
            return i
        end
    end
    return point
end

---检测指定五行是否可提升
function SociatyProfoundModel:CheckCanUpLevel(element)
    local point
    for i = 1, 8 do
        if self:CheckPrePoint(element, i) then
            point = i
        end
    end
    if point == nil then
        return false
    end
    local lvNum, cost = self:GetCanUpMaxLevel(element, point)
    return lvNum > 0
end

---获取某个五行奥义的属性加成
---@param elements number 多种族五行
function SociatyProfoundModel:GetAllAttribute(elements)
    elements = require "CardInfoManager":GetInstance():GetElementsMulti(elements)
    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(self.data[elements[1]].attribute)
    local changeAttrTypes_new = changeAttrTypes
    local attribute_new = self.data[elements[1]].attribute
    if #elements > 1 then
        for i = 2, #elements do
            attribute_new = _G.AttributeClassManager:GetInstance():AddAttributeByNew(attribute_new,
                self.data[elements[i]].attribute)

            local changeAttrTypes2 = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(self.data[elements[i]]
            .attribute)
            changeAttrTypes_new = _G.AttributeClassManager:GetInstance():AddAttributeByNew(changeAttrTypes_new,
                changeAttrTypes2)
        end
    end

    if not require "SociatyManager":GetInstance():HasSociaty() then
        return _G.AttributeClassManager:GetInstance():GetAttribtueClass(), changeAttrTypes_new
    end
    if #changeAttrTypes_new == 0 then
        for _, value in pairs(_G.AttrType) do
            _G.table.insert(changeAttrTypes_new, value)
        end
    end
    return attribute_new, changeAttrTypes_new
end

function SociatyProfoundModel:CheckRedPoint()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end
    if _G.PlayerPrefsManager.GetInt("SociatyProfound") == _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()) then
        return false
    end
    local material1, material2, cost, id
    local minPtLv = {}
    for _, e in pairs(self.data) do
        for p, pLv in pairs(e.points) do
            if minPtLv[p] == nil or pLv < minPtLv[p] then
                minPtLv[p] = pLv
            end
        end
    end
    for p, pLv in pairs(minPtLv) do
        if pLv < self.pointMaxLv[p] then
            id = p * 1000 + pLv
            material1 = pLv > 0 and guild_skill_cfg[id].material or {}
            material2 = guild_skill_cfg[id + 1].material
            cost = self:CalCostMaterial(material1, material2)
            if self:CheckEnoughMaterial(cost) then
                return true
            end
        end
    end
    return false
end

