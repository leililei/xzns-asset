---@class GameInit 逻辑层全局类初始
local GameInit = {}
_G.GameInit = GameInit

local SingCatchTab = {
    "PlayerModel",
    "TaskModule",
    "AutomaticPlayStory",
    "CommonUIEffect",
    "MainManager",
    "FunctionManager",
    "ServerManager",
    "GuideManager",
    "GameNetTipsManager",
    "SystemSettingManager",
    "StorageManager",
    "DeadsoulTowerManager",
    "StoryManager",
    "ChapterRoomManager",
    "LoginManager",
    "StrengthGuideModel"
}

function GameInit.ALLDispose()
    for k, _ in pairs(SingCatchTab) do
        if not _G.IsNil(SingCatchTab[k].Dispose) then
            SingCatchTab[k]:Dispose()
        end
        package.loaded[k] = nil
        _G[k] = nil
        SingCatchTab[k] = nil
    end
end
