local CoreDrawNet = require("CoreDrawNet")

local base = _G.GameDataModelBase
---@class CoreDrawModel : GameDataModelBase
local CoreDrawModel = _G.BaseClass("CoreDrawModel", base)

---@return CoreDrawModel CoreDrawModel
function CoreDrawModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function CoreDrawModel:__init()
    self.cfg = _G.ConfigManager.discrete_cfg[200604]--配置id
    self.spcList = _G.ConfigManager.discrete_cfg[self.cfg[1][1]][1]
    self.spList = _G.ConfigManager.discrete_cfg[self.cfg[1][2]][1]
    self.iList = _G.ConfigManager.discrete_cfg[self.cfg[2][1]]
    self.maxTimes = _G.ConfigManager.discrete_cfg[200607][1][1]
    self.changeTime = _G.ConfigManager.discrete_cfg[200608][1][1]
    self.intervalTime = _G.ConfigManager.discrete_cfg[200609][1][1]
    self.giftId = _G.ConfigManager.discrete_cfg[200614][1][1]
    self.redpointId = _G.ConfigManager.redpoint_cfg.CoreDraw and _G.ConfigManager.redpoint_cfg.CoreDraw.id or 0
    ---@type store_extra_cfg
    self.giftcfg = {}
    if self.giftId then
        self.giftcfg = _G.ConfigManager.store_extra_cfg[self.giftId]
    end
end

---从服务器拉取数据
function CoreDrawModel:GetDataFormServer()
    CoreDrawNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

function CoreDrawModel:GetData(back)
    CoreDrawNet:GetInstance():GetInfo(function(msg)
        self:ParseData(msg)
        if back then
            back()
        end
    end)
end

---解析数据
---@param msg lucky_thousand.s2c_info
function CoreDrawModel:ParseData(msg)
    self.curAward = msg.award and msg.award or {}
    self.records = msg.items and msg.items or {}
    self.selectIndex = msg.award_index and msg.award_index or 0
    self.totalTimes = msg.total_times and msg.total_times or 0
    --当前轮次 1:免费 2付费次数
    self.round = msg.round and msg.round or 2
    self.super.ParseData(self)
end

function CoreDrawModel:GetAwards(index)
    local count = #self.records
    for i = 1, count do
        if self.records[i].index == index then
            return self.records[i].award
        end
    end
end

---打开卡牌预览
function CoreDrawModel:OpenCardPreview(sid,index)
    local cardData = require("CardData").GetPreviewData(sid)
    cardData:SetSkin(0)
    ---@type award.i_award_item[]
    local awards = {}
    if index == -1 then
        awards = self.curAward
        if _G.table.isEmptyOrNil(self.curAward) then
            awards = self:GetAwards(#self.records)
        end
    else
        awards = self:GetAwards(index)
    end

    local datas = {}
    for i = 1, #awards do
        local id = awards[i].type[1]
        if ConfigManager.card_cfg[id] then
            ---@type CardData
            local data = require("CardData").New()
            data:ParseInitMsg({ sid = id })
            table.insert(datas, data)
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LuckyTriadsDrawResultView.Name,datas)
    --_G.UIManager:GetInstance():OpenWindow(
    --        _G.ConfigManager.ui_cfg.CardShowView.Name,
    --        { CardData = cardData },
    --        nil,
    --        true, nil, 1
    --)
end

---从服务器拉新的数据并解析
function CoreDrawModel:UpdateData(callback)
    CoreDrawNet:GetInstance():GetInfo(function(msg)
        self.curAward = msg.award
        self.records = msg.items
        self.selectIndex = msg.award_index
        self.totalTimes = msg.total_times
        if callback then
            callback()
        end
    end)
end

---抽奖
function CoreDrawModel:Draw(callback)
    CoreDrawNet:GetInstance():Draw(function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.totalTimes = self.totalTimes + 1
        self.curAward = msg.award
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.redpointId)
        if callback then
            callback(msg)
        end
    end)
end

---替换记录
function CoreDrawModel:Exchange(index, callback)
    local pbData = { index = index }
    CoreDrawNet:GetInstance():Exchange(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        local count = #self.records
        for i = 1, count do
            if self.records[i].index == index then
                self.records[i] = {
                    award = self.curAward,
                    index = index
                }
            end
        end
        if callback then
            callback()
        end
    end)
end

function CoreDrawModel:GetAward(index, callback)
    local pbData = { index = index }
    CoreDrawNet:GetInstance():GetAward(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
        self.selectIndex = index
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.redpointId)

        if self:IsAllGet() then
            self:CloseFun()
            if callback then
                callback()
            end
        else
            if callback then
                callback()
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GraceOfGodView.Name)
        end
    end)
end

function CoreDrawModel:CloseFun()
    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.CoreDraw)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CoreDrawView.Name)
end

function CoreDrawModel:CheckOpen()
    local isunllock = FunctionManager:GetInstance():CheckFunctionIsUnlock(1006)
    local isAllGet = CoreDrawModel:GetInstance():IsAllGet()
    if isunllock and isAllGet == false then
        return true
    end
    return false
end

function CoreDrawModel:IsAllGet()
    if _G.ConfigManager.discrete_cfg[200617][1][1] == 0 then--如果30元礼包没有开启，领取一次就关活动，后续如果开启活动会重新显示
        return self.selectIndex ~= 0
    end
    if self.round == 2 and self.selectIndex ~= 0 then
        return true
    end
    return false
end

function CoreDrawModel:CheckRedpoint(param)
    if not self:CheckOpen() then
        return 0
    end
    if param == 1 then--首次开放
        return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "First", 1) == 1 and 1 or 0
    elseif param == 2 then--每日登录
        local isLogin = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "Login", 0)
        return isLogin == 0 and 1 or 0
    else--全部次数用完
        local isMax = self.maxTimes == self.totalTimes
        local isGet = self.selectIndex ~= 0
        return (isMax and not isGet) and 1 or 0
    end
end

function CoreDrawModel:OnSixClockUpdate(endcall)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "Login", 0)
    if self.redpointId > 0 then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.redpointId)
    end
    if endcall then
        endcall()
    end
end

function CoreDrawModel:BuyGift()
    if self.giftcfg.id then
        require("MonthlyModel"):GetInstance():BuyRmb(self.giftcfg.id,self.giftcfg.price_id)
    end
end

function CoreDrawModel:GetPrice()
    if self.giftcfg.id == nil then
        return 0
    end
    local store_gear_cfg = ConfigManager.store_gear_cfg[self.giftcfg.price_id]
    if store_gear_cfg == nil then
        return 0
    end
    return _G.GameUtil.RatioControl(store_gear_cfg.price)
end

function CoreDrawModel:GetEndTimer()
    if self.timer_end == nil then
        self.timer_end = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawTimer, 0)
        if self.timer_end == 0 or self.timer_end == nil then
            local nowtime = _G.TimeUtil.GetServerUnixTime()
            self.timer_end = nowtime + 1000
            if ConfigManager.discrete_cfg[200615] then
                self.timer_end = nowtime + ConfigManager.discrete_cfg[200615][1][1]
            end
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawTimer, self.timer_end)
        end
    end
    return self.timer_end
end

---销毁对象时,析构函数
function CoreDrawModel:Dispose()
end


return CoreDrawModel
