local base = require("BaseGameNet")

---@class CoreDrawNet : BaseGameNet	通信协议
local CoreDrawNet = _G.BaseClass("CoreDrawNet", base)
---@return CoreDrawNet CoreDrawNet
function CoreDrawNet:GetInstance()
    return base.GetInstance(self)
end

---获取抽奖信息
function CoreDrawNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_lucky_thousand_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---抽奖
function CoreDrawNet:Draw(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_lucky_thousand_execute
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---替换记录
function CoreDrawNet:Exchange(pbData, callback)
    local item = _G.ConfigManager.net_map.game_lucky_thousand_exchange
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领奖
function CoreDrawNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_lucky_thousand_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CoreDrawNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CoreDrawNet
