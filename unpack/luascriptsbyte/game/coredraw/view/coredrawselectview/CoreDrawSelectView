---@class CoreDrawSelectView : UIBaseView	核心千抽选择界面
---@field go_table CoreDrawSelectView_GoTable
---@field super UIBaseView
local CoreDrawSelectView = _G.BaseClass("CoreDrawSelectView", _G.UIBaseView)


function CoreDrawSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function CoreDrawSelectView:OnCreate(mainView)
    ---@type CoreDrawView
    self.mainView = mainView
    self:InitData()
end

---初始化数据
function CoreDrawSelectView:InitData() 
    self.model = require("CoreDrawModel"):GetInstance()
    self.itemList = {}
    self.curIndex = 0
    self.records = {}
    self.model:UpdateData(function()
        local records = self.model.records or {}
        if #records > 0 then
            for _, v in pairs(records) do
                self.records[v.index] = v.award
            end
        end
        self:InitView()
    end)
end

---初始化界面
function CoreDrawSelectView:InitView()
    self.go_table.scrollloophorizontal_Record:InitItemData(4, _G.handler(self, self.RefreshList))
end

---刷新记录
function CoreDrawSelectView:RefreshList(index, obj)
    index = index + 1
    obj:SetName(index)
    local tb = self.itemList[index]
    if not tb then
        self.itemList[index] = _G.GetAutoGoTable(obj)
        tb = self.itemList[index]
    end
    self:PlayLoadAni(tb)
    if self.records and self.records[index] then
        tb.obj_Empty:SetActiveE(0)
        tb.obj_Card:SetActiveE(1)
        local sid = self.records[index][1].type[1]
        _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                tb.obj_Root,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                    trans:Show(
                        { sid = sid, star = _G.ConfigManager.card_cfg[sid].Star },
                        _G.handlerbind(self, self.SelectCard, index)
                    )
                    trans.go_table.obj_lvNode:SetActiveE(0)
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.CoreDrawSelect_effect,
                        tb.obj_Select,
                        function(effect)
                            if not self.go_table then
                                _G.DestroyImmediate(effect)
                                return
                            end
                        end
                    )
                end
        )
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.OnClickCard, sid, index))
    else
        tb.obj_Empty:SetActiveE(1)
        tb.obj_Card:SetActiveE(0)
    end
end

---播放加载动态动画
function CoreDrawSelectView:PlayLoadAni(tb)
    if not tb.canvasGroup then
        tb.canvasGroup = tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    end
    local x, y, _ = tb.gameObject:GetLocalPosition()
    local time = 0.2
    tb.gameObject:SetLocalPosition(x - 50, y, 0)
    tb.gameObject:DOLocalMoveX(x, time):SetEase(_G.CS.DG.Tweening.Ease.OutExpo)
    tb.canvasGroup.alpha = 0
    tb.canvasGroup:DOFade(1, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

---加载特效
function CoreDrawSelectView:LoadEffect()
    
end

---更换选择卡牌
function CoreDrawSelectView:SelectCard(_, index)
    if self.curIndex == index then
        return
    end
    if self.curIndex ~= 0 then
        self.itemList[self.curIndex].obj_Select:SetActiveE(0)
    end
    self.itemList[index].obj_Select:SetActiveE(1)
    self.curIndex = index
end

---点击卡牌事件
function CoreDrawSelectView:OnClickCard(go, isOn, sid,index)
    local name = go:GetName()
    if name == "@_aorbtn_Detail" then
        self.model:OpenCardPreview(sid,index)
    end
end

---按钮点击事件在这里派发
function CoreDrawSelectView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" or name == "@_aorbtn_Cancel" then
        self:Close()
    elseif name == "@_aorbtn_Confirm" then
        if #self.records == 0 then--记录为空
            _G.PopWindowManager:GetInstance():ShowAllTips(1130003)
            return
        end
        if self.curIndex == 0 then--没有选中角色
            _G.PopWindowManager:GetInstance():ShowAllTips(1130002)
            return
        end
        if #self.records < 4 then--记录未满
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    1130004, 
                    nil,
                    function()
                        self.model:GetAward( self.curIndex, _G.handler(self, self.Close))
                    end
            )
            return
        end
        if self.model.totalTimes < self.model.maxTimes then--还有次数
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    1130005,
                    nil,
                    function()
                        self.model:GetAward( self.curIndex, _G.handler(self, self.Close))
                    end
            )
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(--二次确认
                1130006,
                nil,
                function()
                    self.model:GetAward( self.curIndex, _G.handler(self, self.Close))
                end
        )
    end
end

function CoreDrawSelectView:Close()
    self.mainView:UpdateView()
    CoreDrawSelectView.super.Close(self)
end

---类的析构函数
function CoreDrawSelectView:OnDestroy()
    self.go_table = nil
end

return CoreDrawSelectView
