---@class GraceOfGodView : UIBaseView 窗口
---@field private go_table GraceOfGodView_GoTable GoTable
local GraceOfGodView = BaseClass("GraceOfGodView",_G.UIBaseView)

function GraceOfGodView:__init()

end

---Create显示
---@protected
function GraceOfGodView:OnCreate(view)
    self:InitData(view)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

function GraceOfGodView:OnEnable()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnBuyBack, self)
end

function GraceOfGodView:OnDisable()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnBuyBack, self)
end

function GraceOfGodView:InitData(view)
    ---@type CoreDrawView
    self.parentview = view
    self.model = require("CoreDrawModel"):GetInstance()

    self.timer_end = self.model:GetEndTimer()
    self:Update_1f()
    self:PlayTimer()
end

function GraceOfGodView:RefreshData()

end

function GraceOfGodView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.OnClickBtn))
end

function GraceOfGodView:RefreshUI()
    self.go_table.aortext_btntxt.text = GetLangPackValue(90000010819,self.model:GetPrice())
end

function GraceOfGodView:OnBuyBack()
    self:Close()
end

function GraceOfGodView:PlayTimer()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.Update_1f, self, false, false, true)--用于更换轮播角色
    self.timer:Start()
end

function GraceOfGodView:Update_1f()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local left = self.timer_end - nowTime
    if left > 0 then
        self.go_table.aortext_timer.text = GetLangPackValue(90049500026,TimeUtil.TranslateSecondForStr(left))
    else
        self.go_table.aortext_timer.text = GetLangPackValue(90049500029)
    end
end

--region ------------------界面逻辑区-----------------

--endregion


---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function GraceOfGodView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_gotoTopup then
        self.model:BuyGift()
    end
end
---关闭前调用
function GraceOfGodView:CloseBase()

end

function GraceOfGodView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---@return GraceOfGodView
return GraceOfGodView