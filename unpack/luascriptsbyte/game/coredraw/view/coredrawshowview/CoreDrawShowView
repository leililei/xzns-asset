---@class CoreDrawShowView : UIBaseView	核心千抽记录界面
---@field go_table CoreDrawShowView_GoTable
local CoreDrawShowView = _G.BaseClass("CoreDrawShowView", _G.UIBaseView)


function CoreDrawShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function CoreDrawShowView:OnCreate(mainView)
    ---@type CoreDrawView
    self.mainView = mainView
    self:InitData()
end

---初始化数据
function CoreDrawShowView:InitData() 
    self.model = require("CoreDrawModel"):GetInstance()
    self.itemList = {}
    self.cardList = {}
    self.replaceIndex = 0
    self.model:UpdateData(function()
        local records = self.model.records or {}
        if #records > 0 then
            self.records = {}
            for _, v in pairs(records) do
                self.records[v.index] = v.award
            end
        end
        self.curRecord = self.model.curAward
        self.isFull = true
        if _G.table.isEmptyOrNil(self.curRecord) then
            self.isFull = false
            local newest = {}
            for _, v in ipairs(self.records) do
                newest = v
            end
            self.curRecord = newest
        end
        self.sid = self.curRecord[1].type[1]
        self:InitView()
    end)
end

---初始化界面
function CoreDrawShowView:InitView()
    local tb = _G.GetAutoGoTable(self.go_table.obj_Card)
    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            tb.obj_Root,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans:Show({ sid = self.sid, star = _G.ConfigManager.card_cfg[self.sid].Star })
                trans.go_table.obj_lvNode:SetActiveE(0)
                self:PlayLoadAni(tb)
            end
    )
    self.go_table.scrollloophorizontal_Record:InitItemData(4, _G.handler(self, self.RefreshList))
    self.go_table.aortext_Confirm:SetActiveE(self.isFull and 1 or 0)
    self.go_table.aortext_Tip:SetActiveE(self.isFull and 1 or 0)
    self:LoadEffect()
end

---刷新记录
function CoreDrawShowView:RefreshList(index, obj)
    index = index + 1
    obj:SetName(index)
    local tb = self.itemList[index]
    if not tb then
        self.itemList[index] = _G.GetAutoGoTable(obj)
        tb = self.itemList[index]
    end
    self:PlayLoadAni(tb)
    if self.records[index] then
        tb.obj_Empty:SetActiveE(0)
        tb.obj_Card:SetActiveE(1)
        tb.aorbtn_Replace:SetActiveE(self.isFull and 1 or 0)
        local sid = self.records[index][1].type[1]
        _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                tb.obj_Root,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                    trans:Show({ sid = sid, star = _G.ConfigManager.card_cfg[sid].Star })
                    self.cardList[index] = trans
                    trans.go_table.obj_lvNode:SetActiveE(0)
                end
        )
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.OnClickCard, sid, index))
    else
        tb.obj_Empty:SetActiveE(1)
        tb.obj_Card:SetActiveE(0)
    end
end

---加载特效
function CoreDrawShowView:LoadEffect()
    local cfg = _G.ConfigManager.ui_effect_cfg.CoreDrawShowView_effect
    for i = 1, #self.model.spcList do
        if self.model.spcList[i] == self.sid then
            cfg = _G.ConfigManager.ui_effect_cfg.CoreDrawResultView_effect
        end
    end
    _G.UIUtils.LoadEffectByCfg(
            cfg,
            self.go_table.obj_BgEff,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
    )
end

---播放加载动态动画
function CoreDrawShowView:PlayLoadAni(tb)
    if not tb.canvasGroup then
        tb.canvasGroup = tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    end
    local x, y, _ = tb.gameObject:GetLocalPosition()
    local time = 0.2
    tb.gameObject:SetLocalPosition(x - 50, y, 0)
    tb.gameObject:DOLocalMoveX(x, time):SetEase(_G.CS.DG.Tweening.Ease.OutExpo)
    tb.canvasGroup.alpha = 0
    tb.canvasGroup:DOFade(1, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

---界面关闭函数
function CoreDrawShowView:CloseView(isDiscard, callback)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawExchange, 0)--关闭替换界面视为完成替换
    if isDiscard then
        self.model:Exchange(0, function()
            self.model.curAward = {}
            if callback then
                callback()
            end
        end)
    end
    self:Close()
end

--卡牌点击事件
function CoreDrawShowView:OnClickCard(go, isOn, sid, index)
    local name = go:GetName()
    if name == "@_aorbtn_Detail" then
        if index == nil then
            self.model:OpenCardPreview(self.replaceIndex == index and self.sid or sid,self.replaceIndex)
        else
            self.model:OpenCardPreview(self.replaceIndex == index and self.sid or sid,index)
        end
    elseif name == "@_aorbtn_Replace" then
        _G.PopWindowManager:GetInstance():ShowAllTips(
                1130007,
                nil,
                function()
                    self.model:Exchange(index, function()
                        self.replaceIndex = index
                        self.model.curAward = {}
                        for i = 1, 4 do
                            self.itemList[i].aorbtn_Replace:SetActiveE(0)
                        end
                        self.cardList[index]:Show({ sid = self.sid, star = _G.ConfigManager.card_cfg[self.sid].Star })
                        self.go_table.aortext_Confirm:SetActiveE(0)
                        self.go_table.aortext_Tip:SetActiveE(0)
                    end)
                end
        )
    end
end

---按钮点击事件在这里派发
function CoreDrawShowView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseView(true)
    elseif name == "@_aorbtn_Detail" then
        if self.isFull == false then
            self.model:OpenCardPreview(self.sid,-1)
        else
            self.model:OpenCardPreview(self.sid, self.replaceIndex)
        end
    elseif name == "@_aorbtn_Get" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreDrawSelectView.Name,self.mainView)
        self:CloseView(true)
    elseif name == "@_aorbtn_Continue" then
        self:CloseView(true, function()
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CoreDrawView.Name)
            if view then
                view:Draw()
            end
        end)
    end
end

---类的析构函数
function CoreDrawShowView:OnDestroy()
    self.go_table = nil
end

return CoreDrawShowView
