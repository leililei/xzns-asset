---@class CoreDrawResultView : UIBaseView	核心千抽结果界面
---@field go_table CoreDrawResultView_GoTable
local CoreDrawResultView = _G.BaseClass("CoreDrawResultView", _G.UIBaseView)


function CoreDrawResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function CoreDrawResultView:OnCreate()
    self:InitData()
    self:InitView()
end

---初始化数据
function CoreDrawResultView:InitData() 
    self.model = require("CoreDrawModel"):GetInstance()
    self.drawResult = self.model.curAward
    self.sid = self.drawResult[1].type[1]
    self.itemData = {}
    self.itemList = {}
    for i = 2, #self.drawResult do
        self.itemData[#self.itemData + 1] = self.drawResult[i].type
    end
    local isCore = false
    for _, v in pairs(self.model.spcList) do
        if self.sid == v then
            isCore = true
        end
    end
    if isCore == true then
        local isNew = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawNew .. self.sid, 1) == 1
        if isNew then
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawNew .. self.sid, 0)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawResultRoleView.Name,
                { id = self.sid, Star = _G.ConfigManager.card_cfg[self.sid].Star }
            )
        end
    end
end

---初始化界面
function CoreDrawResultView:InitView()
    local tb = _G.GetAutoGoTable(self.go_table.obj_Card)
    self:PlayLoadAni(tb)
    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            tb.obj_Root,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans:Show({ sid = self.sid, star = _G.ConfigManager.card_cfg[self.sid].Star })
                trans.go_table.obj_lvNode:SetActiveE(0)
            end
    )
    self.go_table.scrollloophorizontal_Award:InitItemData(#self.itemData, _G.handler(self, self.RefreshList))
    self:LoadEffect()
end

---刷新奖励
function CoreDrawResultView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_Root:RemoveAllChildren()
    tb.aortext_Name.text = ""
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            self.itemData[index],
            tb.obj_Root,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans.go_table.obj_ItemNum:SetActiveE(1)
                tb.aortext_Name.text = _G.GetLangPackValue(trans.cfg.Name and trans.cfg.Name or trans.cfg.name)
                self.itemList[index] = trans.go_table
            end
    )
    self:PlayLoadAni(tb)
end

---播放加载动态动画
function CoreDrawResultView:PlayLoadAni(tb)
    if not tb.canvasGroup then
        tb.canvasGroup = tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    end
    local x, y, _ = tb.gameObject:GetLocalPosition()
    local time = 0.2
    tb.gameObject:SetLocalPosition(x - 50, y, 0)
    tb.gameObject:DOLocalMoveX(x, time):SetEase(_G.CS.DG.Tweening.Ease.OutExpo)
    tb.canvasGroup.alpha = 0
    tb.canvasGroup:DOFade(1, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

---加载特效
function CoreDrawResultView:LoadEffect()
    local cfg = _G.ConfigManager.ui_effect_cfg.CoreDrawShowView_effect
    for i = 1, #self.model.spcList do
        if self.model.spcList[i] == self.sid then
            cfg = _G.ConfigManager.ui_effect_cfg.CoreDrawResultView_effect
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        cfg,
        self.go_table.obj_BgEff,
        function(trans)
            if not self.go_table then
                _G.DestroyImmediate(trans)
                return
            end
        end
    )
end

---按钮点击事件在这里派发
function CoreDrawResultView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreDrawShowView.Name)
        self:Close()
    end
end

---类的析构函数
function CoreDrawResultView:OnDestroy()
    self.go_table = nil
end

return CoreDrawResultView
