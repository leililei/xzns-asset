---@class CoreDrawPreviewView : UIBaseView	中文描述
---@field public go_table CoreDrawPreviewView_GoTable GoTable
local CoreDrawPreviewView = _G.BaseClass("CoreDrawPreviewView", _G.UIBaseView)

---每行显示多少个图鉴卡牌
local CARD_ROW_COUNT = 4
local ElementsIcon = {
    [1] = "ui_js_renlei_icon", --人类
    [2] = "ui_js_shouren_icon", --兽人
    [3] = "ui_js_jingling_icon", --精灵
    [4] = "ui_js_wangling_icon", --亡灵
    [5] = "ui_js_chuanqi_icon", --预留
    [6] = "ui_js_chuanqi_icon" --传奇
}
local ElementsName = {
    [1] = 90023200042,
    [2] = 90023200043,
    [3] = 90023200044,
    [4] = 90023200045,
}

function CoreDrawPreviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_team:InitListView(0, _G.handler(self, self.RefreshRenItem))
end

---界面的入口函数
function CoreDrawPreviewView:OnCreate()
    self:FreshData()
    self.num = _G.table.count(self.heroRaceData)
    self.go_table.looplist2_team:SetListItemCount(4, true, false)
end

---按钮点击事件在这里派发
function CoreDrawPreviewView:OnClickBtn(go)
    if go:GetName() == "@_aorbtn_CloseView" then 
        self:Close()
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    end
end

function CoreDrawPreviewView:FreshData()
    self.heroRaceData = {}
    self.dataCount = {}
    for i = 1, 4 do
        self.heroRaceData[i] = {}
        self.dataCount[i] = 0
    end
    local allCards = {}
    for _, v in pairs({200601, 200602}) do
        for _, v2 in pairs(_G.ConfigManager.discrete_cfg[v][1]) do
            _G.table.insert(allCards, v2)
        end
    end
    for _, v in pairs(_G.ConfigManager.discrete_cfg[200603]) do
        _G.table.insert(allCards, v[1])
    end
    for k, v in ipairs(allCards) do
        local element = _G.ConfigManager.card_cfg[v].Elements
        local groupIndex = math.ceil((self.dataCount[element] + 1) / 4)
        self.heroRaceData[element][groupIndex] = self.heroRaceData[element][groupIndex] or {}
        _G.table.insert(self.heroRaceData[element][groupIndex], v)
        self.dataCount[element] = self.dataCount[element] + 1
    end
end 

--初始化item
function CoreDrawPreviewView:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local item = listView2:NewListViewItem("$_obj_Item1")
    item:SetActiveE(1)

    self:SetItem(item, t_index)
    return item
end

--设置Item
function CoreDrawPreviewView:SetItem(go, teamsid)
    if not self.cardItems then
        self.cardItems = {}
    end

    local item = self.cardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.cardItems[go:GetInstanceIDE()] = item
    end

    local index = teamsid
    local data = self.heroRaceData[index]
    item.index = index
    item.data = data
    item.aorimage_Elements.SpriteName = ElementsIcon[index]
    item.aortext_Elements.text = _G.LangUtil.GetLangPackValue(ElementsName[index]) 
    for i = 1, #self.heroRaceData[index] do 
        self:SetCardItem(item, index, i)
    end
    _G.GameUtil.ReBuildRTF(go.gameObject)
    self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
end

function CoreDrawPreviewView:SetCardItem(go, index, groupIndex)
    local groupObj, obj
    go.cardList = go.cardList or {}
    if go.cardList[groupIndex] then 
        groupObj = go.cardList[groupIndex]
    else 
        obj = _G.InstantiateObject(self.go_table.obj_cards, go.transform)
        groupObj = _G.GetAutoGoTable(obj)  
        go.cardList[groupIndex] = groupObj
    end
    local cards_Item = {
        [1] = groupObj.obj_cardItem1,
        [2] = groupObj.obj_cardItem2,
        [3] = groupObj.obj_cardItem3,
        [4] = groupObj.obj_cardItem4,
    }
    for i = 1, CARD_ROW_COUNT do
        local sid, tb, data
        sid = self.heroRaceData[index][groupIndex][i]
        if not sid or sid == 0 then
            cards_Item[i]:SetActiveE(0)
        else
            cards_Item[i]:SetActiveE(1)
            data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 1) 
            tb = _G.GetAutoGoTable(cards_Item[i])
            _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.AddHunJiangBtn, data.sid))
            tb.aortext_name.text =_G.LangUtil.GetLangPackValue(data.cfg.Name)
            tb.rowIndex = groupIndex    --行index
            tb.index = i    --行index
            tb.data = data
            if not tb.cardItem then
                tb.cardItem = require "ItemCardAllView".New(tb.obj_card)
            end
            tb.cardItem:ShowCardData(data, nil, false)
        end
    end
end

function CoreDrawPreviewView:AddHunJiangBtn(go, isOn, cardSid)
    require("CommonTipManager"):GetInstance():OpenTip(self.go_table.gameObject, cardSid)
end

return CoreDrawPreviewView
