---更新左上角信息
function CoreDrawView:UpdateInfo()
    local cfg = _G.ConfigManager.card_cfg[self.spcList[self.curCard]]
    self.go_table.aorimage_Order.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(cfg.Order)
    self.go_table.aortext_Name.text = _G.GetLangPackValue(cfg.Name)
end

---更新时间
function CoreDrawView:UpdateTime()
    if not self.go_table then
        self:StopTimer()
        return
    end
    self.carouselTime = self.carouselTime + 1
    if self.clickTime > 0 then
        self.clickTime = self.clickTime - 1
    end
    if self.carouselTime >= self.changeTime then
        self.carouselTime = 0
        self:ChangeSpine(1)
    end

end

---抽奖
function CoreDrawView:Draw()
    if self.ShowResult or self.isPlaying then
        return
    end
    if self.drawTimes == self.maxTimes then
        _G.PopWindowManager:GetInstance():ShowAllTips(1130001)--当前无可用抽取次数
        return
    end
    local showResult = function()
        self.ShowResult = nil
        local lstCard = {}
        for i = 1, #self.model.curAward do
            local id = self.model.curAward[i].type[1]
            if ConfigManager.card_cfg[id] then
                ---@type CardData
                local data = require("CardData").New()
                data:ParseInitMsg({ sid = id })
                table.insert(lstCard, data)
            end
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LuckyTriadsDrawResultView.Name, lstCard, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreDrawShowView.Name, self)
        end)
    end
    local notExchange = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawExchange, 0)
    if notExchange == 1 or not _G.table.isEmptyOrNil(self.model.curAward) then
        --如果上次的抽奖记录替换没有结束则先进行替换
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreDrawShowView.Name, self)
        return
    end
    self.model:Draw(function(msg)
        if msg.ack ~= 1 then
            return
        end
        local draw = function()
            self.model.curAward = msg.award
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawExchange, 1)
            self.ShowResult = showResult
            showResult()
            self:UpdateView()
        end
        if self.skipAni == 1 then
            draw()
        else
            self:PlayAni(draw)
        end
    end)

end

--播放抽奖动画
function CoreDrawView:PlayAni(callback)
    self.isPlaying = true
    local index = self.sidToIndex[self.model.curAward[1].type[1]]
    local curIndex = 1
    local preIndex = 1
    local ani
    local totalTimes = 0
    for i = 1, #aniSpeed do
        totalTimes = totalTimes + aniSpeed[i][2]
    end
    local dis = index - (aniSpeed[3][2] + aniSpeed[4][2])
    totalTimes = totalTimes + dis - 1
    local count = { 0, -dis, 0, 0 }
    ani = function(i, type)
        if i > totalTimes then
            _G.DelayDo(0.5, function()
                for k = 1, 16 do
                    self.itemList[k].aorimage_Select:SetActiveE(0)
                end
                self.isPlaying = false
                if callback then
                    callback()
                end
            end)
            return
        end
        preIndex = curIndex
        curIndex = curIndex + 1
        if curIndex > 16 then
            curIndex = 1
        end
        self.itemList[curIndex].aorimage_Select:SetActiveE(1)
        self.itemList[preIndex].aorimage_Select:SetActiveE(0)
        _G.DelayDo(aniSpeed[type][1], function()
            if count[type] < aniSpeed[type][2] then
                count[type] = count[type] + 1
            else
                type = type + 1
            end
            ani(i + 1, type)
        end)
    end
    ani(1, 1)
end

---显示spine
function CoreDrawView:ShowSpine(index)
    local cfg = _G.ConfigManager.card_cfg[self.spcList[self.curCard]]
    self.go_table["trans_Spine" .. index]:RemoveAllChildren()
    _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.UIItem,
            self.go_table["trans_Spine" .. index],
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalScaleXYZ(cfg.size3)
                trans:SetLocalPosition(cfg.pos_portrait1[1], cfg.pos_portrait1[2], cfg.pos_portrait1[3])
            end
    )
end

---点击按钮左右切换
function CoreDrawView:ChangeSpineByBtn(changeNum)
    if self.clickTime > 0 then
        return
    end
    self.clickTime = self.intervalTime
    self.carouselTime = 0
    self:ChangeSpine(changeNum)
end

---切换轮播角色
function CoreDrawView:ChangeSpine(changeNum)
    self.curCard = self.curCard + changeNum
    if self.curCard > #self.spcList then
        self.curCard = 1
    elseif self.curCard < 1 then
        self.curCard = #self.spcList
    end
    self.preIndex = self.spineIndex
    self.spineIndex = self.spineIndex == 1 and 2 or 1
    self.go_table["trans_Spine" .. self.spineIndex]:SetLocalPosition(spinePos[changeNum > 0 and 3 or 1][1], spinePos[3][2], 0)
    self:ShowSpine(self.spineIndex)
    self.go_table["trans_Spine" .. self.preIndex]:DOLocalMoveX(spinePos[changeNum > 0 and 1 or 3][1], moveTime)--原先的spine移动到屏幕外
        :SetEase(_G.CS.DG.Tweening.Ease.InOutSine):OnComplete(
            function()
                self.go_table["trans_Spine" .. self.preIndex]:RemoveAllChildren()
                self:UpdateInfo()
            end
    )
    self.go_table["trans_Spine" .. self.spineIndex]:DOLocalMoveX(spinePos[2][1], moveTime):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)--新的spine移动到屏幕中
end

---修改跳过动画状态
function CoreDrawView:ChangeSkip()
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawSkip, self.skipAni == 1 and 0 or 1)
    self.skipAni = self.skipAni == 1 and 0 or 1
    self.go_table.aorimage_IsSkip:SetActiveE(self.skipAni)
end

---按钮点击事件在这里派发
function CoreDrawView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        if self.ShowResult then
            --播放动画途中退出界面直接显示结果
            self.ShowResult()
        end
        self:Close()
    elseif name == "@_aorbtn_Draw" then
        self:Draw()
    elseif name == "@_aorbtn_Left" then
        self:ChangeSpineByBtn(-1)
    elseif name == "@_aorbtn_Right" then
        self:ChangeSpineByBtn(1)
    elseif name == "@_aorbtn_Skip" then
        self:ChangeSkip()
    elseif name == "@_aorbtn_SelectList" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreDrawSelectView.Name, self)
    elseif name == "@_aorbtn_Recommend" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RoleTeamView.Name)
    elseif name == "@_aorbtn_Help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1004)
    elseif go == self.go_table.aorbtn_rewardPreview then
        --奖励预览界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CoreDrawPreviewView.Name)
    elseif go == self.go_table.aorbtn_graceGod then
        --弹窗界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GraceOfGodView.Name)
    elseif go == self.go_table.aorbtn_gotoTopup then
        --充值
        self.model:BuyGift()
    end
end

function CoreDrawView:OnBuyBack()
    self.model:GetData(function()
        self:RefreshData()
        self:UpdateView()
    end)
end

---停止计时器
function CoreDrawView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function CoreDrawView:OnDestroy()
    self.go_table = nil
    self:StopTimer()
end

return CoreDrawView
