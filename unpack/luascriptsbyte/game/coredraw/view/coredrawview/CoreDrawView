        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

---界面入口
function CoreDrawView:OnCreate(isJump)
    self:InitData(isJump)
    self:InitView()
end

function CoreDrawView:OnEnable()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnBuyBack, self)
end

function CoreDrawView:OnDisable()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnBuyBack, self)
end

---初始化数据
function CoreDrawView:InitData(isJump)
    self.sidToIndex = {}
    self.model = require("CoreDrawModel"):GetInstance()
    self.spcList = self.model.spcList
    self.spList = self.model.spList
    self.iList = self.model.iList
    self.changeTime = self.model.changeTime
    self.intervalTime = self.model.intervalTime
    self.drawNum = _G.ConfigManager.discrete_cfg[200610][1][1]
    self.maxTimes = self.model.maxTimes
    self.skipAni = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawSkip, 0)
    if not isJump then--首次弹窗不刷红点
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "First", 0)
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "Login", 1)
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.model.redpointId)
    end

    self.timer_end = self.model:GetEndTimer()
    self:Update_1f()
end

function CoreDrawView:RefreshData()
    self.spcList = self.model.spcList
    self.spList = self.model.spList
    self.iList = self.model.iList
    self.changeTime = self.model.changeTime
    self.intervalTime = self.model.intervalTime
    self.drawNum = _G.ConfigManager.discrete_cfg[200610][1][1]
    self.maxTimes = self.model.maxTimes
    self.skipAni = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CoreDrawSkip, 0)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "First", 0)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CoreDrawRedpoint .. "Login", 1)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self.model.redpointId)
end

---初始化界面
function CoreDrawView:InitView()
    self:InitItem()
    --self:InitCarousel()--策划改需求，不轮播spine了，放一个固定的角色展示
    self:UpdateView()
    self:LoadEffect()
    self.go_table.aortext_DrawNum.text = self.drawNum
    self.go_table.aorimage_IsSkip:SetActiveE(self.skipAni)
    self.go_table.aorrawimage_Spine:LoadImage("ImagesH5/hCoreDraw/ui_hxqc_role")
    self:PlayTimer()
end

---初始化转盘奖励
function CoreDrawView:InitItem()
    self.itemList = {}
    local spcIndex = 0
    local spIndex = 0
    local iIndex = 0
    for i = 1, #itemCfg do
        local cfg = itemCfg[i]
        local obj = _G.InstantiateObject(self.go_table.obj_Item, self.go_table.trans_ItemContent)
        obj:SetLocalPosition(cfg[1], cfg[2], 0)
        obj:SetLocalScaleXYZ(0.95)
        local tb = _G.GetAutoGoTable(obj)
        tb.aorimage_Select:SetActiveE(0)
        if cfg[3] == 1 then
            --道具
            iIndex = iIndex + 1
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    { self.iList[iIndex][1], self.iList[iIndex][2] },
                    tb.obj_Root,
                    function(trans)
                        if not self.go_table then
                            _G.DestroyImmediate(trans)
                            return
                        end
                        --trans.go_table.obj_ItemNum:SetActiveE(1)
                    end
            )
        else
            --卡牌
            _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.baseItem,
                    tb.obj_Root,
                    function(trans)
                        if not self.go_table then
                            _G.DestroyImmediate(trans)
                            return
                        end
                        trans.gameObject:SetLocalScaleXYZ(0.85)
                        trans.go_table.obj_soulAndTalent:SetActiveE(0)
                        local sid
                        if cfg[3] == 2 then
                            spIndex = spIndex + 1
                            sid = self.spList[spIndex]
                        elseif cfg[3] == 3 then
                            spcIndex = spcIndex + 1
                            sid = self.spcList[spcIndex]
                        end
                        self.sidToIndex[sid] = i
                        trans:Show(sid, _G.handlerbind(self, self.OpenCardShowView, sid))
                        if cfg[3] == 3 then
                            trans.go_table.aorimage_ColorBg.SpriteName = "TY_Background_kuang_cai"
                            _G.UIUtils.LoadEffectByCfg(
                                    _G.ConfigManager.ui_effect_cfg.CoreDrawView_effect,
                                    tb.obj_Effect,
                                    function(effect)
                                        if not self.go_table then
                                            _G.DestroyImmediate(effect)
                                            return
                                        end
                                    end
                            )
                        end
                    end
            )
        end
        self.itemList[i] = tb
    end
end

function CoreDrawView:OpenCardShowView(sid)
    local cardData = require("CardData").GetPreviewData(sid)
    cardData:SetSkin(0)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardShowView.Name,
            { CardData = cardData },
            nil,
            true, nil, 1
    )
end

---初始化轮播spine信息
function CoreDrawView:InitCarousel()
    self.curCard = 1--当前角色序号
    self.spineIndex = 1--当前生成节点序号
    self.preIndex = 2--上一个生成节点序号
    self.carouselTime = 0--轮播计时
    self.clickTime = 0--上次点击按钮切换间隔倒计时
    self:ShowSpine(self.spineIndex)
    self:UpdateInfo()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)--用于更换轮播角色
    self.timer:Start()
end

function CoreDrawView:PlayTimer()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.Update_1f, self, false, false, true)--用于更换轮播角色
    self.timer:Start()
end

function CoreDrawView:Update_1f()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local left = self.timer_end - nowTime
    if left > 0 then
        self.go_table.aortext_timer.text = GetLangPackValue(90049500028, TimeUtil.TranslateSecondForStr(left))
        local t = TimeUtil.TranslateSecond(left)
        self.go_table.aortext_state.text = string.format("%02d:%02d:%02d", t.day, t.hour, t.min)
    else
        self.go_table.aortext_timer.text = GetLangPackValue(90049500029)
        self.go_table.aortext_state.text = GetLangPackValue(90049500029)
    end
end

