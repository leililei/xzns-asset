---@class SpringAwardPreView : UIBaseView	中文描述
---@field public go_table SpringAwardPreView_GoTable GoTable
local SpringAwardPreView = _G.BaseClass("SpringAwardPreView", _G.UIBaseView)
local dropCfg = _G.ConfigManager.drop_cfg
--_G.SpringAwardPreView = SpringAwardPreView
function SpringAwardPreView:Awake()
    self.AwardDatas = {}
    self.itemList = {}
    self.weight = 0
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param sid number 奖池idp
function SpringAwardPreView:OnCreate(sid, activityId)
    local Jackpot = sid and sid or 10001
    local insert = _G.table.insert
    local data = dropCfg[Jackpot]
    if data then
        local limited_item = data.content1 or {}
        for _, v in pairs(limited_item) do
            local item = {}
            if v[1] == 0 and #v >= 5 then
                item.sid = v[4]
                item.num = v[5]
                item.weight = v[6] or 0
            else
                item.sid = v[1]
                item.num = v[2]
                item.weight = v[3] or 0
            end
            item.Grand = true
            self.weight = self.weight + item.weight
            insert(self.AwardDatas, item)
        end
        for k, v in pairs(data.content2) do
            local item = {}
            if v[1] == 0 and #v >= 5 then
                item.sid = v[4]
                item.num = v[5]
                item.weight = v[6] or 0
            else
                item.sid = v[1]
                item.num = v[2]
                item.weight = v[3] or 0
            end
            self.weight = self.weight + item.weight
            insert(self.AwardDatas,item)
        end
    end
    _G.SortList(self.AwardDatas,function(a)
        local type = 0
        if a.Grand then
            type = 1
        end
        return type, - a.weight ,-a.sid
    end)

    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end

---刷新显示
function SpringAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 88)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid, data.num},
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(data.Grand)
        end
    )
    -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    tb.aortext_probNum.text = self:GetPerData(index + 1) .. "%"
end

---点击奖励
function SpringAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function SpringAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

function SpringAwardPreView:GetPerData(index)
    local weight = self.AwardDatas[index].weight/self.weight*100
    weight = string.format("%.2f", weight)
    return weight
end

return SpringAwardPreView