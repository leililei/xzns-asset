---@class SpringFestivalRedBoundMainView : UIBaseView MT送包包_主页面
---@field go_table SpringFestivalRedBoundMainView_GoTable GoTable
---@field activity ActivitySynGMActivity
---@field model MiniTaskGameSynModel
local SpringFestivalRedBoundMainView = _G.BaseClass("SpringFestivalRedBoundMainView", _G.UIBaseView)

function SpringFestivalRedBoundMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SpringFestivalRedBoundMainView:OnCreate(model)
    self.model = model
    self.activity = model.curActivityClass
    self.lastTime = self.activity.cfg.time.run_time+self.activity.cfg.time.start_time-_G.TimeUtil.GetServerUnixTime()

    self:InitView()
    --self:UpdateView()
    self:UpdateTimeView(0)

    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeView, self, false)
    self.timer:Start()
end

function SpringFestivalRedBoundMainView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function SpringFestivalRedBoundMainView:InitView()
    local taskActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
            10007,
            self.activity:GetJumpType(),
            self.activity:GetMainType()
    )
    self.go_table.aorbtn_task:SetActiveE(taskActivity and 1 or 0)
    self.go_table.obj_redpoint4:UpdateRedPointItemIDAndParam(
            taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1) --用于挂载战令丶战令任务
    )
    --道具说明
    for _, cfg in ipairs(DropConfigIcons) do
        ---@type SpringFestivalRedBoundMainView._obj_item_GoTable
        local tb = _G.GetAutoGoTable(_G.InstantiateObject(
                self.go_table.obj_item,
                self.go_table.obj_itemParent
        ))
        tb.gameObject:SetActiveE(1)
        tb.aorimage_icon.SpriteName = cfg[1]
        tb.aortext_text.text = cfg[2]
    end
end

---更新页面状态
function SpringFestivalRedBoundMainView:UpdateView()
    local taskActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
            10007,
            self.activity:GetJumpType(),
            self.activity:GetMainType()
    )
    local datas=taskActivity:GetActivityTypeCls():GetTaskDatasByType(1)
    local data
    local isGet=false
    for i = 1, #datas do
        isGet = taskActivity:GetActivityTypeCls():CheckIsGet(datas[i].Cfg.id)
        if not data and not isGet then
            data=datas[i]
        end
    end
    if table.isEmptyOrNil(data) then
        data=datas[#datas]
    end
    local target=data.i_task.target[1]
    if target >= data.Cfg.count then
        target=data.Cfg.count
    end
    self.curtaskdata=data
    local targetstr=string.format("<color=#48FF00>%s</color>/%s", target, data.Cfg.count)
    self.go_table.aortext_scoretarget.text= _G.string.format("%s%s",GetLangPackValue(90031700038),targetstr)
    self.go_table.aorimage_slider.fillAmount=target/data.Cfg.count
end

---获取下一目标所需分数
---@return number,number        @下一阶段分数,当前分数
function SpringFestivalRedBoundMainView:GetNextScore()
    local taskActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
            10007,
            self.activity:GetJumpType(),
            self.activity:GetMainType()
    )
    if not taskActivity then
        return 0, 0
    end

    local allTask = taskActivity:GetActivityTypeCls():GetAllTaskDatas()
    local nextScore, nowScore = 0, self.model.dayScore or 0
    for k, v in pairs(allTask) do
        if v.taskEnumType == 192 then
            nowScore = math.max(nowScore, v.i_task.target[1])
            if v.i_task.target[1] < v.Cfg.count and v.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
                nextScore = nextScore ~= 0 and math.min(nextScore, v.Cfg.count) or v.Cfg.count
            end
        end
    end

    return nextScore, nowScore
end

---更新时间倒计时
function SpringFestivalRedBoundMainView:UpdateTimeView(elapsed)
    self.lastTime = self.lastTime - elapsed
    if self.lastTime < 0 then
        self:Close()
    else
        local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(self.lastTime)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000010082)..time
    end
end

function SpringFestivalRedBoundMainView:OnUIOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.SpringRedPaperView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

    ---@type SpringRedPaperView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SpringRedPaperView.Name)
    if view then
        local nextScore = self:GetNextScore()
        view:SetNextDescript(nextScore > 0 and tostring(nextScore) or _G.GetLangPackValue(90034533009))
    end
end

