local ActivitySynManager = require "ActivitySynManager"
local base = require("LimitedExchangeView")
---@class SpringFestivalTavernPartyExchangeView : UIBaseView    中文描述
---@field public go_table BlackMarketExchangeView_GoTable GoTable
local SpringFestivalTavernPartyExchangeView = _G.BaseClass("SpringFestivalTavernPartyExchangeView", base)

function SpringFestivalTavernPartyExchangeView:InitView(activity)
    base.InitView(self, activity)
    --self.go_table.obj_res:SetActiveE(0)
    --倒计时
    self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    if self.Timer == nil then
        self:UpdateTime()
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.Timer:Start()
    end
end

function SpringFestivalTavernPartyExchangeView:UpdateTime()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
        if view1 then
            view1:Close()
        end
        return
    end
    local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, str)
end

function SpringFestivalTavernPartyExchangeView:RefreshItem(index, obj)
    local instanceId = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickItemBtn, index + 1))
    if self.itemDatas[x] then
        tb.data = self.itemDatas[x]
        -- tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        -- self:CreateItem(tb, instanceId)
        tb.obj_itemRoot:RemoveAllChildren()
        local sid, num = self.activitySynModel:GetItemSidAndNum(tb.data.award[1])
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, num },
            tb.obj_itemRoot,
            function(tran)
                if self:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        )
        tb.aortext_itemname.text = _G.StorageManager:GetInstance():GetItemName(sid)
        tb.aortext_num.text = _G.GetLangPackValue(90021600055) .. tb.data.count_limit - tb.data.exchangeTimes
        local consume_sid, consume_num = self.activitySynModel:GetItemSidAndNum(tb.data.consumes[1])
        if _G.StorageManager:GetInstance():GetItemIcon(consume_sid) then
            tb.aorrawimage_Material:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(consume_sid))
        end
        tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(consume_num)

        tb.obj_SellOut:SetActiveE(tb.data.state ~= 1 and 1 or 0)
        --tb.aorimage_discount:SetActiveE(0)
    end
end

function SpringFestivalTavernPartyExchangeView:Dispose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

return SpringFestivalTavernPartyExchangeView