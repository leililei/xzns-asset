function SpringSignView:InitView()
    self.RewardDatas = FestivalSignInModel:GetInstance().item
    _G.table.sort(self.RewardDatas, function(a, b)
        return a.sid < b.sid
    end)
    self.g_sids = FestivalSignInModel:GetInstance().g_sids
    self.login_days = FestivalSignInModel:GetInstance():GetLoginDays()
    self.title = FestivalSignInModel:GetInstance().title
    self:InitCurrentTable()
    self:InitPeriod()
    self:RefreshBtn()
    for i = 1, 7 do
        local item=_G.InstantiateObject(self.go_table.obj_item,self.itemList[i])
        item:SetActiveE(1)
        item:SetLocalPosition(0,0,0)
        self:OnInitItem(i, item)
    end
end

function SpringSignView:InitCurrentTable()
    local index=1
     local isGet=false
    for i = 1, #self.RewardDatas do
        isGet = _G.table.ContainsValue(self.g_sids, i)
        if self.login_days >= i and not isGet then
            index=i
            break
        end
    end
    if index==1 then
        index=self.login_days
    end
    local currentTable=index//7
    if index%7>0 then
        currentTable=currentTable+1
    end
    self.currenttab=currentTable
end

---@param i number
function SpringSignView:OnInitItem(i, item)
    local eIndex = i+(self.currenttab-1)*7
    local ctrl = _G.GetAutoGoTable(item)
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, eIndex))
    self.ItemList[i] = ctrl
    ctrl.index = eIndex
    local data = self.RewardDatas[eIndex]
    if data then
        ctrl.aortext_title.text = _G.LangUtil.GetLangPackValue(90023800006,data.sid)
        local isGet = _G.table.ContainsValue(self.g_sids, eIndex)
        ctrl.obj_got:SetActiveE(isGet and 1 or 0)
        ctrl.obj_get:SetActiveE((self.login_days >= eIndex and not isGet) and 1 or 0)
        ctrl.obj_notget:SetActiveE((self.login_days < eIndex) and 1 or 0)
        ctrl.aorbtn_getAward:SetActiveE((self.login_days >= eIndex and not isGet) and 1 or 0)
        local awarddata={}
        if data.award[1].type[1]~=0 then
            table.insert(awarddata,data.award[1].type[1])
            table.insert(awarddata,data.award[1].type[2])
        else
            table.insert(awarddata,data.award[1].type[4])
            table.insert(awarddata,data.award[1].type[5])
        end
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awarddata,
                ctrl.obj_awards,
                function(v)
                    v.gameObject:SetLocalScaleXYZ(1)
                    _G.GameUtil.SetActiveByCondition(v.gameObject, true)
                    v:ShowEffect(self.login_days >= eIndex and not isGet)
                    v.gameObject:SetLocalPosition(0, 0, 0)
                    v:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end)
    end
end
function SpringSignView:RefreshItem(index)
    if self.RewardDatas[index] then
        local _index=index%7==0 and 7 or index%7
        local ctrl= self.ItemList[_index]
        _G.AddViewBtnClick(ctrl.gameObject, _G.handlerbind(self, self.OnItemClickBtn))
        local data = self.RewardDatas[index]
        if data then
            ctrl.aortext_title.text = _G.LangUtil.GetLangPackValue(90023800006,data.sid)
            local isGet = _G.table.ContainsValue(self.g_sids, index)
            ctrl.obj_got:SetActiveE(isGet and 1 or 0)
            ctrl.obj_get:SetActiveE((self.login_days >= index and not isGet) and 1 or 0)
            ctrl.obj_notget:SetActiveE((self.login_days < index) and 1 or 0)
            ctrl.aorbtn_getAward:SetActiveE((self.login_days >= index and not isGet) and 1 or 0)
            local awarddata={}
            if data.award[1].type[1]~=0 then
                table.insert(awarddata,data.award[1].type[1])
                table.insert(awarddata,data.award[1].type[2])
            else
                table.insert(awarddata,data.award[1].type[4])
                table.insert(awarddata,data.award[1].type[5])
            end
            ctrl.obj_awards:ClearChildren()
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    awarddata,
                    ctrl.obj_awards,
                    function(v)
                        v.gameObject:SetLocalScaleXYZ(1)
                        _G.GameUtil.SetActiveByCondition(v.gameObject, true)
                        v:ShowEffect(self.login_days >= index and not isGet)
                        v.gameObject:SetLocalPosition(0, 0, 0)
                        v:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end)
        end
    end
end

---点击选中
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function SpringSignView:OnItemClickBtn(_, _)
    local days={}
    local target =self.currenttab*7>=#self.RewardDatas and #self.RewardDatas or self.currenttab*7
    local isGet=false
    for i = (self.currenttab-1)*7+1, target do
        isGet=_G.table.ContainsValue(self.g_sids, i)
        if not isGet and self.login_days >= i then
            table.insert(days,i)
        end
    end
    self.typeCls:GetAwardT(days,
        function(msg)
            if msg.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                for i = 1, #days do
                    _G.table.insert(FestivalSignInModel:GetInstance().g_sids, days[i])
                    local index=days[i]
                    self:RefreshItem(index)
                end
                self.typeCls:RefreshRedPoint()
            end
        end
    )
end

---显示时间更新
function SpringSignView:XianShiTiem()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010082).._G.TimeUtil.GiftPackGroupTime(self.time)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

function SpringSignView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000010082).._G.TimeUtil.GiftPackGroupTime(self.time)
    end
end

---界面的销毁函数
function SpringSignView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end
function SpringSignView:InitPeriod()
    local count=#self.RewardDatas//7
    if #self.RewardDatas%7>0 then
        count=count+1
    end
    for i = 1, #self.Periodlist do
        _G.DestroyObject(self.Periodlist[i].gameObject)
    end
    self.Periodlist={}
    for i = 1, count do
        local obj=_G.InstantiateObject(self.go_table.obj_tag,self.go_table.obj_count)
        obj:SetActiveE(1)
        local tag=_G.GetAutoGoTable(obj)
        local tb=_G.GetAutoGoTable(tag.aorbtn_Period,_G.handlerbind(self, self.OnClickPeriodItem, i))
        tb.aortext_Name.text = _G.GetLangPackValue(90025500088, _G.GameUtil.NumberToChinese(i))
        tb.aortext_Name_On.text = _G.GetLangPackValue(90025500088, _G.GameUtil.NumberToChinese(i))
        self.Periodlist[i]=tb
    end
end
function SpringSignView:OnClickPeriodItem(_,_,index)
    self.currenttab=index
    self:RefreshBtn(index)
    self:RefereshAllItem()
end

function SpringSignView:RefreshBtn(index)
    if not index then
        index=self.currenttab
    end
    for k,v  in pairs(self.Periodlist) do
        if index and k==index then
            v.obj_Off:SetActiveE(0)
            v.obj_On:SetActiveE(1)
            v.obj_redPoint:SetActiveE(0)
        else
            v.obj_Off:SetActiveE(1)
            v.obj_On:SetActiveE(0)
            local iscanGet = false
            local isGet=false
            local target =k*7>=#self.RewardDatas and #self.RewardDatas or k*7
            for i = (k-1)*7+1, target do
                if not iscanGet then
                    isGet=_G.table.ContainsValue(self.g_sids, i) 
                    iscanGet=self.login_days >= i and not isGet
                end
            end
            v.obj_redPoint:SetActiveE(iscanGet and 1 or 0)
        end
    end
end
function SpringSignView:RefereshAllItem()
    for i =(self.currenttab-1)*7+1, self.currenttab*7 do
        self:RefreshItem(i)
    end
end

---按钮点击事件在这里派发
function SpringSignView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

---析构函数
function SpringSignView:Dispose()
    self:RemoveAllListener()
end

return SpringSignView