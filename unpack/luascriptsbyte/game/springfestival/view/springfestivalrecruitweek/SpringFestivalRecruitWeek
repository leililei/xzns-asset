---@class SpringFestivalRecruitWeek : UIBaseView	中文描述
---@field public go_table SpringFestivalRecruitWeek_GoTable GoTable
local SpringFestivalRecruitWeek = _G.BaseClass("SpringFestivalRecruitWeek", _G.UIBaseView)

function SpringFestivalRecruitWeek:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate,self.Close)
end

---界面的入口函数
function SpringFestivalRecruitWeek:OnCreate(activity)
    self.activity = activity
    self:InitView()
    self:UpdateView()
end

function SpringFestivalRecruitWeek:InitView()
    self.price = self.activity:GetPriceId()
    self.buyAward = self.activity:GetBuyAward()
    self.loginAward = self.activity:GetAwardList()
    self.go_table.aortext_discount.text = _G.GetLangPackValue(90031100020) .. _G.math.floor(self.activity:GetRebate() // 100) .. "%"
    self.elapsedTime = self.activity.curActivityClass.cfg.time.start_time +
    self.activity.curActivityClass.cfg.time.run_time - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(0)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.GwRecruitWeekFirstLogin, _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()))
    require("RedPointManager"):GetInstance():RefreshNode(self.activity:GetRedpointIDByIndex(1))
end

function SpringFestivalRecruitWeek:UpdateView()
    local isBuy = self.activity:GetIsBuy()
    self.go_table.aorbtn_buy:SetActiveE(isBuy and 0 or 1)
    self.go_table.aortext_price.text = _G.GetLangPackValue(90021600077,
        require("MallManager"):GetInstance():GetFinalPrice(self.price) // 100)

    local award
    self.go_table.obj_Content:ClearChildren()
    for _, v in pairs(self.buyAward) do
        award = v.type
        local sid = award[1] == 0 and award[4] or award[1]
        local count = award[1] == 0 and award[5] or award[2]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, count },
            self.go_table.obj_Content,
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                trans:SetGou(isBuy)
            end
        )
    end

    local tb, sid, count
    for k, v in pairs(self.loginAward) do
        if k > 7 then
            break
        end
        tb = _G.GetAutoGoTable(self.go_table["obj_award" .. k], _G.handler(self, self.OnClickAward))
        tb.aortext_day.text = _G.GetLangPackValue(90023800006, k)
        local isGet = self.activity:CheckIsGet(v.sid)
        local canGet = self.activity:CheckCanGet(v.sid)
        tb.aorbtn_click:SetActiveE(canGet and 1 or 0)
        tb.obj_root:ClearChildren()
        for _, v in pairs(v.base_award) do
            award = v.type
            sid = award[1] == 0 and award[4] or award[1]
            count = award[1] == 0 and award[5] or award[2]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, count },
                tb.obj_root,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    trans:SetGou(isGet)
                    trans:ShowEffect(canGet)
                    local data = _G.ConfigManager.god_halo_cfg[sid]
                    if data then
                        _G.AddViewBtnClick(trans.gameObject, _G.handlerbind(self, self.OnClickGodHalo, data))
                    end
                end
            )
        end
    end
end

function SpringFestivalRecruitWeek:UpdateTime(elapsed)
    self.elapsedTime = self.elapsedTime - elapsed
    if self.elapsedTime <= 0 then
        self:Close()
        return
    end
    self.go_table.aortext_time.text =
        _G.GetLangPackValue(90000010360,
            _G.TimeUtil.GodSpecialGiftForStr(self.elapsedTime))
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_time)
end

function SpringFestivalRecruitWeek:OnClickAward()
    self.activity:GetAward(function(msg)
        if msg.ack ~= 1 then
            return
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        self:UpdateView()
    end)
end

---界面的销毁函数
function SpringFestivalRecruitWeek:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function SpringFestivalRecruitWeek:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        self.activity:BuyGift(
            function(msg)
                if self:IsNil() then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                local jumpId = self.activity.curActivityClass:GetJumpType()
                local mainType = self.activity.curActivityClass:GetMainType()
                local activity=require("ActivitySynManager"):GetInstance():GetChildAcitivity(10065, jumpId, mainType)
                require("RedPointManager"):GetInstance():RefreshNode(activity.typeClass:GetRedpointIDByIndex(2))
                self:UpdateView()
            end
        )
    end
end

function SpringFestivalRecruitWeek:OnClickGodHalo(go, isOn, data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloShowView.Name, data, nil, nil, nil, nil, true)
end

return SpringFestivalRecruitWeek
