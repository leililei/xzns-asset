local base = require("RedPaperView")

---掉落物icon, 需匹配RedPaperModel.items
local DropIcons = {
    "ui_cjhd_rxyc_yxjm_dl",
    "ui_cjhd_rxyc_yxjm_jyb",
    "ui_cjhd_rxyc_yxjm_hb",
    "ui_cjhd_rxyc_yxjm_bzx",
    "ui_cjhd_rxyc_yxjm_tg", --顺序5是加时间
    "ui_cjhd_rxyc_yxjm_bzx",
}

---@class SpringRedPaperView : RedPaperView	MT送包包_游戏页面
---@field go_table SpringRedPaperView_GoTable GoTable
local SpringRedPaperView = _G.BaseClass("SpringRedPaperView", base)

---界面的入口函数
function SpringRedPaperView:OnCreate(callback,typecls)
    base.OnCreate(self, typecls)
    self.callback = callback
end

function SpringRedPaperView:LoadDragonSpine()
    _G.PoolsManager:GetInstance():Spawn(
        "WX_Role/Animation_UI/Xierwanasishizhuang03_UI/prf_Xierwanasishizhuang03_UI_ui",
        _G.ePoolType.Temporary,
        self.go_table.obj_dragon,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

function SpringRedPaperView:LoadRoleSpine()
    _G.PoolsManager:GetInstance():Spawn(
       "WX_Role/Animation_UI/Jianshengshizhuang03_UI/prf_Jianshengshizhuang03_UI_ui",
        _G.ePoolType.Temporary,
        self.go_table.obj_spine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self:DoGameStart()
        end
    )
    self:DoGameStart()
end

function SpringRedPaperView:SpawnObj(item, pos)
    if item then
        local tb = _G.GetAutoGoTable(_G.InstantiateObject(
            self.go_table.obj_item,
            self.go_table.obj_Node
        ))
        tb.gameObject:SetActiveE(1)
        tb.data = item
        tb.aorimage_icon.SpriteName = DropIcons[item.index] or item.icon
        -- tb.aorimage_icon:SetNativeSize()
        if item.type == "yellow" then
            tb.aorimage_icon:SetActiveE(1)
            tb.obj_eff:SetActiveE(0)
            tb["aortext_" .. item.type]:SetActiveE(1)
            tb["aortext_" .. item.type].text = "+" .. item.score
        elseif item.type == "red" then
            --tb.aorimage_icon:SetActiveE(0)
            tb.obj_eff:SetActiveE(1)
            -- if tb.obj_eff:GetChildCountE() == 0 then
            --     self:LoadEffect(_G.ConfigManager.ui_effect_cfg.ef_huoqiu, tb.obj_eff)
            -- end
            tb["aortext_" .. item.type]:SetActiveE(1)
            tb["aortext_" .. item.type].text = "-" .. item.time .. "S"
        elseif item.type == "green" then
            tb.aorimage_icon:SetActiveE(1)
            tb.obj_eff:SetActiveE(0)
            tb["aortext_" .. item.type]:SetActiveE(1)
            tb["aortext_" .. item.type].text = "+" .. item.time .. "S"
        end
        tb.obj_item:SetActiveE(1)
        tb.obj_item:SetLocalPosition(pos[1], pos[2], 0)
        tb.rect = tb.obj_item:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        table.insert(self.itemList, tb)
        table.insert(self.items, tb.gameObject)
    end
end

function SpringRedPaperView:DespawnObj(trans, poolType)
    _G.DestroyObject(trans)
end

---设置游戏结束
function SpringRedPaperView:SetGameEnd()
    base.SetGameEnd(self, function()
        local curScore = require("RedPaperModel"):GetInstance():GetScore()
        if self.callback then
            self.callback(curScore)
        end
    end)
end

---按钮点击事件在这里派发
function SpringRedPaperView:OnClickBtn(go, ...)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    else
        base.OnClickBtn(self, go, ...)
    end
end

function SpringRedPaperView:SetNextDescript(text)
    self.go_table.aortext_next.text = text
end

return SpringRedPaperView
