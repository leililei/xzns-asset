---@class SpringFestivalGloryAssemblyView : UIBaseView    荣耀集结主页
---@field go_table SpringFestivalGloryAssemblyView_GoTable
---@field activity ActivitySynBase
---@field model GloryAssemblyModel
---@field type number                                                           @当前类型: 1个人, 2全服
---@field value number                                                          @当前进度值
---@field awardDatas activity_honor_gathering.i_cfg_list[]                      @奖励数据
---@field awardItems table<any,SpringFestivalGloryAssemblyView._obj_awardItem_GoTable>        @奖励节点
---@field remainTime number                                                     @活动剩余时长
---@field cdTimer Timer                                                         @活动时长计时器
local SpringFestivalGloryAssemblyView = _G.BaseClass("SpringFestivalGloryAssemblyView", _G.UIBaseView)

function SpringFestivalGloryAssemblyView:Awake()
    --初始化状态
    self.type = 1
    --初始化列表
    self.go_table.scrollloopvectical_award:InitItemData(0, _G.handler(self, self.RefreshAwardItem))

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SpringFestivalGloryAssemblyView:OnDestroy()
    if self.model then
        self.model:SetViewInstance(nil)
        self.model = nil
    end
    if self.cdTimer then
        self.cdTimer:Stop()
        self.cdTimer = nil
    end
    if self.stopEffTimer then
        self.stopEffTimer:Stop()
        self.stopEffTimer = nil
    end
    if self.stopAudioTimer then
        self.stopAudioTimer:Stop()
        self.stopAudioTimer = nil
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.ui_cfg.MainView.audio)
end

---界面的入口函数
function SpringFestivalGloryAssemblyView:OnCreate(activity)
    self.cfg = _G.ConfigManager.discrete_cfg[201001]
    self.periodCfg = _G.ConfigManager.discrete_cfg[201002]
    self.audioCfg = _G.ConfigManager.discrete_cfg[201003]
    self.skinId = _G.ConfigManager.discrete_cfg[201007][1][1]
    self.activity = activity
    self.model = activity:GetActivityTypeCls()
    self.model:SetViewInstance(self)
    self.model:RefreshRedPoint()
    self.donateNum = 0
    self.donateTimes = 0
    self.donatePeriod = 1
    self.lastPeriod = 1
    self.curAudioIndex = 2
    self.isShowInfo = true
    self.addNum = self:GetPeriodCfg(2)
    self:InitData()
    self:InitView()
    self:UpdateView()

    --活动倒计时
    local _, endTime = self.model:GetTime()
    self.remainTime = endTime - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTimeView(0)
    self.cdTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeView, self, false, false, true)
    self.cdTimer:Start()
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.discrete_cfg[201004][1][1])
end

function SpringFestivalGloryAssemblyView:InitData()
end

---初始页面状态
function SpringFestivalGloryAssemblyView:InitView()
    local cfg = _G.ConfigManager.card_cfg[self.skinId] or _G.ConfigManager.skin_cfg[self.skinId]
    local path = cfg.ModelPathHi--界面spine资源路径
    self.go_table.aorimage_Head.SpriteName = cfg.Icon
    --初始化红点
    self.go_table.obj_donateRedpoint:UpdateRedPointItemIDAndParam(self.model:GetRedpointIDByIndex(2))
    _G.PoolsManager:GetInstance():Spawn(--界面spine资源
        path,
        _G.ePoolType.Temporary,
        self.go_table.trans_Spine,
        function(trans)
            if not self.go_table then
                _G.DestroyImmediate(trans)
                return
            end
            self.spineSG = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            self.spineParent = self.spineSG:GetParent()
            self.spineAsset = self.spineSG.SkeletonDataAsset:GetSkeletonData(false)
            self:LoadSpineCall(trans)
        end
    )
    _G.PoolsManager:GetInstance():Spawn(--法杖资源
    "WX_Role/Animation_UI/Fazhang/prf_Fazhang_ui",
        _G.ePoolType.Temporary,
        self.go_table.obj_donateItem,
        function (trans)
            if not self.go_table then
                _G.DestroyImmediate(trans)
                return
            end
            self.donateItem = trans
            self.donateItem:SetLocalScaleXYZ(0.8)
            self.donateItem:SetLocalPosition(0, -120)
            self.donateItemSg = self.donateItem:GetComponentInChildrenE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
        end
    )
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_wenzitiaodong, self.go_table.obj_donateText)
    _G.SetEventTrigger(self.go_table.aorbtn_donate, "onLongPress", _G.handlerbind(self, self.OnLongPress))
    _G.SetEventTrigger(self.go_table.aorbtn_donate, "onUp", _G.handlerbind(self, self.OnUp))
end

function SpringFestivalGloryAssemblyView:LoadSpineCall(trans)
end

---更新活动倒计时
---@param elapsed number
function SpringFestivalGloryAssemblyView:UpdateTimeView(elapsed)
    if elapsed then
        self.remainTime = self.remainTime - elapsed
    end
    local t = _G.TimeUtil.TranslateSecond(self.remainTime)
    local tStr
    if t.day > 0 then
        tStr = _G.GetLangPackValue(90022100001, t.day, t.hour)
    else
        tStr = _G.GetLangPackValue(90022100002, t.hour, t.min)
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000013201, tStr)
end

---更新页面状态
function SpringFestivalGloryAssemblyView:UpdateView()
    self:UpdateAwardView()--更新奖励信息
    self:UpdateCoinView()--更新货币信息
end

---更新货币状态
function SpringFestivalGloryAssemblyView:UpdateCoinView()
    local coinNum = self.model:GetCoinNumber()
    
    local addNum = self.realAddNum and self.realAddNum or self.addNum
    --本次捐献之前的剩余道具数
    self.tempNum = self.donateTimes == 1 and coinNum or coinNum - self.donateNum + addNum
    self.tempNum = _G.math.min(self.tempNum, coinNum)
    local loopTimes = 0
    local updateCoinText
    updateCoinText = function()
        if not self.isPressing or loopTimes == addNum then
            return
        end
        loopTimes = loopTimes + 1
        local curNum = self.tempNum - loopTimes
        if curNum < coinNum - self.donateNum then
            return
        end
        self.go_table.aortext_consume.text = string.format(curNum == 0 and "×<color=red>%s</color>" or "×%s", curNum)
        _G.DelayDo((self.cfg[self.donatePeriod][4] / addNum), updateCoinText)--策划要动态展示消耗道具数量的过程
    end
    local nowNum = _G.math.max(0, coinNum - self.donateNum)
    self.go_table.aortext_consume.text = string.format(coinNum == 0 and "×<color=red>%s</color>" or "×%s", nowNum)
end

---更新奖励视图
function SpringFestivalGloryAssemblyView:UpdateAwardView()
    self.awardDatas = self.model:GetCfgs(self.type) or {}
    self.value = self.model:GetSelfValue()
    if not self.originValue then
        self.originValue = self.value
    end
    if self.isPressing then
        self.value = self.value + _G.math.min(self.donateNum, self.model:GetCoinNumber())
    end

    --视图页面
    self.go_table.aortext_progress.text = tostring(self.value)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_ProgressBg)
    --奖励列表
    local jumpIndex = #self.awardDatas --跳转到可领取奖励丶最新进度处
    for index, t in ipairs(self.awardDatas) do
        if self.value >= t.condition then
            if not self.model:CheckAward(self.type, t.sid) then
                jumpIndex = index
            end
        end
    end
    local curIndex = 0--当前进度位置，捐献中跳转
    local reachIndex = 0--首次达成奖励的id，用于播放达成特效
    for index, t in ipairs(self.awardDatas) do
        if self.value < t.condition then
            curIndex = index
            break
        end
        if reachIndex == 0 and self.originValue < t.condition and self.value >= t.condition then
            self.originValue = self.value
            reachIndex = index
        end
    end
    if curIndex == 0 then--达到最后奖励的贡献值
        self.isMaxValue = true
    end
    self:UpdateInfo()
    if reachIndex ~= 0 then--本次更新有达成奖励需求播放一次特效
        local playEff = function(path)
            _G.UIUtils.LoadEffectByCfg(
                path,
                self.go_table.obj_bgEffect,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                end
            )
        end
        if reachIndex == #self.awardDatas then
            playEff(_G.ConfigManager.ui_effect_cfg.ef_xinchunhongbao)
            playEff(_G.ConfigManager.ui_effect_cfg.ef_xinchunlihua)
        elseif reachIndex % 2 == 1 then
            playEff(_G.ConfigManager.ui_effect_cfg.ef_xinchunhongbao)
        else
            playEff(_G.ConfigManager.ui_effect_cfg.ef_xinchunlihua)
        end
        if self.curProgress then
            self.curProgress.tb.obj_fillLast:RemoveAllChildren()
        end
    elseif self.isAttacking then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_shouji,
                self.go_table.obj_bgEffect,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                end
        )
    end
    self.go_table.scrollloopvectical_award:UpdateCount(#self.awardDatas - 1, jumpIndex)
    if self.value > 0 and curIndex > 0 and self.donateNum > 0 then
        self.go_table.scrollloopvectical_award:ScrollToIndex(curIndex - 1)
    end
    
    self:ShowAwardItem(_G.GetAutoGoTable(self.go_table.obj_BigAwardItem), #self.awardDatas - 1)
end

function SpringFestivalGloryAssemblyView:UpdateInfo()
    local isGetBigAward = self.model:CheckAward(self.type, self.awardDatas[#self.awardDatas].sid)
    if isGetBigAward then
        self.go_table.aorimage_Info:SetActiveE(0)
        return
    end
    self.go_table.aorimage_Info:SetActiveE((self.isShowInfo or self.isMaxValue) and 1 or 0)
    local langId = self.isMaxValue and 201006 or 201005
    self.go_table.aortext_TaskText.text = _G.GetLangPackValue(_G.ConfigManager.discrete_cfg[langId][1][1])
end

---刷新奖励节点
---@param index number
---@param go UnityEngine.GameObject
function SpringFestivalGloryAssemblyView:RefreshAwardItem(index, go)
    if not self.awardItems then
        self.awardItems = {}
    end
    ---@type SpringFestivalGloryAssemblyView._obj_awardItem_GoTable
    local item = self.awardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.awardItems[go:GetInstanceIDE()] = item
    end
    self:ShowAwardItem(item, index)

end

---展示奖励节点信息
function SpringFestivalGloryAssemblyView:ShowAwardItem(item, index)

    local data = self.awardDatas[index + 1]
    local meet = data.condition <= self.value --是否满足目标
    local isBigAward = index + 1 == #self.awardDatas

    item.data = data
    item.aortext_value.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.condition, false)
    local progress = 0
    local lastValue = 0
    if index > 0 then
        lastValue = self.awardDatas[index].condition
    end
    if meet then
        progress = 1
    elseif self.value <= lastValue then
        progress = 0
    else
        local curValue = _G.math.min(self.value - lastValue, data.condition - lastValue)
        local totalValue = data.condition - lastValue
        progress = curValue / totalValue
        if progress < 0 then
            progress = 0
        end
    end
    local isCurProgress = progress > 0 and progress < 1
    if isCurProgress then
        self.curProgress = {
            tb = item,
            curIndex = index,
            value = progress
        }
    else
        item.obj_fillLast:RemoveAllChildren()
    end
    item.obj_fillLast:SetRectTransformSize(progress * 40, 12)

    --奖励信息
    item.obj_reward:ClearChildren()
    if data.award and #data.award > 0 then
        local isGetAward = self.model:CheckAward(self.type, data.sid)
        local canGetAward = not isGetAward and data.condition <= self.value
        local firstAward = data.award[1].type
        if firstAward[1] == 0 and #firstAward >= 5 then
            --活动代币格式: 0 # 活动id # 活动jumpid # 物品id # 物品数量...
            local temp = {}
            for i = 4, #firstAward do
                table.insert(temp, firstAward[i])
            end
            firstAward = temp
        end
        item.obj_canGet:SetActiveE((canGetAward and not isGetAward) and 1 or 0)
        if isBigAward then
            item.aorimage_ItemBg.SpriteName = "ui_jymt_dikuang_tsk"
            if not isGetAward then
                if item.obj_Eff:GetChildCountE() == 0 then
                    _G.UIUtils.LoadEffectByCfg(
                            _G.ConfigManager.ui_effect_cfg.ef_yeqian_caicj,
                            item.obj_Eff,
                            function(trans)
                                if not self.go_table then
                                    _G.DestroyImmediate(trans)
                                    return
                                end
                            end
                    )
                end
            else
                item.obj_Eff:RemoveAllChildren()
            end
        elseif canGetAward or isGetAward then
            item.aorimage_ItemBg.SpriteName = "ui_jymt_dikuang_ydc"
        else
            item.aorimage_ItemBg.SpriteName = "ui_jymt_dikuang_wdc"
        end
        item.aorimage_ItemBg:SetNativeSize()
        item.aorimage_isGet:SetActiveE(isGetAward and 1 or 0)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                firstAward,
                item.obj_reward,
                function(node)
                    if self:IsNil() or item.data ~= data then
                        _G.DestroyObject(node.gameObject)
                        return
                    end
                    node.hideColor = true
                    node.gameObject:SetLocalScaleXYZ(0.85)
                    node:SetGou(false)
                    if node.go_table.obj_item then
                        node.go_table.obj_item:SetLocalScaleXYZ(0.8)
                        node.go_table.obj_item:SetLocalPosition(0, -8, 0)
                        if node.go_table.obj_item:GetChildCountE() > 0 then
                            local tb = _G.GetAutoGoTable(node.go_table.obj_item:GetChildE(0))
                            tb.aorimage_Color:SetActiveE(0)
                        end
                    end
                    node:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end,
                function(go, isOn)
                    if self.value >= data.condition and not self.model:CheckAward(self.type, data.sid) then
                        self:GetAward()
                    else
                        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, firstAward[1])
                    end
                end
        )
    end
end

---领取节点奖励
function SpringFestivalGloryAssemblyView:GetAward()
    local sids = {}
    for _, data in pairs(self.awardDatas) do
        if data.condition > self.value then
            break
        end
        if not self.model:CheckAward(self.type, data.sid) then
            table.insert(sids, data.sid)
        end
    end
    if #sids == 0 then
        return
    end

    ---发起领取请求
    self.model:GetAward(self.type, sids, function(msg)
        self:UpdateView()
        _G.UIUtils.ShowCommonAward(msg)
    end)
end

---获取阶段配置（1-开始次数，2-消耗数量，3-特效数量范围，4-发射间隔）
function SpringFestivalGloryAssemblyView:GetPeriodCfg(index)
    return self.periodCfg[self.donatePeriod][index]
end

---切换Spine受击/正常状态
function SpringFestivalGloryAssemblyView:ChangeSpine()
    local haveCfg = not _G.table.isEmptyOrNil(self.cfg)
    local time = 0.025
    local scale = self.isHit and 1.125 or 1.1
    local color = self.isHit and "ABABAB" or "FFFFFF"
    local y = self.isHit and -72 or 0
    if haveCfg then
        time = self.cfg[self.donatePeriod][1] * (1 / 3)
        scale = self.isHit and self.cfg[self.donatePeriod][2] + 0.025 or self.cfg[self.donatePeriod][2]
        y = self.isHit and self.cfg[self.donatePeriod][3] - 8 or self.cfg[self.donatePeriod][3]
    end
    self.spineParent:DOLocalMoveY(y, time):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)
    self.spineSG.color = _G.ColorTools.FormatColorByString(color)
    self.spineParent:DOScale(scale, scale, scale, time):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)
end

---切换法杖状态
function SpringFestivalGloryAssemblyView:ChangeBtn()
    if self.isPressing == true then
        self.go_table.obj_donateText:SetActiveE(0)
        self.donateItemSg.AnimationState:SetAnimation(0, "fazhang_gongji1", false)
    else
        self.go_table.obj_donateText:SetActiveE(1)
        self.donateItemSg.AnimationState:SetAnimation(0, "fazhang_zhuangtai2", false)
    end
end

---播放法杖特效
function SpringFestivalGloryAssemblyView:PlayEffect()
    self.isPlaying = true
    if self.isShowInfo then
        self.isShowInfo = false
    end
    if not self.isMaxValue and self.curProgress and self.curProgress.value ~= 1 then--有没满进度的进度条才播特效
        local tb = self.curProgress.tb
        local x = tb.obj_fillLast:GetRectTransformSize()
        if tb.obj_fillLast:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_Jindulan,
                tb.obj_fillLast,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                    trans:SetLocalPosition(x, 0)
                end
            )
        else
            local eff = tb.obj_fillLast:GetChildE(0)
            if eff then
                eff:SetLocalPosition(x, 0)
            end
        end
    end
    --Spine放大到攻击中大小
    local scale = self.cfg[self.donatePeriod][2]
    local time = self.cfg[self.donatePeriod][1] * (2 / 3)
    self.spineParent:DOLocalMoveY(self.cfg[1][3], time):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)
    self.spineParent:DOScale(scale, scale, scale, time):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)
    if not self.isShow then--本次捐献时没有在播show动作的时候才播一次
        self.isShow = true
        self.spineSG.AnimationState:SetAnimation(0, "show", true)
        self.spineSG.AnimationState:Complete("+", function()
            self.isShow = nil
            self.spineSG.AnimationState:SetAnimation(0, "idle", true)
        end)
    end
    local delayTime = self.cfg[self.donatePeriod][4]--特效播放后播放spine效果的延迟
    local cfg = self:GetPlayEffect()
    if self.stopEffTimer then
        self.stopEffTimer:Reset()
    else
        self.stopEffTimer = _G.TimerManager:GetInstance():GetTimer(1, self.StopEffCall, self, false, false, true)
        self.stopEffTimer:Start()
    end
    self.isAttacking = true
    self:UpdateView()
    _G.UIUtils.LoadEffectByCfg(--法杖特效
        cfg,
        self.go_table.obj_donateItem,
        function(obj)
            if not self.go_table then
                _G.DestroyImmediate(obj)
                return
            end
            _G.DelayDo(delayTime, function()--延迟一段时间后播放Spine受击效果
                if not self.go_table then
                    return
                end
                self.isHit = true
                self:ChangeSpine()
                self:PlayAudio()
                self.isAttacking = false
            end)
        end,
        function()
            if not self.go_table then
                return
            end
            self.isHit = false
            self:ChangeSpine()
        end
    )
end

function SpringFestivalGloryAssemblyView:GetPlayEffect()
    local effIndex = _G.math.random(1, self:GetPeriodCfg(3))--特效的随机范围
    return self.donatePeriod == 1 and 
            _G.ConfigManager.ui_effect_cfg["ef_SpringFestival_" .. effIndex] or
            _G.ConfigManager.ui_effect_cfg["ef_tuowei_" .. self.addNum .. "_" .. effIndex]
end

function SpringFestivalGloryAssemblyView:PlayAudio()
    if self.isEndPlay or self.isPlayAudio then
        return
    end
    self.isPlayAudio = true
    if self.curAudioIndex > #self.audioCfg[self.donatePeriod] then
        self.curAudioIndex = 2
    end
    if self.lastPeriod ~= self.donatePeriod then
        self.lastPeriod = self.donatePeriod
        self.curAudioIndex = 2
    end
    self.curAudio = self.audioCfg[self.donatePeriod][self.curAudioIndex]
    _G.AudioManager.PlayAudio(
            _G.AudioType.PlaySound,
            self.curAudio,
            nil,
            nil,
            function()
                _G.DelayDo(
                    self.audioCfg[self.donatePeriod][1],
                    function()
                        self.isPlayAudio = false
                        self.curAudioIndex = self.curAudioIndex + 1
                    end
                )
            end
    )
end

---结束播放特效
function SpringFestivalGloryAssemblyView:StopEffect()
    self.isEndPlay = true
end

---特效结束计时器回调
function SpringFestivalGloryAssemblyView:StopEffCall()
    if self.isEndPlay == true and not self.isAttacking then
        self.isPressing = false
        self.isPlaying = nil
        self.isEndPlay = nil
        if self.curProgress then--删除进度条上的特效
            self.curProgress.tb.obj_fillLast:RemoveAllChildren()
        end
        self:ChangeBtn()
        if self.awardCall then
            self.awardCall()
            self.awardCall = nil
        end
        ---Spine缩小回正常尺寸
        local scale = 1
        local time = self.cfg[self.donatePeriod][1] * (2 / 3)
        self.spineParent:DOLocalMoveY(0, time):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)
        self.spineParent:DOScale(scale, scale, scale, time):SetEase(_G.CS.DG.Tweening.Ease.InOutSine)
        if self.stopEffTimer then
            self.stopEffTimer:Stop()
            self.stopEffTimer = nil
        end
    end
end

function SpringFestivalGloryAssemblyView:StopAudioCall()
    if self.isPlayAudio and self.curAudio and
        not _G.AudioManager.CheckIsPlay(_G.ConfigManager.audio_cfg[self.curAudio].audio_res) 
    then
        if self.stopAudioTimer then
            self.stopAudioTimer:Stop()
            self.stopAudioTimer = nil
        end
        _G.DelayDo(
            self.audioCfg[self.donatePeriod][1], 
            function()
                self.isPlayAudio = false
                self.curAudioIndex = self.curAudioIndex + 1
            end
        )
    end
end

---按钮点击事件在这里派发
function SpringFestivalGloryAssemblyView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.awardCall then
            self.awardCall()
            self.awardCall = nil
        end
        self:Close()
    elseif go == self.go_table.aorbtn_donate then--单次点击捐献按钮
        if self.isPlaying or self.isAttacking then
            return
        end
        if self.model:GetCoinNumber() < 1 then
            self.donateNum = 1
            self.isPressing = true
            self:OnUp()
            return
        end
        self:PlayEffect()
        if not self.isPressing then
            self.donateNum = 1
            self.isPressing = true
            self:ChangeBtn()
            self:OnUp()
        end
    elseif go == self.go_table.aorbtn_help then
        if self.model.precast and self.model.precast[1] and self.model.precast[1] == "MTSpringFestivalGloryAssemblyView" then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 194)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 183)
        end
    elseif go == self.go_table.aorbtn_Go then
        local skinCfg = _G.ConfigManager.skin_cfg[self.skinId]
        local cardData = require("CardData").GetPreviewData(skinCfg.card)
        cardData:SetSkin(0)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardShowView.Name,
            { CardData = cardData },
            nil,
            true,
            nil,
            self.skinId
        )
    end
end

---连续捐献
function SpringFestivalGloryAssemblyView:OnLongPress()
    if self.endPress or self.isAttacking == true then
        return
    end
    local coinNum = self.model:GetCoinNumber()
    if coinNum == 0 then
        self.donateNum = 1
        self:OnUp()
        return
    end
    if self.donateNum >= coinNum then--消耗完所有道具直接结算
        self.donateNum = _G.math.max(self.donateNum, 1)
        self.endPress = true
        self:OnUp()
        return
    end
    self.donateTimes = self.donateTimes + 1--第几次捐献
    local nextCfg = self.periodCfg[self.donatePeriod + 1]--下个消耗阶段
    if nextCfg then
        if self.donateTimes >= nextCfg[1] then
            self.donatePeriod = self.donatePeriod + 1
        end
    end
    self.addNum = self:GetPeriodCfg(2)
    self.realAddNum = _G.math.min(coinNum - self.donateNum, self.addNum)--如果道具数量不足这次消耗就全部使用掉
    self.donateNum = self.donateNum + self.realAddNum
    self.isPressing = true
    self:ChangeBtn()
    self:PlayEffect()
end

---结束捐献
function SpringFestivalGloryAssemblyView:OnUp()
    if self.donateNum == 0 or not self.isPressing then
        return
    end
    _G.DelayDo(0.5, function()--给单点时的音效播放留一点时间
        self:StopEffect()
    end)
    local coinSid, coinNum = self.model:GetCoinSid(), self.model:GetCoinNumber()
    if coinNum < self.donateNum then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, coinSid)
        return
    end
    self.isPressing = false
    self.model:Donate(coinSid, self.donateNum, function(msg)
        if msg and msg.ack == 1 then
            self.donateNum = 0
            self.donateTimes = 0
            self.donatePeriod = 1
            self.curAudioIndex = 2
            self.addNum = self:GetPeriodCfg(2)
            self:UpdateView()
            if msg.award then
                self.awardCall = function()
                    _G.UIUtils.ShowCommonAward(msg)
                end 
                _G.DelayDo(2, function()--延迟一会再弹恭喜获得，防止遮挡表现效果
                    if self.go_table and self.awardCall then
                        self.awardCall()
                        self.awardCall = nil
                    end
                end)
            end
        end
    end)
end

return SpringFestivalGloryAssemblyView
