---@class ResLoadingManager : Singleton	中文描述
local ResLoadingManager = _G.BaseClass("ResLoadingManager", _G.Singleton)
_G.ResLoadingManager = ResLoadingManager
local count = 0
---开始下载资源
function ResLoadingManager:Start(name)
    count=count+1
    local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ResLoadingView.Name)
    if(win)then
        --_G.log_error_table(count.."--------->加载资源路径"..name)
        win.View:CheckReStart()
    else
        --_G.log_error_table(count.."--------->加载资源路径"..name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ResLoadingView.Name)
    end
end
---资源下载完成
function ResLoadingManager:Finish(name)
    count = count - 1
    if(count<0)then
        count=0
    end
    --_G.log_error_table(count.."-------->完成加载"..name)
    if(count<=0)then
        local win = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ResLoadingView.Name)
        if(win)then
            --win.View:HideView()
            win.View:Close()
        end
    end
end

return ResLoadingManager
