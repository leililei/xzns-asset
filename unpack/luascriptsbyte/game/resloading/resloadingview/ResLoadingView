---@class ResLoadingView : UIBaseView    中文描述
---@field public go_table ResLoadingView_GoTable GoTable
local ResLoadingView = _G.BaseClass("ResLoadingView", _G.UIBaseView)

---界面的入口函数
function ResLoadingView:OnCreate()
    self.goTable = self.go_table
    self.goTable.trans_eff.gameObject:SetActiveE(0)
    self:ReStart()
end
function ResLoadingView:CheckReStart()
    if(self and self.goTable)then
        --self:Show()
        self:ReStart()
    end
end
function ResLoadingView:ReStart()
    if(self.delayDo~=nil)then
        self.delayDo:Stop()
    end
    self.delayDo =
    _G.TimerManager:GetInstance():GetTimer(
            0.5,
            function()
                self.goTable.trans_eff.gameObject:SetActiveE(1)
            end,
            self,
            true
    )
    self.delayDo:Start()
end
function ResLoadingView:HideView()
    self.delayDo:Stop()
    self:Hide()
end
function ResLoadingView:OnDestroy()
    self.delayDo:Stop()
end

return ResLoadingView
