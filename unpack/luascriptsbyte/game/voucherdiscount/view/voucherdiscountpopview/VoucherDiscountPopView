---@class VoucherDiscountPopView : UIBaseView    中文描述
---@field public go_table VoucherDiscountPopView_GoTable GoTable
local VoucherDiscountPopView = _G.BaseClass("VoucherDiscountPopView", _G.UIBaseView)

local Background = {
    [2001] = { "ImagesH5/hVoucherDiscount/ui_djqzkktc_jk", "ImagesH5/hVoucherDiscount/ui_djqzkktc_jk_kuang" },
    [2002] = { "ImagesH5/hVoucherDiscount/ui_djqzkktc_hjk", "ImagesH5/hVoucherDiscount/ui_djqzkktc_hjk_kuang" },
    [2003] = { "ImagesH5/hVoucherDiscount/ui_djqzkktc_bjk", "ImagesH5/hVoucherDiscount/ui_djqzkktc_bjk_kuang" }
}

---构造函数
---@protected
function VoucherDiscountPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function VoucherDiscountPopView:OnCreate(data)
    self:Init(data)
end

---@param data TipBaseModel
function VoucherDiscountPopView:Init(data)
    self.data = data
    local sid = _G.tonumber(data.cfg.UseParameter[1][1])
    local cashCfg = _G.ConfigManager.item_accumulate_cfg[sid]
    self.cashCfg = cashCfg
    self.go_table.aorrawimage_itemBg:LoadImage(Background[sid][1])
    self.go_table.aorrawimage_outLine:LoadImage(Background[sid][2])
    local ratio = cashCfg.ratio_recharge / 10000
    if _G.GameUtil.GetIsUseChinese() then
        self.go_table.aortext_voucherDiscount.text = _G.GetLangPackValue(90028800006, math.floor(ratio * 10))
    else
        self.go_table.aortext_voucherDiscount.text = _G.GetLangPackValue(90028800006, math.floor(ratio * 100))
    end
    self.go_table.aortext_name.text = _G.GetLangPackValue(data.cfg.Name)
end

---界面的销毁函数
function VoucherDiscountPopView:OnDestroy()
end

---按钮点击事件在这里派发
function VoucherDiscountPopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_shadow then
        self:Close()
    end
end

return VoucherDiscountPopView