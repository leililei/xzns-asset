---@class VoucherDiscountModel : GameDataModelBase 等级活到
local VoucherDiscountModel = _G.BaseClass("VoucherDiscountModel", _G.Singleton)

function VoucherDiscountModel:__init()
    self.itemCards = {}
end

---@return VoucherDiscountModel VoucherDiscountModel
function VoucherDiscountModel:GetInstance()
    return self.super.GetInstance(self)
end

---
---@protected
function VoucherDiscountModel:GetVoucherDiscountData()
    local rio = 10000
    local cfg
    if _G.table.count(self.itemCards) > 0 then
        for k, v in pairs(self.itemCards) do
            local value = _G.ConfigManager.item_accumulate_cfg[tonumber(v.cfg.UseParameter[1][1])]
            if value.ratio_recharge < rio then
                rio = value.ratio_recharge
                cfg = v
            end
        end
    end
    return cfg
end

function VoucherDiscountModel:GetVoucherDiscountValue()
    local rio = 10000
    if _G.table.count(self.itemCards) > 0 then
        for k, v in pairs(self.itemCards) do
            local value = _G.ConfigManager.item_accumulate_cfg[tonumber(v.cfg.UseParameter[1][1])]
            if value.ratio_recharge < rio then
                rio = value.ratio_recharge
            end
        end
    end
    return rio / 10000
end

function VoucherDiscountModel:AddItem(propData)
    if self.itemCards[propData.sid] ~= nil then
        self.itemCards[propData.sid].args.time = propData.args.time
        local str = _G.GetLangPackValue(_G.ConfigManager.tips_system_cfg[517].content, _G.StorageManager:GetInstance():GetItemName(propData.sid), _G.ConfigManager.item_accumulate_cfg[tonumber(propData.cfg.UseParameter[1][1])].duration)
        _G.PopWindowManager:GetInstance():ShowAllTips(
            517,
            str
        )
    else
        local value = _G.ConfigManager.item_accumulate_cfg[tonumber(propData.cfg.UseParameter[1][1])]
        if (value.expiration_time * 86400) >= (propData.args.time - _G.TimeUtil.GetServerUnixTime()) then
            _G.table.insert(require("QuickUseModel"):GetInstance().quene, 1, { itemData = propData, sid = propData.sid, cfg = propData.cfg })
            require("QuickUseModel"):GetInstance():CheckCanQucikUse()
        end
        self.itemCards[propData.sid] = propData
        if not self.timer0 then
            self.timer0 = _G.TimerManager:GetInstance():GetTimer(1, self.InitTimer, self, true, false, true)
            self.timer0:Start()
        end
    end
end

function VoucherDiscountModel:RemoveItem(sid)
    self.itemCards[sid] = nil
end

function VoucherDiscountModel:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer0 then
        self.timer0:Stop()
        self.timer0 = nil
    end
    local now = _G.TimeUtil.GetServerUnixTime()
    local time, et
    local removeLis = {}
    for _, v in pairs(self.itemCards) do
        et = v.args.time
        if now >= et then
            _G.table.insert(removeLis, v.sid)
        else
            if time == nil or et < time then
                time = et
            end
        end
    end
    for _, sid in pairs(removeLis) do
        self:RemoveItem(sid)
        _G.StorageManager:GetInstance():ConsumeItem(sid, 0, 1)
    end
    if #removeLis > 0 then
        _G.Events:GetInstance():Broadcast(_G.eBag.BagVoucherDiscountOverdue)
    end
    if time then
        local endTime = time - _G.TimeUtil.GetServerUnixTime()
        if endTime > 0 then
            self.timer = _G.TimerManager:GetInstance():GetTimer(endTime, self.InitTimer, self, true, false, true)
            self.timer:Start()
        end
    end
end

function VoucherDiscountModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer0 then
        self.timer0:Stop()
        self.timer0 = nil
    end
end

return VoucherDiscountModel
