---@class CharacterView : UIBaseView	角色信息界面
---@field public go_table CardInfoView_GoTable GoTable
---@field public sceneTrans UnityEngine.Transform 场景
---@field public roleTrans UnityEngine.Transform 当前模型
---@field card_cfg card_cfg
local CharacterView = _G.BaseClass("CharacterView", _G.UIBaseView)
function CharacterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_drag"] = function(self, go)
            self:RoleRecycles()
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    ---@type card_show_cfg
    ---角色展示特效表
    self.myCard_show_cfg = nil
    ---角色展示常驻特效 缓存  清空
    self.ActionEffArr = {}
    ---角色展示临时特效 缓存  清空
    self.ActionEffTempArr = {}
    ---角色展示 音效 缓存  清空
    self.ActionAudioArr = {}
    ---角色展示 音效 缓存  清空
    self.ActionAudioArr = {}

    ---展示动作时长（3D展示用）
    self.InfoMoveTime = 5
    ---相机坐标
    self.ControlCameraPosArr = {0.4, 1.75, 7.55}

    ---相机旋转四元素
    self.ControlCameraQuaArr = {0, 1, 0, 0}
end

---界面的入口函数
function CharacterView:OnCreate(Data)
    local data = _G.tonumber(Data[1])
    self.card_cfg_Data = {}

    self.card_cfg_Data = _G.ConfigManager.card_cfg[data]
    local myCard_show_cfg = _G.ConfigManager.card_show_cfg[data]

    if myCard_show_cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("card_show_cfg 未找到配置 sid:" .. data)
        end
    end

    self.myCard_show_cfg = myCard_show_cfg

    if self.myCard_show_cfg.portrait_Path ~= nil and #self.myCard_show_cfg.portrait_Path > 0 then
        self.go_table.aorimage_name.SpriteName = self.myCard_show_cfg.portrait_Path[1]
        self.go_table.aorimage_name:SetNativeSize()

        self.go_table.aorimage_name2.SpriteName = self.myCard_show_cfg.portrait_Path[2]
        self.go_table.aorimage_name2:SetNativeSize()
    else
        self.go_table.aorimage_name:SetActiveE(0)
    end

    if self.myCard_show_cfg.action_time ~= nil then
        self.InfoMoveTime = self.myCard_show_cfg.action_time
    end
    if self.myCard_show_cfg.pos_camera ~= nil and #self.myCard_show_cfg.pos_camera > 0 then
        self.ControlCameraPosArr = self.myCard_show_cfg.pos_camera
    end

    if self.myCard_show_cfg.play_speed ~= nil then
        _G.CS.UnityEngine.Time.timeScale = self.myCard_show_cfg.play_speed
    end

    if self.myCard_show_cfg.pos_portrait ~= nil and #self.myCard_show_cfg.pos_portrait > 0 then
        self.go_table.aorimage_name:SetLocalPosition(
            self.myCard_show_cfg.pos_portrait[1],
            self.myCard_show_cfg.pos_portrait[2],
            0
        )
    end
    if self.sceneTrans == nil then
        self:LoadEmbattleScene(
            function(sceneTrans)
                self:LoadRoleScene(
                    self.card_cfg_Data.ModelPathHi,
                    function(roleTrans)
                        _G.TimerManager:GetInstance():GetTimer(
                            self.InfoMoveTime,
                            self.DingShiXianShi,
                            self,
                            true,
                            false,
                            true
                        ):Start()
                    end
                )
            end
        )
    end
end
--region 加载场景
-----加载场景
---@field camera _G.Camera
function CharacterView:LoadEmbattleScene(callback)
    _G.PoolsManager:GetInstance():Spawn(
        _G.ConfigManager.ui_scens_cfg[8].Scene,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                _G.LogError(
                    "场景无法加载 path:" .. _G.ConfigManager.scene_cfg[2].Scene .. "    CardInfoView LoadEmbattleScene"
                )
                return
            end
            local environment = trans:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
            if environment then
                environment.SceneCamera.fieldOfView = 30 * _G.CS.Launcher.Inst.FovScale
            end

            -- ---设置初始相机
            self.ControlCamera = _G.GraphicsManager.Instance.CurrentVisualCamera
            local pos = self.ControlCameraPosArr
            self.ControlCamera:SetPosition(pos[1], pos[2], pos[3])

            local qua = self.ControlCameraQuaArr
            self.ControlCamera:SetRotation(qua[1], qua[2], qua[3], qua[4])

            trans:SetLocalPosition(900, 900, 0)
            self.sceneTrans = trans
            if callback then
                callback(trans)
            end
        end
    )
end

--加载角色
function CharacterView:LoadRoleScene(rolepath, callback)
    self.YanChiDianJi = true
    self:RoleRecycle()
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.UIItem,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoself LoadRoleScene")
                end
                return
            end

            self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(trans)
            _G.GameUtil.SetActiveByCondition(trans, true)
            trans:SetParentE(self.sceneTrans)

            trans:SetLocalPosition(0, 0, 0)
            self.roleTrans = trans

            -- --设置  缩放
            local Scale = self.myCard_show_cfg.Size1 > 0 and self.myCard_show_cfg.Size1 or 1
            trans:SetLocalScale(Scale, Scale, Scale)
            self:InitRotPos()

            self.ZeDang = true
            if callback then
                callback(trans)
            end
            self.YanChiDianJi = false
        end
    )
end

---@param soundCfg string 台词路径
function CharacterView:AniPlay(name, effAll, isCall, audioCfg, soundPath)
    if self.AnimComponent ~= nil and self.IsAniPlaying == true or self.myCard_show_cfg == nil then
        return
    end

    local isHaveAni = self.AnimComponent:isHaveAni(name)
    if isHaveAni == false then
        name = self.myCard_show_cfg.display_idle
    end

    local nowPlayName = self.AnimComponent:getNowPlayName()
    if nowPlayName == name then
        return
    end
    --- 如果是第一次进入idle 则播场景特效
    if name == self.myCard_show_cfg.display_idle then
        self:LoadActionEff(self.myCard_show_cfg.display_alltime_ef)
    end

    self.oldAniName = name
    self.AnimComponent:Play(name, isCall)
    if _G.string.contains(name, "idle") == false then
        self.IsAniPlaying = true
    end

    --- 播音效
    self:ClearAudio()
    if _G.string.IsNullOrEmpty(audioCfg) == false then
        local path = audioCfg
        if path ~= nil then
            self.ActionAudioArr[path] = true
            _G.AudioManager.Dialogue_PlayPath(path)
        end
    end
    if _G.string.IsNullOrEmpty(soundPath) == false then
        local path = soundPath
        if path ~= nil then
            ---当前是否在播放
            self.IsPlayLines = true
            self.LinesPath = path
            _G.AudioManager.PlayPathBackFun(path, _G.handler(self, self.PlayLinesCallBack))
        end
    end

    self:LoadActionEff(effAll)
end
function CharacterView:PlayLinesCallBack()
    self.IsPlayLines = false
end

function CharacterView:ClearAudio()
    if self.ActionAudioArr ~= nil then
        for path, _ in pairs(self.ActionAudioArr) do
            _G.AudioManager.StopSoundByPath(path)
            self.ActionAudioArr[path] = nil
        end
    end
end

function CharacterView:LoadActionEff(idArr)
    if idArr == nil or #idArr == 0 then
        return
    end

    local effcfg = _G.ConfigManager.card_effect_cfg

    for i = 1, #idArr do
        local id = idArr[i]
        local myEff = effcfg[id]
        if myEff == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError(" card_effect_cfg 未找到id: " .. tostring(id))
            end
        else
            self:LoadFunc(myEff, self.sceneTrans)
        end
    end
end
---@param cfg card_effect_cfg
function CharacterView:LoadFunc(cfg, parent, loadedCall)
    if self.roleTrans == nil then
        return
    end

    local pos = cfg.pos or {0, 0, 0}
    local scale = cfg.scale > 0 and cfg.scale or 1
    --region --------------------------------------当前特效 要隐藏的其他特效--------
    if #cfg.ef_false > 0 then
        for i = #cfg.ef_false, 1, -1 do
            local tranPath = cfg.ef_false[i]
            local efobj = self.roleTrans:FindE(tranPath)
            if efobj ~= nil then
                _G.GameUtil.SetActiveByCondition(efobj, false)
            end
        end
    end
    --endregion

    --region --------------------------------------如果加载过 或者本身有这特效--------
    local efTran = self.EfDic[cfg.id]
    if efTran ~= nil then
        ---  特效要隐藏在显示  确保动画重播
        _G.GameUtil.SetActiveByCondition(efTran, false)
        _G.GameUtil.SetActiveByCondition(efTran, true)
    else
        if _G.string.IsNullOrEmpty(cfg.ef_point) == false then
            if cfg.ef_point == "1" then
                parent = self.roleTrans
            else
                parent = self.roleTrans:FindE(cfg.ef_point)
                if parent == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError(cfg.id .. " 挂点路径未找到: " .. cfg.ef_point)
                    end
                    return
                end
            end
        end
        local efName
        if _G.string.contains(cfg.Ef_Path, "/") then
            efName = _G.string.split2tbl(cfg.Ef_Path, "/")
            efName = efName[#efName]
            local efobj = parent:FindE(efName)
            if _G.IsNil(efobj) == false then
                efobj:SetLocalPosition(pos[1], pos[2], pos[3])
                efobj:SetLocalScaleXYZ(scale)
                _G.GameUtil.SetActiveByCondition(efobj, false)
                _G.GameUtil.SetActiveByCondition(efobj, true)
                self.EfDic[cfg.id] = efobj
                if loadedCall ~= nil then
                    loadedCall()
                end
                --endregion
                return
            end
        end
        --- 否则 加载
        _G.UIUtils.LoadEffectByPath(
            cfg.Ef_Path,
            parent,
            function(tran)
                if cfg.lifeTime == 0 then
                    table.insert(self.ActionEffArr, tran)
                else
                    table.insert(self.ActionEffTempArr, tran)
                end
                self.EfDic[cfg.id] = tran
                if loadedCall ~= nil then
                    loadedCall()
                end
            end,
            nil,
            0,
            pos,
            scale,
            1,
            true
        )
    end
end
---可关闭定时
function CharacterView:DingShiXianShi()
    self.PoolTime = _G.ConfigManager.discrete_cfg[100218][1][1]
    self.go_table.aortext_time.text = _G.string.format(_G.LangUtil.GetLangPackValue(90021300087), self.PoolTime)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.PoolTimer, self, false, false, true)
    self.timer:Start()

    self.go_table.aorbtn_drag:SetActiveE(1)
end
---倒计时
function CharacterView:PoolTimer(elapsed)
    self.PoolTime = self.PoolTime - elapsed
    if self.PoolTime <= 0 then
        self.PoolTime = self.PoolTime + elapsed
        self:RoleRecycles()
    end
    self.go_table.aortext_time.text =
        _G.string.format(_G.LangUtil.GetLangPackValue(90021300087), Mathf.RoundToInt(self.PoolTime))
end
---销毁场景
function CharacterView:RoleRecycles()
    if not _G.IsNil(self.sceneTrans) then
        self:InitRotPos()

        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
        self.sceneTrans = nil
    end
    if self.timer ~= nil then
        self.timer:Stop()
    end
    _G.CS.UnityEngine.Time.timeScale = 1

    self:Close()
end
function CharacterView:InitRotPos(isDel)
    if _G.IsNil(self.sceneTrans) then
        return
    end
    self.EfDic = {}
    self.IsAniPlaying = false

    self.roleTrans:SetLocalEulerAngles(0, 0, 0)
    if isDel == true then
        -- --设置  缩放
        self.roleTrans:SetLocalScale(1, 1, 1)
    else
        --播放一次 初始化 RoleAnimatorController.cs--> animationTime
        _G.GameUtil.SetActiveByCondition(self.roleTrans, true)
        if self.myCard_show_cfg ~= nil and not _G.string.IsNullOrEmpty(self.myCard_show_cfg.display_entr) then
            self:AniPlay(
                self.myCard_show_cfg.display_entr,
                self.myCard_show_cfg.display_entr_ef,
                true,
                self.myCard_show_cfg.audio_enter,
                self.myCard_show_cfg.sound_enter
            )
        else
            --- 否则默认播放 idle配置
            self:PlayAniCallBack()
        end

        _G.AnimatorPlayEndCallback.AddCallback(
            self.AnimComponent:GetInstanceIDE(),
            _G.handler(self, self.PlayAniCallBack)
        )

        self.Timer_InitCard = _G.TimerManager:GetInstance():GetTimer(1, self.Timer_InitCardFunc, self, true, true)
        self.Timer_InitCard:Start()
    end
end

function CharacterView:Timer_InitCardFunc()
    local pos = {}
    if self.myCard_show_cfg ~= nil then
        pos = self.myCard_show_cfg.pos
    end

    local x, y, z = pos[1] or 0, pos[2] or 0, pos[3] or 0
    if self.roleTrans ~= nil then
        self.roleTrans:SetLocalPosition(x, y, z)
    end
end

function CharacterView:PlayAniCallBack(_)
    if _G.IsNil(self.roleTrans) or _G.IsNil(self.AnimComponent) then
        return
    end

    if self:IsNil() then
        return
    end
    self.IsAniPlaying = false
    --播放一次 初始化 RoleAnimatorController.cs--> animationTime
    if self.myCard_show_cfg ~= nil and not _G.string.IsNullOrEmpty(self.myCard_show_cfg.display_idle) then
        self:AniPlay(self.myCard_show_cfg.display_idle, self.myCard_show_cfg.display_idle_ef, true, nil, nil)
    end
end
---销毁角色
function CharacterView:RoleRecycle()
    if not _G.IsNil(self.roleTrans) then
        self:InitRotPos(true)
        if self.Timer_InitCard ~= nil then
            self.Timer_InitCard:Stop()
            self.Timer_InitCard = nil
        end

        self.EfCardSid = 0
        self.EfDic = {}
        self.myCard_show_cfg = nil
        --如果之前对象有 则销毁之前的回调
        if self.AnimComponent ~= nil then
            _G.AnimatorPlayEndCallback.RemoveCallback(self.AnimComponent:GetInstanceIDE())
            self.AnimComponent = nil
        end
        if self.ActionEffArr ~= nil then
            for i = #self.ActionEffArr, 1, -1 do
                local efftran = table.remove(self.ActionEffArr, i)
                if _G.IsNil(efftran) == false then
                    _G.UIUtils.RemoveEffect(efftran, 1)
                end
            end
        end
        if self.ActionEffTempArr ~= nil then
            for i = #self.ActionEffTempArr, 1, -1 do
                local efftran = table.remove(self.ActionEffTempArr, i)
                if _G.IsNil(efftran) == false then
                    _G.UIUtils.RemoveEffect(efftran, 1)
                end
            end
        end
        self:ClearAudio()
        if self.LinesPath ~= nil then
            _G.AudioManager.Dialogue_StopPath(self.LinesPath)
        end
        self.IsPlayLines = false

        if self.roleTrans ~= nil then
            _G.PoolsManager:GetInstance():Despawn(self.roleTrans, _G.ePoolType.UIItem)
        end
        self.roleTrans = nil
    end
end

--endregion
---按钮点击事件在这里派发
function CharacterView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return CharacterView
