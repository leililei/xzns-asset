---@class BattleEmbattleSettingView : UIBaseView	中文描述
---@field public go_table BattleEmbattleSettingView_GoTable GoTable
---@field settingData BattleEmbattleSetting
local BattleEmbattleSettingView = _G.BaseClass("BattleEmbattleSettingView", _G.UIBaseView)
---@class BattleEmbattleSetting
local BattleEmbattleSetting = {
    Num = 1,
    AllSkill = 0,
    MySkill = 0,
    OtherSkill = 0,
    Continue = 0,
    Result = 0
}
local Key = "BattleEmbattleSetting"
function BattleEmbattleSettingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BattleEmbattleSettingView:OnCreate()
    self.settingData = self:GetTable(Key)
    if not self.settingData then
        self.settingData = BattleEmbattleSetting
    end
    self:Show()
end
---显示界面
function BattleEmbattleSettingView:Show()
    self.go_table.toggle_allSkill.isOn = self.settingData.AllSkill == 1
    self.go_table.toggle_mySkill.isOn = self.settingData.MySkill == 1
    self.go_table.toggle_otherSkill.isOn = self.settingData.OtherSkill == 1
    self.go_table.toggle_result.isOn = self.settingData.Result == 1
    self.go_table.toggle_continue.isOn = self.settingData.Continue == 1
    self:ChangeNum(0)
end

---按钮点击事件在这里派发
function BattleEmbattleSettingView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_add then
        self:ChangeNum(1)
    elseif go == self.go_table.aorbtn_add10 then
        self:ChangeNum(10)
    elseif go == self.go_table.aorbtn_sub10 then
        self:ChangeNum(-10)
    elseif go == self.go_table.aorbtn_sub then
        self:ChangeNum(-1)
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        self:CloseView()
    elseif go == self.go_table.toggle_allSkill then
        self:OnToggleAllSkill(isOn)
    elseif go == self.go_table.toggle_mySkill then
        self:ChangeMySkill(isOn)
    elseif go == self.go_table.toggle_otherSkill then
        self:ChangeOtherSkill(isOn)
    elseif go == self.go_table.toggle_continue then
        self:ChangeContine(isOn)
    elseif go == self.go_table.toggle_result then
        self:ChangeResult(isOn)
    elseif go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---更改挑战数字
function BattleEmbattleSettingView:ChangeNum(num)
    if num >= 0 then
        self.settingData.Num = math.min(self.settingData.Num + num, 100)
    else
        self.settingData.Num = math.max(self.settingData.Num + num, 1)
    end

    self.go_table.aortext_num.text = self.settingData.Num
end

---屏蔽双方绝技
function BattleEmbattleSettingView:OnToggleAllSkill(isOn)
    if isOn then
        self.go_table.toggle_mySkill.isOn = false
        self.go_table.toggle_otherSkill.isOn = false
    end
    self.settingData.AllSkill = isOn and 1 or 0
end
---更改其他技能
function BattleEmbattleSettingView:ChangeOtherSkill(isOn)
    self.settingData.OtherSkill = isOn and 1 or 0
    if isOn then
        self.go_table.toggle_allSkill.isOn = false
    end
end
---更改自身技能
function BattleEmbattleSettingView:ChangeMySkill(isOn)
    self.settingData.MySkill = isOn and 1 or 0
    if isOn then
        self.go_table.toggle_allSkill.isOn = false
    end
end
---设置连续战斗
function BattleEmbattleSettingView:ChangeContine(isOn)
    self.settingData.Continue = isOn and 1 or 0
end
---关闭界面
function BattleEmbattleSettingView:CloseView()
    self:Save()
    self:Close()
end
---设置结果显示
function BattleEmbattleSettingView:ChangeResult(isOn)
    self.settingData.Result = isOn and 1 or 0
end
---@return BattleEmbattleSetting
function BattleEmbattleSettingView:GetTable()
    return _G.PlayerPrefsManager.GetTable(Key, false)
end

---保存
function BattleEmbattleSettingView:Save()
    _G.PlayerPrefsManager.SetTable(Key, self.settingData, false)
end

return BattleEmbattleSettingView
