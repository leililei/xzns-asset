---加载场景
function BattleEmbattleView:LoadingScene()
    if self.Scene.gameObject ~= nil or not table.isEmptyOrNil(self.Scene) then
        _G.PoolsManager:GetInstance():Despawn(self.Scene, _G.ePoolType.Temporary)
        if self.timer ~= nil then
            self.timer:Stop()
        end
    end
    local res = {}
    res = _G.ConfigManager.scene_cfg[self.SelectMapSid] and _G.ConfigManager.scene_cfg[self.SelectMapSid].Res or nil
    if not res then
        res = _G.ConfigManager.monster_group_cfg[self.SelectMapSid].ScenePath
    end
    _G.PoolsManager:GetInstance():Spawn(
        res,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            local visual =
                trans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                    _G.typeof(CS.FrameWork.Graphic.VisualCamera)
                )
            if visual then
                visual.Interpolation = 0
            end

            local environment = trans:GetComponentInChildren(_G.typeof(_G.CS.FrameWork.Environment.EnvironmentSetting))
            if environment then
                environment.SceneCamera.fieldOfView = 20 * _G.CS.Launcher.Inst.FovScale
            end
            self.Scene = trans
            local cfg = _G.ConfigManager.monster_group_cfg[self.SelectMapSid]
            local CenterPoint = cfg.FightAreaPos
            trans:SetPosition(CenterPoint[1], CenterPoint[2], CenterPoint[3])
            self:CreatPos()
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.Set3DPos, self)
            self.timer:Start()
            self:OnClickPosBtn(nil, nil, self.SelectPos, self.TeamType)
            self:ClearEmbattleData()
        end
    )
end

---创建3D场景点位空对象
function BattleEmbattleView:CreatPos()
    local cfg = _G.ConfigManager.monster_group_cfg[self.SelectMapSid]
    local pos_cfg = _G.ConfigManager.pos_cfg[cfg.pos]
    local CenterPoint = cfg.FightAreaPos
    if self.Parent then
        for i = 1, 5 do
            self.S3DPos.Attacker[i]:SetPosition(
                CenterPoint[1] + pos_cfg.AttackerPos[i][1],
                CenterPoint[2] + pos_cfg.AttackerPos[i][2],
                CenterPoint[3] + pos_cfg.AttackerPos[i][3]
            )
            self.S3DPos.Defence[i]:SetPosition(
                CenterPoint[1] + pos_cfg.DefenserPos[i][1],
                CenterPoint[2] + pos_cfg.DefenserPos[i][2],
                CenterPoint[3] + pos_cfg.DefenserPos[i][3]
            )
        end
    else
        self.Parent = _G.GameObject("EmbattlePosRoot")
        self.Parent:SetPosition(0, 0, 0)
        for i = 1, 5 do
            local go1 = _G.GameObject(string.format("SelfPos%d", i))
            local go2 = _G.GameObject(string.format("EnemySelfPos%d", i))
            go1:SetParentE(self.Parent)
            go2:SetParentE(self.Parent)
            go1:SetPosition(
                CenterPoint[1] + pos_cfg.AttackerPos[i][1],
                CenterPoint[2] + pos_cfg.AttackerPos[i][2],
                CenterPoint[3] + pos_cfg.AttackerPos[i][3]
            )
            go2:SetPosition(
                CenterPoint[1] + pos_cfg.DefenserPos[i][1],
                CenterPoint[2] + pos_cfg.DefenserPos[i][2],
                CenterPoint[3] + pos_cfg.DefenserPos[i][3]
            )
            self.S3DPos.Attacker[i] = go1
            self.S3DPos.Defence[i] = go2
            _G.PoolsManager:GetInstance():Spawn(
                RolePos,
                _G.ePoolType.Temporary,
                go1,
                function(tran)
                    self.S3DBaseRoleImage.Attacker[i] = tran:FindE("BaseImage"):GetComponentE(typeof(CS.AorImage))
                    tran:SetLocalPosition(0, 0.1, 0)
                end
            )
            _G.PoolsManager:GetInstance():Spawn(
                RolePos,
                _G.ePoolType.Temporary,
                go2,
                function(tran)
                    self.S3DBaseRoleImage.Defence[i] = tran:FindE("BaseImage"):GetComponentE(typeof(CS.AorImage))
                    tran:SetLocalPosition(0, 0.1, 0)
                    if i == 5 then
                        self:UpdateRoleBase()
                    end
                end
            )
        end
    end
    self:LoadEffect()
end

