function BattleEmbattleView:StartRecordLocalBattle()
    local record = _G.CS.BattleManager.Utils.ReadRecordTable()
    local Sid = record.Sid
    local AttackerTable = record.AttackerTable
    local DefenderTable = record.DefenderTable
    local AttackerCombineSkillTable = record.AttackerCombineSkillTable

    local cfg = _G.ConfigManager.monster_cfg
    for i = 1, 5 do
        if cfg[AttackerTable[i]] then
            self.TeamSid.Attack[self.CurPage][i] = cfg[AttackerTable[i]].CardID
        else
            self.TeamSid.Attack[self.CurPage][i] = 0
        end
    end
    --暂时只用到6,这里的6不是战斗人数上限,是站位index,如果有其他站位再调整
    for i = 1, 6 do
        if cfg[DefenderTable[i]] then
            self.TeamSid.Defence[self.CurPage][i] = cfg[DefenderTable[i]].CardID
        else
            self.TeamSid.Defence[self.CurPage][i] = 0
        end
    end

    self:LoadRoles()
    self:UpdateCardList()

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.EmbattleBtnClickEffect,
        self.go_table.aorbtn_FightStart,
        function()
        end,
        function()
            if self.SelectMapSid == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("cfg does not have this MapSid ")
                end
                return
            end
            local TeamSid = _G.DeepCopy(self.TeamSid)

            if not self.Model:CheckEmbattle(TeamSid) then
                return
            end
            self:ExportBattleTeamToLocal()
            if self.FightCall then
                -- _G.BaseBattleManager:GetInstance():ClearView(true)
                self.onBattleBtnClick = true
                self.FightCall(
                    TeamSid.Attack[self.CurPage],
                    TeamSid.Defence,
                    Sid,
                    _G.EBattleType.TestRecord,
                    AttackerCombineSkillTable
                )
                if self.Model.OtherExit then
                    self.Model:OtherExit()
                    self.go_table.aorbtn_Show:SetActiveE(0)
                else
                    self.Model:Exit()
                end
                return
            end
        end
    )
end

