---刷新角色下面的显示
function BattleEmbattleView:UpdateRoleBase()
    if table.isEmptyOrNil(self.S3DBaseRoleImage.Attacker) or table.isEmptyOrNil(self.S3DBaseRoleImage.Defence) then
        return
    end
    if self.TeamType == _G.TeamType.Ally then
        self.go_table.obj_Left:SetActiveE(0)
        self.go_table.obj_Right:SetActiveE(1)
    else
        self.go_table.obj_Left:SetActiveE(1)
        self.go_table.obj_Right:SetActiveE(0)
    end

    for i = 1, 5 do
        if self.TeamType == _G.TeamType.Ally then
            self.S3DBaseRoleImage.Attacker[i]:SetActiveE(1)
            self.S3DBaseRoleImage.Defence[i]:SetActiveE(self.Model:IsShowRoleBase() and 1 or 0)
            if i == self.SelectPos then
                self.S3DBaseRoleImage.Attacker[i].SpriteName = BaseImage.Yes
            else
                self.S3DBaseRoleImage.Attacker[i].SpriteName = BaseImage.No
            end
        else
            self.S3DBaseRoleImage.Defence[i]:SetActiveE(self.Model:IsShowRoleBase() and 1 or 0)
            self.S3DBaseRoleImage.Defence[i]:SetActiveE(1)
            if i == self.SelectPos then
                self.S3DBaseRoleImage.Defence[i].SpriteName = BaseImage.Yes
            else
                self.S3DBaseRoleImage.Defence[i].SpriteName = BaseImage.No
            end
        end
    end
end

---更新卡牌选择
function BattleEmbattleView:UpdateCardList()
    self.go_table.aortext_CurPage.text = self.CurPage
    self.Model:UpdateSelectPos()

    if self.TeamType == TeamType.Ally then
        self.Model:UpdateRoleIndex()
    else
        self.Model:UpdateEnemyRoleIndex()
    end

    self.Model:UpdateFiltBySelect()
    self:UpdateFiltrate()
    self:Update3DName()
    self:UpdateRoleBase()
    self.CardUidList = {}
    local ok = true
    local list
    if self.TeamType == _G.TeamType.Ally then
        list = self.CardList
    else
        list = self.EnemyCardList
    end
    for i, v in pairs(list) do
        ok = true
        if self.SkinSelected ~= _G.SkinSelected.Both then
            local isSkin = v.skin and v.skin > 0 --当前英雄是否穿戴了皮肤
            if self.SkinSelected == _G.SkinSelected.No and isSkin or
                self.SkinSelected == _G.SkinSelected.Only and not isSkin then
                ok = false
            end
        end
        if self.ElementType ~= _G.CardElementType.None then
            if not require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, self.ElementType) then
                ok = false
            end
        end
        if self.ProfType ~= _G.CardProfType.None then
            if v.cfg.Professional ~= self.ProfType then
                ok = false
            end
        end
        if ok then
            table.insert(self.CardUidList, i)
        end
    end
    self.Model:CardListSort(self.CardUidList, list)
    if self.IsFirst.CardList then
        self.IsFirst.CardList = false
        self.go_table.scrollloopvectical_CardList:InitItemData(#self.CardUidList,
            _G.handlerbind(self, self.RefreshCardList))
    else
        self.go_table.scrollloopvectical_CardList:UpdateCount(#self.CardUidList, 0, 0, 0)
    end
end

