---清除
function BattleEmbattleView:Destroy()
    if self.Models then
        for _, team in pairs(self.Models) do
            for _, v in pairs(team) do
                if not _G.IsNil(v) and not _G.IsNil(v) then
                    v.transform:SetRotation(0, 0, 0)
                    _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.Temporary)
                end
            end
        end
    end

    self.Models = nil
    if self.Effect then
        if self.Effect.Attacker then
            for _, v in pairs(self.Effect.Attacker) do
                if not _G.IsNil(v) and not _G.IsNil(v) then
                    -- _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.Temporary)
                    _G.DestroyObject(v)
                end
            end
            self.Effect.Attacker = nil
        end

        if self.Effect.Defence then
            for _, v in pairs(self.Effect.Defence) do
                if not _G.IsNil(v) and not _G.IsNil(v) then
                    -- _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.Temporary)
                    _G.DestroyObject(v)
                end
            end
            self.Effect.Defence = nil
        end

        if self.Effect.UI then
            for _, v in pairs(self.Effect.UI) do
                -- _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.UIItem)
                if not _G.IsNil(v) and not _G.IsNil(v) then
                    _G.DestroyObject(v)
                end
            end
        end
    end

    self.Effect = nil

    if not _G.IsNil(self.Scene) and not _G.IsNil(self.Scene) then
        _G.PoolsManager:GetInstance():Despawn(self.Scene, _G.ePoolType.Temporary)
        self.Scene = nil
    end

    if self.S3DBaseRoleImage then
        for _, team in pairs(self.S3DBaseRoleImage) do
            for _, v in pairs(team) do
                if not _G.IsNil(v) and not _G.IsNil(v) then
                    _G.DestroyObject(v)
                end
            end
        end
    end
    self.S3DBaseRoleImage = nil
    if self.Parent ~= nil and not _G.IsNil(self.Parent) then
        _G.DestroyObject(self.Parent)
    end
    _G.Events:GetInstance():RemoveListener("BattleEmbattleStatisticsPVEViewHide", self.ShowHide, self)
end

