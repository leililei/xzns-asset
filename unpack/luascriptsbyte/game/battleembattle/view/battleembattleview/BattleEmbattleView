function BattleEmbattleView:OpenChooseView()
    self.go_table.obj_ChooseMapView:SetActiveE(1)
    local isRefresh = true
    self.MapSid = {}
    for _, v in pairs(self.Maps) do
        table.insert(self.MapSid, v)
    end
    if self.IsFirst.Map then
        self.ChooseView.looplist2_MapList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst.Map = false
    end
    self.ChooseView.looplist2_MapList:SetListItemCount(_G.math.ceil(#self.MapSid / 3), true)
    if isRefresh then
        self.ChooseView.looplist2_MapList:RefreshAllShownItem()
    end
end

---刷新列表
function BattleEmbattleView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local list = _G.ConfigManager.monster_group_cfg
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index * 3 + 1
    item:SetName(x)
    local tb_i = {}
    local data = {}
    for i = 1, 3 do
        tb_i =
            _G.GetAutoGoTable(
                item:FindE(string.format("$_obj_Item%d", i)),
                _G.handlerbind(self, self.OnClickItem, x + i - 1)
            )
        data = list[self.MapSid[x + i - 1]]
        if data == nil then
            tb_i.gameObject:SetActiveE(0)
        else
            tb_i.gameObject:SetActiveE(1)
            tb_i.aorrawimage_Icon:LoadImage(data.note)
            --tb_i.aortext_Name.text = data.describe
            tb_i.aortext_Name.text = data.id
            if self.SelectMapSid == data.id then
                tb_i.aorimage_Select:SetActiveE(1)
            else
                tb_i.aorimage_Select:SetActiveE(0)
            end
        end
    end
    return item
end

