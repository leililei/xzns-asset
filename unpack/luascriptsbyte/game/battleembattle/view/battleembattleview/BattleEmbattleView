end

---将当前本地阵容导入(只用于测试战斗)
function BattleEmbattleView:InputLocalTeam()
    local data = _G.PlayerPrefsManager.GetTable("SaveBattleTeam", true)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    local card_cfg = _G.ConfigManager.card_cfg
    local skin_cfg = _G.ConfigManager.skin_cfg

    if not _G.table.isEmptyOrNil(data.attacker) then
        for i = 1, #data.attacker do
            local sid = data.attacker[i]
            if skin_cfg[sid] or card_cfg[sid] then
                self.TeamSid.Attack[self.CurPage][i] = sid
            else
                self.TeamSid.Attack[self.CurPage][i] = 0
            end
        end
    end
    if not _G.table.isEmptyOrNil(data.defender) then
        for i = 1, #data.defender do
            local sid = data.defender[i]
            if skin_cfg[sid] or card_cfg[sid] then
                self.TeamSid.Defence[self.CurPage][i] = sid
            else
                self.TeamSid.Defence[self.CurPage][i] = 0
            end
        end
    end

    local pet_cfg = _G.ConfigManager.pet_cfg
    if not _G.table.isEmptyOrNil(data.attackPets) then
        for i = 1, #data.attackPets do
            local sid = data.attackPets[i]
            if pet_cfg[sid] then
                self.curEmbattlePetSkillData[i] = sid
            else
                self.curEmbattlePetSkillData[i] = 0
            end
        end
    end
    if not _G.table.isEmptyOrNil(data.defendPets) then
        for i = 1, #data.defendPets do
            local sid = data.defendPets[i]
            if pet_cfg[sid] then
                self.enemyEmbattlePetSkillData[i] = sid
            end
        end
    end

    self:LoadRoles()
    self:UpdateCardList()
end

