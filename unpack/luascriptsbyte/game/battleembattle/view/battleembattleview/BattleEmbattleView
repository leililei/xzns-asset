function BattleEmbattleView:InputConfig()
    local p = {}
    p.Title = "导入关卡配置"
    p.Content = "输入怪物组id"
    p.InputLimitLength = 10
    p.NeedNum = 0
    p.CancelCall = function()
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.InputDialogView.Name)
    end
    p.ConfirmCall = function(id)
        local cfg = _G.ConfigManager.monster_group_cfg[tonumber(id)]
        if cfg then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.InputDialogView.Name)
            self:InputConfigCall(tonumber(id))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(320109, "输入关卡id有误")
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InputDialogView.Name, p)
end

function BattleEmbattleView:InputConfigCall(id)
    self.MonsterGrounpCfg = _G.ConfigManager.monster_group_cfg[id]
    if self.MonsterGrounpCfg.battle_type == 1 then
        for i = 1, #self.MonsterGrounpCfg.DefaultAttackerSids do
            if i <= 5 then
                local id = self.MonsterGrounpCfg.DefaultAttackerSids[i]
                if id == 0 then
                    self.TeamSid.Attack[1][i] = 0
                else
                    local monsteCfg = _G.ConfigManager.monster_cfg[id]
                    if monsteCfg then
                        self.TeamSid.Attack[1][i] = monsteCfg.CardID
                    end
                end
            end
        end
        self.SelfCardList = self.Model:GetEnemyCardListNoStroage()
    end
    for i = 1, #self.MonsterGrounpCfg.DefaultDefenserSids[1] do
        if i <= 5 then
            local id = self.MonsterGrounpCfg.DefaultDefenserSids[1][i]
            if id == 0 then
                self.TeamSid.Defence[1][i] = 0
            else
                local monsteCfg = _G.ConfigManager.monster_cfg[id]
                self.TeamSid.Defence[1][i] = monsteCfg.CardID
            end
        end
    end
    self.EnemyCardList = self.Model:GetEnemyCardListNoStroage()

    self:LoadingScene()
    --self:LoadRoles()
    self.go_table.aorbtn_Right:SetActiveE(0)
    self.go_table.aorbtn_Left:SetActiveE(0)
    self:ChangeTeam(_G.TeamType.Ally)
end

function BattleEmbattleView:CheckUids(ids)
    for _, v in pairs(ids) do
        if v > 0 and _G.string.len(tostring(v)) > 11 then
            return true
        end
    end
    return false
end

return BattleEmbattleView
