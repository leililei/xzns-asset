---注册拖拽事件
function BattleEmbattleView:AddDragEvent(go, type, index)
    _G.SetEventTrigger(go, "onDragBegin", _G.handlerbind(self, self.onDragBegin_Drag, type, index))
    _G.SetEventTrigger(go, "onDrag", _G.handlerbind(self, self.onDrag_Drag, type, index))
    _G.SetEventTrigger(go, "onDragEnd", _G.handlerbind(self, self.onDragEnd_Drag, type, index))
end

---拖拽开始
function BattleEmbattleView:onDragBegin_Drag(go, eventData, type, index)
    local pos = CS.BattleFighterTopView.UI2WorldInBattleScene(_G.Vector3(eventData.position.x, eventData.position.y, 0))
    if type == _G.TeamType.Ally then
        if self.Models.Attacker[index] ~= nil then
            self.Models.Attacker[index]:SetPosition(pos.x, pos.y, pos.z)
        end
    else
        if self.Models.Defence[index] ~= nil then
            self.Models.Defence[index]:SetPosition(pos.x, pos.y, pos.z)
        end
    end
    self:OnClickPosBtn(nil, nil, index, type)
end

---拖拽中
function BattleEmbattleView:onDrag_Drag(go, eventData, type, index)
    local pos = CS.BattleFighterTopView.UI2WorldInBattleScene(_G.Vector3(eventData.position.x, eventData.position.y, 0))
    if type == _G.TeamType.Ally then
        if self.Models.Attacker[index] ~= nil then
            self.Models.Attacker[index]:SetPosition(pos.x, pos.y, pos.z)
        end
    else
        if self.Models.Defence[index] ~= nil then
            self.Models.Defence[index]:SetPosition(pos.x, pos.y, pos.z)
        end
    end
end

---拖拽结束
function BattleEmbattleView:onDragEnd_Drag(go, eventData, type, index)
    if _G.IsNil(eventData.pointerCurrentRaycast) then
        if type == _G.TeamType.Ally and self.Models.Attacker[index] ~= nil then
            self.Models.Attacker[index]:SetLocalPosition(0, 0, 0)
        elseif self.Models.Defence[index] ~= nil then
            self.Models.Defence[index]:SetLocalPosition(0, 0, 0)
        end
        return
    end
    local CardData
    if type == _G.TeamType.Ally then
        CardData = self.SelfCardList[self.TeamSid.Attack[self.CurPage][self.SelectPos]]
    else
        CardData = self.SelfCardList[self.TeamSid.Defence[self.CurPage][self.SelectPos]]
    end
    if CardData == nil then
        return
    end
    local tmpIndex, tmpIndex2
    local IsChange = false
    for i = 1, 5 do
        if self.SelfPos[i].gameObject:GetName() == eventData.pointerCurrentRaycast.gameObject:GetName() then
            if type == _G.TeamType.Ally then
                tmpIndex = index % 2 == 1 and index or index - 1
                tmpIndex2 = i % 2 == 1 and i or i - 1
                if tmpIndex ~= tmpIndex2 then
                    local tmp = self.TeamSid.Attack[self.CurPage][tmpIndex]
                    self.TeamSid.Attack[self.CurPage][tmpIndex] = self.TeamSid.Attack[self.CurPage][tmpIndex2]
                    self.TeamSid.Attack[self.CurPage][tmpIndex2] = tmp
                    tmp = self.TeamSid.Attack[self.CurPage][tmpIndex + 1]
                    self.TeamSid.Attack[self.CurPage][tmpIndex + 1] = self.TeamSid.Attack[self.CurPage][tmpIndex2 + 1]
                    self.TeamSid.Attack[self.CurPage][tmpIndex2 + 1] = tmp
                    IsChange = true
                    for i = 1, 5 do
                        if CardData.uid == self.TeamSid.Attack[self.CurPage][i] then
                            self.SelectPos = i
                        end
                    end
                end
            end
        end
        if self.EnemyPos[i].gameObject:GetName() == eventData.pointerCurrentRaycast.gameObject:GetName() then
            if type == _G.TeamType.Enemy then
                tmpIndex = index % 2 == 1 and index or index - 1
                tmpIndex2 = i % 2 == 1 and i or i - 1
                if tmpIndex ~= tmpIndex2 then
                    local tmp = self.TeamSid.Defence[self.CurPage][tmpIndex]
                    self.TeamSid.Defence[self.CurPage][tmpIndex] = self.TeamSid.Defence[self.CurPage][tmpIndex2]
                    self.TeamSid.Defence[self.CurPage][tmpIndex2] = tmp
                    tmp = self.TeamSid.Defence[self.CurPage][tmpIndex + 1]
                    self.TeamSid.Defence[self.CurPage][tmpIndex + 1] = self.TeamSid.Defence[self.CurPage][tmpIndex2 + 1]
                    self.TeamSid.Defence[self.CurPage][tmpIndex2 + 1] = tmp
                    for i = 1, 5 do
                        if CardData.uid == self.TeamSid.Defence[self.CurPage][i] then
                            self.SelectPos = i
                        end
                    end
                end
            end
        end
    end
    if not IsChange then
        if type == _G.TeamType.Ally and self.Models.Attacker[index] ~= nil then
            self.Models.Attacker[index]:SetLocalPosition(0, 0, 0)
        elseif self.Models.Defence[index] ~= nil then
            self.Models.Defence[index]:SetLocalPosition(0, 0, 0)
        end
    else
        if self.Models.Attacker[tmpIndex] then
            self.Models.Attacker[tmpIndex]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Attacker[tmpIndex + 1] then
            self.Models.Attacker[tmpIndex + 1]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Attacker[tmpIndex2] then
            self.Models.Attacker[tmpIndex2]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Attacker[tmpIndex2 + 1] then
            self.Models.Attacker[tmpIndex2 + 1]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Defence[tmpIndex] then
            self.Models.Defence[tmpIndex]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Defence[tmpIndex + 1] then
            self.Models.Defence[tmpIndex + 1]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Defence[tmpIndex2] then
            self.Models.Defence[tmpIndex2]:SetLocalPosition(0, 0, 0)
        end
        if self.Models.Defence[tmpIndex2 + 1] then
            self.Models.Defence[tmpIndex2 + 1]:SetLocalPosition(0, 0, 0)
        end

        IsChange = true
    end
    self:UpdateCardList()
    self:LoadRoles()
end

---刷新选择场次按钮
function BattleEmbattleView:UpdateAfkBtn(index)
    local cfg = require("AfkModel"):GetInstance():GetCurSectionCfg()
    local item
    local tb
    for i = 1, 5 do
        item = self.go_table.obj_PageLisr:FindE(string.format("$_obj_Item%d", i))
        if i > #cfg.monster_group or #cfg.monster_group == 1 then
            item:SetActiveE(0)
        else
            item:SetActiveE(1)
            if require("AfkModel"):GetInstance():CheckMonsterIsPass(cfg.monster_group[i]) then
                tb = _G.GetAutoGoTable(item)
                tb.aortext_Num:SetActiveE(0)
                tb.aorimage_Pass:SetActiveE(1)
                tb.aorimage_Select:SetActiveE(0)
            else
                tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnAfkBtnClick, tb, i))
                tb.aortext_Num:SetActiveE(1)
                tb.aorimage_Pass:SetActiveE(0)
                if i == index then
                    tb.aorimage_Select:SetActiveE(1)
                else
                    tb.aorimage_Select:SetActiveE(0)
                end
            end
        end
    end
end

---点击选择场次按钮
function BattleEmbattleView:OnAfkBtnClick(go, IsOn, tb, index)
    if self.CurPage ~= index then
        self:ClearLastFiltrate()
        self.SelectPos = 1
    end
    self.CurPage = index
    self.Model:SetPage(self.CurPage)
    self.SelectMapSid = self.Maps[self.CurPage]
    self:UpdateAfkBtn(index)
    self:UpdateCardList()
    self:LoadingScene()
    self:LoadRoles()
end

---对应3D坐标设置坐标位置
function BattleEmbattleView:Set3DPos()
    local cfg = _G.ConfigManager.monster_group_cfg[self.SelectMapSid]
    local pos_cfg = _G.ConfigManager.pos_cfg[cfg.pos]
    local CenterPoint = cfg.FightAreaPos
    local pos
    for i = 1, 5 do
        pos =
            _G.UIUtils.Get3DTo2DPos(
                self.ObjSelfPos,
                _G.Vector3(
                    CenterPoint[1] + pos_cfg.AttackerPos[i][1],
                    CenterPoint[2] + pos_cfg.AttackerPos[i][2],
                    CenterPoint[3] + pos_cfg.AttackerPos[i][3]
                )
            )
        self.SelfPos[i].rectTrans:SetAnchorPosition(pos.x, pos.y)
        pos =
            _G.UIUtils.Get3DTo2DPos(
                self.ObjEnemyPos,
                _G.Vector3(
                    CenterPoint[1] + pos_cfg.DefenserPos[i][1],
                    CenterPoint[2] + pos_cfg.DefenserPos[i][2],
                    CenterPoint[3] + pos_cfg.DefenserPos[i][3]
                )
            )
        self.EnemyPos[i].rectTrans:SetAnchorPosition(pos.x, pos.y)
    end
end

---创建/刷新所有角色
function BattleEmbattleView:LoadRoles()
    ---@type UnityEngine.Camera
    local mainCamera
    if _G.CS.FrameWork.Graphic.GraphicsManager.Instance then
        mainCamera = _G.CS.FrameWork.Graphic.GraphicsManager.Instance.MainCamera
    end
    local angle = _G.CS.CameraUtils.GetCameraAngleX(mainCamera)
    local direction = {
        right = 1,
        left = -1
    }
    local filpAngle = {
        right = 0,
        left = 180
    }
    local forwardOffset = 0.3 --人物会被位置UI遮挡, 延相机轴向提升坐标位置

    ---坐标归一化处理
    ---@param x number
    ---@param y number
    ---@param z number
    ---@return number,number,number
    local function normalized(x, y, z)
        local magnitude = math.sqrt(x * x + y * y + z * z)
        if magnitude == 0 then
            return x, y, z
        end
        return x / magnitude, y / magnitude, z / magnitude
    end

    local cardManager = require("CardCommentManager"):GetInstance()

    ---@type card_cfg
    local cfg
    local cardData
    for i, v in pairs(self.TeamSid.Attack[self.CurPage]) do
        if v > 0 then
            cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v)
            if cardData then
                cfg = cardData.cfg
            else
                --cfg = _G.ConfigManager.card_cfg[v]
                cfg = cardManager:CardData(v, true)
            end
            if self.Models.Attacker[i] ~= nil and self.Models.Attacker[i]:GetName() ~= tostring(v) then
                self.Models.Attacker[i]:SetName("DespawnModel")
                _G.PoolsManager:GetInstance():Despawn(self.Models.Attacker[i], _G.ePoolType.Temporary)
                self.Models.Attacker[i] = nil
            end
            if self.Models.Attacker[i] == nil or self.Models.Attacker[i]:GetName() ~= tostring(v) then
                local resPath = require "CardInfoManager".GetBattleModelPath(cfg.id, true)
                _G.PoolsManager:GetInstance():Spawn(
                    resPath, --cfg.ModelPathLow,
                    _G.ePoolType.Temporary,
                    self.S3DPos.Attacker[i],
                    function(tran)
                        tran:SetName(v)
                        self.Models.Attacker[i] = tran
                        tran:SetLocalScaleXYZ(cfg.GlobalScale * 0.0001)
                        tran:SetLocalEulerAngles(0, direction.right * filpAngle.right, direction.right * angle)
                        local fx, fy, fz = normalized(tran:GetRight())
                        tran:SetLocalPosition(
                            fx * forwardOffset * direction.right,
                            fy * forwardOffset * direction.right,
                            fz * forwardOffset * direction.right
                        )
                        if self.Effect.Attacker[i] ~= nil then
                            self.Effect.Attacker[i]:SetActiveE(0)
                            self.Effect.Attacker[i]:SetActiveE(1)
                        end
                    end
                )
            end
        else
            if self.Models.Attacker[i] ~= nil and self.Models.Attacker[i]:GetName() ~= tostring(v) then
                self.Models.Attacker[i]:SetName("DespawnModel")
                _G.PoolsManager:GetInstance():Despawn(self.Models.Attacker[i], _G.ePoolType.Temporary)
                self.Models.Attacker[i] = nil
            end
        end
    end
    for i, v in pairs(self.TeamSid.Defence[self.CurPage]) do
        if v > 0 then
            cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v)
            if cardData then
                cfg = cardData.cfg
            else
                --cfg = _G.ConfigManager.card_cfg[v]
                cfg = cardManager:CardData(v, true)
            end
            if self.Models.Defence[i] ~= nil and self.Models.Defence[i]:GetName() ~= tostring(v) then
                self.Models.Defence[i]:SetName("DespawnModel")
                _G.PoolsManager:GetInstance():Despawn(self.Models.Defence[i], _G.ePoolType.Temporary)
                self.Models.Defence[i] = nil
            end
            if self.Models.Defence[i] == nil or self.Models.Defence[i]:GetName() ~= tostring(v) then
                local resPath = require "CardInfoManager".GetBattleModelPath(cfg.id, true)
                _G.PoolsManager:GetInstance():Spawn(
                    resPath, --cfg.ModelPathLow,
                    _G.ePoolType.Temporary,
                    self.S3DPos.Defence[i],
                    function(tran)
                        tran:SetName(v)
                        self.Models.Defence[i] = tran
                        tran:SetLocalScaleXYZ(cfg.GlobalScale * 0.0001)
                        tran:SetLocalEulerAngles(0, direction.left * filpAngle.left, direction.left * angle)
                        local fx, fy, fz = normalized(tran:GetRight())
                        tran:SetLocalPosition(
                            fx * forwardOffset * direction.left,
                            fy * forwardOffset * direction.left,
                            fz * forwardOffset * direction.left
                        )
                        if self.Effect.Defence[i] ~= nil then
                            self.Effect.Defence[i]:SetActiveE(0)
                            self.Effect.Defence[i]:SetActiveE(1)
                        end
                    end
                )
            end
        else
            if self.Models.Defence[i] ~= nil and self.Models.Defence[i]:GetName() ~= tostring(v) then
                self.Models.Defence[i]:SetName("DespawnModel")
                _G.PoolsManager:GetInstance():Despawn(self.Models.Defence[i], _G.ePoolType.Temporary)
                self.Models.Defence[i] = nil
            end
        end
    end
end

