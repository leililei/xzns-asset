---将当前整容导出或者导入外部阵容(只用于测试战斗)
function BattleEmbattleView:InputOrExport()
    local list = {}
    local sum = 0
    for i = 1, 5 do
        list[i] = self.TeamSid.Attack[self.CurPage][i]
        list[i + 5] = self.TeamSid.Defence[self.CurPage][i]
        sum = sum + self.TeamSid.Attack[self.CurPage][i] + self.TeamSid.Defence[self.CurPage][i]
    end
    if sum > 0 then
        local str = ""
        for i = 1, #list do
            if i == #list then
                str = str .. list[i]
            else
                str = str .. list[i] .. "#"
            end
        end
        _G.CS.UnityEngine.GUIUtility.systemCopyBuffer = str
    else
        local str = _G.CS.UnityEngine.GUIUtility.systemCopyBuffer
        str = string.split(str, "#")
        local cfg = _G.ConfigManager.monster_cfg
        if #str == 5 or #str == 10 then
            for i = 1, #str do
                if i > 5 then
                    if tonumber(str[i]) then
                        self.TeamSid.Defence[self.CurPage][i - 5] = tonumber(str[i])
                    end
                else
                    if tonumber(str[i]) then
                        self.TeamSid.Attack[self.CurPage][i] = tonumber(str[i])
                    end
                end
            end
            self:LoadRoles()
            self:UpdateCardList()
        end
    end
end

---将当前阵容导出到本地(只用于测试战斗)
function BattleEmbattleView:ExportBattleTeamToLocal()
    local data = {
        attacker = {},
        defender = {},
        attackPets = {},
        defendPets = {},
    }
    for i = 1, 5 do
        data.attacker[i] = self.TeamSid.Attack[self.CurPage][i] or 0
        data.defender[i] = self.TeamSid.Defence[self.CurPage][i] or 0
    end
    for i = 1, 3 do
        data.attackPets[i] = self.curEmbattlePetSkillData[i] or 0
        data.defendPets[i] = self.enemyEmbattlePetSkillData[i] or 0
    end
