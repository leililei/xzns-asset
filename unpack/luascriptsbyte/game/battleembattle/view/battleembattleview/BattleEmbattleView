    end
    local list
    if self.TeamType == _G._G.TeamType.Ally then
        list = self.CardList
    else
        list = self.EnemyCardList
    end
    local x = index + 1
    go:SetName(x)
    local tb_i = {}
    ---@type CardData
    local data = {}
    data = list[self.CardUidList[x]]
    tb_i = _G.GetAutoGoTable(go, _G.handlerbind(self, self.OnClickCardItem, data))
    if data == nil then
