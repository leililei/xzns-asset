---@class BattleEmbattleResultView : UIBaseView	中文描述
---@field public go_table BattleEmbattleResultView_GoTable GoTable
local BattleEmbattleResultView = _G.BaseClass("BattleEmbattleResultView", _G.UIBaseView)
--_G.BattleEmbattleResultView = BattleEmbattleResultView
local GetLangPackValue = _G.GetLangPackValue
local CS = _G.CS
local typeof = _G.typeof

function BattleEmbattleResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BattleEmbattleResultView:OnCreate(data)
    self.resultData = data
    self.go_table.looplist2_ResultList:InitListView(#data, _G.handler(self, self.RefreshItem))
    self:InitWinNum()
end

---显示结果次数
function BattleEmbattleResultView:InitWinNum()
    local win = 0
    local fail = 0
    for _, v in pairs(self.resultData) do
        if v.isWin then
            win = win + 1
        else
            fail = fail + 1
        end
    end
    self.go_table.aortext_win.text = GetLangPackValue(90022500348, win)
    self.go_table.aortext_lose.text = GetLangPackValue(90022500349, fail)
end

---刷新界面显示
---@param listview2 SuperScrollView.LoopListView2
function BattleEmbattleResultView:RefreshItem(listview2, index)
    local data = self.resultData[index + 1]
    local item = listview2:NewListViewItem("$_obj_ListItem")
    local tb = _G.GetAutoGoTable(item)
    tb.aortext_num.text = GetLangPackValue(90022500403, _G.GameUtil.NumberToChinese(index + 1))
    if data.isWin then
        tb.aortext_result.text = GetLangPackValue(90022500350)
    else
        tb.aortext_result.text = GetLangPackValue(90022500351)
    end
    return item
end

---按钮点击事件在这里派发
function BattleEmbattleResultView:OnClickBtn()
    self:Close()
end

return BattleEmbattleResultView
