require "BaseEmbattle"

---@class SystemEquipEmbattle	中文描述
local SystemEquipEmbattle = _G.BaseClass("SystemEquipEmbattle", _G.BaseEmbattle)
_G.SystemEquipEmbattle = SystemEquipEmbattle

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function SystemEquipEmbattle:__init(view)
end

---初始化
function SystemEquipEmbattle:Init()
    self.type = _G.EBattleType.Abyss
    self.Maps = _G.SystemEquipBattleManager:GetInstance():GetMap()
    self.CurPage = _G.SystemEquipBattleManager:GetInstance():GetPage()
    self.SelectMapSid = self.Maps[self.CurPage]
    self.EnemyCardList = _G.SystemEquipBattleManager:GetInstance():GetEnemyCardList()
    self.SelfCardList = _G.SystemEquipBattleManager:GetInstance():GetCardList()
    self.UnitType = _G.HeroType.Hero
    self:GetEmbattleData()
    self:SetView(self.view.go_table)
end

---获取布阵信息
function SystemEquipEmbattle:GetEmbattleData()
    local EmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.SystemEquipment)
    if table.isEmptyOrNil(EmbattleData) then
        EmbattleData = {0, 0, 0, 0, 0, 0}
    end
    self.TeamSid = {}
    self.TeamSid = {Attack = {EmbattleData}, Defence = {{0, 0, 0, 0, 0, 0}}}
    for i, v in pairs(_G.ConfigManager.monster_group_cfg[self.SelectMapSid].DefaultDefenserSids[1]) do
        self.TeamSid.Defence[1][i] = _G.ConfigManager.monster_cfg[v] and _G.ConfigManager.monster_cfg[v].CardID or 0
    end
end

---类的析构函数
function SystemEquipEmbattle:Dispose()
end
