require "BaseEmbattle"

---@class DungonesEmbattle    中文描述
local DungonesEmbattle = _G.BaseClass("DungonesEmbattle", _G.BaseEmbattle)
_G.DungonesEmbattle = DungonesEmbattle

local tipsID = {
    InEmbattle = 220102,
    InScene = 220101,
    NotEmbattle = 210103
}

---类的构造函数
function DungonesEmbattle:__init(view, type)
end

---初始化
function DungonesEmbattle:Init()
    local dungonesModel = require("DungonesModel"):GetInstance()
    self.Maps = dungonesModel.CurEventInfo.defender_team

    self.CurPage = 1
    ---@type tower_cfg_Item monster
    self.SelectMapSid = self.Maps[self.CurPage]
    self.SelfCardList = {}
    local cards = _G.BaseBattleManager:GetInstance():GetCardList()

    self.SelfCardList = cards

    if _G.AppSetting.DEBUG then
        _G.Log(self.SelfCardList, "卡片筛选结果")
    end
    self.EnemyCardList = require("AfkBattleManager"):GetInstance():GetEnemyCardList()
    self:GetEmbattleData()
    self:SetView(self.view.go_table)
end

---获取布阵信息
function DungonesEmbattle:GetEmbattleData()
    local EmbattleData
    self.TeamSid = {}
    self.TeamSid = {Attack = {}, Defence = {}}

    EmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.dungones)

    if _G.table.isEmptyOrNil(EmbattleData) then
        EmbattleData = {0, 0, 0, 0, 0, 0}
    end
    self.TeamSid.Attack[1] = EmbattleData
    self.TeamSid.Defence[1] = {}

    for i2, v2 in pairs(self.SelectMapSid.fights) do
        self.TeamSid.Defence[1][i2] = v2.sid
    end
end

---类的析构函数
function DungonesEmbattle:Dispose()
end

---开始战斗
function DungonesEmbattle:StartFight()
end

function DungonesEmbattle:CheckEmbattle(TeamSid)
    local isNil = true
    for _, v in pairs(TeamSid.Attack[self.CurPage]) do
        if v > 0 then
            isNil = false
            break
        end
    end
    if isNil then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotEmbattle)
        return false
    end
    return true
end
