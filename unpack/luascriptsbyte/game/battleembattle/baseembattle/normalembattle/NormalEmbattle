require "BaseEmbattle"

---@class NormalEmbattle	中文描述
local NormalEmbattle = _G.BaseClass("NormalEmbattle", _G.BaseEmbattle)
_G.NormalEmbattle = NormalEmbattle

---类的构造函数
function NormalEmbattle:__init(view)
end

---初始化
function NormalEmbattle:Init()
    self.type = _G.EBattleType.NormalBattle
    self.Maps = _G.NormalBattleManager:GetInstance():GetMap()
    self.CurPage = _G.NormalBattleManager:GetInstance():GetPage()
    self.SelectMapSid = self.Maps[self.CurPage]
    self.EnemyCardList = _G.NormalBattleManager:GetInstance():GetEnemyCardList()
    self.SelfCardList = _G.NormalBattleManager:GetInstance():GetCardList()
    self.UnitType = _G.HeroType.Hero
    self:GetEmbattleData()
    self:SetView(self.view.go_table)
end

---获取布阵信息
function NormalEmbattle:GetEmbattleData()
    local EmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.section)
    if table.isEmptyOrNil(EmbattleData) then
        EmbattleData = {0, 0, 0, 0, 0, 0}
    end
    self.TeamSid = {}
    self.TeamSid = {Attack = {EmbattleData}, Defence = {{0, 0, 0, 0, 0, 0}}}
    self.TeamSid.Defence = _G.ConfigManager.monster_group_cfg[self.SelectMapSid].DefaultDefenserSids
end

---类的析构函数
function NormalEmbattle:Dispose()
end
