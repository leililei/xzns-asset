require "BaseEmbattle"
require "NormalBagAloneManager"
---@class NormalBagAloneEmbattle	中文描述
local NormalBagAloneEmbattle = _G.BaseClass("NormalBagAloneEmbattle", _G.BaseEmbattle)
_G.NormalBagAloneEmbattle = NormalBagAloneEmbattle
local CombineModel = require "CombineModel"
local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function NormalBagAloneEmbattle:__init(view, type)
end

---初始化
function NormalBagAloneEmbattle:Init()
    self.Maps = _G.NormalBagAloneManager:GetInstance():GetMap()
    self.CurPage = _G.NormalBagAloneManager:GetInstance():GetPage()
    self.SelectMapSid = self.Maps[self.CurPage]
    self.EnemyCardList = _G.NormalBagAloneManager:GetInstance():GetEnemyCardList()
    self.SelfCardList = _G.NormalBagAloneManager:GetInstance():GetCardList()
    self.UnitType = _G.HeroType.Hero
    self.EnemyIsDrag = true
    self:GetEmbattleData()
end

---获取布阵信息
function NormalBagAloneEmbattle:GetEmbattleData()
    local AtkEmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.normalBagAloneAtk)
    local DefEmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.normalBagAloneDef)
    if table.isEmptyOrNil(AtkEmbattleData) then
        AtkEmbattleData = {0, 0, 0, 0, 0, 0}
    end
    -- if DefEmbattleData[1] == 0 then
    --     DefEmbattleData = {DefEmbattleData}
    -- end
    self.TeamSid = {}
    self.TeamSid = {Attack = {AtkEmbattleData}, Defence = {DefEmbattleData}}
end

---设置一些UI的显示隐藏
function NormalBagAloneEmbattle:SetView(tb)
    tb.obj_Page:SetActiveE(0)
    --     tb.obj_TeamBtn:SetActiveE(0)
    tb.obj_SelectPage:SetActiveE(0)
    tb.aorbtn_InputOrExport:SetActiveE(1)
    tb.aorbtn_InputLocalTeam:SetActiveE(1)
    tb.aorbtn_LastFightStart:SetActiveE(1)
    tb.aorbtn_Setting:SetActiveE(1)
    tb.aorbtn_InputCfg:SetActiveE(1)
    --     tb.obj_ChooseMap:SetActiveE(0)
end

---清除布阵信息
function NormalBagAloneEmbattle:ClearEmbattleData()
    if self.TeamSid.Attack and self.TeamSid.Attack[self.CurPage] then
        self.TeamSid.Attack[self.CurPage] = {0, 0, 0, 0, 0}
    end
    if self.TeamSid.Defence and self.TeamSid.Defence[self.CurPage] then
        self.TeamSid.Defence[self.CurPage] = {0, 0, 0, 0, 0}
    end
end

---类的析构函数
function NormalBagAloneEmbattle:Dispose()
end

---开始战斗
function NormalBagAloneEmbattle:StartFight()
end

function NormalBagAloneEmbattle:GetEnemyCardListNoStroage()
    local CardList = {}
    ---@type card_cfg
    local Cfg = _G.ConfigManager.card_cfg
    for i, v in pairs(Cfg) do
        local Card = _G.CardData.New()
        Card:Parse({sid = i, uid = i})
        CardList[i] = Card
    end
    return CardList or {}
end

function NormalBagAloneEmbattle:OtherExit(call)
    if call ~= nil then
        call()
    end
    local Setting = _G.PlayerPrefsManager.GetTable("BattleEmbattleSetting", false)
    if Setting and Setting.Continue == 1 then
        return
    end
    self.view:Destroy()
    self.view:Close()
end

function NormalBagAloneEmbattle:GetCombineSkills()
end
