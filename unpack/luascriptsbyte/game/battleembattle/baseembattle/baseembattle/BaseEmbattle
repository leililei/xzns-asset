function BaseEmbattle:CheckEmbattle(TeamSid)
    local isNil = true
    for _, v in pairs(TeamSid.Attack[self.CurPage]) do
        if v > 0 then
            isNil = false
            break
        end
    end
    if isNil then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotEmbattle)
        return false
    end

    local tmp = {}
    isNil = true
    for key, value in pairs(TeamSid.Defence[self.CurPage]) do
        if value > 0 then
            isNil = false
            break
        end
    end
    if isNil then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotEmbattle)
        return false
    end
    return true
end

