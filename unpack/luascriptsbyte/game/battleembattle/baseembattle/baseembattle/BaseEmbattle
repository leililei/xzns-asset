---上阵判断
---@field data CardData 卡牌数据
---@field teamType _G.TeamType 队伍类型
function BaseEmbattle:Embattle(data, teamType)
    if teamType == _G.TeamType.Ally then
        if self.TeamSid.Attack[self.CurPage][self.view.SelectPos] == data.uid then
            self.TeamSid.Attack[self.CurPage][self.view.SelectPos] = 0
        else
            self.TeamSid.Attack[self.CurPage][self.view.SelectPos] = data.uid
        end
    else
        if self.TeamSid.Defence[self.CurPage][self.view.SelectPos] == data.uid then
            self.TeamSid.Defence[self.CurPage][self.view.SelectPos] = 0
        else
            self.TeamSid.Defence[self.CurPage][self.view.SelectPos] = data.uid
        end
    end
end

---检查该UID是否被选择
function BaseEmbattle:CheckUidIsSelected(Uid, teamType)
    if teamType == _G.TeamType.Ally then
        for _, v in pairs(self.TeamSid.Attack[self.CurPage]) do
            if Uid == v then
                return true
            end
        end
    else
        for _, v1 in pairs(self.TeamSid.Defence) do
            for _, v2 in pairs(v1) do
                if Uid == v2 then
                    return true
                end
            end
        end
    end

    return false
end

---检查该UID是否被上阵
function BaseEmbattle:CheckUidIsInScene(Uid, teamType)
    if teamType == _G.TeamType.Ally then
        for i, v in pairs(self.TeamSid.Attack) do
            if i ~= self.CurPage then
                for _, v1 in pairs(v) do
                    if Uid == v1 then
                        return true, i
                    end
                end
            end
        end
    end
    return false
end

---检查是否有同类型的卡牌上阵
function BaseEmbattle:CheckSidIsInScene(sid, uid, teamType)
    local cardData
    if teamType == _G.TeamType.Ally then
        for i, v in pairs(self.TeamSid.Attack) do
            for _, v2 in pairs(v) do
                cardData = self.SelfCardList[v2]
                if cardData ~= nil then
                    if cardData.sid == sid and cardData.uid ~= uid then
                        return true
                    end
                end
            end
        end
    end
    return false
end

---位置选择
---@field index number 点击的位置
---@field teamType _G.TeamType 点击位置的队伍类型
---@field selfTeamType _G.TeamType 当前队伍类型
---@return boolean 是否允许队伍切换
function BaseEmbattle:ChoosePos(index, teamType, selfTeamType)
    self.view.TeamType = teamType
    self.view:ClearLastFiltrate()
    self.view.SelectPos = index
    return true
end

---清除布阵信息
function BaseEmbattle:ClearEmbattleData()
    self.TeamSid.Attack[self.CurPage] = {0, 0, 0, 0, 0}
    self.view.SelectPos = 1
end

---对UID列表进行排序
function BaseEmbattle:CardListSort(CardUidList, CardList)
    table.sort(
        CardUidList,
        function(a, b)
            local CardA = CardList[a]
            local CardB = CardList[b]
            if self.view.SortType == _G.SortType.Default then
                if CardA.cfg.Order > CardB.cfg.Order then
                    return true
                elseif CardA.cfg.Order == CardB.cfg.Order then
                    return CardA.power > CardB.power
                end
            elseif self.view.SortType == _G.SortType.Power then
                return CardA.power > CardB.power
            elseif self.view.SortType == _G.SortType.Lv then
                return CardA:GetLevel() > CardB:GetLevel()
            end
        end
    )
end

