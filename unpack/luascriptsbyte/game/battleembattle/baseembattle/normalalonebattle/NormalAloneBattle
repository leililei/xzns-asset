require "BaseEmbattle"
require "NormalAloneManager"
---@class NormalAloneBattle	中文描述
local NormalAloneBattle = _G.BaseClass("NormalAloneBattle", _G.BaseEmbattle)
_G.NormalAloneBattle = NormalAloneBattle
local CombineModel = require "CombineModel"
local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function NormalAloneBattle:__init(view, type)
end

---初始化
function NormalAloneBattle:Init()
    self.Maps = _G.NormalAloneManager:GetInstance():GetMap()
    self.CurPage = _G.NormalAloneManager:GetInstance():GetPage()
    self.SelectMapSid = self.Maps[self.CurPage]
    self.EnemyCardList = _G.NormalAloneManager:GetInstance():GetEnemyCardList()
    self.SelfCardList = _G.NormalAloneManager:GetInstance():GetCardList()
    self.UnitType = _G.HeroType.Hero
    self.EnemyIsDrag = true
    self:GetEmbattleData()
end

---获取布阵信息
function NormalAloneBattle:GetEmbattleData()
    local AtkEmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.normalAloneAtk)
    local DefEmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.normalAloneDef)
    if table.isEmptyOrNil(AtkEmbattleData) then
        AtkEmbattleData = {0, 0, 0, 0, 0, 0}
    end
    -- if DefEmbattleData[1] == 0 then
    --     DefEmbattleData = {DefEmbattleData}
    -- end
    self.TeamSid = {}
    self.TeamSid = {Attack = {AtkEmbattleData}, Defence = {DefEmbattleData}}
end

---设置一些UI的显示隐藏
function NormalAloneBattle:SetView(tb)
    tb.obj_Page:SetActiveE(0)
    --     tb.obj_TeamBtn:SetActiveE(0)
    tb.obj_SelectPage:SetActiveE(0)
    tb.aorbtn_InputOrExport:SetActiveE(1)
    tb.aorbtn_InputLocalTeam:SetActiveE(1)
    tb.aorbtn_LastFightStart:SetActiveE(1)
    --     tb.obj_ChooseMap:SetActiveE(0)
end

---清除布阵信息
function NormalAloneBattle:ClearEmbattleData()
    if self.TeamSid.Attack and self.TeamSid.Attack[self.CurPage] then
        self.TeamSid.Attack[self.CurPage] = {0, 0, 0, 0, 0}
    end
    if self.TeamSid.Defence and self.TeamSid.Defence[self.CurPage] then
        self.TeamSid.Defence[self.CurPage] = {0, 0, 0, 0, 0}
    end
end

function NormalAloneBattle:GetCombineSkills()
    local combine_cfgs = _G.ConfigManager.combine_cfg
    local allCombineList = {}
    local k = 1
    for i, v in pairs(combine_cfgs) do
        allCombineList[k] = {i, #v.skills}
        k = k + 1
    end
    return allCombineList
end

---类的析构函数
function NormalAloneBattle:Dispose()
end

---开始战斗
function NormalAloneBattle:StartFight()
end
