---初始化
function TestAloneEmbattle:Init()
    self.type = _G.EBattleType.TestAlone
    self.Maps = _G.TestBattleManager:GetInstance():GetMap()
    self.CurPage = _G.TestBattleManager:GetInstance():GetPage()
    self.SelectMapSid = self.Maps[self.CurPage]
    --self.EnemyCardList = _G.TestBattleManager:GetInstance():GetEnemyCardList()
    self.EnemyCardList = _G.TestBattleManager:GetInstance():GetCardList()
    self.SelfCardList = _G.TestBattleManager:GetInstance():GetCardList()
    self.EnemyIsDrag = true
    self.UnitType = _G.HeroType.None
    self:GetEmbattleData()
    self:SetView(self.view.go_table)
end

---对UID列表进行排序
function TestAloneEmbattle:CardListSort(CardUidList, CardList)
    table.sort(
        CardUidList,
        function(a, b)
            local CardA = CardList[a]
            local CardB = CardList[b]
            if self.view.SortType == _G.SortType.Default then
                --第一优先级: Order降序
                if CardA.cfg.Order ~= CardB.cfg.Order then
                    return CardA.cfg.Order > CardB.cfg.Order
                end
                --第二优先级: power降序
                if CardA.power ~= CardB.power then
                    return CardA.power > CardB.power
                end
                --第三优先级: sid升序
                return CardA.sid < CardB.sid
            elseif self.view.SortType == _G.SortType.Power then
                --第一优先级: power降序
                if CardA.power ~= CardB.power then
                    return CardA.power > CardB.power
                end
            elseif self.view.SortType == _G.SortType.Lv then
                --第一优先级: level降序
                if CardA:GetLevel() ~= CardB:GetLevel() then
                    return CardA:GetLevel() > CardB:GetLevel()
                end
            end
        end
    )
end

---获取布阵信息
function TestAloneEmbattle:GetEmbattleData()
    local AtkEmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.testAloneAtk)
    local DefEmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.testAloneDef)
    DefEmbattleData = {}
    local index = 0
    local done = false
    while true do
        local data = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.testAloneDef + index)
        index = index + 1
        --布阵数据改了没同步到测试战斗，做个转换
        if data ~= nil and #data > 0 and type(data[1]) == "table" then
            data = data[1]
        end
        for i = 1, #data do
            if data[i] > 0 then
                _G.table.insert(DefEmbattleData, data)
                break
            end
            if i == #data then
                done = true
            end
        end
        if done then
            break
        end
    end
    if #DefEmbattleData == 0 then
        _G.table.insert(DefEmbattleData, { 0, 0, 0, 0, 0 })
    end
    self.TeamSid = {}
    self.TeamSid = { Attack = { AtkEmbattleData }, Defence = DefEmbattleData }
end

