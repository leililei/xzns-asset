function TestAloneEmbattle:GetCombineSkills()
    local combine_cfgs = _G.ConfigManager.combine_cfg
    local allCombineList = {}
    local k = 1
    for i, v in pairs(combine_cfgs) do
        allCombineList[k] = { i, #v.skills }
        k = k + 1
    end
    return allCombineList
end

