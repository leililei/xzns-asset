require "BaseEmbattle"

---@class TowerEmbattle    中文描述
local TowerEmbattle = _G.BaseClass("TowerEmbattle", _G.BaseEmbattle)
_G.TowerEmbattle = TowerEmbattle

local tipsID = {
    InEmbattle = 220102,
    InScene = 220101,
    NotEmbattle = 210103
}

---类的构造函数
function TowerEmbattle:__init(view, type)
end

---初始化
function TowerEmbattle:Init()
    local deadModel = require("DeadsoulTowerModel"):GetInstance()
    self.Maps = deadModel.TowerMonster
    local ti = _G.ConfigManager.tower_cfg[deadModel.CurTowerSid]
    self.CurPage = 1
    ---@type tower_cfg_Item monster
    self.SelectMapSid = self.Maps[self.CurPage]
    self.SelfCardList = {}
    local cards = _G.BaseBattleManager:GetInstance():GetCardList()
    if _G.AppSetting.DEBUG then
        _G.Log(deadModel.CurTowerType .. "==" .. deadModel.MianTower, "布阵五行选择")
    end
    ---主塔没有属性限制
    if deadModel.CurTowerType == deadModel.MianTower then
        self.SelfCardList = cards
    else
        for k, v in pairs(cards) do
            ---@type CardData
            local card = v
            if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(card.cfg.Elements_new , ti.limit_element) then
                self.SelfCardList[k] = v
            end
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log(self.SelfCardList, "卡片筛选结果")
    end
    self.EnemyCardList = require("AfkBattleManager"):GetInstance():GetEnemyCardList()
    self:GetEmbattleData()
    self:SetView(self.view.go_table)
end

---获取布阵信息
function TowerEmbattle:GetEmbattleData()
    local EmbattleData
    self.TeamSid = {}
    self.TeamSid = {Attack = {}, Defence = {}}
    if DeadsoulTowerModel:GetInstance().CurTowerType == DeadsoulTowerModel:GetInstance().MianTower then
        EmbattleData = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.Tower)
    else
        EmbattleData =
            require("EmbattleModel"):GetInstance():GetEmbattleData(
            _G.EmbattleType["Tower" .. DeadsoulTowerModel:GetInstance().CurTowerType]
        )
    end
    if table.isEmptyOrNil(EmbattleData) then
        EmbattleData = {0, 0, 0, 0, 0, 0}
    end
    self.TeamSid.Attack[1] = EmbattleData
    self.TeamSid.Defence[1] = {}

    for i2, v2 in pairs(_G.ConfigManager.monster_group_cfg[self.SelectMapSid].DefaultDefenserSids[1]) do
        self.TeamSid.Defence[1][i2] = _G.ConfigManager.monster_cfg[v2] and _G.ConfigManager.monster_cfg[v2].CardID or 0
    end
end

---类的析构函数
function TowerEmbattle:Dispose()
end

---开始战斗
function TowerEmbattle:StartFight()
end

function TowerEmbattle:CheckEmbattle(TeamSid)
    local isNil = true
    for _, v in pairs(TeamSid.Attack[self.CurPage]) do
        if v > 0 then
            isNil = false
            break
        end
    end
    if isNil then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotEmbattle)
        return false
    end
    return true
end
