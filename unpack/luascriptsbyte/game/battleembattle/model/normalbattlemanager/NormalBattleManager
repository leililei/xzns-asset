---@class NormalBattleManager : Singleton	中文描述
local NormalBattleManager = _G.BaseClass("NormalBattleManager", _G.Singleton)
_G.NormalBattleManager = NormalBattleManager

local CS = _G.CS
local typeof = _G.typeof

---@return NormalBattleManager NormalBattleManager
function NormalBattleManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function NormalBattleManager:__init()
    self.type = _G.EBattleType.NormalBattle
    self.CurPage = 1
end

---获取当前场次
function NormalBattleManager:GetPage()
    return self.CurPage or 1
end

---获取配置表中的场景
function NormalBattleManager:GetMap()
    return {1001}
end

---获取我方卡牌列表
function NormalBattleManager:GetCardList()
    return _G.BaseBattleManager:GetInstance():GetCardList()
end

---获取敌方卡牌列表
function NormalBattleManager:GetEnemyCardList()
    return _G.BaseBattleManager:GetInstance():GetEnemyCardList()
end

local function OpenMainView(self, name)
    if name ~= _G.ConfigManager.ui_cfg.BattleView.Name then
        return
    end

    if self.call ~= nil then
        self.call()
    end
    if self.type ~= _G.EBattletype.NormalBattle then
        self:ClearView(false)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleEmbattleView.Name, self.type)
    else
        self:ClearView(true)
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
end
---战斗结束
function NormalBattleManager:FightEnd(data, call)
    if
        self.type == _G.EBattletype.TestAlone or self.type == _G.EBattletype.TestOnline or
            self.type == _G.EBattletype.NormalAlone
     then
        self.data = data
        self.call = call
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        data.winner,
        nil,
        function()
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        end,
        false
    )
end

---销毁对象时,析构函数
function NormalBattleManager:Dispose()
end
