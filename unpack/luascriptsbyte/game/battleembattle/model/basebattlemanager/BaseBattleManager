---获取我方卡牌列表
function BaseBattleManager:GetCardList()
    local list = {}
    for i, v in pairs(_G.StorageManager:GetInstance():GetStrongestCards()) do
        list[v.uid] = v
    end
    return list
end

---获取敌方卡牌列表
function BaseBattleManager:GetEnemyCardList()
    local CardList = {}
    ---@type card_cfg
    local Cfg = _G.ConfigManager.card_cfg
    for i, v in pairs(Cfg) do
        if v.is_effective_hero then
            local Card = _G.CardData.New()
            Card:Parse({sid = i, uid = i})
            CardList[i] = Card
        end
    end
    return CardList or {}
end

---清除主场景或登录界面
function BaseBattleManager:ClearView(bl)
    local MainView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if MainView then
        if bl then
            bl = self.curWorldState
        else
            self.curWorldState = _G.WorldManager:GetInstance():GetCurWorldShow()
        end
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(bl)
    end
    local LoginView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
    if LoginView then
        self.Login = true
        if bl then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        else
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        end
    elseif self.Login and bl then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        self.Login = false
    end
end

---检测是否正确布阵
function BaseBattleManager:CheckEmbattlePass(att, def)
    local bl = false
    if att then
        for _, v in pairs(att) do
            if v ~= 0 then
                bl = true
                break
            end
        end
    end
    if bl then
        bl = false
    else
        return bl
    end
    if def then
        for _, v in pairs(def) do
            for _, v2 in pairs(v) do
                if v2 ~= 0 then
                    bl = true
                    break
                end
            end
        end
    end
    return bl
end

---生成arg 用于测试战斗
function BaseBattleManager:CreateArgData(MonsterGroupID, BattleType, IsAutoBattle, AtkUids)
    local argdata = {}
    argdata.sid = MonsterGroupID
    argdata.fight_type = BattleType
    argdata.seed = CS.UnityEngine.Time.time
    argdata.auto = IsAutoBattle
    argdata.attacker_team = {}
    argdata.defender_team = {}
    argdata.scene_buffs = {}
    argdata.cards = {}
    local teamData = {}
    local cardData
    local AttrData
    local fighter
    teamData.team_num = 1
    teamData.fighter_type = 0
    teamData.open_buffs = {}
    teamData.team_skill = {}
    teamData.fights = {}
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    teamData.lv = PlayerModelIns:GetLevel()
    teamData.power = 0
    teamData.name = PlayerModelIns.role_name
    local monster_cfg = _G.ConfigManager.monster_cfg
    local cardskill_cfg = _G.ConfigManager.card_skills_cfg
    local cfg
    local insert = _G.table.insert
    for i, v in pairs(AtkUids) do
        fighter = {}
        cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v)
        if cardData then
            AttrData = cardData:GetCardSumAttr()
            fighter.index = i
            fighter.sid = cardData.sid
            fighter.uid = v
            fighter.lv = cardData:GetLevel()
            fighter.order = cardData.cfg.Order
            AttrData.power = cardData:GetPower()
            fighter.attrs = AttrData
            local skills = monster_cfg[cardData.sid].Skills
            local skillArray, transSkillArray = {}, {}
            for j = 1, #skills do
                cfg = cardskill_cfg[skills[j]]
                for k = 1, #cfg.skills do
                    insert(skillArray, cfg.skills[k])
                end
                for k = 1, #cfg.trans_skills do
                    insert(transSkillArray, cfg.trans_skills[k])
                end
            end
            fighter.skills = skillArray
            fighter.trans_skills = transSkillArray
            table.insert(teamData.fights, fighter)
        end
    end
    table.insert(argdata.attacker_team, teamData)
    return argdata
end

