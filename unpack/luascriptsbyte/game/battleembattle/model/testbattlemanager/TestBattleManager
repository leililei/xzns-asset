require "BaseEmbattle"
require "BaseBattleManager"
---@class TestBattleManager : Singleton	中文描述
local TestBattleManager = _G.BaseClass("TestBattleManager", _G.Singleton)
_G.TestBattleManager = TestBattleManager

local CS = _G.CS
local typeof = _G.typeof

---@return TestBattleManager TestBattleManager
function TestBattleManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function TestBattleManager:__init()
    self.type = _G.EBattleType.TestAlone
    self.CurPage = 1
end

---获取配置表中的场景
function TestBattleManager:GetMap()
    local maps = {}
    local cfg = _G.ConfigManager.monster_group_cfg
    for i, v in pairs(cfg) do
        if i >= 1000 and i < 2000 then
            table.insert(maps, i)
        end
    end
    table.sort(
        maps,
        function(a, b)
            return a < b
        end
    )
    return maps
end

---获取卡牌列表
function TestBattleManager:GetCardList()
    local CardList = {}

    local card_cfg = _G.ConfigManager.card_cfg
    local skin_cfg = _G.ConfigManager.skin_cfg

    ---@param cfg card_cfg
    for id, cfg in pairs(card_cfg) do
        if cfg.BattleViewExUi == "1" then
            local cardData1 = _G.CardData.New()
            cardData1:Parse({ sid = id, uid = id })
            CardList[id] = cardData1
            --遍历皮肤列表
            if cfg.skin and #cfg.skin > 0 then
                for _, skinId in ipairs(cfg.skin) do
                    if skin_cfg[skinId] then
                        local cardData2 = _G.CardData.New()
                        cardData2:Parse({ sid = skinId, uid = skinId, skin = skinId })
                        cardData2:SetSkin(skinId)
                        CardList[skinId] = cardData2
                    end
                end
            end
        end
    end

    return CardList or {}
end

---获取敌方卡牌列表
function TestBattleManager:GetEnemyCardList()
    local CardList = {}
    ---@type card_cfg
    local Cfg = _G.ConfigManager.card_cfg
    for i, v in pairs(Cfg) do
        if v.BattleViewExUi == "1" then
            local Card = _G.CardData.New()
            Card:Parse({ sid = i, uid = i })
            CardList[i] = Card
        end
    end
    return CardList or {}
end

---保存当前的页数
function TestBattleManager:SavePage(page)
    self.Page = page
end

---获取当前的页数
function TestBattleManager:GetPage()
    return self.Page or 1
end

---进入布阵
---@param type _G.EBattleType 战斗类型
function TestBattleManager:EnterEmbattle(type)
    self.type = type
    local Model = _G.BaseBattleManager:GetInstance():GetEmbattleModelByType(type)
    if Model then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleEmbattleView.Name,
            Model,
            _G.handler(self, self.CloseEmbattleView),
            _G.handler(self, self.EnterFight)
        )
    end
end

---关闭布阵界面回调
function TestBattleManager:CloseEmbattleView()
end

---进入战斗回调
---@param AttackUids table 我方布阵数据
---@param DefenceSids table<table> 敌方布阵数据
---@param scene monster_group_cfg  ID
function TestBattleManager:EnterFight(AttackUids, DefenceSids, scene, battleType, testSelfCombSkill, testEnemyCombSkill, testSelfPetSkill, testEnemyPetSkill)
    if _G.BaseBattleManager:GetInstance():CheckEmbattlePass(AttackUids, DefenceSids) then
        self.type = battleType
        _G.BattleManager:GetInstance():EnterFight(
            _G.BattleControllerType.testBattle,
            self.type,
            AttackUids,
            DefenceSids,
            scene,
            testSelfCombSkill,
            testEnemyCombSkill, 
            testSelfPetSkill, 
            testEnemyPetSkill
        )
    end
end

---成功进入战斗保存布阵数据
function TestBattleManager:SaveEmbattleData(attackUids, defenceSids)
    ---阵容保存
    if self.type == _G.EBattleType.TestAlone then
        require("EmbattleModel"):GetInstance():SetEmbattleByUids(attackUids, _G.EmbattleType.testAloneAtk, true)
        for i = 1, #defenceSids do
            require("EmbattleModel"):GetInstance():SetEmbattleByUids(
                defenceSids[i],
                _G.EmbattleType.testAloneDef + i - 1,
                true
            )
        end
        require("EmbattleModel"):GetInstance():SaveLocalEmbattleData()
    elseif self.type == _G.EBattleType.NormalAlone then
        require("EmbattleModel"):GetInstance():SetEmbattleByUids(attackUids, _G.EmbattleType.normalAloneAtk, true)
        -- for i = 1, #defenceSids do
        require("EmbattleModel"):GetInstance():SetEmbattleByUids(defenceSids[1], _G.EmbattleType.normalAloneDef, true)
    -- end
    end
    require("EmbattleModel"):GetInstance():SaveLocalEmbattleData()
end

---销毁对象时,析构函数
function TestBattleManager:Dispose()
end
