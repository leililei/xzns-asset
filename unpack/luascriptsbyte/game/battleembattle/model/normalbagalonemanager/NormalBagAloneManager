---@param data CardData
function NormalBagAloneManager:GetSkill(data)
    local tb = {}
    for i = 1, 4 do
        local SkillId = data.sid + i * 100 + 1
        local skillcfg = _G.ConfigManager.card_skills_cfg[SkillId]
        if skillcfg ~= nil then
            -- SkillId = skillcfg.skills[1]
            tb[i] = SkillId
        end
    end
    return tb
end

---成功进入战斗保存布阵数据
function NormalBagAloneManager:SaveEmbattleData(attackUids, defenceSids, id)
    ---阵容保存
    if self.type == _G.EBattleType.NormalBagAlone then
        require("EmbattleModel"):GetInstance():SetEmbattleByUids(attackUids, _G.EmbattleType.normalBagAloneAtk, true)
        -- for i = 1, #defenceSids do
        if type(defenceSids[1]) == "number" then
            require("EmbattleModel"):GetInstance():SetEmbattleByUids(
                defenceSids,
                _G.EmbattleType.normalBagAloneDef,
                true
            )
        else
            require("EmbattleModel"):GetInstance():SetEmbattleByUids(
                defenceSids[1],
                _G.EmbattleType.normalBagAloneDef,
                true
            )
        end
    -- end
    end
    _G.PlayerPrefsManager.SetTable("BattleMonsterGrounpID", {id = id}, true)
    require("EmbattleModel"):GetInstance():SaveLocalEmbattleData()
end

---战斗结束
function NormalBagAloneManager:FightEnd(data, call)
    if
        self.type == _G.EBattletype.TestAlone or self.type == _G.EBattletype.TestOnline or
            self.type == _G.EBattletype.NormalAlone
     then
        self.data = data
        self.call = call
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
        return _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        data.winner,
        nil,
        function()
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        end,
        false
    )
end

