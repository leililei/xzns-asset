---@class NormalBagAloneManager : Singleton	中文描述
local NormalBagAloneManager = _G.BaseClass("NormalBagAloneManager", _G.Singleton)
_G.NormalBagAloneManager = NormalBagAloneManager

local CS = _G.CS
local typeof = _G.typeof

---@return NormalBagAloneManager NormalBagAloneManager
function NormalBagAloneManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function NormalBagAloneManager:__init()
    self.type = _G.EBattleType.NormalBagAlone
    self.CurPage = 1
end

---获取配置表中的场景
function NormalBagAloneManager:GetMap()
    local cfg = _G.ConfigManager.monster_group_cfg
    local Maps = {}
    for i, _ in pairs(cfg) do
        if i >= 1000 and i < 10000 then
            table.insert(Maps, i)
        end
    end
    table.sort(
        Maps,
        function(a, b)
            return a < b
        end
    )
    return Maps
end

---获取当前场次
function NormalBagAloneManager:GetPage()
    return self.CurPage or 1
end

---获取卡牌列表
function NormalBagAloneManager:GetCardList()
    local CardList = _G.StorageManager:GetInstance().Storages[_G.StorageID.Card].list
    return CardList
end

---获取敌方卡牌列表
function NormalBagAloneManager:GetEnemyCardList()
    local CardList = _G.StorageManager:GetInstance().Storages[_G.StorageID.Card].list
    return CardList
end

local function OpenMainView(self, name)
    if name ~= _G.ConfigManager.ui_cfg.BattleView.Name then
        return
    end

    if self.call ~= nil then
        self.call()
    end
    if self.type ~= _G.EBattletype.NormalBattle then
        self:ClearView(false)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleEmbattleView.Name, self.type)
    else
        self:ClearView(true)
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
end

---进入布阵
---@param type _G.EBattleType 战斗类型
---@param Setting BattleEmbattleSetting
function NormalBagAloneManager:EnterEmbattle(type)
    self.type = type
    local Model = _G.BaseBattleManager:GetInstance():GetEmbattleModelByType(type)
    if Model then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleEmbattleView.Name,
            Model,
            _G.handler(self, self.CloseEmbattleView),
            _G.handler(self, self.EnterFight)
        )
    end
end

---关闭布阵界面回调
function NormalBagAloneManager:CloseEmbattleView()
end

---进入战斗回调
---@param AttackUids table 我方布阵数据
---@param DefenceSids table<table> 敌方布阵数据
---@param scene monster_group_cfg  ID

function NormalBagAloneManager:EnterFight(
    AttackUids,
    DefenceSids,
    scene,
    type,
    testSelfCombSkill,
    testEnemyCombSkill,
    testSelfPetSkill,
    testEnemyPetSkill)
    if _G.BaseBattleManager:GetInstance():CheckEmbattlePass(AttackUids, DefenceSids) then
        ---@type BattleEmbattleSetting
        local Setting = _G.PlayerPrefsManager.GetTable("BattleEmbattleSetting", false)
        if Setting and Setting.Continue == 1 then
            local isStory = _G.ConfigManager.monster_group_cfg[scene].battle_type == 1
            local attackUid = AttackUids
            if isStory then
                attackUid = _G.ConfigManager.monster_group_cfg[scene].DefaultAttackerSids
            end
            _G.coroutine.start(_G.handlerbind(self, self.CoFight, Setting, attackUid, DefenceSids, scene))
        else
            _G.BattleManager:GetInstance():EnterFight(
                _G.BattleControllerType.bagAloneBattle,
                self.type,
                AttackUids,
                DefenceSids,
                scene,
                Setting,
                testSelfCombSkill,
                testEnemyCombSkill,
                testSelfPetSkill,
                testEnemyPetSkill
            )
        end
    end
end

function NormalBagAloneManager:CoFight(Setting, AttackUids, DefenceSids, scene)
    local num = 1
    local result = {}
    local isUid = self:CheckUids(DefenceSids[1])
    while num <= Setting.Num do
        local arg
        arg =
            _G.BattleManager:GetInstance():SweepTestBattle(
            scene,
            {},
            {},
            self:GetFightArg(scene, AttackUids, DefenceSids[1]),
            isUid
        )
        result[num] = arg
        num = num + 1
        _G.coroutine.waitforseconds(0.1)
    end
    if Setting.Result == 1 then
        local isExit, view =
            _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleEmbattleStatisticsPVEView.Name)
        if isExit then
            view.View:UpdateData(result)
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleEmbattleStatisticsPVEView.Name)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleEmbattleStatisticsPVEView.Name, result)
        end
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleEmbattleResultView.Name, result)
    end
end

---获取战斗参数
function NormalBagAloneManager:GetFightArg(id, AttackUids, DefenceSids)
    local isStory = _G.ConfigManager.monster_group_cfg[id].battle_type == 1
    local tb = {
        ["sid"] = id,
        ["fight_type"] = _G.EBattleType.TestAlone,
        fight_cmd = {},
        ["seed"] = _G.TimeUtil.GetServerUnixTime() + _G.math.random(0, 100),
        ["auto"] = true,
        ["attacker_team"] = {
            [1] = {
                ["fighter_type"] = 0,
                ["fights"] = self:GetFights(AttackUids, not isStory),
                ["lv"] = _G.PlayerModel:GetInstance():GetLevel(),
                ["name"] = _G.PlayerModel:GetInstance().role_name,
                ["power"] = _G.StorageManager:GetInstance():GetPlayerPower(),
                ["team_num"] = 1
            }
        },
        ["defender_team"] = {
            [1] = {
                ["fighter_type"] = 0,
                ["fights"] = self:GetFights(DefenceSids, self:CheckUids(DefenceSids)),
                ["lv"] = _G.PlayerModel:GetInstance():GetLevel(),
                ["name"] = _G.PlayerModel:GetInstance().role_name,
                ["power"] = _G.StorageManager:GetInstance():GetPlayerPower(),
                ["team_num"] = 1
            }
        }
    }
    return tb
end

function NormalBagAloneManager:CheckUids(ids)
    for _, v in pairs(ids) do
        if v > 0 and _G.string.len(tostring(v)) > 14 then
            return true
        end
    end
    return false
end

