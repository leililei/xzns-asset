---@class NormalAloneManager : Singleton	中文描述
local NormalAloneManager = _G.BaseClass("NormalAloneManager", _G.Singleton)
_G.NormalAloneManager = NormalAloneManager

local CS = _G.CS
local typeof = _G.typeof

---@return NormalAloneManager NormalAloneManager
function NormalAloneManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function NormalAloneManager:__init()
    self.type = _G.EBattleType.NormalBattle
    self.CurPage = 1
end

---获取配置表中的场景
function NormalAloneManager:GetMap()
    local cfg = _G.ConfigManager.monster_group_cfg
    local Maps = {}
    for i, _ in pairs(cfg) do
        if i >= 1000 and i < 10000 then
            table.insert(Maps, i)
        end
    end
    table.sort(
        Maps,
        function(a, b)
            return a < b
        end
    )
    return Maps
end

---获取当前场次
function NormalAloneManager:GetPage()
    return self.CurPage or 1
end

---获取卡牌列表
function NormalAloneManager:GetCardList()
    local CardList = {}
    ---@type card_cfg
    local Cfg = _G.ConfigManager.card_cfg
    for i, v in pairs(Cfg) do
        local Card
        if v.is_effective_hero then
            Card = _G.CardData.New()
            Card:Parse({sid = i, uid = i})
            CardList[i] = Card
        end
    end
    return CardList or {}
end

---获取敌方卡牌列表
function NormalAloneManager:GetEnemyCardList()
    return _G.BaseBattleManager:GetInstance():GetEnemyCardList()
end

local function OpenMainView(self, name)
    if name ~= _G.ConfigManager.ui_cfg.BattleView.Name then
        return
    end

    if self.call ~= nil then
        self.call()
    end
    if self.type ~= _G.EBattletype.NormalBattle then
        self:ClearView(false)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BattleEmbattleView.Name, self.type)
    else
        self:ClearView(true)
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
end
---战斗结束
function NormalAloneManager:FightEnd(data, call)
    if
        self.type == _G.EBattletype.TestAlone or self.type == _G.EBattletype.TestOnline or
            self.type == _G.EBattletype.NormalAlone
     then
        self.data = data
        self.call = call
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        data.winner,
        nil,
        function()
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OpenMainView, self)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        end,
        false
    )
end

---销毁对象时,析构函数
function NormalAloneManager:Dispose()
end
