---@class GemstoneSubstituteView : UIBaseView	中文描述
---@field public go_table GemstoneSubstituteView_GoTable GoTable
local GemstoneSubstituteView = _G.BaseClass("GemstoneSubstituteView", _G.UIBaseView)

function GemstoneSubstituteView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.txtColor = {
        up = _G.ColorTools.FormatColorByString("68bf7a"),
        dowm = _G.ColorTools.FormatColorByString("cc4432")
    }
end

---界面的入口函数
function GemstoneSubstituteView:OnCreate(data, call)
    self.call = call
    self.professional = data.professional
    self.gemData = data.gemData
    self.cardData = data.cardData
    if self.gemData then
        self.score = self.gemData:GetAttrScore()
        self.go_table.aortext_no:SetActiveE(0)
        self.go_table.obj_info:SetActiveE(1)
        self.go_table.aortext_Name.text = self.gemData:GetName()
        self.go_table.aortext_power.text = _G.GetLangPackValue(90000010923, _G.GameUtil.NumberWY(_G.Mathf.RoundToInt(self.score)))
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            self.go_table.obj_root,
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:ShowData(self.gemData, function()
                end)
            end
        )
    else
        self.go_table.aortext_no:SetActiveE(1)
        self.go_table.obj_info:SetActiveE(0)
    end
    self.gemList = require("GemstoneModel"):GetInstance():GetGemListByProfessional(self.professional)
    _G.SortList(
        self.gemList,
        function(gem)
            local isSelf = 0
            if self.gemData and gem.uid == self.gemData.uid then
                isSelf = 1
            end
            return isSelf, gem.cardUid == 0 and 1 or 0, gem.grade, gem.star, gem.sid
        end
    )
    self.go_table.scrollloopvectical_gemList:InitItemData(#self.gemList, _G.handler(self, self.RefreshList))
end

function GemstoneSubstituteView:RefreshList(index, obj)
    index = index + 1
    local data = self.gemList[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClick, data))
    local score = data:GetAttrScore()
    tb.aortext_name.text = data:GetName()
    tb.aortext_score.text = _G.GetLangPackValue(90000010923, _G.GameUtil.NumberWY(score))
    if self.gemData then
        tb.obj_diff:SetActiveE(1)
        if self.score > score then
            tb.aortext_diff.color = self.txtColor.up
            tb.aortext_diff.text = _G.string.format("（-%s)", _G.GameUtil.NumberWY(self.score - score))
            tb.aorimage_up.SpriteName = "0ui_icon_xiajiang"
        elseif self.score < score then
            tb.aortext_diff.color = self.txtColor.dowm
            tb.aortext_diff.text = _G.string.format("（%s)", _G.GameUtil.NumberWY(score - self.score))
            tb.aorimage_up.SpriteName = "0ui_icon_shangsheng"
        else
            tb.obj_diff:SetActiveE(0)
        end
    else
        tb.obj_diff:SetActiveE(0)
    end
    if data.cardUid == 0 then
        tb.aorimage_cardbox:SetActiveE(0)
        tb.aortext_tips:SetActiveE(0)
        if not self.gemData then
            tb.aortext_Done.text = _G.LangUtil.GetLangPackValue(90023400020)
        else
            tb.aortext_Done.text = _G.LangUtil.GetLangPackValue(90020400047)
        end
    else
        tb.aorimage_cardbox:SetActiveE(1)
        tb.aortext_tips:SetActiveE(1)
        local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.cardUid)
        if carddata ~= nil then
            tb.aorimage_card.SpriteName = carddata.cfg.Icon
        end
        if self.gemData and self.gemData.uid == data.uid then
            tb.aortext_Done.text = _G.LangUtil.GetLangPackValue(90012500501)
        else
            tb.aortext_Done.text = _G.LangUtil.GetLangPackValue(90020400047)
        end
    end
    if not tb.item then
        tb.item = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            tb.obj_node,
            function(trans)
                if self:IsNil() then
                    return
                end
                tb.item = trans
                trans:ShowData(data, function()
                end)
            end
        )
    elseif tb.item ~= true then
        tb.item:ShowData(data, function()
        end)
    end
end

function GemstoneSubstituteView:OnClick(_, _, data)
    if self.gemData and self.gemData.uid == data.uid then
        _G.PopWindowManager:GetInstance():ShowAllTips(2720105,nil,function()
            -- 卸下
            require("GemstoneModel"):GetInstance():Upload(
                data.cardUid,
                data.professional,
                function(msg)
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    if self.call then
                        self.call()
                    end
                    self:Close()
                end
            )
        end)
    elseif data.cardUid == 0 then
        -- 穿上
        require("GemstoneModel"):GetInstance():Mosaic(
            self.cardData.uid,
            { { key = data.professional, value = data.uid } },
            function()
                if self.call then
                    self.call()
                end
                self:Close()
            end
        )
    else
        -- 交换
        require("GemstoneModel"):GetInstance():Replace(
            self.cardData.uid,
            data.cardUid,
            data.professional,
            function()
                if self.call then
                    self.call()
                end
                self:Close()
            end
        )

    end
end

---界面的销毁函数
function GemstoneSubstituteView:OnDestroy()
end

---按钮点击事件在这里派发
function GemstoneSubstituteView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

return GemstoneSubstituteView
