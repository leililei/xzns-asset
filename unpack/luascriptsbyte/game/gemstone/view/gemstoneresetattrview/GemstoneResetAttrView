---@class GemstoneResetAttrView : UIBaseView	中文描述
---@field public go_table GemstoneResetAttrView_GoTable GoTable
local GemstoneResetAttrView = _G.BaseClass("GemstoneResetAttrView", _G.UIBaseView)

function GemstoneResetAttrView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.consumeList = _G.ConfigManager.discrete_cfg[153002]
end
local propColor={
    [1]="35d057",
    [2]="55ade0",
    [3]="bd66cf",
    [4]="d44343"
}

---界面的入口函数
---@param data GemstoneData 宝石数据
function GemstoneResetAttrView:OnCreate(data, lockIndexList, call)
    self.data = data
    self.lockIndexList = lockIndexList
    self.call = call
    self.cfg = _G.ConfigManager.gem_add_att_cfg
    self.selectItemIndex = 0
    self.model = require("GemstoneModel"):GetInstance()
    self.score = self.model:GetAdditionsScore(self.data.randomAttr)
    self.maxSpuerDataScore = self.score
    self.maxSpuerDataIndex = 0
    self.resetType = _G.table.count(data.reset)
    if not data.reset then
        self:Close()
    elseif self.resetType == 1 then
        -- self.go_table.aorimage_select:SetRectTransformSize(460, 300)
        self:ShowOnePanel()
        self.go_table.aortext_left.text = _G.GetLangPackValue(90020400063)
        self.go_table.aortext_Right.text = _G.GetLangPackValue(90022500396)
    else
        self:ShowDoublePanel()
        local consume = {}
        local lockNum = _G.table.count(lockIndexList)
        for i = 1, #self.consumeList[lockNum + 1] // 2 do
            _G.table.insert(consume,
                { self.consumeList[lockNum + 1][i * 2 - 1], false, self.consumeList[lockNum + 1][i * 2] })
        end
        for _, v in pairs(consume) do
            v[3] = v[3] * 5
        end
        self.consume = consume
        self.consumeObj = self:AddComponent(
            self.go_table.obj_PlaceHolder,
            require("ConsumeCompont").New(self.go_table.obj_PlaceHolder, consume, nil, nil, true,
                { textColorType = 4, showNow = false })
        )
    end
end

function GemstoneResetAttrView:ShowOnePanel()
    self.go_table.obj_DanCi:SetActiveE(1)
    local tb
    tb = _G.GetAutoGoTable(self.go_table.aorbtn_dan0, _G.handlerbind(self, self.OnItemClick, 0))
    self:OnItemClick(self.go_table.aorbtn_dan0, nil, 0)
    self:ShowAttrItem(tb, self.data.randomAttr, 0)
    tb = _G.GetAutoGoTable(self.go_table.aorbtn_dan1, _G.handlerbind(self, self.OnItemClick, 1))
    for _, v in pairs(self.lockIndexList) do
        _G.table.insert(self.data.reset[1].addition, v, self.data.randomAttr[v])
    end
    self:ShowAttrItem(tb, self.data.reset[1].addition, 1)
end

function GemstoneResetAttrView:ShowDoublePanel()
    self.go_table.obj_DuoCi:SetActiveE(1)
    local tb
    tb = _G.GetAutoGoTable(self.go_table.aorbtn_duo0, _G.handlerbind(self, self.OnItemClick, 0))
    self:OnItemClick(self.go_table.aorbtn_duo0, nil, 0)
    self:ShowAttrItem(tb, self.data.randomAttr, 0)
    local index = 0
    for _, v in pairs(self.data.reset) do
        index = index + 1
        tb = _G.GetAutoGoTable(self.go_table["aorbtn_duo" .. index], _G.handlerbind(self, self.OnItemClick, index))
        for _, lock in pairs(self.lockIndexList) do
            _G.table.insert(v.addition, lock, self.data.randomAttr[lock])
        end
        self:ShowAttrItem(tb, v.addition, index)
    end
end

function GemstoneResetAttrView:ShowAttrItem(tb, attr, index0)
    local index = 0
    local color
    tb.obj_prop:ClearChildren()
    for _, v in pairs(attr) do
        index = index + 1
        local item = _G.InstantiateObject(self.go_table.obj_propDanItem, tb.obj_prop)
        item:SetActiveE(1)
        local itemTb = _G.GetAutoGoTable(item)
        color=self:GetPropShowColor(v.value,self.cfg[v.sid].value[#self.cfg[v.sid].value], self.cfg[v.sid].value[1])
        itemTb.aorimage_di:SetActiveE(index % 2)
        itemTb.aortext_name.text = _G.GetLangPackValue(self.cfg[v.sid].name)
        itemTb.aortext_value.text = v.value / 100 .. "%"
        itemTb.aortext_fanwei.text = _G.string.format("[%s%%~%s%%]", self.cfg[v.sid].value[1] / 100,
            self.cfg[v.sid].value[#self.cfg[v.sid].value] / 100)
        itemTb.aortext_name.color=_G.ColorTools.FormatColorByString(color)
        itemTb.aortext_value.color=_G.ColorTools.FormatColorByString(color)
        itemTb.aortext_fanwei.color=_G.ColorTools.FormatColorByString(color)
        itemTb.aorimage_suo:SetActiveE(_G.table.ContainsValue(self.lockIndexList, v.index) and 1 or 0)
    end
    local score = self.model:GetAdditionsScore(attr)
    tb.aortext_PingFen.text = _G.GetLangPackValue(90000010923,string.AddColor(_G.GameUtil.NumberWY(score),"f89f49"))
    tb.aorimage_up:SetActiveE(self.score == score and 0 or 1)
    if self.score < score then
        tb.aorimage_up.SpriteName="0ui_icon_shangsheng"
    elseif self.score > score then
        tb.aorimage_up.SpriteName="0ui_icon_xiajiang"
    end
    if self.maxSpuerDataScore < score then
        self.maxSpuerDataIndex = index0
        self.maxSpuerDataScore = score
    end
end
function GemstoneResetAttrView:GetPropShowColor(value,max,min)
    local index=1
    local discount=(max-min)/table.count(propColor)
    for i = 1, table.count(propColor) do
        if i<table.count(propColor) and value<(min+discount*i) and value>=(min+discount*(i-1)) then
            index=i
        elseif i==table.count(propColor) and value>=(min+discount*(i-1)) then 
            index=table.count(propColor)
        end
    end
    return propColor[index]
end

function GemstoneResetAttrView:OnItemClick(go, _, index)
    if self.resetType ~= 1 then
        self.go_table.aorimage_select:SetParentE(go)
        self.go_table.aorimage_select:SetSiblingIndexE(1)
        self.go_table.aorimage_select:SetLocalPosition(0, 5, 0)
        self.selectItemIndex = index
        if index == 0 then
            self.go_table.aortext_Right.text = _G.GetLangPackValue(90020400063)
        else
            self.go_table.aortext_Right.text = _G.GetLangPackValue(90022500396)
        end
    end
end

---按钮点击事件在这里派发
function GemstoneResetAttrView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Right then
        local selectIndex = self.resetType == 1 and 1 or self.selectItemIndex
        local type = selectIndex == 0 and 1 or 2
        local SelectResetAttr = function(index, t)
            require("GemstoneModel"):GetInstance():SelectResetAttr(
            self.data.uid,
            index,
            t,
            t == 2 and self.data.reset[index].addition or {},
            function()
                if self.call then
                    self.call()
                end
                self:Close()
            end
        )
        end
        if selectIndex == self.maxSpuerDataIndex then
            SelectResetAttr(selectIndex, type)
        else
            local tipid
            if self.maxSpuerDataIndex == 0 then
                -- 选择了比原属性评分低的
                tipid = 120307
            else
                -- 没有选择评分最高的
                tipid = 120308
            end
            _G.PopWindowManager:ShowAllTips(
                tipid,
                nil,
                function()
                    SelectResetAttr(selectIndex, type)
                end
            )
        end

    elseif go == self.go_table.aorbtn_left then
        local SelectResetAttr = function()
            require("GemstoneModel"):GetInstance():SelectResetAttr(
            self.data.uid,
            1,
            1,
            {},
            function()
                if self.resetType == 1 then
                    if self.call then
                        self.call()
                    end
                    self:Close()
                else
                    for _, v in pairs(self.consume) do
                        if not _G.StorageManager:GetInstance():CheckItemNew(v[1], v[3]) then
                            return
                        end
                    end
                    require("GemstoneModel"):GetInstance():Reset(
                        self.data.uid,
                        _G.table.count(self.data.reset),
                        _G.table.toArray(self.lockIndexList),
                        function()
                            for _, v in pairs(self.consume) do
                                _G.StorageManager:GetInstance():ConsumeItem(v[1], 0, v[3])
                            end
                            self:ShowDoublePanel()
                        end
                    )
                end
            end
        )
        end
        if self.maxSpuerDataIndex ~= 0 then
            _G.PopWindowManager:ShowAllTips(
                120310,
                nil,
                function()
                    SelectResetAttr()
                end
            )
        else
            SelectResetAttr()
        end

    end
end

return GemstoneResetAttrView
