---@class GemstoneUpStarView : UIBaseView	中文描述
---@field public go_table GemstoneUpStarView_GoTable GoTable
local GemstoneUpStarView = _G.BaseClass("GemstoneUpStarView", _G.UIBaseView)

function GemstoneUpStarView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GemstoneUpStarView:OnCreate()
    self:InitData()
end

function GemstoneUpStarView:OnEnable()
    if self.gemModel:UpGradeRedPoint() > 0 then
        self.lastPower = _G.PlayerModel:GetInstance():GetCorePower()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneAutoUpStarView.Name,
        function()
                local power = 0
                local cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
                for _, card in pairs(cards) do
                    card:CalcNowSumProp(_G.AttrFunType.Gemstone)
                    power = power + card.power
                end
                self:ShowPowerChange(self.lastPower, power)
                self.lastPower = power
                self:UpdateView()
            end
        )
    end
end

function GemstoneUpStarView:InitData()
    self.itemTable = {}
    self.newGem = require("GemstoneData").New()
    self.selectMaterialList = {}
    self.cardUidList = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
    self.gemModel = require("GemstoneModel"):GetInstance()
    self.go_table.scrollloopvectical_material:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:UpdateView()
end

function GemstoneUpStarView:UpdateView(notRandomSelect)
    if not notRandomSelect and (not self.selectGemData or self.selectGemData.cardUid == 0) then
        local gemList = self.gemModel:GetGemListInCard()
        for _, v in pairs(self.cardUidList) do
            for _, gem in pairs(gemList[v]) do
                if gem:CheckCanStarUp() then
                    self.selectGemData = gem
                    break
                end
            end
            if self.selectGemData and self.selectGemData.cardUid ~= 0 then
                break
            end
        end
    end
    self.selectMaterialList = {}

    for i = 1, 5 do
        self:UpdateItem(i, self.cardUidList[i] or 0)
    end
    self:UpdateUpStarPanel()
end

function GemstoneUpStarView:ShowPowerChange(lastPower, newPower)
    if lastPower == newPower then
        return
    end
    require "CommonTipManager".OpenPowerUpView(newPower, newPower - lastPower, true)
end

function GemstoneUpStarView:UpdateUpStarPanel()
    if not self.selectGemData then
        return
    end

    if not self.selectGemItem then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            self.go_table.obj_upGem,
            function(trans)
                if self:IsNil() then
                    return
                end
                self.selectGemItem = trans
                trans:ShowData(self.selectGemData, function()
                end)
            end
        )
    else
        self.selectGemItem:ShowData(self.selectGemData, function()
        end)
    end

    local upCount = 0
    local maxCount = self.selectGemData.cfg.star_limit - self.selectGemData.star
    maxCount = self.selectGemData.cfg.upgrade_equip == 0 and maxCount or maxCount + 1
    for _, v in pairs(self.selectMaterialList) do
        upCount = upCount + v.star + 1
    end
    self.go_table.aortext_value.text = _G.string.format("%s/%s", upCount, maxCount)
    if not self.materialItem then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            self.go_table.obj_materialRoot,
            function(trans)
                if self:IsNil() then
                    return
                end
                self.materialItem = trans
                trans:Show(self.selectGemData.sid, function()
                end)
            end
        )
    else
        self.materialItem:Show(self.selectGemData.sid, function() end)
    end

    local gemData = self.gemModel:GetGemDataByUid(self.selectGemData.uid)
    local cardUid = gemData and gemData.cardUid or 0
    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
    local cardSid = cardData and cardData.sid or 0
    local sid, star
    if self.selectGemData.cfg.upgrade_equip == 0 then
        sid = self.selectGemData.sid
        star = self.selectGemData.cfg.star_limit
    else
        sid = self.selectGemData.cfg.upgrade_equip
        star = 0
    end
    if not self.upEnditem then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            self.go_table.obj_endGem,
            function(trans)
                if self:IsNil() then
                    return
                end
                self.upEnditem = trans

                trans:Show(
                    sid,
                    function() end,
                    star,
                    self.selectGemData.level,
                    cardSid
                )
                trans:ShowCardBound(cardSid)
            end
        )
    else
        self.upEnditem:Show(
            sid,
            function() end,
            star,
            self.selectGemData.level
        )
        self.upEnditem:ShowCardBound(cardSid)
    end

    self:ShowAttr()
    self.materialDataList = self.gemModel:GetAllNotUseGemData()
    self.materialDataList = _G.table.chooseToArray(self.materialDataList, function(_, v)
        if v.sid == self.selectGemData.sid then
            return true
        end
        return false
    end)
    local count = #self.materialDataList
    self.go_table.scrollloopvectical_material:UpdateCount(count)
    self.go_table.obj_empty:SetActiveE(count == 0 and 1 or 0)
end

function GemstoneUpStarView:UpdateItem(index, cardUid)
    local tb = self.itemTable[index]
    if not tb then
        tb = _G.GetAutoGoTable(self.go_table["obj_item" .. index])
        self.itemTable[index] = tb
    end
    local data
    if cardUid and cardUid ~= 0 then
        tb.obj_head:SetActiveE(1)
        tb.obj_emptyHead:SetActiveE(0)
        data = self.gemModel:GetGemListByCardUid(cardUid)
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
        if not tb.head then
            tb.head = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_head,
                function(item)
                    if self:IsNil() then
                        return
                    end
                    tb.head = item
                    item:ShowCardData(cardData, function()
                    end)
                end
            )
        elseif tb.head ~= true then
            tb.head:ShowCardData(cardData, function()
            end)
        end
    else
        tb.obj_head:SetActiveE(0)
        tb.obj_emptyHead:SetActiveE(1)
        data = {}
    end
    for i = 1, 4 do
        local gem = _G.GetAutoGoTable(tb["obj_gem" .. i], _G.handlerbind(self, self.OnGemItemClick, data[i]))
        self:UpdateGemItem(gem, data[i])
    end
end

function GemstoneUpStarView:UpdateGemItem(tb, data)
    if data then
        tb.obj_select:SetActiveE(data.uid == self.selectGemData.uid and 1 or 0)
        tb.obj_empty:SetActiveE(0)
        tb.obj_gemRoot:SetActiveE(1)
        if not tb.item then
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemGemstoneBase,
                tb.obj_gemRoot,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    tb.item = trans
                    trans:ShowData(data, function()
                    end)
                end
            )
        else
            tb.item:ShowData(data, function()
            end)
        end
    else
        tb.obj_select:SetActiveE(0)
        tb.obj_empty:SetActiveE(1)
        tb.obj_gemRoot:SetActiveE(0)
    end
end

function GemstoneUpStarView:OnGemItemClick(_, _, data)
    if not data then
        return
    end
    if not data:CheckCanStarUp() then
        _G.PopWindowManager:GetInstance():ShowAllTips(2720108)
        return
    end
    self.selectGemData = data
    self.selectMaterialList = {}
    self:UpdateView(true)
end

function GemstoneUpStarView:ShowAttr()
    self.newGem:Copy(self.selectGemData)
    if self.selectGemData.cfg.upgrade_equip == 0 then
        self.newGem.star = self.selectGemData.cfg.star_limit
    else
        self.newGem.sid = self.selectGemData.cfg.upgrade_equip
        self.newGem.star = 0
    end
    local nowAttr = self.selectGemData:GetBaseAttr()
    local newAttr = self.newGem:GetBaseAttr()
    local index = 0
    for key, v in pairs(nowAttr) do
        index = index + 1
        local tb = _G.GetAutoGoTable(self.go_table["obj_attr" .. index])
        tb.aorimage_icon.SpriteName = _G.AttrTypeIcon[key]
        -- tb.aortext_name.text = _G.AttrType[key].des
        tb.aortext_now.text = _G.AttrType[key].des .. ":" .. _G.GameUtil.NumberWY(_G.Mathf.RoundToInt(nowAttr[key][1][3]))
        tb.aortext_next.text = _G.GameUtil.NumberWY(_G.Mathf.RoundToInt(newAttr[key][1][3]))
    end
    for i = 1, 4 do
        self.go_table["obj_attr" .. i]:SetActiveE(index >= i and 1 or 0)
    end
end

function GemstoneUpStarView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.materialDataList[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnMaterialClick, data))
    if self.selectMaterialList[data.uid] then
        tb.obj_select:SetActiveE(1)
    else
        tb.obj_select:SetActiveE(0)
    end
    if not tb.item then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            tb.obj_root,
            function(trans)
                if self:IsNil() then
                    return
                end
                tb.item = trans
                trans:ShowData(data, function()
                end)
            end
        )
    else
        tb.item:ShowData(data)
    end
end

function GemstoneUpStarView:OnMaterialClick(_, _, data)
    if self.selectMaterialList[data.uid] then
        self.selectMaterialList[data.uid] = nil
    else
        local upCount = 0
        local maxCount = self.selectGemData.cfg.star_limit - self.selectGemData.star
        maxCount = self.selectGemData.cfg.upgrade_equip == 0 and maxCount or maxCount + 1
        for _, v in pairs(self.selectMaterialList) do
            upCount = upCount + v.star + 1
        end
        if upCount >= maxCount then
            _G.PopWindowManager:GetInstance():ShowAllTips(2720101)
            return
        end
        self.selectMaterialList[data.uid] = data
    end
    self.go_table.scrollloopvectical_material:UpdateAllItem()
    self:UpdateUpStarPanel()
end

---按钮点击事件在这里派发
function GemstoneUpStarView:OnClickBtn(go)
    if go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 235)
    elseif go == self.go_table.aorbtn_upstar then
        if _G.table.count(self.selectMaterialList) > 0 then
            local lastPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectGemData
            .cardUid):GetPower()
            local materialList = {}
            local upCount = 0
            local maxCount = self.selectGemData.cfg.star_limit - self.selectGemData.star
            maxCount = self.selectGemData.cfg.upgrade_equip == 0 and maxCount or maxCount + 1
            for k, v in pairs(self.selectMaterialList) do
                _G.table.insert(materialList, k)
                upCount = upCount + v.star + 1
            end
            self.gemModel:UpStar(
                self.selectGemData.uid,
                materialList,
                _G.math.min(upCount, maxCount),
                function(msg)
                    if not msg.award then
                        msg.award = { item = {} }
                    end
                    _G.table.insert(msg.award.item, {type = { msg.gem.sid, msg.gem.uid }})
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    self.selectMaterialList = {}
                    self:UpdateView(true)
                    local newPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,
                        self.selectGemData.cardUid):GetPower()
                    self:ShowPowerChange(lastPower, newPower)
                end
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(2720102)
        end
    elseif go == self.go_table.aorbtn_autoUp then
        if self.gemModel:UpGradeRedPoint() == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(2720106)
        else
            self.lastPower = _G.PlayerModel:GetInstance():GetCorePower()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneAutoUpStarView.Name,
                function()
                    local power = 0
                    local cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
                    for _, card in pairs(cards) do
                        card:CalcNowSumProp(_G.AttrFunType.Gemstone)
                        power = power + card.power
                    end
                    self:ShowPowerChange(self.lastPower, power)
                    self.lastPower = power
                    self:UpdateView()
                end)
        end
    end
end

function GemstoneUpStarView:ShowPowerChange(lastPower, newPower)
    if lastPower == newPower then
        return
    end
    require "CommonTipManager".OpenPowerUpView(newPower, newPower - lastPower, true)
end

return GemstoneUpStarView
