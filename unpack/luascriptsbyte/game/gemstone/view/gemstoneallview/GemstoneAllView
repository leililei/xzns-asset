---@class GemstoneAllView : UIBaseView	中文描述
---@field public go_table GemstoneAllView_GoTable GoTable
local GemstoneAllView = _G.BaseClass("GemstoneAllView", _G.UIBaseView)

function GemstoneAllView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GemstoneAllView:OnCreate()
    self:InitData()
end

function GemstoneAllView:InitData()
    self.selectItemIndex = 1
    self.itemTable = {}
    self.go_table.scrollloopvectical_attr:InitItemData(0,_G.handler(self, self.RefreashAttrItem))
    self:UpdateView()
end

function GemstoneAllView:UpdateView()
    self.cardUidList = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
    self:UpdateSelectItem()
    for i = 1, 5 do
        self:UpdateItem(i, self.cardUidList[i] or 0)
    end
end

function GemstoneAllView:UpdateSelectItem()
    self:ShowHead(self.cardUidList[self.selectItemIndex])
    self.attrData = {}
    local data = require("GemstoneModel"):GetInstance():GetGemListByCardUid(self.cardUidList[self.selectItemIndex])
    local attr = {}
    local randomAttr = {}
    local cfg = _G.ConfigManager.gem_add_att_cfg
    for _, v in pairs(data) do
        for key, att in pairs(v:GetAttr()) do
            if not attr[key] then
                attr[key] = {}
            end
            for k, v in pairs(att) do
                attr[key][k] = v[3] + (attr[key][k] or 0)
            end
        end
        for _, v in pairs(v:GetRandomAttr()) do
            local key = cfg[v.sid].type_attribute
            local value = v.value
            if not randomAttr[key] then
                randomAttr[key] = 0
            end
            randomAttr[key] = randomAttr[key] + value
        end
    end
    for key, att in pairs(attr) do
        for type, value in pairs(att) do
            if key == "atk" or key == "def" or key == "max_hp" or key == "bre" then
                if type == 1 then
                    _G.table.insert(self.attrData, {key, _G.GameUtil.NumberWY(_G.Mathf.RoundToInt(value))})
                else
                    _G.table.insert(self.attrData, {key, value / 100 .. "%" })
                end
            else
                _G.table.insert(self.attrData, {key, value / 100 .. "%" })
            end
        end
    end

    for key, value in pairs(randomAttr) do
        _G.table.insert(self.attrData, {key, value / 100 .. "%"})
    end
    self.go_table.aortext_emptyAttr:SetActiveE(#self.attrData == 0 and 1 or 0)
    local count=#self.attrData%2==0 and #self.attrData/2 or (#self.attrData//2 +1)
    self.go_table.scrollloopvectical_attr:UpdateCount(count)
end

function GemstoneAllView:ShowHead(uid)
    if not uid or uid == 0 then
        self.go_table.obj_head:SetActiveE(0)
        self.go_table.aortext_name.text = ""
    else
        self.go_table.obj_head:SetActiveE(1)
        self.go_table.obj_head:ClearChildren()
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
        self.go_table.aortext_name.text = data:GetName()
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_head,
            function(item)
                if self:IsNil() then
                    return
                end
                item:ShowCardData(data, function()
                end)
            end
        )
    end
end

function GemstoneAllView:ShowPowerChange(lastPower, newPower)
    if lastPower == newPower then
        return
    end
    require "CommonTipManager".OpenPowerUpView(newPower, newPower - lastPower, true)
end

function GemstoneAllView:RefreashAttrItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.attrData[index*2-1]
    local data2 = self.attrData[index*2]
    tb.obj_bg:SetActiveE(index%2==0 and 0 or 1)
    tb.aortext_name.text = _G.AttrType[data[1]].des
    tb.aortext_value.text = data[2]
    if data2 then
        tb.aortext_name1.text = _G.AttrType[data2[1]].des
        tb.aortext_value1.text = data2[2]
    else
        tb.aortext_name1.text = ""
        tb.aortext_value1.text = ""
    end
end

function GemstoneAllView:UpdateItem(index, cardUid)
    local tb = self.itemTable[index]
    if not tb then
        tb = _G.GetAutoGoTable(self.go_table["obj_item" .. index], _G.handlerbind(self, self.OnItemClick, index))
        tb.rectTran = tb.aorimage_move:GetParent():GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        tb.canvas = tb.aorimage_move:GetParent():GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        tb.sortingOrder = tb.canvas.sortingOrder
        tb.cardUid = cardUid
        self.itemTable[index] = tb
        _G.SetEventTrigger(tb.aorimage_move, "onDragBegin", _G.handlerbind(self, self.OnItemDragBegin, tb))
        _G.SetEventTrigger(tb.aorimage_move, "onDrag", _G.handlerbind(self, self.OnItemDrag, tb))
        _G.SetEventTrigger(tb.aorimage_move, "onDragEnd", _G.handlerbind(self, self.OnItemDrogEnd, tb))
    end
    local data
    if cardUid and cardUid ~= 0 then
        tb.obj_head:SetActiveE(1)
        tb.obj_emptyHead:SetActiveE(0)
        data = require("GemstoneModel"):GetInstance():GetGemListByCardUid(cardUid)
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
        if not tb.head then
            tb.head = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_head,
                function(item)
                    if self:IsNil() then
                        return
                    end
                    tb.head = item
                    item:ShowCardData(cardData, function()
                    end)
                end
            )
        elseif tb.head ~= true then
            tb.head:ShowCardData(cardData, function()
            end)
        end
    else
        tb.obj_head:SetActiveE(0)
        tb.obj_emptyHead:SetActiveE(1)
    end
    local GemByProfess = require("GemstoneModel"):GetInstance():GetAllNotUseGemDataByProfessional()
    for i = 1, 4 do
        local gem = tb["gemTb" .. i]
        if not gem then
            gem = _G.GetAutoGoTable(tb["obj_gem" .. i], _G.handlerbind(self, self.OnGemItemClick, index, i))
            tb["gemTb" .. i] = gem
        end
        self:UpdateGemItem(gem, data and data[i] or nil, GemByProfess[i])
    end
end

function GemstoneAllView:UpdateGemItem(tb, data, GemByProfess)
    if data then
        tb.obj_empty:SetActiveE(0)
        tb.obj_gemRoot:SetActiveE(1)
        if not GemByProfess or not GemByProfess[1] or GemByProfess[1]:GetAttrScore() <= data:GetAttrScore() then
            tb.obj_replace:SetActiveE(0)
            tb.obj_redpoint:SetActiveE(0)
        else
            tb.obj_redpoint:SetActiveE(1)
            tb.obj_replace:SetActiveE(1)
        end
        tb.aortext_score:SetActiveE(1)
        tb.aortext_score.text = _G.GameUtil.NumberWY(_G.Mathf.RoundToInt(data:GetAttrScore()))
        if not tb.item then
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemGemstoneBase,
                tb.obj_gemRoot,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    tb.item = trans
                    trans:ShowData(data, function()
                    end)
                end
            )
        else
            tb.item:ShowData(data, function()
            end)
        end
    else
        if not GemByProfess or not GemByProfess[1] then
            tb.obj_redpoint:SetActiveE(0)
        else
            tb.obj_redpoint:SetActiveE(1)
        end
        tb.obj_empty:SetActiveE(1)
        tb.obj_gemRoot:SetActiveE(0)
        tb.obj_replace:SetActiveE(0)
        tb.aortext_score:SetActiveE(0)
    end
end

function GemstoneAllView:OnItemClick(_, _, itemIndex)
    if self.selectItemIndex == itemIndex then
        return
    end
    local uid = self.cardUidList[itemIndex]
    if not uid or uid == 0 then
        return
    end
    self.selectItemIndex = itemIndex
    self:UpdateSelectItem()
end

--- 宝石点击
function GemstoneAllView:OnGemItemClick(_, _, itemIndex, index)
    if not self.cardUidList[itemIndex] or self.cardUidList[itemIndex] == 0 then
        return
    end
    local data = require("GemstoneModel"):GetInstance():GetGemListByCardUid(self.cardUidList[itemIndex])[index]
    local lastPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.cardUidList[itemIndex]):GetPower()
    if data then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneTipView.Name,
            {
                data = data,
                btn = {
                    SwitchBtnCall = function()
                        local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,
                            self.cardUidList[itemIndex])
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneSubstituteView.Name,
                            { professional = index, gemData = data, cardData = cardData },
                            function()
                                self:UpdateView()
                                cardData:CalculatePower()
                                local newPower = cardData.power
                                self:ShowPowerChange(lastPower, newPower)
                            end)
                    end
                }
            }
        )
    else
        local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.cardUidList[itemIndex])
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneSubstituteView.Name,
            { professional = index, gemData = data, cardData = cardData },
            function()
                self:UpdateView()
                local newPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.cardUidList[itemIndex]):GetPower()
                self:ShowPowerChange(lastPower, newPower)
            end)
    end
end

function GemstoneAllView:AllLoad()
    local model = require("GemstoneModel"):GetInstance()
    local GemByProfess = model:GetAllNotUseGemDataByProfessional()

    for _, cardUid in pairs(self.cardUidList) do
        local lastPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid):GetPower()
        local dataList = model:GetGemListByCardUid(cardUid)
        local masaicList = {}
        for i = 1, 4 do
            if GemByProfess[i] and #GemByProfess[i] > 0  then
                if not dataList[i] then
                    --- 空槽位
                    local uid = _G.table.remove(GemByProfess[i], 1).uid
                    _G.table.insert(masaicList, { key = i, value = uid })
                elseif dataList[i]:GetAttrScore() < GemByProfess[i][1]:GetAttrScore() then
                    --- 评分比穿戴的高
                    local uid = GemByProfess[i][1].uid
                    _G.table.insert(masaicList, { key = i, value = uid })
                    GemByProfess[i][1] = dataList[i]
                    _G.SortList(
                        GemByProfess[i],
                        function(gem)
                            return gem:GetAttrScore()
                        end
                    )
                end
            end
        end
        if #masaicList > 0 then
            model:Mosaic(cardUid, masaicList, function()
                self:UpdateView()
                local newPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid):GetPower()
                self:ShowPowerChange(lastPower, newPower)
            end)
        end
    end

end

---按钮点击事件在这里派发
function GemstoneAllView:OnClickBtn(go)
    if go == self.go_table.aorbtn_load then
        self:AllLoad()
    elseif go == self.go_table.aorbtn_unload then
        local lastPower = {}
        for _, uid in pairs(self.cardUidList) do
            lastPower[uid] = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid):GetPower()
        end

        require("GemstoneModel"):GetInstance():AutoUnload(
            self.cardUidList,
            function(msg)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:UpdateView()
                for _, uid in pairs(self.cardUidList) do
                    local newPower = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid):GetPower()
                    self:ShowPowerChange(lastPower[uid], newPower)
                end
            end
        )
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 235)
    end
end

function GemstoneAllView:OnItemDragBegin(_, _, tb)
    if tb.cardUid == 0 then
        return
    end
    tb.canvas.sortingOrder = tb.sortingOrder + 5
end

function GemstoneAllView:OnItemDrag(_, ed, tb)
    if tb.cardUid == 0 then
        return
    end
    local x, y =
        _G.CS.UIUtils.ScreenPointToLocalPointInRectangle(
            tb.rectTran
        )
    tb.aorimage_move:SetLocalPosition(x, y)
    tb.obj_gem:SetLocalPosition(x,y)
end

function GemstoneAllView:OnItemDrogEnd(_, _, tb)
    if tb.cardUid == 0 then
        return
    end
    tb.canvas.sortingOrder = tb.sortingOrder - 5
    tb.aorimage_move:SetLocalPosition(-20,-2)
    tb.obj_gem:SetLocalPositionToZero()
    for i = 1, 5 do
        if self.itemTable[i].cardUid ~= 0 and self.itemTable[i].cardUid ~= tb.cardUid and _G.CS.UIUtils.CheckMousePointInRect(self.itemTable[i].gameObject) then
            require("GemstoneModel"):GetInstance():CardReplace(
                tb.cardUid,
                self.itemTable[i].cardUid,
                function()
                   self:UpdateView()
                end
            )
            break
        end
    end
end

return GemstoneAllView
