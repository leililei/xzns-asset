---@class GemstoneToggleView : UIBaseView  宝石功能切换界面
---@field go_table GemstoneToggleView_GoTable
---@field toggles table<string,GemstoneToggleView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local GemstoneToggleView = _G.BaseClass("GemstoneToggleView", _G.UIBaseView)

local keyName = {
    [1] = "all",
    [2] = "upLv",
    [3] = "upStar",
    [4] = "reset",
}

function GemstoneToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.GemstoneOpen, 0) == 0 then 
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.GemstoneOpen, 1)
        _G.Events:GetInstance():Broadcast(_G.GemstoneViewShow.Open)
    end
end

function GemstoneToggleView:UpdateView()
    if self.views then
        for _, view in pairs(self.views) do
            if view ~= 0 and view.gameObject:GetActiveSelf() == 1 and view.UpdateView then
                view:UpdateView()
            end
        end
    end
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function GemstoneToggleView:OnCreate(toggleIndex)
    self.order = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    self:InitToggles()
    self:InitTogglesFunctionUnlock()
    ---@type string
    local key
    if type(toggleIndex) == "string" then
        key = toggleIndex
    elseif type(toggleIndex) == "number" then
        key = keyName[toggleIndex]
    end
    key = key or self:GetDefaultToggleKey()
    local tog = self.go_table["toggle_" .. key]
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function GemstoneToggleView:SwitchToggle(toggleName)
    if self.curToggle ~= toggleName then
        local tog = self.go_table["toggle_" .. toggleName]
        if tog then
            tog.isOn = false
            tog.isOn = true
        end
    end
end

function GemstoneToggleView:OnDestroy()
    self:RemoveAllListener()
    self.views = nil
end

---根据功能获取当前可打开的toggle节点
function GemstoneToggleView:GetDefaultToggleKey()
    return "all"
end

function GemstoneToggleView:InitToggles()
    self.views = {}
    self.toggles = {
        all = _G.GetAutoGoTable(
            self.go_table.toggle_all,
            _G.handlerbind(self, self.OnClickToggle, "all", _G.handler(self, self.OnAll))
        ),
        upLv = _G.GetAutoGoTable(
            self.go_table.toggle_upLv,
            _G.handlerbind(self, self.OnClickToggle, "upLv", _G.handler(self, self.OnUpLv))
        ),
        upStar = _G.GetAutoGoTable(
            self.go_table.toggle_upStar,
            _G.handlerbind(self, self.OnClickToggle, "upStar", _G.handler(self, self.OnUpStar))
        ),
        reset = _G.GetAutoGoTable(
            self.go_table.toggle_reset,
            _G.handlerbind(self, self.OnClickToggle, "reset", _G.handler(self, self.OnReset))
        ),
    }
end

