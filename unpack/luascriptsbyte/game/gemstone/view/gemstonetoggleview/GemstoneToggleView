---监听Toggle点击事件
---@param key string
---@param callback function
function GemstoneToggleView:OnClickToggle(_, isOn, key, callback)
    local view = self.views[key]
    self.curToggle = key
    for k,v in pairs(self.toggles) do
        v.aorimage_isOn:SetActiveE(key==k and 1 or 0)
    end
    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function GemstoneToggleView:OnAll()
    local view = self.views.all
    if not view then
        self.views.all = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneAllView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function GemstoneToggleView:OnUpLv()
    local view = self.views.upLv
    if not view then
        self.views.upLv = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneUpLvView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function GemstoneToggleView:OnUpStar()
    local gemList = require("GemstoneModel"):GetInstance():GetGemListInCard()
    local flag, canUp = false, false
    for _, v in pairs(gemList) do
        for _, gem in pairs(v) do
            flag = true
            if gem:CheckCanStarUp() then
                canUp = true
                break
            end
        end
        if flag and canUp then
            break
        end
    end
    if not flag or not canUp then
        if not flag then
            _G.PopWindowManager:GetInstance():ShowAllTips(2720107)
        elseif not canUp then
            _G.PopWindowManager:GetInstance():ShowAllTips(2720108)
        end
        self.go_table.toggle_all.isOn = true
        return
    end
    local view = self.views.upStar
    if not view then
        self.views.upStar = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneUpStarView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

function GemstoneToggleView:OnReset()
    local gemList = require("GemstoneModel"):GetInstance():GetGemListInCard()
    local flag = false
    for _, v in pairs(gemList) do
        for _, gem in pairs(v) do
            if _G.table.count(gem.randomAttr) ~= 0 then
                flag = true
                break
            end
        end
    end
    if not flag then
        _G.PopWindowManager:GetInstance():ShowAllTips(2720103)
        self.go_table.toggle_all.isOn = true
        return
    end
    local view = self.views.reset
    if not view then
        self.views.reset = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneResetView.Name)
    elseif view ~= 0 then
        view:UpdateView()
    end
end

---加载界面
function GemstoneToggleView:OnUIOpened(name)
    ---@type string
    local key

    -- TODO: 根据实际UI配置名称映射到对应的key
    -- 示例：
    if name == _G.ConfigManager.ui_cfg.GemstoneAllView.Name then
        key = "all"
    elseif name == _G.ConfigManager.ui_cfg.GemstoneUpLvView.Name then
        key = "upLv"
    elseif name == _G.ConfigManager.ui_cfg.GemstoneUpStarView.Name then
        key = "upStar"
    elseif name == _G.ConfigManager.ui_cfg.GemstoneResetView.Name then
        key = "reset"
    end

    if not key then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if not view or self:IsNil() then
        if view then view:Close() end
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.order+1,
        false
    )
    self.views[key] = view
    if self.curToggle ~= key and view then
        view:Hide()
    end
end

---按钮点击事件在这里派发
function GemstoneToggleView:Close()
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            if type(view) ~= "number" then
                view:Close()
            end
        end
        self.views = nil
    end
    self.super.Close(self)
end

---按钮点击事件在这里派发
function GemstoneToggleView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return GemstoneToggleView