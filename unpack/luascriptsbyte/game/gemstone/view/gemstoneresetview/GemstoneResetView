---@class GemstoneResetView : UIBaseView	中文描述
---@field public go_table GemstoneResetView_GoTable GoTable
local GemstoneResetView = _G.BaseClass("GemstoneResetView", _G.UIBaseView)

function GemstoneResetView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.consumeList = _G.ConfigManager.discrete_cfg[153002]
end

---界面的入口函数
function GemstoneResetView:OnCreate()
    self:InitData()

    local resources = _G.ConfigManager.ui_cfg.GemstoneResetView.resources
    self:AddComponent(
        self.go_table.obj_gold,
        require("ResourceCompont").New(self.go_table.obj_gold, resources)
    )
end

function GemstoneResetView:InitData()
    self.itemTable = {}
    self.lockIndex = {}
    self.cardUidList = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
    self.randomTb = {
        _G.GetAutoGoTable(self.go_table.obj_random1, _G.handlerbind(self, self.LockAttr, 1)),
        _G.GetAutoGoTable(self.go_table.obj_random2, _G.handlerbind(self, self.LockAttr, 2)),
        _G.GetAutoGoTable(self.go_table.obj_random3, _G.handlerbind(self, self.LockAttr, 3))
    }
    self:UpdateView()
end

function GemstoneResetView:UpdateView(notRandomSelect)
    if not notRandomSelect and (not self.selectGemData or self.selectGemData.cardUid == 0) then
        self.selectGemData = nil
        local gemList = require("GemstoneModel"):GetInstance():GetGemListInCard()
        local cardUidList = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
        for _, uid in pairs(cardUidList) do
            for _, gem in pairs(gemList[uid]) do
                if _G.table.count(gem.randomAttr) ~= 0 then
                    self.selectGemData = gem
                    break
                end
            end
            if self.selectGemData then
                break
            end
        end
    end
    for i = 1, 5 do
        self:UpdateItem(i, self.cardUidList[i] or 0)
    end
    self:UpdateResetPanel()
end

function GemstoneResetView:UpdateResetPanel()
    if not self.selectGemData then
        return
    end
    local score = require("GemstoneModel"):GetInstance():GetAdditionsScore(self.selectGemData.randomAttr)
    self.go_table.aortext_score.text = _G.GetLangPackValue(90000010923, _G.string.AddColor(_G.GameUtil.NumberWY(score),"f89f49"))

    self.go_table.aortext_name.text = self.selectGemData:GetName()
    self.go_table.aortext_type.text = self.selectGemData:GetType()
    if not self.selectGemItem then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            self.go_table.obj_gemRoot,
            function(trans)
                if self:IsNil() then
                    return
                end
                self.selectGemItem = trans
                trans:ShowData(self.selectGemData, function()
                end)
            end
        )
    else
        self.selectGemItem:ShowData(self.selectGemData, function()
        end)
    end

    for i = 1, 3 do
        if self.selectGemData.randomAttr[i] then
            local attr = self.selectGemData.randomAttr[i]
            local cfg = _G.ConfigManager.gem_add_att_cfg[attr.sid]
            self.randomTb[i].gameObject:SetActiveE(1)
            self.randomTb[i].aortext_name.text = _G.GetLangPackValue(cfg.name)
            self.randomTb[i].aortext_value.text = (attr.value / 100) .. "%"
            self.randomTb[i].aortext_fanwei.text = _G.string.format("[%s%%~%s%%]", cfg.value[1] / 100,
                cfg.value[#cfg.value] / 100)
            self.randomTb[i].aorimage_lock.SpriteName = self.lockIndex[i] and "ui_zb_icon_suo_02" or  "ui_zb_icon_suo_01"
        else
            self.randomTb[i].gameObject:SetActiveE(0)
        end
    end

    self:UpdateConsume()
end

function GemstoneResetView:UpdateConsume()
    local lockNum = _G.table.count(self.lockIndex)
    local consume = {}
    for i = 1, #self.consumeList[lockNum + 1] // 2 do
        _G.table.insert(consume, {self.consumeList[lockNum + 1][i * 2 - 1], false, self.consumeList[lockNum + 1][i * 2]})
    end
    if not self.oneConsume then
        self.oneConsume = self:AddComponent(
            self.go_table.obj_oneConsume,
            require("ConsumeCompont").New(self.go_table.obj_oneConsume, consume, nil, nil, true, {textColorType = 4, showNow = false})
        )
    else
        self.oneConsume:RestRs(consume)
    end
    for i = 1, #consume do
        consume[i][3] = consume[i][3] * 5
    end
    if not self.fiveConsume then
        self.fiveConsume = self:AddComponent(
            self.go_table.obj_fiveConsume,
            require("ConsumeCompont").New(self.go_table.obj_fiveConsume, consume, nil, nil, true, {textColorType = 4, showNow = false})
        )
    else
        self.fiveConsume:RestRs(consume)
    end
end

function GemstoneResetView:UpdateItem(index, cardUid)
    local tb = self.itemTable[index]
    if not tb then
        tb = _G.GetAutoGoTable(self.go_table["obj_item" .. index])
        self.itemTable[index] = tb
    end
    local data
    if cardUid and cardUid ~= 0 then
        tb.obj_head:SetActiveE(1)
        tb.obj_emptyHead:SetActiveE(0)
        data = require("GemstoneModel"):GetInstance():GetGemListByCardUid(cardUid)
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
        if not tb.head then
            tb.head = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_head,
                function(item)
                    if self:IsNil() then
                        return
                    end
                    tb.head = item
                    item:ShowCardData(cardData, function()
                    end)
                end
            )
        elseif tb.head ~= true then
            tb.head:ShowCardData(cardData, function()
            end)
        end
    else
        tb.obj_head:SetActiveE(0)
        tb.obj_emptyHead:SetActiveE(1)
        data = {}
    end
    for i = 1, 4 do
        local gem = _G.GetAutoGoTable(tb["obj_gem" .. i], _G.handlerbind(self, self.OnGemItemClick, data[i]))
        self:UpdateGemItem(gem, data[i])
    end
end

function GemstoneResetView:UpdateGemItem(tb, data)
    if data then
        tb.obj_select:SetActiveE(data.uid == self.selectGemData.uid and 1 or 0)
        tb.obj_empty:SetActiveE(0)
        tb.obj_gemRoot:SetActiveE(1)
        if not tb.item then
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemGemstoneBase,
                tb.obj_gemRoot,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    tb.item = trans
                    trans:ShowData(data, function()
                    end)
                end
            )
        else
            tb.item:ShowData(data, function()
            end)
        end
    else
        tb.obj_select:SetActiveE(0)
        tb.obj_empty:SetActiveE(1)
        tb.obj_gemRoot:SetActiveE(0)
    end
end

function GemstoneResetView:OnGemItemClick(_, _, data)
    if not data then
        return
    end
    if _G.table.count(data.randomAttr) == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(2720103)
        return
    end
    self.lockIndex = {}
    self.selectGemData = data
    self:UpdateView(true)
end

function GemstoneResetView:LockAttr(_, _, index)
    for _, v in pairs(self.selectGemData.randomAttr) do
        if v.index == index then
            if self.lockIndex[index] then
                self.lockIndex[index] = nil
                self.randomTb[index].aorimage_lock.SpriteName = "ui_zb_icon_suo_01"
            else
                if  _G.table.count(self.selectGemData.randomAttr) - _G.table.count(self.lockIndex) <= 1 then
                    return
                end
                self.lockIndex[index] = index
                self.randomTb[index].aorimage_lock.SpriteName = "ui_zb_icon_suo_02"
            end
        end
    end
    self:UpdateConsume()
end

---按钮点击事件在这里派发
function GemstoneResetView:OnClickBtn(go)
    if go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 235)
    elseif go == self.go_table.aorbtn_reset then
        local lockNum = _G.table.count(self.lockIndex)
        for i = 1, #self.consumeList[lockNum + 1] // 2 do
            if not _G.StorageManager:GetInstance():CheckItemNew(self.consumeList[lockNum + 1][i * 2 - 1], self.consumeList[lockNum + 1][i * 2]) then
                return
            end
        end
        require("GemstoneModel"):GetInstance():Reset(
            self.selectGemData.uid,
            1,
            _G.table.toArray(self.lockIndex),
            function()
                for i = 1, #self.consumeList[lockNum + 1] // 2 do
                    _G.StorageManager:GetInstance():ConsumeItem(self.consumeList[lockNum + 1][i * 2 - 1], 0,self.consumeList[lockNum + 1][i * 2])
                end
                local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectGemData.cardUid)
                local lastPower = data.power
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneResetAttrView.Name,
                    self.selectGemData,
                    self.lockIndex,
                    function()
                        self:UpdateResetPanel()
                        self:ShowPowerChange(lastPower, data.power)
                    end
                )
            end
        )
    elseif go == self.go_table.aorbtn_doubleRest then
        local lockNum = _G.table.count(self.lockIndex)
        for i = 1, #self.consumeList[lockNum + 1] // 2 do
            if not _G.StorageManager:GetInstance():CheckItemNew(self.consumeList[lockNum + 1][i * 2 - 1], self.consumeList[lockNum + 1][i * 2] * 5) then
                return
            end
        end
        require("GemstoneModel"):GetInstance():Reset(
            self.selectGemData.uid,
            2,
            _G.table.toArray(self.lockIndex),
            function()
                for i = 1, #self.consumeList[lockNum + 1] // 2 do
                    _G.StorageManager:GetInstance():ConsumeItem(self.consumeList[lockNum + 1][i * 2 - 1], 0,self.consumeList[lockNum + 1][i * 2] * 5)
                end
                local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.selectGemData.cardUid)
                local lastPower = data.power
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneResetAttrView.Name,
                    self.selectGemData,
                    self.lockIndex,
                    function()
                        self:UpdateResetPanel()
                        self:ShowPowerChange(lastPower, data.power)
                    end
                )
            end
        )
    end
end

function GemstoneResetView:ShowPowerChange(lastPower, newPower)
    if lastPower == newPower then
        return
    end
    require "CommonTipManager".OpenPowerUpView(newPower, newPower - lastPower, true)
end

return GemstoneResetView
