---@class GemstoneAutoUpStarView : UIBaseView	中文描述
---@field public go_table GemstoneAutoUpStarView_GoTable GoTable
local GemstoneAutoUpStarView = _G.BaseClass("GemstoneAutoUpStarView", _G.UIBaseView)

function GemstoneAutoUpStarView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GemstoneAutoUpStarView:OnCreate(call)
    self.call = call
    self.go_table.scrollloopvectical_gem:InitItemData(0, _G.handler(self, self.RefreshItem))

    self:InitData()
end

function GemstoneAutoUpStarView:InitData()
    self.sendGemList, self.showGemList = self:GetAllUpStarGem()
    for k, v in pairs(self.showGemList) do
        if _G.table.count(v) > 0 then
            self.go_table["toggle_type" .. k].isOn = false
            self.go_table["toggle_type" .. k].isOn = true
            return
        end
    end
    self.go_table.toggle_type1.isOn = false
    self.go_table.toggle_type1.isOn = true
end

function GemstoneAutoUpStarView:RefreshItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.showGemList[self.selectType][index]
    if not tb.item then
        tb.item = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            tb.gameObject,
            function(trans)
                if self:IsNil() then
                    return
                end
                tb.item = trans
                trans:Show(
                    data.sid,
                    function() end,
                    data.star
                )
                trans:ShowLevel(false)
                local card = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, data.cardUid)
                trans:ShowCardBound(card.sid)
            end
        )
    elseif tb.item ~= true then
        tb.item:Show(
            data.sid,
            function() end,
            data.star
        )
        local card = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, data.cardUid)
        tb.item:ShowCardBound(card.sid)
        tb.item:ShowLevel(false)
    end
end

function GemstoneAutoUpStarView:SwitchType(type)
    self.selectType = type
    self.go_table.scrollloopvectical_gem:UpdateCount(_G.table.count(self.showGemList[type]))
end

---按钮点击事件在这里派发
function GemstoneAutoUpStarView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_up then
        if not _G.table.isEmptyOrNil(self.sendGemList) then
            local data = {}
            for _, v in pairs(self.sendGemList) do
                for _, gem in pairs(v) do
                    _G.table.insert(data, { info = { gem_uid = gem.uid, consume_gem_uids = gem.food }, upStar = gem.upStar, cardUid = gem.cardUid or 0 })
                end
            end
            require("GemstoneModel"):GetInstance():AllUpStar(data, function(msg)
                local award = {award = {item = {}}}
                for _, v in pairs(msg.gem) do
                    _G.table.insert(award.award.item, {type = { v.sid, v.uid }})
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, award)
                if self.call then
                    self.call()
                end
            end)
        end
        self:Close()
    elseif go == self.go_table.toggle_type1 then
        self:SwitchType(1)
    elseif go == self.go_table.toggle_type2 then
        self:SwitchType(2)
    elseif go == self.go_table.toggle_type3 then
        self:SwitchType(3)
    elseif go == self.go_table.toggle_type4 then
        self:SwitchType(4)
    end
end

function GemstoneAutoUpStarView:GetAllUpStarGem()
    local model = require("GemstoneModel"):GetInstance()
    local cfg = _G.ConfigManager.gem_cfg
    local showGemList = { {}, {}, {}, {} }
    local sendGemList = { {}, {}, {}, {} }
    local gemInCardList = model:GetGemListInCard()
    local foodList = model:GetAllNotUseGemData()
    local foodDict = {}
    --- 高星宝石被消耗可能会产生返回宝石，这些也要计算
    local nilFood = {}
    for _, v in pairs(foodList) do
        if not foodDict[v.sid] then
            foodDict[v.sid] = {}
        end
        _G.table.insert(foodDict[v.sid], { sid = v.sid, uid = v.uid, star = v.star, professional = v.professional , score = v:GetAttrScore()})
    end

    for _, v in pairs(foodDict) do
        _G.SortList(v, function(gem)
            return gem.score
        end)
    end

    local gemInCardBySid = {}
    for _, v in pairs(gemInCardList) do
        for _, gem in pairs(v) do
            if gem:CheckCanStarUp() then
                if not gemInCardBySid[gem.sid] then
                    gemInCardBySid[gem.sid] = {}
                end
                _G.table.insert(gemInCardBySid[gem.sid],
                    { sid = gem.sid, uid = gem.uid, star = gem.star, professional = gem.professional, cardUid = gem.cardUid }) 
            end
        end
    end

    local AddShowList = function(gemList, showList, gem, dict)
        local maxStarNum = cfg[gem.sid].star_limit - gem.star
        maxStarNum = cfg[gem.sid].upgrade_equip == 0 and maxStarNum or maxStarNum + 1
        local foods = {}
        while true do
            if maxStarNum <= 0 then
                if not nilFood[gem.sid] then
                    nilFood[gem.sid] = 0
                end
                -- 将溢出的宝石存起来
                nilFood[gem.sid] = nilFood[gem.sid] - maxStarNum
                break
            end
            local uid
            if #dict[gem.sid] > 0 then
                local food = _G.table.remove(dict[gem.sid])
                uid = food.uid
                maxStarNum = maxStarNum - food.star - 1
                if showList[gem.professional][uid] then
                    showList[gem.professional][uid] = nil
                end
            elseif nilFood[gem.sid] and nilFood[gem.sid] > 0 then
                uid = nil
                nilFood[gem.sid] = nilFood[gem.sid] - 1
                maxStarNum = maxStarNum - 1
            else
                break
            end
            _G.table.insert(foods, uid)
        end
        local sid, star
        if maxStarNum > 0 then
            sid = gem.sid
            star = cfg[gem.sid].star_limit - maxStarNum
            star = cfg[gem.sid].upgrade_equip == 0 and star or star + 1
        else
            sid = cfg[gem.sid].upgrade_equip == 0 and gem.sid or cfg[gem.sid].upgrade_equip
            star = cfg[gem.sid].upgrade_equip == 0 and gem.sid or 0
        end
        if gem.uid == 0 then
            -- uid 为0 的是高星级被吃后返还的宝石，因为当升星轮到返还的宝石时，意味着这是当前sid最后一个升星宝石了，所以直接拿sid作为key
            _G.table.insert(gemList[gem.professional], { sid = sid, uid = gem.uid, food = foods, star = star, cardUid = 0 })

            showList[gem.professional][gem.sid] = { sid = sid, uid = gem.uid, food = foods, star = star, cardUid = 0 }
        else
            _G.table.insert(gemList[gem.professional], { sid = sid, uid = gem.uid, food = foods, star = star, cardUid = gem.cardUid or 0 })

            showList[gem.professional][gem.uid] = { sid = sid, uid = gem.uid, food = foods, star = star, cardUid = gem.cardUid or 0 }
        end
        return sid
    end

    local sidList = _G.table.keys(cfg)
    _G.SortList(sidList, function(sid)
        return -sid
    end)
    for _, sid in pairs(sidList) do
        if not _G.table.isEmptyOrNil(gemInCardBySid[sid]) then
            for _, gem in pairs(gemInCardBySid[sid]) do
                if (foodDict[gem.sid] and #foodDict[gem.sid] > 0) or (nilFood[gem.sid] and nilFood[gem.sid] > 0) then
                    local id = AddShowList(sendGemList, showGemList, gem, foodDict)
                    if id ~= gem.sid then
                        -- 品质提升了
                        if not gemInCardBySid[id] then
                            gemInCardBySid[id] = {}
                        end
                        _G.table.insert(gemInCardBySid[id],
                            { sid = id, uid = gem.uid, star = 0, professional = gem.professional, cardUid = gem.cardUid })
                    end
                end
            end
        end
        while true do
            if foodDict[sid] and #foodDict[sid] > 1 then
                local gem = _G.table.remove(foodDict[sid], 1)
                local id = AddShowList(sendGemList,showGemList, gem, foodDict)
                if id ~= gem.sid then
                    if not foodDict[id] then
                        foodDict[id] = {}
                    end
                    _G.table.insert(foodDict[id], { sid = id, uid = gem.uid, star = 0, professional = gem.professional })
                end
            elseif nilFood[sid] and nilFood[sid] > 1 then
                nilFood[sid] = nilFood[sid] - 1
                local id = AddShowList(sendGemList, showGemList, { sid = sid, uid = 0, star = 0, professional = cfg[sid].professional },
                    foodDict)
                if id ~= sid then
                    if not nilFood[id] then
                        nilFood[id] = 0
                    end
                    nilFood[id] = nilFood[sid] + 1
                end
            else
                break
            end
        end
    end
    for i = 1, 4 do
        showGemList[i] = _G.table.toArray(showGemList[i])
        _G.SortList(
            showGemList[i],
            function(gem)
                return -gem.sid
            end
        )
    end
    return sendGemList, showGemList
end

return GemstoneAutoUpStarView
