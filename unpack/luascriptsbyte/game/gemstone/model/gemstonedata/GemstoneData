local TypeName = {
    [1] = _G.GetLangPackValue(93010010015),
    [2] = _G.GetLangPackValue(93010010016),
    [3] = _G.GetLangPackValue(93010010017),
    [4] = _G.GetLangPackValue(93010010018)
