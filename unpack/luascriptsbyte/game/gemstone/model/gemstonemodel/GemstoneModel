--- 槽位上的宝石的数量
local slotGemstoneNum = 4

---@class GemstoneModel : GameDataModelBase	中文描述
---@field public gemstoneList table<GemstoneData> 宝石数据
---@field public gemstoneInCard table<table<GemstoneData>> 槽位上的宝石
---@field public resonanceGemstone table<GemstoneData> 共鸣槽位的宝石
local GemstoneModel = _G.BaseClass("GemstoneModel", _G.GameDataModelBase)
---创建对象时,入口构造函数
function GemstoneModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Gemstone
    self.gemstoneList = {}
    self.gemstoneInCard = {}
    self.resonanceGemstone = {}
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.p2c_gem_change.Cmd, self.OnCardChange, self)
end

function GemstoneModel:GetDataFormServer()
    self:InitGemData()
    self.super.ParseData(self)
end

function GemstoneModel:InitGemData()
    local cardUidList = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
    for _, v in pairs(cardUidList) do
        self.gemstoneInCard[v] = {}
    end
    local data = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Gemstone)
    for _, gem in pairs(data) do
        self.gemstoneList[gem.uid] = gem
        if gem.cardUid ~= 0 then
            if not self.gemstoneInCard[gem.cardUid] then
                self.gemstoneInCard[gem.cardUid] = {}
            end
            self.gemstoneInCard[gem.cardUid][gem.professional] = gem
        end
    end
    self:UpdateResonanceGem(true)
end

---更新共鸣宝石
function GemstoneModel:UpdateResonanceGem()
    for i = 1, slotGemstoneNum do
        local gem
        local minGrade, minStar = 99, 99
        -- 等级单独计算
        local minLevel = 9999
        for _, v in pairs(self.gemstoneInCard) do
            if not v[i] then
                gem = nil
                minLevel = 0
                break
            else
                if v[i].level < minLevel then
                    minLevel = v[i].level
                end
                if v[i].grade < minGrade then
                    minGrade = v[i].grade
                    minStar = v[i].star
                    gem = v[i]
                elseif v[i].grade == minGrade and v[i].star < minStar then
                    minGrade = v[i].grade
                    minStar = v[i].star
                    gem = v[i]
                end
            end
        end
        local newGem = _G.DeepCopy(gem)
        if newGem then
            newGem.cardUid = 0
            newGem:SetLevel(minLevel)
            newGem.isResonance = true
        end
        if self.resonanceGemstone[i] then
            self.resonanceGemstone[i]:Dispose()
        end
        self.resonanceGemstone[i] = newGem
    end
end

---销毁对象时,析构函数
function GemstoneModel:Dispose()
    for _, v in pairs(self.gemstoneList) do
        v:Dispose()
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.p2c_gem_change.Cmd, self.OnCardChange, self)
end

function GemstoneModel:OnCardChange(msg)
    local lastUid, nowUid
    for _, gem in pairs(msg.gem) do
        if not lastUid then
            lastUid = self.gemstoneList[gem.uid].cardUid
        end
        if not nowUid then
            nowUid = gem.card_uid
        end
        self.gemstoneList[gem.uid].cardUid = gem.card_uid
    end
    self.gemstoneInCard[nowUid] = self.gemstoneInCard[lastUid]
    self.gemstoneInCard[lastUid] = nil
    self:UpdateResonanceGem()
end

