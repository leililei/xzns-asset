--region 红点接口

function GemstoneModel:ReplaceRedPoint()
    local gemList = {}
    for _, gem in pairs(self.gemstoneList) do
        if not gemList[gem.professional] then
            gemList[gem.professional] = {}
        end
        if gem.cardUid == 0 then
            _G.table.insert(gemList[gem.professional], gem)
        end
    end
    for _, v in pairs(gemList) do
        _G.SortList(v,function (item)
            return item:GetAttrScore()
        end)
    end
    for _, v in pairs(self.gemstoneInCard) do
        for i = 1, 4 do
            if not v[i] and gemList[i] and gemList[i][1] then
                return 1
            else
                if gemList[i] and gemList[i][1] and v[i]:GetAttrScore() < gemList[i][1]:GetAttrScore() then
                    return 1
                end
            end
        end
    end
    return 0
end

function GemstoneModel:UpLvRedPoint()
    local maxLv = 10
    local count = 0
    local cardUidList = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
    local material = {}
    local lvList = {}
    local level_cfg = _G.ConfigManager.gem_level_cfg

    for _, v in pairs(cardUidList) do
        local gemDataList = self:GetGemListByCardUid(v)
        lvList[v] = {}
        for i, gem in pairs(gemDataList) do
            lvList[v][i] = gem.level
        end
    end

    local function getMinLv()
        local lv = 99999
        for _, list in pairs(lvList) do
            for i = 1, 4 do
                local num = list[i] or 0
                if num < lv then
                    lv = num
                end
            end
        end
        return lv
    end

    local curMinLv = getMinLv()

    for _, cardUid in pairs(cardUidList) do
        if cardUid and cardUid ~= 0 then
            local gemDataList = self:GetGemListByCardUid(cardUid)
            for _ = 1, maxLv do
                local upLv = false
                for k, v in pairs(lvList[cardUid]) do
                    local gemData = gemDataList[k]
                    if v >= gemData.cfg.strengthen_level then
                    elseif level_cfg[v + 1].min_level > curMinLv or not _G.GlobalConditionManager.CheckConditionArrays(level_cfg[v + 1].condition) then
                    else
                        local flag = true
                        local AddMater = {}
                        local nextCfg = level_cfg[v + 1]
                        for _, mater in pairs(nextCfg.material_1) do
                            AddMater[mater[1]] = mater[2]
                        end
                        for _, mater in pairs(level_cfg[v].material_1) do
                            AddMater[mater[1]] = AddMater[mater[1]] - mater[2]
                        end
                        for sid, num in pairs(AddMater) do
                            local sum = material[sid] or 0
                            if not _G.StorageManager:GetInstance():CheckItem(sid, num + sum) then
                                flag = false
                                break
                            end
                        end
                        if flag then
                            for sid, num in pairs(AddMater) do
                                material[sid] = (material[sid] or 0) + num
                            end
                            lvList[cardUid][k] = v + 1
                            upLv = true
                            if v == curMinLv then
                                curMinLv = getMinLv()
                            end
                        end
                    end
                end
                if not upLv then
                    break
                end
                count = count + 1
                if count >= 10 then
                    return 1
                end
            end
        end
    end
    return 0
end

function GemstoneModel:UpGradeRedPoint()
    local gemInCardList = self:GetGemListInCard()
    local foodList = self:GetAllNotUseGemData()

    local foodBySid = {}
    for _, v in pairs(foodList) do
        if v:CheckCanStarUp() then
            -- 用来判断是否为最高品质的最高星级
            foodBySid[v.sid] = 1 + (foodBySid[v.sid] or 0)
            if foodBySid[v.sid] > 1 then
                return 1
            end
        end
    end

    for _, v in pairs(gemInCardList) do
        for _, gem in pairs(v) do
            if gem:CheckCanStarUp() then
                if foodBySid[gem.sid] then
                    return 1
                end
            end
        end
    end

    return 0
end

