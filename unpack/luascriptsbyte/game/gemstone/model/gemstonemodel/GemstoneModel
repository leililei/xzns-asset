--- 获取角色装备的宝石属性
function GemstoneModel:GetGemAttrByCardUid(cardUid)
    local gemList = self:GetGemListByCardUid(cardUid)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()

    for _, gem in pairs(gemList) do
        local attr = gem:GetAttr()
        for _, v in pairs(attr) do
            for _, value in pairs(v) do
                local type = _G.tonumber(value[2]) == 2 and _G.AttCountType.basePercent or _G.AttCountType.other
                attribute:AddValueByName(
                    value[1],
                    AttributeClassManager:GetValueWithName(value[1], value[3], value[2]),
                    false,
                    type
                )
            end
        end
        local randomAttr = gem:GetRandomAttr()
        local cfg = _G.ConfigManager.gem_add_att_cfg
        for _, v in pairs(randomAttr) do
            local key = cfg[v.sid].type_attribute
            local value = v.value
            attribute:AddValueByName(
                key,
                AttributeClassManager:GetValueWithName(key, value, "2"),
                false,
                _G.AttCountType.basePercent
            )
        end
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

function GemstoneModel:GetAllUpStarGem()
    local showGemList = { {}, {}, {}, {} }
    local gemInCardList = self:GetGemListInCard()
    local foodList = self:GetAllNotUseGemData()
    local foodDict = {}
    for _, v in pairs(foodList) do
        if not foodDict[v.sid] then
            foodDict[v.sid] = {}
        end
        _G.table.insert(foodDict[v.sid], v)
    end

    local AddShowList = function(showGemList, gem, dict)
        local maxStarNum = gem.cfg.star_limit - gem.star
        maxStarNum = gem.cfg.upgrade_equip == 0 and maxStarNum or maxStarNum + 1
        local foods = {}
        while true do
            if maxStarNum <= 0 then
                break
            end
            if #dict[gem.sid] <= 0 then
                break
            end
            local food = _G.table.remove(dict[gem.sid], 1)
            maxStarNum = maxStarNum - food.star - 1
            _G.table.insert(foods, food.uid)
        end
        local sid, star
        if maxStarNum > 0 then
            sid = gem.sid
            star = gem.cfg.star_limit - maxStarNum + 1
        else
            sid = gem.cfg.upgrade_equip == 0 and gem.sid or gem.cfg.upgrade_equip
            star = 0
        end
        _G.table.insert(showGemList[gem.professional],
            { sid = sid, uid = gem.uid, food = foods, star = star })
    end

    for _, list in pairs(gemInCardList) do
        for _, gem in pairs(list) do
            if foodDict[gem.sid] and #foodDict[gem.sid] > 0 then
                AddShowList(showGemList, gem, foodDict)
            end
        end
    end

    local temp = {}
    for _, v in pairs(foodDict) do
        if #v >= 2 then
            _G.table.insert(temp, v)
        end
    end
    for i = 1, #temp do
        if temp[i] and #temp[i] > 0 then
            local gem = _G.table.remove(temp[i], 1)
            AddShowList(showGemList, gem, foodDict)
        end
    end
    return showGemList
end

---镶嵌
---@param gemList table<table<professional,gemUid>> 镶嵌列表
function GemstoneModel:Mosaic(cardUid, gemList, call)
    require("GemstoneNet"):GetInstance():Mosaic(
        { mosaics = { { hero_uid = cardUid, mosaic = gemList } } }, function(msg)
            if msg.ack ~= 1 then
                return
            end
            for _, v in pairs(gemList) do
                local gem = self:GetGemDataByUid(v.value)
                gem.cardUid = cardUid
                if not self.gemstoneInCard[cardUid] then
                    self.gemstoneInCard[cardUid] = {}
                end
                if self.gemstoneInCard[cardUid][v.key] then
                    gem.level = self.gemstoneInCard[cardUid][v.key].level
                    self.gemstoneInCard[cardUid][v.key].cardUid = 0
                    self.gemstoneInCard[cardUid][v.key].level = 0
                end
                self.gemstoneInCard[cardUid][v.key] = gem
            end
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
            cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            self:UpdateResonanceGem()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneReplace.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpLv.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpGrade.id)
            if call then
                call(msg)
            end
        end
    )
end

---卸下宝石
function GemstoneModel:Upload(cardUid, professional, call)
    require("GemstoneNet"):GetInstance():Unload(
        { hero_uid = cardUid, slot_index = professional },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local gemList = self:GetGemListByCardUid(cardUid)
            local gem = gemList[professional]
            gemList[professional] = nil
            gem.cardUid = 0
            gem.level = 0
            self:UpdateResonanceGem()
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Gemstone)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneReplace.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpLv.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpGrade.id)
            if call then
                call(msg)
            end
        end
    )
end

---宝石替换
function GemstoneModel:Replace(cardUid1, cardUid2, professional, call)
    require("GemstoneNet"):GetInstance():Replace(
        { hero_uid = cardUid1, target_hero_uid2 = cardUid2, slot_index = professional },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local gem = self.gemstoneInCard[cardUid1][professional]
            if gem then
                gem.cardUid = cardUid2
            end
            self.gemstoneInCard[cardUid2][professional].cardUid = cardUid1
            self.gemstoneInCard[cardUid1][professional] = self.gemstoneInCard[cardUid2][professional]
            self.gemstoneInCard[cardUid2][professional] = gem
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid1)
            cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid2)
            cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            if call then
                call(msg)
            end
        end
    )
end

---两个卡牌相互交换
function GemstoneModel:CardReplace(cardUid1, cardUid2, call)
    require("GemstoneNet"):GetInstance():CardReplace(
        { hero_uid = cardUid1, target_hero_uid2 = cardUid2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local gemList1 = self.gemstoneInCard[cardUid1] or {}
            local gemList2 = self.gemstoneInCard[cardUid2] or {}
            for _, gem in pairs(gemList1) do
                gem.cardUid = cardUid2
            end
            for _, gem in pairs(gemList2) do
                gem.cardUid = cardUid1
            end
            self.gemstoneInCard[cardUid1] = gemList2
            self.gemstoneInCard[cardUid2] = gemList1
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid1)
            cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid2)
            cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            if call then
                call(msg)
            end
        end
    )
end

---一键卸下
function GemstoneModel:AutoUnload(cardUidList, call)
    require("GemstoneNet"):GetInstance():AutoUnload(
        { hero_uid = cardUidList },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            for _, uid in pairs(cardUidList) do
                local gemList = self.gemstoneInCard[uid] or {}
                for _, gem in pairs(gemList) do
                    gem.cardUid = 0
                    gem.level = 0
                end
                self.gemstoneInCard[uid] = {}
            end
            for _, uid in pairs(cardUidList) do
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid)
                cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            end
            self:UpdateResonanceGem()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneReplace.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpLv.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpGrade.id)
            if call then
                call(msg)
            end
        end
    )
end

