---升级
---@param upInfo table<table<key,value>> key:professional,类型；value:toLv,到达的等级
function GemstoneModel:LevelUp(cardUid, upInfo, call)
    require("GemstoneNet"):GetInstance():Upgrade(
        { card_uid = cardUid, info = upInfo },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local minLevel = 9999
            for _, info in pairs(upInfo) do
                self.gemstoneInCard[cardUid][info.key]:SetLevel(info.value)
                minLevel = _G.math.min(minLevel, info.value)
            end
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
            cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            self:UpdateResonanceGem()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpLv.id)
            _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                    _G.ActiveTaskEnum.ConditionEnum.Gemstone.HasGemWithLevelHistory,
                    minLevel
                },
                #upInfo
            )
            if call then
                call(msg)
            end
        end
    )
end

---升星
---@param uid number 宝石uid
---@param consumeUidList list<number> 消耗的宝石uid
---@param upStar number 指定的星级
function GemstoneModel:UpStar(uid, consumeUidList,upStar , call)
    require("GemstoneNet"):GetInstance():UpStar(
        { gem_uid = uid, consume_gem_uids = consumeUidList },
        function(msg)
            for _, v in pairs(consumeUidList) do
                local gem = self.gemstoneList[v]
                _G.StorageManager:GetInstance():ConsumeItem(gem.sid, v, 1)
                gem:Dispose()
                self.gemstoneList[v] = nil
            end
            self.gemstoneList[uid]:StarUp(upStar)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            local cardUid = self.gemstoneList[uid].cardUid
            if cardUid ~= 0 then
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
                cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            end
            self:UpdateResonanceGem()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneReplace.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpGrade.id)
            _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                    _G.ActiveTaskEnum.ConditionEnum.Gemstone.HasGemWithGradeHistory,
                    self.gemstoneList[uid].grade
                },
                1
            )
            if call then
                call(msg)
            end
        end
    )
end

---一键升星
function GemstoneModel:AllUpStar(data, call)
    local db = {}
    for _, v in pairs(data) do
        _G.table.insert(db, v.info)
    end
    require("GemstoneNet"):GetInstance():OneUpStar(
        {infos = db},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            for _, info in pairs(data) do
                for _, v in pairs(info.info.consume_gem_uids) do
                    local gem = self.gemstoneList[v]
                    if gem then
                        _G.StorageManager:GetInstance():ConsumeItem(gem.sid, v, 1)
                        gem:Dispose()
                        self.gemstoneList[v] = nil
                    end
                end
                -- self.gemstoneList[info.info.gem_uid]:StarUp(info.upStar)
                if info.cardUid ~= 0 then
                    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, info.cardUid)
                    cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
                end
                _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                        _G.ActiveTaskEnum.ConditionEnum.Gemstone.HasGemWithGradeHistory,
                        self.gemstoneList[info.info.gem_uid].grade
                    },
                    1
                )
            end
            for _, v in pairs(msg.gem) do
                local gem = self.gemstoneList[v.uid]
                gem:Parse(v)
            end
            self:UpdateResonanceGem()
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneReplace.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GemstoneUpGrade.id)
            if call then
                call(msg)
            end
        end
    )
end

---洗炼
---@param uid number 宝石uid
---@param type number 洗炼类型 1：单次洗练，2：五次洗练
---@param lock_index list<number> 锁定的词条索引
function GemstoneModel:Reset(uid, type, lock_index, call)
    require("GemstoneNet"):GetInstance():ResetAttr(
        { gem_uid = uid, type = type, lock_index = lock_index },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local gem = self.gemstoneList[uid]
            for _, v in pairs(msg.attr) do
                _G.SortList(
                    v.addition,
                    function(a)
                        return -a.index
                    end
                )
            end
            gem.reset = msg.attr
            local cardUid = gem.cardUid
            if cardUid ~= 0 then
                local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
                cardData:CalcNowSumProp(_G.AttrFunType.Gemstone)
            end
            if call then
                call(msg)
            end
        end
    )
end

---词条选择
---@param index number 选择词条索引
---@param type number 1:保留 2:替换 ,保留时，不用索引
function GemstoneModel:SelectResetAttr(uid, index, type, newAttr, call)
    require("GemstoneNet"):GetInstance():ChooseAttr(
        { uid = uid, index = index, type = type },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if type == 2 then
                local gem = self.gemstoneList[uid]
                if gem then
                    if not _G.table.isEmptyOrNil(newAttr) then
                        _G.SortList(
                            newAttr,
                            function(a)
                                return -a.index
                            end
                        )
                        gem.randomAttr = newAttr
                    end
                    gem.reset = {}
                    if gem.cardUid and gem.cardUid ~= 0 then
                        local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, gem.cardUid)
                        cardData:CalcNowSumProp()
                    end
                end
            end
            if call then
                call(msg)
            end
        end
    )
end

-- 获取属性评分
function GemstoneModel:GetAdditionsScore(attr)
    local gem_add_att_cfg = _G.ConfigManager.gem_add_att_cfg
    local score = 0
    local sid, num
    for _, value in pairs(attr) do
        ---- 当前属性格式   or   洗炼出的属性格式
        sid = value.sid
        num = value.value
        ---属性评分 = 配置值 直接 *  基数
        score = score + num * gem_add_att_cfg[sid].score_base
    end
    return score
end

function GemstoneModel:GetExtraAttrChangeLevel()
    if not self.extraAttrChangeLevel then
        local extraAttrList = {}
        for _, v in pairs(_G.ConfigManager.gem_level_cfg) do
            if v.extra_growth ~= 0 then
                if #extraAttrList == 0 or extraAttrList[#extraAttrList][2] ~= v.extra_growth then
                    _G.table.insert(extraAttrList, {v.level, v.extra_growth})
                end
            end
        end
        self.extraAttrChangeLevel = extraAttrList
    end
    return self.extraAttrChangeLevel
end

