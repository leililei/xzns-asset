function GemstoneModel:GetAllUseGemData()
    local outList = {}
    for _, list in pairs(self.gemstoneInCard) do
        for i = 1, 4 do
            _G.table.insert(outList, list[i] or {})
        end
    end
    return outList
end

--- 获取所有没有装备宝石
function GemstoneModel:GetAllNotUseGemData()
    local outList = {}
    for _, gem in pairs(self.gemstoneList) do
        if gem.cardUid == 0 then
            _G.table.insert(outList, gem)
        end
    end
    return outList
end

--- 获取所有没有装备宝石，以类型为索引，按照评分降序排序
function GemstoneModel:GetAllNotUseGemDataByProfessional()
    local GemByProfess = {}
    local allUnloadGem = self:GetAllNotUseGemData()
    for _, v in pairs(allUnloadGem) do
        if not GemByProfess[v.professional] then
            GemByProfess[v.professional] = {}
        end
        _G.table.insert(GemByProfess[v.professional], v)
    end
    for _, v in pairs(GemByProfess) do
        _G.SortList(
            v,
            function(a)
                return a:GetAttrScore()
            end
        )
    end
    return GemByProfess
end

