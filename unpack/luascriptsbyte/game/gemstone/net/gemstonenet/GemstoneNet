local base = require("BaseGameNet")

---@class GemstoneNet : BaseGameNet	通信协议
local GemstoneNet = _G.BaseClass("GemstoneNet", base)

---@return GemstoneNet GemstoneNet
function GemstoneNet:GetInstance()
    return base.GetInstance(self)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GemstoneNet:CallBack(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

--region 对外接口

---宝石镶嵌请求
---@param msg gem.c2s_gem_mosaic PB数据
---@param call function 完成回调
function GemstoneNet:Mosaic(msg, call)
    local item = _G.ConfigManager.net_map.game_gem_mosaic
    local port = base.Access(self, item, msg, _G.handler(self, self.CallBack))
    self.Call[port] = call
end

