---@class SecretModel : Singleton	中文描述
---@field infoData secret.s2c_secret_info
---@field MapDatas SecretGridData[]
---@field allEventCount table 事件数量
---@field HoldMap secret.i_s_map
---@field curEvent secret.i_event
---@field curHoleEvent secret.i_event
local SecretModel = _G.BaseClass("SecretModel", _G.GameDataModelBase)
local RoundGrid = {-1000, 1000, -1, 1}
local BoomRoundGrid = {-1000, 1000, -1, 1, -1001, 1001, -999, 999}

local QuickNotEvent = {[5] = true, [6] = true, [7] = true, [8] = true}
---@return SecretModel SecretModel
function SecretModel:GetInstance()
    return self.super.GetInstance(self)
end

function SecretModel:__init()
    self.curFunctionOpenID = 53
end

function SecretModel:GetDataFormServer()
    self:GetInfo()
end

---获取蓬莱武库信息
function SecretModel:GetInfo()
    require "SecretNet":GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end

---@param data secret.s2c_secret_info
function SecretModel:GetInfoCall(data)
    self.infoData = data
    self.infoData.events = self.infoData.events or {}
    self.isGetAuto = false
    self:InitItem()
    self:InitMapData()
    self:ParseData()
    self:InitEventCount()
    self:InitAward()
    self:InitMaxFloor()
    self.keyTb = _G.ConfigManager.discrete_cfg[104401][1]
    _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshPanel)
end

function SecretModel:InitMaxFloor()
    if self.maxFloor then
        return
    end
    self.maxFloor = 0
    for _, v in pairs(_G.ConfigManager.secret_area_cfg) do
        if v.type_map == 1 and v.next_map == 0 then
            self.maxFloor = v.id
        end
    end
end

---初始化道具
function SecretModel:InitItem()
    if self.itemList then
        for _, v in pairs(self.itemList) do
            _G.StorageManager:GetInstance():ConsumeItem(v.k, nil, v.v)
        end
    end
    self.itemList = {}
    if self.infoData.item then
        for _, v in pairs(self.infoData.item) do
            self.itemList[v.k] = v
        end
    end
end

function SecretModel:InitAward()
    self.award = {}
    if self.infoData.award then
        for _, v in pairs(self.infoData.award) do
            self.award[v] = true
        end
    end
end

---初始化各种事件数量
function SecretModel:InitEventCount()
    self.allEventCount = {}
    local cfgs = _G.ConfigManager.secret_event_cfg
    for _, v in pairs(self.infoData.events) do
        if not self.allEventCount[cfgs[v.id].event_type] then
            self.allEventCount[cfgs[v.id].event_type] = {finish = 0, count = 0}
        end
        if v.is_finish > 0 then
            self.allEventCount[cfgs[v.id].event_type].finish = self.allEventCount[cfgs[v.id].event_type].finish + 1
        end
        self.allEventCount[cfgs[v.id].event_type].count = self.allEventCount[cfgs[v.id].event_type].count + 1
        if cfgs[v.id].event_type == 6 then
            self.isGetAuto = true
            if v.is_finish > 0 then
                require "SecretManager":GetInstance().isNext = true
            end
        end
    end
end
---初始化地图数据
function SecretModel:InitMapData()
    self.MapDatas = {}
    local SecretGridData = require "SecretGridData"
    for i = 1, 7 do
        for j = 1, 5 do
            self.MapDatas[i * 1000 + j] = SecretGridData.New(j)
            self.MapDatas[i * 1000 + j]:ParseData(i * 1000 + j)
        end
    end
end

---获取道具
function SecretModel:GetItemData(id)
    return self.itemList[id]
end
---使用道具
function SecretModel:ConsumeItem(id, count)
    _G.StorageManager:GetInstance():ConsumeItem(id, nil, count)
    local data = self:GetItemData(id)
    if data then
        data.v = data.v - count
        if data.v == 0 then
            self:RemoveItem(id)
        end
    end
end

function SecretModel:AddItemArray(data)
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    local datas = _G.StorageManager:GetInstance():MergeAward(data)
    if datas then
        for _, v in pairs(datas) do
            self:AddItem(v[1], v[2])
        end
    end
end
---增加道具
function SecretModel:AddItem(id, count)
    local Sid = id
    while (Sid > 1000) do
        Sid = Sid / 10
    end
    Sid = _G.math.floor(Sid)
    if Sid ~= _G.ItemSidJudgeSection.Task then
        return
    end
    local cfg = _G.ConfigManager.item_cfg[id]
    if cfg and cfg.Type1 == 5 then
        if not self.itemList[id] then
            self.itemList[id] = {k = id, v = 0}
        end
        self.itemList[id].v = self.itemList[id].v + count
    end
end

function SecretModel:GetAllItemData()
    return self.itemList
end

function SecretModel:GetAllItemDataToArray()
    local tb = _G.table.toArray(self.itemList)
    _G.table.sort(
        tb,
        function(a, b)
            return a.k < b.k
        end
    )
    return tb
end
---region
---完成事件
---@param prams number 事件参数
function SecretModel:FinishEvent(prams, callback)
    local msg = {type = 1, xy = self.curEvent.xy, prams = prams}
    if self.HoldMap then
        msg.type = 2
        msg.uid = self.HoldMap.uid
        msg.xy = self.curHoleEvent.xy
    end
    local cfg = _G.ConfigManager.secret_event_cfg[self.curEvent.id]
    if cfg and cfg.event_type == 6 and require "SecretManager":GetInstance().isNext then
        if not self:CheckEventFinsh() then
            if self.infoData.id == self.maxFloor then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    530302,
                    nil,
                    function()
                        require "SecretNet":GetInstance():FinshEvent(
                            msg,
                            _G.handlerbind(self, self.FinishEventCall, callback)
                        )
                    end
                )
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    530301,
                    nil,
                    function()
                        require "SecretNet":GetInstance():FinshEvent(
                            msg,
                            _G.handlerbind(self, self.FinishEventCall, callback)
                        )
                    end
                )
            end
            return
        end
    end
    require "SecretNet":GetInstance():FinshEvent(msg, _G.handlerbind(self, self.FinishEventCall, callback, prams))
end
---endregion

---完成事件回调
---@param data secret.c2s_finish_event
function SecretModel:FinishEventCall(data, callback, prams)
    if data.ack ~= 1 then
        return
    end
    if not self.HoldMap then
        self.curEvent.is_finish = 1
        local cfg = _G.ConfigManager.secret_event_cfg[self.curEvent.id]
        if data.event then
            if not self.infoData.events then
                self.infoData.events = {}
            end
            _G.table.insertto(self.infoData.events, data.event)
            self:InitEventCount()
        end
        if cfg.event_type == 5 then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretHoleView.Name)
            _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshPanel)
        end
        self.curEvent = nil
    else
        self.curHoleEvent.is_finish = 1
        self.curHoleEvent = nil
    end
    if data.award then
        self:AddItemArray(data)
    end
    if not isFire then
        if callback then
            callback(data)
        end
    end
end

function SecretModel:UpallGird()
    for _, v in pairs(self.MapDatas) do
        v:RefreshGrid()
    end
end

---移除道具
function SecretModel:RemoveItem(id)
    if self.itemList[id] then
        self.itemList[id] = nil
    end
end

---探索格子
---@param xy number X*1000+y
function SecretModel:LookGrid(xy, callback)
    if self.infoData.a_index == 0 then
        return
    end
    if not _G.StorageManager:GetInstance():CheckItem(self.keyTb[1], self.keyTb[2]) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.keyTb[1])
        return
    end
    local msg = {xy = xy}
    if self.HoldMap then
        msg.uid = self.HoldMap.uid
    end
    require "SecretNet":GetInstance():LookGrid(msg, _G.handlerbind(self, self.LookGridCall, xy, callback))
end

---探索格子回调
---@param msg secret.s2c_look_over
function SecretModel:LookGridCall(msg, xy, callback)
    if msg.ack ~= 1 then
        return
    end

    self.infoData.cost = self.infoData.cost + self.keyTb[2]
    local cfg = _G.ConfigManager.secret_event_cfg[msg.event.id]
    if not self.isGetAuto then
        if cfg.event_type == 6 then
            self.isGetAuto = true
        end
    end
    self:ConsumeItem(self.keyTb[1], self.keyTb[2])
    if self.HoldMap then
        if not self.HoldMap.events then
            self.HoldMap.events = {}
        end
        _G.table.insert(self.HoldMap.events, msg.event)
    else
        _G.table.insert(self.infoData.events, msg.event)
    end
    self.MapDatas[xy]:RefreshGrid()
    if not self.HoldMap then
        if msg.maps then
            if not self.infoData.maps then
                self.infoData.maps = {}
            end
            _G.table.insertto(self.infoData.maps, msg.maps)
        end
        if callback then
            callback()
        end
    else
        if callback then
            callback()
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshSingleGrid, xy)
    if msg.award then
        self:AddItemArray(msg)
        local isExit, View = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SecretFloatTipsView.Name)
        if isExit then
            View.View:Show(msg)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretFloatTipsView.Name, msg)
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshSecretKey)
end

---更新周围的格子
function SecretModel:UpdateRoundGrid(xy, isNotDispath)
    local grid = self.MapDatas[xy]
    if not grid or not grid.eventCfg then
        return
    end
    local round = grid.eventCfg.event_type == 2 and RoundGrid or BoomRoundGrid
    for _, v in pairs(round) do
        local data = self.MapDatas[xy + v]
        if data and not data.event then
            data:RefreshGrid(isNotDispath, true)
        end
    end
end

---获取事件
---@return secret.i_event
function SecretModel:GetEvent(xy)
    for _, v in pairs(self.infoData.events) do
        if v.xy == xy then
            return v
        end
    end
end
---设置当前事件
function SecretModel:SetCurEvent(xy)
    self.curEvent = self:GetEvent(xy)
    local cfg = _G.ConfigManager.secret_event_cfg[self.curEvent.id]
    if cfg.event_type == 5 then
        self:EnterHoldMap(self.curEvent.args[1])
    end
end
---进入山洞地图
function SecretModel:EnterHoldMap(uid)
    self.HoldMap = self:GetHoleData(uid)
end
---退出山洞地图
function SecretModel:ExitHoldMap()
    self.HoldMap = nil
end
---当前山洞事件
function SecretModel:SetHoleEvent(event)
    self.curHoleEvent = event
end

---设置自选奖励
function SecretModel:SetAward(index, callback)
    if index <= 0 then
        self.infoData.a_index = index
        return
    end
    require "SecretNet":GetInstance():SetAward(
        {index = index},
        _G.handlerbind(self, self.SetAwardCall, index, callback)
    )
end

---设置自选奖励回调
function SecretModel:SetAwardCall(data, index, callback)
    if data.ack ~= 1 then
        return
    end
    self.infoData.a_index = index
    if callback then
        callback()
    end
end

