---添加事件数量
---@param event secret.i_event
function SecretModel:AddEventCount(event)
    local cfgs = _G.ConfigManager.secret_event_cfg
    if not self.allEventCount[cfgs[event.id].event_type] then
        self.allEventCount[cfgs[event.id].event_type] = {finish = 0, count = 0}
    end
    if event.is_finish > 0 then
        self.allEventCount[cfgs[event.id].event_type].finish = self.allEventCount[cfgs[event.id].event_type].finish + 1
    end
    self.allEventCount[cfgs[event.id].event_type].count = self.allEventCount[cfgs[event.id].event_type].count + 1
end
---修改事件完成数量
function SecretModel:ChangeEventCount(event)
    local cfgs = _G.ConfigManager.secret_event_cfg
    self.allEventCount[cfgs[event.id].event_type].finish = self.allEventCount[cfgs[event.id].event_type].finish + 1
end
---获取事件数量
---@param eventType number 事件类型
function SecretModel:GetEventCount(eventType)
    return self.allEventCount[eventType]
end
---检测是否又事件未完成
function SecretModel:CheckEventFinsh()
    for _, v in pairs(self.MapDatas) do
        if not v.event or (v.eventCfg.event_type ~= 6 and v.event.is_finish < 0) then
            return false
        end
    end
    return true
end
---检测山洞时间是否全部完成
function SecretModel:CheckHoleEventFinsh()
    if not self.HoldMap.events or #self.HoldMap.events < 9 then
        return false
    end

    for _, v in pairs(self.HoldMap.events) do
        if v.is_finish <= 0 then
            return false
        end
    end
    return true
end
---检测宝箱时间是否能触发
function SecretModel:CheckHoleMidEvent()
    for _, v in pairs(self.HoldMap.events) do
        local value = _G.math.abs(v.xy - 2002)
        if (value == 1 or value == 1000) and v.is_finish > 0 then
            return true
        end
    end
    return false
end

function SecretModel:CheckIsGetAward(id)
    return self.award[id]
end

function SecretModel:GetCusumeAward(ids, callback)
    if _G.table.isEmptyOrNil(ids) then
        return
    end
    require "SecretNet":GetInstance():GetCusumeAward(
        {id = ids},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:AddItemArray(msg)
            for _, v in pairs(ids) do
                self.award[v] = true
            end
            if self:IsGetAllAward() then
                self.infoData.cost = 0
                self.award = {}
                if callback then
                    callback(msg, true)
                end
            else
                if callback then
                    callback(msg)
                end
            end
        end
    )
end
---获取距离下个奖励的数量
function SecretModel:GetNexAward()
    for _, v in ipairs(_G.ConfigManager.secret_reward_cfg) do
        if v.number > self.infoData.cost then
            return v.number - self.infoData.cost
        end
    end
    return nil
end

function SecretModel:IsGetAllAward()
    for _, v in pairs(_G.ConfigManager.secret_reward_cfg) do
        if not self:CheckIsGetAward(v.id) then
            return false
        end
    end
    return true
end

---检测是否挖到自选奖励
function SecretModel:CheckIsGetAuto()
    return self.isGetAuto
end

function SecretModel:OnQuick(call)
    local pos = 5
    local tb = {}
    local finish
    local next
    ----@type SecretGridData
    local gridData
    local SecretManager = require "SecretManager":GetInstance()
    ---@param data SecretGridData
    finish = function(data, isNotNext)
        if not SecretManager.isQuick then
            return
        end
        if data.event.is_finish > 0 or QuickNotEvent[data.eventCfg.event_type] then
            data:RefreshGrid()
            if data.eventCfg.event_type == 6 then
                self.isGetAuto = true
                _G.DelayDo(
                    1,
                    function()
                        if call then
                            call(tb)
                        end
                    end
                )

                return
            end
            _G.DelayDo(
                0.2,
                function()
                    next(isNotNext)
                end
            )
            return
        end
        local prams = {}
        local eventType = data.eventCfg.event_type
        if eventType == 4 then
            local npcCfg = _G.ConfigManager.secret_npc_cfg[data.event.args[1]]
            for i = 1, 3 do
                if npcCfg["answer" .. i] > 0 then
                    if
                        _G.table.isEmptyOrNil(npcCfg["consumption" .. i]) or
                            _G.StorageManager:GetInstance():CheckItem(
                                npcCfg["consumption" .. i][1],
                                npcCfg["consumption" .. i][2]
                            )
                     then
                        prams[1] = i
                        break
                    end
                end
            end
        end
        if eventType == 2 then
            if not _G.table.isEmptyOrNil(data.eventCfg.consumption) then
                if
                    data.eventCfg.consumption[1] == self.keyTb[1] and
                        not _G.StorageManager:GetInstance():CheckItem(
                            data.eventCfg.consumption[1],
                            data.eventCfg.consumption[2]
                        )
                 then
                    data:RefreshGrid()
                    if call then
                        call(tb)
                    end
                    return
                end
            end
        end
        local msg2 = {type = 1, xy = data.xy, prams = prams}
        require "SecretNet":GetInstance():FinshEvent(
            msg2,
            function(msg3)
                if msg3.ack ~= 1 then
                    return
                end
                if data.eventCfg.event_type ~= 10 then
                    if not tb[data.eventCfg.event_type] then
                        tb[data.eventCfg.event_type] = {
                            id = data.eventCfg.event_type,
                            count = 1,
                            award = {item = {}}
                        }
                    else
                        tb[data.eventCfg.event_type].count = tb[data.eventCfg.event_type].count + 1
                    end
                end

                if msg3.award then
                    self:AddItemArray(msg3)
                    if data.eventCfg.event_type == 10 then
                        if msg3.award.item then
                            _G.table.insertto(tb[1].award.item, msg3.award.item)
                        end
                        if msg3.award.overflow then
                            _G.table.insertto(tb[1].award.item, msg3.award.overflow)
                        end
                    else
                        if msg3.award.item then
                            _G.table.insertto(tb[data.eventCfg.event_type].award.item, msg3.award.item)
                        end
                        if msg3.award.overflow then
                            _G.table.insertto(tb[data.eventCfg.event_type].award.item, msg3.award.overflow)
                        end
                    end
                end
                if eventType == 4 then
                    local npcCfg = _G.ConfigManager.secret_npc_cfg[data.event.id]
                    if not _G.table.isEmptyOrNil(npcCfg["consumption" .. prams[1]]) then
                        self:ConsumeItem(npcCfg["consumption" .. prams[1]][1], npcCfg["consumption" .. prams[1]][2])
                        if npcCfg["consumption" .. prams[1]][1] == self.keyTb[1] then
                            self.infoData.cost = self.infoData.cost + npcCfg["consumption" .. prams[1]][2]
                        end
                    end
                end
                if eventType == 2 then
                    if not _G.table.isEmptyOrNil(data.eventCfg.consumption) then
                        self:ConsumeItem(data.eventCfg.consumption[1], data.eventCfg.consumption[2])
                        if data.eventCfg.consumption[1] == self.keyTb[1] then
                            self.infoData.cost = self.infoData.cost + data.eventCfg.consumption[2]
                        end
                    end
                end
                _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshSecretKey)
                data.event.is_finish = 1
                data:RefreshGrid()
                if msg3.event then
                    if not self.infoData.events then
                        self.infoData.events = {}
                    end
                    _G.table.insertto(self.infoData.events, msg3.event)
                    local isAuto = false
                    for _, v in pairs(msg3.event) do
                        if self.MapDatas[v.xy] then
                            self.MapDatas[v.xy]:RefreshGrid()
                            if self.MapDatas[v.xy].eventCfg.event_type == 6 then
                                isAuto = true
                            end
                        end
                    end
                    if isAuto then
                        if call then
                            call(tb)
                        end
                        return
                    end
                end

                _G.DelayDo(
                    0.1,
                    function()
                        next(isNotNext)
                    end
                )
            end
        )
    end

    next = function(isNotNext)
        if not SecretManager.isQuick then
            return
        end
        if not _G.StorageManager:GetInstance():CheckItem(self.keyTb[1], self.keyTb[2]) then
            if call then
                call(tb)
            end
            return
        end
        if pos then
            if not isNotNext then
                pos = pos + 1000
                if _G.math.floor(pos / 1000) > 7 then
                    pos = pos - 7001
                end
            end
            if pos <= 1000 then
                call(tb)
                return
            end
        end
        gridData = self.MapDatas[pos]
        if gridData then
            if gridData.Interactive then
                if not gridData.event then
                    require "SecretNet":GetInstance():LookGrid(
                        {xy = gridData.xy},
                        function(msg)
                            if msg.ack ~= 1 then
                                return
                            end
                            if not tb[1] then
                                tb[1] = {id = 1, count = 1, award = {item = {}}}
                            else
                                tb[1].count = tb[1].count + 1
                            end
                            self.infoData.cost = self.infoData.cost + self.keyTb[2]
                            self:ConsumeItem(self.keyTb[1], self.keyTb[2])
                            _G.table.insert(self.infoData.events, msg.event)
                            _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshSecretKey)
                            if msg.award then
                                self:AddItemArray(msg)
                                if msg.award.item then
                                    _G.table.insertto(tb[1].award.item, msg.award.item)
                                end
                                if msg.award.overflow then
                                    _G.table.insertto(tb[1].award.item, msg.award.overflow)
                                end
                            end
                            if msg.maps then
                                if not self.infoData.maps then
                                    self.infoData.maps = {}
                                end
                                _G.table.insertto(self.infoData.maps, msg.maps)
                            end
                            if msg.event and #msg.event > 1 then
                                self:RefreshAllGridData(true)
                                _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshAllGrid)
                            else
                                gridData:RefreshGrid()
                            end

                            _G.DelayDo(
                                0.1,
                                function()
                                    finish(gridData)
                                end
                            )
                        end
                    )
                else
                    if gridData.event.is_finish > 0 then
                        next()
                        return
                    end
                    _G.DelayDo(
                        0.2,
                        function()
                            finish(gridData)
                        end
                    )
                end
            else
                if gridData.event and gridData.event.is_finish > 0 then
                    next()
                    return
                end
                local tb2 = gridData:GetContentGridList()
                if _G.table.isEmptyOrNil(tb2) then
                    next()
                else
                    gridData = self.MapDatas[tb2[1]]
                    finish(gridData, true)
                end
            end
        end
    end
    next()
end

function SecretModel:RefreshAllGridData(isNotDispath)
    for _, v in pairs(self.MapDatas) do
        v:RefreshGrid(isNotDispath, true)
    end
end

return SecretModel
