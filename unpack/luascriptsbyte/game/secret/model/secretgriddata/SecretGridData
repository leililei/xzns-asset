---@class SecretGridData	中文描述
---@field eventCfg secret_event_cfg
local SecretGridData = _G.BaseClass("SecretGridData")
local RoundGrid = {-1000, 1000, -1, 1}
---类的构造函数
function SecretGridData:__init()
end

---类的析构函数
function SecretGridData:Dispose()
end
---@param event secret.i_event
function SecretGridData:ParseData(xy)
    self.xy = xy
    self.event = require "SecretModel":GetInstance():GetEvent(self.xy)
    if self.event then
        self.eventCfg = _G.ConfigManager.secret_event_cfg[self.event.id]
    end
    self.showX = false
    self:UpdateInteractive()
end

function SecretGridData:RefreshGrid(isNotDispath, isRefreshRoundGrid)
    self.event = require "SecretModel":GetInstance():GetEvent(self.xy)
    if self.event then
        self.eventCfg = _G.ConfigManager.secret_event_cfg[self.event.id]
        if
            (self.eventCfg.event_type == 2 or self.eventCfg.event_type == 8 or self.eventCfg.event_type == 10) and
                not isRefreshRoundGrid
         then
            require "SecretModel":GetInstance():UpdateRoundGrid(self.xy, isNotDispath)
        end
    end
    self:UpdateInteractive()
    if not isNotDispath then
        _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshSingleGrid, self.xy)
    end
end

function SecretGridData:UpdateInteractive()
    self.Interactive = self:CheckInteractive()
end

function SecretGridData:UpdateEvent()
    self.event = require "SecretModel":GetInstance():GetEvent(self.xy)
    if self.event then
        self.eventCfg = _G.ConfigManager.secret_event_cfg[self.event.id]
    end
end

---检测是否可以交互
function SecretGridData:CheckInteractive()
    self.showX = false
    local SecretModel = require "SecretModel":GetInstance()
    if self.event then
        if self.eventCfg.event_type == 7 then
            return false
        end
        return true
    end
    for _, v in pairs(RoundGrid) do
        local data = SecretModel:GetEvent(self.xy + v)
        if data then
            if self.xy + v == 4003 and data.id == 8 then
            else
                local cfg = _G.ConfigManager.secret_event_cfg[data.id]
                if cfg.event_type == 2 and data.is_finish <= 0 then
                    self.showX = true
                    return false
                end
            end
        end
    end
    return true
end
---获取相关联的怪物格子
function SecretGridData:GetContentGridList()
    if not self.showX then
        return nil
    end
    local SecretModel = require "SecretModel":GetInstance()
    local tb = {}
    for _, v in pairs(RoundGrid) do
        local data = SecretModel:GetEvent(self.xy + v)
        if data then
            if self.xy + v == 4003 and data.id == 8 then
            else
                local cfg = _G.ConfigManager.secret_event_cfg[data.id]
                if cfg.event_type == 2 and data.is_finish <= 0 then
                    _G.table.insert(tb, self.xy + v)
                end
            end
        end
    end
    return tb
end

return SecretGridData
