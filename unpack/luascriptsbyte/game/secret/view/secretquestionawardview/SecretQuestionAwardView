---按钮点击事件在这里派发
function SecretQuestionAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    else
        require "SecretNet":GetInstance():GetAward(
            {xy = self.xy, choose = self.index},
            function(data)
                if data.ack ~= 1 then
                    return
                end
                require "SecretModel":GetInstance():ConsumeItem(
                    _G.ConfigManager.discrete_cfg[104401][1][1],
                    self.cfg["consumption" .. self.index]
                )
                require "SecretModel":GetInstance():AddItemArray(data)
                require "CommonTipManager".OpenCommonAwardView(data)
                self:Close()
            end
        )
    end
end

return SecretQuestionAwardView
