local SecretQuestionAwardView = _G.BaseClass("SecretQuestionAwardView", _G.UIBaseView)
--_G.SecretQuestionAwardView = SecretQuestionAwardView

function SecretQuestionAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param cfg secret_npc_cfg
---@param index number 答案
function SecretQuestionAwardView:OnCreate(cfg, index, xy, callback)
    self.awardDatas = cfg["rewards" .. index]
    self.xy = xy
    self.index = index
    self.AwardList = {}
    self.cfg = cfg
    -- self.go_table.scrollloopvectical_Award:InitItemData(#self.awardDatas, _G.handler(self, self.RefreshItem))
    local cfg = _G.ConfigManager.secret_event_cfg[4]
    self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(cfg.name)
    self.go_table.aorrawimage_icon:LoadImage(cfg.icon1)
    local allCount =
        _G.StorageManager:GetInstance():GetItemCountByID(
        _G.StorageID.Material,
        _G.ConfigManager.discrete_cfg[104401][1][1]
    )
    if self.cfg["consumption" .. index] > allCount then
        self.go_table.aortext_num.text =
            _G.string.format("<color=#922222>%d</color>/%d", self.cfg["consumption" .. index], allCount)
    else
        self.go_table.aortext_num.text = _G.string.format("%d/%d", self.cfg["consumption" .. index], allCount)
    end

    self:InitContent()
end

function SecretQuestionAwardView:InitContent()
    local count = #self.awardDatas
    for i = 1, count do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            self.awardDatas[i],
            self.go_table.obj_Content,
            function(item)
                item:SetGrade(true)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(item)
                require "CommonTipManager":GetInstance():OpenTip(item.go_table.gameObject, self.awardDatas[i][1], nil)
            end
        )
    end
end

