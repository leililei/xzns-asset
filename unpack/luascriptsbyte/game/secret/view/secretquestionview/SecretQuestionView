---@class SecretQuestionView : UIBaseView	中文描述
---@field public go_table SecretQuestionView_GoTable GoTable
local SecretQuestionView = _G.BaseClass("SecretQuestionView", _G.UIBaseView)
--_G.SecretQuestionView = SecretQuestionView
local key = {}
function SecretQuestionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data secret.i_event
function SecretQuestionView:OnCreate(callback)
    if require "SecretModel":GetInstance().HoldMap then
        self.eventData = require "SecretModel":GetInstance().curHoleEvent
    else
        self.eventData = require "SecretModel":GetInstance().curEvent
    end

    self.evenetCfg = _G.ConfigManager.secret_event_cfg[self.eventData.id]
    self.cfg = _G.ConfigManager.secret_npc_cfg[self.eventData.args[1]]
    self.callback = callback
    if not self.cfg then
        return
    end

    self:UpdateAnswer(self.go_table.toggle_1, 1)
    self:UpdateAnswer(self.go_table.toggle_2, 2)
    self:UpdateAnswer(self.go_table.toggle_3, 3)
    -- self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(self.evenetCfg.name)
    self.go_table.aorrawimage_icon:LoadImage(self.evenetCfg.icon1)
    self.go_table.aortext_question_des.text = _G.LangUtil.GetLangPackValue(self.cfg.questions)
end
---更新答案显示
function SecretQuestionView:UpdateAnswer(obj, index)
    if self.cfg["answer" .. index] == 0 then
        _G.GameUtil.SetActiveByCondition(obj, false)
        return
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickAnswer, index))
    tb.aortext_des.text = _G.LangUtil.GetLangPackValue(self.cfg["answer" .. index])

    _G.GameUtil.SetActiveByCondition(
        tb.aorimage_icon,
        self.cfg["consumption" .. index][1] and self.cfg["consumption" .. index][2] > 0
    )
    if self.cfg["consumption" .. index][1] and self.cfg["consumption" .. index][2] > 0 then
        local icon = _G.StorageManager:GetInstance():GetItemIcon(self.cfg["consumption" .. index][1])
        local str = _G.string.split2tbl(icon, "/")
        if not _G.table.isEmptyOrNil(str) then
            tb.aorimage_icon.SpriteName = str[#str]
            tb.aortext_num.text = _G.GameUtil.NumberToUnitStr(self.cfg["consumption" .. index][2])
        end
    end
end

---点击答案
function SecretQuestionView:OnClickAnswer(go, isOn, index)
    local isCanChoose = true
    if self.cfg["consumption" .. index][1] then
        local all = _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg["consumption" .. index][1])
        if all == 0 then
            local data = require "SecretModel":GetInstance():GetItemData(self.cfg["consumption" .. index][1])
            if data then
                all = data.v
            end
        end
        isCanChoose = all > self.cfg["consumption" .. index][2]
    end
    if isCanChoose then
        require "SecretModel":GetInstance():FinishEvent(
            {index},
            function(data)
                if self.cfg["consumption" .. index][1] then
                    require "SecretModel":GetInstance():ConsumeItem(
                        self.cfg["consumption" .. index][1],
                        self.cfg["consumption" .. index][2]
                    )
                end
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretResultView.Name,
                    self.evenetCfg,
                    "Images/nSecret/ui-plbk-txt-kmldkw",
                    data,
                    function()
                        self:Close()
                    end,
                    self.cfg["describe" .. index]
                )
                if self.callback then
                    self.callback()
                end
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
            self.cfg["consumption" .. index][1]
        )
    end
end

---按钮点击事件在这里派发
function SecretQuestionView:OnClickBtn(go, isOn)
    self:Close()
end

return SecretQuestionView
