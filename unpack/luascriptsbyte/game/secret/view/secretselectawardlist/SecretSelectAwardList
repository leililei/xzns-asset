---@class SecretSelectAwardList : Component	中文描述
---@field go_table SecretSelectView._obj_Item_GoTable
---@field awardList BaseAwardNewItem[]
local SecretSelectAwardList = _G.BaseClass("SecretSelectAwardList", _G.Component)

function SecretSelectAwardList:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SecretSelectAwardList:OnCreate(check, choose)
    self.curFloor = require "SecretModel":GetInstance().infoData.id
    self.check = check
    self.choose = choose
    self:InitAwardList()
end

function SecretSelectAwardList:Show(index, data)
    self.data = data
    self.go_table.aortext_title.text =
        _G.string.format(_G.LangUtil.GetLangPackValue(90023200002, _G.GameUtil.NumberToChinese(index)))
    self:ShowAwarList()
end
---更新奖励列表显示
function SecretSelectAwardList:ShowAwarList()
    for i = 1, 5 do
        if self.data[i] then
            self.awardList[i]:Show(self.data[i].data)
            _G.GameUtil.SetActiveByCondition(self.awardList[i].go_table.obj_choose, self.check(self.data[i].floor, i))
            _G.GameUtil.SetActiveByCondition(self.awardList[i].go_table.obj_suo, self.data[i].floor ~= self.curFloor)
            _G.GameUtil.SetActiveByCondition(self.awardList[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(self.awardList[i].gameObject, false)
        end
    end
end
---初始化奖励列表
function SecretSelectAwardList:InitAwardList()
    self.awardList = {}
    for i = 1, 5 do
        self.awardList[i] =
            require "BaseAwardNewItem".New(
            self.go_table["obj_award" .. i],
            _G.handlerbind(self, self.OnClickAward, i),
            72
        )
    end
end

function SecretSelectAwardList:OnClickAward(item, index)
    local data = self.data[index]
    if data.floor ~= self.curFloor then
        require "CommonTipManager":GetInstance():OpenTip(item.gameObject, data.data.sid)
        return
    end
    self.choose(item.gameObject, data.floor, index)
end

---销毁对象时,析构函数
function SecretSelectAwardList:OnDestroy()
end

function SecretSelectAwardList:OnClickBtn(go, isOn)
    -- body
end

return SecretSelectAwardList
