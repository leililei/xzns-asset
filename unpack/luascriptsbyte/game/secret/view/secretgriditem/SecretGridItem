---@class SecretGridItem	中文描述
---@field go_table _obj_Map._obj_Grid_GoTable
---@field xy number 坐标
---@field data SecretGridData
local SecretGridItem = _G.BaseClass("SecretGridItem")
local offImage = {"ui-plbk-img-digong03", "ui-plbk-img-digong05", "ui-plbk-img-digong07"}
local onImage = {"ui-plbk-img-digong02", "ui-plbk-img-digong04", "ui-plbk-img-digong06"}

---类的构造函数
function SecretGridItem:__init(obj, time)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.eventEffect = {}
    self:InitEffect(time)
    self.isEffect = false
    self.order = 1055
    if not _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name) then
        self.order = 1005
    end
    _G.Events:GetInstance():AddListener(_G.eSecret.RefreshSingleGrid, self.RefreshShow, self)
end

function SecretGridItem:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSecret.RefreshSingleGrid, self.RefreshShow, self)
end

function SecretGridItem:RefreshShow(xy)
    if not xy or xy ~= self.xy then
        return
    end
    if require "SecretManager":GetInstance():CheckIsQuick() then
        self:QuickShow()
    else
        self:UpdateShow()
    end
end

function SecretGridItem:InitEffect(time)
    _G.DelayDo(
        time,
        function()
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_stone_posui,
                self.gameObject,
                function(trans)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetRectOffSetToZero()
                    self.lookEffect = trans
                    _G.GameUtil.SetActiveByCondition(trans, false)
                end
            )
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_zhandouyanwu,
                self.gameObject,
                function(trans)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetRectOffSetToZero()
                    self.battleEffect = trans
                    _G.GameUtil.SetActiveByCondition(trans, false)
                end
            )
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_stone_wajuejiangli,
                self.gameObject,
                function(trans)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetRectOffSetToZero()
                    self.lookEffect2 = trans
                    _G.GameUtil.SetActiveByCondition(trans, false)
                end
            )
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zixuanjiangli,
        self.gameObject,
        function(trans)
            if _G.IsNil(self.gameObject) then
                _G.DestroyObject(trans)
                return
            end
            trans:SetRectOffSetToZero()
            self.lookEffect3 = trans
            if
                self.data and self.data.event and self.data.eventCfg.event_type == 6 and
                    not require "SecretManager":GetInstance().isNext
             then
                _G.GameUtil.SetActiveByCondition(trans, true)
            else
                _G.GameUtil.SetActiveByCondition(trans, false)
            end
        end
    )
end

function SecretGridItem:Show(xy)
    self.xy = xy
    self.data = require "SecretModel":GetInstance().MapDatas[self.xy]
    if not self.imageNum then
        self.imageNum = _G.math.random(1, 3)
    end
    self:RefreshShow(self.xy)
end
---更新显示
function SecretGridItem:UpdateShow()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_di, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_icon, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_x, false)

    if not self.data.event then
        if self.data.Interactive then
            self.go_table.aorimage_di.SpriteName = onImage[self.imageNum]
        else
            self.go_table.aorimage_di.SpriteName = offImage[self.imageNum]
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_x, self.data.showX)
    elseif self.data.event.is_finish > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_di, false)
        self:HideEventEffect()
        if self.data.eventCfg.event_type == 6 then
            self.go_table.aorrawimage_icon:LoadImage(
                self.data.eventCfg.icon,
                function()
                    self.go_table.aorrawimage_icon:SetNativeSize()
                end
            )
            if self.data.eventCfg.event_type == 6 and self.canvas then
                self.canvas:DestroyCompent()
                self.canvas = nil
            end
            _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_icon, true)
            if self.lookEffect3 then
                _G.GameUtil.SetActiveByCondition(self.lookEffect3, false)
            end
            self:PlayEventEffect()
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_di, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_icon, true)
        if self.data.eventCfg.event_type == 6 and not require "SecretManager":GetInstance().isNext then
            self:HideEventEffect()
            local infoData = require "SecretModel":GetInstance().infoData
            local awardData = _G.ConfigManager.secret_area_cfg[infoData.id].item_select[infoData.a_index]
            local icon = _G.StorageManager:GetInstance():GetItemIcon(awardData[1])
            self.go_table.aorrawimage_icon:LoadImage(
                icon,
                function()
                    self.go_table.aorrawimage_icon:SetNativeSize()
                end
            )
            if not self.canvas then
                self.canvas = self.go_table.aorrawimage_icon:AddComponentE(_G.typeof(_G.Canvas))
                self.canvas.overrideSorting = true
                self.canvas.sortingOrder = self.order
            end
            if self.lookEffect3 then
                _G.GameUtil.SetActiveByCondition(self.lookEffect3, true)
            end
        else
            self.go_table.aorrawimage_icon:LoadImage(
                self.data.eventCfg.icon,
                function()
                    self.go_table.aorrawimage_icon:SetNativeSize()
                end
            )
            self:PlayEventEffect()
        end
    end
    self.go_table.aorimage_di:SetNativeSize()
end

function SecretGridItem:OnClickBtn(go, isOn)
    if
        not self.data.Interactive or
            (self.data.event and self.data.event.is_finish > 0) and self.data.eventCfg.event_type ~= 6 or
            self.isEffect
     then
        return
    end
    if require "SecretManager":GetInstance():CheckIsQuick() then
        return
    end
    if self.data.event then
        require "SecretManager":GetInstance():OnTriggerEvent(
            self.data.event,
            function(data)
                if self.data.eventCfg.event_type == 2 and self.battleEffect then
                    self:PlayEffect(
                        self.battleEffect,
                        function()
                            self.data:RefreshGrid()
                            require "CommonTipManager".OpenCommonAwardView(data)
                        end
                    )
                    self:HideEventEffect()
                elseif self.data.eventCfg.event_type == 10 then
                    self.go_table.aorrawimage_icon.enabled = false
                    _G.GameUtil.SetActiveByCondition(self.eventEffect[self.data.eventCfg.event_type], true)
                    if self.callback then
                        self.callback()
                    end
                    _G.DelayDo(
                        0.8,
                        function()
                            if _G.IsNil(self.go_table) then
                                return
                            end
                            if data.award then
                                local isExit, View =
                                    _G.UIManager:GetInstance():IsExitWindow(
                                    _G.ConfigManager.ui_cfg.SecretFloatTipsView.Name
                                )
                                if isExit then
                                    View.View:Show(data)
                                else
                                    _G.UIManager:GetInstance():OpenWindow(
                                        _G.ConfigManager.ui_cfg.SecretFloatTipsView.Name,
                                        data
                                    )
                                end
                            end
                            require "SecretModel":GetInstance():RefreshAllGridData(true)
                            _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshAllGrid)
                            self.go_table.aorrawimage_icon.enabled = true
                        end
                    )
                else
                    if self.data.eventCfg.event_type == 8 then
                        self.data:RefreshGrid(true)
                        _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshAllGrid)
                    else
                        self.data:RefreshGrid()
                    end
                    if self.callback then
                        self.callback()
                    end
                end
            end
        )
    else
        require "SecretModel":GetInstance():LookGrid(
            self.xy,
            function(data)
                local effect = self.data.eventCfg.event_type == 6 and self.lookEffect2 or self.lookEffect
                self:PlayEffect(effect)
            end
        )
    end
end

function SecretGridItem:PlayEventEffect()
    self:HideEventEffect()
    if self.eventEffect[self.data.eventCfg.event_type] then
        if self.data.eventCfg.event_type == 10 then
            _G.GameUtil.SetActiveByCondition(self.eventEffect[self.data.eventCfg.event_type], false)
        else
            _G.GameUtil.SetActiveByCondition(self.eventEffect[self.data.eventCfg.event_type], true)
        end
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[self.data.eventCfg.special],
            self.go_table.aorrawimage_icon,
            function(trans)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(trans)
                    return
                end
                self.eventEffect[self.data.eventCfg.event_type] = trans
                if self.data.eventCfg.event_type == 10 then
                    _G.GameUtil.SetActiveByCondition(trans, false)
                else
                    _G.GameUtil.SetActiveByCondition(trans, true)
                end
            end
        )
    end
end

function SecretGridItem:HideEventEffect()
    for _, v in pairs(self.eventEffect) do
        _G.GameUtil.SetActiveByCondition(v, false)
    end
end

function SecretGridItem:PlayEffect(effect, call)
    if effect then
        _G.GameUtil.SetActiveByCondition(effect, true)
        self.isEffect = true
        _G.DelayDo(
            0.6,
            function()
                if _G.IsNil(self.gameObject) then
                    return
                end
                self.isEffect = false
                _G.GameUtil.SetActiveByCondition(effect, false)
                if call then
                    call()
                end
            end
        )
    else
        if call then
            call()
        end
    end
end

function SecretGridItem:QuickShow()
    if not self.data.event then
        if self.data.Interactive then
            self.go_table.aorimage_di.SpriteName = onImage[self.imageNum]
        else
            self.go_table.aorimage_di.SpriteName = offImage[self.imageNum]
        end
        self.go_table.aorimage_di:SetActiveE(1)
        self.go_table.aorimage_x:SetActiveE(self.data.showX and 1 or 0)
        return
    end
    self.go_table.aorimage_x:SetActiveE(0)
    local isLook = self.go_table.aorimage_di:GetActiveSelf() == 1
    self.go_table.aorimage_di:SetActiveE(0)
    self.go_table.aorrawimage_icon:SetActiveE(1)
    if self.data.eventCfg.event_type == 6 and not require "SecretManager":GetInstance().isNext then
        self:HideEventEffect()
        local infoData = require "SecretModel":GetInstance().infoData
        local awardData = _G.ConfigManager.secret_area_cfg[infoData.id].item_select[infoData.a_index]
        local icon = _G.StorageManager:GetInstance():GetItemIcon(awardData[1])
        self.go_table.aorrawimage_icon:LoadImage(
            icon,
            function()
                self.go_table.aorrawimage_icon:SetNativeSize()
            end
        )
        if not self.canvas then
            self.canvas = self.go_table.aorrawimage_icon:AddComponentE(_G.typeof(_G.Canvas))
            self.canvas.overrideSorting = true
            self.canvas.sortingOrder = self.order
        end
        if self.lookEffect3 then
            _G.GameUtil.SetActiveByCondition(self.lookEffect3, true)
        end
    else
        if isLook then
            local effect = self.data.eventCfg.event_type == 6 and self.lookEffect2 or self.lookEffect
            self:PlayEffect(effect)
        else
            --self:PlayEffect(effect)
            -- if self.data.eventCfg.event_type == 2 and self.data.event.is_finish > 0 and self.battleEffect then
            --     self:PlayEffect(self.battleEffect)
            --     self:HideEventEffect()
            if self.data.eventCfg.event_type == 10 then
                self.go_table.aorrawimage_icon.enabled = false
                if self.eventEffect[self.data.eventCfg.event_type] then
                    self.eventEffect[self.data.eventCfg.event_type]:SetActiveE(1)
                end

                _G.DelayDo(
                    0.8,
                    function()
                        if _G.IsNil(self.go_table) then
                            return
                        end
                        self.go_table.aorrawimage_icon.enabled = true
                    end
                )
            end
        end
        self.go_table.aorimage_di:SetActiveE(0)
        self:HideEventEffect()
        if self.data.eventCfg.event_type == 6 then
            self.go_table.aorrawimage_icon:LoadImage(
                self.data.eventCfg.icon,
                function()
                    self.go_table.aorrawimage_icon:SetNativeSize()
                end
            )
            if self.data.eventCfg.event_type == 6 and self.canvas then
                self.canvas:DestroyCompent()
                self.canvas = nil
            end
            self.go_table.aorrawimage_icon:SetActiveE(1)
            if self.lookEffect3 then
                _G.GameUtil.SetActiveByCondition(self.lookEffect3, false)
            end
            self:PlayEventEffect()
        elseif self.data.event.is_finish > 0 then
            self.go_table.aorrawimage_icon:SetActiveE(0)
        else
            self.go_table.aorrawimage_icon:LoadImage(
                self.data.eventCfg.icon,
                function()
                    self.go_table.aorrawimage_icon:SetNativeSize()
                end
            )
            self.go_table.aorrawimage_icon:SetActiveE(1)
            self:PlayEventEffect()
        end
    end
end
return SecretGridItem
