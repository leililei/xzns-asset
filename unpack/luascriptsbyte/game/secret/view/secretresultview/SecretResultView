---@class SecretResultView : UIBaseView	中文描述
---@field public go_table SecretResultView_GoTable GoTable
local SecretResultView = _G.BaseClass("SecretResultView", _G.UIBaseView)
--_G.SecretResultView = SecretResultView

function SecretResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param eventCfg secret_event_cfg
function SecretResultView:OnCreate(eventCfg, title, data, loadCallback, desc)
    self.eventCfg = eventCfg
    self.desc = desc
    self.title = title
    self.AwardList = {}
    self.data = data
    self.awardData = _G.StorageManager:GetInstance():MergeAward(data)
    self:InitView()
    if loadCallback then
        loadCallback()
    end
end

function SecretResultView:InitView()
    if self.desc then
        self.go_table.aortext_question_desdawan.text = _G.LangUtil.GetLangPackValue(self.desc)
    else
        self.go_table.aortext_question_desdawan.text = _G.LangUtil.GetLangPackValue(self.eventCfg.desc)
    end

    self.go_table.aorrawimage_title:LoadImage(
        self.title,
        function()
            self.go_table.aorrawimage_title:SetNativeSize()
        end
    )
    local count = #self.awardData
    self.go_table.scrollloophorizontal_award:UpdateScrollRectWeight(20 + 96 * count + (count - 1) * 38)
    self.go_table.scrollloophorizontal_award:InitItemData(count, _G.handler(self, self.RefreshAward))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_kuang, self.eventCfg.event_type == 5)
    self.go_table.aorrawimage_icon:LoadImage(self.eventCfg.icon1)
end

function SecretResultView:RefreshAward(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.AwardList[instanceID]
    local awardData = self.awardData[index + 1]
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 85)
        self.AwardList[instanceID] = item
    end
    item:Show(data)
end

---按钮点击事件在这里派发
function SecretResultView:OnClickBtn(go, isOn)
    require "CommonTipManager".OpenCommonAwardView(self.data)
    self:Close()
end

return SecretResultView
