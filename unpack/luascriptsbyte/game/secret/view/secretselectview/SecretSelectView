---@class SecretSelectView : UIBaseView	中文描述
---@field public go_table SecretSelectView_GoTable GoTable
---@field infoData secret.s2c_secret_info
---@field curFloor number 当前在那层地图
---@field curIndex number 当前选择的奖励
---@field curToggle number 当前的层级
---@field curAward BaseItemData 当前奖励
---@field AwardList SecretSelectAwardList[]
local SecretSelectView = _G.BaseClass("SecretSelectView", _G.UIBaseView)

function SecretSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretSelectView:OnCreate(callback)
    self.infoData = require "SecretModel":GetInstance().infoData
    self.curIndex = self.infoData.a_index
    self.curFloor = self.infoData.id
    self.AwardList = {}
    self:InitAwardData()
    self.callback = callback
    -- self.item =
    --     require "BaseAwardNewItem".New(
    --     self.go_table.obj_Root,
    --     function()
    --     end,
    --     88
    -- )
    self:UpdateAward()
    self.go_table.scrollloopvectical_ItemList:InitItemData(#self.awardDatas, _G.handler(self, self.RefreshItem))
end

---初始化奖励
function SecretSelectView:InitAwardData()
    self.awardDatas = {}
    for k, v in pairs(_G.ConfigManager.secret_area_cfg) do
        if v.type_map == 1 then
            if not self.awardDatas[k] then
                self.awardDatas[k] = {}
            end
            for i, v2 in ipairs(v.item_select) do
                local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v2)

                _G.table.insert(self.awardDatas[k], {data = data, floor = k})
                if k == self.curFloor and i == self.infoData.a_index then
                    self.curAward = data
                end
            end
        end
    end
end
---刷新奖励
function SecretSelectView:RefreshItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.AwardList[instanceID]
    local awardData = self.awardDatas[index + 1]
    if not item then
        item =
            self:AddComponent(
            obj,
            require "SecretSelectAwardList".New(
                _G.handler(self, self.CheckIsCurIndex),
                _G.handler(self, self.OnClickItem)
            )
        )
        self.AwardList[instanceID] = item
    end
    self.AwardList[instanceID]:Show(index + 1, awardData)
end

---点击奖励
function SecretSelectView:OnClickItem(go, floor, index)
    local awardData = self.awardDatas[floor][index]
    if self.curIndex == index then
        require "CommonTipManager":GetInstance():OpenTip(go, awardData.data.sid)
        return
    end

    self.curAward = awardData.data
    self.curIndex = index
    self:UpdateAward()
    self.go_table.scrollloopvectical_ItemList:UpdateItemSingle(self.curFloor - 1)
end

---更新奖励显示
function SecretSelectView:UpdateAward()
    if not self.curAward then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, true)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_add, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_setItem, true)
    --self.item:Show(self.curAward)
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.curAward.sid))
    _G.UIUtils.SetItemNum(self.go_table, self.curAward.count)
end

---按钮点击事件在这里派发
function SecretSelectView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        require "SecretModel":GetInstance():SetAward(
            self.curIndex,
            function()
                if self.callback then
                    self.callback()
                end
                self:Close()
            end
        )
    else
        self:OnToggle(go, isOn)
    end
end

function SecretSelectView:CheckIsCurIndex(floor, index)
    return self.curFloor == floor and self.curIndex == index
end

return SecretSelectView
