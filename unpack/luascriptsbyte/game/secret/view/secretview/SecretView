local TrackingPointModel = require("TrackingPointModel")

---@class SecretView : UIBaseView	中文描述
---@field public go_table SecretView_GoTable GoTable
---@field GridList SecretGridItem[]
local SecretView = _G.BaseClass("SecretView", _G.UIBaseView)
--_G.SecretView = SecretView

function SecretView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSecret.RefreshPanel, self.RefreshPanel)
    self:AddListener(_G.eSecret.RefreshAllGrid, self.RefreshGrid)
    self:AddListener(_G.eSecret.RefreshSecretKey, self.RefreshKey)
end

---界面的入口函数
function SecretView:OnCreate()
    self.infoData = require "SecretModel":GetInstance().infoData
    self.awardList = {}
    self:InitMap()
    self:UpdateChoose()
    self:UpdateTop()
    self:UpdateFloor()
    self:InitAward()
    self:InitSlider()
    self:InitKey()
    self:InitEffect()
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
    local params = _G.ConfigManager.discrete_cfg[104403]
    local isOpen = _G.GlobalConditionManager.CheckConditionByArray(params)
    self.go_table.aorbtn_quick:SetActiveE(isOpen and 1 or 0)
    self.go_table.aortext_content:SetActiveE(isOpen and 0 or 1)
    if not isOpen then
        local str = ""
        for i = 1, #params do
            if not _G.FunctionManager:GetInstance():CheckCondition(params[i][1], params[i][2]) then
                if params[i][1] == 4 then
                    ---@type afk_cfg
                    local cfg = _G.ConfigManager.afk_cfg[params[i][2]]
                    if cfg then
                        str = _G.GetLangPackValue(91024700031, cfg.chapter, cfg.section)
                    end
                else
                    str = _G.FunctionManager:GetInstance():GetStrWithType(params[i][1], params[i][2])
                end
                break
            end
        end
        self.go_table.aortext_content.text = str
    end
end
---初始化特效
function SecretView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SecretView_daojuxuanze,
        self.go_table.aorimage_addIcon,
        function(trans)
            self.chooseEffect = trans
            _G.GameUtil.SetActiveByCondition(trans, false)
        end
    )
end

function SecretView:InitSlider()
    self.unit = 135
    self.maxValue = 40 + (self.count - 1) * 135
    self.go_table.slider_progress.maxValue = self.maxValue
    self.go_table.slider_progress:SetRectTransformSize(2, self.maxValue)
    self.go_table.slider_progress.value = 1
    local cost = require "SecretModel":GetInstance().infoData.cost
    local last
    local max
    for i = self.count, 1, -1 do
        if _G.ConfigManager.secret_reward_cfg[i].number <= cost then
            last = _G.ConfigManager.secret_reward_cfg[i]
            break
        else
            max = _G.ConfigManager.secret_reward_cfg[i]
        end
    end
    if last then
        if last.id == self.count then
            self.go_table.slider_progress.value = 1
        else
            self.go_table.slider_progress.value =
                40 + (last.id - 1) * self.unit + (cost - last.number) / (max.number - last.number) * self.unit
        end
    else
        local cfg = _G.ConfigManager.secret_reward_cfg[1]
        self.go_table.slider_progress.value = cost / cfg.number * 40
    end
end

function SecretView:InitAward()
    self.count = #_G.ConfigManager.secret_reward_cfg
    self.go_table.scrollloopvectical_awardList:InitItemData(
        self.count,
        _G.handler(self, self.RefreshAward),
        self.count - 1
    )
end

function SecretView:RefreshAward(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.awardList[id]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickAward, item))
        self.awardList[id] = item
    end
    self:AwardShow(item, self.count - index)
end

function SecretView:AwardShow(item, index)
    local cfg = _G.ConfigManager.secret_reward_cfg[index]
    item.index = index
    item.aortext_content.text = "" .. cfg.number
    item.isGet = require "SecretModel":GetInstance():CheckIsGetAward(index)
    item.canTake = require "SecretModel":GetInstance().infoData.cost >= cfg.number and not item.isGet
    _G.GameUtil.SetActiveByCondition(item.aorbtn_click, item.canTake)
    -- _G.GameUtil.SetActiveByCondition(item.obj_next, item.canTake)
    if item.index == 3 and item.isGet == true then
        self.go_table.scrollloopvectical_awardList:ScrollToIndex(0, 0)
    end
    if not item.effect then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ItemCardAllView,
            item.trans_effect,
            function(trans)
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                item.effect = trans
                trans:SetAnchorPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(1.1)
                _G.GameUtil.SetActiveByCondition(trans, item.canTake)
            end
        )
    else
        _G.GameUtil.SetActiveByCondition(item.effect, item.canTake)
    end
    if not item.item then
        item.item = require "BaseAwardNewItem".New(item.obj_Root, nil, 85)
    end
    item.item:ShowWithID(cfg.reward[1], nil, nil, cfg.reward[1])
    _G.GameUtil.SetActiveByCondition(item.obj_mask, item.isGet)
    item.aorimage_tj.SpriteName = item.canTake and "ui-plbk-bar-dian" or "ui-lysl-bar-yq02"
end

function SecretView:InitKey()
    local icon = _G.StorageManager:GetInstance():GetItemIcon(_G.ConfigManager.discrete_cfg[104401][1][1])
    local str = _G.string.split2tbl(icon, "/")
    if not _G.table.isEmptyOrNil(str) then
        self.go_table.aorimage_icon.SpriteName = str[#str]
        self.go_table.aorimage_icon2.SpriteName = str[#str]
    end
end

function SecretView:OnClickAward(go, isOn, item)
    if item.canTake then
        local tb = {}
        local insert = _G.table.insert
        local SecretModel = require "SecretModel":GetInstance()
        local cost = SecretModel.infoData.cost
        for _, v in pairs(_G.ConfigManager.secret_reward_cfg) do
            if v.number <= cost and not SecretModel:CheckIsGetAward(v.id) then
                insert(tb, v.id)
            end
        end
        SecretModel:GetCusumeAward(
            tb,
            function(data, isOver)
                if isOver then
                    self.go_table.scrollloopvectical_awardList:UpdateAllItem()
                    self.go_table.scrollloopvectical_awardList:ScrollToIndex(5, 0)
                    self:UpdateTop()
                else
                    self.go_table.scrollloopvectical_awardList:UpdateAllItem()
                end
                require "CommonTipManager".OpenCommonAwardView(data)
                if 3 == item.index then
                    self.go_table.scrollloopvectical_awardList:ScrollToIndex(0, 0)
                end
            end
        )
    else
        require "CommonTipManager":GetInstance():OpenTip(
            go,
            _G.ConfigManager.secret_reward_cfg[item.index].reward[1][1]
        )
    end
end

---更新层数
function SecretView:UpdateFloor()
    self.go_table.aortext_floor.text =
        _G.string.format(_G.ConfigManager.language_package_cfg[90023200002], self.infoData.id)
end

function SecretView:UpdateTop()
    local id = _G.ConfigManager.discrete_cfg[104401][1][1]
    self.go_table.aortext_count.text =
        "x" .. _G.GameUtil.NumberToUnitStr(_G.StorageManager:GetInstance():GetItemCountBySid(id))
    local count = require "SecretModel":GetInstance():GetNexAward() or 0
    self.go_table.aortext_next.text = _G.string.format(_G.LangUtil.GetLangPackValue(90024700031), count)
end

---初始化Map地图
function SecretView:InitMap()
    if self.GridList then
        for k, v in pairs(self.GridList) do
            v:Show(k)
        end
    else
        self.GridList = {}
        for i = 1, self.go_table.obj_Map:GetChildCountE() do
            local y = 6 - _G.math.ceil(i / 7)
            local x = i - (5 - y) * 7
            self.GridList[x * 1000 + y] =
                require "SecretGridItem".New(self.go_table.obj_Map:GetChildE(i - 1), (5 - y) * 0.2 + x * 0.2)
            self.GridList[x * 1000 + y]:Show(x * 1000 + y)
        end
    end
end

---更新格子显示
function SecretView:UpdateGridShow()
    for _, v in pairs(self.GridList) do
        v:UpdateShow()
    end
end

---更新自选奖励
function SecretView:UpdateChoose()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_changeIcon, self.infoData.a_index > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_addIcon, self.infoData.a_index > 0)
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_add,
        self.infoData.a_index <= 0 and not require "SecretModel":GetInstance().isGetAuto
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ItemNum, self.infoData.a_index > 0)
    if self.infoData.a_index > 0 and (self.floor ~= self.infoData.id or self.a_index ~= self.infoData.a_index) then
        self.a_index = self.infoData.a_index
        self.floor = self.infoData.id
        local awardData = _G.ConfigManager.secret_area_cfg[self.infoData.id].item_select[self.infoData.a_index]
        local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
        self.go_table.aorrawimage_addIcon:LoadImage(data.Icon)
        _G.UIUtils.SetItemNum(self.go_table, data:GetCount())
        if self.chooseEffect then
            _G.GameUtil.SetActiveByCondition(self.chooseEffect, false)
            _G.GameUtil.SetActiveByCondition(self.chooseEffect, true)
        end
    end
end

---按钮点击事件在这里派发
function SecretView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_bag then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretBagView.Name)
    elseif go == self.go_table.aorbtn_change then
        if require "SecretModel":GetInstance():CheckIsGetAuto() then
            return
        end
        if require "SecretManager":GetInstance():CheckIsQuick() then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SecretSelectView.Name,
            _G.handler(self, self.UpdateChoose)
        )
    elseif go == self.go_table.aorbtn_close then
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_way then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 32)
    elseif go == self.go_table.aorbtn_quick then
        self:OnQuick()
    end
end

function SecretView:OnQuick()
    if self.infoData.a_index <= 0 then
        return
    end
    if require "SecretManager":GetInstance():CheckIsQuick() then
        return
    end
    if require "SecretModel":GetInstance():CheckIsGetAuto() then
        _G.PopWindowManager:GetInstance():ShowAllTips(2714)
        return
    end
    _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
        2713,
        function()
            require "SecretManager":GetInstance():OnQuick(
                function(datas)
                    if not _G.table.isEmptyOrNil(datas) then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretQuickView.Name, datas)
                    else
                        local keyTb = require "SecretModel":GetInstance().keyTb
                        if not _G.StorageManager:GetInstance():CheckItem(keyTb[1], keyTb[2]) then
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, keyTb[1])
                            return
                        end
                    end
                end
            )
        end,
        nil,
        nil,
        true
    )
end

---刷新界面
function SecretView:RefreshPanel()
    self.infoData = require "SecretModel":GetInstance().infoData
    self:InitMap()
    self:UpdateChoose()
    self:UpdateTop()
    self:UpdateFloor()
    self:InitSlider()
    self.go_table.scrollloopvectical_awardList:UpdateAllItem()
end

function SecretView:RefreshKey()
    self:UpdateTop()
    self:UpdateFloor()
    self:InitSlider()
    self.go_table.scrollloopvectical_awardList:UpdateAllItem()
end

---刷新格子
function SecretView:RefreshGrid()
    self:UpdateGridShow()
    self:UpdateTop()
end

function SecretView:OnStartClose()
    require "SecretManager":GetInstance():StopQuick()
    if self.GridList then
        for _, v in pairs(self.GridList) do
            v:Dispose()
        end
    end
end

return SecretView
