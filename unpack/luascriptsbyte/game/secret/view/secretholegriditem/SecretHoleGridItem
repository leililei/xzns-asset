---@class SecretHoleGridItem	中文描述
---@field event secret.i_event
local SecretHoleGridItem = _G.BaseClass("SecretHoleGridItem")

---类的构造函数
function SecretHoleGridItem:__init(obj, callback)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.callback = callback
    self.eventEffect = {}
    self:InitEffect()
end

function SecretHoleGridItem:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_stone_posui,
        self.gameObject,
        function(trans)
            if _G.IsNil(trans) then
                _G.DestroyObject(trans)
                return
            end
            trans:SetRectOffSetToZero()
            self.lookEffect = trans
            _G.GameUtil.SetActiveByCondition(trans, false)
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zhandouyanwu,
        self.gameObject,
        function(trans)
            if _G.IsNil(trans) then
                _G.DestroyObject(trans)
                return
            end
            trans:SetRectOffSetToZero()
            self.battleEffect = trans
            _G.GameUtil.SetActiveByCondition(trans, false)
        end
    )
end

function SecretHoleGridItem:Show(xy)
    self.xy = xy
    self.event = require "SecretModel":GetInstance():GetHoleEvent(xy)
    if self.event then
        self.cfg = _G.ConfigManager.secret_event_cfg[self.event.id]
    end

    self:UpdateShow()
end
function SecretHoleGridItem:UpdateShow()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_di, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_icon, false)

    if not self.event then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_di, true)
    else
        -- if self.event.xy == 2002 then
        --     _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_di:GetChildE(0), self.event.is_finish == 0)
        --     return
        -- end
        if self.event.is_finish <= 0 then
            _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_icon, true)
            self.go_table.aorrawimage_icon:LoadImage(
                self.cfg.icon,
                function()
                    self.go_table.aorrawimage_icon:SetNativeSize()
                end
            )
            self:PlayEventEffect()
        else
            self:HideEventEffect()
        end
    end
end

function SecretHoleGridItem:OnClickBtn(go, isOn)
    if self.event and self.event.is_finish > 0 then
        return
    end
    if self.event then
        require "SecretModel":GetInstance():SetHoleEvent(self.event)
        require "SecretManager":GetInstance():OnTriggerEvent(
            self.event,
            function(data)
                if self.cfg.event_type == 2 and self.battleEffect then
                    self:PlayEffect(
                        self.battleEffect,
                        function()
                            require "CommonTipManager".OpenCommonAwardView(
                                data,
                                function()
                                    if require "SecretModel":GetInstance():CheckHoleEventFinsh() then
                                        require "SecretModel":GetInstance().HoldMap = nil
                                        require "SecretModel":GetInstance().curHoleEvent = nil
                                        require "SecretModel":GetInstance():FinishEvent()
                                    end
                                end
                            )
                        end
                    )
                    self:UpdateShow()

                    if self.callback then
                        self.callback()
                    end
                    self:HideEventEffect()
                else
                    self:UpdateShow()
                    if self.callback then
                        self.callback()
                    end
                    if require "SecretModel":GetInstance():CheckHoleEventFinsh() then
                        require "SecretModel":GetInstance().HoldMap = nil
                        require "SecretModel":GetInstance().curHoleEvent = nil
                        require "SecretModel":GetInstance():FinishEvent()
                    end
                end
            end,
            true
        )
    else
        require "SecretModel":GetInstance():LookGrid(
            self.xy,
            function(data)
                self.event = require "SecretModel":GetInstance():GetHoleEvent(self.xy)
                if self.event then
                    self.cfg = _G.ConfigManager.secret_event_cfg[self.event.id]
                end
                self:PlayEffect(self.lookEffect)
                self:UpdateShow()
                if self.callback then
                    self.callback()
                end
                if require "SecretModel":GetInstance():CheckHoleEventFinsh() then
                    require "SecretModel":GetInstance().HoldMap = nil
                    require "SecretModel":GetInstance().curHoleEvent = nil
                    require "SecretModel":GetInstance():FinishEvent()
                end
            end
        )
    end
end

function SecretHoleGridItem:PlayEventEffect()
    self:HideEventEffect()
    if self.eventEffect[self.cfg.event_type] then
        _G.GameUtil.SetActiveByCondition(self.eventEffect[self.cfg.event_type], true)
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[self.cfg.special],
            self.go_table.aorrawimage_icon,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.eventEffect[self.cfg.event_type] = trans
            end
        )
    end
end

function SecretHoleGridItem:HideEventEffect()
    for _, v in pairs(self.eventEffect) do
        _G.GameUtil.SetActiveByCondition(v, false)
    end
end

function SecretHoleGridItem:PlayEffect(effect, call)
    if effect then
        _G.GameUtil.SetActiveByCondition(effect, true)
        self.isEffect = true
        _G.DelayDo(
            0.6,
            function()
                if _G.IsNil(self.gameObject) then
                    return
                end
                self.isEffect = false
                _G.GameUtil.SetActiveByCondition(effect, false)
                if call then
                    call()
                end
            end
        )
    else
        if call then
            call()
        end
    end
end

---类的析构函数
function SecretHoleGridItem:Dispose()
end

return SecretHoleGridItem
