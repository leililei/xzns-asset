---@class SecretQuickView : UIBaseView	中文描述
---@field public go_table SecretQuickView_GoTable GoTable
local SecretQuickView = _G.BaseClass("SecretQuickView", _G.UIBaseView)
--_G.SecretQuickView = SecretQuickView
local GetLangPackValue = _G.GetLangPackValue
local typeLanguId = {
    [1] = 91024700032,
    [2] = 91024700033,
    [4] = 91024700034,
    [9] = 91024700035
}

function SecretQuickView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretQuickView:OnCreate(datas)
    if _G.table.isEmptyOrNil(datas) then
        return
    end
    self.datas = datas
    self.keys = _G.table.keys(datas)
    _G.table.sort(
        self.keys,
        function(a, b)
            return a < b
        end
    )
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.keys, _G.handler(self, self.RefreshItem))
end

function SecretQuickView:RefreshItem(index, obj)
    local data = self.datas[self.keys[index + 1]]
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aortext_title.text = GetLangPackValue(typeLanguId[data.id], data.count)
    go_table.trans_content:ClearChildren()
    if not _G.table.isEmptyOrNil(data.award) then
        for i = 1, #data.award do
            _G.StorageManager:GetInstance():GetItemBaseView(
                data.award[i][1],
                data.award[i][2],
                go_table.trans_content,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    item.go_table.gameObject:SetRectTransformSize(88,88)
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                end
            )
        end
    end
end

---按钮点击事件在这里派发
function SecretQuickView:OnClickBtn(go)
    self:Close()
end

return SecretQuickView
