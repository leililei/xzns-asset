---@class SecreBoxView : UIBaseView	中文描述
---@field public go_table SecreBoxView_GoTable GoTable
local SecreBoxView = _G.BaseClass("SecreBoxView", _G.UIBaseView)
--_G.SecreBoxView = SecreBoxView

function SecreBoxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param event secret.i_event
function SecreBoxView:OnCreate(event, callback, isHole)
    self.callback = callback
    if event then
        self.eventData = event
    elseif isHole then
        self.eventData = require "SecretModel":GetInstance().curHoleEvent
    else
        self.eventData = require "SecretModel":GetInstance().curEvent
    end
    self.eventCfg = _G.ConfigManager.secret_event_cfg[self.eventData.id]
    self:InitView()
end

function SecreBoxView:InitView()
    self.go_table.aortext_question_desdawan.text = _G.LangUtil.GetLangPackValue(self.eventCfg.desc)
    self.item = _G.GetAutoGoTable(self.go_table.obj_item)
    local all = _G.StorageManager:GetInstance():GetItemCountBySid(self.eventCfg.consumption[1])
    if all == 0 then
        local data = require "SecretModel":GetInstance():GetItemData(self.eventCfg.consumption[1])
        all = data and data.v or 0
    end

    local consume = self.eventCfg.consumption[2] or 0
    all = _G.math.min(all, consume)
    self.isEnough = all >= consume
    if all > consume then
        self.item.aortext_num.text =
            _G.string.format("%s/%s", _G.GameUtil.NumberToUnitStr(all), _G.GameUtil.NumberToUnitStr(consume))
    else
        self.item.aortext_num.text =
            _G.string.format(
            "<color=#922222>%s</color>/%s",
            _G.GameUtil.NumberToUnitStr(all),
            _G.GameUtil.NumberToUnitStr(consume)
        )
    end
    self.go_table.aorbtn_resolt:SetGray(not self.isEnough)
end

---按钮点击事件在这里派发
function SecreBoxView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    elseif go == self.go_table.aorbtn_resolt then
        if self.isEnough then
            require "SecretModel":GetInstance():FinishEvent(
                {self.eventCfg.consumption[1]},
                function(data)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SecretResultView.Name,
                        self.eventCfg,
                        "Images/nSecret/ui-plbk-txt-ssdbx",
                        data,
                        function()
                            self:Close()
                        end
                    )
                    require "SecretModel":GetInstance():ConsumeItem(
                        self.eventCfg.consumption[1],
                        self.eventCfg.consumption[2]
                    )
                    if self.callback then
                        self.callback()
                    end
                end
            )
        end
    elseif go == self.go_table.aorbtn_unKey then
        require "SecretModel":GetInstance():FinishEvent(
            nil,
            function(data)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretResultView.Name,
                    self.eventCfg,
                    "Images/nSecret/ui-plbk-txt-ssdbx",
                    data,
                    function()
                        self:Close()
                    end
                )
                if self.callback then
                    self.callback()
                end
            end
        )
    end
end

return SecreBoxView
