---@class SecretFloatTipsView : UIBaseView	中文描述
---@field public go_table SecretFloatTipsView_GoTable GoTable
local SecretFloatTipsView = _G.BaseClass("SecretFloatTipsView", _G.UIBaseView)
local GameUtil = _G.GameUtil

function SecretFloatTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.curTips = nil
end

---界面的入口函数
function SecretFloatTipsView:OnCreate(data,callback)
    self.awardDatas = {}
    self.allcount = 0
    self:Show(data,callback)
end
---@param data award.i_award
function SecretFloatTipsView:Show(data,callback)
    self.stopTimer = 0.2
    if (data.isTreasure == true) then
        self.stopTimer = 5
    end
    self.callback = callback
    local data = _G.StorageManager:GetInstance():MergeAward(data)
    self.allcount= self.allcount+ #data
    self:ShowSingleItem(data)
end

function SecretFloatTipsView:ShowSingleItem(datas)
    if (self.curTips ~= nil) then
        _G.DestroyObject(self.curTips)
        self.curTips = nil
    end
    local _obj = _G.GameObject()
    _obj:SetParentE(self.transform)
    local count = #datas
    local index = 0
    local canvasGrounp = _obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    for i = 1, count do
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Secret/TipItem",
            _G.ePoolType.Temporary,
            self.transform,
            function(trans)
                self.curTips = _obj
                index = index + 1
                self.item = _G.GetAutoGoTable(trans)
                local data2 = _G.StorageManager:GetInstance():GetItemDataClassByCfg(datas[i])
                self.item.aorimage_icon.SpriteName = _G.string.replace(data2:GetIconPath(), "Images/Icon/", "")
                self.item.aortext_content.color = GameUtil.GetColorByQuality(data2.Grade)
                self.item.aortext_content.text = data2:GetName() .. 
                    _G.string.AddColor("x" .. GameUtil.NumberToUnitStr(data2:GetCount()),"ffffff")
                trans:SetAnchorPosition(0, (index - 1) * 60)
                trans:SetParentE(_obj)
                if index == count then
                    _G.CommonUIEffect:GetInstance():UpAndFade(
                        _obj,
                        111.9,
                        0.2,
                        self.stopTimer,
                        canvasGrounp,
                        0.2,
                        function()
                            if not _G.IsNil(_obj) then
                                _G.DestroyObject(_obj)
                            end
                            self.curTips = nil
                            self:ShowEnd()
                        end
                    )
                end
            end
        )
    end
end

function SecretFloatTipsView:ShowEnd(trans)
    self.allcount=self.allcount-1
    if self.allcount<=0 then
        if self.callback then
            self.callback()
        end 
       self:Close()
    end
end

---按钮点击事件在这里派发
function SecretFloatTipsView:OnClickBtn()
end

return SecretFloatTipsView
