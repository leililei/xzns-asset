function SecretMonsterView:RefreshAward(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.AwardList[instanceID]
    local awardData = self.eventCfg.rewards[index + 1]
    local data = _G.StorageManager:GetInstance():GetItemDataClass(awardData[1], awardData[2] * self.awardScale)
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 85)
        self.AwardList[instanceID] = item
    end
    item:Show(data)
end

function SecretMonsterView:OnClickItem(go, isOn, item)
    if isOn then
        self.curChooseItem = self.ItemDatas[item.index]
        self:UpdateShow()
    end
end

function SecretMonsterView:InitView()
    --self.go_table.aorimage_icon.SpriteName = self.eventCfg.icon1
    self.go_table.aortext_question_desdawan.text = _G.LangUtil.GetLangPackValue(self.eventCfg.desc)
    local all = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Material, self.eventCfg.consumption[1])
    if all == 0 then
        local data = require "SecretModel":GetInstance():GetItemData(self.eventCfg.consumption[1])
        all = data and data.v or 0
    end
    local consume = self.eventCfg.consumption[2]
    -- local icon = _G.StorageManager:GetInstance():GetItemIcon(self.eventCfg.consumption[1])
    -- local str = _G.string.split2tbl(icon, "/")
    -- if not _G.table.isEmptyOrNil(str) then
    --     self.go_table.aorimage_icon.SpriteName = str[#str]
    -- end
    self.go_table.aorrawimage_icon:LoadImage(self.eventCfg.icon1)
    self.isEnough = all >= consume
    if all > consume then
        self.go_table.aortext_cusumeNum.text = _G.string.format("%d", consume, all)
    else
        self.go_table.aortext_cusumeNum.text = _G.string.format("<color=#922222>%d</color>", consume, all)
    end
    local icon = _G.StorageManager:GetInstance():GetItemIcon(self.eventCfg.consumption[1])
    local str = _G.string.split2tbl(icon, "/")
    if not _G.table.isEmptyOrNil(str) then
        self.go_table.aorimage_cusumeIcon.SpriteName = str[#str]
    end
end

---按钮点击事件在这里派发
function SecretMonsterView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    elseif go == self.go_table.aorbtn_resolt then
        if self.isEnough then
            require "SecretModel":GetInstance():FinishEvent(
                nil,
                function(data)
                    require "SecretModel":GetInstance():ConsumeItem(
                        self.eventCfg.consumption[1],
                        self.eventCfg.consumption[2]
                    )
                    if self.eventCfg.consumption[1] == require "SecretModel":GetInstance().keyTb[1] then
                        require "SecretModel":GetInstance().infoData.cost =
                            require "SecretModel":GetInstance().infoData.cost + self.eventCfg.consumption[2]
                        _G.Events:GetInstance():Broadcast(_G.eSecret.RefreshSecretKey)
                    end
                    if self.callback then
                        self.callback(data)
                    end
                    self:Close()
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                self.eventCfg.consumption[1]
            )
        end
    end
end

return SecretMonsterView
