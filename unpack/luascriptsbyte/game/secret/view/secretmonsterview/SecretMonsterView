        self.eventData = require "SecretModel":GetInstance().curEvent
    end

    self.eventCfg = _G.ConfigManager.secret_event_cfg[self.eventData.id]
    self.ItemDatas = {}
    self.itemList = {}
    self.AwardList = {}
    self.curChooseItem = nil
    self.awardScale = 1
    self.consumeScale = 1
    --  self:InitData()
    self.callback = callback
    -- self.go_table.scrollloophorizontal_award:InitItemData(#self.ItemDatas, _G.handler(self, self.RefreshItem))
    --    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_label, #self.ItemDatas == 0)
    local count = #self.eventCfg.rewards
    self.go_table.scrollloophorizontal_award:UpdateScrollRectWeight(20 + 96 * count + (count - 1) * 38)
    self.go_table.scrollloophorizontal_award:InitItemData(count, _G.handler(self, self.RefreshAward))
    self:InitView()
end

