---@class SecretBagView : UIBaseView	中文描述
---@field public go_table SecretBagView_GoTable GoTable
---@field itemList SecretBagView._obj_item_GoTable[]
local SecretBagView = _G.BaseClass("SecretBagView", _G.UIBaseView)
--_G.SecretBagView = SecretBagView

function SecretBagView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretBagView:OnCreate()
    self.bagDatas = require "SecretModel":GetInstance():GetAllItemDataToArray()
    self.itemList = {}
    local count = #self.bagDatas
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_nil, count <= 0)
    self.go_table.aortext_nil.text =
        _G.LangUtil.GetLangPackValue(90022501300) .. "\n" .. _G.LangUtil.GetLangPackValue(90022501301)
    self.go_table.scrollloophorizontal_BagList:InitItemData(#self.bagDatas, _G.handler(self, self.RefreshItems))
end

function SecretBagView:RefreshItems(index, obj)
    local instanceIDE = obj:GetInstanceIDE()
    local item = self.itemList[instanceIDE]
    local cfg = _G.ConfigManager.item_cfg[self.bagDatas[index + 1].k]
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemList[instanceIDE] = item
    end
    if cfg then
        item.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
        item.aorrawimage_icon:LoadImage(cfg.Icon)
        item.aortext_desc.text = _G.LangUtil.GetLangPackValue(cfg.Describe)
    end
    item.aortext_num.text = _G.GameUtil.NumberToUnitStr(self.bagDatas[index + 1].v)
end

---按钮点击事件在这里派发
function SecretBagView:OnClickBtn()
    self:Close()
end

return SecretBagView
