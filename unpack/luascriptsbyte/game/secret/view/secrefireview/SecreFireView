---@class SecreFireView : UIBaseView	中文描述
---@field public go_table SecreFireView_GoTable GoTable
local SecreFireView = _G.BaseClass("SecreFireView", _G.UIBaseView)
--_G.SecreFireView = SecreFireView
function SecreFireView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param event secret.i_event
function SecreFireView:OnCreate(event, callback)
    if event then
        self.eventData = event
    else
        self.eventData = require "SecretModel":GetInstance().curEvent
    end
    self.eventCfg = _G.ConfigManager.secret_event_cfg[self.eventData.id]
    self.callback = callback
    self:InitView()
end

function SecreFireView:InitView()
    self.go_table.aortext_question_desdawan.text = _G.LangUtil.GetLangPackValue(self.eventCfg.desc)
    self.go_table.aorrawimage_icon:LoadImage(
        self.eventCfg.icon1,
        function()
            self.go_table.aorrawimage_icon:SetNativeSize()
        end
    )
    self.item = require "itemViewNewWithCount".New(self.go_table.obj_item:GetChildE(0):GetChildE(0))
    self.item:Show(
        self.eventCfg.consumption[1],
        function()
            -- body
        end,
        self.eventCfg.consumption[2]
    )
    local all = _G.StorageManager:GetInstance():GetItemCountBySid(self.eventCfg.consumption[1])
    if all == 0 then
        local data = require "SecretModel":GetInstance():GetItemData(self.eventCfg.consumption[1])
        all = data and data.v or 0
    end
    local consume = self.eventCfg.consumption[2]
    self.isEnough = all >= consume
    self.go_table.aorbtn_resolt:SetGray(not self.isEnough)
end

---按钮点击事件在这里派发
function SecreFireView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_anyclose then
        self:Close()
    elseif go == self.go_table.aorbtn_resolt then
        if self.isEnough then
            require "SecretModel":GetInstance():FinishEvent(
                {self.eventCfg.consumption[1]},
                function(data)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SecretResultView.Name,
                        self.eventCfg,
                        "Images/nSecret/ui-plbk-txt-ssdbx",
                        data,
                        function()
                            self:Close()
                        end
                    )
                    require "SecretModel":GetInstance():ConsumeItem(
                        self.eventCfg.consumption[1],
                        self.eventCfg.consumption[2]
                    )
                    if self.callback then
                        self.callback()
                    end
                end
            )
        end
    end
end

return SecreFireView
