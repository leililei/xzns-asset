---@class SecretHoleView : UIBaseView	中文描述
---@field public go_table SecretHoleView_GoTable GoTable
---@field GridList SecretHoleGridItem[]
local SecretHoleView = _G.BaseClass("SecretHoleView", _G.UIBaseView)
--_G.SecretHoleView = SecretHoleView

function SecretHoleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretHoleView:OnCreate()
    self:InitMap()
    self:UpdateTop()
    local icon = _G.StorageManager:GetInstance():GetItemIcon(_G.ConfigManager.discrete_cfg[104401][1][1])
    local str = _G.string.split2tbl(icon, "/")
    if not _G.table.isEmptyOrNil(str) then
        self.go_table.aorimage_key.SpriteName = str[#str]
    end
end

function SecretHoleView:InitMap()
    local SecretModel = require "SecretModel":GetInstance()
    if self.GridList then
        for k, v in pairs(self.GridList) do
            v:Show(k)
        end
    else
        self.GridList = {}
        for i = self.go_table.obj_Map:GetChildCountE(), 1, -1 do
            local y = _G.math.ceil(i / 3)
            local x = i - (y - 1) * 3
            self.GridList[x * 1000 + y] =
                require "SecretHoleGridItem".New(
                self.go_table.obj_Map:GetChildE(9 - i),
                function()
                    self:UpdateTop()
                end
            )
            self.GridList[x * 1000 + y]:Show(x * 1000 + y)
        end
    end
end

function SecretHoleView:UpdateTop()
    local id = _G.ConfigManager.discrete_cfg[104401][1][1]
    self.go_table.aortext_keyNum.text =
        "x" .. _G.GameUtil.NumberToUnitStr(_G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Material, id))
end

---按钮点击事件在这里派发
function SecretHoleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_bag then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretBagView.Name)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_next then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_black, false)
    end
end

function SecretHoleView:OnStartClose()
    require "SecretModel":GetInstance():ExitHoldMap()
end

return SecretHoleView
