---@class SecretManager : Singleton	中文描述
local SecretManager = _G.BaseClass("SecretManager", _G.Singleton)

---@return SecretManager SecretManager
function SecretManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SecretManager:__init()
    self.isNext = false
end

---销毁对象时,析构函数
function SecretManager:Dispose()
end

---触发事件
---@param event secret.i_event 事件id
function SecretManager:OnTriggerEvent(event, callback, isHole)
    local model = require "SecretModel":GetInstance()
    local cfg = _G.ConfigManager.secret_event_cfg[event.id]
    if not cfg then
        return
    end
    if not isHole then
        model:SetCurEvent(event.xy)
    end
    if cfg.event_type == 2 then
        if isHole then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretMonsterView.Name, event, callback)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretMonsterView.Name, nil, callback)
        end
    elseif cfg.event_type == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecreBoxView.Name, nil, callback, isHole)
    elseif cfg.event_type == 4 then
        local cfg2 = _G.ConfigManager.secret_npc_cfg[event.args[1]]
        if cfg2.answer2 == 0 then
            model:FinishEvent(
                {1},
                function(data)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SecretResultView.Name,
                        cfg,
                        "Images/nSecret/ui-plbk-txt-kmldkw",
                        data,
                        function()
                            if callback then
                                callback()
                            end
                        end,
                        cfg2.answer1
                    )
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretQuestionView.Name, callback)
        end
    elseif cfg.event_type == 5 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretHoleView.Name, callback)
    elseif cfg.event_type == 6 then
        if event.is_finish > 0 then
            self.isNext = true
        else
            self.isNext = false
        end
        if self.isNext then
            model:FinishEvent(
                {1},
                function(data)
                    self.isNext = false
                    model:GetInfo()
                    ---通关了一轮了
                    if model.infoData.id == model.maxFloor then
                        require "PopUpGiftBagModel":GetInstance():IsSecretFullOnce()
                    end
                end
            )
        else
            model:FinishEvent(
                {0},
                function(data)
                    self.isNext=true
                    require "CommonTipManager".OpenCommonAwardView(data)
                    if callback then
                        callback(data)
                    end
                end
            )
        end
    elseif cfg.event_type == 8 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecreFireView.Name, event, callback)
    elseif cfg.event_type == 9 then
        model:FinishEvent(
            {},
            function(data)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretResultView.Name,
                    cfg,
                    "Images/nSecret/ui-plbk-txt-ybdbx",
                    data
                )
                if callback then
                    callback(data)
                end
            end
        )
    elseif cfg.event_type == 10 then
        model:FinishEvent(
            {},
            function(data)
                if callback then
                    callback(data)
                end
            end
        )
    end
end

---快速挖格子
function SecretManager:OnQuick(callback)
    self.isQuick = true
    local model = require "SecretModel":GetInstance()
    model:OnQuick(
        function(datas)
            self.isQuick = false
            local storageType, storageID
            local StorageManager = _G.StorageManager:GetInstance()
            for _, v in pairs(datas) do
                v.award = StorageManager:MergeAward(v)
                local tb = {}
                local check = {}
                for _, v2 in pairs(v.award) do
                    storageType, storageID = StorageManager:CheckSidType(v2[1])
                    if
                        storageID == _G.StorageID.Card or storageID == _G.StorageID.Equipment or
                            storageID == _G.StorageID.Decoration
                     then
                        _G.table.insert(tb, v2)
                    else
                        if not check[v2[1]] then
                            check[v2[1]] = v2[2]
                        else
                            check[v2[1]] = check[v2[1]] + v2[2]
                        end
                    end
                end
                for k, v2 in pairs(check) do
                    _G.table.insert(tb, {k, v2})
                end
                v.award = tb
            end
            callback(datas)
        end
    )
end
---检测是否进行快速
function SecretManager:CheckIsQuick()
    return self.isQuick
end
---停止快速挖掘
function SecretManager:StopQuick()
    self.isQuick = false
end

return SecretManager
