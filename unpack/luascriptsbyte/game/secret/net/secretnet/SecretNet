---@class SecretNet : BaseGameNet	通信协议
local SecretNet = _G.BaseClass("SecretNet", require "BaseGameNet")
local base = require "BaseGameNet"

---@return SecretNet SecretNet
function SecretNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function SecretNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_secret_get_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---完成事件
function SecretNet:FinshEvent(pbData, callback)
    local item = _G.ConfigManager.net_map.game_secret_finish_event
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---设置自选奖励
function SecretNet:SetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_secret_set_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---探索格子
function SecretNet:LookGrid(pbData, callback)
    local item = _G.ConfigManager.net_map.game_secret_look_over
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---消耗钥匙领奖
function SecretNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_secret_npc_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
