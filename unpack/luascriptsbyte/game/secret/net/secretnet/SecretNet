function SecretNet:GetCusumeAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_secret_get_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SecretNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type SecretNet
_G.SecretNet = SecretNet
return SecretNet
