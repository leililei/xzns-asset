---@class GroupBattleStartView : UIBaseView	中文描述
---@field public go_table GroupBattleStartView_GoTable GoTable
local GroupBattleStartView = _G.BaseClass("GroupBattleStartView", _G.UIBaseView)
local str={
    [1] = 90024600074,
    [2] = 90024600075,
    [3] = 90024600076
}
function GroupBattleStartView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GroupBattleStartView:OnCreate(index,leftData,rightData,data,isWin,enemyData,fight_arg,uid)
    self.isWin = isWin
    self.enemyData = enemyData
    self.PveData = data
    self.index = index
    self.fight_arg = fight_arg
    self.reportType = 3
    self.playback_uid = uid
    self.leftTable = _G.GetAutoGoTable(self.go_table.obj_left)
    self.rightTable = _G.GetAutoGoTable(self.go_table.obj_right)
    self.go_table.aortext_level.text = _G.GetLangPackValue(str[index])
    self:InitEmbattle(leftData,rightData)
end

function GroupBattleStartView:InitEmbattle(leftData,rightData)
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    local leftObj,rightObj
    if self.isWin == 0 then
        self.leftTable.obj_leftWin:SetActiveE(1)
        self.rightTable.obj_rightFail:SetActiveE(1)
        self.leftTable.aortext_winName.text = PlayerModelIns:GetName()
        self.rightTable.aortext_failName.text = self.enemyData.name
        leftObj = self.leftTable.obj_winContent
        rightObj = self.rightTable.obj_failContent
    else
        self.leftTable.obj_leftFail:SetActiveE(1)
        self.rightTable.obj_rightWin:SetActiveE(1)
        self.leftTable.aortext_failName.text = PlayerModelIns:GetName()
        self.rightTable.aortext_winName.text = self.enemyData.name
        leftObj = self.leftTable.obj_failContent
        rightObj = self.rightTable.obj_winContent
    end
    for k,v in pairs(leftData) do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            leftObj,
            _G.handlerbind(self, self.showItemHeadInfo, v)
        )
    end
    for k,v in pairs(rightData) do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            rightObj,
            _G.handlerbind(self, self.showItemHeadInfo, v)
        )
    end
end

function GroupBattleStartView:showItemHeadInfo(item, cardData)
    item:ShowCardData(cardData, nil)
    item:ShowLevel(cardData.lv)
    item.gameObject:SetLocalScaleXYZ(0.6)
end

---界面的销毁函数
function GroupBattleStartView:OnDestroy()
end

---按钮点击事件在这里派发
function GroupBattleStartView:OnClickBtn(go)
    if go == self.go_table.aorbtn_start then
        self:Close()
        _G.BattleManager:GetInstance():SetBattlePause(false)
    elseif go == self.go_table.aorbtn_total then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            {self.PveData[self.index]},
            {self.isWin},
            nil,
            nil,
            self.enemyData,
            1,
            true,
            self.fight_arg,
            nil,
            {self.playback_uid},
            self.reportType,
            1,
            nil,
            nil,
            nil,
            self.needChangeTag
        )
    end
end

return GroupBattleStartView