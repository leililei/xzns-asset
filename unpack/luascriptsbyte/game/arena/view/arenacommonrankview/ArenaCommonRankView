---@class ArenaCommonRankView : UIBaseView    中文描述
---@field public go_table ArenaCommonRankView_GoTable GoTable
local ArenaCommonRankView = _G.BaseClass("ArenaCommonRankView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable

function ArenaCommonRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local arena_rank_cfg = _G.ConfigManager.arena_rank_cfg
local prize = {
    {"ui_icon_diyi","ui_di_diban1"},
    {"ui_icon_dier","ui_di_diban2"},
    {"ui_icon_disan","ui_di_diban3"},
    {"","TY_img_kuang"}
}

function ArenaCommonRankView:OnCreate(rankList, awardIDLis, rank, power)
    self.rankList = rankList
    self.awardIDLis = awardIDLis
    self.rank = rank
    self.power = power
    local count = _G.Mathf.Min(100, #self.rankList)
    self:InitPlayer(self.rank)
    self.go_table.scrollloopvectical_itemList:InitItemData(count, _G.handler(self, self.RefreshList))
end

function ArenaCommonRankView:RefreshList(index, obj)
    index = index + 1
    ---@type ArenaCommonRankView._obj_item_GoTable
    local tb = GetAutoGoTable(obj)
    if index <= 3 then
        tb.aorimage_bg.SpriteName = prize[index][2]
        tb.aorimage_rank.enabled = true
        tb.aorimage_rank.SpriteName = prize[index][1]
        tb.aorimage_rank:SetNativeSize()
        tb.aortext_rankNum.color = _G.ColorTools.FormatColorByString("fffaeb")
        tb.aortext_rankNum:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Outline)).enabled = true
    else
        tb.aorimage_bg.SpriteName = prize[4][2]
        tb.aorimage_rank.enabled = false
        tb.aortext_rankNum.color = _G.ColorTools.FormatColorByString("5a4112")
        tb.aortext_rankNum:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Outline)).enabled = false
    end
    tb.aortext_rankNum.text = index
    local data = self.rankList[index]
    tb.aortext_name.text = data.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false, function()
        if data.type ~= 1 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        else
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(data.uid, nil, _G.RobotType.Arena)
        end
    end)
    local rewards = self:GetAwards(index)
    tb.trans_Content:ClearChildren()
    for i = 1, #rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[i],
            tb.trans_Content,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end
end

function ArenaCommonRankView:GetAwards(index)
    local awards, type, sid
    for i, v in pairs(self.awardIDLis) do
        if index >= arena_rank_cfg[v].min_rank and index <= arena_rank_cfg[v].max_rank then
            awards = {}
            for _, a in pairs(arena_rank_cfg[v].reward_daily) do
                _G.table.insert(awards, a)
            end
            if not _G.table.isEmptyOrNil(arena_rank_cfg[v].reward_appearance) then
                for _, eff in pairs(arena_rank_cfg[v].reward_appearance) do
                    type = eff[1]
                    sid = _G.tostring(eff[2])
                    for k, item in pairs(_G.ConfigManager.item_cfg) do
                        if item.UseType == type and item.UseParameter[1][1] == sid then
                            _G.table.insert(awards, {item.ID, 1})
                            break
                        end
                    end
                end
            end
            return awards
        end
    end
    return {}
end

function ArenaCommonRankView:InitPlayer(index)
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_player)
    if index == 0 then
        tb.aortext_rankNum.text = _G.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = index
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_power.text =_G.GameUtil.NumberToUnitStrFight(self.power)
    local rewards = self:GetAwards(index)
    for i = 1, #rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[i],
            tb.trans_Content,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false)
end

---按钮点击事件在这里派发
function ArenaCommonRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return ArenaCommonRankView
