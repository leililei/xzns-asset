local descStr = _G.GetLangPackValue(90022100108)
--region 段位item
local ArenaElementLevelAwardItem = _G.BaseClass("ArenaElementLevelAwardItem")

function ArenaElementLevelAwardItem:__init(obj, getCall, arenaClass)
    self.arenaClass = arenaClass
    self.gameObject = obj
    self.getAwardCallback = getCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
end
function ArenaElementLevelAwardItem:Dispose()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = nil
    self.curRankID = nil
    self.gameObject = nil
    self.getAwardCallback = nil
    self.go_table = nil
    self.arenaClass = nil
end
---按钮点击事件在这里派发
function ArenaElementLevelAwardItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_get then
        self.arenaClass:GetRankAward(self.curRankID, _G.handler(self, self.OnAwardGetCall))
    end
end
function ArenaElementLevelAwardItem:OnAwardGetCall(state, data)
    if state then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        if self.getAwardCallback then
            self.getAwardCallback()
        end
    end
end
function ArenaElementLevelAwardItem:Show(id, getCall)
    self.gameObject:SetActiveE(1)
    self.curRankID = id
    local cfg = _G.ConfigManager.arena_league_elem_cfg[id]
    self.go_table.aortext_score.text = _G.string.format(descStr, cfg.min_score)
    self:ShowAward(cfg.reward_level)
    self:ShowAwardState()
end
---显示奖励
function ArenaElementLevelAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_itemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
---显示领取状态
function ArenaElementLevelAwardItem:ShowAwardState()
    self.go_table.aorbtn_get:SetActiveE(0)
    self.go_table.obj_gray:SetActiveE(0)
    self.go_table.obj_alreadyGet:SetActiveE(0)
    local controller = require("ArenaController"):GetInstance()
    if self.arenaClass:GetRankAwardState(self.curRankID) then
        self.go_table.obj_alreadyGet:SetActiveE(1)
    elseif controller:CheckRankAwardTo(self.curRankID, _G.ConfigManager.arena_league_elem_cfg, self.arenaClass.sid) then
        self.go_table.aorbtn_get:SetActiveE(1)
    else
        self.go_table.obj_gray:SetActiveE(1)
    end
end
--endregion

---@class ArenaElementLevelAwardView : UIBaseView	中文描述
---@field public go_table ArenaLevelAwardView_GoTable GoTable
local ArenaElementLevelAwardView = _G.BaseClass("ArenaElementLevelAwardView", _G.UIBaseView)

function ArenaElementLevelAwardView:Awake()
    self.itemTransDic = {}
end
function ArenaElementLevelAwardView:EscClose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.ArenaElementAwardPageView.Name
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName).View
    if self.curView then
        self.curView:Close()
    end
    self:Close()
end
---界面的入口函数
function ArenaElementLevelAwardView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element)
    self.go_table.scrollloopvectical_award:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.cfgs = {}
    for id, value in pairs(_G.ConfigManager.arena_league_elem_cfg) do
        if #value.reward_level > 0 then
            _G.table.insert(self.cfgs, id)
        end
    end
    self:SortItem(true)
end
function ArenaElementLevelAwardView:Close()
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end
function ArenaElementLevelAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] =
            ArenaElementLevelAwardItem.New(obj, _G.handler(self, self.SortItem), self.arenaClass)
    end
    self.itemTransDic[instanceID]:Show(self.cfgs[index])
end

function ArenaElementLevelAwardView:SortItem(init)
    local controller = require("ArenaController"):GetInstance()
    local geta, getb, canGetA, canGetB
    _G.table.sort(
        self.cfgs,
        function(a, b)
            geta = self.arenaClass:GetRankAwardState(a)
            getb = self.arenaClass:GetRankAwardState(b)
            canGetA =
                not geta and controller:CheckRankAwardTo(a, _G.ConfigManager.arena_league_elem_cfg, self.arenaClass.sid)
            canGetB =
                not getb and controller:CheckRankAwardTo(b, _G.ConfigManager.arena_league_elem_cfg, self.arenaClass.sid)
            if canGetA ~= canGetB then
                return canGetA
            end
            if not geta and not getb then
                return a > b
            elseif geta and getb then
                return a < b
            elseif geta then
                return false
            end
            return true
        end
    )
    if init then
        self.go_table.scrollloopvectical_award:UpdateCount(#self.cfgs)
    else
        self.go_table.scrollloopvectical_award:UpdateAllItem()
    end
end

return ArenaElementLevelAwardView
