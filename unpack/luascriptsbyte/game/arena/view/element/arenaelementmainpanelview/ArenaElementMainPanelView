---检查五行有没有变化
---@return boolean
function ArenaElementMainPanelView:CheckElementChanged(element)
    if (element[1] <= 0 or element[2] <= 0) then
        return false
    end

    local lastElement1 = _G.PlayerPrefsManager.GetInt("LastArenaElement1")
    local lastElement2 = _G.PlayerPrefsManager.GetInt("LastArenaElement2")
    local curElement1 = element[1]
    local curElement2 = element[2]
    ---如果上次五行数据和这次一样，判断为五行没有变化
    if (lastElement1 == curElement1 and lastElement2 == curElement2) then
        return false
    end

    ---如果上一次五行没有数据(0,0),或者五行和上次不同，判断为五行有变化
    _G.PlayerPrefsManager.SetInt("LastArenaElement1", element[1])
    _G.PlayerPrefsManager.SetInt("LastArenaElement2", element[2])
    return true
end

function ArenaElementMainPanelView:OnSettleUiClosed(name)
    if (name == _G.ConfigManager.ui_cfg.ArenaElementSeasonEndView.Name) then
        self:AddEmbattleEft()
        _G.PlayerPrefsManager.SetInt("ArenaEmbattleFEfg", 1)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnSettleUiClosed, self)
    end
end

return ArenaElementMainPanelView
