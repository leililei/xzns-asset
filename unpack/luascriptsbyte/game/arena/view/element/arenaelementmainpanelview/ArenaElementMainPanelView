local ArenaManager = require "ArenaManager"
local ArenaController = require "ArenaController"
--region 排位item
local UIUtils = _G.UIUtils
local ArenaElementRankItem = _G.BaseClass("ArenaElementRankItem")
local needEmbattleEfg = 0
function ArenaElementRankItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClick))
end

function ArenaElementRankItem:Dispose()
    self.go_table = nil
    self.data = nil
end

---显示
---@param data table 排行榜单个数据
--[[
   required string name = 1;//名字
   required uint32 score = 2;//积分
   optional string guild = 3;//公会名
   required uint32 title = 4;//称号
   required uint32 style = 5;//头像
   required uint32 level = 6;//等级
   required uint64 uid = 7;//uid
   required uint32 type= 8; // 类型，1为npc，2为玩家
   required uint32 frame=9;//头像框
   required uint32 power = 10;//队伍战斗力
   ]]
function ArenaElementRankItem:Show(data)
    self.data = data
    if data.rank <= 3 then
        self.go_table.aorimage_rank:SetActiveE(1)
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.aorimage_rankBG:SetActiveE(1)
        self.go_table.aorimage_rank.SpriteName = string.format("tz_qjhs_phb_mingci_0%d", data.rank)
        self.go_table.aorimage_rankBG.SpriteName = string.format("tz_qjhs_di_0%d", data.rank + 1)
    else
        self.go_table.aorimage_rank:SetActiveE(0)
        self.go_table.aorimage_rankBG:SetActiveE(0)
        self.go_table.aortext_rank:SetActiveE(1)
        self.go_table.aortext_rank.text = data.rank
    end
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_score.text = data.score
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.power)
    UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase,
        data,
        1,
        true,
        nil,
        nil,
        function()
            if self.data.type ~= 1 then
                if self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                else
                    _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
                end
            else
                _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(self.data.uid, nil, _G.RobotType.Arena)
            end
        end
    )
end

function ArenaElementRankItem:OnClick(go)
    if go == self.go_table.aorbtn_Click then
        if self.data.type ~= 1 then
            if self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
            end
        else
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(self.data.uid, nil, _G.RobotType.Arena)
        end
    end
end

--endregion
---@class ArenaElementMainPanelView : UIBaseView	中文描述
---@field public go_table ArenaElementMainPanelView_GoTable GoTable
local ArenaElementMainPanelView = _G.BaseClass("ArenaElementMainPanelView", _G.UIBaseView)

function ArenaElementMainPanelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
end

---界面的入口函数
function ArenaElementMainPanelView:OnCreate()
    local ArenaManager = require("ArenaManager")
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element)
    self.boxes = {false, false, false}
    self.boxes[1] = {
        ["icon"] = self.go_table.aorimage_box1,
        ["getTag"] = self.go_table.obj_getTag1,
        ["num"] = self.go_table.aortext_awardNum1
        -- ["redpoint"] = self.go_table.obj_redpointbox1
    }
    self.boxes[2] = {
        ["icon"] = self.go_table.aorimage_box2,
        ["getTag"] = self.go_table.obj_getTag2,
        ["num"] = self.go_table.aortext_awardNum2
        -- ["redpoint"] = self.go_table.obj_redpointbox2
    }
    self.boxes[3] = {
        ["icon"] = self.go_table.aorimage_box3,
        ["getTag"] = self.go_table.obj_getTag3,
        ["num"] = self.go_table.aortext_awardNum3
        -- ["redpoint"] = self.go_table.obj_redpointbox3
    }
    local cfg = _G.ConfigManager.arena_info_cfg[ArenaManager.arenaType.element]
    self.points_con = {cfg.points_con1, cfg.points_con2, cfg.points_con3}
    -- for i = 1, #self.boxes do
    --     self.boxes[i].redpoint:UpdateRedPointItemIDAndParam(
    --         _G.ConfigManager.redpoint_cfg.ArenaElementBoxAward.id,
    --         self.points_con[i]
    --     )
    -- end
    self.arenaClass:SetListenerRefresh(_G.handler(self, self.RefreshView), self.viewName)
    self:AddComponent(
        self.go_table.obj_resourceRoot,
        require("ResourceCompont").New(
            self.go_table.obj_resourceRoot,
            _G.ConfigManager.ui_cfg.ArenaElementMainPanelView.resources
        )
    )
    self:ShowRank()
    self:ShowSeasonView()
    self:InitView()
    self:ShowBox()
end

---界面的销毁函数
function ArenaElementMainPanelView:OnDestroy()
    self.arenaClass:GetEndTime(nil)
    self.arenaClass:SetListenerRefresh(nil, self.viewName)
    self.arenaClass = nil
end

---按钮点击事件在这里派发
function ArenaElementMainPanelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_award then
        --TODO:打开奖励界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaElementAwardPageView.Name)
    elseif go == self.go_table.aorbtn_box1 then
        self:OnBoxClick(1)
    elseif go == self.go_table.aorbtn_box2 then
        self:OnBoxClick(2)
    elseif go == self.go_table.aorbtn_box3 then
        self:OnBoxClick(3)
    elseif go == self.go_table.aorbtn_report then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaReportPanel.Name,
            ArenaManager.arenaType.element
        )
    elseif go == self.go_table.aorbtn_shop then
        require "ShopModel":GetInstance():OpenShop(_G.ShopID.PVP)
    elseif go == self.go_table.aorbtn_embattle then
        local function OnEmbattleViewOpen(self, name)
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
            self:Close()
        end
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
        self.arenaClass:OpenEmbattleDefence()
        _G.PlayerPrefsManager.SetInt("ArenaEmbattleFEfg", 0)
    elseif go == self.go_table.aorbtn_CloseView then
        ArenaController:GetInstance():OpenChooseArenaPanel(_G.handler(self, self.Close))
    elseif go == self.go_table.aorbtn_start then
        --TODO:打开挑战列表
        if self.arenaClass:GetCurArenaState() == 1 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaElementChallengeView.Name)
        else
            local closeFun = function()
                self:Close()
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(300301, nil, closeFun, closeFun)
        end
    elseif go == self.go_table.aorbtn_CloseView2 then
        self.go_table.obj_guide:SetActiveE(0)
        self.go_table.aorbtn_CloseView2:SetActiveE(0)
        local function OnEmbattleViewOpen(self, name)
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
            self:Close()
        end
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
        self.arenaClass:OpenEmbattleDefence()
        _G.PlayerPrefsManager.SetInt("ArenaEmbattleFEfg", 0)
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 93)
    end
end

function ArenaElementMainPanelView:RefreshView()
    if self.arenaClass:GetCurArenaState() == ArenaManager.State.open then
        self:InitView()
        self:ShowBox()
        ArenaController:GetInstance():GetRankList(
            function(list)
                self:OnRankRefresh(list)
            end
        )
    end
end

function ArenaElementMainPanelView:ShowSeasonView()
    if self.arenaClass:CheckSeasonAwardState() then
        self.arenaClass:GetSeasonAward(
            function(success, msg)
                if success then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaElementSeasonEndView.Name, msg)
                end
            end
        )
    end
end

function ArenaElementMainPanelView:InitView()
    self.go_table.aortext_rank.text = self.arenaClass:GetRank()
    local score = self.arenaClass:GetScore()
    self.go_table.aortext_score.text = score
    self.go_table.aortext_free.text =
        string.format(_G.GetLangPackValue(90022100106), self.arenaClass:GetFreeFightTimes())
    self.go_table.aortext_power.text =
        _G.GameUtil.NumberToUnitWord(
        require("EmbattleModel"):GetInstance():GetEmbattlePowerWithoutMetatable(_G.EmbattleType.arenaElementDefence)
    )
    self.arenaClass:GetEndTime(_G.handler(self, self.TimeUpdate))
    local element = self.arenaClass:GetLockElement()
    local iconStr = _G.ElementIconName
    self.go_table.aorimage_element1.SpriteName = iconStr[element[1]]
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_xiandingwuxing, self.go_table.obj_effect1)
    self.go_table.aorimage_element2.SpriteName = iconStr[element[2]]
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_xiandingwuxing, self.go_table.obj_effect2)

    ---检查五行有没有变化，如果有变化就给布阵添加特效
    ---或者变化了但是玩家一直没点，也加特效，直到玩家点了
    ---element[1] = 1
    ---element[2] = 2
    needEmbattleEfg = _G.PlayerPrefsManager.GetInt("ArenaEmbattleFEfg")
    if ((self:CheckElementChanged(element) == true) or (needEmbattleEfg == 1)) then
        if (self.arenaClass:CheckSeasonAwardState()) then
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnSettleUiClosed, self)
        else
            self:AddEmbattleEft()
            _G.PlayerPrefsManager.SetInt("ArenaEmbattleFEfg", 1)
        end
    end

    local cfg = ArenaController:GetInstance():GetLeagueCfg(score, _G.ConfigManager.arena_league_elem_cfg)
    if cfg then
        self.go_table.aorrawimage_league:LoadImage(
            cfg.icon,
            function()
                self.go_table.aorrawimage_league:SetNativeSize()
            end
        )
        self.go_table.aortext_league.text = _G.GetLangPackValue(cfg.name)
    end
end

function ArenaElementMainPanelView:TimeUpdate(time)
    local timeStr
    self.updateTimeTab = _G.TimeUtil.TranslateSecond(time, self.updateTimeTab)
    if self.updateTimeTab.day > 0 then
        timeStr =
            _G.string.format(_G.LangUtil.GetLangPackValue(90022100001), self.updateTimeTab.day, self.updateTimeTab.hour)
    elseif self.updateTimeTab.hour > 0 then
        timeStr =
            _G.string.format(_G.LangUtil.GetLangPackValue(90022100002), self.updateTimeTab.hour, self.updateTimeTab.min)
    else
        timeStr =
            _G.string.format(_G.LangUtil.GetLangPackValue(90021800086), self.updateTimeTab.min, self.updateTimeTab.sec)
    end
    self.go_table.aortext_time.text = timeStr
end

local boxBarValue = {0.33, 0.67, 1}
local boxEffect = "Ef_ArenaBaoxiangNew"
function ArenaElementMainPanelView:ShowBox()
    local winTimes = self.arenaClass:GetWinNum()
    self.go_table.aortext_awardCount.text = winTimes
    local per = 1
    local perSet = false
    for i = 1, #self.boxes do
        if not perSet and winTimes < self.points_con[i] then
            if i == 1 then
                per = (winTimes / self.points_con[i]) * boxBarValue[1]
            else
                per =
                    ((winTimes - self.points_con[i - 1]) / (self.points_con[i] - self.points_con[i - 1])) *
                    (boxBarValue[i] - boxBarValue[i - 1]) +
                    boxBarValue[i - 1]
            end
            perSet = true
        end
        self.boxes[i].getTag:SetActiveE(0)
        self.boxes[i].icon:DisposeChildren()
        if self.arenaClass:GetWinBoxState(self.points_con[i]) then
            self.boxes[i].getTag:SetActiveE(1)
        elseif winTimes >= self.points_con[i] then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[boxEffect], self.boxes[i].icon)
        end
        self.boxes[i].icon:SetNativeSize()
        self.boxes[i].num.text = self.points_con[i]
    end
    self.go_table.aorimage_boxBar.fillAmount = per
end

function ArenaElementMainPanelView:OnBoxClick(index)
    local controller = ArenaController:GetInstance()
    if self.arenaClass:GetWinBoxState(self.points_con[index]) then
        controller:OpenBoxAwardPre(index)
        return
    end
    local winTimes = self.arenaClass:GetWinNum()
    local boxIds = {}
    for _, v in pairs(self.points_con) do
        if winTimes >= v and not self.arenaClass:GetWinBoxState(v) then
            _G.table.insert(boxIds, v)
        end
    end
    if #boxIds > 0 then
        self.arenaClass:GetAwardByWin(boxIds, _G.handler(self, self.ShowBox))
    else
        controller:OpenBoxAwardPre(index)
    end
end

--region 排行榜
function ArenaElementMainPanelView:ShowRank()
    self.itemTransDic = {}
    ArenaController:GetInstance():GetRankList(_G.handler(self, self.OnRankListCall))
end

function ArenaElementMainPanelView:OnRankListCall(list)
    self.rankList = list
    self.go_table.scrollloopvectical_rank:InitItemData(#list, _G.handler(self, self.RefreshItem))
end

function ArenaElementMainPanelView:OnRankRefresh(list)
    self.rankList = list
    self.go_table.scrollloopvectical_rank:UpdateCount(#list)
end

function ArenaElementMainPanelView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaElementRankItem.New(obj)
    end
    self.itemTransDic[instanceID]:Show(self.rankList[index])
end

--endregion

