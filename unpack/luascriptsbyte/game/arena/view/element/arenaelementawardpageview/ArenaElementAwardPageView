local pageIndex = {
    rank = 2,
    season = 1
}
---@class ArenaElementAwardPageView : UIBaseView	中文描述
---@field public go_table ArenaElementAwardPageView_GoTable GoTable
local ArenaElementAwardPageView = _G.BaseClass("ArenaElementAwardPageView", _G.UIBaseView)

function ArenaElementAwardPageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function ArenaElementAwardPageView:OnCreate()
    self.curView = nil
    self.curViewIndex = 0
    self.choose = {
        self.go_table.obj_choose2,
        self.go_table.obj_choose1
    }
    self.onBtnTag = true
    self:OnSeasonToggleClick()
end

function ArenaElementAwardPageView:OnDestroy()
    self.curView = nil
    self.curViewIndex = nil
    self.onBtnTag = nil
    self.choose = nil
end

---按钮点击事件在这里派发
function ArenaElementAwardPageView:OnClickBtn(go)
    if self.onBtnTag then
        return
    end
    self.onBtnTag = true
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_shadow then
        self.curView:Close()
        self:Close()
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    elseif go == self.go_table.aorbtn_rank then
        self:OnLevelToggleClick()
    elseif go == self.go_table.aorbtn_season then
        self:OnSeasonToggleClick()
    end
end

function ArenaElementAwardPageView:OnLevelToggleClick()
    if self.curViewIndex == pageIndex.rank then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
    end
    self.curViewIndex = pageIndex.rank
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.ArenaElementLevelAwardView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName).View
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.pageSwitchAuido)
end

function ArenaElementAwardPageView:OnSeasonToggleClick()
    if self.curViewIndex == pageIndex.season then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
    end
    self.curViewIndex = pageIndex.season
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.ArenaElementSeasonAwardView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName).View
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.pageSwitchAuido)
end
function ArenaElementAwardPageView:ShowChoose()
    for i = 1, #self.choose do
        self.choose[i]:SetActiveE(i == self.curViewIndex and 1 or 0)
    end
end
function ArenaElementAwardPageView:OnViewOpen(name)
    if name ~= self.curOpenViewName then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.onBtnTag = false
    self.curView.transform:SetParentE(self.go_table.trans_panel)
    self.curView.transform:SetLocalScaleToOne()
end
return ArenaElementAwardPageView
