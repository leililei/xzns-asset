local ArenaManager = require "ArenaManager"
local ArenaController = require "ArenaController"
--region
local ArenaElementChallengeItem = _G.BaseClass("ArenaElementChallengeItem")

function ArenaElementChallengeItem:__init(obj, challengeCall, arenaClass)
    self.arenaClass = arenaClass
    self.gameObject = obj
    self.onChallengeCallback = challengeCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ArenaElementChallengeItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_chanllenge then
        if self.onChallengeCallback then
            require("EmbattleController"):GetInstance():CheckArenaDefenceIsEmpty(
                _G.EmbattleType.arenaElementDefence,
                _G.EmbattleSaveType.server,
                nil,
                _G.EmbattleControllerItemType.arenaElementDefence,
                function(v)
                    self.IsDefenceEmpty = v
                end
            )
            if (self.IsDefenceEmpty == false) then
                self.onChallengeCallback(self.enemyUid)
            elseif (self.IsDefenceEmpty == true) then
                _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90022100258))
                _G.UIManager:GetInstance():GetWindowCtrl("ArenaElementMainPanelView"):AddEmbattleEft()
                _G.UIManager:GetInstance():CloseWindow("ArenaElementChallengeView")
            end
        end
    elseif go == self.go_table.aorbtn_IconBtn then
        local enemy = self.arenaClass:GetEnemyDataByUid(self.enemyUid)
        if enemy.mType ~= 1 then
            ArenaController:GetInstance():ShowEnemyView(enemy)
        end
    end
end

function ArenaElementChallengeItem:Show(data, free, mpower, mscore, leaguecfg)
    self.enemyUid = data.uid
    self.go_table.aortext_score.text = data.score
    self.go_table.aortext_name.text = data.name
    if mpower and mpower < data.power then
        self.go_table.aortext_power.text =
            string.format("<color=#ff0000>%s</color>", _G.GameUtil.NumberToUnitWord(data.power))
    else
        self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.power)
    end
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_head, portraitCfg.portrait1)
    self.go_table.aortext_victoryScore.text =
        _G.string.format(
            _G.LangUtil.GetLangPackValue(90022100046),
            ArenaController:GetInstance():CalculateWinScore(data.score, leaguecfg, mscore)
        )
    if free then
        self.go_table.aortext_btnName.text = _G.GetLangPackValue(90023900001)
    else
        self.go_table.aortext_btnName.text = _G.GetLangPackValue(90022100045)
    end
    self.gameObject:SetActiveE(1)
end

--endregion

---@class ArenaElementChallengeView : UIBaseView	中文描述
---@field public go_table ArenaChanllengeView_GoTable GoTable
local ArenaElementChallengeView = _G.BaseClass("ArenaElementChallengeView", _G.UIBaseView)

function ArenaElementChallengeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaElementChallengeView:OnCreate()
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element)
    self.onChallengeHandler = _G.handler(self, self.OnChallengeBtn)
    self.itemList = {
        ArenaElementChallengeItem.New(self.go_table.obj_chanllengeItem1, self.onChallengeHandler, self.arenaClass),
        ArenaElementChallengeItem.New(self.go_table.obj_chanllengeItem2, self.onChallengeHandler, self.arenaClass),
        ArenaElementChallengeItem.New(self.go_table.obj_chanllengeItem3, self.onChallengeHandler, self.arenaClass),
        ArenaElementChallengeItem.New(self.go_table.obj_chanllengeItem4, self.onChallengeHandler, self.arenaClass)
    }
    for i = 1, #self.itemList do
        self.itemList[i].gameObject:SetActiveE(0)
    end
    self.refreshTime = 0
end

function ArenaElementChallengeView:OnEnable()
    self.freshTime = 0
    self.arenaClass:GetEnemyInfo(_G.handler(self, self.OnEnemyArrayCall))
    self.arenaClass:GetFreshTime(_G.handler(self, self.OnFreshBtnTimeCall))
    self.arenaClass:SetListenerRefresh(_G.handler(self, self.RefreshView), self.viewName)
    self:Show()
end

function ArenaElementChallengeView:OnDisable()
    self.arenaClass:SetListenerRefresh(nil, self.viewName)
    self.arenaClass:SetFreshTimeCall()
end

function ArenaElementChallengeView:OnDestroy()
    self.arenaClass = nil
    self.onChallengeHandler = nil
end

---按钮点击事件在这里派发
function ArenaElementChallengeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_shadow then
        self:Close()
    elseif go == self.go_table.aorbtn_chanllengeTimes then
        self.arenaClass:BuyTicket(_G.handler(self, self.OnBuyTicketCall))
    elseif go == self.go_table.aorbtn_fresh then
        self:FreshEnemy()
    end
end

function ArenaElementChallengeView:FreshEnemy()
    if self.refreshTime > 0 then --提示刷新时间
        _G.PopWindowManager:GetInstance():ShowAllTips(300106)
    else
        self.arenaClass:RefreshEnemy(_G.handler(self, self.OnEnemyArrayCall), _G.handler(self, self.OnFreshBtnTimeCall))
    end
end

function ArenaElementChallengeView:OnFreshCallback()
    ArenaController:GetInstance():GetEnemyArray(_G.handler(self, self.OnEnemyArrayCall))
end

function ArenaElementChallengeView:RefreshView()
    self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
end

function ArenaElementChallengeView:OnBuyTicketCall(result)
    if result == 1 then
        self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
    end
end

function ArenaElementChallengeView:OnFreshBtnTimeCall(time)
    self.refreshTime = time
    if self.refreshTime > 0 then
        self.go_table.aortext_fresh.text = _G.string.format(_G.GetLangPackValue(90026100037), self.refreshTime)
    else
        --刷新
        self.go_table.aortext_fresh.text = _G.GetLangPackValue(90021700009)
    end
end

function ArenaElementChallengeView:OnChallengeBtn(uid)
    if self.arenaClass:GetCurArenaState() ~= 1 then
        local closeFun = function()
            self:Close()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaElementMainPanelView.Name)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(300301, nil, closeFun, closeFun)
        return
    end
    if self.arenaClass:GetAllFightTimes() <= 0 then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(300101)
        self.arenaClass:BuyTicket(_G.handler(self, self.OnBuyTicketCall))
        return
    end
    self.arenaClass:Challenge(uid)
end

function ArenaElementChallengeView:Show()
    self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
end

function ArenaElementChallengeView:OnEnemyArrayCall(list)
    local times, sum = self.arenaClass:GetFreshEnemyTimes()
    self.go_table.aortext_freshtimes.text = string.format(_G.GetLangPackValue(90022100107), times, sum)
    local freeFight = self.arenaClass:GetFreeFightTimes() > 0
    local power = require("EmbattleModel"):GetInstance():GetEmbattlePower(_G.EmbattleType.arenaElementAttack)
    local leaguecfg = _G.ConfigManager.arena_league_elem_cfg
    for i = 1, #list do
        if i > #self.itemList then
            break
        end
        self.itemList[i]:Show(list[i], freeFight, power, self.arenaClass:GetScore(), leaguecfg[list[i].league])
    end
end

return ArenaElementChallengeView
