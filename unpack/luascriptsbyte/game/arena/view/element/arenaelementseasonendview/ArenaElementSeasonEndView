---@class ArenaElementSeasonEndView : UIBaseView	中文描述
---@field public go_table ArenaElementSeasonEndView_GoTable GoTable
local ArenaElementSeasonEndView = _G.BaseClass("ArenaElementSeasonEndView", _G.UIBaseView)

function ArenaElementSeasonEndView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
--[[
  required uint32 ack = 1;
  optional award.i_award award = 2;//奖励
  optional uint32 score = 3;//赛季最高积分
  repeated uint32 element = 4;//赛季五行
]]
function ArenaElementSeasonEndView:OnCreate(msg)
    local iconStr = _G.ElementIconName
    self.go_table.aorimage_element1.SpriteName = iconStr[msg.element[1]]
    self.go_table.aorimage_element2.SpriteName = iconStr[msg.element[2]]
    local cfg = require("ArenaController"):GetInstance():GetLeagueCfg(msg.score)
    if cfg then
        self.go_table.aorrawimage_icon:LoadImage(
            cfg.icon,
            function()
                self.go_table.aorrawimage_icon:SetNativeSize()
            end
        )
        local GetLangPackValue = _G.GetLangPackValue
        self.go_table.aortext_league.text = GetLangPackValue(90023300131, GetLangPackValue(cfg.name))
    end
    self.awardData = _G.StorageManager:GetInstance():MergeAward(msg)
    if self.awardData then
        local ItemFactoryIns = _G.ItemFactory:GetInstance()
        local type = _G.ItemFactory.itemType.ItemBaseWithCount
        local handler = _G.handler(self, self.OnItemCall)
        self.curShowIndex = 1
        for i = 1, #self.awardData do
            ItemFactoryIns:GetItemCard(type, self.go_table.trans_itemRoot, handler)
        end
    end
end

---界面的销毁函数
function ArenaElementSeasonEndView:OnDestroy()
    self.awardData = nil
    self.curShowIndex = nil
end
---按钮点击事件在这里派发
function ArenaElementSeasonEndView:OnClickBtn(go)
    self:Close()
end

function ArenaElementSeasonEndView:OnItemCall(item)
    local data = self.awardData[self.curShowIndex]
    item:Show(data[1], nil, data[2])
    self.curShowIndex = self.curShowIndex + 1
end

return ArenaElementSeasonEndView
