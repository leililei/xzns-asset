local ArenaManager = require "ArenaManager"
local descStr = _G.GetLangPackValue(90022100112)
local descStr2 = _G.GetLangPackValue(90022100121)
local descStr3 = _G.GetLangPackValue(90022100122)
--region 奖励item
local ArenaElementRankAwardItem = _G.BaseClass("ArenaElementRankAwardItem")

local rankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04",
    "ui_jjc_pic_jinjijl"
}
local rankIconName = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
function ArenaElementRankAwardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.itemList = {}
end
function ArenaElementRankAwardItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end
---显示
---@param id number 奖励id
---@param index number 排名序列号
---@return 变量类型 中文描述
function ArenaElementRankAwardItem:Show(id, index)
    self.gameObject:SetActiveE(1)
    self:ShowDay(id, index)
end
function ArenaElementRankAwardItem:ShowDay(id, index)
    local cfg = _G.ConfigManager.arena_rank_cfg[id]
    local str = ""
    if cfg.min_rank == cfg.max_rank then
        str = string.format(descStr, cfg.min_rank)
    else
        if cfg.max_rank >= 9999 then
            str = string.format(descStr3, cfg.min_rank)
        else
            str = string.format(descStr2, cfg.min_rank, cfg.max_rank)
        end
    end
    self.go_table.aortext_mScoreRank.text = str
    if index <= 3 then
        self.go_table.aorimage_rank.SpriteName = rankIconName[index]
        self.go_table.aorimage_rankbg.SpriteName = rankBgName[index]
        self.go_table.aorimage_rank:SetActiveE(1)
    else
        self.go_table.aorimage_rankbg.SpriteName = rankBgName[4]
        self.go_table.aorimage_rank:SetActiveE(0)
    end
    self:ShowAward(cfg.reward_daily)
end
function ArenaElementRankAwardItem:ShowSeason(id)
    local cfg = _G.ConfigManager.arena_league_elem_cfg[id]
    self.go_table.aorrawimage_duanwei:LoadImage(cfg.icon)
    self.go_table.aortext_level.text = _G.LangUtil.GetLangPackValue(cfg.name)
    self:ShowAward(cfg.reward_season)
end
---显示奖励
function ArenaElementRankAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
--endregion

---@class ArenaElementRankAwardView : UIBaseView	中文描述
---@field public go_table ArenaRankAwardView_GoTable GoTable
local ArenaElementRankAwardView = _G.BaseClass("ArenaElementRankAwardView", _G.UIBaseView)

function ArenaElementRankAwardView:Awake()
    self.itemList = {}
    self.itemTransDic = {}
    self.awardList = {}
end

---界面的入口函数
function ArenaElementRankAwardView:OnCreate()
    self:ShowList()
    self:ShowMyRank()
end
function ArenaElementRankAwardView:Close()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end

function ArenaElementRankAwardView:ShowList()
    self.awardList = _G.DeepCopyCfgTable(_G.ConfigManager.arena_info_cfg[ArenaManager.arenaType.element].rank)
    self.go_table.scrollloopvectical_award:InitItemData(#self.awardList, _G.handler(self, self.RefreshItem))
end

function ArenaElementRankAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaElementRankAwardItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.awardList[index], index)
end

function ArenaElementRankAwardView:ShowMyRank()
    local award = {}
    --我的排名
    local rank = require("ArenaController"):GetInstance():GetRank()
    self.go_table.aortext_mNumber.text = rank
    local arena_rank_cfg = _G.ConfigManager.arena_rank_cfg
    for i = 1, #self.awardList do
        local value = arena_rank_cfg[self.awardList[i]]
        if value.min_rank <= rank and value.max_rank >= rank then
            award = value.reward_daily
            if value.min_rank == value.max_rank then
                self.go_table.aortext_mScoreRank.text = string.format(descStr, value.min_rank)
            else
                if value.max_rank >= 9999 then
                    self.go_table.aortext_mScoreRank.text = string.format(descStr3, value.min_rank)
                else
                    self.go_table.aortext_mScoreRank.text = string.format(descStr2, value.min_rank, value.max_rank)
                end
            end
            break
        end
    end
    local ItemFactory = _G.ItemFactory
    self.itemList = {}
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                _G.table.insert(self.itemList, item)
            end
        )
    end
end

return ArenaElementRankAwardView
