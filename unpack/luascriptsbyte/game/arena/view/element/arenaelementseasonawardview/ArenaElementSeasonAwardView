local descStr = _G.GetLangPackValue(90022100108)
--region 奖励item
local ArenaElementSeasonAwardItem = _G.BaseClass("ArenaRankAwardItem")

function ArenaElementSeasonAwardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.itemList = {}
end
function ArenaElementSeasonAwardItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end
---显示
---@param id number 奖励id
---@return 变量类型 中文描述
function ArenaElementSeasonAwardItem:Show(id)
    self.gameObject:SetActiveE(1)
    self:ShowDay(id)
end
function ArenaElementSeasonAwardItem:ShowDay(id)
    local cfg = _G.ConfigManager.arena_league_elem_cfg[id]
    self.go_table.aortext_mScoreRank.text = string.format(descStr, cfg.min_score)
    self:ShowAward(cfg.reward_season)
end
---显示奖励
function ArenaElementSeasonAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
--endregion

---@class ArenaRankAwardView : UIBaseView	中文描述
---@field public go_table ArenaRankAwardView_GoTable GoTable
local ArenaElementSeasonAwardView = _G.BaseClass("ArenaRankAwardView", _G.UIBaseView)

function ArenaElementSeasonAwardView:Awake()
    self.itemList = {}
    self.itemTransDic = {}
    self.awardList = {}
end

---界面的入口函数
function ArenaElementSeasonAwardView:OnCreate()
    self:ShowList()
    self:ShowMyRank()
end
function ArenaElementSeasonAwardView:Close()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end
function ArenaElementSeasonAwardView:EscClose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.ArenaElementAwardPageView.Name
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName).View
    if self.curView then
        self.curView:Close()
    end
    self:Close()
end
function ArenaElementSeasonAwardView:ShowList()
    self.awardList = {}
    local insert = _G.table.insert
    for id, value in pairs(_G.ConfigManager.arena_league_elem_cfg) do
        if #value.reward_season > 0 then
            insert(self.awardList, id)
        end
    end
    _G.table.sort(
        self.awardList,
        function(a, b)
            return a > b
        end
    )
    self.go_table.scrollloopvectical_award:InitItemData(#self.awardList, _G.handler(self, self.RefreshItem))
end

function ArenaElementSeasonAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaElementSeasonAwardItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.awardList[index])
end

function ArenaElementSeasonAwardView:ShowMyRank()
    local award = {}
    local ArenaManager = require "ArenaManager"
    --我的积分
    local score = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element):GetScore()
    self.go_table.aortext_mNumber.text = score
    for key, value in pairs(_G.ConfigManager.arena_league_elem_cfg) do
        if value.min_score <= score and value.max_score >= score then
            award = value.reward_season
            --100714 展示最低段位满足的积分对应离散表ID
            self.go_table.aortext_mScoreRank.text =
                string.format(
                descStr,
                value.min_score > 0 and value.min_score or _G.ConfigManager.discrete_cfg[100714][1][1]
            )
            break
        end
    end
    local ItemFactory = _G.ItemFactory
    self.itemList = {}
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                _G.table.insert(self.itemList, item)
            end
        )
    end
end

return ArenaElementSeasonAwardView
