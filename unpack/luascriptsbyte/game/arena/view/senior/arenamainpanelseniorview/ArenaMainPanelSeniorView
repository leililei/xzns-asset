local TrackingPointModel = require("TrackingPointModel")
local ArenaManager = require "ArenaManager"
local ArenaController = require "ArenaController"
local format = _G.string.format
local UIUtils = _G.UIUtils
--高阶竞技场SID
local ArenaSeniorSid = 2
local GetLangPackValue = _G.GetLangPackValue
--region 排位item
local ArenaRankSeniorItem = _G.BaseClass("ArenaRankSeniorItem")

function ArenaRankSeniorItem:__init(obj)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClick))
end

function ArenaRankSeniorItem:Dispose()
    self.data = nil
    self.gameObject = nil
    self.transform = nil
    self.go_table = nil
end
---显示
---@param data table 排行榜单个数据
--[[
   required uint64 uid=1;
   required string name = 2;//名字
   required uint32 style = 3;//头像
   required uint32 frame = 4;//头像框
   required uint32 level = 5;//等级
   required uint32 power = 6;//战力
   required uint32 type = 7;//1， 机器人，2，玩家
   ]]
function ArenaRankSeniorItem:Show(data)
    self.data = data
    local leagueCfg = ArenaController:GetInstance():CalculateSeniorLeagueByRank(data.rank)
    if leagueCfg then
        self.go_table.aorrawimage_rankIcon:LoadImage(leagueCfg.icon)
        local str = GetLangPackValue(leagueCfg.name)
        if ArenaController:GetInstance():CheckKing(leagueCfg.level) then
            str = str .. "·" .. data.rank
        end
        self.go_table.aortext_rankname.text = str
    end
    UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase,
        data,
        1,
        true,
        nil,
        nil,
        function()
            if self.data.type ~= 1 then
                if self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                else
                    _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
                end
            else
                _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(self.data.uid, nil, _G.RobotType.ArenaSenior)
            end
        end
    )
    if data.rank <= 3 then
        self.go_table.aorimage_rank:SetActiveE(1)
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.aorimage_rank.SpriteName = format("tz_qjhs_phb_mingci_0%d", data.rank)
    else
        self.go_table.aorimage_rank:SetActiveE(0)
        self.go_table.aortext_rank:SetActiveE(1)
        self.go_table.aortext_rank.text = data.rank
    end
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.power)
end

function ArenaRankSeniorItem:OnClick(go)
    if go == self.go_table.aorbtn_click then
        if self.data.type ~= 1 then
            if self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
            end
        else
            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(self.data.uid, nil, _G.RobotType.ArenaSenior)
        end
    end
end

--endregion

---@class ArenaMainPanelSeniorView : UIBaseView	中文描述
---@field public go_table ArenaMainPanelSeniorView_GoTable GoTable
local ArenaMainPanelSeniorView = _G.BaseClass("ArenaMainPanelSeniorView", require("ArenaSeniorRefreshBaseView"))

function ArenaMainPanelSeniorView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaMainPanelSeniorView:OnCreate()
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaSeniorSid)
    self:InitBaseInfo()
    self.arenaClass:GetRankList(_G.handler(self, self.InitRankInfo))
    self:AddComponent(
        self.go_table.obj_resourceRoot,
        require("ResourceCompont").New(
            self.go_table.obj_resourceRoot,
            _G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.resources
        )
    )
    local ArenaControllerIns = ArenaController:GetInstance()
    ArenaControllerIns:SetArenaLoginFirstByDay(2)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SeniorArena.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaEmbattleSenior.id)
    self.arenaClass:SetDataUpdateCall(_G.handler(self, self.OnDataUpdateCall))
    self.awardTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnAwardCountCall, self)
    self.awardTimer:Start()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.prf_xiahoudun,
        self.go_table.trans_spineRoot,
        function(effect)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
    self:AddListener(_G.eArena.RefreshSeniorView, self.RefreshView)
    self:AddListener(_G.eBattleState.RecordStart, self.Hide)
    self:AddListener(_G.eBattleState.RecordEnd, self.Show)
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
end

function ArenaMainPanelSeniorView:RefreshView()
    self:InitBaseInfo()
    self.arenaClass:GetRankList(_G.handler(self, self.InitRankInfo))
    ArenaController:GetInstance():SetArenaLoginFirstByDay(2)
    self.arenaClass:SetDataUpdateCall(_G.handler(self, self.OnDataUpdateCall))
end

function ArenaMainPanelSeniorView:OnDestroy()
    if self.awardTimer then
        self.awardTimer:Stop()
        self.awardTimer = nil
    end
    self.arenaClass:GetAwardCount(nil)
    self.arenaClass:SetDataUpdateCall(nil)
    self.arenaClass = nil
    self.rankItemDic = nil
    self.rankList = nil
end

---按钮点击事件在这里派发
function ArenaMainPanelSeniorView:OnClickBtn(go)
    if self.onBtnClickTag then
        return
    end
    self.onBtnClickTag = true
    if go == self.go_table.aorbtn_CloseView then --关闭
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        ArenaController:GetInstance():OpenChooseArenaPanel(_G.handler(self, self.Close))
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_award then --奖励
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaAwardSeniorView.Name)
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_help then --说明
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 29)
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_report then --战报
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaReportPanel.Name,
            ArenaManager.arenaType.senior
        )
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_shop then --商店
        require "ShopModel":GetInstance():OpenShop(_G.ShopID.PVP)
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_embattle then --布阵
        self.arenaClass:OpenEmbattleDefence()
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_start then --匹配
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.Name)
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_box then
        self.arenaClass:GetAward(_G.handler(self, self.OnGetAwardCall))
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 29)
        self.onBtnClickTag = false
    elseif go == self.go_table.aorbtn_topAward then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaTopAwardView.Name, 2)
        --self.onBtnClickTag = false
    end
end
function ArenaMainPanelSeniorView:OnDataUpdateCall()
    self.go_table.aortext_free.text = GetLangPackValue(90022100106, self.arenaClass:GetFreeFightTimes())
end
---初始化基础信息
function ArenaMainPanelSeniorView:InitBaseInfo()
    local rank = self.arenaClass:GetCurRank()
    local cfg = ArenaController:GetInstance():CalculateSeniorLeagueByRank(rank)
    self.go_table.aortext_award.text = GetLangPackValue(90022500402, cfg.efficiency)
    self:OnAwardCountCall()
    self.go_table.aortext_rank.text = rank
    --self.go_table.aorimage_rank.SpriteName = cfg.art
    local str = GetLangPackValue(cfg.name)
    if ArenaController:GetInstance():CheckKing(cfg.level) then
        str = str .. "·" .. rank
    end
    self.go_table.aortext_rankname.text = str
    self.go_table.aorrawimage_rankIcon:LoadImage(
        cfg.icon,
        function()
            self.go_table.aorrawimage_rankIcon:SetNativeSize()
        end
    )
    self.go_table.aortext_free.text = GetLangPackValue(90022100106, self.arenaClass:GetFreeFightTimes())
end
function ArenaMainPanelSeniorView:OnGetAwardCall(msg)
    if msg then
        self:OnAwardCountCall()
        --TODO:添加打开宝箱动画
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jingjichangbaoxiangkaiqi,
            self.go_table.aorbtn_box,
            function(effect)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(effect)
                else
                    if not _G.IsNil(self.getAwardEffectTrans) then
                        self.getAwardEffectTrans:SetActiveE(0)
                    end
                    self.go_table.obj_box:SetActiveE(1)
                end
            end,
            function()
                self.onBtnClickTag = false
                self.isCreateAwardEffect = false
                if not self:IsNil() then
                    require("CommonTipManager"):GetInstance():OpenDropTip(msg)
                end
            end
        )
    else
        self.onBtnClickTag = false
        self.isCreateAwardEffect = false
    end
end
function ArenaMainPanelSeniorView:CreateGetAwardEffect()
    if self.isCreateAwardEffect then
        return
    end
    --判定出现可领取的特效条件
    if self.arenaClass:GetAwardCount() > 0 then
        self.isCreateAwardEffect = true
        if _G.IsNil(self.getAwardEffectTrans) then
            --TODO:创建可领取特效
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jingjichangbaoxiangchixu,
                self.go_table.aorbtn_box,
                function(effect)
                    if self:IsNil() then
                        _G.UIUtils.RemoveEffect(effect)
                    else
                        self.go_table.obj_box:SetActiveE(0)
                        self.getAwardEffectTrans = effect
                    end
                end
            )
        else
            self.getAwardEffectTrans:SetActiveE(1)
        end
    end
end
---刷新奖励数量
---@param count number 奖励数量
function ArenaMainPanelSeniorView:OnAwardCountCall()
    self.go_table.aortext_score.text =
        string.format("%d/%d", self.arenaClass:GetAwardCount(), self.arenaClass:GetAwardMax())
    self:CreateGetAwardEffect()
end
---初始化排位信息
function ArenaMainPanelSeniorView:InitRankInfo(list)
    self.rankItemDic = {}
    self.rankList = list
    if not self.inited then
        self.go_table.scrollloopvectical_rank:InitItemData(#list, _G.handler(self, self.UpdateRankItem))
    else
        self.go_table.scrollloopvectical_rank:UpdateCount(#list)
    end
    self.inited = true
    self:OpenTopAwardOrRankView()
end

---打开外显（每日首次登录，赛季首次进入打开奖励界面，否则打开排行界面）
function ArenaMainPanelSeniorView:OpenTopAwardOrRankView()
    local key1 = "ArenaSeniorTopAwardSeason"
    local key2 = "ArenaSeniorRankDaily"
    local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    local awards = _G.ConfigManager.arena_info_cfg[2].rank_league
    local power = 0
    local EmbattleModel = require("EmbattleModel"):GetInstance()
    power = power + EmbattleModel:GetEmbattlePower(_G.EmbattleType.arenaSeniorDefence1)
    power = power + EmbattleModel:GetEmbattlePower(_G.EmbattleType.arenaSeniorDefence2)
    power = power + EmbattleModel:GetEmbattlePower(_G.EmbattleType.arenaSeniorDefence3)
    if self.arenaClass:GetSeason() ~= _G.PlayerPrefsManager.GetInt(key1) then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaTopAwardView.Name, 2, function()
        --    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaCommonRankView.Name, self.rankList, awards, self.arenaClass:GetCurRank(), power)
        --end)
        _G.PlayerPrefsManager.SetInt(key1, self.arenaClass:GetSeason())
        _G.PlayerPrefsManager.SetInt(key2, time)
    elseif time ~= _G.PlayerPrefsManager.GetInt(key2) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaCommonRankView.Name, self.rankList, awards, self.arenaClass:GetCurRank(), power)
        _G.PlayerPrefsManager.SetInt(key2, time)
    end
end

---列表刷新回调
---@param index number 循环列表回调序列号0开始
---@param obj UnityEngine.GameObject 循环使用的对象
function ArenaMainPanelSeniorView:UpdateRankItem(index, obj)
    local insID = obj:GetInstanceIDE()
    local item = self.rankItemDic[insID]
    if not item then
        item = ArenaRankSeniorItem.New(obj)
        self.rankItemDic[insID] = item
    end
    index = index + 1
    item:Show(self.rankList[index])
end

function ArenaMainPanelSeniorView:OnLeagueChanged()
    self:InitBaseInfo()
    self.arenaClass:GetRankList(_G.handler(self, self.UpdateRankList))
end

function ArenaMainPanelSeniorView:UpdateRankList(list)
    self.rankList = list
    self.go_table.scrollloopvectical_rank:UpdateCount(#list)
end

return ArenaMainPanelSeniorView
