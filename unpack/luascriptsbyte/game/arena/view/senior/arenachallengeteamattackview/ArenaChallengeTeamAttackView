local ArenaTeamCreate = realRequire "ArenaSeniorTeamItem"
---@class ArenaChallengeTeamAttackView : UIBaseView	中文描述
---@field public go_table ArenaChallengeTeamAttackView_GoTable GoTable
local ArenaChallengeTeamAttackView = _G.BaseClass("ArenaChallengeTeamAttackView", require("ArenaSeniorRefreshBaseView"))

function ArenaChallengeTeamAttackView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaChallengeTeamAttackView:OnCreate(changeCall, data, enemyTeam, enemyInfo, combSkill)
    self.onChangeCall = changeCall
    self.curShowIndex = {1, 2, 3}
    self.team = ArenaTeamCreate(self.go_table.obj_mTeam, true, _G.handler(self, self.OnTeamChanged))
    self.team:Show(data, combSkill)
    self.enemyTeam = ArenaTeamCreate(self.go_table.obj_eTeam)
    self.enemyTeam:Show(enemyTeam, enemyInfo.combSkill)
    self:ShowInfo(enemyInfo)
end

function ArenaChallengeTeamAttackView:OnDestroy()
    self.team:Dispose()
    self.team = nil
    self.onChangeCall = nil
    self.curShowIndex = nil
    self.enemyTeam:Dispose()
    self.enemyTeam = nil
end

---按钮点击事件在这里派发
function ArenaChallengeTeamAttackView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        self:Close()
        self.onChangeCall(self.curShowIndex)
    end
end

function ArenaChallengeTeamAttackView:OnTeamChanged(index1, index2)
    self.curShowIndex[index1] = self.curShowIndex[index1] + self.curShowIndex[index2]
    self.curShowIndex[index2] = self.curShowIndex[index1] - self.curShowIndex[index2]
    self.curShowIndex[index1] = self.curShowIndex[index1] - self.curShowIndex[index2]
end

function ArenaChallengeTeamAttackView:ShowInfo(data)
    local PlayerModel = _G.PlayerModel:GetInstance()
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[PlayerModel:GetRoleStyle()]
    if portraitCfg then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_mhead, portraitCfg.portrait1)
    end
    self.go_table.aortext_mlv.text = PlayerModel:GetLevel()
    self.go_table.aortext_mName.text = PlayerModel:GetName()

    local portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    if portraitCfg then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_ehead, portraitCfg.portrait1)
    end
    self.go_table.aortext_elv.text = data.level
    self.go_table.aortext_eName.text = data.name
end

function ArenaChallengeTeamAttackView:OnLeagueChanged()
    self:Close()
end

return ArenaChallengeTeamAttackView
