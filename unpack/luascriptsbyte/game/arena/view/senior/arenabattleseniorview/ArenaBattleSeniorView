--region高阶竞技场战斗界面顶部信息展示
local ArenaBattleInfoItem = _G.BaseClass("ArenaBattleInfoItem")
local resultImageName = {
    win = "ui_jjc_icon_sheng",
    lose = "ui_jjc_icon_bai"
}
function ArenaBattleInfoItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self.resultTags = {
        self.go_table.aorimage_result1,
        self.go_table.aorimage_result2,
        self.go_table.aorimage_result3
    }
end

function ArenaBattleInfoItem:Dispose()
    self.go_table = nil
    self.resultTags = nil
end
---展示
---@param data table 玩家数据
function ArenaBattleInfoItem:Show(data)
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_level.text = data.level
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    if portraitCfg then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_head, portraitCfg.portrait1)
    -- self.go_table.aorrawimage_head:LoadImage(portraitCfg.portrait1)
    end
    -- self.go_table.aorrawimage_color:LoadImage(_G.ConfigManager.player_frame_cfg[data.frame].frame)
end
---展示结果
---@param index number 场次
---@param win boolean 是否胜利
function ArenaBattleInfoItem:ShowResult(index, win)
    if win then
        self.resultTags[index].SpriteName = resultImageName.win
    else
        self.resultTags[index].SpriteName = resultImageName.lose
    end
    self.resultTags[index]:SetActiveE(1)
end
--endregion

---@class ArenaBattleSeniorView : UIBaseView	中文描述
---@field public go_table ArenaBattleSeniorView_GoTable GoTable
local ArenaBattleSeniorView = _G.BaseClass("ArenaBattleSeniorView", _G.UIBaseView)

function ArenaBattleSeniorView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.mPlayers = ArenaBattleInfoItem.New(self.go_table.obj_mInfo)
    self.ePlayers = ArenaBattleInfoItem.New(self.go_table.obj_eInfo)
end

---界面的入口函数
function ArenaBattleSeniorView:OnCreate(data)
    self.index = 1
    self.ePlayers:Show(data)
    local PlayerModel = _G.PlayerModel:GetInstance()
    self.mPlayers:Show(
        {
            name = PlayerModel:GetName(),
            frame = PlayerModel:GetCurFrame(),
            style = PlayerModel:GetRoleStyle(),
            level = PlayerModel:GetLevel()
        }
    )
end

function ArenaBattleSeniorView:OnDestroy()
    self.index = nil
    self.mPlayers:Dispose()
    self.ePlayers:Dispose()
    self.mPlayers = nil
    self.ePlayers = nil
    if self.showTipsTimer then
        self.showTipsTimer:Stop()
        self.showTipsTimer = nil
    end
end

function ArenaBattleSeniorView:OnClickBtn(go)
    if go == self.go_table.aorbtn_exit then
        local BattleManager = _G.BattleManager:GetInstance()
        BattleManager:SetBattlePause(true)
        -- _G.BattleManager.CSExitClick()

        _G.PopWindowManager:GetInstance():ShowAllTips(
            110104,
            nil,
            function()
                self:Close()
                if BattleManager.curBattleController then
                    BattleManager.curBattleController:EndFight()
                    _G.CS.BattleManager.Inst:UnLoadCinemachieCamera()
                end
            end,
            function()
                BattleManager:SetBattlePause(false)
            end
        )
    end
end

---战斗开始调用
function ArenaBattleSeniorView:OnBattleBegin(callback)
    if self:IsNil() then
        return
    end
    self.go_table.aortext_text.text = _G.GetLangPackValue(90024600006, self.index)
    self.go_table.obj_tips:SetActiveE(1)
    self.showTipsTimer =
        _G.TimerManager:GetInstance():GetTimer(
        1.5,
        self.ShowTipsTimerFunc,
        self,
        true,
        false,
        true,
        callback
    )
    self.showTipsTimer:Start()
end

function ArenaBattleSeniorView:ShowTipsTimerFunc(callback)
    self:OnShowTipsCall()
    if callback then
        callback()
    end
end

function ArenaBattleSeniorView:OnShowTipsCall()
    if self.go_table and self.go_table.obj_tips then
        self.go_table.obj_tips:SetActiveE(0)
    end
    self.showTipsTimer = nil
end
---战斗结束调用
---@param win boolean 己方是否胜利
function ArenaBattleSeniorView:OnBattleEnd(win)
    if not self.mPlayers then
        ---敌方空阵容时，在场景切换时点击跳过有概率调用此函数时页面已经销毁
        return
    end
    self.mPlayers:ShowResult(self.index, win)
    self.ePlayers:ShowResult(self.index, not win)
    self.index = self.index + 1
end

return ArenaBattleSeniorView
