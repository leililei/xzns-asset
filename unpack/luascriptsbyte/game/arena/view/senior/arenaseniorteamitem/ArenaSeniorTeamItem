--region 阵容展示卡牌
local ArenaTeamCardItem = _G.BaseClass("ArenaTeamCardItem")
---类的构造函数
function ArenaTeamCardItem:__init(obj)
    self.transform = obj
end
---类的析构函数
function ArenaTeamCardItem:Dispose()
    if self.card then
        self.card:Dispose()
        self.card = nil
    end
    self.transform = nil
end
---展示卡牌头像
---@param sid number 卡牌sid
---@param lv number 卡牌等级
---@param star number 卡牌星级
---@param soulLink_lv number 卡牌魂链等级
function ArenaTeamCardItem:Show(sid, lv, star, soulLink_lv)
    if sid <= 0 then
        if self.card then
            self.card.transform:SetActiveE(0)
        end
        return
    end
    if self.card then
        self.card:Show(sid, nil, star, soulLink_lv, lv)
        self.card.transform:SetActiveE(1)
    else
        local ItemCardFactory = _G.ItemCardFactory
        ItemCardFactory:GetInstance():GetItemCard(
            ItemCardFactory.itemCardType.CardAllItem,
            self.transform,
            function(item)
                self.card = item
                self.card:Show(sid, nil, star, soulLink_lv, lv)
            end
        )
    end
end
--endregion

--region 阵容展示组
local ArenaTeamItem = _G.BaseClass("ArenaTeamItem")

---类的构造函数
function ArenaTeamItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self.cards = {
        ArenaTeamCardItem.New(self.go_table.trans_card1),
        ArenaTeamCardItem.New(self.go_table.trans_card2),
        ArenaTeamCardItem.New(self.go_table.trans_card3),
        ArenaTeamCardItem.New(self.go_table.trans_card4),
        ArenaTeamCardItem.New(self.go_table.trans_card5)
    }
    self.skill = {
        {obj = self.go_table.obj_skill1, icon = self.go_table.aorrawimage_icon1, desc = self.go_table.aortext_type1},
        {obj = self.go_table.obj_skill2, icon = self.go_table.aorrawimage_icon2, desc = self.go_table.aortext_type2},
        {obj = self.go_table.obj_skill3, icon = self.go_table.aorrawimage_icon3, desc = self.go_table.aortext_type3}
    }
end
---类的析构函数
function ArenaTeamItem:Dispose()
    self.go_table = nil
    for i = 1, #self.cards do
        self.cards[i]:Dispose()
    end
end
---展示
---@param data table 展示数据
function ArenaTeamItem:Show(data, skills)
    local card
    local power = 0
    for i = 1, #data do
        card = data[i]
        self.cards[i]:Show(card.sid, card.level, card.star, card.soulLink_lv)
        power = power + card.power
    end
    if self.go_table.aortext_power then
        self.go_table.aortext_power.text = power
    end
    local cfgs = _G.ConfigManager.card_skills_cfg
    local bsCfgs = _G.ConfigManager.battle_skill_cfg
    local lanCfgs = _G.ConfigManager.language_package_cfg
    local cfg
    for i = 1, #skills do
        if skills[i] > 0 then
            cfg = cfgs[skills[i]]
            cfg = bsCfgs[cfg.skills[1]]
            if cfg.Icon == "" then
                self.skill[i].icon:LoadImage(cfgs[skills[i]].icon)
            else
                self.skill[i].icon:LoadImage(cfg.Icon)
            end
            self.skill[i].desc.text = lanCfgs[cfg.Brief]
            self.skill[i].obj:SetActiveE(1)
        else
            self.skill[i].obj:SetActiveE(0)
        end
    end
end
--endregion

