local ArenaTeamDragItem = _G.BaseClass("ArenaTeamDragItem", ArenaTeamItem)
local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
---类的构造函数
function ArenaTeamDragItem:__init(obj, dragBegin, dragEnd, index)
    self.objIndex = index
    self.gameObject = obj
    self.onDragBegin = dragBegin
    self.onDragEnd = dragEnd
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
end
---类的析构函数
function ArenaTeamDragItem:Dispose()
    self.gameObject = nil
    self.onDragBegin = nil
    self.onDragEnd = nil
    self.objIndex = nil
end
function ArenaTeamDragItem:Show(data, index, skills)
    self.dataIndex = index
    ArenaTeamItem.Show(self, data, skills)
end
function ArenaTeamDragItem:GetDataIndex()
    return self.dataIndex
end
function ArenaTeamDragItem:OnDragBegin()
    if self.onDragBegin then
        self.onDragBegin(self.objIndex)
    end
end
function ArenaTeamDragItem:OnDrag(go, ed)
    self.gameObject:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end
function ArenaTeamDragItem:OnDragEnd()
    if self.onDragEnd then
        self.onDragEnd(self.objIndex)
    end
end
--endregion

