--region 布阵展示(可拖拽)
---@class ArenaSeniorTeamItem	中文描述
local ArenaSeniorTeamItemDrag = _G.BaseClass("ArenaSeniorTeamItemDrag")

---类的构造函数
function ArenaSeniorTeamItemDrag:__init(obj, call)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.teamPos = {
        {self.go_table.obj_team1:GetLocalPosition()},
        {self.go_table.obj_team2:GetLocalPosition()},
        {self.go_table.obj_team3:GetLocalPosition()}
    }
    local dragBegin = _G.handler(self, self.OnDragBegin)
    local dragEnd = _G.handler(self, self.OnDragEnd)
    self.teams = {
        ArenaTeamDragItem.New(self.go_table.obj_team1, dragBegin, dragEnd, 1),
        ArenaTeamDragItem.New(self.go_table.obj_team2, dragBegin, dragEnd, 2),
        ArenaTeamDragItem.New(self.go_table.obj_team3, dragBegin, dragEnd, 3)
    }
    self.onChangeCall = call
end

---类的析构函数
function ArenaSeniorTeamItemDrag:Dispose()
    self.go_table = nil
    self.teamPos = nil
    self.go_table = nil
    self.gameObject = nil
end

function ArenaSeniorTeamItemDrag:Show(data, skills)
    self.data = data
    self.combSkill = skills
    for i = 1, #data do
        self:ShowOne(data[i], i, self.combSkill[i])
    end
end
function ArenaSeniorTeamItemDrag:ShowOne(data, index, skills)
    self.teams[index]:Show(data, index, skills)
end

function ArenaSeniorTeamItemDrag:OnDragBegin(index)
    self.dragIndex = index
    self.teams[index].gameObject:SetParentE(self.go_table.trans_drag, 1)
end

function ArenaSeniorTeamItemDrag:OnDragEnd(index)
    for i = 1, #self.teams do
        if i ~= index then
            if _G.CS.UIUtils.ChecklocalPositionInRect(self.teams[index].gameObject, self.teams[i].gameObject, false) then
                local moveIndex = self.teams[index]:GetDataIndex()
                local targetIndex = self.teams[i]:GetDataIndex()
                self.teams[index]:Show(self.data[targetIndex], targetIndex, self.combSkill[targetIndex])
                self.teams[i]:Show(self.data[moveIndex], moveIndex, self.combSkill[moveIndex])
                self.onChangeCall(index, i)
                break
            end
        end
    end
    self.teams[index].gameObject:SetParentE(self.go_table.trans_root, 1)
    local pos = self.teamPos[index]
    self.teams[index].gameObject:SetLocalPosition(pos[1], pos[2], pos[3])
end
--endregion

---创建对象
---@param obj UnityEngine.GameObject 节点
---@param drag boolean 是否可拖拽
---@param call function 拖拽后的回调
---@return ArenaSeniorTeamItem|ArenaSeniorTeamItemDrag 中文描述
local function ArenaTeamCreate(obj, drag, call)
    if drag then
        return ArenaSeniorTeamItemDrag.New(obj, call)
    end
    return ArenaSeniorTeamItem.New(obj)
end

return ArenaTeamCreate
