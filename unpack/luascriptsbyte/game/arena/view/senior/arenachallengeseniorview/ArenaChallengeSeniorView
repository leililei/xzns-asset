local ArenaController = require "ArenaController"
local ArenaManager = require "ArenaManager"

--region 敌方使用
local ArenaChallengeSeniorEnemyItem = _G.BaseClass("ArenaChallengeSeniorEnemyItem")

function ArenaChallengeSeniorEnemyItem:__init(obj, challengeCall)
    self.onChallengeCallback = challengeCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ArenaChallengeSeniorEnemyItem:Dispose()
    self.go_table = nil
    self.onChallengeCallback = nil
    self.enemyIndex = nil
end
function ArenaChallengeSeniorEnemyItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_chanllenge then
        if self.onChallengeCallback then
            self.onChallengeCallback(self.enemyIndex)
        end
    end
end
--cfg 自己的段位配置
function ArenaChallengeSeniorEnemyItem:Show(data, cfg, index, free)
    self.enemyIndex = index
    self.type = data.type
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.power)
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_head, portraitCfg.portrait1)
    local ecfg = ArenaController:GetInstance():CalculateSeniorLeagueByRank(data.rank)
    local str = _G.LangUtil.GetLangPackValue(ecfg.name)
    if ArenaController:GetInstance():CheckKing(ecfg.level) then
        str = str .. "·" .. data.rank
    end
    self.go_table.aortext_rank.text = str
    local num = ecfg.efficiency - cfg.efficiency
    num = num < 0 and 0 or num
    self.go_table.aortext_victoryScore.text = string.format(_G.GetLangPackValue(90022100095), num)
    self.go_table.obj_free:SetActiveE(free > 0 and 1 or 0)
    self.go_table.obj_challenge:SetActiveE(free > 0 and 0 or 1)
end
--endregion
local base = require "ArenaSeniorRefreshBaseView"
---@class ArenaChallengeSeniorView : UIBaseView    中文描述
---@field public go_table ArenaChallengeSeniorView_GoTable GoTable
local ArenaChallengeSeniorView = _G.BaseClass("ArenaChallengeSeniorView", base)

function ArenaChallengeSeniorView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaChallengeSeniorView:OnCreate()
    self.onChallengeHandler = _G.handler(self, self.OnChallengeBtn)
    self.itemList = {
        ArenaChallengeSeniorEnemyItem.New(self.go_table.obj_chanllengeItem1, self.onChallengeHandler),
        ArenaChallengeSeniorEnemyItem.New(self.go_table.obj_chanllengeItem2, self.onChallengeHandler),
        ArenaChallengeSeniorEnemyItem.New(self.go_table.obj_chanllengeItem3, self.onChallengeHandler),
        ArenaChallengeSeniorEnemyItem.New(self.go_table.obj_chanllengeItem4, self.onChallengeHandler)
    }
    ---@type ArenaSingleClassSenior
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(2)
    if #_G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.resources > 0 then
        self:AddComponent(
            self.go_table.trans_resources,
            require("ResourceCompont").New(
                self.go_table.trans_resources,
                _G.DeepCopyCfgTable(_G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.resources)
            )
        )
    end
    self:Show()
    self:RefreshChallengeTimes()
    self.arenaClass:SetFreshTimeCall(_G.handler(self, self.OnFreshBtnTimeCall))
    self:AddListener(_G.eArena.RefreshSeniorView, self.Show)
    self:AddListener(_G.eBattleState.RecordStart, self.Hide)
    self:AddListener(_G.eBattleState.RecordEnd, self.ShowView)
end

function ArenaChallengeSeniorView:ShowView()
    self.super.Show(self)
end

function ArenaChallengeSeniorView:OnDestroy()
    self.arenaClass:SetFreshTimeCall()
    self.arenaClass = nil
    for i = 1, #self.itemList do
        self.itemList[i]:Dispose()
    end
    self.itemList = nil
    self.onChallengeHandler = nil
end

---按钮点击事件在这里派发
function ArenaChallengeSeniorView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        self:Close()
    elseif go == self.go_table.aorbtn_chanllengeTimes then
        self.arenaClass:BuyTicket(_G.handler(self, self.OnBuyTicketCall))
        -- _G.PopWindowManager:GetInstance():ShowAllTips(
        --     520301,
        --     nil,
        --     function()
        --         self.arenaClass:BuyTicket(_G.handler(self, self.RefreshChallengeTimes))
        --     end,
        --     nil,
        --     nil,
        --     nil,
        --     self.arenaClass:GetBuyTicketPrice(),
        --     self.arenaClass:GetBuyTicketCountOnce()
        -- )
    elseif go == self.go_table.aorbtn_fresh then
        if self.refreshTime > 0 then
            --提示刷新时间
            _G.PopWindowManager:GetInstance():ShowAllTips(300106)
        else
            self.arenaClass:RefreshEnemy(
                _G.handler(self, self.OnEnemyArrayCall),
                _G.handler(self, self.OnFreshBtnTimeCall)
            )
        end
    end
end
function ArenaChallengeSeniorView:RefreshChallengeTimes()
    self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
end
function ArenaChallengeSeniorView:OnBuyTicketCall(result)
    if result == 1 then
        self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
    end
end
---刷新倒计时
function ArenaChallengeSeniorView:OnFreshBtnTimeCall(time)
    self.refreshTime = time
    if self.refreshTime > 0 then
        self.go_table.aortext_fresh.text = _G.string.format(_G.GetLangPackValue(90026100037), self.refreshTime)
    else
        --刷新
        self.go_table.aortext_fresh.text = _G.GetLangPackValue(90021700009)
    end
end
---挑战
function ArenaChallengeSeniorView:OnChallengeBtn(index)
    if self.arenaClass:GetAllChallengeCount() <= 0 then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(300101)
        self.arenaClass:BuyTicket(_G.handler(self, self.OnBuyTicketCall))
        return
    end
    self.arenaClass:CheckFight(
        index,
        function(success)
            if success then
                self.arenaClass:OpenEmbattleAttack(index, _G.handler(self, self.OnChallengeCallback))
                self:Hide()
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name)
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
            end
        end
    )
end
---布阵返回
function ArenaChallengeSeniorView:OnChallengeCallback()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name)
end
--[[
required uint32 type = 1;// 1 npc，2为玩家
required uint64 uid = 2;//
required uint32 rank = 3;// 排名
required string name = 4;// 名字
required uint32 style = 5;//头像
required uint32 frame = 6;//头像框
required uint32 level = 7;//等级
required uint32 power = 8;// 战斗力
]]
function ArenaChallengeSeniorView:Show()
    self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
    local num, sum = self.arenaClass:GetFreshEnemyTimes()
    self.go_table.aortext_freshtimes.text = string.format(_G.GetLangPackValue(90022100107), num, sum)
    self.arenaClass:GetEnemyInfo(_G.handler(self, self.OnEnemyArrayCall), true)
end
---展示挑战敌人列表
---@param 变量名 变量类型 中文描述
function ArenaChallengeSeniorView:OnEnemyArrayCall(list)
    local num, sum = self.arenaClass:GetFreshEnemyTimes()
    self.go_table.aortext_freshtimes.text = string.format(_G.GetLangPackValue(90022100107), num, sum)
    local cfg = ArenaController:GetInstance():CalculateSeniorLeagueByRank(self.arenaClass:GetCurRank())
    local freeTimes = self.arenaClass:GetFreeFightTimes()
    for i = 1, #list do
        if i > #self.itemList then
            break
        end
        self.itemList[i]:Show(list[i], cfg, i, freeTimes)
    end
end

function ArenaChallengeSeniorView:OnLeagueChanged()
    self.arenaClass:GetEnemyInfo(_G.handler(self, self.OnEnemyArrayCall))
end

return ArenaChallengeSeniorView
