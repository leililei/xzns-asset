local PlayerInfoView = require "PlayerInfoView"
local ArenaTeamCreate = realRequire "ArenaSeniorTeamItem"
---@class ArenaSeniorPlayerInfoView : UIBaseView	中文描述
---@field public go_table ArenaSeniorPlayerInfoView_GoTable GoTable
local ArenaSeniorPlayerInfoView = _G.BaseClass("ArenaSeniorPlayerInfoView", PlayerInfoView)

---界面的入口函数
function ArenaSeniorPlayerInfoView:OnCreate(data, closeCall, embattle)
    PlayerInfoView.OnCreate(self, data, closeCall)
    self:InitEmbattle(embattle)
    self:PlayerLevel(data)
end
--暂时写在子类中
function ArenaSeniorPlayerInfoView:PlayerLevel(data)
    self.go_table.aortext_level.text = "Lv:" .. self.playerData.level
end

function ArenaSeniorPlayerInfoView:OnDestroy()
    PlayerInfoView.OnDestroy(self)
    self.team:Dispose()
    self.team = nil
end

function ArenaSeniorPlayerInfoView:OnEnable()
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(2)
    arenaClass:RegistLeagueChangeCall(_G.handler(self, self.OnLeagueChanged), self.viewName)
    PlayerInfoView.OnEnable(self)
end
function ArenaSeniorPlayerInfoView:OnDisable()
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(2)
    arenaClass:RegistLeagueChangeCall(nil, self.viewName)
    PlayerInfoView.OnDisable(self)
end

function ArenaSeniorPlayerInfoView:OnLeagueChanged()
    self:Close()
end

function ArenaSeniorPlayerInfoView:InitEmbattle(embattle)
    local embattleData = {}
    local insert = _G.table.insert
    local card
    for i = 1, #embattle do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            card = embattle[i].cards[j]
            data[j] = {
                uid = card.sid,
                sid = card.sid,
                level = card.level,
                star = card.star,
                soulLink_lv = card.soulLV,
                power = card.power
            }
        end
        embattleData[embattle[i].index] = data
    end
    self.team = ArenaTeamCreate(self.go_table.obj_team)
    self.team:Show(embattleData)
end

return ArenaSeniorPlayerInfoView
