local ArenaTeamCreate = realRequire "ArenaSeniorTeamItem"
---@class ArenaChallengeTeamDefenceView : UIBaseView	中文描述
---@field public go_table ArenaChallengeTeamDefenceView_GoTable GoTable
local ArenaChallengeTeamDefenceView = _G.BaseClass("ArenaChallengeTeamDefenceView", _G.UIBaseView)

function ArenaChallengeTeamDefenceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaChallengeTeamDefenceView:OnCreate(changeCall, data, enemyCards, enemyInfo, combSkill)
    self.onChangeCall = changeCall
    self.curShowIndex = {1, 2, 3}
    self.team = ArenaTeamCreate(self.go_table.obj_team, true, _G.handler(self, self.OnTeamChanged))
    self.team:Show(data, combSkill)
end

function ArenaChallengeTeamDefenceView:OnDestroy()
    self.team:Dispose()
    self.team = nil
    self.onChangeCall = nil
    self.curShowIndex = nil
end

---按钮点击事件在这里派发
function ArenaChallengeTeamDefenceView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
        if self.onChangeCall then
            self.onChangeCall(self.curShowIndex)
        end
    end
end
function ArenaChallengeTeamDefenceView:OnTeamChanged(index1, index2)
    self.curShowIndex[index1] = self.curShowIndex[index1] + self.curShowIndex[index2]
    self.curShowIndex[index2] = self.curShowIndex[index1] - self.curShowIndex[index2]
    self.curShowIndex[index1] = self.curShowIndex[index1] - self.curShowIndex[index2]
end

return ArenaChallengeTeamDefenceView
