local descStr = _G.GetLangPackValue(90022100136)
local descStr2 = _G.GetLangPackValue(90022100137)
local descStr3 = _G.GetLangPackValue(90022100138)
--region 奖励item
local ArenaSeniorRankAwardItem = _G.BaseClass("ArenaSeniorRankAwardItem")

local rankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04",
    "ui_jjc_pic_jinjijl"
}
local rankIconName = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}

local function AddEffectAward(cfg)
    local awards = {}
    local type, sid
    for _, a in pairs(cfg.reward_daily) do
        _G.table.insert(awards, a)
    end
    if not _G.table.isEmptyOrNil(cfg.reward_appearance) then
        for _, eff in pairs(cfg.reward_appearance) do
            type = eff[1]
            sid = _G.tostring(eff[2])
            for k, item in pairs(_G.ConfigManager.item_cfg) do
                if item.UseType == type and item.UseParameter[1][1] == sid then
                    _G.table.insert(awards, {item.ID, 1})
                    break
                end
            end
        end
    end
    return awards
end

function ArenaSeniorRankAwardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.itemList = {}
end
function ArenaSeniorRankAwardItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end
---显示
---@param id number 奖励id
---@param index number 排名序列号
---@return 变量类型 中文描述
function ArenaSeniorRankAwardItem:Show(id, index)
    self.gameObject:SetActiveE(1)
    self:ShowDay(id, index)
end
function ArenaSeniorRankAwardItem:ShowDay(id, index)
    local cfg = _G.ConfigManager.arena_rank_cfg[id]
    local str = ""
    if cfg.min_rank == cfg.max_rank then
        str = string.format(descStr, cfg.min_rank)
    else
        if cfg.max_rank >= 9999 then
            str = string.format(descStr3, cfg.min_rank)
        else
            str = string.format(descStr2, cfg.min_rank, cfg.max_rank)
        end
    end
    self.go_table.aortext_mScoreRank.text = str
    if index <= 3 then
        self.go_table.aorimage_rank.SpriteName = rankIconName[index]
        self.go_table.aorimage_rankbg.SpriteName = rankBgName[index]
        self.go_table.aorimage_rank:SetActiveE(1)
    else
        self.go_table.aorimage_rankbg.SpriteName = rankBgName[4]
        self.go_table.aorimage_rank:SetActiveE(0)
    end
    local award = AddEffectAward(cfg)
    self:ShowAward(award)
end
function ArenaSeniorRankAwardItem:ShowSeason(id)
    local cfg = _G.ConfigManager.arena_league_cfg[id]
    self.go_table.aorrawimage_duanwei:LoadImage(cfg.icon)
    self.go_table.aortext_level.text = _G.LangUtil.GetLangPackValue(cfg.name)
    if not _G.table.isEmptyOrNil(cfg.reward_season) then
        self:ShowAward(cfg.reward_season)
    end
end
---显示奖励
function ArenaSeniorRankAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
--endregion

---@class ArenaAwardSeniorView_Season : UIBaseView	中文描述
---@field public go_table ArenaAwardSeniorView._obj_SeasonAward_GoTable GoTable
local ArenaAwardSeniorView_Season = _G.BaseClass("ArenaAwardSeniorView_Season", _G.Component)

function ArenaAwardSeniorView_Season:Awake()
    self.itemList = {}
    self.itemTransDic = {}
    self.awardList = {}
end

---界面的入口函数
function ArenaAwardSeniorView_Season:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self.arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(2)
end

function ArenaAwardSeniorView_Season:Show()
    self:ShowList()
    self:ShowMyRank()
end

function ArenaAwardSeniorView_Season:Close()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end

function ArenaAwardSeniorView_Season:ShowList()
    self.awardList = _G.DeepCopyCfgTable(_G.ConfigManager.arena_info_cfg[2].rank_league)
    self.go_table.scrollloopvectical_seasonAward:InitItemData(#self.awardList, _G.handler(self, self.RefreshItem))
end

function ArenaAwardSeniorView_Season:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaSeniorRankAwardItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.awardList[index], index)
end

function ArenaAwardSeniorView_Season:ShowMyRank()
    local award = {}
    --我的排名
    local rank = self.arenaClass:GetCurRank()
    self.go_table.aortext_mNumber.text = rank
    local arena_rank_cfg = _G.ConfigManager.arena_rank_cfg
    for i = 1, #self.awardList do
        local value = arena_rank_cfg[self.awardList[i]]
        if value.min_rank <= rank and value.max_rank >= rank then
            award = AddEffectAward(value)
            if value.min_rank == value.max_rank then
                self.go_table.aortext_mScoreRank.text = string.format(descStr, value.min_rank)
            else
                if value.max_rank >= 9999 then
                    self.go_table.aortext_mScoreRank.text = string.format(descStr3, value.min_rank)
                else
                    self.go_table.aortext_mScoreRank.text = string.format(descStr2, value.min_rank, value.max_rank)
                end
            end
            break
        end
    end
    local ItemFactory = _G.ItemFactory
    self.itemList = {}
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                _G.table.insert(self.itemList, item)
            end
        )
    end
end

function ArenaAwardSeniorView_Season:EscClose()
end

return ArenaAwardSeniorView_Season
