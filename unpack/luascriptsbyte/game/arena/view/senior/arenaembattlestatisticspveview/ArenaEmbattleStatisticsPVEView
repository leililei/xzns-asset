local BattleStatisticsPVEView = require "BattleStatisticsPVEView"
---@class ArenaEmbattleStatisticsPVEView : UIBaseView	中文描述
---@field public go_table ArenaEmbattleStatisticsPVEView_GoTable GoTable
local ArenaEmbattleStatisticsPVEView = _G.BaseClass("ArenaEmbattleStatisticsPVEView", BattleStatisticsPVEView)
--_G.ArenaEmbattleStatisticsPVEView = ArenaEmbattleStatisticsPVEView

local CS = _G.CS
local typeof = _G.typeof

function ArenaEmbattleStatisticsPVEView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data table 伤害数据 数组
---@field FighterInfo.TeamInfo.Attacker table 攻击者 数组
---@field FighterInfo.TeamInfo.Defender table 防御者 数组
---@field FighterInfo.TeamInfo.TeamIndex number 队伍
---@param isWin boolean 胜利
---@param playerInfo table 玩家信息
---@param otherInfo table 其他玩家信息
function ArenaEmbattleStatisticsPVEView:OnCreate(data, isWin, call, plyerInfo, otherInfo, isRecord)
    self.call = call
    self.isWin = isWin or false
    self.playerInfo = plyerInfo
    self.otherInfo = otherInfo
    self.isRecord = isRecord
    self:UpdateData(data)
end

function ArenaEmbattleStatisticsPVEView:UpdateData(data)
    self.page = 1
    self.maxCount = _G.table.count(data.FighterInfo)
    --self.PveData = data
    self.PveData = self:InitData(data)
    self:ChangePage(0)
end

function ArenaEmbattleStatisticsPVEView:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        --temp.isWin = data[i].FighterInfo.TeamInfo.isWin
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = {DmgOut = 0, DmgIn = 0, HpRecover = 0}
        temp.statisticsData = tempData
        for i = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[i].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[i].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[i].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[i].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[i].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[i].HpRecover
            end
        end
        for i = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[i].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[i].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[i].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[i].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[i].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[i].HpRecover
            end
        end
        if temp.statisticsMax.DmgOut == 0 then
            temp.statisticsMax.DmgOut = 1
        end
        if temp.statisticsMax.DmgIn == 0 then
            temp.statisticsMax.DmgIn = 1
        end
        if temp.statisticsMax.HpRecover == 0 then
            temp.statisticsMax.HpRecover = 1
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

---按钮点击事件在这里派发
function ArenaEmbattleStatisticsPVEView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeHide then
        -- _G.Events:GetInstance():Broadcast("BattleEmbattleStatisticsPVEViewHide", 1)
        -- _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleEmbattleStatisticsPVEView.Name)
    elseif go == self.go_table.aorbtn_close then
        _G.Events:GetInstance():Broadcast("BattleEmbattleStatisticsPVEViewHide", 0)
        self:Close()
    elseif go == self.go_table.aorbtn_left then
        self:ChangePage(-1)
    elseif go == self.go_table.aorbtn_right then
        self:ChangePage(1)
    end
end

function ArenaEmbattleStatisticsPVEView:ChangePage(num)
    self.page = self.page + num
    --self.go_table.aortext_page.text = string.format("第%d/%d页", self.page, self.maxCount)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_left, self.page > 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_right, self.page < self.maxCount)
    local data = self.PveData[self.page]
    self.super.OnCreate(
        self,
        data.statisticsData,
        data.statisticsMax,
        self.isWin,
        self.call,
        self.playerInfo,
        self.otherInfo,
        1,
        self.isRecord
    )
end

return ArenaEmbattleStatisticsPVEView
