--region 段位item
local ArenaAwardSeniorItem = _G.BaseClass("ArenaAwardSeniorItem")

function ArenaAwardSeniorItem:__init(obj, getCall, arenaClass)
    self.gameObject = obj
    self.getAwardCallback = getCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    self.arenaClass = arenaClass
end
function ArenaAwardSeniorItem:Dispose()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = nil
    self.curRankID = nil
    self.gameObject = nil
    self.getAwardCallback = nil
    self.go_table = nil
    self.arenaClass = nil
end
---按钮点击事件在这里派发
function ArenaAwardSeniorItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_get then
        self.arenaClass:GetRankAward(self.curRankID, _G.handler(self, self.OnAwardGetCall))
    end
end
function ArenaAwardSeniorItem:OnAwardGetCall(state, data)
    if state then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        if self.getAwardCallback then
            self.getAwardCallback()
        end
    end
end
function ArenaAwardSeniorItem:Show(cfg, icon)
    self.gameObject:SetActiveE(1)
    self.curRankID = cfg.id
    self.curRankLevel = cfg.condition_level
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.name)
    self.go_table.aortext_desc.text = _G.GetLangPackValue(cfg.desc)
    self.go_table.aorrawimage_icon:LoadImage(
        icon,
        function()
            self.go_table.aorrawimage_icon:SetNativeSize()
        end
    )
    self:ShowAward(cfg.reward_daily)
    self:ShowAwardState()
end
---显示奖励
function ArenaAwardSeniorItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_itemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
---显示领取状态
function ArenaAwardSeniorItem:ShowAwardState()
    self.go_table.aorbtn_get:SetActiveE(0)
    self.go_table.obj_gray:SetActiveE(0)
    self.go_table.obj_alreadyGet:SetActiveE(0)
    if self.arenaClass:GetRankAwardState(self.curRankID) then
        self.go_table.obj_alreadyGet:SetActiveE(1)
    elseif self.arenaClass:CheckRankAwardTo(self.curRankLevel) then
        self.go_table.aorbtn_get:SetActiveE(1)
    else
        self.go_table.obj_gray:SetActiveE(1)
    end
end
--endregion

---@class ArenaAwardSeniorView : UIBaseView	中文描述
---@field public go_table ArenaAwardSeniorView_GoTable GoTable
local ArenaAwardSeniorView = _G.BaseClass("ArenaAwardSeniorView", _G.UIBaseView)

function ArenaAwardSeniorView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemTransDic = {}
end

local TagType = {
    Season = 1,
    Rank = 2
}

---界面的入口函数
function ArenaAwardSeniorView:OnCreate()
    self.arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(2)
    self:ChangeToggle(TagType.Season)
end

function ArenaAwardSeniorView:InitSeasonAward()
    local lua = self:AddComponent(self.go_table.obj_SeasonAward, require("ArenaAwardSeniorView_Season").New(self.go_table.obj_SeasonAward))
    lua:Show()
    self.initSeason = true
end

function ArenaAwardSeniorView:InitRankAward()
    self.go_table.scrollloopvectical_award:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.lvIcons = {}
    for id, value in pairs(_G.ConfigManager.arena_senior_cfg) do
        self.lvIcons[value.level] = value.icon
    end
    self.cfgs = {false, false, false, false, false, false, false, false}
    local index = 1
    for id, value in pairs(_G.ConfigManager.arena_senior_rank_cfg) do
        if #value.reward_daily > 0 then
            self.cfgs[index] = value
            index = index + 1
        end
    end
    _G.table.sort(
        self.cfgs,
        function(a, b)
            return a.condition_level > b.condition_level
        end
    )
    local ArenaControllerIns = require("ArenaController"):GetInstance()
    local rank = self.arenaClass:GetCurRank()
    local cfg = ArenaControllerIns:CalculateSeniorLeagueByRank(rank)
    self.go_table.aortext_curLeague.text = _G.GetLangPackValue(cfg.name)
    rank = self.arenaClass:GetMaxRank()
    cfg = ArenaControllerIns:CalculateSeniorLeagueByRank(rank)
    self.go_table.aortext_maxLeague.text = _G.GetLangPackValue(cfg.name)
    self:SortItem(true)
    self.initRank = true
end

---@param tagType number 页签
function ArenaAwardSeniorView:ChangeToggle(tagType)
    for _, v in pairs(TagType) do
        self.go_table["obj_choose" .. v]:SetActiveE(v == tagType and 1 or 0)
    end
    self.go_table.obj_SeasonAward:SetActiveE(tagType == TagType.Season and 1 or 0)
    self.go_table.obj_RankAward:SetActiveE(tagType == TagType.Rank and 1 or 0)
    if tagType == TagType.Season and not self.initSeason then
        self:InitSeasonAward()
    end
    if tagType == TagType.Rank and not self.initRank then
        self:InitRankAward()
    end
end

function ArenaAwardSeniorView:OnClickBtn(go)
    if go == self.go_table.aorbtn_bg then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_season then
        self:ChangeToggle(TagType.Season)
    elseif go == self.go_table.aorbtn_rank then
        self:ChangeToggle(TagType.Rank)
    end
end

function ArenaAwardSeniorView:Close()
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end

function ArenaAwardSeniorView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    local item = self.itemTransDic[instanceID]
    if not item then
        item = ArenaAwardSeniorItem.New(obj, _G.handler(self, self.SortItem), self.arenaClass)
        self.itemTransDic[instanceID] = item
    end
    item:Show(self.cfgs[index], self.lvIcons[self.cfgs[index].condition_level])
end

function ArenaAwardSeniorView:SortItem(init)
    local geta, getb
    _G.table.sort(
        self.cfgs,
        function(a, b)
            geta = self.arenaClass:GetRankAwardState(a.id)
            getb = self.arenaClass:GetRankAwardState(b.id)
            if geta and getb then
                return a.condition_level < b.condition_level
            elseif not geta and not getb then
                return a.condition_level > b.condition_level
            elseif geta then
                return false
            end
            return true
        end
    )
    if init then
        self.go_table.scrollloopvectical_award:UpdateCount(#self.cfgs)
    else
        self.go_table.scrollloopvectical_award:UpdateAllItem()
    end
end

return ArenaAwardSeniorView
