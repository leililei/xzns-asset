---@class ArenaPanelView : UIBaseView	中文描述
---@field public go_table ArenaPanelView_GoTable GoTable
local ArenaPanelView = _G.BaseClass("ArenaPanelView", _G.UIBaseView)

function ArenaPanelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaPanelView:OnCreate()
    self.notIsFristCreate = true
    self.itemlist = {}
    self.itemID = {}
    self.configs = {}
    for id, cfg in pairs(_G.ConfigManager.arena_page_cfg) do
        if not cfg.reveal then
            if cfg.function_open == _G.FunctionID.SociatyMoba then
                if require("SociatyManager"):GetInstance():HasSociaty() then
                    _G.table.insert(self.configs, cfg)
                end
            else
                _G.table.insert(self.configs, cfg)
            end
        end
    end

    _G.SortList(self.configs, function(a)
        return -a.page
    end)

    self.go_table.scrollloopvectical_itemlist:InitItemData(#self.configs, _G.handler(self, self.RefreshItem))

    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.JieMianShuaXing, self)
end

function ArenaPanelView:OnDestroy()
    for k, v in pairs(self.itemlist) do
        v:Dispose()
    end
    self.itemlist = nil
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.JieMianShuaXing, self)
end

function ArenaPanelView:JieMianShuaXing()
    self.go_table.scrollloopvectical_itemlist:UpdateAllItem()
end

function ArenaPanelView:RefreshItem(index, go)
    if index < 0 then
        return
    end
    index = index + 1
    local cfg = self.configs[index]
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.OpenWindos, cfg))
    local itemInfo = info[cfg.id]
    go:SetName(itemInfo.class)
    tb.aorrawimage_bg:LoadImage(cfg.art[1])
    tb.aortext_title.text = _G.GetLangPackValue(itemInfo.title)


    if itemInfo.pointId then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(itemInfo.pointId)
    else
        tb.obj_redpoint:SetActiveE(0)
    end

    local id = go:GetInstanceID()
    if not self.itemlist[cfg.id] then
        self.itemlist[cfg.id] = require(itemInfo.class).New(tb)
    end
    if self.itemID[id] and self.itemID[id] ~= cfg.id then
        self.itemlist[self.itemID[id]]:StopTimer()
    end
    self.itemID[id] = cfg.id
    self.itemlist[cfg.id]:OnShow(tb)
end

---按钮点击事件在这里派发
function ArenaPanelView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
end

function ArenaPanelView:OpenWindos(go, _, cfg)
    ---@type arena_page_cfg
    local configs = cfg
    local functionId = configs.function_open
    if cfg.id == 106 then
        local isOpen,str =  require("SociatyBattleModel"):GetInstance():GetFuncIsOpen()
        if not isOpen then
            _G.PopWindowManager:GetInstance():ShowAllTips(110124, str)
            _G.LogError("功能未开放")
            return
        end
    elseif not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(functionId) then
        local strT, mTipsidT = _G.FunctionManager:GetInstance():GetAllTipsStr(functionId)
        local str = strT[1]
        for i = 2, #strT do
            str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. strT[i]
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(mTipsidT[1], str)
        _G.LogError("功能未开放")
        return
    end

    if functionId == 2 then --竞技场
        self:CloseTimer()
        ArenaController:GetInstance():OnArenaChoose(ArenaManager.arenaType.normal, _G.handler(self, self.Hide))
    elseif functionId == 79 then --五行
        self:CloseTimer()
        ArenaController:GetInstance():OpenMainView(ArenaManager.arenaType.element, _G.handler(self, self.Hide))
    elseif functionId == 51 then --高级竞技场
        ---@type ArenaSingleClassSenior
        local senior = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.senior)
        if senior:CheckSeasonIsOpen() then
            self:CloseTimer()
            ArenaController:GetInstance():OpenMainView(ArenaManager.arenaType.senior, _G.handler(self, self.Hide))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(620101)
        end
    elseif functionId == 138 then --巅峰对决
        if ArenaPeakModel:GetInstance():CheckIsOpen(true) then
            local settleTime = ArenaPeakModel:GetInstance():GetSettlementTime()
            if settleTime == 0 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaPeakView.Name)
                self:Hide()
            else
                self:DianFengRefreshInfo()
            end
        end
    elseif functionId == 152 then --问鼎灵域
        local SpiritualRealmModel = require "SpiritualRealmModel":GetInstance()
        if SpiritualRealmModel:IsSettlementTime() then
            _G.PopWindowManager:GetInstance():ShowAllTips(913104)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualRealmView.Name)
            self:Hide()
        end
    elseif cfg.id == 106 then --争霸天下
        if not require("SociatyManager"):GetInstance():HasSociaty() then
            _G.PopWindowManager:GetInstance():ShowAllTips(250308)
            --require("SociatyManager"):GetInstance():CreateSociaty()
            --self:Close()
        else
            local type = SociatyBattleManager:GetInstance():Enter()
            if type == 1 then
                local sbot = require("SociatyBattleManager"):GetInstance():GetSociatyBattleOpenTime()
                local lockStr = ""
                local residue = sbot - _G.TimeUtil.GetServerUnixTime()
                residue = math.ceil(residue / 86400) - 1
                if residue > 0 then
                    lockStr = _G.GetLangPackValue(90028010131, residue)
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(250126, lockStr)
                return
            elseif type == 2 then
                --functionopen条件不满足
            end
            self:Hide()
        end
    elseif cfg.id == 107 then --冥界纷争
        require("SociatyMobaModel"):GetInstance():EnterView()
    elseif cfg.id == 108 then --跨服奥山
        local stageState = require "SociatyBattleLeagueModel":GetInstance():GetStageState()
        local curSession = require "SociatyBattleLeagueManager":GetInstance():GetCurSession()

        if stageState == _G.SociatyBattleLeagueStageState.None or stageState == _G.SociatyBattleLeagueStageState.End then
            if curSession <= 0 then
                return
            end
        end
        require("SociatyBattleLeagueManager"):GetInstance():Enter()
        self:Hide()
        -- elseif functionId == 72 then --群英会武
        --     local model = require("SeasonModel"):GetInstance()
        --     model:OpenView(
        --             functionId,
        --             function()
        --                 _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
        --             end,
        --             function()
        --                 _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
        --             end
        --     )
    end
end

function ArenaPanelView:CloseTimer()
    for k, v in pairs(self.itemlist) do
        v:StopTimer()
    end
end

function ArenaPanelView:OnEnable()
    if not self.notIsFristCreate then
        self.go_table.scrollloopvectical_itemlist:UpdateAllItem()
    end
    self.notIsFristCreate = false
end

return ArenaPanelView
