---@class ArenaReportPanelView : UIBaseView	中文描述
---@field public go_table ArenaReportPanelView_GoTable GoTable
local ArenaReportPanelView = _G.BaseClass("ArenaReportPanelView", _G.UIBaseView)
local reportItemClass = {
    ArenaReportItemNormal,
    ArenaReportItemSenior,
    ArenaReportItemFair,
    ArenaReportItemElements
}
function ArenaReportPanelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function ArenaReportPanelView:OnCreate(sid)
    self.itemTransDic = {}
    self.go_table.scrollloopvectical_report:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.curArenaSid = sid or ArenaController:GetInstance():GetCurArenaSid()
    ArenaController:GetInstance():GetReport(_G.handler(self, self.ShowReport))
end

function ArenaReportPanelView:OnDestroy()
    if self.itemTransDic then
        for _, value in pairs(self.itemTransDic) do
            value:Dispose()
        end
    end
end

---按钮点击事件在这里派发
function ArenaReportPanelView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    self:Close()
end

function ArenaReportPanelView:ShowReport(list)
    self.reportList = list
    local count = #self.reportList or 0
    self.go_table.obj_emptybg:SetActiveE(count == 0 and 1 or 0)
    self.go_table.scrollloopvectical_report:UpdateCount(count)
    require("ArenaManager"):GetInstance():SetNewReport(ArenaController:GetInstance():GetCurArenaSid(), false)
end

function ArenaReportPanelView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = reportItemClass[self.curArenaSid].New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.reportList[index])
end

return ArenaReportPanelView
