
---@class ArenaPanelItemInfoBase : Component	中文描述
local ArenaPanelItemInfoBase = _G.BaseClass("ArenaPanelItemInfoBase",_G.Component)

---类的构造函数
---@param tb go_table 
function ArenaPanelItemInfoBase:__init(tb)
    self.go_table = tb
end

---类的析构函数
function ArenaPanelItemInfoBase:Dispose()
end


---初始化
function ArenaPanelItemInfoBase:Init()
    self.titleGradient = self.go_table.aortext_title:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    --self.titleOutline = self.go_table.aortext_title:GetComponentE(_G.typeof(_G.CS.TextOutline))
    --self.titleOutline.enabled = false
    self.go_table.obj_time:SetActiveE(0)
    self.go_table.obj_power:SetActiveE(0)
    self.go_table.obj_value:SetActiveE(0)
    self.go_table.aortext_info:SetActiveE(0)
    self.go_table.obj_output:SetActiveE(0)
end

---界面信息展示(子类重写)
function ArenaPanelItemInfoBase:OnShow()
end

---界面信息置灰(子类调用)
---@param isSetGray boolean 是否置灰
function ArenaPanelItemInfoBase:SetGray(isSetGray)
    self.titleGradient.enabled = not isSetGray
    --self.titleOutline.enabled = isSetGray
    self.go_table.aorrawimage_bg:SetGray(isSetGray)
end

---停止计时器(子类重写)
function ArenaPanelItemInfoBase:StopTimer()
end

return ArenaPanelItemInfoBase
