---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
---@class ArenaPanelItemInfoKFAS:ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoKFAS = _G.BaseClass("ArenaPanelItemInfoKFAS", base)

---类的构造函数
function ArenaPanelItemInfoKFAS:__init()
end

function ArenaPanelItemInfoKFAS:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    self.go_table.obj_value:SetActiveE(1)
    self.go_table.aortext_info:SetActiveE(1)
    self:StopTimer()
end

function ArenaPanelItemInfoKFAS:OnShow(tb)
    self.go_table = tb
    self:Init()
    self.go_table.obj_time:SetActiveE(1)
    local model = require("SociatyBattleModel"):GetInstance()
    local data = _G.ConfigManager.guild_entrance_cfg[_G.ScoaityActivityType.SociatyBattleLeague]
    local desc
    local time = 0
    local times = -1
    local stageState = require "SociatyBattleLeagueModel":GetInstance():GetStageState()
    local state = require "SociatyBattleLeagueModel":GetInstance():GetState()
    local IsJoin = require "SociatyBattleLeagueModel":GetInstance().IsJoin
    local IsLeagueOpen = require "SociatyBattleLeagueModel":GetInstance().IsLeagueOpen

    self.LeagueStageState = stageState
    self.LeagueState = state
    self.ShowTime = false
    self.LeagueTime = 0

    local lock = false
    if stageState == _G.SociatyBattleLeagueStageState.None or nil == IsLeagueOpen or IsLeagueOpen == -1 then
        desc = _G.GetLangPackValue(90032100035)
        lock = true
    elseif IsLeagueOpen == 0 then
        desc = _G.GetLangPackValue(90032100042)
        lock = true
    else
        -- if stageState == _G.SociatyBattleLeagueStageState.None then
        --     desc = _G.GetLangPackValue(90032100035)
        --     lock = true
        -- else
        if stageState == _G.SociatyBattleLeagueStageState.Select then
            desc = _G.GetLangPackValue(90032100025)
            time = require "SociatyBattleLeagueModel":GetInstance():GetEndTime()
        elseif stageState == _G.SociatyBattleLeagueStageState.Preparing then
            desc = _G.GetLangPackValue(90032100026)
            time = require "SociatyBattleLeagueModel":GetInstance():GetEndTime()
        elseif stageState == _G.SociatyBattleLeagueStageState.End then
            desc = _G.GetLangPackValue(90032100035)
            lock = true
        else
            if state == _G.SociatyBattleLeagueState.Match then
                desc = _G.GetLangPackValue(90021800473)
            elseif state == _G.SociatyBattleLeagueState.Guess then
                if IsJoin then
                    desc = _G.GetLangPackValue(90021800473)
                else
                    desc = _G.GetLangPackValue(90032100028)
                end
            elseif state == _G.SociatyBattleLeagueState.Battle then
                if IsJoin then
                    desc = _G.GetLangPackValue(data.number)
                    times = require("SociatyModel"):GetInstance():GetTargetActivityTimes(data.id)
                else
                    desc = _G.GetLangPackValue(90032100029)
                end
            elseif state == _G.SociatyBattleLeagueState.Settlement then
                desc = _G.GetLangPackValue(90032100030)
            else
                desc = _G.GetLangPackValue(90100000005)
            end
        end
    end

    local curSession = require "SociatyBattleLeagueManager":GetInstance():GetCurSession()

    if lock and curSession < 1 then
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = desc
        self:SetGray(true)
        self.go_table.obj_time:SetActiveE(0)
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
    else
        self:SetGray(false)
    end

    tb.aortext_endTimeTitle.text = ""
    tb.aortext_endTime.text = ""
    if time > 0 then
        tb.aortext_endTimeTitle.text = desc
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
        local stime = time - _G.TimeUtil.GetServerUnixTime()
        if stime <= 0 then
            stime = 0
        end
        self.closeCountdown = stime
        self.ShowTime = true
        self.LeagueTime = time
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
        self:SetEndTime(0)
        self.timer:Start()
    elseif times >= 0 then
        self.go_table.aortext_info.text = _G.GetLangPackValue(90021800330)
        self.go_table.aortext_value.text = times
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        )
    else
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = desc
    end
end

function ArenaPanelItemInfoKFAS:SetEndTime(elapsed)
    self.closeCountdown = self.closeCountdown - elapsed
    if self.closeCountdown <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self.timer:Stop()
    else
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(_G.Mathf.RoundToInt(self.closeCountdown))
    end
end

function ArenaPanelItemInfoKFAS:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoKFAS:Dispose()
    self:StopTimer()
end

return ArenaPanelItemInfoKFAS
