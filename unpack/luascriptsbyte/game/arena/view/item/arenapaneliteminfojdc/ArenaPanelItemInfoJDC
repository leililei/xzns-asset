---@type ArenaManager
local ArenaManager
---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
---@class ArenaPanelItemInfoJDC : ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoJDC = _G.BaseClass("ArenaPanelItemInfoJDC",base)

---类的构造函数
function ArenaPanelItemInfoJDC:__init()
    ArenaManager = require "ArenaManager"
end

function ArenaPanelItemInfoJDC:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    self.go_table.obj_power:SetActiveE(0)
    self.go_table.obj_value:SetActiveE(1)
    self.go_table.aortext_info:SetActiveE(1)
    self:StopTimer()

end

---显示奖励
function ArenaPanelItemInfoJDC:ShowAward(award)
    self.go_table.trans_outputNode:ClearChildren()
    local ItemFactory = _G.ItemFactory
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
                ItemFactory.itemType.baseItem,
                self.go_table.trans_outputNode,
                function(item)
                    item:Show(award[i][1], nil, award[i][2])
                    item.gameObject:SetLocalScaleXYZ(0.54)
                    if self.go_table.trans_outputNode:GetChildCountE() > i then
                        _G.DestroyImmediate(item.gameObject)
                        return
                    end
                end
        )
    end
end

function ArenaPanelItemInfoJDC:OnShow(tb)
    self.go_table = tb
    self:Init()

    self.go_table.obj_output:SetActiveE(1)
    ---右下角主要奖励
    if not self.initAward then
        local awardList = _G.DeepCopyCfgTable(_G.ConfigManager.arena_info_cfg[1].rank_league)
        local cfg = _G.ConfigManager.arena_rank_cfg[awardList[1]]
        local award = ArenaManager:GetInstance():AddEffectAward(cfg)
        self:ShowAward(award)
        self.initAward = true
    end

    local class = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal)
    self.go_table.aortext_endTimeTitle.text = _G.GetLangPackValue(90022100266)

        self.closeCountdown = class.endTimeSec or 0
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
        self:SetEndTime(0)
        self.timer:Start()

    self.go_table.aortext_value.text = class:GetScore()
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.go_table.aortext_powerNum.text = _G.UIUtils.NumberToUnitStr_CardFightNum(power)

    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
end

function ArenaPanelItemInfoJDC:SetEndTime(elapsed)
    self.closeCountdown = math.ceil(self.closeCountdown - elapsed)
    if self.closeCountdown <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self.timer:Stop()
    else
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(self.closeCountdown)
    end
end

function ArenaPanelItemInfoJDC:StopTimer()  
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoJDC:Dispose()
    self:StopTimer()
    ArenaManager = nil
end

return ArenaPanelItemInfoJDC
