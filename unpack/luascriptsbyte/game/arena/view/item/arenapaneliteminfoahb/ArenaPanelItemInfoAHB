---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
---@class ArenaPanelItemInfoAHB:ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoAHB = _G.BaseClass("ArenaPanelItemInfoAHB", base)


---类的构造函数
function ArenaPanelItemInfoAHB:__init()
end

function ArenaPanelItemInfoAHB:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    self.go_table.obj_value:SetActiveE(1)
    self.go_table.aortext_info:SetActiveE(1)
    self:StopTimer()

end

function ArenaPanelItemInfoAHB:OnShow(tb)
    self.go_table = tb
    self:Init()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(72) then
        self.go_table.obj_time:SetActiveE(1)
        local model = require("AllHeroesBattleManager"):GetInstance()
        local time = model:GetEndTime()
        if time then
            self.closeCountdown = time
            self.go_table.aortext_endTimeTitle.text = _G.GetLangPackValue(90022500413)
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
            self:SetEndTime(0)
            self.timer:Start()
        end
        self.go_table.aortext_info.text = _G.GetLangPackValue(90020800036)
        self.IsUpdateRedPointBox = false
        self.go_table.obj_eff:ClearChildren()
        _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Qyhw/AllHeroesAwardItem",
                _G.ePoolType.Temporary,
                self.go_table.obj_eff,
                function(tran)
                    self.awardItem = _G.GetAutoGoTable(tran, function()
                        require("AllHeroesBattleManager"):GetInstance():GetAward(function()
                            self.IsUpdateRedPointBox = false
                            self:UpdateOnAwardChange(tran)
                        end)
                    end)
                    self:UpdateOnAwardChange(tran)
                    tran:SetLocalPosition(232, -94, 0)
                    local count = self.go_table.obj_eff:GetChildCountE()
                    if count > 1 then
                        for i = 1, count - 1 do
                            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_eff:GetChildE(0), _G.ePoolType.UIItem)
                        end
                    end
                end
        )

        --_G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        --    self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
    else
        local strT = _G.FunctionManager:GetInstance():GetAllTipsStr(72)
        local str = strT[1]
        for i = 2, #strT do
            if strT[i] then
                str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. strT[i]
            end
        end
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = str
        self:SetGray(true)
        self.go_table.obj_time:SetActiveE(0)
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
    end
end

function ArenaPanelItemInfoAHB:UpdateOnAwardChange(obj)
    local tb = obj and _G.GetAutoGoTable(obj) or self.awardItem
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    if AllHeroesBattleManagerIns:GetCurAwardEfficiency() > 0 then
        self:UpdateInfo(tb)
    else
        AllHeroesBattleManagerIns:UpdateInitData(_G.handlerbind(self, self.UpdateInfo, tb))
    end
end

function ArenaPanelItemInfoAHB:UpdateInfo(tb)
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    tb.aortext_award.text = _G.GetLangPackValue(90000010085, AllHeroesBattleManagerIns:GetCurAwardEfficiency())
    local now = AllHeroesBattleManagerIns:GetAwardInfo()
    local max = AllHeroesBattleManagerIns:GetAwardMaxCount()
    tb.aortext_count.text = _G.string.format("%d/%d", now, max)
    if now >= max and false == self.IsUpdateRedPointBox then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleBox.id)
        self.IsUpdateRedPointBox = true
    end
    self.go_table.aortext_value.text = _G.GetLangPackValue(90027000004, _G.GameUtil.NumberToChinese(AllHeroesBattleManagerIns:GetFightTimes()))
end

function ArenaPanelItemInfoAHB:SetEndTime(elapsed)
    self.closeCountdown = math.ceil(self.closeCountdown - elapsed)
    if self.closeCountdown <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self.timer:Stop()
    else
        if self.awardItem then
            self:UpdateOnAwardChange()
        end
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(self.closeCountdown)
    end
end

function ArenaPanelItemInfoAHB:StopTimer()  
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoAHB:Dispose()
    self:StopTimer()
end

return ArenaPanelItemInfoAHB
