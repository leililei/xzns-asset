---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
---@class ArenaPanelItemInfoALXZC:ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoALXZC = _G.BaseClass("ArenaPanelItemInfoALXZC", base)


---类的构造函数
function ArenaPanelItemInfoALXZC:__init()
end

function ArenaPanelItemInfoALXZC:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    -- self.go_table.obj_value:SetActiveE(1)
    -- self.go_table.aortext_info:SetActiveE(1)
    self:StopTimer()

end

function ArenaPanelItemInfoALXZC:OnShow(tb)
    self.go_table = tb
    self:Init()

    local lock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SociatyMoba)
    local sbot = require("SociatyMobaModel"):GetInstance():GetSociatyMobaOpenTime()
    local residue = sbot - _G.TimeUtil.GetServerUnixTime()
    local residueDay = _G.math.ceil(residue / 86400)
    if residueDay <= 0 then
        lock = false
    end

    if not lock then
        self.go_table.obj_time:SetActiveE(1)
        self.go_table.aortext_endTimeTitle.text = self:GetMobaLastText()

        self:GetNextStageTime()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
        self.timer:Start()
        self:SetEndTime(0)
        -- _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        --     self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
    else
        local strT = _G.FunctionManager:GetInstance():GetAllTipsStr(252)
        local str = strT[1]
        for i = 2, #strT do
            str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. strT[i]
        end
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = str
        self:SetGray(true)
        self.go_table.obj_time:SetActiveE(0)
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
    end
end

function ArenaPanelItemInfoALXZC:SetEndTime(elapsed)
    self.nextTime = self.nextTime - elapsed
    if self.nextTime <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self:StopTimer()
        self:OnShow(self.go_table)
    elseif not self.inFighting then
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(_G.Mathf.RoundToInt(self.nextTime))
    end
end

function ArenaPanelItemInfoALXZC:GetNextStageTime()
    self.inFighting = false
    local model = require("SociatyMobaModel"):GetInstance()
    local battleState, nextStateTime = model:GetMobaBattleStage()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    nextStateTime = nextStateTime - servertime
    self.nextTime = 0
    if battleState == model.SociatyMobaBattleState.Match then
        ---匹配中显示距离布阵阶段的倒计时
        self.nextTime = nextStateTime
    elseif battleState == model.SociatyMobaBattleState.Embattle then
        ---显示距离锁定阵容阶段倒计时,如果是星期天则显示下一次定段开始的时间
        if _G.TimeUtil.GetWeekDay() == 7 then
            self.nextTime = model:GetGradingStartTime() - servertime
        else
            self.nextTime = nextStateTime
        end
    elseif battleState == model.SociatyMobaBattleState.EmbattleAllDay then
        ---显示距离定段阶段倒计时
        self.nextTime = model:GetGradingStartTime() - servertime
    elseif battleState == model.SociatyMobaBattleState.Adjustline or battleState == model.SociatyMobaBattleState.Prepare then
        ---距离战斗开始的倒计时
        self.nextTime = model:GetBattleStartTime() - servertime
    elseif battleState == model.SociatyMobaBattleState.Fighting then
        ---打野行动次数
        self.nextTime = nextStateTime
        self.inFighting = true
        self.go_table.aortext_endTime.text = model:GetWildTimes()
    elseif battleState == model.SociatyMobaBattleState.Settlement then
        ---显示结算结束倒计时
        self.nextTime = model:GetSettlementEndTime() - servertime
    elseif battleState == model.SociatyMobaBattleState.Grading then
        ---定段结束倒计时
        self.nextTime = model:GetGradingEndTime() - servertime
    elseif battleState == model.SociatyMobaBattleState.SeasonSettlement then
        ---赛季结算倒计时
        self.nextTime = nextStateTime
    end
end

---获取标题
function ArenaPanelItemInfoALXZC:GetMobaLastText()
    local model = require("SociatyMobaModel"):GetInstance()
    local battleState = model:GetMobaBattleStage()
    if battleState == model.SociatyMobaBattleState.Match then
        ---匹配中
        return _G.GetLangPackValue(90021800255)
    elseif battleState == model.SociatyMobaBattleState.Embattle or battleState == model.SociatyMobaBattleState.EmbattleAllDay then
        ---战斗准备中
        return _G.GetLangPackValue(90031700067)
    elseif battleState == model.SociatyMobaBattleState.Adjustline or battleState == model.SociatyMobaBattleState.Prepare then
        ---战斗即将开始
        return _G.GetLangPackValue(90031700068)
    elseif battleState == model.SociatyMobaBattleState.Fighting then
        ---战斗中
        -- return _G.GetLangPackValue(90031700069)
        return _G.GetLangPackValue(90021800211)
    elseif battleState == model.SociatyMobaBattleState.Settlement then
        ---结算中
        return _G.GetLangPackValue(90000010091)
    elseif battleState == model.SociatyMobaBattleState.Grading then
        ---定段中
        return _G.GetLangPackValue(90031700070)
    elseif battleState == model.SociatyMobaBattleState.SeasonSettlement then
        ---赛季结算中
        return _G.GetLangPackValue(90011611104)
    end

    return ""
end

function ArenaPanelItemInfoALXZC:StopTimer()  
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoALXZC:Dispose()
    self:StopTimer()
end

return ArenaPanelItemInfoALXZC
