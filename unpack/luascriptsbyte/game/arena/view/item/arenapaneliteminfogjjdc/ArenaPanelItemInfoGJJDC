---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
local ArenaManager = require "ArenaManager"
---@class ArenaPanelItemInfoGJJDC:ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoGJJDC = _G.BaseClass("ArenaPanelItemInfoGJJDC", base)

---类的构造函数
function ArenaPanelItemInfoGJJDC:__init()
end

function ArenaPanelItemInfoGJJDC:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    self.go_table.obj_value:SetActiveE(1)
    self.go_table.aortext_info:SetActiveE(1)
    self:StopTimer()
    self.itemList = {}
end

---显示奖励
function ArenaPanelItemInfoGJJDC:ShowAward(award)
    self.go_table.trans_outputNode:ClearChildren()
    local layoutGroup = self.go_table.trans_outputNode:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI
    .HorizontalLayoutGroup))
    layoutGroup.enabled = false
    layoutGroup.padding.left = -16
    layoutGroup.padding.right = -16
    layoutGroup.spacing = -48
    layoutGroup.enabled = true
    local ItemFactory = _G.ItemFactory
    for i = 1, #award do
        if AppSetting.IsXzns then
            ItemFactory:GetInstance():GetItemCard(
                    ItemFactory.itemType.baseItem,
                    self.go_table.trans_outputNode,
                    function(item)
                        item:Show(award[i][1], nil, award[i][2])
                        item.gameObject:SetLocalScaleXYZ(0.54)
                        if self.go_table.trans_outputNode:GetChildCountE() > i then
                         _G.DestroyImmediate(item.gameObject)
                            return
                        end
                    end
            )
        else
            ItemFactory:GetInstance():GetItemCard(
                    ItemFactory.itemType.ItemSpiritualBase,
                    self.go_table.trans_outputNode,
                    function(item)
                        item:Show(award[i][1], nil, award[i][2])
                        item.gameObject:SetLocalScaleXYZ(0.54)
                        if self.go_table.trans_outputNode:GetChildCountE() > i then
                         _G.DestroyImmediate(item.gameObject)
                            return
                        end
                    end
            )
        end
    end
end

function ArenaPanelItemInfoGJJDC:OnShow(tb)
    self.go_table = tb
    self:Init()

    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(152) then
        ---@type SpiritualRealmModel
        local model = require "SpiritualRealmModel":GetInstance()
        local joinType = model:GetJoinType()
        ---右下角主要奖励
        if not self.initAward and joinType > 0 then
            local award = _G.ConfigManager.arena_layer_up_cfg[joinType].Preview
            self:ShowAward(award)
            self.initAward = true
        end
        if joinType > 0 then
            self.go_table.obj_output:SetActiveE(1)
        end
        --region 左下角信息和时间倒计时

        self.go_table.aortext_info.text = _G.GetLangPackValue(90022100009)
        if model:IsSettlementTime() then
            -- 不在活动期
            self.go_table.aortext_value.text = _G.GetLangPackValue(90030700076)
            self.go_table.obj_time:SetActiveE(0)
        else
            if not joinType or joinType == 0 then
                self.go_table.obj_time:SetActiveE(0)
                self.go_table.aortext_value.text = _G.GetLangPackValue(90030700074)
            else
                self.go_table.aortext_info:SetActiveE(1)
                local cfg = _G.ConfigManager.arena_layer_up_cfg[joinType]
                self.go_table.aortext_info.text = _G.GetLangPackValue(cfg.name)

                self.go_table.obj_time:SetActiveE(1)
                self.go_table.aortext_endTimeTitle.text = _G.GetLangPackValue(90022100266)
                self.closeCountdown = model:GetStopTime() - _G.TimeUtil.GetServerUnixTime()
                self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
                self:SetEndTime(0)
                self.timer:Start()
                local score = model:GetScore()
                local arena_layer_league_cfg = model:GetGradeCfg(score)
                self.go_table.aortext_value.text = _G.GetLangPackValue(arena_layer_league_cfg.name)
            end
        end
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
        --endregion
    else
        local strT = _G.FunctionManager:GetInstance():GetAllTipsStr(152)
        local str = strT[1]
        for i = 2, #strT do
            str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. strT[i]
        end
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = str
        self:SetGray(true)
        self.go_table.obj_time:SetActiveE(0)
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
    end
end

function ArenaPanelItemInfoGJJDC:SetEndTime(elapsed)
    self.closeCountdown = math.ceil(self.closeCountdown - elapsed)
    if self.closeCountdown <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self.timer:Stop()
    else
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(self.closeCountdown)
    end
end

function ArenaPanelItemInfoGJJDC:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoGJJDC:Dispose()
    local ItemFactory = _G.ItemFactory
    if not _G.IsNil(self.itemList) then
        for _, v in pairs(self.itemList) do
            ItemFactory:GetInstance():SetItemCard(v)
        end
        self.itemList = nil
    end
    self:StopTimer()
end

return ArenaPanelItemInfoGJJDC
