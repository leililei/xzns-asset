---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
---@class ArenaPanelItemInfoPWS:ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoPWS = _G.BaseClass("ArenaPanelItemInfoPWS", base)


---类的构造函数
function ArenaPanelItemInfoPWS:__init()
end

function ArenaPanelItemInfoPWS:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    self.go_table.obj_value:SetActiveE(1)
    self.go_table.aortext_info:SetActiveE(1)
    self:StopTimer()

end

function ArenaPanelItemInfoPWS:OnShow(tb)
    self.go_table = tb
    self:Init()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(138) then
        local ArenaPeakModel = require("ArenaPeakModel")
        self.go_table.obj_time:SetActiveE(1)
        self.go_table.aortext_endTimeTitle.text = _G.GetLangPackValue(90022100266)

        self.closeCountdown = ArenaPeakModel:GetInstance():GetStartSettlementTime() or 0
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
        self:SetEndTime(0)
        self.timer:Start()
        self.go_table.aortext_value.text =
            _G.GetLangPackValue(90029400052, ArenaPeakModel:GetInstance():GetCurSeasonID())
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
    else
        local strT = _G.FunctionManager:GetInstance():GetAllTipsStr(138)
        local str = strT[1]
        for i = 2, #strT do
            str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. strT[i]
        end
        self.go_table.aortext_condition:SetActiveE(1)
        self.go_table.aortext_condition.text = str
        self:SetGray(true)
        self.go_table.obj_time:SetActiveE(0)
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
    end
end

function ArenaPanelItemInfoPWS:SetEndTime(elapsed)
    self.closeCountdown = math.ceil(self.closeCountdown - elapsed)
    if self.closeCountdown <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self.timer:Stop()
    else
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(self.closeCountdown)
    end
end

function ArenaPanelItemInfoPWS:StopTimer()  
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoPWS:Dispose()
    self:StopTimer()
end

return ArenaPanelItemInfoPWS
