---@type ArenaPanelItemInfoBase
local base = require("ArenaPanelItemInfoBase")
---@class ArenaPanelItemInfoASZZ:ArenaPanelItemInfoBase	中文描述
local ArenaPanelItemInfoASZZ = _G.BaseClass("ArenaPanelItemInfoASZZ", base)


---类的构造函数
function ArenaPanelItemInfoASZZ:__init()
    self.functionOpenId = 147
    local cfg = _G.ConfigManager.function_open_cfg[self.functionOpenId]
    for _, v in pairs(cfg.condition_type) do
        if v[1] == 4 then
            self.type = v[1]
            self.params = v[2]
        end
    end
    self.openStr = _G.FunctionManager:GetInstance():GetStrWithType(self.type,self.params)
end

function ArenaPanelItemInfoASZZ:Init()
    base.Init(self)
    self.go_table.obj_time:SetActiveE(1)
    self.go_table.obj_value:SetActiveE(0)
    self.go_table.aortext_info:SetActiveE(0)
    self.go_table.aortext_condition:SetActiveE(0)
    self:StopTimer()

end

function ArenaPanelItemInfoASZZ:OnShow(tb)
    self:StopTimer()
    self.go_table = tb
    self:Init()
    self.openDelTime =
        require("SociatyBattleManager"):GetInstance():GetSociatyBattleOpenTime()
        - _G.TimeUtil.GetServerUnixTime()

    if _G.GlobalConditionManager.CheckCondition(self.type,self.params) and self.openDelTime <= 0 then
        local model = require("SociatyBattleModel"):GetInstance()

        local state = model:GetState()
        if state == _G.SociatyBattleState.Match then
            self.go_table.aortext_info:SetActiveE(0)
            self.go_table.aortext_endTimeTitle.text = _G.GetLangPackValue(90021800473)
            self.closeCountdown = model:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
            self:SetEndTime(0)
            self.timer:Start()
        elseif state == _G.SociatyBattleState.Battle then
            self.go_table.obj_time:SetActiveE(0)
            self.go_table.obj_value:SetActiveE(1)
            self.go_table.aortext_info:SetActiveE(1)
            self.go_table.aortext_info.text = _G.GetLangPackValue(90021800330)
            self.go_table.aortext_value.text = model:GetChallengeNum()
        elseif state == _G.SociatyBattleState.Settlement then
            self.go_table.aortext_endTimeTitle.text = _G.GetLangPackValue(90000010091)
            self.closeCountdown = model:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.SetEndTime, self, false, false, true)
            self:SetEndTime(0)
            self.timer:Start()
        else
            self.go_table.obj_time:SetActiveE(0)
            self.go_table.aortext_condition:SetActiveE(1)
            self.go_table.aortext_condition.text = _G.GetLangPackValue(90031700203)
        end
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            self.go_table.obj_value:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
    else
        self.go_table.aortext_condition:SetActiveE(1)
        if self.openDelTime >= 0 then
            self.openTimer = _G.TimerManager:GetInstance():GetTimer(
                1,
                self.SetOpenTime,
                self,false,false,true
            )
            self:SetOpenTime(0)
            self.openTimer:Start()
        else
            self.go_table.aortext_condition.text = self.openStr
        end


        self:SetGray(true)
        self.go_table.obj_time:SetActiveE(0)
        self.go_table.obj_value:SetActiveE(0)
        self.go_table.aortext_info:SetActiveE(0)
    end
end

function ArenaPanelItemInfoASZZ:SetOpenTime(elapsed)
    self.openDelTime = math.ceil(self.openDelTime - elapsed)
    if self.openDelTime <= 0 then
        self.timer:Stop()
        self:OnShow(self.go_table)
    else
        self.go_table.aortext_condition.text =
            self.openStr
            .. _G.GetLangPackValue(9002010024)
            .. _G.GetLangPackValue(90028300082, _G.TimeUtil.TranslateSecondForStr(self.openDelTime))
    end
end

function ArenaPanelItemInfoASZZ:SetEndTime(elapsed)
    self.closeCountdown = math.ceil(self.closeCountdown - elapsed)
    if self.closeCountdown <= 0 then
        self.go_table.obj_time:SetActiveE(0)
        self.timer:Stop()
    else
        self.go_table.aortext_endTime.text = _G.TimeUtil.TranslateSecondForStr(self.closeCountdown)
    end
end

function ArenaPanelItemInfoASZZ:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.openTimer then
        self.openTimer:Stop()
        self.openTimer = nil
    end
end

---类的析构函数
function ArenaPanelItemInfoASZZ:Dispose()
    self:StopTimer()
end

return ArenaPanelItemInfoASZZ
