local ArenaManager = require "ArenaManager"
local ArenaController = require "ArenaController"
local EmbattleModel = require "EmbattleModel"
--region
local ArenaChallengeItem = _G.BaseClass("ArenaChallengeItem")

function ArenaChallengeItem:__init(obj, challengeCall)
    self.gameObject = obj
    self.onChallengeCallback = challengeCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ArenaChallengeItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_chanllenge then
        if self.onChallengeCallback then
            self.onChallengeCallback(self.data.uid, self.data.name)
        end
    elseif go == self.go_table.aorbtn_IconBtn then
        local enemy = ArenaController:GetInstance():GetEnemyDataByUid(self.enemyUid)
        if enemy.mType ~= 1 then
            ArenaController:GetInstance():ShowEnemyView(enemy)
        end
    end
end

function ArenaChallengeItem:Show(data, free, mpower, mscore, cfg, chanllengeIcon)
    self.data = data
    self.enemyUid = data.uid
    self.go_table.aortext_score.text = data.score
    self.go_table.aortext_name.text = data.name
    local isHigh = mpower and mpower < data.power
    self.go_table.aortext_power:SetActiveE(isHigh and 0 or 1)
    self.go_table.aortext_powerRed:SetActiveE(isHigh and 1 or 0)
    if isHigh then
        self.go_table.aortext_powerRed.text = _G.GameUtil.NumberToUnitWord(data.power)
    else
        self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.power)
    end
    --local portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    --_G.UIUtils.SetAorImageByPath(self.go_table.aorimage_head, portraitCfg.portrait1)
    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data, 0.8, true, true, false,
                function()
                if self.data.mType ~= 1 then
                    if self.data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                        _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                    else
                        _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
                    end
                else
                    _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(self.data.uid, nil, _G.RobotType.Arena)
                end
            end)
    self.go_table.aortext_victoryScore.text =
        _G.GetLangPackValue(90022100278, ArenaController:GetInstance():CalculateWinScore(data.score, cfg, mscore))
    self.go_table.obj_free:SetActiveE(free and 1 or 0)
    self.go_table.obj_challenge:SetActiveE(free and 0 or 1)
    self.go_table.aorrawimage_chanllengeIcon:LoadImage(chanllengeIcon)
    self.gameObject:SetActiveE(1)
end

--endregion

---@class ArenaChanllengeView : UIBaseView	中文描述
---@field public go_table ArenaChanllengeView_GoTable GoTable
local ArenaChanllengeView = _G.BaseClass("ArenaChanllengeView", _G.UIBaseView)

function ArenaChanllengeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.toggle_skip.onValueChanged:AddListener(_G.handler(self, self.OnValueChanged))
end

---界面的入口函数
function ArenaChanllengeView:OnCreate()
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(1)
    self.onChallengeHandler = _G.handler(self, self.OnChallengeBtn)
    self.itemList = {
        ArenaChallengeItem.New(self.go_table.obj_chanllengeItem1, self.onChallengeHandler),
        ArenaChallengeItem.New(self.go_table.obj_chanllengeItem2, self.onChallengeHandler),
        ArenaChallengeItem.New(self.go_table.obj_chanllengeItem3, self.onChallengeHandler),
        ArenaChallengeItem.New(self.go_table.obj_chanllengeItem4, self.onChallengeHandler)
    }
    for i = 1, #self.itemList do
        self.itemList[i].gameObject:SetActiveE(0)
    end
    self.refreshTime = 0
    local showSkip = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(96)
    if showSkip then
        local isOn = _G.PlayerPrefsManager.GetInt((_G.PlayerModel:GetInstance().role_uid) .. "ArenaNormalOutSkipBattle")
        self.go_table.toggle_skip.isOn = isOn == 1
    end
    self:UpdateSelfInfo()
end

function ArenaChanllengeView:OnEnable()
    local controller = ArenaController:GetInstance()
    controller:GetEnemyArray(_G.handler(self, self.OnEnemyArrayCall))
    controller:GetFreshTime(_G.handler(self, self.OnFreshBtnTimeCall))
    controller:SetRefreshCall(_G.handler(self, self.RefreshView))
    self:Show()
end

function ArenaChanllengeView:OnDisable()
    ArenaController:GetInstance():SetRefreshCall(nil)
    self.arenaClass:SetFreshTimeCall()
end

function ArenaChanllengeView:OnDestroy()
    self.arenaClass = nil
    self.onChallengeHandler = nil
end

---按钮点击事件在这里派发
function ArenaChanllengeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        ArenaController:GetInstance():OnChallengeViewBack()
        self:Close()
    elseif go == self.go_table.aorbtn_chanllengeTimes then
        self.arenaClass:BuyTicket(_G.handler(self, self.OnBuyTicketCall))
    elseif go == self.go_table.aorbtn_fresh then
        self:FreshEnemy()
    end
end

---ZHJH-711 未解锁时点击显示解锁条件
function ArenaChanllengeView:OnValueChanged(isOn)
    -- 检查功能是否解锁
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(96) then
        -- 显示功能未解锁提示
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(96)
        self.go_table.toggle_skip.isOn = false
        return
    end

    -- 处理正常逻辑
    local isSkip = self.go_table.toggle_skip.isOn
    _G.PlayerPrefsManager.SetInt(
            (_G.PlayerModel:GetInstance().role_uid) .. "ArenaNormalOutSkipBattle",
            isSkip and 1 or 0
    )
end

---更新自己的个人信息
function ArenaChanllengeView:UpdateSelfInfo()
    self.go_table.aortext_free.text = _G.GetLangPackValue(90022100277, self.arenaClass:GetFreeFightTimes())
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(
        EmbattleModel:GetInstance():GetEmbattlePower(_G.EmbattleType.arenaAttack, true)
    )
    self.go_table.aortext_score.text = self.arenaClass:GetScore()
end

function ArenaChanllengeView:FreshEnemy()
    if self.refreshTime > 0 then --提示刷新时间
        _G.PopWindowManager:GetInstance():ShowAllTips(300106)
    else
        self.arenaClass:RefreshEnemy(_G.handler(self, self.OnEnemyArrayCall), _G.handler(self, self.OnFreshBtnTimeCall))
    end
end

function ArenaChanllengeView:OnFreshCallback()
    ArenaController:GetInstance():GetEnemyArray(_G.handler(self, self.OnEnemyArrayCall))
end

function ArenaChanllengeView:RefreshView()
    self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
    self:UpdateSelfInfo()
end

function ArenaChanllengeView:OnBuyTicketCall(result)
    if result == 1 then
        self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
    end
end

function ArenaChanllengeView:OnFreshBtnTimeCall(time)
    self.refreshTime = time
    if self.refreshTime > 0 then
        self.go_table.aortext_fresh.text =
            _G.string.format(_G.GetLangPackValue(90026100037), math.ceil(self.refreshTime))
    else
        --刷新
        self.go_table.aortext_fresh.text = _G.GetLangPackValue(90021700009)
    end
end

function ArenaChanllengeView:OnChallengeBtn(uid, enemyName)
    if self.arenaClass:GetCurArenaState() ~= 1 then
        local closeFun = function()
            self:Close()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(300301, nil, closeFun, closeFun)
        return
    end
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    if self.arenaClass:GetAllFightTimes() <= 0 then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(300101)
        self.arenaClass:BuyTicket(_G.handler(self, self.OnBuyTicketCall))
        return
    end
    local isSkip = self.go_table.toggle_skip.isOn
    _G.PlayerPrefsManager.SetInt(
        (_G.PlayerModel:GetInstance().role_uid) .. "ArenaNormalOutSkipBattle",
        isSkip and 1 or 0
    )
    ArenaController:GetInstance():Challenge(uid, isSkip, enemyName)
end

function ArenaChanllengeView:Show()
    self.go_table.aortext_chanllengeTimes.text = self.arenaClass:GetFightTicketNum()
    self.go_table.aorrawimage_chanllengeIcon:LoadImage(self.arenaClass:GetFightTicketIcon())
end

function ArenaChanllengeView:OnEnemyArrayCall(list)
    local times, sum = self.arenaClass:GetFreshEnemyTimes()
    local freeFight = self.arenaClass:GetFreeFightTimes() > 0
    local power = require("EmbattleModel"):GetInstance():GetEmbattlePower(_G.EmbattleType.arenaAttack)
    local leaguecfg = _G.ConfigManager.arena_league_cfg
    for i = 1, #list do
        if i > #self.itemList then
            break
        end
        self.itemList[i]:Show(list[i], freeFight, power, self.arenaClass:GetScore(), leaguecfg[list[i].league], self.arenaClass:GetFightTicketIcon())
    end
end

return ArenaChanllengeView
