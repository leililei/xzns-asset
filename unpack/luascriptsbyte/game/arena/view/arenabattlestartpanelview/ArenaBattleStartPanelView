function ArenaBattleStartPanelView:ShowBaseInfo()
    local playerModel = _G.PlayerModel:GetInstance()
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[playerModel:GetRoleStyle()]
    self.go_table.aorrawimage_mHeadIcon:LoadImage(portraitCfg.portrait1)
    self.go_table.aortext_name1.text = playerModel.role_name
    self.go_table.aortext_power1.text =
        require("EmbattleModel"):GetInstance():GetEmbattlePower(_G.EmbattleType.arenaAttack)

    local controller = require("ArenaController"):GetInstance()
    local data = controller:GetEnemyDataByUid(controller.curChallengeUid)
    portraitCfg = _G.ConfigManager.player_portrait_cfg[data.style]
    self.go_table.aorrawimage_nHeadIcon:LoadImage(portraitCfg.portrait1)
    self.go_table.aortext_name2.text = data.name
    self.go_table.aortext_power2.text = data.power
    self.loadImgCount = 12
    self:ShowMyEmbattle()
    self:ShowEnemyEmbattle()
    if self.loadImgCount == 0 then
        self.loadImageDone = true
    end
end

