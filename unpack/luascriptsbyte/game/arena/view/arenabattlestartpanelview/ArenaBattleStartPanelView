local showTime = 0.2
function ArenaBattleStartPanelView:TimeToShowMCard(trans)
    local count = #trans
    if count <= 0 then
        return
    end
    local index = 1
    self.Timer =
        _G.TimerManager:GetInstance():GetTimer(
        showTime,
        self.TimerFunc,
        self,
        false,
        false,
        false,
        trans,
        index,
        count
    )
    self.Timer:Start()
end

function ArenaBattleStartPanelView:TimerFunc(trans,index,count)
    trans[index].transform:GetChildE(0):SetActiveE(1)
    local animator = trans[index].transform:GetComponentE(typeof(CS.UnityEngine.Animator))
    animator.enabled = false
    animator.enabled = true
    index = index + 1
    if index > count then
        self.Timer:Stop()
    end
end

function ArenaBattleStartPanelView:TimeToShowTeamBg(trans)
    local count = #trans
    if count <= 0 then
        return
    end
    local index = 1
    self.Timer =
        _G.TimerManager:GetInstance():GetTimer(
        showTime,
        self.TimerFunc,
        self,
        false,
        false,
        false,
        trans,
        index,
        count
    )
    self.Timer:Start()
end

function ArenaBattleStartPanelView:TimerFunc(trans,index,count)
    trans[index]:SetActiveE(1)
    index = index + 1
    if index > count then
        self.Timer:Stop()
    end
end

function ArenaBattleStartPanelView:ShowMyCard(parent, table)
    if table[1] == "hero" then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.BodyItem_select,
            parent,
            _G.handlerbind(self, self.ShowMyCardInfo, table[2])
        )
    elseif table[1] == "guard" then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.BodyItem_select,
            parent,
            _G.handlerbind(self, self.ShowMyCardInfo, table[2])
        )
    end
end

function ArenaBattleStartPanelView:ShowMyCardInfo(item, id)
    if id > 0 then
        item.transform:SetName(id)
        item.transform:SetLocalScaleXYZ(0.8)
        local item1 = item
        self.cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, id)
        item1:ShowCardData(self.cardData, nil)
    else
        item.gameObject:SetActiveE(0)
    end
end
function ArenaBattleStartPanelView:ShowEnemyCard(parent, table)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.BodyItem_select,
        parent,
        _G.handlerbind(self, self.ShowEnemyCardInfo, table)
    )
end
function ArenaBattleStartPanelView:ShowEnemyCardInfo(item, table)
    if table.sid > 0 then
        item.transform:SetName(table.sid)
        item.transform:SetLocalScaleXYZ(0.8)
        local item1 = item
        self.cardData = table
        item1:ShowCardData(self.cardData, nil)
    else
        item.gameObject:SetActiveE(0)
    end
end
