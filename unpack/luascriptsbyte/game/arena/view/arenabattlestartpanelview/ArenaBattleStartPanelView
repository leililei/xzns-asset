local CS = _G.CS
local typeof = _G.typeof

--region 卡牌item
local ArenaBattleStartCardItem = _G.BaseClass("ArenaBattleStartCardItem")

function ArenaBattleStartCardItem:__init(obj, loadBack)
    self.gameObject = obj
    self.transform = obj
    self.loadImgCall = loadBack
    self.go_table = _G.GetAutoGoTable(obj)
end
function ArenaBattleStartCardItem:Show(sid, lv, star)
    self:ShowObj(sid == 0)
    self.gameObject:SetActiveE(1)
    if sid == 0 then
        if self.loadImgCall then
            self.loadImgCall()
        end
        self.go_table.aorimage_bg.SpriteName = "ui-jsjx-kp-white2"
        return
    end

    local cfg = require "CardCommentManager":GetInstance():CardData(sid)

    if not cfg then
        return
    end
    local type_professional_cfg = _G.ConfigManager.type_professional_cfg[cfg.Professional]
    if type_professional_cfg then
        self.go_table.aorrawimage_professional:LoadImage(type_professional_cfg.icon)
    end
    local cardinfoManager = require("CardInfoManager"):GetInstance()
    cardinfoManager:StarEf_byParent(self.go_table.obj_starParent, star)
    self.go_table.aorimage_bg.SpriteName = cardinfoManager:GetCardQualityBGSpriteName(cfg.Order)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
    self.go_table.aortext_level.text = lv
    self.go_table.aorrawimage_role:LoadImage(
        cfg.Photo,
        function()
            if self.loadImgCall then
                self.loadImgCall()
            end
        end
    )
end
function ArenaBattleStartCardItem:ShowObj(show)
    for i = 0, self.go_table.aorimage_bg:GetChildCountE() - 1 do
        self.go_table.aorimage_bg:GetChildE(i):SetActiveE(show and 1 or 0)
    end
    self.go_table.obj_elements:SetActiveE((not show) and 1 or 0)
    self.go_table.aorrawimage_role:SetActiveE((not show) and 1 or 0)
    for i = 0, self.go_table.trans_bg:GetChildCountE() - 1 do
        self.go_table.trans_bg:GetChildE(i):SetActiveE((not show) and 1 or 0)
    end
    self.go_table.obj_noneHero:SetActiveE(show and 1 or 0)
    self.go_table.obj_starParent:SetActiveE((not show) and 1 or 0)
end
--endregion

