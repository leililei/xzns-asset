function ArenaBattleStartPanelView:ShowEnemyEmbattle()
    require("ArenaController"):GetInstance():GetEnemyCardList(
        nil,
        function(sids)
            local teamTrans = {}
            local itemTrans = {}
            for i = 1, #sids, 2 do
                local teamPrefab = _G.InstantiateObject(self.go_table.trans_eheroteam, self.go_table.trans_ehero)
                if sids[i].sid > 0 then
                    local item = self:ShowEnemyCard(teamPrefab, sids[i])
                    _G.table.insert(itemTrans, item)
                    _G.table.insert(teamTrans, teamPrefab)
                    self.loadImgCount = self.loadImgCount - 1
                else
                    local aorimage = teamPrefab:GetComponentE(typeof(CS.AorRawImage))
                    aorimage.enabled = false
                    self.loadImgCount = self.loadImgCount - 1
                end
                if sids[i + 1].sid > 0 then
                    local item = self:ShowEnemyCard(teamPrefab, sids[i + 1])
                    _G.table.insert(itemTrans, item)
                    _G.table.insert(teamTrans, teamPrefab)
                    self.loadImgCount = self.loadImgCount - 1
                else
                    local aorimage = teamPrefab:GetComponentE(typeof(CS.AorRawImage))
                    aorimage.enabled = false
                    self.loadImgCount = self.loadImgCount - 1
                end
            end
            self:TimeToShowMCard(itemTrans)
            self:TimeToShowTeamBg(teamTrans)
        end
    )
end

return ArenaBattleStartPanelView
