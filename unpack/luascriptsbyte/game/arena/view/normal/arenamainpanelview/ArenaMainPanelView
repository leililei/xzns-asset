local ArenaMainPanelView = _G.BaseClass("ArenaMainPanelView", _G.UIBaseView)

function ArenaMainPanelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    self.top3Tb = {
        _G.GetAutoGoTable(self.go_table.obj_no1, _G.handlerbind(self, self.OpenPlayerInfo, 1)),
        _G.GetAutoGoTable(self.go_table.obj_no2, _G.handlerbind(self, self.OpenPlayerInfo, 2)),
        _G.GetAutoGoTable(self.go_table.obj_no3, _G.handlerbind(self, self.OpenPlayerInfo, 3))
    }
    for i = 1, 3 do
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ArenaMainPanelItem .. i, self.top3Tb[i])
    end
end

---界面的入口函数
function ArenaMainPanelView:OnCreate()
    self.curArenaSid = 1
    self.singleClass = ArenaManager:GetInstance():GetArenaClass(self.curArenaSid)
    ---停用胜点宝箱
    self.boxes = { false, false, false }
    local cfg = _G.ConfigManager.arena_info_cfg[self.curArenaSid]
    self.points_con = { cfg.points_con1, cfg.points_con2, cfg.points_con3 }
    self:InitView()
    self:AddComponent(
            self.go_table.obj_resourceRoot,
            require("ResourceCompont").New(
                    self.go_table.obj_resourceRoot,
                    _G.ConfigManager.ui_cfg.ArenaMainPanelView.resources
            )
    )
    self:InitToggle()
    self:ShowRank()
    local ArenaControllerIns = ArenaController:GetInstance()
    ArenaControllerIns:SetRefreshCall(_G.handler(self, self.RefreshView))
    ArenaControllerIns:SetArenaLoginFirstByDay(1)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.NormalArena.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLineup.id)
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
    self:ShowTransitionGuidedBtn()
end

---
---@protected
function ArenaMainPanelView:ShowTransitionGuidedBtn()
    local activity = ActivitySynManager:GetInstance():GetActivityWithTypeId(10081)
    if activity then
        local isOpen = activity:GetActivityTypeCls():CheckOpen()
        if isOpen == true then
            local index = activity:GetActivityTypeCls():GetOpenIndex()
            self.go_table.toggle_transitionGuided:SetActiveE(index == 3 and 1 or 0)
            if tonumber(index) == 3 then
                local tb = _G.GetAutoGoTable(self.go_table.toggle_transitionGuided)
                local icon, _ = activity:GetShowBtnInfo()
                tb.aorimage_icon.SpriteName = icon
                tb.aorimage_icon2.SpriteName = icon
            end
        end
    end
end

function ArenaMainPanelView:OnDisable()
    local ArenaControllerIns = ArenaController:GetInstance()
    ArenaControllerIns:SetRefreshCall()
    ArenaControllerIns:ClearEndTimeCall()
end

function ArenaMainPanelView:RefreshView()
    if self.singleClass:GetCurArenaState() == ArenaManager.State.open then
        self:InitView()
        ArenaController:GetInstance():GetRankList(_G.handler(self, self.OnRankRefresh))
    end
end

