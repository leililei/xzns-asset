function ArenaMainPanelView:InitView()
    local playerModel = _G.PlayerModel:GetInstance()
    self.go_table.aortext_name.text = playerModel:GetName()
    self.go_table.aortext_rank.text = self.singleClass:GetRank()
    self.go_table.aortext_score.text = self.singleClass:GetScore()
    self.go_table.aortext_season.text = self.singleClass:GetSeason()
    self.go_table.aortext_free.text = string.format(_G.GetLangPackValue(90022100106), self.singleClass:GetFreeFightTimes())
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(
            EmbattleModel:GetInstance():GetEmbattlePower(_G.EmbattleType.arenaAttack, true)
    )
    local playerData = {}
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.title = playerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, playerData, 1, true, true)
    local controller = ArenaController:GetInstance()
    controller:GetEndTime(_G.handler(self, self.TimeUpdate))
    self:UpdateTicket()
end

function ArenaMainPanelView:UpdateTicket()
    self.go_table.aortext_chanllengeTimes.text = self.singleClass:GetFightTicketNum()
    self.go_table.aorrawimage_chanllengeIcon:LoadImage(self.singleClass:GetFightTicketIcon())
end

