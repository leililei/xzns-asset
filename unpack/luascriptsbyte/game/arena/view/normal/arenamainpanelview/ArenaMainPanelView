function ArenaMainPanelView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaRankItem.New(obj)
    end
    self.itemTransDic[instanceID]:Show(self.rankList[index + 3])
end

function ArenaMainPanelView:InitToggle()
    self.toggles = {
        award = _G.GetAutoGoTable(
                self.go_table.toggle_award,
                _G.handlerbind(self, self.OnClickToggle, "award", _G.handler(self, self.OnAward))
        ),
        report = _G.GetAutoGoTable(
                self.go_table.toggle_report,
                _G.handlerbind(self, self.OnClickToggle, "report", _G.handler(self, self.OnReport))
        ),
        embattle = _G.GetAutoGoTable(
                self.go_table.toggle_embattle,
                _G.handlerbind(self, self.OnClickToggle, "embattle", _G.handler(self, self.OnEmbattle))
        ),
        top = _G.GetAutoGoTable(
                self.go_table.toggle_top,
                _G.handlerbind(self, self.OnClickToggle, "top", _G.handler(self, self.OnTop))
        ),
        transitionGuided = _G.GetAutoGoTable(
            self.go_table.toggle_transitionGuided,
            _G.handlerbind(self, self.OnClickToggle, "transitionGuided", _G.handler(self, self.OnTransitionGuided))
        )
    }
end

function ArenaMainPanelView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function ArenaMainPanelView:OnAward(isOn)
    if not isOn then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaAwardPageView.Name)
end

function ArenaMainPanelView:OnReport(isOn)
    if not isOn then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaReportPanel.Name, ArenaManager.arenaType.normal)
end

function ArenaMainPanelView:OnEmbattle(isOn)
    if not isOn then
        return
    end
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    local function OnEmbattleViewOpen(self, name)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
        self:Close()
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
    ArenaController:GetInstance():OpenEmbattle()
end

function ArenaMainPanelView:OnTop(isOn)
    if not isOn then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaTopAwardView.Name, 1)
end

function ArenaMainPanelView:OnTransitionGuided(isOn)
    if not isOn then
        return
    end
    local activity = ActivitySynManager:GetInstance():GetActivityWithTypeId(10081)
    _G.GlobalInterface.JumpActivityByGM(10081, activity:GetJumpType())
end

function ArenaMainPanelView:OnUIClosed(name)
    self.go_table.toggle_award.isOn = false
    self.go_table.toggle_embattle.isOn = false
    self.go_table.toggle_report.isOn = false
    self.go_table.toggle_top.isOn = false
    self.go_table.toggle_transitionGuided.isOn = false
end

function ArenaMainPanelView:OnDestroy()
    self:RemoveAllListener()
end

return ArenaMainPanelView
