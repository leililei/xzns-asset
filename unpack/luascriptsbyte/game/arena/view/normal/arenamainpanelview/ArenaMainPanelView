        --        _G.UIManager:GetInstance():OpenWindow(
        --            _G.ConfigManager.ui_cfg.ArenaCommonRankView.Name,
        --            self.rankList,
        --            awards,
        --            self.singleClass:GetRank(),
        --            power
        --        )
        --    end
        --)
        _G.PlayerPrefsManager.SetInt(key1, self.singleClass:GetSeason())
