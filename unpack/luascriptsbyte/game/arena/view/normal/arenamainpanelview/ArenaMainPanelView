function ArenaMainPanelView:OnRankListCall(list)
    self.rankList = list
    self.go_table.scrollloopvectical_rank:UpdateCount(#list - 3)
    self:UpdateTop3Rank()
    self:OpenTopAwardOrRankView()
end

function ArenaMainPanelView:OnRankRefresh(list)
    self.rankList = list
    self.go_table.scrollloopvectical_rank:UpdateCount(#list - 3)
    self:UpdateTop3Rank()
end

function ArenaMainPanelView:UpdateTop3Rank()
    local pbData = { roles = {} }
    local tb, data
    self.uidRank = {}
    self.roleSkin = {}
    for i = 1, 3 do
        tb = self.top3Tb[i]
        data = self.rankList[i]
        tb.trans_role:ClearChildren()
        if data == nil then
            tb.aortext_name.text = _G.GetLangPackValue(90021800103)
            tb.aortext_score.text = ""
            tb.aortext_power.text = ""
        else
            tb.aortext_name.text = data.name
            tb.aortext_score.text = data.score
            tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
            if data.type == 1 then
                self.roleSkin[i] = { skin = _G.ConfigManager.discrete_cfg[100002][1][1] }
            else
                _G.table.insert(pbData.roles, data.uid)
            end
            self.uidRank[data.uid] = i
        end
        self:UpdateTitle(tb, data.title)
        if _G.AppSetting.IsXzns then
            GameUtil.SetUiHeXieMask(tb)
        end
    end
    if #pbData.roles > 0 then
        require("CommonRankNet"):GetInstance():GetRoleStyle(
                pbData,
                function(msg)
                    for _, v in pairs(msg.roles) do
                        self.roleSkin[self.uidRank[v.uid]] = v
                    end
                    self:OnInitRankEnd()
                end
        )
    else
        self:OnInitRankEnd()
    end
end

---生成称号
---@param item table
function ArenaMainPanelView:UpdateTitle(tb, data)
    if data.sid == 0 then
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title,
                function(img)
                    if self:IsNil() then
                        return
                    end
                    img:SetNativeSize()
                end
        )
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle ~= player_title.title then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle = player_title.title
            UIUtils.LoadEffectTitleOrFrame(
                    player_title.title,
                    tb.obj_titleEffect,
                    function(trans)
                        if self.curShowEffTitle ~= player_title.title then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                        trans:SetLocalScaleXYZ(titleScale)
                    end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function ArenaMainPanelView:OnInitRankEnd()
    local tb, skinId
    for k, v in pairs(self.roleSkin) do
        tb = self.top3Tb[k]
        skinId = self.roleSkin[k].skin
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(skinId, skinId) ---异步变量
        local scale = cfg.size2
        local pos = cfg.pos_portrait
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
            scale = cfg.size4 or 1
            pos = { 0, 0, 0 }
        end
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            tb.trans_role,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(scale)
                trans:SetLocalPosition(_G.table.unpack(pos))
                --- 只有星座女神有神环
                if _G.AppSetting.IsXzns then
                    local godHaloID = self.roleSkin[k].god_halo
                    if godHaloID and godHaloID ~= 0 then
                        local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                        --- 神环路径，父级路径(加载角色的下面)
                        _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                        end
                    end
                    if not table.isEmptyOrNil(v.artifact_skin) then
                        _G.UIUtils.LoadArtifacteffect(trans,nil,v.artifact_skin[1],v.artifact_skin[2],true)
                    end
                end
        )
    end
end

function ArenaMainPanelView:OpenPlayerInfo(go, isOn, index)
    if self.rankList == nil then
        return
    end
    local data = self.rankList[index]
    if data == nil then
        return
    end
    if data.type ~= 1 then
        if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            _G.PopWindowManager:GetInstance():ShowAllTips(620109)
        else
            _G.SystemSettingManager:GetInstance():OpenView(data.uid)
        end
    else
        _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(data.uid, nil, _G.RobotType.Arena)
    end
end

