function ArenaMainPanelView:OnBoxClick(index)
    local controller = ArenaController:GetInstance()
    if controller:GetBoxState(self.points_con[index]) then
        controller:OpenBoxAwardPre(index)
        return
    end
    local winTimes = controller:GetWinTimes()
    if winTimes >= self.points_con[index] then
        controller:GetBoxAward(self.points_con[index], _G.handler(self, self.GetBoxAwardCallback))
    else
        controller:OpenBoxAwardPre(index)
    end
end

