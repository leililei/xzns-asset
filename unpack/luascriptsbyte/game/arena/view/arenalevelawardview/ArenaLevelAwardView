local descStr = _G.GetLangPackValue(90022100108)
--region 段位item
local ArenaLevelAwardItem = _G.BaseClass("ArenaLevelAwardItem")

function ArenaLevelAwardItem:__init(obj, getCall)
    self.gameObject = obj
    self.getAwardCallback = getCall
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
end
function ArenaLevelAwardItem:Dispose()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = nil
    self.curRankID = nil
    self.gameObject = nil
    self.getAwardCallback = nil
    self.go_table = nil
end
---按钮点击事件在这里派发
function ArenaLevelAwardItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_get then
        require("ArenaController"):GetInstance():GetRankAward(self.curRankID, _G.handler(self, self.OnAwardGetCall))
    end
end
function ArenaLevelAwardItem:OnAwardGetCall(state, data)
    if state then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        if self.getAwardCallback then
            self.getAwardCallback()
        end
    end
end
function ArenaLevelAwardItem:Show(id, getCall)
    self.gameObject:SetActiveE(1)
    self.curRankID = id
    local cfg = _G.ConfigManager.arena_league_cfg[id]
    self.go_table.aortext_score.text = _G.string.format(descStr, cfg.min_score)
    ---镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34306
    --【客户端】普通竞技场-屏蔽积分奖励页签
    if not _G.table.isEmptyOrNil(cfg.reward_level) then
        self:ShowAward(cfg.reward_level)
    end
    self:ShowAwardState()
end
---显示奖励
function ArenaLevelAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_itemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
---显示领取状态
function ArenaLevelAwardItem:ShowAwardState()
    self.go_table.aorbtn_get:SetActiveE(0)
    self.go_table.obj_gray:SetActiveE(0)
    self.go_table.obj_alreadyGet:SetActiveE(0)
    local controller = require("ArenaController"):GetInstance()
    if controller:GetRankAwardState(self.curRankID) then
        self.go_table.obj_alreadyGet:SetActiveE(1)
    elseif controller:CheckRankAwardTo(self.curRankID) then
        self.go_table.aorbtn_get:SetActiveE(1)
    else
        self.go_table.obj_gray:SetActiveE(1)
    end
end
--endregion

---@class ArenaLevelAwardView : UIBaseView	中文描述
---@field public go_table ArenaLevelAwardView_GoTable GoTable
local ArenaLevelAwardView = _G.BaseClass("ArenaLevelAwardView", _G.UIBaseView)

function ArenaLevelAwardView:Awake()
    self.itemTransDic = {}
end

---界面的入口函数
function ArenaLevelAwardView:OnCreate(parent)
    self.parent = parent
    self.go_table.scrollloopvectical_award:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.cfgs = {}
    ---镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34306
    --【客户端】普通竞技场-屏蔽积分奖励页签
    -- for id, value in pairs(_G.ConfigManager.arena_league_cfg) do
    --     if #value.reward_level > 0 then
    --         _G.table.insert(self.cfgs, id)
    --     end
    -- end
    self:SortItem(true)
end
function ArenaLevelAwardView:Close()
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end
function ArenaLevelAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaLevelAwardItem.New(obj, _G.handler(self, self.SortItem))
    end
    self.itemTransDic[instanceID]:Show(self.cfgs[index])
end

function ArenaLevelAwardView:SortItem(init)
    local controller = require("ArenaController"):GetInstance()
    local geta, getb
    _G.table.sort(
        self.cfgs,
        function(a, b)
            geta = controller:GetRankAwardState(a)
            getb = controller:GetRankAwardState(b)
            if geta and getb then
                return a < b
            elseif not geta and not getb then
                return a < b
            elseif geta then
                return false
            end
            return true
        end
    )
    if init then
        self.go_table.scrollloopvectical_award:UpdateCount(#self.cfgs)
    else
        self.go_table.scrollloopvectical_award:UpdateAllItem()
    end
end

function ArenaLevelAwardView:EscClose()
    if self.parent then
        self.parent.curView:Close()
        self.parent:Close()
    end
end

return ArenaLevelAwardView
