---@class GroupBattlePanelView : UIBaseView	中文描述
---@field public go_table GroupBattlePanelView_GoTable GoTable
local GroupBattlePanelView = _G.BaseClass("GroupBattlePanelView", _G.UIBaseView)

function GroupBattlePanelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local Sprites ={
    [0] = "ui_ddhf_shengli_xiaoqizhi",
    [1] = "ui_ddhf_shibai_xiaoqizhi"
}

---界面的入口函数
function GroupBattlePanelView:OnCreate(data,win,enemyData,leftData,fight_arg,reportType,uid,isChat)
    local left,right = 0,0
    for i =1 ,#win do
        if win[i] == 1 then
            right = right + 1
        else
            left = left + 1
        end
    end
    self.winnertable = win
    self.fight_arg = fight_arg
    self.isChat = isChat
    local fight = {}
    for i =1 ,#self.fight_arg.attacker_team do
        fight[i] = {}
        fight[i].atk_uid = self.fight_arg.atk_uid
        fight[i].auto = self.fight_arg.auto
        fight[i].fight_type = self.fight_arg.fight_type
        fight[i].seed = self.fight_arg.seed
        fight[i].sid = self.fight_arg.sid
        fight[i].attacker_team = {}
        fight[i].attacker_team[1] = self.fight_arg.attacker_team[i]
        fight[i].defender_team = {}
        fight[i].attacker_team[1] = self.fight_arg.defender_team[i]

    end
    self.fight = fight
    self.bct = _G.BattleControllerType.arenaSenior
    self.reportType = reportType
    self.playback_uid = uid
    self.data = data
    self.enemyData = enemyData
    self:InitScore(left,right)
    self:InitHead(leftData,enemyData)
    self:InitDetail(data)
end
function GroupBattlePanelView:InitScore(left,right)
    self.go_table.aortext_leftScore.text = left
    self.go_table.aortext_rightScore.text = right
end

function GroupBattlePanelView:InitHead(leftData,enemyData)
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    local UIUtils = _G.UIUtils
    local style = leftData and leftData.style or PlayerModelIns:GetRoleStyle()
    local frame = leftData and leftData.frame or PlayerModelIns:GetCurFrame()
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBaseleft,{style = style,frame = frame},
    0.75,true,false,false,function()end)
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBaseright,{style = enemyData.style,frame = enemyData.frame},
    0.75,true,false,false,function()end)
    self.go_table.aortext_leftName.text = leftData and leftData.name or PlayerModelIns:GetName()
    self.go_table.aortext_rightName.text = enemyData.name
    self.go_table.aorbtn_share:SetActiveE(self.isChat == 1 and 0 or 1)
end

---阵容详情
function GroupBattlePanelView:InitDetail()
    self.battle1 = _G.GetAutoGoTable(self.go_table.obj_Battle1,_G.handlerbind(self, self.EnterRecordFight,1))
    self.battle2 = _G.GetAutoGoTable(self.go_table.obj_Battle2,_G.handlerbind(self, self.EnterRecordFight,2))
    self.battle3 = _G.GetAutoGoTable(self.go_table.obj_Battle3,_G.handlerbind(self, self.EnterRecordFight,3))
    local card_cfg = _G.ConfigManager.card_cfg
    local CardData = _G.CardData
    local insert = _G.table.insert
    self.attacker = {}
    self.defenceder = {}
    for i =1,#self.winnertable do
        self.attacker[i] = {}
        self.defenceder[i] = {}
        local win = self.winnertable[i] == 0
        self["battle"..i].aorimage_leftWin.SpriteName = Sprites[win and 0 or 1]
        self["battle"..i].aorimage_rightWin.SpriteName = Sprites[win and 1 or 0]
        local attackData = self.fight_arg.attacker_team[i].fights
        local defenceData = self.fight_arg.defender_team[i].fights
        for _,cardData in pairs(attackData) do
            if not cardData.lv then
                cardData.lv = -1
                cardData.star = -1
            end
            local card = CardData.New()
            card.cfg = card_cfg[cardData.sid]
            card.sid = cardData.sid
            card.lv = cardData.lv
            card.star = cardData.star == -1 and card.cfg.Star or cardData.star
            card.Icon = card.cfg.Icon
            insert(self.attacker[i],card)
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                self["battle"..i].obj_leftContent,
                _G.handlerbind(self, self.showItemHeadInfo, card)
            )
        end
        for _,cardData in pairs(defenceData) do
            if not cardData.lv then
                cardData.lv = -1
                cardData.star = -1
            end
            local card = CardData.New()
            card.cfg = card_cfg[cardData.sid]
            card.sid = cardData.sid
            card.lv = cardData.lv
            card.star = cardData.star == -1 and card.cfg.Star or cardData.star
            card.Icon = card.cfg.Icon
            insert(self.defenceder[i],card)
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                self["battle"..i].obj_rightContent,
                _G.handlerbind(self, self.showItemHeadInfo, card)
            )
        end
    end
end

function GroupBattlePanelView:showItemHeadInfo(item, cardData)
    item:ShowCardData(cardData, nil)
    item:ShowLevel(cardData.lv)
    item.gameObject:SetLocalScaleXYZ(0.6)
end

function GroupBattlePanelView:EnterRecordFight(go,isOn,index)
    local win = self.winnertable[index] == 0
    self.index = index
    _G.BattleManager:GetInstance():SetArgData(self.fight_arg)
    _G.BattleManager:GetInstance():EnterRecordFight(index, true, self.bct, win, self.fzsid)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    self:Hide()
end

---战斗界面打开监听
function GroupBattlePanelView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.BattleView.Name then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.GroupBattlePanelView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaReportPanel.Name)
        self:IsShowChat(false)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GroupBattleStartView.Name,
        self.index,
        self.attacker[self.index],
        self.defenceder[self.index],
        self.data,
        self.winnertable[self.index],
        self.enemyData,
        self.fight[self.index],
        self.playback_uid)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleViewClosed, self)
    end
end

---战斗界面关闭监听
function GroupBattlePanelView:OnEmbattleViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.BattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleViewClosed, self)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaReportPanel.Name)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.GroupBattlePanelView.Name)
        self:IsShowChat(true)
    end
end

---界面的销毁函数
function GroupBattlePanelView:OnDestroy()
end

---按钮点击事件在这里派发
function GroupBattlePanelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_share then
        self:ShareReport()
    end
end

---分享战报
function GroupBattlePanelView:ShareReport()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ChooseChannelView.Name,
        function(channelargs, firendIdargs)
            local channel = channelargs
            local firendId = firendIdargs or 0

            ---@type share.c2s_share_save
            local msgfx = {}
            msgfx.type = 3
            msgfx.re_uid = {self.playback_uid}
            msgfx.sys = self.reportType
            local bct
            bct = _G.BattleControllerType.arenaSenior
            require("ChatViewNet"):GetInstance():SaveShareInfo(
                msgfx,
                function(datafx)
                    if datafx.ack == 1 then
                        ---分享卡片
                        local data = {}
                        data.shareType = 2
                        data.myname = _G.PlayerModel:GetInstance().role_name
                        data.myframe = _G.PlayerModel:GetInstance().frame
                        data.mystyle = _G.PlayerModel:GetInstance().role_style
                        data.sys = msgfx.sys
                        if self.enemyData then
                            data.dfname = self.enemyData.name
                            data.dfframe = self.enemyData.frame or self.enemyData.frameID
                            data.dfstyle = self.enemyData.style or self.enemyData.headID
                            data.dfsid = self.enemyData.sid
                        else
                            data.dfname = "分享信息异常"
                            data.dfframe = 100
                            data.dfstyle = 100
                        end
                        data.share_id = datafx.share_id
                        data.winnertable = self.winnertable
                        data.bct = bct
                        local dataStr = _G.Table2Json(data)
                        ---@type chat.c2s_chat dsd
                        local param = {}
                        param.channel = channel
                        param.content = dataStr
                        param.f_uid = firendId
                        param.type = 3
                        param.voice = 0
                        param.share_id = datafx.share_id
                        ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
                        local msg = {}
                        msg.channel = channel
                        msg.n_content = dataStr
                        msg.f_uid = firendId
                        msg.type = 3
                        msg.voice = 0
                        msg.share_id = datafx.share_id
                        msg, _ = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
                        require("ChatViewNet"):GetInstance():SendCHAT(
                            param,
                            _G.handlerbind(self, self.CallSendChat, msg)
                        )
                    end
                end
            )
        end
    )
end
function GroupBattlePanelView:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

---是否从聊天进入
function GroupBattlePanelView:IsShowChat(isShow)
    if self.isChat == 1 then
        if isShow then
            self:Show()
            local chatView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChatView.Name)
            if chatView then
                chatView:Show()
            end
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        else
            self:Hide()
            local chatView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChatView.Name)
            if chatView then
                chatView:Hide()
            end
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, false)
        end
    end
end


return GroupBattlePanelView