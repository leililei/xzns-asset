---@class ArenaFairSettlementView : UIBaseView	中文描述
---@field public go_table ArenaFairSettlementView_GoTable GoTable
local ArenaFairSettlementView = _G.BaseClass("ArenaFairSettlementView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local UIUtils = _G.UIUtils
function ArenaFairSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaFairSettlementView:OnCreate(call, result, enemy)
    self.onCloseCall = call
    self:ShowResult(result.winner == 0)
    self.myWin = result.winner == 0
    self.re_uid = result.re_uid
    self.otherInfo = result.otherInfo or enemy
    self.reportType = result.reportType
    self:ShowPlayerInfo(result, enemy)
end

---界面的销毁函数
function ArenaFairSettlementView:OnDestroy()
    self.onCloseCall = nil
end

---按钮点击事件在这里派发
function ArenaFairSettlementView:OnClickBtn(go)
    if self.onBtnClick then
        return
    end
    self.onBtnClick = true
    if go == self.go_table.aorbtn_bg then
        self:Close()
        if self.onCloseCall then
            self.onCloseCall()
            self.onCloseCall = nil
        end
    elseif go == self.go_table.aorbtn_statistics then
        self:ShowStatisticsView()
    end
end
function ArenaFairSettlementView:ShowResult(win)
    self.go_table.obj_win:SetActiveE(win and 1 or 0)
    self.go_table.obj_lose:SetActiveE(not win and 1 or 0)
    self.go_table.aorrawimage_bg:LoadImage(
        win and "Images/Arena/ui_gpjjc_frame_sldi" or "Images/Arena/ui_gpjjc_frame_sbdi"
    )
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if _G.IsNil(effect) then
            RemoveEffect(effect)
        end
    end
    --TODO:加载特效
    if win then
        LoadEffectByCfg(ui_effect_cfg.BattleVictory, self.go_table.obj_win, loadDone)
    else
        LoadEffectByCfg(ui_effect_cfg.ef_shibai_03, self.go_table.obj_lose, loadDone)
    end
end
function ArenaFairSettlementView:ShowPlayerInfo(result, enemy)
    self:ShowInfo(
        _G.GetAutoGoTable(self.go_table.obj_enemy),
        enemy.name,
        enemy.guild_name,
        result.tar_score or 0,
        result.tar_var_score or 0,
        enemy.style,
        enemy.frame,
        result.winner ~= 0
    )
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    self:ShowInfo(
        _G.GetAutoGoTable(self.go_table.obj_mine),
        PlayerModelIns:GetName(),
        require("SociatyManager"):GetInstance():GetGuildName(),
        result.score or 0,
        result.var_score or 0,
        PlayerModelIns:GetRoleStyle(),
        PlayerModelIns:GetCurFrame(),
        result.winner == 0
    )
end
function ArenaFairSettlementView:ShowInfo(go_table, name, guild, score, change, style, frame, win)
    go_table.aortext_name.text = name
    local str = _G.string.IsNullOrEmpty(guild) and GetLangPackValue(90022500400) or guild
    go_table.aortext_guild.text = GetLangPackValue(90022500401, str)
    go_table.aortext_score.text = _G.tostring(score)
    if win then
        go_table.aortext_change.text = string.format("<color=#5BDF99>+%d</color>", change)
    else
        go_table.aortext_change.text = string.format("<color=#FF5656>-%d</color>", change)
    end
    UIUtils.SetPlayerHeadItemNew(
        go_table.obj_HeadItemBase,
        {style = style, frame = frame},
        0.65,
        true,
        false,
        false,
        function()
        end
    )
end

function ArenaFairSettlementView:ShowStatisticsView()
    local data = _G.BattleManager:GetInstance():GetStatistics()
    if data == nil then
        self.onBtnClick = false
        return
    end
    ----公平竞技场玩家伤害统计始终显示在左边
    if data.AtkUid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
        local item
        for i = 1, #data.FighterInfo do
            item = data.FighterInfo[i].Attacker
            data.FighterInfo[i].Attacker = data.FighterInfo[i].Defender
            data.FighterInfo[i].Defender = item
            item = data.FighterInfo[i].AtkCombineSkills
            data.FighterInfo[i].AtkCombineSkills = data.FighterInfo[i].DefCombineSkills
            data.FighterInfo[i].DefCombineSkills = item
        end
    end
    if data.FighterInfo ~= nil then
        data = data.FighterInfo[1]
    end
    self.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
    for i = 1, #data.Attacker do
        if self.statisticsMax.DmgOut < data.Attacker[i].DmgOut then
            self.statisticsMax.DmgOut = data.Attacker[i].DmgOut
        end

        if self.statisticsMax.DmgIn < data.Attacker[i].DmgIn then
            self.statisticsMax.DmgIn = data.Attacker[i].DmgIn
        end

        if self.statisticsMax.HpRecover < data.Attacker[i].HpRecover then
            self.statisticsMax.HpRecover = data.Attacker[i].HpRecover
        end
        if self.statisticsMax.CreateGuard < data.Attacker[i].CreateGuard then
            self.statisticsMax.CreateGuard = data.Attacker[i].CreateGuard
        end
    end
    for i = 1, #data.Defender do
        if self.statisticsMax.DmgOut < data.Defender[i].DmgOut then
            self.statisticsMax.DmgOut = data.Defender[i].DmgOut
        end

        if self.statisticsMax.DmgIn < data.Defender[i].DmgIn then
            self.statisticsMax.DmgIn = data.Defender[i].DmgIn
        end

        if self.statisticsMax.HpRecover < data.Defender[i].HpRecover then
            self.statisticsMax.HpRecover = data.Defender[i].HpRecover
        end
        if self.statisticsMax.CreateGuard < data.Defender[i].CreateGuard then
            self.statisticsMax.CreateGuard = data.Defender[i].CreateGuard
        end
    end
    self.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
    for i = 1, #data.AtkCombineSkills[1] do
        if self.CombMax.DmgOut < data.AtkCombineSkills[1][i].DmgOut then
            self.CombMax.DmgOut = data.AtkCombineSkills[1][i].DmgOut
        end

        if self.CombMax.CreateGuard < data.AtkCombineSkills[1][i].CreateGuard then
            self.CombMax.CreateGuard = data.AtkCombineSkills[1][i].CreateGuard
        end

        if self.CombMax.HpRecover < data.AtkCombineSkills[1][i].HpRecover then
            self.CombMax.HpRecover = data.AtkCombineSkills[1][i].HpRecover
        end
    end
    for i = 1, #data.DefCombineSkills[1] do
        if self.CombMax.DmgOut < data.DefCombineSkills[1][i].DmgOut then
            self.CombMax.DmgOut = data.DefCombineSkills[1][i].DmgOut
        end

        if self.CombMax.CreateGuard < data.DefCombineSkills[1][i].CreateGuard then
            self.CombMax.CreateGuard = data.DefCombineSkills[1][i].CreateGuard
        end

        if self.CombMax.HpRecover < data.DefCombineSkills[1][i].HpRecover then
            self.CombMax.HpRecover = data.DefCombineSkills[1][i].HpRecover
        end
    end
    self.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
    for j = 1, #data.AtkPetSkills[1] do
        if self.PetMax.DmgOut < data.AtkPetSkills[1][j].DmgOut then
            self.PetMax.DmgOut = data.AtkPetSkills[1][j].DmgOut
        end

        if self.PetMax.CreateGuard < data.AtkPetSkills[1][j].CreateGuard then
            self.PetMax.CreateGuard = data.AtkPetSkills[1][j].CreateGuard
        end

        if self.PetMax.HpRecover < data.AtkPetSkills[1][j].HpRecover then
            self.PetMax.HpRecover = data.AtkPetSkills[1][j].HpRecover
        end
    end
    for j = 1, #data.DefPetSkills[1] do
        if self.PetMax.DmgOut < data.DefPetSkills[1][j].DmgOut then
            self.PetMax.DmgOut = data.DefPetSkills[1][j].DmgOut
        end

        if self.PetMax.CreateGuard < data.DefPetSkills[1][j].CreateGuard then
            self.PetMax.CreateGuard = data.DefPetSkills[1][j].CreateGuard
        end

        if self.PetMax.HpRecover < data.DefPetSkills[1][j].HpRecover then
            self.PetMax.HpRecover = data.DefPetSkills[1][j].HpRecover
        end
    end
    -- end
    local damage = {}
    _G.table.insert(
        damage,
        {statisticsData = data, statisticsMax = self.statisticsMax, CombMax = self.CombMax, PetMax = self.PetMax}
    )
    local result = self.myWin and {0} or {1}
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        damage,
        result,
        function()
            self.onBtnClick = false
        end,
        nil,
        self.otherInfo,
        1,
        nil,
        nil,
        nil,
        self.re_uid,
        self.reportType,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        true
    )
end
return ArenaFairSettlementView
