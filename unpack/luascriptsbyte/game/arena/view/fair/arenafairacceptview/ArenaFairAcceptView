---@class ArenaFairAcceptView : UIBaseView	中文描述
---@field public go_table ArenaFairAcceptView_GoTable GoTable
local ArenaFairAcceptView = _G.BaseClass("ArenaFairAcceptView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local UIUtils = _G.UIUtils
function ArenaFairAcceptView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaFairAcceptView:OnCreate(enemyData, call)
    self.onHandleCall = call
    self.enemyData = enemyData
    self:Show(enemyData, self.go_table.obj_enemy)
    local ArenaManager = require("ArenaManager")
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:RegiestCancleInvitationCall(_G.handler(self, self.OnCancleInvitationCall), self.viewName)
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    self:Show(
        {
            score = self.arenaClass:GetScore(),
            name = PlayerModelIns:GetName(),
            style = PlayerModelIns:GetRoleStyle(),
            frame = PlayerModelIns:GetCurFrame(),
            guild_name = require("SociatyManager"):GetInstance():GetGuildName()
        },
        self.go_table.obj_mine
    )
    self.arenaClass:RegiestReConnectCall(self.viewName, _G.handler(self, self.Close))
    self:InitEffect()
end

---界面的销毁函数
function ArenaFairAcceptView:OnDestroy()
    self.onHandleCall = nil
    self.arenaClass:UnRegiestReConnectCall(self.viewName)
    self.arenaClass:RegiestCancleInvitationCall(nil, self.viewName)
    self.arenaClass = nil
    self.enemyData = nil
end

---按钮点击事件在这里派发
function ArenaFairAcceptView:OnClickBtn(go)
    if self.onClickTag then
        return
    end
    self.onclickTag = true
    if go == self.go_table.aorbtn_cancle then --拒绝邀请
        if self.onHandleCall then
            self.onHandleCall(false)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_sure then --确定接受邀请
        --TODO:监听对方的操作结果
        self.go_table.obj_tips:SetActiveE(1)
        self.go_table.obj_accept:SetActiveE(0)
        if self.onHandleCall then
            self.arenaClass:RegiestMatchSuccessCall(_G.handler(self, self.ShowEnterView))
            self.onHandleCall(true, _G.handler(self, self.OnAcceptHandleCall))
            self.onHandleCall = nil
        end
    end
end

function ArenaFairAcceptView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if self:IsNil() then
            RemoveEffect(effect)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptViewtitle, self.go_table.trans_common, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptViewbg, self.go_table.trans_effect, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptView_open, self.go_table.trans_common, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairBattleStartView_once, self.go_table.trans_common, loadDone)
end

function ArenaFairAcceptView:Show(data, obj)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aortext_name.text = data.name
    go_table.aortext_score.text = data.score
    local str = _G.string.IsNullOrEmpty(data.guild_name) and GetLangPackValue(90022500400) or data.guild_name
    go_table.aortext_guild.text = GetLangPackValue(90022500401, str)
    UIUtils.SetPlayerHeadItemNew(go_table.obj_HeadItemBase,data,0.64,true,false,false,function() end)
end

function ArenaFairAcceptView:ShowEnterView()
    if not self.arenaClass then
        return
    end
    self.arenaClass:EnterEmbattle(
        function()
            self:Close()
            local UIManagerIns = _G.UIManager:GetInstance()
            local ui_cfg = _G.ConfigManager.ui_cfg
            UIManagerIns:CloseWindow(ui_cfg.ArenaFairDuelPageView.Name)
            UIManagerIns:CloseWindow(ui_cfg.ArenaFairMainView.Name)
        end
    )
end

function ArenaFairAcceptView:OnAcceptHandleCall(success)
    if not success then
        self.arenaClass:RegiestMatchSuccessCall(nil)
        self:Close()
    end
end
---当对手取消了邀请
function ArenaFairAcceptView:OnCancleInvitationCall()
    self:Close()
end
return ArenaFairAcceptView
