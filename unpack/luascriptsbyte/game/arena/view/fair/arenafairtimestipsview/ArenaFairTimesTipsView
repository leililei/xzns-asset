---@class ArenaFairTimesTipsView : UIBaseView	中文描述
---@field public go_table ArenaFairTimesTipsView_GoTable GoTable
local ArenaFairTimesTipsView = _G.BaseClass("ArenaFairTimesTipsView", _G.UIBaseView)

---界面的入口函数
function ArenaFairTimesTipsView:OnCreate(times)
    local format = _G.string.format
    self.go_table.aortext_times.text =
        format(_G.GetLangPackValue(90026100020), _G.GameUtil.NumberToWordByLanguage(times))
    if times < 3 then --前面两轮上阵2个英雄
        self.go_table.aortext_tips.text = format(_G.GetLangPackValue(90026100038), 2)
    elseif times == 3 then --第三轮上阵1个英雄
        self.go_table.aortext_tips.text = format(_G.GetLangPackValue(90026100038), 1)
    else --第四轮上阵3个合击技能
        self.go_table.aortext_tips.text = _G.GetLangPackValue(90026100039)
    end
    self.showTimer = _G.TimerManager:GetInstance():GetTimer(2, self.Close, self, true)
    self.showTimer:Start()
    --90026100038  请上阵%d名角色
    -- 90026100039  请选择3个合击技
end

---界面的销毁函数
function ArenaFairTimesTipsView:OnDestroy()
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
end

return ArenaFairTimesTipsView
