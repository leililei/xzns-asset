local ArenaFairGetAwardItem = _G.BaseClass("ArenaFairGetAwardItem")
function ArenaFairGetAwardItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end
function ArenaFairGetAwardItem:Dispose()
    self.go_table = nil
end
function ArenaFairGetAwardItem:Show(data)
    self.go_table.aortext_count.text = data.got_award
    data = data.roles
    self.go_table.aortext_name.text = data.name
    local cfg = _G.ConfigManager.player_portrait_cfg[data.style]
    if cfg then
        self.go_table.aorimage_head.SpriteName = cfg.portrait1
    end
    if data.frame and data.frame > 0 then
        cfg = _G.ConfigManager.player_frame_cfg[data.frame]
        if cfg then
            self.go_table.aorrawimage_frame:SetActiveE(1)
            self.go_table.aorrawimage_frame:LoadImage(cfg.frame)
        else
            self.go_table.aorrawimage_frame:SetActiveE(0)
        end
    else
        self.go_table.aorrawimage_frame:SetActiveE(0)
    end
end
---@class ArenaFairGetAwardView : UIBaseView	中文描述
---@field public go_table ArenaFairGetAwardView_GoTable GoTable
local ArenaFairGetAwardView = _G.BaseClass("ArenaFairGetAwardView", _G.UIBaseView)

function ArenaFairGetAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaFairGetAwardView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:GetAwardBoxInfo(_G.handler(self, self.OnAwardInfoCall))
    self:InitEffect()
    self.getAwardAnimator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---界面的销毁函数
function ArenaFairGetAwardView:OnDestroy()
    self.arenaClass = nil
    if self.itemTable then
        for key, value in pairs(self.itemTable) do
            value:Dispose()
        end
        self.itemTable = nil
    end
    self.curAwardMsg = nil
    self.onBtnClick = nil
end

---按钮点击事件在这里派发
function ArenaFairGetAwardView:OnClickBtn(go)
    if self.onBtnClick then
        return
    end
    self.onBtnClick = true
    if go == self.go_table.aorbtn_bg then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        self.arenaClass:GetGuildAwardBox(_G.handler(self, self.OnGetAwardCall))
        self:PlayGetAwardEffect()
    end
end

function ArenaFairGetAwardView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if self:IsNil() then
            RemoveEffect(effect)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFair_touxiang, self.go_table.trans_common, loadDone)
end
function ArenaFairGetAwardView:PlayGetAwardEffect()
    self.getAwardAnimator.enabled = true
    --TODO:播放宝箱抖动动画
    self.getAwardAnimator:Play("a_ArenaFairGetAwardView_get")
    self.curAnimationCall = function()
        self.curAnimationCall = nil
        --TODO:播放特效
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ArenaFairGet_bx_once,
            self.transform,
            function(effect)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(effect)
                end
            end,
            function()
                if self:IsNil() then
                    return
                end
                self.arenaClass:GetAwardBoxInfo(
                    function(msg)
                        self:OnAwardInfoCall(msg)
                        --TODO播放切换动画
                        self.getAwardAnimator:Play("a_ArenaFairGetAwardView_get_open")
                        self.onGetAwardAnimationTimer =
                            _G.TimerManager:GetInstance():GetTimer(0.2, self.ShowDropView, self, true)
                        self.onGetAwardAnimationTimer:Start()
                    end
                )
            end
        )
    end
    self.onGetAwardAnimationTimer = _G.TimerManager:GetInstance():GetTimer(1.2, self.curAnimationCall, self, true)
    self.onGetAwardAnimationTimer:Start()
end
function ArenaFairGetAwardView:OnGetAwardCall(success, msg)
    if self.arenaClass then --断线重连之后，会关闭界面 退出公会
        self.curAwardMsg = msg
        self:ShowDropView()
    end
end
function ArenaFairGetAwardView:ShowDropView()
    if not self.showDropTag then
        self.showDropTag = true
        return
    end
    self.onGetAwardAnimationTimer = nil
    --TODO:弹出奖励tips
    if self.curAwardMsg then
        require("CommonTipManager"):GetInstance():OpenDropTip(self.curAwardMsg)
    end
    self.showDropTag = nil
    self.onBtnClick = false
end
function ArenaFairGetAwardView:OnAwardInfoCall(msg)
    if msg.ack == 1 then
        if msg.award_info then
            local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
            for i = 1, #msg.award_info do
                if msg.award_info[i].roles.uid == uid then --已经领取了
                    self:ShowList(msg, msg.award_info[i].got_award)
                    return
                end
            end
        end
        if msg.award_times > 0 then --还有可领取的数量
            self:ShowGet(msg)
        else --领完了
            self:ShowList(msg, 0)
        end
    end
end
function ArenaFairGetAwardView:ShowGet(data)
    self.go_table.obj_get:SetActiveE(1)
    self.go_table.obj_award:SetActiveE(0)
    self.go_table.aortext_count.text = data.award
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    local cfg = _G.ConfigManager.player_portrait_cfg[PlayerModelIns:GetRoleStyle()]
    if cfg then
        self.go_table.aorimage_head.SpriteName = cfg.portrait1
    end
    local frame = PlayerModelIns:GetCurFrame()
    if frame and frame > 0 then
        cfg = _G.ConfigManager.player_frame_cfg[frame]
        if cfg then
            self.go_table.aorrawimage_frame:SetActiveE(1)
            self.go_table.aorrawimage_frame:LoadImage(cfg.frame)
        else
            self.go_table.aorrawimage_frame:SetActiveE(0)
        end
    else
        self.go_table.aorrawimage_frame:SetActiveE(0)
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ArenaFair_baoxiang_loop,
        self.go_table.aorbtn_get,
        function(effect)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
end
function ArenaFairGetAwardView:ShowList(data, count)
    self.go_table.obj_get:SetActiveE(0)
    self.go_table.obj_award:SetActiveE(1)
    self.go_table.aortext_getCount.text = count > 0 and count or _G.GetLangPackValue(90026100015)
    self.awardList = data.award_info
    self.itemTable = {}
    self.go_table.scrollloopvectical_award:InitItemData(#self.awardList, _G.handler(self, self.OnItemCall))
end
function ArenaFairGetAwardView:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemTable[id]
    if not item then
        item = ArenaFairGetAwardItem.New(obj)
        self.itemTable[id] = item
    end
    item:Show(self.awardList[index + 1])
end
return ArenaFairGetAwardView
