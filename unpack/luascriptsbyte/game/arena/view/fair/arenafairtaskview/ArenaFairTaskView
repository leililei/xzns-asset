---@class ArenaFairTaskView : UIBaseView	中文描述
---@field public go_table ArenaFairTaskView_GoTable GoTable
---@field taskList ArenaFairTaskView._obj_task_GoTable[]
---@field taskData HellGuardTaskData[]
---@field taskDatas HellGuardTaskData[]
local ArenaFairTaskView = _G.BaseClass("ArenaFairTaskView", _G.UIBaseView)
local ArenaManager = require "ArenaManager"
--_G.ArenaFairTaskView = ArenaFairTaskView
local TaskType = {
    Daily = 1,
    Main = 2
}
function ArenaFairTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaFairTaskView:OnCreate()
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.taskList = {}
    self.taskDatas = self.arenaClass:GetTaskDatas()
    self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTask))
    self.go_table.toggle_daily.isOn = true
end

function ArenaFairTaskView:SortTask()
    self.arenaClass:SortTask()
end
function ArenaFairTaskView:FreshView()
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.taskDatas = self.arenaClass:GetTaskDatas()
    self.taskData = self.taskDatas[self.type]
    self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskData)
    self:ShowGetAllBtn()
end
function ArenaFairTaskView:ChangeType(type)
    if self.type ~= type then
        self.type = type
        self.taskData = self.taskDatas[self.type]
        self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskData)
        self:ShowGetAllBtn()
    end
end

function ArenaFairTaskView:ShowGetAllBtn()
    local isHave = false
    for _, v in pairs(self.taskData) do
        if self:CheckIsCanTake(v.sid) then
            isHave = true
            break
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_getAll, isHave)
end

---刷新奖励
function ArenaFairTaskView:RefreshTask(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, tb))
        self.taskList[id] = tb
        tb.awardList = {}
        tb.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAward, tb))
    end
    ---@type HellGuardTaskData
    local data = self.taskData[index + 1]
    tb.index = index + 1
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(data.Cfg.desc)
    if data.state == _G.TaskEnum.ETaskState.Claimed then
        tb.slider_progress.value = data.curValue / data.Cfg.count
        tb.aortext_Slider.text = data.curValue .. "/" .. data.Cfg.count
    elseif self:CheckIsCanTake(data.sid) or self:CheckIsFinish(data.sid) then
        tb.slider_progress.value = 1
        tb.aortext_Slider.text = data.Cfg.count .. "/" .. data.Cfg.count
    else
        tb.slider_progress.value = data.curValue / data.Cfg.count
        tb.aortext_Slider.text = data.curValue .. "/" .. data.Cfg.count
    end
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, self:CheckIsCanTake(data.sid))
    _G.GameUtil.SetActiveByCondition(tb.obj_unGet, data.state == _G.TaskEnum.ETaskState.Claimed)
    _G.GameUtil.SetActiveByCondition(tb.obj_complete, self:CheckIsFinish(data.sid))
    local count = #data.reward
    tb.scrollloophorizontal_awardList:UpdateScrollRectWeight(count <= 1 and 94 or 168)
    tb.scrollloophorizontal_awardList:UpdateCount(count)
    if not tb.ani then
        tb.ani = tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    if not self.isinited then
        tb.gameObject:SetActiveE(0)
        tb.timer = _G.TimerManager:GetInstance():GetTimer(index * 2, self.ShowTaskObj, self, true, true, true, tb)
        tb.timer:Start()
    else
        tb.ani.enabled = false
    end
end
function ArenaFairTaskView:CheckIsCanTake(sid)
    return self.arenaClass:CheckIsCanTake(sid)
end
function ArenaFairTaskView:CheckIsFinish(sid)
    return self.arenaClass:CheckIsFinish(sid)
end
function ArenaFairTaskView:ShowTaskObj(tb)
    if tb then
        tb.timer:Stop()
        tb.timer = nil
    end
    tb.gameObject:SetActiveE(1)
end
---显示奖励
---@param tb  ArenaFairTaskView._obj_task_GoTable
function ArenaFairTaskView:RefreshAward(index, obj, tb)
    local id = obj:GetInstanceIDE()
    ---@type BaseAwardNewItem
    local item = tb.awardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 74)
        tb.awardList[id] = item
    end
    local taskData = self.taskData[tb.index]
    local awardData = taskData.reward[index + 1]
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
    item:Show(data)
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_gou, self:CheckIsFinish(taskData.sid))
end

---点击领取奖励
---@param tb ArenaFairTaskView._obj_task_GoTable
function ArenaFairTaskView:OnClickTask(_, _, tb)
    local taskData = self.taskData[tb.index]
    self.arenaClass:FinishTask(
        {taskData.sid},
        function(data)
            self:SortTask()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
            self:ShowGetAllBtn()
        end
    )
end
---获取所有奖励
function ArenaFairTaskView:GetAll()
    local tb = {}
    for _, v in pairs(self.taskData) do
        if self:CheckIsCanTake(v.sid) then
            _G.table.insert(tb, v.sid)
        end
    end
    if _G.table.isEmptyOrNil(tb) then
        return
    end
    self.arenaClass:FinishTask(
        tb,
        function(data)
            self:SortTask()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
            self:ShowGetAllBtn()
        end
    )
end

---按钮点击事件在这里派发
function ArenaFairTaskView:OnClickBtn(go, isOn)
    if self.isinited == nil then
        self.isinited = false
    elseif self.isinited == false then
        self.isinited = true
    end

    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_daily then
        _G.GameUtil.SetActiveByCondition(self.go_table.toggle_daily:GetChildE(2), isOn)
        if isOn then
            self:ChangeType(TaskType.Daily)
        end
    elseif go == self.go_table.toggle_main then
        _G.GameUtil.SetActiveByCondition(self.go_table.toggle_main:GetChildE(2), isOn)
        if isOn then
            self:ChangeType(TaskType.Main)
        end
    elseif go == self.go_table.aorbtn_getAll then
        self:GetAll()
    end
end

function ArenaFairTaskView:RefreshAward2(index, obj, tb)
    local instanceID = obj:GetInstanceIDE()
    local item = tb.awardList[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 73)
        tb.awardList[instanceID] = item
    end
    item:ShowWithID(tb.Cfg.rewards[index + 1])
end

function ArenaFairTaskView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            item.gameObject:SetActiveE(1)
        end
    end
end

return ArenaFairTaskView
