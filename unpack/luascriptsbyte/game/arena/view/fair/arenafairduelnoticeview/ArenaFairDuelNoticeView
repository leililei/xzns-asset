local ArenaFairDuelNoticeItem = _G.BaseClass("ArenaFairDuelNoticeView")
local UIUtils = _G.UIUtils
function ArenaFairDuelNoticeItem:__init(obj, click)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.onHandleCall = click
end
function ArenaFairDuelNoticeItem:Dispose()
    self.go_table = nil
end
function ArenaFairDuelNoticeItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_cancle then
        --TODO:拒绝切磋
        self.onHandleCall(self.index, false)
    elseif go == self.go_table.aorbtn_sure then
        --TODO:接受切磋
        self.onHandleCall(self.index, true)
    end
end

function ArenaFairDuelNoticeItem:Show(data, index)
    self.go_table.aortext_score.text = data.score
    self.index = index
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_time.text = _G.TimeUtil.TranslateTime(data.time)
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,data,1,true,true)
    self.go_table.aortext_name:SetLocalPosition(-360, -27, 0)
end

---@class ArenaFairDuelNotiveView : UIBaseView	中文描述
---@field public go_table ArenaFairDuelNotiveView_GoTable GoTable
local ArenaFairDuelNoticeView = _G.BaseClass("ArenaFairDuelNoticeView", _G.UIBaseView)

function ArenaFairDuelNoticeView:Awake()
end

---界面的入口函数
function ArenaFairDuelNoticeView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:RegiestCancleInvitationCall(_G.handler(self, self.OnNoticeCancle), self.viewName)
    self.arenaClass:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
end
function ArenaFairDuelNoticeView:OnEnable()
    self:InitView()
end
---界面的销毁函数
function ArenaFairDuelNoticeView:OnDestroy()
    self.noticeList = nil
    if self.itemTable then
        for _, value in pairs(self.itemTable) do
            value:Dispose()
        end
        self.itemTable = nil
    end
    self.arenaClass:RegiestCancleInvitationCall(nil, self.viewName)
    self.arenaClass:UnRegiestReConnectCall(self.viewName)
    self.arenaClass = nil
end

function ArenaFairDuelNoticeView:InitView()
    self.noticeList = self.arenaClass:GetDuelNoticeView()
    if self.noticeList and #self.noticeList > 0 then
        self.go_table.obj_empty:SetActiveE(0)
        self.go_table.scrollloopvectical_list:SetActiveE(1)
        self.itemTable = {}
        self.handleInvitationHandler = _G.handler(self, self.OnItemClickCall)
        self.go_table.scrollloopvectical_list:InitItemData(#self.noticeList, _G.handler(self, self.OnItemCall))
    else
        self.go_table.obj_empty:SetActiveE(1)
        self.go_table.scrollloopvectical_list:SetActiveE(0)
    end
end

function ArenaFairDuelNoticeView:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemTable[id]
    if not item then
        item = ArenaFairDuelNoticeItem.New(obj, self.handleInvitationHandler)
        self.itemTable[id] = item
    end
    index = index + 1
    item:Show(self.noticeList[index], index)
end

function ArenaFairDuelNoticeView:OnItemClickCall(index, accept)
    self.curChooseIndex = index
    if accept then --接受邀请
        --TODO:打开确认界面
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaFairAcceptView.Name,
            self.noticeList[index],
            _G.handler(self, self.OnAcceptViewCall)
        )
    else --拒绝邀请
        --TODO:清除消息
        self.arenaClass:HandletInvitationDeul(
            self.noticeList[index].uid,
            false,
            _G.handler(self, self.OnHandleInvitationCall)
        )
    end
end
function ArenaFairDuelNoticeView:OnHandleInvitationCall(msg)
    self:RemoveNoticeList(self.curChooseIndex)
    self.curChooseIndex = 0
end
function ArenaFairDuelNoticeView:OnAcceptViewCall(accept, call)
    if not accept then
        --TODO:发送接收邀请的消息
        self.arenaClass:HandletInvitationDeul(
            self.noticeList[self.curChooseIndex].uid,
            false,
            _G.handler(self, self.OnHandleInvitationCall)
        )
    else
        --TODO:发送接收邀请的消息
        self.arenaClass:HandletInvitationDeul(
            self.noticeList[self.curChooseIndex].uid,
            true,
            function(msg)
                if msg.ack == 1 then
                    self.arenaClass:RegiestJusticePrepareDuleCall(_G.handler(self, self.OnEnemyPrepareDuleCall))
                    call(true)
                else
                    call(false)
                end
                self:RemoveNoticeList(self.curChooseIndex)
            end
        )
    end
end
function ArenaFairDuelNoticeView:OnEnemyPrepareDuleCall(accept)
    if not accept then --己方已经确认，但对方拒绝了
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaFairAcceptView.Name)
    end
    if self.arenaClass then
        self.arenaClass:RegiestJusticePrepareDuleCall(nil)
    end
end
function ArenaFairDuelNoticeView:RemoveNoticeList(index)
    _G.table.remove(self.noticeList, index)
    if #self.noticeList > 0 then
        self.go_table.scrollloopvectical_list:UpdateCount(#self.noticeList)
    else
        self.go_table.obj_empty:SetActiveE(1)
        self.go_table.scrollloopvectical_list:SetActiveE(0)
    end
end
function ArenaFairDuelNoticeView:OnNoticeCancle(uid)
    if not self.noticeList then
        return
    end
    if #self.noticeList > 0 then
        self.go_table.scrollloopvectical_list:UpdateCount(#self.noticeList)
    else
        self.go_table.obj_empty:SetActiveE(1)
        self.go_table.scrollloopvectical_list:SetActiveE(0)
    end
end
function ArenaFairDuelNoticeView:OnReConnectCall(enter)
    if enter then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaFairDuelPageView.Name)
    end
end

---@private
function ArenaFairDuelNoticeView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArenaFairDuelPageView.Name)
    if view then
        view:DoClose()
    end
end

return ArenaFairDuelNoticeView
