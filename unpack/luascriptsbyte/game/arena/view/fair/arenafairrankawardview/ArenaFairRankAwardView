local ArenaFairRankAwardItem = _G.BaseClass("ArenaFairRankAwardItem")
function ArenaFairRankAwardItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end
function ArenaFairRankAwardItem:Dispose()
    self.go_table = nil
    self.itemList = nil
end
function ArenaFairRankAwardItem:Show(id)
    local cfg = _G.ConfigManager.arena_rank_cfg[id]
    if cfg.min_rank == cfg.max_rank then
        self.go_table.aortext_rank.text = tostring(cfg.min_rank)
    else
        self.go_table.aortext_rank.text = string.format("%d-%d", cfg.min_rank, cfg.max_rank)
    end
    self.itemList = {}
    self:ShowAward(cfg.reward_daily)
end
---显示奖励
function ArenaFairRankAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_Root,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
---@class ArenaFairRankAwardView : UIBaseView	中文描述
---@field public go_table ArenaFairRankAwardView_GoTable GoTable
local ArenaFairRankAwardView = _G.BaseClass("ArenaFairRankAwardView", _G.UIBaseView)

function ArenaFairRankAwardView:Awake()
end

---界面的入口函数
function ArenaFairRankAwardView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.awardList = _G.DeepCopyCfgTable(_G.ConfigManager.arena_info_cfg[ArenaManager.arenaType.fair].rank)
    self.itemTable = {}
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.awardList, _G.handler(self, self.OnItemCall))
    self:ShowGuild()
end

---界面的销毁函数
function ArenaFairRankAwardView:OnDestroy()
    self.arenaClass = nil
    self.awardList = nil
    for _, value in pairs(self.itemTable) do
        value:Dispose()
    end
    self.itemTable = nil
    self.itemList = nil
end

function ArenaFairRankAwardView:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemTable[id]
    if not item then
        item = ArenaFairRankAwardItem.New(obj)
        self.itemTable[id] = item
    end
    item:Show(self.awardList[index + 1])
end

function ArenaFairRankAwardView:ShowGuild()
    local data, index = self.arenaClass:GetGuildRankPlayer()
    if data then
        self.go_table.obj_player:SetActiveE(1)
        self.go_table.obj_empty:SetActiveE(0)
        data = data.role_info
        self.go_table.aortext_name.text = data.name
        local cfg = _G.ConfigManager.player_portrait_cfg[data.style]
        if cfg then
            self.go_table.aorimage_head.SpriteName = cfg.portrait1
        end
        cfg = _G.ConfigManager.player_frame_cfg[data.frame]
        if cfg then
            self.go_table.aorrawimage_frame:SetActiveE(1)
            self.go_table.aorrawimage_frame:LoadImage(cfg.frame)
        end
        local icon = _G.SystemSettingManager.GetTitleIcon(data.title)
        if icon then
            self.go_table.aorrawimage_title:SetActiveE(1)
            self.go_table.aorrawimage_title:LoadImage(
                icon,
                function(rawimage)
                    rawimage:SetNativeSize()
                end
            )
        end
        local cfgs = _G.ConfigManager.arena_rank_cfg
        for i = 1, #self.awardList do
            cfg = cfgs[self.awardList[i]]
            if index <= cfg.max_rank and index >= cfg.min_rank then
                ---显示奖励
                local award = cfg.reward_daily
                local ItemFactory = _G.ItemFactory
                if self.itemList then
                    for i = 1, #self.itemList do
                        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
                    end
                end
                self.itemList = {}
                local insert = _G.table.insert
                for i = 1, #award do
                    ItemFactory:GetInstance():GetItemCard(
                        ItemFactory.itemType.ItemBaseWithCount,
                        self.go_table.trans_Root,
                        function(item)
                            item:Show(award[i][1], nil, award[i][2])
                            insert(self.itemList, item)
                        end
                    )
                end
                break
            end
        end
    else
        self.go_table.obj_player:SetActiveE(0)
        self.go_table.obj_empty:SetActiveE(1)
    end
end

return ArenaFairRankAwardView
