--region 排行榜item
local ArenaFairRankItem = _G.BaseClass("ArenaFairRankItem")
local rankImageName = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}
local rankBgName = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04"
}
local UIUtils = _G.UIUtils
local function NONE()
end

function ArenaFairRankItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end
function ArenaFairRankItem:Dispose()
    self.go_table = nil
    self.uid = nil
end
function ArenaFairRankItem:Show(data, index, my)
    self.go_table.aortext_score.text = data.score
    self.go_table.aortext_num.text = data.win_times
    self.go_table.aortext_percent.text = string.format("/%d%%", data.win_per)
    data = data.role_info
    self.go_table.aortext_name.text = data.name
    self.uid = data.uid
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data, 0.8, true, true, true, NONE)
    if my or index > 3 then
        if index == 0 then
            self.go_table.aortext_mNumber.text = _G.GetLangPackValue(90022900040)
        else
            self.go_table.aortext_mNumber.text = index
        end
        if not my then
            self.go_table.aortext_mNumber:SetActiveE(1)
            self.go_table.aorimage_rank:SetActiveE(0)
        end
    else
        self.go_table.aortext_mNumber:SetActiveE(0)
        self.go_table.aorimage_rank:SetActiveE(1)
        self.go_table.aorimage_rank.SpriteName = rankImageName[index]
        self.go_table.aorimage_rank:SetNativeSize()
        self.go_table.aorimage_bg.SpriteName = rankBgName[index]
    end
    self.go_table.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
end
function ArenaFairRankItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_info then
        --TODO:查看玩家信息界面
        _G.SystemSettingManager:GetInstance():OpenView(self.uid)
    end
end
--endregion
---@class ArenaFairRankView : UIBaseView	中文描述
---@field public go_table ArenaFairRankView_GoTable GoTable
local ArenaFairRankView = _G.BaseClass("ArenaFairRankView", _G.UIBaseView)

function ArenaFairRankView:Awake()
end

---界面的入口函数
function ArenaFairRankView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:GetRankInfo(0, 0, _G.handler(self, self.OnRankListCall))
    self.myRankItem = ArenaFairRankItem.New(self.go_table.obj_myItem)
end

---界面的销毁函数
function ArenaFairRankView:OnDestroy()
    self.myRankItem:Dispose()
    self.myRankItem = nil
    if self.rankItemTab then
        for _, value in pairs(self.rankItemTab) do
            value:Dispose()
        end
        self.rankItemTab = nil
    end
    self.arenaClass = nil
end

function ArenaFairRankView:OnRankListCall(msg)
    if msg then
        self.rankDataList = msg
        self.rankItemTab = {}
        self.go_table.scrollloopvectical_award:InitItemData(#msg, _G.handler(self, self.OnRankObjCall))
    end
    local num, per = self.arenaClass:GetWinNum()
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    self.myRankItem:Show(
        {
            win_per = per,
            win_times = num,
            score = self.arenaClass:GetScore(),
            role_info = {
                name = PlayerModelIns:GetName(),
                style = PlayerModelIns:GetRoleStyle(),
                frame = PlayerModelIns:GetCurFrame(),
                level = PlayerModelIns:GetLevel(),
                title = PlayerModelIns:GetTitle(),
                power = PlayerModelIns:GetPower()
            }
        },
        self.arenaClass:GetMyRankIndex(),
        true
    )
end
function ArenaFairRankView:OnRankObjCall(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local item = self.rankItemTab[id]
    if not item then
        item = ArenaFairRankItem.New(obj)
        self.rankItemTab[id] = item
    end
    index = index + 1
    item:Show(self.rankDataList[index], index)
end

---@private
function ArenaFairRankView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArenaFairRankPageView.Name)
    if view then
        view:DoClose()
    end
end

return ArenaFairRankView
