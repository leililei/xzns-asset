---@class ArenaFairCombineView : UIBaseView	中文描述
---@field public go_table ArenaFairCombineView_GoTable GoTable
local ArenaFairCombineView = _G.BaseClass("ArenaFairCombineView", _G.UIBaseView)

function ArenaFairCombineView:Awake()
end

---界面的入口函数
function ArenaFairCombineView:OnCreate(data)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineClosed, self)
    self.embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
    self.combineView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name)
    if not self.combineView then
        self:Close()
        return
    end
    --TODO:监听装备合击技
    self.combineView:AddListenerCombineEnter(_G.handler(self, self.OnCombineSkillEquip))
    self.combineView:AddListenerIsEquipSkill(_G.handler(self, self.OnCheckEquipSkill))
    --self.combineView:AddListenerCloseCall(_G.handler(self, self.OnCloseBtnClick))
    self.equipSkillIndex = {false, false, false}
    for i = 1, #data do
        if data[i].id > 0 then
            self.equipSkillIndex[i] = true
        end
    end
    self:UpdateContent()
end

---界面的销毁函数
function ArenaFairCombineView:OnDestroy()
    self.embattleItem = nil
    self.combineView = nil
    self.equipSkillIndex = nil
end
function ArenaFairCombineView:OnCombineSkillEquip(index)
    if not self.equipSkillIndex then
        self.equipSkillIndex = {false, false, false}
    end
    self.equipSkillIndex[index] = true
    local change
    for i = 1, #self.equipSkillIndex do
        if not self.equipSkillIndex[i] then
            change = true
            --TODO:切换对应页签
            self.combineView:ChangeCurCombineType(i)
            break
        end
    end
    if not change then
        self.go_table.obj_shadow:SetActiveE(1)
        self.embattleItem:SaveEmbattleFair(
            function(msg)
                if msg.ack ~= 1 then
                    self.go_table.obj_shadow:SetActiveE(0)
                else
                    self.combineView:AddListenerCloseCall(nil)
                    --TODO:3个合击技都确定完 则关闭合击技能界面
                    self.combineView:OnClickBtn(self.combineView.go_table.aorbtn_close)
                end
            end
        )
    end
    self:UpdateContent()
end
function ArenaFairCombineView:UpdateContent()
    self.equipCount = 0
    for i = 1, #self.equipSkillIndex do
        if self.equipSkillIndex[i] then
            self.equipCount = self.equipCount + 1
        end
    end
    self.go_table.aortext_tips.text =
        string.format(_G.GetLangPackValue(90026100022), self.equipCount, #self.equipSkillIndex)
end
function ArenaFairCombineView:OnCombineClosed(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineClosed, self)
        self:Close()
    end
end
