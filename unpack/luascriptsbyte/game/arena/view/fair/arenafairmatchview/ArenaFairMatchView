---@class ArenaFairMatchView : UIBaseView	中文描述
---@field public go_table ArenaFairMatchView_GoTable GoTable
local ArenaFairMatchView = _G.BaseClass("ArenaFairMatchView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local UIUtils = _G.UIUtils
function ArenaFairMatchView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaFairMatchView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.headTable = _G.GetAutoGoTable(self.go_table.obj_HeadItemBase)
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    --TODO:防止匹配就直接成功 因此监听在匹配之前
    self.arenaClass:RegiestMatchSuccessCall(_G.handler(self, self.ShowSuccessView))
    self.arenaClass:Match(true, _G.handler(self, self.OnMatchCall))
    self.arenaClass:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
    self.animator = self.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.animator:Play("a_ArenaFairMatchView_open")
    self.playAnimationTimer = _G.TimerManager:GetInstance():GetTimer(0.5, self.OnOpenAnimationDone, self, true)
    self.playAnimationTimer:Start()
end

---界面的销毁函数
function ArenaFairMatchView:OnDestroy()
    if self.playAnimationTimer then
        self.playAnimationTimer:Stop()
        self.playAnimationTimer = nil
    end
    self:CloseMatchViewTimer()
    self.arenaClass:RegiestMatchSuccessCall(nil)
    self.arenaClass:UnRegiestReConnectCall(self.viewName)
    self.arenaClass = nil
end

---按钮点击事件在这里派发
function ArenaFairMatchView:OnClickBtn(go)
    if go == self.go_table.aorbtn_cancle then
        if self.onEnterBattleTag then
            return
        end
        --TODO:取消匹配，关闭界面
        self.arenaClass:Match(false, _G.handler(self, self.OnCancleCall))
    end
end
--region 动画
function ArenaFairMatchView:OnOpenAnimationDone()
    self.playAnimationTimer = nil
    self.animator:Play("a_ArenaFairMatchView_pipei_loop")
end
function ArenaFairMatchView:PlayMatchSuccessAnimation()
    if self.playAnimationTimer then
        self.playAnimationTimer:Stop()
        self.playAnimationTimer = nil
    end
    self.animator:Play("a_ArenaFairMatchView_pipei_once")
end
--endregion
function ArenaFairMatchView:OnMatchCall(suc)
    if suc then
        self:ShowMatchView()
    else
        self:Close()
    end
end
---展示匹配界面
function ArenaFairMatchView:ShowMatchView()
    self.go_table.obj_match:SetActiveE(1)
    self.go_table.obj_success:SetActiveE(0)
    self.go_table.obj_HeadItemBase:SetActiveE(0)
    self.go_table.trans_common:SetLocalPositionToZero()
    self.matchTime = 0
    self:OnMatchTimeCall()
    local TimerManagerIns = _G.TimerManager:GetInstance()
    --TODO:开启匹配计时器
    self.matchTimer = TimerManagerIns:GetTimer(1, self.OnMatchTimeCall, self)
    self.matchTimer:Start()
    --TODO:开启头像轮动计时器
    --table<player_portrait_cfg>
    self.headIconList = _G.SystemSettingManager:GetInstance():GetUnLockIconData()
    -- if _G.table.isEmptyOrNil(self.headIconList)
    self.headIconIndex = 0
    self.showHeadTimer = TimerManagerIns:GetTimer(0.15, self.ShowCardHeadIcon, self)
    self.showHeadTimer:Start()
end
---展示匹配成功界面
function ArenaFairMatchView:ShowSuccessView(data)
    self:PlayMatchSuccessAnimation()
    UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ArenaFairMatch_Highlight,
        self.transform,
        function(effect)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
    self.onEnterBattleTag = true
    self:CloseMatchViewTimer()
    --TODO:展示匹配玩家的信息
    self.go_table.aortext_name.text = data.roles.name
    self.go_table.aortext_guild.text =
        _G.string.IsNullOrEmpty(data.roles.guild_name) and GetLangPackValue(90022500400) or data.roles.guild_name
    self.go_table.aortext_score.text = data.tar_score
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data.roles, 0.8, true)
    self.go_table.obj_HeadItemBase:SetActiveE(1)
    self.enterTime = 6
    self:OnEnterTimerCall()
    self.enterTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnEnterTimerCall, self)
    self.enterTimer:Start()
end
---展示头像
function ArenaFairMatchView:ShowCardHeadIcon()
    --TODO:获取玩家已激活得头像
    self.go_table.obj_HeadItemBase:SetActiveE(1)
    self.headIconIndex = self.headIconIndex + 1
    if self.headIconIndex > #self.headIconList then
        self.headIconIndex = 1
    end
    local cfg = self.headIconList[self.headIconIndex]
    if cfg then
        self.headTable.aorimage_portrait.SpriteName = cfg.portrait1
    end
end

function ArenaFairMatchView:OnCancleCall(suc)
    if suc then
        self:Close()
    end
end

function ArenaFairMatchView:OnMatchTimeCall(elapsed)
    if not elapsed then
        elapsed = 1
    end
    self.matchTime = self.matchTime + elapsed
    --_G.GetLangPackValue(90026100006)
    self.go_table.aortext_time.text = GetLangPackValue(90026100006, ("..." .. math.floor(self.matchTime)))
end
function ArenaFairMatchView:CloseMatchViewTimer()
    if self.matchTimer then
        self.matchTimer:Stop()
        self.matchTimer = nil
    end
    if self.showHeadTimer then
        self.showHeadTimer:Stop()
        self.showHeadTimer = nil
    end
end
function ArenaFairMatchView:OnEnterTimerCall(elapsed)
    if not elapsed then
        elapsed = 1
    end
    self.enterTime = self.enterTime - elapsed
    if self.enterTime <= 0 then
        self.enterTimer:Stop()
        self.enterTimer = nil
        --TODO:进入布阵
        self.arenaClass:EnterEmbattle(_G.handler(self, self.OnEnterEmbattleCall))
    else
        --TODO:展示倒计时
        self.go_table.aortext_enterTime.text = GetLangPackValue(90026100007, Mathf.RoundToInt(self.enterTime))
    end
end
function ArenaFairMatchView:OnEnterEmbattleCall()
    self:Close()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaFairMainView.Name)
end
function ArenaFairMatchView:OnReConnectCall()
    self:Close()
end
return ArenaFairMatchView
