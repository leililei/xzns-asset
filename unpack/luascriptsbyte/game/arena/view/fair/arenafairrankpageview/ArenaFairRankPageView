local ArenaFairRankPageView = _G.BaseClass("ArenaFairRankPageView", _G.UIBaseView)

function ArenaFairRankPageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.chooseObj = {self.go_table.obj_choose1, self.go_table.obj_choose2}
end

---界面的入口函数
function ArenaFairRankPageView:OnCreate(pages, index)
    self.curPages = pages
    self:ShowPage(index or 1)
end

---界面的销毁函数
function ArenaFairRankPageView:OnDestroy()
    self.onBtnClick = nil
    self.curShowPageIndex = nil
    self.curPages = nil
end

