function ArenaFairRankPageView:CheckViewClose(index, call)
    if self.curShowPageIndex and index == self.curShowPageIndex then
        self.onBtnClick = false
        return
    end
    local UIManagerIns = _G.UIManager:GetInstance()
    local view = UIManagerIns:GetWindowCtrl(self.curPages[self.curShowPageIndex])
    if view.CheckCloseView then
        view:CheckCloseView(call)
    else
        call(true)
    end
end
function ArenaFairRankPageView:ShowPage(index)
    self.chooseObj[index]:SetActiveE(1)
    self.chooseObj[#self.chooseObj + 1 - index]:SetActiveE(0)
    local UIManagerIns = _G.UIManager:GetInstance()
    if self.curShowPageIndex and self.curShowPageIndex > 0 then
        UIManagerIns:HideWindow(self.curPages[self.curShowPageIndex])
    end
    self.curShowPageIndex = index
    if UIManagerIns:IsLoadedWindow(self.curPages[index]) then
        UIManagerIns:ShowWindow(self.curPages[index])
        self.onBtnClick = false
    else
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnPageOpenCall, self)
        _G.UIManager:GetInstance():OpenWindow(self.curPages[index])
    end
end

function ArenaFairRankPageView:OnPageOpenCall(name)
    if name == self.curPages[self.curShowPageIndex] then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnPageOpenCall, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        view.transform:SetParentE(self.go_table.trans_panel)
        view.transform:SetLocalScaleToOne()
        self.onBtnClick = false
    end
end

---@private
function ArenaFairRankPageView:DoClose()
    local UIManagerIns = _G.UIManager:GetInstance()
    local view = UIManagerIns:GetWindowCtrl(self.curPages[self.curShowPageIndex])
    if view.CheckCloseView then
        view:CheckCloseView(
                function(close)
                    if close then
                        for i = 1, #self.curPages do
                            UIManagerIns:CloseWindow(self.curPages[i])
                        end
                        self:Close()
                    else
                        self.onBtnClick = false
                    end
                end
        )
    else
        UIManagerIns = _G.UIManager:GetInstance()
        for i = 1, #self.curPages do
            UIManagerIns:CloseWindow(self.curPages[i])
        end
        self:Close()
    end
end

---@private
function ArenaFairRankPageView:EscClose()
	self:DoClose()
end

return ArenaFairRankPageView
