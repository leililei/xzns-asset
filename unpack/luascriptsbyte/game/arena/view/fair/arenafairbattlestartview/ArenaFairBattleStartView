---@class ArenaFairBattleStartView : UIBaseView	中文描述
---@field public go_table ArenaFairBattleStartView_GoTable GoTable
local ArenaFairBattleStartView = _G.BaseClass("ArenaFairBattleStartView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function ArenaFairBattleStartView:Awake()
end

---界面的入口函数
function ArenaFairBattleStartView:OnCreate(call, enemyData)
    local ArenaManager = require("ArenaManager")
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self:ShowEnterView(call)
    self:ShowInfo(enemyData, self.go_table.obj_enemy)
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    self:ShowInfo(
        {
            score = self.arenaClass:GetScore(),
            name = PlayerModelIns:GetName(),
            style = PlayerModelIns:GetRoleStyle(),
            frame = PlayerModelIns:GetCurFrame(),
            guild_name = require("SociatyManager"):GetInstance():GetGuildName()
        },
        self.go_table.obj_mine
    )
    self:InitEffect()
end

---界面的销毁函数
function ArenaFairBattleStartView:OnDestroy()
    self.arenaClass = nil
end

function ArenaFairBattleStartView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if self:IsNil() then
            RemoveEffect(effect)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptViewbg, self.go_table.trans_effect, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptView_open, self.go_table.trans_common, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairBattleStartView_once, self.go_table.trans_common, loadDone)
end

function ArenaFairBattleStartView:ShowInfo(data, obj)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aortext_name.text = data.name
    go_table.aortext_score.text = data.score
    local str = string.IsNullOrEmpty(data.guild_name) and GetLangPackValue(90022500400) or data.guild_name
    go_table.aortext_guild.text = GetLangPackValue(90022500401, str)
    local cfg = _G.ConfigManager.player_portrait_cfg[data.style]
    if cfg then
        go_table.aorimage_head.SpriteName = cfg.portrait1
    end
    if data.frame and data.frame > 0 then
        cfg = _G.ConfigManager.player_frame_cfg[data.frame]
        if cfg then
            go_table.aorrawimage_frame:SetActiveE(1)
            go_table.aorrawimage_frame:LoadImage(cfg.frame)
        end
    end
end

function ArenaFairBattleStartView:ShowEnterView(call)
    self.time = 3
    local imageName = {
        "ui_gpjjc_role_djs1",
        "ui_gpjjc_role_djs2"
    }
    local animator = self.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    animator:Play("ani_ArenaFairBattleStartView")
    self.Timer =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        false,
        false,
        false,
        imageName,
        animator,
        call
    )
    self.Timer:Start()
end

function ArenaFairBattleStartView:TimerFunc(imageName, animator, call, elapsed)
    self.time =  self.time - elapsed
    local timeToInt=Mathf.RoundToInt(self.time)
    if self.time > 0 then
        self.go_table.aorimage_num.SpriteName = imageName[timeToInt]
    elseif timeToInt == 0 then
        animator.enabled = false
        local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
        local RemoveEffect = _G.UIUtils.RemoveEffect
        local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
        local function loadDone(effect)
            if self:IsNil() then
                RemoveEffect(effect)
            end
        end
        LoadEffectByCfg(ui_effect_cfg.ef_ArenaFairAcceptViewtitle, self.go_table.trans_common, loadDone)
        self.go_table.obj_enter:SetActiveE(0)
        self.go_table.obj_v:SetActiveE(1)
        self.go_table.obj_s:SetActiveE(1)
    else
        self.Timer:Stop()
        self.Timer = nil
        self:Close()
        if call then
            call()
        end
    end
end

return ArenaFairBattleStartView
