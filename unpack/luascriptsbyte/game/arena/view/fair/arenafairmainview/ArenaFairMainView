local TrackingPointModel = require("TrackingPointModel")
local ArenaManager = require "ArenaManager"
--region 排行榜前三item
local ArenaFairMainRankItem = _G.BaseClass("ArenaFairMainRankItem")
local GetLangPackValue = _G.GetLangPackValue
local UIUtils = _G.UIUtils
function ArenaFairMainRankItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end
function ArenaFairMainRankItem:Dispose()
    self.go_table = nil
end
--[[
  required role.i_role role_info = 1;//玩家信息
  required uint32 score = 2; //积分
  required uint32 win_per = 3; //胜率
  required uint32 win_times = 4; //胜场次数
]]
function ArenaFairMainRankItem:Show(data)
    if data then
        self.go_table.aortext_score.text = _G.LangUtil.GetLangPackValue(90000010438, data.score)
        data = data.role_info
        self.go_table.aortext_name.text = data.name
        UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,data,0.8,true)
        self.go_table.obj_shadowHead:SetActiveE(0)
    else
        --TODO:没有数据展示
        self.go_table.aortext_name.text = GetLangPackValue(90000010159)
        self.go_table.obj_shadowHead:SetActiveE(1)
        self.go_table.obj_HeadItemBase:SetActiveE(0)
    end
end
function ArenaFairMainRankItem:GetEffectRoot()
    return self.go_table.trans_icon
end
--endregion
---@class ArenaFairMainView : UIBaseView	中文描述
---@field public go_table ArenaFairMainPanelView_GoTable GoTable
local ArenaFairMainView = _G.BaseClass("ArenaFairMainView", _G.UIBaseView)

function ArenaFairMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.rankItemList = {
        ArenaFairMainRankItem.New(self.go_table.obj_rank1),
        ArenaFairMainRankItem.New(self.go_table.obj_rank2),
        ArenaFairMainRankItem.New(self.go_table.obj_rank3)
    }
    self:AddComponent(
        self.go_table.trans_resources,
        require("ResourceCompont").New(
            self.go_table.trans_resources,
            _G.ConfigManager.ui_cfg.ArenaFairMainView.resources
        )
    )
end

---界面的入口函数
function ArenaFairMainView:OnCreate()
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
    local ArenaControllerIns = require("ArenaController"):GetInstance()
    ArenaControllerIns:SetArenaLoginFirstByDay(3)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaFairLogin.id)
    self:InitView()
    self:InitEffect()
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
    
end

---界面的销毁函数
function ArenaFairMainView:OnDestroy()
    self.arenaClass:UnRegiestEndTimeCall(self.viewName)
    self.arenaClass:UnRegiestReConnectCall(self.viewName)
    self.arenaClass = nil
    self.rankItemList = nil
    self.onBtnClick = nil
end

---按钮点击事件在这里派发
function ArenaFairMainView:OnClickBtn(go)
    if self.onBtnClick then
        return
    end
    self.onBtnClick = true
    if go == self.go_table.aorbtn_CloseView then
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_rank then
        if self.arenaClass:GetCurArenaState() ~= ArenaManager.State.open then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        --TODO:打开排行榜界面
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        local ui_cfg = _G.ConfigManager.ui_cfg
        _G.UIManager:GetInstance():OpenWindow(
            ui_cfg.ArenaFairRankPageView.Name,
            {ui_cfg.ArenaFairRankView.Name, ui_cfg.ArenaFairRankAwardView.Name}
        )
    elseif go == self.go_table.aorbtn_report then
        if self.arenaClass:GetCurArenaState() ~= ArenaManager.State.open then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        --TODO:打开战报界面`
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaReportPanel.Name,
            ArenaManager.arenaType.fair
        )
    elseif go == self.go_table.aorbtn_task then
        if self.arenaClass:GetCurArenaState() ~= ArenaManager.State.open then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        --TODO:打开任务界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaFairTaskView.Name)
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_battle then
        if self.arenaClass:GetCurArenaState() ~= ArenaManager.State.open then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        --TODO:打开切磋界面
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        local ui_cfg = _G.ConfigManager.ui_cfg
        _G.UIManager:GetInstance():OpenWindow(
            ui_cfg.ArenaFairDuelPageView.Name,
            {ui_cfg.ArenaFairDuelListView.Name, ui_cfg.ArenaFairDuelNoticeView.Name}
        )
    elseif go == self.go_table.aorbtn_match then
        if self.arenaClass:GetCurArenaState() ~= ArenaManager.State.open then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        --TODO:打开匹配界面
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaFairMatchView.Name)
    elseif go == self.go_table.aorbtn_lb then
        if not self.arenaClass.activity:CheckIsOpen() then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        local id = self.arenaClass.activity:GetGiftId()
        if id and id > 0 then
            _G.GlobalInterface.JumpActivityByGM(10014, self.arenaClass.activity.curActivityClass:GetJumpType()) --Type -- sub--type
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        end
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_dh then
        if not self.arenaClass.activity:CheckIsOpen() then
            self.onBtnClick = false
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
            return
        end
        local id = require "ArenaFairManager":GetInstance():GetExchangeId()
        if id and id > 0 then
            _G.GlobalInterface.JumpActivityByGM(10005, self.arenaClass.activity.curActivityClass:GetJumpType())
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        end
        self.onBtnClick = false
    end
end
function ArenaFairMainView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local function loadDone(effect)
        if self:IsNil() then
            RemoveEffect(effect)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_guiyingraodong, self.go_table.trans_effectBG, loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_guanjun, self.rankItemList[1]:GetEffectRoot(), loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_yajun, self.rankItemList[2]:GetEffectRoot(), loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_jijun, self.rankItemList[3]:GetEffectRoot(), loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_qizhiliuguang01, self.rankItemList[1]:GetEffectRoot(), loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_qizhiliuguang02, self.rankItemList[2]:GetEffectRoot(), loadDone)
    LoadEffectByCfg(ui_effect_cfg.ef_qizhiliuguang03, self.rankItemList[3]:GetEffectRoot(), loadDone)
end
---初始化界面展示
function ArenaFairMainView:InitView()
    self.go_table.aortext_playerScore.text = _G.LangUtil.GetLangPackValue(90000010439, self.arenaClass.score)
    self.arenaClass:GetRankInfo(1, 3, _G.handler(self, self.OnRankCall))
    --self.arenaClass:GetSessionEndTime(_G.handler(self, self.RefreshTimeCall), self.viewName)
    --TODO:如果有邀请 就自动打开邀请界面
    if self.arenaClass:CheckHaveInvitation() then
        self.onBtnClick = true
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        local ui_cfg = _G.ConfigManager.ui_cfg
        _G.UIManager:GetInstance():OpenWindow(
            ui_cfg.ArenaFairDuelPageView.Name,
            {ui_cfg.ArenaFairDuelListView.Name, ui_cfg.ArenaFairDuelNoticeView.Name},
            2
        )
    end
    self:ShowBtnGray(self.arenaClass:GetCurArenaState() == ArenaManager.State.settle)
    local ActivitySynManager = require"ActivitySynManager":GetInstance()
    local GetLangPackValue = _G.GetLangPackValue
    local startTime, _ = self.arenaClass.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local settlementTime, _ = self.arenaClass.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.SettlementTime = _G.TimeUtil.GetDateTime(settlementTime)
    local text1 = GetLangPackValue(90000010300,self.StartTime.month,self.StartTime.day,self.StartTime.hour)
    .."-".. GetLangPackValue(90000010300,self.SettlementTime.month,self.SettlementTime.day,self.SettlementTime.hour)
    self.go_table.aortext_times.text = GetLangPackValue(90025800003,text1)
end
function ArenaFairMainView:ShowBtnGray(gray)
    if self.curMatchBtnGrayTag ~= nil and self.curMatchBtnGrayTag == gray then
        return
    end
    self.curMatchBtnGrayTag = gray
    self.go_table.aorimage_match:SetGray(gray)
    if self.matchBtnEffectTrans then
        _G.GameUtil.SetActiveByCondition(self.matchBtnEffectTrans, not gray)
    elseif not gray then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_anniugaoliang,
            self.go_table.aorimage_match,
            function(effect)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(effect)
                end
            end
        )
    end
end
---解析排行榜前三数据
---@param msg table 排行榜数据
function ArenaFairMainView:OnRankCall(msg)
    msg = msg or {}
    for i = 1, 3 do
        self.rankItemList[i]:Show(msg[i])
    end
end
function ArenaFairMainView:RefreshTimeCall(t)
    if self.arenaClass:GetCurArenaState() == ArenaManager.State.settle then --结算中
        self.go_table.aortext_time.text = GetLangPackValue(90000010091)
        self:ShowBtnGray(true)
    elseif self.arenaClass:GetCurArenaState() == ArenaManager.State.close then
        self.go_table.aortext_time.text = GetLangPackValue(90026100053)
        self:ShowBtnGray(true)
    else
        self.go_table.aortext_time.text = GetLangPackValue(90026100001, _G.TimeUtil.TranslateSecondForStr(t))
        self:ShowBtnGray(false)
        if t <= 0 then
            self.go_table.aortext_time.text = GetLangPackValue(90026100053)
            --TODO:活动时间结束 刷新排行榜前3
            self.arenaClass:GetRankInfo(1, 3, _G.handler(self, self.OnRankCall))
        end
    end
end
function ArenaFairMainView:OnViewOpened()
    self.onBtnClick = false
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
end
function ArenaFairMainView:OnReConnectCall(enter)
    if enter then
        self:Close()
    end
end
return ArenaFairMainView
