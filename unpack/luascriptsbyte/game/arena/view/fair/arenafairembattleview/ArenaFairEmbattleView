        --670302  点击“确定”后，上阵角色站位将无法更改，是否确认
        --670303  点击“装备”后，合击技将无法更改，是否确认
        -- local times = self.arenaClass:GetCurEmbattleTimes()
        -- _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
        --     times == 4 and 670303 or 670302,
        --     _G.handler(self, self.ShowSureEmbatttleTips),
        --     nil,
        --     nil,
        --     true
        -- )
        self:ShowSureEmbatttleTips()
    end
end

function ArenaFairEmbattleView:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    LoadEffectByCfg(
        ui_effect_cfg.ef_dianji_loop,
        self.go_table.aorbtn_look,
        function(effect)
            if self:IsNil() then
                RemoveEffect(effect)
            else
                self.showLookEffect = effect
            end
        end
    )
end

function ArenaFairEmbattleView:CheckCurTimesEmbattle()
    local times = self.arenaClass:GetCurEmbattleTimes()
    local count = 0
    if times < 4 then --处于选择英雄阶段
        local data = self.embattleItem:GetEmbattleData()
        for i = 1, #data do
            if data[i].uid > 0 then
                count = count + 1
            end
        end
        if _G.Mathf.RoundToInt(count * 0.5) >= times then
            self.sureEmbattleTag = true
            self:UpdateTipsContent(_G.GetLangPackValue(90026100023))
            self:ShowTipsShadow(true)
        else --显示选择英雄
            if times == 3 then
                self:UpdateTipsContent(format(_G.GetLangPackValue(90026100021), 1, 0, 1))
            else
                count = 2 - (times * 2 - count)
                self:UpdateTipsContent(format(_G.GetLangPackValue(90026100021), 2, count, 2))
            end
        end
    else
        local data = self.embattleItem:GetCombSkillData()
        for i = 1, #data do
            if data[i].id > 0 then
                count = count + 1
            end
        end
        if count == 3 then
            self.sureEmbattleTag = true
            self:UpdateTipsContent(_G.GetLangPackValue(90026100023))
            self:ShowTipsShadow(true)
        else
            self:UpdateTipsContent(format(_G.GetLangPackValue(90026100022), count))
        end
    end
end

function ArenaFairEmbattleView:ShowSureEmbatttleTips(unCheck)
    self:ShowTipsShadow(true)
    self.sureEmbattleTag = true
    self.embattleItem:SaveEmbattleFair(_G.handler(self, self.OnSureEmbattleCall), unCheck)
end

function ArenaFairEmbattleView:OnSureEmbattleCall(msg)
    if msg.ack ~= 1 then --没有保存成功 则打开继续编辑
        self:ShowTipsShadow(false)
        return
    end
    self:UpdateTipsContent(_G.GetLangPackValue(90026100023))
    self:UpdateModelLock()
end

function ArenaFairEmbattleView:UpdateModelLock()
    self.embattleView:RegiestMoveBtnInitCall(_G.handler(self, self.OnEmbattleMoveBtnInitDone))
end

function ArenaFairEmbattleView:OnEmbattleMoveBtnInitDone()
    --TODO:将锁定的模型展示为锁定状态
    local data = self.embattleItem:GetEmbattleData()
    local x, y
    for i = 1, #data do
        if data[i].uid > 0 then
            self.modelLockTrans[i]:SetActiveE(1)
            x, y = self.embattleView:GetEmbatlePos(i)
            self.modelLockTrans[i]:SetLocalPosition(x, y, 0)
            self.embattleView:SetModelGray(i)
            self.embattleView:HideMoveBtns(i, false)
        else
            self.modelLockTrans[i]:SetActiveE(0)
        end
    end
    data = self.embattleItem:GetEnemyEmbattleData()
    for i = 1, #data do
        if data[i].uid > 0 then
            self.modelLockTrans[i + 5]:SetActiveE(1)
            x, y = self.embattleView:GetEmbatlePos(i + 5)
            self.modelLockTrans[i + 5]:SetLocalPosition(x, y, 0)
            self.embattleView:SetModelGray(i + 5)
        else
            self.modelLockTrans[i + 5]:SetActiveE(0)
        end
    end
end

---监听界面打开
---@param name string 界面名称
function ArenaFairEmbattleView:OnEmbattleViewOpened(name)
    local ui_cfg = _G.ConfigManager.ui_cfg
    if name == ui_cfg.EmbattleView.Name then
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_root)
        self.embattleView:ShowCardList()
        self.embattleView:HideShackleBottom()
        self.embattleView:HideExitBtn()
        self.embattleView:HideShackle()
        self:OnEmbattleCall(true)
        self:UpdateModelLock()
        self:CheckCurTimesEmbattle()
    elseif name == ui_cfg.EmbattleCombineSkillView.Name then
        self.go_table.obj_CombHandTips:SetActiveE(0)
        _G.UIManager:GetInstance():OpenWindow(ui_cfg.ArenaFairCombineView.Name, self.embattleItem:GetCombSkillData())
        self:CheckCurTimesEmbattle()
    end
end

---检测合击技是否全部上完
function ArenaFairEmbattleView:CheckCombSkiLLsEmpty()
    local index = self.embattleItem:GetFirstEmptyCombineIndex()
    if index > 0 then
        if not self.CombSkillHandEff then
            self.CombSkillHandEff = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_SecretShouZhi,
                self.go_table.obj_CombHandTips,
                function(tran)
                    self.CombSkillHandEff = tran
                end
            )
        end
        if index == 1 then
            self.go_table.obj_CombHandTips:SetLocalPosition(132, -214)
        else
            self.go_table.obj_CombHandTips:SetLocalPosition(132, -120 - 100 * index)
        end
        self.go_table.obj_CombHandTips:SetActiveE(1)
    else
        self.go_table.obj_CombHandTips:SetActiveE(0)
    end
end

function ArenaFairEmbattleView:OnCombineViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name then
