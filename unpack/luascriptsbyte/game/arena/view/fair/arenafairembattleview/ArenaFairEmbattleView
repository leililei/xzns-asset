---界面的入口函数
function ArenaFairEmbattleView:OnCreate(data, itemCall)
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:RegiestChatCall(_G.handler(self, self.OnEnemyChatCall))
    self.arenaClass:RegiestEmbattleUpdateCall(_G.handler(self, self.OnEmbattleCall))
    self.arenaClass:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineViewClosed, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        0,
        _G.EmbattleSaveType.server,
        nil,
        _G.EmbattleControllerItemType.arenaFair,
        nil,
        nil,
        _G.ConfigManager.arena_info_cfg[ArenaManager.arenaType.fair].battle_sences,
        data
    )
    if itemCall then
        itemCall()
    end
    self.embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
    self.embattleItem:RegiestEmbattleDataChanged(_G.handler(self, self.OnEmbattleChanged))
    self:ShowPlayerInfo(
        data.roles.name,
        data.roles.style,
        data.roles.win_times,
        data.roles.win_per,
        self.go_table.obj_enemy
    )
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    local num, per = self.arenaClass:GetWinNum()
    self:ShowPlayerInfo(PlayerModelIns:GetName(), PlayerModelIns:GetRoleStyle(), num, per, self.go_table.obj_my)
    self:InitEffect()
end

---界面的销毁函数
function ArenaFairEmbattleView:OnDestroy()
    if self.handleChooseTimer then
        self.handleChooseTimer:Stop()
        self.handleChooseTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineViewClosed, self)
    self.enemySkillobj = nil
    self.enemySkillIcon = nil
    self.CombSkillHandEff = nil
    self.enemySkillType = nil
    self:DispodChatView()
    self.arenaClass:RegiestChatCall(nil)
    self.arenaClass:RegiestEmbattleUpdateCall(nil)
    self.arenaClass:UnRegiestReConnectCall(self.viewName)
    self.arenaClass = nil
    self.embattleItem:RegiestEmbattleDataChanged(nil)
    self.embattleItem = nil
end

---按钮点击事件在这里派发
