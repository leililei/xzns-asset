        --TODO:查看对方卡池，隐藏确定按钮
        self:LookEnemyCards(true)
        if not _G.IsNil(self.showLookEffect) then
            _G.UIUtils.RemoveEffect(self.showLookEffect)
        end
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_dianji_01,
            self.go_table.aorbtn_lookDone,
            function(effect)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(effect)
                end
            end
        )
    elseif go == self.go_table.aorbtn_lookDone then
        self:LookEnemyCards(false)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_dianji_01,
            self.go_table.aorbtn_look,
            function(effect)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(effect)
                end
            end
        )
