---根据类型展示聊天
---@param type number 聊天类型 1 文本 2 表情
function ArenaFairEmbattleView:ShowChatByType(type)
    self.go_tableChat.aorimage_kong:SetActiveE(0)
    if type == 1 then
        self.go_tableChat.obj_chatEmjioChoose:SetActiveE(0)
        self.go_tableChat.obj_chatTextChoose:SetActiveE(1)
        self.go_tableChat.scrollloopvectical_phiz:SetActiveE(0)
        self.go_tableChat.obj_text:SetActiveE(1)
        self:InitChatViewText()
    else
        self.go_tableChat.obj_chatEmjioChoose:SetActiveE(1)
        self.go_tableChat.obj_chatTextChoose:SetActiveE(0)
        self.go_tableChat.scrollloopvectical_phiz:SetActiveE(1)
        self.go_tableChat.obj_text:SetActiveE(0)
        self:InitChatViewEmj()
    end
end

function ArenaFairEmbattleView:OnChatPanelClickBtn(go)
    if go == self.go_tableChat.aorbtn_chatEmjio then
        --TODO:展示表情聊天页面
        self:ShowChatByType(2)
    elseif go == self.go_tableChat.aorbtn_chatText then
        --TODO展示文本聊天界面
        self:ShowChatByType(1)
    elseif go == self.go_tableChat.aorbtn_chatClose then
        self.go_table.obj_chatPanel:SetActiveE(0)
    else
        for i = 1, #self.chatEmjBtnTable do
            if go == self.chatEmjBtnTable[i] then
                self:ShowChat(true, 2, self.chatEmjioIDs[i])
                --TODO:发送表情聊天
                self.arenaClass:SendChatMsg(2, self.chatEmjioIDs[i])
            end
        end
    end
end

function ArenaFairEmbattleView:InitChatViewEmj()
    if self.chatEmjioIDs then
        return
    end
    local cfg = require("ChatManager"):GetInstance():Phiz_GetGif()
    if #cfg <= 0 then
        cfg = require("ChatManager"):GetInstance():GetPhiz_DataID()
    end
    if #cfg <= 0 then
        self.go_tableChat.aorimage_kong:SetActiveE(1)
        return
    else
        self.go_tableChat.aorimage_kong:SetActiveE(0)
    end

    local expression_cfg = _G.ConfigManager.expression_cfg
    self.PhizArr = _G.table.values(cfg)
    _G.SortList(
        self.PhizArr,
        function(a)
            local num = require("ChatManager"):GetInstance():GetPhiz_ChatData(a.id)
            return num, -a.id
        end
    )
    if self.phiz == nil then
        self.phiz = true
        self.go_tableChat.scrollloopvectical_phiz:InitItemData(#self.PhizArr, _G.handler(self, self.RefreshList_phiz))
    else
        self.go_tableChat.scrollloopvectical_phiz:UpdateCount(#self.PhizArr)
    end
    -- self.chatEmjioIDs = _G.DeepCopyCfgTable(cfg.expression)
end

function ArenaFairEmbattleView:RefreshList_phiz(index, objGame)
    if index < 0 then
        return
    end
    ---@type expression_cfg
    local cfg = self.PhizArr[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_phiz, cfg))
    itemGoTable.Phiz_id = cfg.id or cfg.sid

    if cfg.gif == 0 then
        itemGoTable.aorrawimage_icon:SetActiveE(1)
        itemGoTable.obj_spine:SetActiveE(0)
        itemGoTable.aorrawimage_icon.Alpha = 0
        itemGoTable.aorrawimage_icon:LoadImage(cfg.img_path)
    elseif cfg.gif == 1 then
        itemGoTable.aorrawimage_icon:SetActiveE(0)
        itemGoTable.obj_spine:SetActiveE(1)
        itemGoTable.obj_spine:ClearChildren()
        _G.UIUtils.LoadEffectByPath(cfg.img_path, itemGoTable.obj_spine)
    end

    return objGame
end

function ArenaFairEmbattleView:OnClick_phiz(go, _, itemGoTable)
    local Phiz_id = itemGoTable.id or itemGoTable.sid

    ---@type expression_cfg
    local cfg = _G.ConfigManager.expression_cfg[Phiz_id]
    if cfg ~= nil then
        self:ShowChat(true, 2, cfg.id or cfg.sid)
        self.arenaClass:SendChatMsg(2, cfg.id or cfg.sid)
    end
end

local FAIRINTERACTIONID = 10001
function ArenaFairEmbattleView:InitChatViewText()
    if self.chatLanguageIDs then
        return
    end
    local cfg = _G.ConfigManager.interaction_cfg[FAIRINTERACTIONID]
    self.chatLanguageIDs = _G.DeepCopyCfgTable(cfg.language)
    self.chatItemTable = {}
    self.chatTextClickHandler = _G.handler(self, self.OnChatTextBtnCall)
    self.go_tableChat.scrollloopvectical_chat:InitItemData(
        #self.chatLanguageIDs,
        _G.handler(self, self.OnChatTextItemCall)
    )
end

function ArenaFairEmbattleView:OnChatTextItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.chatItemTable[id]
    if not item then
        item = _G.GetAutoGoTable(obj, self.chatTextClickHandler)
        self.chatItemTable[id] = item
    end
    index = index + 1
    obj:SetName(_G.tostring(index))
    item.aortext_text.text = _G.GetLangPackValue(self.chatLanguageIDs[index])
end

function ArenaFairEmbattleView:OnChatTextBtnCall(go)
    local index = _G.tonumber(go:GetParent():GetName())
    --TODO:发送文字聊天消息并显示在己方头像旁
    self.arenaClass:SendChatMsg(1, self.chatLanguageIDs[index])
    self:ShowChat(true, 1, self.chatLanguageIDs[index])
end

---聊天展示时间离散表配置ID
local CHATSHOWTIMEDISCRETEID = 106014
---开启聊天展示计时器
---@param my boolean 是否是自己
function ArenaFairEmbattleView:OpenShowChatTimer(my)
    if not self.showChatTime then
        self.showChatTime = { my = 0, other = 0 }
    end
    if my then
        self.showChatTime.my = _G.ConfigManager.discrete_cfg[CHATSHOWTIMEDISCRETEID][1][1]
    else
        self.showChatTime.other = _G.ConfigManager.discrete_cfg[CHATSHOWTIMEDISCRETEID][1][1]
    end
    if not self.showChatTimer then
        self.showChatTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnShowChatTimerCall, self)
        self.showChatTimer:Start()
    else
        self.showChatTimer:Resume()
    end
end

function ArenaFairEmbattleView:OnShowChatTimerCall(elapsed)
    if self.showChatTime.my > 0 then
        self.showChatTime.my = self.showChatTime.my - elapsed
        if self.showChatTime.my <= 0 then
            self.showChatTime.my = 0
            self.go_table.obj_chatTextLeft:SetActiveE(0)
            self.go_table.obj_chatImageLeft:SetActiveE(0)
        end
    end
    if self.showChatTime.other > 0 then
        self.showChatTime.other = self.showChatTime.other - elapsed
        if self.showChatTime.other <= 0 then
            self.showChatTime.other = 0
            self.go_table.obj_chatImageRight:SetActiveE(0)
            self.go_table.obj_chatTextRight:SetActiveE(0)
        end
    end
    if self.showChatTime.other == 0 and self.showChatTime.my == 0 then
        self.showChatTimer:Pause()
        self.showChatTimer:Reset()
    end
end

---收到对手的聊天消息
---@param type number 消息类型
---@param id number 消息内容ID  文本为 多语言ID 表情为表情ID
function ArenaFairEmbattleView:OnEnemyChatCall(type, id)
    self:ShowChat(false, type, id)
end

function ArenaFairEmbattleView:ShowChat(my, type, id)
    if my then
        if type == 1 then
            self.go_table.obj_chatImageLeft:SetActiveE(0)
            self.go_table.obj_chatTextLeft:SetActiveE(1)
            self.go_table.aortext_chatLeft.text = _G.GetLangPackValue(id)
            self.go_table.aortext_chatLeft1.text = _G.GetLangPackValue(id)
        else
            self.go_table.obj_chatImageLeft:SetActiveE(1)
            self.go_table.obj_chatTextLeft:SetActiveE(0)
            local cfg = _G.ConfigManager.expression_cfg[id]
            if cfg.gif == 0 then
                self.go_table.aorrawimage_chatLeft:SetActiveE(1)
                self.go_table.obj_chatLeft:SetActiveE(0)
                self.go_table.aorrawimage_chatLeft.Alpha = 0
                self.go_table.aorrawimage_chatLeft:LoadImage(cfg.img_path)
            elseif cfg.gif == 1 then
                self.go_table.aorrawimage_chatLeft:SetActiveE(0)
                self.go_table.obj_chatLeft:SetActiveE(1)
                self.go_table.obj_chatLeft:ClearChildren()
                _G.UIUtils.LoadEffectByPath(cfg.img_path, self.go_table.obj_chatLeft, nil, nil, nil,
                    { 0, -110 })
            end
        end
    else
        if type == 1 then
            self.go_table.obj_chatImageRight:SetActiveE(0)
            self.go_table.obj_chatTextRight:SetActiveE(1)
            self.go_table.aortext_chatRight.text = _G.GetLangPackValue(id)
            self.go_table.aortext_chatRight1.text = _G.GetLangPackValue(id)
        else
            self.go_table.obj_chatImageRight:SetActiveE(1)
            self.go_table.obj_chatTextRight:SetActiveE(0)

            local cfg = _G.ConfigManager.expression_cfg[id]
            if cfg.gif == 0 then
                self.go_table.aorrawimage_chatRight:SetActiveE(1)
                self.go_table.obj_chatRight:SetActiveE(0)
                self.go_table.aorrawimage_chatRight.Alpha = 0
                self.go_table.aorrawimage_chatRight:LoadImage(cfg.img_path)
            elseif cfg.gif == 1 then
                self.go_table.aorrawimage_chatRight:SetActiveE(0)
                self.go_table.obj_chatRight:SetActiveE(1)
                self.go_table.obj_chatRight:ClearChildren()
                _G.UIUtils.LoadEffectByPath(cfg.img_path, self.go_table.obj_chatRight, nil, nil, nil,
                    { 0, -110 })
            end
        end
    end
    self:OpenShowChatTimer(my)
end

function ArenaFairEmbattleView:EscClose()
    self.go_table.obj_chatPanel:SetActiveE(0)
end

--endregion
return ArenaFairEmbattleView
