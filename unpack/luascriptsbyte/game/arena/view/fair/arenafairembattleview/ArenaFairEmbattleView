---展示敌方合击技
function ArenaFairEmbattleView:ShowEnemyCombineSkill()
    local info = self.embattleItem:GetEnemyCombineSkill()
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local language_package_cfg = _G.ConfigManager.language_package_cfg
    local battle_skill_cfg = _G.ConfigManager.battle_skill_cfg
    local cfg
    for i = 1, #info do
        if info[i].id > 0 then
            self.enemySkillobj[i]:SetActiveE(1)
            cfg = card_skills_cfg[info[i].cskillID]
            self.enemySkillIcon[i]:LoadImage(cfg.icon)
            cfg = battle_skill_cfg[cfg.skills[1]]
            self.enemySkillType[i].text = language_package_cfg[cfg.Brief]
        end
    end
end

---查看对手卡牌库
---@param look boolean 查看还是关闭
function ArenaFairEmbattleView:LookEnemyCards(look)
    self.go_table.aorbtn_look:SetActiveE(not look and 1 or 0)
    self.go_table.aorbtn_lookDone:SetActiveE(look and 1 or 0)
    self.go_table.aorbtn_sure:SetActiveE(not look and 1 or 0)
    self.embattleItem:ChangeCardList(not look)
    self.embattleView:RefreshCardListPubByChangeNum()
end

---布阵数据刷新
function ArenaFairEmbattleView:OnEmbattleCall(notUpdate)
    self.sureEmbattleTag = false
    self:ShowEnemyCombineSkill()
    if not notUpdate then
        if self.embattleView then
            --TODO:刷新布阵展示数据
            self.embattleView:UpdateAllModelPub()
        end
        _G.TimerManager:GetInstance():GetTimer(1, self.UpdateModelLock, self, true, true):Start()
    end
    local times = self.arenaClass:GetCurEmbattleTimes()
    if times > 4 then --布阵轮次结束，进入战斗
        ---隐藏手势
        self:CheckCombSkiLLsEmpty()
        self:EnterBattleCall()
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineViewClosed, self)
        local UIManagerIns = _G.UIManager:GetInstance()
        local ui_cfg = _G.ConfigManager.ui_cfg
        UIManagerIns:CloseWindow(ui_cfg.EmbattleCombineSkillView.Name)
        UIManagerIns:CloseWindow(ui_cfg.ArenaFairCombineView.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaFairTimesTipsView.Name, times)
        if times == 4 then
            self.embattleView:ClickCombSkillBtn(1)
            self:UpdateTipsContent(format(_G.GetLangPackValue(90026100022), 0))
        elseif times == 3 then
            self:UpdateTipsContent(format(_G.GetLangPackValue(90026100021), 1, 0, 1))
        else
            self:UpdateTipsContent(format(_G.GetLangPackValue(90026100021), 2, 0, 2))
        end
        self:OnEmbattleTimesCall(times, self.arenaClass:GetCurEmbattleEndTime())
    end
end

---进入战斗
function ArenaFairEmbattleView:EnterBattleCall()
    if self.handleChooseTimer then
        self.handleChooseTimer:Stop()
        self.handleChooseTimer = nil
    end
    --TODO:倒计时结束 自动进入战斗 可能还未关闭提示界面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name)
    --TODO:布阵界面进入战斗
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleViewClosed, self)
    self.embattleView:OnBattleClick(true)
end

---当布阵界面关闭
function ArenaFairEmbattleView:OnEmbattleViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleViewClosed, self)
        self.arenaClass:StartBattle()
    end
end

function ArenaFairEmbattleView:UpdateTipsContent(content)
    self.go_table.aortext_tips.text = content
end

function ArenaFairEmbattleView:ShowTipsShadow(show)
    if self:IsNil() then
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_tips, show)
end

function ArenaFairEmbattleView:OnEmbattleChanged()
    local times = self.arenaClass:GetCurEmbattleTimes()
    local data, count
    count = 0
    if times == 4 then
        data = self.embattleItem:GetCombSkillData()
        for i = 1, #data do
            if data[i].id > 0 then
                count = count + 1
            end
        end
        self:UpdateTipsContent(format(_G.GetLangPackValue(90026100022), count))
    else
        data = self.embattleItem:GetEmbattleData()
        for i = 1, #data do
            if data[i].uid > 0 then
                count = count + 1
            end
        end
        if times == 3 then
            count = 1 - (5 - count)
            self:UpdateTipsContent(format(_G.GetLangPackValue(90026100021), 1, count, 1))
        else
            count = 2 - (times * 2 - count)
            self:UpdateTipsContent(format(_G.GetLangPackValue(90026100021), 2, count, 2))
        end
    end
end

function ArenaFairEmbattleView:OnReConnectCall(enter)
    if enter then
        return
    end
    --TODO:退出布阵
    require("EmbattleController"):GetInstance():CloseEmbattle()
    local UIManagerIns = _G.UIManager:GetInstance()
    local ui_cfg = _G.ConfigManager.ui_cfg
    UIManagerIns:CloseWindow(ui_cfg.EmbattleCombineSkillView.Name)
    UIManagerIns:CloseWindow(ui_cfg.ArenaFairCombineView.Name)
    UIManagerIns:CloseWindow(ui_cfg.ArenaFairTimesTipsView.Name)
    self:Close()
    UIManagerIns:OpenWindow(ui_cfg.ArenaFairMainView.Name)
end

