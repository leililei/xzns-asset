---切换到下一轮次
---@param times number 当前轮次
---@param time number 当前轮次剩余时间戳
function ArenaFairEmbattleView:OnEmbattleTimesCall(times, time)
    self:ShowTipsShadow(false)
    self.go_table.aortext_times.text =
        format(_G.GetLangPackValue(90026100020), _G.GameUtil.NumberToWordByLanguage(times))
    self.chooseTime = 0
    self.chooseTimeStamp = time
    self:HandleChoosTime()
    if self.handleChooseTimer then
        self.handleChooseTimer:Stop()
        self.handleChooseTimer = nil
    end
    self.handleChooseTimer = _G.TimerManager:GetInstance():GetTimer(1, self.HandleChoosTime, self)
    self.handleChooseTimer:Start()
end

function ArenaFairEmbattleView:HandleChoosTime()
    self.chooseTime = self.chooseTimeStamp - _G.TimeUtil.GetServerUnixTime()
    if self.chooseTime > 0 then
        self.go_table.aortext_time.text = format(_G.GetLangPackValue(90026100037), self.chooseTime)
    else
        self.chooseTime = 0
        self.go_table.aortext_time.text = format(_G.GetLangPackValue(90026100037), self.chooseTime)
        if not self.sureEmbattleTag then --倒计时结束，自动确定布阵
            --TODO:确定当前轮次，展示tips界面
            self:ShowSureEmbatttleTips(true)
        end
        if self.handleChooseTimer then
            self.handleChooseTimer:Stop()
            self.handleChooseTimer = nil
        end
    end
end

---展示玩家信息
---@param 变量名 变量类型 中文描述
function ArenaFairEmbattleView:ShowPlayerInfo(name, style, winnum, winper, obj)
