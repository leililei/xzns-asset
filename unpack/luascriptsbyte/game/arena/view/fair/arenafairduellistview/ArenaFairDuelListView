--region 要求列表Item
local ArenaFairDuelListItem = _G.BaseClass("ArenaFairDuelListItem")
local UIUtils = _G.UIUtils
function ArenaFairDuelListItem:__init(obj, invitationCall, id)
    self.onInvitationCall = invitationCall
    self.instanceID = id
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end
function ArenaFairDuelListItem:Dispose()
    self.go_table = nil
    self.onInvitationCall = nil
    self.instanceID = nil
end
function ArenaFairDuelListItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_chat then
        --TODO:打开私聊界面
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatView.Name, _G.ChatType.privateChat)
        require("ChatManager"):GetInstance():Zjsl_OpenView(self.data.uid)
    elseif go == self.go_table.aorbtn_duel then
        --TODO:切磋
        self.onInvitationCall(self.index, self.instanceID)
    end
end
--[[
    uid = uid,
    title = value.title,
    name = value.name,
    score = 0,
    style = value.style,
    frame = value.frame,
    power = value.power
]]
function ArenaFairDuelListItem:Show(data, index)
    self.data = data
    self.go_table.aortext_score.text = data.score
    self.go_table.aortext_name.text = data.name
    self.index = index
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,data,0.9,true,true)
end
function ArenaFairDuelListItem:ShowWait()
    self.go_table.obj_wait:SetActiveE(1)
    self.go_table.aorbtn_duel:SetActiveE(0)
end
function ArenaFairDuelListItem:ShowInvitationBtn()
    self.go_table.obj_wait:SetActiveE(0)
    self.go_table.aorbtn_duel:SetActiveE(1)
end
function ArenaFairDuelListItem:GetIndex()
    return self.index
end
--endregion
---邀请的有效时效 单位秒
local INVITATIONVALIDTIME = 60
---@class ArenaFairDuelListView : UIBaseView	中文描述
---@field public go_table ArenaFairDuelListView_GoTable GoTable
local ArenaFairDuelListView = _G.BaseClass("ArenaFairDuelListView", _G.UIBaseView)

function ArenaFairDuelListView:Awake()
end

---界面的入口函数
function ArenaFairDuelListView:OnCreate()
    local ArenaManager = require "ArenaManager"
    self.arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.fair)
    self.arenaClass:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
    self.OnInvitationCallHandler = _G.handler(self, self.OnInvitationCall)
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.OnItemCall))
end
function ArenaFairDuelListView:OnEnable()
    self.arenaClass:GetDuelList(_G.handler(self, self.OnDuelListCall))
end
function ArenaFairDuelListView:OnDisable()
    self.go_table.scrollloopvectical_list:UpdateCount(0)
end
---界面的销毁函数
function ArenaFairDuelListView:OnDestroy()
    self.arenaClass:UnRegiestReConnectCall(self.viewName)
    self.arenaClass = nil
    self.duelList = nil
    if self.itemTable then
        for _, item in pairs(self.itemTable) do
            item:Dispose()
        end
        self.itemTable = nil
    end
    self.curInvitationItemID = nil
    self.curInvitationIndex = nil
    self.invitationIndexTab = nil
end

function ArenaFairDuelListView:OnDuelListCall(list)
    if list and #list > 0 then
        self.go_table.obj_empty:SetActiveE(0)
        self.go_table.scrollloopvectical_list:SetActiveE(1)
        self.duelList = list
        self.itemTable = {}
        self.go_table.scrollloopvectical_list:UpdateCount(#list)
    else
        self.go_table.obj_empty:SetActiveE(1)
        self.go_table.scrollloopvectical_list:SetActiveE(0)
    end
end

function ArenaFairDuelListView:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemTable[id]
    if not item then
        item = ArenaFairDuelListItem.New(obj, self.OnInvitationCallHandler, id)
        self.itemTable[id] = item
    end
    index = index + 1
    item:Show(self.duelList[index], index)
    if self.invitationIndexTab and self.invitationIndexTab[index] then
        item:ShowWait()
    else
        item:ShowInvitationBtn()
    end
end
function ArenaFairDuelListView:CheckCloseView(call)
    if not _G.table.isEmptyOrNil(self.invitationIndexTab) then --已经在邀请了
        --TODO:弹出提示窗
        --670301  关闭界面将取消所有邀请，是否确认退出
        _G.PopWindowManager:GetInstance():ShowAllTips(
            670301,
            nil,
            function()
                --TODO:发送取消切磋的消息
                self.arenaClass:CancleInvitationDuel(
                    function(success)
                        if success then
                            for _, item in pairs(self.itemTable) do
                                item:ShowInvitationBtn()
                            end
                            self.invitationIndexTab = nil
                            if self.onInvitationTimer then
                                self.onInvitationTimer:Stop()
                                self.onInvitationTimer = nil
                            end
                            call(true)
                        end
                    end,
                    0
                )
            end,
            function()
                call(false)
            end
        )
        return
    end
    call(true)
end
function ArenaFairDuelListView:OnInvitationCall(index, id)
    --TODO:需求变更，可同时要求多个玩家
    if not self.invitationIndexTab then
        self.invitationIndexTab = {}
    end
    if self.invitationIndexTab[index] then --已经邀请过了
        return
    end
    self.curInvitationIndex = index
    self.curInvitationItemID = id
    if
        not self.arenaClass:InvitationDuel(
            self.duelList[index].uid,
            _G.handler(self, self.OnInvitationItemCall),
            _G.handler(self, self.OnInvitationAnswerCall)
        )
     then
        self.curInvitationIndex = 0
        self.curInvitationItemID = 0
    end
end

function ArenaFairDuelListView:OnInvitationItemCall(success)
    if success then
        --邀请好友成功
        _G.PopWindowManager:GetInstance():ShowAllTips(670102)
        self.itemTable[self.curInvitationItemID]:ShowWait()
        self.invitationIndexTab[self.curInvitationIndex] = INVITATIONVALIDTIME
        if not self.onInvitationTimer then
            --TODO:开启一分钟计时
            self.onInvitationTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnInvitationTimeOutCall, self)
            self.onInvitationTimer:Start()
        end
    else
        --TODO:邀请返回错误，可能不在线,是否需要从列表中去除
        -- self:RemoveDuelList(self.curInvitationIndex)
        self.curInvitationIndex = 0
        self.curInvitationItemID = 0
    end
end
function ArenaFairDuelListView:OnInvitationAnswerCall(accept, uid)
    local index
    for i = 1, #self.duelList do
        if self.duelList[i].uid == uid then
            index = i
            break
        end
    end
    if not index then
        return
    end
    if accept then --接受邀请
        --TODO:打开确定界面
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaFairAcceptView.Name,
            self.duelList[index],
            _G.handler(self, self.OnAcceptViewCall)
        )
    else --拒绝邀请
        for _, item in pairs(self.itemTable) do
            if item:GetIndex() == index then
                item:ShowInvitationBtn()
            end
        end
    end
    self.invitationIndexTab[index] = nil
    if _G.table.isEmptyOrNil(self.invitationIndexTab) and self.onInvitationTimer then
        self.onInvitationTimer:Stop()
        self.onInvitationTimer = nil
    end
end
function ArenaFairDuelListView:OnAcceptViewCall(accept, call)
    if accept then
        --TODO:发送切磋准备完成
        self.arenaClass:PrepareDuelFair(
            true,
            function(msg)
                if msg.ack == 1 then
                    call(true)
                else
                    -- self:RemoveDuelList(self.curInvitationIndex)
                    self.curInvitationIndex = 0
                    self.curInvitationItemID = 0
                    call(false)
                end
            end
        )
    else
        --TODO:发送切磋准备完成
        self.arenaClass:PrepareDuelFair(
            false,
            function(msg)
                self.itemTable[self.curInvitationItemID]:ShowInvitationBtn()
                if msg.ack == 1 then
                -- else
                --     self:RemoveDuelList(self.curInvitationIndex)
                end
                self.curInvitationIndex = 0
                self.curInvitationItemID = 0
            end,
            self.curInvitationItemID
        )
    end
end
function ArenaFairDuelListView:OnInvitationTimeOutCall(elapsed)
    if self.invitationIndexTab then
        for index, t in pairs(self.invitationIndexTab) do
            t = t - elapsed
            if t <= 0 then
                --TODO:超时 取消邀请
                --TODO:发送取消切磋的消息
                self.arenaClass:CancleInvitationDuel(
                    function(success)
                        if success then
                            for _, item in pairs(self.itemTable) do
                                if item:GetIndex() == index then
                                    item:ShowInvitationBtn()
                                    break
                                end
                            end
                        end
                    end,
                    self.duelList[index].uid
                )
                --受邀者未接受邀请
                _G.PopWindowManager:GetInstance():ShowAllTips(670108)
                self.invitationIndexTab[index] = nil
                break
            else
                self.invitationIndexTab[index] = t
            end
        end
        if _G.table.isEmptyOrNil(self.invitationIndexTab) and self.onInvitationTimer then
            self.onInvitationTimer:Stop()
            self.onInvitationTimer = nil
        end
    end
end
function ArenaFairDuelListView:RemoveDuelList(index)
    _G.table.remove(self.duelList, index)
    if #self.duelList > 0 then
        self.go_table.scrollloopvectical_list:UpdateCount(#self.duelList)
    else
        self.go_table.obj_empty:SetActiveE(1)
        self.go_table.scrollloopvectical_list:SetActiveE(0)
    end
end
function ArenaFairDuelListView:OnReConnectCall(enter)
    if enter then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaFairDuelPageView.Name)
        return
    end
    --TODO:取消邀请
    if self.invitationIndexTab then
        for _, item in pairs(self.itemTable) do
            item:ShowInvitationBtn()
        end
        self.invitationIndexTab = nil
        self.curInvitationIndex = 0
        self.curInvitationItemID = 0
        if self.onInvitationTimer then
            self.onInvitationTimer:Stop()
            self.onInvitationTimer = nil
        end
    end
end

---@private
function ArenaFairDuelListView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArenaFairDuelPageView.Name)
    if view then
        view:DoClose()
    end
end

return ArenaFairDuelListView
