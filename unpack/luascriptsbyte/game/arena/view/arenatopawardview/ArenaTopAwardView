---@class ArenaTopAwardView : UIBaseView	中文描述
---@field public go_table ArenaTopAwardView_GoTable GoTable
local ArenaTopAwardView = _G.BaseClass("ArenaTopAwardView", _G.UIBaseView)

function ArenaTopAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local ConfigManager = _G.ConfigManager
local GetLangPackValue = _G.GetLangPackValue
local ViewType = {
    Arena = 1,
    ArenaSenior = 2,
    AllHero = 3
}

local TitleName = {
    [ViewType.Arena] = "ImagesH5/hArena/ui_jjc_txt_yxry",
    [ViewType.ArenaSenior] = "Images/Arena/ui_jjc_wsjl_txt",
    [ViewType.AllHero] = "Images/Arena/ui_jjc_qydz_txt"
}

local TipID = {
    [ViewType.Arena] = 90022100133,
    [ViewType.ArenaSenior] = 90022100134,
    [ViewType.AllHero] = 90022100135
}

local RankStrID = {
    [ViewType.Arena] = 100715,
    [ViewType.ArenaSenior] = 100716
}

local NameColor = {
    [1] = "e7c99e",
    [2] = "e7c99e",
    [3] = "e7c99e"
}

local NumColor = "14874a"


---界面的入口函数
function ArenaTopAwardView:OnCreate(type, closeCall)
    if _G.AppSetting.IsXzns then
        NameColor = {
            "67170f",
            "634816",
            "3f1b61"
        }
        NumColor = "90F2A2"
    end
    self.type = type
    self:InitView()
    self.closeCall = closeCall
end

function ArenaTopAwardView:InitView()
    self.go_table.aorrawimage_title:LoadImage(TitleName[self.type])
    self.go_table.aortext_tip.text = GetLangPackValue(TipID[self.type])
    local awards
    if self.type == ViewType.Arena then
        awards = ConfigManager.arena_info_cfg[1].rank_league
        self:ShowArenaAward(awards)
    elseif self.type == ViewType.ArenaSenior then
        awards = ConfigManager.arena_info_cfg[2].rank_league
        self:ShowArenaAward(awards)
    elseif self.type == ViewType.AllHero then
        self.go_table.obj_top2:SetActiveE(0)
        self.go_table.obj_top3:SetActiveE(0)
        awards = ConfigManager.activity_pvp_cfg[750].rank_league
        local namePath, effectPath, attr = self:GetNameAwardSpecial(awards)
        if namePath then
            if effectPath then
                self:LoadTitleEffect(effectPath, self.go_table.aorrawimage_name1)
                self.go_table.aorrawimage_name1.Alpha = 0
            else
                self.go_table.aorrawimage_name1:LoadImage(
                    namePath,
                    function(trans)
                        trans:SetNativeSize()
                    end
                )
            end
            self:ShowProp(attr, self.go_table.obj_PropContent1, NameColor[1])
        else
            self.go_table.aorrawimage_name1:SetActiveE(0)
        end
    end
end

---加载称号特效
function ArenaTopAwardView:LoadTitleEffect(title, parent)
    _G.UIUtils.LoadEffectTitleOrFrame(
        title,
        parent,
        function(trans)
            local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            parClip.NeedCheck = true
            parClip.CheckCount = 10
            parClip.CheckOne = 3
            trans:SetLocalScaleXYZ(1)
        end
    )
end

---显示竞技场奖励
function ArenaTopAwardView:ShowArenaAward(awardIDLis)
    local namePath, effectPath, rankStr, attr, index
    local array = ConfigManager.discrete_cfg[RankStrID[self.type]]
    for i = 1, 3 do
        index = i == 1 and 1 or array[i - 1][1] --起始名次
        namePath, effectPath, rankStr, attr = self:GetTitleAndRankStr(awardIDLis[index], i)
        if namePath then
            if i == 1 and effectPath then
                self:LoadTitleEffect(effectPath, self.go_table["aorrawimage_name" .. i])
                self.go_table["aorrawimage_name" .. i].Alpha = 0
            else
                self.go_table["aorrawimage_name" .. i]:LoadImage(
                    namePath,
                    function(trans)
                        trans:SetNativeSize()
                    end
                )
            end
            self:ShowProp(attr, self.go_table["obj_PropContent" .. i], NameColor[i])
        else
            self.go_table["aorrawimage_name" .. i]:SetActiveE(0)
        end
        self.go_table["aortext_rank" .. i].text = rankStr
    end
end

---从奖励数组找到称号奖励(弃用)
function ArenaTopAwardView:GetNameAward(award)
    local namePath, effectPath, attr, param, cfg
    for _, v in pairs(award) do
        if v[2] == 1 then
            local type, id = _G.StorageManager:GetInstance():CheckSidType(v[1])
            if type == _G.StorageType.Prop then
                param = ConfigManager.item_cfg[v[1]].UseParameter
                cfg = ConfigManager.player_title_effect_cfg[_G.tonumber(param[1][1])]
                namePath = cfg.icon
                effectPath = cfg.type_title == 2 and cfg.title or nil
                attr = cfg.base_att
                break
            end
        end
    end
    return namePath, effectPath, attr
end

---找到称号奖励
function ArenaTopAwardView:GetNameAwardSpecial(award)
    local namePath, effectPath, attr, cfg
    for _, v in pairs(award) do
        if v[1] == 13 then --称号
            cfg = ConfigManager.player_title_effect_cfg[v[2]]
            namePath = cfg.icon
            effectPath = cfg.type_title == 2 and cfg.title or nil
            attr = cfg.base_att
            break
        elseif v[1] == 14 then --光环
            cfg = ConfigManager.player_halo_effect_cfg[v[2]]
            namePath = cfg.icon
            effectPath = cfg.halo
            attr = cfg.base_att
            break
        end
    end
    return namePath, effectPath, attr
end

---获取称号路径，称号特效路径，排名文本
---@param number rankID arena_rank_cfg表id
function ArenaTopAwardView:GetTitleAndRankStr(rankID, index)
    ---@type arena_rank_cfg
    local cfg = ConfigManager.arena_rank_cfg[rankID]
    local namePath, effectPath, attr, rankStr
    namePath, effectPath, attr = self:GetNameAwardSpecial(cfg.reward_appearance)
    if index > 1 then
        local array = ConfigManager.discrete_cfg[RankStrID[self.type]]
        index = index - 1
        rankStr = GetLangPackValue(90022100071, array[index][1], array[index][2])
    else
        rankStr = GetLangPackValue(90022100031, 1)
    end
    -- if cfg.min_rank == cfg.max_rank then
    --     rankStr = GetLangPackValue(90022100031, cfg.min_rank)
    -- else
    --     rankStr = GetLangPackValue(90022100071, cfg.min_rank, cfg.max_rank)
    -- end
    return namePath, effectPath, rankStr, attr
end

---收集属性转换显示
---@param data AttributeClass
function ArenaTopAwardView:ShowProp(data, parent, color)
    local prop = data
    local showlist = {}
    for i, v in pairs(prop) do
        _G.table.insert(
            showlist,
            {
                key = v[1],
                sortid = _G.AttrType[v[1]].sortid,
                proptype = _G.AttrType[v[1]].proptype,
                icon = _G.AttrType[v[1]].icon,
                des = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[v[1]].ID].name),
                percentage = _G.AttrType[v[1]].percentage,
                type = _G.tonumber(v[2]),
                num = v[3]
            }
        )
    end
    _G.SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    for _, v in pairs(showlist) do
        local key = v.key
        if parent ~= nil then
            local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, parent)
            if tran then
                local tb = _G.GetAutoGoTable(tran)
                tb.aorrawimage_icon:LoadImage(v.icon)
                tb.aortext_Name.text = v.des
                tb.aortext_Name.color = _G.ColorTools.FormatColorByString(color)
                tb.aortext_Num.text = "+" .. AttributeClassManager:GetShowProp(key, v.type, v.num, 0.01, 1)
                -- tb.aortext_Num.color = _G.ColorTools.FormatColorByString(NumColor)
            end
        end
    end
end

function ArenaTopAwardView:OnDestroy()
    if self.closeCall then
        self.closeCall()
    end
end

---按钮点击事件在这里派发
function ArenaTopAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

return ArenaTopAwardView
