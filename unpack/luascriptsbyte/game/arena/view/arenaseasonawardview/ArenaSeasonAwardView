local descStr = _G.GetLangPackValue(90022100108)
--region 奖励item
local ArenaSeasonAwardItem = _G.BaseClass("ArenaRankAwardItem")

function ArenaSeasonAwardItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.itemList = {}
end
function ArenaSeasonAwardItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
    local ItemFactoryIns = _G.ItemFactory:GetInstance()
    for i = 1, #self.itemList do
        ItemFactoryIns:SetItemCard(self.itemList[i])
    end
    self.itemList = nil
end
---显示
---@param id number 奖励id
---@return 变量类型 中文描述
function ArenaSeasonAwardItem:Show(id)
    self.gameObject:SetActiveE(1)
    self:ShowDay(id)
end
function ArenaSeasonAwardItem:ShowDay(id)
    local cfg = _G.ConfigManager.arena_league_cfg[id]
    self.go_table.aortext_mScoreRank.text = string.format(descStr, cfg.min_score)
    if not _G.table.isEmptyOrNil(cfg.reward_season) then
        self:ShowAward(cfg.reward_season)
    end
end
---显示奖励
function ArenaSeasonAwardItem:ShowAward(award)
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    self.itemList = {}
    local insert = _G.table.insert
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                insert(self.itemList, item)
            end
        )
    end
end
--endregion

---@class ArenaRankAwardView : UIBaseView	中文描述
---@field public go_table ArenaRankAwardView_GoTable GoTable
local ArenaSeasonAwardView = _G.BaseClass("ArenaRankAwardView", _G.UIBaseView)

function ArenaSeasonAwardView:Awake()
    self.itemList = {}
    self.itemTransDic = {}
    self.awardList = {}
end

---界面的入口函数
function ArenaSeasonAwardView:OnCreate(parent)
    self.parent = parent
    self:ShowList()
    self:ShowMyRank()
end
function ArenaSeasonAwardView:Close()
    local ItemFactory = _G.ItemFactory
    for i = 1, #self.itemList do
        ItemFactory:GetInstance():SetItemCard(self.itemList[i])
    end
    for _, item in pairs(self.itemTransDic) do
        item:Dispose()
    end
    self.itemTransDic = nil
    _G.UIBaseView.Close(self)
end

function ArenaSeasonAwardView:ShowList()
    self.awardList = {}
    --镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34306
    --【客户端】普通竞技场-屏蔽积分奖励页签
    --local insert = _G.table.insert
    -- for id, value in pairs(_G.ConfigManager.arena_league_cfg) do
    --     if #value.reward_season > 0 then
    --         insert(self.awardList, id)
    --     end
    -- end
    -- _G.table.sort(
    --     self.awardList,
    --     function(a, b)
    --         return a > b
    --     end
    -- )
    self.go_table.scrollloopvectical_award:InitItemData(#self.awardList, _G.handler(self, self.RefreshItem))
end

function ArenaSeasonAwardView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = ArenaSeasonAwardItem.New(obj)
    end
    index = index + 1
    self.itemTransDic[instanceID]:Show(self.awardList[index])
end

function ArenaSeasonAwardView:ShowMyRank()
    local award = {}
    --我的积分
    local score = require("ArenaController"):GetInstance():GetScore()
    self.go_table.aortext_mNumber.text = score
    for _, value in pairs(_G.ConfigManager.arena_league_cfg) do
        if value.min_score <= score and value.max_score >= score then
            ---镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34306
            --【客户端】普通竞技场-屏蔽积分奖励页签
            --award = value.reward_season
            --100714 展示最低段位满足的积分对应离散表ID
            self.go_table.aortext_mScoreRank.text =
                string.format(
                descStr,
                value.min_score > 0 and value.min_score or _G.ConfigManager.discrete_cfg[100714][1][1]
            )
            break
        end
    end
    local ItemFactory = _G.ItemFactory
    self.itemList = {}
    for i = 1, #award do
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_mItemRoot,
            function(item)
                item:Show(award[i][1], nil, award[i][2])
                _G.table.insert(self.itemList, item)
            end
        )
    end
end

function ArenaSeasonAwardView:EscClose()
    if self.parent then
        self.parent.curView:Close()
        self.parent:Close()
    end
end

return ArenaSeasonAwardView
