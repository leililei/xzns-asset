function ArenaAwardPageView:ShowChoose()
    for i = 1, #self.choose do
        self.choose[i]:SetActiveE(i == self.curViewIndex and 1 or 0)
    end
end

function ArenaAwardPageView:OnViewOpen(name)
    if name ~= self.curOpenViewName then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    if self:IsNil() then
        return
    end
    self.onBtnTag = false
    self.curView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 10
    )
    self.curView.transform:SetParentE(self.go_table.trans_panel)
    self.curView.transform:SetLocalScaleToOne()
end

return ArenaAwardPageView
