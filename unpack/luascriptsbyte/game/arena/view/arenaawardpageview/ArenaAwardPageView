function ArenaAwardPageView:OnSeasonRankToggleClick()
    if self.curViewIndex == pageIndex.rank then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
    end
    self.curViewIndex = pageIndex.rank
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.ArenaSeasonRankAwardView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    self.curView = _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName, self).View
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.pageSwitchAuido)
end

function ArenaAwardPageView:OnRankToggleClick()
    if self.curViewIndex == pageIndex.day then
        self.onBtnTag = false
        return
    end
    if self.curView then
        self.curView:Close()
        self.curView = nil
    end
    self.curViewIndex = pageIndex.day
    self:ShowChoose()
    self.curOpenViewName = _G.ConfigManager.ui_cfg.ArenaRankAwardView.Name
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
    _G.UIManager:GetInstance():OpenWindow(self.curOpenViewName, self)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.pageSwitchAuido)
end

