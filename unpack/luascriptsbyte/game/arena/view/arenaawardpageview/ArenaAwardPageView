local pageIndex = {
    rank = 3,
    day = 2,
    season = 1
}
---@class ArenaAwardPageView : UIBaseView	中文描述
---@field public go_table ArenaAwardPageView_GoTable GoTable
local ArenaAwardPageView = _G.BaseClass("ArenaAwardPageView", _G.UIBaseView)

function ArenaAwardPageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---界面的入口函数
function ArenaAwardPageView:OnCreate()
    self.curView = nil
    self.curViewIndex = 0
    self.choose = {
        self.go_table.obj_choose1,
        self.go_table.obj_choose2,
        self.go_table.obj_choose3
    }
    self:OnSeasonRankToggleClick(true)
end

function ArenaAwardPageView:OnDestroy()
    self.curView = nil
    self.curViewIndex = nil
    self.onBtnTag = nil
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpen, self)
end

---按钮点击事件在这里派发
function ArenaAwardPageView:OnClickBtn(go)
    if self.onBtnTag then
        return
    end
    self.onBtnTag = true
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        self.curView:Close()
        self:Close()
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    elseif go == self.go_table.aorbtn_rank then
        ---镇魂街ZHJ-33365 【主任务】贪玩三测优化（7.10后）ZHJ-34306
        --【客户端】普通竞技场-屏蔽积分奖励页签
        --     self:OnSeasonToggleClick()
    elseif go == self.go_table.aorbtn_day then
        self:OnRankToggleClick()
    elseif go == self.go_table.aorbtn_season then
        self:OnSeasonRankToggleClick()
    end
end

