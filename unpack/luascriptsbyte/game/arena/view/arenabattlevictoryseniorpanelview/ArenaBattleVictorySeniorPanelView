local SettlementBaseView = require "SettlementBaseView"
---@class ArenaBattleVictorySeniorPanelView : UIBaseView	中文描述
---@field public go_table ArenaBattleVictorySeniorPanelView_GoTable GoTable
local ArenaBattleVictorySeniorPanelView = _G.BaseClass("ArenaBattleVictorySeniorPanelView", SettlementBaseView)
local CS = _G.CS
local typeof = _G.typeof
local imageSource = {
    win = "ui-zd-icon_sheng",
    fail = "ui-zd-icon_bai"
}
----界面的入口函数
function ArenaBattleVictorySeniorPanelView:OnCreateChild(selfplayer, otherPlayer, totalscore, damage, isRecord, fightArg)
    self.anim = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.Changci = {
        [1] = _G.GetAutoGoTable(self.go_table.obj_changci1, _G.handlerbind(self, self.OnClickStaic, 1)),
        [2] = _G.GetAutoGoTable(self.go_table.obj_changci2, _G.handlerbind(self, self.OnClickStaic, 2)),
        [3] = _G.GetAutoGoTable(self.go_table.obj_changci3, _G.handlerbind(self, self.OnClickStaic, 3))
    }
    self.damage = damage
    self.playerInfo = selfplayer
    self.otherPlayer = otherPlayer
    self.totalScore = totalscore
    self.fight_arg = fightArg
    self:SetScore(totalscore)
    self.isWin = self.myResoult > self.otherResoult
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorimage_JingDu,
        not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(95)
    )
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(95) then
        self.go_table.aortext_JingDu.text =
            "(" ..
            _G.ConfigManager.afk_cfg[require("AfkModel"):GetInstance():GetCurSection()].number ..
                "/" ..
                    _G.ConfigManager.afk_cfg[_G.ConfigManager.function_open_cfg[95].condition_type[1][2]].number .. ")"

        self.go_table.aortext_JingDuMiaoSu.text =
            _G.ConfigManager.language_package_cfg[_G.ConfigManager.function_open_cfg[95].function_preview[1]]
    end
    if self.isWin then
        self.go_table.obj_win:SetActiveE(1)
    else
        self.go_table.obj_fail:SetActiveE(1)
        self.go_table.aorimage_JingDu:SetActiveE(0)
    end
    if self.isWin then
        self.anim:Play("a_ArenaBattleVictorySeniorPanelView_shengli")
    else
        self.anim:Play("a_ArenaBattleVictorySeniorPanelView_shibai")
    end
    self:SetPlayer(selfplayer, otherPlayer)
    self:SetRes(selfplayer, otherPlayer)
    self:UpdateData(damage)
    self.go_table.aortext_tips:DOFade(0, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
    if view then
        view:SetChatRootPos({x = 45, y = 43})
    end
    self.isRecord = isRecord
end

---按钮点击事件在这里派发
function ArenaBattleVictorySeniorPanelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_exit then
        self:CloseCall(0)
    elseif go == self.go_table.aorbtn_DamageStatistics then
        --打开伤害统计界面
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaEmbattleStatisticsPVEView.Name,
            self.damage,
            self.isWin,
            nil,
            self.playerInfo,
            self.otherPlayer,
            self.isRecord
        )
    end
end

function ArenaBattleVictorySeniorPanelView:SetPlayer(selfplayer, otherPlayer)
    local node = _G.GetAutoGoTable(self.go_table.obj_mInfo)
    self:SetPlayerInfo(node, selfplayer, self.myResoult)
    local node1 = _G.GetAutoGoTable(self.go_table.obj_eInfo)
    self:SetPlayerInfo(node1, otherPlayer, self.otherResoult)
end

--设置玩家信息
function ArenaBattleVictorySeniorPanelView:SetScore(totalscore)
    self.myResoult = 0
    self.otherResoult = 0
    for i = 1, #totalscore do
        if totalscore[i] then
            self.myResoult = self.myResoult + 1
            self.Changci[i].aorimage_result1.SpriteName = imageSource.win
            self.Changci[i].aorimage_result2.SpriteName = imageSource.fail
        else
            self.Changci[i].aorimage_result1.SpriteName = imageSource.fail
            self.Changci[i].aorimage_result2.SpriteName = imageSource.win
            self.otherResoult = self.otherResoult + 1
        end
    end
end

--设置战斗结果
function ArenaBattleVictorySeniorPanelView:SetWintable()
    local array = {}
    for i = 1, #self.totalScore do
        if self.totalScore[i] then
            _G.table.insert(array, 0)
        else
            _G.table.insert(array, 1)
        end
    end
    return array
end

--设置player信息
function ArenaBattleVictorySeniorPanelView:SetPlayerInfo(node, player, score)
    local cfgHead = _G.ConfigManager.player_portrait_cfg
    local cfgframe = _G.ConfigManager.player_frame_cfg
    node.aortext_name.text = player.name
    _G.UIUtils.SetAorImageByPath(node.aorimage_head, cfgHead[player.style].portrait1)
    node.aortext_level.text = player.level
    -- _G.UIUtils.SetAorImageByPath(node.aorimage_color, cfgframe[player.frame].frame)
    local cfg = require("ArenaController"):GetInstance():CalculateSeniorLeagueByRank(player.rank)
    node.aorrawimage_rankIcon:LoadImage(cfg.icon)
    --node.aorimage_rankmingci.SpriteName = cfg.art
    node.aortext_score.text = score
    local str = _G.LangUtil.GetLangPackValue(cfg.name)
    if require("ArenaController"):GetInstance():CheckKing(cfg.level) then
        str = str .. "·" .. player.rank
    end
    node.aortext_rank.text = str
