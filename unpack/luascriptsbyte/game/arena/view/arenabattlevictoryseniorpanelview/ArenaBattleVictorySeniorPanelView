    --             garray[v.sid] = v
    --         end
    --     end
    --     player.garray = garray
    -- end
end

--设置res
function ArenaBattleVictorySeniorPanelView:SetRes(selfplayer, otherPlayer)
    local num = 0
    if self.isWin then
        local ArenaControllerIns = require("ArenaController"):GetInstance()
        num =
            ArenaControllerIns:CalculateSeniorLeagueByRank(selfplayer.rank).efficiency -
            ArenaControllerIns:CalculateSeniorLeagueByRank(otherPlayer.rank).efficiency
        if num < 0 then
            num = 0
        end
    end
    self.go_table.aortext_res.text = _G.LangUtil.GetLangPackValue(90022100095, num)
end

function ArenaBattleVictorySeniorPanelView:OnClickStaic(go, isOn, index)
    if _G.table.isEmptyOrNil(self.PveData) then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        self:SetWintable(),
        nil,
        self.playerInfo,
        self.otherPlayer,
        index,
        self.isRecord,
        self.fight_arg,
        nil,
        self.playerInfo.re_uid,
        3
    )
end

---@param data table 伤害数据
function ArenaBattleVictorySeniorPanelView:UpdateData(data)
    if data then
        self.maxCount = _G.table.count(data.FighterInfo)
    else
        ---空阵容时data为nil
        self.maxCount = 0
    end
    self.PveData = self:InitData(data)
end

function ArenaBattleVictorySeniorPanelView:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #temp.statisticsData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

function ArenaBattleVictorySeniorPanelView:CloseCall(id)
    if self.isClose then
        return
    end
    require("PowerToTheTopModel"):GetInstance():Top_Rank()
    self.isClose = true
    self:DisposeReource()
    self:Close()
    if self.callback then
        self.callback(id)
        self.callback = nil
    end
    require("PowerToTheTopModel"):GetInstance():Top_Rank()
    if not self.isRecord then
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    end
end

return ArenaBattleVictorySeniorPanelView
