    local state = false
    if data.ack == 1 then
        state = true
        self.stageAward[self.curChooseRankAwardID] = true
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        require("RedPointManager"):GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg.ArenaAwardSenior.id,
            self.curChooseRankAwardID
        )
    end
    if self.onRankAwardCall then
        self.onRankAwardCall(state, data)
    end
    self.curChooseRankAwardID = 0
    self.onRankAwardCall = nil
end

