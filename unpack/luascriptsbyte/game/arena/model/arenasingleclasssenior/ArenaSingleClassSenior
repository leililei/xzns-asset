function ArenaSingleClassSenior:OpenEmbattleAttack(index, call)
    self.curGetEnemyCardArrayindex = index
    local embattleType = _G.EmbattleType
    self:GetEnemyEmbattleArray(
        self.enemyList[index].uid,
        function(data)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ArenaEmbattleSeniorView.Name,
                {
                    embattleType.arenaSeniorAttack1,
                    embattleType.arenaSeniorAttack2,
                    embattleType.arenaSeniorAttack3
                },
                _G.EmbattleControllerItemType.arenaSeniorAttack,
                call,
                function()
                    local skip =
                        _G.PlayerPrefsManager.GetInt(
                        tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. 3
                    ) or 0
                    if self:CheckEnemyEmpty() then
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
                        skip = 1
                    end
                    if skip == 1 then
                        if call then
                            call()
                        end
                    end
                    local port =
                        ArenaNet:GetInstance():FightSenior(
                        self.enemyList[index].uid,
                        _G.handlerbind(self, self.OnFightCall, skip)
                    )
                    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
                end,
                self.enemyList[index],
                _G.ConfigManager.ui_cfg.ArenaChallengeTeamAttackView.Name
            )
        end,
