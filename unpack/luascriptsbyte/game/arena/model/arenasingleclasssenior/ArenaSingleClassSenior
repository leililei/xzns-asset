--领奖
function ArenaSingleClassSenior:GetAward(callback)
    if self.curAwardCount <= 0 then
        callback()
        return
    end
    ArenaNet:GetInstance():GetBoxAwardSenior(
        function(msg)
            if msg.ack ~= 1 then
                callback(self.resCount)
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.resCount = 0
            self.curAwardCount = 0
            self.awardTimeStamp = _G.TimeUtil.GetServerUnixTime()
            callback(msg)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaSeniorBoxAward.id)
        end
    )
end
