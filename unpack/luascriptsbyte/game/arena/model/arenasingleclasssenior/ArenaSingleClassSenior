  required uint32 ticket=8;//挑战券已经购买的次数（每日刷新置0）
  required uint32 refresh_times =9;//今日已刷新对手次数
  required uint32 max_rank = 10;//历史最高排名
  repeated uint32 stage_award = 11;//段位奖励领取情况  整数列表，存段位sid[stageSid...]
]]
---@param data arena_senior.s2c_arena_senior_info
function ArenaSingleClassSenior:OnParseData(data)
    self.curArenaState = data.status
    self.curSeason = data.current_season
    self.nextOpenTime = data.next_open_time
    self.closeCountdown = data.season_closing_countdown
    if self.nextTimer then
        self.nextTimer:Stop()
        self.nextTimer = nil
    end
    if self.curArenaState == ArenaManager.State.open then
        self.curRank = data.rank --20
        self.freshTime = data.refresh_time and data.refresh_time - _G.TimeUtil.GetServerUnixTime() or 0 --1642487874
        if self.freshTime < 0 then
            self.freshTime = 0
        end
        self.freeChallengeTimes = data.fight_times --10
        self.isNewReport = self.isNewReport or (data.attacked or false)
        self.awardTime = _G.TimeUtil.GetServerUnixTime() - data.time --1642487874
        self.awardTimeStamp = data.time
        self.resCount = data.reward
        self.buyTicketTimes = data.ticket + 1
        if self.buyTicketTimes > #self.ticketPrice then
            self.buyTicketTimes = #self.ticketPrice
        end
        self.maxRank = data.max_rank or self.curRank
        self.refreshEnemyTimes = data.refresh_times or 0
        self.stageAward = {}
        if data.stage_award then
            for i = 1, #data.stage_award do
                self.stageAward[data.stage_award[i]] = true
            end
        end
        self:CalculateAwardCount()
        self.nextTimer = _G.TimerManager:GetInstance():GetTimer(
            self.closeCountdown - _G.TimeUtil.GetServerUnixTime(),
            self.OnSettlementStart,
            self,
            true)
        self.nextTimer:Start()
    else
        self.nextTimer = _G.TimerManager:GetInstance():GetTimer(
            self.nextOpenTime - _G.TimeUtil.GetServerUnixTime(),
            self.OnSettlementEnd,
            self,
            true)
        self.nextTimer:Start()
    end
    if self.sixUpdateTimer then
        self.sixUpdateTimer:Stop()
        self.sixUpdateTimer = nil
    end
    self.sixUpdateTimer =
        _G.TimerManager:GetInstance():GetTimer(_G.TimeUtil.GetSixClockTimer(), self.OnInitInfo, self, true)
    self.sixUpdateTimer:Start()
    if self.settleEnd then
        self.settleEnd = false
        _G.Events:GetInstance():Broadcast(_G.eArena.SeniorSettlement, 2)
        self:RefreshAllRedPoint()
    end
    if self.onDataUpdateCall then
        self.onDataUpdateCall()
    end
end
---解析挑战玩家数据
--[[
  required uint32 type = 1;// 1 npc，2为玩家
  required uint64 uid = 2;//
  required uint32 league = 3;// 段位sid
  required string name = 4;// 名字
  required uint32 style = 5;//头像
  required uint32 frame = 6;//头像框
  required uint32 lv = 7;//等级
  required uint32 power = 8;// 战斗力
  ]]
function ArenaSingleClassSenior:OnParseEnemyData(data)
    if data.ack ~= 1 then
        return
    end
    self.enemyList = {{}, {}, {}, {}}
    local enemy
    for i = 1, #data.enemy do
        enemy = data.enemy[i]
        self.enemyList[i].uid = enemy.uid
        self.enemyList[i].type = enemy.type
        self.enemyList[i].rank = enemy.rank
        if enemy.type == 1 then
            self.enemyList[i].name = _G.GetLangPackValue(enemy.name)
        else
            self.enemyList[i].name = enemy.name
        end
        self.enemyList[i].style = enemy.style
        self.enemyList[i].frame = enemy.frame
        self.enemyList[i].level = enemy.lv
        self.enemyList[i].power = enemy.power
    end
end
---解析玩家卡牌数据
---@param index number 序列号
---@param data table 数据
--[[
  optional uint32 sid = 1;//卡牌sid
  optional uint32 level = 2;//等级
  optional uint32 star = 3;//星级
  optional uint32 soul_index = 4;//魂链等级
  ]]
function ArenaSingleClassSenior:OnParseEnemyCard(index, data)
    self.enemyList[index].garray = {false, false, false}
    self.enemyList[index].combSkill = {false, false, false}
    local card
    for i = 1, #data.team do
        local items = {
            {sid = 0, level = 0, star = 0, soulLV = 0, power = 0},
            {sid = 0, level = 0, star = 0, soulLV = 0, power = 0},
            {sid = 0, level = 0, star = 0, soulLV = 0, power = 0},
            {sid = 0, level = 0, star = 0, soulLV = 0, power = 0},
            {sid = 0, level = 0, star = 0, soulLV = 0, power = 0}
        }
        for j = 1, #items do
            card = data.team[i].cards[j]
            items[j].sid = card.sid
            items[j].level = card.level
            items[j].star = card.star
            items[j].soulLV = card.soul_lv
            items[j].power = card.power
            items[j].soulState = card.soul_state
            items[j].talents = card.born_skill_num
        end
        self.enemyList[index].garray[data.team[i].index] = items
        local skills = data.team[i].combine or {0, 0, 0}
        self.enemyList[index].combSkill[data.team[i].index] = skills
    end
end
