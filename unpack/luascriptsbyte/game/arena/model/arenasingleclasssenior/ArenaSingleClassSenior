function ArenaSingleClassSenior:OnFightCall(msg, skip)
    if msg.ack ~= 1 then
        local openviewcall
        openviewcall = function(self, name)
            if name == _G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.Name)
            elseif name == _G.ConfigManager.ui_cfg.ArenaChallengeSeniorView.Name then
                _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, openviewcall, self)
                if msg.ack == 540101 then
                    --对手段位变化
                    _G.PopWindowManager:GetInstance():ShowAllTips(540301)
                end
            end
        end
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, openviewcall, self)
