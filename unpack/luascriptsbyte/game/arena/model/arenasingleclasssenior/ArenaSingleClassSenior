    end
    -- local skip = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. 3) or 0
    -- if self:CheckEnemyEmpty() then
    --     skip = 1
