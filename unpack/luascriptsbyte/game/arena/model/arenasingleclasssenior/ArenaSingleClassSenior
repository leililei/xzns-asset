    if self.freeChallengeTimes <= 0 then
        self:CastFightTicket()
    else
        --TODO:刷新挑战次数红点
        self.freeChallengeTimes = self.freeChallengeTimes - 1
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaSeniorChallenge.id)
    end
    local win = 0
    for i = 1, #msg.winner do
        if msg.winner[i] then
