---赛季是否开启（未在结算中）
function ArenaSingleClassSenior:CheckSeasonIsOpen()
    return self.curArenaState == ArenaManager.State.open
end

function ArenaSingleClassSenior:OnSettlementStart()
    self.curRank = nil
    self.freeChallengeTimes = nil
    self.isNewReport = nil
    self.awardTime = nil
    self.awardTimeStamp = nil
    self.resCount = nil
    self.buyTicketTimes = nil
    self.maxRank = nil
    self.refreshEnemyTimes = nil
    self.stageAward = nil
    self.curArenaState = ArenaManager.State.close
    _G.Events:GetInstance():Broadcast(_G.eArena.SeniorSettlement, 1)
    self:RefreshAllRedPoint()
end

function ArenaSingleClassSenior:OnSettlementEnd()
    self:OnInitInfo()
    self.settleEnd = true
end

---获取赛季
---@return number 当前赛季
function ArenaSingleClassSenior:GetSeason()
    return self.curSeason or 1
end

---获取赛季剩余时间
---@return number 剩余时间
function ArenaSingleClassSenior:GetSeasonCountDown()
    local time = self.closeCountdown - _G.TimeUtil.GetServerUnixTime()
    if time < 0 then
        time = 0
    end
    return time
end

---获取赛季结算剩余时间
---@return number 剩余时间
function ArenaSingleClassSenior:GetSeasonSettlementCountDown()
    local time = self.nextOpenTime - _G.TimeUtil.GetServerUnixTime()
    if time < 0 then
        time = 0
    end
    return time
end

function ArenaSingleClassSenior:RefreshAllRedPoint()
    local RedPointManager = require("RedPointManager"):GetInstance()
    RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaSeniorShop.id)
    RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaSeniorChallenge.id)
    RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaSeniorBoxAward.id)
    RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaEmbattleSenior.id)
    RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaReportSenior.id)
    RedPointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArenaAwardSenior.id)
    RedPointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SeniorArena.id)
end

---检测对手是否存在空阵容
function ArenaSingleClassSenior:CheckEnemyEmpty()
    local count = #self.enemyList[self.curGetEnemyCardArrayindex].garray
    for _, v in pairs(self.enemyList[self.curGetEnemyCardArrayindex].garray) do
        for _, card in pairs(v) do
            if card.sid ~= 0 then
                count = count - 1
                break
            end
        end
    end
    return count > 0
end

function ArenaSingleClassSenior:Dispose()
    if self.nextTimer then
        self.nextTimer:Stop()
        self.nextTimer = nil
    end
    if self.sixUpdateTimer then
        self.sixUpdateTimer:Stop()
        self.sixUpdateTimer = nil
    end
end

return ArenaSingleClassSenior
