    if not data.reports then
        self.reportList = {}
        return
    end
    local GetLangPackValue = _G.LangUtil.GetLangPackValue
    local reports = data.reports or {}
    for i = 1, #reports do
        reports[i].target_role_name =
            reports[i].target_type == 2 and reports[i].target_role_name or GetLangPackValue(reports[i].target_role_name)
    end
    self.reportList = data.reports
