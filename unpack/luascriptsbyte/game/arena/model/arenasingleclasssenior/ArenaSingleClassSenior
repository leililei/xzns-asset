        info.frame = PlayerModel:GetCurFrame()
        info.name = PlayerModel:GetName()
        info.style = PlayerModel:GetRoleStyle()
        info.level = PlayerModel:GetLevel()
        info.re_uid = msg.re_uid
        if win >= 2 and info.rank > enemy.rank then
            local rank = info.rank
            info.rank = enemy.rank
            enemy.rank = rank
        end
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        _G.UIManager:GetInstance():OpenWindow(
            view,
            function()
                -- body
            end,
            info,
            enemy,
            msg.winner,
            _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg),
            true,
            msg.fight_arg
        )
        if self:GetCurArenaState() == 1 then
            self:ClearReport()
            self:InitInfo(
                function()
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.ArenaAwardSenior.id
                    )
                    _G.Events:GetInstance():Broadcast(_G.eArena.RefreshSeniorView)
                end,
                true
            )
        end
        self:RefreshEnemy()
    else
        _G.BattleManager:GetInstance():EnterFight(
            _G.BattleControllerType.arenaSenior,
            msg.winner,
            self.enemyList[self.curGetEnemyCardArrayindex],
            self.curRank,
            msg.re_uid
        )
    end

    if win > 1 then
        --胜利才刷新
        self:RefreshEnemy()
    end
end
---排名变化推送
---@param sid number 新段位
function ArenaSingleClassSenior:OnRankChangedCall(sid)
    self:InitInfo(
        function()
            self.enemyListTemp = self.enemyList
            self.enemyList = nil
            if self.onLeagueChangeCall and _G.table.count(self.onLeagueChangeCall) > 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    540301,
                    nil,
                    function()
                        for _, call in pairs(self.onLeagueChangeCall) do
                            call()
                        end
                    end
                )
            end
        end,
        true
    )
end
---当防守布阵界面打开
function ArenaSingleClassSenior:OnDefenceEmbattleOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnDefenceEmbattleOpened, self)
        --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name)
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    end
end
function ArenaSingleClassSenior:OnDefenceEmbattleClosed()
    local RedPointManager = require("RedPointManager"):GetInstance()
    local embattleType = _G.EmbattleType
    local id = _G.ConfigManager.redpoint_cfg.ArenaEmbattleSenior.id
    --获取奖励默认刷新青铜段位奖励
    RedPointManager:RefreshNode(id, embattleType.arenaSeniorDefence1)
    RedPointManager:RefreshNode(id, embattleType.arenaSeniorDefence2)
    RedPointManager:RefreshNode(id, embattleType.arenaSeniorDefence3)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelSeniorView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end
