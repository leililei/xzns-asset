local awardAddCount = 0
---计算奖励数量
function ArenaSingleClassSenior:CalculateAwardCount()
    if nil == self.resCount or nil == self.maxAwardCount then
        return 0
    end
    if self.resCount >= self.maxAwardCount then
        self.resCount = self.maxAwardCount
        self.curAwardCount = self.resCount
        return self.resCount
    end
    self.awardTime = _G.TimeUtil.GetServerUnixTime() - self.awardTimeStamp
    local cfg = ArenaController:GetInstance():CalculateSeniorLeagueByRank(self.curRank)
    self.curAwardCount = _G.Mathf.RoundToInt(cfg.efficiency * self.awardTime / 3600) + self.resCount
    if self.curAwardCount > self.maxAwardCount then
        return self.maxAwardCount
    end
    return self.curAwardCount
end
