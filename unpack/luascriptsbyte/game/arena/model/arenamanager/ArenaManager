function ArenaManager:GetArenaInfo()
    local info = {}
    for i = 1, #_G.ConfigManager.arena_info_cfg do
        _G.table.insert(
            info,
            {
                id = i,
                isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
                    _G.ConfigManager.arena_info_cfg[i].function_open
                )
            }
        )
    end
    return info
end
