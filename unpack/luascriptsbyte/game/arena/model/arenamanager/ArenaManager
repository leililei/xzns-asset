local base = require "GameDataModelBase"
---@class ArenaManager:GameDataModelBase	竞技场数据管理类
---@field GetInstance fun():ArenaManager
local ArenaManager = _G.BaseClass("ArenaManager", base)

---@class ArenaManager.State 竞技场状态
---@field close number 关闭(功能未开放)
---@field open number 打开(正常开放)
---@field settle number 结算(处于赛季休赛期，发放奖励，暂停挑战)
ArenaManager.State = {
    settle = 0,
    open = 1,
    close = 2
}

local arenaClass = {
    "ArenaSingleClassNormal",
    -- "ArenaSingleClassSenior",
    false,
    "ArenaSingleClassFair"
    -- "ArenaSingleClassElement"
}
ArenaManager.arenaType = {
    normal = 1,
    senior = 2,
    fair = 3,
    element = 4
}
---类的构造函数
function ArenaManager:__init()
    self.arenaClass = {}
    self.functionOpenDic = {}
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.attacked.Cmd, self.OnReportCall, self)
end

---类的析构函数
function ArenaManager:Dispose()
    if self.updateTimer then
        self.updateTimer:Stop()
    end
    self.updateTimer = nil
    for _, arena in pairs(self.arenaClass) do
        arena:Dispose()
    end
    self.arenaClass = nil
    self.functionOpenDic = nil
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.attacked.Cmd, self.OnReportCall, self)
end

function ArenaManager:GetDataFormServer()
    local index = 0
    local function callback(success, sid)
        if not success then
            self.functionOpenDic[_G.ConfigManager.arena_info_cfg[sid].function_open] = sid
        end
        index = index - 1
        if index <= 0 then
            self:ParseData()
        end
    end
    for sid, cfg in pairs(_G.ConfigManager.arena_info_cfg) do
        if not self.arenaClass[sid] then
            if arenaClass[sid] then
                index = index + 1
                self.arenaClass[sid] = require(arenaClass[sid]).New(sid, cfg)
                if sid ~= ArenaManager.arenaType.fair then
                    self.arenaClass[sid]:InitInfo(callback)
                else
                    index = index - 1
                end
            end
        end
        --self.arenaClass[sid]:InitInfo(callback)
    end
    require("ArenaController"):GetInstance():ResetLoginFirstTable()
    ---每次登录刷新高级竞技场红点
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RedPointSeniorChallenge", 1)
end

function ArenaManager:ParseData()
    base.ParseData(self)
    self.updateTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.updateTimer:Start()
    if not _G.IsNil(self.functionOpenDic) then
        _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
    end
end

function ArenaManager:OnFunctionOpenCall(id)
    for funcid, arenasid in pairs(self.functionOpenDic) do
        if id == funcid then
            self.arenaClass[arenasid]:InitInfo(
                _G.handler(self.arenaClass[arenasid], self.arenaClass[arenasid].OnRefreshRedpoint)
            )
            self.functionOpenDic[funcid] = nil
            if _G.IsNil(self.functionOpenDic) then
                _G.Events:GetInstance():RemoveListener(
                    _G.eFunctionsStatus.OpenCfgFunctionId,
                    self.OnFunctionOpenCall,
                    self
                )
            end
            break
        end
    end
end

---重连成功调用
---@param endcall function 完成回调
function ArenaManager:ReConnect(endcall)
    self.onReConnectCall = endcall
    self.onReConnectCount = 0
    for _, _ in pairs(self.arenaClass) do
        self.onReConnectCount = self.onReConnectCount + 1
    end
    local handler = _G.handler(self, self.OnArenaReConnect)
    local callTag = false
    for sid, arena in pairs(self.arenaClass) do
        if self.functionOpenDic then
            callTag = false
            for foid, arenasid in pairs(self.functionOpenDic) do
                if arenasid == sid then
                    self:OnArenaReConnect()
                    callTag = true
                    break
                end
            end
        end
        if not callTag then
            arena:ReConnect(handler)
        end
    end
end
function ArenaManager:UpdateTime()
    for _, value in pairs(self.arenaClass) do
        value:UpdateTime()
    end
end
---回放战报
function ArenaManager:ReplayReport(sid, uid, callback)
    self.arenaClass[sid]:ReplayReport(uid, callback)
end
---当有新的战报推送
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function ArenaManager:OnReportCall(data)
    self:SetNewReport(data.sid, true)
    self.arenaClass[data.sid]:OnAttack()
end
function ArenaManager:OnArenaReConnect()
    self.onReConnectCount = self.onReConnectCount - 1
    if self.onReConnectCount <= 0 then
        if self.onReConnectCall then
            self.onReConnectCall(self.__cname)
        end
    end
end
