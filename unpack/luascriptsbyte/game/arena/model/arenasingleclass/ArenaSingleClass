--region 数据解析
---解析初始化数据数据
---@param data table 初始化数据
function ArenaSingleClass:ParseData(data)
    self:OnParseData(data)
    self.isInitData = true
    if self.InitInfoCall then
        self.InitInfoCall(true, self.sid)
        self.InitInfoCall = nil
    end
    if self.freshTime > 0 and not self.freshTimer then
        self.freshTimer = _G.TimerManager:GetInstance():GetTimer(1, self.HandleFreshTime, self)
        self.freshTimer:Start()
    end
end
---解析挑战敌人组数据
---@param data table 数据
function ArenaSingleClass:ParseEnemyData(data)
    self:OnParseEnemyData(data)
    if data.ack == 1 and self.enemyInfoCallback then
        self.enemyInfoCallback(self.enemyList)
        self.enemyInfoCallback = nil
    end
    if self.freshTime > 0 and not self.freshTimer then
        self.freshTimer = _G.TimerManager:GetInstance():GetTimer(1, self.HandleFreshTime, self)
        self.freshTimer:Start()
    end
end
---解析挑战敌人布阵数据
---@param data table 数据
function ArenaSingleClass:ParseEnemyArray(data)
    self:OnParseEnemyCard(self.curGetEnemyCardArrayindex, data)
    if self.getEnemyArrayCallback then
        self.getEnemyArrayCallback(self.enemyList[self.curGetEnemyCardArrayindex].garray)
        self.getEnemyArrayCallback = nil
    end
end
---解析排行榜数据
---@param data table 数据
function ArenaSingleClass:ParseRankList(data)
    self:OnParseRankList(data)
    if self.onRankListCall then
        self.onRankListCall(self.rankList)
        self.onRankListCall = nil
    end
end
---更新 刷新对手 倒计时
function ArenaSingleClass:HandleFreshTime(elapsed)
    self.freshTime = self.freshTime - elapsed
    if self.freshTimeCall then
        self.freshTimeCall(Mathf.RoundToInt( self.freshTime))
    end
    if self.freshTime <= 0 then
        if self.freshTimer then
            self.freshTimer:Stop()
            self.freshTimer = nil
        end
        self.freshTimeCall = nil
    end
end
---解析战报数据
---@param data table 战报数据
function ArenaSingleClass:ParseBattleReport(data)
    self:OnParseReport(data)
    if self.getReportCallback then
        self.getReportCallback(self.reportList)
    end
end
