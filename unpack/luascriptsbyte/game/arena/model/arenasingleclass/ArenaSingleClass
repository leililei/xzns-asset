local ArenaManager = require "ArenaManager"
---@class ArenaSingleClass	竞技场实体类基类
---@field sid number 竞技场sid
---@field freshTime number 刷新对手倒计时
---@field rankList table 排行榜
---@field curArenaState ArenaManager.State 竞技场当前状态
---@field isInitData boolean 是否初始化数据
local ArenaSingleClass = _G.BaseClass("ArenaSingleClass", _G.LogicClass)

function ArenaSingleClass:__init(sid, cfg)
    self.sid = sid
    self.freshTime = 0
    self.rankList = {}
    self.curRankPage = 1
    self.cfg = cfg
    self.refreshDataCall = nil
    self.isInitData = false
    self.isNewReport = false
    self.curArenaState = ArenaManager.State.close
    self.refreshEnemyTimes = 0
end

function ArenaSingleClass:Dispose()
    self.sid = nil
    self.freshTime = nil
    self.rankList = nil
    self.curRankPage = nil
    self.cfg = nil
    self.refreshDataCall = nil
    self.isInitData = nil
    self.isNewReport = nil
    self.curArenaState = nil
    self.freshTimeCall = nil
    if self.freshTimer then
        self.freshTimer:Stop()
        self.freshTimer = nil
    end
    self.reportList = nil
    self.refreshEnemyTimes = nil
end
--region 对外接口

--region 功能接口
---初始化数据
---@param callback function 初始化完成回调
---@param force boolean 是否强制刷新
function ArenaSingleClass:InitInfo(callback, force)
    if self.isInitData and not force then
        if callback then
            callback(true, self.sid)
        end
        return
    end
    if self:CheckFunctionIsUnlock() then
        self.InitInfoCall = callback or self.InitInfoCall
        self:OnInitInfo()
    else
        if callback then
            callback(false, self.sid)
        end
    end
end

function ArenaSingleClass:CheckFunctionIsUnlock()
    return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
end

---获取对手信息
---@param callback function 数据获取回调(因为是异步请求,所以不直接返回)
---@param force boolean 是否强制获取
function ArenaSingleClass:GetEnemyInfo(callback, force)
    if not force then
        if self.enemyList and #self.enemyList > 0 then
            callback(_G.DeepCopy(self.enemyList))
            return
        end
    end
    self.enemyInfoCallback = callback
    self:OnInitEnemyData()
end
---刷新对手信息
---@param callback function 数据获取回调
---@param freshTimeCall function 刷新时间回调
function ArenaSingleClass:RefreshEnemy(callback, freshTimeCall)
    if self.freshTime > 0 then
        return
    end
    if self.cfg.renovate_time > 0 and self.refreshEnemyTimes >= self.cfg.renovate_time then
        --TODO：刷新次数上限
        return
    end
    self.refreshEnemyTimes = self.refreshEnemyTimes + 1
    self.enemyInfoCallback = callback
    self.freshTimeCall = freshTimeCall
    self.freshTime = self.cfg.refresh_cd
    if self.freshTimeCall then
        self.freshTimeCall(self.freshTime)
    end
    self:OnRefreshEnemyData()
end
---设置刷新时间倒计时回调监听
---@param call function 回调方法
function ArenaSingleClass:SetFreshTimeCall(call)
    self.freshTimeCall = call
    if call then
        call(self.freshTime)
    end
end
--获取对手队伍信息
---@param uid number 玩家uid
---@param callback function 数据获取回调(因为是异步请求,所以不直接返回)
---@param force boolean 强制刷新
function ArenaSingleClass:GetEnemyEmbattleArray(uid, callback, force)
    self.curGetEnemyCardArrayindex = 0
    for i = 1, #self.enemyList do
        if self.enemyList[i].uid == uid then
            self.curGetEnemyCardArrayindex = i
            if (not force or self.enemyList[i].mType == 1) and self.enemyList[i].garray then
                callback(self.enemyList[i].garray)
                return
            end
            break
        end
    end
    self.getEnemyArrayCallback = callback
    self:OnInitEnemyArray(uid)
end
---获取排行榜数据
---@param callback function 数据获取回调(因为是异步请求,所以不直接返回)
function ArenaSingleClass:GetRankList(callback)
    self.onRankListCall = callback
    self:OnInitRankList()
end
---刷新倒计时
function ArenaSingleClass:UpdateTime()
end
---获取战报
---@param callback function 数据获取回调(因为是异步请求,所以不直接返回)
function ArenaSingleClass:GetBattleReport(callback)
    if self.reportList and #self.reportList > 0 then
        callback(self.reportList)
        return
    end
    self.getReportCallback = callback
    self:OnInitReportList()
end
---设置新战报状态
---@param state boolean 是否有新战报
function ArenaSingleClass:SetNewReport(state)
    if self.isNewReport ~= state then
        self.isNewReport = state
        if state then
            self.reportList = nil
        end
        self:OnRefreshReportRedPoint()
    end
end
---获取是否有新的战报
---@return boolean 是否有新的战报
function ArenaSingleClass:GetNewReport()
    return self.isNewReport
end
---清理战报
function ArenaSingleClass:ClearReport()
    self.reportList = nil
end
---挑战敌人
---@param uid number 敌人UID
---@param call function 挑战回调
---@return 变量类型 中文描述
function ArenaSingleClass:ChallengeEnemy(uid, call)
end
