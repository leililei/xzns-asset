---获取敌方基本数据
---@param uid number 敌方uid
---@return table 基本数据
function ArenaSingleClassElement:GetEnemyDataByUid(uid)
    if not self.enemyList or #self.enemyList <= 0 then
        return nil
    end
    for i = 1, #self.enemyList do
        if self.enemyList[i].uid == uid then
            return _G.DeepCopy(self.enemyList[i])
        end
    end
    return nil
end

