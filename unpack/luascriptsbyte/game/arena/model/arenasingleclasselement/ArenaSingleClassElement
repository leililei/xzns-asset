        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnTipsViewClosed, self)
        --_G.PopWindowManager:GetInstance():ShowAllTips(300301)
    end
end
function ArenaSingleClassElement:OnTipsViewClosed()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnTipsViewClosed, self)
    local ArenaControllerIns = require("ArenaController"):GetInstance()
    local uimanager = _G.UIManager:GetInstance()
    ArenaControllerIns:CloseReportPanel(self.sid)
    if self.openEmbattleState then
        require("EmbattleController"):GetInstance():CloseEmbattle()
    end
    local ui_cfg = _G.ConfigManager.ui_cfg
    uimanager:CloseWindow(ui_cfg.ArenaElementMainPanelView.Name)
    uimanager:CloseWindow(ui_cfg.ArenaElementAwardPageView.Name)
    uimanager:CloseWindow(ui_cfg.ArenaElementChallengeView.Name)
