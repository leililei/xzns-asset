   ]]
---@param data table 数据
function ArenaSingleClassElement:OnParseRankList(data)
    self.rankList = data.arenas
    local count = #self.rankList
    local insert = _G.table.insert
    for i = 1, count do
        self.rankList[i].rank = i
        if self.rankList[i].type == 1 then
            self.rankList[i].name = _G.LangUtil.GetLangPackValue(self.rankList[i].name)
        end
    end
end
