---领取胜场奖励
---@param win_num number[] 胜点
---@param callback function 领取完回调(boolean true 则成功 并返回奖励 false 则失败 并返回错误代码)
function ArenaSingleClassElement:GetAwardByWin(win_num, callback)
    ArenaNet:GetInstance():GetBoxAwardElement(
        self.sid,
        win_num,
        function(data)
            if data.ack == 1 then
                for _, v in pairs(win_num) do
                    self.winAward[v] = true
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                callback(true, data)
                require("CommonTipManager"):GetInstance():OpenDropTip(data)
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.ArenaElementBoxAward.id
                )
            else
                callback(false, data.ack)
            end
        end
    )
end

