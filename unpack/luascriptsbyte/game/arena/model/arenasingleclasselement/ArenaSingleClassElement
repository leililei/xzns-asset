function ArenaSingleClassElement:TiaoGuo(msg)
    if msg.ack == 1 then
        local UIManagerIns = _G.UIManager:GetInstance()
        --     _G.BattleManager:GetInstance():ParseStatistics(
        --     _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
        -- )
        _G.WorldManager:GetInstance():DespawnRoleParent()

        local ui_cfg = _G.ConfigManager.ui_cfg
        
        ArenaNet:GetInstance():FightResultElement(
            function(_data)
                self:ChangesChallengeTimes()
                self:InitInfo(
                    function()
                        local result = _data.winner or false
                        self.params = {
                            score = _data.info[1],
                            sumscore = _data.info[2],
                            lastRank = self:GetRank(),
                            win = result,
                            enemy = self.datamType,
                            re_uid = _data.re_uid,
                            reportType = 4,
                            isTiaoGuo = true,
                            mvpData = require("EmbattleModel"):GetInstance():GetEmbattleMaxPowerData(_G.EmbattleType.arenaElementAttack)
                        }
                        if result then
                            self.params.enemyCurScore = _data.info[4]
                            self.params.enemyAddScore = _data.info[5] - _data.info[4]
                        end
                        --self.params.enemy = self.datamType

                        self.params.curRank = self:GetRank()
                        self.params.winNum = self:GetWinNum() - self.curWinNum
                        self.params.curWinNum = self:GetWinNum()
                        self.params.maxWinNum = self:GetMaxWinNum()
                        local RedPointManagerIns = require("RedPointManager"):GetInstance()
                        local redpoint_cfg = _G.ConfigManager.redpoint_cfg
                        --获取奖励默认刷新青铜段位奖励
                        RedPointManagerIns:RefreshNodeByAllParams(redpoint_cfg.ArenaElementLeague.id)
                        --刷新宝箱红点
                        RedPointManagerIns:RefreshNodeByAllParams(redpoint_cfg.ArenaElementBoxAward.id)
                        RedPointManagerIns:RefreshNode(redpoint_cfg.ArenaElementChallenge.id)
                        local getEnemyInfoCall = function(list)
                            local view = UIManagerIns:GetWindowCtrl(ui_cfg.ArenaElementChallengeView.Name)
                            if view then
                                view:Show()
                                view:OnEnemyArrayCall(list)
                                view:RefreshView()
                            end
                            view = UIManagerIns:GetWindowCtrl(ui_cfg.ArenaElementMainPanelView.Name)
                            if view then
                                view:RefreshOnEmptyBattle()
                            end
                        end
                        self:RefreshReport(
                            function()
                                self:GetEnemyInfo(getEnemyInfoCall, true)
                            end
                        )
                        self.curBattleController = _G.require(_G.BattleControllerType.arenaElement).New()
                        self.curBattleController:StartSettlement(_G.SettlementModel.SettlementType.arena, self.params)
                        -- self.curBattleController:OnFightResult()
                    end,
                    true
                )
            end,
            true
        )
    end
end
function ArenaSingleClassElement:ChangesChallengeTimes()
    if self:GetFreeFightTimes() > 0 then
        return
    end
    local cfg = _G.ConfigManager.exchange_cfg[self.cfg.ticket]
    if cfg then
        _G.StorageManager:GetInstance():ConsumeItem(cfg.get_item[1][1], nil, 1)
    end
end
