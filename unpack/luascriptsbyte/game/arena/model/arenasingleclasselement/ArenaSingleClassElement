---更新倒计时(每秒调用)
function ArenaSingleClassElement:UpdateTime()
    if not self.endTimeStamp then
        return
    end
    self.endTimeSec = self.endTimeStamp - _G.TimeUtil.GetServerUnixTime()
    local updateInfo = false
    if self.endTimeSec < 0 then
        self.endTimeSec = 0
        updateInfo = true
    elseif _G.TimeUtil.GetSixClockTimer() == 0 then
        updateInfo = true
    end
    if not self.updateInfo and updateInfo then
        self.updateInfo = true
        local timer =
            _G.TimerManager:GetInstance():GetTimer(
            1,
            self.TimerFunc,
            self,
            true
        )
        timer:Start()
    end
    if self.arenaEndTimeCall then
        self.arenaEndTimeCall(self.endTimeSec)
    end
end

function ArenaSingleClassElement:TimerFunc()
    self:InitInfo(
        function()
            self:OnRefreshRedpoint()
            if not _G.table.isEmptyOrNil(self.refreshDataCall) then
                for _, call in pairs(self.refreshDataCall) do
                    call()
                end
            end
        end,
        true
    )
end

---处理时间
function ArenaSingleClassElement:HandleTime(open_time, close_time, state)
    if state == ArenaManager.State.open then
        self.endTimeStamp = close_time
    else
        self.endTimeStamp = open_time
    end
end
