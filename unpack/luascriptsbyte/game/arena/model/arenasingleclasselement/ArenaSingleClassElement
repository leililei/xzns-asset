---删除战报
---@param callback function 删除完回调(boolean true 则成功 false 则失败 并返回错误代码)
function ArenaSingleClassElement:DeleteBattleReport(uid, callback)
    ArenaNet:GetInstance():DeleteReportElement(
        self.sid,
        uid,
        function(data)
            if data.ack == 1 then
                for i = 1, #self.reportList do
                    if self.reportList[i].uid == uid then
                        _G.table.remove(self.reportList, i)
                        break
                    end
                end
                callback(true)
            else
                callback(false, data.ack)
            end
        end
    )
end

