    required uint32 frame=12;//头像框
]]
---@param data table 数据
function ArenaSingleClassElement:OnParseReport(data)
    if data.ack == 1 then
        local GetLangPackValue = _G.LangUtil.GetLangPackValue
        local reports = data.reports or {}
        for i = 1, #reports do
            reports[i].target_role_name =
                reports[i].target_type == 2 and reports[i].target_role_name or
                GetLangPackValue(reports[i].target_role_name)
        end
        self.reportList = reports
    else
        self.reportList = {}
    end
end
