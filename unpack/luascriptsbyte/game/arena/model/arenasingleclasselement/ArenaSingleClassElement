function ArenaSingleClassElement:OnEmbattleQuit()
    self.curChallengeUid = nil
    self.openEmbattleState = false
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(require "ArenaManager".arenaType.element)
    if arenaClass:GetCurArenaState() == 1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaElementMainPanelView.Name)
        if self.curEmbattleAttackTag then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaElementChallengeView.Name)
        end
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end
function ArenaSingleClassElement:OnBattle(uids)
    self.openEmbattleState = false

    if self.curEmbattleAttackTag then
        local skip =
            _G.PlayerPrefsManager.GetInt(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. 2) or 0

        if skip == 1 then
            --self:OnEmbattleQuit()
            self.datamType = self:GetEnemyDataByUid(self.curChallengeUid)
            -- _G.BattleManager:GetInstance():Settlement()
            ArenaNet:GetInstance():FightElement(
                self.curChooseArenaSid,
                self.curChallengeUid,
                self:GetEnemyDataByUid(self.curChallengeUid).mType,
                _G.handlerbind(self, self.TiaoGuo)
            )
        else
            _G.BattleManager:GetInstance():EnterFight(
                _G.BattleControllerType.arenaElement,
                self:GetRank(),
                self:GetEnemyDataByUid(self.curChallengeUid)
            )
            self.enterArenaBattle = true
        end
    else
        self:OnEmbattleQuit()
    end
end
