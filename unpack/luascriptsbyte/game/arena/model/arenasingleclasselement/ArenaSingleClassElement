function ArenaSingleClassElement:CheckEnterMainView()
    if self.curArenaState ~= ArenaManager.State.open then
        local m = _G.Mathf.Ceil(self.endTimeSec / 60)
        m = m > 0 and m or 1
        _G.PopWindowManager:GetInstance():ShowAllTips(300102, nil, nil, nil, nil, nil, m)
    end
    return self.curArenaState == ArenaManager.State.open
end
