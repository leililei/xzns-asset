---获取切磋列表
---@return table 切磋列表
function ArenaSingleClassFair:GetDuelList(call)
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        return
    end
    local duelList, uidList
    --TODO:获取公会在线列表
    require("SociatyManager"):GetInstance():GetOnlineMember(
        function(list)
            if list then
                --TODO:获取公会名称
                local guidName = require("SociatyManager"):GetInstance():GetGuildName()
                duelList = {}
                uidList = {}
                local muid = _G.PlayerModel:GetInstance():GetPlayerUid()
                for uid, value in pairs(list) do
                    if value.Uid ~= muid then
                        uidList[value.Uid] = true
                        duelList[#duelList + 1] = {
                            uid = value.Uid,
                            title = value.title,
                            name = value.Name,
                            score = 0,
                            style = value.style,
                            frame = value.frame,
                            power = value.Power,
                            guild_name = guidName,
                            win_times = 0,
                            win_per = 0
                        }
                    end
                end
            end
            --TODO:获取好友在线列表
            --FriendManager:FriendListOnLien()
            require("FriendManager"):GetInstance():FriendListOnLien(
                function(list)
                    if list then
                        if not uidList then
                            uidList = {}
                            duelList = {}
                        end
                        for uid, value in pairs(list) do
                            if not uidList[value.uid] then
                                uidList[value.uid] = true
                                duelList[#duelList + 1] = {
                                    uid = value.uid,
                                    title = value.title,
                                    name = value.name,
                                    score = 0,
                                    style = value.style,
                                    frame = value.frame,
                                    power = value.power,
                                    guild_name = value.guild_name
                                }
                            end
                        end
                    end
                    if not _G.table.isEmptyOrNil(duelList) then
                        --TODO:去重，并获取积分
                        ArenaNet:GetInstance():GetBattleScoreList(
                            _G.table.keys(uidList),
                            function(msg)
                                local scoreTable = {}
                                msg = msg.roles
                                for i = 1, #msg do
                                    scoreTable[msg[i].uid] = {msg[i].score, msg[i].win_times, msg[i].win_per}
                                end
                                for i = 1, #duelList do
                                    duelList[i].score = scoreTable[duelList[i].uid][1]
                                    duelList[i].win_times = scoreTable[duelList[i].uid][2]
                                    duelList[i].win_per = scoreTable[duelList[i].uid][3]
                                end
                                _G.table.sort(
                                    duelList,
                                    function(a, b)
                                        if a.score == b.score then
                                            if a.power == b.power then
                                                return a.uid > b.uid
                                            else
                                                return a.power > b.power
                                            end
                                        else
                                            return a.score > b.score
                                        end
                                    end
                                )
                                call(duelList)
                            end
                        )
                    else
                        call()
                    end
                end
            )
        end
    )
end
