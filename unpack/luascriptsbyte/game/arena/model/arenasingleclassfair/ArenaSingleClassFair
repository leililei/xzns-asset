---解析初始化数据数据
---@param data table 数据
function ArenaSingleClassFair:OnParseData(data, unCheck)
    self.seasonEndTimeStamp = data.end_time
    --TODO:结算时间延迟一秒，确保服务器先进入下一赛季
    self.nextSeasonStartTimeStamp = data.open_time + 1
    self.curSixClockTime = _G.TimeUtil.GetSixClockTimer()
    self:HandleState()
    self.score = data.score
    self.awardCount = data.award
    self.winPer = data.win_per
    self.winTimes = data.win_times
    --TODO:任务模块
    self.FairTaskModel:InitTaskDatas(data.curr_task)
    self.FairTaskModel:InitFinishTask(data.finish_daily_task)
    self.FairTaskModel:InitFinishTask(data.finish_period_task)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaFairTaskDayTask.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaFairTaskMainTask.id)
    if self.curArenaState ~= ArenaManager.State.open then
        self.FairTaskModel:Reset()
    end
    self:CheckTaskViewFresh()
    if not self.onSixInitInfoTag then
        --TODO:已经在匹配中的处理
        if not unCheck and data.match_state == 1 then
            _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnWorldLoadOver, self)
        end
    end
    self.onSixInitInfoTag = nil
end
