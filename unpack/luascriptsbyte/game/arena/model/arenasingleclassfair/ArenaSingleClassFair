---布阵数据推送
function ArenaSingleClassFair:OnEmbattleDataCall(msg)
    if self.curr_info then --当前还在加载阶段
        self.curr_info.self_array.sits = msg.my_garry
        self.curr_info.self_array.skill_index = msg.combine
        self.curr_info.tar_array.sits = msg.tar_garry
        self.curr_info.tar_array.skill_index = msg.target_combine
        self.curr_info.end_time = msg.end_time
        return
    end
    if not self.curEmbattleTimes or self.curEmbattleTimes == 0 then
        return
    end
    --TODO:更新布阵数据
    self.curEmbattleTimes = self.curEmbattleTimes + 1
    local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
    if embattleItem then
        embattleItem:InitEmbattleData(msg.my_garry)
        embattleItem:InitEnemyEmbattleData(msg.tar_garry)
        embattleItem:SetCombSkillData(msg.combine)
        embattleItem:SetEnemyCombineSkill(msg.target_combine)
    end
    self.curEmbattleEndTime = msg.end_time
    --TODO:刷新界面
    if self.onEmbattleCall then
        self.onEmbattleCall()
    end
end
