function ArenaSingleClassFair:OnReConnectData(data)
    self:OnParseData(data, true)
    self.onReconnectTag = true
    if data.match_state == 1 then
        self:GetFightInfo(
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.curr_info = data.curr_info
                --TODO:重连后在布阵里面 直接进入布阵
                local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
                if embattleItem then --已经在布阵里面了
                    self:CalculateCurTimes()
                    self.matchPlayerData = self.curr_info
                    embattleItem:InitEmbattleData(self.curr_info.self_array.sits)
                    embattleItem:InitEnemyEmbattleData(self.curr_info.tar_array.sits)
                    embattleItem:SetCombSkillData(self.curr_info.self_array.skill_index)
                    embattleItem:SetEnemyCombineSkill(self.curr_info.tar_array.skill_index)
                    self.matchPlayerData.self_array = nil
                    self.matchPlayerData.tar_array = nil
                    self.curEmbattleEndTime = self.curr_info.end_time
                    self.curr_info = nil
                    --TODO:刷新界面
                    if self.onEmbattleCall then
                        self.onEmbattleCall()
                    end
                else
                    self:OnWorldLoadOver()
                end
                if self.onReConnectCall then
                    for _, call in pairs(self.onReConnectCall) do
                        call(true)
                    end
                end
            end
        )
    else
        --TODO:重连后不在布阵，就清理掉所有的状态,并给予提示，清理战报(有可能是战斗后)
        -- if (not _G.table.isEmptyOrNil(self.invitationUITab)) or self.onMatchTag or self.onInvitationTag then --切磋邀请中 或者匹配中
        --     _G.PopWindowManager:GetInstance():ShowAllTips(670110)
        -- end
        if self.onReConnectCall then
            for _, call in pairs(self.onReConnectCall) do
                call(false)
            end
        end
        self.invitationUITab = nil
        self.curInvitationUid = 0
        self.onInvitationTag = nil
        self.onMatchTag = false
        self:ClearReport()
    end
    self.onReconnectTag = nil
    if self.onReconnectManagerCall then
        self.onReconnectManagerCall()
    end
    self.onReconnectManagerCall = nil
end
function ArenaSingleClassFair:OnHandeInvitationData(msg)
    if self.onInvitationTag == false then
        if msg.ack == 1 then
            self.onInvitationTag = true
        else
            self.onInvitationTag = nil
        end
    end
    if self.onHandleInvitationCall then
        self.onHandleInvitationCall(msg)
        self.onHandleInvitationCall = nil
    end
end
