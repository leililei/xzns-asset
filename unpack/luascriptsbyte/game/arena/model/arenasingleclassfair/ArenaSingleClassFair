---切磋邀请推送
function ArenaSingleClassFair:OnBattleInvitational(msg)
    if not self.invitationList then
        self.invitationList = {msg.role}
        return
    end
    self.invitationList[#self.invitationList + 1] = msg.role
end
---取消切磋推送
--[[
    required uin64 uid = 1;//
]]
function ArenaSingleClassFair:OnCancleInvitational(msg)
    if self.invitationList then
        for i = 1, #self.invitationList do
            if self.invitationList[i].uid == msg.uid then
                _G.table.remove(self.invitationList, i)
                break
            end
        end
        --TODO:提示拒绝切磋
        if self.onCancleInvitationCall then
            for key, call in pairs(self.onCancleInvitationCall) do
                call(msg.uid)
            end
        end
    end
end
---切磋邀请回应
function ArenaSingleClassFair:OnBattleDuel(msg)
    if msg.type == 1 then --同意
        if self.onInvitationAnswerCall then
            self.onInvitationAnswerCall(true, msg.uid)
        end
    else --拒绝
        self.invitationUITab[msg.uid] = nil
        self.curInvitationUid = 0
        if self.onInvitationAnswerCall then
            self.onInvitationAnswerCall(false, msg.uid)
        end
    end
    self.onInvitationAnswerCall = nil
end
--required uint32 type = 1;// 1 同意 2 拒绝
---收到切磋准备完成回应 推送
function ArenaSingleClassFair:OnJusticePrepareDuel(msg)
    if self.onJusticePrepareDuleCall then
        self.onJusticePrepareDuleCall(msg.type == 1)
        self.onJusticePrepareDuleCall = nil
    end
end
