---完成任务
---@param data FairTaskData
function ArenaSingleClassFair:FinishTask(sids, call)
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        return
    end
    require "ArenaNet":GetInstance():FinishTaskFair(
        {sid = sids},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local count = 0
            for _, v in pairs(sids) do
                self.FairTaskModel:FinishTask(v)
                if self.FairTaskModel.taskDatas[v] then
                    count = count + self.FairTaskModel.taskDatas[v].Cfg.reward_coin
                end
            end
            _G.table.insert(msg.award.item, {type = {103, count}})
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaFairTaskDayTask.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaFairTaskMainTask.id)
            require "CommonTipManager".OpenCommonAwardView(
                msg,
                function()
                    if call then
                        call(msg)
                    end
                end
            )
        end
    )
end
