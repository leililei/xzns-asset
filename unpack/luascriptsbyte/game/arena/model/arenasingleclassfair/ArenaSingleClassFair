---类的构造函数
function ArenaSingleClassFair:__init()
    local EventsIns = _G.Events:GetInstance()
    self.FairTaskModel = require "FairTaskModel".New()
    local net_map = _G.ConfigManager.net_map
    --TODO:添加推送监听
    EventsIns:AddListener(net_map.justice_match.Cmd, self.OnMatchSuccessCall, self)
    EventsIns:AddListener(net_map.justice_garry.Cmd, self.OnEmbattleDataCall, self)
    EventsIns:AddListener(net_map.justice_interact.Cmd, self.OnChatCall, self)
    EventsIns:AddListener(net_map.justice_duel.Cmd, self.OnBattleInvitational, self)
    EventsIns:AddListener(net_map.justice_duel_quit.Cmd, self.OnCancleInvitational, self)
    EventsIns:AddListener(net_map.justice_apply_duel.Cmd, self.OnBattleDuel, self)
    EventsIns:AddListener(net_map.justice_prepare_duel.Cmd, self.OnJusticePrepareDuel, self)
end

---类的析构函数
function ArenaSingleClassFair:Dispose()
    self.curEmbattleTimes = nil
    self.matchPlayerData = nil
    self.enemyRoleInfo = nil
    self.onCancleInvitationCall = nil
    self.FairTaskModel = nil
    local EventsIns = _G.Events:GetInstance()
    local net_map = _G.ConfigManager.net_map
    --TODO:移除推送监听
    EventsIns:RemoveListener(net_map.justice_match.Cmd, self.OnMatchSuccessCall, self)
    EventsIns:RemoveListener(net_map.justice_garry.Cmd, self.OnEmbattleDataCall, self)
    EventsIns:RemoveListener(net_map.justice_interact.Cmd, self.OnChatCall, self)
    EventsIns:RemoveListener(net_map.justice_duel.Cmd, self.OnBattleInvitational, self)
    EventsIns:RemoveListener(net_map.justice_duel_quit.Cmd, self.OnCancleInvitational, self)
    EventsIns:RemoveListener(net_map.justice_apply_duel.Cmd, self.OnBattleDuel, self)
    EventsIns:RemoveListener(net_map.justice_prepare_duel.Cmd, self.OnJusticePrepareDuel, self)
end

