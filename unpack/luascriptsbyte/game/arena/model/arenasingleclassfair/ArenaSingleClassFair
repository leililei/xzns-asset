---匹配对手
---@param match boolean 是否匹配对手
---@param callback function 匹配成功回调
function ArenaSingleClassFair:Match(match, callback)
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        return
    end
    self.onMatchCallback = callback
    if match then --匹配对手
        ArenaNet:GetInstance():Match(_G.handler(self, self.OnMatchCall))
    else --取消匹配
        ArenaNet:GetInstance():MatchCancle(_G.handler(self, self.OnMatchCall))
    end
end
