---邀请切磋
---@param uid number 玩家uid
---@param invitationCall function 邀请回调
function ArenaSingleClassFair:InvitationDuel(uid, invitationCall, answerCall)
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        return
    end
    --TODO:需求变更，可同时邀请多个玩家
    if not self.invitationUidTab then
        self.invitationUITab = {}
    end
    if self.invitationUITab[uid] then --已经要求过了
        return false
    end
    self.invitationUITab[uid] = true
    ArenaNet:GetInstance():InvitationalDuelFair(
        uid,
        function(msg)
            if msg.ack == 1 then
                self.onInvitationAnswerCall = answerCall
                invitationCall(true)
            else
                invitationCall(false)
                self.curInvitationUid = 0
            end
        end
    )
    return true
end
---取消邀请
---@param callback function 邀请回调
---@param uid number 玩家uid(0代表取消全部)
function ArenaSingleClassFair:CancleInvitationDuel(callback, uid)
    if uid > 0 and (not self.invitationUITab or not self.invitationUITab[uid]) then
        return false
    end
    ArenaNet:GetInstance():CancleInvitationalDuelFair(
        function(msg)
            if msg.ack == 1 then
                self.curInvitationUid = 0
                if uid == 0 then
                    self.invitationUITab = nil
                else
                    self.invitationUITab[uid] = nil
                end
                callback(true)
            else
                callback(false)
            end
        end,
        uid
    )
    return true
end
---处理切磋邀请
---@param uid number 玩家UID
---@param accept boolean 是否接受邀请
---@param callback function 回调
function ArenaSingleClassFair:HandletInvitationDeul(uid, accept, callback)
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        return
    end
    self.onHandleInvitationCall = callback
    if accept then
        self.onInvitationTag = false
    else
        self.onInvitationTag = nil
    end
    ArenaNet:GetInstance():HandleInvitationalDuelFair(
        uid,
        accept and 1 or 2,
        _G.handler(self, self.OnHandeInvitationData)
    )
end
