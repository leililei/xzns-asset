local serverTime = 0
---更新 赛季 倒计时
function ArenaSingleClassFair:UpdateTime()
    if not self.curEndTimStamp or self.curEndTimStamp <= 0 then
        return
    end
    serverTime = _G.TimeUtil.GetServerUnixTime()
    self.freshTime = self.curEndTimStamp - serverTime
    if self.freshTime < 0 then
        self.freshTime = 0
        if self.curArenaState == ArenaManager.State.settle then
            self.curEndTimStamp = 0
            --TODO:更新数据
            --self:InitInfo(nil, true)
            return
        elseif self.curArenaState == ArenaManager.State.open then
            self.curArenaState = ArenaManager.State.close
        --self.curEndTimStamp = self.nextSeasonStartTimeStamp
        end
    end
    if self.onEndTimeCallTab then
        for _, value in pairs(self.onEndTimeCallTab) do
            value(self.freshTime)
        end
    end
    self.curSixClockTime = self.curSixClockTime - 1
    if not self.onSixInitInfoTag and self.curSixClockTime <= 0 then
        self.onSixInitInfoTag = true
    --TODO:更新数据
    -- self:InitInfo(nil, true)
    end
end
---开始战斗
---@param callback function 进入战斗返回
function ArenaSingleClassFair:StartBattle(callback)
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)
        return
    end
    local BattleManagerIns = _G.BattleManager:GetInstance()
    local port =
        ArenaNet:GetInstance():FightFair(
        function(msg)
            if msg.ack == 1 then
                if callback then
                    callback(true, msg)
                end
                if self.invitationUITab and self.curInvitationUid then
                    self.invitationUITab[self.curInvitationUid] = nil
                end
                self.curInvitationUid = 0
                BattleManagerIns:EnterFight(_G.BattleControllerType.arenaFair, msg, self.enemyRoleInfo)
            else
                if callback then
                    callback(false)
                end
            end
        end
    )
    BattleManagerIns:AddLuaNetEvent(port)
end
--当场景加载完毕
function ArenaSingleClassFair:OnWorldLoadOver()
    _G.Events:GetInstance():RemoveListener(_G.eScene.EnterWorldOver, self.OnWorldLoadOver, self)
    self:GetFightInfo(
        function(data)
            if data.ack ~= 1 then
                return
            end
            self.curr_info = data.curr_info
            --TODO:计算当前所在阶段
            self:CalculateCurTimes()
            local enter = false
            if self.curEmbattleTimes > 0 and self.activity and self.activity:CheckIsOpen() then
                --TODO:判定当前是否还在布阵阶段
                local time = _G.TimeUtil.GetServerUnixTime()
                if time < self.curr_info.end_time then --当前阶段
                    enter = true
                else --已经进入下一阶段
                    self.curEmbattleTimes = self.curEmbattleTimes + 1
                    if self.curEmbattleTimes < 5 then
                        enter = true
                    end
                end
            end
            if enter then
                self.matchPlayerData = self.curr_info
                self.enemyRoleInfo = self.curr_info.roles
                self.enemyRoleInfo.score = self.curr_info.tar_score
                self.curEmbattleEndTime = self.curr_info.end_time
                self.curr_info = nil
                self:EnterEmbattle(
                    nil,
                    function()
                        local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
                        embattleItem:InitEmbattleData(self.matchPlayerData.self_array.sits)
                        embattleItem:InitEnemyEmbattleData(self.matchPlayerData.tar_array.sits)
                        embattleItem:SetCombSkillData(self.matchPlayerData.self_array.skill_index)
                        embattleItem:SetEnemyCombineSkill(self.matchPlayerData.tar_array.skill_index)
                        self.matchPlayerData.self_array = nil
                        self.matchPlayerData.tar_array = nil
                    end
                )
            else
                self.curr_info = nil
            end
        end
    )
end
function ArenaSingleClassFair:CalculateCurTimes()
    local array = self.curr_info.tar_array.sits
    self.curEmbattleTimes = 0
    for i = 1, #array do
        if array[i] > 0 then
            self.curEmbattleTimes = self.curEmbattleTimes + 1
        end
    end
    if self.curEmbattleTimes == #array then
        array = self.curr_info.tar_array.skill_index
        if array[1] == 0 then --处在第四阶段 选择合击技
            self.curEmbattleTimes = 4
        else --已经布阵完
            self.curEmbattleTimes = 0
        end
    else
        self.curEmbattleTimes = _G.Mathf.RoundToInt(self.curEmbattleTimes / 2) + 1
    end
end
---处理当前竞技场状态
function ArenaSingleClassFair:HandleState()
    self.curArenaState = ArenaManager.State.close
    local t = _G.TimeUtil.GetServerUnixTime()
    if t < self.seasonEndTimeStamp then --当前赛季中
        self.curArenaState = ArenaManager.State.open
        self.curEndTimStamp = self.seasonEndTimeStamp
    elseif t < self.nextSeasonStartTimeStamp then --赛季结算中
        self.curArenaState = ArenaManager.State.settle
        self.curEndTimStamp = self.nextSeasonStartTimeStamp
    end
    self.freshTime = 0
end
