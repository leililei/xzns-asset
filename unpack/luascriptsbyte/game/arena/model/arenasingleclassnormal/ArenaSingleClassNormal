function ArenaSingleClassNormal:DeleteBattleReport(uid, callback)
    ArenaNet:GetInstance():DeleteReport(
        self.sid,
        uid,
        function(data)
            if data.ack == 1 then
                for i = 1, #self.reportList do
                    if self.reportList[i].uid == uid then
                        _G.table.remove(self.reportList, i)
                        break
                    end
                end
                callback(true)
            else
                callback(false, data.ack)
            end
        end
    )
end

