--region 数据解析
---解析初始化数据数据
---@param data table 数据
--[[
    required string ack = 1;
    optional uint32 status= 2;//竞技场状态，1开启，2关闭
    optional uint32 next_open_time=3;//下赛季开启时间
    optional uint32 rank = 4;//排名
    optional uint32 max_rank = 5;//历史最高排名
    optional uint32 fight_times = 6;//剩余免费战斗次数
    optional uint32 score = 7;//积分
    optional uint32 win_num = 8;//胜点
    repeated uint32 win_award =9;//胜点宝箱领取情况   整数列表，存胜点[win_num...]
    repeated uint32 stage_award = 10;//段位奖励领取情况  整数列表，存段位sid[stageSid...]
    optional uint32 season_closing_countdown=11;//赛季结算时间戳
    optional uint32 refresh_time=12;//上次刷新对手时间
    optional uint32 current_season=13;//当前赛季
    optional uint32 highest_score=14;//当前赛季最高积分
    optional bool attacked = 15;//离线期间是否被攻击
    required uint32 refresh_times = 16;//今日已刷新对手次数
    ]]
function ArenaSingleClassNormal:OnParseData(data)
    self.updateInfo = false
    self.curArenaState = data.status or ArenaManager.State.close
    self:HandleTime(data.next_open_time, data.season_closing_countdown)
    self.curRank = data.rank
    self.maxRank = data.max_rank
    self.fightTimes = data.fight_times
    self.curScore = data.score
    --self.curWinNum = data.win_num
    --data.win_award = data.win_award or {}
    self.isNewReport = self.isNewReport or (data.attacked or false)
    --self.winAward = {}
    --for i = 1, #data.win_award do
    --    self.winAward[data.win_award[i]] = true
    --end
    self.stageAward = {}
    if data.stage_award then
        for i = 1, #data.stage_award do
            self.stageAward[data.stage_award[i]] = true
        end
    end
    self.maxScore = data.highest_score
    self.seasonStageAward = data.season_stage_award
    self.curSeason = data.current_season or 1
    self.freshTime =
        data.refresh_time and (data.refresh_time + self.cfg.refresh_cd - _G.TimeUtil.GetServerUnixTime()) or 0
    self.freshTime = self.freshTime < 0 and 0 or self.freshTime
    self.freshTime = _G.Mathf.Ceil(self.freshTime)
    self.refreshEnemyTimes = data.refresh_times or 0
    self:UpdateTime()
    --刷新红点状态, 刷新挑战券数量
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaChallenge.id)
end

---解析挑战玩家数据
---@param data table 数据
--[[
    required uint32 type=1;// 1 npc，2为玩家
    required uint64 uid=2;//
    required string name=3;// 名字
    required uint32 style=4;//头像
    required uint32 score=5;// 积分
    required uint32 power=6;// 战斗力
    required uint32 league=7;// 段位sid
    required uint32 frame=8;//头像框
]]
function ArenaSingleClassNormal:OnParseEnemyData(data)
    if data.ack == 1 then
        local info
        self.enemyList = {}
        data.enemy = data.enemy or {}
        for i = 1, #data.enemy do
            info = data.enemy[i]
            self.enemyList[i] = {
                uid = info.uid,
                name = info.type == 2 and info.name or _G.LangUtil.GetLangPackValue(info.name),
                style = info.style,
                score = info.score,
                power = info.power,
                mType = info.type,
                league = info.league or 10001,
                frame = info.frame or 101
            }
        end
        _G.table.sort(
            self.enemyList,
            function(a, b)
                return a.score > b.score
            end
        )
    end
end

---解析玩家卡牌数据
---@param index number 序列号
---@param data table 数据
function ArenaSingleClassNormal:OnParseEnemyCard(index, data)
    self.enemyList[index].garray = { false, false, false, false, false }
    self.enemyList[index].pet = data.pet
    self.enemyList[index].combine = data.combine
    if data.ack == 1 then
        self.enemyList[index].power = data.power or self.enemyList[index].power
        data = data.team
        for i = 1, #self.enemyList[index].garray do
            self.enemyList[index].garray[i] =
                self.enemyList[index].garray[i] or
                {
                    sid = 0,
                    star = 0,
                    lv = 0,
                    pos = 0,
                    soulLV = 0,
                    soulState = 0,
                    artifact = {},
                    talents = 0
                }
            local enemyCard = self.enemyList[index].garray[i]
            if not _G.table.isEmptyOrNil(data[i]) then
                enemyCard.sid = data[i].sid or 0
                enemyCard.star = data[i].star or 0
                enemyCard.lv = data[i].level or 0
                enemyCard.pos = data[i].index or 0
                enemyCard.soulLV = data[i].soul_lv or 0
                enemyCard.soulState = data[i].soul_state or 0
                enemyCard.talents = data[i].born_skill_num or 0
                enemyCard.artifact = data[i].artifact or {}
                enemyCard.artifact_skin = data[i].artifact_skin or {}
            else
                enemyCard.sid = 0
                enemyCard.star = 0
                enemyCard.lv = 0
                enemyCard.pos = 0
                enemyCard.soulLV = 0
                enemyCard.soulState = 0
                enemyCard.talents = 0
                enemyCard.artifact = {}
            end
            self.enemyList[index].garray[i] = enemyCard
        end
    end
end

---解析排行榜数据
--[[   
   required string name = 1;//名字
   required uint32 score = 2;//积分
   optional string guild = 3;//公会名
   required role.i_effect title = 4;//称号
   required uint32 style = 5;//头像
   required uint32 level = 6;//等级
   required uint64 uid = 7;//uid
   required uint32 type= 8; // 类型，1为npc，2为玩家
   required uint32 frame=9;//头像框
   required uint32 power = 10;//队伍战斗力
   ]]
---@param data table 数据
function ArenaSingleClassNormal:OnParseRankList(data)
    local count = #data.arenas
    local rankBase = #self.rankList
    for i = 1, count do
        data.arenas[i].name =
            data.arenas[i].type == 1 and _G.LangUtil.GetLangPackValue(data.arenas[i].name) or data.arenas[i].name
        data.arenas[i].rank = i + rankBase
        _G.table.insert(self.rankList, data.arenas[i])
    end
    if count >= rankListMax then
        self.curRankPage = self.curRankPage + 1
        if self.curRankPage <= rankPageMax then
            ArenaNet:GetInstance():GetRankList(self.sid, self.curRankPage, _G.handler(self, self.ParseRankList))
        end
    end
end

---解析战报数据
--[[
    required uint64 uid=1;//战报uid
    required uint32 score=2;//积分变化，仅数值
    required uint64 target_uid=3;//对手uid
    required uint32 target_type=4;//对手类型,1 npc,2 玩家
    required string target_role_name=5;//对手角色名
    required uint32 target_power=6;//对手战斗力
    required uint32 target_style=7;//对手头像
    required uint32 target_level=8;//对手等级
    required uint32 winner=9;//胜负，0 胜利 | 1 失败
    required uint32 time=10;//时间
    required uint32 report_type=11;//战报类型 0 攻击， 1 防御
    required uint32 frame=12;//头像框
]]
---@param data table 数据
function ArenaSingleClassNormal:OnParseReport(data)
    if data.ack == 1 then
        local GetLangPackValue = _G.LangUtil.GetLangPackValue
        local reports = data.reports or {}
        for i = 1, #reports do
            reports[i].target_role_name =
                reports[i].target_type == 2 and reports[i].target_role_name or
                GetLangPackValue(reports[i].target_role_name)
        end
        self.reportList = reports
    else
        self.reportList = {}
    end
