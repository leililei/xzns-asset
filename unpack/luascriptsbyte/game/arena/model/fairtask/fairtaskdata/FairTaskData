---@class FairTaskData	中文描述
---@field  Cfg arena_equity_task_cfg
local FairTaskData = _G.BaseClass("FairTaskData")
local arena_equity_task_cfg = _G.ConfigManager.arena_equity_task_cfg
---类的构造函数
function FairTaskData:__init(data)
    self:Parse(data)
end
---类的析构函数
function FairTaskData:Dispose()
end
---@param data justice.proto
function FairTaskData:Parse(data)
    self.sid = data.tid
    self.state = data.state
    self.Cfg = arena_equity_task_cfg[self.sid]
    self:InitReward()
    self.type = self.Cfg.type_mission
    self.conditionNum = self.Cfg.count
    self.taskType = self.Cfg.condition[1][1]
    self.curValue = data.curr == -1 and self.conditionNum or data.curr
    self:CheckState()
end
---初始化奖励
function FairTaskData:InitReward()
    self.reward = {}
    _G.table.insertto(self.reward, self.Cfg.reward)
    if self.Cfg.reward_coin > 0 then
        _G.table.insert(self.reward, {103, self.Cfg.reward_coin})
    end
end
function FairTaskData:Reset()
    self.state = _G.TaskEnum.ETaskState.Claimed
    self.curValue = 0
end
---得到任务进度条
function FairTaskData:GetProgress()
    if self.state == _G.TaskEnum.ETaskState.Completed or self.state == _G.TaskEnum.ETaskState.Submited then
        return 1
    end
    local v1, v2 = self:GetCount()
    return v1 / v2
end

function FairTaskData:GetCount()
    if self.state == _G.TaskEnum.ETaskState.Completed or self.state == _G.TaskEnum.ETaskState.Submited then
        return self.count, self.count
    else
        return self.curValue, self.count
    end
end
---检测任务状态
function FairTaskData:CheckState()
    if self.curValue > self.Cfg.count then
        self.curValue = self.Cfg.count
    end

    if self.state == _G.TaskEnum.ETaskState.Claimed then
        if self.curValue >= self.Cfg.count then
        else
            --- 次数没达到 不算完成
            return
        end

        self.state = _G.TaskEnum.ETaskState.Submited
    end
end
return FairTaskData
