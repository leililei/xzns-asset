---@class FairTaskModel	中文描述
---@field finishTasks table<boolean>
---@field taskDatas FairTaskData[]
local FairTaskModel = _G.BaseClass("FairTaskModel")
function FairTaskModel:__init()
end
---类的析构函数
function FairTaskModel:Dispose()
    self.taskDatas = nil
    self.finishTasks = nil
    self.taskArray = nil
end

---解析数据
function FairTaskModel:Parse(msg)
end
---初始化任务数据
---@param msg guard.proto.s2c_guard_info
function FairTaskModel:InitTaskDatas(task)
    self.finishTasks = {}
    self.taskDatas = {}
    self.taskArray = nil
    if not task then
        return
    end
    for _, v in pairs(task) do
        v.state = _G.TaskEnum.ETaskState.Claimed
        self.taskDatas[v.tid] = require "FairTaskData".New(v)
    end
end
--region 完成任务
---初始化任务完成
---@param msg guard.proto.s2c_guard_info
function FairTaskModel:InitFinishTask(task)
    if task then
        for _, v in pairs(task) do
            self.finishTasks[v] = true
            self.taskDatas[v] = require "FairTaskData".New({tid = v, curr = -1})
            self.taskDatas[v].state = _G.TaskEnum.ETaskState.Submited
        end
    end
end

---检测是否完成
function FairTaskModel:CheckIsFinish(sid)
    return self.finishTasks[sid]
end
---检测是否可以领奖
function FairTaskModel:CheckIsCanTake(sid)
    if self:CheckIsGet(sid) then
        return false
    end
    if not self.taskDatas[sid] then
        return false
    else
        return self.taskDatas[sid].state == _G.TaskEnum.ETaskState.Submited
    end
end
function FairTaskModel:Reset()
    self.finishTasks = {}
    for k, v in pairs(self.taskDatas) do
        v:Reset()
    end
end
---检测是否已经领过奖
function FairTaskModel:CheckIsGet(sid)
    return self:CheckIsFinish(sid)
end

---完成任务
---@param data HellGuardTaskData
function FairTaskModel:FinishTask(sid, state)
    self.finishTasks[sid] = true
    self.taskDatas[sid].state = state
    self.taskDatas[sid]:CheckState()
    _G.Events:GetInstance():Broadcast(_G.eArena.SetFairCoin, self.taskDatas[sid].Cfg.reward_coin)
end

---获取任务数据
function FairTaskModel:GetTaskDatas()
    if not self.taskArray then
        self.taskArray = {}
        for _, v in pairs(self.taskDatas) do
            if not self.taskArray[v.type] then
                self.taskArray[v.type] = {}
            end
            _G.table.insert(self.taskArray[v.type], v)
        end
    end
    self:SortTask()
    return self.taskArray
end
---任务排序
function FairTaskModel:SortTask()
    if not self.taskArray then
        return
    end
    for _, v in pairs(self.taskArray) do
        _G.SortList(
            v,
            function(data)
                local type = -99
                local iscantake = self:CheckIsCanTake(data.sid)
                if iscantake then
                    type = 100
                elseif data.state == _G.TaskEnum.ETaskState.Submited then
                    type = 0
                elseif data.state == _G.TaskEnum.ETaskState.Claimed then
                    type = 99
                end
                return type, -data.sid
            end
        )
    end
end
---检测是否有可领取的任务
---@param type number 检测类型 1 日常 2主线
function FairTaskModel:CheckHaveGetTask(type)
    for _, v in pairs(self.taskDatas) do
        if self:CheckIsCanTake(v.sid) and type == v.type then
            return true
        end
    end
    return false
end

--endregion

return FairTaskModel
