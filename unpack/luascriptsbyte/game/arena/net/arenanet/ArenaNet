local base = require("BaseGameNet")

---@class ArenaNet : BaseGameNet	通信协议
local ArenaNet = _G.BaseClass("ArenaNet", require("BaseGameNet"))

---@return ArenaNet ArenaNet
function ArenaNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function ArenaNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ArenaNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---显示错误消息ack的tips
function ArenaNet:ShowErrorAckTips(ack)
    if ack == 5 then
        ack = 4015
    end
    base.ShowErrorAckTips(self, ack)
end

