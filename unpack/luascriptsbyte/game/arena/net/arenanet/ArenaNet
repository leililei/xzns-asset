function ArenaNet:GetRankListFair(start, count, callback)
    if start == 0 then
        self:Access(_G.ConfigManager.net_map.game_rank_justice, {page = 1}, callback)
    else
        self:Access(
            _G.ConfigManager.net_map.game_rank_justice,
            {page = 1, start_index = start, end_index = start + count - 1},
            callback
