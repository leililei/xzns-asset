---选择竞技场
---@param sid number 竞技场id
---@param callback function 异步回调
function ArenaController:OnArenaChoose(sid, callback)
    self.curChooseArenaSid = sid
    local arenaManager = ArenaManager:GetInstance()
    local state = arenaManager:GetArenaState(sid)
    if state == 0 or state == 1 then
        self.onArenaChooseCall = callback
        arenaManager:GetArenaSingle(sid, _G.handler(self, self.OnArenaInfoGetCallback), true)
        arenaManager:SetRefreshCall(self.curChooseArenaSid, _G.handler(self, self.OnArenaRefresh))
    else
        local m = _G.Mathf.Ceil(self:GetEndTime(nil, true) / 60)
        m = m > 0 and m or 1
        _G.PopWindowManager:GetInstance():ShowAllTips(300102, nil, nil, nil, nil, nil, m)
        self.curChooseArenaSid = nil
    end
end

