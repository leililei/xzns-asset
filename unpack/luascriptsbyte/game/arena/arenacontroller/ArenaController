function ArenaController:OnArenaInfoGetCallback(success)
    if success then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
        if self.onArenaChooseCall then
            self.onArenaChooseCall(true)
        end
    else
        --功能未开放
        ArenaManager:GetInstance():SetRefreshCall(self.curChooseArenaSid)
        if self.onArenaChooseCall then
            self.onArenaChooseCall(false)
        end
    end
end

