---挑战
---@param uid number 敌方uid
---@param isSkip boolean 是否不进布阵跳过（挑战列表直接跳）
function ArenaController:Challenge(uid, isSkip, enemyName)
    self.curChallengeUid = uid

    self:GetEnemyCardList(
        uid,
        function(sids)
            local data = { false, false, false, false, false }
            local emptyTag = true
            for i = 1, #sids do
                data[i] = {
                    uid = sids[i].sid,
                    sid = sids[i].sid,
                    level = sids[i].lv or 0,
                    star = sids[i].star or 0,
                    soulLink_lv = sids[i].soulLV or 0,
                    soulLink_IsActivate = sids[i].soulState or 0,
                    artifact = sids[i].artifact or {},
                    open_inborn = sids[i].talents or 0,
                    artifact_skin=sids[i].artifact_skin
                }
                if emptyTag and sids[i].sid > 0 then
                    emptyTag = false
                end
            end
            if emptyTag then --挑战空阵容玩家
                require("EmbattleController"):GetInstance():SaveByEnemyEmpty(
                    _G.EmbattleType.arenaAttack,
                    _G.EmbattleSaveType.server,
                    nil,
                    _G.EmbattleControllerItemType.arenaAttack,
                    _G.ConfigManager.arena_info_cfg[1].battle_sences,
                    data
                )
                ArenaNet:GetInstance():Fight(
                    self.curChooseArenaSid,
                    self.curChallengeUid,
                    self:GetEnemyDataByUid(self.curChallengeUid).mType,
                    _G.handler(self, self.OnChallengeEmptyCall)
                )
                return
            end
            local _enemyData = ArenaManager:GetInstance():GetEnemyDataByUid(self.curChooseArenaSid, uid)
            data.power = _enemyData.power
            data.pet = _enemyData.pet
            data.combine = _enemyData.combine
            -- local function OnEmbattleViewOpen(self, name)
            --     if name == _G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name then
            --         return
            --     end
            --     _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)
            --     local UIManagerIns = _G.UIManager:GetInstance()
            --     if isSkip then
            --         -- UIManagerIns:HideWindow(_G.ConfigManager.ui_cfg.ArenaChanllengeView.Name)
            --         -- UIManagerIns:HideWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
            --         _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, false)
            --     else
            --         UIManagerIns:CloseWindow(_G.ConfigManager.ui_cfg.ArenaChanllengeView.Name)
            --         UIManagerIns:CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
            --     end
            -- end
            -- _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OnEmbattleViewOpen, self)

            local SkipBattle = function()
                self.item:SaveEmbattle(function()
                    self:OnBattle(nil, 1)
                    self.item:Dispose()
                    self.item = nil
                end)
                self.curEmbattleAttackTag = true
            end
            local EmBattle = function()
                self.openEmbattleState = true
                ---@type string 最后挑战目标的名字
                self.lastEnemyName = enemyName
                _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
                require("EmbattleController"):GetInstance():OpenEmbattle(
                    _G.EmbattleType.arenaAttack,
                    _G.EmbattleSaveType.server,
                    nil,
                    _G.EmbattleControllerItemType.arenaAttack,
                    _G.handler(self, self.OnEmbattleQuit),
                    _G.handler(self, self.OnBattle),
                    _G.ConfigManager.arena_info_cfg[1].battle_sences,
                    data
                )
                self.curEmbattleAttackTag = true
            end
            if isSkip then
                self.item = require(_G.EmbattleControllerItemType.arenaAttack).New(
                    _G.EmbattleType.arenaAttack,
                    _G.EmbattleSaveType.server,
                    nil,
                    _G.ConfigManager.arena_info_cfg[1].battle_sences,
                    data
                )
                local PopWindowManager = _G.PopWindowManager:GetInstance()
                local battle, index, noTip = self.item:CheckBattle()
                if not battle then -- 不能出战
                    if not noTip then
                        PopWindowManager:ShowAllTips(140107)
                    end
                    EmBattle()
                    return
                end

                --检测是否有可上阵空位
                local replaceableTip = self.item:CheckEmptyPos() ~= 0
                --额外检测是否可上合击技
                if not replaceableTip then
                    for i = 1, #self.item:GetCombSkillData() do
                        if self.item:CheckCombineSkillEquip(i) then
                            replaceableTip = true
                            break
                        end
                    end
                end
                --额外检测队伍中是否存在1级的角色(未养成的角色)
                if not replaceableTip then
                    for _, card in pairs(self.item:GetCardList()) do
                        if card.lv == 1 and self.item:CheckUidInEmbattle(card.uid) then
                            replaceableTip = true
                            break
                        end
                    end
                end

                if replaceableTip and PopWindowManager:CheckToggleWindow(140303) then
                    --还有可以上阵的角色
                    PopWindowManager:ShowBtnWindowByToggle1(140303, EmBattle, SkipBattle, SkipBattle,nil,{notCall=false,cancleToggleBol=true})
                else
                    SkipBattle()
                end
            else
                EmBattle()
            end
        end,
        true
    )
end

function ArenaController:OnEmbattleOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)

    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaChanllengeView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
    ---@type EmbattleNewView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(name);
    if view then
        view:SetVsDescription(_G.PlayerModel:GetInstance():GetName(), self.lastEnemyName)
    end
end

function ArenaController:OnChallengeEmptyCall(msg)
    if msg.ack == 1 then
        local UIManagerIns = _G.UIManager:GetInstance()
        local ui_cfg = _G.ConfigManager.ui_cfg

        ArenaNet:GetInstance():FightResult(
            nil,
            function(_data)
                self:ChangesChallengeTimes()
                self:FreshArenaInfo(
                    function()
                        -- _G.PopWindowManager:GetInstance():ShowAllTips(
                        --     300302,
                        --     nil,
                        -- function()
                        self:RefreshBoxRedPoint()
                        self:RefreshRePort(
                            function()
                                self:GetEnemyArray(
                                    function(list)
                                        local view = UIManagerIns:GetWindowCtrl(ui_cfg.ArenaChanllengeView.Name)
                                        if view then
                                            view:Show()
                                            view:OnEnemyArrayCall(list)
                                            view:RefreshView()
                                        end
                                        view = UIManagerIns:GetWindowCtrl(ui_cfg.ArenaMainPanelView.Name)
                                        if view then
                                            view:RefreshOnEmptyBattle()
                                        end
                                    end,
                                    true
                                )
                            end
                        )
                    end
                )
            end
        )
    end
end

