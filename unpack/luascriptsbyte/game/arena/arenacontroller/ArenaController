---计算挑战胜利获得的积分
---@param score number 挑战对象积分
---@param cfg arena_league_cfg|arena_league_elem_cfg 挑战段位配置
---@param mscore number 当前积分
---@return number 获胜得分
function ArenaController:CalculateWinScore(score, cfg, mscore)
    local dir = mscore > score and -1 or 1
    local params = _G.DeepCopy(_G.ConfigManager.discrete_cfg[100704][1])
    params[1] = params[1] / 10000
    params[2] = params[2] / 10000
    params[3] = params[3] / 10000
    score = _G.Mathf.Abs(mscore - score)
    score = _G.Mathf.Floor(score / params[2]) * params[1]
    score = score < params[3] and score or params[3]
    score = score * dir
    score = cfg.vic_scores * (1 + score)
    return _G.Mathf.Ceil(score)
end

