local arenaFirstLoginKey = "ArenaLoginFirstDay"
---检测是否每日首次进入竞技场
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function ArenaController:CheckLoginFirstByDay(sid)
    if not self.arenaLoginFirst then
        self.arenaLoginFirst = _G.PlayerPrefsManager.GetTable(arenaFirstLoginKey)
        if _G.table.isEmptyOrNil(self.arenaLoginFirst) then
            self.arenaLoginFirst = { 1, 1, 1, _G.TimeUtil.GetServerUnixTime() }
        else
            local t = _G.TimeUtil.GetServerUnixTime()
            t = _G.TimeUtil.GetInterValDayByGame(t, self.arenaLoginFirst[#self.arenaLoginFirst])
            if t > 0 then
                self.arenaLoginFirst = { 1, 1, 1, _G.TimeUtil.GetServerUnixTime() }
            end
        end
    end
    return self.arenaLoginFirst[sid] == 1
end

function ArenaController:SetArenaLoginFirstByDay(sid)
    self.arenaLoginFirst[sid] = 0
    _G.PlayerPrefsManager.SetTable(arenaFirstLoginKey, self.arenaLoginFirst)
end

function ArenaController:ResetLoginFirstTable()
    if not self.arenaLoginFirst then
        return
    end
    local t = _G.TimeUtil.GetServerUnixTime()
    t = _G.TimeUtil.GetInterValDayByGame(t, self.arenaLoginFirst[#self.arenaLoginFirst])
    if t > 0 then
        self.arenaLoginFirst = { 1, 1, 1, _G.TimeUtil.GetServerUnixTime() }
    end
end

