--region 高阶竞技场
---根据排名计算段位(高阶竞技场)
---@param rank number 排名
---@return arena_senior_cfg 段位配置
function ArenaController:CalculateSeniorLeagueByRank(rank)
    if nil == rank then
        return nil
    end
    local cfgs = _G.ConfigManager.arena_senior_cfg
    if rank <= 100 then --前100名都是王者
        return cfgs[rank]
    end
    local cfg
    for i = #cfgs, 101, -1 do
        cfg = cfgs[i]
        if rank >= cfg.min_rank then
            return cfg
        end
    end
end

