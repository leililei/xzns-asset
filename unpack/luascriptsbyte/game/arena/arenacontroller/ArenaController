---检测段位是否达成
---@param id number 段位ID
---@param cfgs number 段位配置
---@param sid number 竞技场sid
---@return boolean 是否达成
function ArenaController:CheckRankAwardTo(id, cfgs, sid)
    cfgs = cfgs or _G.ConfigManager.arena_league_cfg
    sid = sid or 1
    local cfg = cfgs[id]
    local arenaClass = ArenaManager:GetInstance():GetArenaClass(sid)
    if cfg.rank_con <= 0 then
        return arenaClass:GetMaxScore() >= cfg.min_score
    else
        return arenaClass:GetMaxScore() >= cfg.min_score and self:GetMaxRank(sid) <= cfg.rank_con
    end
end

---根据分数和排名获取段位名字
---@param score number 分数
---@param rank number 排名
---@return number 段位名称多语言key
function ArenaController:GetLeagueNameByScore(score, rank)
    local name = 0
    score = score or self:GetScore()
    rank = rank or self:GetRank()
    for key, value in pairs(_G.ConfigManager.arena_league_cfg) do
        if value.min_score <= score and score <= value.max_score then
            if value.rank_con <= 0 or rank <= value.rank_con then
                name = value.name
            end
        end
    end
    return name
end

---根据分数和排名获取段位配置
---@param score number 分数
---@return arena_league_cfg_Item 段位
function ArenaController:GetLeagueCfg(score, cfgs)
    cfgs = cfgs or _G.ConfigManager.arena_league_cfg
    for key, value in pairs(cfgs) do
        if value.min_score <= score and score <= value.max_score then
            return value
        end
    end
    return nil
end

