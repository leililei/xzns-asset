function ArenaController:OnArenaRefresh()
    if self:GetArenaState() == 1 then
        if self.onArenaRefreshCallback then
            self.onArenaRefreshCallback()
        end
    else
        if not self.enterArenaBattle then
            --_G.PopWindowManager:GetInstance():ShowAllTips(300301)
            self.onArenaRefreshCallback = nil
            ArenaManager:GetInstance():SetRefreshCall(self.curChooseArenaSid)
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnArenaCloseCall, self)
        else
            ArenaManager:GetInstance():SetRefreshCall(self.curChooseArenaSid)
            if self.onArenaRefreshCallback then
                self.onArenaRefreshCallback()
            end
        end
    end
end

function ArenaController:OnArenaCloseCall()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnArenaCloseCall, self)
    local uimanager = _G.UIManager:GetInstance()
    uimanager:CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
    uimanager:CloseWindow(_G.ConfigManager.ui_cfg.ArenaAwardPageView.Name)
    uimanager:CloseWindow(_G.ConfigManager.ui_cfg.ArenaChanllengeView.Name)
    if self.curChooseArenaSid == ArenaManager.arenaType.normal then
        uimanager:CloseWindow(_G.ConfigManager.ui_cfg.ArenaReportPanel.Name)
    end
    ArenaManager:GetInstance():SetRefreshCall(self.curChooseArenaSid, nil)
    if self.openEmbattleState then
        require("EmbattleController"):GetInstance():CloseEmbattle()
    end
end

function ArenaController:OnEmbattleQuit()
    self.curChallengeUid = nil
    self.openEmbattleState = false
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ArenaLineup.id)
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(1)
    if arenaClass:GetCurArenaState() == 1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
        if self.curEmbattleAttackTag then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaChanllengeView.Name)
        end
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end

function ArenaController:TiaoGuo(msg)
    if msg.ack == 1 then
        local UIManagerIns = _G.UIManager:GetInstance()
        --     _G.BattleManager:GetInstance():ParseStatistics(
        --     _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
        -- )
        _G.WorldManager:GetInstance():DespawnRoleParent()

        local ui_cfg = _G.ConfigManager.ui_cfg

        ArenaNet:GetInstance():FightResult(
            nil,
            function(_data)
                self:ChangesChallengeTimes()
                if _data.ack == 1 then
                    -- self:RefreshView(call)
                    --CommonTipManager:GetInstance().OpenCommonAwardView(_data)
                    _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                    local result = _data.winner or false
                    self.params = {
                        score = _data.info[1],
                        sumscore = _data.info[2],
                        lastRank = self:GetRank(),
                        win = result,
                        enemy = self.datamType,
                        re_uid = _data.re_uid,
                        reportType = 2,
                        isTiaoGuo = true,
                        data = _data,
                        mvpData = require("EmbattleModel"):GetInstance():GetEmbattleMaxPowerData(
                            _G.EmbattleType.arenaAttack
                        )
                    }
                    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(1)

                    if result == false then
                        require "PopUpGiftBagModel":GetInstance():IsArenaFailure()
                    end

                    if arenaClass:GetCurArenaState() == 1 then
                        arenaClass:InitInfo(
                            function()
                                self.params.curRank = arenaClass:GetRank()
                                --self.params.winNum = arenaClass:GetWinNum() - self.curWinNum
                                --self.params.curWinNum = arenaClass:GetWinNum()
                                --self.params.maxWinNum = arenaClass:GetMaxWinNum()
                                --local ArenaControllers = require("ArenaController"):GetInstance()
                                self:RefreshBoxRedPoint()
                                self:RefreshRePort(
                                    function()
                                        self:GetEnemyArray(
                                            function(list)
                                                local view = UIManagerIns:GetWindowCtrl(ui_cfg.ArenaChanllengeView.Name)
                                                if view then
                                                    view:Show()
                                                    view:OnEnemyArrayCall(list)
                                                    view:RefreshView()
                                                end
                                                view = UIManagerIns:GetWindowCtrl(ui_cfg.ArenaMainPanelView.Name)
                                                if view then
                                                    view:RefreshOnEmptyBattle()
                                                end
                                            end,
                                            true
                                        )
                                    end
                                )

                                if result then
                                    self.params.enemyCurScore = _data.info[4]
                                    self.params.enemyAddScore = _data.info[5] - _data.info[4]
                                    _G.Events:GetInstance():Broadcast(
                                        _G.eSeasonTask.Action,
                                        { _G.SeasonTaskID.Arena, 1 },
                                        1
                                    )
                                end
                                self.curResultView = self.params.view
                                self.curBattleController = _G.require(_G.BattleControllerType.arena).New()
                                self.curBattleController.leftName = _G.PlayerModel:GetInstance():GetName()
                                self.curBattleController.rightName = self.lastEnemyName
                                self.curBattleController:StartSettlement(
                                    _G.SettlementModel.SettlementType.arena,
                                    self.params
                                )
                            end,
                            true
                        )
                    else
                        --_G.PopWindowManager:GetInstance():ShowAllTips(300301)
                        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnSureCall, self)
                    end
                end
                _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, { _G.SeasonTaskID.Arena, 2 }, 1)
            end
        )
    end
end

function ArenaController:OnBattle(uids, skip)
    self.openEmbattleState = false

    if self.curEmbattleAttackTag then
        skip = skip or
        _G.PlayerPrefsManager.GetInt(_G.tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. 1) or 0
        local arenaClass = ArenaManager:GetInstance():GetArenaClass(1)
        if skip == 1 then
            --self:OnEmbattleQuit()
            self.datamType = self:GetEnemyDataByUid(self.curChallengeUid)
            -- _G.BattleManager:GetInstance():Settlement()
            ArenaNet:GetInstance():Fight(
                self.curChooseArenaSid,
                self.curChallengeUid,
                arenaClass:GetEnemyDataByUid(self.curChallengeUid).mType,
                _G.handlerbind(self, self.TiaoGuo)
            )
        else
            _G.BattleManager:GetInstance():EnterFight(
                _G.BattleControllerType.arena,
                self:GetRank(),
                arenaClass:GetEnemyDataByUid(self.curChallengeUid),
                _G.PlayerModel:GetInstance():GetName(),
                self.lastEnemyName
            )
            self.enterArenaBattle = true
        end
    else
        self:OnEmbattleQuit()
    end
end

---倒计时更新回调
---@param time number 剩余时间
function ArenaController:OnEndTimeUpdate(time)
    local timeStr = ""
    local t = _G.TimeUtil.TranslateSecond(time)
    if t.day > 0 then
        timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022100001), t.day, t.hour)
    elseif t.hour > 0 then
        timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90000011448), t.hour)
    else
        timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(90000010394), t.min)
    end
    if self.endTimeUpdateCall then
        self.endTimeUpdateCall(timeStr)
    end
end

