local PlatformDef = require("PlatformDef")

---@class BanmaModel : GameDataModelBase	秒约斑马H5
---@field GetInstance fun():BanmaModel
---@field showSvip boolean
local BanmaModel = _G.BaseClass("BanmaModel", _G.GameDataModelBase)

function BanmaModel:GetDataFormServer()
    local platform = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
    if platform == PlatformDef.PlatformIdDef.MYBanMaH5 then
        _G.SDKManager:GetInstance():IsShowSvip(_G.handler(self, self.OnShowSvipCallback))
    else
        self.showSvip = false
        self.super.ParseData(self)
    end
end

---监听SDK消息回调: 是否展示svip按钮
function BanmaModel:OnShowSvipCallback(ok, msg)
    if _G.AppSetting.DEBUG then
        _G.Log(msg, "IsShowSvip")
    end
    self.showSvip = false
    if ok and msg then
        self.showSvip = msg.isShow and msg.isShow ~= 0 and msg.isShow ~= "0"
    end
    self.super.ParseData(self)
end

---是否显示svip按钮
---@return boolean
function BanmaModel:IsShowSvip()
    return self.showSvip or false
end

function BanmaModel.CheckShowSvipBtn()
    return BanmaModel:GetInstance():IsShowSvip()
end

return BanmaModel
