local base = require("BaseGameNet")

---@class RechargeDrawNet : BaseGameNet	通信协议
local RechargeDrawNet = _G.BaseClass("RechargeDrawNet", base)
---@return RechargeDrawNet RechargeDrawNet
function RechargeDrawNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function RechargeDrawNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---获取信息
function RechargeDrawNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_day_raffle_info
    self:Access(item,self:GetEmptyPB(),callback)
end

---选择奖励
function RechargeDrawNet:ChooseAward(pbdata,callback)
    local item = _G.ConfigManager.net_map.game_day_raffle_choose
    self:Access(item,pbdata,callback)
end

---抽奖
function RechargeDrawNet:Draw(callback)
    local item = _G.ConfigManager.net_map.game_day_raffle_execute
    self:Access(item,self:GetEmptyPB(),callback)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RechargeDrawNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return RechargeDrawNet