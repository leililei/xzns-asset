---@class RechargeDrawSelectView : UIBaseView	中文描述
---@field public go_table RechargeDrawSelectView_GoTable GoTable
---@field selectAward table 当前选择的奖励
local RechargeDrawSelectView = _G.BaseClass("RechargeDrawSelectView", _G.UIBaseView)

function RechargeDrawSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RechargeDrawSelectView:OnCreate(award,callback)
    self.award = award
    self.callback = callback
    self.selectAward = {index = 0,item = nil}

    self.go_table.scrollloopvectical_awards:InitItemData(#self.award // 2, _G.handler(self,self.RefreshItem))
end


function RechargeDrawSelectView:RefreshItem(index, go)
    if index < 0 then
        return
    end
    index = index + 1
    local tb = _G.GetAutoGoTable(go)
    local count = self.award[index * 2]
    local sid = self.award[index * 2 - 1]

    tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(sid)

    if not tb.item then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.obj_award,
            function(item)
                if self:IsNil() then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                    return
                end
                tb.item = item
                item:Show(sid,_G.handlerbind(self,self.ItemOnChick,index, item),count)
                item:SetGou(index == self.selectAward.index and true or false)
            end
        )
    else
        tb.item:Show(sid,_G.handlerbind(self,self.ItemOnChick,index, tb.item),count)
        tb.item:SetGou(index == self.selectAward.index and true or false)
    end
end

function RechargeDrawSelectView:ItemOnChick(index,item)
    if index == self.selectAward.index then
        require "CommonTipManager":GetInstance():OpenTip(self.gameObject, self.award[index * 2 - 1])
    else
        item:SetGou(true)
        if self.selectAward.item then
            self.selectAward.item:SetGou(false)
        end
        self.selectAward.index = index
        self.selectAward.item = item
    end
end

---界面的销毁函数
function RechargeDrawSelectView:OnDestroy()
end

---按钮点击事件在这里派发
function RechargeDrawSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if self.selectAward.index ~= 0 and self.callback then
            self.callback(self.selectAward.index)
        end
        self:Close()
    end
end

return RechargeDrawSelectView