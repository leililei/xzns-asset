---@class RechargeDrawView : UIBaseView	中文描述
---@field public go_table RechargeDrawView_GoTable GoTable
local RechargeDrawView = _G.BaseClass("RechargeDrawView", _G.UIBaseView)

function RechargeDrawView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

---界面的入口函数
---@param activity RechargeDrawModel
function RechargeDrawView:OnCreate(activity)
    self.model = activity
    self:InitView()
    self:InitAni()
    self:UpdateView()
end

function RechargeDrawView:OnEnable()
    if self.awardAni then
        self.awardAni:Play("award_ruchang")
    end
end

---界面创建时的初始化方法
function RechargeDrawView:InitView()
    self.items = {}
end

---播放初始动画
function RechargeDrawView:InitAni()
    self.awardAni = self.go_table.obj_award:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    if self.awardAni then
        self.awardAni:Play("award_ruchang")
    end
end

---界面的更新方法
function RechargeDrawView:UpdateView()
    self.selectList = self.model:GetSelectList()
    self.awardCfg = self.model:GetAwardCfg()
    self.id = self.model:Getid()
    -- item生成
    local count = 1
    for type, v in pairs(self.awardCfg) do
        for index1, awards in pairs(v) do
            self:UpdateItem(self.go_table["obj_item" .. count], type, index1, awards)
            count = count + 1
        end
    end

    -- 按钮更新
    self.drawCount = self.model:GetDrawTime()
    self.recharge, self.condition = self.model:GetRechargeAndCondition()
    if self.drawCount > 0 then
        self.go_table.aortext_desc2.text = _G.GetLangPackValue(90033300005,
            string.format("<color=#96ce51>%s</color>", self.drawCount))
    else
        self.go_table.aortext_desc2.text = _G.GetLangPackValue(90033300005,
            string.format("<color=#d2510b>%s</color>", self.drawCount))
    end
    if not self.model:GetTodayTime() then
        -- 今天的累充金额 没有 达到
        local vouId = _G.GameUtil.GetVoucherArg(90033300004, 90036300038)
        local recharge = self.recharge // 100
        local condition = self.condition // 100
        if GameUtil.GetIsUseChinese() == false then
            recharge = self.recharge / 100
            condition = self.condition / 100
        end
        if self.recharge >= self.condition then
            self.go_table.aortext_desc1.text =
                _G.GetLangPackValue(
                vouId,
                _G.GameUtil.GetPriceContentByNum(recharge, true),
                _G.GameUtil.GetPriceContentByNum(condition, true)
            )
        else
            self.go_table.aortext_desc1.text =
                _G.GetLangPackValue(
                vouId,
                _G.GameUtil.GetPriceContentByNum(recharge, true),
                _G.GameUtil.GetPriceContentByNum(condition, true)
            )
        end
    else
        -- 今天的累充金额 已经 达到
        self.go_table.aortext_desc1.text = _G.GetLangPackValue(90033300009)
    end
    if self.drawCount > 0 then
        self.go_table.aorbtn_draw:SetGray(false)
        self.go_table.aortext_draw.text = _G.GetLangPackValue(90033300008)
        self.go_table.aortext_draw.color = _G.ColorTools.FormatColorByString("8C2D14")
    elseif not self.model:GetTodayTime() then
        -- 今日次数没有获得
        self.go_table.aorbtn_draw:SetGray(false)
        self.go_table.aortext_draw.text = _G.GetLangPackValue(90024200001)
        self.go_table.aortext_draw.color = _G.ColorTools.FormatColorByString("8C2D14")
    else
        -- 今日次数已获得，且次数用完
        self.go_table.aorbtn_draw:SetGray(true)
        self.go_table.aortext_draw.text = _G.GetLangPackValue(90027500002)
        self.go_table.aortext_draw.color = _G.ColorTools.FormatColorByString("434343")
    end
end

---播放重置奖励动画
function RechargeDrawView:PlayResetAwardAni()
    if self.awardAni then
        self.awardAni:Play("award_chongzhi")
    end
end

function RechargeDrawView:UpdateItem(obj, type, index1, awards)
    if not obj then
        return
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ItemOnClick, type, index1))

    if self.items[type] and self.items[type][index1] then
        -- item已生成
        self:SetItem(tb, type, index1, awards)
    else
        if not self.items[type] then
            self.items[type] = {}
        end
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.obj_award,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item)
                    return
                end
                self.items[type][index1] = item
                self:SetItem(tb, type, index1, awards)
            end)
    end
end

function RechargeDrawView:SetItem(tb, type, index1, awards)
    local item = self.items[type][index1]
    tb.obj_award:SetActiveE(1)
    tb.obj_change:SetActiveE(0)
    tb.obj_select:SetActiveE(0)
    if #awards == 2 then
        -- 配置表中只有一个奖励时
        item:Show(awards[1], nil, awards[2])
        item:SetGou(self.model:CheckAward(type, index1))
    elseif self.selectList[type] and self.selectList[type][index1] then
        -- 配置表中有多个奖励，并且有选择奖励
        local index2 = self.selectList[type][index1]
        item:Show(awards[index2 * 2 - 1], nil, awards[index2 * 2])
        item:SetGou(self.model:CheckAward(type, index1))
        tb.obj_change:SetActiveE(self.model:CheckAward(type, index1) and 0 or 1)
    else
        -- 配置表中有多个奖励，并且没有选择
        tb.obj_award:SetActiveE(0)
        tb.obj_select:SetActiveE(1)
    end
end

--- item点击方法
function RechargeDrawView:ItemOnClick(_, _, type, index1)
    if not (self.awardCfg[type] and self.awardCfg[type][index1]) then
        return
    end
    local sid
    if (#self.awardCfg[type][index1] // 2) > 1 then
        if not self.model:CheckAward(type, index1) then
            -- 选择奖励
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RechargeDrawSelectView.Name,
                self.awardCfg[type][index1],
                function(index)
                    if not index or index == 0 then
                        return
                    end
                    self.model:SelectAward(type, index1, index, function()
                        self:UpdateView()
                    end)
                end)
            return
        else
            local index2 = self.selectList[type][index1]
            sid = self.awardCfg[type][index1][index2 * 2 - 1]
        end
    end
    -- 弹出tip
    if not sid then
        sid = self.awardCfg[type][index1][1]
    end
    require "CommonTipManager":GetInstance():OpenTip(self.gameObject, sid)
end

---界面的销毁函数
function RechargeDrawView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

---按钮点击事件在这里派发
function RechargeDrawView:OnClickBtn(go)
    if go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 165)
    elseif go == self.go_table.aorbtn_draw then
        local todayTime = self.model:GetTodayTime()
        if self.drawCount > 0 then
            -- 抽奖
            for type = 3, 1, -1 do
                for index1, index2 in pairs(self.selectList[type]) do
                    if not index2 then
                        _G.PopWindowManager:GetInstance():ShowAllTips(1060001)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RechargeDrawSelectView.Name,
                            self.awardCfg[type][index1],
                            function(index)
                                if not index or index == 0 then
                                    return
                                end
                                self.model:SelectAward(type, index1, index, function()
                                    self:UpdateView()
                                end)
                            end)
                        return
                    end
                end
            end
            self.model:Draw(function()
                self:UpdateView()
            end)
        elseif not todayTime then
            -- 前往充值
            _G.JumpManager:GetInstance():Jump(211001)
        end
        -- 明日再来
    end
end

return RechargeDrawView
