---@class SociatyMobaMinKillRank : Component
---@field public go_table _obj_minKillRank_GoTable 中文描述
local SociatyMobaMinKillRank = _G.BaseClass("SociatyMobaMinKillRank", _G.Component)

function SociatyMobaMinKillRank:Awake()
end

function SociatyMobaMinKillRank:OnCreate(obj)
    self.parent = obj
    self.expand = false --初始不展开
    self.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.title = {
        _G.GetLangPackValue(90031700274),
        _G.GetLangPackValue(90031700272),
        _G.GetLangPackValue(90031700273)
    }
    self.color = {
        _G.ColorTools.FormatColorByString("77DA67"),
        _G.ColorTools.FormatColorByString("80BFFF"),
        _G.ColorTools.FormatColorByString("FF7B6B")
    }
    local path = "UIH5/SociatyMoba/$_obj_mobaMinKillRank"
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        self.parent,
        function(tran)
            if self.parent == nil then
                _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.Temporary)
                return
            end
            self.rankTran = tran
            self.go_table = _G.GetAutoGoTable(tran, _G.handler(self, self.OnClickBtn))
            self:OnChangeExpand()
            self:UpdateRankList()
        end
    )
end

function SociatyMobaMinKillRank:UpdateRankList()
    if self.go_table == nil then
        return
    end
    self.rankData, self.rank = require("SociatyMobaBattleModel"):GetInstance():GetKillRankData()
    local num = #self.rankData
    self.parent:SetActiveE(num > 0 and 1 or 0)
    if num == 0 then
        return
    end
    self.go_table.aortext_rankSelf.text = _G.GetLangPackValue(90029300023, _G.string.AddColor(self.rank, "E0C369"))
    if self.expand then
        if not self.rankInit then
            self.go_table.scrollloopvectical_rank:InitItemData(num, _G.handler(self, self.RefreshList))
            self.rankInit = true
        else
            if self.lastNum ~= num then
                self.go_table.scrollloopvectical_rank:UpdateCount(num)
            else
                self.go_table.scrollloopvectical_rank:UpdateAllItem()
            end
        end
        self.lastNum = num
    end
end

function SociatyMobaMinKillRank:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.rankData[index]
    
    if index > 3 then
        tb.aorimage_t3RankBg:SetActiveE(0)
        tb.aortext_rank:SetActiveE(1)
        tb.aortext_rank.text = index
    else
        tb.aorimage_t3RankBg:SetActiveE(1)
        tb.aortext_rank:SetActiveE(0)
        require("RankUtils").SetTop3RankStyle(index, tb.aorimage_t3RankBg, tb.aortext_t3Rank)
    end

    local color, title
    if data.isOur then
        if data.rank.uid == self.uid then
            color = self.color[1]
            title = self.title[1]
        else
            color = self.color[2]
            title = self.title[2]
        end
    else
        color = self.color[3]
        title = self.title[3]
    end
    tb.aortext_name.color = color
    tb.aortext_killNum.color = color

    tb.aortext_name.text = title .. data.rank.name
    tb.aortext_killNum.text = _G.GetLangPackValue(90031700276, data.value)
end

function SociatyMobaMinKillRank:OnChangeExpand()
    self.go_table.aorimage_expand:SetLocalScale(1, self.expand and 1 or -1, 1)
    self.go_table.aortext_expand:SetLocalScale(1, self.expand and 1 or -1, 1)
    self.go_table.aortext_expand.text = _G.GetLangPackValue(self.expand and 90031700270 or 90031700271)
    self.go_table.scrollloopvectical_rank:SetActiveE(self.expand and 1 or 0)
end

function SociatyMobaMinKillRank:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_expand then
        self.expand = not self.expand
        self:OnChangeExpand()
        if self.expand then
            self:UpdateRankList()
        end
    elseif go == self.go_table.aorbtn_rank then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaRankView.Name, 3)
    end
end

function SociatyMobaMinKillRank:Dispose()
end

return SociatyMobaMinKillRank
