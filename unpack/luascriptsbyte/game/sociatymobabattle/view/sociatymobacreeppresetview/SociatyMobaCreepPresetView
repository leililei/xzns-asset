local SociatyMobaModel = require("SociatyMobaModel")
---@class SociatyMobaCreepPresetView : UIBaseView	布阵
---@field public go_table SociatyMobaCreepPresetView_GoTable GoTable
local SociatyMobaCreepPresetView = _G.BaseClass("SociatyMobaCreepPresetView", _G.UIBaseView)

---1上路 2中路 3下路 4野区 Embattle布阵按钮
local BranchLine = {
    TopLaner = 1,
    MidLaner = 2,
    BotLaner = 3,
    Jungle = 4,
    Embattle = 5
}
---分线文本
local BranchLineStr = {
    [BranchLine.TopLaner] = _G.GetLangPackValue(90031700057),
    [BranchLine.MidLaner] = _G.GetLangPackValue(90031700058),
    [BranchLine.BotLaner] = _G.GetLangPackValue(90031700059),
    [BranchLine.Jungle] = _G.GetLangPackValue(90031700060),
    [BranchLine.Embattle] = _G.GetLangPackValue(90031700061)
}

function SociatyMobaCreepPresetView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaCreepPresetView:OnCreate(sid, presetData, call)
    self.curBranch = 4
    self.sid = sid
    self.presetData = presetData
    self.call = call
    self.uid2Sid = {}
    for k, v in pairs(self.presetData) do
        for _, uid in pairs(v.uids) do
            self.uid2Sid[uid] = v.sid
        end
    end
    ---所有分线的数据
    self.allLineInfo = {}
    self.lineInfo = {}
    self.isCommander = SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman()
    self.halfY = _G.CS.Launcher.Inst.ScreenSize.y // 2
    self:RefreshLineInfo()
end

---刷新分线数据
function SociatyMobaCreepPresetView:RefreshLineInfo()
    ---拉取当前分线的数据
    self.allLineInfo = {}
    SociatyMobaModel:GetInstance():GetLineInfo(0, _G.handler(self, self.RefreshView))
end

---刷新队伍数量
function SociatyMobaCreepPresetView:RefreshTeamNum()
    --self.go_table.aortext_sociatyTitle.text = _G.GetLangPackValue(90031700062, #self.lineInfo)
end

---刷新界面
function SociatyMobaCreepPresetView:RefreshView(msg)
    if self:IsNil() then
        return
    end
    if msg then
        for _, v in pairs(msg) do
            if v.line_id == self.curBranch then
                self.allLineInfo[v.line_id] = v.role
            end
        end
        if not _G.table.isEmptyOrNil(self.allLineInfo[self.curBranch]) then
            self.allLineInfo[self.curBranch] = _G.table.chooseToArray(
                self.allLineInfo[self.curBranch],
                function(_, v)
                    return self.uid2Sid[v.uid] == self.sid
                end
            )
            _G.table.sort(
                self.allLineInfo[self.curBranch],
                function(a, b)
                    local aSid, bSid
                    if self.uid2Sid[a.uid] == self.sid then
                        aSid = 3
                    elseif self.uid2Sid[a.uid] == nil then
                        aSid = 2
                    else
                        aSid = 1
                    end
                    if self.uid2Sid[b.uid] == self.sid then
                        bSid = 3
                    elseif self.uid2Sid[b.uid] == nil then
                        bSid = 2
                    else
                        bSid = 1
                    end
                    if aSid ~= bSid then
                        return aSid > bSid
                    end
                    return a.power > b.power
                end
            )
        end
    end
    self:RefreshTeam()
end

function SociatyMobaCreepPresetView:RefreshList(index, obj)
    index = index + 1
    ---@type SociatyMobaCreepPresetView._obj_teamItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTeam, index))
    local data = self.lineInfo[index]
    ---头像，头像框
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false)
    ---名字
    tb.aortext_name.text = data.name
    ---战力
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    ---设置卡牌
    self:SetCardItem(tb, data.cards or {}, false)
    ---设置合击技
    if _G.AppSetting.IsXzns then
        self:SetBeastItem(tb, data.beast or {0, 0, 0})
    else
        self:SetCombineItem(tb, data.combine or {0, 0, 0})
    end
    local hasSet, sid = self:GetPlayerPreset(data.uid)
    local name = ""
    if hasSet then
        local cfg = _G.ConfigManager.guild_moba_campsite_cfg[sid]
        if cfg.id == 4 then
            name = _G.GetLangPackValue(90031700198)
        elseif cfg.id == 5 then
            name = _G.GetLangPackValue(90031700197)
        else
            name = _G.GetLangPackValue(cfg.name[1][1])
        end
    end
    tb.aortext_preset.text = hasSet and _G.GetLangPackValue(90031700196, name) or ""
    tb.aorbtn_adjust:SetLocalPosition(364, hasSet and -15 or 0, 0)
    tb.aorbtn_adjust:SetGray(not self.isCommander)
    tb.aortext_adjust.text = _G.GetLangPackValue(hasSet and 90031700199 or 90031700200)
    tb.aortext_adjust.color = _G.ColorTools.FormatColorByString(self.isCommander and 914801 or 444444)
end

function SociatyMobaCreepPresetView:OnClickTeam(go, isOn, index)
    self.curUid = self.lineInfo[index].uid
    if not SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman() then
        return
    end
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
    if state ~= SE.Adjustline then
        _G.PopWindowManager:GetInstance():ShowAllTips(950111)
        return
    end
    local x, y, z = go:GetPosition()
    x, y = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, z)
    local y1 = y - self.halfY
    y1 = y1 < 0 and y1 + 87 or y1 - 87
    self.go_table.aorimage_line:SetLocalPosition(537, y1)
    self:RefreshBranchBtn()
end

---设置卡牌
---@param cards table 卡牌数据
---@param isCardData boolean 是否是卡牌数据
function SociatyMobaCreepPresetView:SetCardItem(tb, cards, isCardData)
    if tb.itemList then
        for _, v in ipairs(tb.itemList) do
            _G.ItemFactory:GetInstance():SetItemCard(v)
        end
    end
    tb.itemList = {}
    for _, v in ipairs(cards) do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            tb.obj_team,
            function(itemLua)
                if _G.IsNil(tb.obj_team) then
                    _G.ItemFactory:GetInstance():SetItemCard(itemLua)
                    return
                end
                _G.table.insert(tb.itemList, itemLua)
                ---@type ItemCardStorageView
                if isCardData then
                    itemLua:ShowCardData(v)
                else
                    itemLua:Show(v.card_sid, nil, v.star, v.soul_lv, v.card_lv, v.uid, nil, v.soul_state)
                end
                itemLua:ShowLevel(300)
            end
        )
    end
end

---设置圣兽
function SociatyMobaCreepPresetView:SetBeastItem(tb, beast)
    local item, beastCfg, skillId, cfgt
    for i = 1, 3 do
        item = _G.GetAutoGoTable(tb["obj_petSkills" .. i])
        if beast[i] and beast[i].sid > 0 then
            item.gameObject:SetActiveE(1)
            beastCfg = _G.ConfigManager.pet_xzns_cfg[beast[i].sid]
            skillId = beastCfg.skill_id[1][1]
            cfgt = _G.ConfigManager.card_skills_cfg[skillId]
            item.aorrawimage_icon:LoadImage(beastCfg and beastCfg.icon_1 or "")
        else
            item.gameObject:SetActiveE(0)
        end
    end
end

---设置合击技
function SociatyMobaCreepPresetView:SetCombineItem(tb, combine)
    local combineItem, petCfg, skillId, cfgt, cfg
    for i = 1, 3 do
        combineItem = _G.GetAutoGoTable(tb["obj_petSkills" .. i])
        if combine[i] and combine[i] > 0 then
            petCfg = _G.ConfigManager.pet_cfg[combine[i]]
            skillId = petCfg.skill_id[1]
            cfgt = _G.ConfigManager.card_skills_cfg[skillId]
            cfg = _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]

            combineItem.aorrawimage_icon:LoadImage(cfg.Icon)
            -- combineItem.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            -- combineItem.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
            -- combineItem.aorimage_bg.SpriteName = PetOrderFrame[petCfg.Order]
        else
            combineItem.gameObject:SetActiveE(0)
        end
    end
end

function SociatyMobaCreepPresetView:GetPlayerPreset(uid)
    for k, v in pairs(self.presetData) do
        if _G.table.ContainsValue(v.uids, uid) then
            return true, v.sid
        end
    end
    return false, 0
end

---刷新当前分线的队伍
function SociatyMobaCreepPresetView:RefreshTeam()
    self.lineInfo = self.allLineInfo[self.curBranch] or {}
    if _G.table.isEmptyOrNil(self.lineInfo) then
        self.go_table.aortext_emptyTip:SetActiveE(1)
    else
        self.go_table.aortext_emptyTip:SetActiveE(0)
    end
    ---刷新队伍数量
    self:RefreshTeamNum()

    if not self.teamListView then
        self.go_table.scrollloopvectical_team:InitItemData(#self.lineInfo, _G.handler(self, self.RefreshList))
        self.teamListView = self.go_table.scrollloopvectical_team
    else
        self.teamListView:UpdateCount(#self.lineInfo)
    end
end

---刷新分线按钮
function SociatyMobaCreepPresetView:RefreshBranchBtn()
    self.showBranch = not self.showBranch
    self.go_table.aorbtn_branch:SetActiveE(self.showBranch and 1 or 0)
    if self.showBranch then
        self.branchData = {}
        for _, v in pairs(self.presetData) do
            if v.sid ~= self.uid2Sid[self.curUid] then
                _G.table.insert(self.branchData, _G.ConfigManager.guild_moba_campsite_cfg[v.sid])
            end
        end

        _G.table.sort(
            self.branchData,
            function(a, b)
                return a.id < b.id
            end
        )
        if not self.BranchListView then
            self.BranchListView = self.go_table.scrollloopvectical_toggle
            self.BranchListView:InitItemData(#self.branchData, _G.handler(self, self.RefreshBranchItem))
        else
            self.BranchListView:UpdateCount(#self.branchData)
        end
    end
end

function SociatyMobaCreepPresetView:RefreshBranchItem(index, obj)
    index = index + 1
    local cfg = self.branchData[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClcikBranchItem, cfg.id))
    local name
    if cfg.id == 4 then
        name = _G.GetLangPackValue(90031700198)
        tb.aortext_label1.fontSize = 20
    elseif cfg.id == 5 then
        name = _G.GetLangPackValue(90031700197)
        tb.aortext_label1.fontSize = 20
    else
        name = _G.GetLangPackValue(cfg.name[1][1])
        tb.aortext_label1.fontSize = 24
    end
    tb.aortext_label1.text = name
    -- tb.aortext_label2.text = BranchLineStr[index]
end

function SociatyMobaCreepPresetView:OnClcikBranchItem(_, _, sid)
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
    if state ~= SE.Adjustline then
        _G.PopWindowManager:GetInstance():ShowAllTips(950111)
        return
    end
    if self.uid2Sid[self.curUid] then
        _G.table.removebyvalue(self.presetData[self.uid2Sid[self.curUid]].uids, self.curUid)
    end
    _G.table.insert(self.presetData[sid].uids, self.curUid)
    self.uid2Sid[self.curUid] = sid
    self.go_table.scrollloopvectical_team:UpdateAllItem()
    self:RefreshBranchBtn()
end

function SociatyMobaCreepPresetView:OnDestroy()
    if self.call then
        self.call()
    end
end

---界面的销毁函数
function SociatyMobaCreepPresetView:Dispose()
    self.go_table = nil
end

---按钮点击事件在这里派发
function SociatyMobaCreepPresetView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_closeView" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_adjust" then
        ---调整
        self:RefreshBranchBtn()
    elseif name == "@_aorbtn_branch" then
        self:RefreshBranchBtn()
    end
end

return SociatyMobaCreepPresetView
