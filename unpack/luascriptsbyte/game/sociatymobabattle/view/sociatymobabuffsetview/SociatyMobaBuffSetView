---发送消息(ZHJ-36367废弃)
function SociatyMobaBuffSetView:SendMsg(data, index)
    local btnData = data.btn[index]
    if btnData.isGray then
        if btnData.num == 0 then
            --无法对%s（分线名称）进行使用
            -- local content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[821].content, _G.LangUtil.GetLangPackValue(lineName[index]))
            _G.PopWindowManager:GetInstance():ShowAllTips(950110)
        elseif btnData.numSelfTeam == 0 then
            --该分线无队伍
            _G.PopWindowManager:GetInstance():ShowAllTips(822)
        elseif btnData.numOtherTeam == 0 then
            --已攻破敌方%s（分线名称），无法使用
            local content =
                _G.LangUtil.GetLangPackValue(
                _G.ConfigManager.tips_system_cfg[823].content,
                _G.LangUtil.GetLangPackValue(lineName[index])
            )
            _G.PopWindowManager:GetInstance():ShowAllTips(823, content)
        end
    else
        local id = self.ids[data.index].id
        if data.type == 2 then
            local CreepState = SociatyMobaBattleModel:GetInstance().CreepState
            for _, v in pairs(SociatyMobaBattleModel:GetInstance().creepData) do
                if v.cfg.type == 2 and v.state == CreepState.OurWin and v.use == 0 then
                    id = v.cfg.id
                    break
                end
            end
        end
        SociatyMobaBattleModel:GetInstance():SendUseBuff(id, index)
    end
end

function SociatyMobaBuffSetView:RefreshList()
    self:CheckSelfPreset()
    self.go_table.scrollloopvectical_buffList:UpdateAllItem()
end

---公会点击选中
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function SociatyMobaBuffSetView:OnItemClickBtn(go, isOn, index)
    local ctrl = self.SociatyItemList[index]
    if go == ctrl.aorbtn_preset then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyMobaCreepPresetView.Name,
            self.ids[ctrl.index].id,
            self.presetData,
            _G.handler(self, self.RefreshList)
        )
    elseif go == ctrl.aorbtn_line then
        if not self.canSet then
            return
        end
        local sid = self.ids[ctrl.index].id
        local newType = self.presetData[sid].use_type + 1
        if newType > 3 then
            newType = 1
        end
        self.presetData[sid].use_type = newType
        ctrl.aortext_preName.text = UseType[newType]
    elseif go == ctrl.aorbtn_presetSelf then
        self.isCommander = SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman()
        local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
        local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
        if not (state == SE.Match or state == SE.Embattle or state == SE.EmbattleAllDay) then
            if not self.isCommander then
                _G.PopWindowManager:GetInstance():ShowAllTips(950111)
                return
            elseif self.isCommander and state ~= SE.Adjustline then
                _G.PopWindowManager:GetInstance():ShowAllTips(950111)
                return
            end
        end
        local sid = self.ids[ctrl.index].id
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()

        if self.isCommander and state == SE.Adjustline then
            if self.preSid > 0 then
                if self.preSid == sid then
                    _G.table.removebyvalue(self.presetData[sid].uids, uid)
                    SociatyMobaBattleModel:GetInstance():SetWildPreset(
                        self.presetData,
                        1,
                        function()
                            self.preSid = 0
                            self:RefreshList()
                        end
                    )
                end
            else
                -- _G.UIUtils.LoadEffectByCfg(
                --     _G.ConfigManager.ui_effect_cfg.ef_huoyanbaokai_effect,
                --     ctrl.aorbtn_presetSelf,
                --     function(trans)
                --         if not self.go_table then
                --             _G.DestroyObject(trans)
                --             return
                --         end
                --     end
                -- )
                _G.table.insert(self.presetData[sid].uids, uid)
                SociatyMobaBattleModel:GetInstance():SetWildPreset(
                    self.presetData,
                    1,
                    function()
                        self.preSid = sid
                        self:RefreshList()
                    end
                )
            end
        else
            if self.preSid > 0 then
                if self.preSid == sid then
                    local presets = {
                        {
                            sid = sid,
                            use_type = self.presetData[sid].use_type,
                            uids = {}
                        }
                    }
                    SociatyMobaBattleModel:GetInstance():SetWildPreset(
                        presets,
                        3,
                        function()
                            _G.table.removebyvalue(self.presetData[sid].uids, uid)
                            self.preSid = 0
                            self:RefreshList()
                        end
                    )
                else
                    local presets = {
                        {
                            sid = sid,
                            use_type = self.presetData[sid].use_type,
                            uids = {uid}
                        }
                    }
                    SociatyMobaBattleModel:GetInstance():SetWildPreset(
                        presets,
                        2,
                        function()
                            _G.table.removebyvalue(self.presetData[self.preSid].uids, uid)
                            _G.table.insert(self.presetData[sid].uids, uid)
                            self.preSid = sid
                            self:RefreshList()
                        end,
                        self.preSid
                    )
                end
            else
                -- _G.UIUtils.LoadEffectByCfg(
                --     _G.ConfigManager.ui_effect_cfg.ef_huoyanbaokai_effect_1,
                --     ctrl.aorbtn_presetSelf,
                --     function(trans)
                --         if not self.go_table then
                --             _G.DestroyObject(trans)
                --             return
                --         end
                --     end
                -- )
                local presets = {
                    {
                        sid = sid,
                        use_type = self.presetData[sid].use_type,
                        uids = {uid}
                    }
                }
                SociatyMobaBattleModel:GetInstance():SetWildPreset(
                    presets,
                    2,
                    function()
                        _G.table.insert(self.presetData[sid].uids, uid)
                        self.preSid = sid
                        self:RefreshList()
                    end
                )
            end
        end
    end
end

---按钮点击事件在这里派发
function SociatyMobaBuffSetView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

function SociatyMobaBuffSetView:CheckSelfPreset()
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for k, v in pairs(self.presetData) do
        if _G.table.ContainsValue(v.uids, uid) then
            self.preSid = k
            return
        end
    end
    self.preSid = 0
end

function SociatyMobaBuffSetView:OnMemberQuit(uid)
    for _, v in pairs(self.presetData) do
        _G.table.removebyvalue(v.uids, uid)
    end
    SociatyMobaBattleModel:GetInstance():GetLineInfo(
        0,
        function(data)
            self:SetBuffInfo()
        end,
        true
    )
end

function SociatyMobaBuffSetView:OnDestroy()
    if SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman() then
        local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
        local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
        if state ~= SE.Adjustline then
            -- _G.PopWindowManager:GetInstance():ShowAllTips(950111)
            return
        end
        SociatyMobaBattleModel:GetInstance():SetWildPreset(self.presetData, 1)
    end
end

function SociatyMobaBuffSetView:Dispose()
    self:RemoveAllListener()
end

return SociatyMobaBuffSetView
