---界面的入口函数
function SociatyMobaBuffSetView:OnCreate(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaBuffChange, self.SetBuffInfo)
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnMemberQuit)
    self.isCommander = SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman()
    self.SociatyItemList = {}
    self.presetData = _G.DeepCopy(SociatyMobaBattleModel:GetInstance().creepPreset)
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
    self.canSet = state == SE.Adjustline
    self.canSet = self.isCommander and self.canSet
    self:CheckSelfPreset()
    SociatyMobaBattleModel:GetInstance():GetLineInfo(
        0,
        function(data)
            self:SetBuffInfo()
        end
    )
end

function SociatyMobaBuffSetView:SetBuffInfo()
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg
    self.ids = {}
    for _, v in pairs(cfg) do
        if v.type ~= 1 then
            _G.table.insert(self.ids, v)
        end
    end
    if not self.initscrolll then
        self.go_table.scrollloopvectical_buffList:InitItemData(#self.ids, _G.handler(self, self.OnRefreshLoopListItem))
        self.initscrolll = true
    else
        self.go_table.scrollloopvectical_buffList:UpdateAllItem()
    end
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function SociatyMobaBuffSetView:OnRefreshLoopListItem(index, item)
    if index < 0 then
        return
    end
    local eIndex = index + 1
    local id = item:GetInstanceIDE()
    ---@type SociatyMobaBuffSetView._obj_item_GoTable
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, id))
        self.SociatyItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.ids[eIndex]
    ctrl.aorrawimage_icon:LoadImage(
        data.icon[1][1],
        function(tran)
            if not self.go_table then
                _G.DestroyObject(tran)
                return
            end
            ctrl.aorrawimage_icon:SetNativeSize()
        end
    )
    ctrl.aortext_buffName.text = _G.LangUtil.GetLangPackValue(data.name[1][1])
    local num = SociatyMobaBattleModel:GetInstance():GetCreepLanerNotUseNum(data.type)
    -- ctrl.aortext_buffNum.text = _G.LangUtil.GetLangPackValue(90020200033) .. num
    ctrl.aortext_buffNum.text = ""
    ctrl.aortext_des.text = _G.LangUtil.GetLangPackValue(data.effect_describe)
    local isAuto = #data.effect > 0 and data.effect[2] == 1
    ctrl.obj_btns:SetActiveE(isAuto and 0 or 1)
    ctrl.aortext_desEffect:SetActiveE(isAuto and 1 or 0)
    ctrl.aortext_des1.text = _G.GetLangPackValue(90031700201, #self.presetData[data.id].uids)
    if not isAuto then
        ctrl.aortext_preName.text = UseType[self.presetData[data.id].use_type]
    end
    ctrl.aorbtn_line:SetGray(not self.canSet)
    ctrl.aortext_preName.color = _G.ColorTools.FormatColorByString(self.canSet and 914801 or 444444)
    SociatyMobaBattleModel:GetInstance():CheckCreepPresetEmpty(
        data.id,
        self.presetData,
        function(isEmpty)
            ctrl.obj_teamRedpoint:SetActiveE((isEmpty and self.isCommander) and 1 or 0)
        end
    )
    ctrl.aorimage_selfRedpoint:SetActiveE(self.preSid == 0 and 1 or 0)
    ctrl.aorbtn_presetSelf:SetGray(self.preSid ~= data.id and self.preSid ~= 0)
    ctrl.aorbtn_presetSelf:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
    _G.ColorTools.FormatColorByString(self.preSid ~= data.id and self.preSid ~= 0 and "A9A9A9" or "FFFFFF")
    ctrl.aortext_btnName.text = self.preSid == data.id and _G.GetLangPackValue(90031700216) or _G.GetLangPackValue(90031700215)
    ctrl.aortext_btnName.color = _G.ColorTools.FormatColorByString(self.preSid ~= data.id and self.preSid ~= 0 and "434343" or "8C2D14")

    -- if ctrl.curPreEff == nil then
    --     ctrl.curPreEff = true
