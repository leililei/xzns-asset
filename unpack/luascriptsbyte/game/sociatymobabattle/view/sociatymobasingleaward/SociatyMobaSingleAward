local SociatyMobaModel = require("SociatyMobaModel")
---@class SociatyMobaSingleAward : Component	每场战斗奖励
---@field go_table SociatyMobaRankView._obj_single_GoTable
local SociatyMobaSingleAward = _G.BaseClass("SociatyMobaSingleAward", _G.Component)

---类的构造函数
function SociatyMobaSingleAward:__init(obj, mParentView)
    self.gameObject = obj
    self.mParentView = mParentView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.sociatyLevel = SociatyMobaModel:GetInstance().SociatyLevel
end

---隐藏界面
function SociatyMobaSingleAward:Hide()
    self.gameObject:SetActiveE(0)
end

function SociatyMobaSingleAward:Show(isShow)
    if not isShow then
        self:Hide()
        return
    end
    self.gameObject:SetActiveE(1)
    ---赛季场次
    self:UpdateView()
    self.selectIndex = 1
    ---当前段位等级
    self.curSociatyLevel = SociatyMobaModel:GetInstance():GetSociatyLevel()
    ---下一场比赛是否满足匹配条件
    self.isCanMatch = SociatyMobaModel:GetInstance():IsCanMatch()
    self:InitView()
    ---下拉列表是否展开
    self.unfold = false
    self:RefreshPanel()
end

function SociatyMobaSingleAward:ShowEffect()
    if not self.lightEffWin then
        self.lightEffWin = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_saoguang,
            self.go_table.aorrawimage_win,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                self.lightEffWin = trans
                self.lightEffWin:SetActiveE(0)
                self.lightEffWin:SetActiveE(1)
            end
        )
    elseif self.lightEffWin ~= true then
        self.lightEffWin:SetActiveE(0)
        self.lightEffWin:SetActiveE(1)
    end

    if not self.lightEffLose then
        self.lightEffLose = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_saoguang,
            self.go_table.aorrawimage_lose,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                self.lightEffLose = trans
                self.lightEffLose:SetActiveE(0)
                self.lightEffLose:SetActiveE(1)
            end
        )
    elseif self.lightEffLose ~= true then
        self.lightEffLose:SetActiveE(0)
        self.lightEffLose:SetActiveE(1)
    end
end

function SociatyMobaSingleAward:SetEffPos()
    local data = self.battleData[self.selectIndex]
    if data.award and data.pos == self.selectSociatyLevel then
        self.lightEffWin:SetParentE(data.win and self.go_table.aorrawimage_win or self.go_table.aorrawimage_lose)
        self.lightEffWin:SetActiveE(0)
        self.lightEffWin:SetActiveE(1)
    else
        self.lightEffWin:SetActiveE(0)
    end
end

function SociatyMobaSingleAward:UpdateView()
    ---赛季场次
    self.seasonIndex = SociatyMobaModel:GetInstance():GetSeasonIndex()
    local seasonId = SociatyMobaModel:GetInstance():GetSeasonId()
    ---服务期下发的战斗数据
    self.battleData = SociatyMobaModel:GetInstance():GetBattleInfo()
    local haveData = false
    for _, v in pairs(self.battleData) do
        if v.f_season_id == seasonId and self.seasonIndex == v.f_index then
            haveData = true
            break
        end
    end
    if not haveData then
        _G.table.insert(self.battleData, {f_index = self.seasonIndex, f_season_id = seasonId})
    end
    _G.SortList(
        self.battleData,
        function(a)
            return a.f_season_id, a.f_index
        end
    )
end

function SociatyMobaSingleAward:InitView()
    local data = self.battleData[self.selectIndex]
    if data and data.award then
        self.selectSociatyLevel = data.pos
    else
        ---当前选中的段位等级(默认选中当前段位)
        if not self.isCanMatch then
            self.selectSociatyLevel = self.sociatyLevel.YellowLevel
        else
            self.selectSociatyLevel = self.curSociatyLevel
        end
    end
    self.go_table["toggle_tab" .. self.selectSociatyLevel].isOn = true
    if self.isCanMatch then
        self.go_table.obj_curLevel:SetActiveE(1)
        self.go_table.obj_curLevel:SetAnchorPosition(134 + (self.selectSociatyLevel - 1) * 150, 29.2)
    else
        self.go_table.obj_curLevel:SetActiveE(0)
    end
end

---刷新奖励
function SociatyMobaSingleAward:RefreshPanel()
    local config = _G.ConfigManager.guild_moba_normal_cfg[self.selectSociatyLevel]
    self:RefreshDropDown()
    local battleInfo = SociatyMobaModel:GetInstance():GetBattleInfo()
    local data = self.battleData[self.selectIndex]
    for i, info in pairs(battleInfo) do
        if info.f_season_id == data.f_season_id and info.f_index == data.f_index then
            self.sociatyBuildLevel = info.build_lv
            break
        end
    end
    if self.sociatyBuildLevel == nil then
        self.sociatyBuildLevel = require("SociatyModel"):GetInstance():GetBuildLevel(5)
    end
    self:RefreshWinAward(config.win_rewards)
    self:RefreshLoseAward(config.lose_rewards)
    self:ShowEffect()
    self:RefreshBtnAndTip()
end

function SociatyMobaSingleAward:RefreshBtnAndTip()
    local data = self.battleData[self.selectIndex]
    local canGet = data.award and data.award == 1 and data.pos == self.selectSociatyLevel
    self.go_table.aortext_tip:SetActiveE(canGet and 0 or 1)
    self.go_table.aorbtn_get:SetActiveE(canGet and 1 or 0)
    if canGet then
        self.go_table.aorbtn_get:SetLocalPosition(data.win and -227 or 156, -232, 0)
    end
end

---胜利法奖励
function SociatyMobaSingleAward:RefreshWinAward(winAwardsCfg)
    local winAwards = {}
    for i,v in ipairs(winAwardsCfg) do
        winAwards[i] = v
    end
    local cfg = _G.ConfigManager.guild_unit_cfg[5]
    if self.sociatyBuildLevel > 1 then
        local privilegeCfg = cfg.privilege[self.sociatyBuildLevel]
        for i = 1, #privilegeCfg, 3 do
            _G.table.insert(winAwards,{privilegeCfg[i + 1],privilegeCfg[i + 2]})
        end
    end
    self.winAwards = winAwards
    if not self.winListView then
        self.go_table.scrollloophorizontal_win:InitItemData(#self.winAwards, _G.handler(self, self.RefreshWinItem))
        self.winListView = self.go_table.scrollloophorizontal_win
    else
        self.winListView:UpdateCount(#self.winAwards)
    end
    local winScale = #self.winAwards > 2 and 0.85 or 1
    self.go_table.obj_ContentWin:SetLocalScale(winScale, winScale, winScale)
end

function SociatyMobaSingleAward:RefreshWinItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:RemoveAllChildren()
    local data = self.battleData[self.selectIndex]
    local canGet = data.award and data.win and data.award == 1 and data.pos == self.selectSociatyLevel
    canGet = canGet and true or false
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.winAwards[eIndex],
        tb.obj_item,
        function(tran)
            if tran.ShowNumText then
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            tran:ShowEffect(canGet)
        end
    )
end

---失败方奖励
function SociatyMobaSingleAward:RefreshLoseAward(loseAwardsCfg)
    local loseAwards = {}
    for i,v in ipairs(loseAwardsCfg) do
        loseAwards[i] = v
    end
    local cfg = _G.ConfigManager.guild_unit_cfg[5]
    if self.sociatyBuildLevel > 1 then
        local privilegeCfg = cfg.privilege[self.sociatyBuildLevel]
        for i = 1, #privilegeCfg, 3 do
            _G.table.insert(loseAwards,{privilegeCfg[i + 1],privilegeCfg[i + 2]})
        end
    end
    self.loseAwards = loseAwards
    if not self.loseListView then
        self.go_table.scrollloophorizontal_lose:InitItemData(#self.loseAwards, _G.handler(self, self.RefreshLoseItem))
        self.loseListView = self.go_table.scrollloophorizontal_lose
    else
        self.loseListView:UpdateCount(#self.loseAwards)
    end
    local loseScale = #self.loseAwards > 2 and 0.85 or 1
    self.go_table.obj_ContentLose:SetLocalScale(loseScale, loseScale, loseScale)
end

function SociatyMobaSingleAward:RefreshLoseItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:RemoveAllChildren()
    local data = self.battleData[self.selectIndex]
    local canGet = data.award and not data.win and data.award == 1 and data.pos == self.selectSociatyLevel
    canGet = canGet and true or false
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.loseAwards[eIndex],
        tb.obj_item,
        function(tran)
            if tran.ShowNumText then
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:ShowEffect(canGet)
            end
        end
    )
end

---刷新下拉列表
function SociatyMobaSingleAward:RefreshDropDown()
    self.go_table.aorbtn_down:SetActiveE(not self.unfold and 1 or 0)
    self.go_table.aorbtn_up:SetActiveE(self.unfold and 1 or 0)
    self.go_table.obj_options:SetActiveE(self.unfold and 1 or 0)
    local data = self.battleData[self.selectIndex]
    self.go_table.aortext_dropdown.text = _G.GetLangPackValue(90031700122, data.f_season_id, data.f_index)
    if self.unfold then
        if not self.optionListView then
            self.go_table.scrollloopvectical_optation:InitItemData(
                #self.battleData,
                _G.handler(self, self.RefreshOptionItem)
            )
            self.optionListView = self.go_table.scrollloopvectical_optation
        else
            self.optionListView:UpdateAllItem()
        end
    end
end

function SociatyMobaSingleAward:RefreshOptionItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOption, eIndex))
    local data = self.battleData[eIndex]
    tb.aortext_label.text = _G.GetLangPackValue(90031700122, data.f_season_id, data.f_index)
    tb.aorimage_select:SetActiveE(self.selectIndex == eIndex and 1 or 0)

    local canGet = data.award and data.award == 1
    tb.obj_redPoint:SetActiveE(canGet and 1 or 0)
end

function SociatyMobaSingleAward:OnClickOption(_, _, eIndex)
    if self.selectIndex == eIndex then
        return
    end
    self.selectIndex = eIndex
    local data = self.battleData[eIndex]
    if not data.award and data.f_index == self.seasonIndex then
        ---即将开始的一场战斗获取实时数据
        self:InitView()
        self:RefreshPanel()
    else
        if data and data.award then
            self.selectSociatyLevel = data.pos
            self.go_table.obj_curLevel:SetActiveE(1)
            self.go_table.obj_curLevel:SetAnchorPosition(134 + (self.selectSociatyLevel - 1) * 150, 29.2)
        else
            self.selectSociatyLevel = self.sociatyLevel.YellowLevel
            self.go_table.obj_curLevel:SetActiveE(0)
        end
        if self.go_table["toggle_tab" .. self.selectSociatyLevel].isOn == true then
            self:RefreshPanel()
        end
        self.go_table["toggle_tab" .. self.selectSociatyLevel].isOn = true
    end
    self:RefreshDropDown()
    self:ShowEffect()
end

---领取奖励
---@param seasonIndex number 索引
function SociatyMobaSingleAward:OnGetFightAward(seasonIndex, seasonId, seasonCfgId, isWinAward)
    SociatyMobaModel:GetInstance():GetFightAward(
        1,
        seasonId,
        seasonIndex,
        seasonCfgId,
        function()
            self:UpdateView()
            if isWinAward then
                self.go_table.scrollloophorizontal_win:UpdateAllItem()
            else
                self.go_table.scrollloophorizontal_lose:UpdateAllItem()
            end
            self:RefreshDropDown()
            self:RefreshBtnAndTip()
        end
    )
end

function SociatyMobaSingleAward:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_tab1 then
        ---黄级
        if isOn then
            self.selectSociatyLevel = self.sociatyLevel.YellowLevel
            self:RefreshPanel()
        end
    elseif go == self.go_table.toggle_tab2 then
        ---玄级
        if isOn then
            self.selectSociatyLevel = self.sociatyLevel.ProfoundLevel
            self:RefreshPanel()
        end
    elseif go == self.go_table.toggle_tab3 then
        ---地级
        if isOn then
            self.selectSociatyLevel = self.sociatyLevel.PrefectureLevel
            self:RefreshPanel()
        end
    elseif go == self.go_table.toggle_tab4 then
        ---天级
        if isOn then
            self.selectSociatyLevel = self.sociatyLevel.HeavenlyLevel
            self:RefreshPanel()
        end
    elseif go == self.go_table.aorbtn_dropdown then
        ---下拉列表
        self.unfold = not self.unfold
        self:RefreshDropDown()
    elseif go == self.go_table.aorbtn_win then
        ---ZHJ-36442 仅能通过按钮领取，优化单没写，成了bug
        -- local data = self.battleData[self.selectIndex]
        -- if data.award and data.win and data.award == 1 and data.pos == self.selectSociatyLevel then
        --     self:OnGetFightAward(data.f_index, data.f_season_id, data.season_cfg_id, true)
        -- end
    elseif go == self.go_table.aorbtn_lose then
        -- local data = self.battleData[self.selectIndex]
        -- if data.award and not data.win and data.award == 1 and data.pos == self.selectSociatyLevel then
        --     self:OnGetFightAward(data.f_index, data.f_season_id, data.season_cfg_id)
        -- end
    elseif go == self.go_table.aorbtn_get then
        local data = self.battleData[self.selectIndex]
        if data.award and data.award == 1 and data.pos == self.selectSociatyLevel then
            self:OnGetFightAward(data.f_index, data.f_season_id, data.season_cfg_id, data.win)
        end
    end
end

return SociatyMobaSingleAward
