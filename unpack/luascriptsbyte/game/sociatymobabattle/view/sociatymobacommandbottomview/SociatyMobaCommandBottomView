local SociatyMobaCommandBottomView = _G.BaseClass("SociatyMobaCommandBottomView", _G.UIBaseView)

function SociatyMobaCommandBottomView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaCommandBottomView:OnCreate()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end

---界面的销毁函数
function SociatyMobaCommandBottomView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end

function SociatyMobaCommandBottomView:OnTopViewClosed(name)
    if name ~= _G.ConfigManager.ui_cfg.SociatyMobaCommandView.Name then
        return
    end

    self:Close()
end

---按钮点击事件在这里派发
function SociatyMobaCommandBottomView:OnClickBtn(go)
end

return SociatyMobaCommandBottomView