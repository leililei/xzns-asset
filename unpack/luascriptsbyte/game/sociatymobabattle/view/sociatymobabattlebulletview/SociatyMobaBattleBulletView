local SociatyMobaModel = require("SociatyMobaModel")
---@class SociatyMobaBattleBulletView : UIBaseView	布阵
---@field public go_table SociatyMobaBattleBulletView_GoTable GoTable
local SociatyMobaBattleBulletView = _G.BaseClass("SociatyMobaBattleBulletView", _G.UIBaseView)

function SociatyMobaBattleBulletView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaBattleBulletView:OnCreate()
    --- 偏好弹幕配置
    self.MeDanmuList = SociatyMobaModel:GetInstance():GetDanmuMeList()
    self.maxCount = _G.ConfigManager.discrete_cfg[116201][1][1]
 
    self:UpDateCfg()
    self:UpDateScorllView()
    self:UpDateScorllViewDeep()
end

function SociatyMobaBattleBulletView:UpDateCfg()
    self.go_table.aortext_mineTitle.text = _G.GetLangPackValue(90031700400, #self.MeDanmuList, self.maxCount)

    --- 配置表弹幕配置
    local cfgList                        = _G.ConfigManager.discrete_cfg[116200]
    self.cfgList                         = cfgList
    self.DanmuListCfg                    = {}
    for i = 1, #cfgList do
        local isHave = self:GetIsHave(cfgList[i][1])
        if not isHave then
            table.insert(self.DanmuListCfg, cfgList[i])
        end
    end

    table.sort(
        self.DanmuListCfg,
        function(a, b)
            local gradeA = a[3] == 1 and 3 or a[3]
            local gradeB = b[3] == 1 and 3 or b[3]
            if gradeA == gradeB then
                return a[1] < b[1]
            else
                return gradeA > gradeB
            end
        end
    )
end

---刷新我的弹幕配置
function SociatyMobaBattleBulletView:UpDateScorllView()
    if self.MeLikeItemListView == nil then
        self.MeLikeItemListView = self.go_table.scrollloopvectical_top
        self.go_table.scrollloopvectical_top:InitItemData(self.maxCount, _G.handler(self, self.RefreshListTop))
    else
        self.MeLikeItemListView:UpdateAllItem()
    end
end

---刷新底部弹幕配置
function SociatyMobaBattleBulletView:UpDateScorllViewDeep()
    if self.ItemListView == nil then
        self.ItemListView = self.go_table.scrollloopvectical_Bullets
        self.go_table.scrollloopvectical_Bullets:InitItemData(#self.DanmuListCfg, _G.handler(self, self.RefreshListDeep))
        self.ItemListViewCount = #self.DanmuListCfg
    else
        if self.ItemListViewCount ~= #self.DanmuListCfg then
            self.go_table.scrollloopvectical_Bullets:UpdateCount(#self.DanmuListCfg)
        else
            self.go_table.scrollloopvectical_Bullets:UpdateAllItem()
        end
    end
end

function SociatyMobaBattleBulletView:RefreshListTop(index, objGame)
    if index < 0 then
        return
    end
    local i = index + 1
    local data = { index = i }
    self:UpdateCommonItem(objGame, data)
end

function SociatyMobaBattleBulletView:RefreshListDeep(index, objGame)
    if index < 0 then
        return
    end
    local i = index + 1
    local data = { index = i }
    self:UpdateCommonDeepItem(objGame, data)
end

function SociatyMobaBattleBulletView:UpdateCommonItem(obj, data)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemOnClickBtn, data))
    tb.aorimage_Bg:SetActiveE(data.index % 2 == 0 and 1 or 0)
    tb.aortext_num.text = data.index

    if self.MeDanmuList[data.index] then
        tb.aortext_desc.text = _G.GetLangPackValue(self.cfgList[self.MeDanmuList[data.index]][2])
        tb.aortext_desc:SetActiveE(1)
        tb.aorbtn_close:SetActiveE(1)
        tb.aorimage_Add:SetActiveE(0)
    else
        tb.aortext_desc:SetActiveE(0)
        tb.aorbtn_close:SetActiveE(0)
        tb.aorimage_Add:SetActiveE(1)
    end
end

--- 底部框Item
function SociatyMobaBattleBulletView:UpdateCommonDeepItem(obj, data)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemDeepOnClickBtn, data))
    tb.aorimage_Bg:SetActiveE(data.index % 2 == 0 and 1 or 0)
    local isHave = self:GetIsHave(self.DanmuListCfg[data.index][1])
    tb.aortext_desc.text = _G.GetLangPackValue(self.DanmuListCfg[data.index][2])
    tb.aorimage_HotTip:SetActiveE(self.DanmuListCfg[data.index][3] == 1 and 1 or 0)
    tb.aorimage_ShowTip:SetActiveE(self.DanmuListCfg[data.index][3] == 2 and 1 or 0)

    if isHave then
        tb.aorbtn_close:SetActiveE(0)
    else
        tb.aorbtn_close:SetActiveE(1)
    end
end

--- 是否已经设置为偏好
function SociatyMobaBattleBulletView:GetIsHave(ID)
    local isHave = false

    if #self.MeDanmuList > 0 then
        for i = 1, #self.MeDanmuList do
            if self.MeDanmuList[i] == ID then
                isHave = true
            end
        end
    end
    return isHave
end

--- 偏好删除按钮
function SociatyMobaBattleBulletView:itemOnClickBtn(go, isOn, data)
    if self.MeDanmuList[data.index] then
        _G.table.remove(self.MeDanmuList, data.index)
    end
    --- 去发送协议 修改整个偏好list
    SociatyMobaModel:GetInstance():SetDanmu(
        self.MeDanmuList,
        _G.handler(self, self.SetDanmuHandler)
    )
end

--- 添加偏好按钮
function SociatyMobaBattleBulletView:itemDeepOnClickBtn(go, isOn, data)
    if #self.MeDanmuList < self.maxCount then
        table.insert(self.MeDanmuList, self.DanmuListCfg[data.index][1])
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(950126)
    end
    --- 去发送协议 修改整个偏好list
    SociatyMobaModel:GetInstance():SetDanmu(
        self.MeDanmuList,
        _G.handler(self, self.SetDanmuHandler)
    )
end

---设置弹幕
function SociatyMobaBattleBulletView:SetDanmuHandler(msg)
    if msg.ack ~= 1 then
        return
    end
    self:RefreshView()
end

---刷新界面
function SociatyMobaBattleBulletView:RefreshView()
    self:UpDateCfg()
    self:UpDateScorllView()
    self:UpDateScorllViewDeep()
end

---界面的销毁函数
function SociatyMobaBattleBulletView:Dispose()
    self.go_table = nil
end

---按钮点击事件在这里派发
function SociatyMobaBattleBulletView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_closeView" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_tips" then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 168)
    end
end

return SociatyMobaBattleBulletView
