local SociatyMobaBattleModel = require("SociatyMobaBattleModel")
local SociatyMobaModel = require("SociatyMobaModel")
local SociatyMobaNet = require("SociatyMobaNet")

---@class SociatyMobaReportView : UIBaseView	冥界纷争定段界面
---@field public go_table SociatyMobaReportView_GoTable GoTable
local SociatyMobaReportView = _G.BaseClass("SociatyMobaReportView", _G.UIBaseView)

function SociatyMobaReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local IconName = {
    "ImagesH5/nSociatyMoba/qingtong",
    "ImagesH5/nSociatyMoba/baiying",
    "ImagesH5/nSociatyMoba/huangjing",
    "ImagesH5/nSociatyMoba/zhuanshi"
}

local FrameName = {
    [2] = "ui-mjfz-touxiangkuang1",
    [3] = "ui-mjfz-touxiangkuang",
    [4] = "ui-mjfz-touxiangkuang2"
}

local jType = {}
for _, cfg in pairs(_G.ConfigManager.guild_moba_campsite_cfg) do
    if cfg.type > 1 then
        _G.table.insert(jType, cfg.id)
    end
end

---界面的入口函数
function SociatyMobaReportView:OnCreate()
    self.SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.fightData = {}
    self:InitToggle()
    self.curLaner = 1
    self:InitView()
    self.go_table.toggle_topLaner.isOn = false
    self.go_table.toggle_midLaner.isOn = false
    self.go_table.toggle_botLaner.isOn = false
    self.go_table.toggle_jungle.isOn = false
    self.go_table.toggle_topLaner.isOn = true
end

function SociatyMobaReportView:InitView()
    ---@type guild_moba.i_guild_info
    local data = SociatyMobaBattleModel:GetInstance():GetHomeData(true)
    local lv = SociatyMobaModel:GetInstance():GetSociatyLevelByScore(data.score)
    self.go_table.aorrawimage_sociatyIcon1:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.brana].portrait)
    self.go_table.aorrawimage_dan1:LoadImage(IconName[lv])
    self.go_table.aortext_sociatyName1.text = data.guild_name

    if SociatyMobaBattleModel:GetInstance().isBye then --轮空
        self.go_table.aorrawimage_sociatyIcon2:SetActiveE(0)
        self.go_table.aorrawimage_dan2:SetActiveE(0)
        self.go_table.aortext_sociatyName2.text = ""
    else
        data = SociatyMobaBattleModel:GetInstance():GetHomeData()
        lv = SociatyMobaModel:GetInstance():GetSociatyLevelByScore(data.score)
        self.go_table.aorrawimage_sociatyIcon2:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.brana].portrait)
        self.go_table.aorrawimage_dan2:LoadImage(IconName[lv])
        self.go_table.aortext_sociatyName2.text = data.guild_name
    end
    self:UpdateTeamNum()
end

function SociatyMobaReportView:UpdateTeamNum()
    if self.curLaner >= 4 then
        self.go_table.aortext_lastArmy1.text = ""
        self.go_table.aortext_lastArmy2.text = ""
    else
        local num = SociatyMobaBattleModel:GetInstance():GetLanerCurTeamNum(self.curLaner, true)
        local num1 = SociatyMobaBattleModel:GetInstance():GetLanerMarchNum(self.curLaner, true)
        num = num + num1
        local maxNum = SociatyMobaBattleModel:GetInstance():GetLanerMaxTeamNum(self.curLaner, true)
        self.go_table.aortext_lastArmy1.text = _G.GetLangPackValue(90031700023, num .. "/" .. maxNum)
        if SociatyMobaBattleModel:GetInstance().isBye then
            self.go_table.aortext_lastArmy2.text = _G.GetLangPackValue(90031700023, "???")
        else
            num = SociatyMobaBattleModel:GetInstance():GetLanerCurTeamNum(self.curLaner)
            num1 = SociatyMobaBattleModel:GetInstance():GetLanerMarchNum(self.curLaner)
            num = num + num1
            maxNum = SociatyMobaBattleModel:GetInstance():GetLanerMaxTeamNum(self.curLaner)
            self.go_table.aortext_lastArmy2.text = _G.GetLangPackValue(90031700023, num .. "/" .. maxNum)
        end
    end
end

function SociatyMobaReportView:InitToggle()
    self.toggles = {}
    self.toggles["topLaner"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_topLaner,
        _G.handlerbind(self, self.OnToggle, "topLaner", _G.handlerbind(self, self.OnLaner, 1))
    )
    self.toggles["midLaner"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_midLaner,
        _G.handlerbind(self, self.OnToggle, "midLaner", _G.handlerbind(self, self.OnLaner, 2))
    )
    self.toggles["botLaner"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_botLaner,
        _G.handlerbind(self, self.OnToggle, "botLaner", _G.handlerbind(self, self.OnLaner, 3))
    )
    self.toggles["jungle"] =
        _G.GetAutoGoTable(
        self.go_table.toggle_jungle,
        _G.handlerbind(self, self.OnToggle, "jungle", _G.handler(self, self.OnJungle))
    )
end

---点击Togggle
function SociatyMobaReportView:OnToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    if call then
        call(isOn)
    end
end

function SociatyMobaReportView:OnLaner(isOn, type)
    self.go_table.obj_Laner:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.curLaner = type
    self:UpdateTeamNum()
    if self.lanerTb == nil then
        ---@type SociatyMobaReportView._obj_Laner_GoTable
        self.lanerTb = _G.GetAutoGoTable(self.go_table.obj_Laner)
    end
    if not self.fightData[type] then
        local pbData = {stations = {type}}
        require("SociatyMobaNet"):GetInstance():GetLineFightInfo(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self.fightData[type] = msg.line_fight and msg.line_fight[1] or {}
                if self.fightData[type].role == nil then
                    self.fightData[type].role = {}
                end
                _G.table.sort(
                    self.fightData[type].role,
                    function(a, b)
                        if a.win_count ~= b.win_count then
                            return a.win_count > b.win_count
                        end
                        return a.power > b.power
                    end
                )
                if not self.rankListInit then
                    self.lanerTb.scrollloopvectical_rankList:InitItemData(
                        #self.fightData[type].role,
                        _G.handler(self, self.RefreshItem)
                    )
                    self.rankListInit = true
                else
                    self.lanerTb.scrollloopvectical_rankList:UpdateCount(#self.fightData[type].role)
                end
                self.go_table.obj_reportEmptyItem:SetActiveE(#self.fightData[type].role == 0 and 1 or 0)
            end
        )
    else
        self.lanerTb.scrollloopvectical_rankList:UpdateCount(#self.fightData[type].role)
        self.go_table.obj_reportEmptyItem:SetActiveE(#self.fightData[type].role == 0 and 1 or 0)
    end
end

function SociatyMobaReportView:OnJungle(isOn)
    self.go_table.obj_Jungle:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.go_table.obj_reportEmptyItem:SetActiveE(0)
    self.curLaner = 4
    self:UpdateTeamNum()
    if self.jungleTb == nil then
        ---@type SociatyMobaReportView._obj_Jungle_GoTable
        self.jungleTb = _G.GetAutoGoTable(self.go_table.obj_Jungle)
    end
    if not self.jungleInit then
        self.jungleInit = true
        local pbData = {stations = jType}
        require("SociatyMobaNet"):GetInstance():GetLineFightInfo(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if msg.line_fight then
                    for _, v in pairs(msg.line_fight) do
                        self.fightData[v.sid] = v
                        if self.fightData[v.sid].role == nil then
                            self.fightData[v.sid].role = {}
                        end
                        _G.table.sort(
                            self.fightData[v.sid].role,
                            function(a, b)
                                if a.win_count ~= b.win_count then
                                    return a.win_count > b.win_count
                                end
                                return a.power > b.power
                            end
                        )
                    end
                end
                self:InitJungle()
            end
        )
    end
end

function SociatyMobaReportView:InitJungle()
    local obj
    ---@type _obj_Jungle._obj_creeps_GoTable
    local tb
    local itemObj, teams
    self.creeps = {}
    for _, cfg in pairs(_G.ConfigManager.guild_moba_campsite_cfg) do
        if cfg.type > 1 then
            obj = _G.InstantiateObject(self.jungleTb.obj_creeps, self.jungleTb.obj_Content)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCreep, cfg.id))
            self.creeps[cfg.id] = tb
            tb.aortext_name.text = _G.GetLangPackValue(cfg.name[1][1])
            tb.aorimage_frame:SetActiveE(0)
            tb.aorrawimage_icon:LoadImage(
                cfg.icon[1][1],
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    tb.aorrawimage_icon:SetNativeSize()
                end
            )
            if self.fightData[cfg.id] ~= nil then
                teams = self.fightData[cfg.id].role
                if #teams == 0 then
                    itemObj = _G.InstantiateObject(self.go_table.obj_reportEmptyItem, tb.obj_army)
                    itemObj:SetActiveE(1)
                    tb.aorimage_expand:SetLocalScale(1,  1, 1)
                    tb.obj_army:SetActiveE(0)
                else
                    local index=1
                    local itemtb={}
                    for _, data in pairs(teams) do
                        itemObj = _G.InstantiateObject(self.go_table.obj_reportItem, tb.obj_army)
                        itemObj:SetActiveE(1)
                        self:ShowReportItem(itemObj, data, cfg.id)
                        itemtb= _G.GetAutoGoTable(itemObj)
                        itemtb.aorimage_bg:SetActiveE(index%2)
                        index=index+1
                    end
                    tb.aorimage_expand:SetLocalScale(1,  1, 1)
                    tb.obj_army:SetActiveE(0)
                end
            end
        end
    end
end

function SociatyMobaReportView:RefreshItem(index, obj)
    index = index + 1
    local data = self.fightData[self.curLaner].role[index]
    self:ShowReportItem(obj, data)
    local tb = _G.GetAutoGoTable(obj)
    tb.aorimage_bg:SetActiveE(index%2)
end

---@param data guild_moba.i_moba_line_fight
function SociatyMobaReportView:ShowReportItem(obj, role, sid)
    sid = sid or self.curLaner
    ---@type SociatyMobaReportView._obj_reportItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, role, sid))
    -- local role = data.role
    tb.aortext_name.text = role.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.power)
    tb.aortext_killNum.text = role.win_count

    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        role,
        nil,
        true,
        nil,
        nil,
        function()
        end
    )

    for i = 1, 3 do
        local card = role.cards[i]
        if tb["card" .. i] then
            if tb["card" .. i] ~= true then
                if card then
                    tb["card" .. i].gameObject:SetActiveE(1)
                    tb["card" .. i]:Show(
                        card.card_sid,
                        nil,
                        card.star,
                        card.soul_lv,
                        card.card_lv,
                        nil,
                        card.skin_id,
                        card.soul_state,
                        card.big_born_num
                    )
                else
                    tb["card" .. i].gameObject:SetActiveE(0)
                end
            end
        else
            if card then
                tb["card" .. i] = true
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    tb.obj_team,
                    function(item)
                        tb["card" .. i] = item
                        item:Show(
                            card.card_sid,
                            nil,
                            card.star,
                            card.soul_lv,
                            card.card_lv,
                            nil,
                            card.skin_id,
                            card.soul_state,
                            card.big_born_num
                        )
                    end
                )
            end
        end
    end

    local id, skillTb
    for i = 1, 3 do
        id = role.combine[i] or 0
        skillTb = _G.GetAutoGoTable(tb["obj_petSkills" .. i])
        SociatyMobaBattleModel.ShowSingleCombine(skillTb, id)
    end
end

function SociatyMobaReportView:OnClickCreep(go, isOn, id)
    local active = self.creeps[id].obj_army:GetActiveSelf()
    self.creeps[id].aorimage_expand:SetLocalScale(1, active == 1 and 1 or -1, 1)
    self.creeps[id].obj_army:SetActiveE(1 - active)
end

---@param data guild_moba.i_moba_line_fight
function SociatyMobaReportView:OnClickItem(go, isOn, data, lanerId)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaReportDetailView.Name, data, lanerId)
end

---界面的销毁函数
function SociatyMobaReportView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMobaReportView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyMobaReportView
