local SociatyModel = require("SociatyModel")
local SociatyMobaModel = require("SociatyMobaModel")

---@class SociatyMobaCommandSetView : UIBaseView	冥界纷争定段界面
---@field public go_table SociatyMobaCommandSetView_GoTable GoTable
local SociatyMobaCommandSetView = _G.BaseClass("SociatyMobaCommandSetView", _G.UIBaseView)

function SociatyMobaCommandSetView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaCommandSetView:OnCreate()
    self:InitView()
end

function SociatyMobaCommandSetView:InitView()
    local memberModule = require("SociatyData").GetMemberModule()
    memberModule:SortMemberByManager()
    self.member = memberModule.Member
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.member, _G.handler(self, self.RefreshItem))
end

function SociatyMobaCommandSetView:RefreshItem(index, obj)
    index = index + 1
    local data = self.member[index]
    ---@type SociatyMobaCommandSetView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        data,
        nil,
        true,
        nil,
        nil,
        function()
            self:OnClickItem(nil, nil, index)
        end
    )
    tb.aortext_name.text = data.Name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.Power)
    tb.obj_cur:SetActiveE(SociatyMobaModel:GetInstance():CheckIsCommander(data.Uid) and 1 or 0)
    tb.aorrawimage_position:LoadImage(_G.SociatyPositionIconName[data.Location])
    tb.aortext_position.text = _G.GetLangPackValue(SociatyModel:GetInstance():GetLocationLanguage(data.Location))
    tb.aorimage_isSelect:SetActiveE(index == self.curIndex and 1 or 0)
end

function SociatyMobaCommandSetView:OnClickItem(go, isOn, index)
    if index ~= self.curIndex then
        self.curIndex = index
        self.go_table.scrollloopvectical_itemList:UpdateAllItem()
    end
end

---界面的销毁函数
function SociatyMobaCommandSetView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyMobaCommandSetView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if self.curIndex == nil then
            self:Close()
            return
        end
        local data = self.member[self.curIndex]
        if SociatyMobaModel:GetInstance():CheckIsCommander(data.Uid) then
            self:Close()
            ---当前玩家已经是指挥了
            return
        end
        SociatyMobaModel:GetInstance():SetCommander(
            data.Uid,
            function()
                self:Close()
                -- self.go_table.scrollloopvectical_itemList:UpdateAllItem()
            end
        )
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    end
end

return SociatyMobaCommandSetView
