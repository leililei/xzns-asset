---@class SociatyMobaSeasonAward : Component	赛季结算奖励
local SociatyMobaSeasonAward = _G.BaseClass("SociatyMobaSeasonAward", _G.Component)

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "0ui_icon_diyi",
    "0ui_icon_dier",
    "0ui_icon_disan"
}

---@type string[] 公会等级图标
local SOCIATY_LEVEL_ICON = {
    "ImagesH5/nSociatyMoba/qingtong",
    "ImagesH5/nSociatyMoba/baiying",
    "ImagesH5/nSociatyMoba/huangjing",
    "ImagesH5/nSociatyMoba/zhuanshi"
}

local alphas = { "255", "255" }
local colors = {
    { "FFFFFF", "FFCB28" },
    { "FFFFFF", "E930FF" },
    { "FFFFFF", "1F7296" }
}

---类的构造函数
function SociatyMobaSeasonAward:__init(obj, mParentView)
    self.gameObject = obj
    self.mParentView = mParentView
    ---前三名item
    self.rankThreeItems = {}
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    ---赛季排行榜奖励配置
    self.rankSociatyCfg = require("SociatyMobaModel"):GetInstance():GetSeasonRankAwards()
    self.sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.sociatyLevel = require("SociatyMobaModel"):GetInstance().SociatyLevel
    ---段位名列表
    self.rankName = {
        [self.sociatyLevel.YellowLevel] = _G.GetLangPackValue(90031700231),
        [self.sociatyLevel.ProfoundLevel] = _G.GetLangPackValue(90031700232),
        [self.sociatyLevel.PrefectureLevel] = _G.GetLangPackValue(90031700233),
        [self.sociatyLevel.HeavenlyLevel] = _G.GetLangPackValue(90031700234)
    }
    ---段位名偏移
    self.rankNamePos = {
        [self.sociatyLevel.YellowLevel] = { 0, -17 },
        [self.sociatyLevel.ProfoundLevel] = { 0, -17 },
        [self.sociatyLevel.PrefectureLevel] = { 0, -17 },
        [self.sociatyLevel.HeavenlyLevel] = { 0, -21 }
    }
end

---隐藏界面
function SociatyMobaSeasonAward:Hide()
    self.gameObject:SetActiveE(0)
end

function SociatyMobaSeasonAward:Show(isShow)
    if not isShow then
        self:Hide()
        return
    end

    self.gameObject:SetActiveE(1)
    require("SociatyMobaModel"):GetInstance():GetRankInfo(_G.handler(self, self.OnSociatyRankCall))
end

---公会排行榜回调
function SociatyMobaSeasonAward:OnSociatyRankCall(data)
    ---赛季排名公会数据
    self.rankSociatyData = data or {}
    if not self.rankListView then
        self.go_table.scrollloopvectical_rank:InitItemData(
            _G.Mathf.Max(3, #self.rankSociatyData),
            _G.handler(self, self.RefreshRank)
        )
        self.rankListView = self.go_table.scrollloopvectical_rank
    else
        self.rankListView:UpdateCount(_G.Mathf.Max(3, #self.rankSociatyData))
    end
    self:RefreshThreeRank()

    ---查询自己公会的数据
    local sUid = require("SociatyModel"):GetInstance().SociatySelf.Uid
    for index, v in ipairs(self.rankSociatyData) do
        if v.guild_uid == sUid then
            self.mineSociatyData = v
            self.mineRank = index
            break
        end
    end
    self:RefreshMineRank()
end

---刷新前三名公会信息
function SociatyMobaSeasonAward:RefreshThreeRank()
    for i = 1, 3 do
        local tb = self.rankThreeItems[i]
        if not tb then
            tb = _G.GetAutoGoTable(self.go_table["obj_rankItem" .. i])
            self.rankThreeItems[i] = tb
        end

        local sociatyData = self.rankSociatyData[i]
        tb.obj_noRank:SetActiveE(sociatyData and 0 or 1)
        tb.obj_rank:SetActiveE(sociatyData and 1 or 0)
        tb.aorimage_sociaty:SetActiveE(sociatyData and 1 or 0)
        if sociatyData then
            tb.aortext_name.text = sociatyData.guild_name
            tb.aortext_server.text = sociatyData.server_id
            local level = require("SociatyMobaModel"):GetInstance():GetSociatyLevelByScore(sociatyData.guild_score)
            --tb.aorrawimage_icon:LoadImage(SOCIATY_LEVEL_ICON[level])
            tb.aortext_result.text = _G.GetLangPackValue(90031700021, sociatyData.win_num, sociatyData.fail_num)
            tb.aorrawimage_sociaty:LoadImage(
                _G.ConfigManager.guild_portrait_cfg[sociatyData.banner].portrait
            )
        else
            tb.aortext_result.text = ""
            tb.aortext_server.text = ""
        end
    end
end

function SociatyMobaSeasonAward:RefreshRank(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.rankSociatyData[eIndex]

    ---根据是否有数据设置显示信息
    tb.aorrawimage_level:SetActiveE(data and 1 or 0)
    tb.obj_sIconBg:SetActiveE(data and 1 or 0)
    tb.aortext_noRank:SetActiveE(data and 0 or 1)
    tb.aorimage_rank:SetActiveE(eIndex <= 3 and 1 or 0)
    if eIndex <= 3 then
        tb.aortext_rank.text = ""
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[eIndex]
        tb.aortext_top3Txt.text = eIndex
        require("CommonTipManager"):GetInstance():SetTextGradient(colors[eIndex], alphas, tb.aortext_top3Txt)
    else
        tb.aortext_rank.text = eIndex
    end
    if data then
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        tb.aortext_name.text = data.guild_name
        tb.aortext_server.text = data.server_id
        tb.aortext_record.text = _G.GetLangPackValue(90031700021, data.win_num, data.fail_num)
        local level = require("SociatyMobaModel"):GetInstance():GetSociatyLevelByScore(data.guild_score)
        tb.aorrawimage_level:LoadImage(SOCIATY_LEVEL_ICON[level])
        tb.aortext_stage.text = self.rankName[level]
        tb.aortext_stage:SetLocalPosition(self.rankNamePos[level][1], self.rankNamePos[level][2], 0)
    else
        tb.aortext_server.text = ""
    end

    ---设置奖励
    local rankData = {}
    for _, v in ipairs(self.rankSociatyCfg) do
        if eIndex >= v.min_rank and eIndex <= v.max_rank then
            rankData = v
            break
        end
    end
    self:SetRankAward(rankData.rewards, tb)
end

function SociatyMobaSeasonAward:SetRankAward(rewards, tb)
    tb.obj_arawdContent:ClearChildren()
    if not _G.table.isEmptyOrNil(rewards) then
        tb.lstAwardItems = {}
        for _, v in pairs(rewards) do
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                tb.obj_arawdContent,
                function(awardItem)
                    if _G.IsNil(tb.obj_arawdContent) then
                        awardItem.gameObject:SetLocalScaleXYZ(1)
                        _G.ItemFactory:GetInstance():SetItemCard(awardItem)
                        return
                    end
                    _G.table.insert(tb.lstAwardItems, awardItem)
                    awardItem.gameObject:SetLocalScaleXYZ(0.6)
                    awardItem:Show(v[1], nil, v[2])
                    awardItem:ShowFrameEffect(v[1], true)
                end)
        end
    end
end

---刷新自己的排名
function SociatyMobaSeasonAward:RefreshMineRank()
    ---mineSociatyData为空时表示未上榜
    local tb = _G.GetAutoGoTable(self.go_table.obj_myItem)
    local isTop3 = self.mineRank and self.mineRank <= 3
    tb.aorimage_rank:SetActiveE(isTop3 and 1 or 0)
    tb.aortext_rankLabel:SetActiveE(isTop3 and 0 or 1)

    tb.aortext_rank.text = ""

    if self.mineRank then
        if self.mineRank <= 3 then
            tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[self.mineRank]
            tb.aortext_top3Txt.text = self.mineRank
            require("CommonTipManager"):GetInstance():SetTextGradient(colors[self.mineRank], alphas, tb.aortext_top3Txt)
        else
            tb.aortext_rank.text = self.mineRank
        end
    else
        if require("SociatyMobaModel"):GetInstance().score == 0 then
            tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
        else
            tb.aortext_rank.text = "100+"
        end
    end
    local level
    if self.mineSociatyData then
        level = require("SociatyMobaModel"):GetInstance():GetSociatyLevelByScore(self.mineSociatyData.guild_score)
        tb.aortext_record.text = _G.GetLangPackValue(90031700021, self.mineSociatyData.win_num,
            self.mineSociatyData.fail_num)
        tb.aortext_server.text = self.mineSociatyData.server_id
    else
        tb.aortext_server.text = ""
        level = require("SociatyMobaModel"):GetInstance():GetSociatyLevel()
        tb.aortext_record.text = _G.GetLangPackValue(90031700021, 0, 0)
    end
    tb.aorrawimage_level:LoadImage(SOCIATY_LEVEL_ICON[level])
    tb.aortext_stage.text = self.rankName[level]
    tb.aortext_stage:SetLocalPosition(self.rankNamePos[level][1], self.rankNamePos[level][2], 0)
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[self.sociatySelf.Banner].portrait)
    tb.aortext_name.text = self.sociatySelf.Name
    ---设置奖励
    local rankData = {}
    if not self.mineRank then
        rankData = self.rankSociatyCfg[#self.rankSociatyCfg]
    else
        for _, v in ipairs(self.rankSociatyCfg) do
            if self.mineRank >= v.min_rank and self.mineRank <= v.max_rank then
                rankData = v
                break
            end
        end
    end
    self:SetRankAward(rankData.rewards, tb)
end

function SociatyMobaSeasonAward:OnClickBtn(go, isOn)
end

return SociatyMobaSeasonAward
