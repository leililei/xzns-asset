---@class SociatyMobaRankView : UIBaseView	冥界纷争排行榜
---@field public go_table SociatyMobaRankView_GoTable GoTable
local SociatyMobaRankView = _G.BaseClass("SociatyMobaRankView", _G.UIBaseView)

function SociatyMobaRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param type number 排行榜类型：1击杀 2赛季
function SociatyMobaRankView:OnCreate(type)
    if _G.IsNil(type) then
        type=1
    end
    ---公会内部击杀排行榜
    if not self.killRank then
        self.go_table.obj_kill:SetActiveE(1)
        self.killRank = self:AddComponent(
            self.go_table.obj_kill,
            require("SociatyMobaKillRank").New(self.go_table.obj_kill, self)
        )
        self.killRank:Hide()
    end
    ---公会之间排行榜
    if not self.sociatyRank then
        self.go_table.obj_sociatyRank:SetActiveE(1)
        self.sociatyRank = self:AddComponent(
            self.go_table.obj_sociatyRank,
            require("SociatyMobaSeasonAward").New(self.go_table.obj_sociatyRank, self)
        )
        self.sociatyRank:Hide()
    end
    --if not self.singleAward then
    --    self.singleAward = self:AddComponent(
    --        self.go_table.obj_single,
    --        require("SociatyMobaSingleAward").New(self.go_table.obj_single, self)
    --    )
    --    self.singleAward:Hide()
    --end
    --self.go_table.toggle_single.isOn = type == 3
    if type == 1 then
        self.go_table.toggle_kill.isOn = false
        self.go_table.toggle_kill.isOn = true
    elseif type == 2 then
        self.go_table.toggle_sociaty.isOn = false
        self.go_table.toggle_sociaty.isOn = true
    elseif type == 3 then
        self.go_table.toggle_allKill.isOn = false
        self.go_table.toggle_allKill.isOn = true
    end

     self.playerHead =
        self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
 
end

function SociatyMobaRankView:Dispose()
    if self.killRank then
       self.killRank:Dispose()
    end
    if self.sociatyRank then
       self.sociatyRank:Dispose()
    end
end

---刷新页签
function SociatyMobaRankView:OnToggle(go, isOn, callBack)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    callBack()
end

---按钮点击事件在这里派发
function SociatyMobaRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
       self:Close()
    elseif go == self.go_table.toggle_kill then
        self:OnToggle(go, isOn, function()
            if not self.killRank then
                self.killRank = self:AddComponent(
                        self.go_table.obj_kill,
                        require("SociatyMobaKillRank").New(self.go_table.obj_kill, self)
                )
                self.killRank:Show(1, isOn)
            else
                self.killRank:Show(1, isOn)
            end
        end)
    elseif go == self.go_table.toggle_sociaty then
        self:OnToggle(go, isOn, function()
            if not self.sociatyRank then
                self.sociatyRank = self:AddComponent(
                        self.go_table.obj_sociatyRank,
                        require("SociatyMobaSeasonAward").New(self.go_table.obj_sociatyRank, self)
                )
                self.sociatyRank:Show(isOn)
            else
                self.sociatyRank:Show(isOn)
            end
        end)
    elseif go == self.go_table.toggle_allKill then
        self:OnToggle(go, isOn, function()
            if not self.killRank then
                self.killRank = self:AddComponent(
                        self.go_table.obj_kill,
                        require("SociatyMobaKillRank").New(self.go_table.obj_kill, self)
                )
                self.killRank:Show(2, isOn)
            else
                self.killRank:Show(2, isOn)
            end
        end)
    elseif go == self.go_table.toggle_single then
        ---单场奖励
        self:OnToggle(go, isOn, function()
            self.singleAward:Show(isOn)
        end)
    end
end

return SociatyMobaRankView