local SociatyMobaBattleModel = require "SociatyMobaBattleModel"
local SociatyMobaModel = require "SociatyMobaModel"
local PetOrderFrame = require("PetModel").PetOrderFrame
---@class SociatyMobaOverviewView : UIBaseView	中文描述
---@field public go_table SociatyMobaOverviewView_GoTable GoTable
local SociatyMobaOverviewView = _G.BaseClass("SociatyMobaOverviewView", _G.UIBaseView)

function SociatyMobaOverviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.SociatyItemList = {}
    self.itemList = {}
    self.showSort = false
    self.sortData = {
        _G.GetLangPackValue(90031700080),
        _G.GetLangPackValue(90031700081),
        _G.GetLangPackValue(90031700230)
    }
    self:InitToggle()
end

---界面的入口函数
function SociatyMobaOverviewView:OnCreate(data)
    self.go_table.scrollloopvectical_teamList:InitItemData(0,_G.handler(self, self.OnRefreshLoopListItem))
    if data then
        self.LineInfo = data
        self.go_table.toggle_topLaner.isOn = false
        self.go_table.toggle_topLaner.isOn=true
    else
        SociatyMobaBattleModel:GetInstance():GetLineInfo(
            0,
            function(data)
                self.LineInfo = data
                self.go_table.toggle_topLaner.isOn = false
                self.go_table.toggle_topLaner.isOn=true
            end,
            true
        )
    end
    self.isAuto = SociatyMobaModel:GetInstance():GetWildAuto()
    self:UpdateAutoWild()
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaTeamChange, self.SetLineInfo)
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaUpdateCommander, self.SetLineInfo)
end

function SociatyMobaOverviewView:SetLineInfo()
    SociatyMobaBattleModel:GetInstance():GetLineInfo(
            0,
            function(data)
                self.LineInfo = data
                local count=table.count(self.LineInfo[self.SelectTag])
                self.data = _G.table.toArray(self.LineInfo[self.SelectTag])
                self:SetView(count)
            end
    )
end

function SociatyMobaOverviewView:InitToggle()
    self.toggles = {
        [1] = _G.GetAutoGoTable(
                self.go_table.toggle_topLaner,
                _G.handlerbind(self, self.OnClickToggle, 1, _G.handler(self, self.SelectToggle))
        ),
        [2]= _G.GetAutoGoTable(
                self.go_table.toggle_midLaner,
                _G.handlerbind(self, self.OnClickToggle, 2, _G.handler(self, self.SelectToggle))
        ),
        [3] = _G.GetAutoGoTable(
                self.go_table.toggle_botLaner,
                _G.handlerbind(self, self.OnClickToggle, 3, _G.handler(self, self.SelectToggle))
        ),
        [4] = _G.GetAutoGoTable(
                self.go_table.toggle_jungle,
                _G.handlerbind(self, self.OnClickToggle, 4, _G.handler(self, self.SelectToggle))
        )
    }
end

---点击选项卡
---@return void
function SociatyMobaOverviewView:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call and isOn then
        call(key)
    end
end

---@param key int32 选中路线
function SociatyMobaOverviewView:SelectToggle(key)
    local count=table.count(self.LineInfo[key])
    self.data = _G.table.toArray(self.LineInfo[key])
    self.SelectTag=key
    self:SetView(count)
end

function SociatyMobaOverviewView:SetView(count)
    self.go_table.scrollloopvectical_teamList:UpdateCount(count)
    self.go_table.aortext_nil:SetActiveE(count == 0 and 1 or 0)
    self.go_table.obj_select:SetActiveE(count > 0 and 1 or 0)
    self.go_table.aortext_curSort.text =
        self.sortData[SociatyMobaBattleModel:GetInstance():GetLanerMarchSort(self.SelectTag)]
end
function SociatyMobaOverviewView:ChangeAutoWild()
    local now = _G.TimeUtil.GetServerUnixTime()
    local lastTime = SociatyMobaModel:GetInstance().lastSetWildAutoTime
    if lastTime and now - SociatyMobaModel:GetInstance().lastSetWildAutoTime < 3 then
        _G.PopWindowManager:GetInstance():ShowAllTips(950117)
        return
    end
    SociatyMobaModel:GetInstance():SetWildAutoTime(now)
    SociatyMobaModel:GetInstance():SetWildAuto(
        not self.isAuto,
        function()
            self.isAuto = not self.isAuto
            self:UpdateAutoWild()
        end
    )
end

function SociatyMobaOverviewView:UpdateAutoWild()
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(self.isAuto and 20 or -20, 0, 0)
    self.go_table.aortext_wenzi.text = _G.GetLangPackValue(self.isAuto and 90021300078 or 90021300079)
    self.go_table.obj_skip:SetActiveE(self.isAuto and 1 or 0)
end


function SociatyMobaOverviewView:OnRefreshLoopListItem(index, item)
    local ctrl = _G.GetAutoGoTable(item)
    local data=self.data[index+1]
    _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data, 1, true, true, false)
    ctrl.aortext_name.text = data.name
    --卡牌
    if ctrl.card then
        for i = 1, #ctrl.card do
            _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, false)
        end
    end
    if data.cards then
        if ctrl.card == nil then
            ctrl.card = {}
        end
        for i = 1, #data.cards do
            local dataItem = data.cards[i]
            if dataItem then
                if ctrl.card[i] then
                    ctrl.card[i]:Show(dataItem.card_sid, nil, dataItem.star, dataItem.soul_lv, 300)
                    _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, true)
                else
                    local ItemCardFactory = _G.ItemCardFactory
                    ItemCardFactory:GetInstance():GetItemCard(
                            ItemCardFactory.itemCardType.CardAllItem,
                            ctrl.obj_teamRoot,
                            function(item)
                                ctrl.card[i] = item
                                ctrl.card[i]:Show(dataItem.card_sid, nil, dataItem.star, dataItem.soul_lv, 300)
                            end
                    )
                end
            else
                if ctrl.card[i] then
                    _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, false)
                end
            end
        end
    end

    if _G.AppSetting.IsXzns then
        local beast = data.beast or {0, 0, 0}
        local beastItem, beastCfg, skillId, cfgt
        for i = 1, 3 do
            beastItem = _G.GetAutoGoTable(ctrl["obj_petSkills" .. i])
            if beast[i] and beast[i].sid > 0 then
                beastItem.gameObject:SetActiveE(1)
                beastCfg = _G.ConfigManager.pet_xzns_cfg[beast[i].sid]
                beastItem.aorrawimage_icon:LoadImage(beastCfg and beastCfg.icon_1 or "")
            else
                beastItem.gameObject:SetActiveE(0)
            end
        end
    else
        --self:SetCombineItem(ctrl, data.combine or {0, 0, 0})
        local combine=data.combine or {0, 0, 0}
        local combineItem, petCfg, skillId, cfgt, cfg
        for i = 1, 3 do
            combineItem = _G.GetAutoGoTable(ctrl["obj_petSkills" .. i])
            if combine[i] and combine[i] > 0 then
                combineItem.gameObject:SetActiveE(1)
                petCfg = _G.ConfigManager.pet_cfg[combine[i]]
                skillId = petCfg.skill_id[1]
                cfgt = _G.ConfigManager.card_skills_cfg[skillId]
                cfg = _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]

                combineItem.aorrawimage_icon:LoadImage(cfg.Icon)
                -- combineItem.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
                -- combineItem.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
                combineItem.aorimage_bg.SpriteName = PetOrderFrame[petCfg.Order]
            else
                combineItem.gameObject:SetActiveE(0)
            end
        end
    end
    --战力
    ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
end

function SociatyMobaOverviewView:ExtendSortList()
    self.go_table.obj_isSorting:SetActiveE(self.showSort and 1 or 0)
    if self.showSort  then
        self.go_table.scrollloopvectical_powerSort:InitItemData(
                #self.sortData,
                _G.handlerbind(self, self.RefreshSortItem)
        )
    end
end

function SociatyMobaOverviewView:RefreshSortItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSortItem, index))
    local isSelect=SociatyMobaBattleModel:GetInstance():GetLanerMarchSort(self.SelectTag)
    if isSelect~=index then
        tb.aortext_sortType.text = self.sortData[index]
    else
        tb.aortext_sortType.text = string.format("<color=#5bdf99>%s</color>",self.sortData[index])
    end
    --tb.obj_isCurSort:SetActiveE(isSelect)
end


function SociatyMobaOverviewView:OnClickSortItem(go, isOn, index)
    self.showSort = not self.showSort
    self:ExtendSortList()
    if index == SociatyMobaBattleModel:GetInstance():GetLanerMarchSort(self.SelectTag) then
        return
    end
    if not SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman() then
        _G.PopWindowManager:GetInstance():ShowAllTips(950120)
        return
    end
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
    if
    not (state == SE.Match or state == SE.Embattle or state == SE.Adjustline or state == SE.Settlement or
            state == SE.EmbattleAllDay or
            state == SE.SeasonSettlement)
    then
        _G.PopWindowManager:GetInstance():ShowAllTips(950111)
        return
    end
    --local tb=_G.GetAutoGoTable(go)
    SociatyMobaBattleModel:GetInstance():SetMarchOrder(
            self.SelectTag,
            index,
            function()
                self.go_table.aortext_curSort.text = self.sortData[index]
                self.go_table.scrollloopvectical_powerSort:UpdateAllItem()
            end
    )
end
---按钮点击事件在这里派发
function SociatyMobaOverviewView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_autoLeft then
        -- self:ChangeAutoWild() -- ZHJ-36367废弃
    elseif go == self.go_table.aorbtn_arrow then
        --if not SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman() then
        --    _G.PopWindowManager:GetInstance():ShowAllTips(950120)
        --    return
        --end
        self.showSort = not self.showSort
        self:ExtendSortList()
    end
end

function SociatyMobaOverviewView:Dispose()
    self:RemoveAllListener()
end

---界面的销毁函数
function SociatyMobaOverviewView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return SociatyMobaOverviewView
