---@class SociatyMobaKillRank : Component    赛季结算奖励
local SociatyMobaKillRank = _G.BaseClass("SociatyMobaKillRank", _G.Component)

---类的构造函数
function SociatyMobaKillRank:__init(obj, mParentView)
    self.gameObject = obj
    self.mParentView = mParentView
    ---前三名item
    self.rankThreeItems = {}
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---隐藏界面
function SociatyMobaKillRank:Hide()
    self.gameObject:SetActiveE(0)
end

function SociatyMobaKillRank:Show(type, isShow)
    if not isShow then
        self:Hide()
        return
    end

    self.type = type
    self.gameObject:SetActiveE(1)
    require("SociatyMobaModel"):GetInstance():GetKillRankInfo(type, _G.handler(self, self.OnKillRankCall))
end

---排行榜获取数据回调
function SociatyMobaKillRank:OnKillRankCall(data)
    self.killRankData = data or {}
    if not self.rankListView then
        self.go_table.scrollloopvectical_rank:InitItemData(
            _G.Mathf.Max(#self.killRankData - 3, 0),
            _G.handler(self, self.RefreshRank)
        )
        self.rankListView = self.go_table.scrollloopvectical_rank
    else
        self.rankListView:UpdateCount(_G.Mathf.Max(#self.killRankData - 3, 0))
    end
    self:RefreshThreeRank()

    ---刷新自己的排名
    if not _G.table.isEmptyOrNil(self.killRankData) then
        local pUid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for index, v in ipairs(self.killRankData) do
            if v.rank.uid == pUid then
                self:RefreshMineRank(index, v)
                return
            end
        end
    end
    self:RefreshMineRank()
end

---刷新前三名公会信息
function SociatyMobaKillRank:RefreshThreeRank()
    local pbData = { roles = {} }
    self.uidRank = {}
    self.roleSkin = {}
    for i = 1, 3 do
        local tb = self.rankThreeItems[i]
        if not tb then
            tb = _G.GetAutoGoTable(self.go_table["obj_rankItem" .. i])
            self.rankThreeItems[i] = tb
        end
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyMobaKillRankItem .. i, tb)
        local data = self.killRankData[i]
        if data then
            tb.aortext_name.text = data.rank.name
            tb.aortext_nameSociay.text = data.rank.guild_name
            ---头像
            --tb.obj_HeadItemBase:SetActiveE(1)
            tb.aortext_nameSociay:SetActiveE(self.type == 2 and 1 or 0)
            _G.table.insert(pbData.roles, data.rank.uid)
            self.uidRank[data.rank.uid] = i
            --_G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.rank, 0.7, true, true, false)
            tb.aortext_score.text = _G.GetLangPackValue(90031700066) .. data.value
        else
            tb.aortext_name.text = _G.GetLangPackValue(90022300109)
            tb.aortext_score.text = _G.GetLangPackValue(90031700066) .. 0
            tb.aortext_nameSociay:SetActiveE(0)
            --tb.obj_HeadItemBase:SetActiveE(0)
        end
    end
    require("CommonRankNet"):GetInstance():GetRoleStyle(
        pbData,
        function(msg)
            msg.roles = msg.roles or {}
            for _, v in pairs(msg.roles) do
                self.roleSkin[self.uidRank[v.uid]] = v
            end
            for i = 1, #self.rankThreeItems do
                local tb = self.rankThreeItems[i]
                tb.trans_role:ClearChildren()
            end
            for k, v in pairs(self.roleSkin) do
                local tb = self.rankThreeItems[k]
                --tb.trans_role:ClearChildren()
                local skinId, cfg
                skinId = self.roleSkin[k].skin
                cfg = require("CardInfoManager").GetCardSkin_ShowCfg(skinId, skinId)
                local scale = cfg.size2
                local pos = cfg.pos_portrait
                local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
                if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
                    scale = cfg.size4 or cfg.size2
                    pos = { 0, 0, 0 }
                end
                local data=v
                _G.PoolsManager:GetInstance():Spawn(
                    path,
                    _G.ePoolType.Temporary,
                    tb.trans_role,
                    function(trans)
                        if table.isEmptyOrNil(self.go_table) then
                            _G.DestroyObject(trans)
                        end
                        trans:SetLocalScaleXYZ(scale)
                        trans:SetLocalPosition(_G.table.unpack(pos))
                        if _G.AppSetting.IsXzns then
                            local godHaloID = data.god_halo
                            if godHaloID ~= 0 then
                                local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                                --- 神环路径，父级路径(加载角色的下面)
                                _G.UIUtils.LoadGodHalo(effCfg, trans,godHaloID)
                            end
                            if not table.isEmptyOrNil(data.artifact_skin) then
                                _G.UIUtils.LoadArtifacteffect(trans,nil,data.artifact_skin[1],data.artifact_skin[2])
                            end
                        end
                    end
                )
                self:UpdateTop3Title(tb, self.roleSkin[k].title, k)
            end
        end
    )
end

---生成称号
---@param item table
function SociatyMobaKillRank:UpdateTop3Title(tb, title, index)
    if title == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[title]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function SociatyMobaKillRank:RefreshRank(index, obj)
    local data = self.killRankData[index + 4]
    local tb = _G.GetAutoGoTable(obj)
    ---排名
    tb.aortext_rank.text = index + 4
    ---头像
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.rank, 0.7, true, true, false)
    ---名字
    tb.aortext_name.text = data.rank.name
    tb.aortext_nameSociay.text = data.rank.guild_name
    tb.aortext_nameSociay:SetActiveE(self.type == 2 and 1 or 0)
    tb.aortext_killNum.text = data.value
end

---刷新自己的排名
---@param rank number 排名
function SociatyMobaKillRank:RefreshMineRank(rank, data)
    local tb = _G.GetAutoGoTable(self.go_table.obj_myRankItem)
    ---排名
    tb.aorimage_rank:SetActiveE(0)
    tb.aortext_rank.text = ""
    if rank then
        tb.aortext_rank.text = rank
    else
        tb.aortext_rank.text = _G.GetLangPackValue(90022900040)
    end
    tb.aortext_killNum.text = data and data.value or 0
    local playerData = _G.PlayerModel:GetInstance():GetIRroleTable()
    ---名字
    tb.aortext_name.text = playerData.name
    tb.aortext_nameSociay.text = playerData.guild_name
    tb.aortext_nameSociay:SetActiveE(self.type == 2 and 1 or 0)
    ---头像
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 0.7, true, true, false)
end

function SociatyMobaKillRank:OnClickBtn()
end

return SociatyMobaKillRank
