---@class SociatyMobaCommandView : UIBaseView	中文描述
---@field public go_table SociatyMobaCommandView_GoTable GoTable
local SociatyMobaCommandView = _G.BaseClass("SociatyMobaCommandView", _G.UIBaseView)

function SociatyMobaCommandView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaCommandView:OnCreate()
    self.styles = {}
    self.scale = 1
    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        self.scale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end
    self:RefreshView()
    ---加载场景
    self:LoadScene()
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaUpdateCommander, self.UpdateCommander, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaCommandBottomView.Name)
end

---刷新界面
function SociatyMobaCommandView:RefreshView()
    local commander = require("SociatyMobaModel"):GetInstance():GetCommander()
    if not commander or commander == 0 then
        ---没有指挥会长默认是指挥
        self.commanderData = require("SociatyModel"):GetInstance():GetChairman()
    else
        self.commanderData = require("SociatyModel"):GetInstance():GetMemberByUid(commander)
        if not self.commanderData then
            ---指挥退出或被踢出公会
            self.commanderData = require("SociatyModel"):GetInstance():GetChairman()
        end
    end
    ---名字 头像 立绘
    self.go_table.aortext_name.text = self.commanderData.Name
    _G.UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase,
        self.commanderData,
        0.8,
        true,
        true,
        false,
        function()
            self:OpenCommandView()
        end
    )
end

---指挥变更
function SociatyMobaCommandView:UpdateCommander()
    self:RefreshView()
    if not _G.IsNil(self.modelParent) then
        local roleCount = self.modelParent:GetChildCountE()
        for i = 1, roleCount do
            local temp = self.modelParent:GetChildE(i - 1)
            _G.PoolsManager:GetInstance():Despawn(temp, _G.ePoolType.Temporary)
        end
        local cfg = _G.ConfigManager.card_show_cfg[self.commanderData.Style]
        self:LoadRoleModel(self.modelParent, cfg.Size2)
    end
end

---监听界面
---@param name string 界面名称
function SociatyMobaCommandView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.SociatyMobaCommandSetView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
        if self.sceneTrans then
            self.sceneTrans:SetActiveE(1)
        end
    end
end

---加载场景
function SociatyMobaCommandView:LoadScene()
    _G.PoolsManager:GetInstance():Spawn(
        "Scenes/sp_gonghuijiesuan/Export/sp_gonghuizhihui",
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("SociatyMobaCommandView：场景无法加载")
                end
                return
            end
            self.modelParent = _G.FindObject("obj")
            if not _G.IsNil(self.modelParent) then
                local cfg = _G.ConfigManager.card_show_cfg[self.commanderData.Style]
                self:LoadRoleModel(self.modelParent, cfg.Size2)
            end

            self.sceneTrans = trans
            self.camera = _G.Camera.main
            self.camera.depth = 55
            local camera = _G.FindObject("3DUICam")
            if not _G.IsNil(camera) then
                self.camera3D = camera:GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
                self.camera3D.depth = 55
            end
        end
    )
end

---加载单个角色
function SociatyMobaCommandView:LoadRoleModel(modelParent, scale)
    ---@type card_cfg
    local cfg = require "CardCommentManager":GetInstance():CardData(self.commanderData.Style, false)
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi)
                end
                return
            end
            if self:IsNil() then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                return
            end
            trans:SetParentE(modelParent)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
            self.roleTrans = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            self:GetRoleStyle(self.commanderData.Uid, rolePoint)
        end
    )
end

function SociatyMobaCommandView:GetRoleStyle(uid, rolePoint)
    if self.styles[uid] then
        -- self:UpdateHalo(uid, rolePoint)
        -- self:UpdateTitle(uid, rolePoint)
    else
        local pbData = {roles = {uid}}
        require("CommonRankNet"):GetInstance():GetRoleStyle(
            pbData,
            _G.handlerbind(self, self.GetRoleStyleHandler, rolePoint, uid)
        )
    end
end

function SociatyMobaCommandView:GetRoleStyleHandler(msg, rolePoint, uid)
    local data = msg.roles[1]
    self.styles[data.uid] = data
    -- self:UpdateHalo(uid, rolePoint)
    -- self:UpdateTitle(uid, rolePoint)
end

---按钮点击事件在这里派发
function SociatyMobaCommandView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_command then
        ---任命指挥界面
        self:OpenCommandView()
    end
end

---打开指挥设置界面
function SociatyMobaCommandView:OpenCommandView()
    if require("SociatyModel"):GetInstance():CheckSelfIsChairman() then
        if self.sceneTrans then
            self.sceneTrans:SetActiveE(0)
        end
        self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaCommandSetView.Name)
    end
end

function SociatyMobaCommandView:UpdateTitle(uid, rolePoint)
    local title = self.styles[uid].title
    local parent = self.roleTrans
    if not self.title or _G.IsNil(self.title.gameObject) then
        if not title or title <= 0 then
            return
        end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if (_G.IsNil(parent)) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.title = go_table
                self:SetTitlePos(rolePoint)
                go_table.aortext_TextName.text = ""

                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[title]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale * self.scale)
                            end
                        )
                        if self.title.item then
                            _G.DestroyObject(self.title.item)
                            self.title.item = nil
                        end
                        self.title.aorrawimage_Title:SetActiveE(1)
                    else
                        self.title.aorrawimage_Title:SetActiveE(0)
                        if self.title.item then
                            _G.DestroyObject(self.title.item)
                            self.title.item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.title.gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.title.item = trans
                                local x, y, z = self.title.aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.title.item:SetLocalScaleXYZ(self.titleScale * self.scale)
                                trans:SetActiveE(1)
                            end
                        )
                    end
                end
            end
        )
    elseif self.title then
        if self.title.item then
            _G.DestroyObject(self.title.item)
            self.title.item = nil
        end
        if not title or title <= 0 then
            self.title.aorrawimage_Title:SetActiveE(0)
            return
        end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[title]
        if cfg.type_title == 1 then
            self.title.aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.title.aorrawimage_Title:SetNativeSize()
                    self.title.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale * self.scale)
                end
            )
            self.title.aorrawimage_Title:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.title.gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.title.item = trans
                    local x, y, z = self.title.aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.title.item:SetLocalScaleXYZ(self.titleScale * self.scale)
                    trans:SetActiveE(1)
                end
            )
            self.title.aorrawimage_Title:SetActiveE(0)
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function SociatyMobaCommandView:SetTitlePos(rolePoint)
    _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if self.title and not _G.IsNil(self.title.gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans
                    if parent == nil then ---快速切换角色时gameObj可能被置位nil
                        return
                    end
                    local position = {}
                    position.x = x
                    position.z = z
                    position.y = y - 0.19
                    local scale = parent:GetLocalScale()
                    local rate = self.scale
                    self.title.gameObject:SetLocalScaleXYZ(rate * 0.8 / scale)
                    self.title.transform:SetLocalPositionToZero()
                    self.title.transform:SetPosition(position.x, position.y, position.z)
                    local lookAt = self.title.transform:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
                    if _G.IsNil(lookAt) then
                        lookAt = self.title.transform:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
                    end
                    lookAt:SetData(self.camera.transform, parent)
                end
            end
        end
    )
end

function SociatyMobaCommandView:UpdateHalo(uid, rolePoint)
    if self.halo then
        _G.PoolsManager:GetInstance():Despawn(self.halo, _G.ePoolType.Temporary)
        self.halo = nil
    end
    local halo = self.styles[uid].circle
    if halo == nil or halo <= 0 then
        return
    end
    local parent = self.roleTrans
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[halo]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo = trans
            if cfg.type_halo == 2 then
                self.halo:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo:GetParent():GetLocalScale()
                local rate = self.scale
                self.halo:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo:GetChildE(0):SetActiveE(1)
            self.halo:SetEulerAngles(0, 0, 0)
            self.halo:SetLocalPositionToZero()
        end
    )
end


function SociatyMobaCommandView:OnDestroy()
    if self.camera ~= nil then
        self.camera.depth = 0
    end
    if self.camera3D then
        self.camera3D.depth = 1
    end
    if self.sceneTrans then
        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    end
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
end

function SociatyMobaCommandView:Dispose()
    self:RemoveAllListener()
end

return SociatyMobaCommandView
