local SociatyModel = require("SociatyModel")
local SociatyMobaModel = require("SociatyMobaModel")
local SociatyMobaBattleModel = require("SociatyMobaBattleModel")

---@class SociatyMobaEmbattleFaceView : UIBaseView    中文描述
---@field public go_table SociatyMobaEmbattleFaceView_GoTable GoTable
local SociatyMobaEmbattleFaceView = _G.BaseClass("SociatyMobaEmbattleFaceView", _G.UIBaseView)

function SociatyMobaEmbattleFaceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local StateEnum = SociatyMobaModel:GetInstance().SociatyMobaBattleState

---界面的入口函数
function SociatyMobaEmbattleFaceView:OnCreate()
    self.roleSelf = SociatyModel:GetInstance().SociatyRoleSelf
    self.sociatySelf = SociatyModel:GetInstance().SociatySelf
    self:InitView()
    local today = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    self.go_table.toggle_reject.isOn = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SociatyMobaEmbattleFace) == today
    if not self.Effect then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_Duizheng,
                self.go_table.obj_effect,
                function(obj)
                    if self.go_table==nil or self.Effect then
                        _G.DestroyObject(obj)
                        return
                    end
                    self.Effect = obj
                end
        )
    end
end

function SociatyMobaEmbattleFaceView:InitView()
    local isEmpty = false
    for i = 1, 4 do
        if SociatyMobaModel:GetInstance():CheckSingleEmbattleHasEmpty(i) then
            isEmpty = true
            break
        end
    end
    self.isEmpty = isEmpty
    if isEmpty then
        self.go_table.aorbtn_embattle:SetActiveE(1)
        self.go_table.aorbtn_team:SetActiveE(0)
        self.go_table.aorbtn_share:SetActiveE(0)
        self.go_table.aortext_assemble:SetActiveE(0)
        self.go_table.aortext_noEmbattle:SetActiveE(1)
        self.go_table.aorbtn_closeView:SetActiveE(0)
        return
    end

    local inPos = self:CheckIsOffical()
    self.go_table.aorbtn_share:SetActiveE(inPos and 1 or 0)
    self.go_table.aorbtn_closeView:SetActiveE(1)
    self.go_table.aorbtn_team:SetActiveE(1)
    self.go_table.aortext_assemble:SetActiveE(1)
    self.go_table.aortext_noEmbattle:SetActiveE(0)
    self.go_table.aortext_assemble:SetActiveE(0)
    SociatyMobaBattleModel:GetInstance():GetLineInfo(
        0,
        function(data)
            self.LineInfo = data
            local roleUid = {}
            for _, roles in pairs(data) do
                for _, role in pairs(roles) do
                    roleUid[role.uid] = true
                end
            end
            local curNum = #_G.table.keys(roleUid)
            self.go_table.aortext_assemble:SetActiveE(1)
            local maxNum = self.sociatySelf.SociatyMemberModule:GetCurMemberCount()
            self.go_table.aortext_assemble.text = _G.GetLangPackValue(90031700303, curNum, maxNum)
        end,
        true
    )
end

function SociatyMobaEmbattleFaceView:CheckIsOffical()
    local enum = require "MemberEnum".ELocationEnum
    return self.roleSelf.position == enum.Chairman or self.roleSelf.position == enum.CoChairman or
        self.roleSelf.position == enum.Elder
end

function SociatyMobaEmbattleFaceView:Share()
    local isUnlock, dataStr1 = require("ChatManager"):GetInstance():IsUnLock(1)
    if not isUnlock then
        _G.PopWindowManager:GetInstance():ShowAllTips(410, dataStr1)
        return
    end

    local model = require("SociatyModel"):GetInstance()
    ---分享公会弹劾信息
    local data = {}
    data.shareType = 1
    data.banner = self.sociatySelf.Banner
    local dataStr = _G.Table2Json(data)

    ---@type chat.c2s_chat dsd
    local param = {}
    param.channel = 3
    param.content = dataStr
    param.f_uid = 0
    param.type = _G.ChatInfoType.GuildMoba
    param.voice = 0
    param.share_id = 0
    --param.share_type = _G.ChatShareType.GuildImpeach
    param.uid = model.SociatySelf.Uid

    ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
    local msg = {}
    msg.channel = 3
    msg.n_content = dataStr
    msg.f_uid = 0
    msg.type = _G.ChatInfoType.GuildMoba
    msg.voice = 0
    msg.share_id = 0
    --msg.share_type = _G.ChatShareType.GuildImpeach
    msg.uid = model.SociatySelf.Uid
    msg = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
    require("ChatManager"):GetInstance():CheckIsCanShare(
        _G.ChatShareType.Guild,
        model.SociatySelf.Uid,
        function()
            require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
        end
    )
end

function SociatyMobaEmbattleFaceView:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

---按钮点击事件在这里派发
function SociatyMobaEmbattleFaceView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        if self.isEmpty then
            return
        end
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        if self.isEmpty then
            return
        end
        self:Close()
    elseif go == self.go_table.aorbtn_embattle then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleTeamView.Name)
        self:Close()
    elseif go == self.go_table.aorbtn_team then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaOverviewView.Name, self.LineInfo)
        self:Close()
    elseif go == self.go_table.aorbtn_share then
        self:Share()
    end
end

---界面的销毁函数
function SociatyMobaEmbattleFaceView:OnDestroy()
    if self.go_table.toggle_reject.isOn == true then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SociatyMobaEmbattleFace, _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return SociatyMobaEmbattleFaceView
