local SociatyMobaBattleModel = require "SociatyMobaBattleModel"
local SociatyMobaModel = require("SociatyMobaModel")

local base = require "EventViewBase"
---@class SociatyMobaBattleInfoView : UIBaseView	中文描述
---@field public go_table SociatyMobaBattleInfoView_GoTable GoTable
local SociatyMobaBattleInfoView = _G.BaseClass("SociatyMobaBattleInfoView", base)

local md = require "SociatyMobaModel"

local bgName = {
    "ui_gh_mjfz_huang_pic",
    "ui_gh_mjfz_xuan_pic",
    "ui_gh_mjfz_di_pic",
    "ui_gh_mjfz_tian_pic",
}

local iconName = {
    "ui_gh_mjfz_huang_txt",
    "ui_gh_mjfz_xuan_txt",
    "ui_gh_mjfz_di_txt",
    "ui_gh_mjfz_tian_txt",
}
local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState

function SociatyMobaBattleInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaBattleInfoView:OnCreate()
    self:SetSociatyInfo(self.go_table.obj_item1, self:GetSociatyDataBySide(true), true)
    self:SetSociatyInfo(self.go_table.obj_item2, self:GetSociatyDataBySide(false))
    self:SetAwards()
    self:LoadEffect()
end

function SociatyMobaBattleInfoView:LoadEffect()
    local ck = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleInfoView_bg, self.go_table.obj_eff, ck)
end

function SociatyMobaBattleInfoView:SetSociatyInfo(obj, data, isSelf)
    local goTable = _G.GetAutoGoTable(obj)
    goTable.obj_have:SetActiveE((data or isSelf) and 1 or 0)
    if isSelf then
        goTable.obj_nil:SetActiveE(data and 0 or 1)
    else
        local state, _ = SociatyMobaModel:GetInstance():GetMobaBattleStage()
        if state == SE.Embattle or state == SE.Adjustline or state == SE.Prepare or state == SE.Fighting or state == SE.Settlement then
            goTable.obj_nil:SetActiveE(data and 0 or 1)
        else
            goTable.obj_nil:SetActiveE(0)
        end
    end
    if data then
        goTable.aortext_name.text = data.guild_name
        goTable.aortext_chairman.text = _G.LangUtil.GetLangPackValue(90021800051)..data.g_owner_name
        goTable.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.brana].portrait)
        goTable.aortext_member.text = _G.LangUtil.GetLangPackValue(90021800053).. data.mem_num.."/".._G.ConfigManager.guild_level_cfg[data.guild_lv].num_player
        local lv
        if isSelf then
            local info = SociatyMobaModel:GetInstance():GetCurBattleInfo()
            if info then
                lv = info.pos
            end
        end
        if not lv then
            lv = md:GetInstance():GetSociatyLevelByScore(data.score)
        end
        goTable.aorimage_danBg.SpriteName = bgName[lv]
        goTable.aorimage_danBg2.SpriteName = iconName[lv]
    elseif isSelf then
        local sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
        goTable.aortext_name.text = sociatySelf.Name
        local chairman = sociatySelf:GetChairman()
        goTable.aortext_chairman.text = _G.LangUtil.GetLangPackValue(90021800051)..chairman.Name
        goTable.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[sociatySelf.Banner].portrait)
        local member = sociatySelf.SociatyMemberModule
        goTable.aortext_member.text = _G.LangUtil.GetLangPackValue(90021800053) .. member.CurMemberCount .. "/" .. member.MaxMemberNum

        local isCanMatch = require("SociatyMobaModel"):GetInstance():IsCanMatch()
        local curSociatyLevel = isCanMatch and require("SociatyMobaModel"):GetInstance():GetSociatyLevel() or 0
        if curSociatyLevel > 0 then
            goTable.aorimage_danBg.SpriteName = bgName[curSociatyLevel]
            goTable.aorimage_danBg2.SpriteName = iconName[curSociatyLevel]
        else
            goTable.aorimage_danBg:SetActiveE(0)
            goTable.aorimage_danBg2:SetActiveE(0)
        end
    end
end

function SociatyMobaBattleInfoView:SetAwards()
    local info = SociatyMobaModel:GetInstance():GetCurBattleInfo()
    local lv = info and info.pos or md:GetInstance():GetSociatyLevel()
    local win_rewards = _G.ConfigManager.guild_moba_normal_cfg[lv].win_rewards
    local lose_rewards = _G.ConfigManager.guild_moba_normal_cfg[lv].lose_rewards
    self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(90031700121, _G.LangUtil.GetLangPackValue(_G.ConfigManager.guild_moba_normal_cfg[lv].name))

    if win_rewards then
        for i = 1, #win_rewards do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                win_rewards[i],
                self.go_table.obj_winRoot,
                function(item)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(item.go_table.gameObject)
                        return
                    end
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
            )
        end
    end

    if lose_rewards then
        for i = 1, #lose_rewards do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                lose_rewards[i],
                self.go_table.obj_failRoot,
                function(item)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(item.go_table.gameObject)
                        return
                    end
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
            )
        end
    end
end


---函数功能注释
---@param isSelf boolean 是否是自己
---@return guild_moba.i_guild_info
function SociatyMobaBattleInfoView:GetSociatyDataBySide(isSelf)
    if not isSelf and SociatyMobaBattleModel:GetInstance().isBye then
        return nil
    end
    return SociatyMobaBattleModel:GetInstance():GetHomeData(isSelf)
end

---按钮点击事件在这里派发
function SociatyMobaBattleInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyMobaBattleInfoView