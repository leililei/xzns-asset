---@class SociatyMobaMemberView : UIBaseView	中文描述
---@field public go_table SociatyMobaMemberView_GoTable GoTable
local SociatyMobaMemberView = _G.BaseClass("SociatyMobaMemberView", _G.UIBaseView)

function SociatyMobaMemberView:Awake()
    self.sociatyItemList = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_memberList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---界面的入口函数
function SociatyMobaMemberView:OnCreate()
    self.sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnMemberRefresh)
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnMemberRefresh)
    self:AddListener(_G.eSociatyEvent.MemberRefresh, self.OnMemberRefresh)
    self:AddListener(_G.ePlayerStatus.PlayerChangeFrame, self.OnMemberRefresh)
    self:AddListener(_G.ePlayerStatus.PlayerChangeIcon, self.OnMemberRefresh)
    self:AddListener(_G.ePlayerStatus.PlayerChangeName, self.OnMemberRefresh)
    self:RefreshPanel()
end

function SociatyMobaMemberView:RefreshPanel()
    self.memberModel = self.sociatySelf.GetMemberModule()
    self.memberModel:SortMemberByWeekVp()
    self.memberList = self.memberModel.Member
    self.go_table.scrollloopvectical_memberList:UpdateCount(#self.memberList)
end

---刷新成员列表
function SociatyMobaMemberView:OnMemberRefresh()
    self.memberModel:SortMemberByWeekVp()
    self.memberList = self.memberModel.Member
    self.go_table.scrollloopvectical_memberList:UpdateAllItem()
end

function SociatyMobaMemberView:RefreshItem(index, item)
    local eIndex = index + 1
    local id = item:GetInstanceIDE()
    local tb = self.sociatyItemList[id]
    if not tb then
        tb = _G.GetAutoGoTable(item)
        self.sociatyItemList[id] = tb
    end
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, tb, eIndex))
    self:RefreshItemShow(tb, eIndex)
end

function SociatyMobaMemberView:RefreshItemShow(tb, eIndex)
    tb.index = eIndex
    local data = self.memberList[eIndex]
    tb.aortext_name.text = data.Name
    tb.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.Power)
    tb.aortext_job.text = data:GetLocationName(data.Location)
    tb.aortext_point.text = data.WeekVp
    tb.aortext_online.text = data.OfflineDesc1
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.55, true, false, true)
end

---界面的销毁函数
function SociatyMobaMemberView:Dispose()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function SociatyMobaMemberView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
       self:Close()
    end
end

return SociatyMobaMemberView