        [self.sociatyLevel.ProfoundLevel] = "ui_gh_mjfz_xuan_txt",
        [self.sociatyLevel.PrefectureLevel] = "ui_gh_mjfz_di_txt",
        [self.sociatyLevel.HeavenlyLevel] = "ui_gh_mjfz_tian_txt"
    }
    ---等级文本的底图
    self.txtDiPic = {
        [self.sociatyLevel.YellowLevel] = "ui_gh_mjfz_huang_pic",
        [self.sociatyLevel.ProfoundLevel] = "ui_gh_mjfz_xuan_pic",
        [self.sociatyLevel.PrefectureLevel] = "ui_gh_mjfz_di_pic",
        [self.sociatyLevel.HeavenlyLevel] = "ui_gh_mjfz_tian_pic"
    }
    self.levelName = {
        [self.sociatyLevel.YellowLevel] = _G.GetLangPackValue(90031700003),
        [self.sociatyLevel.ProfoundLevel] = _G.GetLangPackValue(90031700004),
        [self.sociatyLevel.PrefectureLevel] = _G.GetLangPackValue(90031700005),
        [self.sociatyLevel.HeavenlyLevel] = _G.GetLangPackValue(90031700006)
    }
    ---段位名列表
    self.rankName = {
        [self.sociatyLevel.YellowLevel] = _G.GetLangPackValue(90031700231),
        [self.sociatyLevel.ProfoundLevel] = _G.GetLangPackValue(90031700232),
        [self.sociatyLevel.PrefectureLevel] = _G.GetLangPackValue(90031700233),
        [self.sociatyLevel.HeavenlyLevel] = _G.GetLangPackValue(90031700234)
    }
      ---段位名偏移
    self.rankNamePos = {
        [self.sociatyLevel.YellowLevel] = {0, -58},
        [self.sociatyLevel.ProfoundLevel] = {0, -64},
        [self.sociatyLevel.PrefectureLevel] = {0, -64},
        [self.sociatyLevel.HeavenlyLevel] = {0, -82}
    }
    ---当前等级
    self.curSociatyLevel = require("SociatyMobaModel"):GetInstance():GetSociatyLevel()
    self:RefreshSociatyInfo()

    local isMatchGuild = require("SociatyMobaModel"):GetInstance():IsMatchGuild()
    local isSettleSucess = require("SociatyMobaModel"):GetInstance():IsSettleSucess()
    local isSucess = isMatchGuild or isSettleSucess or false
    self.go_table.obj_unSettle:SetActiveE(0)
    self.go_table.obj_preStage:SetActiveE(0)
    self.go_table.obj_nextStage:SetActiveE(0)
    self.go_table.obj_eff:SetActiveE(0)
    self.go_table.aorbtn_team:SetGray(true)
    self.go_table.aorbtn_team:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
    _G.ColorTools.FormatColorByString("A9A9A9")
    self.go_table.aortext_btnGo.color = _G.ColorTools.FormatColorByString("434343")
    self.go_table.obj_curStage:SetActiveE(isSucess and 1 or 0)
    self.go_table.aortext_nowstage:SetActiveE(isSucess and 1 or 0)
    self.go_table.aortext_stagescore:SetActiveE(isSucess and 1 or 0)
    self.go_table.aorimage_stageScoreBg:SetActiveE(0)
    self.go_table.aortext_title_win:SetActiveE(isSucess and 1 or 0)
    self.go_table.aortext_title_lose:SetActiveE(isSucess and 1 or 0)
    self.go_table.obj_success:SetActiveE(isSucess and 1 or 0)
    self.go_table.obj_failure:SetActiveE(isSucess and 0 or 1)
    if isSucess then
        self.rankSociatyCfg = SociatyMobaModel:GetInstance():GetSeasonRankAwards()
        self:SettleSucess()
        self:SetStartBattleTimer(isSettleSucess)
    else
        self:SettleFail()
        self:SetMatchTimer()
    end
    -- self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(
    --     _G.ConfigManager.redpoint_cfg.GuildMobaAward.id,
    --     1
    -- )
end

---定级成功
function SociatyMobaSettleResultView:SettleSucess()
    self.curStage = _G.GetAutoGoTable(self.go_table.obj_curStage)
    self.curStage.aortext_stage.text = self.rankName[self.curSociatyLevel]
    local pos = self.rankNamePos[self.curSociatyLevel]
    self.curStage.aortext_stage:SetLocalPosition(pos[1], pos[2])
    self.curStage.aortext_stage.color = _G.ColorTools.FormatColorByString(levelColor[self.curSociatyLevel])
    self.curStage.aorrawimage_icon:LoadImage(levelIcon[self.curSociatyLevel])
    self.go_table.aortext_nowstage.text = self.levelName[self.curSociatyLevel]
    self.go_table.aortext_stagescore.text = _G.GetLangPackValue(90000010439, SociatyMobaModel:GetInstance().score)
    self.go_table.aortext_nowstage.color = _G.ColorTools.FormatColorByString(levelColor[self.curSociatyLevel])
    self.go_table.aortext_activeLimit.text = ""
    self:UpdateWinAndLoseAward()
    SociatyMobaModel:GetInstance():GetRankInfo(_G.handler(self, self.UpdateSeasonAward))
end

function SociatyMobaSettleResultView:UpdateWinAndLoseAward()
    ---@type guild_moba_normal_cfg
    local cfg = _G.ConfigManager.guild_moba_normal_cfg[self.curSociatyLevel]
    self.go_table.obj_winAward:ClearChildren()
    self.go_table.obj_loseAward:ClearChildren()
    for i = 1, #cfg.win_rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.win_rewards[i],
            self.go_table.obj_winAward,
            function(tran)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:ShowEffectOrder(true)
            end
        )
    end
    for i = 1, #cfg.lose_rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.lose_rewards[i],
            self.go_table.obj_loseAward,
            function(tran)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:ShowEffectOrder(true)
            end
        )
    end
end

function SociatyMobaSettleResultView:UpdateSeasonAward(data)
    data = data or {}
    local sUid = require("SociatyModel"):GetInstance().SociatySelf.Uid
    for index, v in ipairs(data) do
        if v.guild_uid == sUid then
            self.mineSociatyData = v
            self.mineRank = index
            break
        end
    end
    local rankData = {}
    if not self.mineRank then
        rankData = self.rankSociatyCfg[#self.rankSociatyCfg]
    else
        for _, v in ipairs(self.rankSociatyCfg) do
            if self.mineRank >= v.min_rank and self.mineRank <= v.max_rank then
                rankData = v
                break
            end
        end
    end
    for _, v in pairs(rankData.rewards) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            self.go_table.obj_seasonAward,
            function(tran)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:ShowEffectOrder(true)
            end
        )
    end
end

---距离冥界纷争开始时间
function SociatyMobaSettleResultView:SetStartBattleTimer(isSettleSucess)
    if not isSettleSucess then
        self.endTime = SociatyMobaModel:GetInstance():GetBattleStartTime()
    else
        self.endTime = SociatyMobaModel:GetInstance():GetFirstBattleStartTime()
    end
    if self.startTimer then
        self.startTimer:Stop()
        self.startTimer = nil
    end
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime > servertime then
        self.startTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimerCall, self, false, false)
        self.startTimer:Start()
        self.go_table.aortext_Time.text = _G.string.format(
            starTimeStr,
            _G.TimeUtil.TransDayHourMineMiao(self.endTime - servertime)
        )
    else
        self.go_table.aortext_Time.text = ""
    end
end

function SociatyMobaSettleResultView:OnTimerCall()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime > servertime then
        self.go_table.aortext_Time.text = _G.string.format(
            starTimeStr,
            _G.TimeUtil.TransDayHourMineMiao(self.endTime - servertime)
        )
    else
        self:Close()
    end
end

---定级失败
function SociatyMobaSettleResultView:SettleFail()
    local base = _G.ConfigManager.discrete_cfg[101664][1][1]
    local delta = base - self.sociatySelf.SevenDayLive
    if delta > 0 then
        self.go_table.aortext_failTip.text = _G.GetLangPackValue(90031700012, _G.string.AddColor(delta, "e06420"))
        self.go_table.aortext_activeLimit.text = _G.GetLangPackValue(90031700235, _G.ConfigManager.discrete_cfg[101664][1][1])
    else
        self.go_table.aortext_failTip.text = _G.GetLangPackValue(90031700168)
        self.go_table.aortext_activeLimit.text = ""
    end
end

---距离冥界纷争下次定段时间
function SociatyMobaSettleResultView:SetMatchTimer()
    self.matchEndTime = SociatyMobaModel:GetInstance():GetNextMatchTime()
    if self.matchTimer then
        self.matchTimer:Stop()
        self.matchTimer = nil
    end
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.matchEndTime > servertime then
        self.matchTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnMatchTimerCall, self, false, false)
        self.matchTimer:Start()
        self.go_table.aortext_Time.text = _G.GetLangPackValue(
            90031700172,
            _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(self.matchEndTime - servertime), "96ce51")
        )
    else
        self.go_table.aortext_Time.text = ""
    end
end

function SociatyMobaSettleResultView:OnMatchTimerCall()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.matchEndTime > servertime then
        self.go_table.aortext_Time.text = _G.GetLangPackValue(
            90031700172,
            _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(self.matchEndTime - servertime), "96ce51")
        )
    else
        self:Close()
    end
end

---刷新工会信息
function SociatyMobaSettleResultView:RefreshSociatyInfo()
    ---公会图标
    self.go_table.aorrawimage_icon:LoadImage(
        _G.ConfigManager.guild_portrait_cfg[self.sociatySelf.Banner].portrait,
        function(image)
            image:SetActiveE(1)
        end
    )
    ---公会名字
    self.go_table.aortext_sociatyName.text = self.sociatySelf.Name
    ---公会活跃度
    self.go_table.aortext_active.text = _G.GetLangPackValue(90031700001, self.sociatySelf.SevenDayLive)
    ---赛季时间
    -- self.go_table.aortext_seasonTime.text = SociatyMobaModel:GetInstance():GetSeasoDurationTime()
end

---界面的销毁函数
function SociatyMobaSettleResultView:Dispose()
    if self.startTimer then
        self.startTimer:Stop()
        self.startTimer = nil
    end
    if self.matchTimer then
        self.matchTimer:Stop()
        self.matchTimer = nil
    end
end

---按钮点击事件在这里派发
function SociatyMobaSettleResultView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_active then
        ---查看公会成员活跃度
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaMemberView.Name)
    elseif go == self.go_table.aorbtn_award then
        ---奖励预览
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaRankView.Name)
    -- elseif go == self.go_table.aorbtn_shop then
    --     ---商店
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShopView.Name, 11)
    elseif go == self.go_table.aorbtn_help then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaHelpView.Name, 1)
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 134)
    end
end

return SociatyMobaSettleResultView
