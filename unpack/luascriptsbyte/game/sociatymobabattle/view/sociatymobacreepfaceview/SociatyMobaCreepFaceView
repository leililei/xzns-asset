---@class SociatyMobaCreepFaceView : UIBaseView	公会战聊天窗口
---@field private go_table SociatyMobaCreepFaceView_GoTable  go_table
local SociatyMobaCreepFaceView = _G.BaseClass("SociatyMobaCreepFaceView", _G.UIBaseView)

function SociatyMobaCreepFaceView:Awake()
end

function SociatyMobaCreepFaceView:OnCreate(sid, call)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMobaCreepFaceView.Name)
    self.call = call
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[sid]
    self.imagePath = {
        [2] = "Images/Roles/LH/fuzuiyuangui",
        [3] = "Images/Roles/LH/enianti",
        [4] = "Images/Roles/LH/bimengjushou"
    }
    self.go_table.aorrawimage_role:LoadImage(
        cfg.icon[1][1],
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
            self.img = true
            if self.eff then
                _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMobaCreepFaceView.Name)
                self:StartPlay()
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaCreepFaceView_buff,
        self.go_table.obj_eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.eff = trans
            self.eff:SetActiveE(0)
            if self.img then
                _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMobaCreepFaceView.Name)
                self:StartPlay()
            end
        end
    )
end

function SociatyMobaCreepFaceView:StartPlay()
    _G.DelayDo(
        0.567,
        function()
            self.eff:SetActiveE(1)
            if self.call then
                self.call()
            end
        end
    )
    _G.DelayDo(
        2.33,
        function()
            self:Close()
        end
    )
end

function SociatyMobaCreepFaceView:Dispose()
end

return SociatyMobaCreepFaceView
