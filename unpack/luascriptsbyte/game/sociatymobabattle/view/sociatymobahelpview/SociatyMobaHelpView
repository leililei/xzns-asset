---@class SociatyMobaHelpView : UIBaseView	中文描述
---@field public go_table DrawUpAwardPreView_GoTable GoTable
local SociatyMobaHelpView = _G.BaseClass("SociatyMobaHelpView", _G.UIBaseView)
local tipsid = 1
function SociatyMobaHelpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local TypeEnum = {
    [1] = {
        lang = 116198,
        path = "ImagesH5/nSociatyMoba/settle_teach_"
    },
    [2] = {
        lang = 116197,
        path = "ImagesH5/nSociatyMoba/battle_teach_"
    }
}

---界面的入口函数
---@param ActivityID number 活动id
function SociatyMobaHelpView:OnCreate(type)
    self.type = type
    self.languages = _G.ConfigManager.discrete_cfg[TypeEnum[self.type].lang]
    self.nowIndex = 1
    self.maxIndex = #self.languages
    self:InitPage()
    self:FreshSkill()
end

function SociatyMobaHelpView:InitPage()
    self.paths = {}
    self.dots = {}
    for i = 1, self.maxIndex do
        self.paths[i] = TypeEnum[self.type].path .. i
        self.dots[i] = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.aorimage_dot, self.go_table.obj_group))
        self.dots[i].aorimage_dotShow:SetActiveE(i == self.nowIndex and 1 or 0)
    end
end

function SociatyMobaHelpView:FreshSkill()
    self.go_table.aorrawimage_skill:LoadImage(
        self.paths[self.nowIndex],
        function()
            if not _G.IsNil(self) then
                -- self.go_table.aorrawimage_skill:SetNativeSize()
            end
        end
    )
    self.go_table.aortext_skillName.text = _G.GetLangPackValue(self.languages[self.nowIndex][1])
    self.go_table.aortext_skillDes.text = _G.GetLangPackValue(self.languages[self.nowIndex][2])
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_skillDes.rectTransform)
    self:ShowArrow()

    for i = 1, self.maxIndex do
        self.dots[i].aorimage_dotShow:SetActiveE(i == self.nowIndex and 1 or 0)
    end
end
function SociatyMobaHelpView:ShowArrow()
    self.go_table.aorbtn_left:SetActiveE(self.nowIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.nowIndex ~= self.maxIndex and 1 or 0)
end

---按钮点击事件在这里派发
function SociatyMobaHelpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Get then
    elseif go == self.go_table.aorbtn_close then 
        self:Close()
    elseif go == self.go_table.aorbtn_left then 
        self.nowIndex = self.nowIndex - 1
        self.nowIndex = self.nowIndex > 0 and self.nowIndex or 1
        self:FreshSkill()
    elseif go == self.go_table.aorbtn_right then 
        self.nowIndex = self.nowIndex + 1
        self.nowIndex = self.nowIndex < self.maxIndex and self.nowIndex or self.maxIndex
        self:FreshSkill()
    end
end

function SociatyMobaHelpView:Dispose()
    --_G.UIUtils.CloseVideo()
end

return SociatyMobaHelpView
