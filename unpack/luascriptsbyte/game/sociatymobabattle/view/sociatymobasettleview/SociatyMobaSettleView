function SociatyMobaSettleView:UpdateWinAndLoseAward()
    ---@type guild_moba_normal_cfg
    local cfg = self.levelCfg[self.curShowLevel]
    self.go_table.obj_winAward:ClearChildren()
    self.go_table.obj_loseAward:ClearChildren()
    for i = 1, #cfg.win_rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.win_rewards[i],
            self.go_table.obj_winAward,
            function(tran)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:ShowEffectOrder(true)
            end
        )
    end
    for i = 1, #cfg.lose_rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.lose_rewards[i],
            self.go_table.obj_loseAward,
            function(tran)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:ShowEffectOrder(true)
            end
        )
    end
end

function SociatyMobaSettleView:UpdateSeasonAward(data)
    data = data or {}
    local sUid = require("SociatyModel"):GetInstance().SociatySelf.Uid
    for index, v in ipairs(data) do
        if v.guild_uid == sUid then
            self.mineSociatyData = v
            self.mineRank = index
            break
        end
    end
    local rankData = {}
    if not self.mineRank then
        rankData = self.rankSociatyCfg[#self.rankSociatyCfg]
    else
        for _, v in ipairs(self.rankSociatyCfg) do
            if self.mineRank >= v.min_rank and self.mineRank <= v.max_rank then
                rankData = v
                break
            end
        end
    end
    for _, v in pairs(rankData.rewards) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            self.go_table.obj_seasonAward,
            function(tran)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:ShowEffectOrder(true)
            end
        )
    end
end

---活跃度刷新
---@param data award.i_award_item[]
function SociatyMobaSettleView:ActiveUpdate(data)
    for _, value in pairs(data) do
        if value.type[1] == _G.ResPropID.ActiveValue then
            ---公会活跃度
            require("SociatyModel"):GetInstance():AddSevenDayLive(value.type[2])
            self.go_table.aortext_active.text = _G.GetLangPackValue(90031700001, self.sociatySelf.SevenDayLive)
            ---刷新主界面上的红点
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
            if view and view.gameObject:GetActiveSelf() == 1 then
                view:RefreshActive()
            end
            return
        end
    end
end

function SociatyMobaSettleView:SwitchShow(num)
    self.curShowLevel = self.curShowLevel + num
    if self.curShowLevel > self.maxLevel then
        self.curShowLevel = self.maxLevel
    elseif self.curShowLevel < 1 then
        self.curShowLevel = 1
    end
    self:UpdateSociatyLevel()
end

function SociatyMobaSettleView:UpdateEnterBtnState(state, isTimer)
    state = state or SociatyMobaModel:GetInstance():GetMobaBattleStage()
    self.state = state
    self.inSeasonSettle = state == StateEnum.SeasonSettlement
    self.go_table.aorbtn_team:SetGray(self.inSeasonSettle)
    _G.UIUtils.SetBtnDark(self.go_table.aorbtn_team, self.inSeasonSettle and "A9A9A9" or "FFFFFF")
    self.go_table.aortext_btnGo.color = _G.ColorTools.FormatColorByString(self.inSeasonSettle and "434343" or "8C2D14")
    self.go_table.aortext_btnGo.text = _G.GetLangPackValue(self.inSeasonSettle and 90032100030 or 90031700163)
    self:SetGradingTimer()
end

---界面的销毁函数
function SociatyMobaSettleView:Dispose()
    self:RemoveAllListener()
    if self.gradingTimer then
        self.gradingTimer:Stop()
        self.gradingTimer = nil
    end
end

---按钮点击事件在这里派发
function SociatyMobaSettleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        -- elseif go == self.go_table.aorbtn_enter then
        --     ---前往日常活动界面
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActiveTaskView.Name)
        self:Close()
    elseif go == self.go_table.aorbtn_team then
        if self.inSeasonSettle then
            return
        end
        ---布阵界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleView.Name)
    elseif go == self.go_table.aorbtn_active then
        ---查看公会成员活跃度
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaMemberView.Name)
    elseif go == self.go_table.aorbtn_award then
        -- elseif go == self.go_table.aorbtn_shop then
        --     ---商店
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShopView.Name, 11)
        ---奖励预览
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaRankView.Name)
    elseif go == self.go_table.aorbtn_help then
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 134)
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaHelpView.Name, 1)
    elseif go == self.go_table.aorbtn_left then
        self:SwitchShow(-1)
    elseif go == self.go_table.aorbtn_right then
        self:SwitchShow(1)
    end
end

return SociatyMobaSettleView
