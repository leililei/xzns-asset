        [self.sociatyLevel.ProfoundLevel] = _G.GetLangPackValue(90031700004),
        [self.sociatyLevel.PrefectureLevel] = _G.GetLangPackValue(90031700005),
        [self.sociatyLevel.HeavenlyLevel] = _G.GetLangPackValue(90031700006)
    }
    ---段位名列表
    self.rankName = {
        [self.sociatyLevel.YellowLevel] = _G.GetLangPackValue(90031700231),
        [self.sociatyLevel.ProfoundLevel] = _G.GetLangPackValue(90031700232),
        [self.sociatyLevel.PrefectureLevel] = _G.GetLangPackValue(90031700233),
        [self.sociatyLevel.HeavenlyLevel] = _G.GetLangPackValue(90031700234)
    }
    ---段位名偏移
    self.rankNamePos = {
        [self.sociatyLevel.YellowLevel] = {0, -58},
        [self.sociatyLevel.ProfoundLevel] = {0, -64},
        [self.sociatyLevel.PrefectureLevel] = {0, -64},
        [self.sociatyLevel.HeavenlyLevel] = {0, -82}
    }
    if AppSetting.IsXzns then
        self.rankNamePos = {
            [self.sociatyLevel.YellowLevel] = {0, -42},
            [self.sociatyLevel.ProfoundLevel] = {0, -42},
            [self.sociatyLevel.PrefectureLevel] = {0, -42},
            [self.sociatyLevel.HeavenlyLevel] = {0, -42}
        }
    end

    ---基础积分
    self.baseScore = _G.ConfigManager.discrete_cfg[101664][1][1]
    self.levelItemList = {
        _G.GetAutoGoTable(self.go_table.obj_preStage),
        _G.GetAutoGoTable(self.go_table.obj_curStage),
        _G.GetAutoGoTable(self.go_table.obj_nextStage)
    }
    ---当前等级
    self.curSociatyLevel = self.sociatyLevel.NotLevel
    ---是否满足匹配条件
    self.isCanMatch = SociatyMobaModel:GetInstance():IsCanMatch()
    self.scoreLevel = SociatyMobaModel:GetInstance():GetSociatyLevel()
    if self.isCanMatch then
        self.curSociatyLevel = self.scoreLevel
    end
    self.go_table.obj_settleEnd:SetActiveE(0)
    self.winAwardItem = {}
    self.loseAwardItem = {}
    self.rankSociatyCfg = SociatyMobaModel:GetInstance():GetSeasonRankAwards()
    self:InitHelp()
    self:InitSociatyLevel()
    self:UpdateSociatyLevel()
    -- self:RefreshSlider()
    self:RefreshSociatyInfo()
    self:SetGradingTimer()
    self:UpdateEnterBtnState()
    -- self.go_table.obj_awardredpoint:UpdateRedPointItemIDAndParam(
    --     _G.ConfigManager.redpoint_cfg.GuildMobaAward.id,
    --     1
    -- )
    self.go_table.obj_teamredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.GuildMobaEmbattle.id)
    self:AddListener(_G.eSociatyEvent.ExchangeName, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeIcon, self.RefreshPanel)
    self:AddListener(_G.eItemUpdata.Updata, self.ActiveUpdate)
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaBattleState, self.UpdateEnterBtnState)
    -- self:LoadEffect()
end

function SociatyMobaSettleView:LoadEffect()
    local ck = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_huang_bg, self.levelItemList[1].aorimage_circle, ck)
    UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_xuan_bg, self.levelItemList[2].aorimage_circle, ck)
    UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_di_bg, self.levelItemList[3].aorimage_circle, ck)
    UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_tian_bg, self.levelItemList[4].aorimage_circle, ck)
    if self.curSociatyLevel == self.sociatyLevel.YellowLevel then
        UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_huang, self.levelItemList[1].aorrawimage_bg, ck)
    elseif self.curSociatyLevel == self.sociatyLevel.ProfoundLevel then
        UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_xuan, self.levelItemList[2].aorrawimage_bg, ck)
    elseif self.curSociatyLevel == self.sociatyLevel.PrefectureLevel then
        UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_di, self.levelItemList[3].aorrawimage_bg, ck)
    elseif self.curSociatyLevel == self.sociatyLevel.HeavenlyLevel then
        UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SociatyMobaSettleView_tian, self.levelItemList[4].aorrawimage_bg, ck)
    end
end

---距离冥界纷争定段结束时间
function SociatyMobaSettleView:SetGradingTimer()
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    if state == StateEnum.SeasonSettlement then
        self.gradingEndTime = nextTime
    else
        self.gradingEndTime = SociatyMobaModel:GetInstance():GetGradingStartTime()
    end
    self.state = state
    if self.gradingTimer then
        self.gradingTimer:Stop()
        self.gradingTimer = nil
    end
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.gradingEndTime > servertime then
        self.gradingTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnGradingTimerCall, self, false, false)
        self.gradingTimer:Start()
    end
    if state == StateEnum.SeasonSettlement then
        self.go_table.aortext_Time.text =
            _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(self.gradingEndTime - servertime), "fea843") ..
            _G.GetLangPackValue(90032100030)
    else
        self.go_table.aortext_Time.text =
            _G.GetLangPackValue(90031700008, _G.TimeUtil.TransDayHourMineMiao(self.gradingEndTime - servertime))
    end
end

---计时器回调
function SociatyMobaSettleView:OnGradingTimerCall()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.gradingEndTime > servertime then
        if self.state == StateEnum.SeasonSettlement then
            self.go_table.aortext_Time.text =
                _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(self.gradingEndTime - servertime), "fea843") ..
                _G.GetLangPackValue(90032100030)
        else
            self.go_table.aortext_Time.text =
                _G.GetLangPackValue(90031700008, _G.TimeUtil.TransDayHourMineMiao(self.gradingEndTime - servertime))
        end
    else
        if self.gradingTimer then
            self.gradingTimer:Stop()
            self.gradingTimer = nil
        end
        self.go_table.aortext_Time.text = _G.GetLangPackValue(90031700070)
    end
end

---刷新界面
function SociatyMobaSettleView:RefreshPanel()
    self.sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self:RefreshSociatyInfo()
end

---刷新进度条
function SociatyMobaSettleView:RefreshSlider()
    if self.curSociatyLevel == self.sociatyLevel.HeavenlyLevel then
        ---已经到天级后进度条直接拉满
        self.go_table.slider_level.value = 700
    elseif self.curSociatyLevel == self.sociatyLevel.NotLevel then
        ---未定级
        self.go_table.slider_level.value = self.sociatySelf.SevenDayLive / self.baseScore * 80
    else
        local value = 80 + (self.curSociatyLevel - 1) * 185
        ---TODO:需要加上下一级的进度
        self.go_table.slider_level.value = value
    end
end

function SociatyMobaSettleView:InitHelp()
    local hasShowed = _G.PlayerPrefsManager.GetInt("SociatyBattleMobaHelp_Settle", 0)
    if hasShowed == 0 then
        _G.PlayerPrefsManager.SetInt("SociatyBattleMobaHelp_Settle", 1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaHelpView.Name, 1)
    end
end

---初始化公会等级
function SociatyMobaSettleView:InitSociatyLevel()
    self.levelCfg = {}
    self.maxLevel = 1
    local configs = _G.ConfigManager.guild_moba_normal_cfg
    for k, v in ipairs(configs) do
        self.levelCfg[v.id] = v
        if v.id > self.maxLevel then
            self.maxLevel = v.id
        end
    end
    self.curShowLevel = _G.Mathf.Max(1, self.curSociatyLevel)
    SociatyMobaModel:GetInstance():GetRankInfo(_G.handler(self, self.UpdateSeasonAward))
    self.go_table.aortext_activeLimit.text =
        _G.GetLangPackValue(90031700235, self.baseScore)
end

function SociatyMobaSettleView:UpdateSociatyLevel()
    local cfg, tb, level
    for k = 1, 3 do
        tb = self.levelItemList[k]
        level = self.curShowLevel + k - 2
        cfg = self.levelCfg[level]
        if cfg == nil then
            tb.gameObject:SetActiveE(0)
        else
            tb.gameObject:SetActiveE(1)
            tb.aortext_stage.text = self.rankName[level]
            local pos = self.rankNamePos[level]
            tb.aortext_stage:SetLocalPosition(pos[1], pos[2])
            tb.aortext_stage.color = _G.ColorTools.FormatColorByString(levelColor[level])
            tb.aorrawimage_icon:LoadImage(levelIcon[level])
        end
    end
    cfg = self.levelCfg[self.curShowLevel]
    self.go_table.aortext_activeLimit:SetActiveE(self.curSociatyLevel == self.sociatyLevel.NotLevel and 1 or 0)
    self.go_table.aorimage_nowbg:SetActiveE(self.curShowLevel == self.curSociatyLevel and 1 or 0)
    if self.scoreLevel == self.curShowLevel then
        self.go_table.aorimage_stageScoreBg:SetActiveE(0)
        self.go_table.aortext_stagescore:SetLocalPosition(1, -131, 0)
        self.go_table.aortext_stagescore.text = _G.GetLangPackValue(90000010439, SociatyMobaModel:GetInstance().score)
    else
        self.go_table.aorimage_stageScoreBg:SetActiveE(1)
        self.go_table.aortext_stagescore:SetLocalPosition(1, 276, 0)
        if cfg.min == 0 then
            self.go_table.aortext_stagescore.text = _G.GetLangPackValue(90031700235, self.baseScore)
        else
            self.go_table.aortext_stagescore.text = _G.GetLangPackValue(90031700239, cfg.min)
        end
    end
    self.go_table.aortext_nowstage.text = self.levelName[cfg.id]
    self.go_table.aorbtn_left:SetActiveE(self.levelCfg[self.curShowLevel - 1] and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.levelCfg[self.curShowLevel + 1] and 1 or 0)

    self:UpdateWinAndLoseAward()
end

