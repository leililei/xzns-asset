---初始化战力信息
function SociatyMobaEmbattleView:InitViewInfo(power)
    if not power then
        power = self:SetPower()
    end
    self.go_table.aortext_teamSort.text = _G.GetLangPackValue(90031700088) .. self.sortIndex
    local powerText = _G.GameUtil.NumberToUnitStrFight(power)
    if _G.AppSetting.IsXzns then--星座战力显示用了位图字体，做一下文本内容适配
        powerText = _G.GameUtil.NumberToImage(power)
        powerText = _G.string.lower(powerText)
        if _G.string.contains(powerText, ".") then
            local powerTexts = _G.string.split(powerText, ".")
            powerText = powerTexts[1] .. "-" .. powerTexts[2]
        end
    end
    self.go_table.aortext_power.text = powerText
end

---刷新当前阵容排名
function SociatyMobaEmbattleView:RefreshRank()
    local power = self:SetPower()
    if power == 0 or self.lineInfoNum == 0 then
        self.sortIndex = self.haveEmbattle and self.lineInfoNum or self.lineInfoNum + 1
    else
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        if self.lineInfo[self.sortIndex] and self.lineInfo[self.sortIndex].uid == uid then
            self.lineInfo[self.sortIndex].power = power
        else
            local isChange = false
            for _, v in ipairs(self.lineInfo) do
                if v.uid == uid then
                    v.power = power
                    isChange = true
                    break
                end
            end
            if not isChange then
                _G.table.insert(self.lineInfo, {uid = uid, power = power})
            end
        end
        _G.SortList(
            self.lineInfo,
            function(data)
                return data.power
            end
        )
        for i, v in ipairs(self.lineInfo) do
            if v.uid == uid then
                self.sortIndex = i
                break
            end
        end
    end
    self:InitViewInfo(power)
end

---保持选中卡牌的数据
function SociatyMobaEmbattleView:SaveSelectCardData(data)
    self.selectCardData = data
    self:RefreshRank()
end

---保持选中合击技的数据
function SociatyMobaEmbattleView:SaveSelectSkillData(data)
    self.selectSkillData = data
end

function SociatyMobaEmbattleView:SaveSelectBeastData(data)
    self.selectBeastData = data
end

---更新阵容
function SociatyMobaEmbattleView:UpdateEmbattle()
    local updateData = {}
    local isChange = false
    local isEmptyGarray = false
    if _G.table.sameByCount(self.selectCardData, {0, 0, 0, 0, 0}) then
        ---当前是空阵容
        isEmptyGarray = true
    end
    for _, v in pairs(self.garray) do
        if v.id == self.curLine then
            if not isEmptyGarray then
                if _G.AppSetting.IsXzns then
                    _G.table.insert(
                        updateData,
                        {id = self.curLine, sits = self.selectCardData, skill_index = {0, 0, 0}, pet = self.selectSkillData, beast = self.selectBeastData}
                    )
                else
                    _G.table.insert(
                        updateData,
                        {id = v.id, sits = self.selectCardData, skill_index = {0, 0, 0}, pet = self.selectSkillData}
                    )
                end
            end
            isChange = true
        else
            for i, sUid in pairs(v.pet) do
                if not self.otherSelectSkillData[sUid] then
                    v.pet[i] = 0
                end
            end
            if _G.AppSetting.IsXzns then
                for i, sUid in pairs(v.beast) do
                    if not self.otherSelectBeastData[sUid] then
                        v.beast[i] = 0
                    end
                end
            end
            _G.table.insert(updateData, v)
        end
    end
    if not isChange then
        ---原数据
        if _G.AppSetting.IsXzns then
            _G.table.insert(
                updateData,
                {id = self.curLine, sits = self.selectCardData, skill_index = {0, 0, 0}, pet = self.selectSkillData, beast = self.selectBeastData}
            )
        else
            _G.table.insert(
                updateData,
                {id = self.curLine, sits = self.selectCardData, skill_index = {0, 0, 0}, pet = self.selectSkillData}
            )
        end
    end
    require("SociatyMobaModel"):GetInstance():UpdateGarray(
        updateData,
        function()
            if self.callBack then
                self.callBack()
            end
            self:Close()
        end
    )
end

---设置战力
function SociatyMobaEmbattleView:SetPower()
    local power = 0
    for _, v in ipairs(self.selectCardData) do
        if v and v > 0 then
            local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, v)
            if not _G.table.isEmptyOrNil(data) then
                power = power + data:GetPower()
            end
        end
    end
    return power
end

function SociatyMobaEmbattleView:OneKeyEmbattle()
    local frontRow = {
        [1] = true,
        [2] = true
    }
    local backSort = {3, 4, 5, 1, 2}
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    cards =
        _G.table.chooseToArray(
        cards,
        function(_, CardData)
            if CardData.Grade < 3 then
                ---只显示绝品质及以上角色
                return false
            end
            return not self.otherSelectCardData[CardData.sid]
        end
    )
    _G.SortList(
        cards,
        function(data)
            return data.power, data.star
        end
    )
    self.selectCardData = {0, 0, 0, 0, 0}
    self.selectCardSid = {}
    local cardSidList = {}
    local card
    for i = 1, 3 do
        card = cards[i]
        if card then
            if not cardSidList[card.sid] then
                self.selectCardSid[card.sid] = card.uid
                if frontRow[card.cfg.Distance] then
                    for j = 1, 5 do
                        if self.selectCardData[j] == 0 then
                            self.selectCardData[j] = card.uid
                            cardSidList[card.sid] = true
                            break
                        end
                    end
                else
                    for j = 1, 5 do
                        if self.selectCardData[backSort[j]] == 0 then
                            self.selectCardData[backSort[j]] = card.uid
                            cardSidList[card.sid] = true
                            break
                        end
                    end
                end
            end
        end
    end
    if self.go_table.toggle_card.isOn == true then
        self.embattleCard:Show(true, true, self.selectCardData, self.selectCardSid, self.otherSelectCardData)
    else
        self.embattleCard:LoadSelectItem(self.selectCardData, self.selectCardSid)
    end

    local pets = require("PetModel"):GetInstance():GetAllActivePets()
    local proPets = {}
    for _, pet in pairs(pets) do
        if not self.otherSelectSkillData[pet.sid] then
            if not proPets[pet.cfg.professional] then
                proPets[pet.cfg.professional] = {}
            end
            _G.table.insert(proPets[pet.cfg.professional], pet)
        end
    end

    self.selectSkillData = {0, 0, 0}
    for i = 1, 3 do
        if proPets[i] then
            _G.SortList(
                proPets[i],
                function(data)
                    return data.power, data.star
                end
            )
            self.selectSkillData[i] = proPets[i][1].sid
        end
    end

    if _G.AppSetting.IsXzns then
        local beasts = require("BeastModel"):GetInstance():GetAllActiveBeasts()
        local typeBeasts = {{}, {}}--1可以主战，2可以协战
        for _, beast in pairs(beasts) do
            if not self.otherSelectBeastData[beast.sid] then
                _G.table.insert(typeBeasts[1], beast)
                if beast.cfg.skill_id[1][2] ~= 0 then--有协战技的才能协战
                    _G.table.insert(typeBeasts[2], beast)
                end
            end
        end
        self.typeBeasts = typeBeasts
        self.selectBeastData = {0, 0, 0}
        for i = 1, 3 do
            local type = i == 1 and 1 or 2
            if typeBeasts[type] then
                _G.SortList(
                        typeBeasts[type],
                        function(data)
                            return data.power, data.order, data.star, data.level
                        end
                )
                if typeBeasts[type][1] then
                    self.selectBeastData[i] = typeBeasts[type][1].sid
                    _G.table.remove(typeBeasts[type], 1)
                    if type == 1 then
                        local index = -1
                        for k, v in pairs(typeBeasts[2]) do
                            if v.sid == self.selectBeastData[i] then
                                index = k
                                break
                            end
                        end
                        if index ~= -1 then
                            _G.table.remove(typeBeasts[2], index)--已经在主战的从协战中删除
                        end
                    end
                end
            end
        end
    end

    if self.go_table.toggle_skill.isOn == true then
        if _G.AppSetting.IsXzns then
            self.embattleSkill:Show(true, true, self.selectBeastData,self.otherSelectBeastData, self.typeBeasts)
        else
            self.embattleSkill:Show(true, true, self.selectSkillData, self.otherSelectSkillData)
        end
    else
        if _G.AppSetting.IsXzns then
            self.embattleSkill:RefreshSelectSkill(self.selectBeastData)
        else
            self.embattleSkill:RefreshSelectSkill(self.selectSkillData)
        end
    end
    self:InitViewInfo()
end

function SociatyMobaEmbattleView:OnToggle(go, isOn, callback, index)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    -- if isOn then
    -- callback(self, index)
    -- end
end

---按钮点击事件在这里派发
function SociatyMobaEmbattleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.toggle_card then
        self.embattleCard:Show(isOn, true, self.selectCardData, self.selectCardSid, self.otherSelectCardData)
        self:OnToggle(go, isOn, self.RefreshView, 1)
    elseif go == self.go_table.toggle_skill then
        if _G.AppSetting.IsXzns then
            self.embattleSkill:Show(isOn, true, self.selectBeastData, self.otherSelectBeastData)
        else
            self.embattleSkill:Show(isOn, true, self.selectSkillData, self.otherSelectSkillData)
        end
        self:OnToggle(go, isOn, self.RefreshView, 2)
    elseif go == self.go_table.aorbtn_confirm then
        local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
        local StateEnum = SociatyMobaModel:GetInstance().SociatyMobaBattleState
        if state ~= StateEnum.Embattle and state ~= StateEnum.EmbattleAllDay then
            _G.PopWindowManager:GetInstance():ShowAllTips(950111)
            return
        end
        self:UpdateEmbattle()
    elseif go == self.go_table.aorbtn_oneKey then
        self:OneKeyEmbattle()
    end
end

function SociatyMobaEmbattleView:Dispose()
    if self.embattleCard then
        self.embattleCard:Dispose()
        self.embattleCard = nil
    end
    if self.embattleSkill then
        self.embattleSkill:Dispose()
        self.embattleSkill = nil
    end
end

return SociatyMobaEmbattleView
