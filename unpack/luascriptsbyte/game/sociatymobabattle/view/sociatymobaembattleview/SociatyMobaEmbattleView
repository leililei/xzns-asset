---界面的入口函数
---@param garray i_garray 布阵数据数组
---@param curLine number 当前分线
---@param lineInfo table 当前分线阵容
---@param callBack function 阵容更新回调
function SociatyMobaEmbattleView:OnCreate(garray, curLine, lineInfo, callBack)
    self.curLine = curLine
    self.callBack = callBack
    self.garray = garray or {}
    if not self.embattleCard then
        self.embattleCard = require("SociatyMobaEmbattleCard").New(self.go_table.obj_card, self)
        self.embattleCard:Hide()
    end
    if not self.embattleSkill then
        self.embattleSkill = require("SociatyMobaEmbattleSkill").New(self.go_table.obj_skill, self)
        self.embattleSkill:Hide()
    end
    ---当前分线路的卡牌uid
    self.selectCardData = {0, 0, 0, 0, 0}
    ---当前分线路的卡牌sid
    self.selectCardSid = {}
    ---其他线路的数据<uid>
    self.otherSelectCardData = {}
    self.selectSkillData = {0, 0, 0}
    self.selectBeastData = {0, 0, 0}
    self.otherSelectSkillData = {}
    self.otherSelectBeastData = {}
    for _, v in pairs(self.garray) do
        if v.id == curLine then
            self.selectSkillData = _G.DeepCopy(v.pet)
            self.selectCardData = _G.DeepCopy(v.sits)
            if _G.AppSetting.IsXzns then
                self.selectBeastData = _G.DeepCopy(v.beast)
            end
            for _, cUid in pairs(v.sits) do
                if cUid and cUid > 0 then
                    local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cUid)
                    self.selectCardSid[data.sid] = data.uid
                end
            end
        else
            for _, cUid in pairs(v.sits) do
                if cUid and cUid > 0 then
                    local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cUid)
                    if v.id == curLine then
                        self.selectCardSid[data.sid] = data.uid
                    else
                        self.otherSelectCardData[data.sid] = v.id
                    end
                end
            end
            for _, sUid in ipairs(v.pet) do
                if sUid and sUid > 0 then
                    self.otherSelectSkillData[sUid] = v.id
                end
            end
            if _G.AppSetting.IsXzns then
                for _, sUid in ipairs(v.beast) do
                    if sUid and sUid > 0 then
                        self.otherSelectBeastData[sUid] = v.id
                    end
                end
            end
        end
    end
    self.embattleCard:LoadSelectItem(self.selectCardData, self.selectCardSid)
    if _G.AppSetting.IsXzns then
        self.embattleSkill:RefreshSelectSkill(self.selectBeastData)
    else
        self.embattleSkill:RefreshSelectSkill(self.selectSkillData)
    end
    self.go_table.toggle_card.isOn = false
    self.go_table.toggle_card.isOn = true
    -- self.go_table.toggle_skill.isOn = false
    ---获取分线数据
    self:GetLineInfo(lineInfo)
    ---刷新界面
    self:RefreshView(1)
    ---当前阵容在队伍在的索引
    if not self.sortIndex then
        self.sortIndex = self.lineInfoNum + 1
    end
    self:InitViewInfo()
    self.go_table.aortext_teamNum.text = _G.GetLangPackValue(90031700049, self.lineInfoNum)
    self.go_table.aortext_title.text = _G.GetLangPackValue(TitleTxt[self.curLine])
end

---重新组装数据，因为要修改数据用于排序
function SociatyMobaEmbattleView:GetLineInfo(lineInfo)
    self.lineInfo = {}
    self.lineInfoNum = 0
    for i, v in ipairs(lineInfo) do
        self.lineInfo[i] = {
            uid = v.uid,
            power = v.power
        }
        self.lineInfoNum = self.lineInfoNum + 1
        if v.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            self.sortIndex = i
            self.haveEmbattle = true
        end
    end
end

