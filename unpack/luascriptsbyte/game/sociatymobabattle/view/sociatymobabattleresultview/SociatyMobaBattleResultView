---百分比转换
function SociatyMobaBattleResultView:formatDecimalToString(num)
    -- 使用 string.format 保留两位小数
    local formatted = _G.string.format("%.2f", num)
    -- 移除末尾的零
    formatted = formatted:gsub("0*$", "")
    -- 如果小数点后面没有数字，则移除小数点
    if formatted:sub(-1) == "." then
        formatted = formatted:sub(1, -2)
    end
    return formatted .. "%"
end

---战斗的结果
function SociatyMobaBattleResultView:RefreshResult()
    local data = self.battleData[self.selectIndex] or {}
    if not self.WinEff then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jiesuanshenglinewduoqi,
                self.go_table.obj_win,
                function(obj)
                    if self.go_table==nil or self.WinEff then
                        _G.DestroyObject(obj)
                        return
                    end
                    self.WinEff = obj
                end
        )
    end
    if not self.LostEff then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jiesuanshibaiewduoqi,
            self.go_table.obj_lose,
            function(obj)
                if self.go_table==nil or self.LostEff then
                    _G.DestroyObject(obj)
                    return
                end
                self.LostEff = obj
            end
    )
    end
    if not self.UIAnimator then
        self.UIAnimator=self.go_table.obj_infoPanel:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    if self.isMineSociaty then
        self.go_table.obj_win:SetActiveE(data.self_mvp and data.win and 1 or 0)
        self.go_table.obj_lose:SetActiveE(data.self_mvp and not data.win and 1 or 0)
        self.go_table.obj_infoPanel:SetActiveE(data.self_mvp and 1 or 0)
    else
        self.go_table.obj_win:SetActiveE(data.rival_mvp and not data.win and 1 or 0)
        self.go_table.obj_lose:SetActiveE(data.rival_mvp and data.win and 1 or 0)
        self.go_table.obj_infoPanel:SetActiveE(data.rival_mvp and 1 or 0)
    end
    if self.UIAnimator then
        self.UIAnimator.enabled=false
        self.UIAnimator.enabled=true
        self.go_table.obj_infoPanel:SetActiveE(0)
        self.go_table.obj_infoPanel:SetActiveE(1)
        self.UIAnimator:Play("ani_SociatyMobaBattleResultView",0,0)
    end
    if self.WinEff then
        self.WinEff:SetActiveE(0)
        self.WinEff:SetActiveE(self.go_table.obj_win:GetActiveSelf())
    end
    if self.LostEff then
        self.LostEff:SetActiveE(0)
        self.LostEff:SetActiveE(self.go_table.obj_lose:GetActiveSelf())
    end
    self.go_table.obj_lrbtn:SetActiveE((data.self_mvp or data.rival_mvp) and 1 or 0)
    -- if not data.self_mvp then
    --     ---当前战斗场次没有数据
    --     -- return
    -- end
    local mvpData
    local killStr = ""
    local allkillStr = ""
    local rate = 0
    if self.isMineSociaty then
        mvpData = data.self_mvp
        if not mvpData then
            return
        end
        ---我方击杀比例,击杀数为0时表示我方轮空

        if mvpData.all_kill > 0 then
            rate = self:formatDecimalToString((mvpData.all_kill / data.g_kill_num) * 100)
        end
        killStr = killStr .. _G.GetLangPackValue(90031700089)
    elseif data.rival_mvp then
        mvpData = data.rival_mvp
        if not mvpData then
            return
        end
        ---对手击杀比例
        if data.m_kill_num > 0 then
            rate = self:formatDecimalToString((mvpData.all_kill / data.m_kill_num) * 100)
        end
        killStr = killStr .. _G.GetLangPackValue(90031700089)
    end
    if mvpData then
        ---总击杀数
        allkillStr = _G.GetLangPackValue(90031700091)
        self.go_table.aortext_killRate.text = _G.GetLangPackValue(90031700116)
        self.go_table.aortext_killRatevalue.text = _G.GetLangPackValue(90031700309, mvpData.max_num)
        self.go_table.aortext_name.text = mvpData.name

        require("SystemSettingNet"):GetInstance():GetPlayerInfo(
            {uid = mvpData.uid},
            function(msg)
                if not msg.info then
                    return
                end
                if self.go_table and self.go_table.aortext_guildname then
                    self.go_table.aortext_guildname.text = msg.info.guild_name
                end
            end
        )
        self.go_table.aortext_killvalue.text = mvpData.all_kill
    end
    self.go_table.aortext_kill.text = allkillStr

    self.go_table.aortext_killbl.text = killStr
    self.go_table.aortext_killblvalue.text = rate
end

---刷新下拉列表
function SociatyMobaBattleResultView:RefreshDropDown()
    self.go_table.aorbtn_down:SetActiveE(not self.unfold and 1 or 0)
    self.go_table.aorbtn_up:SetActiveE(self.unfold and 1 or 0)
    self.go_table.obj_options:SetActiveE(self.unfold and 1 or 0)
    local data = self.battleData[self.selectIndex]
    local count = table.count(self.battleData)
    self.go_table.aortext_dropdown.text = _G.GetLangPackValue(90031700122, data.f_season_id, data.f_index)
    self.go_table.aortext_titlename.text = _G.GetLangPackValue(90031700122, data.f_season_id, data.f_index)
    if self.unfold then
        if not self.optionListView then
            self.go_table.scrollloopvectical_optation:InitItemData(
                #self.battleData,
                _G.handler(self, self.RefreshOptionItem)
            )
            self.optionListView = self.go_table.scrollloopvectical_optation
        else
            self.optionListView:UpdateAllItem()
        end
    end
end

function SociatyMobaBattleResultView:RefreshOptionItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOption, eIndex))
    local data = self.battleData[eIndex]
    if self.selectIndex == eIndex then
        tb.aortext_label.text =
            string.format("<color=#5bdf99>%s</color>", _G.GetLangPackValue(90031700122, data.f_season_id, data.f_index))
    else
        tb.aortext_label.text = _G.GetLangPackValue(90031700122, data.f_season_id, data.f_index)
    end
    --tb.aorimage_select:SetActiveE(self.selectIndex == eIndex and 1 or 0)

    local canGet = data.self_mvp and self.isMineSociaty and data.award_mvp and data.award ~= 0 and data.award_mvp == 0
    tb.obj_redPoint:SetActiveE(canGet and 1 or 0)
end

---下拉列表点击事件
function SociatyMobaBattleResultView:OnClickOption(_, _, eIndex)
    if self.selectIndex == eIndex then
        return
    end
    self.selectIndex = eIndex
    self:RefreshDropDown()
    self:RefreshResult()
    self:LoadRoleModel()
    self:RefreshBoxShow()
end

---界面的销毁函数
function SociatyMobaBattleResultView:OnDestroy()
    if self.camera ~= nil then
        self.camera.depth = 0
    end
    if self.camera3D then
        self.camera3D.depth = 1
    end
    if self.sceneTrans then
        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    end
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
    self:RemoveAllListener()
end

---宝箱奖励
function SociatyMobaBattleResultView:OnClickAwardBox()
    local data = self.battleData[self.selectIndex]
    if self.isMineSociaty and data.award_mvp and data.award_mvp == 0 and data.award ~= 0 then
        ---领取MVP奖励
        require("SociatyMobaModel"):GetInstance():GetFightAward(
            2,
            data.f_season_id,
            data.f_index,
            data.season_cfg_id,
            function()
                ---TODO:刷新宝箱状态
                self:RefreshBoxShow()
                self:RefreshDropDown()
            end
        )
        return
    end

    ---奖励弹窗
    self.go_table.aorbtn_TipsView:SetActiveE(1)
    local cfg = _G.ConfigManager.guild_moba_normal_cfg[data.season_cfg_id]
    if self.go_table.obj_win:GetActiveSelf() == 1 then
        self.awards = cfg.mvp_rewards
    else
        self.awards = cfg.smvp_rewards
    end
    if not self.awardListView then
        self.go_table.scrollloopvectical_award:InitItemData(#self.awards, _G.handler(self, self.RefreshAward))
        self.awardListView = self.go_table.scrollloopvectical_award
    else
        self.awardListView:UpdateCount(#self.awards)
    end
end

function SociatyMobaBattleResultView:RefreshAward(index, obj)
    index = index + 1
    local data = self.awards[index]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        obj,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.8)
            item.gameObject:SetActiveE(1)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end

