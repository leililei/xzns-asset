function SociatyMobaBattleResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaBattleResultView:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyMobaBattleResultView,self.go_table)
    ---是否展示自己公会的信息
    self.isMineSociaty = true
    ---选择场次
    self.selectIndex = 1
    self.styles = {}
    self.scale = 1
    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        self.scale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end
    self:UpdateView()

    self:RefreshResult()
    self:LoadRoleModel()
    self:RefreshBoxShow()
    self.go_table.aorbtn_mine:SetActiveE(0)
    local data = self.battleData[self.selectIndex] or {}
    self.go_table.aorbtn_enemy:SetActiveE(data.rival_mvp == nil and 0 or 1)
    --self:LoadScene()
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaBattleEnd, self.UpdateView)
    --self:LoadEffect()
end

function SociatyMobaBattleResultView:LoadEffect()
end

---刷新界面
function SociatyMobaBattleResultView:UpdateView()
    local seasonIndex = SociatyMobaModel:GetInstance():GetSeasonIndex()
    self.seasonId = SociatyMobaModel:GetInstance():GetSeasonId()
    self.battleData = SociatyMobaModel:GetInstance():GetBattleInfo()
    local haveData = false
    for _, v in pairs(self.battleData) do
        if v.f_season_id == self.seasonId and seasonIndex == v.f_index then
            haveData = true
            break
        end
    end
    if not haveData then
        _G.table.insert(self.battleData, {f_index = seasonIndex, f_season_id = self.seasonId})
    end
    ---剔除未结束对局
    for i = 1, table.count(self.battleData) do
        if table.count(self.battleData[i]) <= 2 then
            table.remove(self.battleData, i)
        end
    end
    _G.SortList(
        self.battleData,
        function(a)
            return a.f_season_id, a.f_index
        end
    )
    self:FindFirstCanAwardIndex()
    self:RefreshDropDown()
    self:RefreshResult()
end

function SociatyMobaBattleResultView:FindFirstCanAwardIndex()
    self.selectIndex = 1
    local data
    for i = 1, #self.battleData do
        data = self.battleData[i]
        if self.isMineSociaty and data.award_mvp and data.award ~= 0 and data.award_mvp == 0 then
            self.selectIndex = i
            break
        end
    end
end

---加载模板场景
function SociatyMobaBattleResultView:LoadScene()
    local scene = _G.ConfigManager.ui_scens_cfg[5].Scene
    _G.PoolsManager:GetInstance():Spawn(
        scene,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("场景无法加载 path:" .. scene)
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            local x, y, z, hit
            local rankParent = trans:GetChildE(trans:GetChildCountE() - 1)
            self.modelParent = rankParent:GetChildE(0)
            x, y = self.go_table.obj_shadow:GetPosition()
            hit, x, y, z = _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(0, 0, 0, x, y)
            if hit then
                self.modelParent:SetPosition(x, y, z)
            end
            self.gameObject:SetActiveE(1)

            self.sceneTrans = trans
            self.rankTrans = rankParent
            self.camera = _G.Camera.main
            self.camera.depth = 55
            local camera = _G.FindObject("3DUICam")
            if not _G.IsNil(camera) then
                self.camera3D = camera:GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
                self.camera3D.depth = 55
            end
            self:LoadRoleModel()
        end
    )
end

---加载单个角色
function SociatyMobaBattleResultView:LoadRoleModel()
    local roleCount = self.go_table.trans_role:GetChildCountE()
    for i = 1, roleCount do
        local temp = self.go_table.trans_role:GetChildE(i - 1)
        _G.PoolsManager:GetInstance():Despawn(temp, _G.ePoolType.Temporary)
    end
    local data = self.battleData[self.selectIndex]
    if self.isMineSociaty and not data.self_mvp or not data.rival_mvp and not self.isMineSociaty then
        ---当前战斗场次没有数据
        return
    end
    local mvpData
    if self.isMineSociaty then
        mvpData = data.self_mvp
    else
        mvpData = data.rival_mvp
    end
    local cfg = _G.ConfigManager.card_show_cfg[mvpData.city_style]
    ---@type card_cfg
    local cardCfg = require "CardCommentManager":GetInstance():CardData(mvpData.city_style, false)
    if not _G.AppSetting.IsXzns then
        self.go_table.trans_role:SetLocalScaleXYZ(cardCfg.size2*0.5)
        local pos = cardCfg.pos_portrait
        self.go_table.trans_role:SetLocalPosition(pos[1]*cardCfg.size2*0.5, (pos[2]+650)*cardCfg.size2*0.5, pos[3])
    end
    _G.PoolsManager:GetInstance():Spawn(
        _G.AppSetting.IsXzns and _G.UIUtils.GetBattleSpine(cardCfg) or cardCfg.ModelPathHi,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                return
            end
            if _G.IsNil(self.go_table.trans_role) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                return
            end
            trans:SetParentE(self.go_table.trans_role)
            if _G.AppSetting.IsXzns then
                self.go_table.trans_role:SetLocalScaleXYZ(1)
            end
            self.roleTrans = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            if not table.isEmptyOrNil(mvpData.artifact_skin) then
                _G.UIUtils.LoadArtifacteffect(trans,nil ,mvpData.artifact_skin[1],mvpData.artifact_skin[2])
            end
            self:GetRoleStyle(mvpData.uid, rolePoint, mvpData.name)
        end
    )
end

