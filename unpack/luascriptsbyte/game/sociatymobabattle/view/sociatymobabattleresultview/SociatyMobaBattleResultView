function SociatyMobaBattleResultView:RefreshBoxShow()
    local data = self.battleData[self.selectIndex]
    local hasBox = data.self_mvp and self.isMineSociaty and data.award_mvp and data.award ~= 0
    local isGet = hasBox and data.award_mvp ~= 0
    local canGet = hasBox and data.award_mvp == 0
    self.go_table.aorimage_boxRedPoint:SetActiveE(canGet and 1 or 0)
    --self.go_table.aorimage_toggleRedPoint:SetActiveE(canGet and 1 or 0)
    self.go_table.aorbtn_box:SetGray(isGet)
    self.go_table.aorimage_box_on:SetActiveE(isGet and 1 or 0)
    self.go_table.aorimage_box_off:SetActiveE(isGet and 0 or 1)
end

---按钮点击事件在这里派发
function SociatyMobaBattleResultView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_dropdown then
        ---下拉列表
        self.unfold = not self.unfold
        self:RefreshDropDown()
    elseif go == self.go_table.aorbtn_mine then
        ---自己方

        self.isMineSociaty = true
        self:RefreshResult()
        self:LoadRoleModel()
        self:RefreshBoxShow()
        self.go_table.aorbtn_mine:SetActiveE(0)
        self.go_table.aorbtn_enemy:SetActiveE(1)
    elseif go == self.go_table.aorbtn_enemy then
        ---敌人方

        self.isMineSociaty = false
        self:RefreshResult()
        self:LoadRoleModel()
        self:RefreshBoxShow()
        self.go_table.aorbtn_mine:SetActiveE(1)
        self.go_table.aorbtn_enemy:SetActiveE(0)
    elseif go == self.go_table.aorbtn_box then
        ---奖励
        self:OnClickAwardBox()
    elseif go == self.go_table.aorbtn_TipsView then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
    end
end

function SociatyMobaBattleResultView:UpdateTitle(uid, rolePoint, name)
    local title = self.styles[uid].title
    local parent = self.roleTrans
    name = "<color=#ffee9c>" .. name .. "</color>"
    if not self.title or _G.IsNil(self.title.gameObject) then
        -- if not title or title <= 0 then
        --     return
        -- end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if (_G.IsNil(parent)) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.title = go_table
                self:SetTitlePos(rolePoint)
                go_table.aortext_TextName.text = name
                if not title or title <= 0 then
                    self.title.aorrawimage_Title:SetActiveE(0)
                    return
                end
                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[title]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale * self.scale)
                            end
                        )
                        if self.title.item then
                            _G.DestroyObject(self.title.item)
                            self.title.item = nil
                        end
                        self.title.aorrawimage_Title:SetActiveE(1)
                    else
                        self.title.aorrawimage_Title:SetActiveE(0)
                        if self.title.item then
                            _G.DestroyObject(self.title.item)
                            self.title.item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.title.gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.title.item = trans
                                local x, y, z = self.title.aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.title.item:SetLocalScaleXYZ(self.titleScale * self.scale)
                                trans:SetActiveE(1)
                            end
                        )
                    end
                end
            end
        )
    elseif self.title then
        if self.title.item then
            _G.DestroyObject(self.title.item)
            self.title.item = nil
        end
        self.title.aortext_TextName.text = name
        if not title or title <= 0 then
            self.title.aorrawimage_Title:SetActiveE(0)
            return
        end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[title]
        if cfg.type_title == 1 then
            self.title.aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.title.aorrawimage_Title:SetNativeSize()
                    self.title.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale * self.scale)
                end
            )
            self.title.aorrawimage_Title:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.title.gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.title.item = trans
                    local x, y, z = self.title.aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.title.item:SetLocalScaleXYZ(self.titleScale * self.scale)
                    trans:SetActiveE(1)
                end
            )
            self.title.aorrawimage_Title:SetActiveE(0)
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function SociatyMobaBattleResultView:SetTitlePos(rolePoint)
    _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if self.title and not _G.IsNil(self.title.gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans
                    if parent == nil then ---快速切换角色时gameObj可能被置位nil
                        return
                    end
                    local position = {}
                    position.x = x
                    position.z = z
                    position.y = y
                    local scale = parent:GetLocalScale()
                    local rate = self.scale
                    self.title.gameObject:SetLocalScaleXYZ(rate * 0.8 / scale)
                    self.title.transform:SetLocalPositionToZero()
                    self.title.transform:SetPosition(position.x, position.y, position.z)
                    local lookAt = self.title.transform:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
                    if _G.IsNil(lookAt) then
                        lookAt = self.title.transform:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
                    end
                    lookAt:SetData(self.camera.transform, parent)
                end
            end
        end
    )
end

function SociatyMobaBattleResultView:UpdateHalo(uid, rolePoint)
    if self.halo then
        _G.PoolsManager:GetInstance():Despawn(self.halo, _G.ePoolType.Temporary)
        self.halo = nil
    end
    local halo = self.styles[uid].circle
    if halo == nil or halo <= 0 then
        return
    end
    local parent = self.roleTrans
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[halo]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo = trans
            if cfg.type_halo == 2 then
                self.halo:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo:GetParent():GetLocalScale()
                local rate = self.scale
                self.halo:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo:GetChildE(0):SetActiveE(1)
            self.halo:SetEulerAngles(0, 0, 0)
            self.halo:SetLocalPositionToZero()
        end
    )
end

return SociatyMobaBattleResultView
