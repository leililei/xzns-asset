---野怪刷新特效
function SociatyMobaBattleView:ShowCreepAppearEffect(sid)
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[sid]
    if not self.creepAppearEff[cfg.type] then
        self.creepAppearEff[cfg.type] = true
        local effCfg
        if cfg.type == 2 then
            effCfg = nil
        elseif cfg.type == 3 then
            effCfg = nil
        elseif cfg.type == 4 then
            effCfg = nil
        end
        if effCfg == nil then
            return
        end
        UIUtils.LoadEffectByCfg(
            effCfg,
            self.go_table.obj_screenEff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.creepAppearEff[cfg.type] = trans
            end
        )
    elseif self.creepAppearEff[cfg.type] ~= true then
        self.creepAppearEff[cfg.type]:SetActiveE(0)
        self.creepAppearEff[cfg.type]:SetActiveE(1)
        _G.DelayDo(
            3,
            function()
                if self:IsNil() then
                    return
                end
                self.creepAppearEff[cfg.type]:SetActiveE(0)
            end
        )
    end
end

