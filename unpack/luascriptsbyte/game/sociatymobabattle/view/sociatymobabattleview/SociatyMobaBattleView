function SociatyMobaBattleView:GetCreepStateDes(cfg)
    local sText
    local data = SociatyMobaBattleModel:GetInstance():GetCreepData(cfg.id)
    if data.state == CreepState.OurWin then
        if data.use == 0 then
            sText = _G.GetLangPackValue(90031700124)
        else
            sText = _G.GetLangPackValue(90031700125, LanerName[data.use])
        end
    else
        sText = _G.GetLangPackValue(90031700123)
    end
    return _G.GetLangPackValue(cfg.name[1][1]) .. ":" .. sText
end

