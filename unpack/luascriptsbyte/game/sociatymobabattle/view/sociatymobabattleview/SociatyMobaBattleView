function SociatyMobaBattleView:OnMapScrolling(pos)
    local x = pos[0] * ScrollX
    local y = pos[1] * ScrollY
    local isShow, outX, outY, alpha
    for sid, item in pairs(self.creepItems) do
        if item.needPointer then
            outX = self.pointerParam[sid][1] < x or self.pointerParam[sid][1] > x + ScreenX
            outY = self.pointerParam[sid][2] < y or self.pointerParam[sid][2] > y + ScreenY
            isShow = outX or outY
            if isShow then
                alpha = math.atan((self.pointerParam[sid][2] - y - HalfY) / (self.pointerParam[sid][1] - x - HalfX))
                if math.abs(alpha) > ArctanScreen then
                    if self.pointerParam[sid][2] < y then
                        self.pointers[sid].gameObject:SetLocalPosition(HalfY * math.tan(alpha - HalfPi), -HalfY + 50, 0)
                    else
                        self.pointers[sid].gameObject:SetLocalPosition(-HalfY * math.tan(alpha - HalfPi), HalfY - 50, 0)
                    end
                else
                    if self.pointerParam[sid][1] < x then
                        self.pointers[sid].gameObject:SetLocalPosition(-HalfX + 50, -HalfX * math.tan(alpha), 0)
                    else
                        self.pointers[sid].gameObject:SetLocalPosition(HalfX - 50, HalfX * math.tan(alpha), 0)
                    end
                end
            end
            self.pointers[sid].gameObject:SetActiveE(isShow and 1 or 0)
        elseif self.pointers[sid] then
            self.pointers[sid].gameObject:SetActiveE(0)
        end
    end
end

