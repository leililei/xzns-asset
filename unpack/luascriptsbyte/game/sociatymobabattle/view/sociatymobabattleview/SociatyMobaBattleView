function SociatyMobaBattleView:OnClickCreepSelf(go, isOn)
    if self.curChooseCreep == nil then
        return
    end
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local canCreep, tipID = SociatyMobaBattleModel:GetInstance():GetPlayerCanCreep(uid)
    if not canCreep then
        if tipID then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipID)
        end
        return
    end
    SociatyMobaBattleModel:GetInstance():SetCreepMarch(
        self.curChooseCreep,
        { uid },
        function(id, msg)
            self.go_table.obj_CreepSelfPanel:SetActiveE(0)
            local times = SociatyMobaBattleModel:GetInstance():GetCreepTimes(uid)
            self.creepSelfPanel.aortext_creepTimes.text = _G.GetLangPackValue(90031700083, times)
            -- self:OnSetCreepMarch(id, posDic)
        end
    )
end

function SociatyMobaBattleView:OnClickCreepTeam(go, isOn)
    if go == self.creepTeamPanel.aorbtn_sort then
        self.reverseTeam = not self.reverseTeam
        self:SortTeamData()
        self.creepTeamPanel.scrollloopvectical_team:UpdateAllItem()
    elseif go == self.creepTeamPanel.toggle_selectAll then
        if isOn then
            for _, v in pairs(self.teamSort) do
                if not self:CheckCreepTeamNum() then
                    break
                end
                if SociatyMobaBattleModel:GetInstance():GetCreepTimes(v.uid) > 0 then
                    self.selectTeam[v.uid] = true
                end
            end
        else
            self.selectTeam = {}
        end
        self.creepTeamPanel.scrollloopvectical_team:UpdateAllItem()
    elseif go == self.creepTeamPanel.aorbtn_sure then
        local uidLis = _G.table.KeyToTable(self.selectTeam)
        if #uidLis == 0 then
            return
        end
        SociatyMobaBattleModel:GetInstance():SetCreepMarch(
            self.curChooseCreep,
            uidLis,
            function(id, msg)
                self.selectTeam = {}
                self.creepTeamPanel.toggle_selectAll.isOn = false
                self.go_table.obj_CreepTeamPanel:SetActiveE(0)
                -- self.creepTeamPanel.scrollloopvectical_team:UpdateAllItem()
                -- self:OnSetCreepMarch(id, posDic)
                ---有次数又没在打野，说明取消了托管
                if msg.uids then
                    for _, uid in pairs(msg.uids) do
                        if SociatyMobaBattleModel:GetInstance():GetCreepTimes(uid) > 0 then
                            if not SociatyMobaBattleModel:GetInstance():CheckIsCreeping(uid) then
                                _G.PopWindowManager:GetInstance():ShowAllTips(950114)
                                break
                            end
                        end
                    end
                end
            end
        )
    end
end

function SociatyMobaBattleView:OnClickCreepTeamItem(go, isOn, uid)
    if isOn then
        local canCreep, tipID = SociatyMobaBattleModel:GetInstance():GetPlayerCanCreep(uid)
        if not canCreep then
            go.isOn = false
            self.selectTeam[uid] = nil
            if tipID then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipID)
            end
            return
        elseif not self.selectTeam[uid] and not self:CheckCreepTeamNum() then
            _G.PopWindowManager:GetInstance():ShowAllTips(950108)
            go.isOn = false
            self.selectTeam[uid] = nil
            return
        end
        self.selectTeam[uid] = true
    else
        self.selectTeam[uid] = nil
    end
end

function SociatyMobaBattleView:CheckCreepTeamNum()
    return _G.table.count(self.selectTeam) < 10
end

