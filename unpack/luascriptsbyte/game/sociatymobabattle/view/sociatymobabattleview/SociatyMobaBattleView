function SociatyMobaBattleView:UpdatePlayerCreepAuto(msg)
    ---设置自己时推送可能比ack返回快
    local isSelf = msg.role_uid == _G.PlayerModel:GetInstance():GetPlayerUid()
    if isSelf then
        SociatyMobaModel:GetInstance().autoWild = msg.type
    end
    SociatyMobaBattleModel:GetInstance():OnPlayerCreepAutoChange(msg)
    if SociatyMobaModel:GetInstance():CheckSelfIsCommander() then
        if not isSelf then
            self.selectTeam[msg.role_uid] = nil
        end
    end
    self:TryUpdateCreepTeamPanel()
end

---@param msg guild_moba.p2c_wild_set_change
function SociatyMobaBattleView:UpdatePlayerCreepPreset(msg)
    SociatyMobaBattleModel:GetInstance():UpdateCreepPreset(
        function()
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyMobaBuffSetView.Name)
            local ctrl1 =
                _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyMobaCreepPresetView.Name)
            if ctrl or ctrl1 then
                local presetData = _G.DeepCopy(SociatyMobaBattleModel:GetInstance().creepPreset)
                if ctrl then
                    ctrl.presetData = presetData
                    ctrl:RefreshList()
                end
                if ctrl1 then
                    ctrl1.presetData = presetData
                    ctrl1:RefreshTeam()
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(950119)
            end
        end
    )
end

function SociatyMobaBattleView:OnEndInput(str)
    if str == self.curNotice then
        return
    end
    if not SociatyMobaModel:GetInstance():CheckSelfIsCommander() then
        return
    end
    local pbData = { notice = str }
    SociatyMobaNet:GetInstance():SetNotice(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                self.go_table.input_notice.text = self.curNotice or ""
                return
            end
            self.curNotice = str
        end
    )
end

function SociatyMobaBattleView:UpdateStage(state, nextTime)
    local isTimer
    if state == nil then
        isTimer = true
        state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    end
    self.state = state
    self.stageCountDown = 0
    self.go_table.obj_resultOurF:SetActiveE(0)
    self.go_table.obj_resultOurV:SetActiveE(0)
    self.go_table.obj_resultEnemyF:SetActiveE(0)
    self.go_table.obj_resultEnemyV:SetActiveE(0)
    if state == StateEnum.Settlement or state == StateEnum.SeasonSettlement then
        self.stageCountDown = nextTime - _G.TimeUtil.GetServerUnixTime()
        self.stageShowTime = self.stageCountDown
        self.stageTxt = _G.GetLangPackValue(90031700077)
        if self.mapInit then
            SociatyMobaBattleModel:GetInstance():GetBattleInfo(_G.handler(self, self.BattleStart))
        end
    elseif state == StateEnum.Fighting then
        -- self.go_table.aortext_stage.text = _G.GetLangPackValue(90031700076)
        self.stageTxt = _G.GetLangPackValue(90031700076)
        if self.mapInit then
            if SociatyMobaBattleModel:GetInstance():CheckBattleEnd() ~= 0 then
                nextTime = SociatyMobaModel:GetInstance():GetSettlementEndTime()
                self.stageTxt = _G.GetLangPackValue(90031700077)
            end
            SociatyMobaBattleModel:GetInstance():GetBattleInfo(_G.handler(self, self.BattleStart))
        end
        self.stageCountDown = nextTime - _G.TimeUtil.GetServerUnixTime()
        self.stageShowTime = self.stageCountDown
    elseif state == StateEnum.EmbattleAllDay or state == StateEnum.Match or state == StateEnum.Grading then
        if isTimer then
            self:ShowCloudEffect(true)
        end
        if state == StateEnum.EmbattleAllDay then
            self.stageCountDown =
                SociatyMobaModel:GetInstance():GetStateStartTimeAcrossDay(StateEnum.Grading) -
                _G.TimeUtil.GetServerUnixTime()
        elseif state == StateEnum.Grading then
            self.stageCountDown =
                SociatyMobaModel:GetInstance():GetStateStartTimeAcrossDay(StateEnum.SeasonSettlement) -
                _G.TimeUtil.GetServerUnixTime()
        else
            self.stageCountDown =
                SociatyMobaModel:GetInstance():GetStateStartTimeAcrossDay(StateEnum.Embattle) -
                _G.TimeUtil.GetServerUnixTime()
        end
        self.stageShowTime = self.stageCountDown
        self.stageTxt = _G.GetLangPackValue(state == StateEnum.Grading and 90031700070 or 90031700167)
    else
        if state == StateEnum.Embattle and isTimer then ---计时器转阶段
            self:ShowCloudEffect(false)
            if not self.isEnter then
                self.isEnter = true
                SociatyMobaNet:GetInstance():EnterBattleScene({ type = 1 })
            end
            if self.mapInit then
                SociatyMobaBattleModel:GetInstance():GetBattleInfo(_G.handler(self, self.BattleStart))
            end
        end
        if state == StateEnum.Prepare and isTimer then
            self:UpdateTowerNumByPrepare()
        end
        self.stageCountDown = nextTime - _G.TimeUtil.GetServerUnixTime()
        self.stageShowTime =
            SociatyMobaModel:GetInstance():GetStateStartTimeAcrossDay(StateEnum.Fighting) -
            _G.TimeUtil.GetServerUnixTime()
        self.stageTxt = _G.GetLangPackValue(90031700075)
    end
    local beforeBattle =
        state == StateEnum.Embattle or state == StateEnum.Adjustline or state == StateEnum.Prepare or
        state == StateEnum.EmbattleAllDay
    self.go_table.obj_preparationStage:SetActiveE(beforeBattle and 1 or 0)
    self.go_table.aorbtn_battleArmy:SetGray(self.state ~= StateEnum.Embattle and self.state ~= StateEnum.EmbattleAllDay)
    self.lockCountDown = state == StateEnum.Embattle and nextTime - _G.TimeUtil.GetServerUnixTime() or 0

    self.go_table.aorbtn_record:SetActiveE((state == StateEnum.Fighting or state == StateEnum.Settlement) and 1 or 0)
    local inNormal =
        state == StateEnum.Embattle or state == StateEnum.Adjustline or state == StateEnum.Prepare or
        state == StateEnum.Fighting or
        state == StateEnum.Settlement
    self.go_table.aorbtn_tactic:SetActiveE(0) --ZHJH-7609 移动至出征队伍战术页签中
    self.go_table.obj_lockTip:SetActiveE(0)   --改为不显示，before： inNormal and 1 or 0
    self.go_table.aorbtn_help:SetActiveE(state == StateEnum.Fighting and 0 or 1)
    self.go_table.obj_stageBg:SetActiveE(state == StateEnum.Fighting and 0 or 1)
    local enemyUid = SociatyMobaBattleModel:GetInstance():GetSociatyUid(false)
    enemyUid = enemyUid or 0
    self.go_table.aorbtn_guess:SetActiveE((inNormal and enemyUid > 1) and 1 or 0)
    self.go_table.aortext_byeTip:SetActiveE(SociatyMobaBattleModel:GetInstance().isBye and 1 or 0)
    self:UpdateEmbattleTip()
end

function SociatyMobaBattleView:UpdateTime(elapsed)
    if self.stageCountDown > 0 then
        self.stageCountDown = self.stageCountDown - elapsed
        if self.stageCountDown < 0 then
            self.stageCountDown = 0
        end
        self.stageShowTime = self.stageShowTime - elapsed
        if self.stageShowTime < 0 then
            self.stageShowTime = 0
        end
        self.go_table.obj_stageBg:SetActiveE((self.state == StateEnum.Fighting and self.mapInit and SociatyMobaBattleModel:GetInstance():CheckBattleEnd() == 0) and
            0 or 1)
        local t = _G.TimeUtil.TranslateSecondForStrDHMS(_G.Mathf.RoundToInt(self.stageShowTime))
        self.go_table.aortext_stageTime.text = _G.GetLangPackValue(90031700250, self.stageTxt, t)
    else
        self:UpdateStage()
    end

    if self.lockCountDown > 0 then
        self.lockCountDown = self.lockCountDown - elapsed
        if self.lockCountDown < 0 then
            self.lockCountDown = 0
        end
    end
    if self.lockCountDown > 0 then
        local time = _G.TimeUtil.TransDayHourMineMiao(_G.Mathf.RoundToInt(self.lockCountDown))
        self.go_table.aortext_lockTip.text = _G.GetLangPackValue(90031700019, time)
    else
        self.go_table.aortext_lockTip.text = _G.GetLangPackValue(90031700099)
    end

    if self.creepItems then
        for _, v in pairs(self.creepItems) do
            v:UpdateTime(elapsed)
        end
    end
    self:UpdateCreepPreviewTime(elapsed)
end

function SociatyMobaBattleView:PlayAttack(elapsed)
    if self.state == StateEnum.Fighting then
        self.aniAtk = not self.aniAtk
        local atkKey = self.aniAtk and "our" or "enemy"
        local hertKey = self.aniAtk and "enemy" or "our"
        if self.playerItems then
            local atkArrived, hertArrived
            for i = 1, 3 do
                atkArrived = false
                hertArrived = false
                if self.playerItems[atkKey][i] ~= nil or self.playerItems[hertKey][i] ~= nil then
                    for _, item in pairs(self.playerItems[atkKey][i]) do
                        if item.arrived then
                            atkArrived = true
                        end
                    end
                    for _, item in pairs(self.playerItems[hertKey][i]) do
                        if item.arrived then
                            hertArrived = true
                        end
                    end
                    if atkArrived and hertArrived then
                        for _, item in pairs(self.playerItems[atkKey][i]) do
                            if item.arrived then
                                item:DoAttack()
                            end
                        end
                        for _, item in pairs(self.playerItems[hertKey][i]) do
                            if item.arrived then
                                item:DoHert()
                            end
                        end
                    end
                end
            end
        end
        if self.playerCreepItems then
            local indexE
            for sid, items in pairs(self.playerCreepItems[atkKey]) do
                for _, item in pairs(items) do
                    indexE = item.gameObject:GetSiblingIndexE()
                    item:DelayDoAttack(indexE * 0.5)
                end
            end
            for sid, items in pairs(self.playerCreepItems[hertKey]) do
                for _, item in pairs(items) do
                    indexE = item.gameObject:GetSiblingIndexE()
                    item:DelayDoHert(indexE * 0.5)
                end
            end
        end
    end
end

function SociatyMobaBattleView:UpdateWinOrFail()
    local winner = SociatyMobaBattleModel:GetInstance():CheckBattleEnd()
    if winner ~= 0 then
        self.go_table.obj_resultOurV:SetActiveE((winner == 1 or winner == 3) and 1 or 0)
        self.go_table.obj_resultOurF:SetActiveE(winner == 2 and 1 or 0)
        self.go_table.obj_resultEnemyV:SetActiveE((winner == 2 or winner == 3) and 1 or 0)
        self.go_table.obj_resultEnemyF:SetActiveE(winner == 1 and 1 or 0)
    end
end

