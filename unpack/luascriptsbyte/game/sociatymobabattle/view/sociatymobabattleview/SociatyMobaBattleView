    else
        self.go_table.obj_embattleTip:SetActiveE(0)
    end
end

---@param tMarch guild_moba.i_fight_tower
function SociatyMobaBattleView:InitLanerPlayer(tMarch)
    local obj, item
    if tMarch["m_" .. self.abOur] then
        for _, m in pairs(tMarch["m_" .. self.abOur]) do
            if not self:PlayerIsExist(tMarch.sid, m.team.uid) then
                obj = _G.InstantiateObject(self.go_table.obj_player, self.go_table.trans_map)
                item = SociatyMobaPlayerItem.New(obj, true, self.sortingOrder)
                item:Show(m)
                local onTheWay, time, x, y, tx, ty =
                    SociatyMobaBattleModel:GetInstance():CalLanerPlayerPos(tMarch.sid, m.e_time, true)
                item:SetPosition(x, y)
                item:SetRotation(SociatyMobaBattleModel:GetInstance().hitRotation[tMarch.sid])
                if onTheWay then
                    item:MoveTo(tx, ty, time, _G.handlerbind(self, self.UpdatePlayBattleEffect, tMarch.sid))
                else
                    item.arrived = true
                    self:UpdatePlayBattleEffect(tMarch.sid)
                end
                _G.table.insert(self.playerItems["our"][tMarch.sid], item)
            end
        end
    end
    if tMarch["m_" .. self.abEnemy] then
        for _, m in pairs(tMarch["m_" .. self.abEnemy]) do
            if not self:PlayerIsExist(tMarch.sid, m.team.uid) then
                obj = _G.InstantiateObject(self.go_table.obj_player, self.go_table.trans_map)
                item = SociatyMobaPlayerItem.New(obj, false, self.sortingOrder)
                item:Show(m)
                local onTheWay, time, x, y, tx, ty =
                    SociatyMobaBattleModel:GetInstance():CalLanerPlayerPos(tMarch.sid, m.e_time, false)
                item:SetPosition(x, y)
                item:SetRotation(SociatyMobaBattleModel:GetInstance().hitRotation[tMarch.sid])
                if onTheWay then
                    item:MoveTo(tx, ty, time, _G.handlerbind(self, self.UpdatePlayBattleEffect, tMarch.sid))
                else
                    item.arrived = true
                    self:UpdatePlayBattleEffect(tMarch.sid)
                end
                _G.table.insert(self.playerItems["enemy"][tMarch.sid], item)
            end
        end
    end
end

---@param cMarch guild_moba.i_fight_wild
function SociatyMobaBattleView:InitCreepPlayer(cMarch)
    local obj, sSid, index
    if self.playerItems["our"][cMarch.sid] == nil then
        self.playerItems["our"][cMarch.sid] = {}
    end
    if self.playerItems["enemy"][cMarch.sid] == nil then
        self.playerItems["enemy"][cMarch.sid] = {}
    end
    if cMarch["m_" .. self.abOur] then
        for _, m in pairs(cMarch["m_" .. self.abOur]) do
            if not self:PlayerIsExist(cMarch.sid, m.team.uid) then
                sSid = m.s_sid // SSidCoef
                index = m.s_sid % SSidCoef
                local onTheWay, time, x, y, tx, ty =
                    SociatyMobaBattleModel:GetInstance():CalCreepPlayerPos(cMarch.sid, m.e_time, true, sSid, index)
                if onTheWay then
                    obj = _G.InstantiateObject(self.go_table.obj_player, self.go_table.trans_map)
                    local item = SociatyMobaPlayerItem.New(obj, true, self.sortingOrder)
                    item:Show(m)
                    item:SetPosition(x, y)
                    item:SetIndex(sSid, index)
                    item:MoveTo(
                        tx,
                        ty,
                        time,
                        function()
                            SociatyMobaBattleModel:GetInstance():OnCreepTeamArrive(cMarch.sid, item.uid, true)
                            self.creepItems[cMarch.sid]:UpdateShow()
                            self.creepItems[cMarch.sid]:UpdateSlider()
                            _G.DestroyObject(item.gameObject)
                            item:Dispose()
                            _G.table.removebyvalue(self.playerItems["our"][cMarch.sid], item)
                        end
                    )
                    _G.table.insert(self.playerItems["our"][cMarch.sid], item)
                end
            end
        end
    end
    self:ShowFarMarchLine(true, cMarch.sid)

    if cMarch["m_" .. self.abEnemy] then
        for _, m in pairs(cMarch["m_" .. self.abEnemy]) do
            if not self:PlayerIsExist(cMarch.sid, m.team.uid) then
                sSid = m.s_sid // SSidCoef
                index = m.s_sid % SSidCoef
                local onTheWay, time, x, y, tx, ty =
                    SociatyMobaBattleModel:GetInstance():CalCreepPlayerPos(cMarch.sid, m.e_time, false, sSid, index)
                if onTheWay then
                    obj = _G.InstantiateObject(self.go_table.obj_player, self.go_table.trans_map)
                    local item = SociatyMobaPlayerItem.New(obj, false, self.sortingOrder)
                    item:Show(m)
                    item:SetPosition(x, y)
                    item:SetIndex(sSid, index)
                    item:MoveTo(
                        tx,
                        ty,
                        time,
                        function()
                            SociatyMobaBattleModel:GetInstance():OnCreepTeamArrive(m.station_id, item.uid)
                            self.creepItems[m.station_id]:UpdateShow()
                            self.creepItems[m.station_id]:UpdateSlider()
                            _G.DestroyObject(item.gameObject)
                            item:Dispose()
                            _G.table.removebyvalue(self.playerItems["enemy"][cMarch.sid], item)
                        end
                    )
                    _G.table.insert(self.playerItems["enemy"][cMarch.sid], item)
                end
            end
        end
    end
    self:ShowFarMarchLine(false, cMarch.sid)
end

function SociatyMobaBattleView:InitCreepArrivePlayer()
    for sid, v in pairs(self.creepItems) do
        self:UpdateCreepArrivePlayer(sid, true)
        self:UpdateCreepArrivePlayer(sid, false)
    end
end

function SociatyMobaBattleView:UpdateCreepArrivePlayer(sid, isOur)
    local key = isOur and "our" or "enemy"
    if not self.playerCreepItems[key][sid] then
        self.playerCreepItems[key][sid] = {}
    end
    local obj, data, parent
    local creepItem = self.creepItems[sid]
    if creepItem.data then
        for i = 1, 3 do
            if isOur then
                data = creepItem.data.ourArrive[i]
            else
                data = creepItem.data.enemyArrive[i]
            end
            if data then
                if not self.playerCreepItems[key][sid][data.team.uid] and _G.table.count(self.playerCreepItems[key][sid]) < 3 then
                    parent = isOur and creepItem.go_table.obj_fightOur or creepItem.go_table.obj_fightEnemy
                    obj = _G.InstantiateObject(self.go_table.obj_player, parent)
                    local item = SociatyMobaPlayerItem.New(obj, isOur, self.sortingOrder)
                    item:Show(data)
                    item:SetRotation(-180)
                    self.playerCreepItems[key][sid][item.uid] = item
                end
            end
        end
    end
end

function SociatyMobaBattleView:ClearCreepArrivePlayer(sid)
    if sid then
        if self.playerCreepItems["our"][sid] then
            for uid, item in pairs(self.playerCreepItems["our"][sid]) do
                if item.gameObject then
                    _G.DestroyObject(item.gameObject)
                end
                item:Dispose()
                self.playerCreepItems["our"][sid][uid] = nil
            end
        end
        if self.playerCreepItems["enemy"][sid] then
            for uid, item in pairs(self.playerCreepItems["enemy"][sid]) do
                if item.gameObject then
                    _G.DestroyObject(item.gameObject)
                end
                item:Dispose()
                self.playerCreepItems["enemy"][sid][uid] = nil
            end
        end
        return
    end
    for sid, v in pairs(self.playerCreepItems["our"]) do
        for uid, item in pairs(v) do
            if item.gameObject then
                _G.DestroyObject(item.gameObject)
            end
            item:Dispose()
            self.playerCreepItems["our"][sid][uid] = nil
        end
    end
    for sid, v in pairs(self.playerCreepItems["enemy"]) do
        for uid, item in pairs(v) do
            if item.gameObject then
                _G.DestroyObject(item.gameObject)
            end
            item:Dispose()
            self.playerCreepItems["enemy"][sid][uid] = nil
        end
    end
end

function SociatyMobaBattleView:InitLanerBrokenEffect()
    if self.state ~= StateEnum.Fighting and self.state ~= StateEnum.Settlement then
        for i = 1, 6 do
            self:ShowLanerBrokenEffect(i, false)
        end
        return
    end
    local LanerState = SociatyMobaBattleModel:GetInstance().LanerState
    local state
    for i = 1, 3 do
        state = SociatyMobaBattleModel:GetInstance():GetLanerState(i)
        if state == LanerState.Victory then
            self:ShowLanerBrokenEffect(i, true)
        elseif state == LanerState.Defeat then
            self:ShowLanerBrokenEffect(i + 3, true)
        else
            self:ShowLanerBrokenEffect(i, false)
            self:ShowLanerBrokenEffect(i + 3, false)
        end
    end
end

---玩家队伍已存在（防止重复生成）
function SociatyMobaBattleView:PlayerIsExist(lanerId, uid)
    if self.playerItems["our"][lanerId] then
        for _, item in pairs(self.playerItems["our"][lanerId]) do
            if item.uid == uid then
                return true
            end
        end
    end
    if self.playerItems["enemy"][lanerId] then
        for _, item in pairs(self.playerItems["enemy"][lanerId]) do
            if item.uid == uid then
                return true
            end
        end
    end
    return false
end

---显示行军线
function SociatyMobaBattleView:ShowFarMarchLine(isOur, sid)
    local items
    if isOur then
        items = self.playerItems["our"][sid]
    else
        items = self.playerItems["enemy"][sid]
    end
    local farItems = {}
    for _, item in pairs(items) do
        if farItems[item.sSid] == nil then
            farItems[item.sSid] = item
        elseif item.eTime > farItems[item.sSid].eTime then
            farItems[item.sSid] = item
        elseif item.eTime == farItems[item.sSid].eTime then
            if item.index > farItems[item.sSid].index then
                farItems[item.sSid] = item
            end
        end
    end
    local now = _G.TimeUtil.GetServerUnixTime()
    for _, item in pairs(items) do
        if item.uid ~= farItems[item.sSid].uid then
            item:HideMarchLine()
        elseif not item.showLine then
            local time = item.eTime - now
            if time > 0 then
                item:ShowMarchLine(item.targetX, item.targetY, time)
            end
        end
    end
end

