---战斗开始
---@param data guild_moba.s2c_guild_moba_fight_info
function SociatyMobaBattleView:BattleStart(data)
    -- LogError(data)
    -- self:ClearAllPlayer()
    self:InitTitle()
    self.homeItems["our"]:Show()
    self.homeItems["enemy"]:Show()
    for _, v in pairs(self.towerItems["our"]) do
        for _, item in pairs(v) do
            item:RebuildShow()
            item:UpdateShow(self.state)
            if self.state == StateEnum.Prepare then
                item:ShowPrepareTeamNum()
            end
        end
    end
    for _, v in pairs(self.towerItems["enemy"]) do
        for _, item in pairs(v) do
            item:RebuildShow()
            item:UpdateShow(self.state)
        end
    end
    for _, item in pairs(self.creepItems) do
        item:Show()
    end
    if data.tower_march then
        for _, v in pairs(data.tower_march) do
            self:InitLanerPlayer(v)
        end
    end
    if data.wild_march then
        for _, v in pairs(data.wild_march) do
            self:InitCreepPlayer(v)
        end
    end
    self:UpdateCreepPreview()
    self:InitLanerBrokenEffect()
    if SociatyMobaBattleModel:GetInstance():CheckBattleEnd() ~= 0 then
        if self.state == StateEnum.Fighting or self.state == StateEnum.Grading then
            if self.state == StateEnum.Fighting then
                self:UpdateWinOrFail()
            end
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyMobaChatView.Name)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleResultView.Name)
        end
    end
    self:UpdateMinRank()
end

---战斗结束
---@param msg guild_moba.p2c_moba_wind
function SociatyMobaBattleView:BattleEnd(msg)
    -- self:ClearAllPlayer()
    local winUid = msg.win_uid
    SociatyMobaBattleModel:GetInstance():SetWinSociaty(winUid)
    for _, item in pairs(self.creepItems) do
        item:UpdateShow()
    end
    for _, v in pairs(self.towerItems["our"]) do
        for _, item in pairs(v) do
            item:HideMarchEff()
        end
    end
    for _, v in pairs(self.towerItems["enemy"]) do
        for _, item in pairs(v) do
            item:HideMarchEff()
        end
    end
    self:ClearAllPlayer()
    self.go_table.aorbtn_mvp:SetActiveE(1)
    self:UpdateWinOrFail()
    self:OnReceiveActionLog(msg)
    self:UpdateCreepPreview()
    -- _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.FixUpdateGameItem, self)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyMobaChatView.Name)
    if self.isRecording then
        self.delayShowResult = true
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleResultView.Name)
    end
end

function SociatyMobaBattleView:OnRecordStart()
    self.isRecording = true
end

function SociatyMobaBattleView:OnRecordEnd()
    if self.delayShowResult then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleResultView.Name)
    end
    self.delayShowResult = false
    self.isRecording = false
end

