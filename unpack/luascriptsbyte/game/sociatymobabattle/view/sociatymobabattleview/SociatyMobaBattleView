---@param data guild_moba.i_action
function SociatyMobaBattleView:ExecuteAction(data)
    if data.type == ActionType.TowerMarch then
        self:ActionTowerMarch(data.t_march)
    elseif data.type == ActionType.CreepMarch then
        self:ActionCreepMarch(data.w_march)
    elseif data.type == ActionType.TowerBroken then
        self:ActionTowerBroken(data.t_b)
    elseif data.type == ActionType.FightWin then
        self:ActionFightWin(data.fight_win)
    elseif data.type == ActionType.CreepOccupy then
        self:ActionCreepOccupy(data.h_wild)
    elseif data.type == ActionType.CreepSync then
        self:ActionCreepSync(data.wild_hold)
    elseif data.type == ActionType.UseBuff then
        self:ActionUseBuff(data.use_buff)
    end
end

---@param data guild_moba.i_action_tower_march
function SociatyMobaBattleView:ActionTowerMarch(data)
    local uid = data.tm.team.uid
    local isOur = SociatyMobaBattleModel:GetInstance():CheckIsOur(data.tm.g_uid)
    local key = isOur and "our" or "enemy"

    SociatyMobaBattleModel:GetInstance():OnTowerMarch(data.station_sid, isOur, data.tm.t_index, data.tm)
    if not self:PlayerIsExist(data.station_sid, uid) then
        local obj = _G.InstantiateObject(self.go_table.obj_player, self.go_table.trans_map)
        local item = SociatyMobaPlayerItem.New(obj, isOur, self.sortingOrder)
        item:Show(data.tm)
        local onTheWay, time, x, y, tx, ty =
            SociatyMobaBattleModel:GetInstance():CalLanerPlayerPos(data.station_sid, data.tm.e_time, isOur)
        item:SetPosition(x, y)
        item:SetRotation(SociatyMobaBattleModel:GetInstance().hitRotation[data.station_sid])
        if onTheWay then
            item:MoveTo(tx, ty, time, _G.handlerbind(self, self.UpdatePlayBattleEffect, data.station_sid))
        else
            item.arrived = true
            self:UpdatePlayBattleEffect(data.station_sid)
        end
        _G.table.insert(self.playerItems[key][data.station_sid], item)
    end

    for _, tower in pairs(self.towerItems[key][data.station_sid]) do
        tower:UpdateShow(self.state)
    end
end

---@param data guild_moba.i_wild_march
function SociatyMobaBattleView:ActionCreepMarch(data)
    local isOur = data.g_uid == self.SociatySelf.Uid
    SociatyMobaBattleModel:GetInstance():OnCreepMarch(data.station_id, data.team.uid, isOur)
    if self.creepMarchDelay == 0 then
        self:InnerActionCreepMarch(data, isOur)
    else
        local delta = _G.ConfigManager.discrete_cfg[101688][1][1]
        _G.DelayDo(self.creepMarchDelay * delta, _G.handlerbind(self, self.InnerActionCreepMarch, data, isOur))
    end
    self.creepMarchDelay = self.creepMarchDelay + 1
end

function SociatyMobaBattleView:InnerActionCreepMarch(data, isOur)
    if self:IsNil() then
        return
    end
    if not self:PlayerIsExist(data.station_id, data.team.uid) then
        local sSid = data.s_sid // SSidCoef
        local index = data.s_sid % SSidCoef
        local onTheWay, time, x, y, tx, ty =
            SociatyMobaBattleModel:GetInstance():CalCreepPlayerPos(data.station_id, data.e_time, isOur, sSid, index)
        if onTheWay then
            local obj = _G.InstantiateObject(self.go_table.obj_player, self.go_table.trans_map)
            local item = SociatyMobaPlayerItem.New(obj, isOur, self.sortingOrder)
            item:Show(data)
            item:SetPosition(x, y)
            item:SetIndex(sSid, index)
            item:MoveTo(
                tx,
                ty,
                time,
                function()
                    SociatyMobaBattleModel:GetInstance():OnCreepTeamArrive(data.station_id, item.uid, isOur)
                    self.creepItems[data.station_id]:UpdateShow()
                    self.creepItems[data.station_id]:UpdateSlider()
                    _G.DestroyObject(item.gameObject)
                    item:Dispose()
                    _G.table.removebyvalue(self.playerItems[isOur and "our" or "enemy"][data.station_id], item)
                    self:UpdateCreepArrivePlayer(data.station_id, isOur)
                end
            )
            _G.table.insert(self.playerItems[isOur and "our" or "enemy"][data.station_id], item)
            SociatyMobaBattleModel:GetInstance():OnCreepTeamMoving(data, isOur)
            self:ShowFarMarchLine(isOur, data.station_id)
        else
            SociatyMobaBattleModel:GetInstance():OnCreepTeamAlreadyArrive(data, isOur)
            self.creepItems[data.station_id]:UpdateShow()
            self:UpdateCreepArrivePlayer(data.station_id, isOur)
        end
        local key = isOur and "our" or "enemy"
        if self.playerItems[key][data.station_id] == nil then
            self.playerItems[key][data.station_id] = {}
        end
    end
end

---@param data guild_moba.i_action_tower_broken
function SociatyMobaBattleView:ActionTowerBroken(data)
    local isOur = data.g_uid == self.SociatySelf.Uid
    local key = isOur and "our" or "enemy"
    if data.type == 1 then --单塔
        if _G.AppSetting.DEBUG then
            local name = { "上路", "中路", "下路" }
            local key1 = isOur and "我方" or "敌方"
            local color = isOur and "<color=red>" or "<color=green>"
            _G.LogError(color .. "接受服务器推送：【摧毁】" .. key1 .. name[data.sid] .. data.sid_index .. "塔被击破（非报错打印）</color>")
        end
        SociatyMobaBattleModel:GetInstance():OnTowerDestroy(data.sid, data.sid_index, isOur)
        self.towerItems[key][data.sid][data.sid_index]:PlayDestroyEff()
    elseif data.type == 2 then --全线
        if _G.AppSetting.DEBUG then
            local name = { "上路", "中路", "下路" }
            local key1 = isOur and "我方" or "敌方"
            local color = isOur and "<color=red>" or "<color=green>"
            _G.LogError(color .. "接受服务器推送：【溃败】" .. key1 .. name[data.sid] .. "全线战败（非报错打印）</color>")
        end
        SociatyMobaBattleModel:GetInstance():OnLanerDefeat(data.sid, isOur)
        for _, item in pairs(self.towerItems[key][data.sid]) do
            item:PlayDestroyEff()
        end
        self:ShowLanerBrokenEffect(isOur and data.sid + 3 or data.sid, true)
    end
end

---@param data guild_moba.i_action_fight_win
function SociatyMobaBattleView:ActionFightWin(data)
    SociatyMobaBattleModel:GetInstance():SetKillNum(data.uid, data.win_kill_num or 0)
    if data.station < 4 then
        local isOur = false
        for _, v in pairs(self.playerItems["our"][data.station]) do
            if data.uid == v.uid then
                isOur = true
                break
            end
        end
        SociatyMobaBattleModel:GetInstance():OnLanerFightFail(data.station, isOur)
        self:UpdateTitleTeamNum(not isOur)
        local winKey = isOur and "our" or "enemy"
        local failKey = isOur and "enemy" or "our"
        local winItem
        for _, v in pairs(self.playerItems[winKey][data.station]) do
            if v.uid == data.uid then
                winItem = v
                break
            end
        end
        if winItem then
            if data.win_count > 0 then
                winItem:ShowKillNum(data.win_count)
            end
        end

        -- local failItem = _G.table.remove(self.playerItems[failKey][data.station], 1)
        -- if failItem then
        --     failItem:PlaySettlementEff()
        -- end
        for i = #self.playerItems[failKey][data.station], 1, -1 do
            local failItem = _G.table.remove(self.playerItems[failKey][data.station], i)
            if failItem then
                failItem:PlaySettlementEff()
            end
        end
        self:UpdatePlayBattleEffect(data.station)
    else
        local isOur, fUid = SociatyMobaBattleModel:GetInstance():OnCreepFightWin(data)
        self.creepItems[data.station]:UpdateShow()
        self.creepItems[data.station]:UpdateSlider()
        if fUid then
            local item = self.playerCreepItems[isOur and "enemy" or "our"][data.station][fUid]
            if item then
                item:PlaySettlementEff(
                    function()
                        self.playerCreepItems[isOur and "enemy" or "our"][data.station][fUid] = nil
                        self:UpdateCreepArrivePlayer(data.station, not isOur)
                    end
                )
            else
                self:UpdateCreepArrivePlayer(data.station, not isOur)
            end
        else
            self:UpdateCreepArrivePlayer(data.station, not isOur)
        end
        self:TryUpdateCreepTeamPanel()
    end
    self:UpdateMinRank()
end

