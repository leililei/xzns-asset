function SociatyMobaBattleView:RefreshCreepTeam(index, obj)
    index = index + 1
    local role = self.teamSort[index]
    ---@type _obj_SociatyMobaCreepTeamPanel._obj_teamItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCreepTeamItem, role.uid))
    tb.aortext_name.text = role.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.power)
    local times = SociatyMobaBattleModel:GetInstance():GetCreepTimes(role.uid)
    tb.aortext_creepTimes.text = _G.GetLangPackValue(90031700082, times)
    tb.toggle_select.isOn =
        SociatyMobaBattleModel:GetInstance():GetPlayerCanCreep(role.uid) and self.selectTeam[role.uid]
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        role,
        nil,
        true,
        nil,
        nil,
        function()
        end
    )

    self:ShowCards(role, tb)

    local id, skillTb
    for i = 1, 3 do
        id = role.combine[i] or 0
        skillTb = GetAutoGoTable(tb["obj_combine" .. i])
        SociatyMobaBattleModel.ShowSingleCombine(skillTb, id)
    end
end

function SociatyMobaBattleView:ShowCards(role, tb)
    local card
    for i = 1, 3 do
        card = role.cards[i]
        if tb["card" .. i] then
            if tb["card" .. i] ~= true then
                if card then
                    tb["card" .. i].gameObject:SetActiveE(1)
                    tb["card" .. i]:Show(
                        card.card_sid,
                        nil,
                        card.star,
                        card.soul_lv,
                        card.card_lv,
                        nil,
                        card.skin_id,
                        card.soul_state,
                        card.big_born_num
                    )
                else
                    tb["card" .. i].gameObject:SetActiveE(0)
                end
            end
        else
            if card then
                tb["card" .. i] = true
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    tb.obj_team,
                    function(item)
                        tb["card" .. i] = item
                        item:Show(
                            card.card_sid,
                            nil,
                            card.star,
                            card.soul_lv,
                            card.card_lv,
                            nil,
                            card.skin_id,
                            card.soul_state,
                            card.big_born_num
                        )
                    end
                )
            end
        end
    end
end

function SociatyMobaBattleView:SortTeamData()
    if self.reverseTeam then
        _G.table.sort(
            self.teamSort,
            function(a, b)
                if a.power ~ b.power then
                    return a.power < b.power
                end
                return a.uid < b.uid
            end
        )
    else
        _G.table.sort(
            self.teamSort,
            function(a, b)
                if a.power ~ b.power then
                    return a.power > b.power
                end
                return a.uid < b.uid
            end
        )
    end
end

