---@param data guild_moba.i_moba_log
function SociatyMobaBattleView:ExecuteLog(data, index)
    if data.type ~= 7 then
        self.unreadNum = self.unreadNum + 1
    end

    if data.type == 5 or data.type == 8 or data.type == 9 then
        local obj = _G.InstantiateObject(self.go_table.obj_reportItem, self.go_table.obj_reportPanel)

        ---@type SociatyMobaBattleView._obj_reportItem_GoTable
        local tb = GetAutoGoTable(obj)

        if data.r_info then
            _G.UIUtils.SetPlayerHeadItemNew(
                tb.obj_HeadItemBase,
                data.r_info,
                nil,
                true,
                true,
                nil,
                function()
                end
            )
        else
            tb.obj_HeadItemBase:SetActiveE(0)
        end

        tb.obj_creepHead:SetActiveE(data.type == 8 and 1 or 0)
        if data.type == 8 then
            local sid = _G.tonumber(data.args[1])
            local cfg = _G.ConfigManager.guild_moba_campsite_cfg[sid]
            tb.aorrawimage_icon:LoadImage(
                cfg.icon[1][1],
                function()
                    if self:IsNil() then
                        return
                    end
                    tb.aorrawimage_icon:SetNativeSize()
                end
            )
        end
        local content, colorContent, time = SociatyMobaBattleModel:GetInstance():AddReport(data)
        local isOur = SociatyMobaBattleModel:GetInstance():CheckIsOur(data.g_uid)
        self:ShowBarrageContent(obj, tb, content, index, isOur)
    else
        local content, colorContent, time = SociatyMobaBattleModel:GetInstance():AddReport(data)
        SociatyMobaTipsModel:GetInstance():Show({ colorContent, time })
    end
end

