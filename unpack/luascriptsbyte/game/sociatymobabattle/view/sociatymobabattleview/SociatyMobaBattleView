function SociatyMobaBattleView:UpdateMinRank()
    if self.minRankLua then
        if not self.waitForSortRank then
            self.waitForSortRank = true
            _G.DelayFrameDo(
                function()
                    if self:IsNil() then
                        return
                    end
                    SociatyMobaBattleModel:GetInstance():SortKillRank()
                    self.minRankLua:UpdateRankList()
                    self.waitForSortRank = false
                end
            )
        end
    end
end

