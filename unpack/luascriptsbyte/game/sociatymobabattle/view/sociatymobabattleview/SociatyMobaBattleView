function SociatyMobaBattleView:UpdateCreepPreview()
    self.creepPreviewId = 0
    local lastCountDown = 100000
    for k, v in pairs(self.creepItems) do
        if v.countDown > 0 and v.countDown < lastCountDown then
            lastCountDown = v.countDown
            self.creepPreviewId = k
        end
    end
    if self.creepPreviewId > 0 then
        self.go_table.obj_creepPreview:SetActiveE(1)
        local cfg = self.creepItems[self.creepPreviewId].cfg
        self.go_table.aortext_creepPreName.text = _G.GetLangPackValue(cfg.name[1][1])
        self.go_table.aorrawimage_creepPreIcon:LoadImage(
            cfg.icon[1][1],
            function()
                if self:IsNil() then
                    return
                end
                self.go_table.aorrawimage_creepPreIcon:SetNativeSize()
            end
        )
        self:UpdateCreepPreviewTime()
    else
        self.go_table.obj_creepPreview:SetActiveE(0)
    end
end

function SociatyMobaBattleView:UpdateCreepPreviewTime()
    if self.creepPreviewId > 0 then
        if self.creepItems[self.creepPreviewId].countDown <= 0 then
            self:UpdateCreepPreview()
        else
            local t = _G.Mathf.RoundToInt(self.creepItems[self.creepPreviewId].countDown)
            self.go_table.aortext_creepPreTime.text = _G.GetLangPackValue(90031700249,
                _G.TimeUtil.TransDayHourMineMiao(t))
        end
    end
end

function SociatyMobaBattleView:RefreshTacticRedpoint()
    local isCommander = SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman()
    local selfPreset = SociatyMobaBattleModel:GetInstance():CheckCreepSelfPreset()
    if isCommander then
        SociatyMobaBattleModel:GetInstance():CheckCreepPresetEmpty(
            nil,
            nil,
            function(isEmpty)
                self.go_table.obj_tacticRedpoint:SetActiveE(((isCommander and isEmpty) or not selfPreset) and 1 or 0)
            end
        )
    else
        self.go_table.obj_tacticRedpoint:SetActiveE(selfPreset and 0 or 1)
    end
    self:UpdateEmbattleTip()
end

function SociatyMobaBattleView:CheckShowEmbattleFace()
    if self.state == StateEnum.Embattle or self.state == StateEnum.EmbattleAllDay then
        local today = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
        if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SociatyMobaEmbattleFace) ~= today then
            local item = {
                fun = function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaEmbattleFaceView.Name)
                end,
                aniTime = 5
            }
            self:AddPopQueue(item)
        end
    end
end

