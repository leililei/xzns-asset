---分线战斗特效
function SociatyMobaBattleView:UpdatePlayBattleEffect(lanerId)
    local our, enemy
    for _, v in pairs(self.playerItems["our"][lanerId]) do
        if v.arrived then
            our = true
            break
        end
    end
    for _, v in pairs(self.playerItems["enemy"][lanerId]) do
        if v.arrived then
