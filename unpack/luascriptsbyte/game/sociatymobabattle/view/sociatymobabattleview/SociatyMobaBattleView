function SociatyMobaBattleView:InitView()
    self.creepResExpand = false
    local mvpInfo = SociatyMobaModel:GetInstance():GetBattleInfo()
    self.go_table.aorbtn_mvp:SetActiveE(#mvpInfo > 0 and 1 or 0)
    self.go_table.obj_preparationStage:SetActiveE(1)
    self.creepSelfPanel = GetAutoGoTable(self.go_table.obj_CreepSelfPanel, _G.handler(self, self.OnClickCreepSelf))
    self.creepTeamPanel = GetAutoGoTable(self.go_table.obj_CreepTeamPanel, _G.handler(self, self.OnClickCreepTeam))
    self:InitNotice()
    self:InitHelp()

    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    if
        state == StateEnum.Embattle or state == StateEnum.Adjustline or state == StateEnum.Prepare or
        state == StateEnum.Fighting or
        state == StateEnum.Settlement
    then
        self.isEnter = true
        SociatyMobaNet:GetInstance():EnterBattleScene({ type = 1 })
        self:ShowCloudEffect(false)
    else
        self:ShowCloudEffect(true)
    end
    self:UpdateStage(state, nextTime)

    self.playerItems = { our = {}, enemy = {} }
    self.playerCreepItems = { our = {}, enemy = {} }
    SociatyMobaBattleModel:GetInstance():GetBattleInfo(_G.handler(self, self.InitMap))

    self:UpdateTime(0)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()

    self.atkTimer = _G.TimerManager:GetInstance():GetTimer(2, self.PlayAttack, self, false, false, true)
    self.atkTimer:Start()

    self.go_table.obj_armyredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.GuildMobaEmbattle.id)
    self.go_table.obj_mvpredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.GuildMobaAward.id, 2)
    self:UpdateFingerShow()
    self:InitDanmu()
end

function SociatyMobaBattleView:InitNotice()
    self.go_table.input_notice.text = ""
    local limit = _G.ConfigManager.discrete_cfg[DiscreteID.noticeLimit][1][1]
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_notice, limit, nil, true, false, nil, true)
    self.go_table.input_notice.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndInput))
    self.go_table.input_notice.enabled = SociatyMobaModel:GetInstance():CheckSelfIsCommander()
end

function SociatyMobaBattleView:InitHelp()
    local hasShowed = _G.PlayerPrefsManager.GetInt("SociatyBattleMobaHelp_Battle", 0)
    if hasShowed == 0 then
        _G.PlayerPrefsManager.SetInt("SociatyBattleMobaHelp_Battle", 1)
        local item = {
            fun = function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaHelpView.Name, 2)
            end,
            aniTime = 0.5
        }
        self:AddPopQueue(item)
    end
end

function SociatyMobaBattleView:UpdateNotice(str)
    self.go_table.input_notice.text = str
end

function SociatyMobaBattleView:UpdateCommander()
    local isCommander = SociatyMobaModel:GetInstance():CheckSelfIsCommander()
    self.go_table.input_notice.enabled = isCommander
    if isCommander and self.state == StateEnum.Fighting then
        SociatyMobaBattleModel:GetInstance():UpdateCreepTimes()
    end
    self:RefreshTacticRedpoint()
end

