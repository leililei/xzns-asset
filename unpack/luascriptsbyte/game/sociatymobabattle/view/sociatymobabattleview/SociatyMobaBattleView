    if not self.creepTeamPanelInit then
        self.reverseTeam = false
        self:SortTeamData()
        self.creepTeamPanel.scrollloopvectical_team:InitItemData(
            #self.teamSort,
            _G.handler(self, self.RefreshCreepTeam)
        )
