---清理所有Item对象
function SociatyMobaBattleView:ClearAllPlayer()
    self:ClearCreepArrivePlayer()
    if self.playerItems == nil then
        return
    end
    local item, len
    for _, v in pairs(self.playerItems["our"]) do
        len = #v
        for i = 1, len do
            item = _G.table.remove(v, 1)
            if item.gameObject then
                _G.DestroyObject(item.gameObject)
            end
            item:Dispose()
        end
    end
    for _, v in pairs(self.playerItems["enemy"]) do
        len = #v
        for i = 1, len do
            item = _G.table.remove(v, 1)
            if item.gameObject then
                _G.DestroyObject(item.gameObject)
            end
            item:Dispose()
        end
    end
end

function SociatyMobaBattleView:ClearAllItem()
    if self.homeItems then
        if self.homeItems["our"] then
            _G.DestroyObject(self.homeItems["our"].gameObject)
            self.homeItems["our"]:Dispose()
            self.homeItems["our"] = nil
        end
        if self.homeItems["enemy"] then
            _G.DestroyObject(self.homeItems["enemy"].gameObject)
            self.homeItems["enemy"]:Dispose()
            self.homeItems["enemy"] = nil
        end
    end
    if self.creepItems then
        for _, item in pairs(self.creepItems) do
            _G.DestroyObject(item.gameObject)
            item:Dispose()
        end
    end
    if self.towerItems then
        if self.towerItems["our"] then
            for _, v in pairs(self.towerItems["our"]) do
                for _, item in pairs(v) do
                    _G.DestroyObject(item.gameObject)
                    item:Dispose()
                end
            end
        end
        if self.towerItems["enemy"] then
            for _, v in pairs(self.towerItems["enemy"]) do
                for _, item in pairs(v) do
                    _G.DestroyObject(item.gameObject)
                    item:Dispose()
                end
            end
        end
    end
end

