function SociatyMobaBattleView:UpdateTitleTeamNum(isOur)
    if self.state == StateEnum.Prepare then
        self.ourTitleTb.aortext_buildNum.text = ""
        self.enemyTitleTb.aortext_buildNum.text = ""
        return
    end
    local curNum = SociatyMobaBattleModel:GetInstance():GetSurvivalTeamNum(isOur)
    local maxNum = SociatyMobaBattleModel:GetInstance():GetTotalTeamNum(isOur)
    if isOur then
        self.ourTitleTb.aortext_buildNum.text = _G.GetLangPackValue(90031700023, curNum .. "/" .. maxNum)
    else
        self.enemyTitleTb.aortext_buildNum.text = _G.GetLangPackValue(90031700023, curNum .. "/" .. maxNum)
    end
end

