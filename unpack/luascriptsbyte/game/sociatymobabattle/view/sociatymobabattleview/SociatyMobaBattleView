    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaUpdateCommander, self.UpdateCommander)
    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaBattleEnd, self.BattleEnd)
    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaBattleState, self.OnReconnect)
    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaGarray, self.UpdateFingerShow)
    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaCreepPresetChange, self.RefreshTacticRedpoint)
    self:RemoveListener(net_map.guild_moba_auto_wild.Cmd, self.UpdatePlayerCreepAuto)
    self:RemoveListener(net_map.wild_set_change.Cmd, self.UpdatePlayerCreepPreset)
    self:RemoveListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:RemoveListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
    self:RemoveListener(_G.eSociatyEvent.BeKicked, self.OnMemberQuit)
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnWindowChange)
    self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnWindowChange)
