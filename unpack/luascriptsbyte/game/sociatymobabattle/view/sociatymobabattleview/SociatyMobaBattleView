---更新动画播放按钮
function SociatyMobaBattleView:UpdateDanmuBtn(type)
    if type == nil then
        self.danmuState = _G.PlayerPrefsManager.GetInt("DanmuPlaySkip")
        if self.danmuState == nil then
            self.danmuState = DrawPlayState.Play
        end
    else
        self.danmuState = type
    end
    _G.PlayerPrefsManager.SetInt("DanmuPlaySkip", self.danmuState)

    local isPlay = self.danmuState == DrawPlayState.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 30 or -30, 0, 0)
    self.go_table.aortext_wenzi.text = _G.ConfigManager.language_package_cfg
    [isPlay and DrawPlayText.Open or DrawPlayText.Close]
    self.go_table.aorimage_skip:SetActiveE(isPlay and 1 or 0)
end

---窗口变化事件
---@protected
---@return void
function SociatyMobaBattleView:OnWindowChange()
    ---@type UIBaseView[]
    local windows = _G.UIManager:GetInstance():GetAllWindows()
    if not windows or _G.table.isEmptyOrNil(windows) then
        return
    end

    --仅在战斗页面/主页面放置中显示弹幕
    if not self.ignoreWindows then
        local cfgs = {
            _G.ConfigManager.ui_cfg.ShadowView,
            _G.ConfigManager.ui_cfg.ShadowTopView,
            _G.ConfigManager.ui_cfg.GameNetTipsView,
            _G.ConfigManager.ui_cfg.HUDView,
            _G.ConfigManager.ui_cfg.MainSceneView,
            _G.ConfigManager.ui_cfg.ResLoadingView,
            _G.ConfigManager.ui_cfg.ChatDefultRootView, --mini chat view
            _G.ConfigManager.ui_cfg.QuickUseTipView,
            _G.ConfigManager.ui_cfg.FloatTipsView,
            _G.ConfigManager.ui_cfg.FloatMessagesView,
            _G.ConfigManager.ui_cfg.MainView,
            _G.ConfigManager.ui_cfg.SociatyActivityView,
            _G.ConfigManager.ui_cfg.ArenaPanelView
        }
        ---忽略的View列表
        self.ignoreWindows = {}
        for _, cfg in pairs(cfgs) do
            if cfg then
                self.ignoreWindows[cfg.Name] = true
            end
        end
    end
    self.isShow=true
    for _, view in pairs(windows) do
        if not self.ignoreWindows[view.Name] and view.Active then
            if view.Name == _G.ConfigManager.ui_cfg.SociatyMobaBattleView.Name  then
                self.isShow = true
            else
                self.isShow = false
            end
            if not self.isShow then
                break
            end
        end
    end
    --- 获取弹幕全屏界面
    self.FloatMessagesView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FloatMessagesView.Name)
    if self.FloatMessagesView then
        self.FloatMessagesView:SetShow(self.isShow)
        if self.danmuList then
            self.FloatMessagesView:GetDanmuList(self.danmuList, _G.ConfigManager.discrete_cfg[116202][1][1] * 10, true)
            self.danmuList={}
        end
    end
end

--- 初始化弹幕
function SociatyMobaBattleView:InitDanmu()
    --- 获取弹幕全屏界面
    self.FloatMessagesView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FloatMessagesView
        .Name)
    if self.FloatMessagesView then
        self.FloatMessagesView:SetEnabled(true)
    end
    --拉取战场日志
    SociatyMobaBattleModel:GetInstance():GetBattleInfoToDanmu(function(msg)
        self:ShowDanmu(msg)
    end)
end

--- 展示弹幕
function SociatyMobaBattleView:ShowDanmu(msg)
    local danmuListTest = msg.log or {}

    --- 战场日志中去取出type为123的（首杀 击杀 终结）的消息为需要加载的弹幕配置
    local danmuList = {}
    --- 弹幕拉取上限
    local maxCount = _G.ConfigManager.discrete_cfg[116202][1][1]
    --- 筛选
    for i = #danmuListTest, 1, -1 do
        if danmuListTest[i].type <= 3 and #danmuList < maxCount then
            table.insert(danmuList, danmuListTest[i])
        end
    end
    local list = SociatyMobaBattleModel:GetInstance():DanmuPairse(danmuList)
    self.FloatMessagesView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FloatMessagesView.Name)
    if self.FloatMessagesView then
        self.FloatMessagesView:SetEnabled(true)
    end
    if self.danmuState and self.FloatMessagesView and self.isShow then
        --- 发送弹幕
        self.FloatMessagesView:GetDanmuList(list, maxCount * 10, true)
    else
        if not self.danmuList then
            self.danmuList={}
        end
        for i = 1, #list do
            table.insert(self.danmuList,list[i])
        end
    end
end

