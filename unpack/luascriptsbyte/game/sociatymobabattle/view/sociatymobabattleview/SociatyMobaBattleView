function SociatyMobaBattleView:InitCreepTeamPanel(data)
    data = data or {}
    self.teamDic = data
    self.teamSort = {}
    for _, v in pairs(data) do
        if SociatyMobaBattleModel:GetInstance():GetPlayerCanCreep(v.uid) then
            _G.table.insert(self.teamSort, v)
        end
