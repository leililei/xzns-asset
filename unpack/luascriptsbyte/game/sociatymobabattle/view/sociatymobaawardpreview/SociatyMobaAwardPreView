local SociatyMobaModel = require("SociatyMobaModel")
---@class SociatyMobaAwardPreView : UIBaseView	奖励预览
---@field public go_table SociatyMobaAwardPreView_GoTable GoTable
local SociatyMobaAwardPreView = _G.BaseClass("SociatyMobaAwardPreView", _G.UIBaseView)

function SociatyMobaAwardPreView:Awake()
    self.uiDic = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@field type number 类型
function SociatyMobaAwardPreView:OnCreate(type)
    ---页签
    local PreAwardTabType = SociatyMobaModel:GetInstance().PreAwardTabType
    ---单场奖励
    if not self.singleAward then
        self.singleAward = self:AddComponent(
            self.go_table.obj_single,
            require("SociatyMobaSingleAward").New(self.go_table.obj_single, self)
        )
        self.singleAward:Hide()
        self.uiDic[PreAwardTabType.Single] = self.singleAward
    end
    ---赛季奖励
    if not self.seasonAward then
        self.seasonAward = self:AddComponent(
            self.go_table.obj_season,
            require("SociatyMobaSeasonAward").New(self.go_table.obj_season, self)
        )
        self.seasonAward:Hide()
        self.uiDic[PreAwardTabType.Season] = self.seasonAward
    end

    local defaultType = type or PreAwardTabType.Single
    self.go_table.toggle_single.isOn = defaultType == PreAwardTabType.Single
    self.go_table.toggle_season.isOn = defaultType == PreAwardTabType.Season
end

---刷新页签
function SociatyMobaAwardPreView:RefreshToggle(go, isOn, callBack)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    callBack()
end

---界面的销毁函数
function SociatyMobaAwardPreView:Dispose()
    for _, v in pairs(self.uiDic) do
        v:Dispose()
    end
end

---按钮点击事件在这里派发
function SociatyMobaAwardPreView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.toggle_single then
        ---单场奖励
        self:RefreshToggle(go, isOn, function()
            self.singleAward:Show(isOn)
        end)
    elseif go == self.go_table.toggle_season then
        ---赛季奖励
        self:RefreshToggle(go, isOn, function()
            self.seasonAward:Show(isOn)
        end)
    end
end

return SociatyMobaAwardPreView
