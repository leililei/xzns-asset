function SociatyMobaGuessView:InitGoTable()
    self.typeTable = {
        _G.GetAutoGoTable(self.go_table.obj_typeSociaty),
        _G.GetAutoGoTable(self.go_table.obj_typeLaner, _G.handlerbind(self, self.OnClickLaner)),
        _G.GetAutoGoTable(self.go_table.obj_typeMaxKill),
        _G.GetAutoGoTable(self.go_table.obj_typeOverKill)
    }
    self.ourSociatyTb = _G.GetAutoGoTable(self.typeTable[1].obj_ourSociaty)
    self.enemySociatyTb = _G.GetAutoGoTable(self.typeTable[1].obj_enemySociaty)
end

function SociatyMobaGuessView:InitView()
    self.guessInfo, self.guessDic = SociatyMobaModel:GetInstance():GetCurGuessInfo()
    if _G.table.isEmptyOrNil(self.guessInfo) then
        self.enemyUid = SociatyMobaBattleModel:GetInstance():GetSociatyUid(false)
        self.guessInfo = {
            guild_uid1 = self.sociatyUid,
            guild_uid2 = self.enemyUid
        }
    else
        if self.guessInfo.guild_uid1 == self.sociatyUid then
            self.enemyUid = self.guessInfo.guild_uid2
        else
            self.enemyUid = self.guessInfo.guild_uid1
        end
    end
    self:UpdateShow(true)
    SociatyModel:GetInstance():GetOtherStatueInfo(self.sociatyUid, _G.handlerbind(self, self.InitFameHall, true))
    SociatyModel:GetInstance():GetOtherStatueInfo(self.enemyUid, _G.handlerbind(self, self.InitFameHall, false))
    SociatyMobaModel:GetInstance():GetGuessSupportInfo(
        self.guessInfo.guild_uid1,
        self.guessInfo.guild_uid2,
        self.guessIds,
        _G.handler(self, self.GetGuessSupportInfoHandler)
    )
end

function SociatyMobaGuessView:UpdateCfg()
    self.go_table.obj_selectEff:SetActiveE(0)
    self.go_table.obj_selectEff2:SetActiveE(0)

    self.curId = self.guessIds[self.curIndex]
    self.curCfg = _G.ConfigManager.guild_moba_guess_cfg[self.curId]
    self.curType = self.curCfg.conditon[1]
end

---名人堂
---@param msg guild.s2c_other_guild_statue
function SociatyMobaGuessView:InitFameHall(msg, isOur)
    if msg.ack ~= 1 then
        return
    end
    local allRoles = msg.roles or {}
    local roles = { [1] = {}, [2] = {}, [3] = {} }
    for _, v in pairs(allRoles) do
        _G.table.insert(roles[v.pos], v)
    end
    if isOur then
        self.ourFameData = msg
        self:ShowSociatyWinBase(self.ourSociatyTb, msg, roles[1][1])
    else
        self.enemyFameData = msg
        self:ShowSociatyWinBase(self.enemySociatyTb, msg, roles[1][1])
    end
    ---@type SociatyMobaGuessView._obj_fameHallOur_GoTable|SociatyMobaGuessView._obj_fameHallEnemy_GoTable
    local tb = _G.GetAutoGoTable(isOur and self.go_table.obj_fameHallOur or self.go_table.obj_fameHallEnemy)
    tb.aortext_sociatyName.text = msg.name
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[msg.banner].portrait)
    self:CreateRole(tb.obj_player1, roles[1][1])
    self:CreateRole(tb.obj_player2, roles[2][1])
    self:CreateRole(tb.obj_player3, roles[2][2])
    self:CreateRole(tb.obj_player4, roles[3][1])
    self:CreateRole(tb.obj_player5, roles[3][2])
end

function SociatyMobaGuessView:CreateRole(obj, role)
    if role then
        ---@type _obj_fameHallOur._obj_player1_GoTable
        local playerTb = _G.GetAutoGoTable(obj)
        local pos = role.pos
        playerTb.aortext_name.text = role.role.name
        playerTb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.role.power)
        playerTb.aorimage_official.SpriteName = officialBg[pos]
        playerTb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[pos].name)
        playerTb.aortext_offName.color = officialColor[pos]
        playerTb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(nil, role.role.city_style_id)
        _G.PoolsManager:GetInstance():Spawn(
            _G.AppSetting.IsXzns and _G.UIUtils.GetBattleSpine(cfg) or cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            playerTb.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                if _G.AppSetting.IsXzns then
                    playerTb.obj_spine:SetLocalScaleXYZ(1)
                end
                if not table.isEmptyOrNil(role.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,role.artifact_skin[1],role.artifact_skin[2])
                end
                trans:SetLocalScaleXYZ(cfg.size2)
            end
        )
    else
        obj:SetActiveE(0)
    end
end

---刷新竞猜项
function SociatyMobaGuessView:UpdateShow(isShowAnim)
    self.go_table.obj_typeSociaty:SetActiveE(self.curType == _G.SociatyMobaGuess.Win and 1 or 0)
    self.go_table.obj_typeLaner:SetActiveE(self.curType == _G.SociatyMobaGuess.LanerWin and 1 or 0)
    self.go_table.obj_typeMaxKill:SetActiveE(
        (self.curType == _G.SociatyMobaGuess.KillMax or self.curType == _G.SociatyMobaGuess.SerialMax) and 1 or 0
    )
    self.go_table.obj_typeOverKill:SetActiveE(
        (self.curType == _G.SociatyMobaGuess.KillNum or self.curType == _G.SociatyMobaGuess.SerialNum) and 1 or 0
    )
    self.go_table.aorbtn_left:SetActiveE(self.curIndex > 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.curIndex < self.idNum and 1 or 0)
    self.go_table.aorrawimage_vs:SetActiveE(self.curType == _G.SociatyMobaGuess.Win and 1 or 0)
    self.go_table.aorrawimage_shield:SetActiveE(
        (self.curType == _G.SociatyMobaGuess.KillMax or self.curType == _G.SociatyMobaGuess.KillNum or
            self.curType == _G.SociatyMobaGuess.SerialMax or
            self.curType == _G.SociatyMobaGuess.SerialNum) and
        1 or
        0
    )

    self.go_table.aortext_question.text = _G.GetLangPackValue(self.curCfg.desc[1])
    self.go_table.aortext_target.text = _G.GetLangPackValue(self.curCfg.desc[2])
    self.go_table.aortext_desOur.text = _G.GetLangPackValue(self.curCfg.button_desc[1])
    self.go_table.aortext_desEnemy.text = _G.GetLangPackValue(self.curCfg.button_desc[2])
    self.go_table.aorimage_hasBetOur:SetActiveE(self.guessDic[self.curId] == self.sociatyUid and 1 or 0)
    self.go_table.aorimage_hasBetEnemy:SetActiveE(self.guessDic[self.curId] == self.enemyUid and 1 or 0)

    local unGuess = self.guessDic[self.curId] == nil and not self:CheckState() --未竟猜且不在竞猜阶段
    self.go_table.aorbtn_guessOur:SetActiveE(unGuess and 0 or 1)
    self.go_table.aorbtn_guessEnemy:SetActiveE(unGuess and 0 or 1)
    self.go_table.aortext_noGuessTip:SetActiveE(unGuess and 1 or 0)

    local awardNum = #self.curCfg.win_reward
    local obj, tb
    for i = 1, awardNum do
        if not self.awardItems[i] then
            obj = _G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_awards)
            self.awardItems[i] = _G.GetAutoGoTable(obj)
        end
        tb = self.awardItems[i]
        tb.gameObject:SetActiveE(1)
        tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.curCfg.win_reward[i][1]))
        tb.aortext_num.text = "x" .. self.curCfg.win_reward[i][2]
    end

    for i = awardNum + 1, #self.awardItems do
        self.awardItems[i].gameObject:SetActiveE(0)
    end
    if self.curType == _G.SociatyMobaGuess.Win then --拉取完名人堂信息后更新Base
        if self.Anim ~= nil and isShowAnim then
            self.Anim:Play("SociatyMobaGuessView_show", 0, self.ShowTime)
            self.ShowTime = 4
        end
        self:ShowSociatyWin()
    elseif self.curType == _G.SociatyMobaGuess.LanerWin then
        if self.Anim ~= nil and isShowAnim then
            self.Anim:Play("SociatyMobaGuessView_Laner", 0, 0)
        end
        self:ShowLanerWin()
    elseif self.curType == _G.SociatyMobaGuess.KillMax then
        if self.Anim ~= nil and isShowAnim then
            self.Anim:Play("SociatyMobaGuessView_OverKill", 0, 0)
        end
        self:ShowKillMax()
    elseif self.curType == _G.SociatyMobaGuess.SerialMax then
        if self.Anim ~= nil and isShowAnim then
            self.Anim:Play("SociatyMobaGuessView_MaxKill", 0, 0)
        end
        self:ShowSerialMax()
    elseif self.curType == _G.SociatyMobaGuess.KillNum then
        if self.Anim ~= nil and isShowAnim then
            self.Anim:Play("SociatyMobaGuessView_OverKill", 0, 0)
        end
        self:ShowKillNum()
    elseif self.curType == _G.SociatyMobaGuess.SerialNum then
        if self.Anim ~= nil and isShowAnim then
            self.Anim:Play("SociatyMobaGuessView_MaxKill", 0, 0)
        end
        self:ShowSerialNum()
    end
    self:UpdatePopular()
    self:UpdateRedpoint()
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaGuess.id)
end

---初始化小黄点
function SociatyMobaGuessView:InitYellowPoint()
    self.yellowPts = {}
    local obj
    for i = 1, self.idNum do
        obj = _G.InstantiateObject(self.go_table.obj_ptItem, self.go_table.obj_yellowPt)
        obj:SetActiveE(1)
        self.yellowPts[i] = _G.GetAutoGoTable(obj)
    end
    self:UpdateYellowPoint()
end

---刷新小黄点
function SociatyMobaGuessView:UpdateYellowPoint()
    self.go_table.obj_yellowPt:SetActiveE(self.curType == _G.SociatyMobaGuess.Win and 0 or 1)
    for i = 1, self.idNum do
        self.yellowPts[i].aorimage_isOn:SetActiveE(i == self.curIndex and 1 or 0)
    end
end

---刷新人气
function SociatyMobaGuessView:UpdatePopular()
    if self.curType ~= _G.SociatyMobaGuess.Win then
        return
    end
    if self.guessSupportDic[self.curId] and self.guessSupportDic[self.curId][self.sociatyUid] then
        local score =
            _G.Mathf.Log(_G.Mathf.Max(self.guessSupportDic[self.curId][self.sociatyUid], 0) + 1, 1.0002) + 1000
        self.ourSociatyTb.aortext_popular.text = _G.GetLangPackValue(90031700284, _G.Mathf.Ceil(score))
    else
        self.ourSociatyTb.aortext_popular.text = _G.GetLangPackValue(90031700284, 1000)
    end
    if self.guessSupportDic[self.curId] and self.guessSupportDic[self.curId][self.enemyUid] then
        local score = _G.Mathf.Log(_G.Mathf.Max(self.guessSupportDic[self.curId][self.enemyUid], 0) + 1, 1.0002) + 1000
        self.enemySociatyTb.aortext_popular.text = _G.GetLangPackValue(90031700284, _G.Mathf.Ceil(score))
    else
        self.enemySociatyTb.aortext_popular.text = _G.GetLangPackValue(90031700284, 1000)
    end
end

function SociatyMobaGuessView:UpdateRedpoint()
    local model = SociatyMobaModel:GetInstance()
    local state = model:GetMobaBattleStage()
    if
        state == model.SociatyMobaBattleState.Embattle or state == model.SociatyMobaBattleState.Adjustline or
        state == model.SociatyMobaBattleState.Prepare
    then
        local flag = 0
        for i = 1, self.curIndex - 1 do
            if self.guessDic[self.guessIds[i]] == nil then
                flag = 1
                break
            end
        end
        self.go_table.obj_redpointLeft:SetActiveE(flag)

        flag = 0
        for i = self.curIndex + 1, self.idNum do
            if self.guessDic[self.guessIds[i]] == nil then
                flag = 1
                break
            end
        end
        self.go_table.obj_redpointRight:SetActiveE(flag)
    else
        self.go_table.obj_redpointLeft:SetActiveE(0)
        self.go_table.obj_redpointRight:SetActiveE(0)
    end
end

---@param tb _obj_typeSociaty._obj_ourSociaty_GoTable
---@param msg guild.s2c_other_guild_statue
function SociatyMobaGuessView:ShowSociatyWinBase(tb, msg, chairman)
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[msg.banner].portrait)
    tb.aortext_sociatyName.text = msg.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(msg.guild_power)
    tb.aortext_chairmanName.text = _G.GetLangPackValue(90031700282, chairman and chairman.role.name or "")
end

function SociatyMobaGuessView:ShowSociatyWin()
    if not self.guessDic[self.curId] then
        self.ourSociatyTb.aorimage_result:SetActiveE(0)
        self.enemySociatyTb.aorimage_result:SetActiveE(0)
        return
    end
    self.ourSociatyTb.aorimage_result:SetActiveE(0)
    self.enemySociatyTb.aorimage_result:SetActiveE(0)
    local isGuessOur = self.guessDic[self.curId] == self.sociatyUid
    if SociatyMobaBattleModel:GetInstance():CheckBattleEnd() > 0 then
        -- self.ourSociatyTb.aorimage_result:SetActiveE(isGuessOur and 1 or 0)
        -- self.enemySociatyTb.aorimage_result:SetActiveE(isGuessOur and 0 or 1)

        if isGuessOur then
            self.ourSociatyTb.aorimage_result.SpriteName =
                SociatyMobaBattleModel:GetInstance():GetIsWin() and ResultSprite[1] or ResultSprite[2]
            self.go_table.obj_selectEff:SetActiveE(SociatyMobaBattleModel:GetInstance():GetIsWin() and
                1 or 0)
            self.go_table.obj_selectEff2:SetActiveE(SociatyMobaBattleModel:GetInstance():GetIsWin() and
                0 or 1)
        else
            self.ourSociatyTb.aorimage_result.SpriteName =
                (not SociatyMobaBattleModel:GetInstance():GetIsWin() or SociatyMobaBattleModel:GetInstance():GetIsWin()) and
                ResultSprite[1] or
                ResultSprite[2]
            self.go_table.obj_selectEff:SetActiveE((not SociatyMobaBattleModel:GetInstance():GetIsWin() or SociatyMobaBattleModel:GetInstance():GetIsWin()) and
                1 or 0)
            self.go_table.obj_selectEff2:SetActiveE((not SociatyMobaBattleModel:GetInstance():GetIsWin() or SociatyMobaBattleModel:GetInstance():GetIsWin()) and
                0 or 1)
        end
    else
        self.ourSociatyTb.aorimage_result:SetActiveE(0)
        self.enemySociatyTb.aorimage_result:SetActiveE(0)
    end
end

function SociatyMobaGuessView:ShowLanerWin()
    local tb = self.typeTable[2]
    local lanerId = self.curCfg.conditon[2]
    local cfg ---线路id对应的野怪图456
    if lanerId == 1 then
        cfg = _G.ConfigManager.guild_moba_campsite_cfg[5]
    elseif lanerId == 2 then
        cfg = _G.ConfigManager.guild_moba_campsite_cfg[6]
    else
        cfg = _G.ConfigManager.guild_moba_campsite_cfg[4]
    end
    tb.aorrawimage_icon:LoadImage(
        cfg.icon[1][1],
        function()
            if self:IsNil() then
                return
            end
            tb.aorrawimage_icon:SetNativeSize()
        end
    )
    tb.aortext_name.text = LanerName[lanerId]
    if not self.guessDic[self.curId] or SociatyMobaBattleModel:GetInstance():CheckBattleEnd() == 0 then
        tb.aorimage_result:SetActiveE(0)
    else
        tb.aorimage_result:SetActiveE(1)
        local isGuessOur = self.guessDic[self.curId] == self.sociatyUid
        local ourWin, enemyWin = SociatyMobaBattleModel:GetInstance():CheckLanerVictory(lanerId)
        self.go_table.obj_selectEff:SetActiveE(((isGuessOur and ourWin) or (not isGuessOur and enemyWin)) and 1 or 0)
        self.go_table.obj_selectEff2:SetActiveE(((isGuessOur and ourWin) or (not isGuessOur and enemyWin)) and 0 or 1)
        tb.aorimage_result.SpriteName =
            ((isGuessOur and ourWin) or (not isGuessOur and enemyWin)) and ResultSprite[1] or ResultSprite[2]
    end
end

function SociatyMobaGuessView:ShowKillMax()
    local tb = self.typeTable[3]
    tb.aorimage_killText.SpriteName = "zqtc_jctc_jszd"
    if not self.guessDic[self.curId] or SociatyMobaBattleModel:GetInstance():CheckBattleEnd() == 0 then
        tb.aorimage_result:SetActiveE(0)
    else
        tb.aorimage_result:SetActiveE(1)
        local isGuessOur = self.guessDic[self.curId] == self.sociatyUid
        local ourNum, enemyNum = SociatyMobaBattleModel:GetInstance():GetKillMaxNum()
        tb.aorimage_result.SpriteName =
            ((isGuessOur and ourNum >= enemyNum) or (not isGuessOur and ourNum <= enemyNum)) and ResultSprite[1] or
            ResultSprite[2]
