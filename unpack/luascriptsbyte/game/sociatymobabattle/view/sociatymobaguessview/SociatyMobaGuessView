---界面的入口函数
---@param ActivityID number 活动id
function SociatyMobaGuessView:OnCreate()
    self.Anim = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.guessIds = SociatyMobaModel:GetInstance():GetGuessIds()
    if _G.table.isEmptyOrNil(self.guessIds) then
        if _G.AppSetting.DEBUG then
            _G.LogError("当前竞猜项列表为空！界面关闭！")
        end
        self:Close()
        return
    end
    local seasonIdOld = _G.PlayerPrefsManager.GetInt("SociatyMobaBattleSeasonId")
    local today = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())

    --- 第一个展示动画播放的时间节点
    self.ShowTime = 4

    if self.state == SociatyMobaModel:GetInstance().SociatyMobaBattleState.Settlement then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SociatyMobaGuess, today) --改为登录查看
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaGuess.id)
    end
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SociatyMobaGuessFace, today)
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SociatyMobaGuessAni, 0) ~= today then
        self.ShowTime = 0
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SociatyMobaGuessAni, today)
    end

    self.idNum = #self.guessIds
    self.curIndex = 1
    self:InitEffct()
    self:UpdateCfg()
    self.guessSupportDic = {}
    self.awardItems = {}
    self.sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.sociatyUid = self.sociatySelf.Uid
    self:InitGoTable()
    self:InitYellowPoint()
    self:InitView()
    self.state, _ = SociatyMobaModel:GetInstance():GetMobaBattleStage()
end

