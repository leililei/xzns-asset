---@param msg guild_moba.s2c_guess_support_info
function SociatyMobaGuessView:GetGuessSupportInfoHandler(msg)
    if msg.ack ~= 1 then
        return
    end
    if msg.guess_support_info then
        for _, v in pairs(msg.guess_support_info) do
            self.guessSupportDic[v.guess_id] = {}
            if v.guess_num then
                for _, data in pairs(v.guess_num) do
                    self.guessSupportDic[v.guess_id][data.key] = data.value
                end
            end
        end
    end
    self:UpdatePopular()
end

function SociatyMobaGuessView:CheckState()
    local state, _ = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    self.state = state
    if state == StateEnum.Embattle or state == StateEnum.Adjustline or state == StateEnum.Prepare then
        return true
    end
    return false
end

function SociatyMobaGuessView:Guess(uid)
    local sid = self.curId
    local srcGuessUid = self.guessDic[sid]
    self.go_table.obj_selectEff:SetActiveE(0)
    self.go_table.obj_selectEff2:SetActiveE(0)
    SociatyMobaModel:GetInstance():Guess(
        self.guessInfo.guild_uid1,
        self.guessInfo.guild_uid2,
        sid,
        uid,
        function()
            if not self.guessSupportDic[sid] then
                self.guessSupportDic[sid] = {}
            end
            if not self.guessSupportDic[sid][uid] then
                self.guessSupportDic[sid][uid] = 0
            end
            if srcGuessUid == nil then
                self.guessSupportDic[sid][uid] = self.guessSupportDic[sid][uid] + 1
            elseif srcGuessUid ~= uid then
                if self.guessSupportDic[sid][srcGuessUid] then
                    self.guessSupportDic[sid][srcGuessUid] = self.guessSupportDic[sid][srcGuessUid] - 1
                end
                self.guessSupportDic[sid][uid] = self.guessSupportDic[sid][uid] + 1
            end
            self:UpdateShow()
        end
    )
end

function SociatyMobaGuessView:OnClickLaner(go, isOn)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaOverviewView.Name)
end

---按钮点击事件在这里派发
function SociatyMobaGuessView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_left then
        if self.curIndex <= 1 then
            return
        end
        self.curIndex = self.curIndex - 1
        self:UpdateCfg()
        self:UpdateYellowPoint()
        self:UpdateShow(true)
    elseif go == self.go_table.aorbtn_right then
        if self.curIndex >= self.idNum then
            return
        end
        self.curIndex = self.curIndex + 1
        self:UpdateCfg()
        self:UpdateYellowPoint()
        self:UpdateShow(true)
    elseif go == self.go_table.aorbtn_guessOur then
        if not self:CheckState() then
            return
        end
        self:Guess(self.sociatyUid)
    elseif go == self.go_table.aorbtn_guessEnemy then
        if not self:CheckState() then
            return
        end
        self:Guess(self.enemyUid)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 167)
    end
end

