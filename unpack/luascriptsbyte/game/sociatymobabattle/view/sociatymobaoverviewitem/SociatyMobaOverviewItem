local SociatyMobaBattleModel = require "SociatyMobaBattleModel"
local SociatyMobaModel = require "SociatyMobaModel"
local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH

---@class SociatyMobaOverviewItem : Component	中文描述
---@field go_table SociatyMobaOverviewView._obj_item1_GoTable
local SociatyMobaOverviewItem = _G.BaseClass("SociatyMobaOverviewItem", _G.Component)

--region 阵容展示组(可拖拽)
local SociatyMobaOverDragItem = _G.BaseClass("SociatyMobaOverDragItem")
---类的构造函数
function SociatyMobaOverDragItem:__init(obj, dragBegin, dragEnd, drag, index, data, setChange, longPress)
    self.objIndex = index
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.onDragBegin = dragBegin
    self.onDragEnd = dragEnd
    self.onDrag = drag
    self.setChange = setChange
    self.longPressCall = longPress
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onLongPress", _G.handlerbind(self, self.OnLongPress))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDown", _G.handler(self, self.OnDownEvent))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onUp", _G.handler(self, self.OnUpEvent))
    self:Show(data)
end

function SociatyMobaOverDragItem:OnLongPress()
    if self.onPress then
        self.onPress = false
        self.longPress = true
        if self.longPressCall then
            self.longPressCall(self.objIndex)
        end
    end
end

function SociatyMobaOverDragItem:OnDownEvent()
    if self.setChange then
        self.setChange(false)
    end
    if self.onPress then
        return
    end
    self.longPress = false
    self.onPress = true
end

function SociatyMobaOverDragItem:OnUpEvent()
    self.go_table.obj_choose:SetActiveE(0)
end

function SociatyMobaOverDragItem:OnDragBegin(s, event)
    if self.onDragBegin then
        self.onDragBegin(self.objIndex, self.longPress, event)
    end
end

function SociatyMobaOverDragItem:OnDrag(go, ed)
    if self.onDrag then
        self.onDrag(self.objIndex, go, ed, self.longPress)
    end
end
function SociatyMobaOverDragItem:OnDragEnd(s, event)
    if self.onDragEnd then
        self.onDragEnd(self.objIndex, self.longPress, event)
        self.longPress = false
    end
end

---类的析构函数
function SociatyMobaOverDragItem:Dispose()
    self.gameObject = nil
    self.onDragBegin = nil
    self.onDragEnd = nil
    self.objIndex = nil
end
function SociatyMobaOverDragItem:Show(data)
    local ctrl = self.go_table
    _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data, 1, true, true, false)
    ctrl.aortext_name.text = data.name
    --卡牌
    if ctrl.card then
        for i = 1, #ctrl.card do
            _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, false)
        end
    end
    if data.cards then
        if ctrl.card == nil then
            ctrl.card = {}
        end
        for i = 1, #data.cards do
            local dataItem = data.cards[i]
            if dataItem then
                if ctrl.card[i] then
                    ctrl.card[i]:Show(dataItem.card_sid, nil, dataItem.star, dataItem.soul_lv, 300)
                    _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, true)
                else
                    local ItemCardFactory = _G.ItemCardFactory
                    ItemCardFactory:GetInstance():GetItemCard(
                        ItemCardFactory.itemCardType.CardAllItem,
                        ctrl.obj_teamRoot,
                        function(item)
                            ctrl.card[i] = item
                            ctrl.card[i]:Show(dataItem.card_sid, nil, dataItem.star, dataItem.soul_lv, 300)
                        end
                    )
                end
            else
                if ctrl.card[i] then
                    _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, false)
                end
            end
        end
    end
    --技能
    local combineCfgs = _G.ConfigManager.combine_cfg
    local cfgs = _G.ConfigManager.card_skills_cfg
    local bsCfgs = _G.ConfigManager.battle_skill_cfg
    local lanCfgs = _G.ConfigManager.language_package_cfg
    local cfg
    for i = 1, 3 do
        if data.combine and data.combine[i] and data.combine[i] > 0 then
            cfg = cfgs[combineCfgs[data.combine[i]].skills[1]]
            ctrl["aorrawimage_icon" .. i]:LoadImage(cfg.icon)
            cfg = bsCfgs[cfg.skills[1]]
            ctrl["aortext_type" .. i].text = lanCfgs[cfg.Brief]
            ctrl["obj_skill" .. i]:SetActiveE(1)
        else
            ctrl["obj_skill" .. i]:SetActiveE(0)
        end
    end
    --战力
    ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
end
function SociatyMobaOverDragItem:GetDataIndex()
    return self.dataIndex
end
--endregion

function SociatyMobaOverviewItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.SociatyItemList = {}
end

---创建对象时,入口构造函数
function SociatyMobaOverviewItem:OnCreate(index, go, dragEnd)
    self.index = index
    self.trans_drag = go
    self.ondragEnd = dragEnd
    self.go_table.scrollloopvectical_teamList:InitItemData(0, _G.handler(self, self.OnRefreshLoopListItem))
    self.go_table.scrollloopvectical_teamList:DetectingSlippage(_G.handler(self, self.onValueChanged))
    self.scorll = self.go_table.scrollloopvectical_teamList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    self.showSort = false
    self.sortData = {
        _G.GetLangPackValue(90031700203),
        _G.GetLangPackValue(90031700205),
        _G.GetLangPackValue(90031700204)
    }
end

function SociatyMobaOverviewItem:SetChangeValua(value)
    self.isChange = value
end

function SociatyMobaOverviewItem:onValueChanged()
    self:SetChangedValue(true)
end

function SociatyMobaOverviewItem:SetChangedValue(isChange)
    self.scrolllPosChange = isChange
end

function SociatyMobaOverviewItem:Show(data)
    if data then
        self.data = _G.table.toArray(data)
        _G.table.sort(
            self.data,
            function(a, b)
                return a.power > b.power
            end
        )
    else
        self.data = {}
    end
    self.dataNum = #self.data
    self:SetView()
end

function SociatyMobaOverviewItem:SetBtnChangeLeft(isShow)
    self.go_table.aorbtn_changeLeft:SetActiveE(isShow and 1 or 0)
end

function SociatyMobaOverviewItem:SetBtnChangeRight(isShow)
    self.go_table.aorbtn_changeRight:SetActiveE(isShow and 1 or 0)
end

function SociatyMobaOverviewItem:SetView()
    self.go_table.scrollloopvectical_teamList:UpdateCount(self.dataNum)
    self.go_table.aortext_teamNum.text = self.dataNum
    self.go_table.aortext_nil:SetActiveE(self.dataNum == 0 and 1 or 0)
    self.go_table.obj_select:SetActiveE(self.dataNum > 0 and 1 or 0)
    self.go_table.aortext_curSort.text =
        self.sortData[SociatyMobaBattleModel:GetInstance():GetLanerMarchSort(self.index)]
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function SociatyMobaOverviewItem:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        local dragBegin = _G.handler(self, self.OnDragBegin)
        local drag = _G.handler(self, self.OnDrag)
        local dragEnd = _G.handler(self, self.OnDragEnd)
        local setChange = _G.handler(self, self.SetChangedValue)
        local longPress = _G.handler(self, self.OnLongPress)
        ctrl = SociatyMobaOverDragItem.New(item, dragBegin, dragEnd, drag, id, self.data[eIndex], setChange, longPress)
        --_G.GetAutoGoTable(item)
        -- LogError(ctrl.obj_have)
        -- _G.SetEventTrigger(ctrl.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin, eIndex, ctrl.obj_have))
        -- _G.SetEventTrigger(ctrl.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag, ctrl))
        -- _G.SetEventTrigger(ctrl.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd, eIndex))
        self.SociatyItemList[id] = ctrl
    else
        ctrl:Show(self.data[eIndex])
    end
    ctrl.index = eIndex
    local data = self.data[eIndex]
    ctrl.uid = data.uid
end

function SociatyMobaOverviewItem:OnDrag(indexObj, go, ed, isLong)
    if isLong and self.isDrag and self.isChange and (not self.scrolllPosChange) then
        self.SociatyItemList[indexObj].go_table.obj_have:AddLocalPosition(
            ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
            ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
            0
        )
    else
        self.scorll:OnDrag(ed)
    end
end

function SociatyMobaOverviewItem:OnLongPress(indexObj)
    if self.isChange and (not self.scrolllPosChange) then
        self.SociatyItemList[indexObj].go_table.obj_choose:SetActiveE(1)
    end
end

function SociatyMobaOverviewItem:OnDragBegin(indexObj, isLong, event)
    if isLong and self.isChange and (not self.scrolllPosChange) then
        self.SociatyItemList[indexObj].go_table.obj_have:SetParentE(self.trans_drag, 1)
        self.isDrag = true
    else
        self.scorll:OnBeginDrag(event)
    end
end

function SociatyMobaOverviewItem:OnDragEnd(indexObj, isLong, event)
    if isLong then
        if self.ondragEnd and self.isChange then
            self.ondragEnd(
                self.index,
                self.SociatyItemList[indexObj].go_table.obj_have,
                self.SociatyItemList[indexObj].uid
            )
        end
        self.SociatyItemList[indexObj].go_table.obj_have:SetParentE(self.SociatyItemList[indexObj].go_table.obj_item, 1)
        self.SociatyItemList[indexObj].go_table.obj_have:SetLocalPosition(0, 0, 0)
        self.isDrag = false
    end
    self.scorll:OnEndDrag(event)
end

function SociatyMobaOverviewItem:ExtendSortList()
    self.go_table.obj_sort:SetLocalPosition(0, self.showSort and 80 or -62, 0)
    self.go_table.aorimage_arrow:SetLocalScale(1, self.showSort and 1 or -1, 0)
    self.go_table.obj_isSorting:SetActiveE(self.showSort and 1 or 0)
    if self.showSort and not self.sortInit then
        self.go_table.scrollloopvectical_powerSort:InitItemData(
            #self.sortData,
            _G.handlerbind(self, self.RefreshSortItem)
        )
    end
end

function SociatyMobaOverviewItem:RefreshSortItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSortItem, index))
    tb.aortext_sortType.text = self.sortData[index]
    tb.obj_isCurSort:SetActiveE(SociatyMobaBattleModel:GetInstance():GetLanerMarchSort(self.index) == index and 1 or 0)
end

function SociatyMobaOverviewItem:OnClickSortItem(go, isOn, index)
    self.showSort = not self.showSort
    self:ExtendSortList()
    if index == SociatyMobaBattleModel:GetInstance():GetLanerMarchSort(self.index) then
        return
    end
    if not SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman() then
        _G.PopWindowManager:GetInstance():ShowAllTips(950120)
        return
    end
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    local SE = SociatyMobaModel:GetInstance().SociatyMobaBattleState
    if
        not (state == SE.Match or state == SE.Embattle or state == SE.Adjustline or state == SE.Settlement or
            state == SE.EmbattleAllDay or
            state == SE.SeasonSettlement)
     then
        _G.PopWindowManager:GetInstance():ShowAllTips(950111)
        return
    end
    SociatyMobaBattleModel:GetInstance():SetMarchOrder(
        self.index,
        index,
        function()
            self.go_table.aortext_curSort.text = self.sortData[index]
            self.go_table.scrollloopvectical_powerSort:UpdateAllItem()
        end
    )
end

---按钮点击事件在这里派发
function SociatyMobaOverviewItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_changeLeft then
        SociatyMobaBattleModel:GetInstance():ChangeAllLineInfo(self.index, self.index - 1)
    elseif go == self.go_table.aorbtn_changeRight then
        SociatyMobaBattleModel:GetInstance():ChangeAllLineInfo(self.index, self.index + 1)
    elseif go == self.go_table.aorbtn_arrow then
        if not SociatyMobaModel:GetInstance():CheckSelfIsCommanderOrChairman() then
            _G.PopWindowManager:GetInstance():ShowAllTips(950120)
            return
        end
        self.showSort = not self.showSort
        self:ExtendSortList()
    end
end

---销毁对象时,析构函数
function SociatyMobaOverviewItem:OnDestroy()
end

return SociatyMobaOverviewItem
