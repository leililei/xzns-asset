---@class SociatyMobaReportDetailView : UIBaseView	冥界纷争定段界面
---@field public go_table SociatyMobaReportDetailView_GoTable GoTable
local SociatyMobaReportDetailView = _G.BaseClass("SociatyMobaReportDetailView", _G.UIBaseView)

function SociatyMobaReportDetailView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data guild_moba.i_line_role
function SociatyMobaReportDetailView:OnCreate(data, lanerId)
    self.go_table.aortext_record.text = _G.GetLangPackValue(90031700035, data.win_count)
    self.uid = data.uid
    self.roleData = data
    local cards = data.cards
    ---@type guild_moba.i_team_card
    local card
    for i = 1, #cards do
        card = cards[i]
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table["obj_card" .. i],
            function(item)
                item:Show(
                    card.card_sid,
                    nil,
                    card.star,
                    card.soul_lv,
                    card.card_lv,
                    nil,
                    card.skin_id,
                    card.soul_state,
                    card.big_born_num
                )
            end
        )
    end
    local pbData = {uid = data.uid, type = data.type, station_sid = lanerId}
    require("SociatyMobaNet"):GetInstance():GetLineRoleFightInfo(pbData, _G.handler(self, self.InitView))
    self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

---@param msg guild_moba.s2c_line_role_fight
function SociatyMobaReportDetailView:InitView(msg)
    self.data = msg.r_info or {}
    self.go_table.scrollloopvectical_playerList:InitItemData(#self.data, _G.handler(self, self.RefreshList))
end

function SociatyMobaReportDetailView:RefreshList(index, obj)
    index = index + 1
    local data = self.data[index]
    ---@type SociatyMobaReportDetailView._obj_playerItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index, data.report_uid))
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role, nil, true, nil)
    tb.aortext_name.text = data.role.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.role.power)
    tb.aortext_lose:SetActiveE(data.win and 0 or 1)
    tb.aortext_win:SetActiveE(data.win and 1 or 0)
end

function SociatyMobaReportDetailView:OnClickItem(go, isOn, index, uid)
    local pbData = {uid = uid}
    require("SociatyMobaNet"):GetInstance():GetLineRoleFightDetail(
        pbData,
        _G.handlerbind(self, self.OnReplayReportCall, index)
    )
end

local SetOtherPlayer = function(data)
    local otherPlayer = {}
    otherPlayer.frame = data.frame
    otherPlayer.name = data.role_name
    otherPlayer.lv = data.role_lv
    otherPlayer.style = data.target_style
    otherPlayer.title = data.title
    return otherPlayer
end

function SociatyMobaReportDetailView:OnReplayReportCall(msg, index)
    if msg.ack == 1 then
        self.fight_arg = msg.fight_arg
        self:UpdateData(index, _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg))
    end
end

---@param data table 伤害数据
function SociatyMobaReportDetailView:UpdateData(index, data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCount = _G.table.count(data.FighterInfo)
    self.PveData = self:InitData(data)
    ---@type guild_moba.i_line_role_fight
    local roleData = self.data[index]
    local otherPlayer = SetOtherPlayer(roleData.role)
    local leftName = roleData.role.name
    local rightName = self.roleData.name
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        {roleData.win and 0 or 1},
        nil,
        nil,
        otherPlayer,
        1,
        true,
        self.fight_arg,
        nil,
        self.playback_uid,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        {leftName, rightName}
    )
end

function SociatyMobaReportDetailView:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

function SociatyMobaReportDetailView:OnRecordStart()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMobaReportView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMobaTipsView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
end

function SociatyMobaReportDetailView:OnRecordEnd()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMobaTipsView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMobaReportView.Name)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
end

---界面的销毁函数
function SociatyMobaReportDetailView:OnDestroy()
    self:RemoveListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:RemoveListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

---按钮点击事件在这里派发
function SociatyMobaReportDetailView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyMobaReportDetailView
