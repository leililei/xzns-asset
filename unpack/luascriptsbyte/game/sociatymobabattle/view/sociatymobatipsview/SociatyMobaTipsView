local SociatyMobaTipsModel = require("SociatyMobaTipsModel")

---@class SociatyMobaTipsView : UIBaseView    中文描述
---@field public go_table SociatyMobaTipsView_GoTable GoTable
---@field public slot SociatyMobaTipsView._obj_TipItem_GoTable[] GoTable
local SociatyMobaTipsView = _G.BaseClass("SociatyMobaTipsView", _G.UIBaseView)

function SociatyMobaTipsView:Awake()
    SociatyMobaTipsModel:GetInstance():SetView(self)
end

local MaxTipNum = _G.ConfigManager.discrete_cfg[101687][1][1]
local Delta = 44

---界面的入口函数
function SociatyMobaTipsView:OnCreate(content, pos)
    self.queue = {}
    self.highSort = {}
    self.highDic = {}
    self.slot = {}
    self.slotState = {}
    self.lowerY = 72 - Delta * MaxTipNum
    self:InitView()
    self.timer = _G.TimerManager:GetInstance():GetTimer(0.8, self.TryToShow, self, false, false, true)
    self.timer:Start()
    self:Add(content)
    self:TryToShow()
    if pos ~= nil then
        self.go_table.obj_tips:SetLocalPosition(pos[1], pos[2], pos[3])
    end
end

function SociatyMobaTipsView:InitView()
    for i = 1, MaxTipNum do
        if self.slot[i] == nil then
            local obj = _G.InstantiateObject(self.go_table.obj_TipItem, self.go_table.obj_tips)
            obj:SetActiveE(1)
            local y = 72 - Delta * i
            self.highDic[y] = i
            obj:SetLocalPosition(0, y, 0)
            self.slot[i] = _G.GetAutoGoTable(obj)
            self.slot[i].canvas = self.slot[i].obj_content:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
            self.slot[i].canvas.alpha = 0
            self.slot[i].y = y
            self.highSort[i] = i
        end
    end
end

--region 对外接口
function SociatyMobaTipsView:Add(content)
    _G.table.insert(self.queue, content)
    self.timer:Resume()
end

function SociatyMobaTipsView:TryToShow()
    if #self.queue == 0 then
        self.timer:Pause()
        return
    end
    local num = 1
    for i = 1, MaxTipNum do
        if not self.slotState[self.highSort[i]] then
            local content = _G.table.remove(self.queue, 1)
            self:Show(self.highSort[i], content)
            num = num - 1
        end
        if num == 0 or #self.queue == 0 then
            return
        end
    end
end

function SociatyMobaTipsView:Show(index, content)
    self.slotState[index] = true
    self.slot[index].canvas.alpha = 1
    -- self.slot[index].gameObject:SetActiveE(1)
    self.slot[index].obj_content:SetActiveE(1)
    self.slot[index].aortext_content.text = content[1]
    local fadeTime = content[2] - 0.2
    self:PlayToBig(index, fadeTime)
end

function SociatyMobaTipsView:PlayToBig(index, fadeTime)
    self.slot[index].obj_content:DOScale(1.2, 1.2, 0, 0.1):OnComplete(
        _G.handlerbind(self, self.PlayToNormal, index, fadeTime)
    )
end

function SociatyMobaTipsView:PlayToNormal(index, fadeTime)
    self.slot[index].obj_content:DOScale(1, 1, 0, 0.1):OnComplete(
        _G.handlerbind(self, self.PlayToFade, index, fadeTime)
    )
end

function SociatyMobaTipsView:PlayToFade(index, fadeTime)
    self.slot[index].canvas:DOFade(0, fadeTime):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
        _G.handlerbind(self, self.ShowEnd, index)
    )
end

function SociatyMobaTipsView:UpEnd(index)
    self.slot[index].upDt = nil
end

function SociatyMobaTipsView:ShowEnd(index)
    self.slotState[index] = false
    self.slot[index].obj_content:SetActiveE(0)
    self.slot[index].gameObject:SetLocalPosition(0, self.lowerY, 0)
    for i = 1, MaxTipNum do
        if self.slot[i].y < self.slot[index].y then
            self.slot[i].y = self.slot[i].y + Delta
            self.highSort[self.highDic[self.slot[i].y]] = i
            if self.slot[i].upDt then
                self.slot[i].upDt:Kill()
            end
            self.slot[i].upDt = self.slot[i].gameObject:DOLocalMoveY(self.slot[i].y, 0.5):OnComplete(_G.handlerbind(self, self.UpEnd, i))
        end
    end
    self.slot[index].y = self.lowerY
    -- self.slot[index].gameObject:SetActiveE(0)
    -- self:TryToShow()
end

function SociatyMobaTipsView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    SociatyMobaTipsModel:GetInstance():SetView(nil)
end

--endregion
return SociatyMobaTipsView
