local SociatyMobaModel = require("SociatyMobaModel")
---@class SociatyMobaBattleTeamView : UIBaseView	布阵
---@field public go_table SociatyMobaBattleTeamView_GoTable GoTable
local SociatyMobaBattleTeamView = _G.BaseClass("SociatyMobaBattleTeamView", _G.UIBaseView)

---1上路 2中路 3下路 4野区 Embattle布阵按钮
local BranchLine = {
    TopLaner = 1,
    MidLaner = 2,
    BotLaner = 3,
    Jungle = 4,
    Embattle = 5
}
---分线文本
local BranchLineStr = {
    [BranchLine.TopLaner] = _G.GetLangPackValue(90031700057),
    [BranchLine.MidLaner] = _G.GetLangPackValue(90031700058),
    [BranchLine.BotLaner] = _G.GetLangPackValue(90031700059),
    [BranchLine.Jungle] = _G.GetLangPackValue(90031700060),
    [BranchLine.Embattle] = _G.GetLangPackValue(90031700061)
}

local BranchStr = {
    [BranchLine.TopLaner] = _G.GetLangPackValue(90031700028),
    [BranchLine.MidLaner] = _G.GetLangPackValue(90031700029),
    [BranchLine.BotLaner] = _G.GetLangPackValue(90031700030),
    [BranchLine.Jungle] = _G.GetLangPackValue(90031700031)
}

local PetOrderFrame = require("PetModel").PetOrderFrame
function SociatyMobaBattleTeamView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMobaBattleTeamView:OnCreate(line)
    self.curBranch = BranchLine.TopLaner
    ---所有分线的数据
    self.allLineInfo = {}
    self.lineInfo = {}
    local defaultIndex = line or BranchLine.TopLaner
    self.go_table.toggle_topLaner.isOn = defaultIndex == BranchLine.TopLaner
    self.go_table.toggle_midLaner.isOn = defaultIndex == BranchLine.MidLaner
    self.go_table.toggle_botLaner.isOn = defaultIndex == BranchLine.BotLaner
    self.go_table.toggle_jungle.isOn = defaultIndex == BranchLine.Jungle
    self.BattleTeam_Mine = _G.GetAutoGoTable(self.go_table.obj_myTeam, _G.handler(self, self.OnClickBtn))
    self.branchBtn = {
        self.BattleTeam_Mine.aorbtn_goto1,
        self.BattleTeam_Mine.aorbtn_goto2,
        self.BattleTeam_Mine.aorbtn_goto3,
        self.BattleTeam_Mine.aorbtn_goto4
    }
    self.toggles = {
        _G.GetAutoGoTable(self.go_table.toggle_topLaner),
        _G.GetAutoGoTable(self.go_table.toggle_midLaner),
        _G.GetAutoGoTable(self.go_table.toggle_botLaner),
        _G.GetAutoGoTable(self.go_table.toggle_jungle)
    }
    self:RefreshBranchBtn()
    self:RefreshLineInfo()
    self:AddListener(_G.eSociatyMobaBattle.SociatyMobaGarray, self.UpdateFakeRedPoint)
    self:UpdateFakeRedPoint()
end

---刷新分线数据
function SociatyMobaBattleTeamView:RefreshLineInfo()
    ---拉取当前分线的数据
    self.allLineInfo = {}
    SociatyMobaModel:GetInstance():GetLineInfo(0, _G.handler(self, self.RefreshView))
end

---刷新队伍数量
function SociatyMobaBattleTeamView:RefreshTeamNum()
    self.go_table.aortext_mineTitle.text = _G.GetLangPackValue(90031700044, self.mineTeamData and 1 or 0)
    self.go_table.aortext_sociatyTitle.text = _G.GetLangPackValue(90031700062, #self.lineInfo)
end

---刷新界面
function SociatyMobaBattleTeamView:RefreshView(msg)
    if self:IsNil() then
        return
    end
    if msg then
        for _, v in pairs(msg) do
            self.allLineInfo[v.line_id] = v.role
        end
        for _, v in pairs(self.allLineInfo) do
            if not _G.table.isEmptyOrNil(v) then
                _G.table.sort(v,function(a, b)
                    return a.power > b.power
                end)
            end
        end
    end
    self:RefreshTeam()
end

function SociatyMobaBattleTeamView:RefreshList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local data = self.lineInfo[index + 1]
    ---头像，头像框
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, false)
    ---名字
    tb.aortext_name.text = data.name
    ---战力
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    ---设置卡牌
    self:SetCardItem(tb, data.cards or {}, false)
    ---设置合击技
    if _G.AppSetting.IsXzns then
        self:SetBeastItem(tb, data.beast or {{sid = 0}, {sid =0}, {sid= 0}})
    else
        self:SetCombineItem(tb, data.combine or {0, 0, 0})
    end
end

---设置卡牌
---@param cards table 卡牌数据
---@param isCardData boolean 是否是卡牌数据
function SociatyMobaBattleTeamView:SetCardItem(tb, cards, isCardData)
    if tb.itemList then
        for _, v in ipairs(tb.itemList) do
            _G.ItemFactory:GetInstance():SetItemCard(v)
        end
    end
    tb.itemList = {}
    for _, v in ipairs(cards) do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            tb.obj_team,
            function(itemLua)
                if _G.IsNil(tb.obj_team) then
                    _G.ItemFactory:GetInstance():SetItemCard(itemLua)
                    return
                end
                _G.table.insert(tb.itemList, itemLua)
                ---@type ItemCardStorageView
                if isCardData then
                    itemLua:ShowCardData(v)
                else
                    itemLua:Show(v.card_sid, nil, v.star, v.soul_lv, v.card_lv, v.uid, nil, v.soul_state)
                end
                itemLua:ShowLevel(300)
            end
        )
    end
end

---设置宠物技
function SociatyMobaBattleTeamView:SetCombineItem(tb, combine)
    local combineItem, petCfg, skillId, cfgt, cfg
    for i = 1, 3 do
        combineItem = _G.GetAutoGoTable(tb["obj_petSkills" .. i])
        if combine[i] and combine[i] > 0 then
            combineItem.gameObject:SetActiveE(1)
            petCfg = _G.ConfigManager.pet_cfg[combine[i]]
            skillId = petCfg.skill_id[1]
            cfgt = _G.ConfigManager.card_skills_cfg[skillId]
            cfg = cfgt and _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]
            combineItem.aorrawimage_icon:LoadImage(cfg and cfg.Icon or "")
            -- combineItem.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            -- combineItem.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
            -- combineItem.aorimage_bg.SpriteName = PetOrderFrame[petCfg.Order]
        else
            combineItem.gameObject:SetActiveE(0)
        end
    end
end

function SociatyMobaBattleTeamView:SetBeastItem(tb, beast)
    local item, beastCfg, skillId, cfgt
    for i = 1, 3 do
        item = _G.GetAutoGoTable(tb["obj_petSkills" .. i])
        if beast[i] and beast[i].sid > 0 then
            item.gameObject:SetActiveE(1)
            beastCfg = _G.ConfigManager.pet_xzns_cfg[beast[i].sid]
            skillId = beastCfg.skill_id[1][1]
            cfgt = _G.ConfigManager.card_skills_cfg[skillId]
            item.aorrawimage_icon:LoadImage(beastCfg and beastCfg.icon_1 or "")
        else
            item.gameObject:SetActiveE(0)
        end
    end
end

---刷新当前分线的队伍
function SociatyMobaBattleTeamView:RefreshTeam()
    self.lineInfo = self.allLineInfo[self.curBranch] or {}
    if _G.table.isEmptyOrNil(self.lineInfo) and self.curBranch ~= 4 then
        self.go_table.aorrawimage_empty:SetActiveE(1)
    else
        self.go_table.aorrawimage_empty:SetActiveE(0)
    end
    ---获取自己的队伍
    self.mineTeamData = nil
    for _, v in ipairs(self.lineInfo) do
        if v.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            self.mineTeamData = v
            break
        end
    end
    ---刷新队伍数量
    self:RefreshTeamNum()

    self.go_table.obj_myTeam:SetActiveE(self.mineTeamData and 1 or 0)
    self.go_table.aorbtn_emptyTeam:SetActiveE(self.mineTeamData and 0 or 1)
    if self.mineTeamData then
        local power = 0
        if not _G.table.isEmptyOrNil(self.mineTeamData.cards) then
            for _, data in ipairs(self.mineTeamData.cards) do
                power = power + data.power
            end
        end
        self:RefreshMineTeam(power)
    end
    if self.curBranch == BranchLine.Jungle then
        self.go_table.aortext_sociatyTitle.text = _G.GetLangPackValue(90031700218)
        self.go_table.obj_BuffSet:SetActiveE(1)
        self.go_table.scrollloopvectical_team:SetActiveE(0)
        if not self.buffSet then
            self.buffSet = self:AddComponent(
                    self.go_table.obj_BuffSet,
                    require("SociatyMobaBuffSetView").New(self.go_table.obj_BuffSet)
            )
        end
    else
        self.go_table.obj_BuffSet:SetActiveE(0)
        self.go_table.scrollloopvectical_team:SetActiveE(1)
    end
    if not self.teamListView then
        self.go_table.scrollloopvectical_team:InitItemData(#self.lineInfo, _G.handler(self, self.RefreshList))
        self.teamListView = self.go_table.scrollloopvectical_team
    else
        self.teamListView:UpdateCount(#self.lineInfo)
    end
end

---刷新自己的队伍
function SociatyMobaBattleTeamView:RefreshMineTeam(power)
    local tb = self.BattleTeam_Mine
    local playerData = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = playerData.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, false)
    ---设置卡牌
    self:SetCardItem(tb, self.mineTeamData.cards)
    ---设置合击技
    if _G.AppSetting.IsXzns then
        self:SetBeastItem(tb, self.mineTeamData.beast)
    else
        self:SetCombineItem(tb, self.mineTeamData.combine)
    end
    tb.aorbtn_adjust:SetActiveE(SociatyMobaModel:GetInstance():IsEmbattleState() and 1 or 0)
end

---刷新分线按钮 ZHJH-9409按钮结构调整，方法重写
function SociatyMobaBattleTeamView:RefreshBranchBtn()
    for i = 1, 4 do
        self.branchBtn[i]:SetActiveE(self.curBranch == i and 0 or 1)
    end
end

function SociatyMobaBattleTeamView:RefreshBranchItem(index, obj)
    local eIndex = self.branchData[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClcikBranchItem, eIndex))
    tb.aortext_label1.text = BranchLineStr[eIndex]
    tb.aortext_label2.text = BranchLineStr[eIndex]
end

function SociatyMobaBattleTeamView:OnClcikBranchItem(_, _, eIndex)
    local state, nextTime = SociatyMobaModel:GetInstance():GetMobaBattleStage()
    local StateEnum = SociatyMobaModel:GetInstance().SociatyMobaBattleState
    if state ~= StateEnum.Embattle and state ~= StateEnum.EmbattleAllDay then
        _G.PopWindowManager:GetInstance():ShowAllTips(950111)
        return
    end
    if eIndex == BranchLine.Embattle then
        ---调整阵容
        self:OpenEmbattleView()
        -- self:RefreshBranchBtn()
    else
        ---调整分线
        local garrayList = SociatyMobaModel:GetInstance():GetGarray()
        local newGarray = {}
        for _, v in pairs(garrayList) do
            if v.id == eIndex then
                if _G.AppSetting.IsXzns then
                    _G.table.insert(newGarray,
                    {
                        id = self.curBranch,
                        sits = garrayList[eIndex].sits,
                        skill_index = garrayList[eIndex].skill_index,
                        pet = garrayList[eIndex].pet,
                        beast = garrayList[eIndex].beast
                    })
                else
                    _G.table.insert(newGarray,
                    {
                        id = self.curBranch,
                        sits = garrayList[eIndex].sits,
                        skill_index = garrayList[eIndex].skill_index,
                        pet = garrayList[eIndex].pet
                    })
                end
            elseif v.id == self.curBranch then
                if _G.AppSetting.IsXzns then
                    _G.table.insert(newGarray,
                    {
                        id = eIndex,
                        sits = garrayList[self.curBranch].sits,
                        skill_index = garrayList[self.curBranch].skill_index,
                        pet = garrayList[self.curBranch].pet,
                        beast = garrayList[self.curBranch].beast
                    })
                else
                    _G.table.insert(newGarray,
                    {
                        id = eIndex,
                        sits = garrayList[self.curBranch].sits,
                        skill_index = garrayList[self.curBranch].skill_index,
                        pet = garrayList[self.curBranch].pet
                    })
                end
            else
                _G.table.insert(newGarray, v)
            end
        end
        SociatyMobaModel:GetInstance():UpdateGarray(newGarray, function()
            -- self:RefreshBranchBtn()
            if _G.AppSetting.IsXzns then
                local content =  _G.GetLangPackValue(90031700437, BranchStr[eIndex])
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    1,
                    content
                )
            end
            self.allLineInfo = {}
            SociatyMobaModel:GetInstance():GetLineInfo(0, _G.handler(self, self.RefreshView))
        end)
    end
end

---刷新页签
function SociatyMobaBattleTeamView:RefreshToggle(go, isOn, type)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)

    if self.curBranch == type then
       return
    end
    self.curBranch = type
    self:RefreshBranchBtn()
    self:RefreshTeam()
    self:UpdateFakeRedPoint()
end

---界面的销毁函数
function SociatyMobaBattleTeamView:Dispose()
    self:RemoveListener(_G.eSociatyMobaBattle.SociatyMobaGarray, self.UpdateFakeRedPoint)
    self.go_table = nil
end

---打开布阵界面
function SociatyMobaBattleTeamView:OpenEmbattleView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SociatyMobaEmbattleView.Name,
        SociatyMobaModel:GetInstance():GetGarray(),
        self.curBranch,
        self.lineInfo,
        function()
            self.allLineInfo[self.curBranch] = {}
            SociatyMobaModel:GetInstance():GetLineInfo(0, _G.handler(self, self.RefreshView))
        end
    )
end

---刷新页签假红点（因为指挥能操作分线，故不进红点树）
function SociatyMobaBattleTeamView:UpdateFakeRedPoint()
    local tb
    for i = 1, 4 do
        tb = self.toggles[i]
        if self.curBranch == i then
            tb.obj_redpoint:SetActiveE(0)
        else
            tb.obj_redpoint:SetActiveE(SociatyMobaModel:GetInstance():CheckSingleEmbattleUnfull(i))
        end
    end
end

---按钮点击事件在这里派发
function SociatyMobaBattleTeamView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_closeView" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "$_toggle_topLaner" then
        ---上路
        self:RefreshToggle(go, isOn, BranchLine.TopLaner)
    elseif name == "$_toggle_midLaner" then
        ---中路
        self:RefreshToggle(go, isOn, BranchLine.MidLaner)
    elseif name == "$_toggle_botLaner" then
        ---下路
        self:RefreshToggle(go, isOn, BranchLine.BotLaner)
    elseif name == "$_toggle_jungle" then
        ---野区
        self:RefreshToggle(go, isOn, BranchLine.Jungle)
    elseif name == "@_aorbtn_adjust" then
        ---调整
        self:OnClcikBranchItem(nil, nil, 5)
    elseif name == "@_aorbtn_goto1" then
        ---调整
        self:OnClcikBranchItem(nil, nil, 1)
    elseif name == "@_aorbtn_goto2" then
        ---调整
        self:OnClcikBranchItem(nil, nil, 2)
    elseif name == "@_aorbtn_goto3" then
        ---调整
        self:OnClcikBranchItem(nil, nil, 3)
    elseif name == "@_aorbtn_goto4" then
        ---调整
        self:OnClcikBranchItem(nil, nil, 4)
    -- elseif name == "@_aorbtn_branch" then
    --     self:RefreshBranchBtn()
    elseif name == "@_aorbtn_emptyTeam" then
        ---上阵
        self:OpenEmbattleView()
    end
end

return SociatyMobaBattleTeamView