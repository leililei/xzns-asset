---@class SociatyMobaEmbattleSkill : Component	中文描述
local SociatyMobaEmbattleSkill = _G.BaseClass("SociatyMobaEmbattleSkill", _G.Component)

local table = _G.table
local PetOrderFrame = require("PetModel").PetOrderFrame
local Professional = {
    main = 1,
    assist = 2,
    tactic = 3
}

---创建对象时,入口构造函数
function SociatyMobaEmbattleSkill:__init(obj, mParentView)
    self.gameObject = obj
    self.mParentView = mParentView
    ---标签文本
    self.flagList = {
        _G.GetLangPackValue(90024900004),
        _G.GetLangPackValue(90024900005),
        _G.GetLangPackValue(90024900006)
    }
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table_item = _G.GetAutoGoTable(mParentView.go_table.obj_selectGrid)
    ---缓存选中的技能item
    self.selectedItemList = {}
end

---隐藏界面
function SociatyMobaEmbattleSkill:Hide()
    self.mParentView.go_table.obj_empty:SetActiveE(0)
    self.gameObject:SetActiveE(0)
end

---@param isShow boolean 是否显示界面
---@param isChangeBtn boolean 是否切换页签
---@param selectedData table 选中的数据
---@param otherSelectSkillData table 其他队伍选择的技能数据
function SociatyMobaEmbattleSkill:Show(isShow, isChangeBtn, selectedData, otherSelectSkillData)
    if not isShow then
        if _G.AppSetting.IsXzns then
            self.mParentView:SaveSelectBeastData(self.selectedData)
        else
            self.mParentView:SaveSelectSkillData(self.selectedData)
        end
        self:Hide()
        return
    end
    self.gameObject:SetActiveE(1)
    ---当前分线队伍选择的数据
    self.selectedData = selectedData or {0, 0, 0}
    ---其他分线队伍选择的数据
    self.otherSelectSkillData = otherSelectSkillData or {}
    -- require("CombineModel"):GetInstance():UpdateAllData()
    self.curType = Professional.main
    self:ChooseSkillData()
    self:RefreshSelectSkill()
    if isChangeBtn then
        self.go_table.toggle_active.isOn = true
    end
end

---筛选数据
function SociatyMobaEmbattleSkill:ChooseSkillData()
    local combineDatas
    if _G.AppSetting.IsXzns then
        combineDatas = require("BeastModel"):GetInstance():GetAllActiveBeasts()
        self.coopBeast = {}
        for _, v in pairs(combineDatas) do
            self.coopBeast[v.sid] = v.cfg.skill_id[1][2] ~= 0
        end
    else
        combineDatas = require("PetModel"):GetInstance():GetAllActivePets()
        combineDatas = _G.table.chooseToArray(
            combineDatas,
            function(k, v)
                return v.cfg.professional == self.curType
            end
        )
    end
    self.combineDatas = combineDatas
    if #self.combineDatas > 0 then
        _G.SortList(
            self.combineDatas,
            function(a)
                local index = 1
                if table.indexof(self.selectedData, a.sid) then
                    index = 2
                end

                if self.otherSelectSkillData[a.sid] then
                    index = 0
                end
                return index, a:GetOrder(), a:GetStar(), a.sid
            end
        )
        self.mParentView.go_table.obj_empty:SetActiveE(0)
    else
        self.mParentView.go_table.obj_empty:SetActiveE(1)
        self.mParentView.go_table.aortext_empty.text = _G.GetLangPackValue(90114010121)
    end
    if not self.skillListView then
        self.go_table.scrollloopvectical_skill:InitItemData(#self.combineDatas, _G.handler(self, self.RefreshSkillItem))
        self.skillListView = self.go_table.scrollloopvectical_skill
    else
        self.skillListView:UpdateCount(#self.combineDatas)
    end
end

function SociatyMobaEmbattleSkill:RefreshSkillItem(index, obj)
    local data = self.combineDatas[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSkillItem, data))
    self:ShowPetItem(tb, data.sid)
    if _G.AppSetting.IsXzns then--星座的圣兽不分类，全在一个列表显示
        if self.selectedData[1] == data.sid or self.selectedData[2] == data.sid or self.selectedData[3] == data.sid then
            tb.obj_shadow:SetActiveE(1)
            tb.obj_curMask:SetActiveE(1)
            tb.obj_otherMask:SetActiveE(0)
        elseif self.otherSelectSkillData[data.sid] then
            tb.obj_shadow:SetActiveE(1)
            tb.obj_curMask:SetActiveE(0)
            tb.obj_otherMask:SetActiveE(1)
        elseif self.selectedData[1] ~= 0 and self.coopBeast[data.sid] == false then--上了主战后没有协战技能的加蒙版
            tb.obj_shadow:SetActiveE(1)
            tb.obj_curMask:SetActiveE(0)
            tb.obj_otherMask:SetActiveE(0)
        else
            tb.obj_shadow:SetActiveE(0)
        end
    else
        if self.selectedData[self.curType] == data.sid then
            tb.obj_shadow:SetActiveE(1)
            tb.obj_curMask:SetActiveE(1)
            tb.obj_otherMask:SetActiveE(0)
        elseif self.otherSelectSkillData[data.sid] then
            tb.obj_shadow:SetActiveE(1)
            tb.obj_curMask:SetActiveE(0)
            tb.obj_otherMask:SetActiveE(1)
        else
            tb.obj_shadow:SetActiveE(0)
        end
    end
    -- _G.SetEventTrigger(tb.aorbtn_click, "onLongPress", _G.handlerbind(self, self.OnLongPress, data))
end

function SociatyMobaEmbattleSkill:OnLongPress(_, _, data)
    if not _G.AppSetting.IsXzns then
        require("CommonTipManager"):GetInstance():OpenView(_G.TipType.Pet, data, nil)
    end
end

function SociatyMobaEmbattleSkill:OnClickSkillItem(_, _, data)
    ---其他队伍选择的不响应
    if self.otherSelectSkillData[data.sid] then
        self.otherSelectSkillData[data.sid] = nil
    end

    local haveChange = false

    if _G.AppSetting.IsXzns then
        for i = 1, 3 do
            if self.selectedData[i] == data.sid then
                self.selectedData[i] = 0
                haveChange = true
            end
        end
        if not haveChange then--没有下阵再检查能否上阵
            if self.selectedData[1] == 0 then
                self.selectedData[1] = data.sid
                haveChange = true
            elseif self.selectedData[2] == 0 then
                if self.coopBeast[data.sid] == true then
                    self.selectedData[2] = data.sid
                    haveChange = true
                end
            elseif self.selectedData[3] == 0 then
                if self.coopBeast[data.sid] == true then
                    self.selectedData[3] = data.sid
                    haveChange = true
                end
            end
        end
    else
        if self.selectedData[self.curType] == 0 then
            self.selectedData[self.curType] = data.sid
            haveChange = true
        else
            if self.selectedData[self.curType] == data.sid then
                self.selectedData[self.curType] = 0
                haveChange = true
            end
        end
    end

    if haveChange then
        self.skillListView:UpdateAllItem()
        self:RefreshSelectSkill()
    end
end

---刷新选中的技能
function SociatyMobaEmbattleSkill:RefreshSelectSkill(selectedData)
    if selectedData then
        self.selectedData = selectedData
    end
    for index = 1, 3 do
        local tb = self.selectedItemList[index]
        if not tb then
            tb =
                _G.GetAutoGoTable(
                self.go_table_item["obj_selectItem" .. index],
                _G.handlerbind(self, self.OnClickSelectItem, index)
            )
            self.selectedItemList[index] = tb
        end
        if self.selectedData[index] > 0 then
            tb.gameObject:SetActiveE(1)
            self:ShowPetItem(tb, self.selectedData[index])
        else
            tb.gameObject:SetActiveE(0)
        end
    end
end

function SociatyMobaEmbattleSkill:ShowPetItem(tb, sid)
    local petData
    if _G.AppSetting.IsXzns then
        petData =  require("BeastModel"):GetInstance():GetBeast(sid)
    else
        petData =  require("PetModel"):GetInstance():GetPet(sid)
    end
    local petCfg = petData.cfg
    local skillIdx, maxSkillIdx = petData.star + 1, #petCfg.skill_id
    local skillId = petCfg.skill_id[skillIdx < 1 and 1 or skillIdx <= maxSkillIdx and skillIdx or maxSkillIdx]
    local cfgt = _G.ConfigManager.card_skills_cfg[skillId]
    -- local cfg = _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]
    tb.aorrawimage_icon:LoadImage(petCfg.Icon or petCfg.icon)
    -- combineItem.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
    -- combineItem.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
    if _G.AppSetting.IsXzns then
        tb.aorimage_bg.SpriteName = _G.ItemBaseIconName_Decoration[petCfg.order]
    else
        tb.aorimage_bg.SpriteName = PetOrderFrame[petCfg.Order]
    end
end

function SociatyMobaEmbattleSkill:OnClickSelectItem(_, _, index)
    self.selectedData[index] = 0
    self.selectedItemList[index].aorrawimage_icon:SetActiveE(0)
    self.selectedItemList[index].aorimage_typeBg:SetActiveE(0)
    self.skillListView:UpdateAllItem()
end

function SociatyMobaEmbattleSkill:OnClickBtn(go)
    if go == self.go_table.toggle_active then
        if self.curType ~= Professional.main then
            self.curType = Professional.main
            self:ChooseSkillData()
        end
    elseif go == self.go_table.toggle_passive then
        if self.curType ~= Professional.assist then
            self.curType = Professional.assist
            self:ChooseSkillData()
        end
    elseif go == self.go_table.toggle_ZH then
        if self.curType ~= Professional.tactic then
            self.curType = Professional.tactic
            self:ChooseSkillData()
        end
    elseif go == self.go_table.aorbtn_confirm then
        self.mParentView:SaveEmbattle()
    end
end

return SociatyMobaEmbattleSkill
