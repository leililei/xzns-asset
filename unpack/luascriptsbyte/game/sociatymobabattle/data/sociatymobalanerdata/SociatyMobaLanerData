---@class SociatyMobaLanerData    中文描述
local SociatyMobaLanerData = _G.BaseClass("SociatyMobaLanerData")

---类的构造函数
function SociatyMobaLanerData:__init(ab)
    self.SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.ab = ab
end

---@param msg guild_moba.i_fight_tower
function SociatyMobaLanerData:Parse(msg)
    local LanerState = require("SociatyMobaBattleModel").LanerState
    local ABIndex = require("SociatyMobaBattleModel").ABIndex
    self.ABIdx = ABIndex[self.ab]
    self.sid = msg.sid
    self.cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
    self.state = LanerState.InBattle
    if msg.state == 3 then --双方无队伍，全负
        self.state = LanerState.Defeat
    elseif msg.state > 0 then
        if msg.state == self.ABIdx then
            self.state = LanerState.Defeat
        else
            self.state = LanerState.Victory
        end
    end

    self.maxNum = msg[self.ab .. "_line_max"]
    self.curNum = msg[self.ab .. "_line_num"] or 0
    local mab = msg["m_" .. self.ab]
    self.curTeam = mab
    if mab then
        for _, v in pairs(mab) do
            if v.t_index > self.curNum then
                self.curNum = v.t_index
            end
        end
    end

    ---塔人数
    local teamSize = self.cfg.team[self.ABIdx]
    local len = #teamSize
    self:UpdateTowerTeamNum(teamSize, len)

    ---塔摧毁情况
    self.towerBroken = {}
    local sum = self.maxNum
    local preSum = 0
    for i = 1, len do
        if self.state == LanerState.Defeat then
            self.towerBroken[i] = true
        elseif self.towerNum[i] > 0 then
            self.towerBroken[i] = false
        elseif preSum > 0 then
            self.towerBroken[i] = false
        elseif self:GetAllTowerCurNum() + teamSize[i] < sum then
            self.towerBroken[i] = true
        else
            self.towerBroken[i] = false
        end
        sum = sum - teamSize[i]
        preSum = preSum + self.towerNum[i]
    end
end

function SociatyMobaLanerData:OnTowerMarch(index)
    for i = 1, #self.towerNum do
        if self.towerNum[i] > 0 then
            self.towerNum[i] = self.towerNum[i] - 1
            break
        end
    end
    self.curNum = index
end

---@param msg guild_moba.i_tower_march
function SociatyMobaLanerData:UpdateCurTeam(msg)
    self.curTeam = msg
end

function SociatyMobaLanerData:SetTowerBroken(towerId)
    self.towerBroken[towerId] = true
end

function SociatyMobaLanerData:SetLanerWinState(isWin)
    local LanerState = require("SociatyMobaBattleModel").LanerState
    self.state = isWin and LanerState.Victory or LanerState.Defeat
end

---获取某个塔当前剩余队伍数
function SociatyMobaLanerData:GetTowerCurNum(id, includeMarch)
    if includeMarch then
        if id == 1 and not self:CheckTowerIsBroken(id) then
            return self.towerNum[id] + self:GetMarchNum()
        elseif self:CheckTowerIsBroken(id - 1) and not self:CheckTowerIsBroken(id) then
            return self.towerNum[id] + self:GetMarchNum()
        else
            return self.towerNum[id]
        end
    else
        return self.towerNum[id]
    end
end

---获取已行军队伍数量
function SociatyMobaLanerData:GetMarchNum()
    local LanerState = require("SociatyMobaBattleModel").LanerState
    if self.state == LanerState.Victory then
        return 1
    end
    return self.curTeam and 1 or 0
end

---检测某个塔是否被摧毁
function SociatyMobaLanerData:CheckTowerIsBroken(towerId)
    return self.towerBroken[towerId]
end

function SociatyMobaLanerData:GetAllTowerCurNum()
    local num = 0
    for _, v in pairs(self.towerNum) do
        num = num + v
    end
    return num
end

function SociatyMobaLanerData:AddCreepTeam()
    self.maxNum = self.maxNum + 1
    local teamSize = self.cfg.team[self.ABIdx]
    local len = #teamSize
    self:UpdateTowerTeamNum(teamSize, len)
end

function SociatyMobaLanerData:UpdateTowerTeamNum(teamSize, len)
    local LanerState = require("SociatyMobaBattleModel").LanerState
    self.towerNum = {}
    if self.state == LanerState.Defeat then
        for i = 1, len do
            _G.table.insert(self.towerNum, 0)
        end
    else
        local totalNum = self.maxNum
        local curNum = self.curNum
        for i = 1, len do
            if i == len then
                _G.table.insert(self.towerNum, totalNum)
            elseif totalNum > teamSize[i] then
                _G.table.insert(self.towerNum, teamSize[i])
                totalNum = totalNum - teamSize[i]
            else
                _G.table.insert(self.towerNum, totalNum)
                totalNum = 0
            end
        end
        for i = 1, len do
            if curNum >= self.towerNum[i] then
                curNum = curNum - self.towerNum[i]
                self.towerNum[i] = 0
            else
                self.towerNum[i] = self.towerNum[i] - curNum
                curNum = 0
            end
        end
    end
end

---类的析构函数
function SociatyMobaLanerData:Dispose()
end

return SociatyMobaLanerData
