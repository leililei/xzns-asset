local base = require("BaseGameNet")

---@class SociatyMobaNet : BaseGameNet	通信协议
local SociatyMobaNet = _G.BaseClass("SociatyMobaNet", base)
---@return SociatyMobaNet SociatyMobaNet
function SociatyMobaNet:GetInstance()
    return  base.GetInstance(self)
end

---获取MOBA公会战信息
---@param pbData table PB数据
---@param callback function 完成回调
function SociatyMobaNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_guild_moba_info
    local port = base.Access(self, item, self.GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

