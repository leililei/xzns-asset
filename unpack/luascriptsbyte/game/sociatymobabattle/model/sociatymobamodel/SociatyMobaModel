---销毁对象时,析构函数
function SociatyMobaModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.battleInfo = {}
    self.score = 0
    self.garray = {}
    self.jungleTimes = 0
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.p2c_info_change.Cmd, self.UpdateInfo, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.p2c_moba_wind.Cmd, self.UpdateMobaWind, self)
    _G.Events:GetInstance():RemoveListener(_G.eCard.CardDelCard, self.RefreshGarrayData, self)
end

return SociatyMobaModel
