---赛季排行榜奖励
function SociatyMobaModel:GetSeasonRankAwards()
    if not _G.table.isEmptyOrNil(self.rankAwardList) then
        return self.rankAwardList
    end

    self.rankAwardList = {}
    if not self.seasonCfgId then
        self.seasonCfgId = 1
    end
    local rank = _G.ConfigManager.guild_moba_season_cfg[self.seasonCfgId].rank
    local rankConfig = _G.ConfigManager.system_rank_cfg
    for _, v in pairs(rank) do
        if rankConfig[v] then
            _G.table.insert(self.rankAwardList, rankConfig[v])
        end
    end

    --进行排序(从高到底)
    _G.SortList(
        self.rankAwardList,
        function(v)
            return -v.min_rank
        end
    )

    return self.rankAwardList
end

