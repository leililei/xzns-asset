---在周天的21点到24点之间因为服务器还没有匹配，但客户端表现上定段已结束，所以需要客户端自己去计算结果
function SociatyMobaModel:IsSettleSucess()
    local battleState = self:GetMobaBattleStage()
    if battleState == self.SociatyMobaBattleState.Grading or battleState == self.SociatyMobaBattleState.SeasonSettlement then
        return self:IsCanMatch()
    end
    return false
end

