---获取下一场匹配时间
function SociatyMobaModel:GetNextMatchTime()
    local currentDay = _G.TimeUtil.GetWeekDay()
    local statrTime = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
    if currentDay < 7 then
        ---先从当前时间向后找下一场匹配时间
        for day = currentDay + 1, 7 do
            local stageList = self.SociatyStageCfg[day]
            for _, v in pairs(stageList) do
                if v[1] == self.SociatyMobaBattleState.Match then
                    return (day - currentDay) * 86400 + statrTime + v[2] * 3600 + v[3] * 60
                end
            end
        end
    end

    ---后面几天没有匹配阶段，就去下一周找
    for day = 1, currentDay - 1 do
        local stageList = self.SociatyStageCfg[day]
        for _, v in pairs(stageList) do
            if v[1] == self.SociatyMobaBattleState.Match then
                return (7 - currentDay + day) * 86400 + statrTime + v[2] * 3600 + v[3] * 60
            end
        end
    end

    return _G.TimeUtil.GetServerUnixTime()
end

---是否满足匹配条件
function SociatyMobaModel:IsCanMatch()
    local sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    local base = _G.ConfigManager.discrete_cfg[101664][1][1]
    if sociatySelf.SevenDayLive < base then
        return false
    end

    return true
end

---公会等级
function SociatyMobaModel:GetSociatyLevel()
    local curLevel = 1
    local configs = _G.ConfigManager.guild_moba_normal_cfg
    for _, v in ipairs(configs) do
        if self.score >= v.min then
            curLevel = v.id
        end
    end

    return curLevel
end

---通过积分计算当前公会等级（主要用于排行榜，所以最少是黄级）
---@param score number 公会积分
function SociatyMobaModel:GetSociatyLevelByScore(score)
    local curLevel = self.SociatyLevel.YellowLevel
    local configs = _G.ConfigManager.guild_moba_normal_cfg
    for _, v in ipairs(configs) do
        if score >= v.min then
            curLevel = v.id
        end
    end

    return curLevel
end

---判断当前是否显示定段界面（如果当前处于布阵阶段，需要判断当前是否和定段是同一天）
---@param weekDay number 当前周几
function SociatyMobaModel:IsShowSettleView(weekDay, battleState)
    if battleState == self.SociatyMobaBattleState.EmbattleAllDay then
        ---整天都是布阵
        return true
    end

    ---ZHJH-8714 2025.07.10赛季结算阶段不可进入战场
    if battleState == self.SociatyMobaBattleState.SeasonSettlement then
        return true
    end

    if battleState == self.SociatyMobaBattleState.Embattle then
        ---和定段在同一天的布阵阶段显示定段界面
        local stageList = self.SociatyStageCfg[weekDay]
        for _, v in pairs(stageList) do
            if v[1] == self.SociatyMobaBattleState.Grading then
                return true
            end
        end
    end

    return false
end

---判断是否显示定段结果界面
function SociatyMobaModel:IsShowSettleResultView(weekDay, battleState)
    if battleState == self.SociatyMobaBattleState.Grading then
        return true
    end

    if weekDay == 1 and battleState == self.SociatyMobaBattleState.Match then
        return true
    end

    if battleState == self.SociatyMobaBattleState.SeasonSettlement and weekDay == 1 then
        return true
    end

    if battleState ~= self.SociatyMobaBattleState.SeasonSettlement and self.matchGuild == 0 then
        return true
    end

    return false
end

