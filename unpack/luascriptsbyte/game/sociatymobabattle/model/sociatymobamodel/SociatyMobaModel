---获取当前比赛所在的阶段
---@return number
function SociatyMobaModel:GetMobaBattleStage()
    local currentDay = _G.TimeUtil.GetWeekDay()
    local stageList = self.SociatyStageCfg[currentDay]

    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local beginTime = _G.TimeUtil.GetDayBegin(serverTime)
    for _, v in ipairs(stageList) do
        local startTime = v[2] * 3600 + v[3] * 60
        local endTime = v[4] * 3600 + v[5] * 60
        if serverTime >= beginTime + startTime and serverTime < beginTime + endTime then
            return v[1], beginTime + endTime
        end
    end

    return self.SociatyMobaBattleState.Grading, 0
end

---状态计时器
function SociatyMobaModel:SetStateTimer(nextStateTime)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    local delay = nextStateTime - _G.TimeUtil.GetServerUnixTime()
    if delay < 1 then
        delay = 1 --容错，用0可能会卡
    end
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(
        delay,
        _G.handlerbind(self, self.GetInfo, true),
        self,
        true,
        false,
        false
    )
    self.timer:Start()
end

---检测当前是否是布阵阶段
function SociatyMobaModel:IsEmbattleState()
    local battleState = self:GetMobaBattleStage()
    if battleState == self.SociatyMobaBattleState.Embattle or battleState == self.SociatyMobaBattleState.EmbattleAllDay then
        return true
    end

    return false
end

---获取下一阶段的开始时间
function SociatyMobaModel:GetNextStateTime()
    local _, nextStateTime = self:GetMobaBattleStage()
    return nextStateTime
end

---当天结算结束时间
function SociatyMobaModel:GetSettlementEndTime()
    local currentDay = _G.TimeUtil.GetWeekDay()
    local stageList = self.SociatyStageCfg[currentDay]
    local serverTime = _G.TimeUtil.GetServerUnixTime()

    for _, v in ipairs(stageList) do
        if v[1] == self.SociatyMobaBattleState.Settlement then
            return v[4] * 3600 + v[5] * 60 + _G.TimeUtil.GetDayBegin(serverTime)
        end
    end
    return serverTime
end

---获取每周第一场战斗开始时间(主要用于定段界面显示)
function SociatyMobaModel:GetFirstBattleStartTime()
    for day, config in ipairs(self.SociatyStageCfg) do
        for _, v in pairs(config) do
            if v[1] == self.SociatyMobaBattleState.Fighting then
                local statrTime = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
                local currentDay = _G.TimeUtil.GetWeekDay()
                if day >= currentDay then
                    return (day - currentDay) * 86400 + statrTime + v[2] * 3600 + v[3] * 60
                else
                    return (7 - _G.TimeUtil.GetWeekDay() + day) * 86400 + statrTime + v[2] * 3600 + v[3] * 60
                end
            end
        end
    end
    return _G.TimeUtil.GetServerUnixTime()
end

---战斗开始时间
function SociatyMobaModel:GetBattleStartTime()
    local weekDay = _G.TimeUtil.GetWeekDay()
    local stageList = self.SociatyStageCfg[weekDay]

    for _, v in pairs(stageList) do
        if v[1] == self.SociatyMobaBattleState.Fighting then
            local statrTime = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
            return statrTime + v[2] * 3600 + v[3] * 60
        end
    end

    return _G.TimeUtil.GetServerUnixTime()
end

---某阶段开始时间（可跨天）
function SociatyMobaModel:GetStateStartTimeAcrossDay(state)
    local weekDay = _G.TimeUtil.GetWeekDay()
    local stageList
    local day = 0
    for i = 0, 6 do
        stageList = self.SociatyStageCfg[(weekDay + i - 1) % 7 + 1]
        for _, v in pairs(stageList) do
            if v[1] == state then
                local startTime = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime())
                return startTime + v[2] * 3600 + v[3] * 60 + day * 86400
            end
        end
        day = day + 1
    end

    return _G.TimeUtil.GetServerUnixTime()
end

