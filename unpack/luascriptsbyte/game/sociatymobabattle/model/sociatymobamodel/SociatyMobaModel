---领取MVP奖励/参与奖
---@param type number 1：参与奖、2：MVP奖
---@param seasonId number 赛季id
---@param seasonIndex number 赛季场次
---@param seasonCfgId number 赛季配置id
function SociatyMobaModel:GetFightAward(type, seasonId, seasonIndex, seasonCfgId, callBack)
    local pbData = {
        type = type,
        season_id = seasonId,
        season_index = seasonIndex,
        season_cfg_id = seasonCfgId
    }
    SociatyMobaNet:GetInstance():GetFightAward(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require("SociatyModel"):GetInstance():ReceiveBuildCoin(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            for _, v in pairs(self.battleInfo) do
                if v.f_index == seasonIndex and v.f_season_id == seasonId then
                    if type == 1 then
                        v.award = 2
                    else
                        v.award_mvp = 1
                    end
                    break
                end
            end
            if callBack then
                callBack()
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaAward.id, type)
        end
    )
end

---检测出征队伍按钮的红点,只要布阵阶段才展示红点
function SociatyMobaModel:CheckEmbattleRedPoint()
    local sbot = require("SociatyMobaModel"):GetInstance():GetSociatyMobaOpenTime()
    if sbot - _G.TimeUtil.GetServerUnixTime() > 0 then
        return 0
    end

    local battleState = self:GetMobaBattleStage()
    if battleState == self.SociatyMobaBattleState.EmbattleAllDay or battleState == self.SociatyMobaBattleState.Embattle then
        if battleState == self.SociatyMobaBattleState.Embattle and self.matchGuild == 0 then
            ---匹配失败不显示红点
            return 0
        end

        if _G.table.isEmptyOrNil(self.garray) then
            return 1
        end

        if _G.table.count(self.garray) ~= 4 then
            ---已上阵卡牌
            local garrayList = {}
            for _, v in pairs(self.garray) do
                for _, uid in pairs(v.sits) do
                    if uid and uid > 0 then
                        garrayList[uid] = v.id
                    end
                end
            end
            ---判断是否有足够的卡牌上阵
            local cardData = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
            for _, v in pairs(cardData) do
                if not garrayList[v.uid] then
                    return 1
                end
            end
        end
    end

    return 0
end

---检测单线布阵是否未布阵
function SociatyMobaModel:CheckSingleEmbattleUnfull(id)
    if _G.table.isEmptyOrNil(self.garray) then
        return 1
    end
    for _, v in pairs(self.garray) do
        if v.id == id then
            for _, uid in pairs(v.sits) do
                if uid > 0 then
                    return 0
                end
            end
        end
    end
    return 1
end

---检测单线布阵是否有空缺
function SociatyMobaModel:CheckSingleEmbattleHasEmpty(id)
    if _G.table.isEmptyOrNil(self.garray) then
        return true
    end
    local num = 0
    for _, v in pairs(self.garray) do
        if v.id == id then
            for _, uid in pairs(v.sits) do
                if uid > 0 then
                    num = num + 1
                end
            end
        end
    end
    return num < 3
end

---检测是否可领奖
---@param param number 1参与奖2MVP奖励
function SociatyMobaModel:CheckCanGetAward(param)
    local sbot = require("SociatyMobaModel"):GetInstance():GetSociatyMobaOpenTime()
    if sbot - _G.TimeUtil.GetServerUnixTime() > 0 then
        return 0
    end

    if _G.table.isEmptyOrNil(self.battleInfo) then
        return 0
    end

    local battleState = self:GetMobaBattleStage()
    local weekDay = _G.TimeUtil.GetWeekDay()
    ---是否可以领取参与奖
    local showSettleView = self:IsShowSettleView(weekDay, battleState)
    local showSettleResView = self:IsShowSettleResultView(weekDay, battleState)
    -- local canGetAward = showSettleView or showSettleResView or false
    local canGetMVPAward = showSettleView or not showSettleResView
    for _, data in pairs(self.battleInfo) do
        if param == 1 and data.award == 1 then
            return 1
        end

        if param == 2 and data.self_mvp and data.award ~= 0 and data.award_mvp == 0 and canGetMVPAward then
            return 1
        end
    end

    return 0
end

---红点检测
function SociatyMobaModel:CheckRedPoint()
    local sbot = require("SociatyMobaModel"):GetInstance():GetSociatyMobaOpenTime()
    if sbot - _G.TimeUtil.GetServerUnixTime() > 0 then
        return 0
    end

    if not self.seasonId then
        ---没有数据表示还没有拉取到服务器数据
        return 0
    end

    if _G.PlayerPrefsManager.GetInt("SociatyMobaBattle_Enter", 0) == 0 then
        ---功能第一次开启后
        return 1
    end
    local battleState = self:GetMobaBattleStage()
    ---检测战斗开始红点--有打野次数
    if battleState == self.SociatyMobaBattleState.Fighting and self:GetWildTimes() > 0 and not self:CurFightIsEnd() then
        -- if _G.PlayerPrefsManager.GetInt("SociatyMobaBattle_WildTimes_" .. self.seasonId, 0) == self.seasonIndex then
        return 1
    -- end
    end

    return 0
end

---当前场次已打完
function SociatyMobaModel:CurFightIsEnd()
    for i, info in pairs(self.battleInfo) do
        if info.f_season_id == self.seasonId and info.f_index == self.seasonIndex then
            return true
        end
    end
    return false
end

---获取当场战斗数据
function SociatyMobaModel:GetCurBattleInfo()
    for i, info in pairs(self.battleInfo) do
        if info.f_season_id == self.seasonId and info.f_index == self.seasonIndex then
            return info
        end
    end
    return nil
end

