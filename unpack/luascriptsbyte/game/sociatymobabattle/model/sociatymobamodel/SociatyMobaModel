            self.commander = uid
            if uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaUpdateCommander)
            end
            if call then
                call()
            end
        end
    )
