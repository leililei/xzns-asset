function SociatyMobaModel:CheckGuessRedpoint()
    ---是否有匹配到对手
    local isMatchGuild = require("SociatyMobaModel"):GetInstance():IsMatchGuild()
    if not isMatchGuild then
        return false
    end
    ---是否有竞猜数据
    if self.guessIds == nil then
        return false
    end
    ---状态判定
    local state, _ = self:GetMobaBattleStage()
    if
        state == self.SociatyMobaBattleState.Match or state == self.SociatyMobaBattleState.Fighting or
            state == self.SociatyMobaBattleState.Grading or
            state == self.SociatyMobaBattleState.EmbattleAllDay or
            state == self.SociatyMobaBattleState.SeasonSettlement
     then
        return false
    elseif
        state == self.SociatyMobaBattleState.Embattle or state == self.SociatyMobaBattleState.Adjustline or
            state == self.SociatyMobaBattleState.Prepare
     then
        self.idNum = #self.guessIds
        local flag = 0
        for i = 1, self.idNum do
            if self.guessDic[self.guessIds[i]] == nil then
                flag = 1
                break
            end
        end
        if flag > 0 then
            return true
        end
    elseif state == self.SociatyMobaBattleState.Settlement then
        local today = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()) --改为登录查看
        if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SociatyMobaGuess, 0) ~= today then
            return true
        end
    end

    return false
end

