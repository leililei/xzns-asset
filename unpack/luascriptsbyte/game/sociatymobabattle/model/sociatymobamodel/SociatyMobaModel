end

---更新数据
function SociatyMobaModel:UpdateInfo(msg)
    if msg.type == 1 then
        ---更新公告
        _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaUpdateNotice, msg.notice)
    end
    if msg.uid then
        ---更新公会uid
        self.commander = msg.uid
        _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaUpdateCommander)
    end
end

---战斗结算推送
function SociatyMobaModel:UpdateMobaWind(msg)
    if msg.f_info then
        ---是防止客户端拉取到最新数据后再接收到推送，导致客户端重复缓存
        local isChange = false
        for i, info in pairs(self.battleInfo) do
            if info.f_season_id == msg.f_info.f_season_id and info.f_index == msg.f_info.f_index then
                self.battleInfo[i] = msg.f_info
                isChange = true
                break
            end
        end
        if not isChange then
            _G.table.insert(self.battleInfo, msg.f_info)
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaBattleEnd, msg)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildMobaAward.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaStart.id)
end

---更新阵容数据
---@param delUid number 删除的uid
function SociatyMobaModel:RefreshGarrayData(delUid)
    if not _G.table.isEmptyOrNil(self.garray) then
        local isChange = false
        for id, v in pairs(self.garray) do
            for i, uid in ipairs(v.sits) do
                if uid and uid ~= 0 and uid == delUid then
                    v.sits[i] = 0
                    isChange = true
                    break
                end
            end

            if isChange then
                if _G.table.sameByCount(v.sits, {0, 0, 0, 0, 0}) then
                    ---阵容中最后一张卡牌被消耗掉就清除阵容
                    self.garray[id] = nil
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.GuildMobaEmbattle.id
                    )
                end
                break
            end
        end
    end
end

---判断第一个服务器是否开启活动
function SociatyMobaModel:GetSociatyMobaOpenTime()
    local ot = _G.ConfigManager.discrete_cfg[101668][1][1]
    if ot > 999 then
        ot = 999
    end
    local _time = _G.PlayerModel:GetInstance().main_open_time + ot * 86400
    local day = _G.TimeUtil.GetWeekDay(_time)
    if day >= 1 and day <= 3 then
        ---周一到周三功能提前开启
        return _time - day * 86400
    end
    return _time
end

---获取数据
function SociatyMobaModel:GetInfo(isTimer)
    local sbot = require("SociatyMobaModel"):GetInstance():GetSociatyMobaOpenTime()
    if sbot - _G.TimeUtil.GetServerUnixTime() > 0 then
        self.super.ParseData(self)
        return
    end
    if _G.PlayerModel:GetInstance().main_open_time == 0 then
        ---未分配赛区
        self.super.ParseData(self)
        return
    end
    if not SociatyManager:GetInstance():HasSociaty() then
        ---未加入公会
        self.super.ParseData(self)
        return
    end
    SociatyMobaNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, isTimer))
    if isTimer then
        local state, _ = self:GetMobaBattleStage()
        if state == self.SociatyMobaBattleState.Fighting then
            _G.PopWindowManager:GetInstance():ShowAllTips(950118)
        end
    end
end

---获取信息回调
---@field battleInfo guild_moba.i_moba_fight_info 对战数据列表
---@field garray garray.i_garray 布阵数据列表
---@field jungleTimes number 已用打野次数
function SociatyMobaModel:GetInfoCall(msg, isTimer)
    if msg.ack ~= 1 then
        self.super.ParseData(self)
        return
    end
    local info = msg.info
    if info then
        ---赛季信息
        self:InitSeasonInfo(info.season)
        ---公会匹配数据
        self:InitGuildInfo(info.guild)
        ---赛季对战信息
        self.battleInfo = info.f_info or {}
        ---自己的布阵信息
        local garrays = info.garray or {}
        self.garray = {}
        if not _G.table.isEmptyOrNil(garrays) then
            for _, v in pairs(garrays) do
                self.garray[v.id] = v
            end
        end
        ---打野队伍次数{玩家uid，已用次数},非指挥只有自己的次数，指挥发所有
        self.wild_time = info.wild_time or {} -- ZHJ-36367废弃
        self.jungleTimes = 0 -- ZHJ-36367废弃
        for _, v in ipairs(self.wild_time) do
            if v.key == _G.PlayerModel:GetInstance():GetPlayerUid() then
                self.jungleTimes = v.value
                break
            end
        end
        self.autoWild = info.auto_wild or 0 -- ZHJ-36367废弃
        self.guessIds = info.guess_sid or {} --随机的竞猜sid guild_moba_guess_cfg
        self.danmuMe = info.danmu or  {} 
        self.sociatyUid = require "SociatyManager":GetInstance():GetGuildUid()
        local state, nextStateTime = self:GetMobaBattleStage()
        self:SetStateTimer(nextStateTime)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaEmbattle.id)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaStart.id)
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildMobaAward.id)
        if not isTimer then
            self:GetGuessInfoFromServer()
        else
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaGuess.id)
        end
        _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaBattleState, state, isTimer)
    end
    self.super.ParseData(self)
end

---初始化赛季信息
---@param data guild_moba.i_moba_season
function SociatyMobaModel:InitSeasonInfo(data)
    ---赛季id(自增)
    self.seasonId = data.season_id or 1
    ---赛季开始时间
    self.seasonStartTime = data.start_time or 0
    ---当前赛季场次
    self.seasonIndex = data.season_index or 1
    ---赛季配置id(如果赛季id没有获取到配置，则取最后一条配置)
    self.seasonCfgId = data.season_cfg_id or 1
    self.seasonCfg = _G.ConfigManager.guild_moba_season_cfg[self.seasonCfgId]
    self.seasonEndTime = self.seasonCfg.duration * 86400 + self.seasonStartTime
end

