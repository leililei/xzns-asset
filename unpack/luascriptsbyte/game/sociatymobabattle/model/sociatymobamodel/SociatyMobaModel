---周一到周三功能提前开启，需要特殊判断
function SociatyMobaModel:GetFunctionOpen()
    local createPlayer = _G.PlayerModel:GetInstance():CheckCreateRole()
    if self.curFunctionOpenID > 0 then
        if createPlayer then
            local residue = self:GetSociatyMobaOpenTime() - _G.TimeUtil.GetServerUnixTime()
            residue = _G.math.ceil(residue / 86400)
            return residue <= 0
        end
    end
    return createPlayer
end

---从服务器拉取数据
function SociatyMobaModel:GetDataFormServer()
