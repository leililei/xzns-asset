        _G.ConfigManager.discrete_cfg[101657],
        _G.ConfigManager.discrete_cfg[101658],
        _G.ConfigManager.discrete_cfg[101659],
        _G.ConfigManager.discrete_cfg[101660],
        _G.ConfigManager.discrete_cfg[101661],
        _G.ConfigManager.discrete_cfg[101662]
