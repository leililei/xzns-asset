    if _G.PlayerPrefsManager.GetInt("SociatyMobaBattle_Enter", 0) == 0 then
        _G.PlayerPrefsManager.SetInt("SociatyMobaBattle_Enter", 1)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaStart.id)
    end

    local weekDay = _G.TimeUtil.GetWeekDay()
    local battleState = self:GetMobaBattleStage()
    if self:IsShowSettleView(weekDay, battleState) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaSettleView.Name)
        return
    end

    if self:IsShowSettleResultView(weekDay, battleState) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaSettleResultView.Name)
        return
    end

    ---进入主界面
    if battleState == self.SociatyMobaBattleState.Fighting then
        ---战斗开始时有打野次数刷新红点
        if _G.PlayerPrefsManager.GetInt("SociatyMobaBattle_WildTimes_" .. self.seasonId, 0) ~= self.seasonIndex then
            _G.PlayerPrefsManager.SetInt("SociatyMobaBattle_WildTimes_" .. self.seasonId, self.seasonIndex)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GuildMobaStart.id)
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMobaBattleView.Name)
end

