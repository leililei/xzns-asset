---创建对象时,入口构造函数
function SociatyMobaBattleModel:__init()
    self.maxPlayerNum = 0
    for _, v in pairs(_G.ConfigManager.guild_level_cfg) do
        if v.num_player > self.maxPlayerNum then
            self.maxPlayerNum = v.num_player
        end
    end
    self.creepMaxTimes = _G.ConfigManager.discrete_cfg[101665][1][1]
    self.reports = {}
    self.lanerOur = {}
    self.lanerEnemy = {}
    self.creepData = {}
    self.hitRotation = {}
    self.unAutoUid = {}
    self.rankData = {}     --uid为key，方便修改数据
    self.rankSortData = {} --用于排序
    local cfg, pos
    for i = 1, 3 do
        cfg = _G.ConfigManager.guild_moba_campsite_cfg[i]
        pos = cfg.battle_coordinate
        if pos[2][1] == pos[1][1] then
            self.hitRotation[i] = pos[2][2] > pos[1][2] and -90 or -270
        else
            self.hitRotation[i] = math.atan((pos[2][2] - pos[1][2]) / (pos[2][1] - pos[1][1])) * 180 / math.pi
            if self.hitRotation[i] > 0 then
                self.hitRotation[i] = self.hitRotation[i] - 180
            end
        end
    end
end

---获取战场信息
function SociatyMobaBattleModel:GetBattleInfo(call)
    require("SociatyMobaNet"):GetInstance():GetBattleInfo(
        function(msg)
            self:InitBattleData(msg)
            if call then
                call(msg)
            end
        end
    )
end

