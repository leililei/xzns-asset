    end
end

---@param ourRank guild_moba.i_kill_rank[]
---@param enemyRank guild_moba.i_kill_rank[]
function SociatyMobaBattleModel:InitKillRank(ourRank, enemyRank)
    ourRank = ourRank or {}
    enemyRank = enemyRank or {}
    self.rankData = {}     --uid为key，方便修改数据
    self.rankSortData = {} --用于排序
    for _, v in pairs(ourRank) do
        v.isOur = true
        self.rankData[v.rank.uid] = v
        _G.table.insert(self.rankSortData, v)
    end
    for _, v in pairs(enemyRank) do
        v.isOur = false
        self.rankData[v.rank.uid] = v
        _G.table.insert(self.rankSortData, v)
    end
    self:SortKillRank()
end

function SociatyMobaBattleModel:SortKillRank()
    _G.table.sort(
        self.rankSortData,
        function(a, b)
            if a.value == b.value then
                return a.rank.uid > b.rank.uid
            end
            return a.value > b.value
        end
    )
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.selfKillRank = 0
    for i, v in pairs(self.rankSortData) do
        if v.rank.uid == uid then
            self.selfKillRank = i
            break
        end
    end
end

function SociatyMobaBattleModel:AddKillNum(uid)
    if self.rankData and self.rankData[uid] then
        self.rankData[uid].value = self.rankData[uid].value + 1
    end
end

---设置击杀数
function SociatyMobaBattleModel:SetKillNum(uid, num)
    if self.rankData and self.rankData[uid] then
        if num > self.rankData[uid].value then
            self.rankData[uid].value = num
        end
    end
end


function SociatyMobaBattleModel:GetKillRankData()
    return self.rankSortData or {}, self.selfKillRank
end

---更新打野数据（指挥变动）
function SociatyMobaBattleModel:UpdateCreepTimes()
    require("SociatyMobaNet"):GetInstance():GetBattleInfo(
        function(msg)
            self:InitCreepTimes(msg.wild_time)
        end
    )
end

---更新打野预设数据
function SociatyMobaBattleModel:UpdateCreepPreset(call)
    require("SociatyMobaNet"):GetInstance():GetBattleInfo(
        function(msg)
            self:CheckDataWildSet(msg)
            self:InitCreepPreset(msg.wild_set)
            if call then
                call()
            end
        end
    )
end

---添加打野中uid
function SociatyMobaBattleModel:AddCreepUid(sid, uid)
    if self.creepUid[sid] == nil then
        self.creepUid[sid] = {}
    end
    _G.table.insert(self.creepUid[sid], uid)
end

---移除打野中uid
function SociatyMobaBattleModel:RemoveCreepUid(sid, uid)
    if sid then
        if self.creepUid[sid] then
            _G.table.removebyvalue(self.creepUid[sid], uid, true)
        end
    else
        for _, uids in pairs(self.creepUid) do
            _G.table.removebyvalue(uids, uid, true)
        end
    end
end

function SociatyMobaBattleModel:AddCreepUidSort(sid, uid)
    if not self.creepUidSort[sid] then
        self.creepUidSort[sid] = {}
    end
    if not self.creepUidSortId[sid] then
        self.creepUidSortId[sid] = 1
    end
    self.creepUidSort[sid][uid] = self.creepUidSortId[sid]
    self.creepUidSortId[sid] = self.creepUidSortId[sid] + 1
end

function SociatyMobaBattleModel:GetCreepUidSort(sid)
    if not self.creepUidSort then
        return {}
    end
    return self.creepUidSort[sid] or {}
end

---初始化战报日志信息
---@param logs guild_moba.i_moba_log[]
function SociatyMobaBattleModel:InitReport(logs)
    self.reports = {}
    if logs then
        for i = #logs, 1, -1 do
            self:AddReport(logs[i])
        end
    end
end

---添加战报日志
---@param data guild_moba.i_moba_log
---@return string 日志文本
function SociatyMobaBattleModel:AddReport(data)
    local cfg = _G.ConfigManager.guild_moba_report_cfg[data.type]
    if data.type == 1 or data.type == 3 then
        data.laner = _G.table.remove(data.args, 1)
    end
    if data.type == 2 then
        local lanName = LanerName[_G.tonumber(data.args[1])]
        data.args[1] = data.args[2]
        data.args[2] = lanName
    elseif data.type == 4 then
        local gName = data.args[2]
        data.args[2] = LanerName[_G.tonumber(data.args[3])]
        data.args[3] = data.args[4]
        data.args[4] = gName
    elseif data.type == 5 then
        data.args[2] = self:GetCreepName(_G.tonumber(data.args[2]))
    elseif data.type == 6 then
        data.args[3] = LanerName[_G.tonumber(data.args[3])]
    elseif data.type == 7 then
        local laner = LanerName[_G.tonumber(data.args[1])]
        data.args[1] = data.args[2]
        data.args[2] = laner
    elseif data.type == 8 then
        data.args[1] = self:GetCreepName(_G.tonumber(data.args[1]))
    elseif data.type == 9 then
        if data.g_uid == 1 then ---平局
            data.args = { self.SociatySelf.Name }
        end
    end
    local report = {}
    report.data = data
    report.type = _G.ChatInfoType.system
    local lanId
    if data.type == 2 then
        if _G.tonumber(data.args[3]) - 2 > #cfg.language then
            lanId = cfg.language[#cfg.language]
        else
            lanId = cfg.language[_G.tonumber(data.args[3]) - 2]
        end
    else
        lanId = cfg.language[1]
    end
    local srcContent = _G.SafeGetLangPackValue(lanId, _G.SafeUnpack(data.args))
    local isOur = self:CheckIsOur(data.g_uid) or data.g_uid == 0
    report.n_content = _G.string.AddColor(srcContent, isOur and "1796DD" or "FF5555")
    if data.type ~= 7 then
        _G.table.insert(self.reports, report)
        _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaLog)
    end
    return srcContent, report.n_content, cfg.time
end

---获取战报日志
function SociatyMobaBattleModel:GetReport()
    return self.reports or {}
end

---获取野怪名字
function SociatyMobaBattleModel:GetCreepName(id)
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[id]
    return _G.GetLangPackValue(cfg.name[1][1])
end

---塔摧毁
---@param lanerId number 线路id
---@param towerId number 防御塔id
---@param isOur boolean 是否是我方
function SociatyMobaBattleModel:OnTowerDestroy(lanerId, towerId, isOur)
    if isOur then
        self.lanerOur[lanerId]:SetTowerBroken(towerId)
    else
        self.lanerEnemy[lanerId]:SetTowerBroken(towerId)
    end
end

---单线战败
---@param lanerId number 线路id
---@param isOur boolean 是否是我方
function SociatyMobaBattleModel:OnLanerDefeat(lanerId, isOur)
    if isOur then
        for i = 1, 3 do
            self.lanerOur[lanerId]:SetTowerBroken(i)
        end
        self.lanerOur[lanerId]:SetLanerWinState(false)
        self.lanerEnemy[lanerId]:SetLanerWinState(true)
    else
        for i = 1, 3 do
            self.lanerEnemy[lanerId]:SetTowerBroken(i)
        end
        self.lanerOur[lanerId]:SetLanerWinState(true)
        self.lanerEnemy[lanerId]:SetLanerWinState(false)
    end
end

---防御塔行军
---@param lanerId number 线路id
---@param isOur boolean 是否是我方
---@param index number 第几个队伍
