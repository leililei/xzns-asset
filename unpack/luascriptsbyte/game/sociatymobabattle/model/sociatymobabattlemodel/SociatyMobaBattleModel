---根据分线防御塔剩余队伍检测是否结算（暂时弃用，战斗结果后台推送，且防御塔剩余数量计算有误）
---@return number 0-未结算，1-我方胜利，2-敌方胜利
function SociatyMobaBattleModel:CheckSettlement()
    local brokenOur = 0
    local brokenEnemy = 0
    for i = 1, 3 do
        if self:GetLanerCurTeamNum(i, true) == 0 then
            brokenOur = brokenOur + 1
        end
        if brokenOur >= 2 then
            return 2
        end
        if self:GetLanerCurTeamNum(i) == 0 then
            brokenEnemy = brokenEnemy + 1
        end
        if brokenEnemy >= 2 then
            self.data.win_guild = self.SociatySelf.Uid
            return 1
        end
    end
    return 0
end

