-- 弹幕解析组装
function SociatyMobaBattleModel:DanmuPairse(danmuList)
    --- 弹幕离散表配置 查找语言表
    local LanguageList = _G.ConfigManager.discrete_cfg[116200]

    local SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    --- 组装要传入的弹幕Item结构 content为数据 color为颜色 expressionPath 为表情路径 tag频道标签
    --- name为玩家名 【除了表情弹幕 其他消息一律拼好content为数据再传】
    local danmuItemList = {}
    --- 弹幕开关
    local isDanmuShow = true
    local MessageContentColors = {
        [1] = "<color=#5BDF99>", --自己的文本颜色
        [2] = "<color=#76DAF8>", --盟友的文本颜色
        [3] = "<color=#FF5555>", --敌对的文本颜色
    }
    if not self.lianshaicon then
        self.lianshaicon={
            "ui_alxzc_zcjm_piaozi_liansha",
            "ui_alxzc_zcjm_piaozi_baozou",
            "ui_alxzc_zcjm_piaozi_chaosheng",
            "ui_alxzc_zcjm_piaozi_tzzc"
        }
    end
    if not self.lianshaCfg then
        self.lianshaCfg=_G.ConfigManager.discrete_cfg[116203]
    end
    local atlas = "AtlasH5/nSociatyMoba_Language/nSociatyMoba_LanguageAtlas"
    if #danmuList > 0 and isDanmuShow then
        for i = 1, #danmuList do
            --_G.LogError(danmuList[i])
            --获取弹幕文本颜色
            local isSelf = danmuList[i].r_info and
                danmuList[i].r_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid()

            local isOur = danmuList[i].g_uid == SociatySelf.Uid


            local playerName   = danmuList[i].args[2] .. ": "

            --- 是否己方同盟
            local colorNum     = isOur and 2 or 3
            --- 是否自己
            local contentColor = MessageContentColors[isSelf and 1 or colorNum]

            local item         = {}
            item.content       ="<size=24>".. contentColor .. playerName ..
                _G.GetLangPackValue(LanguageList[danmuList[i].l_id][2]) .. "</color></size>"
            item.atlas         = atlas
            if danmuList[i].type == 1 then
                item.icon = "ui_alxzc_zcjm_piaozi_shousha"
            elseif danmuList[i].type == 2 then
                local KillNum= tonumber(danmuList[i].args[3])
                for j = 1, #self.lianshaCfg do
                    if self.lianshaCfg[j][3]==0 and self.lianshaCfg[j][1] <=KillNum then
                        item.icon=self.lianshaicon[j]
                    elseif self.lianshaCfg[j][3]==1 and self.lianshaCfg[j][1] <=KillNum and self.lianshaCfg[j][2]>=KillNum then
                        item.icon=self.lianshaicon[j]
                    end
                end
            elseif danmuList[i].type == 3 then
                item.icon = "ui_alxzc_zcjm_piaozi_zhongjie"
            end

            table.insert(danmuItemList, item)
        end
    end

    return danmuItemList
end

---初始化战场数据
---@param data guild_moba.s2c_guild_moba_fight_info
function SociatyMobaBattleModel:InitBattleData(data)
    self.SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.data = data
    if data.a_uid == 0 or data.b_uid == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("冥界纷争未开始匹配！")
        end
        self:CheckDataWildSet(data)
        self:CheckDataMarchOrder(data)
        self:InitCreepPreset(data.wild_set)
        self:InitMarchOrder(data.order_set)
        return
    end
    self.abOur = "a"
    self.abEnemy = "b"
    if data.b_uid == self.SociatySelf.Uid then
        self.abOur = "b"
        self.abEnemy = "a"
    end
    -- LogError(self.abOur)
    self.isBye = data[self.abEnemy .. "_uid"] == 1 --轮空
    self:CheckData(data)
    self:InitLanerData(data.tower_march)
    self:InitCreepTimes(data.wild_time)
    self:InitCreepData(data.wild_march)
    self:InitCreepPreset(data.wild_set)
    self:InitMarchOrder(data.order_set)
    self:InitReport(data.log)
    self:InitKillRank(data[self.abOur .. "_rank"], data[self.abEnemy .. "_rank"])
    self.unAutoUid = {}
    self.creepSelf = nil
    self.LineInfo = nil
end

---检查校验数据
---@param data guild_moba.s2c_guild_moba_fight_info
function SociatyMobaBattleModel:CheckData(data)
    if not data.tower_march then
        data.tower_march = {
            { sid = 1, state = 0, a_line_max = 0, a_line_num = 0, b_line_max = 0, b_line_num = 0 },
            { sid = 2, state = 0, a_line_max = 0, a_line_num = 0, b_line_max = 0, b_line_num = 0 },
            { sid = 3, state = 0, a_line_max = 0, a_line_num = 0, b_line_max = 0, b_line_num = 0 }
        }
    end
    if data.a_t_state then
        for _, tm in pairs(data.tower_march) do
            for _, ts in pairs(data.a_t_state) do
                if ts.sid == tm.sid then
                    tm.state = ts.state
                    tm.a_line_max = ts.l_max or 0
                    if ts.state == 0 then --为1时不做处理，全部摧毁
                        tm.a_line_num = ts.l_index or 0
                    else
                        tm.a_line_num = tm.a_line_max
                    end
                end
            end
        end
    end
    if data.b_t_state then
        for _, tm in pairs(data.tower_march) do
            for _, ts in pairs(data.b_t_state) do
                if ts.sid == tm.sid then
                    if tm.state == 0 then
                        tm.state = ts.state == 1 and 2 or 0 --理论上不可能进or
                    elseif tm.state == 1 then
                        tm.state = ts.state == 1 and 3 or 1
                    end
                    tm.b_line_max = ts.l_max or 0
                    if ts.state == 0 then --为1时不做处理，全部摧毁
                        tm.b_line_num = ts.l_index or 0
                    else
                        tm.b_line_num = tm.b_line_max
                    end
                end
            end
        end
    end

    if not data.wild_time then
        data.wild_time = {}
    end
    if not data.wild_march then
        data.wild_march = {}
        for _, cfg in pairs(_G.ConfigManager.guild_moba_campsite_cfg) do
            if cfg.type > 1 then
                _G.table.insert(
                    data.wild_march,
                    { sid = cfg.id, state = -1, a_hold = 0, b_hold = 0, args = 0, last_time = 0 }
                )
            end
        end
    end
    self:CheckDataWildSet(data)
    self:CheckDataMarchOrder(data)
end

function SociatyMobaBattleModel:CheckDataWildSet(data)
    if not data.wild_set then
        data.wild_set = {}
        for _, cfg in pairs(_G.ConfigManager.guild_moba_campsite_cfg) do
            if cfg.type > 1 then
                _G.table.insert(data.wild_set, { sid = cfg.id, use_type = 1, uids = {} })
            end
        end
    else
        local sids = {}
        for _, v in pairs(data.wild_set) do
            if not v.uids then
                v.uids = {}
            end
            _G.table.insert(sids, v.sid)
        end
        for _, cfg in pairs(_G.ConfigManager.guild_moba_campsite_cfg) do
            if cfg.type > 1 and not _G.table.ContainsValue(sids, cfg.id) then
                _G.table.insert(data.wild_set, { sid = cfg.id, use_type = 1, uids = {} })
            end
        end
    end
end

function SociatyMobaBattleModel:CheckDataMarchOrder(data)
    if not data.order_set then
        data.order_set = {}
        for i = 1, 4 do
            _G.table.insert(data.order_set, { k = i, v = 1 })
        end
    else
        local sids = {}
        for _, v in pairs(data.order_set) do
            _G.table.insert(sids, v.k)
        end
        for i = 1, 4 do
            if not _G.table.ContainsValue(sids, i) then
                _G.table.insert(data.order_set, { k = i, v = 1 })
            end
        end
    end
end

---初始化分线数据
---@param towerMarch guild_moba.i_fight_tower[]
function SociatyMobaBattleModel:InitLanerData(towerMarch)
    self.lanerOur = {}
    self.lanerEnemy = {}
    self.survivalNum = { our = 0, enemy = 0 }
    self.totalTeamNum = { our = 0, enemy = 0 }
    local laner
    if towerMarch then
        for _, v in pairs(towerMarch) do
            laner = SociatyMobaLanerData.New(self.abOur)
            laner:Parse(v)
            self.lanerOur[v.sid] = laner

            laner = SociatyMobaLanerData.New(self.abEnemy)
            laner:Parse(v)
            self.lanerEnemy[v.sid] = laner

            self.survivalNum.our = self.survivalNum.our + self:GetLanerCurTeamNum(v.sid, true)
            self.survivalNum.our = self.survivalNum.our + self:GetLanerMarchNum(v.sid, true)
            self.totalTeamNum.our = self.totalTeamNum.our + self:GetLanerMaxTeamNum(v.sid, true)

            self.survivalNum.enemy = self.survivalNum.enemy + self:GetLanerCurTeamNum(v.sid, false)
            self.survivalNum.enemy = self.survivalNum.enemy + self:GetLanerMarchNum(v.sid, false)
            self.totalTeamNum.enemy = self.totalTeamNum.enemy + self:GetLanerMaxTeamNum(v.sid, false)
        end
    end
end

---初始化野怪行军次数
---@param creepTime public.i_kv_64[]
function SociatyMobaBattleModel:InitCreepTimes(creepTime)
    self.creepTimes = {}
    for _, v in pairs(creepTime) do
        self.creepTimes[v.key] = v.value
        if v.key == _G.PlayerModel:GetInstance():GetPlayerUid() then
            require("SociatyMobaModel"):GetInstance():SetWildTimes(v.value)
        end
    end
end

---初始化野怪数据
---@param creepMarch guild_moba.i_fight_wild[]
function SociatyMobaBattleModel:InitCreepData(creepMarch)
    self.creepUid = {}
    self.creepData = {}
    self.creepUidSort = {}
    self.creepUidSortId = {}
    local data
    for _, v in pairs(creepMarch) do
        data = SociatyMobaCreepData.New(self.abOur, self.abEnemy)
        data:Parse(v)
        self.creepData[v.sid] = data
        if v["m_" .. self.abOur] then
            for _, m in pairs(v["m_" .. self.abOur]) do
                self:AddCreepUid(v.sid, m.team.uid)
                self:AddCreepUidSort(v.sid, m.team.uid)
            end
        end
        if v["m_" .. self.abEnemy] then
            for _, m in pairs(v["m_" .. self.abEnemy]) do
                self:AddCreepUidSort(v.sid, m.team.uid)
            end
        end
    end
end

---初始化野怪预设
---@param creepPreset guild_moba.i_wild_set[]
function SociatyMobaBattleModel:InitCreepPreset(creepPreset)
    self.creepPreset = {}
