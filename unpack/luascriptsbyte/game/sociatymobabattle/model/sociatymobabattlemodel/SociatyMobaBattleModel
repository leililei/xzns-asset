---设置打野预设
function SociatyMobaBattleModel:SetWildPreset(presets, setType, call, preSid)
    local presetArr = _G.table.toArray(presets)
    local pbData = { set = presetArr, set_type = setType }
    SociatyMobaNet:GetInstance():SetWildPreset(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if setType == 1 then
                self.creepPreset = presets
            elseif setType == 2 then
                _G.table.insert(self.creepPreset[presets[1].sid].uids, presets[1].uids[1])
                if preSid then
                    _G.table.removebyvalue(
                        self.creepPreset[preSid].uids,
                        presets[1].uids[1]
                    )
                end
            elseif setType == 3 then
                _G.table.removebyvalue(
                    self.creepPreset[presets[1].sid].uids,
                    _G.PlayerModel:GetInstance():GetPlayerUid()
                )
            end
            _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaCreepPresetChange)
            if call then
                call()
            end
        end
    )
end

