    local pbData = { station = id, uid = {} }
    local ssid
    for i = 1, #uidLis do
        ssid = ((i - 1) % 5 + 1) * 1000 + (i - 1) // 5 + 1
        _G.table.insert(pbData.uid, { uid = uidLis[i], s_id = ssid })
    end
    SociatyMobaNet:GetInstance():SetWildMarch(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if call then
                call(id, msg)
            end
        end
    )
end

---使用buff
---@param id number buffId
---@param line number 分路
function SociatyMobaBattleModel:SendUseBuff(id, line)
    SociatyMobaNet:GetInstance():UseBuff(
        id,
        line,
        function(msg)
            if msg.ack == 1 then
                self:GetCreepData(id).use = line
                _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaBuffChange, id)
            end
        end
    )
end

---获取个人打野队伍数据
---@param call function 回调
function SociatyMobaBattleModel:GetSelfCreepInfo(call)
    if self.creepSelf == nil then
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        require("SociatyMobaModel"):GetInstance():GetLineInfo(
            4,
            function(msg)
                if msg and msg[1] and msg[1].role then
                    for _, v in pairs(msg[1].role) do
                        if v.uid == uid then
                            self.creepSelf = v
                            break
                        end
                    end
                else
                    self.creepSelf = {}
                end
                if call then
                    call(self.creepSelf)
                end
            end
        )
    else
        if call then
            call(self.creepSelf)
        end
    end
end

---获取分路信息
---@param line number 分路
---@return table<uid,i_line_role>  table<玩家uid,i_line_role>
function SociatyMobaBattleModel:GetLineInfo(line, callback, force)
    if self.LineInfo == nil or force then
        self.LineInfo = {}
        for i = 1, 4 do
            self.LineInfo[i] = {}
        end
        SociatyMobaNet:GetInstance():GetLineInfo(
            0,
            function(msg)
                if msg.line_info then
                    for i, v in ipairs(msg.line_info) do
                        if self.LineInfo[v.line_id] == nil then
                            self.LineInfo[v.line_id] = {}
                        end
                        if v.role then
                            for k2, v2 in ipairs(v.role) do
                                self.LineInfo[v.line_id][v2.uid] = v2
                            end
                        end
                    end
                end
                local data
                if line == 0 then
                    data = self.LineInfo
                else
                    data = self.LineInfo[line]
                end
                if callback then
                    callback(data)
                end
            end
        )
    else
        local data
        if line == 0 then
            data = self.LineInfo
        else
            data = self.LineInfo[line]
        end
        if callback then
            callback(data)
        end
    end
end

---交换队伍
function SociatyMobaBattleModel:ChangeLineInfo(uid, line, line2)
    if self.LineInfo[line2][uid] then
        SociatyMobaNet:GetInstance():CommandUpdateGarry(
            { uid },
            line,
            line2,
            function(msg)
                if msg.ack == 1 then
                    local data = self.LineInfo[line][uid]
                    self.LineInfo[line][uid] = self.LineInfo[line2][uid]
                    self.LineInfo[line2][uid] = data
                    _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaTeamChange)
                end
            end
        )
    elseif _G.table.count(self.LineInfo[line2]) < 40 then
        SociatyMobaNet:GetInstance():CommandUpdateGarry(
            { uid },
            line,
            line2,
            function(msg)
                if msg.ack == 1 then
                    self.LineInfo[line2][uid] = self.LineInfo[line][uid]
                    self.LineInfo[line][uid] = nil
                    _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaTeamChange)
                end
            end
        )
    end
end

---交换队伍
function SociatyMobaBattleModel:ChangeAllLineInfo(line, line2)
    if self.LineInfo[line2] then
        local uids = {}
        for i, v in pairs(self.LineInfo[line2]) do
            if not _G.table.ContainsValue(uids, v.uid) then
                _G.table.insert(uids, v.uid)
            end
        end
        for i, v in pairs(self.LineInfo[line]) do
            if not _G.table.ContainsValue(uids, v.uid) then
                _G.table.insert(uids, v.uid)
            end
        end
        SociatyMobaNet:GetInstance():CommandUpdateGarry(
            uids,
            line,
            line2,
            function(msg)
                if msg.ack == 1 then
                    local data = self.LineInfo[line]
                    self.LineInfo[line] = self.LineInfo[line2]
                    self.LineInfo[line2] = data
                    _G.Events:GetInstance():Broadcast(_G.eSociatyMobaBattle.SociatyMobaTeamChange)
                end
            end
        )
    end
end

function SociatyMobaBattleModel:GetLinePower(line)
    local data = _G.table.toArray(self.LineInfo[line])
    _G.table.sort(
        data,
        function(a, b)
            return a.power > b.power
        end
    )
    return data[1] and data[1].power or 0
end

function SociatyMobaBattleModel:CheckLanerVictory(lanerId)
    return self.lanerOur[lanerId].state == LanerState.Victory, self.lanerEnemy[lanerId].state == LanerState.Victory
end

---获取双方最大击杀数量
function SociatyMobaBattleModel:GetKillMaxNum()
    local ourKillMax, enemyKillMax = 0, 0
    for _, v in pairs(self.rankData) do
        if v.isOur then
            if v.value > ourKillMax then
                ourKillMax = v.value
            end
        else
            if v.value > enemyKillMax then
                enemyKillMax = v.value
            end
        end
    end
    return ourKillMax, enemyKillMax
end

---获取双方最大连杀数量
function SociatyMobaBattleModel:GetSerialMaxNum()
    local ourSerialMax, enemySerialMax = 0, 0
    for _, v in pairs(self.rankData) do
        if v.isOur then
            if v.max_line_kill > ourSerialMax then
                ourSerialMax = v.max_line_kill
            end
        else
            if v.max_line_kill > enemySerialMax then
                enemySerialMax = v.max_line_kill
            end
        end
    end
    return ourSerialMax, enemySerialMax
end

