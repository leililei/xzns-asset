---计算防御塔行军参数
---@param lanerId number 线路id
---@param eTime number 到达时间
---@param isOur boolean 是否是我方
---@return boolean, number, number, number, number, number 是否在行军路上，用时，出发x， 出发y，到达x，到达y
function SociatyMobaBattleModel:CalLanerPlayerPos(lanerId, eTime, isOur)
    -- eTime = eTime / 1000
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[lanerId]
    local targetPos = isOur and cfg.battle_coordinate[1] or cfg.battle_coordinate[2]
    local delta = eTime - _G.TimeUtil.GetServerUnixTime()
    if delta <= 0 then
        return false, 0, targetPos[1], targetPos[2], targetPos[1], targetPos[2]
    end
    local index = self:GetFirstNotBrokenID(lanerId, isOur)
    local rate = delta / cfg.move_time[index]
    if rate > 1 then
        rate = 1
    end
    if not isOur then
        index = index + 3
    end
    local towerPos = cfg.coordinate[index]
    local x = towerPos[1] * rate + targetPos[1] * (1 - rate)
    local y = towerPos[2] * rate + targetPos[2] * (1 - rate)
    return true, delta, x, y, targetPos[1], targetPos[2]
end

---计算野怪行军参数
---@param sid number 野怪sid
---@param eTime number 到达时间
---@param isOur boolean 是否是我方
---@param sSid number 点位sid
---@param index number 出发次序
---@return boolean, number, number, number, number, number 是否在行军路上，用时，出发x， 出发y，到达x，到达y
function SociatyMobaBattleModel:CalCreepPlayerPos(sid, eTime, isOur, sSid, index)
    -- eTime = eTime / 1000
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[sid]
    local targetPos = isOur and cfg.battle_coordinate[1] or cfg.battle_coordinate[2]
    local delta = eTime - _G.TimeUtil.GetServerUnixTime()
    if delta <= 0 then
        return false, 0, targetPos[1], targetPos[2], targetPos[1], targetPos[2]
    end
    local id = isOur and 101678 or 101681
    local sPos = _G.ConfigManager.discrete_cfg[id][sSid]
    local totalTime = cfg.move_time[isOur and ABIndex[self.abOur] or ABIndex[self.abEnemy]]
    local rate = delta / totalTime
    if rate > 1 then
        rate = 1
    end
    if index == 1 then
        local x = sPos[1] * rate + targetPos[1] * (1 - rate)
        local y = sPos[2] * rate + targetPos[2] * (1 - rate)
        return true, delta, x, y, targetPos[1], targetPos[2]
    end
    local bia = _G.ConfigManager.discrete_cfg[101679][1][1]
    if sPos[1] == targetPos[1] then
        return true, delta, sPos[1], sPos[2] - bia, targetPos[1], targetPos[2]
    end
    local alpha = math.atan((sPos[2] - targetPos[2]) / (sPos[1] - targetPos[1]))
    index = index - 1
    local k = index * bia
    local x = (sPos[1] - k * math.cos(alpha)) * rate + targetPos[1] * (1 - rate)
    local y = (sPos[2] - k * math.sin(alpha)) * rate + targetPos[2] * (1 - rate)
    -- LogError("角度" .. alpha .. ", x偏移:" .. x .. ", y偏移:" .. y)
    return true, delta, x, y, targetPos[1], targetPos[2]
end

