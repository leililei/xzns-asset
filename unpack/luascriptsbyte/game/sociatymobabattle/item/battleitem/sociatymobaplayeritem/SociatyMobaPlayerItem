---@class SociatyMobaPlayerItem    中文描述
---@field go_table SociatyMobaBattleView._obj_player_GoTable
local SociatyMobaPlayerItem = _G.BaseClass("SociatyMobaPlayerItem", _G.Component)

local NameColor = {
    _G.ColorTools.FormatColorByString("99E1FF"),
    _G.ColorTools.FormatColorByString("FFB496")
}

---类的构造函数
function SociatyMobaPlayerItem:__init(obj, isOur, parentSortingOrder)
    self.gameObject = obj
    self.isOur = isOur
    self.sortingOrder = parentSortingOrder
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.ani = self.go_table.obj_cardItem:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.killEffs = {}
end

---@param data guild_moba.i_tower_march|guild_moba.i_wild_march
function SociatyMobaPlayerItem:Show(data)
    self.go_table.aorimage_nameBg.SpriteName = self.isOur and "ui_alxzc_zcjm_di_lan" or "ui_alxzc_zcjm_di_hong"
    local team = data.team
    self.uid = team.uid
    self.eTime = data.e_time
    self.go_table.aortext_name.text = team.name
    self.go_table.aortext_name.color = self.isOur and NameColor[1] or NameColor[2]
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        self.go_table.obj_card,
        function(item)
            if self.gameObject == nil then
                _G.DestroyObject(item.gameObject)
                item = nil
                return
            end
            item:Show(team.card_sid, nil, team.star, team.soul_lv, team.card_lv, nil, nil, team.soul_state, team.telnet)
        end
    )
end

function SociatyMobaPlayerItem:SetRotation(z)
    if not self.isOur then
        z = 180 + z
    end
    self.go_table.obj_cardParent:SetLocalEulerAngles(0, 0, z)
    self.go_table.obj_card:SetLocalEulerAngles(0, 0, -z)
    self.go_table.obj_canvas:SetLocalEulerAngles(0, 0, -z)
    self.go_table.obj_hertEff:SetLocalEulerAngles(0, 0, -z)
    self.go_table.obj_killEff:SetLocalEulerAngles(0, 0, -z)
end

function SociatyMobaPlayerItem:SetPosition(x, y)
    self.gameObject:SetLocalPosition(x, y, 0)
end

function SociatyMobaPlayerItem:SetIndex(sSid, index)
    self.sSid = sSid
    self.index = index
end

