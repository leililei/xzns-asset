function SociatyMobaPlayerItem:PlayDestroyEff()
end

function SociatyMobaPlayerItem:PlaySettlementEff(call)
    self.go_table.aorimage_mask:SetActiveE(1)
    self.go_table.aorimage_dead:SetActiveE(1)
    _G.DelayDo(
        0.5,
        function()
            if self.gameObject then
                _G.DestroyObject(self.gameObject)
            end
            self:Dispose()
            if call then
                call()
            end
        end
    )
end

function SociatyMobaPlayerItem:PlayKillNumEff(num)
    local stage = 0
    local cfg
    if num >= 8 then
        cfg = _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_gao
        stage = 3
    elseif num >= 6 then
        cfg = _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_zhong
        stage = 2
    elseif num >= 3 then
        cfg = _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_di
        stage = 1
    end
    for i = 1, 3 do
        if i == stage then
            if self.killEffs[stage] == nil then
                self.killEffs[stage] = true
                _G.UIUtils.LoadEffectByCfg(
                    cfg,
                    self.go_table.obj_killEff,
                    function(trans)
                        if self.go_table == nil then
                            _G.DestroyObject(trans)
                            return
                        end
                        self.killEffs[stage] = trans
                    end
                )
            end
        else
            if self.killEffs[i] and self.killEffs[i] ~= true then
                self.killEffs[i]:SetActiveE(0)
            end
        end
    end
end

function SociatyMobaPlayerItem:DoAttack()
    self.ani:Play("a_SociatyMobaBattleView_gongji", 0, 0)
    if self.atkEff == nil then
        self.atkEff = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_gongji,
            self.go_table.obj_bEff,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                self.atkEff = trans
            end
        )
    elseif self.atkEff ~= true then
        _G.DelayDo(
            0.25,
            function()
                if self.go_table == nil then
                    return
                end
                self.atkEff:SetActiveE(0)
                self.atkEff:SetActiveE(1)
            end
        )
    end
end

function SociatyMobaPlayerItem:DelayDoAttack(time)
    if time == 0 then
        self:DoAttack()
    else
        _G.DelayDo(
            time,
            function()
                if self.go_table == nil then
                    return
                end
                self:DoAttack()
            end
        )
    end
end

