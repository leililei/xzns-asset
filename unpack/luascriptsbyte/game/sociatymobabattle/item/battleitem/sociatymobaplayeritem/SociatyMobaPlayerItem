function SociatyMobaPlayerItem:MoveTo(x, y, time, call)
    self.targetX = x
    self.targetY = y
    self.go_table.transform:DOLocalMove(x, y, 0, time):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
        function()
            self.arrived = true
            if call then
                call()
            end
        end
    )
end

function SociatyMobaPlayerItem:ShowMarchLine(x, y, time)
    self.showLine = true
    self.lineRenderer = self.go_table.obj_marchLine:GetComponentE(_G.typeof(_G.CS.UnityEngine.LineRenderer))
    self.lineRenderer.sortingOrder = self.sortingOrder + 1
    self.go_table.obj_marchLine:SetActiveE(1)
    self.pos = {x = x, y = y}
    self.positions = {_G.Vector3.New(x, y, 0), _G.Vector3.New(0, 0, 0)}
    -- self:FixUpdate()
    -- _G.UpdateManager:GetInstance():AddUpdate(self.FixUpdate, self)

    local x1, y1, z1 = self.gameObject:GetLocalPosition()
    self.dtX =
        _G.DOTween.To(
        function(x)
            self.positions[1].x = x
            self.lineRenderer:SetPositions(self.positions)
        end,
        self.positions[1].x - x1,
        0,
        time
    ):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.dtY =
        _G.DOTween.To(
        function(x)
            self.positions[1].y = x
            self.lineRenderer:SetPositions(self.positions)
        end,
        self.positions[1].y - y1,
        0,
        time
    ):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

function SociatyMobaPlayerItem:HideMarchLine()
    self.showLine = false
    self.go_table.obj_marchLine:SetActiveE(0)
    if self.dtX then
        self.dtX:Kill()
        self.dtX = nil
    end
    if self.dtY then
        self.dtY:Kill()
        self.dtY = nil
    end
end

function SociatyMobaPlayerItem:FixUpdate()
    local x, y, z = self.gameObject:GetLocalPosition()
    self.positions[1]:Set(self.pos.x - x, self.pos.y - y, 0)
    self.lineRenderer:SetPositions(self.positions)
end

function SociatyMobaPlayerItem:OnClickBtn()
end

---类的析构函数
function SociatyMobaPlayerItem:Dispose()
    -- _G.UpdateManager:GetInstance():RemoveUpdate(self.FixUpdate, self)
    if self.DtRotate then
        self.DtRotate:Kill()
        self.DtRotate = nil
    end
    if self.dtX then
        self.dtX:Kill()
        self.dtX = nil
    end
    if self.dtY then
        self.dtY:Kill()
        self.dtY = nil
    end
    self.go_table = nil
    self.uid = nil
end

return SociatyMobaPlayerItem
