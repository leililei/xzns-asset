---@class SociatyMobaTowerItem    中文描述
---@field go_table SociatyMobaBattleView._obj_tower_GoTable
local SociatyMobaTowerItem = _G.BaseClass("SociatyMobaTowerItem", _G.Component)

---类的构造函数
function SociatyMobaTowerItem:__init(obj, sid, towerId, isOur)
    self.gameObject = obj
    self.sid = sid
    self.towerId = towerId
    self.isOur = isOur
    self.stateEnum = require("SociatyMobaModel"):GetInstance().SociatyMobaBattleState
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---@param data guild_moba.i_fight_tower
function SociatyMobaTowerItem:Show(state)
    self.data = require("SociatyMobaBattleModel"):GetInstance():GetLanerData(self.sid, self.isOur)
    -- local cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
    local index = self.isOur and self.towerId or self.towerId + 3

    if self.data == nil then
        local cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
        self.go_table.aorrawimage_icon:LoadImage(
            cfg.icon[1][index],
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetNativeSize()
                self.go_table.aorrawimage_icon:SetGray(false)
            end
        )
        self.go_table.aorimage_teamNum:SetActiveE(0)
        self.go_table.aortext_teamNum.text = ""
        self:LoadEffect()
        return
    end
    self.hasDestroy = self.data:CheckTowerIsBroken(self.towerId)
    self.go_table.aorrawimage_icon:LoadImage(
        self.data.cfg.icon[self.hasDestroy and 2 or 1][index],
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
            self.go_table.aorrawimage_icon:SetGray(self.hasDestroy)
        end
    )
    self:LoadEffect()
    self:UpdateShow(state)
end

function SociatyMobaTowerItem:LoadEffect()
    -- local effCfg =
    --     self.isOur and _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_lan or
    --     _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_hong
    -- _G.UIUtils.LoadEffectByCfg(
    --     effCfg,
    --     self.go_table.obj_eff,
    --     function(trans)
    --         if self.go_table == nil then
    --             _G.DestroyObject(trans)
    --             return
    --         end
    --         self.towerEff = trans
    --         self.towerEff:SetActiveE(self.hasDestroy and 0 or 1)
    --     end
    -- )

    local marchCfg =
        self.isOur and _G.ConfigManager.ui_effect_cfg.ef_lanjudian or
        _G.ConfigManager.ui_effect_cfg.ef_hongsejudian
    _G.UIUtils.LoadEffectByCfg(
        marchCfg,
        self.go_table.obj_eff,
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
                return
            end
            self.marchEff = trans
            local isCur =
                require("SociatyMobaBattleModel"):GetInstance():GetFirstNotBrokenID(self.sid, self.isOur) ==
                self.towerId
            local inBattle = require("SociatyMobaBattleModel"):GetInstance():CheckInBattle()
            self.marchEff:SetActiveE((inBattle and isCur and not self.hasDestroy) and 1 or 0)
        end
    )
end

function SociatyMobaTowerItem:UpdateMarchEff(isBroken)
    isBroken = isBroken or self.hasDestroy
    if self.marchEff then
        local isCur =
            require("SociatyMobaBattleModel"):GetInstance():GetFirstNotBrokenID(self.sid, self.isOur) == self.towerId
        self.marchEff:SetActiveE((isCur and not isBroken) and 1 or 0)
    end
end

function SociatyMobaTowerItem:HideMarchEff()
    if self.marchEff then
        self.marchEff:SetActiveE(0)
    end
end

function SociatyMobaTowerItem:UpdateShow(state)
    local num = require("SociatyMobaBattleModel"):GetInstance():GetTowerCurTeamNum(self.sid, self.towerId, self.isOur)
    self.go_table.aorimage_teamNum:SetActiveE(state == self.stateEnum.Fighting and 1 or 0)
    self.go_table.aortext_teamNum.text = _G.GetLangPackValue(90031700023, num)
    self:UpdateMarchEff()
end

function SociatyMobaTowerItem:ShowBuffEffect(effCfg,callback)
    _G.UIUtils.LoadEffectByCfg(effCfg,self.go_table.obj_effBg,callback)
end

function SociatyMobaTowerItem:ShowPrepareTeamNum()
    if not self.isOur then
        return
    end
    if self.data == nil then
        return
    end
    local teamSize = self.data.cfg.team[self.data.ABIdx]
    require("SociatyMobaBattleModel"):GetInstance():GetLineInfo(
        self.sid,
        function(data)
            local totalNum = _G.table.count(data)
            local sum = 0
            local num = 0
            for i = 1, self.towerId - 1 do
                sum = sum + teamSize[i]
            end
            if totalNum <= sum then
                num = 0
            elseif self.towerId == #teamSize then
                num = totalNum - sum
            elseif totalNum - num < teamSize[self.towerId] then
                num = totalNum - sum
            else
                num = teamSize[self.towerId]
            end
            self.go_table.aorimage_teamNum:SetActiveE(0) --战前隐藏
            self.go_table.aortext_teamNum.text = _G.GetLangPackValue(90031700023, num)
        end
    )
end

function SociatyMobaTowerItem:RebuildShow()
    self.data = require("SociatyMobaBattleModel"):GetInstance():GetLanerData(self.sid, self.isOur)
    local index = self.isOur and self.towerId or self.towerId + 3
    if self.data == nil then
        self.go_table.aorimage_teamNum:SetActiveE(0)
        self.go_table.aortext_teamNum.text = ""
        local cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
        self.go_table.aorrawimage_icon:LoadImage(cfg.icon[1][index])
        self.go_table.aorrawimage_icon:SetGray(false)
        self.hasDestroy = false
        -- if self.towerEff then
        --     self.towerEff:SetActiveE(1)
        -- end
        self:HideMarchEff()
    else
        local isBroken = self.data:CheckTowerIsBroken(self.towerId)
        self.go_table.aorrawimage_icon:LoadImage(self.data.cfg.icon[isBroken and 2 or 1][index])
        self.go_table.aorrawimage_icon:SetGray(isBroken)
        self.hasDestroy = isBroken
        -- if self.towerEff then
        --     self.towerEff:SetActiveE(isBroken and 0 or 1)
        -- end
        self:UpdateMarchEff(isBroken)
    end
end

function SociatyMobaTowerItem:SetPosition(x, y)
    local index = self.isOur and self.towerId or self.towerId + 3
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
    -- local pos = self.data.cfg.coordinate[index]
    local pos = cfg.coordinate[index]
    self.gameObject:SetLocalPosition(pos[1], pos[2], pos[3])
end

function SociatyMobaTowerItem:PlayDestroyEff()
    self.go_table.aortext_teamNum.text = _G.GetLangPackValue(90031700023, 0)
    if not self.hasDestroy then
        if self.boomEff == nil then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaBattleView_baozha,
                self.go_table.obj_eff,
                function(trans)
                    if self.go_table == nil then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.boomEff = trans
                end
            )
        else
            self.boomEff:SetActiveE(0)
            self.boomEff:SetActiveE(1)
        end
        local index = self.isOur and self.towerId or self.towerId + 3
        self.go_table.aorrawimage_icon:LoadImage(self.data.cfg.icon[2][index])
        self.go_table.aorrawimage_icon:SetGray(true)
        self.hasDestroy = true
        -- if self.towerEff then
        --     self.towerEff:SetActiveE(0)
        -- end
        self:HideMarchEff()
    end
end

function SociatyMobaTowerItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_tower then
        if not self.hasDestroy then
            _G.PopWindowManager:GetInstance():ShowAllTips(self.isOur and 950107 or 950106)
        end
    end
end

---类的析构函数
function SociatyMobaTowerItem:Dispose()
end

return SociatyMobaTowerItem
