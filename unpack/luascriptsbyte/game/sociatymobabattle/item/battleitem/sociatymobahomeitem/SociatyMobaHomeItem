---@class SociatyMobaHomeItem    中文描述
---@field go_table SociatyMobaBattleView._obj_home_GoTable
---@field data guild_moba.i_guild_info
local SociatyMobaHomeItem = _G.BaseClass("SociatyMobaHomeItem", _G.Component)

local Build = {
    "ImagesH5/nSociatyMoba/guild_moba_lianmeng",
    "ImagesH5/nSociatyMoba/guild_moba_buluo"
}

---类的构造函数
function SociatyMobaHomeItem:__init(obj, isOur)
    self.gameObject = obj
    self.isOur = isOur
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function SociatyMobaHomeItem:Show()
    self.data = require("SociatyMobaBattleModel"):GetInstance():GetHomeData(self.isOur)
    self.go_table.aorrawimage_baseHome:LoadImage(
        self.isOur and Build[1] or Build[2],
        function(trans)
            if self.go_table == nil then
                return
            end
            self.go_table.aorrawimage_baseHome:SetNativeSize()
        end
    )
    if self.data == nil then
        if self.isOur then
            self.go_table.obj_infoBg:SetActiveE(1)
            --- ZHJ-35729 隐藏段位显示
            local sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
            self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[sociatySelf.Banner].portrait)
            self.go_table.aortext_name.text = sociatySelf.Name
        else
            self.go_table.obj_infoBg:SetActiveE(0)
            --self.go_table.aortext_name.text = ""
            -- self.gameObject:SetActiveE(0)
        end
        return
    end
    self.gameObject:SetActiveE(1)
    self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[self.data.brana].portrait)
    self.go_table.aortext_name.text = self.data.guild_name
    --- ZHJ-35729 隐藏段位显示
    self:UpdateShow()
    self:LoadEff()
end


function SociatyMobaHomeItem:LoadEff()
    self.go_table.obj_effBg:RemoveAllChildren()
    local effCfg = self.isOur and _G.ConfigManager.ui_effect_cfg.ef_dabenying_lan or _G.ConfigManager.ui_effect_cfg.ef_dabenying_hong
    _G.UIUtils.LoadEffectByCfg(
        effCfg,
        self.go_table.obj_effBg,
        function (obj)
            if not self.go_table then
                _G.UIUtils.RemoveChildren(obj)
                return
            end
        end
    )

end

function SociatyMobaHomeItem:HideName()
    self.go_table.aortext_name.text = ""
end

function SociatyMobaHomeItem:UpdateShow()
    self.data = require("SociatyMobaBattleModel"):GetInstance():GetHomeData(self.isOur)
    -- self.go_table.aortext_record.text = _G.GetLangPackValue(90031700021, self.data.season_win, self.data.season_fail)
end

function SociatyMobaHomeItem:SetPosition(x, y)
    ---525-181.5
    self.gameObject:SetLocalPosition(x, y, 0)
end

function SociatyMobaHomeItem:PlayDestroyEff()
end

function SociatyMobaHomeItem:OnClickBtn()
end

---类的析构函数
function SociatyMobaHomeItem:Dispose()
end

return SociatyMobaHomeItem
