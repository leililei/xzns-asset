---类的构造函数
function SociatyMobaCreepItem:__init(obj, sid, call)
    self.gameObject = obj
    self.sid = sid
    self.call = call
    self.countDown = 0
    self.creepState = require("SociatyMobaBattleModel").CreepState
    self.cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function SociatyMobaCreepItem:Show()
    local model = require("SociatyMobaBattleModel"):GetInstance()
    self.data = model:GetCreepData(self.sid)
    local cfg = {}
    local isPreview = false
    if self.data == nil then
        --self.gameObject:SetActiveE(0)
        --return
        isPreview = true
        --ZHJH-7609 未匹配时也显示野怪
        cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
    else
        cfg = self.data.cfg
    end
    self.gameObject:SetActiveE(1)
    -- self.go_table.aorimage_frame.SpriteName = FrameName[self.data.cfg.type]
    self.go_table.aorrawimage_icon:LoadImage(
        cfg.icon[1][1],
        function(trans)
            if self.go_table == nil then
                return
            end
            self.go_table.aorrawimage_icon:SetNativeSize()
        end
    )
    -- self.go_table.aorimage_nameBg.SpriteName = NameBackground[self.data.cfg.type]
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.name[1][1])
    if not isPreview then
        self.go_table.slider_blue.value = self.data:GetOurProcess()
        self.go_table.slider_red.value = self.data:GetEnemyProcess()
    end
    self:ShowOrHideDetail(false)
    self:UpdateShow(isPreview)
    self:LoadEff()
end

function SociatyMobaCreepItem:LoadEff()
    if self.sid == 4 then
        -- 伐木场
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jumuchang,
            self.go_table.obj_eff,
            function(obj)
                if not self.go_table then
                    _G.UIUtils.RemoveChildren(obj)
                    return
                end
            end
        )
    elseif self.sid == 5 then
        -- 矿场
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_caikuangchang,
            self.go_table.obj_eff,
            function(obj)
                if not self.go_table then
                    _G.UIUtils.RemoveChildren(obj)
                    return
                end
            end
        )
    elseif self.sid == 6 then
        -- 铁匠铺
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_tiejiangpu,
            self.go_table.obj_eff,
            function(obj)
                if not self.go_table then
                    _G.UIUtils.RemoveChildren(obj)
                    return
                end
            end
        )
    end
end

function SociatyMobaCreepItem:UpdateShow(isPreview)
    self.data = require("SociatyMobaBattleModel"):GetInstance():GetCreepData(self.sid)
    if not isPreview then
        -- self.go_table.aortext_blueNum.text = self.data:GetArriveTeamNum(true)
        -- self.go_table.aortext_redNum.text = self.data:GetArriveTeamNum()
        local totalNum = self.data:GetArriveTeamNum(true) + self.data:GetArriveTeamNum()
        self.go_table.aortext_totalNum.text = _G.GetLangPackValue(90031700251, totalNum)
    else
        local cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
        local minute = string.format("%02d", cfg.resource_time // 60)
        local second = string.format("%02d", cfg.resource_time % 60)
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90031700236, minute, second)
        self.go_table.aortext_tip.text = ""
        return
    end

    local state = self.data.state
    if state == self.creepState.Idle then
        local minute = string.format("%02d", self.data.cfg.resource_time // 60)
        local second = string.format("%02d", self.data.cfg.resource_time % 60)
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90031700217, minute, second)
        self.go_table.aortext_tip.text = ""
    elseif state == self.creepState.UnRefresh then
        self.countDown =
            require("SociatyMobaModel"):GetInstance():GetBattleStartTime() + self.data.cfg.resource_time -
            _G.TimeUtil.GetServerUnixTime()
        self:UpdateTime(0)
    elseif state == self.creepState.NoOccupy then
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700094)
    elseif state == self.creepState.OurOccupy then
        -- self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700092, self.rate, self.countDown)
        self.rate, self.countDown = self.data:GetOurWinTime()
        self.rate = self.rate * 100 .. "%"
        self:UpdateTime(0)
    elseif state == self.creepState.EnemyOccupy then
        -- self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700093, self.countDown)
        self.rate, self.countDown = self.data:GetEnemyWinTime()
        self.rate = self.rate * 100 .. "%"
        self:UpdateTime(0)
    elseif state == self.creepState.InBattle then
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700095)
        self:LoadFightEffect()
    elseif state == self.creepState.OurWin then
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700240)
    elseif state == self.creepState.EnemyWin then
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700241)
    end
    self.go_table.obj_inBattle:SetActiveE(state == self.creepState.InBattle and 1 or 0)
    self.go_table.obj_countDown:SetActiveE(
        (state == self.creepState.UnRefresh or state == self.creepState.Idle) and 1 or 0
    )
    -- self.go_table.obj_normal:SetActiveE(state == self.creepState.UnRefresh and 0 or 1)
    self.go_table.aorimage_tipBg:SetActiveE((self.showDetail or state == self.creepState.OurWin or state == self.creepState.EnemyWin) and 1 or 0)
    self.needPointer =
        state == self.creepState.NoOccupy or state == self.creepState.OurOccupy or state == self.creepState.EnemyOccupy or
        state == self.creepState.InBattle
end

