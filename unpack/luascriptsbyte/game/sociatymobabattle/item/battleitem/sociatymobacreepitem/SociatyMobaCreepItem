function SociatyMobaCreepItem:ShowOrHideDetail(isShow)
    self.showDetail = isShow
    if self.data then
        self.go_table.aorimage_tipBg:SetActiveE((self.showDetail or self.data.state == self.creepState.OurWin or self.data.state == self.creepState.EnemyWin) and 1 or 0)
    end
    -- self.go_table.obj_teamNum:SetActiveE(isShow and 1 or 0)
    self.go_table.obj_slider:SetActiveE(0)
    self.go_table.aorimage_countDownBg:SetActiveE(isShow and 0 or 1)
    self.go_table.aorimage_nameBg:SetActiveE(isShow and 0 or 1)
end

function SociatyMobaCreepItem:SetPosition(x, y)
    local cfg = _G.ConfigManager.guild_moba_campsite_cfg[self.sid]
    -- local pos = self.data.cfg.coordinate[1]
    local pos = cfg.coordinate[1]
    self.gameObject:SetLocalPosition(pos[1], pos[2], pos[3])
end

function SociatyMobaCreepItem:PlayDestroyEff()
end

function SociatyMobaCreepItem:UpdateTime(elapsed)
    if self.data == nil then
        return
    end
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    self.go_table.obj_slider:SetActiveE(0)
    if self.data.state == self.creepState.UnRefresh then
        local countDown = _G.Mathf.RoundToInt(self.countDown)
        local time = _G.TimeUtil.TransDayHourMineMiao(countDown)
        local minute = string.format("%02d", countDown // 60)
        local second = string.format("%02d", countDown % 60)
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90031700217, minute, second)
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700098, time)
    elseif self.data.state == self.creepState.OurOccupy then
        -- self.go_table.obj_slider:SetActiveE(1)
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700092)
    elseif self.data.state == self.creepState.EnemyOccupy then
        -- self.go_table.obj_slider:SetActiveE(1)
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90031700093)
    elseif self.data.state == self.creepState.InBattle then
    -- self.go_table.obj_slider:SetActiveE(1)
    end
    local isEnd = self.data.state == self.creepState.OurWin or self.data.state == self.creepState.EnemyWin
    self.go_table.aorrawimage_icon:SetGray(isEnd)
    self.go_table.aorimage_frame:SetGray(isEnd)
end

function SociatyMobaCreepItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_showDetail then
        self.data = require("SociatyMobaBattleModel"):GetInstance():GetCreepData(self.sid)
        if self.data == nil then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                UnfreshTip[self.cfg.type],
                nil,
                nil,
                nil,
                nil,
                nil,
                self.cfg.resource_time
            )
            return
        end
        if self.data.state == self.creepState.Idle or self.data.state == self.creepState.UnRefresh then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                UnfreshTip[self.data.cfg.type],
                nil,
                nil,
                nil,
                nil,
                nil,
                self.data.cfg.resource_time
            )
            self:ShowOrHideDetail(false)
        elseif self.data.state == self.creepState.OurWin or self.data.state == self.creepState.EnemyWin then
            local name = _G.GetLangPackValue(self.data.cfg.name[1][1])
            local homeData =
                require("SociatyMobaBattleModel"):GetInstance():GetHomeData(self.data.state == self.creepState.OurWin)
            local sociatyName = homeData and homeData.guild_name or ""
            local lanerName = LanerName[self.data.cfg.effect[4]] or ""
            _G.PopWindowManager:GetInstance():ShowAllTips(950124, nil, nil, nil, nil, nil, name, sociatyName, lanerName)
            self:ShowOrHideDetail(false)
        else
            -- if self.showDetail then
            --     if self.call then
            --         self.call(self.sid, _G.handlerbind(self, self.ShowOrHideDetail, false))
            --     end
            -- end
            _G.PopWindowManager:GetInstance():ShowAllTips(WaitWinTip[self.data.cfg.type])
            self:ShowOrHideDetail(not self.showDetail)
        end
    end
end

function SociatyMobaCreepItem:LoadFightEffect()
    if not self.fightEff then
        self.fightEff = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jiaozhan,
            self.go_table.obj_fightEff,
            function(tran)
                if not self.go_table then
                    _G.DestroyObject(tran)
                    return
                end
                self.fightEff = tran
            end
        )
    end
end

---类的析构函数
function SociatyMobaCreepItem:Dispose()
    if self.doTween then
        self.doTween:Kill()
        self.doTween = nil
    end
end

return SociatyMobaCreepItem
