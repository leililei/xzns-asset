---@param cardid number 卡牌是升星解锁购买
---@param star number 卡牌的星级
function TrainHeroMegganModel:ExternalUnLockHero(cardid, star)
    if not self.isActivity then
        return
    end
    local flag = false
    for i = 1, #self.HeroMeggan_lists do
        local car_id = self.HeroMeggan_lists[i].card_id
        if car_id == cardid then
            --检测是否 已经解锁
            if self.HeroMeggan_lists[i].isLock then
                --return
            else
                --检测条件
                if star >= self.HeroMeggan_lists[i].cfg.condition[2] then
                    self.HeroMeggan_lists[i].isPay_buy = true
                    self.HeroMeggan_lists[i].isLock = true
                    local sid = self.HeroMeggan_lists[i].cfg.sid
                    if self.can_award == nil then
                        self.can_award = {}
                    end
                    _G.table.insert(self.can_award, sid)

                    --刷新红点
                    self.activity.typeClass:UpdateRedpoint()
                    --向服务器发送数据  改标记为  解锁的状态
                    require "ActivitySynNet":GetInstance():GetAward(
                        self.activity:GetActivityID(),
                        {sid, 1},
                        function(data)
                            if data.ack ~= 1 then
                                return
                            end

                            if _G.AppSetting.DEBUG then
                                _G.Log("标记升星解锁")
                            end
                        end
                    )
                --return
                end
            end
        end
    end
    if not flag then
        return
    end
end
