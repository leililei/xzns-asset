---@field info activity_cfg_one_cash.i_one_cash_info
function TrainHeroMegganModel:InitFunction()
    self:InitHeroMegganData(self.cfg_data, self.curActivityClass)
end
---初始化数据
---@param cfg_data table 服务器下发的数据
---@field sid number 档次id
---@field condition_params table 领奖参数{卡牌sid，卡牌星级}
---@field rewards_normal table 免费奖励 {{12，200},{12,300}}
---@field rewards_pay table 付费奖励 {{12，500},{12,600}}
---@field price number 消费人民币
---@field count_limit number 限制购买次数
function TrainHeroMegganModel:InitHeroMegganData(cfgdata, activity)
    self.activity = activity
    if cfgdata == nil then
        return
    end
    local data = {}
    for i = 1, #cfgdata do
        local t_data = {
            sid = cfgdata[i].sid,
            count_limit = cfgdata[i].count_limit,
            rewards_normal = cfgdata[i].normal_award, --{type = {12,20}} 内部结构
            rewards_pay = cfgdata[i].pay_award, --{type = {12,20}}内部结构
            card_id = 111010000,
            condition = cfgdata[i].condition,
            price = cfgdata[i].price
        }
        if cfgdata[i].pos_portrait then
            self.pos_portrait = cfgdata[i].pos_portrait --立绘偏转（x#y#z） then
        end

        _G.table.insert(data, t_data)
    end

    self:NeatenHeroMegganData(data)
    HeroMegganModel:GetInstance():SetAcitivitys(self.curActivityClass)
end
---整理数据
---@param externaldata table 外部传入的数据
function TrainHeroMegganModel:NeatenHeroMegganData(externaldata)
    self.HeroMeggan_lists = {}
    for i = 1, #externaldata do
        local data = {
            cfg = externaldata[i],
            card_id = 0,
            isfree = false, --是否已领取奖励（免费）
            isPay = false, --购买是否已经没有次数
            isLock = false, --是否解锁
            --是否解锁购买
            pay_buy_num = 0 --剩余购买的次数
        }
        data.card_id = externaldata[i].condition[1]
        data.isfree = self:CheckFreeAward(externaldata[i].sid)
        --查看是否解锁购买
        data.isLock =
            self:CheckUnlockBuy(externaldata[i].condition[1], externaldata[i].condition[2], externaldata[i].sid)
        --检测是否购买，购买的次数
        local flag, buy_times = self:CheckPayBuyTime(externaldata[i].sid)
        if not flag then
            data.isPay = false
            data.pay_buy_num = externaldata[i].count_limit
        else
            data.pay_buy_num = externaldata[i].count_limit - buy_times
            data.isPay = data.pay_buy_num == 0
        end
        _G.table.insert(self.HeroMeggan_lists, data)
    end
    self.isActivity = true
end
---查看是否解锁
---@param cardid number 卡牌sid
---@param condition number 卡牌限制的条件 星级
---@param sid number 检测 sid
function TrainHeroMegganModel:CheckUnlockBuy(cardid, condition, sid)
    --先检测（是不是历史的最大值）
    local flag = false
    --检测有没有免费领取
    if _G.table.isEmptyOrNil(self.a_list) or self.a_list == nil then
    else
        for i = 1, #self.a_list do
            if self.a_list[i] == sid then
                return true
            end
        end
    end
    --现金购买过
    if _G.table.isEmptyOrNil(self.card_info) or self.card_info == nil then
    else
        for i = 1, #self.card_info do
            if self.card_info[i].id == sid then
                return true
            end
        end
    end
    --是不有预完成
    if self.can_award then
        for i = 1, #self.can_award do
            if self.can_award[i] == sid then
                return true
            end
        end
    end
    --查找仓库卡牌是否可以解锁
    local cards = _G.StorageManager:GetInstance():GetCardDataSortList()
    for i = 1, #cards do
        if cardid == cards[i].sid and cards[i].star >= condition then
            return true
        end
    end
    return false
end
---检测付费购买的次数
function TrainHeroMegganModel:CheckPayBuyTime(id)
    if _G.table.isEmptyOrNil(self.card_info) or self.card_info == nil then
        return false, 0
    end
    for i = 1, #self.card_info do
        if self.card_info[i].id == id then
            return true, self.card_info[i].buy_times
        end
    end
    return false, 0
end
---检测免费的道具是否领取
---@param id number 档次id
function TrainHeroMegganModel:CheckFreeAward(id)
    if _G.table.isEmptyOrNil(self.a_list) or self.a_list == nil then
        return false
    end
    for i = 1, #self.a_list do
        if self.a_list[i] == id then
            return true
        end
    end
    return false
end

