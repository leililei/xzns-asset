function TrainHeroMegganModel:CheckRedpoint()
    if not self.isActivity then --活动未解锁，或者是活动已经结束
        return false
    end
    for i = 1, #self.HeroMeggan_lists do
        if not self.HeroMeggan_lists[i].isfree and self.HeroMeggan_lists[i].isLock then
            return true
        end
    end
    return false
end
--领取奖励
function TrainHeroMegganModel:LinquFree(a_id, id, call)
    require "ActivitySynNet":GetInstance():GetAward(
        a_id,
        {self.HeroMeggan_lists[id].cfg.sid, 0},
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.table.insert(self.a_list, self.HeroMeggan_lists[id].cfg.sid)
            self.HeroMeggan_lists[id].isfree = true
            ---放入仓库
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self:UpdateRedpoint()
            if call then
                call()
            end
        end
    )
end

function TrainHeroMegganModel:OnMallCashListener(data)
    local id = 0
    for key, value in pairs(self.HeroMeggan_lists) do
        if value.cfg.sid == data.sid then
            id = key
            break
        end
    end
    if id > 0 then
        ---检测是否购买过
        local flag = false
        if _G.table.isEmptyOrNil(self.card_info) then
            _G.table.insert(self.card_info, {id, 1})
        else
            for i = 1, #self.card_info do
                if self.card_info[i].id == id then
                    self.card_info[i].buy_times = self.card_info[i].buy_times + 1
                    flag = true
                    break
                end
            end
            if not flag then
                _G.table.insert(self.card_info, {id, 1})
            end
        end
        self.HeroMeggan_lists[id].pay_buy_num = self.HeroMeggan_lists[id].pay_buy_num - 1
        self.HeroMeggan_lists[id].isPay = self.HeroMeggan_lists[id].pay_buy_num == 0
    end
end

