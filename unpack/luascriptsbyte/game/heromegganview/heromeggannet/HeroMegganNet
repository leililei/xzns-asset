local base = require("BaseGameNet")

---@class HeroMegganNet : BaseGameNet	通信协议
local HeroMegganNet = _G.BaseClass("HeroMegganNet", base)
---@return HeroMegganNet HeroMegganNet
function HeroMegganNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function HeroMegganNet:AccessGetAward(pbData, callback1)
    local item = _G.ConfigManager.net_map.game_gm_store_card_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback1
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function HeroMegganNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return HeroMegganNet
