---创建对象时,入口构造函数
---@param cardid number 用来展示卡牌立绘，名字
---@param a_list number 免费领取的id
---@param card_info table 已经领取的档次 （付费的 id = 档次，buy_times = 购买的次数）
---@param HeroMegganEnum number 获得的类型 GM ，赛季，开服活动
---@param isActivity boolean 判断活动是否开启
function HeroMegganModel:__init()
    self.allActivitys = {}
end
---设置活动
function HeroMegganModel:SetAcitivitys(activity)
    _G.table.insert(self.allActivitys, activity)
end
---销毁对象时,析构函数
function HeroMegganModel:Dispose()
    self.allActivitys = nil
end
---@param cardid number 卡牌是升星解锁购买
---@param star number 卡牌的星级
function HeroMegganModel:ExternalUnLockHero(cardid, star)
    if _G.table.isEmptyOrNil(self.allActivitys) then
        return
    end
    for i = 1, #self.allActivitys do
        self.allActivitys[i].typeClass:ExternalUnLockHero(cardid, star)
    end
end
--endrgon
return HeroMegganModel
