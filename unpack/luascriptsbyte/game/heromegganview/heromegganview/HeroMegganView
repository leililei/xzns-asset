function HeroMegganView:ItemOnclick(go, ison, data, ind)
    if go:GetName() == "@_aorbtn_left" then
        if not data.isLock then
            local ordername = require "CardInfoManager":GetInstance():GetOrderStarCount(data.cfg.condition[2])
            local star = data.cfg.condition[2] - card_order_star[ordername]
            if star == 0 then
                local yanse = GetLangPackValue(card_order_tips[ordername])
                _G.PopWindowManager:GetInstance():ShowAllTips(3604, nil, nil, nil, nil, nil, yanse)
            else
                local yanse2 = _G.LangUtil.TryGetLangValue(card_order_Name[ordername])
                _G.PopWindowManager:GetInstance():ShowAllTips(3605, nil, nil, nil, nil, nil, yanse2, star)
            end
            return
        end
        self.activity_data.typeClass:LinquFree(
            self.activity_data:GetActivityID(),
            ind,
            function()
                self:IninScorll()
            end
        )
    elseif go:GetName() == "@_aorbtn_right" then
        if not data.isLock then
            local ordername = require "CardInfoManager":GetInstance():GetOrderStarCount(data.cfg.condition[2])
            local star = data.cfg.condition[2] - card_order_star[ordername]
            if star == 0 then
                local yanse = GetLangPackValue(card_order_tips[ordername])
                _G.PopWindowManager:GetInstance():ShowAllTips(3604, nil, nil, nil, nil, nil, yanse)
            else
                local yanse2 = _G.LangUtil.TryGetLangValue(card_order_Name[ordername])
                _G.PopWindowManager:GetInstance():ShowAllTips(3605, nil, nil, nil, nil, nil, yanse2, star)
            end
            return
        end
        if data.pay_buy_num == 0 then
            --_G.FloatTipsModel:GetInstance():Show("已达到限购次数")
            return
        end
        self.activity_data.typeClass:BuyItemCash(
            ind,
            self.activity_data:GetActivityID()
            -- ,
            -- function()
            --     --self:UpdateRedpoint()
            --     self:IninScorll()
            -- end
        )
    end
end

