---界面的入口函数
function HeroMegganView:OnCreate(acitvity)
    self:InitView(acitvity)
    self:UIEffect()
    self:ShowUIEffect()
end
function HeroMegganView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:StopClooling()
end
function HeroMegganView:InitView(data)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.activity_data = data
    self.item_touxiang = {}
    self.item_left_awrad_lists = {}
    self.item_right_awrad_lists = {}
    self.time = 0
    self:SetIsFanhui()
    self:SetRoleAndName()
    self:SetActivtyTime()
    self:IninScorll()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.ResClooling, self, false, false, true)
        self.timer:Start()
    end

    --require "FreeGiftManager":GetInstance():Show(
    --    _G.FreeGiftID.HeroMeggan,
    --    self.go_table.obj_freeGift,
    --    data:GetActivityID()
    --)
end
function HeroMegganView:UpdateView(data)
    self:InitView(data)
    self:UIEffect()
    self:ShowUIEffect()
end
--常驻特效
function HeroMegganView:UIEffect()
    local path = _G.ConfigManager.ui_effect_cfg["ef_HeroMegganView_zi_loop"]
    if path then
        _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_effect_ziti)
    end
end
---展示特效
function HeroMegganView:ShowUIEffect()
    local path = _G.ConfigManager.ui_effect_cfg["ef_ContinueRecharge_mid_once"]
    _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_effect_liuguan)
    path = _G.ConfigManager.ui_effect_cfg["ef_DrawResultRole_Name"]
    _G.UIUtils.LoadEffectByCfg(
        path,
        self.go_table.obj_uieffect_name,
        function(obj)
            obj:SetLocalPosition(0, 0, 0)
        end
    )
end

function HeroMegganView:ResClooling(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self.go_table.aortext_acti_time.text = GetLangPackValue(90022500413) .. _G.TimeUtil.TranslateSecondForStr(0)
        self.activity_data:ChangeState(1)
        self:StopClooling()
    else
        self.go_table.aortext_acti_time.text =
            GetLangPackValue(90022500413) .. _G.TimeUtil.TranslateSecondForStr(Mathf.RoundToInt(self.time))
    end
end
function HeroMegganView:StopClooling()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end
