---设置角色id
function HeroMegganView:SetRoleAndName()
    self.cardid = self.activity_data.typeClass.HeroMeggan_lists[1].card_id or 114200000
    local name = _G.ConfigManager.card_cfg[self.cardid].Name -- Portrait
    self.go_table.aortext_name.text = _G.LangUtil.TryGetLangValue(name)
    local icon = _G.ConfigManager.card_cfg[self.cardid].Portrait
    self.go_table.aorrawimage_role:LoadImage(
        icon,
        function(tran)
            if self.activity_data.typeClass.pos_portrait then
                local pos = self.activity_data.typeClass.pos_portrait
                local posx = pos[1]
                local posx1 = pos[1].num
                if posx.pn ~= 0 then
                    posx1 = -pos[1].num
                end
                local posy, posy1 = pos[2], 0
                if posy.pn ~= 0 then
                    posy1 = -pos[2].num
                end
                self.go_table.aorrawimage_role:SetLocalPosition(posx1, posy1, 0)
            end
        end
    )
end
---设置活动时间 到计时
function HeroMegganView:SetActivtyTime()
    local startTime, _ = self.activity_data:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local endTime, countdown = self.activity_data:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local time1 = endTime - startTime
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local time2 = nowTime - startTime

    self.time = time1 - time2
    if self.time <= 0 then
        self.time = 0
    end
    self.go_table.aortext_acti_time.text = GetLangPackValue(90022500413) .. _G.TimeUtil.TranslateSecondForStr(self.time)
end

---初始化视图
function HeroMegganView:IninScorll()
    self.lists_data = self.activity_data.typeClass:GetListsData()
    if self.mScorll == nil then
        self.go_table.scrollloopvectical_item:InitItemData(#self.lists_data, _G.handler(self, self.RefreshItem))
        self.mScorll = self.go_table.scrollloopvectical_item
    else
        self.mScorll:UpdateAllItem()
    end
end
---刷新
function HeroMegganView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    obj:SetName(index + 1)
    local ind = index + 1
    local data = self.lists_data[ind]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ItemOnclick, data, ind))
    --tb.aortext_xiangou.text = _G.LangUtil.TryGetLangValue(90021600042, data.cfg.count_limit)
    tb.aortext_xiangou.text = _G.LangUtil.TryGetLangValue(90021600042, data.pay_buy_num)
    local ordername = require "CardInfoManager":GetInstance():GetOrderStarCount(data.cfg.condition[2])
    local star = data.cfg.condition[2] - card_order_star[ordername]
    if star == 0 then
        star = ""
    end
    tb.aortext_hint1.text = _G.LangUtil.TryGetLangValue(card_order_Name[ordername]) .. star
    local price = _G.GameUtil.RatioControl(data.cfg.price)
    tb.aortext_name3.text = price
    --左边btn
    _G.GameUtil.SetActiveByCondition(tb.aorimage_left, data.isfree)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_left, not data.isfree)
    _G.GameUtil.SetActiveByCondition(tb.aortext_name1, data.isLock)
    _G.GameUtil.SetActiveByCondition(tb.aortext_name2, not data.isLock)
    tb.aorbtn_left:SetGray(not data.isLock)
    --右边btn
    _G.GameUtil.SetActiveByCondition(tb.aorimage_right, data.isPay)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_right, not data.isPay)
    _G.GameUtil.SetActiveByCondition(tb.obj_mask, not data.isLock)

    --中间头像
    local dikuang = require "CardInfoManager":GetInstance():GetHeadBgSpriteName(data.cfg.condition[2])
    tb.aorimage_ColorBg.SpriteName = dikuang
    local icon = _G.ConfigManager.card_cfg[data.cfg.condition[1]].Icon
    tb.aorimage_Icon.SpriteName = icon
    --左边奖励
    local left_award_obj = {
        [1] = tb.obj_award1,
        [2] = tb.obj_award2
    }
    self:SetAward(left_award_obj, self.item_left_awrad_lists, ind, data, data.cfg.rewards_normal, 1)
    --右边奖励
    left_award_obj = {
        [1] = tb.obj_award3,
        [2] = tb.obj_award4
    }
    self:SetAward(left_award_obj, self.item_right_awrad_lists, ind, data, data.cfg.rewards_pay, 2)
    return obj
end
