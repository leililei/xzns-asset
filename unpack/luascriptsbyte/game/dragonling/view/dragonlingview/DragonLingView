local ActivitySynManager = require "ActivitySynManager"
---@class DragonLingView : UIBaseView	中文描述
---@field public go_table DragonLingView_GoTable GoTable
---@field activity DragonLingModel 活动数据
---@field rateDatas activity_cash_day_rebate.i_cash_day_rebate[] 挡位数据
---@field RTS number 剩余时间
---@field timer Timer 计时器
---@field startTime table 开始时间
---@field endTime table 结束时间
local DragonLingView = _G.BaseClass("DragonLingView", _G.UIBaseView)
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
--_G.DragonLingView = DragonLingView
---说明id
local InstructionID = {
    ---活动说明
    activityID = 50,
    ---充值返利说明
    RateID = 51
}
function DragonLingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity DragonLingModel
function DragonLingView:OnCreate(activity)
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:UpdateView(activity)
    self:AddListener(_G.eDragonLing.UpdateCash, self.UpdateCash)
    require "FreeGiftManager":GetInstance():Show(
        _G.FreeGiftID.DragonLing,
        self.go_table.obj_freeGift,
        self.activity.curActivityClass:GetActivityID()
    )
    self:InitEffect()
    self:ChangeState()
end

function DragonLingView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DragonLingView_Bg,
        self.transform,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
        end
    )
end

---更新界面
function DragonLingView:UpdateView(activity)
    self.activity = activity
    self.rateDatas = self.activity:GetRateDatas()
    local count = #self.rateDatas
    self.go_table.scrollloopvectical_itemList:UpdateCount(count)
    if count > 4 then
        self.go_table.scrollloopvectical_itemList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).vertical =
            true
    end
    self:UpdateTime()
    self:UpdateCash()
end
---更新时间
function DragonLingView:UpdateTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.startTime = self.activity:GetTime(ActivitySynManager.State.Open)
    self.settlementTime = self.activity:GetTime(ActivitySynManager.State.Settlement)
    self.endTime = self.activity:GetTime(ActivitySynManager.State.Close)
    local startTime = _G.TimeUtil.GetDateTime(self.startTime)
    local settlementTime = _G.TimeUtil.GetDateTime(self.settlementTime)
    local endTime = _G.TimeUtil.GetDateTime(self.endTime)
    local text1 =
        _G.GetLangPackValue(90000010300, startTime.month, startTime.day, startTime.hour) ..
        "-" .. _G.GetLangPackValue(90000010300, settlementTime.month, settlementTime.day, settlementTime.hour)
    self.go_table.aortext_activityTime.text = _G.GetLangPackValue(90025800003, text1)
    local text2 =
        _G.GetLangPackValue(90000010300, settlementTime.month, settlementTime.day, settlementTime.hour) ..
        "-" .. _G.GetLangPackValue(90000010300, endTime.month, endTime.day, endTime.hour)
    self.go_table.aortext_settlementTime.text = _G.GetLangPackValue(90028010132, text2)
    if self.activity.curActivityClass:GetCurActivityState() == ActivitySynManager.State.smch then
        self.endTime, self.RTS = self.activity:GetTime(ActivitySynManager.State.Close)
        if self.RTS <= 0 then
            return
        end
        local time = _G.TimeUtil.TransLateSMCH(self.RTS)
        self.go_table.aortext_GetTime.text = _G.LangUtil.GetLangPackValue(90000001030, time)
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimerShow, self, false, false, true)
        self.timer:Start()
    end
    local time = _G.TimeUtil.GetDateTime(self.settlementTime)
    self.go_table.aortext_canTime.text = _G.LangUtil.GetLangPackValue(90000001029, time.year, time.month, time.day)
end
---更新金额
function DragonLingView:UpdateCash()
    if version == 1 then
        self.go_table.aortext_total:SetActiveE(1)
        self.go_table.obj_tips:SetActiveE(0)
        if _G.AppSetting.IsOverseas then
            self.go_table.aortext_total.text =
                _G.GetLangPackValue(90000010807) .. self:ChangeCash(self.activity:CurDayCash())
        else
            self.go_table.aortext_total.text =
                _G.GetLangPackValue(90000010819, self:ChangeCash(self.activity:CurDayCash()))
        end
    elseif version == 2 then
        self.go_table.obj_tips:SetActiveE(1)
        self.go_table.aortext_Total:SetActiveE(1)
        self.go_table.aortext_Total.text = self.activity:CurDayCash()
    end
    self.go_table.aortext_getNum.text = _G.GameUtil.NumberToUnitStr(self.activity:GetHyCount())
end
---金额格式化
function DragonLingView:ChangeCash(num)
    return _G.GameUtil.FormatRmb(num)
end

---更新计时显示
function DragonLingView:UpdateTimerShow(elapsed)
    self.RTS = self.RTS - elapsed
    local time = _G.TimeUtil.TransLateSMCH(Mathf.RoundToInt(self.RTS))
    self.go_table.aortext_GetTime.text = _G.LangUtil.GetLangPackValue(90000001030, time)
end

---刷新挡位显示
---@param obj UnityEngine.GameObject 物体
---@param index number 下标
function DragonLingView:RefreshItem(index, obj)
    ---@type DragonLingView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.rateDatas[index + 1]
    if version == 1 then
        if _G.AppSetting.IsOverseas then
            tb.aortext_L.text =
                _G.GetLangPackValue(90000010807) ..
                _G.string.format(
                    "<color=#f9b85b>%s~%s</color>",
                    self:ChangeCash(data.min_num),
                    self:ChangeCash(data.max_num)
                )
        else
            tb.aortext_L.text =
                _G.GetLangPackValue(
                90000010819,
                _G.string.format(
                    "<color=#f9b85b>%s~%s</color>",
                    self:ChangeCash(data.min_num),
                    self:ChangeCash(data.max_num)
                )
            )
        end
    elseif version == 2 then
        tb.aortext_L.text =
            _G.LangUtil.GetLangPackValue(
            90000010817,
            _G.string.format("<color=#f9b85b>%s~%s</color>", data.min_num, data.max_num)
        )
    end
    tb.aortext_R.text = _G.LangUtil.GetLangPackValue(90000001031, _G.GameUtil.FormatNum(data.percent / 100))
end

---按钮点击事件在这里派发
function DragonLingView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_go then
        _G.JumpManager:GetInstance():Jump(108001)
    elseif go == self.go_table.aorbtn_tan1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, InstructionID.RateID)
    elseif go == self.go_table.aorbtn_tan2 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name,
            InstructionID.activityID
        )
    elseif go == self.go_table.aorbtn_GetAward then
        self.activity:GetCashAward(
            function()
                self.activity.curActivityClass:ChangeState(ActivitySynManager.State.Close)
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
                if view then
                    view:Close()
                end
            end
        )
    end
end

function DragonLingView:CloseView()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

function DragonLingView:ChangeState()
    if self.activity.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        self.go_table.aortext_title.text = _G.GetLangPackValue(90000001034)
        self.go_table.obj_award:SetActiveE(0)
        self.go_table.aorbtn_go:SetActiveE(1)
        self.go_table.aorbtn_GetAward:SetActiveE(0)
        self.go_table.obj_di:SetActiveE(1)
    elseif self.activity.curActivityClass:GetCurActivityState() == ActivitySynManager.State.smch then
        self.go_table.scrollloopvectical_itemList:SetActiveE(0)
        self.go_table.obj_award:SetActiveE(1)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            {12, self.activity:GetHyCount()},
            self.go_table.obj_award,
            function(item)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                _G.DelayDo(0.5,function()
                    item:ShowEffect(true)
                end)
            end
        )
        self.go_table.aortext_title.text = _G.GetLangPackValue(90000010878)
        self.go_table.obj_tips:SetActiveE(0)
        self.go_table.aorbtn_go:SetActiveE(0)
        self.go_table.aorbtn_GetAward:SetActiveE(1)
        self.go_table.obj_di:SetActiveE(0)
        self.go_table.obj_freeGift:SetActiveE(0)
    end
end

return DragonLingView
