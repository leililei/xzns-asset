local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class DragonLingModel:ActivitySynTypeBase 龙桃灵气
---@field info activity_cash_day_rebate.i_activity_cash_day_rebate 龙桃灵气数据
local DragonLingModel = _G.BaseClass("DragonLingModel", base)
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
---类的构造函数
function DragonLingModel:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.curActivityClass:AddStateChanged(self.StateChange, self)
end

---当状态改变
function DragonLingModel:StateChange(state)
    if state == ActivitySynManager.State.Close then
        require "FreeGiftManager":GetInstance():Remove(_G.FreeGiftID.DragonLing, self.curActivityClass:GetActivityID())
    elseif state == ActivitySynManager.State.Settlement then
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PenglaiLTLQView.Name)
        if self:GetHyCount() > 0 then
            self.curActivityClass:ChangeState(ActivitySynManager.State.smch)
            if window then
                window.View:ChangeState()
            end
        else
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            if window then
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
                if view then
                    view:Close()
                end
            end
        end
    end
end

---类的析构函数
function DragonLingModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

