end

---获取返利魂玉
function DragonLingModel:GetHyCount()
    local count = 0
    local min
    local value = 0
    local getNum = function(num)
        value = 0
        for _, v in pairs(self.info.rebate) do
            min = v.min_num
            if v.min_num == 0 then
                min = 1
            end
            if num >= v.max_num then
                value = (v.max_num - min + 1) * (self.info.rmb_num / self.info.money_num) * v.percent / 10000 + value
            elseif num >= min then
                value = (num - min + 1) * (self.info.rmb_num / self.info.money_num) * v.percent / 10000 + value
            end
        end
        return value
    end
    for _, v in pairs(self.info.role_info.day_cash) do
        count = getNum(v.cash_num) + count
    end

    return _G.math.floor(count + 0.5)
end

---初始化红点
function DragonLingModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { { 2 }, false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function DragonLingModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function DragonLingModel:UpdateRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function DragonLingModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        if self.info.is_award == 0 and self.info.old_cash_num > 0 then
            return 1
        end
    end
    return 0
end

---获取挡位信息
---@return activity_cash_day_rebate.i_cash_day_rebate[]
function DragonLingModel:GetRateDatas()
    return self.info.rebate or {}
end

---获取时间
function DragonLingModel:GetTime(state)
    return self.curActivityClass:GetActivityDeadLineByCondition(state)
end

function DragonLingModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PenglaiLTLQView.Name)
    if window then
        window.View:UpdateView(self)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PenglaiLTLQView.Name, self)
    end
    base.OnEnterActivity(self)
end

function DragonLingModel:GetCashAward(callback)
    require "ActivitySynNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        nil,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require "CommonTipManager".OpenCommonAwardView(msg, callback)
            -- self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
            self.info.is_award = 1
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        end
    )
end

return DragonLingModel
