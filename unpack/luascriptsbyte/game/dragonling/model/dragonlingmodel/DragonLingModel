---充值监听
---@param data store.p2c_store_cash
function DragonLingModel:OnMallCashListener(data)
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open then
        return
    end
    if data ~= nil and data.total_cash_bool then
        if version == 1 then
            self.info.cash_num =
                data.cash_rmb + self.info.cash_num
        elseif version == 2 then
            self.info.cash_num =
                data.base_rmb + self.info.cash_num
        end
        _G.Events:GetInstance():Broadcast(_G.eDragonLing.UpdateCash)
    end
end

