---@class WildADView : UIBaseView	中文描述
---@field public go_table WildADView_GoTable GoTable
local WildADView = _G.BaseClass("WildADView", _G.UIBaseView)

function WildADView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WildADView:OnCreate()
    self.award = require "AdvertisementModel":GetInstance():GetWildRewardList()
    self.go_table.obj_content:ClearChildren()
    for i = 1, #self.award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            self.award[i],
            self.go_table.obj_content,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end
end

function WildADView:CloseView()
    self:Close()
end

function WildADView:ADSuc()
    require "AdvertisementModel":GetInstance():StartPlaneTimer()
    _G.MainManager:GetInstance():RefreshWildPlane()
    self:Close()
end

---按钮点击事件在这里派发
function WildADView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_ad then 
        require("AdvertisementModel"):GetInstance():VideoAD(_G.AdvertisementType.PlaneAD, _G.handler(self, self.ADSuc))
    elseif go == self.go_table.aorbtn_jump then 
        _G.JumpManager:GetInstance():Jump(148001)
    end
end

return WildADView