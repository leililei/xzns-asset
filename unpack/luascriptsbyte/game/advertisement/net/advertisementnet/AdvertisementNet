local base = require("BaseGameNet")

---@class AdvertisementNet : BaseGameNet	通信协议
local AdvertisementNet = _G.BaseClass("AdvertisementNet", base)
---@return AdvertisementNet AdvertisementNet
function AdvertisementNet:GetInstance()
    return base.GetInstance(self)
end

---请求充值信息
---@param callback function 回调方法
function AdvertisementNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_advertisement_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---领取奖励
---@param pbdata table 发送数据
---@param callback function 回调方法
function AdvertisementNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_advertisement_add_num
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function AdvertisementNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return AdvertisementNet
