local base = require "BaseSystemMaterialModel"
---@class SystemEquipmentMaterialModel : BaseSystemMaterialModel	中文描述
---@field Datas table<number,SystemMaterialData>
local SystemEquipmentMaterialModel = _G.BaseClass("SystemEquipmentMaterialModel", base)

function SystemEquipmentMaterialModel:Init()
    self.systemID = 103
    local cfg = _G.ConfigManager.system_cfg[self.systemID]
    self.curTimes = cfg.count_reset
    self.curInstance = 0
    self.maxTimes = cfg.count_limit
    self.curFunctionOpenID = 8
    self.redID = _G.ConfigManager.redpoint_cfg.SoldierTrial.id
end

---@return SystemEquipmentMaterialModel
function SystemEquipmentMaterialModel:GetInstance()
    return base.GetInstance(self)
end

function SystemEquipmentMaterialModel:GetDataFormServer()
    require("SystemMaterialNet"):GetInstance():GetEquipmentMaterailInfo(_G.handler(self, self.ParseData))
end

function SystemEquipmentMaterialModel:ParseData(data)
    self.curTimes = data.times
    self.curInstance = data.instance or 0
    self.maxTimes = data.maxtimes and data.maxtimes > 0 and data.maxtimes or 2
    if not self.sTime then
        self.sTime = self.maxTimes
    end
    require("SystemEntranceModel"):GetInstance():SetTimes(self.systemID, self.curTimes, self.maxTimes)
    self:InitDatas()
    base.ParseData(self)
end

function SystemEquipmentMaterialModel:UpdateTimesByAd(num)
    base.UpdateTimesByAd(self,num)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.TimesofEquipment.id)
end

--region对外接口
function SystemEquipmentMaterialModel:GetHighSection()
    return self.highSection
end

function SystemEquipmentMaterialModel:FreshInfo(callback)
    self.endCallback = callback
    self:GetDataFormServer()
end

function SystemEquipmentMaterialModel:GetCurChallengeFloor()
    return self.curInstance == 0 and 0 or _G.ConfigManager.system_material_cfg[self.curInstance].difficulty
end

---检测是否挑战(红点)
function SystemEquipmentMaterialModel:CheckIsChallenge()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return true
    end
    if not self.curInstance then
        return false
    end
    return self.curInstance > 0
end

function SystemEquipmentMaterialModel:OnSweep(times, callback, notUITip)
    require "SystemMaterialNet":GetInstance():EquipmentMaterailSweep(
        times,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            if not notUITip then
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    data,
                    nil,
                    true,
                    nil,
                    require "DoubleResourcesModel":GetInstance():FanHui(self.systemID)
                )
            end
            self.curTimes = _G.Mathf.Max(self.curTimes - times, 0)
            require("SystemEntranceModel"):GetInstance():SetTimes(self.systemID, self.curTimes, self.maxTimes)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.SoldierTrial.id
            )
            self:InitData()
            if callback then
                callback(data)
            end
        end
    )
end

---检测关卡是否通关
function SystemEquipmentMaterialModel:CheckIsPass(sid)
    return self.curInstance >= sid
end

function SystemEquipmentMaterialModel:InitDatas()
    if not self.Datas then
        self.Datas = {}
        local tb =
            _G.table.choose(
            _G.ConfigManager.system_material_cfg,
            function(k, v)
                return v.system == self.systemID
            end
        )
        for _, v in pairs(tb) do
            self.Datas[v.id] = require "SystemMaterialData".New(_G.ConfigManager.system_material_cfg)
            self.Datas[v.id]:Init(v.id, self.curInstance)
        end
    else
        for _, v in pairs(self.Datas) do
            v:UpdateData(self.curInstance)
        end
    end
end

---@param includeAll? boolean 包含全部数据
---@return table<number,SystemMaterialData>
function SystemEquipmentMaterialModel:GetDatas(includeAll)
    if includeAll then
        return self.Datas
    end
    local results = {}
    for k, v in pairs(self.Datas) do
        if not v.isHide then
            results[k] = v
        end
    end
    return results
end

function SystemEquipmentMaterialModel:GetEBattleType()
    return _G.EBattleType.ResourcesEquipmentMaterial
end

function SystemEquipmentMaterialModel:GetEmbattleType()
    return _G.EBattleType.ResourcesEquipmentMaterial
end

--endregion

return SystemEquipmentMaterialModel
