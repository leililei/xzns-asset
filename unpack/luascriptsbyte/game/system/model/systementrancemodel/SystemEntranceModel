require "SystemMaterialNet"
require "SystemMaterialController"
---@class SystemEntranceModel : Singleton    中文描述
local SystemEntranceModel = _G.BaseClass("SystemEntranceModel", _G.GameDataModelBase)

local defaultChanllengeCount = 2

---创建对象时,入口构造函数
function SystemEntranceModel:__init()
    self.systemTimes = {}
end

---销毁对象时,析构函数
function SystemEntranceModel:Dispose()
    self.systemTimes = nil
end

function SystemEntranceModel:GetDataFormServer()
    self.changeCalls = {}
    self:ParseData()
end
function SystemEntranceModel:ParseData(data)
    _G.GameDataModelBase.ParseData(self)
end

---获取副本挑战次数
---@param id number 副本id
---@return number 剩余挑战次数
---@return number 总次次数
function SystemEntranceModel:GetTimes(id)
    local item = self.systemTimes[id] or {}
    return item.count or defaultChanllengeCount, item.sum or defaultChanllengeCount
end

---获取是否有红点
function SystemEntranceModel:GetRedPoint(id)
    local item = self.systemTimes[id] or {}
    return item.count or 0
end

---设定副本挑战次数
---@param id number 副本id
---@param count number 剩余挑战次数
---@param sum number 总挑战次数
function SystemEntranceModel:SetTimes(id, count, sum)
    self.systemTimes[id] = {count = count, sum = sum}
    if self.changeCalls then
        for key, value in pairs(self.changeCalls) do
            if value then
                value(id, count, sum)
            end
        end
    end
    if id < 200 then
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ChallengePage.id, id)
    else
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.AdventurePage.id, id)
    end
end

function SystemEntranceModel:GetFunctionLimitText(id)
    local cfg = _G.ConfigManager.system_cfg[id]
    return _G.FunctionManager:GetInstance():GetTipsStr(cfg.function_open)
end

function SystemEntranceModel:OnSystemClick(id)
    local cfg = _G.ConfigManager.system_cfg[id]
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.function_open) then
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(cfg.function_open)
        return
    end
    if not _G.string.IsNullOrEmpty(cfg.views) then
        if cfg.views == _G.ConfigManager.ui_cfg.DeadsoulTowerView.Name then
            _G.DeadsoulTowerManager:GetInstance():OpenDeadsoul(id)
        elseif cfg.views == _G.ConfigManager.ui_cfg.SelectSectionMapView.Name then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SelectSectionMapView.Name)
        else
            _G.UIManager:GetInstance():OpenWindow(cfg.views, id)
        end
    end
end

function SystemEntranceModel:SetPosition()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SystemAdventureView.Name)
end

---添加次数改变监听
---@param key string 监听唯一key值
---@param call function 回调方法(id 副本id,count可挑战次数,sum总挑战次数)
function SystemEntranceModel:AddTimesChangeListener(key, call)
    self.changeCalls[key] = call
end

--移除次数改变监听
---@param key string 监听唯一key值
function SystemEntranceModel:RemoveTimesChangeListener(key)
    if self.changeCalls then
        self.changeCalls[key] = nil
    end
end

return SystemEntranceModel
