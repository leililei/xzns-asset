local base = require "BaseSystemMaterialModel"
---@class SystemGemstoneModel : BaseSystemMaterialModel	中文描述
local SystemGemstoneModel = _G.BaseClass("SystemGemstoneModel", base)
---创建对象时,入口构造函数
function SystemGemstoneModel:Init()
    self.systemID = 106
    local cfg = _G.ConfigManager.system_cfg[self.systemID]
    self.curTimes = cfg.count_reset
    self.curInstance = 0
    self.maxTimes = cfg.count_limit
    self.curFunctionOpenID = _G.FunctionID.Gemstone
    self.redID = _G.ConfigManager.redpoint_cfg.GemstoneTrial.id
end

---@return SystemGemstoneModel
function SystemGemstoneModel:GetInstance()
    return base.GetInstance(self)
end

function SystemGemstoneModel:GetDataFormServer()
    require("SystemMaterialNet"):GetInstance():GetGemInfo(_G.handler(self, self.ParseData))
end

function SystemGemstoneModel:ParseData(data)
    self.curTimes = data.challenge_num and data.challenge_num or 2
    self.curInstance = data.high_section or 0
    self.maxTimes = data.limit_num and data.limit_num > 0 and data.limit_num or 2
    if not self.sTime then
        self.sTime = self.maxTimes
    end
    require("SystemEntranceModel"):GetInstance():SetTimes(self.systemID, self.curTimes, self.maxTimes)
    self:InitDatas()
    base.ParseData(self)
end

function SystemGemstoneModel:UpdateTimesByAd(num)
    base.UpdateTimesByAd(self,num)
    -- require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.TimesofCoinAdd.id)
end


--region对外接口
function SystemGemstoneModel:GetHighSection()
    return self.highSection
end

function SystemGemstoneModel:FreshInfo(callback)
    self.endCallback = callback
    self:GetDataFormServer()
end

function SystemGemstoneModel:GetCurChallengeFloor()
    return self.curInstance == 0 and 0 or _G.ConfigManager.system_material_cfg[self.curInstance].difficulty
end

function SystemGemstoneModel:GetEBattleType()
    return _G.EBattleType.ResourcesGemstone
end

function SystemGemstoneModel:GetEmbattleType()
    return _G.EBattleType.ResourcesGemstone
end

---检测是否挑战(红点)
function SystemGemstoneModel:CheckIsChallenge()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return true
    end
    if not self.curInstance then
        return false
    end
    return self.curInstance > 0
end

function SystemGemstoneModel:OnSweep(times, callback, notUITip)
    require "SystemMaterialNet":GetInstance():GemSweep(
        times,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            if not notUITip then
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    data,
                    nil,
                    true,
                    nil
                    -- require "DoubleResourcesModel":GetInstance():FanHui(self.systemID)
                )
            end
            self.curTimes = _G.Mathf.Max(self.curTimes - times, 0)
            require("SystemEntranceModel"):GetInstance():SetTimes(self.systemID, self.curTimes, self.maxTimes)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GemstoneTrial.id)
            self:InitData()
            if callback then
                callback(data)
            end
        end
    )
end

---检测关卡是否通关
function SystemGemstoneModel:CheckIsPass(sid)
    return self.curInstance >= sid
end

function SystemGemstoneModel:InitDatas()
    if not self.Datas then
        self.Datas = {}
        local tb =
            _G.table.choose(
            _G.ConfigManager.system_material_cfg,
            function(k, v)
                return v.system == self.systemID
            end
        )

        for _, v in pairs(tb) do
            self.Datas[v.id] = require "SystemMaterialData".New(_G.ConfigManager.system_material_cfg)
            self.Datas[v.id]:Init(v.id, self.curInstance)
        end
    else
        for _, v in pairs(self.Datas) do
            v:UpdateData(self.curInstance)
        end
    end
end

---@param includeAll? boolean 包含全部数据
---@return table<number,SystemMaterialData>
function SystemGemstoneModel:GetDatas(includeAll)
    if includeAll then
        return self.Datas
    end
    local results = {}
    for k, v in pairs(self.Datas) do
        if not v.isHide then
            results[k] = v
        end
    end
    return results
end

--endregion

return SystemGemstoneModel