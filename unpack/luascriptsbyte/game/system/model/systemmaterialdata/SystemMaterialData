---@class SystemMaterialData	中文描述
---@field cfg system_material_cfg|system_prof_cfg
---@field isLock boolean        是否锁定关卡
---@field isHide boolean        是否隐藏关卡(不显示/不可见)
local SystemMaterialData = _G.BaseClass("SystemMaterialData")

---类的构造函数
function SystemMaterialData:__init(cfgs)
    self.Cfgs = cfgs
    self.id = 0
    self.cfg = {}
    self.isLock = true
    self.isHide = true
end

---类的析构函数
function SystemMaterialData:Dispose()
    self.Cfgs = nil
    self.id = nil
    self.cfg = nil
    self.isLock = nil
end

---初始化数据
function SystemMaterialData:Init(id, curFloor)
    self.id = id
    self.cfg = self.Cfgs[id]
    self:UpdateData(curFloor)
end

---更新数据
function SystemMaterialData:UpdateData(curFloor, isForce)
    --检查关卡是否锁定
    if self.isLock or isForce then
        self.isLock = true
        self.lockStr = ""
        if
            #self.cfg.limit_condition > 0 and
                not _G.GlobalConditionManager.CheckCondition(self.cfg.limit_condition[1], self.cfg.limit_condition[2])
         then
            if self.cfg.pre_id > curFloor then
                self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900049), self.Cfgs[self.cfg.pre_id].difficulty)
                self.tipId = 1001
            else
                self.lockStr, self.tipId =
                _G.FunctionManager:GetInstance():GetStrWithType(
                        self.cfg.limit_condition[1],
                        self.cfg.limit_condition[2]
                )
            end
        elseif self.cfg.pre_id > curFloor then
            if self.Cfgs[self.cfg.pre_id] then
                self.lockStr =
                    _G.string.format(_G.LangUtil.GetLangPackValue(90022900049), self.Cfgs[self.cfg.pre_id].difficulty)
                self.tipId = 1001
            end
        else
            self.isLock = false
        end
    end

    --检查关卡是否隐藏
    if self.isHide or isForce then
        if self.cfg.preview_condition and #self.cfg.preview_condition > 0 then
            self.isHide = not _G.GlobalConditionManager.CheckConditionArrays(self.cfg.preview_condition)
        else
            self.isHide = false
        end
    end
end

function SystemMaterialData:GetLockStr()
    return self.lockStr
end

return SystemMaterialData
