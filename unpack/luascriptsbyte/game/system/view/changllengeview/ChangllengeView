---@protected
function ChangllengeView:UpdateBlackMarketExchange()
    local act = ActivitySynManager:GetInstance():GetActivityWithTypeId(10017)
    if act ~= nil then
        local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10048, act:GetJumpType(act:GetActivityID()))
        local blacktravle = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.BlackTraveler)
        if _G.AppSetting.DEBUG then
            _G.Log(blacktravle, "黑市旅人活动 渠道显示控制")
        end
        self.go_table.aorbtn_blackMarketExchange:SetActiveE((activity ~= nil and activity:CheckConditionExtra() == true and blacktravle) and
            1 or 0)
        if activity ~= nil and activity:CheckConditionExtra() == true then
            self.blackMarketExchange.obj_redpoint:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls()
                                                                                       :GetRedpointIDByIndex(1))
            require "RedPointManager":GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.Changllenge.id,
                activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
        end
    else
        self.go_table.aorbtn_blackMarketExchange:SetActiveE(0)
    end
end

function ChangllengeView:ShowView()
    if self.isHide then
        self.isHide = false
        return
    end
    _G.UIBaseView.Show(self)
end

function ChangllengeView:HideView()
    if self.gameObject:GetActiveSelf() == 0 then
        self.isHide = true
        return
    end
    _G.UIBaseView.Hide(self)
end

function ChangllengeView:InitView(playMusic)
    if playMusic then
        _G.AudioManager.PlayAudioByAudioCfgID(2032)
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ChallengeView, self.go_table)
    for _, v in pairs(_G.ConfigManager.system_cfg) do
        if self.go_table["aorbtn_" .. v.id] then
            if not self.itemList[v.id] then
                self.itemList[v.id] = require "ChangllengeItem".New(self.go_table["aorbtn_" .. v.id])
            end
            self.itemList[v.id]:Init(v)
        end
    end
    self:InitItem(self.lingyushouwei, 75)
    self:InitItem(self.xuewanglaixi, 4)
    self:InitItem(self.arena, 2)
    self:ShowPlane()
    self:UpdateBlackMarketExchange()
end

function ChangllengeView:InitNpc()
    --local ScreenWidth, ScreenHeight = _G.UIManager:GetInstance().UIRootRect:GetRectTransformSizeDelta()
    local heigth = -115
    self.npc = self.go_table.aorbtn_plane
    local endTime = _G.ConfigManager.discrete_cfg[126201] and
        _G.ConfigManager.discrete_cfg[126201][1][1] or 12
    -----@field public movePoint table 移动参数{1~3-xyz坐标，5-移动时间}
    -----@field public delay number 首次播放延迟时间
    -----@field public cycle number 间隔时间（读不到离散表配置就使用默认值5秒）
    self.npcCfg = {
        movePoint = {
            --起始参数
            { -400, heigth, 0,
              0.8,
              0,
              1
            },
            --终点参数
            { 450, heigth, 0,
              0.8,
              endTime,
              1
            }
        },
        delay = 2,
        cycle = _G.ConfigManager.discrete_cfg[122007][1][1] or 5
    }
    if self.npcCfg.delay > 0 then
        self.npc:SetActiveE(0)
        _G.DelayDo(self.npcCfg.delay, _G.handler(self, self.PlayNpcAni))
    else
        self:PlayNpcAni()
    end
end

function ChangllengeView:PlayNpcAni()
    if self.go_table == nil or not require("AdvertisementModel"):GetInstance():CheckWildPlaneShow() then
        return
    end
    self.npc:SetActiveE(1)
    local pos = self.npcCfg.movePoint[1]
    self.npc:SetAnchorPosition(pos[1], pos[2], pos[3])
    local size = pos[4]
    self.npc:SetLocalScale(size * pos[6], size, 1)
    self:NpcMoveTo(2)
end

function ChangllengeView:NpcMoveTo(index)
    if self.go_table == nil or not require("AdvertisementModel"):GetInstance():CheckWildPlaneShow() then
        return
    end
    if index > #self.npcCfg.movePoint then
        if self.npcCfg.cycle > 0 then
            self.npc:SetActiveE(0)
            _G.DelayDo(self.npcCfg.cycle, _G.handler(self, self.PlayNpcAni))
        else
            self:PlayNpcAni()
        end
        return
    end
    local pos = self.npcCfg.movePoint[index]
    local x, y, z = self.npc:GetLocalScale()
    self.npc:SetLocalScale(_G.math.abs(x) * pos[6], y, z)
    local size = pos[4]
    self.npc:DOScale(size * pos[6], size, 1, pos[5]):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    self.npc:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)):DOAnchorPos(_G.Vector2(pos[1], pos[2]), pos[5], false):SetEase(
        _G.CS.DG.Tweening.Ease.Linear
    )   :OnComplete(
        function()
            if self.go_table == nil then
                return
            end
            self:NpcMoveTo(index + 1)
        end
    )
end

function ChangllengeView:InitEffect()
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(trans)
        if _G.IsNil(self.go_table) then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_tianzaizhidi, self.lingyushouwei.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_longzhishilian, self.xuewanglaixi.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_ranshaoyuanzheng, self.burningCrusade.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_shikongzhimen, self.timePortal.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_ChangllengeView_men, self.damijing.obj_eff, check)
end

function ChangllengeView:InitItem(go_table, function_open)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ChallengeViewBuild .. function_open, go_table)
    self.lock = self.lock or {}
    if not self.functionList then
        self.functionList = {}
    end
    self.functionList[function_open] = go_table
    self.lock[go_table] = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(function_open)
    self.lockStr[go_table], self.tipsId[go_table] = _G.FunctionManager:GetInstance():GetAllTipsStr(function_open)
    if self.lock[go_table] then
        if _G.FunctionManager:GetInstance():CheckFunctionForbidden(function_open) then
            self.tipsId[go_table] = { 1020010 }
            self.lockStr[go_table] = {}
        end
    end
    --self.double = require("DoubleResourcesModel"):GetInstance():FanHui(self.cfg.id)
    go_table.obj_lockBg:SetActiveE(0)
    --go_table.obj_mask:SetActiveE(self.lock[go_table] and 1 or 0)
    ---如果未解锁 图片置灰
    -- go_table.aorrawimage_icon:SetGray(self.lock[go_table])
    -- go_table.aorrawimage_double:SetGray(self.lock[go_table])
    -- if go_table.aorrawimage_iconChild then
    --     go_table.aorrawimage_iconChild:SetGray(self.lock[go_table])
    -- end
    if AppSetting.IsXzns then
        go_table.obj_mask:SetActiveE(self.lock[go_table] and 1 or 0)
        go_table.aorrawimage_icon:SetActiveE(self.lock[go_table] and 0 or 1)
    end
    go_table.obj_suo:SetActiveE(self.lock[go_table] and 1 or 0)
    go_table.aorrawimage_item:SetActiveE(self.lock[go_table] and 0 or 1)
    if self.lock[go_table] then
        if self.lockStr[go_table] then
            go_table.obj_lockBg:SetActiveE(1)
            go_table.aortext_lock.text = self.lockStr[go_table]
            _G.GameUtil.ReBuildRTF(go_table.aortext_lock)
            local x = go_table.aortext_lock:GetRectTransformSizeDelta()
            local _, y1 = go_table.obj_lockBg:GetRectTransformSizeDelta()
            go_table.obj_lockBg:SetRectTransformSize(x + 30, y1)
        end
    end
    --_G.GameUtil.SetActiveByCondition(go_table.aorrawimage_double, self.double)
    -- if not lock then
    --     self:InitEffect()
    -- end
end

---更新死魂塔图标
function ChangllengeView:UpdateTowerIcon()
    local tb = self.itemList and self.itemList[202] and self.itemList[202].go_table or nil
    if not tb then
        return
    end

    local isUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.DeadsoulMain)
    if not isUnlock then
        tb.obj_towerIcon:SetActiveE(0)
        return
    end
    --是否满足挑战战力
    local towerId = require("DeadsoulTowerModel"):GetInstance().LandFloor
    if not towerId then
        tb.obj_towerIcon:SetActiveE(0)
        return
    end
    if towerId == 0 then
        --初始塔
        towerId = 90001
    end
    local mPower, ePower = _G.DeadsoulTowerManager:GetInstance():GetTowerPower(towerId)
    tb.obj_towerIcon:SetActiveE(mPower > ePower and 1 or 0)
end

---按钮点击事件在这里派发
function ChangllengeView:OnClickBtn(go, isOn)
    --_G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseOtherView()
        self:Close()
    elseif go == self.go_table.aorbtn_lingyushouwei then
        if self.lock[self.lingyushouwei] then
            local str = self.lockStr[self.lingyushouwei][1]
            for i = 2, #self.lockStr[self.lingyushouwei] do
                str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. self.lockStr[self.lingyushouwei][i]
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId[self.lingyushouwei][1], str)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
    elseif go == self.go_table.aorbtn_xuewanglaixi then
        if self.lock[self.xuewanglaixi] then
            --_G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId[self.xuewanglaixi], self.lockStr[self.xuewanglaixi])
            local str = self.lockStr[self.xuewanglaixi][1]
            for i = 2, #self.lockStr[self.xuewanglaixi] do
                str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. self.lockStr[self.xuewanglaixi][i]
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId[self.xuewanglaixi][1], str)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
    elseif go == self.go_table.aorbtn_arena then
        if self.lock[self.arena] then
            --_G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId[self.arena], self.lockStr[self.arena])
            local str = self.lockStr[self.arena][1]
            for i = 2, #self.lockStr[self.arena] do
                str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. self.lockStr[self.arena][i]
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId[self.arena][1], str)
            return
        end
        require("ArenaController"):GetInstance():OpenChooseArenaPanel()
    elseif go == self.go_table.aorbtn_plane then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WildADView.Name)
    elseif go == self.go_table.aorbtn_blackMarketExchange then
        local act = ActivitySynManager:GetInstance():GetActivityWithTypeId(10017)
        _G.GlobalInterface.JumpActivityByGM(10048, act:GetJumpType())
    end
end

function ChangllengeView:ShowPlane(bol)
    if bol ~= nil then
        self.go_table.aorbtn_plane:SetActiveE(bol and 1 or 0)
        return
    end
    self.go_table.aorbtn_plane:SetActiveE(require("AdvertisementModel"):GetInstance():CheckWildPlaneShow() and 1 or 0)
    if self.go_table.aorbtn_plane:GetActiveSelf() == 1 then
        self:InitNpc()
    end
end

---关闭其他界面
function ChangllengeView:CloseOtherView()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
    if window then
        window.View:Close()
    end
    window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
    if window then
        window.View:Close()
    end
end

function ChangllengeView:OnSixUpdate()
    if self.gameObject:GetActiveSelf() == 1 then
        self:InitView(false)
    end
end

function ChangllengeView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    self:RemoveAllListener()
    _G.Events:GetInstance():RemoveListener(_G.eAdvertisement.Refresh, self.ShowPlane, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.FunctionForbidden, self.RefreshView, self)
    _G.Events:GetInstance():RemoveListener(_G.DungeonChallengeBattleViewShow.Open, self.UpdateNewFunctionIcon, self)
    _G.Events:GetInstance():RemoveListener(_G.eBlackMarketExchange.BlackMarketExchangeOpen,
        self.UpdateBlackMarketExchange, self)
end

return ChangllengeView
