local ActivitySynManager = require "ActivitySynManager"
---@class ChangllengeView : UIBaseView    中文描述
---@field public go_table ChangllengeView_GoTable GoTable
---@field itemList ChangllengeItem[]
local ChangllengeView = _G.BaseClass("ChangllengeView", _G.UIBaseView)

function ChangllengeView:__init(obj)
    if obj then
        self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    end
end

function ChangllengeView:Awake()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    --_G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eAdvertisement.Refresh, self.ShowPlane, self)
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.FunctionForbidden, self.RefreshView, self)
    _G.Events:GetInstance():AddListener(_G.DungeonChallengeBattleViewShow.Open, self.UpdateNewFunctionIcon, self)
    _G.Events:GetInstance():AddListener(_G.eBlackMarketExchange.BlackMarketExchangeOpen, self.UpdateBlackMarketExchange,
        self)
end

---界面的入口函数
function ChangllengeView:OnCreate()
    self.itemList = {}
    self.lock = {}
    self.lockStr = {}
    self.tipsId = {}
    self.lingyushouwei = _G.GetAutoGoTable(self.go_table.aorbtn_lingyushouwei) --天灾之地
    self.xuewanglaixi = _G.GetAutoGoTable(self.go_table.aorbtn_xuewanglaixi)   --龙之试炼
    self.arena = _G.GetAutoGoTable(self.go_table.aorbtn_arena)                 --竞技场
    self.burningCrusade = _G.GetAutoGoTable(self.go_table.aorbtn_205)          --燃烧远征
    self.timePortal = _G.GetAutoGoTable(self.go_table.aorbtn_203)              --时空之门
    self.damijing = _G.GetAutoGoTable(self.go_table.aorbtn_213)                --大秘境
    self.blackMarketExchange = _G.GetAutoGoTable(self.go_table.aorbtn_blackMarketExchange)
    self:InitView(true)
    self:InitEffect()
    ---ZHJ-19851【黑暗本源】战斗回放场景内，挑战和主城UI没有隐藏。
    self:AddListener(_G.eBattleState.RecordStart, self.HideView)
    self:AddListener(_G.eBattleState.RecordEnd, self.ShowView)
    self:AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.RefreshView)
end

function ChangllengeView:OnEnable()
    self:UpdateNewFunctionIcon()
    self:UpdateTowerIcon()
end

function ChangllengeView:UpdateNewFunctionIcon()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(54) then
        self.timePortal.obj_newFunctionIcon:SetActiveE(0)
    else
        if _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "NewFunctionWearBoss") == 0
            or (_G.GameUtil.GetFunctionData(_G.FunctionBlock.game_type) ~= 1 and 
                _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "NewFunction") == 0)
        then
            self.timePortal.obj_newFunctionIcon:SetActiveE(1)
        else
            self.timePortal.obj_newFunctionIcon:SetActiveE(0)
        end
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune) then
        self.damijing.obj_newFunctionIcon:SetActiveE(0)
    else
        local isShow = require("SecretRealmModel"):GetInstance():CheckOpenIndex()
        self.damijing.obj_newFunctionIcon:SetActiveE(isShow == true and 1 or 0)
    end
end

function ChangllengeView:RefreshView(id)
    if self.itemList then
        local flag = false
        for _, v in pairs(self.itemList) do
            if v.cfg and v.cfg.function_open == id then
                flag = true
                v:Init(v.cfg)
                break
            end
        end

        if not flag and self.functionList then
            for _id, goTable in pairs(self.functionList) do
                if _id == id then
                    self:InitItem(goTable, _id)
                    break
                end
            end
        end
    end
    self:UpdateTowerIcon()
end

