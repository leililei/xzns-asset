---@class HazardousItem	中文描述
---@field go_table ChangllengeView._aorbtn_101_GoTable
local HazardousItem = _G.BaseClass("HazardousItem")
local GetLangPackValue = _G.GetLangPackValue
local function_open_cfg = _G.ConfigManager.function_open_cfg
local afk_cfg = _G.ConfigManager.afk_cfg

local decorationBossId = 210
local effect = {
    [204] = _G.ConfigManager.ui_effect_cfg.ef_HazardousLocationsView_blue,
    [209] = _G.ConfigManager.ui_effect_cfg.ef_HazardousLocationsView_brown,
    [212] = _G.ConfigManager.ui_effect_cfg.ef_HazardousLocationsView_red,
    [decorationBossId] = _G.ConfigManager.ui_effect_cfg.ef_HazardousLocationsView_red
}
---类的构造函数
function HazardousItem:__init(go, cfg, CloseCall)
    self.closeCall = CloseCall
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
    self.cfg = cfg
    self.view = cfg.views
    self:Init()
end

---@param cfg system_cfg
function HazardousItem:Init()
    if not self.cfg then
        return
    end
    self.go_table.aorrawimage_bg:LoadImage(self.cfg.image_sub)
    self.double = require("DoubleResourcesModel"):GetInstance():FanHui(self.cfg.id)
    self.lockStr, self.tipsId = _G.FunctionManager:GetInstance():GetTipsStr(self.cfg.function_id)
    self.go_table.aorrawimage_double:SetActiveE(self.double and 1 or 0)
    self.go_table.aortext_Name.text = GetLangPackValue(self.cfg.name)
    self.lock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_id)
    self.go_table.obj_Lock:SetActiveE(self.lock and 1 or 0)
    self.go_table.obj_Open:SetActiveE(self.lock and 0 or 1)
    self.go_table.aorrawimage_bg:SetGray(self.lock)
    self.go_table.aorrawimage_double:SetGray(self.lock)
    if self.lock then
        --self.lockStr = string.sub(self.lockStr, 16, -9)
        self.go_table.aortext_condition.text = self.lockStr
    else
        self.go_table.obj_Last:SetActiveE(self.cfg.type_pve == 2 and 1 or 0)
        self.go_table.aortext_NoCount:SetActiveE(self.cfg.type_pve == 1 and 1 or 0)
        if self.cfg.type_pve == 2 then
            local count = 0
            if self.cfg.id == 204 then
                count = require "WorldBossModel":GetInstance():GetCrusadeNum()
            elseif self.cfg.id == 209 then
                count = require "BlackSourceModel":GetInstance():GetFightNum()
            elseif self.cfg.id == decorationBossId then
                count = require("DecorationBossModel"):GetInstance():GetLeftAwardTimes()
            end
            self.go_table.aortext_last.text = count
        end
    end
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.cfg.redpoint_cfg)
    local preciousPreview = self.cfg.precious_preview
    if not _G.table.isEmptyOrNil(preciousPreview) then
        self.go_table.obj_Award:SetActiveE(1)
        for i = 1, #preciousPreview do
            _G.StorageManager:GetInstance():GetItemBaseView(
                preciousPreview[i],
                1,
                self.go_table.obj_Award,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.9)
                    tran:ShowNumText(false)
                end
            )
        end
    else
        self.go_table.obj_Award:SetActiveE(0)
    end
    if not self.lock then
        self:InitEffect()
    end
end

function HazardousItem:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        effect[self.cfg.id],
        self.go_table.transform,
        function(trans)
            if _G.IsNil(self.go_table.gameObject) then
                _G.DestroyObject(trans)
            end
        end
    )
end

---类的析构函数
function HazardousItem:Dispose()
    self.double = nil
    self.lock = nil
    self.cfg = nil
end
---监听界面打开
---@param name string 界面名称
function HazardousItem:OnViewOpened(name)
    if name == self.view then
        if self.closeCall then
            self.closeCall()
        end
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    end
end
function HazardousItem:OnClickBtn(go, isOn)
    if self.lock then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId, self.lockStr)
        return
    end
    if self.cfg then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        if self.cfg.id == decorationBossId then
            require("DecorationBossController"):GetInstance():OpenView(_G.handler(self, self.OnViewOpened))
        else
            _G.UIManager:GetInstance():OpenWindow(self.view)
        end
    end
end
return HazardousItem
