function ChangllengeItem:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
    if self.lock then
        local str = self.lockStr[1]
        for i = 2, #self.lockStr do
            str = str .. _G.LangUtil.GetLangPackValue(9002010024) .. self.lockStr[i]
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId[1], str)
        --_G.PopWindowManager:GetInstance():ShowAllTips(self.tipsId, self.lockStr)
        return
    end
    if self.cfg then
        if self.cfg.id == 202 then
            _G.DeadsoulTowerManager:GetInstance():OpenDeadsoul(self.cfg.id)
        else
            if self.cfg.id == 201 then
                require "RequestSubscribeModel":GetInstance():DoRS(3)
            end
            if self.cfg.views == "SystemFairylandView" then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungeonChallengeHallView.Name)
            else
                _G.UIManager:GetInstance():OpenWindow(self.cfg.views)
            end
        end
    end
end

---视频切换到 界面 ，淡入淡出
function ChangllengeItem:VideoCutUiView()
    local showTime = 1
    local colorRgb = nil
    colorRgb = { 0 / 255, 0 / 255, 0 / 255, 1 }
    local tagerAlpha = 1
    self.BalckMaskView.go_table.aorrawimage_curtain.color =
        _G.Color.New(colorRgb[1], colorRgb[2], colorRgb[3], colorRgb[4])
    if self.TweenerIng ~= nil then
        self.TweenerIng:Kill(true)
        self.TweenerIng = nil
    end
    self.TweenerIng = self.BalckMaskView.go_table.aorrawimage_curtain:DOFade(0, showTime)
    self.TweenerIng:SetEase(_G.CS.DG.Tweening.Ease.InQuad)
    self.TweenerIng.onComplete =
        _G.handler(
            self,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BlackCurtainView.Name)
                self.TweenerIng:Kill(true)
            end
        )
end

return ChangllengeItem
