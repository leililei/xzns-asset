---类的构造函数
function ChangllengeItem:__init(go)
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
end

---@param cfg system_cfg
function ChangllengeItem:Init(cfg)
    if not cfg then
        return
    end
    self.cfg = cfg
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ChallengeViewBuild .. self.cfg.id, self.go_table)
    if self.cfg.id < 200 then
        self.lock = false
        for _, v in pairs(_G.ConfigManager.system_cfg) do
            if v.id ~= 104 then
                if v.display_priority == 1 then
                    self.cfg = v
                    break
                end
            end
        end
    end
    self.lock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    if self.lock then
        if _G.FunctionManager:GetInstance():CheckFunctionForbidden(self.cfg.function_open) then
            self.tipsId = { 1020010 }
            self.lockStr = {}
        else
            self.lockStr, self.tipsId = _G.FunctionManager:GetInstance():GetAllTipsStr(self.cfg.function_open)
        end
    end
    self.double = require("DoubleResourcesModel"):GetInstance():FanHui(self.cfg.id)
    self.go_table.obj_lockBg:SetActiveE(0)
    --self.go_table.obj_mask:SetActiveE(self.lock and 1 or 0)
    ---如果未解锁 图片置灰
    --self.go_table.aorrawimage_icon:SetGray(self.lock)
    --self.go_table.aorrawimage_double:SetGray(self.lock)
    -- if self.go_table.aorrawimage_iconChild then
    --     self.go_table.aorrawimage_iconChild:SetGray(self.lock)
    -- end
    if AppSetting.IsXzns then
        self.go_table.obj_mask:SetActiveE(self.lock and 1 or 0)
        self.go_table.aorrawimage_icon:SetActiveE(self.lock and 0 or 1)
        if self.go_table.obj_eff then
            self.go_table.obj_eff:SetActiveE(self.lock and 0 or 1)
        end
    end
    if self.go_table.obj_suo then
        self.go_table.obj_suo:SetActiveE(self.lock and 1 or 0)
        self.go_table.aorrawimage_item:SetActiveE(self.lock and 0 or 1)
    end
    if self.lock then
        if self.lockStr then
            self.go_table.obj_lockBg:SetActiveE(1)
            self.go_table.aortext_lock.text = self.lockStr
            _G.GameUtil.ReBuildRTF(self.go_table.aortext_lock)
            local x = self.go_table.aortext_lock:GetRectTransformSizeDelta()
            local _, y1 = self.go_table.obj_lockBg:GetRectTransformSizeDelta()
            self.go_table.obj_lockBg:SetRectTransformSize(x + 30, y1)
        end
    end
    self.go_table.aorrawimage_double:SetActiveE(self.double and 1 or 0)
    -- if not self.lock then
    --     self:InitEffect()
    -- end
end

function ChangllengeItem:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        Effect[self.cfg.id],
        self.go_table.transform,
        function(obj)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(obj)
            end
        end
    )
end

