---@class SystemAdventureNewItem
local SystemAdventureNewItem = _G.BaseClass("SystemAdventureNewItem")

function SystemAdventureNewItem:__init(obj, click)
    self.gameObject = obj
    self.transform = obj
    self.clickCall = click
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.effect = nil
    self.Color = {White = _G.Color.New(1, 1, 1, 1), Gray = _G.Color.New(0.39, 0.39, 0.39, 1)}
end

function SystemAdventureNewItem:OnClickBtn(go)
    if self.go_table.obj_mask:GetActiveSelf() == 1 then
        return
    end
    if self.clickCall then
        self.clickCall(self.cfg.id)
    end
end

---更新显示
---@param cfg system_cfg_Item
---@param data
function SystemAdventureNewItem:Show(cfg)
    self.cfg = cfg
    if self.effect then
        _G.PoolsManager:GetInstance():Despawn(self.effect, _G.ePoolType.Temporary)
        self.effect = nil
    end
    local open = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    _G.PoolsManager:GetInstance():Spawn(
        self.cfg.image,
        _G.ePoolType.Temporary,
        self.go_table.trans_root,
        function(trans)
            local sg = trans:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            local count, num = require("SystemEntranceModel"):GetInstance():GetTimes(self.cfg.id)
            if open and count > 0 then
                sg.color = self.Color.White
            else
                sg.color = self.Color.Gray
            end
            self.effect = trans
            self.spawnEffect = false
        end
    )

    if require("DoubleResourcesModel"):GetInstance():FanHui(self.cfg.id) then
        self.go_table.aorimage_XianShi:SetActiveE(1)
    else
        self.go_table.aorimage_XianShi:SetActiveE(0)
    end
    if open then
        self:UpdateTimes()
    else
        self.go_table.obj_mask:SetActiveE(1)
        self.go_table.aortext_num.text = require("SystemEntranceModel"):GetInstance():GetFunctionLimitText(self.cfg.id)
        self.go_table.aortext_num:SetActiveE(1)
        self.go_table.obj_lock:SetActiveE(1)
        self.go_table.obj_complete:SetActiveE(0)
    end
end

---更改剩余次数
function SystemAdventureNewItem:UpdateTimes()
    if self.cfg.count_reset == 0 then
        self.go_table.aortext_num:SetActiveE(0)
        self.go_table.obj_lock:SetActiveE(0)
        self.go_table.obj_mask:SetActiveE(0)
        if self.effect then
            local sg = self.effect:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.color = self.Color.White
        end
        return
    else
        self.go_table.aortext_num:SetActiveE(1)
    end
    local count, num = require("SystemEntranceModel"):GetInstance():GetTimes(self.cfg.id)
    if self.cfg.id == 204 then
        self.go_table.aortext_num.text = _G.string.format(_G.LangUtil.GetLangPackValue(90022900034), count, num)
    else
        self.go_table.aortext_num.text = _G.LangUtil.GetLangPackValue(90022500426, (count .. "/" .. num))
    end
    if count == 0 and self.cfg.id ~= 204 then
        self.go_table.obj_lock:SetActiveE(0)
        self.go_table.obj_complete:SetActiveE(1)
        self.go_table.obj_mask:SetActiveE(1)
        if self.effect then
            local sg = self.effect:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.color = self.Color.Gray
        end
    else
        self.go_table.obj_mask:SetActiveE(0)
        if self.effect then
            local sg = self.effect:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.color = self.Color.White
        end
    end
end

---@class SystemAdventureNewView : UIBaseView	中文描述
---@field public go_table SystemAdventureNewView_GoTable GoTable
local SystemAdventureNewView = _G.BaseClass("SystemAdventureNewView", _G.UIBaseView)
--_G.SystemAdventureNewView = SystemAdventureNewView

local systemType = 2
function SystemAdventureNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SystemAdventureNewView:OnCreate(transBG, doneCall)
    self.itemList = {}
    self.doneCall = doneCall
    self.go_table.looplist2_List:InitListView(0, _G.handler(self, self.RefreshList))
    self.itemCount = 0
    self.cfgs = nil
    require("SystemEntranceModel"):GetInstance():AddTimesChangeListener(
        "SystemAdventureView",
        _G.handler(self, self.UpdateTimes)
    )
end

function SystemAdventureNewView:RefreshList(listView2, index)
    local newIndex = index + 1
    local listItem = listView2:NewListViewItem("$_obj_ListItem")
    listItem:SetName(self.cfgs[newIndex].id)
    local instanceID = listItem:GetInstanceIDE()
    local item = self.itemList[instanceID]
    if not item then
        item = SystemAdventureNewItem.New(listItem, _G.handler(self, self.OnItemClick))
        self.itemList[instanceID] = item
    end
    item:Show(self.cfgs[newIndex])
    self.itemDic[self.cfgs[newIndex].id] = item
    return listItem
end

function SystemAdventureNewView:OnItemClick(id)
    require("SystemEntranceModel"):GetInstance():OnSystemClick(id)
end

function SystemAdventureNewView:Show()
    if not self.cfgs then
        self.cfgs = {}
        for _, value in pairs(_G.ConfigManager.system_cfg) do
            if value.type_pve == systemType then
                _G.table.insert(self.cfgs, value)
            end
        end
        self.itemCount = #self.cfgs
    end
    self:SortCfgs(self.cfgs)
    if not self.itemDic then
        self.itemDic = {}
        self.go_table.looplist2_List:SetListItemCount(self.itemCount)
    else
        self.go_table.looplist2_List:RefreshAllShownItem()
    end
    if self.doneCall then
        self.doneCall()
    end
end

function SystemAdventureNewView:OnEnable()
    self:Show()
end

function SystemAdventureNewView:OnDestroy()
    require("SystemEntranceModel"):GetInstance():RemoveTimesChangeListener("SystemAdventureView")
end

function SystemAdventureNewView:SortCfgs(cfgs)
    _G.table.sort(
        cfgs,
        function(a, b)
            local openA = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(a.function_open)
            local openB = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(b.function_open)
            if (openA and openB) or (not openA and not openB) then
                local countA = require("SystemEntranceModel"):GetInstance():GetTimes(a.id)
                local countB = require("SystemEntranceModel"):GetInstance():GetTimes(b.id)
                if a.count_reset == 0 and b.count_reset == 0 then
                    return a.id < b.id
                elseif a.count_reset == 0 or b.count_reset == 0 then
                    return a.count_reset < b.count_reset
                elseif (countA > 0 and countB > 0) or (countA == 0 and countB == 0) then
                    return a.id < b.id
                else
                    return countA > 0
                end
            elseif not openA and not openB then
                return a.id < b.id
            else
                if openA then
                    return true
                else
                    return false
                end
            end
        end
    )
end

function SystemAdventureNewView:UpdateTimes(id)
    if self.itemDic[id] then
        self.itemDic[id]:UpdateTimes()
    end
end
function SystemAdventureNewView:GetPosition()
    return self.go_table.obj_Content:GetAnchorPosition()
end
