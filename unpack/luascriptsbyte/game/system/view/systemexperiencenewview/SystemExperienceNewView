---@class SystemExperienceNewItem
local SystemExperienceNewItem = _G.BaseClass("SystemExperienceNewItem")
local GetLangPackValue = _G.GetLangPackValue
function SystemExperienceNewItem:__init(obj, click)
    self.gameObject = obj
    self.transform = obj
    self.clickCall = click
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.effect = nil
    self.sg = nil
    self.Color = {White = _G.Color.New(1, 1, 1, 1), Gray = _G.Color.New(0.39, 0.39, 0.39, 1)}
end

function SystemExperienceNewItem:OnClickBtn(go)
    if not self.isOpen and self.go_table.obj_mask:GetActiveSelf() == 1 then
        return
    end
    if self.clickCall then
        self.clickCall(self.cfg.id)
    end
end

---更新显示
---@param cfg system_cfg_Item
---@param data
function SystemExperienceNewItem:Show(cfg)
    self.cfg = cfg
    if self.effect then
        _G.DestroyObject(self.effect)
        self.effect = nil
    end
    self.isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    _G.PoolsManager:GetInstance():Spawn(
        self.cfg.image,
        _G.ePoolType.Temporary,
        self.go_table.trans_root,
        function(trans)
            trans:SetParentE(self.go_table.trans_root)
            self.effect = trans
            trans:SetLocalPositionToZero()
            trans:SetLocalScaleToOne()
            self.sg = trans:GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            if self.isOpen then
                self.sg.color = self.Color.White
            else
                self.sg.color = self.Color.Gray
            end
        end
    )

    if require("DoubleResourcesModel"):GetInstance():FanHui(self.cfg.id) then
        self.go_table.aorimage_XianShi:SetActiveE(1)
    else
        self.go_table.aorimage_XianShi:SetActiveE(0)
    end
    if self.isOpen then
        self:UpdateTimes()
    else
        self.go_table.obj_mask:SetActiveE(1)
        self.go_table.aortext_num.text = require("SystemEntranceModel"):GetInstance():GetFunctionLimitText(self.cfg.id)
        self.go_table.aortext_num:SetActiveE(1)
        self.go_table.obj_lock:SetActiveE(1)
        self.go_table.obj_complete:SetActiveE(0)
    end
end

---更改剩余次数
function SystemExperienceNewItem:UpdateTimes()
    if self.cfg.count_reset == 0 then
        self.go_table.aortext_num:SetActiveE(0)
        self.go_table.obj_lock:SetActiveE(0)
        self.go_table.obj_mask:SetActiveE(0)
        return
    else
        self.go_table.aortext_num:SetActiveE(1)
    end
    local count, num = require("SystemEntranceModel"):GetInstance():GetTimes(self.cfg.id)
    if self.cfg.id <= 104 then
        self.go_table.aortext_num.text = GetLangPackValue(90022500433, (count .. "/" .. num))
    else
        self.go_table.aortext_num.text = GetLangPackValue(90022500426, count .. "/" .. num)
    end

    -- if count == 0 then
    --     self.go_table.obj_lock:SetActiveE(0)
    --     self.go_table.obj_complete:SetActiveE(1)
    --     self.go_table.obj_mask:SetActiveE(1)
    -- else
    --     self.go_table.obj_mask:SetActiveE(0)
    -- end
    self.go_table.obj_mask:SetActiveE(0)
end

---@class SystemExperienceNewView : UIBaseView    中文描述
---@field public go_table SystemExperienceNewView_GoTable GoTable
local SystemExperienceNewView = _G.BaseClass("SystemExperienceNewView", _G.UIBaseView)
--_G.SystemExperienceNewView = SystemExperienceNewView

local systemType = 1
function SystemExperienceNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SystemExperienceNewView:OnCreate(transBG, doneCall)
    self.itemList = {}
    self.itemDic = {}
    self.doneCall = doneCall
    local x, y = _G.UIManager:GetInstance().UIRootRect:GetRectTransformSize()
    self.go_table.looplist2_List:InitListView(0, _G.handler(self, self.RefreshList))
    self.itemCount = 0
    self.cfgs = nil
    self.endPos = require "SystemMaterialController":GetInstance().endPosition
end

function SystemExperienceNewView:RefreshList(listView2, index)
    local newIndex = index + 1
    local listItem = listView2:NewListViewItem("$_obj_ListItem")
    listItem:SetName(self.cfgs[newIndex].id)
    local item = SystemExperienceNewItem.New(listItem, _G.handler(self, self.OnItemClick))
    _G.table.insert(self.itemList, item)
    item:Show(self.cfgs[newIndex])
    self.itemDic[self.cfgs[newIndex].id] = item
    if self.endPos and newIndex == self.itemCount then
        self.go_table.obj_Content:SetAnchorPosition(self.endPos.x, self.endPos.y)
        self.endPos = nil
        require "SystemMaterialController":GetInstance().endPosition = nil
    end
    return listItem
end

function SystemExperienceNewView:OnItemClick(id)
    require("SystemEntranceModel"):GetInstance():OnSystemClick(id)
end

function SystemExperienceNewView:Show()
    if not self.cfgs then
        self.cfgs = {}
        for key, value in pairs(_G.ConfigManager.system_cfg) do
            if value.type_pve == systemType and value.id ~= 104 then
                _G.table.insert(self.cfgs, value)
            end
        end
        self.itemCount = #self.cfgs
    end

    self:SortCfgs(self.cfgs)

    self.go_table.looplist2_List:SetListItemCount(self.itemCount)
    if self.doneCall then
        self.doneCall()
    end
end

function SystemExperienceNewView:OnEnable()
    self:Show()
    require("SystemEntranceModel"):GetInstance():AddTimesChangeListener(
        "SystemExperienceView",
        _G.handler(self, self.UpdateTimes)
    )
end

function SystemExperienceNewView:OnDisable()
    -- require("SystemEntranceModel"):GetInstance():RemoveTimesChangeListener("SystemExperienceView")
end

function SystemExperienceNewView:OnDestroy()
    require("SystemEntranceModel"):GetInstance():RemoveTimesChangeListener("SystemExperienceView")
end

function SystemExperienceNewView:SortCfgs(cfgs)
    _G.table.sort(
        cfgs,
        function(a, b)
            local openA = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(a.function_open)
            local openB = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(b.function_open)
            if openA and openB then
                local countA = require("SystemEntranceModel"):GetInstance():GetTimes(a.id)
                local countB = require("SystemEntranceModel"):GetInstance():GetTimes(b.id)
                if a.count_reset == 0 and b.count_reset == 0 then
                    return a.id < b.id
                elseif a.count_reset == 0 or b.count_reset == 0 then
                    return a.count_reset < b.count_reset
                elseif (countA > 0 and countB > 0) or (countA == 0 and countB == 0) then
                    return a.id < b.id
                else
                    return countA > 0
                end
            elseif not openA and not openB then
                return a.id < b.id
            else
                if openA then
                    return true
                else
                    return false
                end
            end
        end
    )
end

function SystemExperienceNewView:UpdateTimes(id)
    if self.itemDic[id] then
        self.itemDic[id]:UpdateTimes()
    end
end

function SystemExperienceNewView:GetPosition()
    return self.go_table.obj_Content:GetAnchorPosition()
end

---按钮点击事件在这里派发
function SystemExperienceNewView:OnClickBtn()
end

return SystemExperienceNewView
