---@class HazardousLocationsView : UIBaseView	中文描述
---@field public go_table HazardousLocationsView_GoTable GoTable
---@field itemList ChangllengeItem[]
local HazardousLocationsView = _G.BaseClass("HazardousLocationsView", _G.UIBaseView)
local entranceCfg = _G.ConfigManager.entrance_cfg
local GetLangPackValue = _G.GetLangPackValue
function HazardousLocationsView:Awake()
    self.UiDic = {
        self.go_table.obj_item1,
        self.go_table.obj_item2,
        self.go_table.obj_item3,
        self.go_table.obj_items4
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HazardousLocationsView:OnCreate()
    --require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HellGuard.id)
    local go
    for _, v in pairs(entranceCfg) do
        go = self.go_table["obj_items" .. v.order]
        if go then
            require "HazardousItem".New(go, v, _G.handler(self, self.Close))
        end
    end
end
---按钮点击事件在这里派发
function HazardousLocationsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Bg then
        self:Close()
    end
end

return HazardousLocationsView
