---试炼塔跨天刷新数据
function DeadsoulTowerManager:GetPractice(back)
    ---获取试炼塔信息
    ---@param msg dead_soul.s2c_dead_soul_practice
    DeadsoulTowerNet:GetInstance():DeadSoulPractice(
        nil,
        function(msg)
            for i = 1, #msg.open_tower do
                ---@type dead_soul.tower_info
                local towerInfo = msg.open_tower[i]
                local pfr = DeadsoulTowerModel:GetInstance().PracticeFloor[towerInfo.type]
                pfr.high_floor = towerInfo.high_floor
                pfr.pass_num = towerInfo.pass_num
                pfr.award_list = towerInfo.award_list
            end

            if back then
                back()
            end
        end
    )
end

---更新一下刷新时间
function DeadsoulTowerManager:UpdateWeek()
    local now = _G.CS.YoukiaCore.TimeKit.GetNowUnixTime() - _G.TimeUtil.GAME_DAY_TIME
    local tb = _G.TimeUtil.GetDateTime(now)
    local getWeek = tb.week == 0 and 7 or tb.week
    if getWeek ~= DeadsoulTowerModel:GetInstance().CurWeek then
        DeadsoulTowerModel:GetInstance().CurWeek = getWeek

        if _G.AppSetting.DEBUG then
            _G.Log(DeadsoulTowerModel:GetInstance().PracticeFloor, "跨天刷新五行数据")
        end
        local window1 = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
        if window1 and window1.View then
            window1.View:Show()
            window1.View:UpdateFightFloor()
        end
