---检查布阵角色是否全部满足
---@param sid number    @关卡sid
---@return boolean
function DeadsoulTowerManager:CheckEmbattleValid(sid)
    local cfg = _G.ConfigManager.tower_cfg[sid]
    if not cfg then
        return false
    end

    --获取布阵id
    ---@type number[]
    local embattleIds = {}
    table.insert(
        embattleIds,
        cfg.tower == 1 and _G.EmbattleType.Tower1 or
        cfg.tower == 2 and _G.EmbattleType.Tower2 or
        cfg.tower == 3 and _G.EmbattleType.Tower3 or
        cfg.tower == 4 and _G.EmbattleType.Tower4 or
        cfg.tower == 5 and _G.EmbattleType.Tower5 or
        cfg.tower == 9 and _G.EmbattleType.Tower or
        _G.EmbattleType.Tower
    )
    if cfg.monster and #cfg.monster[1] > 1 then
        for i = 1, #cfg.monster[1] do
            if i == 1 then
                embattleIds[i] = embattleIds[i] * 1000 + 1
            else
                table.insert(embattleIds, embattleIds[i - 1] + 1)
            end
        end
    end

    --布阵id是否都是有效的
    ---@type EmbattleModel
    local embattleModel = require("EmbattleModel"):GetInstance()
    for _, embattleId in pairs(embattleIds) do
        if not embattleModel:CheckEmbattleData(embattleId) then
            return false
        end
    end
    return true
end

---检查当前关卡布阵是否满足
---@return boolean
function DeadsoulTowerManager:CheckCurrentEmbattleValid()
    return self:CheckEmbattleValid(require("DeadsoulTowerModel"):GetInstance():GetCurTowerSid())
end

---更新下一场战斗的布阵(多场战斗)
---@param index number 下一场战斗的索引
---@param callback fun(ok:boolean,index:number):void
function DeadsoulTowerManager:UpdateNextEmbattle(callback)
    local sid = require("DeadsoulTowerModel"):GetInstance():GetCurTowerSid()
    local cfg = _G.ConfigManager.tower_cfg[sid]
    if not cfg or not cfg.monster or #cfg.monster[1] == 1 then
        if callback then
            callback(true, 1)
        end
        return
    end

    ---@type EmbattleModel
    local embattleModel = require("EmbattleModel"):GetInstance()
    ---获取当前挑战中的布阵id, 并且校验布阵数据
    local curEmbattleId = cfg.tower == 1 and _G.EmbattleType.Tower1 or
        cfg.tower == 2 and _G.EmbattleType.Tower2 or
        cfg.tower == 3 and _G.EmbattleType.Tower3 or
        cfg.tower == 4 and _G.EmbattleType.Tower4 or
        cfg.tower == 5 and _G.EmbattleType.Tower5 or
        cfg.tower == 9 and _G.EmbattleType.Tower or
        _G.EmbattleType.Tower
    local curEmbattleIndex = 1
    local groups = _G.DeadsoulTowerManager:GetInstance():GetSceneID()
    for i = 1, #groups do
        if not self:CheckMonsterIsPass(groups[i]) then
            curEmbattleIndex = i
            break
        end
    end
    curEmbattleId = curEmbattleId * 1000 + curEmbattleIndex
    if not embattleModel:CheckEmbattleData(curEmbattleId) then
        if callback then
            callback(false)
        end
        return
    end
    --更新布阵数据
    embattleModel:SaveEmbattleDataNew(
        curEmbattleId,
        function(ret)
            if callback then
                callback(ret == 0, curEmbattleIndex)
            end
        end,
        _G.EmbattleSaveType.localfile,
        false
    )
end

