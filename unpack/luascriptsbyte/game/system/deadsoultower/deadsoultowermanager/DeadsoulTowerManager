function DeadsoulTowerManager:QuickChallenges(towerid, maxTower, callback)
    --是不是主塔
    if DeadsoulTowerModel:GetInstance().CurTowerType ~= 9 then
        return
    end
    ---测试代码
    self.ent = true
    self.quickFightCallBack = callback
    self.stopCoProgress = _G.coroutine.start(_G.handlerbind(self, self.CoProgressCheckTower, towerid, maxTower))
end

---协程检测
function DeadsoulTowerManager:CoProgressCheckTower(towerid, maxTower)
    local towersid = towerid
    local temp = 0

    while self.ent do
        if temp >= self.max_pass_limit then
            self.ent = false
            break
        end
        if self.towercfg[towersid].layer >= maxTower then
            self.ent = false
            break
        end
        if self:CheckQuickPower(towersid) then
            self.ent = false
            break
        end
        temp = temp + 1
        towersid = towersid + 1
    end
    self:SendQuickFight(towerid, temp)
end

