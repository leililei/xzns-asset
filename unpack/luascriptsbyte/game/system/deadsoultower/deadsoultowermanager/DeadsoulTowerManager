---外部跳转接口
function DeadsoulTowerManager.JumpDeadsoul()
    --显示野外窗口
    _G.MainManager:GetInstance():ShowWildWindow()

    --如果正在战斗中, 则不要实际打开界面
    if _G.DeadsoulTowerManager:GetInstance():IsFighting() then
        _G.JumpManager:GetInstance():OnViewOpened(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
        --_G.Events:GetInstance():Broadcast(_G.eUIManagerStatus.OnUIShow, _G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
    else
        DeadsoulTowerModel:GetInstance().CurTowerType = DeadsoulTowerModel:GetInstance().MianTower
        DeadsoulTowerManager:GetInstance():OpenDeadsoul(201)
    end
end

---打开爬塔的界面
function DeadsoulTowerManager:OpenDeadsoulView(id, isFightWin, callback)
    if nil == isFightWin then
        isFightWin = false
    end
    DeadsoulTowerModel:GetInstance().SystemId = id

    if not isFightWin then
        --是否打开爬塔玩法页面
        local openDeadsoulView = false
        if DeadsoulTowerModel:GetInstance().IsOpenWx then
            local window1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
            if window1 then
                window1:Show()
                window1:UpdateFightFloor()
            else
                --强制打开死魂塔页面
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DeadsoulTowerView.Name,
                    DeadsoulTowerModel:GetInstance().CurTowerType
                )
            end
            --检查当前塔是否开启中
            local towerType = DeadsoulTowerModel:GetInstance().CurTowerType
            if towerType == 9 or DeadsoulTowerModel:GetInstance():CheckWeek(towerType) then
                if not window1 then
                    --先关闭爬塔玩法页面, 然后依次打开: 列表页面 -> 玩法页面O
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                end
                openDeadsoulView = true
            end
        else
            openDeadsoulView = true
        end
        if openDeadsoulView then
            local window2 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
            if window2 then
                window2:Show()
                window2:UpdateFightFloor(false)
            else
                --强制打开死魂塔页面
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DeadsoulView.Name,
                    DeadsoulTowerModel:GetInstance().CurTowerType
                )
            end
        else
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
        end
        if callback then
            callback()
        end
        return
    end
    if DeadsoulTowerModel:GetInstance().CurTowerType == DeadsoulTowerModel:GetInstance().MianTower then
        ---获取主塔信息
        ---@param msg dead_soul.s2c_dead_soul_island
        DeadsoulTowerNet:GetInstance():DeadSoulIsland(
            nil,
            function(msg)
                DeadsoulTowerModel:GetInstance().LandFloor = msg.high_floor
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.DeadSoulDailyReward.id
                )
                DeadsoulTowerModel:GetInstance().target_list = msg.target_list or {}
                DeadsoulTowerModel:GetInstance().award_list = msg.award_list
                DeadsoulTowerModel:GetInstance():UpdateAwardDatas()
                local unlockFloor = _G.ConfigManager.discrete_cfg[102301][1][1]
                ---主塔层级达到开试炼的条件
                local isFinishFloor = msg.high_floor
                if isFinishFloor > 0 then
                    isFinishFloor = _G.ConfigManager.tower_cfg[isFinishFloor].layer
                end
                _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {
                        _G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor
                    },
                    1
                )
                if
                    isFinishFloor >= unlockFloor and
                        _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Deadsoul)
                 then
                    DeadsoulTowerModel:GetInstance().IsOpenWx = true
                else
                    DeadsoulTowerModel:GetInstance().IsOpenWx = false
                end
                if callback then
                    callback()
                end
            end
        )
    else
        self:GetPractice(
            function()
                if callback then
                    callback()
                end
            end
        )
    end

    if not _G.PlayerPrefsManager.HasKey("OpenDeadsoulTowerView") then
        _G.PlayerPrefsManager.SetInt("OpenDeadsoulTowerView", 1)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainChallenge.id, 201)
    end
end

---打开死魂岛
---@field id number System配置id
---@field openDs boolean 打开死魂岛塔界面
---@field isFightWin boolean isFightWin 战斗胜利结束
function DeadsoulTowerManager:OpenDeadsoul(id, openDs, isFightWin)
    if nil == openDs then
        openDs = false
    end
    if nil == isFightWin then
        isFightWin = false
    end
    DeadsoulTowerModel:GetInstance().SystemId = id
    ---获取主塔信息
    ---@param msg dead_soul.s2c_dead_soul_island
    DeadsoulTowerNet:GetInstance():DeadSoulIsland(
        nil,
        function(msg)
            DeadsoulTowerModel:GetInstance().LandFloor = msg.high_floor
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadSoulDailyReward.id)
            DeadsoulTowerModel:GetInstance().target_list = msg.target_list or {}
            DeadsoulTowerModel:GetInstance().award_list = msg.award_list or {}
            DeadsoulTowerModel:GetInstance():UpdateAwardDatas()
            local unlockFloor = _G.ConfigManager.discrete_cfg[102301][1][1]

            if _G.AppSetting.DEBUG then
                _G.Log(unlockFloor, "试炼塔要求层数")
            end
            ---主塔层级达到开试炼的条件
            local isFinishFloor = msg.high_floor
            if isFinishFloor > 0 then
                isFinishFloor = _G.ConfigManager.tower_cfg[isFinishFloor].layer
            end

            if _G.AppSetting.DEBUG then
                _G.Log(isFinishFloor, "当前塔层数")
            end
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor
                },
                1
            )
            _G.Events:GetInstance():Broadcast(_G.ePopGiftEvent.FinishDead)

            if
                isFinishFloor >= unlockFloor and
                    _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Deadsoul)
             then
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)   --关闭缓存的DeadsoulView界面
                local window1 = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
                if window1 and window1.View then
                    --- 偶尔会触发 死魂塔 黑屏

                    if _G.AppSetting.DEBUG then
                        _G.Log("死魂塔黑屏", "<color=red>" .. ">>>" .. "</color>")
                    end
                    window1.View:Show()
                    window1.View:UpdateFightFloor()
                else
                    for i = 1, 5 do
                        DeadsoulTowerModel:GetInstance().PracticeFloor[i] = {
                            name = _G.table.keyof(DeadsoulTowerModel:GetInstance().TowerProps, i),
                            high_floor = 0,
                            pass_num = 0
                        }
                    end
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DeadsoulTowerView.Name,
                        id,
                        openDs,
                        isFightWin
                    )
                end
                DeadsoulTowerModel:GetInstance().IsOpenWx = true
                --刷新 死魂塔 五行塔开启刷新 红点
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.DeadsoulMain.id
                )
            else
                DeadsoulTowerModel:GetInstance().IsOpenWx = false
                ---@type DeadsoulView
                local window1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                if window1 then
                    window1:Show()
                    window1:UpdateFightFloor()
                else
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DeadsoulView.Name,
                        DeadsoulTowerModel:GetInstance().CurTowerType,
                        isFightWin
                    )
                end
            end
        end
    )
end

---检测是否
function DeadsoulTowerManager:CheckPlayerTowerVideo()
    local floor = DeadsoulTowerModel:GetInstance().LandFloor
    if floor > 0 then
        floor = _G.ConfigManager.tower_cfg[floor].layer
    end
    local unlockFloor = _G.ConfigManager.discrete_cfg[102301][1][1]
    if (floor + 1) == unlockFloor then
        return true
    else
        return false
    end
end

