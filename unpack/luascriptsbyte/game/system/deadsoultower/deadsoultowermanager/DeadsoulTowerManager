---获取所有场次的统计数据
---@return table 统计数据
function DeadsoulTowerManager:GetStatisticsData()
    if _G.table.isEmptyOrNil(self.statisticsTab) then
        return nil
    end
    local data = self:GetSceneID()
    local statistics = {FighterInfo = {}}
    for i = 1, #data do
        if self.statisticsTab[data[i]] then
            table.insert(statistics.FighterInfo, self.statisticsTab[data[i]].FighterInfo[1])
            local lastIndex = #statistics.FighterInfo
            statistics.FighterInfo[lastIndex].TeamIndex = lastIndex
        end
    end
    return statistics
end

