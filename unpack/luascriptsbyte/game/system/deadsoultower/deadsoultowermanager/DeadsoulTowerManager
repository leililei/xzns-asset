    end
end

---进入布阵界面，准备战斗
---@param autoFight boolean 是否是 自动战斗
function DeadsoulTowerManager:EnterEmbattle(autoFight, index)
    if autoFight == nil then
        autoFight = self.autoFight or false
    end
    self.autoFight = autoFight

    --_G.UIManager:GetInstance():SwitchSceneCloseWindows()
    local embattleType = {}
    if DeadsoulTowerModel:GetInstance().CurTowerType == 9 then
        embattleType[1] = _G.EmbattleType.Tower
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 1 then
        embattleType[1] = _G.EmbattleType.Tower1
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 2 then
        embattleType[1] = _G.EmbattleType.Tower2
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 3 then
        embattleType[1] = _G.EmbattleType.Tower3
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 4 then
        embattleType[1] = _G.EmbattleType.Tower4
    elseif DeadsoulTowerModel:GetInstance().CurTowerType == 5 then
        embattleType[1] = _G.EmbattleType.Tower5
    end
    local monsterId = self:GetSceneID()
    local count = #monsterId
    if count > 1 then
        embattleType[1] = embattleType[1] * 1000 + 1
        for i = 2, count do
            embattleType[i] = embattleType[i - 1] + 1
        end
    end

    _G.CS.BattleManager.Inst:Destroy()
    _G.BattleManager:GetInstance():SetRendererActiveState(true)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    if self:CheckBattleFirst() then
        self.pass = _G.DeepCopyCfgTable(monsterId)
    end

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DeadSoulEmbattleView.Name,
        embattleType,
        _G.handler(self, self.ExitEmbattle),
        _G.handler(self, self.EnterFight),
        autoFight,
        index
    )
end

---重新进入布阵
---@return void
function DeadsoulTowerManager:ReEmbattle(autoFight, index)
    if not _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        --返回wild界面
        _G.UIManager:GetInstance():SwitchSceneCloseWindows()
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        _G.MainManager:GetInstance():ShowWildWindow()
    end
    self:EnterEmbattle(autoFight, index)

    --刷新主页面
    _G.MainManager:GetInstance():RefreshWildWindow()
end

--进入下一场战斗
function DeadsoulTowerManager:EnterNextFight(showFightView)
    local monsterId = self:GetSceneID()
    if self:CheckBattleFirst() then
        self.pass = _G.DeepCopyCfgTable(monsterId)
    end
    --如果是后台战斗, 隐藏战斗场景
    local isToggledWild = _G.MainManager:GetInstance():IsToggledWildWindow(false)
    _G.CS.BattleManager.Inst:Destroy()
    _G.BattleManager:GetInstance():SetRendererActiveState(isToggledWild)

    --更新队伍信息
    self:UpdateNextEmbattle(function(ok, index)
        if ok then
            self:EnterFight(nil, index, showFightView)
        else
            self:ExitFight()
        end
    end)
end

function DeadsoulTowerManager:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
        if window and window.Active == true then
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
        if window and window.Active == true then
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        if window and window.Active == true then
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        end
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    end
end

