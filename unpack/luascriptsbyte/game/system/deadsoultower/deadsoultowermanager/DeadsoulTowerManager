    if nil == isWin then
        isWin = false
    end
    self:OpenDeadsoulView(
        DeadsoulTowerModel:GetInstance().SystemId,
        isWin,
        function()
            if isWin then
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.DeadsoulTarget.id
                )
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.DeadsoulFirst.id
                )
            end
            --是否打开爬塔玩法页面
            local openDeadsoulView = false

            if DeadsoulTowerModel:GetInstance().IsOpenWx then
                local window1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
                if window1 then
                    window1:Show()
                    window1:UpdateFightFloor()
                else
                    --强制打开死魂塔页面
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DeadsoulTowerView.Name,
                        DeadsoulTowerModel:GetInstance().CurTowerType
                    )
                end
                --检查当前塔是否开启中
                local towerType = DeadsoulTowerModel:GetInstance().CurTowerType
                if towerType == 9 or DeadsoulTowerModel:GetInstance():CheckWeek(towerType) then
                    if not window1 then
                        --先关闭爬塔玩法页面, 然后依次打开: 列表页面 -> 玩法页面O
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                    end
                    openDeadsoulView = true
                end
            else
                openDeadsoulView = true
            end
            if openDeadsoulView then
                local window2 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                if window2 then
                    window2:Show()
                    window2:UpdateFightFloor(isWin)
                else
                    --强制打开死魂塔页面
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DeadsoulView.Name,
                        DeadsoulTowerModel:GetInstance().CurTowerType
                    )
                end
            else
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
            end
        end
    )
