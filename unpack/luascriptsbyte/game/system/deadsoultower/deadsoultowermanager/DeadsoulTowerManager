---获取死魂塔挑战战力信息
---@param towerId number 目标层
---@param noGetOwner boolean 不获取自己的战力，默认false会获取自己的战力
---@return number,number,number @我方战力,敌方战力,我方最大战力布阵id
function DeadsoulTowerManager:GetTowerPower(towerId, noGetOwner)
    local cfg = self.towercfg[towerId]
    if not cfg then
        return 0, 0, 0
    end

    --获取布阵信息
    local monsterGroupID = cfg.monster[1]
    local count = #monsterGroupID
    local id = cfg.tower == 9 and _G.EmbattleType.Tower or cfg.tower
    local item
    if count <= 1 then
        item = require "EmbattleItemTower".New({ id }, _G.EmbattleSaveType.server, false, monsterGroupID)
    else
        ---多队阵容 _G.EmbattleType.Tower * 1000+index
        local tb = { id * 1000 + 1 }
        for i = 2, count do
            tb[i] = tb[i - 1] + 1
        end
        item = require "EmbattleItemTower".New(tb, _G.EmbattleSaveType.server, false, monsterGroupID)
    end

    --获取己方战力信息
    local mPower, mPowerMaxId = 0, 1
    if not noGetOwner then
        --获取死魂塔布阵ID
        local embattleIds = {}
        if DeadsoulTowerModel:GetInstance().CurTowerType == 9 then
            embattleIds[1] = _G.EmbattleType.Tower
        elseif DeadsoulTowerModel:GetInstance().CurTowerType == 1 then
            embattleIds[1] = _G.EmbattleType.Tower1
        elseif DeadsoulTowerModel:GetInstance().CurTowerType == 2 then
            embattleIds[1] = _G.EmbattleType.Tower2
        elseif DeadsoulTowerModel:GetInstance().CurTowerType == 3 then
            embattleIds[1] = _G.EmbattleType.Tower3
        elseif DeadsoulTowerModel:GetInstance().CurTowerType == 4 then
            embattleIds[1] = _G.EmbattleType.Tower4
        elseif DeadsoulTowerModel:GetInstance().CurTowerType == 5 then
            embattleIds[1] = _G.EmbattleType.Tower5
        end
        local monsterId = self:GetSceneID()  --DeadsoulTowerManager尚未初始化
        local count = monsterId and #monsterId or 1
        if count > 1 then
            embattleIds[1] = embattleIds[1] * 1000 + 1
            for i = 2, count do
                embattleIds[i] = embattleIds[i - 1] + 1
            end
        end
        for _, v in pairs(embattleIds) do
            local power = 0
            local data = require("EmbattleModel"):GetInstance():GetEmbattleData(v)
            for i = 1, #data do
                if data[i] > 0 then
                    ---@type CardData
                    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data[i])
                    if not _G.table.isEmptyOrNil(card) then
                        power = power + card:GetPower()
                    else
                        data[i] = 0
                    end
                end
            end
            if power > mPower then
                mPower = power
                mPowerMaxId = v
            end
        end
    end

    --获取敌方战力信息
    local ePower = 0
    for i = 1, count do
        local power = item:GetEnemyEmbattlePower(i)
        if power > ePower then
            ePower = power
        end
    end

    return mPower, ePower, mPowerMaxId
end

---发送协议 快送挑战协议
function DeadsoulTowerManager:SendQuickFight(towerid, layer)
    local sits = require("EmbattleModel"):GetInstance():GetEmbattleData(self.maxPowerEmbattleId)
    local skills = require "EmbattleModel":GetInstance():GetSkillIndex(self.maxPowerEmbattleId)
    local array = {id = 0, sits = sits, skill_index = skills, pet = { 0, 0, 0 }} --TODO: 合击技暂时默认写0
    local DemoModel = require "DemoModel":GetInstance()
    for i = 1, #sits do
        if sits[i] > 0 then
            ---@type CardData
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, sits[i])
            if not card and DemoModel:CheckIsDemoCard(sits[i]) then
                sits[i] = 0
            end
        end
    end
    DeadsoulTowerNet:GetInstance():DeadSoulFastFight(
        {array = array},
        function(data)
            if data.ack == 3703 then
                ---@type DeadsoulView
                local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
                if window then
                    window.go_table.aorbtn_RestartDo_quick:SetActiveE(0)
                    --window.go_table.obj_quick_start:SetActiveE(0)
                    window.go_table.aorbtn_RestartDo:SetActiveE(1)
                end
                return
            end
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            DeadsoulTowerModel:GetInstance().CurTowerSid = towerid + layer
            DeadsoulTowerModel:GetInstance().curQuickPass = layer
            self:StopQuickChallenges()
            require "PopUpGiftBagModel":GetInstance():IsArriveDeadTower(towerid, layer)
            ---@param msg dead_soul.s2c_dead_soul_island
            DeadsoulTowerNet:GetInstance():DeadSoulIsland(
                nil,
                function(msg)
                    DeadsoulTowerModel:GetInstance().LandFloor = msg.high_floor
                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.DeadSoulDailyReward.id
                    )
                    DeadsoulTowerModel:GetInstance().award_list = msg.award_list
                    ---主塔层级达到开试炼的条件
                    local isFinishFloor = msg.high_floor
                    if isFinishFloor > 0 then
                        isFinishFloor = _G.ConfigManager.tower_cfg[isFinishFloor].layer
                    end
                    _G.Events:GetInstance():Broadcast(
                        _G.ePlayAactionEvent.PlayAaction,
                        {
                            _G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor
                        },
                        1
                    )

                    _G.Events:GetInstance():Broadcast(
                        _G.eSeasonTask.Action,
                        {
                            _G.SeasonTaskID.Deadsoul
                        },
                        layer
                    )
                    --额外奖励 数据更新
                    local sid = DeadsoulTowerModel:GetInstance().LandFloor
                    local type = DeadsoulTowerModel:GetInstance().CurTowerType
                    local AwardDatas_list = DeadsoulTowerModel:GetInstance().AwardDatas
                    if _G.table.isEmptyOrNil(AwardDatas_list) then
                        if _G.AppSetting.DEBUG then
                            _G.Log("", "<color=red>" .. "死魂塔奖励数据结构 未进行初始化" .. "</color>")
                        end
                    end
                    for _, v in ipairs(AwardDatas_list) do
                        if v.cfg.tower == type then
                            if sid >= v.sid then
                                if v.isGet then
                                else
                                    v.CanTake = true
                                end
                            end
                        end
                    end
                    require("PowerToTheTopModel"):GetInstance():hongDianNew()
                    -- --刷新 死魂塔 五行塔开启刷新 红点
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.DeadsoulMain.id
                    )
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.DeadsoulFirst.id
                    )
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.DeadsoulFast.id
                    )

                    if self.quickFightCallBack then
                        self.quickFightCallBack(layer, data)
                    end
                end
            )
        end
    )
end

--停止  快速挑战
function DeadsoulTowerManager:StopQuickChallenges()
    if self.stopCoProgress then
        _G.coroutine.stopwaiting(self.stopCoProgress)
        self.stopCoProgress = nil
        self.ent = false
    end
end

