---进入战斗
---@param showFightView boolean 是否显示战斗页面(默认true)
function DeadsoulTowerManager:EnterFight(_, index, showFightView)
    if not index then
        index = 1
    end
    --存储战斗状态
    self.fighting = true
    self.fightingView = showFightView == nil and true or showFightView

    --获取对战名称
    local leftName, rightName = _G.PlayerModel:GetInstance():GetName()
    local towerCfg = _G.ConfigManager.tower_cfg[DeadsoulTowerModel:GetInstance().CurTowerSid]
    if towerCfg then
        rightName = _G.GetLangPackValue(
            towerCfg.tower == 9 and 90000011279 or 90000011279 + towerCfg.tower,
            towerCfg.layer
        )
    end

    _G.Events:GetInstance():AddListener(_G.FightPlayState.FightStart, self.OnFightStartInBackground, self)
    local monsterId = self:GetSceneID()[index]
    _G.BattleManager:GetInstance():EnterFight(
        _G.BattleControllerType.Tower,
        DeadsoulTowerModel:GetInstance().CurTowerSid,
        monsterId,
        index,
        leftName,
        rightName
    )

    --显示主页面下边栏
    if _G.MainManager:GetInstance():IsToggledWildWindow(false) then 
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        _G.MainManager:GetInstance():RefreshWildWindow()

        --初始化下边栏动画
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView then
            mainView:InitAnimation()
        end
    end
end

function DeadsoulTowerManager:UpdateAwardCanTake()
    local sid = DeadsoulTowerModel:GetInstance().CurTowerSid
    local type = DeadsoulTowerModel:GetInstance().CurTowerType
    local AwardDatas_list = DeadsoulTowerModel:GetInstance().AwardDatas
    for _, v in ipairs(AwardDatas_list) do
        if v.cfg.tower == type then
            if sid >= v.sid then
                if v.isGet then
                else
                    v.CanTake = true
                end
            end
        end
    end
    if type == 9 then
        if DeadsoulTowerModel:GetInstance().LandFloor == 0 then
            DeadsoulTowerModel:GetInstance().LandFloor = 90001
        end
        local cfg = _G.ConfigManager.tower_cfg[DeadsoulTowerModel:GetInstance().LandFloor]
        if not cfg.is_top then
            DeadsoulTowerModel:GetInstance().LandFloor = DeadsoulTowerModel:GetInstance().LandFloor + 1
        end
    end
end

---战斗胜利
function DeadsoulTowerManager:FightWin(id)
    local AwardDatas_list = DeadsoulTowerModel:GetInstance().AwardDatas
    require("PowerToTheTopModel"):GetInstance():hongDianNew()

    if _G.table.isEmptyOrNil(AwardDatas_list) then
        --DeadsoulTowerModel:GetInstance():InitAwardDatas()

        if _G.AppSetting.DEBUG then
            _G.Log("死魂塔的 放置未打开", "<color=red>" .. "死魂塔奖励数据结构 未进行初始化" .. "</color>")
        end
        return
    end
    if id ~= nil and id == require("SettlementModel").FunctionEnum.Next then
    else
        --选中"野外"选项卡时, 才返回死魂塔页面
        if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
            self:ReturnUIPage(true)
        end
    end

    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainChallenge.id, 201)
end

---战斗失败
function DeadsoulTowerManager:FightLose()
    --选中"野外"选项卡时, 才返回死魂塔页面
    if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
        self:ReturnUIPage()
    end
end

--战斗结束, 退出结算页面
function DeadsoulTowerManager:ExitFight()
    --存储战斗状态
    self.fighting = false
    --self.fightingView = false --是否显示战斗页面

    --隐藏主页面
    if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
        _G.MainManager:GetInstance():RefreshWildWindow()
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    end
end

---额外奖励
---@param tid dead.c2s_dead_soul_award 额外奖励的塔的id(9,1-2-3-4-5)
function DeadsoulTowerManager:DeadSoulAward(tid, sids, Call)
    local pbdata = {}
    pbdata.tid = tid
    pbdata.sids = sids
    DeadsoulTowerNet:GetInstance():DeadSoulAward(
        pbdata,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            local list = {}
            if tid == 9 then
                list = DeadsoulTowerModel:GetInstance().award_list
            else
                local pra = DeadsoulTowerModel:GetInstance().PracticeFloor
                list = pra[tid].award_list
            end
            if not list then
                return
            end
            local index = 0
            for i = 1, #sids do
                index = 0
                for key, value in pairs(list) do
                    if value == sids[i] then
                        index = key
                        break
                    end
                end
                if index ~= 0 then
                    _G.table.remove(list, index)
                end
            end
            --刷新 死魂塔 五行塔开启刷新 红点
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.DeadsoulMain.id
            )
            --刷新红点
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.DeadsoulFirst.id
            )

            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulFirst.id, tid)
            --奖励
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            if Call then
                Call(data)
            end
        end
    )
end

---目标奖励
---@param id dead.c2s_dead_soul_target_award 额外奖励的塔层id
function DeadsoulTowerManager:DeadSoulTargetAward(id, Call)
    local pbdata = {}
    pbdata.id = id
    DeadsoulTowerNet:GetInstance():DeadSoulTargetAward(
        pbdata,
        function(data)
            if data.ack ~= 1 then
                return
            end
            DeadsoulTowerModel:GetInstance().target_list[id] = id
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            --奖励
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.DeadsoulTarget.id
            )
            if Call then
                Call()
            end
        end
    )
end

