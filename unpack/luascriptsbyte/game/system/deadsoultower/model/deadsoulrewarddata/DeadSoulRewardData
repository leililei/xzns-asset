local DeadsoulTowerModel = require "DeadsoulTowerModel"
---@class DeadSoulRewardData 死魂塔奖励数据
local DeadSoulRewardData = _G.BaseClass("DeadSoulRewardData")
_G.DeadSoulRewardData = DeadSoulRewardData

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function DeadSoulRewardData:__init()
end

---类的析构函数
function DeadSoulRewardData:Dispose()
end
--- 解析数据
---@param cfg afk_stage_cfg
function DeadSoulRewardData:Parse(cfg)
    self.sid = cfg.id
    self.cfg = cfg
    self.isGet = false
    self.reward = _G.StorageManager:GetInstance():GetItemDataClassByCfg(cfg.reward_first[1])
    self.realReward = cfg.reward[1]
    self.CanTake = false
    self.Proptype = cfg.tower
    self:UpdateCanTake()
    self:setImage()
    self.isBag = not _G.string.IsNullOrEmpty(self.cfg.image)
end
function DeadSoulRewardData:setImage()
    self.image = self.cfg.image
end
function DeadSoulRewardData:UpdateCanTake(num)
    local award_list = {}
    local isFightFloor = num or 0
    if self.Proptype == 9 then
        award_list = require "DeadsoulTowerModel":GetInstance().award_list
        isFightFloor = require "DeadsoulTowerModel":GetInstance().LandFloor
    else
        local PracticeFloor = require "DeadsoulTowerModel":GetInstance().PracticeFloor
        if not _G.table.isEmptyOrNil(PracticeFloor[self.Proptype]) then
            if not _G.table.isEmptyOrNil(PracticeFloor[self.Proptype].award_list) then
                award_list = PracticeFloor[self.Proptype].award_list
            end
            isFightFloor = PracticeFloor[self.Proptype].high_floor
        end
    end
    if _G.table.isEmptyOrNil(award_list) then
        if isFightFloor ~= 0 and isFightFloor >= self.sid then
            self.isGet = true
        end
        return
    end
    local flag = false
    for key, value in pairs(award_list) do
        if value == self.sid then
            flag = true
            break
        end
    end
    if flag then
        self.CanTake = true
    else
        if isFightFloor ~= 0 and isFightFloor >= self.sid then
            self.isGet = true
        end
    end
end
return DeadSoulRewardData
