---获取礼包最大层级数
function DeadsoulTowerModel:GetGiftMaxLayer()
    local curLayer = self:Getlayer()
    local maxLayer = 0
    for _, v in pairs(self.giftDataList) do
        if curLayer >= v.layer then
            maxLayer = v.layer
        end
    end
    return maxLayer
end

