---跨天刷新
function DeadsoulTowerModel:OnSixClockUpdate(endcall)
    if _G.AppSetting.DEBUG then
        _G.Log(DeadsoulTowerModel:GetInstance().PracticeFloor, "跨天刷新五行数据")
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.DeadsoulMain) then
        if endcall then
            endcall()
        end
        return
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadSoulDailyReward.id)
    if DeadsoulTowerModel:GetInstance().IsOpenWx then
        --更改下日期
        local now = _G.TimeUtil.GetServerUnixTime() - _G.TimeUtil.GAME_DAY_TIME
        local tb = _G.TimeUtil.GetDateTime(now)
        local curWeek = tb.week == 0 and 7 or tb.week
        DeadsoulTowerModel:GetInstance().CurWeek = curWeek

        --刷新界面数据
        ---@type DeadsoulTowerView
        local window1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulTowerView.Name)
        if window1 and window1.gameObject:GetActiveSelf() == 1 then
            --window1:Show()
            window1:UpdateFightFloor()
            window1:StartTower()
        end
        ---@type DeadsoulView
        local window2 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
        if window2 and window2.PropType ~= DeadsoulTowerModel:GetInstance().MianTower and window2.gameObject:GetActiveSelf() == 1 then
            --检查当前是否开启此塔
            local isOpen = false
            local cfg = _G.ConfigManager.discrete_cfg[101802]
            if cfg then
                isOpen = cfg[window2.PropType] and _G.table.indexof(cfg[window2.PropType], curWeek)
            end
            if isOpen then
                window1:UpdateFightFloor()
            else
                window2:Close()
            end
        end
    end
    base.OnSixClockUpdate(self, endcall)
end

function DeadsoulTowerModel:InitFunction()
    local isTrue, _ = self:CheckFunctionIsUnlock(_G.FunctionID.DeadsoulMain)
    if isTrue then
        self:InitAwardDatas()
    end
    self:CacheMainTowerTask()
    --刷新 死魂塔 五行塔开启刷新 红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DeadsoulMain.id)
end

function DeadsoulTowerModel:CacheMainTowerTask()
    self.TowerTaskList = {}
    for k, v in pairs(_G.ConfigManager.mission_cfg) do
        if v.condition[1][1] == 40 then
            if not self.TowerTaskList[v.condition[1][2]] then
                self.TowerTaskList[v.condition[1][2]] = {}
            end
            _G.table.insert(self.TowerTaskList[v.condition[1][2]], {v.id, v.condition[1][3]})
            if not _G.table.isEmptyOrNil(self.TowerTaskList[v.condition[1][2]]) then
                _G.SortList(
                    self.TowerTaskList[v.condition[1][2]],
                    function(a)
                        return -a[2]
                    end
                )
            end
        end
    end
end

---结算使用
---找到最接近的任务
function DeadsoulTowerModel:GetSidTaskCom(sid)
    local missionCfg
    if _G.table.isEmptyOrNil(self.TowerTaskList) and not sid then
        return nil
    else
        local tower = _G.ConfigManager.tower_cfg[sid].tower
        local _condition = sid - 10000 * tower
        if not _G.table.isEmptyOrNil(self.TowerTaskList[tower]) then
            for k, v in pairs(self.TowerTaskList[tower]) do
                if _condition <= v[2] then
                    return v[1]
                end
            end
        end
    end
end

