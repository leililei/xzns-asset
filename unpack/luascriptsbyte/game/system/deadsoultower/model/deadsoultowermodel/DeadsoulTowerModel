function DeadsoulTowerModel:__init()
    self.endCallback = nil
    self.curFunctionOpenID = 22
    self.TowerProps = {
        none = 0,
        lei = 1,
        feng = 2,
        shui = 3,
        huo = 4,
        tu = 5
    }

    self.MianTower = 9
    self.SystemId = 0

    self.LandFloor = 0
    self.PracticeFloor = {}
    self.CurWeek = 0
    for i = 1, 5 do
        self.PracticeFloor[i] = {
            name = _G.table.keyof(self.TowerProps, i),
            high_floor = 0,
            pass_num = 0
        }
    end
    self.CurTowerType = self.MianTower
    self.extra_reaward_jiange = 5
    self.enemy_lists = {}
    self.target_list = {}
    self.award_list = {}
    self.curQuickPass = 0
    self.CurTowerSid = 0
