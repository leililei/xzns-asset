--死魂塔目标层数 102301
function DeadsoulTowerModel:GetDeadTowerFunForecast()
    local Layer = _G.ConfigManager.discrete_cfg[102301][1][1]
    if self.CurTowerType == 9 then
        local curLayer = self.CurTowerSid - self.CurTowerType * 10000
        if curLayer <= Layer then
            local forecast = {}
            forecast.progress = "(" .. curLayer .. "/" .. Layer .. ")"
            forecast.desc = _G.LangUtil.GetLangPackValue(90028010119, Layer)
            forecast.finish = curLayer >= Layer
            return forecast
        end
    end
    return nil
end

---检测星期是否对上
---@param propType number 五行类型
function DeadsoulTowerModel:CheckWeek(propType)
    local isOk = false
    local param = _G.ConfigManager.discrete_cfg[101802]
    local weeks = param[propType]
    for i = 1, #weeks do
        if weeks[i] == self.CurWeek then
            isOk = true
            break
        end
    end

    return isOk
end

