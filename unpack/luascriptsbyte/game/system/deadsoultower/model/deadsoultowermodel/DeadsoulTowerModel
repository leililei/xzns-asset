---购买礼包
function DeadsoulTowerModel:BuyGift(data, callback)
    if data.buyType == 1 then
        _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
        self.mallCall = callback
        self.curBuyId = data.id
        self.sendBuy = true
        require "MallManager":GetInstance():BuyActiveGift(data.price_id, nil, data.sid)
    elseif data.buyType == 2 then
        local pbData = {}
        pbData.buy_store_id = data.id
        DeadsoulTowerNet:GetInstance():BuyGift(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.StorageManager:GetInstance():ConsumeItem(12, 0, data.price_id)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, callback)
                self.buy_store_id[1] = data.id
            end
        )
    end
end

---充值回调
function DeadsoulTowerModel:OnMallCashListener(data)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.buy_store_id[1] = self.curBuyId
    if self.mallCall then
        self.mallCall()
        self.mallCall = nil
    end
    self.sendBuy = false
end

function DeadsoulTowerModel:DeadSoulStrategy(call)
    local Getlayer = self:Getlayer()

    if Getlayer <= 0 then
        return
    end
    Getlayer = self.CurTowerType * 10000 + Getlayer + 1

    require "DeadsoulTowerNet":GetInstance():GetRecommend(
        {sid = Getlayer},
        function(msg)
            if call then
                call(msg)
            end
        end
    )
end

