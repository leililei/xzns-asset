---领取所有奖励
---@param type number 爬塔类型
---@param callback function 回调
function DeadsoulTowerModel:GetAllAward(type, callback)
    local temp = {}
    local datas = self.AwardDatas
    if datas then
        for _, v in ipairs(datas) do
            if v.CanTake and v.cfg.tower == type then
                _G.table.insert(temp, v.sid)
            end
        end
    end
    if _G.table.isEmptyOrNil(temp) then
        return
    end
    _G.DeadsoulTowerManager:GetInstance():DeadSoulAward(type, temp, function(msg)
        for _, value in pairs(self.AwardDatas) do
            if _G.table.indexof(temp, value.sid) then
                value.isGet = true
                value.CanTake = false
            end
        end
        if callback then
            callback(msg)
        end
    end)
end

---每日礼包是否已领取
function DeadsoulTowerModel:CheckIsDailyReward()
    return self.isDailyReward == 1
end

---获取昨日最高层数
function DeadsoulTowerModel:GetLastDayMaxLayer()
    local layer = 0
    if self.lastMaxFid == 0 then
        return 0
    else
        local cfg = _G.ConfigManager.tower_cfg[self.lastMaxFid]
        if cfg then
            layer = cfg.layer
        end
    end
    return layer
end

---可领取的index 方便跳转
function DeadsoulTowerModel:GetHaveGetIndex()
    local maxGift = self.buy_store_id and self.buy_store_id[1] or 0
    
    return maxGift 
end

---检测是否所有礼包购买完
function DeadsoulTowerModel:CheckAllGitfSoldOut()
    local maxLayer = self.buy_store_id and self.buy_store_id[1] or 0
    for i, v in pairs(self.giftDataList) do
        if v.id > maxLayer then
            return false
        end
    end
    return true
end

function DeadsoulTowerModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return DeadsoulTowerModel
