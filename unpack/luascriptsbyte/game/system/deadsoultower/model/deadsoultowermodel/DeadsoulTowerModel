---打开死魂岛
function DeadsoulTowerModel:GetDataFormServer(_)
    local isTrue, _ = self:CheckFunctionIsUnlock(_G.FunctionID.DeadsoulMain)
    if isTrue then
        DeadsoulTowerModel:GetInstance().SystemId = 201
        ---获取主塔信息
        ---@param msg dead_soul.s2c_dead_soul_island
        DeadsoulTowerNet:GetInstance():DeadSoulIsland(
            nil,
            function(msg)
                DeadsoulTowerModel:GetInstance().LandFloor = msg.high_floor
                -- local unlockFloor = _G.ConfigManager.discrete_cfg[102301][1][1]
                DeadsoulTowerModel:GetInstance().target_list = msg.target_list
                DeadsoulTowerModel:GetInstance().award_list = msg.award_list
                DeadsoulTowerModel:GetInstance().buy_store_id = msg.buy_store_id or {}
                self.isDailyReward = msg.day_award
                self.lastMaxFid = msg.last_max_fid
                local towerStore = _G.ConfigManager.tower_store_cfg
                local cashCfg = _G.ConfigManager.store_extra_cfg
                local diamondCfg = _G.ConfigManager.store_exchange_cfg
                local towerCfg = _G.ConfigManager.tower_cfg
                local giftDataList = {}
                local insert = _G.table.insert
                for k, v in pairs(towerStore) do
                    local data = {}
                    data.layer = towerCfg[v.tower].layer
                    data.award = {}
                    if v.rmb and v.rmb ~= 0 then
                        local giftdata = cashCfg[v.rmb]
                        data.sid = v.rmb
                        data.award = giftdata.goods
                        data.price_id = giftdata.price_id
                        data.original_id = giftdata.original_id
                        data.buyType = 1
                    end
                    if v.diamond and v.diamond ~= 0 then
                        local giftdata = diamondCfg[v.diamond]
                        data.sid = v.diamond
                        data.award = giftdata.goods
                        data.price_id = giftdata.price
                        data.original_id = giftdata.original
                        data.buyType = 2
                    end
                    data.id = v.id
                    data.nextLayer = 9999
                    local lastdata = giftDataList[#giftDataList]
                    if lastdata then
                        lastdata.nextLayer = data.layer
                    end
                    insert(giftDataList, data)
                end
                _G.SortList(
                    giftDataList,
                    function(a)
                        return -a.id
                    end
                )
                DeadsoulTowerModel:GetInstance().giftDataList = giftDataList
                ---主塔层级达到开试炼的条件
                local isFinishFloor = msg.high_floor
                if isFinishFloor > 0 then
                    isFinishFloor = _G.ConfigManager.tower_cfg[isFinishFloor].layer
                end
                _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {
                        _G.ActiveTaskEnum.ConditionEnum.Section.DeadsoulFoor
                    },
                    1
                )
                --查看是否解锁了 五行试炼塔
                local unlockFloor = _G.ConfigManager.discrete_cfg[102301][1][1]
                if
                    isFinishFloor >= unlockFloor and
                        _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Deadsoul)
                 then
                    DeadsoulTowerModel:GetInstance().IsOpenWx = true
                    DeadsoulTowerNet:GetInstance():DeadSoulPractice(
                        nil,
                        function(msg)
                            for i = 1, #msg.open_tower do
                                ---@type dead_soul.tower_info
                                local towerInfo = msg.open_tower[i]
                                local pfr = self.PracticeFloor[towerInfo.type]
                                pfr.high_floor = towerInfo.high_floor
                                pfr.pass_num = towerInfo.pass_num
                                pfr.award_list = towerInfo.award_list
                            end
                            self.super.ParseData(self)
                        end
                    )
                else
                    DeadsoulTowerModel:GetInstance().IsOpenWx = false
                    self.super.ParseData(self)
                end
                --刷新红点信息
                --require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulMain.id)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadSoulDailyReward.id)
            end
        )
    else
        self.super.ParseData(self)
    end
end

