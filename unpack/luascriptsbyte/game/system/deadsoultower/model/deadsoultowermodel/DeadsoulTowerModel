--初始化奖励数据
function DeadsoulTowerModel:InitAwardDatas()
    self.AwardDatas = {}
    local Tower_cfg = _G.ConfigManager.tower_cfg
    local cfg = {}
    for key, value in pairs(Tower_cfg) do
        if not _G.table.isEmptyOrNil(value.reward_first) then
            _G.table.insert(cfg, value)
        end
    end
    _G.table.sort(
        cfg,
        function(a, b)
            if a.tower < b.tower then
                return true
            elseif a.tower == b.tower and a.layer < b.layer then
                return true
            end
            return false
        end
    )
    local ChapterRewardData = require "DeadSoulRewardData"
    local count = #cfg
    for i = 1, count do
        self.AwardDatas[i] = ChapterRewardData.New()
        self.AwardDatas[i]:Parse(cfg[i])
    end
end

---更新奖励数据
function DeadsoulTowerModel:UpdateAwardDatas()
    if not self.AwardDatas then
        return
    end
    for _, v in pairs(self.AwardDatas) do
        v.isGet = false
        v.CanTake = false
        v:UpdateCanTake()
    end
end

