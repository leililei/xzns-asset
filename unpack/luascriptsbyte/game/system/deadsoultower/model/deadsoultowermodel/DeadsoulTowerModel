---获取层数
---@param id number 查询id/nil当前
function DeadsoulTowerModel:Getlayer(id)
    local layer = 0
    local tid
    if id == nil then
        tid = self.LandFloor
    else
        tid = id
    end
    if tid > 0 then
        local cfg = _G.ConfigManager.tower_cfg[tid]
        if cfg then
            layer = cfg.layer
        end
    end
    return layer
end

---检测接口, 死魂塔 任务，塔的类型，（9-主塔；1-雷；2-风；3-水；4-火；5-土；10-所有塔都达到指定层；11-所有五行塔都达到指定层）
---@param type number 10 全部塔，11 全部的 五行塔
---@param param number 目标值
---@return  返回 最小的塔的层数
function DeadsoulTowerModel:CheckDeadsoulTask(type, param)
    local layer = 0
    local towertable = {}
    local cfg = _G.ConfigManager.tower_cfg

    local sid = 0

    --region --------------------------------------主塔--------

    ---- 10    9 要考虑主塔
    if type == 10 or type == 9 then
        sid = self.LandFloor
        if sid == 0 then
            layer = 0
        else
            layer = cfg[sid].layer
        end
        _G.table.insert(towertable, layer)
    end

    --region --------------------------------------五行塔--------

    if type == 11 or type == 10 then
        ---所有五行塔
        for key, value in pairs(self.PracticeFloor) do
            sid = value.high_floor
            if sid == 0 then
                layer = 0
            else
                layer = cfg[sid].layer
            end
            _G.table.insert(towertable, layer)
        end
    elseif type < 6 then
        ---指定 五行塔
        local value = self.PracticeFloor[type]
        sid = value.high_floor
        if sid == 0 then
            layer = 0
        else
            layer = cfg[sid].layer
        end
        _G.table.insert(towertable, layer)
    end

    --endregion------------------------------------五行塔--------
    _G.table.sort(
        towertable,
        function(a, b)
            return a < b
        end
    )
    layer = towertable[1]
    return layer
end

--region 对外接口 检测红点
---检测目标奖励
function DeadsoulTowerModel:CheckRedPointTowerTargetAward()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return false
    end
    local target_list = DeadsoulTowerModel:GetInstance().target_list
    local tower_five_cfg = _G.ConfigManager.tower_five_cfg
    local maxCount = #tower_five_cfg
    local id = 1
    if table.isEmptyOrNil(target_list) then
        id = 1
    else
        _G.table.sort(
            target_list,
            function(a, b)
                return a > b
            end
        )
        id = target_list[1]
        id = id + 1
        if id > maxCount then
            return false
        end
    end
    local tower = tower_five_cfg[id].tower
    local number = 0
    local pra = DeadsoulTowerModel:GetInstance().PracticeFloor
    for i = 1, #tower do
        if tower[i] <= pra[i].high_floor then
            number = number + 1
        end
    end
    if number < 5 then
        return false
    end
    return true
end

---检测额外奖励
function DeadsoulTowerModel:CheckRedpointTowerExtraAward(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return false
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(23) then
        return false
    end
    ---判断是主塔 还是 五行塔
    local exraAward = {}
    local flag = false
    if param == 9 then
        exraAward = {}
        exraAward = DeadsoulTowerModel:GetInstance().award_list
        flag = true
    else
        ---检测时间是否有开启的五行塔，五行塔中是否有奖励
        local now = _G.CS.YoukiaCore.TimeKit.GetNowUnixTime() - _G.TimeUtil.GAME_DAY_TIME
        local tb = _G.TimeUtil.GetDateTime(now)
        local pra = DeadsoulTowerModel:GetInstance().PracticeFloor
        local param1 = _G.ConfigManager.discrete_cfg[101802]
        local week = tb.week
        if week == 0 then
            week = 7
        end
        ---查看五行塔是否 又可领取的
        local param2 = param1[param]
        for i = 1, #param2 do
            if param2[i] == week then
                exraAward = {}
                exraAward = pra[param].award_list
                flag = true
                break
            end
        end
    end
    ---查看是否有奖励可以领取
    if flag and (not _G.table.isEmptyOrNil(exraAward)) then
        return true
    end
    return false
end

