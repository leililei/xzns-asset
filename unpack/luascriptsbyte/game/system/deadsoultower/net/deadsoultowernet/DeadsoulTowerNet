---获取死魂岛排行榜
---@param pbdata rank.c2s_rank_public 发送数据
---@param type number 爬塔类型towercfg.tower
---@param callback function 回调方法
function DeadsoulTowerNet:DeadSoulRank(pbdata, type, callback)
    pbdata = pbdata or self:GetEmptyPB()
    local item
    if type == require("DeadsoulTowerModel"):GetInstance().MianTower then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_island
    elseif type == 1 then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_ltower
    elseif type == 2 then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_ftower
    elseif type == 3 then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_stower
    elseif type == 4 then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_htower
    elseif type == 5 then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_ttower
    end
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end
