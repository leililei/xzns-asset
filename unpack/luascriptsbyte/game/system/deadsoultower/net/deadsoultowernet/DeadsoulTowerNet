require "BaseGameNet"

---@class DeadsoulTowerNet : BaseGameNet    通信协议
local DeadsoulTowerNet = _G.BaseClass("DeadsoulTowerNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return DeadsoulTowerNet DeadsoulTowerNet
function DeadsoulTowerNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取死魂岛(主塔)的信息
---@param pbdata public.c2s_common_empty 发送数据
---@param callback function 回调方法
function DeadsoulTowerNet:DeadSoulIsland(pbdata, callback)
    pbdata = pbdata or self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_dead_soul_island
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

