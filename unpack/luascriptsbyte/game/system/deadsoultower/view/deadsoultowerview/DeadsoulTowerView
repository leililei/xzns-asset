local DeadsoulTowerModel = require("DeadsoulTowerModel")

---@class DeadsoulTowerView : UIBaseView
local DeadsoulTowerView = _G.BaseClass("DeadsoulTowerView", _G.UIBaseView)

function DeadsoulTowerView:__init()
    self:AddListener(_G.eBattleState.RecordStart, self.HideView)
    self:AddListener(_G.eBattleState.RecordEnd, self.ShowView)
end

function DeadsoulTowerView:Dispose()
    self:RemoveListener(_G.eBattleState.RecordStart, self.HideView)
    self:RemoveListener(_G.eBattleState.RecordEnd, self.ShowView)
end

function DeadsoulTowerView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function DeadsoulTowerView:DoUpdateWeek()
    _G.DeadsoulTowerManager:GetInstance():UpdateWeek()
end

-- 启动
function DeadsoulTowerView:OnCreate(deadsoulview)
    self.DeadSoulView = deadsoulview
    ---@type DeadsoulTowerView._obj_lei_GoTable[]
    self.Toggles = {
        self.go_table.obj_lei,
        self.go_table.obj_feng,
        self.go_table.obj_shui,
        self.go_table.obj_huo
    }

    ---暂时屏蔽功能说明，UI和设计方案还没

    local now = _G.CS.YoukiaCore.TimeKit.GetNowUnixTime() - _G.TimeUtil.GAME_DAY_TIME
    local tb = _G.TimeUtil.GetDateTime(now)
    DeadsoulTowerModel:GetInstance().CurWeek = tb.week == 0 and 7 or tb.week

    self:StartTower()
    local cfg = _G.ConfigManager.tower_cfg
    local finishFloor = DeadsoulTowerModel:GetInstance().LandFloor
    if finishFloor > 0 then
        finishFloor = cfg[finishFloor].layer
    end
    local floor = finishFloor + 1
    local towerInfo = DeadsoulTowerModel:GetInstance():InitTowerInfo(9)
    if floor >= #towerInfo then
        floor = #towerInfo
    end
    self.go_table.aortext_ZC.text = _G.LangUtil.GetLangPackValue(90025700024, floor)


    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        self.resource =
            self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo,
                    _G.ConfigManager.ui_cfg.DeadsoulTowerView.resources)
            )
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function DeadsoulTowerView:ShowView()
    if self.isHide == false or self.gameObject:GetActiveSelf() == 1 then
        self.isHide = false
        return
    end
    self.isHide = false
    self:Show()
end

function DeadsoulTowerView:HideView()
    if self.isHide or self.gameObject:GetActiveSelf() == 0 then
        self.isHide = true
        return
    end
    self.isHide = true
    self:Hide()
end

---塔开始
function DeadsoulTowerView:StartTower()
    _G.DeadsoulTowerManager:GetInstance():GetPractice(
        function()
            if self:IsNil() then
                return
            end
            if _G.AppSetting.DEBUG then
                _G.Log(DeadsoulTowerModel:GetInstance().PracticeFloor, "进入死魂岛五行数据")
            end
            self.target_lists = DeadsoulTowerModel:GetInstance().target_list
            self.choose = {}
            local param = _G.ConfigManager.discrete_cfg[101802]

            if _G.AppSetting.DEBUG then
                _G.Log(param, "试炼时间信息")
            end
            local cfg = _G.ConfigManager.tower_cfg
            for i = 1, #self.Toggles do
                ---@type DeadsoulTowerView._obj_lei_GoTable
                local goTable = _G.GetAutoGoTable(self.Toggles[i])
                local text = ""
                local flag = false
                for j = 1, #param[i] do
                    text = text .. _G.GameUtil.NumberToChinese(param[i][j]) .. "/"
                    if DeadsoulTowerModel:GetInstance().CurWeek == param[i][j] then
                        flag = true
                        break
                    end
                end

                local textContent = string.sub(text, 1, string.len(text) - 1)
                if flag  then
                    goTable.obj_desc:SetActiveE(0)
                    if goTable.obj_effNde and not AppSetting.IsXzns then
                        goTable.obj_effNde:SetActiveE(1)
                    end
                    self:LoadEff(goTable.obj_effNde)
                else
                    goTable.obj_desc:SetActiveE(1)
                    goTable.aortext_Desc.text = _G.GetLangPackValue(90023200041, textContent)
                    if goTable.obj_effNde then
                        goTable.obj_effNde:SetActiveE(0)
                    end
                end
                local fightFloor = DeadsoulTowerModel:GetInstance().PracticeFloor[i].high_floor
                if fightFloor > 0 then
                    fightFloor = cfg[fightFloor].layer
                end
                local floor = fightFloor + 1
                local towerInfo = DeadsoulTowerModel:GetInstance():InitTowerInfo(i)
                if floor >= #towerInfo then
                    floor = #towerInfo
                end
                goTable.aortext_C.text = _G.LangUtil.GetLangPackValue(90025700024, floor)
            end
            --设置奖励 ,和进度条
            local PracticeFloor = DeadsoulTowerModel:GetInstance().PracticeFloor

            local tower_five_cfg = _G.ConfigManager.tower_five_cfg
            local maxCount = #tower_five_cfg
            local id = 1
            local flag = true
            if table.isEmptyOrNil(self.target_lists) then
                id = 1
            else
                _G.table.sort(
                    self.target_lists,
                    function(a, b)
                        return a > b
                    end
                )
                id = self.target_lists[1]
                id = id + 1
                if id > maxCount then
                    id = maxCount
                    flag = false
                end
            end
            local tower = tower_five_cfg[id].tower
            local number = 0
            for i = 1, #tower do
                if tower[i] <= PracticeFloor[i].high_floor then
                    number = number + 1
                end
            end
            local qushu = cfg[tower[1]].layer
            local str = ""
            if not flag then
                str = _G.LangUtil.GetLangPackValue(90023200018)
            else
                str = _G.LangUtil.GetLangPackValue(90023200040, qushu)
            end
            self.go_table.aortext_jinduDesc.text = str
            local reward = tower_five_cfg[id].reward[1]
            self:UpDateBar(number)
            self:UpdateTagetAward(reward, tower, PracticeFloor, id, flag, number)
            self.go_table.aortext_jindu.text = number .. "/4"
            if AppSetting.IsXzns then
                self.go_table.aorimage_bar1:SetRectTransformSize(233 * number / 4, 11)
                self.go_table.aorimage_bar2:SetRectTransformSize(233 * number / 4, 11)
            else
                self.go_table.aorimage_bar1:SetRectTransformSize(204 * number / 4, 11)
                self.go_table.aorimage_bar2:SetRectTransformSize(204 * number / 4, 11)
            end
        end
    )
end

---@param node UnityEngine.GameObject
function DeadsoulTowerView:LoadEff(node)
    if node:GetChildCountE() <= 0 then
        _G.UIUtils.LoadEffectByCfg( _G.ConfigManager.ui_effect_cfg.ef_shouhuzhitakuang, node, function(tran)
            if _G.IsNil(self.go_table) then
                tran:DestroyObject()
                return
            end
            if tran ~= nil then
                tran:SetLocalScaleXYZ(1)
                tran:SetActiveE(1)
            end
        end)
    end
end

function DeadsoulTowerView:ClearEff(number)
    if self.EffectGet then
        _G.DestroyObject(self.EffectGet)
    end

    if number >= 4 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
            self.go_table.obj_reward,
            function(tran)
                --- 防止 异步后
                if _G.IsNil(self.go_table.gameObject) then
                    tran:DestroyObject()
                    return
                end
                self.EffectGet = tran
            end
        )
    end
end

---目标奖励
function DeadsoulTowerView:UpdateTagetAward(reward, tower, PracticeFloor, id, flag, number)
    self:ClearEff(number)


    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        reward,
        self.go_table.obj_reward,
        function(item)
            self.Item = item
            item:SetGou(not flag)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            self:AwardBtn(go, reward[1], tower, PracticeFloor, id, flag)
        end
    )
end

function DeadsoulTowerView:AwardBtn(go, itemid, tower, PracticeFloor, id, flag)
    if not flag then
        return
    end

    local number = 0
    for i = 1, #tower do
        if tower[i] <= PracticeFloor[i].high_floor then
            number = number + 1
        end
    end
    self:ClearEff(number)

    if number < #tower then
        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemid)
    else
        _G.DeadsoulTowerManager:DeadSoulTargetAward(
            id,
            function()
                self:StartTower()
            end
        )
    end
end

---进度条
function DeadsoulTowerView:UpDateBar(number)
    if number == 0 then
        number = 0.01
    else
        number = number / 5
    end
    self.go_table.aorimage_bar2.fillAmount = number
end

---更新已挑战层级
function DeadsoulTowerView:UpdateFightFloor()
    self:StartTower()
    local cfg = _G.ConfigManager.tower_cfg
    local finishFloor = DeadsoulTowerModel:GetInstance().LandFloor
    if finishFloor > 0 then
        finishFloor = cfg[finishFloor].layer
    end
    local floor = finishFloor + 1
    local towerInfo = DeadsoulTowerModel:GetInstance():InitTowerInfo(9)
    if floor >= #towerInfo then
        floor = #towerInfo
    end
    self.go_table.aortext_ZC.text = _G.LangUtil.GetLangPackValue(90025700024, floor)
    self:Show()
end

-- 按钮单击事件--
function DeadsoulTowerView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_zhu" then
        --self:Close()
        DeadsoulTowerModel:GetInstance().CurTowerType = DeadsoulTowerModel:GetInstance().MianTower
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DeadsoulView.Name,
            DeadsoulTowerModel:GetInstance().CurTowerType,
            false
        )
    elseif name == "@_aorbtn_lei" then
        --self:Close()
        DeadsoulTowerModel:GetInstance().CurTowerType = _G.CardElementType.Thunder
        self:CheckIsOpneTowerWuxing(_G.CardElementType.Thunder)
    elseif name == "@_aorbtn_feng" then
        --elf:Close()
        DeadsoulTowerModel:GetInstance().CurTowerType = _G.CardElementType.Wind
        self:CheckIsOpneTowerWuxing(_G.CardElementType.Wind)
    elseif name == "@_aorbtn_shui" then
        DeadsoulTowerModel:GetInstance().CurTowerType = _G.CardElementType.Water
        self:CheckIsOpneTowerWuxing(_G.CardElementType.Water)
    elseif name == "@_aorbtn_huo" then
        DeadsoulTowerModel:GetInstance().CurTowerType = _G.CardElementType.Fire
        self:CheckIsOpneTowerWuxing(_G.CardElementType.Fire)
    elseif name == "@_aorbtn_tu" then
        DeadsoulTowerModel:GetInstance().CurTowerType = _G.CardElementType.Earth
        self:CheckIsOpneTowerWuxing(_G.CardElementType.Earth)
    end
end

---检测 五行塔 是否开启
function DeadsoulTowerView:CheckIsOpneTowerWuxing(type)
    if type ~= 9 then
        local isOk = DeadsoulTowerModel:GetInstance():CheckWeek(type)
        if not isOk then
            _G.PopWindowManager:GetInstance():ShowAllTips(390101)
            return
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DeadsoulView.Name, type, false)
end

--endregion

function DeadsoulTowerView:OnDestroy()
end

return DeadsoulTowerView
