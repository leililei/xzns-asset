---@class DeadsoulEnemyItem : Component	中文描述
local DeadsoulEnemyItem = _G.BaseClass("DeadsoulEnemyItem", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function DeadsoulEnemyItem:OnCreate(obj, cardData)
    self.go_table = _G.GetAutoGoTable(obj)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        self.go_table.obj_head,
        _G.handlerbind(self, self.showItemHeadInfo, cardData)
    )
end

---销毁对象时,析构函数
function DeadsoulEnemyItem:OnDestroy()
end
function DeadsoulEnemyItem:showItemHeadInfo(item, card)
    item:ShowCardData(card, nil)
end
function DeadsoulEnemyItem:ShowDes(card)
end
return DeadsoulEnemyItem
