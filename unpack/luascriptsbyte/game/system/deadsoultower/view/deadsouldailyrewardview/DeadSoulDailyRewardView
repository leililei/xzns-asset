local DeadsoulTowerModel = require("DeadsoulTowerModel")

---@class DeadSoulDailyRewardView : UIBaseView    中文描述
---@field public go_table DeadSoulDailyRewardView_GoTable GoTable
---@field orderLis DeadSoulDailyRewardView._obj_num1_GoTable[]
local DeadSoulDailyRewardView = _G.BaseClass("DeadSoulDailyRewardView", _G.UIBaseView)

local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local tower_cfg = _G.ConfigManager.tower_cfg
local discrete_cfg = _G.ConfigManager.discrete_cfg
local table = _G.table
local DAYSEC = 86400

function DeadSoulDailyRewardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DeadSoulDailyRewardView:OnCreate()
    self.showCfg = {}
    table.insert(self.showCfg, {layer = 0, reward_day = discrete_cfg[102304]})
    for _, v in pairs(tower_cfg) do
        if v.tower == 9 and v.reward_preview == 1 then
            table.insert(self.showCfg, v)
        end
    end
    _G.SortList(
        self.showCfg,
        function(a)
            return -a.layer
        end
    )
    self:FindCurRewardLayer()
    self.countDown = DAYSEC - _G.TimeUtil.GetSecondsOfDayOf6Hour()
    self:UpdateTime(0)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:InitView()
end

function DeadSoulDailyRewardView:FindCurRewardLayer()
    self.curRewardLayer = 0
    local layer = DeadsoulTowerModel:GetInstance():GetLastDayMaxLayer()
    self.jumpIdx = 0
    if layer == 0 then
        return
    end
    for i, v in pairs(self.showCfg) do
        if layer >= v.layer then
            self.curRewardLayer = v.layer
            self.jumpIdx = i - 1
        else
            break
        end
    end
end

---初始化页面
function DeadSoulDailyRewardView:InitView()
    local isGet = DeadsoulTowerModel:GetInstance():CheckIsDailyReward()
    if _G.AppSetting.IsXzns then
        self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = isGet and "ui_ty_kuang_02" or "ui_ty_kuang_00"
    else
        self.go_table.aorbtn_get:SetGray(isGet)
        self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(isGet and "A9A9A9" or "FFFFFF")
    end
    self.go_table.aortext_getText.text = isGet and GetLangPackValue(90023800011) or GetLangPackValue(90023800054)
    local canGetColor = "8C2D14"
    if AppSetting.IsXzns then
        canGetColor = "50351e"
    end
    self.go_table.aortext_getText.color = _G.ColorTools.FormatColorByString(isGet and "434343" or canGetColor)
    self.go_table.scrollloopvectical_itemList:InitItemData(
        #self.showCfg,
        _G.handler(self, self.RefreshItem),
        self.jumpIdx
    )
end

function DeadSoulDailyRewardView:UpdateTime(elapsed)
    self.countDown = Mathf.RoundToInt(self.countDown - elapsed)
    if self.countDown <= 0 then
        self.countDown = DAYSEC
        if _G.AppSetting.IsXzns then
            self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_kuang_00"
        else
            self.go_table.aorbtn_get:SetGray(false)
            self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
            _G.ColorTools.FormatColorByString("FFFFFF")
        end
        self.go_table.aortext_getText.text = GetLangPackValue(90023800054)
        self.go_table.aortext_getText.color = _G.ColorTools.FormatColorByString("8C2D14")
    end
    -- local t = _G.TimeUtil.TranslateSecond(self.countDown)
    -- self.go_table.aortext_reset.text = GetLangPackValue(90023200031, t.hour, t.min, t.sec)
    self.go_table.aortext_reset.text = GetLangPackValue(90023200031)
end

function DeadSoulDailyRewardView:RefreshItem(index, obj)
    index = index + 1
    ---@type DeadSoulDailyRewardView._obj_item_GoTable
    local tb = GetAutoGoTable(obj)
    local cfg = self.showCfg[index]
    tb.aortext_layer.text = cfg.layer == 0 and GetLangPackValue(90023200034) or GetLangPackValue(90023200002, cfg.layer)
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    tb.obj_cur:SetActiveE(0)
    tb.obj_cur2:SetActiveE(0)
    local obj_cur = uiModel and tb.obj_cur2 or tb.obj_cur
    obj_cur:SetActiveE(cfg.layer == self.curRewardLayer and 1 or 0)
    tb.trans_Content:ClearChildren()
    local rewards = cfg.reward_day
    for i = 1, #rewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[i],
            tb.trans_Content,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function DeadSoulDailyRewardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        if DeadsoulTowerModel:GetInstance():CheckIsDailyReward() then
            return
        else
            DeadsoulTowerModel:GetInstance():GetDailyReward(
                function(msg)
                    if _G.AppSetting.IsXzns then
                        self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_kuang_02"
                    else
                        self.go_table.aorbtn_get:SetGray(true)
                        self.go_table.aorbtn_get:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
                        _G.ColorTools.FormatColorByString("A9A9A9")
                    end
                    self.go_table.aortext_getText.text = GetLangPackValue(90023800011)
                    self.go_table.aortext_getText.color = _G.ColorTools.FormatColorByString("434343")
                end
            )
        end
    end
end

---@private
function DeadSoulDailyRewardView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return DeadSoulDailyRewardView
