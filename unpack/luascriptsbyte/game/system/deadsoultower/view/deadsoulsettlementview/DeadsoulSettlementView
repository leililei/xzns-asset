---@class DeadsoulSettlementView : UIBaseView	中文描述
---@field public go_table DeadsoulSettlementView_GoTable GoTable
local DeadsoulSettlementView = _G.BaseClass("DeadsoulSettlementView", _G.UIBaseView)
--_G.DeadsoulSettlementView = DeadsoulSettlementView

local GetLangPackValue = _G.GetLangPackValue
function DeadsoulSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DeadsoulSettlementView:OnCreate(AutoFight, call, result)
    self.AutoFight = AutoFight
    self.onCloseCall = call
    self.result = result.iSWin
    self.otherInfo = result.otherInfo
    self.reportType = result.reportType
    self.go_table.obj_lose:SetActiveE(self.result and 0 or 1)
    self.go_table.obj_win:SetActiveE(self.result and 1 or 0)
    self:StartTimer()
    self.go_table.aortext_tip:DOFade(0.2, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)
end

function DeadsoulSettlementView:StartTimer()
    if not self.AutoFight or not self.result then
        self.go_table.aortext_tip.text = GetLangPackValue(90000000918)
        return
    end
    self.UiCountDown = 3 --自动战斗界面关闭倒计时 策划要求3秒 写死
    self.go_table.aortext_tip.text = GetLangPackValue(90021300087, self.UiCountDown)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeChanged, self, false, false, true)
    self.timer:Start()
end
function DeadsoulSettlementView:OnTimeChanged(elapsed)
    self.UiCountDown = self.UiCountDown - elapsed
    self.go_table.aortext_tip.text = GetLangPackValue(90021300087, Mathf.RoundToInt(self.UiCountDown))
    if self.UiCountDown < 0 then
        self:Close()
        if self.onCloseCall then
            self.onCloseCall()
            self.onCloseCall = nil
        end
    end
end
---界面的销毁函数
function DeadsoulSettlementView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.onCloseCall = nil
    self.result = nil
    self.onBtnClick = nil
end

---按钮点击事件在这里派发
function DeadsoulSettlementView:OnClickBtn(go)
    if self.onBtnClick then
        return
    end
    self.onBtnClick = true
    if go == self.go_table.aorbtn_bg then
        self:Close()
        if self.onCloseCall then
            self.onCloseCall()
            self.onCloseCall = nil
        end
    elseif go == self.go_table.aorbtn_statistics then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            _G.BattleManager:GetInstance():ParseStatistics(),
            self.result and {0} or {1},
            function()
                self.onBtnClick = false
                self:StartTimer()
            end,
            nil,
            self.otherInfo,
            1,
            nil,
            nil,
            nil,
            nil,
            self.reportType
        )
    end
end

return DeadsoulSettlementView
