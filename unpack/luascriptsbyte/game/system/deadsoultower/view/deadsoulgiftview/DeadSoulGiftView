---@class DeadSoulGiftView : UIBaseView    中文描述
---@field public go_table DeadSoulGiftView_GoTable GoTable
local DeadSoulGiftView = _G.BaseClass("DeadSoulGiftView", _G.UIBaseView)
---@type DeadsoulTowerModel
local DeadsoulTowerModel
local ColorTools = _G.ColorTools
local lineIcon = {
    [1] = "ui_sc_jj_bar03",
    [2] = "ui_sc_jj_bar01"
}
local GetLangPackValue = _G.GetLangPackValue
function DeadSoulGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DeadSoulGiftView:OnCreate()
    DeadsoulTowerModel = require "DeadsoulTowerModel":GetInstance()
    self.maxGift = DeadsoulTowerModel.buy_store_id and DeadsoulTowerModel.buy_store_id[1] or 0
    local landId = DeadsoulTowerModel.LandFloor
    self.LandFloor = landId ~= 0 and _G.ConfigManager.tower_cfg[landId].layer or 0
    self.giftDataList = DeadsoulTowerModel.giftDataList or {}
    self.jumpIndex = DeadsoulTowerModel:GetHaveGetIndex()
    --self.resource = self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, { 12 }))

    self.diamondNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    self.giftList = {}
    self.go_table.scrollloopvectical_items:InitItemData(#self.giftDataList, _G.handler(self, self.RefreshGiftList))
    --_G.UIUtils.LoadEffectByCfg(
    --        _G.ConfigManager.ui_effect_cfg.ef_DeadSoulGiftView_title,
    --        self.go_table.obj_uieffect_title,
    --        function(trans)
    --            if self:IsNil() then
    --                _G.DestroyObject(trans)
    --            end
    --        end
    --)
    self:ScrollToIndex()
    _G.PlayerPrefsManager.SetInt("DeadSoulGift", DeadsoulTowerModel:GetGiftMaxLayer())
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
end

function DeadSoulGiftView:ScrollToIndex()
    _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_items:ScrollToIndex(self.jumpIndex)
        end
    )
end

function DeadSoulGiftView:RefreshGiftList(index, obj)
    local id = obj:GetInstanceIDE()
    local tb
    local data = self.giftDataList[index + 1]
    tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.ItemOnclick, data))
    local x = index + 1
    tb.index = index + 1
    ----@type HellGuardTaskData
    tb.aorimage_up:SetActiveE(x ~= 1 and 1 or 0)
    tb.aorimage_down:SetActiveE(x ~= #self.giftDataList and 1 or 0)
    local wasBuy = self.maxGift >= data.id
    local num = 1
    tb.aortext_cashnum.text = GetLangPackValue(90000010359, num)
    tb.aortext_diamondnum.text = GetLangPackValue(90000010359, num)
    tb.aortext_level.text = GetLangPackValue(90025700024, data.layer)

    if data.buyType == 1 then
        tb.obj_cash:SetActiveE(1)
        tb.obj_diamond:SetActiveE(0)
        _G.GameUtil.SetPriceByChannel(data.price_id, tb.aortext_cash)
        _G.GameUtil.AddDouYinIcon(tb.aorbtn_buy, true, tb.aortext_cash)
    elseif data.buyType == 2 then
        tb.obj_cash:SetActiveE(0)
        tb.obj_diamond:SetActiveE(1)
        tb.aortext_diamond.text = data.price_id
    end
    if data.id > self.maxGift then
        tb.aorbtn_buy:SetActiveE(1)
        tb.obj_soldOut:SetActiveE(0)
        tb.aortext_cash:SetActiveE(data.buyType == 1 and 1 or 0)
        tb.aortext_diamond:SetActiveE(data.buyType == 2 and 1 or 0)
    else
        tb.aorbtn_buy:SetActiveE(0)
        num = 0
        tb.obj_soldOut:SetActiveE(1)
        tb.aortext_cash:SetActiveE(0)
        tb.aortext_diamond:SetActiveE(0)
        tb.obj_getEff:SetActiveE(0)
        tb.obj_cash:SetActiveE(0)
        tb.obj_diamond:SetActiveE(0)
    end
    if data.layer > self.LandFloor then
        tb.aorimage_upBar:SetActiveE(0)
        tb.aorimage_downBar:SetActiveE(0)
        tb.aorimage_bg:SetGray(true)
        tb.aorbtn_buy:SetGray(false)
        --tb.obj_getEff:SetActiveE(0)
    else
        tb.aorimage_upBar:SetActiveE(1)
        if data.nextLayer > self.LandFloor then
            tb.aorimage_downBar:SetActiveE(0)
        else
            tb.aorimage_downBar:SetActiveE(1)
        end
        tb.aorimage_bg:SetGray(false)
        tb.aorbtn_buy:SetGray(false)
        --tb.obj_getEff:SetActiveE(1)
        -- require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
    end
    for i = 1, 4 do
        local award = data.award[i]
        if not award then
            tb["obj_award" .. i]:RemoveAllChildren()
        else
            tb["obj_award" .. i]:RemoveAllChildren()
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                award,
                tb["obj_award" .. i],
                function(tran)
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran.gameObject:SetLocalScaleXYZ(0.83)
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    if tran.SetGou then
                        tran:SetGou(wasBuy)
                    end
                end
            )
        end
    end
end

---界面的销毁函数
function DeadSoulGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function DeadSoulGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

function DeadSoulGiftView:ItemOnclick(go, isOn, data)
    if data.layer > self.LandFloor then
        _G.PopWindowManager:GetInstance():ShowAllTips(390104)
        -- require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
        return
    end
    if data.id - 1 ~= self.maxGift then
        _G.PopWindowManager:GetInstance():ShowAllTips(390105)
        -- require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DeadsoulPack.id)
        return
    end
    if data.buyType == 2 and data.price_id > self.diamondNum then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        return
    end
    DeadsoulTowerModel:BuyGift(
        data,
        function()
            if self:IsNil() then
                return
            end
            self.diamondNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID
                .Diamond)
            self.maxGift = data.id
            self.go_table.scrollloopvectical_items:UpdateAllItem()
        end
    )
end

return DeadSoulGiftView
