local CommonTipManager = require "CommonTipManager"
local DeadSoulReward_item = require "DeadSoulReward_item"
local base = _G.UIBaseView
---@type DeadsoulTowerModel
local DeadsoulTowerModel = require "DeadsoulTowerModel"
---@class DeadSoulRewardView : UIBaseView	死魂塔爬塔奖励界面
---@field public go_table DeadSoulRewardView_GoTable GoTable
local DeadSoulRewardView = _G.BaseClass("DeadSoulRewardView", base)

function DeadSoulRewardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
end

---界面的入口函数
---@param type number 点击塔的类型
function DeadSoulRewardView:OnCreate(type, call)
    self.PropType = type
    self.call = call
    self:Init()
end

---界面初始化
function DeadSoulRewardView:Init()
    self.isInited = false
    self.jumpNum = 0
    local cfg = _G.ConfigManager.tower_cfg
    local IsFinishFloor = 0
    if self.PropType == DeadsoulTowerModel:GetInstance().MianTower then
        IsFinishFloor = DeadsoulTowerModel:GetInstance().LandFloor
    else
        IsFinishFloor = DeadsoulTowerModel:GetInstance().PracticeFloor[self.PropType].high_floor
    end
    if IsFinishFloor > 0 then
        self.layer = cfg[IsFinishFloor].layer
    else
        self.layer = 0
    end

    self:InitAwardDatas()
    self.deadsoulID = IsFinishFloor
    self.awardItemList = {}
    self:InitView()
    self.isInited = true
end

---初始化奖励数据
function DeadSoulRewardView:InitAwardDatas()
    local datas = require "DeadsoulTowerModel":GetInstance().AwardDatas
    self.AwardDatas = {}
    self.getCount = 0
    local fristAward = false
    for _, v in ipairs(datas) do
        if v.cfg.tower == self.PropType then
            if v.CanTake then
                self.getCount = self.getCount + 1
                fristAward = true
            else
                if v.cfg.layer <= self.layer and not fristAward then
                    self.jumpNum = self.jumpNum + 1
                end
            end
            _G.table.insert(self.AwardDatas, v)
        end
        -- if not v.CanTake and not v.isGet then
        --     break
        -- end
    end
end

function DeadSoulRewardView:InitView()
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshItem))
    self.go_table.scrollloopvectical_itemList:ScrollToIndex(self.jumpNum)
end

function DeadSoulRewardView:RefreshItem(index, go)
    if index < 0 then
        return
    end
    index = index + 1
    local id = go:GetInstanceID()
    if not self.awardItemList[id] then
        self.awardItemList[id] = _G.GetAutoGoTable(go)
    end
    local tb = self.awardItemList[id]
    local data = self.AwardDatas[index]



    tb.aortext_title.text = _G.GetLangPackValue(90025200010,data.cfg.layer,self.layer,data.cfg.layer) 

    tb.aorbtn_get.onClick:RemoveAllListeners()
    if data.CanTake then
        -- 可以领取
        tb.aorimage_getImage:SetActiveE(1)
        tb.obj_got:SetActiveE(0)

        tb.aortext_getText.text = _G.GetLangPackValue(90025600002)
        tb.aorimage_getImage.SpriteName = "ui_ty_kuang_00"

        -- ZHJH-2364 领取奖励时，一键领取所有奖励
        -- tb.aorbtn_get.onClick:AddListener(_G.handlerbind(self, self.OnClickItem, index, tb))
        tb.aorbtn_get.onClick:AddListener(_G.handler(self, self.GetAllAward))
    elseif data.isGet then
        -- 已领取
        tb.aorimage_getImage:SetActiveE(0)
        tb.obj_got:SetActiveE(1)
        tb.aortext_getText.text = ""
    else
        -- 不能领取
        tb.aorimage_getImage:SetActiveE(1)
        tb.obj_got:SetActiveE(0)
        tb.aortext_getText.text = _G.GetLangPackValue(90022200010)
        tb.aorimage_getImage.SpriteName = "ui_ty_kuang_01"

        tb.aorbtn_get.onClick:AddListener(_G.handler(self, self.Close))
    end

    -- 清空
    tb.obj_rewardList:ClearChildren()
    local loadId = (tb.loadId or 0) + 1
    tb.loadId = loadId
    for _, v in pairs(data.cfg.reward_first) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_rewardList,
            function(item)
                if self:IsNil() or tb.loadId ~= loadId then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end)
    end
end

---点击奖励item回调
---@param item DeadSoulReward_item
function DeadSoulRewardView:OnClickItem(index,tb)
    ---@type ChapterRewardData
    local data = self.AwardDatas[index]
    if not data then
        return
    end
    local award_list = { data.sid }
    if not data.CanTake then
        return
    else
        _G.DeadsoulTowerManager:GetInstance():DeadSoulAward(
            self.PropType,
            award_list,
            function(awardData)
                for i = 1, #award_list do
                    for key, value in pairs(self.AwardDatas) do
                        if value.sid == award_list[i] then
                            value.isGet = true
                            value.CanTake = false
                        end
                    end
                end
                self.getCount = self.getCount - 1
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, awardData)

                if self.call then
                    self.call(award_list)
                end
            end
        )
        tb.aorimage_getImage:SetActiveE(0)
        tb.obj_got:SetActiveE(1)
    end
end

function DeadSoulRewardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

---一键领取奖励
function DeadSoulRewardView:GetAllAward()
    local award_list = {}
    local temp = {}
    if self.PropType == 9 then
        award_list = DeadsoulTowerModel:GetInstance().award_list
    else
        local PracticeFloor = DeadsoulTowerModel:GetInstance().PracticeFloor
        if not _G.table.isEmptyOrNil(PracticeFloor[self.PropType]) then
            if not _G.table.isEmptyOrNil(PracticeFloor[self.PropType].award_list) then
                award_list = PracticeFloor[self.PropType].award_list
            end
        end
    end
    for key, value in pairs(award_list) do
        _G.table.insert(temp, value)
    end
    award_list = temp
    _G.DeadsoulTowerManager:GetInstance():DeadSoulAward(
        self.PropType,
        award_list,
        function(awardData)
            for i = 1, #award_list do
                for key, value in pairs(self.AwardDatas) do
                    if value.sid == award_list[i] then
                        value.isGet = true
                        value.CanTake = false
                    end
                end
            end
            if self.call then
                self.call(award_list)
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, awardData)
            self.go_table.scrollloopvectical_itemList:UpdateAllItem()
        end
    )
end

function DeadSoulRewardView:Close()
    base.Close(self)

    --领奖后刷新主塔页面
    ---@type DeadsoulView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DeadsoulView.Name)
    if view then 
        view:UpdateTowerAni()
    end
end

function DeadSoulRewardView:OnDisable()
end

return DeadSoulRewardView
