local DeadsoulTowerNet = require("DeadsoulTowerNet")

---@class DeadsoulSituationView : UIBaseView
---@field TowerInfo tower_cfg_Item
---@field Heroes CardItem
local DeadsoulSituationView = BaseClass("DeadsoulSituationView", UIBaseView)

function DeadsoulSituationView:Awake()
    AddViewBtnClick(self.go_table.gameObject, handler(self, self.OnClickBtn))
end

-- 启动
function DeadsoulSituationView:OnCreate(...)
    local args = {...}
    self.TowerId = args[1]

    self.DsItemGotableList = {}

    ---@type dead_soul.c2s_dead_soul_strategy
    local data = {}
    data.fid = self.TowerId
    ---@param msg dead_soul.s2c_dead_soul_strategy
    DeadsoulTowerNet:GetInstance():DeadSoulStrategy(
        data,
        function(msg)
            if msg.ack == 1 then
                if msg.strategy_info then
                    ---@type dead_soul.i_strategy[]
                    self.Strategys = msg.strategy_info
                    self.go_table.looplist2_InfoList:InitListView(
                        #self.Strategys,
                        _G.handler(self, self.RefreshInfoItem)
                    )
                end
            end
        end
    )
end

---创建情报列表
---@param looplist2 SuperScrollView.LoopListView2 滚动组件
---@param index number 该数据的索引   0起始
function DeadsoulSituationView:RefreshInfoItem(looplist2, index)
    if index < 0 then
        return
    end
    local eIndex = index + 1
    local item = looplist2:NewListViewItem("$_obj_InfoItem")
    ---@type DeadsoulSituationView._obj_InfoItem_GoTable
    local itemGotable = GetAutoGoTable(item, _G.handlerbind(self, self.OnItemClickBtn, eIndex))
    self.DsItemGotableList[eIndex] = itemGotable
    ---@type dead_soul.i_strategy
    local strategy = self.Strategys[eIndex]
    itemGotable.aortext_Level.text = strategy.role_info.level
    itemGotable.aortext_power.text = strategy.role_info.power
    itemGotable.aortext_Name.text = strategy.role_info.name
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[strategy.role_info.style]
    itemGotable.aorrawimage_head:LoadImage(portraitCfg.portrait1)

    return item
end

---点击回放(暂时没有开发的功能)
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function DeadsoulSituationView:OnItemClickBtn(_, _, index)
end

-- 按钮单击事件--
function DeadsoulSituationView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
end
--endregion

function DeadsoulSituationView:OnDestroy()
end

return DeadsoulSituationView
