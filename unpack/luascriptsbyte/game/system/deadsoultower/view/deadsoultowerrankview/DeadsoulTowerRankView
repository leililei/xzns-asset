require "DeadsoulTowerNet"
---@class DeadsoulTowerRankView : UIBaseView	死魂岛排行榜
---@field rankData rank.s2c_rank_get_dead_island 排行榜数据
---@field RankItems table 所有Rank 的子物体
---@field public go_table DeadsoulTowerRankView_GoTable GoTable

local DeadsoulTowerRankView = _G.BaseClass("DeadsoulTowerRankView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function DeadsoulTowerRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param page number 页数
---@param type number 塔的类型
---@param floor number 玩家爬塔的最高层数
function DeadsoulTowerRankView:OnCreate(type, floor)
    local msg = {page = 1}
    require("DeadsoulTowerNet"):GetInstance():DeadSoulRank(msg, type, _G.handlerbind(self, self.Init, floor))
end

---初始化界面
---@param data rank.s2c_rank_get_dead_island
function DeadsoulTowerRankView:Init(data, floor)
    self.rankData = data.deads
    self.RankItems = {}
    ---@type MyScrollList

    if not _G.table.isEmptyOrNil(self.rankData) then
        self.go_table.aorlooplist_RankList:StartUpdataDragInfo(#self.rankData, _G.handler(self, self.InitRanList))
    end
    self:InitPlayer(floor)
end

---初始化rankList
---@param trans UnityEngine.Transform
---@param index number 下标
function DeadsoulTowerRankView:InitRanList(trans, index)
    index = index + 1
    local instance = trans:GetInstanceIDE()
    if not self.RankItems[instance] then
        self.RankItems[instance] = _G.GetAutoGoTable(trans)
    end
    if index <= #self.rankData then
        self:UpdateRankItem(self.RankItems[instance], self.rankData[index], index)
    else
        self:UpdateRankItem(self.RankItems[instance], nil)
    end
end

---更新RankItem内容
---@param rank table rank的所有
---@param data dead_soul.i_dead
function DeadsoulTowerRankView:UpdateRankItem(rank, data, rankNum)
    if data == nil and rank:GetActiveSelf() == 1 then
        rank:SetActiveE(0)
        return
    end

    rank.aorimage_rank:SetActiveE(rankNum <= 3 and 1 or 0)
    rank.aortext_rankNum:SetActiveE(not (rankNum <= 3) and 1 or 0)
    if rankNum <= 3 then
        rank.aorimage_rank.SpriteName = "ui_shd_icon_paim0" .. rankNum
    else
        rank.aortext_rankNum.text = rankNum
    end
    if data.role_info.frame > 0 then
        rank.aorrawimage_frame:LoadImage(_G.ConfigManager.player_frame_cfg[data.role_info.frame].frame)
    end

    rank.aorrawimage_icon:LoadImage(_G.ConfigManager.player_portrait_cfg[data.role_info.style].portrait1)
    rank.aortext_name.text = data.role_info.name
    --rank.aortext_level.text = data.role_info.level
    local fontImage_lv = {rank.aorimage_level1}
    _G.UIUtils.SetImageFont(fontImage_lv, "v" .. tostring(data.role_info.level), _G.AorImageFont.Cardlevel)
    rank.aortext_tower.text = GetLangPackValue(90022500431, string.format("<color=#018e43>%d</color>", data.count_pass))
end

---初始化玩家的排名数据
function DeadsoulTowerRankView:InitPlayer(floor)
    local player = _G.GetAutoGoTable(self.go_table.obj_playerRank)
    player.aortext_name.text = _G.PlayerModel:GetInstance().role_name
    player.aorrawimage_icon:LoadImage(
        _G.ConfigManager.player_portrait_cfg[_G.PlayerModel:GetInstance().role_style].portrait1
    )
    if _G.PlayerModel:GetInstance().frame > 0 then
        player.aorrawimage_frame:LoadImage(_G.ConfigManager.player_frame_cfg[_G.PlayerModel:GetInstance().frame].frame)
    end

    --player.aortext_level.text = _G.PlayerModel:GetInstance().role_lv
    local fontImage_lv = {player.aorimage_level1}
    _G.UIUtils.SetImageFont(
        fontImage_lv,
        "v" .. tostring(_G.PlayerModel:GetInstance().role_lv),
        _G.AorImageFont.Cardlevel
    )
    local rankNum = self:GetPlayerRank()
    if _G.table.isEmptyOrNil(self.rankData) or floor == 0 then
        player.aortext_rankNum.text = GetLangPackValue(90022900040)
    else
        if rankNum == 0 then
            player.aortext_rankNum.text = "500+"
        else
            player.aortext_rankNum.text = rankNum
        end
    end

    player.aortext_tower.text = GetLangPackValue(90022500431, string.format("<color=#41ea91>%d</color>", floor))
end

---获取玩家Rank排名
function DeadsoulTowerRankView:GetPlayerRank(id)
    if not self.rankData then
        return 1
    end
    for i = 1, #self.rankData do
        if self.rankData[i].role_info.uid == _G.PlayerModel:GetInstance().role_uid then
            return i
        end
    end
    return 0
end
---按钮点击事件在这里派发
function DeadsoulTowerRankView:OnClickBtn()
    self:Close()
end

return DeadsoulTowerRankView
