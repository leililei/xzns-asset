local EmbattleController = require "EmbattleController"
local DeadsoulTowerModel = require("DeadsoulTowerModel")
---@class DeadSoulEmbattleView : UIBaseView    中文描述
---@field public go_table DeadSoulEmbattleView_GoTable GoTable
local DeadSoulEmbattleView = _G.BaseClass("DeadSoulEmbattleView", _G.UIBaseView)

function DeadSoulEmbattleView:Awake()
end
---界面的入口函数
function DeadSoulEmbattleView:OnCreate(embattleType, exitCall, battleCall, autoFight, index)
    self.onExitCall = exitCall
    self.embattleType = embattleType
    self.onBattleCall = battleCall
    self.autoFight = autoFight
    self.index = index
    self:OpenEmbattleView()
    self:ShowCurSectionTag()
end
function DeadSoulEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
end

function DeadSoulEmbattleView:ShowCurSectionTag()
    local curSection = _G.ConfigManager.tower_cfg[DeadsoulTowerModel:GetInstance().CurTowerSid].layer
    self.go_table.aortext_CurSection.text = _G.LangUtil.GetLangPackValue(90023200002, tostring(curSection))
end

function DeadSoulEmbattleView:OpenEmbattleView()
    local towerSid = DeadsoulTowerModel:GetInstance().CurTowerSid
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    local cfg = _G.ConfigManager.tower_cfg[towerSid]
    self.text = _G.GetLangPackValue(cfg.tower == 9 and 90000011279 or 90000011279 + cfg.tower, cfg.layer)
    EmbattleController:GetInstance():OpenEmbattle(
            self.embattleType,
            _G.EmbattleSaveType.localfile,
            false,
            _G.EmbattleControllerItemType.tower,
            _G.handler(self, self.OnExitCall),
            self.onBattleCall,
            _G.ConfigManager.tower_cfg[towerSid].monster[1],
            self.index,
            towerSid
    )
end

function DeadSoulEmbattleView:OnExitCall()
    self:Close()
    require("DemoModel"):GetInstance():ClearTempEmbattleData()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function DeadSoulEmbattleView:OnBattleCall(...)
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function DeadSoulEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
                name,
                self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        if self.autoFight then
            embattleView:SetAutoBattle()
        end
        embattleView:SetVsDescription(
                _G.PlayerModel:GetInstance():GetName(),
                self.text
        )
        embattleView:SetQuitCallback(_G.handler(self, self.CheckQuitEmbattle))
        embattleView.transform:SetParentE(self.go_table.trans_view)
    end
end

function DeadSoulEmbattleView:CheckQuitEmbattle(call)
    local groups = _G.DeadsoulTowerManager:GetInstance():GetSceneID()
    for i = 1, #groups do
        if _G.DeadsoulTowerManager:GetInstance():CheckMonsterIsPass(groups[i]) then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    3309,
                    nil,
                    function()
                        --移除临时助战使用次数
                        require("FriendHelpModel"):GetInstance():RemoveTempCount()

                        call(true)
                    end,
                    function()
                        call(false)
                    end
            )
            return
        end
    end
    call(true)
end

return DeadSoulEmbattleView
