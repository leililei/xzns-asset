---检测界面进度
function DeadsoulView:CoOnProgress()
    if _G.AppSetting.DEBUG then
        _G.Log("死魂塔初始化数据")
    end
    ---等待视频 播放完成(死魂塔视频 播放时间是 5 秒)
    if not self.firstOpen then
        _G.coroutine.waitforseconds(5)
        self:Show()
        self.firstOpen = true
    end

    self:UpdateTowerAni()
    _G.coroutine.yield()
    self.go_table.scrollloopvectical_Tower:ScrollToIndex(self.tower_count - 1)
    _G.coroutine.yield()
    -- if self.IsFinishFloor >= #self.TowerInfo - 5 then
    --     self.go_table.obj_towerContent:SetLocalPosition(0, -38, 0)
    -- end
    if self.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.WiatCoroutine)
        self.WiatCoroutine = nil
    end
end

