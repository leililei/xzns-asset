function DeadsoulView:UpdateTowerAni()
    local start = 0
    self.finshi = 0
    self.tower_count = 0
    if self.Floor < 2 then
        start = 0
        self.finshi = start + 35
        -- elseif self.Floor >= (#self.TowerInfo - 5) then
        --     start = #self.TowerInfo - 5
        --     self.finshi = #self.TowerInfo
    else
        start = self.Floor - 1
        self.finshi = self:GetMaxFloor(start)
        -- if self.finshi > #self.TowerInfo then
        --     self.finshi = #self.TowerInfo
        -- end
    end
    --ZHJH-4080【客户端】爬塔显示逻辑和奖励领取逻辑优化
    --每逢7-10层, 固定显示第6层不再往上
    local n = 10
    local mod = self.Floor % n
    if self.Floor > 0 and (mod >= 7 and mod <= (n - 1) or mod == 0) then
        start = start - (mod == 0 and n or mod) + 7
    end
    --如果有未领取得奖励(10N层), 则固定显示此10N-6至10N层信息
    self.has10NReward = false
    local datas = DeadsoulTowerModel:GetInstance().AwardDatas
    if datas then
        local floor = self.Floor
        local isHasRewarLayout = false
        for _, v in ipairs(datas) do
            if v.CanTake and v.cfg.tower == self.PropType and v.cfg.layer % n == 0 and v.cfg.layer <= self.IsFinishFloor then
                isHasRewarLayout = true
                floor = v.cfg.layer
            end
        end
        if isHasRewarLayout then
            start = floor - 4
            self.has10NReward = true
        end
    end

    self.tower_count = self.finshi - start
    --XZNS-8689 【Beta_1.1.9】BuglistXZNS-8772【魔星塔】通关至1490层后塔的显示位置错误
    self.tower_count = math.max(self.tower_count,7) --剩余挑战关卡不足不能低于7
    self.go_table.scrollloopvectical_Tower:UpdateCount(self.tower_count)
    self.go_table.scrollloopvectical_Tower:ScrollToIndex(self.tower_count - 1)
end
function DeadsoulView:GetMaxFloor(star)
    for i = star, star+35 do
        if not self.TowerInfo[i] or self.TowerInfo[i].is_top then
            return i
        end
    end
    return star+35
end

