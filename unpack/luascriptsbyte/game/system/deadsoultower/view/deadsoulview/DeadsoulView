function DeadsoulView:SetOneTower(obj, data)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.Onclick))
    tb.data = data

    local isPass = self.IsFinishFloor and self.IsFinishFloor >= data.layer
    local isBoxAward = isPass and self.has10NReward and data.layer % 10 == 0
    if isPass then
        tb.aortext_ceng.text = _G.LangUtil.GetLangPackValue(90000000118) --已通关
        --如果为10N关且未领取奖励
        if isBoxAward then
            tb.aorbtn_Chest:SetActiveE(1)
