            sid = Getlayer,
            uid = self.GetRecommend[index].uid,
            index = 1
        },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            --TODO: 现在主界面不显示首通玩家了??
            local leftName, rightName = "", ""

            self:RemoveListener(_G.eBattleState.RecordStart, self.OnRecordStart)
            self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
            _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
            _G.BattleManager:GetInstance():EnterRecordFight(
                1,
                true,
                _G.BattleControllerType.Tower,
                true,
                self.fzsid,
                leftName,
                rightName
            )

            if call then
                call(self.recordData)
            end
        end
    )
end

function DeadsoulView:OnRecordStart()
    self:Hide()
    self:RemoveListener(_G.eBattleState.RecordStart, self.OnRecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

function DeadsoulView:OnRecordEnd()
    self:Show()
    self:RemoveListener(_G.eBattleState.RecordEnd, self.OnRecordEnd)
end

--endregion

function DeadsoulView:OnDestroy()
    if self.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.WiatCoroutine)
        self.WiatCoroutine = nil
    end

    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    if self.WeekTimer ~= nil then
        self.WeekTimer:Stop()
        self.WeekTimer = nil
    end
end

return DeadsoulView
