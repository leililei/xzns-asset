---快速挑战
function DeadsoulView:DoStartFight_quick()
    ---登顶
    if self.IsFinishFloor >= #self.TowerInfo then
        _G.PopWindowManager:GetInstance():ShowAllTips(390103)
        return
    end
    ---进入主塔或者试炼
    if self.PropType ~= 9 then
        return
    end
    _G.DeadsoulTowerManager:GetInstance():QuickChallenges(
        self.TowerInfo[self.Floor].id,
        #self.TowerInfo,
        function(quickFloor, data)
            if self.waitPlayAni == nil then
                self.waitPlayAni = _G.coroutine.start(_G.handlerbind(self, self.CoOnProgressTower, quickFloor, data))
            end
        end
    )
end

function DeadsoulView:CoOnProgressTower(quickFloor, data)
    _G.coroutine.yield()
    self.go_table.scrollloopvectical_Tower:UpdateAllItem()
    _G.coroutine.yield()

    self:PlayAni(
        quickFloor,
        function()
            self:PlayAniOver(data)
        end
    )
    _G.coroutine.yield()
    -- if self.IsFinishFloor >= #self.TowerInfo then
    --     self.go_table.obj_towerContent:SetLocalPosition(0, -45.7, 0)
    -- end
    if self.waitPlayAni ~= nil then
        _G.coroutine.stopwaiting(self.waitPlayAni)
        self.waitPlayAni = nil
    end
end

function DeadsoulView:PlayAniOver(data)
    if self.waitPlayAni then
        _G.coroutine.stopwaiting(self.waitPlayAni)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, false)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)

    self.exraAward = {}
    self.Floor = 0
    self.MaxFloor = 0
    self:InitTowerInfo()
    self:UpdateTowerAni()
    self.go_table.scrollloopvectical_Tower:ScrollToIndex(self.tower_count - 1)
end

