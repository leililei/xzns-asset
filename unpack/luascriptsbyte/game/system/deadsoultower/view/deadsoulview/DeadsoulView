---@param award_list table 额外奖励的 塔层id
function DeadsoulView:RefresExtraAward(award_list)
    if _G.table.isEmptyOrNil(award_list) then
        return
    end
    for i = 1, #award_list do
        local number = award_list[i]
        local index = 0
        for key, value in pairs(self.exraAward) do
            if value == number then
                index = key
                break
            end
        end
        if index ~= 0 then
            _G.table.remove(self.exraAward, index)
        end
    end
    local temp = {}
    if not _G.table.isEmptyOrNil(self.exraAward) then
        for key, value in pairs(self.exraAward) do
            _G.table.insert(temp, value)
        end
        _G.table.sort(
            temp,
            function(a, b)
                return a < b
            end
        )
    end
    self.exraAward = temp
    self:UpdateExtraAward(self.exraAward)
end

