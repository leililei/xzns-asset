---拿当前塔面数据
function DeadsoulView:InitTowerInfo()
    self.TowerInfo = {}
    self.Floor_list = {}
    self.TowerInfo = DeadsoulTowerModel:GetInstance():InitTowerInfo(self.PropType)
    --设置下 当前塔类型的 最大层
    DeadsoulTowerModel:GetInstance():SetMaxCurrentTower(self.TowerInfo[#self.TowerInfo])
    local cfg = _G.ConfigManager.tower_cfg
    self.IsFinishFloor = 0

    if _G.AppSetting.DEBUG then
        _G.Log(self.PropType, "塔类型>>>>>>")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(DeadsoulTowerModel:GetInstance().PracticeFloor, "五行塔爬塔进度数据")
    end
    local flag = false
    if self.PropType == DeadsoulTowerModel:GetInstance().MianTower then
        self.IsFinishFloor = DeadsoulTowerModel:GetInstance().LandFloor
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_challenge, false)
        self.exraAward = DeadsoulTowerModel:GetInstance().award_list
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Wuxing, false)
        --检测战力是否充足
        flag = true
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Wuxing, true)
        self.IsFinishFloor = DeadsoulTowerModel:GetInstance().PracticeFloor[self.PropType].high_floor
        self.go_table.aorimage_wuxing_icon.SpriteName = wuxintip[self.PropType].image
        self.go_table.aortext_type.text = _G.GetLangPackValue(wuxintip[self.PropType].text)
        self.exraAward = DeadsoulTowerModel:GetInstance().PracticeFloor[self.PropType].award_list
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_challenge, true)
        local dayFightFloor = _G.ConfigManager.discrete_cfg[101801][1][1]

        local isFightFloor = DeadsoulTowerModel:GetInstance().PracticeFloor[self.PropType].pass_num
        self.go_table.aortext_challenge.text = _G.LangUtil.GetLangPackValue(90023200008, dayFightFloor - isFightFloor)
    end
    if self.IsFinishFloor > 0 then
        self.IsFinishFloor = cfg[self.IsFinishFloor].layer
    end

    if _G.AppSetting.DEBUG then
        _G.Log(self.IsFinishFloor .. ">=" .. #self.TowerInfo, "完成的塔层与最大层对比")
    end

    if self.IsFinishFloor >= #self.TowerInfo then
        if _G.AppSetting.DEBUG then
            _G.Log("已爬塔到顶")
        end
        self.Floor = self.IsFinishFloor
        self.MaxFloor = #self.TowerInfo
    else
        self.Floor = self.IsFinishFloor + 1

        if self.Floor <= 3 then
            self.MaxFloor = 5
        else
            self.MaxFloor = (self.Floor + 2) > #self.TowerInfo and #self.TowerInfo or (self.Floor + 2)
        end
    end
    -- 判断是否能够快速爬塔
    if flag and self.PropType == DeadsoulTowerModel:GetInstance().MianTower then
        flag = _G.DeadsoulTowerManager:GetInstance():CheckQuickPower(self.TowerInfo[self.Floor].id)
        if self.IsFinishFloor >= #self.TowerInfo then
            self.go_table.aorbtn_RestartDo:SetActiveE(1)
            self.go_table.aorbtn_RestartDo_quick:SetActiveE(0)
        elseif self.IsFinishFloor ~= 0 then
            self.go_table.aorbtn_RestartDo:SetActiveE(flag and 1 or 0)
            self.go_table.aorbtn_RestartDo_quick:SetActiveE(flag and 0 or 1)
            --暂时写在这里 刷新死混塔的红点
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.DeadsoulFast.id
            )
        end
    else
        self.go_table.aorbtn_RestartDo:SetActiveE(1)
    end
    if self.Floor < 3 then
        for i = 1, 6 do
            self.Floor_list[i] = self.TowerInfo[i]
        end
    elseif self.Floor > 3 and self.Floor >= (#self.TowerInfo - 2) then
        local cengchu = #self.TowerInfo - 6
        for i = 1, 6 do
            self.Floor_list[i] = self.TowerInfo[cengchu + i]
        end
    else
        self.Floor_list[1] = self.TowerInfo[self.Floor - 2]
        self.Floor_list[2] = self.TowerInfo[self.Floor - 1]
        self.Floor_list[3] = self.TowerInfo[self.Floor]
        self.Floor_list[4] = self.TowerInfo[self.Floor + 1]
        self.Floor_list[5] = self.TowerInfo[self.Floor + 2]
        self.Floor_list[6] = self.TowerInfo[self.Floor + 3]
    end

    local towerInfo = self.TowerInfo[self.Floor]
    local monsterlist = _G.ConfigManager.monster_group_cfg[towerInfo.monster[1][1]].DefaultDefenserSids
    DeadsoulTowerModel:GetInstance().enemy_lists = monsterlist[1]
    --设置额外奖励
    self:UpdateExtraAward(self.exraAward)
    self:UpdateAwardView()
    self:FreshJiJinBtn()
    self:RefreshRank()
end

---额外奖励
function DeadsoulView:UpdateExtraAward(extraAward)
    local cengshu = 0
    local reward = {}
    local index = 1
    for i = 1, #self.TowerInfo do
        if not _G.table.isEmptyOrNil(self.TowerInfo[i].reward_first) and self.TowerInfo[i].layer > self.IsFinishFloor then
            reward = self.TowerInfo[i].reward_first[1]
            cengshu = self.TowerInfo[i].layer
            index = i
            break
        end
    end
    if self.IsFinishFloor >= (#self.TowerInfo - 5) then
        --不要显示旧的奖励按钮
        --_G.GameUtil.SetActiveByCondition(self.go_table.obj_extra, true)
        --return
    end
    local flag = false
    local str = ""
    local icon = ""
    if _G.table.isEmptyOrNil(extraAward) then
        if self.IsFinishFloor >= #self.TowerInfo then
            reward = self.TowerInfo[#self.TowerInfo].reward_first[1]
            icon = (_G.ConfigManager.item_cfg[reward[1]] and _G.ConfigManager.item_cfg[reward[1]].Icon) or
                _G.ConfigManager.currency_type_cfg[reward[1]].icon
            str = _G.LangUtil.GetLangPackValue(90023200047, cengshu - self.IsFinishFloor)
        else
            icon = (_G.ConfigManager.item_cfg[reward[1]] and _G.ConfigManager.item_cfg[reward[1]].Icon) or
                _G.ConfigManager.currency_type_cfg[reward[1]].icon
            str = _G.LangUtil.GetLangPackValue(90023200047, cengshu - self.IsFinishFloor)
        end
    else
        flag = true
        local id = extraAward[#extraAward]
        reward = _G.ConfigManager.tower_cfg[id].reward_first[1]
        icon = (_G.ConfigManager.item_cfg[reward[1]] and _G.ConfigManager.item_cfg[reward[1]].Icon) or
            _G.ConfigManager.currency_type_cfg[reward[1]].icon
        str = _G.LangUtil.GetLangPackValue(90000000122)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_uieffectNode, flag)
    self.go_table.aortext_residue.text = str
    --[[    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.baseItem,
            self.go_table.obj_icon,
            function(item)
                item:Show(reward[1])
            end
        )]]
end

---更新奖励视图
---@return void
function DeadsoulView:UpdateAwardView()
    local n = 10
    --可领取的奖励列表
    local awardList = DeadsoulTowerModel:GetInstance().award_list
    --当前已完成的楼层
    local floorId = DeadsoulTowerModel:GetInstance().LandFloor

    --如果是元素塔, 取元素塔的信息
    if self.PropType ~= DeadsoulTowerModel:GetInstance().MianTower then
        local info = DeadsoulTowerModel:GetInstance().PracticeFloor[self.PropType]
        awardList = info.award_list
        floorId = info.high_floor
    end

    local floor = floorId and floorId > 0 and _G.ConfigManager.tower_cfg[floorId].layer or 0
    local startFloor = math.floor(floor / n) * n
    if awardList and #awardList > 0 then
        local minLayer = floor
        for _, id in pairs(awardList) do
            local cfg = _G.ConfigManager.tower_cfg[id]
            if cfg.layer < minLayer then
                minLayer = cfg.layer
            end
        end
        if minLayer > 1 and minLayer < floor and minLayer % n == 0 then
            minLayer = minLayer - 1 --满十层时, 往下取一层
        end
        local _sf = math.floor(minLayer / n) * n
        if _sf < startFloor then
            startFloor = _sf
        end
    end

    ---@type tower_cfg
    local nextCfg
    --当前展示的奖励列表
    self.rewardDatas = {}
    for i = 1, n do
        local f = startFloor + i
        local cfg = self.TowerInfo[f]
        if not cfg then
            break
        end
        table.insert(self.rewardDatas, 1, { --倒序插入
            cfg = cfg,
            isPass = f <= floor,
        })
        if f > floor and #cfg.reward_first > 0 then
            nextCfg = cfg
        end
    end
    self.go_table.scrollloopvectical_reward:UpdateCount(#self.rewardDatas)

    --进度条
    local n, t = floor - startFloor, #self.rewardDatas
    self.go_table.slider_rewardProgress.value = (t <= 1 or n < 0) and 0 or n / (t - 1);

    --下一个奖励
    if awardList and #awardList > 0 then
        self.go_table.aortext_rewardNext.text = _G.GetLangPackValue(90022200014); --可领取奖励
    elseif not nextCfg then
        self.go_table.aortext_rewardNext.text = _G.GetLangPackValue(90000010985); --无可领取奖励
    else
        local id, num = table.unpack(nextCfg.reward_first[1])
        --差n关可领取
        self.go_table.aortext_rewardNext.text = _G.GetLangPackValue(90000011493, nextCfg.layer - floor);
        self.go_table.aorrawimage_rewardIcon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(id))
        self.go_table.aortext_rewardNum.text = tostring(num)
    end

    local showNextReward = nextCfg and (not awardList or #awardList == 0) --是否展示奖励图标
    self.go_table.aorrawimage_rewardIcon:SetActiveE(showNextReward and 1 or 0)
    self.go_table.aortext_rewardNum:SetActiveE(showNextReward and 1 or 0)
end

