---@param index number
---@param go UnityEngine.GameObject
function DeadsoulView:RefreshAwardItem(index, go)
    if not self.rewardItems then
        self.rewardItems = {}
    end
    ---@type DeadsoulView._obj_rewardItem_GoTable
    local item = self.rewardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.rewardItems[go:GetInstanceIDE()] = item
    end

