---@param data rank.s2c_rank_get_dead_island
function DeadsoulView:ShowPlayerRankList(data)
    if self:IsNil() then
        return
    end
    self.rankData = data.deads

    --ZHJH-4678【爬塔】排名信息未及时刷新
    --服务器数据排行刷新有延迟, 本地处理自己的数据
    if self.rankData then
        local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()
        local selfIndex = -1
        for i = 1, #self.rankData do
            if self.rankData[i].role_info.uid == selfUid then
                self.rankData[i].count_pass = self.IsFinishFloor
                selfIndex = i
                break
            end
        end
        --重新排序
        if selfIndex > 1 then
            --如果自己已经是第一名, 不作处理
            for i = selfIndex - 1, 1, -1 do
                if self.rankData[selfIndex].count_pass > self.rankData[i].count_pass then
                    local temp = self.rankData[selfIndex]
                    self.rankData[selfIndex] = self.rankData[i]
                    self.rankData[i] = temp
                    selfIndex = i
                else
                    break
                end
            end
        end
    end

    local tb
    for i = 1, 3 do
        if not self.playerList[i] then
            self.playerList[i] = _G.GetAutoGoTable(self.go_table["obj_player" .. i])
        end
        tb = self.playerList[i]
        tb.aortext_rank.text = i
        if not self.rankData or not self.rankData[i] then
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
            tb.aortext_ceng.text = ""
        else
            local name = self.rankData[i].role_info.name
            --if utf8.len(name) > 3 then
            if #name > 9 then
                --一个中文占3个长度?
                name = _G.string.utf8sub(name, 1, 3) .. "..."
            end
            tb.aortext_name.text = name
            tb.aortext_ceng.text = _G.GetLangPackValue(90027300019, self.rankData[i].count_pass)
        end
    end
    local player = _G.GetAutoGoTable(self.go_table.obj_me)
    local rankNum = self:GetPlayerRank()
    if _G.table.isEmptyOrNil(self.rankData) then
        player.aortext_rank.text = _G.GetLangPackValue(90022900040)
    else
        if rankNum == 0 then
            player.aortext_rank.text = _G.GetLangPackValue(90022900040)
        else
            player.aortext_rank.text = rankNum
        end
    end
end

