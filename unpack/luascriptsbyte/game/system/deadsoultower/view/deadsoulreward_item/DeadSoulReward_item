---@class DeadSoulReward_item : Component	死魂塔奖励 item
local DeadSoulReward_item = _G.BaseClass("DeadSoulReward_item", _G.Component)

---ZHJH-2885  ZHJH-2048 删除蓝绿
local effect = {
    [3] = "ef_BaseItemWithCount_zi",
    [4] = "ef_BaseItemWithCount_cheng",
    [5] = "ef_BaseItemWithCount_hong",
    [6] = "ef_BaseItemWithCount_jin"
}
function DeadSoulReward_item:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---创建对象时,入口构造函数
function DeadSoulReward_item:OnCreate(call)
    self.call = call
    self.item = require "BaseAwardNewItem".New(self.go_table.obj_Root, nil, 83)
    self.effectTb = {}
    self.inited = false
end

----更新显示
---@param index number 下标
---@param data ChapterRewardData
function DeadSoulReward_item:Show(index, data)
    self.index = index
    self.data = data
    self:UpdateShow()
end
---更新显示
function DeadSoulReward_item:UpdateShow()
    self.item:Show(self.data.reward)
    if self.data.cfg then
        --self.go_table.aortext_section.text = _G.string.format("%d-%d", self.data.cfg.tower, self.data.cfg.layer)
        self.go_table.aortext_section.text = _G.LangUtil.GetLangPackValue(90023200002, self.data.cfg.layer)
    end
    self.go_table.obj_Root:SetLocalScaleXYZ(self.data.isBag and 1.2 or 1)
    self.go_table.obj_mask:SetLocalScaleXYZ(self.data.isBag and 1.2 or 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Tips, self.data.isBag)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_light, false)
    if self.data.isBag then
        self.go_table.aortext_tips.text = self.data.reward:GetName() .. "x" .. self.data.reward:GetCount()
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, self.data.isGet)

    for _, v in pairs(self.effectTb) do
        _G.GameUtil.SetActiveByCondition(v, false)
    end
    self.grade = _G.StorageManager:GetInstance():GetItemGrade(self.data.reward.sid, self.data.reward.uid)
    if not self.effectTb[self.grade] then
        if not self.spawnEff then
            self.spawnEff = true
            local uiEffect = nil
            uiEffect = _G.StorageManager:GetInstance():GetCommonLightEffect(self.data.reward.sid, self.data.reward.uid)
            _G.UIUtils.LoadEffectByCfg(
                uiEffect,
                self.go_table.obj_Root,
                function(trans)
                    self.spawnEff = false
                    self.effectTb[self.grade] = trans
                    ---@type ui_effect_cfg
                    local cfg = _G.ConfigManager.ui_effect_cfg[effect[self.grade]]
                    if self.data.isBag and cfg then
                        trans:SetAnchorPosition(cfg.Pos[1], cfg.Pos[2])
                    else
                        trans:SetAnchorPosition(0, -2)
                    end
                    trans:SetLocalScaleXYZ(0.9)
                    _G.GameUtil.SetActiveByCondition(self.effectTb[self.grade], self.data.CanTake)
                    if not self.inited then
                        self.inited = true
                        local item = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        self.co =
                            _G.DelayDo(
                            0.3,
                            function()
                                item.enabled = false
                                item.enabled = true
                            end
                        )
                    else
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    end
                end
            )
        end
    else
        _G.GameUtil.SetActiveByCondition(self.effectTb[self.grade], self.data.CanTake)
    end
end

---点击奖励item回调
function DeadSoulReward_item:OnClickBtn(go, isOn)
    if self.call then
        self.call(go, isOn, self)
    end
end

---销毁对象时,析构函数
function DeadSoulReward_item:OnDestroy()
    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
end

return DeadSoulReward_item
