require "BaseGameNet"
---@class SystemMaterialNet : BaseGameNet	通信协议
local SystemMaterialNet = _G.BaseClass("SystemMaterialNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return SystemMaterialNet SystemMaterialNet
function SystemMaterialNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SystemMaterialNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SystemMaterialNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

--region金币副本
---获取金币副本信息
---@param callback function 获取回调
function SystemMaterialNet:GetGoldInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_instance_gold_info, self:GetEmptyPB(), callback)
end
---金币副本挑战
---@param sid number 层数
---@param callback function 挑战回调
function SystemMaterialNet:GoldFight(sid, callback)
    return self:Access(_G.ConfigManager.net_map.game_instance_gold_fight, {sid = sid}, callback)
end
--endregion

