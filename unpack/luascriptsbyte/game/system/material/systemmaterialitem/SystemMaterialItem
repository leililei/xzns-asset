---@class SystemMaterialItem	中文描述
---@field go_table SystemMaterialView._obj_item_GoTable
---@field data SystemMaterialData
---@field RewardItems BaseAwardNewItem[]
local SystemMaterialItem = _G.BaseClass("SystemMaterialItem",_G.LogicClass)
local SystemMaterialController = require "SystemMaterialController"
local PrivilegeType = {
    [101] = _G.PrivilegeType.System.CoinAdd,
    [102] = _G.PrivilegeType.System.ExpAdd,
    [103] = _G.PrivilegeType.System.Equipment,
    [105] = _G.PrivilegeType.System.StarAdd
}
local table = _G.table
---@type PrivilegeManager
local PrivilegeManager
function SystemMaterialItem:__init(obj)
    PrivilegeManager = require "PrivilegeManager"
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.RewardItems = {}
    self.go_table.scrollloophorizontal_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---@param data SystemMaterialData
function SystemMaterialItem:UpdateData(data, curId)
    self.data = data
    self.AwrdDatas = {}
    local award = {}
    local system = data.cfg.system and data.cfg.system or 105
    local privilegeData = PrivilegeManager:GetInstance():GetPrivilegeDataNew({ PrivilegeType[system] })
    if system == 105 then
        if not table.isEmptyOrNil(privilegeData) then
            for _, v in pairs(privilegeData[2]) do
                award[v] = privilegeData[3][1]
            end
        end
    else
        if not table.isEmptyOrNil(privilegeData) then
            for _, v in pairs(privilegeData) do
                award[v[2]] = v[3]
            end
        end
    end
    self.firstList = {}
    if self.data.id >= curId then
        for _, v in ipairs(data.cfg.reward_first) do
            self.firstList[v[1]] = { pos = #self.AwrdDatas + 1, base = v }
            self.AwrdDatas[#self.AwrdDatas + 1] = _G.DeepCopyCfgTable(v)
        end
    end
    for _, v in ipairs(data.cfg.reward) do
        if self.firstList[v[1]] then
            self.AwrdDatas[self.firstList[v[1]].pos][2] = self.AwrdDatas[self.firstList[v[1]].pos][2] + v[2]
        else
            self.AwrdDatas[#self.AwrdDatas + 1] = _G.DeepCopyCfgTable(v)
        end
    end
    if not table.isEmptyOrNil(privilegeData) then
        local item = {}
        local items = {}
        local RoundToInt = _G.Mathf.RoundToInt
        for _, v in pairs(self.AwrdDatas) do
            if award[v[1]] then
                item[1] = v[1]
                item[2] = RoundToInt(v[2] * (award[v[1]] / 10000))
                item.isPri = true
                table.insert(items, item)
            end
        end
        if not table.isEmptyOrNil(items) then
            for _, v in pairs(items) do
                table.insert(self.AwrdDatas, v)
            end
        end
    end
    self.go_table.scrollloophorizontal_itemList:UpdateCount(#self.AwrdDatas)
    self.go_table.aortext_floor.text =
        _G.string.format(_G.LangUtil.GetLangPackValue(90023200002), self.data.cfg.difficulty)
    local power = _G.ConfigManager.monster_group_cfg[self.data.cfg.monster].Power
    if power > _G.PlayerModel:GetInstance():GetPower() then
        self.go_table.aortext_powerDown:SetActiveE(1)
        self.go_table.aortext_powerUp:SetActiveE(0)
        self.go_table.aortext_powerDown.text = _G.GameUtil.NumberToUnitWord(power)
    else
        self.go_table.aortext_powerDown:SetActiveE(0)
        self.go_table.aortext_powerUp:SetActiveE(1)
        self.go_table.aortext_powerUp.text = _G.GameUtil.NumberToUnitWord(power)
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, data.isLock)
    self.go_table.obj_recommend:SetActiveE(self.data.isLock and 0 or 1)
    if self.data.isLock then
        self.go_table.aortext_lock.text = self.data:GetLockStr()

        if self.data:GetLockStr() == _G.GetLangPackValue(90022900049) then
            self.go_table.aortext_lock.text = ""
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_isOn, self.data.id == curId)
    self.go_table.scrollloophorizontal_itemList:GetComponentE(
        _G.typeof(_G.CS.UnityEngine.UI.ScrollRect)
    ).horizontal = #self.AwrdDatas > 2
    _G.DelayFrameDo(function()
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.trans_power)
    end)
    if _G.AppSetting.IsXzns then
        self:RefreshRight()
    end
end

function SystemMaterialItem:RefreshRight()
    self.systemID = self.data.cfg.system
    if not self.systemID then
        self.systemID = 105
    end
    self.curFloor = SystemMaterialController:GetInstance():GetCurChallengeFloor(self.systemID)
    self.go_table.aorbtn_changgle:SetActiveE(0)
    self.go_table.aorbtn_sweep:SetActiveE(0)
    self.go_table.aorimage_finish:SetActiveE(0)
    self.go_table.aortext_tips:SetActiveE(0)
    self.go_table.obj_lock:SetActiveE(0)
    self.curTimes = SystemMaterialController:GetInstance():GetTImesAndCount(self.systemID)
    self.go_table.aortext_num.text = self.curTimes

    if self.curTimes == 0 then
        self.go_table.aortext_num.text = _G.string.format("<color=#5B6477>%d</color>", self.curTimes)
    end
    local power = _G.ConfigManager.monster_group_cfg[self.data.cfg.monster].Power
    self.go_table.aortext_powerUp.text = _G.GameUtil.NumberToUnitWord(power)
    self.go_table.aortext_powerDown.text = _G.GameUtil.NumberToUnitWord(power)

    if self.data.isLock then
        self.go_table.aortext_tips.text = self.data:GetLockStr()
    end



    local floorCount = SystemMaterialController:GetInstance():GetFloorCount(self.systemID)
    local isPass = SystemMaterialController:GetInstance():
    CheckIsPass(self.systemID, self.curFloor)
    if self.curFloor == self.data.cfg.difficulty then
        if isPass then
            self.go_table.aorbtn_sweep:SetActiveE(1)
        else
            self.go_table.aorbtn_changgle:SetActiveE(1)
        end
    elseif self.curFloor > self.data.cfg.difficulty then
        if self.curFloor - self.data.cfg.difficulty == 1 and not isPass then
            self.go_table.aorbtn_sweep:SetActiveE(1)
        else
            self.go_table.aorimage_finish:SetActiveE(1)
        end
    else
        self.go_table.aortext_tips:SetActiveE(1)
    end
end

---刷新物体
function SystemMaterialItem:RefreshItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local item = self.RewardItems[instanceID]
    if not item then
        item = _G.GetAutoGoTable(obj)
        item.awardItem = require "BaseAwardNewItem".New(item.obj_Root)
        self.RewardItems[instanceID] = item
    end
    local data = self.AwrdDatas[index + 1]
    local first = self.firstList[self.AwrdDatas[index + 1][1]]
    if first then
        item.obj_first:SetActiveE(1)
        -- if data[2] == first.base[2] then
        --     item.aortext_rate.text = _G.GetLangPackValue(90000011041, 1)
        -- else
        --     item.aortext_rate.text = _G.GetLangPackValue(90000011041, math.floor(data[2] / (data[2] - first.base[2])))
        -- end
        item.aortext_rate.text = _G.GetLangPackValue(90000011041)
    else
        item.obj_first:SetActiveE(0)
    end
    item.awardItem:ShowWithID(
        data,
        nil,
        function(tran)
            tran.item:SetPri(data.isPri)
        end
    )
end

function SystemMaterialItem:OnClickBtn(go, isOn)
    if _G.AppSetting.IsXzns then
        if go == self.go_table.aorbtn_changgle then
            if self.data.isLock then
                if self.data.tipId then
                    _G.PopWindowManager:GetInstance():ShowAllTips(self.data.tipId, self.data.lockStr)
                end
                return
            end
            local floorCount = SystemMaterialController:GetInstance():GetFloorCount(self.systemID)
            if
                SystemMaterialController:GetInstance():CheckIsPass(self.systemID, self.curFloor) and
                self.curFloor < floorCount
            then
                if not SystemMaterialController:GetInstance():CheckCondition(self.systemID, self.curFloor + 1) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(310118)
                    return
                end
            end
            if not SystemMaterialController:GetInstance():CheckIsPass(self.systemID, floorCount) then
                if _G.MainManager:GetInstance():IsFighting(true) then
                    return
                end
                SystemMaterialController:GetInstance():OnChallenge(self.systemID, self.curFloor)
            else
                SystemMaterialController:GetInstance():OnSweep(
                    self.systemID,
                    self.curTimes,
                    function()
                        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SystemMaterialView
                        .Name)
                        if window then
                            window.View:InitView()
                            window.View:RefreshAllItem()
                        end
                    end
                )
            end
        elseif go == self.go_table.aorbtn_sweep then
            if self.curFloor == 1 and not SystemMaterialController:GetInstance():CheckIsPass(self.systemID, self.curFloor) then
                _G.PopWindowManager:GetInstance():ShowAllTips(310114)
                return
            end
            SystemMaterialController:GetInstance():OnSweep(
                self.systemID,
                1,
                function()
                    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
                    if window then
                        window.View:InitView()
                        window.View:RefreshAllItem()
                    end
                end
            )
        end
    end
    if go == self.go_table.aorbtn_lock then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.data.tipId, self.data:GetLockStr())
    end
end

return SystemMaterialItem
