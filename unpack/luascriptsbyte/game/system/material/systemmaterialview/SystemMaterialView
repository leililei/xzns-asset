---更新界面显示
function SystemMaterialView:InitView()
    local cfg = _G.ConfigManager.system_cfg[self.systemID]
    self.curTimes = SystemMaterialController:GetInstance():GetTImesAndCount(self.systemID)
    local time
    if time == nil then
        time = ""
    else
        time = _G.TimeUtil.TranslateSecondForStr(self.StarSoulModel:GetLeftTime())
    end
    -- self.go_table.aortext_endTime.text = _G.string.format(_G.LangUtil.GetLangPackValue(90022900045), time)
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.power)
    self.go_table.aortext_num.text = self.curTimes
    self.go_table.aorrawimage_name:LoadImage(titlePath[self.systemID])
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_hun, self.systemID == 105)
    if _G.AppSetting.IsXzns then
        if self.systemID == 102 then
            _G.GameUtil.SetUiHeXieMask(self.go_table)
        else
            self.go_table.obj_HeXieMask:SetActiveE(0)
        end
    end
    if self.systemID == 105 then
        self:UpdateHun()
    end
    self.go_table.obj_month:SetActiveE(self.showMonthSid[self.systemID] and 1 or 0)
    self.monthData = require "MonthlyModel":GetInstance():GetMonthlyCard(401002)
    self.go_table.aorbtn_month:SetActiveE(self.monthData and 0 or 1)
    self.go_table.obj_time:SetActiveE(self.monthData and 1 or 0)
    if self.monthData then 
        self.go_table.aortext_monthEndTime.text = _G.GetLangPackValue(90000011951, self.monthData.time)
    end
end

---更新spine
function SystemMaterialView:UpdateSpine()
    self.go_table.obj_CardSpine:ClearChildren()
    local index = self.StarSoulModel:GetPro()
    if index == nil or self.systemID ~= 105 then
        index = 1
    end
    local cfg
    if self.systemID == 105 then
        cfg = _G.ConfigManager.system_prof_cfg[(self.StarSoulModel:GetPro() + 100) * 1000 + 1]
    else
        cfg = _G.ConfigManager.system_material_cfg[self.systemID * 1000 + 1]
    end
    _G.PoolsManager:GetInstance():Spawn(
            cfg.image,
            _G.ePoolType.Temporary,
            self.go_table.obj_CardSpine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(cfg.pos_portrait[1][1])
                trans:SetLocalPosition(cfg.pos_portrait[2][1], cfg.pos_portrait[2][2], cfg.pos_portrait[2][3])
                if cfg.pos_portrait[3] then
                    local rotation = _G.Quaternion.Euler(cfg.pos_portrait[3][1], cfg.pos_portrait[3][2], cfg.pos_portrait[3][3])
                    trans:SetLocalRotation(rotation.x, rotation.y, rotation.z, rotation.w)
                end
                if _G.AppSetting.IsXzns then
                    _G.GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                end
            end
    )
end

---更新星魂界面
function SystemMaterialView:UpdateHun()
    self.go_table.aorimage_hunIcon.SpriteName = proIcon[self.StarSoulModel:GetPro()]
end

---更新时间
function SystemMaterialView:UpdateTime(RTS)
    if not RTS then
        self.go_table.aortext_endTime.text = _G.string.format(
                _G.LangUtil.GetLangPackValue(90022900045),
                _G.TimeUtil.TranslateSecondForStr(self.StarSoulModel:GetLeftTime())
        )
    else
        self.go_table.aortext_endTime.text = _G.string.format(_G.LangUtil.GetLangPackValue(90022900045), _G.TimeUtil.TranslateSecondForStr(RTS))
    end
end

function SystemMaterialView:OnDestroy()
    self.StarSoulModel:RemoveUpdateListener(_G.handler(self, self.UpdateTime))
    SystemMaterialController:GetInstance():UnregisterTimesChange("SystemMaterialView")
    self:RemoveAllListener()
end

---更新下一职业
function SystemMaterialView:UpdateNextPro()
    local pro = self.StarSoulModel:GetNextPro()
    self.go_table.aortext_pro.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_professional_cfg[pro].name)
    self.go_table.aorimage_pro.SpriteName = proIcon[pro]
end

function SystemMaterialView:Refresh(id)
    if id == self.systemID then
        if id == 105 then
            self:Init()
        else
            self:InitView()
        end
    end
end

