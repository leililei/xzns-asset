function SystemMaterialView:PrivilegedNew()
    self.store_month_cfg = _G.ConfigManager.store_month_cfg[PrivilegeType[self.systemID][1]]
    self.Privileged = 0

    self.go_table.obj_TeXiao:SetActiveE(1)
    self.obj_TeXiao.aortext_instruction.text = _G.ConfigManager.language_package_cfg[self.store_month_cfg.describe]
    -- local tab = _G.ConfigManager.privilege_cfg[self.store_month_cfg.extra_first[PrivilegeType[self.systemID][2]]]
    local IS = require "MonthlyModel":GetInstance():IsHavePrivi(PrivilegeType[self.systemID][1])
    --local count = require "HellRoadModel":GetInstance():GetNumber(tab.privilege[1])
    if IS then
        self.obj_TeXiao.aortext_YiJiHuo:SetActiveE(1)
        self.obj_TeXiao.aorbtn_TiaoZhuan:SetActiveE(0)
        self.obj_TeXiao.aortext_Name.text = _G.ConfigManager.language_package_cfg[90000001139]
    else
        self.obj_TeXiao.aortext_YiJiHuo:SetActiveE(0)
        self.obj_TeXiao.aorbtn_TiaoZhuan:SetActiveE(1)
        self.obj_TeXiao.aortext_Name.text = _G.ConfigManager.language_package_cfg[90020600036]
    end

    self:InstructionIS()
end

function SystemMaterialView:InstructionIS()
    self.obj_TeXiao.obj_Tip:SetActiveE(self.Privileged)
end

---按钮点击事件在这里派发
function SystemMaterialView:PrivilegedBtn(go, isOn)
    local name = go:GetName()

    if name == "@_aorbtn_TeXiao" then
        self.Privileged = 1
        self:InstructionIS()
    elseif name == "@_aorbtn_jianlitanchuang" then
        self.Privileged = 0
        self:InstructionIS()
    elseif name == "@_aorbtn_TiaoZhuan" then
        if self.store_month_cfg.type_1 == 1 then
            _G.JumpManager:GetInstance():Jump(148001)
        elseif self.store_month_cfg.type_1 == 4 then
            _G.JumpManager:GetInstance():Jump(165001)
        end
    end
end

