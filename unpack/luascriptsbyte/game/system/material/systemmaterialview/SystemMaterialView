---@param item SystemMaterialToggleItem
function SystemMaterialView:OnClickToggle(item)
    _G.AudioManager.PlayAudioByAudioCfgID(2003)
    if self.systemID == item.cfg.id and self.curFloor then
        return
    end

    self.systemID = item.cfg.id
    self:Init()
    self:UpdateSpine()
end

function SystemMaterialView:Init()
    if self.systemID == 105 then
        self.cfgs = _G.ConfigManager.system_material_cfg
    else
        self.cfgs = _G.ConfigManager.system_prof_cfg
    end
    SystemMaterialController:GetInstance():SetCurChooseMaterial(self.systemID)
    SystemMaterialController:GetInstance():UpdateData(self.systemID)
    self.Datas = SystemMaterialController:GetInstance():GetDatas(self.systemID)
    self.curFloor = SystemMaterialController:GetInstance():GetCurChallengeFloor(self.systemID)

    self.curData = self.Datas[SystemMaterialController:GetInstance():GetMaterailIDBySidAndFloor(self.systemID, self.curFloor)]

    self.go_table.scrollloopvectical_ItemList:UpdateCount(_G.table.count(self.Datas))
    if _G.AppSetting.IsXzns then
        self.go_table.scrollloopvectical_ItemList:ScrollToIndex(self.curFloor - 2)
    else
        self.go_table.scrollloopvectical_ItemList:ScrollToIndex(self.curFloor - 1)
    end
    self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
    self:InitView()
    local sweepGray = self.curFloor == 1 and not SystemMaterialController:GetInstance():CheckIsPass(self.systemID, self.curFloor)
    self.go_table.aorbtn_sweep:SetGray(sweepGray)
    self.go_table.aorbtn_sweep:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString(sweepGray and "FFAAFF" or "FFFFFF")
    self.label1.color = _G.ColorTools.FormatColorByString(sweepGray and color[3] or color[1])
    self.go_table.aorrawimage_bg:LoadImage(_G.ConfigManager.system_cfg[self.systemID].image)
    local floorCount = SystemMaterialController:GetInstance():GetFloorCount(self.systemID)
    local notShow = false
    if self.curFloor < floorCount then
        if sweepGray then
            notShow = not SystemMaterialController:GetInstance():CheckCondition(self.systemID, self.curFloor)
        else
            notShow = SystemMaterialController:GetInstance():CheckIsPass(self.systemID, self.curFloor) and
                    not SystemMaterialController:GetInstance():CheckCondition(self.systemID, self.curFloor + 1)
        end
    end
    self.go_table.aorbtn_changgle:SetGray(notShow)
    self.go_table.aorbtn_changgle:GetComponentE(_G.typeof(_G.CS.AorImage)).color = _G.ColorTools.FormatColorByString(notShow and "FFAAFF" or "FFFFFF")
    self.label2.color = _G.ColorTools.FormatColorByString(notShow and color[3] or color[2])
    self.go_table.aortext_changgle.text = SystemMaterialController:GetInstance():CheckIsPass(self.systemID, floorCount) and
            _G.GetLangPackValue(90022900072) or
            _G.GetLangPackValue(91111800101)
    self:ShowAdTxt()
end

