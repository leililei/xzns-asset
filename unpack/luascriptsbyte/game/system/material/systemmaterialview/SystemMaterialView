function SystemMaterialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.Toggles = {}
    self.SectionItems = {}
    self:AddListener(_G.eAdvertisement.Refresh, self.ShowAdTxt)
    self.showMonthSid = {}
    for k, v in ipairs(_G.ConfigManager.store_month_cfg[401002].extra_first) do 
        if _G.ConfigManager.privilege_cfg[v].privilege[1][1] == _G.PrivilegeType.System.Count then 
            self.showMonthSid[_G.ConfigManager.privilege_cfg[v].privilege[1][2]] = true
        end
    end
end

---界面的入口函数
function SystemMaterialView:OnCreate(id)
    self.AdRedPointType = {
        [101] = _G.ConfigManager.redpoint_cfg.TimesofCoinAdd.id,
        [102] = _G.ConfigManager.redpoint_cfg.TimesofExpAdd.id,
        [103] = _G.ConfigManager.redpoint_cfg.TimesofEquipment.id,
        [105] = _G.ConfigManager.redpoint_cfg.TimesofStarAdd.id
    }
    self.systemID = id or SystemMaterialController:GetInstance():GetOpenModel()
    self.label1 = self.go_table.aorbtn_sweep:GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorText))
    self.label2 = self.go_table.aorbtn_changgle:GetChildE(0):GetComponentE(_G.typeof(_G.CS.AorText))
    self.go_table.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.StarSoulModel = SystemMaterialController:GetInstance():GetModel(105)
    self.StarSoulModel:AddUpdateListener(_G.handler(self, self.UpdateTime))
    self:RefreshPower()
    self:InitToggle()
    self:InitView()
    self:InitComponent()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.StarSoulModel.curFunctionOpenID) then
        self:UpdateNextPro()
    end
    -- self:PrivilegedNew()

    SystemMaterialController:GetInstance():RegisterTimesChange("SystemMaterialView", _G.handler(self, self.Refresh))
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
end

---刷新阵容战力
function SystemMaterialView:RefreshPower()
    --self.power = SystemMaterialController:GetInstance():GetPower(self.systemID)
    ---ZHJ-23069 改为显示最低等级
    self.power = SystemMaterialController:GetInstance():GetMinLevel(self.systemID)
end

function SystemMaterialView:ShowAdTxt()
    if not adType[self.systemID] then
        self.go_table.aorbtn_ad:SetActiveE(0)
        return
    end
    local model = require("AdvertisementModel"):GetInstance()
    if not model:CheckADShow(adType[self.systemID]) then
        self.go_table.aorbtn_ad:SetActiveE(0)
        return
    end

    local max = model:GetAdMax(adType[self.systemID])
    self.go_table.aorbtn_ad:SetActiveE(1)

    if max <= 1 then
        self.go_table.aortext_ad.text = _G.GetLangPackValue(90000011733)
    else
        local watchedNum = model:GetWatchedAdNum(adType[self.systemID])
        local curNum = max - watchedNum
        if max - watchedNum <= 0 then
            curNum = _G.string.format("<color=#AA3932>%d</color>", curNum)
        end
        self.go_table.aortext_ad.text = _G.GetLangPackValue(90000011734, curNum, max)
    end
end

---按钮点击事件在这里派发
function SystemMaterialView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_changgle then
        if self.curData.isLock then
            if self.curData.tipId then
                _G.PopWindowManager:GetInstance():ShowAllTips(self.curData.tipId, self.curData.lockStr)
            end
            return
        end
        local floorCount = SystemMaterialController:GetInstance():GetFloorCount(self.systemID)
        if
        SystemMaterialController:GetInstance():CheckIsPass(self.systemID, self.curFloor) and
                self.curFloor < floorCount
        then
            if not SystemMaterialController:GetInstance():CheckCondition(self.systemID, self.curFloor + 1) then
                _G.PopWindowManager:GetInstance():ShowAllTips(310118)
                return
            end
        end
        if not SystemMaterialController:GetInstance():CheckIsPass(self.systemID, floorCount) then
            if _G.MainManager:GetInstance():IsFighting(true) then
                return
            end
            SystemMaterialController:GetInstance():OnChallenge(self.systemID, self.curFloor)
        else
            SystemMaterialController:GetInstance():OnSweep(
                    self.systemID,
                    self.curTimes,
                    function()
                        self:InitView()
                    end
            )
        end
    elseif go == self.go_table.aorbtn_sweep then
        if self.curFloor == 1 and not SystemMaterialController:GetInstance():CheckIsPass(self.systemID, self.curFloor) then
            _G.PopWindowManager:GetInstance():ShowAllTips(310114)
            return
        end
        SystemMaterialController:GetInstance():OnSweep(
                self.systemID,
                1,
                function()
                    self:InitView()
                end
        )
    elseif go == self.go_table.aorbtn_CloseView then
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_closeTip then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_hunTip, false)
    elseif go == self.go_table.aorbtn_hun then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_hunTip, true)
    elseif go == self.go_table.aorbtn_help then
        local id = playWay[self.systemID]
        if id > 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, id)
        end
    elseif go == self.go_table.aorbtn_info then
        local index
        if self.systemID == 105 then
            index = self.StarSoulModel:GetPro()
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossIntroduceView.Name, self.systemID, index)
    elseif go == self.go_table.aorbtn_ad then
        ---广告
        local sid = adType[self.systemID]
        if not sid then
            return
        end

        require "MonthlyModel":GetInstance():CheckShowADTips(function()
            require("AdvertisementModel"):GetInstance():PlaySystemMaterialAd(
                sid,
                self.systemID,
                function()
                    require("RedPointManager"):GetInstance():RefreshNode(self.AdRedPointType[self.systemID])
                    if self:IsNil() then
                        return
                    end
                    self:ShowAdTxt()
                end
            )
        end)
    elseif go == self.go_table.aorbtn_month then 
        if _G.ConfigManager.item_way_cfg[148001] then
            _G.JumpManager:GetInstance():Jump(148001)
        end
    end
end

function SystemMaterialView:InitComponent()
    local resources = _G.ConfigManager.ui_cfg.SystemMaterialView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.playerHead = self:AddComponent(
            self.go_table.trans_PlayerHead,
            require("PlayerComponent").New(self.go_table.trans_PlayerHead)
    )
end

function SystemMaterialView:InitToggle()
    local tb = _G.table.chooseToArray(
            _G.ConfigManager.system_cfg,
            function(k, v)
                return k ~= 104 and k < 200
            end
    )
    _G.table.sort(
            tb,
            function(a, b)
                return a.display_priority < b.display_priority
            end
    )
    local count = #tb
    for i = 1, count do
        _G.PoolsManager:GetInstance():Spawn(
                togglePath,
                _G.ePoolType.Temporary,
                self.go_table.togglegroup_Content,
                function(trans)
                    local cfg = tb[i]
                    trans:SetName(cfg.id)
                    self.Toggles[i] = require "SystemMaterialToggleItem".New(trans, i, cfg, _G.handler(self, self.OnClickToggle))
                    self.Toggles[i].go_table.toggle_material.group = self.go_table.togglegroup_Content
                    if cfg.id == self.systemID then
                        self.Toggles[i]:SetIsOn(true)
                    end
                end
        )
    end
end

