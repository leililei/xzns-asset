function SystemMaterialView:RefreshSkills()
    if not self.Skills then
        self.Skills = {}
        for i = 1, 3 do
            self.Skills[i] = _G.GetAutoGoTable(self.go_table["obj_skill" .. i])
            _G.AddViewBtnClick(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, self.Skills[i]))
        end
    end
    local tb = self.Skills[1]
    local cfg
    for i = 1, 3 do
        tb = self.Skills[i]
        cfg = _G.ConfigManager.card_skills_cfg[self.curData.cfg.preview_skill[i]]
        if cfg then
            tb.cfg = cfg
            tb.aorrawimage_icon:LoadImage(cfg.icon)
        else
            tb.aorrawimage_icon:LoadImage("")
        end
    end
end

function SystemMaterialView:OnClickSkill(go, isOn, item)
    require "CommonTipManager":GetInstance():OpenSkillTip(item.cfg.id)
end

function SystemMaterialView:RefreshItem(index, obj)
    local data = self.Datas[SystemMaterialController:GetInstance():GetMaterailIDBySidAndFloor(self.systemID, index + 1)]
    local instanceID = obj:GetInstanceIDE()
    local item = self.SectionItems[instanceID]
    if not item then
        item = SystemMaterialItem.New(obj)
        self.SectionItems[instanceID] = item
    end
    item:UpdateData(data, self.curData.id)
end

--- 星座女神用
function SystemMaterialView:RefreshAllItem()
    for k, v in pairs(self.SectionItems) do
        v:RefreshRight()
    end
end

