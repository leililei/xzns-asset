---@class BaseSystemMaterialModel : Singleton	中文描述
---@field Datas table<number,SystemMaterialData>
---@field floorSid number[]
local BaseSystemMaterialModel = _G.BaseClass("BaseSystemMaterialModel", _G.GameDataModelBase)

---创建对象时,入口构造函数
function BaseSystemMaterialModel:__init()
    self.nextFight = true
    self:Init()
    self:InitFloorSid()
    _G.Events:GetInstance():AddListener(_G.eHellRoadPrivilegeEvent.HellRoadPrivilege, self.UpdateTimes, self)
end

function BaseSystemMaterialModel:Init()
    -- body
end

function BaseSystemMaterialModel:InitFloorSid()
    self.floorSid = {}
    for key, value in pairs(_G.ConfigManager.system_material_cfg) do
        if value.system == self.systemID then
            self.floorSid[value.difficulty] = key
        end
    end
end

---销毁对象时,析构函数
function BaseSystemMaterialModel:Dispose()
    self.curTimes = nil
    self.curInstance = nil
    self.maxTimes = nil
    self.systemID = nil
    self.curFunctionOpenID = nil
    self.redID = nil
    _G.Events:GetInstance():RemoveListener(_G.eHellRoadPrivilegeEvent.HellRoadPrivilege, self.UpdateTimes, self)
end

function BaseSystemMaterialModel:ParseData(data)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.redID)
    _G.GameDataModelBase.ParseData(self)
end

---初始化功能逻辑
function BaseSystemMaterialModel:InitFunction()
end

