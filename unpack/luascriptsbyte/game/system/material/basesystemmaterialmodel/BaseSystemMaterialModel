function BaseSystemMaterialModel:CheckRedPoint()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return false
    end
    return self.curTimes > 0
end

function BaseSystemMaterialModel:GetImagePath()
