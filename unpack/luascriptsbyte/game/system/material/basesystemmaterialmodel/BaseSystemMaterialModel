---获取总层数
---@param sid number 副本id
---@return number 总层数
function BaseSystemMaterialModel:GetFloorCount()
    if not self.Datas then
        return #self.floorSid
    end
    local num = 0
    for _, id in pairs(self.floorSid) do
        if not self.Datas[id].isHide then
            num = num + 1
        end
    end
    return num
end

function BaseSystemMaterialModel:GetMonster(id)
    return _G.ConfigManager.system_material_cfg[id].monster
