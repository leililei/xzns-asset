---更新挑战次数上限
function BaseSystemMaterialModel:UpdateTimes(isInit)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return
    end
    local data =
        require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.System.Count, self.systemID })
    if data[1] then
        local cfg = _G.ConfigManager.system_cfg[self.systemID]
        if cfg then
            if self.maxTimes < data[1] + cfg.count_reset then
                self.lastTimes = self.maxTimes
                self.maxTimes = data[1] + cfg.count_reset
                self.curTimes = self.curTimes + (self.maxTimes - self.lastTimes)
                require("SystemEntranceModel"):GetInstance():SetTimes(self.systemID, self.curTimes, self.maxTimes)
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.redID)
            end
        end
    end
end

function BaseSystemMaterialModel:UpdateTimesByAd(num)
    if num then
        self.maxTimes = self.maxTimes + 1
        self.curTimes = self.curTimes + 1
        require("SystemEntranceModel"):GetInstance():SetTimes(self.systemID, self.curTimes, self.maxTimes)
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.redID)
    end
end

