---@class SystemMaterialToggleItem	中文描述
---@field go_table _toggle_material_GoTable
---@field cfg system_cfg
local SystemMaterialToggleItem = _G.BaseClass("SystemMaterialToggleItem", _G.IRecycle)

local redPoint = {
    [101] = 205005,
    [102] = 205006,
    [103] = 205007,
    [105] = 205008,
    [106] = 205010,
}

local iconSpriteName = {
    [101] = "ui_yxb_siwangkuangjing_",
    [102] = "ui_yxb_yuanzhengshilian_",
    [103] = "ui_yxb_ronglushilian_",
    [105] = "ui_yxb_aoshujuxiang_",
    [106] = "ui_bs_zonglan_"
}

---类的构造函数
function SystemMaterialToggleItem:__init(trans, index, cfg, onChoose)
    self.transform = trans
    self.gameObject = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.index = index
    self.cfg = cfg
    self.onChoose = onChoose
    self:Init()
end
---初始化界面
function SystemMaterialToggleItem:Init()
    --self.go_table.aortext_downDesc.text = _G.LangUtil.GetLangPackValue(self.cfg.name)
    self.go_table.aortext_togDesc.text = _G.LangUtil.GetLangPackValue(self.cfg.name)
    self.go_table.aortext_togDescselect.text = _G.LangUtil.GetLangPackValue(self.cfg.name)
    local lock, lockType = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, lock)
    if lock then
        self.lockStr, self.tips = _G.FunctionManager:GetInstance():GetTipsStr(self.cfg.function_open)
        --self.go_table.aortext_lockDes.text = self.lockStr
        --local cfg = _G.ConfigManager.function_open_cfg[self.cfg.function_open]
    end
    self.go_table.obj_mask:SetActiveE(lock and 1 or 0)
    local image = iconSpriteName[self.cfg.id]
    self.go_table.aorimage_offIcon.SpriteName = image .. "n"
    self.go_table.aorimage_onIcon.SpriteName = image .. "c"
    self:SetRedPointParam(redPoint[self.cfg.id])
end

function SystemMaterialToggleItem:SetIsOn(isOn)
    self.go_table.toggle_material.isOn = isOn
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_isOn, isOn)
    if isOn and self.onChoose then
        self.onChoose(self)
    end
end
---设置红点
function SystemMaterialToggleItem:SetRedPointParam(id)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(id)
end

function SystemMaterialToggleItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Lock then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tips, self.lockStr)
    elseif go == self.go_table.toggle_material then
        self:SetIsOn(isOn)
    end
end

---类的析构函数
function SystemMaterialToggleItem:Dispose()
    self.go_table.toggle_com.onValueChanged:RemoveAllListeners()
    self.go_table.toggle_com.isOn = false
    self.gameObject:DestroyObject()
    _G.ObjectPool:GetInstance():Push(self)
end

return SystemMaterialToggleItem
