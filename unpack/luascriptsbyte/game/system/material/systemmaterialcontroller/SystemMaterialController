---获取当前挑战的层数
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function SystemMaterialController:GetCurChallengeFloor(id)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.modelInstance[id].curFunctionOpenID) then
        return 1
    end
    local curIndex = self.modelInstance[id]:GetCurChallengeFloor()
    if curIndex >= self:GetFloorCount(id) then
        return curIndex
    else
        local conditionPass = self:CheckCondition(id, curIndex + 1)
        if conditionPass then
            return curIndex + 1
        else
            if curIndex <= 0 then
                curIndex = 1
            end
            return curIndex
        end
    end
end

---检查能否挑战
function SystemMaterialController:CheckCondition(id, floor)
    local Cfgs = _G.ConfigManager.system_material_cfg
    if id == 105 then
        Cfgs = _G.ConfigManager.system_prof_cfg
    end
    local cfg = Cfgs[self:GetMaterailIDBySidAndFloor(id, floor)]
    if #cfg.limit_condition > 0 and not _G.GlobalConditionManager.CheckCondition(cfg.limit_condition[1], cfg.limit_condition[2]) then
        return false
    end
    if cfg.preview_condition and #cfg.preview_condition > 0 and not _G.GlobalConditionManager.CheckConditionArrays(cfg.preview_condition) then
        return false
    end
    return true
end

---获取副本层数ID (sid和难度)
---@param sid number 副本ID
---@param floor number 层数
---@return number 副本层数ID
function SystemMaterialController:GetMaterailIDBySidAndFloor(sid, floor)
    return self.modelInstance[sid]:GetMaterailIDBySidAndFloor(floor)
end

---获取总层数
---@param sid number 副本id
---@return number 总层数
function SystemMaterialController:GetFloorCount(sid)
