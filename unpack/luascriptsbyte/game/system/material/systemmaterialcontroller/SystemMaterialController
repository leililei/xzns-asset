function SystemMaterialController:OnInfoUpdate()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
    if window then
        window.View:UpdateInitView(self.curChooseMaterialID)
    end
end

function SystemMaterialController:GetEBattleType(sid)
    local cfg = _G.ConfigManager.system_material_cfg[sid]
    if not cfg then
        cfg = _G.ConfigManager.system_prof_cfg[sid]
    end
    if not cfg then
        return 0
    end
    return self.eBattleType[cfg.system]
end

function SystemMaterialController:GetEBattleTypeWithSystemId(id)
    return self.modelInstance[id]:GetEmbattleType()
end

function SystemMaterialController:OnEmbattleQuit()
    self.curChallengeSid = 0
    local isExit = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
    if isExit then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name, self.curChooseMaterialID)
    end
end

---布阵点击挑战进入接口
function SystemMaterialController:OnBattle(sid)
    --对战双方名称
    local cfg = _G.ConfigManager.system_cfg[sid]
    local leftName, rightName = _G.PlayerModel:GetInstance():GetName(), cfg and _G.GetLangPackValue(cfg.name) or ""

    self.modelInstance[self.curChooseMaterialID]:SetCanNextFight(true)
    _G.BattleManager:GetInstance():EnterFight(
        _G.BattleControllerType.SystemMetarial,
        self.curChallengeSid,
        leftName,
        rightName
    )
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
    if ctrl then
        ctrl:RefreshPower()
    end
end

---检测是否通关
function SystemMaterialController:CheckIsPass(sid, floor)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.modelInstance[sid].curFunctionOpenID) then
        return false
    end
    if not sid then
        sid = self.curChooseMaterialID
    end
    if not floor then
        floor = self.curChallengeFloor
    end
    local model = self.modelInstance[sid]
    if floor<=0 then
        floor=1
    end
    return model:CheckIsPass(self:GetMaterailIDBySidAndFloor(sid, floor))
end

