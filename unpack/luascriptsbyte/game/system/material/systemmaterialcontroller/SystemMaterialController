---检测是否能继续挑战
function SystemMaterialController:CheckCanFightNext()
    local result = self.modelInstance[self.curChooseMaterialID]:GetCanNextFight()
    self.modelInstance[self.curChooseMaterialID]:SetCanNextFight(true)
    if self:GetCurChallengeFloor(self.curChooseMaterialID) >= self:GetFloorCount(self.curChooseMaterialID) then
        result = false
    else
        if not self:CheckCondition(self.curChooseMaterialID, self.curChallengeFloor + 1) then
            result = false
        end
    end
    return result
end

