end

---挑战
---@param sid number 副本系统id
---@param floor number 副本层数ID
function SystemMaterialController:OnChallenge(sid, floor, isAuto)
    if self:CheckIsPass(sid, floor) then
        if floor >= self:GetFloorCount(sid) then
            _G.PopWindowManager:GetInstance():ShowAllTips(310113)
        end
        return
    end
    self.isAuto = isAuto
    local model = self.modelInstance[sid]
    sid = sid or self.curChooseMaterialID
    floor = floor or self.curChallengeFloor
    self.curChallengeFloor = floor
    local ebt = self.modelInstance[sid]:GetEmbattleType()
    if ebt == 0 then
        return
    end

    self.curChallengeSid = self:GetMaterailIDBySidAndFloor(sid, floor)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SystemMateriaEmbattleView.Name,
        ebt,
        _G.handler(self, self.OnEmbattleQuit),
        _G.handlerbind(self, self.OnBattle, sid),
        self.isAuto,
        floor,
        sid
    )
    --_G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    -- require("EmbattleModel"):GetInstance():ClearEmbattleData(ebt)
end

function SystemMaterialController:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        if self.isAuto then
            embattleView:SetAutoBattle()
            self.isAuto = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    end
end

---@param noUITip boolean 是否展示UI界面
function SystemMaterialController:OnSweep(sid, times, callback, noUITip)
    if self:GetTImesAndCount(sid) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(310115)
        return
    end
    sid = sid or self.curChooseMaterialID
    local model = self.modelInstance[sid]
    model:OnSweep(times, callback, noUITip)
end

