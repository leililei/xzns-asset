function SystemMaterialController:GetOpenModel()
    local minCfg
    local id
    for k, _ in pairs(self.modelInstance) do
        local cfg = _G.ConfigManager.system_cfg[k]

        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.function_open) then
            if not minCfg or (minCfg.display_priority > cfg.display_priority) then
                minCfg = cfg
                id = k
            end
        end
    end
    return id
end

