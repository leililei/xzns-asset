---@class SystemMateriaEmbattleView : UIBaseView    中文描述
---@field public go_table SystemMateriaEmbattleView_GoTable GoTable
local SystemMateriaEmbattleView = _G.BaseClass("SystemMateriaEmbattleView", _G.UIBaseView)

function SystemMateriaEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SystemMateriaEmbattleView:OnCreate(embattleType, exitCall, battleCall, autoFight, floor, sid)
    self.onExitCall = exitCall
    self.embattleType = embattleType
    self.onBattleCall = battleCall
    self.autoFight = autoFight
    self.floor = floor
    self.sid = sid
    self.model = require "SystemMaterialController":GetInstance()
    self:OpenEmbattleView()
    self:ShowCurSectionTag()
end

function SystemMateriaEmbattleView:ShowCurSectionTag()
    self.go_table.aortext_CurSection.text = _G.LangUtil.GetLangPackValue(90023200002, self.floor)
end

function SystemMateriaEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
end

function SystemMateriaEmbattleView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        self.embattleType,
        _G.EmbattleSaveType.server,
        nil,
        _G.EmbattleControllerItemType.material,
        _G.handler(self, self.OnEmbattleQuit),
        _G.handler(self, self.OnBattleCall),
        self.model:GetCurModel():GetMonster(self.model.curChallengeSid),
        self.model.curChallengeSid,
        self.model.curChooseMaterialID == 105
    )
end

function SystemMateriaEmbattleView:OnEmbattleQuit()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end

function SystemMateriaEmbattleView:OnBattleCall(...)
    if self.onBattleCall then
        self.onBattleCall(...)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function SystemMateriaEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SystemMaterialView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        ---@type EmbattleNewView
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        embattleView:SetInitDoneCall(
            function()
                self.go_table.obj_section:SetActiveE(1)
            end
        )
        --对战双方名称
        local cfg = _G.ConfigManager.system_cfg[self.sid]
        local leftName, rightName = _G.PlayerModel:GetInstance():GetName(), cfg and _G.GetLangPackValue(cfg.name) or ""
        embattleView:SetVsDescription(leftName, rightName)
        if self.autoFight then
            embattleView:SetAutoBattle()
        end
        embattleView.transform:SetParentE(self.go_table.trans_view)
    end
end

return SystemMateriaEmbattleView
