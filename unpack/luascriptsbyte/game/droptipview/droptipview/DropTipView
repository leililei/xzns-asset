require "ItemViewBase"
require "EquipViewBase"
require "StringUtil"

---@class DropTipView : UIBaseView	中文描述
---@field public go_table DropTipView_GoTable GoTable
local DropTipView = _G.BaseClass("DropTipView", _G.UIBaseView)
--_G.DropTipView = DropTipView

local CS = _G.CS
local typeof = _G.typeof

local ItemTypeStr = {
    [1] = 90010600101,
    [2] = 90010600301,
    [3] = 90000900101,
    [4] = 90000900201
}

function DropTipView:Awake()
    --_G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DropTipView:OnCreate(datas)
    if table.isEmptyOrNil(datas) then
        self:Close()
        return
    end
    self.itemDatas = {}
    if datas.award.item then
        _G.table.insert(self.itemDatas, self:ParseData(datas.award.item))
    end

    if datas.award.overflow then
        _G.table.insert(self.itemDatas, self:ParseData2(datas.award.overflow))
    end

    self:PlayerAni()
end

---播放动画
function DropTipView:PlayerAni()
    local showTime = 1.5
    for i = 1, #self.itemDatas[1] do
        _G.DelayDo(
            showTime * (i - 1),
            function()
                if not _G.IsNil(self.gameObject) and self.gameObject:GetctiveInHierarchy() == 1 then
                    self:CreateItem(self.itemDatas[1][i])
                end
            end
        )
        if _G.IsNil(self.gameObject) or self.gameObject:GetctiveInHierarchy() == 0 then
            return
        end
    end
    if self.go_table then
        _G.DelayDo(
            showTime * #self.itemDatas[1],
            function()
                _G.table.remove(self.itemDatas, 1)
                if #self.itemDatas <= 0 then
                    self:Close()
                else
                    self:PlayerAni()
                end
            end
        )
    end
end

---更新掉落奖励数据
---@param data award.i_award_item
function DropTipView:UpdateData(data)
    _G.table.insert(self.itemDatas, self:ParseData(data))
    if data.award.overflow then
        _G.table.insert(self.itemDatas, self:ParseData(data.award.overflow))
    end
end

function DropTipView:ParseData(datas)
    local table = {}
    for i = 1, #datas do
        local sid = datas[i].sid and datas[i].sid or datas[i].type[1]

        local ItemType = _G.StorageManager:GetInstance():CheckSidType(sid)
        local number = self:CheckNum(ItemType, datas[i])

        local addnum = 1
        local num = 0
        if ItemType == _G.StorageType.Card or ItemType == _G.StorageType.Equipment then -- 不堆叠
            while (num < number) do
                num = num + addnum
                table[#table + 1] = {number = addnum, sid = sid, type = 1}
            end
        else
            if sid > 100 then
                addnum = _G.ConfigManager.item_cfg[sid].MaxCount
            else
                addnum = 9999999999999999999
            end

            self:AddItem(table, sid, number, 1, addnum)
        end
    end

    return table
end

function DropTipView:ParseData2(datas)
    local table = {}
    for k, v in pairs(datas) do
        local sid = v.type[1]

        local ItemType = _G.StorageManager:GetInstance():CheckSidType(sid)
        local number = self:CheckNum2(ItemType, v.type[3] or v.type[2])

        local addnum = 1
        local num = 0
        if ItemType == _G.StorageType.Card or ItemType == _G.StorageType.Equipment then -- 不堆叠
            while (num < number) do
                num = num + addnum
                table[#table + 1] = {number = addnum, sid = sid, type = 1}
            end
        else
            if sid > 100 then
                addnum = _G.ConfigManager.item_cfg[sid].MaxCount
            else
                addnum = 9999999999999999999
            end

            self:AddItem(table, sid, number, 1, addnum)
        end
    end

    return table
end

function DropTipView:AddItem(table, sid, number, startIndex, maxCount)
    local addnum = 0
    for i = startIndex, #table do
        if sid == table[i].sid and table[i].number < maxCount then
            if table[i].number + number > maxCount then
                table[i].number = maxCount
                addnum = table[i].number + number - maxCount
                if addnum < maxCount then
                    table[#table + 1] = {number = addnum, sid = sid, type = 1}
                    return
                else
                    self:AddItem(table, sid, addnum - maxCount, i, maxCount)
                    return
                end
            else
                table[i].number = table[i].number + number
                return
            end
        end
    end
    table[#table + 1] = {number = number, sid = sid, type = 1}
end

function DropTipView:CheckNum(type, data)
    if data.type and data.sid == nil then
        data = data.type
    end
    local num = 0
    if type == _G.StorageType.Card then
        num = 1
    elseif type == _G.StorageType.Equipment then
        num = 1
    else
        num = data.num or data.number or data[2]
    end

    return num
end

function DropTipView:CheckNum2(type, number)
    local num = 0
    if type == _G.StorageType.Card then
        num = 1
    elseif type == _G.StorageType.Equipment then
        num = 1
    else
        num = number
    end

    return num
end

function DropTipView:CreateItem(data)
    if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
        return
    end
    for i = 1, self.go_table.obj_Item:GetChildCountE() do
        self.go_table.obj_Item:GetChildE(i - 1):DestroyObject()
    end

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.DropViewEffect,
        self.transform,
        function(trans)
            if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
                trans:DestroyObject()
            else
                trans:SetParentE(self.go_table.aorrawimage_BG)
                _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.ItemAwardAppearAuido)
            end
        end,
        function()
        end
    )

    local sid = data.sid

    local ItemLv = ""
    local ItemName = ""
    local TypeName = ""
    local ShowNum = false
    -- if sid > 10000 and sid < 100000 then
    --     return
    -- end

    local ItemType = _G.StorageManager:GetInstance():CheckSidType(sid)
    if ItemType == _G.StorageType.Card then
        _G.CardViewBase.Create(
            {sid = data.sid, number = data.number},
            self.go_table.obj_Item,
            function(go)
                if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
                    go:DestroyObject()
                    return
                end
                go:GetComponentE(typeof(CS.UnityEngine.RectTransform)):SetLocalPosition(0, 0, 0)
                go:ShowNumText(false)
                self.CurItem = go
            end
        )

        ItemLv = _G.ConfigManager.card_cfg[sid].Order
        ItemName = _G.ConfigManager.card_cfg[sid].Name
        if _G.ConfigManager.card_cfg[sid].UnitType == 1 then
            TypeName = ItemTypeStr[3]
        else
            TypeName = ItemTypeStr[4]
        end
    elseif ItemType == _G.StorageType.Equipment then
        _G.EquipViewBase.Create(
            {sid = data.sid, number = data.number},
            self.go_table.obj_Item,
            function(go)
                if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
                    go:DestroyObject()
                    return
                end
                go:GetComponentE(typeof(CS.UnityEngine.RectTransform)):SetLocalPosition(0, 0, 0)
                go:ShowNumText(false)
            end
        )

        ItemLv = _G.ConfigManager.equipment_cfg[sid].grade
        ItemName = _G.ConfigManager.equipment_cfg[sid].name
        TypeName = ItemTypeStr[2]
    else
        local cfg
        if sid > _G.ItemSidJudgeSection.ResPropMax then
            cfg = _G.ConfigManager.item_cfg[sid]
        else
            cfg = _G.ConfigManager.currency_type_cfg[sid]
        end

        require("ItemViewBase").Create(
            {sid = data.sid, number = data.number, cfg = cfg},
            self.go_table.obj_Item,
            function(go)
                if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
                    go.gameObject:DestroyObject()
                    return
                end

                go.gameObject:GetComponentE(typeof(CS.UnityEngine.RectTransform)):SetLocalPosition(0, 0, 0)
                go:ShowNumText(false)
            end
        )

        --ItemLv= _G.ConfigManager.item_cfg[sid].Quality
        if sid < 100 then
            ItemName = _G.ConfigManager.currency_type_cfg[sid].name
            ShowNum = true
        else
            ItemName = _G.ConfigManager.item_cfg[sid].Name
            if _G.ConfigManager.item_cfg[sid].MaxCount > 1 then
                ShowNum = true
            end
        end

        TypeName = ItemTypeStr[1]
    end

    self.go_table.aortext_LV.text = ItemLv
    self.go_table.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(ItemName)
    self.go_table.aortext_ItemType.text = _G.LangUtil.GetLangPackValue(TypeName)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_Number, ShowNum)
    if ShowNum then
        self.go_table.aortext_Number.text = data.number
    end
end

return DropTipView
