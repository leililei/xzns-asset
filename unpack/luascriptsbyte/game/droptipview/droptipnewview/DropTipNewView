---界面的入口函数
function DropTipNewView:OnCreate(datas)
    self.ItemList = {}
    if table.isEmptyOrNil(datas) then
        self:Close()
        return
    end
    self.itemDatas = {}
    if datas.award.item then
        _G.table.insert(self.itemDatas, self:AddItemData(datas.award.item))
    end
    if datas.award.overflow then
        self:AddOverflowData(datas.award.overflow)
    end
    self:Sort(self.itemDatas[1])
    self:InitData()
    if self.itemDatas[1] then
        if #self.itemDatas[1] < count then
            self.go_table.scrollloopvectical_drop:InitItemData(
                #self.itemDatas[1][1],
                _G.handler(self, self.RefreshDropItem)
            )
        else
            self.go_table.scrollloopvectical_drop:InitItemData(count, _G.handler(self, self.RefreshDropItem))
        end
    end
    self:PlayerAni()
end
function DropTipNewView:Sort(table1)
    table.sort(
        table1,
        function(b, a)
            if b.type > a.type then
                return true
            elseif b.type == a.type then
                if b.sid > a.sid then
                    return true
                else
                    return false
                end
            else
                return false
            end
        end
    )
end
function DropTipNewView:InitData()
    local table = {}
    local index = 1
    if #self.itemDatas[1] ~= nil then
        local tempIndex = math.ceil(#self.itemDatas[1] / count)
        if tempIndex > 1 then
            for i = 1, tempIndex do
                table[i] = {}
            end
        end
    else
        return
    end
    if #self.itemDatas[1] > 5 then
        for i = 1, #self.itemDatas[1] do
            if math.ceil(i / count) > index then
                index = index + 1
            end
            _G.table.insert(table[index], self.itemDatas[1][i])
        end
    else
        table[index] = self.itemDatas[1]
    end
    self.itemDatas[1] = table
end
---播放动画
function DropTipNewView:PlayerAni()
    local showTime = 3
    for i = 1, #self.itemDatas[1] do
        _G.DelayDo(
            showTime * (i - 1),
            function()
                for k = 1, #self.ItemList do
                    self.ItemList[k].gameObject:SetActiveE(0)
                end
                if not _G.IsNil(self.gameObject) and self.gameObject:GetctiveInHierarchy() == 1 then
                    _G.coroutine.start(_G.handlerbind(self, self.UpdateItem, self.itemDatas[1][i]))
                end
            end
        )
        if _G.IsNil(self.gameObject) or self.gameObject:GetctiveInHierarchy() == 0 then
            return
        end
    end
    if self.go_table then
        _G.DelayDo(
            showTime * #self.itemDatas[1],
            function()
                _G.table.remove(self.itemDatas, 1)
                if #self.itemDatas <= 0 then
                    self:Close()
                else
                    self:PlayerAni()
                end
            end
        )
    end
end

--更新掉落item数据
function DropTipNewView:UpdateItem(data)
    if data ~= nil then
        for i = 1, #data do
            self:CreateItem(data[i], i)
            _G.coroutine.waitforseconds(0.07)
            self.ItemList[i].gameObject:SetActiveE(1)
            _G.DelayDo(
                1.5,
                function()
                    if self.ItemList then
                        if self.ItemList[i] and self.ItemList[i].anim then
                            self.ItemList[i].anim:Play("a_obj_dropitaem_hide")
                        end
                    end
                end
            )
        end
    end
end

---干掉动态添加的掉落对象
function DropTipNewView:Dispose()
    for k = #self.ItemList, 1, -1 do
        _G.DestroyObject(self.ItemList[k].gameObject)
    end
    self.ItemList = nil
end

--创建循环列表
function DropTipNewView:RefreshDropItem(index, trans)
    local tblIndex = index + 1
    if not self.ItemList[tblIndex] then
        trans:SetName(tblIndex)
        local go_table = _G.GetAutoGoTable(trans)
        self.ItemList[tblIndex] = go_table
        if not self.ItemList[tblIndex].anim then
            self.ItemList[tblIndex].anim =
                self.ItemList[tblIndex].gameObject:GetComponentE((typeof(CS.UnityEngine.Animator)))
        end
    end
    trans:SetActiveE(0)
end
---更新掉落奖励数据
---@param data award.i_award_item
function DropTipNewView:UpdateData(data)
    _G.table.insert(self.itemDatas, self:AddItemData(data))
    if data.award.overflow then
        _G.table.insert(self.itemDatas, self:AddOverflowData(data.award.overflow))
    end
end
function DropTipNewView:AddItemData(datas)
    local table = {}
    for i = 1, #datas do
        local sid = datas[i].sid and datas[i].sid or datas[i].type[1]
        local ItemType = _G.StorageManager:GetInstance():CheckSidType(sid)
        local number = self:CheckNum(ItemType, datas[i])
        local addnum = 1
        local num = 0
        if ItemType == _G.StorageType.Card or ItemType == _G.StorageType.Equipment then -- 不堆叠
            while (num < number) do
                num = num + addnum
                table[#table + 1] = {number = addnum, sid = sid, type = tonumber(ItemType)}
            end
        else
            if sid > 100 then
                addnum = _G.ConfigManager.item_cfg[sid].MaxCount
            else
                addnum = 9999999999999999999
            end
            self:AddItem(table, sid, number, 1, addnum)
        end
    end
    return table
end
function DropTipNewView:AddOverflowData(datas)
    local table = {}
    for k, v in pairs(datas) do
        local sid = v.type[1]
        local ItemType = _G.StorageManager:GetInstance():CheckSidType(sid)
        local number = self:CheckNum2(ItemType, v.type[3] or v.type[2])

        local addnum = 1
        local num = 0
        if ItemType == _G.StorageType.Card or ItemType == _G.StorageType.Equipment then -- 不堆叠
            while (num < number) do
                num = num + addnum
                table[#table + 1] = {number = addnum, sid = sid, type = tonumber(ItemType)}
            end
        else
            if sid > 100 then
                addnum = _G.ConfigManager.item_cfg[sid].MaxCount
            else
                addnum = 9999999999999999999
            end

            self:AddItem(table, sid, number, 1, addnum)
        end
    end
    if #self.itemDatas > 0 then
        if table ~= nil then
            for i = 1, #table do
                _G.table.insert(self.itemDatas[1], table[i])
            end
        end
    else
        if table ~= nil then
            _G.table.insert(self.itemDatas, table)
        end
    end
    --return table
end
function DropTipNewView:AddItem(table, sid, number, startIndex, maxCount)
    local addnum = 0
    for i = startIndex, #table do
        if sid == table[i].sid and table[i].number < maxCount then
            if table[i].number + number > maxCount then
                table[i].number = maxCount
                addnum = table[i].number + number - maxCount
                if addnum < maxCount then
                    table[#table + 1] = {number = addnum, sid = sid, type = 1}
                    return
                else
                    self:AddItem(table, sid, addnum - maxCount, i, maxCount)
                    return
                end
            else
                table[i].number = table[i].number + number
                return
            end
        end
    end
    table[#table + 1] = {number = number, sid = sid, type = 1}
end
function DropTipNewView:CheckNum(type, data)
    if data.type and data.sid == nil then
        data = data.type
    end
    local num = 0
    if type == _G.StorageType.Card then
        num = 1
    elseif type == _G.StorageType.Equipment then
        num = 1
    else
        num = data.num or data.number or data[2]
    end
    return num
end
function DropTipNewView:CheckNum2(type, number)
    local num = 0
    if type == _G.StorageType.Card then
        num = 1
    elseif type == _G.StorageType.Equipment then
        num = 1
    else
        num = number
    end
    return num
end
--创建单个掉落物品的item以及特效
function DropTipNewView:CreateItem(data, index)
    local tb, icon
    local tblIndex = index
    if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
        return
    end
    for i = 1, self.ItemList[tblIndex].obj_Item:GetChildCountE() do
        _G.PoolsManager:GetInstance():Despawn(self.ItemList[tblIndex].obj_Item:GetChildE(0), _G.ePoolType.UIItem)
    end
    local sid = data.sid
    local ItemLv = ""
    local ItemName = ""
    local ShowNum = true
    -- if sid > 10000 and sid < 100000 then
    --     return
    -- end

    local ItemType = _G.StorageManager:GetInstance():CheckSidType(sid)
    if ItemType == _G.StorageType.Card then
        ItemLv = _G.ConfigManager.card_cfg[sid].Order
        ItemName = _G.ConfigManager.card_cfg[sid].Name
        icon = _G.ConfigManager.card_cfg[sid].Icon
    elseif ItemType == _G.StorageType.Equipment then
        ItemLv = _G.ConfigManager.equipment_cfg[sid].grade
        ItemName = _G.ConfigManager.equipment_cfg[sid].name
        icon = _G.ConfigManager.equipment_cfg[sid].icon
    else
        if sid < 100 then
            ItemName = _G.ConfigManager.currency_type_cfg[sid].name
            ItemLv = _G.ConfigManager.currency_type_cfg[sid].Quality
            icon = _G.ConfigManager.currency_type_cfg[sid].icon
            ShowNum = true
        else
            ItemName = _G.ConfigManager.item_cfg[sid].Name
            ItemLv = _G.ConfigManager.item_cfg[sid].Quality
            icon = _G.ConfigManager.item_cfg[sid].Icon
            if _G.ConfigManager.item_cfg[sid].MaxCount > 1 then
                ShowNum = true
            end
        end
    end

    _G.PoolsManager:GetInstance():Spawn(
        DropItem,
        _G.ePoolType.UIItem,
        self.ItemList[tblIndex].obj_Item,
        function(go)
            if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
                go:DestroyObject()
                return
            end
            tb = _G.GetAutoGoTable(go)
            tb.aorimage_GradeBG.SpriteName = BGDi[ItemLv]
            tb.aorimage_Grade.SpriteName = BGkuang[ItemLv]
            tb.aorrawimage_Icon:LoadImage(icon)
        end
    )
    local effname
    if ItemLv == 3 then
        effname = _G.ConfigManager.ui_effect_cfg.ef_daoju_purple
    elseif ItemLv == 4 then
        effname = _G.ConfigManager.ui_effect_cfg.ef_daoju_orange
    elseif ItemLv == 5 then
        effname = _G.ConfigManager.ui_effect_cfg.ef_daoju_red
    else
        effname = nil
    end
    if effname ~= nil then
        _G.UIUtils.LoadEffectByCfg(
            effname,
            self.transform,
            function(trans)
                if _G.IsNil(self.gameObject) or 0 == self.gameObject:GetctiveInHierarchy() then
                    trans:DestroyObject()
                else
                    trans:SetParentE(self.ItemList[tblIndex].obj_Item)
                    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.ItemAwardAppearAuido)
                end
            end,
            function()
            end
        )
    end

    local ShowNum = data.number > 1 and string.format(" x%s", tostring(data.number)) or ""
    self.ItemList[tblIndex].aortext_Cfg.text = _G.LangUtil.GetLangPackValue(ItemName) .. ShowNum
    self.ItemList[tblIndex].aortext_Cfg.color = textColor[ItemLv]
end

return DropTipNewView
