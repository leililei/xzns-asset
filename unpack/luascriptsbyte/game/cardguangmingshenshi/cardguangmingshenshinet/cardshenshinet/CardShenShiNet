require "BaseGameNet"

---@class CardShenShiNet : BaseGameNet	通信协议
local CardShenShiNet = _G.BaseClass("CardShenShiNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return CardShenShiNet CardShenShiNet
function CardShenShiNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function CardShenShiNet:AccessShenshiInfo(callback)
    local item = _G.ConfigManager.net_map.game_card_port_get_stone
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.ReceiveShenShiData))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CardShenShiNet:ReceiveShenShiData(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

