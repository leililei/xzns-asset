---设施 格子
---@param index int 该数据的索引   0起始
function CardGuangMingShenShi:RefreshRenItem(index, obj)
    if index < 0 then
        return
    end
    local gridindex = index + 1
    obj:SetName(gridindex)
    local grid = self:GetComponent(obj, item_card_grid)
    local gridData = self.stone_model:GetOneGrid(gridindex)
    if grid == nil then
        grid = self:AddComponent(obj, item_card_grid.New(obj, gridData, gridindex))
        self.kacao_go[gridindex] = {}
    else
        grid:HideItemGrid()
        grid:initGridData(gridData, gridindex)
    end
    self.kacao_go[gridindex] = grid
    if gridindex <= 5 then
        self.cardtrans_uieffect[gridindex] = obj
    end
    return obj
end

