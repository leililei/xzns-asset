function CardGuangMingShenShi:DisposHexinUI()
    local count = self.headGridLists.gameObject:GetChildCountE()
    for i = 1, count do
        local node = self.headGridLists.gameObject:GetChildE(i - 1)
        if node:GetChildCountE() > 0 then
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
end

---设置神石核心头像(1-3 是人卡 头像，4-6 是灵卡头像)
function CardGuangMingShenShi:SetShenshiHexinHeadUI()
    local count = self.headGridLists.gameObject:GetChildCountE()
    local core_uid = self.stone_model:GetAllCore()
    _G.table.sort(
        core_uid,
        function(a, b)
            if a:GetCarduid() > 0 and b:GetCarduid() > 0 then
                local acard = a:GetCard()
                local bcard = b:GetCard()
                if acard:GetLevel() > bcard:GetLevel() then
                    return true
                elseif acard:GetLevel() == bcard:GetLevel() and acard.cfg.Order > bcard.cfg.Order then
                    return true
                end
            else
                return a:GetCarduid() > 0
            end
        end
    )
    for i = 1, count do
        _G.PoolsManager:GetInstance():Spawn(
            grid_itemPath,
            _G.ePoolType.UIItem,
            self.headGridLists.gameObject:GetChildE(i - 1),
            function(trans)
                local tb = _G.GetAutoGoTable(trans)
                local grid = core_uid[i]
                local count = tb.trans_headPanel:GetChildCountE()
                if count > 0 then
                    _G.DestroyObject(tb.trans_headPanel:GetChildE(0))
                end
                if grid:GetCarduid() ~= 0 then
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.baseBodyItem,
                        tb.trans_headPanel,
                        function(item)
                            _G.GameUtil.SetActiveByCondition(tb.trans_headPanel, true)
                            local card =
                                _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, grid:GetCarduid())
                            local _, skinIs = require "CardCommentManager":GetInstance():CardWearSkin(card.sid)
                            if skinIs ~= 0 then
                                card.skinIs = skinIs
                            end
                            item:ShowCardData(card, nil, true)
                            item.gameObject:SetLocalScale(1, 1, 1)
                        end
                    )
                end
                _G.GameUtil.SetActiveByCondition(tb.trans_redpointKacao, false)
            end
        )
    end
end

