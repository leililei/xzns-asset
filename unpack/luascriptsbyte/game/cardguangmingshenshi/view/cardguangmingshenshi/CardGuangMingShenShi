--解锁特效
function CardGuangMingShenShi:CoOnProgress()
    _G.GameUtil.SetActiveByCondition(self.upLevel_Panel.obj_consume, false)
    self.isSec = true
    local effectName = uieffect.unlockSecend
    local cfg = _G.ConfigManager.ui_effect_cfg[effectName]
    _G.UIUtils.LoadEffectByCfg(
        cfg,
        self.go_table.obj_effect,
        function(trans)
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Mask, true)
        end,
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Mask, false)
            --播放中心爆炸特效
            --self:UpdateUnLockStoneState()
        end
    )
    _G.coroutine.waitforseconds(3.2)
    --_G.coroutine.waitforseconds(0.2)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_unlock_level, false)
    _G.GameUtil.SetActiveByCondition(self.shenshiHead_panel.gameObject, false)
    _G.GameUtil.SetActiveByCondition(self.upLevel_Panel.gameObject, true)
    for i = 1, 5 do
        effectName = uieffect.guangshu
        local cfg2 = _G.ConfigManager.ui_effect_cfg[effectName]
        _G.coroutine.waitforseconds(0.08)
        _G.UIUtils.LoadEffectByCfg(
            cfg2,
            self.go_table.obj_effect_baozha,
            function(go)
                local rationz = guanshuEffe[i].rationz
                local scalex = guanshuEffe[i].scalex
                go.transform:SetLocalScale(scalex, scalex, scalex)
                go.transform:SetLocalEulerAngles(0, 0, rationz)
            end,
            function()
                --self:UpdateUnLockStoneState()
            end
        )
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Mask, false)
        --播放卡牌显示的特效
        local effectName1 = uieffect.jisuokapai
        local cfg3 = _G.ConfigManager.ui_effect_cfg[effectName1]
        _G.UIUtils.LoadEffectByCfg(
            cfg3,
            self.go_table.obj_uieffcet_card,
            function(go)
                local x, y, z = self.cardtrans_uieffect[i]:GetPosition()
                go.transform:SetLocalScale(100, 100, 100)
                go.transform:SetPosition(x, y, z)
            end,
            function(tran)
            end
        )
    end
    --光束特效
    self:ShowShenshiHexinOrUpLevelPanel()
    ---神石二阶段 刷新下 槽位的红点
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.Cardconmonlevelroom.id
    )
    --删除携程
    if self.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(self.WiatCoroutine)
        self.WiatCoroutine = nil
    end
end

