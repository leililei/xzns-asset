---刷新 神石 背包的数据
function CardGuangMingShenShi:UpdataShenshiBagData()
    self:RefreshBagNumber()
    local num = 0
    if self.stone_model:GetStoneEnum() == _G.StoneEnum.secend then
        num = num + hexin_num
    end
    local maxGridNumber = self.stone_model.show_grid_number + num
    if not _G.IsNil(self.mlistView2) then
        if maxGridNumber ~= self.now_cor_num then
            self.go_table.scrollloopvectical_kacaoListe:UpdateCount(maxGridNumber)
            self.now_cor_num = maxGridNumber
        else
            self.go_table.scrollloopvectical_kacaoListe:UpdateAllItem()
        end
    end
end

