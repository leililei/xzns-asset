--初始化
function CardGuangMingShenShi:onDown_Uplv()
    self.DownClickTime = 0
    self.jishi = 0
    self.numberlevel = 0

    --跳出 提示 框
    self.tipsjishi = 0
end

--计算时间
function CardGuangMingShenShi:onLongPressS_Uplv()
    self.DownClickTime = self.DownClickTime + 1
    if self.DownClickTime > self.DownClickLimit then
        --检测等级 not self.shenshi_Ctroller:CheckLevelMax(self.numberlevel)
        if (self.stone_model.stone_level + self.numberlevel) >= self.stone_model.shenLevel_Limit then
            self.tipsjishi = self.tipsjishi + 0.1
            if self.tipsjishi > 5 then
                _G.PopWindowManager:GetInstance():ShowAllTips(190104)
                self.tipsjishi = 0
                return
            end
            return
        end
        --检测材料
        local tab = self.shenshi_Ctroller:CheckUpLevelCaiLiaoManzu()
        if not _G.table.isEmptyOrNil(tab) then
            self.tipsjishi = self.tipsjishi + 0.1
            if self.tipsjishi > 5 then
                _G.FloatTipsModel:GetInstance():Show("缺少材料，不要在长按按钮")
                self.tipsjishi = 0
                self.shenshi_Ctroller:JianConsumeItem(
                    self.stone_model.stone_level + self.numberlevel,
                    self.stone_model.stone_level + self.numberlevel + 1,
                    false
                )
                self:SetCaiLiaoUI()
                return
            end
            return
        end
        self.jishi = self.jishi + 0.1
        if self.jishi > self.DownTimeClickTimeLimit then
            --self.stone_model:GetCaiLiaoXiaoHaoLimit(self.stone_model.stone_level + self.numberlevel)
            self.numberlevel = self.numberlevel + 1
            self.shenshi_Ctroller:JianConsumeItem(
                self.stone_model.stone_level + self.numberlevel,
                self.stone_model.stone_level + self.numberlevel + 1,
                true
            )
            self:SetCaiLiaoUI()
            self.jishi = 0
            -- self.go_table.aortext_level.text =
            --     _G.LangUtil.GetLangPackValue(90020600039, self.stone_model.stone_level + self.numberlevel)
            self.go_table.aortext_level.text =
                _G.LangUtil.GetLangPackValue(90020600039, self.stone_model.stone_level) ..
                "/" .. _G.LangUtil.GetLangPackValue(90020600039, self.stone_model.shenLevel_Limit)
        end
    end
end

function CardGuangMingShenShi:onUp_Uplv()
    local level = 1
    if self.DownClickTime > self.DownClickLimit then
        level = self.numberlevel
    else
        level = 1
    end
    if (self.stone_model.stone_level + self.numberlevel) >= self.stone_model.shenLevel_Limit then
        level = (self.stone_model.shenLevel_Limit - self.stone_model.stone_level)
        _G.PopWindowManager:GetInstance():ShowAllTips(190104)
    else
        --self:ShowButtonSJorCommon()
    end
    self.shenshi_Ctroller:ShenShiUpLevel(level)
end

---获取材料界面
function CardGuangMingShenShi:CommonBtnOnClick()
    ---tab表中的顺序就是突破石、经验、钱，如果不缺就不会插入到tab表里
    local tab = self.shenshi_Ctroller:CheckUpLevelCaiLiaoManzu(self.stone_model.stone_level)
    if _G.IsNil(tab) then
        return
    end
    local id
    ---按顺序突破石，经验，钱弹快捷使用,不要连着弹。
    for i = 1, #tab do
        id = tab[i].id
        local isViewOpened = _G.StorageManager:GetInstance():FastCheckItem(id, nil, self.viewName)
        if (isViewOpened) then
            return
        end
    end
    ---如果走到这里，说明没有一个快捷使用打开，说明道具不足,弹获取窗口(也是按顺序)
    id = tab[1].id
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, id)
end

