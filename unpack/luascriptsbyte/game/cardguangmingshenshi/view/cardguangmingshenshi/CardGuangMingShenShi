    if self.stone_model:GetStoneEnum() == _G.StoneEnum.secend then
        ---设置升级需要用到的材料
        self:ShowButtonSJorCommon()
        _G.GameUtil.SetActiveByCondition(self.upLevel_Panel.gameObject, true)
        _G.GameUtil.SetActiveByCondition(self.shenshiHead_panel.gameObject, false)
        self:SetCaiLiaoUI()
        ---设置共鸣神石等级 ui
        self:UpdataShenshiBagData()
    else
        _G.GameUtil.SetActiveByCondition(self.upLevel_Panel.gameObject, false)
        _G.GameUtil.SetActiveByCondition(self.shenshiHead_panel.gameObject, true)
        self:SetShenshiHexinHeadUI()
    end
    if self.stone_model.StoneEnum == _G.StoneEnum.secend then
        self.go_table.aortext_level.text =
            _G.LangUtil.GetLangPackValue(90020600039, self.stone_model.stone_level) ..
            "/" .. _G.LangUtil.GetLangPackValue(90020600039, self.stone_model.shenLevel_Limit)
    else
        self.go_table.aortext_level.text = _G.LangUtil.GetLangPackValue(90020600039, self.stone_model.stone_level)
    end
end

---设置 升级材料的 ui   ---card_level_cfg 配置
---@param coin number 金币
---@param jingyan number 经验
---@param item number 物品
function CardGuangMingShenShi:SetCaiLiaoUI()
    if self.mMaterial == nil then
        self.mMterial = {}
        self.mMterial[1] = self.upLevel_Panel.obj_Material_1
        self.mMterial[2] = self.upLevel_Panel.obj_Material_2
        self.mMterial[3] = self.upLevel_Panel.obj_Material_3
    end
    --材料显示
    local subList = {}
    if self.stone_model.materialLimt == 0 then
    else
        table.insert(
            subList,
            { self.stone_model.materialId, self.stone_model.materialLimt, self.stone_model.materialCount }
        )
    end
    table.insert(subList, { _G.ResPropID.CardExp, self.stone_model.expLimit, self.stone_model.expCount })
    table.insert(subList, { _G.ResPropID.Coin, self.stone_model.coinLimit, self.stone_model.coinCount })

    for i = 1, 3 do
        if _G.table.isEmptyOrNil(subList[i]) then
            _G.GameUtil.SetActiveByCondition(self.mMterial[i], false)
        else
            _G.GameUtil.SetActiveByCondition(self.mMterial[i], true)
            local tb = _G.GetAutoGoTable(self.mMterial[i])
            self:SetStoneMaterial(tb, subList[i])
        end
    end
end

---设置神石第二阶段
---@param tb table 预制体
---@param data table sid,数量限制，当前数量
function CardGuangMingShenShi:SetStoneMaterial(tb, data)
    local ConsumeCount = _G.GameUtil.NumberToUnitStr(data[2])
    local haveCount = data[3]
    if haveCount >= data[2] then
        haveCount = _G.GameUtil.NumberToUnitStr(haveCount)
        tb.aortext_Des.text = haveCount .. "/" .. ConsumeCount
    else
        haveCount = _G.GameUtil.NumberToUnitStr(haveCount)
        tb.aortext_Des.text = "<color=#ff5656>" .. haveCount .. "</color>" .. "/" .. ConsumeCount
    end
    local icon = _G.StorageManager:GetInstance():GetItemIcon(data[1])
    if not icon then
        tb.aorrawimage_Icon:SetActiveE(0)
    else
        tb.aorrawimage_Icon:SetActiveE(0)
        tb.aorrawimage_Icon:LoadImage(
            icon,
            function()
                tb.aorrawimage_Icon:SetActiveE(1)
                self.upLevel_Panel.obj_consume:SetActiveE(1)
            end
        )
    end
end

