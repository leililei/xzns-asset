---筛选
function GongMing_SwitchCardView:OnToggle_sx_Elements(go, isOn)
    if isOn == false then
        return
    end
    local name = go:GetName()
    local mSplit = string.split(name, " (")
    local now = tonumber(mSplit[2]) or 0
    -- 用来切换到原来的 toggle 组件
    self.tempindex = self.sx_Elements.Index
    self.sx_Elements.TempIndex = now
    self.sx_Elements.Index = self.sx_Elements.TempIndex
    self.sx_Elements.data = self.sxEnum.Elements[self.sx_Elements.Index]
    self.nowCardIndex = 1
    self:UpdataLoopList()
    self:RefreshAllItem()
    --self:SelectHead()
end

function GongMing_SwitchCardView:UpdataLoopList()
    self:SelectWuxing()
    self:StarSort()
end

function GongMing_SwitchCardView:GetUidtoCard(uid)
    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    return cardData
end

--选择卡牌  五行（1-雷；2-风；3-水；4-火；5-土）
function GongMing_SwitchCardView:SelectWuxing()
    local items = self.all_cards
    self.CardData = {}
    self.CardData = self.all_cards[1]
    if self.sx_Elements.data == 0 then
        self.StorageCard = self.all_cards
        return
    end
    self.StorageCard = {}
    for i = 1, #items do
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(items[i].cfg.Elements_new, self.sx_Elements.data) then
            table.insert(self.StorageCard, items[i])
        end
    end
    if _G.table.isEmptyOrNil(self.StorageCard) then
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
        self.go_sx_Elements["toggle_1 (" .. tostring(self.tempindex)].isOn = true
        return
    end
    self.CardData = self.StorageCard[1]
end

--排序
function GongMing_SwitchCardView:StarSort()
    _G.SortList(
        self.StorageCard,
        function(item)
            ---self.sortEnum  取排序字段
            local index = (self.old_Sort + 0) % 3
            if index == 0 then
                index = 3
            end
            local sort1 = item[self.sortEnum[index]] or 0
            index = (self.old_Sort + 1) % 3
            if index == 0 then
                index = 3
            end
            local sort2 = item[self.sortEnum[index]] or 0
            index = (self.old_Sort + 2) % 3
            if index == 0 then
                index = 3
            end
            local sort3 = item[self.sortEnum[index]] or 0
            local sort4 = item.sid
            local sort5 = item.uid

            return sort1, sort2, sort3, sort4, sort5
        end
    )
end

---刷新
function GongMing_SwitchCardView:RefreshAllItem()
    self.cardLists = self.StorageCard
    local sumCount = #self.cardLists
    if self.mlistView2 == nil then
        self.go_table.scrollloopvectical_kapai:InitItemData(sumCount, _G.handler(self, self.RefreshList))
        self.mlistView2 = self.go_table.scrollloopvectical_kapai
    else
        self.go_table.scrollloopvectical_kapai:UpdateCount(sumCount)
    end
end

function GongMing_SwitchCardView:InitFun(itemGoTable)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.BodyItem_select,
        itemGoTable.obj_node,
        function(itemLua)
            itemGoTable.Lua = itemLua
            self:SetCardItem(itemGoTable)
        end
    )
end

function GongMing_SwitchCardView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local itemGoTable = _G.GetAutoGoTable(objGame)
    itemGoTable.CardIndex = index + 1
    ---没生成对象
    if itemGoTable.Lua == nil then
        ---开始生成对象 并标记
        itemGoTable.Lua = true

        if self.Params_LoopInit == false then
            if self.Params_LoopTimers == nil then
                self.Params_LoopTimers = {}
            end
            local timer =
                _G.TimerManager:GetInstance():GetTimer(0.5 * index, self.InitFun, self, true, true, true, itemGoTable)
            table.insert(self.Params_LoopTimers, timer)
            timer:Start()
        else
            self:InitFun(itemGoTable)
        end
    elseif itemGoTable.Lua ~= true then
        ---已生成对象
        self:SetCardItem(itemGoTable)
    end
    return objGame
end

function GongMing_SwitchCardView:SetCardItem(itemGoTable)
    if itemGoTable == nil or self:IsNil() then
        return
    end
    ---@type CardData
    local carddata = self.cardLists[itemGoTable.CardIndex]
    ---@type ItemCardBodySelectView
    local lua = itemGoTable.Lua
    itemGoTable.gameObject:SetName(carddata.uid)
    itemGoTable.gameObject:SetLocalScale(0.9, 0.9, 0.9)
    local _, skinIs = require "CardCommentManager":GetInstance():CardWearSkin(carddata.sid)
    if skinIs ~= 0 then
        carddata.skinIs = skinIs
    end
    --直接从池子 中取出
    lua:ShowCardData(carddata, _G.handlerbind(self, self.OnCardBodyClick_bg, itemGoTable), true)
    lua:SetSelectGou(self.nowCardIndex == itemGoTable.CardIndex)
end

function GongMing_SwitchCardView:OnCardBodyClick_bg(_, itemGoTable)
    local CardIndex = itemGoTable.CardIndex
    if CardIndex == nil or CardIndex == self.nowCardIndex then
        return
    end
    self.CardData = self.cardLists[CardIndex]
    self.nowCardIndex = CardIndex
    self.go_table.scrollloopvectical_kapai:UpdateAllItem()
end

return GongMing_SwitchCardView
