---按钮点击事件在这里派发
function GongMing_SwitchCardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    -- _G.AudioManager.PlayAudioByAudioCfgID(2049)
end

function GongMing_SwitchCardView:OnDestroy()
    self.all_cards = nil
    self.gridIndex = nil
    if self.Params_LoopTimers then
        for i = 1, #self.Params_LoopTimers do
            self.Params_LoopTimers[i]:Stop()
        end
        self.Params_LoopTimers = nil
    end
end

