function GongMing_SwitchCardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemObjDic = {}
    self.isInit = false
    self.sxEnum = {
        ---[toggle顺序]=配置表对应值
        Elements = {
            [1] = 0,
            [2] = 6,
            [3] = 2,
            [4] = 1,
            [5] = 3,
            [6] = 4,
            [7] = 5
        }
    }
    self.sortEnum = {
        [1] = "lv",
        [2] = "star",
        [3] = "Grade"
    }
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["@_aorbtn_closeview"] = self.CloseView,
        ["@_aorbtn_queding"] = self.QueDingBtnOnClick,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go.name .. "</color>")
            end
        end
    }
    self.sx_Elements = {
        ---初始化显示当前的筛选
        Index = 1,
        ---筛选界面的临时选中筛选
        TempIndex = 1,
        data = self.sxEnum.Elements[1]
    }
    self.go_sx_Elements = _G.GetAutoGoTable(self.go_table.obj_Elements, _G.handler(self, self.OnToggle_sx_Elements))
    self.mItemCountPerRow = 6
    self.old_Sort = 1
    self.CardData = {}
end

---界面的入口函数
function GongMing_SwitchCardView:OnCreate(Data)
    self:AddRest()
    self.Params_LoopInit = false
    self.mlistView2 = nil
    --当前卡数据 所在表索引 1->
    self.nowCardIndex = 1
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
    self:IniDataShenshiSwitchHead(Data)
    self.go_sx_Elements["toggle_1 (" .. tostring(self.sx_Elements.Index)].isOn = true
    self:UpdataLoopList()
    self:RefreshAllItem()
    self.Params_LoopInit = true
end

