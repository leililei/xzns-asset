---@class item_card_grid : Component	中文描述
local item_card_grid = _G.BaseClass("item_card_grid", _G.Component)

--puttype,type,indexPos,cardData
---创建对象时,入口构造函数
---@param gridindex number 界面点击 格子位置的下标
function item_card_grid:OnCreate(trans, gridData, gridindex)
    self:SetCommont(trans)
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_tianjia"] = self.AddCardBtnOnClicek,
        ["@_aorbtn_suo"] = self.SuoBtnOnClicek,
        ["@_aorbtn_timer"] = self.ClearCd,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.LoadingItem = false
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn1))
    self:initGridData(gridData, gridindex)
end

---销毁对象时,析构函数
---@param onclickindex number 界面点击 格子的下标
function item_card_grid:initGridData(gridData, onclickindex)
    self.grid = gridData
    if self.timer ~= nil then
        self.timer:Stop()
    end
    if _G.table.isEmptyOrNil(gridData) then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    ---摆放核心位置
    self.curIndex = onclickindex --self.grid:GetGridIndex()
    self.cdLimit = self.grid:GetLastTime()
    self.type = self.grid:GetGridDataEnum()
    ---有卡牌
    if self.type == _G.GridDataEnum.head then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_headPanel, true)
        -- local count = self.go_table.trans_headPanel:GetChildCountE()
        -- if count > 0 then
        --     for i = 1, count do
        --         local tran = self.go_table.trans_headPanel:GetChildE(count - i)
        --         if tran then
        --             _G.DestroyObject(tran)
        --         end
        --     end

        -- --_G.PoolsManager:GetInstance():Despawn(self.go_table.trans_headPanel:GetChildE(0), _G.ePoolType.UIItem)
        -- end

        if self.CurItem then
            self:showItemHeadInfo(self.CurItem)
        else
            if not self.LoadingItem then
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.BodyItem_select,
                    self.go_table.trans_headPanel,
                    _G.handler(self, self.showItemHeadInfo)
                )
                self.LoadingItem = true
            end
        end
    elseif self.type == _G.GridDataEnum.unlock then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_suo, true)
    elseif self.type == _G.GridDataEnum.add then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_tianjia, true)
    else
        self.cd = 0
        if self.grid:GetLastTime() then
            self.cd = _G.TimeUtil.GetServerUnixTime() - self.grid:GetLastTime()
            self.cd = self.grid:GetCd() - self.cd
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_timer, true)
        --self.cooling_timer_UI.text = "冷却中\n"..ti
        self:coolingUI(self.cd)
        if self.cd <= 0 then
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_timer, false)
            self.type = _G.GridDataEnum.add
            self.grid:SetGridDataEnum(_G.GridDataEnum.add)
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_tianjia, true)
            _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.CleadCd_client, self.grid)
        else
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.ResCloolingUI, self, false, false, false)
            self.timer:Start()
        end
    end
    --设置红点
    self.go_table.trans_redpointKacao:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.Cardconmonlevelroom.id,
        self.grid:GetGridIndex()
    )
end

---计时 --刷新 冷却时间
function item_card_grid:ResCloolingUI(second)
    self.cd = self.cd - second
    if self.cd <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_timer, false)
        self.type = _G.GridDataEnum.add
        self.grid:SetGridDataEnum(_G.GridDataEnum.add)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_tianjia, true)
        _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.CleadCd_client, self.grid)
        self.timer:Stop()
    end
    self:coolingUI(self.cd)
end

---销毁对象时,析构函数
function item_card_grid:OnDestroy()
    self.type = nil
    self.curIndex = nil
    if self.time ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

-----------------------------------------------------------------

---设置组件信息
---@param index number 点击的位置
function item_card_grid:SetCommont(trans)
    self.gameObject = trans.gameObject
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(trans)
end

function item_card_grid:OnClickBtn1(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    --_G.AudioManager.PlayAudioByAudioCfgID(2049)
end

function item_card_grid:HideItemGrid()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_timer, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_tianjia, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_suo, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_headPanel, false)
    -- local count = self.go_table.trans_headPanel:GetChildCountE()
    -- if count > 0 then
    --     for i = 1, count do
    --         local tran = self.go_table.trans_headPanel:GetChildE(count - i)
    --         if tran then
    --             _G.DestroyObject(tran)
    --         end
    --     end
    -- --_G.PoolsManager:GetInstance():Despawn(self.go_table.trans_headPanel:GetChildE(0), _G.ePoolType.UIItem)
    -- end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_LvLimit, false)
end

function item_card_grid:showItemHeadInfo(item)
    self.LoadingItem = false
    self.CurItem = item
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_headPanel, true)
    local data = self.grid:GetCard()

    item:ShowCardData(data, _G.handler(self, self.CardHeadOnClick), true)
    item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
    self:UpdataLimitlevelUi(data)
end

-----卡槽有卡牌  点击事件
function item_card_grid:CardHeadOnClick()
    _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.DownCard, self.curIndex)
end

--设置button点击事件 神石 背包 添加一个对象
function item_card_grid:AddCardBtnOnClicek()
    --弹出 头像列表
    _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.AddCardShenShi, self.curIndex, self.go_table)
end

--解锁
function item_card_grid:SuoBtnOnClicek()
    _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.UnlockShenshiGrid, self.curIndex, self.go_table.gameObject)
end

---清楚冷却时间 消耗材料
function item_card_grid:ClearCd()
    _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.ClearCd, self.curIndex)
end

function item_card_grid:OnDispose()
    self.gameObject:DestroyObject()
end

--region 辅助方法
---冷却时间 ui ---
function item_card_grid:coolingUI(time)
    local ti = _G.TimeUtil.TimeToString(math.ceil(time), 1)
    if self.go_table.gameObject:GetActiveSelf() == 0 then
        return
    end
    self.go_table.aortext_timer.text = _G.LangUtil.GetLangPackValue(90020600063, ti)
end

--endregion

--region UI
---等级上限 ui
function item_card_grid:UpdataLimitlevelUi(data)
    if self.grid:GetIslevelLimit() then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_LvLimit, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_LvLimit, false)
    end
end

--endregion

return item_card_grid
