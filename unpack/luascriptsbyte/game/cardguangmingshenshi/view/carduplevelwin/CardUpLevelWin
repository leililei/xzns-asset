---@class CardUpLevelWin : UIBaseView	中文描述
---@field public go_table CardUpLevelWin_GoTable GoTable
local CardUpLevelWin = _G.BaseClass("CardUpLevelWin", _G.UIBaseView)
--_G.CardUpLevelWin = CardUpLevelWin

local CS = _G.CS
local typeof = _G.typeof

function CardUpLevelWin:Awake()
    _G.AudioManager.PlayAudioByAudioCfgID(2045)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_shenshiupWinclose"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go.name .. "</color>")
            end
        end
    }
end

---界面的入口函数
function CardUpLevelWin:OnCreate(Data)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
    self.carddata = Data
    self.oldlv = Data.lv_Old
    self.shenshiLv = Data:GetLevel()
    self:UpdataLevel()
    self:SetHead()
end
---资源加载
function CardUpLevelWin:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function CardUpLevelWin:SetData(Data)
end

function CardUpLevelWin:CloseView()
    self:Close()
end

function CardUpLevelWin:OnDestroy()
    self.carddata = nil
    self.oldlv = nil
    self.shenshiLv = nil
end

---按钮点击事件在这里派发
function CardUpLevelWin:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    --_G.AudioManager.PlayAudioByAudioCfgID(2049)
end
--------------------------------设置头像---------------------------------
function CardUpLevelWin:SetHead()
    local head = self.go_table.trans_head
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.ItemCardStorageView,
        head.transform,
        _G.handler(self, self.showHeadInfo)
    )
end
function CardUpLevelWin:showHeadInfo(item)
    item.gameObject:SetLocalPosition(0, 0, 0)
    item:Show(self.carddata.sid, nil, self.carddata.star, self.carddata.soulLink_lv, self.carddata.lv, nil, true, self.carddata.soulLink_IsActivate, self.carddata.open_inborn)
end
--------------------------------更新---方法- -----------------------------
function CardUpLevelWin:UpdataLevel()
    local currLevel = self.go_table.aortext_upLv
    self.go_table.aortext_oldLv.text = _G.LangUtil.GetLangPackValue(90000010036, self.oldlv)
    currLevel.text = self.shenshiLv
end

function CardUpLevelWin:EscClose()
    self:CloseView()
end

return CardUpLevelWin
