local CS = _G.CS
local typeof = _G.typeof
local itemCardBaseViwePath = "UIH5/Common/ItemView/ItemCardBaseView"
function CardDownGridItemView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["@_aorbtn_closeview"] = self.CloseView,
        ["@_aorbtn_cancel"] = self.CancelOnClicktBtn,
        ["@_aorbtn_queding"] = self.QueDingOnClicktBtn,
        ["$_toggle_DownEquipAutoBtn"] = self.AutoEquipToggleOnClicktBtn,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go.name .. "</color>")
            end
        end
    }
end

---界面的入口函数
function CardDownGridItemView:OnCreate(Data)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
    self.index = Data.index
    self.card_uid = Data.uid
    self.cradData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.card_uid)
    self.oldLv = self.cradData.lv_Old
    self.curLv = self.cradData:GetLevel()
    self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90020600054, "1: 00: 00")
    --点击
    self.AutoTuoZhuanbei = 2
    self:LevelUpdate()
    self:SetHead()
end
