---设置头像框
function CardDownGridItemView:SetHead()
    local headTrans = self.go_table.trans_head
    local count = headTrans.gameObject:GetChildCountE()
    for i = 1, count do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            headTrans.transform:GetChildE(i - 1),
            _G.handlerbind(self, self.showItemBaseHeadInfo, i)
        )
    end
end

function CardDownGridItemView:showItemBaseHeadInfo(item, num)
    local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.card_uid)
    local gameObj = _G.GetAutoGoTable(item.gameObject)
    item:ShowCardData(data, nil, true)
    if num == 2 then
        item:ShowCardLevel(true, self.oldLv)
    end
    --item:HideOrShowLevel(false)
end
--自动脱下饰品
function CardDownGridItemView:UnfixDecoration(call)
    self.decoration = {}
    if self.cradData:GetDecorationCount() == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("无饰品 穿戴")
        end
        if call then
            call()
            return
        end
    end
    local DecorationBar = self.cradData.DecorationBar
    for i = 1, #DecorationBar do
        if not _G.table.isEmptyOrNil(DecorationBar[i]) then
            _G.table.insert(self.decoration, {DecorationBar[i].sid, DecorationBar[i].uid})
        end
    end
    require("DecorationModel"):GetInstance():UnfixDecoration({self.cradData.uid}, call)
end
---脱装备 是否 有装备
function CardDownGridItemView:AutoDownEquipBar()
    local index = {}
    for _, v in pairs(_G.EquipmentPart) do
        if not table.isEmptyOrNil(self.cradData.EquipBar[v]) then
            table.insert(index, v)
        end
    end

    if table.isEmptyOrNil(index) then
        --检测是否穿戴了饰品
        self:UnfixDecoration(
            function()
                local mainCards = {}
                --饰品
                for key, value in pairs(self.decoration) do
                    local award1 = {value[1], value[2]}
                    table.insert(mainCards, {type = award1})
                end
                if _G.table.isEmptyOrNil(mainCards) then
                    _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.DownCardOne, self.index)
                    self:CloseView()
                    return
                end
                local data = {}
                data.award = {item = {}}

                table.insertto(data.award.item, mainCards, 1)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.DownCardOne, self.index)
                self:CloseView()
            end
        )
        return
    end
    ---@type EquipmentItem[]
    local equipBar = self.cradData.EquipBar
    self.equip_sids = {}
    for i = 1, #equipBar do
        if not _G.table.isEmptyOrNil(equipBar[i]) then
            _G.table.insert(self.equip_sids, {equipBar[i].sid, equipBar[i].uid})
        end
    end
    local msg = {}
    msg.uid = self.cradData.uid
    msg.indexs = index
    require "EquipmentModel":GetInstance():UnfixEquip(msg.uid, msg.indexs, _G.handlerbind(self, self.UnfixEquipShenShi))
    --require("EquipmentNet"):GetInstance():EquipmentTake(msg, _G.handlerbind(self, self.UnfixEquipShenShi, equipBar))
end

---脱下装备返回
function CardDownGridItemView:UnfixEquipShenShi()
    --检测是否拥有饰品(卸下饰品)
    self:UnfixDecoration(
        function()
            local mainCards = {}
            --装备
            for key, value in pairs(self.equip_sids) do
                local award = {value[1], value[2]}
                table.insert(mainCards, {type = award})
            end
            --饰品
            for key, value in pairs(self.decoration) do
                local award1 = {value[1], value[2]}
                table.insert(mainCards, {type = award1})
            end
            local data = {}
            data.award = {item = {}}
            table.insertto(data.award.item, mainCards, 1)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            ---发送下阵的数据 到 服务器
            _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.DownCardOne, self.index)
            self:CloseView()
        end
    )
end
return CardDownGridItemView
