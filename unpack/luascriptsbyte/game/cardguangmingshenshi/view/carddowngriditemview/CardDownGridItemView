function CardDownGridItemView:QueDingOnClicktBtn()
    ---检测 是否 脱装备
    if self.AutoTuoZhuanbei == 2 then
        ---脱下神器
        require("ArtifactModel"):TakeOffArtifact(self.cradData, _G.handler(self, self.AutoDownEquipBar))
