---@class CardGodStoneView : UIBaseView	共鸣神石使用界面
---@field public go_table CardGodStoneView_GoTable GoTable
local CardGodStoneView = _G.BaseClass("CardGodStoneView", _G.UIBaseView)

---属性key
local propKeyList = {"atk", "bre", "def", "max_hp"}

function CardGodStoneView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self.propUseNum = 0
end

---界面的入口函数
function CardGodStoneView:OnCreate()
    self.itemData = _G.ConfigManager.discrete_cfg[102514][1]
    self.basePropConfig = _G.ConfigManager.discrete_cfg[102515][1]
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self:InitPropItem()
    self:RefreshView()
    self.propUseNum = self:CanUseMaxNum()
    self:RefreshPropUseInfo()
end

function CardGodStoneView:OnEndEditorDeclaration(input)
    local num = _G.tonumber(input)
    if not num then
        input = self.propUseNum
    end
    local max = self:CanUseMaxNum()
    num = _G.Mathf.Clamp(num, 0, max)
    if self.propUseNum ~= num then
       self.propUseNum = num
       self:RefreshPropUseInfo()
    end
end

---计算当前显示的属性
function CardGodStoneView:GetShowProp()
    local newPropData = {}
    for index, v in pairs(propKeyList) do
        local addNum =  self.basePropConfig[index] or 0
        newPropData[v] = addNum * (self.propUseNum + self.stoneUpNum)
    end

    return newPropData
end

---刷新道具使用
function CardGodStoneView:RefreshPropUseInfo(isInit)
    self.go_table.input_userNum.text = self.propUseNum
    if not isInit then 
        self:ShowProp()
    end
end

function CardGodStoneView:RefreshView()
    self.stoneUpNum = require("StoneModel"):GetInstance():GetStoneUpNum()
    local haveNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemData[1])
    self.go_table.aortext_haveNum.text = _G.GetLangPackValue(90000010363, haveNum)
    self:ShowProp()
end

---初始化道具item
function CardGodStoneView:InitPropItem()
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.itemData[1],
        self.itemData[2],
        self.go_table.obj_item,
        function(tran)
            if _G.IsNil(self.go_table.obj_item) then
               _G.DestroyObject(tran)
               return
            end

            tran:ShowEffect(true)
        end,
        function(go)
            require "CommonTipManager":GetInstance():OpenTip(self.go_table.obj_item, self.itemData[1])
        end
    )
end

---可使用的最大数量
function CardGodStoneView:CanUseMaxNum()
    return _G.StorageManager:GetInstance():GetItemCountBySid(self.itemData[1])
end

---统计刷新
function CardGodStoneView:calcProp()
    local propData = self:GetShowProp()
    local showList = {}
    for i, v in pairs(propData) do
        _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid, num = v})
    end
    _G.SortList(
        showList,
        function(a)
            return -a.sortId
        end
    )
    for _, v in pairs(showList) do
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = _G.AttrType[v.key].des
            local numStr = v.num
            if _G.AttrType[v.key].percentage == 1 then
                numStr = _G.GameUtil.FormatNum(numStr * 100)
                numStr = "<color=#6effc6>" .. tostring(numStr) .. "%" .. "</color>"
            else
                numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
            end
            tb.aortext_Num.text = numStr
            tb.gameObject:SetActiveE(1)
        end
    end
end

---设置属性
function CardGodStoneView:ShowProp()
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end

    self:calcProp()
end

---界面的销毁函数
function CardGodStoneView:OnDestroy()
end

---按钮点击事件在这里派发
function CardGodStoneView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
       self:Close()
    elseif go == self.go_table.aorbtn_propSub then
        if self.propUseNum > 0 then
           self.propUseNum = self.propUseNum - 1
           self:RefreshPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propAdd then
        if self.propUseNum < self:CanUseMaxNum() then
            self.propUseNum = self.propUseNum + 1
            self:RefreshPropUseInfo()
        end
    elseif go == self.go_table.aorbtn_propMax then
        self.propUseNum = self:CanUseMaxNum()
        self:RefreshPropUseInfo()
    elseif go == self.go_table.aorbtn_Prop then
        self:OnClickPropBtn()
    end
end

---属性按钮
function CardGodStoneView:OnClickPropBtn()
    if self.propUseNum <= 0 then
        return
    end
    require("CardGuangMingShenShiManager"):GetInstance():DevelopStone(
        self.propUseNum,
        function()
            self:LoadEffect()
            _G.StorageManager:GetInstance():ConsumeItem(self.itemData[1], self.itemData[1], self.propUseNum)
            ---属性变化提示
            local curProp = self:GetShowProp()
            self.propUseNum = 0
            local lastProp = self:GetShowProp()
            _G.UIUtils.ShowPropUp(nil, lastProp, nil, {prop = curProp})
            ---战力变化提示
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.GodStone)
            local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
            local offset = newPower - self.power
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(self.power, offset)
                self.power = newPower
            end
            ---刷新界面
            self:RefreshView()
            self:RefreshPropUseInfo()
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CardconmonDevelop.id)
        end
    )
end

---充能成功特效
function CardGodStoneView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_gmssLU, 
        self.go_table.obj_icon
    )
end

return CardGodStoneView