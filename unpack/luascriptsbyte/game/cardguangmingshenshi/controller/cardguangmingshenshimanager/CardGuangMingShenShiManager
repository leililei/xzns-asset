---数据改变时掉用
function CardGuangMingShenShiManager:Chang(change_all_card)
    --升级调用
    if self.isUpLevel then
        local uid = 0
        for key, _ in pairs(change_all_card) do
            uid = key
        end
        self:CardLeveUpReplaceHexin(uid)
        self:SetUpLevel(false)
        self:RedPointUp()
    end
    --升星调用
    if self.isUpStar then
        self:SetUpStar(false)
    end
    --卡牌重置等级
    if self.isResetLevel then
        self:CheckStorageResetLevel()
        local flag = false
        for key, value in pairs(change_all_card) do
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, key)
            if card.shenshiPosType == _G.GridCardPosEnum.hexin then
                flag = true
                break
            end
        end
        if flag then
            self.shenshiModel:SetAllGridCardLevel(self.shenshiModel.stone_level)
            self:RedPointUp()
        end
    end
end

