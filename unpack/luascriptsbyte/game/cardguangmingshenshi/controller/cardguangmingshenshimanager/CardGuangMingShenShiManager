---设置神石卡槽的 等级 单个设置等级
function CardGuangMingShenShiManager:SetCardLevel(uid, level)
    local cardData = self:GetUidToCard(uid)
    if not _G.table.isEmptyOrNil(cardData) then
        local cfg = _G.ConfigManager.card_star_cfg
        local elements = cardData.cfg.Elements_new
        local id = require("CardInfoManager"):GetInstance():GetStarCfgId(elements , cardData.star)
        local limitLeve = cfg[id].level_limit
        if self.shenshiModel:GetStoneEnum() == _G.StoneStateType.sceond then
            cardData.shenshiLv = level
            cardData.lv = cardData:GetLevel()
            cardData:AddCardLv(0)
            return
        end
        if level >= limitLeve then
            cardData.shenshiLv = limitLeve
        else
            cardData.shenshiLv = level
        end
        cardData.lv = cardData:GetLevel()
        cardData:AddCardLv(0)
    end
end
---检测 是否 在神石的 卡槽中
function CardGuangMingShenShiManager:CheckUidLists(uid)
    if not self.shenshiModel:CheckFunctionOpen() then
        return false
    end
    if self.shenshiModel.shenShiStage == _G.StoneStateType.sceond then
        return true
    end
    local allgrid = self.shenshiModel:GetAllGrid()
    if _G.table.isEmptyOrNil(allgrid) then
        return false
    end
    local number = 0
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.secend then
        number = hexinnumber
    end
    local lockNumber = self.shenshiModel:GetMinUnlockNumber() + self.shenshiModel:GetCurrentGrid() + number
    for i = 1, lockNumber do
        if allgrid[i]:GetCarduid() == uid then
            return true
        end
    end
    return false
end
