---@param index number 1 是星级 2 是五行
---五行排序
function CardGuangMingShenShiManager:WuxingPaixu1()
    local kacao = self.shenshiModel:GetAllGrid()
    local number = 0
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.secend then
        number = hexinnumber
    end
    local lockNumber = self.shenshiModel:GetMinUnlockNumber() + self.shenshiModel:GetCurrentGrid() + number
    for i = 1, lockNumber do
        for j = i + 1, lockNumber do
            local dj = kacao[j]:GetCard()
            local di = kacao[i]:GetCard()
            if
                not _G.table.isEmptyOrNil(dj) and not _G.table.isEmptyOrNil(di) and 
                tonumber(require "CardInfoManager":GetInstance():GetElementsKey(dj.cfg.Elements_new)) > tonumber(require "CardInfoManager":GetInstance():GetElementsKey(di.cfg.Elements_new)) or
                    not _G.table.isEmptyOrNil(dj) and not _G.table.isEmptyOrNil(di) and
                        require "CardInfoManager":GetInstance():CheckMultiMatch(dj.cfg.Elements_new, di.cfg.Elements_new) and
                        dj.star > di.star or
                    (_G.table.isEmptyOrNil(di) and not _G.table.isEmptyOrNil(dj)) or
                    (_G.table.isEmptyOrNil(di) and _G.table.isEmptyOrNil(dj) and kacao[j]:GetLastTime() > 0) or
                    kacao[i]:GetCarduid() == 0 and not _G.table.isEmptyOrNil(dj) or
                    kacao[i]:GetCarduid() == 0 and _G.table.isEmptyOrNil(dj) and kacao[j]:GetLastTime() > 0
             then
                local d = kacao[i]
                local indexi = kacao[i]:GetGridIndex()
                local indexJ = kacao[j]:GetGridIndex()
                kacao[i] = kacao[j]
                kacao[i]:SetGridIndex(indexi)
                kacao[j] = d
                kacao[j]:SetGridIndex(indexJ)
            end
        end
    end
end

function CardGuangMingShenShiManager:ExchangeKapai(grid)
    local kacao = self.shenshiModel:GetAllGrid()
    local number = 0
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.secend then
        number = hexinnumber
    end
    local lockNumber = self.shenshiModel:GetMinUnlockNumber() + self.shenshiModel:GetCurrentGrid() + number
    local index = 0
    for i = 1, lockNumber do
        if kacao[i]:GetCarduid() == 0 and kacao[i]:GetGridDataEnum() == _G.GridDataEnum.add then
            index = i
            break
        end
    end
    if index == 0 then
        return false
    end
    local indexJ = grid:GetGridIndex()
    if index >= indexJ then
        return false
    end
    local d = kacao[index]
    local indexi = kacao[index]:GetGridIndex()
    kacao[index] = grid
    kacao[index]:SetGridIndex(indexi)
    kacao[indexJ] = d
    kacao[indexJ]:SetGridIndex(indexJ)
    self.currentGridIndex = indexi
    return true
end
