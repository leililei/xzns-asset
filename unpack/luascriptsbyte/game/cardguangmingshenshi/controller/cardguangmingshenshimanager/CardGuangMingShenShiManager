---吃卡 后，去仓库 检测卡牌 上阵到神石核心
function CardGuangMingShenShiManager:CheckStorageCardsUpHexin()
    self.shenshiModel:SetIsRemoveCard(false)
    local Storage = self.shenshiModel:RepeatCardDatasBagAndKaCao()
    local temp = {}
    local hexincard = self.shenshiModel:GetAllCore()
    local pbData = {
        type = _G.StonePosType.PosTwo,
        index = {},
        cd = 0
    }
    for i = 1, #hexincard do
        if hexincard[i]:GetCarduid() == 0 then
            _G.table.insert(temp, hexincard[i]:GetCardHexinIndex())
        end
    end
    if not _G.table.isEmptyOrNil(temp) then
        for i = 1, #temp do
            if not _G.table.isEmptyOrNil(Storage[i]) then
                local data = {
                    index = temp[i],
                    uid = Storage[i].uid
                }
                _G.table.insert(pbData.index, data)
            end
        end
    end
    if _G.table.isEmptyOrNil(pbData.index) then
        return --没有卡牌
    end
    ---检测 是否 卡牌是不是 有没有在 卡槽中
    local pb = {index = {}, type = _G.StonePosType.PosOne}
    for i = 1, #pbData.index do
        for j = 1, #self.shenshiModel.allGrid do
            local grid = self.shenshiModel.allGrid[j]
            if grid:GetCarduid() ~= 0 and pbData.index[i].uid == grid:GetCarduid() then
                _G.table.insert(pb.index, grid:GetCardKaCaoIndex())
            end
        end
    end
    if not _G.table.isEmptyOrNil(pb.index) then
        self:DownCardsHexin(pb, pbData, false)
    else
        self:UpCardsHexin(pbData)
    end
end
