    --卡牌坐标 转为 格子坐标
    local grid = self:GetkacaoBag(onclickIndex)
    grid:SetGridDataEnum(_G.GridDataEnum.cooling)
    local cdlimit = self.shenshiModel:GetCloolingLimit()
    grid:SetCd(cdlimit)
    grid:SetLastTime(_G.TimeUtil.GetServerUnixTime())
    if flag then
        local cardata = grid:GetCard()
        grid:SetCardStonePos(_G.GridCardPosEnum.zero)
        grid:SetCardLevel(0)
        grid:SetCardStone(_G.StoneEnum.zero)
        cardata:SetLevel(cardata.lv_Old)
        cardata:AddCardLv(0)
    else
        grid:SetLastTime(0)
    end
    grid:SetCardUid(0)
    self.shenshiModel.up_num = self.shenshiModel.up_num - 1
    _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.UpDataShenSHiBag)
