--region 设置神石二阶段 对外接口 卡牌升级
function CardGuangMingShenShiManager:CardLeveUpReplaceHexin(uid)
    --检测 功能是否 开启
    if not self.shenshiModel:CheckFunctionOpen() then
        return
    end
    local Card = self:GetUidToCard(uid)
    local lv = self.shenshiModel:GetMaxLimitLevel()
    --神石2阶段
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.sceond then
        return
    end
    local flag = false
    local count = 0
    local core_uid = self.shenshiModel:GetAllCore()
    --检测是不是 自己 同时检测下 达到限制 开启条件的 等级
    for i = 1, #core_uid do
        if core_uid[i]:GetCarduid() ~= 0 and core_uid[i]:GetCarduid() == uid then
            flag = true
        end
        local ca = core_uid[i]:GetCard()
        if not _G.table.isEmptyOrNil(ca) then
            if ca.lv >= lv and Card.uid ~= ca.uid then
                count = count + 1
            end
        end
    end
    if flag and (count + 1) == hexinnumber then
        if Card.lv >= lv then
            self.shenshiModel.unlockLevel = 2
            self.shenshiModel.stone_level = lv
            self.shenshiModel:SetAllGridCardLevel(lv)
            return
        else
            self.shenshiModel:SetAllGridCardLevel(self.shenshiModel:InitStoneCardLevel())
            return
        end
    elseif flag and (count + 1) < hexinnumber then
        self.shenshiModel:SetAllGridCardStone()
        return
    end
    --检测自己 是不是 最小的 有没有空位置
    local flag = self.shenshiModel:GetRenAndLingOfCoreUids()
    ---是空直接发送上阵的数据
    if flag then
        local hexinIndex = 0
        hexinIndex = self:CheckHeXinKongSpace(Card)
        self:SendHexinSpaceUpCardData(hexinIndex, Card.uid)
    else
        self:CheckHexin(Card, self.shenshiModel.core_uid)
    end
end
---没有空位置 检测
function CardGuangMingShenShiManager:CheckHexin(card, chektable)
    local hexinIndex = 0
    _G.table.sort(
        chektable,
        function(a, b)
            if a:GetCard().lv_Old < b:GetCard().lv_Old then
                return true
            elseif a:GetCard().lv_Old == b:GetCard().lv_Old and a:GetCard().cfg.Order < b:GetCard().cfg.Order then
                return true
            end
            return false
        end
    )
    local cardTarget = chektable[1]:GetCard()
    if card.lv_Old > cardTarget.lv_Old or (card.lv_Old == cardTarget.lv_Old and card.cfg.Order > cardTarget.cfg.Order) then
        hexinIndex = chektable[1]:GetCardHexinIndex()
        self:SendHexinDownCardAuto(hexinIndex, card.uid)
    end
end
--- 核心 下阵
function CardGuangMingShenShiManager:SendHexinDownCardAuto(hexinIndex, uid)
    local pbData = {
        index = {},
        type = _G.GridCardPosEnum.hexin
    }
    _G.table.insert(pbData.index, hexinIndex)
    require("CardShenShiNet"):GetInstance():AccessDownCard(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            local grid = self.shenshiModel:GetOneCoreData(hexinIndex)
            grid:SetCardStonePos(_G.GridCardPosEnum.zero)
            grid:SetCardStone(_G.StoneEnum.zero)
            self.shenshiModel:ChaneOneCore_uid(hexinIndex, 0)
            self:SendHexinSpaceUpCardData(hexinIndex, uid)
            _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.DownCoreCard, pbData.index)
        end
    )
end
---有空位置  检测
function CardGuangMingShenShiManager:CheckHeXinKongSpace(card)
    local hexinIndex = 0
    local core_uid = self.shenshiModel:GetAllCore()
    for i = 1, #core_uid do
        if core_uid[i]:GetCarduid() == 0 then
            hexinIndex = core_uid[i]:GetCardHexinIndex()
