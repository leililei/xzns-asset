---上阵
---@param hexinindex number 自动上阵的 核心的下标
---@param uid number 自动上阵的 uid
function CardGuangMingShenShiManager:SendHexinSpaceUpCardData(hexinindex, uid)
    local pbData = {
        type = _G.StonePosType.PosTwo,
        index = {},
        cd = 0
    }
    local da = {}
    da.index = hexinindex
    da.uid = uid
    _G.table.insert(pbData.index, da)
    require("CardShenShiNet"):GetInstance():AccessUpCard(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            self.shenshiModel:SetOneCoreData(hexinindex, da)
            --self.shenshiModel:SetAllGridCardLevel(self.shenshiModel:InitStoneCardLevel())
            --local flag = false
            local core_uid = self.shenshiModel:GetAllCore()
            local count = 0
            local lv = self.shenshiModel:GetMaxLimitLevel()
            --检测是不是 自己 同时检测下 达到限制 开启条件的 等级
            for i = 1, #core_uid do
                local ca = core_uid[i]:GetCard()
                if not _G.table.isEmptyOrNil(ca) then
                    if ca.lv >= lv then
                        count = count + 1
                    end
                end
            end
            --local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, da.uid)
            --客户端 开启神石二阶段 重新获取信息
            if count == hexinnumber then
                self.shenshiModel.unlockLevel = _G.StoneEnum.secend
            end
            self.shenshiModel:SetAllGridCardStone()
            self:RedPointUp()
            _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.UpCoreCard, pbData.index)
        end
    )
end
