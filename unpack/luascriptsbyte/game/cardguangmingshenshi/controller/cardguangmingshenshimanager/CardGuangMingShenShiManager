---获得卡牌
---@param add table 获得卡牌的 uid 表(key=uid,value = sid)
function CardGuangMingShenShiManager:GetCardTongBuShenshi(add)
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.secend then
        return
    end
    local cardAdds = {}
    for key, value in pairs(add) do
        local card = self:GetUidToCard(key)
        if card.shenshiPosType == _G.GridCardPosEnum.zero then
            _G.table.insert(cardAdds, card)
        end
    end
    _G.table.sort(
        cardAdds,
        function(a, b)
            if a.lv > b.lv then
                return true
            elseif a.lv == b.lv and a.cfg.Order > b.cfg.Order then
                return true
            end
            return false
        end
    )
    local core_uid = self.shenshiModel:GetAllCore()
    local flag = false
    --检测是不是 自己 同时检测下 达到限制 开启条件的 等级
    for i = 1, #core_uid do
        if core_uid[i]:GetCarduid() == 0 then
            flag = true
            break
        end
    end
    if not flag then
        local lv, uid = self.shenshiModel:GetLevelofCoreUids()
        local card = self:GetUidToCard(uid)
        if cardAdds[1].lv < lv then
            return
        elseif cardAdds[1].lv == lv and cardAdds[1].cfg.Order <= card.cfg.Order then
            return
        end
    end
    ---是空直接发送上阵的数据
    self:CheckHexinAdd(cardAdds, self.shenshiModel.core_uid)
end
function CardGuangMingShenShiManager:CheckHexinAdd(cards)
    local pbData = {
        type = _G.StonePosType.PosTwo,
        index = {}
    }
    local flag = self.shenshiModel:GetRenAndLingOfCoreUids()
    local hexincard = self.shenshiModel:GetAllCore()
    local temp = {}
    if flag then
        for i = 1, #hexincard do
            if hexincard[i]:GetCarduid() == 0 then
                _G.table.insert(temp, hexincard[i]:GetCardHexinIndex())
            end
        end
        if not _G.table.isEmptyOrNil(temp) then
            for i = 1, #temp do
                if not _G.table.isEmptyOrNil(cards[i]) then
                    local data = {
                        index = temp[i],
                        uid = cards[i].uid
                    }
                    _G.table.insert(pbData.index, data)
                end
            end
        end
        if _G.table.isEmptyOrNil(pbData.index) then
            return
        end
        self:UpCardsHexin(pbData)
        return
    end
    local lv, uid, index = self.shenshiModel:GetLevelofCoreUids()
    local card = self:GetUidToCard(uid)
    local data = {
        uid = 0,
        index = 0
    }
    local pb = {
        index = {},
        type = _G.StonePosType.PosTwo
    }
    _G.table.insert(pb.index, index)
    if _G.table.isEmptyOrNil(cards) then
        return
    end
    data.uid = cards[1].uid
    local flag = false
    if data.uid == 0 then
        flag = true
    end
    data.index = index
    _G.table.insert(pbData.index, data)
    self:DownCardsHexin(pb, pbData, flag)
end
---获得卡牌  下阵数据
---@param flag boolean true 没有可上阵的卡牌
function CardGuangMingShenShiManager:DownCardsHexin(pbDataRem, pbDataAdd, flag)
    require("CardShenShiNet"):GetInstance():AccessDownCard(
        pbDataRem,
        function(data)
            if data.ack ~= 1 then
                return
            end
            if pbDataRem.type == _G.GridCardPosEnum.hexin then
                for i = 1, #pbDataRem.index do
                    local grid = self.shenshiModel:GetOneCoreData(pbDataRem.index[i])
                    grid:SetCardStonePos(_G.GridCardPosEnum.zero)
                    grid:SetCardStone(_G.StoneEnum.zero)
                    self.shenshiModel:ChaneOneCore_uid(pbDataRem.index[i], 0)
                end
                if flag then
                    self.shenshiModel:SetAllGridCardStone()
                    return
                end
            elseif pbDataRem.type == _G.GridCardPosEnum.kacao then
                for i = 1, #pbDataRem.index do
                    local ind = self.shenshiModel:GetAllGridKeyOfKaCaoIndex(pbDataRem.index[i])
                    self:DisposeCardDownDataOne(ind, true)
                    local grid = self:GetkacaoBag(ind)
                    grid:SetLastTime(0)
                end
            end
            self:UpCardsHexin(pbDataAdd)
        end
    )
end
function CardGuangMingShenShiManager:UpCardsHexin(pbData)
    if not self.shenshiModel or not self:IsShenShiOpen() then
        return
    end
    require("CardShenShiNet"):GetInstance():AccessUpCard(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            for i = 1, #pbData.index do
                local hexinindex = pbData.index[i].index
                local grid = self.shenshiModel:GetOneCoreData(hexinindex)
                grid:SetCardUid(pbData.index[i].uid)
                grid:SetCardHeXinIndex(hexinindex)
                grid:SetGridCardPosEnum(_G.GridCardPosEnum.hexin)
                grid:SetCardStonePos(_G.GridCardPosEnum.hexin)
                --local card = grid:GetCard()
            end
            self.shenshiModel:SetAllGridCardStone()
            if pbData.type == _G.StonePosType.PosTwo then
                _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.UpCoreCard, pbData.index)
            end
        end
    )
end
---------------------删除卡牌 -----------------------
---吃卡，不分，神石的阶段
---@param remuids table 删除卡牌的uids
function CardGuangMingShenShiManager:RemoveCardAllGrid(remuids)
    local core_uid = self.shenshiModel:GetAllCore()
    local uid_list = self.shenshiModel:GetAllGrid()
    local remKaCao, remHexin = {}, {}
    for key, value in pairs(remuids) do
        for j = 1, #core_uid do
            if core_uid[j]:GetCarduid() ~= 0 and value == core_uid[j]:GetCarduid() then
                _G.table.insert(remHexin, core_uid[j]:GetCardHexinIndex())
                break
            end
        end
        if #remHexin >= 0 then
            break
        end
        for i = 1, #uid_list do
            if uid_list[i]:GetCarduid() ~= 0 and value == uid_list[i]:GetCarduid() then
                _G.table.insert(remKaCao, uid_list[i]:GetCardKaCaoIndex())
                break
            end
        end
    end
    return remKaCao, remHexin
end

