function CardGuangMingShenShiManager:UnlockShenshiGrid(tempIndex, go)
    local number = 0
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.secend then
        number = hexinnumber
    end
    local on_index = self.shenshiModel:GetCurrentGrid() + number + 1 + self.shenshiModel:GetMinUnlockNumber()
    self.currentGridIndex = on_index
    --判断材料 是否 足够
    self.limit = self.shenshiModel:GetunlockMaterialsNumber(on_index)
    local nameId = self.shenshiModel:Getunlock_materialsCfg()
    local itemCount = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Material, nameId[1])

    --获得砖石数量
    local diamodNumber = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
    --消耗砖石
    local diamodLimit = self.shenshiModel:GetDiamodUnlockLimit()
    local tipsId = self.shenshiModel.ShenShiTips.materialUnloc
    local contentId = _G.ConfigManager.tips_system_cfg[tipsId].content
    local CN = _G.LangUtil.GetLangPackValue(contentId)
    local content = string.format(CN, self.limit)
    if itemCount < self.limit then
        self:PopTipsZuanshi(diamodNumber, diamodLimit, go)
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipsId,
            content,
            function()
                self:SendToSeverUnlockGrid(1, self.limit, go)
            end,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.OptionDialogView.Name)
            end
        )
    end
end

