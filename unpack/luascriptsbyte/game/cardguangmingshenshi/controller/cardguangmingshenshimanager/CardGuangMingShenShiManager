---共鸣神石平均等级
function CardGuangMingShenShiManager:AverageLv()
    local hexincard = self.shenshiModel:GetAllCore()
    local level = 0
    local count = 0
    for _, v in pairs(hexincard) do
        if v:GetCarduid() > 0 then
            level = level + v:GetCard().lv
            count = count + 1
        end
    end

    if count > 0 then
        return _G.Mathf.RoundToInt(level / count)
    end
    return level
end

---共鸣神石上最高等级
function CardGuangMingShenShiManager:GetMaxLv()
    local hexincard = self.shenshiModel:GetAllCore()
    local level = 0
    for _, v in pairs(hexincard) do
        if v:GetCarduid() > 0 then
            level = _G.Mathf.Max(level, v:GetCard().lv)
        end
    end
    return level
end
