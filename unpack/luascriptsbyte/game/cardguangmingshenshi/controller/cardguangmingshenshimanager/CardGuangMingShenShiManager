--region 对外接口 角色重置等级
---@param uids table 卡牌重置等级 所有的 uids
function CardGuangMingShenShiManager:ResetCardLevel(uids, callback)
    if not self.shenshiModel:CheckFunctionOpen() then
        if callback then
            callback()
        end
        return
    end
    local core_uid = self.shenshiModel:GetAllCore()
    local flag = false
    for j = 1, #uids do
        for i = 1, #core_uid do
            local grid = core_uid[i]
            if grid:GetCarduid() ~= 0 and grid:GetCarduid() == uids[j] then
                flag = true
                break
            end
        end
        if flag then
            break
        end
    end
    if not flag then
        if callback then
            callback()
        end
        return
    end
    local Storage = self.shenshiModel:RepeatCardDatasBagAndKaCao() or {}
    --卡牌是空
    if _G.table.isEmptyOrNil(Storage) then
        self.shenshiModel:SetAllGridCardStone()
        if callback then
            callback()
        end
        return
    end
    local hexincard = self.shenshiModel:GetAllCore()
    local index_downs = {}
    for j, _ in pairs(uids) do
        for i = 1, #hexincard do
            if uids[j] == hexincard[i]:GetCarduid() then
                _G.table.insert(index_downs, hexincard[i]:GetCardHexinIndex())
                break
            end
        end
    end
    if _G.table.isEmptyOrNil(index_downs) then
        self.shenshiModel:SetAllGridCardStone()
        if callback then
            callback()
        end
        return
    end
    local pbData = {
        type = _G.GridCardPosEnum.hexin,
        index = {}
    }
    pbData.index = index_downs
    self:SetResetCardLevel(true)
    require("CardShenShiNet"):GetInstance():AccessDownCard(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            for i = 1, #pbData.index do
                local grid = self.shenshiModel:GetOneCoreData(pbData.index[i])
                grid:SetCardStonePos(_G.GridCardPosEnum.zero)
                grid:SetCardStone(_G.StoneEnum.zero)
                self.shenshiModel:ChaneOneCore_uid(pbData.index[i], 0)
            end
            _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.DownCoreCard, index_downs)
            if callback then
                callback()
            end
        end
    )
end
