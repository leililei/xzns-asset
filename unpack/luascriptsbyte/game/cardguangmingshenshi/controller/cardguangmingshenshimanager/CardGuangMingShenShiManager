function CardGuangMingShenShiManager:RecUnlockGrid(data, type, go, index)
    if data.ack ~= 1 then
        return
    end
    --减少魂玉(砖石)
    if type == 1 then
        local itemId = self.shenshiModel:Getunlock_materialsCfg()
        _G.StorageManager:GetInstance():ConsumeItem(itemId[1], nil, self.limit)
    elseif type == 2 then
        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, nil, self.shenshiModel:GetDiamodUnlockLimit())
    end
    self:UnlockGridsuccessful(self.currentGridIndex, go, index)
end

