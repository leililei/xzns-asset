            self:zhaomuNum(value)

            if value == _G.ResPropID.Diamond or value == 202050100 then
                flagDiamond = true
                break
            end
        end
    end
    if not _G.table.isEmptyOrNil(change) then
        for key, value in pairs(change) do
            self:zhaomuNum(value)

            if value == _G.ResPropID.Diamond or value == 202050100 then
                flagDiamond = true
                break
            end
        end
    end
    if not _G.table.isEmptyOrNil(rem) then
        for key, value in pairs(rem) do
            self:zhaomuNum(value)

            if value == _G.ResPropID.Diamond or value == 202050100 then
                flagDiamond = true
                break
            end
        end
    end

    if not flagDiamond then
        return
    end
    self:RedStoneRefresh()
