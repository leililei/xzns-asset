---共鸣神石解锁 第二阶段
function CardGuangMingShenShiManager:UnlockStoneState(call)
    require("CardShenShiNet"):GetInstance():UnlockStoneState(
        function(data)
            if data.ack ~= 1 then
                self.shenshiModel:GetDataFormServer()
                return
            end
            for i = 1, #self.shenshiModel.core_uid do
                local grid = self.shenshiModel.core_uid[i]
                if grid:GetCarduid() ~= 0 then
                    grid:SetGridDataEnum(_G.GridDataEnum.head)
                    local card = grid:GetCard()
                    grid:SetCardStone(_G.StoneEnum.secend)
                    card.lv_Old = 1
                end
            end

            self.shenshiModel.unlockLevel = _G.StoneEnum.first
            self.shenshiModel:SetStoneEnum(_G.StoneEnum.secend)

            local level = self.shenshiModel:GetMaxLimitLevel()
            local kacao = self.shenshiModel:GetAllGrid()
            for i = 1, self.shenshiModel:GetCurrentGrid() + self.shenshiModel:GetMinUnlockNumber() do
                if kacao[i]:GetCarduid() ~= 0 or kacao[i]:GetLastTime() > 0 then
                    if _G.table.isEmptyOrNil(self.shenshiModel.uid_list[i]) then
                        self.shenshiModel.uid_list[i] = {}
                    end
                    self.shenshiModel.uid_list[i] = kacao[i]
                end
            end
            self.shenshiModel:SetUnnum(self.shenshiModel.uid_list, self.shenshiModel.core_uid)
            self.shenshiModel:SetAllGrid()
            self.shenshiModel:InitAllGrid()
            self.shenshiModel:SetAllGridCardLevel(level)
            if call then
                call()
            end
            self:RedPointUp()
        end
    )
end
---检测是否可以升级
function CardGuangMingShenShiManager:CheckCanUp()
    if self.shenshiModel:GetStoneEnum() == _G.StoneEnum.secend then
        if self.shenshiModel.stone_level >= self.shenshiModel.shenLevel_Limit then
            return false
        else
            self.shenshiModel:GetCaiLiaoXiaoHaoLimit(self.shenshiModel.stone_level)
            self.shenshiModel:GetBagUpLevelNumber()
            local tab = self:CheckUpLevelCaiLiaoManzu()
            return _G.table.isEmptyOrNil(tab)
        end
    else
        if self.shenshiModel:CheckIsCanUnLock() then
            if _G.PlayerPrefsManager.HasKey("CardGuangMingShenShiManagerUpLevel") then
                return false
            else
                return true
            end
        end
    end
    return false
end

