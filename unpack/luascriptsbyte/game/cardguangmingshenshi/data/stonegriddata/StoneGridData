local base = require("BaseItemData")
---@class StoneGridData	中文描述
local StoneGridData = _G.BaseClass("StoneGridData", base)
_G.StoneGridData = StoneGridData

---类的析构函数
function StoneGridData:Dispose()
end
---@field self.gridDataEnum number 格子的状态
---@field self.gridindex number 格子的位置
---@field self.card_kacao_index number 卡牌卡槽的位置
---@field self.card_hexin_index number 卡牌核心的位置
---@field slef.card_uid number 卡牌的 uid
---@field slef.lasttime number 卡牌的倒计时 基数
---@param data number 核心的 数据 cd uid index
---@param gridenum number 格子的类型
---@param cardposEnum number 卡牌的位置类型
---@param stoneEnum number 神石的状态
---@param isKaCao boolean 神石核心卡牌 是否在卡槽中
---@param isLevelLimit boolean 是否 达到等级上限
---@param isKacaoOrhexin boolean true 卡槽 false 是 核心
function StoneGridData:ParseInitMsg(data, gridenum, cardposEnum, stoneEnum)
    self.girdDataEnum = gridenum or _G.GridDataEnum.unlock
    self.girdindex = 0
    self.card_kacao_index = 0
    self.card_hexin_index = 0
    local uid = data.uid or 0
    self:SetCardUid(uid)
    self:SetCd()
    self.lasttime = data.cd or 0
    self.cardposEnum = cardposEnum or _G.GridCardPosEnum.zero
    self.stoneEnum = stoneEnum or _G.StoneEnum.zero
    self.isKacao = false
    self.isLevelLimit = false
    self.isKacaoOrhexin = true
end
--region 设置、获取
function StoneGridData:SetStoneEnum(enum)
    self.stoneEnum = enum
end
function StoneGridData:GetStoneEnum()
    return self.stoneEnum
end
---设置格子的状态
function StoneGridData:SetGridDataEnum(enum)
    self.girdDataEnum = enum
end
function StoneGridData:GetGridDataEnum()
    return self.girdDataEnum
end
---设置格子的下标
function StoneGridData:SetGridIndex(index)
    self.girdindex = index
end
function StoneGridData:GetGridIndex()
    return self.girdindex
end
---设置卡牌卡槽的下标
function StoneGridData:SetCardKaCaoIndex(index)
    self.card_kacao_index = index
end
function StoneGridData:GetCardKaCaoIndex()
    return self.card_kacao_index
end
---设置卡牌核心的下标
function StoneGridData:SetCardHeXinIndex(index)
    self.card_hexin_index = index
end
function StoneGridData:GetCardHexinIndex()
    return self.card_hexin_index
end
---设置卡牌的uid
function StoneGridData:SetCardUid(uid)
    self.card_uid = uid or 0
end
function StoneGridData:GetCarduid()
    return self.card_uid
end
function StoneGridData:GetCard()
    --uid 转为 card
    local card = {}
    if self:GetCarduid() ~= 0 then
        card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self:GetCarduid())
    end
    return card
end
---设置倒计时计数
function StoneGridData:SetLastTime(time)
    self.lasttime = time
end
function StoneGridData:GetLastTime()
    return self.lasttime
end
function StoneGridData:SetCd()
    local cd = _G.ConfigManager.discrete_cfg[102506][1][1]
    self.cd = cd * 3600
end
function StoneGridData:GetCd()
    return self.cd or 0
end
---设置 卡槽的位置
function StoneGridData:SetGridCardPosEnum(enum)
    self.cardposEnum = enum
end
function StoneGridData:GetGridCardPosEnum()
    return self.cardposEnum
end
---根据卡牌的位置  获得 卡牌的下标（卡槽、核心）
function StoneGridData:GetCardPosEnumBackIndex()
    if self:GetGridCardPosEnum() == _G.GridCardPosEnum.kacao then
        return self:GetCardKaCaoIndex()
    else
        return self:GetCardHexinIndex()
    end
end

---设置卡牌的 等级
function StoneGridData:SetCardLevel(level)
    local card = self:GetCard()
    local limitCfg = _G.ConfigManager.discrete_cfg
    local order_limit = limitCfg[102513]
    local start_limit = limitCfg[102511] --- 品质 最大可升星的 等级
    local flag = false
    if not _G.table.isEmptyOrNil(card) then
        for key, value in pairs(order_limit[1]) do
            if card.cfg.Order == value then
                flag = true
                break
            end
        end
        local star = card.star
        if flag then
            for k, v in pairs(start_limit) do
                if v[1] == card.cfg.Order then
                    star = v[2]
                    break
                end
            end
        end

        local cfg = _G.ConfigManager.card_star_cfg
        local elements = card.cfg.Elements_new
        local id = require("CardInfoManager"):GetInstance():GetStarCfgId(elements, star)
        local limitLeve = cfg[id].level_limit
        if flag then
            if level >= limitLeve then
                card.shenshiLv = limitLeve
                self:SetIslevelLimit(true)
            else
                card.shenshiLv = level
            end
        else
            self:SetIslevelLimit(false)
            card.shenshiLv = level
        end
        -- if stoneEnum == _G.StoneEnum.secend then
        --     card.shenshiLv = level
        --     card.lv = card:GetLevel()
        --     card:AddCardLv(0)
        --     return
        -- end
        -- if level >= limitLeve then
        --     card.shenshiLv = limitLeve
        -- else
        --     card.shenshiLv = level
        -- end
        card.lv = card:GetLevel()
        card:AddCardLv(0)
    end
end
---设置等级上限
function StoneGridData:SetIslevelLimit(flag)
    self.isLevelLimit = flag
end
function StoneGridData:GetIslevelLimit()
    return self.isLevelLimit
end
---设置卡牌的状态
function StoneGridData:SetCardStone(enum)
    local card = self:GetCard()
    if not _G.table.isEmptyOrNil(card) then
        card.shenState = enum
    end
end
---设置卡牌的位置
function StoneGridData:SetCardStonePos(enum)
    local card = self:GetCard()
    if not _G.table.isEmptyOrNil(card) then
        card.shenshiPosType = enum
    end
end
---设置是否在卡槽中
function StoneGridData:SetIsKaCaoStone(isBool)
    self.isKacao = isBool
end
function StoneGridData:GetIsKaCaoStone()
    return self.isKacao
end
--endregion
return StoneGridData
