function StoneModel:SetShenShiLeveLimit()
    -- if self:GetStoneEnum() ~= _G.StoneEnum.secend then
    --     return
    -- end
    local count = #self.max_sids or 0
    self.shenLevel_Limit = count * self.shenshilvLimit
    local lvLimit = self:GetMaxLimitLevel()
    self.shenLevel_Limit = self.shenLevel_Limit + lvLimit
    if self.shenLevel_Limit > maxLevel then
        self.shenLevel_Limit = maxLevel
    end
end
