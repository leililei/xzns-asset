---初始化 核心的数据
function StoneModel:InitCoreuids()
    local data = {}
    for i = 1, hexinNumber do
        data = {}
        data.cd = 0
        data.uid = 0
        data.index = i
        self:SetOneCoreData(i, data)
    end
end
---初始化 神石的等级
---初始化 神石的阶段
function StoneModel:InitStoneEnum(data)
    if self.stone_level >= self:GetMaxLimitLevel() then
        self:SetStoneEnum(_G.StoneEnum.secend)
        return
    end
    local flag = false
    if _G.table.isEmptyOrNil(data) then
        self:SetStoneEnum(_G.StoneEnum.zero)
        return
    end
    for i = 1, #data do
        if data[i].uid == 0 then
            flag = true
            break
        end
    end
    if #data < hexinNumber then
        flag = true
    end
    if flag then
        self:SetStoneEnum(_G.StoneEnum.zero)
    else
        self:SetStoneEnum(_G.StoneEnum.first)
    end
end
---初始化 可用添加的格子下标
function StoneModel:InitStoneLockGridIndex()
    for i = 1, self.curr_unlock_number + self.minUnlockNumber do
        self:SetLockGridIndex(i, 0)
    end
end
---初始化 神石的卡牌等级
function StoneModel:InitStoneCardLevel()
    local lv = 0
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        lv = self.stone_level
    elseif self:GetStoneEnum() == _G.StoneEnum.first then
        lv = self:GetLevelofCoreUids()
    else
        lv = 1
    end
    self:SetStoneLevel(lv)
    return lv
end
function StoneModel:SetStoneLevel(lv)
