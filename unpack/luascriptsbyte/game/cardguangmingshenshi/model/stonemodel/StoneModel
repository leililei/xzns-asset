function StoneModel:GetCaiLiaoXiaoHaoLimit(level, targetLevel)
    local lv = level or self.stone_level
    local targetlv = targetLevel or lv + 1
    if targetlv > maxLevel then
        targetlv = maxLevel
    end
    local nextItemLimit = self:GetUpLevelLimitItem(targetlv)
    local currentItemLimit = self:GetUpLevelLimitItem(lv)
    self.materialId = self.cardLevelcfg[lv].material[1]
    --self.materialCount = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Material, self.materialId)
    self.coinLimit = nextItemLimit.CoinLimit - currentItemLimit.CoinLimit
    self.expLimit = nextItemLimit.ExpLimit - currentItemLimit.ExpLimit
    self.materialLimt = nextItemLimit.MaterialLimit - currentItemLimit.MaterialLimit
end
