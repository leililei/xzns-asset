---数据解析完成
function StoneModel:ParseData(data)
    self.curr_unlock_number = 0
    self.up_num_ke = self:GetMinUnlockNumber()
    --神石等级6
    self.stone_level = data.level <= maxLevel and data.level or maxLevel
    --神石解锁的数量
    self:SetCurrentGrid(data.unlock_num)
    self:SetAllGrid()
    self:InitStoneLockGridIndex()
    local tempdata = data.core_uid or {}
    -- 设置神石的状态
    self:InitStoneEnum(tempdata)
    --神石核心三人的uid
    self:SetAllCore(tempdata)
    --神石卡牌放置区域的uid`3
    self.uid_list = {}
    self:SetAllKacao(data.uid_list)
    ---有多少卡牌 达到了星级的 限制
    self.max_sids = data.max_sids or {}
    ---神石养成次数
    self.stoneUpNum = data.up_num or 0
    self:SetShenShiLeveLimit()
    if (self:GetMinUnlockNumber() + self:GetCurrentGrid()) <= 9 then
        self.show_grid_number = 9 + hexinNumber
    elseif (self:GetMinUnlockNumber() + self:GetCurrentGrid()) == self:GetMaxGridNumber() then
        self.show_grid_number = self:GetMinUnlockNumber() + self:GetCurrentGrid()
    else
        self.show_grid_number = self:GetMinUnlockNumber() + self:GetCurrentGrid() + hexinNumber
    end
    --初始化所有格子
    self:CheckIsUnlockStoneStateOnClick()
    self:InitAllGrid()
    if _G.table.isEmptyOrNil(tempdata) then
        self:HexinFirstShangZhen()
    else
        if self:GetStoneEnum() == _G.StoneEnum.zero then
        else
            self:SetAllGridCardLevel(self:InitStoneCardLevel())
        end
    end
    self:SetUnnum(data.uid_list, data.core_uid)
    self:SetCanUpNumber(data.uid_list, data.core_uid)

    self.super.ParseData(self)
end
