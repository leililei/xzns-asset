function StoneModel:GetLevelofCoreUids()
    local lv = 0
    local temp = {}
    local data = {}
    for i = 1, #self.core_uid do
        if self.core_uid[i]:GetCarduid() ~= 0 then
            data = {}
            local card = self:GetUidToCard(self.core_uid[i]:GetCarduid())
            data.index = self.core_uid[i]:GetCardHexinIndex()
            data.card = card
            _G.table.insert(temp, data)
        end
    end
    _G.table.sort(
        temp,
        function(a, b)
            if a.card.lv < b.card.lv then
                return true
            elseif a.card.lv == b.card.lv and a.card.cfg.Order < b.card.cfg.Order then
                return true
            end
            return false
        end
    )
    lv = temp[1].card.lv
    return lv, temp[1].card.uid, temp[1].index
end
