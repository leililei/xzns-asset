function StoneModel:SetAllKacao(data)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    _G.table.sort(
        data,
        function(a, b)
            return a.index < b.index
        end
    )
    for i = 1, #data do
        self:SetOneKacaoData(data[i].index, data[i])
        self:SetLockGridIndex(data[i].index, data[i].index)
    end
end
