---设置 神石 卡槽中所有卡牌的等级
function StoneModel:SetAllGridCardLevel(level)
    local grid = {}
    local number = 0
    if self.StoneEnum == _G.StoneEnum.secend then
        number = number + hexinNumber
    end
    for i = 1, self.curr_unlock_number + self.minUnlockNumber + number do
        grid = self:GetOneGrid(i)
        if grid:GetCarduid() ~= 0 then
            grid:SetCardLevel(level, self:GetStoneEnum())
        end
    end

    require "PopUpGiftBagModel":GetInstance():IsRecUpLevel(self.stone_level)
end
