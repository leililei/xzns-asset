function StoneModel:HexinFirstShangZhen()
    local cards_bag = self:RepeatCardDatasBag()
    local pbData = {
        type = _G.StonePosType.PosTwo,
        index = {},
        cd = 0
    }
    if not _G.table.isEmptyOrNil(cards_bag) then
        for i = 1, hexinNumber do
            if not _G.table.isEmptyOrNil(cards_bag[i]) then
                local data = {}
                data.index = i
                data.uid = cards_bag[i].uid
                _G.table.insert(pbData.index, data)
            end
        end
    end
    if _G.table.isEmptyOrNil(pbData.index) then
        return
    end
    require("CardShenShiNet"):GetInstance():AccessUpCard(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            local count = 0
            for i = 1, #pbData.index do
                local data = {
                    uid = pbData.index[i].uid,
                    cd = 0
                }
                local hexinindex = pbData.index[i].index
                self:SetOneCoreData(hexinindex, data)
                if pbData.index[i].uid > 0 then
                    count = count + 1
                end
            end
            --设置神石的状态
            local flag = false
            if count < hexinNumber then
                flag = true
            end
            if flag then
                self:SetStoneEnum(_G.StoneEnum.zero)
            else
                self:SetStoneEnum(_G.StoneEnum.first)
            end
            self:SetAllGridCardLevel(self:InitStoneCardLevel())
            _G.Events:GetInstance():Broadcast(_G.eShenshiEvents.UpCoreCard, pbData.index)
        end
    )
end
