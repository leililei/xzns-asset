function StoneModel:SetAllCore(data)
    if _G.table.isEmptyOrNil(data) then
        for i = 1, hexinNumber do
            local da = {
                uid = 0,
                cd = 0,
                index = i
            }
            self:SetOneCoreData(i, da)
        end
        return
    end
    for i = 1, hexinNumber do
        if not _G.table.isEmptyOrNil(data[i]) then
            self:SetOneCoreData(data[i].index, data[i])
        else
            local da = {
                uid = 0,
                cd = 0,
                index = i
            }
            self:SetOneCoreData(i, da)
        end
    end
end
