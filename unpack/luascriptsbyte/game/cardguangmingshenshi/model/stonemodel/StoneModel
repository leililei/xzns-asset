---设置可上阵的卡牌个数
function StoneModel:SetCanUpNumber(uid_list, core_uid)
    local num = 0
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        if _G.table.isEmptyOrNil(core_uid) then
            num = hexinNumber
        else
            -- local num1 = 0
            -- for i = 1, #core_uid do
            --     if core_uid[i].uid == 0 and core_uid[i].cd > 0 then
            --         num1 = num1 + 1
            --     end
            -- end
            num = hexinNumber - #core_uid
        end
    end
    if _G.table.isEmptyOrNil(uid_list) then
        num = num + self:GetCurrentGrid() + self:GetMinUnlockNumber()
    else
        -- local num2 = 0
        -- for i = 1, #uid_list do
        --     if uid_list[i].uid ~= 0 and uid_list[i].cd > 0 then
        --         num2 = num2 + 1
        --     end
        -- end
        num = num + self:GetCurrentGrid() + self:GetMinUnlockNumber() - #uid_list
    end
    self.up_num_ke = num
end
--- 这是已上阵的卡牌个数
function StoneModel:SetUnnum(uid_list, core_uid)
    local num = 0
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        if _G.table.isEmptyOrNil(core_uid) then
            num = hexinNumber
        else
            for i = 1, #core_uid do
                if core_uid[i].uid ~= 0 then
                    num = num + 1
                end
            end
        end
    end
    if _G.table.isEmptyOrNil(uid_list) then
        self.up_num = num
    else
        for i = 1, #uid_list do
            if uid_list[i].uid ~= 0 then
                num = num + 1
            end
        end
    end
    self.up_num = num
end
---检测 解锁功能按钮
function StoneModel:CheckIsUnlockStoneStateOnClick()
    --检测是否已达到 限制等级
    local flag = true
    local count = 0
    for i = 1, #self.core_uid do
        if self.core_uid[i]:GetCarduid() == 0 then
            flag = false
            break
        elseif self.core_uid[i]:GetCard().lv < self:GetMaxLimitLevel() then
            flag = false
        elseif self.core_uid[i]:GetCard().lv >= self:GetMaxLimitLevel() then
            count = count + 1
        end
    end
    if count < 5 then
        flag = false
    end
    if flag and self.stone_level < self:GetMaxLimitLevel() then
        self.unlockLevel = _G.StoneEnum.secend
    else
        self.unlockLevel = _G.StoneEnum.first
    end
end
