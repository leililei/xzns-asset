---设置 单个所有卡槽的数据
function StoneModel:SetOneKacaoData(index, data)
    if _G.table.isEmptyOrNil(data) then
        return
    end
    local grid = StoneGridData.New()
    if data.uid == 0 and data.lasttime == 0 then
        grid:ParseInitMsg(data, _G.GridDataEnum.add)
    elseif data.uid ~= 0 then
        grid:ParseInitMsg(data, _G.GridDataEnum.head)
    elseif data.lasttime ~= 0 then
        grid:ParseInitMsg(data, _G.GridDataEnum.cooling)
    end
    grid:SetCardKaCaoIndex(data.index)
    grid:SetGridCardPosEnum(_G.GridCardPosEnum.kacao)
    grid:SetCardStonePos(_G.GridCardPosEnum.kacao)
    grid:SetCardStone(self:GetStoneEnum())
    _G.table.insert(self.uid_list, grid)
end
function StoneModel:GetOneKacaoData(index, data)
    return self.uid_list[index]
end
