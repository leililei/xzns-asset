end
---初始化 神石的所有
function StoneModel:InitAllGrid()
    local gridindex = 0
    if _G.table.isEmptyOrNil(self.uid_list) then
        gridindex = #self.uid_list
    end
    local lockNumber = self:GetMinUnlockNumber() + self:GetCurrentGrid()
    local number = 0
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        for i = 1, #self.core_uid do
            local temp = self.core_uid[i]
            self.allGrid[i] = temp
            self.allGrid[i]:SetGridIndex(i)
            self.allGrid[i].isKacaoOrhexin = false
        end
        number = hexinNumber
    end
    local lv = self:InitStoneCardLevel()
    for i = number + 1, lockNumber + number do
        self.allGrid[i]:SetGridDataEnum(_G.GridDataEnum.add)
        self.allGrid[i]:SetCardKaCaoIndex(i - number)
        self.allGrid[i]:SetGridCardPosEnum(_G.GridCardPosEnum.kacao)
    end
    for j = lockNumber + number + 1, self:GetMaxGridNumber() + number do
        self.allGrid[j]:SetCardKaCaoIndex(j - number)
        self.allGrid[j]:SetGridDataEnum(_G.GridDataEnum.unlock)
        self.allGrid[j]:SetGridCardPosEnum(_G.GridCardPosEnum.kacao)
    end
    if not _G.table.isEmptyOrNil(self.uid_list) then
        _G.table.sort(
            self.uid_list,
            function(a, b)
                return a:GetCardKaCaoIndex() < b:GetCardKaCaoIndex()
            end
        )
        for i = 1, #self.uid_list do
            local tempIndex = self.uid_list[i]:GetCardKaCaoIndex()
            self.allGrid[tempIndex + number] = self.uid_list[i]
            self.allGrid[tempIndex + number]:SetGridIndex(tempIndex)
        end
    end
end
