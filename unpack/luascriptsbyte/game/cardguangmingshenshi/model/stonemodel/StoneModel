---设置单个核心卡牌的数据,和卡牌的位置
---@param index number 核心的下标
---@param data number 核心的 数据 cd uid index
function StoneModel:SetOneCoreData(index, data)
    local grid = StoneGridData.New()
    if data.uid == 0 and data.cd == 0 then
        grid:ParseInitMsg(data, _G.GridDataEnum.add)
    elseif data.cd ~= 0 then
        grid:ParseInitMsg(data, _G.GridDataEnum.cooling)
    else
        grid:ParseInitMsg(data, _G.GridDataEnum.head, _G.GridCardPosEnum.hexin, self:GetStoneEnum())
    end
    grid:SetCardHeXinIndex(index)
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        grid:SetCardLevel(self.stone_level, self:GetStoneEnum())
    end
    grid:SetCardHeXinIndex(index)
    grid:SetGridCardPosEnum(_G.GridCardPosEnum.hexin)
    grid:SetCardStonePos(_G.GridCardPosEnum.hexin)
    grid:SetCardStone(self:GetStoneEnum())
    local cardGrid, ind = self:GetOneCoreData(index)
    if _G.table.isEmptyOrNil(cardGrid) then
        self.core_uid[index] = grid
    else
        self.core_uid[ind] = grid
    end
end
