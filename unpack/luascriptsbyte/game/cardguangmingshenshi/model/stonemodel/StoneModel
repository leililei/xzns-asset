function StoneModel:SetAllGrid()
    local grid = {}
    self.allGrid = {}
    local data = {
        cd = 0,
        uid = 0,
        index = 0
    }
    local number = self:GetMaxGridNumber()
    if self.stone_level > 0 then
        number = number + 5
    end
    for i = 1, number do
        grid = StoneGridData.New()
        grid:Parse(data)
        grid:SetGridDataEnum(_G.GridDataEnum.unlock)
        grid:SetGridIndex(i)
        grid:SetCardKaCaoIndex(i)
        grid.isKacaoOrhexin = true
        self.allGrid[i] = grid
    end
end
