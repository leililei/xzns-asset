---解锁格子 消耗材料
function StoneModel:GetunlockMaterialsNumber(gridIndex)
    local materialLimits = _G.ConfigManager.discrete_cfg[102504][1]
    local countLimit = _G.table.count(materialLimits)
    local limit
    local number = 0
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        number = hexinNumber
    end
    gridIndex = gridIndex - self:GetMinUnlockNumber() - number
    if gridIndex >= countLimit then
        limit = materialLimits[countLimit]
    else
        limit = materialLimits[gridIndex]
    end
    return limit
end
