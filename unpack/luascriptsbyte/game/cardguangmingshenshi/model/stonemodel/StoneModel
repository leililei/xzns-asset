---设置神石第二阶段 等级上限 （升星时调用） 达到星级 增加等级
---@param sid number 卡牌的sid
---@param star number 卡牌的星级
function StoneModel:AddMaxSids(sid, star)
    if not self:CheckFunctionOpen() then
        return
    end
    --卡牌星级 小于限制的条件
    if star < self.startLimit then
        return
    end
    if _G.table.isEmptyOrNil(self.max_sids) then
        _G.table.insert(self.max_sids, sid)
        self:SetShenShiLeveLimit()
        return
    end
    for i = 1, #self.max_sids do
        if self.max_sids[i] == sid then
            return
        end
    end
    _G.table.insert(self.max_sids, sid)
    self:SetShenShiLeveLimit()
end
