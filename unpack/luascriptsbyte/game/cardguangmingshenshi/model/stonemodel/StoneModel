function StoneModel:CheckIsCanUnLock()
    if _G.table.isEmptyOrNil(self.core_uid) then
        return false
    end
    if #self.core_uid < 5 then
        return false
    end
    for _, v in pairs(self.core_uid) do
        if v:GetCarduid() > 0 then
            local card = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, v:GetCarduid())
            if not _G.table.isEmptyOrNil(card) then
                if card:GetLevel() < self:GetMaxLimitLevel() then
                    return false
                end
            else
                return false
            end
        else
            return false
        end
    end
    return true
end
---设置 卡槽中卡牌的状态
function StoneModel:SetAllGridCardStone()
    local core_uid = self:GetAllCore()
    local flag = false
    for i = 1, #core_uid do
        if core_uid[i]:GetCarduid() == 0 then
            flag = true
            break
        end
    end
    local temp = _G.StoneEnum.zero
    if flag then
        temp = _G.StoneEnum.zero
    else
        temp = _G.StoneEnum.first
    end
    local number = 0
    if self:GetStoneEnum() == _G.StoneEnum.secend then
        temp = _G.StoneEnum.secend
        number = number + hexinNumber
    end
    self:SetStoneEnum(temp)
    local num = self:GetCurrentGrid() + self:GetMinUnlockNumber() + number
    local allGrid = self:GetAllGrid()
    for i = 1, num do
        if allGrid[i]:GetCarduid() ~= 0 then
            allGrid[i]:SetCardStone(temp)
        end
    end
    if temp == _G.StoneEnum.zero then
    else
        self:SetAllGridCardLevel(self:InitStoneCardLevel())
    end
end
