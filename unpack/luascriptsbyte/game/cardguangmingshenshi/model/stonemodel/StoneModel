function StoneModel:RepeatCardDatasBagAndKaCao()
    local card_bag = {}
    local cars = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for key, value in pairs(cars) do
        if value.shenshiPosType == _G.GridCardPosEnum.zero or value.shenshiPosType == _G.GridCardPosEnum.kacao then
            _G.table.insert(card_bag, value)
        end
    end
    _G.SortList(
        card_bag,
        function(card)
            local num = 10
            if card.shenshiPosType ~= 0 then
                num = 9
            end
            return card:GetLv_Old(), num, card.star, card.uid
        end
    )
    return card_bag
end
----卡牌背包 不包括 神石核心 和 神石卡槽的 卡牌
function StoneModel:RepeatCardDatasBag()
    local cards_bag = {}
    local cars = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for key, value in pairs(cars) do
        _G.table.insert(cards_bag, value)
    end
    _G.table.sort(
        cards_bag,
        function(a, b)
            if a.lv > b.lv then
                return true
            elseif a.lv == b.lv and a.cfg.Order > b.cfg.Order then
                return true
            end
            return false
        end
    )
    return cards_bag
end

