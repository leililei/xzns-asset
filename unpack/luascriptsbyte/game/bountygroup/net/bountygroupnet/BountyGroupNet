local BaseGameNet = require("BaseGameNet")

---@class BountyGroupNet : BaseGameNet 描述
---@field GetInstance fun():BountyGroupNet
local BountyGroupNet = _G.BaseClass("BountyGroupNet", BaseGameNet)

---请求
---@param pbData table PB数据
---@param item net_map 网络协议
---@param callback function 完成回调
function BountyGroupNet:GetData(pbData, item, callback)
    if pbData == nil then
        pbData = self:GetEmptyPB()
    end
    local port = BaseGameNet:Access(item, pbData, _G.handler(self, self.GetDataCall))
    self.Call[port] = callback
end
---讨伐备战信息
---@param callback function 完成回调
function BountyGroupNet:GetBountyData(callback)
    local item = _G.ConfigManager.net_map.game_bounty_group_info
    self:GetData(nil, item, callback)
end
---派遣阵容
---@param pbData c2s_bounty_group_put
function BountyGroupNet:BountyGroupPut(pbData, callback)
    local item = _G.ConfigManager.net_map.game_bounty_group_put
    self:GetData(pbData, item, callback)
end

---描述：讨伐结算信息
function BountyGroupNet:BountyGrouBoxInfo(callback)
    local item = _G.ConfigManager.net_map.game_bounty_group_box_info
    self:GetData(nil, item, callback)
end

---领取奖励
---@param pbDatac2s_bounty_group_award
function BountyGroupNet:BountyGrouPaward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_bounty_group_award
    self:GetData(pbData, item, callback)
end

---获取上一次团队讨伐信息
function BountyGroupNet:BountyGrouLastInfo(callback)
    local item = _G.ConfigManager.net_map.game_bounty_group_last_info
    self:GetData(nil, item, callback)
end

---玩家翻宝箱添加后端主动推的网络消息监听接口
function BountyGroupNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.get_box_award.Cmd, self.P2C_Friendinfo)
end
---后端主动推送的数据
function BountyGroupNet:P2C_Friendinfo(data)
    require("BountyGroupModel"):GetInstance():BoxAward(data)
end
---请求回调
---@param port number 中文描述
---@param data table 返回PB数据
---@param error string 错误信息
function BountyGroupNet:GetDataCall(port, data, error)
    if error then
        if _G.AppSetting.DEBUG then
            _G.LogError("BountyGroupNet :" .. error)
        end
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---析构函数
function BountyGroupNet:Dispose()
end

---@return BountyGroupNet
return BountyGroupNet
