---@class BountyGroupModel : GameDataModelBase
---@field GetInstance fun():BountyGroupModel
local BountyGroupModel = _G.BaseClass("BountyGroupModel", _G.GameDataModelBase)

---创建对象时,入口构造函数
function BountyGroupModel:__init()
    self.state = {
        --可布阵状态
        KeBuZheng = 1,
        --讨伐中
        TaoFaZho = 2,
        --展示中
        ZhanShi = 3
    }
    self.getSids = {}
    self.QuestDataPool = {}
    --讨伐开启time
    self.KaiQiTime = _G.ConfigManager.discrete_cfg[106301][1][1]
    --讨伐开启持续time
    self.ChiXuTime = _G.ConfigManager.discrete_cfg[106302][1][1]
    -- self.curFunctionOpenID = 12
end
---剩余时间
function BountyGroupModel:ShengYuTime()
    local TaoFa = self.KaiQiTime * 3600

    return TaoFa - _G.TimeUtil.GetSecondsOfDay()
end
function BountyGroupModel:TiemJiShi()
    if require("SociatyManager"):GetInstance():GetGuildUid() == 0 or self:BoolKaiQi() == self.state.ZhanShi then
        return
    end
    --讨伐倒计时
    self.timeShengYu = (self.KaiQiTime * 3600) + self.ChiXuTime - _G.TimeUtil.GetSecondsOfDay()

    if self.ShengYuTimers == nil then
        self.ShengYuTimers = _G.TimerManager:GetInstance():GetTimer(1, self.PoolTimer, self, false, false, true)
        self.ShengYuTimers:Start()
    end
end

---讨伐中倒计时--
function BountyGroupModel:PoolTimer(elapsed)
    self.timeShengYu = self.timeShengYu - elapsed
    if self.timeShengYu < 0 then
        self.ShengYuTimers:Stop()
        self:Info(_G.handler(self, self.ParseData))
        return
    end
end

---战斗力 数字计算
function BountyGroupModel.NumberToUnitStr_CardFightNum(num)
    -- 小数点规则
    -- 保留一位小数 四舍五入
    -- 10.56亿 算10.6亿
    --num = _G.GameUtil.FormatNum(num)
    local str = ""
    local len = string.len(num)
    --个十百千万十百千亿
    if len > 8 then
        --num = num + 5000000
        num = num * 0.00000001
        --len = string.len(num)
        str = string.sub(num, 1, len - 6)
        str = str .. _G.LangUtil.GetLangPackValue(90023100002)
    elseif len > 4 then
        --num = num + 500
        num = num * 0.0001
        --len = string.len(num)
        str = string.sub(num, 1, len - 2)
        str = str .. _G.LangUtil.GetLangPackValue(90023100001)
    else
        str = tostring(num)
    end
    return str
end
---判断开启状态
function BountyGroupModel:BoolKaiQi()
    local state = self.state.ZhanShi
    local TaoFa = self.KaiQiTime * 3600
    if _G.TimeUtil.GetSecondsOfDayOf6Hour() >= 0 then
        if _G.TimeUtil.GetSecondsOfDay() <= TaoFa then
            state = self.state.KeBuZheng
        elseif _G.TimeUtil.GetSecondsOfDay() <= TaoFa + self.ChiXuTime then
            state = self.state.TaoFaZho
        end
    end
    return state
end

function BountyGroupModel:GetDataFormServer()
    --self:GetBountyData(_G.handler(self, self.ParseData))
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.BountyGroupView.Name)
    if view ~= nil then
        view.View:HuoQu()
    else
        self:Info(_G.handler(self, self.ParseData))
    end
end

function BountyGroupModel:ParseData(data)
    if self.endCallback then
        self.endCallback()
    end
    self.endCallback = nil
end
--奖励未领取红点
function BountyGroupModel:JiangLiHongDian()
    if self:BoolKaiQi() ~= self.state.TaoFaZho and self.info ~= nil and self.info.is_award == 0 then
        return true
    end
    return false
end
---布阵红点
function BountyGroupModel:ListHongDian()
    if self:BoolKaiQi() == self.state.KeBuZheng and self.info ~= nil and self.info.arrays == nil then
        return true
    end
    return false
end
---销毁对象时,析构函数
function BountyGroupModel:Dispose()
end
---描述：获取讨伐备战信息
function BountyGroupModel:Info(Call)
    if require("SociatyManager"):GetInstance():GetGuildUid() ~= 0 then
        require("BountyGroupNet"):GetInstance():GetBountyData(
            function(msg)
                self.info = msg.info
                self.box_info = msg.box_info
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BountyGroupLineup.id)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BountyGroupCensus.id)
                self:TiemJiShi()
                if Call ~= nil then
                    Call(msg)
                end
            end
        )
    else
        if Call ~= nil then
            Call()
        end
    end
end

