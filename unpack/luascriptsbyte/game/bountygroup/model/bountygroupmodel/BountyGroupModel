---监听公会玩家翻宝箱推送
function BountyGroupModel:BoxAward(award)
    if
        require("SociatyManager"):GetInstance():GetGuildUid() ~= 0 and
            award.guild_uid == require("SociatyManager"):GetInstance():GetGuildUid()
     then
        local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.BountyGroupSettlementView.Name)
        if view ~= nil then
            view.View:BoxAward(award)
        else
            local i_box = {}

            i_box.index = award.index
            i_box.role_info = award.role_info
            i_box.box_id = award.box_id
            if self.box_info.box_info == nil then
                self.box_info.box_info = {}
            end
            _G.table.insert(self.box_info.box_info, i_box)
        end
    end
end
