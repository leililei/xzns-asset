local BountyGroupUpgradeView = _G.BaseClass("BountyGroupUpgradeView", _G.UIBaseView)
--_G.BountyGroupUpgradeView = BountyGroupUpgradeView

function BountyGroupUpgradeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.info = require("BountyGroupModel"):GetInstance().info
    self:InitElement()
end

---界面的入口函数
function BountyGroupUpgradeView:OnCreate()
end

function BountyGroupUpgradeView:InitElement()
    local power = _G.ConfigManager.bounty_group_cfg[self.info.lv]
    local powerup = _G.ConfigManager.bounty_group_cfg[self.info.lv + 1]
    local lv = _G.LangUtil.GetLangPackValue(90026200009, self.info.lv)
    local lvUp = _G.LangUtil.GetLangPackValue(90026200009, self.info.lv + 1)

    self.go_table.aortext_title.text = lv
    self.go_table.aortext_LvL.text = lv
    self.go_table.aortext_LvR.text = lvUp
    local GetSociatyLevel = require("SociatyManager"):GetInstance():GetSociatyLevel()

    local max = 608
    local num, maxs, numr, maxsr

    if powerup ~= nil then
        self.go_table.obj_contentR:SetActiveE(1)
        self.go_table.aortext_TextR:SetActiveE(0)
        self.go_table.obj_down:SetActiveE(1)
        self.go_table.aortext_Level:SetActiveE(0)
        num = GetSociatyLevel / power.guild_level
        numr = self.info.fight_times / power.num_killed
        maxs = power.guild_level
        maxsr = power.num_killed
        if num > 1 then
            num = 1
        end
        if numr > 1 then
            numr = 1
        end
        self.go_table.aorimage_GongHuiLevel:SetRectTransformSize(num * max or 0, 13)
        self.go_table.aorimage_GongHuiLevelGH:SetRectTransformSize(numr * max or 0, 13)
        self.go_table.aortext_press.text = GetSociatyLevel .. "/" .. maxs
        self.go_table.aortext_pressGH.text = self.info.fight_times .. "/" .. maxsr
        self:LvInfoR()
    else
        self.go_table.obj_contentR:SetActiveE(0)
        self.go_table.aortext_TextR:SetActiveE(1)
        self.go_table.obj_down:SetActiveE(0)
        self.go_table.aortext_Level:SetActiveE(1)
    end
    self:LvInfo()
end

--左边界面显示
function BountyGroupUpgradeView:LvInfo()
    local power = _G.ConfigManager.bounty_group_cfg[self.info.lv]
    self.JiangLiL = {}

    self.go_table.aortext_LvL.text = _G.LangUtil.GetLangPackValue(90026200009, self.info.lv)
    --self.go_table.aortext_contentL1.text = _G.LangUtil.GetLangPackValue(90021800173, power.professional)
    self.go_table.aortext_contentL2.text = _G.LangUtil.GetLangPackValue(90021800174, power.condition[1])
    self.go_table.scrollloophorizontal_jiangLiL:InitItemData(0, _G.handler(self, self.JiangLiList))

    local i = 1
    for key, value in pairs(power.precious_preview) do
        for k, v in pairs(value) do
            _G.table.insert(self.JiangLiL, {v, i})
        end
        i = i + 1
    end

    self.go_table.scrollloophorizontal_jiangLiL:UpdateCount(#self.JiangLiL)
end

--右边界面显示
function BountyGroupUpgradeView:LvInfoR()
    local power = _G.ConfigManager.bounty_group_cfg[self.info.lv + 1]
    self.JiangLiR = {}
    --self.go_table.aortext_LvR.text = _G.LangUtil.GetLangPackValue(90026200009, self.info.lv)
    --self.go_tab                    le.aortext_contentR1.text = _G.LangUtil.GetLangPackValue(90021800173, power.professional)
    self.go_table.aortext_contentR2.text = _G.LangUtil.GetLangPackValue(90021800174, power.condition[1])
    self.go_table.scrollloophorizontal_jiangLiR:InitItemData(0, _G.handler(self, self.JiangLiListR))
    local i = 1
    for key, value in pairs(power.precious_preview) do
        for k, v in pairs(value) do
            _G.table.insert(self.JiangLiR, {v, i})
        end
        i = i + 1
    end
    self.go_table.scrollloophorizontal_jiangLiR:UpdateCount(#self.JiangLiR)
end

---任务item刷新
function BountyGroupUpgradeView:JiangLiList(index, listView2)
    if index < 0 then
        return
    end

    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.DianJiXiangYing, x))
    local data = self.JiangLiL[x]

    if data == nil then
        tb.gameObject:SetActiveE(0)
    else
        -- tb.aortext_name.text = _G.string.format(_G.LangUtil.GetLangPackValue(data.max_rank), data.min_rank)
        tb.gameObject:SetActiveE(1)
        self:CareatItem({data[1], 0}, false, tb.obj_item)
    end
    return tb
end
---任务item刷新
function BountyGroupUpgradeView:JiangLiListR(index, listView2)
    if index < 0 then
        return
    end

    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.DianJiXiangYing, x))
    local data = self.JiangLiR[x]

    if data == nil then
        tb.gameObject:SetActiveE(0)
    else
        -- tb.aortext_name.text = _G.string.format(_G.LangUtil.GetLangPackValue(data.max_rank), data.min_rank)
        tb.aorimage_Xin:SetActiveE(0)
        tb.aorimage_Tag:SetActiveE(0)
        if data[2] == 1 then
            tb.aorimage_Xin:SetActiveE(1)
        elseif data[2] == 2 then
            tb.aorimage_Tag:SetActiveE(1)

        -- body
        end
        tb.gameObject:SetActiveE(1)
        self:CareatItem({data[1], 0}, false, tb.obj_item)
    end
    return tb
end
function BountyGroupUpgradeView:CareatItem(data, isGou, Parent, insId, key)
    local item = require "BaseAwardNewItem".New(Parent, nil, nil, Parent)

    item:ShowWithID(data)

    --end
end
