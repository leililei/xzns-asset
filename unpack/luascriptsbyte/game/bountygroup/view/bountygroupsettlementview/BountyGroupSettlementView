function BountyGroupSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemTable = {}
    self.TaskRewardInfo = {}
    self.BoxList = {}
    self.info = require("BountyGroupModel"):GetInstance().info
    self.tb = _G.GetAutoGoTable(self.go_table.obj_currentRanks)

    self.PaiHangBang = false
    self.DianJI = false
end

---界面的入口函数
function BountyGroupSettlementView:OnCreate(call)
    self.Bg = {}
    self.go_table.scrollloopvectical_ZhanDouJiangLi:InitItemData(0, _G.handler(self, self.ZhanDouRefreshList))
    self.call = call
    self:HuoQu()
end
function BountyGroupSettlementView:HuoQu()
    self.bounty = require("BountyGroupModel"):GetInstance().box_info
    self:InitElement()
    self.go_table.obj_currentRanks:SetActiveE(0)
    self.go_table.scrollloopvectical_rankList:InitItemData(
        _G.table.count(self.bounty.ranks),
        _G.handler(self, self.RankList)
    )

    self.XianSiLingQu = true
    for key, value in pairs(self.bounty.ranks) do
        local data = value

        if data.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
            self.XianSiLingQu = false

            self.go_table.obj_currentRanks:SetActiveE(1)
            ---@type Params_PlayerHeadItem
            local Params_PlayerHeadItem = {}
            Params_PlayerHeadItem.frame = data.role_info.frame
            Params_PlayerHeadItem.lv = data.role_info.role_lv
            Params_PlayerHeadItem.style = data.role_info.style
            Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.role_info.style].ID

            --赋值单个
            self.tb.obj_rankBiaozhi:SetActiveE(0)
            self.tb.obj_mingci:SetActiveE(0)
            _G.UIUtils.SetPlayerHeadItemNew(self.tb.obj_HeadItemBase, data.role_info, 0.7, true, false, true)

            if key <= 3 then
                self.tb.obj_rankBiaozhi:SetActiveE(1)

                _G.GameUtil.SetActiveByCondition(self.tb.aorimage_paiming, true)
                if key == 1 then
                    self.tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
                    self.tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
                elseif key == 2 then
                    self.tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
                    self.tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
                elseif key == 3 then
                    self.tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
                    self.tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
                end
            else
                self.tb.obj_mingci:SetActiveE(1)

                self.tb.aortext_rank_paiming.text = key
            end
            self.tb.aortext_name.text = data.role_info.name
            self.tb.aorimage_jd:SetRectTransformSize(data.recent * 140 * 0.01 or 0, 14)

            self.tb.aortext_ranknumber.text = _G.string.format("%.1f", data.recent) .. "%"
        end
    end

    --require("BountyGroupModel"):GetInstance():BountyGrouBoxInfo(_G.handler(self, self.InitElement))
end
---刷新排名信息
function BountyGroupSettlementView:RankList(index, listView2)
    index = index + 1
    local tb = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.ClickHead))

    local data = self.bounty.ranks[index]
    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = data.role_info.frame
    Params_PlayerHeadItem.lv = data.role_info.role_lv
    Params_PlayerHeadItem.style = data.role_info.style
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.role_info.style].ID
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 0.7, true, false, true)
    tb.obj_rankBiaozhi:SetActiveE(0)
    tb.obj_mingci:SetActiveE(0)
    if index <= 3 then
        tb.obj_rankBiaozhi:SetActiveE(1)

        _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, true)
        if index == 1 then
            tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
            tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
        elseif index == 2 then
            tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
            tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
        elseif index == 3 then
            tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
            tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
        end
    else
        tb.obj_mingci:SetActiveE(1)

        tb.aortext_rank_paiming.text = index
    end
    tb.aortext_name.text = data.role_info.name
    tb.aorimage_jd:SetRectTransformSize(data.recent * 140 * 0.01 or 0, 14)
    tb.aortext_ranknumber.text = _G.string.format("%.1f", data.recent) .. "%"
end

function BountyGroupSettlementView:InitElement()
    local num = 0
    -- if self.bounty.ranks then
    --     for key, value in pairs(self.bounty.ranks) do
    --         if value.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
    --             num = value.recent
    --             self.PaiHangBang = false
    --         end
    --     end
    -- end
    -- self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(90026200020, num) .. "%"
    if self.info.is_award == nil or self.info.is_award == 0 then
        local data = {}
        data.type = 1
        data.index = 1
        require("BountyGroupModel"):GetInstance():BountyGrouPaward(
            data,
            function(mag)
                _G.StorageManager:GetInstance():ReceiveAwardData(mag)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, mag)
                self.info.is_award = 1
            end
        )
    end
    if self.nam == nil then
        self.go_table.scrollloopvectical_JiangLi:InitItemData(0, _G.handler(self, self.RefreshList))
        self.nam = true
    end
    self.go_table.scrollloopvectical_JiangLi:UpdateCount(#self.bounty.ranks)

    if self.PaiHangBang == false then
        self.PaiHangBang = true
        self:ZhanShiJiangLi()
    end
end
---展示奖励
function BountyGroupSettlementView:ZhanShiJiangLi()
    local bount = _G.ConfigManager.bounty_group_cfg[self.bounty.lv]
    self.jiangLiList = {}
    local t = 0
    local t1 = 1

    if self.bounty.count_power >= bount.power then
        t = 1
        t1 = 0
    end

    for key, value in pairs(bount.reward_base) do
        _G.table.insert(self.jiangLiList, {value, 1})
    end
    for key, value in pairs(bount.reward_extra) do
        local data = value

        self.go_table.aorimage_gous:SetActiveE(t)
        self.go_table.aorimage_gou:SetActiveE(t1)

        self:tanQuanDian(value, false, self.go_table.obj_Item)
    end

    self.go_table.scrollloopvectical_ZhanDouJiangLi:SetRectTransformSize(#self.jiangLiList * 100, 100)

    self.go_table.scrollloopvectical_ZhanDouJiangLi:UpdateCount(#self.jiangLiList)
end
function BountyGroupSettlementView:ZhanDouRefreshList(index, listView2)
    if index < 0 then
        return
    end
    local indexs = index + 1
    local data = self.jiangLiList[indexs]

    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.JiangLiZanSHi, data))
    --gotable.aorimage_tag:SetActiveE(data[2])
    if self.PaiHangBang then
        gotable.aorimage_gou:SetActiveE(1)
    else
        gotable.aorimage_gou:SetActiveE(0)
    end
    self:tanQuanDian(data[1], false, gotable.obj_Item)

    return gotable
end

function BountyGroupSettlementView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local indexs = index + 1
    local data = {}
    if self.bounty.box_info ~= nil then
        for key, value in pairs(self.bounty.box_info) do
            if value.index == indexs then
                data = value
            end
        end
    end

    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.JiangLiZanSHi, indexs))

    self:NewData(gotable, data)
    -- self.BoxList[indexs] = gotable
    return gotable
end

function BountyGroupSettlementView:NewData(gotable, data)
    local Bg = 3

    if gotable ~= nil then
        gotable.obj_putongbaoxiang:SetActiveE(0)

        gotable.obj_EFF:SetActiveE(0)
        gotable.aorimage_tag:SetActiveE(0)

        gotable.obj_gaojibaoxiang:SetActiveE(0)
        if data.role_info ~= nil then
            gotable.aorrawimage_BaoXiang:SetActiveE(0)

            if _G.ConfigManager.box_reward_cfg[data.box_id].effect == 1 then
                gotable.obj_EFF:SetActiveE(1)
                gotable.aorimage_tag:SetActiveE(1)
            else
                --gotable.aorimage_tag.SpriteName = BgImage[Bg]
                gotable.aorimage_tag:SetActiveE(1)
            end
            gotable.aorimage_Role:SetActiveE(1)
            gotable.obj_Item:SetActiveE(1)

            if self.Bg[data.index] ~= nil then
                if self.Bg[data.index] == 1 then
                    gotable.obj_putongbaoxiang:SetActiveE(1)
                elseif self.Bg[data.index] == 2 then
                    gotable.obj_gaojibaoxiang:SetActiveE(1)
                end
                self.Bg[data.index] = nil
            end
            gotable.aorimage_style.SpriteName = _G.ConfigManager.player_portrait_cfg[data.role_info.style].portrait1
            gotable.aortext_name.text = data.role_info.name

            if data.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
                self.DianJI = true
            end
            local box = _G.ConfigManager.box_reward_cfg[data.box_id]
            self:tanQuanDian(box.rewards[1], false, gotable.obj_Item)
            Bg = box.grade
        else
            -- self.Bg[data.index] = Bg
            gotable.aorrawimage_BaoXiang:SetActiveE(1)
            gotable.obj_Item:SetActiveE(0)
            gotable.aorimage_Role:SetActiveE(0)
        end
    else
        local i_box = {}
        local box = _G.ConfigManager.box_reward_cfg[data.box_id]

        self.Bg[data.index] = box.grade

        i_box.index = data.index
        i_box.role_info = data.role_info
        i_box.box_id = data.box_id
        if self.bounty.box_info == nil then
            self.bounty.box_info = {}
        end
        _G.table.insert(self.bounty.box_info, i_box)
        self.go_table.scrollloopvectical_JiangLi:UpdateItemSingle(data.index - 1)
    end
end
function BountyGroupSettlementView:JiangLiZanSHi(go, isOn, index)
    if self.DianJI or self.XianSiLingQu then
        return
    end
    local data = {}
    data.type = 2
    data.index = index
    require("BountyGroupModel"):GetInstance():BountyGrouPaward(
        data,
        function(mag)
            _G.StorageManager:GetInstance():ReceiveAwardData(mag)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, mag)
            --self:NewData(self.BoxList[data.index], data)
        end
    )
end
---物品内容选中显示
function BountyGroupSettlementView:tanQuanDian(data, isGou, Parent, firstCashs, insId)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            -- item:SetGou(isGou)
            if item.go_table.aorrawimage_Icon ~= nil then
                item.go_table.aorrawimage_Icon:SetGray(isGou)
            end

            -- item.go_table.aorimage_Color:SetGray(isGou)
            if item.go_table.aorimage_ColorBG ~= nil then
                item.go_table.aorimage_ColorBG:SetActiveE(0)
            end
            if item.go_table.aorimage_Color ~= nil then
                item.go_table.aorimage_Color:SetActiveE(0)
            end

            item:SetGrade(true)

            -- _G.DelayDo(
            --     1,
            --     function()
            --         -- body
            --     end
            -- )
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end
---后端主动推送的数据
function BountyGroupSettlementView:BoxAward(award)
    self:NewData(nil, award)
end
---按钮点击事件在这里派发
function BountyGroupSettlementView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Close" then
        if self.call ~= nil then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_way" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BountyGroupRankInfoView.Name)
    end
end

return BountyGroupSettlementView
