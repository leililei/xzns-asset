---按钮点击事件在这里派发
function BountyGroupView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    elseif name == "@_aorbtn_Xiaobaoxiang" then
        local bount = _G.ConfigManager.bounty_group_cfg[require("BountyGroupModel"):GetInstance().info.lv]

        local jiangLiList = {}
        for key, value in pairs(bount.reward_extra) do
            _G.table.insert(jiangLiList, value)
        end
        self:ShowItems(self.aorbtn_Xiaobaoxiang, jiangLiList)
    elseif name == "@_aorbtn_JiangLi" then
        local box_info = require("BountyGroupModel"):GetInstance().box_info

        if box_info == nil then
            _G.PopWindowManager:GetInstance():ShowAllTips(700104)
        elseif box_info.ranks == nil then
            _G.PopWindowManager:GetInstance():ShowAllTips(700101)
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BountyGroupSettlementView.Name,
                _G.handler(self, self.HuoQu)
            )
        end
    elseif name == "@_aorbtn_DengJi" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BountyGroupUpgradeView.Name)
    elseif name == "@_aorbtn_JueSei" then
        local BoolKaiQi = require("BountyGroupModel"):GetInstance():BoolKaiQi()

        if self.bounty.arrays ~= nil then
            return
        elseif BoolKaiQi == self.state.ZhanShi then
            _G.PopWindowManager:GetInstance():ShowAllTips(700105)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BountyGroupFormationView.Name,
            _G.handler(self, self.HuoQu)
        )
    elseif name == "@_aorbtn_TipsView" then
        --self.go_table.aorbtn_TipsView:SetActiveE(0)
    elseif name == "@_aorbtn_way" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 45)
    elseif name == "@_aorbtn_BaoXiang" then
        local box_info = require("BountyGroupModel"):GetInstance().box_info

        if box_info and box_info.ranks and _G.table.count(box_info.ranks) > 0 then
            local role = true
            for key, value in pairs(box_info.ranks) do
                if value.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
                    role = false
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.BountyGroupSettlementView.Name,
                        _G.handler(self, self.HuoQu)
                    )
                end
            end
            if role then
                self:BountyGrouPawardFun()
            end
        else
            self:BountyGrouPawardFun()
        end
        self.go_table.obj_BaoXiang:SetActiveE(0)
    elseif name == "@_aorbtn_OneKeyDeploy" then
        self:ShuXing()
    end
end

return BountyGroupView
