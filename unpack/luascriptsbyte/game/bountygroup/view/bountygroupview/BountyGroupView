            tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, #NowItems * 68)
        end

        --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, true)
    end

    local insId = self.go_table.obj_Parent:GetInstanceIDE()
    self.TaskRewardInfo[insId] = {}
    for i = 1, #cfg do
        local info = NowItems[i]
        local num = info[2]
        self.TaskRewardInfo[insId][info[1]] = num
        self:CareatItem(info, true, self.go_table.obj_Parent, self.itemTable)
    end
end

--生成item
function BountyGroupView:CareatItem(data, isGou, Parent, itemTable, shu)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    -- local has, value = self:HasItem(itemTable, Sid)
    -- if has then

    -- else
    --     table.insert(itemTable, {Sid, nil})
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.7)
                local insId = Parent:GetInstanceIDE()
                if self.TaskRewardInfo[insId] and self.TaskRewardInfo[insId][item.sid] then
                    _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    table.insert(itemTable, item)
                else
                    item.Despawn(item)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
        )
    end
    --end
end

