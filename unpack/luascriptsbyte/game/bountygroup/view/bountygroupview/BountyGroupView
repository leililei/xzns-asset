---判断是否显示一键上阵按钮
function BountyGroupView:ShowOneKeyDeployButton()
    self.go_table.aorbtn_OneKeyDeploy:SetActiveE(0)
    self.go_table.aortext_OneKeyDeploy:SetActiveE(0)

    if self.bounty.arrays ~= nil then
        return
    elseif not _G.GlobalConditionManager.CheckConditionByArray(_G.ConfigManager.discrete_cfg[106304]) then
        self.go_table.aortext_OneKeyDeploy:SetActiveE(1)
        local result =
            _G.ConfigManager.discrete_cfg[106304][1][2] -
            ((_G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time) / 86400)


        if result <= 1 then
            result = 1
        end
        self.go_table.aortext_OneKeyDeploy.text =
            _G.LangUtil.GetLangPackValue(90021800205, _G.math.floor(result))
        return
    end
    self.go_table.aorbtn_OneKeyDeploy:SetActiveE(1)
end

---主界面展示
function BountyGroupView:Main()
    self.go_table.obj_Main:SetActiveE(1)

    if self.bounty.is_award == 0 then
        local TaoFa = _G.ConfigManager.discrete_cfg[106301][1][1] * 3600
        if _G.TimeUtil.GetSecondsOfDayOf6Hour() >= 1 then
            if
                _G.TimeUtil.GetSecondsOfDay() >= TaoFa and
                _G.TimeUtil.GetSecondsOfDay() <= TaoFa + _G.ConfigManager.discrete_cfg[106302][1][1]
            then
            else
                self.go_table.obj_BaoXiang:SetActiveE(1)
            end
        else
            self.go_table.obj_BaoXiang:SetActiveE(1)
        end
    end
    self:ShowOneKeyDeployButton()
end

---讨伐中展示
-- 函数：TaoFaZho()
-- 功能：执行讨伐组操作
-- 参数：无
-- 返回值：无
function BountyGroupView:TaoFaZho()
    -- 关闭结算界面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BountyGroupSettlementView.Name)
    -- 关闭编队界面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BountyGroupFormationView.Name)
    -- 关闭排行榜界面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BountyGroupRankInfoView.Name)
    -- 关闭升级界面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BountyGroupUpgradeView.Name)

    -- 计算讨伐剩余时间
    self.timeShengYu =
        require("BountyGroupModel"):GetInstance().ChiXuTime -
        (_G.TimeUtil.GetSecondsOfDay() - (require("BountyGroupModel"):GetInstance().KaiQiTime * 3600))

    -- 更新剩余时间文本
    self.go_table.aortext_ShengYuTime.text = _G.TimeUtil.TimeToString(self.timeShengYu, 1)

    -- 启动定时器
    self:PoolTimer()
    if self.ShengYuTimers == nil then
        self.ShengYuTimers =
            _G.TimerManager:GetInstance():GetTimer(1, self.PoolTimer, self, false, false, true)
        self.ShengYuTimers:Start()
    end
end

---讨伐中倒计时
function BountyGroupView:PoolTimer(elapsed)
    self.timeShengYu = self.timeShengYu - (elapsed or 1)
    if self.timeShengYu < 0 then
        self:HuoQu()
        self.ShengYuTimers:Stop()
        return
    end
    local max = 887

    local num =
        (_G.TimeUtil.GetSecondsOfDay() - (require("BountyGroupModel"):GetInstance().KaiQiTime * 3600)) /
        require("BountyGroupModel"):GetInstance().ChiXuTime
    if num > 1 then
        num = 1
    end
    self.go_table.aorimage_ShengYucjjd:SetRectTransformSize(num * max or 0, 13)
    self.go_table.aortext_ShengYuTime.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.timeShengYu), 1)
end

