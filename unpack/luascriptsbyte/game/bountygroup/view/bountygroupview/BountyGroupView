    --     local x, y, z = go:GetPosition()
    --     --- 根据按钮 设置坐标
    --     self.go_table.obj_ItemTips:SetPosition(x, y, z)
    -- end

    local cfg = list
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("ActiveTaskView:ShowItems 未找到配置 boxIndex:%d"))
        end
        return
    end
