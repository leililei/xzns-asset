---界面的入口函数
function BountyGroupView:OnCreate()
    local bount = _G.ConfigManager.bounty_group_cfg[require("BountyGroupModel"):GetInstance().info.lv]

    local jiangLiList = {}
    for _, value in pairs(bount.reward_extra) do
        _G.table.insert(jiangLiList, value)
    end
    self:ShowItems(self.aorbtn_Xiaobaoxiang, jiangLiList)
end

function BountyGroupView:HuoQu()
    require("BountyGroupModel"):GetInstance():Info(_G.handler(self, self.InitElement))
end

function BountyGroupView:InitElement(mag)
    if mag.ack == 1 then
        self.bounty = require("BountyGroupModel"):GetInstance().info
        self:XianShiBoll()
    else
        self:Close()
    end
end

--当前显示界面判断
function BountyGroupView:XianShiBoll()
    if self.go_table == nil then
        self:Close()
        return
    end
    local BoolKaiQi = require("BountyGroupModel"):GetInstance():BoolKaiQi()
    self.go_table.obj_Main:SetActiveE(0)
    self.go_table.obj_JinDu:SetActiveE(0)
    self.go_table.obj_BaoXiang:SetActiveE(0)
    if BoolKaiQi == self.state.KeBuZheng then
        self:ZanDouZuangTai(self.state.KeBuZheng)

        self:Main()
    elseif BoolKaiQi == self.state.TaoFaZho then
        self.go_table.obj_JinDu:SetActiveE(1)
        self:TaoFaZho()
    elseif BoolKaiQi == self.state.ZhanShi then
        self:Main()
        self:ZanDouZuangTai(self.state.ZhanShi)
    end
    -- if self.bounty.fight_times == nil or self.bounty.fight_times < 1 then
    --     self.go_table.aorimage_jieSuan:SetActiveE(0)
    -- else
    --     self.go_table.aorimage_jieSuan:SetActiveE(1)
    -- end
end

---查询对应条件的英雄并上阵
function BountyGroupView:ShuXing()
    self.item = {}
    self.KaPao = { 0, 0, 0 }
    local kaPai = _G.StorageManager:GetInstance():GetMaxPowerCardByTarget(self.KaPao)
    local info = require("BountyGroupModel"):GetInstance().info
    self.go_table.aortext_Level.text = info.lv
    local bounty = _G.ConfigManager.bounty_group_cfg[info.lv].condition[2]
    self.XianShiList = {}
    for _, value in pairs(kaPai) do
        if value.star >= bounty and self:ToggLeMaskBool(value.cfg.Professional) == 0 then
            _G.table.insert(self.XianShiList, value)
        end
    end
    _G.SortList(
        self.XianShiList,
        function(a)
            return a.power, a.star, a.uid
        end
    )
    local dataLists = {}

    local power     = 0
    local condition = _G.ConfigManager.bounty_group_cfg[info.lv].condition[1]
    for key, value in pairs(self.XianShiList) do
        if key <= condition then
            _G.table.insert(dataLists, value.uid)
            power = power + value.power
        end
    end

    if #dataLists < _G.ConfigManager.bounty_group_cfg[info.lv].condition[1] then
        _G.PopWindowManager:GetInstance():ShowAllTips(700103)
        return
    end

    _G.PopWindowManager:GetInstance():ShowAllTips(
        700102,
        nil,
        function()
            local group = {}
            group.arrays = dataLists
            group.power = power + _G.math.floor(power)
            require("BountyGroupModel"):GetInstance():BountyGroupPut(
                group,
                function(mag)
                    self:HuoQu()
                end
            )
        end
    )
    -- self.go_table.scrollloopvectical_ZhanDouJiangLi:UpdateCount(#self.XianShiList)
end

---判断当前点击是否响应
function BountyGroupView:ToggLeMaskBool(id)
    for key, value in pairs(require("BountyGroupModel"):GetInstance().info.limit_list) do
        if value == id then
            return 0
        end
    end
    return 1
end

---战斗状态显示
function BountyGroupView:ZanDouZuangTai(type)
    if type == self.state.KeBuZheng then
        self.go_table.aorimage_txt_ji.SpriteName = WuXingImage[1]
        self.go_table.aorimage_YiShangZheng.SpriteName = WuXingImage[3]
        self.go_table.aortext_kai.text = _G.LangUtil.GetLangPackValue(90026200001)
        self:ZanDouTimer()
        if self.timeShengYus == nil then
            self.timeShengYus =
                _G.TimerManager:GetInstance():GetTimer(
                    1,
                    self.ZanDouTimer,
                    self,
                    false,
                    false,
                    true
                )
            self.timeShengYus:Start()
        end
    elseif type == self.state.ZhanShi then
        self.go_table.aorimage_txt_ji.SpriteName = WuXingImage[2]
        self.go_table.aorimage_YiShangZheng.SpriteName = WuXingImage[4]
        self.go_table.aortext_kai.text = _G.LangUtil.GetLangPackValue(90026200029)
        self:GetSixClockTimer()
        if self.GetSixClockTimers == nil then
            self.GetSixClockTimers =
                _G.TimerManager:GetInstance():GetTimer(
                    1,
                    self.GetSixClockTimer,
                    self,
                    false,
                    false,
                    true
                )
            self.GetSixClockTimers:Start()
        end
    end

    self.go_table.aortext_Level.text = self.bounty.lv
    self.go_table.aortext_WoFangZhanLi.text = _G.GameUtil.NumberToUnitStrFight(self.bounty.my_power)
    if self.arrays == nil then
        self.go_table.scrollloophorizontal_WoDi:InitItemData(0, _G.handler(self, self.RefreshList))

        self.arrays = true
    end

    self.go_table.scrollloophorizontal_WoDi:UpdateCount(_G.ConfigManager.bounty_group_cfg[self.bounty.lv].condition[1])
    if self.bounty.arrays ~= nil then
        self.go_table.aorimage_YiShangZheng:SetActiveE(1)
    else
        self.go_table.aorimage_YiShangZheng:SetActiveE(0)
    end

    local max = 336

    local num = self.bounty.count_power / _G.ConfigManager.bounty_group_cfg[self.bounty.lv].power
    if num > 1 then
        num = 1
    end
    if self.JueSei == nil then
        self.JueSei = true

        self.go_table.scrollloopvectical_JueSei:InitItemData(0, _G.handler(self, self.ItemDataAll_Index))
    end
    local power = _G.GameUtil.NumberToUnitStrFight(_G.ConfigManager.bounty_group_cfg[self.bounty.lv].power)
    --     require("BountyGroupModel"):GetInstance().NumberToUnitStr_CardFightNum(
    --     _G.ConfigManager.bounty_group_cfg[self.bounty.lv].power
    -- )
    local count_power = _G.GameUtil.NumberToUnitStrFight(self.bounty.count_power)
    -- require("BountyGroupModel"):GetInstance().NumberToUnitStr_CardFightNum(self.bounty.count_power)

    --self.go_table.aortext_CountZhanLi.text = count_power
    -- self.go_table.aortext_MaxZhanLi.text = power
    self.go_table.aortext_press.text = count_power .. "/" .. power
    self.go_table.aorimage_cjjd:SetRectTransformSize(num * max or 0, 15)
    local MD = require("SociatyData").GetMemberModule()
    if nil == MD then
        self.go_table.scrollloopvectical_JueSei:UpdateCount(0)
    else
        MD:SortMemberByOffline()

        self.Member = MD.Member

        _G.SortList(
            self.Member,
            function(a)
                local i = 0
                if self.bounty and self.bounty.groups then
                    -- body
                    for key, value in pairs(self.bounty.groups) do
                        if value.uid == a.Uid then
                            i = value.power
                            -- gotable.aortext_power:SetActiveE(1)
                        end
                    end
                end
                return i
            end
        )
        self.go_table.scrollloopvectical_JueSei:UpdateCount(#self.Member)
    end
end

function BountyGroupView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local indexes = index + 1

    local gotable = _G.GetAutoGoTable(listView2)

    if self.bounty.arrays ~= nil then
        local data = self.bounty.arrays[indexes]
        gotable.aorimage_role:SetActiveE(1)

        gotable.aorimage_role.SpriteName = _G.ConfigManager.card_cfg[data].Icon
    else
        gotable.aorimage_role:SetActiveE(0)
    end
    return gotable
end

function BountyGroupView:ItemDataAll_Index(index, listView2)
    if index < 0 then
        return
    end
    local indexes = index + 1
    local data = self.Member[indexes]

    local gotable = _G.GetAutoGoTable(listView2)

    gotable.aorimage_playerIcon.SpriteName = _G.ConfigManager.player_portrait_cfg[data.style].portrait1
    -- gotable.aortext_Lv.text = data.level
    -- gotable.aortext_power:SetActiveE(0)
    gotable.aortext_power.text = 0
    if self.bounty.groups == nil then
        -- body
        self.bounty.groups = {}
    end
    for key, value in pairs(self.bounty.groups) do
        if value.uid == data.Uid then
            gotable.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(value.power)
            -- gotable.aortext_power:SetActiveE(1)
        end
    end
    -- require("BountyGroupModel"):GetInstance().NumberToUnitStr_CardFightNum(data.power)
    gotable.aortext_name.text = data.name or data.Name
    return gotable
end

---讨伐中倒计时
function BountyGroupView:ZanDouTimer()
    local timeShengYu = require("BountyGroupModel"):GetInstance():ShengYuTime()
    if timeShengYu <= 0 then
        self.timeShengYus:Stop()
        self:HuoQu()
        return
    end
    self.go_table.aortext_Time.text = _G.TimeUtil.TimeToString(math.ceil(timeShengYu), 1)
end

---讨伐中倒计时
function BountyGroupView:GetSixClockTimer()
    local timeShengYu = _G.TimeUtil.GetSixClockTimer()
    if timeShengYu <= 0 then
        self.GetSixClockTimers:Stop()

        return
    end
    self.go_table.aortext_Time.text = _G.TimeUtil.TimeToString(timeShengYu, 1)
end

