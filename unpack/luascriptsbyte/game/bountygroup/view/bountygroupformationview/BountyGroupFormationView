        gotable.aorimage_gou:SetActiveE(1)
    else
        gotable.aorimage_gou:SetActiveE(0)
    end

    local insId = listView2:GetInstanceIDE()
    self:CareatItem(self.XianShiList[indexs], false, gotable.obj_playerIcon, insId)

    --gotable.aorimage_playerIcon.SpriteName = data.Icon
    -- gotable.aortext_Lv.text = self.XianShiList[indexs].lv
    gotable.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.XianShiList[indexs].power)
    --require("BountyGroupModel"):GetInstance().NumberToUnitStr_CardFightNum(self.XianShiList[indexs].power)
    self.item[self.XianShiList[indexs].sid] = gotable
    return gotable
end

function BountyGroupFormationView:CareatItem(data, isGou, Parent, insId, key)
    if self.TaskRewardInfo[insId] ~= nil then
        self.TaskRewardInfo[insId]:Show(data)
    else
        self.TaskRewardInfo[insId] = require "BaseAwardNewItem".New(Parent, nil, nil, Parent)

        self.TaskRewardInfo[insId]:Show(
            data,
            function(item)
                item.item:HideOrShowLevel(false)
                item.item:HideOrShowElements(false)
                item.item:HideOrShowStar(false)
            end
        )
    end
    --end
end

--判断当前英雄是否以选择
function BountyGroupFormationView:PanDuanXianShi(sid)
    for key, value in pairs(self.arrays) do
        if value == sid then
            return true
        end
    end
    return false
end

----界面点击事件
function BountyGroupFormationView:OnFriendListClick(go, isOn, index)
    local data = self.XianShiList[index]

    local datas = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)

    if self:ToggLeMaskBool(datas.cfg.Professional) == 1 then
        return
    end
    if self:PanDuanXianShi(data.uid) then
        if self.item[data.sid] ~= nil then
            self.item[data.sid].aorimage_gou:SetActiveE(0)
        end

        for key, value in pairs(self.arrays) do
            if value == data.uid then
                self.arrays[key] = nil
            end
        end
        self.power = self.power - data.power
    else
        local maxRen = _G.ConfigManager.bounty_group_cfg[self.info.lv].condition[1]

        if #self.arrays >= maxRen then
            return
        end
        if self.item[data.sid] ~= nil then
            self.item[data.sid].aorimage_gou:SetActiveE(1)
        end
        _G.table.insert(self.arrays, data.uid)
        self.power = self.power + data.power
    end
    local item = {}
    for _, value in pairs(self.arrays) do
        _G.table.insert(item, value)
    end
    self.arrays = item
    self:CeBian()
end

----界面点击事件
function BountyGroupFormationView:OnFriendListClicks(go, isOn, index)
    if index ~= nil then
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, index)

        if self.item[data.sid] ~= nil then
            self.item[data.sid].aorimage_gou:SetActiveE(0)
        end
        for key, value in pairs(self.arrays) do
            if value == data.uid then
                self.arrays[key] = nil
            end
        end
        self.power = self.power - data.power
    end
    local item = {}
    for key, value in pairs(self.arrays) do
        _G.table.insert(item, value)
    end
    self.arrays = item
    self:CeBian()
end

