--tog是否显示背景
function BountyGroupFormationView:ToggLeMask()
    for key, value in pairs(Toggle) do
        local item = _G.GetAutoGoTable(self.go_table[value], _G.handler(self, self.OnClickBtnisOff))

        item.aorbtn_isOff:SetActiveE(self:ToggLeMaskBool(key))
    end
end

