    if name == "@_aorbtn_isOff" then
        _G.PopWindowManager:GetInstance():ShowAllTips(4404)
    end
end

---判断当前点击是否响应
function BountyGroupFormationView:ToggLeMaskBool(id)
    for key, value in pairs(self.info.limit_list) do
        if value == id then
            return 0
        end
    end
    return 1
end

---查询对应条件的英雄
function BountyGroupFormationView:ShuXing()
    self.item = {}
    self.KaPao = { self.WuXing, self.ZhiYe, 0 }
    local kaPai = _G.StorageManager:GetInstance():GetMaxPowerCardByTarget(self.KaPao)

    self.go_table.aortext_Level.text = require("BountyGroupModel"):GetInstance().info.lv

    self.XianShiList = {}
    for _, value in pairs(kaPai) do
        if value.star >= self.bounty and self:ToggLeMaskBool(value.cfg.Professional) == 0 then
            _G.table.insert(self.XianShiList, value)
        end
    end
    _G.SortList(
        self.XianShiList,
        function(a)
            return a.power, a.star, a.uid
        end
    )
    self.go_table.scrollloopvectical_ZhanDouJiangLi:UpdateCount(#self.XianShiList)
end

function BountyGroupFormationView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local indexs = index + 1

    local datas = self.arrays[indexs]
    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.OnFriendListClicks, datas))
    gotable.aorimage_KaCao:SetActiveE(0)
    gotable.aorimage_Di:SetActiveE(0)
    if datas ~= nil then
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.arrays[indexs])

        gotable.obj_role:SetActiveE(1)

        local insId = listView2:GetInstanceIDE()
        self:CareatItem(data, false, gotable.obj_role, insId)
    else
        gotable.obj_role:SetActiveE(0)

        if indexs <= self.condition then
            gotable.aorimage_Di:SetActiveE(1)
        else
            gotable.aorimage_KaCao:SetActiveE(1)
        end
    end

    return gotable
end

