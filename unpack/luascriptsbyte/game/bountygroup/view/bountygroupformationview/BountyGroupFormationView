function BountyGroupFormationView:PanDuanZhYe(type, num)
    local nums = 0
    for key, value in pairs(self.arrays) do
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, value)
        if data.cfg.Professional == type then
            nums = nums + 1
        end
    end
    if nums < num then
        return 0
    end
    self.JiaCheng = self.JiaCheng + 1
    return 1
end

function BountyGroupFormationView:PanDuanWuXing(type, num)
    local nums = 0
    for key, value in pairs(self.arrays) do
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, value)
        if data.cfg.Professional == type then
            nums = nums + 1
        end
    end
    if nums < num then
        --nums = num
        return 0
    end
    self.JiaCheng = self.JiaCheng + 1

    return 1
end

---按钮点击事件在这里派发
function BountyGroupFormationView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Close" then
        self:Close()
    elseif name == "@_aorbtn_PaiQian" then
        if #self.arrays < _G.ConfigManager.bounty_group_cfg[self.info.lv].condition[1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(700103)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                700102,
                nil,
                function()
                    local group = {}
                    group.arrays = self.arrays
                    group.power = self.power + _G.math.floor(self.power)
                    require("BountyGroupModel"):GetInstance():BountyGroupPut(
                        group,
                        function(mag)
                            if self.call ~= nil then
                                self.call()
                            end
                            self:Close()
                        end
                    )
                end
            )
        end
    elseif name == "$_toggle_quan" then
        if isOn then
            if self.ZhiYes == 1 then
                self.ZhiYes = 0
            else
                self.ZhiYes = 1
            end
            --self.go_table.aorimage_pic_di:SetActiveE(self.ZhiYes)
        end
        if self.WuXing ~= 0 then
            self.WuXing = 0

            self:ShuXing()
        end
    elseif name == "$_toggle_shen" then
        if self.WuXing ~= 6 then
            self.WuXing = 6

            self:ShuXing()
        end
    elseif name == "$_toggle_lei" then
        if self.WuXing ~= 1 then
            self.WuXing = 1

            self:ShuXing()
        end
    elseif name == "$_toggle_fong" then
        if self.WuXing ~= 2 then
            self.WuXing = 2

            self:ShuXing()
        end
    elseif name == "$_toggle_shui" then
        if self.WuXing ~= 3 then
            self.WuXing = 3

            self:ShuXing()
        end
    elseif name == "$_toggle_huo" then
        if self.WuXing ~= 4 then
            self.WuXing = 4

            self:ShuXing()
        end
    elseif name == "$_toggle_tu" then
        if self.WuXing ~= 5 then
            self.WuXing = 5

            self:ShuXing()
        end
    elseif name == "$_toggle_zhiye" then
        if self.ZhiYe ~= 0 then
            self.ZhiYe = 0

            self:ShuXing()
        end
    elseif name == "$_toggle_youxia" then
        if self.ZhiYe ~= 5 then
            self.ZhiYe = 5

            self:ShuXing()
        end
    elseif name == "$_toggle_tanke" then
        if self.ZhiYe ~= 1 then
            self.ZhiYe = 1

            self:ShuXing()
        end
    elseif name == "$_toggle_fuzhu" then
        if self.ZhiYe ~= 4 then
            self.ZhiYe = 4

            self:ShuXing()
        end
    elseif name == "$_toggle_fashi" then
        if self.ZhiYe ~= 3 then
            self.ZhiYe = 3

            self:ShuXing()
        end
    elseif name == "$_toggle_zhanshi" then
        if self.ZhiYe ~= 2 then
            self.ZhiYe = 2

            self:ShuXing()
        end
    elseif name == "@_aorbtn_DengJi" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BountyGroupUpgradeView.Name)
    end
end

