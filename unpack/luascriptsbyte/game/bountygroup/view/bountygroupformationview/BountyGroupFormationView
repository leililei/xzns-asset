    self.TaskRewardInfo = {}

    -- 初始化WuXing变量为0
    self.WuXing = 0

    -- 初始化ZhiYe变量为0
    self.ZhiYe = 0

    -- 设置aorimage_tag的SpriteName为ZiYeImage表中self.info.limit_list[1]对应的值
    self.go_table.aorimage_tag.SpriteName = ZiYeImage[self.info.limit_list[1]]

    -- 设置aorimage_tags的SpriteName为ZiYeImage表中self.info.limit_list[2]对应的值
    self.go_table.aorimage_tags.SpriteName = ZiYeImage[self.info.limit_list[2]]

    -- 调用ToggLeMask函数
    self:ToggLeMask()

    -- 调用ShuXing函数
    self:ShuXing()

