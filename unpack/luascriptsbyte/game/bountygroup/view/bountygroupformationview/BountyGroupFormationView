    -- 获取info变量的值，值为require("BountyGroupModel"):GetInstance().info
    self.info = require("BountyGroupModel"):GetInstance().info

    -- 获取bounty变量的值，值为_G.ConfigManager.bounty_group_cfg[self.info.lv].condition[2]
    self.bounty = _G.ConfigManager.bounty_group_cfg[self.info.lv].condition[2]

