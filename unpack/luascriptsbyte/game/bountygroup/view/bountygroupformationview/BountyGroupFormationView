function BountyGroupFormationView:ItemDataAll_Index(index, listView2)
    if index < 0 then
        return
    end
    local indexs = index + 1
    local data = _G.ConfigManager.card_cfg[self.XianShiList[indexs].sid]

    local gotable = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.OnFriendListClick, indexs))

