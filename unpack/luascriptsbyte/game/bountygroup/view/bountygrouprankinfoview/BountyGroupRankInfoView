---排行奖励 节点信息
function BountyGroupRankInfoView:InitRankReward()
    self.model:GetDataFormSeverRankNodeInfo(
        self.type,
        function()
            self.rewardLists = {}
            self.ranksid = 100000 + self.model.rankNode.type_rank_enum * 1000
            self:RefreshNodeReward()
        end
    )
end
function BountyGroupRankInfoView:ClickHead(go, ref, uid)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if uid > 0 then
            if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(uid)
            end
        end
    end
end
---按钮点击事件在这里派发
function BountyGroupRankInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_Close" or name == "@_aorbtn_close1" then
        if self.call ~= nil then
            self.call()
        end
        self:Close()
    end
end
return BountyGroupRankInfoView
