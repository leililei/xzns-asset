local LingRankModel = require("LingRankModel")
---@class BountyGroupRankInfoView : UIBaseView 关卡奖励
---@field public go_table RankInfoView_GoTable GoTable
local BountyGroupRankInfoView = _G.BaseClass("BountyGroupRankInfoView", _G.UIBaseView)
_G.BountyGroupRankInfoView = BountyGroupRankInfoView

local CS = _G.CS
local typeof = _G.typeof

function BountyGroupRankInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = require("BountyGroupModel"):GetInstance().box_info.ranks
    self:SetRankList()
    self:SetCurrentTiaoRank()
end

--- 设置 listView
function BountyGroupRankInfoView:SetRankList()
    local row = #self.model
    if self.mList == nil then
        self.go_table.scrollloopvectical_rankList:InitItemData(row, _G.handler(self, self.RefreshItem))
        self.mList = self.go_table.scrollloopvectical_rankList
    end
    self.go_table.scrollloopvectical_rankList:UpdateAllItem()
end
function BountyGroupRankInfoView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local item = obj
    item:SetName(index + 1)
    local data = self.model[index + 1] or {}
    self:SetRankTiaoOne(obj, data, 1, index + 1)
    return item
end
--region 更新
function BountyGroupRankInfoView:SetCurrentTiaoRank()
    local node = self.go_table.obj_currentRank
    node:SetActiveE(0)

    for key, value in pairs(self.model) do
        if value.role_info.uid == _G.PlayerModel:GetInstance().role_uid then
            node:SetActiveE(1)
            self:SetRankTiaoOne(node, value, 2, key)
        end
    end
end
---设置
function BountyGroupRankInfoView:SetRankTiaoOne(go, data, type, index)
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.ClickHead, data.role_info.uid))
    if data.role_info.uid == nil then
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        return
    end
    if index and type == 2 then
        _G.GameUtil.SetActiveByCondition(tb.aortext_myRank, true)
        tb.obj_mingci1:SetLocalPosition(-416, -11, 0)
    else
        _G.GameUtil.SetActiveByCondition(tb.aortext_myRank, false)
        tb.obj_mingci1:SetLocalPosition(-416, 0, 0)
    end
    tb.aortext_name.text = data.role_info.name
    tb.aortext_ranknumber.text = data.recent
    --tb.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    local icon = _G.SystemSettingManager.GetTitleIcon(data.role_info.title)
    --称号
    if icon then
        tb.aorrawimage_title:LoadImage(icon)
    else
        tb.aorrawimage_title:LoadImage("")
    end
    _G.UIUtils.SetImageFont({tb.aorimage_level1}, _G.tostring(data.role_info.level), _G.AorImageFont.Cardlevel)
    local flag = false
    if index then
        local mingci = index
        if mingci <= 3 then
            flag = true
            _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, true)
            if mingci == 1 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
            elseif mingci == 2 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
            elseif mingci == 3 then
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
            end
            tb.aortext_rank_paiming.text = ""
        else
            flag = false
            tb.aortext_rank_paiming.text = mingci
        end
    else
        flag = false
        tb.aortext_rank_paiming.text = _G.ConfigManager.language_package_cfg[90022900040]
    end

    _G.GameUtil.SetActiveByCondition(tb.obj_mingci, not flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBiaozhi, flag)
    tb.aortext_level.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    tb.aorimage_portrait.SpriteName = _G.ConfigManager.player_portrait_cfg[data.role_info.style].portrait1
    tb.aorrawimage_frame:LoadImage(_G.ConfigManager.player_frame_cfg[data.role_info.frame].frame)
end
