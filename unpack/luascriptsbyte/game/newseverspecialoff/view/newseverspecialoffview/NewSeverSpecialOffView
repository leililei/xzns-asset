---@class NewSeverSpecialOffView : UIBaseView    开服特惠
---@field public go_table NewSeverSpecialOffView_GoTable GoTable
local NewSeverSpecialOffView = _G.BaseClass("NewSeverSpecialOffView", _G.UIBaseView)

function NewSeverSpecialOffView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local Itemkuang = {
    [7] = "ui_kfth_kk_3_2",
    [201008] = "ui_kfth_kk_1_2",
    [201018] = "ui_kfth_kk_2_2"
}
local Itembg = {
    [7] = "ui_kfth_kk_3",
    [201008] = "ui_kfth_kk_1",
    [201018] = "ui_kfth_kk_2"
}
local ItemDaybg = {
    [7] = "ui_kfth_kk_3_3",
    [201008] = "ui_kfth_kk_1_3",
    [201018] = "ui_kfth_kk_2_3"
}
local Giftkuang = {
    [201008] = "ImagesH5/hNewSeverSpecialOffView/ui_kfth_jz_1",
    [201018] = "ImagesH5/hNewSeverSpecialOffView/ui_kfth_jz_2"
}
local StorageManager = _G.StorageManager:GetInstance()
function NewSeverSpecialOffView:OnCreate()
    ---@type  NewSeverSpecialOffModel
    self.Model = require("NewSeverSpecialOffModel"):GetInstance()
    --require("RedPointManager"):GetInstance():RefreshNode()红点，暂时禁用
    self.Itemlist = {
        [1] = self.go_table.obj_awarditem1,
        [2] = self.go_table.obj_awarditem2,
        [3] = self.go_table.obj_awarditem3,
        [4] = self.go_table.obj_awarditem4,
        [5] = self.go_table.obj_awarditem5,
        [6] = self.go_table.obj_awarditem6,
        [7] = self.go_table.obj_awarditem7
    }
    _G.PlayerPrefsManager.SetInt("NewSeverSpecialOff" .. self.Model:GetToday(), 1)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointNewSeverSpecialOff.id)
    ---@type store_battle_pass_cfg
    self.endTime = self.Model:GetEndTime()
    self.SelectTag = self.Model:GetNowShowTag()
    self:UpdateTimer()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer:Start()
    end
    self:InitToggle()
    self.spindic = {}
    self.go_table.toggle_type1.isOn = false
    self.go_table.toggle_type2.isOn = false
    self.go_table.toggle_type1.isOn = true
    self.go_table.toggle_eject.isOn = _G.PlayerPrefsManager.GetInt("NewSeverSpecialOffView" .. self.Model:GetToday(), 0) ==
        1
end

function NewSeverSpecialOffView:InitToggle()
    self.toggles = {}
    local i = 1
    for k, v in pairs(self.Model.info) do
        self.toggles[k] = _G.GetAutoGoTable(
            self.go_table["toggle_type" .. i],
            _G.handlerbind(self, self.OnClickToggle, k, _G.handler(self, self.SelectToggle))
        )
        self.toggles[k].obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RedPointNewSeverSpecialOff.id, k)
        i = i + 1
        if i > 2 then
            break
        end
    end
end

---点击选项卡
---@return void
function NewSeverSpecialOffView:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call and isOn then
        call(key)
    end
end

---@param key int32 选中路线
function NewSeverSpecialOffView:SelectToggle(key)
    self.SelectTag = key
    self:init()
end

local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg

function NewSeverSpecialOffView:init()
    self.go_table.aorrawimage_kuan:LoadImage(Giftkuang[self.SelectTag])
    self.cfg = self.Model:GetGiftCfg(self.SelectTag)
    for i = 1, #self.Itemlist do
        local itemcfg = store_battle_content_cfg[self.cfg.content[i]]
        if table.isEmptyOrNil(itemcfg.rewards_pay) then
            self.Itemlist[i]:SetActiveE(0)
        else
            self.Itemlist[i]:SetActiveE(1)
            local data = StorageManager:GetItemDataClassByCfg(itemcfg.rewards_pay[1])
            local tb = _G.GetAutoGoTable(self.Itemlist[i], _G.handlerbind(self, self.OnClickItem, data, itemcfg))
            self:SetItemSpriteName(Itembg, tb.aorimage_bg, i)
            self:SetItemSpriteName(Itemkuang, tb.aorimage_kuang, i)
            self:SetItemSpriteName(ItemDaybg, tb.aorimage_daybg, i)
            local grade, type = StorageManager:GetItemGrade(data.sid)
            --[[if type == _G.StorageType.Artifact then
                if grade<3 then
                    grade = grade + 4
                else
                    grade = grade + 5
                 end

            elseif type == _G.StorageType.Spiritual then
                if grade<4 then
                    grade = grade + 3
                else
                    grade = grade + 4
                end
            end]]
            local icon = data.cfg.Icon and data.cfg.Icon or data.cfg.icon
            --tb.aorimage_quality.SpriteName=self.orderBG[grade]

            tb.aortext_num.text = _G.GameUtil.NumberToUnitStr(itemcfg.rewards_pay[1][2])
            tb.aortext_day.text = _G.GetLangPackValue(90023800006, GameUtil.NumberToChinese(i))

            if type == _G.StorageType.Card then
                tb.aorimage_icon:SetActiveE(1)
                tb.aorrawimage_icon:SetActiveE(0)
                tb.aorimage_icon.SpriteName = icon
                _G.GameUtil.SetActiveByCondition(tb.aorimage_jue, true)
                tb.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(data.cfg.Order)
                local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag(data.cfg.Order, data.sid)
                tb.aorimage_type:SetActiveE(icon and 1 or 0)
                if icon then
                    tb.aorimage_type.SpriteName = icon
                end
            else
                local tag = StorageManager:GetItemTag(data.sid)
                tb.aorimage_type:SetActiveE(_G.string.IsNullOrEmpty(tag) and 0 or 1)
                if not _G.string.IsNullOrEmpty(tag) then
                    tb.aorimage_type.SpriteName = tag
                end
                tb.aorimage_icon:SetActiveE(0)
                tb.aorrawimage_icon:SetActiveE(1)
                tb.aorrawimage_icon:LoadImage(icon)
                _G.GameUtil.SetActiveByCondition(tb.aorimage_jue, false)
            end
            if type == _G.StorageType.Prop and data.cfg.Type1 == 11 then
                tb.aorimage_special:SetActiveE(1)
            else
                tb.aorimage_special:SetActiveE(0)
            end
            if i == 7 then
                self.showspindata = data
            end
            local isget = self.Model:CheckIsGetItem(self.SelectTag, itemcfg.id)
            local canGet = self.Model:CheckIsCanGetItem(self.SelectTag, itemcfg.id) == 1

            if canGet then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqu_1,
                    tb.obj_Effect
                )
            end

            tb.obj_Effect:SetActiveE(canGet and 1 or 0)
            tb.obj_got:SetActiveE(isget and 1 or 0)
        end
    end
    self:UpdatBtn()
    self:InitToggleShow()
    self:ShowSpin()
end

function NewSeverSpecialOffView:ShowSpin()
    for k, v in pairs(self.spindic) do
        v:SetActiveE(k == self.SelectTag and 1 or 0)
    end
    local grade, type = StorageManager:GetItemGrade(self.showspindata.sid)
    local cfg
    self.go_table.aorimage_type:SetActiveE(type == _G.StorageType.Card and 1 or 0)
    self.go_table.aorimage_Order:SetActiveE(type == _G.StorageType.Card and 1 or 0)
    if type == _G.StorageType.Card then
        ---@type card_cfg
        cfg = self.showspindata.cfg
        self.go_table.aorimage_Order.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(cfg.Order)
        local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag(cfg.Order, self.showspindata.sid)
        self.go_table.aorimage_type:SetActiveE(icon and 1 or 0)
        if icon then
            self.go_table.aorimage_type.SpriteName = icon
        end
    else
        cfg = self:GetSkincfgByUnLockItemId(self.showspindata.sid)
    end
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.Name or cfg.name)
    if self.showspindata and not table.ContainsKey(self.spindic, self.SelectTag) then
        if not cfg then
            LogError("配置不是卡牌和皮肤解锁道具")
            return
        end
        local tag = self.SelectTag
        _G.UIUtils.LoadEffectByPath(cfg.ModelPathHi, self.go_table.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                --trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
                trans:SetLocalScaleXYZ(0.8)
                self.spindic[tag] = trans
            end)
    end
end

function NewSeverSpecialOffView:OnClickItem(go, ison, data, itemcfg)
    local isget = self.Model:CheckIsGetItem(self.SelectTag, itemcfg.id)
    if not isget and self.Model:CheckIsCanGetItem(self.SelectTag, itemcfg.id) == 1 then
        self.Model:GetAward(self.SelectTag, function()
            self:UpdatBtn()
            self:UpdateAwardItem()
        end, { itemcfg.id })
    else
        local grade, type = StorageManager:GetItemGrade(data.sid)
        if type == _G.StorageType.Card then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PreviewCardShowView.Name,
                { CardData = data },
                nil,
                true)
        elseif type == _G.StorageType.Prop and data.cfg.Type1 == 11 then
            ---@type skin_cfg
            local cfg = self:GetSkincfgByUnLockItemId(data.cfg.ID)
            local cardData = require("CardData").GetPreviewData(cfg.card)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PreviewCardShowView.Name,
                { CardData = cardData, showSwitchBtn = false },
                nil,
                true, --isPreviewCardShow,
                nil,
                cfg.id
            )
        else
            require "CommonTipManager":GetInstance():OpenTip(
                go.transform,
                data.sid,
                data.uid,
                data
            )
        end
    end
end

function NewSeverSpecialOffView:InitToggleShow()
    self.go_table.obj_togggroup:SetActiveE(self.Model:CheckIsShowNextGift(self.SelectTag) and 1 or 0)
end

function NewSeverSpecialOffView:UpdatBtn()
    if self.Model:CheckGiftIsBuy(self.SelectTag) == 1 then
        if self.Model:CheckGiftHasGet(self.SelectTag) == 1 then
            self.go_table.aortext_skip.text = _G.GetLangPackValue(9002010005)
        else
            self.go_table.aortext_skip.text = _G.GetLangPackValue(90001008406)
        end
    else
        self.go_table.aortext_skip.text = _G.GameUtil.SetPriceByChannel(self.cfg.price_id)
        _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buyorget, true)
    end
end

function NewSeverSpecialOffView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
    local timestr
    if time > 86400 then
        timestr = string.format("<color=#83e497>%s</color>", _G.TimeUtil.TranslateSecondForStr(time))
    else
        timestr = string.format("<color=#f49187>%s</color>", _G.TimeUtil.TranslateSecondForStr(time))
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, timestr)
end

function NewSeverSpecialOffView:SetItemSpriteName(names, image, key)
    if key and table.ContainsKey(key) then
        image.SpriteName = names[key]
    else
        image.SpriteName = names[self.SelectTag]
    end
end

function NewSeverSpecialOffView:UpdateAwardItem()
    for i = 1, #self.Itemlist do
        local itemcfg = store_battle_content_cfg[self.cfg.content[i]]
        if table.isEmptyOrNil(itemcfg.rewards_pay) then
            self.Itemlist[i]:SetActiveE(0)
        else
            self.Itemlist[i]:SetActiveE(1)
            local isget = self.Model:CheckIsGetItem(self.SelectTag, itemcfg.id)
            local tb = _G.GetAutoGoTable(self.Itemlist[i])
              local canGet = self.Model:CheckIsCanGetItem(self.SelectTag, itemcfg.id) == 1
            tb.obj_Effect:SetActiveE(canGet and 1 or 0)
            tb.obj_got:SetActiveE(isget and 1 or 0)
        end
    end
end

function NewSeverSpecialOffView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_buyorget then
        if self.Model:CheckGiftIsBuy(self.SelectTag) == 1 then
            if self.Model:CheckGiftHasGet(self.SelectTag) == 1 then
                self.Model:GetAward(self.SelectTag, function()
                    self:UpdatBtn()
                    self:UpdateAwardItem()
                end)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(5200101)
            end
        else
            self.Model:BuyGift(self.SelectTag, function()
                self:UpdatBtn()
                self:InitToggleShow()
            end)
        end
    elseif go == self.go_table.aorbtn_tip then
        local itemcfg = store_battle_content_cfg[self.cfg.content[#self.cfg.content]]
        local data = StorageManager:GetItemDataClassByCfg(itemcfg.rewards_pay[1])
        local grade, type = StorageManager:GetItemGrade(data.sid)
        if type == _G.StorageType.Card then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PreviewCardShowView.Name,
                { CardData = data },
                nil,
                true)
        elseif type == _G.StorageType.Prop and data.cfg.Type1 == 11 then
            ---@type skin_cfg
            local cfg = self:GetSkincfgByUnLockItemId(data.cfg.ID)
            local cardData = require("CardData").GetPreviewData(cfg.card)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PreviewCardShowView.Name,
                { CardData = cardData, showSwitchBtn = false },
                nil,
                true, --isPreviewCardShow,
                nil,
                cfg.id
            )
        end
    end
end

local skin_cfg = _G.ConfigManager.skin_cfg
function NewSeverSpecialOffView:GetSkincfgByUnLockItemId(sid)
    for k, v in pairs(skin_cfg) do
        if v.item == sid then
            return v
        end
    end
    return nil
end

function NewSeverSpecialOffView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.PlayerPrefsManager.SetInt("NewSeverSpecialOffView" .. self.Model:GetToday(),
        self.go_table.toggle_eject.isOn and 1 or 0)
end

return NewSeverSpecialOffView
