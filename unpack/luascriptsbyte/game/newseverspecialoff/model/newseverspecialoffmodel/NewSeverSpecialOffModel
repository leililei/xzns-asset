---@class NewSeverSpecialOffModel : GameDataModelBase    中文描述
local NewSeverSpecialOffModel = _G.BaseClass("NewSeverSpecialOffModel", _G.GameDataModelBase)

---@return NewSeverSpecialOffModel
function NewSeverSpecialOffModel:GetInstance()
    return self.super.GetInstance(self)
end

local store_battle_pass_cfg=_G.ConfigManager.store_battle_pass_cfg
---创建对象时,入口构造函数
function NewSeverSpecialOffModel:__init()
    local cfg=_G.ConfigManager.discrete_cfg[201102]
    self.info= {}
    for i = 1, #cfg[1] do
        self.info[cfg[1][i]]={sid=cfg[1][i],pack_sign={},is_buy=0}
    end
    self:GetDataFormServer()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate,self.OnSixUpdate,self)
end

function NewSeverSpecialOffModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate,self.OnSixUpdate,self)
end


function NewSeverSpecialOffModel:GetDataFormServer()
    if self:CheckIsOpen() then
        require("NewSeverSpecialOffNet"):GetInstance():SendInfoGet(_G.handler(self,self.ParseData))
    end
end

function NewSeverSpecialOffModel:OnSixUpdate()
    if  _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(1007) and not self:CheckIsOpen() then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.NewSeverSpecialOff)
        _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate,self.OnSixUpdate,self)
    else
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RedPointNewSeverSpecialOff.id)
    end
end
---数据解析完成
---@param msg beginner_pack.i_beginner_pack_info
function NewSeverSpecialOffModel:ParseData(msg)
    if msg.ack==1 and not table.isEmptyOrNil(msg.info) then
        for _,v in pairs(msg.info) do
            self.info[v.sid].is_buy=v.is_buy
            if not table.isEmptyOrNil(v.pack_sign)  then
                self.info[v.sid].pack_sign={}
                for i = 1, #v.pack_sign do
                    table.insert(self.info[v.sid].pack_sign,v.pack_sign[i])
                end
            end
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RedPointNewSeverSpecialOff.id)
    self.super.ParseData(self)
end
--购买礼包
function NewSeverSpecialOffModel:BuyGift(id,callback)
    local cfg = _G.ConfigManager.store_battle_pass_cfg[id]
    if cfg ~= nil then
        require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
        self.BuyGiftBack=function()
            callback()
        end
        _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end
---购买回调
function NewSeverSpecialOffModel:OnMallCashListener(data)
    if table.ContainsKey(self.info,data.sid) then
        self.info[data.sid].is_buy=1
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RedPointNewSeverSpecialOff.id, data.sid)
        if self.BuyGiftBack then
            self:BuyGiftBack()
            self.BuyGiftBack=nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end
function NewSeverSpecialOffModel:GetAward(tag,callback,ids)
    local pb={sid=tag,pack_sign=ids or self:GetGiftAllGet(tag)}
    require("NewSeverSpecialOffNet"):GetInstance():SendRewardGet(pb,_G.handlerbind(self,self.GetAwardBack,pb,callback))
end
function NewSeverSpecialOffModel:GetAwardBack(msg,pb,callback)
    if msg.ack==1 then
        for i = 1, #pb.pack_sign do
            table.insert(self.info[pb.sid].pack_sign,pb.pack_sign[i])
        end
        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RedPointNewSeverSpecialOff.id, pb.sid)
        if callback then
            callback()
        end
    end
end

function NewSeverSpecialOffModel:GetGiftCfg(id)
    return store_battle_pass_cfg[id]
end
---获得当前展示tag
function NewSeverSpecialOffModel:GetNowShowTag()
    local tag
    for k,v in pairs(self.info) do
        local cfg=store_battle_pass_cfg[k]
        if not tag and not (cfg.pre_sid > 0) then
            tag=k
        end
        if v.is_buy==1 and self:CheckGiftHasGet(k)==1 then
            tag=k
            break
        end
    end
    return tag
end
---判断当前礼包是否存在未领取奖励
---@param cfg store_battle_pass_cfg
function NewSeverSpecialOffModel:CheckGiftHasGet(tag)
    local ToDay=self:GetToday()
    local cfg=store_battle_pass_cfg[tag]
    for i = 1, #cfg.content do
        if ToDay>=i and not table.ContainsValue(self.info[cfg.id].pack_sign,cfg.content[i]) then
            return 1
        end
    end
    return 0
end
function NewSeverSpecialOffModel:GetGiftAllGet(tag)
    local ids={}
    local ToDay=self:GetToday()
    local cfg=store_battle_pass_cfg[tag]
    for i = 1, #cfg.content do
        if ToDay>=i and not table.ContainsValue(self.info[cfg.id].pack_sign,cfg.content[i]) then
            table.insert(ids,cfg.content[i])
        end
    end
    return ids
end
---判断奖励item是否已经领取
function NewSeverSpecialOffModel:CheckIsGetItem(tag,id)
    return self.info[tag] and table.ContainsValue(self.info[tag].pack_sign,id) or false
end
---判断奖励item是否能够领取
function NewSeverSpecialOffModel:CheckIsCanGetItem(tag,id)
    if self.info[tag].is_buy==0 then
        return 0
    end
    local ToDay=self:GetToday()
    local cfg=store_battle_pass_cfg[tag]
    for i = 1, #cfg.content do
        if ToDay>=i and cfg.content[i]== id  and not table.ContainsValue(self.info[cfg.id].pack_sign,id) then
            return 1
        end
    end
    return 0
end
function NewSeverSpecialOffModel:CheckShowRed()
    if not self:CheckIsOpen() then
        return 0
    end
    return _G.PlayerPrefsManager.GetInt("NewSeverSpecialOff"..self:GetToday(),0)==0 and 1 or 0
end
---判断礼包是否已经购买
function NewSeverSpecialOffModel:CheckGiftIsBuy(tag)
    return self.info[tag] and self.info[tag].is_buy or 0
end
function NewSeverSpecialOffModel:CheckIsShowNextGift(tag)
    local isbuy=self:CheckGiftIsBuy(tag)
    if isbuy==1 then
        return true
    else
        local cfg=store_battle_pass_cfg[tag]
        return cfg.re_sid==0 
    end
end

local continueDay=_G.ConfigManager.discrete_cfg[201101][1][1]
---获取结束时间
function NewSeverSpecialOffModel:GetEndTime()
    return _G.TimeUtil.GetDayBySix(_G.PlayerModel:GetInstance():GetCreateRoleTime() + 86400*
            (continueDay+_G.ConfigManager.function_open_cfg[1007].condition_type[1][2]-1))
end
function NewSeverSpecialOffModel:GetToday()
    local CreatTime =_G.PlayerModel:GetInstance():GetCreateRoleTime()
    local startTime=CreatTime+(_G.ConfigManager.function_open_cfg[1007].condition_type[1][2]-1)*86400
    local NowTime=_G.TimeUtil.GetServerUnixTime()
    local ToDay=_G.TimeUtil.GetIntervalDayBySix1(startTime,NowTime)+1
    return ToDay
end
---判断功能是否开启
function NewSeverSpecialOffModel:CheckIsOpen()
    if not  _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(1007) then
        return false
    end
    local ToDay=require("NewSeverSpecialOffModel"):GetInstance():GetToday()
    if ToDay>continueDay then
        return false
    end
    return true
end



return NewSeverSpecialOffModel