---@class NewSeverSpecialOffNet : BaseGameNet	通信协议
local NewSeverSpecialOffNet = _G.BaseClass("NewSeverSpecialOffNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return NewSeverSpecialOffNet NewSeverSpecialOffNet
function NewSeverSpecialOffNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求 信息
---@param pbData table PB数据
---@param callback function 完成回调
---i_task sid任务sid  target
function NewSeverSpecialOffNet:SendInfoGet(callback)
    local item = _G.ConfigManager.net_map.game_beginner_pack_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end


---开服特惠签到领奖
---@param pbData number 奖励 id(index = 1)
---@param callback funtion 完成回调（public.s2c_common_ack）
function NewSeverSpecialOffNet:SendRewardGet(pbData, callback)
    local item = _G.ConfigManager.net_map.game_beginner_pack_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function NewSeverSpecialOffNet:ActionGoalsCall(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type NewSeverSpecialOffNet
_G.NewSeverSpecialOffNet = NewSeverSpecialOffNet
return NewSeverSpecialOffNet
