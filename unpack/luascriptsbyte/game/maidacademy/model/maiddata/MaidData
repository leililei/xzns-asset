---@class MaidData    中文描述
---@field cfg study_role_cfg
---@field grow number 培养次数
---@field level number 等级（历史学院等级同步）
---@field idle number 空闲了
local MaidData = _G.BaseClass("MaidData")

local decMainAttribute = {
    atk = 90010200101,
    bre = 90010200201,
    def = 90010200301,
    max_hp = 90010200401
}

local ConfigManager = _G.ConfigManager

---类的构造函数
function MaidData:__init()
end

---数据解析
---@param data study.i_study_role 数据
function MaidData:Parse(data)
    self.sid = data.sid
    self.cfg = ConfigManager.study_role_cfg[self.sid]
    if not self.cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("study_role_cfg中找不到对应的女仆配置，sid: " .. _G.tostring(self.sid))
        end
        self.cfg = _G.ConfigManager.study_role_cfg[273000101]
    end
    self.grow = data.grow or 0
    self.level = data.level or 1
    self.idle = false
end

---获取最终属性  or not all
---@return AttributeClass
function MaidData:GetProp()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    
    ---基础属性
    local percent = self:GetPropRate()
    local baseAttribute = self:GetBasePropAttr(percent)
    _G.AttributeClassManager:GetInstance():AddAttribute(self.attribute, baseAttribute)

    return self.attribute
end

---基础属性加成倍率
function MaidData:GetPropRate()
    local percent = 1
    local studycfg = _G.ConfigManager.study_role_level_cfg[self.level]

    percent = (studycfg.role_level + math.floor(self.grow/studycfg.role_grow[1]) *  studycfg.role_grow[2]) * 0.0001

    return percent
end

---获取基础属性
---@return AttributeClass
function MaidData:GetBasePropAttr(percent)
    local attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    for key, value in pairs(decMainAttribute) do
        local tempValue = self.cfg[key]
        if tempValue and tempValue > 0 then
            attribute:SetValueByName(key, tempValue * percent, false, _G.AttCountType.other)
        end
    end
    return attribute
end

return MaidData