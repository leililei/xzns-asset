---保留两位换算百分比值
function MaidAcademyModel:TruncateDecimal(number, places)
    local multiplier = 10 ^ places
    return math.floor(number * multiplier)
end

--可招募红点
function MaidAcademyModel:CanDraw()
    local posList = self.pos
    if posList then
        _G.SortList(posList, function(a)
            return -a.index
        end)
        if self.cfg then
            for i = 1, self.MaxNum do
                if self.cfg.position >= i then
                    ---解锁了
                    local posdata = posList[i]
                    if not posdata or not posdata.s_role then
                        return 1
                    end
                end
            end
        end
    end
    return 0
end

--可培养红点
function MaidAcademyModel:CanCultivate(index)
    local posList = self.pos
    if posList then
        _G.SortList(posList, function(a)
            return -a.index
        end)
        for i = 1, self.MaxNum do
            if self.cfg then
                if self.cfg.position >= i then
                    ---解锁了
                    local posdata = posList[i]
                    if posdata and posdata.s_role and posdata.index == index then
                        local rcfg = _G.ConfigManager.study_role_level_cfg[posdata.s_role.level]
                        ---人没满并且有体力
                        if posdata.s_role.grow < rcfg.position_pay and posdata.physical > 0 then
                            return 1
                        end
                    end
                end
            end
        end
    end
    return 0
end

