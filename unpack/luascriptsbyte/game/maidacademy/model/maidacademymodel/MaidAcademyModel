---词条特质
function MaidAcademyModel:GetEntryInfo()
    local preList = {}
    local cfg = _G.ConfigManager.study_role_level_cfg
    for i = 1, #cfg do
        local add = cfg[i].study_entry_add
        if self.level >= i and #add > 0 then
            table.insert(preList, add)
        end
    end
    return preList[#preList]
end

---获取品质抽取概率

function MaidAcademyModel:GetDrawPro(herolevel)
    local proList = {}
    local cfg = _G.ConfigManager.study_role_cfg
    for key, value in pairs(cfg) do
        if nil == proList[value.order] then
            proList[value.order] = {}
        end
        table.insert(proList[value.order], key)
    end

    local model = require("HeroicIconModel"):GetInstance()
    local curLevel = model:GetIconTotalLevel()
    ---测试用
    --local curLevel = herolevel

    local index = 0
    local dcfg = _G.ConfigManager.discrete_cfg[202009]
    for i = 1, #dcfg do
        if curLevel >= dcfg[i][1] then
            index = i
        end
    end
    local quepro = { 0, 0, 0, 0, 0, 0 }
    local result = {}

    local ocfg = _G.ConfigManager.discrete_cfg[202009][index]
    local id = ocfg[2]
    local rcfg = _G.ConfigManager.study_role_roller_cfg[id]
    for k = 1, #rcfg.study_role do
        for j = 1, 6 do
            if false ~= table.indexof(proList[j], rcfg.study_role[k][1]) then
                quepro[j] = quepro[j] + rcfg.study_role[k][2]
            end
        end
    end

    local total = 0
    local bwIndex = 0
    for k = 1, #quepro do
        if quepro[k] > 0 then
            bwIndex = k
        end
        total = total + quepro[k]
    end
    local temptotal = 100
    for k = 1, #quepro do
        local qp = self:TruncateDecimal(quepro[k] / total, 2)
        result[k] = qp
        if temptotal > qp then
            temptotal = temptotal - qp
        else
            temptotal = 0
        end
    end

    result[bwIndex] = result[bwIndex] + temptotal

    if index >= #dcfg then
        ---满了
        return result, result
    else
        local quepro1 = { 0, 0, 0, 0, 0, 0 }
        local result1 = {}

        local ocfg1 = _G.ConfigManager.discrete_cfg[202009][index + 1]
        local id1 = ocfg1[2]
        local rcfg1 = _G.ConfigManager.study_role_roller_cfg[id1]
        for k = 1, #rcfg1.study_role do
            for j = 1, 6 do
                if false ~= table.indexof(proList[j], rcfg1.study_role[k][1]) then
                    quepro1[j] = quepro1[j] + rcfg1.study_role[k][2]
                end
            end
        end

        local total1 = 0
        local bwIndex1 = 0
        for k = 1, #quepro1 do
            if quepro1[k] > 0 then
                bwIndex1 = k
            end
            total1 = total1 + quepro1[k]
        end
        local temptotal1 = 100
        for k = 1, #quepro1 do
            local qp = self:TruncateDecimal(quepro1[k] / total1, 2)
            result1[k] = qp
            if temptotal1 > qp then
                temptotal1 = temptotal1 - qp
            else
                temptotal1 = 0
            end
        end
        result1[bwIndex1] = result1[bwIndex1] + temptotal1
        return result, result1
    end
end

