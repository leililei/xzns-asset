function MaidAcademyModel:P2CStudySendApply(data)
    if data.type == 1 then
        ---拒绝
        for k = 1, #self.finish do
            if self.finish[k].uid == data.s_uid then
                self.finish[k].state = 0
                self.finish[k].state_type = 0
                break
            end
        end
        _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.P2CSendApply)
    end
end

