---合作
function MaidAcademyModel:Cooperation(msg, call)
    MaidAcademyNet:GetInstance():Cooperation(msg, function(data)
        if data.ack == 1 then
            if data.del_uid then
                for i = 1, #data.del_uid do
                    for k = 1, #self.record do
                        if self.record[k].uid == data.del_uid[i] then
                            table.remove(self.record, k)
                            break
                        end
                    end
                end
            end
            if data.attr then
                self.attr = data.attr
            end
            if data.n_sr then
                table.insert(self.record, data.n_sr)
                for k = 1, #self.finish do
                    if self.finish[k].uid == data.n_sr.uid then
                        table.remove(self.finish, k)
                        break
                    end
                end
                self.study_info[2] = self.study_info[2] + 1
                ---模拟推送
                _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.P2CCooperation)
            end

            if call then
                call(data)
            end
        end
    end)
end

