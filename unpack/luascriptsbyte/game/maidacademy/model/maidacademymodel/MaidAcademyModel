---拿所有上阵属性
function MaidAcademyModel:GetAllAppiotAttr()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    ---上阵加成
    for i = 1, #self.appoint do
        local maid = self.appoint[i].s_role
        if maid then
            local acfg = _G.ConfigManager.study_cooperation_cfg[self.appoint[i].index]
            ---上阵属性
            for j = 1, #maid.r_add do
                local ecfg = _G.ConfigManager.study_entry_cfg[maid.r_add[j]]

                for _, v in pairs(ecfg.attribute) do
                    attribute:AddValueByName(
                        v[1],
                        _G.AttributeClassManager:GetInstance():GetValueWithName(v[1],
                            v[3], _G.tonumber(v[2])),
                        false,
                        _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                    )
                end
            end

            for k = 1, #maid.entry_add do
                local ecfg = _G.ConfigManager.study_entry_cfg[maid.entry_add[k]]
                local levelcfg = _G.ConfigManager.study_role_level_cfg[maid.level]
                local levelgrow = levelcfg.role_cooperate_grow or 10000

                for _, v in pairs(ecfg.attribute) do
                    attribute:AddValueByName(
                        v[1],
                        _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], v[3] * (10000 + acfg.cooperation_level)/10000 * levelgrow /
                            10000, _G.tonumber(v[2])),
                        false,
                        _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                    )
                end
            end

            local otheradd = maid.p_info.partner
            for j = 1, #otheradd.r_add do
                local ecfg = _G.ConfigManager.study_entry_cfg[otheradd.r_add[j]]

                for _, v in pairs(ecfg.attribute) do
                    attribute:AddValueByName(
                        v[1],
                        _G.AttributeClassManager:GetInstance():GetValueWithName(v[1],
                            v[3], _G.tonumber(v[2])),
                        false,
                        _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                    )
                end
            end

            for k = 1, #otheradd.entry_add do
                local ecfg = _G.ConfigManager.study_entry_cfg[otheradd.entry_add[k]]
                local levelcfg = _G.ConfigManager.study_role_level_cfg[otheradd.level]
                local levelgrow = levelcfg.role_cooperate_grow or 10000

                for _, v in pairs(ecfg.attribute) do
                    attribute:AddValueByName(
                        v[1],
                        _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], v[3] *(10000 + acfg.cooperation_level)/10000 * levelgrow /
                            10000, _G.tonumber(v[2])),
                        false,
                        _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                    )
                end
            end
        end
    end
    if attribute.attriOther then
        for k, v in pairs(attribute.attriOther) do
            if v ~= 0 then
                local ev = self:CheckAttrRate(k, v)
                attribute.attriOther[k] = ev
            end
        end
    end

    if attribute.attributePercent then
        for k, v in pairs(attribute.attributePercent) do
            if v ~= 0 then
                local ev = self:CheckAttrRate(k, v)
                attribute.attributePercent[k] = ev
            end
        end
    end
    return attribute
end

---判断属性加成上限
function MaidAcademyModel:CheckAttrRate(k, v)
    if nil == self.cfg then
        return 0
    end
    local attribute = self.cfg.attribute_rate
    local rvalue = 0
    for i = 1, #attribute do
        local key = attribute[i][1]
        if key == k then
            local type = tonumber(attribute[i][2])
            local value = tonumber(attribute[i][3])
            local evalue = 0
            if type == 1 then
                if _G.AttrType[key].percentage == 1 then
                    evalue = value / 10000
                else
                    evalue = value
                end
            else
                evalue = value / 10000
            end
            if v > evalue then
                rvalue = evalue
            else
                rvalue = v
            end
            break
        end
    end
    return rvalue
end

