---任命
function MaidAcademyModel:Appoint(msg, call, info)
    MaidAcademyNet:GetInstance():Appoint(msg, function(data)
        if data.ack == 1 then
            if msg.uid == 0 then
                ---下
                local role
                for k = 1, #self.appoint do
                    if self.appoint[k].index == msg.index then
                        role = _G.DeepCopy(self.appoint[k].s_role)
                        table.remove(self.appoint, k)
                        break
                    end
                end
                if role then
                    table.insert(self.record, 1, role)
                end
            else
                ---上
                local role
                for k = 1, #self.appoint do
                    if self.appoint[k].index == msg.index then
                        role = _G.DeepCopy(self.appoint[k].s_role)
                        table.remove(self.appoint, k)
                        break
                    end
                end
                if role then
                    table.insert(self.record, 1, role)
                end
                if info then
                    local infonew = {}
                    infonew.index = msg.index
                    infonew.s_role = info
                    table.insert(self.appoint, infonew)

                    for k = 1, #self.record do
                        if self.record[k].uid == info.uid then
                            table.remove(self.record, k)
                            break
                        end
                    end
                end
            end
            if call then
                call(data)
            end

            _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.AppointFinish)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                .PointMaidCanAppoint.id)
        end
    end)
end

---补充体力
function MaidAcademyModel:AddStrength(msg, call)
    MaidAcademyNet:GetInstance():AddStrength(msg, function(data)
        if data.ack == 1 then
            if data.pos then
                for i = 1, #data.pos do
                    local index = 0
                    for k = 1, #self.pos do
                        if self.pos[k].index == data.pos[i].index then
                            index = k
                            break
                        end
                    end
                    if index > 0 then
                        self.pos[index].index = data.pos[i].index
                        self.pos[index].physical = data.pos[i].physical
                        self.pos[index].oldphysical = data.pos[i].physical
                        self.pos[index].l_time = data.pos[i].l_time
                    end
                end
            end
            if call then
                call(data)
            end
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                .PointMaidCanCultivate.id)
        end
    end)
end

---合作达成推送
function MaidAcademyModel:P2CStudyCooperation(data)
    if data.del_uid then
        for i = 1, #data.del_uid do
            for k = 1, #self.record do
                if self.record[k].uid == data.del_uid[i] then
                    table.remove(self.record, k)
                    break
                end
            end
        end
    end
    if data.s_role then
        table.insert(self.record, data.s_role)

        for k = 1, #self.finish do
            if self.finish[k].uid == data.s_role.uid then
                table.remove(self.finish, k)
                break
            end
        end
        self.study_info[2] = self.study_info[2] + 1
    end

    if data.attr then
        self.attr = data.attr
    end

    _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.P2CCooperation)
end

