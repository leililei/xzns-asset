local base = _G.GameDataModelBase

---@class MaidAcademyModel : GameDataModelBase
local MaidAcademyModel = _G.BaseClass("MaidAcademyModel", base)

function MaidAcademyModel:__init()
    self.curFunctionOpenID = 305
    local startup = MaidUtil.startup
    self.MaxNum = 4
    self.HasRequest = 0
    self.level = 1
    self.exp = 0
    self.pos = {}
    self.finish = {}
    self.appoint =  {}
    self.attr = { 0, 0, 0, 0 }
    self.record = {}
    self.study_info = { 0, 0, 0 }
    self.posingmaids = {}

    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenFunctionNewEvent, self.FunOpen, self)
end

function MaidAcademyModel:FunOpen()
    if _G.AppSetting.DEBUG then
        _G.Log("刷新女仆功能红点")
    end
    self:GetDataFormServer()
end

---从服务器拉取数据
function MaidAcademyModel:GetDataFormServer()
    MaidAcademyNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg any
function MaidAcademyModel:ParseData(msg)
    self:SetSelfData(msg)
    base.ParseData(self)
end

---初始化数据
function MaidAcademyModel:SetSelfData(msg)
    self.level = msg.level or 1
    self.exp = msg.exp or 0
    self.pos = msg.pos or {}
    self.finish = msg.finish or {}
    self.appoint = msg.appoint or {}
    self.attr = msg.attr or { 0, 0, 0, 0 }
    self.record = msg.record or {}
    self.study_info = msg.study_info or { 0, 0, 0 }

    self:UpDateData()

    self.posingmaids = {}
    for i = 1, #self.pos do
        if self.pos[i].s_role then
            local maiddata = MaidData.New()
            maiddata:Parse(self.pos[i].s_role)
            self.posingmaids[self.pos[i].index] = maiddata
        end
    end

    self:NewStrength()

    if self.ThisTimer then
        self.ThisTimer:Stop()
        self.ThisTimer = nil
    end
    ---测试一秒刷
    self.ThisTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnThisTimer, self)
    --self.ThisTimer = _G.TimerManager:GetInstance():GetTimer(self.restStrengthBl / 5, self.OnThisTimer, self)
    self.ThisTimer:Start()

    MaidAcademyModel:GetInstance():GetApply(function(data)
        self.cList = data.apply or {}
        if #self.cList > 0 then
            self.HasRequest = 1
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidHasRequest.id)
        end
    end)
    _G.Events:GetInstance():Broadcast(_G.eMaidUpdate.MaidInit)

    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidCanDraw.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PointMaidCanCultivate
        .id)
end

function MaidAcademyModel:UpDateData()
    self.cfg = _G.ConfigManager.study_cfg[self.level]
    self.maxStreng = self.cfg.physical[1]      --体力上限
    self.restStrengthBl = self.cfg.physical[2] --x秒回复1点体力
end

---恢复体力倒计时
function MaidAcademyModel:OnThisTimer(elapsed)
    self:ResetStrength()

    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PointMaidCanCultivate
        .id)
end

---恢复体力
function MaidAcademyModel:ResetStrength()
    for k = 1, #self.pos do
        ---体力未满做一下算法
        if self.pos[k].physical < self.maxStreng then
            local addstreng = math.floor((_G.TimeUtil.GetServerUnixTime() - self.pos[k].l_time) / self.restStrengthBl)
            local old = self.pos[k].oldphysical or 0
            local curstreng = old + addstreng
            if curstreng >= self.maxStreng then
                curstreng = self.maxStreng
            end
            if curstreng < 0 then
                curstreng = 0
            end
            self.pos[k].physical = curstreng
        end
    end
end

---新加的体力(前端按时间自行换算)
function MaidAcademyModel:NewStrength()
    for k = 1, #self.pos do
        self.pos[k].oldphysical = self.pos[k].physical
        ---体力未满做一下算法
        if self.pos[k].physical < self.maxStreng then
            local addstreng = math.floor((_G.TimeUtil.GetServerUnixTime() - self.pos[k].l_time) / self.restStrengthBl)
            local curstreng = self.pos[k].physical + addstreng
            if curstreng >= self.maxStreng then
                curstreng = self.maxStreng
            end
            if curstreng < 0 then
                curstreng = 0
            end
            self.pos[k].physical = curstreng
        end
    end
end

---女仆毕业一个加一点经验
function MaidAcademyModel:AddExp()
    if not self:IsMax() then
        self.exp = self.exp + 1
        local cfg = _G.ConfigManager.study_cfg[self.level]
        local nextcfg = _G.ConfigManager.study_cfg[self.level + 1]
        if self.exp >= nextcfg.exp - cfg.exp then
            self.level = self.level + 1
            self.exp = 0

            self:UpDateData()

            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                .PointMaidCanAppoint.id)

            _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.UpLevel)
        end
    end
end

---是否为满级
function MaidAcademyModel:IsMax()
    if self.level >= #_G.ConfigManager.study_cfg then
        return true
    end
    return false
end

---基础属性加成倍率
function MaidAcademyModel:GetPropRate(grow, level)
    local percent = 1
    local studycfg = _G.ConfigManager.study_role_level_cfg[level]

    percent = (studycfg.role_level + math.floor(grow / studycfg.role_grow[1]) * studycfg.role_grow[2]) * 0.0001

    return percent
end

---获取成长
function MaidAcademyModel:GetAllOtherProp()
    local allProp = { atk = 0, bre = 0, def = 0, max_hp = 0 }
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Maid) then
        return allProp
    end
    local attribute = self:GetCultivateBasePropAttr()
    if not _G.table.isEmptyOrNil(attribute.attriOther) then
        allProp = attribute.attriOther
    end
    return allProp
end

---功能全属性
function MaidAcademyModel:GetAllAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Maid) then
        local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
        return attribute, changeAttrTypes
    end
    ---基础加成
    local base = self:GetBasePropAttr()
    _G.AttributeClassManager:GetInstance():AddAttribute(attribute, base)

    ---上阵加成
    local appoint = self:GetAllAppiotAttr()
    _G.AttributeClassManager:GetInstance():AddAttribute(attribute, appoint)

    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    return attribute, changeAttrTypes
end

---获取基础属性
---@return AttributeClass
function MaidAcademyModel:GetBasePropAttr()
    local attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    for i = 1, #decMainAttribute do
        local tempValue = self.attr[i]
        if tempValue and tempValue > 0 then
            attribute:SetValueByName(decMainAttribute[i], tempValue, false, _G.AttCountType.other)
        end
    end
    for j = 1, 4 do
        local maiddata = self.posingmaids[j]
        if nil ~= maiddata and not maiddata.idle then
            local posbase = maiddata:GetProp()
            _G.AttributeClassManager:GetInstance():AddAttribute(attribute, posbase)
        end
    end
    return attribute
end

--获取培养中女仆属性
---@return AttributeClass
function MaidAcademyModel:GetCultivateBasePropAttr()
    local attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    for j = 1, 4 do
        local maiddata = self.posingmaids[j]
        if nil ~= maiddata and not maiddata.idle then
            local posbase = maiddata:GetProp()
            _G.AttributeClassManager:GetInstance():AddAttribute(attribute, posbase)
        end
    end
    return attribute
end

---招募女仆
function MaidAcademyModel:Execute(msg, call)
    MaidAcademyNet:GetInstance():Execute(msg, function(data)
        if data.ack == 1 then
            local index = 0
            for k = 1, #self.pos do
                if self.pos[k].index == msg.index then
                    index = k
                    break
                end
            end
            data.pos.oldphysical = data.pos.physical
            if index > 0 then
                self.pos[index] = data.pos
            else
                table.insert(self.pos, data.pos)
            end

            local maiddata = self.posingmaids[data.pos.index]
            if nil == maiddata then
                maiddata = MaidData.New()
                maiddata:Parse(data.pos.s_role)
                self.posingmaids[data.pos.index] = maiddata
            else
                maiddata:Parse(data.pos.s_role)
            end

            if call then
                call(data)
            end

            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidCanDraw.id)
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                .PointMaidCanCultivate.id)
        end
    end)
end

---培养女仆
function MaidAcademyModel:Cultivate(msg, call)
    MaidAcademyNet:GetInstance():Cultivate(msg, function(data)
        if data.ack == 1 then
            for i = 1, #data.pos do
                local times = 0
                for j = 1, #msg.c_info do
                    if data.pos[i].index == msg.c_info[j].key then
                        times = msg.c_info[j].value
                    end
                end
                local tpos
                for k = 1, #self.pos do
                    if self.pos[k].index == data.pos[i].index then
                        tpos = self.pos[k]
                        break
                    end
                end
                tpos.l_time = data.pos[i].l_time
                tpos.physical = data.pos[i].physical
                tpos.oldphysical = data.pos[i].physical
                if tpos.s_role then
                    tpos.s_role.grow = tpos.s_role.grow + times
                    local maiddata = self.posingmaids[tpos.index]
                    if maiddata then
                        maiddata.grow = tpos.s_role.grow
                    end
                end
            end
            if call then
                call(data)
            end
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                .PointMaidCanCultivate.id)
        end
    end)
end

---完成培养女仆
function MaidAcademyModel:FinishRole(msg, call)
    MaidAcademyNet:GetInstance():FinishRole(msg, function(data)
        if data.ack == 1 then
            local role
            for k = 1, #self.pos do
                if self.pos[k].index == msg.index then
                    role = _G.DeepCopy(self.pos[k].s_role)
                    self.pos[k].s_role = nil
                    local maiddata = self.posingmaids[msg.index]
                    local attr = maiddata:GetProp()
                    local attrs = { "atk", "bre", "def", "max_hp" }
                    for o = 1, #attrs do
                        self.attr[o] = self.attr[o] + attr.attriOther[attrs[o]]
                    end
                    maiddata.idle = true
                    break
                end
            end
            if role then
                table.insert(self.finish, role)
            end
            self:AddExp()
            self.study_info[1] = self.study_info[1] + 1
            if call then
                call(data)
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidCanDraw.id)

            _G.Events:GetInstance():Broadcast(_G.eMaidUpdate.MaidUpdate)
        end
    end)
end

