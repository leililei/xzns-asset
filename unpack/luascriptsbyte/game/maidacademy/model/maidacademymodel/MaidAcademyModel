        return self.level, self.level
    else
        return self.level, self.level + 1
    end
end

---获取女仆培养上限
function MaidAcademyModel:GetCultivateMaxChange()
    local cfg = _G.ConfigManager.study_role_level_cfg[self.level]
    if self:IsMax() then
        return cfg.position_pay, cfg.position_pay
    else
        local nextcfg = _G.ConfigManager.study_role_level_cfg[self.level + 1]
        return cfg.position_pay, nextcfg.position_pay
    end
end

---获取女仆任命上限
function MaidAcademyModel:GetAppointMaxChange()
    self.ids = { 101, 201, 202, 301, 302 }
    if self:IsMax() then
        return #self.ids, #self.ids
    else
        local curo = 0
        local nexto = 0
        for i = 1, #self.ids do
            local cfg = _G.ConfigManager.study_cooperation_cfg[self.ids[i]]
            if cfg.condition_type <= self.level then
                curo = curo + 1
            end
        end
        nexto = curo + 1
        return curo, nexto
    end
end

