--可上阵红点
function MaidAcademyModel:CanAppoint(id)
    local ids = { 101, 201, 202, 301, 302 }
    local appointList = self.appoint

    for i = 1, #ids do
        local cfg = _G.ConfigManager.study_cooperation_cfg[ids[i]]
        if cfg.condition_type <= self.level and id == ids[i] then
            ---开了
            local data
            for k = 1, #appointList do
                if appointList[k].index == ids[i] then
                    data = appointList[k]
                end
            end
            if not data and #self.record > 0 then
                return 1
            end
        end
    end
    return 0
end

