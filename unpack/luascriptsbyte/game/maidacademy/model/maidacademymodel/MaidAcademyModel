---获取圣像关联等级描述
function MaidAcademyModel:GetHeroicLevelDesc()
    local model = require("HeroicIconModel"):GetInstance()
    local curLevel = model:GetIconTotalLevel()
    local curque = ""

    local cfg = _G.ConfigManager.discrete_cfg[202009]
    for i = 1, #cfg do
        local fav = cfg[i][1]
        local id = cfg[i][2]
        local rollercfg = _G.ConfigManager.study_role_roller_cfg[id]

        if curLevel >= fav then
            curque = rollercfg.describe
        end
    end

    if curque == "" then
        local id = cfg[#cfg][2]
        local rollercfg = _G.ConfigManager.study_role_roller_cfg[id]
        curque = rollercfg.describe
    end
    return curque
end

