---@class MaidCooperLimitView : UIBaseView	中文描述
---@field public go_table MaidCooperLimitView_GoTable GoTable
local MaidCooperLimitView = _G.BaseClass("MaidCooperLimitView", _G.UIBaseView)

local MaidAcademyModel = require("MaidAcademyModel")

function MaidCooperLimitView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidCooperLimitView:OnCreate(uid, level, ttype)
    self.uid = uid
    self.maxLimitMaid = level
    self.ttype = ttype
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidCooperLimitView:InitView()
    self.go_table.input_limitLevel.onEndEdit:AddListener(_G.handler(self, self.OnEndInputMaid))
    self.limitMaid = self.maxLimitMaid
    self.go_table.input_limitLevel.text =  self.maxLimitMaid
end

---根据输入的num加减入会限制的数字
function MaidCooperLimitView:ChangeMaid(num)
    self.limitMaid = self.limitMaid + num
    if self.limitMaid <= 1 then
        self.limitMaid = 1
    elseif self.limitMaid >= self.maxLimitMaid then
        self.limitMaid = self.maxLimitMaid
    end
    self.go_table.input_limitLevel.text = self.limitMaid
end

---直接输入 入会限制
function MaidCooperLimitView:OnEndInputMaid(input)
    local maid = _G.tonumber(input)
    if nil ~= maid then
        self.limitMaid = maid
    end
    self:ChangeMaid(0)
end

---界面的更新方法
function MaidCooperLimitView:UpdateView()
    
end

---界面的销毁函数
function MaidCooperLimitView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidCooperLimitView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_sub then
        self:ChangeMaid(-1)
    elseif go == self.go_table.aorbtn_add then
        self:ChangeMaid(1)
    elseif go == self.go_table.aorbtn_sendcooper then
        ---发布
        if self.ttype == 2 then
            if not require("SociatyManager"):GetInstance():HasSociaty() then
                _G.PopWindowManager:GetInstance():ShowAllTips(802)
                return
            end
        end
        local msg = {}
        msg.uid = self.uid--女仆uid
        msg.con = self.limitMaid -- 合作女仆要求
        msg.type = self.ttype --发布类型  1:人才市场，2：公会
        MaidAcademyModel:GetInstance():Release(msg, function(data)
            self:Close()
            if _G.AppSetting.Debug then
                _G.Log("发布成功")
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(9012012)
            _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.ReleaseFinish)
        end)
    end
end

return MaidCooperLimitView