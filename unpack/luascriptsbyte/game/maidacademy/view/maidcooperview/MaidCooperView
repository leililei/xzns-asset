---@class MaidCooperView : UIBaseView	中文描述
---@field public go_table MaidCooperView_GoTable GoTable
local MaidCooperView = _G.BaseClass("MaidCooperView", _G.UIBaseView)

local MaidAcademyModel = require("MaidAcademyModel")

local toggletype = {
    func = 1,
    strength = 2
}

function MaidCooperView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.InfoList = {}
    self.strengthList = {}

    self.infotype = { 2, 1 }
    self.refreshdelay = 10
    self.refreshtime = _G.TimeUtil.GetServerUnixTime()
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshList))

    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.ReleaseFinish, self.OnReleaseFinish, self)
end

---发布成功
function MaidCooperView:OnReleaseFinish()
    self:Close()
end

--获取随机推荐
function MaidCooperView:GetSelect()
    local msg = {}
    msg.uid = self.MyInfo.uid--女仆uid
    msg.type = self.infotype[self.curSelectToggle] ---//1:人才市场，2：公会
    if msg.type == 2 then
        if require("SociatyManager"):GetInstance():HasSociaty() then
            MaidAcademyModel:GetInstance():Select(msg, function(data)
                self.InfoList = {}
                local tempdata = data.s_info or {}
                for i = 1,#tempdata do
                    tempdata[i].index = i
                    self.InfoList[i] = tempdata[i]
                end

                _G.SortList(self.InfoList, function(a)
                    return a.s_info.role_uid
                end)
                self:UpdateView()
            end)
        else
            self.InfoList = {}
            self:UpdateView()
        end
    else
        MaidAcademyModel:GetInstance():Select(msg, function(data)
            self.InfoList = {}
            local tempdata = data.s_info or {}
            for i = 1,#tempdata do
                tempdata[i].index = i
                self.InfoList[i] = tempdata[i]
            end
            _G.SortList(self.InfoList, function(a)
                    return a.s_info.role_uid
                end)
            self:UpdateView()
        end)
    end
end

---界面的入口函数
---@param info i_study_role 自己的女仆
function MaidCooperView:OnCreate(info)
    self.MyInfo = info
    self.curSelectToggle = toggletype.strength
    self:GetSelect()
end

---界面的更新方法
function MaidCooperView:UpdateView()
    self.go_table.aortext_desc.text = _G.GetLangPackValue(90120200056, MaidAcademyModel:GetInstance():GetMaxAttrAddBySelf())
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.InfoList)
end

function MaidCooperView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.InfoList[x]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, info, x))

    goTable.aortext_name.text = _G.GetLangPackValue(info.s_info.name[1]).._G.GetLangPackValue(info.s_info.name[2])
    goTable.aortext_who.text = _G.GetLangPackValue(90120200049, info.s_info.role_uid > 0  and info.s_info.role_name or _G.GetLangPackValue(90120200084))

    _G.MaidUtil.Head(goTable.aorimage_iconbg, info.s_info.sid, info.s_info.spine, true, info.s_info, info.s_info.role_uid > 0  and info.s_info.role_name or _G.GetLangPackValue(90120200084))
    _G.MaidUtil.Type(goTable.aorimage_type, info.s_info.sid, info.s_info.level)
    _G.MaidUtil.Quelity(goTable.aorimage_quelity, info.s_info.sid)
    _G.MaidUtil.Power(goTable.aorimage_power, info.s_info.entry_add[1], info.s_info.level)
    _G.MaidUtil.Award(goTable.aorrawimage_award, info.s_info.level)

    for i = 1, 4 do
        local item = goTable.obj_allct:GetChildE(i - 1)
        local esid = info.s_info.r_add[i]
        if esid then
            item:SetActiveE(1)
            _G.MaidUtil.Entry(item, esid)
        else
            item:SetActiveE(0)
        end
    end

    if info.level_con > self.MyInfo.level then
        goTable.aorbtn_cooper:SetGray(true)
    else
        goTable.aorbtn_cooper:SetGray(false)
    end
end

function MaidCooperView:OnClickItem(go, isOn, info, index)
    local name = go:GetName()
    if name == "@_aorbtn_cooper" then
        if info.level_con > self.MyInfo.level then
            ---没有达到发布者的等级要求
            _G.PopWindowManager:GetInstance():ShowAllTips(9012011)
        else
            ---合作
        self:RecordPower()
            local msg = {}
            msg.index = info.index --排列序号
            msg.sr_uid = self.MyInfo.uid --自己要去合作的女仆uid
            MaidAcademyModel:GetInstance():Cooperation(msg, function(data)
                self:Close()
                local cfg = _G.ConfigManager.study_role_level_cfg[self.MyInfo.level]
                if cfg then
                    MaidAcademyModel:GetInstance().study_info[3] = MaidAcademyModel:GetInstance().study_info[3] + cfg.price[1][2]
                end
                local ocfg = _G.ConfigManager.study_role_level_cfg[info.s_info.level]
                if ocfg then
                    MaidAcademyModel:GetInstance().study_info[3] = MaidAcademyModel:GetInstance().study_info[3] + ocfg.price[1][2]
                end
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.MaidAcademy)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,data)
                self:UpdateView()
                self:ShowPowerUp()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidCooperSuccessView.Name, self.MyInfo, info)
            end)
        end
    end
end

function MaidCooperView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function MaidCooperView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

---界面的销毁函数
function MaidCooperView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.ReleaseFinish, self.OnReleaseFinish, self)
end

---按钮点击事件在这里派发
function MaidCooperView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_sendcooper then
        ---发布
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidCooperLimitView.Name,self.MyInfo.uid, self.MyInfo.level, self.infotype[self.curSelectToggle])
    elseif go == self.go_table.aorbtn_refresh then
        ---刷新
        if _G.TimeUtil.GetServerUnixTime() - self.refreshtime > self.refreshdelay then
            self:GetSelect()
            self.refreshtime = _G.TimeUtil.GetServerUnixTime()
        else
            ---刷新间隔中
            if _G.AppSetting.Debug then
                _G.Log("刷新间隔中")
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90120200137, (self.refreshdelay - (_G.TimeUtil.GetServerUnixTime() - self.refreshtime))))
        end
    end

    if name == "$_toggle_func" then
        if isOn then
            self.curSelectToggle = toggletype.func
            if _G.TimeUtil.GetServerUnixTime() - self.refreshtime > self.refreshdelay then
                self:GetSelect()
            else
                if _G.AppSetting.Debug then
                    _G.Log("刷新间隔中")
                end
            end
        end
    end

    if name == "$_toggle_strength" then
        if isOn then
            self.curSelectToggle = toggletype.strength
            if _G.TimeUtil.GetServerUnixTime() - self.refreshtime > self.refreshdelay then
                self:GetSelect()
            else
                if _G.AppSetting.Debug then
                    _G.Log("刷新间隔中")
                end
            end
        end
    end
end

return MaidCooperView
