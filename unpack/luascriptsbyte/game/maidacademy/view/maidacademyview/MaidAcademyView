---@class MaidAcademyView : UIBaseView	中文描述
---@field public go_table MaidAcademyView_GoTable GoTable
local MaidAcademyView = _G.BaseClass("MaidAcademyView", _G.UIBaseView)

local toggletype = {
    cultivate = 1,
    cooperation = 2,
    appoint = 3
}

function MaidAcademyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.Close, self)
    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.GotoCooper, self.OnGotoCooper, self)
end

---界面的入口函数
function MaidAcademyView:OnCreate()
    self.curSelectToggle = toggletype.cultivate
    self:InitView()
    self:UpdateView()
end

function MaidAcademyView:OnGotoCooper()
    self.go_table.toggle_cooperation.isOn = true
end

---界面创建时的初始化方法
function MaidAcademyView:InitView()
    self.go_table.aorimage_bg:SetActiveE(0)
    self.go_table.aorrawimage_bg:LoadImage("ImagesH5/hMaidAcademy/ui_np_bg")
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_cultivate, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_cooperation, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_appoint, false)
end

---界面的更新方法
function MaidAcademyView:UpdateView()
    if self.curSelectToggle == toggletype.cultivate then
        if not self.cultivateComponent then
            ---@type MaidAcademyCultivate
            self.cultivateComponent =
                self:AddComponent(
                    self.go_table.obj_cultivate,
                    require("MaidAcademyCultivate").New(self.go_table.obj_cultivate, self)
                )
        end
        self.cultivateComponent:UpdateView()
    elseif self.curSelectToggle == toggletype.cooperation then
        if not self.cooperationComponent then
            ---@type MaidAcademyCooperation
            self.cooperationComponent =
                self:AddComponent(
                    self.go_table.obj_cooperation,
                    require("MaidAcademyCooperation").New(self.go_table.obj_cooperation, self)
                )
        end
        self.cooperationComponent:UpdateView()
    elseif self.curSelectToggle == toggletype.appoint then
        if not self.appointComponent then
            ---@type MaidAcademyAppoint
            self.appointComponent =
                self:AddComponent(
                    self.go_table.obj_appoint,
                    require("MaidAcademyAppoint").New(self.go_table.obj_appoint, self)
                )
        end
        self.appointComponent:UpdateView()
    end
end

---界面的销毁函数
function MaidAcademyView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.Close, self)
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.GotoCooper, self.OnGotoCooper, self)
end

---按钮点击事件在这里派发
function MaidAcademyView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1042)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end

    if name == "$_toggle_cultivate" then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_cultivate, isOn)
        _G.GameUtil.SetActiveByCondition(_G.GetAutoGoTable(self.go_table.toggle_cultivate).obj_isonicon, isOn)
        if isOn then
            self.curSelectToggle = toggletype.cultivate
            self.go_table.aorrawimage_bg:LoadImage("ImagesH5/hMaidAcademy/ui_np_bg")
            self.go_table.aorimage_bg:SetActiveE(0)
            self:UpdateView()
        end
    end

    if name == "$_toggle_cooperation" then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_cooperation, isOn)
        _G.GameUtil.SetActiveByCondition(_G.GetAutoGoTable(self.go_table.toggle_cooperation).obj_isonicon, isOn)
        if isOn then
            self.curSelectToggle = toggletype.cooperation
            self.go_table.aorrawimage_bg:LoadImage("ImagesH5/hMaidAcademy/ui_np_bg")
            self.go_table.aorimage_bg:SetActiveE(1)
            if self.cultivateComponent then
                self.cultivateComponent:StopAuto()
            end
            self:UpdateView()
        end
    end

    if name == "$_toggle_appoint" then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_appoint, isOn)
        _G.GameUtil.SetActiveByCondition(_G.GetAutoGoTable(self.go_table.toggle_appoint).obj_isonicon, isOn)
        if isOn then
            self.curSelectToggle = toggletype.appoint
            self.go_table.aorrawimage_bg:LoadImage("ImagesH5/hMaidAcademy/ui_nvxy_bg_rm")
            self.go_table.aorimage_bg:SetActiveE(0)
            if self.cultivateComponent then
                self.cultivateComponent:StopAuto()
            end
            self:UpdateView()
        end
    end
end

return MaidAcademyView
