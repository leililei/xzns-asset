---@class MaidAcademyCooperation : Component	敌方布阵情报
local MaidAcademyCooperation = _G.BaseClass("MaidAcademyCooperation", _G.Component)

local MaidAcademyModel = require("MaidAcademyModel")

local toggletype = {
    coopered = 1,
    notcooper = 2
}

---界面的入口函数
function MaidAcademyCooperation:OnCreate(obj, ...)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    self.tbList = {}
    self.curSelectToggle = toggletype.notcooper
    
    self.go_table.scrollloopvectical_List:InitItemData(0, _G.handler(self, self.RefreshList))
    self.go_table.scrollloopvectical_NotList:InitItemData(0, _G.handler(self, self.RefreshNotList))

    _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_List, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_NotList, true)

    self:UpdateView()

    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.P2CCooperation, self.OnP2CCooperation, self)
    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.ReleaseFinish, self.OnReleaseFinish, self)
    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.P2CSendApply, self.OnP2CSendApply, self)

    if self.ThatTimer then
        self.ThatTimer:Stop()
        self.ThatTimer = nil
    end
    self.ThatTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnThatTimer, self)
    self.ThatTimer:Start()
end

function MaidAcademyCooperation:OnThatTimer(elapsed)
    for k, v in pairs(self.tbList) do
        local infos = v
        local goTable = infos[1]
        local x = infos[2]
        local info = self.notList[x]

        if info then
            if info.state == 0 then
                goTable.aortext_sending:SetActiveE(0)
                goTable.aorbtn_cancel:SetActiveE(0)
                goTable.aorbtn_cooper:SetActiveE(1)
            else
                if info.state - _G.TimeUtil.GetServerUnixTime() > 0 then
                    goTable.aortext_sending:SetActiveE(1)
                    goTable.aorbtn_cancel:SetActiveE(1)
                    goTable.aorbtn_cooper:SetActiveE(0)
                    goTable.aortext_sendtime.text = _G.TimeUtil.TimeToString(
                        info.state - _G.TimeUtil.GetServerUnixTime(), 1)
                    --发布类型0：未发布，1：人才市场，2：公会，3：申请中
                    if info.state_type == 1 then
                        goTable.aortext_sending.text = _G.GetLangPackValue(90120200017)
                    elseif info.state_type == 2 then
                        goTable.aortext_sending.text = _G.GetLangPackValue(90120200018)
                    elseif info.state_type == 3 then
                        goTable.aortext_sending.text = _G.GetLangPackValue(90120200019)
                    else
                        goTable.aortext_sending.text = ""
                    end
                else
                    goTable.aortext_sending:SetActiveE(0)
                    goTable.aorbtn_cancel:SetActiveE(0)
                    goTable.aorbtn_cooper:SetActiveE(1)
                end
            end
        end
    end
end

function MaidAcademyCooperation:OnP2CCooperation()
    self:UpdateView()
end

function MaidAcademyCooperation:OnReleaseFinish()
    self:UpdateView()
end

function MaidAcademyCooperation:OnP2CSendApply()
    self:UpdateView()
end

function MaidAcademyCooperation:UpdateData()
    self.cedList = {}
    local app = MaidAcademyModel:GetInstance().appoint
    for i = 1, #app do
        table.insert(self.cedList, app[i].s_role)
    end
    local re = MaidAcademyModel:GetInstance().record
    for i = 1, #re do
        table.insert(self.cedList, re[i])
    end
    self.notList = MaidAcademyModel:GetInstance().finish
end

function MaidAcademyCooperation:UpdateView()
    self.tbList = {}
    self:UpdateData()
    if self.curSelectToggle == toggletype.coopered then
        self.go_table.aortext_coopernum.text = MaidAcademyModel:GetInstance().study_info[2]----#self.cedList
        self.go_table.scrollloopvectical_List:UpdateCount(#self.cedList)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nomaid, #self.cedList <= 0)
    else
        local finishmax = _G.ConfigManager.discrete_cfg[202003][1][1]
        self.go_table.aortext_coopernum.text = #self.notList .. "/" .. finishmax
        self.go_table.scrollloopvectical_NotList:UpdateCount(#self.notList)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_notnomaid, #self.notList <= 0)
    end
end

function MaidAcademyCooperation:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.cedList[x]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, info))

    local maid1 = _G.GetAutoGoTable(goTable.obj_maid1)

    maid1.aortext_name.text = _G.GetLangPackValue(info.name[1]) .. _G.GetLangPackValue(info.name[2])

    _G.MaidUtil.Head(maid1.aorimage_iconbg, info.sid, info.spine, true, info, _G.PlayerModel:GetInstance():GetName())
    _G.MaidUtil.Type(maid1.aorimage_type, info.sid, info.level)
    _G.MaidUtil.Power(maid1.aorimage_power, info.entry_add[1], info.level)
    _G.MaidUtil.Award(maid1.aorrawimage_award, info.level)

    local maid2 = _G.GetAutoGoTable(goTable.obj_maid2)

    maid2.aortext_name.text = _G.GetLangPackValue(info.p_info.partner.name[1]) ..
        _G.GetLangPackValue(info.p_info.partner.name[2])

    _G.MaidUtil.Head(maid2.aorimage_iconbg, info.p_info.partner.sid, info.p_info.partner.spine, true, info.p_info
        .partner, info.p_info.role_uid > 0 and info.p_info.role_name or
        _G.GetLangPackValue(90120200084))
    _G.MaidUtil.Type(maid2.aorimage_type, info.p_info.partner.sid, info.p_info.partner.level)
    _G.MaidUtil.PowerR(maid2.aorimage_powerR, info.p_info.partner.entry_add[1], info.p_info.partner.level)
    _G.MaidUtil.Award(maid2.aorrawimage_award, info.p_info.partner.level)

    local timeStr = _G.TimeUtil.TransTimeYMD(info.p_info.time)
    goTable.aortext_rolename.text = info.p_info.role_uid > 0 and info.p_info.role_name or
        _G.GetLangPackValue(90120200084)
    goTable.aortext_sendtime.text = timeStr

    _G.GameUtil.SetActiveByCondition(goTable.aorimage_inEmbattle, self:IsInAppoint(info.uid))
end

function MaidAcademyCooperation:IsInAppoint(uid)
    local appoint = MaidAcademyModel:GetInstance().appoint
    for j = 1, #appoint do
        if uid == appoint[j].s_role.uid then
            return true
        end
    end
    return false
end

function MaidAcademyCooperation:OnClickItem(go, isOn, info)
end

function MaidAcademyCooperation:RefreshNotList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.notList[x]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickNotItem, info))

    goTable.aortext_name.text = _G.GetLangPackValue(info.name[1]) .. _G.GetLangPackValue(info.name[2])

    _G.MaidUtil.Head(goTable.aorimage_iconbg, info.sid, info.spine, true, info, _G.PlayerModel:GetInstance():GetName())
    _G.MaidUtil.Type(goTable.aorimage_type, info.sid, info.level)
    _G.MaidUtil.Power(goTable.aorimage_power, info.entry_add[1], info.level)
    _G.MaidUtil.Award(goTable.aorrawimage_award, info.level)
    _G.MaidUtil.Quelity(goTable.aorimage_quelity, info.sid)

    for i = 1, 4 do
        local entry = goTable["aorimage_entry" .. i]
        local esid = info.r_add[i]
        if esid then
            entry:SetActiveE(1)
            _G.MaidUtil.Entry(entry, esid)
        else
            entry:SetActiveE(0)
        end
    end

    if info.state == 0 then
        goTable.aortext_sending:SetActiveE(0)
        goTable.aorbtn_cancel:SetActiveE(0)
        goTable.aorbtn_cooper:SetActiveE(1)
    else
        if info.state - _G.TimeUtil.GetServerUnixTime() > 0 then
            goTable.aortext_sending:SetActiveE(1)
            goTable.aorbtn_cancel:SetActiveE(1)
            goTable.aorbtn_cooper:SetActiveE(0)
            goTable.aortext_sendtime.text = _G.TimeUtil.TimeToString(info.state - _G.TimeUtil.GetServerUnixTime(), 1)
            --发布类型0：未发布，1：人才市场，2：公会，3：申请中
            if info.state_type == 1 then
                goTable.aortext_sending.text = _G.GetLangPackValue(90120200017)
            elseif info.state_type == 2 then
                goTable.aortext_sending.text = _G.GetLangPackValue(90120200018)
            elseif info.state_type == 3 then
                goTable.aortext_sending.text = _G.GetLangPackValue(90120200019)
            else
                goTable.aortext_sending.text = ""
            end
        else
            goTable.aortext_sending:SetActiveE(0)
            goTable.aorbtn_cancel:SetActiveE(0)
            goTable.aorbtn_cooper:SetActiveE(1)
        end
    end
    local id = goTable.gameObject:GetInstanceID()
    self.tbList[id] = { goTable, x }
end

function MaidAcademyCooperation:OnClickNotItem(go, isOn, info)
    local name = go:GetName()
    if name == "@_aorbtn_cooper" then
        ---合作
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidCooperView.Name, info)
    elseif name == "@_aorbtn_cancel" then
        ---取消合作发布请求
        local msg = {}
        msg.uid = info.uid --女仆uid
        MaidAcademyModel:GetInstance():ReleaseCancel(msg, function(data)
            self:UpdateView()
        end)
    elseif name == "@_aorbtn_wenhao" then
        MaidAcademyModel:GetInstance():SetChatStr(info)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ChooseChannelView.Name,
            function(channelargs, firendIdargs)
                local channel = channelargs
                local firendId = firendIdargs or 0

                local json = MaidAcademyModel:GetInstance():GetChatStr()
                ---@type chat.c2s_chat
                local param = {}
                param.channel = channel
                param.content = json
                param.f_uid = firendId
                param.type = ChatInfoType.MaidAcademy
                param.voice = 0
                param.share_id = ""

                ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
                local msg = {}
                msg.channel = channel
                msg.n_content = json
                msg.f_uid = firendId
                msg.type = ChatInfoType.MaidAcademy
                msg.voice = 0
                msg.share_id = ""
                msg, _ = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
                require("ChatViewNet"):GetInstance():SendCHAT(
                    param,
                    _G.handlerbind(self, self.CallSendChat, msg, channel)
                )
            end,
            2
        )
    end
end

function MaidAcademyCooperation:CallSendChat(param, msg, channel)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(411)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatView.Name, channel)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MaidCooperPrivateView.Name)
    end
end

function MaidAcademyCooperation:OnDestroy()
    if self.ThatTimer then
        self.ThatTimer:Stop()
        self.ThatTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.P2CCooperation, self.OnP2CCooperation, self)
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.ReleaseFinish, self.OnReleaseFinish, self)
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.P2CSendApply, self.OnP2CSendApply, self)
end

function MaidAcademyCooperation:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_send then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidCooperRequestView.Name)
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrMaidPanel.Name, 2)
    end

    if name == "$_toggle_coopered" then
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_List, isOn)
        _G.GameUtil.SetActiveByCondition(_G.GetAutoGoTable(self.go_table.toggle_coopered).aortext_ontxt, isOn)
        if isOn then
            self.curSelectToggle = toggletype.coopered
            self:UpdateView()
        end
    end

    if name == "$_toggle_notcooper" then
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_NotList, isOn)
        _G.GameUtil.SetActiveByCondition(_G.GetAutoGoTable(self.go_table.toggle_notcooper).aortext_ontxt, isOn)
        if isOn then
            self.curSelectToggle = toggletype.notcooper
            self:UpdateView()
        end
    end
end

return MaidAcademyCooperation
