---@class MaidChamAttrMaxView : UIBaseView	中文描述
---@field public go_table MaidChamAttrMaxView_GoTable GoTable
local MaidChamAttrMaxView = _G.BaseClass("MaidChamAttrMaxView", _G.UIBaseView)

local MaidAcademyModel = require("MaidAcademyModel")

function MaidChamAttrMaxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidChamAttrMaxView:OnCreate()
    ---@type study_cfg
    self.cfg = _G.ConfigManager.study_cfg[MaidAcademyModel:GetInstance().level]
    self:UpdateView()
end

---界面的更新方法
function MaidChamAttrMaxView:UpdateView()
    
    for i = 1, 29 do
        local obj = self.go_table["aortext_key3" .. i]
        obj:SetActiveE(0)
    end

    local index = 1
    local attribute = self.cfg.attribute_rate

    for i = 1, #attribute do
        local key = attribute[i][1]
        local type = tonumber(attribute[i][2])
        local value = tonumber(attribute[i][3])
        local obj = self.go_table["aortext_key3" .. index]
        obj:SetActiveE(1)

        if type == 1 then
            if _G.AttrType[key].percentage == 1 then
                _G.MaidUtil.ChambersKeyValue(obj, _G.AttrType[key].des, value / 100 .. "%")
            else
                _G.MaidUtil.ChambersKeyValue(obj, _G.AttrType[key].des, value)
            end
        else
            _G.MaidUtil.ChambersKeyValue(obj, _G.AttrType[key].des, value / 100 .. "%")
        end
        index = index + 1
    end

    self.go_table.aortext_addmax.text = _G.GetLangPackValue(90120200090)
end

---界面的销毁函数
function MaidChamAttrMaxView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidChamAttrMaxView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidChamAttrMaxView
