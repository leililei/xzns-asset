local MaidAcademyModel = require("MaidAcademyModel")

---@class MaidCooperSendView : UIBaseView	中文描述
---@field public go_table MaidCooperSendView_GoTable GoTable
local MaidCooperSendView = _G.BaseClass("MaidCooperSendView", _G.UIBaseView)

function MaidCooperSendView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshList))
end

---界面的入口函数
function MaidCooperSendView:OnCreate(data, roleuid, rolename)
    self.data     = data
    self.roleuid  = roleuid
    self.rolename = rolename
    local cfg = _G.ConfigManager.study_role_cfg[data.sid]
    self.cedList = {}
    self.tbList = {}

    local mf = MaidAcademyModel:GetInstance().finish
    for i = 1, #mf do
        local mcfg = _G.ConfigManager.study_role_cfg[mf[i].sid]
        if mcfg.role_type ~= cfg.role_type then
            table.insert(self.cedList, mf[i])
        end
    end

    _G.SortList(self.cedList, function(a)
        return -a.state
    end)
    self:InitView()
    self:UpdateView()

    

    if self.ThatTimer then
        self.ThatTimer:Stop()
        self.ThatTimer = nil
    end
    self.ThatTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnThatTimer, self)
    self.ThatTimer:Start()
end

function MaidCooperSendView:OnThatTimer(elapsed)
    for k, v in pairs(self.tbList) do
        local infos = v
        local goTable = infos[1]
        local x = infos[2]
        local info = self.cedList[x]

        if info.state == 0 then
            goTable.aortext_sending:SetActiveE(0)
            goTable.aorbtn_cooper:SetActiveE(1)
        else
            if info.state - _G.TimeUtil.GetServerUnixTime() > 0 then
                goTable.aortext_sending:SetActiveE(1)
                goTable.aorbtn_cooper:SetActiveE(0)
                goTable.aortext_sendtime.text = _G.TimeUtil.TimeToString(info.state - _G.TimeUtil.GetServerUnixTime(), 1)
                --发布类型0：未发布，1：人才市场，2：公会，3：申请中
                if info.state_type == 1 then
                    goTable.aortext_sending.text = _G.GetLangPackValue(90120200017)
                elseif info.state_type == 2 then
                    goTable.aortext_sending.text = _G.GetLangPackValue(90120200018)
                elseif info.state_type == 3 then
                    goTable.aortext_sending.text = _G.GetLangPackValue(90120200019)
                else
                    goTable.aortext_sending.text = ""
                end
            else
                goTable.aortext_sending:SetActiveE(0)
                goTable.aorbtn_cooper:SetActiveE(1)
            end
        end
    end
end

---界面创建时的初始化方法
function MaidCooperSendView:InitView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.name[1]) .. _G.GetLangPackValue(self.data.name[2])

    self.go_table.aortext_who.text = _G.GetLangPackValue(90120200049,
        self.rolename or _G.GetLangPackValue(90120200084))

    _G.MaidUtil.Head(self.go_table.aorimage_iconbg, self.data.sid, self.data.spine)
    _G.MaidUtil.Type(self.go_table.aorimage_type, self.data.sid, self.data.level)
    _G.MaidUtil.Power(self.go_table.aorimage_power, self.data.entry_add[1], self.data.level)
    _G.MaidUtil.Quelity(self.go_table.aorimage_quelity, self.data.sid)

    for i = 1, 4 do
        local entry = self.go_table["aorimage_entry" .. i]
        local esid = self.data.r_add[i]
        if esid then
            entry:SetActiveE(1)
            _G.MaidUtil.Entry(entry, esid)
        else
            entry:SetActiveE(0)
        end
    end
end

---界面的更新方法
function MaidCooperSendView:UpdateView()
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nomaid, #self.cedList <= 0)
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.cedList)
end

function MaidCooperSendView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.cedList[x]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, info))

    goTable.aortext_name.text = _G.GetLangPackValue(info.name[1]) .. _G.GetLangPackValue(info.name[2])

    _G.MaidUtil.Head(goTable.aorimage_iconbg, info.sid, info.spine)
    _G.MaidUtil.Type(goTable.aorimage_type, info.sid, info.level)
    _G.MaidUtil.Power(goTable.aorimage_power, info.entry_add[1], info.level)
    _G.MaidUtil.Quelity(goTable.aorimage_quelity, info.sid)

    for i = 1, 4 do
        local entry = goTable["aorimage_entry" .. i]
        local esid = info.r_add[i]
        if esid then
            entry:SetActiveE(1)
            _G.MaidUtil.Entry(entry, esid)
        else
            entry:SetActiveE(0)
        end
    end

    if info.state == 0 then
        goTable.aortext_sending:SetActiveE(0)
        goTable.aorbtn_cooper:SetActiveE(1)
    else
        if info.state - _G.TimeUtil.GetServerUnixTime() > 0 then
            goTable.aortext_sending:SetActiveE(1)
            goTable.aorbtn_cooper:SetActiveE(0)
            goTable.aortext_sendtime.text = _G.TimeUtil.TimeToString(info.state - _G.TimeUtil.GetServerUnixTime(), 1)
            --发布类型0：未发布，1：人才市场，2：公会，3：申请中
            if info.state_type == 1 then
                goTable.aortext_sending.text = _G.GetLangPackValue(90120200017)
            elseif info.state_type == 2 then
                goTable.aortext_sending.text = _G.GetLangPackValue(90120200018)
            elseif info.state_type == 3 then
                goTable.aortext_sending.text = _G.GetLangPackValue(90120200019)
            else
                goTable.aortext_sending.text = ""
            end
        else
            goTable.aortext_sending:SetActiveE(0)
            goTable.aorbtn_cooper:SetActiveE(1)
        end
    end
    local id = goTable.gameObject:GetInstanceID()
    self.tbList[id] = {goTable, x}
end

function MaidCooperSendView:OnClickItem(go, isOn, info)
    local name = go:GetName()
    if name == "@_aorbtn_cooper" then
        ---发起请求
        --   required uint64 r_uid = 1;  //对方玩家uid
        --   required uint64 r_s_uid = 2;  //对方女仆uid
        --   required uint64 s_uid = 3;   //自身女仆uid
        local msg = {}
        msg.r_uid = self.roleuid
        msg.r_s_uid = self.data.uid
        msg.s_uid = info.uid
        MaidAcademyModel:GetInstance():Apply(msg, function(data)
            self:Close()
            _G.PopWindowManager:GetInstance():ShowAllTips(9012012)
        end)
    end
end

---界面的销毁函数
function MaidCooperSendView:OnDestroy()
    if self.ThatTimer then
        self.ThatTimer:Stop()
        self.ThatTimer = nil
    end
end

---按钮点击事件在这里派发
function MaidCooperSendView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidCooperSendView
