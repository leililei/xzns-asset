---@class MaidStudyLevelView : UIBaseView	中文描述
---@field public go_table MaidShrineLevelView_GoTable GoTable
local MaidStudyLevelView = _G.BaseClass("MaidStudyLevelView", _G.UIBaseView)

function MaidStudyLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidStudyLevelView:OnCreate()
    local model = require("MaidAcademyModel"):GetInstance()
    self.curLevel = model.level

    self.PreList = {}

    local cfg = _G.ConfigManager.study_cfg
    for i = 1, #cfg do
        local curcfg = cfg[i]
        local info = {}
        info.level = curcfg.level
        info.neednum = curcfg.exp
        local rlevelcfg = _G.ConfigManager.study_role_level_cfg[curcfg.level]
        info.studymax = rlevelcfg.position_pay
        info.strengthmax = curcfg.physical[1]

        table.insert(self.PreList, info)
    end

    self.go_table.aortext_curstudynum.text = _G.GetLangPackValue(90120200129, model.study_info[1])

    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidStudyLevelView:InitView()
    for i = 1, #self.PreList do
        local item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_total)
        local goitem = _G.GetAutoGoTable(item)
        goitem.aortext_level.text = self.PreList[i].level
        goitem.aortext_neednum.text = self.PreList[i].neednum
        goitem.aortext_studymax.text = _G.GetLangPackValue(90120200132, self.PreList[i].studymax)
        goitem.aortext_strengthmax.text = _G.GetLangPackValue(90120200133, self.PreList[i].strengthmax)

        if self.curLevel == self.PreList[i].level then
            ---亮起，设置不一样的高亮显示
            goitem.aortext_level.color = require("CardInfoManager").GetColorFromRGB("ffd426")
            goitem.aortext_neednum.color = require("CardInfoManager").GetColorFromRGB("41f065")
            goitem.aortext_studymax.color = require("CardInfoManager").GetColorFromRGB("f1ef5b")
            goitem.aortext_strengthmax.color = require("CardInfoManager").GetColorFromRGB("f1ef5b")
        else
            goitem.aortext_level.color = require("CardInfoManager").GetColorFromRGB("edeae0")
            goitem.aortext_neednum.color = require("CardInfoManager").GetColorFromRGB("98cfa3")
            goitem.aortext_studymax.color = require("CardInfoManager").GetColorFromRGB("f4f4bd")
            goitem.aortext_strengthmax.color = require("CardInfoManager").GetColorFromRGB("f4f4bd")
        end
        item:SetActiveE(1)
    end
end

---界面的更新方法
function MaidStudyLevelView:UpdateView()
end

---界面的销毁函数
function MaidStudyLevelView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidStudyLevelView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidStudyLevelView
