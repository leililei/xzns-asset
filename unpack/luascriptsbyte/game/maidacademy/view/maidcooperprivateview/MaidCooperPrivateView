local MaidAcademyModel = require("MaidAcademyModel")

---@class MaidCooperPrivateView : UIBaseView	中文描述
---@field public go_table MaidCooperPrivateView_GoTable GoTable
local MaidCooperPrivateView = _G.BaseClass("MaidCooperPrivateView", _G.UIBaseView)

function MaidCooperPrivateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshList))
end

---界面的入口函数
function MaidCooperPrivateView:OnCreate(callback)
    self.CallBack = callback
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidCooperPrivateView:InitView()
    self.limitMaid = 0
    self.go_table.obj_sitem:SetActiveE(0)
    self.go_table.input_limitLevel.onEndEdit:AddListener(_G.handler(self, self.OnEndInputMaid))
end

---直接输入 玩家id
function MaidCooperPrivateView:OnEndInputMaid(input)
    local maid = _G.tonumber(input)
    if nil ~= maid then
        self.limitMaid = maid
        self.go_table.input_limitLevel.text = self.limitMaid
    end
end

---界面的更新方法
function MaidCooperPrivateView:UpdateView()
    require("FriendManager"):GetInstance():GetFriendListInServer(
        function(list)
            self.numList = _G.table.count(list)
            self.FriendList = list
            self.FriendUidList = {}
            for i, _ in pairs(list) do
                _G.table.insert(self.FriendUidList, i)
        end
            _G.table.sort(
                self.FriendUidList,
                function(a, b)
                    if list[a].time == 0 and list[b].time ~= 0 then
                        return true
                    elseif list[b].time == 0 then
                        return false
                    end
                    return list[a].time > list[b].time
                end
            )
            self.go_table.scrollloopvectical_itemList:UpdateCount(self.numList)
        end
    )
end

function MaidCooperPrivateView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local data = self.FriendList[self.FriendUidList[x]]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))

    goTable.aortext_name.text = data.name or "???"

    local server = _G.ServerManager:GetInstance():GetServerNameByServerID(data.server)
    if server then
        goTable.aortext_server.text = _G.GetLangPackValue(90020100025) .. server
    else
        goTable.aortext_server.text =
            _G.GetLangPackValue(90020100025) .. _G.ServerManager:GetInstance().CurServer.ServerName
    end

    goTable.aortext_maidnum.text = GetLangPackValue(90120200065, data.study_info and data.study_info[1]  or 0)

    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = data.frame
    Params_PlayerHeadItem.lv = data.lv
    Params_PlayerHeadItem.style = data.style
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[data.style].ID
    Params_PlayerHeadItem.title = data.title
    _G.UIUtils.SetPlayerHeadItemNew(goTable.obj_FriendHead, Params_PlayerHeadItem, 0.75, true, true, true)
end

function MaidCooperPrivateView:OnClickItem(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_choose" then
        ---选择
        if self.CallBack then
            self.CallBack(4, data.uid)
        end
        self:Close()
    end
end

---界面的销毁函数
function MaidCooperPrivateView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidCooperPrivateView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_search then
        ---搜索
        if self.limitMaid and self.limitMaid > 0 then
            local msg = {}
            msg.condition = tostring(self.limitMaid)
            require("FriendsNet"):GetInstance():SeekPlayerAccess(
                msg,
                function(data)
                    if data and data.ack == 1 and data.friend then
                        local pdata = data.friend[1]
                        self.SearchUid = pdata.uid
                        self.go_table.obj_sitem:SetActiveE(1)
                        self.go_table.aortext_name.text = pdata.name or "???"

                        local server = _G.ServerManager:GetInstance():GetServerNameByServerID(pdata.server)
                        if server then
                            self.go_table.aortext_server.text = GetLangPackValue(90020100025) .. server
                        else
                            self.go_table.aortext_server.text =
                                GetLangPackValue(90020100025) .. _G.ServerManager:GetInstance().CurServer.ServerName
                        end

                        self.go_table.aortext_maidnum.text = GetLangPackValue(90120200065, pdata.study_info and pdata.study_info[1] or 0)

                        ---@type Params_PlayerHeadItem
                        local Params_PlayerHeadItem = {}
                        Params_PlayerHeadItem.frame = pdata.frame
                        Params_PlayerHeadItem.lv = pdata.level
                        Params_PlayerHeadItem.style = pdata.style
                        Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[pdata.style].ID
                        Params_PlayerHeadItem.title = pdata.title
                        UIUtils.SetPlayerHeadItemNew(self.go_table.obj_FriendHead, Params_PlayerHeadItem, 0.75, true, true,
                            true)
                    end
                end
            )
        end
    elseif go == self.go_table.aorbtn_choose then
        ---选择
        if self.SearchUid then
            if self.CallBack then
                self.CallBack(4, self.SearchUid)
                self.SearchUid = nil
            end
        end
        self:Close()
    end
end

return MaidCooperPrivateView
