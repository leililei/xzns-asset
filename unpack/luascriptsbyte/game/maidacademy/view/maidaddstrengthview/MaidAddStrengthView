local MaidAcademyModel = require "MaidAcademyModel"

---@class MaidAddStrengthView : UIBaseView	中文描述
---@field public go_table MaidAddStrengthView_GoTable GoTable
local MaidAddStrengthView = _G.BaseClass("MaidAddStrengthView", _G.UIBaseView)

function MaidAddStrengthView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.MaxNum = 4
    self.StreaghTbs = {}

    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshList))

    self:AddListener(_G.eItemUpdata.Updata, self.ResRefresh)
    self:AddListener(_G.eItemUpdata.ResRefresh, self.ResRefresh)
end

function MaidAddStrengthView:ResRefresh()
    self:UpdateResNum()
    self:UpdateHealth()
end

function MaidAddStrengthView:UpdateResNum()
    self.itemid = 203170001
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(self.itemid)
    self.Health = _G.StorageManager:GetInstance():GetItemCountByID(storageId, self.itemid)
    self.go_table.aortext_value.text = self.Health
end

---界面的入口函数
function MaidAddStrengthView:OnCreate()
    self:UpdateData()
    self:UpdateView()

    if self.ThatTimer then
        self.ThatTimer:Stop()
        self.ThatTimer = nil
    end
    self.ThatTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnThatTimer, self)
    self.ThatTimer:Start()
    self:OnThatTimer()
end

---体力变化
function MaidAddStrengthView:OnThatTimer(elapsed)
    for i = 1, #self.PosList do
        local info = self.PosList[i]
        if info then
            local goTable = self.StreaghTbs[i]
            local addedtime = (_G.TimeUtil.GetServerUnixTime() - info.l_time) % self.restStrengthBl
            if addedtime == 0 then
                info.physical = info.physical + 1
                if info.physical > self.maxStreng then
                    info.physical = self.maxStreng
                end
                if goTable then
                    local add = self.AddNum[i] or 0

                    if add > 0 then
                        goTable.aortext_connum.text = info.physical .. "<color=#71b16e>+" .. add .. "</color>"
                    else
                        goTable.aortext_connum.text = info.physical
                    end
                end
            end

            if goTable then
                if info.physical >= self.maxStreng then
                    goTable.aortext_time.text =""
                else
                goTable.aortext_time.text = _G.GetLangPackValue(90120200053,
                    _G.TimeUtil.TimeToString(self.restStrengthBl - addedtime, 2))
                end
            end
        end
    end
end

function MaidAddStrengthView:UpdateData()
    ---@type study_cfg
    self.cfg = _G.ConfigManager.study_cfg[MaidAcademyModel:GetInstance().level]
    self.maxStreng = self.cfg.physical[1]      --体力上限
    self.restStrengthBl = self.cfg.physical[2] --x秒回复1点体力
    self.PosList = {}
    local poss = MaidAcademyModel:GetInstance().pos
    _G.SortList(poss, function(a)
        return -a.index
    end)
    for i = 1, self.MaxNum do
        if self.cfg.position >= i then
            ---解锁了
            local posdata = poss[i]
            ---女仆没满并且槽位有体力
            if posdata and posdata.s_role then
                table.insert(self.PosList, posdata)
            end
        end
    end
end

---界面的更新方法
function MaidAddStrengthView:UpdateView()
    self.AddNum = {}
    for i = 1, #self.PosList do
        table.insert(self.AddNum, 0)
    end
    self:UpdateResNum()
    self.go_table.aortext_max.text = _G.GetLangPackValue(90120200083, self.cfg.physical[1])
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.PosList)

    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nomaid, #self.PosList <= 0)

    self:UpdateHealth()
end

---更新体力显示
function MaidAddStrengthView:UpdateHealth()
    local addNum = 0
    for _, v in pairs(self.AddNum) do
        addNum = addNum + v
    end
    self.go_table.aortext_connum.text = addNum .. "/" .. self.Health
end

function MaidAddStrengthView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.PosList[x]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, info, obj, x))

    _G.MaidUtil.Head(goTable.aorimage_iconbg, info.s_role.sid, info.s_role.spine)
    _G.MaidUtil.Type(goTable.aorimage_type, info.s_role.sid, info.s_role.level)

    local rcfg = _G.ConfigManager.study_role_level_cfg[info.s_role.level]

    goTable.slider_jd.maxValue = self.cfg.physical[1] - info.physical

    goTable.slider_jd.onValueChanged:AddListener(_G.handlerbind(self, self.ChangeJd, x, goTable, info))

    local add = self.AddNum[x] or 0

    if add > 0 then
        goTable.aortext_connum.text = info.physical .. "<color=#71b16e>+" .. add .. "</color>"
    else
        goTable.aortext_connum.text = info.physical
    end

    local addedtime = (_G.TimeUtil.GetServerUnixTime() - info.l_time) % self.restStrengthBl
    goTable.aortext_time.text = _G.GetLangPackValue(90120200053,
        _G.TimeUtil.TimeToString(self.restStrengthBl - addedtime, 2))

    local needpy = math.min(rcfg.position_pay - info.s_role.grow - info.physical, self.cfg.physical[1] - info.physical)
    if needpy < 0 then
        needpy = 0
    end
    goTable.slider_jd.value = needpy
    goTable.aortext_jd.text = needpy

    goTable.aortext_lwjd.text = info.s_role.grow .. "/" .. rcfg.position_pay

    self.StreaghTbs[x] = goTable
end

function MaidAddStrengthView:ChangeJd(volume, index, goTable, info)
    local value = math.floor(volume)

    self.AddNum[index] = value

    local add = self.AddNum[index] or 0

    if add > 0 then
        goTable.aortext_connum.text = info.physical .. "<color=#71b16e>+" .. add .. "</color>"
    else
        goTable.aortext_connum.text = info.physical
    end

    goTable.aortext_jd.text = value

    self:UpdateHealth()
end

function MaidAddStrengthView:OnClickItem(go, isOn, info, obj, index)
    local name = go:GetName()
    local goTable = _G.GetAutoGoTable(obj)
    if name == "@_aorbtn_add" then
        ---增加进度
        if self.AddNum[index] < self.cfg.physical[1] - info.physical then
            self.AddNum[index] = self.AddNum[index] + 1

            local add = self.AddNum[index] or 0
            goTable.aortext_jd.text = add
            goTable.slider_jd.value = add

            self:UpdateHealth()
        end
    elseif name == "@_aorbtn_sub" then
        ---减少进度
        if self.AddNum[index] >= 1 then
            self.AddNum[index] = self.AddNum[index] - 1

            local add = self.AddNum[index] or 0
            goTable.aortext_jd.text = add
            goTable.slider_jd.value = add

            self:UpdateHealth()
        end
    end
end

---界面的销毁函数
function MaidAddStrengthView:OnDestroy()
    if self.ThatTimer then
        self.ThatTimer:Stop()
        self.ThatTimer = nil
    end
end

---按钮点击事件在这里派发
function MaidAddStrengthView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_add then
        ---加体力
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.itemid)
        -- local ctrl = require "IntegrateBpFdModel":GetInstance():GetController(1014101)
        -- if ctrl == nil then
        --     return
        -- end
        -- _G.UIManager:GetInstance():OpenWindow(ctrl:GetViewName(), ctrl)
    elseif go == self.go_table.aorbtn_use then
        ---使用体力道具补充体力
        local addNum = 0
        for _, v in pairs(self.AddNum) do
            addNum = addNum + v
        end
        if addNum <= self.Health then
            local msg = {}
            msg.use = {}
            for i = 1, #self.PosList do
                local info = {}
                local num = self.AddNum[i]
                if num > 0 then
                    info.key = self.PosList[i].index
                    info.value = num
                    table.insert(msg.use, info)
                end
            end
            if #msg.use > 0 then
                MaidAcademyModel:GetInstance():AddStrength(msg, function(data)
                    if data.use_num then
                        _G.StorageManager:GetInstance():ConsumeItem(self.itemid, 0, data.use_num)
                    end
                    self:UpdateData()
                    self:UpdateView()
                end)
            else
                if _G.AppSetting.Debug then
                    _G.Log("未选择补充体力")
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(9012010)
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1080305)
        end
    end
end

return MaidAddStrengthView
