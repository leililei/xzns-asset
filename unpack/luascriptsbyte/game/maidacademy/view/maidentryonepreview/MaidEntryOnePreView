---@class MaidEntryOnePreView : UIBaseView	中文描述
---@field public go_table MaidEntryOnePreView_GoTable GoTable
local MaidEntryOnePreView = _G.BaseClass("MaidEntryOnePreView", _G.UIBaseView)

function MaidEntryOnePreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidEntryOnePreView:OnCreate(esid, outPos)
    self.esid = esid
    self.outPos = outPos
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidEntryOnePreView:InitView()
    _G.MaidUtil.Entry(self.go_table.aorimage_entry, self.esid)
    local ecfg = _G.ConfigManager.study_entry_cfg[self.esid]
    self.go_table.aortext_desc.text = _G.GetLangPackValue(ecfg.describe)
    local x = math.min(720/2-413, self.outPos.x)
    self.go_table.obj_panel:SetLocalPosition(x, self.outPos.y, 0)
end

---界面的更新方法
function MaidEntryOnePreView:UpdateView()
end

---界面的销毁函数
function MaidEntryOnePreView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidEntryOnePreView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidEntryOnePreView