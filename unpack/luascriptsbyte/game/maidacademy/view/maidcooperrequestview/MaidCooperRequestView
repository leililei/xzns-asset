local MaidAcademyModel = require("MaidAcademyModel")

---@class MaidCooperRequestView : UIBaseView	中文描述
---@field public go_table MaidCooperRequestView_GoTable GoTable
local MaidCooperRequestView = _G.BaseClass("MaidCooperRequestView", _G.UIBaseView)

function MaidCooperRequestView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshList))
end

---界面的入口函数
function MaidCooperRequestView:OnCreate()
    self.cList = {}

    ---获取申请信息
    MaidAcademyModel:GetInstance():GetApply(function(data)
        self.cList = data.apply or {}
        self:InitView()
        self:UpdateView()
        if #self.cList <= 0 then
            MaidAcademyModel:GetInstance().HasRequest = 0
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidHasRequest.id)
        end
    end)
end

---界面创建时的初始化方法
function MaidCooperRequestView:InitView()
    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.P2CApply, self.OnP2CApply, self)
end

function MaidCooperRequestView:OnP2CApply(data)
    --收到新的申请的推送
    local info = {}
    info.s_uid = data.uid
    info.s_info = data.s_role
    table.insert(self.cList, info)
    self:UpdateView()
end

---界面的更新方法
function MaidCooperRequestView:UpdateView()
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nomaid, #self.cList <= 0)
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.cList)
end

function MaidCooperRequestView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.cList[x]
    local myinfo = MaidAcademyModel:GetInstance():GetMiadByUid(info.s_uid)
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, myinfo, info))

    local maid1 = _G.GetAutoGoTable(goTable.obj_maid1)

    maid1.aortext_name.text = _G.GetLangPackValue(myinfo.name[1]) .. _G.GetLangPackValue(myinfo.name[2])

    _G.MaidUtil.Head(maid1.aorimage_iconbg, myinfo.sid, myinfo.spine, true, myinfo, _G.PlayerModel:GetInstance():GetName())
    _G.MaidUtil.Type(maid1.aorimage_type, myinfo.sid, myinfo.level)
    _G.MaidUtil.Power(maid1.aorimage_power, myinfo.entry_add[1], myinfo.level)
    _G.MaidUtil.Award(maid1.aorrawimage_award, myinfo.level)

    ---这里需要两组数据，目前只有一组，找服务器看
    local maid2 = _G.GetAutoGoTable(goTable.obj_maid2)

    maid2.aortext_name.text = _G.GetLangPackValue(info.s_info.name[1]) .. _G.GetLangPackValue(info.s_info.name[2])

    _G.MaidUtil.Head(maid2.aorimage_iconbg, info.s_info.sid, info.s_info.spine, true, info.s_info,
        info.s_info.role_uid > 0 and info.s_info.role_name or _G.GetLangPackValue(90120200084))
    _G.MaidUtil.Type(maid2.aorimage_type, info.s_info.sid, info.s_info.level)
    _G.MaidUtil.PowerR(maid2.aorimage_powerR, info.s_info.entry_add[1], info.s_info.level)
    _G.MaidUtil.Award(maid2.aorrawimage_award, info.s_info.level)

    goTable.aortext_who.text = _G.GetLangPackValue(90120200049,
        info.s_info.role_uid > 0 and info.s_info.role_name or _G.GetLangPackValue(90120200084))
end

---移除请求信息
function MaidCooperRequestView:RemoveRequestInfoByUid(uid)
    for i = 1, #self.cList do
        if self.cList[i].s_info.uid == uid then
            table.remove(self.cList, i)
            break
        end
    end
    if #self.cList <= 0 then
        MaidAcademyModel:GetInstance().HasRequest = 0
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidHasRequest.id)
    end
end

---移除跟自己相关请求信息
function MaidCooperRequestView:RemoveRequestInfoByMyUid(uid)
    local removeNum = 0
    for i = 1, #self.cList do
        if self.cList[i].s_uid == uid then
            removeNum = removeNum + 1
        end
    end
    for i = 1, removeNum do
        for j = 1, #self.cList do
            if self.cList[j].s_uid == uid then
                table.remove(self.cList, j)
                break
            end
        end
    end
    if #self.cList <= 0 then
        MaidAcademyModel:GetInstance().HasRequest = 0
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidHasRequest.id)
    end
end

function MaidCooperRequestView:OnClickItem(go, isOn, myinfo, otherinfo)
    local name = go:GetName()
    if name == "@_aorbtn_argee" then
        ---同意
        self:RecordPower()
        --required uint64 s_uid = 1;  //自身的女仆uid
        --required uint64 role_uid = 2;  //对方玩家uid
        --required uint64 rs_uid = 3;  //对方的女仆uid
        --required uint64 type = 4;  //1：同意，2：拒绝
        local info = {}
        info.s_uid = myinfo.uid
        info.role_uid = otherinfo.s_info.role_uid
        info.rs_uid = otherinfo.s_info.uid
        info.type = 1
        local msg = {}
        msg.c_apply = { info }
        MaidAcademyModel:GetInstance():CheckApply(msg, function(data)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.MaidAcademy)
            self:RemoveRequestInfoByMyUid(myinfo.uid)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,data)
            self:UpdateView()
            self:ShowPowerUp()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidCooperSuccessView.Name, myinfo, otherinfo)
        end)
    elseif name == "@_aorbtn_refuse" then
        ---拒绝
        local info = {}
        info.s_uid = myinfo.uid
        info.role_uid = otherinfo.s_info.role_uid
        info.rs_uid = otherinfo.s_info.uid
        info.type = 2
        local msg = {}
        msg.c_apply = { info }
        MaidAcademyModel:GetInstance():CheckApply(msg, function(data)
            self:RemoveRequestInfoByUid(otherinfo.s_info.uid)
            self:UpdateView()
        end)
    end
end

function MaidCooperRequestView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function MaidCooperRequestView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

---界面的销毁函数
function MaidCooperRequestView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.P2CApply, self.OnP2CApply, self)
end

---按钮点击事件在这里派发
function MaidCooperRequestView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_refuseonekey then
        ---一键拒绝
        local msg = {}
        msg.c_apply = {}
        for i = 1, #self.cList do
            local otherinfo = self.cList[i]
            local myinfo = MaidAcademyModel:GetInstance():GetMiadByUid(otherinfo.s_uid)
            local info = {}
            info.s_uid = myinfo.uid
            info.role_uid = otherinfo.s_info.role_uid
            info.rs_uid = otherinfo.s_info.uid
            info.type = 2
            table.insert(msg.c_apply, info)
        end

        if #msg.c_apply > 0 then
            MaidAcademyModel:GetInstance():CheckApply(msg, function(data)
                self.cList = {}
                MaidAcademyModel:GetInstance().HasRequest = 0
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointMaidHasRequest.id)
                self:UpdateView()
            end)
        end
    end
end

return MaidCooperRequestView
