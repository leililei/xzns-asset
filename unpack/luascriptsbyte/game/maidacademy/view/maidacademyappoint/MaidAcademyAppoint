---@class MaidAcademyAppoint : Component	敌方布阵情报
local MaidAcademyAppoint = _G.BaseClass("MaidAcademyAppoint", _G.Component)

local MaidAcademyModel = require("MaidAcademyModel")

---界面的入口函数
function MaidAcademyAppoint:OnCreate(obj, ...)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    self.ids = { 101, 201, 202, 301, 302 }

    self:UpdateView()
    _G.Events:GetInstance():AddListener(_G.eMaidAcademyEvent.AppointFinish, self.OnAppointFinish, self)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaidAcademyView_huaban,
        self.go_table.obj_eff,
        function(trans)
            if nil == self.go_table then
                _G.DestroyObject(trans)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaidAcademyView_xingguang,
        self.go_table.obj_eff,
        function(trans)
            if nil == self.go_table then
                _G.DestroyObject(trans)
            end
        end
    )
end

---上下阵完成
function MaidAcademyAppoint:OnAppointFinish()
    self:UpdateView()
end

function MaidAcademyAppoint:UpdateView()
    self.AppointList = MaidAcademyModel:GetInstance().appoint

    for i = 1, #self.ids do
        local gotable = _G.GetAutoGoTable(self.go_table["obj_Item" .. i], _G.handlerbind(self, self.OnClickItem, i))
        local cfg = _G.ConfigManager.study_cooperation_cfg[self.ids[i]]
        if cfg.condition_type <= MaidAcademyModel:GetInstance().level then
            ---开了
            local data
            for k = 1, #self.AppointList do
                if self.AppointList[k].index == self.ids[i] then
                    data = self.AppointList[k]
                end
            end
            if data then
                _G.UIUtils.RemoveChildren(gotable.obj_spine1)
                _G.UIUtils.RemoveChildren(gotable.obj_spine2)

                _G.MaidUtil.LoadMiad(data.s_role.spine, gotable.obj_spine1, self.go_table)
                _G.MaidUtil.LoadMiad(data.s_role.p_info.partner.spine, gotable.obj_spine2, self.go_table)

                gotable.aorimage_infodi:SetActiveE(0)
                gotable.aorbtn_curMaid:SetActiveE(1)
            else
                gotable.aorimage_infodi:SetActiveE(1)
                gotable.aorbtn_noMaid:SetActiveE(1)
                gotable.obj_lock:SetActiveE(0)
                gotable.aorbtn_curMaid:SetActiveE(0)

                _G.UIUtils.RemoveChildren(gotable.obj_spine1)
                _G.UIUtils.RemoveChildren(gotable.obj_spine2)
            end
        else
            gotable.aorimage_infodi:SetActiveE(1)
            gotable.aorbtn_noMaid:SetActiveE(0)
            gotable.obj_lock:SetActiveE(1)
            gotable.aorbtn_curMaid:SetActiveE(0)

            _G.UIUtils.RemoveChildren(gotable.obj_spine1)
            _G.UIUtils.RemoveChildren(gotable.obj_spine2)
        end
        gotable.aorimage_otheradd.SpriteName = cfg.icon or "ui_nvxy_diban_sx_lan"
        gotable.aortext_addname.text = _G.GetLangPackValue(cfg.name)
        gotable.aortext_addnum.text = "额外 + " .. cfg.cooperation_level / 100 .. "%"
    end

    local attribute = MaidAcademyModel:GetInstance():GetAllAppiotAttr()
    _G.UIUtils.RemoveChildren(self.go_table.obj_prop)

    if attribute.attriOther then
        for k, v in pairs(attribute.attriOther) do
            if v ~= 0 then
                local obj = _G.InstantiateObject(self.go_table.obj_attritem, self.go_table.obj_prop)
                local tb = _G.GetAutoGoTable(obj)
                tb.aortext_attrvalue.text = _G.AttrType[k].des .. "+" .. _G.Mathf.RoundToInt(v * 1000) / 10 .. "%"
            end
        end
    end

    if attribute.attributePercent then
        for k, v in pairs(attribute.attributePercent) do
            if v ~= 0 then
                local obj = _G.InstantiateObject(self.go_table.obj_attritem, self.go_table.obj_prop)
                local tb = _G.GetAutoGoTable(obj)
                tb.aortext_attrvalue.text = _G.AttrType[k].des .. "+" .. _G.Mathf.RoundToInt(v * 1000) / 10 .. "%"
            end
        end
    end
    if attribute.attribute then
        for k, v in pairs(attribute.attribute) do
            if v ~= 0 then
                local obj = _G.InstantiateObject(self.go_table.obj_attritem, self.go_table.obj_prop)
                local tb = _G.GetAutoGoTable(obj)
                tb.aortext_attrvalue.text = _G.AttrType[k].des .. "+" .. _G.Mathf.RoundToInt(v * 1000) / 10 .. "%"
            end
        end
    end
end

function MaidAcademyAppoint:OnClickItem(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_noMaid" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidAppointView.Name, self.ids[index])
    elseif name == "@_aorbtn_curMaid" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidAppointView.Name, self.ids[index])
    elseif name == "@_aorbtn_curlock" then
        local cfg = _G.ConfigManager.study_cooperation_cfg[self.ids[index]]
        _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90120200117, cfg.condition_type))
    end
end

function MaidAcademyAppoint:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eMaidAcademyEvent.AppointFinish, self.OnAppointFinish, self)
end

function MaidAcademyAppoint:OnClickBtn(go)
    if go == self.go_table.aorbtn_wenhao then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidChambersView.Name, 2)
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrMaidPanel.Name, 2)
    end
end

return MaidAcademyAppoint
