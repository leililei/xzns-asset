---@class MaidEntryTotalPreView : UIBaseView	中文描述
---@field public go_table MaidEntryTotalPreView_GoTable GoTable
local MaidEntryTotalPreView = _G.BaseClass("MaidEntryTotalPreView", _G.UIBaseView)

local MaidAcademyModel = require("MaidAcademyModel")

function MaidEntryTotalPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidEntryTotalPreView:OnCreate()
    self.PreList = {}
    self.cfg = _G.ConfigManager.study_role_level_cfg
    for i = 1, #self.cfg do
        local add = self.cfg[i].study_entry_add
        if #add > 0 then
            local info = {}
            info.title = self.cfg[i].level
            info.entry = add
            table.insert(self.PreList, info)
        end
    end
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidEntryTotalPreView:InitView()
    for i = 1, #self.PreList do
        local title = _G.InstantiateObject(self.go_table.obj_title, self.go_table.obj_total)
        local allct = _G.InstantiateObject(self.go_table.obj_allct, self.go_table.obj_total)
        local gotitle = _G.GetAutoGoTable(title)
        gotitle.aortext_title.text = _G.GetLangPackValue(90120200041, self.PreList[i].title, MaidAcademyModel:GetInstance().level, self.PreList[i].title)

        if MaidAcademyModel:GetInstance().level >= self.PreList[i].title then
            gotitle.aortext_title.color = require("CardInfoManager").GetColorFromRGB("3EE540")
        else
            gotitle.aortext_title.color = require("CardInfoManager").GetColorFromRGB("363C4B")
        end
        local entry = self.PreList[i].entry
        for j = 1, #entry do
            local tentry = _G.InstantiateObject(self.go_table.aorimage_entry, allct)
            tentry:SetName("$_aorimage_entry")
            _G.MaidUtil.Entry(tentry, entry[j])
        end
    end
end 

---界面的更新方法
function MaidEntryTotalPreView:UpdateView()
    
end

---界面的销毁函数
function MaidEntryTotalPreView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidEntryTotalPreView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidEntryTotalPreView