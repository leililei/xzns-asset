local MaidAcademyModel = require("MaidAcademyModel")

---@class MaidInfoView : UIBaseView	中文描述
---@field public go_table MaidInfoView_GoTable GoTable
local MaidInfoView = _G.BaseClass("MaidInfoView", _G.UIBaseView)

function MaidInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidInfoView:OnCreate(data, isself, role_name, chooseindex)
    self.data = data
    self.isSelf = isself
    self.roleName = role_name
    self.chooseindex = chooseindex
    self.cfg = _G.ConfigManager.study_cfg[MaidAcademyModel:GetInstance().level]

    self.PosList = MaidAcademyModel:GetInstance().pos
    _G.SortList(self.PosList, function(a)
        return -a.index
    end)

    self:UpdateView()
end

function MaidInfoView:UpdateData(data)
    self.data = data
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidInfoView:UpdateView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.name[1]) .. _G.GetLangPackValue(self.data.name[2])

    local attrs = { "atk", "bre", "def", "max_hp" }

    local cfg = _G.ConfigManager.study_role_cfg[self.data.sid]
    local rcfg = _G.ConfigManager.study_role_level_cfg[self.data.level]

    for i = 1, 4 do
        local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrs[i]].ID]
            .name)
        local attrValue = _G.tonumber(cfg[attrs[i]])

        if self.isSelf then
            self.go_table["aortext_attr" .. i].text = attrName ..
            ":" .. math.floor(attrValue * MaidAcademyModel:GetInstance():GetPropRate(self.data.grow, self.data.level))
        else
            self.go_table["aortext_attr" .. i].text = attrName ..
            ":" .. math.floor(attrValue * MaidAcademyModel:GetInstance():GetPropRate(rcfg.position_pay, self.data.level))
        end
    end

    _G.MaidUtil.Type(self.go_table.aorimage_type, self.data.sid, self.data.level)
    _G.MaidUtil.Quelity(self.go_table.aorimage_quelity, self.data.sid)

    if self.isSelf then
        _G.MaidUtil.Power(self.go_table.aorimage_power, nil)
        self.go_table.slider_level.value = self.data.grow / rcfg.position_pay
        self.go_table.aortext_Slider.text = self.data.grow .. "/" .. rcfg.position_pay
    else
        _G.MaidUtil.Power(self.go_table.aorimage_power, self.data.entry_add[1], self.data.level)
    end

    _G.UIUtils.RemoveChildren(self.go_table.obj_spine)
    _G.MaidUtil.LoadMiad(self.data.spine, self.go_table.obj_spine, self.go_table)

    for i = 1, 6 do
        local character = self.go_table.obj_allct:GetChildE(i - 1)
        local esid = self.data.r_add[i]
        if esid then
            character:SetActiveE(1)
            _G.MaidUtil.Character(character, esid)
        else
            character:SetActiveE(0)
        end
    end

    if self.isSelf then
        self.go_table.obj_runingmaid:SetActiveE(1)
        for i = 1, 4 do
            local citem = self.go_table.obj_runingmaid:GetChildE(i - 1)
            local gocitem = _G.GetAutoGoTable(citem, _G.handlerbind(self, self.OnClickItemBtn, i))

            if self.cfg.position >= i then
                ---解锁了
                local pdata = self.PosList[i]

                if pdata and pdata.s_role then
                    _G.MaidUtil.Head(gocitem.aorimage_iconbg, pdata.s_role.sid, pdata.s_role.spine)
                    _G.MaidUtil.Type(gocitem.aorimage_type, pdata.s_role.sid, pdata.s_role.level)
                    if self.chooseindex == i then
                        gocitem.obj_choose:SetActiveE(1)
                    else
                        gocitem.obj_choose:SetActiveE(0)
                    end
                else
                    _G.MaidUtil.Head(gocitem.aorimage_iconbg, nil)
                    _G.MaidUtil.Type(gocitem.aorimage_type, nil)
                end

                gocitem.aorimage_lock:SetActiveE(0)
            else
                _G.MaidUtil.Head(gocitem.aorimage_iconbg, nil)
                _G.MaidUtil.Type(gocitem.aorimage_type, nil)
                gocitem.aorimage_lock:SetActiveE(1)
            end
        end
        self.go_table.obj_kuang:SetRectTransformSize(699, 983)
        self.go_table.slider_level:SetActiveE(1)
        self.go_table.aortext_cultivatedesc:SetActiveE(1)
        self.go_table.aortext_who:SetActiveE(0)
    else
        self.go_table.obj_runingmaid:SetActiveE(0)
        self.go_table.obj_kuang:SetRectTransformSize(699, 753)
        self.go_table.slider_level:SetActiveE(0)
        self.go_table.aortext_cultivatedesc:SetActiveE(0)
        self.go_table.aortext_who:SetActiveE(1)
        self.go_table.aortext_who.text = _G.GetLangPackValue(90120200049,
            self.roleName or _G.GetLangPackValue(90120200084))
    end
end

---按钮点击事件在这里派发
function MaidInfoView:OnClickItemBtn(go, isOn, i)
    local name = go:GetName()
    if name == "@_aorbtn_click" then
        if self.cfg.position >= i then
            ---解锁了
            local pdata = self.PosList[i]
            if pdata and pdata.s_role then
                self.chooseindex = i
                self:UpdateData(pdata.s_role)
            end
        else
            local unlevel = 0
            for k = 1, #_G.ConfigManager.study_cfg do
                if _G.ConfigManager.study_cfg[k].position == i then
                    unlevel = _G.ConfigManager.study_cfg[k].level
                    break
                end
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90120200117, unlevel))
        end
    end
end

---界面的销毁函数
function MaidInfoView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidInfoView
