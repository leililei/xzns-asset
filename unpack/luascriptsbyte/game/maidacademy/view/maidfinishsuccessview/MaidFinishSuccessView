local MaidAcademyModel = require("MaidAcademyModel")

---@class MaidFinishSuccessView : UIBaseView	中文描述
---@field public go_table MaidFinishSuccessView_GoTable GoTable
local MaidFinishSuccessView = _G.BaseClass("MaidFinishSuccessView", _G.UIBaseView)

function MaidFinishSuccessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidFinishSuccessView:OnCreate(data)
    ---i_study_role
    self.data = data
    self.isnew = true
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidFinishSuccessView:InitView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.name[1]).._G.GetLangPackValue(self.data.name[2])

    local attrs = {"atk", "bre", "def", "max_hp"}

    local cfg = _G.ConfigManager.study_role_cfg[self.data.sid]

    for i = 1, 4 do
        local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrs[i]].ID]
        .name)
        local attrValue = _G.tonumber(cfg[attrs[i]])

        self.go_table["aortext_attr" .. i].text = attrName .. ":" .. math.floor(attrValue * MaidAcademyModel:GetInstance():GetPropRate(self.data.grow, self.data.level))
    end

    _G.MaidUtil.Type(self.go_table.aorimage_type, self.data.sid, self.data.level)
    _G.MaidUtil.Quelity(self.go_table.aorimage_quelity, self.data.sid)
    _G.MaidUtil.Power(self.go_table.aorimage_power, self.data.entry_add[1], self.data.level)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_isnew, self.isnew)

    for i = 1, 6 do
        local character = self.go_table.obj_allct:GetChildE(i - 1)
        local esid = self.data.r_add[i]
        if esid then
            character:SetActiveE(1)
            _G.MaidUtil.Character(character, esid)
        else
            character:SetActiveE(0)
        end
    end

    _G.MaidUtil.LoadMiad(self.data.spine, self.go_table.obj_spine, self.go_table)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaidFinishSuccessView_effect,
        self.go_table.obj_effect,
        function(tran)
            if nil == self.go_table then
                tran:DestroyObject()
                return
            end
        end
    )
end

---界面的更新方法
function MaidFinishSuccessView:UpdateView()

end

---界面的销毁函数
function MaidFinishSuccessView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidFinishSuccessView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
        _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.CallBackCultivate)
    elseif go == self.go_table.aorbtn_back then
        ---返回
        self:Close()
        _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.CallBackCultivate)
    elseif go == self.go_table.aorbtn_gotocooper then
        ---前往合作
        self:Close()
        _G.Events:GetInstance():Broadcast(_G.eMaidAcademyEvent.GotoCooper)
    end
end

return MaidFinishSuccessView