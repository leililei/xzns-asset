local MaidAcademyModel = require("MaidAcademyModel")

---@class MaidCooperSuccessView : UIBaseView	中文描述
---@field public go_table MaidCooperSuccessView_GoTable GoTable
local MaidCooperSuccessView = _G.BaseClass("MaidCooperSuccessView", _G.UIBaseView)

function MaidCooperSuccessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidCooperSuccessView:OnCreate(mydata, data)
    self.mydata = mydata
    self.data = data
    self.otherdata = data.s_info
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidCooperSuccessView:InitView()
    local maid1 = _G.GetAutoGoTable(self.go_table.obj_maid1)

    maid1.aortext_name.text = _G.GetLangPackValue(self.mydata.name[1]).._G.GetLangPackValue(self.mydata.name[2])

    _G.MaidUtil.Head(maid1.aorimage_iconbg, self.mydata.sid, self.mydata.spine)
    _G.MaidUtil.Type(maid1.aorimage_type, self.mydata.sid, self.mydata.level)
    _G.MaidUtil.Power(maid1.aorimage_power, self.mydata.entry_add[1], self.mydata.level)
    _G.MaidUtil.Award(maid1.aorrawimage_award, self.mydata.level)

    local maid2 = _G.GetAutoGoTable(self.go_table.obj_maid2)

    maid2.aortext_name.text = _G.GetLangPackValue(self.otherdata.name[1]).._G.GetLangPackValue(self.otherdata.name[2])

    _G.MaidUtil.Head(maid2.aorimage_iconbg, self.otherdata.sid, self.otherdata.spine)
    _G.MaidUtil.Type(maid2.aorimage_type, self.otherdata.sid, self.otherdata.level)
    _G.MaidUtil.PowerR(maid2.aorimage_powerR, self.otherdata.entry_add[1], self.otherdata.level)
    _G.MaidUtil.Award(maid2.aorrawimage_award, self.otherdata.level)

    local attrs = {"atk", "bre", "def", "max_hp"}
    local attrValues = {}
    local otherattrValues = {}

    local cfg = _G.ConfigManager.study_role_cfg[self.mydata.sid]
    local othercfg = _G.ConfigManager.study_role_cfg[self.otherdata.sid]

    for i = 1, 4 do
        local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrs[i]].ID]
        .name)
        local attrValue = _G.tonumber(cfg[attrs[i]])

        local studycfg = _G.ConfigManager.study_role_level_cfg[self.mydata.level]
        local curAttrValue = math.floor(attrValue * MaidAcademyModel:GetInstance():GetPropRate(studycfg.position_pay, self.mydata.level))

        self.go_table["aortext_curattr"..i].text = attrName .. ":" .. curAttrValue

        attrValues[i] = curAttrValue

        local otherattrValue = _G.tonumber(othercfg[attrs[i]])

        local studyothercfg = _G.ConfigManager.study_role_level_cfg[self.otherdata.level]
        local curOtherAttrValue = math.floor(otherattrValue * MaidAcademyModel:GetInstance():GetPropRate(studyothercfg.position_pay, self.otherdata.level))

        otherattrValues[i] = curOtherAttrValue
    end

    local stealattr = _G.MaidUtil.GetCooperateAttr(self.mydata.level, attrValues, otherattrValues)

    for i = 1, 4 do
        local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrs[i]].ID]
        .name)
        local attrValue = stealattr[i]

        self.go_table["aortext_addattr"..i].text = attrName .. ":" .. attrValue
    end

    for i = 1, 4 do
        local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrs[i]].ID]
        .name)
        local attrValue = _G.tonumber(cfg[attrs[i]])
        local studycfg = _G.ConfigManager.study_role_level_cfg[self.mydata.level]
        local curAttrValue = math.floor(attrValue * MaidAcademyModel:GetInstance():GetPropRate(studycfg.position_pay, self.mydata.level))

        local attrValuesteal = stealattr[i]

        self.go_table["aortext_attr"..i].text = attrName .. ":" .. (curAttrValue + attrValuesteal)
    end

    for i = 1, 4 do
        local item1 = self.go_table.obj_allct1:GetChildE(i - 1)

        local esid1 = self.mydata.r_add[i]
        if esid1 then
            item1:SetActiveE(1)
            _G.MaidUtil.Character(item1, esid1)
        else
            item1:SetActiveE(0)
        end

        local item2 = self.go_table.obj_allct2:GetChildE(i - 1)

        local esid2 = self.otherdata.r_add[i]
        if esid2 then
            item2:SetActiveE(1)
            _G.MaidUtil.Character(item2, esid2)
        else
            item2:SetActiveE(0)
        end
    end

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaidCooperSuccessView_effect_1,
        self.go_table.obj_effect,
        function(tran)
            if nil == self.go_table then
                tran:DestroyObject()
                return
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaidCooperSuccessView_effect_2,
        self.go_table.obj_effect,
        function(tran)
            if nil == self.go_table then
                tran:DestroyObject()
                return
            end
        end
    )
end

---界面的更新方法
function MaidCooperSuccessView:UpdateView()
    
end

---界面的销毁函数
function MaidCooperSuccessView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidCooperSuccessView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidCooperSuccessView