---@class MaidShrineLevelView : UIBaseView	中文描述
---@field public go_table MaidShrineLevelView_GoTable GoTable
local MaidShrineLevelView = _G.BaseClass("MaidShrineLevelView", _G.UIBaseView)

function MaidShrineLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidShrineLevelView:OnCreate()
    local model = require("HeroicIconModel"):GetInstance()
    self.curLevel = model:GetIconTotalLevel()

    self.PreList = {}

    local cfg = _G.ConfigManager.discrete_cfg[202009]
    for i = 1, #cfg do
        local fav = cfg[i][1]
        local id = cfg[i][2]
        local rollercfg = _G.ConfigManager.study_role_roller_cfg[id]
        local info = {}
        info.level = rollercfg.describe
        info.favorability = fav
        info.quelity = rollercfg.describe2

        table.insert(self.PreList, info)
    end

    self.go_table.aortext_curquelity.text = _G.GetLangPackValue(90120200043, _G.GetLangPackValue(require("MaidAcademyModel"):GetInstance():GetHeroicLevelDesc()))
    self.go_table.aortext_curfavorability.text = _G.GetLangPackValue(90120200044, self.curLevel)

    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidShrineLevelView:InitView()
    for i = 1, #self.PreList do
        local item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_total)
        local goitem = _G.GetAutoGoTable(item)
        goitem.aortext_level.text = _G.GetLangPackValue(self.PreList[i].level)
        goitem.aortext_favorability.text = _G.GetLangPackValue(90120200045, self.PreList[i].favorability)
        goitem.aortext_quelity.text = _G.GetLangPackValue(90120200046, _G.GetLangPackValue(self.PreList[i].quelity))

        if self.curLevel >= self.PreList[i].favorability then
            ---亮起，设置不一样的高亮显示
            goitem.aortext_level.color = require("CardInfoManager").GetColorFromRGB("fff5ae")
            goitem.aortext_favorability.color = require("CardInfoManager").GetColorFromRGB("fff5ae")
            goitem.aortext_quelity.color = require("CardInfoManager").GetColorFromRGB("fff5ae")
        else
            goitem.aortext_level.color = require("CardInfoManager").GetColorFromRGB("aca7b8")
            goitem.aortext_favorability.color = require("CardInfoManager").GetColorFromRGB("aca7b8")
            goitem.aortext_quelity.color = require("CardInfoManager").GetColorFromRGB("aca7b8")
        end
        item:SetActiveE(1)
    end
end

---界面的更新方法
function MaidShrineLevelView:UpdateView()
end

---界面的销毁函数
function MaidShrineLevelView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidShrineLevelView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidShrineLevelView
