---@class MaidDrawSuccessView : UIBaseView	中文描述
---@field public go_table MaidDrawSuccessView_GoTable GoTable
local MaidDrawSuccessView = _G.BaseClass("MaidDrawSuccessView", _G.UIBaseView)

function MaidDrawSuccessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidDrawSuccessView:OnCreate(data)
    ---i_study_role
    self.data = data
    self:InitView()
    self:UpdateView()
end

---界面创建时的初始化方法
function MaidDrawSuccessView:InitView()
    for i = 1, 4 do
        local item = self.go_table.obj_allct:GetChildE(i - 1)
        local esid = self.data.r_add[i]
        if esid then
            item:SetActiveE(1)
            _G.MaidUtil.Character(item, esid)
        else
            item:SetActiveE(0)
        end
    end

    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.name[1]).._G.GetLangPackValue(self.data.name[2])

    _G.MaidUtil.Type(self.go_table.aorimage_type, self.data.sid, self.data.level)
    _G.MaidUtil.Quelity(self.go_table.aorimage_quelity, self.data.sid)

    _G.MaidUtil.LoadMiad(self.data.spine, self.go_table.obj_spine, self.go_table)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaidDrawSuccessView_effect,
        self.go_table.obj_effect,
        function(tran)
            if nil == self.go_table then
                tran:DestroyObject()
                return
            end
        end
    )
end

---界面的更新方法
function MaidDrawSuccessView:UpdateView()
    
end

---界面的销毁函数
function MaidDrawSuccessView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidDrawSuccessView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return MaidDrawSuccessView
