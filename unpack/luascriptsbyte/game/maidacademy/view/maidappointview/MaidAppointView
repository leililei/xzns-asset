---@class MaidAppointView : UIBaseView	中文描述
---@field public go_table MaidAppointView_GoTable GoTable
local MaidAppointView = _G.BaseClass("MaidAppointView", _G.UIBaseView)

local MaidAcademyModel = require("MaidAcademyModel")

function MaidAppointView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshList))
end

function MaidAppointView:IsInAppoint(uid)
    local appoint = MaidAcademyModel:GetInstance().appoint
    for j = 1, #appoint do
        if uid == appoint[j].s_role.uid then
            return true
        end
    end
    return false
end

function MaidAppointView:InitData()
    self.hasSelf = false
    self.appList = {}
    local appoint = MaidAcademyModel:GetInstance().appoint
    local record = MaidAcademyModel:GetInstance().record
    for i = 1, #appoint do
        if self.Index == appoint[i].index then
            self.hasSelf = true
            table.insert(self.appList, appoint[i].s_role)
        end
    end
    if #appoint > 0 then
        for i = 1, #record do
            if not self:IsInAppoint(record[i].uid) then
                ---上阵中的合作过滤
                table.insert(self.appList, record[i])
            end
        end
    else
        for i = 1, #record do
            table.insert(self.appList, record[i])
        end
    end

    self.selectIndex = 0

    self.dropList = {}
    local templist = {}
    local ecfg = _G.ConfigManager.study_entry_cfg
    for k, v in pairs(ecfg) do
        if nil == templist[v.attribute[1][1]] then
            templist[v.attribute[1][1]] = {}
        end
        table.insert(templist[v.attribute[1][1]], k)
    end
    table.insert(self.dropList, { "all" })
    for k, v in pairs(templist) do
        table.insert(self.dropList, { k, v })
    end
end

---界面的入口函数
function MaidAppointView:OnCreate(index)
    self.Index = index
    self:InitData()
    self.go_table.aortext_maxattradd.text = _G.GetLangPackValue(90120200039)
    self:UpdateView()
    self.unfoldDropdown = false
    self:RefreshDropDwon()
end

---界面的更新方法
function MaidAppointView:UpdateView()
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nomaid, #self.appList <= 0)
    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.appList)
end

function MaidAppointView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local info = self.appList[x]
    local goTable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, info))

    local maid1 = _G.GetAutoGoTable(goTable.obj_maid1)

    maid1.aortext_name.text = _G.GetLangPackValue(info.name[1]) .. _G.GetLangPackValue(info.name[2])

    _G.MaidUtil.Head(maid1.aorimage_iconbg, info.sid, info.spine, true, info, _G.PlayerModel:GetInstance():GetName())
    _G.MaidUtil.Type(maid1.aorimage_type, info.sid, info.level)
    _G.MaidUtil.Power(maid1.aorimage_power, info.entry_add[1], info.level)
    _G.MaidUtil.Award(maid1.aorrawimage_award, info.level)

    for i = 1, 4 do
        local item = maid1["aorimage_entry" .. i]
        local esid = info.r_add[i]
        if esid then
            item:SetActiveE(1)
            _G.MaidUtil.Entry(item, esid)
        else
            item:SetActiveE(0)
        end
    end

    local maid2 = _G.GetAutoGoTable(goTable.obj_maid2)

    maid2.aortext_name.text = _G.GetLangPackValue(info.p_info.partner.name[1]) ..
        _G.GetLangPackValue(info.p_info.partner.name[2])

    _G.MaidUtil.Head(maid2.aorimage_iconbg, info.p_info.partner.sid, info.p_info.partner.spine, true, info.p_info.partner, 
        info.p_info.role_uid > 0 and info.p_info.role_name or _G.GetLangPackValue(90120200084))
    _G.MaidUtil.Type(maid2.aorimage_type, info.p_info.partner.sid, info.p_info.partner.level)
    _G.MaidUtil.PowerR(maid2.aorimage_powerR, info.p_info.partner.entry_add[1], info.p_info.partner.level)
    _G.MaidUtil.Award(maid2.aorrawimage_award, info.p_info.partner.level)

    for i = 1, 4 do
        local item = maid2["aorimage_entry" .. i]
        local esid = info.p_info.partner.r_add[i]
        if esid then
            item:SetActiveE(1)
            _G.MaidUtil.Entry(item, esid)
        else
            item:SetActiveE(0)
        end
    end

    goTable.aortext_who.text = _G.GetLangPackValue(90120200049,
        info.p_info.role_uid > 0 and info.p_info.role_name or _G.GetLangPackValue(90120200084))

    if self.hasSelf and x == 1 then
        goTable.aorbtn_up:SetActiveE(0)
        goTable.aorbtn_down:SetActiveE(1)
    else
        goTable.aorbtn_up:SetActiveE(1)
        goTable.aorbtn_down:SetActiveE(0)
    end
end

---刷新下拉列表
function MaidAppointView:RefreshDropDwon()
    self.go_table.obj_templateBg:SetActiveE(self.unfoldDropdown and 1 or 0)
    if self.dropList[self.selectIndex + 1][1] == "all" then
        self.go_table.aortext_label.text = _G.GetLangPackValue(90020200027)
    else
        self.go_table.aortext_label.text = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg
            [_G.AttrType[self.dropList[self.selectIndex + 1][1]].ID].name)
    end
    if self.unfoldDropdown then
        if not self.dropDownListView then
            self.go_table.scrollloopvectical_dropdown:InitItemData(#self.dropList,
                _G.handler(self, self.RefreshDropDownItem))
            self.dropDownListView = self.go_table.scrollloopvectical_dropdown
        else
            self.dropDownListView:UpdateAllItem()
        end
    end
    if self.unfoldDropdown then
        self.go_table.aorimage_arrow:SetLocalEulerAngles(0, 0, 270)
    else
        self.go_table.aorimage_arrow:SetLocalEulerAngles(0, 0, 90)
    end
end

function MaidAppointView:RefreshDropDownItem(index, obj)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickDropItem, index))

    if self.dropList[index + 1][1] == "all" then
        tb.aortext_label.text = _G.GetLangPackValue(90020200027)
    else
        tb.aortext_label.text = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg
            [_G.AttrType[self.dropList[index + 1][1]].ID].name)
    end
    local color = self.selectIndex == index and "8FBF50" or "301E0F"
    tb.aortext_label.color = require("CardInfoManager").GetColorFromRGB(color)
end

function MaidAppointView:OnClickDropItem(_, _, index)
    self.selectIndex = index
    self:RefreshDropDwon()

    if self.dropList[index + 1][1] == "all" then
        self.appList = {}
        local appoint = MaidAcademyModel:GetInstance().appoint
        local record = MaidAcademyModel:GetInstance().record
        for i = 1, #appoint do
            if self.Index == appoint[i].index then
                self.hasSelf = true
                table.insert(self.appList, appoint[i].s_role)
            end
        end
        if #appoint > 0 then
            for i = 1, #record do
                for j = 1, #appoint do
                    if not self:IsInAppoint(record[i].uid) then
                        ---上阵中的合作过滤
                        table.insert(self.appList, record[i])
                    end
                end
            end
        else
            for i = 1, #record do
                table.insert(self.appList, record[i])
            end
        end
    else
        self.appList = {}
        local appoint = MaidAcademyModel:GetInstance().appoint
        local record = MaidAcademyModel:GetInstance().record
        for i = 1, #appoint do
            if self.Index == appoint[i].index then
                self.hasSelf = true
                table.insert(self.appList, appoint[i].s_role)
            end
        end
        if #appoint > 0 then
            for i = 1, #record do
                for j = 1, #appoint do
                    if not self:IsInAppoint(record[i].uid) then
                        ---上阵中的合作过滤
                        local ishas = false
                        for j = 1, #record[i].r_add do
                            if false ~= table.indexof(self.dropList[index + 1][2], record[i].r_add[j]) then
                                ishas = true
                            end
                        end
                        if not ishas then
                            for k = 1, #record[i].entry_add do
                                if false ~= table.indexof(self.dropList[index + 1][2], record[i].entry_add[k]) then
                                    ishas = true
                                end
                            end
                        end
                        if ishas then
                            table.insert(self.appList, record[i])
                            break
                        end
                    end
                end
            end
        else
            for i = 1, #record do
                local ishas = false
                for j = 1, #record[i].r_add do
                    if false ~= table.indexof(self.dropList[index + 1][2], record[i].r_add[j]) then
                        ishas = true
                    end
                end
                if not ishas then
                    for k = 1, #record[i].entry_add do
                        if false ~= table.indexof(self.dropList[index + 1][2], record[i].entry_add[k]) then
                            ishas = true
                        end
                    end
                end
                if ishas then
                    table.insert(self.appList, record[i])
                end
            end
        end
    end
    self:UpdateView()
end

function MaidAppointView:OnClickItem(go, isOn, info)
    local name = go:GetName()
    if name == "@_aorbtn_up" then
        local msg = {}
        msg.uid = info.uid
        msg.index = self.Index
        self:RecordPower()
        MaidAcademyModel:GetInstance():Appoint(msg, function(data)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.MaidAcademy)
            self:Close()
            self:ShowPowerUp()
        end, info)
    elseif name == "@_aorbtn_down" then
        local msg = {}
        msg.uid = 0
        msg.index = self.Index
        self:RecordPower()
        MaidAcademyModel:GetInstance():Appoint(msg, function(data)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.MaidAcademy)
            self:Close()
            self:ShowPowerUp()
        end)
    end
end

function MaidAppointView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function MaidAppointView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    --if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    --end
    self.power = newPower
end

---界面的销毁函数
function MaidAppointView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidAppointView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_dropdown then
        self.unfoldDropdown = not self.unfoldDropdown
        self:RefreshDropDwon()
    elseif go == self.go_table.aorbtn_CloseTips then
        self.unfoldDropdown = false
        self:RefreshDropDwon()
    elseif go == self.go_table.aorbtn_wenhao then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidChamAttrMaxView.Name)
    end
end

return MaidAppointView
