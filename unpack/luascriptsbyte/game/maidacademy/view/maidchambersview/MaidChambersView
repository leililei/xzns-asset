---@class MaidChambersView : UIBaseView	中文描述
---@field public go_table MaidChambersView_GoTable GoTable
local MaidChambersView = _G.BaseClass("MaidChambersView", _G.UIBaseView)

local MaidAcademyModel = require("MaidAcademyModel")

local toggletype = {
    level = 1,
    info = 2
}

function MaidChambersView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MaidChambersView:OnCreate(type)
    -- if nil == type or type == 1 then
    --     self.curSelectToggle = toggletype.level
    --     _G.GameUtil.SetActiveByCondition(self.go_table.obj_level, true)
    --     _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, false)
    -- else
        --self.go_table.toggle_info.isOn = true
        self.curSelectToggle = toggletype.info
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_level, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, true)
    --end
    ---@type study_cfg
    self.cfg = _G.ConfigManager.study_cfg[MaidAcademyModel:GetInstance().level]
    self:UpdateView()
end

---界面的更新方法
function MaidChambersView:UpdateView()
    local study_info = MaidAcademyModel:GetInstance().study_info
    if self.curSelectToggle == toggletype.level then
        local infonames = { _G.GetLangPackValue(90120200023), _G.GetLangPackValue(90120200024), _G.GetLangPackValue(90120200025),
            _G.GetLangPackValue(90120200026) }
        local valuefunction = { "GetLevelChange", "GetCultivateMaxChange", "GetAppointMaxChange", "GetStregthMaxChange" }

        for i = 1, 4 do
            local obj = self.go_table["obj_setting" .. i]
            local key, value = MaidAcademyModel:GetInstance()[valuefunction[i]](MaidAcademyModel:GetInstance())
            _G.MaidUtil.ChambersDescKeyValue(obj, infonames[i], key, value)
        end

        self.go_table.aortext_desc2.text = _G.GetLangPackValue(90120200082, MaidAcademyModel:GetInstance().level)
        local entrys = MaidAcademyModel:GetInstance():GetEntryInfo()
        for i = 1, 4 do
            local obj = self.go_table["aorimage_entry" .. i]
            local esid = entrys[i]
            if esid then
                obj:SetActiveE(1)
                _G.MaidUtil.Entry(obj, esid)
            else
                obj:SetActiveE(0)
            end
        end

        local result, result1 = MaidAcademyModel:GetInstance():GetDrawPro(0)

        for i = 1, 6 do
            local obj = self.go_table["obj_quelity" .. i]
            _G.MaidUtil.ChambersDescKeyValue(obj, _G.GetLangPackValue(MaidShowText[i]), result[i] .. "%",
                result1[i] .. "%")
        end

        self.go_table.aortext_level.text = _G.GetLangPackValue(90120200002, _G.GetLangPackValue(MaidAcademyModel:GetInstance():GetHeroicLevelDesc()), self.cfg.level)

        if MaidAcademyModel:GetInstance():IsMax() then
            local scfg = _G.ConfigManager.study_cfg[MaidAcademyModel:GetInstance().level]
            local finishmax = scfg.exp
            self.go_table.aortext_finishnum.text = _G.GetLangPackValue(9002050021)
        else
            local scfg = _G.ConfigManager.study_cfg[MaidAcademyModel:GetInstance().level + 1]
            local finishmax = scfg.exp
            self.go_table.aortext_finishnum.text = _G.GetLangPackValue(90120200022, study_info[1], finishmax)
        end

        self.go_table.aortext_quelityup.text = _G.GetLangPackValue(90120200030,
            MaidAcademyModel:GetInstance():GetDrawNextLevel())
    else
        ---统计
        local infonames = { _G.GetLangPackValue(90120200034), _G.GetLangPackValue(90120200035), _G.GetLangPackValue(90120200036) }
        for i = 1, 3 do
            local attrName = infonames[i]
            local attrValue = study_info[i] or 0

            _G.MaidUtil.ChambersKeyValue(self.go_table["aortext_key" .. i], attrName, attrValue)
        end

        local attrs = { "atk", "bre", "def", "max_hp" }
        local attrValues = MaidAcademyModel:GetInstance().attr
        for i = 1, 4 do
            local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrs[i]].ID]
                .name)
            local attrValue = math.floor(attrValues[i] or 0)

            _G.MaidUtil.ChambersKeyValue(self.go_table["aortext_key2" .. i], attrName, attrValue)
        end

        for i = 1, 29 do
            local obj = self.go_table["aortext_key3" .. i]
            obj:SetActiveE(0)
        end

        local index = 1
        local attribute = MaidAcademyModel:GetInstance():GetAllAppiotAttr()

        if attribute.attriOther then
            for k, v in pairs(attribute.attriOther) do
                if v ~= 0 then
                    local obj = self.go_table["aortext_key3" .. index]
                    obj:SetActiveE(1)
                    _G.MaidUtil.ChambersKeyValue(obj, _G.AttrType[k].des, _G.Mathf.RoundToInt(v * 1000) / 10 .. "%")
                    index = index + 1
                end
            end
        end

        if attribute.attributePercent then
            for k, v in pairs(attribute.attributePercent) do
                if v ~= 0 then
                    local obj = self.go_table["aortext_key3" .. index]
                    obj:SetActiveE(1)
                    _G.MaidUtil.ChambersKeyValue(obj, _G.AttrType[k].des, _G.Mathf.RoundToInt(v * 1000) / 10 .. "%")
                    index = index + 1
                end
            end
        end
        if attribute.attribute then
            for k, v in pairs(attribute.attribute) do
                if v ~= 0 then
                    local obj = self.go_table["aortext_key3" .. index]
                    obj:SetActiveE(1)
                    _G.MaidUtil.ChambersKeyValue(obj, _G.AttrType[k].des, _G.Mathf.RoundToInt(v * 1000) / 10 .. "%")
                    index = index + 1
                end
            end
        end

        self.go_table.aortext_addmax.text = _G.GetLangPackValue(90120200039)
    end
end

---界面的销毁函数
function MaidChambersView:OnDestroy()
end

---按钮点击事件在这里派发
function MaidChambersView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_showmore then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidEntryTotalPreView.Name)
    elseif go == self.go_table.aorbtn_wenhao then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidShrineLevelView.Name)
    elseif go == self.go_table.aorbtn_wenhaopromax then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidChamAttrMaxView.Name)
    end

    if name == "$_toggle_level" then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_level, isOn)
        if isOn then
            self.curSelectToggle = toggletype.level
            self:UpdateView()
        end
    end

    if name == "$_toggle_info" then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, isOn)
        if isOn then
            self.curSelectToggle = toggletype.info
            self:UpdateView()
        end
    end
end

return MaidChambersView
