local base = require("BaseGameNet")

---@class MaidAcademyNet : BaseGameNet	通信协议
local MaidAcademyNet = _G.BaseClass("MaidAcademyNet", base)
---@return MaidAcademyNet MaidAcademyNet
function MaidAcademyNet:GetInstance()
    return  base.GetInstance(self)
end

---监听推送
function MaidAcademyNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.p2c_study_cooperation.Cmd, self.P2CStudyCooperation)
    self:AddMessageListener(_G.ConfigManager.net_map.p2c_study_apply.Cmd, self.P2CStudyCheckApply)
    self:AddMessageListener(_G.ConfigManager.net_map.game_study_send_apply.Cmd, self.P2CStudySendApply)
end

---合作达成推送
function MaidAcademyNet:P2CStudyCooperation(msg)
    require "MaidAcademyModel":GetInstance():P2CStudyCooperation(msg)
end

---收到新的申请的推送
function MaidAcademyNet:P2CStudyCheckApply(msg)
    require "MaidAcademyModel":GetInstance():P2CStudyCheckApply(msg)
end

---收到新的申请的推送
function MaidAcademyNet:P2CStudySendApply(msg)
    require "MaidAcademyModel":GetInstance():P2CStudySendApply(msg)
end

---获取女仆信息
function MaidAcademyNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_study_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

