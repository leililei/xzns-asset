    goname = string.replace(goname,"$_","")
    local gotable 
    if showtips then
        gotable = _G.GetAutoGoTable(obj,_G.handlerbind(MaidUtil, MaidUtil.ClickHead, spdata, rolename))
    else
        gotable = _G.GetAutoGoTable(obj)
    end
    if sid then
        local rcfg = _G.ConfigManager.study_role_cfg[sid]
        gotable[goname].SpriteName = MaidHeadIconName[rcfg.order] or "TY_Background_kuang_bai"

        local cfg = _G.ConfigManager.study_role_spine_cfg[spid]
        if cfg then
            gotable.aorrawimage_icon:SetActiveE(1)
            gotable.aorrawimage_icon:LoadImage(cfg.Icon)
        end
    else
        gotable[goname].SpriteName = "TY_Background_kuang_bai"
        gotable.aorrawimage_icon:SetActiveE(0)
    end
end

