---设置词条方块的(基础词条)
---@param obj transform 显示节点
---@param esid number 词条sid
function MaidUtil.Entry(obj, esid)
    local goname = obj:GetName()
    goname = string.replace(goname,"$_","")
    local gotable = _G.GetAutoGoTable(obj, _G.handlerbind(MaidUtil, MaidUtil.ClickEntry, esid))
    local ecfg = _G.ConfigManager.study_entry_cfg[esid]
    gotable[goname].SpriteName = MaidLEntry[ecfg.order] or "ui_npxy_diban_sx_hui"
    gotable[goname]:SetNativeSize()
    gotable.aortext_entryname.text = _G.GetLangPackValue(ecfg.name)
    local attrName,attrValueStr = MaidUtil.GetAttrNameAValue(ecfg)
    gotable.aortext_entryvalue.text = attrName .. "+" .. attrValueStr
end

function MaidUtil:ClickEntry(obj, isOn, esid)
    local x, y, z = obj:GetPosition()
    local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, z)
    local topLayer = _G.UIManager:GetInstance().TopLayer:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local _, outPos =
        _G.CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(topLayer,
            _G.Vector2.New(nx, ny), _G.UIManager:GetInstance().UICameraTop)
    
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaidEntryOnePreView.Name, esid, outPos)
end

