---加载女仆spine
---@param spid number spineid
---@param parent transform 显示到父节点
---@param gotable go_table 界面序列化对象
function MaidUtil.LoadMiad(spid, parent, gotable, argsindex)
    local cfg = _G.ConfigManager.study_role_spine_cfg[spid]
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.Portrait,
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if nil == gotable then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(cfg.size)
                local pos_portrait
                if argsindex then
                    pos_portrait = cfg["pos_portrait".. argsindex]
                else
                    pos_portrait = cfg["pos_portrait"]
                end
                trans:SetLocalPosition(pos_portrait[1], pos_portrait[2], pos_portrait[3])
            end
        )
    end
end

---获取合作属性
---@param level number 女仆等级
---@param attr number[] 女仆属性
---@param level number[] 对方女仆属性
---@return stealattr number[] 偷到属性
function MaidUtil.GetCooperateAttr(level, attr, otherattr)
    local cfg = _G.ConfigManager.study_role_level_cfg[level]
    local stealattr = {0, 0, 0, 0}
    if cfg then
        local maxattr = {}
        for i = 1, #attr do
            maxattr[i] = Mathf.RoundToInt(attr[i] * cfg.attribute_max/10000)
        end
        local cangetattr = {}
        for i = 1, #otherattr do
            cangetattr[i] = Mathf.RoundToInt(otherattr[i] * cfg.role_cooperate/10000)
        end

        for k = 1, #cangetattr do
            if cangetattr[k] > maxattr[k] then
                stealattr[k] = maxattr[k]
            else
                stealattr[k] = cangetattr[k]
            end
        end
    end
    return stealattr
end

return MaidUtil


