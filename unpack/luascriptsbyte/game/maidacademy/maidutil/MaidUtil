---获取词条属性名和值
---@param ecfg study_entry_cfg 词条cfg
---@param levelgrow number 倍率
function MaidUtil.GetAttrNameAValue(ecfg, levelgrow)
    local grow = levelgrow or 10000
    local attr = ecfg.attribute[1]
    local attrKey = attr[1]
    local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrKey].ID]
        .name)
    local attrType = _G.tonumber(attr[2])
    local attrValue = _G.tonumber(attr[3]) * grow / 10000
    local attrValueStr = ""

    if attrType == 1 then
        if _G.AttrType[attrKey].percentage == 1 then
            attrValueStr = attrValue / 100 .. "%"
        else
            attrValueStr = tostring(attrValue)
        end
    else
        attrValueStr = attrValue / 100 .. "%"
    end

    return attrName, attrValueStr
end

