---@class MiniGameXKTSSettlementView : UIBaseView	虚空吞噬_结算页面
---@field go_table MiniGameXKTSSettlementView_GoTable
---@field callback fun(type:number):void        @回调函数, type: 0返回, 1-继续, 2-重新开始
local MiniGameXKTSSettlementView = _G.BaseClass("MiniGameXKTSSettlementView", _G.UIBaseView)

function MiniGameXKTSSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function MiniGameXKTSSettlementView:OnCreate(data, callback)
    self.callback = callback

    self:InitUI(data.win, data.next, data.score or -1)
    if data.win then
        self:LoadWinEffect()
    else
        self:LoadLoseEffect()
    end
end

---初始化ui
function MiniGameXKTSSettlementView:InitUI(isWin, hasNext, score)
    self.go_table.aortext_tip:DOFade(0.2, 1):SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo)

    self.go_table.obj_win:SetActiveE(isWin and 1 or 0)
    self.go_table.obj_lose:SetActiveE(isWin and 0 or 1)
    self.go_table.aorbtn_next:SetActiveE(isWin and hasNext and 1 or 0)
    self.go_table.aorbtn_retry:SetActiveE(isWin and 0 or 1)

    if _G.AppSetting.ArraignedType == _G.ArraignedStartType.SwordCasual then
        self.go_table.aorbtn_retry:SetActiveE(1)
        self.go_table.aorbtn_next:SetActiveE(0)
        self.go_table.aorbtn_back:SetActiveE(0)
    end

    --分数信息
    self.go_table.obj_score:SetActiveE(score and score >= 0 and 1 or 0)
    if score and score >= 0 then
        self.go_table.aortext_score.text = tostring(score)
    end
end

---加载胜利特效
function MiniGameXKTSSettlementView:LoadWinEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ShowAwardVBGLight,
        self.go_table.obj_winBGEffect
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ShowAwardVBGShengLI,
        self.go_table.obj_winEffect1
    )
end

--加载失败特效
function MiniGameXKTSSettlementView:LoadLoseEffect()
end

---按钮点击事件在这里派发
function MiniGameXKTSSettlementView:OnClickBtn(go, isOn)
    if _G.AppSetting.ArraignedType == _G.ArraignedStartType.SwordCasual then
        self:Close()
        if self.callback then
            self.callback(2)
        end
        return
    end
    if go == self.go_table.aorbtn_BG or go == self.go_table.aorbtn_back then
        self:Close()
        if self.callback then
            self.callback(0)
        end
    elseif go == self.go_table.aorbtn_next then
        self:Close()
        if self.callback then
            self.callback(1)
        end
        return
    elseif go == self.go_table.aorbtn_retry then
        self:Close()
        if self.callback then
            self.callback(2)
        end
        return
    end
end

return MiniGameXKTSSettlementView
