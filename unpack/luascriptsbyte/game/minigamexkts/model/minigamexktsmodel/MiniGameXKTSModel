local base = _G.GameDataModelBase

---@class MiniGameXKTSModel : GameDataModelBase
---@field GetInstance fun():MiniGameXKTSModel
---@field stages xkts_stage_cfg[]       关卡列表
---@field curStageIndex number          当前进行中的关卡下标
---@field challengeIndex number         挑战中关卡下标
local MiniGameXKTSModel = _G.BaseClass("MiniGameXKTSModel", base)

function MiniGameXKTSModel:__init()
    self.stages = {}
    self.curStageIndex = 1
    for _, cfg in pairs(_G.ConfigManager.xkts_stage_cfg) do
        if cfg.type == 0 then
            table.insert(self.stages, cfg)
        end
    end
    table.sort(self.stages, function(a, b)
        return a.id < b.id
    end)
end

---从服务器拉取数据
function MiniGameXKTSModel:GetDataFormServer()
    self:ParseData()
end

---@param msg any
function MiniGameXKTSModel:ParseData(msg)
    base.ParseData(self)
end

---检测是否全部通关
---@return boolean
function MiniGameXKTSModel:CheckIsAllPass()
    local curStage = self.stages[self.curStageIndex]
    return not curStage
end

---获取当前待挑战关卡下标
---@return number
function MiniGameXKTSModel:GetCurSectionIndex()
    return self.curStageIndex
end

---获取关卡配置
---@return xkts_stage_cfg[]
function MiniGameXKTSModel:GetSectionCfgs()
    return self.stages
end

---挑战
---@param sectionId number 关卡下标
function MiniGameXKTSModel:Challenge(stageIndex)
    local stageCfg = self.stages[stageIndex]
    if not stageCfg then
        local cfg = _G.ConfigManager.xkts_stage_cfg[stageIndex]
        if cfg then
            for index, _cfg in ipairs(self.stages) do
                if _cfg.id == stageIndex then
                    stageCfg = _cfg
                    stageIndex = index
                    break
                end
            end
        end
    end
    if not stageCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("挑战的关卡sectionId不存在: " .. tostring(stageIndex))
        end
        return
    end
    if _G.AppSetting.DEBUG then
        if stageIndex ~= self.curStageIndex then
            _G.LogError("当前挑战的关卡stageIndex错误: " .. tostring(stageIndex))
        end
    end
    self.challengeIndex = stageIndex
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MiniGameXKTSView.Name,
        stageIndex,
        stageCfg,
        _G.handler(self, self.OnChallengeSettlement)
    )
end

---监听挑战结束事件
---@param win boolean 是否胜利
---@param time number 挑战时间
function MiniGameXKTSModel:OnChallengeSettlement(win, time)
    if win and self.curStageIndex == self.challengeIndex then
        self.curStageIndex = self.curStageIndex + 1
        self.challengeIndex = self.challengeIndex + 1
        _G.Events:GetInstance():Broadcast(_G.eMiniSectionGame.MiniSectionPass)
    end

    local hasNextStage = win and (not not self.stages[self.challengeIndex])
    --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MiniGameXKTSView.Name)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MiniGameXKTSSettlementView.Name,
        { win = win, next = hasNextStage, time = time },
        ---@param type number 0返回, 1-继续, 2-重新开始
        function(type)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MiniGameXKTSView.Name)
            if type == 1 or type == 2 then
                self:Challenge(self.challengeIndex)
            end
        end
    )
end

---提审挑战
function MiniGameXKTSModel:ArraignedChallenge()
    local stageCfg = self.stages[1]
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpenedOfArraigned, self)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MiniGameXKTSView.Name,
        1,
        stageCfg,
        _G.handler(self, self.ArraignedSettlement)
    )
end

---提审结算
function MiniGameXKTSModel:ArraignedSettlement(win, time)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MiniGameXKTSSettlementView.Name,
        { win = win, next = false, time = time },
        ---@param type number 2-重新开始
        function(type)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MiniGameXKTSView.Name)
            self:ArraignedChallenge()
        end
    )
end

function MiniGameXKTSModel:OnUIOpenedOfArraigned(name)
    if name ~= _G.ConfigManager.ui_cfg.MiniGameXKTSView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpenedOfArraigned, self)
    ---@type MiniGameXKTSView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(
        _G.ConfigManager.ui_cfg.MiniGameXKTSView.Name
    )
    if view then
        view:SetHelpButtonActive(false)
        view:SetSettingsButtonActive(false)
        view:SetCloseButtonActive(false)
    end
end

return MiniGameXKTSModel
