---@class ThemeSignModel : ThemeActivityBaseModel	中文描述
local base = require "ThemeActivityBaseModel"
local ThemeSignModel = _G.BaseClass("ThemeSignModel", base)

---@return ThemeSignModel ThemeSignModel
function ThemeSignModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ThemeSignModel:__init()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
end

function ThemeSignModel:InitData(msg)
    self.themeData = msg
    self.awardList = {}
    self.awardList = msg.cfg_list
    self.isGet = {}
    if not _G.table.isEmptyOrNil(self.themeData.award_list) then
        for _, v in pairs(self.themeData.award_list) do
            self.isGet[v] = v
        end
    end
    _G.SortList(
        self.awardList,
        function(a)
            return -a.id
        end
    )
    -- _G.table.sort(
    --     self.awardList,
    --     function(a,b)
    --         return a.id < b.id
    --     end
    -- )
    --self:RefreshRedPoint()
end

---销毁对象时,析构函数
function ThemeSignModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
end

function ThemeSignModel:SetCurrentDay()
    for i = 1, #self.awardList do
        if self.isGet[i] == nil then
            self.currentDay = i
            break
        else
            self.currentDay = 999
        end
    end
end

function ThemeSignModel:CheckGet()
    if self.currentDay > 7 then
        return false
    elseif self.currentDay > self.themeData.login_day then
        return false
    elseif self.isGet[self.currentDay] ~= nil then
        return false
    else
        return true
        --self.pageTable[self.currentDay].obj_effect:SetActiveE(1)
    end
end

function ThemeSignModel:ClickAward(msg,award,call)
    local coinsid = require"ThemeActivityManager":GetInstance():GetCoinSid()
    require("ThemeSignNet"):GetInstance():GetSignAward(
        msg,
        function(data)
            if not data.award then
                data.award ={item = {}}
            end
            if award then
                for key, value in pairs(award) do
                    if value.sid == coinsid then
                        local type = {type = {value.sid, value.num}}
                        _G.table.insert(data.award.item, type)
                    end
                end
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self.isGet[msg.id] = msg.id
            if _G.table.isEmptyOrNil(self.themeData.award_list) then
                self.themeData.award_list = {}
            end
            _G.table.insert(self.themeData.award_list,msg.id)
            self:RefreshRedPoint()
            if call then
                call()
            end
        end
    )
end

function ThemeSignModel:GetData()
    return self.themeData
end

function ThemeSignModel:GetIsGet()
    return self.isGet
end

---进入活动
function ThemeSignModel:EnterActivity()
    if #self.awardList >7 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ThemeSignSEView.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ThemeSignView.Name)
    end
end

---初始化红点树{{id,lua,child}} id 红点id ,lua 红点脚本需继承RedPointBaseThemeActivity,child 子功能红点id
function ThemeSignModel:InitRedTree()
    self.redTree = {{1, "RedPointThemeSign", {}}}
end

function ThemeSignModel:CheckRedPoint()
    if _G.table.isEmptyOrNil(self.themeData.award_list) then
        return true
    elseif #self.themeData.award_list >= #self.awardList then
        return false
    elseif self.awardList[#self.awardList].day <= self.themeData.login_day and not self.isGet[1001] then
        return true
    else
        return self.themeData.login_day > #self.themeData.award_list
    end
end

function ThemeSignModel:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
end

return ThemeSignModel
