local base = require("BaseGameNet")

---@class ThemeSignNet : BaseGameNet	通信协议
local ThemeSignNet = _G.BaseClass("ThemeSignNet", base)
---@return ThemeSignNet ThemeSignNet
function ThemeSignNet:GetInstance()
    return base.GetInstance(self)
end

function ThemeSignNet:GetSignAward(data, callBack)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_sign
    local port = base.Access(self, item, data, _G.handler(self, self.GetSignAwardCall))
    self.Call[port] = callBack
end

---@param port number 流水号
---@param data public.s2c_common_ack 返回PB数据
---@param error string 错误信息
function ThemeSignNet:GetSignAwardCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function ThemeSignNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ThemeSignNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return ThemeSignNet
