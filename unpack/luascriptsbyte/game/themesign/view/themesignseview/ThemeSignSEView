---@class ThemeSignSEView : UIBaseView	中文描述
---@field public go_table ThemeSignSEView_GoTable GoTable
local ThemeSignSEView = _G.BaseClass("ThemeSignSEView", _G.UIBaseView)
local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local ThemeSignModel =require("ThemeSignModel"):GetInstance()
local GetLangPackValue = _G.GetLangPackValue
local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
local icons = {
    [1] = "ztqd_riqi_putong",
    [2] = "ztqd_riqi_xuanzhong"
}

local colors = {
    [1] = "f9f1e2",
    [2] = "7F3E23"
}

function ThemeSignSEView:Awake()
    self.pageTable = {}
    self.isGet = {}
    self.anims = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function ThemeSignSEView:CreatEffect()
    _G.DelayDo(0.33,_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_biaotilizi, self.go_table.obj_tittleEffect))
    LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_guangquanchangliang, self.go_table.obj_finalEffect)
    _G.DelayDo(0.46,LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_guangyun, self.go_table.obj_finalEffect))
    LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_fengexian,self.go_table.obj_light)
    _G.DelayDo(0.5,
    function()
        for _,v in pairs(self.pageTable) do
            LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqu, v.obj_effect)
        end
    end)
end

---界面的入口函数
function ThemeSignSEView:OnCreate()
    self.data =ThemeSignModel:GetData()
    self.isGet = ThemeSignModel:GetIsGet()
    self.awardList =ThemeSignModel.awardList
    self.sid = ThemeActivityManager:GetActivityID()
    local time = ThemeActivityManager:GetRTS()
    self.time = _G.TimeUtil.TranslateSecond(time)
    -- if self.time.hour > 0 or self.time.min > 0 or self.time.sec > 0 then
    --     self.time.day = self.time.day + 1
    -- end
    --self.go_table.aortext_time.text = _G.GetLangPackValue(90028500007, self.time.day)
    self.canGetDays = self.data.login_day
    self:InitPage()
    self:InitExtra()
    self:InitGrandPrix()
    self:CreatEffect()
    --self.currentDay = ThemeSignModel:SetCurrentDay()
    --self:CheckGray()
end

function ThemeSignSEView:InitExtra()
    if self.isGet[1001] then
        self.go_table.aorimage_day:SetActiveE(0)
        self.go_table.aorimage_taken:SetActiveE(1)
    else
        self.go_table.aorimage_day:SetActiveE(1)
        self.go_table.aorimage_taken:SetActiveE(0)
    end
end

function ThemeSignSEView:InitGrandPrix()
    self.go_table.slider_mask.value = 7 - self.canGetDays
    local array = {self.awardList[#self.awardList].award[1].sid, self.awardList[#self.awardList].award[1].num}
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        array,
        self.go_table.aorbtn_box,
        function (tran)
            self.GrandAward = tran
            tran:SetGou(self.isGet[1001])
            tran.gameObject:SetLocalScaleXYZ(1)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
end

function ThemeSignSEView:InitPage()
    for i = 1, 7 do
        local tb = _G.GetAutoGoTable(self.go_table["aorbtn_Page" .. i])
        self.pageTable[i] = tb
        tb.aortext_daydark.text = GetLangPackValue(90032010102, i)
        tb.aortext_daylight.text = GetLangPackValue(90032010101, i)
        if self.isGet[i] ~= nil then
            self.pageTable[i].obj_claimed:SetActiveE(1)
        elseif i <= self.data.login_day then
            self:ChangePage(i,true)
        end
        tb.obj_item:SetActiveE(1)
        if not _G.table.isEmptyOrNil(self.awardList[i]) then
            --tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(self.awardList[index].award[1].sid)
            local tb1 = _G.GetAutoGoTable(tb.obj_item)
            local array = {self.awardList[i].award[1].sid, self.awardList[i].award[1].num}
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                array,
                tb1.obj_Root,
                function(tran)
                    self.pageTable[i].tran = tran
                    tran.gameObject:SetLocalScaleXYZ(0.73)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    tran:SetGou(self.isGet[i] ~= nil and true or false)
                end
            )
        end
    end
end
---界面的销毁函数
function ThemeSignSEView:OnDestroy()
end

---按钮点击事件在这里派发
function ThemeSignSEView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif  go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_Page1 then
        self:DayButton(1)
    elseif go == self.go_table.aorbtn_Page2 then
        self:DayButton(2)
    elseif go == self.go_table.aorbtn_Page3 then
        self:DayButton(3)
    elseif go == self.go_table.aorbtn_Page4 then
        self:DayButton(4)
    elseif go == self.go_table.aorbtn_Page5 then
        self:DayButton(5)
    elseif go == self.go_table.aorbtn_Page6 then
        self:DayButton(6)
    elseif go == self.go_table.aorbtn_Page7 then
        self:DayButton(7)
    elseif go == self.go_table.aorbtn_box then
        self:DayButton(1001)
    end
end

function ThemeSignSEView:DayButton(day)
    local index = day
    if day > #self.awardList then
        index = #self.awardList
    end
    if self.canGetDays < self.awardList[index].day or self.isGet[day] then
        return
    end
    self:ClickAward(index,day)
    --ThemeSignModel:RefreshRedPoint()
end

function ThemeSignSEView:ChangePage(day,target)
    if day > 7 and not target then
        self.GrandAward:SetGou(true)
        self.go_table.aorimage_taken:SetActiveE(1)
        self.go_table.aorimage_day:SetActiveE(0)
        return
    end
    if target then
        self.pageTable[day].aorimage_page.SpriteName = icons[2]
        self.pageTable[day].aorimage_page:SetNativeSize()
        self.pageTable[day].aorimage_page:AddLocalPosition(-6,27,0)
        self.pageTable[day].aortext_daylight:SetActiveE(1)
        self.pageTable[day].aortext_daydark:SetActiveE(0)
        self.pageTable[day].obj_item:SetLocalPosition(6.9,-67,0)
        self.pageTable[day].obj_effect:SetActiveE(1)
    else
        self.pageTable[day].aorimage_page.SpriteName = icons[1]
        self.pageTable[day].aorimage_page:SetNativeSize()
        self.pageTable[day].aorimage_page:AddLocalPosition(6,-27,0)
        self.pageTable[day].aortext_daylight:SetActiveE(0)
        self.pageTable[day].aortext_daydark:SetActiveE(1)
        self.pageTable[day].obj_claimed:SetActiveE(1)
        self.pageTable[day].obj_effect:SetActiveE(0)
        self.pageTable[day].tran:SetGou(true)
        self.pageTable[day].obj_item:SetLocalPosition(-1,-54,0)

    end
end

---领取奖励
function ThemeSignSEView:ClickAward(index,day)
    local msg = {activity_id = self.sid, id = self.awardList[index].id}
    ThemeSignModel:ClickAward(msg,self.awardList[index].award,
        function()
            self.data = ThemeSignModel:GetData()
            self.isGet = ThemeSignModel:GetIsGet()
            self:ChangePage(day,false)
        end
    )
end

function ThemeSignSEView:SixUpdata()
    if self.canGetDays >= 7 then
        return
    end
    self.canGetDays = self.canGetDays + 1
    ThemeSignModel.themeData.login_day = self.canGetDays
    self:ChangePage(self.canGetDays,true)
    ThemeSignModel:RefreshRedPoint()
end

return ThemeSignSEView
