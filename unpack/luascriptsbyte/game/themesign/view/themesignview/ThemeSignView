---@class ThemeSignView : UIBaseView	中文描述
---@field public go_table ThemeSignView_GoTable GoTable
local ThemeSignView = _G.BaseClass("ThemeSignView", _G.UIBaseView)
local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local ThemeSignModel = require("ThemeSignModel"):GetInstance()
function ThemeSignView:Awake()
    self.pageTable = {}
    self.isGet = {}
    self.anims = {}
    self.canGet = false
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeSignView_bg, self.go_table.obj_BG)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeSignView_title, self.go_table.obj_tittle)
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
    self.Anim = self.go_table.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---界面的入口函数
function ThemeSignView:OnCreate()
    self.data = ThemeSignModel.themeData
    if not _G.table.isEmptyOrNil(self.data.award_list) then
        for _, v in pairs(self.data.award_list) do
            self.isGet[_] = v
        end
    end
    self.awardList = ThemeSignModel.awardList
    self.sid = ThemeActivityManager:GetActivityID()
    local time = ThemeActivityManager:GetRTS()
    self.time = _G.TimeUtil.TranslateSecond(time)
    -- if self.time.hour > 0 or self.time.min > 0 or self.time.sec > 0 then
    --     self.time.day = self.time.day + 1
    -- end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90028500007, self.time.day)
    self.canGetDays = self.data.login_day
    self:InitPage()
    self:SetCurrentDay()
    self:CheckGet()
    self:CheckGray()
end

function ThemeSignView:Dispose()
    self.Anim = nil
end

function ThemeSignView:FinishAnim()
    if self.Anim then
        self.Anim:Play("loop")
    end
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
end

function ThemeSignView:InitPage()
    for i = 1, 7 do
        --self.go_table['toggle_Page'..i]:AddLocalPosition(0,-29.1,0)
        local tb = _G.GetAutoGoTable(self.go_table["toggle_Page" .. i])
        --tb.obj_halo:SetActiveE(0)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeSignView_biankuang, tb.obj_effect)
        tb.aortext_day.text = _G.GetLangPackValue(90028500006, i)
        tb.Anim = tb.transform:GetComponentE(typeof(CS.UnityEngine.Animator))
        --tb.Anim = self.go_table["toggle_Page" .. i]:GetComponentE(typeof(CS.UnityEngine.Animator))
        self.pageTable[i] = tb
        self.pageTable[i].obj_page:AddLocalPosition(0, -29.1, 0)
        if self.isGet[i] ~= nil then
            self.pageTable[i].obj_claimed:SetActiveE(1)
        elseif i <= self.data.login_day then
            self.pageTable[i].obj_page:AddLocalPosition(0, 29.1, 0)
            self.pageTable[i].Anim.enabled = true
            self.pageTable[i].obj_halo:SetActiveE(1)
        end
        tb.obj_item:SetActiveE(1)
        if not _G.table.isEmptyOrNil(self.awardList[i]) then
            tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(self.awardList[i].award[1].sid)
            local tb1 = _G.GetAutoGoTable(tb.obj_item)
            local array = {self.awardList[i].award[1].sid, self.awardList[i].award[1].num}
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                array,
                tb1.obj_Root,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.73)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            )
        end
    end
end

function ThemeSignView:SetCurrentDay()
    for i = 1, #self.awardList do
        if self.isGet[i] == nil then
            self.currentDay = i
            break
        else
            self.currentDay = 999
        end
    end
end

function ThemeSignView:CheckGet()
    if self.currentDay > 7 then
        self.canGet = false
    elseif self.currentDay > self.canGetDays then
        self.canGet = false
    elseif self.isGet[self.currentDay] ~= nil then
        self.canGet = false
    else
        self.canGet = true
        self.pageTable[self.currentDay].obj_effect:SetActiveE(1)
    end
end
