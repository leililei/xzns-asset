---领取奖励
function ThemeSignView:ClickAward()
    local msg = {activity_id = self.sid, id = self.awardList[self.currentDay].id}
    require("ThemeSignNet"):GetInstance():GetSignAward(
        msg,
        function(data)
            if not data.award then
                data.award ={item = {}}
                if self.awardList[self.currentDay].award then
                    for key, value in pairs(self.awardList[self.currentDay].award) do
                        local item1 = {
                            type = {
                                value.sid,
                                value.num
                            }
                        }
                        _G.table.insert(data.award.item, item1)
                    end
                end
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            if self.data.award_list == nil then
                self.data.award_list = {}
            end
            _G.table.insert(self.data.award_list, self.currentDay)
            _G.table.insert(self.isGet, self.currentDay)
            self:RefreshPage()
        end
    )
end

function ThemeSignView:RefreshPage()
    self.pageTable[self.currentDay].obj_claimed:SetActiveE(1)
    self.pageTable[self.currentDay].Anim.enabled = false
    self.pageTable[self.currentDay].obj_page:AddLocalPosition(0, -29.1, 0)
    self.pageTable[self.currentDay].obj_halo:SetActiveE(0)
    self.pageTable[self.currentDay].obj_effect:SetActiveE(0)
    self:SetCurrentDay()
    self:CheckGet()
    self:CheckGray()
    ThemeSignModel:RefreshRedPoint()
end

function ThemeSignView:SixUpdata()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90028500007, self.time.day - 1)
    self.canGetDays = self.canGetDays + 1
    --self:InitPage()
    self.pageTable[self.canGetDays].obj_page:AddLocalPosition(0, 29.1, 0)
    self.pageTable[self.canGetDays].obj_halo:SetActiveE(1)
    self.pageTable[self.canGetDays].anim.enabled = true
    self:SetCurrentDay()
    self:CheckGet()
    self:CheckGray()
    ThemeSignModel:RefreshRedPoint()
end

function ThemeSignView:CheckGray()
    if self.canGet then
        self.go_table.aorbtn_click:SetGray(false)
        self.go_table.aortext_receive.color = _G.ColorTools.FormatColorByString("823A0F")
    else
        self.go_table.aorbtn_click:SetGray(true)
        self.go_table.aortext_receive.color = _G.ColorTools.FormatColorByString("444444")
    end
end

return ThemeSignView
