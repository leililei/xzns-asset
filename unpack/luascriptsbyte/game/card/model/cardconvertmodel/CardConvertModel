local base = require("GameDataModelBase")
local CardConvertNet = require("CardConvertNet")
local CardResonanceModel = require("CardResonanceModel")

---可转化卡牌的目标品质
local ConvertOrder = 6

---@class CardConvertModel : GameDataModelBase 卡牌转化控制类
---@field GetInstance fun():CardConvertModel
---@field convertNumber number                          @单次最多转化数量
---@field convertDict table<number,number>              @不同种族转化获得的道具
---@field convertInitialOrder table<number,boolean>     @初始可转化卡牌品质
---@field reserveNumber number                          @转化时相同sid的卡牌保留n张
local CardConvertModel = _G.BaseClass("CardConvertModel", base)

function CardConvertModel:__init()
    --self.curFunctionOpenID = _G.FunctionID.CardConvert

    --初始化配置表
    local cfg1 = _G.ConfigManager.discrete_cfg[129001]
    local cfg2 = _G.ConfigManager.discrete_cfg[129002]
    local cfg3 = _G.ConfigManager.discrete_cfg[129003]
    local cfg4 = _G.ConfigManager.discrete_cfg[129004]
    self.reserveNumber = cfg3 and cfg3[1][1] or 1
    self.convertNumber = cfg4 and cfg4[1][1] or 10
    if cfg1 then
        self.convertDict = {}
        for _, v in ipairs(cfg1) do
            self.convertDict[v[1]] = v[2]
        end
    end
    if cfg2 then
        self.convertInitialOrder = {}
        for _, order in ipairs(cfg2[1]) do
            self.convertInitialOrder[order] = true
        end
    end
end

function CardConvertModel:GetFunctionOpen()
    if self.curFunctionOpenID and self.curFunctionOpenID > 0 then
        return base.GetFunctionOpen(self)
    end

    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return false
    end

    --读取离散表条件配置
    local cfg = _G.ConfigManager.discrete_cfg[129006]
    if not cfg then
        return false
    end
    for _, condition in ipairs(cfg) do
        local type, param1 = table.unpack(condition)
        if _G.GlobalConditionManager.CheckCondition(type, param1) then
            return true
        end
    end
    return false
end

function CardConvertModel:Dispose()
end

