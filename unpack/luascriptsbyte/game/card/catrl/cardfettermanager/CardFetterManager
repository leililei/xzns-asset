---@class CardFetterManager	: GameDataModelBase
---@field fetterDataList CardFetterData[] 羁绊数据
local CardFetterManager = _G.BaseClass("CardFetterManager", _G.GameDataModelBase)
---@return CardFetterManager CardFetterManager
function CardFetterManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function CardFetterManager:__init()
    self.curFunctionOpenID = 0
    -- self.fetterDataList = {}
    -- self.cardsidToFetter = {}
    -- self.fetterToCardSid = {}
end

--region 子类重写
---从服务器拉取数据
function CardFetterManager:GetDataFormServer()
    require "CardFetterNet":GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end
---获取解锁数据回调
---@param info card.s2c_card_fetter
function CardFetterManager:GetInfoCall(info)
    self:InitActiveFetter(info)
    self:InitFetterDatas()
    self:ParseData()
end

function CardFetterManager:InitFetterDatas()
    self.fetterDataList = {}
    self.cardsidToFetter = {}
    self.fetterToCardSid = {}
    local CardFetterData = require "CardFetterData"
    ---@type card_cfg[]
    local cfgs = _G.ConfigManager.card_cfg
    for _, v in pairs(cfgs) do
        self.fetterDataList[v.id] = CardFetterData.New(v)
        for _, v2 in pairs(v.fetter) do
            self.fetterToCardSid[v2] = v.id
        end
    end
    local insert = _G.table.insert
    for _, v in pairs(_G.ConfigManager.card_fetter_cfg) do
        for _, v2 in pairs(v.cards) do
            if not self.cardsidToFetter[v2] then
                self.cardsidToFetter[v2] = {}
            end
            insert(self.cardsidToFetter[v2], v.id)
        end
    end
end

---初始化已激活羁绊
---@param info card.s2c_card_fetter
function CardFetterManager:InitActiveFetter(info)
    self.activeFetterList = {}
    if info.fetters then
        for _, v in pairs(info.fetters) do
            if not self.activeFetterList[v.sid] then
                self.activeFetterList[v.sid] = {}
            end
            if v.fetter then
                for _, v2 in pairs(v.fetter) do
                    if not self.activeFetterList[v.sid][v2.fetter_sid] then
                        self.activeFetterList[v.sid][v2.fetter_sid] = {}
                    end
                    for _, v3 in pairs(v2.index) do
                        if not self.activeFetterList[v.sid][v2.fetter_sid][v3] then
                            self.activeFetterList[v.sid][v2.fetter_sid][v3] = {}
                        end
                        self.activeFetterList[v.sid][v2.fetter_sid][v3] = true
                    end
                end
            end
        end
    end
end
---检测羁绊是否解锁
---@param sid number 卡牌sid
---@param index number 下标
---@param fetterId number 羁绊id
function CardFetterManager:CheckIsActive(sid, fetterId, index)
    if
        not self.activeFetterList[sid] or (not self.activeFetterList[sid][fetterId]) or
            not self.activeFetterList[sid][fetterId][index]
     then
        return false
    end
    return true
end

---初始化功能逻辑
function CardFetterManager:InitFunction()
end

---激活属性
---@param pbData card.c2s_card_unlock_fetter
function CardFetterManager:Active(pbData, call)
    require "CardFetterNet":GetInstance():Active(pbData, _G.handlerbind(self, self.ActiveCall, pbData, call))
end

---激活回调
---@param pbData card.c2s_card_unlock_fetter
function CardFetterManager:ActiveCall(msg, pbData, call)
    if msg.ack ~= 1 then
        return
    end
    local tb = {}
    for _, v in pairs(pbData.fetter) do
        for _, v2 in pairs(v.index) do
            self.fetterDataList[pbData.sid]:SetActive(v.fetter_sid, v2)
            require "RedPointManager":GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.CardFetterButton.id,
                v.fetter_sid * 100 + v2
            )
        end
        self.fetterDataList[pbData.sid]:UpdateActiveAttr()
        tb[pbData.sid] = true
    end
    if call then
        call()
    end
end

---激活所有羁绊
---@param sid number dis
function CardFetterManager:ActiveAll(sid, call)
    local tb = self.fetterDataList[sid]:GetCanActiveIds()
    local msg = {sid = sid, fetter = tb}
    self:Active(msg, call)
end

---激活单个羁绊
---@param sid number 卡牌sid
---@param index number 下标
---@param fetterId number 羁绊id
function CardFetterManager:ActiveSingle(sid, fetterId, index, call)
    local msg = {sid = sid, fetter = {{fetter_sid = fetterId, index = {index}}}}
    self:Active(msg, call)
end

---获取卡牌羁绊
---@return CardFetterData
function CardFetterManager:GetCardFetterData(sid)
    return self.fetterDataList[sid]
end
---检测是否可以激活
function CardFetterManager:CheckHasActive(sid)
    if not self.fetterDataList or not self.fetterDataList[sid] then
        return false
    end
    return self.fetterDataList[sid]:CheckHasActive()
end

---获取卡牌激活属性
---@param sid number 卡牌sid
function CardFetterManager:GetCardActiveAttr(sid)
    if not self.fetterDataList or not self.fetterDataList[sid] then
        return _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    end
    return self.fetterDataList[sid]:GetActiveAttr()
end

---更新激活属性
---@param sid number 卡牌 sid
function CardFetterManager:UpdateCanActiveState(sid, fetter)
    if not self.fetterDataList then
        return
    end
    if not sid then
        for _, v in pairs(self.fetterDataList) do
            v:UpdateCanActiveState()
        end
    else
        self.fetterDataList[sid]:UpdateCanActiveState(fetter)
    end
end

---检测某条羁绊是否可以激活
---@param sid number 卡牌 sid
---@param fetter_sid number 羁绊sid
---@param index number 羁绊下标（为Nil则检测整个羁绊）
function CardFetterManager:CheckIsCanActiveSingle(sid, fetter_sid, index)
    if not self.fetterDataList or not self.fetterDataList[sid] then
        return false
    end
    return self.fetterDataList[sid]:CheckCanActiveSingleState(fetter_sid, index)
end
---刷新红点
function CardFetterManager:RefreshRedPoint(add, remove, change)
    if not self.cardsidToFetter then
        return
    end
    local tb = {}
    local addFetter = function(datas)
        if not _G.table.isEmptyOrNil(datas) then
            for _, v in pairs(datas) do
                if self.cardsidToFetter[v] then
                    for _, v3 in pairs(self.cardsidToFetter[v]) do
                        tb[v3] = v3
                    end
                end
            end
        end
    end
    addFetter(add)
    addFetter(remove)
    addFetter(change)
    for _, v in pairs(tb) do
        if self.fetterToCardSid[v] then
            require "CardFetterManager":GetInstance():UpdateCanActiveState(self.fetterToCardSid[v], v)
        end
      for i = 1, _G.CardFetterParams.AttrCount do
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CardFetterButton.id, v*100+i)
      end
    end
end

return CardFetterManager
