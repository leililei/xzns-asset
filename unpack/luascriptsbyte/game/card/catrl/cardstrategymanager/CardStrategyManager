---@class CardStrategyManager : GameDataModelBase	中文描述
---@field CardStrategyView CardStrategyView 主界面显示对象
---@field Cardcfg card_cfg
local CardStrategyManager = _G.BaseClass("CardStrategyManager", _G.Singleton)
_G.CardStrategyManager = CardStrategyManager

---创建对象时,入口构造函数
function CardStrategyManager:__init()
    self.Order = {
        [1] = "ui_ty_icon_n",
        [2] = "ui_ty_icon_r",
        [3] = "ui_ty_icon_sr",
        [4] = "ui_ty_icon_ssr"
    }
    self.EquipmentType = {
        [1] = "ui_js_icon_liliang",
        [2] = "ui_js_icon_minjie",
        [3] = "ui_js_icon_zhili"
    }
    self.starIconName = {
        normal = "ui_ty_icon_xingji1-5x",
        specail = "ui_ty_icon_xingji6-9x"
    }
    self.Professional = _G.ProfessionalIcon
    self.Cardcfg = _G.ConfigManager.card_cfg
    self.card_skills_cfg = _G.ConfigManager.card_skills_cfg
end

---@return CardStrategyManager
function CardStrategyManager:GetInstance()
    return self.super.GetInstance(self)
end

function CardStrategyManager:GetFirstEmptyIndex(heroes)
    for i = 1, #heroes, 2 do
        if heroes[i].uid == 0 and heroes[i + 1].uid == 0 then
            return i
        end
    end
    return nil
end

function CardStrategyManager:GetChooseIndex(index)
    local chooseIndex = index / 2
    if chooseIndex <= 1 then
        if self.chooseIndex then
            self.chooseIndex = 1
        else
            self.chooseIndex = chooseIndex < 1 and 2 or 1
        end
    elseif chooseIndex <= 2 then
        if self.chooseIndex then
            self.chooseIndex = 3
        else
            self.chooseIndex = chooseIndex < 2 and 4 or 3
        end
    elseif chooseIndex <= 3 then
        if self.chooseIndex then
            self.chooseIndex = 5
        else
            self.chooseIndex = chooseIndex < 3 and 6 or 5
        end
    end
end
---引导 典韦解锁
function CardStrategyManager.SetoleUnlock()
    ---@type CardStrategyView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardStrategyView.Name)
    if view ~= nil then
        view:SetoleUnlock()
    end
end
return CardStrategyManager
