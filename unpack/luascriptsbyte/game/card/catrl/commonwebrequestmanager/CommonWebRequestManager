---@class CommonWebRequestManager : Singleton	中文描述
local CommonWebRequestManager = _G.BaseClass("CommonWebRequestManager", _G.Singleton)

local CommonWebRequest = _G.CS.CommonWebRequest
local CommonWebRequestIns = CommonWebRequest.Inst

function CommonWebRequestManager:__init()
    self.RequestCallBack = {}
end
---@return CommonWebRequestManager CommonWebRequestManager
function CommonWebRequestManager:GetInstance()
    return self.super.GetInstance(self)
end

function CommonWebRequestManager:Get(url, token, call)
    self.RequestCallBack[url] = call
    CommonWebRequestIns:CommonWebRequestGet(url, token)
end

function CommonWebRequestManager:Post(url, jsonData, token, call)
    self.RequestCallBack[url] = call
    CommonWebRequestIns:CommonWebRequestPost(url, jsonData, token)
end

function CommonWebRequestManager:Dispose()
    self.RequestCallBack = nil
end

function CommonWebRequestManager.CallLuaGet(url, arg)
    local CommonWebRequestManagerIns = require "CommonWebRequestManager":GetInstance()
    if not CommonWebRequestManagerIns.RequestCallBack or not CommonWebRequestManagerIns.RequestCallBack[url] then
        return
    end
    CommonWebRequestManagerIns.RequestCallBack[url](arg)
end
CommonWebRequest.CallLuaGet = CommonWebRequestManager.CallLuaGet
function CommonWebRequestManager.CallLuaPost(url, arg)
    local CommonWebRequestManagerIns = require "CommonWebRequestManager":GetInstance()
    if not CommonWebRequestManagerIns.RequestCallBack or not CommonWebRequestManagerIns.RequestCallBack[url] then
        return
    end
    CommonWebRequestManagerIns.RequestCallBack[url](arg)
end
CommonWebRequest.CallLuaPost = CommonWebRequestManager.CallLuaPost

return CommonWebRequestManager
