---创建对象时,入口构造函数
function CardCommentManager:__init()
    self.CommentCallBack = {}
    --皮肤信息(已解锁的皮肤id)
    self.i_card_skin = {}
    --已穿戴的 卡牌皮肤信息
    self.i_card_wear_skin = {}
    --卡牌sid-皮肤id 字典
    self.sidSkin = {}
    ---所有已解锁的皮肤id kv
    self.unLockSids = {}
    self:InitCardSkin()
end

--- sid 对应的卡牌 id 皮肤
function CardCommentManager:InitCardSkin()
    ---皮肤配置
    self.skinCfgs = {}
    ---每个卡牌拥有的皮肤
    self.cardSkins = {}
    for _, v in pairs(_G.ConfigManager.card_cfg) do
        self.skinCfgs[v.id] = {
            id = v.id,
            card = v.id,
            name = v.Name,
            Icon = v.Icon,
            Photo = v.Photo,
            portrait = v.Portrait,
            display_entr_ef = v.display_entr,
            display_click_ef = v.display_click,
            skillportrait = v.SkillPortrait,
            pos_portrait6 = v.pos_portrait6,
            size5 = v.size5,
            size2 = v.size2,
            pos_portrait = v.pos_portrait,
            BannerPicSize = v.BannerPicSize,
            BannerPicPos = v.BannerPicPos,
            ModelPathLow = v.ModelPathLow,
            ModelPathHi = v.ModelPathHi,
            inherit = v.inherit,
            SkinType = "",
            way = 0,
            base_att = {}
        }
        self.cardSkins[v.id] = {}
        _G.table.insertto(self.cardSkins[v.id], v.skin)
        _G.table.insert(self.cardSkins[v.id], 1, v.id)
    end

    for _, v in pairs(_G.ConfigManager.skin_cfg) do
        self.skinCfgs[v.id] = v
    end
end

function CardCommentManager:GetDataFormServer()
