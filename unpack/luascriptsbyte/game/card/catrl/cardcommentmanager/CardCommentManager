function CardCommentManager:PlayShowCfg(sid,isPreview)
    local cardCfg = ConfigManager.card_cfg[sid]
    local isWear, skinId 
    if not isPreview then
        isWear, skinId = self:CardWearSkin(sid)
    end
    local cfg = _G.ConfigManager.card_show_cfg[sid]
    local show_enter = cfg and cfg.show_enter or nil
    if show_enter ~= nil then
        if isWear then
            cfg = _G.ConfigManager.skin_cfg[skinId]
            self:PlaySound(cfg.show_enter)
        else
            self:PlaySound(cfg.show_enter)
        end
    end
end

function CardCommentManager:ClearSound()
    AudioManager.RestoreBackgroundMusic()
    if self.ActionAudioArr ~= nil then
        for path, value in pairs(self.ActionAudioArr) do
            _G.AudioManager.StopSoundByPath(path)
            self.ActionAudioArr[path] = nil
        end
    end
    if self.LinesPath ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.LinesPath)
    end
end

function CardCommentManager:PlaySound(audioCfg, soundPath)
    self:ClearSound()
    self.ActionAudioArr = {}
    if _G.string.IsNullOrEmpty(audioCfg) == false then
        local path = audioCfg
        if path ~= nil then
            self.ActionAudioArr[path] = true
            require("CardUtils").PlayRoleSound(path)
        end
    end
    if _G.string.IsNullOrEmpty(soundPath) == false then
        local path = soundPath
        if path ~= nil then
            self.LinesPath = path
            require("CardUtils").PlayRoleSound(path)
        end
    end
end

