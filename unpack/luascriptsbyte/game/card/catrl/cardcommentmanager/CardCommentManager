---是否有可用皮肤配置
---@param cardCfg card_cfg|number[] 可传卡牌配置或皮肤列表
---@return boolean
function CardCommentManager:CheckCardSkinCfg(cardCfg)
    if not cardCfg then
        return false
    end
    --根据渠道屏蔽皮肤
    local channelId = tonumber(_G.SDKManager:GetInstance():GetChannelId()) or -1

    ---@type number[]
    local skins = cardCfg.skin or cardCfg
    for _, skinId in ipairs(skins) do
        local skinCfg = _G.ConfigManager.skin_cfg[skinId]
        if skinCfg and (
                self:CheckSkin(skinId) or
                _G.table.isEmptyOrNil(skinCfg.channel_id) or
                _G.table.ContainsValue(skinCfg.channel_id, channelId)
            ) then
            return true
        end
    end
    return false
end

---获取可用的皮肤配置
---@param cardCfg card_cfg|number[] 可传卡牌配置或皮肤列表
---@return number[]
function CardCommentManager:GetCardSkinCfgs(cardCfg)
    if not cardCfg then
        return nil
    end
    --根据渠道屏蔽皮肤
    local channelId = tonumber(_G.SDKManager:GetInstance():GetChannelId()) or -1

    ---@type number[]
    local skins = cardCfg.skin or cardCfg
    --先检查是否需要排除id
    local isExcludedAny = false
    for _, skinId in ipairs(skins) do
        local skinCfg = _G.ConfigManager.skin_cfg[skinId]
        if not skinCfg or not (
                self:CheckSkin(skinId) or
                _G.table.isEmptyOrNil(skinCfg.channel_id) or
                _G.table.ContainsValue(skinCfg.channel_id, channelId)
            ) then
            isExcludedAny = true
            break
        end
    end
    if not isExcludedAny then
        return skins
    end

    --排除配置后的数据
    local results = {}
    for _, skinId in ipairs(skins) do
        local skinCfg = _G.ConfigManager.skin_cfg[skinId]
        if skinCfg and (
                self:CheckSkin(skinId) or
                _G.table.isEmptyOrNil(skinCfg.channel_id) or
                _G.table.ContainsValue(skinCfg.channel_id, channelId)
            ) then
            table.insert(results, skinId)
        end
    end
    return results
end

return CardCommentManager
