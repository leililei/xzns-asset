end

function CardCommentManager:GetToken(callback)
    self.CommentCallBack = {}
    CardCommentNet:GetInstance():GetCommentToken(_G.handlerbind(self, self.OnGetSuccessed, callback))
end

function CardCommentManager:OnGetSuccessed(msg, call)
    self.token = msg.c_sign
    self.url = msg.url
    self.super.ParseData(self)
    if call then
        call()
    end
end

---返回当前皮肤加成(解锁即有加成，无需穿戴)
function CardCommentManager:GetCardPF(id)
    local cfg = _G.ConfigManager.card_cfg[id]
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attribute = attributeManager:GetAttribtueClass()

    local skinCfg
    for key, skin in pairs(cfg.skin) do
        if self:CheckSkin(skin) then
            skinCfg = _G.ConfigManager.skin_cfg[skin]
            for _, v in pairs(skinCfg.base_att) do
                attribute:AddValueByName(
                    v[1],
                    attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                    nil,
                    _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
                )
            end
        end
    end
    return attribute, _G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
end

---获取所有皮肤的全局加成属性（获得生效）
function CardCommentManager:GetAllCardSkinAttr()
    local changeAttrTypes
    if self.allSkinAttr == nil then
        changeAttrTypes = self:UpdateAllSkinAttr()
    else
        changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrList(self.allSkinAttr)
    end
    return self.allSkinAttr, changeAttrTypes
end

---更新皮肤全局属性（获得生效）
function CardCommentManager:UpdateAllSkinAttr()
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attribute = attributeManager:GetAttribtueClass()
    local cfg
    for sid, _ in pairs(self.unLockSids) do
        cfg = _G.ConfigManager.skin_cfg[sid]
        if cfg.team_base_att == nil then
            break
        end
        for _, v in pairs(cfg.team_base_att) do
            attribute:AddValueByName(
                v[1],
                attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                nil,
                _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
            )
        end
    end
    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    self.allSkinAttr = attribute
    return changeAttrTypes
end

---初始化当前皮肤数据
function CardCommentManager:OnGetSkinInfo(msg, call)
    if msg.info then
        self.i_card_skin = msg.info
        self.unLockSids = {}
        for _, v in pairs(self.i_card_skin) do
            if v.s_id_list then
                for _, v2 in pairs(v.s_id_list) do
                    self.unLockSids[v2] = true
                end
            end
        end
    end
    self.sidSkin = {}
    if msg.wear_info then
        self.i_card_wear_skin = msg.wear_info
        for _, v in pairs(msg.wear_info) do
            self.sidSkin[v.card_sid] = v.skin_id
        end
        self:CardSkin()
    end
    self.super.ParseData(self)
    if call then
        call()
    end
    self:UpdateAllSkinAttr()
end

function CardCommentManager:CardSkin()
    local cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for _, v in pairs(self.i_card_wear_skin) do
        for key, value in pairs(cardList) do
            if v.card_sid == value.sid then
                value:SetSkin(v.skin_id)
            end
        end
    end
end

---查询当前id是否第一次拥有皮肤
function CardCommentManager:ChaXun(id)
    local dataRep = _G.PlayerPrefsManager.GetTable("CardCommentManagerRep")
    if dataRep == nil then
        return false
    end
    for key, value in pairs(dataRep) do
        if id == key then
            return true
        end
    end
    return false
end

function CardCommentManager:AddChaXun(id, Is)
    local dataRep = _G.PlayerPrefsManager.GetTable("CardCommentManagerRep")
    if dataRep == nil then
        dataRep = {}
    end
    local sid = _G.ConfigManager.skin_cfg[id] and _G.ConfigManager.skin_cfg[id].card or id
    if Is then
        local is = true
        for key, value in pairs(dataRep) do
            if id == value then
                is = false
            end
        end
        if is then
            dataRep[id] = sid
        end
    else
        local num
        for key, value in pairs(dataRep) do
            if id == key then
                num = key
            end
        end
        if num then
            dataRep[num] = nil
            _G.PlayerPrefsManager.SetTable("CardCommentManagerRep", dataRep)

            local cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
            for _, v in pairs(cardList) do
                if v.sid == sid then
                    --刷新红点
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.SkinCard.id,
                        v.uid
                    )
                end
            end
        end
    end
    _G.PlayerPrefsManager.SetTable("CardCommentManagerRep", dataRep)
end

---查询当前id是否解锁皮肤
function CardCommentManager:CradSid(id, IdList)
    for key, value in pairs(self.i_card_skin) do
        if id == value.card_sid then
            if IdList then
                for _, v in pairs(value.s_id_list) do
                    if IdList == v then
                        return true
                    end
                end
            else
                return false, value.card_sid
            end
        end
    end
    return false
end

---检测皮肤是否解锁
---@param sid number 皮肤 sid
function CardCommentManager:CheckSkin(sid)
    return self.unLockSids[sid]
end

---查询当前id是否穿戴皮肤
function CardCommentManager:CardWearSkin(id)
    for key, value in pairs(self.i_card_wear_skin) do
        if id == value.card_sid and value.skin_id ~= 0 then
            return true, value.skin_id
        end
    end
    return false, 0
end

---通过skinid查询card_cfg.id
---@param skinId number
---@return boolena,number  是否为皮肤ID,对应的card_cfg.id
function CardCommentManager:GetCardSidBySkinId(skinId)
    if not self.skinMapping then
        ---@type table<number,number> 皮肤对应的card_cfg.id
        self.skinMapping = {}
        for _, v in pairs(_G.ConfigManager.card_cfg) do
            for _, _skinId in pairs(v.skin) do
                self.skinMapping[_skinId] = v.id
            end
        end
    end
    local cardSid = self.skinMapping[skinId]
    if cardSid then
        return true, cardSid
    end
    return false, 0
end

---根据id返回显示数据
function CardCommentManager:CardData(ID, Is)
    if not _G.IsNumber(ID) or ID <= 0 then
        return nil
    end
    if Is == nil then
        return _G.ConfigManager.card_cfg[ID]
    end
    local xianshi, skin = {}, {}

    local cfg = _G.ConfigManager.card_cfg[ID]

    if cfg == nil then
        skin = _G.ConfigManager.skin_cfg[ID]
        if skin == nil then --材料卡
            cfg = _G.ConfigManager.item_card_cfg[ID]
            xianshi = cfg
        else
            cfg = _G.ConfigManager.card_cfg[skin.card]
            xianshi._cfg = cfg
            xianshi._skin = skin 
            setmetatable(
                xianshi,
                {
                    __index = function(t, key)
                        if t._skin[key] then
                            rawset(t, key, t._skin[key])
                            return t[key]
                        elseif t._cfg[key] then
                            rawset(t, key, t._cfg[key])
                            return t[key]
                        end
                        return nil
                    end
                }
            )
            xianshi.SkinType = skin.SkinType
            xianshi.way = skin.way
            xianshi.base_att = skin.base_att
            xianshi.CradSid = skin.card
        end
    else
        local is, skin_id = self:CardWearSkin(ID)
        if is and Is then
            skin = _G.ConfigManager.skin_cfg[skin_id]
            xianshi._cfg = cfg
            xianshi._skin = skin 
            setmetatable(
                xianshi,
                {
                    __index = function(t, key)
                        if t._skin[key] then
                            rawset(t, key, t._skin[key])
                            return t[key]
                        elseif t._cfg[key] then
                            rawset(t, key, t._cfg[key])
                            return t[key]
                        end
                        return nil
                    end
                }
            )
            xianshi.SkinType = skin.SkinType
            xianshi.way = skin.way
            xianshi.base_att = skin.base_att
        else
            xianshi = cfg
        end
    end

    if Is then
        skin = _G.ConfigManager.skin_cfg[ID]
    end
    return xianshi, skin
end

---解锁皮肤
function CardCommentManager:AddSkin(id, skinId)
    local add = true
    for key, value in pairs(self.i_card_skin) do
        if value.card_sid == id then
            _G.table.insert(value.s_id_list, skinId)
            self.unLockSids[skinId] = true
            add = false
        end
    end
    if add then
        self:AddChaXun(skinId, true)
        _G.table.insert(self.i_card_skin, {card_sid = id, s_id_list = {skinId}})
        self.unLockSids[skinId] = true
    end
    local needUpdateAll = _G.ConfigManager.skin_cfg[skinId].team_base_att and #_G.ConfigManager.skin_cfg[skinId].team_base_att > 0 or false
    local cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for _, v in pairs(cardList) do
        if v.sid == id then
            if not needUpdateAll then --有全局属性的时候需刷新全卡，减少额外计算
                v:GetCardSumAttr()
            end

            --刷新红点
            require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.SkinCard.id,
                v.uid
            )
        end
    end
    if needUpdateAll then
        self:UpdateAllSkinAttr()
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.AllSkin)
    end
end

---更换皮肤
function CardCommentManager:AddSid(id, skinId)
    local add = true
    for key, value in pairs(self.i_card_wear_skin) do
        if value.card_sid == id then
            value.skin_id = skinId
            add = false
        end
    end
    if add then
        _G.table.insert(self.i_card_wear_skin, {card_sid = id, skin_id = skinId})
    end
    self.sidSkin[id] = skinId ~= 0 and skinId or id
end

