---提升等级
function CardHunLianManger:UpLevel()
    local msg = {}
    msg.uid = CardHunLianModel:GetInstance().cardData.uid
    self.LastCardEquipProp = _G.GameUtil.GetPropUpData(CardHunLianModel:GetInstance().cardData)
    local level = CardHunLianModel:GetInstance().level
    local IsItemEnough = CardHunLianModel:GetInstance():IsItemEnough()
    if level + 1 <= CardHunLianModel:GetInstance().maxLevel and IsItemEnough then
        CardHunLianNet:GetInstance():CardHunLianLevelUp(msg, _G.handler(self, self.ReceiveUpLevel))
    else
        self:TipsShow(CardHunLianModel:GetInstance().tips["not_up_lv"].content)
    end
end

---强化成功 更新界面显示 更改 更改属性
function CardHunLianManger:ReceiveUpLevel(data)
    if data.ack ~= 1 then
        _G.FloatTipsModel:Show(data.ack)
        return
    end
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local C_Model = CardHunLianModel:GetInstance()
    C_Model.level = C_Model.level + 1
    local item = C_Model:GetHLItem(C_Model.cardData.sid, C_Model.cardData.soulLink_lv)
    local name = item[1]
    --消耗道具数量限制
    --C_Model.itemLimit = C_Model:GetItemLimit(C_Model.cardData.sid, C_Model.cardData.soulLink_lv)
    C_Model.cardData.soulLink_lv = C_Model.level
    _G.StorageManager:GetInstance():ConsumeItem(C_Model.itemName, C_Model.cardData.uid, C_Model.itemLimit)
    local count, limit = 0, 0

    --C_Model:GetItemLimit(C_Model.cardData.sid, C_Model.cardData.soulLink_lv)
    --判断 是否 切换材料
    if C_Model:ChangeMaterial(C_Model.cardData.sid, C_Model.cardData.soulLink_lv) then
        item = C_Model:GetHLItem(C_Model.cardData.sid, C_Model.cardData.soulLink_lv + 1)
        C_Model.itemName = item[1]
        limit = item[2]
    else
        limit = C_Model:GetItemLimit(C_Model.cardData.sid, C_Model.cardData.soulLink_lv)
    end
    count = C_Model:GetBagItemNumber(_G.StorageID.Material, item[1])
    if count <= 0 then
        C_Model.itemCount = 0
    end

    C_Model.itemCount = count
    C_Model.itemLimit = limit
    _G.Events:GetInstance():Broadcast(
        _G.eHunLianEvents.UpLevelhHuiLian,
        C_Model.cardData.sid,
        C_Model.cardData.soulLink_lv
    )
    _G.Events:GetInstance():Broadcast(_G.ChatViewEvents.ChatViewHunLian, C_Model.cardData,
        C_Model.cardData.soulLink_lv)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(C_Model.cardData, true)
    if self.isSkillUp then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.HunLianUpResultView.Name,
            C_Model.cardData,
            C_Model.SoulLink_Level_Cfg
        )

        self.isSkillUp = false
    end
    local maxstart = _G.ConfigManager.discrete_cfg[102402][1][1]

    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(power, offset)
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SoulChain.id)
    if C_Model.cardData:GetLevel() > 1 and C_Model.cardData.soulLink_lv >= maxstart then
        require "RedPointManager":GetInstance():RemoveRedPointParam(
            _G.ConfigManager.redpoint_cfg.SoulChain.id,
            C_Model.cardData.uid * 10 + 1
        )
    end
end

