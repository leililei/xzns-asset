---显示 属性Tips
function CardHunLianManger:ShowAttributeTips(obj, sid, level, isActive, soulLink_lv)
    local att_or_skill = CardHunLianModel:GetInstance().SoulLink_Level_Cfg
    local sid, ActiveType
    for i = 1, #att_or_skill do
        if level == att_or_skill[i].level then
            sid = att_or_skill[i].activeDataID
            ActiveType = att_or_skill[i].ActiveType
            break
        end
    end
    if ActiveType == _G.ActiveTypeEnum.attribute then
        require "CommonTipManager":GetInstance():OpenAttributeTip(obj, sid, nil, 1)
    else
        if level == 0 then
            local hunlianskillTips = {
                [1] = 0, --魂链技能 激活的等级
                [2] = 10,
                [3] = 20,
                [4] = 30
            }
            require "CommonTipManager":GetInstance():OpenHunLianSkillAllTip(
                obj,
                sid,
                nil,
                isActive,
                soulLink_lv,
                hunlianskillTips
            )
        else
            require "CommonTipManager":GetInstance():OpenAttributeTip(obj, sid, nil, 2)
        end
    end
end

