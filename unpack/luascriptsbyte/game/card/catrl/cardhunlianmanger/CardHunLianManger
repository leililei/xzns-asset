---设置魂链 数据
function CardHunLianManger:SetDataHunLian(data)
    CardHunLianModel:GetInstance():InitDataHunLian(data)
    local cardProp = data.NowSumProp:Clone():GetAllAttr()
    local curProp = {
        [_G.AttrType.max_hp.key] = 0,
        [_G.AttrType.atk.key] = 0,
        [_G.AttrType.def.key] = 0,
        [_G.AttrType.bre.key] = 0
    }
    for key, _ in pairs(curProp) do
        curProp[key] = cardProp[key]
    end
    self.LastCardEquipProp = curProp
end

---获得 激活属性
function CardHunLianManger:GetActiveAttribute(level)
    local sid = CardHunLianModel:GetInstance().cardData.sid
    local cfg = _G.ConfigManager.card_exclusive_cfg[sid + level]
    local attID = cfg.attribute_display[1]
    local attribute = _G.ConfigManager.attribute_cfg[attID]
    return attribute
end

---获得 属性名字
function CardHunLianManger:GetAttributeDes(key)
    local id = _G.AttrType[key].ID
    local des = _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[id].name)
    return des
end

---等到当前等级 基础属性
---@param sid number 卡牌的sid
---@param level number 魂链的等级
function CardHunLianManger:GetBase_att(sid, level)
    local exclusive_BaseAtt = {}
    local sid = sid
    local cfg = _G.ConfigManager.card_exclusive_cfg[sid + level]
    if not cfg then
        return nil
    end
    for i = 1, #cfg.base_att do
        local temp = {}
        temp.key = cfg.base_att[i][1]
        temp.type = cfg.base_att[i][2]
        temp.value = cfg.base_att[i][3]
        table.insert(exclusive_BaseAtt, temp)
    end
    self:SortDispaly_Priority(exclusive_BaseAtt)
    return exclusive_BaseAtt
end

---排序 type_attribute display_priority
function CardHunLianManger:SortDispaly_Priority(attList)
    table.sort(
        attList,
        function(a, b)
            if _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid then
                return true
            end
            return false
        end
    )
end

--region 计算属性值
---base
function CardHunLianManger:CalAttributeBase(sid, level)
    local att = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    local base_att = self:GetBase_att(sid, level)
    if not _G.table.isEmptyOrNil(base_att) then
        for i = 1, #base_att do
            local type_att = _G.ConfigManager.type_attribute_cfg
            local id = _G.AttrType[base_att[i].key].ID
            if _G.AttrType[base_att[i].key].percentage == 1 then
                if base_att[i].type == 2 then
                    att:SetValueByName(
                        base_att[i].key,
                        base_att[i].value * type_att[id].params_power * 0.0001,
                        false,
                        _G.AttCountType.basePercent
                    )
                elseif base_att[i].type == 1 then
                    att:AddValueByName(
                        base_att[i].key,
                        base_att[i].value + type_att[id].params_power * 0.0001 * 100,
                        false,
                        _G.AttCountType.base
                    )
                end
            else
                att:AddValueByName(base_att[i].key, base_att[i].value * 0.0001, false, _G.AttCountType.basePercent)
            end
        end
    end
    return att
end

---激活属性
function CardHunLianManger:CalAttribute(sid, level)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local att = AttributeClassManager:GetAttribtueClass()
    --local cfg = _G.ConfigManager.card_exclusive_cfg[sid+level]
    local cfg = _G.ConfigManager.card_exclusive_cfg
    local attCfg = _G.ConfigManager.attribute_cfg
    local attArrays = {}
    for i = 1, level do
        local temp = cfg[sid + i].attribute_display[1]
        if temp ~= nil then
            table.insert(attArrays, attCfg[temp])
        end
    end
    if not _G.table.isEmptyOrNil(attArrays) then
        for i = 1, #attArrays do
            -- local type_att = _G.ConfigManager.type_attribute_cfg
            -- local id = _G.AttrType[attArrays[i].attribute].ID
            if attArrays[i].attribute[1][2] == "1" then
                att:AddValueByName(
                    attArrays[i].attribute[1][1],
                    AttributeClassManager:GetValueWithName(
                        attArrays[i].attribute[1][1],
                        attArrays[i].attribute[1][3],
                        attArrays[i].attribute[1][2]
                    ),
                    false,
                    _G.AttCountType.other
                )
            else
                if attArrays[i].attribute[1][2] == "2" then
                    att:AddValueByName(
                        attArrays[i].attribute[1][1],
                        AttributeClassManager:GetValueWithName(
                            attArrays[i].attribute[1][1],
                            attArrays[i].attribute[1][3],
                            attArrays[i].attribute[1][2]
                        ),
                        false,
                        _G.AttCountType.basePercent
                    )
                end
            end
        end
    end
    return att
end

---魂链等级材料 获得 或者是 删除
function CardHunLianManger:RedPointRefreshHunLianStorage(add, rem, change)
    local table = _G.table
    local flag = false
    local hunlMateril = _G.ConfigManager.discrete_cfg[102404][1]
    if not table.isEmptyOrNil(add) then
        for key, value in pairs(add) do
            for i = 1, #hunlMateril do
                if value == hunlMateril[i] then
                    flag = true
                    break
                end
            end
            if flag then
                break
            end
        end
    end
    if not table.isEmptyOrNil(change) then
        for key, value in pairs(change) do
            for i = 1, #hunlMateril do
                if value == hunlMateril[i] then
                    flag = true
                    break
                end
            end
            if flag then
                break
            end
        end
    end
    if not flag then
        return
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.SoulChain.id
    )
end

