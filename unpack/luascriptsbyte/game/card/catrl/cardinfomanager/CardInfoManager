---@param obj UnityEngine.GameObject
---@param CardData CardData
---@param isHead boolean  true 头像item  false 全身item
---@return gotable gotable
function CardInfoManager:SetCardDataWakeLvInfo(obj, CardData, isHead)
    if _G.IsNil(obj) then
        return
    end
    ---  icon 三种颜色,两套皮肤   text 三种艺术字
    --- 觉醒等级 1-3 zi  4-6 cheng 7-9 hong

    local go_table = _G.GetAutoGoTable(obj)
    if go_table == nil then
        return
    end
    if CardData.awaken == 0 then
        obj:SetActiveE(0)
        return
    end
    local awaken = CardData.awaken

    ---类型
    local Enum = {
        --头像
        head = 2,
        --半身
        body = 1
    }

    local iconType = isHead and Enum.head or Enum.body

    --- 不同等级对应的资源显示等级
    local lvDic = {
        [1] = 1,
        [2] = 1,
        [3] = 1,
        [4] = 2,
        [5] = 2,
        [6] = 2,
        [7] = 3,
        [8] = 3,
        [9] = 3
    }

    local ResPos = {
        [Enum.body] = { 5, 10, 0 },
        [Enum.head] = { 4.9, 4.9, 0 }
    }

    local iconTypeStr = tostring(iconType)

    -- icon   ResDic..iconTypeStr  ui-js-bar-zi01
    local ResDic = {
        [1] = {
            icon = "ui-js-bar-zi0" .. iconTypeStr
        },
        [2] = {
            icon = "ui-js-bar-zi0" .. iconTypeStr
        },
        [3] = {
            icon = "ui-js-bar-hong0" .. iconTypeStr
        }
    }
    local textRP = {
        [Enum.head] = {
            pos = { -13.1, -23, 0 },
            rot = { 0, 0, -45 }
        },
        [Enum.body] = {
            pos = { -15, -22, 0 },
            rot = { 0, 0, 0 }
        }
    }

    local text = {
        [1] = go_table.aortext_num1,
        [2] = go_table.aortext_num2,
        [3] = go_table.aortext_num3
    }

    local lv = lvDic[awaken]
    local textrp = textRP[iconType]

    for i = 1, 3 do
        ---@type AorText
        local nowText = text[i]
        local isLV = lv == i
        if isLV then
            nowText.text = tostring(awaken)
            nowText:SetAnchorPosition(textrp.pos[1], textrp.pos[2], textrp.pos[3])
            nowText:SetAnchorPosition(textrp.rot[1], textrp.rot[2], textrp.rot[3])
        end
        nowText:SetActiveE(isLV and 1 or 0)
    end

    go_table.aorimage_wakelv.SpriteName = ResDic[lv].icon

    obj:SetActiveE(1)

    local mResPos = ResPos[iconType]
    obj:SetAnchorPosition(mResPos[1], mResPos[2], mResPos[3])
    return go_table
end

