---检测是否有足够本体升级
function CardInfoManager:GetCanMaxStartOfSidList()
    local tb = {}
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local min = self.StarIndexDic[7][1]
    local max = self.StarIndexDic[7][#self.StarIndexDic[7]]
    local checkCardList =
        _G.table.chooseToArray(
            list,
            function(k, v)
                return v.star >= min and v.star < max
            end
        )
    local curMat, targerMat, needMat
    local startCfgs = _G.ConfigManager.card_star_cfg
    ---@type card_star_cfg
    local starCfg
    local minStar, maxStar
    for _, v in ipairs(checkCardList) do
        if not tb[v.sid] then
            needMat = 0
            curMat = self:GetUpStarMat(self:GetStarElements(v:GetElement_new()), v.star)
            targerMat = self:GetUpStarMat(self:GetStarElements(v:GetElement_new()), max)
            starCfg = startCfgs[self:GetStarCfgId(v:GetElement_new(), max)]
            minStar = not starCfg and 5 or starCfg.reset_oneself[1]
            maxStar = minStar
            for k, v2 in pairs(targerMat.materials_oneself) do
                if k > maxStar then
                    maxStar = k
                end
                if k == minStar then
                    needMat = needMat + v2 - (curMat.materials_oneself[k] or 0)
                else
                    starCfg = startCfgs[self:GetStarCfgId(v:GetElement_new(), k)]
                    if starCfg and starCfg.reset_oneself[2] then
                        needMat = needMat + (v2 - curMat.materials_oneself[k] or 0) * starCfg.reset_oneself[2]
                    end
                end
            end
            for _, card in pairs(list) do
                if v.sid == card.sid and card.star >= minStar and card.star <= maxStar then
                    if card.star == minStar then
                        needMat = needMat - 1
                    else
                        starCfg = startCfgs[self:GetStarCfgId(v:GetElement_new(), card.star)]
                        if starCfg and starCfg.reset_oneself[2] then
                            needMat = needMat - starCfg.reset_oneself[2]
                        end
                    end
                    if needMat <= 0 then
                        tb[v.sid] = true
                        break
                    end
                end
            end
        end
    end

    return tb
end

---获取升星材料(累计),从最低开始，有些卡默认星级高于最低星级 要注意
function CardInfoManager:GetUpStarMat(element, star)
    if not self.UpStarMaterialDic then
        self.UpStarMaterialDic = {}
    end
    local key = element * 100 + star
    local startKey
    if not self.UpStarMaterialDic[key] then
        local tb = { materials_oneself = {}, materials_elements = {} }
        local sxCfg
        ---card_star_cfg中消耗为升下一星的消耗 故22升23 消耗在22中
        for i = 2, star - 1 do
            startKey = element * 100 + i
            sxCfg = card_star_cfg[startKey]
            if sxCfg then
                local num = 0
                if sxCfg.materials_oneself[1] then
                    if not tb.materials_oneself[sxCfg.materials_oneself[1]] then
                        tb.materials_oneself[sxCfg.materials_oneself[1]] = 0
                    end
                    tb.materials_oneself[sxCfg.materials_oneself[1]] =
                        tb.materials_oneself[sxCfg.materials_oneself[1]] + sxCfg.materials_oneself[2]
                end
                if sxCfg.materials_elements[1] then
                    if not tb.materials_elements[sxCfg.materials_elements[1]] then
                        tb.materials_elements[sxCfg.materials_elements[1]] = 0
                    end
                    tb.materials_elements[sxCfg.materials_elements[1]] =
                        tb.materials_elements[sxCfg.materials_elements[1]] + sxCfg.materials_elements[2]
                end
            end
        end
        self.UpStarMaterialDic[key] = tb
    end
    return self.UpStarMaterialDic[key]
end

