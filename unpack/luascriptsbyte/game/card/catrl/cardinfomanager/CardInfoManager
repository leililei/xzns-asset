---递归合成卡牌, 直至全部卡牌合成完成
---@param callback fun(msg:public.s2c_common_ack):void    操作回调
function CardInfoManager:AutoCardDevelopRecursive(callback)
    if self.autoCardDevelopRecursiveExecuting then
        if callback then
            callback(nil)
        end
        return
    end
    self.autoCardDevelopRecursiveExecuting = true

    ---@param lastMsg public.s2c_common_ack
    local function recursiveAutoCardDevelop(lastMsg, callback)
        self:AutoCardDevelop(
            function(ok, msg)
                if ok and msg then
                    if lastMsg then
                        _G.table.insertto(lastMsg.award.item, msg.award.item)
                    else
                        lastMsg = msg
                    end
                    recursiveAutoCardDevelop(lastMsg, callback)
                else
                    if callback then
                        callback(lastMsg)
                    end
                    self.autoCardDevelopRecursiveExecuting = false
                end
            end
        )
    end
    recursiveAutoCardDevelop(nil, callback)
end

---检查卡牌自动合成开关
---@return boolean
function CardInfoManager:CheckAutoCardDevelopToggle()
    return _G.PlayerPrefsManager.GetInt("AutoCardDevelop", 0) == 1
end

---设定卡牌自动合成开关
---@param isOn boolean
function CardInfoManager:SetAutoCardDevelopToggle(isOn)
    _G.PlayerPrefsManager.SetInt("AutoCardDevelop", isOn and 1 or 0)
end

---获取配置觉醒等级
function CardInfoManager:GetAttPotential(potential_lv, carddata)
    if potential_lv then
        if potential_lv == 999 then
            if carddata then
                return carddata.potential
            end
        elseif potential_lv > 0 then
            local cfg = _G.ConfigManager.card_potential_cfg[potential_lv]
            if cfg then
                return cfg.id
            end
        end
    end
    return 0
end

---通过att_equity_cfg获取卡牌数据
---@param attEquity table att_equity_cfg配置
---@param cardData CardData 当前背包内的卡牌
---@param newCardData CardData 新的卡牌数据
function CardInfoManager:GetNewCardDataByCfg(attEquity, cardData, newCardData)
    local msg = {
        sid = cardData.sid,
        uid = cardData.uid,
        lv = attEquity.level,
        star = cardData.star,
        skin = 0,
        soul_chain_lv = cardData.soulLink_lv,
        soul_state = cardData.soulLink_IsActivate,
        inborn_num = 0,
        open_inborn = cardData.open_inborn,
        awaken_lv = self:GetAttPotential(attEquity.potential_lv, cardData)
    }
    newCardData.DecorationBar = cardData.DecorationBar
    newCardData.CarvingBar = cardData.CarvingBar
    if attEquity.equip_grade and attEquity.equip_grade > 0 then
        local equipments = {}
        for _, index in pairs(_G.EquipmentPart) do
            if index ~= _G.EquipmentPart.Trousers then
                ---@type prop.i_equipment
                local data2 = {}
                data2.sid =
                    201000000 + attEquity.equip_grade + cardData.cfg.EquipmentType * 1000 + index * 100
                data2.uid = 0
                data2.streng = attEquity.equip_stren
                data2.exp = 0
                if attEquity.equip_ele > 0 then
                    data2.element = cardData:GetElement()
                else
                    data2.element = 0
                end

                data2.reset_element = 0
                _G.table.insert(equipments, data2)
            end
        end
        msg.equipments = equipments
    end

    if attEquity.artifact_grade and attEquity.artifact_grade > 0 then
        local artifact = {
            {
                sid = 255000000 + attEquity.artifact_grade * 100000 + cardData.cfg.Professional * 10000 + 100,
                uid = 0,
                num = 1,
                level = attEquity.artifact_level or 1,
                star = attEquity.artifact_star or 0,
                awaken = 0,
            }
        }
        msg.artifact = artifact
    else
        newCardData.ArtifactBar = cardData.ArtifactBar
    end

    if attEquity.spiritual_num and attEquity.spiritual_num > 0 then
        local spiritual = {}
        local spiritualMsg
        for j = 1, attEquity.spiritual_num do
            spiritualMsg = {
                sid = 256000000 + attEquity.spiritual_grade * 100000 + 100,
                uid = 0,
                level = attEquity.spiritual_level,
                star = attEquity.spiritual_star,
                index = j
            }
            _G.table.insert(spiritual, spiritualMsg)
        end
        msg.spiritual = spiritual
    else
        newCardData.SpiritualBar = cardData.SpiritualBar
    end
    newCardData.DecorationBar = cardData.DecorationBar
    return msg
end

return CardInfoManager
