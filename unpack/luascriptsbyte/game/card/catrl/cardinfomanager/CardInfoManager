---@param starPropParent UnityEngine.GameObject  属性列表父级
function CardInfoManager:ShowUpStarPropUpdata(CardData, star, starPropParent)
    local carduid = CardData.uid
    if _G.IsNil(carduid) or _G.IsNil(star) or _G.IsNil(starPropParent) then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 参数有空  CardInfoManager:ShowUpStarPropUpdata(carduid, star, starPropParent)")
        end
        return
    end
    ---影响的属性
    local updataProp = {
        _G.AttrType.max_hp.key,
        _G.AttrType.atk.key,
        _G.AttrType.def.key,
        _G.AttrType.bre.key
        -- _G.AttrType.hit.key,
        -- _G.AttrType.avd.key,
        -- _G.AttrType.cri.key,
        -- _G.AttrType.cri_r.key
    }
    local nowProp = CardData:GetSpecifyStarLvProp(star)
    local nextProp = CardData:GetSpecifyStarLvProp(star + 1)

    local SetProp = function(gotable, Attrid)
        --描述
        gotable.aortext_des.text = _G.AttrType[Attrid].des
        --当前
        gotable.aortext_value.text = nowProp[Attrid]
        --升星后
        gotable.aortext_next.text = nextProp[Attrid]

        require("CardInfoManager"):GetInstance().LoadRawImage(gotable.aorrawimage_icon, _G.AttrType[Attrid].icon)
    end
    local childCount = starPropParent:GetChildCountE()
    for i = 1, childCount do
        local Attrid = updataProp[i]

        local tTf = starPropParent:GetChildE(i - 1)
        if tTf ~= nil then
            ---只显示 变化的属性
            if nowProp[Attrid] ~= nextProp[Attrid] then
                local tGotable = _G.GetAutoGoTable(tTf)
                SetProp(tGotable, Attrid)

                _G.GameUtil.SetActiveByCondition(tTf, false)
                _G.DelayDo(
                    1 + 0.2 * i,
                    function()
                        _G.GameUtil.SetActiveByCondition(tTf, true)
                    end
                )
            else
                _G.GameUtil.SetActiveByCondition(tTf, false)
            end
        end
    end
end

