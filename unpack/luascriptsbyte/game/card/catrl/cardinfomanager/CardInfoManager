---制片人 呼吸(放大缩小)
---@param tran UnityEngine.Transform
---@param carddata CardData
---@return function  Dotween kill
function CardInfoManager:RoleBreathe(tran, isBig)
    if _G.IsNil(tran) then
        return
    end
    local GameTestData = self:ReLoad("Game.Dialogue.DialogueData")

    local lsex, _, _ = tran:GetLocalScale()
    local _, lpny, _ = tran:GetLocalPosition()
    local scale = lsex
    local pox_y = lpny

    local time = GameTestData.time
    local scaleAdd = GameTestData.scale
    local pox_y_Add = GameTestData.pox_y
    if isBig == true then
        scale = scale + scaleAdd
        pox_y = pox_y + pox_y_Add
    else
        scale = scale - scaleAdd
        pox_y = pox_y - pox_y_Add
    end
    local dotween = tran:DOScale(scale, scale, scale, time)
    dotween:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    local dotweenDOLocalMoveY = tran:DOLocalMoveY(pox_y, time)
    dotween.onComplete = function()
        self:RoleBreathe(tran, not isBig)
    end
    local killfun = function()
        if dotween ~= nil then
            dotween:Kill()
        end
        if dotweenDOLocalMoveY ~= nil then
            dotweenDOLocalMoveY:Kill()
        end
    end
    return killfun
end

---获取color
---@param string string 3e4055
---@param alpha number 0.8
function CardInfoManager.GetColorFromRGB(colorStr, alpha)
    local co = _G.Color.white
    if string.IsNullOrEmpty(colorStr) or string.len(colorStr) < 6 then
        if _G.AppSetting.DEBUG then
            _G.LogError(" colorStr 输入有误  CardInfoManager.GetColorFromRGB()")
        end
        return co
    end

    if string.len(colorStr) == 7 then
        colorStr = string.sub(colorStr, 2, 7)
    end
    local R = tonumber(string.sub(colorStr, 1, 2), 16) or 0
    local B = tonumber(string.sub(colorStr, 3, 4), 16) or 0
    local G = tonumber(string.sub(colorStr, 5, 6), 16) or 0
    local A = alpha or 1
    return Color.New(R / 255, B / 255, G / 255, A)
end

---卡牌 准备销毁检测 (吞噬升星被选中,检测上阵上锁)
---@param CardData CardData
---@param updataCall function 刷新回调  卡牌若多种牵扯 一次只解除一个但要刷新卡牌状态
---@param okCall function 成功回调
---@param failCall function 失败回调
---@param isCheck boolean 仅检测  return True无法被吃
---@param isStarUp boolean 升星自动选择 不要弹窗检测提示
---@return ReData ReData.isEmbattle true上阵的卡 真吃的时候要下阵
function CardInfoManager.CardReadyDestroy(CardData, updataCall, okCall, failCall, isCheck, isStarUp)
    ---返回要处理的数据
    local ReData = {}
    ---true上阵的卡 真吃的时候要下阵
    ReData.isEmbattle = false
    local failFun = function()
        if failCall ~= nil then
            failCall()
        end
    end

    if _G.IsNil(CardData) then
        failFun()
        return
    end

    local updataFun = function()
        if updataCall ~= nil then
            updataCall()
        end
    end

    ---检测数量
    local CheckCount = 0

    ---检测上阵
    local isembattleAll = require("EmbattleModel"):GetInstance():CheckHeroEmbattle(CardData.uid)
    if isembattleAll then
        CheckCount = CheckCount + 1
    end
    ---检测 上锁
    local isLock = CardData.unlock == 1
    if isLock then
        CheckCount = CheckCount + 1
    end
    ---  如果只是检测 直接返回
    if isCheck == true then
        --ZHJH-2505 共鸣神石中的也能被吃 --更新：又不能被吃了，逆天 --更新：又能吃了
        -- if CardData.shenshiPosType ~= _G.StonePosType.PosZero then --共鸣神石主槽位卡牌不能被一键升星吞掉
        --     CheckCount = CheckCount + 1
        -- end
        return CheckCount > 0
    end

    local okFun = function()
        updataFun()
        --成功 减一
        CheckCount = CheckCount - 1
        --- 如果 该卡 还有其他牵扯  就不算成功(让玩家再次点击 再次提示)
        if CheckCount > 0 then
            failFun()
            return
        else
            if okCall ~= nil then
                okCall(ReData)
            end
        end
    end

    if CardData.unlock == 1 then --如果上锁了
        _G.PopWindowManager:GetInstance():ShowAllTips(
            2001,
            nil,
            _G.handler(
                self,
                function()
                    --确定  要解锁 并选中
                    require("CardInfoManager"):GetInstance():CardSuo(
                        CardData,
                        false,
                        _G.handler(
                            self,
                            function()
                                okFun()
                            end
                        )
                    )
                end
            ),
            function()
                failFun()
            end
        )
    elseif isembattleAll then --- 是否上阵
        if not isStarUp then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                2002,
                nil,
                _G.handler(
                    self,
                    function()
                        ReData.isEmbattle = true
                        okFun()
                        ---真吃了 在真下阵
                        -- local isok = require("EmbattleModel"):GetInstance():SetEmbattleDownByUid(CardData.uid)
                        -- if isok then
                        -- else
                        --     failFun()
                        -- end
                    end
                ),
                function()
                    failFun()
                end
            )
        end
    else
        okFun()
    end
end

---新版 卡牌销毁 前
---@param CardData CardData[]
