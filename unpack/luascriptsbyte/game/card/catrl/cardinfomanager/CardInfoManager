---检测卡牌是否可以升至某个星级
---@param list CardData[] 卡牌列表
---@param curStar number 当前星级
---@param targerStar number 目标星级
---@param sid number 卡牌sid
function CardInfoManager:GetCanUpToStar(list, sid, element, curStar, targerStar)
    if not list then
        list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    end
    local curMat = self:GetUpStarMat(element, curStar)
    local targerMat = self:GetUpStarMat(element, targerStar)
    local needMat = {}
    for k, v in pairs(targerMat) do
        needMat[k] = {}
        for star, num in pairs(v) do
            needMat[k][star] = num - (curMat[k][star] or 0)
        end
    end
    if needMat.materials_oneself[curStar] then
        needMat.materials_oneself[curStar] = needMat.materials_oneself[curStar] + 1
    end

    local god = _G.CardElementType.God
    for _, v in pairs(list) do
        if v.star < targerStar then
            if v.sid == sid and needMat.materials_oneself[v.star] then
                needMat.materials_oneself[v.star] = needMat.materials_oneself[v.star] - 1
            end
            if needMat.materials_elements[v.star] then
                if element == god then
                    needMat.materials_elements[v.star] = needMat.materials_elements[v.star] - 1
                elseif v:GetElement() == element then
                    needMat.materials_elements[v.star] = needMat.materials_elements[v.star] - 1
                end
            end
        end
    end
    for _, v in pairs(needMat) do
        for _, v2 in pairs(v) do
            if v2 > 0 then
                return false
            end
        end
    end
    return true
end

