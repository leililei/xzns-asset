function CardInfoManager:BindCardRedPointEquiment(add, rem, change)
    local redpointmanager = require("RedPointManager"):GetInstance()
    --绑定装备红点
    if not _G.table.isEmptyOrNil(add) then
        for key, value in pairs(add) do
            local part_uid
            for k, v in pairs(_G.EquipmentPart) do
                if v ~= _G.EquipmentPart.Trousers then
                    part_uid = key * 10 + v
                    redpointmanager:AddRedPointParam(_G.ConfigManager.redpoint_cfg.RoleEquipment.id, part_uid)
                    redpointmanager:AddRedPointParam(_G.ConfigManager.redpoint_cfg.SkinCard.id, value)
                    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SkinCard.id, key)
                    redpointmanager:AddRedPointParam(_G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id, part_uid)
                end
            end
        end
    end
    if not _G.table.isEmptyOrNil(rem) then
        for key, value in pairs(rem) do
            local part_uid
            for k, v in pairs(_G.EquipmentPart) do
                if v ~= _G.EquipmentPart.Trousers then
                    part_uid = key * 10 + v
                    redpointmanager:RemoveRedPointParam(_G.ConfigManager.redpoint_cfg.RoleEquipment.id, part_uid)
                    redpointmanager:RemoveRedPointParam(_G.ConfigManager.redpoint_cfg.SkinCard.id, value)
                    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SkinCard.id, key)
                    redpointmanager:AddRedPointParam(_G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id, part_uid)
                end
            end
        end
    end
    if not _G.table.isEmptyOrNil(change) then
        for key, value in pairs(change) do
            for k, v in pairs(_G.EquipmentPart) do
                if v ~= _G.EquipmentPart.Trousers then
                    require("RedPointManager"):GetInstance():RefreshNode(
