                ---升星消耗的卡牌
                ---@type number[]
                local destroyUids = {}
                ---消耗卡牌的sid
                ---@type number[][]
                local destroySids = {}
                ---销毁的卡牌是否在神石核心上
                local inStoneCore = false

                local newPbData = { uids = {} }
                for _, targets in ipairs(targetss) do
                    ---构造pbData
                    ---@type card.c2s_card_up_star
                    local pbData = { uids = {} }

                    for _, target in ipairs(targets) do
                        ---@type card.i_c_uid
                        local i_c_uid = { uid = target[1].uid, c_uids = {}, c_uids2 = {} }
                        ---@type number[]
                        local _sids = destroySids[target[1].uid] or {}
                        table.insert(pbData.uids, i_c_uid)
                        --table.insert(destroySids, _sids)
                        destroySids[target[1].uid] = _sids

                        ---@param cardData CardData
                        for _, cardData in pairs(target[2]) do
                            table.insert(i_c_uid.c_uids, cardData.uid)
                            table.insert(_sids, cardData.sid)
                            table.insert(destroyUids, cardData.uid)
                            if cardData.shenshiPosType == _G.StonePosType.PosTwo then
                                inStoneCore = true
