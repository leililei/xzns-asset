--- 缓存技能解锁等级
function CardInfoManager:SetLevelSkillUnlockDic()
    --- 当前的技能等级数组
    local nowSkillArr = {}

    local tempOrder = nil
    local skillArr = nil

    local card_level_cfg = _G.ConfigManager.card_level_cfg
    local MaxLv = table.count(card_level_cfg)
    local card_level_cfgItem = nil
    ---@param card_level_cfgItem card_level_cfg
    for lv = 1, MaxLv do
        card_level_cfgItem = card_level_cfg[lv]
        if card_level_cfgItem ~= nil then
            skillArr = card_level_cfgItem.level_skill
            for i = 1, #skillArr do
                if nowSkillArr[i] == nil then
                    nowSkillArr[i] = {}
                end
                if table.sameByCount(skillArr[i], nowSkillArr[i]) == false then
                    nowSkillArr[i] = skillArr[i] or {}

                    if self.LevelSkillUnlockDic[i] == nil then
                        self.LevelSkillUnlockDic[i] = {}
                    end
                    table.insert(self.LevelSkillUnlockDic[i], lv - 1)
                end
            end
        end
    end
    -- body
end

--- 获取低一档的技能解锁等级   返回配置里大于checkLV的等级  只返回限制在配置区间的等级
--- 51 {20，40，60}  return 40
---品质一最高解锁等级40级   51 return nil
function CardInfoManager:GetLevelSkill(Order, checkLV, nowLv)
    local OrderMax = 4
    local lvArr = self.LevelSkillUnlockDic[Order]
    if lvArr == nil then
        return nil
    end

    local arr = {}
    local len = #lvArr
    for i = 1, len do
        --    51 {20，40，60} return 40
        if lvArr[i] >= checkLV then
            if lvArr[i] > checkLV then
                return lvArr[i - 1]
            else
                return lvArr[i]
            end
        end
    end

    --    51 {0,20，40}  return 40
    return lvArr[len]
