---星级父节点 设置星级显示
---@param gameObject UnityEngine.GameObject  星级 父节点
function CardInfoManager:StarEf_byParent(gameObject, star)
    if _G.IsNil(gameObject) or star == nil then
        return
    end
    local transform = gameObject
    local childCount = transform:GetChildCountE()

    local t_i = 0
    local function tFun()
        t_i = t_i + 1
        if t_i > childCount then
            return
        end
        if _G.IsNil(transform) then
            return
        end
        local tObj = transform:GetChildE(t_i - 1)

        if tObj ~= nil then
            local tAorImage = tObj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if tAorImage ~= nil then
                self:Star_setEf(
                    tAorImage,
                    self:GetHuoType(star, t_i),
                    function(tran)
                        if _G.IsNil(tran) then
                            tran:DestroyObject()
                        end
                        _G.DelayDo(
                            self.UPSTAR_EFTIME,
                            function()
                                tFun()
                            end
                        )
                    end
                )
            end
        end
    end
    tFun()
end

