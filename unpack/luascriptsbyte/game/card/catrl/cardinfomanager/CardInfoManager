                                                            return
                                                        end
                                                        --- 返回 操作撤回函数
                                                        okFun(
                                                            function()
                                                                EquipmentReFun()
                                                                -- body
                                                            end
                                                        )
                                                    end
                                                )
                                            end
                                        )
                                    end
                                )
                            end
                        )
                    end
                )
            )
        end
    )
end

