---获取 星级 对应品质与星数量
---@return number,number 品质，星数量  order, starCount
function CardInfoManager:GetOrderStarCount(star)
    local starCount = 0
    local order = 1

    star = tonumber(star)
    if star == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 星级输入有误 ")
        end
        return order, starCount
    end

    local starArr
    for i = 1, #self.StarIndexDic do
        starArr = self.StarIndexDic[i]
        if starArr ~= nil then
            for j = 1, #starArr do
                if star == starArr[j] then
                    starCount = j - 1
                    if starCount >= 6 then
                        starCount = starCount - 5
                    end
                    order = i
                    return order, starCount
                end
            end
        end
    end

    return order, starCount
end

