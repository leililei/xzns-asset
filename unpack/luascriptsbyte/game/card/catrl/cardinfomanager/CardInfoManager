                end
                if needMat.materials_elements[v.star] then
                    if element == god then
                        needMat.materials_elements[v.star] = needMat.materials_elements[v.star] - 1
                    elseif v:GetElement() == element then
                        needMat.materials_elements[v.star] = needMat.materials_elements[v.star] - 1
