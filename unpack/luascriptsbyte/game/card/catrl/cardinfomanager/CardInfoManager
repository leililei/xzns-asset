---检查卡牌技能是否解锁
---@param cardData CardData
---@param cardSkillCfg card_skills_cfg
function CardInfoManager.CheckCardSkillIsUnlock(cardData, cardSkillCfg, useLvOld)
    if cardSkillCfg.skill_pos == 8 then --SP技能
        local cond = _G.ConfigManager.discrete_cfg[100142][1]
        if cond[1] == 1 then            --等级
            if useLvOld then
                return cardData.lv_Old >= cond[2]
            else
                return cardData.lv >= cond[2]
            end
        elseif cond[1] == 2 then --星级
            return cardData.star >= cond[2]
        elseif cond[1] == 3 then --魂链
            return cardData.soulLink_IsActivate == 1 and cardData.soulLink_lv >= cond[2]
        elseif cond[1] == 4 then --天赋
            return _G.table.count(cardData.open_inborn) >= cond[2]
        end
        return false
    else
        if useLvOld then
            return cardSkillCfg.condition_star <= cardData.lv_Old
        else
            return cardSkillCfg.condition_star <= cardData.lv
        end
    end
end

---获取非本体狗粮卡
---@param cardData CardData
function CardInfoManager.GetNotSelfDogFoodCards(cardData)
    local cards = {}
    local disCards = 0
    local cfg = _G.ConfigManager.card_star_cfg
    [require "CardInfoManager":GetInstance():GetStarCfgId(cardData.cfg.Elements_new, cardData.star)]
    local star = #cfg.materials_elements ~= 0 and cfg.materials_elements[1] or cardData.star
    if cfg.materials_oneself[1] and star == cardData.star then
        star = cfg.materials_oneself[1]
    end
    local element = cardData:GetElement_new()
    local isGod = require("CardInfoManager"):GetInstance():CheckMultiMatchCOP(element, _G.CardElementType.God)
    local allCards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for _, v in pairs(allCards) do
        local confirm = false
        if v.star == star and v.uid ~= cardData.uid then
            if isGod then
                -- 不需要消耗其他卡牌  并且  为同种卡牌
                if #cfg.materials_elements == 0 and v.cfg.id == cardData.cfg.id then
                    -- 需要消耗其他卡牌
                    confirm = true
                elseif #cfg.materials_elements ~= 0 then
                    confirm = true
                end
            elseif (require "CardInfoManager":GetInstance():CheckMultiMatch(v:GetElement_new(), element) and #cfg.materials_elements ~= 0) or v.cfg.id == cardData.cfg.id then
                confirm = true
            end
        end
        -- ZHJH-2505 共鸣神石中的也能被选中
        if confirm then
            -- 不能选中计数+1
            _G.table.insert(cards, v)
        else
            disCards = disCards + 1
        end
    end
    return cards, disCards
end

