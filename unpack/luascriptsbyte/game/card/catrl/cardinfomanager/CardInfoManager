            -- end

            ---脱掉需要消耗的英雄的装备
            ---@param targets Data[]
            ---@param confirm fun(revocationFn:function):void
            local function readyDestroy(targetss, confirm)
                ---@type number[]
                local consumeIds = {}

                for _, targets in ipairs(targetss) do
                    for _, target in ipairs(targets) do
                        ---@param cardData CardData
                        for _, cardData in pairs(target[2]) do
                            table.insert(consumeIds, cardData.uid)
                        end
                        ---@param cardData CardData
                        for _, cardData in pairs(target[3]) do
                            table.insert(consumeIds, cardData.uid)
                        end
                    end
                end

                self:CardNewReadyDestroy(
                    consumeIds,
                    function(revocationFn)
                        confirm(revocationFn)
                    end,
                    function()
                        if callback then
                            callback(false, nil)
                        end
                    end
                )
            end
            ---执行升星操作
            ---@param targets Data[]
            ---@param revocationFn fun():void       撤销readyDestroy操作
