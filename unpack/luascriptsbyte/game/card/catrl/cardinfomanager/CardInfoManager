---设置魂链和天赋显示
---@param goTable ItemCardBaseView_GoTable 或者其它卡牌预制体
---@param soulLinkLv number 魂链等级，如果为-1则未激活
---@param talents number|table 天赋（大天赋数量或者天赋列表）
function CardInfoManager:SetSoulLinkAndTalent(goTable, soulLinkLv, talents)
    soulLinkLv = soulLinkLv or 0
    talents = talents or {}

    local soulLinkName
    local lvStep = { 0, 10, 20, 30 }
    if soulLinkLv == -1 then
        goTable.aorimage_eSoulChain:SetActiveE(0)
    else
        for i = 1, #lvStep do
            if soulLinkLv >= lvStep[i] then
                soulLinkName = self.Enum.SoulLink[i]
            else
                break
            end
        end
        goTable.aorimage_eSoulChain:SetActiveE(1)
        goTable.aorimage_eSoulChain.SpriteName = soulLinkName
    end

    local num = 0
    if _G.IsNumber(talents) then
        num = talents
    else
        local tCfg
        for i = 1, #talents do
            tCfg = _G.ConfigManager.attribute_cfg[talents[i]]
            if tCfg.skill > 0 then
                num = num + 1
            end
        end
    end
    goTable.aorimage_eTanlent1:SetActiveE(num > 0 and 1 or 0)
    goTable.aorimage_eTanlent2:SetActiveE(num > 1 and 1 or 0)
    goTable.aorimage_eTanlent1:SetLocalPosition(num == 1 and 0 or -11.5, 32.5, 0)
end

---获取激活大天赋数量
---@param sid number 卡牌sid
---@param skills table fight_arg中的卡牌技能组
---@return number 激活的大天赋数量
function CardInfoManager:GetTalentsNum(sid, skills)
    local cfg = _G.ConfigManager.card_cfg[sid]
    if cfg == nil then
        return 0
    end
    local attrCfg = _G.ConfigManager.attribute_cfg
    local tCfg
    local num = 0
    for i, node in pairs(cfg.talent) do
        for j, talent in pairs(node) do
            tCfg = attrCfg[talent]
            if tCfg.skill > 0 and _G.table.ContainsValue(skills, tCfg.skill) then
                num = num + 1
            end
        end
    end
    return num
end

---获取激活大天赋数量
---@param sid number 卡牌sid
---@param openInborn table 解锁的天赋
---@return number 激活的大天赋数量
function CardInfoManager:GetTalentsNumByInborn(openInborn)
    local attrCfg = _G.ConfigManager.attribute_cfg
    local num = 0
    for j, talent in pairs(openInborn) do
        if attrCfg[talent].skill > 0 then
            num = num + 1
        end
    end
    return num
end

---@field lvL number 当前等级
---@field lvR number 提升后等级
---@field CardSid number 卡牌sid
---@field Order number 卡牌品质 N卡(1) 读card_level_cfg.level_skill2字段
---@class params_CheckCardLvUpSkill

---@param data params_CheckCardLvUpSkill
---@return number SkillId 解锁(升级)的技能id   nil 则没有
function CardInfoManager.CheckCardLvUpSkill(data)
    local lvL = data.lvL
    local lvR = data.lvR
    local Order = data.Order
    local CardSid = data.CardSid

    local levelCfgL = _G.ConfigManager.card_level_cfg[lvL]
    local levelCfgR = _G.ConfigManager.card_level_cfg[lvR]

    local SkillPos = nil
    local SkillLv = nil
    local SkillId = nil

    for pos, lv_R in pairs(levelCfgR.level_skill[Order]) do
        local lvcfg_L = levelCfgL and levelCfgL.level_skill[Order] or nil
        if lvcfg_L ~= nil then
            local lv_L = lvcfg_L[pos]
            if lv_R > lv_L then
                SkillPos = pos
                SkillLv = lv_R
                break
            end
        end
    end
    if SkillPos ~= nil and SkillLv ~= nil then
        SkillId = CardSid + SkillPos * 100 + SkillLv
    end
    return SkillId
end

---异步加载Rawiamge 防止界面卡帧
---@param tb table  go_table
---@param key string   初次加载成功 第二次无需异步
---@param icon string   image地址
---@param IsInitItem table   表存储key是否已初次加载过
---@param TimerDic table   存储timer 方便界面关闭销毁
function CardInfoManager.SetRawImageTimer(tb, key, Index, rawImage, icon, IsInitItem, TimerDic, call)
    if tb.Time_load ~= nil then
        _G.coroutine.stopwaiting(tb.Time_load)
        tb.Time_load = nil
        TimerDic[key .. tostring(Index)] = nil
    end
    if IsInitItem[key] == true then
        CardInfoManager.LoadRawImage(rawImage, icon, call)
    else
        tb.Time_load =
            _G.DelayDo(
                0.02 * Index,
                function()
                    CardInfoManager.LoadRawImage(rawImage, icon, call)
                end
            )
        TimerDic[key .. tostring(Index)] = tb.Time_load
    end
end

