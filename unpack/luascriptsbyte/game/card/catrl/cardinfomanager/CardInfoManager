function CardInfoManager:IsMaxUpStar(CardData)
    if not CardData then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "参数无效" .. "</color>")
        end
        return false
    end
    local maxStar = self.MaxStarDic[CardData.Grade] or 1
    return CardData.star >= maxStar
end

