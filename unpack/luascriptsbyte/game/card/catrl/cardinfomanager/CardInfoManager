--- Spawn 从对象池取出对象
---@param resPath string 对象路径
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
---@param parent Transform 加载物体后设置的父节点
---@param RoleEffTypeEnum RoleEffTypeEnum roleEff_cfg表显示配置 _G.RoleEffTypeEnum.Fight
---@param callback fun(obj:UnityEngine.Transform) 加载物体后的回调
function CardInfoManager.GetRole(resPath, poolType, parent, RoleEffTypeEnum, callback)
    local item = require "SpawnItem".New()
    item:Spawn(
        resPath,
        poolType,
        parent,
        function(trans, path)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            if trans then
                trans:SetLocalPosition(0, 0, 0)
            end
            if callback then
                callback(trans, path)
            end
        end
    )
    return item
end

---Despawn 回收对象至对象池
---@param trans Transform 对象
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
function CardInfoManager.DelRole(roleTran, poolType, callback)
    local GoTable
    local UIGoTable = roleTran:GetComponentE(_G.typeof(_G.CS.UIGoTable))
    if UIGoTable == nil then
        UIGoTable = roleTran:AddComponentE(_G.typeof(_G.CS.UIGoTable))
    end
    ---用lua表方便存数据
    GoTable = UIGoTable:CreateLuaGoTable()

    if GoTable.EffArr then
        for path, tran in pairs(GoTable.EffArr) do
            _G.PoolsManager:GetInstance():Despawn(tran, poolType)
        end
        GoTable.EffArr = nil
    end
    _G.PoolsManager:GetInstance():Despawn(roleTran, poolType)
    if callback then
        callback()
    end
end

