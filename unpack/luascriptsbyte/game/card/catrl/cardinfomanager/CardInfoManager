-- 获取卡牌 排序 星级>战力>sid
function CardInfoManager:GetSortStarLvSid(list)
    if list == nil then
        list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    end
    local tSort = table.values(list)
    ---@param  item CardData
    SortList(
        tSort,
        function(item)
            return item.star, item.power, item.sid, item.uid
        end
    )
    return tSort
end

-- 升星获取卡牌  优先可升星卡牌 其次星级>等级>sid 其他不可升星卡牌
---@param list CardData[] 中文描述
---@param needStar number 需要的卡牌星级
---@return CardData[]
function CardInfoManager:GetSortUpStarLvSid(list)
    if list == nil then
        local MinStar = 4

        ---@type discrete_cfg
        local discrete_cfg = _G.ConfigManager.discrete_cfg[100505]
        if discrete_cfg ~= nil then
            MinStar = discrete_cfg[1][1]
        end

        list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
        ---@param v CardData
        list =
            table.choose(
                list,
                function(k, v)
                    return v.star >= MinStar and v.star <= 27
                end
            )
    end

    --- 本体  {  sid*100+星级=数量 }
    local OneSelfDic = {}
    --- 五行  { 五行*100+星级=数量 }
    local ElementsDic = {}

    ---  uid={}
    local AllCard = {}
    for key, mCardData in pairs(list) do
        local Elements_new = mCardData.cfg.Elements_new
        local star = mCardData.star
        local sid = mCardData.sid
        local uid = mCardData.uid
        local posType = mCardData.shenshiPosType

        ---@field sid number
        ---@field star number
        ---@field Elements_new table
        ---@field uid number
        ---@class AllCardUpStarItem

        AllCard[uid] = { sid = sid, star = star, Elements_new = Elements_new, uid = uid, posType = posType }
    end

    ------@param item  AllCardUpStarItem
    for uid, item in pairs(AllCard) do
        local Elements_new = item.Elements_new
        local star = item.star

        local selfKey = item.sid * 100 + star
        if OneSelfDic[selfKey] == nil then
            OneSelfDic[selfKey] = {}
        end
        table.insert(OneSelfDic[selfKey], uid)

        local eleKey = self:GetStarCfgId(Elements_new, star)
        if ElementsDic[eleKey] == nil then
            ElementsDic[eleKey] = {}
        end
        table.insert(ElementsDic[eleKey], uid)
    end
    --- 升星消耗  uid=true 能升星
    local upStarXh = {}
    --- 能升星的卡
    local upStarArr = {}
    local AllCardSub,
    Elements_new,
    card_star_cfgId,
    sxCfg,
    isFindSelf,
    isFindEle,
    isSubMy,
    selfKey,
    num,
    eleKey,
    isok,
    maxstrar
    ---获取狗粮卡
    local propCardCount = {}
    local propStar = {}
    for k, v in pairs(_G.ConfigManager.item_card_cfg) do
        local count = _G.StorageManager:GetInstance():GetItemCountBySid(k)
        propCardCount[v.Elements] = count
        propStar[v.Elements] = v.Star
    end
    --- true是神  神能吃任意五行对应星级的卡
    local isShen = false
    for key, mCardData in pairs(list) do
        AllCardSub = {}
        Elements_new = mCardData.cfg.Elements_new
        isShen = self:CheckMultiMatch(6, Elements_new)
        card_star_cfgId = self:GetStarCfgId(Elements_new, mCardData.star)
        ---@type card_star_cfg
        sxCfg = card_star_cfg[card_star_cfgId]
        isFindSelf = false
        isFindEle = false
        --- 自己加一  除外自己
        isSubMy = false
        ----达到最大星级的不能升
        maxstrar = self.MaxStarDic[mCardData.Grade] or 1
        if maxstrar > mCardData.star and sxCfg and (#sxCfg.materials_oneself > 0 or #sxCfg.materials_elements > 0) then
            if #sxCfg.materials_oneself > 0 then
                selfKey = mCardData.sid * 100 + sxCfg.materials_oneself[1]
                num = sxCfg.materials_oneself[2]
                --- 如果需要的和自己同星 要加一
                if sxCfg.materials_oneself[1] == mCardData.star then
                    num = num + 1
                    isSubMy = true
                end

                if OneSelfDic[selfKey] and #OneSelfDic[selfKey] >= num then
                    local DelUids = {}
                    for _, uid in pairs(OneSelfDic[selfKey]) do
                        if AllCard[uid] and AllCardSub[uid] ~= true then
                            table.insert(DelUids, uid)
                        end
                        if #DelUids >= num then
                            break
                        end
                    end
                    if #DelUids < num then
                    else
                        for i = 1, #DelUids do
                            AllCardSub[DelUids[i]] = true
                        end
                        isFindSelf = true
                    end
                end
            else
                isFindSelf = true
            end
            if #sxCfg.materials_elements > 0 then
                num = sxCfg.materials_elements[2]
                local canUseProp = sxCfg.materials_elements[1] == propStar[_G.CardElementType.Common]
                local propCard = canUseProp and propCardCount[_G.CardElementType.Common] or 0
                ---- 现在神能吃任意五行对应星级的卡只能遍历
                if isShen == true then
                    for i = 1, 6 do
                        eleKey = i * 100 + sxCfg.materials_elements[1]
                        canUseProp = sxCfg.materials_elements[1] == propStar[i]
                        if canUseProp and propCardCount[i] then
                            propCard = propCardCount[i] + propCard
                        end
                        --- 如果需要的和自己同星 要加一
                        if sxCfg.materials_elements[1] == mCardData.star and isSubMy == false then
                            num = num + 1
                            isSubMy = true
                        end
                        if ElementsDic[eleKey] and #ElementsDic[eleKey] >= num then
                            local DelUids = {}
                            for _, uid in pairs(ElementsDic[eleKey]) do
                                if AllCard[uid] and AllCardSub[uid] ~= true then
                                    table.insert(DelUids, uid)
                                end
                                if #DelUids >= num then
                                    break
                                end
                            end
                            if #DelUids < num then
                            else
                                for j = 1, #DelUids do
                                    AllCardSub[DelUids[j]] = true
                                end
                                isFindEle = true
                            end
                        end
                        if isFindEle == true then
                            break
                        end
                    end
                else
                    canUseProp = sxCfg.materials_elements[1] ==
                        propStar[self:GetStarElements(mCardData.cfg.Elements_new)]
                    if canUseProp then
                        propCard = propCardCount[self:GetStarElements(mCardData.cfg.Elements_new)] + propCard
                    end
                    eleKey = self:GetStarElements(mCardData.cfg.Elements_new) * 100 + sxCfg.materials_elements[1]
                    --- 如果需要的和自己同星 要加一
                    if sxCfg.materials_elements[1] == mCardData.star and isSubMy == false then
                        num = num + 1
                        isSubMy = true
                    end
                    --- 如果有同种族卡牌则加上狗粮卡判断是否足够，没有同种族卡直接判断狗粮卡数量
                    if propCard >= num or (ElementsDic[eleKey] ~= nil and #ElementsDic[eleKey] + propCard >= num) then
                        local DelUids = {}
                        if ElementsDic[eleKey] then
                            for _, uid in pairs(ElementsDic[eleKey]) do
                                if AllCard[uid] and AllCardSub[uid] ~= true then
                                    table.insert(DelUids, uid)
                                end
                                if #DelUids >= num then
                                    break
                                end
                            end
                        end

                        if #DelUids + propCard < num then
                        else
                            for i = 1, #DelUids do
                                AllCardSub[DelUids[i]] = true
                            end
                            isFindEle = true
                        end
                    end
                end
            else
                isFindEle = true
            end
        end
        isok = isFindSelf and isFindEle
        upStarXh[mCardData.uid] = isok
        if isok then
            table.insert(upStarArr, mCardData.uid)
        end
    end

    --- [uid]=num
    local numDic = {}
    local tSort = table.values(list)
    ---@param  item CardData
    SortList(
        tSort,
        function(item)
            num = numDic[item.uid]
            if num == nil then
                if upStarXh[item.uid] == true then
                    num = 3
                else
                    num = 0
                end
                numDic[item.uid] = num
            end
            --return num, item.star, -(item:GetElement() % 6), item.power, item.sid, item.uid
            return num, item.star, item:GetLevel(),-(item:GetElement() % 6), item.power, item.sid, item.uid
        end
    )
    return tSort, upStarArr, upStarXh
end

---获取所有可以升星的组和后续组
function CardInfoManager:GetSortUpStarAllAndAfter(list, isCheck, callback)
    if list == nil then
        list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    end
    self.CheckStarList = _G.DeepCopy(list)

    self.StarSortList = {}
    self:GetSortUpStarAllAndAfterMiddle(isCheck, callback)
end

---递归找组
function CardInfoManager:GetSortUpStarAllAndAfterMiddle(isCheck, callback)
    local listsort = self:GetSortUpStarAllAndAfterDo(isCheck)
    if not listsort or #listsort <= 0 then
        if callback then
            local index = 0
            for i = 1, #self.StarSortList do
                index = index + #self.StarSortList[i]
            end
            if _G.AppSetting.DEBUG then
                _G.Log(index, "当前总共可升星卡片组数为")
            end
            callback(self.StarSortList)
        end
    else
        table.insert(self.StarSortList, listsort)
        for i = 1, #listsort do
            for _, mCardData in pairs(self.CheckStarList) do
                if mCardData.uid == listsort[i][1].uid then
                    mCardData.star = mCardData.star + 1
                end
            end
            for j = 1, #listsort[i][2] do
                for uid, mCardData in pairs(self.CheckStarList) do
                    if mCardData.uid == listsort[i][2][j].uid then
                        self.CheckStarList[uid] = nil
                        break
                    end
                end
            end
            for k = 1, #listsort[i][3] do
                for uid, mCardData in pairs(self.CheckStarList) do
                    if mCardData.uid == listsort[i][3][k].uid then
                        self.CheckStarList[uid] = nil
                        break
                    end
                end
            end
        end
        self:GetSortUpStarAllAndAfterMiddle(isCheck, callback)
    end
end

-- 获取 自动升星 卡牌 所有组别
---@param isCheck boolean 检测模式  如果有可一键升星 就直接返回
---@return CardData[][]
function CardInfoManager:GetSortUpStarAllAndAfterDo(isCheck)
    local list = self.CheckStarList
    --- 小于等于 可一键升星
    local MinStar = 4
    local MaxStar = 6

    ---@type discrete_cfg
    local discrete_cfg = _G.ConfigManager.discrete_cfg[100505]
    if discrete_cfg ~= nil then
        MinStar = discrete_cfg[1][1]
        MaxStar = discrete_cfg[1][2]
    end
    --- 不同的升星id  计数
    ---@type table<number,CardData[]>
    local CardUpStar = {}
    ---最大升星组 数量
    local cfg = _G.ConfigManager.discrete_cfg[100502]
    local upstarMaxCount = cfg and cfg[1][1] or 10

    ---优先升的sid  有5星同名卡优先  优先该卡一键升4
    local onesidDic = {}

    --- 不同的升星id  数组  用于排序  低星先升
    local cfgIdS = {}
    for key, mCardData in pairs(list) do
        local maxstrar = self.MaxStarDic[mCardData.Grade]
        ---未达到最大星 才可升星
        if maxstrar == nil or mCardData.star < maxstrar then
            if mCardData.unlock == 0 and mCardData.star >= MinStar and mCardData.star <= MaxStar then
                local card_star_cfgId = self:GetStarCfgId(mCardData.cfg.Elements_new, mCardData.star)
                if mCardData.star == 5 then
                    if onesidDic[mCardData.sid] == nil then
                        onesidDic[mCardData.sid] = true
                    end
                end
                local sxCfg = _G.ConfigManager.card_star_cfg[card_star_cfgId]
                if sxCfg ~= nil then
                    if CardUpStar[card_star_cfgId] == nil then
                        CardUpStar[card_star_cfgId] = {}
                        table.insert(cfgIdS, card_star_cfgId)
                    end
                    table.insert(CardUpStar[card_star_cfgId], mCardData)
                end
            end
        end
    end

    table.sort(
        cfgIdS,
        function(a, b)
            return a % 10 < b % 10
        end
    )

    ---低质量的先吃
    for _, value in pairs(CardUpStar) do
        SortList(
            value,
            function(item)
                return onesidDic[item.sid] and 1 or 0, item.cfg.Order, item.shenshiPosType, item.lv_Old, item.power,
                    item.sid, item.uid
            end
        )
    end

    local tSort = {}
    --- 无法被吃的卡(锁住上阵等, 但可吃别人升星)
    local DontDel = {}

    --可升星卡字典
    local starDic = {}

    for _, cfgId in pairs(cfgIdS) do
        local cardList = CardUpStar[cfgId]
        if cardList ~= nil then
            ---至少 有一张卡 主卡
            if #cardList > 0 then
                --- 作为主卡判断过的卡 去重
                local uidDic = {}
                local CheckFun = nil
                CheckFun = function()
                    local isL = nil
                    local isR = nil
                    local nowCard =
                        table.find(
                            cardList,
                            function(a)
                                return uidDic[a.uid] == nil
                            end
                        )
                    if nowCard == nil then
                        return
                    end
                    table.removebyvalue(cardList, nowCard)
                    uidDic[nowCard.uid] = true
                    local cardid = nowCard.uid

                    local oneselfStarId = nil
                    local oneselfList = {}

                    local elementsStarId = nil
                    local elementsList = {}

                    local sxCfg = _G.ConfigManager.card_star_cfg[cfgId]

                    local haveMaterials_oneself = _G.table.isEmptyOrNil(sxCfg.materials_oneself) == false
                    if haveMaterials_oneself then
                        isL = false
                        local count = 0
                        local star = sxCfg.materials_oneself[1]
                        local num = sxCfg.materials_oneself[2]
                        oneselfStarId = nowCard.cfg.Elements * 100 + star
                        local List = CardUpStar[oneselfStarId]
                        if List ~= nil and #List >= num then
                            for i = #List, 1, -1 do
                                local c = List[i]

                                if DontDel[c.uid] == nil then
                                    ---检测能否被吃
                                    DontDel[c.uid] = require("CardInfoManager").CardReadyDestroy(c, nil, nil, nil, true)
                                end
                                if DontDel[c.uid] == false and c.sid == nowCard.sid then
                                    table.insert(oneselfList, table.remove(List, i))
                                    count = count + 1
                                    if count == num then
                                        break
                                    end
                                end
                            end
                            ---数量不足  还回去
                            if count < num then
                                for i = #oneselfList, 1, -1 do
                                    table.insert(CardUpStar[oneselfStarId], 1, table.remove(oneselfList, 1))
                                end
                                table.insert(CardUpStar[cfgId], 1, nowCard)
                            else
                                isL = true
                            end
                        end
                    end

                    local haveMaterials_elements = _G.table.isEmptyOrNil(sxCfg.materials_elements) == false
                    if isL ~= false and haveMaterials_elements then
                        isR = false
                        local count = 0
                        local star = sxCfg.materials_elements[1]
                        local num = sxCfg.materials_elements[2]

                        --- true是神  神能吃任意五行对应星级的卡
                        if nowCard.cfg.Elements == 6 then
                            for i = 1, 6 do
                                elementsStarId = i * 100 + star
                                local List = CardUpStar[elementsStarId]
                                if List ~= nil and #List >= num then
                                    for j = #List, 1, -1 do
                                        local c = List[j]
                                        if DontDel[c.uid] == nil then
                                            ---检测能否被吃
                                            DontDel[c.uid] =
                                                require("CardInfoManager").CardReadyDestroy(c, nil, nil, nil, true)
                                        end
                                        if DontDel[c.uid] == false then
                                            table.insert(elementsList, table.remove(List, i))
                                            count = count + 1
                                            if count == num then
                                                break
                                            end
                                        end
                                    end
                                    ---数量不足  还回去
                                    if count < num then
                                        for j = #elementsList, 1, -1 do
                                            table.insert(CardUpStar[elementsStarId], 1, table.remove(elementsList, 1))
                                        end
                                        table.insert(CardUpStar[cfgId], 1, nowCard)
                                    else
                                        isR = true
                                    end
                                end
                                if isR == true then
                                    break
                                end
                            end
                        else
                            elementsStarId = nowCard.cfg.Elements * 100 + star
                            local List = CardUpStar[elementsStarId]
                            if List ~= nil and #List >= num then
                                for i = #List, 1, -1 do
                                    local c = List[i]
                                    if DontDel[c.uid] == nil then
                                        ---检测能否被吃
                                        DontDel[c.uid] =
                                            require("CardInfoManager").CardReadyDestroy(c, nil, nil, nil, true)
                                    end
                                    if DontDel[c.uid] == false then
                                        table.insert(elementsList, table.remove(List, i))
                                        count = count + 1
                                        if count == num then
                                            break
                                        end
                                    end
                                end
                                ---数量不足  还回去
                                if count < num then
                                    for i = #elementsList, 1, -1 do
                                        table.insert(CardUpStar[elementsStarId], 1, table.remove(elementsList, 1))
                                    end
                                    table.insert(CardUpStar[cfgId], 1, nowCard)
                                else
                                    isR = true
                                end
                            end
                        end
                    end
                    if isL == false or isR == false then
                    else
                        table.insert(tSort, { nowCard, oneselfList, elementsList })
                        if isCheck then
                            return tSort
                        end
                        if #tSort >= upstarMaxCount then
                            return
                        end
                    end
                    CheckFun()
                end
                CheckFun()
            end
            if #tSort >= upstarMaxCount then
                break
            end
        end
    end
    if #tSort > 0 then
        --region --------------------------------------ZHJ-8382 一键升星列表排序应该按照升星对象星级从低到高排序。--------
        _G.SortList(
            tSort,
            function(arrs)
                ---@type CardData
                local carddata = arrs[1]
                return carddata.star, carddata.Grade, carddata.lv, carddata.sid, carddata.uid
            end
        )
    end
    return tSort
end

