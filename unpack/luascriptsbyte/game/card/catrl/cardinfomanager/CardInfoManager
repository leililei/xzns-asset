                                inStoneCore = true
                            end
                        end
                    end

                    table.insert(newPbData.uids, pbData)
                end

                require("CardInfoNet"):GetInstance():UpStar(
                    newPbData,
                    function(msg)
                        if not msg or msg.ack ~= 1 then
                            if revocationFn then
                                revocationFn()
                            end
                            if callback then
                                callback(false, nil)
                            end
                            return
                        end
                        local power = _G.StorageManager:GetInstance():GetPlayerPower()

                        --销毁卡牌实例
                        self:CardNewStartDestroy(destroyUids)
                        for _, uid in ipairs(destroyUids) do
                            _G.StorageManager:GetInstance():DelCard(uid)
                        end
                        local lstCardAward = {} --升级后的英雄信息
                        --更新升级主体卡牌
                        -- for index, targets in ipairs(targetss) do
                        --     for index, target in ipairs(targets) do
