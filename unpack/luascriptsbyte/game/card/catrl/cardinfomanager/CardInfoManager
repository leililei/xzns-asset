---获取卡牌 升星  显示的两个变化技能
---@param CardData CardData
---@param star number 指定星级 默认当前星级+1
---@return number[]  @[技能id1，技能id2] 如果相同 第一个代表锁定状态
function CardInfoManager:GetUpStarSkill(CardData, star)
    local nextSkills = {}
    local mstar = CardData.star + 1
    if not _G.IsNil(star) then
        mstar = star
    end
    for skillid, value in pairs(card_skills_cfg) do
        if value.card_id == CardData.sid and value.condition_star == mstar then
            --如果是一级  相同 代表 第一个是锁定
            if value.level == 1 then
                table.insert(nextSkills, skillid)
                table.insert(nextSkills, skillid)
            else
                table.insert(nextSkills, skillid - 1)
                table.insert(nextSkills, skillid)
            end
        end
    end
    return nextSkills
end

