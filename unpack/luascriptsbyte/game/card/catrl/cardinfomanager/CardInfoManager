    end
    local transform = gameObject
    local childCount = transform:GetChildCountE()
    for i = 1, childCount do
        local tObj = transform:GetChildE(i - 1)
        if tObj ~= nil then
            local tAorImage = tObj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if tAorImage ~= nil then
                self:Star_setSprite(tAorImage, self:GetHuoType(star, i))
            end
        end
    end
