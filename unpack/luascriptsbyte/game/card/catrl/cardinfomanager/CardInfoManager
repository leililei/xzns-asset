---多种族匹配是否一致（比较在前，卡片五行在后）
---@param MatchElements number|table 要比较的种族五行，1|{1,6}
---@param Elements table 卡片多种族五行例{1,6}
function CardInfoManager:CheckMultiMatch(MatchElements, Elements)
    if nil == Elements or nil == MatchElements then
        return false
    end
    Elements = self:GetElementsMulti(Elements)
    if type(MatchElements) == "number" then
        if false ~= table.indexof(Elements, MatchElements) then
            return true
        end
    elseif type(MatchElements) == "table" then
        for i = 1, #MatchElements do
            if false ~= table.indexof(Elements, MatchElements[i]) then
                return true
            end
        end
    end
    return false
end

