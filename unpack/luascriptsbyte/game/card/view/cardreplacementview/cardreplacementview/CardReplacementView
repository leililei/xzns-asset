local CardReplacementData = require("CardReplacementData")

---@class CardReplacementView : UIBaseView 窗口
---@field private go_table CardReplacementView_GoTable GoTable
---@field private super UIBaseView GoTable
local CardReplacementView = BaseClass("CardReplacementView", _G.UIBaseView)

---Create显示
---@protected
function CardReplacementView:OnCreate(times)
    self:InitData(times)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
    self:LoadEffect()
end

function CardReplacementView:InitData(times)
    self.isSelectCard = false
    ---@type CardData 选中的要置换英雄
    self.CurSelectCard = nil

    ---@type number 剩余可置换次数
    self.RemainingCount = times
    ---@type number 置换恢复倒计时
    self.RestoreTimer = 0

    ---@type table<number,CardData> 选中下方已有角色卡牌字典
    self.CurSelectCardDict = {}
    ---@type CardData[] 选中下方可选角色卡牌字典
    self.CurSelectCardList = {}

    self.maxSelectCardCount = 0
    self.isShowReplacement = false

    ---@type ItemCardHeadSelectView[] 角色头像Item
    self.cardItemList = {}

    ---@type CardReplacementData[] 卡牌置换配置数据
    self.CardReplacementDatas = {}

    self.CardReplacementDatas[1] = CardReplacementData.New(1, 5, 103706, nil, 103718, 91901090006, 91901090009)
    self.CardReplacementDatas[2] = CardReplacementData.New(2, 6, 103713, 103714, 103717, 91901090007, 91901090008)
    self.curSelectTagData = self.CardReplacementDatas[1]
end

function CardReplacementView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.CardReplacementDatas = nil
    self.cardItemList = nil
end

function CardReplacementView:RefreshData()
    self.isShowReplacement = false
    local count = #self.CurSelectCardList
    --self.maxSelectCardCount = self.curSelectTagData.NeedCardCount
    self.CurSelectCardDict = {}
    self.isCallReplacement = false
    for i = 1, count do
        local data = self.CurSelectCardList[i]
        self.CurSelectCardDict[data.uid] = data
    end
    local maxSelectCardCountl = self.curSelectTagData:GetNeedCardCount(self.CurSelectCardList)
    if self.maxSelectCardCount ~= maxSelectCardCountl then
        local left = maxSelectCardCountl - self.maxSelectCardCount
        if left > 0 then
            local count2 = #self.cardItemList
            for i = count2, left, -1 do
                self.cardItemList[i] = nil
            end
        end
        self.maxSelectCardCount = maxSelectCardCountl
    end
    if count >= self.maxSelectCardCount then
        self.isShowReplacement = true
    end
end

function CardReplacementView:InitUI()
    self.go_table["_onclick"] = handlerbind(self, self.OnClickBtn)

    local resources = _G.ConfigManager.ui_cfg.CardReplacementView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    ---@type CardReplacementView._obj_InfoNodeN_GoTable
    self.DesN = GetAutoGoTable(self.go_table.obj_InfoNodeN)
    ---@type CardReplacementView._obj_InfoNodeS_GoTable
    self.DesS = GetAutoGoTable(self.go_table.obj_InfoNodeS)

    self.RTS = _G.TimeUtil.GetSixClockTimer()
    self:UpdateTimeShow(true)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeShow, self, false, false, true, false)
    self.timer:Start()
end

function CardReplacementView:RefreshTimer()
    require("CardInfoNet"):GetInstance():GetExchangeInfo(nil, function(data)
        self.RemainingCount = data.times
        self.RTS = _G.TimeUtil.GetSixClockTimer()
        self:UpdateTimeShow(true)
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeShow, self, false, false, true, false)
        self.timer:Start()
        self:RefreshDesc()
    end)
end

function CardReplacementView:UpdateTimeShow(show, elapsed)
    if not show then
        self.RTS = self.RTS - elapsed
    end
    local color = "96ce51"
    local showTxt = ""
    if self.isSelectCard then
        color = "00721d"
        showTxt = GetLangPackValue(self.curSelectTagData.ExchangeDesc)
    else
        local tiemFormat = _G.TimeUtil.TimeToString(self.RTS, 1)
        showTxt = GetLangPackValue(91901090003, ColorTools.GetRichtext(color, tiemFormat))
    end
    self.DesN.aortext_time.text = showTxt
    self.DesS.aortext_time.text = showTxt
    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
            self:RefreshTimer()
        end
        --self:Close()
    end
end

function CardReplacementView:RefreshUI()
    if self.isSelectCard == false then
        self.go_table.obj_noSelectNode:SetActiveE(1)
        self.go_table.obj_selectNode:SetActiveE(0)
    else
        self.go_table.obj_noSelectNode:SetActiveE(0)
        self.go_table.obj_selectNode:SetActiveE(1)

        GameUtil.SetChildCount(self.go_table.obj_roleHeadList, self.maxSelectCardCount, function(obj, index)
            ---@type roleHeadItem_GoTable
            local item = GetAutoGoTable(obj)
            item["_onclick"] = handlerbind(self, self.OnClickSelectCard, item)
            local cardData = self.CurSelectCardList[index]
            if cardData then
                item.obj_NoSelect:SetActiveE(0)
                item.aortext_Num.text = string.format("(%s/%s)", 1, 1)
                if not self.cardItemList[index] then
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.HeadItem_Select,
                        item.obj_headNode,
                        handlerbind(self, self.CardItemLoadFinish, item, cardData, index)
                    )
                else
                    self.cardItemList[index]:ShowCardData(cardData)
                    self.cardItemList[index]:isHave(true)
                end
            else
                item.obj_headNode:RemoveAllChildren()
                self.cardItemList[index] = nil
                item.obj_NoSelect:SetActiveE(1)
                item.aortext_Num.text = string.format("(%s/%s)", ColorTools.GetRichtext("C84937", 0), 1)
            end
        end)

        self.go_table.aorbtn_enter:SetActiveE(self.isShowReplacement and 1 or 0)
        self.DesS.aortext_time:SetActiveE(self.isShowReplacement and 0 or 1)

        self:RefreshRoleInfo()
    end
    self:RefreshDesc()
end

function CardReplacementView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_kapaizhihuan,
        self.go_table.obj_eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

---@param data CardData 角色卡牌数据
---@param Index number 角色卡牌索引
---@param item ItemCardHeadSelectView 角色头像Item
function CardReplacementView:CardItemLoadFinish(item, goTable, data, Index)
    if self:IsNil() then
        DestroyObject(item.gameObject)
        return
    end

    self.cardItemList[Index] = item
    item:ShowCardData(data)
    item:isHave(true)
    item.transform:SetLocalPositionToZero()
end

function CardReplacementView:RefreshDesc()
    local showtxt = ""
    if self.RemainingCount == 0 then
        showtxt = GetLangPackValue(91901090002, ColorTools.GetRichtext("C02214", self.RemainingCount))
    else
        local color = "96ce51"
        if self.isSelectCard then
            color = "00721d"
        end
        showtxt = GetLangPackValue(91901090002, ColorTools.GetRichtext(color, self.RemainingCount))
    end
    self.DesN.aortext_count.text = showtxt
    self.DesS.aortext_count.text = showtxt
end

---@param item roleHeadItem_GoTable 角色头像Item
function CardReplacementView:OnClickSelectCard(go, ison, item)
    if item.aorbtn_onlick == go then
        ---@type CardSelctPopView.OpenData
        local OpenData = {
            callback = function(list)
                self.CurSelectCardList = list
                self:RefreshData()
                self:RefreshUI()
            end,
            CurSelectCardDict = self.CurSelectCardDict or {},
            curSelectTagData = self.curSelectTagData,
            curSelectCardData = self.CurSelectCard
        }
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardSelctPopView.Name, OpenData)
    end
end

---卡牌名称和招募次数变化
function CardReplacementView:RefreshRoleInfo()
    self.go_table.trans_card:ClearChildren()
    if self.CurSelectCard ~= nil and self.CurSelectCard.cfg ~= nil then
        self.cfg = self.CurSelectCard.cfg
        self.go_table.obj_roleInfo:SetActiveE(1)
        self.isHave = require("IllustrationModel"):GetInstance():HunjiangJieSuo(self.cfg.id)
        self.go_table.aortext_cardName.text = GetLangPackValue(self.cfg.Name)
        local grade = self.cfg.Order
        self.go_table.aorimage_cardOrder.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(grade)
        if _G.CardOrderBigIconName[grade] then
            self.go_table.aorimage_cardLogo:SetActiveE(1)
            self.go_table.aorimage_cardLogo.SpriteName = _G.CardOrderBigIconName[grade]
        else
            self.go_table.aorimage_cardLogo:SetActiveE(0)
        end

        self.go_table.trans_card:SetLocalScaleXYZ(self.cfg.size2)
        local pos = self.cfg.pos_portrait
        self.go_table.trans_card:SetLocalPosition(pos[1], pos[2], pos[3])
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.trans_card,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    else
        self.go_table.obj_roleInfo:SetActiveE(0)
        self.go_table.aortext_cardName.text = ""
        self.go_table.aorimage_cardLogo:SetActiveE(0)
    end
end

---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function CardReplacementView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Select or go == self.go_table.aorbtn_changeRole then
        ---@type CardSelctView.OpenData
        local OpenData = {
            callback = function(data, curSelectTagData)
                self.CurSelectCard = data
                self.isSelectCard = true
                self.curSelectTagData = curSelectTagData
                self.CurSelectCardList = {}
                self:RefreshData()
                self:RefreshUI()
            end,
            CurSelectCard = self.CurSelectCard,
            TagDatas = self.CardReplacementDatas
        }
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardSelctView.Name, OpenData)
    elseif go == self.go_table.aorbtn_enter then
        if self.SeedComp then
            return
        end
        if self.RemainingCount <= 0 then
            PopWindowManager:GetInstance():ShowAllTips(460124)
            return
        end
        local msg = {
            sid = self.CurSelectCard.sid,
            uids = {}
        }
        for i = 1, #self.CurSelectCardList do
            table.insert(msg.uids, self.CurSelectCardList[i].uid)
        end

        ---@type CardData[]
        local curSelectCardList = {}
        local count = #self.CurSelectCardList
        for i = 1, count do
            table.insert(curSelectCardList, self.CurSelectCardList[i])
        end
        self.SeedIng = true
        PopWindowManager:GetInstance():ShowAllTips(460104, nil, function()
            local consume_cards = {}
            local count = #curSelectCardList
            for i = 1, count do
                table.insert(consume_cards, curSelectCardList[i].uid)
            end

            require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                consume_cards,
                function(Refun)
                    require("CardInfoNet"):GetInstance():CardExchange(msg, function(data)
                        if data.award == nil then
                            return
                        end
                        local count = #curSelectCardList
                        for i = 1, count do
                            _G.StorageManager:GetInstance():ConsumeItem(curSelectCardList[i].sid,
                                curSelectCardList[i].uid, 1)
                        end
                        _G.StorageManager:GetInstance():ReceiveAwardData(data)
                        self.CurSelectCardList = {}
                        self:RefreshData()
                        self:RefreshUI()
                        self:RefreshTimer()
                        self.SeedComp = false

                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                            data,
                            nil,
                            true,
                            nil,
                            nil,
                            nil,
                            nil,
                            true
                        )
                    end)
                end,
                function()
                    _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90024100053))
                    return
                end
            )
        end
        )
    elseif self.go_table.aorbtn_Explanation == go then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 171)
    end
end

---@return CardReplacementView
return CardReplacementView
