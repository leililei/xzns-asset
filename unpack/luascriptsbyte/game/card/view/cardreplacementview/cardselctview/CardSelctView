local CardUtils = require("CardUtils")
local CardReHeadItem = require("CardReHeadItem")

---@class CardSelctView : UIBaseView 窗口
---@field private go_table CardSelctView_GoTable GoTable
local CardSelctView = BaseClass("CardSelctView",UIBaseView)


---Create显示
---@protected
function CardSelctView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

---@class CardSelctView.OpenData
---@field public callback fun(T:CardData,T1:CardReplacementData) 回调函数
---@field public CurSelectCard CardData 当前选中card
---@field public TagDatas CardReplacementData[] 当前选中card

---@param msg CardSelctView.OpenData
function CardSelctView:InitData(msg)
    self.callback = msg.callback
    ---@type CardData 当前选中card
    self.CurSelectCard = msg.CurSelectCard
    self.TagDatas = msg.TagDatas

    self.CurSelectTagData = self.TagDatas[1]

    ---@type CardSelctView._obj_tagItem_GoTable[]
    self.TagItemList = {}

    self.CurSelectOccupation = CardProfType.None
    self.CurSelectQuality = self.CurSelectTagData.order

    ---@type CardData[] 当前选中的英雄列表
    self.curcardList = {}
    ---@type CardReHeadItem[]
    self.cardItemList = {}
    ---@type CardSelctView._obj_type_GoTable[]
    self.OccupationBtnList = {}

    ---@type CardData[]
    local cardDatas = _G.StorageManager:GetInstance():GetCardDataSortList()
    self.cardDict = {}
    local count = #cardDatas
    for i = 1, count do
        self.cardDict[cardDatas[i].sid] = true
    end

end

function CardSelctView:RefreshData()
    ---@type CardData[]
    local StorageCard = self.CurSelectTagData:GetCardList()
    self.curcardList = CardUtils.GetFilteredList_Card(StorageCard,self.CurSelectOccupation,self.CurSelectQuality)
    if self.curcardList and #self.curcardList > 0 then
        self.CurSelectCard = self.curcardList[1]
    end
end

function CardSelctView:GetQuality(index)
    return index + 3
end

function CardSelctView:GetTagId(Quality)
    return Quality - 3
end

function CardSelctView:InitUI()
    self.go_table["_onclick"] = handlerbind(self,self.OnClickBtn)

    GameUtil.SetChildCount(self.go_table.obj_tagBtn,#self.TagDatas,function(obj,index)
        local data = self.TagDatas[index]
        ---@type CardSelctView._obj_tagItem_GoTable
        local ItemGotable = GetAutoGoTable(obj,handlerbind(self,self.SetSelectQuality,data))
        ItemGotable.aortext_nameN.text = GetLangPackValue(data.tagNameKey)
        ItemGotable.aortext_nameS.text = GetLangPackValue(data.tagNameKey)
        self.TagItemList[index] = ItemGotable
    end)

    if _G.AppSetting.IsXzns then
        GameUtil.SetChildCount(self.go_table.obj_OccupationList,7,function(obj,index)
            if index > 1 then
                self.OccupationBtnList[index - 1] = GetAutoGoTable(obj,handlerbind(self,self.SetCurSelectOccupation,index - 1))
            end
        end)
    else
        GameUtil.SetChildCount(self.go_table.obj_OccupationList,6,function(obj,index)
            self.OccupationBtnList[index] = GetAutoGoTable(obj,handlerbind(self,self.SetCurSelectOccupation,index))
        end)
    end

    self:RefreshOccupationBtnList()
    self:RefreshTagBtn()

    self.go_table.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.OnCardItemCall))
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.CardSelctView,self.go_table)
end

---@param cardProfType CardProfType
function CardSelctView:SetCurSelectOccupation(go,ison,cardProfType)
    if _G.AppSetting.IsXzns then
        if ison ~= true then
            return
        end
        self.CurSelectTagData = self.TagDatas[cardProfType == 6 and 2 or 1]
        self.CurSelectQuality = self.CurSelectTagData.order
        self.CurSelectOccupation = (cardProfType - 1)
        self:RefreshOccupationBtnList()
        if cardProfType == 6 then
            self.CurSelectOccupation = 0
        end
        self:RefreshData()
        self:RefreshUI()
    else
        self.CurSelectOccupation = (cardProfType - 1)
        self:RefreshOccupationBtnList()
        self:RefreshData()
        self:RefreshUI()
    end
end

---@param cardProfType CardProfType
function CardSelctView:IsNotHasTypeRole(cardProfType)
    local StorageCard = self.CurSelectTagData:GetCardList()
    local datas = CardUtils.GetFilteredList_Card(StorageCard,cardProfType - 1,self.CurSelectQuality)
    if datas == nil or #datas == 0 then
        return true
    end
    return false
end

function CardSelctView:SetSelectQuality(go,ison,data)
    self.CurSelectQuality = data.order
    self.CurSelectTagData = data
    self:RefreshTagBtn()
    self:RefreshData()
    self:RefreshUI()
end

function CardSelctView:RefreshUI()
    if self.curcardList == nil or #self.curcardList == 0 then
        --self.go_table.aortext_notRole:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemList:UpdateCount(0)
    else
        --self.go_table.aortext_notRole:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.curcardList)
    end

    if self.CurSelectCard then
        self:UpdateCardShow()
    end
end

function CardSelctView:RefreshTagBtn()
    local count = #self.TagItemList
    for i = 1, count do
        self.TagItemList[i].obj_choose:SetActiveE(self.CurSelectQuality == self.TagDatas[i].order and 1 or 0)
        self.TagItemList[i].transform:SetActiveE(self.TagDatas[i]:IsShowTag() and 1 or 0)
    end
end

function CardSelctView:RefreshOccupationBtnList()
    local count = #self.OccupationBtnList
    for i = 1, count do
        self.OccupationBtnList[i].aorimage_typeOn:SetActiveE(i == (self.CurSelectOccupation + 1) and 1 or 0)
    end
end

function CardSelctView:OnCardItemCall(index, obj)
    local id = obj:GetInstanceID()
    local item = self.cardItemList[id]
    if not item then
        item = CardReHeadItem.New(obj, self)
        self.cardItemList[id] = item
    end
    index = index + 1

    local cardData = self.curcardList[index]
    --local i, tag, sameIndex = self:GetCardIndexAndTag(index, true)
    cardData.skinIs = false
    local isTick = false
    if cardData then
        isTick = self.CurSelectCard.sid == cardData.sid
    end
    local isunlock = true
    if self.CurSelectTagData.isNeedUnlock then
        isunlock = self.cardDict[cardData.sid] and true or false
    end
    item:SetActivateState(isunlock)
    item:RefreshItem(cardData, isTick, isTick,function(data)
        if self.CurSelectCard and self.CurSelectCard.sid == data.sid then
            return
        end
        self.CurSelectCard = data
        self:RefreshUI()
    end)
end

---更新卡牌显示
function CardSelctView:UpdateCardShow()
    local data = self.CurSelectCard
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[data.sid]
    local path = ""
    if cfg then
        path = cfg.Photo
    end
    if _G.AppSetting.IsXzns then
        if self.cardItem then
            self.cardItem:Show(data)
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.baseBodyItem,
                    self.go_table.obj_Root,
                    function(trans)
                        if not self.go_table or self.cardItem then
                            _G.DestroyImmediate(trans)
                            return
                        end
                        self.cardItem = trans
                        trans:Show(data)
                        trans.go_table.obj_lvNode:SetActiveE(0)
                    end
            )
        end
    else
        --加载spine
        self.go_table.obj_Root:ClearChildren()
        self.go_table.obj_Root:SetLocalScaleXYZ(data.cfg.size2)
        local pos = data.cfg.pos_portrait
        self.go_table.obj_Root:SetLocalPosition(pos[1], pos[2], pos[3])
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(data.skin, data.sid)
        _G.PoolsManager:GetInstance():Spawn(
                cfg.ModelPathHi,
                _G.ePoolType.Temporary,
                self.go_table.obj_Root,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                end
        )

        self.go_table.aortext_name.text = data:GetName()

        --设定星级
        local CardInfoManager = require("CardInfoManager"):GetInstance()
        local SpriteName
        local haveStar
        for i = 1, 5 do
            SpriteName = CardInfoManager:GetHuoSpriteName(data.star, i)
            self.go_table["aorimage_star" .. i].SpriteName = SpriteName
            self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
            if SpriteName then
                haveStar = true
            end
        end
        self.go_table.aortext_name:SetLocalPosition(0, haveStar and 18 or -3)
        --设定元素和职业图标
        require("CardInfoManager"):GetInstance():SetElementsProfessionalSP(
                self.go_table.aorimage_element,
                data.cfg.Elements_new,
                self.go_table.aorimage_profession,
                data.cfg.Professional
        )
    end

end


---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function CardSelctView:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_close2  == go or self.go_table.aorbtn_Cancel == go then
        self:Close()
    elseif self.go_table.aorbtn_enter == go then
        if self.callback then
            self.callback(self.CurSelectCard,self.CurSelectTagData)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_showInfo then
        if self.CurSelectCard then
            require("CommonTipManager"):GetInstance():OpenTip(self.go_table.gameObject, self.CurSelectCard.sid)
        end
    end
end

---@return CardSelctView
return CardSelctView