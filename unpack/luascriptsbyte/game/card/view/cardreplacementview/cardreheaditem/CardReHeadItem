---@class CardReHeadItem
---@field private go_table CardSelctView._obj_ListItem_GoTable GoTable
local CardReHeadItem = _G.BaseClass("CardReHeadItem")

---__init构造函数
---@protect
function CardReHeadItem:__init(cardRoot,view)
    self.root = cardRoot
    ---@type CardSelctView
    self.view = view
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))
    self.isLoadIng = false
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function CardReHeadItem:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_onlick == go then
        if self.IsActivate ~= nil and self.IsActivate == false then
            return
        end
        if self.callback then
            self.callback(self.data,self)
        end
    end
end

---@param callback fun(T:CardData,T2:CardReHeadItem)
function CardReHeadItem:RefreshItem(data,isSelected,isTick,callback)
    self.data = data
    self.isSelected = isSelected
    self.callback = callback
    self.isTick = isTick

    self.go_table.obj_selectedNode:SetActiveE(self.isTick and 1 or 0)
    if not self.cardItem then
        self.isLoadIng = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.HeadItem_Select,
                self.go_table.obj_headNode,
                function(view)
                    if self.go_table == nil then
                        if view == nil then
                            return
                        end
                        DestroyObject(view.transform)
                        return
                    end
                    ---@type ItemCardHeadSelectView
                    self.cardItem = view
                    view.transform:SetLocalPositionToZero()
                    view.transform:SetLocalScaleXYZ(0.75)
                    self:RefreshCardItem(view)
                    self.isLoadIng = false
                end
        )
    else
        self:RefreshCardItem(self.cardItem)
    end
end

---@param item ItemCardHeadSelectView
function CardReHeadItem:RefreshCardItem(item)
    item:ShowCardData(self.data)

    if self.IsActivate ~= nil then
        if self.IsActivate then
            item:SetSelectGou(self.isSelected)
            --item:isHave(not self.isTick)
            --item:ShowMask(self.isSelected)
        else
            item:SetSelectGou(false)
            item:ShowMask(true)
            --item:isHave(false)
        end
    else
        --item:isHave(not self.isTick)
        item:SetSelectGou(self.isSelected)
    end
    item:isHave(true)
end

function CardReHeadItem:SetActivateState(IsActivate)
    self.IsActivate = IsActivate
    self.go_table.obj_noActivateNode:SetActiveE(IsActivate and 0 or 1)
end

function CardReHeadItem:Dispose()
    CardReHeadItem.super.Dispose(self)
end

---@return CardReHeadItem
return CardReHeadItem