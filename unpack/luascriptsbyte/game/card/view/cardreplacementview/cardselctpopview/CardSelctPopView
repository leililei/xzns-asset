local CardReHeadItem = require("CardReHeadItem")
local CardUtils = require("CardUtils")

---@class CardSelctPopView : UIBaseView 窗口
---@field private go_table CardSelctPopView_GoTable GoTable
local CardSelctPopView = BaseClass("CardSelctPopView",UIBaseView)

function CardSelctPopView:__init()

end

---Create显示
---@protected
function CardSelctPopView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

---@class CardSelctPopView.OpenData
---@field public callback fun(T:CardData[],T1:curSelectTagData) 回调函数
---@field public CurSelectCardDict table<number,CardData> 当前选中的卡片字典
---@field public curSelectTagData CardReplacementData 最大选中数量
---@field public curSelectCardData CardData

---@param msg CardSelctPopView.OpenData
function CardSelctPopView:InitData(msg)
    self.callback = msg.callback
    ---@type table<number,CardData> （打勾）英雄列表
    --self.CurSelectCardDict = msg.CurSelectCardDict or {}
    ---@type CardReplacementData
    self.curSelectTagData = msg.curSelectTagData
    self.maxCount = msg.curSelectTagData.NeedCardCount
    self.curSelectCardData = msg.curSelectCardData

    self.CurCount = 0
    ---@type table<number,CardData> 当前待确认的英雄列表
    self.CurTickCardDict = msg.CurSelectCardDict or {}
    self.CurTickCardList = {}

    ---@type CardData[] 当前显示的英雄列表
    self.curcardList = {}
    ---@type CardReHeadItem[]
    self.cardItemList = {}

    self.CurSelectOccupation = CardProfType.None
    ---@type CardSelctView._obj_type_GoTable[]
    self.OccupationBtnList = {}
end

function CardSelctPopView:RefreshData()
    ---@type CardData[]
    --local StorageCard = _G.StorageManager:GetInstance():GetCardDataSortList()
    ---@type CardData[]
    local StorageCard = CardUtils.GetUserRedundantCharacters()
    --self.curcardList = CardUtils.GetFilteredList_Card(StorageCard,self.CurSelectOccupation,self.curSelectTagData.order)
    self.curcardList = CardUtils.GetFilteredFilterList_Card(StorageCard,self.CurSelectOccupation,self.curSelectTagData.FilterList,self.curSelectCardData)

    ---@param v CardData
    table.chooseToArray(self.curcardList,function(k,v)
        if v.star > 1 then
            return false
        end
        return true
    end)

end

function CardSelctPopView:InitUI()
    self.go_table["_onclick"] = handlerbind(self,self.OnClickBtn)

    self.go_table.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.OnCardItemCall))

    GameUtil.SetChildCount(self.go_table.obj_OccupationList,6,function(obj,index)
        self.OccupationBtnList[index] = GetAutoGoTable(obj,handlerbind(self,self.SetCurSelectOccupation,index))
    end)
    self:RefreshOccupationBtnList()
end

---@param cardProfType CardProfType
function CardSelctPopView:SetCurSelectOccupation(go,ison,cardProfType)
    self.CurSelectOccupation = (cardProfType - 1)
    self:RefreshOccupationBtnList()
    self:RefreshData()
    self:RefreshUI()
end

---@param cardProfType CardProfType
function CardSelctPopView:IsNotHasTypeRole(cardProfType)
    local StorageCard = _G.StorageManager:GetInstance():GetCardDataSortList()
    local datas = CardUtils.GetFilteredFilterList_Card(StorageCard,cardProfType - 1,self.curSelectTagData.FilterList,self.curSelectCardData)
    if datas == nil or #datas == 0 then
        return true
    end
    return false
end

function CardSelctPopView:RefreshUI()
    if self.curcardList == nil or #self.curcardList == 0 then
        self.go_table.aortext_notRole:SetActiveE(1)
        self.go_table.scrollloopvectical_ItemList:UpdateCount(0)
    else
        self.go_table.aortext_notRole:SetActiveE(0)
        self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.curcardList)
    end
end

function CardSelctPopView:RefreshOccupationBtnList()
    local count = #self.OccupationBtnList
    for i = 1, count do
        self.OccupationBtnList[i].aorimage_typeOn:SetActiveE(i == (self.CurSelectOccupation + 1) and 1 or 0)
    end
end

function CardSelctPopView:OnCardItemCall(index, obj)
    local id = obj:GetInstanceID()
    local item = self.cardItemList[id]
    if not item then
        item = CardReHeadItem.New(obj, self)
        self.cardItemList[id] = item
    end
    index = index + 1

    local cardData = self.curcardList[index]
    --local i, tag, sameIndex = self:GetCardIndexAndTag(index, true)
    cardData.skinIs = true
    --local isSelected = false
    --if self.CurSelectCardDict[cardData.uid] then
    --    isSelected = true
    --end
    local isTick = false
    if self.CurTickCardDict[cardData.uid] then
        isTick = true
    end
    item:RefreshItem(cardData, isTick, isTick,function(data,item)
        if self.CurTickCardDict[data.uid] then
            self.CurTickCardDict[data.uid] = nil
            self:AddCount(data,false)
            item:RefreshItem(data,false,false,item.callback)
        else
            local list = self:GetCurTickCardList()
            local IsCallAddCard,tipsID = self.curSelectTagData:IsCallAddCard(list,data)
            if IsCallAddCard == false then
                --require "CommonTipManager":GetInstance():OpenTip(self.go_table.transform, tipsID)
                PopWindowManager:GetInstance():ShowAllTips(tipsID)
                return
            end
            self.CurTickCardDict[data.uid] = data
            self:AddCount(data,true)
            item:RefreshItem(data,true,true,item.callback)
        end
        --self:RefreshUI()
    end)
end

function CardSelctPopView:GetCurTickCardList()
    local list = {}
    for i, v in pairs(self.CurTickCardDict) do
        table.insert(list,v)
    end
    return list
end

---@param data CardData
function CardSelctPopView:AddCount(data,IsAdd)
    if data.star >= 6 then
        if IsAdd then
            self.CurCount = self.CurCount + 2
        else
            self.CurCount = self.CurCount - 2
        end
    else
        if IsAdd then
            self.CurCount = self.CurCount + 1
        else
            self.CurCount = self.CurCount - 1
        end
    end
end


---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function CardSelctPopView:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_CloseView  == go or self.go_table.aorbtn_Cancel == go then
        self:Close()
    elseif self.go_table.aorbtn_enter == go then
        local list = {}
        for i, v in pairs(self.CurTickCardDict) do
            if v then
                table.insert(list,v)
            end
        end

        if self.callback then
            self.callback(list)
        end
        self:Close()
    end
end

---@return CardSelctPopView
return CardSelctPopView