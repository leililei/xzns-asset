---@class CardOtherPropTipsView : UIBaseView	中文描述
---@field public go_table CardPropTipsView_GoTable GoTable
local CardOtherPropTipsView = _G.BaseClass("CardOtherPropTipsView", _G.UIBaseView)
--_G.CardOtherPropTipsView = CardOtherPropTipsView

local CS = _G.CS
local typeof = _G.typeof

function CardOtherPropTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---@class params_CardPropTipsView Data

---界面的入口函数
------@param data fight.i_fight_fighter
function CardOtherPropTipsView:OnCreate(data)
    ---@type ItemCardAllView
    self.lua_ItemCardAllView = require("ItemCardAllView").New(self.go_table.obj_CardItem)
    self.data = data
    self.cfg = _G.ConfigManager.card_cfg[data.sid]
    self.lua_ItemCardAllView:Show(data.sid, nil, data.star, data.soul_chain_lv, data.lv)
    local data2 = _G.CardData.New()
    data2:Parse(
        {
            sid = data.sid,
            lv = data.lv,
            soulLink_lv = data.soulLink_lv,
            soulLink_lv = data.soul_chain_lv,
            star = data.star
        }
    )
    self.go_table.aorimage_type.SpriteName = require("CardInfoManager").Enum.EquipmentType[self.cfg.EquipmentType]
    self.go_table.aortext_Power.text =
        _G.LangUtil.GetLangPackValue(90020200032) ..
        _G.UIUtils.NumberToUnitStr_CardFightNum(tostring(self.data.attrs.power), true)

    self.go_table.aortext_rolename.text = _G.LangUtil.GetLangPackValue(self.cfg.Name)
    self:ShowProp()
end

---设置属性
---@param data AttributeClass
function CardOtherPropTipsView:ShowProp()
    --- 忽略  (不显示)
    local ignore = {
        ---雷伤增加
        [_G.AttrType.thd_dmg.key] = true,
        ---雷伤减免
        [_G.AttrType.thd_d_r.key] = true,
        ---风伤增加
        [_G.AttrType.air_dmg.key] = true,
        ---风伤减免
        [_G.AttrType.air_d_r.key] = true,
        ---水伤增加
        [_G.AttrType.water_dmg.key] = true,
        ---水伤减免
        [_G.AttrType.water_d_r.key] = true,
        ---火伤增加
        [_G.AttrType.fire_dmg.key] = true,
        ---火伤减免
        [_G.AttrType.fire_d_r.key] = true,
        ---土伤增加
        [_G.AttrType.earth_dmg.key] = true,
        ---土伤减免
        [_G.AttrType.earth_d_r.key] = true
    }
    local prop = self.data.attrs
    local showlist = {}

    for i, v in pairs(prop) do
        if _G.AttrType[i] then
            table.insert(
                showlist,
                {
                    key = i,
                    sortid = _G.AttrType[i].sortid,
                    proptype = _G.AttrType[i].proptype,
                    icon = _G.AttrType[i].icon,
                    des = _G.AttrType[i].des,
                    percentage = _G.AttrType[i].percentage
                }
            )
        end

        -- end
    end
    SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )

    for _, v in pairs(showlist) do
        local key = v.key
        if ignore[key] == nil then
            local parent
            if v.proptype == 1 then
                parent = self.go_table.obj_PropContent
            else
                parent = self.go_table.obj_Prop2Content
            end
            if parent ~= nil then
                local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, parent)
                if tran then
                    local tb = _G.GetAutoGoTable(tran)
                    tb.aorrawimage_icon:LoadImage(v.icon)
                    tb.aortext_Name.text = v.des
                    local num = self.data.attrs[key]
                    if v.percentage == 1 then
                        num = num / 100
                        num = Mathf.RoundToInt(num)
                        num = tostring(num) .. "%"
                        tb.aortext_Num.text = num
                    else
                        tb.aortext_Num.text = tostring(num)
                    end
                end
            end
        end
    end
end

function CardOtherPropTipsView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function CardOtherPropTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return CardOtherPropTipsView
