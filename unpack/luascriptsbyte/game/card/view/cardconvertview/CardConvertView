---@class CardConvertView : UIBaseView    卡牌转化
---@field go_table CardConvertView_GoTable
---@field model CardConvertModel
---@field cardList CardData[]           @待转化卡牌列表
---@field awardList any[]               @转化后的奖励列表
---@field awardItems table<number,BaseAwardNewItem>
local CardConvertView = _G.BaseClass("CardConvertView", _G.UIBaseView)

function CardConvertView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.awardItems = {}
    self.go_table.obj_convert:SetActiveE(1)
    self.go_table.scrollloophorizontal_card:InitItemData(0, _G.handler(self, self.RefreshCardItem))
    self.go_table.scrollloophorizontal_award:InitItemData(0, _G.handler(self, self.RefreshAwardItem))
end

function CardConvertView:OnCreate()
    self.model = require("CardConvertModel"):GetInstance()
    self:InitView()
    self:UpdateView()
end

---初始化页面
function CardConvertView:InitView()
    --初始化奖励预览
    local previewList = self.model:GetAwardPreview()
    if previewList then
        ---@param item BaseAwardNewItem
        local function loaded(item)

        end
        for _, d in ipairs(previewList) do
            local ins = _G.InstantiateObject(self.go_table.obj_awardPreviewItem, self.go_table.obj_awardPreview)
            ins:SetLocalScaleXYZ(0.7)
            ins:SetActiveE(1)
            ---@type BaseAwardNewItem
            local item = require("BaseAwardNewItem").New(ins)
            item:ShowWithID(d)
        end
    end
    --初始化转化文本
    self.go_table.aortext_convertNumber.text = _G.GetLangPackValue(90034300005, self.model:GetConvertNumber())

    --加载特效
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.xxxx, self.go_table.obj_doorEffect)
end

---刷新页面显示
function CardConvertView:UpdateView()
    self.cardList = self.model:GetConvertCardList()
    self.awardList = self.cardList and self.model:GetConvertAwardList(self.cardList) or nil

    local hasCardList = self.cardList and #self.cardList > 0
    self.go_table.obj_convert:SetActiveE(hasCardList and 1 or 0)
    self.go_table.obj_nothing:SetActiveE(hasCardList and 0 or 1)
    self.go_table.aorrawimage_door:SetGray(not hasCardList)
    self.go_table.obj_doorEffect:SetActiveE(not hasCardList and 0 or 1)
    if hasCardList then
        self.go_table.scrollloophorizontal_card:UpdateCount(#self.cardList)
        self.go_table.scrollloophorizontal_award:UpdateCount(#self.awardList)
    end
end

function CardConvertView:RefreshCardItem(index, go)
    ---@type BaseAwardNewItem
    local item = self.awardItems[go:GetInstanceIDE()]
    if not item then
        item = require("BaseAwardNewItem").New(go)
        self.awardItems[go:GetInstanceIDE()] = item
    end

    item:Show(self.cardList[index + 1])
end

function CardConvertView:RefreshAwardItem(index, go)
    ---@type BaseAwardNewItem
    local item = self.awardItems[go:GetInstanceIDE()]
    if not item then
        item = require("BaseAwardNewItem").New(go)
        self.awardItems[go:GetInstanceIDE()] = item
    end

    item:ShowWithID(self.awardList[index + 1])
end

---按钮点击事件在这里派发
function CardConvertView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_confirm then
        if not self.cardList or #self.cardList <= 0 then
            return
        end
        self.model:Convert(self.cardList, function(msg)
            if not msg or msg.ack ~= 1 then
                _G.PopWindowManager:GetInstance():ShowAllTips(msg and msg.ack or 10)
                return
            end
            self:UpdateView()
            _G.UIUtils.ShowCommonAward(msg)
        end)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name,
            174
        )
    end
end

return CardConvertView
