local ReadOnlyTable = function(t)
    local proxy = {}
    local mt = {
        __index = t,
        __newindex = function(t, k, v)
            error("attempt to update a read-only talbe 只读", 2)
        end
    }
    setmetatable(proxy, mt)
    return proxy
end
