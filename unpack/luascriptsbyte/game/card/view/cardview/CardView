---@class CardView : UIBaseView
local CardView = _G.BaseClass("CardView", _G.UIBaseView)

-- 启动
function CardView:OnCreate(lastSceneSid)
    ---@type card_cfg
    local CardImageConfig = _G.ConfigManager.card_cfg
    self.lastSceneSid = 300
    if lastSceneSid ~= nil then
        self.lastSceneSid = lastSceneSid
    end
    local obb = _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn)) --注册按钮事件
    _G.GetAutoGoTable(self.go_table.obj_showtype, _G.handler(self, self.OnClickBtnToggle))
    _G.GetAutoGoTable(self.go_table.obj_actiontype_show, _G.handler(self, self.OnClickBtnToggle))
    _G.GetAutoGoTable(self.go_table.obj_actiontype_fight, _G.handler(self, self.OnClickBtnToggle))

    ---玩家id配置
    self.PlayerCfg = {}

    for k, v in pairs(CardImageConfig) do
        table.insert(self.PlayerCfg, k)
    end
    table.sort(self.PlayerCfg)

    self.PlayerNameCfg = {}

    for i = 1, #self.PlayerCfg do
        self.PlayerNameCfg[self.PlayerCfg[i]] = CardImageConfig[self.PlayerCfg[i]]
    end

    ---当前对象的常驻特效  关闭场景后销毁
    self.PlayerIdleEffect = {}

    ---角色icon对象列表
    self.PlayerList = {}
    self.go_table.aorlooplist_PlayerList:StartUpdataDragInfo(#self.PlayerCfg, _G.handler(self, self.InitPlayerList))
    self.PlayerList[1].toggle_TagSelect.isOn = true

    SetEventTrigger(self.go_table.aorimage_rotateL, "onDown", _G.handler(self, self.OnclickRotateRole_L))
    SetEventTrigger(self.go_table.aorimage_rotateR, "onDown", _G.handler(self, self.OnclickRotateRole_R))
    SetEventTrigger(self.go_table.aorimage_rotateL, "onUp", _G.handler(self, self.OnclickRotateRole_exitL))
    SetEventTrigger(self.go_table.aorimage_rotateR, "onUp", _G.handler(self, self.OnclickRotateRole_exitR))
    self.nowActionType = {}
    self.curAnimName = ""
end

-- 角色左右旋转  左
function CardView:OnclickRotateRole_L(aaa, bbb)
    self.go_table.aorimage_rotateL.SpriteName = "ui_juese_btn_001_1_b"
    self:Ontemp_rotate(true)
end
-- 角色左右旋转  右
function CardView:OnclickRotateRole_R(aaa, bbb)
    self.go_table.aorimage_rotateR.SpriteName = "ui_juese_btn_001_1_b"
    self:Ontemp_rotate()
end
-- 角色左右旋转  弹起
function CardView:OnclickRotateRole_exitL(aaa, bbb)
    self.go_table.aorimage_rotateL.SpriteName = "ui_juese_btn_001_1_a"
    self.isRoate = false
end

-- 角色左右旋转  弹起
function CardView:OnclickRotateRole_exitR(aaa, bbb)
    self.go_table.aorimage_rotateR.SpriteName = "ui_juese_btn_001_1_a"
    self.isRoate = false
end

function CardView:AddAction(actionType, actionStr)
    for i = #actionType, 1, -1 do
        local isHaveAni = self.AnimComponent:isHaveAni(actionType[i])
        if isHaveAni == false then
            table.remove(actionType, i)
        end
    end
    if #actionType > 0 then
        for i = #actionType, 1, -1 do
            table.insert(actionType, i + 1, actionStr)
        end
    else
        table.insert(actionType, actionStr)
    end
end

function CardView:AddActionS(actionType)
    self:AddAction(actionType.debut, actionType.idle[1])
    self:AddAction(actionType.special, actionType.idle[1])

    self:AddAction(actionType.stunt, actionType.stand[1])
    self:AddAction(actionType.attack, actionType.stand[1])
    self:AddAction(actionType.skill, actionType.stand[1])
    self:AddAction(actionType.summon, actionType.stand[1])
end

-- 初始化 角色选择列表
function CardView:InitPlayerList(trans, index)
    local tblIndex = index + 1
    local cfg = self.PlayerCfg[tblIndex]

    if cfg then
        if not self.PlayerList[tblIndex] then
            local go_table =
                _G.GetAutoGoTable(
                trans,
                function(btn, isOn)
                    self:OnClickItemBtn(btn, isOn)
                end
            )
            self.PlayerList[tblIndex] = go_table
        end
        self.PlayerList[tblIndex].toggle_TagSelect.name = "" .. tblIndex
        self.PlayerList[tblIndex].toggle_TagSelect.isOn = false

        local aorrawimage_Icon = self.PlayerList[tblIndex].aorrawimage_Icon
        local t_path = self.PlayerNameCfg[cfg].Photo
        aorrawimage_Icon:LoadImage(t_path)
        self.PlayerList[tblIndex].State = false
    end
end
-- 初始化 动作点击事件
function CardView:BindToggleFun(nowtransform, fun)
    nowtransform:GetComponentE(typeof(CS.UnityEngine.UI.Toggle)).onValueChanged:AddListener(_G.handler(self, fun))
end

-- 按钮单击事件--
function CardView:OnClickBtn(go)
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("CardView>>ClickBtn>>" .. name)
    end
    --关闭
    if name == "@_aorbtn_btnClose" then
        --初始化摄像机位置 以便下次寻找
        self:InitParentPos(self.nowRoleCamera, self.roleCamera1:GetParent())
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CardView.Name)
        _G.WorldManager:GetInstance():EnterWorld(self.lastSceneSid)
    end
end

-- Toggle单击事件--
function CardView:OnClickBtnToggle(go, isOn)
    local name = go:GetName()
    if self.obj_nowRole == nil or self.mActionType == nil then
        return
    end
    if isOn then
        self.isRoate = false
        self.obj_nowRole:SetRotationToIdentity()
        if name == "@_toggle_idle" then
            self:PlayActionType(self.mActionType.idle)
        elseif name == "@_toggle_debut" then
            -- self:PlayActionType(self.mActionType.attack)
            self:PlayActionType(self.mActionType.debut)
        elseif name == "@_toggle_special" then
            self:PlayActionType(self.mActionType.special)
        elseif name == "@_toggle_walk" then
            self:PlayActionType(self.mActionType.walk)
        elseif name == "@_toggle_rotate" then
            self:PlayActionType(self.mActionType.idle)
            self:Ontemp_rotate(nil, 2.5)
        elseif name == "@_toggle_stand" then
            self:PlayActionType(self.mActionType.stand)
        elseif name == "@_toggle_stunt" then
            self:PlayActionType(self.mActionType.stunt)
        elseif name == "@_toggle_attack" then
            self:PlayActionType(self.mActionType.attack)
        elseif name == "@_toggle_skill" then
            self:PlayActionType(self.mActionType.skill)
        elseif name == "@_toggle_summon" then
            self:PlayActionType(self.mActionType.summon)
        elseif name == "@_toggle_showaction" then
            -- --重置 动作为待机
            --休闲动作
            self.go_table.obj_actiontype_show:SetActiveE(isOn and 1 or 0)
            self.go_table.toggle_idle.isOn = true

            self:InitParentPos(self.nowRoleCamera, self.roleCamera1)
        elseif name == "@_toggle_hitaction" then
            -- --重置 动作显示为待机
            ---战斗 动作
            self.go_table.obj_actiontype_fight:SetActiveE(isOn and 1 or 0)
            self.go_table.toggle_stand.isOn = true

            self:InitParentPos(self.nowRoleCamera, self.roleCamera2)
        end
    else
        if name == "@_toggle_showaction" then
            -- --重置 动作为待机
            --休闲动作

            self.go_table.obj_actiontype_show:SetActiveE(isOn and 1 or 0)
            self.go_table.toggle_idle.isOn = false
        elseif name == "@_toggle_hitaction" then
            -- --重置 动作显示为待机

            self.go_table.obj_actiontype_fight:SetActiveE(isOn and 1 or 0)
            self.go_table.toggle_stand.isOn = false
        end
    end
end

------角色旋转控制
---@param isRotate_L boolean true顺时针旋转 默认false
---@param Rotate_speed int 旋转速度
function CardView:Ontemp_rotate(isRotate_L, Rotate_speed)
    if isRotate_L then
        t_Rotate_lr = 1
    else
        t_Rotate_lr = -1
    end
    if Rotate_speed then
        t_Rotate_speed = Rotate_speed
    else
        t_Rotate_speed = 5
    end

    self.isRoate = true
    if self.temp_rotate == nil then
        self.temp_rotate = _G.coroutine.start(_G.handler(self, self.CoOnProgress))
    end
end
---@param _ UnityEngine.GameObject
---@param isOn boolean
---@param cfg table UID
---@param index number
function CardView:OnClickItemBtn(nowObj, isOn)
    self:RemoveIdleEffect()
    local index = tonumber(nowObj.name)
    local cfg = self.PlayerCfg[index]
    ---  GetChild  box
    self.PlayerList[index]:GetChildE(3):SetActiveE(isOn and 1 or 0)

    if isOn and self.PlayerList[index].State == false then
        -- --重置 动作类型 为休闲动作
        self.go_table.toggle_showaction.isOn = true
        -- --重置 动作按钮显示为待机
        self.go_table.toggle_idle.isOn = true

        -- 当前角色名称
        self.go_table.aortext_rolename.text =
            self.PlayerNameCfg[cfg].describe .. "    -    " .. self.PlayerNameCfg[cfg].Name

        if nil ~= self.obj_nowRole then
            _G.PoolsManager:GetInstance():Despawn(self.obj_nowRole, _G.ePoolType.StoryRole)
        end
        if nil == self.RoloShowPoint then
            local world = _G.WorldManager:GetInstance():GetCurWorld()
            --将生成的NPC 挪远一点
            local t_ItemRoot = world.ItemRoot
            t_ItemRoot:SetPos(-5, 0, 0, false)
            --获取根节点 find角色展示节点
            local dfasda1 = world.Transform
            local dfasda2 = dfasda1:FindE("RoleShow")
            if nil ~= dfasda2 then
                local dfasda3 = dfasda2:FindE("RoloShowPoint")
                self.RoloShowPoint = dfasda3

                if nil == self.roleCamera1 then
                    self.roleCamera1 = dfasda2:FindE("roleCamera1")
                end
                if nil == self.roleCamera2 then
                    self.roleCamera2 = dfasda2:FindE("roleCamera2")
                end
                if nil == self.nowRoleCamera then
                    self.nowRoleCamera = dfasda2:FindE("nowRoleCamera")
                    self:InitParentPos(self.nowRoleCamera, self.roleCamera1)
                end
            end
        end

        ---加载预制体
        self:loadeRolePrefab(
            cfg,
            function(tran)
                self.obj_nowRole = tran
                --如果之前对象有 则销毁之前的回调
                if self.AnimComponent ~= nil then
                    _G.AnimatorPlayEndCallback.RemoveCallback(self.AnimComponent:GetInstanceIDE())
                end

                self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(tran)
                --播放一次 初始化 RoleAnimatorController.cs--> animationTime
                self.AnimComponent:Play(ActionType.idle[1], true)

                local tRoleIdleAnimPlaySpecial = self:GetComponent(self.obj_nowRole, _G.RoleIdleAnimPlaySpecial)
                if tRoleIdleAnimPlaySpecial == nil then
                    tRoleIdleAnimPlaySpecial =
                        self:AddComponent(self.obj_nowRole, _G.RoleIdleAnimPlaySpecial.New(self.AnimComponent))
                end

                ---@type RoleIdleAnimPlaySpecial
                self.mRoleIdleAnimPlaySpecial = tRoleIdleAnimPlaySpecial
                self.mActionType = _G.DeepCopy(ActionType)

                self:AddActionS(self.mActionType)

                _G.AnimatorPlayEndCallback.AddCallback(
                    self.AnimComponent:GetInstanceIDE(),
                    _G.handler(self, self.PlayAniCallBack)
                )
                self:PlayActionType(self.mActionType.idle)
                self.PlayerList[index].State = true
                self.PlayerList[index].toggle_TagSelect.isOn = true
            end
        )
    elseif self.PlayerList[index].State == true then
        self.PlayerList[index].State = false
    end
end

---播放动画
---@param name string 动画名称
---@param crossFade boolean 是否需要动画过渡，默认要
function CardView:PlayAnim(name)
    -- if nil == crossFade then
    --     crossFade = true
    -- end
    if not name or name == "" then
        return
    end
    if _G.IsNil(self.AnimComponent) then
        return
    end
    if not self.obj_nowRole then
        return
    end
    self.AnimName = name
    self.curAnimName = name

    if _G.AppSetting.DEBUG then
        _G.Log("CardView:PlayAnim", "<color=red>" .. name .. "</color>")
    end
    self.AnimComponent:Play(name, true)
end

--播放动作
function CardView:PlayActionType(nowActionType)
    self.AnimCount = nil

    ---如果上次是idld状态 但这次不是  清除回调
    if self.nowActionType == self.mActionType.idle and nowActionType ~= self.mActionType.idle then
        --如果之前对象有 则销毁之前的回调
        if self.AnimComponent ~= nil then
            _G.AnimatorPlayEndCallback.RemoveCallback(self.AnimComponent:GetInstanceIDE())
        end

        _G.AnimatorPlayEndCallback.AddCallback(
            self.AnimComponent:GetInstanceIDE(),
            _G.handler(self, self.PlayAniCallBack)
        )
    end

    self.nowActionType = nowActionType

    if nowActionType == self.mActionType.idle then
        self.mRoleIdleAnimPlaySpecial:SpecialStart()
    else
        self.mRoleIdleAnimPlaySpecial:SpecialStop()
        self:PlayAniCallBack()
    end
end

--播放动作
function CardView:PlayAniCallBack(name)
    if name then
        --
        if _G.AppSetting.DEBUG then
            _G.Log("CardView:PlayAniCallBack", "<color=red>" .. name .. "</color>")
        end

        if name ~= self.nowActionType[self.AnimCount] then
            return
        end
    end
    if self.nowActionType == nil or #self.nowActionType < 1 then
        return
    end
    self:AddAnimCount()
    if #self.nowActionType > 1 and self.AnimComponent:getNowPlayName() == self.nowActionType[self.AnimCount] then
        self:PlayAniCallBack()
    else
        self:PlayAnim(self.nowActionType[self.AnimCount], true)
    end
end

--播放动作
function CardView:AddAnimCount()
    if self.AnimCount == nil then
        self.AnimCount = 1
    elseif self.AnimCount + 1 > #self.nowActionType then
        self.AnimCount = 1
    else
        self.AnimCount = self.AnimCount + 1
    end
end

function CardView:CoOnProgress()
    while true do
        if self.isRoate == true and self.obj_nowRole ~= nil then
            if self.obj_nowRole ~= nil then
                self.obj_nowRole:Rotate(Vector3.up * t_Rotate_lr, t_Rotate_speed)
            end
        end
        _G.coroutine.waitforendofframe()
    end
end

---设置父级 并位置初始化
function CardView:InitParentPos(nowTF, nowParent)
    if nowTF == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" CardView:InitParentPos  nowTF对象丢失")
        end
        return
    end

    nowTF:SetParentE(nowParent)
    nowTF:SetPos(0, 0, 0, false)
    nowTF:SetRotationToIdentity()
end

function CardView:OnDestroy()
    if self ~= nil then
        if not _G.IsNil(self.obj_nowRole) and self.obj_nowRole ~= nil then
            _G.PoolsManager:GetInstance():Despawn(self.obj_nowRole, _G.ePoolType.StoryRole)
        end

        self:RemoveIdleEffect()
        if self.temp_rotate ~= nil then
            _G.coroutine.stopwaiting(self.temp_rotate)
            self.temp_rotate = nil
        end
    end
end

--- 加载Role对应的  预制体
function CardView:loadeRolePrefab(cfg, callback)
    ---加载预制体
    _G.PoolsManager:GetInstance():Spawn(
        self.PlayerNameCfg[cfg].ModelPathHi,
        _G.ePoolType.Temporary,
        self.RoloShowPoint,
        function(tran)
            if tran == nil then
                local param = {}
                param.Title = GetLangPackValue(90021300007)
                param.Content =
                    GetLangPackValue(90022500368) .. "<color=red>" .. self.PlayerNameCfg[cfg].ModelPathHi .. "</color>"
                param.SureCallBack = function()
                end
                param.CancelCallBack = function()
                end

                -- _G.PopWindowManager:GetInstance():ShopTipsWindow(param)
                return
            end
            if cfg == 154010000 then
                tran:SetLocalScaleXYZ(0.75)
            else
                tran:SetLocalScaleXYZ(1)
            end
            tran:SetRotationToIdentity()

            callback(tran)
        end
    )
end

---常驻特效 加载完成回调
function CardView:loadedIdleCall(effectTran, effectPath2, ccc, ddd, dfff)
    self.PlayerIdleEffect[effectPath2] = effectTran
end

function CardView:RemoveIdleEffect()
    ---销毁加载的常驻特效
    for effectPath, effectTran in pairs(self.PlayerIdleEffect) do
        _G.UIUtils.RemoveEffect(effectTran, 0)
        self.PlayerIdleEffect[effectPath] = nil
    end
end

return CardView
