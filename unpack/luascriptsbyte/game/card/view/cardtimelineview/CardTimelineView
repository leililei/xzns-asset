---@class CardTimelineView : UIBaseView	中文描述
---@field public go_table CardTimelineView_GoTable GoTable
local CardTimelineView = _G.BaseClass("CardTimelineView", _G.UIBaseView)
--_G.CardTimelineView = CardTimelineView

local CS = _G.CS
local typeof = _G.typeof
--region 场景处理
local ScenePrefabPath = "Ani_timeline/liuyuchan_zhanshi/jq/prefab/ef_liuyuchan_show_1"
local ResDic = {
    liuyuchan = 1
}
-----加载布阵场景
---@param  view EmbattleView 界面对象
---@param  PrefabPath string 场景地址
---@field camera _G.Camera
local function LoadEmbattleScene(view, PrefabPath, callback)
    local paht = ""
    if not string.IsNullOrEmpty(PrefabPath) then
        paht = PrefabPath
    else
        paht = ScenePrefabPath
    end
    _G.PoolsManager:GetInstance():Spawn(
        paht,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            trans:SetLocalPosition(0, 0, 0)
            if callback then
                callback(trans)
            end
        end
    )
end
--endregion

function CardTimelineView:Awake()
    self.sceneTrans = nil

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end
---界面的入口函数
function CardTimelineView:OnCreate(scencePath)
    self.sceneTrans = {}
    LoadEmbattleScene(
        self,
        scencePath,
        function(trans)
            self.sceneTrans[ResDic.liuyuchan] = {
                trans = trans,
                mgr = nil,
                playable_director = nil
            }
            -- local tMgr = trans:RequireComponentE(typeof(_G.CS.RoleTimelineManager))
            -- tMgr:Play()
            -- self.sceneTrans[ResDic.liuyuchan].mgr = tMgr
            self.sceneTrans[ResDic.liuyuchan].playable_director =
                trans:GetComponentE(typeof(CS.UnityEngine.Playables.PlayableDirector))
            _G.DelayDo(
                self.sceneTrans[ResDic.liuyuchan].playable_director.duration,
                function()
                    self:CloseView()
                end
            )
        end
    )
end

---按钮点击事件在这里派发
function CardTimelineView:CloseView(go, isOn)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if self.sceneTrans ~= nil then
        for key, value in pairs(self.sceneTrans) do
            _G.PoolsManager:GetInstance():Despawn(value.trans, _G.ePoolType.Temporary)
        end
        self.sceneTrans = nil
    end

    self:Close()
end
function CardTimelineView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
return CardTimelineView
