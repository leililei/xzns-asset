function BiographyView:PanDuan(k, star)
    local item = require("IllustrationModel"):GetInstance().b_info[self.id.id]
    if item == nil then
        return true
    end
    for _, value in pairs(item) do
        if k == value then
            return false
        elseif star > self.stars or self.stars == 0 then
            return false
        end
    end

    return true
end

function BiographyView:CareatItem(data, Parent, index)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            -- item.go_table.aorrawimage_Icon:SetGray(false)
            item.go_table.obj_ItemNum.GetComponentE(1)
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jianglitubiao,
                item.go_table.gameObject,
                function(trans)
                    item.effect = trans
                end
            )
            self.itemList[index] = item
        end,
        function(go, isOn)
            self:ListClick(Parent, index)
        end
    )
end

