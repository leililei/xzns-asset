---界面的入口函数
function BiographyView:OnCreate(Data, call)
    if Data == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("Id错误")
        end
    end
    self.call = call
    self.id = _G.ConfigManager.card_cfg[Data]
    --local unlock = _G.ConfigManager.card_star_unlock_cfg
    self.biography = _G.ConfigManager.card_biography_cfg
    local IllustrationModel = require("IllustrationModel"):GetInstance()
    self.stars = IllustrationModel.stars[self.id.id]
    self.b_info = IllustrationModel.b_info[self.id.id]
    if self.stars == nil then
        self.stars = 0
    end
    if self.b_info == nil then
        self.b_info = 0
    end
    self.sid = {}

    for _, value in pairs(self.biography) do
        if value.order == self.id.Order then
            self.sid[value.id] = value
        end
    end
    self:TextShuaXing()
    local RorSr = _G.table.count(self.sid)
    self.ScrollRect:UpdateCount(RorSr)
    --self:ItemXinashi()
    -- local t = {[1] = 1, 2, 3, 4, 5, 6, 7}
    -- local unlucky = _G.math.random(1, 7)
end

function BiographyView:TextShuaXing()
    self.go_table.aortext_name.text = _G.ConfigManager.language_package_cfg[self.id.Name]
    self.go_table.aortext_Name.text = _G.ConfigManager.language_package_cfg[self.id.Name]
    self.go_table.aortext_wuxing.text =
        _G.ConfigManager.language_package_cfg[_G.tonumber(_G.ConfigManager.type_elements_cfg[self.id.Elements].name)]
    self.go_table.aortext_shenfen.text =
        _G.ConfigManager.language_package_cfg[_G.tonumber(_G.ConfigManager.type_unit_cfg[self.id.UnitType].name)]
    self.go_table.aortext_zhenying.text =
        _G.ConfigManager.language_package_cfg[
        _G.tonumber(_G.ConfigManager.type_organization_cfg[self.id.Organization].name)
    ]

    local str = ""
    for key, value in pairs(self.id.recommend) do
        if key == _G.table.count(self.id.recommend) then
            str = str .. _G.ConfigManager.language_package_cfg[_G.tonumber(value)]
        else
            str = str .. _G.ConfigManager.language_package_cfg[_G.tonumber(value)] .. ","
        end
    end
    self.go_table.aortext_jiban.text = str
end

---刷新词条
function BiographyView:SuaXingCiTiao(index, listView2)
    if index < 0 then
        return
    end

    local indexs = self.id.Order * 100 + index + 1

    local item = listView2[0]
    local item1 = listView2[1]
    item:SetName(indexs)
    item1:SetName(indexs * 100)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnFriendListClick, indexs))
    local tb1 = _G.GetAutoGoTable(item1, _G.handlerbind(self, self.OnFriendListClick, indexs))
    item1:SetParentE(tb.obj_Count)
    if self.sid[indexs] == nil then
        return
    end
    local star = self.sid[indexs].star
    local biographies
    local langText = 0
    if index + 1 == 1 then
        biographies = self.id.biographies1
        if self.id.Order == 2 then
            langText =
                _G.LangUtil.GetLangPackValue(
                90020300180,
                _G.LangUtil.GetLangPackValue(self.StarIndexNameDic[self.biography[201].star])
            )
        else
            langText =
                _G.LangUtil.GetLangPackValue(
                90020300180,
                _G.LangUtil.GetLangPackValue(self.StarIndexNameDic[self.biography[301].star])
            )
        end
    elseif index + 1 == 2 then
        biographies = self.id.biographies2
        if self.id.Order == 2 then
            langText =
                _G.LangUtil.GetLangPackValue(
                90020300180,
                _G.LangUtil.GetLangPackValue(self.StarIndexNameDic[self.biography[202].star])
            )
        else
            langText =
                _G.LangUtil.GetLangPackValue(
                90020300180,
                _G.LangUtil.GetLangPackValue(self.StarIndexNameDic[self.biography[302].star])
            )
        end
    elseif index + 1 == 3 then
        biographies = self.id.biographies3
        if self.id.Order == 2 then
            langText =
                _G.LangUtil.GetLangPackValue(
                90020300180,
                _G.LangUtil.GetLangPackValue(self.StarIndexNameDic[self.biography[203].star])
            )
        else
            langText =
                _G.LangUtil.GetLangPackValue(
                90020300180,
                _G.LangUtil.GetLangPackValue(self.StarIndexNameDic[self.biography[303].star])
            )
        end
    else
        -- body
        biographies = nil
    end
    local SpriteName
    local suoding
    if star <= self.stars and self.stars ~= 0 then
        SpriteName = "ui_jszj_di_07"
        suoding = 0
        if biographies ~= nil and biographies[1] ~= nil then
            tb.aortext_BiaoTi.text = _G.ConfigManager.language_package_cfg[biographies[1]]
            tb.aortext_BiaoTi.color = require("CardInfoManager").GetColorFromRGB("D0D8FF")
        end
        if biographies ~= nil and biographies[2] ~= nil then
            tb1.aortext_BiaoTi.text = _G.ConfigManager.language_package_cfg[biographies[2]]
            tb1.aortext_BiaoTi.color = require("CardInfoManager").GetColorFromRGB("808199")
        end
    else
        if biographies ~= nil and biographies[1] ~= nil then
            tb.aortext_BiaoTi.text = _G.ConfigManager.language_package_cfg[biographies[1]]
            tb.aortext_BiaoTi.color = require("CardInfoManager").GetColorFromRGB("dee0eb")
        end
        SpriteName = "ui_jszj_di_08"
        suoding = 1
        tb1.aortext_BiaoTiGuanBi.text = langText
    end

    tb.aorimage_BG.SpriteName = SpriteName
    tb.aorimage_suo:SetActiveE(suoding)
    --_G.GameUtil.ReBuildRTF(tb1.aortext_BiaoTi)
    local ScrollRect = tb.gameObject:GetComponentE(_G.typeof(_G.CS.ScrollLoopBaseLevelPartObj))
    --ScrollRect:Btn_FoldSubList(false)
    local sha = false
    if index > 0 then
        sha = true
    end
    _G.TimerManager:GetInstance():GetTimer(
        2,
        self.ShuaXin,
        self,
        true,
        true,
        false,
        tb1,
        ScrollRect,
        sha,
        index
    ):Start()

    -- ScrollRect:Btn_FoldSubList(true)
    return item
end
