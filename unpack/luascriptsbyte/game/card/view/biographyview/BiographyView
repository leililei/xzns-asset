function BiographyView:LingQu(msg, _)
    ---@type public.s2c_common_ack
    self.Data = {}
    self.Data = msg
    local IllustrationModel = require("IllustrationModel"):GetInstance()

    if IllustrationModel.b_info[self.id.id] == nil then
        IllustrationModel.b_info[self.id.id] = self.itmelisyBiao
    else
        for key, value in pairs(self.itmelisyBiao) do
            _G.table.insert(IllustrationModel.b_info[self.id.id], value)
        end
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    --self:ItemXinashi()
    if self.call ~= nil then
        self.call()
    end
    --self.go:SetActiveE(0)
end
---按钮点击事件在这里派发
function BiographyView:OnClickBtn(go, isOn)
    if self.banduan == nil or self.banduan then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_guanbi" then
        self:Close()
    else
        self.clickFunction["nilFnc"].CallFunction(self, go)
    end
end
return BiographyView
