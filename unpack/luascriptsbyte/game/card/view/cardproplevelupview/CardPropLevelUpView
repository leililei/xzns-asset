---@class CardPropLevelUpView : UIBaseView	卡牌属性等级提升
---@field public go_table CardPropLevelUpView_GoTable GoTable
local CardPropLevelUpView = _G.BaseClass("CardPropLevelUpView", _G.UIBaseView)
--_G.CardPropLevelUpView = CardPropLevelUpView

function CardPropLevelUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_bossSkillbtn"] = self.OnClick_Skill,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.ConstDic = {
        lvstr = "Lv. <color=#95e7ff>%s</color>"
    }

    self.go_table_skill = _G.GetAutoGoTable(self.go_table.obj_skillLock, _G.handler(self, self.OnClickBtn))
end

---@field lv number[] _[之前等级,当前等级]
---@field CardData CardData
---@class params_CardPropLevelUpView
---界面的入口函数
---@param Data params_CardPropLevelUpView
function CardPropLevelUpView:OnCreate(Data)
    self.Data = Data
    self.CardData = Data.CardData
    self.lvL = 0
    self.lvR = 0
    if self.Data.lv ~= nil then
        self.lvL = self.Data.lv[1]
        self.lvR = self.Data.lv[2]
    end
    self:SetData(Data)
end

function CardPropLevelUpView:SetData()
    self:ShowLv()
    self:ShowProp()
    self:SetSkill()
    _G.AudioManager.PlayAudioByAudioCfgID(2030)
end

function CardPropLevelUpView:ShowLv()
    self.go_table.aortext_LvL.text = _G.string.format(self.lvL)
    self.go_table.aortext_LvR.text = _G.string.format(self.lvR)
end

function CardPropLevelUpView:ShowProp()
    local PropL = self.CardData:GetSpecifyStarLvProp(self.CardData.star, self.lvL)
    local PropR = self.CardData:GetSpecifyStarLvProp(self.CardData.star, self.lvR)

    local showlist = {
        _G.AttrType.max_hp,
        _G.AttrType.atk,
        _G.AttrType.def,
        _G.AttrType.bre
    }

    -- for key, value in pairs(_G.AttrType) do
    --     if value.proptype == 1 then
    --         _G.table.insert(showlist, value)
    --     end
    -- end
    -- _G.SortList(
    --     showlist,
    --     function(a)
    --         return -a.sortid
    --     end
    -- )
    local go_name = "obj_prop (%s)"
    ---@param value AttrTypeInfo
    for i, value in pairs(showlist) do
        local name = _G.string.format(go_name, i)
        local obj = self.go_table[name]
        if obj ~= nil then
            local go = _G.GetAutoGoTable(obj)
            local numL = PropL[value.key]
            local numR = PropR[value.key]
            self:SetProp(go, value.des, numL, numR)
        end
    end
end
function CardPropLevelUpView:SetProp(go, name, numL, numR)
    go.aortext_nameL.text = name
    go.aortext_numL.text = _G.tostring(numL)
    go.aortext_numR.text = _G.tostring(numR)
end

