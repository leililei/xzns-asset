---按钮点击事件在这里派发
function CardPropLevelUpView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function CardPropLevelUpView:OnClick_Skill(go)
    local skillid = go:GetParent():GetName()
    skillid = _G.tonumber(skillid)
    if skillid ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(skillid)
    end
end

function CardPropLevelUpView:CloseView()
    self:Close()
end

return CardPropLevelUpView
