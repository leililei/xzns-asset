---@class CardUpStarView_carditem : Component	单张卡 角色卡item
local CardUpStarView_carditem = _G.BaseClass("CardUpStarView_carditem", _G.Component)
_G.CardUpStarView_carditem = CardUpStarView_carditem
local CS = _G.CS
local typeof = _G.typeof
function CardUpStarView_carditem:Awake()
    self.CardData = nil
    self.index = nil
    --- -1未选中 1 1号位 2号位
    self.SelectIndex = -1
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.mCardUpStarView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CardUpStarView.Name).View
end

function CardUpStarView_carditem:OnCreate()
end

function CardUpStarView_carditem:Dispose()
    self.go_table = nil
    self.mCardInfoManager = nil
    self.mCardUpStarView = nil
end

---@param CardData CardData
---@param UpIndex number 本item是上方选中item 索引
function CardUpStarView_carditem:Init(CardData, index, UpIndex)
    --- 如果 数据为空 显示空格子
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_box, CardData == nil)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, not (CardData == nil))

    if CardData == nil then
        return
    end
    self.CardData = CardData
    self.index = index
    --- -1未选中 1 1号位 2号位
    self.SelectIndex = -1

    --- -1不是 1 1号位 2号位
    self.UpIndex = UpIndex or -1

    -- coroutine.start(_G.handler(self, self.InitData))
    self:InitData()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_xuanz, false)

    local tSele = self.mCardUpStarView.SelectObjs[self.CardData.uid]
    if tSele ~= nil then
        self:SetSelect(true, tSele)
    end
end

---初始数据
function CardUpStarView_carditem:InitData()
    self.go_table.aorrawimage_Icon.Alpha = 0
    local cardsid = self.CardData.sid
    ---@type card_cfg
    local cardInfo = _G.ConfigManager.card_cfg[cardsid]

    if _G.IsNil(cardInfo) then
        return
    end
    self.gameObject.name = self.CardData.uid
    if _G.GuideManager:GetInstance().IsGuideing then
        self.gameObject.name = self.index
    end
    --锁
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_suo, self.CardData.unlock == 1)
    -- --职业icon
    -- self.go_table.aorimage_zhiye=1
    -- --职业背景
    -- self.go_table.aorimage_zhiyebg=1
    -- 品质背景图
    self.go_table.aorimage_Color.SpriteName =
        self.mCardInfoManager:GetCardIconQualityBGSpriteName(self.CardData.cfg.Order)
    -- --角色
    if _G.IsNil(self.CardData.cfg.Icon) == false then
        self.go_table.aorrawimage_Icon:LoadImage("Images/zRoles/" .. self.CardData.cfg.Icon, nil, nil, 1)
    end

    -- -- --角色名字
    -- self.go_table.aortext_name.text = cardInfo.Name
    -- -- --角色等级
    self.go_table.aortext_Number.text = self.CardData.lv
    -- --是否出战
    -- self.go_table.aorimage_zhan
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorimage_zhan,
        require("CardInfoManager"):GetInstance():GetCardIsIntoBattle(self.CardData.uid)
    )
    --huo
    -- self.go_table.aorimage_huo1=1
    -- self.go_table.aorimage_huo2=1
    -- self.go_table.aorimage_huo3=1
    -- self.go_table.aorimage_huo4=1
    -- self.go_table.aorimage_huo5=1
    self:ShowStar(self.CardData.star)
    self:SetShow(true)
end

function CardUpStarView_carditem:Clear()
    if self.CardData == nil then
        return
    end
    self:SetSelect(false, -1)
    self:SetShow(false)
    self.CardData = nil
    self.index = nil
    self.SelectIndex = nil
    self.UpIndex = nil
end

function CardUpStarView_carditem:SetShow(isShow)
    _G.GameUtil.SetActiveByCondition(self.gameObject, isShow)
end

function CardUpStarView_carditem:SetSelect(isShow, SelectIndex)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_xuanz, isShow)
    if SelectIndex == -1 then
        self.mCardUpStarView.SelectObjs[self.CardData.uid] = nil
        --- 将原本 位置 赋空
        self.mCardUpStarView.SelectObjLua[self.SelectIndex] = nil
    else
        self.mCardUpStarView.SelectObjs[self.CardData.uid] = SelectIndex
        self.mCardUpStarView.SelectObjLua[SelectIndex] =
            _G.handler(
            self,
            function()
                self:SetSelect(false, -1)
            end
        )
    end
    self.SelectIndex = SelectIndex
end

--- 上方item
function CardUpStarView_carditem:OnClick_UpSelecet()
    local fun = self.mCardUpStarView.SelectObjLua[self.UpIndex]
    if fun then
        fun()
    end
    self:Clear()
end

function CardUpStarView_carditem:OnClick_Selecet()
    local Selectlua = nil
    local SelectIndex = -1
    for i = 1, #self.mCardUpStarView.selectItems do
        local tselectItem = self.mCardUpStarView.selectItems[i]
        if tselectItem.mLua.CardData == nil then
            Selectlua = tselectItem.mLua
            SelectIndex = i
            break
        end
    end

    local SelectFunc = function()
        ---  如果自身没选中 且 上方都被选了 则不响应
        if self.SelectIndex == -1 then
            if Selectlua == nil then
                return
            end
            Selectlua:Init(self.CardData, self.index, SelectIndex)
            self:SetSelect(true, SelectIndex)
        else
            local selectItem = self.mCardUpStarView.selectItems[self.SelectIndex]
            if selectItem == nil then
                return
            end
            selectItem.mLua:Clear()
            self:SetSelect(false, -1)
        end
    end

    require("CardInfoManager").CardReadyDestroy(
        self.CardData,
        function()
            self:InitData()
        end,
        function()
            SelectFunc()
        end
    )
end

-- 按钮单击事件--
function CardUpStarView_carditem:OnClickBtn(go)
    if _G.IsNil(go) then
        return
    end

    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("CardUpStarView_carditem>>ClickBtn>>" .. name)
    end
    if name == "@_aorbtn_Click" then
        if self.UpIndex ~= -1 then
            self:OnClick_UpSelecet()
        else
            self:OnClick_Selecet()
        end
    end
end

function CardUpStarView_carditem:ShowStar(star)
    self.mCardInfoManager:Star_byParent(self.go_table.obj_starParent, star)
end
function CardUpStarView_carditem:Star_setSprite(aorimage, type)
    if type == 2 then
        aorimage.SpriteName = "ui_ty_icon_huo2"
    elseif type == 1 then
        aorimage.SpriteName = "ui_ty_icon_huo1"
    else
        aorimage.SpriteName = "ui_ty_icon_huo3"
    end
end

function CardUpStarView_carditem:OnDestroy()
end
