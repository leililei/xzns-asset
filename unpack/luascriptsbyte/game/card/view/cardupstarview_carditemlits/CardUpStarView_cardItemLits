function CardUpStarView_cardItemLits:Awake()
    self.mCarditemList = {}
    for i = 1, self.transform:GetChildCountE() do
        local nowitem = self.transform:GetChildE(i - 1)
        if nowitem == nil then
            break
        end
        local tCardBagView_cardItem = self:GetComponent(nowitem, _G.CardUpStarView_carditem)
        if tCardBagView_cardItem == nil then
            tCardBagView_cardItem = self:AddComponent(nowitem, _G.CardUpStarView_carditem.New())
        end
        self.mCarditemList[i] = tCardBagView_cardItem
        -- body
    end

