---@class CardMaCheView_base : Component	马车系统-子页面
local CardMaCheView_base = _G.BaseClass("CardMaCheView_base", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function CardMaCheView_base:OnCreate(obj, CardMaCheView)
    ---@type CardMaCheView
    self.mCardMaCheView = CardMaCheView
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.ElementsType = 0
    self:Init()
    self.gameObject:SetActiveE(0)
end
function CardMaCheView_base:Init()
    if _G.AppSetting.DEBUG then
        _G.LogError(" Init未重载 " .. self.__cname)
    end
end
function CardMaCheView_base:Show()
    self.gameObject:SetActiveE(1)
end
function CardMaCheView_base:Hide()
    self.gameObject:SetActiveE(0)
end
function CardMaCheView_base:SetNilTips(isShow)
    self.go_table.aorimage_tips:SetActiveE(isShow and 1 or 0)
end

function CardMaCheView_base:UnEquip(Cardata, call)
    local indexs = {}
    local Uids = {}

    ---@param equip EquipmentItem
    for key, equip in pairs(Cardata.EquipBar) do
        if not table.isEmptyOrNil(equip) then
            table.insert(Uids, {equip.sid, equip.uid})
            table.insert(indexs, key)
        end
    end
    if not _G.table.isEmptyOrNil(Cardata.ArtifactBar) then
        table.insert(Uids, {Cardata.ArtifactBar.sid, Cardata.ArtifactBar.uid})
    end
    if #indexs < 1 then
        --call(Uids)
        self:UnDecoration(Cardata, function(uids)
            self:UnArtifact(Cardata, call, uids)
        end, Uids)
    else
        require("EquipmentModel"):GetInstance():UnfixEquip(
            Cardata.uid,
            indexs,
            function(data)
                for _, equip in pairs(Cardata.EquipBar) do
                    if not table.isEmptyOrNil(equip) then
                        equip:UnEquip()
                    end
                end
                --call(Uids)
                self:UnDecoration(Cardata, function(uids)
                    self:UnArtifact(Cardata, call, uids)
                end, Uids)
            end
        )
    end
end

function CardMaCheView_base:UnDecoration(CardData, call, Uids)
    self.decoration = {}
    if CardData:GetDecorationCount() == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("无饰品 穿戴")
        end
        if call then
            call(Uids)
            return
        end
    end
    local DecorationBar = CardData.DecorationBar
    for i = 1, #DecorationBar do
        if not _G.table.isEmptyOrNil(DecorationBar[i]) then
            _G.table.insert(self.decoration, {DecorationBar[i].sid, DecorationBar[i].uid})
        end
    end
    require("DecorationModel"):GetInstance():UnfixDecoration(
        {CardData.uid},
        function()
            if call then
                call(Uids)
            end
        end
    )
end

function CardMaCheView_base:UnArtifact(cardData, call, Uids)
    ---脱下神器
    require("ArtifactModel"):TakeOffArtifact(cardData, function()
        if call then
            call(Uids)
        end
    end)
end

---升星会返装备  检测装备背包是否能容纳
---@return boolean,number true能容纳 , 返装备数量
function CardMaCheView_base:CheckStorageMax_Equipment(CardDataS)
    --- 返数量
    local reCount = 0
    for _, CardData in pairs(CardDataS) do
        reCount = reCount + CardData:GetEquipBarNumber()
    end

    local isok = true
    if reCount > 0 then
        if _G.StorageManager:GetInstance():CheckUnfixEquipmentIsFull(reCount) then
            isok = false
        end
    end

    return isok, reCount
end

---检测 卡牌仓库 是否能装下
---@return boolean true能容纳
function CardMaCheView_base:CheckStorageMax_Card(count)
    return _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Card, count)
end

---按钮点击事件在这里派发
function CardMaCheView_base:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function CardMaCheView_base:SetisUpdataList(isUpdataList)
    if isUpdataList == true and self.mCardMaCheView.isUpdataList ~= true then
        self.mCardMaCheView.isUpdataList = isUpdataList
    end
end
function CardMaCheView_base:RefreshView()
end
return CardMaCheView_base
