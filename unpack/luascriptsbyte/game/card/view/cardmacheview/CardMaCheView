---@type string[] 内嵌页面名称列表
local InnerViews = { "develop" }

---@class CardMaCheView : UIBaseView 返魂（马车） 主界面
---@field go_table CardMaCheView_GoTable
---@field toggles table<string,CardMaCheView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local CardMaCheView = _G.BaseClass("CardMaCheView", _G.UIBaseView)

function CardMaCheView:Awake()
    -- if _G.PlayerPrefsManager.GetInt("Red_CardMache", 999) ~= 1 then
    --     _G.PlayerPrefsManager.SetInt("Red_CardMache", 1)
    --     require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MacheIcon.id)
    -- end
    self.go_table.aorbtn_CloseView.EnableClickSound = false

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_isGray"] = self.OnClickIsGray,
        [self.go_table.aorbtn_help:GetName()] = function(_, _, isOn)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 76)
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    -- local resources = _G.ConfigManager.ui_cfg.CardMaCheView.resources
    -- if #resources > 0 then
    --     self:AddComponent(
    --         self.go_table.obj_goldInfo,
    --         require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
    --     )
    -- end
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function CardMaCheView:OnCreate(toggleIndex)
    self:InitToggles()

    ---@type string
    local key
    if not toggleIndex then
        key = "reset"
    elseif type(toggleIndex) == "string" then
        key = toggleIndex
    elseif toggleIndex == 1 then
        key = "reset"
    elseif toggleIndex == 2 then
        key = "resolve"
    elseif toggleIndex == 3 then
        key = "develop"
    else
        key = "reset"
    end
    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_reset
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function CardMaCheView:OnEnable()
    self:AddListener(_G.eFunctionsStatus.OpenCfgFunctionId,handler(self,self.RefreshToggle))
end

function CardMaCheView:OnDestroy()
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnDevelopOpened)
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.LoadCardReplacementViewBack)
    self:RemoveListener(_G.eUIManagerStatus.OpenCfgFunctionId, self.RefreshToggle)

    --关闭内嵌页面O
    for key, view in pairs(self.views) do
        if _G.table.indexof(InnerViews, key) and view and view ~= 0 then
            view:Close()
        end
    end
end

function CardMaCheView:InitToggles()
    self.views = {}
    self.toggles = {
        reset = _G.GetAutoGoTable(
            self.go_table.toggle_reset,
            _G.handlerbind(self, self.OnClickToggle, "reset", _G.handler(self, self.OnReset))
        ),
        resolve = _G.GetAutoGoTable(
            self.go_table.toggle_resolve,
            _G.handlerbind(self, self.OnClickToggle, "resolve", _G.handler(self, self.OnResolve))
        ),
        develop = _G.GetAutoGoTable(
            self.go_table.toggle_develop,
            _G.handlerbind(self, self.OnClickToggle, "develop", _G.handler(self, self.OnDevelop))
        ),
    }
    self:RefreshToggle()
end

function CardMaCheView:RefreshToggle(funcId)
    local isUnlockReplacement = require("CardUtils").GetIsUnlockReplacement()
    self.go_table.toggle_resolve:SetActiveE(isUnlockReplacement and 1 or 0)
end

---监听Toggle点击事件
---@param key string
---@param callback function
function CardMaCheView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)

    if isOn then
        self.curToggle = key
        local isShowHelp = false
        if self.curToggle == "reset" then
            isShowHelp = true
        end
        self.go_table.aorbtn_help:SetActiveE(isShowHelp and 1 or 0)
    end

    --节点显隐
    if view and view ~= 0 then
        if _G.table.indexof(InnerViews, key) then
            if isOn then
                view:Show()
            else
                view:Hide()
            end
        else
            view.gameObject:SetActiveE(isOn and 1 or 0)
        end
    end

    if isOn and callback then
        callback()
    end
end

function CardMaCheView:OnReset()
    local view = self.views.reset
    if not view then
        self:LoadResetOrResolveComponent()
    elseif view ~= 0 then
        view:Show(0)
    end
end

function CardMaCheView:OnResolve()
    local view = self.views.resolve
    if not view then
        require("CardInfoNet"):GetInstance():GetExchangeInfo(nil,function(data)
            --self.views.resolve = 0
            self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.LoadCardReplacementViewBack)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardReplacementView.Name,data.times)
        end)
    elseif view ~= 0 then
        view:Show(1)
    end
end

function CardMaCheView:OnDevelop()
    local view = self.views.develop
    if not view then
        self.views.develop = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnDevelopOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardDevelopView.Name)
    elseif view ~= 0 then
        view:SetData()
    end
end

---加载重置和遣返界面
function CardMaCheView:LoadResetOrResolveComponent()
    self.views.reset = 0
    --self.views.resolve = 0

    local resPath = "UIH5/Card/CardMaCheView/CardMaCheView_reset"
    _G.PoolsManager:GetInstance():Spawn(
        resPath,
        _G.ePoolType.UIItem,
        self.go_table.obj_NodeParent,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end

            local component = self:AddComponent(trans, require("CardMaCheView_reset").New(trans, self))
            self.views.reset = component
            --self.views.resolve = component

            if self.curToggle == "reset" then
                component:Show(0)
            elseif self.curToggle == "resolve" then
                component:Show(1)
            else
                component.gameObject:SetActiveE(0)
            end
        end
    )
end

function CardMaCheView:LoadCardReplacementViewBack(name)
    if name ~= _G.ConfigManager.ui_cfg.CardReplacementView.Name then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.LoadCardReplacementViewBack)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_NodeParent)
    if view.go_table and view.go_table.obj_close then
        view.go_table.obj_close:SetActiveE(0)
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views.resolve = view
    if self.curToggle ~= "resolve" then
        view:Hide()
    end
end

---加载升星界面
function CardMaCheView:OnDevelopOpened(name)--CardReplacementView  CardReplacementView
    if name ~= _G.ConfigManager.ui_cfg.CardDevelopView.Name then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnDevelopOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_NodeParent)
    if view.go_table and view.go_table.obj_close then
        view.go_table.obj_close:SetActiveE(0)
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views.develop = view
    if self.curToggle ~= "develop" then
        view:Hide()
    end
end

function CardMaCheView:CloseView()
    UIManager:GetInstance():CloseWindow(ConfigManager.ui_cfg.CardReplacementView.Name)
    if self.curToggle=="develop" and self.views.develop.CardData ~= nil then
        self.views.develop:UpdataLoopList()
        self.views.develop:UpdatePropCardData()
        return
    end
    self:Close()
end

function CardMaCheView:OnClickIsGray()
    _G.PopWindowManager:GetInstance():ShowAllTips(460113)
end

---按钮点击事件在这里派发
function CardMaCheView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return CardMaCheView
