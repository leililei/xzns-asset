function CardMaCheView_resolve:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    index = index + 1
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemObjDic[id] = item
        item.lua_ItemCardAllView = require("ItemCardBodySelectView").New(item.obj_card)
    end
    local isSelect = false
    local data = self.itemDatas[index]
    if data ~= nil then
        if item.lua_ItemCardAllView.CardData == nil or item.lua_ItemCardAllView.CardData.uid ~= data.uid then
            item.obj_card:SetActiveE(0)
            if self.IsLoopInit then
                item.obj_card:SetActiveE(1)
                item.lua_ItemCardAllView:ShowCardData(data, _G.handler(self, self.OnClick_CardClick), true, index)
            else
                _G.DelayDo(
                    index * 0.02,
                    function()
                        item.obj_card:SetActiveE(1)
                        item.lua_ItemCardAllView:ShowCardData(
                            data,
                            _G.handler(self, self.OnClick_CardClick),
                            true,
                            index
                        )
                    end
                )
            end
        end
        if self.SelectIndexDic[data.uid] then
            isSelect = true
        end
    end
    item.aorimage_Selected:SetActiveE(isSelect and 1 or 0)
    item.obj_card:SetActiveE(data ~= nil and 1 or 0)
    return item
end
function CardMaCheView_resolve:OnItemSelectCall(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local item = self.itemSelectObj[id]
    index = index + 1
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemSelectObj[id] = item
        item.lua_ItemCardAllView = require("ItemCardAllView").New(item.gameObject)
    end
    local cardid = self.showCardlist[index] or 0
    if cardid == 0 then
        _G.GameUtil.SetActiveByCondition(item.gameObject, false)
        return item
    end

    local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardid)
    if data ~= nil then
        _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        if item.lua_ItemCardAllView.CardData == nil or item.lua_ItemCardAllView.CardData.uid ~= data.uid then
            _G.GameUtil.SetActiveByCondition(item.gameObject, false)
            if self.IsLoopInit then
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item.lua_ItemCardAllView:ShowCardData(data, nil, true, index)
            else
                _G.DelayDo(
                    index * 0.02,
                    function()
                        _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                        item.lua_ItemCardAllView:ShowCardData(data, nil, true, index)
                    end
                )
            end
        end
    else
        _G.GameUtil.SetActiveByCondition(item.gameObject, false)
    end
    return item
end

function CardMaCheView_resolve:OnClick_CardClick(params)
    local index = params[1]
    local cardData = self.itemDatas[index]
    if cardData == nil then
        return
    end
    if self.SelectIndexDic[cardData.uid] then
        self.SelectIndexDic[cardData.uid] = nil
        self.showCardlist[index] = 0
    else
        if _G.table.count(self.SelectIndexDic) >= self.MaxSelectCount then
            _G.PopWindowManager:GetInstance():ShowAllTips(623) --选择卡牌数量达到上限
            return
        end
        if cardData.shenshiPosType ~= _G.StonePosType.PosZero then  --共鸣神石槽位卡
            _G.PopWindowManager:GetInstance():ShowAllTips(170305)
            return
        end
        self.SelectIndexDic[cardData.uid] = index
        self.showCardlist[index] = cardData.uid
        self.showCardlist[index] = cardData.uid
    end
    if _G.table.isEmptyOrNil(self.SelectIndexDic) then
        self.showCardlist = {}
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_node_qiansan, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nothing, true)
    else
        -- _G.GameUtil.SetActiveByCondition(self.go_table.scrollloophorizontal_resolveCard, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_node_qiansan, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nothing, false)
    end
    self.go_table.scrollloopvectical_card:UpdateItemSingle(index - 1)
    --self:UpdataSelectList(#self.showCardlist)
    self:ShowItem()
    self:ShowItemCard()
end

--- 一键选择
function CardMaCheView_resolve:OnClick_All()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    if _G.table.isEmptyOrNil(self.itemDatas) then
        local cont = _G.LangUtil.GetLangPackValue(90024100042)
        _G.FloatTipsModel:GetInstance():Show(cont)
        return
    end
    --- 如果当前有勾选 就全取消
    if table.count(self.SelectIndexDic) > 0 then
        self.SelectIndexDic = {}
        self.showCardlist = {}
        self:UpdataList()
        self.go_table.scrollloopvectical_card:ScrollToIndex(0)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_node_qiansan, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nothing, true)
        return
    end
    --- 没有勾选就全勾
    self.SelectIndexDic = {}
    for i = 1, self.MaxSelectCount do
        local card = self.itemDatas[i]
        if card == nil then
            break
        else
            if card.shenshiPosType ~= _G.StonePosType.PosZero then  --共鸣神石槽位卡
                _G.PopWindowManager:GetInstance():ShowAllTips(170305)
                return
            end
            self.SelectIndexDic[card.uid] = i
            self.showCardlist[i] = card.uid
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_nothing, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_node_qiansan, true)
    self:UpdataList()

    self.go_table.scrollloopvectical_card:ScrollToIndex(0)
end

---准备遣散
function CardMaCheView_resolve:OnClick_Ready()
    local cards = {}
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    for _, index in pairs(self.SelectIndexDic) do
        table.insert(cards, self.itemDatas[index])
    end
    if #cards == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(460110)
        return
    end

    local isok = self:CheckStorageMax_Equipment(cards)
    if isok == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(460105)
        return
    end

    if not require("ArtifactModel"):GetInstance():CheckEnoughStorageToTakeOffArtifact(cards, true) then
        return
    end

    if not require("SpiritualModel"):GetInstance():CheckIsEnoughStorageSize(cards, true) then
        return
    end

    _G.PopWindowManager:GetInstance():ShowAllTips(
        460101,
        nil,
        function()
            local consume_cards = table.keys(self.SelectIndexDic)
            require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                consume_cards,
                function(Refun)
                    self:Star_resolve(consume_cards, Refun)
                end,
                function()
                    -- _G.PopWindowManager:GetInstance():ShowAllTips(1001, "mache  遣散失败 请稍后再试")
                end
            )
        end
    )
end

---开始 遣散
function CardMaCheView_resolve:Star_resolve(consume_cards, Refun)
    ---@type card.c2s_card_resolve
    local pbdata = {}
    pbdata.uids = consume_cards
    require("CardInfoNet"):GetInstance():CardResolve(
        pbdata,
        function(data)
            if data.ack ~= 1 then
                --_G.GameUtil.NetAckShowTips(data.ack)
                if Refun then
                    Refun()
                end
                return
            end
            self:SetisUpdataList(true)
            self.showCardlist = {}
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_node_qiansan, false)
            if data.award ~= nil and data.award.item ~= nil then
                --- 解析奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            end
            for _, carduid in ipairs(consume_cards) do
                _G.StorageManager:GetInstance():DelCard(carduid)
            end
            require("CardInfoManager"):GetInstance():CardNewStartDestroy(consume_cards)
            self:Show()
        end
    )
end

