---展示 卡牌的选择的 卡牌立绘
function CardMaCheView_resolve:ShowSelecetLihuiIcon()
    local card = self.itemDatas[self.NowSelectIndex] or {}
    if _G.table.isEmptyOrNil(card) then
        self:ShorOrHideNothing(true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Lh_icon, false)
        return
    end
    local lihui_image = card.cfg.Portrait
    local pos = card.cfg.pos_portrait1
    local scale = card.cfg.size3 or 0.7
    self.go_table.aorrawimage_Lh_icon:LoadImage(
        lihui_image,
        function(item)
            _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Lh_icon, true)
            item.gameObject:SetLocalPosition((pos[1] or 0) - 230, pos[2] or 0, pos[3] or 0)
            item:SetLocalScale(scale * 0.9, scale * 0.9, scale * 0.9)
            self.go_table.aorrawimage_Lh_icon:SetNativeSize()
        end
    )
end
