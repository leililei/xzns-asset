function CardMaCheView_resolve:SetCardList()
    -- 当前选中的卡  [uid=index]
    self.SelectIndexDic = {}
    self.itemDatas = {}
    local Dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    ---@type CardData[]
    ---@param v CardData
    for key, value in pairs(Dic) do
        if value.Grade <= self.resolveCfg_grade then
            if self.ElementsType == 0 then
                _G.table.insert(self.itemDatas, value)
            elseif require "CardInfoManager":GetInstance():CheckMultiMatch(self.ElementsType , value.cfg.Elements_new) then
                _G.table.insert(self.itemDatas, value)
            end
        end
    end

    -- self.itemDatas =
    --     table.chooseToArray(
    --     Dic,
    --     function(k, v)
    --         return v.Grade <= self.resolveCfg_grade
    --         -- v.lv_Old > 1
    --     end
    -- )
    ---@param v CardData
    _G.SortList(
        self.itemDatas,
        function(v)
            return v.lv_Old, v.uid
        end
    )
    local count = #self.itemDatas
    -- if count > 0 then
    --     ---默认选择第一张
    --     self.SelectIndexDic[self.itemDatas[1].uid] = true
    -- end
    if count == 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothingCard, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothingCard, false)
    end
    self:UpdataList(count)

    self.IsLoopInit = true
end
function CardMaCheView_resolve:UpdataList(Count)
    if Count ~= nil then
        -- if Count < 25 then
        --     Count = 25
        -- end
        self.go_table.scrollloopvectical_card:UpdateCount(Count)
    else
        self.go_table.scrollloopvectical_card:UpdateAllItem()
    end

    self:ShowItem()
    self:ShowItemCard()
end
---刷线选中的 卡牌列表
function CardMaCheView_resolve:UpdataSelectList(Count)
    if Count ~= nil then
        self.go_table.scrollloophorizontal_resolveCard:UpdateCount(Count)
    else
        self.go_table.scrollloophorizontal_resolveCard:UpdateAllItem()
    end
end
---@param CardData CardData
function CardMaCheView_resolve:ShowItemCard()
    local ChildCount = self.go_table.obj_itemCard:GetChildCountE()
    for i = 1, ChildCount do
        local tran = self.go_table.obj_itemCard:GetChildE(ChildCount - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    local Count = table.count(self.SelectIndexDic)
    if Count <= 0 then
        return
    end
    for key, value in pairs(self.SelectIndexDic) do
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, key)
        --_G.StorageManager:GetInstance():GetItemBaseView(card.sid, 1, self.go_table.obj_itemCard, nil)
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            self.go_table.obj_itemCard,
            function(item)
                item:Show(card.sid, nil, card.star, card.soulLink_lv, card.lv, card.uid, true, card.open_inborn)
            end
        )
    end
end
function CardMaCheView_resolve:ShowItem()
    local ChildCount = self.go_table.obj_item:GetChildCountE()
    for i = 1, ChildCount do
        local tran = self.go_table.obj_item:GetChildE(ChildCount - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    local Count = table.count(self.SelectIndexDic)
    if Count <= 0 then
        return
    end
    local ItemViewBase = require("ItemViewBase")

    local Dic = _G.ConfigManager.discrete_cfg[103701]
    if Dic ~= nil then
        Dic = Dic
    else
        Dic = {}
    end
    local len = #Dic
    for i = 1, len do
        local param = Dic[i]
        if param then
            local num = param[2]
            if num > 0 then
                local sid = param[1]
                num = num * Count
                _G.StorageManager:GetInstance():GetItemBaseView(
                    sid,
                    num,
                    self.go_table.obj_item,
                    function(mitem)
                        mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                    end
                )
            end
        end
    end

    local card_level_cfg = _G.ConfigManager.card_level_cfg
    local res = {}
    res[_G.ResPropID.Coin] = 0
    res[_G.ResPropID.CardExp] = 0

    ---@type CardData
    local cardData, cfgItem, len, key, id, num
    for carduid, _ in pairs(self.SelectIndexDic) do
        cardData = self.itemDatas[self.SelectIndexDic[carduid]]
        if cardData.lv_Old > 1 then
            ---@type card_level_cfg
            cfgItem = card_level_cfg[cardData.lv_Old]
            res[_G.ResPropID.CardExp] = res[_G.ResPropID.CardExp] + cfgItem.exp
            res[_G.ResPropID.Coin] = res[_G.ResPropID.Coin] + cfgItem.coin
            len = #cfgItem.material
            if len >= 2 then
                len = len / 2
                for i = 1, len do
                    key = i * 2
                    id = cfgItem.material[key - 1]
                    num = cfgItem.material[key] or 0
                    if res[id] == nil then
                        res[id] = 0
                    end
                    res[id] = res[id] + num
                end
            end
        end
    end
    for sid, num in pairs(res) do
        if num > 0 then
            _G.StorageManager:GetInstance():GetItemBaseView(
                sid,
                num,
                self.go_table.obj_item,
                function(mitem)
                    mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                end
            )
        end
    end
end
