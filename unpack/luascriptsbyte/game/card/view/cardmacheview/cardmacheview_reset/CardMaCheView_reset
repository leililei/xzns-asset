function CardMaCheView_reset:ResetEnd(consume_cards, data, callback)
    self:SetisUpdataList(true)
    --ZHJH-2359【战斗】战斗中回退正在战斗的角色下一场战斗时该角色直接消失
    --保留上阵状态
    --require("CardInfoManager"):GetInstance():CardNewStartDestroy(consume_cards)
    ---@type CardData
    local mCardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, consume_cards[1])
    ---消耗回退道具
    if mCardData and mCardData.star >= self.Reset_StarCost then
        _G.StorageManager:GetInstance():ConsumeItem(self.resumeCfg[1], nil, self.resumeCfg[2])
        local count = _G.PlayerPrefsManager.GetInt("CardRest_Prop_RedPoint", 0)
        _G.PlayerPrefsManager.SetInt("CardRest_Prop_RedPoint", _G.Mathf.Max(count - self.resumeCfg[2], 0))
        require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.BackpackItem.id,
                self.resumeCfg[1]
        )
    end
    if mCardData ~= nil then
        mCardData:Reset(6)
        _G.PlayerPrefsManager.SetInt(
                tostring(_G.PlayerModel:GetInstance().role_uid) .. mCardData.uid .. "SpiritualUnlock",
                6
        )
        require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.SpiritualPage.id,
                mCardData.uid
        )
    end
    if data.award ~= nil and data.award.item ~= nil then
        --- 解析奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        local awardType_mCard = {
            [1] = mCardData.sid,
            [2] = mCardData.uid,
            [3] = mCardData.star
        }
        _G.table.insert(data.award.item, { type = awardType_mCard })
        _G.table.insertto(data.award.item, self.awardLis)
        -- require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        --     _G.ConfigManager.redpoint_cfg.Biography.id
        -- )
    end
    require("CardInheritModel"):GetInstance():CheckInheritBuffLock()
    -- require("CardResonanceModel"):GetInstance():UpdateAllPosCard()
    if callback then
        callback()
    end
    require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg.RoleArtifact.id,
            mCardData.uid
    )
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
    )
    _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.Card.Reset },
            1
    )
    return data
end

---开始 遣散
function CardMaCheView_reset:Star_resolve(consume_cards, Refun)
    ---@type card.c2s_card_resolve
    local pbdata = {}
    pbdata.uids = consume_cards
    require("CardInfoNet"):GetInstance():CardResolve(
            pbdata,
            function(data)
                if data.ack ~= 1 then
                    --_G.GameUtil.NetAckShowTips(data.ack)
                    if Refun then
                        Refun()
                    end
                    return
                end
                self:SetisUpdataList(true)
                self.showCardlist = {}
                if data.award ~= nil and data.award.item ~= nil then
                    --- 解析奖励
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                end
                for _, carduid in ipairs(consume_cards) do
                    _G.StorageManager:GetInstance():DelCard(carduid)
                end
                require("CardInfoManager"):GetInstance():CardNewStartDestroy(consume_cards)
            end
    )
end

