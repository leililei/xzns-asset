local base = require("CardMaCheView_base")

---@class CardMaCheView_reset : CardMaCheView_base    马车系统-角色 回退
local CardMaCheView_reset = _G.BaseClass("CardMaCheView_reset", base)
local typeof = _G.typeof
---创建对象时,入口构造函数
function CardMaCheView_reset:Init()
    self.itemObjDic = {}
    --按钮点击对应的方法
    self.clickFunction = {
        ["@_aorbtn_plus"] = self.OpenSelectHeroPanel,
        ["@_aorbtn_roleSelect"] = self.OpenSelectHeroPanel,
        [self.go_table.aorbtn_sure:GetName()] = function()
            if self.pageType == 0 then
                self:OnClick_Star_Reset()
            elseif self.pageType == 1 then
                self:OnClick_Star_Resolve()
            end
        end,
        [self.go_table.aorrawimage_costIcon:GetName()] = function(obj, go, isOn)
            require("CommonTipManager"):GetInstance():OpenPropTip(self.go_table.aorrawimage_costIcon, self.resumeCfg[1])
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))

    ---角色回退卡牌品质大于等于3
    self.Reset_Grade = _G.ConfigManager.discrete_cfg[103707][1][1]
    self.Reset_StarLowr = _G.ConfigManager.discrete_cfg[103709][1][1]
    self.Reset_StarCost = _G.ConfigManager.discrete_cfg[103709][1][2]
    ---回退消耗的道具
    self.resumeCfg = _G.ConfigManager.discrete_cfg[103712][1]
    self.resumeItemCfg = _G.ConfigManager.item_cfg[self.resumeCfg[1]]
    self.resumeItemNum = self.resumeCfg[2]
    local sizeDelta_bg_x, sizeDelta_bg_y = self.go_table.obj_hide:GetComponentE(typeof(CS.UnityEngine.RectTransform)):GetRectTransformSize()
    local y = sizeDelta_bg_y - 640
    if y > 0 then
        local sizeDelta = _G.Vector2.New(self.go_table.obj_Scroll_cards:GetRectTransformSize())
        self.go_table.obj_Scroll_cards:SetRectTransformSize(sizeDelta.x, sizeDelta.y + y / 2)
        sizeDelta = _G.Vector2.New(self.go_table.obj_Scroll_items:GetRectTransformSizeDelta())
        self.go_table.obj_Scroll_items:SetRectTransformSize(sizeDelta.x, sizeDelta.y + y / 2)
        _G.GameUtil.ReBuildRTF(self.go_table.obj_Scroll_cards)
    end
    self:LoadEffect()
end

function CardMaCheView_reset:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_chongshengjitan, self.go_table.obj_bgEffect, check)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_fudong, self.go_table.obj_plusEffect, check)
end

function CardMaCheView_reset:IsNil()
    return self.go_table == nil
end

function CardMaCheView_reset:Show(pageType)
    self.pageType = pageType
    self.card = nil
    self.itemDatas = {}
    self.SelectIndexDic = {}
    self:ShowItem()
    self:ShowSelecetLihuiIcon()
    if pageType == 0 then
        -- self.go_table.aortext_right.text = "回退"
        self.go_table.aortext_cardTitle.text =_G.LangUtil.GetLangPackValue(18900000096)
        self.go_table.aortext_tip.text = _G.LangUtil.GetLangPackValue(90024100039)
    elseif pageType == 1 then
        -- self.go_table.aortext_right.text = "遣返"
        self.go_table.aortext_cardTitle.text =_G.LangUtil.GetLangPackValue(90024100030)
        self.go_table.aortext_tip.text = _G.LangUtil.GetLangPackValue(90024100038)
    end
    self.go_table.aortext_notres:SetActiveE(0)
    self.go_table.obj_plus:SetActiveE(1)
    self.go_table.obj_plusTip:SetActiveE(pageType == 0 and 1 or 0)
    base.Show(self)
end

---打开选择英雄界面
function CardMaCheView_reset:OpenSelectHeroPanel()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardMaCheView_selectHero.Name, self.pageType, _G.handler(self, self.SelectCallBack))
end

---展示 卡牌的选择的 卡牌立绘
function CardMaCheView_reset:ShowSelecetLihuiIcon()
    if self.go_table.trans_selectCardNode:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(self.go_table.trans_selectCardNode:GetChildE(0), _G.ePoolType.UIItem)
    end
    local card = self.card or {}
    if _G.table.isEmptyOrNil(card) then
        return
    end
    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.BodyItem_select,
            self.go_table.trans_selectCardNode,
            function(itemLua)
                card.skinIs = false

                if card.skin and card.skin ~= 0 then
                    card.skinIs = true
                end
                itemLua:ShowCardData(card, nil, true)
            end
    )
end

function CardMaCheView_reset:RefreshView()
    self:Show()
end

function CardMaCheView_reset:ShowItem()
    local count = self.go_table.obj_item:GetChildCountE()
    for i = 1, count do
        local tran = self.go_table.obj_item:GetChildE(count - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end
    count = self.go_table.obj_itemCard:GetChildCountE()
    for i = 1, count do
        local tran = self.go_table.obj_itemCard:GetChildE(count - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    if self.pageType == 0 then
        self:ShowItem_reset()
    elseif self.pageType == 1 then
        self:ShowItem_resolve()
    end
end

function CardMaCheView_reset:ShowItem_reset()
    local CardData = self.card
    if CardData == nil then
        return
    end
    local ItemViewBase = require("ItemViewBase")

    local key = require("CardInfoManager"):GetInstance():GetStarCfgId(CardData.cfg.Elements_new, CardData.star)
    ---@type card_star_cfg
    local starCfg = _G.ConfigManager.card_star_cfg[key]

    local oneself = starCfg.reset_oneself
    local materials = starCfg.reset_materials
    --- 获得 升星消耗的卡牌
    local cards = {}
    local cfg = _G.ConfigManager.card_cfg
    if not _G.table.isEmptyOrNil(CardData.cost_card_list) then
        for i = 1, #CardData.cost_card_list do
            local sid = CardData.cost_card_list[i].k
            local v = CardData.cost_card_list[i].v
            for j = 1, v do
                local data = _G.CardData.New()
                local msg = {}
                msg.sid = sid
                msg.star = 6
                data:ParseInitMsg(msg)
                _G.table.insert(cards, data)
            end
        end
        local data = _G.CardData.New()
        local msg = {}
        msg.sid = CardData.sid
        msg.star = 6
        data:ParseInitMsg(msg)
        _G.table.insert(cards, data)
        for i = 1, #cards do
            _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    self.go_table.obj_itemCard,
                    function(item)
                        item:ShowCardData(cards[i], nil, true, true)
                        item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                    end
            )
        end
    end
    ---材料的返回
    local isNotRes = true
    local items = {}
    local len = 0
    if self.needResetLv then
        if len > 0 then
            len = len / 2
            for i = 1, len do
                local num = materials[i * 2]
                if num and num > 0 then
                    table.insert(items, {materials[i], num})
                end
            end
        end
        --升级材料返回
        if CardData.lv_Old > 1 then
            local card_level = _G.ConfigManager.card_level_cfg[CardData.lv_Old]
            local num = 0
            if card_level.exp ~= nil then
                local expid = _G.ResPropID.CardExp
                num = card_level.exp
                table.insert(items, {expid, num})
            end
            if card_level.coin ~= nil then
                local coinid = _G.ResPropID.Coin
                num = card_level.coin
                table.insert(items, {coinid, num})
            end
            if not _G.table.isEmptyOrNil(card_level.material) then
                local materialid = card_level.material[1]
                num = card_level.material[2]
                table.insert(items, {materialid, num})
            end
        end
    end
    --- 魂链 材料返回
    if CardData.soulLink_IsActivate == 1 then
        ---@type card_exclusive_cfg
        local exclusiveCfg = _G.ConfigManager.card_exclusive_cfg[CardData.sid + CardData.soulLink_lv]
        if exclusiveCfg ~= nil then
            materials = exclusiveCfg.material
            len = #materials
            if len > 0 then
                --len = len / 2
                for i = 1, len do
                    local num = materials[i][2]
                    if num and num > 0 then
                        table.insert(items, { materials[i][1], num })
                    end
                end
            end
        end
    end
    if CardData.star >= self.Reset_StarCost then
        ---天赋点返还
        if CardData.inborn_cost_num > 0 then
            local sid = require "TalentModel":GetInstance():MaxMatrialNum()
            _G.table.insert(items, { sid, CardData.inborn_cost_num })
        end
    end
    --觉醒 材料返回
    local potential = CardData:CheckCanPotential() and CardData:GetPotential() or 0
    local potentialCfg = potential > 0 and _G.ConfigManager.card_potential_cfg[potential]
    if potentialCfg then
        --材料消耗
        for _, material in ipairs(potentialCfg.material) do
            _G.table.insert(items, material)
        end
        --本体消耗
        local star, num = table.unpack(potentialCfg.materials_oneself)
        if star and num and num > 0 then
            local tempCard = _G.CardData.New()
            tempCard:ParseInitMsg({ sid = CardData.sid, star = star })
            for i = 1, num do
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    self.go_table.obj_itemCard,
                    function(item)
                        item:ShowCardData(tempCard, nil, true, true)
                        item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                    end
                )
            end
        end
        if _G.AppSetting.IsXzns then
            if not _G.table.isEmptyOrNil(CardData.awaken_cards) then
                local msg
                for _, v in pairs(CardData.awaken_cards) do
                    for i = 1, v.type[2] do
                        local data = _G.CardData.New()
                        msg = {}
                        msg.sid = v.type[1]
                        msg.star = v.type[3]
                        data:ParseInitMsg(msg)
                        _G.ItemCardFactory:GetInstance():GetItemCard(
                            _G.ItemCardFactory.itemCardType.CardAllItem,
                            self.go_table.obj_itemCard,
                            function(item)
                                item:ShowCardData(data, nil, true, true)
                                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                            end
                        )
                    end
                end
            end
        end
    end

    local count = #items
    if count > 0 then
        isNotRes = false
    end
    for i = 1, count do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                items[i],
                self.go_table.obj_item,
                function(mitem)
                    mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                    --self:UpdateLayout()
                end
        )
    end

    for _, v in pairs(CardData.EquipBar) do
        if not table.isEmptyOrNil(v) then
            local key = v.key
            local tran = _G.InstantiateObject(self.go_table.obj_equipment, self.go_table.obj_item)
            if tran then
                local ItemEquipmentBase = require("ItemEquipmentBase").New(tran)
                ItemEquipmentBase:ShowData(v, _G.handlerbind(self, self.EuipmentItemClick, tran, v.sid))
                tran:SetActiveE(1)
                isNotRes = false
            end
        end
    end
    for _, deco_v in pairs(CardData.DecorationBar) do
        if not table.isEmptyOrNil(deco_v) then
            local sid = deco_v.sid
            _G.StorageManager:GetInstance():GetItemBaseView(sid, nil, self.go_table.obj_item)
            isNotRes = false
        end
    end

    local artifact = CardData.ArtifactBar
    if not table.isEmptyOrNil(artifact) then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { artifact.sid },
                self.go_table.obj_item,
                function(item)
                    item:HideCardBound()
                end,
                nil,
                artifact.uid
        )
        isNotRes = false
    end

    -- 饰品
    for _, Spiritual in pairs(CardData.SpiritualBar) do
        if not _G.table.isEmptyOrNil(Spiritual) then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                {Spiritual.sid},
                self.go_table.obj_item
            )
            isNotRes = false
        end
    end

    if isNotRes or not self.card then
        self.go_table.aortext_notres:SetActiveE(1)
    else
        self.go_table.aortext_notres:SetActiveE(0)
    end
end

function CardMaCheView_reset:ShowItem_resolve()
    local Count = table.count(self.SelectIndexDic)
    if Count <= 0 then
        return
    end
    for key, value in pairs(self.SelectIndexDic) do
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, key)
        --_G.StorageManager:GetInstance():GetItemBaseView(card.sid, 1, self.go_table.obj_itemCard, nil)
        _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                self.go_table.obj_itemCard,
                function(item)
                    item:Show(card.sid, nil, card.star, card.soulLink_lv, card.lv, card.uid, true, card.open_inborn)
                end
        )
    end

    ---资源
    local ItemViewBase = require("ItemViewBase")
    local Dic = _G.ConfigManager.discrete_cfg[103701]
    if Dic ~= nil then
        Dic = Dic
    else
        Dic = {}
    end
    local len = #Dic
    for i = 1, len do
        local param = Dic[i]
        if param then
            local num = param[2]
            if num > 0 then
                local sid = param[1]
                num = num * Count
                _G.StorageManager:GetInstance():GetItemBaseView(
                        sid,
                        num,
                        self.go_table.obj_item,
                        function(mitem)
                            mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                        end
                )
            end
        end
    end

    local card_level_cfg = _G.ConfigManager.card_level_cfg
    local res = {}
    res[_G.ResPropID.Coin] = 0
    res[_G.ResPropID.CardExp] = 0

    ---@type CardData
    local cardData, cfgItem, len, key, id, num
    for carduid, _ in pairs(self.SelectIndexDic) do
        cardData = self.itemDatas[self.SelectIndexDic[carduid]]
        if cardData.lv_Old > 1 then
            ---@type card_level_cfg
            cfgItem = card_level_cfg[cardData.lv_Old]
            res[_G.ResPropID.CardExp] = res[_G.ResPropID.CardExp] + cfgItem.exp
            res[_G.ResPropID.Coin] = res[_G.ResPropID.Coin] + cfgItem.coin
            len = #cfgItem.material
            if len >= 2 then
                len = len / 2
                for i = 1, len do
                    key = i * 2
                    id = cfgItem.material[key - 1]
                    num = cfgItem.material[key] or 0
                    if res[id] == nil then
                        res[id] = 0
                    end
                    res[id] = res[id] + num
                end
            end
        end
    end
    for sid, num in pairs(res) do
        if num > 0 then
            _G.StorageManager:GetInstance():GetItemBaseView(
                    sid,
                    num,
                    self.go_table.obj_item,
                    function(mitem)
                        mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                    end
            )
        end
    end
end

function CardMaCheView_reset:Hide()
    base.Hide(self)
end

---选择卡牌后回调
---@param card ItemCardBodySelectView
function CardMaCheView_reset:SelectCallBack(card, indexDic)
    if self.pageType == 0 then
        self.card = card
        self.go_table.obj_plus:SetActiveE(card and 0 or 1)
        -- self.needResetLv = card and require("CardResonanceModel"):GetInstance():CheckReplaceNeedResetLv(self.card.uid) or false
        self.needResetLv = card and card:GetLevel() > 1 or false
    elseif self.pageType == 1 then
        self.itemDatas = card
        self.SelectIndexDic = indexDic
        self.go_table.obj_plus:SetActiveE(1)
    end
    self.go_table.obj_plusTip:SetActiveE(self.pageType == 0 and 1 or 0)

    self:ShowItem()
    self:ShowSelecetLihuiIcon()
end

function CardMaCheView_reset:OnClick_Star_Reset()
    local card = self.card
    if card == nil then
        return
    end

    local isok = self:CheckStorageMax_Equipment({ card })
    if isok == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(460105)
        return
    end

    if not require("ArtifactModel"):GetInstance():CheckEnoughStorageToTakeOffArtifact({ card }, true) then
        return
    end

    if not require("SpiritualModel"):GetInstance():CheckIsEnoughStorageSize({ card }, true) then
        return
    end

    local key = require("CardInfoManager"):GetInstance():GetStarCfgId(card.cfg.Elements_new, card.star)
    ---@type card_star_cfg
    local starCfg = _G.ConfigManager.card_star_cfg[key]

    if starCfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 未找到配置表 card_star_cfg key:" .. key)
        end
        return
    end
    local oneself = starCfg.reset_oneself

    isok = self:CheckStorageMax_Card(oneself[2])
    if isok == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(460106)
        return
    end

    local tipId = 460103
    if card.star >= self.Reset_StarCost then
        if not _G.StorageManager:GetInstance():CheckItemNew(self.resumeCfg[1], self.resumeItemNum) then
            return
        end
        tipId = 460121
    end

    _G.PopWindowManager:ShowAllTips(
            tipId,
            nil,
            function()
                self.awardLis = {}
                ---@param equip EquipmentItem
                for key, equip in pairs(card.EquipBar) do
                    if not _G.table.isEmptyOrNil(equip) then
                        _G.table.insert(self.awardLis, { equip.sid, equip.uid })
                    end
                end
                if not _G.table.isEmptyOrNil(card.ArtifactBar) then
                    table.insert(self.awardLis, { card.ArtifactBar.sid, card.ArtifactBar.uid })
                end
                for i = 1, #card.DecorationBar do
                    if not _G.table.isEmptyOrNil(card.DecorationBar[i].decoration) then
                        _G.table.insert(self.awardLis, { card.DecorationBar[i].decoration.sid, card.DecorationBar[i].decoration.uid })
                        card.DecorationBar[i].decoration:PutCard(0)
                        card.DecorationBar[i].decoration = nil
                    end
                end
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RuneStrength.id, card.uid)
                local consume_cards = { card.uid }
                if not require("CampsiteModel"):GetInstance():CheckInCamp(card) then
                    require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                            consume_cards,
                            function(Refun)
                                self:Start_Reset(consume_cards, Refun)
                            end,
                            function()
                                --_G.PopWindowManager:GetInstance():ShowAllTips(1001, "mache  回退失败 请稍后再试")
                            end,
                            true
                    )
                else
                    --调用营地下阵逻辑
                    require("CampsiteModel"):GetInstance():CardBakeCamp(
                            card,
                            function()
                                require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                                        consume_cards,
                                        function(Refun)
                                            self:Start_Reset(
                                                    consume_cards,
                                                    Refun,
                                                    function()
                                                        require("CampsiteModel"):GetInstance():RefRedPointForReset(card)
                                                    end
                                            )
                                        end,
                                        function()
                                            --_G.PopWindowManager:GetInstance():ShowAllTips(1001, "mache  回退失败 请稍后再试")
                                        end,
                                        true
                                )
                            end
                    )
                end
            end
    )
end

---准备遣散
function CardMaCheView_reset:OnClick_Star_Resolve()
    local cards = {}
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    for _, index in pairs(self.SelectIndexDic) do
        table.insert(cards, self.itemDatas[index])
    end
    if #cards == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(460110)
        return
    end

    local isok = self:CheckStorageMax_Equipment(cards)
    if isok == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(460105)
        return
    end

    if not require("ArtifactModel"):GetInstance():CheckEnoughStorageToTakeOffArtifact(cards, true) then
        return
    end

    if not require("SpiritualModel"):GetInstance():CheckIsEnoughStorageSize(cards, true) then
        return
    end

    _G.PopWindowManager:GetInstance():ShowAllTips(
            460101,
            nil,
            function()
                local consume_cards = table.keys(self.SelectIndexDic)
                require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                        consume_cards,
                        function(Refun)
                            self:Star_resolve(consume_cards, Refun)
                        end,
                        function()
                            -- _G.PopWindowManager:GetInstance():ShowAllTips(1001, "mache  遣散失败 请稍后再试")
                        end
                )
            end
    )
end

function CardMaCheView_reset:Start_Reset(consume_cards, Refun, callback)
    local uid = consume_cards[1]
    require("CardResonanceModel"):GetInstance():CardReset(
        uid,
        function(data, rUid)
            if data.ack ~= 1 then
                --_G.GameUtil.NetAckShowTips(data.ack)
                if Refun then
                    Refun()
                end
                return
            end
            local data = self:ResetEnd(consume_cards, data, callback)
            if self.needResetLv then
                _G.PopWindowManager:ShowAllTips(460122)
                require("CardResonanceModel"):GetInstance():LevelReset(
                    rUid, 
                    function(data1)
                        if data1.ack ~= 1 then
                            self:SelectCallBack()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                                data,
                                nil,
                                nil,
                                nil,
                                nil,
                                nil,
                                nil,
                                nil,
                                true
                            )  
                            return
                        end
                        self:SelectCallBack()
                        _G.StorageManager:GetInstance():ReceiveAwardData(data1)
                        if data1.award ~= nil and data1.award.item ~= nil then
                            if data.award ~= nil and data.award.item ~= nil then
                                _G.table.insertto(data.award.item, data1.award.item)
                            end
                        end
    
                        _G.PlayerPrefsManager.DeleteKey(_G.CardHunLian.CardHunLianSaveKey .. (uid * 10 + 1))
                        require "RedPointManager":GetInstance():RefreshNode(
                            _G.ConfigManager.redpoint_cfg.SoulChain.id,
                            uid * 10 + 1
                        )
                        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                            _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
                        )
                        _G.UIManager:GetInstance():OpenWindow(
