---筛选
function CardMaCheView_selectHero:StarSx()
    ---@param CardData CardData
    self.nowCardList =
        _G.table.chooseToArray(
            self.itemDatas,
            function(_, CardData)
                if self.sx_Elements.data ~= 0 and not require "CardInfoManager":GetInstance():CheckMultiMatch(self.sx_Elements.data , CardData.cfg.Elements_new) then
                    return false
                elseif self.sx_Elements.profData ~= 0 and self.sx_Elements.profData ~= CardData.cfg.Professional then
                    return false
                elseif self.sx_Elements.equipData ~= 0 and self.sx_Elements.equipData ~= CardData.cfg.EquipmentType then
                    return false
                end
                return true
            end
        )
    self:UpdataList(#self.nowCardList)
end

function CardMaCheView_selectHero:OnClick_CardType(index)
    if index == nil or index == self.sx_Elements.data then
        return
    end
    local olddata = self.sx_Elements.data
    self.sx_Elements.data = self.sxEnum.Elements[index]
    ---先筛选
    self:StarSx()
    ---若没有卡
    if #self.nowCardList == 0 then
        ---还原
        self.sx_Elements.data = olddata
        self:StarSx()
        --并弹提示
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
    else
        self.NowSelectCardIndex = 1
        self.cardID = self.nowCardList[1].sid
        self:SureTextRefresh()
        self:InitBtn(true)
    end
end

function CardMaCheView_selectHero:SureTextRefresh()
    if self.cardID == self.GodHaloChooseID then
        self.go_table.aortext_sureText.text = _G.LangUtil.GetLangPackValue(90012500501)
    else
        self.go_table.aortext_sureText.text = _G.LangUtil.GetLangPackValue(90021300006)
    end
end

---@param IsSetOn boolean True检测当前选中 (OnCreate里设置会错位)
function CardMaCheView_selectHero:InitBtn(IsSetOn)
    local obj, showGod
    for i = 0, 6 do
        if self.cardTypeGos[i] == nil then
            obj = self.go_table["obj_type (" .. i .. ")"]
            obj = _G.GetAutoGoTable(obj)
            self.cardTypeGos[i] = obj
        end
        self:btnSet(self.cardTypeGos[i], i, IsSetOn)
        if i == _G.CardElementType.God then
            showGod = _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[106706])
            self.cardTypeGos[i].gameObject:SetActiveE(showGod and 1 or 0)
        end
    end
end

function CardMaCheView_selectHero:btnSet(go_table, cardTypeEnumIndex, IsSetOn)
    if cardTypeEnumIndex ~= nil then
        go_table.aorimage_icon.SpriteName = self.cardTypeEnum.btnIcon[cardTypeEnumIndex]
    end
    if go_table.Click == nil then
        go_table.aorbtn_btn.onClick:AddListener(_G.handlerbind(self, self.OnClick_CardType, cardTypeEnumIndex))
        go_table.Click = true
    end
    if IsSetOn and cardTypeEnumIndex == self.sx_Elements.data then
        self.go_table.aorimage_typeOn:SetPositionByTarget(go_table.gameObject)
    end
end

function CardMaCheView_selectHero:SetAutoShow()
    self.isAuto = not self.isAuto
    require("CardInfoManager").SetPlayerPrefs_CardIsAutoResolve(self.isAuto)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_gou, self.isAuto)
end

--- 一键选择
function CardMaCheView_selectHero:OnClick_All()
    if _G.table.isEmptyOrNil(self.nowCardList) then
        local cont = _G.LangUtil.GetLangPackValue(90024100042)
        _G.FloatTipsModel:GetInstance():Show(cont)
        return
    end
    --- 如果当前有勾选 就全取消
    if table.count(self.SelectIndexDic) > 0 then
        self.SelectIndexDic = {}
        self.showCardlist = {}
        self:UpdataList()
        self.go_table.scrollloopvectical_card:ScrollToIndex(0)
        return
    end
    --- 没有勾选就全勾
    self.SelectIndexDic = {}
    for i = 1, self.MaxSelectCount do
        local card = self.nowCardList[i]
        if card == nil then
            break
        else
            if card.shenshiPosType ~= _G.StonePosType.PosZero then --共鸣神石槽位卡
                _G.PopWindowManager:GetInstance():ShowAllTips(170305)
                return
            end
            self.SelectIndexDic[card.uid] = i
            self.showCardlist[i] = card.uid
        end
    end
    self:UpdataList()

    self.go_table.scrollloopvectical_card:ScrollToIndex(0)
end

