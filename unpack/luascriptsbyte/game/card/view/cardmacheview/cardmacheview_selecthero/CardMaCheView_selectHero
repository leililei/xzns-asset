function CardMaCheView_selectHero:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    index = index + 1

    local func = function()
        local data = self.nowCardList[index]
        if data ~= nil then
            if item.ItemCardHeadSelectView.CardData == nil or item.ItemCardHeadSelectView.CardData.uid ~= data.uid then
                if self.IsLoopInit then
                    data.skinIs = true
                    data.isHave = true
                    item.ItemCardHeadSelectView:ShowCardData(data, _G.handler(self, self.OnClick_CardClick), true, index)
                else
                    _G.DelayDo(
                        index * 0.02,
                        function()
                            data.skinIs = true
                            data.isHave = true
                            item.ItemCardHeadSelectView:ShowCardData(
                                data,
                                _G.handler(self, self.OnClick_CardClick),
                                true,
                                index
                            )
                        end
                    )
                end
            end
            -- local isLv = data.lv_Old > 1
            -- if isLv then
            --     isGou = false
            --     isGray = true
            -- elseif self.NowSelectIndex == index then
            --     isGou = true
            --     isGray = true
            -- end
            if self.pageType == 0 then
                if _G.AppSetting.IsXzns and self.IsGodHaloChoose then
                    item.ItemCardHeadSelectView:SetSelectGou(data.sid == self.GodHaloChooseID)
                    item.ItemCardHeadSelectView:SetSelect(self.NowSelectIndex == index)
                    local tb = _G.GetAutoGoTable(item.gameObject)


                    local WearID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(data.sid)
                    local cfg = _G.ConfigManager.god_halo_cfg[WearID]
                    tb.obj_item:SetActiveE(0)

                    if WearID ~= 0 then
                        tb.obj_item:SetActiveE(1)
                        tb.aorrawimage_icon:LoadImage(cfg.icon)
                        tb.aorimage_bg.SpriteName = _G.EquipItemIconName[cfg.grade]
                    end
                else
                    item.ItemCardHeadSelectView:SetSelectGou(self.NowSelectIndex == index)
                end
            elseif self.pageType == 1 then
                item.ItemCardHeadSelectView:SetSelectGou(self.SelectIndexDic[data.uid] == index)
            end
        end
    end

    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemObjDic[id] = item

        ------@param view ItemCardHeadSelectView
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.HeadItem_Select,
            item.gameObject,
            function(view)
                view.gameObject:SetActiveE(1)
                view.transform:SetLocalPositionToZero()
                view.transform:SetLocalScale(0.75, 0.75, 1)
                item.ItemCardHeadSelectView = view
                view.gameObject:SetSiblingIndexE(0)

                func()
            end
        )
    else
        func()
    end

    return item
end

function CardMaCheView_selectHero:OnClick_CardClick(params)
    local index = params[1]
    local cardData = self.itemDatas[index]
    if cardData == nil then
        return
    end

    if self.pageType == 0 then
        -- if cardData.lv_Old > 1 then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(460107)
        --     return
        -- end
        if self.NowSelectIndex ~= index then
            self.NowSelectIndex = index
        end

        self:UpdataList()
        if _G.AppSetting.IsXzns and self.IsGodHaloChoose then
            self.cardID = self.nowCardList[index].sid

            self:SureTextRefresh()
        end
    elseif self.pageType == 1 then
        if self.SelectIndexDic[cardData.uid] then
            self.SelectIndexDic[cardData.uid] = nil
            self.showCardlist[index] = 0
        else
            if _G.table.count(self.SelectIndexDic) >= self.MaxSelectCount then
                _G.PopWindowManager:GetInstance():ShowAllTips(623) --选择卡牌数量达到上限
                return
            end
            if cardData.shenshiPosType ~= _G.StonePosType.PosZero then --共鸣神石槽位卡
                _G.PopWindowManager:GetInstance():ShowAllTips(170305)
                return
            end
            self.SelectIndexDic[cardData.uid] = index
            self.showCardlist[index] = cardData.uid
            self.showCardlist[index] = cardData.uid
        end
        if _G.table.isEmptyOrNil(self.SelectIndexDic) then
            self.showCardlist = {}
        end
        self.go_table.scrollloopvectical_card:UpdateItemSingle(index - 1)
    end
end

function CardMaCheView_selectHero:SetCardList()
    if self.pageType == 0 then
        local starCfg = _G.ConfigManager.card_star_cfg
        local Dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
        local sidMaxStar = {}

        ---@param CardData CardData
        for uid, CardData in pairs(Dic) do
            ---品质要求
            if CardData.star > self.Reset_StarLowr then
                --- 有回退奖励
                ---@type card_star_cfg
                local mStarCfg = starCfg[require("CardInfoManager"):GetInstance():GetStarCfgId(CardData.cfg.Elements_new, CardData.star)]
                if mStarCfg and (#mStarCfg.reset_oneself > 0 or #mStarCfg.reset_materials > 0) then
                    local sids = sidMaxStar[CardData.sid]
                    if sids == nil then
                        sids = {}
                        sidMaxStar[CardData.sid] = sids
                    end
                    if self.ElementsType == 0 then
                        table.insert(sids, CardData)
                    elseif require "CardInfoManager":GetInstance():CheckMultiMatch(self.ElementsType , CardData.cfg.Elements_new) then
                        table.insert(sids, CardData)
                    end
                end
            end
        end

        local carddatas = {}
        for sid, cards in pairs(sidMaxStar) do
            ---数量要求
            if #cards < 1 then
                sidMaxStar[sid] = nil
            else
                ---@param a CardData
                _G.SortList(
                    cards,
                    function(a)
                        return a.star, a.power, a.uid
                    end
                )
                -- --- 有且仅有一个最高星 不显示
                -- if cards[1].star > cards[2].star then
                --     table.remove(cards, 1)
                -- end
                _G.table.insertto(carddatas, cards)
            end
        end
        ---@type CardData[]
        ---@param v CardData
        self.itemDatas =
            table.chooseToArray(
                carddatas,
                function(k, v)
                    local isok = true
                    ---  升级过不显示
                    -- if v.lv_Old > 1 then
                    --     isok = false
                    -- end
                    return isok
                end
            )

        if _G.AppSetting.IsXzns and self.IsGodHaloChoose then
            self.itemDatas = {}
            local DicCard = {}
            for key, value in pairs(Dic) do
                if DicCard[value.sid] == nil then
                    DicCard[value.sid] = value
                end

                if value.star > DicCard[value.sid].star then
                    DicCard[value.sid] = value
                end
            end

            for key, value in pairs(DicCard) do
                if self.ElementsType == 0 then
                    _G.table.insert(self.itemDatas, value)
                elseif self.ElementsType == value.cfg.Elements then
                    _G.table.insert(self.itemDatas, value)
                end
            end
        end
    elseif self.pageType == 1 then
        -- 当前选中的卡  [uid=index]
        self.SelectIndexDic = {}
        self.itemDatas = {}
        local Dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
        ---@type CardData[]
        ---@param v CardData
        for key, value in pairs(Dic) do
            if value.Grade <= self.resolveCfg_grade then
                if self.ElementsType == 0 then
                    _G.table.insert(self.itemDatas, value)
                elseif require "CardInfoManager":GetInstance():CheckMultiMatch(self.ElementsType , value.cfg.Elements_new) then
                    _G.table.insert(self.itemDatas, value)
                end
            end
        end

        -- self.itemDatas =
        --     table.chooseToArray(
        --     Dic,
        --     function(k, v)
        --         return v.Grade <= self.resolveCfg_grade
        --         -- v.lv_Old > 1
        --     end
        -- )
        ---@param v CardData
        _G.SortList(
            self.itemDatas,
            function(v)
                return v.lv_Old, v.uid
            end
        )
    end

    self.nowCardList = self.nowCardList or self.itemDatas

    if _G.AppSetting.IsXzns and self.IsGodHaloChoose then
        _G.SortList(
            self.nowCardList,
            function(a)
                return a.Grade, a.power, a.uid
            end
        )

        if self.cardID == 0 then
            self.cardID = self.nowCardList[1] and self.nowCardList[1].cfg.id or 0
        end
        self:SureTextRefresh()
    end

    local count = #self.nowCardList
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_null, count == 0)
    self:UpdataList(count)
    self.IsLoopInit = true
end

function CardMaCheView_selectHero:UpdataList(Count)
    if Count ~= nil then
        self.go_table.scrollloopvectical_card:UpdateCount(Count)
    else
        self.go_table.scrollloopvectical_card:UpdateAllItem()
    end
end

function CardMaCheView_selectHero:CloseView()
    self:Close()
end

---@private
function CardMaCheView_selectHero:ChangeProfListType(index)
    if index == nil then
        return
    end
    if index == self.sx_Elements.profData then
        self.sx_Elements.profData = profType.None
        self.NowSelectCardIndex = 1
        self:StarSx()
        self.go_table.trans_pChoose:SetPositionByTarget(self.profBtns[profType.None + 1])
        return
    end
    local olddata = self.sx_Elements.profData
    self.sx_Elements.profData = index
    self:StarSx()
    if #self.nowCardList == 0 then
        self.sx_Elements.profData = olddata
        self:StarSx()
        --并弹提示
        _G.PopWindowManager:GetInstance():ShowAllTips(self.profNilTips[index])
    else
        self.NowSelectCardIndex = 1
        self.go_table.trans_pChoose:SetPositionByTarget(self.profBtns[index + 1])
    end
end

