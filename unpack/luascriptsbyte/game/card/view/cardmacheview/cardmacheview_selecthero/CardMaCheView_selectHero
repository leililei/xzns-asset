        self.go_table.aorbtn_pTK, --1
        self.go_table.aorbtn_pZS, --2
        self.go_table.aorbtn_pFS, --3
        self.go_table.aorbtn_pFZ, --4
        self.go_table.aorbtn_pYX  --5
