function CardMaCheView_resetLevel:StarSure(CardData)
    self:UnEquip(
        CardData,
        function(equipAwards)
            if equipAwards == nil then
                return
            end
            require("CardResonanceModel"):GetInstance():LevelReset(
                CardData.uid,
                function(data)
                    if data.ack ~= 1 then
                        --_G.GameUtil.NetAckShowTips(data.ack)
                        return
                    end
                    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Lh_icon, false)
                    self:SetisUpdataList(true)
                    if data.award ~= nil then
                        if data.award.item ~= nil then
                            --- 解析奖励
                            _G.StorageManager:GetInstance():ReceiveAwardData(data)
                            table.insertto(data.award.item, equipAwards)
                            local mainCards = {}
                            --饰品
                            for key, value in pairs(self.decoration) do
                                local award1 = {value[1], value[2]}
                                table.insert(mainCards, {type = award1})
                            end
                            table.insertto(data.award.item, mainCards)
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        end
                    end
                    self.NowSelectIndex = nil
                    self:Show()
                    _G.PlayerPrefsManager.DeleteKey(_G.CardHunLian.CardHunLianSaveKey .. (CardData.uid * 10 + 1))
                    require "RedPointManager":GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.SoulChain.id,
                        CardData.uid * 10 + 1
                    )
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
                    )
                    --require("CardInfoManager"):GetInstance():UpLevelRedPointEquipMent(CardData)
                end
            )
        end
    )
end

---@param CardData CardData
function CardMaCheView_resetLevel:ShowItem(CardData)
    local lv = CardData.lv_Old
    ---@type card_level_cfg
    local cfg = _G.ConfigManager.card_level_cfg[lv]
    if cfg == nil then
        return
    end

    local ItemViewBase = require("ItemViewBase")

    local count = self.go_table.obj_item:GetChildCountE()
    for i = 1, count do
        local tran = self.go_table.obj_item:GetChildE(count - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    local expNum = cfg.exp
    if expNum > 0 then
        local exp = _G.ResPropID.CardExp
        _G.StorageManager:GetInstance():GetItemBaseView(
            exp,
            expNum,
            self.go_table.obj_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            end
        )
    end

    local coinNum = cfg.coin
    if coinNum > 0 then
        local coin = _G.ResPropID.Coin
        _G.StorageManager:GetInstance():GetItemBaseView(
            coin,
            coinNum,
            self.go_table.obj_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            end
        )
    end

    local len = #cfg.material
    if len >= 2 then
        len = len / 2
        for i = 1, len do
            local mIndex = i * 2
            local num = cfg.material[mIndex]
            if num and num > 0 then
                local sid = cfg.material[mIndex - 1]
                _G.StorageManager:GetInstance():GetItemBaseView(
                    sid,
                    num,
                    self.go_table.obj_item,
                    function(mitem)
                        mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                    end
                )
            end
        end
    end

    local cardataEqu = {}
    for _, v in pairs(CardData.EquipBar) do
        if not table.isEmptyOrNil(v) then
            local key = v.key
            local tran = _G.InstantiateObject(self.go_table.obj_equipment, self.go_table.obj_item)
            if tran then
                local ItemEquipmentBase = require("ItemEquipmentBase").New(tran)
                ItemEquipmentBase:ShowData(v, _G.handlerbind(self, self.EuipmentItemClick, tran, v.sid))
                tran:SetActiveE(1)
            end
        end
    end
    for _, deco_v in pairs(CardData.DecorationBar) do
        if not table.isEmptyOrNil(deco_v) then
            local sid = deco_v.sid
            _G.StorageManager:GetInstance():GetItemBaseView(sid, nil, self.go_table.obj_item)
        end
    end

    local artifact = CardData.ArtifactBar
    if not table.isEmptyOrNil(artifact) then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            {artifact.sid},
            self.go_table.obj_item,
            function(item)
                item:HideCardBound()
            end,
            nil,
            artifact.uid
        )
    end
end
