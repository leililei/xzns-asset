end
---展示 卡牌的选择的 卡牌立绘
function CardMaCheView_resetLevel:ShowSelecetLihuiIcon()
    local card = self.itemDatas[self.NowSelectIndex] or {}
    if _G.table.isEmptyOrNil(card) then
        self:ShorOrHideNothing(true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Lh_icon, false)
        return
    end
    local cardS
    if card.skin and card.skin ~= 0 then
        cardS = require "CardCommentManager":GetInstance():CardData(card.skin, true)
    else
        cardS = require "CardCommentManager":GetInstance():CardData(card.sid, false)
    end

    local lihui_image = cardS.Portrait
    local pos = cardS.pos_portrait1
    local scale = cardS.size3 or 0.7
    self.go_table.aorrawimage_Lh_icon:LoadImage(
        lihui_image,
        function(item)
            _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Lh_icon, true)
            item:SetLocalPosition((pos[1] or 0) - 230, pos[2] or 0, pos[3] or 0)
            item:SetLocalScale(scale * 0.9, scale * 0.9, scale * 0.9)
            self.go_table.aorrawimage_Lh_icon:SetNativeSize()
        end
    )
end
---默认 夏玲 (没有可以选择的卡牌 显示)
function CardMaCheView_resetLevel:ShorOrHideNothing(isShow)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothing, isShow)
end
function CardMaCheView_resetLevel:SetCardList()
    local Dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)

    ---@type CardData[]
    ---@param v CardData
    self.itemDatas = {}
    for key, value in pairs(Dic) do
        if value.lv_Old > 1 then
            if self.ElementsType == 0 then
                _G.table.insert(self.itemDatas, value)
            elseif require "CardInfoManager":GetInstance():CheckMultiMatch(self.ElementsType , value.cfg.Elements_new) then
                _G.table.insert(self.itemDatas, value)
            end
        end
    end
    ---@param v CardData
    _G.SortList(
        self.itemDatas,
        function(v)
            return v.lv_Old, v.uid
        end
    )
    local count = #self.itemDatas
    if count == 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothingCard, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothingCard, false)
    end
    self:UpdataList(count)

    self.IsLoopInit = true
end

function CardMaCheView_resetLevel:UpdataList(Count)
    local ChildCount = self.go_table.obj_item:GetChildCountE()
    for i = 1, ChildCount do
        local tran = self.go_table.obj_item:GetChildE(ChildCount - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    if self.NowSelectIndex ~= nil then
        local CardData = self.itemDatas[self.NowSelectIndex]
        self:ShowItem(CardData)
    end
    self.go_table.obj_hide:SetActiveE(self.NowSelectIndex ~= nil and 1 or 0)
    if Count ~= nil then
        -- if Count < 25 then
        --     Count = 25
        -- end
        self.go_table.scrollloopvectical_card:UpdateCount(Count)
    else
        self.go_table.scrollloopvectical_card:UpdateAllItem()
    end
end

function CardMaCheView_resetLevel:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    index = index + 1
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemObjDic[id] = item
        item.lua_ItemCardAllView = require("ItemCardBodySelectView").New(item.obj_card)
    end
    local data = self.itemDatas[index]
    if data ~= nil then
        if item.lua_ItemCardAllView.CardData == nil or item.lua_ItemCardAllView.CardData.uid ~= data.uid then
            item.obj_card:SetActiveE(0)
            if self.IsLoopInit then
                item.obj_card:SetActiveE(1)
                item.lua_ItemCardAllView:ShowCardData(data, _G.handler(self, self.OnClick_CardClick), true, index)
            else
                _G.DelayDo(
                    index * 0.02,
                    function()
                        item.obj_card:SetActiveE(1)
                        item.lua_ItemCardAllView:ShowCardData(
                            data,
                            _G.handler(self, self.OnClick_CardClick),
                            true,
                            index
                        )
                    end
                )
            end
        end
    end
    item.aorimage_Selected:SetActiveE(self.NowSelectIndex == index and 1 or 0)
    item.obj_card:SetActiveE(data ~= nil and 1 or 0)
    return item
end

