    local index = params[1]

    if self.NowSelectIndex == index then
        self.NowSelectIndex = nil
        self:ShorOrHideNothing(true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_Lh_icon, false)
    else
        local CardData = self.itemDatas[index]
        --self.Lua_CardL:ShowCardData(CardData)
        ---@type CardData
        local CardData_lvOne = _G.DeepCopy(CardData)
        CardData_lvOne.uid = 101 ---防止显示共鸣等级
        CardData_lvOne.lv = 1
        CardData_lvOne.lv_Old = 1
        --self.Lua_CardR:ShowCardData(CardData_lvOne)
        self.NowSelectIndex = index
        self:ShorOrHideNothing(false)
        self:ShowSelecetLihuiIcon()
    end
    self:UpdataList()
end

