function CardMaCheView_exchange:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    index = index + 1
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemObjDic[id] = item
        item.lua_ItemCardAllView = require("ItemCardBodySelectView").New(item.obj_card)
    end

    local isGou = false
    local isGray = false

    local data = self.curItemDatas[index]
    local isNil = data == nil
    if isNil == false then
        if item.lua_ItemCardAllView.CardData == nil or item.lua_ItemCardAllView.CardData.uid ~= data.uid then
            item.obj_card:SetActiveE(0)
            if self.IsLoopInit then
                item.obj_card:SetActiveE(1)
                data.skinIs = true
                item.lua_ItemCardAllView:ShowCardData(data, _G.handler(self, self.OnClick_CardClick), true, index)
            else
                _G.DelayDo(
                    index * 0.02,
                    function()
                        item.obj_card:SetActiveE(1)
                        data.skinIs = true
                        item.lua_ItemCardAllView:ShowCardData(
                            data,
                            _G.handler(self, self.OnClick_CardClick),
                            true,
                            index
                        )
                    end
                )
            end
        end
        if self.SelectIndexDic[data.uid] then
            isGou = true
            isGray = true
        elseif not self:CheckStar(data.cfg.Elements, data.star) then
            --- 升星过 不可选
            isGou = false
            isGray = true
        elseif data.lv_Old > 1 then
            --- 升级过 不可选
            isGou = false
            isGray = true
        end
    end
    item.obj_card:SetActiveE(isNil == false and 1 or 0)
    item.aorimage_gou:SetActiveE(isGou and 1 or 0)
    item.aorimage_Selected:SetActiveE(isGray and 1 or 0)
    return item
end

function CardMaCheView_exchange:OnItemCall_Exchange(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    index = index + 1
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.itemObjDic[id] = item
        item.lua_ItemCardAllView = require("ItemCardBodyBaseView").New(item.obj_card)
    end
    local sid = self.itemDatasSids_Exchange[index]
    if item.lua_ItemCardAllView.CardData == nil or item.lua_ItemCardAllView.CardData.sid ~= sid then
        local star = _G.ConfigManager.card_cfg[sid].Star
        local params = {}
        params.sid = sid
        params.star = star
        params.lv = 1
        params.showSoulTalent = true
        item.lua_ItemCardAllView:Show(params, _G.handler(self, self.OnClick_CardClick_Exchange), index)
    end
    item.aorimage_Selected:SetActiveE(self.SelectSid_Exchange == sid and 1 or 0)
    return item
end

---展示所选中的 卡牌
function CardMaCheView_exchange:ShowCardItem()
    local card = {}
    local element
    if self.SelectSid_Exchange ~= nil then
        local cfg = _G.ConfigManager.card_cfg[self.SelectSid_Exchange]
        ---@type CardData
        local data = _G.CardData.New()
        local msg = {}
        msg.sid = self.SelectSid_Exchange
        msg.star = cfg.Star
        msg.lv = 1
        data:ParseInitMsg(msg)
        card = data
        self.subCardCount = self:GetNeedCount(card.cfg.Elements)
        element = cfg.Elements
    end

    local item = self.go_table.obj_card
    if self.itemCardobj == nil then
        self.itemCardobj = require("ItemCardAllView").New(self.go_table.obj_card)
    end
    if not _G.table.isEmptyOrNil(card) then
        self.itemCardobj.gameObject:SetActiveE(1)
        self.itemCardobj:ShowCardData(card, nil, true, true)
    else
        --self.itemCardobj:SetActiveE(0)
        self.go_table.obj_card:SetActiveE(0)
    end
    if element and element == _G.CardElementType.God then
        self.curItemDatas =
            _G.table.chooseToArray(
                self.itemDatas,
                function(k, v)
                    return v.cfg.Elements == element
                end
            )
    else
        self.curItemDatas = self.itemDatas
    end
    self:UpdataList(#self.curItemDatas)
end

---@param CardData CardData
function CardMaCheView_exchange:ShowItem()
    if self.SelectCard_LuaArr == nil then
        ---@type ItemCardAllView[]
        self.SelectCard_LuaArr = {}
    end
    local indexS = table.values(self.SelectIndexDic)
    local Count = #indexS

    local len = #self.SelectCard_LuaArr > Count and #self.SelectCard_LuaArr or Count
    for i = 1, len do
        local luaCard = self.SelectCard_LuaArr[i]
        local CardData = self.curItemDatas[indexS[i]]
        if i > Count then
            if luaCard ~= nil then
                luaCard.gameObject:SetActiveE(0)
            end
        else
            if luaCard == nil then
                local tran = _G.InstantiateObject(self.go_table.obj_cardItem, self.go_table.obj_itemCost)
                luaCard = require("ItemCardAllView").New(tran)
                self.SelectCard_LuaArr[i] = luaCard
            end
            luaCard.gameObject:SetActiveE(1)
            CardData.skinIs = true
            luaCard:ShowCardData(CardData, _G.handler(self, self.OnClick_SubCardClick), true, true, CardData.uid)
        end
    end
end

