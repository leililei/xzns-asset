function CardMaCheView_exchange:SetCardList()
    ---达到最高星的卡 不显示在可换卡里
    self.MaxStarDic = {}
    self.SelectIndexDic = {}
    --- 当前选中 想换取到的神卡
    self.SelectSid_Exchange = nil
    -- self.itemDatasSids_Exchange[1]   默认第一张
    self.itemDatasSids_Exchange = {}
    local starCfg = _G.ConfigManager.card_star_cfg
    local cardCfg = _G.ConfigManager.card_cfg
    local Dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    --{ sid=[card,card]}
    local sidMaxStar = {}
    --作为材料卡牌在此处更改
    ---@param CardData CardData
    for uid, CardData in pairs(Dic) do
        local sids = sidMaxStar[CardData.sid]
        if sids == nil then
            sids = {}
            sidMaxStar[CardData.sid] = sids
        end
        table.insert(sids, CardData)
    end

    local carddatas = {}
    local isMaxStar
    for sid, cards in pairs(sidMaxStar) do
        isMaxStar = false
        _G.SortList(
            cards,
            function(a)
                return a.star
            end
        )
        --- 有一个达到最高星 就不显示可置换
        if #cards > 0 and cards[1].star >= self.subCardMaxStar then
            self.MaxStarDic[cards[1].sid] = true
            isMaxStar = true
        end
        ---数量要求
        if #cards <= 1 then
            sidMaxStar[sid] = nil
        else
            ---@param a CardData
            _G.SortList(
                cards,
                function(a)
                    return a.star, a.power, a.uid
                end
            )

            --- 要有一个达到最高星
            if isMaxStar then
                --- 最高星 不显示
                table.remove(cards, 1)
                _G.table.insertto(carddatas, cards)
            end
        end
    end

    ---@type CardData[]
    ---@param v CardData
    self.itemDatas =
        table.chooseToArray(
            carddatas,
            function(k, v)
                local isok = true
                if not self:CheckStar(v.cfg.Elements, v.star) or v.lv_Old > 1 then
                    isok = false
                end
                return isok
            end
        )
    _G.SortList(
        self.itemDatas,
        function(a)
            return a.cfg.Elements, -a.star, a.power
        end
    )
    self.curItemDatas = self.itemDatas

    --- 可置换神卡 [sid,sid,sid...]
    ---@param exchange CardData
    self.itemDatasSids_Exchange = {}
    for key, sid in pairs(self.CfgexchangeArr) do
        ---不显示已达到最高星的卡
        if self.MaxStarDic[sid] ~= true and not self.CanUpMaxStartList[sid] then
            if self.ElementsType == 0 then
                table.insert(self.itemDatasSids_Exchange, sid)
            elseif self.ElementsType == cardCfg[sid].Elements then
                table.insert(self.itemDatasSids_Exchange, sid)
            end
        end
    end
    local count = #self.curItemDatas
    if count == 0 then
        --self.go_table.obj_Des:SetActiveE(0)
        --self.go_table.obj_costCardBg:SetActiveE(0)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothingCard, true)
    else
        --self.go_table.obj_Des:SetActiveE(1)
        --self.go_table.obj_costCardBg:SetActiveE(1)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothingCard, false)
    end
    self:UpdataList(count)

    self:UpdataList_Exchange(#self.itemDatasSids_Exchange)
    self.IsLoopInit = true
    self:ShowItem()
end

