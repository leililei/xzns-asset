function CardMaCheView_exchange:OnClick_CardClick(params)
    local index = params[1]
    local cardData = self.curItemDatas[index]
    if cardData == nil then
        return
    end
    if #self.itemDatasSids_Exchange == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(460111)
        return
    end
    if not self:CheckStar(cardData.cfg.Elements, cardData.star) then
        --- 升星过 不可选
        _G.PopWindowManager:GetInstance():ShowAllTips(460108)
        return
    elseif cardData.lv_Old > 1 then
        --- 升级过 不可选
        _G.PopWindowManager:GetInstance():ShowAllTips(460107)
        return
    end
    if self.SelectSid_Exchange == nil then
        _G.PopWindowManager:GetInstance():ShowAllTips(460112)
        return
    end
    if self.SelectIndexDic[cardData.uid] then
        self.SelectIndexDic[cardData.uid] = nil
    else
        if table.count(self.SelectIndexDic) >= self.subCardCount then
            _G.PopWindowManager:GetInstance():ShowAllTips(460118)
            return
        end
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(cardData.cfg.Elements_new , 6) and cardData.star == 6 and not isEmptyOrNil(self.SelectIndexDic) then
            _G.PopWindowManager:GetInstance():ShowAllTips(460120)
            return
        end
        self.SelectIndexDic[cardData.uid] = index
    end
    if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(cardData.cfg.Elements_new, 6) and cardData.star == 6 then
        local isActive = self.go_table.obj_costCardBg:GetActiveSelf()
        self:ChangeCostCount(isActive ~= 1)
    end
    -- if _G.table.isEmptyOrNil(self.SelectIndexDic) then
    --     _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_select, true)
    -- else
    --     _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_select, false)
    -- end
    self:UpdataList()
    self:ShowItem()
end

function CardMaCheView_exchange:OnClick_CardClick_Exchange(params)
    local index = params[1]
    local sid = self.itemDatasSids_Exchange[index]
    if sid == nil then
        return
    end
    if self.SelectSid_Exchange == nil or self.SelectSid_Exchange ~= sid then
        self.SelectSid_Exchange = sid
    else
        self.SelectSid_Exchange = nil
    end
    -- body
    self:UpdataList_Exchange()
end

