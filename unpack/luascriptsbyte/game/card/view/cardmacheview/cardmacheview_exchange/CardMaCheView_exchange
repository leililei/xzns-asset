function CardMaCheView_exchange:OnClick_Ready()
    if self.SelectSid_Exchange == nil then
        --请选择想得到的神卡
        _G.PopWindowManager:GetInstance():ShowAllTips(260101)
        return
    end
    local cards = {}
    for _, index in pairs(self.SelectIndexDic) do
        table.insert(cards, self.itemDatas[index])
    end

    local isok = self:CheckStorageMax_Equipment(cards)
    if isok == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(460105)
        return
    end

    if not require("ArtifactModel"):GetInstance():CheckEnoughStorageToTakeOffArtifact(cards, true) then
        return
    end

    if not require("SpiritualModel"):GetInstance():CheckIsEnoughStorageSize(cards, true) then
        return
    end

    _G.PopWindowManager:ShowAllTips(
        460104,
        nil,
        function()
            local consume_cards = table.keys(self.SelectIndexDic)
            require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
                consume_cards,
                function(Refun)
                    self:Star_exchange(consume_cards, Refun)
                end,
                function()
                    --_G.PopWindowManager:GetInstance():ShowAllTips(1001, "mache  置换失败 请稍后再试")
                    return
                end
            )
        end
    )
end

---判断置换的卡和消耗卡片的类型是否符合
---@param Sid1 number 消耗第一张卡牌的sid
---@param Sid2 number 消耗第二张卡牌的sid
---@param needSid number 目标卡牌的sid
---@return boolean
function CardMaCheView_exchange:CheckType(Sid1, Sid2, needSid)
    local cfg = _G.ConfigManager.card_cfg
    local element1 = cfg[Sid1].Elements
    local element2 = 0
    if Sid2 ~= 0 then
        element2 = cfg[Sid2].Elements
    end
    local elementNeed = cfg[needSid].Elements
    if self.subCardCount > 1 then
        if elementNeed == 6 and (element1 ~= 6 or element2 ~= 6) then
            _G.PopWindowManager:GetInstance():ShowAllTips(460114)
            return false
        end
    else
        if elementNeed == 6 and (element1 ~= 6 and element2 ~= 6) then
            _G.PopWindowManager:GetInstance():ShowAllTips(460114)
            return false
        end
    end
    return true
end

---开始 置换
function CardMaCheView_exchange:Star_exchange(consume_cards, Refun)
    ---@type card.c2s_card_exchange
    local pbdata = {}
    pbdata.uids = consume_cards
    pbdata.sid = self.SelectSid_Exchange
    if #pbdata.uids < self.subCardCount then
        _G.PopWindowManager:GetInstance():ShowAllTips(460115)
        return
    end
    local exchangeSid1 = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, pbdata.uids[1])
    local exchangeSid2 = {sid = 0}
    if pbdata.uids[2] then
        exchangeSid2 = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, pbdata.uids[2])
    end
    local isContinue = self:CheckType(exchangeSid1.sid, exchangeSid2.sid, pbdata.sid)
    if isContinue then
        require("CardInfoNet"):GetInstance():CardExchange(
            pbdata,
            function(data)
                if data.ack ~= 1 then
                    --_G.GameUtil.NetAckShowTips(data.ack)
                    if Refun then
                        Refun()
                    end
                    -- if #pbdata.uids == 2 then
                    --     _G.PopWindowManager:GetInstance():ShowAllTips(460114)
                    -- else
                    --     _G.PopWindowManager:GetInstance():ShowAllTips(460115)
                    -- end
                    return
                end
    
                self:SetisUpdataList(true)
                self:ChangeCostCount(true)
                --_G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_select, true)
                require("CardInfoManager"):GetInstance():CardNewStartDestroy(consume_cards)
                if data.award ~= nil and data.award.item ~= nil then
                    --- 解析奖励
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                end
                for _, carduid in ipairs(consume_cards) do
                    _G.StorageManager:GetInstance():DelCard(carduid)
                end
                self.SelectSid_Exchange = nil
                -- if self.SelectSid_Exchange == nil then
                --     self:ShorOrHideNothing(true)
                -- else
                --     self:ShorOrHideNothing(false)
                -- end
                require("CardInheritModel"):GetInstance():CheckInheritBuffLock()
                self.CanUpMaxStartList = require "CardInfoManager":GetInstance():GetCanMaxStartOfSidList() or {}
                self:Show()
                --self:ShowSelecetLihuiIcon()
            end
        )
    else
        return
    end
