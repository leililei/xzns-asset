        [self.go_table.aorbtn_SelectCard:GetName()] = self.ShowSelectCardView,
        [self.go_table.aorbtn_close_select:GetName()] = self.CloseViewSelectCardView,
        [self.go_table.aorbtn_exit:GetName()] = self.CloseViewSelectCardView,
        [self.go_table.aorbtn_queding:GetName()] = self.CloseViewSelectCardView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end,
        ["$_toggle_all"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 0
                self:RefreshView()
            end
        end,
        ["$_toggle_shen"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 6
                self:RefreshView()
            end
        end,
        ["$_toggle_feng"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 2
                self:RefreshView()
            end
        end,
        ["$_toggle_lei"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 1
                self:RefreshView()
            end
        end,
        ["$_toggle_shui"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 3
                self:RefreshView()
            end
        end,
        ["$_toggle_huo"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 4
                self:RefreshView()
            end
        end,
        ["$_toggle_tu"] = function(obj, go, isOn)
            if isOn then
                self.ElementsType = 5
                self:RefreshView()
            end
        end
    }
    self.go_table.scrollloopvectical_card:InitItemData(0, _G.handler(self, self.OnItemCall))
    discrete_cfg = _G.ConfigManager.discrete_cfg
    self.CfgexchangeArr = discrete_cfg[103706][1]
    self.go_table.scrollloopvectical_Exchange:InitItemData(0, _G.handler(self, self.OnItemCall_Exchange))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_SelectCard_Panel, false)
    --- 需要消耗神卡数量  3
    self.subCardCount = 2
    --- 达到指定星级 溢出的才可兑换 15
    self.subCardMaxStar = discrete_cfg[103704][1][1]
    self.itemCardobj = nil
    self.elementStarTb = {}
    for k, v in pairs(discreteId) do
        local tempTb = {}
        for index, v1 in pairs(discrete_cfg[v]) do
            if #v1 > 3 then
                tempTb[index] = {}
                for i = 1, #v1, 3 do
                    _G.table.insert(tempTb[index], { v1[i], v1[i + 1], v1[i + 2] })
                end
            else
                tempTb[index] = v1
            end
        end
        self.elementStarTb[k] = tempTb
    end
    local isRun, data =
        pcall(require "CardInfoManager":GetInstance().GetCanMaxStartOfSidList, require "CardInfoManager":GetInstance())
    if isRun then
        self.CanUpMaxStartList = data
    else
        LogError(data)
    end
end

---检测星级是否满足
---@param element number 卡牌对应的五行
---@param star number 卡牌的星级
---@return boolean
function CardMaCheView_exchange:CheckStar(element, star)
    local data = self.elementStarTb[element] or self.elementStarTb[1]
    if not data then
        return false
    end

    local type = element == 6 and element or 0
    for _, v in pairs(data) do
        if _G.type(v[2]) == "number" then
            if v[2] == star and v[1] == type then
                return true
            end
        else
            for _, cond in ipairs(v) do
                if cond[2] == star and v[1] == type then
                    return true
                end
            end
        end
    end
    return false
end

---获取星级对应的数量
function CardMaCheView_exchange:GetNeedCount(element)
    local data = self.elementStarTb[element] or self.elementStarTb[1]
    for _, v in pairs(data) do
        if _G.type(v[2]) == "number" then
            if v[1] == element then
                return v[3]
            end
        else
            local total = 0
            local haveElement = false
            for _, cond in ipairs(v) do
                total = total + cond[3]
                if cond[1] == element then
                    haveElement = true
                end
            end
            if haveElement then
                return total
            end
        end
    end
    return 2
end

