---切换消耗数量
---@field isShow boolean 是否显示消耗背景
function CardMaCheView_exchange:ChangeCostCount(isShow)
    if isShow then
        self.go_table.obj_costCardBg:SetActiveE(1)
        self.subCardCount = 2
        self.go_table.obj_itemCost:SetLocalPosition(-68, 3, 0)
    else
        self.go_table.obj_costCardBg:SetActiveE(0)
        self.subCardCount = 1
        self.go_table.obj_itemCost:SetLocalPosition(-10, 3, 0)
    end
end

return CardMaCheView_exchange
