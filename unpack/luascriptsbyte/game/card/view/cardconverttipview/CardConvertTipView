---@class CardConvertTipView : UIBaseView    卡牌转化tip
---@field go_table CardConvertTipView_GoTable
---@field time number   @倒计时时间
---@field timer Timer
local CardConvertTipView = _G.BaseClass("CardConvertTipView", _G.UIBaseView)

function CardConvertTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function CardConvertTipView:OnCreate()
    self.time = 60

    self:UpdateView()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateView, self, false, false)
    self.timer:Start()
end

function CardConvertTipView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function CardConvertTipView:UpdateView()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90034300012, self.time)
    self.time = self.time - 1
    if self.time < 0 then
        self:Close()
    end
end

---按钮点击事件在这里派发
function CardConvertTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_open then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardConvertView.Name)
        self:Close()
    end
end

return CardConvertTipView
