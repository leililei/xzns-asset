---@class CardSelectListView : UIBaseView	中文描述
---@field public go_table CardSelectListView_GoTable GoTable
local CardSelectListView = _G.BaseClass("CardSelectListView", _G.UIBaseView)
--_G.CardSelectListView = CardSelectListView

function CardSelectListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.Close,
        --- 确定
        ["@_aorbtn_1"] = self.OnClick_sure,
        ["nilFnc"] = function(_, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.go_table.scrollloopvectical_card:InitItemData(0, _G.handler(self, self.OnCardCreateCall))
    self.itemTransLuaDic = {}
    ---@type CardData[]
    self.CardList = {}
end

---@field selected number[] 已选中的卡uid
---@field ignore number[] 忽略的卡uid
---@field maxCount number 最大选中数量
---@field okFun function 选中的uid列表 fun(selected )
---@field updataFun function 当前选中数量 更新 fun(selectedCount,CardData)
---@field filterFun function 筛选规则 fun(uid,CardData)==true
---@class params_CardSelectListView Data

---界面的入口函数
---@param  Data params_CardSelectListView
function CardSelectListView:OnCreate(Data)
    ---@type table<uid,boolean>
    self.IgnoreDic = {}
    ---@type table<uid,boolean>
    self.selected = {}
    ---旧选中 (关闭界面 就不改)
    ---@type uid[]
    self.selectedOld = {}
    self.okFun = nil
    self.updataFun = nil
    self.filterFun = nil
    self.maxCount = 10
    if Data ~= nil then
        local ignore = Data.ignore or {}
        for i = 1, #ignore do
            self.IgnoreDic[ignore[i]] = true
        end

        if Data.selected ~= nil then
            self.selectedOld = Data.selected
            for i = 1, #self.selectedOld do
                self.selected[self.selectedOld[i]] = true
            end
        end

        if Data.maxCount ~= nil then
            self.maxCount = Data.maxCount
        end

        self.okFun = Data.okFun
        self.updataFun = Data.updataFun
        self.filterFun = Data.filterFun
    end

    self:SetData(Data)
end
---@param  Data params_CardSelectListView
function CardSelectListView:SetData()
    self:UpdataLoopList()
end
function CardSelectListView:UpdataLoopList()
    self.CardList = self:SetCardList()
    self.go_table.scrollloopvectical_card:UpdateCount(#self.CardList)
    self.go_table.obj_nilTips:SetActiveE(#self.CardList == 0 and 1 or 0)
end
function CardSelectListView:OnCardCreateCall(index, obj)
    local id = obj:GetInstanceID()
    ---@type ItemCardAllView
    local item = self.itemTransLuaDic[id]
    if not item then
        item = require("ItemCardAllView").New(obj)
        self.itemTransLuaDic[id] = item
    end
    index = index + 1
    ---@type CardData
    local CardData = self.CardList[index]
    item:ShowCardData(CardData, _G.handler(self, self.OnClick_item), index, item)
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_gou, self.selected[CardData.uid] ~= nil)
end
function CardSelectListView:SetCardList()
    local dic = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    if self.filterFun ~= nil then
        dic = _G.table.choose(dic, self.filterFun)
    end
    ---@param v CardData
    local list =
        _G.table.chooseToArray(
        dic,
        function(_, v)
            return self.IgnoreDic[v.uid] ~= true
        end
    )
    ---@param a CardData
    _G.SortList(
        list,
        function(a)
            return -a.Grade, -a.lv, a.uid
        end
    )
    return list
end

function CardSelectListView:OnClick_item(Params)
    local index = Params[1]
    local lua = Params[2]
    local CardData = self.CardList[index]

    ---是否原本已选满
    local nowCount = _G.table.count(self.selected)

    local isAdd = false

    local OkFun = function()
        if isAdd then
            self.selected[CardData.uid] = true
        else
            self.selected[CardData.uid] = nil
        end
        _G.GameUtil.SetActiveByCondition(lua.go_table.obj_gou, self.selected[CardData.uid] ~= nil)
        ---当前数量
        nowCount = _G.table.count(self.selected)
        if self.updataFun ~= nil then
            self.updataFun(nowCount, CardData)
        end
    end

    if self.selected[CardData.uid] == nil then
        isAdd = true
        if nowCount >= self.maxCount then
            -- _G.PopWindowManager:ShowAllTips(1001, string.format("已选满%d个 请先取消   \n(未配置语言id）", self.maxCount))
            _G.PopWindowManager:ShowAllTips(170106)

            return
        end
        require("CardInfoManager").CardReadyDestroy(
            CardData,
            function()
                self.go_table.scrollloopvectical_card:UpdateAllItem()
            end,
            function()
                OkFun()
            end
        )
        return
    else
        isAdd = false
        OkFun()
    end
end

function CardSelectListView:OnDisable()
    self:OkFun()
end
function CardSelectListView:OnClick_sure()
    self:OkFun(true)
    self:Close()
end
function CardSelectListView:OkFun(isok)
    local ret = self.selectedOld
    if isok then
        ret = _G.table.keys(self.selected)
    end
    if self.updataFun ~= nil then
        self.updataFun(#ret)
    end
    if self.okFun ~= nil then
        self.okFun(ret)
        self.okFun = nil
    end
end

---按钮点击事件在这里派发
function CardSelectListView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return CardSelectListView
