---@class CardStrategyInfoView : UIBaseView 角色推荐信息展示
local CardStrategyInfoView = _G.BaseClass("CardStrategyInfoView", _G.UIBaseView)
--_G.CardStrategyInfoView = CardStrategyInfoView

local CS = _G.CS
local typeof = _G.typeof

function CardStrategyInfoView:Awake()
    self.mCardStrategyManager = require("CardStrategyManager"):GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.SkillsDesc = {
        [1] = self.go_table.aortext_skill1,
        [3] = self.go_table.aortext_skill3,
        [4] = self.go_table.aortext_skill4,
        [5] = self.go_table.aortext_skill5
    }

    self.stars = {
        self.go_table.aorimage_huo1,
        self.go_table.aorimage_huo2,
        self.go_table.aorimage_huo3,
        self.go_table.aorimage_huo4,
        self.go_table.aorimage_huo5
    }
    self.FontImage_star = {self.go_table.aorimage_star1}
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.CloseView
        },
        ["$_toggle_skill1"] = {
            ["audio"] = _G.AudioClipTypeEnum.pitchAuido,
            ["CallFunction"] = self.OnClickSkillTip
        },
        ["$_toggle_skill2"] = {
            ["audio"] = _G.AudioClipTypeEnum.pitchAuido,
            ["CallFunction"] = self.OnClickSkillTip
        },
        ["$_toggle_skill3"] = {
            ["audio"] = _G.AudioClipTypeEnum.pitchAuido,
            ["CallFunction"] = self.OnClickSkillTip
        },
        ["$_toggle_skill4"] = {
            ["audio"] = _G.AudioClipTypeEnum.pitchAuido,
            ["CallFunction"] = self.OnClickSkillTip
        }
    }
end

function CardStrategyInfoView:OnEnable()
end

---@field colseCall function 关闭界面(角色信息界面) 回调
---@field cardUid number
---@class params_CardStrategyView Data

---界面的入口函数
---@param  Data params_CardStrategyView
function CardStrategyInfoView:OnCreate(cfg)
    self.CardCfg = cfg
    self:InitView()
end

function CardStrategyInfoView:InitView()
    self:SetRole()
    self:ShowRoleInfo()
    self:ShowSkills()
end
function CardStrategyInfoView:SetRole()
    self.go_table.aorrawimage_Role:LoadImage(
        self.CardCfg.Portrait,
        function(trans)
            trans:SetNativeSize()
            local x = self.CardCfg.pos_portrait[1] or 0
            local y = self.CardCfg.pos_portrait[2] or 0
            local z = self.CardCfg.pos_portrait[3] or 0

            trans:SetLocalPosition(x, y, z)
            local size = self.CardCfg.size2 > 0 and self.CardCfg.size2 or 1
            trans.rectTransform:SetLocalScaleXYZ(size)
            trans.Alpha = 1
        end
    )
    self.go_table.aortext_RoleDescDi.text = _G.LangUtil.GetLangPackValue(self.CardCfg.recommend_doc[1])
    self.go_table.aortext_RoleDesc.text = _G.LangUtil.GetLangPackValue(self.CardCfg.recommend_doc[1])
end
function CardStrategyInfoView:ShowRoleInfo()
    self.go_table.aortext_CfgName.text = _G.LangUtil.GetLangPackValue(self.CardCfg.Name)
    self.go_table.aorimage_Professional.SpriteName = self.mCardStrategyManager.Professional[self.CardCfg.Professional]
    self.go_table.aorimage_Professional:SetNativeSize()
    self:ShowStar(
        self.CardCfg.Star,
        self.stars,
        self.FontImage_star,
        self.go_table.obj_starParent,
        self.go_table.obj_star2
    )
    self.go_table.aorimage_EquipmentType.SpriteName =
        self.mCardStrategyManager.EquipmentType[self.CardCfg.EquipmentType]
    self.go_table.aorimage_Elements.SpriteName = self.mCardStrategyManager.Order[self.CardCfg.Order]
    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_content.rectTransform)
end
function CardStrategyInfoView:ShowStar(star, stars, FontImage_star, obj_starParent, obj_star2)
    --- 1-10星的显示
    local isShow1 = false
    --- 10星以上的显示
    local isShow10 = false
    if star <= 0 then
    elseif star <= 10 then
        isShow1 = true
        if star < 6 then
            for i = 1, star do
                stars[i].SpriteName = self.mCardStrategyManager.starIconName.normal
                stars[i]:SetActiveE(1)
            end
            for i = star + 1, #stars do
                stars[i]:SetActiveE(0)
            end
        else
            for i = 1, star - 5 do
                stars[i].SpriteName = self.mCardStrategyManager.starIconName.specail
                stars[i]:SetActiveE(1)
            end
            for i = star + 1 - 5, #stars do
                stars[i]:SetActiveE(0)
            end
        end
    else
        isShow1 = false
        isShow10 = true
        _G.UIUtils.SetImageFont(FontImage_star, tostring(star), _G.AorImageFont.CardStar)
    end
    _G.GameUtil.SetActiveByCondition(obj_starParent, isShow1)
    _G.GameUtil.SetActiveByCondition(obj_star2, isShow10)
end
function CardStrategyInfoView:ShowSkills()
    local card_skills_cfg = self.mCardStrategyManager.card_skills_cfg
    --- 从左到有
    local skillObj = {
        --- key 根据 card_skills_cfg.skill_pos  顺序  从左到右显示
        [1] = self.go_table.toggle_skill1,
        [3] = self.go_table.toggle_skill2,
        [4] = self.go_table.toggle_skill3,
        [5] = self.go_table.toggle_skill4
    }

    ---@param nowskillCfg card_skills_cfg_Item
    local function SetSkill(nowskillCfg, pos)
        local gotable = nil
        local obj = skillObj[pos]
        if obj == nil then
            return
        end
        gotable = _G.GetAutoGoTable(obj)
        if gotable == nil then
            return
        end
        if nowskillCfg == nil then
            _G.GameUtil.SetActiveByCondition(self.SkillsDesc[pos], false)
            _G.GameUtil.SetActiveByCondition(gotable.gameObject, false)
            return
        end
        if nowskillCfg then
            --图标
            require("CardInfoManager").LoadRawImage(gotable.aorrawimage_skill, nowskillCfg.icon)
            gotable.aorrawimage_skilltype.Alpha = 0
            self.SkillsDesc[pos].text = _G.LangUtil.GetLangPackValue(nowskillCfg.overview)
            if string.IsNullOrEmpty(nowskillCfg.skill_type) == false then
                require("CardInfoManager").LoadRawImage(gotable.aorrawimage_skilltype, nowskillCfg.skill_type)
            end
        end
        _G.GameUtil.SetActiveByCondition(gotable.gameObject, true)
    end

    --小技能1
    local skillCfg = nil
    skillCfg = card_skills_cfg[self.CardCfg.id + 3 * 100 + 1]
    SetSkill(skillCfg, 3)

    --小技能2
    skillCfg = nil
    skillCfg = card_skills_cfg[self.CardCfg.id + 4 * 100 + 1]
    SetSkill(skillCfg, 4)

    --小技能3
    skillCfg = nil
    skillCfg = card_skills_cfg[self.CardCfg.id + 5 * 100 + 1]
    SetSkill(skillCfg, 5)

    --绝招
    skillCfg = nil
    skillCfg = card_skills_cfg[self.CardCfg.id + 1 * 100 + 1]
    SetSkill(skillCfg, 1)
end
function CardStrategyInfoView:CloseView()
    self:Close()
end

function CardStrategyInfoView:OnDestroy()
end
--BtnOnClick
function CardStrategyInfoView:OnClickSkillTip(go, isOn, name)
    if name == nil then
        name = go:GetName()
    end
    if name == nil then
        return
    end
    local skillid = 0
    if name == "$_toggle_skill1" then
        skillid = self.CardCfg.id + 1 * 100 + 1
    elseif name == "$_toggle_skill2" then
        skillid = self.CardCfg.id + 3 * 100 + 1
    elseif name == "$_toggle_skill3" then
        skillid = self.CardCfg.id + 4 * 100 + 1
    elseif name == "$_toggle_skill4" then
        skillid = self.CardCfg.id + 5 * 100 + 1
    end
    if skillid ~= 0 and isOn then
        require("CommonTipManager"):GetInstance():OpenSkillTip(
            skillid,
            function()
                go:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = false
            end,
            false
        )
    end
end
function CardStrategyInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    else
        name = "nilFnc"
    end
end

return CardStrategyInfoView
