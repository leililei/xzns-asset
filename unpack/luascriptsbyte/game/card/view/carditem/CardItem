---@class CardItem : Component
local CardItem = BaseClass("CardItem", Component)
_G.CardItem = CardItem

function CardItem:OnCreate(go)
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
    self.item = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
    self.item.onValueChanged:AddListener(_G.handler(self, self.ItemValueChange))
end

---@param data mail.MailBrief
function CardItem:Init(data, index, clickBack)
    self.data = data
    self.index = index
    self.clickBack = clickBack
    self:InitData()
    self:UpdateCardInfo()
end

---初始数据
function CardItem:InitData()
    if self.index == 0 then
        self.item.isOn = true
    end
end

---更新状态
function CardItem:UpdateCardInfo()
    self.go_table.aortext_lv.text = "Lv." .. self.data.lv
end

function CardItem:ItemValueChange(value)
    if _G.AppSetting.DEBUG then
        _G.Log(value)
    end
    self.isChoose = value
    if value then
        if self.clickBack then
            self.clickBack(self.data)
        end
    end
end

-- 按钮单击事件--
function CardItem:OnClickBtn(go)
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("CardItem>>ClickBtn>>" .. name)
    end
    --关闭
    if name == "@_aorbtn_btnXX" then
    end
end

function CardItem:Awake()
end

function CardItem:OnDestroy()
end
