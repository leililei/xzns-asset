---@class CardPropLevelUpTipsView : UIBaseView	卡牌升级解锁技能 提示界面
---@field public go_table CardPropLevelUpTipsView_GoTable GoTable
local CardPropLevelUpTipsView = _G.BaseClass("CardPropLevelUpTipsView", _G.UIBaseView)
--_G.CardPropLevelUpTipsView = CardPropLevelUpTipsView

local CS = _G.CS
local typeof = _G.typeof

function CardPropLevelUpTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.OnClick_Close,
        ["@_aorbtn_anyClose"] = self.OnClick_Close,
        ["@_aorbtn_bossSkillbtn"] = self.OnClick_Skill,
        ["@_aorbtn_Done"] = self.OnClick_Done,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.ConstDic = {
        lvtext = "Lv.%s"
    }
end

---@field skillID number 提升的技能id
---@field subList table 消耗资源
---@field rolelv number 玩家当前等级 (升级前)
---@field Call function<boolean> true点击了确定
---@class params_CardPropLevelUpTipsView

---界面的入口函数
---@param Data params_CardPropLevelUpTipsView
function CardPropLevelUpTipsView:OnCreate(Data)
    -- self.Data = Data
    self.skillId = Data.skillID
    self.Call = Data.Call
    self.subList = Data.subList
    self.rolelv = Data.rolelv

    self:SetData()
    _G.AudioManager.PlayAudioByAudioCfgID(2005)
end
function CardPropLevelUpTipsView:SetData()
    local islock = true
    if self.go_table.ResConsume == nil then
        self.go_table.ResConsume =
            self:AddComponent(
            self.go_table.obj_consume,
            require("ConsumeCompont").New(self.go_table.obj_consume, self.subList, nil, nil, true)
        )
    else
        self.go_table.ResConsume:RestRs(self.subList)
    end

    local skillcfg = _G.ConfigManager.card_skills_cfg[self.skillId]
    if skillcfg ~= nil then
        --(" 该技能未配置 card_skills_cfg.id:" .. self.skillId)
        islock = skillcfg.level == 1
        if islock then
            self:SetSkillLock()
        else
            self:SetSkillUp()
        end

        _G.GameUtil.SetActiveByCondition(self.go_table.obj_up, not islock)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, islock)
    end

    self.go_table.aortext_TitleName.text = _G.LangUtil.GetLangPackValue(islock and 90020600037 or 90020600038)
end

function CardPropLevelUpTipsView:SetSkillLock()
    local skillcfg = _G.ConfigManager.card_skills_cfg[self.skillId]
    local go = _G.GetAutoGoTable(self.go_table.obj_skillLock, _G.handler(self, self.OnClickBtn))

    require("CardInfoManager").LoadRawImage(go.aorrawimage_skill, skillcfg.icon)
    go.aortext_skilllevel.text = tostring(skillcfg.level)

    go.aortext_name.text = _G.LangUtil.GetLangPackValue(skillcfg.name1)
    go.aorimage_nuqi:SetActiveE(skillcfg.skill_pos == 1 and 1 or 0)
    -- require("CardInfoManager").LoadRawImage(go.aorrawimage_skilltype, skillcfg.skill_type)
    go.aorbtn_bossSkillbtn:GetParent():SetName(tostring(self.skillId))
end

function CardPropLevelUpTipsView:SetSkillUp()
    local skillcfg = _G.ConfigManager.card_skills_cfg[self.skillId]
    local go = _G.GetAutoGoTable(self.go_table.obj_skill_2, _G.handler(self, self.OnClickBtn))

    require("CardInfoManager").LoadRawImage(go.aorrawimage_skill, skillcfg.icon)
    go.aortext_skilllevel.text = tostring(skillcfg.level)
    go.aorimage_nuqi:SetActiveE(skillcfg.skill_pos == 1 and 1 or 0)
    -- require("CardInfoManager").LoadRawImage(go.aorrawimage_skilltype, skillcfg.skill_type)
    go.aorbtn_bossSkillbtn:GetParent():SetName(tostring(self.skillId))
    go.aortext_cardLv.text = string.format(self.ConstDic.lvtext, self.rolelv + 1)
    go.aortext_name.text = _G.LangUtil.GetLangPackValue(skillcfg.name1)
    go.obj_skilllock:SetActiveE(0)

    local oldSkillid = self.skillId - 1
    skillcfg = _G.ConfigManager.card_skills_cfg[oldSkillid]
    go = _G.GetAutoGoTable(self.go_table.obj_skill_1, _G.handler(self, self.OnClickBtn))
    require("CardInfoManager").LoadRawImage(go.aorrawimage_skill, skillcfg.icon)
    go.aortext_skilllevel.text = tostring(skillcfg.level)
    go.aorimage_nuqi:SetActiveE(skillcfg.skill_pos == 1 and 1 or 0)
    go.aortext_name.text = _G.LangUtil.GetLangPackValue(skillcfg.name1)
    -- require("CardInfoManager").LoadRawImage(go.aorrawimage_skilltype, skillcfg.skill_type)
    go.aorbtn_bossSkillbtn:GetParent():SetName(tostring(self.skillId - 1))
    go.aortext_cardLv.text = string.format(self.ConstDic.lvtext, self.rolelv)
    go.obj_skilllock:SetActiveE(0)
end

--region --------------------------------------点击事件--------

function CardPropLevelUpTipsView:OnClick_Skill(go, isOn, name)
    local skillid = go:GetParent():GetName()
    skillid = tonumber(skillid)
    if skillid ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(skillid)
    end
end
function CardPropLevelUpTipsView:OnClick_Done(go, isOn, name)
    self:CloseView(true)
end
function CardPropLevelUpTipsView:OnClick_Close(go, isOn, name)
    self:CloseView()
end

--endregion

function CardPropLevelUpTipsView:CloseView(isTrue)
    if self.Call ~= nil then
        self.Call(isTrue)
    end
    self:Close()
end

---按钮点击事件在这里派发
function CardPropLevelUpTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return CardPropLevelUpTipsView
