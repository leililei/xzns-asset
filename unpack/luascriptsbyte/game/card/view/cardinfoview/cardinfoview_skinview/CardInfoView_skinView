---@class CardInfoView_skinView : Component	皮肤
local CardInfoView_skinView = _G.BaseClass("CardInfoView_skinView", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function CardInfoView_skinView:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_CardItem:SetActiveE(0)
    --按钮点击对应的方法
    self.clickFunction = {
        [self.go_table.aorbtn_btn:GetName()] = self.OnClick_sure,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.ScrollRect = self.go_table.obj_ScrollView:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    ---@type UnityEngine.RectTransform
    self.ContentRect = self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))

    self.Timer_CardSize_state = {}
    self.Timer_CardSize = {}
    self.Params = {
        CardItemSize = 0.7,
        Content_spacing = 150,
        CardItemWidth = 175,
        CardItemCount = 4,
        CardItemNowMaxCount = 0,
        doTweenTime = 0.3,
        ---单个itemPosX 用计算当前index self.ContentRectX= CardItemOneWidth * index
        CardItemOneWidth = 0,
        UI = {
            tipsId = {
                --更换成功上浮框
                ghcg = 490103
            },
            --- 按钮状态
            BtnState = 1,
            --- 按钮状态枚举
            BtnStateEnum = {
                --- 确认更换
                qrgh = 1,
                --- 去获得
                qhd = 2,
                --- 限售
                xs = 3,
                --- 已穿戴
                ycd = 4
            },
            ---@field langId number
            ---@field isGray boolean
            ---@field SpriteName string
            ---@field color string
            ---@class CardInfoView_skinView_BtnUi
            Btn = {
                --- 确认更换
                [1] = {
                    color = "69381a",
                    SpriteName = "ui_ty_btn_huangseanniu",
                    isGray = false,
                    langId = 91511142009
                },
                --- 去获得
                [2] = {
                    color = "5d1d1d",
                    SpriteName = "ui_ty_btn_hongseanniu",
                    isGray = false,
                    langId = 91511142011
                },
                --- 限售
                [3] = {
                    color = "3c3c3c",
                    SpriteName = "ui_ty_btn_huangseanniu",
                    isGray = true,
                    langId = 91511142010
                },
                --- 已穿戴
                [4] = {
                    color = "69381a",
                    SpriteName = nil,
                    isGray = false,
                    langId = 91511142008
                }
            }
        }
    }
    self.Params.CardItemWidth = self.Params.CardItemWidth * self.Params.CardItemSize
    self.Params.CardItemOneWidth = (self.Params.Content_spacing) * -1

    self.go_table.CardItemList = {}

    --- 当前穿戴皮肤
    self.NowPutSkin = 0
    --- 当前穿戴皮肤索引 方便快速切换 显示穿戴  默认原皮
    self.NowPutSkinIndex = 1
    --- 皮肤
    self.SkinArr = {}
    --- 拥有皮肤 {皮肤id=true}
    self.HaveSkinDic = {}
    --拥有皮肤数量
    self.HaveSkinCount = 0

    self.NowIndex = -1
end

---@param CardData CardData
function CardInfoView_skinView:InitView(CardData)
    self.CardData = CardData
    local skinArr = {0}
    table.insertto(skinArr, self.CardData.cfg.skin)
    self.Params.CardItemNowMaxCount = self.ContentRect:GetChildCountE()

    self.HaveSkinDic = {}
    self.HaveSkinCount = 0
    self.NowPutSkinIndex = 1
    self.NowPutSkin = self.CardData.skin
    self:SetCardItemCount(skinArr)
    self:ShowName()
end

--- 显示当前 或 指定 索引的皮肤
---@param CardData CardData
function CardInfoView_skinView:ShowNowPut(Index)
    if Index == nil then
        Index = 0
        if self.NowPutSkinIndex ~= nil then
            Index = self.NowPutSkinIndex
        end
    end

    self.ContentRect:SetAnchorPosition(self.Params.CardItemOneWidth * (Index - 1), 0)
end

function CardInfoView_skinView:SetCardItemCount(skinArr)
    local count = #skinArr
    self.SkinArr = skinArr
    self.Params.CardItemCount = count
    for i = 1, count do
        if self.go_table.CardItemList[i] == nil then
            self.go_table.CardItemList[i] = _G.InstantiateObject(self.go_table.obj_CardItem, self.ContentRect)
            self.Params.CardItemNowMaxCount = self.Params.CardItemNowMaxCount + 1
        end
        self.go_table.CardItemList[i]:SetActiveE(1)
        self:SetCardInfo(self.go_table.CardItemList[i], skinArr[i], i)
    end

    self.go_table.aortext_haveCount.text = _G.LangUtil.GetLangPackValue(91511142004, self.HaveSkinCount, #self.SkinArr)

    local listCount = self.Params.CardItemNowMaxCount
    if listCount > count then
        for i = count + 1, listCount do
            self.go_table.CardItemList[i]:SetActiveE(0)
        end
    end

    self.ScrollRect.onValueChanged:AddListener(
        function(pos, aa, bb)
            local x, y, z = self.ContentRect:GetAnchorPosition()
            local intx = self:GetIndex(x)
            if intx ~= nil then
                self:SetNowCard(intx)
            end
        end
    )

    self:ShowNowPut()
end

function CardInfoView_skinView:SetCardInfo(item, id, Index)
    local path
    if id == 0 then
        path = self.CardData.cfg.Photo
    else
        local skin_cfg = _G.ConfigManager.skin_cfg[id]
        if skin_cfg ~= nil then
            path = skin_cfg.Photo
        end
    end
    local goTable = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClick_CardItme, id, Index))
    if path == nil then
        goTable.aorrawimage_role.Alpha = 0
        return
    end

    local isHave = false
    if _G.PlayerModel:GetInstance():IsHaveSkin(id) or id == 0 then
        self.HaveSkinDic[id] = true
        self.HaveSkinCount = self.HaveSkinCount + 1
        isHave = true
    end

    goTable.aorrawimage_mask:SetActiveE(isHave == false and 1 or 0)
    goTable.aorrawimage_role:LoadImage(path)
    goTable.aorimage_zhezhao:SetActiveE(self.NowPutSkin == id and 1 or 0)

    goTable.aorimage_type:SetActiveE(0)

    if self.NowPutSkin == id then
        self.NowPutSkinIndex = Index
    end
end

--- 根据索引 设置皮肤是否显示穿戴
function CardInfoView_skinView:SetShowPutSkin(Index, isShow)
    local goTable = _G.GetAutoGoTable(self.go_table.CardItemList[Index])
    if goTable == nil then
        return
    end
    goTable.aorimage_zhezhao:SetActiveE(isShow and 1 or 0)
end
function CardInfoView_skinView:ShowName()
    local name = self.CardData:GetName()
    local skin_cfg = _G.ConfigManager.skin_cfg[self.SkinArr[self.NowIndex]]
    if skin_cfg ~= nil then
        name = _G.LangUtil.GetLangPackValue(skin_cfg.name)
    end
    self.go_table.aortext_name.text = name
end

---@param aorbtn AorButton
function CardInfoView_skinView:OnClick_CardItme(aorbtn, isOn, id, Index)
    self:ShowNowPut(Index)
end

function CardInfoView_skinView:GetIndex(x)
    local index = 1
    local maxX = self.Params.Content_spacing * (self.Params.CardItemCount - 1)
    local minX = self.Params.Content_spacing

    index = math.ceil((math.abs(x) + minX / 2) / minX)

    if index < 1 or x > 0 then
        index = 1
    elseif index > self.Params.CardItemCount then
        index = self.Params.CardItemCount
    end
    return index
end

function CardInfoView_skinView:SetNowCard(Index)
    if self.NowIndex == Index then
        return
    end
    for i = 1, self.Params.CardItemCount do
        local isShow = false
        if Index == i then
            isShow = true
            self.NowIndex = Index

            self:ShowName()
        end
        local tran = self.ContentRect:GetChildE(i - 1)
        if tran ~= nil then
            self:SetCardSize(tran, i, isShow)
        end
    end
    local skinid = self.SkinArr[self.NowIndex]
    local isHave = self.HaveSkinDic[skinid] == true
    ---@type CardInfoView_skinView_BtnUi
    local btnUi

    if self.NowPutSkin == skinid then
        self.Params.UI.BtnState = self.Params.UI.BtnStateEnum.ycd
    else
        if isHave == true then
            self.Params.UI.BtnState = self.Params.UI.BtnStateEnum.qrgh
        else
            self.Params.UI.BtnState = self.Params.UI.BtnStateEnum.qhd
        end
    end

    btnUi = self.Params.UI.Btn[self.Params.UI.BtnState]
    if btnUi ~= nil then
        if btnUi.SpriteName ~= nil then
            self.go_table.aorimage_btn.SpriteName = btnUi.SpriteName
            self.go_table.aorimage_btn:SetGray(btnUi.isGray)
        end
        self.go_table.aorimage_btn:SetActiveE(btnUi.SpriteName ~= nil and 1 or 0)
        self.go_table.aortext_btn.color = require("CardInfoManager").GetColorFromRGB(btnUi.color)
        self.go_table.aortext_btn.text = _G.LangUtil.GetLangPackValue(btnUi.langId)
    end
end

---@param item UnityEngine.Transform
function CardInfoView_skinView:SetCardSize(item, Index, isShow)
    local size = self.Params.CardItemSize
    if isShow == true then
        size = 1
    end

    if self.Timer_CardSize[Index] ~= nil then
        self.Timer_CardSize[Index]:Kill()
    end
    self.Timer_CardSize[Index] = self:DoTween(item, size, Index)
end

function CardInfoView_skinView:DoTween(item, size, Index)
    return item:DOScale(
        size,
        size,
        size,
        self.Params.doTweenTime,
        function()
            self.Timer_CardSize[Index] = nil
        end
    )
end

--region --------------------------------------交互按钮--------
---按钮点击事件在这里派发
function CardInfoView_skinView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function CardInfoView_skinView:OnClick_sure(go, isOn)
    local nowid = self.SkinArr[self.NowIndex]
    if nowid == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("未选中皮肤", "<color=red>" .. ">>>" .. "</color>")
        end
        return
    end
    if self.Params.UI.BtnState == self.Params.UI.BtnStateEnum.qhd then
        _G.PopWindowManager:GetInstance():ShowAllTips(1001, "去获得 未配置")
        return
    end
    if self.Params.UI.BtnState == self.Params.UI.BtnStateEnum.xs then
        _G.PopWindowManager:GetInstance():ShowAllTips(1001, "限售 未配置")
        return
    end
    require("CardInfoManager").CardPutSkin(
        self.CardData.uid,
        nowid,
        function(data)
            if data.ack ~= 1 then
                --_G.GameUtil.NetAckShowTips(data.ack)
                return
            end
            self:SetShowPutSkin(self.NowPutSkinIndex, false)
            self.NowPutSkinIndex = self.NowIndex
            self.CardData:SetSkin(nowid)
            self:SetShowPutSkin(self.NowPutSkinIndex, true)

            _G.PopWindowManager:GetInstance():ShowAllTips(self.Params.UI.tipsId.ghcg)

            self.NowPutSkin = nowid
            self:SetNowCard(self.NowPutSkinIndex)
        end
    )
end

--endregion------------------------------------交互按钮--------

---销毁对象时,析构函数
function CardInfoView_skinView:OnDestroy()
end

return CardInfoView_skinView
