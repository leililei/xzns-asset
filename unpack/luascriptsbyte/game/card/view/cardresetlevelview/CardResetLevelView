---按钮点击事件在这里派发
function CardResetLevelView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Done then
        self:OnClickSure()
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_CloseView2 then
        self:CloseView()
    end
end

function CardResetLevelView:OnClickSure()
    local CardData = self.CardData
    if CardData == nil then
        return
    end

    self:StarSure(CardData)
end
function CardResetLevelView:StarSure(CardData)
    self:UnEquip(
        CardData,
        function(equipAwards)
            if equipAwards == nil then
                return
            end
            require("CardResonanceModel"):GetInstance():LevelReset(
                CardData.uid,
                function(data)
                    if data.ack ~= 1 then
                        --_G.GameUtil.NetAckShowTips(data.ack)
                        return
                    end
                    if data.award ~= nil then
                        if data.award.item ~= nil then
                            --- 解析奖励
                            _G.StorageManager:GetInstance():ReceiveAwardData(data)
                            table.insertto(data.award.item, equipAwards)
                            --饰品
                            local mainCards = {}
                            if self.spiritual then
                                for _, v in pairs(self.spiritual) do
                                    local award1 = {v.sid, v.uid, 1}
                                    table.insert(mainCards, {type = award1})
                                end
                            end
                            --[[if self.decoration then
                                for key, value in pairs(self.decoration) do
                                    local award1 = {value[1], value[2]}
                                    table.insert(mainCards, {type = award1})
                                end
                            end]]

                            table.insertto(data.award.item, mainCards)
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        end
                    end

                    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                    _G.PlayerPrefsManager.DeleteKey(_G.CardHunLian.CardHunLianSaveKey .. (CardData.uid * 10 + 1))
                    require "RedPointManager":GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.SoulChain.id,
                        CardData.uid * 10 + 1
                    )
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
                    )
                    self:CloseView()
                end
            )
        end
    )
end

---@param CardData CardData
function CardResetLevelView:ShowItem(CardData)
    local lv = CardData.lv_Old
    ---@type card_level_cfg
    local cfg = _G.ConfigManager.card_level_cfg[lv]
    if cfg == nil then
        return
    end

    local name = _G.GetLangPackValue(_G.ConfigManager.card_cfg[CardData.sid].Name)
    self.go_table.aortext_tips.text = _G.LangUtil.GetLangPackValue(90020300092, "<color=#AC490C>" .. name .. "</color>")
    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            self.go_table.obj_item,
            function(item)
                item:Show(CardData.sid, nil, CardData.star, CardData.soul_lv, CardData.level, nil, nil, CardData.soul_state, CardData.born_skill_num)
                item.transform:FindE("scale"):SetLocalScaleXYZ(0.875)
            end
    )

    local ItemViewBase = require("ItemViewBase")

    local count = self.go_table.obj_item:GetChildCountE()
    for i = 2, count do
        local tran = self.go_table.obj_item:GetChildE(count - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    local expNum = cfg.exp
    if expNum > 0 then
        local exp = _G.ResPropID.CardExp
        _G.StorageManager:GetInstance():GetItemBaseView(
            exp,
            expNum,
            self.go_table.obj_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            end
        )
    end

    local coinNum = cfg.coin
    if coinNum > 0 then
        local coin = _G.ResPropID.Coin
        _G.StorageManager:GetInstance():GetItemBaseView(
            coin,
            coinNum,
            self.go_table.obj_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            end
        )
    end
    local len = #cfg.material
    if len >= 2 then
        len = len / 2
        for i = 1, len do
            local mIndex = i * 2
            local num = cfg.material[mIndex]
            if num and num > 0 then
                local sid = cfg.material[mIndex - 1]
                _G.StorageManager:GetInstance():GetItemBaseView(
                    sid,
                    num,
                    self.go_table.obj_item,
                    function(mitem)
                        mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                    end
                )
            end
        end
    end
    
    local decoration = CardData.DecorationBar
    local material = {}
    for _, v in pairs(decoration) do
        if v.slotLevel and v.slotLevel >= 1 then
            local data = _G.ConfigManager.decoration_stren_cfg[v.slotLevel - 1].cost
            local id = data[1]
            local num = data[2]
            if material[id] then
                material[id] = material[id] + num
            else
                material[id] = num
            end
        end
    end
    for sid, num in pairs(material) do
        _G.StorageManager:GetInstance():GetItemBaseView(
            sid,
            num,
            self.go_table.obj_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            end
        )
    end
    
    local move = len > 0 and ((count * 48) + (count - 1) * 4) * -1 or 0
    self.go_table.obj_item:SetLocalPosition(move, 0, 0)


    --- 不预览装备获得  在恭喜获得界面显示
