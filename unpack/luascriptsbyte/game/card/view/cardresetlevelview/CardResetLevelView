end

function CardResetLevelView:UnEquip(Cardata, call)
    local indexs = {}
    local Uids = {}

    ---@param equip EquipmentItem
    for key, equip in pairs(Cardata.EquipBar) do
        if not table.isEmptyOrNil(equip) then
            table.insert(Uids, {equip.sid, equip.uid})
            table.insert(indexs, key)
        end
    end
    if not _G.table.isEmptyOrNil(Cardata.ArtifactBar) then
        table.insert(Uids, {Cardata.ArtifactBar.sid, Cardata.ArtifactBar.uid})
    end
    --ZHJH-7581 重生后卸下饰品
    if #indexs < 1 then
        self:UnSpiritual(Cardata, call, Uids)
        ---脱下符文
        self:UnDecoration(Cardata, call, Uids)
        ---脱下神器
        self:UnArtifact(Cardata, call, Uids)
    else
        require("EquipmentModel"):GetInstance():UnfixEquip(
            Cardata.uid,
            indexs,
            function(data)
                for _, equip in pairs(Cardata.EquipBar) do
                    if not table.isEmptyOrNil(equip) then
                        equip:UnEquip()
                    end
                end
                self:UnSpiritual(Cardata, call, Uids)
                ---脱下符文
                self:UnDecoration(Cardata, call, Uids)
                ---脱下神器
                self:UnArtifact(Cardata, call, Uids)
            end
        )
    end
end


function CardResetLevelView:UnSpiritual(CardData, call, Uids)
    self.spiritual = {}
    local SpiritualBar = CardData.SpiritualBar
    local hasSpiritual = false
    for _, v in pairs(SpiritualBar) do
        if v then
            hasSpiritual = true
            _G.table.insert(self.spiritual, v)
        end
    end
    if not hasSpiritual then
        if _G.AppSetting.DEBUG then
            _G.Log("无饰品 穿戴")
        end
        if call then
            --call(Uids)
            return
        end
    end

    require("SpiritualModel"):GetInstance():OneKeyOffSpiritual(
            {CardData.uid},
            function()
                if call then
                    --call(Uids)
                end
            end
    )
end

function CardResetLevelView:UnDecoration(CardData, call, Uids)
    self.decoration = {}
    if CardData:GetDecorationCount() == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("无饰品 穿戴")
        end
        if call then
            --call(Uids)
            return
        end
    end
    local DecorationBar = CardData.DecorationBar
    for i = 1, #DecorationBar do
        if not _G.table.isEmptyOrNil(DecorationBar[i]) then
            _G.table.insert(self.decoration, {DecorationBar[i].decoration.sid, DecorationBar[i].decoration.uid})
        end
    end
    require("DecorationModel"):GetInstance():UnfixDecoration(
        CardData,
        function()
            if call then
                --call(Uids)
            end
        end
    )
end

function CardResetLevelView:UnArtifact(cardData, call, Uids)
    ---脱下神器
    require("ArtifactModel"):TakeOffArtifact(
        cardData,
        function()
            if call then
                call(Uids)
            end
        end
    )
end

return CardResetLevelView
