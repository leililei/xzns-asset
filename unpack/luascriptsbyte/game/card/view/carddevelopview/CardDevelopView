---打开卡牌评论
---@param sid number 卡牌
function CardDevelopView:OpenCardCommon(carddata)
    if not self.minCaiCardStar then
        self.minCaiCardStar = self.mCardInfoManager.StarIndexDic[7][1]
    end
    if carddata.star ~= self.minCaiCardStar then
        return
    end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    cards =
        _G.table.chooseToArray(
            cards,
            function(_, v)
                return v.sid == carddata.sid
            end
        )
    _G.table.sort(
        cards,
        function(a, b)
            return a.star > b.star
        end
    )
    if not cards[2] or cards[2].star < self.minCaiCardStar then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardCommonGuideView.Name, carddata)
    end
end

---初始化材料卡数据
function CardDevelopView:InitPropCardData()
    self.propCards = {}
    local sid, count, data
    for _, v in pairs(_G.ConfigManager.item_card_cfg) do
        sid = v.id
        count = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
        if count > 0 then
            data = PropCardData.New()
            data:Parse({ sid = sid, uid = sid, num = count })
            self.propCards[sid] = data
        end
    end
end

---更新材料卡数据
function CardDevelopView:UpdatePropCardData()
    local count
    for k, v in pairs(self.propCards) do
        if v.uid ~= v.sid then
            v:Dispose()
            self.propCards[k] = nil
        else
            count = _G.StorageManager:GetInstance():GetItemCountBySid(v.sid)
            if count <= 0 then
                v:Dispose()
                self.propCards[k] = nil
            else
                v.count = count
            end
        end
    end
end

---检测是否选中的是材料卡，并生成/销毁材料卡的CardData
---@param CardData CardData|PropCardData 卡牌数据
---@param hasSelect boolean 是否已选中
---@param index number 计算槽位用（老代码的逻辑）
function CardDevelopView:IfSelectPropCardData(CardData, hasSelect, index)
    if CardData.type == _G.CardType.Prop then
        if not hasSelect then ---没选中那组的一定是sid=uid
            if index < 0 then
                local tempIndex = self:CalculateRightIndex(CardData)
                if tempIndex ~= nil then
                    index = tempIndex * -1
                end
            end
            if CardData:GetCount() == 1 then
                return CardData
            elseif self:CheckRightIsFull(index) then
                return CardData
            else
                CardData.count = CardData.count - 1
                local tempData = PropCardData.New()
                local uid = self:GetSameSidPropCardUid(CardData.sid)
                tempData:Parse({ sid = CardData.sid, uid = uid, num = 1 })
                self.propCards[uid] = tempData
                return tempData
            end
        else
            if CardData.sid == CardData.uid then ---已选中的sid=uid,说明这个卡只有一张
                return CardData
            else
                self.propCards[CardData.uid] = nil ---解除引用
                local mainData = self.propCards[CardData.sid]
                mainData.count = mainData.count + 1
                return CardData
            end
        end
    else
        return CardData
    end
end

---获取生成uid
---@param sid number 材料卡sid
function CardDevelopView:GetSameSidPropCardUid(sid)
    local count = 0
    for _, v in pairs(self.propCards) do
        if sid == v.sid then
            count = count + 1
        end
    end
    local uid = sid * 100
    for i = 1, count do
        uid = uid + 1
        if self.propCards[-uid] == nil then
            return -uid
        end
    end
    return -(uid + 1)
end

---已选中的材料卡uid转sid
function CardDevelopView:ConvertPropUidToSid(uidLis)
    local sidLis = {}
    for _, v in pairs(uidLis) do
        if self.propCards[v] then
            _G.table.insert(sidLis, self.propCards[v].sid)
        else
            _G.table.insert(sidLis, v)
        end
    end
    return sidLis
end

---已选中的材料卡uid转sid
function CardDevelopView:FindPropIndex()
    for i = 1, #self.CardList do
        if self.CardList[i]:GetGrade() ~= 3 or self.propCards[self.CardList[i].sid] then
            return i
        end
    end
    return -1
end

function CardDevelopView:MoveToCardIndex(index)
    if index < 0 then
        return
    end
    local outIndex = math.ceil(index / self.mItemCountPerRow)
    if outIndex > 0 then
        outIndex = outIndex - 1
        self.mlistView2:MovePanelToItemIndex(outIndex)
    end
end

---尝试查找布阵上的同名同等级同星级卡
---@param cardData CardData
function CardDevelopView:FindSameEmbattleCard(cardData)
    ---@type CardData
    local card
    if not self.embattleUids then
        self.embattleUids = {}
        local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
        if uids then
            for _, v in pairs(uids) do
                if v > 0 then
                    card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v)
                    if card then
                        self.embattleUids[card.sid] = card
                    end
                end
            end
        end
    end
    card = self.embattleUids[cardData.sid]
    if card and card.uid ~= cardData.uid then
        if card:GetLevel() == cardData:GetLevel() and card:GetStar() == cardData:GetStar() then
            return card
        end
    end
    return cardData
end

