------@param arr number[] 吃卡信息 _{星级，数量，五行/0任意，sid/0任意，}
function CardDevelopView:SetSingleSelectCard(type, arr, Cardata)
    if type == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 输入错误")
        end
        return
    end
    if type > 3 then
        if _G.AppSetting.DEBUG then
            _G.LogError(arr, " 配置的 吃卡 数量大于3 ")
        end
        return
    end
    local tempCardData = _G.DeepCopy(Cardata)
    tempCardData.isSelfLogo = arr[4] > 0
    if type == 1 then
        self.upstarCondition_1 = arr
        self.NowSelectCardChild_1_MaxCount = self:GetSelectCardArrinfo_num(self.upstarCondition_1) or 0
        ---显示 需要 的星级
        tempCardData.star = self:GetSelectCardArrinfo_star(self.upstarCondition_1)
        self:SetSelectCard(self.CardIndexLuaEnum.one, tempCardData, true, 1, self.upstarCondition_1)
        if self:GetSelectCardArrinfo_sid(arr) == 0 then
            ---显示灰头像（代表任意）
            self.CardIndexLuaEnum.one.go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
            self.CardIndexLuaEnum.one:HideOrShowJue(false)
            self.CardIndexLuaEnum.one.go_table.aorimage_type:SetActiveE(0)
            self.CardIndexLuaEnum.one:HideOrShowProfession(false)
        end
    elseif type == 2 then
        self.upstarCondition_2 = arr
        self.NowSelectCardChild_2_MaxCount = self:GetSelectCardArrinfo_num(self.upstarCondition_2) or 0
        tempCardData.star = self:GetSelectCardArrinfo_star(self.upstarCondition_2)
        self:SetSelectCard(self.CardIndexLuaEnum.two, tempCardData, true, 2, self.upstarCondition_2)
        if self:GetSelectCardArrinfo_sid(arr) == 0 then
            ---显示灰头像（代表任意）
            self.CardIndexLuaEnum.two.go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
            self.CardIndexLuaEnum.two:HideOrShowJue(false)
            self.CardIndexLuaEnum.two.go_table.aorimage_type:SetActiveE(0)
            self.CardIndexLuaEnum.two:HideOrShowProfession(false)
        end
    elseif type == 3 then
        self.upstarCondition_3 = arr
        self.NowSelectCardChild_3_MaxCount = self:GetSelectCardArrinfo_num(self.upstarCondition_3) or 0
        tempCardData.star = self:GetSelectCardArrinfo_star(self.upstarCondition_3)
        self:SetSelectCard(self.CardIndexLuaEnum.three, tempCardData, true, 3, self.upstarCondition_3)
        if self:GetSelectCardArrinfo_sid(arr) == 0 then
            ---显示灰头像（代表任意）
            self.CardIndexLuaEnum.three.go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
            self.CardIndexLuaEnum.three:HideOrShowJue(false)
            self.CardIndexLuaEnum.three.go_table.aorimage_type:SetActiveE(0)
            self.CardIndexLuaEnum.three:HideOrShowProfession(false)
        end
    end

    tempCardData = nil
end

