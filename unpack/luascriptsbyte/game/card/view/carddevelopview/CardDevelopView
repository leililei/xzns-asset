---@param CardData CardData
function CardDevelopView:CheckRightSelect(CardData, mCarditemListItem)
    local Select1or2 = nil
    local function SetSelect(isselect)
        if mCarditemListItem ~= nil then
            local isMainCard = self.NowSelectCard and CardData.uid == self.NowSelectCard.uid
            -- mCarditemListItem.go_table.aorimage_gou:SetActiveE(isMainCard == false and isselect and 1 or 0)
            mCarditemListItem:SetSelectGou(isMainCard == false and isselect)
            if CardData.type == _G.CardType.Prop then
                if isselect then
                    mCarditemListItem:SetLevelText(_G.GetLangPackValue(90000001251, 1))
                else
                    mCarditemListItem:SetLevelText(_G.GetLangPackValue(90000001252, CardData.count))
                end
            end
        end
    end
    local isShowMask = false
    if self.NowSelectCard == nil then
        SetSelect(false)
    else
        if CardData.uid ~= self.NowSelectCard.uid then
            isShowMask = true
            local RightIndex = self.Right_SelectCardDic[CardData.uid]
            if RightIndex ~= nil then
                isShowMask = false
                SetSelect(RightIndex > 0)

                if RightIndex < 0 then
                    if
                        self.upstarCondition_1 == nil or
                        #self.NowSelectCardChild_1 == self:GetSelectCardArrinfo_num(self.upstarCondition_1)
                    then
                        if
                            self.upstarCondition_2 == nil or
                            #self.NowSelectCardChild_2 == self:GetSelectCardArrinfo_num(self.upstarCondition_2)
                        then
                            if
                                self.upstarCondition_3 == nil or
                                #self.NowSelectCardChild_3 == self:GetSelectCardArrinfo_num(self.upstarCondition_3)
                            then
                                --- 选满 全置灰
                                isShowMask = true
                            end
                        end
                    end

                    ---如果没选满 检测是否还能选中 否则置灰  (假如同五行选满了 本张卡上不了就置灰了)
                    if isShowMask == false then
                        local Select1or2, tisSelect = self:CalculateRightIndex(CardData)
                        if tisSelect == false then
                            isShowMask = true
                        end
                    end
                end
            else
                local isSelect = false

                local isCondition
                if self.upstarCondition_1 ~= nil then
                    isCondition = self:IsMatchCardArrinfo(self.upstarCondition_1, CardData)
                    if isCondition then
                        if #self.NowSelectCardChild_1 == self:GetSelectCardArrinfo_num(self.upstarCondition_1) then
                            ---上阵 或锁 也可以被吃 反正有吃卡提示
                            -- and self.mCardInfoManager.CardReadyDestroy(CardData, nil, nil, nil, true) == false
                            ---false(玩家自选)
                            self:Ritht_SetSelect(CardData, false, 1)
                            isSelect = table.indexof(self.NowSelectCardChild_1, CardData.sid) ~= false
                            Select1or2 = 1
                        else
                            self:Ritht_SetSelect(CardData, false, 1)
                        end
                        isShowMask = false
                    end
                end
                ---    如果上面  没选中
                if isSelect == false and self.upstarCondition_2 ~= nil then
                    isCondition = self:IsMatchCardArrinfo(self.upstarCondition_2, CardData)
                    if isCondition then
                        if #self.NowSelectCardChild_2 == self:GetSelectCardArrinfo_num(self.upstarCondition_2) then
                            ---上阵 或锁 也可以被吃 反正有吃卡提示
                            -- and  self.mCardInfoManager.CardReadyDestroy(CardData, nil, nil, nil, true) == false
                            ---false(玩家自选)
                            self:Ritht_SetSelect(CardData, false, 2)
                            isSelect = table.indexof(self.NowSelectCardChild_2, CardData.sid) ~= false
                            Select1or2 = 2
                        else
                            self:Ritht_SetSelect(CardData, false, 2)
                        end
                        isShowMask = false
                    end
                elseif self.upstarCondition_1 == nil and self.upstarCondition_2 == nil then
                    isShowMask = false
                end

                if isSelect == false and self.upstarCondition_3 ~= nil then
                    isCondition = self:IsMatchCardArrinfo(self.upstarCondition_3, CardData)
                    if isCondition then
                        if #self.NowSelectCardChild_3 == self:GetSelectCardArrinfo_num(self.upstarCondition_3) then
                            ---上阵 或锁 也可以被吃 反正有吃卡提示
                            -- and  self.mCardInfoManager.CardReadyDestroy(CardData, nil, nil, nil, true) == false
                            ---false(玩家自选)
                            self:Ritht_SetSelect(CardData, false, 3)
                            isSelect = table.indexof(self.NowSelectCardChild_3, CardData.sid) ~= false
                            Select1or2 = 3
                        else
                            self:Ritht_SetSelect(CardData, false, 3)
                        end
                        isShowMask = false
                    end
                elseif self.upstarCondition_1 == nil and self.upstarCondition_2 == nil and self.upstarCondition_3 == nil then
                    isShowMask = false
                end

                SetSelect(isSelect)
            end
        else
            SetSelect(false)
        end
    end

    return isShowMask, Select1or2
end

---重新计算槽位  玩家主动下卡槽一的卡 原本预定卡槽二的卡若卡槽二满了 可以重新计算
---@return index,boolean 槽位,true可选中
function CardDevelopView:CalculateRightIndex(CardData)
    local isSelect = false
    local Select1or2, isCondition

    if self.upstarCondition_1 ~= nil then
        isCondition = self:IsMatchCardArrinfo(self.upstarCondition_1, CardData)
        if isCondition then
            if #self.NowSelectCardChild_1 < self:GetSelectCardArrinfo_num(self.upstarCondition_1) then
                ---上阵 或锁 也可以被吃 反正有吃卡提示
                -- and  self.mCardInfoManager.CardReadyDestroy(CardData, nil, nil, nil, true) == false
                Select1or2 = 1
                isSelect = true
            else
                Select1or2 = 1
            end
        end
    end
    --- 消耗同五行 （星级#数量）   如果上面  没选中
    ---    如果上面  没选中
    if isSelect == false and self.upstarCondition_2 ~= nil then
        isCondition = self:IsMatchCardArrinfo(self.upstarCondition_2, CardData)
        if isCondition then
            if #self.NowSelectCardChild_2 < self:GetSelectCardArrinfo_num(self.upstarCondition_2) then
                ---上阵 或锁 也可以被吃 反正有吃卡提示
                -- and self.mCardInfoManager.CardReadyDestroy(CardData, nil, nil, nil, true) == false
                Select1or2 = 2
                isSelect = true
            else
                Select1or2 = 2
            end
        end
    end

    if isSelect == false and self.upstarCondition_3 ~= nil then
        isCondition = self:IsMatchCardArrinfo(self.upstarCondition_3, CardData)
        if isCondition then
            if #self.NowSelectCardChild_3 < self:GetSelectCardArrinfo_num(self.upstarCondition_3) then
                ---上阵 或锁 也可以被吃 反正有吃卡提示
                -- and self.mCardInfoManager.CardReadyDestroy(CardData, nil, nil, nil, true) == false
                Select1or2 = 3
                isSelect = true
            else
                Select1or2 = 3
            end
        end
    end
    return Select1or2, isSelect
end

---右侧 选副卡
---@param index number  1 or 2 or 3 副卡槽位  -1 -2 -3取消选中
---@param CardData CardData
function CardDevelopView:Ritht_SetSelect(CardData, isSelect, index, cancelSelect)
    index = math.abs(index)
    local NowSelectCardChild
    local NowSelectCardChild_MaxCount
    local CardIndexLuaEnum
    if index == 1 then
        CardIndexLuaEnum = self.CardIndexLuaEnum.one
        NowSelectCardChild = self.NowSelectCardChild_1
        NowSelectCardChild_MaxCount = self.NowSelectCardChild_1_MaxCount
    elseif index == 2 then
        CardIndexLuaEnum = self.CardIndexLuaEnum.two
        NowSelectCardChild = self.NowSelectCardChild_2
        NowSelectCardChild_MaxCount = self.NowSelectCardChild_2_MaxCount
    elseif index == 3 then
        CardIndexLuaEnum = self.CardIndexLuaEnum.three
        NowSelectCardChild = self.NowSelectCardChild_3
        NowSelectCardChild_MaxCount = self.NowSelectCardChild_3_MaxCount
    end

    local cEnum, cCondition
    if index == 1 then
        cEnum = self.CardIndexLuaEnum.one
        cCondition = self.upstarCondition_1
    elseif index == 2 then
        cEnum = self.CardIndexLuaEnum.two
        cCondition = self.upstarCondition_2
    else
        cEnum = self.CardIndexLuaEnum.three
        cCondition = self.upstarCondition_3
    end
    if isSelect == true then
        if #NowSelectCardChild == NowSelectCardChild_MaxCount then
            _G.PopWindowManager:ShowAllTips(170106)
            return
        end
        table.insert(NowSelectCardChild, CardData.uid)
        self.Right_SelectCardDic[CardData.uid] = index

        self:SetSelectCard(cEnum, CardData, nil, index, cCondition)
        CardIndexLuaEnum:ShowLevel(CardData:GetLevel())
        CardIndexLuaEnum:HideOrShowLevel(CardData.type ~= _G.CardType.Prop)
        CardIndexLuaEnum:HideOrShowJue(true)
    else
        table.removebyvalue(NowSelectCardChild, CardData.uid)
        self.Right_SelectCardDic[CardData.uid] = -index

        if cancelSelect then
            local isSelf = self.NowSelectCard.sid == CardData.sid
            self:SetSingleSelectCard(index, cCondition, CardData, isSelf)
            CardIndexLuaEnum:HideOrShowLevel(false)
        end
    end
    local num = #NowSelectCardChild
    --self:SetCountText(CardIndexLuaEnum.go_table.aortext_num, num, NowSelectCardChild_MaxCount)

    self:SetCardBlack(CardIndexLuaEnum, num ~= NowSelectCardChild_MaxCount)
end

---检测 槽位是否已满
---@param index number  1 or 2 or 3副卡槽位  -1 -2 -3取消选中
function CardDevelopView:CheckRightIsFull(index)
    index = math.abs(index)
    local NowSelectCardChild
    local NowSelectCardChild_MaxCount
    local CardIndexLuaEnum
    if index == 1 then
        CardIndexLuaEnum = self.CardIndexLuaEnum.one
        NowSelectCardChild = self.NowSelectCardChild_1
        NowSelectCardChild_MaxCount = self.NowSelectCardChild_1_MaxCount
    elseif index == 2 then
        CardIndexLuaEnum = self.CardIndexLuaEnum.two
        NowSelectCardChild = self.NowSelectCardChild_2
        NowSelectCardChild_MaxCount = self.NowSelectCardChild_2_MaxCount
    elseif index == 3 then
        CardIndexLuaEnum = self.CardIndexLuaEnum.three
        NowSelectCardChild = self.NowSelectCardChild_3
        NowSelectCardChild_MaxCount = self.NowSelectCardChild_3_MaxCount
    end
    local num = #NowSelectCardChild
    return num >= NowSelectCardChild_MaxCount
end

