---该卡 是否匹配
---@param arr number[] 吃卡信息 _{星级，数量，五行/0任意，sid/0任意，}
---@param CardData CardData 吃卡信息 _{星级，数量，五行/0任意，sid/0任意，}
function CardDevelopView:IsMatchCardArrinfo(arr, CardData)
    local sid = self:GetSelectCardArrinfo_sid(arr)
    if sid == 0 or sid == CardData.sid then
    else
        return false
    end

    local star = arr[1]
    if star == CardData.star then
    else
        return false
    end

    local ele = self:GetSelectCardArrinfo_ele(arr)
    if ele == 0 or ele == {} or require("CardInfoManager"):GetInstance():CheckMultiMatch(ele, CardData.cfg.Elements_new)
        or require("CardInfoManager"):GetInstance():CheckMultiMatch(_G.CardElementType.Common, CardData.cfg.Elements_new) then
    else
        return false
    end

    return true
end

