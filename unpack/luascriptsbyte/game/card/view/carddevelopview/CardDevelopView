function CardDevelopView:StartUpStar2(Cardids, ReFun)
    local mCardData = self.NowSelectCard

    ---@type card.c2s_card_up_star
    local pbdata = {}
    ---@type card.i_c_uid 变量名
    local i_c_uid = {}
    i_c_uid.uid = self.NowSelectCard.uid

    --- 升星卡 吃掉的sid [sid,sid...]
    local SubCards = {}
    local uid
    --- 发给服务器要分 本体 同族
    local card_self = {}
    local card_ele = {}
    local props = {}
    if #self.NowSelectCardChild_1 > 0 then
        uid = self.NowSelectCardChild_1[1]
        if self:GetSelectCardArrinfo_sid(self.upstarCondition_1) == 0 then
            if self.propCards[uid] then
                uid = self.propCards[uid].sid
            end
            if _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, uid) then
                if not props[uid] then
                    props[uid] = 1
                else
                    props[uid] = props[uid] + 1
                end
            else
                _G.table.insert(card_ele, uid)
            end
        else
            _G.table.insert(card_self, uid)
        end

        _G.table.insert(SubCards, self.NowSelectCardChild_1Lua.CardData.sid)
    end
    if #self.NowSelectCardChild_2 > 0 then
        uid = self.NowSelectCardChild_2[1]
        if self:GetSelectCardArrinfo_sid(self.upstarCondition_2) == 0 then
            if self.propCards[uid] then
                uid = self.propCards[uid].sid
            end
            if _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, uid) then
                if not props[uid] then
                    props[uid] = 1
                else
                    props[uid] = props[uid] + 1
                end
            else
                _G.table.insert(card_ele, uid)
            end
        else
            _G.table.insert(card_self, uid)
        end
        _G.table.insert(SubCards, self.NowSelectCardChild_2Lua.CardData.sid)
    end
    if #self.NowSelectCardChild_3 > 0 then
        uid = self.NowSelectCardChild_3[1]
        if self:GetSelectCardArrinfo_sid(self.upstarCondition_3) == 0 then
            if self.propCards[uid] then
                uid = self.propCards[uid].sid
            end
            if _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, uid) then
                if not props[uid] then
                    props[uid] = 1
                else
                    props[uid] = props[uid] + 1
                end
            else
                _G.table.insert(card_ele, uid)
            end
        else
            _G.table.insert(card_self, uid)
        end
        _G.table.insert(SubCards, self.NowSelectCardChild_3Lua.CardData.sid)
    end

    i_c_uid.c_uids = card_self
    i_c_uid.c_uids2 = card_ele
    i_c_uid.c_item = {}
    for k, v in pairs(props) do
        _G.table.insert(i_c_uid.c_item, { k = k, v = v })
    end
    pbdata.uids = {}
    table.insert(pbdata.uids, i_c_uid)

    ---@type card.c2s_card_up_star
    local newpbdata = {}
    newpbdata.uids = {}
    table.insert(newpbdata.uids, pbdata)

    require("CardInfoNet"):GetInstance():UpStar(
        newpbdata,
        function(data)
            if data.ack ~= 1 then
                if ReFun ~= nil then
                    ReFun()
                end
                self.isReadyUpStar = false
                return
            end

            self:UpStarOver(data, Cardids, mCardData, pbdata, SubCards)
            _G.AudioManager.PlayAudioByAudioCfgID(2057)
            local openxzInfo = _G.ConfigManager.discrete_cfg[107401][1]
            local openxz = openxzInfo[1]
            local openxzNum = openxzInfo[2]
            if self.NowSelectCard:GetStar() >= openxz then
                self.NowSelectCard.inborn_num = self.NowSelectCard.inborn_num + openxzNum

                require "RedPointManager":GetInstance():RefreshParentNode(
                    _G.ConfigManager.redpoint_cfg.TalentCultivate.id,
                    self.NowSelectCard.uid
                )
            end
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.CardPotential.id
            )
        end
    )
end

function CardDevelopView:UpStarOver(data, Cardids, mCardData, pbdata, SubCards)
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    if data.award ~= nil and data.award.item ~= nil then
        --- 解析奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
    end

    if #Cardids > 0 then
        self.mCardInfoManager:CardNewStartDestroy(Cardids)
    end
    -- if data
    for index, carduid in ipairs(Cardids) do
        _G.StorageManager:GetInstance():DelCard(carduid)
    end
    for _, v in pairs(self.UpStarConsumePropList) do
        _G.StorageManager:GetInstance():ConsumeItem(v.sid, nil, 1)
    end
    self.UpStarConsumePropList = {}
    self:UpdatePropCardData()
    mCardData:upStarCardAward()
    mCardData:SetCostCardList(SubCards)
    mCardData:CalcNowSumProp()
    _G.Events:GetInstance():Broadcast(_G.eCard.CardUpStar, mCardData:GetStar(), mCardData.sid, mCardData.uid)
    _G.Events:GetInstance():Broadcast(_G.ChatViewEvents.ChatViewLevel, mCardData, mCardData:GetStar())

    ---@type Params_CardDevelopView_upOver
    local Params_CardDevelopView_upOver = {}
    Params_CardDevelopView_upOver.CardData = self.NowSelectCard
    local tempCardData = self.NowSelectCard
    Params_CardDevelopView_upOver.CloseFun = function()
        -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_hide, true)
        if data.award ~= nil and data.award.item ~= nil then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data,
                function()
                    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
                    if offset > 0 then
                        require "CommonTipManager".OpenPowerUpView(power, offset)
                    end
                    -- self:OpenCardCommon(tempCardData)
                end
            )
        else
            -- self:OpenCardCommon(tempCardData)
            local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(power, offset)
            end
        end
    end

    --region --------------------------------------把吃的卡下阵--------
    local embattleArr = {}
    for index, carduid in ipairs(Cardids) do
        if self.EmbabbleUids[carduid] == true then
            table.insert(embattleArr, carduid)
        end
    end
    if #embattleArr then
        require("EmbattleModel"):GetInstance():SetEmbattleDownByUidTable(embattleArr)
    end
    --endregion------------------------------------把吃的卡下阵--------

    ---清空  (可再选该卡 )
    self.CardData = nil

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CardDevelopView_upOver.Name,
        self,
        Params_CardDevelopView_upOver
    )
    require("CardResonanceModel"):GetInstance():AddMaxSids(mCardData.sid, mCardData.star)
    ---检测共鸣神石核心
    -- require("CardResonanceModel"):GetInstance():UpdateAllPosCard()
    --刷新红点形象
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PlayerRole.id, mCardData.sid)
    --卡牌升星后 获得成长星辉
    require "PlayerTreeModel":GetInstance():GetGrow()
    require("CardInheritModel"):GetInstance():CheckInheritBuffLock(true)
    require "CardInfoManager":GetInstance():RedPointItemCardDevelopAllUpstar_Init()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RoleArtifact.id, mCardData.uid)
    require "RedPointManager":GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.RedPointCardUpStar.id,
        mCardData.uid
    )
    self:DelayUpdataLoopList()
end

