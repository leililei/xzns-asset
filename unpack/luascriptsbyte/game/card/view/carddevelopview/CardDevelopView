function CardDevelopView:CheckCardHaveTips()
    local showTips = false

    local len = #self.UpStarDelCardDataList
    for i = 1, len do
        local CardData = self.UpStarDelCardDataList[i]
        if require("CardInfoManager"):GetInstance():CheckMultiMatch(6,CardData.cfg.Elements_new) and self.CardData.cfg.id ~= CardData.cfg.id then
            showTips = true
            break
        end
    end
    return showTips
end

