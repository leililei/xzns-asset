---@param CardData CardData
function CardDevelopView:SetCard(lua, CardData, isBlack, index, condition)
    self:SetCardBlack(lua, isBlack)
    if CardData ~= nil then
        lua:ShowCardData(CardData, nil, true, index == nil)
        ---true显示五行
        local isShowE = true

        local haveE = self:GetSelectCardArrinfo_ele(condition or self.upstarCondition_1)
        ---如果是副卡
        if index ~= nil and index > 0 then
            --如果没选中
            if isBlack then
                --如果待吃任意五行就不显示图标
                if haveE == _G.CardElementType.None then
                    isShowE = false
                end
            end
        end
        if isShowE then
            if CardData.type == _G.CardType.Prop then
                if isBlack and self.NowSelectCard then --取消选择材料卡
                    lua:SetElements(self.NowSelectCard:GetElement_new())
                end
            else
                lua:SetElements(haveE)
            end
        end
        lua:HideOrShowElements(isShowE)
        lua:HideOrShowProfession(true)
    end
end

