function CardDevelopView:AutoSelectMaterialOneSelf(Materials, SelectCardData)
    if Materials and Materials[2] then
        local MaterialCount = Materials[2]
        local MaterialIndex = 1
        local UpStarConditions = {
            self.upstarCondition_1,
            self.upstarCondition_2,
            self.upstarCondition_3
        }
        for _, CardData in pairs(self.CardList) do
            if CardData.uid ~= SelectCardData.uid and self:IsMatchCardArrinfo(UpStarConditions[MaterialIndex], CardData) then
                if CardData.shenshiPosType == _G.StonePosType.PosZero then --共鸣神石槽位卡牌不自动上
                    self:Ritht_SetSelect(CardData, true, MaterialIndex)
                    if MaterialIndex >= MaterialCount then
                        return
                    end
                    MaterialIndex = MaterialIndex + 1
                end
            end
        end
    end
end

function CardDevelopView:OnClickBtn_LoopListCardItem(Params)
    if self.isReadyUpStar then
        return
    end
    local index = Params[1]
    ---@type ItemCardBodySelectView
    local itemLua = Params[2]
    ---@type CardData
    local Cardata = self.CardList[index]
    self.NowSelectCardData = Cardata
    local upStarid = require("CardInfoManager"):GetInstance():GetStarCfgId(Cardata.cfg.Elements_new or Cardata.cfg.Elements, Cardata.star)
    local cfg = _G.ConfigManager.card_star_cfg[upStarid]
    if cfg == nil or (_G.table.isEmptyOrNil(cfg.materials_oneself) and _G.table.isEmptyOrNil(cfg.materials_elements)) then
        if not require("CardInfoManager"):GetInstance():CheckMultiMatch(_G.CardElementType.Common, Cardata.cfg.Elements_new) then
            _G.PopWindowManager:ShowAllTips(1001, _G.GetLangPackValue(90028300019))
            return
        end
    end
    local rightSeleceIndex = self.Right_SelectCardDic[Cardata.uid]
    if rightSeleceIndex ~= nil then
        Cardata = self:IfSelectPropCardData(Cardata, rightSeleceIndex > 0, rightSeleceIndex)
        --- 如果已选中 则取消选中
        if rightSeleceIndex > 0 then
            self:Ritht_SetSelect(Cardata, rightSeleceIndex < 0, rightSeleceIndex, true)
            if Cardata.type == _G.CardType.Prop then
                local changeCount = self:UpdataLoopList(true, true)
                if changeCount then
                    self:SetRefreshAllShownItem(true)
                end
            else
                self:SetRefreshAllShownItem(true)
            end
            return
        end
        if Cardata.type == _G.CardType.Prop then
            if rightSeleceIndex < 0 then
                local tempRightSeleceIndex = self:CalculateRightIndex(Cardata)
                if tempRightSeleceIndex ~= nil then
                    rightSeleceIndex = tempRightSeleceIndex * -1
                end
            end
            self:Ritht_SetSelect(Cardata, rightSeleceIndex < 0, rightSeleceIndex, true)
            local changeCount = self:UpdataLoopList(true, true)
            if changeCount then
                self:SetRefreshAllShownItem(true)
            end
        else
            -- if Cardata.shenshiPosType ~= _G.StonePosType.PosZero then --共鸣神石槽位卡
            --     _G.PopWindowManager:GetInstance():ShowAllTips(170305)
            --     return
            -- end
            ---否则判断是否可选 提示 上锁 下阵
            require("CardInfoManager").CardReadyDestroy(
                Cardata,
                function()
                    --updataCall
                    -- self:SetRefreshAllShownItem()
                end,
                function(ReData)
                    ---okCall

                    if ReData.isEmbattle then
                        ---记录 该卡真被吃的时候要下阵
                        self.EmbabbleUids[Cardata.uid] = true
                    end

                    --- 如果当前 不在槽位
                    if rightSeleceIndex < 0 then
                        ---如果预定槽位已经满了
                        -- local isFull = self:CheckRightIsFull(rightSeleceIndex)
                        -- if isFull == true then
                        --- 重新计算 看别的槽位
                        local tempRightSeleceIndex = self:CalculateRightIndex(Cardata)
                        if tempRightSeleceIndex ~= nil then
                            rightSeleceIndex = tempRightSeleceIndex * -1
                        end
                        -- end
                    end

                    self:Ritht_SetSelect(Cardata, rightSeleceIndex < 0, rightSeleceIndex, true)
                    self:SetRefreshAllShownItem(true)
                    return
                end,
                function()
                    return
                end
            )
        end
        return
    end
    if Cardata.type == _G.CardType.Prop then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsIdDic.cantUpStar)
        return
    end
    if self.CardData ~= nil then
        if Cardata.uid == self.CardData.uid then
            self:UpdataLoopList()
            self:UpdatePropCardData()
            return
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsIdDic.bfh)
            return
        end
    end

    if self.mCardInfoManager:IsMaxUpStar(Cardata) then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsIdDic.maxStar)
        return
    end

    --region ------------------------------------当前选中卡牌----------
    if self.nowItemLua ~= nil then
        self.nowItemLua:SetSelect(false)
    end
    if itemLua then
        self.nowItemLua = itemLua
        self.nowItemLua:SetSelect(true)
    end

    --endregion

    Cardata = self:FindSameEmbattleCard(Cardata)
    self.CardData = Cardata

    self.ShowCfg = require("CardInfoManager").GetCardSkin_ShowCfg(self.CardData.skin, self.CardData.sid)

    self:SetCardSpine(self.CardData)
    self.go_table.obj_Order:SetActiveE(1)
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.CardData.cfg.Name)

    --设定元素和职业图标
    CardInfoManager:GetInstance():SetElementsProfessionalSP(self.go_table.aorimage_element,
        self.CardData.cfg.Elements_new)
    -- 设置星级 最高5星 (不为阶级)
    local SpriteName
    for i = 1, 5 do
        SpriteName = CardInfoManager:GetInstance():GetHuoSpriteName(self.CardData.star, i)
        self.go_table["aorimage_star" .. i].SpriteName = SpriteName
        self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
    end
    self:SetInitSelectCard(cfg.materials_oneself, cfg.materials_elements, Cardata)

    self.NowSelectCard = Cardata

    self:ClearSelect()

    local ismaxCount_1 = self.NowSelectCardChild_1_MaxCount ~= 0
    if ismaxCount_1 then
        self:SetCountText(self.CardIndexLuaEnum.one.go_table.aortext_num, 0, self.NowSelectCardChild_1_MaxCount)
    end

    local ismaxCount_2 = self.NowSelectCardChild_2_MaxCount ~= 0
    if ismaxCount_2 then
        self:SetCountText(self.CardIndexLuaEnum.two.go_table.aortext_num, 0, self.NowSelectCardChild_2_MaxCount)
    end

    local ismaxCount_3 = self.NowSelectCardChild_3_MaxCount ~= 0
    if ismaxCount_3 then
        self:SetCountText(self.CardIndexLuaEnum.three.go_table.aortext_num, 0, self.NowSelectCardChild_3_MaxCount)
    end

    self:AutoSelectMaterialOneSelf(cfg.materials_oneself, Cardata)

    local count1 = math.ceil(#self.CardList / self.mItemCountPerRow)
    if self.loopCount ~= count1 then
        self.loopCount = count1
        self.mlistView2:SetListItemCount(count1)
    end
    self:SetRefreshAllShownItem()
    self:OnClick_BtnType(self.mEnum.filter.all)
    return
end

---@param Cardata CardData
function CardDevelopView:SetInitSelectCard(oneSelfArr, ElementsArr, Cardata)
    ---- 策划需求 神 同族吃任意五行包括神   每个槽位 只能选一张卡

    self.upstarCondition_1 = nil
    self.upstarCondition_2 = nil
    self.upstarCondition_3 = nil

    self.NowSelectCardChild_1_MaxCount = 0
    self.NowSelectCardChild_2_MaxCount = 0
    self.NowSelectCardChild_3_MaxCount = 0

    self:SetSelectCard(self.CardIndexLuaEnum.main, Cardata)

    ---@param arr  number[] 吃卡信息 _{星级，数量，五行/0任意，sid/0任意，}
    ---@param star  number 星级
    ---@param num  number 该槽位吃卡数量
    ---@param ele  number 五行/0任意
    ---@param sid  number sid/0任意
    local NowIndex, arr, star, num, ele, sid

    --- 当前槽位索引 每个槽位吃一张卡  最多吃2张  策划保证配置最多吃两张
    --- 说出去的话就像拉出去的shi有策划不当人 现在最多吃3张
    NowIndex = 0
    if oneSelfArr ~= nil then
        if oneSelfArr[2] ~= nil then
            star = oneSelfArr[1]
            num = 1
            sid = Cardata.sid
            ele = Cardata.cfg.Elements_new
            NowIndex = NowIndex + 1
            self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
            if oneSelfArr[2] == 2 then
                --- 2  第2张
                NowIndex = NowIndex + 1
                self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
            end
            if oneSelfArr[2] == 3 then
                --- 3  第3张
                NowIndex = NowIndex + 1
                self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
                NowIndex = NowIndex + 1
                self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
            end
        end
    end

    if ElementsArr ~= nil then
        if ElementsArr[2] ~= nil then
            star = ElementsArr[1]
            num = 1
            sid = 0
            if require("CardInfoManager"):GetInstance():CheckMultiMatch(6, Cardata.cfg.Elements_new) then
                ---神吃任意五行
                ele = 0
            else
                ele = Cardata.cfg.Elements_new
            end
            NowIndex = NowIndex + 1
            self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)

            if ElementsArr[2] == 2 then
                NowIndex = NowIndex + 1
                self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
            end
            if ElementsArr[2] == 3 then
                NowIndex = NowIndex + 1
                self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
                NowIndex = NowIndex + 1
                self:SetSingleSelectCard(NowIndex, { star, num, ele, sid }, Cardata)
            end
        end
    end
    self.CardIndexLuaEnum.one.gameObject:SetActiveE(NowIndex >= 1 and 1 or 0)
    self.CardIndexLuaEnum.two.gameObject:SetActiveE(NowIndex >= 2 and 1 or 0)
    self.CardIndexLuaEnum.three.gameObject:SetActiveE(NowIndex >= 3 and 1 or 0)
end

