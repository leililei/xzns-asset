function CardDevelopView:InitOneKeyRedPointDict(CardList)
    local cfg = _G.ConfigManager.discrete_cfg[100505]
    local minStar = cfg[1][1]
    local maxStar = cfg[1][2]
    self.OneKeyCard = {}
    local CardInfoManagerIns = require("CardInfoManager"):GetInstance()
    for _, v in pairs(CardList) do
        if v:GetStar() >= minStar and v:GetStar() <= maxStar then
            if CardInfoManagerIns:CheckCanUpStar(v.uid) then
                self.OneKeyCard[v.uid] = true
            end
        end
    end
end

---升星会返装备  检测装备背包是否能容纳
function CardDevelopView:CheckEquipmentStorageMax()
    --- 返数量
    local reCount = 0
    local len = #self.UpStarDelCardDataList
    for i = 1, len do
        local CardData = self.UpStarDelCardDataList[i]
        if CardData ~= nil then
            reCount = reCount + CardData:GetEquipBarNumber()
        end
    end

    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)

    local isok = true
    if reCount > 0 then
        if _G.table.count(list) + reCount > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Equipment) then
            isok = false
        end
    end

    return isok, reCount
end

