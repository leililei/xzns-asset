function CardDevelopView:OnCreate(Data, callzhenrong, isFromCardShow)
    self.isFromCardShow = isFromCardShow
    if Data ~= nil then
        self.closeFun = Data.closeFun
        self.openFun = Data.openFun
        if Data.cardUid then
            self.TempCardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, Data.cardUid)
        else
            self.inited = true
        end
    end
    if callzhenrong ~= nil then
        self.callzhenrong = callzhenrong
    end
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData)

    if self.mlistView2 == nil then
        self.go_table.looplist2_loop:InitListView(0, _G.handler(self, self.RefreshRenItem))
        self.mlistView2 = self.go_table.looplist2_loop
    end
    self.initToggleState = true
    self.go_table.toggle_auto.isOn = require("CardInfoManager"):GetInstance():CheckAutoCardDevelopToggle()
    self.initToggleState = false
    self:InitPropCardData()
    --UIUtils.IsNeedChangeUI(IsNeedChangeUI.CardDevelopView,self.go_table)
    if AppSetting.IsXzns then
        local cfg = ConfigManager.discrete_cfg[200801]
        if cfg then
            local isUnlock = GlobalConditionManager.CheckConditionByArray(cfg)
            self.go_table.toggle_auto:SetActiveE(isUnlock and 1 or 0)
        end
    end
end

function CardDevelopView:OnEnable()
    if self.prb_sceneTrans ~= nil then -- 切换时隐藏 禁用场景摄象机
        _G.GameUtil.SetActiveByCondition(self.prb_sceneTrans, true)
    end
end

function CardDevelopView:SetData()
    if not self.ResList then
        return
    end

    self.sx_Elements.data = self.mEnum.filter.all
    self:UpdataLoopList()
    --- 延迟一秒 (loopitem异步加载)
    _G.DelayDo(
        0.2,
        function()
            if not self.ResList then
                return
            end
            self.InitLoop = true
        end
    )

    if self.openFun ~= nil then
        self.openFun()
        self.openFun = nil
    end
end

function CardDevelopView:UpdataLoopList(isNotClear, isNotMove)
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local CardList = CardInfoManager:GetSortUpStarLvSid()
    if not isNotClear then
        self.CardData = nil
        self.go_table.obj_Order:SetActiveE(0)
        self:ClearSelect()
        self.NowSelectCard = nil
        self.DisCardCount = 0
        ---如果真吃的时候要下阵的卡 (真吃的时候在下 否则下阵了 但没吃,取消了 阵容找卡的逻辑会异常)
        self.EmbabbleUids = {}
        self:InitOneKeyRedPointDict(CardList)
    end
    local showLength = #CardList
    if self.CardData then
        CardList, self.DisCardCount = require("CardInfoManager").GetNotSelfDogFoodCards(self.CardData)
        self.DisCardCount = self.DisCardCount - 1
        _G.table.insert(CardList, self.CardData)
        ---不显示卡牌自身 ZHJH-2410【客户端】晋升大厅优化-01
        --_G.table.insert(CardList, self.CardData)
    end
    self.hideCount = #CardList + self.DisCardCount - showLength + 1
    -- self.hideCount = #CardList
    local propCards = _G.table.toArray(self.propCards)
    _G.SortList(
        propCards,
        function(CardData)
            return -(CardData:GetElement() % 7)
        end
    )
    -- 因为材料卡不进入背包，所以需要手动对材料卡能否当狗粮进行判断
    if self.CardData then
        local cfg = _G.ConfigManager.card_star_cfg
            [require("CardInfoManager"):GetInstance():GetStarCfgId(self.CardData.cfg.Elements_new, self.CardData.star)]
        local star = #cfg.materials_elements ~= 0 and cfg.materials_elements[1] or self.CardData.star
        if cfg.materials_oneself[1] and star == self.CardData.star then
            star = cfg.materials_oneself[1]
        end
        local element = self.CardData:GetElement_new()
        local isGod = require("CardInfoManager"):GetInstance():CheckMultiMatchCOP(element, _G.CardElementType.God)
        local confirm = false
        for _, v in pairs(propCards) do
            confirm = false
            if v.star == star and v.uid ~= self.CardData.uid then
                if isGod then
                    -- 不需要消耗其他卡牌  并且  为同种卡牌
                    if #cfg.materials_elements == 0 and v.cfg.id == self.CardData.cfg.id then
                        -- 需要消耗其他卡牌
                        confirm = true
                    elseif #cfg.materials_elements ~= 0 then
                        confirm = true
                    end
                elseif
                    (require("CardInfoManager"):GetInstance():CheckMultiMatchCOP(v:GetElement_new(), element) and #cfg.materials_elements ~= 0) or v.cfg.id == self.CardData.cfg.id or
                    (require("CardInfoManager"):GetInstance():CheckMultiMatchCOP(v:GetElement_new(), _G.CardElementType.Common))
                then
                    confirm = true
                end
            end
            if confirm then
                _G.table.insert(CardList, v)
            else
                self.DisCardCount = self.DisCardCount + 1
            end
        end
    else
        ---ZHJH-3649 未选中角色不显示材料卡
        -- for _, v in pairs(propCards) do
        --     _G.table.insert(CardList, v)
        -- end
    end

    local maxCount = 0
    self.CardList =
        _G.table.chooseToArray(
            CardList,
            function(cardUid, CardData)
                ---满星不显示 镇魂街ZHJ-3998 新角色系统ZHJ-11323【角色】奇卡升星至星级上限后，仍然显示在升星列表内。
                if CardInfoManager:IsMaxUpStar(CardData) then
                    maxCount = maxCount + 1
                    return false
                end
                if self.sx_Elements.data ~= 0 then
                    if not require("CardInfoManager"):GetInstance():CheckMultiMatch(self.sx_Elements.data, CardData.cfg.Elements_new) and
                        not require("CardInfoManager"):GetInstance():CheckMultiMatch(_G.CardElementType.Common, CardData.cfg.Elements_new) then --7为通用材料
                        return false
                    end
                end

                if self.sx_Type.data ~= 0 then
                    if CardData.cfg.EquipmentType ~= self.sx_Type.data then
                        return false
                    end
                end

                if self.sx_Professional.data ~= 0 then
                    if CardData.cfg.Professional ~= self.sx_Professional.data then
                        return false
                    end
                end
                return true
            end
        )
    if self.maxCount == nil then
        self.maxCount = maxCount
    end
    self.OriginCardList = self.CardList
    if isNotClear then
        self:SelectUpdataSort()
    end

    self:SetCardUpTips()
    self.OriginCardList = self.CardList
    if not isNotClear then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_hideBtn, false)
        _G.UIUtils.RemoveChildren(self.go_table.obj_spineRoot)
    end
    local count1 = math.ceil(#self.OriginCardList / self.mItemCountPerRow)
    local changeCount = false

    if self.loopCount ~= count1 then
        self.loopCount = count1
        changeCount = true
        self.mlistView2:SetListItemCount(count1, not isNotMove)
    else
        self:SetRefreshAllShownItem(isNotMove)
    end

    --local isCanUp = self:CheckUpStarAll()
    self:SetUpStarAllBtnGray()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, true)
    -- self.go_table.looplist2_loop:SetRectTransformSize(465.95, isCanUp and 514 or 581)
    if self.TempCardData then
        local idx = 1
        for i, v in pairs(self.CardList) do
            if v.uid == self.TempCardData.uid then
                idx = i
                break
            end
        end
        self.TempCardData = nil
        self:OnClickBtn_LoopListCardItem({ idx })
    end
    return changeCount
end

---选择后排序
---//没选卡牌的时候页面排序：可升星＞不可升星
---选了卡牌之后：主卡＞符合条件的卡牌＞其他卡牌 同类型按照品质 uid排序 如果本次升级需要本体 则符合条件的本子排在前 单号ZHJ-14078
function CardDevelopView:SelectUpdataSort()
    if self.NowSelectCard == nil then
        return
    end
    local mainUId = self.NowSelectCard.uid
    local mainSid = self.NowSelectCard.sid
    local haveCard_1 = #self.NowSelectCardChild_1 == self.NowSelectCardChild_1_MaxCount
    local haveCard_2 = #self.NowSelectCardChild_2 == self.NowSelectCardChild_2_MaxCount
    local haveCard_3 = #self.NowSelectCardChild_3 == self.NowSelectCardChild_3_MaxCount
    self.CardList = self.OriginCardList

    -- 若为本身则移除
    for i = #self.CardList, 1, -1 do
        -- if self.CardList[i].uid == self.CardData.uid then
        --     table.remove(self.CardList, i)
        if self.CardList[i].uid ~= self.CardData.uid and not self:IsMatchAtLeastOneCardArrInfo(self.CardList[i]) then
            table.remove(self.CardList, i)
        end
    end
    ---@param CardData CardData
    _G.SortList(
        self.CardList,
        function(CardData)
            local uid = CardData.uid
            local sid = CardData.sid
            local order = 0
            local sameCard = mainSid == sid and 1 or 0
            if CardData.uid == self.CardData.uid then
                sameCard = 1000
            end
            local rightSeleceIndex = self.Right_SelectCardDic[uid]
            if uid == mainUId then
                order = -99
            else
                local match = self:IsMatchAtLeastOneCardArrInfo(CardData)
                if match then
                    if CardData.shenshiPosType ~= _G.StonePosType.PosZero then
                        order = 90
                    else
                        order = 99
                    end
                else
                    if CardData.shenshiPosType ~= _G.StonePosType.PosZero then
                        order = -98
                    else
                        order = -90
                    end
                end
            end
            return order + sameCard, rightSeleceIndex ~= nil and 1 or 0, -CardData.Grade, -CardData.type, -CardData:GetElement(

                ), -CardData:GetRealLevel(), uid
        end
    )
end

---至少满足一个格子的条件（可作为狗粮）
function CardDevelopView:IsMatchAtLeastOneCardArrInfo(CardData)
    return self:IsMatchCardArrinfo(self.upstarCondition_1, CardData) or
        self:IsMatchCardArrinfo(self.upstarCondition_2, CardData) or
        self:IsMatchCardArrinfo(self.upstarCondition_3, CardData)
end

function CardDevelopView:SetRefreshAllShownItem(isNotMove)
    local Index = 1
    local min1Index = nil
    local min2Index = nil
    local min3Index = nil

    for Index, CardData in pairs(self.CardList) do
        self:CheckRightSelect(CardData)
    end

    self:SelectUpdataSort()

    if Index ~= nil and not isNotMove then
        local count1 = math.ceil(Index / self.mItemCountPerRow)
        if count1 > 0 then
            count1 = count1 - 1
        end
        self.mlistView2:MovePanelToItemIndex(count1)
    else
        self.mlistView2:RefreshAllShownItem()
    end
end

