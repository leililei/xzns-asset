function CardDevelopView:UpStarCall(allCard)
    local havePrecious = false
    local haveCore = false
    local hasMain = false
    local haveSP = false
    self.UpStarDelCardDataList = {}
    ---升星消耗材料卡list
    self.UpStarConsumePropList = {}
    for i = 1, #allCard do
        local cardid = allCard[i]
        local CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardid)
        if _G.table.isEmptyOrNil(CardData) == false then
            _G.table.insert(self.UpStarDelCardDataList, CardData)
            if self.NowSelectCard.sid == CardData.sid then
                hasMain = true
            end

            if CardData:GetGrade() >= 5 and self:GetSelectCardArrinfo_sid(self["upstarCondition_" .. i]) == 0 then --核心卡
                haveCore = true
                if CardData:GetGrade() == 7 then 
                    haveSP = true
                end
            end
        else
            _G.table.insert(self.UpStarConsumePropList, self.propCards[cardid])
        end
    end
    ---ZHJ-27934 当吃的卡有本地时不在显示precious提示
    -- if hasMain then
    --     havePrecious = false
    -- end

    if self:CheckEquipmentStorageMax() == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsIdDic.storage_max_Equipment)
        return
    end
    local upStar = function()
        self:UpStarTips1(
            function()
                self:UpStarTips2(
                    function()
                        self:ReadyUpStar2()
                    end
                )
            end
        )
    end
    if haveSP then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            self.tipsIdDic.spCard,
            nil,
            function()
                upStar()
            end
        )
    elseif haveCore then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            self.tipsIdDic.core,
            nil,
            function()
                upStar()
            end
        )
    else
        upStar()
    end
end

