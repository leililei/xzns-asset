        self.loopTimer:Stop()
        self.loopTimer = nil
    end
    self.loopTimer = _G.TimerManager:GetInstance():GetTimer(2, self.DelayUpdataLoopListEnd, self, true, true, true)
    self.loopTimer:Start()
end

function CardDevelopView:DelayUpdataLoopListEnd()
