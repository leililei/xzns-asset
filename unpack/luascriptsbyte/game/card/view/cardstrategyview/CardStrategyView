local CardStrategyView = _G.BaseClass("CardStrategyView", _G.UIBaseView)
local EmbattleController = require "EmbattleController"
--_G.CardStrategyView = CardStrategyView

local CS = _G.CS
local typeof = _G.typeof

function CardStrategyView:Awake()
    self.mCardStrategyManager = require("CardStrategyManager"):GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.CloseView
        },
        ["@_aorbtn_itemCombSkill1"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handlerbind(self, self.OnClickCombSkill, 1)
        },
        ["@_aorbtn_itemCombSkill2"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handlerbind(self, self.OnClickCombSkill, 2)
        },
        ["@_aorbtn_itemCombSkill3"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handlerbind(self, self.OnClickCombSkill, 3)
        },
        ["@_aorbtn_itemBsx1"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handlerbind(self, self.OnClickGuide, 1)
        },
        ["@_aorbtn_itemBsx2"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handlerbind(self, self.OnClickGuide, 2)
        },
        ["@_aorbtn_itemBsx3"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handlerbind(self, self.OnClickGuide, 3)
        },
        ["@_aorbtn_Configuration"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handler(self, self.OnClickConfiguration)
        },
        ["@_aorbtn_iihui"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = _G.handler(self, self.OnClickLihui)
        }
    }
end

function CardStrategyView:OnEnable()
end

---界面的入口函数
---@param  Data params_CardStrategyView
---@param  sid params_CardStrategyView -- 引导使用
function CardStrategyView:OnCreate(sid, Data)
    if _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing then
        self.type = 1 --0:功能界面 1:引导界面
        self.curSelectRole = nil
    else
        self.type = 0
    end
    local cardData
    if sid ~= nil then
        cardData = _G.StorageManager:GetInstance():GetMaxPowerCardBySid(sid)
    end
    self.CardData = cardData and cardData or Data
    self.RecommendRoleItemList = {}
    self.Cardcfg = self.mCardStrategyManager.Cardcfg
    self.cfg = self.Cardcfg[self.CardData.sid]
    self.UnitType = self.cfg.UnitType == 1 --1为寄灵人 0为守护灵
    self.CombSkills = {}
    self:GetCombSkills()
    self.RecommendRole = {
        [1] = _G.GetAutoGoTable(self.go_table.obj_item1),
        [2] = _G.GetAutoGoTable(self.go_table.obj_item2),
        [3] = _G.GetAutoGoTable(self.go_table.obj_item3)
    }
    self:InitView(self.type)
end
function CardStrategyView:InitView(type)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Configuration, type ~= 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_itemBsx1, type ~= 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_itemBsx2, type ~= 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_itemBsx3, type ~= 0)
    self:SetRole()
    self:SetRecommendRole()
end
function CardStrategyView:SetRole()
    self.go_table.aorrawimage_Role:LoadImage(
        self.cfg.Portrait,
        function(trans)
            if not trans then
                return
            end
            trans:SetNativeSize()
            local x = self.cfg.pos_portrait[1] or 0
            local y = self.cfg.pos_portrait[2] or 0
            local z = self.cfg.pos_portrait[3] or 0
            trans:SetLocalPosition(x, y, z)
            local size = self.cfg.size2 > 0 and self.cfg.size2 or 1
            trans.rectTransform:SetLocalScaleXYZ(size)
            trans.Alpha = 1
        end
    )
    self.go_table.aorimage_Elements.SpriteName = self.mCardStrategyManager.Order[self.cfg.Order]
    self.go_table.aortext_RoleNameDi.text = _G.LangUtil.GetLangPackValue(self.cfg.Name)
    self.go_table.aortext_RoleName.text = _G.LangUtil.GetLangPackValue(self.cfg.Name)
    self.go_table.aortext_RoleDescDi.text = _G.LangUtil.GetLangPackValue(self.cfg.recommend_doc[1])
    self.go_table.aortext_RoleDesc.text = _G.LangUtil.GetLangPackValue(self.cfg.recommend_doc[1])
end
function CardStrategyView:SetRecommendRole()
    for i = 1, 3 do
        self.RecommendRole[i].aortext_CombSKillDesc.text = _G.LangUtil.GetLangPackValue(self.cfg.recommend_doc[i + 1])
        local cardData = _G.StorageManager:GetInstance():GetDatasBySidGuide(_G.StorageID.Card, self.cfg.recommend[i])
        local cardCfg = self.Cardcfg[self.cfg.recommend[i]]
        self:InitCardBodyItem(
            cardCfg,
            self.RecommendRole[i].obj_bsx,
            function(item)
                _G.table.insert(self.RecommendRoleItemList, item)
                if #cardData == 0 then
                    item:SetGray(true)
                end
            end
        )
        if #cardData == 0 then
            self.RecommendRole[i].aorrawimage_itemMask:SetActiveE(1)
            self.RecommendRole[i].aorimage_combSkillBg:SetGray(true)
            self.RecommendRole[i].aorrawimage_combSkill:SetGray(true)
        end
        local _, skillid2 = EmbattleController:GetInstance():GetCombSkill(self.CombSkills[i][1], self.CombSkills[i][2])
        local cfg = self.mCardStrategyManager.card_skills_cfg[skillid2]
        if cfg then
            self.RecommendRole[i].aorrawimage_combSkill:LoadImage(cfg.icon)
        end
    end
end
function CardStrategyView:InitCardBodyItem(cfg, parent, callback)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.baseBodyItem,
        parent,
        function(item)
            item.transform:SetLocalPositionToZero()
            item:SetLocalScale(1, 1, 1)
            callback(item)
            item:ShowCardData(
                {sid = cfg.id, lv = 1, star = cfg.Star, soulLink_lv = 0},
                _G.handlerbind(self, self.OnClickRecommondRole, cfg)
            )
        end
    )
end
function CardStrategyView:GetCombSkills()
    for i = 1, 3 do
        if self.UnitType then
            _G.table.insert(self.CombSkills, {self.CardData.sid, self.cfg.recommend[i]})
        else
            _G.table.insert(self.CombSkills, {self.cfg.recommend[i], self.CardData.sid})
        end
    end
end
---BtnClick
function CardStrategyView:OnClickRecommondRole(_, cfg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardStrategyInfoView.Name, cfg)
end
function CardStrategyView:OnClickCombSkill(_, go, isOn, index)
    local herosid = self.CombSkills[index][1]
    local guardianid = self.CombSkills[index][2]
    local hero = {sid = herosid, star = self.Cardcfg[herosid].Star, lv = 1, soulLink_lv = 0}
    local guardian = {sid = guardianid, star = self.Cardcfg[guardianid].Star, lv = 1, soulLink_lv = 0}
    local posx, posy, posz = self.RecommendRole[index].aorrawimage_combSkill:GetPosition()
    local pos = {x = posx, y = posy, z = posz}
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CombSkillTipsView.Name, hero, guardian, nil, pos)
end
function CardStrategyView:OnClickGuide(_, go, isOn, index)
    self.RecommendRole[1].aorrawimage_SelectMask:SetActiveE(1)
    self.RecommendRole[2].aorrawimage_SelectMask:SetActiveE(1)
    self.RecommendRole[3].aorrawimage_SelectMask:SetActiveE(1)
    if self.curSelectRole then
        self.RecommendRole[self.curSelectRole].aorimage_Select:SetActiveE(0)
    end
    self.curSelectRole = index
    if self.RecommendRole[self.curSelectRole].aorimage_Select:GetctiveInHierarchy() == 0 then
        self.RecommendRole[self.curSelectRole].aorrawimage_SelectMask:SetActiveE(0)
        self.RecommendRole[self.curSelectRole].aorimage_Select:SetActiveE(1)
    end
end
function CardStrategyView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    else
        name = "nilFnc"
    end
end
function CardStrategyView:OnClickLihui(_, go, isOn)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardStrategyInfoView.Name, self.cfg)
end
function CardStrategyView:OnClickConfiguration()
    local curEmbattleItem = EmbattleController:GetInstance():GetCurEmbattleItem()
    local CheckRoleBattle = true
    local CheckReCommRoleBattle = true
    local RoleBattleIndex = nil
    local ReCommRoleBattleIndex = nil
    if
        _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing and
            _G.GuideManager:GetInstance().CurGuideId == 20417
     then
        local guardianData = {
            level = 1,
            sid = 124220000,
            soulLink_lv = 0,
            star = 5,
            uid = 1
        }
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CombSkillEmbattleView.Name,
            self.CardData,
            guardianData,
            function()
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name)
                if view then
                    view:Close()
                end
                self:Close()
            end
        )
        return
    end
    local RoleSid = self.CardData.sid
    local RecommondRoleSid = self.cfg.recommend[self.curSelectRole]
    --拿到当前选中推荐卡牌数据 当前角色数据 调接口 进行合击技组合 组合时判断(各种组合方式)
    local getUid = function(Roles)
        for _, v in pairs(Roles) do
            return v.uid
        end
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    if not view then
        return
    end
    --检查卡牌是否可以上阵
    for i, v in pairs(curEmbattleItem.curEmbattleData[1]) do
        if v.sid ~= self.CardData.sid then
        else
            CheckRoleBattle = false
            RoleBattleIndex = i
            self.mCardStrategyManager:GetChooseIndex(i)
        end
        if v.sid ~= self.cfg.recommend[self.curSelectRole] then
        else
            CheckReCommRoleBattle = false
            ReCommRoleBattleIndex = i
            self.mCardStrategyManager:GetChooseIndex(i)
        end
    end
    local OnChooseCloseCall = function()
        view:OnChooseCloseCall()
        self:Close()
    end
    local OpenViewCall
    OpenViewCall = function(_, name)
        if name == _G.ConfigManager.ui_cfg.EmbattleChooseView.Name then
            local chooseView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name)
            local RoleIndex = function()
                local index
                for i, v in pairs(chooseView.cardList) do
                    if RoleSid == v.sid then
                        index = i
                        break
                    end
                end
                for i, v in pairs(chooseView.curIds) do
                    if index == v then
                        return i + #chooseView.embattleIds
                    end
                end
            end
            local RecommendRoleIndex = function()
                local index
                for i, v in pairs(chooseView.cardList) do
                    if RecommondRoleSid == v.sid then
                        index = i
                        break
                    end
                end
                for i, v in pairs(chooseView.curIds) do
                    if index == v then
                        return i + #chooseView.embattleIds
                    end
                end
            end
            if CheckRoleBattle then
                chooseView:OnItemClick(RoleIndex())
            end
            if CheckReCommRoleBattle then
                chooseView:OnItemClick(RecommendRoleIndex())
            end
            --两张卡已经组合上阵
            if
                not CheckRoleBattle and not CheckReCommRoleBattle and RoleBattleIndex < ReCommRoleBattleIndex and
                    ReCommRoleBattleIndex - RoleBattleIndex == 1
             then
                if EmbattleController:GetInstance():GetChangeAuto() then
                    chooseView:CheckNextIndex()
                else
                    chooseView.go_table.scrollloopvectical_card:UpdateAllItem()
                    chooseView:InitCardImage()
                    chooseView:ShowDoneBtn()
                end
            end
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OpenViewCall, self)
        end
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, OpenViewCall, self)
    if not self.chooseIndex then
        self.chooseIndex = self.mCardStrategyManager:GetFirstEmptyIndex(curEmbattleItem.curEmbattleData[1])
        if self.chooseIndex ~= nil then
            require("EmbattleController"):GetInstance():OpenChooseCardView(
                curEmbattleItem,
                1,
                OnChooseCloseCall,
                self.chooseIndex
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(140108)
            self:Close()
        end
    else
        require("EmbattleController"):GetInstance():OpenChooseCardView(
            curEmbattleItem,
            1,
            OnChooseCloseCall,
            self.chooseIndex
        )
    end
end

---引导 典韦解锁
function CardStrategyView:SetoleUnlock()
    self.RecommendRoleItemList[1]:SetGray(false)
    self.RecommendRole[1].aorrawimage_itemMask:SetActiveE(0)
    self.RecommendRole[1].aorrawimage_combSkill:SetGray(false)
end
function CardStrategyView:CloseView()
    self:Close()
end

function CardStrategyView:OnDestroy()
    self.RecommendRoleItemList = nil
    self.CardData = nil
    self.cfg = nil
    self.CombSkills = nil
end

return CardStrategyView
