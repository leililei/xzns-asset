---根据等级判断 是否 是解锁
function CardShowView_RightView_hl:UpdateSuoIcon(sid)
    local hl_dataStatic = self.cardHLModel:GetAllExclusiveCf_attribute_display(sid)
    local level = self.cardData.soulLink_lv
    for i = 1, #hl_dataStatic do
        local tb = _G.GetAutoGoTable(self.skillNodes[i].obj)
        local suoobj = tb.obj_suonode:GetChildE(1)
        suoobj:SetActiveE(1)
        if self.cardData.soulLink_IsActivate == 1 then
            if hl_dataStatic[i].lv <= level then
                self.skillNodes[i].isActive = true
            else
                self.skillNodes[i].isActive = false
            end
        else
            self.skillNodes[i].isActive = false
        end
        _G.GameUtil.SetActiveByCondition(tb.obj_suonode, not self.skillNodes[i].isActive)
    end
end
