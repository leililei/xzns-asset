---设置小图标的进度条
function CardShowView_RightView_hl:UpdateSmallSkillJindu()
    if self.cardData.soulLink_IsActivate == 0 then
        return
    end
    local smallskillindex = 5
    local level = self.cardData.soulLink_lv
    if level == 0 then
        local tb = _G.GetAutoGoTable(self.skillNodes[2].obj)
        local suoobj = tb.obj_suonode:GetChildE(1)
        suoobj:SetActiveE(0)
    --self:PlayUnLockEffect(level, self.skillNodes[2].obj)
    end
    if level < smallskillindex then
        local aorjindu = self.skillsmallNodes[1].obj:GetChildE(1):GetComponentE(_G.typeof(_G.CS.AorImage))
        local num = math.fmod(level, 5)
        aorjindu.fillAmount = num * 0.2
        local tb = _G.GetAutoGoTable(self.skillsmallNodes[1].obj)
        self:SikllUpLevelEffect(level, tb, num, 1)
        self.skillsmallNodes[1].obj:GetChildE(1):SetActiveE(1)
        self.skillsmallNodes[1].obj:SetActiveE(1)
        self.skillsmallNodes[1].obj:GetChildE(3):SetActiveE(1)
        --关闭锁子
        local tb = _G.GetAutoGoTable(self.skillNodes[2].obj)
        local suoobj = tb.obj_suonode:GetChildE(1)
        suoobj:SetActiveE(0)
    elseif level == 5 then
        local tb = self.skillsmallNodes[1].obj
        tb = _G.GetAutoGoTable(tb)
        self.skillsmallNodes[1].obj:SetActiveE(1)
        self.skillsmallNodes[1].obj:GetChildE(0):SetActiveE(0)
        self.skillsmallNodes[1].obj:GetChildE(1):SetActiveE(0)
        self.skillsmallNodes[1].obj:GetChildE(3):SetActiveE(0)
        --播放技能解锁特效
        self:SikllChangzhuUIEffect(level, tb.obj_node)
        --下一层解锁图标消失（有一个 播放特效）
        --self:PlayUnLockEffect(level, self.skillNodes[3].obj)
        local tb = _G.GetAutoGoTable(self.skillNodes[3].obj)
        local suoobj = tb.obj_suonode:GetChildE(1)
        suoobj:SetActiveE(0)
    elseif level >= 30 then
        for i = 1, 6 do
            local tb = self.skillsmallNodes[i].obj
            tb = _G.GetAutoGoTable(tb)
            self.skillsmallNodes[i].obj:SetActiveE(1)
            self.skillsmallNodes[i].obj:GetChildE(0):SetActiveE(0)
            self.skillsmallNodes[i].obj:GetChildE(1):SetActiveE(0)
            self.skillsmallNodes[i].obj:GetChildE(3):SetActiveE(0)
            self:SikllChangzhuUIEffect(self.skillsmallNodes[i].level, tb.obj_node)
        end
    else --15 -57
        for i = 1, 6 do
            local tb = self.skillsmallNodes[i].obj
            tb = _G.GetAutoGoTable(tb)
            if level > self.skillsmallNodes[i].level then
                self.skillsmallNodes[i].obj:SetActiveE(1)
                self.skillsmallNodes[i].obj:GetChildE(0):SetActiveE(0)
                self.skillsmallNodes[i].obj:GetChildE(1):SetActiveE(0)
                self.skillsmallNodes[i].obj:GetChildE(3):SetActiveE(0)
                self:SikllChangzhuUIEffect(self.skillsmallNodes[i].level, tb.obj_node)
            elseif level == self.skillsmallNodes[i].level then
                local aorjindu = self.skillsmallNodes[i].obj:GetChildE(1):GetComponentE(_G.typeof(_G.CS.AorImage))
                self.skillsmallNodes[i].obj:SetActiveE(1)
                self.skillsmallNodes[i].obj:GetChildE(0):SetActiveE(0)
                self.skillsmallNodes[i].obj:GetChildE(1):SetActiveE(0)
                self.skillsmallNodes[i].obj:GetChildE(3):SetActiveE(0)
                --播放技能解锁特效
                self:SikllChangzhuUIEffect(self.skillsmallNodes[i].level, tb.obj_node)
                --下一层解锁图标消失（有一个 播放特效）
                if i ~= 6 then
                    tb = {}
                    tb = _G.GetAutoGoTable(self.skillNodes[i + 2].obj)
                    local suoobj = tb.obj_suonode:GetChildE(1)
                    suoobj:SetActiveE(0)
                    local tb2 = _G.GetAutoGoTable(self.skillNodes[i + 1].obj)
                    --self:PlayUnLockEffect(level, self.skillNodes[i + 2].obj)
                    aorjindu = self.skillsmallNodes[i + 1].obj:GetChildE(1):GetComponentE(_G.typeof(_G.CS.AorImage))
                    local num = math.fmod(level, 5)
                    aorjindu.fillAmount = num * 0.2
                    self:SikllUpLevelEffect(level, tb2, num, i + 1)
                    self.skillsmallNodes[i + 1].obj:SetActiveE(1)
                end
                break
            else
                local num = math.fmod(level, 5)
                local aorjindu = self.skillsmallNodes[i].obj:GetChildE(1):GetComponentE(_G.typeof(_G.CS.AorImage))
                aorjindu.fillAmount = num * 0.2
                self:SikllUpLevelEffect(level, tb, num)
                self.skillsmallNodes[i].obj:GetChildE(1):SetActiveE(1)
                self.skillsmallNodes[i].obj:GetChildE(3):SetActiveE(1)
                self.skillsmallNodes[i].obj:SetActiveE(1)
                --self.skillsmallNodes[i - 1].obj:SetActiveE(0)
                local tb = _G.GetAutoGoTable(self.skillNodes[i + 1].obj)
                local suoobj = tb.obj_suonode:GetChildE(1)
                suoobj:SetActiveE(0)
                break
            end
        end
    end
end

