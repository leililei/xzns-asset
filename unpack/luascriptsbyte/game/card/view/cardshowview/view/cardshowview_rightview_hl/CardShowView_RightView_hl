---更新 按钮
function CardShowView_RightView_hl:UpdateButtonUI()
    ---如果是预览就不显示按钮了
    if self.IsIllustration then
        self.hl_Active_Button:SetActiveE(0)
        self.hl_Up_Button:SetActiveE(0)
    else
        ---是否激活魂链
        local isActivateHl = self.cardHLModel.isActive
        local isBtn1
        local isBtn2
        if isActivateHl == 1 then
            isBtn2 = true
            isBtn1 = false
        else
            isBtn2 = false
            isBtn1 = true
        end

        self.hl_Active_Button:SetActiveE(isBtn1 and 1 or 0)
        self.hl_Up_Button:SetActiveE(isBtn2 and 1 or 0)
    end
    local isGray = self.cardHLModel:IsCardStar() == false
    local button = _G.GetAutoGoTable(self.go_table.obj_Button)
    if isGray then
        self.hl_Active_Button:SetActiveE(0) --SetGrayWithInteractable(isGray)
        button.aortext_activate.text = _G.ConfigManager.language_package_cfg[90023500003]
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_starLimit, true)
        local content = LangUtil.GetLangPackValue(90023500002)
        local starLimit = _G.ConfigManager.discrete_cfg[102401][1][1]
        content = string.format(content, starLimit)
        self.go_table.aortext_tips_starLimit.text = content
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_starLimit, false)
        if self.go_table.obj_Item:GetChildCountE() > 0 then
            local node = self.go_table.obj_Item:GetChildE(0)
            node.gameObject:SetActiveE(1)
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, true)
        button.aortext_activate.text = _G.ConfigManager.language_package_cfg[90023500003]
    end
    if self.cardData.type == _G.CardType.Timer then
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_starLimit, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_enhance, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_timer, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Button, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_timer, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Button, true)
    end
end
