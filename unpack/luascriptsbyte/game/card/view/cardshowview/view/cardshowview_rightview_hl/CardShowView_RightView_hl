---创建对象时,入口构造函数
function CardShowView_RightView_hl:OnCreate(obj, isIllustration)
    if nil == isIllustration then
        self.IsIllustration = false
    else
        self.IsIllustration = isIllustration
    end
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end,
        ----------------------------------------------------------------------
        --强化 btn
        ["@_aorbtn_hl_qianghua"] = self.QianHuanButtonClick,
        --激活 btn
        ["@_aorbtn_hl_Active_button"] = self.ActiveButtonClick,
        --属性总揽 btn 属性详情
        ["@_aorbtn_AttributeInfo"] = self.ShowAllAttributeUI_OnClick,
        ["@_aorbtn_CloseView_tipView"] = self.CloseAttributeInfoShow
    }
    --- 界面滑动dotween
    self.cardHlManager = CardHunLianManger:GetInstance()
    self.cardHLModel = CardHunLianModel:GetInstance()
    _G.Events:GetInstance():AddListener(_G.eHunLianEvents.UpLevelhHuiLian, self.PlayerUIEffectUpLevel, self)
    _G.Events:GetInstance():AddListener(_G.eHunLianEvents.ActiveHunLian, self.PlayerUIEffectAcitvie, self)
    self.all_attribute = {}
    self.item_table = nil
    self:initHunlian()
    self:LoadEffect()
end
function CardShowView_RightView_hl:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_hunliantexiao, self.go_table.trans_effct)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_diwen,
        self.go_table.trans_effct2,
        function(obj)
            if _G.IsNil(self.gameObject) then
                _G.DestroyObject(obj)
                return
            end
            self.unLockEffect = obj
        end
    )
end
---动态绑定 canvas 不会增加 图鉴中进入
