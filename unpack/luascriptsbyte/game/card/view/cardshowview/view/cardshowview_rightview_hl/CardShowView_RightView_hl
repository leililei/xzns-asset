---@param CardData CardData
function CardShowView_RightView_hl:ShowCardInfo(CardData)
    if CardData.cfg.Order < 3 then
        return
    end
    ---@type CardData
    self.cardData = CardData
    if not CardData then
        self:Close()
        return
    end
    self:SetData(CardData)
    self.isShowALl = false
    --self.go_table.obj_Tips:SetActiveE(0)
end

function CardShowView_RightView_hl:SetData(Data)
    self.cardData = Data
    local tb = _G.GetAutoGoTable(self.go_table.obj_Button)
    local max_level = _G.ConfigManager.discrete_cfg[102402][1][1]
    if Data.soulLink_lv >= max_level then
        -- self.go_table.obj_hl_item:SetActiveE(0)
        tb.aorbtn_hl_qianghua:SetActiveE(0)
        self.go_table.aortext_tips_starLimit:SetActiveE(0)
        self.go_table.aortext_enhance:SetActiveE(1)
    else
        --self.go_table.obj_hl_item:SetActiveE(1)
        tb.aorbtn_hl_qianghua:SetActiveE(1)
        self.go_table.aortext_tips_starLimit:SetActiveE(1)
        self.go_table.aortext_enhance:SetActiveE(0)
    end
    self.cardHlManager:SetDataHunLian(Data)
    --设置属性图标(7个)
    self:SetAll_attIcon_UI(self.cardData.sid)
    --切换卡牌 进行重置
    for i = 1, 6 do
        self.skillsmallNodes[i].obj:SetActiveE(0)
        local tb = _G.GetAutoGoTable(self.skillsmallNodes[i].obj)
        if tb.obj_node:GetChildCountE() > 0 then
            for i = 1, tb.obj_node:GetChildCountE() do
                _G.PoolsManager:GetInstance():Despawn(tb.obj_node:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
    end
    self:PlayGuangQuan(self.cardData.soulLink_IsActivate == 1)
    self:UpdateView()
    self:SetRedPoint(Data)
    self.go_table.trans_effct2:SetActiveE(self.cardData.soulLink_IsActivate == 1 and 1 or 0)
end

function CardShowView_RightView_hl:OnEnable()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
        for k, v in pairs(self.skillsmallNodes) do
            if self.skillNodes[k + 1] then
                v.obj:SetParentE(self.go_table.obj_smallIconNode_jindutiao, 1)
            end
        end
    elseif not self.smallPos then
        self.smallPos = {}
        local x, y
        for k, v in pairs(self.skillsmallNodes) do
            if self.skillNodes[k + 1] then
                x, y = v.obj:GetLocalPosition()
                self.smallPos[k + 1] = {x, y}
            end
        end
    end
    --self.go_table.obj_smallIconNode_jindutiao:SetActiveE(0)
    for k, v in pairs(self.skillsmallNodes) do
        if self.skillNodes[k + 1] then
            v.obj:SetParentE(self.skillNodes[k + 1].obj, 1)
        end
    end
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        true,
        false,
        true
    )
    self.timer:Start()
end

function CardShowView_RightView_hl:TimerFunc()
    for k, v in pairs(self.skillsmallNodes) do
        v.obj:SetParentE(self.go_table.obj_smallIconNode_jindutiao, 1)
        if self.smallPos and self.smallPos[k + 1] then
            v.obj:SetLocalPosition(self.smallPos[k + 1][1], self.smallPos[k + 1][2], 0)
        end
    end
end

function CardShowView_RightView_hl:SetRedPoint(data)
    if data.uid == nil then
        return
    end
    local uid = data.uid * 10
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SoulChain.id, uid + 1)
    ---ZHJ-23329 魂链红点显示过后，进去界面就不再显示，重置之后满足要救在显示
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CardShowView.Name) then
        if not _G.PlayerPrefsManager.HasKey(_G.CardHunLian.CardHunLianSaveKey .. (uid + 1)) then
            if
                require "RedPointManager":GetInstance():GetNodeNum(_G.ConfigManager.redpoint_cfg.SoulChain.id, uid + 1) >
                    0
             then
                _G.PlayerPrefsManager.SetInt(_G.CardHunLian.CardHunLianSaveKey .. (uid + 1), 1)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SoulChain.id, uid + 1)
            end
        end
        if _G.PlayerPrefsManager.HasKey(_G.CardHunLian.CardHunLianFirstSaveKey .. (uid + 1)) then
            _G.PlayerPrefsManager.DeleteKey(_G.CardHunLian.CardHunLianFirstSaveKey .. (uid + 1))
        end
    end
end

function CardShowView_RightView_hl:ShowHunLian(data)
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    --self:DisposeAttribute()
    self:SetData(data)
