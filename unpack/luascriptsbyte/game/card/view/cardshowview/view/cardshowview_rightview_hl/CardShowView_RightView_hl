---升级 链子 断裂 特效
function CardShowView_RightView_hl:PlayerUIEffectUpLevel()
    local level = self.cardData.soulLink_lv
    local index = 1
    local falg = false
    for i = 1, #self.skillsmallNodes do
        local tb = self.skillsmallNodes[i].obj
        tb = _G.GetAutoGoTable(tb)
        if level == self.skillsmallNodes[i].level then
            --self:SikllBaozhaoUIEffect(level, tb.obj_node)
            if i ~= 6 then
                tb = _G.GetAutoGoTable(self.skillsmallNodes[i + 1].obj)
                self:PlayUnLockEffect(index + 1, tb.obj_node)
            end
            falg = true
            break
        elseif level < self.skillsmallNodes[i].level then
            index = i
            break
        end
    end
    if not falg then
        local tb1 = self.skillsmallNodes[index].obj
        tb1 = _G.GetAutoGoTable(tb1)
        --self:SikllUpLevelEffect(level, tb1.obj_skill, index)
        self:UpdateView()
    end
end
