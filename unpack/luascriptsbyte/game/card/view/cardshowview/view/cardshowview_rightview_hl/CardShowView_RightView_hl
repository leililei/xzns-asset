---刷新界面 4条 属性（攻击,防御,破甲，生命）
function CardShowView_RightView_hl:UpdateAttributeUI()
    local att = {
        atk = 0,
        max_hp = 0,
        bre = 0,
        def = 0
    }
    if self.cardHLModel.isActive == 1 then
        local attArrays = self.cardHlManager:GetBase_att(self.cardHLModel.cardData.sid, self.cardHLModel.level)
        for i = 1, #attArrays do
            local value = attArrays[i].value
            value = value * 0.0001 * 100
            att[attArrays[i].key] = value
        end
    end
    for key, value in pairs(att) do
        local str = ""
        if self.cardHLModel.isActive == 1 then
            str = "+" .. value .. "%"
        else
            str = value
        end
        self.attributenode[key].text = str
    end
end
---点击属性 详情 弹出 tips 框
function CardShowView_RightView_hl:ShowAllAttributeUI_OnClick()
    if self.cardHLModel.isActive == 0 then
        _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90020600036))
        return
    end
    --self.go_table.obj_Tips:SetActiveE(1)
    local level = self.cardHLModel.level
    local attArrays = self.cardHlManager:GetBase_att(self.cardHLModel.cardData.sid, level)
    local transNode = self.go_table.trans_Content
    if transNode:GetChildCountE() > 0 then
        for i = 1, transNode:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(transNode:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local count = 0
    if not self.isShowALl then
        if attArrays then
            count = #attArrays
            for i = 1, count do
                _G.PoolsManager:GetInstance():Spawn(
                    tipsItem,
                    _G.ePoolType.UIItem,
                    transNode,
                    function(trans)
                        local tb = _G.GetAutoGoTable(trans)
                        local name = self.cardHlManager:GetAttributeDes(attArrays[i].key)
                        tb.aortext_title.text = name
                        local value = attArrays[i].value
                        value = value * 0.0001 * 100
                        tb.aortext_des.text = "+" .. value .. "%"
                        self.all_attribute[i] = tb
                    end
                )
            end
        end
        self.isShowALl = true
    else
        if not _G.table.isEmptyOrNil(self.all_attribute) then
            count = #attArrays
            for i = 1, count do
                local tb = self.all_attribute[i]
                local name = self.cardHlManager:GetAttributeDes(attArrays[i].key)
                tb.aortext_title.text = name
                local value = attArrays[i].value
                value = value * 0.0001 * 100
                tb.aortext_des.text = "+" .. value .. "%"
                self.all_attribute[i] = tb
            end
        end
    end
end
