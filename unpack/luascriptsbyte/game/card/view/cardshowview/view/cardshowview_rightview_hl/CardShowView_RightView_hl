---更新 道具信息 消耗道具 ui-dj-sjs
function CardShowView_RightView_hl:UpdateItemUI()
    -- local subList = {}
    local node = self.go_table.obj_Item
    local max_level = _G.ConfigManager.discrete_cfg[102402][1][1]
    if self.cardData.soulLink_lv >= max_level then
        if self.go_table.obj_Item:GetChildCountE() > 0 then
            local node1 = self.go_table.obj_Item:GetChildE(0)
            node1.gameObject:SetActiveE(0)
            _G.PoolsManager:GetInstance():Despawn(node1, _G.ePoolType.Temporary)
            self.item_table = nil
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, false)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, true)
    if self.item_table == nil then
        _G.PoolsManager:GetInstance():Spawn(
            item,
            _G.ePoolType.Temporary,
            node,
            function(item)
                item:SetName(self.cardHLModel.itemName)
                self:SetItemConsume(item)
                self.item_table = item
            end
        )
    else
        self:SetItemConsume(self.item_table)
    end
end
function CardShowView_RightView_hl:SetItemConsume(item)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.ConsumeOnClickBtn, self.cardHLModel.itemName))
    local cfg = _G.ConfigManager.item_cfg
    local icon = cfg[self.cardHLModel.itemName].Icon or cfg[self.cardHLModel.itemName].icon
    tb.aorrawimage_item_Bg_image:LoadImage(icon)
    local str = ""
    if not self.cardHLModel:IsItemEnough() then
        str = "<color=#e33f3f>" .. _G.GameUtil.NumberToUnitStr(self.cardHLModel.itemLimit) .. "</color>"
    else
        str = "<color=#D0D8FF>" .. _G.GameUtil.NumberToUnitStr(self.cardHLModel.itemLimit) .. "</color>"
    end

    tb.aortext_item_number.text =
        _G.string.format(
        "%s/%s",
        str,
        _G.string.AddColor(
            _G.StorageManager:GetInstance():GetItemCountBySid(_G.tonumber(self.cardHLModel.itemName)),
            "D0D8FF"
        )
    )
