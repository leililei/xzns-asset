--技能解锁爆炸特效
function CardShowView_RightView_hl:SikllUpLevelEffect(level, tb)
    if not tb.obj_skill then
        return
    end
    if not tb.effect then
        tb.effect = {}
    end
    local str = _G.string.replace(tb.gameObject:GetName(), "$_obj_skill_jindu_", "")
    local pos = _G.tonumber(str)
    tb.obj_skill:SetEulerAngles(0, 0, -149.32)
    local num = math.fmod(level, 5)
    for i = 1, 5 do
        if tb.effect[i] then
            tb.effect[i]:SetActiveE(i > num and 0 or 1)
        elseif i <= num then
            -- body
            if pos == 1 or pos == 3 or pos == 5 then
                local postList = bianEffectPos[1][i]
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[bianEffect],
                    tb.obj_skill,
                    function(tran)
                        if _G.IsNil(self.gameObject) then
                            _G.DestroyObject(tran)
                            return
                        end
                        tb.effect[i] = tran
                        tran:SetLocalScale(0.8, 0.8, 1)
                        tran:SetLocalPosition(postList[1], postList[2], 0)
                        tran:SetLocalEulerAngles(0, 0, postList[3])
                    end
                )
            else
                local postList = bianEffectPos[2][i]
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[bianEffect],
                    tb.obj_skill,
                    function(tran)
                        if _G.IsNil(self.gameObject) then
                            _G.DestroyObject(tran)
                            return
                        end
                        tb.effect[i] = tran
                        --tran:SetLocalScale(1, 1, 1)
                        tb.effect[i] = tran
                        tran:SetLocalPosition(postList[1], postList[2], 0)
                        tran:SetLocalEulerAngles(0, 0, postList[3])
                    end
                )
            end
        end
    end
end
