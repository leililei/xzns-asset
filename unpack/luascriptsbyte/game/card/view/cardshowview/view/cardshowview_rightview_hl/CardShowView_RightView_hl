function CardShowView_RightView_hl:SetAll_attIcon_UI(cardid)
    local hl_dataStatic = self.cardHLModel:GetAllExclusiveCf_attribute_display(cardid)
    for k = 1, #self.skillNodes do
        local iconname = hl_dataStatic[k].icon
        local tb = _G.GetAutoGoTable(self.skillNodes[k].obj)
        tb.aorrawimage_icon_1:LoadImage(iconname)
