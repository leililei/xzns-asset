---@class ContactPopView : UIBaseView    分享到界面
---@field public go_table ChatView_GoTable GoTable
local ContactPopView = _G.BaseClass("ContactPopView", _G.Component)
local contactCfg = _G.ConfigManager.card_qiyue_cfg
local CardInfoManager = require("CardInfoManager"):GetInstance()

local CardItem = _G.BaseClass("CardItem")
function CardItem:__init(obj, data)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:Show(data)
end

function CardItem:Dispose()
    self.go_table = nil
end

---展示卡牌
---@param index number 序列号
---@param data table 卡牌对象
function CardItem:Show(data)
    data.isHave = true     --隐藏aorrawimage_bg节点
    data.isSelfLogo = true --显示核心或传奇logo
    self.data = data
    if not self.cardItem then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.HeadItem_Select,
            self.go_table.trans_root,
            function(view)
                self.cardItem = view
                view.transform:SetLocalPositionToZero()
                view:ShowCardData(self.data)
                if view.HideOrShowSpEffect then 
                    view:HideOrShowSpEffect(false)
                end 
            end
        )
    else
        self.cardItem:ShowCardData(data)
    end
end

---设置卡牌置灰
---@param gray boolean 是否置灰
---@param tips number 点击tipsid
function CardItem:SetGray(gray)
    if self.cardItem then
        -- self.cardItem:SetGray(gray)
        if gray then
            self.go_table.obj_shadow:SetActiveE(0)
            self.go_table.obj_dead:SetActiveE(0)
            self.go_table.obj_sameTips:SetActiveE(0)
            self.go_table.obj_full:SetActiveE(0)
        end
        self.cardItem:SetGray(gray)
    end
end

function ContactPopView:__init(obj, cardData, EmbattleItem, func, teamIndex)
    self.teamIndex = teamIndex or 1
    self.EmbattleItem = EmbattleItem
    self.cardData = cardData
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.gameObject:SetActiveE(1)
    _G.DelayDo(0.9, function()
        func()
        _G.DelayDo(1.1,function()
            _G.DestroyObject(self.go_table.gameObject)
        end
        )
    end
    )
end

---界面的入口函数
---@  number _G.ChatType默认打开界面
function ContactPopView:OnCreate()
    self.cfg = contactCfg[self.cardData.cfg.fetter[1]]
    self:FreshView()
end

function ContactPopView:FreshView()
    --self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg.name) 
    local attDes
    for k, v in ipairs(self.cfg.att1) do
        if k == 1 then
            attDes = CardInfoManager:GetShowProp(v[1], v[2], v[3])
        else
            attDes = attDes .. "," .. CardInfoManager:GetShowProp(v[1], v[2], v[3])
        end
    end
    attDes = "</color><color=#7fde77>" .. attDes .. "</color>"
    local cardCount = 0
    for i = 1, #self.cfg.cards do
        if self.EmbattleItem.curEmbattleData[self.teamIndex][1] then
            for j = 1, #self.EmbattleItem.curEmbattleData[self.teamIndex] do
                if self.EmbattleItem.curEmbattleData[self.teamIndex][j].sid == self.cfg.cards[i] then
                    cardCount = cardCount + 1
                end
            end
        else
            for j = 1, 5 do
                if self.EmbattleItem.curEmbattleData[j].sid == self.cfg.cards[i] then
                    cardCount = cardCount + 1
                end
            end
        end
        -- if self.EmbattleItem:CheckSidInEmbattle(self.cfg.cards[i]) then
        --     cardCount = cardCount + 1
        -- end
    end
    if cardCount > 1 then
        self.go_table.obj_head2:SetActiveE(1)
        --self.go_table.aortext_des2:SetActiveE(1)
        self.go_table.aortext_des1.text = _G.LangUtil.GetLangPackValue(self.cfg.name) .. ":<color=#e6d4b4>" .. _G.LangUtil.GetLangPackValue(18900000048, attDes)
        --self.go_table.aortext_des2.text = _G.LangUtil.GetLangPackValue(0, self.cfg.condition_star1)
    else
        self.go_table.obj_head2:SetActiveE(0)
        --self.go_table.aortext_des2:SetActiveE(0)
        self.go_table.aortext_des1.text = _G.LangUtil.GetLangPackValue(self.cfg.name) .. ":<color=#e6d4b4>" .. _G.LangUtil.GetLangPackValue(18900000049, attDes)
    end
    for i = 1, 2 do
        self.go_table["obj_itemcard" .. i]:SetActiveE(0)
        self.go_table["obj_head" .. i]:SetActiveE(0)
    end
    --local fighterSids = require("EmbattleModel"):GetInstance():GetEmbattleSidsData(self.EmbattleType)
    self:ShowItem(1, self.cardData.sid, self.cardData)
    for i = 1, #self.cfg.cards do
        if self.cfg.cards[i] == self.cardData.sid then
            self.go_table["obj_itemcard" .. i]:SetActiveE(1)
            self.go_table["obj_head" .. i]:SetActiveE(0)
            CardItem.New(self.go_table["obj_itemcard" .. i], self.cardData)
            _G.GetAutoGoTable(self.go_table["obj_itemcard" .. i]).aortext_name.text = _G.LangUtil.GetLangPackValue(self.cardData.cfg.Name)
        elseif cardCount > 1 and self.EmbattleItem:CheckSidInEmbattle(self.cfg.cards[i]) then
            local card
            local sid = self.cfg.cards[i]
            if self.EmbattleItem.curEmbattleData[self.teamIndex][1] then
                for j = 1, #self.EmbattleItem.curEmbattleData[self.teamIndex] do
                    if self.EmbattleItem.curEmbattleData[self.teamIndex][j].sid == sid then
                        card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.EmbattleItem.curEmbattleData[self.teamIndex][j].uid)
                        break
                    end
                end
            else
                for j = 1, 5 do
                    if self.EmbattleItem.curEmbattleData[j].sid == sid then
                        card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.EmbattleItem.curEmbattleData[j].uid)
                        break
                    end
                end
            end
            if card == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("未在当前布阵中找到契约卡" .. self.cfg.cards[i])
                end
                return
            end
            CardItem.New(self.go_table["obj_itemcard" .. i], card)
            self.go_table["obj_itemcard" .. i]:SetActiveE(1)
            self.go_table["obj_head" .. i]:SetActiveE(0)
            _G.GetAutoGoTable(self.go_table["obj_itemcard" .. i]).aortext_name.text = _G.GetLangPackValue(_G.ConfigManager.card_cfg[sid].Name)
        --else
        --    self.go_table["obj_itemcard" .. i]:SetActiveE(0)
        --    self.go_table["obj_head" .. i]:SetActiveE(1)
        --    self:ShowItem(i, self.cfg.cards[i])
        end
    end
end

function ContactPopView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_backGround" then
        self:Close()
    end
end

function ContactPopView:ShowItem(index, sid)
    local gray = #_G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card):GetCardsBySid(sid) > 0
    local goTable = _G.GetAutoGoTable(self.go_table["obj_head" .. index]) 
    local cfg = require "CardCommentManager":GetInstance():CardData(sid, false)
    local grade = (cfg and cfg.Order)
    local star = (cfg and cfg.Star)

    goTable.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(grade)
    goTable.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
    if goTable.obj_logo then
        if _G.CardBodyOrderIconName[grade] then
            goTable.obj_logo:SetActiveE(1)
            -- self.go_table.obj_logoTxt:SetActiveE(cfg.card_logo == 1 and 1 or 0)
            goTable.aorimage_logo.SpriteName = _G.CardBodyOrderIconName[grade]
            goTable.aorimage_logo:SetNativeSize()
        else
            goTable.obj_logo:SetActiveE(0)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("logo异常")
        end
    end

    local icon

    icon = cfg.Icon

    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    goTable.aorimage_Icon.SpriteName = icon

    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local order, starCount = CardInfoManager:GetOrderStarCount(star)
    goTable.aorimage_ColorBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, order)
    goTable.aorimage_jue:SetGray(not gray)
    goTable.aorimage_logo:SetGray(not gray)
    goTable.aorimage_ColorBg:SetGray(not gray)
    goTable.aorimage_Icon:SetGray(not gray)
end

return ContactPopView
