local SpiritualModel = require("SpiritualModel"):GetInstance()
---@class SpiritualRecommendView : UIBaseView	中文描述
---@field public go_table SpiritualRecommendView_GoTable GoTable
local SpiritualRecommendView = _G.BaseClass("SpiritualRecommendView", _G.UIBaseView)

---操作类型
local operationType = {
    Wear = 1,
    TakeOff = 2
}

local SpiritualStateEnum = {
    HaveNot = 1, --未拥有
    NotWorn = 2, --未穿戴
    Wearing = 3 --穿戴中
}

local SpiritualStateText = {
    [SpiritualStateEnum.HaveNot] = _G.GetLangPackValue(90000011211),
    [SpiritualStateEnum.NotWorn] = "",
    [SpiritualStateEnum.Wearing] = _G.GetLangPackValue(90020400069)
}

---饰品品质背景
local QualityIcon = {
    "ui_js_txk_zi",
    "ui_js_txk_cheng",
    "ui_js_txk_hong",
    "ui_js_txk_cai"
}

function SpiritualRecommendView:Awake()
    self.AllTbs = {}
    self.spiritualSidList = {}
    self.spiritualWearList = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpiritualRecommendView:OnCreate(CardData, isPreviewCardShow, callback)
    self.CardData = CardData
    self.cardSid = self.CardData.sid
    self.callback = callback
    self.isPreviewCardShow = isPreviewCardShow
    self:InitView()
end

function SpiritualRecommendView:OnDestroy()
end

---按钮点击事件在这里派发
function SpiritualRecommendView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_closeview" then
        self:Close()
    elseif name == "@_aorbtn_go" then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SpiritualDraw) then
            _G.PopWindowManager:GetInstance():ShowAllTips(110113)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDrawToggleGroupView.Name, 2)
        self:Close()
    end
end

---初始化
function SpiritualRecommendView:InitView()
    ---@type card_cfg
    local cardCfg = _G.ConfigManager.card_cfg[self.cardSid]
    local spiritual_cfg = _G.ConfigManager.spiritual_cfg
    self.infos = {}
    local recommend = cardCfg.jewelry_recommend
    local title = cardCfg.jewelry_title
    self.go_table.aorbtn_go:SetActiveE(not self.isPreviewCardShow and 1 or 0)
    if recommend then
        for i = 1, #recommend do
            --饰品表
            local SpiritualCfg = {}
            for _, v in pairs(recommend[i]) do
                local data = {}
                local cfg = spiritual_cfg[v]
                if cfg then
                    data.sid = cfg.id
                    data.image = cfg.image_1
                    data.name = cfg.Name
                    data.cfg = cfg
                    data.order = cfg.Order
                    _G.table.insert(SpiritualCfg, data)
                end
            end

            self.infos[i] = {title[i], SpiritualCfg}
        end
        --拥有饰品
        self.spirituals = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual, _G.ArtifactType.NoWear)
        self.spiritualsWear = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual, _G.ArtifactType.Wear)

        self.go_table.looplist2_team:InitListView(0, _G.handler(self, self.RefreshItem))
        self.go_table.looplist2_team:SetListItemCount(#recommend, true)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("无配置")
        end
    end
end

---初始化item
function SpiritualRecommendView:RefreshItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1

    local item = listView2:NewListViewItem("$_obj_Item")
    item:SetActiveE(1)

    self:SetItem(item, t_index)

    return item
end

--设置Item
function SpiritualRecommendView:SetItem(go, index)
    local info = self.infos[index]
    local goId = go:GetInstanceIDE()
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.OnClickItem, index))
    self.AllTbs[goId] = tb
    self.spiritualSidList[index] = {}
    self.spiritualWearList[index] = {}
    tb.aorbtn_use:SetActiveE(not self.isPreviewCardShow and 1 or 0)
    --标题
    tb.aortext_name.text = _G.ConfigManager.language_package_cfg[info[1]]

    local childAmount = tb.obj_Node:GetChildCountE()
    local spiritualState
    for i = 1, childAmount do
        local obj = tb["obj_Spiritual_" .. i]
        local Spiritual_tb = _G.GetAutoGoTable(obj)

        local data = info[2][i]
        Spiritual_tb.gameObject:SetActiveE(data and 1 or 0)
        if data then
            spiritualState = SpiritualStateEnum.HaveNot
            local spiritualData = self:TryGetStorageSpiritual(data.sid, false)
            if spiritualData == nil then
                spiritualData = self:TryGetStorageSpiritual(data.sid, true)
            end
            if spiritualData then
                if not self.spiritualSidList[index][spiritualData.sid] then
                    self.spiritualSidList[index][spiritualData.sid] = true
                end
                if spiritualData.cardUid > 0 then
                    spiritualState = SpiritualStateEnum.Wearing
                    if spiritualData.cardUid ~= self.CardData.uid then
                        self.spiritualWearList[index][spiritualData.uid] = spiritualData
                    end
                else
                    spiritualState = SpiritualStateEnum.NotWorn
                end
            else
                spiritualData = self:GetTempSpiritualData(data)
            end

            if not Spiritual_tb.itemLua then
                Spiritual_tb.itemLua = true
                _G.ItemFactory:GetInstance():GetItemCard(
                    _G.ItemFactory.itemType.ItemSpiritualBase,
                    Spiritual_tb.obj_item,
                    function(itemLua)
                        if self:IsNil() then
                            return
                        end
                        itemLua:ShowData(spiritualData)
                        Spiritual_tb.itemLua = itemLua
                    end
                )
            elseif Spiritual_tb.itemLua ~= true then
                Spiritual_tb.itemLua:ShowData(spiritualData)
            end

            Spiritual_tb.obj_mask:SetActiveE(spiritualState == SpiritualStateEnum.HaveNot and 1 or 0)
            Spiritual_tb.aortext_RoleName.text = SpiritualStateText[spiritualState]
            local color = spiritualState == SpiritualStateEnum.HaveNot and "E44543" or "00721D"
            Spiritual_tb.aortext_RoleName.color = _G.ColorTools.FormatColorByString(color)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("出现找不到的饰品，检查配置")
            end
        end
    end
    tb.gameObject:SetActiveE(1)
end

function SpiritualRecommendView:TryGetStorageSpiritual(sid, isWear)
    local spiritualLis = isWear and self.spiritualsWear or self.spirituals
    local power
    local maxPower = 0
    local spiritualData
    for k, v in pairs(spiritualLis) do
        if v.sid == sid then
            power = v:GetPower()
            if power > maxPower then
                maxPower = power
                spiritualData = v
            end
        end
    end
    return spiritualData
end

---获取临时灵契数据
function SpiritualRecommendView:GetTempSpiritualData(data)
    if not self.tempSpiritual then
        self.tempSpiritual = {}
    end
    if not self.tempSpiritual[data.sid] then
        self.tempSpiritual[data.sid] = _G.SpiritualData.New()
        self.tempSpiritual[data.sid]:Parse(data)
    end
    return self.tempSpiritual[data.sid]
end

--点击饰品响应
function SpiritualRecommendView:OnClickItemSpiritualIcon(go, isOn, data, uid)
    local name = go:GetName()
    if name == "@_aorbtn_click" then
        -- 饰品详情
        require "CommonTipManager":GetInstance():OpenTip(go, data.sid, uid, nil, false)
    end
end

---卡牌点击跳转
function SpiritualRecommendView:CardOnlick(params)
    --跳转到角色预览界面
    local obj = params[1]
    local cardsid = params[2]
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CardShowView.Name)
    self:Close()
    require("CommonTipManager"):GetInstance():OpenTip(obj, cardsid)
end

---点击一键穿戴事件
function SpiritualRecommendView:OnClickItem(go, ison, index)
    local name = go:GetName()
    if name == "@_aorbtn_use" then
        if self.isWearing then
            return
        end
        self.isWearing = true
        local wearingNum = _G.table.count(self.spiritualWearList[index])
        if wearingNum > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                320132,
                nil,
                _G.handlerbind(self, self.TakeOffOtherAndOneKeyPutOn, index, wearingNum),
                function()
                    self.isWearing = false
                end,
                function()
                    for _, sData in pairs(self.spiritualWearList[index]) do
                        self.spiritualSidList[index][sData.sid] = nil
                    end
                    self:OneKeyOperation(operationType.Wear, self.spiritualSidList[index])
                end
            )
        else
            self:OneKeyOperation(operationType.Wear, self.spiritualSidList[index])
        end
    end
end

function SpiritualRecommendView:TakeOffOtherAndOneKeyPutOn(index, wearingNum)
    for _, sData in pairs(self.spiritualWearList[index]) do
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, sData.cardUid)
        local idx
        if cardData then
            for i, spiritualData in pairs(cardData.SpiritualBar) do
                if spiritualData.uid == sData.uid then
                    idx = i
                    break
                end
            end
            if idx then
                require("SpiritualModel"):GetInstance():TakeOffSpiritual(
                    cardData,
                    sData,
                    idx,
                    function()
                        wearingNum = wearingNum - 1
                        if wearingNum == 0 then
                            self:OneKeyOperation(operationType.Wear, self.spiritualSidList[index])
                        end
                    end
                )
            else
                wearingNum = wearingNum - 1
            end
        else
            wearingNum = wearingNum - 1
        end
    end
end

---一键穿戴和卸下
function SpiritualRecommendView:OneKeyOperation(type, infos)
    if type == operationType.Wear and _G.table.isEmptyOrNil(self.CardData.SpiritualBar) then
        SpiritualModel:OneKeyPutOnSpiritual(
            self.CardData,
            function()
                if self.callback then
                    self.callback()
                end
                self:Close()
            end,
            infos
        )
        return
    end

    SpiritualModel:OneKeyDetachSpiritual(
        self.CardData,
        type == operationType.TakeOff,
        function()
            if type == operationType.Wear then
                SpiritualModel:OneKeyPutOnSpiritual(
                    self.CardData,
                    function()
                        if self.callback then
                            self.callback()
                        end
                        self:Close()
                    end,
                    infos
                )
                return
            end
            if self.callback then
                self.callback()
            end
            self:Close()
        end
    )
end

return SpiritualRecommendView
