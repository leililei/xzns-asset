---更新装备界面
------@param CardData CardData
function CardShowView_Right_equipment:UpdateEquip(CardData)
    if CardData == nil then
        return
    end

    -- _G.LogError(CardData.uid)
    -- _G.LogError(CardInfoManager.IsSpiritualRedPointShow(CardData.uid))
    if CardInfoManager.IsSpiritualRedPointShow(CardData.uid) then
        CardInfoManager.SetSpiritualRedPointShow(CardData.uid, 0)
        self.showSpiritualTipsGo_Table.toggle_SpiritualTips.isOn = true
        self.isSetEquipCultivate = true
    else
        self.showSpiritualTipsGo_Table.toggle_SpiritualTips.isOn = false
        self.isSetEquipCultivate = false
    end

    local AttributeClassManager = _G.AttributeClassManager:GetInstance()

    local PropDic = AttributeClassManager:GetAttribtueClass(0, _G.PowerType.equipment)

    ---@param v1 EquipmentItem
    for i, v1 in pairs(CardData.EquipBar) do
        if self.EquipItem[i] then
            if _G.table.isEmptyOrNil(v1) then
                self.EquipItem[i].gameObject:SetActiveE(0)
            else
                AttributeClassManager:AddAttribute(PropDic, v1.UPProp)
                AttributeClassManager:AddAttribute(PropDic, v1.prop)
                self.EquipItem[i].gameObject:SetActiveE(1)
                self.EquipItem[i]:ShowData(v1)
            end
        end
    end

    self.go_table.obj_weaponredpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id,
            self.CardData.uid * 10 + _G.EquipmentPart.Weapon
    )
    self.go_table.obj_headredpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id,
            self.CardData.uid * 10 + _G.EquipmentPart.Head
    )
    self.go_table.obj_clothesredpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id,
            self.CardData.uid * 10 + _G.EquipmentPart.Clothes
    )
    self.go_table.obj_shoesredpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id,
            self.CardData.uid * 10 + _G.EquipmentPart.Shoes
    )

    local childAmount = self.go_table.obj_Node:GetChildCountE() - 1
    for index = 1, childAmount do
        local obj = self.go_table["obj_node_" .. index]
        local tb = _G.GetAutoGoTable(obj)
        local param = self.CardData.uid * 10 + index
        if self.isSetEquipCultivate == true then
            -- tb["obj_redpointLevelUp" .. index]:UpdateRedPointItemIDAndParam(
            --     _G.ConfigManager.redpoint_cfg.SpiritualLevelUp.id,
            --     param
            -- )
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Spiritual.id, index)
        end
    end
    self:RefreshRoleEquipmentOneKey()
end

function CardShowView_Right_equipment:RefreshRoleEquipmentOneKey()
    RedPointManager:RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg.Spiritual.id
    )
    RedPointManager:RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg.SpiritualPage.id
    )
    --刷新神器红点
    RedPointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifact.id)
    RedPointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)

    self.go_table.obj_redpoint_allput:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RoleEquipmentOneKey.id,
            self.CardData and self.CardData.uid or 0
    )
end

---一键穿装
function CardShowView_Right_equipment:OnClick__AllPut()
    local count = 0
    for _, v in pairs(self.EquipBtn) do
        if v and v:GetActiveSelf() == 0 then
            count = count + 1
        end
    end
    if count == 4 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotEquip)
        return
    end
    require("EquipmentModel"):GetInstance():DressAllEquip(
            self.CardData.uid,
            function(target)
                require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                self:RefrehsEqupRedPoint()
                _G.AudioManager.PlayAudioByAudioCfgID(2055)
            end
    )
end

---一键穿装
function CardShowView_Right_equipment:OnClick__AllUnfix()
    local index = {}
    for _, v in pairs(_G.EquipmentPart) do
        if not _G.table.isEmptyOrNil(self.CardData.EquipBar[v]) then
            _G.table.insert(index, v)
        end
    end
    if _G.table.isEmptyOrNil(index) then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.dqwcd)

        return
    end
    require("EquipmentModel"):GetInstance():UnfixEquip(
            self.CardData.uid,
            index,
            function()
                require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                self:RefrehsEqupRedPoint()
            end
    )
end

---@param onlyCurCard boolean 仅刷新当前卡牌
function CardShowView_Right_equipment:RefrehsEqupRedPoint(onlyCurCard)
    if not onlyCurCard then
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
        )
    else
        for _, v in pairs(_G.EquipmentPart) do
            if v ~= _G.EquipmentPart.Trousers then
                require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id,
                        self.CardData.uid * 10 + v
                )
            end
        end
    end
end

function CardShowView_Right_equipment:OpenEquiip(EquipmentPart)
    local eqData = self.CardData.EquipBar[EquipmentPart]
    if _G.TableIsEmpty(eqData) then
        if self.CardData.type == _G.CardType.Timer then
            _G.PopWindowManager:GetInstance():ShowAllTips(790102)
            return
        end

        ---@type params_EquipmentSubstituteView
        local data = {}
        data.EquipmentType = self.CardData.cfg.EquipmentType
        data.parts = EquipmentPart
        data.CurItemData = eqData
        data.CardData = self.CardData
        data.TrueFun = function()
            require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
            self:RefrehsEqupRedPoint()
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EquipmentSubstituteView.Name, data)
    else
        self:ShowEquipmentTipsItem(eqData)
    end
end

---点击装备对象
---@param data EquipmentItem 饰品数据类
function CardShowView_Right_equipment:ShowEquipmentTipsItem(data)
    if _G.TableIsEmpty(data) then
        if _G.AppSetting.DEBUG then
            _G.LogError("CardInfoView:ShowEquipmentTipsItem  data = nil")
        end
        return
    end
    local msg = {}
    local data1 = {}

    ---true显示培养按钮  能强化 或 能重铸
    local isPy = false
    if data.cfg.strengthen_level > 0 then
        isPy = true
    elseif data.cfg.elements[1] ~= nil then
        isPy = true
    elseif data.Grade >= 7 then
        --金色及以上品质可以洗练
        isPy = true
    end

    local data2 = {}
    data2.data = data
    data2.isSelf = false
    data2.btn = {}

    if isPy == true then
        data2.btn.left = {}
        data2.btn.left.name = _G.LangUtil.GetLangPackValue(90023400005)
        data2.btn.left.func = _G.handlerbind(self, self.Strengthen, data)
    end

    data2.btn.right = {}
    data2.btn.right.name = _G.LangUtil.GetLangPackValue(90020400047)
    data2.btn.right.func = _G.handlerbind(self, self.EquipReplace, data)

    if not _G.table.isEmptyOrNil(self.CardData.EquipBar[data.cfg.parts]) then
        data1.data = self.CardData.EquipBar[data.cfg.parts]
        if data2.data.uid ~= data1.data.uid then
            data1.isSelf = true
            data1.btn = nil
            _G.table.insert(msg, data1)
            _G.table.insert(msg, data2)
        else
            data1.isSelf = false
            data1.btn = {}

            if isPy == true then
                data1.btn.left = {}
                data1.btn.left.name = _G.LangUtil.GetLangPackValue(90020400065)
                data1.btn.left.func = _G.handlerbind(self, self.Strengthen, data)
            end
            data1.btn.right = {}
            data1.btn.right.name = _G.LangUtil.GetLangPackValue(90020400047)
            data1.btn.right.func = _G.handlerbind(self, self.EquipReplace, data)

            data1.btn.replace = {}
            data1.btn.replace.name = _G.LangUtil.GetLangPackValue(90020400064)
            data1.btn.replace.func = _G.handlerbind(self, self.EquipTakeOff, data)

            table.insert(msg, data1)
        end
    else
        table.insert(msg, data2)
    end
    if self.CardData.type == _G.CardType.Timer then
        msg = {}
        data2.isSelf = true
        data2.btn.right = {}
        table.insert(msg, data2)
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, msg, 1)
end

---装备培养
------@param EquipmentData EquipmentItem
function CardShowView_Right_equipment:Strengthen(EquipmentData)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)

    ---@type params_EquipmentView
    local data = {}
    data.CloseFun = function()
        -- self:CutoverFun(self.CardData)
        self:ShowCardInfo(self.CardData)
        self:RefrehsEqupRedPoint()
    end
    data.EquipmentItem = EquipmentData
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EquipmentView.Name, data, self.CardData.EquipBar)
end

---装备替换
------@param EquipmentData EquipmentItem
function CardShowView_Right_equipment:EquipReplace(EquipmentData)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)

    ---@type params_EquipmentSubstituteView
    local data = {}
    data.EquipmentType = self.CardData.cfg.EquipmentType
    data.parts = EquipmentData:GetParts()
    data.CurItemData = EquipmentData
    data.CardData = self.CardData
    data.TrueFun = function()
        require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
        self:RefrehsEqupRedPoint()
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EquipmentSubstituteView.Name, data)
end

---装备脱下
------@param EquipmentData EquipmentItem
function CardShowView_Right_equipment:EquipTakeOff(EquipmentData)
    require("EquipmentModel"):GetInstance():UnfixEquip(
            self.CardData.uid,
            { EquipmentData:GetParts() },
            function()
                require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
                self:RefrehsEqupRedPoint()
            end
    )
end

