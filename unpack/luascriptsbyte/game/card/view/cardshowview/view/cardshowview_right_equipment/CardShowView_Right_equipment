---创建对象时,入口构造函数
function CardShowView_Right_equipment:OnCreate()
    self.LastCardEquipProp = nil
    self.CardData = nil
    self.wearList = {}
    ---@type  ItemEquipmentBase[]
    self.EquipItem = {}
    self.EquipBtn = {
        [_G.EquipmentPart.Head] = self.go_table.aorbtn_Head,
        [_G.EquipmentPart.Clothes] = self.go_table.aorbtn_Clothes,
        [_G.EquipmentPart.Trousers] = false,
        [_G.EquipmentPart.Shoes] = self.go_table.aorbtn_Shoes,
        [_G.EquipmentPart.Weapon] = self.go_table.aorbtn_Weapon
    }

    if not self.showSpiritualTipsGo_Table then
        self.showSpiritualTipsGo_Table = _G.GetAutoGoTable(self.go_table.toggle_SpiritualTips,
                _G.handler(self, self.OnClickShowSpiritualTip))
        self.showSpiritualTipsGo_Table.toggle_SpiritualTips.isOn = true
    end

    self:InitEquipmentItem()
end

---点击饰品勾选
function CardShowView_Right_equipment:OnClickShowSpiritualTip(go, isOn)
    if go == self.showSpiritualTipsGo_Table.aorbtn_click then
        if not self.go_table.toggle_SpiritualTips.isOn then
            self.showSpiritualTipsGo_Table.toggle_SpiritualTips.isOn = true
            self.isSetEquipCultivate = true
            CardInfoManager.SetSpiritualRedPointShow(self.CardData.uid, 0)

            -- self:UpdateEquip(self.CardData)
            self:RefreshRoleEquipmentOneKey()

            _G.PopWindowManager:GetInstance():ShowAllTips(320130)
        else
            self.showSpiritualTipsGo_Table.toggle_SpiritualTips.isOn = false
            self.isSetEquipCultivate = false
            CardInfoManager.SetSpiritualRedPointShow(self.CardData.uid, 1)

            -- self:UpdateEquip(self.CardData)
            self:RefreshRoleEquipmentOneKey()

            _G.PopWindowManager:GetInstance():ShowAllTips(320131)
        end
    elseif go == self.showSpiritualTipsGo_Table.toggle_SpiritualTips then
        if self.isSetEquipCultivate then
            self.isSetEquipCultivate = false
        end
    end
end

