function CardShowView_Right_equipment:GetParentCanvas(obj)
    local canvas = obj:GetComponentInParentE(_G.typeof(_G.Canvas))
    if not canvas.overrideSorting then
        return self:GetParentCanvas(canvas.transform)
    else
        return canvas
    end
end
---设置灵契显示详情
function CardShowView_Right_equipment:ShowSpiritualDetail(isInit)
    if self.isRefreshing then
        return
    end

    self.isRefreshing = true
    if not isInit then
        ---属性变化提示
        require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
        local curPower = self.CardData.power
        if self.lastPower < curPower then
            require "CommonTipManager".OpenPowerUpView(self.lastPower, curPower - self.lastPower)
        end
        self.lastPower = curPower
    end
    local unlockData = _G.ConfigManager.discrete_cfg[114001] or {}
    local unlockPanel = self.CardData.star >= unlockData[1][1]
    self.go_table.obj_Node:SetActiveE((_G.AppSetting.IsXzns or unlockPanel) and 1 or 0)
    self.go_table.toggle_SpiritualTips:SetActiveE(0)--(unlockPanel and 1 or 0)
    if _G.AppSetting.IsXzns or (unlockData[1] and unlockPanel) then
        local spiritualBar = self.CardData.SpiritualBar or {}
        local childAmount = self.go_table.obj_Node:GetChildCountE() - 1
        if _G.AppSetting.IsXzns then
            childAmount = childAmount + 1
        end
        local wearSids = {}
        local spiritualData
        for index = 1, childAmount do
            spiritualData = spiritualBar[index]
            if spiritualData then
                wearSids[spiritualData.sid] = true
            end
        end
        for index = 1, childAmount do
            local obj = self.go_table["obj_node_" .. index]
            local tb = _G.GetAutoGoTable(obj)
            local isUnlock = self.CardData.star >= unlockData[1][index]
            tb.obj_locknode:SetActiveE(isUnlock and 0 or 1)
            tb.aorrawimage_xd:SetActiveE(0)
            tb.aortext_unlocktip.text = _G.GetLangPackValue(unlockTipText[index])
            tb.obj_normalNode:SetActiveE(isUnlock and 1 or 0)
            spiritualData = nil
            tb.obj_up:RemoveAllChildren()
            tb.trans_effect:RemoveAllChildren()
            if isUnlock then
                spiritualData = spiritualBar[index]
                tb.obj_normalNode:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder =
                self:GetParentCanvas(tb.obj_normalNode).sortingOrder + 5
                if spiritualData then
                    tb.obj_baseInfo:SetActiveE(1)
                    tb.obj_add:SetActiveE(0)
                    if not _G.string.IsNullOrEmpty(spiritualData.cfg.Icon) then
                        tb.aorrawimage_icon:LoadImage(
                                spiritualData.cfg.Icon,
                                function(trans)
                                    trans:SetLocalScaleXYZ(1.4)
                                    trans:SetActiveE(1)
                                    if _G.AppSetting.IsXzns then
                                        tb.aorimage_levelBG:SetActiveE(1)
                                    end
                                end
                        )
                    end
                    if spiritualData.cfg.suit>0 then
                        tb.aorrawimage_xd:SetActiveE(1)
                        tb.aorimage_bg.SpriteName="ui_xdspk_dk"
                    else
                        self:SetAorImageBg(tb.aorimage_bg, spiritualData:GetOrder())
                    end
                    tb.aortext_level.text = "Lv." .. spiritualData:GetLevel()
                    self.wearList[index] = spiritualData.uid

                    ---星级
                    local star = spiritualData:GetStar() or 0
                    for i = 1, 5 do
                        tb["aorimage_star" .. i]:SetActiveE(star >= i and 1 or 0)
                    end
                    tb.aorimage_upArray:SetActiveE(SpiritualModel:CheckSpiritualCanLvUpOrReplace(spiritualData, wearSids, self.CardData.uid, index) and 1 or 0)
                    if _G.AppSetting.IsXzns then
                        if spiritualData.cfg.suit>0 then
                            tb.trans_effect:ClearChildren()
                            local suitcfg=_G.ConfigManager.spiritual_suit_cfg[spiritualData.cfg.suit]
                            local  activesuitItem={}
                            for k,v in pairs(spiritualBar) do
                                if table.ContainsValue(suitcfg.name2,v.sid) and not table.ContainsValue(activesuitItem,v.sid) then
                                    table.insert(activesuitItem,v.sid)
                                end
                            end
                            local suitactive=false
                            for i = 1, #suitcfg.att_suit2 do
                                if #activesuitItem>=suitcfg.att_suit2[i][1] then
                                    suitactive=true
                                end
                            end
                            local effectcfg=suitactive and _G.ConfigManager.ui_effect_cfg.ef_shipinjihuo_jin or 
                                    _G.ConfigManager.ui_effect_cfg.ef_shipinliuguang_jin
                            _G.UIUtils.LoadEffectByCfg(
                                    effectcfg,
                                    tb.trans_effect,
                                    function(trans)
                                        if not self.go_table then
                                            _G.DestroyImmediate(trans)
                                            return
                                        end
                                    end
                            )
                        elseif spiritualBar[index]:GetOrder() == 4 then
                            _G.UIUtils.LoadEffectByCfg(
                                    _G.ConfigManager.ui_effect_cfg.ef_CardShowView_Right_equipment_cai,
                                    tb.trans_effect,
                                    function(trans)
                                        if not self.go_table or spiritualBar[index]:GetOrder() ~= 4
                                                or tb.trans_effect:GetChildCountE() > 1 then
                                            _G.DestroyImmediate(trans)
                                            return
                                        end
                                    end
                            )
                        end
                    end
                else
                    tb.obj_add:SetActiveE(1)
                    tb.obj_baseInfo:SetActiveE(0)
                    self:SetAorImageBg(tb.aorimage_bg, 0)
                    tb.aorimage_upArray:SetActiveE(0)
                end
                tb.aorimage_bg.color = _G.ColorTools.FormatColorByString("FFFFFF")
            else
                tb.obj_baseInfo:SetActiveE(0)
                self:SetAorImageBg(tb.aorimage_bg, 0)
                tb.aorimage_bg.color = _G.ColorTools.FormatColorByString("AAAAAA")
                tb.aorimage_upArray:SetActiveE(0)
            end

            tb.aorimage_lock:SetGray(true)
            tb.aorimage_lock:SetActiveE(1)
            tb.aortext_unlocktip:SetActiveE(0)
            if self.isSetEquipCultivate == true then
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Spiritual.id, index)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualLevelUp.id,
                        self.CardData.uid * 10 + index)
            end
            _G.SetEventTrigger(obj, "onClick", _G.handlerbind(self, self.OnClickItem, isUnlock, spiritualData, index))
        end
    end
    self.isRefreshing = false
end

---更新神器详情显示
function CardShowView_Right_equipment:UpdateArtifact()
    ---@type CardShowView
    local parent = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if not parent then
        return
    end
    parent:UpdateArtifact(self.CardData)
end

---设置品质背景图
function CardShowView_Right_equipment:SetAorImageBg(aorimage, quality)
    if _G.AppSetting.IsXzns then
        -- 灵契背景
        local spriteName
        if quality == 0 then
            spriteName = "ui_js_zb_sp_hui"
        elseif quality == 1 then
            spriteName = "ui_js_zb_sp_zi"
        elseif quality == 2 then
            spriteName = "ui_js_zb_sp_cheng"
        elseif quality == 3 then
            spriteName = "ui_js_zb_sp_hong"
        elseif quality >= 4 then
            spriteName = "ui_js_zb_sp_cai"
        end
        aorimage.SpriteName = spriteName
    else
        aorimage.SpriteName = _G.ItemSpiritualQuailty[quality]
    end
end

---灵契展示位点击事件
---@field spiritualData SpiritualData
function CardShowView_Right_equipment:OnClickItem(go, isOn, isUnlock, spiritualData, index, callBack)
    if isUnlock then
        if spiritualData then
            local btnDevelop = {
                name = _G.GetLangPackValue(90020400065),
                func = _G.handlerbind(self, self.DevelopSpiritual, spiritualData),
                close = true
            }
            local btnTakeOff = {
                name = _G.GetLangPackValue(90023400032),
                func = _G.handlerbind(self, self.TakeOffSpiritual, spiritualData, index),
                close = true
            }
            local btnReplace = {
                name = _G.GetLangPackValue(90020400047),
                func = _G.handlerbind(self, self.TryReplaceSpiritual, spiritualData, index),
                close = true
            }

            local data = {}
            data.data = spiritualData
            data.isSelf = false
            data.btn = { right = btnReplace, middle = btnDevelop, left = btnTakeOff }
            data.data.index = index
            data.data.lua = self
            if not callBack then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, { data }, 3)
            else
                callBack(data)
            end
        else
            self:TryReplaceSpiritual(spiritualData, index)
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(unlockTip[index])
    end
end

---培养灵契
---@field SpiritualData SpiritualData 灵契数据类
function CardShowView_Right_equipment:DevelopSpiritual(SpiritualData)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SpiritualDevelopView.Name,
            SpiritualData,
            function(cardData, lastPower)
                self.CardData = cardData
                self.lastPower = lastPower
                self:ShowSpiritualDetail()
            end,
            self.CardData,
            self.lastPower,
            self
    )
end

---脱下灵契
function CardShowView_Right_equipment:TakeOffSpiritual(SpiritualData, index)
    self.wearList[index] = nil
    SpiritualModel:TakeOffSpiritual(
            self.CardData,
            SpiritualData,
            index,
            function()
                self:ShowSpiritualDetail()
            end
    )
end

---替换灵契
---@field SpiritualData SpiritualData 灵契数据类
function CardShowView_Right_equipment:TryReplaceSpiritual(SpiritualData, index)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SpiritualReplaceView.Name,
            index,
            SpiritualData,
            function()
                self:ShowSpiritualDetail()
            end,
            self.CardData
    )
end

---一键穿戴和卸下
function CardShowView_Right_equipment:OneKeyOperationSpiritual(type)
    if self.isSetEquipCultivate == false then
        return
    end
    if type == operationType.Wear and _G.table.isEmptyOrNil(self.CardData.SpiritualBar) then
        SpiritualModel:OneKeyPutOnSpiritual2(
                self.CardData,
                function()
                    self:ShowSpiritualDetail()
                end
        )
        return
    end

    -- 收集当前已穿戴的灵契数据（按槽位 index 存储）
    local existIndexMap = {}
    local usedSpiritualUidMap = {}
    local usedSpiritualSidMap = {}
    if not table.isEmptyOrNil(self.CardData.SpiritualBar) then
        for _, data in pairs(self.CardData.SpiritualBar) do
            existIndexMap[data.index] = data.uid
            usedSpiritualUidMap[data.uid] = true
            usedSpiritualSidMap[data.sid] = true
        end
    end

    SpiritualModel:OneKeyDetachSpiritual(
            self.CardData,
            type == operationType.TakeOff,
            function()
                if type == operationType.Wear then
                    SpiritualModel:OneKeyPutOnSpiritual2(
                            self.CardData,
                            function()
                                self:ShowSpiritualDetail()
                            end,
                            { existIndexMap, usedSpiritualUidMap, usedSpiritualSidMap }
                    )
                    return
                end
                self:ShowSpiritualDetail()
            end
    )
end

---一键穿戴或卸载神器
---@param type number
function CardShowView_Right_equipment:OneKeyOperationArtifact(type)
    if not self.CardData or not CardInfoManager.IsArtifactAutoEquip(self.CardData.uid) then
        return
    end

    local model = ArtifactModel:GetInstance()
    if type == operationType.Wear then
        --穿戴神器
        local wearArtifact = model:GetCardCanPutOnArtifact(self.CardData.uid, true)
        if wearArtifact then
            model:PutOnArtifact(
                    self.CardData,
                    wearArtifact,
                    function()
                        self:UpdateArtifact()
                    end
            )
        end
    elseif not _G.table.isEmptyOrNil(self.CardData.ArtifactBar) then
        --卸载神器
        model:TakeOffArtifact(
                self.CardData,
                function()
                    self:UpdateArtifact()
                end
        )
    end
end

