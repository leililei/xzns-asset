---@param CardData CardData 卡牌数据
function CardShowView_Right_equipment:ShowCardInfo(CardData, show)
    if not CardData then
        if self.go_table ~= nil and _G.AppSetting.DEBUG then
            _G.LogError("卡牌装备页面卡牌数据丢失")
        end
        return
    end
    if show or not self.lastPower or self.CardData and self.CardData.uid ~= CardData.uid then
        self.lastPower = CardData.power
    end
    if self.CardData and self.CardData.uid == CardData.uid then
        _G.Events:GetInstance():Broadcast(_G.eCardShow.CardChangeProp, self.LastCardEquipProp)
    end

    self.CardData = CardData

    self.LastCardEquipProp = _G.GameUtil.GetPropUpData(self.CardData)
    local star = CardData:GetStar()
    local cacheKey = _G.PlayerModel:GetInstance().role_uid .. CardData.uid .. "SpiritualUnlock"
    if star > _G.PlayerPrefsManager.GetInt(cacheKey, 0) then
        _G.PlayerPrefsManager.SetInt(cacheKey, CardData:GetStar())
        require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.SpiritualPage.id,
                CardData.uid
        )
    end
    if CardData.type == _G.CardType.Timer then
        self:ShowTempSpiritualDetail()
    else
        self.go_table.aorbtn_attrib:SetActiveE(1)
        self:ShowSpiritualDetail(true)
    end
    self.go_table.obj_btns:SetActiveE(CardData.type == _G.CardType.Timer and 0 or 1)

    if _G.AppSetting.IsXzns then
        self.go_table.aortext_name.text = _G.GetLangPackValue(CardData.cfg.Name)
        CardInfoManager:SetElementsProfessionalSP(self.go_table.aorimage_element, CardData.cfg.Elements_new)
        self.go_table.aortext_desc.text = _G.GetLangPackValue(CardData.cfg.card_title)
        self.go_table.aortext_element.text = _G.GetLangPackValue(_G.ElementStrEnum[CardInfoManager:GetElementsKey(CardData.cfg.Elements_new)])
    end

    local childAmount = self.go_table.obj_Node:GetChildCountE() - 1
    if _G.AppSetting.IsXzns then
        childAmount = childAmount + 1
    end
    for index = 1, childAmount do
        local obj = self.go_table["obj_node_" .. index]
        local tb = _G.GetAutoGoTable(obj)
        local param = self.CardData.uid * 10 + index
        tb["obj_redpointLevelUp" .. index]:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.SpiritualLevelUp.id,
                param
        )
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Spiritual.id, index)
    end

    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Gemstone) then
        self.go_table.obj_gemstone:SetActiveE(1)
        self:UpdateGemstone()
    else
        self.go_table.obj_gemstone:SetActiveE(0)
    end

    if not self.equipItemInit then
        self.initEquipCall = _G.handlerbind(self, self.UpdateEquip, self.CardData)
    else
        self:UpdateEquip(self.CardData)
    end
end

---按钮点击事件在这里派发
function CardShowView_Right_equipment:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_remove" then
        ---一键卸下
        self:OnClick__AllUnfix()
        self:OneKeyOperationSpiritual(operationType.TakeOff)
        --self:OneKeyOperationArtifact(operationType.TakeOff)
        self.wearList = {}
    elseif name == "@_aorbtn_equip" then
        ---一键穿戴
        self:OnClick__AllPut()
        --if _G.table.isEmptyOrNil(self.CardData.SpiritualBar) then
        --英雄饰品槽位已装备饰品时，点一键装备不进行替换饰品
        self:OneKeyOperationSpiritual(operationType.Wear)
        --end
        --self:OneKeyOperationArtifact(operationType.Wear)
    elseif name == "@_aorbtn_attrib" then
        ---效果总览
        if not _G.table.isEmptyOrNil(self.CardData.SpiritualBar) then
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DecorationTipsView.Name,
                    { { data = self.CardData.SpiritualBar } },
                    4
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(920102)
        end
    elseif name == "@_aorbtn_Head" then
        self:OpenEquiip(_G.EquipmentPart.Head)
    elseif name == "@_aorbtn_Clothes" then
        self:OpenEquiip(_G.EquipmentPart.Clothes)
    elseif name == "@_aorbtn_Shoes" then
        self:OpenEquiip(_G.EquipmentPart.Shoes)
    elseif name == "@_aorbtn_Weapon" then
        self:OpenEquiip(_G.EquipmentPart.Weapon)
    elseif name == "@_aorbtn_recommendBtn" then
        ---推荐穿戴饰品
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualRecommendView.Name, self.CardData,
                _G.handler(self, self.ShowSpiritualDetail))
    elseif name == "@_aorbtn_gemstone" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneToggleView.Name)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
        if view then
            view:Close()
        end
    end
end

function CardShowView_Right_equipment:UpdateGemstone()
    local _, isResonance = require("CardResonanceModel"):GetInstance():GetIndexByUid(self.CardData.uid)
    self.go_table.obj_Resonance:SetActiveE(isResonance and 0 or 1)
    local gemList = require("GemstoneModel"):GetInstance():GetGemListByCardUid(self.CardData.uid)
    for i = 1, 4 do
        if not gemList[i] then
            self.go_table["aorrawimage_gem" .. i]:SetActiveE(0)
        else
            self.go_table["aorrawimage_gem" .. i]:SetActiveE(1)
            self.go_table["aorrawimage_gem" .. i]:LoadImage(gemList[i].cfg.icon)
        end
    end
    ---@type AttributeClass
    local attribute = require("GemstoneModel"):GetInstance():GetGemAttrByCardUid(self.CardData.uid)
    local attrOther=attribute:GetAttrByName(_G.AttCountType.other)
    local attrbasePercent=attribute:GetAttrByName(_G.AttCountType.basePercent)
    local _attribute =  _G.AttributeClassManager:GetInstance():GetAttribtueClass(0, _G.PowerType.equipment)
    for k,v in pairs(attrOther) do
        _attribute:AddValueByName(k, v, false)
    end
    for k,v in pairs(attrbasePercent) do
        _attribute:AddValueByName(k, v, false,_G.AttCountType.basePercent)
    end
    self.go_table.aortext_Gempower.text=_G.GetLangPackValue(93010010026,_G.GameUtil.NumberWY(_attribute:CalculatePower()))
end

---临时角色的灵契详情(默认全解锁)
function CardShowView_Right_equipment:ShowTempSpiritualDetail()
    if self.isRefreshing then
        return
    end
    self.isRefreshing = true
    local unlockData = _G.ConfigManager.discrete_cfg[114001] or {}
    if unlockData[1] then
        local spiritualBar = self.CardData.SpiritualBar or {}
        if _G.table.isEmptyOrNil(spiritualBar) then
            self.go_table.aorbtn_attrib:SetActiveE(0)
        else
            self.go_table.aorbtn_attrib:SetActiveE(1)
        end
        local childAmount = self.go_table.obj_Node:GetChildCountE()
        for index = 1, childAmount do
            local obj = self.go_table["obj_node_" .. index]
            local tb = _G.GetAutoGoTable(obj)
            tb.obj_locknode:SetActiveE(0)
            tb.aorrawimage_xd:SetActiveE(0)
            tb.obj_normalNode:SetActiveE(1)
            local spiritualData = nil
            tb.obj_up:RemoveAllChildren()
            tb.trans_effect:RemoveAllChildren()
            tb.obj_add:SetActiveE(0)
            spiritualData = spiritualBar[index]
            if spiritualData then
                tb.obj_add:SetActiveE(0)
                if not _G.string.IsNullOrEmpty(spiritualData.cfg.Icon) then
                    tb.aorrawimage_icon:LoadImage(
                            spiritualData.cfg.Icon,
                            function()
                                tb.aorrawimage_icon:SetActiveE(1)
                            end
                    )
                end
                self:CreateEffect(spiritualData:GetOrder(), tb.trans_effect)
                self:SetAorImageBg(tb.aorimage_bg, spiritualData:GetOrder())
            else
                tb.aorrawimage_icon:SetActiveE(0)
                self:SetAorImageBg(tb.aorimage_bg, 0)
            end

            if index < childAmount then
            end
            tb.obj_redpoint:SetActiveE(0)
            _G.SetEventTrigger(obj, "onClick", _G.handlerbind(self, self.OnClickTempItem, spiritualData))
        end
    end
    self.isRefreshing = false
end

---穿戴特效
function CardShowView_Right_equipment:CreateWearEffect(parentTran, callBack)
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    _G.UIUtils.LoadEffectByCfg(
            ui_effect_cfg.ef_hunlian_bao,
            parentTran,
            function(obj)
                if _G.IsNil(parentTran) then
                    _G.DestroyObject(obj)
                end
            end,
            function()
                if callBack then
                    callBack()
                end
            end
    )
end

---创建边框特效
function CardShowView_Right_equipment:CreateEffect(order, parentTran)
    local effectCfg
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    if order == 1 then
        effectCfg = ui_effect_cfg.ef_hunlian_zi
    elseif order == 2 then
        effectCfg = ui_effect_cfg.ef_hunlian_cheng
    elseif order == 3 then
        effectCfg = ui_effect_cfg.ef_hunlian_hong
    else
        effectCfg = ui_effect_cfg.ef_hunlian_cai
    end
    _G.UIUtils.LoadEffectByCfg(
            effectCfg,
            parentTran,
            function(obj)
                if _G.IsNil(parentTran) then
                    _G.DestroyObject(obj)
                end
            end
    )
end

