---获取 当前神石 限制等级上限
function CardShowView_Right_qh:GetNowCard_ShenSHi_lvLimit()
    local lv_Old = self.CardData.lv_Old
    --共鸣神石 二阶段不能升级(暂无)

    local card_level_cfg = _G.ConfigManager.card_level_cfg
    local shenShiMinLv = require("CardResonanceModel"):GetInstance():GetMinLevel()
    local nowlv = lv_Old
    for i = 1, 999 do
        nowlv = lv_Old + i
        local card_level_cfgItem = card_level_cfg[nowlv]
        if card_level_cfgItem == nil then
            break
        end
        if shenShiMinLv < card_level_cfgItem.min_level then
            ---  共鸣神石 核心成员 最低等级未达到要求
            break
        end
    end
    return nowlv - 1
end

--- 获取当前卡牌材料 能升级的上限
function CardShowView_Right_qh:GetNowCard_Res_lvLimit()
    local lv_Old = self.CardData.lv_Old
    local card_level_cfg = _G.ConfigManager.card_level_cfg
    local coin = 0
    ---- 当前等级消耗的资源是累计的  需要减去当前等级已消耗的资源
    local oldmaterialDic = {}
    local StorageDic = {}

    ---@type card_level_cfg
    local card_level_cfgItem = card_level_cfg[lv_Old]
    if card_level_cfgItem ~= nil then
        oldmaterialDic[_G.ResPropID.Coin] = card_level_cfgItem.coin
        oldmaterialDic[_G.ResPropID.CardExp] = card_level_cfgItem.exp

        local materialList = card_level_cfgItem.material
        if materialList ~= nil and #materialList > 1 then
            local len = #materialList / 2
            if len > 0 then
                for i = 1, len do
                    local key = i * 2
                    local materialId = materialList[key - 1]
                    local materialNum = (materialList[key] or 0)
                    if materialNum > 0 and materialId > 0 then
                        if oldmaterialDic[materialId] == nil then
                            oldmaterialDic[materialId] = 0
                        end
                        oldmaterialDic[materialId] = materialNum + oldmaterialDic[materialId]
                    end
                end
            end
        end
    end

    local nowList
    local nowlv = 0
    for i = 1, 999 do
        nowlv = lv_Old + i
        card_level_cfgItem = card_level_cfg[nowlv]
        if card_level_cfgItem == nil then
            return nowlv - 1
        else
            nowList = {}
            nowList[_G.ResPropID.Coin] = card_level_cfgItem.coin
            nowList[_G.ResPropID.CardExp] = card_level_cfgItem.exp
            local materialList = card_level_cfgItem.material
            if materialList ~= nil and #materialList > 1 then
                local len = #materialList / 2
                if len > 0 then
                    for i = 1, len do
                        local key = i * 2
                        local materialId = materialList[key - 1]
                        local materialNum = (materialList[key] or 0)
                        if materialNum > 0 and materialId > 0 then
                            if nowList[materialId] == nil then
                                nowList[materialId] = 0
                            end
                            nowList[materialId] = materialNum + nowList[materialId]
                        end
                    end
                end
            end

            for id, num in pairs(nowList) do
                if StorageDic[id] == nil then
                    StorageDic[id] = _G.StorageManager:GetInstance():GetItemCountBySid(id) or 0
                end
                if oldmaterialDic[id] == nil then
                    oldmaterialDic[id] = 0
                end

                ---  该等级消耗 -
                if num - oldmaterialDic[id] > StorageDic[id] then
                    return nowlv - 1
                end
            end
        end
    end
    return nowlv
end

--  获取当前 可升至等级
function CardShowView_Right_qh:GetNowCardAssignLv()
    if self.IsAssignLvUnlock == false then
        return
    end
    ---ZHJ-7736  【客户端】快速升级规则
    local nowlv = self.CardData.lv_Old
    local starLv = self:GetNowCard_Star_lvLimit()
    local ShenShiLV = self:GetNowCard_ShenSHi_lvLimit()
    local resLV = self:GetNowCard_Res_lvLimit()

    starLv = starLv - 20

    local minLv = math.min(starLv, ShenShiLV, resLV)

    minLv = self.mCardInfoManager:GetLevelSkill(self.CardData.Grade, minLv, self.CardData.lv_Old) or minLv

    local isAssignLv = minLv > nowlv + 10
    if isAssignLv then
        self.go_table.aortext_assignLv.text = _G.LangUtil.GetLangPackValue(90020300085, minLv)
        ---可升到的等级
        self.CardAssignLv = minLv
    else
        self.CardAssignLv = nil
        self:ShowAssignLvBtn()
    end
end

