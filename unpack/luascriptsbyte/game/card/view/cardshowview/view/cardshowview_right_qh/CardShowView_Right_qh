    end
    if consumeList == nil then
        consumeList = self.go_table.CardUpLvConsumeList
    end
    if self:View_Shuxing_CheckRoleUpLvConsume(consumeList) == false then
        return
    end
    local lastPower = self.CardData.power
    require("CardResonanceModel"):GetInstance():CheckPosLimitAndLevelUp(
        self.CardData.uid,
        lvCount,
        function(calProp)
            local power = self.go_table.longUpCount > 0 and self.longUpStartPower or self.CardData.power
            local Events = _G.Events:GetInstance()

            for key, value in pairs(consumeList) do
                local resid = value[1]
                local consume = value[3]
                _G.StorageManager:GetInstance():ConsumeItem(resid, 0, consume)
            end
            if call ~= nil then
                call()
            end
            if calProp then
                self.CardData:AddCardLv(0)
            end
            ---仓库更改后刷新一次  不然仓库扣除有延迟导致等级计算错误
            self:GetNowCardAssignLv()
            self:ShowAssignLvBtn()
            -- 刷新 死魂塔的 快速挑战红点
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.DeadsoulFast.id
            )
            local tempLV = 0
            local offset = self.CardData.power - lastPower
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(lastPower, offset)
                if self.go_table.longUpCount > 0 then
                    self.longUpStartPower = nil
                end
            end
            Events:Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignLevel,
                    tempLV
                },
                1
            )
            Events:Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignSidAssignLevel,
                    --- 指定SID卡牌升到N级（检测当前背包）
                    self.CardData.sid,
                    tempLV
                },
                1
            )
            Events:Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.CardResonance.FivePosLevel,
                    tempLV
                },
                1
            )
            Events:Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.CardResonance.PosLevelNum },
                1
            )
        end
    )
end

