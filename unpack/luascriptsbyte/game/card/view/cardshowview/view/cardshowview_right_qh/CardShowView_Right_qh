--- 该等级升级 消耗
function CardShowView_Right_qh:View_Shuxing_SetLvOneConsume(lv, delta)
    if lv == nil then
        lv = self.CardData.lv_Old
    end
    delta = delta or 1
    local isShowResConsume = false
    local subList = {}
    local card_level_cfg = _G.ConfigManager.card_level_cfg

    local oldCfg = card_level_cfg[lv]
    if oldCfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" CardInfoView:View_Shuxing_SetLvOneConsume lv:" .. tostring(lv) .. " 该等级配置未找到 ")
        end
        return isShowResConsume, subList
    end
    local oldmaterialList = oldCfg.material or {}
    lv = lv + delta
    local mCfg = card_level_cfg[lv]
    if mCfg ~= nil then
        --经验
        local exp = (mCfg.exp - oldCfg.exp) or 0
        --金币
        local coin = (mCfg.coin - oldCfg.coin) or 0
        --其他材料  id#数量#id#数量
        local materialList = mCfg.material or {}

        if materialList ~= nil and #materialList > 1 then
            local len = #materialList / 2
            if len > 0 then
                for i = 1, len do
                    local key = i * 2
                    local materialId = materialList[key - 1]

                    local materialNum = (materialList[key] or 0) - (oldmaterialList[key] or 0)
                    if materialNum > 0 and materialId > 0 then
                        table.insert(subList, { materialId, false, materialNum })
                    end
                end
            end
        end
        if exp > 0 then
            table.insert(subList, { _G.ResPropID.CardExp, false, exp })
        end
        if coin > 0 then
            table.insert(subList, { _G.ResPropID.Coin, false, coin })
        end

        isShowResConsume = true
    end
    return isShowResConsume, subList
end

--- 该卡 检测是否还可以升级
---@return number,number errid,(6)核心成员限制等级
function CardShowView_Right_qh:View_Shuxing_CheckUpLv(lv)
    -- return -1   程序配置错误
    -- return 0   可继续提升等级
    -- return 1   星级限制等级
    -- return 2   共鸣水晶限制等级（弃用）
    -- return 3   最高星级等级上限 240
    -- return 4   共鸣神石 二阶段不能升级
    -- return 5   已达到最大星级最大等级
    -- return 6   共鸣神石 核心成员 最低等级未达到要求
    -- return 7   共鸣神石暂未开放

    if lv == nil then
        lv = self.CardData.lv_Old
    end
    lv = lv + 1

    ---@type card_level_cfg
    local card_level_cfg = _G.ConfigManager.card_level_cfg[lv]
    if card_level_cfg ~= nil then
        local shenShiMinLv = require("CardResonanceModel"):GetInstance():GetMinLevel()
        if shenShiMinLv < card_level_cfg.min_level then
            ---  共鸣神石 核心成员 最低等级未达到要求
            if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Stone) then
                return 7
            end
            if _G.AppSetting.DEBUG then
                _G.Log("升级", "<color=red>" .. "共鸣神石 核心成员 最低等级未达到要求" .. "</color>")
            end
            return 6, card_level_cfg.min_level
        end
    end

    local level_limit = self:GetNowCard_Star_lvLimit()

    if level_limit == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("升级", "<color=red>" .. "程序配置出错" .. "</color>")
        end
        return -1
    end
    --- 星级限制等级
    if lv > level_limit then
        ---等级达到共鸣神石二阶段
        if lv > _G.tonumber(_G.ConfigManager.discrete_cfg[102509][1][1]) then
            return 5
        end
        local maxStar = self.MaxStarDic[self.CardData.Grade] and self.MaxStarDic[self.CardData.Grade][2] or 0
        if self.CardData.star >= maxStar then
            if _G.AppSetting.DEBUG then
                _G.Log("升级", "<color=red>" .. "已达到最大星级最大等级" .. "</color>")
            end
            return 5
        end

        return 1
    end

    return 0, level_limit
end

---@return boolean,boolean 材料是否足够,不足材料的sid
function CardShowView_Right_qh:View_Shuxing_CheckRoleUpLvConsume(ConsumeList)
    if ConsumeList == nil then
        ConsumeList = self.go_table.CardUpLvConsumeList
    end
    if ConsumeList == nil then
        return false
    end
    for key, value in pairs(ConsumeList) do
        local resid = value[1]
        local consume = value[3]

        if _G.StorageManager:GetInstance():CheckItem(resid, consume) == false then
            if resid == 202010100 then
                require "PopUpGiftBagModel":GetInstance():IsBtStoneDeficiency(true)
            end
            return false, resid
        end
    end
    return true
end

