function CardShowView_Right_qh:CardUplvCount(lvCount, call)
    local consumeList = {}
    for i = 1, lvCount do
        local isok, sublist = self:View_Shuxing_SetLvOneConsume(i + self.CardData.lv_Old - 1)
        if isok == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(120115)
            return
        end
        for _, value in pairs(sublist) do
            local findValue =
                table.find(
                    consumeList,
                    function(v)
                        if v[1] == value[1] then
                            return true
                        end
                    end
                )
            if findValue == nil then
                table.insert(consumeList, value)
            else
                findValue[3] = findValue[3] + value[3]
            end
        end
    end
    self:View_Shuxing_RoleUpLv(
        self.CardData.lv_Old + lvCount,
        lvCount,
        consumeList,
        function()
            self:AddCardLevel()
            if call ~= nil then
                call()
            end
        end
    )
end

function CardShowView_Right_qh:AddCardLevel(isLonePress)
    if isLonePress then
        self.CardData:AddCardLv(1, true)
    end
    self.mCardInfoManager:CardBagViewPlayEff_lv()
    self.mCardInfoManager:Updata_CardViewUpdataFun(self.CardData, true)
end

--- 检测能否升级 并弹出提示
---@param isDontTips boolean  true不显示tips提示界面
function CardShowView_Right_qh:View_Shuxing_CheckRoleUpLvAll(isDontTips)
    local lvErrid = self:View_Shuxing_CheckUpLv()
    if lvErrid > 0 then
        if isDontTips then
            return false
        end
        if lvErrid == 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, " 星级限制等级 \ntipsId未配置")
        elseif lvErrid == 2 then
            -- 临时 神石卡槽中  可共享等级
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, "在共鸣神石 卡槽中，不能操作等级 \ntipsId未配置")
        end
        return false
    end
    local isOK, resSid = self:View_Shuxing_CheckRoleUpLvConsume()
    if isOK == false then
        if isDontTips then
            return false
        end
        if resSid then
            ---true能使用道具获得缺少资源
            if
                _G.StorageManager:GetInstance():FastCheckItem(
                    resSid,
                    function()
                        self:UpdataRes()
                    end
                ) == true
            then
                if _G.AppSetting.DEBUG then
                    _G.Log("升级", "<color=red>" .. "共鸣神石水晶限制等级" .. "</color>")
                end
                return
            end
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, resSid)
        end
        return false
    end

    return true
end

--- 检测 是否解锁或升级技能
function CardShowView_Right_qh:View_Shuxing_CheckRoleUpGetSkill()
    local isOK, resSid = self:View_Shuxing_CheckRoleUpLvConsume(self.go_table.CardUpLvConsumeList)

    if isOK == false then
        if
            _G.StorageManager:GetInstance():FastCheckItem(
                resSid,
                function()
                    self:UpdataRes()
                end
            ) == true
        then
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(230303)
        return
    end
    ---@type params_CheckCardLvUpSkill
    local data = {}
    data.CardSid = self.CardData.sid
    data.lvL = self.CardData.lv_Old
    data.lvR = self.CardData.lv_Old + 1
    data.Order = self.CardData.Grade
    local upSkillID = require("CardInfoManager").CheckCardLvUpSkill(data)
    if upSkillID ~= nil then
        ---@type parms_CardPropLevelUpTipsView
        local data = {}
        data.skillID = upSkillID
        data.rolelv = self.CardData.lv_Old
        data.Call = function(isTrue)
            if isTrue == true then
                self:View_Shuxing_RoleUpLv(
                    self.CardData.lv_Old + 1,
                    1,
                    nil,
                    function()
                        self:AddCardLevel()

                        --- 保证升级后在显示窗口
                        ---@type params_CardPropLevelUpView
                        local data2 = {}
                        data2.lv = { self.CardData.lv_Old - 1, self.CardData.lv_Old }
                        data2.CardData = self.CardData

                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardPropLevelUpView.Name, data2)
                    end
                )
            end
        end
        data.subList = self.go_table.CardUpLvConsumeList
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardPropLevelUpTipsView.Name, data)
        return true
    end

    return false
end

function CardShowView_Right_qh:View_Shuxing_SetConsume()
    local isShowResConsume, subList
    local lvErrid, param = self:View_Shuxing_CheckUpLv()
    self.go_table.obj_sj:SetActiveE(self.CardData.type == _G.CardType.Normal and 1 or 0)
    if lvErrid > 0 then
        if lvErrid == 1 then
            if _G.AppSetting.IsXzns then
                self.go_table.aorimage_sjtipsBg:SetActiveE(1)
            end
            ---"等级已达到当前星级上限"  前往 升星
            self.go_table.aortext_sjtips.text = _G.LangUtil.GetLangPackValue(90020300076)

            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90020300075)

            isShowResConsume = false
        elseif lvErrid == 2 or lvErrid == 3 then
            if _G.AppSetting.IsXzns then
                self.go_table.aorimage_sjtipsBg:SetActiveE(0)
            end
            --【神石卡槽中 不可操作等级     /   达到最高星级等级上限 240 】  前往 共鸣神石
            self.go_table.aortext_sjtips.text = ""
            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90020300077)
            isShowResConsume = false
        elseif lvErrid == 5 then
            ---已达到最大星级最大等级
            if self.CardData.lv >= 300 then
                if _G.AppSetting.IsXzns then
                    self.go_table.aorimage_sjtipsBg:SetActiveE(1)
                end
                local langId = self.CardData:IsSp() and 90050200030 or 90020300206
                self.go_table.aortext_sjtips.text = _G.LangUtil.GetLangPackValue(langId)
            else
                if _G.AppSetting.IsXzns then
                    self.go_table.aorimage_sjtipsBg:SetActiveE(0)
                end
                self.go_table.aortext_sjtips.text = ""
            end
            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90020300077)
            isShowResConsume = false
            self.go_table.obj_sj:SetActiveE(0)
        elseif lvErrid == 6 then
            if _G.AppSetting.IsXzns then
                self.go_table.aorimage_sjtipsBg:SetActiveE(1)
            end
            ---共鸣神石 核心成员 最低等级未达到要求
            self.go_table.aortext_sjtips.text = _G.LangUtil.GetLangPackValue(90020300097, param)
            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90020300098)
            isShowResConsume = false
        elseif lvErrid == 7 then
            if _G.AppSetting.IsXzns then
                self.go_table.aorimage_sjtipsBg:SetActiveE(1)
            end
            ---共鸣神石未开放
            self.go_table.aortext_sjtips.text = _G.LangUtil.GetLangPackValue(90020500002, param)
            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90020300098)
            isShowResConsume = false
        end
    else
        local nowLv = self.CardData.lv_Old
        local dLv
        if self:CheckUpSkill() then
            dLv = 1
            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90031300029)
        else
            local minLv = self:GetNowCard_Res_lvLimit()
            local ShenShiLV = self:GetNowCard_ShenSHi_lvLimit()
            local nextLv = self.mCardInfoManager:GetNextLevelSkill(self.CardData.Grade, nowLv) or minLv
            nextLv = nextLv < nowLv and minLv or nextLv
            minLv = math.min(minLv, nextLv, param, ShenShiLV)
            dLv = minLv - nowLv
            if dLv < 1 then
                dLv = 1
            end
            if dLv > self.perLvMax then
                dLv = self.perLvMax
            end
            self.go_table.aortext_sjtxt.text = _G.LangUtil.GetLangPackValue(90021800244, dLv)
        end
        isShowResConsume, subList = self:View_Shuxing_SetLvOneConsume(nil, dLv)
        self.curUpLevelNum = dLv
        if _G.AppSetting.IsXzns then
            self.go_table.aorimage_sjtipsBg:SetActiveE(0)
        end
        self.go_table.aortext_sjtips.text = ""
    end

    self.isShowResConsume = isShowResConsume and self.CardData.type == _G.CardType.Normal
    if self.CardData.type ~= _G.CardType.Normal then
        if _G.AppSetting.IsXzns then
            self.go_table.aorimage_sjtipsBg:SetActiveE(0)
        end
        self.go_table.aortext_sjtips.text = ""
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_consume, self.isShowResConsume)
    if self.isShowResConsume == true then
        self.go_table.CardUpLvConsumeList = subList or {}
        self:UpdataRes()
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_levelUp, lvErrid >= 0)
    -- self.go_table.aorimage_levelUp:SetGray(lvErrid == 6 or lvErrid == 7)
end

