    self.jumpSkinId = id
    if self.jumpSkinId == 1 then
        key = "attribute"
    end
    ---判断是否为光武皮肤
    local weaponskincfg=_G.ConfigManager.artifact_skin_cfg[id]
    if weaponskincfg then
        key = "artifact"
    end
    self.curToggleKey = key
    self:RefreshSelectToggle()
end

