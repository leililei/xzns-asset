        attribute = _G.GetAutoGoTable(
            self.go_table.toggle_attribute,
            _G.handlerbind(self, self.OnClickToggle, "attribute", _G.handler(self, self.OnAttribute))
        ),
        equipment = _G.GetAutoGoTable(
            self.go_table.toggle_equipment,
            _G.handlerbind(self, self.OnClickToggle, "equipment", _G.handler(self, self.OnEquipment))
        ),
        starUp = _G.GetAutoGoTable(
            self.go_table.toggle_starUp,
            _G.handlerbind(self, self.OnClickToggle, "starUp", _G.handler(self, self.OnStarUp))
        ),
        artifact = _G.GetAutoGoTable(
            self.go_table.toggle_artifact,
            _G.handlerbind(self, self.OnClickToggle, "artifact", _G.handler(self, self.OnArtifact))
        ),
        skin = _G.GetAutoGoTable(
            self.go_table.toggle_skin,
            _G.handlerbind(self, self.OnClickToggle, "skin", _G.handler(self, self.OnSkin))
        ),
        rune = _G.GetAutoGoTable(
            self.go_table.toggle_rune,
            _G.handlerbind(self, self.OnClickToggle, "rune", _G.handler(self, self.OnRune))
        )
    }
end

function CardShowView_RightView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        self.curToggleKey = key
    end
    self.cardShowView:OnToggleCall(key)
    if call then
        call(isOn)
    end
end

function CardShowView_RightView:OnToggleCall(key, call)
    if not self.call[key] then
        self.call[key] = {}
    end
    _G.tbale.insert(self.call[key], call)
end

function CardShowView_RightView:OnAttribute(isOn)
    if _G.AppSetting.IsXzns then
        if not self.attributeGroup then
            self.attributeGroup = self.go_table.obj_attribute:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
        end
        self.attributeGroup.alpha = isOn and 1 or 0
        self.attributeGroup.blocksRaycasts = isOn
        if isOn then
            self.go_table.obj_attribute:SetLocalPositionToZero()
        else
            self.go_table.obj_attribute:SetLocalPosition(9999,9999,0)
        end
    else
        self.go_table.obj_attribute:SetActiveE(isOn and 1 or 0)
    end
    if not isOn then
        return
    end
    local key = "attribute"
    if not self.panelInit[key] then
        self.panelInit[key] = 0
        local prefabs = not _G.AppSetting.IsXzns and PanelPrefabs[key] or PanelPrefabs_xzns[key]
        _G.PoolsManager:GetInstance():Spawn(
            prefabs,
            _G.ePoolType.UIItem,
            self.go_table.obj_attribute,
            function(trans)
                local active = self.go_table.obj_attribute:GetActiveSelf()
                self.go_table.obj_attribute:SetActiveE(1)
                self.panelLua[key] = self:AddComponent(trans, require(PanelLuaFile[key]).New(trans))
                self.go_table.obj_attribute:SetActiveE(active)
                self.panelInit[key] = true
                if self.CardData then
                    self.panelLua[key]:ShowCardInfo(self.CardData, nil, self.isPreviewCardShow)
                end
                self:PlayOpenAni(key)
            end
        )
    elseif self.panelInit[key] == true then
        if self.CardData then
            self.panelLua[key]:ShowCardInfo(self.CardData, nil, self.isPreviewCardShow)
        end
        self:PlayOpenAni(key)
    end
end

