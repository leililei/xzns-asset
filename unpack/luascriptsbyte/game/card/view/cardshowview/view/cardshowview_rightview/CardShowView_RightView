-- 播放打开动画(星座)
function CardShowView_RightView:PlayOpenAni(key)
    if not _G.AppSetting.IsXzns then
        return
    end
    local aniName = PanelOpenAniName[key]
    if _G.string.IsNullOrEmpty(aniName) then
        return
    end
    local ani = self.panelAni[key]
    if not ani then
        if self.panelLua[key] then
            ani = self.panelLua[key].gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
            self.panelAni[key] = ani
        else
            return
        end
    end
    ani:Play(aniName,-1,0)
end


