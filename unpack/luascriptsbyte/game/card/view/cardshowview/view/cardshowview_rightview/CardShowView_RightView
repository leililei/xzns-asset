function CardShowView_RightView:RefreshSelectToggle()
    if self.curToggleKey == "equipment" then
        self.go_table.toggle_equipment.isOn = true
    elseif self.curToggleKey == "attribute" then
        self.go_table.toggle_attribute.isOn = true
    elseif self.curToggleKey == "starUp" then
        if self.go_table.toggle_starUp:GetActiveSelf() == 1 then
            self.go_table.toggle_starUp.isOn = true
        else
            self.curToggleKey = "equipment"
            self.go_table.toggle_equipment.isOn = true
        end
    elseif self.curToggleKey == "skin" then
        if self.go_table.toggle_skin:GetActiveSelf() == 1 then
            self.go_table.toggle_skin.isOn = true
        else
            if self.go_table.toggle_starUp:GetActiveSelf() == 1 then
                self.curToggleKey = "starUp"
                self.go_table.toggle_starUp.isOn = true
            elseif self.go_table.toggle_equipment:GetActiveSelf() == 1 then
                self.curToggleKey = "equipment"
                self.go_table.toggle_equipment.isOn = true
            else
                self.curToggleKey = "attribute"
                self.go_table.toggle_attribute.isOn = true
            end
        end
    elseif self.curToggleKey == "rune" then
        self.go_table.toggle_rune.isOn = true
    elseif self.curToggleKey == "artifact" then
        self.go_table.toggle_artifact.isOn = true
    end
end

--- 图鉴新增 单独判断skin页签
function CardShowView_RightView:UpdateSkinToggleState()
    local show = self.CardData.type ~= _G.CardType.Timer and
        require("CardCommentManager"):GetInstance():CheckCardSkinCfg(self.CardData.cfg)
    if not show and self.go_table.toggle_skin.isOn then
        self.go_table.toggle_attribute.isOn = true
    end
    local showArtifaceskin= self.CardData.type ~= _G.CardType.Timer and
            require("ArtifactIllustrationModel"):GetInstance():CheckCardIsShowArtifactSkin(self.CardData.sid)
    self.go_table.toggle_skin:SetActiveE(show and 1 or 0)
    self.go_table.toggle_artifact:SetActiveE(showArtifaceskin and 1 or 0)
end

function CardShowView_RightView:UpdateToggleState()
    if self.CardData.type == _G.CardType.Timer then
        self.curToggleKey = "attribute"
        self.go_table.toggle_equipment:SetActiveE(0)
        self.go_table.obj_equipment:SetActiveE(0)
        self.go_table.toggle_starUp:SetActiveE(0)
        self.go_table.obj_starUp:SetActiveE(0)
        self.go_table.toggle_skin:SetActiveE(0)
        self.go_table.obj_skin:SetActiveE(0)
        self.go_table.toggle_rune:SetActiveE(0)
        self.go_table.obj_rune:SetActiveE(0)
        return
    end
    self.go_table.toggle_equipment:SetActiveE(1)

    local unlockRune = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune)
    self.go_table.toggle_rune:SetActiveE(unlockRune and 1 or 0)
    local show = self.CardData.type ~= _G.CardType.Timer and
        require("CardCommentManager"):GetInstance():CheckCardSkinCfg(self.CardData.cfg)
    self.go_table.toggle_skin:SetActiveE(show and 1 or 0)
    self.go_table.toggle_artifact:SetActiveE(show and 1 or 0)
    if self.go_table.toggle_skin.isOn and not show then
        --self.go_table.toggle_attribute.isOn = true
        self.go_table.obj_skin:SetActiveE(0)
    elseif self.go_table.toggle_skin.isOn then
        self.go_table.obj_skin:SetActiveE(1)
    end
    show = self.CardData.star >= _G.ConfigManager.discrete_cfg[101204][1][1]
    self.go_table.toggle_artifact:SetActiveE(show and 1 or 0)
    if self.go_table.toggle_artifact.isOn and not show then
        self.go_table.toggle_attribute.isOn = true
        return
    end
    local unlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.CardDevelop)
    show =
        unlock and self.CardData.star < require("CardInfoManager"):GetInstance():GetMaxStarByOrder(self.CardData.Grade)
    self.go_table.toggle_starUp:SetActiveE(show and 1 or 0)
    if self.go_table.toggle_starUp.isOn and not show then
        --self.go_table.toggle_attribute.isOn = true
        --self.curToggleKey = "attribute"
        return
    end
end

