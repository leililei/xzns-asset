function CardShowView_Right_pf:onDragBegin(go, ed)
    self.startMousePos = ed.position.x
end

function CardShowView_Right_pf:onDragEnd(go, ed)
    local offset = ed.position.x - self.startMousePos
    if _G.math.abs(offset) < 1 then
        return
    end
    if offset < 0 then
        if self.NowPutSkinIndex + 1 > #self.NowPutSkin then
            self:ShowNew(0)
        else
            self:ShowNew(self.NowPutSkinIndex + 1)
        end
    else
        if self.NowPutSkinIndex - 1 >= 0 then
            self:ShowNew(self.NowPutSkinIndex - 1)
        else
            self:ShowNew(#self.NowPutSkin)
        end
    end
end

function CardShowView_Right_pf:Cradzuo()
    if self.NowPutSkinIndex - 1 >= 0 then
        self:ShowNew(self.NowPutSkinIndex - 1)
    else
        self:ShowNew(#self.NowPutSkin)
    end
end

