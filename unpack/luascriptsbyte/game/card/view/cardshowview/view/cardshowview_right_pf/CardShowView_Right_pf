---查询对应id数据
function CardShowView_Right_pf:SkinList(num)
    local ID, Card
    if num == 0 then
        ID = self.CardData.sid
        Card = CardCommentManager:CardData(ID, false)
    elseif num < 0 then
    elseif self.NowPutSkin[num] then
        -- body
        Card = skin_cfg[self.NowPutSkin[num]]
        ID = Card.id
    end
    return ID, Card
end

---查询是否拥有该皮肤
function CardShowView_Right_pf:HaveSkinDicIs(num)
    if self.CardData.sid == num then
        return true
    end
    local value = CardCommentManager:CradSid(self.CardData.sid, num)

    return value
end

---查询是否穿戴该皮肤
function CardShowView_Right_pf:CardWearSkinIs(num)
    -- if self.CardData.sid == num then
    --     return true
    -- end

    --local value = CardCommentManager:CardWearSkin(self.CardData.sid, num)
    if self.CardData.skin == 0 and self.CardData.sid == num then
        return true
    end
    if self.CardData.skin == num then
        return true
    end
    return false
end

---刷新显示的
function CardShowView_Right_pf:ShowNew(num)
    if num == nil then
        num = self.NowPutSkinIndex
    else
        self.NowPutSkinIndex = num
    end
    self:StartLoadRoleScene()
    local ID, Card = self:SkinList(num)
    CardCommentManager:AddChaXun(ID, false)
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.SkinCard.id,
        self.CardData.uid
    )
    self.go_table.obj_Crad:ClearChildren()
    if ID then
        local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad)
        obj:SetLocalPositionToZero()
        self:RefreshAwardItem(Card, obj)
        local noAtt = true
        if Card.base_att and #Card.base_att > 0 then
            noAtt = false
            --self:ShowProp(Card.base_att)
            self.go_table.obj_AllProp:SetActiveE(1)
            self.go_table.obj_WearEffect:SetActiveE(1)
            self.go_table.obj_AllProp:ClearChildren()
            self:ShowProp(Card.base_att, self.go_table.obj_AllProp, self.AllPropItemDic)
        else
            self.go_table.obj_AllProp:SetActiveE(0)
            self.go_table.obj_WearEffect:SetActiveE(0)
        end
        ---现在后端没有全队加成，暂时屏蔽
        if Card.team_base_att and #Card.team_base_att > 0 then
            noAtt = false
            self.go_table.obj_AllProp2:SetActiveE(1)
            self.go_table.obj_TeamEffect:SetActiveE(1)
            self.go_table.obj_AllProp2:ClearChildren()
            self:ShowProp(Card.team_base_att, self.go_table.obj_AllProp2, self.AllPropItemDic)
        else
            self.go_table.obj_AllProp2:SetActiveE(0)
            self.go_table.obj_TeamEffect:SetActiveE(0)
        end
        self.go_table.aortext_tips:SetActiveE(noAtt and 1 or 0)
        --self.CardData:SetSkin(self.NowPutSkinIndex)
    end

    -- if self.noSkin then
    --     return
    -- end
    self.go_table.obj_Crad2:ClearChildren()
    self.go_table.obj_Crad1:ClearChildren()

    if #self.NowPutSkin == 1 then
        if num == 0 then
            ID, Card = self:SkinList(num + 1)

            if ID then
                local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad2)
                obj:SetLocalPositionToZero()
                self:RefreshAwardItem(Card, obj, num + 1)
            end
            -- self.go_table.obj_Crad1:ClearChildren()
        else
            ID, Card = self:SkinList(num - 1)

            if ID then
                local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad1)
                obj:SetLocalPositionToZero()
                self:RefreshAwardItem(Card, obj, num - 1)
            end
            -- self.go_table.obj_Crad2:ClearChildren()
        end
    else
        local left = num - 1 < 0 and #self.NowPutSkin or num - 1
        ID, Card = self:SkinList(left)

        if ID then
            local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad1)
            obj:SetLocalPositionToZero()
            self:RefreshAwardItem(Card, obj, left)
        end
        local right = num + 1 > #self.NowPutSkin and 0 or num + 1
        ID, Card = self:SkinList(right)

        if ID then
            local obj = _G.InstantiateObject(self.go_table.obj_CardItem, self.go_table.obj_Crad2)
            obj:SetLocalPositionToZero()
            self:RefreshAwardItem(Card, obj, right)
        end
    end
end

---奖励显示
function CardShowView_Right_pf:RefreshAwardItem(Card, obj, num)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCard, num))
    _G.SetEventTrigger(tb.aorbtn_Click, "onDragBegin", _G.handler(self, self.onDragBegin))
    _G.SetEventTrigger(tb.aorbtn_Click, "onDragEnd", _G.handler(self, self.onDragEnd))
    if Card.Name then
        self.cardName = Card.Name
    else
        self.cardName = _G.ConfigManager.card_cfg[Card.card].Name
    end
    tb.obj_Redpoint:SetActiveE(CardCommentManager:ChaXun(Card.id) and 1 or 0)
    tb.aortext_CardName.text = _G.GetLangPackValue(self.cardName)
    tb.aortext_SkinName.text = _G.GetLangPackValue(Card.name or 90020800034)
    tb.aorimage_Bg.SpriteName = Card.name and "ui_szsc_pifu_frame" or "ui_szsc_yuanpi_frame"
    -- tb.aorimage_Hei.SpriteName = Card.name and "ui_szsc_pifu_frame" or "ui_szsc_yuanpi_frame"
    if AppSetting.IsXzns then
        tb.aorrawimage_Card:LoadImage(
            Card.Photo2 and Card.Photo2 or Card.Photo,
            function(image)
                if image then
                    image:SetNativeSize()
                    image:SetActiveE(1)
                end
            end
        )
    else
        tb.aorrawimage_Card:LoadImage(
            Card.Photo,
            function(image)
                if image then
                    image:SetNativeSize()
                    image:SetActiveE(1)
                end
            end
        )
    end
    local isHave = self:HaveSkinDicIs(Card.id)
    local isWear = self:CardWearSkinIs(Card.id)
    tb.aorimage_Hei:SetActiveE(isHave and 0 or 1)
    tb.aorimage_Wear:SetActiveE(isWear and 1 or 0)
    if self.jumpSkinId ~= nil then
        tb.aorimage_Hei:SetActiveE(0)
        tb.aorimage_Wear:SetActiveE(0)
    end

    tb.gameObject:SetActiveE(1)
end

function CardShowView_Right_pf:OnClickCard(_, _, index)
    if index then
        self:ShowNew(index)
    end
end

function CardShowView_Right_pf:ShowProp(additions, parent, dic)
    ------ local scale = self.CurArrayData:GetStarAllAttr()
    local len = #additions

    local obj, num

    for i, v in pairs(additions) do
        ---生成属性条

        obj = _G.InstantiateObject(self.go_table.obj_propItem, parent)
        --local obj = _G.GetAutoGoTable(tb)

        -- _G.table.insert(dic, obj)

        num = _G.tonumber(v[3])
        num = _G.AttributeClassManager:GetInstance():GetShowProp(v[1], v[2], num, 0.01, 1)
        self:SetProp(
            obj,
            _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[v[1]].ID].name),
            num
        )
        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #dic do
        dic[i]:SetActiveE(0)
    end
end

