function CardShowView_Right_pf:SetSortOrder()
    local base = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if not base then
        base = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
    end
    if base then
        _G.UIUtils.SetCanvasSortingOrder(self.gameObject, base.gameObject)
    end
end

function CardShowView_Right_pf:CardSid(id, skinId)
    local data, skin = CardCommentManager:CardData(skinId, true)
    self.CradSid = CardCommentManager:CradSid(id, skinId)
    self.desc = data.card_title
    local str = 2
    if self.CradSid or id == skinId then
        if self:CardWearSkinIs(skinId) then
            str = 4
        else
            str = 1
        end
    else
        if skin and skin.way > 0 then
            self.CaedBtn = false
            self.CradNum = skin.way
        else
            self.CaedBtn = true
            self.CradNum = 0
        end
    end

    if self.Params.UI.Btn[str] then
        --- 如果有jumpId 说明是跳转皮肤过来的，此时只在可以去获得的时候展示按钮
        if self.jumpSkinId ~= nil then
            self.go_table.aorbtn_btn:SetActiveE(str == 2 and 1 or 0)
        end
        self.go_table.aortext_btn.text = _G.GetLangPackValue(self.Params.UI.Btn[str].langId)
        self.go_table.aorimage_btn:SetGray(self.Params.UI.Btn[str].isGray)
        self.go_table.aorimage_btn.color = _G.ColorTools.FormatColorByString(self.Params.UI.Btn[str].isGray and "A9A9A9" or
            "FFFFFF")
        self.go_table.aortext_btn.color = _G.ColorTools.FormatColorByString(self.Params.UI.Btn[str].isGray and "434343" or
            "8C2D14")
    end
end

function CardShowView_Right_pf:Btn()
    ---是否已解锁，解锁后可替换穿戴
    local sid = self.NowPutSkinIndex == 0 and self.CardData.cfg.id or self.NowPutSkin[self.NowPutSkinIndex]
    local unlock = self:HaveSkinDicIs(sid)
    if unlock then
        if not self:CardWearSkinIs(sid) then
            self:OnClick_sure()
        end
    else
        -- ZHJH-9040 通过item的way显示皮肤的获取路径
        local skinItemSid = _G.ConfigManager.skin_cfg[sid].item
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, skinItemSid)
        -- if self.skinid == 113020001 then
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InitialView.Name, nil, true)
        --     return
        -- end
        --是否可跳转前往获得
        -- if not self.CaedBtn then
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, self.CradNum)
        -- end
    end
end

function CardShowView_Right_pf:StartLoadRoleScene()
    local str
    if self.NowPutSkinIndex == 0 then
        str = self.CardData.sid
        self.skinid = nil
    else
        str = self.NowPutSkin[self.NowPutSkinIndex]
        self.skinid = str
    end
    self:CardSid(self.CardData.sid, str)
    if self.str == str then
        return
    end

    local tWindow = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if tWindow == nil then
        -- 可能是预览界面
        tWindow = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
    end
    if tWindow ~= nil then
        tWindow:StartLoadRoleScene(self.CardData, str, _G.handlerbind(self, self.Shou))
    end
end

function CardShowView_Right_pf:Shou(ca, call)
    if ca and self.skinid == nil then
        self.skinid = ca
    elseif self.skinid == self.CardData.sid then
        -- body
        self.skinid = nil
    end
    if self.skinid == nil then
        return
    end
    local cfg = self.skinid == self.CardData.sid and _G.ConfigManager.card_cfg[self.skinid] or
        _G.ConfigManager.skin_cfg[self.skinid]
    if not cfg then
        return
    end

    if _G.AppSetting.IsXzns then
        self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.Name or cfg.name)
        self.go_table.aortext_desc.text = self.desc and _G.GetLangPackValue(self.desc) or ""

        local bgPath = cfg.pos_bg
        if string.IsNullOrEmpty(bgPath) then
            bgPath = require("CardInfoManager"):GetInstance():GetCardElementBg(self.CardData:GetElement())
        end
        self.go_table.aorrawimage_bg:LoadImage(bgPath)

        self.go_table.obj_cardSpine:ClearChildren()
        local pathList = _G.string.split(cfg.ModelPathHi, "/")
        self.pathName = pathList[#pathList]
        if AppSetting.IsXzns then
            ---@type SpineClick
            local SpineClick_Lua = self.go_table.SpineClick_Lua
            if SpineClick_Lua then
                SpineClick_Lua:SetCardSid(cfg.id)
            end
        end
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_cardSpine,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                trans.gameObject:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
                self.go_table.obj_cardSpine:SetLocalScaleXYZ(cfg.size2)
                local count = self.go_table.obj_cardSpine:GetChildCountE()
                if count > 1 then
                    for i = 1, count do
                        local obj = self.go_table.obj_cardSpine:GetChildE(i - 1)
                        obj:SetActiveE(obj:GetName() == self.pathName and 1 or 0)
                    end
                end
                if _G.AppSetting.IsXzns then
                    local spineCfg = _G.ConfigManager.card_show_cfg[cfg.id] or _G.ConfigManager.skin_cfg[cfg.id]
                    local idle = spineCfg.display_idle[1]
                    _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true, cfg.id)
                end
            end
        )
        self.go_table.obj_miniSpine:ClearChildren()
        if cfg.Order == 1 then
            self.go_table.obj_miniSpine:SetActiveE(0)
        else
            self.go_table.obj_miniSpine:SetActiveE(1)
            local path = cfg.spine and cfg.spine[1] or cfg.ModelPathHi
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_miniSpine,
                function(obj)
                    if not self.go_table then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalScaleXYZ(cfg.size6 or 1.2)
                    local sg = obj:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    sg.AnimationState:SetAnimation(0, "stand_2", true)

                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, obj, godHaloID)
                        end
                        local artifactskinid=require("ArtifactIllustrationModel"):GetInstance():
                        GetArtifactSkinidByCardSkinid(self.CardData.sid,self.skinid)
                        if artifactskinid then
                            _G.UIUtils.LoadArtifacteffect(obj,self.CardData.sid ,artifactskinid,nil)
                        end
                    end
                end
            )
        end
    end
    if call then
        call(cfg)
    end
end

---@param CardData CardData
function CardShowView_Right_pf:ShowCardInfo(CardData, num, jumpSkinId)
    -- if num then
    --     self.NowPutSkinIndex = num
    -- end
    self.jumpSkinId = jumpSkinId
    self.go_table.obj_WearEffect:SetActiveE(0)
    self.go_table.obj_TeamEffect:SetActiveE(0)
    if _G.AppSetting.IsXzns then
        self.go_table.aorimage_order.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(CardData
            :GetGrade())
    end
    self.skinid = nil
    if self.CardData and self.CardData.sid == CardData.sid then
        -- self.NowPutSkinIndex = 0

        if self.skinid then
            for key, value in pairs(self.NowPutSkin) do
                if value == self.CardData.skin then
                    self.NowPutSkinIndex = key
                end
            end
        end
        self.noSkin = #self.NowPutSkin == 0
    else
        ---@type CardData
        self.CardData = CardData
        if _G.AppSetting.IsXzns then
            self.NowPutSkin = {}
            if not _G.table.isEmptyOrNil(self.CardData.cfg.skin) then
                for _, v in pairs(self.CardData.cfg.skin) do
                    local cfg = _G.ConfigManager.skin_cfg[v]
                    if cfg.skin_show and cfg.skin_show == true then
                        _G.table.insert(self.NowPutSkin, v)
                    end
                end
            end
        else
            self.NowPutSkin = require("CardCommentManager"):GetInstance():GetCardSkinCfgs(self.CardData.cfg) or {}
        end
        self.noSkin = #self.NowPutSkin == 0
        if self.CardData.skin ~= 0 then
            for key, value in pairs(self.NowPutSkin) do
                if value == self.CardData.skin then
                    self.NowPutSkinIndex = key
                end
            end
        else
            self.NowPutSkinIndex = 0
        end
        --_G.table.insertto(self.NowPutSkin, self.CardData.cfg.skin)

        self:CardSid(self.CardData.sid, self.NowPutSkin[1])

        self.AllPropItemDic = {}
        self.HaveSkinCount = 0
    end
    self.go_table.aorbtn_You:SetActiveE(self.noSkin and 0 or 1)
    self.go_table.aorbtn_Cradzuo:SetActiveE(self.noSkin and 0 or 1)
    --- 如果是跳转过来的 以跳转ID为准，不考虑穿戴的皮肤
    if self.jumpSkinId ~= nil then
        for key, value in pairs(self.NowPutSkin) do
            if value == self.jumpSkinId then
                self.NowPutSkinIndex = key
            end
        end
    end

    self:ShowNew(self.NowPutSkinIndex)

    -- self:SetCardItemCount(skinArr)
    -- self:ShowName()
    -- self:ShowNowPut(self.NowPutSkinIndex)
end

