---@param CardData CardData 卡牌数据
function CardShowView_Right_starUp:ShowCardInfo(CardData, reset)
    if not CardData then
        self:Close()
        return
    end
    if _G.AppSetting.IsXzns then
        local SpriteName
        for i = 1, 5 do
            SpriteName = require("CardInfoManager"):GetInstance():GetHuoSpriteName(CardData.star, i)
            self.go_table["aorimage_star" .. i].SpriteName = SpriteName
            self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
        end
        self.go_table.aortext_curLv.text = CardData.lv
        self.go_table.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(CardData.power, false)
        self.go_table.aorimage_Orderzi.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(CardData.Grade)
        local tag = require("CardInfoManager"):GetInstance():GetCardGradeFlag(CardData.Grade, CardData.sid)
        self.go_table.aorimage_Tag:SetActiveE(tag and 1 or 0)
        self.go_table.trans_TagEffNode:SetActiveE(tag and 1 or 0)
        if tag then
            self.go_table.aorimage_Tag.SpriteName = tag
            if not self.tagEffIsLoad then
                self.tagEffIsLoad = true
                _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_hexinbiaoqian,
                        self.go_table.trans_TagEffNode,
                        function(trans)
                            if not self.go_table then
                                _G.DestroyImmediate(trans)
                                return
                            end
                        end
                )
            end
        end
    end
    self.maxStar = require("CardInfoManager"):GetInstance():GetMaxStarByOrder(CardData.Grade)
    local reset = reset or self.CardData ~= CardData
    self.CardData = CardData
    local curStar = self.CardData.star
    if curStar >= self.maxStar then
        return
    end
    require("CardInfoManager"):GetInstance():SetCanUpStarUid(CardData.uid)
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.RedPointCardUpStar.id,
        CardData.uid
    )
    local nextStar = curStar + 1
    if nextStar > self.maxStar then
        nextStar = curStar
    end
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local order, starCount = CardInfoManager:GetOrderStarCount(curStar)
    local spriteName, starTb, color
    ---@type CardShowView_Right_starUp._obj_curStar_GoTable
    local tb = _G.GetAutoGoTable(self.go_table.obj_curStar)
    for i = 1, 5 do
        starTb = tb["aorimage_star" .. i]
        spriteName = CardInfoManager:GetHuoSpriteName(curStar, i, order, starCount)
        starTb.SpriteName = spriteName
        starTb:SetActiveE(spriteName ~= nil and 1 or 0)
    end
    if starCount == 0 then
        if order == 7 then
            self.go_table.aortext_starZeroText2:SetActiveE(1)
            self.go_table.aortext_starZeroText:SetActiveE(0)
        else
            self.go_table.aortext_starZeroText2:SetActiveE(0)
            self.go_table.aortext_starZeroText:SetActiveE(1)
            self.go_table.aortext_starZeroText.color = require("CardInfoManager"):GetInstance():GetNameColorByStar(nextStar, order)
            self.go_table.aortext_starZeroText.text = _G.GetLangPackValue(starDesc[order])
        end
    else
        self.go_table.aortext_starZeroText2:SetActiveE(0)
        self.go_table.aortext_starZeroText:SetActiveE(0)
    end

    order, starCount = CardInfoManager:GetOrderStarCount(nextStar)
    tb = _G.GetAutoGoTable(self.go_table.obj_nextStar)
    for i = 1, 5 do
        starTb = tb["aorimage_star" .. i]
        spriteName = CardInfoManager:GetHuoSpriteName(nextStar, i, order, starCount)
        starTb.SpriteName = spriteName
        starTb:SetActiveE(spriteName ~= nil and 1 or 0)
    end
    if starCount == 0 then
        if order == 7 then
            self.go_table.aortext_nextStarZeroText2:SetActiveE(1)
            self.go_table.aortext_nextStarZeroText:SetActiveE(0)
        else
            self.go_table.aortext_nextStarZeroText2:SetActiveE(0)
            self.go_table.aortext_nextStarZeroText:SetActiveE(1)
            self.go_table.aortext_nextStarZeroText.color = require("CardInfoManager"):GetInstance():GetNameColorByStar(nextStar, order)
            self.go_table.aortext_nextStarZeroText.text = _G.GetLangPackValue(starDesc[order])
        end
    else
        self.go_table.aortext_nextStarZeroText2:SetActiveE(0)
        self.go_table.aortext_nextStarZeroText:SetActiveE(0)
    end

    local cfg = _G.ConfigManager.card_star_cfg[require("CardInfoManager"):GetInstance():GetStarCfgId(self.CardData.cfg.Elements_new, nextStar)]
    self.go_table.aortext_attrRate.text = cfg.att_growth // 100 .. "%"
    self.go_table.aortext_lv.text = _G.GetLangPackValue(90020600039, cfg.level_limit)

    local unlockStr
    if nextStar == _G.ConfigManager.discrete_cfg[101204][1][1] then
        --神器
        unlockStr = _G.GetLangPackValue(9002070035)
    elseif nextStar == _G.ConfigManager.discrete_cfg[107405][1][1] then
        --灵脉
        unlockStr = _G.GetLangPackValue(9002070034)
    else
        local stars = _G.ConfigManager.discrete_cfg[114001][1] --灵契
        for i = 1, #stars do
            if nextStar == stars[i] then
                unlockStr = _G.GetLangPackValue(9002070036)
                break
            end
        end
    end
    self.go_table.aortext_unlock.text = unlockStr or ""
    self.go_table.obj_unlock:SetActiveE(unlockStr and 1 or 0)

    if reset then
        self:ResetAllConsume()
    end
end

function CardShowView_Right_starUp:ResetAllConsume()
    self.embattleUids = {}
    self.consumeCard = {}
    local cfg = _G.ConfigManager.card_star_cfg[require("CardInfoManager"):GetInstance():GetStarCfgId(self.CardData.cfg.Elements_new,self.CardData.star)]
    self.consumeSelf = {}
    self.consumeStar = {}
    local index = 0
    if #cfg.materials_oneself > 0 then
        for i = 1, cfg.materials_oneself[2] do
            index = index + 1
            self.consumeSelf[index] = true
            self.consumeStar[index] = cfg.materials_oneself[1]
        end
    end
    if #cfg.materials_elements > 0 then
        for i = 1, cfg.materials_elements[2] do
            index = index + 1
            self.consumeSelf[index] = false
            self.consumeStar[index] = cfg.materials_elements[1]
        end
    end
    self.consumeNum = index
    self:AutoFindSelfCard()
    self:UpdateConsumeItem(1, index < 1)
    self:UpdateConsumeItem(2, index < 2)
    self:UpdateConsumeItem(3, index < 3)
end

---自动寻找本体卡
function CardShowView_Right_starUp:AutoFindSelfCard()
    local star
    for i = 1, 3 do
        if self.consumeSelf[i] then
            star = self.consumeStar[i]
            break
        end
    end
    if star == nil then
        return
    end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    cards = _G.table.chooseToArray(
        cards,
        function(_, v)
            return v.star == star and v.sid == self.CardData.sid and v.uid ~= self.CardData.uid and
                not _G.table.ContainsValue(uids, v.uid)
        end
    )
    _G.SortList(
        cards,
        function(v)
            return -v:GetRealLevel()
        end
    )
    self.tempSelfCards = cards
    for i = 1, 3 do
        if self.consumeSelf[i] then
            self:FindOneSelfCard(i)
        end
    end
end

function CardShowView_Right_starUp:FindOneSelfCard(index)
    local card = _G.table.remove(self.tempSelfCards)
    if card then
        -- if card.shenshiPosType ~= _G.StonePosType.PosZero then --共鸣神石槽位卡
        --     self:FindOneSelfCard(index)
        --     return
        -- end
        ---否则判断是否可选 提示 上锁 下阵
        local isReady = not require("CardInfoManager").CardReadyDestroy(card, nil, nil, nil, false,true)
        if isReady then
            self.consumeCard[index] = card
        else
            self:FindOneSelfCard(index)
        end
    end
end

function CardShowView_Right_starUp:UpdateConsumeItem(index, hide)
    ---@type CardShowView_Right_starUp._obj_consume1_GoTable
    local tb = self.consumeItems[index]
    tb.gameObject:SetActiveE(hide and 0 or 1)
    if hide then
        return
    end
    local cardData = self.consumeCard[index]
    local isSelf = self.consumeSelf[index]
    local star = self.consumeStar[index] or 0
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local order, starCount = CardInfoManager:GetOrderStarCount(star)
    local element = cardData and cardData.cfg.Elements_new or self.CardData.cfg.Elements_new
    CardInfoManager:SetElementsProfessional(tb.aorimage_element, element)
    tb.aorimage_element:SetActiveE((cardData or element ~= _G.CardElementType.God) and 1 or 0)
    tb.aorimage_colorBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, order)
    tb.aorimage_black:SetActiveE(0)--not cardData and 1 or 0)

    if cardData then
        tb.aorimage_jue:SetActiveE(1)
        tb.aorimage_icon.SpriteName = cardData.cfg.Icon
        tb.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(cardData.cfg.Order)
        if cardData.cfg.UnitType == 7 and not require("CardInfoManager"):GetInstance():CheckMultiMatch(cardData.cfg.Elements_new, self.CardData.cfg.Elements_new) then
            tb.aorimage_element:SetActiveE(0)
        end
    else
        tb.aorimage_jue:SetActiveE(isSelf and 1 or 0)
        if isSelf then
            tb.aorimage_icon.SpriteName = self.CardData.cfg.Icon
            tb.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(self.CardData.cfg.Order)
        else
            tb.aorimage_icon.SpriteName = self.defaultHead
        end
    end
    local spriteName, starTb
    for i = 1, 5 do
        starTb = tb["aorimage_star" .. i]
        spriteName = CardInfoManager:GetHuoSpriteName(star, i, order, starCount)
        starTb.SpriteName = spriteName
        starTb:SetActiveE(spriteName ~= nil and 1 or 0)
    end
    tb.aorimage_add:SetActiveE(cardData == nil and 1 or 0)
    tb.aorimage_mask:SetActiveE(cardData ~= nil and 1 or 0)
    tb.aortext_consumeNum.text = cardData and "(<color=#087023>1</color>/1)" or "(<color=#840709>0</color>/1)"
end

function CardShowView_Right_starUp:OnClickBtn_StartUpStar()
    if self.isReadyUpStar then
        return
    end
    if _G.table.count(self.consumeCard) < self.consumeNum then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsIdDic.addUpstar)
        return
    end

    local allCard = _G.table.toArray(self.consumeCard)
    local CardResonanceModel = require("CardResonanceModel"):GetInstance()
    local temp
    local tempList = {}
    local blackList = {}
    for k, v in pairs(allCard) do
        _, temp = CardResonanceModel:GetIndexByUid(v.uid)
        if temp then
            _G.table.insert(tempList, v.uid)
        else
            blackList[v.uid] = true
        end
    end

    local overList = CardResonanceModel:CardDownarray(tempList, blackList)
    if #overList ~= 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError(overList, "需要重置的卡牌uid")
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardDevelopView_tip.Name,
            overList,
            _G.handlerbind(self, self.UpStarCall, allCard)
        )
        return

    else
        self:UpStarCall(allCard)
    end
end

function CardShowView_Right_starUp:UpStarCall(allCard)
    local havePrecious = false
    local haveCore = false
    local hasMain = false
    local haveSP = false
    self.UpStarDelCardDataList = {}
    ---升星消耗材料卡list
    self.UpStarConsumePropList = {}
    for i = 1, #allCard do
        local CardData = allCard[i]
        if CardData.type ~= _G.CardType.Prop then
            _G.table.insert(self.UpStarDelCardDataList, CardData)
            if self.CardData.sid == CardData.cfg.id then
                hasMain = true
            end

            if CardData:GetGrade() >= 5 and not self.consumeSelf[i] then
                --核心卡
                haveCore = true
                if CardData:GetGrade() == 7 then 
                    haveSP = true
                end
            end
        else
            _G.table.insert(self.UpStarConsumePropList, CardData)
        end
    end
    ---ZHJ-27934 当吃的卡有本地时不在显示precious提示
    -- if hasMain then
    --     havePrecious = false
    -- end

    if self:CheckEquipmentStorageMax() == false then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsIdDic.storage_max_Equipment)
        return
    end
    local upStar = function()
        self:UpStarTips1(
            function()
                self:UpStarTips2(
                    function()
                        self:ReadyUpStar()
                    end
                )
            end
        )
    end
    if haveSP then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            self.tipsIdDic.spCard,
            nil,
            function()
                upStar()
            end
        )
    elseif haveCore then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            self.tipsIdDic.core,
            nil,
            function()
                upStar()
            end
        )
    else
        upStar()
    end
end

