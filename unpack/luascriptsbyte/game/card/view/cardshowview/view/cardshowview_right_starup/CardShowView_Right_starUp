end

function CardShowView_Right_starUp:StartUpStar2(Cardids, ReFun)
    local mCardData = self.CardData

    ---@type card.c2s_card_up_star
    local pbdata = {}
    ---@type card.i_c_uid 变量名
    local i_c_uid = {}
    i_c_uid.uid = self.CardData.uid

    --- 升星卡 吃掉的sid [sid,sid...]
    local SubCards = {}
    local uid
    --- 发给服务器要分 本体 同族
    local card_self = {}
    local card_ele = {}
    local props = {}

    for i = 1, 3 do
        if self.consumeCard[i] then
            uid = self.consumeCard[i].uid
            if not self.consumeSelf[i] then
                if self.consumeCard[i].type == _G.CardType.Prop then
                    uid = self.consumeCard[i].sid
                end
                if _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, uid) then
                    if not props[uid] then
                        props[uid] = 1
                    else
                        props[uid] = props[uid] + 1
                    end
                else
                    _G.table.insert(card_ele, uid)
                end
            else
                _G.table.insert(card_self, uid)
            end
            _G.table.insert(SubCards, self.consumeCard[i].sid)
        end
    end

    i_c_uid.c_uids = card_self
    i_c_uid.c_uids2 = card_ele
    i_c_uid.c_item = {}
    for k, v in pairs(props) do
        _G.table.insert(i_c_uid.c_item, { k = k, v = v })
    end
    pbdata.uids = {}
    table.insert(pbdata.uids, i_c_uid)

    ---@type card.c2s_card_up_star
    local newpbdata = {}
    newpbdata.uids = {}
    table.insert(newpbdata.uids, pbdata)

    require("CardInfoNet"):GetInstance():UpStar(
        newpbdata,
        function(data)
            if data.ack ~= 1 then
                if ReFun ~= nil then
                    ReFun()
                end
                return
            end

            self:UpStarOver(data, Cardids, mCardData, pbdata, SubCards)
            _G.AudioManager.PlayAudioByAudioCfgID(2057)
            local openxzInfo = _G.ConfigManager.discrete_cfg[107401][1]
            local openxz = openxzInfo[1]
            local openxzNum = openxzInfo[2]
            if self.CardData:GetStar() >= openxz then
                self.CardData.inborn_num = self.CardData.inborn_num + openxzNum

                require "RedPointManager":GetInstance():RefreshParentNode(
                    _G.ConfigManager.redpoint_cfg.TalentCultivate.id,
                    self.CardData.uid
                )
            end
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CardPotential.id)
        end
    )
end

function CardShowView_Right_starUp:UpStarOver(data, Cardids, mCardData, pbdata, SubCards)
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    --吃掉神石里面的卡牌
    if data.award ~= nil and data.award.item ~= nil then
        --- 解析奖励
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
    end

    if #Cardids > 0 then
        require("CardInfoManager"):GetInstance():CardNewStartDestroy(Cardids)
    end
    -- if data
    for index, carduid in ipairs(Cardids) do
        _G.StorageManager:GetInstance():DelCard(carduid)
    end
    for _, v in pairs(self.UpStarConsumePropList) do
        _G.StorageManager:GetInstance():ConsumeItem(v.sid, nil, 1)
    end
    self.UpStarConsumePropList = {}
    mCardData:upStarCardAward()
