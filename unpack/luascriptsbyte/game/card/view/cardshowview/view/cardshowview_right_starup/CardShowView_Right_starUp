    mCardData:CalcNowSumProp()
    _G.Events:GetInstance():Broadcast(_G.eCard.CardUpStar, mCardData:GetStar(), mCardData.sid, mCardData.uid)
    _G.Events:GetInstance():Broadcast(_G.ChatViewEvents.ChatViewLevel, mCardData, mCardData:GetStar())
    ---@type Params_CardDevelopView_upOver
    local Params_CardDevelopView_upOver = {}
    Params_CardDevelopView_upOver.CardData = self.CardData
    Params_CardDevelopView_upOver.CloseFun = function()
        -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_hide, true)
        if data.award ~= nil and data.award.item ~= nil then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data,
                function()
                    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
                    if offset > 0 then
                        require "CommonTipManager".OpenPowerUpView(power, offset)
                    end
                end
            )
        else
            local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(power, offset)
            end
        end
    end

    --region --------------------------------------把吃的卡下阵--------
    local embattleArr = {}
    for index, carduid in ipairs(Cardids) do
        if self.embattleUids[carduid] == true then
            table.insert(embattleArr, carduid)
        end
    end
    if #embattleArr then
        require("EmbattleModel"):GetInstance():SetEmbattleDownByUidTable(embattleArr)
    end
    --endregion------------------------------------把吃的卡下阵--------

    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CardDevelopView_upOver.Name,
        self,
        Params_CardDevelopView_upOver
    )
    require("CardResonanceModel"):GetInstance():AddMaxSids(mCardData.sid, mCardData.star)
    ---检测共鸣神石核心
    -- require("CardResonanceModel"):GetInstance():UpdateAllPosCard()
    --刷新红点形象
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PlayerRole.id, mCardData.sid)
    --卡牌升星后 获得成长星辉
    require "PlayerTreeModel":GetInstance():GetGrow()
    require("CardInheritModel"):GetInstance():CheckInheritBuffLock(true)
    require "CardInfoManager":GetInstance():RedPointItemCardDevelopAllUpstar_Init()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RoleArtifact.id, mCardData.uid)
    self:ShowCardInfo(self.CardData, true)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
end

--- 检测 卡牌是否合理  是否需要提示
function CardShowView_Right_starUp:CheckCardHaveTips()
    local showTips = false

    local len = #self.UpStarDelCardDataList
    for i = 1, len do
        local CardData = self.UpStarDelCardDataList[i]
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(CardData.cfg.Elements_new, 6) and self.CardData.sid ~= CardData.cfg.id then
            showTips = true
            break
        end
    end
    return showTips
end

---升星会返装备  检测装备背包是否能容纳
function CardShowView_Right_starUp:CheckEquipmentStorageMax()
    --- 返数量
    local reCount = 0
    local len = #self.UpStarDelCardDataList
    for i = 1, len do
        local CardData = self.UpStarDelCardDataList[i]
        if CardData ~= nil then
            reCount = reCount + CardData:GetEquipBarNumber()
        end
    end

    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)

    local isok = true
    if reCount > 0 then
        if _G.table.count(list) + reCount > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Equipment) then
            isok = false
        end
    end

    return isok, reCount
end

function CardShowView_Right_starUp:UpdateAllConsume(selectCards, embattleUids)
    for i = 1, 3 do
        if not self.consumeSelf[i] then
            self.consumeCard[i] = _G.table.remove(selectCards)
            self:UpdateConsumeItem(i, self.consumeNum < i)
        end
    end
    for k, v in pairs(embattleUids) do
        self.embattleUids[k] = v
    end
end

--已选中的材料卡uid转sid
function CardShowView_Right_starUp:ConvertPropUidToSid(index)
    local data = self.consumeCard[index]
    if data then
        if data.type == _G.CardType.Prop then
            return data.sid
        else
            return data.uid
        end
    end
end

function CardShowView_Right_starUp:OnClickConsume(go, isOn, index)
    if self.consumeSelf[index] then
        --本体狗粮不用选择
        return
    end
    local cards = {}
    local ignoreUids = {}
    local maxNum = 0
    for i = 1, 3 do
        if self.consumeSelf[i] then
            if self.consumeCard[i] then
                _G.table.insert(ignoreUids, self.consumeCard[i].uid)
            end
        else
            if self.consumeCard[i] then
                _G.table.insert(cards, self.consumeCard[i])
            end
            if self.consumeStar[i] then
                maxNum = maxNum + 1
            end
        end
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CardChooseView.Name,
        self.CardData,
        maxNum,
        cards,
        ignoreUids,
        _G.handler(self, self.UpdateAllConsume)
    )
end

---按钮点击事件在这里派发
function CardShowView_Right_starUp:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_starUp then
