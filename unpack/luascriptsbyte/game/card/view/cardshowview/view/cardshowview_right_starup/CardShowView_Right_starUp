    local consume_cards = {}
    ---@param value CardData
    for _, value in pairs(self.consumeCard) do
        if value.type ~= _G.CardType.Prop then
            _G.table.insert(consume_cards, value.uid)
        end
    end
    if #consume_cards == 0 then
        self:StartUpStar(consume_cards)
    else
        require("CardInfoManager"):GetInstance():CardNewReadyDestroy(
            consume_cards,
            function(Refun)
                self:StartUpStar(consume_cards, Refun)
            end,
            function(data)
            end
        )
    end
