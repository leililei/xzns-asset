---@class CardShowView_Right_fetter : Component	角色羁绊
---@field CardFetterData CardFetterData
---@field go_table CardShowView_Right_fetter_GoTable
---@field curData CardData
local CardShowView_Right_fetter = _G.BaseClass("CardShowView_Right_fetter", _G.Component)
local GetLangPackValue = _G.LangUtil.GetLangPackValue
local cfgs = _G.ConfigManager.card_fetter_cfg
---创建对象时,入口构造函数
function CardShowView_Right_fetter:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.ScrollRect = self.go_table.obj_itemList:GetComponentE(_G.typeof(_G.CS.ScrollLoopUIManger))
    self.ScrollRect:InitItemData(0, _G.handler(self, self.RefreshItem))
end
---@param data CardData
function CardShowView_Right_fetter:ShowCardInfo(data)
    if self.curData and data.sid == self.curData.sid then
        return
    end
    self.inited = false
    self.curData = data
    self.CardFetterData = require "CardFetterManager":GetInstance():GetCardFetterData(data.sid)
    self:RefreshAllItem()
    self.inited = true
end
---刷新所有羁绊
function CardShowView_Right_fetter:RefreshAllItem()
    if self.Items then
        for _, v in pairs(self.Items) do
            _G.DestroyImmediate(v)
        end
    end
    self.Items = {}
    self.itemList = {}
    self.cardList = {}
    if not self.CardFetterData then
        self.ScrollRect:UpdateCount(0)
    else
        self.ScrollRect:UpdateCount(#self.CardFetterData.cfg.fetter)
    end

    self:RefreshOneKeyActive()
end

function CardShowView_Right_fetter:UpdateItemList()
    for _, v in pairs(self.itemList) do
        v.tb.aorbtn_active:SetActiveE(v.itemData.canActive and 1 or 0)
        v.tb.obj_actived:SetActiveE(v.itemData.active and 1 or 0)
    end
    for _, v in pairs(self.cardList) do
        if self.CardFetterData:CheckIsActiveAll(v.data.id) then
            v.card.star = v.data.condition_star3
            v.card:ShowCard()
        end
    end
    self:RefreshOneKeyActive()
end

---刷新一键激活显示
function CardShowView_Right_fetter:RefreshOneKeyActive()
    local isActive = require "CardFetterManager":GetInstance():CheckHasActive(self.curData.sid)
    self.go_table.aorbtn_active:SetActiveE(isActive and 1 or 0)
    self.go_table.obj_itemList:SetRectTransformSize(453.89, isActive and 513.48 or 605.5)
end

function CardShowView_Right_fetter:RefreshItem(index, listView2)
    if index < 0 then
        return
    end
    if not self.listView2 then
        self.listView2 = listView2
    end
    local indexs = index + 1
    local item = listView2[0]
    self.Items[indexs] = item
    ---@type card_fetter_cfg
    local cfg = cfgs[self.CardFetterData.cfg.fetter[indexs]]
    item:SetName(indexs)
    local ScrollRect = item:GetComponentE(_G.typeof(_G.CS.ScrollLoopBaseLevelPartObj))
    ---@type CardShowView_Right_fetter._obj_Item_GoTable
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickItem, ScrollRect))
    tb.aortext_name.text = GetLangPackValue(self.CardFetterData:GetName(indexs))
    tb.trans_cardRoot:ClearChildren()
    tb.obj_redpointD:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CardFetterExtend.id, cfg.id)
    tb.obj_redpointU:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CardFetterExtend.id, cfg.id)

    for i = 1, #cfg.cards do
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.trans_cardRoot,
            function(item)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                _G.table.insert(self.cardList, {card = item, data = cfg})
                ---@type CardData
                local card = _G.StorageManager:GetInstance():GetItemDataClass(cfg.cards[i], 1)
                local isHave = false
                if self.CardFetterData:CheckIsActiveAll(cfg.id) then
                    isHave = true
                    card.star = cfg.condition_star3
                else
                    local card2 = _G.StorageManager:GetInstance():GetMaxStarCardBySid(cfg.cards[i])
                    if card2 then
                        isHave = true
                        card.star = card2.star
                    end
                end
                ---是否已经投放
                local isPutInto = _G.ConfigManager.card_cfg[cfg.cards[i]].is_put_into
                item.go_table.aorimage_ColorBg:SetGray(not isHave)
                item.go_table.aorimage_Icon:SetGray(isPutInto and not isHave)
                item.go_table.aorimage_Elements:SetGray(not isHave)
                item:HideOrShowLevel(false)
                item:ShowCardData(card)
                if not isPutInto then
                    item.go_table.aorimage_Icon.SpriteName = "ui_ty_touxiang999"
                end
            end
        )
    end
    for i = 1, 3 do
        local item1 = listView2[i]
        item1:SetName(indexs + i * 100)
        ---@type CardShowView_Right_fetter._obj_text_GoTable
        local tb1 = _G.GetAutoGoTable(item1, _G.handlerbind(self, self.OnClickActive, cfg.id, i))
        tb1.gameObject:SetParentE(tb.obj_content)
        local itemData = self.CardFetterData:GetFetterItemData(cfg.id, i)
        tb1.aortext_desc.text = GetLangPackValue(itemData.desc)
        tb1.aorbtn_active:SetActiveE(itemData.canActive and 1 or 0)
        tb1.obj_actived:SetActiveE(itemData.active and 1 or 0)
        tb1.obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.CardFetterButton.id,
            cfg.id * 100 + i
        )
        self.itemList[indexs + i * 100] = {tb = tb1, itemData = itemData}
        if itemData.active or itemData.canActive then
            tb1.aortext_num.text = ""
        else
            tb1.aortext_num.text = _G.string.format("%s/%s", itemData.count, itemData.allCount)
        end
        for j = 1, 2 do
            local data = itemData.att[1 + (j - 1) * 2]
            local item2 = listView2[3 + (i - 1) * 2 + j]
            ---@type CardShowView_Right_fetter._obj_propText_GoTable
            local tb2 = _G.GetAutoGoTable(item2)
            item2:SetParentE(tb1.obj_content)
            if not data then
                item2:SetActiveE(0)
            else
                item2:SetActiveE(1)
                item2:SetParentE(tb1.obj_content)
                tb2.aortext_L.text = GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[data[1]].ID].name)
                if _G.tonumber(data[2]) == 1 then
                    tb2.aortext_Lnum.text = "+" .. data[3]
                else
                    tb2.aortext_Lnum.text = "+" .. _G.tonumber(data[3]) / 100 .. "%"
                end

                data = itemData.att[2 * (j - 1) + 2]
                if not data then
                    tb2.aortext_R.text = ""
                    tb2.aortext_R.text = ""
                else
                    tb2.aortext_R.text =
                        GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[data[1]].ID].name)
                    if _G.tonumber(data[2]) == 1 then
                        tb2.aortext_Rnum.text = "+" .. data[3]
                    else
                        tb2.aortext_Rnum.text = "+" .. _G.tonumber(data[3]) / 100 .. "%"
                    end
                end
            end
        end
    end
    if not self.inited then
        tb.obj_content:SetActiveE(0)
        tb.aorbtn_up:SetActiveE(0)
        tb.aorbtn_down:SetActiveE(1)
    end
    return item
end

function CardShowView_Right_fetter:OnClickActive(_, _, id, index)
    require "CardFetterManager":GetInstance():ActiveSingle(
        self.curData.sid,
        id,
        index,
        function()
            local power = self.curData.power
            require "CardInfoManager":GetInstance():CardBagViewPlayEff_lv()
            self:UpdateItemList()
            require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.curData, true)
            local curPower = self.curData.power
            if power < curPower then
                require "CommonTipManager".OpenPowerUpView(power, curPower - power)
            end
            _G.StorageManager:GetInstance():UpdateCardProp(
                function(card)
                    return card.sid == self.curData.sid
                end
            )
        end
    )
end

function CardShowView_Right_fetter:OnClickItem(go, _, ScrollRect)
    local name = go:GetName()
    if name == "@_aorbtn_down" then
        ScrollRect:Btn_FoldSubList(false)
    elseif name == "@_aorbtn_up" then
        ScrollRect:Btn_FoldSubList(true)
    end
end

---销毁对象时,析构函数
function CardShowView_Right_fetter:OnDestroy()
end

function CardShowView_Right_fetter:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_active then
        require "CardFetterManager":GetInstance():ActiveAll(
            self.curData.sid,
            function()
                local power = self.curData.power
                require "CardInfoManager":GetInstance():CardBagViewPlayEff_lv()
                self:UpdateItemList()
                require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.curData, true)
                local curPower = self.curData.power
                if power < curPower then
                    require "CommonTipManager".OpenPowerUpView(power, curPower - power)
                end
                _G.StorageManager:GetInstance():UpdateCardProp(
                    function(card)
                        return card.sid == self.curData.sid
                    end
                )
            end
        )
    end
end

return CardShowView_Right_fetter
