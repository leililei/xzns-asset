---@class CardShowView_Right_Artifact : Component    皮肤
local CardShowView_Right_Artifact = _G.BaseClass("CardShowView_Right_Artifact", _G.Component)

local namebg={
    [1]="ui_gwsx_sd3",
    [2]="ui_gwsx_sd2",
    [3]="ui_gwsx_sd"
}
function CardShowView_Right_Artifact:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eItemUpdata.Updata,self.RefreshUI,self)
    self:InitToggle()
end
---@param CardData CardData
function CardShowView_Right_Artifact:ShowCardInfo(CardData, Show,jumpSkinId)
    self.cardData=CardData
    ---@type ArtifactData
    self.artifactData=CardData.ArtifactBar or nil
    self.jumpSkinId = jumpSkinId
    if self.jumpSkinId then
        self.go_table.toggle_Skin.isOn=false
        self.go_table.toggle_upLevel.isOn=false
        self.go_table.toggle_upStar.isOn=false
        self.go_table.toggle_Skin.isOn=true
        self.go_table.obj_Toggle:SetActiveE(0)
        self.go_table.obj_togglebg:SetActiveE(0)
    else
        self:InitPageRedPoint()
        local ArtifactIllustrationModel=require("ArtifactIllustrationModel"):GetInstance()
        local isShowArtifactSkin=ArtifactIllustrationModel:CheckCardIsShowArtifactSkin(self.cardData.sid)
        self.go_table.obj_skin:SetActiveE(isShowArtifactSkin and 1 or 0)
        self.go_table.toggle_Skin:SetActiveE(isShowArtifactSkin and 1 or 0)
        if not string.IsNullOrEmpty(self.curToggle) then
            if self.curToggle == "Skin" and not isShowArtifactSkin  then
                self.curToggle="upLevel"
            end
            self.go_table.toggle_upStar.isOn=self.curToggle == "upStar"
            self.go_table.toggle_upLevel.isOn=self.curToggle == "upLevel"
            self.go_table.toggle_Skin.isOn=self.curToggle == "Skin"
            if self.curToggle=="Skin" then
                self:OnSkin(true)
            elseif self.curToggle=="upLevel" then
                self:OnUpLevel(true)
            elseif self.curToggle=="upStar" then
                self:OnUpStar(true)
            end
        else
            if isShowArtifactSkin then
                self.go_table.toggle_Skin.isOn=false
                self.go_table.toggle_Skin.isOn=true
                self.go_table.toggle_upStar.isOn=false
                self.go_table.toggle_upLevel.isOn=false
            else
                self.go_table.toggle_upLevel.isOn=false
                self.go_table.toggle_Skin.isOn=false
                self.go_table.toggle_upStar.isOn=false
                self.go_table.toggle_upLevel.isOn=true
            end
        end
    end
    self:InitArtifactMessageShow()
end
function CardShowView_Right_Artifact:RefreshUI()
    self.go_table.toggle_upStar.isOn=self.curToggle == "upStar"
    self.go_table.toggle_upLevel.isOn=self.curToggle == "upLevel"
    self.go_table.toggle_Skin.isOn=self.curToggle == "Skin"
    if self.curToggle=="Skin" then
        self:OnSkin(true)
    elseif self.curToggle=="upLevel" then
        self:OnUpLevel(true)
    elseif self.curToggle=="upStar" then
        self:OnUpStar(true)
    end
end

function CardShowView_Right_Artifact:InitToggle()
    self.toggles={}
    self.toggles["Skin"] = _G.GetAutoGoTable(
    self.go_table.toggle_Skin,
    _G.handlerbind(self, self.OnClickToggle,"Skin", _G.handler(self, self.SelectToggle))
    )
    self.toggles["upLevel"] = _G.GetAutoGoTable(
    self.go_table.toggle_upLevel,
    _G.handlerbind(self, self.OnClickToggle, "upLevel", _G.handler(self, self.SelectToggle))
    )
    self.toggles["upStar"] = _G.GetAutoGoTable(
            self.go_table.toggle_upStar,
            _G.handlerbind(self, self.OnClickToggle, "upStar", _G.handler(self, self.SelectToggle))
    )
end

function CardShowView_Right_Artifact:OnClickToggle(_, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call and isOn then
        call(key)
    end
end
function CardShowView_Right_Artifact:SelectToggle(key)
    self.go_table.obj_skinPanel:SetActiveE(key=="Skin" and 1 or 0)
    self.go_table.obj_lvPanel:SetActiveE(key=="upLevel" and 1 or 0)
    self.go_table.obj_startPanel:SetActiveE(key=="upStar" and 1 or 0)
    self.go_table.obj_showArtifact:SetActiveE((key=="upStar" or key=="upLevel") and 1 or 0)
    self.curToggle=key
    self:InitArtifactMessageShow()
    if key=="Skin" then
        self:OnSkin(true)
    elseif key=="upLevel" then
        self:OnUpLevel(true)
    elseif key=="upStar" then
        self:OnUpStar(true)
    end
end

function CardShowView_Right_Artifact:OnSkin(isOn)
    if not isOn then
        return
    end
    self.curToggle = "Skin"
    if not self.skinPanel then
        self.skinPanel = self:AddComponent(self.go_table.obj_skinPanel, require "ArtifactDevelop_guangwuPanel".New())
        self.skinPanel:Show(self.cardData, self.jumpSkinId)
    else
        self.skinPanel:Show(self.cardData, self.jumpSkinId)
    end
end

function CardShowView_Right_Artifact:OnUpLevel(isOn)
    if not isOn then
        return
    end
    self.curToggle = "upLevel"
    if not self.upLevePanel then
        self.upLevePanel = self:AddComponent(self.go_table.obj_lvPanel, require "ArtifactDevelop_UpLevelPanel".New())
        self.upLevePanel:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
    else
        self.upLevePanel:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
    end
end

---升星
function CardShowView_Right_Artifact:OnUpStar(isOn)
    if not isOn then
        return
    end
    self.curToggle = "upStar"
    if not self.upStarPanel then
        self.upStarPanel = self:AddComponent(self.go_table.obj_startPanel, require "ArtifactDevelop_UpStarPanel".New())
        self.upStarPanel:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
    else
        self.upStarPanel:Show(self.artifactData, self.cardData, _G.handler(self, self.UpdateArtifactData))
    end
end
---@param cardData CardData
function CardShowView_Right_Artifact:UpdateArtifactData(artifactData, cardData)
    self.artifactData = table.isEmptyOrNil(cardData.ArtifactBar) and nil or cardData.ArtifactBar
    self.cardData = cardData
end
function CardShowView_Right_Artifact:InitArtifactMessageShow()
    if self.curToggle=="upLevel" or self.curToggle=="upStar" then
        if table.isEmptyOrNil(self.artifactData) then
            self.go_table.aorrawimage_artifaceIcon:SetActiveE(0)
            self.go_table.aorbtn_exchange:SetActiveE(0)
            self.go_table.aorbtn_juexing:SetActiveE(0)
            self.go_table.aorrawimage_Add:SetActiveE(1)
            self.go_table.aorbtn_takeoff:SetActiveE(0)
            self:RefreshTopName()
            self:RefreshStar()
        else
            self.go_table.aorrawimage_artifaceIcon:SetActiveE(1)
            self.go_table.aorbtn_exchange:SetActiveE(1)
            self.go_table.aorrawimage_Add:SetActiveE(0)
            self.go_table.aorbtn_takeoff:SetActiveE(0)
            if self.curToggle=="upStar" and self.artifactData.star == self.artifactData.cfg.Star and
                    self.artifactData.cfg.card_id > 0 and (self.artifactData.cfg.display and self.artifactData.cfg.display == 1)  then
                self.go_table.aorbtn_juexing:SetActiveE(1)
            else
                self.go_table.aorbtn_juexing:SetActiveE(0)
            end
            self.go_table.aorrawimage_artifaceIcon:LoadImage(self.artifactData.cfg.image_1,function(img)
                if img then
                    img:SetNativeSize()
                end
            end)
            local Tweening = _G.CS.DG.Tweening
            local x, y, z = self.go_table.aorrawimage_artifaceIcon:GetLocalPosition()
            if not self.tweer then
                self.tweer =
                self.go_table.aorrawimage_artifaceIcon:DOLocalMoveY(y + 20, 1.5):SetEase(Tweening.Ease.InOutSine):SetLoops(
                        -1,
                        Tweening.LoopType.Yoyo
                )
            end
            self:RefreshTopName(self.artifactData:GetName(),self.artifactData:GetOrder())
            self:RefreshStar(self.artifactData.star)
        end
    elseif self.curToggle=="Skin" then
        ---@param artifact_cfg
        local artifatcfg=_G.ConfigManager.artifact_cfg[self.cardData.cfg.artifactid]
        self:RefreshTopName(GetLangPackValue(artifatcfg.Name),artifatcfg.Order)
    end
   
end
function CardShowView_Right_Artifact:RefreshStar(star)
    if star then
        if star>5 then
            self.go_table.aorimage_starbg:SetActiveE(1)
            self.go_table.aortext_star.text=tostring(star)
            for i = 1, 5 do
                self.go_table["aorimage_star"..i]:SetActiveE(0)
            end
        else
            self.go_table.aorimage_starbg:SetActiveE(0)
            for i = 1, 5 do
                self.go_table["aorimage_star"..i]:SetActiveE(star>=i and 1 or 0)
            end
        end
    else
        self.go_table.aorimage_starbg:SetActiveE(0)
        for i = 1, 5 do
            self.go_table["aorimage_star"..i]:SetActiveE(0)
        end
    end
end
function CardShowView_Right_Artifact:RefreshTopName(name,order)
    if not name then
        self.go_table.aorimage_namebg:SetActiveE(0)
        self.go_table.aortext_name:SetActiveE(0)
        return
    end
    self.go_table.aorimage_namebg:SetActiveE(1)
    self.go_table.aortext_name:SetActiveE(1)
    self.go_table.aortext_name.text = name
    self.go_table.aorimage_namebg.SpriteName=namebg[order]
    order = order + 4
    if order == 7 then
        order = 8
    end
    local ctm = require("CommonTipManager"):GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name, order)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
    _G.ColorTools.FormatColorByString(ctm:GetTipTypeNameOutLineColorByGrade(order))
end
function CardShowView_Right_Artifact:InitPageRedPoint()
    if table.isEmptyOrNil(self.artifactData) then
        self.toggles["upLevel"].obj_redpoint:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.RoleArtifact.id,
                self.cardData.uid
        )
        self.toggles["upStar"].obj_redpoint:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.RoleArtifact.id,
                self.cardData.uid
        )
        if _G.AppSetting.IsXzns then
            self.toggles["upStar"].obj_redpointAwaken:UpdateRedPointItemIDAndParam(0)
            self.go_table.obj_redpointAwaken:UpdateRedPointItemIDAndParam(0)
        end
        return
    end
    self.toggles["upLevel"].obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
            self.artifactData.uid * 10 + 1
    )
    self.toggles["upStar"].obj_redpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
            self.artifactData.uid * 10 + 2
    )
    if _G.AppSetting.IsXzns then
        self.toggles["upStar"].obj_redpointAwaken:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
                self.artifactData.uid * 10 + 3
        )
        self.go_table.obj_redpointAwaken:UpdateRedPointItemIDAndParam(
                _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id,
                self.artifactData.uid * 10 + 3
        )
    end
end

function CardShowView_Right_Artifact:TakeOffArtifact(cardData, isOther, call)
    cardData = cardData or self.cardData
    if not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(270801)
        return
    end
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardData)
    require "ArtifactModel":GetInstance():TakeOffArtifact(
            cardData,
            function()
                if not isOther then
                    self.artifactData=cardData.ArtifactBar or nil
                    self:UpdateArtifact()
                    _G.UIUtils.ShowPropUp(cardData, self.lastCardProp)
                    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.power
                    if offset > 0 then
                        require "CommonTipManager".OpenPowerUpView(self.power, offset)
                    end
                end
                require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                if call then
                    call()
                end
            end
    )
end
---打开神器穿戴界面
function CardShowView_Right_Artifact:OpenArtifact()
    if self.cardData.type == _G.CardType.Timer then
        _G.PopWindowManager:GetInstance():ShowAllTips(710102)
        return
    end
    if self.cardData:GetStar() < _G.ConfigManager.discrete_cfg[101204][1][1] then
        _G.PopWindowManager:GetInstance():ShowAllTips(270701)
        return
    end

    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardData)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArtifactWearView.Name,
            self.cardData,
            function()
                if table.isEmptyOrNil(self.go_table) then
                    _G.MainManager:GetInstance():OpenMainViewToggle("card")
                else
                    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                    _G.UIUtils.ShowPropUp(self.cardData, self.lastCardProp)
                    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.power
                    if offset > 0 then
                        require "CommonTipManager".OpenPowerUpView(self.power, offset)
                    end
                    self:UpdateArtifact()
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArtifactWearView.Name)
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
                    require("RedPointManager"):GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.ArtifactAwaken.id,
                        self.cardData.uid
                    )
                end
            end
    )
end
function CardShowView_Right_Artifact:UpdateArtifact()
    self:InitArtifactMessageShow()
    if self.curToggle == "upLevel" then
        self:OnUpLevel(true)
    elseif self.curToggle == "upStar" then
        self:OnUpStar(true)
    end
end
function CardShowView_Right_Artifact:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_reset then
        if self.artifactData:GetLevel() <= 1 and self.artifactData:GetStar() <= 0 then
            ---未升级或升星不可重置
            _G.PopWindowManager:GetInstance():ShowAllTips(280110)
        else
            self.power = _G.StorageManager:GetInstance():GetPlayerPower()
            self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardData)
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.ResetLevelView.Name,
                    self.artifactData,
                    function()
                        if table.isEmptyOrNil(self.go_table) then
                            return
                        end
                        require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
                        _G.UIUtils.ShowPropUp(self.cardData, self.lastCardProp)
                        local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.power
                        if offset > 0 then
                            require "CommonTipManager".OpenPowerUpView(self.power, offset)
                        end
                        self.artifactData=self.cardData.ArtifactBar
                        self:UpdateArtifact()
                    end
            )
        end
    elseif go == self.go_table.aorbtn_bag then
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagNewView.Name, 3)
    elseif go == self.go_table.aorbtn_wearArtiface or go == self.go_table.aorbtn_exchange then
        self:OpenArtifact()
    elseif go==self.go_table.aorbtn_takeoff then
        self:TakeOffArtifact()
    elseif go==self.go_table.aorbtn_juexing then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactDevelop_AwakenView.Name, self.artifactData,self.cardData)
    end
end

function CardShowView_Right_Artifact:OnOpenUI(name)
    if name == _G.ConfigManager.ui_cfg.BagNewView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOpenUI, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BagNewView.Name)
        view:OnClickToggle(nil, true, 3)
        _G.DelayDo(0.1, function()
            view.go_table.toggle_artifact.isOn = true
            view:OnClickEquipToggle(nil, true, 4)
        end)
        view.go_table.toggle_equipment.isOn = true
    end
end
---销毁对象时,析构函数
function CardShowView_Right_Artifact:OnDestroy()
    self:RemoveAllListener()
    if self.tweer then
        self.tweer:Kill()
        self.tweer=nil
    end
end
return CardShowView_Right_Artifact