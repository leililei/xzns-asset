                --         if list[i]:GetStar() >= star then
                --             list[i].guideCC = 1
                --             self.GuideCC = list[i]
                --             break
                --         end
                --     end
            end
        end
    end
    local index
    local sortFunc = function(data)
        index = 1
        if self.Params_RedPoint.uids[data.uid] then
            index = 2
        end
        return data.guideCC, index, data:GetGrade(), data.star, data.power, data.sid
    end
    _G.SortList(list, sortFunc)
    if islycGuide then
        for i = 1, #list do
            if list[i].sid == islycGuideId then
                lycInfo = list[i]
                table.remove(list, i)
                break
            end
        end

        if lycInfo then
            table.insert(list, 1, lycInfo)
        end
    end
end

function CardShowView_CardBag:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local id = objGame:GetInstanceIDE()
    local itemGoTable = self.cardItems[id]
    if not itemGoTable then
        itemGoTable = _G.GetAutoGoTable(objGame)
        _G.AddViewBtnClick(objGame, _G.handlerbind(self, self.OnClick_CardItem, itemGoTable))
        self.cardItems[id] = itemGoTable
    end

    ---@type CardData
    local CardData = self.nowCardList[index + 1]

    itemGoTable.CardIndex = index + 1
    self.cardGoTables[itemGoTable.CardIndex] = itemGoTable
    self.cardGoTablesByUid[CardData.uid] = itemGoTable

    ---没生成对象
    if itemGoTable.Lua == nil then
        ---开始生成对象 并标记
        itemGoTable.Lua = true

        if self.Params_LoopInit == false then
            if self.Params_LoopTimers == nil then
                self.Params_LoopTimers = {}
            end
            local timer = _G.TimerManager:GetInstance():GetTimer(1 * index, self.SpawnCard, self, true, true, true,
                itemGoTable)
            table.insert(self.Params_LoopTimers, timer)
            timer:Start()
        else
            self:SpawnCard(itemGoTable)
        end
    elseif itemGoTable.Lua ~= true then
        ---已生成对象
        self:SetCardItem(itemGoTable)
    end
    return objGame
end

---播放动画
function CardShowView_CardBag:PlayAni(itemGoTable)
    itemGoTable.obj_node:SetLocalPosition(-50, 0, 0)
    itemGoTable.obj_node:DOLocalMoveX(0, 0.3):SetEase(_G.CS.DG.Tweening.Ease.OutExpo)
    local CanvasGroup = itemGoTable.gameObject:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    CanvasGroup.alpha = 0
    CanvasGroup:DOFade(1, 0.3):SetEase(_G.CS.DG.Tweening.Ease.Linear)
end

function CardShowView_CardBag:SpawnCard(itemGoTable)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.BodyItem_select,
        itemGoTable.obj_node,
        function(itemLua)
            itemGoTable.Lua = itemLua
            self:SetCardItem(itemGoTable)
            if self.Params_LoopInit then
                self:PlayAni(itemGoTable)
            end
        end
    )
end

function CardShowView_CardBag:SetCardItem(itemGoTable)
    if itemGoTable == nil or self:IsNil() then
        return
    end
    ---@type CardData
    local carddata = self.nowCardList[itemGoTable.CardIndex]
    if not carddata then
        return
    end
    ---@type ItemCardBodySelectView
    local lua = itemGoTable.Lua
    itemGoTable.gameObject:SetName(itemGoTable.CardIndex)
    carddata.skinIs = false

    if carddata.skin and carddata.skin ~= 0 then
        carddata.skinIs = true
    end
    lua:ShowCardData(carddata, nil, true)
    -- lua:SetSelect(self.NowSelectCardIndex == itemGoTable.CardIndex)
    if self.NowSelectCardIndex == itemGoTable.CardIndex then
        self.NowSelectCardItemGoTableLua = lua
    end
    if lua.SetInEmbattleStatus then
        lua:SetInEmbattleStatus(carddata.uid)
    end

    --ZHJH-3262【角色】角色可升星时激活的红点未在角色背包内显示
    --总是显示红点
    local redID = carddata.uid
    ---只检测特定卡红点
    -- if self:CheckRedRoint(carddata) then
    --     redID = carddata.uid
    -- end
    if carddata.type == _G.CardType.Timer then
        redID = 0
    end
    --临时添加 红点
    itemGoTable.trans_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MineCardList.id, redID)
end

---@param IsSetOn boolean True检测当前选中 (OnCreate里设置会错位)
function CardShowView_CardBag:InitBtn(IsSetOn)
    local obj, showGod
    for i = 0, 6 do
        if self.cardTypeGos[i] == nil then
            obj = self.go_table["obj_type (" .. i .. ")"]
            obj = _G.GetAutoGoTable(obj)
            self.cardTypeGos[i] = obj
        end
        self:btnSet(self.cardTypeGos[i], i, IsSetOn)
        if i == _G.CardElementType.God then
            showGod = _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[106706])
            self.cardTypeGos[i].gameObject:SetActiveE(showGod and 1 or 0)
        end
    end
end

function CardShowView_CardBag:btnSet(go_table, cardTypeEnumIndex, IsSetOn)
    if cardTypeEnumIndex ~= nil then
        go_table.aorimage_icon.SpriteName = self.cardTypeEnum.btnIcon[cardTypeEnumIndex]
    end
    if go_table.Click == nil then
        go_table.aorbtn_btn.onClick:AddListener(_G.handlerbind(self, self.OnClick_CardType, cardTypeEnumIndex))
        go_table.Click = true
    end
    if IsSetOn and cardTypeEnumIndex == self.sx_Elements.data then
        self.go_table.aorimage_typeOn:SetPositionByTarget(go_table.gameObject)
    end
end

function CardShowView_CardBag:OnClick_CardItem(_, _, itemGoTable)
    local CardIndex = itemGoTable.CardIndex
    local cardLua = itemGoTable.Lua
    if CardIndex == nil or CardIndex == self.NowSelectCardIndex then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardShowView.Name, nil, self)
        if AppSetting.IsXzns and cardLua ~= nil then
            require("CardCommentManager"):GetInstance():PlayShowCfg(cardLua.sid)
        end
        return
    end
    if nil == cardLua or cardLua == true then
        return
    end
    -- if self.NowSelectCardItemGoTableLua then
    --     self.NowSelectCardItemGoTableLua:SetSelect(false)
    -- end
    self.NowSelectCardItemGoTableLua = cardLua
    -- if self.NowSelectCardItemGoTableLua then
    --     self.NowSelectCardItemGoTableLua:SetSelect(true)
    -- end
    self.NowSelectCardIndex = CardIndex
    if _G.AppSetting.DEBUG then
        local carddata = self.nowCardList[self.NowSelectCardIndex]
        if carddata then
            _G.Log(carddata, "选中卡片信息")
        end
    end
    --self.go_table.scrollloopvectical_card:UpdateAllItem()
    self:SendCutoverFun()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardShowView.Name, nil, self)
    if AppSetting.IsXzns then
         require("CardCommentManager"):GetInstance():PlayShowCfg(cardLua.sid)
    end
end

function CardShowView_CardBag:OnClick_CardType(index)
    if index == nil then
        return
    end
    if index == self.sx_Elements.data and self.sx_Elements.data ~= 0 then
        index = 0
    end
    local olddata = self.sx_Elements.data
    self.sx_Elements.data = self.sxEnum.Elements[index]
    ---先筛选
    self:UpdataLoopList_1()
    ---若没有卡
    if #self.nowCardList == 0 then
        ---还原
        self.sx_Elements.data = olddata
        self:UpdataLoopList_1()
        --并弹提示
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
    else
        self.NowSelectCardIndex = 1
        self:UpdataLoopList_2()
        self:InitBtn(true)
        self:SendCutoverFun()
    end
end

