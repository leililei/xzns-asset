        _G.GuideManager:GetInstance().CurGuideModelCfg.id == 5000 and
        not isPass
    then
        islycGuide = true
    end

    -- 放置上阵角色排列到最前

    -- 按品质降序排列

    -- 品质相同时按星级降序排列

    -- 星级相同时按战力降序排列

    --     战力相同时按UID降序排列

    local list = self.nowCardList

    if not islycGuide then
        if _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing then
            if _G.GuideManager:GetInstance().CurGuideModelCfg.id == _G.ConfigManager.discrete_cfg[102405][1][1] then
                local star = _G.ConfigManager.discrete_cfg[102405][1][2]
                for i = 1, #list do
                    if list[i]:GetStar() >= star then
                        list[i].guideCC = 1
                        self.GuideCC = list[i]
