---按钮点击事件在这里派发
function CardShowView_CardBag:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_add then
        _G.StorageUtils.CardBagAdd(function()
            self:jiaNew()
        end,self)
    elseif go == self.go_table.aorbtn_typeList then
        self:ShowTypeList(not self.showTypeListTag)
    elseif go == self.go_table.aorbtn_pAll then
        self:ChangeProfListType(profType.None)
    elseif go == self.go_table.aorbtn_pTK then
        self:ChangeProfListType(profType.Tank)
    elseif go == self.go_table.aorbtn_pZS then
        self:ChangeProfListType(profType.Warrior)
    elseif go == self.go_table.aorbtn_pFS then
        self:ChangeProfListType(profType.Master)
    elseif go == self.go_table.aorbtn_pFZ then
        self:ChangeProfListType(profType.Support)
    elseif go == self.go_table.aorbtn_pYX then
        self:ChangeProfListType(profType.Ranger)
    elseif go == self.go_table.aorbtn_eAll then
        self:ChangeEquipmentListType(0)
    elseif go == self.go_table.aorbtn_eLiliang then
        self:ChangeEquipmentListType(equipmentType.Plank)
    elseif go == self.go_table.aorbtn_eMinjie then
        self:ChangeEquipmentListType(equipmentType.Coat)
    elseif go == self.go_table.aorbtn_eZhili then
        self:ChangeEquipmentListType(equipmentType.Cloth)
    -- elseif go == self.go_table.aorbtn_recommend then
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RoleTeamView.Name)
    elseif go == self.go_table.aorbtn_formation then
        self:OpenFormation()
    elseif go == self.go_table.aorbtn_resonance then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardResonanceView.Name)
    elseif go == self.go_table.aorbtn_convert then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardConvertView.Name)
    end
end

---true 界面已经关闭 被释放
function CardShowView_CardBag:IsNil()
    return self.go_table == nil
end

function CardShowView_CardBag:RefreshCardList()
    self:jiaNew()
    self:UpdataLoopList(true)
    local uid = _G.StorageManager:GetInstance().SelectCardUid
    if uid ~= nil then
        for i, v in ipairs(self.nowCardList) do
            if v.uid == uid then
                self.NowSelectCardIndex = i
                break
            end
        end
    end
end

function CardShowView_CardBag:UpdateResonance()
    local resonanceUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Stone)
    self.go_table.aorbtn_resonance:SetActiveE(resonanceUnlock and 1 or 0)
    if resonanceUnlock then
        self.go_table.aortext_resonance.text = _G.GetLangPackValue(9002050027,
        require("CardResonanceModel"):GetInstance():GetStageLevel())
        local curNum = require("CardResonanceModel"):GetInstance():GetStageUpMeetPosNum()
        local totalNum = require("CardResonanceModel"):GetInstance().posNum
        self.go_table.aortext_resonanceNum.text = _G.string.format("（%s/%s）", curNum, totalNum)
        local color
        if curNum == totalNum then
            if _G.AppSetting.IsXzns then
                color = _G.ColorTools.FormatColorByString("83E496")
            else
                color = _G.ColorTools.FormatColorByString("72c946")
            end
        else
            if _G.AppSetting.IsXzns then
                color = _G.ColorTools.FormatColorByString("FFFFF9")
            else
                color = _G.ColorTools.FormatColorByString("FFFFFF")
            end
        end
        self.go_table.aortext_resonanceNum.color = color
    end
end

---销毁对象时,析构函数
function CardShowView_CardBag:OnDestroy()
    self:RemoveAllListener()
    _G.Events:GetInstance():RemoveListener(_G.CardUpdateEvent.CardConvert, self.OnCardConvert, self)
    _G.StorageManager:GetInstance().SelectCardUid = nil
    self.mCardInfoManager:Del_CardViewUpdataFun("CardShowView_CardBag")
    if self.Params_LoopTimers then
        for i = 1, #self.Params_LoopTimers do
            self.Params_LoopTimers[i]:Stop()
        end
        self.Params_LoopTimers = nil
    end
    if self.GuideCC then
        self.GuideCC.guideCC = 0
        self.GuideCC = nil
    end
end

function CardShowView_CardBag:OpenFormation()
    require("EmbattleController"):GetInstance():OpenFormation(
        _G.handler(self, self.OnGroupChoose),
        _G.EmbattleControllerItemType.formationGroup,
        _G.FormationGroupType.All,
        nil,
        nil,
        {}
    )
end

function CardShowView_CardBag:OnGroupChoose(data, skills, petSkills, edit, call, notShackle)
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    local index = _G.EmbattleType.formationGroup
    local count = _G.ConfigManager.discrete_cfg[103001][1][1]
    local ids = {}
    for i = 1, count do
        ids[i] = index + i - 1
    end
    require("EmbattleController"):GetInstance():GetPreFormation(
        function()
            require("EmbattleController"):GetInstance():OpenEmbattle(
                ids,
                _G.EmbattleSaveType.temporary,
                nil,
                _G.EmbattleControllerItemType.formationTemp,
                _G.handler(self, self.OnEmbattleQuit),
                _G.handler(self, self.OnBattle),
                _G.ConfigManager.guild_boss_cfg[1].monster_group
            )
        end
    )
end

function CardShowView_CardBag:OnEmbattleQuit()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.EmbattleFormationGroupView.Name)
end

function CardShowView_CardBag:OnBattle()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.EmbattleFormationGroupView.Name)
end

return CardShowView_CardBag
