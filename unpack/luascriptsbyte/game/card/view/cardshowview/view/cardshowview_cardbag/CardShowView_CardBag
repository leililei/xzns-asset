function CardShowView_CardBag:StarSx()
    ---@param CardData CardData
    self.nowCardList = _G.table.chooseToArray(
        self.StorageCard,
        function(_, CardData)
            if self.sx_Elements.data ~= 0 and not self.mCardInfoManager:CheckMultiMatch(self.sx_Elements.data , CardData.cfg.Elements_new) then
                return false
            elseif self.sx_Elements.profData ~= 0 and self.sx_Elements.profData ~= CardData.cfg.Professional then
                return false
            elseif self.sx_Elements.equipData ~= 0 and self.sx_Elements.equipData ~= CardData.cfg.EquipmentType then
                return false
            end
            return true
        end
    )
    if self.cardUid ~= nil then
        for i = 1, #self.nowCardList do
            local t_card = self.nowCardList[i]
            if t_card ~= nil and t_card.uid == self.cardUid then
                self.nowCardIndex = i
                break
            end
        end
    end
end

