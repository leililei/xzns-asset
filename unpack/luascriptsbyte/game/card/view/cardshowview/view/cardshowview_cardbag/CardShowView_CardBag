                    end
                end
                -- elseif _G.GuideManager:GetInstance().CurGuideModelCfg.id == _G.ConfigManager.discrete_cfg[102405][1][1] then
                --     local star = _G.ConfigManager.discrete_cfg[102405][1][2]
