---更新转换按钮状态
function CardShowView_CardBag:UpdateCardConvertButton()
    local convertModel = require("CardConvertModel"):GetInstance()
    --功能是否开放
    local isOpenConvert = convertModel:GetFunctionOpen()
    self.go_table.aorbtn_convert:SetActiveE(isOpenConvert and 1 or 0)
    if isOpenConvert then
        local isGray = not convertModel:CheckCardConvert()
        self.go_table.aorbtn_convert:SetGray(isGray)
        self.go_table.aorimage_convertIcon:SetGray(isGray)
        --弹出快捷转化tip
        local showTipCfg = _G.ConfigManager.discrete_cfg[129005] --背包使用超出此比例时弹出
        if showTipCfg and showTipCfg[1][1] > 0 then
            local maxCapacity = _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card)
            local freeSize = math.ceil(maxCapacity * (100 - showTipCfg[1][1]) * 0.01)
            if freeSize > 0 and not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Card, freeSize) then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardConvertTipView.Name)
            end
        end
    end
end

function CardShowView_CardBag:InitCard()
    if not self.Params_LoopInit then
        self:InitRedPointUids()
        self.Params_LoopInit = false
        self.NowSelectCardIndex = 1
        self:InitBtn()
        self:UpdataLoopList(true)
        self:SendCutoverFun()
        self.Params_LoopInit = true
    end
end

function CardShowView_CardBag:SetCutoverFun(fun)
    self.CutoverFun = fun
end

---要显示红点的卡牌  (放置阵容里的卡 背包排序)
function CardShowView_CardBag:InitRedPointUids()
    self.Params_RedPoint = {
        uids = {}
    }

    local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    local uid
    if uids ~= nil then
        for i = 1, #uids do
            uid = uids[i]
            if uid > 0 then
                self.Params_RedPoint.uids[uid] = true
            end
        end
    end
    -- body
end

---true该卡要检测红点
---@param CardData CardData
function CardShowView_CardBag:CheckRedRoint(CardData)
    if self.Params_RedPoint.uids[CardData.uid] then
        return true
    end
    if require "CardFetterManager":GetInstance():CheckHasActive(CardData.sid) then
        return true
    end
    if CardData.lv > 1 then
        return true
    end
    ---判断是在共鸣神石 中
    if CardData.shenshiPosType ~= _G.StonePosType.PosZero then
        return true
    end
    if require("IllustrationModel"):GetInstance():CardPanDuan(CardData.sid) then
        return true
    end
    return false
end

---@param isNext boolean True下一个角色
function CardShowView_CardBag:CutoverRole(isNext)
    local NewIndex = self.NowSelectCardIndex + (isNext and 1 or -1)
    if NewIndex == 0 then
        NewIndex = #self.nowCardList
    elseif NewIndex > #self.nowCardList then
        NewIndex = 1
    end
    local carddata = self.nowCardList[NewIndex]
    if carddata == nil then
        if _G.AppSetting.DEBUG then
            _G.Log(" 索引错误", "<color=red>" .. ">>>" .. "</color>")
        end
        return
    end

    self.NowSelectCardIndex = NewIndex

    -- if self.NowSelectCardItemGoTableLua then
    --     self.NowSelectCardItemGoTableLua:SetSelect(false)
    -- end
    if self.cardGoTables[self.NowSelectCardIndex] then
        self.NowSelectCardItemGoTableLua = self.cardGoTables[self.NowSelectCardIndex].Lua
    else
        self.NowSelectCardItemGoTableLua = nil
    end
    -- if self.NowSelectCardItemGoTableLua then
    --     self.NowSelectCardItemGoTableLua:SetSelect(true)
    -- end
    self.go_table.scrollloopvectical_card:ScrollToIndex(self.NowSelectCardIndex - 1)
    self:SendCutoverFun()

    self:UpdateFirstRedpoint(carddata)
    if AppSetting.IsXzns then
        require("CardCommentManager"):GetInstance():PlayShowCfg(carddata.cfg.id)
    end
end

function CardShowView_CardBag:UpdateFirstRedpoint(carddata)
    ---@type CardShowView
    local csvrv = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CardShowView.Name)
    if csvrv and csvrv.View.lua_Right.btnIndex == 2 then
        for i = 1, 4 do
            require "DecorationModel":GetInstance():UpdateFirstRedpoint(carddata, i)
        end
    end
end

---@param tCardData CardData 有改动的卡牌 与当前选中uid相同 才刷新
function CardShowView_CardBag:SendCutoverFun(tCardData, isUpdata, show)
    if self.CutoverFun == nil then
        return
    end

    ---@type CardData CardData
    local carddata = self.nowCardList[self.NowSelectCardIndex]
    if carddata ~= nil then
        if isUpdata then
        else
            ---如果不是强制刷新 判定当前
            if tCardData ~= nil and tCardData.uid ~= carddata.uid then
                return
            end
        end

        _G.StorageManager:GetInstance().SelectCardUid = carddata.uid
        self.CutoverFun(carddata, self.NowSelectCardIndex, #self.nowCardList, show)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TalentButton.id, 666)
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Spiritual.id)
        --灵契格子可升级升星
        for index = 1, 5 do
            local param = carddata.uid * 10 + index
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpiritualLevelUp.id, param)
        end
    end
end

---@param isGetStorage boolean true从仓库重新获取
function CardShowView_CardBag:UpdataLoopList(isGetStorage)
    ---分两步   策划要求筛选五行若没卡 则不跳转过去
    self:UpdataLoopList_1(isGetStorage)
    self:UpdataLoopList_2()
end

function CardShowView_CardBag:OnCardOver(uid)
    for i, v in pairs(self.StorageCard) do
        if v.uid == uid then
            _G.table.remove(self.StorageCard, i)
            break
        end
    end
    local index = 0
    for i, v in pairs(self.nowCardList) do
        if v.uid == uid then
            _G.table.remove(self.nowCardList, i)
            index = i
            break
        end
    end
    if index == 0 then
        return
    end
    local isCur = self.NowSelectCardIndex == index
    if isCur then
        self.NowSelectCardIndex = 1
    end
    -- self.go_table.scrollloopvectical_card:RecycleItem(index - 1)
    self.go_table.scrollloopvectical_card:UpdateCount(#self.nowCardList)
    if isCur then
        -- self.go_table.scrollloopvectical_card:UpdateAllItem()
        self:SetCardItem()
        self:SendCutoverFun()
    end
end

---@param isGetStorage boolean true从仓库重新获取
function CardShowView_CardBag:UpdataLoopList_1(isGetStorage)
    if isGetStorage == true or self.StorageCard == nil then
        self.StorageCard = _G.StorageManager:GetInstance():GetCardDataSortList() -- {}
    end
    self:StarSx()
end

---@param isGetStorage boolean true从仓库重新获取
function CardShowView_CardBag:UpdataLoopList_2()
    self:StarSort()
    if self.tempCardData then
        for i, v in ipairs(self.nowCardList) do
            if v.uid == self.tempCardData.uid then
                self.NowSelectCardIndex = i
                break
            end
        end
    end
    self.go_table.scrollloopvectical_card:UpdateCount(#self.nowCardList)
    if self.tempCardData then
        self.go_table.scrollloopvectical_card:ScrollToIndex(self.NowSelectCardIndex - 1)
        self.tempCardData = nil
    end
end

---刷新显示  升级后
function CardShowView_CardBag:UpdateAllItem()
    local nowCardData = self.nowCardList[self.NowSelectCardIndex]
    self:StarSort()

    ---@param carddata CardData
    for index, carddata in pairs(self.nowCardList) do
        if carddata.uid == nowCardData.uid then
            self.NowSelectCardIndex = index
            break
        end
    end
    self.go_table.scrollloopvectical_card:UpdateAllItem()
    self:UpdateResonance()
end

