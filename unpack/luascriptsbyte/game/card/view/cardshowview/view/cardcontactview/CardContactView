---@class CardContactView : UIBaseView    分享到界面
---@field public go_table ChatView_GoTable GoTable
local CardContactView = _G.BaseClass("CardContactView", _G.UIBaseView)
local contactCfg = _G.ConfigManager.card_qiyue_cfg
local CardInfoManager = require("CardInfoManager"):GetInstance()

function CardContactView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@  number _G.ChatType默认打开界面
function CardContactView:OnCreate(cardData)
    self.cardData = cardData
    self.cfg = contactCfg[self.cardData.cfg.fetter[1]]
    self:FreshView()
end

function CardContactView:FreshView()
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg.name) 
    local attDes
    for k, v in ipairs(self.cfg.att1) do 
        if k == 1 then 
            attDes = CardInfoManager:GetShowProp(v[1], v[2], v[3])
        else 
            attDes = attDes .. "," .. CardInfoManager:GetShowProp(v[1], v[2], v[3])
        end
    end
    if #self.cfg.cards > 1 then 
        self.go_table.obj_head2:SetActiveE(1)
        self.go_table.aortext_des2:SetActiveE(1)
        self.go_table.aortext_des1.text = _G.LangUtil.GetLangPackValue(18900000048, attDes)
        self.go_table.aortext_des2.text = _G.LangUtil.GetLangPackValue(18900000050)
    else 
        self.go_table.obj_head2:SetActiveE(0)
        self.go_table.aortext_des2:SetActiveE(0)
        self.go_table.aortext_des1.text = _G.LangUtil.GetLangPackValue(18900000049, attDes)
    end
    self:ShowItem(1, self.cardData.sid, self.cardData)
    local index = 2
    for i = 1, #self.cfg.cards do 
        if self.cfg.cards[i] ~= self.cardData.sid then
            self:ShowItem(index, self.cfg.cards[i])
            index = index + 1
        end
    end 
end

function CardContactView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_backGround" then
        self:Close()
    end
end

function CardContactView:ShowItem(index, sid)
    local gray = #_G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card):GetCardsBySid(sid) > 0
    local goTable = _G.GetAutoGoTable(self.go_table["obj_head" .. index]) 
    local cfg = index == 1 and self.cardData.cfg or require "CardCommentManager":GetInstance():CardData(sid, false)
    local grade = index == 1 and self.cardData.Order or (cfg and cfg.Order)
    local star = index == 1 and self.cardData.star or (cfg and cfg.Star)

    goTable.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(grade)
    goTable.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.Name)

    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    local obj_logo = uiModel and goTable.obj_logo2 or goTable.obj_logo
    local aorimage_logo = uiModel and goTable.aorimage_logo2 or goTable.aorimage_logo
    if goTable.obj_logo2 then
        goTable.obj_logo2:SetActiveE(0)
        goTable.obj_logo:SetActiveE(0)
    end

    if obj_logo then
        local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag(grade, sid)
        if icon then
            aorimage_logo.SpriteName = icon
            obj_logo:SetActiveE(1)
        else
            obj_logo:SetActiveE(0)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("logo异常")
        end
    end

    local icon

    icon = cfg.Icon

    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    goTable.aorimage_Icon.SpriteName = icon

    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local order, starCount = CardInfoManager:GetOrderStarCount(star)
    goTable.aorimage_ColorBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, order)
    goTable.aorimage_jue:SetGray(not gray)
    goTable.aorimage_logo:SetGray(not gray)
    goTable.aorimage_ColorBg:SetGray(not gray)
    goTable.aorimage_Icon:SetGray(not gray)
end

return CardContactView
