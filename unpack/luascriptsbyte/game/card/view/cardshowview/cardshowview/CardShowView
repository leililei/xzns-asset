function CardShowView:InitArtifactItem(call)
    if self.isPreviewCardShow then
        return
    end
    local factoryIns = _G.ItemFactory:GetInstance()
    local type = _G.ItemFactory.itemType.ItemArtifactBase
    self.ArtifactItem = nil
    self.go_table.obj_ArtifactItem:ClearChildren()
    ---@param item ItemArtifactBase
    factoryIns:GetItemCard(
        type,
        self.go_table.obj_ArtifactItem,
        function(item)
            ---隐藏   不挡神器栏点击
            item.go_table.aorbtn_Click:SetActiveE(0)
            -- 设置神器星级层级
            local canvas = item.go_table.obj_stars:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            canvas.overrideSorting = true
            canvas.sortingOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 5
            self.ArtifactItem = item
            if call then
                call()
            end
        end
    )
end

