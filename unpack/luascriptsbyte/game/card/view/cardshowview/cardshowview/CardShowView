---界面的入口函数
---@param  Data params_CardShowView
---@param cardBagView CardShowView_CardBag
---@param isShowCard boolean 是否为展示预览卡牌
---@param showtypename string 优先展示内容
function CardShowView:OnCreate(Data, cardBagView, isPreviewCardShow, showtypename, jumpSkinId)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CardShowView, self.go_table)
    self.isPreviewCardShow = isPreviewCardShow
    if isPreviewCardShow then
        if Data and Data.CardData then
            if Data.CardData:CheckCanPotential() then
                Data.CardData.potential = require("CardPotentialModel"):GetInstance():GetMaxPotential()
            end
        end
        if AppSetting.IsXzns then
            require("CardCommentManager"):GetInstance():PlayShowCfg(Data.CardData.sid, isPreviewCardShow)
        end
        local tipsView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonTipView.Name)
        self.IllustrationDataortHunJiangs = require("IllustrationModel"):GetInstance().IllustrationHunJiangList
        self.IllustrationDataortHunJianglist = {}
        for k, v in pairs(self.IllustrationDataortHunJiangs) do
            _G.table.insert(self.IllustrationDataortHunJianglist, v)
        end
        _G.table.sort(self.IllustrationDataortHunJianglist, function(a, b)
            return a.taskState.display_priority < b.taskState.display_priority
        end)
        for i, v in ipairs(self.IllustrationDataortHunJianglist) do
            if Data.CardData.sid == v.id then
                self.IllustrationDataortHunJiangNowIndex = i
            end
        end

        if tipsView then
            --sortingOrder+49,刚好比下一层CommonTip层级少1，防止在角色界面点技能弹窗后关不掉
            -- self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder =
            --     tipsView.orderInLayer + 49
            tipsView:Hide()
        end
    end
    self.CallBack = Data and Data.CallBack or nil
    self.initIndex = Data and Data.initIndex or nil
    self.tempCardData = Data and Data.CardData or nil
    -- self:InitCardBG()
    -- self:InitOtherAll(
    --     function()
    --         -- local res = _G.ConfigManager.ui_cfg.CardShowView.resources
    --         -- self:AddComponent(
    --         --     self.go_table.obj_goldInfo,
    --         --     require("ResourceCompont").New(self.go_table.obj_goldInfo, res)
    --         -- )
    --     end
    -- )
    ---@type CardShowView_RightView
    self.jumpSkinId = jumpSkinId
    self.lua_Right =
        self:AddComponent(
            self.go_table.obj_bottom,
            require("CardShowView_RightView").New(self.go_table.obj_bottom, self.isPreviewCardShow, showtypename, self)
        )
    self.lua_cardBag = cardBagView
    if self.lua_cardBag then
        self.lua_cardBag:SetCutoverFun(_G.handler(self, self.CutoverFun))
        self.lua_cardBag:SendCutoverFun()
    elseif self.tempCardData then
        if self.isPreviewCardShow then
            self:CutoverFun(self.tempCardData, self.IllustrationDataortHunJiangNowIndex,
                table.count(self.IllustrationDataortHunJianglist))
        else
            self:CutoverFun(self.tempCardData)
        end
        self.mCardInfoManager:Add_CardViewUpdataFun(
            "CardShowView",
            function(CardData, isUp, show)
                self:CutoverFun(CardData)
            end
        )
    end
    if self.isPreviewCardShow then
        self.go_table.aorbtn_fx:SetActiveE(0)
        self.lua_Right:OffOtherToggle()
        self.lua_Right:UpdateSkinToggleState()


        if jumpSkinId ~= nil then
            self.lua_Right:OnJumpSkin(jumpSkinId)
        end
    end

    -- self:LoadEffect()
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName)
end

function CardShowView:ShowSpiritualDetail(oldpower)
    local key = "equipment"
    if self.lua_Right.go_table.obj_equipment:GetActiveSelf() == 1 and self.lua_Right.panelLua[key] then
        self.lua_Right.panelLua[key]:ShowSpiritualDetail()
    else
        ---属性变化提示
        require "CardInfoManager":GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
        local curPower = self.CardData.power
        require "CommonTipManager".OpenPowerUpView(oldpower, curPower - oldpower)
    end
end

function CardShowView:ShowContact(CardData)
    if CardData.cfg.fetter[1] then
        self.go_table.obj_contract:SetActiveE(1)
        self.contactCardData = CardData
    else
        self.go_table.obj_contract:SetActiveE(0)
        return
    end
    local contactCfg = _G.ConfigManager.card_qiyue_cfg[CardData.cfg.fetter[1]]
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local attDes
    for k, v in ipairs(contactCfg.att1) do
        if k == 1 then
            attDes = CardInfoManager:GetShowProp(v[1], v[2], v[3])
        else
            attDes = attDes .. "," .. CardInfoManager:GetShowProp(v[1], v[2], v[3])
        end
    end
    if #contactCfg.cards > 1 then
        --self.go_table.aortext_contractDes.text = string.format("同时上阵，%s", attDes)
        self.go_table.obj_head2:SetActiveE(1)
        self.go_table.aortext_contractDes.text = _G.LangUtil.GetLangPackValue(18900000048, attDes)
    else
        --self.go_table.aortext_contractDes.text = string.format("上阵后，%s", attDes)
        self.go_table.obj_head2:SetActiveE(0)
        self.go_table.aortext_contractDes.text = _G.LangUtil.GetLangPackValue(18900000049, attDes)
    end
    self:ShowItem(1, CardData.sid, CardData)
    local index = 2
    for i = 1, #contactCfg.cards do
        if contactCfg.cards[i] ~= CardData.sid then
            self:ShowItem(index, contactCfg.cards[i], CardData)
            index = index + 1
        end
    end
end

function CardShowView:ShowItem(index, sid, CardData)
    local temp = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card):GetCardsBySid(sid)
    local gray = #_G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card):GetCardsBySid(sid) > 0
    local goTable = _G.GetAutoGoTable(self.go_table["obj_head" .. index])
    local cfg = index == 1 and CardData.cfg or require "CardCommentManager":GetInstance():CardData(sid, false)
    local grade = index == 1 and CardData.Order or (cfg and cfg.Order)
    local star = index == 1 and CardData.star or (cfg and cfg.Star)

    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    goTable.obj_logo:SetActiveE(uiModel and 0 or 1)
    if goTable.obj_logo2 then
        goTable.obj_logo2:SetActiveE(uiModel and 1 or 0)
    end
    local obj_logo = (uiModel and goTable.obj_logo2) and goTable.obj_logo2 or goTable.obj_logo
    local aorimage_logo = (uiModel and goTable.aorimage_logo2) and goTable.aorimage_logo2 or goTable.aorimage_logo

    goTable.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(grade)
    goTable.aortext_name = _G.LangUtil.GetLangPackValue(cfg.name)
    if obj_logo then
        local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag(grade, sid)
        if icon then
            aorimage_logo.SpriteName = icon
            obj_logo:SetActiveE(1)
        else
            obj_logo:SetActiveE(0)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("logo异常")
        end
    end

    local icon

    icon = cfg.Icon

    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    goTable.aorimage_Icon.SpriteName = icon

    local CardInfoManager = require("CardInfoManager"):GetInstance()
    --ZHJH-4979 不根据卡牌品质更改底框，统一显示为橙色
    --local order, starCount = CardInfoManager:GetOrderStarCount(star)
    goTable.aorimage_ColorBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, 4)
    goTable.aorimage_jue:SetGray(not gray)
    goTable.aorimage_logo:SetGray(not gray)
    if goTable.aorimage_logo2 then
        goTable.aorimage_logo2:SetGray(not gray)
    end
    goTable.aorimage_ColorBg:SetGray(not gray)
    goTable.aorimage_Icon:SetGray(not gray)
end

