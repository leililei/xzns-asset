        self.temp_rotate = nil
    end

    if self.eflv_tran then
        _G.DestroyObject(self.eflv_tran)
        self.eflv_tran = nil
    end

    ---团队战力更新
    _G.StorageManager:GetInstance():GetServerCardPower(
        function()
            local power = self:MaxPowerGet()

            if _G.AppSetting.DEBUG then
                _G.Log(power, "团队战斗力变化同步")
            end
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.AFK.MaxPower },
                power
            )
        end,
        true
    )
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.View_PropUp.Name)
end

function CardShowView:MaxPowerGet()
    self.KaPao = { 0, 0, 0 }
    local kaPai = _G.StorageManager:GetInstance():GetMaxPowerCardByTarget(self.KaPao)
    local KaPaiList = {}
    for key, value in pairs(kaPai) do
        _G.table.insert(KaPaiList, value)
    end
    _G.SortList(
        KaPaiList,
        function(a)
            return a.power
        end
    )
    local power = 0
    for i = 1, 5 do
        if KaPaiList[i] ~= nil then
            power = power + KaPaiList[i].power
        end
    end

    return power
end

