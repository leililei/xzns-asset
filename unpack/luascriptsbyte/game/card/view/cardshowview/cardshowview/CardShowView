function CardShowView:UpdateSpine(cfg)
    self.go_table.obj_cardSpine:SetLocalScaleXYZ(cfg.size2)
    local pos = cfg.pos_portrait
    self.go_table.obj_cardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
    self.go_table.obj_cardLvEff:SetLocalPosition(pos[1], pos[2], pos[3])
    local x, _, z = self.go_table.aorrawimage_pingtai.gameObject:GetPosition()
    self.go_table.aorrawimage_pingtai.gameObject:SetLocalPosition(x, pos[2], z)

    local pathList = _G.string.split(cfg.ModelPathHi, "/")
    self.pathName = pathList[#pathList]

    if _G.AppSetting.IsXzns then
        -- 大spine
        self.go_table.obj_cardSpine:SetLocalScaleXYZ(1)
        if not self.SpineScrollViewAndZoom then
            self.go_table.obj_cardSpine:SetLocalPositionToZero()
            self.SpineScrollViewAndZoom = self:AddComponent(self.go_table.obj_cardSpine,
                require("SpineScrollViewAndZoom").New(self.go_table.obj_cardSpine, cfg, function(obj)
                    if self:IsNil() then
                        return
                    end
                    obj:GetChildE(0):SetLocalScaleXYZ(cfg.size2)

                    if self.go_table.SpineClick_Lua then
                        self.go_table.SpineClick_Lua:SetPos(pos)
                        self.go_table.SpineClick_Lua:ChangeCard(cfg.id)
                        self.go_table.SpineClick_Lua.gameObject:SetParentE(obj)
                    end
                end))
        else
            self.SpineScrollViewAndZoom:LoadSpine(cfg, function(obj)
                if self:IsNil() then
                    return
                end
                self.SpineScrollViewAndZoom.go_table.obj_root:SetLocalScaleXYZ(cfg.size2)
                if self.go_table.SpineClick_Lua then
                    self.go_table.SpineClick_Lua:SetPos(pos)
                    self.go_table.SpineClick_Lua:ChangeCard(cfg.id)
                end
            end)
        end

        -- 小spine
        if cfg.Order == 1 then
            self.go_table.obj_miniSpine:SetActiveE(0)
        else
            self.go_table.obj_miniSpine:SetActiveE(1)
            self.go_table.obj_miniSpine:ClearChildren()
            local path = cfg.spine and cfg.spine[1] or cfg.ModelPathHi
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_miniSpine,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans.gameObject:SetLocalScaleXYZ(cfg.size6 or 1.2)
                    local sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    sg.AnimationState:SetAnimation(0, "stand_2", true)
                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(self.CardData.sid)
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                        end
                        local artifactskinid = require("ArtifactIllustrationModel"):GetInstance():
                        GetArtifactSkinidByCardSkinid(self.CardData.sid, cfg.id and cfg.id or cfg.sid)
                        if artifactskinid then
                            _G.UIUtils.LoadArtifacteffect(trans, self.CardData.sid, artifactskinid, nil)
                        end
                    end
                end
            )
        end
    else
        self.go_table.obj_cardSpine:ClearChildren()
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_cardSpine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
            end
        )
    end
end

