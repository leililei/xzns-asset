---@param tCardData CardData
---@param skinid number 临时换皮 预览
function CardShowView:StartLoadRoleScene(tCardData, skinid, call)
    if self.call == nil then
        self.call = call
    end
    if not call then
        self.call = nil
    end
    local skin = nil
    ---加载角色模型
    local isLoadCard = false
    if self.CardData == nil then
        isLoadCard = true
    elseif tCardData ~= nil then
        skin = tCardData.skinid
        if self.CardData.uid ~= tCardData.uid then
            isLoadCard = true
        elseif skinid ~= nil then
            if self.tempSkin ~= skinid then
                skin = skinid
                isLoadCard = true
            end
        end
    end
    self.CardData = tCardData
    self:RefreshStrategyStationBtn()
    self.CardData.skinid = skinid

    -- self.go_table.aorbtn_AllPut:SetActiveE(self.CardData.type == _G.CardType.Normal and 1 or 0)
    -- self.go_table.aorbtn_AllUnfix:SetActiveE(self.CardData.type == _G.CardType.Normal and 1 or 0)
    --self.go_table.aorbtn_fx:SetActiveE(self.CardData.type == _G.CardType.Normal and 1 or 0)

    if self.CardData == nil then
        return
    end
    if self.call then
        self.call(skin, _G.handler(self, self.UpdateSpine))
    end
    if skin == nil then
        skin = self.CardData.skin
    end
    self.tempSkin = skin

    if isLoadCard then
        self.ShowCfg = require("CardInfoManager").GetCardSkin_ShowCfg(skinid or self.CardData.skin, self.CardData.sid)
    end
    local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(skinid, self.CardData.sid)

    local bgPath = self.CardData.cfg.pos_bg
    if string.IsNullOrEmpty(bgPath) or self.isPreviewCardShow then
        bgPath = cfg.pos_bg
    end
    if string.IsNullOrEmpty(bgPath) then
        bgPath = require("CardInfoManager"):GetInstance():GetCardElementBg(self.CardData:GetElement())
    end
    self.go_table.aorrawimage_bg:LoadImage(bgPath)
end

