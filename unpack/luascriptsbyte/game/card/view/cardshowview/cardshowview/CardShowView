---@param CardData CardData
function CardShowView:CutoverFun(CardData, nowIndex, sumIndex, show)
    if CardData == nil then
        return
    end
    if nowIndex ~= nil then
        self.go_table.aorbtn_left:SetActiveE(nowIndex > 1 and 1 or 0)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if nowIndex ~= nil then
        self.nowIndex = nowIndex
        self.sumIndex = sumIndex
        self.go_table.aorbtn_right:SetActiveE(nowIndex ~= sumIndex and 1 or 0)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end

    local order = CardData.cfg.Order
    local talent = CardData.cfg.talent
    local openxz = _G.ConfigManager.discrete_cfg[107401][1][1]
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_talent, order >= 3 and #talent > 0)

    self:ShowContact(CardData)


    --local unlockData = _G.ConfigManager.discrete_cfg[114001] or {}
    --local unlockPanel = CardData.star >= unlockData[1][1] --and not self.isPreviewCardShow
    --self.go_table.aorbtn_recommendBtn:SetActiveE(unlockPanel and 1 or 0)
    self.go_table.aorbtn_recommendBtn:SetActiveE(0)
    -- 灵脉按钮右上角数字初始化
    -- 灵脉已激活
    if order >= 3 and #talent > 0 and CardData:GetStar() >= openxz then
        local count = _G.table.count(CardData.open_inborn)
        if count > 0 then
            self.go_table.obj_talentLv:SetActiveE(1)
            local talentGo = _G.GetAutoGoTable(self.go_table.obj_talentLv)
            talentGo.aortext_num.text = count
        else
            -- 策划需求 参数为零时，不显示
            self.go_table.obj_talentLv:SetActiveE(0)
        end
    else
        -- 未激活
        self.go_table.obj_talentLv:SetActiveE(0)
    end

    -- 设置魂链图标 是否活动
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_soulLink, order >= 3)
    -- 魂链按钮右上角数字初始化
    -- 魂链已激活
    -- if CardData.soulLink_IsActivate == 1 and CardData.soulLink_lv > 0 then
    --     self.go_table.obj_soulLinkLv:SetActiveE(1)
    --     local soulLinkLvGo = _G.GetAutoGoTable(self.go_table.obj_soulLinkLv)
    --     soulLinkLvGo.aortext_num.text = CardData.soulLink_lv
    -- else
    --     -- 策划需求 层数为零时，不显示
    --     -- 未激活
    --     self.go_table.obj_soulLinkLv:SetActiveE(0)
    -- end

    -- self.go_table.aorimage_OrderDi.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderDi(CardData.star)
    --镇魂街养成提示勾选
    if not self.showYcTipsGo_Table then
        self.showYcTipsGo_Table =
            _G.GetAutoGoTable(self.go_table.toggle_showYcTips, _G.handler(self, self.OnClickShowYcTips))
    end

    self:StartLoadRoleScene(CardData)
    if CardData.type == _G.CardType.Timer then
        -- if CardData.Grade == 2 or CardData.Grade == 1 then
        self.go_table.toggle_showYcTips:SetActiveE(0)
    elseif CardData.star < 15 then
        self.go_table.toggle_showYcTips:SetActiveE(0)
    else
        self.go_table.toggle_showYcTips:SetActiveE(not self.IsShowInfo and 1 or 0)
        self.go_table.toggle_showYcTips.isOn = require "CardInfoManager".IsShowYc(CardData.uid)
    end

    if self.go_table.toggle_showEquipCultivateTips and CardData.uid then
        --已上阵角色不显示【饰品】、【装备】（现在装备没有培养红点）、【神器】功能中关于 “培养”的红点
        if not self.showEquipCultivateTipsGo_Table then
            self.showEquipCultivateTipsGo_Table =
                _G.GetAutoGoTable(self.go_table.toggle_showEquipCultivateTips,
                    _G.handler(self, self.OnClickShowEquipCultivateTips))
        end
        --ZHJH-6606【客户端】角色装备界面优化
        --self.go_table.toggle_showEquipCultivateTips:SetActiveE(not self.IsShowInfo and 1 or 0)
        --self.go_table.toggle_showEquipCultivateTips.isOn = require "CardInfoManager".IsShowEquipCultivate(CardData.uid)
    end
    self:UpdateCardInfo(show, nowIndex, sumIndex)
    if not self.isPreviewCardShow then
        self.go_table.obj_redpointArtifact:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RoleArtifact.id,
            CardData.uid
        )
        self.go_table.obj_redpointArtifactUpgrade:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id,
            CardData.uid
        )
        self.go_table.obj_fettersredpoint:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.CardFetterArena.id,
            CardData.uid
        )

        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg.RedPointRoleGodHalo.id
        )
 
        self.go_table.obj_redpointGodHalo:UpdateRedPointItemIDAndParam(
            _G.ConfigManager.redpoint_cfg.RedPointRoleGodHalo.id,
            CardData.uid
        )



        local redID = CardData.uid
        if CardData.type == _G.CardType.Timer then
            redID = 0
        end
        self.go_table.obj_redpoint_yc:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RoleArrow.id, redID)
    end

    -- self:UpdateEquip(CardData)
    -- self:UpdateArtifact(CardData)
    if not self.lua_Right or not self.ArtifactItem then
        self:InitArtifactItem(_G.handler(self, self.UpdateArtifact))
    else
        self:UpdateArtifact()
    end
    self:UpdateGodHalo()
end

--- 刷新神环
function CardShowView:UpdateGodHalo()
    local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(self.CardData.sid)
    local grade = 1
    if godHaloID ~= 0 then
        self.go_table.aorimage_add:SetActiveE(0)
        self.go_table.aorrawimage_icon:SetActiveE(1)
        local data = _G.ConfigManager.god_halo_cfg[godHaloID]
        self.go_table.aorrawimage_icon:LoadImage(data.icon)
        grade = data.grade
    else
        self.go_table.aorimage_add:SetActiveE(1)
        self.go_table.aorrawimage_icon:SetActiveE(0)
    end
    self.go_table.aorimage_bg.SpriteName = _G.EquipItemIconName[grade]

    local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(self.CardData.skin, self.CardData.sid)
    -- 小spine
    if cfg.Order == 1 then
        self.go_table.obj_miniSpine:SetActiveE(0)
    else
        self.go_table.obj_miniSpine:SetActiveE(1)
        self.go_table.obj_miniSpine:ClearChildren()
        local path = cfg.spine and cfg.spine[1] or cfg.ModelPathHi
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            self.go_table.obj_miniSpine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans.gameObject:SetLocalScaleXYZ(cfg.size6 or 1.2)
                local sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                sg.AnimationState:SetAnimation(0, "stand_2", true)
                --- 只有星座女神有神环
                if _G.AppSetting.IsXzns then
                    local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(self.CardData.sid)
                    if godHaloID ~= 0 then
                        local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                        --- 神环路径，父级路径(加载角色的下面)
                        _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                    end
                    _G.UIUtils.LoadArtifacteffect(trans, self.CardData.sid, nil, nil)
                end
            end
        )
    end
end

function CardShowView:UpdatePower()
    local power = _G.UIUtils.NumberToUnitStr_CardFightNum(self.CardData:GetPower(), true)
    if _G.AppSetting.IsXzns then
        power = _G.UIUtils.NumberToUnitStr_CardFightNum(self.CardData:GetPower(), false)
    end
    self.go_table.aortext_power.text = power
end

function CardShowView:UpdateCardInfo(show, nowIndex, sumIndex)
    self.go_table.aortext_name.text = self.CardData:GetName()
    self.go_table.aortext_lv.text = self.CardData:GetLevel()
    local power = _G.UIUtils.NumberToUnitStr_CardFightNum(self.CardData:GetPower(), true)
    if _G.AppSetting.IsXzns then
        power = _G.UIUtils.NumberToUnitStr_CardFightNum(self.CardData:GetPower(), false)
        self.go_table.aortext_desc.text = _G.GetLangPackValue(self.CardData.cfg.card_title)
        self.go_table.aortext_element.text = _G.GetLangPackValue(_G.ElementStrEnum
            [require "CardInfoManager":GetInstance():GetElementsKey(self.CardData.cfg.Elements_new)])
    end
    self.go_table.aortext_power.text = power

    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local SpriteName
    for i = 1, 5 do
        SpriteName = CardInfoManager:GetHuoSpriteName(self.CardData.star, i)
        self.go_table["aorimage_star" .. i].SpriteName = SpriteName
        self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
    end

    local posText
    local posId = self.CardData.cfg.card_position1
    if posId > 0 then
        posText = _G.GetLangPackValue(posId)
    end
    posId = self.CardData.cfg.card_position2
    if posId > 0 then
        posText = posText .. "/" .. _G.GetLangPackValue(posId)
    end
    self.go_table.aortext_position.text = posText

    --设定元素和职业图标
    require("CardInfoManager"):GetInstance():SetElementsProfessionalSP(
        self.go_table.aorimage_element,
        self.CardData.cfg.Elements_new,
        self.go_table.aorimage_profession,
        self.CardData.cfg.Professional
    )
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_position.text = posText ..
            _G.GetLangPackValue(_G.ProfessionalStrEnum[self.CardData.cfg.Professional])
        self.go_table.aorimage_Orderzi.SpriteName = CardInfoManager:GetCardOrderZi(self.CardData.Grade)
        local tag = CardInfoManager:GetCardGradeFlag(self.CardData.Grade, self.CardData.sid)
        self.go_table.aorimage_Tag:SetActiveE(tag and 1 or 0)
        self.go_table.trans_TagEffNode:SetActiveE(tag and 1 or 0)
        if tag then
            self.go_table.aorimage_Tag.SpriteName = tag
            if not self.tagEffIsLoad then
                self.tagEffIsLoad = true
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_hexinbiaoqian,
                    self.go_table.trans_TagEffNode,
                    function(trans)
                        if not self.go_table then
                            _G.DestroyImmediate(trans)
                            return
                        end
                    end
                )
            end
        end
    else
        self.go_table.aortext_profession.text = _G.GetLangPackValue(_G.ProfessionalStrEnum
            [self.CardData.cfg.Professional])
        self.go_table.aortext_equipment.text = _G.GetLangPackValue(equipmentType[self.CardData.cfg.EquipmentType])
        self.go_table.aorimage_Orderzi.SpriteName = CardInfoManager:GetCardOrderZi(self.CardData.Grade)
        local effectSP2 = "ef_ItemCardBodyBaseViewSP_bg"
        self.go_table.aorimage_Orderzi:ClearChildren()
        if self.CardData.Grade == 7 then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg[effectSP2],
                self.go_table.aorimage_Orderzi,
                function(trans)
                    if _G.IsNil(self.go_table) then
                        _G.DestroyObject(trans)
                        return
                    end
                end
            )
        end
