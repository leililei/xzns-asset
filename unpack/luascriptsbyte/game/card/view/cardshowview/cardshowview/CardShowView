function CardShowView:ShowLvUpEffect()
    if self.effPlatform == nil then
        self.effPlatform = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_pingtai,
            self.go_table.obj_platformEff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.effPlatform = trans
            end
        )
    elseif self.effPlatform ~= true then
        self.effPlatform:SetActiveE(0)
        self.effPlatform:SetActiveE(1)
    end
    if self.effCardLv == nil then
        self.effCardLv = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_jueseshengji,
            self.go_table.obj_cardLvEff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.effCardLv = trans
            end
        )
    elseif self.effCardLv ~= true then
        self.effCardLv:SetActiveE(0)
        self.effCardLv:SetActiveE(1)
    end
end

---刷新神器升级/替换箭头提示
function CardShowView:UpdateArtifactArray()
    local isShow = require("ArtifactModel"):GetInstance():CheckCardArtifactCanReplace(self.CardData.uid)
    local isShowStartUp
    local cLv, cStar, cAwaken
    if not _G.TableIsEmpty(self.CardData.ArtifactBar) then
        cLv, cStar, cAwaken = self.CardData.ArtifactBar:CanDevelop()
        isShow = isShow or (cLv and not cStar and not cAwaken)
    end
    isShowStartUp = cStar
    self.go_table.aorimage_artifactUpArray:SetActiveE((isShow and not isShowStartUp) and 1 or 0)
    self.go_table.aortext_effcetName:SetActiveE(isShowStartUp and 1 or 0)
    self.go_table.obj_effect:SetActiveE(isShowStartUp and 1 or 0)
    if isShowStartUp and not self.ArtifactStartEffect then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shenbingtisheng,
            self.go_table.obj_effect,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                self.ArtifactStartEffect = trans
            end
        )
    end
end

---界面的销毁函数
function CardShowView:OnDestroy()
    if self.lua_cardBag then
        self.lua_cardBag:SetCutoverFun(nil)
    end
    self.mCardInfoManager:Del_CardViewUpdataFun("CardShowView")
    self:RemoveListener(_G.ArtifactShow.ArtifactTimeOver, self.OnArtifactTimeOver)
    self:RemoveListener(_G.eCardResonance.CRLevelUp, self.ShowLvUpEffect)
    self:RemoveListener(_G.eCardResonance.CRSEquipmentRefresh, self.UpdateArtifact)
    self:RemoveListener(_G.eGodHalo.GodHaloRefresh, self.UpdateGodHalo)
    if self.isPreviewCardShow then
        local tipsView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonTipView.Name)
        if tipsView then
            tipsView:Show()
        end
    end
end

return CardShowView
