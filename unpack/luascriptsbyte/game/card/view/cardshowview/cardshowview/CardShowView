function CardShowView:OpenArtifactTip(artifactData)
    local btnDevelop = {
        name = _G.GetLangPackValue(90020400065),
        func = _G.handlerbind(self, self.DevelopArtifact, artifactData),
        close = true,
        redPoint = { _G.ConfigManager.redpoint_cfg.ArtifactUpgradeAny.id, artifactData.uid }
    }
    local btnTakeOff = {
        name = _G.GetLangPackValue(90020400064),
        func = _G.handlerbind(self, self.TakeOffArtifact),
        close = true
    }
    local btnPutOn = {
        name = _G.GetLangPackValue(90023400020),
        func = _G.handlerbind(self, self.ConfirmToPutOnArtifact, artifactData),
        close = true
    }
    local btnReplace = {
        name = _G.GetLangPackValue(90020400047),
        func = _G.handlerbind(self, self.OpenArtifact),
        close = true,
        redPoint = { _G.ConfigManager.redpoint_cfg.RoleArtifact.id, self.CardData.uid }
    }
    -- _G.UIManager:GetInstance():OpenWindow(
    --     _G.ConfigManager.ui_cfg.CommonTipView.Name,
    --     _G.TipType.Artifact,
    --     artifactData,
    --     btn,
    --     true
    -- )
    local msg = {}
    local artifact = {}
    if _G.table.isEmptyOrNil(self.CardData.ArtifactBar) then --未穿戴
        artifact.data = artifactData
        if artifactData.type == _G.ArtifactDataType.Normal then
            artifact.btn = { left = btnDevelop, middle = btnPutOn }
        else
            artifact.btn = { left = btnPutOn }
        end
        artifact.isSelf = false
        table.insert(msg, artifact)
    else --已穿戴
        artifact.data = artifactData
        if artifactData.type == _G.ArtifactDataType.Normal then
            artifact.btn = { left = btnTakeOff, middle = btnDevelop, right = btnReplace }
        else
            artifact.btn = { left = btnTakeOff, middle = btnReplace }
        end
        table.insert(msg, artifact)
    end
    if not table.isEmptyOrNil(msg[1].data) then
        require("RedPointManager"):GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id,
            self.CardData.uid
        )
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id
        )
        self:UpdateArtifactArray()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, msg, 2)
    else
        self:OpenArtifact()
    end
end

function CardShowView:DevelopArtifact(artifactData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ArtifactDevelopView.Name,
        artifactData,
        self.CardData,
        function(cardData)
            self:UpdateArtifact(cardData)
            require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
        end
    )
end

function CardShowView:TakeOffArtifact(cardData, isOther, call)
    cardData = cardData or self.CardData
    if not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, 1) then
        _G.PopWindowManager:GetInstance():ShowAllTips(270801)
        return
    end
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
    self.lastCardProp = _G.GameUtil.GetPropUpData(self.CardData)
    require "ArtifactModel":GetInstance():TakeOffArtifact(
        cardData,
        function()
            if not isOther then
                self:UpdateArtifact(cardData)
                _G.UIUtils.ShowPropUp(cardData, self.lastCardProp)
                local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.power
                if offset > 0 then
                    require "CommonTipManager".OpenPowerUpView(self.power, offset)
                end
            end
            require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
            if call then
                call()
            end
        end
    )
end

function CardShowView:ConfirmToPutOnArtifact(artifactData)
    if artifactData:GetProfessional() ~= self.CardData:GetProfessional() then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            271601,
            nil,
            _G.handlerbind(self, self.TryToPutOnArtifact, artifactData)
        )
    else
        self:TryToPutOnArtifact(artifactData)
    end
end

function CardShowView:TryToPutOnArtifact(artifactData)
    if artifactData.cardUid > 0 then
        self.lastCardProp = _G.GameUtil.GetPropUpData(self.cardList[artifactData.cardUid])
        self:TakeOffArtifact(
            self.cardList[artifactData.cardUid],
            true,
            _G.handlerbind(self, self.PutOnArtifact, artifactData)
        )
    else
        self.power = _G.StorageManager:GetInstance():GetPlayerPower()
        self.lastCardProp = _G.GameUtil.GetPropUpData(self.CardData)
        self:PutOnArtifact(artifactData)
    end
end

function CardShowView:PutOnArtifact(artifactData)
    require("ArtifactModel"):GetInstance():PutOnArtifact(
        self.CardData,
        artifactData,
        function()
            self:UpdateArtifact()
            self:InitArtifactList()
            self:ChangeProfession(self.curProfession, true)
            _G.UIUtils.ShowPropUp(self.CardData, self.lastCardProp)
            local offset = _G.StorageManager:GetInstance():GetPlayerPower() - self.power
            if offset > 0 then
                require "CommonTipManager".OpenPowerUpView(self.power, offset)
            end
        end
    )
end

