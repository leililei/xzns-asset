local CardInfoManager = require("CardInfoManager")
local PropCardData = require("PropCardData")

---@class CardChooseView : UIBaseView    中文描述
---@field public go_table CardChooseView_GoTable GoTable
local CardChooseView = _G.BaseClass("CardChooseView", _G.UIBaseView)

function CardChooseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.elementBtns = {
        self.go_table.aorbtn_all,
        self.go_table.aorbtn_lei,
        self.go_table.aorbtn_feng,
        self.go_table.aorbtn_shui,
        self.go_table.aorbtn_huo,
        self.go_table.aorbtn_tu,
        self.go_table.aorbtn_shen
    }
end

---界面的入口函数
function CardChooseView:OnCreate(cardData, maxNum, curSelect, ignoreUids, call)
    self.cardData = cardData
    self.maxNum = maxNum
    self.curSelect = curSelect
    self.ignoreUids = ignoreUids
    self.curSelectUid = {}
    self.embattleUids = {}
    for _, v in pairs(curSelect) do
        _G.table.insert(self.curSelectUid, v.uid)
    end
    self.closeCall = call
    self:InitAllCards()
    local Element = cardData.Element or cardData:GetElement()
    self.isGod = Element == _G.CardElementType.God
    self:ChangeListType(_G.CardElementType.None)
    local showGod = _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[106706])
    self.go_table.aorbtn_shen:SetActiveE(showGod and 1 or 0)
end

function CardChooseView:InitAllCards()
    self:InitPropCardData()
    local cardList = not self.cardData.Element and
        CardInfoManager.GetNotSelfDogFoodCards(self.cardData) or CardInfoManager.GetDogFoodCards(self.cardData.Element, self.cardData.Star)
    self.battleUids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    self.battleUids = _G.table.chooseToArray(
        self.battleUids,
        function(_, v)
            return v > 0
        end
    )
    -- _G.table.insertto(self.battleUids, self.ignoreUids)
    ---槽位上的卡不显示
    -- local posUids = require("CardResonanceModel"):GetInstance():GetAllPosCardsUids()
    -- _G.table.insertto(uids, posUids)
    -- 显示在阵上的卡牌
    cardList = _G.table.chooseToArray(
        cardList,
        function(_, v)
            return not _G.table.ContainsValue(self.ignoreUids, v.uid)
        end
    )
    self.cardList = cardList
    local propCards = _G.table.toArray(self.propCards)
    _G.SortList(
        propCards,
        function(CardData)
            return -(CardData:GetElement() % 7)
        end
    )
    for _, v in pairs(propCards) do
        _G.table.insert(self.cardList, v)
    end
    _G.SortList(
        self.cardList,
        function(v)
            local hasSelect = _G.table.ContainsValue(self.curSelectUid, v.uid) and 1 or 0
            return hasSelect, -v.Grade, -v.type, -v:GetElement(), -v:GetRealLevel(), v.uid
        end
    )
end

function CardChooseView:AddOrDelPropCard(data, isAdd)
    if isAdd then
        _G.table.insert(self.cardList, data)
    else
        _G.table.removebyvalue(self.cardList, data)
    end
    _G.SortList(
        self.cardList,
        function(v)
            local hasSelect = _G.table.ContainsValue(self.curSelectUid, v.uid) and 1 or 0
            return hasSelect, -v.Grade, -v.type, -v:GetElement(), -v:GetRealLevel(), v.uid
        end
    )
    self:UpdateCardList()
end

function CardChooseView:UpdateCardList()
    local all = _G.CardElementType.None
    if self.chooseElementType == all then
        self.curCardList = self.cardList
    else
        self.curCardList = _G.table.chooseToArray(
            self.cardList,
            function(_, v)
                return v:GetElement() == self.chooseElementType
            end
        )
    end
    if not self.listInit then
        self.go_table.scrollloopvectical_card:InitItemData(#self.curCardList, _G.handler(self, self.RefreshCardItem))
        self.listInit = true
    else
        self.go_table.scrollloopvectical_card:UpdateCount(#self.curCardList)
        if self.OnSelectCardCall then
            self.OnSelectCardCall(self.curSelect)
        end
    end
    self.go_table.aortext_empty:SetActiveE(#self.curCardList == 0 and 1 or 0)
end

function CardChooseView:RefreshCardItem(index, obj)
    index = index + 1
    local data = self.curCardList[index]
    ---@type CardChooseView._obj_cardItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCard, data))
    if not tb.card then
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.HeadItem_Select,
            tb.obj_cardNode,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item)
                    return
                end
                item.transform:SetLocalPositionToZero()
                tb.card = item
                self:ShowCard(item, data)
            end
        )
    elseif tb.card ~= true then
        self:ShowCard(tb.card, data)
    end
end

function CardChooseView:ShowCard(item, data)
    item:ShowCardData(data, nil, true)
    item:isHave(true)
    local isSelect = _G.table.ContainsValue(self.curSelectUid, data.uid)
    item:SetSelectGou(isSelect)
    if _G.table.ContainsValue(self.battleUids, data.uid) then
        item:ShowOrHideGong(true)
    end
    if data.type == _G.CardType.Prop then
        if isSelect then
            item:SetLevelText(_G.GetLangPackValue(90000001251, 1))
        else
            item:SetLevelText(_G.GetLangPackValue(90000001252, data.count))
        end
    end
end

function CardChooseView:OnClickCard(go, isOn, data)
    local hasSelect = _G.table.ContainsValue(self.curSelectUid, data.uid)
    if not hasSelect and not self:CheckHasEmpty() then
        _G.PopWindowManager:GetInstance():ShowAllTips(170106)
        return
    end
    if data.type == _G.CardType.Prop then
        if hasSelect then
            ---没选中那组的一定是sid=uid
            if data.sid == data.uid then
                ---已选中的sid=uid,说明这个卡只有一张
                self:OnSelectCard(data)
            else
                self.propCards[data.uid] = nil ---解除引用
                local mainData = self.propCards[data.sid]
                mainData.count = mainData.count + 1
                self:OnSelectCard(data, true)
                self:AddOrDelPropCard(data, false)
            end
        else
            if data:GetCount() == 1 then
                self:OnSelectCard(data)
            else
                data.count = data.count - 1
                local tempData = PropCardData.New()
                local uid = self:GetSameSidPropCardUid(data.sid)
                tempData:Parse({ sid = data.sid, uid = uid, num = 1 })
                self.propCards[uid] = tempData
                self:OnSelectCard(tempData, true)
                self:AddOrDelPropCard(tempData, true)
            end
        end
    else
        if hasSelect then
            self:OnSelectCard(data)
            return
        end

        -- if data.shenshiPosType ~= _G.StonePosType.PosZero then --共鸣神石槽位卡
        --     _G.PopWindowManager:GetInstance():ShowAllTips(170305)
        --     return
        -- end
        ---否则判断是否可选 提示 上锁 下阵
        require("CardInfoManager").CardReadyDestroy(
            data,
            function()
                --updataCall
            end,
            function(ReData)
                ---okCall
                if ReData.isEmbattle then
                    ---记录 该卡真被吃的时候要下阵
                    self.embattleUids[data.uid] = true
                end
                self:OnSelectCard(data)
            end,
            function()
                return
            end
        )
    end
end

function CardChooseView:OnSelectCardCall(call)
    self.OnSelectCardCall = call
end

function CardChooseView:OnSelectCard(data, noRefresh)
    if _G.table.ContainsValue(self.curSelectUid, data.uid) then
        _G.table.removebyvalue(self.curSelectUid, data.uid)
        for i, v in ipairs(self.curSelect) do
            if v.uid == data.uid then
                _G.table.remove(self.curSelect, i)
            end
        end
        --_G.table.removebyvalue(self.curSelect, data)
    elseif self:CheckHasEmpty() then
        _G.table.insert(self.curSelectUid, data.uid)
        _G.table.insert(self.curSelect, data)
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(170106)
    end
    if noRefresh then
        return
    end
    self.go_table.scrollloopvectical_card:UpdateAllItem()
    if self.OnSelectCardCall then
        self.OnSelectCardCall(self.curSelect)
    end
end

function CardChooseView:CheckHasEmpty()
    return _G.table.count(self.curSelectUid) < self.maxNum
end

function CardChooseView:ChangeListType(_t)
    if self.chooseElementType == _t then
        return
    end

    self.go_table.trans_choose:SetParentE(self.elementBtns[_t + 1].transform)
    self.chooseElementType = _t
    self:UpdateCardList()
end

---初始化材料卡数据
function CardChooseView:InitPropCardData()
    self.propCards = {}
    local element = self.cardData.Element or self.cardData:GetElement()
    local sid, count, data
    for _, v in pairs(_G.ConfigManager.item_card_cfg) do
        sid = v.id
        if v.Elements == _G.CardElementType.Common or v.Elements == element then
            count = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
            if count > 0 then
                data = PropCardData.New()
                data:Parse({ sid = sid, uid = sid, num = count })
                self.propCards[sid] = data
            end
        end
    end
    local addprop={}
    for i, v in pairs(self.propCards) do
        if _G.table.ContainsValue(self.curSelectUid, v.sid) and v.count>1 then
            local uid = self:GetSameSidPropCardUid(v.sid)
            table.removebyvalue(self.curSelectUid,v.sid,true)
            local olddata = table.find(self.curSelect,function(a) return a.uid==v.sid  end)
            table.insert(self.curSelectUid,uid)
            if olddata then
                table.removebyvalue(self.curSelect,olddata)
            end
            v.count = v.count - 1
            local tempData = PropCardData.New()
            tempData:Parse({ sid = data.sid, uid = uid, num = 1 })
            table.insert(self.curSelect,tempData)
            addprop[uid] = tempData
        end
    end
    for k,v in pairs(addprop) do
        self.propCards[k]=v
    end
end

---获取生成uid
---@param sid number 材料卡sid
function CardChooseView:GetSameSidPropCardUid(sid)
    local count = 0
    for _, v in pairs(self.propCards) do
        if sid == v.sid then
            count = count + 1
        end
    end
    local uid = sid * 100
    for i = 1, count do
        uid = uid + 1
        if self.propCards[-uid] == nil then
            return -uid
        end
    end
    return -(uid + 1)
end

---按钮点击事件在这里派发
function CardChooseView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if self.closeCall then
            if _G.AppSetting.IsXzns then--星座卡牌觉醒材料卡选取问题，单独修改
                local selectCards = {}
                local selectCardsDic = {}
                for _, v in pairs(self.curSelect) do
                    local newUid = v.uid
                    if v.uid < 0 then
                        newUid = -(v.uid) // 100
                    end
                    if not selectCardsDic[newUid] then
                        selectCardsDic[newUid] = 1
                    else
                        selectCardsDic[newUid] = selectCardsDic[newUid] + 1
                    end
                end
                for _, v in pairs(self.curSelect) do
                    if v.uid < 0 then
                        local newUid = -(v.uid) // 100
                        local tempData = PropCardData.New()
                        tempData:Parse({sid = v.sid, uid = newUid, num = selectCardsDic[newUid]})
                        _G.table.insert(selectCards, tempData)
                    else
                        _G.table.insert(selectCards, v)
                    end
                end
                self.closeCall(selectCards, self.embattleUids)
            else
                self.closeCall(self.curSelect, self.embattleUids)
            end
        end
        self:Close()
    elseif go == self.go_table.aorbtn_lei then
        self:ChangeListType(_G.CardElementType.Thunder)
    elseif go == self.go_table.aorbtn_feng then
        self:ChangeListType(_G.CardElementType.Wind)
    elseif go == self.go_table.aorbtn_shui then
        self:ChangeListType(_G.CardElementType.Water)
    elseif go == self.go_table.aorbtn_huo then
        self:ChangeListType(_G.CardElementType.Fire)
    elseif go == self.go_table.aorbtn_tu then
        self:ChangeListType(_G.CardElementType.Earth)
    elseif go == self.go_table.aorbtn_shen then
        self:ChangeListType(_G.CardElementType.God)
    elseif go == self.go_table.aorbtn_all then
        self:ChangeListType(_G.CardElementType.None)
    end
end

return CardChooseView
