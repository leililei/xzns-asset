function CardSkillPreview:FreshSkill()
    self.go_table.aorrawimage_skill:LoadImage(
        self.cfg.skills_display_picture[self.nowIndex],
        function()
            if not _G.IsNil(self) then
                self.go_table.aorrawimage_skill:SetNativeSize()
            end
        end
    )
    self.go_table.aortext_skillDes.text = _G.LangUtil.GetLangPackValue(self.cfg.skills_display_2[self.nowIndex]) 
    self.go_table.aortext_skillName.text = _G.LangUtil.GetLangPackValue(self.cfg.skills_display_1[self.nowIndex]) 
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_skillDes.rectTransform)
    self:ShowArrow()
    for i = 1, 4 do 
        self.go_table["aorimage_dot" .. i]:SetActiveE(i > self.maxIndex and 0 or 1)
        self.go_table["aorimage_dotShow" .. i]:SetActiveE(i == self.nowIndex and 1 or 0)
    end
    -- if self.nowIndex == self.maxIndex then 
    --     self.canGet = true 
    -- end
end
function CardSkillPreview:ShowArrow()
    self.go_table.aorbtn_left:SetActiveE(self.nowIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.nowIndex ~= self.maxIndex and 1 or 0)
end
---点击奖励
function CardSkillPreview:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function CardSkillPreview:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Get then
        -- if self.actTypeCls.isGet then 
        --     _G.PopWindowManager:GetInstance():ShowAllTips(tipsid, "不可再次领取")
        -- elseif self.canGet then 
        --     self.actTypeCls:GetCard(_G.handler(self, self.GetCardCall))
        -- else 
        --     _G.PopWindowManager:GetInstance():ShowAllTips(tipsid, "查看所有技能后可免费试用角色2天")
        -- end
    elseif go == self.go_table.aorbtn_close then 
        self:Close()
    elseif go == self.go_table.aorbtn_left then 
        self.nowIndex = self.nowIndex - 1
        self.nowIndex = self.nowIndex > 0 and self.nowIndex or 1
        self:FreshSkill()
    elseif go == self.go_table.aorbtn_right then 
        self.nowIndex = self.nowIndex + 1
        self.nowIndex = self.nowIndex < self.maxIndex and self.nowIndex or self.maxIndex
        self:FreshSkill()
    end
end

---领取卡牌回调
function CardSkillPreview:GetCardCall(cardData)
    self.go_table.aorbtn_Get:SetGray(true)
    --self.actTypeCls:RefreshRedPoint()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, {award = {item = {[1] = {type = {cardData.sid, cardData.uid, 1}}}}})
end

function CardSkillPreview:Dispose()
    --_G.UIUtils.CloseVideo()
end

return CardSkillPreview
