---@class CardPropTipsView : UIBaseView	中文描述
---@field public go_table CardPropTipsView_GoTable GoTable
local CardPropTipsView = _G.BaseClass("CardPropTipsView", _G.UIBaseView)
--_G.CardPropTipsView = CardPropTipsView

local CS = _G.CS
local typeof = _G.typeof

function CardPropTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_TipsClose"] = self.CloseTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---@class params_CardPropTipsView Data

---界面的入口函数
------@param CardData CardData
function CardPropTipsView:OnCreate(CardData)
    ---@type ItemCardAllView
    self.lua_ItemCardAllView = require("ItemCardAllView").New(self.go_table.obj_CardItem)
    self.lua_ItemCardAllView:ShowCardData(CardData)

    self.go_table.aorimage_type.SpriteName = require("CardInfoManager").Enum.EquipmentType[CardData.cfg.EquipmentType]
    local power = _G.UIUtils.NumberToUnitStr_CardFightNum(CardData.power, true)
    if _G.AppSetting.IsXzns then--星座用其他的位图字体显示战力，需要改一下文本内容来适配字体需求
        power = string.lower(power)
        if string.contains(power, ".") then
            local num = string.split(power, ".")
            power = num[1] .. "-" .. num[2]--小数点用-显示
        end
    end
    self.go_table.aortext_Power.text = power
    --    _G.LangUtil.GetLangPackValue(90020200032) .."<color=#76DAF8>" ..  _G.UIUtils.NumberToUnitStr_CardFightNum(CardData.power, true).. "</color>"
    --self.go_table.aortext_Power.color = _G.ColorTools.FormatColorByString("76daf8")
    self.go_table.aortext_rolename.text = _G.LangUtil.GetLangPackValue(CardData.cfg.Name)
    local prop = CardData.NowSumProp
    self:ShowProp(prop)
end
---设置属性
---@param data AttributeClass
function CardPropTipsView:ShowProp(data)
    if not data then
        if _G.AppSetting.DEBUG then
            _G.LogError(" CardPropTipsView:ShowProp 无属性")
        end
        self:Close()
        return
    end
    local iconDic = {
        ["max_hp"] = "ui_js_sm_icon",
        ["atk"] = "ui_js_gj_icon",
        ["def"] = "ui_js_fy_icon",
        ["bre"] = "ui_js_pj_icon",
        ["hit_rate"] = "ui_js_mzl_icon",
        ["avd_rate"] = "ui_js_sbl_icon",
        ["cri_rate"] = "ui_js_bjl_icon",
        ["cri_r_rate"] = "ui_js_kbl_icon",
        ["cri_dmg"] = "ui_js_bjsh_icon",
        ["cri_dmg_r"] = "ui_js_bsjm_icon",
        ["dmg_inc"] = "ui_js_shzj_icon",
        ["psy_d_r"] = "ui_js_wsjm_icon",
        ["mag_d_r"] = "ui_js_fsjm_icon",
        ["all_speed"] = "ui_js_js_icon",
        ["pvp_dmg"] = "ui_js_pvpzs_icon",
        ["pvp_dmg_r"] = "ui_js_pvpjs_icon",
        ["recover_rate"] = "ui_js_zy_icon",
        ["recover_suffer"] = "ui_js_sy_icon",
        ["control_dec"] = "ui_js_rx_icon",
    }
    --- 忽略  (不显示)
    local ignore = {
        ---雷伤增加
        [_G.AttrType.thd_dmg.key] = true,
        ---雷伤减免
        [_G.AttrType.thd_d_r.key] = true,
        ---风伤增加
        [_G.AttrType.air_dmg.key] = true,
        ---风伤减免
        [_G.AttrType.air_d_r.key] = true,
        ---水伤增加
        [_G.AttrType.water_dmg.key] = true,
        ---水伤减免
        [_G.AttrType.water_d_r.key] = true,
        ---火伤增加
        [_G.AttrType.fire_dmg.key] = true,
        ---火伤减免
        [_G.AttrType.fire_d_r.key] = true,
        ---土伤增加
        [_G.AttrType.earth_dmg.key] = true,
        ---土伤减免
        [_G.AttrType.earth_d_r.key] = true
    }
    -- local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    -- if ChildCount > 0 then
    --     for i = 1, ChildCount do
    --         _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
    --     end
    -- end
    -- ChildCount = self.go_table.obj_Prop2Content:GetChildCountE()
    -- if ChildCount > 0 then
    --     for i = 1, ChildCount do
    --         _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_Prop2Content:GetChildE(0), _G.ePoolType.UIItem)
    --     end
    -- end
    local prop = data:GetAttrByName()
    local showlist = {}
    for i, v in pairs(prop) do
        -- if v > 0 then
        if _G.AttrType[i] then
            table.insert(
                showlist,
                {
                    key = i,
                    ID = _G.AttrType[i].ID,
                    sortid = _G.AttrType[i].sortid,
                    proptype = _G.AttrType[i].proptype,
                    icon = iconDic[i],
                    des = _G.AttrType[i].des,
                    percentage = _G.AttrType[i].percentage
                }
            )
        end

        -- end
    end
    SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )

    for _, v in pairs(showlist) do
        local key = v.key
        if ignore[key] == nil then
            local parent
            if v.proptype == 1 then
                parent = self.go_table.obj_PropContent
            else
                parent = self.go_table.obj_Prop2Content
            end
            if parent ~= nil then
                local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, parent)
                if tran then
                    local tb = _G.GetAutoGoTable(tran)
                    --tb.aorrawimage_icon:LoadImage(v.icon)
                    if v.icon then
                        tb.aorimage_icon:SetActiveE(1)
                        tb.aorimage_icon.SpriteName = v.icon
                    else
                        tb.aorimage_icon:SetActiveE(0)
                    end
                    tb.aortext_Name.text = v.des
                    tb.aorbtn_Click.onClick:AddListener(
                        _G.handlerbind(self, self.OnClickPropDetail, tb.aorbtn_Click, v.ID)
                    )
                    local num = prop[key]
                    if v.percentage == 1 then
                        num = num * 100
                        num = Mathf.RoundToInt(num)
                        num = tostring(num) .. "%"
                        tb.aortext_Num.text = num
                    else
                        tb.aortext_Num.text = tostring(num)
                    end
                end
            end
        end
    end
end

function CardPropTipsView:CloseView()
    self:Close()
end

function CardPropTipsView:CloseTips()
    self.go_table.aorbtn_TipsClose:SetActiveE(0)
    self.go_table.obj_TipsBg:SetActiveE(0)
end

function CardPropTipsView:OnClickPropDetail(go, sid)
    self.go_table.aorbtn_TipsClose:SetActiveE(1)
    self.go_table.obj_TipsBg:SetActiveE(1)
    local x, y, z = go:GetPosition()
    self.go_table.obj_TipsBg:SetPosition(x, y - 0.6, z)
    self.go_table.aortext_Tips.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[sid].desc)
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.aortext_Tips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    )
end

---按钮点击事件在这里派发
function CardPropTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return CardPropTipsView
