---@class CardPotentialView : UIBaseView    通用卡牌选择
---@field public go_table CardPotentialView_GoTable GoTable
local CardPotentialView = _G.BaseClass("CardPotentialView", _G.UIBaseView)
local CardPotentialModel = require("CardPotentialModel")

function CardPotentialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemType = {
        self.go_table.obj_itemSmall,
        self.go_table.obj_itemMid,
        self.go_table.obj_itemBig
    }
end

---界面的入口函数
---@param CardData CardData 卡牌数据
function CardPotentialView:OnCreate(CardData, cardBagLua, isPreviewCardShow)
    self.isPreviewCardShow = isPreviewCardShow
    self.CardData = CardData
    self.cardBagLua = cardBagLua
    self.potentialCfgs = CardPotentialModel:GetInstance().potentialCfgs
    self.AttrItems = {
        self.go_table.aortext_attrName1,
        self.go_table.aortext_attrName2
    }
    self.ConsumeItems = {}
    self.itemBol = false
    self.starBol = false
    self.befBol = false
    -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CardPotentialView_bg_loop, self.go_table.gameObject)

    self:FreshData()
    self:CreateNode()

    self.Page = 1
    -- if self.nowNodeNum > 0 then
    --     self.Page = math.ceil((self.nowNodeNum + 1) / 5)
    --     if self.Page > 4 then
    --         self.Page = 4
    --     end
    --     self.go_table.obj_itemParent:SetAnchorPosition(0, (self.Page - 1) * 719.5, 0)
    -- -- self.go_table.aortext_scrollLv.text = _G.GetLangPackValue(90000011748, self.Page)
    -- end

    _G.SetEventTrigger(
            self.go_table.aorbtn_scroll,
            "onDragEnd",
            function(s, event)
                if self.Moveing then
                    return
                end
                local epy = event.position.y

                if epy > self.DragStartPosy then
                    ---向上走，向下翻页
                    self:MovePage(true)
                else
                    ---向下走，向上翻页
                    self:MovePage(false)
                end
            end
    )
    _G.SetEventTrigger(
            self.go_table.aorbtn_scroll,
            "onDragBegin",
            function(s, event)
                if self.Moveing then
                    return
                end
                self.DragStartPosy = event.position.y
            end
    )
    -- self:DoRing()
    -- _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.FreshDetail, self)
    self.roleBgIcon = "ImagesH5/hCardPotential/ui_jsjx_bg1"
    self:InitData()
    self:RefreshUI()
end

function CardPotentialView:MovePage(up)
    if up then
        if self.Page >= 4 then
            return
        end
        self.Page = self.Page + 1
    else
        if self.Page <= 1 then
            return
        end
        self.Page = self.Page - 1
    end
    self.Moveing = true
    local my = 719.5 * (self.Page - 1)
    self.go_table.obj_itemParent:DOLocalMoveY(my, 0.3):OnComplete(
            function()
                -- self.go_table.aortext_scrollLv.text = _G.GetLangPackValue(90000011748, self.Page)
                self:DoRing()
            end
    )
end

function CardPotentialView:FreshData()
    self.needElementCardList = {}
    self.nowNodeNum = CardPotentialModel:GetInstance():GetIndexBySid(self.CardData:GetPotential())
    self.go_table.aorbtn_reset:SetActiveE(self.nowNodeNum > 0 and 1 or 0)
    if self.isPreviewCardShow then
        self.go_table.aorbtn_reset:SetActiveE(0)
    end
end

function CardPotentialView:CreateNode()
    ---@type CardPotentialView._obj_itemBase1_GoTable[]
    self.node = {}
    self:UpdateAllNode()
    if self.nowNodeNum > 0 then
        local x, y, z = self.node[self.nowNodeNum].gameObject:GetAnchorPosition()
        y = math.abs(y)
        self.go_table.obj_itemParent:SetAnchorPosition(0, y, 0)
    end
    --计算当前点位，显示到这个点位

    -- local x, y, z = self.node[temp].gameObject:GetLocalPosition()
    -- local x1, y1, z1 = self.go_table.obj_itemParent:GetLocalPosition()
    -- local y2 = -y - 320
    -- y2 = y2 > 0 and y2 or 0
    -- self.go_table.obj_itemParent:SetLocalPosition(x1, y2, z1)
end

function CardPotentialView:InitData()
    self.checkId = 0
    local params = _G.ConfigManager.discrete_cfg[100507]
    for _, v in pairs(params) do
        if v[1] == self.needItemSid then
            self.checkId = v[2]
        end
    end
end

function CardPotentialView:GetMovePosY(num)
    local x, y, z
    if self.node[num - 1] == nil then
        x, y, z = self.go_table.obj_itemParent:GetAnchorPosition()
    else
        x, y, z = self.node[num - 1].gameObject:GetAnchorPosition()
    end
    y = math.abs(y)

    return y
end

function CardPotentialView:RefreshUI()
    local loadpath = self.roleBgIcon
    if self.CardData:GetIsCoreRole() then
        loadpath = self.CardData.cfg.potential_bg
    end
    self.go_table.aorrawimage_roleBg:LoadImage(loadpath)
end

function CardPotentialView:UpdateAllNode()
    local count = _G.table.count(self.potentialCfgs)
    for i = 1, count do
        self:FreshNode(i)
    end
    local temp = self.nowNodeNum >= count and count or (self.nowNodeNum + 1)
    self:ClickNode(nil, nil, temp)
end

function CardPotentialView:DoRing()
    local st = (self.Page - 1) * 5 + 1
    local en = (self.Page) * 5
    self.RingIndex = st
    self.RingMax = en
    self:DoAllRing()
end

function CardPotentialView:DoAllRing()
    local node = self.node[self.RingIndex]
    if node then
        local anim = node.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        anim:Play("a_@_obj_ScrollView")
        self.DoRingDelay = _G.DelayDo(
                0.06,
                function()
                    node.obj_ring:SetActiveE(0)
                    node.obj_ring:SetActiveE(1)
                    self.DoRingDelay = nil
                    self.RingIndex = self.RingIndex + 1
                    if self.RingIndex <= self.RingMax then
                        self:DoAllRing()
                    else
                        self.Moveing = false
                    end
                end
        )
    end
end

--刷新点位显示
function CardPotentialView:FreshNode(i)
    ---@type card_potential_cfg
    local cfg = self.potentialCfgs[i]
    if not self.node[i] then
        self.node[i] = self.go_table["obj_itemBase" .. i]
        self.node[i] = _G.GetAutoGoTable(self.node[i])
        ---@type CardPotentialView._obj_itemSmall_GoTable
        local obj = _G.InstantiateObject(self.itemType[cfg.type], self.node[i].obj_item)
        obj:SetActiveE(1)
        self.node[i].itemTb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickNode, i))
    end
    local isunlock = i <= self.nowNodeNum
    --self.node[i].aorimage_line.SpriteName = i <= self.nowNodeNum and "ui_jsjx_jx_jingdu1" or "ui_jsjx_jx_jingdu2"
    self.node[i].aorimage_line.SpriteName = "ui_jsjx_jd4"
    self.node[i].aorimage_line:SetGray(not isunlock)
    ---@type CardPotentialView._obj_itemBig_GoTable|CardPotentialView._obj_itemMid_GoTable|CardPotentialView._obj_itemSmall_GoTable
    local tb = self.node[i].itemTb
    tb.gameObject:SetLocalPositionToZero()
    tb.aorimage_select:SetActiveE(self.nowChooseIndex == i and 1 or 0)
    --tb.aorimage_active:SetActiveE(i <= self.nowNodeNum and 1 or 0)
    tb.aorimage_active:SetActiveE(0)
    tb.aorimage_new:SetActiveE(i == self.nowNodeNum + 1 and 1 or 0)
    --tb.aorimage_mask:SetActiveE(i > self.nowNodeNum + 1 and 1 or 0)
    tb.aorimage_mask:SetActiveE(0)
    --local isgray = i > self.nowNodeNum + 1
    tb.aorimage_bg:SetGray(not isunlock)

    if cfg.type == 3 then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_YXJX_Liuguang, tb.gameObject)
    end

    _G.GameUtil.SetActiveByCondition(tb.obj_effect, isunlock)
    if isunlock then
        if nil == tb.loopeff then
            tb.loopeff = 1

            local effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_Loop1
            if cfg.type == 1 then
                effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_Loop3
                tb.aorimage_bg.SpriteName = "ui_jsjx_jiedian_jihuo"
            elseif cfg.type == 2 then
                effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_Loop2
            elseif cfg.type == 3 then
                effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_Loop1
            end

            _G.UIUtils.LoadEffectByCfg(effCfg, tb.obj_effect)
        end
    end
    -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CardPotentialView_ring, self.node[i].obj_ring)
    if cfg.type == 3 then
        local attSid = CardPotentialModel:GetInstance():GetAttributeSid(self.CardData.sid, cfg.id)
        local attCfg = _G.ConfigManager.attribute_cfg[attSid]
        if attCfg and attCfg.skill ~= 0 then
            local skillCfg = _G.ConfigManager.card_skills_cfg[attCfg.skill]
            tb.aorrawimage_icon:LoadImage(skillCfg.icon)
        end
    end
    if tb.aorrawimage_icon then
        tb.aorrawimage_icon:SetGray(not isunlock)
    end
    if tb.aorimage_icon then
        tb.aorimage_icon:SetGray(not isunlock)
    end
end

function CardPotentialView:ClickNode(go, isOn, index)
    if self.nowChooseIndex == index then
        return
    end
    if self.nowChooseIndex then
        self.node[self.nowChooseIndex].itemTb.aorimage_select:SetActiveE(0)
    end
    self.nowChooseIndex = index
    self.node[index].itemTb.aorimage_select:SetActiveE(1)
    -- if not self.node[index].chooseload then
    --     self.node[index].chooseload = 1
    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_CardPotentialView_cheng,
    --     self.node[index].obj_choose
    -- )
    -- end
    self:FreshDetail(index)
end

--刷新右边详情
function CardPotentialView:FreshDetail(index)
    -- self.go_table.aortext_Lv.text = index

    ---@type card_potential_cfg
    local cfg = self.potentialCfgs[self.nowChooseIndex]
    self.starBol = self.CardData.star >= cfg.condition_star
    local attSid = CardPotentialModel:GetInstance():GetAttributeSid(self.CardData.sid, cfg.id)
    local attCfg = _G.ConfigManager.attribute_cfg[attSid]
    local caiStar = _G.ConfigManager.discrete_cfg[120001][1][1]
    local starStr = self.starBol and self.CardData.star - caiStar or "<color=#e33f3f>" .. self.CardData.star - caiStar .. "</color>"
    self.go_table.aortext_condition.text = _G.GetLangPackValue(90020800003, cfg.condition_star - caiStar, starStr, cfg.condition_star - caiStar)
    self.go_table.aortext_name.text = _G.GetLangPackValue(attCfg.name)
    self.befBol = CardPotentialModel:GetInstance():CheckBeforUnlock(self.CardData.potential, cfg.bef_id)

    local attData, isSkill
    if self.nowChooseIndex > 1 then
        local preCfg = self.potentialCfgs[self.nowChooseIndex - 1]
        local preAttSid = CardPotentialModel:GetInstance():GetAttributeSid(self.CardData.sid, preCfg.id)
        local _data
        isSkill, _data = _G.AttributeClassManager:GetInstance().CalAddedAttribute2(attSid, preAttSid)
        attData = isSkill and {} or _data
    else
        attData = attCfg.attribute
        isSkill = attCfg.skill > 0
    end

    for i = 1, #self.AttrItems do
        local tt = self.AttrItems[i]
        if i > #attData then
            tt:SetActiveE(0)
        else
            local data = attData[i]
            local attrKey = data[1]
            local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrKey].ID].name)
            local attrType = _G.tonumber(data[2])
            -- local attrValue = _G.tonumber(data[3])
            local attrValue = _G.tonumber(data.maxAttr)
            local attrOldValue = _G.tonumber(data.minAttr)

            if attrType == 1 then
                if _G.AttrType[attrKey].percentage == 1 then
                    self.go_table["aortext_attrValue" .. i].text = "+" .. attrValue / 100 .. "%"
                    if attrOldValue == 0 then
                        self.go_table["aortext_value" .. i].text = attrOldValue
                    else
                        self.go_table["aortext_value" .. i].text = attrOldValue / 100 .. "%"
                    end
                else
                    self.go_table["aortext_attrValue" .. i].text = "+" .. attrValue
                    self.go_table["aortext_value" .. i].text = attrOldValue
                end
            else
                self.go_table["aortext_attrValue" .. i].text = "+" .. attrValue / 100 .. "%"
                if attrOldValue == 0 then
                    self.go_table["aortext_value" .. i].text = attrOldValue
                else
                    self.go_table["aortext_value" .. i].text = attrOldValue / 100 .. "%"
                end
            end

            tt:SetActiveE(1)

            tt.text = attrName
        end
    end

    self.go_table.obj_skill:SetActiveE(isSkill and 1 or 0)
    self.go_table.obj_attribute:SetActiveE(isSkill and 0 or 1)

    if isSkill then
        local skillCfg = _G.ConfigManager.card_skills_cfg[attCfg.skill]
        if not self.skillDes then
            self.skillDes = self.go_table.obj_skillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
            self.skillDes.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
        end
        self.skillDes.text = _G.GetLangPackValue(skillCfg.describe1)
    end

    local nextIndex = self.nowNodeNum + 1
    self.go_table.obj_skill:SetLocalPosition(0, 74, 0)
    self.go_table.obj_hasActive:SetActiveE(self.nowChooseIndex < nextIndex and 1 or 0)
    self.go_table.obj_needPre:SetActiveE(self.nowChooseIndex > nextIndex and 1 or 0)
    self.go_table.obj_canActive:SetActiveE(self.nowChooseIndex == nextIndex and 1 or 0)
    self.go_table.obj_itemLis:SetActiveE(self.nowChooseIndex >= nextIndex and 1 or 0)
    self.itemBol = false
    self.needItemSid = nil
    if self.nowChooseIndex >= nextIndex then
        local haveNum = CardPotentialModel:GetInstance():GetSelfDogFoodNum(
                self.CardData.sid,
                self.CardData.uid,
                cfg.materials_oneself[1]
        )
        local mat = CardPotentialModel:GetInstance():GetMaterial(cfg.id)
        local needCardNum = _G.table.isEmptyOrNil(mat.materials_oneself) and 0 or mat.materials_oneself[2]
        local haveCardNumExceedOne = needCardNum > 0 and 1 or 0
        local needElementNum = 0
        if _G.AppSetting.IsXzns then
            needElementNum = _G.table.isEmptyOrNil(mat.materials_elements) and 0 or mat.materials_elements[2]
            local propCards = {}
            local propCount = 0
            local element = self.CardData:GetElement()
            local sid, count, data
            for _, v in pairs(_G.ConfigManager.item_card_cfg) do
                sid = v.id
                if v.Elements == _G.CardElementType.Common or v.Elements == element then
                    count = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
                    if count > 0 then
                        data = require("PropCardData").New()
                        data:Parse({ sid = sid, uid = sid, num = count })
                        propCards[sid] = data
                        propCount = propCount + 1
                    end
                end
            end
            if propCount > 0 then
                local sortedPropCards = _G.table.toArray(propCards)
                _G.SortList(
                        sortedPropCards,
                        function(CardData)
                            return -(CardData:GetElement() % 7)
                        end
                )
                local selectCount = 0
                for _, v in pairs(self.needElementCardList) do
                    selectCount = selectCount + 1
                end
                self.materialDic = {}
                --- XZNS-5692觉醒界面当界面需要狗粮解锁时，取消节点的狗粮自动填充
                -- for _, v in ipairs(sortedPropCards) do
                --     if selectCount < needElementNum then
                --         local tempData = require("PropCardData").New()
                --         local newUid = v.uid
                --         if v.uid < 0 then
                --             newUid = -(v.uid) // 100
                --         end
                --         tempData:Parse({sid = v.sid, uid = newUid, num = 1})
                --         selectCount = selectCount + 1
                --         self.needElementCardList[selectCount] = tempData
                --         self.materialDic[selectCount] = selectCount
                --     end
                -- end
            end
        end
        local needPropNum = #mat.material
        self.itemBol = (haveNum >= needCardNum)
        for i = 1, haveCardNumExceedOne + needPropNum + needElementNum do
            local tb = self:GetOrAddMatItem(i)
            tb.obj_itemRoot:ClearChildren()
            --本体材料
            if i <= haveCardNumExceedOne then
                local color = (haveNum >= needCardNum) and "<color=#351B0A>" or "<color=#e33f3f>"
                tb.aortext_item.text = color .. haveNum .. "</color>/" .. needCardNum
                _G.StorageManager:GetInstance():GetItemBaseView(
                        self.CardData.sid,
                        1,
                        tb.obj_itemRoot,
                        nil,
                        function(go)
                        end,
                        { mat.materials_oneself[1] }
                )
            elseif i <= haveCardNumExceedOne + needElementNum then
                -- 星座，增加同五行卡牌消耗
                tb.obj_consume:SetActiveE(1)
                local consume = _G.GetAutoGoTable(tb.obj_consume, _G.handlerbind(self, self.SelectElementCard, mat))
                local cardData = self.needElementCardList[i - haveCardNumExceedOne]
                if cardData then
                    tb.aortext_item.text = "<color=#351B0A>" .. 1 .. "</color>/" .. 1
                    consume.aorimage_colorBg.SpriteName = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(cardData.star, cardData.order)
                    consume.aorimage_icon.SpriteName = cardData.cfg.Icon
                else
                    self.itemBol = false
                    tb.aortext_item.text = "<color=#e33f3f>" .. 0 .. "</color>/" .. 1
                    consume.aorimage_colorBg.SpriteName = "ui_js_txk_cheng"
                    consume.aorimage_icon.SpriteName = "0ui_jsxt_sx_icon5"
                end
            else
                local sid = mat.material[i - haveCardNumExceedOne - needElementNum][1]
                local num = mat.material[i - haveCardNumExceedOne - needElementNum][2]
                local haveNum = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
                self.itemBol = self.itemBol and (haveNum >= num)
                if not self.itemBol and (haveNum < num) then
                    self.needItemSid = sid
                    self:InitData()
                end
                local color = (haveNum >= num) and "<color=#351B0A>" or "<color=#e33f3f>"
                tb.aortext_item.text = color .. haveNum .. "</color>/" .. num
                _G.StorageManager:GetInstance():GetItemBaseView(
                        sid,
                        num,
                        tb.obj_itemRoot,
                        nil,
                        function(go)
                            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
                        end
                )
            end
        end
        local activeCount = haveCardNumExceedOne + needElementNum + needPropNum
        for i = 1, #self.ConsumeItems do
            self.ConsumeItems[i].gameObject:SetActiveE(i <= activeCount and 1 or 0)
        end
    end
end

function CardPotentialView:SelectElementCard(_, _, mat)
    local ignoreUids = {}
    if not _G.table.isEmptyOrNil(mat.materials_oneself) then
        local cards = _G.StorageManager:GetInstance():GetWeakestCardsBySidStar(
                self.CardData.sid,
                mat.materials_oneself[1],
                mat.materials_oneself[2],
                { self.CardData.uid }
        )
        if cards then
            for i = 1, #cards do
                _G.table.insert(ignoreUids, cards[i].uid)
            end
        end
    end
    local selectList = {}
    for _, v in pairs(self.needElementCardList) do
        _G.table.insert(selectList, v)
    end
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardChooseView.Name,
            self.CardData,
            mat.materials_elements[2],
            selectList,
            ignoreUids,
            _G.handler(self, self.SelectElementCardCall)
    )
end

function CardPotentialView:SelectElementCardCall(selectCards)
    self.needElementCardList = selectCards
    self:FreshDetail()
end

---@return CardPotentialView._obj_item_GoTable
function CardPotentialView:GetOrAddMatItem(index)
    if self.ConsumeItems[index] == nil then
        local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_itemLis)
        obj:SetActiveE(1)
        self.ConsumeItems[index] = _G.GetAutoGoTable(obj)
    end
    return self.ConsumeItems[index]
end

---按钮点击事件在这里派发
function CardPotentialView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        self:OnClickSure()
    elseif go == self.go_table.aorbtn_reset then
        if self.nowNodeNum == 0 then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CardPotentialResetTipView.Name,
                self.CardData,
                function()
                    self:FreshData()
                    self:UpdateAllNode()
                    self.go_table.obj_itemParent:DOLocalMoveY(654, 0.5)
                    if self.CardData:IsSp() and self.cardBagLua then
                        self.cardBagLua:Skill()
                    end
                end
        )
    elseif go == self.go_table.aorbtn_attrhelp then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PotentialTipsView.Name, self.CardData)
    end
end

function CardPotentialView:OnClickSure()
    ---@type card_potential_cfg
    local cfg = self.potentialCfgs[self.nowChooseIndex]
    local mat = CardPotentialModel:GetInstance():GetMaterial(cfg.id)
    if not self.befBol then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(1000107)
        return
    end
    if not self.itemBol then
        if self.needItemSid then
            local _, storageID = _G.StorageManager:GetInstance():CheckSidType(self.needItemSid)
            self.data = _G.StorageManager:GetInstance():GetItemDataByID(storageID, self.needItemSid)
            if table.isEmptyOrNil(self.data) then
                self.data = _G.StorageManager:GetInstance():GetItemDataClass(self.needItemSid, 0)
                self.data:Parse({ sid = self.needItemSid, num = 0 })
            end

            --激活觉醒时检测是否快捷使用道具
            if _G.StorageManager:GetInstance():CheckItem(self.checkId, 1) then
                local itemData = _G.StorageManager:GetInstance():GetItemDataByIDEx(self.checkId)
                if itemData then
                    local num = _G.table.find(mat.material, function(item)
                        return item[1] == self.needItemSid
                    end)[2] - _G.StorageManager:GetInstance():GetItemCountBySid(self.needItemSid)
                    _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.BagChoosePropTipView.Name,
                            itemData,
                            _G.handlerbind(self, self.FreshDetail),
                            {
                                sid = self.needItemSid,
                                num = num
                            }
                    )
                    return
                end
            end

            if self.data.cfg and self.data.cfg.way then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.needItemSid)
                return
            end
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(1100101)
        return
    end
    if not self.starBol then
        _G.PopWindowManager:GetInstance():ShowAllTips(1100102)
        return
    end
    local uids = {}
    local info = {}
    if not _G.table.isEmptyOrNil(mat.materials_oneself) then
        local cards = _G.StorageManager:GetInstance():GetWeakestCardsBySidStar(
                self.CardData.sid,
                mat.materials_oneself[1],
                mat.materials_oneself[2],
                { self.CardData.uid }
        )
        if cards then
            for i = 1, #cards do
                table.insert(uids, cards[i].uid)
            end
        end
    end
    if _G.AppSetting.IsXzns then
        if mat.materials_elements and not _G.table.isEmptyOrNil(mat.materials_elements) then
            if mat.materials_elements[2] == #self.needElementCardList then
                for k, v in pairs(self.needElementCardList) do
                    _G.table.insert(uids, v.uid)
                    _G.table.insert(info, { type = { v.sid, 1, v.star } })
                end
            end
        end
    end
    CardPotentialModel:GetInstance():PotentialUp(
            self.CardData,
            cfg.id,
            uids,
            function()
                self.go_table.aorbtn_sure.enabled = false
                local temp = self.nowChooseIndex
                self.nowChooseIndex = nil
                if _G.AppSetting.IsXzns and not _G.table.isEmptyOrNil(uids) then
                    --星座可能消耗材料卡，需要做一下消耗
                    for _, v in pairs(uids) do
                        local itemCfg = _G.ConfigManager.item_cfg[v]
                        if itemCfg then
                            _G.StorageManager:GetInstance():ConsumeItem(v, v, 1)
                        end
                    end
                    if _G.table.isEmptyOrNil(self.CardData.awaken_cards) then
                        self.CardData.awaken_cards = {}
                    end
                    for _, v in pairs(info) do
                        local isUsed = false
                        for _, v2 in pairs(self.CardData.awaken_cards) do
                            if v.type[1] == v2.type[1] then
                                isUsed = true
                                v2.type[2] = v2.type[2] + v.type[2]
                            end
                        end
                        if not isUsed then
                            _G.table.insert(self.CardData.awaken_cards, v)
                        end
                    end
                end
                local tb = self.node[temp].itemTb
                local effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_jihuo1
                if cfg.type == 1 then
                    effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_jihuo3
                    tb.aorimage_bg.SpriteName = "ui_jsjx_jiedian_jihuo"
                elseif cfg.type == 2 then
                    effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_jihuo2
                elseif cfg.type == 3 then
                    effCfg = _G.ConfigManager.ui_effect_cfg.ef_YXJX_jihuo1
                end
                tb.obj_effect:SetActiveE(1)
                _G.UIUtils.LoadEffectByCfg(
                        effCfg,
                        tb.obj_effect,
                        nil,
                        function()
                            self:FreshData()
                            self:FreshNode(temp)
                            if temp < #self.potentialCfgs then
                                self:FreshNode(temp + 1)
                                self:ClickNode(nil, nil, temp + 1)
                            else
                                self:ClickNode(nil, nil, temp)
                            end
                            _G.UIManager:GetInstance():OpenWindow(
                                    _G.ConfigManager.ui_cfg.CardPotentialActiveView.Name,
                                    self.CardData,
                                    cfg,
                                    function()
                                        if self:IsNil() then
                                            return
                                        end
                                        if temp < #self.potentialCfgs then
                                            --local x, y, z = self.node[self.nowNodeNum + 1].gameObject:GetLocalPosition()
                                            ---- local x1, y1, z1 = self.go_table.obj_itemParent:GetAnchorPosition()
                                            --local w, h = self.go_table.obj_ScrollView:GetRectTransformSize()
                                            ---- 386 = -286+654， 654是滑动窗口的高，滑动窗口锚点是底部，这里需要加上一个高654
                                            --local targetY = -y + 286 - h
                                            --if targetY > -h then
                                            --    targetY = -h
                                            --end
                                            --self.go_table.obj_itemParent:DOLocalMoveY(((self.nowNodeNum + 1) * 150), 0.5)
                                            self.go_table.obj_itemParent:DOLocalMoveY(self:GetMovePosY(self.nowNodeNum), 0.5)
                                            -- if y + y1 > 268 then -- 偏移值，268是点位y距离滑动窗底部的距离，y1为负数，大于这个值表示点位在画面上方甚至超出画面
                                            -- self.go_table.obj_itemParent:SetAnchorPosition(0, 268 - y, 0)
                                            -- end
                                        end
                                    end
                            )
                            self.go_table.aorbtn_sure.enabled = true
                        end
                )
                if self.CardData:IsSp() and self.cardBagLua then
                    self.cardBagLua:Skill()
                end
            end
    )
end

function CardPotentialView:OnHrefClick(id, name, asa)
    -- local weight, height = self.rect:GetRectTransformWidthHeight()
    local weight, height = 0, 0
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

function CardPotentialView:OnDestroy()
    if self.DoRingDelay then
        _G.coroutine.stopwaiting(self.DoRingDelay)
        self.DoRingDelay = nil
    end
    if self.isPreviewCardShow then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.PreviewCardShowView.Name)
    end
    -- _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.FreshDetail, self)
end

return CardPotentialView
