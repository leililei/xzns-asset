local CardPotentialModel = require("CardPotentialModel")

---@class CardPotentialActiveView : UIBaseView	中文描述
---@field public go_table CardPotentialActiveView_GoTable GoTable
local CardPotentialActiveView = _G.BaseClass("CardPotentialActiveView", _G.UIBaseView)

function CardPotentialActiveView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param cfg card_potential_cfg
function CardPotentialActiveView:OnCreate(cardData, cfg, call)
    self.call = call
    self:InitView(cardData, cfg)
    self:LoadEffect()
end

function CardPotentialActiveView:InitView(cardData, cfg)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CardPotentialActiveView, self.go_table)
    local attSid = CardPotentialModel:GetInstance():GetAttributeSid(cardData.sid, cfg.id)
    local attCfg = _G.ConfigManager.attribute_cfg[attSid]
    if attCfg == nil then
        return
    end
    local potentialCfgs = CardPotentialModel:GetInstance().potentialCfgs
    local index = CardPotentialModel:GetInstance():GetIndexBySid(cfg.id)
    local attData, isSkill
    if index > 1 then
        local preCfg = potentialCfgs[index - 1]
        local preAttSid = CardPotentialModel:GetInstance():GetAttributeSid(cardData.sid, preCfg.id)
        local _data
        isSkill, _data = _G.AttributeClassManager:GetInstance().CalAddedAttribute2(attSid, preAttSid)
        attData = isSkill and {} or _data
    else
        attData = attCfg.attribute
        isSkill = attCfg.skill > 0
    end
    self.go_table.aortext_title.text = _G.GetLangPackValue(isSkill and 90020800013 or 90020800012)
    self.go_table.obj_attribute:SetActiveE(isSkill and 0 or 1)
    self.go_table.obj_skill:SetActiveE(isSkill and 1 or 0)
    if isSkill then
        if attCfg.skill == 0 then
            return
        end
        ---@type card_skills_cfg
        local skillCfg = _G.ConfigManager.card_skills_cfg[attCfg.skill]
        self.go_table.aorrawimage_icon:LoadImage(skillCfg.icon)
        self.go_table.aortext_name.text = _G.GetLangPackValue(skillCfg.name1)

        self.go_table.obj_skillDes:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = _G.GetLangPackValue(skillCfg.describe1)
    else
        local obj, tb
        for i = 1, #attData do
            local data = attData[i]
            obj = _G.InstantiateObject(self.go_table.obj_attrItem, self.go_table.obj_attrs)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            local attrKey = data[1]
            local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrKey].ID].name)
            local attrType = _G.tonumber(data[2])
            -- local attrValue = _G.tonumber(data[3])

            local attrValue = _G.tonumber(data.maxAttr)
            local attrOldValue = _G.tonumber(data.minAttr)

            -- if attrType == 1 then
            --     if _G.AttrType[attrKey].percentage == 1 then
            --         tb.aortext_value.text = "+" .. attrValue / 100 .. "%"
            --     else
            --         tb.aortext_value.text = "+" .. attrValue
            --     end
            -- else
            --     tb.aortext_value.text = "+" .. attrValue / 100 .. "%"
            -- end

            if attrType == 1 then
                if _G.AttrType[attrKey].percentage == 1 then
                    tb.aortext_value.text = "+" .. attrValue / 100 .. "%"
                    if attrOldValue == 0 then
                        tb.aortext_attrValue.text = attrOldValue
                    else
                        tb.aortext_attrValue.text = attrOldValue / 100 .. "%"
                    end
                else
                    tb.aortext_value.text = "+" .. attrValue
                    tb.aortext_attrValue.text = attrOldValue
                end
            else
                tb.aortext_value.text = "+" .. attrValue / 100 .. "%"
                if attrOldValue == 0 then
                    tb.aortext_attrValue.text = attrOldValue
                else
                    tb.aortext_attrValue.text = attrOldValue / 100 .. "%"
                end
            end

            tb.aortext_name.text = attrName

        end
    end
end

---按钮点击事件在这里派发
function CardPotentialActiveView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if self.call then
            self.call()
        end
        self:Close()
    end
end

function CardPotentialActiveView:LoadEffect()
    if not _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ShowAwardVBGShengLI,
            self.go_table.obj_eff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_sunlight,
        self.go_table.obj_effTitle,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function CardPotentialActiveView:OnDestroy()
end

return CardPotentialActiveView
