local CardPotentialModel = require("CardPotentialModel")

---@class CardPotentialResetTipView : UIBaseView	中文描述
---@field public go_table CardPotentialResetTipView_GoTable GoTable
local CardPotentialResetTipView = _G.BaseClass("CardPotentialResetTipView", _G.UIBaseView)

function CardPotentialResetTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CardPotentialResetTipView:OnCreate(cardData, call)
    self.CardData = cardData
    self.call = call
    self:InitView()
end

function CardPotentialResetTipView:InitView()
    local cfg = _G.ConfigManager.card_potential_cfg[self.CardData:GetPotential()]
    local needCardNum = _G.table.isEmptyOrNil(cfg.materials_oneself) and 0 or cfg.materials_oneself[2]
    local needPropNum = #cfg.material
    for i = 1, needCardNum do
        --本体材料
        _G.StorageManager:GetInstance():GetItemBaseView(
            self.CardData.sid,
            1,
            self.go_table.obj_items,
            nil,
            function(go)
            end,
            {cfg.materials_oneself[1]}
        )
    end
    if _G.AppSetting.IsXzns then
        if not _G.table.isEmptyOrNil(self.CardData.awaken_cards) then
            local msg
            for _, v in pairs(self.CardData.awaken_cards) do
                for i = 1, v.type[2] do
                    local data = _G.CardData.New()
                    msg = {}
                    msg.sid = v.type[1]
                    msg.star = v.type[3]
                    data:ParseInitMsg(msg)
                    _G.ItemCardFactory:GetInstance():GetItemCard(
                        _G.ItemCardFactory.itemCardType.CardAllItem,
                        self.go_table.obj_items,
                        function(item)
                            item:ShowCardData(data, nil, true, true)
                            item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                        end
                    )
                end
            end
        end
    end
    for i = 1, needPropNum do
        local sid = cfg.material[i][1]
        local num = cfg.material[i][2]
        _G.StorageManager:GetInstance():GetItemBaseView(
            sid,
            num,
            self.go_table.obj_items,
            function(go)
                go.go_table.obj_ItemNum:SetActiveE(1)
            end,
            function(go)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
            end
        )
    end
    local obj, tb
    for _, v in pairs(_G.ConfigManager.discrete_cfg[120002]) do
        obj = _G.InstantiateObject(self.go_table.obj_consumeItem, self.go_table.obj_consume)
        obj:SetActiveE(1)
        tb = _G.GetAutoGoTable(obj)
        tb.aortext_num.text = v[2]
        tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(v[1]))
        if not _G.StorageManager:GetInstance():CheckItem(v[1], v[2]) then
            tb.aortext_num.color = require("CardInfoManager").GetColorFromRGB("e33f3f") 
        end
    end
end

---按钮点击事件在这里派发
function CardPotentialResetTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView2 then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        for _, v in pairs(_G.ConfigManager.discrete_cfg[120002]) do
            if not _G.StorageManager:GetInstance():CheckItemNew(v[1], v[2]) then
                return
            end
        end
        CardPotentialModel:GetInstance():PotentialReset(
            self.CardData,
            function(msg)
                self:Close()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                if not _G.table.isEmptyOrNil(self.CardData.awaken_cards) then
                    self.CardData.awaken_cards = {}
                end
                if self.call then
                    self.call()
                end
            end
        )
    end
end

function CardPotentialResetTipView:OnDestroy()

end

return CardPotentialResetTipView
