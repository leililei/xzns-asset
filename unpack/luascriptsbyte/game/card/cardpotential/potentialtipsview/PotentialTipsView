---@class PotentialTipsView : UIBaseView	通用卡牌选择
---@field public go_table PotentialTipsView_GoTable GoTable
local PotentialTipsView = _G.BaseClass("PotentialTipsView", _G.UIBaseView)
local CardPotentialModel = require("CardPotentialModel")

function PotentialTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PotentialTipsView:OnCreate(CardData)
    self.CardData = CardData
    self.nowIndex = CardPotentialModel:GetInstance():GetIndexBySid(self.CardData:GetPotential())
    self:InitView()
end

function PotentialTipsView:InitView()
    local attTable, skillTable = CardPotentialModel:GetInstance():GetAllAttribute(self.CardData)
    _G.SortList(
        attTable,
        function(a)
            return -_G.AttrType[a[1]].sortid
        end
    )
    ---@type PotentialTipsView._obj_attrItem_GoTable|PotentialTipsView._obj_skillItem_GoTable
    local tb
    local obj, name, value
    self.go_table.obj_attribute:SetActiveE(#attTable > 0 and 1 or 0)
    for i = 1, #attTable do
        obj = _G.InstantiateObject(self.go_table.obj_attrItem, self.go_table.obj_attribute)
        obj:SetActiveE(1)
        tb = _G.GetAutoGoTable(obj)
        name, value = self:GetPropStr(attTable[i])
        tb.aortext_name.text = name
        tb.aortext_value.text = value
        if _G.AttrTypeIcon[attTable[i][1]] then
            tb.aorimage_icon.SpriteName = _G.AttrTypeIcon[attTable[i][1]]
        else
            tb.aorimage_icon:SetActiveE(0)
        end
    end
    ---@type card_skills_cfg
    local skillCfg
    local skillLock
    for i = 1, #skillTable do
        obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.obj_skills)
        obj:SetActiveE(1)
        tb = _G.GetAutoGoTable(obj)
        skillCfg = _G.ConfigManager.card_skills_cfg[skillTable[i][2]]
        tb.aortext_name.text = _G.GetLangPackValue(skillCfg.name1)
        if not tb.skillDes then
            tb.skillDes = tb.obj_skillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
            tb.skillDes.OnHrefClick:AddListener(_G._G.handlerbind(self, self.OnHrefClick, obj))
        end
        tb.skillDes.text = _G.GetLangPackValue(skillCfg.describe1)
        skillLock = skillTable[i][1] > self.nowIndex
        tb.aortext_name.color = require("CardInfoManager").GetColorFromRGB(skillLock and "575757" or "BB3D00")
        tb.skillDes.color = require("CardInfoManager").GetColorFromRGB(skillLock and "1F1F1F" or "351B0A")
        tb.aorimage_bg:SetGray(skillLock)
        tb.obj_lock:SetActiveE(skillLock and 1 or 0)
    end
end

function PotentialTipsView:GetPropStr(attribute)
    if attribute == nil then
        return ""
    end
    local key = attribute[1]
    local num = _G.tonumber(attribute[3])
    local aType = attribute[2] == "1" and _G.AttCountType.other or _G.tonumber(attribute[2])
    num = _G.AttributeClassManager:GetInstance():GetValueWithName(key, num, aType)
    local isPer = attribute[2] == "2" and true or false
    return self:ToPropNum(key, num, isPer)
end

---属性数字转换
---@param key string 属性key
---@param num number 属性值
---@return string 属性值文本
function PotentialTipsView:ToPropNum(key, num, isPer)
    local numStr
    if _G.AttrType[key].percentage == 1 or isPer then
        num = num * 100
        num = _G.GameUtil.FormatNum(num)
        numStr = _G.tostring(num) .. "%"
    else
        num = _G.math.floor(num)
        num = _G.GameUtil.NumberWY(num)
        numStr = _G.tostring(num)
    end
    return _G.AttrType[key].des, numStr
end

---按钮点击事件在这里派发
function PotentialTipsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function PotentialTipsView:OnHrefClick(id, name, obj)
    -- local weight, height = obj:GetRectTransformWidthHeight()
    local weight,height = 0,0
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

function PotentialTipsView:OnDestroy()
end

return PotentialTipsView
