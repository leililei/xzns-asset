local base =  require "CardData"

---@class PropCardData:CardData
---@field cfg item_card_cfg
local PropCardData = _G.BaseClass("PropCardData", base)

function PropCardData:__init()
    self.type = _G.CardType.Prop
end

--region 子类重写
---物品数据解析(类重写数据解析)
---@param msg prop.i_card 数据
function PropCardData:ParseInitMsg(msg)
    self.sid = msg.sid and msg.sid or msg[1]
    self.count = msg.num or 1
    self.lv = msg.lv ~= nil and msg.lv or 1
    self.lv_Old = msg.lv ~= nil and msg.lv or 1
    self.exp = 0
    self.cfg = _G.ConfigManager.item_card_cfg[self.sid]
    --設置營地 id
    self.campid = self.cfg.Elements + 100
    --卡牌的类型（1-人卡，2-灵卡，3-小怪，4-精英，5-boss）
    self.cardType = self.cfg.UnitType
    self.awaken = msg.awaken ~= nil and msg.awaken or 0

    self.Icon = "Images/zRoles/" .. self.cfg.Icon
    self.Grade = self.cfg.Order
    self:CardAwakenChoose()

    self.unlock = msg.unlock ~= nil and msg.unlock or 0
    --- 当前皮肤 默认0原皮
    self.skin = 0
    self.star = self.cfg.Star
    self.uid = msg.uid or self.sid
    self.quality = 1
    --msg.quality_info.quality
    --魂链等级
    self.soulLink_lv = msg.soul_chain_lv or 0
    --魂链 是否激活
    self.soulLink_IsActivate = msg.soul_state or 0

    --天赋
    self.open_inborn = msg.open_inborn or {}
    --天赋点
    self.inborn_num = msg.inborn_num or 0
    --消耗材料获得的天赋点
    self.inborn_cost_num = msg.inborn_cost_num or 0

    local attributeManager = _G.AttributeClassManager:GetInstance()
    --卡牌自身计算后属性
    ---@type AttributeClass
    self.BaseProp = attributeManager:GetAttribtueClass(self.cfg.Elements)
    --卡牌总属性
    ---@type AttributeClass
    self.NowSumProp = attributeManager:GetAttribtueClass(self.cfg.Elements)

    self.maxCount = 11
    --local value, ID = require "CardCommentManager":GetInstance():CardWearSkin(self.sid)
    self.skin = 0
    self.msg = msg
    self.cost_card_list = msg.cost_card_list or {}
end

return PropCardData
