            local eData = self.ExchangeConditionDict[j]
            for i, v in pairs(eData) do
                for start, Num in pairs(v) do
                    curMaxCount = curMaxCount + Num
                end
            end
            if curMaxCount > needCount then
                needCount = curMaxCount
            end
            curMaxCount = 0
        end
    else
        local data = {}
        local order = 0
        local start = 0
        local CurSelectBranch = nil
        local isHasBranch = false --是否已有选中分支

        local ExchangeCondCount = #self.ExchangeConditionDict
        for j = 1, ExchangeCondCount do
            local eData = self.ExchangeConditionDict[j]
            --先判断是否已经满足条件
            for i = 1, count do
                data = cardList[i]
                order = data.cfg.Order
                start = data.star

                --if CurSelectBranch[order] == nil or CurSelectBranch[order][start] == nil then
                if eData[order] and eData[order][start] then
                    isHasBranch = true
                else
                    isHasBranch = false
                    break
                end
            end
            if isHasBranch then
                for order1, star1 in pairs(eData) do
                    for start2, Num in pairs(star1) do
                        curMaxCount = curMaxCount + Num
                    end
                end
                if curMaxCount > needCount then
                    needCount = curMaxCount
                end
                curMaxCount = 0
            end
            isHasBranch = false
        end
    end
    return needCount
end

