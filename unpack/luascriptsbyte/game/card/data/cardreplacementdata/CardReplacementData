local CardReplacementData = _G.BaseClass("CardReplacementData")

---@param order card_cfg .order
function CardReplacementData:__init(tagid,order,cardId,unlockId,ExchangeCondId,tagNameKey,ExchangeDesc)
    self.tagid = tagid
    self.order = order
    self.tagNameKey = tagNameKey
    self.ExchangeDesc = ExchangeDesc

    if ConfigManager.discrete_cfg[cardId] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("discrete_cfg表没有id：" .. cardId)
        end
    end

    ---@type number[]  {{11601000,11602000}}
    self.cardIds = ConfigManager.discrete_cfg[cardId][1]
    ---@type number[number[]]
    local unlockIds = ConfigManager.discrete_cfg[unlockId]--{{50,15},{50,25},{50,35}}
    self.ExchangeCondIds = ConfigManager.discrete_cfg[ExchangeCondId]--{{6,6,1},{6,5,2,6,4,3}}

    self.isNeedUnlock = false
    if unlockId then
        self.isNeedUnlock = true
        ---@type table<number,number[]>
        self.unlockDict = {}
        local count = #unlockIds
        for i = 1, count do
            local unlockData = unlockIds[i]
            self.unlockDict[self.cardIds[i]] = unlockData
        end
    end

    ---@type number 需要的0星卡牌数量
    self.NeedCardCount = 0
    local count = #self.ExchangeCondIds
    ---@type table<number,CardReplacementData.ExchangeConditions[]>
    self.ExchangeConditionList = {}

    ---@type table<number,number,number,number>
    self.ExchangeConditionDict = {}
    ---@type table<number,boolean>
    self.showOrderDict = {}

    ---@type table<number,number,boolean> 阶级,星级
    self.FilterList = {}
    for i = 1, count do
        ---{6,5,2,6,4,3}
        local ExchangeCondData = self.ExchangeCondIds[i]
        local QuantityConditions = #ExchangeCondData / 3
        ---@type CardReplacementData.ExchangeConditions[]
        local datas = {}
        self.ExchangeConditionDict[i] = {}
        for j = 1, QuantityConditions do

            ---@type CardReplacementData.ExchangeConditions
            local data = {
                order = ExchangeCondData[3 * j - 2],
                start = ExchangeCondData[3 * j - 1],
                num = ExchangeCondData[3 * j],
            }
            self.showOrderDict[data.order] = true
            if self.FilterList[data.order] == nil then
                self.FilterList[data.order] = {}
            end
            self.FilterList[data.order][data.start] = true
            self.ExchangeConditionDict[i][data.order] ={}
            self.ExchangeConditionDict[i][data.order][data.start] = data.num
            table.insert(datas,data)
            local Strat = ExchangeCondData[2 * j]
            if Strat == 6 then
                self.NeedCardCount = self.NeedCardCount + (ExchangeCondData[3 * j] * 2)
            else
                self.NeedCardCount = self.NeedCardCount + ExchangeCondData[3 * j]
            end
        end
        table.insert(self.ExchangeConditionList,datas)
    end
end

