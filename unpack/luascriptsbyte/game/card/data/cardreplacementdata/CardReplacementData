function CardReplacementData:GetCardList()
    --if self.CardDatas then
    --    return self.CardDatas
    --end

    local cardDict = {}
    local count = #self.cardIds
    ---@type CardData[]
    self.CardDatas = {}
    for i = 1, count do
        local cardId = self.cardIds[i]
        cardDict[cardId] = cardId
    end

    local cfgList = ConfigManager.card_cfg
    for id,cfg in pairs(cfgList) do
        if cardDict[id] and self:GetCardIsUnlock(id) then
            ---@type CardData
            local data = CardData.New()
            data:Parse({sid = id, uid = id})
            table.insert(self.CardDatas, data)
        end
    end
    return self.CardDatas
end

function CardReplacementData:GetCardIsUnlock(sid)
    if self.isNeedUnlock then
        local unlockCfg = self.unlockDict[sid]
        return _G.GlobalConditionManager.CheckCondition(unlockCfg[1],unlockCfg[2])
    end
    return true
end

