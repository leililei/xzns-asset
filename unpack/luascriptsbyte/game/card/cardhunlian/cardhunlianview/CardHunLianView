    self.hl_ren_bg:SetActiveE(isShow and 1 or 0)
    self.go_table.obj_hl_icon:SetActiveE(isShow and 1 or 0)
    if self.cardHLModel.isActive == 1 then
        --self.go_table.obj_hl_level:SetActiveE(1)
