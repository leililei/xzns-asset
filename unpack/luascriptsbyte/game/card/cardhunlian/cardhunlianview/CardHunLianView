function CardHunLianView:ShowHunLian(data)
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    self:DisposeAttribute()
    CardInfoManager:GetInstance():Add_CardViewUpdataFun(
        "CardHunLianView",
        function(CardData)
            self:DisposeAttribute()
            self:UpdateRoleData(CardData)
        end
    )
    self:SetData(data)
end

function CardHunLianView:CloseView()
    self:Close()
    self:DisposeHunlian()
end
---魂链隐藏
function CardHunLianView:HideHunLian(ui_name)
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
    self:DisposeAttribute()
    CardInfoManager:GetInstance():Del_CardViewUpdataFun("CardHunLianView")
end

---按钮点击事件在这里派发
function CardHunLianView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function CardHunLianView:OnDestroy()
    --_G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIHide, self.Hide, self)
    _G.Events:GetInstance():RemoveListener(_G.eHunLianEvents.UpLevelhHuiLian, self.PlayerUIEffectUpLevel, self)
    _G.Events:GetInstance():RemoveListener(_G.eHunLianEvents.ActiveHunLian, self.PlayerUIEffectAcitvie, self)
    self:DisposeHunlian()
    CardInfoManager:GetInstance():Del_CardViewUpdataFun("CardHunLianView")
end

--region 释放方法
---释放 方法 控制器
function CardHunLianView:DisposeHunlian()
    --释放 控制器
    if CardHunLianManger then
        CardHunLianManger:GetInstance():DisposeHunLiamManager()
    --CardHunLianManger = nil
    end
end
---释放 属性
function CardHunLianView:DisposeAttribute()
    local transNode = self.go_table.trans_content
    local count = transNode:GetChildCountE()
    if count > 0 then
        for i = 1, count do
            _G.PoolsManager:GetInstance():Despawn(transNode:GetChildE(0), _G.ePoolType.Default)
        end
    end
end
--endregion
