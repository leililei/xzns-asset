function CardHunLianView:SetTouXiang_UI(cardKey)
    local sprite_bg
    local sprite_normal
    local sprite_bg_Gray
    local jindutiao

    if cardKey == 1 then
        --等级uis
        sprite_bg_Gray = "ui_hl_bg_diren"
        sprite_bg = "ui_hl_bg_diren2"
        sprite_normal = "ui_hl_bg_ren"
        jindutiao = "ui_hl_xt_huangs"
        self.cardKey = self.keys.CardRen
    else
        sprite_bg_Gray = "ui_hl_bg_diling"
        sprite_bg = "ui_hl_bg_diling02"
        sprite_normal = "ui_hl_bg_ling"
        jindutiao = "ui_hl_xt_lans"
        self.cardKey = self.keys.CardLing
    end

    --两个条  1.星级是否达到 标准   2 是否 已经激活
    -- if self.cardHLModel.isActive == 0 then
    --     self.hl_ren_bg_Gray:LoadSprite(sprite_bg_Gray)
    --     self:ShowTouXian_UI(false)
    --     return
    -- else
    -- end
    self:ShowTouXian_UI(true)
    self.hl_ren_Normal:LoadSprite(sprite_normal)
    self.hl_ren_Normal:SetNativeSize()
    self.hl_ren_bg.SpriteName = sprite_bg
    self:UpdateIconJnAll(self.cardKey, self.cardHLModel.level)
    self.CircularProgressBar_UI.SpriteName = jindutiao
    self:Updateicon_UI(self.cardHLModel.cardData.sid)
end

