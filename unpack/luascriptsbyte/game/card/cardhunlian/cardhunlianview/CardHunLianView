end
---更新 按钮
function CardHunLianView:UpdateButtonUI()
    ---是否激活魂链
    local isActivateHl = self.cardHLModel.isActive
    local isBtn1 = false
    local isBtn2 = false
    if isActivateHl == 1 then
        --_G.
        isBtn2 = true
        isBtn1 = false
    else
        isBtn2 = false
        isBtn1 = true
    end
    self.hl_Active_Button:SetActiveE(isBtn1 and 1 or 0)
    self.hl_Up_Button:SetActiveE(isBtn2 and 1 or 0)
    local isGray = self.cardHLModel:IsCardStar() == false
    self.hl_Active_Button:SetGrayWithInteractable(isGray)
    local button = _G.GetAutoGoTable(self.go_table.obj_Button)
    if isGray then
        button.aortext_activate.text =
            "<color=#504B49>" .. _G.ConfigManager.language_package_cfg[90023500003] .. "</color>"
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_starLimit, true)

        local content = LangUtil.GetLangPackValue(90023500002)
        local starLimit = _G.ConfigManager.discrete_cfg[102401][1][1]
        content = string.format(content, starLimit)
        self.go_table.aortext_tips_starLimit.text = content
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tips_starLimit, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Item, true)
        button.aortext_activate.text =
            "<color=#914801>" .. _G.ConfigManager.language_package_cfg[90023500003] .. "</color>"
    end
    --self.hl_Up_Button:SetGray(isGray)
end

---更新 锁链的状态 suolian_UI
function CardHunLianView:UpdateSuolianUI(level)
    for i = 1, 7 do
        if self.cardHLModel.isActive == 1 then
            -- body
            if self.suolian_UI[i].lv <= level then
                _G.GameUtil.SetActiveByCondition(self.suolian_UI[i].image, false)
            else
                _G.GameUtil.SetActiveByCondition(self.suolian_UI[i].image, true)
            end
        else
            _G.GameUtil.SetActiveByCondition(self.suolian_UI[i].image, true)
        end
    end
    if level >= self.suolian_UI[7].lv then
        _G.GameUtil.SetActiveByCondition(self.suozi_UI, false)
    else
        _G.GameUtil.SetActiveByCondition(self.suozi_UI, true)
    end
end
