end
---设置Icon 根据所选择的 卡牌 设置属性图标
function CardHunLianView:Updateicon_UI(cardid)
    local hl_dataStatic = self.cardHLModel:GetAllExclusiveCf_attribute_display(cardid)
    for k = 1, #self.icon do
        local tem = hl_dataStatic[k].icon
        self.icon[k]:LoadImage(tem)
        self.icon[k]:SetActiveE(1)
        --self.icon.lv = hl_dataStatic[k].lv
        _G.SetEventTrigger(self.icon[k], "onClick", _G.handlerbind(self, self.TipsAttributeBtnOnClick, k))
    end
end

