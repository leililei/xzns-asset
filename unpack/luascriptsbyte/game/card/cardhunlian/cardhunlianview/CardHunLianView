---更新 属性 是否激活 及 属性显示的图片 的底层图片
---@param key nembuer 1寄灵人 2 守护灵
function CardHunLianView:UpdateIconJnAll(key, level)
    local ditu = self.go_table.obj_hl_icon
    for i = 1, #self.icon_jn do
        if self.cardHLModel.isActive == 1 then
            if icondJNCfg[key][i].lv <= level then
                self.icon_jn[i].SpriteName = icondJNCfg[key][i].icon.normal
                self.icon[i].color = _G.Color.white
            else
                self.icon_jn[i].SpriteName = icondJNCfg[key][i].icon.blank
                self.icon[i].color = _G.Color.New(68 / 255, 64 / 255, 64 / 255, 1)
            end
        else
            self.icon_jn[i].SpriteName = icondJNCfg[key][i].icon.blank
            self.icon[i].color = _G.Color.New(68 / 255, 64 / 255, 64 / 255, 1)
        end
        self.icon_b[i].SpriteName = icondJNCfg[key][i].icon.blank
    end
end

function CardHunLianView:UpdateIconJnOne()
    local level = self.cardHLModel.level
    local index
    if levelCfg[level] ~= nil then
        index = levelCfg[level].key
        self.icon_jn[index].SpriteName = icondJNCfg[self.cardKey][index].icon.normal
        self.icon[index].color = _G.Color.white
    end
end

