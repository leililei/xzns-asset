function CardHunLianView:UpdateView()
    --魂链等级
    self:UpdateHunLianLevelUI()
    --道具
    self:UpdateItemUI()
    --btn
    self:UpdateButtonUI()
    --锁链
    self:UpdateSuolianUI(self.cardHLModel.level)
    --进度条
    self:UpdateCircularProgressBar(self.cardHLModel.level)
    --属性信息显示
    --self:UpdateAttributeUI()
end
---强化按钮点击处理方法
function CardHunLianView:QianHuanButtonClick()
    --判断背包道具 是不是 小于 强化道具 提示道具 数量不够 获取通用的 获取道具界面
    if not self.cardHLModel:IsItemEnough() then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.cardHLModel.itemName)
        return
    end
    if levelCfg[self.cardHLModel.level + 1] ~= nil then
        self.cardHlManager:HunLianTips(2)
    else
        self.cardHlManager:UpLevel()
    end
end

