function CardHunLianView:PlayerUIEffectBg()
    local trans = self.go_table.trans_EffectPanel
    local count = trans:GetChildCountE()
    if count > 0 then
        _G.UIUtils.RemoveEffect(trans:GetChildE(0), 1)
    end
    -- if self.cardHLModel.isActive == 1 then
    -- end
    local effectName = UIEffectBG[self.cardHLModel.cardData.cardType].bg
    local cfg = _G.ConfigManager.ui_effect_cfg[effectName]
    _G.UIUtils.LoadEffectByCfg(cfg, trans)
end
---激活 特效
function CardHunLianView:PlayerUIEffectAcitvie()
    local trans = self.go_table.trans_EffectActivePanel
    local count = trans:GetChildCountE()
    if count > 0 then
        _G.UIUtils.RemoveEffect(trans:GetChildE(0), 1)
    end
    if self.cardHLModel.isActive == 1 then
        local effectName = UIEffectBG[self.cardHLModel.cardData.cardType].active
        local cfg = _G.ConfigManager.ui_effect_cfg[effectName]
        _G.UIUtils.LoadEffectByCfg(
            cfg,
            trans,
            function()
                _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_dianjichuantou, true)
            end,
            _G.handlerbind(self, self.RefreshUI, 1)
        )
    end
end
---升级 链子 断裂 特效
function CardHunLianView:PlayerUIEffectUpLevel()
    self.isPlay = true
    if levelCfg[self.cardHLModel.level] ~= nil then
        local trans = self.suolian_UI[levelCfg[self.cardHLModel.level].key].image
        local effectName = UIEffectBG[self.cardHLModel.cardData.cardType].lianzi
        local cfg = _G.ConfigManager.ui_effect_cfg[effectName]
        _G.UIUtils.LoadEffectByCfg(
            cfg,
            trans,
            function(tr)
                local z = self.suolian_UI[levelCfg[self.cardHLModel.level].key].rot
                local pos = self.suolian_UI[levelCfg[self.cardHLModel.level].key].pos
                tr:SetLocalPosition(pos[1], pos[2], pos[3])
                tr.transform:SetLocalEulerAngles(0, 0, z)
                _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_dianjichuantou, true)
                self.isPlay = false
            end,
            function()
                self:RefreshUI(2)
            end
        )
    else
        self:UpdateView()
        self:UpdateIconJnOne(self.cardHLModel.level)
    end
end
