---进度条
function CardHunLianModel:JinDuTiao(lv)
    if lv <= 5 then
        return 0
    end
    if lv == self.maxLevel then
        return 1
    end
    local newNumerical
    newNumerical = (lv - 5) / 30
    return newNumerical
end
---得到配置面的 card_exclusive_cfg 的base_att 属性 和 attribute_display
function CardHunLianModel:GetAllExclusiveCfgBase_att(sid)
    local exclusive_BaseAtt = {}
    for i = 0, self.maxLevel do
        local temp = {}
        temp.id = sid + i
        temp.key = exclusiveCfg[sid + i].base_att[1][1]
        temp.type = exclusiveCfg[sid + i].base_att[1][2]
        temp.value = exclusiveCfg[sid + i].base_att[1][3]
        --暂时留用
        temp.name = _G.ConfigManager.language_package_cfg[90010200101]
        table.insert(exclusive_BaseAtt, temp)
        temp = nil
    end
    return exclusive_BaseAtt
end

function CardHunLianModel:GetHunLevelMax()
    return _G.ConfigManager.discrete_cfg[102402][1][1]
end

---魂链额外激活的属性 和  技能  配置表 card_skills_cfg 和 attribute_cfg
---初始化额外激活的 属性
---@param sid number 卡牌的 sid
function CardHunLianModel:InitActiveAttOrSkill(sid)
    local tab = {}
    local cfg = _G.ConfigManager.card_exclusive_cfg
    local data = {}
    data.level = cfg[sid + 0].level
    if not _G.table.isEmptyOrNil(cfg[sid + 0].attribute_display) then
        data.ActiveType = _G.ActiveTypeEnum.attribute
        data.activeDataID = cfg[sid + 0].attribute_display[1]
    end
    if cfg[sid + 0].skills_display ~= 0 then
        data.ActiveType = _G.ActiveTypeEnum.skill
        data.activeDataID = cfg[sid + 0].skills_display
    end
    _G.table.insert(tab, data)
    for i = 1, self:GetHunLevelMax() do
        data = {}
        if not _G.table.isEmptyOrNil(cfg[sid + i].attribute_display) then
            data.ActiveType = _G.ActiveTypeEnum.attribute
            data.activeDataID = cfg[sid + i].attribute_display[1]
            data.level = cfg[sid + i].level
            _G.table.insert(tab, data)
        end
        if cfg[sid + i].skills_display ~= 0 then
            data.ActiveType = _G.ActiveTypeEnum.skill
            data.activeDataID = cfg[sid + i].skills_display
            data.level = cfg[sid + i].level
            _G.table.insert(tab, data)
        end
    end
    return tab
end

---得到配置面的 card_exclusive_cfg 的base_att 属性 和 attribute_display
function CardHunLianModel:GetAllExclusiveCf_attribute_display(sid, levelCfg)
    local exclusive_attributeCfg = {}
    ---魂链的配置表
    local attCfg = _G.ConfigManager.attribute_cfg
    local cardSkillcfg = _G.ConfigManager.card_skills_cfg
    local SoulLink_Level_Cfg = levelCfg or self.SoulLink_Level_Cfg
    for key, value in pairs(SoulLink_Level_Cfg) do
        local temp = {}
        local att
        local attId = value.activeDataID
        if value.ActiveType == _G.ActiveTypeEnum.attribute then
            att = attCfg[attId]
        else
            att = cardSkillcfg[attId]
        end
        --temp.name = att.name
        --temp.key  = att.attribute
        --temp.type = att.attribute_type
        --temp.value= att.attribute_params
        temp.icon = att.icon
        temp.lv = value.level --排序
        table.insert(exclusive_attributeCfg, temp)
    end
    table.sort(
        exclusive_attributeCfg,
        function(a, b)
            if a.lv < b.lv then
                return true
            end
            return false
        end
    )
    return exclusive_attributeCfg
end

---魂链 影响的 所有属性
function CardHunLianModel:GetAllAttribute(sid)
    local exlusive_att = self.att_or_skillsCfg
    local exlusive_base = self.att_exclusivecfg_baseAttCfg
    local All_attribute = {}
    local temp1 = {}
    for key, value in pairs(exlusive_att) do
        table.insert(exlusive_base, value)
    end
    for key, vallue in pairs(exlusive_base) do
        temp1[vallue.key] = true
    end
    for key, value in pairs(temp1) do
        table.insert(All_attribute, key)
    end
    temp1 = nil
    return All_attribute
end

return CardHunLianModel
