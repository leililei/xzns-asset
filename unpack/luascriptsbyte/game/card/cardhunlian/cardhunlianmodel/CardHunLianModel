---初始化 魂链的数据
function CardHunLianModel:InitDataHunLian(cardData)
    --魂链等级
    self.level = cardData.soulLink_lv
    --魂链是否激活
    self.isActive = cardData.soulLink_IsActivate
    --CardData
    self.cardData = cardData
    self.maxLevel = self:GetHunLevelMax()
    --魂链星级 魂链解锁星级
    self.cardStar = cardData.star
    --道具
    local item = {}
    if self:ChangeMaterial(cardData.sid, self.level) then
        item = self:GetHLItem(cardData.sid, self.level + 1)
        self.itemName = item[1]
        self.itemLimit = item[2]
    else
        item = self:GetHLItem(cardData.sid, self.level)
        self.itemName = item[1]
        self.itemLimit = self:GetItemLimit(cardData.sid, self.level)
    end
    --道具名称
    --道具数量
    self.itemCount = self:GetBagItemNumber(_G.StorageID.Material, item[1])
    --提示
    self.tips = tips
    --魂链额外激活的数据
    self.SoulLink_Level_Cfg = self:InitActiveAttOrSkill(cardData.sid)
end

--region 消耗道具
---道具信息  获取魂链卡牌 所消耗的道具 和 信息 HL->hun lian
---sid == 卡牌的sid + 卡牌的 魂链等级 level
function CardHunLianModel:GetHLItem(sid, lv)
    local material = {}
    local exclcfg = _G.ConfigManager.card_exclusive_cfg[sid + lv].material
    if #exclcfg == 1 then
        material = exclcfg[1]
    else
        material = exclcfg[#exclcfg]
    end
    return material
end
function CardHunLianModel:ChangeMaterial(sid, lv)
    if (lv + 1) >= self:GetHunLevelMax() then
        return false
    end
    local material = {}
    local exclcfg = _G.ConfigManager.card_exclusive_cfg[sid + lv].material
    local limit1 = #exclcfg
    exclcfg = _G.ConfigManager.card_exclusive_cfg[sid + lv + 1].material
    local limit2 = #exclcfg
    if limit2 - limit1 == 0 then
        return false
    else
        return true
    end
end
---获取升级需要的 道具 限制
function CardHunLianModel:GetItemLimit(sid, lv)
    local number = 0
    local item = {}
    local it = {}
    if self.isActive == 0 then
        item = self:GetHLItem(sid, 0)
        return item[2]
    end
    if lv == 0 then
        item = self:GetHLItem(sid, 0)
        it = self:GetHLItem(sid, lv + 1)
        number = it[2] - item[2]
    else
        if (lv + 1) > self:GetHunLevelMax() then
            return 0
        end
        local lev = lv + 1
        item = self:GetHLItem(sid, lv)
        it = self:GetHLItem(sid, lev)
        number = it[2] - item[2]
    end
    return number
end
---消耗道具信息
function CardHunLianModel:GetHLItemInfo(itemId)
    local itemAttributeCfg = _G.ConfigManager.item_cfg
    return itemAttributeCfg[itemId]
end
---获取仓库的 某种升级魂链道具数量
---@param id number 仓库的ID
---@param sidOrUid number 道具的sid
---@reture count 数量
function CardHunLianModel:GetBagItemNumber(id, sid)
    local count = _G.StorageManager:GetInstance():GetItemCountByID(id, sid)
    return count
end
---道具 是否 足够
function CardHunLianModel:IsItemEnough()
    if self.itemCount < self.itemLimit then
        return false
    end
    return true
end
---检测道具是否足够
function CardHunLianModel:IsItemEnoughShowFast(call)
    if self.itemCount < self.itemLimit then
        _G.GameUtil.FastUseChooseItem(
            boxItemId,
            self.itemName,
            self.itemLimit,
            function()
                self.itemCount = self:GetBagItemNumber(_G.StorageID.Material, self.itemName)
                if call then
                    call()
                end
            end
        )
        return false
    else
        return true
    end
end
