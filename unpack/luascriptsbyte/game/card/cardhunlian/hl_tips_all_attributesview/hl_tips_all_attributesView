---@class hl_tips_all_attributesView : UIBaseView	中文描述
---@field public go_table hl_tips_all_attributesView_GoTable GoTable
local hl_tips_all_attributesView = _G.BaseClass("hl_tips_all_attributesView", _G.UIBaseView)
--_G.hl_tips_all_attributesView = hl_tips_all_attributesView

local CS = _G.CS
local typeof = _G.typeof

local levelCfg = {
    [0] = {lv = 0, key = 1},
    [5] = {lv = 5, key = 2},
    [10] = {lv = 10, key = 3},
    [15] = {lv = 15, key = 4},
    [20] = {lv = 20, key = 5},
    [25] = {lv = 25, key = 6},
    [30] = {lv = 30, key = 7}
}

function hl_tips_all_attributesView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.contentTrans = self.go_table.obj_content
end

---界面的入口函数
function hl_tips_all_attributesView:OnCreate(Data)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
end
---资源加载
function hl_tips_all_attributesView:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function hl_tips_all_attributesView:SetData(Data)
    self.AllModel_exclusive_BaseAtt = require("CardHunLianModel"):GetInstance():GetAllExclusiveCfgBase_att(Data.sid)
    self.AllModel_exclusive_attDisplay_attCfg =
        require("CardHunLianModel"):GetInstance():GetAllExclusiveCf_attribute_display(Data.sid)
    self.AllAttributeModel = self:GetAllAttribute()
    self:UopdateAllAttributeTips(Data)
end

function hl_tips_all_attributesView:CloseView()
    self:Close()
end

function hl_tips_all_attributesView:OnDestroy()
    self.AllModel_exclusive_BaseAtt = nil
    self.AllModel_exclusive_attDisplay_attCfg = nil
    self.AllAttributeModel = nil
end

---按钮点击事件在这里派发
function hl_tips_all_attributesView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---得到要显示的 总属性
---@return 返回 新的 要显示的总属性
function hl_tips_all_attributesView:GetAllAttribute()
    local All_attribute = {}
    local temp1 = {}
    for key, value in pairs(self.AllModel_exclusive_attDisplay_attCfg) do
        table.insert(self.AllModel_exclusive_BaseAtt, value)
    end
    for key, vallue in pairs(self.AllModel_exclusive_BaseAtt) do
        temp1[vallue.key] = true
    end
    for key, value in pairs(temp1) do
        table.insert(All_attribute, key)
    end
    temp1 = nil
    return All_attribute
end

---刷新 属性 所有信息
function hl_tips_all_attributesView:UopdateAllAttributeTips(data)
    local da = data.allAttr
    local attr = {}
    for key, value in pairs(self.AllAttributeModel) do
        table.insert(attr, value)
    end

    table.sort(
        attr,
        function(a, b)
            if _G.AttrType[a].sortid < _G.AttrType[b].sortid then
                return true
            end
            return false
        end
    )
    for i = 1, #attr do
        local function InitInfo(trans)
            local id = _G.AttrType[attr[i]].ID
            local icon = _G.ConfigManager.type_attribute_cfg[id].icon
            local nameid = _G.ConfigManager.type_attribute_cfg[id].name
            local name = _G.GetLangPackValue(nameid)
            local go = _G.GetAutoGoTable(trans)
            go.aorrawimage_att:LoadImage(icon)
            go.aortext_dec.text = name
            go.aortext_hlAtt_number.text = Mathf.RoundToInt(da[attr[i]])
        end
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Card/CardHunLian/$_obj_one_shuxing_Hl",
            _G.ePoolType.Default,
            self.contentTrans,
            function(trans)
                InitInfo(trans)
            end
        )
    end
end

---获得卡牌 魂链 所有能激活的属性
function hl_tips_all_attributesView:GetCardHLAllAttribute(sid)
    local attributeAllID = {}
    for key, value in pairs(levelCfg) do
        local va = _G.ConfigManager.card_exclusive_cfg[sid + value.lv].attribute_display[1]
        table.insert(attributeAllID, va)
    end
    return attributeAllID
end
return hl_tips_all_attributesView
