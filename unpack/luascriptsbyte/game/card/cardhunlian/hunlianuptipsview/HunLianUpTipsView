---@class HunLianUpTipsView : UIBaseView	中文描述
---@field public go_table HunLianUpTipsView_GoTable GoTable
local HunLianUpTipsView = _G.BaseClass("HunLianUpTipsView", _G.UIBaseView)
--_G.HunLianUpTipsView = HunLianUpTipsView
local CardHunLianManger = require "CardHunLianManger"
local CardHunLianModel = require "CardHunLianModel"

local CS = _G.CS
local typeof = _G.typeof

function HunLianUpTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_close"] = self.CloseView,
        ["@_aorbtn_Done"] = self.Done,
        ["@_aorbtn_tips"] = self.OnClickTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go.name .. "</color>")
            end
        end
    }
end

---界面的入口函数
function HunLianUpTipsView:OnCreate(Data, lv)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
    self:InitView(Data, lv)
end
