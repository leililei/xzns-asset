end
function HunLianUpTipsView:SetData(Data)
end

function HunLianUpTipsView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function HunLianUpTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function HunLianUpTipsView:OnClickTips()
    ---激活的7个属性 UI显示
    local soulLink_lv = CardHunLianModel:GetInstance().cardData.soulLink_lv
    CardHunLianManger:GetInstance():ShowAttributeTips(
        self.go_table.gameObject,
        CardHunLianModel:GetInstance().cardData.sid,
        self.lv,
        CardHunLianModel:GetInstance().isActive == 1,
        soulLink_lv
    )
end

---初始化界面
---@param type number 类型 1 代表激活 2 代表升级
function HunLianUpTipsView:InitView(type, slevel)
    self.type = type
    self.lv = slevel
    local level = CardHunLianModel:GetInstance().level
    local att_or_skill = CardHunLianModel:GetInstance().SoulLink_Level_Cfg
    local activeDataId, ActiveType
    if level <= 0 then
        level = 0
        activeDataId = att_or_skill[1].activeDataID
        ActiveType = att_or_skill[1].ActiveType
    else
        level = level + 1
        for i = 1, #att_or_skill do
            if level == att_or_skill[i].level then
                activeDataId = att_or_skill[i].activeDataID
                ActiveType = att_or_skill[i].ActiveType
                break
            end
        end
    end
    local cfg, icon, name, value, describe
    if ActiveType == _G.ActiveTypeEnum.attribute then
        cfg = _G.ConfigManager.attribute_cfg[activeDataId]
        icon = cfg.icon
        name = _G.LangUtil.GetLangPackValue(cfg.name)
        -- value = cfg.attribute_params
        -- value = value * 0.0001 * 100
        describe = _G.LangUtil.GetLangPackValue(cfg.describe)
    else
        cfg = _G.ConfigManager.card_skills_cfg[activeDataId]
        if cfg == nil then
            _G.FloatTipsModel:GetInstance():Show("请查看 配置表 是否 有此 id：" .. activeDataId)
        end
        icon = cfg.icon
        name = _G.LangUtil.GetLangPackValue(cfg.name1)
        describe = _G.LangUtil.GetLangPackValue(cfg.describe1)
    end
    self.go_table.aorrawimage_icon:LoadImage(icon)
    self.go_table.aortext_skillName1.text = name
    --self.go_table.aortext_des.text = describe

    --暂时显示用 后期要配置表
    local subList = {}
    local itemId = CardHunLianModel:GetInstance().itemName
    local itemCountLimit = CardHunLianModel:GetInstance().itemLimit
    table.insert(subList, {itemId, false, itemCountLimit})
    --table.insert(subList,{_G.ResPropID.CardExp,false,0})
    --table.insert(subList,{_G.ResPropID.Coin,false,0})
    --材料显示
    if self.go_table.ResConsume == nil then
        self.go_table.ResConsume =
            self:AddComponent(
            self.go_table.obj_consume,
            --require("ConsumeCompont").New(self.go_table.obj_consume, subList, nil, nil, true)
            require("ResourceCompont").New(self.go_table.obj_consume, subList, 2, nil, true)
        )
    else
        self.go_table.ResConsume:RestRs(subList)
    end
end

function HunLianUpTipsView:Done()
    if self.type == 1 then
        CardHunLianManger:GetInstance():ActiveHunLian()
    else
        CardHunLianManger:GetInstance():UpLevel()
    end
    self:Close()
end

return HunLianUpTipsView
