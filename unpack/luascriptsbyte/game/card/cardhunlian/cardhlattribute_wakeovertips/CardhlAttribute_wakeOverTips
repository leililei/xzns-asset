---@class CardhlAttribute_wakeOverTips : UIBaseView	中文描述
---@field public go_table CardhlAttribute_wakeOverTips_GoTable GoTable
local CardhlAttribute_wakeOverTips = _G.BaseClass("CardhlAttribute_wakeOverTips", _G.UIBaseView)
--_G.CardhlAttribute_wakeOverTips = CardhlAttribute_wakeOverTips

local card_exclusiveCfg = _G.ConfigManager.card_exclusive_cfg
local attributeCfg = _G.ConfigManager.attribute_cfg
---@type card_cfg
local cardCfg = _G.ConfigManager.card_cfg
local typeAttributeCfg = _G.ConfigManager.type_attribute_cfg
local GetLangPackValue = _G.GetLangPackValue
function CardhlAttribute_wakeOverTips:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_wakeOverTipsClose"] = self.OnClickBtn_wakeOverTipsClose,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self:initData()
    local upstatOverTips = _G.GetAutoGoTable(self.go_table.obj_upStarOverTips)
    self.titleIcon = upstatOverTips.aorimage_title
end

---界面的入口函数
---@param type number 1 是激活成功 2 是强化
function CardhlAttribute_wakeOverTips:OnCreate(Data, type)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
    self:ShowWakeOver(Data)
    if type == 1 then
        --self.titleIcon:LoadImage("ui_tongyong_font_jihuocg")
        self.titleIcon.SpriteName = "ui_tongyong_font_jihuocg"
    else
        --self.titleIcon:loadImage("ui_tongyong_font_sjcg")
        self.titleIcon.SpriteName = "ui_tongyong_font_sjcg"
    end
end
---资源加载
function CardhlAttribute_wakeOverTips:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function CardhlAttribute_wakeOverTips:SetData(Data)
end

function CardhlAttribute_wakeOverTips:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function CardhlAttribute_wakeOverTips:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function CardhlAttribute_wakeOverTips:OnClickBtn_wakeOverTipsClose()
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

function CardhlAttribute_wakeOverTips:ShowView(data, type)
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
    self:ShowWakeOver(data)
    if type == 1 then
        --self.titleIcon:LoadImage("ui_tongyong_font_jihuocg")
        self.titleIcon.SpriteName = "ui_tongyong_font_jihuocg"
    else
        --self.titleIcon:loadImage("ui_tongyong_font_sjcg")
        self.titleIcon.SpriteName = "ui_tongyong_font_sjcg"
    end
end

---初始化 unity里面的控件
function CardhlAttribute_wakeOverTips:initData()
    local obj = _G.GetAutoGoTable(self.go_table.obj_upStarOverTips)
    self.roleImage = obj.aorrawimage_Role
    self.skillName = obj.aortext_SkillName
    self.skillIcon = obj.aorrawimage_SkillIcon
    self.skillDes = obj.aortext_skillDes
    self.skillEffectDes = obj.aortext_effectDes
    self.obj_info = obj.obj_info
end

function CardhlAttribute_wakeOverTips:ShowWakeOver(cardData)
    if cardData == nil then
        return
    end
    local attrID = card_exclusiveCfg[cardData.sid + cardData.soulLink_lv].attribute_display[1]
    --local attrValue = attributeCfg[attrID].attribute_params
    --local attrType = attributeCfg[attrID].attribute_type
    --local key = _G.AttrType[attributeCfg[attrID].attribute].ID
    ---local typeAttCfgValue = typeAttributeCfg[key].params_power

    -- if _G.AttrType[attributeCfg[attrID].attribute].proptype == 1 then
    --     if attrType == 1 then
    --     else
    --         attrValue = attrValue / typeAttCfgValue * 100
    --     end
    -- else
    --     attrValue = attrValue * 0.0001 * 100
    -- end

    local skillDes = GetLangPackValue(attributeCfg[attrID].describe)
    --- true 是技能 显示技能描述
    local isSkill = attributeCfg[attrID].skill ~= 0
    --- 显示 技能描述
    if isSkill then
        self.skillDes.text = skillDes
    else --显示 效果描述
        self.skillEffectDes.text = skillDes
    end

    local skillIcon = attributeCfg[attrID].icon

    --- 延迟一秒显示图片 防止动画 alpha调整 失效
    local timerSkillIcon =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        true,
        false
    )
    timerSkillIcon:Start()

    _G.GameUtil.SetActiveByCondition(self.skillDes, isSkill)
    _G.GameUtil.SetActiveByCondition(self.skillEffectDes, not isSkill)

    local var = attributeCfg[attrID].name
    local name = GetLangPackValue(var)
    self.skillName.text = " " .. GetLangPackValue(90022500361, name)
    self.roleImage.Alpha = 0
    local card_cfg = cardCfg[cardData.sid]
    local aorrawimage_Role = self.roleImage
    aorrawimage_Role.Alpha = 0
    if card_cfg ~= nil and not _G.string.IsNullOrEmpty(card_cfg.Portrait) then
        aorrawimage_Role:LoadImage(
            card_cfg.Portrait,
            function()
                _G.GameUtil.SetActiveByCondition(self.obj_info, true)

                aorrawimage_Role:SetNativeSize()
                local x = card_cfg.pos_portrait[1] or 0
                local y = -18
                local z = card_cfg.pos_portrait[3] or 0
                aorrawimage_Role:SetLocalPosition(x, y, z)
                local size = card_cfg.size2 or 1
                aorrawimage_Role.rectTransform:SetLocalScaleXYZ(size)
            end
        )
    end
end

function CardhlAttribute_wakeOverTips:TimerFunc(skillIcon)
    self.skillIcon:LoadImage(
        skillIcon,
        function(image)
            -- image:SetNativeSize()
        end
    )
end

return CardhlAttribute_wakeOverTips
