---@class CardHunLianView_AttributeTips : UIBaseView	中文描述
---@field public go_table CardHunLianView_AttributeTips_GoTable GoTable
local CardHunLianView_AttributeTips = _G.BaseClass("CardHunLianView_AttributeTips", _G.UIBaseView)
--_G.CardHunLianView_AttributeTips = CardHunLianView_AttributeTips

local CS = _G.CS
local typeof = _G.typeof

function CardHunLianView_AttributeTips:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_close"] = self.Hide,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self:InitUI()
end

---界面的入口函数
function CardHunLianView_AttributeTips:OnCreate(Data)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
end
---资源加载
function CardHunLianView_AttributeTips:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function CardHunLianView_AttributeTips:SetData(Data)
    self:UpDateJimian(Data)
end

function CardHunLianView_AttributeTips:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function CardHunLianView_AttributeTips:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function CardHunLianView_AttributeTips:InitUI()
    self.hl_tips_title_text = self.go_table.aortext_attribute_name
    self.hl_att_text = self.go_table.aortext_attribute_jianjietips
    self.hl_att_icon = self.go_table.aorrawimage_attribute
end
---刷新界面 标题、图标、内容
function CardHunLianView_AttributeTips:UpDateJimian(data)
    self.hl_tips_title_text.text = data.titls
    self.hl_att_text.text = data.describe
    self.hl_att_icon:LoadImage(data.icon)
end

---隐藏 提示界面
function CardHunLianView_AttributeTips:Hide()
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
end

---显示界面
function CardHunLianView_AttributeTips:Show(data)
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    self:UpDateJimian(data)
end

return CardHunLianView_AttributeTips
