local CardHunLianModel = require("CardHunLianModel")
local CardHunLianManger = require("CardHunLianManger")
local SkillHunLianTipModel = require("SkillHunLianTipModel")

local levelIndex = {
    [0] = 1,
    [5] = 2,
    [10] = 3,
    [15] = 4,
    [20] = 5,
    [25] = 6,
    [30] = 7
}

---@class HunLianUpResultView : UIBaseView    中文描述
---@field public go_table HunLianUpResultView_GoTable GoTable
local HunLianUpResultView = _G.BaseClass("HunLianUpResultView", _G.UIBaseView)

function HunLianUpResultView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HunLianUpResultView:OnCreate(data, SoulLink_Level_Cfg)
    ---@type CardData
    self.cardData = data or CardHunLianModel:GetInstance().cardData
    self.SoulLink_Level_Cfg = SoulLink_Level_Cfg or CardHunLianModel:GetInstance().SoulLink_Level_Cfg
    self:InitShow()
end

---@private
function HunLianUpResultView:InitShow()
    local level = self.cardData.soulLink_lv
    local idx = levelIndex[level]
    CardHunLianManger:GetInstance():GetBase_att(self.cardData.sid, level)
    local hlData = CardHunLianModel:GetInstance():GetAllExclusiveCf_attribute_display(self.cardData.sid,self.SoulLink_Level_Cfg)
    self.go_table.aorrawimage_Icon:LoadImage(hlData[idx].icon)
    local isActive = self.cardData.soulLink_IsActivate == 1
    local attrOld = CardHunLianManger:GetInstance():GetBase_att(self.cardData.sid, level - 1)
    local attrNew = CardHunLianManger:GetInstance():GetBase_att(self.cardData.sid, level)

    self.SkillDesExText = self.go_table.obj_Describe:GetComponentE(_G.typeof(_G.CS.ExtendText))

    for i = 1, 4 do
        self.go_table["aortext_OldVal" .. i].text = (isActive and attrOld) and attrOld[i].value * 0.01 .. "%" or 0
        self.go_table["aortext_NewVal" .. i].text = isActive and attrNew[i].value * 0.01 .. "%" or 0
    end
    local attrOrSkill = self.SoulLink_Level_Cfg
    local sid = attrOrSkill[idx].activeDataID
    --local activeType = attrOrSkill[idx].ActiveType
    if level == 0 then
        local hunlianskillTips = {
            [1] = 0, --魂链技能 激活的等级
            [2] = 10,
            [3] = 20,
            [4] = 30
        }
        local data = SkillHunLianTipModel.New()
        data:Init(sid, self.cardData.soulLink_IsActivate, level, hunlianskillTips)
        local skillData = data.skillData

        if skillData[1].name1 > 0 and _G.LangUtil.GetLangPackValue(skillData[1].name1) then
            self.go_table.aortext_SkillName.text = _G.LangUtil.GetLangPackValue(skillData[1].name1)
        else
            self.go_table.aortext_SkillName.text = ""
        end

        if skillData[1].describe1 > 0 and _G.LangUtil.GetLangPackValue(skillData[1].describe1) then
            --技能描述
            if not data.isSkillActive[1].isLock and not skillData[1].skill_type ~= "Images/Icon/ui-jn-bar-heji" then
                self.SkillDesExText.text =
                    _G.LangUtil.GetLangPackValue(skillData[1].describe1) ..
                    _G.string.AddColor("（" .. _G.LangUtil.GetLangPackValue(9002070022) .. "）", "ff5656")
            else
                self.SkillDesExText.text = _G.LangUtil.GetLangPackValue(skillData[1].describe1)
            end
        else
            self.SkillDesExText.text = ""
        end
    else
        local cfg = _G.ConfigManager.card_skills_cfg[sid]
        self.go_table.aortext_SkillName.text = _G.LangUtil.GetLangPackValue(cfg.name1)
        self.SkillDesExText.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
    end
end

---界面的销毁函数
function HunLianUpResultView:OnDestroy()
end

---按钮点击事件在这里派发
function HunLianUpResultView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return HunLianUpResultView
