end

---按钮点击事件在这里派发
function HunLianUpLevelView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

local title = {
    [1] = "ui_tongyong_font_jihuocg",
    [2] = "ui_tongyong_font_sjcg"
}

---初始化 数据
function HunLianUpLevelView:InitViewData(data)
    local level = require "CardHunLianModel":GetInstance().level
    local att_or_skill = require "CardHunLianModel":GetInstance().SoulLink_Level_Cfg
    local activeDataId, ActiveType
    local cfg, icon, name, value, describe
    if level == 1 then
        activeDataId = att_or_skill[1].activeDataID
        ActiveType = att_or_skill[1].ActiveType
        cfg = _G.ConfigManage.card_skills_cfg[activeDataId]
    else
        for i = 1, #att_or_skill do
            if level == att_or_skill[i].level then
                activeDataId = att_or_skill[i].activeDataID
                ActiveType = att_or_skill[i].ActiveType
                break
            end
        end
    end
    if data.type == 1 then --激活
        self.go_table.aorimage_title.SpriteName = title[1]
    else --升级
        self.go_table.aorimage_title.SpriteName = title[2]
    end
    ---@type card_cfg
    local cardCfg = _G.ConfigManager.card_cfg
    local nextAttArr = require "CardHunLianManger":GetInstance():GetBase_att(data.cardData.sid, level)
    --设置属性值
    local trFrom1 = self.go_table.trans_JHPanel
    local count = #nextAttArr
    if data.type == 1 then -- 激活
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_JHPanel, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_Up, false)
        for i = 1, count do
            _G.PoolsManager:GetInstance():Spawn(
                attributeItem_jH,
                _G.ePoolType.Default,
                trFrom1,
                function(trans)
                    trans = _G.GetAutoGoTable(trans)
                    local name = require "CardHunLianManger":GetInstance():GetAttributeDes(nextAttArr[i].key)
                    local value = nextAttArr[i].value
                    value = value * 0.0001 * 100
                    trans.aortext_name.text = name
                    trans.aortext_attvalue.text = "+" .. value .. "%"
                end
            )
        end
    else -- 升级 属性
        local currAttArr = require "CardHunLianManger":GetInstance():GetBase_att(data.cardData.sid, level - 1)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_JHPanel, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_Up, true)
        self.go_table.aortext_curLevel.text = level - 1
        self.go_table.aortext_NextLevel.text = level
        trFrom1 = self.go_table.trans_currentPanel
        count = #currAttArr
        for i = 1, count do
            _G.PoolsManager:GetInstance():Spawn(
                attributeItem_Sj,
                _G.ePoolType.Default,
                trFrom1,
                function(trans)
                    trans = _G.GetAutoGoTable(trans)
                    local name = require "CardHunLianManger":GetInstance():GetAttributeDes(currAttArr[i].key)
                    local value = currAttArr[i].value
                    value = value * 0.0001 * 100
                    trans.aortext_curname.text = name
                    trans.aortext_nextname.text = name

                    trans.aortext_curattvalue.text = "+" .. value .. "%"
                    value = nextAttArr[i].value
                    value = value * 0.0001 * 100
                    trans.aortext_nextattvalue.text = "+" .. value .. "%"
                    if i >= count then
                        self.go_table.trans_Skill:SetAsLastSiblingE()
                    end
                end
            )
        end
    end
    --立绘图
    local roleImage = self.go_table.aorrawimage_Role
    roleImage.Alpha = 0
    local card_cfg = cardCfg[data.cardData.sid]
    local aorrawimage_Role = roleImage
    aorrawimage_Role.Alpha = 0
    if card_cfg ~= nil and not _G.string.IsNullOrEmpty(card_cfg.Portrait) then
        aorrawimage_Role:LoadImage(
            card_cfg.Portrait,
            function()
                aorrawimage_Role:SetNativeSize()
                local x = card_cfg.pos_portrait6[1] or 0
                local y = card_cfg.pos_portrait6[2] or 0
                local z = card_cfg.pos_portrait6[3] or 0

                aorrawimage_Role:SetLocalPosition(x, y, z)
                local size = card_cfg.size5 or 0.697
                aorrawimage_Role.rectTransform:SetLocalScaleXYZ(size)
            end
        )
    end
    --解锁 属性或者是 技能
    if ActiveType == _G.ActiveTypeEnum.attribute then
        cfg = _G.ConfigManager.attribute_cfg[activeDataId]
        name = _G.LangUtil.GetLangPackValue(cfg.name)
        -- value = cfg.attribute_params
        -- value = value * 0.0001 * 100
        self.go_table.aortext_effectDes.text = _G.LangUtil.GetLangPackValue(cfg.describe)
    else
        cfg = _G.ConfigManager.card_skills_cfg[activeDataId]
        name = _G.LangUtil.GetLangPackValue(cfg.name1)
        self.go_table.aortext_effectDes.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
    end
    self.go_table.aorrawimage_icon:LoadImage(cfg.icon)
    self.go_table.aortext_skillName.text = name
end

---释放
function HunLianUpLevelView:RelsGameObject()
    --激活
    local trFrom = self.go_table.trans_JHPanel
    local count = trFrom:GetChildCountE()
    if count > 0 then
        for i = 1, count do
            _G.PoolsManager:GetInstance():Despawn(trFrom:GetChildE(0), _G.ePoolType.Default)
        end
    end
    --升级  当前
    local trFrom1 = self.go_table.trans_currentPanel
    count = trFrom1:GetChildCountE()
    if count > 0 then
        for i = 1, count do
            _G.PoolsManager:GetInstance():Despawn(trFrom1:GetChildE(0), _G.ePoolType.Default)
        end
    end
end

return HunLianUpLevelView
