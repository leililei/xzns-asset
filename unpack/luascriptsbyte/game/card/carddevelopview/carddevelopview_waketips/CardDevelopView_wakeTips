---@class CardDevelopView_wakeTips : UIBaseView	中文描述
local CardDevelopView_wakeTips = _G.BaseClass("CardDevelopView_wakeTips", _G.UIBaseView)

local CS = _G.CS
local typeof = _G.typeof
function CardDevelopView_wakeTips:Awake()
    --- 是否以界面的形式打开   界面要colse  否则只隐藏
    self.isView = false

    -- self.TipsArr[index] = {
    --     tran = tTran,
    --     attribute_cfg = nil
    -- }

    ---@field public tran UnityEngine.Transform 九个节点tran
    ---@field public attribute_cfg attribute_cfg_Item 九个节点tran
    ---@class CardDevelopView_wakeTips_TipsArrItem

    ---@type CardDevelopView_wakeTips_TipsArrItem[]
    self.TipsArr = {}
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()
    --- 觉醒Tips
    self.go_wakeTips = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    --- 觉醒Tips觉醒九宫格
    self.go_awake9 = _G.GetAutoGoTable(self.go_wakeTips.obj_awake9, _G.handler(self, self.OnClickBtn))
    self.StopCoroutine_rota = coroutine.start(_G.handler(self, self.CoOnProgress))

    self.clickFunction = {
        --按钮点击对应的方法
        --界面关闭
        ["@_aorbtn_jxt"] = self.OnClickBtn_ShowWakeInfoTips,
        ["@_aorbtn_wakeTipsCloseView"] = self.OnClickBtn_wakeTipsClose,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end
---创建对象时,入口构造函数
function CardDevelopView_wakeTips:OnCreate(mCardData)
    self.isView = mCardData ~= nil
    if mCardData == nil then
        self.gameObject:SetActiveE(0)
    else
        self:OnClickBtn_ShowWakeInfoTips(mCardData)
    end
end

function CardDevelopView_wakeTips:OnClickBtn_ShowWakeInfoTips(mCardData)
    if mCardData == nil then
        return
    end

    self.mCardData = mCardData
    ---头像
    self.go_wakeTips.aorrawimage_Icon:LoadImage(mCardData.Icon)
    ----五行
    require("CardInfoManager").LoadRawImage_elements(self.go_wakeTips.aorrawimage_elements, mCardData)
    ----职业
    require("CardInfoManager").LoadRawImage_professional(self.go_wakeTips.aorrawimage_professional, mCardData)
    -- 品质背景图
    self.go_wakeTips.aorimage_Color.SpriteName =
        self.mCardInfoManager:GetCardIconQualityBGSpriteName(mCardData.cfg.Order)
    ---设置升星结果数据
    self.mCardInfoManager:Star_byParent(self.go_wakeTips.obj_starParent, mCardData.star)

    self.go_wakeTips.aortext_cardname.text = _G.LangUtil.GetLangPackValue(mCardData.cfg.Name)

    self:SetWake9View(mCardData)

    self.gameObject:SetActiveE(1)
end

function CardDevelopView_wakeTips:OnClickBtn_wakeTipsClose()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)

    if self.isView == true then
        self:Close()
    else
        self.go_wakeTips:SetActiveE(0)
    end
end

function CardDevelopView_wakeTips:OnClickBtn_wake9(go, BaseEventData, Index)
    ---@type attribute_cfg_Item
    local attribute_cfg = self.TipsArr[Index].attribute_cfg

    -- local attrValue = attribute_cfg.attribute_params

    -- if _G.AttrType[attribute_cfg.attribute].proptype == 1 then
    --     if attribute_cfg.attribute_type == 1 then
    --     else
    --         attrValue = attrValue * 0.0001 * 100
    --     end
    -- else
    --     attrValue = attrValue * 0.0001 * 100
    -- end

    ---是否觉醒了该技能 true 是
    local isHave = Index <= self.mCardData.awaken

    local skillinfoStr = _G.LangUtil.GetLangPackValue(attribute_cfg.describe) or ""
    if isHave == false then
        skillinfoStr = skillinfoStr .. "\n<size=17><color=#000000>"
        skillinfoStr = skillinfoStr .. _G.LangUtil.GetLangPackValue(90020300068, tostring(Index)) or ""
        skillinfoStr = skillinfoStr .. "</color></size>"
    end
    self.go_wakeTips.aortext_skillinfo.text = skillinfoStr

    local skillicon = attribute_cfg.icon
    if string.IsNullOrEmpty(skillicon) then
        skillicon = self.mCardInfoManager.RawSkillicon
    end
    self.go_wakeTips.aorrawimage_aLeft:LoadImage(
        skillicon,
        function(image)
            -- image:SetNativeSize()
        end
    )

    self:ShowRota(Index)
end

function CardDevelopView_wakeTips:SetWake9View(mCardData)
    if mCardData == nil then
        return
    end
    --- 觉醒效果表
    local attribute_cfg = _G.ConfigManager.attribute_cfg

    local ShowBtn = false
    local ShowAwake9 = true
    --- 角色觉醒配置
    local mCard_awaken_cfg = _G.ConfigManager.card_awaken_cfg[mCardData.sid]
    if mCard_awaken_cfg == nil then
        ShowAwake9 = false
    else
        ShowBtn = not _G.IsNil(mCard_awaken_cfg.num_coin[mCardData.awaken + 1])

        for i = 1, 9 do
            local mAttributeId = mCard_awaken_cfg.attribute[i]
            local mAttribute = attribute_cfg[mAttributeId]

            if mAttribute == nil then
                self:Set_aorimage_abg(i, false, mAttribute)
                self:Set_aorimage_a(i, false)
            else
                ---是否觉醒了该技能 true 是
                local isHave = i <= mCardData.awaken

                self:Set_aorimage_abg(i, isHave, mAttribute)

                self:Set_aorimage_a(i, true, mAttribute.icon, isHave)
            end
        end
    end
    self:OnClickBtn_wake9(nil, nil, 1)

    _G.GameUtil.SetActiveByCondition(self.go_wakeTips.obj_awake9, ShowAwake9)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_upStar, ShowBtn)
end

function CardDevelopView_wakeTips:CoOnProgress()
    local rot_z = 0
    local rot_obj_RotBg = 0
    while true do
        if self.gameObject:GetActiveSelf() == 1 then
            if self.go_wakeTips.obj_RotBg ~= nil then
                if self.go_wakeTips.obj_RotBg ~= nil then
                    if rot_z >= 360 then
                        rot_z = 0
                    end
                    rot_z = rot_z + 10

                    if rot_obj_RotBg >= 360 then
                        rot_obj_RotBg = 0
                    end
                    rot_obj_RotBg = rot_obj_RotBg + 0.5
                    self.go_wakeTips.obj_RotBg:SetLocalEulerAngles(0, 0, -rot_obj_RotBg)
                end
            end
        end
        _G.coroutine.waitforendofframe()
    end
end

---@param index number 1-9
---@param mAttribute attribute_cfg_Item
function CardDevelopView_wakeTips:Set_aorimage_abg(index, isShow, mAttribute)
    ---@type AorImage
    local tAorimage = self.go_awake9["aorimage_abg" .. index]
    if tAorimage == nil then
        return
    end

    if self.TipsArr[index] == nil then
        local tTran = self.go_awake9.obj_skill:GetChildE(index - 1)
        if tTran ~= nil then
            self.TipsArr[index] = {
                tran = tTran,
                attribute_cfg = nil
            }
            ---监听 点击 显示Tips
            _G.SetEventTrigger(tTran, "onClick", _G.handlerbind(self, self.OnClickBtn_wake9, index))
        end
    end
    self.TipsArr[index].attribute_cfg = mAttribute

    if tAorimage:GetActiveSelf() ~= (isShow and 1 or 0) then
        _G.GameUtil.SetActiveByCondition(tAorimage, isShow)
    end
    if isShow == true then
        self:ShowRota(index)
    end
end

---销毁对象时,析构函数
function CardDevelopView_wakeTips:ShowRota(index)
    self.go_awake9.obj_rot:SetActiveE(1)
    self.go_awake9.obj_rot:SetParentE(self.TipsArr[index].tran)
    self.go_awake9.obj_rot:SetLocalPosition(0, 0, 0)

    --- 每第三个是大技能
    local Scale = 0.6
    if index % 3 == 0 then
        Scale = 1
    end
    self.go_awake9.obj_rot:SetLocalScaleXYZ(Scale)
end

---@param index number 1-9
function CardDevelopView_wakeTips:Set_aorimage_a(index, isShow, Spritname, isHave)
    if string.IsNullOrEmpty(Spritname) then
        Spritname = self.mCardInfoManager.RawSkillicon
    end
    ---@type AorImage
    local tAorrawimage = self.go_awake9["aorrawimage_a" .. index]
    if tAorrawimage == nil then
        return
    end
    if tAorrawimage:GetActiveSelf() ~= (isShow and 1 or 0) then
        _G.GameUtil.SetActiveByCondition(tAorrawimage, isShow)
    end

    tAorrawimage:LoadImage(
        Spritname,
        function(image)
            -- image:SetNativeSize()
        end
    )
    if isHave == true then
        tAorrawimage.color = _G.Color.white
    else
        tAorrawimage.color = _G.Color.New(84 / 255, 84 / 255, 84 / 255, 1)
    end
end

---销毁对象时,析构函数
function CardDevelopView_wakeTips:OnDestroy()
    if self.StopCoroutine_rota ~= nil then
        _G.coroutine.stopwaiting(self.StopCoroutine_rota)
        self.StopCoroutine_rota = nil
    end
end

---按钮点击事件在这里派发
function CardDevelopView_wakeTips:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
return CardDevelopView_wakeTips
