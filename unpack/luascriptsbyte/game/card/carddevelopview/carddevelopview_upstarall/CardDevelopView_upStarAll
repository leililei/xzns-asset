---@class CardDevelopView_upStarAll : Component	中文描述
local CardDevelopView_upStarAll = _G.BaseClass("CardDevelopView_upStarAll", _G.UIBaseView)

local CS = _G.CS
local typeof = _G.typeof

function CardDevelopView_upStarAll:Awake()
    ---选择的升星组 self.Selectindex[Index]=isSelect
    self.Selectindex = nil
    --- 当前数据数量
    self.oldCardNum = nil
end

---创建对象时,入口构造函数
function CardDevelopView_upStarAll:OnCreate(mView)
    self.mView = mView
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    ---@type CardInfoManager
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()
    self.go_table.looplist2_loop:InitListView(0, _G.handler(self, self.RefreshRenItem))
    self:OnClickBtn_ShowUpStarAll()
end

function CardDevelopView_upStarAll:Dispose()
    self.go_table = nil
    self.mView = nil
    self.mCardInfoManager = nil
end

function CardDevelopView_upStarAll:OnClickBtn_ShowUpStarAll()
    self.CardList = self.mCardInfoManager:GetSortUpStarAll()
    self.Selectindex = {}

    ----默认全选
    for Index, cards in pairs(self.CardList) do
        self.Selectindex[Index] = true
    end

    self.gameObject:SetActiveE(1)

    local num = #self.CardList
    if num ~= self.oldCardNum then
        self.oldCardNum = num
        self.go_table.looplist2_loop:SetListItemCount(self.oldCardNum, true)
    else
        self.go_table.looplist2_loop:RefreshAllShownItem()
    end
end

--初始化聊天iitem
---@param index int 该数据的索引   0起始
function CardDevelopView_upStarAll:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1

    local item = listView2:NewListViewItem("$_obj_ListItem")
    if GuideManager:GetInstance().IsGuideing then
        item:SetName(t_index)
    end
    local CardDevelopView_upStarAll_CardItem = require("CardDevelopView_upStarAll_CardItem")
    local tCard = self:GetComponent(item, CardDevelopView_upStarAll_CardItem)
    if tCard == nil then
        _G.GameUtil.SetActiveByCondition(item, true)
        tCard = self:AddComponent(item, CardDevelopView_upStarAll_CardItem.New(self))
    end
    local params = self.CardList[t_index]
    tCard:Init(params, t_index, true)

    return item
end

function CardDevelopView_upStarAll:HideView()
    self.gameObject:SetActiveE(0)

    self.go_table.aorbtn_Done:SetActiveE(0)
end

function CardDevelopView_upStarAll:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_anyClose" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        self:OnClickBtn_StartUpStar()
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

--region --------------------------------------按钮事件--------

function CardDevelopView_upStarAll:OnClickBtn_StartUpStar()
    local CardDelUids = {}
    for Index, cards in pairs(self.CardList) do
        if self.Selectindex[Index] then
            for _, Carddata in pairs(cards[2]) do
                table.insert(CardDelUids, Carddata.uid)
            end
            for _, Carddata in pairs(cards[3]) do
                table.insert(CardDelUids, Carddata.uid)
            end
        end
    end

    self.mCardInfoManager:CardNewReadyDestroy(
        CardDelUids,
        function(Refun)
            --共鸣神石下阵检测
            local CardResonanceModel = require("CardResonanceModel"):GetInstance()
            local tempList, blackList = {}, {}
            for _, v in pairs(CardDelUids) do
                local _, temp = CardResonanceModel:GetIndexByUid(v)
                if temp then
                    _G.table.insert(tempList, v)
                else
                    blackList[v] = true
                end
            end
            local overList = CardResonanceModel:CardDownarray(tempList, blackList)
            if #overList ~= 0 then
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CardDevelopView_tip.Name,
                    overList,
                    _G.handlerbind(self, self.StartUpStar, CardDelUids, Refun)
                )
            else
                self:StartUpStar(CardDelUids, Refun)
            end
        end,
        function()
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90022500367))
        end
    )
end

--endregion

--region --------------------------------------逻辑函数--------

function CardDevelopView_upStarAll:StartUpStar(Cardids, ReFun)
    --- 升星的主卡  用于添加到奖励里 显示
    local mainCards = {}

    --- 升星卡 吃掉的sid [uid={sid,sid...},...]
    local mainSubCards = {}

    ---@type card.c2s_card_up_star
    local pbdata = {}
    pbdata.uids = {}

    for Index, Cards in pairs(self.CardList) do
        if self.Selectindex[Index] then
            ---@type card.i_c_uid 变量名
            local i_c_uid = {}
            i_c_uid.uid = Cards[1].uid
            i_c_uid.c_uids = {}
            i_c_uid.c_uids2 = {}

            local SubCards = {}

            ---@param Carddata CardData
            for _, Carddata in pairs(Cards[2]) do
                table.insert(i_c_uid.c_uids, Carddata.uid)
                table.insert(SubCards, Carddata.sid)
            end
            for _, Carddata in pairs(Cards[3]) do
                table.insert(i_c_uid.c_uids2, Carddata.uid)
                table.insert(SubCards, Carddata.sid)
            end
            table.insert(pbdata.uids, i_c_uid)

            local award = {Cards[1].sid, Cards[1].uid, Cards[1].star + 1}
            table.insert(mainCards, {type = award})

            mainSubCards[Cards[1].uid] = SubCards
        end
    end

    ---@type card.c2s_card_up_star
    local newpbdata = {}
    newpbdata.uids = {}
    table.insert(newpbdata.uids, pbdata)

    require("CardInfoNet"):GetInstance():UpStar(
        newpbdata,
        function(data)
            if data.ack ~= 1 then
                if ReFun ~= nil then
                    ReFun()
                end
                --_G.GameUtil.NetAckShowTips(data.ack)
                self:Close()
                return
            end
            local power = _G.StorageManager:GetInstance():GetPlayerPower()
            self.mCardInfoManager:CardNewStartDestroy(Cardids)
            -- if data
            for index, carduid in ipairs(Cardids) do
                _G.StorageManager:GetInstance():DelCard(carduid)
            end
            -- _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Coin, 0, self.mCard_starInfo.num_coin)
            for key, data in pairs(pbdata.uids) do
                local mCardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
                if mCardData ~= nil then
                    mCardData:upStarCardAward()
                    mCardData:SetCostCardList(mainSubCards[data.uid])
                    mCardData:CalcNowSumProp()
                    require("CardResonanceModel"):GetInstance():AddMaxSids(mCardData.sid, mCardData.star)

                    local openxzInfo = _G.ConfigManager.discrete_cfg[107401][1]
                    local openxz = openxzInfo[1]
                    local openxzNum = openxzInfo[2]
                    if mCardData:GetStar() >= openxz then
                        mCardData.inborn_num = mCardData.inborn_num + openxzNum
                        require "RedPointManager":GetInstance():RefreshParentNode(
                            _G.ConfigManager.redpoint_cfg.TalentCultivate.id,
                            mCardData.uid
                        )
                    end

                    _G.Events:GetInstance():Broadcast(
                        _G.eCard.CardUpStar,
                        mCardData:GetStar(),
                        mCardData.sid,
                        mCardData.uid
                    )
                    _G.Events:GetInstance():Broadcast(_G.ChatViewEvents.ChatViewLevel, mCardData, mCardData:GetStar())
                    --刷新红点形象
                    require "RedPointManager":GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.PlayerRole.id,
                        mCardData.sid
                    )
                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointCardUpStar.id, mCardData.uid)
                -- _G.Events:GetInstance():Broadcast(
                --     _G.ePlayAactionEvent.PlayAaction,
                --     {
                --         _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar,
                --         mCardData:GetStar() - 1
                --     },
                --     -1
                -- )
                -- _G.Events:GetInstance():Broadcast(
                --     _G.ePlayAactionEvent.PlayAaction,
                --     {
                --         _G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar,
                --         mCardData:GetStar()
                --     },
                --     1
                -- )
                -- if mCardData:GetStar() >= 11 then
                --     local Storages = self.Storages[_G.StorageID.Card]
                --     Storages:XingJiPanDuan()
                -- end
                end
            end
            if data.award == nil or data.award.item == nil then
                data.award = {
                    item = {}
                }
            else
                --- 先解析奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
            end

            --- 再将升星成功的也显示上去
            table.insertto(data.award.item, mainCards, 1)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data,
                function()
                    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
                    if offset > 0 then
                        require "CommonTipManager".OpenPowerUpView(power, offset)
                    end
                end
            )

            self:Close()
            -- self.prb_upStarOverTips_Lua:ShowUpStarOver(mCardData)

            -- require("CardInfoManager"):GetInstance():RedPointItemCard_UpdataAll()
            --营地 获取信息
            --require("CampsiteModel"):GetInstance():GetDataFormServer()
            ---检测共鸣神石核心
            -- require("CardResonanceModel"):GetInstance():UpdateAllPosCard() --与storage重复调用

            --卡牌升星后 获得成长星辉
            require "PlayerTreeModel":GetInstance():GetGrow()
            require("CardInheritModel"):GetInstance():CheckInheritBuffLock(true)
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.CardPotential.id)
            self.mView:UpdatePropCardData()
            self.mView:DelayUpdataLoopList()
        end
    )
end

function CardDevelopView_upStarAll:SelectCardGroup(Index, isSelect)
    self.Selectindex[Index] = isSelect

    local isShowbtn = false
    for _, isbool in pairs(self.Selectindex) do
        if isbool then
            isShowbtn = true
            break
        end
    end
    self.go_table.aorbtn_Done:SetActiveE(isShowbtn and 1 or 0)
end

--endregion

