---@class CardDevelopView_tip : UIBaseView	中文描述
---@field public go_table CardDevelopView_tip_GoTable GoTable
local CardDevelopView_tip = _G.BaseClass("CardDevelopView_tip", _G.UIBaseView)

local marerialSid = 202010100

function CardDevelopView_tip:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function CardDevelopView_tip:OnCreate(uidlist,call)
    self.uidList = uidlist
    self.call = call
    local exp = 0
    local coin = 0
    local material = 0
    self.exp = 0
    self.coin = 0
    self.material = 0
    for k, v in pairs(self.uidList) do
        exp,coin,material = self:GetResetRes(v)
        self.exp = self.exp + exp
        self.coin = self.coin + coin
        self.material = self.material + material
    end
    self:SetResetRes()
end

---界面的销毁函数
function CardDevelopView_tip:OnDestroy()
    self.cardList = nil
end

---按钮点击事件在这里派发
function CardDevelopView_tip:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_1 then
        -- 确定
        local tempList = {}
        for k, v in pairs(self.uidList) do
            local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,v)
            if data.lv ~= 1 then
                _G.table.insert(tempList,data)
            end
        end
        self.resetCount = #tempList
        for _, data in pairs(tempList) do
            self:StarSure(data)
        end

        if self.resetCount == 0 and self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_2 then
        -- 取消
        self:Close()
    end
end

--- 获得卡牌回退资源
function CardDevelopView_tip:GetResetRes(uid)
    local CardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,uid)
    local lv = CardData.lv_Old
    ---@type card_level_cfg
    local cfg = _G.ConfigManager.card_level_cfg[lv]
    if cfg == nil then
        return
    end

    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            self.go_table.trans_item,
            function(item)
                item:Show(CardData.sid, nil, CardData.star, CardData.soul_lv, CardData.level, nil, nil, CardData.soul_state, CardData.born_skill_num)
                item.gameObject:SetLocalScaleXYZ(0.85)
                -- item.transform:FindE("scale"):SetLocalScaleXYZ(0.875)
            end
    )

    local count = self.go_table.trans_item:GetChildCountE()
    for i = 2, count do
        local tran = self.go_table.trans_item:GetChildE(count - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    local expNum = cfg.exp or 0

    local coinNum = cfg.coin or 0
    local len = #cfg.material
    local num = 0
    if len >= 2 then
        len = len / 2
        for i = 1, len do
            local mIndex = i * 2
            num = cfg.material[mIndex]
        end
    end
    return expNum,coinNum,num
end

function CardDevelopView_tip:SetResetRes()
    local ItemViewBase = require("ItemViewBase")
    if self.exp > 0 then
        local exp = _G.ResPropID.CardExp
        _G.StorageManager:GetInstance():GetItemBaseView(
            exp,
            self.exp,
            self.go_table.trans_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                mitem.gameObject:SetLocalScaleXYZ(0.85)
            end
        )
    end
    if self.coin > 0 then
        local coin = _G.ResPropID.Coin
        _G.StorageManager:GetInstance():GetItemBaseView(
            coin,
            self.coin,
            self.go_table.trans_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                mitem.gameObject:SetLocalScaleXYZ(0.85)
            end
        )
    end

    if self.material and self.material > 0 then
        local sid = marerialSid
        _G.StorageManager:GetInstance():GetItemBaseView(
            sid,
            self.material,
            self.go_table.trans_item,
            function(mitem)
                mitem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                mitem.gameObject:SetLocalScaleXYZ(0.85)
            end
        )
    end
end


function CardDevelopView_tip:OpenAwardWindos(data)
    if not self.awardData then
        self.awardData = {award={item={}}}
    end
    _G.table.insertto(self.awardData.award.item, data.award.item)
    if not self.awardCount then
        self.awardCount = 0
    end
    self.awardCount = self.awardCount + 1
    if self.awardCount == self.resetCount then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.awardData)
    end
end

function CardDevelopView_tip:StarSure(CardData)
    self:UnEquip(
        CardData,
        function(equipAwards)
            if equipAwards == nil then
                return
            end
            require("CardResonanceModel"):GetInstance():LevelResetNoUpdatePosCard(
                CardData.uid,
                function(data)
                    if data.ack ~= 1 then
                        --_G.GameUtil.NetAckShowTips(data.ack)
                        return
                    end
                    if data.award ~= nil then
                        if data.award.item ~= nil then
                            --- 解析奖励
                            _G.StorageManager:GetInstance():ReceiveAwardData(data)
                            _G.table.insertto(data.award.item, equipAwards)
                            --饰品
                            local mainCards = {}
                            if self.decoration then
                                for key, value in pairs(self.decoration) do
                                    local award1 = {value[1], value[2]}
                                    _G.table.insert(mainCards, {type = award1})
                                end
                            end

                            _G.table.insertto(data.award.item, mainCards)
                            self:OpenAwardWindos(data)
                            -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        end
                    end

                    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(CardData, true)
                    _G.PlayerPrefsManager.DeleteKey(_G.CardHunLian.CardHunLianSaveKey .. (CardData.uid * 10 + 1))
                    require "RedPointManager":GetInstance():RefreshNode(
                        _G.ConfigManager.redpoint_cfg.SoulChain.id,
                        CardData.uid * 10 + 1
                    )
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
                    )

                    if self.awardCount == self.resetCount then
                        if self.call then
                            _G.DelayFrameDo(function()
                                self.call()
                                require("CardResonanceModel"):GetInstance():UpdateAllPosCard()
                            end)
                        end
                    end
                end
            )
        end
    )
end

function CardDevelopView_tip:UnEquip(Cardata, call)
    local indexs = {}
    local Uids = {}

    ---@param equip EquipmentItem
    for key, equip in pairs(Cardata.EquipBar) do
        if not table.isEmptyOrNil(equip) then
            table.insert(Uids, {equip.sid, equip.uid})
            table.insert(indexs, key)
        end
    end
    if not _G.table.isEmptyOrNil(Cardata.ArtifactBar) then
        table.insert(Uids, {Cardata.ArtifactBar.sid, Cardata.ArtifactBar.uid})
    end
    --ZHJ-20596 刻魂不再卸下
    if #indexs < 1 then
        --self:UnDecoration(Cardata, call, Uids)
        ---脱下神器
        self:UnArtifact(Cardata, call, Uids)
    else
        require("EquipmentModel"):GetInstance():UnfixEquip(
            Cardata.uid,
            indexs,
            function(data)
                for _, equip in pairs(Cardata.EquipBar) do
                    if not _G.table.isEmptyOrNil(equip) then
                        equip:UnEquip()
                    end
                end
                ---脱下神器
                -- self:UnDecoration(Cardata, call, Uids)
                self:UnArtifact(Cardata, call, Uids)
            end
        )
    end
end


function CardDevelopView_tip:UnDecoration(CardData, call, Uids)
    self.decoration = {}
    if CardData:GetDecorationCount() == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("无饰品 穿戴")
        end
        if call then
            call(Uids)
            return
        end
    end
    local DecorationBar = CardData.DecorationBar
    for i = 1, #DecorationBar do
        if not _G.table.isEmptyOrNil(DecorationBar[i]) then
            _G.table.insert(self.decoration, {DecorationBar[i].sid, DecorationBar[i].uid})
        end
    end
    require("DecorationModel"):GetInstance():UnfixDecoration(
        {CardData.uid},
        function()
            if call then
                call(Uids)
            end
        end
    )
end

function CardDevelopView_tip:UnArtifact(cardData, call, Uids)
    ---脱下神器
    require("ArtifactModel"):TakeOffArtifact(
        cardData,
        function()
            if call then
                call(Uids)
            end
        end
    )
end

return CardDevelopView_tip