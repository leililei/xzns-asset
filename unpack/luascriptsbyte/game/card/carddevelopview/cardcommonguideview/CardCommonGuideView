---@class CardCommonGuideView : UIBaseView	中文描述
---@field public go_table CardCommonGuideView_GoTable GoTable
local CardCommonGuideView = _G.BaseClass("CardCommonGuideView", _G.UIBaseView)
--_G.CardCommonGuideView = CardCommonGuideView
local LanguageId = 90022501393
local GetLangPackValue = _G.GetLangPackValue
function CardCommonGuideView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CardCommonGuideView:OnCreate(cardData)
    self:ShowView(cardData)
end
---显示界面
---@param cardData CardData
function CardCommonGuideView:ShowView(cardData)
    self.cardData = cardData
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.baseBodyItem,
        self.go_table.trans_card,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            item:ShowCardData(self.cardData, nil, true)
        end
    )
    self.go_table.aortext_content.text =
        GetLangPackValue(LanguageId, GetLangPackValue(self.cardData.cfg.Name), GetLangPackValue(self.cardData.cfg.Name))
end
---点击前往
function CardCommonGuideView:OnGo()
    _G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardShowView.Name, {CardData = self.cardData})
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommentView.Name, self.cardData.sid)
end

---按钮点击事件在这里派发
function CardCommonGuideView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_go then
        self:OnGo()
    end
end

return CardCommonGuideView
