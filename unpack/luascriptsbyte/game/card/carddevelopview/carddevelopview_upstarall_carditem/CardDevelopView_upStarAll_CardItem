--region --------------------------------------CardItem--------

---@class CardDevelopView_upStarAll_CardItem : Component	中文描述
local CardDevelopView_upStarAll_CardItem = _G.BaseClass("CardDevelopView_upStarAll_CardItem", _G.Component)

function CardDevelopView_upStarAll_CardItem:Awake()
    self.isSelect = false

    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_tableCard = {
        main = require("ItemCardAllView").New(self.go_table.obj_cardItem11),
        one = require("ItemCardAllView").New(self.go_table.obj_cardItem21),
        two = require("ItemCardAllView").New(self.go_table.obj_cardItem22),
        new = require("ItemCardAllView").New(self.go_table.obj_cardItem31)
    }
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()
end

function CardDevelopView_upStarAll_CardItem:Dispose()
    self.go_table = nil
    self.go_tableCard = nil
    self.mCardInfoManager = nil
    self.mUpStarAllView = nil
end

---@param mView CardDevelopView
function CardDevelopView_upStarAll_CardItem:OnCreate(mView)
    self.mUpStarAllView = mView
end

---@param CardData CardData
---@param isAni boolean true (scale 0.8->1)
function CardDevelopView_upStarAll_CardItem:Init(CardDataList, index)
    self.index = index

    local isSelect = self.mUpStarAllView.Selectindex[self.index]
    if isSelect ~= nil then
        self:SetIsSelect(isSelect)
    else
        self:SetIsSelect(true)
    end

    local mainCard = CardDataList[1]
    self:SetCard(self.go_tableCard.main, CardDataList[1])
    local temps = CardDataList[2]
    local tempCard = {}
    if not _G.table.isEmptyOrNil(temps) then
        for i = 1, #temps do
            _G.table.insert(tempCard, temps[i])
        end
    end
    temps = CardDataList[3]
    if not _G.table.isEmptyOrNil(temps) then
        for i = 1, #temps do
            _G.table.insert(tempCard, temps[i])
        end
    end
    local isOne = false
    if not _G.table.isEmptyOrNil(tempCard[1]) then
        -- local oneCard = _G.DeepCopy(mainCard)
        -- oneCard.star = tempCard[1].star
        self:SetCard(self.go_tableCard.one, tempCard[1])
        --self:UpdataCardCount(oneLen, self.go_tableCard.one)
        isOne = true
    end
    _G.GameUtil.SetActiveByCondition(self.go_tableCard.one.gameObject, isOne)
    isOne = false
    local twoLen = CardDataList[3] and #CardDataList[3] or 0

    if not _G.table.isEmptyOrNil(tempCard[2]) then
        -- local twoCard = _G.DeepCopy(mainCard)
        -- twoCard.star = tempCard[2].star
        self:SetCard(self.go_tableCard.two, tempCard[2])
        --self:UpdataCardCount(#CardDataList[3], self.go_tableCard.two)
        isOne = true
    end
    _G.GameUtil.SetActiveByCondition(self.go_tableCard.two.gameObject, isOne)

    local newCard = _G.DeepCopy(mainCard)
    newCard.star = newCard.star + 1
    self:SetCard(self.go_tableCard.new, newCard)

    self:InitData()
end

function CardDevelopView_upStarAll_CardItem:InitData()
    -- if self.index % 2 == 0 then
    --     self.go_table.aorimage_bg.Alpha = 0
    -- else
    --     self.go_table.aorimage_bg.Alpha = 1
    -- end
end
function CardDevelopView_upStarAll_CardItem:SetCard(lua, CardData)
    if CardData ~= nil then
        lua:ShowCardData(CardData, nil, true, true)
        lua:HideOrShowLevel(true)
        _G.GameUtil.SetActiveByCondition(lua.go_table.aorimage_black, false)
    end
end
function CardDevelopView_upStarAll_CardItem:UpdataCardCount(num, go_tableCard)
    if go_tableCard ~= nil then
        self:SetCountText(go_tableCard.go_table.aortext_num, num)
    end
    return
end
function CardDevelopView_upStarAll_CardItem:SetCountText(aortext, num)
    if aortext == nil then
        return
    end
    aortext.text = string.format("%d/%d", num, num)
end

function CardDevelopView_upStarAll_CardItem:OnClick_bg()
end

-- 按钮单击事件--
function CardDevelopView_upStarAll_CardItem:OnClickBtn(go, isOn)
    if _G.IsNil(go) then
        return
    end

    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("CardDevelopView_upStarAll_CardItem>>ClickBtn>>" .. name)
    end
    if name == "@_aorbtn_gou" then
        self:SetIsSelect(not self.isSelect)
    end
end

function CardDevelopView_upStarAll_CardItem:SetIsSelect(isSelect)
    self.isSelect = isSelect
    self.go_table.aorimage_gou:SetActiveE(self.isSelect and 1 or 0)
    self.mUpStarAllView:SelectCardGroup(self.index, self.isSelect)
end
function CardDevelopView_upStarAll_CardItem:OnDisable()
end
function CardDevelopView_upStarAll_CardItem:OnDestroy()
end

--endregion

return CardDevelopView_upStarAll_CardItem
