---@class CardDevelopView_wakeOverTips : Component	中文描述
local CardDevelopView_wakeOverTips = _G.BaseClass("CardDevelopView_wakeOverTips", _G.Component)

local CS = _G.CS
local typeof = _G.typeof
function CardDevelopView_wakeOverTips:Awake()
    --- 纸片人 呼吸dotween killFun
    self.tweenRoleBreatheKillFun = nil
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()

    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    --- 觉醒完成
    self.go_wakeOverTips = _G.GetAutoGoTable(self.go_table.obj_upStarOverTips, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --按钮点击对应的方法
        --界面关闭
        ["@_aorbtn_wakeOverTipsClose"] = self.OnClickBtn_wakeOverTipsClose,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end
---创建对象时,入口构造函数
function CardDevelopView_wakeOverTips:OnCreate(mView)
    self.mView = mView
    self.gameObject:SetActiveE(0)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

function CardDevelopView_wakeOverTips:Dispose()
    self.mView = nil
    self.mCardInfoManager = nil
end

function CardDevelopView_wakeOverTips:OnClickBtn_wakeOverTipsClose()
    if _G.IsNil(self.mView) then
        --- 防止 新手引导直接关闭界面
        return
    end
    local nowtf = self.mView:GetChildE(0)
    if nowtf ~= nil then
        nowtf:SetActiveE(1)
    end
    self.gameObject:SetActiveE(0)
    self.mView:GetUpdataCard()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

--- 觉醒完成
---@param mCardData CardData
function CardDevelopView_wakeOverTips:ShowWakeOver(mCardData)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_DontClick, false)

    if mCardData == nil then
        return
    end

    local tCard_awaken_cfg = _G.ConfigManager.card_awaken_cfg[mCardData.sid]
    if tCard_awaken_cfg == nil then
        return
    end
    local tAttribute_cfgID = tCard_awaken_cfg.attribute[mCardData.awaken]
    if tAttribute_cfgID == nil then
        return
    end
    local tAttribute_cfg = _G.ConfigManager.attribute_cfg[tAttribute_cfgID]
    if tAttribute_cfg == nil then
        return
    end

    --隐藏 主要界面 只显示升星结果界面
    local nowtf = self.mView:GetChildE(0)
    if nowtf ~= nil then
        nowtf:SetActiveE(0)
    end

    self.gameObject:SetActiveE(1)

    -- local attrValue = tAttribute_cfg.describe

    -- if _G.AttrType[tAttribute_cfg.attribute].proptype == 1 then
    --     if tAttribute_cfg.attribute_type == 1 then
    --     else
    --         attrValue = attrValue * 0.0001 * 100
    --     end
    -- else
    --     attrValue = attrValue * 0.0001 * 100
    -- end

    local skillDes = _G.LangUtil.GetLangPackValue(tAttribute_cfg.describe)

    --- true 是技能 显示技能描述
    local isSkill = tAttribute_cfg.skill ~= 0
    --- 显示 技能描述
    if isSkill then
        self.go_wakeOverTips.aortext_skillDes.text = skillDes
    else --显示 效果描述
        self.go_wakeOverTips.aortext_effectDes.text = skillDes
    end

    local skillicon = tAttribute_cfg.icon
    if string.IsNullOrEmpty(tAttribute_cfg.icon) then
        skillicon = self.mCardInfoManager.RawSkillicon
    end

    --- 延迟一秒显示图片 防止动画 alpha调整 失效
    local timerSkillIcon =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        true,
        false,
        false,
        skillicon
    )
    timerSkillIcon:Start()

    _G.GameUtil.SetActiveByCondition(self.go_wakeOverTips.aortext_skillDes, isSkill)
    _G.GameUtil.SetActiveByCondition(self.go_wakeOverTips.aortext_effectDes, not isSkill)

    self.go_wakeOverTips.aortext_SkillName.text =
        " 领悟<color=#95e7ff>“" .. _G.LangUtil.GetLangPackValue(tonumber(tAttribute_cfg.name)) .. "”</color>"

    ---@type card_cfg
    local card_cfg = _G.ConfigManager.card_cfg[mCardData.sid]
    ---@type AorRawImage
    local aorrawimage_Role = self.go_wakeOverTips.aorrawimage_Role
    aorrawimage_Role.Alpha = 0

    if card_cfg ~= nil and not _G.string.IsNullOrEmpty(card_cfg.Portrait) then
        aorrawimage_Role:LoadImage(
            card_cfg.Portrait,
            function()
                _G.GameUtil.SetActiveByCondition(self.go_wakeOverTips.obj_info, true)

                aorrawimage_Role:SetNativeSize()
                local pos =
                    Vector3.New(
                    card_cfg.pos_portrait[1] or 0,
                    card_cfg.pos_portrait[2] or 0,
                    card_cfg.pos_portrait[3] or 0
                )
                aorrawimage_Role:SetLocalPosition(pos.x, pos.y, pos.z)

                -- --- 角色立绘 动画   程序实现  因为要动态最终大小
                -- aorrawimage_Role.Alpha = 0
                -- aorrawimage_Role:DOFade(1, 0.2)
                local size = card_cfg.size2 or 1
                aorrawimage_Role.rectTransform:SetLocalScaleXYZ(size)
            end
        )
    end
end

function CardDevelopView_wakeOverTips:TimerFunc(skillicon)
    self.go_wakeOverTips.aorrawimage_SkillIcon:LoadImage(
        skillicon,
        function(image)
        end
    )
end

function CardDevelopView_wakeOverTips:OnDisable()
    if self.tweenRoleBreatheKillFun ~= nil then
        self.tweenRoleBreatheKillFun()
    end
end

---销毁对象时,析构函数
function CardDevelopView_wakeOverTips:OnDestroy()
end

---按钮点击事件在这里派发
function CardDevelopView_wakeOverTips:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
return CardDevelopView_wakeOverTips
