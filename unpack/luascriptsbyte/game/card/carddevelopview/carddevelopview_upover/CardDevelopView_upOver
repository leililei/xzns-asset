---创建对象时,入口构造函数
function CardDevelopView_upOver:OnCreate(mView, data)
    self.uiDic = {
        ---战力
        zl = _G.LangUtil.GetLangPackValue(90020300107),
        ---最大等级
        zddj = _G.LangUtil.GetLangPackValue(90020300106)
    }

    self.mView = mView
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CardUpOverView, self.go_table)
    self.go_table.obj_infoItem:SetActiveE(0)
    self:ShowView(data)
    self.canclick = false
    self:LoadEffect()
    _G.DelayDo(
        2,
        function()
            self.canclick = true
        end
    )
    -- ZHJH-1735
    -- 卡牌升级和升星是同一个音效
    _G.AudioManager.PlayAudioByAudioCfgID(2030)
end

function CardDevelopView_upOver:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ShowAwardVBGShengLI,
        self.go_table.obj_eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

---灵契
function CardDevelopView_upOver:SetSpiritualTip(starLevel)
    local unlockData = _G.ConfigManager.discrete_cfg[114001]
    local starIs = 0
    local starText = ""
    local starImage = ""
    if starLevel == unlockData[1][1] then
        starText = 90030900022
        starIs = 1
        starImage = "tb_bn_kh"
    end
    self.go_table.obj_Level:SetActiveE(starIs)
    if starIs == 1 then
        self.go_table.aortext_Text.text = _G.LangUtil.GetLangPackValue(starText)
        self.go_table.aorimage_Icon.SpriteName = starImage
    end
end

function CardDevelopView_upOver:SetCardText(starLevel)
    local starIs = 0
    -- 判断当前魂将星级
    local starText = ""
    local starImage = ""
    if starLevel == 7 then --橙色
        if not _G.AppSetting.IsOverseas then
            starText = 90000010990
            starImage = "tb_bn_sq"
        else
            starText = 90000010989
            starImage = "tb_bn_kh"
        end
        starIs = 1
    elseif starLevel == 11 then --红色
    elseif starLevel == 15 then --金色
        starText = 90000010991
        starImage = "tb_bn_hl"
        starIs = 1
    elseif starLevel == 19 then --彩色
        starText = 90000010992
        starImage = "tb_bn_lm"
        starIs = 1
    elseif starLevel > 19 and starLevel < 25 then -- 彩1 到 彩5
        starText = 90000011342
        starImage = "tb_bn_lm"
        starIs = 1
    end
    starIs = 0 --ZHJH-1085隐藏
    self.go_table.obj_Level:SetActiveE(starIs)
    if starIs == 1 then
        self.go_table.aortext_Text.text = _G.LangUtil.GetLangPackValue(starText)
        self.go_table.aorimage_Icon.SpriteName = starImage
    end
end

