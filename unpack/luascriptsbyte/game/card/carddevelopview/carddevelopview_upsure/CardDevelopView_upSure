local PropCardData = require("PropCardData")

---@class CardDevelopView_upSure : Component	中文描述
local CardDevelopView_upSure = _G.BaseClass("CardDevelopView_upSure", _G.UIBaseView)

local CS = _G.CS
local typeof = _G.typeof

---@field sids number[]
---@field CardData CardData
---@class Params_CardDevelopView_upSure

---创建对象时,入口构造函数
function CardDevelopView_upSure:OnCreate(mView, data)
    self.uiDic = {
        ---战力
        zl = _G.LangUtil.GetLangPackValue(90020300107),
        ---最大等级
        zddj = _G.LangUtil.GetLangPackValue(90020300106),
        ---确认
        qr = _G.LangUtil.GetLangPackValue(90020300105),
        ---升星消耗
        sxxh = _G.LangUtil.GetLangPackValue(90020300104)
    }

    self.mView = mView
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_infoItem:SetActiveE(0)

    self.go_table.aortext_Name1.text = self.uiDic.qr
    self.go_table.aortext_tips.text = self.uiDic.sxxh
    self:ShowView(data)
end

---@param Data Params_CardDevelopView_upSure
function CardDevelopView_upSure:ShowView(Data)
    self.gameObject:SetActiveE(1)

    local CardData = Data.CardData
    self:SetCardInfo(self.go_table.obj_cardL, CardData)
    CardData = _G.DeepCopy(CardData)
    CardData.star = CardData.star + 1
    CardData:OnUpdateBaseAttr()
    CardData:UpdataGetSkills()
    CardData:CalcNowSumProp()

    self:SetCardInfo(self.go_table.obj_cardR, CardData, true)

    local uid
    local len = #Data.sids
    local propData
    for i = 1, len do
        uid = Data.sids[i]
        propData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, uid)
        if propData then
            self:AddPropItem(self.go_table, uid, i)
        else
            self:AddCardItem(self.go_table, uid, i)
        end
    end

    for index, itemLua in pairs(self.go_table.itemLuaDic) do
        if itemLua ~= nil and itemLua ~= true then
            if index > len then
                itemLua.gameObject:SetActiveE(0)
            end
        end
    end
end

---@param CardData CardData
function CardDevelopView_upSure:SetCardInfo(obj, CardData, isUp)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.itemData = CardData
    if go_table.itemLua == nil then
        go_table.itemLua = true
        ---@param itemLua ItemCardBodyBaseView
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            go_table.obj_item,
            function(itemLua)
                go_table.itemLua = itemLua
                self:SetItemData(go_table)
            end
        )
    elseif go_table.itemLua ~= true then
        self:SetItemData(go_table)
    end

    local power = CardData:GetPower()
    local maxlv = 0
    local max_hp = 0
    local atk = 0
    local def = 0
    local bre = 0

    local starCfgItem = CardData:GetStarCfg()
    maxlv = starCfgItem.level_limit

    local att = CardData:GetSpecifyStarLvProp()

    max_hp = att[_G.AttrType.max_hp.key]
    atk = att[_G.AttrType.atk.key]
    def = att[_G.AttrType.def.key]
    bre = att[_G.AttrType.bre.key]

    ---战力
    self:AddText(go_table, self.uiDic.zl, power, isUp, 1)
    ---最大等级
    self:AddText(go_table, self.uiDic.zddj, maxlv, isUp, 2)
    self:AddText(go_table, _G.AttrType.max_hp.des, max_hp, isUp, 3)
    self:AddText(go_table, _G.AttrType.atk.des, atk, isUp, 4)
    self:AddText(go_table, _G.AttrType.def.des, def, isUp, 5)
    self:AddText(go_table, _G.AttrType.bre.des, bre, isUp, 6)
end

function CardDevelopView_upSure:AddText(go_table, name, num, isUp, index)
    if go_table.goTDic == nil then
        go_table.goTDic = {}
    end
    local goT
    if go_table.goTDic[index] == nil then
        local obj = _G.InstantiateObject(self.go_table.obj_infoItem, go_table.obj_infos)
        obj:SetActiveE(1)
        goT = _G.GetAutoGoTable(obj)
        go_table.goTDic[index] = goT
    else
        goT = go_table.goTDic[index]
    end

    goT.aortext_name.text = name
    ---ZHJ-19478 【角色】升星界面内，角色战力数值超过6位时没有转换单位
    goT.aortext_num.text = _G.GameUtil.NumberToUnitStrFight(num)
    goT.aorimage_up:SetActiveE(isUp and 1 or 0)
    goT.aorimage_bg:SetActiveE(index % 2 == 0 and 1 or 0)
end

function CardDevelopView_upSure:AddCardItem(go_table, uid, index)
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    if go_table.itemLuaDic == nil then
        go_table.itemLuaDic = {}
    end
    if go_table.itemDataDic == nil then
        go_table.itemDataDic = {}
    end
    go_table.itemDataDic[index] = card

    if go_table.itemLuaDic[index] == nil then
        go_table.itemLuaDic[index] = true
        ---@param itemLua ItemCardBodyBaseView
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_cards,
            function(itemLua)
                itemLua.gameObject:SetLocalScaleXYZ(0.6)
                go_table.itemLuaDic[index] = itemLua
                self:SetCardData(go_table, index)
                go_table.itemLuaDic[index]:HideOrShowLevel(true)
            end
        )
    elseif go_table.itemLuaDic[index] ~= true then
        self:SetCardData(go_table, index)
        go_table.itemLuaDic[index]:HideOrShowLevel(true)
    end
end

function CardDevelopView_upSure:SetItemData(go_table)
    local lua = go_table.itemLua
    local itemData = go_table.itemData
    lua:ShowCardData(itemData, nil, true)
end

function CardDevelopView_upSure:SetCardData(go_table, index)
    go_table.itemLuaDic[index].gameObject:SetActiveE(1)
    go_table.itemLuaDic[index]:ShowCardData(go_table.itemDataDic[index], nil, true, true)
end

function CardDevelopView_upSure:HideView()
    self.gameObject:SetActiveE(0)
end

function CardDevelopView_upSure:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        self.mView:ReadyUpStar2()
        self:Close()
    end
end

function CardDevelopView_upSure:AddPropItem(go_table, uid, index)
    local card = PropCardData.New()
    card:Parse({sid = uid})
    if go_table.itemLuaDic == nil then
        go_table.itemLuaDic = {}
    end
    if go_table.itemDataDic == nil then
        go_table.itemDataDic = {}
    end
    go_table.itemDataDic[index] = card

    if go_table.itemLuaDic[index] == nil then
        go_table.itemLuaDic[index] = true
        ---@param itemLua ItemCardBodyBaseView
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_cards,
            function(itemLua)
                itemLua.gameObject:SetLocalScaleXYZ(0.6)
                go_table.itemLuaDic[index] = itemLua
                self:SetCardData(go_table, index)
                go_table.itemLuaDic[index]:HideOrShowLevel(false)
            end
        )
    elseif go_table.itemLuaDic[index] ~= true then
        self:SetCardData(go_table, index)
        go_table.itemLuaDic[index]:HideOrShowLevel(false)
    end
end

---销毁对象时,析构函数
function CardDevelopView_upSure:OnDestroy()
end

return CardDevelopView_upSure
