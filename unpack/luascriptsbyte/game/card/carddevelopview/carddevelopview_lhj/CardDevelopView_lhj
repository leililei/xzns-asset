---@class CardDevelopView_lhj : UIBaseView
local CardDevelopView_lhj = _G.BaseClass("CardDevelopView_lhj", _G.UIBaseView)

local wuSid = 113020000
local shenSid = 116010000

function CardDevelopView_lhj:Awake()
    self.CardList = {}
    --- 当前数据数量
    self.oldCardNum = nil

    --- 当前五行 最高行  用于跳转当前行
    self.NowMaxUp_wu = 0
    self.NowMaxUp_shen = 0
    self:InitMaxStar()

    ---- 五行 模板卡

    self.list_wu = {}
    self.list_shen = {}

    self.CardData_wu = _G.CardData.New()
    self.CardData_wu:Parse({sid = wuSid, uid = wuSid, count = 1})
    local card_star_cfg = _G.ConfigManager.card_star_cfg

    ---@type CardData
    local card
    ---@type card_star_cfg
    local cfg
    local temp, len, tStar
    for i = 5, 23 do
        cfg = card_star_cfg[400 + i]
        if cfg ~= nil then
            temp = {}
            card = _G.DeepCopy(self.CardData_wu)
            card.star = cfg.star
            temp[1] = card

            tStar = cfg.materials_oneself[1]
            len = cfg.materials_oneself[2]
            temp[2] = {}
            if len ~= nil then
                card = _G.DeepCopy(self.CardData_wu)
                card.star = tStar
                for i = 1, len do
                    table.insert(temp[2], card)
                end
            end

            tStar = cfg.materials_elements[1]
            len = cfg.materials_elements[2]
            temp[3] = {}
            if len ~= nil then
                card = _G.DeepCopy(self.CardData_wu)
                card.star = tStar
                for i = 1, len do
                    table.insert(temp[3], card)
                end
            end

            table.insert(self.list_wu, temp)
        end
        -- body
    end

    ---- 神 模板卡
    self.CardData_shen = _G.CardData.New()
    self.CardData_shen:Parse({sid = shenSid, uid = shenSid, count = 1})
    for i = 5, 23 do
        cfg = card_star_cfg[600 + i]
        if cfg ~= nil then
            temp = {}
            card = _G.DeepCopy(self.CardData_shen)
            card.star = cfg.star
            temp[1] = card

            tStar = cfg.materials_oneself[1]
            len = cfg.materials_oneself[2]
            temp[2] = {}
            if len ~= nil then
                card = _G.DeepCopy(self.CardData_shen)
                card.star = tStar
                for i = 1, len do
                    table.insert(temp[2], card)
                end
            end

            tStar = cfg.materials_elements[1]
            len = cfg.materials_elements[2]
            temp[3] = {}
            if len ~= nil then
                card = _G.DeepCopy(self.CardData_shen)
                card.star = tStar
                for i = 1, len do
                    table.insert(temp[3], card)
                end
            end

            table.insert(self.list_shen, temp)
        end
        -- body
    end

    self.ui = {
        btn = {
            ---选中
            [1] = {
                txtColor = require("CardInfoManager").GetColorFromRGB("8C2D14"),
                image = "ui_ty_kuang_00"
            },
            ---未选中
            [2] = {
                txtColor = require("CardInfoManager").GetColorFromRGB("EEC398"),
                image = "ui_ty_kuang_01"
            }
        }
    }
end
---创建对象时,入口构造函数
function CardDevelopView_lhj:OnCreate(mView)
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lhj, false)
    ---@type CardInfoManager
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()
    self.go_table.looplist2_loop:InitListView(0, _G.handler(self, self.RefreshRenItem))
    self:ShowView()
end

function CardDevelopView_lhj:Dispose()
    self.go_table = nil
    self.mCardInfoManager = nil
end

function CardDevelopView_lhj:InitMaxStar()
    --- 当前五行 最高行  用于跳转当前行
    self.NowMaxUp_wu = 0
    self.NowMaxUp_shen = 0

    local cardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    for _, v in pairs(cardList) do
        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(v.cfg.Elements_new, 6) then
            if self.NowMaxUp_shen < v.star then
                self.NowMaxUp_shen = v.star
            end
        else
            if self.NowMaxUp_wu < v.star then
                self.NowMaxUp_wu = v.star
            end
        end
    end
end

function CardDevelopView_lhj:InitShowView()
    local row = 0
    if self.isWu then
        row = self.NowMaxUp_wu
    else
        row = self.NowMaxUp_shen
    end
    row = row - 5
    if row < 1 then
        row = 0
    end

    ---显示当前最高星+5
    local num = row + 6
    if num > #self.CardList then
        num = #self.CardList
    end

    if num ~= self.oldCardNum then
        self.oldCardNum = num
        self.go_table.looplist2_loop:SetListItemCount(self.oldCardNum, true)
    else
        self.go_table.looplist2_loop:RefreshAllShownItem()
    end

    self.go_table.looplist2_loop:MovePanelToItemIndex(row)
end

function CardDevelopView_lhj:ShowView()
    self:InitMaxStar()

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lhj, false)
    self.gameObject:SetActiveE(1)
    self.Timer_show =
        _G.DelayDo(
        0.3,
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_lhj, true)
            self:SetBtnisOn(true)
        end
    )
end
function CardDevelopView_lhj:SetBtnisOn(isWu)
    if isWu == self.isWu then
        return
    end
    self.isWu = isWu
    if isWu then
        self.CardList = self.list_wu
    else
        self.CardList = self.list_shen
    end

    self:SetBtn(isWu, self.go_table.aorimage_wu, self.go_table.aortext_wu)
    self:SetBtn(isWu == false, self.go_table.aorimage_shen, self.go_table.aortext_shen)
    local parameters = _G.ConfigManager.discrete_cfg[106706]
    local isUnlock= _G.GlobalConditionManager.CheckConditionArrays(parameters)
    self.go_table.aorbtn_wu:SetActiveE(BoolToNumber(isUnlock))
    self.go_table.aorbtn_shen:SetActiveE(BoolToNumber(isUnlock))

    self:InitShowView()
end

function CardDevelopView_lhj:SetBtn(isOn, image, txt)
    local type = isOn == true and 1 or 2
    image.SpriteName = self.ui.btn[type].image
    txt.color = self.ui.btn[type].txtColor
end

--初始化聊天iitem
---@param index int 该数据的索引   0起始
function CardDevelopView_lhj:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1

    local item = listView2:NewListViewItem("$_obj_ListItem")
    local CardDevelopView_lhj_CardItem = require("CardDevelopView_lhj_CardItem")
    local tCard = self:GetComponent(item, CardDevelopView_lhj_CardItem)
    if tCard == nil then
        tCard = self:AddComponent(item, CardDevelopView_lhj_CardItem.New(self))
    end
    local params = self.CardList[t_index]
    tCard:Init(params, t_index, true)

    return item
end

function CardDevelopView_lhj:HideView()
    if self.Timer_show ~= nil then
        _G.coroutine.stopwaiting(self.Timer_show)
        self.Timer_show = nil
    end
    self.gameObject:SetActiveE(0)
end

function CardDevelopView_lhj:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_CloseBtn" then
        -- self:HideView()
        self:Close()
    elseif go == self.go_table.aorbtn_wu then
        self:SetBtnisOn(true)
    elseif go == self.go_table.aorbtn_shen then
        self:SetBtnisOn(false)
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

--endregion

---销毁对象时,析构函数
function CardDevelopView_lhj:OnDestroy()
    if self.Timer_show ~= nil then
        _G.coroutine.stopwaiting(self.Timer_show)
        self.Timer_show = nil
    end
end

return CardDevelopView_lhj
