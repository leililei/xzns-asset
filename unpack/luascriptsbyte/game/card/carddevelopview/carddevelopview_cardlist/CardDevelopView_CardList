--region --------------------------------------CardList--------

---@class CardDevelopView_CardList : Component	中文描述
local CardDevelopView_CardList = _G.BaseClass("CardDevelopView_CardList", _G.Component)

function CardDevelopView_CardList:Awake()
    ---@type ItemCardBodySelectView[]
    self.mCarditemList = {}
end
---创建对象时,入口构造函数
function CardDevelopView_CardList:OnCreate(mView, count, call)
    self.mView = mView
    self.call = call
    self.MaxCount = count
    self.NowCount = 0
    for i = 1, self.MaxCount do
        self:LoadRed(i)
    end
end

function CardDevelopView_CardList:LoadRed(i)
    ------@param item ItemCardBodySelectView
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.HeadItem_Select,
        self.gameObject,
        function(item)
            if not self.mView or self.mView:IsNil() or not self.mCarditemList then
                _G.DestroyObject(item)
                return
            end
            item.gameObject:SetActiveE(0)
            item.transform:SetLocalPositionToZero()
            item.transform:SetLocalScale(1, 1, 1)

            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Common/common_redpoint",
                _G.ePoolType.Temporary,
                item.transform,
                function(tran)
                    if not self.mView or self.mView:IsNil() or not self.mCarditemList then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran:SetAnchorPosition(45, 50, 0)
                    item.go_table.obj_redpoint = tran
                    self.mCarditemList[i] = item
                    self:LoadComplete()
                end
            )

        end
    )
end

function CardDevelopView_CardList:LoadComplete()
    self.NowCount = self.NowCount + 1
    if self.NowCount ~= self.MaxCount then
        return
    end
    if self.call ~= nil then
        self.call(self.mCarditemList)
    end
end
function CardDevelopView_CardList:Dispose()
    self.mView = nil
end

---销毁对象时,析构函数
function CardDevelopView_CardList:OnDestroy()
    self.mCarditemList = nil
end

--endregion

return CardDevelopView_CardList
