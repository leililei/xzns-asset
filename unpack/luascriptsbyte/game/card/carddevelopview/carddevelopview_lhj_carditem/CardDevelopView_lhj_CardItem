--region --------------------------------------CardItem--------

---@class CardDevelopView_lhj_CardItem : Component	中文描述
local CardDevelopView_lhj_CardItem = _G.BaseClass("CardDevelopView_lhj_CardItem", _G.Component)

function CardDevelopView_lhj_CardItem:Awake()
    self.isSelect = false

    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))

    self.UiCfg = {
        ---+号 图标
        icon1 = {
            ---吃一个卡时位置
            [1] = {-159, -2},
            ---吃二个卡时位置
            [2] = {-159, -2}
        },
        ---  > 图标
        icon2 = {
            [1] = {105, 0},
            [2] = {105, 0}
        }
    }

    self.go_tableCard = {
        main = require("ItemCardAllView").New(self.go_table.obj_cardItem11),
        one = require("ItemCardAllView").New(self.go_table.obj_cardItem21),
        two = require("ItemCardAllView").New(self.go_table.obj_cardItem22),
        new = require("ItemCardAllView").New(self.go_table.obj_cardItem31)
    }
    self.mCardInfoManager = require("CardInfoManager"):GetInstance()
end

function CardDevelopView_lhj_CardItem:Dispose()
    self.go_table = nil
    self.go_tableCard = nil
    self.mCardInfoManager = nil
    self.mUpStarAllView = nil
end

---@param mView CardDevelopView
function CardDevelopView_lhj_CardItem:OnCreate(mView)
    self.mUpStarAllView = mView
end

---@param CardData CardData
---@param isAni boolean true (scale 0.8->1)
function CardDevelopView_lhj_CardItem:Init(CardDataList, index)
    self.index = index

    local mainCard = CardDataList[1]
    self:SetCard(self.go_tableCard.main, CardDataList[1])
    local temps = CardDataList[2]
    local card
    local tempCard = {}
    if not _G.table.isEmptyOrNil(temps) then
        for i = 1, #temps do
            _G.table.insert(tempCard, temps[i])
        end
    end
    temps = CardDataList[3]
    if not _G.table.isEmptyOrNil(temps) then
        for i = 1, #temps do
            _G.table.insert(tempCard, temps[i])
            temps[i].IsEle = true
            --- 如果是神 吃任意五行卡 不显示属性
            if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(temps[i].cfg.Elements_new,  6) then
                temps[i].IsAll = true
            end
        end
    end
    local isOne = false
    card = tempCard[1]
    if not _G.table.isEmptyOrNil(card) then
        self:SetCard(self.go_tableCard.one, card)
        self.go_tableCard.one:HideOrShowLevel(false)
        if card.IsEle then
            self.go_tableCard.one.go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
            self.go_tableCard.one.go_table.aorimage_jue.SpriteName = "ui_js_a_icon"
            self.go_tableCard.one.go_table.aorimage_eleBg:SetActiveE(0)
            self.go_tableCard.one.go_table.aorimage_professional:SetActiveE(0)
            self.go_tableCard.one.go_table.aorimage_type:SetActiveE(0)
            if self.go_tableCard.one.go_table.aorimage_type2 then
                self.go_tableCard.one.go_table.aorimage_type2:SetActiveE(0)
            end
        end
        self.go_tableCard.one:HideOrShowElements(card.IsAll ~= true and true or false)

        isOne = true
    end
    _G.GameUtil.SetActiveByCondition(self.go_tableCard.one.gameObject, isOne)
    isOne = false

    card = tempCard[2]
    if not _G.table.isEmptyOrNil(card) then
        self:SetCard(self.go_tableCard.two, card)
        self.go_tableCard.two:HideOrShowLevel(false)
        if card.IsEle then
            self.go_tableCard.two.go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
            self.go_tableCard.two.go_table.aorimage_jue.SpriteName = "ui_js_a_icon"
            self.go_tableCard.two.go_table.aorimage_eleBg:SetActiveE(0)
            self.go_tableCard.two.go_table.aorimage_professional:SetActiveE(0)
            self.go_tableCard.two.go_table.aorimage_type:SetActiveE(0)
            if self.go_tableCard.two.go_table.aorimage_type2 then
                self.go_tableCard.two.go_table.aorimage_type2:SetActiveE(0)
            end
        end

        self.go_tableCard.two:HideOrShowElements(card.IsAll ~= true and true or false)
        isOne = true
    end

    local xy = self.UiCfg.icon1[isOne == true and 2 or 1]
    self.go_table.aorimage_icon1:SetAnchorPosition(xy[1], xy[2], 0)
    xy = self.UiCfg.icon2[isOne == true and 2 or 1]
    self.go_table.aorimage_icon2:SetAnchorPosition(xy[1], xy[2], 0)

    _G.GameUtil.SetActiveByCondition(self.go_tableCard.two.gameObject, isOne)

    local newCard = _G.DeepCopy(mainCard)
    newCard.star = newCard.star + 1
    self:SetCard(self.go_tableCard.new, newCard)

    self:InitData()
end

function CardDevelopView_lhj_CardItem:InitData()
end
function CardDevelopView_lhj_CardItem:SetCard(lua, CardData)
    if CardData ~= nil then
        lua:ShowCardData(CardData)
        lua:HideOrShowLevel(true)
        _G.GameUtil.SetActiveByCondition(lua.go_table.aorimage_black, false)
    end
end
function CardDevelopView_lhj_CardItem:UpdataCardCount(num, go_tableCard)
    if go_tableCard ~= nil then
        self:SetCountText(go_tableCard.go_table.aortext_num, num)
    end
    return
end
function CardDevelopView_lhj_CardItem:SetCountText(aortext, num)
    if aortext == nil then
        return
    end
    aortext.text = string.format("%d/%d", num, num)
end

function CardDevelopView_lhj_CardItem:OnClick_bg()
end

-- 按钮单击事件--
function CardDevelopView_lhj_CardItem:OnClickBtn(go, isOn)
    if _G.IsNil(go) then
        return
    end

    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("CardDevelopView_lhj_CardItem>>ClickBtn>>" .. name)
    end
end

function CardDevelopView_lhj_CardItem:OnDisable()
end
function CardDevelopView_lhj_CardItem:OnDestroy()
end

--endregion

return CardDevelopView_lhj_CardItem
