---@class CardFetterData	中文描述
---@field sid number 卡牌sid
---@field cfg card_cfg 卡牌配置
---@field fetterList CardFetterData_ItemData[] 羁绊内容
local CardFetterData = _G.BaseClass("CardFetterData")

---@class CardFetterData_ItemData
---@field desc number 激活描述
---@field att table 激活后的属性
---@field condition_star number  激活条件
---@field active boolean 激活
---@field canActive boolean 是否可激活
---@field count number 满足条件的数量
---@field allCount number 总数量
---激活数量
local Fetter_Count = 3
---类的构造函数
function CardFetterData:__init(cfg)
    self:Parse(cfg)
end

---@param cfg card_cfg
function CardFetterData:Parse(cfg)
    self.sid = cfg.id
    self.cfg = cfg
    self.activeAllDic = {}
    self:InitFetterList()
end

---初始化羁绊数据
function CardFetterData:InitFetterList()
    self.fetterList = {}
    local cfgs = _G.ConfigManager.card_fetter_cfg
    local CardFetterManager = require "CardFetterManager":GetInstance()
    ---@type card_fetter_cfg
    local cfg
    for i = 1, #self.cfg.fetter do
        cfg = cfgs[self.cfg.fetter[i]]
        if cfg then
            self.fetterList[cfg.id] = {}
            local isActiveAll = true
            for j = 1, Fetter_Count do
                self.fetterList[cfg.id][j] = {
                    att = cfg["att" .. j],
                    desc = cfg["desc" .. j],
                    condition_star = cfg["condition_star" .. j],
                    active = CardFetterManager:CheckIsActive(self.sid, cfg.id, j),
                    allCount = #cfg.cards
                }
                self.fetterList[cfg.id][j].canActive, self.fetterList[cfg.id][j].count =
                    self:CheckIsCanActive(cfg.id, j)
                if not self.fetterList[cfg.id][j].active then
                    isActiveAll = false
                end
            end
            if isActiveAll then
                self.activeAllDic[cfg.id] = true
            end
        end
    end
end

---获取已激活属性
function CardFetterData:GetActiveAttr()
    if not self.attribute then
        self:UpdateActiveAttr()
    end
    return self.attribute
end
---更新属性
function CardFetterData:UpdateActiveAttr()
    ---@type AttributeClassManager
    local attributeManager = _G.AttributeClassManager:GetInstance()
    self.attribute = attributeManager:GetAttribtueClass()
    for _, v in pairs(self.fetterList) do
        for _, v2 in pairs(v) do
            if v2.active then
                for _, v3 in pairs(v2.att) do
                    if _G.tonumber(v3[2]) == 1 then
                        self.attribute:AddValueByName(
                            v3[1],
                            attributeManager:GetValueWithName(v3[1], v3[3], _G.tonumber(v3[2])),
                            nil,
                            3
                        )
                    else
                        self.attribute:AddValueByName(
                            v3[1],
                            attributeManager:GetValueWithName(v3[1], v3[3], _G.tonumber(v3[2])),
                            nil,
                            _G.tonumber(v3[2])
                        )
                    end
                end
            end
        end
    end
end

---检测是否可以激活
function CardFetterData:CheckIsCanActive(fetter_sid, index)
    if require "CardFetterManager":GetInstance():CheckIsActive(self.sid, fetter_sid, index) then
        return false
    end
    ---@type card_fetter_cfg
    local cfg = _G.ConfigManager.card_fetter_cfg[fetter_sid]
    local data = self.fetterList[fetter_sid][index]
    local card
    local count = 0
    local result = true
    for _, v in pairs(cfg.cards) do
        card = _G.StorageManager:GetInstance():GetMaxStarCardBySid(v)
        if not card or card.star < data.condition_star then
            result = false
        else
            count = count + 1
        end
    end
    return result, count
end

---设置激活
function CardFetterData:SetActive(fetter, index)
    if not self.fetterList[fetter] or not self.fetterList[fetter][index] then
        return
    end
    self.fetterList[fetter][index].canActive = false
    self.fetterList[fetter][index].active = true
    local isActiveAll = true
    for _, v in pairs(self.fetterList[fetter]) do
        if not v.active then
            isActiveAll = false
        end
    end
    if isActiveAll then
        self.activeAllDic[fetter] = true
    end
end
---检测是否激活全部
function CardFetterData:CheckIsActiveAll(fetter)
    return self.activeAllDic[fetter]
end

---获取羁绊列表
---@return CardFetterData_ItemData[]
function CardFetterData:GetFetterList(fetterId)
    return self.fetterList[fetterId]
end

---获取激活内容
---@return CardFetterData_ItemData
function CardFetterData:GetFetterItemData(fetterId, index)
    if not self.fetterList[fetterId] then
        return nil
    end
    return self.fetterList[fetterId][index]
end

---获取可激活id表
function CardFetterData:GetCanActiveIds()
    local tb = {}
    local insert = _G.table.insert
    for k, v in pairs(self.fetterList) do
        for i, v2 in pairs(v) do
            if v2.canActive then
                if not tb[k] then
                    tb[k] = {fetter_sid = k, index = {}}
                end
                insert(tb[k].index, i)
            end
        end
    end
    return _G.table.toArray(tb)
end

function CardFetterData:GetName(index)
    if not _G.ConfigManager.card_fetter_cfg[self.cfg.fetter[index]] then
        return ""
    end
    return _G.ConfigManager.card_fetter_cfg[self.cfg.fetter[index]].name
end

---类的析构函数
function CardFetterData:Dispose()
    self.cfg = nil
    self.sid = nil
    self.fetterList = nil
end
---更新是否可以激活状态
function CardFetterData:CheckHasActive()
    for _, v in pairs(self.fetterList) do
        for _, v2 in pairs(v) do
            if v2.canActive then
                return true
            end
        end
    end
    return false
end
---更新是否可以激活状态
function CardFetterData:UpdateCanActiveState(fetter)
    if fetter then
        if self.fetterList[fetter] then
            for i, v2 in pairs(self.fetterList[fetter]) do
                if not v2.active then
                    v2.canActive, v2.count = self:CheckIsCanActive(fetter, i)
                end
            end
        end
    else
        for k, v in pairs(self.fetterList) do
            for i, v2 in pairs(v) do
                if not v2.active then
                    v2.canActive, v2.count = self:CheckIsCanActive(k, i)
                end
            end
        end
    end
end

---检测某个物体是否可以更新
function CardFetterData:CheckCanActiveSingleState(fetter_sid, index)
    if not self.fetterList or not self.fetterList[fetter_sid] then
        return false
    end
    if not index then
        for _, v in pairs(self.fetterList[fetter_sid]) do
            if v.canActive then
                return true
            end
        end
        return false
    else
        if not self.fetterList[fetter_sid][index] then
            return false
        end
        return self.fetterList[fetter_sid][index].canActive
    end
end

return CardFetterData
