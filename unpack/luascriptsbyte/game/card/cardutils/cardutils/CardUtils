---获取筛选后的英雄列表
---@param element CardProfType
---@param StorageCard CardData[]
---@return CardData[]
function CardUtils.GetFilteredList_Card(StorageCard,element,Quality)
    if element == CardProfType.None and Quality == nil then
        return StorageCard
    else
        local newStorageCard = {}
        if element == CardProfType.None then
            ---@param data CardData
            newStorageCard = table.chooseToArray(
                    StorageCard,
                    function(_,data)
                        if Quality == data.cfg.Order then
                            return true
                        end
                        return false
                    end
            )
        else
            ---@param data CardData
            newStorageCard = table.chooseToArray(
                    StorageCard,
                    function(_,data)
                        if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(data.cfg.Elements_new, element) and Quality == data.cfg.Order then
                            return true
                        end
                        return false
                    end
            )
        end
        return newStorageCard
    end
end

---获取筛选后的英雄列表
---@param element CardProfType
---@param orderDict table<number,boolean>
---@param StarDict table<number,boolean>
---@param StorageCard CardData[]
---@return CardData[]
function CardUtils.GetFilteredDict_Card(StorageCard,element,orderDict,StarDict)
    ---@param data CardData[]
    local newStorageCard = {}
    if element == CardProfType.None then
        ---@param data CardData
        newStorageCard = table.chooseToArray(
            StorageCard,
            function(_,data)
                if orderDict[data.cfg.Order] and StarDict[data.star] then
                    return true
                end
                return false
            end
        )
    else
        ---@param data CardData
        newStorageCard = table.chooseToArray(
            StorageCard,
            function(_,data)
                if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(data.cfg.Elements_new, element) and orderDict[data.cfg.Order] and StarDict[data.star] then
                    return true
                end
                return false
            end
        )
    end

    return newStorageCard
end

---获取筛选后的英雄列表
---@param element CardProfType
---@param FilterList table<number,number,boolean>
---@param cardData CardData 想排除的英雄
---@param StorageCard CardData[]
---@return CardData[]
function CardUtils.GetFilteredFilterList_Card(StorageCard,element,FilterList,cardData)
    ---@param data CardData[]
    local newStorageCard = {}
    if element == CardProfType.None then
        ---@param data CardData
        newStorageCard = table.chooseToArray(
                StorageCard,
                function(_,data)
                    if cardData and cardData.sid == data.sid then
                        return false
                    end
                    if FilterList[data.cfg.Order] and FilterList[data.cfg.Order][data.star] then
                        return true
                    end
                    return false
                end
        )
    else
        ---@param data CardData
        newStorageCard = table.chooseToArray(
                StorageCard,
                function(_,data)
                    if cardData and cardData.sid == data.sid then
                        return false
                    end
                    if require "CardInfoManager":GetInstance():CheckMultiMatchCOP(data.cfg.Elements_new, element) and FilterList[data.cfg.Order] and FilterList[data.cfg.Order][data.star] then
                        return true
                    end
                    return false
                end
        )
    end

    return newStorageCard
end

---@return CardData[] 获取可置换的角色列表
function CardUtils.GetUserRedundantCharacters()
    ---@type CardData[]
    local StorageCard = _G.StorageManager:GetInstance():GetCardDataSortList()
    if StorageCard == nil or #StorageCard == 0 then
        return {}
    end

    local count = #StorageCard
    ---@type table<number,CardData>
    local maxStarCardDict = {}
    local cardList = {}
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    for i = 1, count do
        local data = StorageCard[i]
        if  CardInfoManager:IsMaxUpStar(data) then
            maxStarCardDict[data.sid] = data
        end
    end

    for i = 1, count do
        local data = StorageCard[i]
        if maxStarCardDict[data.sid] and data.uid ~= maxStarCardDict[data.sid].uid then
            table.insert(cardList,data)
        end
    end

    return cardList
end

