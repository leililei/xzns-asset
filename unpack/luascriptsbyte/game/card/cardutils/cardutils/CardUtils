--加载神环
function CardUtils.LoadGod_halo(trans,sid,data)
    if _G.AppSetting.IsXzns then
        local godHaloID = 0
        if sid == nil and data and data.god_halo then
            godHaloID = data.god_halo
        else
            godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(sid)
        end
        if godHaloID ~= 0 then
            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
            --- 神环路径，父级路径(加载角色的下面)
            _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
        end
    end
end

return CardUtils