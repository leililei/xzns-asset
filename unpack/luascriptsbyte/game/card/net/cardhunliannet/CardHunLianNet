require "BaseGameNet"
require "net_map"

---@class CardHunLianNet : BaseGameNet	通信协议
local CardHunLianNet = _G.BaseClass("CardHunLianNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return CardHunLianNet CardHunLianNet
function CardHunLianNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---魂链升级 发送数据
---@param pbData table PB数据
---@param callback function 完成回调
function CardHunLianNet:CardHunLianLevelUp(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_soul_chain_level_up
    local port = base.Access(self, item, pbData, _G.handler(self, self.CardHunLianLevelUpCall))
    self.Call[port] = callback
end

---魂链升级 接收回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CardHunLianNet:CardHunLianLevelUpCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
