local base = require("BaseGameNet")

---@class CardPotentialNet : BaseGameNet	通信协议
local CardPotentialNet = _G.BaseClass("CardPotentialNet", base)
---@return CardPotentialNet CardPotentialNet
function CardPotentialNet:GetInstance()
    return base.GetInstance(self)
end

function CardPotentialNet:CardPotentialUp(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_card_awaken
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function CardPotentialNet:CardPotentialReset(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_card_awaken_reset
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CardPotentialNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CardPotentialNet
