require "BaseGameNet"

---@class CardInfoNet : BaseGameNet	通信协议
local CardInfoNet = _G.BaseClass("CardInfoNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return CardInfoNet CardInfoNet
function CardInfoNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求回调 通用 返回 ack 字符Call
---@param port number 流水号Card
---@param data table 返回PB数据
---@param error string 错误信息
function CardInfoNet:CardCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---请求 卡牌升级
---@param pbData card.c2s_card_up_exp PB数据
---@param callback function 完成回调
function CardInfoNet:CardUpLevel(pbData, callback)
    if _G.ConfigManager.net_map.game_card_card_up_lv == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 协议非最新")
        end
        return
    end
    local item = _G.ConfigManager.net_map.game_card_card_up_lv
    local port = base.Access(self, item, pbData, _G.handler(self, self.CardCall))
    self.Call[port] = callback
end

