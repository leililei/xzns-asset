local base = require("BaseGameNet")

---@class CardConvertNet : BaseGameNet	通信协议
---@field GetInstance fun():CardConvertNet
local CardConvertNet = _G.BaseClass("CardConvertNet", base)

---请求回调 通用 返回 ack 字符Call
---@param port number 流水号Card
---@param data table 返回PB数据
---@param error string 错误信息
function CardConvertNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---转化
---@param pbData card.c2s_card_exchange_item PB数据
---@param callback fun(msg:public.s2c_common_ack):void 完成回调
function CardConvertNet:Convert(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_card_exchange_item
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

return CardConvertNet
