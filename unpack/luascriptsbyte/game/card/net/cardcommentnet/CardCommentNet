---@class CardCommentNet : BaseGameNet	通信协议
local base = require("BaseGameNet")
local CardCommentNet = _G.BaseClass("CardCommentNet", base)

---@return CardCommentNet CardCommentNet
function CardCommentNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function CardCommentNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CardCommentNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---获取卡牌评论大数据签名
---@param callback function 完成回调
function CardCommentNet:GetCommentToken(callback)
    self:Access(_G.ConfigManager.net_map.game_card_port_get_card_score_sign, self:GetEmptyPB(), callback)
end

---获取卡牌皮肤信息
---@param callback function 完成回调
function CardCommentNet:GetSkinInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_skin_info, self:GetEmptyPB(), callback)
end
---替换卡牌皮肤
---@param callback function 完成回调
function CardCommentNet:GetSkinChange(pbdata, callback)
    self:Access(_G.ConfigManager.net_map.game_skin_game, pbdata, callback)
end

---@type CardCommentNet
return CardCommentNet
