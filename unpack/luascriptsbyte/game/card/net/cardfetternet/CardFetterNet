local base = require "BaseGameNet"

---@class CardFetterNet : BaseGameNet	角色羁绊
local CardFetterNet = _G.BaseClass("CardFetterNet", base)

---@return CardFetterNet CardFetterNet
function CardFetterNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取已解锁羁绊信息
function CardFetterNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_card_port_get_fetter
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---激活羁绊
---@param pbData card.c2s_card_unlock_fetter
function CardFetterNet:Active(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_port_unlock_fetter
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CardFetterNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type CardFetterNet
_G.CardFetterNet = CardFetterNet
return CardFetterNet
