local SeasonTowerCardBagView = _G.BaseClass("SeasonTowerCardBagView", _G.UIBaseView)

local itemid = 209050001

function SeasonTowerCardBagView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function SeasonTowerCardBagView:OnCreate(...)
    self.towerModel = require "SeasonTowerModel":GetInstance()
    local args = {...}
    itemid = _G.tonumber(self.towerModel.reviveParams[1])
    self.CardType = {
        {"卡牌类型", 0},
        {_G.ConfigManager.language_package_cfg[90000900101], 1},
        {_G.ConfigManager.language_package_cfg[90000900201], 2}
    }
    self.CardElements = {
        {"卡牌五行", 0},
        {_G.ConfigManager.language_package_cfg[90000200101], 1},
        {_G.ConfigManager.language_package_cfg[90000200201], 2},
        {_G.ConfigManager.language_package_cfg[90000200301], 3},
        {_G.ConfigManager.language_package_cfg[90000200401], 4},
        {_G.ConfigManager.language_package_cfg[90000200501], 5},
        {_G.ConfigManager.language_package_cfg[90020300048], 6}
    }

    self.sx_Elements = 0
    self.sx_UnitType = 0

    self.itemObjDic = {}
    self.itemTransLuaDic = {}

    self.rebirth = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, itemid)
    if _G.table.isEmptyOrNil(self.rebirth) or self.rebirth == nil then
        self.rebirth = {}
        self.rebirth.cfg = {}
        self.rebirth.cfg = _G.ConfigManager.item_cfg[itemid]
        self.rebirth.count = 0
    end
    self.go_table.aorrawimage_icon:LoadImage(self.rebirth.cfg.Icon)
    --self.StorageCard = _G.StorageManager:GetInstance():GetCardDataSortList()
    self.StorageCard = {}
    self.StorageCard = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    self:StarSx()

    if _G.AppSetting.DEBUG then
        _G.Log(#self.nowCardList, "卡牌数据长度")
    end

    _G.SortList(
        self.nowCardList,
        function(item)
            return item.lv, item.power, item.star, item.cfg.Order, item.sid, item.uid
        end
    )
    self.go_table.scrollloopvectical_CardBag:InitItemData(0, _G.handler(self, self.RefreshBagItem))
    self:InitElement()
    self:UpdateRebirth()
    --配置表 最大 怒气值
    --self.MpLimit = _G.ConfigManager.battle_skill_cfg[6]
    self:AddListener(_G.eSeasonTower.SeasonTowerRefeshModel, self.RefreshBag)
end

function SeasonTowerCardBagView:RefreshBag()
    self.go_table.scrollloopvectical_CardBag:UpdateAllItem()
end

function SeasonTowerCardBagView:UpdateRebirth()
    if self.rebirth.count == nil then
        --.. _G.GetLangPackValue(90025800011)
        -- body
        self.go_table.aortext_num.text = 0
    else
        self.go_table.aortext_num.text = self.rebirth.count --.. _G.GetLangPackValue(90025800011)
    end
    --self.go_table.aorbtn_queding:SetGray(self.rebirth.count <= 0)
    --local flag = self.rebirth.count <= 0
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_queding, not flag)
    -- self.go_table.aorbtn_queding:SetActiveE(0)
end
function SeasonTowerCardBagView:InitElement()
    self.ElementTb = _G.GetAutoGoTable(self.go_table.obj_Elements, _G.handler(self, self.OnClickElement))
    self.ElementTb.toggle_0.isOn = false
    self.ElementTb.toggle_0.isOn = true
end

---点击元素
function SeasonTowerCardBagView:OnClickElement(go, isOn)
    if not isOn then
        return
    end
    local name = go:GetName()
    local s_type = _G.string.replace(name, "$_toggle_", "")
    local type = _G.tonumber(s_type)
    self.sx_Elements = self.CardElements[type + 1][2]
    self:StarSx()
    if self.Elements == type then
        return
    end
    if #self.nowCardList > 0 then
        self:ClickTag2(type)
    else
        --self.sx_Elements = self.CardElements[self.Elements + 1][2]
        --self:StarSx()
        self.ElementTb["toggle_" .. self.Elements].isOn = true
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
    end
end

---@param index int 该数据的索引   0起始
function SeasonTowerCardBagView:RefreshBagItem(index, obj)
    if index < 0 then
        return
    end

    local id = obj:GetInstanceIDE()
    local DungonesBagCardItem = self.itemObjDic[id]
    if not DungonesBagCardItem then
        DungonesBagCardItem = require("SeasonTowerCardBagItem").New(obj, _G.handler(self, self.OnCardBodyClick_bg))
        self.itemObjDic[id] = DungonesBagCardItem
    end
    -- _G.GameUtil.SetActiveByCondition(obj, false)
    local t_index = index + 1

    if _G.GuideManager:GetInstance().IsGuideing then
        obj:SetName(t_index)
    end

    local params = self.nowCardList[t_index]
    self.itemTransLuaDic[params.uid] = DungonesBagCardItem
    DungonesBagCardItem:Show(params, t_index, false)
    if _G.AppSetting.DEBUG then
        _G.Log(params.uid, "卡片uid")
    end
end

function SeasonTowerCardBagView:OnCardBodyClick_bg(parmas)
    if tonumber(parmas[1]) == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" CardBagView.OnCardBodyClick_bg 参数有误")
        end
        return
    end
end

function SeasonTowerCardBagView:StarSx()
    ---@param CardData CardData
    self.nowCardList =
        _G.table.chooseToArray(
        self.StorageCard,
        function(_, CardData)
            if self.sx_UnitType ~= 0 then
                if CardData.cfg.UnitType ~= self.sx_UnitType then
                    return false
                end
            end
            if self.sx_Elements ~= 0 then
                if not require "CardInfoManager":GetInstance():CheckMultiMatchCOP(CardData.cfg.Elements_new, self.sx_Elements) then
                    return false
                end
            end

            return true
        end
    )
end

function SeasonTowerCardBagView:ClickTag1(value)
    if _G.AppSetting.DEBUG then
        _G.Log(value, "卡牌类型")
    end
    self.sx_UnitType = self.CardType[value + 1][2]
    self:StarSx()

    if _G.AppSetting.DEBUG then
        _G.Log(#self.nowCardList, "卡牌数量")
    end
    _G.SortList(
        self.nowCardList,
        function(item)
            return item.lv, item.power, item.star, item.cfg.Order, item.sid, item.uid
        end
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_nil, #self.nowCardList <= 0)
    self.go_table.scrollloopvectical_CardBag:UpdateCount(#self.nowCardList)
end

function SeasonTowerCardBagView:ClickTag2(value)
    if _G.AppSetting.DEBUG then
        _G.Log(value, "卡牌五行")
    end
    self.sx_Elements = self.CardElements[value + 1][2]
    self:StarSx()
    _G.SortList(
        self.nowCardList,
        function(item)
            return item.lv, item.power, item.star, item.cfg.Order, item.sid, item.uid
        end
    )

    if _G.AppSetting.DEBUG then
        _G.Log(#self.nowCardList, "卡牌数量")
    end
    --  _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_nil, #self.nowCardList <= 0)
    if #self.nowCardList > 0 then
        self.go_table.scrollloopvectical_CardBag:UpdateCount(#self.nowCardList)
        self.Elements = value
    end
end

---主要界面点击事件
function SeasonTowerCardBagView:OnClickBtn(go, IsOn)
    if _G.AppSetting.DEBUG then
        _G.Log(go, "点击千机按钮事件")
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_queding then
        if not self.rebirth.count or self.rebirth.count <= 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.tonumber(self.towerModel.reviveParams[1]))

            --TODO 出现提示
            -- _G.PopWindowManager:GetInstance():ShowAllTips(820102)
            return
        end
        --TODO 二次确认框
        _G.PopWindowManager:GetInstance():ShowAllTips(
            820304,
            nil,
            function()
                self.towerModel:ReviveCard(
                    function()
                        _G.StorageManager:GetInstance():ConsumeItem(itemid, nil, 1)
                        self.go_table.scrollloopvectical_CardBag:UpdateAllItem()
                        self:UpdateRebirth()
                    end
                )
            end
        )
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

---销毁对象时,析构函数
function SeasonTowerCardBagView:OnDestroy()
    self.tag1 = nil
    self.tag2 = nil
end
return SeasonTowerCardBagView
