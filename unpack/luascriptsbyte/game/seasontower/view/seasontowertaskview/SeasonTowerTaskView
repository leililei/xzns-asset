---@class SeasonTowerTaskView : UIBaseView	中文描述
---@field public go_table SeasonTowerTaskView_GoTable GoTable
local SeasonTowerTaskView = _G.BaseClass("SeasonTowerTaskView", _G.UIBaseView)
--_G.SeasonTowerTaskView = SeasonTowerTaskView

local GetLangPackValue=_G.GetLangPackValue

function SeasonTowerTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonTowerTaskView:OnCreate()
    self.towerModel = require "SeasonTowerModel":GetInstance()
    self.passCount = self.towerModel:GetPassTowerCount()
    self:UpdateView()
end
---更新界面
function SeasonTowerTaskView:UpdateView()
    self.go_table.aortext_floor.text =GetLangPackValue(90037010134, self.passCount)
    self.taskAwardList = {}
    self.taskAward = self.towerModel:GetStoreCfg().content
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.taskAward, _G.handler(self, self.RefreTaskAwardItem))
end
---刷新奖励
function SeasonTowerTaskView:RefreTaskAwardItem(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskAwardList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem))
    end
    local cfg = _G.ConfigManager.store_season_battlecon_cfg[self.taskAward[index + 1]]
    if not tb.item then
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, nil, 88)
    end
    local isGet = self.towerModel:CheckAwrdIsGet(cfg.id)
    tb.item:ShowWithID(
        cfg.rewards_pay[1],
        nil,
        function()
            tb.item.item:SetGouScroll(isGet)
            if self.towerModel.isBuy and not isGet and cfg.conditions[2] <= self.passCount then
                tb.item.item:ShowEffectOrder(true)
            end
        end
    )
    tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(cfg.rewards_pay[1][1])
    tb.aortext_num.text ="X".. cfg.rewards_pay[1][2]
    tb.aortext_floor.text = GetLangPackValue(90037010115,cfg.conditions[2])
    obj:SetName(self.taskAward[index])
end

---按钮点击事件在这里派发
function SeasonTowerTaskView:OnClickBtn()
    self:Close()
end

return SeasonTowerTaskView
