        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name, _G.CommonRankType.SeasonTower)
    elseif go == self.go_table.aorbtn_match then
        self.go_table.aorbtn_match:SetActiveE(0)
