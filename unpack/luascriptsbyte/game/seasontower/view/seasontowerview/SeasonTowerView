local SeasonTowerView = _G.BaseClass("SeasonTowerView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function SeasonTowerView:Awake()
    self.buffItemList = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSeasonTower.SeasonTowerRefreshView, self.SetIsUpdate)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.CheckBuffAndUpdateView)
end

function SeasonTowerView:SetIsUpdate(refsult)
    if refsult == nil then
        self:CheckBuffAndUpdateView()
        return
    end
    if not refsult then
        return
    end
    if self.gameObject:GetActiveSelf() == 1 then
        self.go_table.obj_mask:SetActiveE(1)
        self:ShowChuansongmen(function()
            self:EnterNextFloor()
        end)
        -- self.co =
        --     _G.DelayDo(
        --     0.5,
        --     function()
        --         self:EnterNextFloor()
        --     end
        -- )
    else
        self.isUpdate = true
    end
end

function SeasonTowerView:OnEnable()
    if self.isUpdate then
        self.go_table.obj_mask:SetActiveE(1)
        self.co = _G.DelayDo(
                0.5,
                function()
                    if self:IsNil() then
                        return
                    end
                    self:EnterNextFloor()
                end
        )
        self.isUpdate = nil
    end
end

---界面的入口函数
function SeasonTowerView:OnCreate()
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.SeasonTowerView, self.go_table)
    self.towerModel = require "SeasonTowerModel":GetInstance()
    self.offset = 0
    self:CheckBuffAndUpdateView()
    self.towerModel:SetFirst()
    -- self.ani = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    if not _G.IsNil(_G.ConfigManager.ui_cfg.SeasonTowerView.resources) then
        self:AddComponent(
                self.go_table.obj_gold,
                require("ResourceCompont").New(self.go_table.obj_gold, _G.ConfigManager.ui_cfg.SeasonTowerView.resources)
        )
    end
end

function SeasonTowerView:CheckBuffAndUpdateView()
    if self.towerModel.isOverStage or self:CheckHasSelfBuff() then
        self:UpdateView()
    else
        self.towerModel:ChooseBuff()
    end
end

---检测是否有buff
function SeasonTowerView:CheckHasSelfBuff()
    if self.towerModel.isOverStage and not self.towerModel:CheckIsAllStage() then
        return false
    end
    return self.towerModel:GetBuff().boss_buff and #self.towerModel:GetBuff().boss_buff > 0 or false
end

---更新界面
function SeasonTowerView:UpdateView()
    self.stage = self.towerModel.stage
    self.stageCfg = self.towerModel:GetStageCfg()
    self.towerId = self.towerModel.curTowerId > 0 and self.towerModel.curTowerId or self.stageCfg.season_tower[1]
    if self.towerModel.isOverStage and not self.towerModel:CheckIsAllStage() then
        self.stage = self.stage + 1
        self.stageCfg = _G.ConfigManager.season_tower_pools_cfg[self.stage]
        self.towerId = self.stageCfg.season_tower[1]
    end
    self:ShowMonster()
    self:UpdateBuffList()
    self:InitBg()
    self:InitMid()
    self:InitEffect()
    ---@type season_tower_cfg
    local cfg = _G.ConfigManager.season_tower_cfg[self.towerId]
    self.go_table.aortext_floor.text = GetLangPackValue(90037010103, cfg.layer)
    self.go_table.aortext_stageNum.text = GetLangPackValue(90026100020, cfg.stage)
    --90037010130
    -- self.go_table.aortext_max.text = GetLangPackValue(90037010130, self.towerModel:GetStageMaxFloor())
end

