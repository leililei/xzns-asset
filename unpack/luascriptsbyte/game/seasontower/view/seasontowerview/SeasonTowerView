function SeasonTowerView:LoadEffect(name, parent, isGui)
    if _G.string.IsNullOrEmpty(name) then
        return
    end
    if not self.effectTb[name] then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg[name],
                parent,
                function(obj)
                    if self:IsNil() then
                        _G.DestroyObject(obj)
                        return
                    end
                    self.effectTb[name] = obj
                    self.gameObject:SetActiveE(1)
                    if isGui then
                        self.gui = name
                    end
                end
        )
    else
        self.effectTb[name]:SetActiveE(1)
    end
end

function SeasonTowerView:InitMid()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.towerModel.isOverStage and not self.towerModel:CheckIsAllStage() then
        self.go_table.obj_lock:SetActiveE(1)
        -- self.go_table.aorrawimage_lock:SetActiveE(1)
        local nextStageCfg = _G.ConfigManager.season_tower_pools_cfg[self.towerModel.stage + 1]
        local endTime = self.towerModel:GetStartTime() + (nextStageCfg.time - 1) * 86400
        local time = _G.TimeUtil.GetServerUnixTime()
        if time >= endTime then
            self.go_table.obj_lockTime:SetActiveE(0)
            self.go_table.aorbtn_match:SetActiveE(1)
        else
            self.RTS = endTime - time
            self:UpdateTimerShow(true)
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimerShow, self, false, false, true, false)
            self.timer:Start()
            -- self.go_table.aorrawimage_lock:SetActiveE(1)
            self.go_table.obj_lockTime:SetActiveE(1)
        end
        self:InitEffect()

        self.go_table.aortext_lockdesc.text = GetLangPackValue(90037010104, self.towerModel.stage + 1)
        self.go_table.aortext_lv.text = GetLangPackValue(90025501110, self.towerModel.stage + 1)
        self.go_table.aorbtn_RestartDo:SetActiveE(0)
        self.go_table.obj_wait:SetActiveE(1)
        self.go_table.aortext_wait.text = GetLangPackValue(90037010126)
        self.go_table.aortext_nextSumLayer.text = GetLangPackValue(90037010152, self.towerModel:GetNextStageMaxFloor())
        self.go_table.obj_unlock:SetActiveE(0)
    elseif self.towerModel:CheckIsAllStage() then
        self.go_table.obj_lock:SetActiveE(0)
        self.go_table.obj_unlock:SetActiveE(1)
        ---@type season_tower_cfg
        local cfg = _G.ConfigManager.season_tower_cfg[self.towerId]
        self:InitAwardList(cfg.rewards, true)
        self.go_table.aorbtn_RestartDo:SetActiveE(0)
        self.go_table.obj_wait:SetActiveE(0)
        self.go_table.aortext_allPass:SetActiveE(1)
        self.go_table.aorbtn_refresh:SetActiveE(0)
        -- self.go_table.aortext_wait.text = GetLangPackValue(90037010120)
        self.go_table.aortext_nextSumLayer.text = ""
    else
        self.go_table.obj_wait:SetActiveE(0)
        self.go_table.obj_lock:SetActiveE(0)
        self.go_table.obj_unlock:SetActiveE(1)
        self.go_table.aortext_allPass:SetActiveE(0)
        ---@type season_tower_cfg
        local cfg = _G.ConfigManager.season_tower_cfg[self.towerId]
        self:InitAwardList(cfg.rewards)
        if self:CheckHasSelfBuff() then
            self.go_table.aorbtn_RestartDo:SetActiveE(1)
            -- self.go_table.aorbtn_choose:SetActiveE(0)
        else
            self.go_table.aorbtn_RestartDo:SetActiveE(0)
            -- self.go_table.aorbtn_choose:SetActiveE(1)
        end
    end
end

---显示奖励
function SeasonTowerView:InitAwardList(awardList, isGou)
    self.go_table.obj_content:ClearChildren()
    for i = 1, #awardList do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awardList[i],
                self.go_table.obj_content,
                function(item)
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    if item.SetGou then
                        item:SetGou(isGou)
                    end
                end
        )
    end
end

---更新计时显示
function SeasonTowerView:UpdateTimerShow(isShow, elapsed)
    if not isShow then
        self.RTS = self.RTS - elapsed
    end
    local time = _G.TimeUtil.TranslateSecond(Mathf.RoundToInt(self.RTS))
    local str = ""
    if time.day >= 1 then
        if time.hour == 0 then
            time.hour = 1
        end
        str = _G.LangUtil.GetLangPackValue(90022100001, time.day, time.hour)
    elseif time.hour >= 1 then
        if time.min == 0 then
            time.min = 1
        end
        str = _G.LangUtil.GetLangPackValue(90022100002, time.hour, time.min)
    elseif time.min >= 1 then
        str = _G.LangUtil.GetLangPackValue(90000010394, time.min)
    else
        str = _G.LangUtil.GetLangPackValue(90000010395)
    end
    self.go_table.aortext_lockTime.text = str
    if self.RTS <= 0 and not isShow then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.go_table.aorbtn_match:SetActiveE(1)
        self.go_table.obj_lockTime:SetActiveE(0)
    end
end

