---显示怪物
function SeasonTowerView:ShowMonster()
    self.monsterList = self.towerModel:GetMonsterList() or {}
    local ItemCardFactory = _G.ItemCardFactory:GetInstance()
    if not self.monsterItemList then
        self.monsterItemList = {}
    end
    local isNext = self.towerModel.isOverStage and not self.towerModel:CheckIsAllStage()
    local count = math.max(#self.monsterList, 5)
    for i = 1, count do
        if not self.monsterItemList[i] then
            self.monsterItemList[i] = true
            ItemCardFactory:GetItemCard(
                    ItemCardFactory.itemCardType.CardAllItem,
                    self.go_table.trans_cardContent,
                    function(item)
                        local data = self.monsterList[i]
                        if not data or isNext then
                            item:Show(111070000, nil, 24, nil, 300)
                            item.go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
                        else
                            item:Show(data.m_id, nil, data.star, nil, data.lv)
                        end
                        self.monsterItemList[i] = item
                    end
            )
        elseif self.monsterItemList[i] ~= true then
            local data = self.monsterList[i]
            if not data or isNext then
                self.monsterItemList[i]:Show(111070000, nil, 24, nil, 300)
                self.monsterItemList[i].go_table.aorimage_Icon.SpriteName = "0ui_jsxt_sx_icon5"
            else
                self.monsterItemList[i]:Show(data.m_id, nil, data.star, nil, data.lv)
            end
        end
    end
end

---更新buff
function SeasonTowerView:UpdateBuffList()
    local isNext = self.towerModel.isOverStage and not self.towerModel:CheckIsAllStage()
    self.monsterBuffList = isNext and { boss_buff = {}, buff = {} } or self.towerModel:GetMonsterBuff()
    self.bossBuffCount = self.monsterBuffList.boss_buff and #self.monsterBuffList.boss_buff or 0
    self.buffCount = self.bossBuffCount + #self.monsterBuffList.buff

    self.go_table.obj_contentList:RemoveAllChildren()
    local obj
    if self.towerModel and self.towerModel.curTowerId == 0 or isNext then
        obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_contentList)
        self:RefreshBuffItem(obj, 0)
    else
        for i = 1, self.buffCount do
            obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_contentList)
            self:RefreshBuffItem(obj, i - 1)
        end
    end
end

---@param looplist SuperScrollView.LoopListView2
function SeasonTowerView:RefreshBuffItem(obj, index)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local tb = self.buffItemList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
    end
    tb.index = index + 1
    local id
    if index + 1 > self.bossBuffCount then
        tb.obj_boss:SetActiveE(0)
        tb.aorimage_bg.SpriteName = "ui_sjhd_myzt_buff_di_2"
        id = self.monsterBuffList.buff[index + 1 - self.bossBuffCount]
    else
        tb.obj_boss:SetActiveE(1)
        tb.aorimage_bg.SpriteName = "ui_sjhd_myzt_buff_di_1"

        id = self.monsterBuffList.boss_buff[index + 1]
    end
    if not id then
        tb.aortext_desc.text = GetLangPackValue(90037010132)
        tb.aortext_name.text = GetLangPackValue(90037010131)
        tb.aorrawimage_icon:LoadImage("ImagesH5/hmementos/shushendekuizeng")
        tb.obj_mask:SetActiveE(1)
    else
        ---@type mementos_cfg
        local cfg = _G.ConfigManager.mementos_cfg[id]
        if not cfg then
            _G.LogError("mementos_cfg not id:" .. id)
            return
        end
        local data = { cfg = cfg, isbossbuff = (index + 1 <= self.bossBuffCount) }
        tb.aortext_desc.text = GetLangPackValue(cfg.desc)
        if index + 1 > self.bossBuffCount then
            tb.aortext_name.text = string.format("<color=#ffffff>%s</color>", GetLangPackValue(cfg.name))
        else
            tb.aortext_name.text = string.format("<color=#e96565>%s</color>", GetLangPackValue(cfg.name))
        end
        tb.aorrawimage_icon:LoadImage(cfg.icon)
        tb.obj_mask:SetActiveE(0)
        _G.SetEventTrigger(
                obj,
                "onClick",
                _G.handlerbind(self, self.TipsAttributeBtnOnClick, data)
        )
    end
    _G.GameUtil.ReBuildRTF(tb.aortext_desc)
    return obj
end

function SeasonTowerView:TipsAttributeBtnOnClick(go, ison, data)
    require "CommonTipManager":GetInstance():OpenBuffTip(data)
