---@class SeasonTowerRankView : UIBaseView	中文描述
---@field public go_table SeasonTowerRankView_GoTable GoTable
local SeasonTowerRankView = _G.BaseClass("SeasonTowerRankView", _G.UIBaseView)
--_G.SeasonTowerRankView = SeasonTowerRankView
local UIUtils = _G.UIUtils
function SeasonTowerRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank, _G.handler(self, self.OnClickBtn))
    self:IsBool()
end

---界面的入口函数
function SeasonTowerRankView:OnCreate()
    self.RewardDatas = _G.table.toArray(_G.ConfigManager.boss_rank_cfg)
    _G.table.sort(
        self.RewardDatas,
        function(a, b)
            return a.id < b.id
        end
    )
    self.towerModel = require "SeasonTowerModel":GetInstance()
    self:InitToggle()
    self.go_table.obj_Rank:SetActiveE(1)
    self:UpdateView()
    self.go_table.obj_Rank:SetActiveE(0)
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
end

function SeasonTowerRankView:UpdateView()
    self.towerModel:GetRank(
        function(msg)
            self.rankDatas = msg.ranks or {}
            self.rankList = {}
            self.rewardList_Rank = {}
            self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
            _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        end
    )
    require "SeasonTowerNet":GetInstance():GetSelfRank(
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.playerRank = msg
            self:InitPlayer()
        end
    )
end

function SeasonTowerRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
        )
    --self.Toggles["Reward"] =
    --_G.GetAutoGoTable(
    --        self.go_table.toggle_reward,
    --        _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.OnReward))
    --)
    self.go_table.toggle_zoneRank:SetActiveE(1)
    self.Toggles["ZoneRank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_zoneRank,
            _G.handlerbind(self, self.OnToggle, "ZoneRank", _G.handler(self, self.OnZoneRank))
        )
    self.go_table.toggle_rank:SetActiveE(
        require "ZoneRankModel":GetInstance():CheckIsShowSingle(_G.ZoneRankType.SeasonTower) and 1 or 0
    )
end

---点击Togggle
function SeasonTowerRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---大区排行
function SeasonTowerRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.SeasonTower, nil)
                self.ZoneRank = view
            end
        )
    end
end

---排行
function SeasonTowerRankView:OnRank(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
        self.rankList = {}
        self.rewardList_Rank = {}
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer()
    end
end

---刷新排行
function SeasonTowerRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb1 = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb1 = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.RankItemClick, tb1))
        self.rankList[instanceID] = tb1
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[newindex]
    tb.rankData = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (newindex + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
    else
        tb.aortext_rankNum.text = newindex
    end
    tb.aortext_name.text = data.role_info.name
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 1, true, true, false)
    tb.aortext_floor.text = self.towerModel:GetFloor(data.f_id)
    local times = _G.TimeUtil.GetDateTime(data.pass_time)
    tb.aortext_time1.text = _G.string.format("%s-%s-%s", times.year, times.month, times.day)
    tb.aortext_time2.text = _G.string.format("%02d:%02d:%02d", times.hour, times.minute, times.second)
    if self.IsHuiFang and tb.aorbtn_huifang then
        tb.aorbtn_huifang:SetActiveE(0)
    end
end

---判断是否显示回放按钮
function SeasonTowerRankView:IsBool()
    local EmbattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    local BattleView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    local ShowAwardWithButtonView = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg
        .ShowAwardWithButtonView.Name)
    if EmbattleView or BattleView or ShowAwardWithButtonView then
        self.IsHuiFang = true
    end
end

function SeasonTowerRankView:RankItemClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.role_info.uid > 0 then
            if data.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.role_info.uid)
            end
        end
    end
end

---显示玩家排行
function SeasonTowerRankView:InitPlayer()
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
                self.Rank.obj_player,
                _G.handlerbind(
                    self,
                    self.RankItemClick,
                    { rankData = { role_info = { uid = _G.PlayerModel:GetInstance():GetPlayerUid() } } }
                )
            )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
        local cfg = _G.ConfigManager.season_tower_cfg[self.towerModel:GetCurTowerId()]
        if not cfg then
            tb.aortext_floor.text = 0
        elseif self.towerModel.isOverStage then
            tb.aortext_floor.text = cfg.layer
        else
            tb.aortext_floor.text = cfg.layer - 1
        end
    else
        tb.aortext_rankNum.text = newindex
        tb.aortext_floor.text = self.towerModel:GetFloor(self.playerRank.values[1])
    end
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    local playerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, false)
    if newindex > 0 then
        local times = _G.TimeUtil.GetDateTime(self.playerRank.values[2])
        tb.aortext_time1.text = _G.string.format("%s-%s-%s", times.year, times.month, times.day)
        tb.aortext_time2.text = _G.string.format("%02d:%02d:%02d", times.hour, times.minute, times.second)
    elseif self.towerModel.passTime and self.towerModel.passTime > 0 then
        local times = _G.TimeUtil.GetDateTime(self.towerModel.passTime)
        tb.aortext_time1.text = _G.string.format("%s-%s-%s", times.year, times.month, times.day)
        tb.aortext_time2.text = _G.string.format("%02d:%02d:%02d", times.hour, times.minute, times.second)
    else
        tb.aortext_time1.text = ""
        tb.aortext_time2.text = ""
    end
end

---按钮点击事件在这里派发
function SeasonTowerRankView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SeasonTowerRankView
