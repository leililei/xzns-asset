---@class SeasonTowerBuffView : UIBaseView    中文描述
---@field public go_table SeasonTowerBuffView_GoTable GoTable
local SeasonTowerBuffView = _G.BaseClass("SeasonTowerBuffView", _G.UIBaseView)
--_G.SeasonTowerBuffView = SeasonTowerBuffView

local buffType = {
    Normal = 1,
    Boss = 2
}
local GetLangPackValue = _G.GetLangPackValue

function SeasonTowerBuffView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---拖拽显示
function SeasonTowerBuffView:OnDraging()
    local x = self.go_table.looplist2_buffList.ContainerTrans:GetLocalPosition()
    if x < 0 and _G.math.abs(x) > 180 then
        self.go_table.aorbtn_left:SetActiveE(1)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if _G.math.abs(x) + 940 < self.endPos then
        self.go_table.aorbtn_right:SetActiveE(1)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end
end

---界面的入口函数
function SeasonTowerBuffView:OnCreate()
    self.towerModel = require "SeasonTowerModel":GetInstance()
    self.itemList = {}
    self:InitBuffList()
    self.go_table.looplist2_buffList:InitListView(self.buffCount, _G.handler(self, self.RefreshBuffItem))
    self.go_table.looplist2_buffList.ScrollRect.onValueChanged:AddListener(_G.handler(self, self.OnDraging))
    self.go_table.aorbtn_left:SetActiveE(0)
    self.go_table.aorbtn_right:SetActiveE(self.buffCount > 5 and 1 or 0)
end

function SeasonTowerBuffView:InitBuffList()
    local buffList = self.towerModel:GetBuff()
    self.buffList = {}
    _G.table.insertto(self.buffList, buffList.boss_buff)
    _G.table.insertto(self.buffList, buffList.buff)
    self.buffCount = #self.buffList
    self.bossTb = {}
    for _, v in pairs(buffList.boss_buff) do
        self.bossTb[v] = true
    end
    self:SortBuffList()
    self.endPos = self.buffCount * 182 + 5 * (self.buffCount - 1)
end

function SeasonTowerBuffView:SortBuffList()
    _G.SortList(
        self.buffList,
        function(id)
            local sort = 1
            if self.bossTb[id] then
                sort = 99
            end
            return sort, -id
        end
    )
end
---刷新
function SeasonTowerBuffView:RefreshBuffItem(looplist, index, type)
    if index < 0 then
        return
    end
    local obj = looplist:NewListViewItem("$_obj_ListItem")
    local instanceId = obj:GetInstanceIDE()
    local id = self.buffList[index + 1]
    ---@type SeasonTowerChooseBuffView._toggle_item_GoTable
    local tb = _G.GetAutoGoTable(obj)
    tb.index = index + 1
    self.itemList[instanceId] = tb
    tb.obj_boss:SetActiveE(self.bossTb[id] and 1 or 0)
    ---@type mementos_cfg
    local cfg = _G.ConfigManager.mementos_cfg[id]
    tb.aortext_desc.text = _G.GetLangPackValue(cfg.desc)
    tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
    tb.aorrawimage_icon:LoadImage(cfg.icon)
    tb.obj_choose:SetActiveE(0)
    _G.GameUtil.ReBuildRTF(tb.aortext_desc)
    local _, y = tb.aortext_desc:GetRectTransformSize()
    tb.scrollrect_scrollView.enabled = y > 132

    --重置位置
    local x = tb.aortext_desc:GetLocalPosition()
    tb.aortext_desc:SetLocalPosition(x, 0, 0)
    return obj
end

---点击下一页
function SeasonTowerBuffView:OnNext()
    local count = self:GetViewShowMaxIndex()
    self.go_table.looplist2_buffList:MovePanelToItemIndex(math.min(count + 1, self.buffCount - 1), 0)
    if count + 6 >= self.buffCount then
        self.go_table.aorbtn_right:SetActiveE(0)
    end
    self.go_table.aorbtn_left:SetActiveE(1)
end
---点击上一页
function SeasonTowerBuffView:OnLast()
    local count = self:GetViewShowMaxIndex()
    self.go_table.looplist2_buffList:MovePanelToItemIndex(math.max(count - 9, 0), 0)
    if count - 9 <= 1 then
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    self.go_table.aorbtn_right:SetActiveE(1)
end

function SeasonTowerBuffView:GetViewShowMaxIndex()
    local index = 0
    local parentX = self.go_table.obj_Content:GetAnchorPosition()
    parentX = _G.math.abs(parentX)
    for _, v in pairs(self.itemList) do
        if v.gameObject:GetActiveSelf() == 1 then
            local x = v.gameObject:GetAnchorPosition()
            if x > parentX and x + 170 < parentX + 940 and index < v.index then
                index = v.index
            end
        end
    end
    return index - 1
end

---按钮点击事件在这里派发
function SeasonTowerBuffView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_enter then
        self:Close()
    elseif go == self.go_table.aorbtn_left then
        self:OnLast()
    elseif go == self.go_table.aorbtn_right then
        self:OnNext()
    end
end

return SeasonTowerBuffView
