---@class SeasonTowerChooseBuffView : UIBaseView    中文描述
---@field public go_table SeasonTowerChooseBuffView_GoTable GoTable
---@field curLua SeasonTowerChooseBuffView_Base
local SeasonTowerChooseBuffView = _G.BaseClass("SeasonTowerChooseBuffView", _G.UIBaseView)
---选择buff阶段
local Stage = {
    Boss = 1,
    Normal = 2
}
local Key = "SeasonTowerChooseBuffView"
local GetLangPackValue = _G.GetLangPackValue
function SeasonTowerChooseBuffView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.looplist2_buffList:InitListView(0, _G.handler(self, self.RefreshBuffItem))
    self.go_table.looplist2_buffList.ScrollRect.onValueChanged:AddListener(_G.handler(self, self.OnDraging))
    self.luaTb = {
        [Stage.Boss] = {obj = self.go_table.obj_Boss, luaName = "SeasonTowerChooseBuffView_Boss", lua = false},
        [Stage.Normal] = {obj = self.go_table.obj_Normal, luaName = "SeasonTowerChooseBuffView_Normal", lua = false}
    }
end
---初始话数据 初始化阶段（初始话buff列表和底部显示），点击buff，点击下部一确定的buff
---界面的入口函数
function SeasonTowerChooseBuffView:OnCreate(call)
    self.towerModel = require "SeasonTowerModel":GetInstance()

    self.curKey = Key .. (require "SeasonModel":GetInstance():GetCurSeasonId() * 100 + self.towerModel.stage + 1)
    self.tempDatas = _G.PlayerPrefsManager.GetTable(self.curKey) or {stage = Stage.Boss, boss_buff = {}, buff = {}}
    self.curStage = self.tempDatas.stage
    self.itemList = {}
    self:ShowStage()
    self:InitEffect()
    self.call = call
end
function SeasonTowerChooseBuffView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jiantou_L,
        self.go_table.aorbtn_left,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jiantou_R,
        self.go_table.aorbtn_right,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
        end
    )
end
---拖拽显示
function SeasonTowerChooseBuffView:OnDraging()
    local x = self.go_table.looplist2_buffList.ContainerTrans:GetLocalPosition()
    if x < 0 and _G.math.abs(x) > 180 then
        self.go_table.aorbtn_left:SetActiveE(1)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if _G.math.abs(x) + 940 < self.endPos then
        self.go_table.aorbtn_right:SetActiveE(1)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end
end

function SeasonTowerChooseBuffView:ShowStage()
    if not self.luaTb[self.curStage] then
        return
    end
    if self.curLua then
        self.curLua:HideView()
    end
    if not self.luaTb[self.curStage].lua then
        self.luaTb[self.curStage].obj:SetActiveE(1)
        self.luaTb[self.curStage].lua =
            self:AddComponent(
            self.luaTb[self.curStage].obj,
            require(self.luaTb[self.curStage].luaName).New(
                self,
                self.curStage == Stage.Boss and self.tempDatas.boss_buff or self.tempDatas.buff
            )
        )
    end
    self.curLua = self.luaTb[self.curStage].lua
    self.curLua:ShowView()
    self.buffcount = self.curLua:GetBuffCount()
    self.endPos = self.buffcount * 182 + 5 * (self.buffcount - 1)
    self.chooseIndex = 1
    self.go_table.looplist2_buffList:SetListItemCount(self.buffcount, true)
    self.max = 0
    self.go_table.looplist2_buffList:RefreshAllShownItem()
    self.go_table.aorbtn_left:SetActiveE(0)
    self.go_table.aorbtn_right:SetActiveE(self.buffcount > 5 and 1 or 0)
    self:OnClickBuff(nil, nil, 1)
end

---刷新
function SeasonTowerChooseBuffView:RefreshBuffItem(loopList, index)
    if index < 0 then
        return
    end
    local obj = loopList:NewListViewItem("$_obj_ListItem")
    local instanceId = obj:GetInstanceIDE()
    local id = self.curLua:GetBuffId(index + 1)
    ---@type SeasonTowerChooseBuffView._obj_ListItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickBuff, index + 1))
    tb.index = index + 1
    self.itemList[instanceId] = tb
    tb.obj_boss:SetActiveE(self.curLua:CheckIsBoss(index + 1) and 1 or 0)
    tb.obj_gou:SetActiveE(self.curLua:CheckIsChoose(id) and 1 or 0)
    ---@type mementos_cfg
    local cfg = _G.ConfigManager.mementos_cfg[id]
    tb.aortext_desc.text = _G.GetLangPackValue(cfg.desc)

    _G.GameUtil.ReBuildRTF(tb.aortext_desc)
    local _, y = tb.aortext_desc:GetRectTransformSize()
    tb.scrollrect_scrollView.enabled = y > 132
    tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
    tb.aorrawimage_icon:LoadImage(cfg.icon)
    tb.obj_scale:SetLocalScaleXYZ(self.chooseIndex == index + 1 and 1 or 0.9)
    tb.obj_choose:SetActiveE(self.chooseIndex == index + 1 and 1 or 0)

    --重置位置
    local x = tb.aortext_desc:GetLocalPosition()
    tb.aortext_desc:SetLocalPosition(x, 0, 0)
    return obj
end

function SeasonTowerChooseBuffView:OnClickBuff(go, _, index)
    local last = self.chooseIndex
    self.chooseIndex = index
    if last > 0 then
        self.go_table.looplist2_buffList:RefreshItemByItemIndex(last - 1)
    end
    self.go_table.looplist2_buffList:RefreshItemByItemIndex(index - 1)
    self.curLua:OnClickBuff(index)
end
---点击下一页
function SeasonTowerChooseBuffView:OnNext()
    local count = self:GetViewShowMaxIndex()
    self.go_table.looplist2_buffList:MovePanelToItemIndex(math.min(count + 1, self.buffcount - 1), 0)
    if count + 5 >= self.buffcount then
        self.go_table.aorbtn_right:SetActiveE(0)
    end
    self.go_table.aorbtn_left:SetActiveE(1)
end
---点击上一页
function SeasonTowerChooseBuffView:OnLast()
    local count = self:GetViewShowMaxIndex()
    self.go_table.looplist2_buffList:MovePanelToItemIndex(math.max(count - 9, 0), 0)
    if count - 10 <= 1 then
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    self.go_table.aorbtn_right:SetActiveE(1)
end

function SeasonTowerChooseBuffView:GetViewShowMaxIndex()
    local index = 0
    local parentX = self.go_table.obj_Content:GetAnchorPosition()
    parentX = _G.math.abs(parentX)
    for _, v in pairs(self.itemList) do
        if v.gameObject:GetActiveSelf() == 1 then
            local x = v.gameObject:GetAnchorPosition()
            if x > parentX and x + 170 < parentX + 940 and index < v.index then
                index = v.index
            end
        end
    end
    return index - 1
end

function SeasonTowerChooseBuffView:GetItemIsShow(itemIndex)
    local isShow = false
    local parentX = self.go_table.obj_Content:GetAnchorPosition()
    parentX = _G.math.abs(parentX)
    for _, v in pairs(self.itemList) do
        if v.gameObject:GetActiveSelf() == 1 then
            if v.index == itemIndex then
                local x = v.gameObject:GetAnchorPosition()
                if x > parentX and x + 170 < parentX + 940 then
                    isShow = true
                end
            end
        end
    end
    return isShow
end

---进去下个阶段
function SeasonTowerChooseBuffView:OnNextStage()
    self.curStage = self.curStage + 1
    self:ShowStage()
end
---返回上个阶段
function SeasonTowerChooseBuffView:OnLastStage()
    self.curStage = self.curStage - 1
    self:ShowStage()
end
---刷新buff显示
function SeasonTowerChooseBuffView:RefreshShow(index)
    if index then
        self.go_table.looplist2_buffList:RefreshItemByItemIndex(index - 1)
    else
        self.go_table.looplist2_buffList:RefreshAllShownItem()
    end
end

function SeasonTowerChooseBuffView:ShowChooseBuffEffect(x, y, callback)
    if self.moveDoTween ~= nil then
        self.moveDoTween:Kill()
    end
    self.go_table.obj_mask:SetActiveE(1)
    self.go_table.obj_tuowei:SetActiveE(1)

    local isShow = self:GetItemIsShow(self.chooseIndex)
    if not isShow then
        self.go_table.looplist2_buffList:MovePanelToItemIndex(self.chooseIndex - 1, 0)
    end
    local showItem = self.go_table.looplist2_buffList:GetShownItemByItemIndex(self.chooseIndex - 1)
    if showItem ~= nil then
        local bgx, bgy, bgz = _G.GetAutoGoTable(showItem).obj_effPos:GetPosition()
        self.go_table.obj_tuowei:SetPosition(bgx, bgy, bgz)
        --清理特效拖尾
        local trails = self.go_table.obj_tuowei:GetComponentsInChildrenE(_G.typeof(_G.CS.UnityEngine.TrailRenderer), 1)
        for i = 0, trails.Length - 1 do
            trails[i]:Clear()
        end
        local _, _, tuiweiz = self.go_table.obj_tuowei:GetPosition()
        self.moveDoTween = self.go_table.obj_tuowei:DoMove(x, y, tuiweiz, function ()
            self.go_table.obj_mask:SetActiveE(0)
            self.go_table.obj_tuowei:SetActiveE(0)
            self.go_table.obj_dianliang:SetActiveE(1)
            callback()
        end, 1)
    else
        callback()
    end
    local _, _, posz = self.go_table.obj_dianliang:GetPosition()
    self.go_table.obj_dianliang:SetPosition(x, y, posz)
    self.go_table.obj_dianliang:SetActiveE(0)
end

function SeasonTowerChooseBuffView:ChangeBuffItem()
    self:SaveBuff()
    if self.curStage == Stage.Boss and self.curLua:CheckIsOver() then
        self:OnNextStage()
        return
    end
    self:RefreshShow(self.chooseIndex)
end

function SeasonTowerChooseBuffView:CheckIsShow(index)
    local max = self:GetViewShowMaxIndex()
    return max >= index and _G.math.abs(max - index) <= 5
end

---点击已确定的buff
function SeasonTowerChooseBuffView:OnClickChooseBuff(go, isOn, index)
    local id = (self.curStage == Stage.Boss and self.bossChooseArray or self.normalChooseArray)[index]
    if not id then
        return
    end
    local data = self.curStage == Stage.Boss and self.bossBuffList or self.normalBuffList
    local pos = 0
    for i, v in pairs(data) do
        if v == id then
            pos = i
            break
        end
    end
    self.go_table.looplist2_buffList:MovePanelToItemIndex(pos - 1, 0)
end
---buff跳转
function SeasonTowerChooseBuffView:JumpIndex(index)
    self.chooseIndex = index
    self.go_table.looplist2_buffList:MovePanelToItemIndex(_G.math.max(index - 3, 0), 0)
end

---选择buff结束
function SeasonTowerChooseBuffView:OnEnter()
    self.towerModel:ChooseBuff(
        self.tempDatas.boss_buff,
        self.tempDatas.buff,
        function()
            _G.PlayerPrefsManager.DeleteKey(self.curKey)
            self:Close()
        end
    )
end

---按钮点击事件在这里派发
function SeasonTowerChooseBuffView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_left then
        self:OnLast()
    elseif go == self.go_table.aorbtn_right then
        self:OnNext()
    end
end

function SeasonTowerChooseBuffView:SaveBuff()
    if self.luaTb[Stage.Boss].lua and not self.luaTb[Stage.Boss].lua:CheckIsOver() then
        self.tempDatas.stage = Stage.Boss
    else
        self.tempDatas.stage = Stage.Normal
    end
    if self.luaTb[Stage.Boss].lua then
        self.tempDatas.boss_buff = self.luaTb[Stage.Boss].lua:GetChooseBuff()
    end
    if self.luaTb[Stage.Normal].lua then
        self.tempDatas.buff = self.luaTb[Stage.Normal].lua:GetChooseBuff()
    end
    _G.PlayerPrefsManager.SetTable(self.curKey, self.tempDatas)
end

---界面的销毁函数
function SeasonTowerChooseBuffView:OnDestroy()
    if self.moveDoTween then
        self.moveDoTween:Kill()
        self.moveDoTween = nil
    end
end

return SeasonTowerChooseBuffView
