local base = require "SeasonTowerChooseBuffView_Base"
---@class SeasonTowerChooseBuffView_Boss : SeasonTowerChooseBuffView_Base    中文描述
---@field go_table SeasonTowerChooseBuffView._obj_Boss_GoTable
---@field donwItemList _obj_Normal._obj_item1_GoTable[]
---@field view SeasonTowerChooseBuffView
local SeasonTowerChooseBuffView_Boss = _G.BaseClass("SeasonTowerChooseBuffView_Boss", base)

function SeasonTowerChooseBuffView_Boss:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SeasonTowerChooseBuffView_Boss:OnCreate(view, data)
    self.view = view
    self.BuffList = _G.GlobalInterface.GetNewArray(self.view.towerModel.stageCfg.pools2)
    self.limitCount = self.view.towerModel.stageCfg.number[2]
    self.BuffCount = #self.BuffList
    self.chooseList = {}
    self.chooseArray = data or {}
    self.donwItemList = {}
    for _, v in pairs(self.chooseArray) do
        self.chooseList[v] = true
    end
    self:InitDown()
    local nums = {}
    for _, v in pairs(self.view.towerModel.stageCfg.season_tower) do
        local cfg = _G.ConfigManager.season_tower_cfg[v]
        if cfg and cfg.type == 2 then
            nums = cfg.number
            break
        end
    end

    self.go_table.aortext_tips.text = _G.GetLangPackValue(90037010141, self.view.towerModel.stageCfg.number[2], nums[2])
end

function SeasonTowerChooseBuffView_Boss:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_FirstTestView_loop,
        self.donwItemList[1].gameObject,
        function(trans)
            if _G.IsNil(self.gameObject) then
                return
            end
            self.effect = trans
            self.effect:SetAnchorPosition(0, -3)
            self.effect:SetLocalScaleXYZ(1.1)
        end
    )
end

---初始化下部Buff显示
function SeasonTowerChooseBuffView_Boss:InitDown()
    local count = self.go_table.obj_content:GetChildCountE()
    for i = 1, count do
        if self.go_table["obj_item" .. i] then
            if i > self.limitCount then
                self.go_table["obj_item" .. i]:SetActiveE(0)
            else
                self.donwItemList[i] =
                    _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClickDown, i))
                self:RefreshDown(i)
            end
        end
    end
end
---刷新下部buff
function SeasonTowerChooseBuffView_Boss:RefreshDown(index)
    local tb = self.donwItemList[index]
    local id = self.chooseArray[index]
    if id then
        ---@type mementos_cfg
        local cfg = _G.ConfigManager.mementos_cfg[id]
        tb.aorrawimage_icon:LoadImage(cfg.icon)
        tb.aortext_name.text = _G.GetLangPackValue(cfg.name)
    else
        tb.aorrawimage_icon:LoadImage("")
        tb.aortext_name.text = ""
    end
end
---点击下部已选中的卡牌
function SeasonTowerChooseBuffView_Boss:OnClickDown(_, _, index)
    --self:ChangeCurDown(index)
    local id = self.chooseArray[index]
    if not id then
        return
    end
    local pos = 0
    for i, v in pairs(self.BuffList) do
        if v == id then
            pos = i
            break
        end
    end
    self.view:JumpIndex(pos)
    self:OnClickBuff(pos)
end

function SeasonTowerChooseBuffView_Boss:GetBuffCount()
    return self.BuffCount
end
---取消选择
function SeasonTowerChooseBuffView_Boss:UnChoose()
    local pos = 1
    for i, v in pairs(self.chooseArray) do
        if v == self.curId then
            pos=i
            break
        end
    end
    self.chooseList[self.curId] = nil
    self.chooseArray[pos] = nil
    self:RefreshDown(pos)
    self:UpdateBtnShow()
    self.view:ChangeBuffItem(self:GetBuffPos(self.curId))
end

function SeasonTowerChooseBuffView_Boss:GetBuffPos(id)
    if self.chooseList[id] then
        for i, v in pairs(self.chooseArray) do
            if v == id then
                return i
            end
        end
    else
        for i, v in pairs(self.BuffList) do
            if v == id then
                return i
            end
        end
    end

    return 999
end

---选中
function SeasonTowerChooseBuffView_Boss:Choose()
    local pos = 1
    for i = 1, self.limitCount do
        if not self.chooseArray[i] then
            pos = i
            break
        end
    end
    local x, y, z = self.go_table["obj_item" .. pos]:GetPosition()
    self.view:ShowChooseBuffEffect(x, y, function ()
        self.chooseList[self.curId] = true

        self.chooseArray[pos] = self.curId
        self:RefreshDown(pos)
        self:UpdateBtnShow()
        --self:ChangeCurDown()
        self.view:ChangeBuffItem(pos)
    end)
end

function SeasonTowerChooseBuffView_Boss:GetBuffId(index)
    return self.BuffList[index]
end

function SeasonTowerChooseBuffView_Boss:OnClickBuff(index)
    self.index = index
    self.curId = self.BuffList[index]
    self:UpdateBtnShow()
    self.go_table.aortext_tips:SetActiveE(1)
end

function SeasonTowerChooseBuffView_Boss:CheckIsChoose(id)
    return self.chooseList[id]
end

function SeasonTowerChooseBuffView_Boss:CheckIsBoss()
    return false
end
---更新按钮显示
function SeasonTowerChooseBuffView_Boss:UpdateBtnShow()
    local isOver = self:CheckIsOver()
    self.go_table.aorbtn_nextStage:SetGray(not isOver)
    self.go_table.aortext_nextlabel.color =
        isOver and _G.ColorTools.FormatColorByString("914801") or _G.ColorTools.FormatColorByString("414141")
    if self.curId then
        if not self.chooseList[self.curId] then
            self.go_table.aorbtn_down:SetActiveE(0)
            if self:CheckIsOver() then
                self.go_table.aorbtn_enter:SetActiveE(0)
                self.go_table.aorbtn_replace:SetActiveE(1)
            else
                self.go_table.aorbtn_enter:SetActiveE(1)
                self.go_table.aorbtn_replace:SetActiveE(0)
            end
        else
            self.go_table.aorbtn_enter:SetActiveE(0)
            self.go_table.aorbtn_down:SetActiveE(1)
            self.go_table.aorbtn_replace:SetActiveE(0)
        end
    end
end

function SeasonTowerChooseBuffView_Boss:CheckIsOver()
    return _G.table.count(self.chooseArray) == self.limitCount
end

function SeasonTowerChooseBuffView_Boss:OnNextStage()
    if not self:CheckIsOver() then
        _G.PopWindowManager:GetInstance():ShowAllTips(820101)
        return
    end
    self.view:OnNextStage()
end

function SeasonTowerChooseBuffView_Boss:Replace()
    if self.chooseList[self.curId] then
        _G.PopWindowManager:GetInstance():ShowAllTips(820103)
        return
    end
    local id = self.chooseArray[1]
    self.chooseArray[1] = nil
    self.chooseList[id] = nil
    self.view:RefreshShow()
    self:Choose()
end

function SeasonTowerChooseBuffView_Boss:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_down then
        self:UnChoose()
    elseif go == self.go_table.aorbtn_enter then
        self:Choose()
    elseif go == self.go_table.aorbtn_nextStage then
        self:OnNextStage()
    elseif go == self.go_table.aorbtn_replace then
        self:Replace()
    end
end

function SeasonTowerChooseBuffView_Boss:ShowView()
    self.go_table.aorbtn_enter:SetActiveE(0)
    self.go_table.aortext_tips:SetActiveE(0)
    self.go_table.aorbtn_down:SetActiveE(0)
    self.go_table.aorbtn_replace:SetActiveE(0)
    self:UpdateBtnShow()
    base.ShowView(self)
end

---获取选中buff
function SeasonTowerChooseBuffView_Boss:GetChooseBuff()
    return self.chooseArray
end

function SeasonTowerChooseBuffView_Boss:GetTips()
    return _G.GetLangPackValue(90037010141)
end

function SeasonTowerChooseBuffView_Boss:ChangeCurDown(downIndex)
    if not downIndex then
        downIndex = 1
        for i = 1, #self.donwItemList do
            if not self.chooseArray[i] then
                downIndex = i
                break
            end
        end
    end

    self.curDownIndex = downIndex
    if self.effect then
        self.effect:SetParentE(self.donwItemList[self.curDownIndex].gameObject)
        self.effect:SetAnchorPosition(0, -5)
    end
end

function SeasonTowerChooseBuffView_Boss:GetChooseBuffCount()
    return _G.table.count(self.chooseArray)
end

return SeasonTowerChooseBuffView_Boss
