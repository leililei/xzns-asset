---@class SeasonTowerCardBagItem : UIBaseView	中文描述
---@field public go_table SeasonTowerCardBagItem_GoTable GoTable
local SeasonTowerCardBagItem = _G.BaseClass("SeasonTowerCardBagItem", _G.UIBaseView)

---类的构造函数
function SeasonTowerCardBagItem:__init(obj, callback)
    ---@type UnityEngine.GameObject
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.callback = callback
end
---@param data CardData
function SeasonTowerCardBagItem:Show(data, index, isSelect)
    local hpdata = require "SeasonTowerModel":GetInstance():GetHPMP(data.uid)
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.BodyItem_select,
            self.go_table.obj_node,
            function(item)
                self.item = item
                item:ShowCardData(data, self.callback, index)
                _G.GameUtil.SetActiveByCondition(self.item.go_table.obj_deal, hpdata.hp <= 0)
                item.go_table.gameObject:SetLocalScaleXYZ(1)
                self.item:SetSelect(isSelect)
            end
        )
    else
        self.item:ShowCardData(data)
        self.item:SetSelect(isSelect)
        _G.GameUtil.SetActiveByCondition(self.item.go_table.obj_deal, hpdata.hp <= 0)
    end
    self.go_table.slider_hp.value = hpdata.hp / 10000
    self.go_table.slider_mp.value = hpdata.mp / 1000
    --临时添加 红点
    self.go_table.trans_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.MineCardList.id, data.uid)
end

function SeasonTowerCardBagItem:SetSelect(isSelect)
    if self.item then
        self.item:SetSelect(isSelect)
    end
end

function SeasonTowerCardBagItem:OnClickBtn()
end

---类的析构函数
function SeasonTowerCardBagItem:Dispose()
end

return SeasonTowerCardBagItem