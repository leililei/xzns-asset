---@class SeasonTowerGiftView : UIBaseView	中文描述
---@field public go_table SeasonTowerGiftView_GoTable GoTable
local SeasonTowerGiftView = _G.BaseClass("SeasonTowerGiftView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue

function SeasonTowerGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloophorizontal_itemList:InitItemData(0, _G.handler(self, self.RefreTaskAwardItem))
end

---界面的入口函数
function SeasonTowerGiftView:OnCreate()
    self.towerModel = require "SeasonTowerModel":GetInstance()
    self.passCount = self.towerModel:GetPassTowerCount()
    self.isBuy = self.towerModel.isBuy
    self:UpdateView()
    self:InitEffect()
end

---更新界面
function SeasonTowerGiftView:UpdateView()
    self:InitGiftAward()
    self:InitGiftTaskAward()
    self:UpdateTimer()
    if self.isBuy then
        self.go_table.aortext_getLabel.text = _G.string.AddColor(GetLangPackValue(9002010005), "414141")
    else
        local content = _G.GameUtil.SetPriceByChannel(self.towerModel:GetStoreCfg().price_id)
        self.go_table.aortext_getLabel.text = GetLangPackValue(90037010125, content)
    end

    self.go_table.aortext_floor.text = self.passCount
    if self.isBuy then
        self.go_table.aorbtn_get:SetGray(#self.towerModel:GetCanTakeAward() <= 0)
    end
end

---初始化特效
function SeasonTowerGiftView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SeasonTowerGiftView_bg,
        self.go_table.aorbtn_close,
        function(trans)
            if self:IsNil() then
                _G.DestroyImmediate(trans)
                return
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SeasonTowerGiftView_saoguang,
        self.go_table.trans_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyImmediate(trans)
                return
            end
        end
    )
end

---初始化礼包奖励
function SeasonTowerGiftView:InitGiftAward()
    local award = self.towerModel:GetStoreCfg().goods
    if not self.awardList then
        self.awardList = {}
    end

    local StorageManager = _G.StorageManager:GetInstance()
    local parent = self.go_table.trans_Mid
    local count = #award
    for i = 1, count do
        if i <= 2 and count >= 3 then
            parent = self.go_table.trans_Down
        elseif count >= 3 then
            parent = self.go_table.trans_Top
        end
        if not self.awardList[i] then
            StorageManager:GetItemBaseViewNew(
                award[i],
                parent,
                function(item)
                    item.go_table.gameObject:SetRectTransformSize(88, 88)
                    self.awardList[i] = item
                    if item.SetGouScroll and self.isBuy then
                        item:SetGouScroll(true)
                    end
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                end
            )
        else
            if self.awardList[i].SetGouScroll and self.isBuy then
                self.awardList[i]:SetGouScroll(true)
            end
        end
    end
end

---初始化礼包任务奖励
function SeasonTowerGiftView:InitGiftTaskAward()
    self.taskAwardList = {}
    self.taskAward = self.towerModel:GetStoreCfg().content
    self.go_table.scrollloophorizontal_itemList:UpdateCount(#self.taskAward)
end

---刷新奖励
function SeasonTowerGiftView:RefreTaskAwardItem(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskAwardList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem))
    end
    local cfg = _G.ConfigManager.store_season_battlecon_cfg[self.taskAward[index + 1]]
    tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(cfg.rewards_pay[1][1]))
    tb.obj_mask:SetActiveE(self.towerModel:CheckAwrdIsGet(cfg.rewards_pay[1][1]) and 1 or 0)
    tb.aortext_num.text = cfg.rewards_pay[1][2]
    tb.aortext_floor.text = GetLangPackValue(90037010108, cfg.conditions[2])
    obj:SetName(self.taskAward[index + 1])
    tb.obj_mask:SetActiveE(0)
    if not self.isBuy then
        tb.trans_effet:SetActiveE(1)
        if not tb.effett then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_FirstTestView_loop,
                tb.trans_effet,
                function(obj)
                    if self:IsNil() then
                        _G.DestroyImmediate(obj)
                        return
                    end
                    tb.effett = obj
                    if self.towerModel:CheckAwrdIsGet(cfg.id) then
                        tb.effett:SetActiveE(0)
                    end
                end
            )
        end
    else
        if self.towerModel:CheckAwrdIsGet(cfg.id) then
            tb.obj_mask:SetActiveE(1)
            tb.trans_effet:SetActiveE(0)
        elseif self.passCount >= cfg.conditions[2] then
            tb.trans_effet:SetActiveE(1)
            if not tb.effett then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_FirstTestView_loop,
                    tb.trans_effet,
                    function(obj)
                        if self:IsNil() then
                            _G.DestroyImmediate(obj)
                            return
                        end
                        tb.effett = obj
                        if self.towerModel:CheckAwrdIsGet(cfg.id) then
                            tb.effett:SetActiveE(0)
                        end
                    end
                )
            end
        else
            tb.trans_effet:SetActiveE(0)
        end
    end
end

function SeasonTowerGiftView:OnClickItem(go, _, index)
    local name = go:GetParent():GetName()
    if name then
        local cfg = _G.ConfigManager.store_season_battlecon_cfg[_G.tonumber(name)]
        require "CommonTipManager":GetInstance():OpenTip(go, cfg.rewards_pay[1][1])
    end
end

function SeasonTowerGiftView:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:UpdateTime()
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(_G.TimeUtil.GetSixClockTimer(), self.UpdateTime, self, true, false, true)
    self.timer:Start()
end

function SeasonTowerGiftView:UpdateTime()
    local endTime = self.towerModel:GetEndTime()
    local starTime = _G.TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time.text =
        GetLangPackValue(90037010106) ..
        GetLangPackValue(90025500011, _G.TimeUtil.GetInterValDayByGame(starTime, endTime), "")
end

function SeasonTowerGiftView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---购买或领取礼包
function SeasonTowerGiftView:OnGet()
    if self.isBuy then
        self.towerModel:GetAward(
            function()
                self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
                self.go_table.aorbtn_get:SetGray(true)
            end
        )
    else
        self.towerModel:Buy(
            function()
                self.isBuy = true
                self:InitGiftAward()
                self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
                self.go_table.aortext_getLabel.text = GetLangPackValue(9002010005)
                self.go_table.aorbtn_get:SetGray(#self.towerModel:GetCanTakeAward() <= 0)
            end
        )
    end
end

---按钮点击事件在这里派发
function SeasonTowerGiftView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        self:OnGet()
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonTowerTaskView.Name)
    end
end

return SeasonTowerGiftView
