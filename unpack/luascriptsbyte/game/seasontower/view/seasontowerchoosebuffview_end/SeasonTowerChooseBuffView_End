local base = require "SeasonTowerChooseBuffView_Base"
---@class SeasonTowerChooseBuffView_End : SeasonTowerChooseBuffView_Base	中文描述
---@field go_table  SeasonTowerChooseBuffView._obj_End_GoTable
---@field view SeasonTowerChooseBuffView
local SeasonTowerChooseBuffView_End = _G.BaseClass("SeasonTowerChooseBuffView_End", base)

function SeasonTowerChooseBuffView_End:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SeasonTowerChooseBuffView_End:OnCreate(view)
    self.view = view
    self.go_table.aortext_tips.text = _G.GetLangPackValue(90037010144)
end

---销毁对象时,析构函数
function SeasonTowerChooseBuffView_End:OnDestroy()
end

function SeasonTowerChooseBuffView_End:ShowView(boss, normal)
    self:InitBuff(boss, normal)
    base.ShowView(self)
end

function SeasonTowerChooseBuffView_End:InitBuff(boss, normal)
    self.bossCount = #boss
    self.buffList = {}
    _G.table.insertto(self.buffList, boss)
    _G.table.insertto(self.buffList, normal)
    self.bossTb = {}
    for _, v in pairs(boss) do
        self.bossTb[v] = true
    end
    self.BuffCount = #self.buffList
    self:SortBuffList()
end

function SeasonTowerChooseBuffView_End:SortBuffList()
    _G.SortList(
        self.buffList,
        function(id)
            local sort = 1
            if self.bossTb[id] then
                sort = 99
            end
            return sort, -id
        end
    )
end

function SeasonTowerChooseBuffView_End:GetBuffCount()
    return self.BuffCount
end

function SeasonTowerChooseBuffView_End:CheckIsBoss(index)
    return index <= self.bossCount
end
---获取buffid
function SeasonTowerChooseBuffView_End:GetBuffId(index)
    return self.buffList[index]
end

function SeasonTowerChooseBuffView_End:OnLastStage()
    self.view:OnLastStage()
end
function SeasonTowerChooseBuffView_End:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_enter then
        self.view:OnEnter()
    elseif go == self.go_table.aorbtn_lastStage then
        self:OnLastStage()
    end
end

return SeasonTowerChooseBuffView_End
