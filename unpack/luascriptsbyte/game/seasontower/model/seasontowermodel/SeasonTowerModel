---购买礼包
function SeasonTowerModel:Buy(call)
    if self.buyCall then
        return
    end
    self.buyCall = call
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    local cfg = self:GetStoreCfg()
    require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
end

function SeasonTowerModel:OnMallCashListener(data)
    if self:GetStoreCfg().id == data.sid then
        self.isBuy = true
        if self.buyCall then
            self.buyCall()
            self.buyCall = nil
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        require "CommonTipManager".OpenCommonAwardView(data)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTower.id, 1)
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

