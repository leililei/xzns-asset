---退出功能
function SeasonTowerModel:OnQuit()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SeasonTowerView.Name) and
            not _G.BattleManager:GetInstance():CheckInBattle()
     then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTowerChooseBuffView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTowerCardBagView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTowerGiftView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTowerTaskView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTowerBuffView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.OptionDialogView.Name)
        local isExit, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if isExit then
            view.view:QuitEmbattle()
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonTowerView.Name)
    end
end

