function SeasonTowerModel:GetAwardCall(msg, ids, call)
    if msg.ack ~= 1 then
        return
    end
    for _, v in pairs(ids) do
        self.awardList[v] = true
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    require "CommonTipManager".OpenCommonAwardView(msg)
    if call then
        call()
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTower.id, 1)
end

---获取可领取的奖励
function SeasonTowerModel:GetCanTakeAward()
    if not self.isBuy then
        return {}
    end
    local tb = {}
    ---@type store_season_battlecon_cfg
    local cfg
    for _, v in pairs(self.storeCfg.content) do
        cfg = _G.ConfigManager.store_season_battlecon_cfg[v]
        if cfg and self.passTowerCount >= cfg.conditions[2] and not self:CheckAwrdIsGet(v) then
            _G.table.insert(tb, v)
        end
    end
    return tb
end

---战斗
function SeasonTowerModel:Fight()
    if not require "SeasonManager".CheckSeasonIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        return
    end
    local data = {}
    data.power = 0
    for i = 1, #self.monsterList do
        local tb = {
            sid = 0,
            uid = 0,
            level = 0,
            star = 0
        }
        if self.monsterList[i].info and self.monsterList[i].info.hp and self.monsterList[i].info.hp > 0 then
            tb = {
                sid = self.monsterList[i].m_id,
                uid = 0,
                level = self.monsterList[i].lv,
                star = self.monsterList[i].star
            }
        end
        _G.table.insert(data, tb)
    end
    data.power = self:GetMonsterPower()
    data.pet = self.monsterPet
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():OpenEmbattle(
        _G.EmbattleType.SeasonTower,
        _G.EmbattleSaveType.server,
        true,
        _G.EmbattleControllerItemType.seasonTower,
        _G.handler(self, self.OnExitFight),
        _G.handler(self, self.OnFight),
        self.stageCfg.monster_group,
        data
    )
end

