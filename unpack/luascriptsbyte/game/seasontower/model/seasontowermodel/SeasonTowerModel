---监听界面打开
---@param name string 界面名称
function SeasonTowerModel:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if _G.IsNil(view.curSceneTrans) then
            view:SetInitSceneCall(
                function()
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SeasonTowerView.Name)
                end
            )
        else
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SeasonTowerView.Name)
        end
    end
end

