---从服务器拉取数据
function SeasonTowerModel:GetDataFormServer()
    require "SeasonTowerNet":GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---初始化信息
---@param msg season_tower.s2c_season_tower_info
function SeasonTowerModel:ParseData(msg)
    if msg.ack ~= 1 then
        base.ParseData(self)
        return
    end
    self.stage = msg.info.stage
    self.buffList = msg.info.buff_list
    self.isBuy = msg.info.is_buy == 1
    self.refreshTimes = msg.info.refresh_times
    self.stageCfg = _G.ConfigManager.season_tower_pools_cfg[self:GetStage()]
    self.isOverStage = msg.info.stage_pass
    self.passTime = msg.info.pass_time
    self:InitTowerInfo(msg.info.tower_info)
    self:InitCardList(msg.info.card_info)
    self:InitAwardList(msg.info.award)
    self:UpdateTimer()
    base.ParseData(self)
end

function SeasonTowerModel:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if not self.isOverStage then
        return
    end
    local nextStageCfg = _G.ConfigManager.season_tower_pools_cfg[self.stage + 1]
    if nextStageCfg then
        local endTime = self:GetStartTime() + (nextStageCfg.time - 1) * 86400
        if endTime > _G.TimeUtil.GetServerUnixTime() then
            self.timer =
                _G.TimerManager:GetInstance():GetTimer(
                endTime - _G.TimeUtil.GetServerUnixTime(),
                self.TimerOver,
                self,
                true,
                false,
                true
            )
            self.timer:Start()
        else
            require "RedPointManager":GetInstance():RefreshNode(self.redPointId, 2)
        end
    end
end

function SeasonTowerModel:TimerOver()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    require "RedPointManager":GetInstance():RefreshNode(self.redPointId, 2)
end

function SeasonTowerModel:InitFunction()
    local seasonCfg = require "SeasonModel":GetInstance():GetCfg()
    local id = _G.tonumber(seasonCfg.tower_pools[2][1])
    self.storeCfg = _G.ConfigManager.store_season_battle_cfg[id]
    self.towerMapFloor = {}
    local startFloor = 0
    for i = 1, #seasonCfg.tower_pools[1] do
        ---@type season_tower_pools_cfg
        local cfg = _G.ConfigManager.season_tower_pools_cfg[seasonCfg.tower_pools[1][i]]
        for i = 1, #cfg.season_tower do
            startFloor = startFloor + 1
            self.towerMapFloor[cfg.season_tower[i]] = startFloor
        end
    end
end

---初始化卡牌
---@param cardInfo fight.i_fight_card[]
function SeasonTowerModel:InitCardList(cardInfo)
    self.cardList = {}
    if cardInfo then
        for _, v in pairs(cardInfo) do
            self.cardList[v.uid] = {hp = v.hp or 0, mp = v.mp or 0}
        end
    end
end

---初始化当前层的信息
---@param tower season_tower.i_tower 当前层的信息
function SeasonTowerModel:InitTowerInfo(tower)
    self.curTowerId = tower.t_id
    self.monsterBuffList = tower.buff
    if not self.monsterBuffList.boss_buff then
        self.monsterBuffList.boss_buff = {}
    end
    if not self.monsterBuffList.buff then
        self.monsterBuffList.buff = {}
    end
    self.monsterPower = tower.tower_power
    self.monsterList = {}
    self.monsterPet = tower.pet or {}
    if tower.monster_list then
        for _, v in pairs(tower.monster_list) do
            self.monsterList[v.index] = v
            local id = v.m_id * 10 + v.index
            for _, v2 in pairs(tower.card_info) do
                if v2.uid == id then
                    v.info = v2
                    break
                end
            end
        end
    end
    self.tempid = self.curTowerId > 0 and self.curTowerId or self:GetStageCfg().season_tower[1]
    local cfg = _G.ConfigManager.season_tower_cfg[self.tempid]
    self.passTowerCount = 0
    if cfg then
        self.passTowerCount = cfg.layer
        if not self.isOverStage then
            self.passTowerCount = self.passTowerCount - 1
        end
    end
end

---初始化奖励
---@param award number[]
function SeasonTowerModel:InitAwardList(award)
    self.awardList = {}
    if award then
        for _, v in pairs(award) do
            self.awardList[v] = true
        end
    end
end

