local base = require "SeasonBaseModel"
---@class SeasonTowerModel : SeasonBaseModel
---@field maxStage number 最高阶段
---@field stage number 当前阶段
---@field buffList season_tower.i_buff 当前阶段选择buff
---@field curTowerId number 当前层数
---@field monsterBuffList season_tower.i_buff 当前怪物buff
---@field isBuy boolean 礼包是否购买
---@field monsterList season_tower.i_monster[] 怪物信息
---@field stageCfg season_tower_pools_cfg 阶段配置
