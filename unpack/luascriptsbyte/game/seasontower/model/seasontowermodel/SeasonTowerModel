local SeasonTowerModel = _G.BaseClass("SeasonTowerModel", base)
local FirstKey = "SeasonTowerModelKey"
local NextStageKey = "SeasonTowerNextStage"
---@return SeasonTowerModel SeasonTowerModel
function SeasonTowerModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SeasonTowerModel:__init()
    self.curFunctionOpenID = _G.FunctionID.SeasonTower
    self.maxStage = 1
    self.stageEndTb = {}
    for _, v in pairs(_G.ConfigManager.season_tower_cfg) do
        if v.stage > self.maxStage then
            self.maxStage = v.stage
        end
        if not self.stageEndTb[v.stage] then
            self.stageEndTb[v.stage] = v.layer
        elseif self.stageEndTb[v.stage] and self.stageEndTb[v.stage] < v.layer then
            self.stageEndTb[v.stage] = v.layer
        end
    end
    self.redPointId = _G.ConfigManager.redpoint_cfg.FirstTower.id
    self.reviveParams = _G.ConfigManager.discrete_cfg[107601][1]
    self.cycle = _G.ConfigManager.discrete_cfg[122004][1][1]
end

---销毁对象时,析构函数
function SeasonTowerModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

