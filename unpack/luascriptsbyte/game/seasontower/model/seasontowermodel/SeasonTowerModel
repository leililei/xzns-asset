        call()
    end
    self:UpdateTimer()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTower.id, 2)
end

---复活卡牌
function SeasonTowerModel:ReviveCard(call)
    if
        not _G.StorageManager:GetInstance():CheckItem(
            _G.tonumber(self.reviveParams[1]),
            _G.tonumber(self.reviveParams[2])
        )
     then
        return
    end
    if _G.table.isEmptyOrNil(self.cardList) then
        _G.PopWindowManager:GetInstance():ShowAllTips(820104)
        return
    end
    local isNeed = false
    for _, v in pairs(self.cardList) do
        if v.hp < 10000 then
            isNeed = true
            break
        end
    end
    if not isNeed then
        _G.PopWindowManager:GetInstance():ShowAllTips(820104)
        return
    end
    require "SeasonTowerNet":GetInstance():ReviveCard(_G.handlerbind(self, self.ReviveCardCall, call))
end

---复活卡牌回调
function SeasonTowerModel:ReviveCardCall(msg, call)
    if msg.ack ~= 1 then
        return
    end
    for _, v in pairs(self.cardList) do
        v.hp = 10000
        v.mp = 1000
    end
    if call then
        call()
    end
end

