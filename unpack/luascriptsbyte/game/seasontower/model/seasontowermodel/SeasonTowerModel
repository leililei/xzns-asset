function SeasonTowerModel:OnExitFight()
    if not require "SeasonModel":GetInstance():CheckSeasonIsOpen() then
        self:OnQuit()
    else
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SeasonTowerView.Name)
    end
