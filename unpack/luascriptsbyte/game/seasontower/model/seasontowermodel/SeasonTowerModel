---刷新buff成功
---@param msg season_tower.s2c_season_tower_refresh_buff
function SeasonTowerModel:RefreshMonsterBuffCall(msg, call)
    if msg.ack ~= 1 then
        return
    end
    if self.refreshTimes >= self.stageCfg.frequency then
        _G.StorageManager:GetInstance():ConsumeItem(self.stageCfg.expend[1], nil, self.stageCfg.expend[2])
    end
    self.refreshTimes = self.refreshTimes + 1
    self.monsterBuffList = msg.buff
    if call then
        call()
    end
end

