---刷新buff
function SeasonTowerModel:RefreshMonsterBuff(call)
    local refesh = function()
        require "SeasonTowerNet":GetInstance():RefreshMonsterBuff(
            _G._G.handlerbind(self, self.RefreshMonsterBuffCall, call)
        )
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OpenDialog, self)
    self.tipsStr = ""
    if self.refreshTimes >= self.stageCfg.frequency then
        self.tipsStr = _G.LangUtil.GetLangPackValue(90036010108, self.stageCfg.expend[2])
        local str = _G.LangUtil.GetLangPackValue(90036010101)
        _G.PopWindowManager:GetInstance():ShowAllTips(
            820302,
            str,
            function()
                if not _G.StorageManager:GetInstance():CheckItemNew(self.stageCfg.expend[1], self.stageCfg.expend[2]) then
                    return
                end
                refesh()
            end
        )
    else
        self.tipsStr =
            _G.LangUtil.GetLangPackValue(
            90036010107,
            self.stageCfg.frequency - self.refreshTimes,
            self.stageCfg.frequency
        )
        local str = _G.LangUtil.GetLangPackValue(90036010101)
        _G.PopWindowManager:GetInstance():ShowAllTips(
            820301,
            str,
            function()
                refesh()
            end
        )
    end
end

