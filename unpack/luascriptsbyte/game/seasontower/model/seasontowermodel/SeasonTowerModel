---进入战斗
function SeasonTowerModel:OnFight()
    local otherInfo = {}
    local cfg = _G.ConfigManager.season_tower_cfg[self.tempid]
    otherInfo.name = _G.GetLangPackValue(90023200002, cfg.layer)
    otherInfo.sid = self.monsterList[1].m_id
    otherInfo.selfName = _G.PlayerModel:GetInstance():GetName()
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.seasonTower, otherInfo)
end

---战斗胜利
function SeasonTowerModel:FightWin(result)
    if result then
        self.passTowerCount = self.passTowerCount + 1
        _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.SeasonTower}, 1)
    end
    if require "SeasonModel":GetInstance():CheckSeasonIsOpen() then
        require "SeasonTowerNet":GetInstance():GetInfo(
            function(msg)
                self.isOverStage = msg.info.stage_pass
                self.passTime = msg.info.pass_time
                self:InitTowerInfo(msg.info.tower_info)
                self:InitCardList(msg.info.card_info)
                self:UpdateTimer()
                require "RedPointManager":GetInstance():RefreshNode(self.redPointId, 1)
                _G.Events:GetInstance():Broadcast(_G.eSeasonTower.SeasonTowerRefreshView, result)
            end
        )
    end
end

