function SeasonTowerModel:GetStageMaxFloor(stageId)
    if not stageId then
        stageId = self.stage
    end
    return self.stageEndTb[stageId]
end

function SeasonTowerModel:GetNextStageMaxFloor()
    if self.stage >= self.maxStage then
        return 0
    end
    return self.stageEndTb[self.stage + 1]
end

---检测红点
function SeasonTowerModel:GetRedPoint(param)
    if param == 1 then
        if #self:GetCanTakeAward() > 0 then
            return true
        end
        return false
    elseif param == 2 then
        if self.isOverStage then
            local nextStageCfg = _G.ConfigManager.season_tower_pools_cfg[self.stage + 1]
            if nextStageCfg then
                local endTime = self:GetStartTime() + (nextStageCfg.time - 1) * 86400
                return _G.TimeUtil.GetServerUnixTime() >= endTime
            end
        end
    else
        if
            not _G.PlayerPrefsManager.HasKey(FirstKey) or
                (self:GetStartTime() > 0 and _G.PlayerPrefsManager.GetString(FirstKey) ~= _G.tostring(self:GetStartTime()))
         then
            return true
        end
    end

    return false
end

---设置首次登录
function SeasonTowerModel:SetFirst()
    _G.PlayerPrefsManager.SetString(FirstKey, _G.tostring(self:GetStartTime()))
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstTower.id, 0)
end

---获取礼包配置
function SeasonTowerModel:GetStoreCfg()
    if not self.storeCfg then
        local seasonCfg = require "SeasonModel":GetInstance():GetCfg()
        local id = _G.tonumber(seasonCfg.tower_pools[2][1])
        self.storeCfg = _G.ConfigManager.store_season_battle_cfg[id]
    end
    return self.storeCfg
end

---获取当前期数, 从0开始计数（x天一期）
function SeasonTowerModel:GetCurPeriods()
    local curDay = require "SeasonModel":GetInstance().curDay
    return (curDay - 1) // self.cycle
end

return SeasonTowerModel
