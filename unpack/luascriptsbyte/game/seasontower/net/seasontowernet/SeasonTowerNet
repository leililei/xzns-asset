local base = require "BaseGameNet"

---@class SeasonTowerNet : BaseGameNet	通信协议
local SeasonTowerNet = _G.BaseClass("SeasonTowerNet", base)

---@return SeasonTowerNet SeasonTowerNet
function SeasonTowerNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map
---@param pbData table PB数据
---@param callback function 完成回调
function SeasonTowerNet:Access(item, pbData, callback)
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
    return port
end

---获取心魔幻境信息
---@param pbData table PB数据
---@param callback function 完成回调
function SeasonTowerNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_season_tower_info, self:GetEmptyPB(), callback)
end
---领取奖励
---@param pbData season_tower.c2s_season_tower_award
function SeasonTowerNet:GetAward(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_season_tower_award_tower_award, pbData, callback)
end

---复活卡牌
function SeasonTowerNet:ReviveCard(callback)
    self:Access(_G.ConfigManager.net_map.game_season_tower_revive, self:GetEmptyPB(), callback)
end

---刷新此层怪物buff
function SeasonTowerNet:RefreshMonsterBuff(callback)
    self:Access(_G.ConfigManager.net_map.game_season_tower_refresh_buff, self:GetEmptyPB(), callback)
end

---战斗
function SeasonTowerNet:Fight(callback)
  return  self:Access(_G.ConfigManager.net_map.game_season_tower_fight_tower_fight, self:GetEmptyPB(), callback)
end

---选择buff
---@param pbData season_tower.c2s_season_tower_choose_buff
function SeasonTowerNet:ChooseBuff(callback)
    self:Access(_G.ConfigManager.net_map.game_season_tower_choose_buff, self:GetEmptyPB(), callback)
end
---进入下个阶段
---@param pbData season_tower.c2s_season_tower_choose_buff
function SeasonTowerNet:NextStage(callback)
    self:Access(_G.ConfigManager.net_map.game_season_tower_next_stage, self:GetEmptyPB(), callback)
end
---获取个人排行
function SeasonTowerNet:GetSelfRank(callback)
    self:Access(_G.ConfigManager.net_map.game_rank_get_rank_num, {type = 82}, callback)
end

function SeasonTowerNet:GetRank(callback)
    self:Access(_G.ConfigManager.net_map.game_rank_season_tower, {page = 1}, callback)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SeasonTowerNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type SeasonTowerNet
return SeasonTowerNet
