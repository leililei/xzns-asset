---@class TreasureMapView : UIBaseView	中文描述
---@field public go_table TreasureMapView_GoTable GoTable
---@field cfg item_cfg
local TreasureMapView = _G.BaseClass("TreasureMapView", _G.UIBaseView)
--_G.TreasureMapView = TreasureMapView
local Title = {"yu_cbt_txt_3", "yu_cbt_txt_2", "yu_cbt_txt_1"}
local Bottom = {"ui_cbt_role_diguangl", "ui_cbt_role_diguangz", "ui_cbt_role_diguangc"}
local Top = {"ui_cbt_role_dingguangl", "ui_cbt_role_dingguangz", "ui_cbt_role_dingguang"}
local effect = {"ef_Mapblue", "ef_Mappurple", "ef_Maporange"}
local FontShow = {{1, 2}, {3, 4}, {5, 6}}
local FiveElement = {"aorimage_j", "aorimage_m", "aorimage_s", "aorimage_h", "aorimage_t"}
local speed = 50
function TreasureMapView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TreasureMapView:OnCreate(id, pos)
    self.cfg = _G.ConfigManager.item_cfg[id]
    self.order = _G.tonumber(self.cfg.UseParameter[1][1])
    self.endPos = pos
    self:InitView()
    self:PlayAni()
    self:InitEffect()
end

function TreasureMapView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureMapView, self.go_table.trans_effect)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[effect[self.order]], self.go_table.trans_effect)
end
---播放移动动画
function TreasureMapView:PlayAni()
    self:MoveChan()
    self:MoveArrow()
end

function TreasureMapView:MoveArrow()
    local angle = _G.math.random(0, 360)
    self.arrowTweer =
        self.go_table.aorimage_arrow.transform:DOLocalRotate(_G.Vector3.New(0, 0, angle), angle / speed):OnComplete(
        _G.handler(self, self.MoveArrow)
    )
end

---初始化界面
function TreasureMapView:InitView()
    self.go_table.aorimage_title.SpriteName = Title[self.order]
    self.go_table.aorimage_top.SpriteName = Top[self.order]
    self.go_table.aorimage_bottom.SpriteName = Bottom[self.order]
    self:ShowFont()
end

function TreasureMapView:ShowFont()
    local type = self:GetArea()
    local tb = {}
    _G.table.insertto(tb, FontShow[type])
    _G.table.insert(tb, _G.math.random(7, 8))
    for i = 1, 3 do
        _G.GameUtil.SetActiveByCondition(self.go_table["aorimage_" .. tb[i]], true)
    end
    local element = _G.math.random(1, 5)
    self.go_table[FiveElement[element]].color = _G.ColorTools.Color_White
end

---获取藏宝图显示区域
function TreasureMapView:GetArea()
    for _, v in pairs(_G.ConfigManager.treasure_cfg) do
        for _, v2 in pairs(v.position1) do
            if v2[1] == self.endPos[1] and v2[2] == self.endPos[2] then
                return 1
            end
        end
        for _, v2 in pairs(v.position2) do
            if v2[1] == self.endPos[1] and v2[2] == self.endPos[2] then
                return 2
            end
        end
        for _, v2 in pairs(v.position3) do
            if v2[1] == self.endPos[1] and v2[2] == self.endPos[2] then
                return 3
            end
        end
    end
    return 1
end

---移动铲子
function TreasureMapView:MoveChan()
    self.tweer =
        self.go_table.aorimage_chan:DOLocalMoveX(529, 2):SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo):SetEase(
        _G.CS.DG.Tweening.Ease.Linear
    )
end

---停止移动铲子
function TreasureMapView:StopMoveChan()
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    if self.arrowTweer then
        self.arrowTweer:Kill()
        self.arrowTweer = nil
    end
    local x = self.go_table.aorimage_chan:GetLocalPosition()
    local x1, x2 = x, x + 42
    local ex = self.go_table.aorrawimage_double:GetLocalPosition()
    local w = self.go_table.aorrawimage_double:GetRectTransformSizeDelta()
    local type = 1
    if x2 <= ex - w / 2 or x1 > ex + w / 2 then
        type = 0
    end
    require "TreasureMapModel":GetInstance():GetAwardData(
        type,
        function()
            self:Close()
        end
    )
end

function TreasureMapView:OnStartClose()
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    if self.arrowTweer then
        self.arrowTweer:Kill()
        self.arrowTweer = nil
    end
end

---按钮点击事件在这里派发
function TreasureMapView:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_close == go then
        self:Close()
    elseif self.go_table.aorbtn_click == go then
        self:StopMoveChan()
    end
end

return TreasureMapView
