---@class TreasureMapQuick : UIBaseView	中文描述
---@field public go_table TreasureMapQuick_GoTable GoTable
local TreasureMapQuick = _G.BaseClass("TreasureMapQuick", _G.UIBaseView)

function TreasureMapQuick:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TreasureMapQuick:OnCreate()
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.TreasureQuick, self.ViewAnimationFinish, self)
end

---界面的销毁函数
function TreasureMapQuick:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.TreasureQuick, self.ViewAnimationFinish, self)
end

---按钮点击事件在这里派发
function TreasureMapQuick:OnClickBtn(go)
end

function TreasureMapQuick:ViewAnimationFinish()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.TreasureQuick, self.ViewAnimationFinish, self)
    require "TreasureMapModel":GetInstance():GetAwardData(1)
    self:Close()
end

return TreasureMapQuick