---@class TreasureMapModel : Singleton	中文描述
local TreasureMapModel = _G.BaseClass("TreasureMapModel", _G.Singleton)

function TreasureMapModel:__init()
    self.isRunning = false
end
---@return TreasureMapModel TreasureMapModel
function TreasureMapModel:GetInstance()
    return self.super.GetInstance(self)
end

function TreasureMapModel:VipTreasure()
    local Mian = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid) > 0 then
        _G.StorageManager:GetInstance():UsePropToServer(self.itemSid,1)
    else
        self.isRunning = false
        Mian:DisplayContinueTreasure(false)
    end
end

function TreasureMapModel:UseTreasureMap(pos,sid)
    if  not self.isVip then
        local pri = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({_G.PrivilegeType.TreasureMap.Quick,1})
        local isVip = not _G.table.isEmptyOrNil(pri)
        self.isVip = isVip
    end
    self.itemSid = sid
    self.endPos = pos
    if self.isVip then
        self.isRunning = true
        local Mian = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        Mian:DisplayContinueTreasure(true)
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BagNewView.Name)
    if _G.WorldManager:GetInstance():GetCurWorldSid() ~= 300 then
        _G.WorldManager:GetInstance():EnterWorld(
            300,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
                self.delay =
                    _G.DelayDo(
                    0.1,
                    function()
                        _G.WorldManager:GetInstance():GetCurWorldPlayer():GotoPoint(
                            _G.Vector3.New(pos[1], 0, pos[2]),
                            _G.handler(self, self.MoveEnd)
                        )
                    end
                )
                _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerMoveStart, self.PlayerMoveStart, self)
            end
        )
    else
        self.delay =
            _G.DelayDo(
            0.1,
            function()
                _G.WorldManager:GetInstance():GetCurWorldPlayer():GotoPoint(
                    _G.Vector3.New(pos[1], 0, pos[2]),
                    _G.handler(self, self.MoveEnd)
                )
            end
        )
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerMoveStart, self.PlayerMoveStart, self)
    end
end

function TreasureMapModel:MoveEnd()
    if self.delay then
        _G.coroutine.stopwaiting(self.delay)
        self.delay = nil
    end
    self.isTreasureMap = false
    _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerMoveStart, self.PlayerMoveStart, self)
    _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):ShowFindTresureMap(false)
    if self.isVip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TreasureMapQuick.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TreasureMapView.Name, self.itemSid, self.endPos)
    end

    _G.Events:GetInstance():Broadcast(_G.eGuideEvent.TreasureMap, false)
end

function TreasureMapModel:PlayerMoveStart(Uid)
    if Uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
        return
    end
    if not self.isTreasureMap then
        self.isTreasureMap = true
        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):ShowFindTresureMap(true)
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerMoveEnd, self.PlayerMoveEnd, self)

        _G.Events:GetInstance():Broadcast(_G.eGuideEvent.TreasureMap, true)
    else
        --被打断
        self.isTreasureMap = false
        self.isRunning = false
        if self.delay then
            _G.coroutine.stopwaiting(self.delay)
            self.delay = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerMoveEnd, self.PlayerMoveEnd, self)
        _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerMoveStart, self.PlayerMoveStart, self)
        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):ShowFindTresureMap(false)
        _G.Events:GetInstance():Broadcast(_G.eGuideEvent.TreasureMap, false)
    end
end

function TreasureMapModel:PlayerMoveEnd()
    if self.isTreasureMap then
        --被打断
        self.isTreasureMap = false
        if self.delay then
            _G.coroutine.stopwaiting(self.delay)
            self.delay = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerMoveStart, self.PlayerMoveStart, self)
        _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerMoveEnd, self.PlayerMoveEnd, self)
        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name):ShowFindTresureMap(false)

        _G.Events:GetInstance():Broadcast(_G.eGuideEvent.TreasureMap, false)
    end
end

function TreasureMapModel:GetAwardData(type, callback)
    require "TreasureMapNet":GetInstance():GetAward(
        {id = _G.tonumber(_G.ConfigManager.item_cfg[self.itemSid].UseParameter[1][1]), type = type},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local data = {}
            if msg.normal_award then
                data.award = msg.normal_award
                if msg.extra_award then
                    for _,v in pairs(msg.extra_award.item) do
                        v.type.ispri = true
                        if data.award.item then
                            _G.table.insert(data.award.item,v)
                        elseif data.award.overflow then
                            _G.table.insert(data.award.overflow,v)
                        end
                    end
                end
            end
            data.isTreasure = true
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.StorageManager:GetInstance():ConsumeItem(self.itemSid, nil, 1)
            if self.isVip then
                require "CommonTipManager".ShowSecretFloatTips(data)
                self:VipTreasure()
            else
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    data,
                    function()
                        if callback then
                            callback()
                        end
                        if _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid) > 0 then
                            ---@type MainView
                            local Mian = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
                            Mian:DisplayContinueTreasure(true)
                        end
                    end,
                    true,nil,nil,nil,nil,true)
            end
        end
    )
end

---获取奖励
function TreasureMapModel:GetAward()
    return {self.itemSid, _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid)}
end

---获取当前藏宝图sid
function TreasureMapModel:GetCurSid()
    return self.itemSid
end

function TreasureMapModel:GetRunning()
    return self.isRunning
end

function TreasureMapModel:SetRunning(isRunning)
    self.isRunning = isRunning
    if not self.isRunning then
        local TreasureMapQuick = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TreasureMapQuick.Name)
        if TreasureMapQuick then
            TreasureMapQuick:Close()
        end
    end
end

return TreasureMapModel
