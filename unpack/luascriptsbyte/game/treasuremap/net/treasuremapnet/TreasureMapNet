local base = require "BaseGameNet"

---@class TreasureMapNet : BaseGameNet	通信协议
local TreasureMapNet = _G.BaseClass("TreasureMapNet", base)

---@return TreasureMapNet TreasureMapNet
function TreasureMapNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---领取藏宝图奖励
---@param pbData table PB数据
---@param callback function 完成回调
function TreasureMapNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_treasure_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TreasureMapNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type TreasureMapNet
_G.TreasureMapNet = TreasureMapNet
return TreasureMapNet
