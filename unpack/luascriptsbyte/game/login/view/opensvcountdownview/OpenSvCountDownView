---按钮点击事件在这里派发
function OpenSvCountDownView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_gg" then
        --self:GetWHNotice(false)
        local login = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LoginView.Name)
        if login then
            login.isCompareNotice = false
            login:GetWHNotice(false)
        end
    elseif name == "@_aorbtn_sc" then
        --local cfg = _G.ConfigManager.community_global_cfg[101102]
        local ob
        local communityGlobal = _G.GameUtil.GetFunctionData(_G.FunctionBlock.communityGlobal)
        local id = communityGlobal[1]
        if id then
            local cfg = _G.ConfigManager.community_global_cfg[id]
            if cfg then
                ob = cfg.ob
            end
        end
        if not _G.string.IsNullOrEmpty(ob) then
            _G.CS.UnityEngine.Application.OpenURL(ob)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("跳转链接为空")
            end
        end
    elseif name == "@_aorbtn_close" then
        self:Close()
    end
end

function OpenSvCountDownView:OnStartClose()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

return OpenSvCountDownView
