---@class OpenSvCountDownView : UIBaseView	开服倒计时界面
---@field public go_table OpenSvCountDownView_GoTable GoTable
local OpenSvCountDownView = _G.BaseClass("OpenSvCountDownView", _G.UIBaseView)
function OpenSvCountDownView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.IsSDK = _G.CS.Launcher.Inst.IsSDK
end

---界面的入口函数
function OpenSvCountDownView:OnCreate(lastTime)
    self.lastTime = lastTime

    if _G.AppSetting.DEBUG then
        _G.Log(self.lastTime, "当前开服倒计时时间")
    end

    self:CreateSpine()

    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateTime, self, false)
        self.timer:Start()
    end

    self:ShowTime()
end

function OpenSvCountDownView:UpdateTime(elapsed)
    self.lastTime = self.lastTime - elapsed
    self:ShowTime()
    if self.lastTime <= 0 then
        self:Close()
    end
end

function OpenSvCountDownView:ShowTime()
    self.times = TimeUtil.TimeToString(self.lastTime, 4)
    self.timestrs = string.split(self.times, ":")

    self.go_table.aortext_countDownt.text = self.timestrs[1]
    self.go_table.aortext_countDowns.text = self.timestrs[2]
    self.go_table.aortext_countDownf.text = self.timestrs[3]
end

function OpenSvCountDownView:CreateSpine()
    self.go_table.obj_role:SetActiveE(1)
    local trans = self.go_table.obj_role
    trans:ClearChildren()
    local cfg = _G.ConfigManager.card_cfg[111010000]
    local path = cfg.ModelPathHi

    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        trans,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
            end
            trans:SetLocalScaleXYZ(0.37)
            trans:SetLocalPosition(-195, -183, 0)
        end
    )
end

