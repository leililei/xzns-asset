---获取托管ip端口
---@return number|nil ,number   ip, port
function LoginView:GetTrustIpPort()
    local ip = self.go_table.input_trustIp.text
    local port = self.go_table.input_trustPort.text
    local serverId = self.go_table.input_trustServerId.text
    local tUid = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(ip) == true then
        ip = nil
    end
    if _G.string.IsNullOrEmpty(port) == true then
        port = nil
    end
    if _G.string.IsNullOrEmpty(serverId) == true then
        serverId = nil
    end
    if nil ~= port then
        port = _G.tonumber(port)
    end
    if nil ~= serverId then
        serverId = _G.tonumber(serverId)
    end
    if _G.string.IsNullOrEmpty(tUid) == true then
        tUid = nil
    end
    return ip, port, serverId, tUid
end

