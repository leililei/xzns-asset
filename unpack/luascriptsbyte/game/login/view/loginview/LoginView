---获取隐私协议和用户协议(H5不能跳转网页，所以通过游戏内弹窗的方式弹出)
function LoginView:OnGetAgreement(herfParam, callBack)
    if self.IsSDK and (not _G.LoginManager:GetInstance().isSDKLoginSuccess) then
        if self.clicktime ~= nil and _G.Time.time - self.clicktime < 2 then
            return
        end
        self.clicktime = _G.Time.time
        _G.SDKManager:GetInstance():SendLoginEx()
        return
    end
    local url
    local title = ""
    local WechatGameApp = _G.CS.WechatGameCore.WechatGameApp.Instance
    if _G.tonumber(herfParam) == 1 then
        ---隐私协议
        url = WechatGameApp.PrivacyAgreement
        title = _G.GetLangPackValue(90000011257)
    else
        ---用户协议
        url = WechatGameApp.UserAgreement
        title = _G.GetLangPackValue(90000011258)
    end
    if not _G.string.IsNullOrEmpty(url) then
        _G.CS.GameUtility.HttpRequest(
                url,
                function(result, resultData)
                    if result then
                        _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.AgreementTipView.Name,
                                title,
                                resultData,
                                callBack
                        )
                    end
                end
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("获取的url地址为空！")
        end
    end
end

---点击超链接
function LoginView:OnHrefClick(herfParam, callBack)
    if self.IsSDK and (not _G.LoginManager:GetInstance().isSDKLoginSuccess) then
        if self.clicktime ~= nil and _G.Time.time - self.clicktime < 2 then
            return
        end
        self.clicktime = _G.Time.time
        _G.SDKManager:GetInstance():SendLoginEx()
        return
    end
    if _G.AppSetting.DEBUG then
        _G.Log(herfParam, "超链接参数")
    end
    if not self.IsShowExtend then
        return
    end

    if _G.AppSetting.IsWebGl then
        self:OnGetAgreement(herfParam, callBack)
        --小游戏内不能打开外置，所以下面的放置只能APP平台使用
        return
    end

    local WechatGameApp = _G.CS.WechatGameCore.WechatGameApp.Instance
    if _G.tonumber(herfParam) == 1 then
        ---隐私政策
        if _G.string.IsNullOrEmpty(WechatGameApp.PrivacyAgreement) then
            if _G.AppSetting.DEBUG then
                _G.LogError("挂接后台没有配置隐私政策跳转链接！")
            end
            return
        end
        _G.GameUtil.OpenUrl(WechatGameApp.PrivacyAgreement)
    else
        ---用户协议
        if _G.string.IsNullOrEmpty(WechatGameApp.UserAgreement) then
            if _G.AppSetting.DEBUG then
                _G.LogError("挂接后台没有配置用户协议跳转链接！")
            end
            return
        end
        _G.GameUtil.OpenUrl(WechatGameApp.UserAgreement)
    end
    if callBack and type(callBack) == "function" then
        callBack()
    end
end

-- 按钮单击事件--
function LoginView:OnClickBtn(go)
    if go ~= self.go_table.toggle_xieyi and self.IsSDK and (not _G.LoginManager:GetInstance().isSDKLoginSuccess) then
        if self.clicktime ~= nil and _G.Time.time - self.clicktime < 2 then
            return
        end
        self.clicktime = _G.Time.time
        _G.SDKManager:GetInstance():SendLoginEx()
        return
    end
    --单独放行aorbtn_login按钮事件
    if self.IsSDK and (self.canClick == false) and go:GetName() ~= "@_aorbtn_login" then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red>" .. go:GetName() .. "  self.canClick:" .. tostring(self.canClick) .. "</color>")
        end
        return
    end
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("<color=red>" .. "OnClickBtn:    " .. name .. "</color>")
    end
    if name == "@_aorbtn_btnStart" then
        --ZHJH5ZHJH-13846 【ZHJH】【H5】魔兽海外繁体10月主任务ZHJH-14222
        --【前端】海外繁体新增“开服倒计时”功能
        if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.countdown_tips) then
            local lasttime = _G.ServerManager:GetInstance().CurServer.OpenServerTime - os.time()
            if _G.AppSetting.DEBUG then
                _G.Log(_G.ServerManager:GetInstance().CurServer.OpenServerTime, "登录界面sdk开服时间")
                _G.Log(os.time(), "登录界面lua获取utc时间")
                _G.Log(lasttime, "登录界面当前开服倒计时时间")
            end
            if lasttime > 0 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.OpenSvCountDownView.Name, lasttime)
                return
            end
        end
        -- TODO 单机版
