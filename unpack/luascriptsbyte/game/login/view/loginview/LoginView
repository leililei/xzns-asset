---初始化社区
function LoginView:InitCommunity(communityGlobal)
    for _, v in pairs(communityGlobal) do
        local cfg = _G.ConfigManager.community_global_cfg[v]
        if cfg then
            local obj = _G.InstantiateObject(self.go_table.aorbtn_community, self.go_table.obj_menu)
            obj:SetActiveE(1)
            local tb = _G.GetAutoGoTable(obj)
            _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickCommunityBtn, cfg.ob))
            tb.aorimage_icon.SpriteName = cfg.icon
            tb.aortext_community.text = _G.GetLangPackValue(cfg.title)
        end
    end
end

function LoginView:OnClickCommunityBtn(obj, isOn, ob)
    if not _G.string.IsNullOrEmpty(ob) then
        _G.GameUtil.OpenUrl(ob)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("跳转链接为空")
        end
    end
end

function LoginView:InitChannelInfo()
    ---默认净化
    local banhao = 90021100048
    local public = 90021100047
    local beian = 0

    local platform = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
    if _G.AppSetting.DEBUG then
        _G.Log(platform, "渠道id")
    end
    --ZHJH-9735 英文侧显示英文logo
    local isUseChinese = _G.GameUtil.GetIsUseChinese()
    self.go_table.aortext_jkgg.fontSize = isUseChinese and 18 or 12

    if _G.AppSetting.IsXzns then
        _G.PoolsManager:GetInstance():Spawn(_G.GameUtil.GetFunctionData(_G.FunctionBlock.LoginBg), _G.ePoolType.Default, self.go_table.obj_bgNode, function(obj)
            CS.Launcher.Inst:CloseLoading()
            if self:IsNil() then
                _G.DestroyObject(obj)
                return
            end
            _G.UIUtils.SetCanvasSortingOrder(obj, self.go_table.gameObject)
            ---@type xzns_bg_GoTable
            local goTable = _G.GetAutoGoTable(obj)
            if not _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.Log) then
                goTable.obj_logoNode:SetActiveE(0)
            end
        end)
    else
        local imgPath = "ImagesH5/nLogin/ui_dljm_bg"
        local loadingData = _G.GameUtil.GetFunctionData(_G.FunctionBlock.loading)
        if not _G.table.isEmptyOrNil(loadingData) then
            imgPath = loadingData[1]
            self.logoEffect = loadingData[2]
        end
        if imgPath then
            self.go_table.aorrawimage_background:LoadImage(
                    imgPath,
                    function(img)
                        if self:IsNil() then
                            return
                        end
                        img:SetNativeSize()
                        CS.Launcher.Inst:CloseLoading()
                    end
            )
        end
    end

    ---星耀和秒悦有多个子渠道，需要根据渠道id显示不同的资质信息
    local channelList = _G.GameUtil.GetFunctionData(_G.FunctionBlock.PrivacyPolicyID) or {}

    if _G.AppSetting.DEBUG then
        _G.Log(_G.AppSetting.GameChannel, "游戏渠道类型")
        _G.Log(channelList, "游戏渠道离散信息")
    end

    if not _G.table.isEmptyOrNil(channelList) then
        public = channelList[1]
        banhao = channelList[2]
        beian = channelList[3]
    end

    if not _G.AppSetting.IsXzns then
        local logoPath = _G.GameUtil.GetFunctionData(_G.FunctionBlock.Log)
        if not _G.string.IsNullOrEmpty(logoPath) then
            self.go_table.aorrawimage_logo:LoadImage(
                    logoPath,
                    function(img)
                        if self:IsNil() then
                            return
                        end
                        img:SetActiveE(1)
                        img:SetNativeSize()
                    end
            )
        else
            self.go_table.aorrawimage_logo:SetActiveE(0)
        end
    end

    if banhao and banhao > 0 then
        self.go_table.aortext_banhao.text = _G.GetLangPackValue(banhao)
    else
        self.go_table.aortext_banhao.text = ""
    end
    if public and public > 0 then
        self.go_table.aortext_public.text = _G.GetLangPackValue(public)
    else
        self.go_table.aortext_public.text = ""
    end

    if _G.AppSetting.DEBUG then
        _G.Log(beian, "游戏备案信息")
    end
    if beian and beian > 0 then
        self.go_table.obj_beian:SetActiveE(1)
        if not self.go_table.ExtendTextBA then
            self.go_table.ExtendTextBA = self.go_table.obj_beian:GetComponentE(typeof(CS.ExtendText))
            self.go_table.ExtendTextBA.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClickBA))
            self.go_table.ExtendTextBA.text = GetLangPackValue(beian)
        end
        if _G.AppSetting.DEBUG then
            _G.Log("游戏备案信息显示")
        end
    else
        self.go_table.obj_beian:SetActiveE(0)
        if _G.AppSetting.DEBUG then
            _G.Log("游戏备案信息隐藏")
        end
    end

    --海外显示语言设置按钮
    local cfg = _G.GameUtil.GetFunctionData(_G.FunctionBlock.language_list)
    if cfg and #cfg > 0 then
        self.go_table.aorbtn_lang:SetActiveE(_G.AppSetting.LanguageChoose and 1 or 0)
    else
        self.go_table.aorbtn_lang:SetActiveE(0)
    end
end

