---等待Loading结束后初始化
function LoginView:WaitForInitView()
    while (not _G.CS.Launcher.Inst.IsShowSplashOver) do
        --闪屏没结束,继续等待
        _G.coroutine.waitforendofframe()
    end
    if self.IsSDK then
        -- _G.SDKManager:GetInstance():SendLoginEx()
        --发送SDK登录请求
        -- if self.WaitloginTimer then
        --     self.WaitloginTimer:Stop()
        --     self.WaitloginTimer = nil
        -- end
        -- self:GetWHNotice()
        -- self.WaitloginTimer = _G.TimerManager:GetInstance():GetTimer(2, self.OnWaitLoginTimer, self, true, false, true)
        -- self.WaitloginTimer:Start()
        if not _G.LoginManager:GetInstance().isSDKLoginSuccess and not self.initLoginForbidden then
            _G.SDKManager:GetInstance():SendLoginEx()
        else
            self.canClick = true
            self:InitView()
            self:CompareNotice(false)
        end
    else
        self:InitView()
        self:CompareNotice()
    end
end

function LoginView:OnWaitLoginTimer()
    if self.WaitloginTimer then
        self.WaitloginTimer:Stop()
        self.WaitloginTimer = nil
    else
        return
    end
    if not _G.LoginManager:GetInstance().isSDKLoginSuccess then
        _G.SDKManager:GetInstance():SendLoginEx()
    else
        self.canClick = true
        self:InitView()
    end
end

---初始化UI显示
function LoginView:InitView()
    local rawImage = self.go_table.aorbtn_gonggao:GetComponentE(typeof(CS.AorRawImage))
    _G.UIUtils.RawImageByLanguageCfg(rawImage, self.language_keys.gonggao)
    rawImage = self.go_table.aorbtn_kefu:GetComponentE(typeof(CS.AorRawImage))
    _G.UIUtils.RawImageByLanguageCfg(rawImage, self.language_keys.kefu)

    _G.UIUtils.RawImageByLanguageCfg(self.go_table.aorrawimage_dianjipingmu, self.language_keys.dianjipingmu)

    local info
    if self.IsSDK and not _G.AppSetting.IsTuoGuan then
        info = _G.ServerManager:GetInstance():GetLastServer()
    else
        _G.ServerManager:GetInstance():InitLocalServerList()
        info = _G.ServerManager:GetInstance():GetLastServer()
    end

    self.loginInfo = info

    --region --------------------------------------托管登录--------

    self.go_table.obj_trust:SetActiveE(_G.AppSetting.IsTuoGuan and 1 or 0)
    if _G.AppSetting.IsTuoGuan then
        local trustIp, trustPort, trustServerId, trustUid = _G.LoginManager:GetInstance():TrustServerGet()
        if trustIp ~= nil then
            self.go_table.input_trustIp.text = trustIp
        end
        if trustPort ~= nil then
            self.go_table.input_trustPort.text = trustPort
        end

        if trustServerId ~= nil then
            self.go_table.input_trustServerId.text = trustServerId
        end

        if trustUid ~= nil then
            self.go_table.input_Name.text = trustUid
        end

        self.go_table.aortext_Placeholder.text = GetLangPackValue(90022500415)
        self.go_table.input_Name:SetActiveE(1)
    else
        --endregion------------------------------------托管登录--------
        if self.IsSDK then
            _G.GameUtil.SetActiveByCondition(self.go_table.input_Name, false)
        else
            if not string.IsNullOrEmpty(self.loginInfo.AccountName) then
                self.go_table.input_Name.text = self.loginInfo.AccountName
            else
                _G.GameUtil.SetActiveByCondition(self.go_table.input_Name, true)
            end
        end
    end

    if self.loginInfo then
        self:SelectServer(info)
    end

    self.IsShowExtend = true
    self:OnShowExtendText()
    if _G.AppSetting.IsDouYin and require("DouyinModel"):GetInstance().feed then
        ---从抖音直完场景进入的游戏拉取服务器列表成功后就自动登录
        self:OnClickBtn(self.go_table.aorbtn_btnStart)
        return
    end
end

