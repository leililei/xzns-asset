        -- chapterModel:EnterSection(
        --     function()
        _G.ChapterRoomManager:GetInstance():JoinSection(defaultSection)
        --     end
        -- )
    end
    if isNotFirst then
        -- storyCall() --屏蔽序章
        require "PlayerNewCreateController":GetInstance():CreateRole()
    else
        self:DoJoinStory(
                function()
                    require "PlayerNewCreateController":GetInstance():CreateRole()
