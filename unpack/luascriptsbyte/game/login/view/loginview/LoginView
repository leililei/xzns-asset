function LoginView:GetNoticeInfoSuccess(list, call)
    -- 格式
    -- 最后一次GM更新公告的时间戳$
    -- 公告id~公告标题~公告内容~图片url~点击跳转url~发布时间~截止时间~置顶顺序|

    if _G.AppSetting.DEBUG then
        _G.Log(list, "<color=red>" .. "获取公告成功>>>" .. "</color>")
    end

    ---@field sort string
    ---@field endTime string
    ---@field startTime string
    ---@field imgJumpUrl string
    ---@field imgUrl string
    ---@field context string
    ---@field title string
    ---@field id string
    ---@class NoticeItem

    ---公告条目列表
    if not _G.table.isEmptyOrNil(list) then
        local isRun, noticeList = _G.pcall(self.ParseNotice, self, list)
        if isRun and not _G.table.isEmptyOrNil(noticeList) then
            self:ShowAnnouncementView(noticeList, call)
        else
            if not isRun and _G.AppSetting.DEBUG then
                LogError(noticeList)
            end
            self:GetNoticeInfoError()
            if call then
                call()
            end
        end
    else
        self:GetNoticeInfoError()
        if call then
            call()
        end
    end
end

---解析公告
function LoginView:ParseNotice(list)
    if _G.table.isEmptyOrNil(list) then
        return
    end
    ---@type NoticeItem[]
    local noticeList = {}
    local time = _G.TimeUtil.GetServerUnixTime()
    local tonumber = _G.tonumber
    -- 标题~正文~起始时间~终止时间~排序$下一条公告
    for _, v in pairs(list) do
        ---@type NoticeItem
        local notice = {}
        notice.id = v.id
        notice.title = v.title
        notice.context = v.content
        notice.startTime = tonumber(v.start_time) or time
        notice.endTime = tonumber(v.end_time) or time
        notice.sort = v.id
        if notice.endTime == 0 or time <= notice.endTime then
            _G.table.insert(noticeList, notice)
        else
            if _G.AppSetting.DEBUG then
                _G.Log("<color=red>" .. "公告条目格式错误>>>" .. "</color>")
            end
        end
    end
    return noticeList
end

