---获取维护公告内容
function LoginView:OnGetWHNotice(args)
    if not self.WaitloginTimer and not _G.LoginManager:GetInstance().isSDKLoginSuccess then
        return
    end
    if self.WaitloginTimer then
        self.WaitloginTimer:Stop()
        self.WaitloginTimer = nil
    end
    if self.isCompareNotice then
        self:CheckOpenNotice(args)
        return
    end
    self:OnGetMaintainnotice(args, _G.handler(self, self.GetMaintainnoticeCall))
end

function LoginView:GetMaintainnoticeCall()
    if not _G.LoginManager:GetInstance().isSDKLoginSuccess then
        _G.SDKManager:GetInstance():SendLoginEx()
    end
end

function LoginView:OnGetMaintainnotice(args, call)
    if args and args.notice_list then
        self:GetNoticeInfoSuccess(args.notice_list, call)
    else
        self:GetNoticeInfoError()
        if call then
            call()
        end
    end
end

function LoginView:OnFangchenmiFlag(args)
    local age = tonumber(args)
    _G.PlayerModel:GetInstance().SDK_AgeState = age
    _G.LoginManager:GetInstance():LoginServer(self.go_table.input_Name.text)
end

