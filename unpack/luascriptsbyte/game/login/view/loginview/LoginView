function LoginView:SetDefaultOpen()
    if _G.GameUtil.GetFunctionData(_G.FunctionBlock.SpecialCheck) then
        return false
    end

    local privacy = _G.GameUtil.GetFunctionData(_G.FunctionBlock.Privacy)
    if privacy then
        --0或不填-不勾选，1-正式服默认勾选，提审默认不勾选，2-不区分状态默认勾选
        if privacy == 1 and not _G.AppSetting.IsArraigned then
            return true
        elseif privacy == 2 then
            return true
        end
    end
    return false
end

