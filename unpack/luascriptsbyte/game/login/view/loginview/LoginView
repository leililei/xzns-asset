function LoginView:OnDisable()
    if self.IsSDK then
        _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetServerListSuccess, self.OnGetServerListSuccess, self)
        _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetMaintainnotice, self.OnGetMaintainnotice, self)
        _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetNotice, self.OnGetWHNotice, self)
        _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.FangchenmiFlag, self.OnFangchenmiFlag, self)
    end
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.LoginSucceed, self.LoginSucceed, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetUserInfoCall, self.OnGetUserInfoCall, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.NewPlayer, self.OnNewPlayer, self)
end

return LoginView