---检测是否有新公告
function LoginView:CompareNotice(retry)
    --sdk未登录时, 不要拉取公告
    if self.IsSDK and not _G.LoginManager:GetInstance().isSDKLoginSuccess then
        return
    end

    local firstOpen = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.FirstOpenAgreement, 0, true)
    if ((_G.AppSetting.IsArraigned and _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.SpecialCheck)) or _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.SpecialCheck1))
            and firstOpen == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTipsExtend(180107, nil, function()
            self.isCompareNotice = true
            self:GetWHNotice(retry)
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.FirstOpenAgreement, 1, true)
        end, function()
            _G.SDKManager:GetInstance():SendExit()
        end, nil, nil, { noBgClose = true, showExtendText = true, extendTextCall = _G.handler(self, self.OnHrefClick) })
    else
        self.isCompareNotice = true
        self:GetWHNotice(retry)
    end
    if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.SpecialCheck) then
        _G.AppSetting.IsArraigned = false
    end
end

---有新公告就打开公告
function LoginView:CheckOpenNotice(args)
    if self:IsNil() then
        return
    end
    local maxReadId = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.LoginNoticeCheck, 0, true)
    if maxReadId > 0 then
        if args.notice_list then
            for _, v in pairs(args.notice_list) do
                if v.id > maxReadId then
                    self:OnGetMaintainnotice(args, _G.handler(self, self.GetMaintainnoticeCall))
                    return
                end
            end
        end
    else
        self:OnGetMaintainnotice(args, _G.handler(self, self.GetMaintainnoticeCall))
    end
end

