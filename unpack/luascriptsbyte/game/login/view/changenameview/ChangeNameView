--返回当前字符实际占用的字符数
local function SubStringGetByteCount(str, index)
    local curByte = string.byte(str, index)
    local byteCount = 1
    if curByte == nil then
        byteCount = 0
    elseif curByte > 0 and curByte <= 127 then
        byteCount = 1
    elseif curByte >= 192 and curByte <= 223 then
        byteCount = 2
    elseif curByte >= 224 and curByte <= 239 then
        byteCount = 3
    elseif curByte >= 240 and curByte <= 247 then
        byteCount = 4
    end
    return byteCount
end
--防止输入超12字符
function ChangeNameView:SubStringGetTotalIndex(str)
    local curIndex = 0
    local i = 1
    local lastCount = 1

    --- 策划要求12字符 中英文混输 中文算2字符 英文1
    local width = 0

    repeat
        lastCount = SubStringGetByteCount(str, i)

        if lastCount ~= 0 then
            if lastCount == 1 then
                width = width + 1
            else
                width = width + 2
            end
        end
        curIndex = curIndex + 1
        if width > 12 then
            local ssstr = string.sub(str, 1, i - 1)
            self.go_table.input_Name.text = ssstr
            break
        end
        i = i + lastCount
    until (lastCount == 0)
    -- return curIndex - 1
    -- return width
end

---@param eventData UnityEngine.EventSystems.PointerEventData
function ChangeNameView:onDown(go, eventData)
    -- @type InputField
    -- local dsdsd = ni
    if "" ~= self.go_table.input_Name.text then
        local rect = self.go_table.input_Name.textComponent.rect
        rect:DOAnchorPos(Vector2.New(0, 0), 0.1)

        self:DelClickDownTween()
        self.ClickDownTween =
            _G.DOTween.To(
            function()
                return self.go_table.aorimage_guilinag.fillAmount
            end,
            function(x)
                self.go_table.aorimage_guilinag.fillAmount = x
            end,
            1,
            1.5
        )
        self.ClickDownTween.onComplete = function()
            self:CreateRole()
        end
    end
end

function ChangeNameView:OnStartClose()
    if self.DelayDo_timer ~= nil then
        _G.coroutine.stopwaiting(self.DelayDo_timer)
        self.DelayDo_timer = nil
    end
end

---@param eventData UnityEngine.EventSystems.PointerEventData
function ChangeNameView:onUp(go, eventData)
    self:DelClickDownTween()
    self.go_table.aorimage_guilinag.fillAmount = 0
end

function ChangeNameView:DelClickDownTween()
    if not _G.IsNil(self.ClickDownTween) then
        self.ClickDownTween:Kill()
    end
end

