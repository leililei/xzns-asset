-- 按钮单击事件--
function ChangeNameView:OnClickBtn(go, isOn, cfg)
    local name = go:GetName()

    if _G.AppSetting.DEBUG then
        _G.Log("ChangeNameView:OnClickBtn>>>" .. name)
    end

    if name == "@_aorbtn_btnCreate" then
        self:CreateRole()
    elseif name == "@_aorbtn_RandomName" then
        self.go_table.input_Name.text = _G.LoginManager:GetInstance():GetRandomName()
    end
end

---强制取名协议数据处理
---@param message public.ReplyOk
function ChangeNameView:UpdateNameSucceed(message)
    if message.ack == 1 then --取名成功
        _G.PlayerModel:GetInstance().role_name = self.go_table.input_Name.text
        self:CloseView()
        _G.LoginManager:GetInstance():StartLoginInfo()
        -- elseif message.ack == "role_trust_no_create" then --托管用户不创建
        --
        if _G.AppSetting.DEBUG then
            _G.Log("托管用户不创建", "<color=red>" .. ">>>" .. "</color>")
        end
        -- elseif message.ack == "role_already_create" then --角色已经创建
        --
        if _G.AppSetting.DEBUG then
            _G.Log("角色已经创建", "<color=red>" .. ">>>" .. "</color>")
        end
    end
end

function ChangeNameView:CreateRole()
    local nameStr = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(nameStr) then
        _G.PopWindowManager:GetInstance():ShowAllTips(200117)
        return
    end
    if self.nameCallback then
        self.nameCallback(nameStr)
    else
        --end
        -- local isIllegal = _G.CS.DenyWordModel.Instance:IsIllegal(nameStr)
        -- if isIllegal then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(200118)
        -- else
        _G.GameUtil.SecCheck(nameStr, "1",function()
            local msg = {}
            msg.name = nameStr
            require("UserNet"):GetInstance():UpdateName(msg, _G.handler(self, self.UpdateNameSucceed))
        end)
    end
end

---销毁对象时,析构函数
function ChangeNameView:CloseView()
    if not _G.IsNil(self.sceneTrans) then
        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
        self.sceneTrans = nil
    end
    if _G.WorldManager:GetInstance().CurrentWorld ~= nil then
        _G.WorldManager:GetInstance().CurrentWorld:ShowOrHideAllItem(true)
    end
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    self:Close()
end

