---@class AgreementTipView : UIBaseView	中文描述
---@field public go_table AgreementTipView_GoTable GoTable
local AgreementTipView = _G.BaseClass("AgreementTipView", _G.UIBaseView)

function AgreementTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function AgreementTipView:OnCreate(title, content, callBack)
    self.callBack = callBack
    self.go_table.aortext_title.text = title
    ---解析文本内容
    if not _G.string.IsNullOrEmpty(content) then
        content = _G.string.replace(content, "%[%n%]", "\n")
        content = _G.string.replace(content, "%[%-%]", "</color>")
        content = _G.string.replace(content, "%[", "<color=#")
        content = _G.string.replace(content, "%]", ">")
    end
    ---因为文本过长，所以需要做文本拆分
    self.contentList = _G.string.split2tbl(content, "\n")
    self.go_table.looplist2_content:InitListView(#self.contentList, _G.handler(self, self.OnRefreshContent))
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.FirstOpenAgreement, 1, true)
end

function AgreementTipView:OnRefreshContent(listView2, index)
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local tb = _G.GetAutoGoTable(item)
    local contentText = tb.gameObject:GetComponentE(_G.typeof(_G.CS.AorText))
    contentText.text = self.contentList[index + 1] or ""
    _G.GameUtil.ReBuildRTF(tb.gameObject)

    return item
end

---界面的销毁函数
function AgreementTipView:OnDestroy()
    if self.callBack then
        self.callBack()
        self.callBack = nil
    end
end

---按钮点击事件在这里派发
function AgreementTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return AgreementTipView