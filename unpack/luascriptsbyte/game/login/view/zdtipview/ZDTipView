---@class ZDTipView : UIBaseView	中文描述
---@field public go_table ZDTipView_GoTable GoTable
local ZDTipView = _G.BaseClass("ZDTipView", _G.UIBaseView)

function ZDTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ZDTipView:OnCreate(data)
    if _G.AppSetting.DEBUG then
        _G.LogError(data, "转端SDK配置数据：")
    end
    self.go_table.aortext_title.text = data.popTit or ""
    local desc = ""
    if data.popDesc then
        if _G.type(data.popDesc) == "string" then
            desc = data.popDesc
        else
            local maxIndex = #data.popDesc
            for i, v in ipairs(data.popDesc) do
                if i == maxIndex then
                    desc = desc .. v
                else
                    desc = desc .. v .. "\n"
                end
            end
        end
    end
    self.go_table.aortext_desc.text = desc
    _G.CS.GameUtility.RequestTexture(
        data.zdQrcode,
        function(result, texture)
            if result then
                self.go_table.aorrawimage_icon.texture = texture
                self.go_table.aorrawimage_icon.Alpha = 1
                -- self.go_table.aorrawimage_icon:SetNativeSize()
            end
        end
    )
end

---界面的销毁函数
function ZDTipView:OnDestroy()
end

---按钮点击事件在这里派发
function ZDTipView:OnClickBtn(go)
end

return ZDTipView
