---@class AnnouncementView : UIBaseView	公告界面
---@field public go_table AnnouncementView_GoTable GoTable
---@field NoticeItemList NoticeItem[]
local AnnouncementView = _G.BaseClass("AnnouncementView", _G.UIBaseView)
local xpcall = _G.xpcall
function AnnouncementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_close"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self.UiCfg = {
        --- 侧标栏 公告按钮 text
        btntext = {
            -- 未选中
            wxz = Color(126 / 255, 131 / 255, 159 / 255, 255 / 255),
            --- 选中
            xz = Color(255 / 255, 255 / 255, 255 / 255, 255 / 255)
        }
    }

    --- 当前 侧边栏选中公告索引
    self.NowSelectIndex = -1

    ---@type NoticeItem[]
    self.NoticeItemList = {}
end

---界面的入口函数
---@param NoticeItemList  NoticeItem[]
function AnnouncementView:OnCreate(NoticeItemList, lastTime, callback)
    --self.go_table.aorimage_Announcement:LoadImage(_G.LangUtil.GetLangPackValue(90021100027))
    xpcall(self.ShowView, _G.handler(self, self.OnError), self, NoticeItemList, lastTime, callback)
end

function AnnouncementView:ShowView(NoticeItemList, lastTime, callback)
    self.NoticeItemList = NoticeItemList
    self.lastTime = lastTime
    self:AddRest()
    -- self:SortNotice()
    self.callback = callback
    self.ResLoadCompleteCall = _G.handler(self, self.OnSetData)
end

function AnnouncementView:OnSetData()
    xpcall(self.SetData, _G.handler(self, self.OnError), self)
end

function AnnouncementView:OnError(msg)
    if _G.AppSetting.DEBUG then
        LogError(msg)
    end
    self:CloseView()
end

---公告排序
function AnnouncementView:SortNotice()
    _G.table.sort(
        self.NoticeItemList,
        function(a, b)
            return a.sort < b.sort
        end
    )
end
---资源加载
function AnnouncementView:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function AnnouncementView:SetData()
    self.ggitemList = {}

    for Index, value in pairs(self.NoticeItemList) do
        local obj = self.go_table.obj_Btn:InstantiatE(self.go_table.obj_ItemList)
        local gotable = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClick_Select, Index))
        gotable.Info = value
        gotable.aortext_text.text = value.title
        gotable.aortext_textOn.text = value.title
        -- _G.GameUtil.SetActiveByCondition(gotable.obj_new, value.startTime == self.lastTime)
        self.ggitemList[Index] = gotable
        gotable.aorimage_OnBg:SetActiveE(0)
    end
    self.go_table.obj_Btn:SetActiveE(0)
    self:SetReadNotice()
    self:SetNowSelectIndex(1)
end

function AnnouncementView:SetNowSelectIndex(index)
    if index == nil or self.NowSelectIndex == index then
        return
    end

    local gotable = self.ggitemList[self.NowSelectIndex]
    if gotable ~= nil then
        gotable.aorimage_OnBg:SetActiveE(0)
    -- gotable.aortext_text.color = self.UiCfg.btntext.wxz
    end

    gotable = self.ggitemList[index]
    if gotable ~= nil then
        gotable.aorimage_OnBg:SetActiveE(1)
    --   gotable.aortext_text.color = self.UiCfg.btntext.xz
    end

    self.NowSelectIndex = index

    self:ShowNowInfo()
end

function AnnouncementView:ShowNowInfo()
    local gotable = self.ggitemList[self.NowSelectIndex]
    if gotable ~= nil then
        ---@type NoticeItem
        local info = gotable.Info

        local newInfo = _G.string.replace(info.context, "%[%n%]", "\n")
        newInfo = _G.string.replace(newInfo, "%[%-%]", "</color>")
        newInfo = _G.string.replace(newInfo, "%[", "<color=#")
        newInfo = _G.string.replace(newInfo, "%]", ">")

        --local newInfos = _G.CS.System.Text.RegularExpressions.Regex.Unescape(newInfo)

        self.go_table.aortext_info.text = newInfo
        self.go_table.aortext_title.text = info.title
    end
end

function AnnouncementView:SetReadNotice()
    local maxReadId = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.LoginNoticeCheck, 0, true)
    for _, v in pairs(self.NoticeItemList) do
        if v.id > maxReadId then
            maxReadId = v.id
        end
    end
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.LoginNoticeCheck, maxReadId, true)
end

function AnnouncementView:CloseView()
    if self.callback then
        self.callback()
    end
    self:Close()
end

--region --------------------------------------点击事件--------

function AnnouncementView:OnClick_Select(go, isOn, Index)
    self:SetNowSelectIndex(Index)
end

--endregion

---按钮点击事件在这里派发
function AnnouncementView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return AnnouncementView
