---@class LoginNet : BaseGameNet	中文描述
local LoginNet = _G.BaseClass("LoginNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return LoginNet LoginNet
function LoginNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---连接服务器
---@param ip string ip
---@param port number port
function LoginNet:ConnectServer(ip, port)
    _G.LoginManager:GetInstance().IsLoginSucceed = false
    _G.GameNetTipsManager:GetInstance().mAccessMsgCount = 0
    _G.Net.CloseAllConnects()
    _G.Net.NewConnect(ip, port)

    if _G.AppSetting.DEBUG then
        _G.Log("连接服务器>>>ip>>>" .. ip .. ">>>port>>>" .. port)
    end
end

---添加所有后端主动推的网络消息监听接口
function LoginNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.account.Cmd, self.P2C_Call_account)
    self:AddMessageListener(_G.ConfigManager.net_map.system_fcm.Cmd, self.P2C_Call_fcm)
end

---后端主动推送的聊天数据
---@param data chat.p2c_chat PB数据
function LoginNet:P2C_Call_account(data)
    if not _G.IsNil(data.type) then
        --如果loading的过程出现弹窗会导致弹窗被遮挡，所以需要关闭loading
        local loadingView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LoadingView.Name)
        if loadingView then
           loadingView:Close()
        end
        if data.type == 1 then
            ---被挤号
            _G.GameNetTipsManager:GetInstance():AddListener(false)
            _G.GameNetTipsManager:GetInstance():OnUserLoginOut()
            _G.PopWindowManager:GetInstance():ShowAllTips(
                180301,
                nil,
                function()
                    _G.GameMain:ResetGame()
                end,
                nil,
                nil,
                true
            )
        elseif data.type == 2 then
            --- 被托管
            _G.GameNetTipsManager:GetInstance():AddListener(false)
            _G.GameNetTipsManager:GetInstance():OnUserLoginOut()
            _G.PopWindowManager:GetInstance():ShowAllTips(
                180305,
                nil,
                function()
                    _G.GameMain:ResetGame()
                end,
                nil,
                nil,
                true
            )
        elseif data.type == 3 then
            ---全服踢人
            _G.GameNetTipsManager:GetInstance():AddListener(false)
            _G.GameNetTipsManager:GetInstance():OnUserLoginOut()
            _G.PopWindowManager:GetInstance():ShowAllTips(
                180103,
                nil,
                function()
                    _G.GameMain:ResetGame()
                end,
                nil,
                nil,
                true
            )
        elseif data.type == 4 then
            ---踢人
            _G.GameNetTipsManager:GetInstance():AddListener(false)
            _G.GameNetTipsManager:GetInstance():OnUserLoginOut()
            _G.PopWindowManager:GetInstance():ShowAllTips(
                180104,
                nil,
                function()
                    _G.GameMain:ResetGame()
                end,
                nil,
                nil,
                true
            )
        elseif data.type == 5 then
            ---热更
            _G.PopWindowManager:GetInstance():ShowAllTips(
                680101,
                nil,
                function()
                    _G.GameUtil.DoQuit()
                end,
                nil,
                nil,
                true
            )
        end
    end
end

---后端主动推送的防沉迷数据
---@param data chat.p2c_chat PB数据
function LoginNet:P2C_Call_fcm(data)
    if not _G.IsNil(data.ack) then
        -- https://notice.youkia.net/v2/online/3.txt
        if data.ack ~= "ok" then
            local content = data.ack
            _G.PopWindowManager:GetInstance():ShowAllTips(
                290302,
                content,
                function()
                    _G.SDKManager:GetInstance():SendExit()
                end
            )
        end
    end
end

---登录请求
---@param callback function 登录完成回调
---@param isReConnect number 是否重连：0否，1是
function LoginNet:Login(callback, isReConnect)
    isReConnect = isReConnect or 0

    local curServer = _G.ServerManager:GetInstance().CurServer
    local hotVersion = _G.CS.Main.Inst:GetHotVersion()
    local fullVersion = _G.CS.Main.Inst:GetFullVersion()

    if _G.AppSetting.DEBUG then
        _G.Log("热更版本号>>>>>" .. hotVersion)
        _G.Log("游戏版本号>>>>>" .. fullVersion)
    end

    ---@type login.c2s_login msg
    local msg = {}
    msg.login_type = isReConnect
    msg.lan_type = 1
    --msg.guest = 0
    msg.client_version = hotVersion
    msg.app_version = fullVersion

    if _G.CS.Launcher.Inst.IsSDK and not _G.AppSetting.IsTuoGuan then
        --msg.age_stage = _G.PlayerModel:GetInstance().SDK_AgeState
        msg.url = curServer.AccountName
        msg.device_id = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID)
    else
        msg.userid = curServer.AccountName
        -- msg.server_name = curServer.ServerName
        --服务器显示名字，查看其他玩家信息界面里有使用
        --msg.server_name_show = curServer.ServerName
        msg.server_id = curServer.ServerID
        msg.platform_id = 1001
        msg.device_id = "0"
    end
    local port
    if _G.AppSetting.IsTuoGuan then
        local _, _, ServerID, Tuid = _G.LoginManager:GetInstance():GetTrustIpPort()

        if _G.AppSetting.DEBUG then
            _G.Log(ServerID, "输入拖管服务器id为>>>>>>>>>>>>>>>>>>")
        end
        if nil ~= ServerID then
            msg.server_id = ServerID
        end

        if _G.AppSetting.DEBUG then
            _G.Log(msg, "拖管登录信息如下>>>>>>>>>>>>>>>")
        end
        --- 托管登录
        port = require("BaseGameNet"):Access(_G.ConfigManager.net_map.game_trust, msg, _G.handler(self, self.LoginCall))
    else
        port = require("BaseGameNet"):Access(_G.ConfigManager.net_map.game_login, msg, _G.handler(self, self.LoginCall))
    end
    self.Call[port] = callback
end

---登录请求回调
---@param port number 中文描述
---@param data login.ReplyLogin 返回PB数据
---@param error string 错误信息
function LoginNet:LoginCall(port, data, error)
    if error then
        return
    end

    _G.LoginManager:GetInstance().IsLoginSucceed = true

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

