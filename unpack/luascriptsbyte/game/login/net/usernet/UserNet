local base = require("BaseGameNet")
---@class UserNet : BaseGameNet	中文描述
---@field functionManager FunctionManager
local UserNet = _G.BaseClass("UserNet", base)

-- 单例类有获取实例的方法GetInstance()
---@return UserNet UserNet
function UserNet:GetInstance()
    return base.GetInstance(self)
end

--注册监听后台推送消息
function UserNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.game_function_gm_close_function.Cmd, self.OnFunctionClose)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function UserNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function UserNet:Callback(port, data, error)
    if error then
        return
    end
    if data.server_time then
        --同步服务器时间
        --服务器下发的时间单位是S  本地解析是按照MS解析的 所以*1000
        _G.CS.YoukiaCore.TimeKit.ModifyTime(data.server_time * 1000)
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---创建角色请求
---@param pbData table PB数据
---@param callback function 完成回调
function UserNet:CreateRole(pbData, callback)
    if _G.AppSetting.DEBUG then
        _G.Log("发送创建角色>>>>>>>>>>>>>>>>>>")
    end
    self:Access(_G.ConfigManager.net_map.game_create_role, pbData, callback)
end

---获取用户信息请求
---@param callback function 完成回调
function UserNet:GetUserInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_role_get_user, self:GetEmptyPB(), callback)
end

---更换名字
---@param pbData table PB数据
---@param callback function 完成回调
function UserNet:UpdateName(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_role_update_name, pbData, callback)
end

---更换头像
---@param pbData table PB数据
---@param callback function 完成回调
function UserNet:UpdateStyle(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_role_update_style, pbData, callback)
end

---获取功能开放ID组
---@param callback function 完成回调
function UserNet:GetOpenFunction(callback)
    self:Access(_G.ConfigManager.net_map.game_function_open_info, self:GetEmptyPB(), callback)
end

---设置FucntionManager实例
---@param instance FunctionManager
function UserNet:SetFunctionManagerInstance(instance)
    self.functionManager = instance
end

---服务器主动推送关闭的功能列表(同步最新的列表状态)
---@param msg role.p2c_close_function
function UserNet:OnFunctionClose(msg)
    if not self.functionManager then
        return
    end
    self.functionManager:UpdateFunctionForbidden(msg.close_id)
end

---@type UserNet
return UserNet
