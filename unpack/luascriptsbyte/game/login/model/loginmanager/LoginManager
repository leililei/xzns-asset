function LoginManager:CoProgressGetInfo()
    local loading_window = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    -- 等待loading 加载完成
    while (_G.IsNil(loading_window.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
    self.loadingView = loading_window.View
    local RedPointManager = require "RedPointManager"
    RedPointManager:GetInstance():InitNodeTree()
    self:InitGameData(_G.handler(self, self.OnGameDataInitDone))
end

function LoginManager:OnGameDataInitDone()
    for i = 1, #self.dataModel do
        for j = 1, #self.dataModel[i] do
            self.dataModel[i][j]:OnInitFunction()
        end
    end
    _G.FunctionManager:GetInstance():InitOpenFunid()
    local RedPointManager = require "RedPointManager"
    RedPointManager:GetInstance():InitAllNodeData()
    self:OnComplete()
    self:OnSixClockUpdate()
end

function LoginManager:OnSixClockUpdate()
    local time = _G.TimeUtil.GetSixClockTimer()
    if time == 0 then
        time = 86400
    end
    if self.onSixTimeTimer then
        self.onSixTimeTimer:Stop()
        self.onSixTimeTimer = nil
    end
    self.onSixTimeTimer = _G.TimerManager:GetInstance():GetTimer(time, self.UpdateModels, self, true, false, true)
    self.onSixTimeTimer:Start()
end

function LoginManager:UpdateModels()
    self.curSixLevelIndex = 1
    self.curDataCount = #self.updateSixClockModels[self.curSixLevelIndex]
    self.SixPassCount = self.curDataCount
    for i = 1, self.curDataCount do
        self.updateSixClockModels[self.curSixLevelIndex][i]:OnSixClockUpdate(
            _G.handler(self, self.OnSixClockUpdateCall)
        )
    end
end

function LoginManager:OnSixClockUpdateCall()
    self.SixPassCount = self.SixPassCount - 1
    if self.SixPassCount <= 0 then
        self.curSixLevelIndex = self.curSixLevelIndex + 1
        if self.curSixLevelIndex > #self.updateSixClockModels then
            for i = 1, #self.updateSixClockModels do
                for j = 1, #self.updateSixClockModels[i] do
                    self.updateSixClockModels[i][j]:OnInitFunction(true)
                end
            end
            _G.Events:GetInstance():Broadcast(_G.eSixUpdate.SixClockUpdate)
            self:OnSixClockUpdate()
        else
            self.curDataCount = #self.updateSixClockModels[self.curSixLevelIndex]
            self.SixPassCount = self.curDataCount
            for i = 1, self.curDataCount do
                self.updateSixClockModels[self.curSixLevelIndex][i]:OnSixClockUpdate(
                    _G.handler(self, self.OnSixClockUpdateCall)
                )
            end
        end
    end
end

