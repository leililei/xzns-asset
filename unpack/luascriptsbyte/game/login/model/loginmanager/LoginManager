function LoginManager:LoginServer(inputName)
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.LoginServer)
    if _G.AppSetting.DEBUG then
        _G.SetConstClassLog(false)
    end
    -- 登录
    if _G.CS.Launcher.Inst.IsSDK and not _G.AppSetting.IsTuoGuan then
        if not _G.LoginManager:GetInstance().isSDKLoginSuccess then
            _G.SDKManager:GetInstance():SendLoginEx()
            _G.ServerManager:GetInstance().canClick = true
            return
        end

        if _G.AppSetting.DEBUG then
            _G.Log(_G.ServerManager:GetInstance().CurServer.Sid, "登录sdk游戏服务器id>>>>>>>>>")
        end
        _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.LoginSdkServer)
        _G.SDKManager:GetInstance():SendLoginServer(tostring(_G.ServerManager:GetInstance().CurServer.Sid))
    else
        _G.ServerManager:GetInstance():InitLocalServerInfo(inputName)
        _G.LoginManager:GetInstance():ConnectServer(false)
    end
end

function LoginManager:DoLoginGameServer(inputName)
    if _G.CS.Launcher.Inst.IsSDK and not _G.AppSetting.IsTuoGuan then
        -- 查询是否未成年
        _G.SDKManager:GetInstance():SendIsMinor()
    else
        _G.LoginManager:GetInstance():LoginServer(inputName)
    end
end

---重新热更
function LoginManager:ReLoadHot()
    _G.GameNetTipsManager:GetInstance():AddListener(false)
    _G.GameNetTipsManager:GetInstance():OnUserLoginOut()
    _G.PopWindowManager:GetInstance():ShowAllTips(
        680101,
        nil,
        function()
            _G.GameMain:ResetGame()
            _G.UIManager:GetInstance():CloseAllWindows()
            _G.CS.Main.Inst:LoginOut()
            _G.DestroyObject(_G.CS.Main.Inst.gameObject)
            _G.CS.Main.Inst = nil
            local win = _G.InstantiateObject(_G.CS.UnityEngine.Resources.Load("Launcher/Loading"))
            win:SetParentE(_G.CS.Launcher.Inst)
            win:SetName("LauncherLoading")
            local llCanvas = win:FindE("Canvas"):GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.CanvasScaler))
            llCanvas.matchWidthOrHeight = _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight
            win:AddComponentE(_G.typeof(_G.CS.LauncherLoading))
        end
    )
end

---获取挂接生产用户id
function LoginManager:GetUserId()
    return self.userId or -1
end

---获取创建角色key
function LoginManager:GetCreatePlayerKey()
    if self:GetUserId() == -1 then
        local accountName = _G.ServerManager:GetInstance():GetLastServer().AccountName
        if accountName then
            return "CreatePlayerNew" .. accountName
        else
            return "9999999"
        end
    else
        return "CreatePlayerNew" .. self:GetUserId()
    end
end

function LoginManager:GetRandRecommend(Namecount)
    _G.math.randomseed(self:getHash(_G.tostring(os.time()):reverse():sub(1, 7) .. os.clock()))
    return _G.math.random(1, Namecount)
end

function LoginManager:GetRandomName()
    if self.issetseed == nil then
        self.issetseed = true
        local useid = self:GetUserId()
        _G.math.randomseed(self:getHash(_G.tostring(os.time()):reverse():sub(1, 7) .. useid))
    end
    --这里默认165个姓
    local Namecount = 165
    local name_cfg = _G.ConfigManager.random_name_cfg
    local lastname = name_cfg[_G.math.random(1, Namecount)].last_name
    local firstname = name_cfg[_G.math.random(1, #name_cfg)].first_name
    return lastname .. firstname
end

function LoginManager:getHash(str)
    local hash = 5381
    for i = 1, #str do
        hash = ((hash * 33) + string.byte(str, i)) % 2 ^ 32
    end
    return hash
end
