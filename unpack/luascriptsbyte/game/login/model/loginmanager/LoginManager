---注销确认
function LoginManager:auth_logout()
    LoginManager:GetInstance().isSDKLoginSuccess = false

    if _G.CS.Launcher.Inst.IsSDK then
        _G.GameMain:ResetGame()
        ---登录界面注销需要拉起登录
        if self.IsInLoginOut then
            _G.SDKManager:GetInstance():SendLoginEx()
            self.IsInLoginOut = false
        end
    end
end

---用户登录成功
function LoginManager:login_success()
    if  _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.mailactivity) then
        _G.SDKManager:GetInstance():RequestZDConfig(
            function(bol, data)
               --[[ if bol and data and data.ifZd and _G.tonumber(data.ifZd) == 1 then
                    _G.CS.Launcher.Inst:CloseLoading()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ZDTipView.Name, data)
                    return
                end]]

                _G.PlayerModel:GetInstance().ZdConfig=data
                _G.LoginManager:GetInstance().isSDKLoginSuccess = true
                ---获取appinfo
                self:get_app_info()
            end
        )
    else
        _G.LoginManager:GetInstance().isSDKLoginSuccess = true
        ---获取appinfo
        self:get_app_info()
    end
end

---用户登录失败
function LoginManager:login_failed(args)
    _G.LoginManager:GetInstance().isSDKLoginSuccess = false
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LoginView.Name)
    if view then
        view:openAutoBtn()
    end
    --这里判断是否是海外用的是语言判断，那么这种方式需要避免玩家切换语言
    if not _G.GameUtil.GetIsUseChinese() then
        _G.SDKManager:GetInstance():SendLoginEx()
    end
end

---获取设备评分成功
---@param self LoginView LoginView
function LoginManager:get_phone_info(jsonData)
    if jsonData then
        if _G.AppSetting.DEBUG then
            _G.Log(jsonData, "<color=red>" .. "get_phone_info" .. "</color>")
        end
        local status = _G.tonumber(jsonData["status"])
        if status == 1 then
            self.DeviceScore = _G.tonumber(jsonData["deviceScore"])
        else
            self.DeviceScore = -1
        end
        local qualityManager = require("QualityManager")
        qualityManager:GetInstance():SdkSetQuality(self.DeviceScore)
        ---初始化画面设置
        _G.SystemSettingManager:GetInstance():InitImageOtherSet()
    end
    _G.SDKManager:GetInstance():GetServerList()
end

function LoginManager:get_app_info(args)
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.GetPhoneInfo)
    local qualityManager = require("QualityManager")
    qualityManager:GetInstance():SdkSetQuality(-1)
    ---初始化画面设置
    _G.SystemSettingManager:GetInstance():InitImageOtherSet()
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.GetPhoneInfoOk)
    _G.SDKManager:GetInstance():GetServerList()
    -- --获取设备评分
    --_G.SDKManager:GetInstance():SendPhoneInfo()
end

