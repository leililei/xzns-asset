function LoginManager:UpdateProgress(_name)
    --断线重连的话，就是会重新发送，这里就不在继续走了
    if self.isReconnect then
        return
    end
    self.PassCount = self.PassCount + 1
    self.Progress = self.PassCount / self.dataCount
    if self.progressCallback then
        self.progressCallback(self.Progress)
    end
    self.curDataCount = self.curDataCount - 1
    if _G.AppSetting.DEBUG then
        _G.Log(_name, "回调完成的model")
        self.names[_name] = nil
        _G.Log(self.curDataCount, "当前剩余的量")
        _G.Log(self.names, "当前量名字")
    end
    if self.curDataCount <= 0 then
        self:NextLevelDataInit()
    end
    -- loadingView界面进度表现
    if self.loadingView then
        self.loadingView:SetProgress(self.Progress)
    end
end

function LoginManager:InitGameData(callback)
    self.curLevelIdex = 0
    self.PassCount = 0
    self.onInitGameDataDone = callback
    ---NextLevelDataInit用  判定是否是重连 调用GameDataModelBase重连ReConnect函数
    self.isReconnect = false
    self.names = {}
    self:NextLevelDataInit()
end

---更新下一组的初始化
---@param isReConnectData bool  断线重连
function LoginManager:NextLevelDataInit()
    --断线重连的话，就是会重新发送，这里就不在继续走了
    if self.isReconnect then
        return
    end
    self.curLevelIdex = self.curLevelIdex + 1
    if _G.AppSetting.DEBUG then
        _G.Log(self.curLevelIdex, "当前索引")
        _G.Log(#self.dataModel, "总长度")
    end

    if self.curLevelIdex > #self.dataModel then
        if self.onInitGameDataDone then
            self.onInitGameDataDone()
        end
        self.onInitGameDataDone = nil
    else
        self.curDataCount = #self.dataModel[self.curLevelIdex]
        for i = 1, self.curDataCount do
            if _G.AppSetting.DEBUG then
                local name       = self.dataModel[self.curLevelIdex][i].__cname
                self.names[name] = true
                self.dataModel[self.curLevelIdex][i]:InitData(_G.handlerbind(self, self.UpdateProgress, name))
            else
                self.dataModel[self.curLevelIdex][i]:InitData(_G.handler(self, self.UpdateProgress))
            end
        end
    end
end

-----断线重连触发model发送
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function LoginManager:ReConnectInitGameData(callback)
    self.ReConnectcurLevelIdex = 0
    self.ReConnectPassCount = 0
    self.ReConnectonInitGameDataDone = callback
    self.isReconnect = true
    self.eConnectcurDataCount = 0
    self:ReConnectNextLevelDataInit()
end

-----循环发送断线重连的reconnect方法
function LoginManager:ReConnectNextLevelDataInit()
    --断线重连的时候发送没有发送消息的时候不执行，应该抛弃
    if self.isReconnect and _G.GameNetTipsManager:GetInstance().isResendMessage then
        return
    end

    self.ReConnectcurLevelIdex = self.ReConnectcurLevelIdex + 1
    if _G.AppSetting.DEBUG then
        _G.Log(self.ReConnectcurLevelIdex, "当前索引")
        _G.Log(#self.dataModel, "总长度")
    end

    if self.ReConnectcurLevelIdex > #self.dataModel then
        if self.ReConnectonInitGameDataDone then
            self.ReConnectonInitGameDataDone()
        end
        self.ReConnectonInitGameDataDone = nil
    else
        self.eConnectcurDataCount = #self.dataModel[self.ReConnectcurLevelIdex]
        for i = 1, self.eConnectcurDataCount do
            ---断线重连时, 应先检查FunctionOpen是否开发
            ---@type GameDataModelBase
            local model = self.dataModel[self.ReConnectcurLevelIdex][i]
            if model:GetFunctionOpen() then
                if _G.AppSetting.DEBUG then
                    local name = model.__cname
                    model:ReConnect(_G.handlerbind(self, self.ReConnectUpdateProgress, name))
                else
                    model:ReConnect(_G.handler(self, self.ReConnectUpdateProgress))
                end
            else
                self:ReConnectUpdateProgress(model.__cname)
            end
        end
    end
end

------刷新重新触发断线的发送
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function LoginManager:ReConnectUpdateProgress(_name)
    --断线重连的时候发送没有发送消息的时候不执行，应该抛弃
    if self.isReconnect and _G.GameNetTipsManager:GetInstance().isResendMessage then
        return
    end
    self.eConnectcurDataCount = self.eConnectcurDataCount - 1
    if _G.AppSetting.DEBUG then
        _G.Log(_name, "回调完成的model")
        _G.Log(self.eConnectcurDataCount, "当前剩余的量")
    end
    if self.eConnectcurDataCount <= 0 then
        self:ReConnectNextLevelDataInit()
    end
end

