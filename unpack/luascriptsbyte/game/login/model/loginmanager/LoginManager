---销毁对象时,析构函数
function LoginManager:Dispose()
    self.ConstKey = nil
    self.Running = nil
    self.isSDKLoginSuccess = nil
    self.IsLoginSucceed = nil
    self.LoginState = nil
    self.isReLogin = nil
    self.Progress = nil
    self.PassCount = nil
    self.curDataCount = nil
    self.isReconnect = nil
    self.dataModel = nil
    self.curLevelIdex = nil
    self.dataCount = nil
    self.updateSixClockModels = nil
    self.isLoginServerOK = nil
    self:RemoveEvent()
    _G.Events:RemoveListener(_G.eYKNetEvent.ConnectSuccessComplete, self.ConnectSucceed, self)
end

-- region -------------登录服务器-------------

---public：连接服务器
---@param isReLogin boolean 是否重登流程
function LoginManager:ConnectServer(isReLogin)
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.StartLoginServer)
    self.LoginState = 0
    self.isReLogin = isReLogin

    local IP, Port, ServerID, TUid
    if _G.AppSetting.IsTuoGuan then
        IP, Port, ServerID, TUid = self:GetTrustIpPort()
        if IP == nil or Port == nil then
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, " 托管登录的 IP, Port 不能为空")
            return
        end
        _G.LoginManager:GetInstance():TrustServerSave(IP, Port, ServerID, TUid)
    else
        local curServer = _G.ServerManager:GetInstance().CurServer
        IP = curServer.IP
        Port = curServer.Port
    end
    _G.Events:GetInstance():AddListener(_G.eYKNetEvent.ConnectSuccessComplete, self.ConnectSucceed, self)
    _G.GameNetTipsManager:GetInstance().isFirstLogin = true
    _G.CS.BattleManager.GameNetTipsResumeBattle()
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.StartNetConnect)
    _G.SDKManager:GetInstance():MiniGameTrack(SDKDef.DotMsg.ShuShu.login_server)
    LoginNet:GetInstance():ConnectServer(IP, Port)
end

---private：连接服务器成功，登录
function LoginManager:ConnectSucceed()
    _G.Events:GetInstance():RemoveListener(_G.eYKNetEvent.ConnectSuccessComplete, self.ConnectSucceed, self)

    if _G.AppSetting.DEBUG then
        _G.Log("LoginManager 收到 连接服务器成功 事件  " .. "      时间为     " .. _G.Time.realtimeSinceStartup)
    end
    self.LoginState = 1
    -- 给非SDK模式模拟一个SDK登陆成功的标记
    self.isSDKLoginSuccess = true
    _G.ServerManager:GetInstance():SaveLastServer()
    self:Login()
    _G.GameNetTipsManager:GetInstance().isFirstLogin = false
end

---登录
---@param isReConnect boolean 是否重登
function LoginManager:Login()
    self.isReLogin = self.isLoginServerOK
    _G.SDKManager:GetInstance():GameStepInfo(-60400)
    LoginNet:GetInstance():Login(_G.handler(self, self.LoginSucceed), self.isReLogin and 1 or 0)
end

---private：登录协议数据处理
---@param message login.s2c_login 登录返回数据
function LoginManager:LoginSucceed(message)
    local isOK = false
    if message.ack == 135 then
        -- 登录成功
        isOK = true
        _G.Events:GetInstance():Broadcast(_G.eLoginEvent.LoginSucceed, message)
        if not self.isReLogin then
            require "SDKDotManager":GetInstance():SDKDot_Login()
        end
    elseif message.ack == 59 then
        -- 登录成功，但是没有角色
        isOK = true
        _G.SDKManager:GetInstance():GameStepInfo(-60401)
        _G.Net.IsReceiveLogin(true)
        if not self.isLoginServerOK then
            require("GuideModel"):GetInstance():InitData(
                function()
                    _G.Events:GetInstance():Broadcast(_G.eLoginEvent.NewPlayer)
                    --_G.DownloadPlayManager:GetInstance():BeginDownloadAll()
                    -- _G.AudioManager.PlayAudioByAudioCfgID(1003)
                end
            )
            self.isLoginServerOK = true
        else
            _G.GameNetTipsManager:GetInstance():OnLoginSuccess()
            _G.AudioManager.PlayAudioByAudioCfgID(1003)
        end

        if not self.isReLogin then
            require "SDKDotManager":GetInstance():SDKDot_Login()
        end
        return
    elseif message.ack == 136 then
        -- 登录成功，顶号登录
        isOK = true
        _G.Events:GetInstance():Broadcast(_G.eLoginEvent.LoginSucceed, message)

        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]登录成功，顶号登录", "<color=red>" .. ">>>" .. "</color>")
        end
        if not self.isReLogin then
            require "SDKDotManager":GetInstance():SDKDot_Login()
        end
    elseif message.ack == 61 then
        -- 登录失败，服务器最大在线人数限制
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]登录失败，服务器最大在线人数限制", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        if self.isLoginServerOK then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1004,
                nil,
                function()
                    _G.DelayFrameDo(
                        function()
                            _G.GameMain:ResetGame()
                        end
                    )
                end
            )
        end
        return
    elseif message.ack == 62 then
        -- 登录失败，签名没有通过
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]登录失败，签名没有通过", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 63 then
        -- 登录失败，账号被禁用
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]登录失败，账号被禁用", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 137 then
        -- 服务器忙（人太多，实际上进入了登录排队队列），请稍后再试
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]-服务器忙（人太多，实际上进入了登录排队队列），请稍后再试", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.ServerManager:GetInstance().canClick = true
        if self.isLoginServerOK then
            _G.GameNetTipsManager:GetInstance():DelayFrameDoReLogin()
        end
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 141 then
        -- 限制登录
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]-服务器限制登录", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 142 then
        -- 热更版本号验证异常
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]-服务器验证热更版本号异常", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(
            680102,
            nil,
            function()
                _G.Log("热更版本号验证异常强制退出游戏")
                _G.GameUtil.DoQuit()
            end
        )
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 143 then
        -- 游戏版本号限制
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]-服务器验证版本号限制", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(
            159,
            nil,
            function()
                _G.Log("游戏版本号限制强制退出游戏")
                _G.GameUtil.DoQuit()
            end
        )
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 140 then
        ---防沉迷
        _G.PopWindowManager:GetInstance():ShowAllTips(290302)
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 211 then
        ---是否允许创建角色
        --镇魂街ZHJ-27030 【9月后必须出包】【主任务】9月后必须出包任务ZHJ-27725
        --【客户端】登录-新增是否允许创建角色提示【9月后必须出包任务】
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginManager]-不允许创建角色", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(34)
        _G.ServerManager:GetInstance().canClick = true
        if self.isLoginServerOK then
            _G.Net.CloseAllConnects()
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1003,
                nil,
                function()
                    _G.DelayFrameDo(
                        function()
                            _G.GameMain:ResetGame()
                        end
                    )
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        end
        return
    elseif message.ack == 69 then
        -- 账号涉嫌违规，若有疑问请联系客服
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]-账号涉嫌违规，若有疑问请联系客服", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(290302, message.tips)
        _G.ServerManager:GetInstance().canClick = true
        _G.Net.CloseAllConnects()
        return
    elseif message.ack == 65 then
        -- 服务器注册已满
        if _G.AppSetting.DEBUG then
            _G.Log("[LoginView]-服务器注册已满", "<color=red>" .. ">>>" .. "</color>")
        end
        _G.Net.CloseAllConnects()
        _G.ServerManager:GetInstance().canClick = true
        if self.isLoginServerOK then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1003,
                nil,
                function()
                    _G.DelayFrameDo(
                        function()
                            _G.GameMain:ResetGame()
                        end
                    )
                end
            )
        end
        return
    else
        if self.isLoginServerOK then
            _G.GameNetTipsManager:GetInstance():DelayFrameDoReLogin()
        end
        _G.ServerManager:GetInstance().canClick = true
        return
    end

    if not isOK then
        --登录失败广播
        _G.Events:GetInstance():Broadcast(_G.eLoginEvent.LoginFailure, message)
        _G.SDKManager:GetInstance():GameStepInfo(-60402)
    else
        _G.SDKManager:GetInstance():GameStepInfo(-60401)
    end

    self.LoginState = 2
    _G.Net.IsReceiveLogin(true)
