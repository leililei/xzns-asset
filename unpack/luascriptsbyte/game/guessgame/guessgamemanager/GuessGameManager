---检测下注红点
function GuessGameManager:CheckRedPointBet()
    local curSessionIndex = self:GetCurFactSessionIndex()
    local info = self:GetSessionData(curSessionIndex)
    if info.bet and info.bet > 0 then
        return 0
    end
    local t = _G.TimeUtil.GetServerUnixTime()
    if t > info.time_start and t < info.time_end - self:GetSettlementSecond() then --在竞猜时间范围内
        return 1
    end
    return 0
end
---检测奖励红点
function GuessGameManager:CheckRedPointAward()
    local info = self:GetAllSessionInfo()
    for i = 1, #info do
        local session = info[i]
        if session.award == 0 and session.bet > 0 and session.win > 0 then
            return 1
        end
    end
    return 0
end
---检测任务状态红点
function GuessGameManager:CheckRedPointMission()
    for _, v in pairs(self.missionList[1]) do
        if self:CheckCanTake(v, 1) then
            return 1
        end
    end
    for _, v in pairs(self.missionList[2]) do
        if self:CheckCanTake(v, 2) then
            return 1
        end
    end
    return 0
end

function GuessGameManager:UpdateExtraRedPoint(id, num)
    if id == self.storeRedPoint then
        self.storePoint = num
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(4))
    elseif id == self.exchangeRedPoint then
        self.exchangePoint = num
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(4))
    end
end

function GuessGameManager:CheckStoreAndExchange()
    if self.storePoint == 1 then
        return 1
    elseif self.exchangePoint == 1 then
        return 1
    else
        return 0
    end
end

