function GuessGameManager:ParseData(data, reconnect)
    data = data.guess
    self.curActivityState = true
    self:HandleCfg()
    self:HandleInfoData(data)
    base.ParseData(self)
    if self.OnSixUpdateTag then
        if self.onSixUpdateCall then
            for key, call in pairs(self.onSixUpdateCall) do
                call()
            end
        end
    end
    if reconnect then
        if self.onResultSendCall then
            for key, call in pairs(self.onResultSendCall) do
                call()
            end
        end
    end
end
---初始化功能逻辑
function GuessGameManager:InitFunction()
    ---啥也没改，写行注释装装样子
    if not self.curActivityState then
        return
    end
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlement then
        self.isSettlement = true
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
    --TODO:初始化当前场次以及状态
    local t = _G.TimeUtil.GetServerUnixTime()
    local dayTime = _G.TimeUtil.GetSecondsOfDay()
    if dayTime > opentime then
        if not self.isSettlement then
            self:StopZeroFresh()
            local times = _G.TimeUtil.GetClockTimer(24)
            times  = times >= 86400 and times - 86400 or times
            self.zeroFreshTimer = _G.TimerManager:GetInstance():GetTimer(
                times + 1,
                self.ZeroFresh,
                self,
                true)
            self.zeroFreshTimer:Start()
        end
    else
        if not self.isSettlement then
            self:StopOpenFresh()
            self.openFreshTimer =_G.TimerManager:GetInstance():GetTimer(
            opentime - dayTime + 1,
            self.OpenFresh,
            self,
            true)
            self.openFreshTimer:Start()
            self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        end
    end
    if t < self.sessionInfo[1].time_start then --第一场开始之前
        if not self.isSettlement then
            self:StopRedPointBetTimer()
            self.redpointBetTimer =
                _G.TimerManager:GetInstance():GetTimer(
                self.sessionInfo[1].time_start - t + 1,
                self.RefreshRedPointBet,
                self,
                true
            )
            self.redpointBetTimer:Start()
        end
        self.curOpenSessionIndex = 1
        self.curSessionState = sessionState.notOpen
        self.tipsTimer =
            _G.TimerManager:GetInstance():GetTimer(self.sessionInfo[1].time_start - t, self.HandleTips, self, true)
        self.tipsTimer:Start()
    else
        local len = #self.sessionInfo
        if t > self.sessionInfo[len].time_end then --最后一场结束后
            self.curOpenSessionIndex = len
            self.curSessionState = sessionState.over
        else
            for i = 1, len do
                if t > self.sessionInfo[i].time_start and t < self.sessionInfo[i].time_end then --场次时间范围内
                    self.curOpenSessionIndex = i
                    self:StopRedPointBetTimer()
                    if self.sessionInfo[i].time_end - t - self:GetSettlementSecond() > 0 then
                        self.redpointBetTimer =
                            _G.TimerManager:GetInstance():GetTimer(
                            self.sessionInfo[i].time_end - t - self:GetSettlementSecond(),
                            self.RefreshRedPointBet,
                            self,
                            true
                        )
                        self.redpointBetTimer:Start()
                    end
                    break
                end
            end
            t = t - self.sessionInfo[1].time_start
            while t > self.tipsTime do
                t = t - self.tipsTime
            end
            self.tipsTimer = _G.TimerManager:GetInstance():GetTimer(t, self.HandleTips, self, true)
            self.tipsTimer:Start()
        end
    end
end

