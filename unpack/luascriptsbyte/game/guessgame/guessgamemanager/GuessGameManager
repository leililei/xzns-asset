---@param data table 伤害数据
function GuessGameManager:UpdateData(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCount = _G.table.count(data.FighterInfo)
    self.PveData = self:InitReportData(data)
    _G.Events:GetInstance():AddListener(_G.eBattleState.RecordStart, self.ReplayCall, self)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        {self.sessionInfo[self.curMessageSessionIndex].win == 1 and 0 or 1},
        nil,
        function()
            _G.Events:GetInstance():RemoveListener(_G.eBattleState.RecordStart, self.ReplayCall, self)
        end,
        self.otherPlayer,
        1,
        true,
        self.fight_arg
    )
end

