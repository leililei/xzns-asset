---判断任务是否领取
function GuessGameManager:WasTaken(Sid, type)
    if not _G.table.isEmptyOrNil(self.finshedMissionList[type]) then
        for _, v in pairs(self.finshedMissionList[type].sid) do
            if Sid == v then
                return true
            end
        end
    end
    return false
end

---判断任务能否领取
function GuessGameManager:CheckCanTake(data, type)
    if not self:WasTaken(data.sid, type) then
        local progressType = missionState[data.condition[1].k]
        if self.progressList[type][progressType] >= data.condition[1].v then
            return true
        end
    end
    return false
end

function GuessGameManager:RefreshCoin(data)
    for _, v in pairs(data) do
        if v.type[1] == 104 then
            self.chip_own = self.chip_own + v.type[2]
            self:RefreshMission(missionState[2], v.type[2])
        end
    end
end

function GuessGameManager:RefreshMission(missionType, nums)
    self.progressList[1][missionType] = self.progressList[1][missionType] + nums
    self.progressList[2][missionType] = self.progressList[2][missionType] + nums
    self:RefreshRedPointMission()
    if self.call then
        self:SortTask(1)
        self:SortTask(2)
        self.call()
        self.call = nil
    end
end

function GuessGameManager:GetProgressData()
    return self.progressList
end

function GuessGameManager:GetMissionData()
    return self.missionList
end

function GuessGameManager:GetMissionAward(sid, type, call)
    local activity_id = self.curActivityClass:GetActivityID()
    local coinData = {}
    local coins = 0
    for k, v in pairs(self.missionList[type]) do
        for k1, v1 in pairs(sid) do
            if v.sid == v1 then
                coins = coins + v.coin
            end
        end
    end
    coinData = {[1] = 104,[2] = coins}
    GuessGameNet:GetInstance():GetMissionAward(activity_id,sid,
    function(msg)
        if msg.ack ~= 1 then
            return
        end
        if coins > 0 then
           table.insert(msg.award.item,{type = coinData})
        end
        _G.Events:GetInstance():Broadcast(_G.eArena.SetGuessCoin, coins)
         _G.StorageManager:GetInstance():ReceiveAwardData(msg)
         _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg,call)
     end)
    for _,v in pairs(sid) do
        table.insert(self.finshedMissionList[type].sid,v)
    end
    --self:RefreshRedPointMission()
    if call then
        self.call = call
    end
end

function GuessGameManager:SortTask(type)
    if not self.missionList then
        return
    end
    _G.SortList(
        self.missionList[type],
        function(v)
            local missionType
            local iscantake = self:CheckCanTake(v, type)
            local WasTaken = self:WasTaken(v.sid, type)
            if WasTaken then
                missionType = -1
            else
                if iscantake then
                    missionType = 1
                else
                    missionType = 0
                end
            end
            return missionType, -v.sid
        end
    )
end

