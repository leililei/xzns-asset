---每日活动开启刷新入口
function GuessGameManager:OpenFresh()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlement then
        self.isSettlement = true
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
    if not self.isSettlement then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Open)
        local time = _G.TimeUtil.GetClockTimer(24)
        self:StopZeroFresh()
        self.zeroFreshTimer = _G.TimerManager:GetInstance():GetTimer(
            time,
            self.ZeroFresh,
            self,
            true
            )
        self.zeroFreshTimer:Start()
    end
end

function GuessGameManager:StopZeroFresh()
    if self.zeroFreshTimer then
        self.zeroFreshTimer:Stop()
        self.zeroFreshTimer = nil
    end
end

function GuessGameManager:StopOpenFresh()
    if self.openFreshTimer then
        self.openFreshTimer:Stop()
        self.openFreshTimer = nil
    end
end

