--region 数据解析
--[[初始化竞猜信息
    required uint64 time_start=1;//竞猜开始时间
    required uint64 time_end=2;//竞猜开始时间
    required uint32 times=3;//竞猜序列号
    repeated uint32 array = 4;// 对战双方阵容sid,第一位进攻方
    required uint32 bet = 5;//本场下注情况 0，未下注，1，进攻方，2，防守方
    required uint32 win=6;//胜利方 0 未开始,1，进攻方，2，防守方
    required uint32 award=7;//是否领取宝箱 0 ,未领取，1，已领取
    repeated uint32 combine_1 = 8;//进攻方合击技
    repeated uint32 combine_2 = 9;//防守方合击技
    optional uint64 playback_uid=10;//战报详细项uid
]]
function GuessGameManager:HandleInfoData(msg)
    self.curAllAwardCount = msg.coin
    require("GuessGameModel"):GetInstance():SetCoin(self.curAllAwardCount)
    self.sessionInfo = msg.session_info
    self.missionData = msg.task
    self.missionProgress = msg.task_curr
    self.finshDatas = msg.task_finish
    _G.table.sort(
        self.sessionInfo,
        function(a, b)
            return a.times < b.times
        end
    )
    self.dailyTasks = {}
    self.challengeTasks = {}
    self.progressList = {}
    self.progressList[1] = {}
    self.progressList[2] = {}
    local insert = _G.table.insert
    if self.missionData ~= nil then
        for _, v in pairs(self.missionData) do
            local coin = {}
            coin.type = {[1] = 104, [2] = v.coin}
            insert(v.award, coin)
            if v.type == 1 then
                insert(self.dailyTasks, v)
            elseif v.type == 2 then
                insert(self.challengeTasks, v)
            end
        end
    end
    self.progressList[1].times = 0
    self.progressList[1].coin = 0
    self.progressList[1].barrage = 0
    self.progressList[1].winTimes = 0
    self.progressList[1].winningStreak = 0
    self.progressList[2].times = 0
    self.progressList[2].coin = 0
    self.progressList[2].barrage = 0
    self.progressList[2].winTimes = 0
    self.progressList[2].winningStreak = 0
    if self.missionProgress ~= nil then
        for _, v in pairs(self.missionProgress) do
            local type
            if v.con_type == 1 then
                type = "times"
            elseif v.con_type == 2 then
                type = "coin"
            elseif v.con_type == 3 then
                type = "barrage"
            elseif v.con_type == 4 then
                type = "winningStreak"
            elseif v.con_type == 5 then
                type = "winTimes"
            end
            if v.task_type == 1 then
                self.progressList[1][type] = self.progressList[1][type] + v.num
            elseif v.task_type == 2 then
                self.progressList[2][type] = self.progressList[2][type] + v.num
            end
        end
    end
    self.finshedMissionList = {}
    self.finshedMissionList[1] = {}
    self.finshedMissionList[1].sid = {}
    self.finshedMissionList[2] = {}
    self.finshedMissionList[2].sid = {}
    if not _G.table.isEmptyOrNil(self.finshDatas) then
        for _, v in pairs(self.finshDatas) do
            self.finshedMissionList[v.task_type].sid = v.sid
        end
    end
    self.missionList = {}
    insert(self.missionList, self.dailyTasks)
    insert(self.missionList, self.challengeTasks)
    self:SortTask(1)
    self:SortTask(2)
end
