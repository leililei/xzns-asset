--[[竞猜结果 推送
  required uint32 times=1;//竞猜序列号
  required uint32 win=2;//胜利方 1，进攻方，2，防守方
  required uint64 playback_uid=3;//战报详细项uid
  required uint64 id = 4;  //活动sid
  required uint32 win_times=5; //玩家连胜次数
   ]]
function GuessGameManager:HandleResultData(msg)
    if not self.sessionInfo then
        return
    end
    self.curSuccessGuessTimes = nil
    self.sessionInfo[msg.times].win = msg.win
    self.sessionInfo[msg.times].playback_uid = msg.playback_uid
    --TODO:数据更新 界面刷新
    if self.onResultSendCall then
        for key, call in pairs(self.onResultSendCall) do
            call(msg.times)
        end
    end
    if self.progressList[2].winTimes < msg.win_times then
        self:RefreshMission(missionState[4], 1)
    end
    if self.sessionInfo[msg.times].bet == msg.win then
        self:RefreshMission(missionState[5], 1)
    end
    --TODO:刷新红点 奖励+竞猜
    if msg.times < #self.sessionInfo then
        self.curOpenSessionIndex = msg.times + 1
        self:StopRedPointBetTimer()
        local time =
            self.sessionInfo[self.curOpenSessionIndex].time_end - _G.TimeUtil.GetServerUnixTime() -
            self:GetSettlementSecond()
        if time > 0 then
            self.redpointBetTimer = _G.TimerManager:GetInstance():GetTimer(time, self.RefreshRedPointBet, self, true)
            self.redpointBetTimer:Start()
        end
    end
    self:RefreshRedPointBet()
    self:RefreshRedPointAward()
end
--[[邮件补发奖励推送
  required uint64 id = 1; //活动sid
  repeated uint32 times=2;//竞猜序列号
]]
function GuessGameManager:HandleAwardData(msg)
    _G.Events:GetInstance():Broadcast(_G.eArena.SetGuessCoin, msg.add_coin)
end

---零点刷新
function GuessGameManager:ZeroFresh()
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Settlement then
        self.isSettlement = true
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
    if not self.isSettlement then
        if self.sessionInfo then
            for i = 1, #self.sessionInfo do
                self.sessionInfo[i].award = 1
            end
        end
        self:RefreshRedPointAward()
        --TODO:刷新界面
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        self:ZeroClose()
        self:StopOpenFresh()
        self.openFreshTimer =
        _G.TimerManager:GetInstance():GetTimer(
            opentime + 1,
            self.OpenFresh,
            self,
            true)
        self.openFreshTimer:Start()
        if self.onMailAwardCall then
            self.onMailAwardCall()
        end
    end
end

