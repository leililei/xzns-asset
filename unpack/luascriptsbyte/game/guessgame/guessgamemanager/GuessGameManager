---获取连续竞猜成功场次和额外的奖励
---@return number|number 场次|奖励数量
function GuessGameManager:GetContinuouslyWinTimes()
    if self.curSuccessGuessTimes then
        if self.curSuccessGuessTimes > 0 then --连续竞猜
            return self.curSuccessGuessTimes, self.winExtraAward[self.curSuccessGuessTimes][2]
        else
            return 0, 0
        end
    else
        self.curSuccessGuessTimes = 0
        for i = self.curOpenSessionIndex - 1, 1, -1 do
            local info = self.sessionInfo[i]
            if info.bet == 0 then --未竞猜
                break
            end
            if info.bet == info.win then
                self.curSuccessGuessTimes = self.curSuccessGuessTimes + 1
            else
                break
            end
        end
    end
    return self:GetContinuouslyWinTimes()
end
