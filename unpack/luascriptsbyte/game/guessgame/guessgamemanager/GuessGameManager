---获取弱势翻盘奖励
---@param per number 进攻方下注倍率
---@return number|number 显示状态 0无1红方2蓝方|奖励数量
function GuessGameManager:GetShowWeakWinAward(per)
    if per < self.weakAward[3] then --进攻方弱势
        return 1, self.weakAward[2] * _G.Mathf.Round((self.weakAward[3] - per) / self.weakAward[4])
    elseif 100 - per < self.weakAward[3] then --防守方弱势
        per = 100 - per
        return 2, self.weakAward[2] * _G.Mathf.Round((self.weakAward[3] - per) / self.weakAward[4])
    end
    return 0
end
---计算热度值
---@param num number 支持的人数
---@return number 热度值
function GuessGameManager:CalculateHotValue(num)
    if num <= 0 then
        return 0
    end
    local value = 0
    local sum = 0
    for i = 1, num do
        value = self.hotValue[1] + _G.Mathf.Floor(i / self.hotValue[2]) * self.hotValue[3]
        if value < 1 then
            value = 1
        end
        sum = sum + value
    end
    return sum
end
