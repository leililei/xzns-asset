local base = require("BaseGameNet")

---@class GuessGameNet : BaseGameNet	通信协议
local GuessGameNet = _G.BaseClass("GuessGameNet", base)
---@return GuessGameNet GuessGameNet
function GuessGameNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function GuessGameNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GuessGameNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---初始化数据
---@param callback function 回调
function GuessGameNet:Init(callback)
    self:Access(_G.ConfigManager.net_map.game_guess_info, self:GetEmptyPB(), callback)
end
---获取竞猜下注数据
---@param index number 场次序列号
---@param callback function 回调
function GuessGameNet:GetPercentage(index, callback, sid)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_percentage, {times = index, id = sid}, callback)
end
---下注
---@param index number 场次序列号
---@param bet number 下注方
---@param callback function 回调
function GuessGameNet:Bet(index, bet, callback, sid)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_bet, {times = index, bet = bet, id = sid}, callback)
end
---领奖
---@param id number 竞猜场次
---@param callback function 回调
function GuessGameNet:Award(index, callback, sid)
    self:Access(_G.ConfigManager.net_map.game_guess_award, {times = index, id = sid}, callback)
end
---下注公告信息
---@param callback function 回调
function GuessGameNet:BetInfo(callback, sid)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_bet_info, {id = sid}, callback)
end
---阵容详细数据
---@param index number 竞猜场次
---@param callback function 回调
function GuessGameNet:GetEmbattleData(index, callback, sid)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_array, {times = index, id = sid}, callback)
end
---回放战报
---@param id number 竞猜场次
---@param callback function 回调
function GuessGameNet:PlayReport(id, callback, sid)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_playback, {playback_uid = id, id = sid}, callback)
end
---排行榜
---@param callback function 回调
function GuessGameNet:Rank(callback, sid)
    self:Access(_G.ConfigManager.net_map.game_rank_guess, {page = 1, id = sid}, callback)
end
---个人排行榜数据
---@param callback function 回调
function GuessGameNet:SelfRank(callback, sid)
    self:Access(_G.ConfigManager.net_map.game_rank_get_rank_num, {type = sid}, callback)
end
---获取聊天弹幕信息
---@param id number 活动id
---@param callback function 回调
function GuessGameNet:GetChatData(id, callback)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_bullet_info, {id = id}, callback)
end
---发送聊天弹幕信息
---@param id number 活动id
---@param type number 类型 1聊天 2弹幕
---@param content string 内容
---@param callback function 回调
function GuessGameNet:SendChatData(id, type, content, isAuto,callback)
    self:Access(
        _G.ConfigManager.net_map.game_activity_module_port_bullet,
        {id = id, type = type, content = type == 1 and content or nil, sid = type == 2 and content or nil,auto = isAuto and 1 or 0},
        callback
    )
end

function GuessGameNet:GetMissionAward(id,sids,callback)
    local data = {}
    data.activity_id = id
    data.task_sids = sids
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_guess_finish, data, callback)
end

function GuessGameNet:GetBetAward(id,time,callback)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_guess_award,
    {activity_id = id,times = time}, callback)
end

return GuessGameNet
