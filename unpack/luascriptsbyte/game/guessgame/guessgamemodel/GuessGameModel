---@class GuessGameModel : Singleton	中文描述
local GuessGameModel = _G.BaseClass("GuessGameModel", _G.Singleton)
local CS = _G.CS
local typeof = _G.typeof

---@return GuessGameModel GuessGameModel
function GuessGameModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function GuessGameModel:__init()
    _G.Events:GetInstance():AddListener(_G.eArena.SetGuessCoin, self.AddCoin, self)
end

---销毁对象时,析构函数
function GuessGameModel:Dispose()
end

---设置活动
function GuessGameModel:SetActivity(activity)
    self.activity = activity
end
---设置coin
function GuessGameModel:SetCoin(coin)
    self.coin = coin
end
---增加代币
function GuessGameModel:AddCoin(num)
    self.coin = self.coin + num
    local tmp = {}
    _G.table.insert(tmp, 104)
    _G.table.insert(tmp, num)
    _G.table.insert(tmp, self.coin)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
end
---获取代币
function GuessGameModel:GetCoin()
    return self.coin or 0
end
---兑换id
function GuessGameModel:SetExchangeId(id)
    self.exchangeId = id
end
---获取兑换id
function GuessGameModel:GetExchangeId()
   return self.exchangeId or 0
end

return GuessGameModel