local format = _G.string.format
---@class GuessGameEmbattleView : UIBaseView	中文描述
---@field public go_table GuessGameEmbattleView_GoTable GoTable
local GuessGameEmbattleView = _G.BaseClass("GuessGameEmbattleView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function GuessGameEmbattleView:Awake()
    self.initViewDoneTag = true
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GuessGameEmbattleView:OnCreate(index, side, activity)
    self.activity = activity
    self.curSesstionIndex = index
    self.curBetSessionSide = side
    self.curBetTag = side > 0
    local num, award = self.activity:GetContinuouslyWinTimes()
    self.go_table.aortext_successNums.text = GetLangPackValue(90000010129, num)
    self.go_table.aortext_extraAward.text = GetLangPackValue(90000010130, award)
    self.activity:GetPercentage(self.curSesstionIndex, _G.handler(self, self.OnBetPerCall))
    num, award = self.activity:GetBetCost()
    if _G.StorageManager:GetInstance():CheckItem(award, num) then
        self.go_table.aortext_cost.text = GetLangPackValue(90020300101) .. ":" .. num
    else
        self.go_table.aortext_cost.text =
            GetLangPackValue(90020300101) .. ":" .. format("<color=#ff0000>%d</color>", num)
    end
    self:ShowBlueCombineSkill()
    self:OpenEmbattle()
    self.activity:SetOnSixUpdateCall(self.viewName, _G.handler(self, self.OnSixUpdateCall))
end

---界面的销毁函数
function GuessGameEmbattleView:OnDestroy()
    self.activity:SetOnSixUpdateCall(self.viewName, nil)
    self.activity = nil
    self.curBetTag = nil
    self.curBetSessionSide = nil
    self.curSesstionIndex = nil
end

---按钮点击事件在这里派发
function GuessGameEmbattleView:OnClickBtn(go)
    if self.initViewDoneTag then
        return
    end
    if go == self.go_table.aorbtn_Close then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnGuessGameViewOpened, self)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GuessGameView.Name,
            self.curSesstionIndex,
            self.activity
        )
    elseif go == self.go_table.aorbtn_sure then
        if not self.curBetSessionSide or self.curBetSessionSide == 0 then
            --TODO:提示没有选择队伍
            _G.PopWindowManager:GetInstance():ShowAllTips(630105)
            return
        end
        if self.curBetTag then
            --TODO:已竞猜的场次无法更改支持方
            _G.PopWindowManager:GetInstance():ShowAllTips(630107)
            return
        end
        local info = self.activity:GetSessionData(self.curSesstionIndex)
        if _G.TimeUtil.GetServerUnixTime() > info.time_end - self.activity:GetSettlementSecond() then
            _G.PopWindowManager:GetInstance():ShowAllTips(630104)
            self:OnClickBtn(self.go_table.aorbtn_Close)
            return
        end
        --TODO:下注
        self.activity:Bet(self.curSesstionIndex, self.curBetSessionSide, _G.handler(self, self.OnBetCall))
    elseif go == self.go_table.aorbtn_red then
        --TODO:选中红方
        self:SetGuessSide(1)
    elseif go == self.go_table.aorbtn_blue then
        --TODO:选中蓝方
        self:SetGuessSide(2)
    elseif go == self.go_table.aorbtn_detail then
        ---打开详情界面
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GuessBattleDetail.Name,
            {
                self.curCardData.attacker_team[1],
                self.curCardData.defender_team[1]
            },
            {
                self.curCardData.decoration_suit_att,
                self.curCardData.decoration_suit_def
            }
        )
    elseif go == self.go_table.aorbtn_skill1 then
        self:ShowSkillInfo(1)
    elseif go == self.go_table.aorbtn_skill2 then
        self:ShowSkillInfo(2)
    elseif go == self.go_table.aorbtn_skill3 then
        self:ShowSkillInfo(3)
    elseif go == self.go_table.aorbtn_skill4 then
        self:ShowSkillInfo(4)
    elseif go == self.go_table.aorbtn_skill5 then
        self:ShowSkillInfo(5)
    elseif go == self.go_table.aorbtn_skill6 then
        self:ShowSkillInfo(6)
    end
end
function GuessGameEmbattleView:ShowSkillInfo(index)
    local data = self.activity:GetSessionData(self.curSesstionIndex)
    --TODO:弹技能tips
    if index <= 3 then
        require "CommonTipManager":GetInstance():OpenSkillTip(data.combine_1[index])
    else
        require "CommonTipManager":GetInstance():OpenSkillTip(data.combine_2[index - 3])
    end
end
---下注倍率回调
---@param att number 进攻方下注人数
---@param def number 防守方下注人数
function GuessGameEmbattleView:OnBetPerCall(att, def)
    if att == 0 and def == 0 then
        self.go_table.aortext_numred.text = "0%"
        self.go_table.aortext_numblue.text = "0%"
        self.go_table.trans_tips:SetActiveE(0)
        _G.DelayFrameDo(
            function()
                self.go_table.obj_redNum:SetActiveE(0)
                self.go_table.obj_blueNum:SetActiveE(0)
                self.go_table.obj_redNum:SetActiveE(1)
                self.go_table.obj_blueNum:SetActiveE(1)
            end
        )
        return
    end
    def = att + def
    att = _G.Mathf.RoundToInt(att / def * 100)
    self.go_table.aortext_numred.text = string.format("%d%%", att)
    self.go_table.aortext_numblue.text = string.format("%d%%", 100 - att)
    local award, num = self.activity:GetShowWeakWinAward(att)
    if award == 0 then
        self.go_table.trans_tips:SetActiveE(0)
    else
        self.go_table.aortext_weakAward.text = format(_G.GetLangPackValue(90000010128), num)
        self.go_table.trans_tips:SetActiveE(1)
        local x, y
        if award == 1 then
            x, y = self.go_table.aorbtn_red:GetLocalPosition()
        else
            x, y = self.go_table.aorbtn_blue:GetLocalPosition()
        end
        self.go_table.trans_tips:SetLocalPosition(x, y, 0)
    end
    _G.DelayFrameDo(
        function()
            self.go_table.obj_redNum:SetActiveE(0)
            self.go_table.obj_blueNum:SetActiveE(0)
            self.go_table.obj_redNum:SetActiveE(1)
            self.go_table.obj_blueNum:SetActiveE(1)
        end
    )
end
function GuessGameEmbattleView:OnSixUpdateCall()
    if self.activity:GetCurState() then
        self:OnClickBtn(self.go_table.aorbtn_Close)
    else
        self:Close()
    end
end
function GuessGameEmbattleView:OnBetCall(success)
    if success then
        self.curBetTag = true
        _G.PopWindowManager:GetInstance():ShowAllTips(630103)
        self.activity:GetPercentage(self.curSesstionIndex, _G.handler(self, self.OnBetPerCall))
    end
end
function GuessGameEmbattleView:SetGuessSide(side)
    if self.curBetTag then
        --TOOD:已经下注过了
        _G.PopWindowManager:GetInstance():ShowAllTips(630107)
        return
    end
    self.curBetSessionSide = side
end
function GuessGameEmbattleView:OpenEmbattle()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    self.activity:GetSessionCardDetail(
        self.curSesstionIndex,
        function(data)
            self.curCardData = data
            require("EmbattleController"):GetInstance():OpenEmbattle(
                0,
                _G.EmbattleSaveType.server,
                true,
                _G.EmbattleControllerItemType.guessGame,
                nil,
                nil,
                _G.ConfigManager.discrete_cfg[105712][1][1],
                data
            )
        end
    )
end
function GuessGameEmbattleView:ShowBlueCombineSkill()
    local info = self.activity:GetSessionData(self.curSesstionIndex)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local language_package_cfg = _G.ConfigManager.language_package_cfg
    local battle_skill_cfg = _G.ConfigManager.battle_skill_cfg
    local cfg = card_skills_cfg[info.combine_2[1]]
    self.go_table.aorrawimage_icon1:LoadImage(cfg.icon)
    cfg = battle_skill_cfg[cfg.skills[1]]
    self.go_table.aortext_type1.text = language_package_cfg[cfg.Brief]
    cfg = card_skills_cfg[info.combine_2[2]]
    self.go_table.aorrawimage_icon2:LoadImage(cfg.icon)
    cfg = battle_skill_cfg[cfg.skills[1]]
    self.go_table.aortext_type2.text = language_package_cfg[cfg.Brief]
    cfg = card_skills_cfg[info.combine_2[3]]
    self.go_table.aorrawimage_icon3:LoadImage(cfg.icon)
    cfg = battle_skill_cfg[cfg.skills[1]]
    self.go_table.aortext_type3.text = language_package_cfg[cfg.Brief]
end
---监听界面打开
---@param name string 界面名称
function GuessGameEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
        )
        embattleView.transform:SetParentE(self.go_table.trans_view)
        embattleView:HideShackleBottom()
        embattleView:HideExitBtn()
        embattleView:ShowBottomBtn(false)
        embattleView:SetOpenAnimationDoneCall(
            function()
                self.initViewDoneTag = nil
                self.go_table.aorbtn_skill1:SetActiveE(1)
                self.go_table.aorbtn_skill2:SetActiveE(1)
                self.go_table.aorbtn_skill3:SetActiveE(1)
                self.go_table.aorbtn_skill4:SetActiveE(1)
                self.go_table.aorbtn_skill5:SetActiveE(1)
                self.go_table.aorbtn_skill6:SetActiveE(1)
            end
        )
    end
end
function GuessGameEmbattleView:OnGuessGameViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.GuessGameView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnGuessGameViewOpened, self)
        require("EmbattleController"):GetInstance():CloseEmbattle()
        self:Close()
    end
end
return GuessGameEmbattleView
