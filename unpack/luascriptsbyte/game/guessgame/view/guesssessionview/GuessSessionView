local SessionItem = _G.BaseClass("SessionItem")
local format = _G.string.format
local teamTagLan = {90000010135, 90000010134}
function SessionItem:__init(obj, click)
    self.gameObject = obj
    self.onBgClick = click
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.cardTrans = {
        self.go_table.trans_cardRed1,
        self.go_table.trans_cardRed2,
        self.go_table.trans_cardRed3,
        self.go_table.trans_cardRed4,
        self.go_table.trans_cardRed5,
        self.go_table.trans_cardBlue1,
        self.go_table.trans_cardBlue2,
        self.go_table.trans_cardBlue3,
        self.go_table.trans_cardBlue4,
        self.go_table.trans_cardBlue5
    }
    self.cards = {
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false},
        {sid = 0, star = 0, level = 0, item = false}
    }
end
function SessionItem:Dispose()
    self.gameObject = nil
    self.go_table = nil
    self.playback_uid = nil
    self.cardTrans = nil
    self.activity = nil
end
function SessionItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_replay then
        if self.playback_uid and self.playback_uid > 0 then
            --TODO:回放功能
            self.activity:ReplayBattle(self.curSessionIndex, true)
        end
    elseif go == self.go_table.aorbtn_bg then
        if self.onBgClick then
            self.onBgClick(self.curSessionIndex, self.go_table.aortext_time.text)
        end
    end
end
function SessionItem:Show(data, tb, index, activity)
    self.activity = activity
    self.curSessionIndex = index
    if not data then
        self.gameObject:SetActiveE(0)
    else
        self.gameObject:SetActiveE(1)
        _G.TimeUtil.GetDateTime(data.time_start, tb)
        if tb.minute == 0 then
            self.go_table.aortext_time.text = format("%d.%d.%d  %d:00", tb.year, tb.month, tb.day, tb.hour)
        elseif tb.minute < 10 then
            self.go_table.aortext_time.text = format("%d.%d.%d  %d:0%d", tb.year, tb.month, tb.day, tb.hour, tb.minute)
        else
            self.go_table.aortext_time.text = format("%d.%d.%d  %d:%d", tb.year, tb.month, tb.day, tb.hour, tb.minute)
        end
        self:ShowResult(data)
        if data.playback_uid and data.playback_uid > 0 then
            self.playback_uid = data.playback_uid
            self.go_table.aorbtn_replay:SetActiveE(1)
        else
            self.go_table.aorbtn_replay:SetActiveE(0)
        end
        self:ShowCardInfo(data.array, data.bet == 2 and 2 or 1)
    end
end
function SessionItem:ShowResult(data)
    if data.time_start > _G.TimeUtil.GetServerUnixTime() then --未开始
        self.go_table.aorimage_tag.SpriteName = "ui_hjdj_txt_wkq"
    else
        if data.bet == 0 then --未竞猜
            self.go_table.aorimage_tag.SpriteName = "ui_hjdj_txt_wjc"
        else
            if data.win == 0 then --未开奖
                self.go_table.aorimage_tag.SpriteName = "ui_hjdj_txt_yjc02"
            else
                if data.win == data.bet then
                    self.go_table.aorimage_tag.SpriteName = "ui_hjdj_txt_sl"
                else
                    self.go_table.aorimage_tag.SpriteName = "ui_hjdj_txt_sb"
                end
            end
        end
    end
    self.go_table.aorimage_tag:SetNativeSize()
end
---展示当前场次卡牌数据
---@param data table 队伍ID组
function SessionItem:ShowCardInfo(data, guessIndex)
    local cardIndex = 1
    local function onCardCall(item)
        local card = self.cards[cardIndex]
        cardIndex = cardIndex + 1
        item:Show(card.sid, nil, card.star, card.level, 0, 0)
        item:ShowLevel(card.level, true)
    end
    self.go_table.aortext_red.text = _G.GetLangPackValue(teamTagLan[guessIndex])
    self.go_table.aortext_blue.text = _G.GetLangPackValue(teamTagLan[3 - guessIndex])
    local cfg = _G.ConfigManager.monster_equity_cfg[data[guessIndex]]
    local attCfg = _G.ConfigManager.att_equity_cfg[cfg.att_equity]
    local itemCardType = _G.ItemCardFactory.itemCardType
    local ItemCardFactoyIns = _G.ItemCardFactory:GetInstance()
    local card
    for i = 1, #cfg.cards_id do
        card = self.cards[i]
        card.sid = cfg.cards_id[i]
        card.star = attCfg.star
        card.level = attCfg.level
        if card.item then
            card.item:Show(card.sid, nil, card.star, card.level, 0, 0)
        else
            ItemCardFactoyIns:GetItemCard(itemCardType.levelItem, self.cardTrans[i], onCardCall)
        end
    end
    cfg = _G.ConfigManager.monster_equity_cfg[data[3 - guessIndex]]
    for i = 1, #cfg.cards_id do
        card = self.cards[i + 5]
        card.sid = cfg.cards_id[i]
        card.star = attCfg.star
        card.level = attCfg.level
        if card.item then
            card.item:Show(card.sid, nil, card.star, card.level, 0, 0)
        else
            ItemCardFactoyIns:GetItemCard(itemCardType.levelItem, self.cardTrans[i + 5], onCardCall)
        end
    end
end

---@class GuessSessionView : UIBaseView	中文描述
---@field public go_table GuessSessionView_GoTable GoTable
local GuessSessionView = _G.BaseClass("GuessSessionView", _G.UIBaseView)

function GuessSessionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GuessSessionView:OnCreate(activity)
    self.activity = activity
    self.itemDic = {}
    self.tb = {
        year = 0,
        month = 0,
        day = 0,
        week = 0,
        hour = 0,
        minute = 0,
        second = 0
    }
    self.sessionInfo = self.activity:GetAllSessionInfo()
    self.onBgClickHandler = _G.handler(self, self.OnBgClick)
    self.go_table.scrollloopvectical_session:InitItemData(#self.sessionInfo, _G.handler(self, self.OnItemCall))
    self.activity:SetResultSendCall(self.viewName, _G.handler(self, self.OnResultCall))
    self.activity:SetOnSixUpdateCall(self.viewName, _G.handler(self, self.OnSixUpdateCall))
end

---界面的销毁函数
function GuessSessionView:OnDestroy()
    for _, value in pairs(self.itemDic) do
        value:Dispose()
    end
    self.itemDic = nil
    self.sessionInfo = nil
    self.tb = nil
    self.activity:SetResultSendCall(self.viewName, nil)
    self.activity:SetOnSixUpdateCall(self.viewName, nil)
    self.activity = nil
end

---按钮点击事件在这里派发
function GuessSessionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_BG then
        self:Close()
    end
end
function GuessSessionView:OnItemCall(index, obj)
    if index < 0 then
        return
    end
    local insID = obj:GetInstanceIDE()
    local item = self.itemDic[insID]
    if not item then
        item = SessionItem.New(obj, self.onBgClickHandler)
        self.itemDic[insID] = item
    end
    index = index + 1
    item:Show(self.sessionInfo[index], self.tb, index, self.activity)
end
function GuessSessionView:OnBgClick(index, time)
    local info = self.sessionInfo[index]
    if _G.TimeUtil.GetServerUnixTime() < info.time_start then
        --TODO:提示未开
        _G.PopWindowManager:GetInstance():ShowAllTips(630102, nil, nil, nil, nil, nil, time)
        return
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GuessGameView.Name)
    if view then
        view:ShowByIndex(index)
        self:Close()
    end
end
function GuessSessionView:OnSixUpdateCall()
    --TODO:信息刷新 需要刷新界面
    if self.activity:GetCurState() then
        self.sessionInfo = self.activity:GetAllSessionInfo()
        self.go_table.scrollloopvectical_session:UpdateAllItem()
    else
        self:Close()
    end
end
function GuessSessionView:OnResultCall(index)
    self.sessionInfo = self.activity:GetAllSessionInfo()
    if index then
        self.go_table.scrollloopvectical_session:UpdateItemSingle(index - 1)
    else
        self.go_table.scrollloopvectical_session:UpdateAllItem()
    end
end
return GuessSessionView
