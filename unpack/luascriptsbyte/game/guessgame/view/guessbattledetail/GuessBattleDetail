---@class GuessBattleDetail : UIBaseView	中文描述
---@ffeld public go_table GuessBattleDetail_GoTable GoTable

local GuessBattleDetail = _G.BaseClass("GuessBattleDetail", _G.UIBaseView)
function GuessBattleDetail:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local teamIcon = {
    "ui_hjdj_txt_hf",
    "ui_hjdj_txt_lf"
}
local titleIcon = {
    "ui_hjdj_frame_hongtiao",
    "ui_hjdj_frame_lantiao"
}
local ShowType = {red = 1, blue = 2}
---界面的入口函数
---@param data table{i_fight_arg}
function GuessBattleDetail:OnCreate(data, decorationData, index)
    self.DecorationData = decorationData
    self.data = data
    self.go_table.scrollloopvectical_Card:InitItemData(0, _G.handler(self, self.RefreshList))
    self:InitView(index)
end
function GuessBattleDetail:OnDestroy()
    self.data = nil
    self.chooseEffect = nil
end
function GuessBattleDetail:InitView(index)
    if self.chooseEffect == nil then
        self.chooseEffect = false
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_Guess_xuanzhong,
            index == ShowType.red and self.go_table.aorbtn_red or self.go_table.aorbtn_blue,
            function(eff)
                if _G.IsNil(self.go_table) then
                    _G.UIUtils.RemoveEffect(eff)
                else
                    self.chooseEffect = eff
                end
            end
        )
    elseif self.chooseEffect then
        self.chooseEffect:SetParentE(index == ShowType.red and self.go_table.aorbtn_red or self.go_table.aorbtn_blue)
        self.chooseEffect:SetLocalPositionToZero()
    end
    if index and index ~= self.CurShowType then
        self.CurShowType = index
    elseif not index then
        self.CurShowType = ShowType.red
    end
    self.go_table.aorimage_titlebg.SpriteName = titleIcon[self.CurShowType]
    if self.go_table.aorimage_titlebg:GetActiveSelf() == 0 then
        self.go_table.aorimage_titlebg:SetActiveE(1)
    end
    self.go_table.aorimage_team.SpriteName = teamIcon[self.CurShowType]
    if self.go_table.aorimage_team:GetActiveSelf() == 0 then
        self.go_table.aorimage_team:SetActiveE(1)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_curRed, self.CurShowType == 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_curBlue, self.CurShowType == 2)
    self:SetData()
end
function GuessBattleDetail:SetData()
    self.CurData = self.data[self.CurShowType]
    self.CurDecorationData = self.DecorationData[self.CurShowType]
    self:ShowList()
    self:ShowCombineSkill()
end
local ComputeDecoration = function(id)
    return 251000000 + id * 10000 + 1 * 100 + _G.ConfigManager.att_equity_cfg[1].decoration_grade
end
function GuessBattleDetail:ShowCombineSkill()
    local data = self.CurData
    self.combSkill = _G.GetAutoGoTable(self.go_table.obj_combSkill, _G.handlerbind(self, self.ClickCombine, data))
    local cfg
    for i = 1, 3 do
        cfg = _G.ConfigManager.card_skills_cfg[data.combine_skill[i]]
        _G.GameUtil.SetActiveByCondition(self.combSkill["obj_lock" .. i], not cfg)
        _G.GameUtil.SetActiveByCondition(self.combSkill["obj_type" .. i], cfg)
        if cfg then
            self.combSkill["aorrawimage_icon" .. i]:LoadImage(cfg.icon)
            _G.GameUtil.SetActiveByCondition(self.combSkill["aorimage_type" .. i], cfg.brief > 0)
            if cfg.brief > 0 then
                self.combSkill["aortext_type" .. i].text = _G.ConfigManager.language_package_cfg[cfg.brief]
            end
            self.combSkill[string.format("aortext_type%d%d", i, i)].text =
                _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][i])
        end
    end
end
function GuessBattleDetail:ClickCombine(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_1" then
        if data.combine_skill and data.combine_skill[1] then
            require("CommonTipManager"):GetInstance():OpenSkillTip(data.combine_skill[1])
        end
    elseif name == "@_aorbtn_2" then
        if data.combine_skill and data.combine_skill[2] then
            require("CommonTipManager"):GetInstance():OpenSkillTip(data.combine_skill[2])
        end
    elseif name == "@_aorbtn_3" then
        if data.combine_skill and data.combine_skill[3] then
            require("CommonTipManager"):GetInstance():OpenSkillTip(data.combine_skill[3])
        end
    end
end
function GuessBattleDetail:ShowList()
    local data = self.CurData
    if self.Count ~= #data.fights then
        self.go_table.scrollloopvectical_Card:UpdateCount(#data.fights)
    else
        self.go_table.scrollloopvectical_Card:UpdateAllItem()
    end
    self.Count = #data.fights
end
function GuessBattleDetail:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetActiveE(0)
    obj:SetName(x)
    -- local decorId = ComputeDecoration(self.CurDecorationData[x])
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickDecoration, decorId))
    self:ShowCard(self.CurData.fights, tb, x)
    -- if decorId > 0 then
    --     tb.aorrawimage_des:LoadImage(_G.ConfigManager.decoration_cfg[decorId].icon)
    -- end
end
function GuessBattleDetail:ClickDecoration(go, isRef, decorId)
    require "CommonTipManager":GetInstance():OpenTip(go, decorId)
end
function GuessBattleDetail:ShowAttribute(attrs, goTable)
    for k, v in pairs(attrs) do
        if goTable["aortext_" .. k] then
            if _G.AttrType[k] then
                if k == "psy_d_r" or k == "mag_d_r" then
                    local num
                    if v % 10 == 1 then
                        num = math.floor(-v / 10)
                    elseif v % 10 == 0 then
                        num = math.floor(v / 10)
                    end
                    if num == 0 then
                        goTable["aortext_" .. k].text = 0 .. "%"
                    else
                        goTable["aortext_" .. k].text = (num / 100) .. "%"
                    end
                else
                    if _G.AttrType[k].percentage == 1 then
                        goTable["aortext_" .. k].text = math.floor(v / 100) .. "%"
                    else
                        goTable["aortext_" .. k].text = GameUtil.NumberToUnitStrFight(v)
                    end
                end
            end
        end
    end
end
function GuessBattleDetail:ShowCard(data, goTable, x)
    if data and data[x] then
        goTable.gameObject:SetActiveE(1)
        if goTable.lua_Prop == nil then
            ---开始生成对象 并标记
            ---@type ItemCardAllView
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                goTable.trans_card,
                function(tran)
                    goTable.lua_Prop = tran
                    self:ItemSet_Cfg(tran, data[x])
                end
            )
        else
            self:ItemSet_Cfg(goTable.lua_Prop, data[x])
        end
        self:ShowAttribute(data[x].attrs, goTable)
    end
end
function GuessBattleDetail:ItemSet_Cfg(tran, data)
    tran:Show(data.sid, nil, data.star, data.soul_chain_lv, data.lv, data.uid, false)
end
---按钮点击事件在这里派发
function GuessBattleDetail:OnClickBtn(go)
    if go == self.go_table.aorbtn_red then
        self:InitView(1)
    elseif go == self.go_table.aorbtn_blue then
        self:InitView(2)
    elseif go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

function GuessBattleDetail:EscClose()
    self:Close()
end

return GuessBattleDetail
