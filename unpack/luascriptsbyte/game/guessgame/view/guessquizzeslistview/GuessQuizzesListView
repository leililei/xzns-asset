---列表刷新
function GuessQuizzesListView:RefreshRewardsNodeLists(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1

    item:SetName(x)
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.DianJiXiangYing, x))
    local data = self.datalist[x]
    if data == nil then
        tb.gameObject:SetActiveE(0)
    else
        tb.gameObject:SetActiveE(1)
        tb.aortext_name.text = data.role_info.name
        tb.aortext_rankwintimes.text = data.win_num
        tb.aortext_rankwinrate.text = data.win_rate / 100 .. "%"
        local mingci = x
        if mingci <= 3 then
            _G.GameUtil.SetActiveByCondition(tb.obj_rankBiaozhi, true)
            _G.GameUtil.SetActiveByCondition(tb.obj_mingci, false)
            if mingci == 1 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
            elseif mingci == 2 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
            elseif mingci == 3 then
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
            end
        else
            _G.GameUtil.SetActiveByCondition(tb.obj_rankBiaozhi, false)
            _G.GameUtil.SetActiveByCondition(tb.obj_mingci, true)
            tb.aortext_rank_paiming.text = mingci
        end
        ---@type Params_PlayerHeadItem
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 1, true, true)
        if data.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            self:PaiMingXianShi(x)
        end
    end
    return item
end

function GuessQuizzesListView:DianJiXiangYing()
end

---排名显示
function GuessQuizzesListView:PaiMingXianShi(number)
    if number <= 3 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_rankBiaozhi, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_mingci, false)
        if number == 1 then
            self.go_table.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
            self.go_table.aorimage_bg.SpriteName = "tz_qjhs_di_02"
        elseif number == 2 then
            self.go_table.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
            self.go_table.aorimage_bg.SpriteName = "tz_qjhs_di_03"
        elseif number == 3 then
            self.go_table.aorimage_bg.SpriteName = "tz_qjhs_di_04"
            self.go_table.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_rankBiaozhi, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_mingci, true)
        self.go_table.aortext_rank_paiming.text = number
    end
end
---个人信息更新
function GuessQuizzesListView:SetCurrentTiaoRank(data)
    --self.go_table.aortext_ranknumber.text = self.type
    self.go_table.aortext_rankwintimes.text = data.values[1]
    self.go_table.aortext_rankwinrate.text = data.values[2] / 100 .. "%"
    self.go_table.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    ---@type Params_PlayerHeadItem
    local Params_PlayerHeadItem = {}
    Params_PlayerHeadItem.frame = _G.PlayerModel:GetInstance():GetCurFrame()
    Params_PlayerHeadItem.lv = _G.PlayerModel:GetInstance():GetLevel()
    Params_PlayerHeadItem.style = _G.PlayerModel:GetInstance():GetRoleStyle()
    Params_PlayerHeadItem.sid = _G.ConfigManager.player_portrait_cfg[_G.PlayerModel:GetInstance():GetRoleStyle()].ID
    Params_PlayerHeadItem.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    Params_PlayerHeadItem.title = _G.PlayerModel:GetInstance():GetTitle()

    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true)
end

---按钮点击事件在这里派发
function GuessQuizzesListView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_BG" then
        self:CloseView()
    end
end
function GuessQuizzesListView:CloseView()
    self:Close()
end
--endregion

return GuessQuizzesListView
