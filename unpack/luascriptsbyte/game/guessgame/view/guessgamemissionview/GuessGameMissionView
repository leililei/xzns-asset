function GuessGameMissionView:WasTaken(sid,type)
    return self.activity:WasTaken(sid,type)
end

function GuessGameMissionView:CheckCanTake(data,type)
    return self.activity:CheckCanTake(data,type)
end


return GuessGameMissionView