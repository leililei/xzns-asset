---@class GuessGameMissionView : UIBaseView	中文描述
---@field public go_table GuessGameMissionView_GoTable GoTable
local GuessGameMissionView = _G.BaseClass("GuessGameMissionView", _G.UIBaseView)

function GuessGameMissionView:Awake()
    self.curType = 1
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GuessGameMissionView:OnCreate(activity)
    self.activity = activity
    self.missionList = {}
    self.progressList = {}
    self.taskList = {}
    self.activity:SortTask(1)
    self.activity:SortTask(2)
    self.missionList = self.activity:GetMissionData()
    self.progressList = self.activity:GetProgressData()
    self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTask))
    self.go_table.toggle_daily.isOn = true
    self:RefreshRedPoint()
end

---界面的销毁函数
function GuessGameMissionView:OnDestroy()
end

function GuessGameMissionView:RefreshRedPoint()
    self.go_table.obj_dailyRed:SetActiveE(0)
    self.go_table.obj_mainRed:SetActiveE(0)
    for _,v in pairs(self.missionList[1]) do
        if self:CheckCanTake(v,1) then
            self.go_table.obj_dailyRed:SetActiveE(1)
        end
    end
    for _,v in pairs(self.missionList[2]) do
        if self:CheckCanTake(v,2) then
            self.go_table.obj_mainRed:SetActiveE(1)
        end
    end
end

---按钮点击事件在这里派发
function GuessGameMissionView:OnClickBtn(go,isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_daily then
        --self.go_table.toggle_daily:GetChildE(2):SetActiveE(isOn and 1 or 0)
        --_G.GameUtil.SetActiveBycondition(self.go_table.toggle_daily:GetChildE(2), isOn)
        if isOn then
            self.curType = 1
            self:ChangeType(1)
        end
    elseif go == self.go_table.toggle_main then
        --self.go_table.toggle_daily:GetChildE(2):SetActiveE(isOn and 1 or 0)
        --_G.GameUtil.SetActiveBycondition(self.go_table.toggle_main:GetChildE(2), isOn)
        if isOn then
            self.curType = 2
            self:ChangeType(2)
        end
    elseif go == self.go_table.aorbtn_getAll then
        self:GetAll()
    end
end

function GuessGameMissionView:RefreshTask(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskList[id]
    local data = self.missionList[self.curType][index + 1]
    self.data = data
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, tb))
        self.taskList[id] = tb
        tb.awardList = {}
        tb.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAward, tb))
    end
    tb.index = index + 1
    ---@type HellGuardTaskData
    --tb.index = index + 1
    local desc = 0
    local need = data.condition[1].v
    local progress = need
    if data.condition[1].k == 1 then
        desc = 90000001113
        progress = self.progressList[self.curType].times
    elseif data.condition[1].k == 2 then
        desc = 90000001114
        progress = self.progressList[self.curType].coin
    elseif data.condition[1].k == 3 then
        desc = 90000001115
        progress = self.progressList[self.curType].barrage
    elseif data.condition[1].k == 4 then
        desc = 90000001131
        progress = self.progressList[self.curType].winningStreak
    elseif data.condition[1].k == 5 then
        desc = 90000001130
        progress = self.progressList[self.curType].winTimes
    end
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(desc,data.condition[1].v)
    if progress >= need then
        tb.slider_progress.value = need / need
        tb.aortext_Slider.text = need .. "/" .. need
    else
        tb.slider_progress.value = progress / need
        tb.aortext_Slider.text = progress .. "/" .. need
    end
    local cantake = self:CheckCanTake(data,self.curType)
    tb.aorbtn_get:SetActiveE(cantake and 1 or 0)
    tb.obj_unGet:SetActiveE(progress >= need and 0 or 1)
    tb.obj_complete:SetActiveE(self:WasTaken(data.sid,self.curType) and 1 or 0)
    local count = #data.award
    tb.scrollloophorizontal_awardList:UpdateScrollRectWeight(count <= 1 and 94 or 168)
    tb.scrollloophorizontal_awardList:UpdateCount(count)

end

function GuessGameMissionView:RefreshAward(index, obj, tb)
    local data = self.data
    local id = obj:GetInstanceIDE()
    ---@type BaseAwardNewItem
    local item = tb.awardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 74)
        tb.awardList[id] = item
    end
    local taskData = data
    local awardData = taskData.award[index + 1]
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData.type)
    item:Show(data)
    item.go_table.obj_gou:SetActiveE(self:WasTaken(taskData.sid) and 1 or 0)
end

function GuessGameMissionView:ChangeType(type)
    self.curType = type
    self.go_table.scrollloopvectical_taskList:UpdateCount(#self.missionList[self.curType])
    self:ShowGetAllBtn()
end

function GuessGameMissionView:ShowGetAllBtn()
    local isCanTake = false
    for _, v in pairs(self.missionList[self.curType]) do
        if self:CheckCanTake(v,self.curType) then
            isCanTake = true
            break
        end
    end
    self.go_table.aorbtn_getAll:SetActiveE(isCanTake and 1 or 0)
end

function GuessGameMissionView:OnClickTask(_, _, tb)
    local taskData = self.missionList[self.curType][tb.index]
    self.activity:GetMissionAward(
        {taskData.sid},
        self.curType,
        function()
            self.missionList = self.activity:GetMissionData()
            self.progressList = self.activity:GetProgressData()
            self:ShowGetAllBtn()
            self:RefreshRedPoint()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end
    )
end
---获取所有奖励
function GuessGameMissionView:GetAll()
    local sids = {}
    for _, v in pairs(self.missionList[self.curType]) do
        if self:CheckCanTake(v,self.curType) then
            _G.table.insert(sids, v.sid)
        end
    end
    if _G.table.isEmptyOrNil(sids) then
        return
    end
    self.activity:GetMissionAward(
        sids,
        self.curType,
        function()
            --self:SortTask(self.curType)
            self.missionList = self.activity:GetMissionData()
            self.progressList = self.activity:GetProgressData()
            self:ShowGetAllBtn()
            self:RefreshRedPoint()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end
    )
end

