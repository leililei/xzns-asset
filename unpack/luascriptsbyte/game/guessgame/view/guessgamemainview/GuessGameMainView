---下注倍率回调
---@param att number 进攻方下注人数
---@param def number 防守方下注人数
function GuessGameMainView:OnBetPerCall(att, def)
    self.go_table.aortext_hotRed.text = _G.tostring(self.activity:CalculateHotValue(att))
    self.go_table.aortext_hotBlue.text = _G.tostring(self.activity:CalculateHotValue(def))
    if att == 0 and def == 0 then
        self.go_table.trans_tipsRed:SetActiveE(0)
        self.go_table.trans_tipsBlue:SetActiveE(0)
        return
    end
    def = att + def
    att = _G.Mathf.RoundToInt(att / def * 100)
    local award, num = self.activity:GetShowWeakWinAward(att)
    if award == 0 then
        self.go_table.trans_tipsRed:SetActiveE(0)
        self.go_table.trans_tipsBlue:SetActiveE(0)
    else
        if award == 1 then
            self.go_table.trans_tipsRed:SetActiveE(1)
            self.go_table.trans_tipsBlue:SetActiveE(0)
            self.go_table.aortext_weakAwardRed.text = format(GetLangPackValue(90000010128), num)
        else
            self.go_table.trans_tipsRed:SetActiveE(0)
            self.go_table.trans_tipsBlue:SetActiveE(1)
            self.go_table.aortext_weakAwardBlue.text = format(GetLangPackValue(90000010128), num)
        end
    end
end

