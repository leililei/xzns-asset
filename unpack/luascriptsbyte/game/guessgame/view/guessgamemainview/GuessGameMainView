end

---按钮点击事件在这里派发
function GuessGameMainView:OnClickBtn(go)
    if self.onBtnClick then
        return
    end
    self.onBtnClick = true
    if go == self.go_table.aorbtn_Close then
        --TODO:判定当前是否可领奖励
        if self.curSessionData.bet > 0 and self.curSessionData.win > 0 and self.curSessionData.award == 0 then
            self.activity:GetAward(self.curShowSessionIndex, _G.handler(self, self.OnAwardCall))
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_way then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpenedChangeTag, self)
        --TODO:玩法说明界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 41)
    elseif go == self.go_table.aorbtn_battle then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpenedChangeTag, self)
        --TODO:赛程界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GuessSessionView.Name, self.activity)
    elseif go == self.go_table.aorbtn_rank then
        if self.activity:CheckActivityOpened() then
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpenedChangeTag, self)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GuessQuizzesListView.Name,self.activity)
        else
            self.onBtnClick = false
        end
    elseif go == self.go_table.aorbtn_guess then
        if not self.activity:CheckActivityOpened() then
            self.onBtnClick = false
            return
        end
        if self.curSessionEndTime < self.activity:GetSettlementSecond() then
            _G.PopWindowManager:GetInstance():ShowAllTips(630104)
            self.onBtnClick = false
            return
        end
        self:Bet(false)
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_guessBlue then
        if not self.activity:CheckActivityOpened() then
            self.onBtnClick = false
            return
        end
        --TODO:投注蓝色方
        if self.curSessionEndTime < self.activity:GetSettlementSecond() then
            _G.PopWindowManager:GetInstance():ShowAllTips(630104)
            self.onBtnClick = false
            return
        end
        self:Bet(true)
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_next then
        if self.curShowSessionIndex >= #(self.activity:GetAllSessionInfo()) then
            --TODO:提示赛程结束
            _G.PopWindowManager:GetInstance():ShowAllTips(630109)
            self.onBtnClick = false
            return
        end
        --TODO:下一关
        self.curShowSessionIndex = self.activity:GetShowSessionInfo()
        self:ShowSessionInfo()
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_box then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_Guess_bx_open,
            self.go_table.aorbtn_box,
            function(eff)
                if _G.IsNil(self.go_table) then
                    _G.UIUtils.RemoveEffect(eff)
                end
            end,
            function()
                --TODO:领取宝箱
                self.activity:GetAward(self.curShowSessionIndex, _G.handler(self, self.OnAwardCall))
            end
        )
    elseif go == self.go_table.aorbtn_replay then
        --TODO:回放战报
        if self.curSessionData.playback_uid and self.curSessionData.playback_uid > 0 then
            --TODO:回放功能
            self.activity:ReplayBattle(self.curShowSessionIndex, false)
        end
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_shop then
        self.onBtnClick = false
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity.curActivityClass:GetJumpType())
    elseif go == self.go_table.aorbtn_detail then
        self:ShowDetailView()
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_detailRed then
        self:ShowDetailView()
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_detailBlue then
        self:ShowDetailView(true)
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_chatOpen then
        self:ShowChatWindow(false)
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_chatClose then
        self:ShowChatWindow(true)
        self.onBtnClick = false
    elseif go == self.go_table.aorbtn_chat then
        self:ShowChatView()
    elseif go == self.go_table.aorbtn_exchange then
        self.onBtnClick = false
        _G.GlobalInterface.JumpActivityByGM(10005, self.activity.curActivityClass:GetJumpType())
    elseif go == self.go_table.aorbtn_mission then
        self.onBtnClick = false
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GuessGameMissionView.View, self.activity)
    end
end
