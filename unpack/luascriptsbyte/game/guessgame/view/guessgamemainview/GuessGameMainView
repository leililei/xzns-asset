---展示当前场次卡牌数据
---@param data table 队伍ID组
function GuessGameMainView:ShowCardInfo(data)
    local cardIndex = 1
    local function onCardCall(item)
        local card = self.cards[cardIndex]
        cardIndex = cardIndex + 1
        item:Show(card.sid, nil, card.star, card.level, 0, 0)
        item:ShowLevel(card.level, true)
    end
    local cfg = _G.ConfigManager.monster_equity_cfg[data[1]]
    local attCfg = _G.ConfigManager.att_equity_cfg[cfg.att_equity]
    local itemCardType = _G.ItemCardFactory.itemCardType
    local ItemCardFactoyIns = _G.ItemCardFactory:GetInstance()
    local card
    for i = 1, #cfg.cards_id do
        card = self.cards[i]
        card.sid = cfg.cards_id[i]
        card.star = attCfg.star
        card.level = attCfg.level
        if card.item then
            card.item:Show(card.sid, nil, card.star, card.level, 0, 0)
        else
            ItemCardFactoyIns:GetItemCard(itemCardType.levelItem, self.cardTrans[i], onCardCall)
        end
    end
    cfg = _G.ConfigManager.monster_equity_cfg[data[2]]
    for i = 1, #cfg.cards_id do
        card = self.cards[i + 5]
        card.sid = cfg.cards_id[i]
        card.star = attCfg.star
        card.level = attCfg.level
        if card.item then
            card.item:Show(card.sid, nil, card.star, card.level, 0, 0)
        else
            ItemCardFactoyIns:GetItemCard(itemCardType.levelItem, self.cardTrans[i + 5], onCardCall)
        end
    end
end
---展示合击技
---@param skill1 table 红方合击技
---@param skill2 table 蓝方合击技
function GuessGameMainView:ShowSkillInfo(skill1, skill2)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local battle_skill_cfg = _G.ConfigManager.battle_skill_cfg
    local language_package_cfg = _G.ConfigManager.language_package_cfg
    local typeTextDesc = _G.ConfigManager.discrete_cfg[105003][1]
    local GetLangPackValue = _G.LangUtil.GetLangPackValue
    local cfg
    for i = 1, #skill1 do
        cfg = card_skills_cfg[skill1[i]]
        self.skills[i].img:LoadImage(cfg.icon)
        cfg = battle_skill_cfg[cfg.skills[1]]
        self.skills[i].text.text = language_package_cfg[cfg.Brief]
        self.skills[i].typeText.text = GetLangPackValue(typeTextDesc[i])
    end
    for i = 1, #skill2 do
        cfg = card_skills_cfg[skill2[i]]
        self.skills[i + 3].img:LoadImage(cfg.icon)
        cfg = battle_skill_cfg[cfg.skills[1]]
        self.skills[i + 3].text.text = language_package_cfg[cfg.Brief]
        self.skills[i + 3].typeText.text = GetLangPackValue(typeTextDesc[i])
    end
end
---展示场次信息
function GuessGameMainView:ShowSessionInfo()
    self.curSessionData = self.activity:GetSessionData(self.curShowSessionIndex)
    self.activity:GetPercentage(self.curShowSessionIndex, _G.handler(self, self.OnBetPerCall))
    self:ShowCardInfo(self.curSessionData.array)
    self:ShowSkillInfo(self.curSessionData.combine_1, self.curSessionData.combine_2)
    self.curSessionEndTime = self.activity:GetSessionEndTime(self.curShowSessionIndex) + 1
    self:HandleTime()
    if self.curSessionEndTime > 0 then
        self.sessionEndTimer = _G.TimerManager:GetInstance():GetTimer(1, self.HandleTime, self)
        self.sessionEndTimer:Start()
    end
    -- self.go_table.trans_allAward:SetActiveE(0)
    -- self.go_table.trans_allAward:SetActiveE(1)
    -- self.go_table.trans_allAward:SetLocalPosition(25, -81)
    self:ShowBtnState()
    self:ShowResult()
    self.go_table.scrollloopvectical_info:InitItemData(0, _G.handler(self, self.OnBetInfoItemCall))
    self.activity:GetGuessInfo(_G.handler(self, self.OnBetInfoCall))
    self.activity:SetResultSendCall(self.viewName, _G.handler(self, self.OnResultCall))
    self.activity:SetOnSixUpdateCall(self.viewName, _G.handler(self, self.OnSixUpdateCall))
    -- local num, award = self.activity:GetContinuouslyWinTimes()
    -- self.go_table.aortext_allAward.text = format(GetLangPackValue(90000000980), award)
end

function GuessGameMainView:ShowResult()
    if self.curSessionData.win > 0 then --已出结果
        self.go_table.trans_guessResult:SetActiveE(1)
        if self.curSessionData.win == 1 then --红方
            self.go_table.trans_guessResult:SetParentE(self.go_table.trans_leftResult)
        else
            self.go_table.trans_guessResult:SetParentE(self.go_table.trans_rightResult)
        end
        self.go_table.trans_guessResult:SetLocalPosition(0, 0, 0)
    else
        self.go_table.trans_guessResult:SetActiveE(0)
    end
    if self.curSessionData.bet > 0 then -- 已竞猜
        if self.curSessionData.bet == 1 then --红方
            self.go_table.aorimage_resultTag:SetParentE(self.go_table.trans_leftGuessTag)
        else
            self.go_table.aorimage_resultTag:SetParentE(self.go_table.trans_rightGuessTag)
        end
        self.go_table.aorimage_resultTag:SetLocalPosition(0, 0, 0)
        if self.curSessionData.win > 0 then --已出结果
            if self.curSessionData.bet == self.curSessionData.win then --猜对结果
                self.go_table.aorimage_resultTag.SpriteName = "ui_hjdj_txt_jccg"
            else
                self.go_table.aorimage_resultTag.SpriteName = "ui_hjdj_txt_jcsb"
            end
            self.go_table.aorimage_resultTag:SetActiveE(1)
        else
            self.go_table.aorimage_resultTag:SetActiveE(0)
        end
    else
        self.go_table.aorimage_resultTag:SetActiveE(0)
    end
end

---处理本轮竞猜剩余时间
function GuessGameMainView:HandleTime(elapsed)
    self.curSessionEndTime = self.curSessionEndTime - (elapsed or 1)
    if self.curSessionEndTime > intervalTime then
        self.go_table.aortext_time.text = intervalTimeStr
    else
        if self.curSessionEndTime <= 0 then
            self.curSessionEndTime = 0
            if self.sessionEndTimer then
                self.sessionEndTimer:Stop()
                self.sessionEndTimer = nil
            end
        end
        self.go_table.aortext_time.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.curSessionEndTime), 1)
    end
end
function GuessGameMainView:ShowBtnState()
    if self.curSessionData.award == 1 then --已经领取奖励,显示下一关
        self.go_table.aorbtn_guess:SetActiveE(0)
        self.go_table.aorbtn_guessBlue:SetActiveE(0)
        if self.curShowSessionIndex >= #(self.activity:GetAllSessionInfo()) then
            self.go_table.aorimage_next.SpriteName = "ui_hjdj_txt_ywc"
        else
            self.go_table.aorimage_next.SpriteName = "ui_hjdj_txt_xyc"
        end
        self.go_table.aorbtn_next:SetActiveE(1)
        self.go_table.aorimage_next:SetNativeSize()
        self.go_table.aorbtn_box:SetActiveE(0)
        return
    end
    if self.curSessionData.win > 0 then --该场次已结束但是没有领取奖励
        if self.curSessionData.bet > 0 then
            --TODO：显示领取奖励
            self.go_table.aorbtn_guess:SetActiveE(0)
            self.go_table.aorbtn_guessBlue:SetActiveE(0)
            self.go_table.aorbtn_next:SetActiveE(0)
            self.go_table.aorbtn_box:SetActiveE(1)
            if self.boxEffectLoop == nil then
                self.boxEffectLoop = false
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_Guess_bx_loop,
                    self.go_table.aorbtn_box,
                    function(eff)
                        if _G.IsNil(self.go_table) then
                            _G.UIUtils.RemoveEffect(eff)
                        else
                            self.boxEffectLoop = eff
                        end
                    end
                )
            end
        else
            self.go_table.aorbtn_guess:SetActiveE(0)
            self.go_table.aorbtn_guessBlue:SetActiveE(0)
            if self.curShowSessionIndex >= #(self.activity:GetAllSessionInfo()) then
                self.go_table.aorimage_next.SpriteName = "ui_hjdj_txt_ywc"
            else
                self.go_table.aorimage_next.SpriteName = "ui_hjdj_txt_xyc"
            end
            self.go_table.aorbtn_next:SetActiveE(1)
            self.go_table.aorimage_next:SetNativeSize()
            self.go_table.aorbtn_box:SetActiveE(0)
        end
        return
    end
    if self.curSessionData.bet > 0 then --已竞猜
        if self.curSessionData.bet == 1 then
            --TODO:显示竞猜
            self.go_table.aorbtn_guess:SetActiveE(1)
            self.go_table.aorbtn_guessBlue:SetActiveE(0)
            self.go_table.aorimage_guess.SpriteName = "ui_hjdj_txt_yjc"
            self.go_table.aorimage_guessBlue.SpriteName = "ui_hjdj_txt_jc"
        else
            --TODO:显示竞猜
            self.go_table.aorbtn_guess:SetActiveE(0)
