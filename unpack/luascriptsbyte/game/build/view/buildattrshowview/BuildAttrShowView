--@class BuildAttrShowView : UIBaseView 下边栏菜单
---@field go_table BuildAttrShowView_GoTable
local BuildAttrShowView = _G.BaseClass("BuildAttrShowView", _G.UIBaseView)

function BuildAttrShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---@param attribute AttributeClass
function BuildAttrShowView:OnCreate(attribute)
    local otherattr = attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    local typelist=_G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    local showList={}
    for k,v in pairs(typelist) do
        table.insert(showList,v.key)
    end
    _G.SortList(
            showList,
            function(a)
                return  -_G.AttrType[a].sortid
            end
    )
    self.attrlist={}
    local numStr, num, key
    for i = 1, #showList do
        key=showList[i]
        if table.ContainsKey(otherattr,key) then
            num = otherattr[key]
            if _G.AttrType[key].percentage == 1 then
                num =  _G.Mathf.RoundToInt(num) / 100
                num = _G.GameUtil.FormatNum(num)
                numStr = tostring(num) .. "%"
            else
                local numOld = _G.math.floor(_G.Mathf.RoundToInt(num))
                numOld = _G.GameUtil.NumberWY(numOld)
                numStr = numOld
            end
            table.insert(self.attrlist,{key=key,name=_G.AttrType[key].des,value=numStr})
        end
    end
    for i = 1, #showList do
        key=showList[i]
        if table.ContainsKey(Percentattr,key) then
            num = Percentattr[key]
            num =  num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = tostring(num) .. "%"

            table.insert(self.attrlist,{key=key,name=_G.GetLangPackValue(90033800108,_G.AttrType[key].des),
                                        value=numStr})
        end
    end
    self.go_table.scrollloopvectical_list:InitItemData(#self.attrlist, _G.handler(self, self.RefreshAttrList))
end
function BuildAttrShowView:RefreshAttrList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local item=self.attrlist[index+1]
    tb.aortext_name.text=item.name
    tb.aortext_value.text=item.value
    tb.aorimage_icon.SpriteName=_G.AttrTypeIcon[item.key]
end

---按钮点击事件在这里派发
function BuildAttrShowView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return BuildAttrShowView