local BuildDrawModel = require "BuildDrawModel"
local card_skills_cfg = _G.ConfigManager.card_skills_cfg

local base = require "EventViewBase"
---@class BuildShowView : UIBaseView	建筑合成展示界面
---@field public go_table BuildShowView_GoTable GoTable
local BuildShowView = _G.BaseClass("BuildShowView", base)

function BuildShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BuildShowView:OnCreate(sid)
    self.data = BuildDrawModel:GetInstance():GetBuild(sid)
    -- local pos = self.data:GetCfg().spine_portrait1
    -- if self.data.cfg.spine_1 ~= "" then
    --     _G.UIUtils.LoadEffectByPath(self.data.cfg.spine_1, self.go_table.aorrawimage_icon,nil,nil,nil,{pos[1], pos[2], pos[3]},pos[4])
    -- end
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(sid)
    self.LoveLevel = self.loveData.favor_level
    self.go_table.aorrawimage_icon:LoadImage(
        self.data.cfg.image_1,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
        end)

    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(self.data.cfg.Order))
    ctm:SetItemTextGradient(self.go_table.aortext_name, self.data.cfg.Order)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.data.cfg.Name)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    local Cfg = _G.ConfigManager.attribute_cfg[self.data.cfg.skill_id[1]]
    local baseSkillCfg = card_skills_cfg[Cfg.skill]
    self.go_table.aorrawimage_skill:LoadImage(baseSkillCfg.icon)
    self.go_table.aortext_petSkillName.text = _G.GetLangPackValue(baseSkillCfg.name1)


    local skillDesExText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text = self:GetSkillDesBase(self.data.cfg.skill_id[1])
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))


    --- 是否解锁衣物遮挡
    self.IsClothSpecial = false
    self:GetSpecial()

    local childCount = self.go_table.obj_spine:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_spine:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.data.cfg.spine,
        _G.ePoolType.UIItem,
        self.go_table.obj_spine,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            self.spine = trans

            if not self.IsMaskSpecial then
                GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle99, true)
            else
                --- 两个都开启播放没衣服的
                if self.IsMaskSpecial and self.IsClothSpecial then
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle, true)
                else
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle2, true)
                end
            end
            trans:SetLocalScaleXYZ(self.data.cfg.coord[2][1])
            trans:SetLocalPosition(_G.table.unpack(self.data.cfg.coord[1]))
        end
    )

    --self:LoadEffect()
end

--- 特殊解锁判定
function BuildShowView:GetSpecial()
    for i = 1, #self.data.cfg.special do
        if self.data.cfg.special[i][2] < self.LoveLevel then
            if self.data.cfg.special[i][1] == 1 then
                self.IsMaskSpecial = true
                self.go_table.obj_Effect:SetActiveE(0)
            end
            if self.data.cfg.special[i][1] == 2 then
                self.IsSoundSpecial = true
            end
            if self.data.cfg.special[i][1] == 3 then
                self.IsClothSpecial = true
            end
            if self.data.cfg.special[i][1] == 4 then
                self.IsPlaySpecial = true
            end
            if self.data.cfg.special[i][1] == 5 then
                self.IsTalkSpecial = true
            end
        end
    end
end

function BuildShowView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_PetillustratedView_bg_bao,
        self.go_table.aorrawimage_icon,
        check
    )
end

---获取基本技能描述
function BuildShowView:GetSkillDesBase(id)
    local Cfg = _G.ConfigManager.attribute_cfg[id]
    local LanID = Cfg.describe
    if LanID == 0 then
        LanID = _G.ConfigManager.card_skills_cfg[Cfg.skill].describe1
    end
    if Cfg then
        return _G.GetLangPackValue(LanID)
    else
        return id
    end
end

