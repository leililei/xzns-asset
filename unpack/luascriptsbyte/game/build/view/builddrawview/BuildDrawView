---刷新抽卡按钮icon
function BuildDrawView:UpdateDrawBtn()
    local remainingNum = _G.StorageManager:GetInstance():GetItemCountBySid(mIDLis[self.curIndex])

    -- self.go_table.aortext_Prop1NumDesc.text = _G.GetLangPackValue(90022300126, GameUtil.NumberToWordByLanguage(1))

