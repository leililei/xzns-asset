---抽！
function BuildDrawView:Draw(type)
    local sid = mIDLis[self.curIndex]
    local draw = function(counsumeType, drawNum)
        self:ChangeBtnSO(false)
        BuildDrawModel:GetInstance():Draw(
            drawNum,
            counsumeType,
            function(msg)
                if msg.ack ~= 1 then
                    self:SetDrawBtnEnabled(true)
                    return
                end
                local item = self.materialItems[self.curIndex]
                item.count = _G.StorageManager:GetInstance():GetItemCountBySid(sid)
                item:ShowCount()
                RedPointManager:GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildBuilding.id)
                RedPointManager:GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildStar.id)
                self:UpdateDrawBtn()
                self:UpdateMaterialRedPoint()
                if self.playType == DrawPlayType.Play and self.isBtnDraw then
                    self:PlayDrawEffect({ award = msg.award })
                else
                    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, { award = msg.award }, nil, true)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DrawAwardView.Name,
                        { award = msg.award },
                        _G.handler(self, self.ClickDrawBtn),
                        true, nil, nil, nil, nil, nil, nil, nil, nil, nil,
                        { ItemCfg[mIDLis[self.curIndex]].Icon, self.drawNum or 10 }
                    )
                    self:SetDrawBtnEnabled(true)
                end
                self:LoadDiamondTimes()
                self:SetNeedCount()
            end
        )
    end

    local num = 0
    local counsumeType = 0
    -- if type == DrawType.one then
    --     counsumeType = 1
    --     num = 1
    -- elseif type == DrawType.rmbTen then
    --     counsumeType = 2
    --     num = 10
    -- elseif type == DrawType.ten then
    --     counsumeType = 1
    --     num = self.midNum > 10 and 10 or self.midNum
    --     num = self.midNum < 1 and 10 or num
    -- elseif type == DrawType.rmbOne then
    --     counsumeType = 2
    --     num = 1
    -- end

    local counsumeType = type == DrawType.one and (self.leftIsDiamond and 2 or 1) or (self.rightIsDiamond and 2 or 1)

    local num = type == DrawType.one and 1 or
        self.rightIsDiamond and 10 or (self.midNum > 0 and (self.midNum <= 10 and self.midNum or 10)) or 10

    if counsumeType == 1 then
        if not _G.StorageManager:GetInstance():CheckItem(sid, num) then
            self:ChangeBtnSO(true)
            self:SetDrawBtnEnabled(true)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, sid)
            return
        end

        draw(counsumeType, num)
    elseif counsumeType == 2 then
        local rmbSid, numNeed = BuildDrawModel:GetInstance():GetDiamondCurrencyByType(num)

        if not _G.StorageManager:GetInstance():CheckItem(rmbSid, numNeed) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, rmbSid, function()
                self:SetDrawBtnEnabled(true)
            end)
            return
        end

        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
            1110101,
            function()
                draw(counsumeType, num)
            end,
            function()
                self:ChangeBtnSO(true)
                self:SetDrawBtnEnabled(true)
            end,
            nil,
            true,
            numNeed,
            num,
            _G.GetLangPackValue(_G.ConfigManager.item_cfg[sid].Name),
            num
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("建筑建造收到未定义建造类型")
            return
        end
    end
end

