        GameUtil.NumberToWordByLanguage(rightIsDiamond and 10 or
            (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)))

    self.drawNum = midNum
    self.go_table.obj_hongDian:SetActiveE(self.midNum >= 10 and 1 or 0)
    -- self.go_table.aortext_Prop3NumDesc.text = _G.GetLangPackValue(90033800021, GameUtil.NumberToWordByLanguage(10))
    -- self.go_table.aortext_Prop3Num.text = rightIsDiamond and num * 10 or
    -- (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)

    self.go_table.aorrawimage_Prop1:LoadImage(
        leftIsDiamond and diamondIcon or mIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_Prop2:LoadImage(
        rightIsDiamond and diamondIcon or mIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_Prop3:LoadImage(
        rightIsDiamond and diamondIcon or mIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    -- self.go_table.aorrawimage_Prop3:LoadImage(
    --     _G.StorageManager:GetInstance():GetItemIcon(sid),
    --     function(image)
    --         if image then
    --             image:SetActiveE(1)
    --         end
    --     end
    -- )
    --endregion

    ---广告按钮
    if require("AdvertisementModel"):GetInstance():CheckADShow(_G.AdvertisementType.BuildDraw) then
        self.go_table.aorbtn_AD:SetActiveE(1)
        local nowTimes = require("AdvertisementModel"):GetInstance():GetADTimes(_G.AdvertisementType.BuildDraw)
        local maxTimes = require("AdvertisementModel"):GetInstance():GetAdMax(_G.AdvertisementType.BuildDraw)
        self.go_table.aortext_AD.text = nowTimes > 1 and _G.GetLangPackValue(90000011734, nowTimes, maxTimes) or
            _G.GetLangPackValue(90000011733)
