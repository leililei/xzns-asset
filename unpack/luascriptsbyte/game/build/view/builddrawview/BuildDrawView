--- 特殊解锁判定
function BuildDrawView:GetSpecial()
    --- 是否解锁衣物遮挡
    self.IsClothSpecial = false
    self.IsMaskSpecial = false

    for i = 1, #self.data.cfg.special do
        if self.data.cfg.special[i][1] <= self.LoveLevel then
            if self.data.cfg.special[i][2] == 6 then
                self.IsMaskSpecial = true
            end
            if self.data.cfg.special[i][2] == 2 then
                self.IsSoundSpecial = true
            end
            if self.data.cfg.special[i][2] == 3 then
                self.IsClothSpecial = true
            end
            if self.data.cfg.special[i][2] == 4 then
                self.IsPlaySpecial = true
            end
            if self.data.cfg.special[i][2] == 5 then
                self.IsTalkSpecial = true
            end
        end
    end
end

function BuildDrawView:ShowWish()
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.LimitedTimePrivilege
        .Choose })
    self.go_table.obj_Privilege:SetActiveE(1)   --(data[1] and 1 or 0)
    self.go_table.obj_noPrivilege:SetActiveE(0) --data[1] and 0 or 1)
    self.go_table.obj_ring1:SetActiveE(1)       --(data[1] and 1 or 0)
    --心愿一直开放
    --[[    if not data[1] then
            return
        end]]
    local wishs = BuildDrawModel:GetInstance():GetWishsids()
    --ZHJH-3048 心愿单数量改为1
    local k = 1
    local v = wishs[1]
    if not self.wishObj[k] then
        self.wishObj[k] = _G.GetAutoGoTable(self.go_table["obj_ring" .. k], _G.handlerbind(self, self.OnClickWishBtn, k))
    end

    if _G.AppSetting.IsXzns then
        self.go_table.aorrawimage_BG:SetActiveE(0)
    end
    if v ~= 0 then
        self.cfg = _G.ConfigManager.manor_build_cfg[v]
        local path = ""
        if self.cfg then
            path = self.cfg.image_1
        end
        self.wishObj[k].aorimage_roleBG.SpriteName = BuildBgColorIconName[self.cfg.Order]
        self.wishObj[k].aorimage_IconFlower.SpriteName = BuildFlowerIconName[self.cfg.Order]
        self.wishObj[k].aorrawimage_role:LoadImage(path)
        self.wishObj[k].aorimage_roleBG:SetActiveE(1)
        self.wishObj[k].aorimage_icon:SetActiveE(1)
        self.wishObj[k].obj_ring:SetActiveE(0)
        self.Ring1AorRawImage.enabled = false
        self.wishObj[k].obj_no:SetActiveE(0)
        self.go_table.aortext_iconName.text = self.cfg and _G.GetLangPackValue(self.cfg.Name) or ""
        if _G.AppSetting.IsXzns then
            self.go_table.aorrawimage_BG:SetActiveE(1)
            self.go_table.aortext_iconName:SetActiveE(0)
            self.go_table.aortext_name.text = self.cfg and _G.GetLangPackValue(self.cfg.Name) or ""

            local childCount = self.go_table.obj_spine:GetChildCountE()
            if childCount > 0 then
                for i = 1, childCount do
                    _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_spine:GetChildE(i - 1), _G.ePoolType.UIItem)
                end
            end
            self.data = BuildDrawModel:GetInstance():GetBuild(v)
            self.loveData = BuildDrawModel:GetInstance():GetBuildLove(v)
            self.LoveLevel = self.loveData.favor_level
            self:GetSpecial()

            _G.PoolsManager:GetInstance():Spawn(
                self.cfg.spine,
                _G.ePoolType.UIItem,
                self.go_table.obj_spine,
                function(trans)
                    if not self.go_table then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.spine = trans
                    if not self.IsMaskSpecial then
                        GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle99, true)
                    else
                        --- 两个都开启播放没衣服的
                        if self.IsMaskSpecial and self.IsClothSpecial then
                            GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle, true)
                        else
                            GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle2, true)
                        end
                    end
                    trans:SetLocalScaleXYZ(self.cfg.coord[2][1])
                    trans:SetLocalPosition(_G.table.unpack(self.cfg.coord[1]))
                end
            )
        end

        local order = self.cfg.Order
        if order == 7 then
            order = 8
        end

        local ctm = require "CommonTipManager":GetInstance()
        ctm:SetItemTextGradient(self.go_table.aortext_iconName, order)
        local isUnlock = BuildDrawModel:GetInstance():GetBuild(v):GetIsActive()
        local IsMaxStar = BuildDrawModel:GetInstance():GetBuild(v):IsMaxStar()

        self.wishObj[k].obj_progress:SetActiveE(not IsMaxStar and isUnlock and 1 or 0)
        self.wishObj[k].obj_maxStar:SetActiveE(IsMaxStar and 1 or 0)
        self.wishObj[k].aortext_star.text = _G.GetLangPackValue(90000010475,
            BuildDrawModel:GetInstance():GetBuild(v):GetStar())

        local count = BuildDrawModel:GetInstance():GetBuild(v):GetItemCount()
        local needCount = BuildDrawModel:GetInstance():GetBuild(v):GetUpCostNum()
        self.wishObj[k].aortext_progress.text = count .. "/" .. needCount

        if needCount <= count then
            self.wishObj[k].aorimage_activeSchedule:SetLocalScale(1, 1, 1)
        else
            self.wishObj[k].aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
        end
    else
        self.wishObj[k].aorimage_roleBG:SetActiveE(0)
        self.wishObj[k].aorimage_icon:SetActiveE(0)
        self.wishObj[k].obj_progress:SetActiveE(0)
        self.wishObj[k].obj_maxStar:SetActiveE(0)
        self.wishObj[k].obj_ring:SetActiveE(1)
        self.Ring1AorRawImage.enabled = false
        self.wishObj[k].obj_no:SetActiveE(1)
    end
    self.wishObj[k].aorrawimage_role:SetNativeSize()



    if _G.AppSetting.IsXzns then
        if not self.InitEffectObj then
            self:InitEffect()
            self.InitEffectObj = true
        end
    else
        if not self.InitEffectObj then
            self:InitEffect()
            self.InitEffectObj = true
        end
    end
end

