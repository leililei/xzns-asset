---@param DefaultIndex number 默认选中页签
function BuildDrawView:OnCreate(DefaultIndex)
    self.materialItems = {}
    self.index = DefaultIndex or 1
    self.Ring1AorRawImage = self.go_table.obj_ring1:GetComponentE(_G.typeof(_G.CS.AorRawImage))
    ---@type BaseAwardNewItem
