---@param cfgId number
---@return number,number        兑换ID和数量
local function getExchangeCurrency(cfgId)
    local cfg = _G.ConfigManager.exchange_cfg[cfgId]
    if not cfg or not cfg.need_item or #cfg.need_item < 1 then
        return 0, 0
    end
    return table.unpack(cfg.need_item[1])
end

