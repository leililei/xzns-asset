        self.afkGiftTimer:Stop()
        self.afkGiftTimer = nil
    end
end

function BuildDrawView:InstructionIS()
    self.go_table.obj_Tip:SetActiveE(self.Privileged)
    if self.Privileged == 1 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        local _, time = MonthlyModel:GetInstance():IsHavePrivi(405002)
        self.PrivilegEnd = time
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime(0)
    elseif self.Privileged == 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
end

function BuildDrawView:UpdateTime(fix)
    local time = self.PrivilegEnd - fix
    self.go_table.aortext_instruction.text = _G.GetLangPackValue(90028900002,
        _G.TimeUtil.TranslateSecondForStrMiaoHui(time))
end

