---@class BuildUpToggleGroupView : UIBaseView 下边栏菜单
---@field go_table BuildUpToggleGroupView_GoTable
---@field toggles table<string,BuildUpToggleGroupView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local BuildUpToggleGroupView = _G.BaseClass("BuildUpToggleGroupView", _G.UIBaseView)

function BuildUpToggleGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eBuildUpStar.BuildUpStarRefresh, self.RefreshToggle)
    self:AddListener(_G.eBuildUpLevel.BuildUpLevelRefresh, self.RefreshToggle)
    self:AddListener(_G.eBuildUpLove.BuildUpLoveRefresh, self.RefreshToggle)
    self:AddListener(_G.eBuildCurID.BuildIDRefresh, self.RefreshID)
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function BuildUpToggleGroupView:OnCreate(toggleIndex, id)
    self.id =
        id or (toggleIndex == 1 and require("BuildDrawModel"):GetInstance():GetCanActiveBuild()) or
        (toggleIndex == 2 and require("BuildDrawModel"):GetInstance():GetCanLevelUpBuild())

    ---@type string
    local key
    if not toggleIndex then
        key = "starUp"
    elseif type(toggleIndex) == "string" then
        key = toggleIndex
    elseif toggleIndex == 1 then
        key = "starUp"
    elseif toggleIndex == 2 then
        key = "levelUp"
        if require("BuildDrawModel"):GetInstance():GetCanLevelUpBuild() == 0 then
            key = "starUp"
            self.id = require("BuildDrawModel"):GetInstance():GetCanActiveBuild()
        end
    elseif toggleIndex == 3 then
        key = "love"
    end
    self:InitToggles()
    self:RefreshToggle()
    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_starUp
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function BuildUpToggleGroupView:RefreshID(id, type)
    self.id = id
    self:RefreshToggle(type)
end

function BuildUpToggleGroupView:RefreshToggle(type)
    self:InitTogglesFunctionUnlock(type)
    local tbStar = self.toggles.starUp
    local tbLevel = self.toggles.levelUp
    local tblove = self.toggles.love
    local buildData = require("BuildDrawModel"):GetInstance():GetBuild(self.id)
    local canLevelUp = require("BuildDrawModel"):GetInstance():CanLevelUp(buildData)
    local canStarUp = require("BuildDrawModel"):GetInstance():CanStarUp(buildData)
    local canLoveUp = require("BuildDrawModel"):GetInstance():CanLoveUp(buildData)

    if self.isActive then
        tbLevel.obj_redpoint:SetActiveE(canLevelUp and 1 or 0)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildLvup.id)
    else
        tbLevel.obj_redpoint:SetActiveE(0)
    end
    tbStar.obj_redpoint:SetActiveE(canStarUp and 1 or 0)
    tblove.obj_redpoint:SetActiveE(canLoveUp and 1 or 0)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildStar.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildLoveUp.id)
    
    -- self.go_table.toggle_starUp.isOn = true
end

function BuildUpToggleGroupView:OnDestroy()
    self:RemoveListener(_G.eBuildUpLevel.BuildUpLevelRefresh, self.RefreshToggle)
    self:RemoveListener(_G.eBuildUpStar.BuildUpStarRefresh, self.RefreshToggle)
    self:RemoveListener(_G.eBuildUpLove.BuildUpLoveRefresh, self.RefreshToggle)
    self:RemoveListener(_G.eBuildCurID.BuildIDRefresh, self.RefreshID)
end

function BuildUpToggleGroupView:InitToggles()
    self.views = {}

    self.toggles = {
        starUp = _G.GetAutoGoTable(
            self.go_table.toggle_starUp,
            _G.handlerbind(self, self.OnClickToggle, "starUp", _G.handler(self, self.OnBuild))
        ),
        levelUp = _G.GetAutoGoTable(
            self.go_table.toggle_levelUp,
            _G.handlerbind(self, self.OnClickToggle, "levelUp", _G.handler(self, self.OnLevelUp))
        ),
        love = _G.GetAutoGoTable(
            self.go_table.toggle_love,
            _G.handlerbind(self, self.OnClickToggle, "love", _G.handler(self, self.OnLoveUp))
        ),
    }
end

function BuildUpToggleGroupView:InitTogglesFunctionUnlock(type)
    local buildData = require("BuildDrawModel"):GetInstance():GetBuild(self.id)
    self.isActive = buildData:GetIsActive()
    if not self.isActive then
        self.toggles["levelUp"].gameObject:SetActiveE(0)
    else
        self.toggles["levelUp"].gameObject:SetActiveE(1)
        self.toggles["love"].gameObject:SetActiveE(1)
        self.toggles["starUp"].gameObject:SetActiveE(1)
    end

    if type then
        local tog = self.go_table["toggle_" .. type]
        tog.isOn = true
    end
end

---监听Toggle点击事件
---@param key string
---@param callback function
function BuildUpToggleGroupView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function BuildUpToggleGroupView:OnBuild()
    local view = self.views.starUp
    if not view then
        self.views.starUp = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BuildAttributeView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildAttributeView.Name, self.id)
    elseif view ~= 0 then
        view:UpdateView(self.id)
    end
end

function BuildUpToggleGroupView:OnLevelUp()
    local view = self.views.levelUp
    if not view then
        self.views.levelUp = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BuildLevelUpView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildLevelUpView.Name, self.id)
    elseif view ~= 0 then
        view:UpdateView(self.id)
    end
end

function BuildUpToggleGroupView:OnLoveUp()
    local view = self.views.love
    if not view then
        self.views.love = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BuildLoveView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildLoveView.Name, self.id)
    elseif view ~= 0 then
        view:UpdateView(self.id)
    end
end

---加载升星界面
function BuildUpToggleGroupView:OnUIOpened(name)
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.BuildAttributeView.Name then
        key = "starUp"
    elseif name == _G.ConfigManager.ui_cfg.BuildLevelUpView.Name then
        key = "levelUp"
    elseif name == _G.ConfigManager.ui_cfg.BuildLoveView.Name then
        key = "love"
    end
    if not key then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    if view.go_table and view.go_table.obj_close then
        view.go_table.obj_close:SetActiveE(0)
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views[key] = view
    if self.curToggle ~= key then
        view:Hide()
    end
end

---按钮点击事件在这里派发
function BuildUpToggleGroupView:Close()
    self.super.Close(self)
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            view:Close()
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function BuildUpToggleGroupView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return BuildUpToggleGroupView
