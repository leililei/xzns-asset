function BuildMainView:Awake()
    self:AddListener(_G.eBuildUpStar.BuildUpStarRefresh, self.InitBuild)
    self:AddListener(_G.eBuildUpFetter.BuildUpFetterRefresh, self.InitBuild)
    self:AddListener(_G.eBuildDecompose.BuildDecomposeRefresh, self.InitBuild)
    self:AddListener(_G.eBuildUpLevel.BuildUpLevelRefresh, self.InitBuild)
    self:AddListener(_G.eBuildUpLove.BuildUpLoveRefresh, self.InitBuild)
    self:AddListener(_G.eItemUpdata.Updata, self.InitBuild)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param DefaultIndex number 默认选中页签
function BuildMainView:OnCreate(DefaultIndex)
    self.buildcfg = _G.ConfigManager.manor_build_cfg
    if _G.AppSetting.IsXzns then
        local res = _G.ConfigManager.ui_cfg.BuildMainView.resources
        self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))

        --显示玩家信息
        -- self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_BuildMainViewl_bg,
                self.go_table.aorrawimage_Bg,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                end
            )
    end

    self:InitBuild()
end

function BuildMainView:InitBuild()
    self.buildData = {}
    local index = 0
    for k, cfg in pairs(self.buildcfg) do
        local data = {}
        index = index + 1
        data.tb = _G.GetAutoGoTable(self.go_table["obj_build" .. index], _G.handlerbind(self, self.OnClickBuild, cfg))
        data.cfg = cfg
        data.item = self.go_table["obj_build" .. index]
        data.class = require("BuildDrawModel"):GetInstance():GetBuild(cfg.id)

        table.insert(self.buildData, data)
    end
    self:UpdateView()
end

--- 建筑按钮点击事件
function BuildMainView:OnClickBuild(go, isOn, cfg)
    -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildAttributeView.Name, cfg.id)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildUpToggleGroupView.Name, nil, cfg.id)
end

function BuildMainView:UpdateView()
    self:UpdateBuild()
end

function BuildMainView:UpdateBuild()
    for _, data in pairs(self.buildData) do
        local isUnLock = data.class:GetIsActive()
        data.tb.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
        if data.class:IsMaxStar() then
            data.tb.aortext_slider.text = _G.GetLangPackValue(90022300065)
            data.tb.aorimage_slider.fillAmount = 1
        else
            local starMax = data.cfg.Star
            data.tb.aortext_slider.text = data.class:GetItemCount() .. "/" .. data.class:GetUpCostNum()
            data.tb.aorimage_slider.fillAmount = data.class:GetItemCount() / data.class:GetUpCostNum()
        end


        data.tb.aorimage_professionalIcon.SpriteName = Professional[data.cfg.professional]
        data.tb.aorimage_professionalIcon:SetActiveE(data.cfg.professional == 0 and 0 or 1)

        -- data.tb.aorrawimage_icon:SetGray(not isUnLock)
        -- data.tb.aorrawimage_icon:LoadImage(
        --     data.cfg.image_1,
        --     function(trans)
        --         if not self.go_table then
        --             _G.DestroyObject(trans)
        --             return
        --         end
        --         local pos1 = data.cfg.coordinate_icon

        --         if #pos1 == 3 then
        --             trans:SetLocalPosition(pos1[1], pos1[2], pos1[3])
        --         end
        --         trans:SetNativeSize()
        --     end)
        local pos = data.cfg.coordinate

        data.tb.aorrawimage_Head:LoadImage(
            data.cfg.Icon_1,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
             
            end)

        if _G.AppSetting.IsXzns then
            data.tb.aorimage_bg.SpriteName = BuildBgColorIconNameXZNS[data.class:GetOrder()]
        else
            data.tb.aorimage_LvBg.SpriteName = BuildBgColorIconName[data.class:GetOrder()]
            data.tb.aorimage_bg.SpriteName = BuildBgColorIconName2[data.class:GetOrder()]
        end

        if data.class:GetOrder() >= 7 and data.tb.obj_Effect2:GetChildCountE() <= 0 then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_BuildMainView_anniu,
                data.tb.obj_Effect2,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                end
            )
        end
        if data.tb.obj_Effect:GetChildCountE() <= 0 then
            -- _G.UIUtils.LoadEffectByCfg(
            --     _G.ConfigManager.ui_effect_cfg[data.cfg.bulid_effect],
            --     data.tb.obj_Effect,
            --     function(trans)
            --         if self:IsNil() then
            --             _G.DestroyObject(trans)
            --         end
            --     end
            -- )
        end

        if isUnLock then
            data.tb.aorimage_stardi:SetActiveE(1)
            for i = 1, 5 do
                if data.class.star <= 5 then
                    if data.class.star >= i then
                        data.tb["aorimage_star_" .. i]:SetActiveE(1)
                        data.tb["aorimage_star_" .. i].SpriteName = "ui_img_xing"
                    else
                        data.tb["aorimage_star_" .. i]:SetActiveE(0)
                    end
                elseif data.class.star > 5 then
                    if data.class.star >= i + 5 then
                        data.tb["aorimage_star_" .. i]:SetActiveE(1)
                        data.tb["aorimage_star_" .. i].SpriteName = "ui_img_xing_hong"
                    elseif data.class.star < i + 5 then
                        data.tb["aorimage_star_" .. i]:SetActiveE(1)
                        data.tb["aorimage_star_" .. i].SpriteName = "ui_img_xing"
                    end
                end
            end
        else
            data.tb.aorimage_stardi:SetActiveE(0)
        end


        if #pos == 3 then
            data.item:SetLocalPosition(pos[1], pos[2], pos[3])
        end
        if isUnLock then
            data.tb.obj_start:SetActiveE(1)
            data.tb.aorimage_stardi:SetActiveE(data.class.star > 0 and 1 or 0)
            for i = 1, 5 do
                if data.class.star <= 5 then
                    if data.class.star >= i then
                        data.tb["aorimage_star_" .. i]:SetActiveE(1)
                        data.tb["aorimage_star_" .. i].SpriteName = "ui_img_xing"
                    else
                        data.tb["aorimage_star_" .. i]:SetActiveE(0)
                    end
                elseif data.class.star > 5 then
                    if data.class.star >= i + 5 then
                        data.tb["aorimage_star_" .. i]:SetActiveE(1)
                        data.tb["aorimage_star_" .. i].SpriteName = "ui_img_xing_hong"
                    elseif data.class.star < i + 5 then
                        data.tb["aorimage_star_" .. i]:SetActiveE(1)
                        data.tb["aorimage_star_" .. i].SpriteName = "ui_img_xing"
                    end
                end
            end
        else
            data.tb.obj_start:SetActiveE(0)
            data.tb.aorimage_stardi:SetActiveE(0)
        end
        data.tb.aorimage_lock:SetActiveE(isUnLock and 0 or 1)
        data.tb.aorimage_LvBg:SetActiveE(isUnLock and 1 or 0)
        -- data.tb.aorimage_LvBg:SetGray(not isUnLock)
        data.tb.aortext_Lv.text = _G.GetLangPackValue(32001170403, data.class:GetLevel())
        -- data.tb.aorimage_bg:SetGray(not isUnLock)

        if require("BuildDrawModel"):GetInstance():CanLevelUp(data.class) then
            data.tb.obj_redpoint:SetActiveE(1)
        elseif require("BuildDrawModel"):GetInstance():CanStarUp(data.class) then
            data.tb.obj_redpoint:SetActiveE(1)
        elseif require("BuildDrawModel"):GetInstance():CanLoveUp(data.class) then
            data.tb.obj_redpoint:SetActiveE(1)
        else
            data.tb.obj_redpoint:SetActiveE(0)
        end

        -- data.tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.BuildLvup.id, data.cfg.id)
    end
end

