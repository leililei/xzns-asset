---界面的销毁函数
function BuildMainView:OnDestroy()
    self:RemoveListener(_G.eBuildUpStar.BuildUpStarRefresh, self.InitBuild)
    self:RemoveListener(_G.eBuildUpFetter.BuildUpFetterRefresh, self.InitBuild)
    self:RemoveListener(_G.eBuildUpLevel.BuildUpLevelRefresh, self.InitBuild)
    self:RemoveListener(_G.eBuildUpLove.BuildUpLoveRefresh, self.InitBuild)
    self:RemoveListener(_G.eBuildDecompose.BuildDecomposeRefresh, self.InitBuild)
end

