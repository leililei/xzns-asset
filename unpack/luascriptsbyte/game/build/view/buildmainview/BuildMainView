end

---按钮点击事件在这里派发
function BuildMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_decompose then
        self:OnClickEquipmentDecompose()
    elseif go == self.go_table.aorbtn_attribute  then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrBuildPanel.Name)
    end
end

function BuildMainView:OnClickEquipmentDecompose()
    local params = {}
    params.titleText = 90033800047
    params.DeComposeCall = function()

    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeView.Name, _G.StorageID.Build, params)
end

return BuildMainView
