---展示属性
function BuildAttributeView:ShowPropByCfg()
    ---@type AttributeClass
    local attribute=self.data:GetAttributeDict(not self.data:GetIsActive(), true)
    local attrDic = attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)

    local index
    local go = _G.GetAutoGoTable(self.go_table.obj_PropContent)
    for k, v in pairs(attrDic) do
        index = propIndex[k]
        go["aortext_num" .. index].text = v
    end
    local go2 = _G.GetAutoGoTable(self.go_table.obj_PropContent2)
    local go3 = _G.GetAutoGoTable(self.go_table.obj_PropContent3)
    local num,numStr
    for k, v in pairs(Percentattr) do
        index = propIndex[k]
        num =  v * 100
        num = _G.GameUtil.FormatNum(num)
        numStr = tostring(num) .. "%"
        go = index > 2 and go3 or go2
        go["aortext_num" .. index].text = numStr
        go["aortext_name" .. index].text = _G.AttrType[k].des
    end
end

---展示技能
function BuildAttributeView:ShowSkill()
    local baseSkillCfg = _G.ConfigManager.attribute_cfg[self.data.cfg.skill_id[1]]
    local skillCfg = _G.ConfigManager.card_skills_cfg[baseSkillCfg.skill]
    self.go_table.aorrawimage_skill:LoadImage(skillCfg.icon)
    self.go_table.aortext_petSkillName.text = _G.GetLangPackValue(skillCfg.name1)
    local skillDesExText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    local maxStar = #self.data.cfg.skill_id
    local des = ""
    if self.isPreview then
        for i = 1, maxStar do
            local Cfg = _G.ConfigManager.attribute_cfg[self.data.cfg.skill_id[i]]

            local LanID = Cfg.describe
            if LanID == 0 then
                LanID = _G.ConfigManager.card_skills_cfg[Cfg.skill].describe1
            end

            if _G.AppSetting.IsXzns then
                des = des .. "<color=#f59f3a>" .. _G.GetLangPackValue(90000010475, i - 1) .. ":</color>"
                    .. _G.GetLangPackValue(LanID)
            else
                des = des .. "<color=#ff912c>" .. _G.GetLangPackValue(90000010475, i - 1) .. ":</color>"
                    .. _G.GetLangPackValue(LanID)
            end

            if i < maxStar then
                des = des .. "\n"
            end
        end
    else
        for i = 1, maxStar do
            local Cfg = _G.ConfigManager.attribute_cfg[self.data.cfg.skill_id[i]]

            local LanID = Cfg.describe
            if LanID == 0 then
                LanID = _G.ConfigManager.card_skills_cfg[Cfg.skill].describe1
            end

            local colorStr = (self.data:GetStar() + 1) >= i and "<color=#76DAF8>" or "<color=#B1A589>"

            if _G.AppSetting.IsXzns then
                colorStr = (self.data:GetStar() + 1) >= i and "<color=#7caaf1>" or "<color=#a19896>"
            end
            des = des .. "<color=#ff912c>" .. _G.GetLangPackValue(90000010475, i - 1) .. ":</color>"
                .. colorStr .. _G.GetLangPackValue(LanID) .. "</color>"
            if i < maxStar then
                des = des .. "\n"
            end
        end
    end
    skillDesExText.text = des

    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
end

function BuildAttributeView:ShowSkillTag()
    local lanID, obj, tb
    for i = 1, self.go_table.obj_skillTagContent:GetChildCountE() do
        self.go_table.obj_skillTagContent:GetChildE(i - 1):SetActiveE(0)
    end
    for i = 1, 3 do
        lanID = self.data.cfg["pet_position" .. i]
        if lanID and lanID > 0 then
            if self.go_table.obj_skillTagContent:GetChildCountE() <= i then
                obj = _G.InstantiateObject(self.go_table.obj_skillTagItem, self.go_table.obj_skillTagContent)
            else
                obj = self.go_table.obj_skillTagContent:GetChildE(i)
            end
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            --tb.aorimage_bg.SpriteName = i == 1 and "ui_js_biaoqian_jnleixing" or "ui_js_biaoqian_zhanwei"
            tb.aortext_tagName.text = _G.GetLangPackValue(lanID)
        end
    end
end

