function BuildAttributeView:FreshStar()
    self.go_table.aorimage_professionalIcon.SpriteName = _G.ProfessionalIcon[self.data.cfg.professional]
    if not self.data:GetIsActive() then
        self.go_table.obj_stars:SetActiveE(0)
        self.go_table.aortext_Level:SetActiveE(0)
        return
    end
    self.go_table.obj_stars:SetActiveE(1)
    self.go_table.aortext_Level:SetActiveE(1)

    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(self.data.cfg.Order))
    if _G.AppSetting.IsXzns then
    else
        ctm:SetItemTextGradient(self.go_table.aortext_name, self.data.cfg.Order)
    end
    self.go_table.aortext_name:SetActiveE(0)
    self.go_table.aortext_name:SetActiveE(1)
