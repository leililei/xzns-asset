function BuildAttributeView:ChangeShowBuild(isNext)
    if isNext then
        self.buildIndex = self.buildIndex + 1
    else
        self.buildIndex = self.buildIndex - 1
    end
    local data = self.buildIList[self.buildIndex]
    _G.Events:GetInstance():Broadcast(_G.eBuildCurID.BuildIDRefresh, data.sid, "starUp")

    if self.go_table.obj_pet:GetChildCountE() > 1 then
        _G.DestroyObject(self.go_table.obj_pet:GetChildE(0))
    end
    self.data = data
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(data.sid)
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level
    self:GetSpecial()
    self:ShowBuild(data)
end

---界面的销毁函数
function BuildAttributeView:OnDestroy()
    self.IsPlay = false
    self:RemoveListener(_G.ePetUpStar.BuildDrawWishRefresh, self.BuildDrawWishRefresh, self)
    self:RemoveListener(_G.ePetUpStar.BuildUpStarRefresh, self.BuildDrawWishRefresh, self)
end

return BuildAttributeView
