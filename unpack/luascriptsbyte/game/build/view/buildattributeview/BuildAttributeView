    self.go_table.aortext_Level.text = _G.LangUtil.GetLangPackValue(32001170403, self.data:GetLevel())

    self.go_table.aorimage_professionalIcon:SetActiveE(self.data.cfg.professional == 0 and 0 or 1)
    local star = self.data:GetStar()

    for i = 1, 5 do
        self.go_table["aorimage_star" .. i].SpriteName = "ui_ty_kapaipinjie_1"
        self.go_table["aorimage_starMask" .. i]:SetActiveE(star >= i and 0 or 1)
    end
    if star - 5 > 0 then
        for i = 1, star - 5 do
            self.go_table["aorimage_star" .. i].SpriteName = "ui_img_xing_hong"
        end
    end
end

