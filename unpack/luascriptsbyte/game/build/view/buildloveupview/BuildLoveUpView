local BuildDrawModel = require "BuildDrawModel"

local base = require "EventViewBase"
---@class BuildLoveUpView : UIBaseView    建筑好感度提示
---@field public go_table BuildLoveUpView_GoTable GoTable
local BuildLoveUpView = _G.BaseClass("BuildLoveUpView", base)

function BuildLoveUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BuildLoveUpView:OnCreate(sid, callBack)
    ---@type BuildData
    self.data = BuildDrawModel:GetInstance():GetBuild(sid)
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(sid)
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level + 1
    self.callBack = callBack


    if self.LoveLevel == 1 then
        self.go_table.aortext_curLevel.text = _G.LangUtil.GetLangPackValue(90033800099)
    else
        self.go_table.aortext_curLevel.text = self.LoveLevel -1
    end

        UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.BuildUpToggleGroupView_effect_1,
        self.go_table.obj_Eff,
        function(obj)
            if self:IsNil() then
                UIUtils.RemoveEffect(obj)
                return
            end
        end
    )

    --- 是否解锁衣物遮挡
    self.IsClothSpecial = false
    self:GetSpecial()

    self:InitbgCanvasSortingOrder()
    self:ShowBuild()
end

--- 特殊解锁判定
function BuildLoveUpView:GetSpecial()
    for i = 1, #self.data.cfg.special do
        if self.data.cfg.special[i][2] < self.LoveLevel then
            if self.data.cfg.special[i][1] == 1 then
                self.IsMaskSpecial = true
                -- self.go_table.obj_Effect:SetActiveE(0)
            end
            if self.data.cfg.special[i][1] == 2 then
                self.IsSoundSpecial = true
            end
            if self.data.cfg.special[i][1] == 3 then
                self.IsClothSpecial = true
            end
            if self.data.cfg.special[i][1] == 4 then
                self.IsPlaySpecial = true
            end
            if self.data.cfg.special[i][1] == 5 then
                self.IsTalkSpecial = true
            end
        end
    end
end

