function BuildLoveView:SliderExp()
    self.go_table.aortext_SliderExp.text = ""
    self.go_table.aortext_SliderExp2.text = ""
    if self.loveData.favor_level < #self.data.cfg.love then
        self.go_table.aortext_SliderExp.text = self.clickIndex .. "/" .. self.data.cfg.love[self.LoveLevel + 1]
        if self.SelectIndex ~= 0 then
            local cfg = _G.ConfigManager.item_cfg[self.data.cfg.hgd[self.SelectIndex]]
            local expNum = cfg.UseParameter[1][1]
            self.go_table.aortext_SliderExp2.text = "(+" .. expNum .. ")"
        end
    end
end

function BuildLoveView:RefreshBuildView()
    for k, v in pairs(self.buildIList) do
        if v.sid == sid then
            self.buildIndex = k
        end
    end
end

---切换建筑展示
---@param isNext boolean 切换下一个建筑
function BuildLoveView:ChangeShowBuild(isNext)
    if isNext then
        self.buildIndex = self.buildIndex + 1
    else
        self.buildIndex = self.buildIndex - 1
    end
    local data = self.buildIList[self.buildIndex]
    _G.Events:GetInstance():Broadcast(_G.eBuildCurID.BuildIDRefresh, data.sid, "love")
    self.Sid = data.sid
    self.data = BuildDrawModel:GetInstance():GetBuild(self.Sid)
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(data.sid)
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level
    self:RefreshView()
end

---按钮点击事件在这里派发
function BuildLoveView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help or go == self.go_table.aorbtn_help2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildLoveShowView.Name, self.Sid)
    elseif go == self.go_table.aorbtn_right then
        self.ChangeIndex = 0
        self:ChangeShowBuild(true)
    elseif go == self.go_table.aorbtn_left then
        self.ChangeIndex = 0
        self:ChangeShowBuild(false)
    elseif go == self.go_table.aorbtn_SpineClick then
        if self.IsPlaySpecial then
            local animName = self.data.cfg.display_show

            local sg = self.spine:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.AnimationState:SetAnimation(0, animName, false)

            if not self.IsMaskSpecial then
                sg.AnimationState:AddAnimation(0, self.data.cfg.display_idle99, true, 0)
            else
                --- 两个都开启播放没衣服的
                if self.IsMaskSpecial and self.IsClothSpecial then
                    sg.AnimationState:AddAnimation(0, self.data.cfg.display_idle, true, 0)
                else
                    sg.AnimationState:AddAnimation(0, self.data.cfg.display_idle2, true, 0)
                end
            end
        end
        self:PlayClickSound()
    elseif go == self.go_table.aorbtn_OneGift then
        if self.isMax then
            _G.PopWindowManager:GetInstance():ShowAllTips(1110202)
            return
        end


        if self.SelectIndex ~= 0 then
            local list = { { key = self.data.cfg.hgd[self.SelectIndex], value = 1 } }
            local level, exp = self:GetExpAndLevel(list)
            BuildDrawModel:GetInstance():UseBuildLoveItem(self.Sid,
                list,
                function(msg)
                    if level > self.LoveLevel then
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.CommonAwardView.Name, { award = msg.re_award })
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildLoveUpView.Name, self.Sid,
                            function()
                                self:SetLoveData(level, exp)
                            end
                        )
                    else
                        self:SetLoveData(level, exp + self.clickIndex)
                    end
                end)
        else
            if BuildDrawModel:GetInstance():CanLoveUp(self.data) then
                _G.PopWindowManager:GetInstance():ShowAllTips(1110203)
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 202186001)
            end
        end
        -- 一键赠送
    elseif go == self.go_table.aorbtn_AllGift then
        if self.isMax then
            _G.PopWindowManager:GetInstance():ShowAllTips(1110202)
            return
        end

        if not BuildDrawModel:GetInstance():CanLoveUp(self.data) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 202186001)
        end
        local list = self:GetUpOneLevelItem()

        if #list <= 0 then
            return
        end
        local level, exp = self:GetExpAndLevel(list)

        BuildDrawModel:GetInstance():UseBuildLoveItem(self.Sid,
            list,
            function(msg)
                if level > self.LoveLevel then
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CommonAwardView.Name, { award = msg.re_award })

                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildLoveUpView.Name, self.Sid,
                        function()
                            self:SetLoveData(level, exp)
                        end
                    )
                else
                    self:SetLoveData(level, exp + self.clickIndex)
                end
            end)
    elseif go == self.go_table.aorbtn_Hide then
        if self.go_table.obj_panel:GetActiveSelf() == 1 then
            self.go_table.obj_panel:SetActiveE(0)
        else
            self.go_table.obj_panel:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrBuildPanel.Name)
    end
end

function BuildLoveView:SetLoveData(level, exp)
    BuildDrawModel:GetInstance():SetBuildLove(self.Sid, {
        sid = self.Sid,
        favor_level = level,
        click_value = exp,
    })
    self.LoveLevel = level
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(self.Sid)

    self.clickIndex = exp

    self:RefreshView()
end

function BuildLoveView:GetUpOneLevelItem()
    local level = self.LoveLevel
    local exp = self.clickIndex
    --- 需要的经验值
    local neepExp = self.data.cfg.love[level + 1] - exp
    local itemList = {}
    for i = #self.data.cfg.hgd, 1, -1 do
        local sid = self.data.cfg.hgd[i]
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)
        --- 当前拥有的经验道具数量
        local itemCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, sid)
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, sid)
        if itemData then
            --- 道具给的经验
            local itemExp = tonumber(itemData.cfg.UseParameter[1][1])
            --- 实际可以使用的道具数量
            local needCount = 0
            --- 如果道具经验已经大于差的经验了 直接返回
            if itemExp >= neepExp then
                table.insert(itemList, { key = sid, value = 1 })
                break
            else
                --- 如果可以使用的经验道具总值大于需要的经验 返回
                if math.ceil(neepExp / itemExp) <= itemCount then
                    needCount = math.ceil(neepExp / itemExp)
                    table.insert(itemList, { key = sid, value = needCount })
                    break
                else
                    needCount = itemCount
                    table.insert(itemList, { key = sid, value = needCount })
                    neepExp = neepExp - itemExp * needCount
                end
            end
        end
    end

    return itemList
end

function BuildLoveView:GetExpAndLevel(args)
    local level = self.LoveLevel
    local exp = self.clickIndex
    local neepExp = self.data.cfg.love[level + 1] - exp
    local useExp = 0
    for i = 1, #args do
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, args[i].key)
        --- 道具给的经验
        local itemExp = tonumber(itemData.cfg.UseParameter[1][1])
        useExp = useExp + itemExp * args[i].value

        if useExp >= neepExp then
            level = level + 1
            local nextExp = self.data.cfg.love[self.LoveLevel + 1] + (itemExp - neepExp)
            useExp = useExp - neepExp
            neepExp = nextExp
        end
    end
    return level, useExp
end

---界面的销毁函数
function BuildLoveView:OnDestroy()
    self.IsPlay = false
    self:RemoveListener(_G.ePetUpStar.BuildUpLevelRefresh, self.BuildDrawWishRefresh, self)
end

return BuildLoveView
