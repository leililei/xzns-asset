local BuildDrawModel = require "BuildDrawModel"

local base = require "EventViewBase"
---@class BuildLoveView : UIBaseView	建筑好感度
---@field public go_table BuildLoveView_GoTable GoTable
local BuildLoveView = _G.BaseClass("BuildLoveView", base)


function BuildLoveView:Awake()
    self.PropListObj = {}
    self.SelectIndex = 0
    self.IsPlay = false
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function BuildLoveView:OnEnable()

end

---界面的入口函数
function BuildLoveView:OnCreate(sid)
    local res = _G.ConfigManager.ui_cfg.BuildLoveView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self:AddListener(_G.eBuildUpStar.BuildUpStarRefresh, self.RefreshBuildView, self)
    self.buildIList = BuildDrawModel:GetInstance():GetAllBuild()

    for k, v in pairs(self.buildIList) do
        if v.sid == sid then
            self.buildIndex = k
        end
    end

    --- 当前人物点击播放动画的次数
    self.clickIndex = 0
    --- 当前好感度等级
    self.LoveLevel = 0


    --- 气泡播放下标
    self.TalkIndex = 0
    --- 点击语音组
    self.TalkSoundList = {}

    self.Sid = sid
    self.data = BuildDrawModel:GetInstance():GetBuild(self.Sid)
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(self.Sid)
    --- 当前经验
    self.clickIndex = self.loveData.click_value
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level


    UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.BuildUpToggleGroupView_effect,
        self.go_table.obj_Eff,
        function(obj)
            if self:IsNil() then
                UIUtils.RemoveEffect(obj)
                return
            end
        end
    )

    self:RefreshView()

    --- 对话气泡 一直循环调用
    self:ShowTalkPop()

    self:InitSound()
    self:InitClickSound()
end

function BuildLoveView:RefreshView()
    if self.buildIndex ~= nil then
        self.go_table.aorbtn_left:SetActiveE(self.buildIndex > 1 and 1 or 0)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if self.buildIndex ~= nil then
        self.go_table.aorbtn_right:SetActiveE(self.buildIndex ~= table.count(self.buildIList) and 1 or 0)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end

    self.data = BuildDrawModel:GetInstance():GetBuild(self.Sid)
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(self.Sid)
    self:GetSpecial()
    self:ShowBuild()
    ---礼包商品item
    local count = table.count(self.data.cfg.hgd)
    self.PropListObj = {}
    if not self.itemListView then
        self.go_table.scrollloophorizontal_item:InitItemData(count, _G.handler(self, self.RefreshItem))
        self.itemListView = self.go_table.scrollloophorizontal_item
    else
        self.itemListView:UpdateCount(count)
    end
    self.go_table.aorbtn_OneGift:SetGray(false)
    self.go_table.aorbtn_AllGift:SetGray(false)

    if self.isMax then
        self.go_table.aorbtn_OneGift:SetGray(true)
        self.go_table.aorbtn_AllGift:SetGray(true)
    end
    local pos = self.data.cfg.lines_py
    self.go_table.aorimage_Talk:SetLocalPosition(pos[1], pos[2], pos[3])
    _G.Events:GetInstance():Broadcast(_G.eBuildUpLove.BuildUpLoveRefresh)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildLoveUp.id)
end

function BuildLoveView:RefreshItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local curIndex = index + 1
    tb.obj_root:ClearChildren()
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(self.data.cfg.hgd[curIndex])
    local itemCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, self.data.cfg.hgd[curIndex])
    tb.aorimage_select:SetActiveE(self.SelectIndex == curIndex and 1 or 0)

    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { self.data.cfg.hgd[curIndex], itemCount },
        tb.obj_root,
        function(tran)
            if _G.IsNil(tb.obj_root) then
                _G.DestroyObject(tran.gameObject)
                return
            end
            tran.gameObject:SetLocalScaleXYZ(0.8)
            if itemCount ~= 0 then
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            tb.aorimage_Mask:SetActiveE(itemCount == 0 and 1 or 0)

            if self.SelectIndex == curIndex then
                if itemCount == 0 then
                    self.SelectIndex = 0
                    tb.aorimage_select:SetActiveE(1)
                end
            end

            tran:SetGray(itemCount == 0)
            table.insert(self.PropListObj, tb)
        end,
        function(go, isOn)
            if itemCount == 0 then
                -- self.SelectIndex = 0
                local cfg = _G.ConfigManager.item_cfg[self.data.cfg.hgd[curIndex]]

                require "CommonTipManager":GetInstance():OpenTip(go.gameObject, self.data.cfg.hgd[curIndex])

                return
            end

            for i = 1, #self.PropListObj do
                self.PropListObj[i].aorimage_select:SetActiveE(curIndex == i and 1 or 0)
            end
            self.SelectIndex = curIndex
            -- require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.type[1])
            self:DeepBtnRefresh(curIndex)
            self:SliderExp()
        end
    )
end

function BuildLoveView:DeepBtnRefresh(index)
    local sid = self.data.cfg.hgd[index]
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)
    local itemCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, sid)
    self.go_table.aorbtn_OneGift:SetGray(false)
    self.go_table.aorbtn_AllGift:SetGray(false)

    if self.isMax then
        self.go_table.aorbtn_OneGift:SetGray(true)
        self.go_table.aorbtn_AllGift:SetGray(true)
    end
end

--- 进入语音
function BuildLoveView:InitSound()
    local id = self.data.cfg.idle_sound[1][2]
    for i = 1, #self.data.cfg.idle_sound do
        if self.data.cfg.idle_sound[i][1] < self.LoveLevel then
            id = self.data.cfg.idle_sound[i][2]
        end
    end
    _G.AudioManager.PlayAudioByAudioCfgID(id)
end

--- 点击语音组
function BuildLoveView:InitClickSound()
    --- 语音播放下标
    self.TalkSoundListIndex = 0
    local id = {}
    for i = 1, #self.data.cfg.show_sound do
        if self.data.cfg.show_sound[i][1] < self.LoveLevel or self.data.cfg.show_sound[i][1] == 0 then
            table.insert(id, self.data.cfg.show_sound[i][2])
        end
    end
    self.TalkSoundList = id
end

--- 播放点击语音
function BuildLoveView:PlayClickSound()
    if not self.IsPlay then
        self.TalkSoundListIndex = self.TalkSoundListIndex + 1
        if self.TalkSoundListIndex > #self.TalkSoundList then
            self.TalkSoundListIndex = 1
        end
        self.IsPlay = true
        _G.AudioManager.PlayAudioByAudioCfgID(self.TalkSoundList[self.TalkSoundListIndex])
        _G.DelayDo(5, function()
            self.IsPlay = false
        end)
    end
end

--- 特殊解锁判定
function BuildLoveView:GetSpecial()
    --- 是否解锁对话特殊气泡
    self.IsTalkSpecial = false
    --- 是否解锁云雾遮罩
    self.IsMaskSpecial = false
    --- 是否解锁特殊语音
    self.IsSoundSpecial = false
    --- 是否解锁特殊动作
    self.IsPlaySpecial = false
    --- 是否解锁衣物遮挡
    self.IsClothSpecial = false
    --- 是否已达到当前可升级的最大等级
    self.IsMaxByBuildLock = false

    for i = 1, #self.data.cfg.special do
        if self.data.cfg.special[i][1] <= self.loveData.favor_level then
            if self.data.cfg.special[i][2] == 6 then
                self.IsMaskSpecial = true
                self.go_table.obj_Effect:SetActiveE(0)
            end
            if self.data.cfg.special[i][2] == 2 then
                self.IsSoundSpecial = true
            end
            if self.data.cfg.special[i][2] == 3 then
                self.IsClothSpecial = true
            end
            if self.data.cfg.special[i][2] == 4 then
                self.IsPlaySpecial = true
            end
            if self.data.cfg.special[i][2] == 5 then
                self.IsTalkSpecial = true
            end
        end
    end
end

function BuildLoveView:ShowTalkPop()
    ---气泡展示时间
    local TalkShowTime = self.data.cfg.interval[2]
    ---气泡Cd时间
    local TalkCdTime = self.data.cfg.interval[1]
    self.go_table.aorimage_Talk:SetActiveE(1)

    local list = not self.IsTalkSpecial and self.data.cfg.lines[1] or self.data.cfg.lines[#self.data.cfg.lines]

    self.TalkIndex = self.TalkIndex + 1
    if self.TalkIndex > #list then
        self.TalkIndex = 1
    end
    self.go_table.aortext_tips.text = _G.LangUtil.GetLangPackValue(list[self.TalkIndex])

    _G.DelayDo(
        TalkShowTime,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.aorimage_Talk:SetActiveE(0)
            _G.DelayDo(
                TalkCdTime,
                function()
                    if self:IsNil() then
                        return
                    end
                    self:ShowTalkPop()
                end
            )
        end
    )
end

function BuildLoveView:UpdateView(sid)
    self.Sid = sid
    self:RefreshView()
end

--- 中间的spine以及点击参数
function BuildLoveView:ShowBuild()
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(self.Sid)
    self.clickIndex = self.loveData.click_value
    self.isMax = self.loveData.favor_level >= self.data:GetStar() + 1 or not self.data:GetIsActive()
    if self.isMax and self.loveData.favor_level >= #self.data.cfg.love then
        self.go_table.aorimage_slider:SetRectTransformSize(405, 8)
        self.go_table.aortext_curLevelName:SetActiveE(0)
    else
        self.go_table.aorimage_slider:SetRectTransformSize(
            self.clickIndex / self.data.cfg.love[self.LoveLevel + 1] * 405, 8)
    end

    local childCount = self.go_table.obj_spine:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_spine:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.data.cfg.spine,
        _G.ePoolType.UIItem,
        self.go_table.obj_spine,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            self.spine = trans
            if not self.IsMaskSpecial then
                GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle99, true)
            else
                --- 两个都开启播放没衣服的
                if self.IsMaskSpecial and self.IsClothSpecial then
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle, true)
                else
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle2, true)
                end
            end
            trans:SetLocalScaleXYZ(self.data.cfg.coord[2][1])
            trans:SetLocalPosition(_G.table.unpack(self.data.cfg.coord[1]))
        end
    )


    self:RefreshStar()
end

