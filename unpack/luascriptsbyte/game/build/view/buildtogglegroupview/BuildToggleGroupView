---@class BuildToggleGroupView : UIBaseView 下边栏菜单
---@field go_table BuildToggleGroupView_GoTable
---@field toggles table<string,BuildToggleGroupView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local BuildToggleGroupView = _G.BaseClass("BuildToggleGroupView", _G.UIBaseView)

function BuildToggleGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function BuildToggleGroupView:OnCreate(toggleIndex)
    self:InitToggles()
    self:InitTogglesFunctionUnlock()
    ---@type string
    local key
    if not toggleIndex then
        key = "build"
    elseif type(toggleIndex) == "string" then
        key = toggleIndex
    elseif toggleIndex == 1 then
        key = "build"
    elseif toggleIndex == 2 then
        key = "book"
    elseif toggleIndex == 3 then
        key = "draw"
    end

    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_build
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
end

function BuildToggleGroupView:OnDestroy()
    self:RemoveAllListener()
end

function BuildToggleGroupView:InitToggles()
    self.views = {}
    self.toggles = {
        build = _G.GetAutoGoTable(
            self.go_table.toggle_build,
            _G.handlerbind(self, self.OnClickToggle, "build", _G.handler(self, self.OnBuild))
        ),
        book = _G.GetAutoGoTable(
            self.go_table.toggle_book,
            _G.handlerbind(self, self.OnClickToggle, "book", _G.handler(self, self.OnBook))
        ),
        draw = _G.GetAutoGoTable(
            self.go_table.toggle_draw,
            _G.handlerbind(self, self.OnClickToggle, "draw", _G.handler(self, self.OnDraw))
        ),

    }
end

function BuildToggleGroupView:InitTogglesFunctionUnlock()

end

---监听Toggle点击事件
---@param key string
---@param callback function
function BuildToggleGroupView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function BuildToggleGroupView:OnBuild()
    local view = self.views.build
    if not view then
        self.views.build = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BuildMainView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildMainView.Name)
    elseif view ~= 0 then
        --view:UpdateView()
    end
end

function BuildToggleGroupView:OnBook()
    local view = self.views.book
    if not view then
        self.views.book = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BuildFetterView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildFetterView.Name)
    elseif view ~= 0 then
        --view:UpdateView()
    end
end

function BuildToggleGroupView:OnDraw()
    local view = self.views.draw
    if not view then
        self.views.draw = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BuildDrawView.Name)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildDrawView.Name)
    elseif view ~= 0 then
        --view:UpdateView()
    end
end

---加载升星界面
function BuildToggleGroupView:OnUIOpened(name)
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.BuildMainView.Name then
        key = "build"
    elseif name == _G.ConfigManager.ui_cfg.BuildDrawView.Name then
        key = "draw"
    elseif name == _G.ConfigManager.ui_cfg.BuildFetterView.Name then
        key = "book"
    end
    if not key then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    if view.go_table and view.go_table.obj_close then
        view.go_table.obj_close:SetActiveE(0)
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views[key] = view
    if self.curToggle ~= key then
        view:Hide()
    end
end

---按钮点击事件在这里派发
function BuildToggleGroupView:Close()
    self.super.Close(self)
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            view:Close()
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function BuildToggleGroupView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return BuildToggleGroupView
