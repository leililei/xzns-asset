function BuildStarUpView:ShowProp(data)
    if not self.compareData then
        base.ShowProp(self, data)
        return
    end
    local curData = data
    data = self.compareData
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local numStr, num, tb, tran, key, showList, upNum
    local showProp = function(prop, isPer, otherProp)
        showList = {}
        for i, v in pairs(prop) do
            if v > 0 then
                table.insert(showList, { key = i, sortId = _G.AttrType[i].sortid })
            end
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        local getNum = function(keyType, curValue)
            if _G.AttrType[keyType].percentage == 1 or isPer then
                curValue = curValue * 100
                curValue = _G.GameUtil.FormatNum(curValue)
                curValue = curValue .. "%"
                if isPer then
                    curValue=_G.string.AddColor(curValue,"ff8331")
                end
            else
                curValue = _G.math.floor(curValue)
                curValue = _G.GameUtil.NumberWY(curValue)
            end
            return curValue
        end
        for _, v in pairs(showList) do
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = isPer and _G.string.AddColor(_G.GetLangPackValue(90033800108,_G.AttrType[key].des),"ff8331") or _G.AttrType[key].des
                num = prop[key]
                if otherProp[key] then
                    upNum = otherProp[key] - num
                else
                    upNum = 0
                end

                local propNum = getNum(key, num)
                local numStr = propNum
                if _G.AttrType[key].percentage == 1 or isPer then
                    numStr = "<color=#5bdf99>" .. propNum .. "</color>"
                end
                tb.aortext_oldValue.text = numStr
                if upNum > 0 then
                    propNum = getNum(key, upNum + num)
                end
                tb.aortext_curValue.text = propNum
                tb.aorimage_icon:LoadSprite(_G.AttrTypeIcon[key])
                tran:SetActiveE(1)
            end
        end
    end

    local prop = data.attribute:GetAttrByName(_G.AttCountType.other)
    local compareProp = curData.attribute:GetAttrByName(_G.AttCountType.other)
    showProp(prop, nil, compareProp)
    prop = data.attribute:GetAttrByName(_G.AttCountType.basePercent)
    compareProp = curData.attribute:GetAttrByName(_G.AttCountType.basePercent)
    showProp(prop, true, compareProp)
end

---显示技能
function BuildStarUpView:ShowSkill()
    self:ShowStar(1)
    ---@type pet_cfg
    local cfg = self.data:GetCfg()
    self.starSkills = {}

    for i = 2, #cfg.skill_id do
        _G.table.insert(self.starSkills, cfg.skill_id[i])
    end

    for i = 1, #self.starSkills do
        if i == self.data.star + 1 then
            local obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.trans_content)
            local tb = _G.GetAutoGoTable(obj)
            tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
            tb.DesExText.text = self:GetSkillDes(i, cfg.skill_id[i])
            tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
            obj:SetActiveE(1)
        end
    end

    if #self.starSkills == 0 then
        self.go_table.obj_gap:SetActiveE(0)
        self.go_table.obj_skills:SetActiveE(0)
        self.go_table.obj_title2:SetActiveE(0)
    else
        GameUtil.ReBuildRTF(self.go_table.obj_title2_Layout)
    end
end

---设置星级显示
---@param isShow number
function BuildStarUpView:ShowStar(isShow)
    self.go_table.obj_starNode:SetActiveE(isShow)
    if isShow == 1 then
        if self.data.star - 5 > 0 then
            for i = 1, self.data.star - 5 do
                local star = self.go_table["aorrawimage_star_" .. i]
                star:LoadImage("ImagesH5/hCardShow/xing_hong")
            end
        end

        for i = 1, 5 do
            local starblack = self.go_table["aorrawimage_black_" .. i]

            if i < self.data.star then
                starblack:SetActiveE(0)
            elseif i == self.data.star then
                local starblack = self.go_table["aorrawimage_black_" .. i]
                starblack:SetActiveE(1)
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_xingxingchuxian,
                    self.go_table["obj_eff_" .. i],
                    function(obj)
                        if self.go_table == nil then
                            _G.DestroyObject(obj)
                            return
                        else
                            obj:SetActiveE(1)
                            _G.DelayDo(0.5, function()
                                if self.go_table == nil then
                                    return
                                end
                                starblack:SetActiveE(0)
                            end)
                        end
                    end
                )
            else
                starblack:SetActiveE(1)
            end
        end
    end
end

---获取技能描述
function BuildStarUpView:GetSkillDes(index, id)
    local Cfg = _G.ConfigManager.attribute_cfg[id]
    local LanID = Cfg.describe
    if LanID == 0 then
        LanID = _G.ConfigManager.card_skills_cfg[Cfg.skill].describe1
    end
    if Cfg then
        return _G.GetLangPackValue(90022300084, index - 1, _G.GetLangPackValue(LanID))
    else
        return _G.GetLangPackValue(90022300084, index - 1, id)
    end
end

---@private
function BuildStarUpView:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

function BuildStarUpView:InitbgCanvasSortingOrder()
    local canvas = self.go_table.obj_bg:GetComponentE(_G.typeof(_G.Canvas))
    local parentcanvas = self:GetParentCanvas(self.go_table.obj_bg)
    canvas.sortingOrder = canvas.sortingOrder + parentcanvas.sortingOrder
end

---获得父物体画布
---@param obj UnityEngine.GameObject 子物体
function BuildStarUpView:GetParentCanvas(obj)
    local canvas = obj:GetComponentInParentE(_G.typeof(_G.Canvas))
    if not canvas.overrideSorting then
        return self:GetParentCanvas(canvas.transform)
    else
        return canvas
    end
end

return BuildStarUpView
