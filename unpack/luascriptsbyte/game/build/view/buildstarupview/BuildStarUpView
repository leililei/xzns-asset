local BuildDrawModel = require "BuildDrawModel"

local base = require "EventViewBase"
---@class BuildStarUpView : UIBaseView    灵兽升星界面
---@field public go_table BuildStarUpView_GoTable GoTable
local BuildStarUpView = _G.BaseClass("BuildStarUpView", base)

function BuildStarUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BuildStarUpView:OnCreate(sid)
    ---@type BuildData
    self.data = BuildDrawModel:GetInstance():GetBuild(sid)
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(sid)
    self.LoveLevel = self.loveData.favor_level
    local oldData = require("BuildData").New(sid)
    oldData:Parse({ star = self.data:GetStar() - 1 })
    local nowData = require("BuildData").New(sid)
    nowData:Parse({ star = self.data:GetStar() })
    self:InitbgCanvasSortingOrder()


    self:GetSpecial()


    self:SetCompareData(oldData)
    self:ShowBase(true)
    self:ShowProp(nowData)
    self:ShowSkill()
    self:ShowBtn()
end

--- 特殊解锁判定
function BuildStarUpView:GetSpecial()
    --- 是否解锁衣物遮挡
    self.IsClothSpecial = false
    self.IsMaskSpecial = false

    for i = 1, #self.data.cfg.special do
        if self.data.cfg.special[i][1] <= self.LoveLevel then
            if self.data.cfg.special[i][2] == 6 then
                self.IsMaskSpecial = true
            end
            if self.data.cfg.special[i][2] == 2 then
                self.IsSoundSpecial = true
            end
            if self.data.cfg.special[i][2] == 3 then
                self.IsClothSpecial = true
            end
            if self.data.cfg.special[i][2] == 4 then
                self.IsPlaySpecial = true
            end
            if self.data.cfg.special[i][2] == 5 then
                self.IsTalkSpecial = true
            end
        end
    end


    local childCount = self.go_table.obj_spine:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_spine:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.data.cfg.spine,
        _G.ePoolType.UIItem,
        self.go_table.obj_spine,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            self.spine = trans

            if not self.IsMaskSpecial then
                GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle99, true)
            else
                --- 两个都开启播放没衣服的
                if self.IsMaskSpecial and self.IsClothSpecial then
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle, true)
                else
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle2, true)
                end
            end
            trans:SetLocalScaleXYZ(self.data.cfg.coord[2][1])
            trans:SetLocalPosition(_G.table.unpack(self.data.cfg.coord[1]))
        end
    )
end

---按钮点击事件在这里派发
function BuildStarUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    end
end

