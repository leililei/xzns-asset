---长按事件
function BuildWishListView:OnLongPressEvent(BuildSid)
    if self.isLongPress then
        self.isLongPress = false
        require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, BuildSid, nil, nil,
            { #_G.ConfigManager.artifact_level_cfg })
    end
end

---建筑Item点击事件
---@param BuildSid number 建筑sid
function BuildWishListView:OnClickBuild(obj, isOn, BuildSid)
    if self.selecID == BuildSid then
        require("CommonTipManager"):GetInstance():OpenTip(obj, BuildSid, nil, nil, true, true)
    else
        self.selecID = BuildSid
        self:RefreshSelectBuild()
        self.go_table.scrollloopvectical_artifact:UpdateAllItem()
    end
end

---刷新选中的建筑
function BuildWishListView:RefreshSelectBuild(index)
    if index then
        ---如果点击已选择的建筑，则取消选择
        self.selectBuildData[index] = 0
        local parentObj = self.go_table["aorbtn_select" .. index]
        self.go_table["aortext_name" .. index].text = ""
        self.selectBuildItem[parentObj:GetInstanceIDE()] = nil
        parentObj:ClearChildren()
        -- self:OnSend()
        return
    end
    for i = 1, self.selectBuildtNum do
        local parentObj = self.go_table["aorbtn_select" .. i]
        if self.selectBuildData[i] > 0 and not self.selectBuildItem[parentObj:GetInstanceIDE()] then
            local sid = self.selectBuildData[i]
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBuildBase,
                parentObj,
                function(item)
                    item:Show(sid)
                    item:SetSize(100)
                    self.selectBuildItem[parentObj:GetInstanceIDE()] = item
                end
            )
            ---建筑名字
            local build_cfg = _G.ConfigManager.manor_build_cfg[sid]
            self.go_table["aortext_name" .. i].text = _G.LangUtil.GetLangPackValue(build_cfg.Name)
            self.go_table["obj_gou_" .. i]:SetActiveE(0)
        end
    end
end

function BuildWishListView:OnClickBtnTip(storageType, cardList, itemData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.WearCardList,
        storageType,
        cardList,
        itemData
    )
end

---选中item点击事件
---@param index number item的索引
function BuildWishListView:OnClickSelectItem(index)
    if self.selectBuildData[index] then
        self:RefreshSelectBuild(index)
        self:ChangeProfession(self.curProfession, true)
    end
end

---发送消息
function BuildWishListView:OnSend()
    BuildDrawModel:GetInstance():SetWish({ self.selecID, 0, 0 })
end

---界面的销毁函数
function BuildWishListView:OnDestroy()
end

return BuildWishListView
