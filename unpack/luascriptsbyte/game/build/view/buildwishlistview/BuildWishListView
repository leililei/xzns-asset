---界面的入口函数
function BuildWishListView:OnCreate()
    self:InitBuildData()
    ---已选中的数据,0是未选择（TODO:临时测试数据）
    self.selectBuildData = BuildDrawModel:GetInstance():GetWishsids()
    self.selecID = self.selectBuildData[1]
    ---默认显示全部
    self:ChangeProfession(PlayerTreeID.none)
    self:RefreshSelectBuild()
    -- self.go_table.aortext_toptips.text = _G.GetLangPackValue(90022300068)
end

---初始化建筑数据
function BuildWishListView:InitBuildData()
    --TODO:临时测试数据
    -- _G.ConfigManager.item_roller_cfg[10100].wish_item
    local wishItemData = _G.ConfigManager.item_roller_cfg[40100].wish_item
    local buildcfg = _G.ConfigManager.manor_build_cfg
    for _, id in pairs(wishItemData) do
        local cfg = buildcfg[id]
        if cfg then
            _G.table.insert(self.buildDataList[PlayerTreeID.none], id)
        end
    end
end

---更改当前选择职业
---@param profession number 职业
---@param force boolean 是否强制刷新
function BuildWishListView:ChangeProfession(profession, force)
    if profession ~= self.curProfession or force then
        self.curProfession = profession
        self.go_table.aorimage_select:SetParentE(self.professionBtn[profession])
        self.curBuildData = self.buildDataList[profession]
        self.go_table.scrollloopvectical_artifact:UpdateCount(#self.curBuildData)
    end
end

