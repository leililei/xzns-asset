local BuildDrawModel = require "BuildDrawModel"

local base = require "EventViewBase"
---@class BuildLoveShowView : UIBaseView    建筑好感度提示
---@field public go_table BuildLoveShowView_GoTable GoTable
local BuildLoveShowView = _G.BaseClass("BuildLoveShowView", base)

function BuildLoveShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BuildLoveShowView:OnCreate(sid, callBack)
    ---@type BuildData
    self.data = BuildDrawModel:GetInstance():GetBuild(sid)
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(sid)
    self.LoveLevel = self.loveData.favor_level
    self.go_table.scrollloopvectical_items:InitItemData(0, _G.handler(self, self.RefereshItemList))
    self.go_table.scrollloopvectical_items:UpdateCount(#self.data.cfg.love)
end

function BuildLoveShowView:RefereshItemList(index, obj)
    local id = obj:GetInstanceIDE()
    local curIndex = index + 1
    local tb = GetAutoGoTable(obj)
    -- _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
    tb.aortext_Level.text = index
    if index == 0 then
        tb.aortext_Level.text = _G.LangUtil.GetLangPackValue(90033800099)
    end

    tb.aortext_Desc2:SetActiveE(0)

    local specialList = self.data.cfg.special
    local indexNum = 0
    tb.aortext_Desc1.text = "<color=#394562>" .. _G.LangUtil.GetLangPackValue(90033800221) .. "</color>"
    --- 是否特殊的奖励级别
    for i = 1, #specialList do
        if specialList[i][1] == curIndex then
            indexNum = indexNum + 1
            if indexNum == 1 then
                tb.aortext_Desc1.text = "<color=#00721D>" .. _G.LangUtil.GetLangPackValue(specialList[i][3]) ..
                    "</color>"
            else
                tb.aortext_Desc2.text = "<color=#00721D>" .. _G.LangUtil.GetLangPackValue(specialList[i][3]) ..
                    "</color>"
                tb.aortext_Desc2:SetActiveE(1)
            end
        end
    end

    tb.obj_RewardRoot:ClearChildren()

    local array = self.data.cfg.reward[curIndex]
    StorageManager:GetItemBaseViewNew(
        array,
        tb.obj_RewardRoot,
        function(tran)
            tran.gameObject:SetLocalScaleXYZ(0.83)

            tran:SetGou(self.LoveLevel >= curIndex)
            tran:ShowEffect()

            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
end

---按钮点击事件在这里派发
function BuildLoveShowView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
        if self.callBack then
            self.callBack()
        end
    end
end

return BuildLoveShowView
