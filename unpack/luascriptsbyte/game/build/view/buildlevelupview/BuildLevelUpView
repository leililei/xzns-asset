---显示消耗
function BuildLevelUpView:ShowConsume()
    if not self.data:GetIsActive() and not self.data:IsMaxLevel() then
        return
    end
    local curLevel = self.data:GetLevel()
    self.upLevel = self.data:GetLevel() == self.curMaxLevel and 0 or 1
    local upLevel = 10
    if upLevel + curLevel > self.curMaxLevel and 10 + curLevel >= self.curMaxLevel then
        upLevel = self.curMaxLevel - curLevel
    end


    ---计算升级所需要的资源是否足够
    local canUpLevel = 0
    local consumeResList
    local lastConsumeResList
    local enoughRes = true
    local StorageManager = _G.StorageManager:GetInstance()
    for i = curLevel + 1, curLevel + upLevel do
        consumeResList = BuildDrawModel:GetInstance():GetConsume(i - curLevel, curLevel, i, self.data)
        for _, v in pairs(consumeResList) do
            if v[2] > 0 and not StorageManager:CheckItem(v[1], v[2]) then
                enoughRes = false
                break
            end
        end
        if not enoughRes then
            if not lastConsumeResList then
                lastConsumeResList = consumeResList
            end
            break
        else
            canUpLevel = canUpLevel + 1
            lastConsumeResList = consumeResList
        end
    end
    self.upLevel = canUpLevel > 0 and canUpLevel or 1



    if self.data:IsMaxLevel() and self.data:IsMaxStar() then
        self.go_table.aortext_maxLevel.text = _G.LangUtil.GetLangPackValue(90023400029)
    elseif self.data:IsMaxLevel() and not self.data:IsMaxStar() then
        self.go_table.aortext_maxLevel.text = _G.LangUtil.GetLangPackValue(90033800056)
    end

    local level2 = self.data:GetLevel() + self.upLevel
    if level2 > self.curMaxLevel then
        level2 = self.data:GetLevel()
    end
    self.go_table.aortext_Level2.text = _G.LangUtil.GetLangPackValue(90033800028, level2)


    self.consumeResList = lastConsumeResList
    self.go_table.aortext_UpTextLevel.text = _G.LangUtil.GetLangPackValue(90021800244, self.upLevel)

    self:ShowConsumItem(self.consumeResList)
end

--- 展示升级的消耗
function BuildLevelUpView:ShowConsumItem(datas)
    if datas then
        for i = 1, #datas do
            local num = 0
            local itemSid = datas[i][1]
            local itemData = _G.StorageManager:GetInstance():GetItemDataByIDEx(itemSid)
            if itemData then
                num = itemData:GetCount()
            end
            local maxNum = datas[i][2]
            local strNum = num
            -- if num < maxNum then
            strNum = num < maxNum and string.format("<color=#ff5252>%s</color>", _G.GameUtil.NumberToUnitStr(num)) or
                string.format("<color=#96CE51>%s</color>", _G.GameUtil.NumberToUnitStr(num))
            -- else
            -- strNum = _G.GameUtil.NumberToUnitStr(strNum)
            -- end
            self.go_table["aortext_costLevel" .. i].text = strNum .. "/" .. _G.GameUtil.NumberToUnitStr(maxNum)

            local costImage = self.go_table["aorrawimage_costLevel" .. i]
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.baseItem,
                costImage,
                function(item)
                    if _G.IsNil(costImage) then
                        return
                    end
                    item:Show(itemSid)
                end
            )
        end
    end
end

---消耗展示
function BuildLevelUpView:SetCostState()
    -- self.go_table.scrollrect_content:SetRectTransformSize(536, 200)
    self.go_table.obj_upStar:SetActiveE(1)
    local isMaxLevel = self.data:IsMaxLevel()
    local isActive = self.data:GetIsActive()
    local isShowLevelUp = not isMaxLevel and isActive
    self.go_table.obj_upLevel:SetActiveE(isShowLevelUp and 1 or 0)
    self.go_table.aortext_maxLevel:SetActiveE(isMaxLevel and 1 or 0)
end

---按钮点击事件在这里派发
function BuildLevelUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_up then
        local itemSid = self.data.cfg.materials_item
        -- if not _G.StorageManager:GetInstance():CheckItem(itemSid, self.data:GetUpCostNum()) then
        --     local quickUseBox = _G.StorageManager:GetInstance():PetFastCheckItem(self.data.sid, function()
        --         self:SetCostState()
        --     end)
        --     if quickUseBox then
        --         return
        --     end
        -- end

        local num = 0
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, itemSid)
        if itemData then
            num = itemData:GetCount()
        end
        local maxNum = self.data:GetUpCostNum()

        if num < maxNum then
            _G.PopWindowManager:GetInstance():ShowAllTips(95)
            return
        end

        self:RecordPower()
        self.lastProp = BuildDrawModel:GetInstance():GetAllOtherProp(nil, self.data.sid)
        BuildDrawModel:GetInstance():UpStar(self.data.sid, self.data:GetStar(), function()
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Build)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildStar)
            self:ShowPowerUp()
        end)
    elseif go == self.go_table.aorbtn_upLevel then
        local consumeResList = BuildDrawModel:GetInstance():GetConsume(self.upLevel, self.data:GetLevel(),
            self.upLevel + self.data:GetLevel(), self.data)

        for i = 1, #consumeResList do
            local needNum = consumeResList[i][2]
            local num = 0
            local itemSid = consumeResList[i][1]
            local itemData = _G.StorageManager:GetInstance():GetItemDataByIDEx(itemSid)
            if itemData then
                num = itemData:GetCount()
            end
            --- 需求不足
            if needNum > num then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, itemSid)
                return
            end
        end

        self:RecordPower()
        self.lastProp = BuildDrawModel:GetInstance():GetAllOtherProp(nil, self.data.sid)
        BuildDrawModel:GetInstance():UpLevel(self.data.sid, self.upLevel + self.data:GetLevel(), function()
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Build)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildLevelExtra)
            self:ShowPowerUp()
        end)
    elseif go == self.go_table.aorbtn_info then
        require("CommonTipManager"):GetInstance():OpenBuildTipsView(self.data.sid, true)
    elseif go == self.go_table.aorbtn_right then
        self.clickIndex = 0
        self:ChangeShowBuild(true)
    elseif go == self.go_table.aorbtn_left then
        self.clickIndex = 0
        self:ChangeShowBuild(false)
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 172)
    elseif go == self.go_table.aorbtn_SpineClick then
        if self.IsPlaySpecial then
            local animName = self.data.cfg.display_show

            local sg = self.spine:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.AnimationState:SetAnimation(0, animName, false)

            if not self.IsMaskSpecial then
                sg.AnimationState:AddAnimation(0, self.data.cfg.display_idle99, true, 0)
            else
                --- 两个都开启播放没衣服的
                if self.IsMaskSpecial and self.IsClothSpecial then
                    sg.AnimationState:AddAnimation(0, self.data.cfg.display_idle, true, 0)
                else
                    sg.AnimationState:AddAnimation(0, self.data.cfg.display_idle2, true, 0)
                end
            end
        end
        self:PlayClickSound()
    elseif go == self.go_table.aorbtn_Hide then
        if self.go_table.obj_panel:GetActiveSelf() == 1 then
            self.go_table.obj_panel:SetActiveE(0)
        else
            self.go_table.obj_panel:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrBuildPanel.Name)
    end
end

function BuildLevelUpView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function BuildLevelUpView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

---切换建筑展示
---@param isNext boolean 切换下一个建筑
function BuildLevelUpView:ChangeShowBuild(isNext)
    if isNext then
        self.buildIndex = self.buildIndex + 1
    else
        self.buildIndex = self.buildIndex - 1
    end
    local data = self.buildIList[self.buildIndex]
    _G.Events:GetInstance():Broadcast(_G.eBuildCurID.BuildIDRefresh, data.sid, "levelUp")
    if self.go_table.obj_pet:GetChildCountE() > 1 then
        _G.DestroyObject(self.go_table.obj_pet:GetChildE(0))
    end

    self.data = data
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(data.sid)
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level
    self:GetSpecial()
    self:ShowBuild(data)
end

---界面的销毁函数
function BuildLevelUpView:OnDestroy()
    -- self:RemoveListener(_G.ePetUpStar.BuildDrawWishRefresh, self.BuildDrawWishRefresh, self)
    self:RemoveListener(_G.ePetUpStar.BuildUpLevelRefresh, self.BuildDrawWishRefresh, self)
end

return BuildLevelUpView
