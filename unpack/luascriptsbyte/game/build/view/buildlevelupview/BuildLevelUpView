local BuildDrawModel = require "BuildDrawModel"
local BuildDrawModel = require("BuildDrawModel")

local base = require "EventViewBase"
---@class BuildLevelUpView : UIBaseView	建筑升级
---@field public go_table BuildLevelUpView_GoTable GoTable
local BuildLevelUpView = _G.BaseClass("BuildLevelUpView", base)

local propIndex = {
    atk = 1,
    max_hp = 3,
    def = 2,
    bre = 4
}

function BuildLevelUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.PropListObj = {}
    self.IsPlay = false
end

---界面的入口函数
function BuildLevelUpView:OnCreate(sid)
    -- self:AddListener(_G.eBuildDraw.BuildDrawWishRefresh, self.BuildDrawWishRefresh, self)
    self:AddListener(_G.eBuildUpLevel.BuildUpLevelRefresh, self.RefreshBuildView, self)
    self.buildIList = BuildDrawModel:GetInstance():GetAllIsUnlockBuild()
    self:AddListener(_G.eItemUpdata.Updata, self.ShowConsume, self)
    self.clickIndex = 0
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(sid)
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level
    for k, v in pairs(self.buildIList) do
        if v.sid == sid then
            self.buildIndex = k
        end
    end
    local curData = self.buildIList[self.buildIndex]


    self:GetCurLevelIndex()
    local res = _G.ConfigManager.ui_cfg.BuildLevelUpView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self.data = curData
    self:GetSpecial()
    self:ShowBuild(curData)
end

--- 点击语音组
function BuildLevelUpView:InitClickSound()
    --- 语音播放下标
    self.TalkSoundListIndex = 0
    local id = {}
    for i = 1, #self.data.cfg.show_sound do
        if self.data.cfg.show_sound[i][1] < self.LoveLevel or self.data.cfg.show_sound[i][1] == 0 then
            table.insert(id, self.data.cfg.show_sound[i][2])
        end
    end
    self.TalkSoundList = id
end

--- 播放点击语音
function BuildLevelUpView:PlayClickSound()
    if not self.IsPlay then
        self.TalkSoundListIndex = self.TalkSoundListIndex + 1
        if self.TalkSoundListIndex > #self.TalkSoundList then
            self.TalkSoundListIndex = 1
        end
        self.IsPlay = true
        _G.AudioManager.PlayAudioByAudioCfgID(self.TalkSoundList[self.TalkSoundListIndex])
        _G.DelayDo(5, function()
            self.IsPlay = false
        end)
    end
end

function BuildLevelUpView:GetCurLevelIndex()
    --- 当前解锁额外等级属性的下标
    self.CurLevelIndex = 0
    self.extraList = {}
    for key, value in pairs(ConfigManager.manor_build_level_cfg) do
        if value.text ~= 0 then
            local args = {}
            args.level = key
            args.value = value.extra_growth
            args.text = value.text
            table.insert(self.extraList, args)

            if self.buildIList[self.buildIndex]:GetLevel() >= key then
                self.CurLevelIndex = self.CurLevelIndex + 1
            end
        end
    end
end

function BuildLevelUpView:UpdateView(sid)
    local curData = BuildDrawModel:GetInstance():GetBuild(sid)
    self.data = curData
    self.loveData = BuildDrawModel:GetInstance():GetBuildLove(sid)
    --- 当前好感度等级
    self.LoveLevel = self.loveData.favor_level
    self:GetSpecial()
    self:ShowBuild(curData)
end

function BuildLevelUpView:RefreshBuildView()
    for k, v in pairs(self.buildIList) do
        if v.sid == sid then
            self.buildIndex = k
        end
    end
    local curData = self.buildIList[self.buildIndex]

    self:ShowBuild(curData)
    self:BuildDrawWishRefresh()
end

--- 特殊解锁判定
function BuildLevelUpView:GetSpecial()
    --- 是否解锁衣物遮挡
    self.IsClothSpecial = false
    self.IsMaskSpecial = false

    for i = 1, #self.data.cfg.special do
        if self.data.cfg.special[i][1] <= self.LoveLevel then
            if self.data.cfg.special[i][2] == 6 then
                self.IsMaskSpecial = true
            end
            if self.data.cfg.special[i][2] == 2 then
                self.IsSoundSpecial = true
            end
            if self.data.cfg.special[i][2] == 3 then
                self.IsClothSpecial = true
            end
            if self.data.cfg.special[i][2] == 4 then
                self.IsPlaySpecial = true
            end
            if self.data.cfg.special[i][2] == 5 then
                self.IsTalkSpecial = true
            end
        end
    end
    self:InitClickSound()
end

function BuildLevelUpView:ShowBuild(curData)
    if self.buildIndex ~= nil then
        self.go_table.aorbtn_left:SetActiveE(self.buildIndex > 1 and 1 or 0)
    else
        self.go_table.aorbtn_left:SetActiveE(0)
    end
    if self.buildIndex ~= nil then
        self.go_table.aorbtn_right:SetActiveE(self.buildIndex ~= table.count(self.buildIList) and 1 or 0)
    else
        self.go_table.aorbtn_right:SetActiveE(0)
    end
    self.isPreview = not curData:GetIsActive()
    self.data = curData
    self.curMaxLevel = self.data:GetMaxLevel()
    local childCount = self.go_table.obj_spine:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_spine:GetChildE(i - 1), _G.ePoolType.UIItem)
        end
    end


    _G.PoolsManager:GetInstance():Spawn(
        self.data.cfg.spine,
        _G.ePoolType.UIItem,
        self.go_table.obj_spine,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            self.spine = trans
            if not self.IsMaskSpecial then
                GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle99, true)
            else
                --- 两个都开启播放没衣服的
                if self.IsMaskSpecial and self.IsClothSpecial then
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle, true)
                else
                    GameUtil.SetCardUiSpineAnimation(self.spine, self.data.cfg.display_idle2, true)
                end
            end
            trans:SetLocalScaleXYZ(self.data.cfg.coord[2][1])
            trans:SetLocalPosition(_G.table.unpack(self.data.cfg.coord[1]))
        end
    )


    self.go_table.aorrawimage_Build:LoadImage(
        curData.cfg.image_1,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()
            local cfg = self.data.cfg.icon_position2
            trans:SetLocalPosition(cfg[1], cfg[2], cfg[3])
            trans:SetLocalScaleXYZ(cfg[4])
        end)
    self:FreshStar()
    self:SetCostState()
    --- 升级的消耗
    self:ShowConsume()
    self:SetRightView()
end

function BuildLevelUpView:FreshStar()
    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(self.data.cfg.Order))
    ctm:SetItemTextGradient(self.go_table.aortext_name, self.data.cfg.Order)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_name:SetActiveE(0)
    self.go_table.aortext_name:SetActiveE(1)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.data.cfg.Name)
    self.go_table.aortext_Level.text = _G.LangUtil.GetLangPackValue(90033800028, self.data:GetLevel())

    local star = self.data:GetStar()
    self.go_table.aortext_Level:SetActiveE(self.data:IsMaxLevel() and 0 or 1)
    self.go_table.aorimage_jiantou:SetActiveE(self.data:IsMaxLevel() and 0 or 1)

    for i = 1, 5 do
        self.go_table["aorimage_star" .. i].SpriteName = "ui_ty_kapaipinjie_1"
        self.go_table["aorimage_starMask" .. i]:SetActiveE(star >= i and 0 or 1)
    end
    if star - 5 > 0 then
        for i = 1, star - 5 do
            self.go_table["aorimage_star" .. i].SpriteName = "ui_img_xing_hong"
        end
    end
end

function BuildLevelUpView:BuildDrawWishRefresh()
    self:SetCostState()
    --- 升级的消耗
    self:ShowConsume()
    self:ShowPropByCfg()
    self:ShowSkill()
    local curProp = BuildDrawModel:GetInstance():GetAllOtherProp(nil, self.data.sid)
    _G.UIUtils.ShowPropUp(nil, self.lastProp:GetAttrByName(_G.AttCountType.other), nil, { prop = curProp:GetAttrByName(_G.AttCountType.other) })
    self:FreshStar()
end

---右侧界面
function BuildLevelUpView:SetRightView()
    self:ShowPropByCfg()
    self:ShowSkill()
    self:ShowSkillTag()
end

---展示属性
function BuildLevelUpView:ShowPropByCfg()
    ---@type AttributeClass
    local attribute=self.data:GetAttributeDict(not self.data:GetIsActive(), true)
    local attrDic = attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)

    local index
    local go = _G.GetAutoGoTable(self.go_table.obj_PropContent)
    for k, v in pairs(attrDic) do
        index = propIndex[k]
        go["aortext_num" .. index].text = v
    end
    go = _G.GetAutoGoTable(self.go_table.obj_PropContent2)
    local go2 = _G.GetAutoGoTable(self.go_table.obj_PropContent2)
    local go3 = _G.GetAutoGoTable(self.go_table.obj_PropContent3)
    local num,numStr
    for k, v in pairs(Percentattr) do
        index = propIndex[k]
        num =  v * 100
        num = _G.GameUtil.FormatNum(num)
        numStr = tostring(num) .. "%"
        go = index > 2 and go3 or go2
        go["aortext_num" .. index].text = numStr
        go["aortext_name" .. index].text = _G.AttrType[k].des
    end
end

