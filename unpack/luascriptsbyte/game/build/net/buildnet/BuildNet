local base = require("BaseGameNet")

---@class BuildNet : BaseGameNet    通信协议
local BuildNet = _G.BaseClass("BuildNet", base)
---@return BuildNet BuildNet
function BuildNet:GetInstance()
    return base.GetInstance(self)
end

--region ------------- 建筑养成 -------------
---获取建筑信息
function BuildNet:Info(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_build_build_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

