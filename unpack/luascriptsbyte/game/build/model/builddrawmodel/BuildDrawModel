---@param msg artifact_draw.s2c_info
function BuildDrawModel:ParseData(msg)
    self.dayCount = 0
    self.accCount = {}

    self.attribute = nil
    self.attribute2 = nil
    self.attribute3 = nil

    if msg.day_count ~= nil then
        self.dayCount = msg.day_count or 0
    end
    if msg.total_count ~= nil then
        self.accCount = msg.total_count
    end
    if msg.diamond_times ~= nil then
        self.diamond_times = msg.diamond_times
    end
    if msg.need_count ~= nil then
        self.need_count = msg.need_count
    end
    if msg.wish_sids ~= nil then
        self.wish_sids = msg.wish_sids
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawBuildGiftPack.id)


    local week = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime()).week
    if week == 1 then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "BuildGiftLastRefreshTime", 0)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawBuildGiftPack.id)
    end
    self.super.ParseData(self)

    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Build)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildStar)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildLevelExtra)
end

