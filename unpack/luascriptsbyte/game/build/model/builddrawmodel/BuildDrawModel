---是否可升星
---@param BuildData BuildData
function BuildDrawModel:CanStarUp(BuildData)
    if BuildData:IsCanGet() then
        return true
    elseif (not BuildData:IsMaxStar()) and BuildData:IsCanStarUp() then
        return true
    else
        return false
    end
end

