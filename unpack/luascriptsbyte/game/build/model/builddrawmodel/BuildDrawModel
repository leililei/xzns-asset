function BuildDrawModel:RefreshRedPoint(param)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildMain.id, param)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildBuilding.id, param)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildGet.id, param)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildLvup.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BuildStar.id)
end

---检查材料是否足够十连
function BuildDrawModel:CheckMaterial(type)
    local checkNum = 10
    local enough
    if type == nil or type == MaterialType.All then
        enough = _G.StorageManager:GetInstance():CheckItem(self.MaterialEnum[MaterialType.N], checkNum)
        if enough then
            return true
        end
        enough = _G.StorageManager:GetInstance():CheckItem(self.MaterialEnum[MaterialType.R], checkNum)
        if enough then
            return true
        end
        return _G.StorageManager:GetInstance():CheckItem(self.MaterialEnum[MaterialType.SR], checkNum)
    elseif type == MaterialType.N then
        return _G.StorageManager:GetInstance():CheckItem(self.MaterialEnum[MaterialType.N], checkNum)
    elseif type == MaterialType.R then
        return _G.StorageManager:GetInstance():CheckItem(self.MaterialEnum[MaterialType.R], checkNum)
    elseif type == MaterialType.SR then
        return _G.StorageManager:GetInstance():CheckItem(self.MaterialEnum[MaterialType.SR], checkNum)
    end
end

---资源更新监听
function BuildDrawModel:OnUpData(data)
    self:RefreshRedPoint()
end

---销毁对象时,析构函数
function BuildDrawModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnUpData, self)
end

function BuildDrawModel:OnFunctionOpenCall(id)
    base.OnFunctionOpenCall(self, id)
    if id == self.curFunctionOpenID then
        _G.FunctionManager:GetInstance():AddNewFunId(self.curFunctionOpenID)
    end
end

return BuildDrawModel
