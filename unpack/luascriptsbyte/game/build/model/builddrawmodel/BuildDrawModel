---建筑的总属性(包含星级 不包含图鉴属性 分开计算)
function BuildDrawModel:GetBuildAttribute()
    if self.attribute ~= nil and self.changeAttrTypes ~= nil then
        return self.attribute, self.changeAttrTypes
    end
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    local dataBuild,attrData
    for _, v in pairs(_G.ConfigManager.manor_build_cfg) do
        dataBuild = self.builds[v.id]
        attrData = dataBuild:GetAttributeDict(false, true)
        AttributeClassManager:AddAttribute(attribute,attrData,false)
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    self.attribute = attribute
    self.changeAttrTypes = changeAttrTypes
    return attribute, changeAttrTypes
end

---建筑等级额外加成属性
function BuildDrawModel:GetBuildLevelExtraAttribute()
    if self.attribute3 ~= nil and self.changeAttrTypes3 ~= nil then
        return self.attribute3, self.changeAttrTypes3
    end
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(_G.ConfigManager.manor_build_cfg) do
        local dataBuild = self.builds[v.id]
        local attributeCfg = _G.ConfigManager.manor_build_level_cfg[dataBuild:GetLevel()]
        if attributeCfg and #attributeCfg.extra_growth > 0 then
            attribute = self:UpdateAttribute(AttributeClassManager, attribute, attributeCfg.extra_growth,
                dataBuild:GetCfg())
        end
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)

    self.attribute3 = attribute
    self.changeAttrTypes3 = changeAttrTypes

    return attribute, changeAttrTypes
end

---建筑星级技能的属性
function BuildDrawModel:GetBuildStarAttribute()
    if self.attribute2 ~= nil and self.changeAttrTypes2 ~= nil then
        return self.attribute2, self.changeAttrTypes2
    end

    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(_G.ConfigManager.manor_build_cfg) do
        local dataBuild = self.builds[v.id]
        local attributeCfg = ConfigManager.attribute_cfg[dataBuild:GetCfg().skill_id[dataBuild:GetStar() + 1]]
        if #attributeCfg.attribute > 0 then
            attribute = self:UpdateAttribute(AttributeClassManager, attribute, attributeCfg.attribute, dataBuild:GetCfg())
        end
    end
    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)

    self.attribute2 = attribute
    self.changeAttrTypes2 = changeAttrTypes


    return attribute, changeAttrTypes
end

function BuildDrawModel:UpdateAttribute(attributeManager, attribute, attData, cfg)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(
            v[1],
            attributeManager:GetValueWithName(v[1], v[3], v[2]),
            false,
            type
        )
    end
    return attribute
end

