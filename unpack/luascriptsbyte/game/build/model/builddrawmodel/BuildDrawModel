function BuildDrawModel:UpStar(sid, star, call)
    local isActive = self.builds[sid]:GetIsActive()
    local pbData = { sid = sid, new_star = not isActive and 0 or star + 1 }
    BuildNet:GetInstance():StarUp(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.attribute = nil
            self.attribute2 = nil
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)

            _G.StorageManager:GetInstance():ConsumeItem(self.builds[sid].cfg.materials_item, 0,
                self.builds[sid]:GetUpCostNum())
            if star == 0 and not isActive then
                self.builds[sid]:DoActive()
            else
                self.builds[sid]:UpStar(star + 1)
            end
            if star == 0 and not isActive then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildShowView.Name, sid)
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BuildStarUpView.Name, sid)
            end

            require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.Buildfetter.id
            )
            _G.Events:GetInstance():Broadcast(_G.eBuildUpStar.BuildUpStarRefresh)
            _G.Events:GetInstance():Broadcast(_G.eBuildUpLove.BuildUpLoveRefresh)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Build)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildStar)

            if call then
                call()
            end
        end
    )
end

function BuildDrawModel:UpLevel(sid, level, call)
    local pbData = { sid = sid, new_level = level }
    BuildNet:GetInstance():LevelUp(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.attribute = nil
            self.attribute3 = nil
            local consumeResList = self:GetConsume(level - self:GetBuild(sid):GetLevel(), self:GetBuild(sid):GetLevel(),
                level, self:GetBuild(sid))
            for i = 1, #consumeResList do
                _G.StorageManager:GetInstance():ConsumeItem(consumeResList[i][1], 0,
                    consumeResList[i][2])
            end
            self.builds[sid]:UpLevel(level)
            _G.Events:GetInstance():Broadcast(_G.eBuildUpLevel.BuildUpLevelRefresh)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Build)
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildLevelExtra)


            if call then
                call()
            end
        end
    )
end

---抽卡
---@param num number 抽奖次数
---@param consume_type number 消耗类型（1:道具 2:魂玉）
function BuildDrawModel:Draw(drawNum, consume_type, callback)
    local pbData = { draw_times = drawNum, consume_type = consume_type }
    if self.dayCount + drawNum > _G.ConfigManager.item_roller_cfg[40100].limit_daily then
        _G.PopWindowManager:GetInstance():ShowAllTips(130102)
        return
    end
    BuildNet:GetInstance():DrawExecute(
        pbData,
        function(msg)
            if msg.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData({ award = msg.award })
                if msg.award.overflow then
                    _G.PopWindowManager:GetInstance():ShowAllTips(380104)
                end
                self.need_count = msg.need_count
                self.dayCount = self.dayCount + drawNum
                local sid
                local num
                if consume_type == 1 then
                    sid = _G.ConfigManager.item_roller_cfg[40100].ticket[1]
                    num = drawNum
                else
                    self:AddDiamondTimes(drawNum)
                    sid, num = self:GetDiamondCurrencyByType(drawNum)
                end
                _G.StorageManager:GetInstance():ConsumeItem(sid, 0, num)
                _G.Events:GetInstance():Broadcast(_G.eBuildDecompose.BuildDecomposeRefresh)
                if self:IsAutoDecompose() then
                    self:AutoDecompose(callback, msg)
                end
                if callback then
                    callback(msg)
                end
            end
        end
    )
end

---调用立即自动分解
function BuildDrawModel:AutoDecompose(callback, msg)
    --只处理紫丶橙丶红三种品质
    local gradeList = _G.ConfigManager.discrete_cfg[126610]
    if not gradeList then
        if callback then
            callback(msg)
        end
        return
    end

    local buildDebrisList = {}
    for _, buildData in pairs(self:GetAllBuild()) do
        --已合成且满星的灵兽, 才进行分解
        if buildData:IsMaxStar() and _G.table.ContainsValue(gradeList[1], buildData:GetOrder()) then
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, buildData.cfg.materials_item)
            if not table.isEmptyOrNil(data)  then
                table.insert(buildDebrisList, { sid = buildData.cfg.materials_item, num = data.count })
            end
        end
    end

    if #buildDebrisList > 0 then
        self:DebrisDecompose(buildDebrisList, function(msg)
            if not msg or msg.ack ~= 1 then
                if callback then
                    callback(msg)
                end
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --对应材料id
            local gradeCfg = _G.ConfigManager.discrete_cfg[126604]
            if gradeCfg and gradeCfg[1] then
                local firstGradeCfg = _G.ConfigManager.discrete_cfg[gradeCfg[1][2]]
                local itemId = firstGradeCfg[1][1]
                local itemNum = 0
                if msg.award and msg.award.item then
                    for _, v in ipairs(msg.award.item) do
                        if v.type[1] == itemId then
                            itemNum = itemNum + v.type[2]
                        end
                    end
                end
                if itemNum > 0 then
                    --显示分解tip
                    _G.PopWindowManager:GetInstance():ShowAllTips(1110201, nil, nil, nil, nil, nil, itemNum)
                end
            end
        end)
    else
        if callback then
            callback(msg)
        end
    end
end

---获取魂玉抽卡的sid和num
---@param drawNum number 抽奖次数
---@return number,number,number 消耗id，消耗值，折扣
function BuildDrawModel:GetDiamondCurrencyByType(drawNum)
    local sid
    local num
    sid = _G.ConfigManager.item_roller_cfg[40100].ticket_2[1]
    local baseNum = _G.ConfigManager.item_roller_cfg[40100].ticket_2[2]
    num = drawNum * baseNum
    local data =
        require "PrivilegeManager":GetInstance():GetPrivilegeData(
            { _G.PrivilegeType.LimitedTimePrivilege.ConsumeReduce, 40100 }
        )
    local discount = 1
    --取消折扣
    --[[    if data[1] then
        discount = data[1] * 0.0001
        num = num - num * discount
    end]]
    return sid, _G.math.ceil(num), 1 - discount
end

