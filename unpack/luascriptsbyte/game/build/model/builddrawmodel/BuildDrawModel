---计算消耗
function BuildDrawModel:GetConsume(upLevel, curLevel, nextLevel, data)
    local order = data:GetOrder()

    ---@field cfg manor_build_level_cfg
    local cfg = _G.ConfigManager.manor_build_level_cfg[nextLevel]
    local curCfg = _G.ConfigManager.manor_build_level_cfg[curLevel]
    local consumeResList = _G.DeepCopyCfgTable(cfg["material_" .. order])
    if upLevel > 0 then
        for _, v in pairs(consumeResList) do
            for _, v2 in pairs(curCfg["material_" .. order]) do
                if v2[1] == v[1] then
                    v[2] = v[2] - v2[2]
                    break
                end
            end
        end
    end
    return consumeResList
end

---@param sidNumLis table 碎片数组{{sid = 1, num = 1},..}
function BuildDrawModel:DebrisDecompose(sidNumLis, call)
    local pbData = { build_debris = sidNumLis }
    BuildNet:GetInstance():Decompose(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            for _, v in pairs(sidNumLis) do
                _G.StorageManager:GetInstance():ConsumeItem(v.sid, nil, v.num)
            end
            _G.Events:GetInstance():Broadcast(_G.eBuildDecompose.BuildDecomposeRefresh)

            -- require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
            -- .PetillustratedItem.id)
            if call then
                call(msg)
            end
        end
    )
end

