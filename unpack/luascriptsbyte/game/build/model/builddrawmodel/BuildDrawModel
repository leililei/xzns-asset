---创建对象时,入口构造函数
function BuildDrawModel:__init()
    self.curFunctionOpenID = 292


    self.buildDebrisList = {}
    for _, v in pairs(_G.ConfigManager.item_cfg) do
        if v.Type1 == _G.ItemCfgType.BuildChip then
            self.buildDebrisList[v.ID] = v
        end
    end
    self.builds = {}
    self.buildloves = {}

    for _, v in pairs(_G.ConfigManager.manor_build_cfg) do
        self.builds[v.id] = BuildData.New(v.id)
        self.buildloves[v.id] = {
            sid = v.id,
            favor_level = 0,
            click_value = 0,
        }
    end


    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnUpData, self)
end

