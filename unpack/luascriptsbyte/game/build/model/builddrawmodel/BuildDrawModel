---可升好感度提示红点
function BuildDrawModel:CanLoveUp(data)
    if data:GetIsActive() then
        local cfg = data:GetCfg()
        local loveData = self:GetBuildLove(data.sid)
        if loveData.favor_level >= data:GetStar() + 1 then
            return false
        end

        for i = 1, #cfg.hgd do
            local sid = cfg.hgd[i]
            local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)
            --- 当前拥有的经验道具数量
            local itemCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, sid)
            if itemCount > 0 then
                return true
            end
        end
        return false
    else
        return false
    end
end

---是否可升级
---@param BuildData BuildData
function BuildDrawModel:CanLevelUp(BuildData)
    local curLevel = BuildData:GetLevel()
    if curLevel >= BuildData:GetMaxLevel() then
        return false
    end

    if not BuildData:GetIsActive() then
        return false
    end

    local levelCfgs = _G.ConfigManager.manor_build_level_cfg
    local cfg = levelCfgs[curLevel + 1]
    local curCfg = levelCfgs[curLevel]
    local order = BuildData:GetOrder()
    local consumeResList = _G.DeepCopyCfgTable(cfg["material_" .. order])
    for _, v in pairs(consumeResList) do
        for _, v2 in pairs(curCfg["material_" .. order]) do
            if v2[1] == v[1] then
                v[2] = v[2] - v2[2]
                break
            end
        end
    end

    local StorageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(consumeResList) do
        if v[2] > 0 and not StorageManager:CheckItem(v[1], v[2]) then
            return false
        end
    end

    return true
end

