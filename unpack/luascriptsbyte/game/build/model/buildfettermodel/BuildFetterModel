local BuildNet = require("BuildNet")

local base = _G.GameDataModelBase
---@class BuildFetterModel : GameDataModelBase
local BuildFetterModel = _G.BaseClass("BuildFetterModel", base)

---@return BuildFetterModel BuildFetterModel
function BuildFetterModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function BuildFetterModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Build
    self.fetters = {}
end

---从服务器拉取数据
function BuildFetterModel:GetDataFormServer()
    BuildNet:GetInstance():GetBuildFetterInfo(_G.handler(self, self.ParseData))
end

---@param msg
function BuildFetterModel:ParseData(msg)
    local fetters = msg.fetter_list or {}
    self.fetters = {}
    self.attribute = nil
    for _, v in pairs(fetters) do
        self.fetters[v.fetter_sid] = v.index
    end
    self.super.ParseData(self)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildFetter)
end

---激活建筑羁绊
---@param sid number 羁绊sid
---@param index number 羁绊阶段
function BuildFetterModel:FetterActive(sid, index, call)
    local pbData = { fetter_sid = sid, index = index }
    BuildNet:GetInstance():BuildFetterActive(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.attribute = nil
            self.fetters[sid] = index
            _G.Events:GetInstance():Broadcast(_G.eBuildUpFetter.BuildUpFetterRefresh)
            if call then
                call()
            end
            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.BuildFetter)

            require("RedPointManager"):GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.Buildfetter.id
            )
        end
    )
end

---获取羁绊阶段
---@param sid number 羁绊sid
function BuildFetterModel:GetFetterIndex(sid)
    return self.fetters[sid] or 0
end

---当前羁绊对应的建筑总星级
---@param builds table 羁绊对应的宠物
---@param condition_star number 解锁星级
function BuildFetterModel:CanActiveFetter(builds, condition_star)
    for _, v in pairs(builds) do
        local buildData = require("BuildDrawModel"):GetInstance():GetBuild(v)
        if _G.table.isEmptyOrNil(buildData) or not buildData:GetIsActive() then
            return false
        end

        if buildData:GetStar() < condition_star then
            return false
        end
    end
    return true
end

---是否有可激活的羁绊
function BuildFetterModel:CheckCanActiveFetter()
    local allCfg = _G.ConfigManager.manor_build_fetter_cfg

    for _, v in pairs(allCfg) do
        for i = 1, 5 do
            if self:GetFetterIndex(v.id) < i and self:CanActiveFetter(v.build, v["condition_star" .. i]) then
                return 1
            end
        end
    end
    return 0
end

---获取当前羁绊内可激活的最高阶段
function BuildFetterModel:GetActiveMaxIndex(sid)
    local curIndex = self:GetFetterIndex(sid)
    if curIndex >= 5 then
        return
    end

    local fetterCfg = _G.ConfigManager.manor_build_fetter_cfg[sid]
    local maxIndex = nil
    for i = curIndex + 1, 5 do
        if self:CanActiveFetter(fetterCfg.build, fetterCfg["condition_star" .. i]) then
            maxIndex = i
        end
    end

    return maxIndex
end

---建筑图鉴的属性
function BuildFetterModel:GetBuildFetterAttribute()
    if self.attribute ~= nil  then
        return self.attribute, self.changeAttrTypes
    end
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    for _, v in pairs(_G.ConfigManager.manor_build_fetter_cfg) do
        local index = self.fetters[v.id]
        if index and index > 0 then
            attribute = self:UpdateAttribute(AttributeClassManager, attribute, v["att" .. index])
        end
    end

    local changeAttrTypes = AttributeClassManager:GetChangeAttrTypes(attribute)
    self.attribute = attribute
    self.changeAttrTypes = changeAttrTypes
    return attribute, changeAttrTypes
end

function BuildFetterModel:UpdateAttribute(attributeManager, attribute, attData)
    for _, v in pairs(attData) do
        local type = v[2] == "2" and _G.AttCountType.basePercent or _G.AttCountType.other
        attribute:AddValueByName(
            v[1],
            attributeManager:GetValueWithName(v[1], v[3], v[2]),
            false,
            type
        )
    end
    return attribute
end

---销毁对象时,析构函数
function BuildFetterModel:Dispose()
end

return BuildFetterModel
