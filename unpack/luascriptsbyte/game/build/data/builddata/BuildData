---@class BuildData    中文描述
---@field cfg manor_build_cfg
---@field active boolean 是否激活
---@field star number 星级
local BuildData = _G.BaseClass("BuildData")
_G.BuildData = BuildData

local ConfigManager = _G.ConfigManager

---类的构造函数
function BuildData:__init(sid)
    self.sid = sid
    self.cfg = ConfigManager.manor_build_cfg[sid]
    self.active = false
    self.star = 0
    self.level = 0
end

---数据解析
function BuildData:Parse(msg)
    self.active = true
    self:Setmsg(msg)
end
function BuildData:Setmsg(msg)
    self.star = msg.star
    self.level = msg.level
    self:UpdateAttribute()
end

---更新属性
function BuildData:UpdateAttribute()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self.attribute:OnInit(nil, _G.PowerType.equipment)
    self:GetAttribute(self.attribute)
    self:CalculatePower()
end

-----计算战力
---@param item EquipmentItem 装备item
function BuildData:CalculatePower()
    self.power = self.attribute:CalculatePower()
    local power = self:GetCalculatePower()
end

-----计算满级满星
---@param item EquipmentItem 装备item
function BuildData:GetCalculatePower()
    self.attributeMax = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self.attributeMax:OnInit(nil, _G.PowerType.equipment)

    return self:GetAttribute(self.attributeMax, true):CalculatePower()
end

--region ------------- 访问数据 -------------

---获取基础属性
function BuildData:GetAttribute(attribute, isMax)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if attribute == nil then
        attribute = AttributeClassManager:GetAttribtueClass()
    end

    local starCfgGrowth = self.cfg.att_growth[self.star + 1] / 10000

    local level         = self.level ~= 0 and self.level or 1

    local growth        = (ConfigManager.manor_build_level_cfg[level].att_growth * starCfgGrowth) / 10000

    if isMax then
        starCfgGrowth = self.cfg.att_growth[self:GetCfg().Star + 1] / 10000
        level         = #ConfigManager.manor_build_level_cfg
        growth        = (ConfigManager.manor_build_level_cfg[level].att_growth * starCfgGrowth) / 10000
    elseif not self.active then
        attribute:AddValueByName("atk", 0, false)
        attribute:AddValueByName("bre", 0, false)
        attribute:AddValueByName("def", 0, false)
        attribute:AddValueByName("max_hp", 0, false)
        return attribute
    end
    attribute:AddValueByName("atk", _G.Mathf.RoundToInt(self.cfg.atk * growth), false)
    attribute:AddValueByName("bre", _G.Mathf.RoundToInt(self.cfg.bre * growth), false)
    attribute:AddValueByName("def", _G.Mathf.RoundToInt(self.cfg.def * growth), false)
    attribute:AddValueByName("max_hp", _G.Mathf.RoundToInt(self.cfg.max_hp * growth), false)
    for k,v in pairs(self.cfg.att) do
        attribute:AddValueByName(v[1], AttributeClassManager:GetValueWithName(v[1], tonumber(v[3])*(self.star + 1), tonumber(v[2])), false,tonumber(v[2]))
    end
    return attribute
end


---获取属性字典
---@return table 属性
function BuildData:GetAttributeDict(isPreview, notFetterAttr)
    local star = self.star + 1
    local level = self.level ~= 0 and self.level or 1
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if isPreview then
        star = self:GetCfg().Star + 1
        level = self:GetCfg().lv_limit[star]
    elseif not self.active then
        attribute:AddValueByName("atk", 0, false,_G.AttCountType.other)
        attribute:AddValueByName("bre", 0, false,_G.AttCountType.other)
        attribute:AddValueByName("def", 0, false,_G.AttCountType.other)
        attribute:AddValueByName("max_hp", 0, false,_G.AttCountType.other)
        return attribute
    end
    local starCfgGrowth = self.cfg.att_growth[star] / 10000
    local growth        = (ConfigManager.manor_build_level_cfg[level].att_growth * starCfgGrowth) / 10000
    
    attribute:AddValueByName("atk", _G.Mathf.RoundToInt(self.cfg.atk * growth), false,_G.AttCountType.other)
    attribute:AddValueByName("bre", _G.Mathf.RoundToInt(self.cfg.bre * growth), false,_G.AttCountType.other)
    attribute:AddValueByName("def", _G.Mathf.RoundToInt(self.cfg.def * growth), false,_G.AttCountType.other)
    attribute:AddValueByName("max_hp", _G.Mathf.RoundToInt(self.cfg.max_hp * growth), false,_G.AttCountType.other)
    for k,v in pairs(self.cfg.att) do
        attribute:AddValueByName(v[1], AttributeClassManager:GetValueWithName(v[1], tonumber(v[3])*star, tonumber(v[2])), false,tonumber(v[2]))
    end
    return attribute
end

---获取基础属性字典
---@return table 属性
function BuildData:GetAttributeBaseDict()
    if not self.active then
        return { atk = 0, bre = 0, def = 0, max_hp = 0 }
    end
    local prop = {}
    prop.atk = _G.Mathf.RoundToInt(self.cfg.atk)
    prop.bre = _G.Mathf.RoundToInt(self.cfg.bre)
    prop.def = _G.Mathf.RoundToInt(self.cfg.def)
    prop.max_hp = _G.Mathf.RoundToInt(self.cfg.max_hp)
    return prop
end

