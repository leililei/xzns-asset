--region ------------- 增删改 -------------

---合成激活
function BuildData:DoActive()
    self.active = true
    self.star = 0
    self.level = 1
    self:UpdateAttribute()
end

---升星(赋予等级)
function BuildData:UpStar(star)
    if star then
        self.star = star
    else
        self.star = self.star + 1
    end
    if self.star > self.cfg.Star then
        self.star = self.cfg.Star
    end
    self:UpdateAttribute()
end

---升级
function BuildData:UpLevel(level)
    self.level = level
    self:UpdateAttribute()
end

