---计时
function FlyingChessView:LDTimerCallBack()
    self.DiDa = self.DiDa + 1
    if self.IsOver then
        if self.DiDa > 30 then
            self:DoOver()
        end
    else
        if self.DiDa >= self.Speed then
            self.DiDa = 0
            self:DoNext()
        end
    end
end
---进入下一个节点
function FlyingChessView:DoNext()
    self.LDIndex = self.LDIndex + 1
    if self.LDIndex > #self.nowaward then
        self.LDIndex = 1
    end
    for i = 1, #self.nowaward do
        self.nowaward[i].select:SetActiveE(((i == self.LDIndex and self.nowaward[i].num > 0) or (i == self.LDIndex and i==self.nowAwardIndex)) and 1 or 0)
    end
    self.LDTimes = self.LDTimes + 1
    if self.Speed >= 10 then
        ---稳定速度至到本轮定位奖励位置
        self.Speed = 10
        if self.LDIndex == self.nowAwardIndex then
            self.DiDa = 0
            self.Speed = 99999

            self.IsOver = true
        end
    elseif self.Speed > 5 then
        ---一轮快速降速
        if math.floor(self.LDTimes / #self.nowaward) * 2 >= 1 then
            self.Speed = self.Speed + 5
        end
    else
        ---两轮缓慢降速
        if math.floor(self.LDTimes / #self.nowaward) >= 3 then
            self.Speed = self.Speed + 0.5
        end
    end
end

function FlyingChessView:DoOver()
    if self.LDTimer then
        self.LDTimer:Stop()
        self.LDTimer = nil
    end
    if _G.AppSetting.IsXzns then
        self.go_table.obj_AniMask:SetActiveE(0)
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.dajiangItem, nil, true)
    if not self.dajiang.award or #self.dajiang.award.item == 0 then
        self:InitNowAward()
        self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnWindowChange)
        self.dajiang={}
        self.dajiangItem={}
        self.playAnima = false
        self.isInTen = false
        self.rollmessage = {}
    else
        self:RefreshNowAward()
    end
end

function FlyingChessView:OnWindowChange(name)
    if name == _G.ConfigManager.ui_cfg.CommonAwardView.Name then
        if nil == self.LDTimer then
            self.nowAwardIndex, self.dajiangItem = self:GetNowAwardIndex()
            self.LDIndex = 1
            self.LDTimes = 0
            self.DiDa = 0
            self.Speed = 1
            self.IsOver = false
            if _G.AppSetting.IsXzns then
                self.go_table.obj_AniMask:SetActiveE(1)
            end
            self.LDTimer = _G.TimerManager:GetInstance():GetTimer(0.03, self.LDTimerCallBack, self, false, false, true)
            self.LDTimer:Start()
        end
    end
    --if self.dajiang.award and #self.dajiang.award.item>0 then
    --
    --end
end

function FlyingChessView:OnClickBtn(go, ison)
    if go == self.go_table.aorbtn_CloseView then
        self:OnClose()
    elseif go == self.go_table.aorbtn_anima then
        self:ChangeSkip(true)
    elseif go == self.go_table.toggle_anima then
        Model.isturnAnima = ison
        local index = ison and 1 or 0 
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.TeamUniteFlyingChessAnim, index)
    elseif go == self.go_table.toggle_ten then
        Model.isTen = ison
        self:RefreshCoin()
    elseif go == self.go_table.aorbtn_hunt then
        if self.playAnima then
            return
        end
        if not self.isenough then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.TeamUniteCircleCoin)
            return
        end
        if self.circle > Model.maxcircle then
            _G.PopWindowManager:GetInstance():ShowAllTips(1010201, nil, _G.handler(self, self.Roll), function()
                --self:Close()
            end)
        else
            self:Roll()
        end
    elseif go == self.go_table.aorbtn_task then
        require "TeamUniteTaskModel":GetInstance():OpenView()
    elseif go == self.go_table.aorbtn_awardpreview then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FlyChessAwardShowView.Name)
    elseif go == self.go_table.aorbtn_gift then
        require "TeamUniteGiftModel":GetInstance():OpenView()
    elseif go == self.go_table.aorbtn_help1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 163)
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FlyChessAwardShowView.Name)
    end
end

function FlyingChessView:OnClose()
    if not table.isEmptyOrNil(self.rollmessage) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.rollmessage, nil, true)
    elseif not table.isEmptyOrNil(self.dajiang) then
        if not table.isEmptyOrNil(self.dajiangItem) then
            table.insert(self.dajiang.award.item,self.dajiangItem.award.item[1])
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.dajiang, nil, true)
    end
    self:Close()
end

return FlyingChessView
