function FlyingChessView:UpdateCoin(data)
    if _G.IsNil(data) then
        return
    end
    --礼包里买的没有回调处理，监听一下物品更新来刷新代币
    local gift = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name)
    if not gift then
        return
    end
    for _, v in pairs(data) do
        if v.type[4] and v.type[4] == self.ActivityID then
            if v.type[1] and v.type[1] == Model:GetCoinId() then
                Model:AddCoin(v.type[2])
            end
        end
    end
end

