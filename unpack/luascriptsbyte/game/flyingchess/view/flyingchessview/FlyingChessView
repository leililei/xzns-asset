function FlyingChessView:DoMoveMaChe()
    if table.isEmptyOrNil(self.go_table) then
        return
    end
    if self.isInTen and not self.speedUpEffect then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jiasu,
                self.go_table.obj_mache,
                function(obj)
                    if self:IsNil() then
                        _G.UIUtils.RemoveEffect(obj)
                        return
                    end
                    self.speedUpEffect = obj
                end
        )
    end
    self.go_table.aorimage_TouZi:SetActiveE(0)
    if self.addpoint > 0 then
        self.addpoint = self.addpoint - 1
        self.nowpoint = self.nowpoint + 1 > 26 and 0 or self.nowpoint + 1
        local x, y, z, x1, y1, z1
        x, y, z = self.go_table[self.nowpoint ~= 0 and "obj_raw" .. self.nowpoint or "obj_startpoint"]:GetLocalPosition()
        x1, y1, z1 = self.go_table.obj_mache:GetLocalPosition()
        self.go_table.obj_mache:SetLocalScale(x1 < x and -1 or 1, 1, 1)
        self.moveDoTween = self.go_table.obj_mache:DOLocalMove(x, y, z,
                self.isInTen and self.speedtime / 3 or self.speedtime, function()
                    if self.nowpoint == 0 then
                        self:InitMessage()
                        self.dajiangList = Model:GetDaJiangList()
                        self.go_table.scrollloophorizontal_dajiangList:UpdateAllItem()
                        self:InitDItuAward(true)
                        _G.DelayDo(1, _G.handler(self, self.DoMoveMaChe))
                    else
                        self:DoMoveMaChe()
                    end
                end)
    else
        if not _G.TableIsEmpty(self.rollmessage) and table.count(self.rollmessage.award) > 0 then
            if self.speedUpEffect then
                _G.UIUtils.RemoveEffect(self.speedUpEffect)
                self.speedUpEffect = nil
            end
            local award, dajiang = Model:AwardSplit(self.rollmessage)
            self.dajiang = dajiang
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, award, nil, true)
            self.go_table.aortext_AllPoint.text = ""
            if self.dajiang.award and #self.dajiang.award.item > 0 then
                self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnWindowChange)
            else
                self.playAnima = false
                self.isInTen = false
                if _G.AppSetting.IsXzns then
                    self.go_table.obj_AniMask:SetActiveE(0)
                end
            end
            self.rollmessage = {}
        end
    end
end

