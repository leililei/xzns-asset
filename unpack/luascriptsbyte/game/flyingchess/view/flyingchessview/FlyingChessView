end

function FlyingChessView:GetNowAwardIndex()
    for j = 1, #self.nowaward do
        for i = 1, #self.dajiang.award.item do
            local sid, num
            sid = self.dajiang.award.item[i].type[1]
            num = self.dajiang.award.item[i].type[2]
            if self.nowaward[j].item[1] == sid and num == self.nowaward[j].item[2] then
                if self.nowaward[j].num > 0 then
                    local awarditem = { award = { item = { self.dajiang.award.item[i] } } }
                    self.nowaward[j].num = self.nowaward[j].num - 1
                    table.remove(self.dajiang.award.item, i)
                    return j, awarditem
                end
            end
        end
    end
    if self.circle >= self.nowAwardConfig.min and self.circle <= self.nowAwardConfig.max then
        return
    end
    self.nowAwardConfig = Model:GetNowInitDaJiangList()
    self:ShowNowAwark()
    local index, award = self:GetNowAwardIndex()
    return index, award
end

