        self.nowaward[i].tb.obj_gou:SetActiveE(self.nowaward[i].num == 0 and 1 or 0)
        self.nowaward[i].tb.aortext_Num.text = string.format("<color=#%s>%s</color>", self.nowaward[i].num == 0 and "e72a2a" or "1ccf21",
                _G.GetLangPackValue(90000001252, self.nowaward[i].num))
