local FlyingChessSynAwardShowView = _G.BaseClass("FlyingChessSynAwardShowView", _G.UIBaseView)
local Model=require "FlyingChessModel":GetInstance()
function FlyingChessSynAwardShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function FlyingChessSynAwardShowView:OnCreate(activity)
    if activity then
        Model = activity
    end
    self.circle=Model.circle
    self:InitAwardPreviewLuist()
    self:InitDaJiangList()

end

function FlyingChessSynAwardShowView:InitAwardPreviewLuist()
    self.awawrdPreviewList=Model:GetAwardPreviewList()
    local index=0
    for i = 1, #self.awawrdPreviewList do
        if i>1 and i<#self.awawrdPreviewList and self.awawrdPreviewList[i].min<Model.circle and self.awawrdPreviewList[i].max>=Model.circle then
            index=i
        end
    end
    index=index-1
    self.go_table.scrollloopvectical_jiangliList:InitItemData(#self.awawrdPreviewList,_G.handler(self,self.InitJiangliItem),index)
end

function FlyingChessSynAwardShowView:InitJiangliItem(index, obj)
    local item=self.awawrdPreviewList[index+1]
    local tb=_G.GetAutoGoTable(obj)
    tb.aortext_title.text=_G.GetLangPackValue(90000011753,item.min,item.max)
    tb.obj_items:ClearChildren()
    for i = 1, #item.awards do
        local itemob=_G.InstantiateObject(self.go_table.obj_awarditem2,tb.obj_items)
        itemob:SetActiveE(1)
        local goId = itemob:GetInstanceIDE()
        local itemtb=_G.GetAutoGoTable(itemob)
        itemtb.aortext_Num.text=string.format("%s", _G.GetLangPackValue(90000001252,item.awards[i].num))
        itemtb.obj_gou:SetActiveE(item.awards[i].num==0 and 1 or 0)
        local awardcfg=_G.ConfigManager.team_checkers_reward_cfg[item.awards[i].award]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awardcfg.item,
                itemtb.obj_Root,
                function(tran)
                    if _G.IsNil(tb) or goId ~= itemob:GetInstanceIDE() then
                        return
                    end
                    tran.gameObject:SetLocalScaleXYZ(0.9)
                    itemtb.obj_gou:SetLocalScaleXYZ(0.9)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    tran:SetGradeNew(i ~= 1)
                end
        )
    end
end

function FlyingChessSynAwardShowView:InitDaJiangList()
    self.dajiangList=Model:GetDaJiangList()
    local index=0
    for i = 1, #self.dajiangList do
        if i>1 and i<#self.dajiangList and self.dajiangList[i].circle<Model.circle and self.dajiangList[i+1].circle>=Model.circle then
            index=i
        end
    end
    index=index-1
    self.go_table.scrollloophorizontal_dajianglist:InitItemData(#self.dajiangList,_G.handler(self,self.InitDaJiangItem),index)
end
function FlyingChessSynAwardShowView:InitDaJiangItem(index, obj)
    local item=self.dajiangList[index+1]
    local tb=_G.GetAutoGoTable(obj)
    local goId = obj:GetInstanceIDE()
    tb.obj_gou:SetActiveE(item.num>0 and 0 or 1)
    tb.aortext_round.text=_G.GetLangPackValue(90000011752,item.circle)
    tb.obj_item:ClearChildren()
    local awardcfg=_G.ConfigManager.team_checkers_reward_cfg[item.award]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awardcfg.item,
            tb.obj_item,
            function(tran)
                if _G.IsNil(tb) or goId ~= obj:GetInstanceIDE() then
                    return
                end
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:SetGradeNew(false)
            end
    )
end

function FlyingChessSynAwardShowView:OnClickBtn(go,isOn)
    if go==self.go_table.aorbtn_close then
        self:Close()
    elseif go==self.go_table.aorbtn_Close then
        self:Close()
    end
end
function FlyingChessSynAwardShowView:Dispose()
    self.dajiangList={}
    self.awawrdPreviewList={}
end
return FlyingChessSynAwardShowView
