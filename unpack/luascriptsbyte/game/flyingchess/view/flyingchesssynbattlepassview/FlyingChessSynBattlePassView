function FlyingChessSynBattlePassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eTeamUnite.Refresh, self.InitView, self)
end

---界面的入口函数
---@param activity IntegrateBpFdControllerBase
function FlyingChessSynBattlePassView:OnCreate(activity)
    self.activity = activity
    self.jumpType = activity.curActivityClass:GetJumpType()
    self.GetJumpType = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        activity:GetJumpModelType(),
        self.jumpType,
        activity.curActivityClass:GetMainType()
    )
    self.ActivityID = self.GetJumpType:GetActivityID()
    ---@type FlyingChessSynModel
    self.model = require("FlyingChessManager"):GetInstance():GetActivity(self.jumpType)
    self.coinId = self.model:GetCoinId()
    self.ctrl = require("FlyingChessBpFdController").New(self.model)
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener)
    self:AddListener(_G.BattlePassExpEvents.BPUnlock, self.OnBPUnlock)
    --更新视图
    self.ctrl:InitData()
    self:InitView()
    self.ctrl:OnViewOpened()
    self:AddComponent(self.go_table.obj_playerInfo,
            require("PlayerComponent").New(self.go_table.obj_playerInfo))
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    self:OnAniEnd()
end

