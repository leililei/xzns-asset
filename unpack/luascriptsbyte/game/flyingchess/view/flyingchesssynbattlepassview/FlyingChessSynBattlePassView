---刷新战令
function FlyingChessSynBattlePassView:UpdateBattlePass()
    self.go_table.aortext_des.text = self.ctrl:GetRebateDes()
    self.isBuy = self.model:GetIsUp()
    self.go_table.obj_senior:SetActiveE(self.isBuy and 0 or 1)
    local x, y, z = self.go_table.aorbtn_buy:GetLocalPosition()
    self.go_table.aorbtn_buy:SetLocalPosition(self.isBuy and 0 or 202, y, z)
    _G.GameUtil.SetPriceByChannel(self.model:GetPrice(), self.go_table.aortext_money)

    self.awardCfgArray = self.model:GetAwardList()

    self.awardLis = self.model:FindAllUnclaimedRewards(self.lv)
    self.go_table.aorbtn_oneKey:SetActiveE((self.isBuy and #self.awardLis > 1) and 1 or 0)
    self.go_table.aorbtn_buy:SetActiveE(self.isBuy and 0 or 1)
    self.go_table.obj_btns:SetActiveE(((self.isBuy and #self.awardLis > 1) or not self.isBuy) and 1 or 0)
    local jumpIndex = self:FindFirstAwardIndex()
    self.go_table.scrollloopvectical_items:SetRectTransformOffset(20,((self.isBuy and #self.awardLis > 1) or not self.isBuy) and 146 or 17,-20,-66)
    if not self.bpInit then
        self.go_table.scrollloopvectical_items:InitItemData(#self.awardCfgArray, _G.handler(self, self.RefreshList), jumpIndex)
        self.bpInit = true
    else
        self.go_table.scrollloopvectical_items:UpdateCount(#self.awardCfgArray, jumpIndex)
    end

    if not self.isBuy then
        if not self.seniorInit then
            self.seniorInit = true
            self.seniorAwards = self.model:GetSeniorAwardList()
            self.go_table.scrollloophorizontal_seniorAward:InitItemData(#self.seniorAwards, _G.handler(self, self.RefreshSeniorItem))
        end
    end
end

function FlyingChessSynBattlePassView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local cfg = self.awardCfgArray[index]
    local id = cfg.id
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, cfg))

    local freeState, payState
    local lvEnough = self.model:CheckItemCondition(cfg)
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isBuy) and ItemState.Unlock or ItemState.Lock
    tb.freeState = self.model:CheckAwardIsGet(id, true) and ItemState.Received or freeState
    tb.payState = self.model:CheckAwardIsGet(id, false) and ItemState.Received or payState

    local rewards = cfg.rewards_free_item[1]
    if rewards[4] and rewards[5] then
        rewards = { rewards[4], rewards[5] }
    end
    if not tb.item1 then
        tb.item1 = BaseAwardNewItem.New(tb.obj_item1, nil, 88, tb.obj_item1)
    end
    tb.item1:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, false, 1, rewards[1]))

    rewards = cfg.rewards_pay[1]
    if rewards[4] and rewards[5] then
        rewards = { rewards[4], rewards[5] }
    end
    if not tb.item2 then
        tb.item2 = BaseAwardNewItem.New(tb.obj_item21, nil, 88, tb.obj_item21)
    end
    tb.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 21, rewards[1]))

    rewards = cfg.rewards_pay[2]
    if not _G.table.isEmptyOrNil(rewards) and rewards[4] and rewards[5] then
        rewards = { rewards[4], rewards[5] }
    end
    tb.obj_item22:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item3 then
            tb.item3 = BaseAwardNewItem.New(tb.obj_item22, nil, 88, tb.obj_item22)
        end
        tb.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 22, rewards[1]))
    end

    ---是否显示第二个
    tb.obj_gou22:SetActiveE(rewards and 1 or 0)

    ---已领打勾
    tb.obj_gou1:SetActiveE(tb.freeState == ItemState.Received and 1 or 0)
    tb.obj_gou2:SetActiveE(tb.payState == ItemState.Received and 1 or 0)
    ---可领
    tb.aorbtn_get:SetActiveE((tb.freeState == ItemState.Unlock or tb.payState == ItemState.Unlock) and 1 or 0)
    tb.aorbtn_notAchieved:SetActiveE(lvEnough and 0 or 1)
    --tb.aorbtn_notAchieved:SetGray(not lvEnough)
    tb.aorbtn_buySenior:SetActiveE((tb.freeState == ItemState.Received and tb.payState == ItemState.Lock) and 1 or 0)
    tb.aorimage_hasGetAll:SetActiveE((tb.freeState == ItemState.Received and tb.payState == ItemState.Received) and 1 or 0)

    --等级经验
    local exp = self.model:GetLvExpByLv(cfg)
    tb.aortext_lv.text = exp
    tb.aortext_exp.text = _G.GetLangPackValue(90000011765)
    tb.obj_itemExp:SetActiveE(1)

    --进度条
    tb.aorimage_DayBar:SetActiveE(index == 1 and 0 or 1)
    local lastExp = index > 1 and self.model:GetLvExpByLv(self.awardCfgArray[index - 1]) or 0
    local curExp = self.model:GetExp()
    if self.lv >= index then
        tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
        tb.aorrawimage_lvBg:LoadImage("ImagesH5/hSpringFestival/ui_myzt_zljm_fk")
    elseif index - 1 == self.lv then
        local scale = (curExp - lastExp) /
                (exp - lastExp)
        if scale < 0 then
            scale = 0
        end
        tb.aorimage_dayBar:SetLocalScale(1, scale, 1)
        tb.aorrawimage_lvBg:LoadImage("ImagesH5/hSpringFestival/ui_myzt_zljm_fk2")
    else
        tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
        tb.aorrawimage_lvBg:LoadImage("ImagesH5/hSpringFestival/ui_myzt_zljm_fk2")
    end
    return obj
end

function FlyingChessSynBattlePassView:RefreshSeniorItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.seniorAwards[index]
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(data, tb.obj_item, _G.handler(self, self.SeniorItemCall))
end

function FlyingChessSynBattlePassView:FindFirstAwardIndex()
    local maxIndex = self.isBuy and #self.awardCfgArray - 4 or #self.awardCfgArray - 3
    local index = self.ctrl:GetFirstAwardIndex(self.lv, self.awardCfgArray)
    return index > maxIndex and maxIndex - 1 or index - 1
end


---@param isBuy boolean true是豪华奖励
---@param itemLua BaseAwardNewItem 奖励脚本
function FlyingChessSynBattlePassView:itemLoadedCall(itemLua, tb, isBuy, suf, sid)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    else
        lua.go_table.trans_Root:SetLocalScaleXYZ(1.15)
    end

    local state = isBuy and tb.payState or tb.freeState
    local isShowEffect = state == ItemState.Unlock and self.loadEff

    if itemLua.type ~= _G.StorageType.Card then
        local needShow = _G.table.ContainsValue(effectShowSids, sid)
        itemLua:ShowEffect(needShow)
        if isShowEffect then
            lua:ShowEffect(needShow)
        else
            lua:ShowOrHideEffect(false)
        end
    else
        itemLua:ShowEffect(isShowEffect)
    end
    tb["obj_Eff" .. suf]:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
            tb["obj_Eff" .. suf],
        function(tran)
            if _G.IsNil(self.go_table.gameObject) then
                tran:DestroyObject()
                return
            end
            tran:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end

function FlyingChessSynBattlePassView:SeniorItemCall(itemLua)
    itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    _G.DelayDo(0.17, function()
        itemLua:ShowEffectOrder(true)
    end)
end

function FlyingChessSynBattlePassView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self:IsNil() then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.TimeUtil.TransDayHourMineMiao(time)
    self.go_table.aortext_remainTime.text = _G.GetLangPackValue(90049500026, time)
    self:UpdateAddBtnShow()
end

function FlyingChessSynBattlePassView:Buy()
    if not self.buyTipLua then
        self.buyTipLua = true
        local params = {}
        params.okFun = function()
            self.model:BuyUp()
        end
        params.content = self.model:GetAwardList()
        params.name = "英雄宝典"
        params.nowLevel = self.model.battle_lv
        params.price = self.model:GetPrice()
        params.activityId = self.ActivityID
        params.goods = self.model.cfg_list.award
        _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Task/$_obj_activeBattlePassBuyTips",
                _G.ePoolType.Temporary,
                self.go_table.obj_buyTip,
                function(tran)
                    if self.go_table == nil then
                        _G.DestroyObject(tran)
                        return
                    end
                    local sortOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 35
                    self.buyTipLua = self:AddComponent(tran, require("DrawUpBattlePassBuyTips").New(tran, params))
                end
        )
    elseif self.buyTipLua ~= true then
        self.buyTipLua:Show()
    end
end

function FlyingChessSynBattlePassView:OnAniEnd()
    --ZHJH-7257 动画缩放导致遮罩对特效的遮挡效果更新异常，延迟加载道具特效
    _G.DelayDo(0.5, function()
        self.loadEff = true
        self:UpdateBattlePass()
    end)
end

---充值成功监听
function FlyingChessSynBattlePassView:OnMallCashListener(msg)
    self:UpdateView()
end

---选线后刷新
function FlyingChessSynBattlePassView:OnPrePrecessEnd()
    self:ShowByPath()
    self:UpdateBattlePass()
end

function FlyingChessSynBattlePassView:OnGetAwardEnd()
    self.lv, self.curExp, self.curMaxExp = self.model:GetLvAndCurLvExp()
    self:UpdateBattlePass()
end

function FlyingChessSynBattlePassView:OnBPUnlock(id)
    if id == self.ctrl.type then
        self:InitView()
    end
end

function FlyingChessSynBattlePassView:OnClickItem(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if not self.model:CheckItemCondition(cfg) then
            return
        end
        if self.isBuy then
            self.model:GetAwardAll(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        elseif self.model:CheckAwardIsGet(cfg.id, true) then --弹出购买
            self:Buy()
        else
            self.model:GetAwardAll(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        end
    elseif name == "@_aorbtn_buySenior" then
        self.model:BuyUp()
    end
end

---按钮点击事件在这里派发
function FlyingChessSynBattlePassView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Back then
        self:Close()
    elseif go == self.go_table.aorbtn_add then
        if self.path == 0 then
            return
        end
        local content = self.pathCfg.content[1]
        local maxId = content[#content]
        local maxLv = _G.ConfigManager.store_season_battlecon_cfg[maxId].level
        if self.lv == maxLv then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        else
        end
    elseif go == self.go_table.aorbtn_getExp then
        self.ctrl:JumpGetExp()
    elseif go == self.go_table.aorbtn_buy then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_oneKey then
        self.awardLis = self.awardLis or {}
        if #self.awardLis > 0 then 
            self.model:GetAwardAll(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        end
    elseif go == self.go_table.aorbtn_switch then
        if not self.canSwitch then
            return
        end
        self.go_table.obj_choosePath:SetActiveE(1)
        self.go_table.obj_battlePass:SetActiveE(0)
        self.go_table.aorbtn_add:SetActiveE(0)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, self.ctrl:GetHelpId())
    end
end

function FlyingChessSynBattlePassView:ClickBuy()
    self:Buy()
end

function FlyingChessSynBattlePassView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.ctrl:OnUIClosed()
    _G.Events:GetInstance():RemoveListener(_G.eTeamUnite.Refresh, self.InitView, self)
end

return FlyingChessSynBattlePassView
