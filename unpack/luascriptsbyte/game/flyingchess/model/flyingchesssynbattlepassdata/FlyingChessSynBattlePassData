---进入活动
function FlyingChessSynBattlePassData:OnEnterActivity()
    local type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if type then
        if type == _G.JointActivityType.SpringFestival then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpringFestivalFlyingChessSynBattlePassView.Name, self.activity)
            return
        end
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FlyingChessSynBattlePassView.Name, self.activity)
end

---检测红点
function FlyingChessSynBattlePassData:CheckRedPoint()
    ---可领奖
    if self.curActivityClass:GetJumpType() and not _G.table.isEmptyOrNil(self:FindAllUnclaimedRewards(self.curActivityClass:GetJumpType())) then
        return 1
    end
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local key =
        _G.PlayerModel:GetInstance():GetPlayerUid() ..
        "DrawUpBattlePass" .. self.curActivityClass:GetActivityID() .. endTime
    ---首次开启
    if _G.PlayerPrefsManager.GetInt(key) ~= 1 then
        return 1
    end
    --ZHJH5ZHJH-12810 国庆节活动ZHJH-13792
    --【国庆活动】战令红点消不掉
    -- 加速按钮默认关闭了，先把红点逻辑注销
    -- local delta = _G.ConfigManager.discrete_cfg[108601][1][1]
    -- ---加速按钮开启
    -- if _G.PlayerPrefsManager.GetInt(key .. "Add") ~= 1 and _G.TimeUtil.GetServerUnixTime() >= endTime - delta * 86400 then
    --     return 1
    -- end
    return 0
end

function FlyingChessSynBattlePassData:SetOnSixUpdateCall(name, callback)
    if not self.onSixUpdateCall then
        self.onSixUpdateCall = {}
    end
    self.onSixUpdateCall[name] = callback
end

function FlyingChessSynBattlePassData:GetJumpModelType()
    return self.typeID or 10027
end

function FlyingChessSynBattlePassData:GetCoinId()
    return require "FlyingChessManager":GetInstance():GetCoinId(self.curActivityClass:GetJumpType())
end

function FlyingChessSynBattlePassData:GetTitle()
    return "ui_sqtj_sqbd_txt"
end

function FlyingChessSynBattlePassData:InitJump()
    self.GetJumpType =
    require "ActivitySynManager":GetInstance():GetChildAcitivity(
            10087,
            self.curActivityClass:GetJumpType()
    )
    if self.GetJumpType then
        self.ActivityID = self.GetJumpType.activityID
        require("FlyingChessManager"):GetInstance():ParseBPData(self.curActivityClass:GetJumpType(), self.msg)
    else
        self.ParseFail = true
        require("FlyingChessManager"):GetInstance():SetBPData(self.curActivityClass:GetJumpType(), self)
    end
end
return FlyingChessSynBattlePassData
