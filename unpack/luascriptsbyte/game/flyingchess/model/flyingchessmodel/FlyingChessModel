---掷色子
---@parm times 投掷次数
function FlyingChessModel:Roll(times,callBack)
    net:Roll(
        {
            activity_id = require("TeamUniteModel"):GetInstance():GetActivityID(),
            times = times
        },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:UseCoin(times)
            local addpoint=msg.step
            while(addpoint>54-self.nowpoint)do
                addpoint=addpoint-27
            end
            self:AddNowCircle(msg.step)
            if msg.map_award then
                self.map_award=msg.map_award
                if msg.circle_award then
                    self:RefreshAwardPreviewList(msg.circle_award)
                end
            end
            if msg.award and msg.circle_award then
                --_G.StorageManager:GetInstance():ReceiveAwardData(msg.award)
                --for i = 1, #msg.award.item do
                --    table.insert(self.award,{type={[1]=msg.award.item[i].type[1],[2]=msg.award.item[i].type[2],[3]=msg.award.item[i].type[3]}})
                --end
                table.sort(msg.award.item,function(a,b)
                    local anum=self:AwardIsDaJiang(a,msg.circle_award)
                    local bnum=self:AwardIsDaJiang(b,msg.circle_award)
                    return anum>bnum
                end)
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                for _, v in pairs(msg.award.item) do
                    if v.type[1] == 71 then
                        self:AddCoin(v.type[2])
                    end
                end
                callBack(addpoint,msg)--{award={item=self.award}})
            else
                callBack(addpoint)
            end
        end
    )
end
function FlyingChessModel:AddNowCircle(addpoint)
    if self.nowpoint+addpoint>26 then
        self.circle=self.circle+1
        addpoint=self.nowpoint+addpoint-27
        self.nowpoint=0
        self:AddNowCircle(addpoint)
    else
        self.nowpoint=self.nowpoint+addpoint
    end
end
---@param award award.i_award
---@return  System.Int32 普通奖励0,转圈奖励1,大奖2
function FlyingChessModel:AwardIsDaJiang(award,circle_award)
    local sid,num
    sid= award.type[1]
    num = award.type[2]
    local awardcfg={}
    for i = 1, table.count(circle_award) do
        awardcfg=_G.ConfigManager.team_checkers_reward_cfg[circle_award[i].v]
        if awardcfg.item[1]==sid and num== awardcfg.item[2] then
            local dajiang=table.find(self.dajianglist,function(a)
                if  a.circle== circle_award[i].k then
                    return true
                end
            end)
            if dajiang then
                return 2
            end
            return 1
        end
    end
    return 0
end

---奖励预览数据
function FlyingChessModel:InitAwardPreviewList()
    self.awardPreviewList={}
    self.dajianglist={}
    self.initPreviewList={}
    local saiji=_G.ConfigManager.team_cfg[self.term]
    local awardCfg={}
    local awards={}
    local awardItemcfg={}
    local getTime=0
    for i=1 , #saiji.circle do
        awards={}
        awardCfg=_G.ConfigManager.team_checkers_cfg[saiji.circle[i][1]]
        for j = 1, #awardCfg.pool1 do
            getTime=self:GetAwardGetTimeInRange(saiji.circle[i][2],saiji.circle[i][3],awardCfg.pool1[j][1])
            table.insert(awards,{num=awardCfg.pool1[j][2]-getTime,award=awardCfg.pool1[j][1]})
        end
        awardItemcfg=_G.ConfigManager.team_checkers_reward_cfg[awardCfg.reward[1]]
        getTime=self:GetAwardGetTimeInRange(saiji.circle[i][2],saiji.circle[i][3],awardCfg.reward[1])
        if #awardCfg.reward>0 then
            table.insert(self.dajianglist,{circle=saiji.circle[i][3],num=awardCfg.reward[2]-getTime,award=awardCfg.reward[1]})
        end
        table.insert(self.awardPreviewList,{min=saiji.circle[i][2],max=saiji.circle[i][3],awards=awards})
        table.insert(self.initPreviewList,{min=saiji.circle[i][2],max=saiji.circle[i][3],awards=awards})
        if i==#saiji.circle then
            self.maxcircle=saiji.circle[i][3]
        end
    end
end
---圈数奖励获取记录中获取一个圈数范围内的某一个奖励的获取次数
function FlyingChessModel:GetAwardGetTimeInRange(minindex,maxindex,id)
    local num=0
    if self.circle_award then
        for k,v in pairs(self.circle_award) do
            if v.k>=minindex and v.k<=maxindex then
                if v.v==id then
                    num=num+1
                end
            end
        end
    end
    return num
end
function FlyingChessModel:RefreshAwardPreviewList(circle_award)
    for i = 1, table.count(circle_award) do
        local AwardPreviewItem=table.find(self.awardPreviewList,function(a)
            if a.min<=circle_award[i].k and a.max>=circle_award[i].k then
                return true
            end
        end)
        local dajiangitem=table.find(self.dajianglist,function(a)
            if a.circle==AwardPreviewItem.max then
                return true
            end
        end)
        if dajiangitem and dajiangitem.award==circle_award[i].v then
            dajiangitem.num=dajiangitem.num-1
        end
        for j = 1, table.count(AwardPreviewItem.awards) do
            if AwardPreviewItem.awards[j].award==circle_award[i].v then
                AwardPreviewItem.awards[j].num=AwardPreviewItem.awards[j].num-1
            end
        end
        table.insert(self.circle_award,circle_award[i])
    end
end
---奖励拆分
function FlyingChessModel:AwardSplit(msg)
    local ordanaryaward={}
    local dajiangaward={}
    if msg.award and msg.award.item and  #msg.award.item>0 then
        if msg.circle_award and #msg.circle_award>0 then
            for _,v in pairs(msg.award.item) do
                local isdajiang= self:AwardIsDaJiang(v,msg.circle_award)
                if isdajiang ~= 0 then
                    if not dajiangaward.award then
                        dajiangaward.award={item={}}
                    end
                    table.insert(dajiangaward.award.item,v)
                else
                    if not ordanaryaward.award then
                        ordanaryaward.award={item={}}
                    end
                    table.insert(ordanaryaward.award.item,v)
                end
            end
        else
            ordanaryaward={award=msg.award}
        end
    end
    return ordanaryaward,dajiangaward
end

function FlyingChessModel:GetNowDaJiangList()
    for i = 1, #self.awardPreviewList do
        if self.circle>=self.awardPreviewList[i].min and self.circle<=self.awardPreviewList[i].max then
            return self.awardPreviewList[i]
        end
    end
    return self.awardPreviewList[#self.awardPreviewList]
end
