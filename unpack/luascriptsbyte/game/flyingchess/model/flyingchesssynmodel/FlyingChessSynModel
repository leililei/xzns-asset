---掷色子
---@parm times 投掷次数
function FlyingChessSynModel:Roll(times, callBack)
    net:ActivityRoll(
            {
                activity_id = self.activityId,
                times = times
            },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self:UseCoin(times)
                local addpoint = msg.step
                while (addpoint > 54 - self.nowpoint) do
                    addpoint = addpoint - 27
                end
                self:AddNowCircle(msg.step)
                if msg.map_award then
                    self.map_award = msg.map_award
                    if msg.circle_award then
                        self:RefreshAwardPreviewList(msg.circle_award)
                    end
                end
                if msg.award and msg.circle_award then
                    table.sort(msg.award.item, function(a, b)
                        local anum = self:AwardIsDaJiang(a, msg.circle_award)
                        local bnum = self:AwardIsDaJiang(b, msg.circle_award)
                        return anum > bnum
                    end)
                end
                if msg.award then
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    for _, v in pairs(msg.award.item) do
                        if v.type[1] == self.coinId then
                            self:AddCoin(v.type[2])
                        end
                    end
                    callBack(addpoint, msg)--{award={item=self.award}})
                else
                    callBack(addpoint)
                end
            end
    )
end
function FlyingChessSynModel:AddNowCircle(addpoint)
    if self.nowpoint + addpoint > 26 then
        self.circle = self.circle + 1
        addpoint = self.nowpoint + addpoint - 27
        self.nowpoint = 0
        self:AddNowCircle(addpoint)
    else
        self.nowpoint = self.nowpoint + addpoint
    end
end
---@param award award.i_award
---@return  System.Int32 普通奖励0,转圈奖励1,大奖2
function FlyingChessSynModel:AwardIsDaJiang(award, circle_award)
    local sid, num
    sid = award.type[1]
    num = award.type[2]
    local awardcfg = {}
    for i = 1, table.count(circle_award) do
        awardcfg = _G.ConfigManager.team_checkers_reward_cfg[circle_award[i].v]
        if awardcfg.item[1] == sid and num == awardcfg.item[2] then
            local dajiang = table.find(self.dajianglist, function(a)
                if a.circle == circle_award[i].k then
                    return true
                end
            end)
            if dajiang then
                return 2
            end
            return 1
        end
    end
    return 0
end

---奖励预览数据
function FlyingChessSynModel:InitAwardPreviewList()
    self.awardPreviewList = {}
    self.dajianglist = {}
    self.initPreviewList = {}
    local awardCfg = {}
    local awards = {}
    local awardItemcfg = {}
    local getTime = 0
    for k, v in pairs(self.checkers) do
        awards = {}
        awardCfg = _G.ConfigManager.team_checkers_cfg[v.sid]
        for j = 1, #awardCfg.pool1 do
            getTime = self:GetAwardGetTimeInRange(v.start_cycle, v.end_cycle, awardCfg.pool1[j][1])
            table.insert(awards, { num = awardCfg.pool1[j][2] - getTime, award = awardCfg.pool1[j][1] })
        end
        awardItemcfg = _G.ConfigManager.team_checkers_reward_cfg[awardCfg.reward[1]]
        getTime = self:GetAwardGetTimeInRange(v.start_cycle, v.end_cycle, awardCfg.reward[1])
        if #awardCfg.reward > 0 then
            table.insert(self.dajianglist, { circle = v.end_cycle, num = awardCfg.reward[2] - getTime, award = awardCfg.reward[1] })
        end
        table.insert(self.awardPreviewList, { min = v.start_cycle, max = v.end_cycle, awards = awards })
        table.insert(self.initPreviewList, { min = v.start_cycle, max = v.end_cycle, awards = awards })
        if k == #self.checkers then
            self.maxcircle = v.end_cycle
        end
    end
end
