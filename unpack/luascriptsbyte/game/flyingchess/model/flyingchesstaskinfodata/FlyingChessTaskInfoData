---@class FlyingChessTaskInfoData	限时招募
local FlyingChessTaskInfoData = _G.BaseClass("FlyingChessTaskInfoData", _G.LogicClass)

function FlyingChessTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function FlyingChessTaskInfoData:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FlyingChessSynTaskView.Name, self.curActivityClass)
end
---领取奖励
function FlyingChessTaskInfoData:GetAward(ids,call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local JumpType = self.curActivityClass:GetJumpType()
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            local exp = 0
            for _, v in pairs(ids) do
                local task = self.activity:GetTaskData(v)
                if not msg.award or not msg.award.item then
                    msg.award = {item = {}}
                end
                for _, reward in pairs(task.Cfg.reward) do
                    local item = reward.type
                    if item[4] and item[5] then
                        if require "FlyingChessManager":GetInstance():GetCoinId(JumpType) == item[4] then
                            require "FlyingChessManager":GetInstance():AddCoin(JumpType, item[5])
                        end
                    end
                end
                if task.Cfg.other_award[1] then
                    exp = exp + task.Cfg.other_award[1].num
                end

                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            require("FlyingChessManager"):GetInstance():AddExp(self.curActivityClass:GetJumpType(), exp)
            require("FlyingChessManager"):GetInstance():RefreshRedPoint(self.curActivityClass:GetJumpType(), 4)

            if call then
                call()
            end
        end
    )
end
function FlyingChessTaskInfoData:GetJumpModelType()
    return 10087
end
return FlyingChessTaskInfoData
