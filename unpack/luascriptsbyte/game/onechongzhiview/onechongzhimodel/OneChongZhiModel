local base = require "ActivitySynTypeBase"
---@class OneChongZhiModel : Singleton	单笔充值
local OneChongZhiModel = _G.BaseClass("OneChongZhiModel", base)
---创建对象时,入口构造函数
function OneChongZhiModel:__init()
    self.info = {cash_num = 0, state = 0}
    self.state = 1 --充值状态
    _G.Events:GetInstance():AddListener(_G.eRechargeEvent.OneCash, self.EventCash, self)
end

---销毁对象时,析构函数
function OneChongZhiModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.OneCash, self.EventCash, self)
    self.info = nil
    self.state = nil
end
function OneChongZhiModel:GetDataFormServer()
    local activity = self.curActivityClass:GetActivityID()
    local msg = {
        activity_id = activity
    }
    require "OneChongZhiNet":GetInstance():One_cash_info(msg, _G.handler(self, self.ParseData))
    --self:ParseData()
end
---断线重连
function OneChongZhiModel:ReConnect(endcall)
    --重新获取数据
    local activity = self.curActivityClass:GetActivityID()
    local msg = {
        activity_id = activity
    }
    require "OneChongZhiNet":GetInstance():One_cash_info(
        msg,
        function(data)
            self.info = data.info
            self:InitFunction()
            --重新拉取数据信息
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OneChongZhiView.Name)
            if view ~= nil then
                view:UpdateViewOneChongzhi()
            end
            if endcall then
                endcall()
            end
        end
    )
end

---数据解析完成
---@field info activity_cfg_one_cash.i_one_cash_info
---cash_num ;  //  单笔最高金额，（单位：分）
---state //0：未领取，1：已领取
function OneChongZhiModel:ParseData(data)
    if data.ack ~= 1 then
        base.ParseData(self)
        return
    end
    self.info = data.info
    base.ParseData(self)
end
function OneChongZhiModel:InitFunction()
    local coin = _G.ConfigManager.discrete_cfg[106202][1][1]
    if self.info.state == 1 then --已经领取
        self.state = 0
        self.curActivityClass:ChangeState(1)
    else
        coin = coin
        if self.info.cash_num < coin then
            self.state = 1 --充值
        else
            self.state = 2 --可领取
        end
    end
end
function OneChongZhiModel:SetAwardState()
end
function OneChongZhiModel:EventCash()
    local coin = _G.ConfigManager.discrete_cfg[106202][1][1]
    local msg = {
        activity_id = self.curActivityClass:GetActivityID() --1010401 --self.curAcvivityClass:GetActivityID()
    }
    require "OneChongZhiNet":GetInstance():One_cash_info(
        msg,
        function(data)
            if data.ack ~= 1 then
                return
            end
            self.info = data.info
            if data.info.state == 1 then --已经领取
            else
                coin = coin
                self.info = data.info
                if data.info.cash_num < coin then
                    self.state = 1 --充值
                else
                    self.state = 2 --可领取
                    self:UpdateRedpoint()
                end
            end
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OneChongZhiView.Name)
            if view ~= nil then
                view:UpdateViewOneChongzhi()
            end
        end
    )
end
---查看领取的状态
function OneChongZhiModel:CheckAwardState()
    return self.state == 2
end
function OneChongZhiModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.OneChongZhiView.Name, self.curActivityClass)
end
function OneChongZhiModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.OneChongZhiView.Name
end
--领取额外奖励
function OneChongZhiModel:LingquAward(call)
    require "ActivitySynNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        nil,
        function(data)
            if data.ack ~= 1 then
                return
            end
            self.state = 0
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self:UpdateRedpoint()
            if call then
                call()
            end
        end
    )
    self.state = 0
end
---初始化红点
function OneChongZhiModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckFirstLogin}
    self.redpointTree = {{4}, false}
end
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function OneChongZhiModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
--红点
function OneChongZhiModel:UpdateRedpoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    require("RedPointManager"):GetInstance():RefreshNode(0)
end
---是否 每日的首次登录
function OneChongZhiModel:CheckFirstLogin()
    return self:CheckAwardState() and 1 or 0
end
return OneChongZhiModel
