local base = require("BaseGameNet")

---@class OneChongZhiNet : BaseGameNet	通信协议
local OneChongZhiNet = _G.BaseClass("OneChongZhiNet", base)
---@return OneChongZhiNet OneChongZhiNet
function OneChongZhiNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function OneChongZhiNet:One_cash_info(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_port_one_cash_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallAccess))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function OneChongZhiNet:CallAccess(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return OneChongZhiNet
