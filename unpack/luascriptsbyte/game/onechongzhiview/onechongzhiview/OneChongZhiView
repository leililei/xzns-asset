---@class OneChongZhiView : UIBaseView	中文描述
---@field public go_table OneChongZhiView_GoTable GoTable
local OneChongZhiView = _G.BaseClass("OneChongZhiView", _G.UIBaseView)
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
function OneChongZhiView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function OneChongZhiView:OnCreate(data)
    self.info = data.typeClass.info
    self.typeClass = data.typeClass
    self.data = data
    self.skillnode = {
        [1] = self.go_table.aorrawimage_skill_1,
        [2] = self.go_table.aorrawimage_skill_2,
        [3] = self.go_table.aorrawimage_skill_3,
        [4] = self.go_table.aorrawimage_skill_4
    }
    if version == 1 then
        self.go_table.aorrawimage_hunyu:SetActiveE(0)
        self.go_table.obj_tips:SetActiveE(0)
    elseif version == 2 then
        self.go_table.aorrawimage_hunyu:SetActiveE(1)
        self.go_table.obj_tips:SetActiveE(1)
    end
    self:ShowUISpine()
    self:UpdateBtn()
    self:UpDateScorllView()
    self:UpdateSkill()
    self:UIEffect()
    self:ShowUIEffect()
end
function OneChongZhiView:UpdateViewOneChongzhi()
    self:UpdateBtn()
    self:UpDateScorllView()
end
function OneChongZhiView:ShowUISpine()
    local path = _G.ConfigManager.ui_effect_cfg["prf_chiche"]
    _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_spine)
end
function OneChongZhiView:ShowUIEffect()
    local path = _G.ConfigManager.ui_effect_cfg["ef_ContinueRecharge_mid_once"]
    _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_uieffect_piao)
    path = _G.ConfigManager.ui_effect_cfg["ef_DrawResultRole_Name"]
    _G.UIUtils.LoadEffectByCfg(
        path,
        self.go_table.obj_uieffect_name,
        function(obj)
            obj:SetLocalPosition(0, 0, 0)
        end
    )
end
function OneChongZhiView:UIEffect()
    local path = _G.ConfigManager.ui_effect_cfg["ef_OneChongZhiView_648_loop"]
    _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_uieffect_wenzi)
    path = _G.ConfigManager.ui_effect_cfg["ef_OneChongZhiView_kuang_loop"]
    _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_uieffect_kuang)
    path = _G.ConfigManager.ui_effect_cfg["ef_ContinueRecharge_mid_once"]
    _G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_uieffect_piao)
    path = _G.ConfigManager.ui_effect_cfg["ef_DrawResultRole_Name"]
    _G.UIUtils.LoadEffectByCfg(
        path,
        self.go_table.obj_uieffect_name,
        function(obj)
            obj:SetLocalPosition(0, 0, 0)
        end
    )
end
function OneChongZhiView:UpdateSkill()
    local cardid = self.lists[1][1]
    local cfg = _G.ConfigManager.card_cfg[cardid]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.Log("未找到卡牌id ：" .. cardid)
        end
        return
    end

    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.Name)
    local cardlevel = 300
    local mySkills = {}
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local card_level_Item = _G.ConfigManager.card_level_cfg[cardlevel]
    local skillLvList = card_level_Item.level_skill[cfg.Order]

    local skillid, skillCfg, skilllv

    if skillLvList ~= nil then
        for i = 1, 5 do
            skilllv = skillLvList[i]
            if skilllv ~= nil and skilllv > 0 then
                skillid = cardid + i * 100 + skilllv
                skillCfg = card_skills_cfg[skillid]
                if skillCfg ~= nil then
                    mySkills[i] = {
                        skillId = skillid,
                        cfg = skillCfg
                    }
                end
            end
        end
        --- 当前技能
        self.Skills = {
            --绝招
            [1] = mySkills[1],
            --普攻
            --[2] = mySkills[2],
            --小技能 1
            [2] = mySkills[3],
            --小技能 2
            [3] = mySkills[4],
            --小技能 3
            [4] = mySkills[5]
        }
    end
    for i = 1, 4 do
        local icon = self.Skills[i].cfg.icon
        self.skillnode[i]:LoadImage(icon)
    end
end
function OneChongZhiView:CardSkillTips(index)
    local skill_id = self.Skills[index].skillId
    require "CommonTipManager":GetInstance():OpenSkillTip(skill_id)
end
function OneChongZhiView:UpDateScorllView()
    self.lists = _G.ConfigManager.discrete_cfg[106201]
    if self.mScorll == nil then
        self.go_table.scrollloophorizontal_iterm:InitItemData(#self.lists, _G.handler(self, self.RefreshItem))
        self.mScorll = self.go_table.scrollloophorizontal_iterm
    else
        self.mScorll:UpdateAllItem()
    end
end
---刷新展示的卡牌
function OneChongZhiView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    obj:SetName(index + 1)
    local ind = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ItemOnclick, self.lists[1][1]))
    local awrad = self.lists[index + 1]
    --第一个必定是卡牌
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_check, ind == 1)
    if tb.obj_node:GetChildCountE() > 0 then
        for i = 1, tb.obj_node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(tb.obj_node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    _G.StorageManager:GetInstance():GetItemBaseView(
        awrad[1],
        awrad[2],
        tb.obj_node,
        function(item)
            item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            local storagetype = _G.StorageManager:GetInstance():CheckSidType(awrad[1])
            if storagetype == _G.StorageType.Equipment then
                ---装备的属性
                item:ShowElement(awrad[3])
            end
        end,
        function(go)
            local storagetype = _G.StorageManager:GetInstance():CheckSidType(awrad[1])
            if storagetype == _G.StorageType.Card then
            elseif storagetype == _G.StorageType.Equipment then
                require "CommonTipManager":GetInstance():OpenEquipmenTip(awrad[1], nil, awrad[3])
            else
                require "CommonTipManager":GetInstance():OpenTip(go.gameObject, awrad[1])
            end
        end
    )
    return obj
end
function OneChongZhiView:ItemOnclick(go, isOn, cardsid)
    if not self.data:CheckActivityInteractable() then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
        cardsid,
        function()
            --_G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DungonesMainEventView.Name)
        end,
        true
    )
end
function OneChongZhiView:UpdateBtn()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_go, self.typeClass.state == 1) --充值
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_ling, self.typeClass.state == 2) --可领取
end

function OneChongZhiView:CloseView()
    self:Close()
end
---按钮点击事件在这里派发
function OneChongZhiView:OnClickBtn(go)
    if not self.data:CheckActivityInteractable() then
        return
    end
    if go == self.go_table.aorbtn_go then
        --前往充值界面
        _G.JumpManager:GetInstance():Jump(108001)
    elseif go == self.go_table.aorbtn_ling then
        --领取
        self.typeClass:LingquAward(
            function()
                self.data:ChangeState(1)
                self:UpdateBtn()
            end
        )
    elseif go == self.go_table.aorbtn_1 then
        self:CardSkillTips(1)
    elseif go == self.go_table.aorbtn_2 then
        self:CardSkillTips(2)
    elseif go == self.go_table.aorbtn_3 then
        self:CardSkillTips(3)
    elseif go == self.go_table.aorbtn_4 then
        self:CardSkillTips(4)
    end
end

return OneChongZhiView
