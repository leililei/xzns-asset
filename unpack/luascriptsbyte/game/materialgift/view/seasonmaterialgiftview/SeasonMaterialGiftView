---@class SeasonMaterialGiftView : UIBaseView	中文描述
---@field public go_table MaterialGiftView_GoTable GoTable
local SeasonMaterialGiftView = _G.BaseClass("SeasonMaterialGiftView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local extraCfg = _G.ConfigManager.store_extra_cfg
local StorageManager
local GameUtil = _G.GameUtil
local TimeUtil = _G.TimeUtil
local typeLangua = {
    [1] = {90000011033, 90000011034, 90000011035},
    [2] = {90000011038, 90000011039, 90000011040}
}
local OrderName = {
    "ui_qrcz_chengse_yxtxk",
    "ui_qrcz_chengse_yxtxk",
    "ui_qrcz_chengse_yxtxk",
    "ui_qrcz_chengse_yxtxk",
    "ui_qrcz_hongse_yxtxk",
    "ui_qrcz_jingse_yxtxk",
    "ui_qrcz_caise_yxtxk"
}

function SeasonMaterialGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonMaterialGiftView:OnCreate()
    StorageManager = _G.StorageManager:GetInstance()
    local SeasonMaterialGiftModel = require ("SeasonMaterialGiftModel")
    self.cfg = SeasonMaterialGiftModel:GetInstance():GetCfg()
    if not self.cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("赛季七日粉将没有活动数据！")
        end
        self:CloseView()
        return
    end
    self.go_table.aortext_time.text = ""
    self.giftList = self.cfg.store_extra
    self.buyList = SeasonMaterialGiftModel:GetInstance().buyList
    self.curDay = require ("SeasonModel"):GetInstance().curDay
    self:InitDayList()
    self.go_table.aortext_limit.text = _G.GetLangPackValue(90022900063) .. _G.GetLangPackValue(90027000004, 1)

    -- self:LoadEffect()
end

function SeasonMaterialGiftView:InitDayList()
    self.DayTbList = {}
    local stars = _G.ConfigManager.discrete_cfg[119003][1]
    local order, starCount
    for i = 1, 7 do
        ---@type MaterialGiftView._aorbtn_Day1_GoTable
        local tb = _G.GetAutoGoTable(self.go_table["aorbtn_Day" .. i], _G.handlerbind(self, self.OnClickDay, i))
        self.DayTbList[i] = tb
        tb.aortext_Day.text = GetLangPackValue(90023800019, i)
        local dataSid = self.giftList[i]
        local data = extraCfg[dataSid]
        if not self.buyList[dataSid] and not self.curIndedx then
            self.curIndedx = i
        end
        if self.buyList[dataSid] then
            tb.aorimage_buy:SetActiveE(1)
        end
        tb.awardData = data
        order, starCount = CardInfoManager:GetInstance():GetOrderStarCount(stars[i] or 5)
        tb.aorimage_bg.SpriteName = OrderName[order]
        for j = 1, 5 do
            tb["aorimage_star" .. j]:SetActiveE(j <= starCount and 1 or 0)
        end
    end
    self:InitAwardItems()
end

function SeasonMaterialGiftView:InitAwardItems()
    self.awardList = {}
    if not self.curIndedx then
        self.curIndedx = 1
    end
    for i = 1, 4 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
        self.awardList[i] = tb
    end
    self:ChangeSelect()
end

---界面的销毁函数
function SeasonMaterialGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function SeasonMaterialGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_buy then
        if self.curDay < self.curIndedx then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                3805,
                GetLangPackValue(90000011037, self.curIndedx - self.curDay)
            )
            return
        end
        local data = self.DayTbList[self.curIndedx]
        if self.buyList[data.awardData.id] then
            return
        end
        require ("SeasonMaterialGiftModel"):GetInstance():BuyGift(
            extraCfg[self.giftList[self.curIndedx]],
            self.cfg.id,
            _G.handler(self, self.BuyBack)
        )
    elseif go == self.go_table.aorbtn_next then
        self.curIndedx = self.curIndedx + 1
        self:ChangeSelect()
    elseif go == self.go_table.aorbtn_before then
        self.curIndedx = self.curIndedx - 1
        self:ChangeSelect()
    elseif go == self.go_table.aorbtn_closeView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_anyclose then
        self:CloseView()
    end
end

function SeasonMaterialGiftView:OnClickDay(go, isOn, index)
    if index == self.curIndedx then
        return
    end
    self.curIndedx = index
    self:ChangeSelect()
end

function SeasonMaterialGiftView:ChangeSelect()
    if self.curIndedx == 7 then
        self.go_table.aorbtn_next:SetActiveE(0)
        self.go_table.aorbtn_before:SetActiveE(1)
    elseif self.curIndedx == 1 then
        self.go_table.aorbtn_before:SetActiveE(0)
        self.go_table.aorbtn_next:SetActiveE(1)
    else
        self.go_table.aorbtn_next:SetActiveE(1)
        self.go_table.aorbtn_before:SetActiveE(1)
    end
    if self.chooseEff then
        self.chooseEff:SetParentE(self.go_table["aorbtn_Day" .. self.curIndedx])
    end
    self.go_table.obj_choose:SetParentE(self.DayTbList[self.curIndedx].obj_choose)
    self.go_table.obj_choose:SetLocalPositionToZero()
    self.go_table.aorimage_curPt:SetParentE(self.go_table["aorimage_pt" .. self.curIndedx])
    self:UpdateItems()
end

function SeasonMaterialGiftView:UpdateBuyBtn()
    local data = self.DayTbList[self.curIndedx]
    self.DayTbList[self.curIndedx].aorimage_buy:SetActiveE(0)
    if self.buyList[data.awardData.id] then
        self.DayTbList[self.curIndedx].aorimage_buy:SetActiveE(1)
        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("414141")
        self.go_table.aortext_charge.text = GetLangPackValue(90022500421)
    elseif self.curDay < self.curIndedx then
        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("414141")
        self.go_table.aortext_charge.text = GetLangPackValue(90000011037, self.curIndedx - self.curDay)
    else
        self.go_table.aorbtn_buy:SetGray(false)
        self.go_table.aortext_charge.color = require("CardInfoManager").GetColorFromRGB("815633")
        local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(data.awardData.price)
        if info ~= nil then
            self.go_table.aortext_charge.text = info.formattedPrice .. GetLangPackValue(90021000017)
        else
            local price = GameUtil.RatioControl(data.awardData.price)
            if _G.AppSetting.IsOverseas then
                self.go_table.aortext_charge.text = GetLangPackValue(90000010807, price)
            else
                self.go_table.aortext_charge.text = GetLangPackValue(90000010819, price)
            end
        end
    end
end

function SeasonMaterialGiftView:UpdateItems()
    self:UpdateBuyBtn()
    self.go_table.aortext_tips.text = _G.GetLangPackValue(90023800136, _G.GameUtil.NumberToChinese(self.curIndedx))
    local data = self.DayTbList[self.curIndedx]
    local lock = 0
    if self.curDay < self.curIndedx or self.buyList[data.awardData.id] then
        lock = 1
    end
    for i = 1, 4 do
        local tb = self.awardList[i]
        tb.gameObject:SetActiveE(0)
        if data.awardData.goods[i] then
            tb.obj_item:ClearChildren()
            tb.item = nil
            -- if not tb.item then
            StorageManager:GetItemBaseViewNew(
                data.awardData.goods[i],
                tb.obj_item,
                function(tran)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    tran.gameObject:SetLocalScaleXYZ(0.84)
                    tb.item = tran
                    if tb.item.SetGradeNew then
                        tb.item:SetGradeNew(false)
                    end
                end
            )
            -- else
            --     tb.item:SetImage(data.awardData.goods[i][1])
            --     tb.item:ShowCount(data.awardData.goods[i][2])
            --     tb.item:UpdateFunction(_G.handlerbind(self, self.ShowTips,data.awardData.goods[i][1]))
            --     if tb.item.SetGradeNew then
            --         tb.item:SetGradeNew(false)
            --     end
            -- end
            --tb.aorimage_lock:SetActiveE(lock)
            tb.gameObject:SetActiveE(1)
        end
    end
end

function SeasonMaterialGiftView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jinshenghaoli,
        self.go_table.obj_lightEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

function SeasonMaterialGiftView:TimerFunc(time)
    local time = TimeUtil.TranslateSecondForDHMOrHMS(time)
    self.go_table.aortext_time.text = GetLangPackValue(90028500004, time)
end

function SeasonMaterialGiftView:BuyBack()
    self:UpdateItems()
end

function SeasonMaterialGiftView:ShowTips(go, got, isOn, rewardsid)
    require("CommonTipManager"):GetInstance():OpenPropTip(go.gameObject, rewardsid)
end

function SeasonMaterialGiftView:CloseView()
    if self.ActivityData then
        self.ActivityData.timerFunc = nil
    end
    self:Close()
end

return SeasonMaterialGiftView
