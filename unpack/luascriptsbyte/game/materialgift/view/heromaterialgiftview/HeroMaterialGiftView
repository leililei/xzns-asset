local baseView = require("MaterialGiftBaseView")
---@class HeroMaterialGiftView : MaterialGiftBaseView	魂将材料礼包
local HeroMaterialGiftView = _G.BaseClass("HeroMaterialGiftView", baseView)

local GetLangPackValue = _G.GetLangPackValue

function HeroMaterialGiftView:OnClickBuyBtn()
    baseView.OnClickBuyBtn(self, function()
        self:UpdateView()
    end)
end

function HeroMaterialGiftView:OnViewCreate()
    local sid = self.activity.item[1].icon
    self.cardCfg = _G.ConfigManager.card_cfg[_G.tonumber(sid)]
    self:UpdateView()
    self:RefreshRoleIcon()
    self:SetActivityTimer()
end

function HeroMaterialGiftView:UpdateView()
    self:RefreshDailyItem()
    self:RefreshItemAward()
end

---刷新立绘
function HeroMaterialGiftView:RefreshRoleIcon()
    self.go_table.aorrawimage_icon:SetActiveE(0)
    self.go_table.aorrawimage_icon:LoadImage(
        self.activity.image,
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetNativeSize()
            local pos_dev = _G.string.split2tbl(self.activity.pos_dev, "#")
            trans:SetLocalPosition(pos_dev[1], pos_dev[2], 0)
            trans:SetLocalScaleXYZ(pos_dev[3])
            trans:SetActiveE(1)
        end
    )
end

---刷新item奖励
function HeroMaterialGiftView:RefreshItemAward()
    local awardData = self.activity.item[self.selectIndex].award
    self.awardData = {}
    for _, v in pairs(awardData) do
        _G.table.insert(self.awardData, v.type)
    end
    local itemCount = #self.awardData
    self:RefreshAwardList(itemCount)
    self:RefreshButton()
end

---初始化奖励item
function HeroMaterialGiftView:RefreshList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetItemBaseViewNew(
        self.awardData[index + 1],
        tb.obj_item,
        function(tran)
            if _G.IsNil(tb.obj_item) then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalScaleXYZ(0.8)
            tb.item = tran
            if tb.item.SetGradeNew then
                tb.item:SetGradeNew(false)
            end
            tb.gameObject:SetActiveE(1)
        end
    )
end

---刷新商品item
function HeroMaterialGiftView:RefreshDailyItem()
    for i = 1, self.dailyItemCount do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClickItem, i))
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.ItemCardStorageView,
            tb.obj_Item,
            function(item)
                if _G.IsNil(tb.obj_Item) then
                    _G.DestroyObject(item)
                    return
                end

                item:Show(self.cardCfg.sid, nil, 1)
                item:HideOrShowLevel(false)
                item:HideOrShowElements(false)
                item.go_table.obj_Selected:SetActiveE(self.selectIndex == i and 1 or 0)
                self.awardItemList[i] = item
            end
        )
        local data = self.activity.item[i]
        tb.aortext_tip.text = data.name
        tb.aortext_txt.text = GetLangPackValue(90023800019, _G.GameUtil.NumberToWordByLanguage(data.day))
        if self.activity:CheckIsBuy(data.sid) then
            tb.aorimage_buy:SetActiveE(1)
        end
    end
end

function HeroMaterialGiftView:OnClickItem(obj, isOn, index)
    if self.selectIndex == index then
        return
    end
    for i, v in pairs(self.awardItemList) do
        v.go_table.obj_Selected:SetActiveE(index == i and 1 or 0)
    end
    self.selectIndex = index
    self:RefreshItemAward()
end

---@param newIndex number 新的索引
function HeroMaterialGiftView:onClickSwitchBtn(newIndex)
    self:OnClickItem(nil, nil, newIndex)
end

function HeroMaterialGiftView:Dispose()
    self:StopAllTimer()
    self.go_table = nil
end

return HeroMaterialGiftView