local baseView = require("MaterialGiftBaseView")
local ArtifactData = require("ArtifactData")
local ArtifactMaterialGiftView = _G.BaseClass("ArtifactMaterialGiftView", baseView)

local GetLangPackValue = _G.GetLangPackValue
local tonumber = _G.tonumber

---按钮点击事件
function ArtifactMaterialGiftView:OnClickBtn(go, isOn)
    baseView.OnClickBtn(self, go, isOn)
    if go == self.go_table.aorbtn_tip then
        self:OnClickDetailBtn()
    end
end

---@param newIndex number 新的索引
function ArtifactMaterialGiftView:onClickSwitchBtn(newIndex)
    self:OnClickItem(nil, nil, newIndex)
end

---购买按钮点击事件
function ArtifactMaterialGiftView:OnClickBuyBtn()
    baseView.OnClickBuyBtn(self, function()
        self:UpdateView()
    end)
end

---@param activityClass ActivitySynBase
function ArtifactMaterialGiftView:OnViewCreate()
    local icon = self.activity.item[1].icon
    local iconList =  _G.string.split2tbl(icon, '#')
    self.artifactCfg = _G.ConfigManager.artifact_cfg[tonumber(iconList[1])]
    self:UpdateView()
    self:RefreshRoleIcon()
    self:SetActivityTimer()
end

---刷新界面
---@param activityClass ActivitySynBase
function ArtifactMaterialGiftView:UpdateView()
    self:RefreshDailyItem()
    self:RefreshItemAward()
end

---刷新商品item
function ArtifactMaterialGiftView:RefreshDailyItem()
    for i = 1, self.dailyItemCount do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClickItem, i))
        tb.aorrawimage_icon:LoadImage(
            self.artifactCfg.image_1,
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:SetLocalScaleXYZ(0.8)
                trans:SetActiveE(1)
            end
        )
        local data = self.activity.item[i]
        tb.aortext_tip.text = data.name
        tb.aortext_txt.text = GetLangPackValue(90023800019, _G.GameUtil.NumberToWordByLanguage(data.day))
        tb.aorimage_iconBg.SpriteName = _G.ArtifactItemIconName[self.artifactCfg.Order]
        local iconList =  _G.string.split2tbl(data.icon, '#')
        local star = tonumber(iconList[2])
        if star > 0 then
            for i = 1, star do
                tb["obj_star" .. i]:SetActiveE(1)
            end 
        end
        if self.activity:CheckIsBuy(data.sid) then
            tb.aorimage_buy:SetActiveE(1)
        end
        self.awardItemList[i] = tb
    end
end

function ArtifactMaterialGiftView:OnClickItem(obj, isOn, index)
    if self.selectIndex == index then
        return
    end
    if self.chooseEff then
        self.chooseEff:SetParentE(self.awardItemList[index].obj_Item)
    end
    self.selectIndex = index
    self:RefreshItemAward()
end

---刷新立绘
function ArtifactMaterialGiftView:RefreshRoleIcon()
    local icon = _G.string.split2tbl(self.activity.image, "#")
    self.go_table.aorrawimage_icon:SetActiveE(0)
    self.go_table.aorrawimage_icon:LoadImage(
        icon[1],
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetNativeSize()
            local pos_dev = _G.string.split2tbl(self.activity.pos_dev, "#")
            trans:SetLocalPosition(pos_dev[1], pos_dev[2], 0)
            trans:SetLocalScaleXYZ(pos_dev[3])
            trans:SetActiveE(1)
        end
    )
    self.go_table.aorrawimage_player:LoadImage(
        icon[2],
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetActiveE(1)
        end
    )
    self:SetEffect()
end

---立绘特效
function ArtifactMaterialGiftView:SetEffect()
    for _, v in pairs(self.artifactCfg.effect) do
        _G.UIUtils.LoadEffectByPath(
            v[2],
            self.go_table["trans_effect" .. v[1]],
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(obj)
                    return
                end
                obj:SetLocalPosition(v[3], v[4], v[5])
                obj:SetLocalScaleXYZ(v[6])
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end

    ---标题特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SpiritualMaterialGiftView_title,
        self.go_table.aorimage_title,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )

    ---选中特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SpiritualMaterialGiftView_anniu_loop,
        self.awardItemList[self.selectIndex].obj_Item,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.chooseEff = trans
        end
    )
end

---效果预览tip按钮
function ArtifactMaterialGiftView:OnClickDetailBtn()
    if not self.iconData then
        self.iconData = ArtifactData.New()
        local maxStar = 5
        local maxLevel = _G.ConfigManager.artifact_star_cfg[100 + maxStar].level_limit
        self.iconData:Parse({sid = self.artifactCfg.id, star = maxStar, level = maxLevel})
    end
    local detailData = {data = self.iconData, btn = {}, isSelf = false}
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DecorationTipsView.Name,
        {detailData},
        2
    )
end

---刷新item奖励
function ArtifactMaterialGiftView:RefreshItemAward()
    local awardData = self.activity.item[self.selectIndex].award
    self.awardData = {}
    for _, v in pairs(awardData) do
        _G.table.insert(self.awardData, v.type)
    end
    local itemCount = #self.awardData
    self:RefreshAwardList(itemCount)
    self:RefreshButton()
    self:RefreshBtnEffect()
end

---刷新按钮特效
function ArtifactMaterialGiftView:RefreshBtnEffect()
    local itemData = self.activity.item[self.selectIndex]
    local showBtnEffect = not self.activity:CheckIsBuy(itemData.sid) and self.openDay >= self.selectIndex
    if self.btnEffect then
        _G.GameUtil.SetActiveByCondition(self.btnEffect, showBtnEffect)
    elseif showBtnEffect then
        ---按钮
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SpiritualMaterialGiftView_anniu,
            self.go_table.aorbtn_buy,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPosition(0, 2, 0)
                self.btnEffect = trans
            end
        )    
    end
end

---初始化奖励item
function ArtifactMaterialGiftView:RefreshList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetItemBaseViewNew(
        self.awardData[index + 1],
        tb.obj_item,
        function(tran)
            if _G.IsNil(tb.obj_item) then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalScaleXYZ(0.84)
            tb.item = tran
            if tb.item.SetGradeNew then
                tb.item:SetGradeNew(false)
            end
            tb.gameObject:SetActiveE(1)
        end
    )
end

function ArtifactMaterialGiftView:Dispose()
    if self.iconData then
        self.iconData:Dispose()
        self.iconData = nil
    end
    self:StopAllTimer()
end

return ArtifactMaterialGiftView