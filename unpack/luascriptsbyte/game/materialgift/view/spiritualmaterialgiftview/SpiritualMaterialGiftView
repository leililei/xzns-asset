local baseView = require("MaterialGiftBaseView")
---@field public go_table SpiritualMaterialGiftView_GoTable GoTable
---@field public activityCls SpiritualMaterialGiftModel
local SpiritualMaterialGiftView = _G.BaseClass("SpiritualMaterialGiftView", baseView)

local GetLangPackValue = _G.GetLangPackValue
local tonumber = _G.tonumber

---界面的入口函数
function SpiritualMaterialGiftView:OnViewCreate()
    local icon = self.activity.item[1].icon
    local iconList =  _G.string.split2tbl(icon, '#')
    self.spiritualCfg = _G.ConfigManager.spiritual_cfg[tonumber(iconList[1])]
    self:UpdateView()
    self:SetActivityTimer()
    self:RefreshRoleIcon()
    self:LoadEffect()
end

function SpiritualMaterialGiftView:RefreshRoleIcon()
    self.go_table.aorrawimage_icon:SetActiveE(0)
    self.go_table.aorrawimage_icon:LoadImage(
        self.activity.image,
        function(trans)
            if self:IsNil() then
                return
            end
            trans:SetNativeSize()
            local pos_dev = _G.string.split2tbl(self.activity.pos_dev, "#")
            trans:SetLocalPosition(pos_dev[1], pos_dev[2], 0)
            trans:SetLocalScaleXYZ(pos_dev[3])
            trans:SetActiveE(1)
        end
    )
end

---刷新界面
function SpiritualMaterialGiftView:UpdateView()
    self:RefreshDailyItem()
    self:RefreshItemAward()
end

function SpiritualMaterialGiftView:LoadEffect()
    ---标题
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SpiritualMaterialGiftView_title,
        self.go_table.aorimage_title,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
    ---选中特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SpiritualMaterialGiftView_anniu_loop,
        self.awardItemList[self.selectIndex].obj_Item,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.chooseEff = trans
        end
    )
end

---刷新商品item
function SpiritualMaterialGiftView:RefreshDailyItem()
    for i = 1, self.dailyItemCount do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClickItem, i))
        tb.aorrawimage_icon:LoadImage(
            self.spiritualCfg.image_1,
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:SetLocalScaleXYZ(0.8)
                trans:SetActiveE(1)
            end
        )
        local data = self.activity.item[i]
        tb.aortext_tip.text = data.name
        tb.aortext_day.text = GetLangPackValue(90023800019, _G.GameUtil.NumberToWordByLanguage(data.day))
        tb.aorimage_iconBg.SpriteName = _G.SpiritualItemIconName[self.spiritualCfg.Order]
        if self.activity:CheckIsBuy(data.sid) then
            tb.aorimage_buy:SetActiveE(1)
        end
        local iconList = _G.string.split2tbl(data.icon, '#')
        if iconList[2] then
            tb.obj_stars:SetActiveE(1)
            local star = tonumber(iconList[2])
            if star > 0 then
                for i = 1, star do
                    tb["obj_star" .. i]:SetActiveE(1)
                end 
            end
        else
            tb.obj_stars:SetActiveE(0)
        end
        if self.activity:CheckIsBuy(data.sid) then
            tb.aorimage_buy:SetActiveE(1)
        end
        self.awardItemList[i] = tb
    end
end

function SpiritualMaterialGiftView:OnClickItem(obj, isOn, index)
    if self.selectIndex == index then
        self:ShowAwardTips()
        return
    end
    if self.chooseEff then
        self.chooseEff:SetParentE(self.awardItemList[index].obj_Item)
    end
    self.selectIndex = index
    self:RefreshItemAward(true)
end

---@param newIndex number 新的索引
function SpiritualMaterialGiftView:onClickSwitchBtn(newIndex)
    self:OnClickItem(nil, nil, newIndex)
end

function SpiritualMaterialGiftView:OnClickBuyBtn()
    baseView.OnClickBuyBtn(self, function()
        self:UpdateView()
    end)
end

---刷新item奖励
---@param showTip boolean 展示弹窗
function SpiritualMaterialGiftView:RefreshItemAward(showTip)
    local awardData = self.activity.item[self.selectIndex].award
    self.awardData = {}
    for _, v in pairs(awardData) do
        _G.table.insert(self.awardData, v.type)
    end
    local itemCount = #self.awardData
    self:RefreshAwardList(itemCount)
    self:RefreshButton()
    self:RefreshBtnEffect()
    ---策划需求：自动打开第二个奖励的tips(ZHJ-33098)
    if showTip and itemCount >= 2 then
        self:ShowAwardTips(awardData)
    end
end

---弹奖励提示
function SpiritualMaterialGiftView:ShowAwardTips(awardData)
    if not awardData then
        awardData = self.activity.item[self.selectIndex].award
    end
    local data = awardData[2] and awardData[2].type
    if data and data[1] then
        require("CommonTipManager"):GetInstance():OpenTip(self.go_table.scrollloophorizontal_awards, data[1])
    end
end

---刷新按钮特效
function SpiritualMaterialGiftView:RefreshBtnEffect()
    local itemData = self.activity.item[self.selectIndex]
    local showBtnEffect = not self.activity:CheckIsBuy(itemData.sid) and self.openDay >= self.selectIndex
    if self.btnEffect then
        _G.GameUtil.SetActiveByCondition(self.btnEffect, showBtnEffect)
    elseif showBtnEffect then
        ---按钮
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SpiritualMaterialGiftView_anniu,
            self.go_table.aorbtn_buy,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPosition(0, 2, 0)
                self.btnEffect = trans
            end
        )    
    end
end

---初始化奖励item
function SpiritualMaterialGiftView:RefreshList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetItemBaseViewNew(
        self.awardData[index + 1],
        tb.obj_item,
        function(tran)
            if _G.IsNil(tb.obj_item) then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalScaleXYZ(0.84)
            tb.item = tran
            if tb.item.SetGradeNew then
                tb.item:SetGradeNew(false)
            end
            tb.gameObject:SetActiveE(1)
        end
    )
end

function SpiritualMaterialGiftView:Dispose()
    self:StopAllTimer()
    self.go_table = nil
end

return SpiritualMaterialGiftView