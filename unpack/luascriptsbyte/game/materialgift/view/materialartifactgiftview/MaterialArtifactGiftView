local MaterialGiftView = require("MaterialGiftView")

---@class MaterialArtifactGiftView : MaterialGiftView	中文描述
---@field public go_table MaterialArtifactGiftView_GoTable GoTable
local MaterialArtifactGiftView = _G.BaseClass("MaterialArtifactGiftView", MaterialGiftView)

function MaterialArtifactGiftView:InitDayList()
    self.DayTbList = {}
    for i = 1, 7 do
        ---@type MaterialGiftView._aorbtn_Day1_GoTable
        local tb = _G.GetAutoGoTable(self.go_table["aorbtn_Day" .. i], _G.handlerbind(self, self.OnClickDay, i))
        self.DayTbList[i] = tb
        tb.aortext_Day.text = _G.GetLangPackValue(90023800019, i)
        local dataSid = self.giftList[i]
        local data = _G.ConfigManager.store_extra_cfg[dataSid]
        if not self.buyList[dataSid] and not self.curIndedx then
            self.curIndedx = i
        end
        if self.buyList[dataSid] then
            tb.aorimage_buy:SetActiveE(1)
        end
        tb.awardData = data
    end
    self:InitAwardItems()
end

return MaterialArtifactGiftView
