local ActivitySynManager = require("ActivitySynManager")
---@class MaterialGiftBaseView : UIBaseView	材料礼包View基类
local MaterialGiftBaseView = _G.BaseClass("MaterialGiftBaseView", _G.UIBaseView)

local TimeUtil = _G.TimeUtil
local GetLangPackValue = _G.GetLangPackValue

function MaterialGiftBaseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---商品item列表
    self.goodsItemList = {}
    ---每个商品对应的道具奖励列表
    self.awardItemList = {}
    self.selectIndex = 1
    self.dailyItemCount = 5
    self.endTimer = nil
    if self.go_table.scrollloophorizontal_awards then
        self.go_table.scrollloophorizontal_awards:InitItemData(0, _G.handler(self, self.RefreshList))
    end
end

---按钮点击事件
function MaterialGiftBaseView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_anyClose then
        self:CloseView()
    elseif go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_before then
        if self.selectIndex > 1 then
            self:onClickSwitchBtn(self.selectIndex - 1)
        end
    elseif go == self.go_table.aorbtn_next then
        if self.selectIndex < self.dailyItemCount then
            self:onClickSwitchBtn(self.selectIndex + 1)
        end
    elseif go == self.go_table.aorbtn_buy then
        self:OnClickBuyBtn()
    end
end

---@param activityClass ActivitySynBase
function MaterialGiftBaseView:OnCreate(activityClass, type)
    ---@field public activity ActivitySynTypeBase
    self.activity = activityClass:GetActivityTypeCls()
    self.activity:UpdateRedPoint(true)
    self.activityClass = activityClass
    self.selectIndex = self.activity:GetNextItemIndex()
    ---活动开启天数
    self.openDay = self.activity:GetCanBuyDay()
    ---活动倒计时
    self.activityEndTime = activityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self:OnViewCreate()
end

---基类方法
function MaterialGiftBaseView:OnViewCreate()
end

---刷新奖励列表
function MaterialGiftBaseView:RefreshAwardList(itemCount)
    if not self.go_table.scrollloophorizontal_awards then
        return
    end
    self.go_table.scrollloophorizontal_awards:UpdateScrollRectWeight(itemCount <= 4 and itemCount * 85 or 350)
    if self.lastItemCount and self.lastItemCount == itemCount then
        self.go_table.scrollloophorizontal_awards:UpdateAllItem()
    else
        self.go_table.scrollloophorizontal_awards:UpdateCount(itemCount)
    end
end

---刷新按钮
function MaterialGiftBaseView:RefreshButton()
    self.go_table.aorbtn_next:SetActiveE(self.selectIndex == self.dailyItemCount and 0 or 1)
    self.go_table.aorbtn_before:SetActiveE(self.selectIndex == 1 and 0 or 1)

    local itemData = self.activity.item[self.selectIndex]
    if self.activity:CheckIsBuy(itemData.sid) then
        self.go_table.aorbtn_buy:SetGray(true)
        self.go_table.aortext_tip.color = require("CardInfoManager").GetColorFromRGB("414141")
        self.go_table.aortext_tip.text = GetLangPackValue(90022500421)
    else
        if self.openDay >= self.selectIndex then
            self.go_table.aorbtn_buy:SetGray(false)
            self.go_table.aortext_tip.color = require("CardInfoManager").GetColorFromRGB("815633")
            local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(itemData.price)
            if info ~= nil then
                self.go_table.aortext_tip.text = info.formattedPrice .. GetLangPackValue(90021000017)
            else
                local price = _G.GameUtil.RatioControl(itemData.price)
                if _G.AppSetting.IsOverseas then
                    self.go_table.aortext_tip.text =GetLangPackValue(90000010807,price)
                else
                    self.go_table.aortext_tip.text =GetLangPackValue(90000010819,price)
                end
            end
        else
            self.go_table.aorbtn_buy:SetGray(true)
            self.go_table.aortext_tip.color = require("CardInfoManager").GetColorFromRGB("414141")
            self.go_table.aortext_tip.text = GetLangPackValue(90000011037, self.selectIndex - self.openDay)
        end
    end
end

---活动倒计时
function MaterialGiftBaseView:SetActivityTimer()
    self:StopAllTimer()
    self:UpdateTime()
    self.endTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.endTimer:Start()
end

function MaterialGiftBaseView:UpdateTime()
    local time = self.activityEndTime - TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self:CloseView()
        return
    end
    local str = TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_time.text = GetLangPackValue(90000011044, str)
end

---点击左右切换按钮
---@param newIndex number 新的索引
function MaterialGiftBaseView:onClickSwitchBtn(newIndex)
end

function MaterialGiftBaseView:OnClickBuyBtn(callBack)
    local data = self.activity.item[self.selectIndex]
    if self.activity:CheckIsBuy(data.sid) then
        ---已购买礼包
        return
    end

    if self.openDay < self.selectIndex then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            3805,
            GetLangPackValue(90000011037, self.selectIndex - self.openDay)
        )
        return
    end

    self.activity:BuyGift(data, function()
        if callBack then
            callBack() 
        end
    end)
end

function MaterialGiftBaseView:SetDailyItemCount(count)
    self.dailyItemCount = count
end

---基类方法
function MaterialGiftBaseView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function MaterialGiftBaseView:StopAllTimer()
    if self.endTimer then
        self.endTimer:Stop()
        self.endTimer = nil
    end
end

---初始化奖励item
function MaterialGiftBaseView:RefreshList(index, obj)
end

return MaterialGiftBaseView