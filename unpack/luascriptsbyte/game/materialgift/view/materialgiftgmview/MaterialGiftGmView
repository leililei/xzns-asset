local baseView = require("MaterialGiftBaseView")
---@class MaterialGiftGmView : MaterialGiftBaseView	材料礼包
local MaterialGiftGmView = _G.BaseClass("MaterialGiftGmView", baseView)

local GetLangPackValue = _G.GetLangPackValue
local tonumber = _G.tonumber

local viewInfo = {
    [1] = {
        "Images/nMaterialGift/ui_lmcllb_biaoti_txt",
        "Images/nMaterialGift/ui_lmcllb_libaodiban_bg"
    },
    [2] = {
        "Images/nMaterialGift/ui_clxsbx_biaoti_txt",
        "Images/nMaterialGift/ui_clxsbx_libao_bg"
    }
}

function MaterialGiftGmView:onClickSwitchBtn(newIndex)
    self:OnClickDay(nil, nil, newIndex)
end

---购买按钮点击事件
function MaterialGiftGmView:OnClickBuyBtn()
    baseView.OnClickBuyBtn(self, function()
        self:InitDayList()
        self:RefreshItemAward()
    end)
end

function MaterialGiftGmView:OnViewCreate()
    self:SetDailyItemCount(7)
    self:InitView()
    self:InitDayList()
    self:RefreshItemAward()
    self:LoadEffect()
    self:SetActivityTimer()
end

function MaterialGiftGmView:InitView()
    local info = viewInfo[self.activity.actType]
    self.go_table.aorrawimage_tittle:LoadImage(
        info[1],
        function(tran)
            tran:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_bg:LoadImage(
        info[2],
        function(tran)
            tran:SetNativeSize()
        end
    )
    if self.activity.actType == 1 then
        self.go_table.aorrawimage_bg:SetLocalPosition(24, -69, 0)
    end
end

function MaterialGiftGmView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaterialGiftView_bg,
        self.go_table.aorrawimage_bg,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            if self.giftType == 2 then
                trans:SetLocalPosition(0, 0, 0)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_LimitBrokenView_title,
        self.go_table.aorrawimage_title,
        check
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MaterialGiftView_kuang,
        self.go_table["aorbtn_Day" .. self.selectIndex],
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.chooseEff = trans
        end
    )
end

function MaterialGiftGmView:InitDayList()
    self.DayTbList = {}
    local item_cfg = _G.ConfigManager.item_cfg
    for i, data in pairs(self.activity.item) do
        local tb = _G.GetAutoGoTable(self.go_table["aorbtn_Day".. i], _G.handlerbind(self,self.OnClickDay, i))
        self.DayTbList[i] = tb
        tb.aortext_Day.text = GetLangPackValue(90023800019, _G.GameUtil.NumberToWordByLanguage(data.day))
        tb.aorrawimage_item:LoadImage(
            item_cfg[tonumber(data.icon)].Icon
        )
        if not _G.string.IsNullOrEmpty(data.name) then
            tb.obj_extra:SetActiveE(1)
            tb.aortext_extra.text = data.name
        else
            tb.obj_extra:SetActiveE(0)
        end
        if self.activity:CheckIsBuy(data.sid) then
            tb.aorimage_buy:SetActiveE(1)
        end
    end
end

function MaterialGiftGmView:OnClickDay(go, isOn, index)
    if index == self.selectIndex then
        return
    end
    self.selectIndex = index
    self:ChangeSelect()
end

function MaterialGiftGmView:ChangeSelect()
    if self.selectIndex == 7 then
        self.go_table.aorbtn_next:SetActiveE(0)
        self.go_table.aorbtn_before:SetActiveE(1)
    elseif self.selectIndex == 1 then
        self.go_table.aorbtn_before:SetActiveE(0)
        self.go_table.aorbtn_next:SetActiveE(1)
    else
        self.go_table.aorbtn_next:SetActiveE(1)
        self.go_table.aorbtn_before:SetActiveE(1)
    end
    if self.chooseEff then
        self.chooseEff:SetParentE(self.go_table["aorbtn_Day" .. self.selectIndex])
    end
    self:RefreshItemAward()
end

---刷新item奖励
function MaterialGiftGmView:RefreshItemAward()
    local awardData = self.activity.item[self.selectIndex].award
    self.awardData = {}
    for _, v in pairs(awardData) do
        _G.table.insert(self.awardData, v.type)
    end
    local itemCount = #self.awardData
    self:RefreshAwardList(itemCount)
    self:RefreshButton()
end

---初始化奖励item
function MaterialGiftGmView:RefreshList(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetItemBaseViewNew(
        self.awardData[index + 1],
        tb.obj_item,
        function(tran)
            if _G.IsNil(tb.obj_item) then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalScaleXYZ(0.84)
            tb.item = tran
            if tb.item.SetGradeNew then
                tb.item:SetGradeNew(false)
            end
            tb.gameObject:SetActiveE(1)
        end
    )
end

return MaterialGiftGmView