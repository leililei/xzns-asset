local base = require("BaseGameNet")

---@class MaterialGiftNet : BaseGameNet	通信协议
local MaterialGiftNet = _G.BaseClass("MaterialGiftNet", base)
---@return MaterialGiftNet MaterialGiftNet
function MaterialGiftNet:GetInstance()
    return  base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function MaterialGiftNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MaterialGiftNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function MaterialGiftNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_store_target_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

function MaterialGiftNet:ActiveGift(sid,callback)
    local pbData = {sid = sid}
    local item = _G.ConfigManager.net_map.game_store_target_unlock_gift
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback,sid))
    self.Call[port] = callback
end

---解锁活动
function MaterialGiftNet:UnlockGiftActivity(a_id, callback)
    local pbData = {a_id = a_id}
    local item = _G.ConfigManager.net_map.game_activity_module_grow_gift
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

return MaterialGiftNet