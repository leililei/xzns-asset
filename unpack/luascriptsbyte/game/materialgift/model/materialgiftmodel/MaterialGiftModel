function MaterialGiftModel:ActiveCall(msg, sid)
    if msg.ack ~= 1 then
        return
    end
    local useTime = TimeUtil:GetSecondsOfDayOf6Hour()
    local curTime = TimeUtil:GetServerUnixTime()
    self.GiftList[sid].startTime = curTime - useTime
    self.GiftList[sid].state = StateType.open
    self.giftTimes[sid] = (self.GiftList[sid].continueTime * 86400) - useTime
    self.GiftList[sid].curDay = 1
    self:StartTimer()
    --local MainOpenViewFunItem = {}
    --MainOpenViewFunItem.OpenViewFun = function()
    --    self:OpenWindow(self.GiftList[sid].type)
    --end
    self.GiftList[sid].show = true
    --_G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem,_G.MainViewShowOrder.MaterialGift)
    self:ShowGiftUI(self.GiftList[sid].type, true)
    --是否显示主页面按钮
    local mainFunctionId
    if self.GiftList[sid].type == 1 then
        mainFunctionId = _G.MainFunctionItems.MaterialCard
    elseif self.GiftList[sid].type == 2 then
        mainFunctionId = _G.MainFunctionItems.MaterialLM
    elseif self.GiftList[sid].type == 3 then
        mainFunctionId = _G.MainFunctionItems.MaterialArtifact
    elseif self.GiftList[sid].type == 4 then
        mainFunctionId = _G.MainFunctionItems.MaterialPet
    end
    local mainFunctionCfg = mainFunctionId and _G.ConfigManager.main_function_cfg[mainFunctionId]
    if mainFunctionCfg and mainFunctionCfg.ShowInMainView then
        _G.FunctionManager:GetInstance():OpenFunById(mainFunctionId)
    end
    --require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

