    if endcall ~= nil then
        endcall(self.__cname)
    end
end

function MaterialGiftModel:CheckOpen()
    local bol = true
    for k, v in pairs(self.GiftList) do
        if v.state == StateType.unOpen then
            if _G.GlobalConditionManager.CheckConditionByArray(v.condition_type) then
                self:OpenActive(v.id)
            end
            bol = false
        end
    end
    if bol then
        _G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.CheckOpen, self)
    end
end

---购买礼包
function MaterialGiftModel:BuyGift(data, sid, callBack)
    self.curBuyGift = data
    self.curSid = sid
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require("MallManager"):GetInstance():BuyActiveGift(data.price, nil, data.id)
end

function MaterialGiftModel:OnMallCashListener(data)
    if data.sid == self.curBuyGift.id then
        local curGiftData = self.GiftList[self.curSid]
        curGiftData.buyList[data.sid] = 1
        curGiftData.buyCount = curGiftData.buyCount + 1
        if curGiftData.buyCount == 7 then
            self:CloseActive(self.curSid)
        end
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

