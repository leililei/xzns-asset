---获取礼包数据
function MaterialGiftModel:GetGiftData(type, ignoreOpen)
    for k, v in pairs(self.GiftList) do
        if v.type == type and (v.state == StateType.open or ignoreOpen) then
            return v
        end
    end
    return nil
end

function MaterialGiftModel:CheckIsOpen(type)
    if not type then
        return
    end
    for k, v in pairs(self.GiftList) do
        if v.type == type and v.state == StateType.open then
            return true
        end
    end
    return false
end

