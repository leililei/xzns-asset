---解析数据
---@param data table 服务器返回数据
function MaterialGiftModel:ParseData(data)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.InitGiftActive, self)
    _G.Events:GetInstance():AddListener(_G.eMainViewShow.Fort, self.InitGiftActive1, self)
    _G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.CheckOpen, self)
    if _G.table.isEmptyOrNil(data) then
        if self.endCallback then
            self.endCallback()
        end
        self.endCallback = nil
        return
    end
    local curTime = _G.TimeUtil.GetServerUnixTime()
    for k, v in pairs(data.gift) do
        if self.GiftList[v.sid] then
            local data = self.GiftList[v.sid]
            data.buyCount = 0
            data.startTime = v.start_time
            if v.cash_gift then
                for k, id in pairs(v.cash_gift) do
                    data.buyList[id] = 1
                    data.buyCount = data.buyCount + 1
                end
            end
            if data.buyCount == 7 then
                self:CloseActive(v.sid)
            elseif v.start_time + (data.continueTime * 86400) <= curTime + 1 then
                self:CloseActive(v.sid)
            elseif v.start_time + (data.continueTime * 86400) > curTime then
                data.curDay = math.ceil((curTime - v.start_time) / 86400)
                self.giftTimes[v.sid] = (data.continueTime * 86400) - curTime + v.start_time
                data.state = StateType.open
                if not data.show then
                    -- local MainOpenViewFunItem = {}
                    -- MainOpenViewFunItem.OpenViewFun = function()
                    --     self:OpenWindow(data.type)
                    -- end
                    -- _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.MaterialGift)
                    self:ShowGiftUI(data.type, true)
                else
                    local view = self:GetWindow(data.type)
                    if view then
                        view:UpdateItems()
                    end
                end
                data.show = true
            else
                data.state = StateType.unOpen
            end
            --self.GiftList[v.sid].buyList = v.cash_gift
        end
    end
    if self.sendBuy then
        local data = {}
        data.award = {}
        data.award.item = self.curBuyGift.goods
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        self.sendBuy = false
        if self.mallCall then
            self.mallCall()
        end
    end
    if not table.isEmptyOrNil(self.giftTimes) then
        self:StartTimer()
    end
    self.initDataDoneTag = nil
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    self.endCallback = nil
end

---重连成功调用
