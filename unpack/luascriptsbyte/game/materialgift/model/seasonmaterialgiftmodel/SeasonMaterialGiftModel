local SeasonModel = require("SeasonModel")

---@class SeasonMaterialGiftModel : GameDataModelBase	中文描述
---@field GetInstance fun():SeasonMaterialGiftModel
---@field cfg store_target_season_cfg 礼包数据
local SeasonMaterialGiftModel = _G.BaseClass("SeasonMaterialGiftModel", require("SeasonBaseModel"))

---类的构造函数
function SeasonMaterialGiftModel:__init()
    self.curFunctionOpenID = _G.FunctionID.SeasonMaterialGift
end

function SeasonMaterialGiftModel:GetDataFormServer()
    self:ParseData()
end

---解析数据
---@param data table 服务器返回数据
function SeasonMaterialGiftModel:ParseData()
    local gift = SeasonModel:GetInstance().infoData.role_info.seven_gift or {}
    local seasonCfg = SeasonModel:GetInstance():GetCfg()
    self.buyList = {}
    for _, v in pairs(gift) do
        self.buyList[v.k] = v.v
    end
    self.storeId = seasonCfg.sevenday_pack
    self.cfg = _G.ConfigManager.store_target_season_cfg[self.storeId]
    self.super.ParseData(self)
end

---购买礼包
function SeasonMaterialGiftModel:BuyGift(data, sid, callBack)
    self.curBuyGift = data
    self.curSid = sid
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require("MallManager"):GetInstance():BuyActiveGift(data.price, nil, data.id)
end

function SeasonMaterialGiftModel:OnMallCashListener(data)
    if data.sid == self.curBuyGift.id then
        self.buyList[data.sid] = 1
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

---获取礼包数据
function SeasonMaterialGiftModel:GetCfg()
    return self.cfg
end

---打开UI界面
---@param type number 礼包类型: 1.七日粉将(材料), 2.待定, 3.神兵礼包
---@return void
function SeasonMaterialGiftModel:OpenView()
    _G.UIManager:GetInstance():OpenWindow(self:GetWindowName(self.cfg.type), self.cfg.type)
end

---获取UI界面
---@param type number 礼包类型: 1.七日粉将(材料), 2.待定, 3.神兵礼包
---@return MaterialGiftView
function SeasonMaterialGiftModel:GetWindow(type)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(self:GetWindowName(type))
    if not view or view.type ~= type then
        return nil
    end
    return view
end

---获取UI界面
---@private
---@param type number 礼包类型: 1.七日粉将(材料), 2.待定, 3.神兵礼包
---@return string
function SeasonMaterialGiftModel:GetWindowName(type)
    if type == 3 then
        return _G.ConfigManager.ui_cfg.SeasonMaterialArtifactGiftView.Name
    end
    return _G.ConfigManager.ui_cfg.SeasonMaterialGiftView.Name
end

