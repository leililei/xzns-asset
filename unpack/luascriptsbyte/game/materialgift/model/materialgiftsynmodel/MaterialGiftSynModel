---关闭活动
function MaterialGiftSynModel:OnCloseActivity()
    self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
end

---获取当前解锁的商品数量
function MaterialGiftSynModel:GetUnlockItemAmout()
    ---活动开启天数
    local openDay = _G.Mathf.Ceil((_G.TimeUtil.GetServerUnixTime() - self.openTime) / 86400)
    local unlockAmount = 0
    for _, v in pairs(self.item) do
        if openDay >= v.day then
            unlockAmount = unlockAmount + 1
        end
    end
    return unlockAmount
end

