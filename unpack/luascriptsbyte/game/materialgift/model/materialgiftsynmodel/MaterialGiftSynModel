local base = require("ActivitySynTypeBase")
local ActivitySynManager = require("ActivitySynManager")

---@field curActivityClas ActivitySynBase 
local MaterialGiftSynModel = _G.BaseClass("MaterialGiftSynModel", base)

---类的析构函数
function MaterialGiftSynModel:__init(activity)
    ---活动类型列表
    self.actTypeList = {
        ---灵脉
        LingMai = 1,
        ---魂链
        SoulChain = 2,
        ---神器
        Artifact = 3,
        ---灵契
        Spiritual = 4,
        ---魂将
        Hero = 5
    }
    _G.Events:GetInstance():AddListener(_G.eCard.CardUpStar, self.CheckGift, self)
end

---获取GM数据
function MaterialGiftSynModel:OnHandleGMData(data)
    self:ParseData(data)
end

---解析数据
function MaterialGiftSynModel:ParseData(data)
    if _G.table.isEmptyOrNil(data) or _G.table.isEmptyOrNil(data.grow_gift) then
        return
    end

    local endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    if _G.TimeUtil.GetServerUnixTime() >= endTime then
        self:OnCloseActivity()
    else
        ---活动开启时间
        self.openTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)

        self.actType = data.grow_gift.g_type
        ---玩家已购买数据，结构是<礼包sid, 购买次数>
        self.times = data.grow_gift.times or {}
        self.card_con = data.grow_gift.card_con
        self.image = data.grow_gift.image
        self.pos_dev = data.grow_gift.pos_dev
        self.item = data.grow_gift.item or {}
        self.totalBuyDay = _G.table.count(self.item)
        self.open_time = data.grow_gift.open_time or 0
        if self:CheckAllGiftPurchased() then
            return
        end
        if self.open_time == 0 then
            self:UnlockGiftActivity()
        else
            self:OpenFunctionsView()
        end
    end
end

---获取可购买天数
function MaterialGiftSynModel:GetCanBuyDay()
    if self.open_time > 0 then
        local curTime = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
        return _G.Mathf.Ceil((curTime - self.open_time) / 86400) + 1
    end
    return 0
end

---解锁活动
function MaterialGiftSynModel:UnlockGiftActivity()
    if self:CheckGMConditionPatams() then
        self:SendUnlockGiftMsg()
    else
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

---检测礼包是否激活
function MaterialGiftSynModel:CheckGift(star, sid)
    if self.open_time == 0 then
        if self:CheckGMConditionPatams(sid, star) then
            self:SendUnlockGiftMsg()
        end
    end
end

---解锁请求
function MaterialGiftSynModel:SendUnlockGiftMsg()
    require("MaterialGiftNet"):GetInstance():UnlockGiftActivity(
        self.curActivityClass:GetActivityID(),
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            self.curActivityClass:ChangeState(ActivitySynManager.State.Open)
            self.open_time = msg.unlock_time
            self:OpenFunctionsView()
        end
    )
end

function MaterialGiftSynModel:CheckGMConditionPatams(sid, star)
    if not _G.table.isEmptyOrNil(self.card_con) then
        if self.card_con.k == 0 then
            ---0表示任意卡牌星级达到指定星级
            if star and star >= self.card_con.v then
                return true 
            end

            local cardDatas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
            for _, data in pairs(cardDatas) do
                if data.star >= self.card_con.v then
                   return true 
                end
            end
        else
            if sid and sid == self.card_con.k and star and star == self.card_con.v then
               return true
            end

            local cardData = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Card, self.card_con.k)
            for _, v in pairs(cardData) do
                if v.star >= self.card_con.v then
                    return true
                end
            end
        end
        return false
    end

    return true
end

---进入活动界面
function MaterialGiftSynModel:OnEnterActivity()
    if self.actTypeList.LingMai == self.actType then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaterialGiftGmView.Name, self.curActivityClass)
    elseif self.actTypeList.SoulChain == self.actType then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MaterialGiftGmView.Name, self.curActivityClass)
    elseif self.actTypeList.Artifact == self.actType then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArtifactMaterialGiftView.Name, self.curActivityClass)
    elseif self.actTypeList.Spiritual == self.actType then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualMaterialGiftView.Name, self.curActivityClass)
    elseif self.actTypeList.Hero == self.actType then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroMaterialGiftView.Name, self.curActivityClass)
    end
end

