---初始化红点树
function MaterialGiftSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检查红点
function MaterialGiftSynModel:CheckRedPoint()
    local curUnlockCount = self:GetUnlockItemAmout()
    local lastUnlockCount = _G.PlayerPrefsManager.GetInt("MaterialGiftRedPoint_" .. self.curActivityClass:GetActivityID(), 0)
    if curUnlockCount > lastUnlockCount then
        return 1
    end
    return 0
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function MaterialGiftSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新红点
---@param needSave bool 是否需要保持当前解锁数量
function MaterialGiftSynModel:UpdateRedPoint(needSave)
    if needSave then
        local unlockCount = self:GetUnlockItemAmout()
        _G.PlayerPrefsManager.SetInt("MaterialGiftRedPoint_" .. self.curActivityClass:GetActivityID(), unlockCount)
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---购买礼包
function MaterialGiftSynModel:BuyGift(data, callBack)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require("MallManager"):GetInstance():BuyActiveGift(data.price, self.curActivityClass:GetActivityID(), data.sid)
end

---充值监听
function MaterialGiftSynModel:OnMallCashListener(data)
    if data.activity_id == self.curActivityClass:GetActivityID() then
        _G.table.insert(self.times, {k = data.sid, v = 1})
        if self:CheckAllGiftPurchased() then
            return
        end
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

---检测礼包是否购买完
function MaterialGiftSynModel:CheckAllGiftPurchased()
    if self.totalBuyDay == _G.table.count(self.times) then
        self:OnCloseActivity()
        if self.actTypeList.LingMai == self.actType or self.actTypeList.SoulChain == self.actType then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MaterialGiftGmView.Name)
            if view then
               view:CloseView() 
            end
        elseif self.actTypeList.Artifact == self.actType then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArtifactMaterialGiftView.Name)
            if view then
               view:CloseView() 
            end
        elseif self.actTypeList.Spiritual == self.actType then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SpiritualMaterialGiftView.Name)
            if view then
               view:CloseView() 
            end
        elseif self.actTypeList.Hero == self.actType then
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HeroMaterialGiftView.Name)
            if view then
               view:CloseView() 
            end
        end
        return true
    end

    return false
end

---检查是否购买商品
function MaterialGiftSynModel:CheckIsBuy(sid)
    for _, v in pairs(self.times) do
        if v.k == sid then
            return true
        end
    end

    return false
end

---当前可购买的item索引
function MaterialGiftSynModel:GetNextItemIndex()
    if _G.table.isEmptyOrNil(self.times) then
        return 1
    end

    for index, v in pairs(self.item) do
        if not self:CheckIsBuy(v.sid) then
            return index
        end
    end
    return 1
end

---类的析构函数
function MaterialGiftSynModel:Dispose()
    base.Dispose(self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.eCard.CardUpStar, self.CheckGift, self)
    self.mallCall = nil
    self.actType = nil
    self.buyTimes = {}
    self.card_con = nil
    self.open_time = 0
    self.image = nil
    self.pos_dev = nil
    self.times = {}
end

return MaterialGiftSynModel