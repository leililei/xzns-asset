local base = require("BaseGameNet")

---@class RoleTeamNet : BaseGameNet	通信协议
local RoleTeamNet = _G.BaseClass("RoleTeamNet", base)
---@return RoleTeamNet RoleTeamNet
function RoleTeamNet:GetInstance()
    return base.GetInstance(self)
end

---查询角色推荐
---@param pbData table PB数据
---@param callback function 完成回调
---@field huidao team_show.s2c_team_show_info 回掉的数据
function RoleTeamNet:GetAllRoleTeamRewardInfos(callback)
    local item = _G.ConfigManager.net_map.game_team_show_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

function RoleTeamNet:GetTeamAwardInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_team_show_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RoleTeamNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return RoleTeamNet
