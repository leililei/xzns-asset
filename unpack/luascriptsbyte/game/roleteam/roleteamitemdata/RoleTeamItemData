local BaseItemData = require "BaseItemData"
---@class RoleTeamItemData 角色推荐队伍 数据类
local RoleTeamItemData = _G.BaseClass("RoleTeamItemData", BaseItemData)

local awardstateEnum = {
    none = 0, -- 正常
    receive = 1, -- 可以领取
    already_receive = 2 -- 已领取
}
---类的构造函数
function RoleTeamItemData:__init()
    self:InitAttribute()
end
---类的析构函数
function RoleTeamItemData:Dispose()
    self.cfg = nil
end
function RoleTeamItemData:InitAttribute()
    self.cfg = _G.ConfigManager.team_show_cfg
    self.sid = 0
    self.teamname = ""
    self.teamAllCardsinfos = {
        [1] = {},
        [2] = {},
        [3] = {},
        [4] = {},
        [5] = {}
    } --cardsid = 卡牌sid ,cardinfo=卡牌信息, flag = false 是否解锁
    self.teamAllCardsState = awardstateEnum.none -- 0 全部解锁，1 有未解锁
    self.teamAllCardsSids_State = {} -- 0 全部解锁，1 有未解锁
    self.comboAllComboinfos = {} -- 合击技的 技能id
    self.combo = {
        [1] = {},
        [2] = {},
        [3] = {}
    } -- combosid == 0 comboskillid = 技能id  flag = true 是否激活,activation_cards = 需要激活的卡牌
    self.comboAllComboState = awardstateEnum.none -- 0 全部解锁，1 有未解锁
    self.teamRewardinfos = {}
    self.teamRewardState = awardstateEnum.none -- 0 未解锁 1，可以领取，2，已领取
end
function RoleTeamItemData:ParseInitMsg(msg)
    self.sid = msg.sid
    local cards_sids = self.cfg[self.sid].team_role
    self.comboAllComboinfos = self.cfg[self.sid].combo_skill
    self.teamRewardinfos = self.cfg[self.sid].reward
    for i = 1, #cards_sids do
        local cardsid = cards_sids[i]
        self.teamAllCardsinfos[i].sid = cardsid
        self.teamAllCardsinfos[i].card = {}
        self.teamAllCardsinfos[i].flag = false
    end
    --反向查找 合击技的 sid
    for i = 1, #self.comboAllComboinfos do
        self:CheckComboSid(i, self.comboAllComboinfos[i])
    end
end
--反向查找 合击技的 sid
---@param index number 合击技 下标 上 1 左2 右 3
function RoleTeamItemData:CheckComboSid(index, comboskill_id)
    local cfg = _G.ConfigManager.combine_cfg
    for _, value in pairs(cfg) do
        local flag = false
        local skills = value.skills
        for i = 1, #skills do
            if skills[i] == comboskill_id then
                local data = {}
                data.combosid = value.id
                data.comboskillid = comboskill_id
                data.flag = false
                data.activation_cards = value.activation
                self.combo[index] = data
                flag = true
                break
            end
        end
        if flag then
            return true
        end
    end
end
function RoleTeamItemData:SetTeamRewardState(state)
    self.teamRewardState = state
end
---队伍的状态
function RoleTeamItemData:SetTeamAllCardsState(state)
    self.teamAllCardsState = state
end
---队伍的合击技状态
function RoleTeamItemData:SetTeamAllCombos(state)
    self.comboAllComboState = state
end
---获得队伍名字
function RoleTeamItemData:GetTeamName()
    local name = self.cfg[self.sid].name
    return _G.LangUtil.GetLangPackValue(name)
end
---获得队伍描述
function RoleTeamItemData:GetTeamDesc()
    local desc = self.cfg[self.sid].desc
    return _G.LangUtil.GetLangPackValue(desc)
end

function RoleTeamItemData:GetTeamAllCardIds()
    return self.teamAllinfos
end
function RoleTeamItemData:GetTeamAllCombo()
    return self.GetTeamAllCombo
end

return RoleTeamItemData
