---@class RoleTeamView : UIBaseView	中文描述
---@field public go_table RoleTeamView_GoTable GoTable
local RoleTeamView = _G.BaseClass("RoleTeamView", _G.UIBaseView)

function RoleTeamView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local count = #_G.ConfigManager.team_show_cfg
    self.team = {}
    for i = 1, count do
        self.team[i] = {}
    end
    self.ObjSame = {}
    self.AwardsItems = {}
    self.AllTbs = {}
end

---界面的入口函数
function RoleTeamView:OnCreate()
    self:InitView()
end

function RoleTeamView:OnDestroy()
end

---按钮点击事件在这里派发
function RoleTeamView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_closeview" then
        self:Close()
    end
end

--初始化 视图
function RoleTeamView:InitView()
    local cfg = _G.ConfigManager.team_show_cfg
    local count = #cfg
    self:UpdateView()
    self.go_table.looplist2_team:InitListView(0, _G.handler(self, self.RefreshRenItem))
    self.go_table.looplist2_team:SetListItemCount(count, true)
end

--初始化聊天iitem
---@param index int 该数据的索引   0起始
function RoleTeamView:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1

    local item = listView2:NewListViewItem("$_obj_Item")
    item:SetActiveE(1)

    self:SetItem(item, t_index)

    return item
end

function RoleTeamView:UpdateView()
    local teams = require "RoleTeamModel":GetInstance().roleteamAll
    self.allteam = {}
    for i = 1, #teams do
        _G.table.insert(self.allteam, teams[i])
    end
    _G.SortList(
        self.allteam,
        function(team)
            local num = 9
            if team.teamRewardState == 1 then
                num = 10
            end
            return num, -team.sid
        end
    )
end

--设置Item
function RoleTeamView:SetItem(go, teamsid)
    local all_roleteam = self.allteam[teamsid]
    local goId = go:GetInstanceIDE()

    --_G.Log(goId, "生成单队信息id")
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.OnlickItem, all_roleteam.sid, teamsid, goId))
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.TeamShowreward.id, all_roleteam.sid)
    self.AllTbs[goId] = tb
    local cards_obj = {
        [1] = tb.obj_card_1,
        [2] = tb.obj_card_2,
        [3] = tb.obj_card_3,
        [4] = tb.obj_card_4,
        [5] = tb.obj_card_5
    }
    local combo_objs = {
        [1] = tb.obj_ComboSkill_1,
        [2] = tb.obj_ComboSkill_2,
        [3] = tb.obj_ComboSkill_3
    }
    tb.aortext_roleteamname.text = all_roleteam:GetTeamName()
    local card_sids = all_roleteam.teamAllCardsinfos
    if not tb.item then
        --卡牌信息
        tb.item = {}
    end

    for i = 1, 5 do
        local card_tb = _G.GetAutoGoTable(cards_obj[i])
        --local child = card_tb.obj_cardnode:GetChildE(0)
        local flag = card_sids[i].flag
        local carddata = card_sids[i].card
        carddata.isHave = card_sids[i].flag or false

        local cardCfg = require "CardCommentManager":GetInstance():CardData(carddata.sid, false)
        card_tb.aortext_RoleName.text = _G.GetLangPackValue(cardCfg.Name)

--[[        if tb.item[i] == nil then
            tb.item[i] = {}

            local itembase = require("ItemCardBodyBaseView").New(child)
            tb.item[i] = itembase
            itembase:ShowCardData(carddata, _G.handler(self, self.CardOnlick), true, itembase, card_sids[i].sid)
            _G.GameUtil.SetActiveByCondition(card_tb.obj_mask, not flag)
        else
            tb.item[i]:ShowCardData(carddata, _G.handler(self, self.CardOnlick), true, tb.item[i], card_sids[i].sid)
            _G.GameUtil.SetActiveByCondition(card_tb.obj_mask, not flag)
        end]]
        if tb.item[i] == nil then
            tb.item[i] = {}
            _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.HeadItem_Select,
                    card_tb.obj_cardnode,
                    function(view)
                        tb.item[i] = view
                        view.transform:SetLocalPositionToZero()
                        view:ShowCardData(carddata, _G.handler(self, self.CardOnlick), true, view, card_sids[i].sid)
                    end
            )
            _G.GameUtil.SetActiveByCondition(card_tb.obj_mask, not flag)
        else
            tb.item[i]:ShowCardData(carddata, _G.handler(self, self.CardOnlick), true, tb.item[i], card_sids[i].sid)
            _G.GameUtil.SetActiveByCondition(card_tb.obj_mask, not flag)
        end
    end

    --合击技
    local combo = all_roleteam.combo
    for i = 1, 3 do
        local combtb =
            _G.GetAutoGoTable(
            combo_objs[i],
            _G.handlerbind(self, self.ComboOnclick, combo[i].combosid, combo[i].comboskillid, goId)
        )
        _G.GameUtil.SetActiveByCondition(combtb.obj_mask, not combo[i].flag)
        _G.GameUtil.SetActiveByCondition(combtb.obj_maskbg, not combo[i].flag)
        local cfg = _G.ConfigManager.card_skills_cfg[combo[i].comboskillid]
        local icon = cfg.icon
        combtb.aorrawimage_icon:LoadImage(icon)
    end
    --设置下拉列表
    local reward = all_roleteam.teamRewardinfos
    if self.AwardsItems[goId] == nil then
        self.AwardsItems[goId] = 0

        _G.StorageManager:GetInstance():GetItemBaseView(
            reward[1],
            reward[2],
            tb.obj_item,
            _G.handlerbind(self, self.LoadCallBack, all_roleteam, goId),
            _G.handlerbind(self, self.ItemOnclick, all_roleteam, reward[1], teamsid, goId)
        )
    elseif self.AwardsItems[goId] ~= 0 then
        --取消等
        self.AwardsItems[goId]:SetGou(all_roleteam.teamRewardState == 2)
        self.AwardsItems[goId]:ShowOrHideEffect(all_roleteam.teamRewardState == 1)
        self.AwardsItems[goId]:UpdateFunction(
            _G.handlerbind(self, self.ItemOnclick, all_roleteam, reward[1], teamsid, goId)
        )
    end
    tb.aortext_desc.text = all_roleteam:GetTeamDesc()
    tb.aorbtn_copy:SetGray(all_roleteam.teamAllCardsState == 1)
    --_G.GameUtil.SetActiveByCondition(tb.obj_descnode, all_roleteam.teamRewardState == 1)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_open_desc, not (all_roleteam.teamRewardState == 1))
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_close_desc, all_roleteam.teamRewardState == 1)

    if nil == self.ObjSame[goId] or (self.ObjSame[goId] ~= (all_roleteam.teamRewardState == 1)) then
        self.ObjSame[goId] = (all_roleteam.teamRewardState == 1)
    end
    _G.GameUtil.ReBuildRTF(tb.gameObject)
    self.go_table.looplist2_team:OnItemSizeChanged(teamsid - 1)
end

function RoleTeamView:LoadCallBack(item, all_roleteam, goId)
    if self:IsNil() then
        return
    end
    self.AwardsItems[goId] = item
    item:SetGou(all_roleteam.teamRewardState == 2)
    item:ShowEffect(all_roleteam.teamRewardState == 1)
    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
end

--- 合击技 点击事件
function RoleTeamView:ComboOnclick(go, ison, combosid, cardskillid)
    require("CommonTipManager"):GetInstance():OpenCombineTipsView(go, combosid, cardskillid)
end

---物品点击
function RoleTeamView:ItemOnclick(go, got, ison, all_roleteam, rewardsid, index, goId)
    --判断奖励状态
    local state = all_roleteam.teamRewardState
    --未解锁
    if state == 0 then
        require("CommonTipManager"):GetInstance():OpenPropTip(go.gameObject, rewardsid)
        return
    elseif state == 2 then
        return
    end
    --获得奖励
    require("RoleTeamModel"):GetInstance():GetTeamAwards(
        all_roleteam.sid,
        function(sid)
            self.AwardsItems[goId]:SetGou(true)
            self.AwardsItems[goId]:ShowOrHideEffect(false)
            self.AwardsItems[goId]:ShowOrHideEffect(false)
            --_G.GameUtil.SetActiveByCondition(self.AllTbs[goId].obj_descnode, false)
            _G.GameUtil.SetActiveByCondition(self.AllTbs[goId].aorbtn_open_desc, true)
            _G.GameUtil.SetActiveByCondition(self.AllTbs[goId].aorbtn_close_desc, false)
            _G.GameUtil.ReBuildRTF(self.AllTbs[goId].gameObject)
            self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TeamShowreward.id, sid)
        end
    )
end

---卡牌点击跳转
function RoleTeamView:CardOnlick(params)
    --跳转到角色预览界面
    local obj = params[1]
    local cardsid = params[2]
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CardShowView.Name)
    self:Close()
    require("CommonTipManager"):GetInstance():OpenTip(obj, cardsid)
end

---队伍点击事件
function RoleTeamView:OnlickItem(go, ison, teamsid, index, goId)
    --_G.Log(goId, "队伍点击事件")
    local tb = self.AllTbs[goId]
    local name = go:GetName()
    if name == "@_aorbtn_copy" then
        --require "RoleTeamModel":GetInstance():CopyTeam(teamsid)
        --复制功能
        local roleteam = require "RoleTeamModel":GetInstance().roleteamAll[teamsid]
        --提示合击技
        if roleteam.comboAllComboState == 0 then
            require "RoleTeamModel":GetInstance():CopyTeam(teamsid)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                320116,
                nil,
                function()
                    require "RoleTeamModel":GetInstance():CopyTeam(teamsid)
                end
            )
        end
    elseif name == "@_aorbtn_close_desc" then
        -- 关闭描述
        if ison then
            tb.aorbtn_close_desc:SetActiveE(0)
            tb.aorbtn_open_desc:SetActiveE(1)
            tb.obj_descnode:SetActiveE(0)
            _G.GameUtil.ReBuildRTF(tb.gameObject)
            self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
        end
    elseif name == "@_aorbtn_open_desc" then
        if ison then
            tb.aorbtn_close_desc:SetActiveE(1)
            tb.aorbtn_open_desc:SetActiveE(0)
            tb.obj_descnode:SetActiveE(1)
            _G.GameUtil.ReBuildRTF(tb.gameObject)
            self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
        end
    end
end

return RoleTeamView
