---@class GetLoginVipExpView : UIBaseView	中文描述
---@field public go_table GetLoginVipExpView_GoTable GoTable
local GetLoginVipExpView = _G.BaseClass("GetLoginVipExpView", _G.UIBaseView)

function GetLoginVipExpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

---界面的入口函数
function GetLoginVipExpView:OnCreate(call)
    self.cfg = _G.ConfigManager.discrete_cfg[105904]
    self.call = call
    ---@type GetLoginVipExpModel
    self.model = require("GetLoginVipExpModel"):GetInstance()
    self.loginDay = 0
    self:UpdateView()
end

function GetLoginVipExpView:UpdateView()
    self.loginDay = _G.PlayerModel:GetInstance():GetLoginDay()
    local todayData = self:GetExpByLoginDay(self.loginDay)
    local tomorrowData = self:GetExpByLoginDay(self.loginDay + 1)

    self.go_table.aortext_todayExp.text = todayData[2]
    self.go_table.aortext_tomorrowExp.text = tomorrowData[2]
    self.go_table.aortext_loginDay.text = _G.GetLangPackValue(90028500006, self.loginDay)

    self:ChangeBtnState(self.model:CheckGetAward())
end

function GetLoginVipExpView:ChangeBtnState(flag)
    if flag then
        self.go_table.aorbtn_get:SetActiveE(0)
        self.go_table.aorimage_gotAward:SetActiveE(1)
    else
        self.go_table.aorbtn_get:SetActiveE(1)
        self.go_table.aorimage_gotAward:SetActiveE(0)
    end
end

---获取当天能够获得经验
function GetLoginVipExpView:GetExpByLoginDay(day)
    -- 防止新号第一次登录导致登录天数为0
    if day and day < 1 then
        day = 1
    end
    local d = _G.math.min(day, #self.cfg)
    return self.cfg[d]
end

---界面的销毁函数
function GetLoginVipExpView:OnDestroy()
    self.model = nil
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

---按钮点击事件在这里派发
function GetLoginVipExpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        if self.model:CheckGetAward() then
            return
        end
        --local day = self.loginDay
        self.model:GetAward(function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:ChangeBtnState(true)
            ---ZHJH5ZHJH-12062 【主任务】魔兽尊享抽奖功能开发ZHJH-13500
            ---【VIP抽奖】领取每日VIP经验后，前台刷新不及时，需要重登才会加上
            ---使用服务器给的奖励结构
            --local award = {award = {item = {[1] = {type = self:GetExpByLoginDay(day)}}}}
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)

            if self.call then
                self.call()
            end
            self:Close()
        end)
    end
end

return GetLoginVipExpView
