local base = require("BaseGameNet")

---@class GetLoginVipExpNet : BaseGameNet	通信协议
local GetLoginVipExpNet = _G.BaseClass("GetLoginVipExpNet", base)
---@return GetLoginVipExpNet GetLoginVipExpNet
function GetLoginVipExpNet:GetInstance()
    return  base.GetInstance(self)
end

function GetLoginVipExpNet:GetAward(call)
    local pbdata = {id = 0}
    local item = _G.ConfigManager.net_map.game_vip_award
    self:Access(item,pbdata,call)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function GetLoginVipExpNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GetLoginVipExpNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return GetLoginVipExpNet