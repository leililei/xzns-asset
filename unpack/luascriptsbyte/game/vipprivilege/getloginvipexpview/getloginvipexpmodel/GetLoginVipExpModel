local GameDataModelBase = require "GameDataModelBase"
---@class GetLoginVipExpModel : GameDataModelBase	中文描述
local GetLoginVipExpModel = _G.BaseClass("GetLoginVipExpModel" ,GameDataModelBase)

---类的构造函数
function GetLoginVipExpModel:__init()
    self.getLoginVipExpNet = require("GetLoginVipExpNet"):GetInstance()
    self.day_award = require("VIPPrivilegeModel"):GetInstance().day_award
end

---领取每日免费奖励
function GetLoginVipExpModel:GetAward(call)
    self.getLoginVipExpNet:GetAward(function(msg)
        if msg.ack ~= 1 then
            return
        end
        self.day_award = true
        require("VIPPrivilegeModel"):GetInstance().day_award = true
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StoreVIP.id)
        if call then
            call(msg)
        end
    end)
end

---判断今天奖励是否被领取
function GetLoginVipExpModel:CheckGetAward()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(273) then
        return true
    end
    self.day_award = require("VIPPrivilegeModel"):GetInstance().day_award
    return self.day_award
end

---类的析构函数
function GetLoginVipExpModel:Dispose()
    self.getLoginVipExpNet = nil
    self.vipPrivilegeModel = nil
end

return GetLoginVipExpModel