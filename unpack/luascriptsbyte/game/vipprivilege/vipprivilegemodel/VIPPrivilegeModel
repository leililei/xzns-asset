local GameDataModelBase = require "GameDataModelBase"
local VIPPrivilegeData = require "VIPPrivilegeData"
---@class VIPPrivilegeModel : Singleton	vip特权
local VIPPrivilegeModel = _G.BaseClass("VIPPrivilegeModel", GameDataModelBase)
---@return VIPPrivilegeModel VIPPrivilegeModel
function VIPPrivilegeModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
---@param currentVipLevel number 当前特权vip 等级
---@param oldVipLevel number 以前的特权vip 等级
---@param total_exp number 经验总值
---@param isUpLevel boolean 等级是否提升
---@param Conversion_Rate number 兑换比例
function VIPPrivilegeModel:__init()
    self.endCallback = nil
    self.curFunctionOpenID = 0
    self.currentVipLevel = 1
    self.realVipLevel = 1
    self.oldVipLevel = 1
    self.total_exp = 0
    self.p_award = {}
    self.isUpLevel = false
    self.vipmaxlevel = _G.ConfigManager.discrete_cfg[105903][1][1]
    self.Conversion_Rate = {}
    self.all_player_vip = {}
    self.uplevel = 0
    self.day_award = false
    self.isRedFirt = false --- 用来检测时 每次登录
end

---销毁对象时,析构函数
function VIPPrivilegeModel:Dispose()
    self.currentVipLevel = nil
    self.realVipLevel = nil
    self.oldVipLevel = nil
    self.total_exp = nil
    self.p_award = nil
    self.Conversion_Rate = nil
    self.day_award = nil
end

function VIPPrivilegeModel:GetDataFormServer()
    require "VIPPrivilegeNet":GetInstance():AccessVipInfo(_G.handler(self, self.ParseData))
end

function VIPPrivilegeModel:ParseData(msg)
    self.msg = msg
    self.Conversion_Rate = _G.ConfigManager.discrete_cfg[105901]
    self:InitPlayerVipData()
    self.super.ParseData(self)
end

function VIPPrivilegeModel:InitFunction()
end

function VIPPrivilegeModel:ReConnect(endcall)
    require "VIPPrivilegeNet":GetInstance():AccessVipInfo(
        function(msg)
            self.msg = msg
            self:InitFunction()
            self.Conversion_Rate = _G.ConfigManager.discrete_cfg[105901]
            self:InitPlayerVipData()
            self:GetFreeGift(true)
            local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
            if window then
                window.View:UpdateDesc()
                window.View:UpdateView()
            end
            if endcall then
                endcall()
            end
        end
    )
end

