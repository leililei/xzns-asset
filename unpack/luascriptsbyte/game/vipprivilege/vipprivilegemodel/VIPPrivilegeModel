function VIPPrivilegeModel:InitPlayerVipData()
    if self.msg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("palyer_msg  数据是空")
        end
    end
    self.all_player_vip = {}
    self.oldVipLevel = self.msg.lv
    self.currentVipLevel = self.msg.lv
    self.realVipLevel = self.msg.lv
    self.lastRealVipLv = self.msg.lv
    self.total_exp = self.msg.exp
    self.p_award = self.msg.p_award
    self.award_list = self.msg.award_list or {}
    self.day_award = self.msg.day_award or false
    self.vip_repair = self.msg.vip_repair or false
    self.need_count = self.msg.need_count

    --封装数据
    local MallManager = require("MallManager"):GetInstance()
    local cfg = _G.ConfigManager.player_vip_cfg
    for i = 1, #cfg do
        local p_data = VIPPrivilegeData.New()
        p_data:ParseInitMsg({ id = i })
        local state, buystate = 0, 0
        --设置奖励的状态
        if self.msg.lv < i and self.total_exp < cfg[i].exp then
            state = 0
        else
            state = 1
            p_data:SetVIPPrivile()
            buystate = 1
            ---购买状态
            if MallManager:GetItemBuyTimes(p_data.goods.itemid, p_data.goods.type_reset) > 0 then
                buystate = 2
            end
        end
        p_data:SetIsLock(state)
        p_data:SetAwardState(buystate)
        if self.all_player_vip[i] == nil then
            self.all_player_vip[i] = {}
        end
        self.all_player_vip[i] = p_data
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.VipPage.id)
    require("AfkModel"):GetInstance():SetPrivilegeAward()

    --客户端是否自动更新vip经验代币的背包数据 true:需要更新  false:不用管
    --说明: 由于vip抽奖系统上线后,玩家第一次登陆后,后台自动补发奖励,可能会导致客户端与服务器道具数
    --据不一致的情况。因此给客户端一个标记符，在服务器发奖后.让客户端更新背包数据
    local maxexp = cfg[#cfg].exp
    if self.total_exp >= maxexp then
        self.IsMaxExp = true
        _G.PlayerPrefsManager.SetInt("VIPDrawTenTimes", 0)
        if self.vip_repair and (self.total_exp - maxexp) > 0 then
            _G.StorageManager:GetInstance():AddItemByData(_G.StorageID.ResProp, 79, self.total_exp - maxexp)
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LotteryPremium.id)
        end
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.LotteryPremium.id)
    else
        self.IsMaxExp = false
    end
end

---改变 oldVipLevel 等级 用在升级界面
function VIPPrivilegeModel:ChangeOldLevel()
    self.oldVipLevel = self.oldVipLevel + self.uplevel
    if self.oldVipLevel >= self.currentVipLevel then
        self.oldVipLevel = self.currentVipLevel
    end
    if self.oldVipLevel >= self.vipmaxlevel then
        self.oldVipLevel = self.vipmaxlevel
    end
end

---改变 当前的等级
function VIPPrivilegeModel:ChangeCurLevel(level)
    self.currentVipLevel = self.currentVipLevel + level
    _G.Events:GetInstance():Broadcast(_G.ePlayerStatus.PlayerUpVipLevel, self.currentVipLevel)
    if self.currentVipLevel > self.realVipLevel then
        self.currentVipLevel = self.realVipLevel
    end
    if self.currentVipLevel >= self.vipmaxlevel then
        self.currentVipLevel = self.vipmaxlevel
    end
end

---改变 等级是否提升 是否可以打开升级界面
function VIPPrivilegeModel:ChangeIsUpLevel()
    self.isUpLevel = not self.isUpLevel
end

function VIPPrivilegeModel:NotificationLevel(level)
    self:ChangeCurLevel(level)
end

function VIPPrivilegeModel:ChangerTotaleExp(exp)
    self.total_exp = self.total_exp + exp
    local cfg = _G.ConfigManager.player_vip_cfg
    local maxexp = cfg[#cfg].exp
    if self.total_exp >= maxexp then
        self.IsMaxExp = true
    else
        self.IsMaxExp = false
    end
    for _, v in ipairs(cfg) do
        if self.total_exp < v.exp then
            if v.id - 1 ~= self.realVipLevel then
                self.realVipLevel = v.id - 1
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.VIP)
            end
            return
        end
    end
    if self.realVipLevel ~= self.vipmaxlevel then
        self.realVipLevel = self.vipmaxlevel
        _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.VIP)
    end
end

function VIPPrivilegeModel:GetVIpInfo(level)
    return self.all_player_vip[level]
end

--region 对外接口调用 打开界面
---特殊判定
function VIPPrivilegeModel:ChangeVipFirstState()
    if self.oldVipLevel == 1 then
        local exp = self.all_player_vip[1].max_exp
        if self.total_exp >= exp and self.all_player_vip[1]:GetIsLock() == 0 then
            self.all_player_vip[1]:SetIsLock(1)
            self.all_player_vip[1]:SetAwardState(1)
            self.all_player_vip[1]:SetVIPPrivile()
            self.isRedFirt = false
        end
    end
end

function VIPPrivilegeModel:NotificationExp(coin)
    if self.currentVipLevel >= self.vipmaxlevel then
        return
    end
    if self.tempExp and self.tempExp ~= self.total_exp then
        self.tempExp = self.total_exp
        return
    end
    if not self.isUpLevel then
        self.uplevel = 0
    end

    self:ChangerTotaleExp(coin)
    ---特殊判定 等级是1 处理
    self:ChangeVipFirstState()
    --改变奖励状态
    for i = 2, #self.all_player_vip do
        if self.all_player_vip[i].max_exp <= self.total_exp and self.all_player_vip[i]:GetIsLock() == 0 then
            self.all_player_vip[i]:SetIsLock(1)
            self.all_player_vip[i]:SetAwardState(1)
            self.all_player_vip[i]:SetVIPPrivile()
            self.uplevel = self.uplevel + 1
        end
    end
    --是否是提升等级
    if self.uplevel > 0 then
        self.isRedFirt = false
        self.isUpLevel = true
        self:GetFreeGift()
        ---发送VIP 检测事件
        _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.VIP, 0)
        ---刷新红点
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.VipPage.id)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StoreVoucher.id)
        self:AddVipPopQuene()
    end
    self.lastRealVipLv = self.realVipLevel
    ---当界面中打开时 更新界面数据
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
    if window then
        if not self.isUpLevel then
            window.View:UpdateViewOneData()
        end
    end
    self.tempExp = self.total_exp
end

---Vip提升弹窗
function VIPPrivilegeModel:AddVipPopQuene()
    local popFuncItem = {}
    popFuncItem.OpenViewFun = function(endCallback)
        self:ChangeCurLevel(self.uplevel)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeUpLevelView.Name, endCallback)
    end
    _G.PopWindowManager:GetInstance():AddPopWindowQuene(popFuncItem, _G.PopViewShowOrder.VipLevelUp)
end

---领取免费礼包
function VIPPrivilegeModel:RequestFreeGift(i)
    local promotion = self.all_player_vip[i].player_vip_cfg.promotion
    if not _G.table.isEmptyOrNil(promotion) and _G.table.indexof(self.award_list, i) == false then
        require("VIPPrivilegeNet"):GetInstance():FreeAwardVIp({ id = i }, function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.table.insert(self.award_list, i)
        end)
    end
end

---获取免费礼包
---@param isReconnect boolean 是否重连
function VIPPrivilegeModel:GetFreeGift(isReconnect)
    if isReconnect then
        for i = 1, self.realVipLevel do
            self:RequestFreeGift(i)
        end
        return
    end

    if self.lastRealVipLv < self.realVipLevel then
        for i = self.lastRealVipLv + 1, self.realVipLevel do
            self:RequestFreeGift(i)
        end
    end
end

