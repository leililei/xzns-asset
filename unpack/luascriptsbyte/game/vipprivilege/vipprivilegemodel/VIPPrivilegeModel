---购买VIP礼包
---@param vipid number vip特权配置表 id
function VIPPrivilegeModel:BuyVipGiftBag(vipLv, call)
    local vipinfo = self.all_player_vip[vipLv]
    local goods = vipinfo.goods
    require("MallNet"):GetInstance():BuyItem(
        goods.store_exchange,
        1,
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            require("MallManager"):GetInstance():SetItemBuyTimes(goods.itemid, goods.type_reset, 1)
            _G.StorageManager:GetInstance():ConsumeItem(goods.type_price, 0, goods.price)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.PopWindowManager:GetInstance():AddAwardPopQuene(msg)
            vipinfo:SetAwardState_Buy(2)
            if call then
                call()
            end
        end
    )
end

---领取特权礼包
---@param p_id number 26周礼包 27月礼包
function VIPPrivilegeModel:BuyVipPrivilegeGiftBag(p_id, call)
    local msg = {
        p_id = p_id
    }
    require "VIPPrivilegeNet":GetInstance():BuyVipPrivilegeGiftBag(
        msg,
        _G._G.handlerbind(self, self.BuyVipPrivilegeGiftBagSuc, p_id, call)
    )
end

function VIPPrivilegeModel:BuyVipPrivilegeGiftBagSuc(data, p_id, call)
    if data.ack ~= 1 then
        return
    end
    --添加仓库
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.PopWindowManager:GetInstance():AddAwardPopQuene(data)
    --添加
    if self.p_award == nil then
        self.p_award = {}
    end
    _G.table.insert(self.p_award, p_id)
    --刷新密令特权红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.VipGift.id)
    if call then
        call()
    end
end

