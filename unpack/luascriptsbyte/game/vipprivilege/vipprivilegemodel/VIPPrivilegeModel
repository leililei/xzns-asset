---检测vip等级解锁后是否点击
function VIPPrivilegeModel:CheckGiftBagIsBuy(vipid)
    local unlockLv = _G.PlayerPrefsManager.GetTable("VIP_Unlock_Lv") or {}
    if not unlockLv[vipid] and self.realVipLevel >= vipid then
        return true
    end

    local vipinfo = self.all_player_vip[vipid]
    if vipid <= self.realVipLevel and vipinfo:GetAwardState_Buy() ~= 2 then
        local cfg = _G.ConfigManager.store_exchange_cfg[vipinfo.player_vip_cfg.store_exchange]
        if cfg.price == 0 then
            return true
        end
    end

    return false
end

---红点检测
function VIPPrivilegeModel:CheckRedNumer(param)
    local flag = self:CheckGiftBagIsBuy(param)
    return flag and 1 or 0
end

---对外接口 检测密令特权红点
--检测密令特权有可领取未领取奖励时，在页签和福利按钮上显示红点；全部领取后，红点消失；
--密令特权有未达到领取条件时在页签和福利按钮上显示红点，进入一次页签后红点消失；
function VIPPrivilegeModel:CheckRedMiling()
    --没有开启
    if not self:CheckGiftOpen() then
        return false
    end
    if _G.table.isEmptyOrNil(self.all_player_vip) or self.all_player_vip == nil then
        return false
    end
    if _G.PlayerPrefsManager.GetInt("VIPPrivilegeMiLing" .. _G.PlayerModel:GetInstance():GetPlayerUid()) ~= 1 then
        return true
    end

    local gift_list = {}
    for i = 1, #self.all_player_vip do
        if self.all_player_vip[i].weekid > 0 then
            _G.table.insert(gift_list, self.all_player_vip[i])
        elseif self.all_player_vip[i].monthid > 0 then
            _G.table.insert(gift_list, self.all_player_vip[i])
        end
    end
    ---1 代表周礼包 2 代表月礼包
    --local unLingqu = false
    for i = 1, 2 do
        local pri_enum = _G.PrivilegeType.VIP.WeekGift
        if i == 2 then
            pri_enum = _G.PrivilegeType.VIP.MonthGift
        end
        local falg = self:CheckGift(pri_enum, gift_list[i].id)
        if falg == 1 then -- 有可以领取的奖励
            return true
        end
    end
    return false
end

function VIPPrivilegeModel:CheckGiftOpen()
    local falg = false
    local open = _G.ConfigManager.discrete_cfg[105902]
    if self.currentVipLevel >= (open[1][1] - open[1][2]) then
        falg = true
    end
    return falg
end

function VIPPrivilegeModel:CheckGift(id, vipid)
    if vipid > self.currentVipLevel then
        return 0   --没有达到领取条件
    end
    local flag = 1 -- 可以领取
    if self.p_award then
        for i = 1, #self.p_award do
            if self.p_award[i] == id then
                flag = 2 --已经领取
            end
        end
    end
    return flag
end

function VIPPrivilegeModel:GetAllAttribute()
    if _G.table.isEmptyOrNil(self.all_player_vip) then
        return { attribute = {}, attributePercent = {}, attriOther = {} }, {}
    end
    local attr = self.all_player_vip[self.realVipLevel]:GetAllAttribute()
    local attributeChangeType = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attr)
    return attr, attributeChangeType
end

return VIPPrivilegeModel
