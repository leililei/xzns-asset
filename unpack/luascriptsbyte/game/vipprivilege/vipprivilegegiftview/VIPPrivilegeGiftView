---@class VIPPrivilegeGiftView : UIBaseView	中文描述
---@field public go_table VIPPrivilegeGiftView_GoTable GoTable
local VIPPrivilegeGiftView = _G.BaseClass("VIPPrivilegeGiftView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function VIPPrivilegeGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdate, self)
end

-- 6点刷新回调
function VIPPrivilegeGiftView:OnSixClockUpdate()
    self:UpdateDesc()
end

function VIPPrivilegeGiftView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdate, self)
end

---界面的入口函数
function VIPPrivilegeGiftView:OnCreate()
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, _G.ConfigManager.ui_cfg.VIPPrivilegeView
                                                                             .resources)
        )
    end
    self.vipMaxLevel = require("VIPPrivilegeModel"):GetInstance().vipmaxlevel
    self.order = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    self.cur_level = require "VIPPrivilegeModel":GetInstance().currentVipLevel
    _G.PlayerPrefsManager.SetInt("VIPPrivilegeMiLing" .. _G.PlayerModel:GetInstance():GetPlayerUid(),1)
    --local path = _G.ConfigManager.ui_effect_cfg["ef_Vip_icon_loop"]
    --_G.UIUtils.LoadEffectByCfg(path, self.go_table.obj_uieffect)
    self:SetLevel()
    self:SetDesc()
    self:SetJindu()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MailViewChild, self.go_table.obj_Effect)
    local liste = require "VIPPrivilegeModel":GetInstance().all_player_vip
    self.awardList = {}
    self.gift_list = {}
    for i = 1, #liste do
        if liste[i].weekid > 0 then
            _G.table.insert(self.gift_list, liste[i])
        elseif liste[i].monthid > 0 then
            _G.table.insert(self.gift_list, liste[i])
        end
    end
    for i = 1, 2 do
        self:SetGift(i)
    end
    require "VIPPrivilegeModel":GetInstance().isRedFirstMiling = true
    --刷新密令特权红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.VipGift.id)
end

---按钮点击事件在这里派发
function VIPPrivilegeGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_get_week then
        self:OnClickGift(1)
    elseif go == self.go_table.aorbtn_get_month then
        self:OnClickGift(2)
    elseif go == self.go_table.aorbtn_up_quick then
        self:OnClickUpQuick()
    elseif go == self.go_table.aorbtn_help then
        self:OnClickHelp()
    elseif go == self.go_table.aorbtn_zhml then
        local isExit = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
        if isExit then
            return
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeGiftView.Name)
        end
    end
end
function VIPPrivilegeGiftView:UpdateDesc()
    self:SetLevel()
    self:SetJindu()
    self:SetDesc()
    for i = 1, 2 do
        self:SetGift(i)
    end
end
---帮助
function VIPPrivilegeGiftView:OnClickHelp()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 38)
end
--快速提升
function VIPPrivilegeGiftView:OnClickUpQuick()
    _G.JumpManager:GetInstance():Jump(108001)
end
function VIPPrivilegeGiftView:OnClickGift(num)
    local p_id = _G.PrivilegeType.VIP.WeekGift
    if num == 2 then
        p_id = _G.PrivilegeType.VIP.MonthGift
    end
    require "VIPPrivilegeModel":GetInstance():BuyVipPrivilegeGiftBag(
        p_id,
        function()
            --刷新数据
            self:SetGift(num)
        end
    )
end
---设置礼包
---@param num number 1 = 周礼包 2 = 月礼包
function VIPPrivilegeGiftView:SetGift(num)
    local vipinfo = self.gift_list[num]
    local tb = {}
    local store_extraCfg = {}
    local name = ""
    local pri_id = 0
    local pri_enum = 26
    local day = 7
    if num == 1 then
        tb = self.go_table.obj_VIPPrivilege_week
        pri_id = vipinfo.privile_weekid
        store_extraCfg = _G.ConfigManager.store_extra_cfg[vipinfo.weekid]
        name = _G.LangUtil.GetLangPackValue(90000010272)
        pri_enum = 26
        day = 7
    else
        tb = self.go_table.obj_VIPPrivilege_month
        pri_id = vipinfo.privile_montid
        store_extraCfg = _G.ConfigManager.store_extra_cfg[vipinfo.monthid]
        name = _G.LangUtil.GetLangPackValue(90000010273)
        pri_enum = 27
        day = 30
    end
    tb = _G.GetAutoGoTable(tb)
    if pri_id == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("Error: 特权礼包：" .. num)
        end
        return
    end
    tb.aortext_name.text = name
    local falg = require "VIPPrivilegeModel":GetInstance():CheckGift(pri_enum, vipinfo.id)
    tb.aortext_state.text = _G.LangUtil.TryGetLangValue(90000010287, vipinfo.id)
    tb.aortext_tips.text = _G.LangUtil.TryGetLangValue(90000010275, day)
    _G.GameUtil.SetActiveByCondition(tb.aortext_state, falg == 0)
    _G.GameUtil.SetActiveByCondition(tb.obj_get, falg == 2)
    self:SetAwardState(num, falg == 1)
    local count = #store_extraCfg.goods
    local data_lists = store_extraCfg.goods
    -- if self.awardList[num] == nil then
    --     self.awardList[num] = 1 --目前 self.refshawrd 只是判空操作
    -- end
    for i = 1, count do
        local awrad_node = tb.obj_AwardListsNode:GetChildE(i - 1)
        if awrad_node:GetChildCountE() > 0 then
            for j = 1, awrad_node:GetChildCountE() do
                _G.DestroyObject(awrad_node:GetChildE(0))
                --_G.PoolsManager:GetInstance():Despawn(awrad_node:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
        local data = data_lists[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            awrad_node,
            function(item)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                item:ShowEffect(falg == 0 or falg == 1)
            end
        )
    end
end
function VIPPrivilegeGiftView:SetAwardState(num, stateboolen)
    if num == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_get_week, stateboolen)
        self:ShowBtnUIEffect(self.go_table.obj_weekEffect, stateboolen)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_get_month, stateboolen)
        self:ShowBtnUIEffect(self.go_table.obj_monthEffect, stateboolen)
    end
end
