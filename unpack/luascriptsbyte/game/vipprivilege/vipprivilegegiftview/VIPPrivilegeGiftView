---设置等级
function VIPPrivilegeGiftView:SetLevel()
    self.go_table.aortext_curlv.text = self.cur_level--GetLangPackValue(9002050018, self.cur_level)
    self.go_table.aortext_upLv.text = GetLangPackValue(9002050018, self.cur_level + 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_curlv, self.cur_level < self.vipMaxLevel)
    --_G.GameUtil.SetActiveByCondition(self.go_table.aortext_upLv, self.cur_level < self.vipMaxLevel)
end
---设置进度
function VIPPrivilegeGiftView:SetJindu()
    local model = require "VIPPrivilegeModel":GetInstance()
    local level = model.currentVipLevel
    local nextlevel = level + 1
    if level >= self.vipMaxLevel then
        nextlevel = self.vipMaxLevel
        if _G.AppSetting.IsXzns then
            self.go_table.aorimage_bar:SetRectTransformSize(299, 10)
        else
            self.go_table.aorimage_bar:SetRectTransformSize(310, 30)
        end
        return
    end
    local curcfg = _G.ConfigManager.player_vip_cfg[level]
    local nextcfg = _G.ConfigManager.player_vip_cfg[nextlevel]
    local value
    local cur_exp = model.total_exp - curcfg.exp
    local max_exp = nextcfg.exp - curcfg.exp
    if cur_exp <= 0 then
        cur_exp = 0
    end
    local w = cur_exp / max_exp
    if _G.AppSetting.IsXzns then
        if w >= 1 then
            w = 1
            value = w * 299
        else
            value = w * 299
        end
        self.go_table.aorimage_bar:SetRectTransformSize(value > 0 and value or 0, 10)
    else
        if w >= 1 then
            w = 1
            value = w * 310
        else
            value = w * 310
        end
        self.go_table.aorimage_bar:SetRectTransformSize(value > 0 and value or 0, 30)
    end
end
function VIPPrivilegeGiftView:SetDesc()
    local model = require "VIPPrivilegeModel":GetInstance()
    local palyer_vipinfo = model.all_player_vip[model.currentVipLevel]
    if palyer_vipinfo.player_vip_cfg.name == 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("策划未配置 vip 等级名字")
        end
    else
        self.go_table.aortext_title.text = _G.LangUtil.TryGetLangValue(palyer_vipinfo.player_vip_cfg.name)
    end
    if model.currentVipLevel < self.vipMaxLevel then
        local exp = 0
        local up = _G.ConfigManager.player_vip_cfg[model.currentVipLevel + 1]
        exp = up.exp - model.total_exp
        self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(90000010270)
        local cur_exp = model.total_exp - palyer_vipinfo.max_exp
        if cur_exp <= 0 then
            cur_exp = 0
        end
        self.go_table.aortext_jindu.text = cur_exp .. "/" .. (up.exp - palyer_vipinfo.max_exp)
        self.go_table.aortext_huode.text = up.exp - palyer_vipinfo.max_exp - cur_exp
        _G.GameUtil.ReBuildRTF(self.go_table.obj_huode)
    else
        self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(90000010281, model.currentVipLevel)
        self.go_table.aortext_jindu.text = _G.LangUtil.GetLangPackValue(90000010282)
        self.go_table.obj_tips:SetActiveE(0)
    end
end

return VIPPrivilegeGiftView
