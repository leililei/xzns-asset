---@class VIPPrivilegeUpLevelView : UIBaseView	中文描述
---@field public go_table VIPPrivilegeUpLevelView_GoTable GoTable
local VIPPrivilegeUpLevelView = _G.BaseClass("VIPPrivilegeUpLevelView", _G.UIBaseView)
local colorType = {
    [1] = "c95f00",
    [2] = "E0D9B8"
}
local vipNum = {
    [0] = "ui_txt_0",
    [1] = "ui_txt_1",
    [2] = "ui_txt_2",
    [3] = "ui_txt_3",
    [4] = "ui_txt_4",
    [5] = "ui_txt_5",
    [6] = "ui_txt_6",
    [7] = "ui_txt_7",
    [8] = "ui_txt_8",
    [9] = "ui_txt_9"
}
function VIPPrivilegeUpLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.AffixItems = {}
end

---界面的入口函数
function VIPPrivilegeUpLevelView:OnCreate(callback)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.VIPPrivilegeUpLevelView, self.go_table)
    if _G.AppSetting.IsXzns then
        colorType[1] = "A7EFBC"
        colorType[2] = "EDEDED"
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    self.call = callback
    self.vipMaxLevel = require("VIPPrivilegeModel"):GetInstance().vipmaxlevel
    self.isUpLevel = require "VIPPrivilegeModel":GetInstance().isUpLevel
    if self.isUpLevel then
        self.oldLv = require "VIPPrivilegeModel":GetInstance().oldVipLevel
        self.curLv = self.oldLv + require "VIPPrivilegeModel":GetInstance().uplevel
    else
        self.oldLv = _G.PlayerPrefsManager.GetInt("LastUpVipLevel", 1)
        self.curLv = require "VIPPrivilegeModel":GetInstance().currentVipLevel
    end
    _G.PlayerPrefsManager.SetInt("LastUpVipLevel", self.curLv)
    local lv = self.curLv > self.vipMaxLevel and self.vipMaxLevel or self.curLv
    local nums = {}
    while lv > 0 do
        _G.table.insert(nums, lv % 10)
        lv = lv // 10
    end
    local obj
    for i = #nums, 1, -1 do
        self.go_table.aorimage_num.SpriteName = vipNum[nums[i]]
        obj = _G.InstantiateObject(self.go_table.aorimage_num, self.go_table.obj_viptext)
        if _G.IsNil(obj) then
            obj:SetSiblingIndexE(0)
        end
    end
    self.go_table.obj_vip:SetSiblingIndexE(0)
    _G.AudioManager.PlayAudioByAudioCfgID(2057)
    self.textList = {}
    self.oldPrivile = {}
    self.curPrivile = {}
    self.addPrivileList = {}
    self:SetOldPrivilege()
    self:SetCurPrivilege()
    self:ShowNewPrivile()
    self:SetGiftPreview()
    self:LoadEff()
    local time = _G.PopWindowManager:GetInstance():AutoCloseTime(_G.PopViewShowOrder.VipLevelUp)
    if time > 0 then
        self.closeTimer =
            _G.TimerManager:GetInstance():GetTimer(
            time,
            function()
                self:OnClickBtn(self.go_table.aorbtn_anyClose)
            end,
            self,
            true,
            false
        )
        self.closeTimer:Start()
    end
end

---按钮点击事件在这里派发
function VIPPrivilegeUpLevelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyClose then
        if self.isUpLevel then
            require "VIPPrivilegeModel":GetInstance():ChangeIsUpLevel()
            require "VIPPrivilegeModel":GetInstance():ChangeOldLevel()
        end
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
        if window then
            window.View:UpdateDesc()
        end
        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeGiftView.Name)
        if window then
            window.View:UpdateDesc()
        end
        --刷新密令特权红点
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.VipGift.id)
        self:Close()
    end
end

---设置特权
function VIPPrivilegeUpLevelView:SetOldPrivilege()
    local all = require "VIPPrivilegeModel":GetInstance().all_player_vip
    local newPr = all[self.oldLv].player_vip_cfg.privilege_extra[1]
    local oldPr = all[self.oldLv].player_vip_cfg.privilege_extra[2]
    local cfg = _G.ConfigManager.privilege_cfg
    for _, value in pairs(newPr) do
        local data = {}
        data.cfg = cfg[value]
        data.sid = value
        data.isNew = false
        self.addPrivileList[value] = 1
        _G.table.insert(self.oldPrivile, data)
        _G.table.insert(self.curPrivile, data)
    end
    for _, value in pairs(oldPr) do
        local data = {}
        data.cfg = cfg[value]
        data.sid = value
        data.isNew = false
        self.addPrivileList[value] = 1
        _G.table.insert(self.oldPrivile, data)
        _G.table.insert(self.curPrivile, data)
    end
    --ID顺序：ID序号升序排列；
    _G.SortList(
        self.oldPrivile,
        function(priv)
            return priv.sid
        end
    )
end

function VIPPrivilegeUpLevelView:SetCurPrivilege()
    local all = require "VIPPrivilegeModel":GetInstance().all_player_vip
    local cfg = _G.ConfigManager.privilege_cfg
    for i = self.oldLv + 1, self.curLv do
        local newPr = all[i].player_vip_cfg.privilege_extra[1]
        for _, value in pairs(newPr) do
            if not self.addPrivileList[value] then
                local data = {}
                data.cfg = cfg[value]
                data.isNew = true
                data.sid = value
                _G.table.insert(self.curPrivile, data)
            end
        end
    end
    _G.SortList(
        self.curPrivile,
        function(priv)
            local num = 10
            if not priv.isNew then
                num = 9
            end
            return num, priv.sid
        end
    )
end

---新等级特权
function VIPPrivilegeUpLevelView:ShowNewPrivile()
    if not self.curPrivile then
        return
    end
    for _, v in pairs(self.curPrivile) do
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/VIPPrivilege/$_obj_txtItem",
            _G.ePoolType.Temporary,
            self.go_table.trans_rContent,
            function(obj)
                local tb = _G.GetAutoGoTable(obj)
                self:UpdateText(tb, v)
            end
        )
    end
end

---更新特权文本
function VIPPrivilegeUpLevelView:UpdateText(tb, data)
    local desc = data.cfg.desc
    if _G.AppSetting.IsXzns then--星座特权升级界面文本颜色用浅色
        desc = data.cfg.desc1
        colorType[1] = "E18F00"
    end
    if not desc or desc < 1 then
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
    else
        _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
        if data.isNew then
            tb.aortext_content.text = _G.GetLangPackValue(desc)
        else
            tb.aortext_content.text = _G.string.replace(_G.GetLangPackValue(desc), colorType[1], colorType[2])
        end
        _G.GameUtil.SetActiveByCondition(tb.obj_new, data.isNew)
    end
end

-- 解锁礼包显示
function VIPPrivilegeUpLevelView:SetGiftPreview()
    local level = self.curLv > self.vipMaxLevel and self.vipMaxLevel or self.curLv
    local vipinfo = require "VIPPrivilegeModel":GetInstance().all_player_vip[level]
    self.awrdlists_Buy = {}
    local store_exchange_id = vipinfo.player_vip_cfg.store_exchange
    local cfg = _G.ConfigManager.store_exchange_cfg
    self.awrdlists_Buy = cfg

    self.awardList = _G.ConfigManager.store_exchange_cfg[store_exchange_id].goods
    self:ParseAward(self.awardList)

    local item, index
    index = 0
    for k, v in pairs(self.awardList) do
        item = _G.InstantiateObject(self.go_table.obj_AwardItem, self.go_table.obj_awards)
        self:RefreshItem(index, item)
        index = index + 1
    end
end

--解析奖励
---@param data award.i_award_item 奖励数据
function VIPPrivilegeUpLevelView:ParseAward(data)
    self.AffixData = {}
    for i = 1, #data do
        local data2 = {sid = data[i][1], count = data[i][2]}
        local type = _G.StorageManager:GetInstance():CheckSidType(data2.sid)
        if type == _G.StorageType.Card or type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            for i = 1, data2.count do
                local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data2.sid, 0)
                --, data2.extend)
                _G.table.insert(self.AffixData, itemData)
            end
        else
            local itemData = _G.StorageManager:GetInstance():GetItemDataClass(data2.sid, data2.count)
            _G.table.insert(self.AffixData, itemData)
        end
    end
end

function VIPPrivilegeUpLevelView:LoadEff()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_sunlight,
        self.go_table.obj_Effect,
        function(obj)
            if self:IsNil() then
                _G.DestroyObject(obj)
                return
            end
        end
    )
end

---刷新附件
function VIPPrivilegeUpLevelView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.AffixData[index]
    local instance = obj:GetInstanceIDE()
    if self.AffixItems[instance] == nil then
        self.AffixItems[instance] = require("BaseAwardNewItem").New(obj, nil, 94)
    end
    self.AffixItems[instance]:Show(data)
    self.AffixItems[instance].gameObject:SetLocalScaleXYZ(0.9)
end

function VIPPrivilegeUpLevelView:OnDestroy()
    if self.call then
        self.call()
    end
    if self.closeTimer then
        self.closeTimer:Stop()
    end
    _G.PopWindowManager:GetInstance():SetNowPopping(false)
    _G.PopWindowManager:GetInstance():Next()
end

return VIPPrivilegeUpLevelView
