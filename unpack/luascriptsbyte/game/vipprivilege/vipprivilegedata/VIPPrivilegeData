local BaseItemData = require "BaseItemData"
---@class VIPPrivilegeData	中文描述
local VIPPrivilegeData = _G.BaseClass("VIPPrivilegeData", BaseItemData)

---类的构造函数
---@field id number vip特权id
---@field max_exp number 经验池
---@field cur_exp number 当前经验池
---@field goods table {id = 充值的id，prices = 价格，goods= 奖励的物品}
function VIPPrivilegeData:__init()
    self.id = 0
    self.max_exp = 0
    self.awardstate_buy = 0 --人民币
    self.awardstate_Free = 0 --免费领取
    self.player_vip_cfg = {}
    self.weekid = 0
    self.monthid = 0
    self.privile_montid = 0
    self.privile_weekid = 0
    self.isLock = 0 --0 未解锁 1，解锁
end
---类的析构函数
function VIPPrivilegeData:Dispose()
end

function VIPPrivilegeData:ParseInitMsg(msg)
    local cfg = _G.ConfigManager.player_vip_cfg[msg.id]
    self.player_vip_cfg = cfg
    self.id = cfg.id
    self.max_exp = cfg.exp
    self:SetPrivilege()
    self:SetBuyItem()
    self:GetBaseAttr(cfg.att)
end

---获取基础属性
function VIPPrivilegeData:GetBaseAttr(att)
    if not self.attribute then
        local attributeManager = _G.AttributeClassManager:GetInstance()
        self.attribute = attributeManager:GetAttribtueClass()
        for _, v in pairs(att) do
            self.attribute:AddValueByName(
                v[1],
                attributeManager:GetValueWithName(v[1], v[3], v[2]),
                false,
                _G.tonumber(v[2])
            )
        end
    end
    return self.attribute
end

---刷新属性
function VIPPrivilegeData:GetAllAttribute()
    if not self.attribute then
        self:GetBaseAttr(self.player_vip_cfg.att)
    end
    local cardAttr = self.attribute:Clone()
    cardAttr:AttributeToOther()
    return cardAttr
end

---礼包是否满足购买条件
function VIPPrivilegeData:CheckCondition()
    local store_exchange_id = self.player_vip_cfg.store_exchange
    local cfg = _G.ConfigManager.store_exchange_cfg[store_exchange_id]
    if _G.table.isEmptyOrNil(cfg.conditions) then
       return true
    end

    if _G.GlobalConditionManager.CheckConditionArrays(cfg.conditions) then
        return true
    end

    return false
end

--判断是不是解锁
function VIPPrivilegeData:SetIsLock(state)
    self.isLock = state
end
function VIPPrivilegeData:GetIsLock()
    return self.isLock
end

---设置vip 尊享礼包 的状态，0 = 不可领取 1 =可领取，2 = 已领取
function VIPPrivilegeData:SetAwardState(buystate)
    self.awardstate_buy = buystate --人民币
end
function VIPPrivilegeData:SetAwardState_Buy(buystate)
    self.awardstate_buy = buystate --人民币
end
function VIPPrivilegeData:GetAwardState_Buy()
    return self.awardstate_buy
end
function VIPPrivilegeData:GetAwardState()
    return self.awardstate_buy
end
---设置特权
function VIPPrivilegeData:SetPrivilege()
    self.Privile = {}
    ---@field cfg table 特权配置表
    ---@field sid number 特权id
    ---@field isNew boolean 是否是新特权
    local newPr = self.player_vip_cfg.privilege_extra[1]
    local oldPr = self.player_vip_cfg.privilege_extra[2]
    local cfg = _G.ConfigManager.privilege_cfg
    for _, value in ipairs(newPr) do
        local data = {}
        data.cfg = cfg[value]
        data.isNew = true
        data.sid = value
        if not _G.table.isEmptyOrNil(cfg[value].privilege) then
            if cfg[value].privilege[1][1] == _G.PrivilegeType.VIP.WeekGift then
                self.privile_weekid = cfg[value].id
                self.weekid = cfg[value].privilege[1][2]
            elseif cfg[value].privilege[1][1] == _G.PrivilegeType.VIP.MonthGift then
                self.monthid = cfg[value].privilege[1][2]
                self.privile_montid = cfg[value].id
            end
        end
        _G.table.insert(self.Privile, data)
    end
    for _, value in ipairs(oldPr) do
        local data = {}
        data.cfg = cfg[value]
        data.isNew = false
        data.sid = value
        _G.table.insert(self.Privile, data)
    end
    --排序  按照新旧特权显示>按照配置的顺序ID显示  新旧特权：当前等级新增特权显示在最上方，老特权显示在下方；
    --ID顺序：ID序号升序排列；
