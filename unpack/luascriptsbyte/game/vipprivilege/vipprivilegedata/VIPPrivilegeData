    --     self.Privile,
    --     function(priv)
    --         local num = 10
    --         if not priv.isNew then
    --             num = 9
    --         end
    --         return num, priv.sid
    --     end
    -- )
end

function VIPPrivilegeData:GetPrivilege()
    return self.Privile
end
---设置VIP 特权
function VIPPrivilegeData:SetVIPPrivile()
    for i = 1, #self.Privile do
        require "PrivilegeManager":GetInstance():AddPrivilege(self.Privile[i].sid, true, true)
    end
end

function VIPPrivilegeData:SetBuyItem()
    local store_exchange_id = self.player_vip_cfg.store_exchange
    local cfg = _G.ConfigManager.store_exchange_cfg[store_exchange_id]
    self.goods = {
        itemid = cfg.id, --物品id
        count_limit = 1, --限购次数
        price = cfg.price, --价钱
        goods = cfg.goods, --奖励的物品
        type_reset = cfg.type_reset,
        type_price = cfg.type_price,
        store_exchange = store_exchange_id
    }
end
return VIPPrivilegeData
