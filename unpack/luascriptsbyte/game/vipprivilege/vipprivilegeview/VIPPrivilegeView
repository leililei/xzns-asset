function VIPPrivilegeView:ShowAwardStateOther()
    local model = require "VIPPrivilegeModel":GetInstance()
    local vipinfo = model.all_player_vip[self.cur_level]
    local awardState = vipinfo:GetAwardState_Buy()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_get, awardState == 2)
