    )
end

--当前等级奖励物品(充值人民币)
function VIPPrivilegeView:AwardListes_Buy()
    local vipinfo = require "VIPPrivilegeModel":GetInstance().all_player_vip[self.cur_level]
    self.awrdlists_Buy = {}
    local store_exchange_id = vipinfo.player_vip_cfg.store_exchange
    local cfg = _G.ConfigManager.store_exchange_cfg[store_exchange_id]
    local totalAmount = #cfg.goods
    local rowIndex = 1
    for i = 1, #cfg.goods do
        if not self.awrdlists_Buy[rowIndex] then
            self.awrdlists_Buy[rowIndex] = {}
        end
        _G.table.insert(self.awrdlists_Buy[rowIndex], cfg.goods[i])
        if totalAmount > 3 and totalAmount < 6 then
            if i == 2 then
                rowIndex = rowIndex + 1
            end
        elseif totalAmount >= 6 then
            if i % 3 == 0 then
                rowIndex = rowIndex + 1
            end
        end
    end
    if not self.item_lua_buy then
        self.item_lua_buy = {}
    end
    --奖励两行显示
    --[[    for i = 1, self.go_table.obj_awardContent:GetChildCountE() do
        local tb = _G.GetAutoGoTable(self.go_table["trans_Root" .. i])
        if self.awrdlists_Buy[i] then
            local data = self.awrdlists_Buy[i]
            tb.gameObject:SetActiveE(1)
            self:RefreshList_Buy_Item(data, tb, i)
        else
            tb.gameObject:SetActiveE(0)
        end
    end]]
    --奖励一行显示
    local tb = _G.GetAutoGoTable(self.go_table["trans_Root" .. 1])
    tb.gameObject:SetActiveE(1)
    if #cfg.goods <= 3 then
        tb.gameObject:SetPivotPosition(0.5, 1)
    else
        tb.gameObject:SetPivotPosition(0, 1)
    end
    self:RefreshList_Buy_ScrollItem(cfg.goods, tb)
end

