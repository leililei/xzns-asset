function VIPPrivilegeView:AsCompBack()
    if self.isSet == true and self.AsCount <= 0 then
        if self.lineObj then
            self.lineObj:SetSiblingIndexE(self.LineIndex)
            self.isloadIng = false
        else
            _G.PoolsManager:GetInstance():Spawn(
                textLinePath,
                _G.ePoolType.Temporary,
                self.go_table.trans_Content,
                function(obj)
                    self.isloadIng = false
                    if self:IsNil() then
                        DestroyObject(obj)
                    end
                    self.lineObj = obj
                    obj:SetSiblingIndexE(self.LineIndex)
                    self.isloadIng = false
                end
            )
        end
        self.isSet = false
    end
end

function VIPPrivilegeView:ShowText_xzns()
    if not self.Privile then
        return
    end
    local count = #self.textList
    local count2 = #self.Privile
    local data = {}
    if self.isloadIng  then
        return
    end
    self.LineIndex = 0
    self.AsCount = 0
    self.isloadIng = true
    self.isSet = false

    for i = 1, count2 do
        local data = self.Privile[i]
        if data.isNew == false then
            self.LineIndex = i - 1
            if self.LineIndex < 0 then
                self.LineIndex = 0
            end
            break
        end
    end
    if count < count2 then
        self.AsCount = count2 - count
        for i = count + 1, count2 do
            self.textList[i] = true
            _G.PoolsManager:GetInstance():Spawn(
                    textPrefabPath,
                    _G.ePoolType.Temporary,
                    self.go_table.trans_Content,
                    function(obj)
                        self.textList[i] = _G.GetAutoGoTable(obj)
                        self:UpdateText(i)
                        self.AsCount = self.AsCount - 1
                        self:AsCompBack()
                    end
            )
        end
    end
    self.isSet = true
    for i = 1, count do
        if self.textList[i] ~= true then
            if i <= count2 then
                _G.GameUtil.SetActiveByCondition(self.textList[i].gameObject, true)
                self:UpdateText(i)
            else
                _G.GameUtil.SetActiveByCondition(self.textList[i].gameObject, false)
            end
        end
    end
    self:AsCompBack()
end

