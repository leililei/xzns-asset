---初始化vip等级列表
function VIPPrivilegeView:InitVipList()
    local cfg = _G.ConfigManager.player_vip_cfg
    self.vipData = {}
    for index, v in ipairs(cfg) do
        if not v.display_lv or self.cur_level >= v.display_lv then
            local store_exchange_id = v.store_exchange
            local exchangeCfg = _G.ConfigManager.store_exchange_cfg[store_exchange_id]
            self.vipData[index] = {
                id = v.id,
                award = exchangeCfg.goods[1]
            }
        end
    end
    if not self.vipList then
        self.go_table.scrollloopvectical_vipList:InitItemData(#self.vipData, _G.handler(self, self.RefreshVipLevelList))
        self.vipList = self.go_table.scrollloopvectical_vipList
    else
        self.vipList:UpdateCount(#self.vipData)
    end
    if self.delayCo then
        _G.coroutine.stopwaiting(self.delayCo)
        self.delayCo = nil
    end
    self.delayCo =
        _G.DelayFrameDo(
            function()
                self.vipList:ScrollToIndex(self.selectVipId - 1)
            end
        )
    self.go_table.obj_LoginVipExp:SetActiveE(_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(273) and 1 or 0)
end

