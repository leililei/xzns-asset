---属性加成
function VIPPrivilegeView:ShowAttribute()
    local all_player_vip = require "VIPPrivilegeModel":GetInstance().all_player_vip
    local vipinfo = all_player_vip[self.cur_level]
    local showList = {}
    if vipinfo and vipinfo.attribute then
        if self.go_table.obj_PropContent:GetChildCountE() > 0 then
            self.go_table.obj_PropContent:ClearChildren()
        end
        local prop = vipinfo.attribute:GetAttrByName()
        for i, v in pairs(prop) do
            if v > 0 then
                _G.table.insert(showList, { key = i, sortId = _G.AttrType[i].sortid, num = v })
            end
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        for _, v in pairs(showList) do
            local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                local tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[v.key].des
                local numStr = v.num
                tb.aorimage_icon.SpriteName = _G.AttrTypeIcon[v.key]
                if _G.AttrType[v.key].percentage == 1 then
                    numStr = _G.GameUtil.FormatNum(numStr * 100)
                else
                    numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
                end
                tb.aortext_Num.text = numStr
                tb.gameObject:SetActiveE(1)
            end
        end
    end
end

