function VIPPrivilegeView:OnClickVipLevelItem(obj, isOn, index)
    if self.selectVipId == index then
        return
    end
    ---上一次选中的item
    local lastItemTb = self.vipInstanceIDList[self.selectVipId]
    _G.GameUtil.SetActiveByCondition(lastItemTb.aorrawimage_On, false)
    --lastItemTb.aortext_lv.text = _G.string.replace(lastItemTb.aortext_lv.text, "#515268", "#ebf5fe")
    require "VIPPrivilegeModel":GetInstance():RefreshRedPoint(self.selectVipId)

    ---当前选中的item
    local curItemTb = self.vipInstanceIDList[index]
    _G.GameUtil.SetActiveByCondition(curItemTb.aorrawimage_On, true)
    if _G.AppSetting.IsXzns then
        local gradient = lastItemTb.aortext_lv:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        if gradient then
            gradient.enabled = false
        else
            _G.UIUtils.ChangeUIMethod({4,"F5F5E9"}, lastItemTb.aortext_lv)
        end
        gradient = curItemTb.aortext_lv:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        if gradient then
            gradient.enabled = true
        else
            _G.UIUtils.ChangeUIMethod({4,"ffffff"}, curItemTb.aortext_lv)
        end

    end
    --curItemTb.aortext_lv.text = "<color=#515268>" .. "VIP " .. index .. "</color>"
    self.cur_level = index
    self.selectVipId = index
    --刷新
    self:UpdateView()
end

