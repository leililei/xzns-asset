    if awardState ~= 2 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_buyGift, cfg.price > 0)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_free, cfg.price <= 0)

