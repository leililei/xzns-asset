---按钮点击事件在这里派发
function VIPPrivilegeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_help then
        self:OnClickHelp()
    elseif go == self.go_table.aorbtn_up_quick then
        self:OnClickUpQuick()
    elseif go == self.go_table.aorbtn_get then
        self:OnClickGet()
    elseif go == self.go_table.aorbtn_free then
        self:OnClickGet()
    elseif go == self.go_table.aorbtn_mllb then
        local isExit = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeGiftView.Name)
        if isExit then
            return
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeGiftView.Name)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeView.Name)
        end
    elseif go == self.go_table.aorbtn_getLoginVipExp then
        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(273) then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetLoginVipExpView.Name,
                _G.handler(self, self.UpdateViewOneData)
            )
        end
    elseif go == self.go_table.aorbtn_vipdraw then
        ---尊享抽奖
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPDrawMainView.Name)
    end
end

function VIPPrivilegeView:CheckGiftView()
    local isUpLevel = require "VIPPrivilegeModel":GetInstance().isUpLevel
    local lastUpLevel = _G.PlayerPrefsManager.GetInt("LastUpVipLevel", 1)
    if isUpLevel or self.cur_level > lastUpLevel then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.VIPPrivilegeUpLevelView.Name)
        require "VIPPrivilegeModel":GetInstance():ChangeCurLevel(require "VIPPrivilegeModel":GetInstance().uplevel)
    end
    local isOpen = require "VIPPrivilegeModel":GetInstance():CheckGiftOpen()
    local level = require "VIPPrivilegeModel":GetInstance().currentVipLevel
    if isOpen or 9 <= level then
        self.go_table.aorbtn_mllb:SetActiveE(1)
        self.go_table.aorbtn_zhml:SetActiveE(1)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_MailViewChild, self.go_table.obj_Effect)
        --刷新密令特权红点
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.VipGift.id)
    end
end

