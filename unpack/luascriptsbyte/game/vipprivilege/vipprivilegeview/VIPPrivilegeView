        if data[i] then
            if tb.obj_Root:GetChildCountE() > 0 then
                _G.DestroyObject(tb.obj_Root:GetChildE(0))
            end
            tb.gameObject:SetActiveE(1)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data[i],
                tb.obj_Root,
                function(item)
                    if _G.IsNil(tb.obj_Root) then
                        return
                    end
                    if not self.item_lua_buy[index] then
