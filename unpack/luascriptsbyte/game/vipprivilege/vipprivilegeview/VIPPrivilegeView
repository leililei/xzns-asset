        if data[i] then
            tb.obj_Root:RemoveAllChildren()
            tb.gameObject:SetActiveE(1)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data[i],
                tb.obj_Root,
                function(item)
                    if _G.IsNil(tb.obj_Root) then
                        return
                    end
                    if not self.item_lua_buy then
                        self.item_lua_buy = {}
                    end
                    self.item_lua_buy[i] = item
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    local vipinfo = require "VIPPrivilegeModel":GetInstance().all_player_vip[self.cur_level]
                    local flag = vipinfo:GetAwardState_Buy() == 2
                    item:ShowEffectOrder(not flag)
                end
            )
        else
            tb.gameObject:SetActiveE(0)
        end
    end
end

function VIPPrivilegeView:RefreshList_Buy_Item(data, parentTb, index)
    for i = 1, 3 do
