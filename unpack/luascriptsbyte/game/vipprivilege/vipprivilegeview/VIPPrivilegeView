---设置进度
function VIPPrivilegeView:SetJindu()
    local model = require "VIPPrivilegeModel":GetInstance()
    local level = model.currentVipLevel
    local nextlevel = level + 1
    if level >= self.vipMaxLevel then
        nextlevel = self.vipMaxLevel
        self.go_table.aorimage_bar:SetRectTransformSize(348, 13)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_maxvipdraw,
            require("VIPPrivilegeModel"):GetInstance().IsMaxExp)
        return
    end
    local curcfg = _G.ConfigManager.player_vip_cfg[level]
    local nextcfg = _G.ConfigManager.player_vip_cfg[nextlevel]
    local value
    self.curExp = model.total_exp
    local cur_exp = model.total_exp - curcfg.exp
    local max_exp = nextcfg.exp - curcfg.exp
    if cur_exp <= 0 then
        cur_exp = 0
    end
    local w = cur_exp / max_exp
    if w >= 1 then
        w = 1
        value = w * 348
    else
        value = w * 348
    end
    self.go_table.aorimage_bar:SetRectTransformSize(value > 0 and value or 0, 13)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_maxvipdraw, require("VIPPrivilegeModel"):GetInstance().IsMaxExp)
end

---设置描述
function VIPPrivilegeView:SetDesc()
    local model = require "VIPPrivilegeModel":GetInstance()
    local palyer_vipinfo = model.all_player_vip[model.currentVipLevel]
    if palyer_vipinfo.player_vip_cfg.name then
    else
        self.go_table.aortext_title.text = _G.LangUtil.TryGetLangValue(palyer_vipinfo.player_vip_cfg.name)
    end
    if model.currentVipLevel < self.vipMaxLevel then
        local exp = 0
        local up = _G.ConfigManager.player_vip_cfg[model.currentVipLevel + 1]
        exp = up.exp - model.total_exp
        -- ZHJH-4722 【VIP特权】低概率经验进度满了未升级，显示负数
        -- 手动刷新
        if exp < 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError("VIP等级刷新出错")
            end
            model:NotificationExp(0)
            self:SetDesc()
            return
        end
        self.go_table.aortext_desc.text = GetLangPackValue(90029300047, exp, model.currentVipLevel + 1)
        local cur_exp = model.total_exp - palyer_vipinfo.max_exp
        if cur_exp <= 0 then
            cur_exp = 0
        end
        self.go_table.aortext_jindu.text = cur_exp .. "/" .. (up.exp - palyer_vipinfo.max_exp)
        self.go_table.obj_slider:SetActiveE(1)
        self.go_table.obj_maxvipdraw:SetActiveE(0)

        if not _G.AppSetting.IsXzns then
            self.go_table.obj_vipbg:SetAnchorPosition(-395, -370, 0)
            self.go_table.obj_maxvipdraw:SetAnchorPosition(-274, -228, 0)
        end

        local showvipdraw = _G.ConfigManager.discrete_cfg[133001][1]
        local isOk = _G.GlobalConditionManager.CheckCondition(showvipdraw[1], showvipdraw[2])
        if isOk then
            self.go_table.obj_maxvipdraw:SetActiveE(1)
            self.go_table.obj_maxvipdraw:SetAnchorPosition(-216, -263, 0)
            self.go_table.aortext_maxleveltips:SetActiveE(0)
        end
    else
        self.go_table.aortext_desc.text = GetLangPackValue(90000010281, model.currentVipLevel)
        self.go_table.aortext_jindu.text = GetLangPackValue(90000010282)
        self.go_table.obj_slider:SetActiveE(0)
        self.go_table.obj_maxvipdraw:SetActiveE(1)
        self.go_table.aortext_maxleveltips:SetActiveE(1)

        if not _G.AppSetting.IsXzns then
            self.go_table.obj_vipbg:SetAnchorPosition(-290, -220, 0)
            self.go_table.obj_maxvipdraw:SetAnchorPosition(-169, -228, 0)
	    
            self.go_table.obj_vipbg:SetAnchorPosition(-290, -220, 0)
            self.go_table.obj_maxvipdraw:SetAnchorPosition(-169, -228, 0)
        end
    end
end

