                _G.ConfigManager.redpoint_cfg.VipPage.id,
                self.cur_level
            )
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_buyGift, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_free, false)
    end
    if cfg.price > 0 then
