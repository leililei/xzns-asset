local base = require("BaseGameNet")

---@class VIPPrivilegeNet : BaseGameNet	vip 通信协议类
local VIPPrivilegeNet = _G.BaseClass("VIPPrivilegeNet", base)
---@return VIPPrivilegeNet VIPPrivilegeNet
function VIPPrivilegeNet:GetInstance()
    return base.GetInstance(self)
end

---vip 信息
---@param callback function 完成回调
---@field s2c_vip_info vip.s2c_vip_info  获取vip 的信息
function VIPPrivilegeNet:AccessVipInfo(callback)
    local item = _G.ConfigManager.net_map.game_vip_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end
---领取免费的礼包
function VIPPrivilegeNet:FreeAwardVIp(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_vip_award
    local port = base.Access(self, item, pbdata, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---购买尊享礼包
---@param pbdata vip.c2s_vip_buy_award  id == 特权vip id
function VIPPrivilegeNet:BuyVipGiftBag(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_vip_buy_award
    local port = base.Access(self, item, pbdata, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---领取特权礼包
---@param pbdata vip.c2s_vip_privilege_award  p_id == 26-》周礼包 27 -》月礼包
function VIPPrivilegeNet:BuyVipPrivilegeGiftBag(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_vip_privilege_award
    local port = base.Access(self, item, pbdata, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

function VIPPrivilegeNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.vip_add_exp.Cmd, self.RecCallBack)
end
function VIPPrivilegeNet:RecCallBack(data)
    -- require "VIPPrivilegeModel":GetInstance():NotificationExp(data.add_exp)
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function VIPPrivilegeNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return VIPPrivilegeNet
