local base = require "BaseGameNet"
---@class SeasonWarPrintedNet : BaseGameNet	通信协议
local SeasonWarPrintedNet = _G.BaseClass("SeasonWarPrintedNet", base)

---@return SeasonWarPrintedNet SeasonWarPrintedNet
function SeasonWarPrintedNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求数据
---@param pbData table PB数据
---@param callback function 完成回调
function SeasonWarPrintedNet:GetInfo(callback)
    self:DealAccess(self:GetEmptyPB(), _G.ConfigManager.net_map.game_season_totem_info, callback)
end

---领取奖励
---@param pbData table
---@param  callback function 回调
function SeasonWarPrintedNet:GetAward(pbData, callback)
    self:DealAccess(pbData, _G.ConfigManager.net_map.game_season_totem_skill, callback)
end
---处理请求
---@param pbData table PB数据
---@param item net_map 协议配置
---@param callback function 回调
function SeasonWarPrintedNet:DealAccess(pbData, item, callback)
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SeasonWarPrintedNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type SeasonWarPrintedNet
_G.SeasonWarPrintedNet = SeasonWarPrintedNet
return SeasonWarPrintedNet
