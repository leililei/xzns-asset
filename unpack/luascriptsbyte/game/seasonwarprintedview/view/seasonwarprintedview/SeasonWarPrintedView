---@class SeasonWarPrintedView : UIBaseView    中文描述
---@field public go_table SeasonWarPrintedView_GoTable GoTable
local SeasonWarPrintedView = _G.BaseClass("SeasonWarPrintedView", _G.UIBaseView)
local SeasonWarPrintedManager = require "SeasonWarPrintedManager"
function SeasonWarPrintedView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local chooseBtnColor = {
    [0] = require("CardInfoManager").GetColorFromRGB("828ABC"),
    [1] = require("CardInfoManager").GetColorFromRGB("D0D8FF"),
    [2] = require("CardInfoManager").GetColorFromRGB("686989")
}
local GetLangPackValue = _G.GetLangPackValue
---界面的入口函数
function SeasonWarPrintedView:OnCreate(id)
    self.Eff = 0

    ---可选列表
    self.DisIDList = {}
    --_G.ConfigManager.discrete_cfg[112501][1]

    for key, value in pairs(_G.ConfigManager.discrete_cfg[107501][1]) do
        if require "SeasonModel":GetInstance():CheckFunctionIsOpen(value) then
            _G.table.insert(self.DisIDList, value)
        end
    end
    self.DisID = self.DisIDList[1]

    if id then
        for key, value in pairs(self.DisIDList) do
            if value == id then
                self.DisID = id
            end
        end
    end
    ---已选id
    if id then
        for key, value in pairs(self.DisIDList) do
            if value == id then
                self.DisID = id
            end
        end
    end
    ---设置默认选中按钮
    self.DisBtn = false
    self.ShengCheng = true
    self.JingDu = true
    ---当前赛季可选择的技能列表
    self.SetId = require "SeasonModel":GetInstance():GetCfg().war_totem
    ---当前显示界面，0为主界面，1为大技能详情显示，2为小技能显示列表
    self.XianShiID = 0
    ---当前选中的Id
    self.IdXuanZo = 0
    self.ExtendText = {}
    self.Max = _G.GetAutoGoTable(self.go_table.obj_XiangQingXQ, _G.handlerbind(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_TianFuMian:InitItemData(
        _G.table.count(self.SetId),
        _G.handler(self, self.TainFuMian)
    )
    self.go_table.obj_XiangQingXQ:SetActiveE(0)
    self.go_table.scrollloopvectical_XuanZeJiNeng:SetActiveE(0)
    self:DisBtnNew()
    local tab = _G.PlayerPrefsManager.GetTable("DoubleResourceslist", true) or {}
    if tab[self.DisID] ~= nil then
        tab[self.DisID] = {}
    end
    _G.PlayerPrefsManager.SetTable("DoubleResourceslist", tab, true)
end
---主界面刷新item
function SeasonWarPrintedView:TainFuMian(index, obj)
    index = index + 1

    local id = self.SetId[index]
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.dataXianSi, id, index))

    local data = _G.ConfigManager.season_totem_cfg[id]
    local JiNeng, ids = SeasonWarPrintedManager:GetInstance():IDZi(self.DisID, id)
    obj:SetName(index)
    if self.XianShiID == 0 then
        self.go_table.obj_effdixian:SetActiveE(0)
        local dataIcn = _G.ConfigManager.mementos_cfg[ids]

        item.obj_XiangQing:SetActiveE(1)
        local str = data.name
        local desc = data.desc

        if JiNeng then
            str = dataIcn.name
            desc = dataIcn.desc
            item.aortext_MiaoShu.color = chooseBtnColor[0]
            item.aortext_TypeID:SetActiveE(0)
        else
            item.aortext_MiaoShu.color = chooseBtnColor[2]
            local num =
                _G.ConfigManager.season_totem_cfg[id].unlock[2] -
                require "SeasonWarPrintedManager":GetInstance().finish_num
            --item.aortext_TypeID.text = GetLangPackValue(90022500122, num)
            item.aortext_TypeID:SetActiveE(1)
        end
        item.aortext_Name.text = GetLangPackValue(str)
        item.aortext_Type.text = GetLangPackValue(data.typename)
        item.aortext_MiaoShu:SetActiveE(0)
        item.obj_Root:SetActiveE(0)
        if index == 1 or index == _G.table.count(self.SetId) then
            item.obj_Root:SetActiveE(1)

            if not self.ExtendText[id] then
                self.ExtendText[id] = item.obj_MiaoShu:GetComponentE(_G.typeof(_G.CS.ExtendText))
                self.ExtendText[id].OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick, item, data))
            end
            local CurCardItem = require("ItemCardAllView").New(item.trans_Root)
            CurCardItem:Show(data.card, nil, _G.ConfigManager.card_cfg[data.card].Star)
            CurCardItem:HideOrShowStar(false)
            -- local str = GetLangPackValue(desc)

            if JiNeng then
                self.ExtendText[id].color = chooseBtnColor[0]
            else
                self.ExtendText[id].color = chooseBtnColor[2]
            end
            self.ExtendText[id].text = GetLangPackValue(desc)
        else
            item.aortext_MiaoShu:SetActiveE(1)

            item.aortext_MiaoShu.text = _G.ConfigManager.language_package_cfg[desc]
        end
    else
        self.go_table.obj_effdixian:SetActiveE(1)
        item.obj_XiangQing:SetActiveE(0)
    end

    item.obj_XuanZhong:SetActiveE(0)
    item.obj_XuanZhongXiao:SetActiveE(0)
    if index == 1 or index == _G.table.count(self.SetId) then
        item.obj_XuanZhong:SetActiveE(1)
        item.obj_eff:SetActiveE(1)

        if index == _G.table.count(self.SetId) then
            item.obj_eff:SetActiveE(0)
        end
        item.aorrawimage_DaTu:LoadImage(
            data.icon[2],
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
        --item.obj_da:SetActiveE(self.Eff)

        item.aorrawimage_Icon:LoadImage(
            data.icon[1],
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
        item.aorimage_GuangQuan:SetActiveE(0)
        item.aorbtn_Mask:SetActiveE(0)
        item.aorbtn_Max:SetActiveE(0)
        if self.IdXuanZo == id then
            item.aorimage_GuangQuan:SetActiveE(1)
        end
        if JiNeng and SeasonWarPrintedManager:GetInstance().finish_num >= data.unlock[2] then
            item.aorbtn_Max:SetActiveE(1)
        else
            item.aorbtn_Mask:SetActiveE(1)
        end
    else
        item.obj_effxiao:SetActiveE(1)
        item.obj_effShang:SetActiveE(0)
        if index == _G.table.count(self.SetId) - 1 then
            item.obj_effxiao:SetActiveE(0)
            item.obj_effShang:SetActiveE(1)
        end
        item.obj_XuanZhongXiao:SetActiveE(1)

        item.aorrawimage_XuanZhongX:LoadImage(
            data.icon[2],
            function(image)
                if image then
                    --image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
        local icon = data.icon[1]
        if JiNeng then
            item.aorrawimage_XuanZhongX:SetActiveE(1)
            item.aorimage_itemJia:SetActiveE(0)

            local dataIcn = _G.ConfigManager.mementos_cfg[ids]
            icon = dataIcn.icon
        else
            item.aorimage_itemJia:SetActiveE(1)
            item.aorrawimage_XuanZhongX:SetActiveE(0)
        end
        if not JiNeng and SeasonWarPrintedManager:GetInstance().finish_num >= data.unlock[2] then
            item.aorimage_redpointTip:SetActiveE(1)
        else
            item.aorimage_redpointTip:SetActiveE(0)
        end
        item.aorrawimage_Iconx:LoadImage(
            icon,
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                end
            end
        )
        item.aorimage_GuangQuanx:SetActiveE(0)
        item.aorbtn_MaskX:SetActiveE(0)
        item.aorbtn_Xiao:SetActiveE(0)
        if SeasonWarPrintedManager:GetInstance().finish_num >= data.unlock[2] then
            if self.IdXuanZo == id then
                item.aorimage_GuangQuanx:SetActiveE(1)
            end
            item.aorbtn_Xiao:SetActiveE(1)
            item.aortext_TypeID:SetActiveE(0)
        else
            item.aorbtn_MaskX:SetActiveE(1)
            item.aortext_TypeID:SetActiveE(1)
        end
    end
    item.obj_Mask:SetActiveE(0)
    item.obj_Mask:SetActiveE(require "SeasonWarPrintedManager":GetInstance():GetRedPoint(self.DisID, id))
    item.obj_xiao:SetActiveE(0)

    if self.effindex and self.effindex == index and self.Eff == 1 then
        item.obj_xiao:SetActiveE(1)
    end
    return item
end

---多语言id点击
function SeasonWarPrintedView:OnHrefClick(go, ta, asa)
    require("CommonTipManager"):GetInstance():OpenSkillTip(tonumber(go))
end

---主页面显示
function SeasonWarPrintedView:dataXianSi(go, _, id, index)
    local name = go:GetName()
    if index ~= nil then
        self.effindex = index
        self.Eff = 0
    else
        self.Eff = 1
    end
    if name == "@_aorbtn_Mask" or name == "@_aorbtn_MaskX" then
        local num =
            _G.ConfigManager.season_totem_cfg[id].unlock[2] - require "SeasonWarPrintedManager":GetInstance().finish_num
        _G.PopWindowManager:GetInstance():ShowAllTips(800201, nil, nil, nil, nil, nil, num)
        return
    end
    self.go_table.obj_XiangQingXQ:SetActiveE(0)
    self.go_table.scrollloopvectical_XuanZeJiNeng:SetActiveE(0)

    if name == "@_aorbtn_Max" then
        if self.IdXuanZo == id and self.XianShiID ~= 0 then
            self.XianShiID = 0
            self.IdXuanZo = 0
        else
            self.go_table.obj_XiangQingXQ:SetActiveE(1)

            self.XianShiID = 1
            self.IdXuanZo = id
            self:MaxLitt()
        end
    elseif name == "@_aorbtn_Xiao" then
        if self.IdXuanZo == id and self.XianShiID ~= 0 then
            self.XianShiID = 0
            self.IdXuanZo = 0
        else
            self.go_table.scrollloopvectical_XuanZeJiNeng:SetActiveE(1)

            self.XianShiID = 2
            self.IdXuanZo = id
            local data = _G.ConfigManager.season_totem_cfg[self.IdXuanZo]
            if self.JingDu then
                self.JingDu = false
                self.go_table.scrollloopvectical_XuanZeJiNeng:InitItemData(
                    _G.table.count(data.skill_effect),
                    _G.handler(self, self.XuanZeJiNeng)
                )
            else
                self.go_table.scrollloopvectical_XuanZeJiNeng:UpdateCount(_G.table.count(data.skill_effect))
            end
        end

    -- body
    end
    -- local i = 0
    -- for key, value in pairs(self.SetId) do
    --     if value == self.IdXuanZo then
    --         i = key - 1
    --     end
    -- end
    -- if i < 0 then
    --     i = 0
    -- end
    self.go_table.scrollloopvectical_TianFuMian:UpdateAllItem()
    -- self.go_table.scrollloopvectical_TianFuMian:ScrollToIndex(i)
end

---进度展示
function SeasonWarPrintedView:MaxLitt()
    local data = _G.ConfigManager.season_totem_cfg[self.IdXuanZo]
    local JiNeng, ids = SeasonWarPrintedManager:GetInstance():IDZi(self.DisID, self.IdXuanZo)
    local dataIcn = _G.ConfigManager.mementos_cfg[ids]
    self.Max.aortext_Name.text = _G.ConfigManager.language_package_cfg[dataIcn.name]
    self.Max.aortext_Type.text = _G.ConfigManager.language_package_cfg[data.typename]
    -- self.Max.aortext_MiaoShu.text = _G.ConfigManager.language_package_cfg[dataIcn.desc]

    if not self.ExtendText[0101] then
        self.ExtendText[0101] = self.Max.obj_MiaoShu:GetComponentE(_G.typeof(_G.CS.ExtendText))
        self.ExtendText[0101].OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick, self.Max, data))
    end
    local CurCardItem = require("ItemCardAllView").New(self.Max.trans_Root)
    CurCardItem:Show(data.card, nil, _G.ConfigManager.card_cfg[data.card].Star)
    CurCardItem:HideOrShowStar(false)

    if JiNeng then
        self.ExtendText[0101].color = chooseBtnColor[0]
    else
        self.ExtendText[0101].color = chooseBtnColor[2]
    end
    self.ExtendText[0101].text = GetLangPackValue(dataIcn.desc)
    self.Max.aortext_MiaoShuXQ.text = _G.ConfigManager.language_package_cfg[data.story]
    self.Max.aorrawimage_XuanZhong:LoadImage(
        data.icon[2],
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    self.Max.aorrawimage_DaTu:LoadImage(
        data.icon[1],
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
end

--刷新技能选择界面
function SeasonWarPrintedView:XuanZeJiNeng(index, obj)
    index = index + 1

    local id = _G.ConfigManager.season_totem_cfg[self.IdXuanZo].skill_effect[index]
    local data = _G.ConfigManager.mementos_cfg[id]
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.DisBtnNews, id))
    item.aortext_Name.text = _G.ConfigManager.language_package_cfg[data.name]
    item.aortext_MiaoShu.text = _G.ConfigManager.language_package_cfg[data.desc]
    item.aorrawimage_XuanZhongX:LoadImage(
        _G.ConfigManager.season_totem_cfg[self.IdXuanZo].icon[2],
        function(image)
            if image then
                --image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    item.aorrawimage_Icon:LoadImage(
        data.icon,
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )

    local Btn, eff = SeasonWarPrintedManager:GetInstance():JiNengBool(self.DisID, self.IdXuanZo, id)
    item.aorimage_Btn:SetActiveE(0)
    item.aorbtn_DianJi:SetActiveE(0)
    item.obj_Eff:SetActiveE(0)
    if Btn and eff then
        item.aorbtn_DianJi:SetActiveE(1)
    elseif eff then
        item.aorimage_Btn:SetActiveE(1)
    else
        item.obj_Eff:SetActiveE(1)
    end

    return item
end

---刷新按钮的显示状态
function SeasonWarPrintedView:DisBtnNews(go, _, id)
    local name = go:GetName()
    if name == "@_aorbtn_DianJi" then
        local PBs = {}
        PBs.skills = {{sys_id = self.DisID, id = self.IdXuanZo, skill_id = id}}
        require("SeasonWarPrintedManager"):GetInstance():TotemSkill(
            PBs,
            function(msg)
                self.XianShiID = 0
                self.IdXuanZo = 0
                self:dataXianSi(go)
                if require("SeasonWarPrintedManager"):GetInstance():HongDian() then
                    self.go_table.aorimage_redpointTip:SetActiveE(1)
                else
                    self.go_table.aorimage_redpointTip:SetActiveE(0)
                end
                -- self.go_table.scrollloopvectical_TianFuMian:UpdateCount(_G.table.count(self.SetId))
            end
        )
    elseif name == "@_aorbtn_DianJiS" then
        _G.PopWindowManager:GetInstance():ShowAllTips(800301)
    elseif name == "@_aorbtn_DianJiMain" then
        self.XianShiID = 0
        self.IdXuanZo = 0
        self:dataXianSi(go)
    end
end

---刷新按钮的显示状态
function SeasonWarPrintedView:DisBtnNew(go, _, id)
    if id ~= nil then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(id) then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(id)
            return
        end
        local tab = _G.PlayerPrefsManager.GetTable("DoubleResourceslist", true) or {}
        if tab[id] ~= nil then
            tab[id] = {}
        end
        _G.PlayerPrefsManager.SetTable("DoubleResourceslist", tab, true)
        self.DisBtn = false
        if self.DisID ~= id then
            local str = _G.ConfigManager.language_package_cfg[_G.ConfigManager.function_open_cfg[id].name]
            _G.PopWindowManager:GetInstance():ShowAllTips(800401, nil, nil, nil, nil, nil, str)
        end
        self.DisID = id
        self.XianShiID = 0
        self.IdXuanZo = 0
        --self.IdXuanZo = 0
        self:dataXianSi(go)
    -- self.go_table.scrollloopvectical_TianFuMian:UpdateCount(_G.table.count(self.SetId))
    end
    self.go_table.aortext_TipName.text =
        _G.ConfigManager.language_package_cfg[_G.ConfigManager.function_open_cfg[self.DisID].name]

    local i, o = 1, 0

    if self.DisBtn then
        i = -1
        o = 1
    end
    self.go_table.aorimage_JianTou:SetLocalScale(1, i, 1)
    self.effindex = nil
    self.Eff = 0
    if require("SeasonWarPrintedManager"):GetInstance():HongDian(self.DisID) then
        self.go_table.aorimage_redpointTip:SetActiveE(1)
    else
        self.go_table.aorimage_redpointTip:SetActiveE(0)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WarPrinted.id)
    self.go_table.obj_List:SetActiveE(o)
    if o == 1 then
        if self.ShengCheng then
            self.ShengCheng = false
            self.go_table.scrollloopvectical_List:InitItemData(
                _G.table.count(self.DisIDList),
                _G.handler(self, self.TipList)
            )
        else
            self.go_table.scrollloopvectical_List:UpdateCount(_G.table.count(self.DisIDList))
        end
    end
end

function SeasonWarPrintedView:TipList(index, obj)
    index = index + 1

    local id = self.DisIDList[index]
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.DisBtnNew, id))
    local i = 0
    if id == self.DisID then
        i = 1
    end
    item.aortext_Name.color = chooseBtnColor[i]
    item.aorimage_XuanZhong:SetActiveE(i)
    item.aortext_Name.text = _G.ConfigManager.language_package_cfg[_G.ConfigManager.function_open_cfg[id].name]

    if require("SeasonWarPrintedManager"):GetInstance():HongDianDanGe(id) then
        item.aorimage_redpoint:SetActiveE(1)
    else
        item.aorimage_redpoint:SetActiveE(0)
    end
    return item
end

---按钮点击事件在这里派发
function SeasonWarPrintedView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_ListTip then
        self.DisBtn = not self.DisBtn
        self:DisBtnNew()
    elseif go == self.go_table.toggle_main then
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 59)
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.Max.aorbtn_WiDeng then
        self.XianShiID = 0
        self.IdXuanZo = 0
        self:dataXianSi(go)
    end
end

return SeasonWarPrintedView
