local base = require "SeasonBaseModel"
local SeasonWarPrintedManager = _G.BaseClass("SeasonWarPrintedManager", base)
local SeasonWarPrintedNet = require "SeasonWarPrintedNet"

---创建对象时,入口构造函数
function SeasonWarPrintedManager:__init()
    self.curFunctionOpenID = 125
    self.redPointId = 30590215
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.HongDian, self)
end
---@return SeasonWarPrintedManager SeasonWarPrintedManager
function SeasonWarPrintedManager:GetInstance()
    return self.super.GetInstance(self)
end

function SeasonWarPrintedManager:OnSettlement()
