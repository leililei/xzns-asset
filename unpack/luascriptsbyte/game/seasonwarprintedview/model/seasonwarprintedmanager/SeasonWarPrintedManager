    _G.PlayerPrefsManager.SetTable("DoubleResourceslistJieSuo", {}, true)
    _G.PlayerPrefsManager.SetTable("DoubleResourceslist", {}, true)
end

function SeasonWarPrintedManager:GetDataFormServer()
    self.HongDianList = {}
    SeasonWarPrintedNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetPrinted))
end
---红点显示（全部已解锁
function SeasonWarPrintedManager:HongDian(ids)
    -- local SeasonWarPrinted = _G.PlayerPrefsManager.GetInt("SeasonWarPrinted")
    -- if
    --     SeasonWarPrinted == nil or SeasonWarPrinted == 0 or
    --         not _G.TimeUtil.CheckTheSameDay(_G.TimeUtil.GetServerUnixTime(), SeasonWarPrinted)
    --  then
    --     return true
    -- end
    -- return false
    if self.id_list == nil then
        return
    end
    local DisIDList = _G.ConfigManager.discrete_cfg[107501][1]
    self.SetId = require "SeasonModel":GetInstance():GetCfg().war_totem

    if ids ~= nil then
        local i = true
        for key, value in pairs(DisIDList) do
            if ids == value then
                i = false
            end
        end
        if i then
            return
        end

        for key, value in pairs(self.SetId) do
            local JiNeng, ids = self:IDZi(ids, value)
            local data = _G.ConfigManager.season_totem_cfg[value]
            if not JiNeng and self.finish_num >= data.unlock[2] and self.finish_num > 0 then
                return true
            end
        end
    else
    end

    local id = _G.PlayerPrefsManager.GetInt("DoubleResourceslistID")
    if id == 0 and require "SeasonModel":GetInstance():GetCurSeasonId() ~= nil then
        _G.PlayerPrefsManager.SetInt("DoubleResourceslistID", require "SeasonModel":GetInstance():GetCurSeasonId())
    end
    if id ~= require "SeasonModel":GetInstance():GetCurSeasonId() then
        _G.PlayerPrefsManager.SetInt("DoubleResourceslistID", require "SeasonModel":GetInstance():GetCurSeasonId())
        _G.PlayerPrefsManager.SetTable("DoubleResourceslistJieSuo", {}, true)
        _G.PlayerPrefsManager.SetTable("DoubleResourceslist", {}, true)
    end
    local HongDianList = _G.PlayerPrefsManager.GetTable("DoubleResourceslist", true) or {}
    for _, value in pairs(DisIDList) do
        if
            _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(value) and
                require "SeasonModel":GetInstance():CheckFunctionIsOpen(value)
         then
            if HongDianList[value] ~= nil and _G.table.count(HongDianList[value]) > 0 then
                return true
            end
            for k, v in pairs(self.SetId) do
                local JiNeng, ids = self:IDZi(value, v)
                local data = _G.ConfigManager.season_totem_cfg[v]
                if not JiNeng and self.finish_num >= data.unlock[2] and self.finish_num > 0 then
                    return true
                end
            end
        end
    end
    return false
end
---红点显示（根据传输id
function SeasonWarPrintedManager:HongDianDanGe(id)
    local HongDianList = _G.PlayerPrefsManager.GetTable("DoubleResourceslist", true) or {}

    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(id) then
        if HongDianList[id] ~= nil and _G.table.count(HongDianList[id]) > 0 then
            return true
        end
    end

    self.SetId = require "SeasonModel":GetInstance():GetCfg().war_totem

    for key, value in pairs(self.SetId) do
        local JiNeng, ids = self:IDZi(id, value)
        local data = _G.ConfigManager.season_totem_cfg[value]
        if not JiNeng and self.finish_num >= data.unlock[2] then
            return true
        end
    end
    return false
end

function SeasonWarPrintedManager:GetPrinted(mag)
    if mag.ack == 1 then
        self.finish_num = mag.info.finish_num
        self.id_list = mag.info.sys_info
    end
    base.ParseData(self)
end

---判断当前id是否需要展示解锁动画
function SeasonWarPrintedManager:GetRedPoint(id, index)
    local HongDianList = _G.PlayerPrefsManager.GetTable("DoubleResourceslistJieSuo", true) or {}
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(id) then
        if HongDianList[id] ~= nil and _G.table.count(HongDianList[id]) > 0 then
            for i = 1, _G.table.count(HongDianList[id]) do
                if HongDianList[id][i].id == index then
                    _G.table.remove(HongDianList[id], i)
                    _G.PlayerPrefsManager.SetTable("DoubleResourceslistJieSuo", HongDianList, true)
                    return 1
                end
            end
        end
    end
    return 0
end

function SeasonWarPrintedManager:TipIDSet(id)
    local num = _G.table.count(id)
    self.finish_num = self.finish_num + num

    local DisIDList = _G.ConfigManager.discrete_cfg[107501][1]
    local SetId = require "SeasonModel":GetInstance():GetCfg().war_totem
    local season_totem_cfg = _G.ConfigManager.season_totem_cfg
    local PB = {}
    for key, value in pairs(DisIDList) do
        for k, v in pairs(SetId) do
            if k == 1 or k >= _G.table.count(SetId) then
                -- body

                local data = season_totem_cfg[v]
                if data.unlock[2] <= self.finish_num then
                    local x, z = self:IDZi(value, v)
                    if not x then
                        local p1 = 1

                        for r, s in pairs(data.skill_effect) do
                            local q, w = self:JiNengBool(value, v, s)
                            local j = true

                            if q then
                                for _, p in pairs(PB) do
                                    if p.skill_id == s and p.sys_id == value then
                                        j = false
                                    end
                                end
                            end
                            if p1 == 1 and j then
                                p1 = r
                            end
                        end

                        if self.HongDianList[value] then
                        else
                            self.HongDianList[value] = {}
                        end
                        _G.table.insert(
                            self.HongDianList[value],
                            {sys_id = value, id = v, skill_id = data.skill_effect[p1]}
                        )
                        _G.PlayerPrefsManager.SetTable("DoubleResourceslistJieSuo", self.HongDianList, true)
                        _G.PlayerPrefsManager.SetTable("DoubleResourceslist", self.HongDianList, true)

                        _G.table.insert(PB, {sys_id = value, id = v, skill_id = data.skill_effect[p1]})
                    end
                end
            end
        end
    end
    if _G.table.count(PB) > 0 then
        local PBs = {}
        PBs.skills = PB
        self:TotemSkill(PBs)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WarPrinted.id)
end

---@field sysId 功能id
---@field id 战印id
---@field skillId 技能id
function SeasonWarPrintedManager:TotemSkill(PB, call)
    SeasonWarPrintedNet:GetInstance():GetAward(
        PB,
        function(msg)
            if msg.ack == 1 then
                self:SkkillGai(PB)
                if call ~= nil then
                    call()
                end
                require("RedPointManager"):GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.WarPrinted.id
                )
            end
        end
    )
end

function SeasonWarPrintedManager:SkkillGai(PB)
    for _, v in pairs(PB.skills) do
        local data = {}

        for key, value in pairs(self.id_list) do
            if value.sys_id == v.sys_id then
                data = value.id_list
            end
        end
        local sk = true
        for key, value in pairs(data) do
            if value.id == v.id then
                sk = false
                value.skill_id = v.skill_id
            end
        end
        if sk then
            for key, value in pairs(self.id_list) do
                if value.sys_id == v.sys_id then
                    _G.table.insert(value.id_list, {id = v.id, skill_id = v.skill_id})
                end
            end
        end
    end
end

---根据类型和id判断是否已有位置
function SeasonWarPrintedManager:IDZi(id, SliId)
    local data = {}
    for key, value in pairs(self.id_list) do
        if value.sys_id == id then
            data = value.id_list
        end
    end

    for key, value in pairs(data) do
        if value.id == SliId then
            return true, value.skill_id
        end
    end
    return false
end

---根据类型和id判断是否选中
function SeasonWarPrintedManager:JiNengBool(id, SliId, MenentId)
    local data = {}
    for key, value in pairs(self.id_list) do
        if value.sys_id == id then
            data = value.id_list
        end
    end
    for key, value in pairs(data) do
        if value.id == SliId then
            if value.skill_id == MenentId then
                return false, false
            end
        elseif value.skill_id == MenentId then
            return false, true
        end
    end
    return true, true
end

