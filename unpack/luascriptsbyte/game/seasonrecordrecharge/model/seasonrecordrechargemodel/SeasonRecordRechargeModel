local base = require("SeasonBaseModel")
local SeasonModel = require("SeasonModel")
local SeasonRecordRechargeNet = require("SeasonRecordRechargeNet")

---@class SeasonRecordRechargeModel : SeasonBaseModel
---@field GetInstance fun():SeasonRecordRechargeModel
---@field curFunctionOpenID number 功能ID
---@field redPointId number 红点ID
local SeasonRecordRechargeModel = _G.BaseClass("SeasonRecordRechargeModel", base)

local season_recharge_cfg = _G.ConfigManager.season_recharge_cfg
SeasonRecordRechargeModel.AwardState = {
    CanReceive = 1, --可领取
    CanNotReceive = 2, --不可领取
    HasReceived = 3 --已领取
}

---@return SeasonRecordRechargeModel
function SeasonRecordRechargeModel:GetInstance()
    return self.super.GetInstance(self)
end

function SeasonRecordRechargeModel:__init()
    self.curFunctionOpenID = _G.FunctionID.SeasonRecordRecharge
    self.redPointId = _G.ConfigManager.redpoint_cfg.SeasonRecordRecharge.id
    self.receivedList = {}
    --当前赛季累充金额
    self.recordNum = 0
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SeasonRecordRechargeModel:GetDataFormServer()
    SeasonRecordRechargeNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg season_privilege.s2c_season_privilege_info
function SeasonRecordRechargeModel:ParseData(msg)
    local info = msg.info
    if info then
        self.recordNum = info.recharge_num --当前赛季累充金额
        if info.award_list then
            for _, v in pairs(info.award_list) do
                self.receivedList[v] = true
            end
        end
    end
    base.ParseData(self)
end

---领取奖励
---@param id number 奖励id（season_recharge_cfg的key)
function SeasonRecordRechargeModel:ReceiveAward(id, callback)
    local pbData = {award_id = id}
    SeasonRecordRechargeNet:GetInstance():ReceiveAward(
        pbData,
        function(msg)
            if msg.ack == 1 then
                self.receivedList[id] = true
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SeasonRecordRecharge.id)
                if callback then
                    callback()
                end
            end
        end
    )
end

function SeasonRecordRechargeModel:OnMallCashListener(msg)
    self.recordNum = self.recordNum + msg.cash_rmb
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SeasonRecordRecharge.id)
end

function SeasonRecordRechargeModel:GetRechargeList()
    return SeasonModel:GetInstance():GetCfg().season_recharge[1]
end

---获取奖励状态
function SeasonRecordRechargeModel:GetAwardState(id)
    if self.receivedList[id] then
        return self.AwardState.HasReceived
    elseif self.recordNum >= season_recharge_cfg[id].conditions then
        return self.AwardState.CanReceive
    else
        return self.AwardState.CanNotReceive
    end
end

---获取累充数量
function SeasonRecordRechargeModel:GetRecordNum()
    return self.recordNum
end

---赛季开始
function SeasonRecordRechargeModel:OnSeasonStart()
end

---进入结算期（关闭界面）
function SeasonRecordRechargeModel:OnSettlement()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonRecordRechargeView.Name)
end

---赛季结束
function SeasonRecordRechargeModel:OnSeasonEnd()
end

---检查红点
function SeasonRecordRechargeModel:CheckRedPoint()
    if SeasonModel:GetInstance():GetSeasonTimeLeft() <= 0 then
        return false
    end
    local seasonID = _G.PlayerPrefsManager.GetInt("SeasonRecordRecharge")
    if seasonID == nil or seasonID ~= SeasonModel:GetInstance():GetCurSeasonId() then
        return true
    end
    local rechargeLis = self:GetRechargeList()

    --local backRed = require("SuperValuGiftModel"):GetInstance():CheckRedPoint()
    --if backRed then
    --    return backRed
    --end

    for _, v in pairs(rechargeLis) do
        if self:GetAwardState(v) == self.AwardState.CanReceive then
            return true
        end
    end

    return false
end

---打开界面
function SeasonRecordRechargeModel:OpenView(hideFun, openFun, ...)
    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonRecordRechargeView.Name)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonGiftPackView.Name)
end

function SeasonRecordRechargeModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---@type SeasonRecordRechargeModel
return SeasonRecordRechargeModel
