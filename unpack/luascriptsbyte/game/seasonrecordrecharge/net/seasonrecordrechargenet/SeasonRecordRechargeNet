local BaseGameNet = require("BaseGameNet")

---@class SeasonRecordRechargeNet : BaseGameNet 描述
---@field GetInstance fun():SeasonRecordRechargeNet
local SeasonRecordRechargeNet = _G.BaseClass("SeasonRecordRechargeNet", BaseGameNet)

---请求
---@param pbData table PB数据
---@param item net_map 网络协议
---@param callback function 完成回调
function SeasonRecordRechargeNet:Access(pbData, item, callback)
    if pbData == nil then
        pbData = self:GetEmptyPB()
    end
    local port = BaseGameNet.Access(self, item, pbData, _G.handler(self, self.GetDataCall))
    self.Call[port] = callback
    return port
end
---获取赛季特权信息
---@param callback function 完成回调
function SeasonRecordRechargeNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_season_recharge_info
    self:Access(nil, item, callback)
end
---领取赛季特权奖励
---@param pbData c2s_bounty_group_put
function SeasonRecordRechargeNet:ReceiveAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_season_recharge_get
    self:Access(pbData, item, callback)
end

---后端主动推送的数据
function SeasonRecordRechargeNet:P2C_Friendinfo(data)
    require("BountyGroupModel"):GetInstance():BoxAward(data)
end
---请求回调
---@param port number 中文描述
---@param data table 返回PB数据
---@param error string 错误信息
function SeasonRecordRechargeNet:GetDataCall(port, data, error)
    if error then
        if _G.AppSetting.DEBUG then
            _G.LogError("SeasonRecordRechargeNet :" .. error)
        end
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---析构函数
function SeasonRecordRechargeNet:Dispose()
end

---@return SeasonRecordRechargeNet
return SeasonRecordRechargeNet
