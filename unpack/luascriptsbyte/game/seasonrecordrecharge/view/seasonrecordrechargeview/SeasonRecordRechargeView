local SeasonModel = require("SeasonModel")
local SeasonRecordRechargeModel = require("SeasonRecordRechargeModel")
local BaseAwardNewItem = require("BaseAwardNewItem")

---@class SeasonRecordRechargeView : UIBaseView	中文描述
---@field public go_table SeasonRecordRechargeView_GoTable GoTable
local SeasonRecordRechargeView = _G.BaseClass("SeasonRecordRechargeView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local GetAutoGoTable = _G.GetAutoGoTable
local table = _G.table
local tonumber = _G.tonumber
local season_recharge_cfg = _G.ConfigManager.season_recharge_cfg
local AwardState = SeasonRecordRechargeModel.AwardState

function SeasonRecordRechargeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SeasonRecordRechargeView:OnCreate()
    self.rechargeLis = _G.DeepCopy(SeasonRecordRechargeModel:GetInstance():GetRechargeList())
    self:UpdateList()
    self:InitView()

    _G.PlayerPrefsManager.SetInt("SeasonRecordRecharge", require("SeasonModel"):GetInstance():GetCurSeasonId())
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstRitual.id)
end

function SeasonRecordRechargeView:UpdateList()
    _G.SortList(
        self.rechargeLis,
        function(id)
            local state = SeasonRecordRechargeModel:GetInstance():GetAwardState(id)
            local con = season_recharge_cfg[id].conditions
            return -state, -con
        end
    )
end

function SeasonRecordRechargeView:InitView()
    self.go_table.aortext_totalNum.text =
        GetLangPackValue(90025500073, _G.GameUtil.RatioControl(SeasonRecordRechargeModel:GetInstance():GetRecordNum()))
    self.countDown = SeasonModel:GetInstance():GetSeasonSettlementTimeLeft()
    self.go_table.aortext_countDown.text =
        GetLangPackValue(90025500075) .. _G.TimeUtil.TranslateSecondForDHMOrHMS(self.countDown)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    local cfg = SeasonModel:GetInstance():GetCfg()
    local spine = cfg.spine_1
    local loadedCall = function(tran)
        if self:IsNil() then
            _G.DestroyObject(tran)
            return
        end
        tran:SetLocalPosition(tonumber(spine[2][1]), tonumber(spine[2][2]), tonumber(spine[2][3]))
        tran:SetLocalScaleXYZ(tonumber(spine[2][4]))
    end
    if not table.isEmptyOrNil(spine) then
        self.go_table.aorrawimage_role:SetActiveE(0)
        if _G.string.find(spine[1][1], "/") then
            _G.UIUtils.LoadEffectByPath(spine[1][1], self.go_table.obj_role, loadedCall)
        else
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_spine_effect_cfg[spine[1][1]],
                self.go_table.obj_role,
                loadedCall
            )
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ShopViewBg_loop,
        self.go_table.obj_backEff,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_hunjiangyinghuochong,
        self.go_table.obj_backEff,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
        end
    )
    self.go_table.scrollloopvectical_gift:InitItemData(#self.rechargeLis, _G.handler(self, self.RefreshList))
end

function SeasonRecordRechargeView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    self.countDown = _G.Mathf.RoundToInt(self.countDown - elapsed)
    if self.countDown < 0 then
        return
    end
    self.go_table.aortext_countDown.text =
        GetLangPackValue(90025500075) .. _G.TimeUtil.TranslateSecondForDHMOrHMS(self.countDown)
end

function SeasonRecordRechargeView:RefreshList(index, obj)
    index = index + 1
    local id = self.rechargeLis[index]
    ---@type SeasonRecordRechargeView._obj_item_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, id))
    ---@type season_recharge_cfg
    local cfg = season_recharge_cfg[id]
    tb.goods = cfg.goods
    local state = SeasonRecordRechargeModel:GetInstance():GetAwardState(id)
    tb.state = state
    tb.aorbtn_get:SetActiveE(state ~= AwardState.HasReceived and 1 or 0)
    tb.aorbtn_get:SetGray(state ~= AwardState.CanReceive)
    tb.obj_redpoint:SetActiveE(state == AwardState.CanReceive and 1 or 0)
    tb.aorimage_redpoint:SetActiveE(state == AwardState.CanReceive and 1 or 0)
    tb.aorimage_isGet:SetActiveE(state == AwardState.HasReceived and 1 or 0)
    local curPrice = _G.GameUtil.RatioControl(cfg.conditions)
    tb.aortext_num.text = curPrice
    if _G.AppSetting.IsOverseas then
        tb.aortext_unit.text = GetLangPackValue(20307012601)
    else
        tb.aortext_unit.text = GetLangPackValue(90000010355)
    end
    if tb.init then
        tb.scrollloophorizontal_award:UpdateCount(#cfg.goods)
    else
        tb.scrollloophorizontal_award:InitItemData(#cfg.goods, _G.handlerbind(self, self.RefreshAwardList, tb))
        tb.init = true
    end
    _G.GameUtil.ReBuildRTF(tb.obj_aimText)
end

function SeasonRecordRechargeView:RefreshAwardList(index, obj, parent)
    index = index + 1
    ---@type _obj_item._obj_awardItem_GoTable
    local tb = GetAutoGoTable(obj)
    if not tb.item then
        tb.item = BaseAwardNewItem.New(tb.obj_item, _G.handlerbind(self, self.ShowTips, tb), 88, tb.obj_item)
    end
    tb.item:ShowWithID(parent.goods[index], nil, _G.handlerbind(self, self.itemCall, tb, parent))
end

function SeasonRecordRechargeView:ShowTips(itemlua, btnObj, isOn, itemGoTable)
    if itemlua.type ~= _G.StorageType.Card then
        require("CommonTipManager"):GetInstance():OpenPropTip(itemlua.gameObject, itemlua.data.sid)
    end
end

---@param itemLua BaseAwardNewItem 奖励脚本
---@param tb _obj_item._obj_awardItem_GoTable
function SeasonRecordRechargeView:itemCall(itemLua, tb, parent)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end
    tb.obj_gou:SetActiveE(parent.state == AwardState.HasReceived and 1 or 0)
    local isShowEffect = parent.state ~= AwardState.HasReceived
    if itemLua.type ~= _G.StorageType.Card then
        itemLua:ShowEffect(false)
        if isShowEffect then
            lua:ShowEffect()
        else
            lua:ShowOrHideEffect(false)
        end
    else
        itemLua:ShowEffect(isShowEffect)
    end
end

function SeasonRecordRechargeView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function SeasonRecordRechargeView:OnClickItem(go, isOn, id)
    local state = SeasonRecordRechargeModel:GetInstance():GetAwardState(id)
    if state ~= AwardState.CanReceive then
        return
    end
    SeasonRecordRechargeModel:GetInstance():ReceiveAward(
        id,
        function()
            self:UpdateList()
            self.go_table.scrollloopvectical_gift:UpdateAllItem()
        end
    )
end

---按钮点击事件在这里派发
function SeasonRecordRechargeView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    elseif name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 103)
    end
end

return SeasonRecordRechargeView
