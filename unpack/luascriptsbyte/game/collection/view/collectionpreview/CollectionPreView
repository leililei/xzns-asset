local CollectionModel
---@class CollectionPreView : UIBaseView	藏品
---@field public go_table CollectionView_GoTable GoTable
local CollectionPreView = _G.BaseClass("CollectionPreView", _G.UIBaseView)
local collection_lv = _G.ConfigManager.collection_level_cfg
local GetLangPackValue = _G.LangUtil.GetLangPackValue
function CollectionPreView:Awake()
    CollectionModel = require "CollectionModel":GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --当前藏品等级属性列表
    self.CurAttributeTb = {}
    --下一藏品等级属性列表
    self.NextAttributeTb = {}
    --当前属性的条数
    self.CurAttributeLen = 0
    --当前收藏等级
    self.CurLv = 0
    --当前收藏进度总值
    self.CurValue = 0
    --当前等级总进度
    self.CurAllValue = 1
    --是否满级，true未满级，false满级
    self.IsMax = true
end

---界面入口
function CollectionPreView:OnCreate(attribute1, attribute2)
    self.CurAttributeTb = attribute1
    self.NextAttributeTb = attribute2
    self:InitCollectionAttribute()
    self:InitView()
end

---类的析构函数
function CollectionPreView:OnDispose()
end

---初始化藏品等级属性界面数据
function CollectionPreView:InitCollectionAttribute()
    self.CurLv = CollectionModel:GetCurLv()
    self.CurValue = CollectionModel:GetCurValue()
    self.CurAllValue = CollectionModel:GetCurAllValue()
    if self.CurLv == 0 then
        self.CurAttributeLen = #collection_lv[self.CurLv + 1].att
    else
        self.CurAttributeLen = #collection_lv[self.CurLv].att
    end
    if collection_lv[self.CurLv + 1] == nil then
        self.IsMax = false
    end
end

---初始化界面
function CollectionPreView:InitView()
    self:InitProgress()
    self.go_table.scrollloopvectical_itemattribute:InitItemData(
        self.CurAttributeLen,
        _G.handler(self, self.RefreshAttribute)
    )
end

---藏品等级界面进度条显示更新
function CollectionPreView:InitProgress()
    self.go_table.slider_progress.value = self.CurValue / self.CurAllValue
    local slider_progress = _G.GetAutoGoTable(self.go_table.slider_progress, _G.handler(self))
    slider_progress.aortext_Slider.text = self.CurValue .. "/" .. self.CurAllValue
    self.go_table.aortext_lv.text = GetLangPackValue(90028700008, self.CurLv)
end

---属性显示
---@param index number 下标
---@param obj obj item
function CollectionPreView:RefreshAttribute(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local loopitemTb = _G.GetAutoGoTable(obj, _G.handler(self))
    --是否满级
    _G.GameUtil.SetActiveByCondition(loopitemTb.aorimage_jiantou, self.IsMax)
    if _G.table.isEmptyOrNil(self.CurAttributeTb) then
        --0级
        loopitemTb.aortext_afterNum.text = "+" .. self.NextAttributeTb[x][3]
        loopitemTb.aortext_addNum.text = 0
        loopitemTb.aortext_name.text = _G.AttrType[self.NextAttributeTb[x][1]].des
    elseif _G.table.isEmptyOrNil(self.NextAttributeTb) then
        --满级
        loopitemTb.aortext_afterNum.text = 0
        loopitemTb.aortext_addNum.text = "+" .. self.CurAttributeTb[x][3]
        loopitemTb.aortext_name.text = _G.AttrType[self.CurAttributeTb[x][1]].des
    else
        loopitemTb.aortext_afterNum.text = "+" .. self.NextAttributeTb[x][3]
        loopitemTb.aortext_addNum.text = "+" .. self.CurAttributeTb[x][3]
        loopitemTb.aortext_name.text = _G.AttrType[self.CurAttributeTb[x][1]].des
    end
end
---按钮点击事件在这里派发
function CollectionPreView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
end

return CollectionPreView
