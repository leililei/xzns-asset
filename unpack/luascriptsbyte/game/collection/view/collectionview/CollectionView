function CollectionView:Awake()
    CollectionModel = require "CollectionModel":GetInstance()
    PrivilegeManager = require "PrivilegeManager":GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---已获得的藏品列表
    self.GetList = {}
    ---任务列表
    self.MissionDatas = {}
    ---所有藏品列表
    ---@type CollectionData[][]
    self.AllCollection = {}
    ---藏品table表
    self.itemsList = {}
    ---星列表
    self.Stars = {}
    ---当前品质需要显示的排数
    self.CurLen = 0
    ---当前收藏等级
    self.CurLv = 0
    ---当前收藏进度总值
    self.CurValue = 0
    ---当前等级总进度
    self.CurAllValue = 1
    ---当前页签标记
    self.CurPage = 1
    ---当前藏品是否可激活/升星
    self.AtActive = false
    self.selectId = 1
    --右上角货币显示
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        self.resource =
            self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, _G.ConfigManager.ui_cfg.CollectionView.resources)
        )
    end
    ---toggles
    self.ToggleIndex = 1
    self.ShowCollection = {}
    self.needRedPointData = {}
end

---界面入口
---@param id number 藏品id
function CollectionView:OnCreate(id)
    self.DefaultId = _G.tonumber(id)
    self.Instruction = _G.GetAutoGoTable(self.go_table.obj_instruction, _G.handlerbind(self, self.ClosePage))
    self.Detail = _G.GetAutoGoTable(self.go_table.obj_detail, _G.handlerbind(self, self.ClosePage))
    self.JumpWay = _G.GetAutoGoTable(self.go_table.obj_jumpWay, _G.handlerbind(self, self.JumpWayClick))
    self.needRedPointData = _G.PlayerPrefsManager.GetTable("CollectionRedPoint", false) or {}
    self:InitCollectionData()
    self:InitView()
    self:CreateEffect()
    self:RefreshToggleRedPoint()
    self.Detail.scrollloopvectical_effect:InitItemData(0, _G.handler(self, self.RefreshDetail))
    self.go_table.obj_detail:SetActiveE(0)
    self.go_table.aorimage_jiantou:SetActiveE(1)
end

---类的析构函数
function CollectionView:OnDispose()
end

---创建特效
function CollectionView:CreateEffect()
    UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ColletcionView_xinkong, self.go_table.obj_Bg)
    UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ColletcionView_bg, self.go_table.obj_Bg)
    local info = _G.GetAutoGoTable(self.go_table.obj_info)
    UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CollectionView_IconBack, info.obj_bg)
end

---初始化藏品界面数据
function CollectionView:InitCollectionData()
    self.AllCollection = {}
    local tb = CollectionModel:GetAllCollections()
    for _, value in pairs(tb) do
        if not self.AllCollection[value.cfg.type1] then
            self.AllCollection[value.cfg.type1] = {}
        end
        _G.table.insert(self.AllCollection[value.cfg.type1], value)
        if self.DefaultId and self.DefaultId == value.cfg.id then
            self.ToggleIndex = value.cfg.type1
            self.selectId = #self.AllCollection[value.cfg.type1]
        end
    end
    self.CurLen = _G.math.ceil(#self.AllCollection[self.ToggleIndex] / 4)
    if self.DefaultId then
        self.go_table["toggle_type" .. self.ToggleIndex].isOn = true
        self.DefaultId = nil
    end
end

---初始化界面
function CollectionView:InitView()
    --self:InitProgress()
    self.go_table.scrollloopvectical_collection:InitItemData(self.CurLen, _G.handler(self, self.RefreshCollection))
    self.go_table.scrollloopvectical_collection:DetectingSlippage(_G.handler(self, self.onValueChanged))
    self:InitInfoView(self.selectId)
end

