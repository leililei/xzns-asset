end

---藏品item生成
---@param index number 下标
---@param obj obj item
function CollectionView:RefreshCollection(index, obj)
    if index < 0 then
        return
    end
    local x = (index + 1) * 4
    local loopitemTb = _G.GetAutoGoTable(obj, _G.handler(self))
    local name = "obj_loopItem"
    for i = 1, 4 do
        local item = loopitemTb[name .. i]
        local curIndex = x + i - 4
        local itemTb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.ClickBtn, curIndex))
        self.itemsList[curIndex] = itemTb
        if self.AllCollection[self.ToggleIndex][curIndex] ~= nil then
            itemTb.gameObject:SetActiveE(1)
            itemTb.obj_redpoint:SetActiveE(0)
            self:UpdateIconView(itemTb, curIndex, self.AllCollection[self.ToggleIndex][curIndex].level)
        else
            itemTb.gameObject:SetActiveE(0)
        end
    end
end

---滑动条显示
function CollectionView:onValueChanged(y)
    if self.CurLen > 3 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_jiantou, y < 400)
    else
        self.go_table.aorimage_jiantou:SetActiveE(0)
    end
end

---左边界面显示
---@param curIndex number 藏品位置下标
---@param itemTb obj 当前的实例对象
---@param curLevel number 当前藏品等级
function CollectionView:UpdateIconView(itemTb, curIndex, curLevel)
    local data = self.AllCollection[self.ToggleIndex][curIndex]
    local chip_name = data.cfg.name
    local iconImage = data.cfg.icon

    itemTb.obj_select:SetActiveE(0)
    if curIndex == self.selectId then
        itemTb.obj_select:SetActiveE(1)
        if not itemTb.isEffect then
            UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_Collection_selected,
                itemTb.obj_select,
                function(trans)
                    trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                end
            )
            itemTb.isEffect = true
        end
    end

    itemTb.aorrawimage_activate:LoadImage(
        iconImage,
        function(tran)
            tran:SetNativeSize()
        end
    )

    itemTb.aorrawimage_mask:LoadImage(
        iconImage,
        function(tran)
            tran:SetNativeSize()
            tran.Alpha = 0.5
        end
    )
    itemTb.aortext_name.text = GetLangPackValue(chip_name)
    local currency
    local canActive = false
    if curLevel == 0 then --未激活
        itemTb.aorbtn_activate:SetActiveE(0)
        itemTb.aorrawimage_mask:SetActiveE(1)
        itemTb.aortext_name.color = _G.ColorTools.FormatColorByString("ffae45")
        currency = data.cfg.unlock_params
        canActive = _G.StorageManager:GetInstance():CheckItem(currency[1], currency[2])
        itemTb.aortext_level.text = _G.GetLangPackValue(canActive and 90024900044 or 90000011070)
        itemTb.aortext_level.color = _G.ColorTools.FormatColorByString(canActive and "95e7ff" or "6e6e6e")
    else
        itemTb.aorbtn_activate:SetActiveE(0)
        itemTb.aorrawimage_mask:SetActiveE(0)
        itemTb.aortext_name.color = _G.ColorTools.FormatColorByString("ffae45")
        itemTb.aortext_level.color = _G.ColorTools.FormatColorByString("D0D8FF")
        local maxLevel = data.maxLevel
        if maxLevel <= curLevel then
            itemTb.aortext_level.text = _G.GetLangPackValue(90000011071)
        else
            itemTb.aortext_level.text = _G.GetLangPackValue(90000011072, curLevel, maxLevel)
        end
    end

    --红点(我也不知道之前的人为什么不走红点树)
    if canActive then
        itemTb.obj_redpoint:SetActiveE(1)
    elseif data.level < data.maxLevel and _G.table.ContainsValue(self.needRedPointData, data.cfg.id) then
        currency = data.level == 0 and data.cfg.unlock_params or data.cfg.currency[data.level]
        itemTb.obj_redpoint:SetActiveE(_G.StorageManager:GetInstance():CheckItem(currency[1], currency[2]) and 1 or 0)
    else
        itemTb.obj_redpoint:SetActiveE(0)
    end
end

---藏品信息介绍界面更新
---@param curIndex number 当前的藏品位置下标
function CollectionView:InitInfoView(curIndex)
    self.curIndex = curIndex
    local data = self.AllCollection[self.ToggleIndex][curIndex]
    local cid = data.cfg.id
    local info_item = self.go_table.obj_info
    local info_tb = _G.GetAutoGoTable(info_item, _G.handlerbind(self, self.ClickBtnInfo, cid, curIndex))

    --图像
    local iconImage = data.cfg.icon
    local iconPosition = data.cfg.offset
    info_tb.aorrawimage_itemIcon:LoadImage(
        iconImage,
        function(tran)
            tran:SetNativeSize()
        end
    )
    info_tb.aorrawimage_itemIcon:SetLocalPosition(iconPosition[1], iconPosition[2], 0)

    --等级
    info_tb.aortext_level.text =
        data.level == 0 and _G.GetLangPackValue(90000011070) or
        _G.GetLangPackValue(90000011072, data.level, data.maxLevel)

    --消耗
    --判断是否激活
    local chip_id = 0
    local chip_need = 0
    if data.level == 0 then --未激活
        chip_id = data.cfg.unlock_params[1]
        chip_need = data.cfg.unlock_params[2]
    else --升级
        if data.level < data.maxLevel then
            chip_id = data.cfg.currency[data.level][1]
            chip_need = data.cfg.currency[data.level][2]
        end
    end
    info_tb.obj_res1:SetActiveE(data.level < data.maxLevel and 1 or 0)
    if data.level < data.maxLevel then
        info_tb.aortext_resHave1.text = _G.GameUtil.NumberToUnitStr(chip_need)
        info_tb.aorrawimage_resIcon1:LoadImage(_G.StorageManager:GetItemIcon(chip_id))
    end

    --按钮状态
    info_tb.aortext_jihuo.text =
        data.level == 0 and _G.GetLangPackValue(90000011073) or _G.GetLangPackValue(90000011074)
    if _G.StorageManager:GetInstance():CheckItem(chip_id, chip_need) then
        info_tb.aorbtn_jihuo:SetGray(false)
        info_tb.aortext_resHave1.color = _G.ColorTools.FormatColorByString("514842")
        info_tb.aortext_jihuo.color = _G.ColorTools.FormatColorByString("914801")
    else
        info_tb.aortext_resHave1.color = _G.ColorTools.FormatColorByString("ff5656")
        info_tb.aortext_jihuo.color = _G.ColorTools.FormatColorByString("525252")
        info_tb.aorbtn_jihuo:SetGray(true)
    end

    info_tb.aorbtn_jihuo:SetActiveE(data.level >= data.maxLevel and 0 or 1)
    info_tb.aorimage_maxLevel:SetActiveE(data.level >= data.maxLevel and 1 or 0)

    --当前属性
    local index = data.level == 0 and 1 or data.level

    info_tb.aortext_propAtk.text = _G.GetLangPackValue(90000011075, data.cfg.atk[index])
    info_tb.aortext_propBre.text = _G.GetLangPackValue(90000011076, data.cfg.bre[index])
    info_tb.aortext_propDef.text = _G.GetLangPackValue(90000011077, data.cfg.def[index])
    info_tb.aortext_propMaxHp.text = _G.GetLangPackValue(90000011078, data.cfg.max_hp[index])

    if data.cfg.type1 == 1 then
        local attr = data.cfg.att[index]
        local desc = CollectionModel:GetShowProp(attr[1], attr[2], attr[3], 90000011091)
        info_tb.aortext_effect.text = desc
    elseif data.cfg.type1 == 2 then
        local info_privilegId = data.cfg.privilege[index]
        local info_privilegDes = privilege_cfg[info_privilegId].desc1
        local info_value =
            tostring(
            privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege][
                #privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege]
            ] / 100
        )
        info_tb.aortext_effect.text = _G.GetLangPackValue(info_privilegDes, info_value)
    end

    --判断提示
    if data.level == 0 then
        self:ShowJumpWay(curIndex)
    end

    --培养提醒
    info_tb.toggle_needRedPoint:SetActiveE(data.level < data.maxLevel and 1 or 0)
    info_tb.aortext_needRedPoint:SetActiveE(data.level < data.maxLevel and 1 or 0)
    info_tb.toggle_needRedPoint.isOn = _G.table.ContainsValue(self.needRedPointData, cid)
end

---设置藏品星级、效果、激活条件
function CollectionView:SetStarAndInstruction(curIndex)
    local curMissionList = self.AllCollection[curIndex].mission
    local nums = #curMissionList
    self.curStarNo = 1
    for i = 1, 3 do
        self.Stars[i]["toggle_star" .. i]:SetActiveE(0)
        self.infoTable["aorimage_line" .. i]:SetActiveE(0)
        self.infoTable["aortext_Des" .. i]:SetActiveE(0)
    end
    if nums == 2 then
        self.infoTable.aorimage_line1:SetActiveE(1)
        if self.MissionDatas[curMissionList[1]].i_task.state == state.Completed then
            self.infoTable.aorimage_line1.SpriteName = line[2]
        else
            self.infoTable.aorimage_line1.SpriteName = line[1]
        end
    elseif nums == 3 then
        self.infoTable.aorimage_line2:SetActiveE(1)
        if self.MissionDatas[curMissionList[1]].i_task.state == state.Completed then
            self.infoTable.aorimage_line2.SpriteName = line[2]
        else
            self.infoTable.aorimage_line2.SpriteName = line[1]
        end
        self.infoTable.aorimage_line3:SetActiveE(1)
        if self.MissionDatas[curMissionList[2]].i_task.state == state.Completed then
            self.infoTable.aorimage_line3.SpriteName = line[2]
        else
            self.infoTable.aorimage_line3.SpriteName = line[1]
        end
    end
    for i = 1, nums do
        local pos = (i - 1) * 2
        self.Stars[i]["toggle_star" .. i]:SetActiveE(1)
        self.infoTable["aortext_Des" .. i]:SetActiveE(1)
        self.infoTable["aortext_Des" .. i].color = _G.ColorTools.FormatColorByString("515268")
        self.Stars[i]["toggle_star" .. i]:SetLocalPosition(startPosition[nums][1 + pos], startPosition[nums][2 * i], 0)
        self.Stars[i]["toggle_star" .. i].isOn = false
        local missionState = self.MissionDatas[curMissionList[i]].i_task.state
        local chip_id = self.AllCollection[curIndex].currency[1][1]
        local chip_need = self.AllCollection[curIndex].currency[1][2]
        local chip_own = _G.StorageManager:GetInstance():GetItemCountBySid(chip_id)
        local info_privilegId = self.AllCollection[curIndex].privilege[i]
        local info_privilegDes = privilege_cfg[info_privilegId].desc
        local info_value =
            tostring(
            privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege][
                #privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege]
            ] / 100
        )
        self.infoTable["aortext_Des" .. i].text = GetLangPackValue(info_privilegDes, info_value)
        self.Stars[i].obj_Upgradeable:SetActiveE(0)
        self.Stars[i].obj_Upgraded:SetActiveE(0)
        self.infoTable["aorimage_Star" .. i].SpriteName = newStar[2]
        if missionState == state.Completed then
            self.Stars[i].aorimage_star.SpriteName = star[3]
            self.curStarNo = i
            self.Stars[i].obj_Upgraded:SetActiveE(1)
            self.infoTable["aortext_Des" .. i].color = _G.ColorTools.FormatColorByString("C95F00")
            self.infoTable["aorimage_Star" .. i].SpriteName = newStar[1]
            if self.curStarNo + 1 <= nums then
                self.curStarNo = self.curStarNo + 1
            end
        elseif missionState == state.Submited and chip_own >= chip_need then
            self.Stars[i].aorimage_star.SpriteName = star[1]
            self.Stars[i].obj_Upgradeable:SetActiveE(1)
            if i > 1 then
                if self.MissionDatas[curMissionList[i - 1]].i_task.state == state.Completed then
                    self.curStarNo = i
                else
                    self.Stars[i].aorimage_star.SpriteName = star[2]
                    self.Stars[i].obj_Upgradeable:SetActiveE(0)
                end
            end
        else
            self.Stars[i].aorimage_star.SpriteName = star[2]
        end
    end
    self.Stars[self.curStarNo]["toggle_star" .. self.curStarNo].isOn = true
end

---藏品信息切换点击事件左边，刷新右边信息描述
---@param index number 藏品位置下标
function CollectionView:ClickBtn(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_clickinfo" then
        self.JumpWay.gameObject:SetActiveE(0)
        self.itemsList[self.selectId].obj_select:SetActiveE(0)
        self.selectId = index
        self.itemsList[index].obj_select:SetActiveE(1)
        if not self.itemsList[index].isEffect then
            UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_Collection_selected,
                self.itemsList[index].obj_select,
                function(trans)
                    trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                end
            )
            self.itemsList[index].isEffect = true
        end
        self:InitInfoView(index)
    end
end

---激活藏品点击事件
---@param cid number 藏品id
---@param curIndex number 当前的藏品位置下标
function CollectionView:ClickBtnInfo(go, isOn, cid, curIndex)
    local name = go:GetName()
    --激活
    if name == "@_aorbtn_jihuo" then
        local data = self.AllCollection[self.ToggleIndex][self.selectId]
        local isUp = data.level ~= 0

        local currency = {}
        if isUp then
            currency = data.cfg.currency[data.level]
        else
            currency = data.cfg.unlock_params
        end
        if _G.StorageManager:GetInstance():CheckItem(currency[1], currency[2]) then
            CollectionModel:ActivateCollection(
                cid,
                data.level + 1,
                function()
                    -- data.level = data.level + 1
                    _G.StorageManager:GetInstance():ConsumeItem(currency[1], 0, currency[2])
                    --self:UpdateIconView(self.itemsList[curIndex],curIndex,data.level)
                    self.go_table.scrollloopvectical_collection:UpdateAllItem()
                    if data.cfg.type1 == 1 then
                    else
                        local privilegeid = data.cfg.privilege[data.level]
                        require "PrivilegeManager":GetInstance():AddPrivilege(privilegeid, true, true)
                    end

                    self:InitInfoView(curIndex)
                    self:RefreshToggleRedPoint()

                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CollectionActivateView.Name,
                        cid,
                        data,
                        isUp
                    )
                end
            )
        else
            if isUp then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, currency[1])
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(
                    780114,
                    _G.GetLangPackValue(90000011079),
                    function()
                        _G.JumpManager:GetInstance():Jump(120001)
                    end
                )
            end
        end
    elseif name == "@_aorbtn_OverView" then
        self:ShowOverView(curIndex)
    elseif name == "@_aorbtn_tips" or name == "@_aorbtn_icon" then
        self:ShowDetailView(curIndex)
    elseif name == "$_toggle_needRedPoint" then
        local data = self.AllCollection[self.ToggleIndex][self.selectId]
        if isOn then
            if not _G.table.ContainsValue(self.needRedPointData, data.cfg.id) then
                _G.table.insert(self.needRedPointData, data.cfg.id)
            end
        else
            if _G.table.ContainsValue(self.needRedPointData, data.cfg.id) then
                _G.table.removebyvalue(self.needRedPointData, data.cfg.id)
            end
        end
        _G.PlayerPrefsManager.SetTable("CollectionRedPoint", self.needRedPointData, false)
        self:UpdateIconView(self.itemsList[curIndex], curIndex, data.level)
        CollectionModel:RefreshRedPoint()
        self:RefreshToggleRedPoint()
    end
end

---显示藏品介绍
function CollectionView:ShowOverView(curIndex)
    self.Instruction.gameObject:SetActiveE(1)
    self.Instruction.aortext_Des.text = GetLangPackValue(self.AllCollection[self.ToggleIndex][curIndex].cfg.desc)
end

---显示跳转提示
function CollectionView:ShowJumpWay(curIndex)
    self.JumpWay.gameObject:SetActiveE(1)
    local data = self.AllCollection[self.ToggleIndex][curIndex]
    if data.level == 0 then
        self.JumpWay.aortext_desc.text =
            _G.GetLangPackValue(self.AllCollection[self.ToggleIndex][self.selectId].cfg.activation)
    else
        self.JumpWay.aortext_desc.text = _G.GetLangPackValue(90028611704)
    end
    _G.DelayDo(3, _G.handlerbind(self, self.HideJumpWay, curIndex))
end

function CollectionView:HideJumpWay(curIndex)
    if self.selectId == curIndex then
        self.JumpWay.gameObject:SetActiveE(0)
    end
end

---显示藏品详情
function CollectionView:ShowDetailView(curIndex)
    self.Detail.gameObject:SetActiveE(1)
    local data = self.AllCollection[self.ToggleIndex][curIndex]
    self.DetailShowList = {}
    if data.cfg.type1 == 1 then
        local desc = ""
        for i, v in ipairs(data.cfg.att) do
            desc = _G.GetLangPackValue(90000011080, i, CollectionModel:GetShowProp(v[1], v[2], v[3], 90000011093))
            _G.table.insert(self.DetailShowList, desc)
        end
    elseif data.cfg.type1 == 2 then
        local desc = ""
        local info_privilegId = 0
        local info_privilegDes = ""
        local info_value = 0
        for i, v in ipairs(data.cfg.privilege) do
            info_privilegId = data.cfg.privilege[i]
            info_value =
                tostring(
                privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege][
                    #privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege]
                ] / 100
            )
            info_privilegDes = _G.GetLangPackValue(privilege_cfg[info_privilegId].desc, info_value)
            desc = _G.GetLangPackValue(90000011080, i, info_privilegDes)
            _G.table.insert(self.DetailShowList, desc)
        end
    end
    self.Detail.scrollloopvectical_effect:UpdateCount(#self.DetailShowList)
    self.Detail.scrollloopvectical_effect:UpdateAllItem()

    --名字
    self.Detail.aortext_name.text = GetLangPackValue(data.cfg.name)
    --等级
    self.Detail.aortext_level.text =
        data.level ~= 0 and _G.GetLangPackValue(90000011081, data.level) or _G.GetLangPackValue(90000011070)

    --icon
    local iconImage = data.cfg.icon
    self.Detail.aorrawimage_icon:LoadImage(
        iconImage,
        function(tran)
            tran:SetNativeSize()
        end
    )
end

---刷新详情item
function CollectionView:RefreshDetail(index, obj)
    local data = self.AllCollection[self.ToggleIndex][self.selectId]
    local detailItemTb = _G.GetAutoGoTable(obj, _G.handler(self))
    detailItemTb.aortext_desc.text = self.DetailShowList[index + 1]

    if data.level == index + 1 then
        detailItemTb.aortext_desc.color = _G.ColorTools.FormatColorByString("ffee9d")
    else
        detailItemTb.aortext_desc.color = _G.ColorTools.FormatColorByString("d3d7f2")
    end
end

function CollectionView:ClosePage(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self.Instruction.gameObject:SetActiveE(0)
        self.Detail.gameObject:SetActiveE(0)
    end
end

function CollectionView:JumpWayClick(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        --self.JumpWay.gameObject:SetActiveE(0)
    elseif name == "@_aorbtn_jump" then
        local data = self.AllCollection[self.ToggleIndex][self.curIndex]
        if data.level == 0 then --未激活
            _G.JumpManager:GetInstance():Jump(120001)
        else
            _G.JumpManager:GetInstance():Jump(163001)
        end
    end
end

function CollectionView:UpdataView()
end
---按钮点击事件在这里派发
function CollectionView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
    if name == "@_aorbtn_CollectionLv" then
        local attribute1, attribute2 = self:GetShowAttribute()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CollectionPreView.Name, attribute1, attribute2)
    end
    if name == "@_aorbtn_help" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 55)
    end
    if name == "$_toggle_type1" then
        self:ToggleEvent(go, isOn, 1)
    end

    if name == "$_toggle_type2" then
        self:ToggleEvent(go, isOn, 2)
    end

    if name == "@_aorbtn_Deco" then
        if self.JumpWay.gameObject:GetActiveSelf() == 0 then
            self:ShowJumpWay(self.selectId)
        else
            self.JumpWay.gameObject:SetActiveE(0)
        end
    end
end

---toggle相应事件
function CollectionView:ToggleEvent(toggle, isOn, index)
    if isOn and not self.DefaultId then
        self.ToggleIndex = index
        self.selectId = 1
        self.CurLen = _G.math.ceil(#self.AllCollection[self.ToggleIndex] / 4)
        self.go_table.scrollloopvectical_collection:UpdateCount(self.CurLen)
        self.go_table.scrollloopvectical_collection:UpdateAllItem()
        self:InitInfoView(1)
    end
    local go_table = _G.GetAutoGoTable(toggle)
    go_table.aortext_togDesc.color =
        isOn and _G.ColorTools.FormatColorByString("823A0F") or _G.ColorTools.FormatColorByString("ADA6EF")
end

function CollectionView:RefreshToggleRedPoint()
    local go_table = {}
    for i = 1, 2 do
        go_table = _G.GetAutoGoTable(self.go_table["toggle_type" .. i])
        go_table.obj_common_redpoint:SetActiveE(0)
        for _, value in ipairs(self.AllCollection[i]) do
            if value.level < value.maxLevel then
                local currency = value.level == 0 and value.cfg.unlock_params or value.cfg.currency[value.level]
                if
                    _G.table.ContainsValue(self.needRedPointData, value.cfg.id) and
                        _G.StorageManager:GetInstance():CheckItem(currency[1], currency[2])
                 then
                    go_table.obj_common_redpoint:SetActiveE(1)
                    break
                elseif value.level == 0 and _G.StorageManager:GetInstance():CheckItem(currency[1], currency[2]) then
                    go_table.obj_common_redpoint:SetActiveE(1)
                    break
                end
            end
        end
    end
end

return CollectionView
