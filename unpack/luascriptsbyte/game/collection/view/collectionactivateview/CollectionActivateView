---@class CollectionActivateView : UIBaseView	藏品
---@field public go_table CollectionView_GoTable GoTable
local CollectionActivateView = _G.BaseClass("CollectionActivateView", _G.UIBaseView)
---@type CollectionModel
local CollectionModel
local privilege_cfg = _G.ConfigManager.privilege_cfg
local tittleIcon = {
    [1] = "Images/nCollectionView/ui_hejiji_txt_jihuochenggong",
    [2] = "Images/nCardHunLianNew/ui_js_txt_shengjichenggong_02",
}

local desc = {
    [1] = 90028700016,
    [2] = 90028700012
}

function CollectionActivateView:Awake()
    CollectionModel = require "CollectionModel":GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.CollectionAnim, self.ViewAnimationFinish, self)
    
end

---初始化界面
---@param id number 藏品Id
---@param isUp boolean 是否为升级
---@param data CollectionData
function CollectionActivateView:OnCreate(id,data,isUp)
    self.data = data
    local image = _G.ConfigManager.collection_cfg[id].icon
    local name = _G.LangUtil.GetLangPackValue(_G.ConfigManager.collection_cfg[id].name)
    self.go_table.aorrawimage_itemIcon:LoadImage(
        image,
        function(tran)
            tran:SetNativeSize()
        end
    )
    if isUp then
        self.go_table.aorrawimage_tittle:LoadImage(
           tittleIcon[2],
            function(tran)
                tran:SetNativeSize()
            end
        )
    else
        self.go_table.aorrawimage_tittle:LoadImage(
            tittleIcon[1],
             function(tran)
                 tran:SetNativeSize()
             end
         )
    end
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(isUp and desc[1] or desc[2], name)
    self.go_table.obj_levelUp:SetActiveE(isUp and 1 or 0)
    self.go_table.obj_active:SetActiveE(isUp and 0 or 1)
    if isUp then
        self:RefreshLevelUp()
    else
        self:RefreshActive()
    end
    --self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.privilege_cfg[privilegeid].desc)
end

function CollectionActivateView:RefreshLevelUp()
    local oldLevel = self.data.level -1 
    local newLevel = self.data.level

    local old_table = _G.GetAutoGoTable(self.go_table.obj_oldLevel,_G.handler(self))
    local new_table = _G.GetAutoGoTable(self.go_table.obj_newLevel,_G.handler(self))
    old_table.aortext_atk.text = _G.GetLangPackValue(90000011095,self.data.cfg.atk[oldLevel])
    old_table.aortext_bre.text = _G.GetLangPackValue(90000011096,self.data.cfg.bre[oldLevel])
    old_table.aortext_def.text =_G.GetLangPackValue(90000011097,self.data.cfg.def[oldLevel])
    old_table.aortext_hp.text = _G.GetLangPackValue(90000011098,self.data.cfg.max_hp[oldLevel])

    new_table.aortext_atk.text = _G.GetLangPackValue(90000011095,self.data.cfg.atk[newLevel])
    new_table.aortext_bre.text = _G.GetLangPackValue(90000011096,self.data.cfg.bre[newLevel])
    new_table.aortext_def.text =_G.GetLangPackValue(90000011097,self.data.cfg.def[newLevel])
    new_table.aortext_hp.text = _G.GetLangPackValue(90000011098,self.data.cfg.max_hp[newLevel])

    if self.data.cfg.type1 == 1 then
        local attr = self.data.cfg.att[oldLevel]
        local desc = CollectionModel:GetShowProp(attr[1],attr[2],attr[3],90000011099)
        old_table.aortext_effect.text = desc
        
        attr =  self.data.cfg.att[newLevel]
        desc = CollectionModel:GetShowProp(attr[1],attr[2],attr[3],90000011099)
        new_table.aortext_effect.text = desc
    elseif self.data.cfg.type1 == 2 then
        local info_privilegId = self.data.cfg.privilege[oldLevel]
        local info_privilegDes =privilege_cfg[info_privilegId].desc
        local info_value = tostring(privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege][#privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege]]/100)
        old_table.aortext_effect.text = _G.GetLangPackValue(info_privilegDes,info_value)

        info_privilegId = self.data.cfg.privilege[newLevel]
        info_privilegDes =privilege_cfg[info_privilegId].desc
        info_value = tostring(privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege][#privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege]]/100)
        new_table.aortext_effect.text = _G.GetLangPackValue(info_privilegDes,info_value)
    end
    
end

function CollectionActivateView:RefreshActive()
    local newLevel = 1
    local active_table = _G.GetAutoGoTable(self.go_table.obj_active,_G.handler(self))

    active_table.aortext_atk.text = _G.GetLangPackValue(90000011095,self.data.cfg.atk[newLevel])
    active_table.aortext_bre.text = _G.GetLangPackValue(90000011096,self.data.cfg.bre[newLevel])
    active_table.aortext_def.text =_G.GetLangPackValue(90000011097,self.data.cfg.def[newLevel])
    active_table.aortext_hp.text = _G.GetLangPackValue(90000011098,self.data.cfg.max_hp[newLevel])

    if self.data.cfg.type1 == 1 then
        local attr = self.data.cfg.att[newLevel]
        local desc = CollectionModel:GetShowProp(attr[1],attr[2],attr[3],90000011099)
        active_table.aortext_effect.text = desc
    elseif self.data.cfg.type1 == 2 then
        local info_privilegId = self.data.cfg.privilege[newLevel]
        local info_privilegDes =privilege_cfg[info_privilegId].desc
        local info_value = tostring(privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege][#privilege_cfg[info_privilegId].privilege[#privilege_cfg[info_privilegId].privilege]]/100)
        active_table.aortext_effect.text = _G.GetLangPackValue(info_privilegDes,info_value)
    end
end

---按钮点击事件在这里派发
function CollectionActivateView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    if  not self.animFinish then

    end
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.CollectionAnim, self.ViewAnimationFinish, self)
        self:Close()
    end
end

---类的析构函数
function CollectionActivateView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.CollectionAnim, self.ViewAnimationFinish, self)
end

function CollectionActivateView:ViewAnimationFinish()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.CollectionAnim, self.ViewAnimationFinish, self)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CollectionActivateView_iconBG,
    self.go_table.aorrawimage_itemIcon,
    function(trans)
        if not self.go_table then
            _G.DestroyObject(trans)
        end
    end)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CollectionActivateView_title,
    self.go_table.aorrawimage_tittle,
    function(trans)
        if not self.go_table then
            _G.DestroyObject(trans)
        end
    end)
end

return CollectionActivateView
