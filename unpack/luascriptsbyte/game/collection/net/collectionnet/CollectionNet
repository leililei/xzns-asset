---@class CollectionNet : BaseGameNet
---@field GetInstance fun():CollectionNet
local CollectionNet = _G.BaseClass("CollectionNet", require "BaseGameNet")
local base = require "BaseGameNet"
---@return CollectionNet CollectionNet

function CollectionNet:GetInstance()
    return base.GetInstance(self)
end

---请求 藏品信息
---@param callback function 完成回调
---@field s2c_turntable_out_info 返回的信息数组
function CollectionNet:CollectionInfo(callback)
    local item = _G.ConfigManager.net_map.game_collection_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求 激活藏品
---@param callback function 完成回调
---@param id number 藏品id
function CollectionNet:ActivateCollection(id, level, callback)
    local pbData = {}
    pbData.unlock = {}
    pbData.unlock = {cid = id, lv = level}
    local item = _G.ConfigManager.net_map.game_collection_activation
    local port = base.Access(self, item, pbData, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CollectionNet:SuccessCall(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CollectionNet
