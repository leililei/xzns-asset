local base = require("BaseGameNet")

---@class PlayerCircleNet : BaseGameNet    通信协议
local PlayerCircleNet = _G.BaseClass("PlayerCircleNet", base)
---@return PlayerCircleNet PlayerCircleNet
function PlayerCircleNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
---@param callback function 回调
function PlayerCircleNet:GetInfo(callback, type)
    local netmap
    if type == 1 then
        netmap = _G.ConfigManager.net_map.game_gaming_circles_info
    elseif type == 2 then
        netmap = _G.ConfigManager.net_map.game_gaming_circles_tiktok_info
    elseif type == 3 then
        ---预留支付宝类型
        netmap = _G.ConfigManager.net_map.game_gaming_circles_info
    end
    self:Access(netmap, self:GetEmptyPB(), callback)
end

---设置心愿掉落
---@param callback function 回调
function PlayerCircleNet:Synchronous(pbData, callback, type)
    local netmap
    if type == 1 then
        netmap = _G.ConfigManager.net_map.game_gaming_circles_synchronous
    elseif type == 2 then
        netmap = _G.ConfigManager.net_map.game_gaming_circles_tiktok_synchronous
    elseif type == 3 then
        ---预留支付宝类型
        netmap = _G.ConfigManager.net_map.game_gaming_circles_synchronous
    end
    self:Access(netmap, pbData, callback)
end

---设置倍率
---@param callback function 回调
function PlayerCircleNet:Award(pbData, callback, type)
    local netmap
    if type == 1 then
        netmap = _G.ConfigManager.net_map.game_gaming_circles_award
    elseif type == 2 then
        netmap = _G.ConfigManager.net_map.game_gaming_circles_tiktok_award
    elseif type == 3 then
        ---预留支付宝类型
        netmap = _G.ConfigManager.net_map.game_gaming_circles_award
    end
    self:Access(netmap, pbData, callback)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function PlayerCircleNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PlayerCircleNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return PlayerCircleNet
