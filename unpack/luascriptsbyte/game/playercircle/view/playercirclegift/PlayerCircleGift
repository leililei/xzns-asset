local PlayerCircleModel = require("PlayerCircleModel")
---@class PlayerCircleGift : Component    中文描述
local PlayerCircleGift = _G.BaseClass("PlayerCircleGift", _G.Component)

---构造函数
---@protected
function PlayerCircleGift:Awake()
    self:AddListener(_G.ePlayerCircle.Refresh, self.InitView)
end

---创建对象时,入口构造函数
function PlayerCircleGift:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    local data = PlayerCircleModel:GetInstance():GetTaskCfgInfoByType(1)
    self.id = data[1].id
    self.items = {}
    self:InitView()
end

function PlayerCircleGift:InitView()
    if #self.items == 0 then
        local data = PlayerCircleModel:GetInstance():GetTaskCfgInfoByType(1)
        local array = data[1].reward
        for i, v in ipairs(array) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                self.go_table.obj_awardRoot,
                function(tran)
                    if _G.IsNil(self.gameObject) then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran.gameObject:SetLocalScaleXYZ(1)
                    local state = PlayerCircleModel:GetInstance():GetTaskAwardStateById(self.id)
                    tran:SetGou(state == 2)
                    table.insert(self.items, tran)
                end
            )
        end
    end
    self:SetAwardState()

    local txtPath = "ImagesH5/hPlayerCircle/ui_yqxsy_mengxing_txt"
    if _G.AppSetting.IsDouYin then
        txtPath = "ImagesH5/hPlayerCircle/ui_yqxsy_mengxing_txt_1"
    end
    self.go_table.aorrawimage_txt:LoadImage(txtPath, function(img)
        if self.go_table == nil then
            return
        end
        img:SetNativeSize()
    end)
end

function PlayerCircleGift:SetAwardState()
    self.state = PlayerCircleModel:GetInstance():GetTaskAwardStateById(self.id)
    self.go_table.aorimage_over:SetActiveE(0)
    self.go_table.aorbtn_get:SetActiveE(self.state ~= 2 and 1 or 0)
    self.go_table.aorbtn_get:SetGray(self.state == 0)
    if self.state == 0 then
        self.go_table.aortext_text.color = _G.ColorTools.FormatColorByString("474747")
    else
        self.go_table.aortext_text.color = _G.ColorTools.FormatColorByString("8C2D14")
    end
    if #self.items > 0 then
        for i, v in ipairs(self.items) do
            v:SetGou(self.state == 2)
        end
    end
end

---按钮点击事件在这里派发
function PlayerCircleGift:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_get then
        if self.state ~= 1 then
            require "PlayerCircleModel":GetInstance():RefreshData()
            return
        end
        PlayerCircleModel:GetInstance():GetAwardById({ self.id }, function()
            self:SetAwardState()
        end)
    end
end

---销毁对象时,析构函数
function PlayerCircleGift:OnDestroy()
    self:RemoveAllListener()
end

return PlayerCircleGift