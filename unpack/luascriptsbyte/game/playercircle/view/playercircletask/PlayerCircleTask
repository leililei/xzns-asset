local PlayerCircleModel = require("PlayerCircleModel")
---@class PlayerCircleTask : Component    中文描述
local PlayerCircleTask = _G.BaseClass("PlayerCircleTask", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---构造函数
---@protected
function PlayerCircleTask:Awake()
    self:AddListener(_G.ePlayerCircle.Refresh, self.InitView)
end

---创建对象时,入口构造函数
function PlayerCircleTask:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.CaCheLoadAwardList = {}
    self.data = PlayerCircleModel:GetInstance():GetTaskCfgInfoByType(3)
    self:InitView()
end

---按钮点击事件在这里派发
function PlayerCircleTask:OnClickBtn(go, isOn)

end

---
---@protected
function PlayerCircleTask:InitView()
    local data = PlayerCircleModel:GetInstance():GetTaskCfgInfoByType(3)
    self.task = {}
    for i, v in ipairs(data) do
        local state = PlayerCircleModel:GetInstance():GetTaskAwardStateById(v.id)
        local sortIndex = state
        if state == 2 then
            sortIndex = 3
        elseif state == 0 then
            sortIndex = 2
        end
        table.insert(self.task, { cfg = v, state = state, progress = PlayerCircleModel:GetInstance():GetTaskProgressById(v.id), sortIndex = sortIndex })
    end
    table.sort(self.task, function(a, b)
        if a.sortIndex ~= b.sortIndex then
            return a.sortIndex < b.sortIndex
        end
        return a.cfg.id < b.cfg.id
    end)
    if self.init == nil then
        self.go_table.scrollloopvectical_Group2:InitItemData(#self.task, _G.handler(self, self.RefreshList))
        self.init = true
    else
        self.go_table.scrollloopvectical_Group2:UpdateAllItem()
    end
end

function PlayerCircleTask:RefreshList(index, listView)
    if index < 0 then
        return
    end
    _G.DelayFrameDo(
        function()
            if self ~= nil then
                self:ItemsInit(index + 1, listView)
            end
        end
    )
    return listView
end

---@param  item UnityEngine.Transform
function PlayerCircleTask:ItemsInit(taskIndex, item)
    taskIndex = taskIndex
    local task = self.task[taskIndex]
    local gotable = _G.GetAutoGoTable(item)

    gotable.gameObject:SetName(task.cfg.id)
    local task1 = PlayerCircleModel:GetInstance():GetSdkInfoByType(task.cfg.condition[1][1])
    if task1 == nil then
        task1 = 0
    end
    local taskcount = task.cfg.condition[1][2]
    if task1 > taskcount then
        task1 = taskcount
    end
    local desc = ""
    if _G.AppSetting.IsDouYin then
        desc = _G.LangUtil.GetLangPackValue(task.cfg.desc_zfb)
    else
        desc = _G.LangUtil.GetLangPackValue(task.cfg.desc)
    end
    gotable.aortext_info.text = desc .. "(" .. task1 .. "/" .. taskcount .. ")"

    local state = task.state
    if state == nil then
        state = 0
    end

    gotable.aorbtn_get:SetActiveE(state ~= 2 and 1 or 0)
    gotable.aorimage_over:SetActiveE(state == 2 and 1 or 0)
    gotable.aorbtn_get:SetGray(state == 0)

    if state == 0 then
        gotable.aortext_text.color = _G.ColorTools.FormatColorByString("474747")
    else
        gotable.aortext_text.color = _G.ColorTools.FormatColorByString("8C2D14")
    end

    local btnName = gotable.aorbtn_get:GetName()
    if _G.tonumber(btnName) == nil then
        gotable.aorbtn_get.onClick:AddListener(_G.handlerbind(self, self.Btn_TaskClick, gotable, taskIndex))
    end
    gotable.aorbtn_get:SetName(_G.tostring(task.cfg.id))
    gotable.obj_items:ClearChildren()
    for key, value in pairs(task.cfg.reward) do
        self:CareatItem(value, state == 2, gotable.obj_items)
    end
    return item
end

function PlayerCircleTask:CareatItem(data, isGou, Parent, backCall)
    local Sid = data[1]
    local id = Parent:GetInstanceID()
    if self.CaCheLoadAwardList[id] then
        if self.CaCheLoadAwardList[id][Sid] then
            return
        end
    else
        self.CaCheLoadAwardList[id] = {}
    end
    self.CaCheLoadAwardList[id][Sid] = true
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                if _G.IsNil(Parent) then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                self.CaCheLoadAwardList[id][Sid] = false
                item.gameObject:SetLocalScaleXYZ(0.8)
                item.gameObject:SetActiveE(1)
                item:SetPri(data.isPri)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                if backCall then
                    backCall(item)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
        )
    end
    --end
end

function PlayerCircleTask:Btn_TaskClick(go, num)
    local name = go.aorbtn_get:GetName()
    local taskid = tonumber(name)
    if taskid == nil then
        return
    end
    if self.task[num].state ~= 1 then
        return
    end
    PlayerCircleModel:GetInstance():GetAwardById({ self.task[num].cfg.id }, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self:InitView()
    end)
end

---销毁对象时,析构函数
function PlayerCircleTask:OnDestroy()
    self:RemoveAllListener()
end

return PlayerCircleTask