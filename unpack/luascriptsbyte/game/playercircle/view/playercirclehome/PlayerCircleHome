---@class PlayerCircleHome : Component    中文描述
local PlayerCircleHome = _G.BaseClass("PlayerCircleHome", _G.Component)

---创建对象时,入口构造函数
function PlayerCircleHome:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    local array = _G.ConfigManager.discrete_cfg[124009]
    for i, v in ipairs(array) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            self.go_table.obj_awardRoot,
            function(tran)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(tran)
                    return
                end
                tran.gameObject:SetLocalScaleXYZ(1)
            end
        )
    end
    local txtPath = "ImagesH5/hPlayerCircle/ui_yxqsy_txt"
    if _G.AppSetting.IsDouYin then
        txtPath = "ImagesH5/hPlayerCircle/ui_yxqsy_txt_1"
    end
    self.go_table.aorrawimage_txt:LoadImage(txtPath, function(img)
        if self.go_table == nil then
            return
        end
        img:SetNativeSize()
    end)
end

---按钮点击事件在这里派发
function PlayerCircleHome:OnClickBtn(go, isOn)

end

---销毁对象时,析构函数
function PlayerCircleHome:OnDestroy()
end

return PlayerCircleHome