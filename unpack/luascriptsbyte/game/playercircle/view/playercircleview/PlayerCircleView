local PlayerCircleModel = require("PlayerCircleModel")
---@class PlayerCircleView : UIBaseView    中文描述
local PlayerCircleView = _G.BaseClass("PlayerCircleView", _G.UIBaseView)

local luaPage = {
    "PlayerCircleHome",
    "PlayerCircleGift",
    "PlayerCircleSign",
    "PlayerCircleTask",
}

function PlayerCircleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    if not _G.AppSetting.IsEditor then
        local x, y = self.go_table.aorbtn_go:GetRectTransformSize()
        local wx, wy, wz = self.go_table.aorbtn_go.gameObject:GetPosition()
        ---定位
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(wx, wy, wz)
        _G.SDKManager:GetInstance():ShowGameButton(
            {
                x = nx * (_G.CS.Launcher.Inst.ScreenSize.x / _G.AppSetting.SCREEN_WIDTH) - (x / 2),
                y = (_G.CS.Launcher.Inst.ScreenSize.y -
                        ny * (_G.CS.Launcher.Inst.ScreenSize.y / _G.AppSetting.SCREEN_HEIGHT)) -
                    (y / 2),
                w = x,
                h = y,
                ww = _G.CS.Launcher.Inst.ScreenSize.x,
                hh = _G.CS.Launcher.Inst.ScreenSize.y,
                dev = 0
            }
        )
    end
end

---创建对象时,入口构造函数
function PlayerCircleView:OnCreate()
    self.toggles = {}
    for i = 1, 4 do
        local toggle = _G.GetAutoGoTable(self.go_table["toggle_" .. i])
        _G.table.insert(self.toggles, toggle)
    end
    self.go_table["toggle_" .. 4]:SetActiveE(_G.AppSetting.IsDouYin and 0 or 1)
    self.index = 0
    require "PlayerCircleModel":GetInstance():ChangeHomeRed()
    self:SetToggle(1)
    if _G.AppSetting.IsDouYin then
       self.go_table.aortext_go.text = _G.GetLangPackValue(90032900027)
       self.go_table.aortext_goD.text = _G.GetLangPackValue(90032900027)
    else
        self.go_table.aortext_go.text = _G.GetLangPackValue(90032900001)
        self.go_table.aortext_goD.text = _G.GetLangPackValue(90032900001)
    end
end

---
---@protected
function PlayerCircleView:SetToggle(index)
    if self.index == index then
        return
    end
    self.index = index
    for i = 1, 4 do
        self.toggles[i].aorimage_isOff:SetActiveE(self.index ~= i and 1 or 0)
        self.toggles[i].aorimage_isOn:SetActiveE(self.index == i and 1 or 0)
    end
    self.go_table.aorimage_bg:SetActiveE(self.index ~= 4 and 1 or 0)
    self:SetPage(index)
end

---
---@protected
function PlayerCircleView:SetPage()
    for i = 1, 4 do
        self.go_table["obj_tagObj" .. i]:SetActiveE(self.index == i and 1 or 0)
    end
    if self["page" .. self.index] then
        return
    end
    self["page" .. self.index] = self:AddComponent(self.go_table["obj_tagObj" .. self.index],
        require(luaPage[self.index]).New(self.go_table["obj_tagObj" .. self.index]))
end

---按钮点击事件在这里派发
function PlayerCircleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 or go == self.go_table.aorbtn_Close then
        -- if self.go_table.obj_choose:GetActiveSelf() == 1 then
        --     --self:BackChoose()
        -- else
        --     if not self.scene then
        --         return
        --     end
        --     self:Close()
        -- end
        if not _G.AppSetting.IS_EDITOR then
            _G.SDKManager:GetInstance():HideGameButton()
        end
        self:Close()
    elseif go == self.go_table.toggle_1 then
        self:SetToggle(1)
    elseif go == self.go_table.toggle_2 then
        self:SetToggle(2)
    elseif go == self.go_table.toggle_3 then
        self:SetToggle(3)
    elseif go == self.go_table.toggle_4 then
        self:SetToggle(4)
    elseif go == self.go_table.aorbtn_goD then
        if not _G.AppSetting.IS_EDITOR then
            _G.SDKManager:GetInstance():OpenGameClub(
                { openGameStation = true },
                function(b, info)
                    PlayerCircleModel:GetInstance().info = { like_num = 2, comment_num = 0 }
                    PlayerCircleModel:GetInstance():GetData()
                end)
        else
            PlayerCircleModel:GetInstance().info = { like_num = 2, comment_num = 0 }
            PlayerCircleModel:GetInstance():GetData()
        end
    end
end

---销毁对象时,析构函数
function PlayerCircleView:OnDestroy()
end

return PlayerCircleView
