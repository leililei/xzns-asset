local PlayerCircleModel = require("PlayerCircleModel")
---@class PlayerCircleSign : Component    中文描述
local PlayerCircleSign = _G.BaseClass("PlayerCircleSign", _G.Component)

local CS = _G.CS
local typeof = _G.typeof
---构造函数
---@protected
function PlayerCircleSign:Awake()
    self:AddListener(_G.ePlayerCircle.Refresh, self.InitView)
end

---创建对象时,入口构造函数
function PlayerCircleSign:OnCreate(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:InitView()
end

function PlayerCircleSign:InitView()
    self.data = PlayerCircleModel:GetInstance():GetTaskCfgInfoByType(2)
    _G.table.sort(self.data, function(a, b)
        return a.condition[2][2] < b.condition[2][2]
    end)
    if self.ItemList == nil then
        self.ItemList = {}
        for i = 1, 7 do
            self.ItemList[i] = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
            for j = 1, #self.data[i].reward do
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    self.data[i].reward[j],
                    self.ItemList[i].obj_Root,
                    function(item)
                        if _G.IsNil(self.ItemList[i].obj_Root) then
                            _G.DestroyImmediate(item.gameObject)
                            return
                        end
                        item.gameObject:SetLocalScaleXYZ(0.8)
                        item.gameObject:SetActiveE(1)
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        if item.SetGradeNew then
                            item:SetGradeNew(false)
                        end
                        local state = PlayerCircleModel:GetInstance():GetTaskAwardStateById(self.data[i].id)
                        item:SetGou(state == 2)
                        self.ItemList[i].item = item
                    end,
                    function(go, isOn)
                        require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, self.data[i].reward[j][1])
                    end
                )
            end
            self.ItemList[i].aortext_day.text = _G.GetLangPackValue(90023800006, _G.GameUtil.NumberToChinese(i))
        end
    end
    self:SetStateView()
    self.go_table.aortext_des.text = _G.GetLangPackValue(90032900008, PlayerCircleModel:GetInstance():GetTaskProgressById(2))

    local times = _G.ConfigManager.player_circle_mission_cfg[self.data[1].id].condition[1][2]
    if _G.AppSetting.IsDouYin then
        self.go_table.aortext_des2.text = _G.GetLangPackValue(90032900029, times)
    else
        self.go_table.aortext_des2.text = _G.GetLangPackValue(90032900007, times)
    end
end

function PlayerCircleSign:SetStateView()
    local allAwardNum = 0
    local allGetNum = 0
    self.Award = {}
    for i = 1, 7 do
        local goTable = self.ItemList[i]
        local state = PlayerCircleModel:GetInstance():GetTaskAwardStateById(self.data[i].id)
        goTable.aorimage_choose:SetActiveE(state == 1 and 1 or 0)
        if state == 1 then
            allAwardNum = allAwardNum + 1
            table.insert(self.Award, self.data[i].id)
        elseif state == 2 then
            allGetNum = allGetNum + 1
        end
        if self.ItemList[i].item then
            self.ItemList[i].item:SetGou(state == 2)
        end
    end
    self.go_table.aorimage_over:SetActiveE(allGetNum == 7 and 1 or 0)
    self.go_table.aorbtn_get:SetActiveE(allGetNum < 7 and 1 or 0)
    self.go_table.aorbtn_get:SetGray(allAwardNum == 0)
    if allAwardNum == 0 then
        self.go_table.aortext_text.color = _G.ColorTools.FormatColorByString("474747")
    else
        self.go_table.aortext_text.color = _G.ColorTools.FormatColorByString("8C2D14")
    end
end

---按钮点击事件在这里派发
function PlayerCircleSign:OnClickBtn(go, isOn)
    if #self.Award == 0 then
        return
    end
    PlayerCircleModel:GetInstance():GetAwardById(self.Award, function(msg)
        if msg.ack ~= 1 then
            return
        end
        self:SetStateView()
    end)
end

---销毁对象时,析构函数
function PlayerCircleSign:OnDestroy()
    self:RemoveAllListener()
end

return PlayerCircleSign