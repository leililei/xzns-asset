local JointActivityDrawUpModel = require("JointActivityDrawUpModel")
local ChieftainTreasuryView = require("ChieftainTreasuryView")

---@class  TreasureBlissView:ChieftainTreasuryView
---@field go_table TreasureBlissView_GoTable
---@field activityCls JointActivityDrawUpMainGmModel
local TreasureBlissView = BaseClass("TreasureBlissView", ChieftainTreasuryView)

function TreasureBlissView:RefreshBtnRedPoint()
    local mainType = self.activity.cfg.info.front.main_type
    local activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.activity:GetJumpType(self.activityID), mainType)
    if activity then
        self.go_table.obj_redpointask:UpdateRedPointItemIDAndParam(
            activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_task:SetActiveE(activity and 1 or 0)
    else
        self.go_table.aorbtn_task:SetActiveE(0)
    end

    local activity1 = require "ActivitySynManager":GetInstance():GetChildAcitivity(10088, self.activity:GetJumpType(self.activityID), mainType)
    if activity1 then
        self.go_table.obj_redpointbaodian:UpdateRedPointItemIDAndParam(
            activity1:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_baodian:SetActiveE(1)
    else
        self.go_table.aorbtn_baodian:SetActiveE(0)
    end
end

function TreasureBlissView:OnClickBtn(go)
    if go == self.go_table.aorbtn_baodian then
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        local mainType = self.activity.cfg.info.front.main_type
        _G.GlobalInterface.JumpActivityByGM(10088, self.activity:GetJumpType(self.ActivityID), false, mainType)
    else
        ChieftainTreasuryView.OnClickBtn(self, go)
        if go == self.go_table.aorbtn_preview then
            --打开预览界面
            ---@type TreasureBlissPreView
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TreasureBlissPreView.Name, self.activityCls.activity.cfg.self_info.limited_draw.cfg.pool_sid)
        end
    end
end

return TreasureBlissView