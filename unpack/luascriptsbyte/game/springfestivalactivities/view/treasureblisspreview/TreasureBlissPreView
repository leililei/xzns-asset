local PetProbabilityView = require("PetProbabilityView")

---@class TreasureBlissPreView:PetProbabilityView
---@field private go_table TreasureBlissPreView_GoTable GoTable
local TreasureBlissPreView = BaseClass("TreasureBlissPreView",PetProbabilityView)
local limited_roller_cfg = ConfigManager.limited_roller_cfg

function TreasureBlissPreView:OnCreate(poolID)
    ---@type PetProbabilityView._obj_spiritualItem_GoTable[]
    self.itemList = {}
    self.init = true
    self.probList = {}
    self:CalRollerProb(poolID)
    self.go_table.scrollloopvectical_artifact:InitItemData(#self.probList, _G.handler(self, self.RefreshList))
end

---概率计算
function TreasureBlissPreView:CalRollerProb(poolID)
    local sum = 0
    local storageType, storageID, artFlag, order
    local Spiritual = _G.StorageID.Spiritual
    local StorageManager = _G.StorageManager:GetInstance()
    ---@type limited_roller_cfg
    local cfg = limited_roller_cfg[poolID]
    if not cfg then
        return
    end
    local poolProDic = {}
    for _, poolArgs in pairs(cfg.pool) do
        local poolId = poolArgs[1]
        local poolPro = poolArgs[2]
        local poolCfg = ConfigManager.item_pools_cfg[poolId]
        local poolSum = 0
        if poolCfg then
            for _, itemArgs in pairs(poolCfg.items) do
                if #itemArgs > 0 then
                    local itemId = itemArgs[1]
                    local itemNum = itemArgs[2]
                    local itemPro = itemArgs[3]
                    poolSum = poolSum + (itemPro or 0)
                    storageType, storageID = StorageManager:CheckSidType(itemId)
                    artFlag = storageID == Spiritual and 1 or 0
                    order = storageID == Spiritual and ConfigManager.spiritual_cfg[itemId].Order or 0
                    table.insert(self.probList,
                            { sid = itemId, num = itemNum, prob = itemPro or 0, poolId = poolId, art = artFlag, order = order })
                end
            end
        end
        poolProDic[poolId] = { poolSum, poolPro }
        sum = sum + poolPro
    end
    for _, v in pairs(self.probList) do
        v.prob = 100 * (v.prob / poolProDic[v.poolId][1]) * (poolProDic[v.poolId][2] / sum)
    end
    _G.SortList(self.probList, function(a)
        return a.art, a.order, a.num, a.sid
    end)
end

---@return TreasureBlissPreView
return TreasureBlissPreView