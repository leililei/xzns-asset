---@class ThemeCashSignView : UIBaseView	中文描述
---@field public go_table ThemeCashSignView_GoTable GoTable
local ThemeCashSignView = _G.BaseClass("ThemeCashSignView", _G.UIBaseView)
local ThemeCashSignModel
local StorageManager
local ColorTools = _G.ColorTools
local GetLangPackValue = _G.GetLangPackValue
function ThemeCashSignView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ThemeCashSignView:OnCreate()
    ThemeCashSignModel = require("ThemeCashSignModel"):GetInstance()
    StorageManager = _G.StorageManager:GetInstance()
    self.awardList = ThemeCashSignModel.awardList
    self.isGetFree = ThemeCashSignModel.isGetFree
    self.isGetCash = ThemeCashSignModel.isGetCash
    self.loginDay = ThemeCashSignModel.loginDay
    self.isCash = ThemeCashSignModel.isCash
    self.cashPrice = _G.GameUtil.RatioControl(ThemeCashSignModel.price)
    self.go_table.aorbtn_cash:SetActiveE(self.isCash == 1 and 0 or 1)
    self.go_table.aortext_receive.text = GetLangPackValue(90028500029, self.cashPrice)
    self.go_table.scrollloophorizontal_PageList:InitItemData(#self.awardList, _G.handler(self, self.RefreshList))
    self:LoadEffect()
end

function ThemeCashSignView:RefreshView()
    self.isCash = ThemeCashSignModel.isCash
    self.go_table.scrollloophorizontal_PageList:UpdateAllItem()
end

---界面的销毁函数
function ThemeCashSignView:OnDestroy()
end

function ThemeCashSignView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_ThemeCashSignView_bg, self.go_table.obj_BG, check)
end

---按钮点击事件在这里派发
function ThemeCashSignView:OnClickBtn(go)
    if go == self.go_table.aorbtn_cash then
        if not ThemeCashSignModel:CheckIsCash() then
            ThemeCashSignModel:BuyGift(
                function()
                    self.go_table.aorbtn_cash:SetActiveE(0)
                    self:RefreshView()
                end
            )
        end
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function ThemeCashSignView:RefreshList(index, obj)
    local newindex = index + 1
    local data = self.awardList[newindex]
    local tb = _G.GetAutoGoTable(obj, _G.handler(self, self.GetAward))
    tb.aortext_day.text = data.des
    local freeAward = data.free_award[1]
    local cashAward = data.pay_award[1]
    tb.obj_lock:SetActiveE(newindex > 1 and 1 or 0)
    tb.obj_Free:RemoveAllChildren()
    StorageManager:GetItemBaseViewNew(
        {freeAward.sid, freeAward.num},
        tb.obj_Free,
        function(trans)
            if _G.IsNil(tb.obj_Free) then
                _G.DestroyObject(trans)
                return
            end
            trans.gameObject:SetLocalScaleXYZ(0.9)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            trans:SetGou(self.isGetFree[data.id])
        end,
        function(go, isOn)
            if self.loginDay >= data.day and ThemeCashSignModel:CheckCanTake() then
                self:GetAward()
            else
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, freeAward.sid)
            end
        end
    )
    tb.obj_Cash:RemoveAllChildren()
    StorageManager:GetItemBaseViewNew(
        {cashAward.sid, cashAward.num},
        tb.obj_Cash,
        function(trans)
            if _G.IsNil(tb.obj_Cash) then
                _G.DestroyObject(trans)
                return
            end
            trans.gameObject:SetLocalScaleXYZ(0.9)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            trans:SetGou(self.isGetCash[data.id])
        end,
        function(go, isOn)
            if self.isCash ~= 1 then
                _G.PopWindowManager:GetInstance():ShowAllTips(770106)
            else
                if self.loginDay >= data.day and ThemeCashSignModel:CheckCanTake() then
                    self:GetAward()
                else
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, cashAward.sid)
                end
            end
        end
    )

    tb.obj_awdEff:SetActiveE(0)
    tb.obj_bgEff:SetActiveE(0)
    tb.obj_FreeLock:SetActiveE(self.loginDay < data.day and 1 or 0)
    tb.obj_CashLock:SetActiveE((self.isCash ~= 1 or self.loginDay < data.day) and 1 or 0)
    if self.loginDay >= data.day then
        if not self.isGetCash[data.id] or not self.isGetFree[data.id] then
            tb.obj_high:SetActiveE(1)
            tb.aortext_day.color = ColorTools.FormatColorByString("e16419")
        else
            tb.obj_high:SetActiveE(0)
            tb.aortext_day.color = ColorTools.FormatColorByString("5e4540")
        end

        if self.isCash == 1 and not self.isGetCash[data.id] then
            tb.obj_awdEff:SetActiveE(1)
            tb.obj_bgEff:SetActiveE(1)
        elseif self.isCash == 0 then
            tb.obj_awdEff:SetActiveE(0)
            tb.obj_bgEff:SetActiveE(not self.isGetFree[data.id] and 1 or 0)
        end
    else
        tb.obj_high:SetActiveE(0)
        tb.aortext_day.color = ColorTools.FormatColorByString("5e4540")
    end

    -- isGetFree 1 已领取过免费
    -- isGetCash 1 已领取过付费
    -- 可领取（免费， 付费， 都可领取） 边框显示
    -- 付费后可领取，奖励特效 显示

    -- tb.obj_bgEff:SetActiveE(self.isGetFree[data.id] and 1 or 0)
    -- tb.obj_awdEff:SetActiveE((self.loginDay >= data.day and not self.isGetCash[data.id]) and 1 or 0)

    --- 边框特效
    if tb.BgEffobj == nil and not tb.BgEffLoad then
        tb.BgEffLoad = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ThemeCashSignView_kuang,
            tb.obj_bgEff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                tb.BgEffobj = trans
            end
        )
    end

    --- 奖励特效
    if tb.AwdEffobj == nil and not tb.AwdEffLoad then
        tb.AwdEffLoad = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ThemeCashSignView_kuang_l,
            tb.obj_awdEff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                tb.AwdEffobj = trans
            end
        )
    end
end

function ThemeCashSignView:GetAward()
    ThemeCashSignModel:ClickAward(
        function()
            self.go_table.scrollloophorizontal_PageList:UpdateAllItem()
        end
    )
end

return ThemeCashSignView
