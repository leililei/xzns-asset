---@class ThemeCashSignModel : ThemeActivityBaseModel	中文描述
local base = require "ThemeActivityBaseModel"
local ThemeCashSignModel = _G.BaseClass("ThemeCashSignModel", base)
local ThemeActivityManager = require"ThemeActivityManager":GetInstance()
local insert = _G.table.insert
---@return ThemeCashSignModel ThemeCashSignModel
function ThemeCashSignModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ThemeCashSignModel:__init()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
end

function ThemeCashSignModel:InitData(msg)
    self.themeData = msg
    self.awardList = {}
    self.awardList = msg.cfg_list
    self.isGetFree = {}
    self.isGetCash = {}
    self.loginDay = msg.login_day > #self.awardList and #self.awardList or msg.login_day
    self.price = msg.price
    self.cashSid = msg.cash_sid
    self.isCash = msg.is_cash
    self.coinSid = require"ThemeActivityManager":GetInstance():GetCoinSid()
    if not _G.table.isEmptyOrNil(self.themeData.free_list) then
        for _, v in pairs(self.themeData.free_list) do
            self.isGetFree[v] = v
        end
    end
    if not _G.table.isEmptyOrNil(self.themeData.pay_list) then
        for _, v in pairs(self.themeData.pay_list) do
            self.isGetCash[v] = v
        end
    end
    _G.SortList(
        self.awardList,
        function(a)
            return -a.day
        end
    )
end

---销毁对象时,析构函数
function ThemeCashSignModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
end

function ThemeCashSignModel:BuyGift(callBack)
    self.sendBuy = true
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    local activityId = ThemeActivityManager:GetActivityID()
    require "MallManager":GetInstance():BuyActiveGift(self.price, activityId, self.cashSid)
end

function ThemeCashSignModel:OnMallCashListener(data)
    if data.activity_id == ThemeActivityManager:GetActivityID() then
        self.isCash = 1
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
    self.sendBuy = false
end

function ThemeCashSignModel:CheckCanTake()
    if self:CheckIsCash() then
        if #self.isGetCash < self.loginDay then
            return true
        end
    end
    return #self.isGetFree < self.loginDay
end

function ThemeCashSignModel:ClickAward(call)
    require"ActivitySynNet":GetInstance():GetAward(ThemeActivityManager:GetActivityID(),nil,
    function(msg)
        if msg.ack ~= 1 then
            return
        end
        if not msg.award then
            msg.award = {item = {}}
        end
        local isCash = self:CheckIsCash()
        local coins = 0
        for i =1 ,self.loginDay do
            local data = self.awardList[i]
            if not self.isGetFree[data.id] and self.coinSid == data.free_award[1].sid then
                coins = coins + data.free_award[1].num
            end
            self.isGetFree[data.id] = data.id
            if isCash then
                if not self.isGetCash[data.id] and self.coinSid == data.pay_award[1].sid then
                    coins = coins + data.pay_award[1].num
                end
                self.isGetCash[data.id] = data.id
            end
        end
        if coins > 0 then
            insert(msg.award.item,{type = {self.coinSid,coins}})
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        --self.isGet[msg.id] = msg.id
        self:RefreshRedPoint()
        if call then
            call()
        end
    end)
end

---进入活动
function ThemeCashSignModel:EnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ThemeCashSignView.Name)
end

---初始化红点树{{id,lua,child}} id 红点id ,lua 红点脚本需继承RedPointBaseThemeActivity,child 子功能红点id
function ThemeCashSignModel:InitRedTree()
    self.redTree = {{1, "RedPointThemeCashSign", {}}}
end

function ThemeCashSignModel:CheckRedPoint()
    if _G.table.isEmptyOrNil(self.isGetFree) then
        return true
    elseif #self.isGetFree < self.loginDay then
        return true
    elseif self:CheckIsCash() and  #self.isGetCash < self.loginDay then
        return true
    else
        return self.loginDay > #self.awardList
    end
end



function ThemeCashSignModel:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
end

function ThemeCashSignModel:CheckIsCash()
    return self.isCash == 1
end

return ThemeCashSignModel
