function ChapterAwardView:UpdateUpAndDown()
    if self.maxPage == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, false)
    elseif self.curPage == self.maxPage then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, true)
    elseif self.curPage == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, true)
    end
end

--更新数据

function ChapterAwardView:CloseView()
    for i, v in pairs(self.itemTable) do
        v.Dispose()
    end
    self.itemTable = nil
    self:Close()
end

---按钮点击事件在这里派发
function ChapterAwardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        if _G.AppSetting.DEBUG then
            _G.Log(go:GetName() .. "未触发点击事件")
        end
    end
end

return ChapterAwardView
