local ViewState = {
    PlayEffect = 1,
    WaitClick = 2,
    Click = 3
}

local MaxItemNum = 10

---@class ChapterAwardView : UIBaseView	通用奖励界面
---@field public go_table ChapterAwardView_GoTable GoTable
---@field AwardItem CommonAwardView_AwardItem
---@field AwardItems CommonAwardView_AwardItem[]
local ChapterAwardView = _G.BaseClass("ChapterAwardView", _G.UIBaseView)
--_G.ChapterAwardView = ChapterAwardView
--最多同时显示同时物品个数

function ChapterAwardView:Awake()
    self.awardData = {}
    self.clickFunction = {
        ["@_aorbtn_close"] = self.OnNext,
        ["@_aorbtn_GoNext"] = self.OnNext
    }
    self.itemTable = {}
    self.curPage = 1
    self.maxPage = 1
    self.itemTable = {}
    self.maxCount = 1
    self.checkAward = {}
    self.AwardItems = {}

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.ItemAwardAuido)
end

---界面的入口函数
---@param data award.i_award_item 传入奖励的内容
---@param call function
---@param isNotMerge boolean 不合并奖励
---@param path string  标题
---@param isExtra bool  额外奖励显示
---@param isAdd bool 是否显示加成
---@param isFan bool 是否显示加成
function ChapterAwardView:OnCreate(data, callBack, isNotMerge, path, isExtra, isAdd, isFan)
    if _G.table.isEmptyOrNil(data) or not data.award then
        self:Close()
        return
    end
    self.isExtra = isExtra
    self.isAdd = isAdd
    self.isFan = isFan
    self.state = ViewState.PlayEffect
    self.animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.isNotMerge = isNotMerge
    self:ParseData(data)
    self.maxCount = #self.awardData
    self.maxPage = 1
    --   math.floor(self.maxCount % MaxItemNum == 0 and self.maxCount / MaxItemNum or self.maxCount / MaxItemNum + 1)
    self.content = self.go_table.obj_Content
    self.callBack = callBack
    self:InitAwardItem()
    self:Wait()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    self.animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

function ChapterAwardView:ParseData(data)
    local award = data.award or data
    if award then
        local item = award.item or data
        for _, value in ipairs(item) do
            self:ParseSimpleAward(value)
        end
        if award.overflow then
            for _, value in ipairs(award.overflow) do
                self:ParseOverFlow(value)
            end
        end
    end
end

function ChapterAwardView:ParseSimpleAward(data)
    local itemType = data.type or data
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            table.insert(self.awardData, {sid = itemType[1], uid = itemType[2], star = itemType[3], number = 1})
        elseif type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            table.insert(self.awardData, {sid = itemType[1], uid = itemType[2], number = 1})
        else
            local addNum = itemType[2] or itemType[3]
            if self.isNotMerge then
                table.insert(self.awardData, {sid = itemType[1], number = addNum})
            else
                if self.checkAward[itemType[1]] == nil then
                    table.insert(self.awardData, {sid = itemType[1], number = addNum})
                    self.checkAward[itemType[1]] = self.awardData[#self.awardData]
                else
                    self.checkAward[itemType[1]].number = self.checkAward[itemType[1]].number + addNum
                end
            end
        end
    end
end

function ChapterAwardView:ParseOverFlow(data)
    local itemType = data.type or data
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            table.insert(self.awardData, {sid = itemType[1], uid = 0, star = itemType[2], number = itemType[3]})
        elseif type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            table.insert(self.awardData, {sid = itemType[1], uid = 0, element = itemType[2], number = itemType[3]})
        else
            local addNum = itemType[2] or itemType[3]
            if self.isNotMerge then
                if self.isExtra then
                    local count
                    if self.checkAward[itemType[1]] == nil then
                        count = _G.math.ceil(addNum / 2)
                        table.insert(self.awardData, {sid = itemType[1], number = count})
                        if addNum > count then
                            table.insert(self.awardData, {sid = itemType[1], number = addNum - count})
                        end
                    else
                        table.insert(self.awardData, {sid = itemType[1], number = addNum})
                    end
                else
                    table.insert(self.awardData, {sid = itemType[1], number = addNum})
                end
            else
                if self.checkAward[itemType[1]] == nil then
                    table.insert(self.awardData, {sid = itemType[1], number = addNum})
                    self.checkAward[itemType[1]] = self.awardData[#self.awardData]
                else
                    self.checkAward[itemType[1]].number = self.checkAward[itemType[1]].number + addNum
                end
            end
        end
    end
end

---更新显示内容
function ChapterAwardView:InitAwardItem()
    self.AwardItem = _G.GetAutoGoTable(self.go_table.obj_AwardItem)
    self.co =
        _G.DelayDo(
        1,
        function()
            if self.maxCount > 5 then
                self.AwardItem.scrollloopvectical_AwardList:InitItemData(
                    _G.math.ceil(self.maxCount / 5),
                    _G.handler(self, self.RefreshAwardItem)
                )
            else
                self.awardItem = require "CommonAwardView_AwardItem".New(self.AwardItem.obj_Award2, self.awardData)
                _G.GameUtil.SetActiveByCondition(self.AwardItem.obj_Award2, true)
                ---@type CommonAwardView_AwardItemParames
                local params = {index = 1, datas = self.awardData, isExtra = self.isExtra, isAdd = self.isAdd}
                self.awardItem:Show(params)
            end
        end
    )
    if self.isFan ~= nil and self.isFan == true then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_QiSan, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_QiSan, false)
    end
end

function ChapterAwardView:RefreshAwardItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    self.awardItem = self.AwardItems[instanceID]
    if not self.awardItem then
        self.awardItem = require "CommonAwardView_AwardItem".New(obj)
        self.AwardItems[instanceID] = self.awardItem
    end
    ---@type CommonAwardView_AwardItemParames
    local params = {index = index + 1, datas = self.awardData, isExtra = self.isExtra, isAdd = self.isAdd}
    self.awardItem:Show(params)
end

function ChapterAwardView:GetTable(startIndex, endIndex)
    local table = {}
    for i = 1, MaxItemNum do
        table[i] = self.awardData[startIndex + i - 1]
    end
    return table
end

---初始化界面
function ChapterAwardView:OnLast()
    if self.isDrag then
        return
    end
    self.curPage = self.curPage - 1
    self:MovePos()
end

function ChapterAwardView:Wait()
    if self.wait then
        _G.coroutine.stopwaiting(self.wait)
    end
    self.wait =
        _G.DelayDo(
        1.2,
        function()
            self.state = ViewState.Click
            if self.go_table then
                _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_GoNext, true)
            end
        end
    )
end
function ChapterAwardView:AddChapterTitleView()
    local FunItem = {}
    FunItem.checkFun = function()
        return true
    end
    FunItem.OpenViewFun = function()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChapterTitleView.Name, nil, true)
    end
    _G.MainManager:GetInstance():AddMainFunQueue(FunItem, _G.MainViewShowOrder.ChapterTitle)
end
function ChapterAwardView:OnNext()
    if self.state ~= ViewState.Click then
        return
    end
    self.curPage = self.curPage + 1
    if self.curPage > self.maxPage then
        if self.wait then
            _G.coroutine.stopwaiting(self.wait)
        end
        if self.co then
            _G.coroutine.stopwaiting(self.co)
        end
        self:AddChapterTitleView()
        self:Close()
        if self.callBack then
            self.callBack()
        end
        return
    end
