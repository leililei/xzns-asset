---@class ChapterTitleView : UIBaseView	中文描述
---@field public go_table ChapterTitleView_GoTable GoTable
local ChapterTitleView = _G.BaseClass("ChapterTitleView", _G.UIBaseView)

function ChapterTitleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local endFrame = _G.ConfigManager.discrete_cfg[100219][1][1]
---界面的入口函数
---callback
---type true 根据放置进度来 falseOrNil 新手第一次进入主城
function ChapterTitleView:OnCreate(callback, type)
    self.VideoToView = false
    self.anim = self.go_table.obj_group:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.callback = callback
    self.type = type or false
    self.haveStory = self:PlayChapterEnterStrory()
    _G.UIUtils.PlayVideo(
        _G.ConfigManager.video_cfg.zhangjie,
        function()
            if not self.VideoToView then
                self.VideoToView = true
                self.go_table.obj_group:SetActiveE(1)

                self:ShowChatperIndo()
                -- self.mCanvasGroup = self.go_table.obj_group:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
                -- self.mCanvasGroup:DOFade(1, 1)
                ---延迟三秒 等boss死亡动画播完
                self._delaySecondHandle = _G.TimerManager:GetInstance():GetTimer(3, self.PlayOver, self, true)
                self._delaySecondHandle:Start()
            end
        end,
        function()
        end
    )
    -- end
    _G.UIUtils.EndByFrame(
        function()
            if not self.VideoToView then
                self.VideoToView = true
                self.go_table.obj_group:SetActiveE(1)

                self:ShowChatperIndo()
                -- self.mCanvasGroup = self.go_table.obj_group:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
                -- self.mCanvasGroup:DOFade(1, 1)
                ---延迟三秒 等boss死亡动画播完
                self._delaySecondHandle = _G.TimerManager:GetInstance():GetTimer(3, self.PlayOver, self, true)
                self._delaySecondHandle:Start()
            end
        end,
        endFrame
    )
end
function ChapterTitleView:ShowTitle()
end
function ChapterTitleView:ShowChatperIndo()
    local iStr = ""
    local nameStr = _G.LangUtil.GetLangPackValue(90025600003)
    local cfg
    if not self.type then
        ---@param value afk_cfg
        for key, value in pairs(_G.ConfigManager.afk_cfg) do
            if value.chapter == 1 and value.section == 1 then
                cfg = value
                break
            end
        end
    end
    if cfg ~= nil then
        local Name = cfg.Name[1]
        if Name ~= nil then
            iStr = _G.LangUtil.GetLangPackValue(Name[1])
            nameStr = _G.LangUtil.GetLangPackValue(Name[2])
        end
    end
    self.go_table.aortext_i.text = iStr
    self.go_table.aortext_name.text = nameStr
end

function ChapterTitleView:PlayOver()
    if self._delaySecondHandle then
        self._delaySecondHandle:Stop()
        self._delaySecondHandle = nil
    end
    self:Hide()
    if not self.haveStory then
        self:CloseView()
        if self.callback then
            self.callback()
        end
    end
end
---视频完 衔接章节进入剧情
function ChapterTitleView:PlayChapterEnterStrory()
    local cfg = require "AfkModel":GetInstance():GetCurSectionCfg()
    if cfg and cfg.FrontChapterStoryID > 0 then
        _G.AutomaticPlayStory.PlayStoryByID(
            cfg.FrontChapterStoryID,
            function()
                self:CloseView()
                if self.callback then
                    self.callback()
                end
            end
        )
        return true
    else
        return false
    end
end
function ChapterTitleView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function ChapterTitleView:OnClickBtn()
end

function ChapterTitleView:OnDestroy()
    if self._delaySecondHandle then
        self._delaySecondHandle:Stop()
        self._delaySecondHandle = nil
    end
end

return ChapterTitleView
