---界面的入口函数
function ChapterEmbattleView:OnCreate(exitCall, battleCall, mgpID, objectWorldSid)
    self.onExitCall = exitCall
    self.onBattleCall = battleCall
    self:OpenEmbattleView(mgpID, objectWorldSid)
end
function ChapterEmbattleView:OnDestroy()
    -- self.tags = nil
    -- self.cardParent = nil
    self.needItemPos = nil
end
function ChapterEmbattleView:OpenEmbattleView(mgpID, objectWorldSid)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    local emItem, saveType
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        emItem = _G.EmbattleControllerItemType.chapter
        saveType = _G.EmbattleSaveType.server
    else
        emItem = _G.EmbattleControllerItemType.chapterPrologue
        saveType = _G.EmbattleSaveType.temporary
    end
    EmbattleController:GetInstance():OpenEmbattle(
        _G.EmbattleType.section,
        saveType,
        true,
        emItem,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        mgpID,
        objectWorldSid
    )
end

function ChapterEmbattleView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function ChapterEmbattleView:OnBattleCall(storyCardList)
    if self.embattleView then
        self.embattleView:Close()
    end
    self:Close()
    if self.onBattleCall then
        self.onBattleCall(storyCardList)
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function ChapterEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
    end
end

return ChapterEmbattleView
