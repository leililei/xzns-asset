function SelectSectionMapView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.ListUnflodAuido)
end

---界面的入口函数
function SelectSectionMapView:OnCreate(ChapterID, SectionID, call)
    self.call = call
    self.indexID = SectionID
    self.CurChapterID = ChapterID
    if self.CurChapterID == nil or self.CurChapterID == 0 then
        self.cfg = require("ChapterModel"):GetInstance():GetCurChapterCfg()
        self.CurChapterID = self.cfg.ID
    end
    if not IsNumber(self.CurChapterID) then
        if type(self.CurChapterID) == "table" then
            self.CurChapterID = self.CurChapterID[1]
        else
            self:Close()
            return
        end
    end
    self.cfg = _G.ConfigManager.main_chapter_cfg[self.CurChapterID]
    self.IsFirst = true
    self.go_table.aorrawimage_ViewName:LoadImage(_G.LangUtil.GetLangPackValue(ViewName))
    self.go_table.aorrawimage_D:LoadImage(_G.LangUtil.GetLangPackValue(font_D))
    self.go_table.aorrawimage_Z:LoadImage(_G.LangUtil.GetLangPackValue(font_Z))
    self.go_table.aorrawimage_ViewName:LoadImage(_G.LangUtil.GetLangPackValue(ImagePath.FX))

    ---加载循环特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.Ef_Main_section01,
        self.go_table.aortext_ChapterName,
        function(tran)
        end
    )

    ---加载章节图
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.Ef_Main_section02,
        self.go_table.obj_BG,
        function(tran)
            if tran then
                self.preChpaterIcon = tran:FindE("ani/bg/@obj_1"):GetComponentE(typeof(CS.AorRawImage))
                self.curChpaterIcon = tran:FindE("ani/bg/@obj_2"):GetComponentE(typeof(CS.AorRawImage))
                self.ChpaterChangeEff = tran
            end
            self.go_table.aorrawimage_ChapterIcon:LoadImage(
                self.cfg.image_2,
                function()
                    self:InitView()
                    self:ShowEnterEff()
                end
            )
        end
    )
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    if not _G.PlayerPrefsManager.HasKey(uid .. "OpenSelectSectionMapView") then
        _G.PlayerPrefsManager.SetInt(uid .. "OpenSelectSectionMapView", 1)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainChallenge.id, 205)
    end
end

---初始化界面
function SelectSectionMapView:InitView()
    self.go_table.aortext_ChpaterNum.text = _G.ConfigManager.main_chapter_cfg[self.CurChapterID].ChapterNum
    self.go_table.aortext_ChapterName.text =
        _G.LangUtil.GetLangPackValue(_G.ConfigManager.main_chapter_cfg[self.CurChapterID].Name)
    self:ShwoSectionList()
end

---显示关卡列表
function SelectSectionMapView:ShwoSectionList()
    self.SectionIDList = self.cfg.Section

    if self.IsFirst then
        self.go_table.looplist2_SectionList:InitListView(0, _G.handler(self, self.RefreshList))

        self.IsFirst = false
    end
    self.go_table.looplist2_SectionList:SetListItemCount(#self.SectionIDList, true)

    if not self.IsFirst then
        self.go_table.looplist2_SectionList:RefreshAllShownItem()
    end
    local curSection = self.indexID or require("ChapterModel"):GetInstance():GetCurSectionSID()
    for i = 1, #self.SectionIDList do
        if self.SectionIDList[i] == curSection then
            local num = i - 2
            local offset = 0
            if num > #self.SectionIDList - 5 then
                num = #self.SectionIDList - 5
                offset = -100
            end
            if num > 0 then
                self.go_table.looplist2_SectionList:MovePanelToItemIndex(num, offset)
            end
            return
        end
    end
end

---列表刷新
function SelectSectionMapView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index + 1
    item:SetName(x)
    local tb = {}
    local data = {}
    local data = _G.ConfigManager.main_section_cfg[self.SectionIDList[x]]
    tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickSection, data))

    if data == nil then
        tb.gameObject:SetActiveE(0)
    else
        tb.gameObject:SetActiveE(1)
        tb.aortext_SectionName.text = _G.LangUtil.GetLangPackValue(data.Name)
        tb.aorrawimage_BG:LoadImage(data.section_icon)
        self:ShowLock(tb, data)
        local ChapterModel = require("ChapterModel"):GetInstance()
        if ChapterModel:CheckSectionChanllenge(data.id) then
            ---是否为剧情关卡
            if data.Type1 == _G.ChapterItemType.Npc then
                tb.aortext_ExploreValue.text = "100%"
            else
                local num, sum = ChapterModel:GetSectionExploreDetail(data.id)
                if sum == 0 then
                    tb.aortext_ExploreValue.text = "0%"
                else
                    tb.aortext_ExploreValue.text = _G.math.floor(num / sum * 100) .. "%"
                end
            end
        else
            tb.aortext_ExploreValue.text = "<color=#ffea45>" .. _G.LangUtil.GetLangPackValue(90000000092) .. "</color>"
        end
    end

    return item
end

---@param data main_section_cfg_Item
function SelectSectionMapView:ShowLock(tb, data)
    ---放置>等级>任务
    local lockType = LockType.None
    if not _G.GlobalConditionManager.CheckCondition(_G.GlobalConditionManager.ConditionType.afk, data.Afk_Lock) then
        lockType = LockType.Afk
    elseif data.LimitLevel > _G.PlayerModel:GetInstance():GetLevel() then
        lockType = LockType.Level
    elseif
        not require("ChapterModel"):GetInstance():CheckSectionPass(
            _G.ConfigManager.main_section_cfg[data.id].PreSection
        )
     then
        lockType = LockType.Section
    else
        lockType = LockType.None
    end
    if lockType == LockType.None then
        tb.obj_OnLock:SetActiveE(0)
    else
        tb.obj_OnLock:SetActiveE(1)
        if lockType == LockType.Afk then
            local afkCfg = _G.ConfigManager.afk_cfg[data.Afk_Lock]
            if afkCfg then
                tb.aortext_Des.text =
                    string.format(_G.LangUtil.GetLangPackValue(90028010103), afkCfg.chapter, afkCfg.section)
            end
        elseif lockType == LockType.Level then
            tb.aortext_Des.text = string.format(_G.LangUtil.GetLangPackValue(90022300026), data.LimitLevel)
        else
            tb.aortext_Des.text = string.format(_G.LangUtil.GetLangPackValue(90022013802))
        end
    end
end

---显示进场效果
function SelectSectionMapView:ShowEnterEff()
    self.go_table.obj_ViewMask:SetActiveE(1)
    local list = {}
    local childCount = self.go_table.obj_Content:GetChildCountE()
    local child
    for i = 1, childCount do
        child = self.go_table.obj_Content:GetChildE(i - 1)
        if child:GetActiveSelf() == 1 then
            table.insert(list, child:GetComponentE(typeof(CS.UnityEngine.RectTransform)))
        end
    end
    table.sort(
        list,
        function(b, a)
            if tonumber(b:GetName()) < tonumber(a:GetName()) then
                return true
            end
            return false
        end
    )
    if not self.Coroutine then
        self.Coroutine = {}
    end
    self.Coroutine[#list * 0.15 + 0.5] =
        _G.DelayDo(
        #list * 0.15 + 0.5,
        function()
            if self ~= nil and self.go_table then
                self.go_table.obj_ViewMask:SetActiveE(0)
            end
        end
    )
    for i = 1, #list do
        local canvasGroup = list[i]:GetComponentE(typeof(CS.UnityEngine.CanvasGroup))
        canvasGroup.alpha = 0
        local _, y1 = list[i]:GetAnchorPosition()
        list[i]:SetAnchorPosition(700, y1)
        self.Coroutine[(i) * 0.15] =
            _G.DelayDo(
            (i) * 0.15,
            function()
                if not _G.IsNil(canvasGroup) then
                    canvasGroup:DOFade(1, 0.25)
                end
                if not _G.IsNil(list[i]) then
                    local _, y2 = list[i]:GetAnchorPosition()
                    list[i]:DOAnchorPos(_G.Vector2.New(0, y2), 0.15)
                end
            end
        )
    end
end

