---点击物品，放入选择列表
function SelectSectionMapView:OnClickSection(go, IsOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_Lock" then
        if not _G.GlobalConditionManager.CheckCondition(4, data.Afk_Lock) then
            local afkCfg = _G.ConfigManager.afk_cfg[data.Afk_Lock]
            if afkCfg then
                local str = string.format(_G.LangUtil.GetLangPackValue(90028010103), afkCfg.chapter, afkCfg.section)
                _G.PopWindowManager:GetInstance():ShowAllTips(280103, str)
                return
            end
        end
        if _G.PlayerModel:GetInstance():GetLevel() < data.LimitLevel then
            local str = _G.LangUtil.GetLangPackValue(TeamLvLanguage)
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.TeamLv, string.format(str, data.LimitLevel))
            return
        end
        if not require("ChapterModel"):GetInstance():CheckSectionPass(data.PreSection) then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.PreOnLock)
            return
        end
    elseif name == "@_aorbtn_Enter" or name == "@_aorbtn_Enter2" then
        self:EnterSection(data)
    end
end

---进入关卡
---@param data table main_section_cfg的id
function SelectSectionMapView:EnterSection(data)
    local cfg = _G.ConfigManager.main_section_cfg[data.id]
    local ChapterModel = require("ChapterModel"):GetInstance()
    if not ChapterModel:CheckSection(data.id) then
        local str = cfg.TaskCondition
        if str > 0 then
            str = _G.ConfigManager.task_cfg[str].name
            str = _G.LangUtil.GetLangPackValue(str)
            _G.PopWindowManager:GetInstance():ShowAllTips(110106, nil, nil, nil, nil, nil, str)
        end
        return
    end

    if data.Type1 == _G.ChapterItemType.Npc then
        ChapterModel:EnterStorySection(
            data,
            function()
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SectionMapView.Name, data.id, false)
    end
end

---切换章节
function SelectSectionMapView:ChangeChapter(num)
    local sid
    for _, v in pairs(_G.ConfigManager.main_chapter_cfg) do
        if v.ChapterNum == self.cfg.ChapterNum + num and v.is_formal and v.Section[1] then
            if
                not require("ChapterModel"):GetInstance():CheckSection(
                    _G.ConfigManager.main_section_cfg[v.Section[1]].PreSection
                )
             then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.PreChapter)
                return
            end
            self.preChpaterIcon:LoadImage(self.cfg.image_2)
            self.cfg = v
            self.CurChapterID = v.ID
            self.go_table.aorrawimage_ChapterIcon:SetActiveE(0)
            self.curChpaterIcon:LoadImage(self.cfg.image_2)
            self.ChpaterChangeEff:SetActiveE(0)
            self.ChpaterChangeEff:SetActiveE(1)
            self:InitView()
            self:ShowEnterEff()
            return
        end
    end
end

---按钮点击事件在这里派发
function SelectSectionMapView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        if self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Up then
        self:ChangeChapter(-1)
    elseif go == self.go_table.aorbtn_Down then
        self:ChangeChapter(1)
    end
end

function SelectSectionMapView:OnDestroy()
    if self.Coroutine then
        for k, v in pairs(self.Coroutine) do
            if v then
                _G.coroutine.stopwaiting(v)
            end
        end
    end
end

return SelectSectionMapView
