--region
local tagName = {
    [_G.WorldItemType.Box] = "ui_jq_pic_ld03",
    [_G.WorldItemType.NPC] = "ui_jq_pic_ld01",
    [_G.WorldItemType.Enemy] = "ui_jq_pic_ld04"
}
local defaultAddPosY = 70
local ChapterObjectTagItem = _G.BaseClass("ChapterObjectTagItem")

function ChapterObjectTagItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end
function ChapterObjectTagItem:Dispose()
    self.go_table = nil
end
function ChapterObjectTagItem:OnClickBtn(go)
    if self.uid ~= 0 then
        _G.WorldManager:GetInstance():GetCurWorld():OnClick("WorldObject", self.uid)
    end
end
function ChapterObjectTagItem:Show(uid, tag, pos, rect, deltaY)
    if uid == 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    self.uid = uid
    self.go_table.aorimage_tag.SpriteName = tagName[tag]
    pos = _G.UIUtils.Get3DTo2DPos(rect, pos)
    if not deltaY or deltaY == 0 then
        deltaY = defaultAddPosY
    end
    self.go_table.gameObject:SetLocalPosition(pos.x, pos.y + deltaY, 0)
end
--endregion

local WorldItemManager = require "WorldItemManager"

---@class ChapterObjectTagView : UIBaseView	中文描述
---@field public go_table ChapterObjectTagView_GoTable GoTable
local ChapterObjectTagView = _G.BaseClass("ChapterObjectTagView", _G.UIBaseView)

function ChapterObjectTagView:Awake()
    self.objList = {ChapterObjectTagItem.New(self.go_table.obj_tag)}
    self.objectShowDic = {}
    _G.Events:GetInstance():AddListener(WorldItemManager.ItemEvent.showTag, self.ShowByUid, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.OnMainViewShow, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIHide, self.OnMainViewHide, self)
end

---界面的入口函数
function ChapterObjectTagView:OnCreate()
    self:ShowAll()
end

function ChapterObjectTagView:OnDestroy()
    for i = 1, #self.objList do
        self.objList[i]:Dispose()
    end
    self.objList = nil
    for _, item in pairs(self.objectShowDic) do
        item:Dispose()
    end
    self.objectShowDic = nil
    _G.Events:GetInstance():RemoveListener(WorldItemManager.ItemEvent.showTag, self.ShowByUid, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIShow, self.OnMainViewShow, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIHide, self.OnMainViewHide, self)
end

function ChapterObjectTagView:OnMainViewShow(name)
    if name == _G.ConfigManager.ui_cfg.MainView.Name then
        if _G.UIManager:GetInstance():IsLoadedWindow(_G.ConfigManager.ui_cfg.ChapterObjectTagView.Name) then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChapterObjectTagView.Name)
        end
    end
end
function ChapterObjectTagView:OnMainViewHide(name)
    if name == _G.ConfigManager.ui_cfg.MainView.Name then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChapterObjectTagView.Name)
    end
end

function ChapterObjectTagView:ShowAll()
    self:ShowByType(_G.WorldItemType.NPC)
    self:ShowByType(_G.WorldItemType.Enemy)
    self:ShowByType(_G.WorldItemType.Box)
end
function ChapterObjectTagView:ShowByType(_type)
    local items = WorldItemManager:GetInstance():GetItemsByType(_type)
    local show, posy
    for uid, item in pairs(items) do
        show, posy = item:GetShowTagData()
        if show then
            self:ShowByUid(uid, show, posy)
        end
    end
end
---展示图标
---@param uid number 物件uid
---@param show boolean 是否展示
---@param deltaY number Y轴偏移值
function ChapterObjectTagView:ShowByUid(uid, show, deltaY)
    if show then
        if self.objectShowDic[uid] then
            return
        end
        local item = WorldItemManager:GetInstance():GetItemByUid(uid)
        local x, y, z = item:GetHeadPoint()
        if x then
            local pos = {x = x, y = y, z = z}
            local obj = self:GetObj()
            self.objectShowDic[uid] = obj
            obj:Show(uid, item.Cfg.Type1, pos, self.go_table.rect_view, deltaY)
        end
    else
        local item = self.objectShowDic[uid]
        if item then
            self:PutObj(item)
        end
        self.objectShowDic[uid] = nil
    end
end

function ChapterObjectTagView:GetObj()
    local obj
    if #self.objList <= 0 then
        obj = self.go_table.obj_tag:InstantiatE(self.go_table.gameObject)
        obj = ChapterObjectTagItem.New(obj)
    else
        obj = _G.table.remove(self.objList, 1)
    end
    return obj
end

function ChapterObjectTagView:PutObj(obj)
    obj:Show(0)
    _G.table.insert(self.objList, obj)
end

return ChapterObjectTagView
