---@class ChapterSelectView : UIBaseView    中文描述
---@field public go_table ChapterSelectView_GoTable GoTable
local ChapterSelectView = _G.BaseClass("ChapterSelectView", _G.UIBaseView)
--_G.ChapterSelectView = ChapterSelectView

local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
local ChapterPage = "UI/Chatper/ChapterPage"
local ChapterAward = "<color=#c7832b>%d</color><color=#6f69ac>%s</color>"
local ChapterNum = GetLangPackValue(90022500370)
local NumToStr = {
    [1] = 90022011802,
    [2] = 90022011902,
    [3] = 90022012002,
    [4] = 90022012102,
    [5] = 90022012202,
    [6] = 90022012302,
    [7] = 90022012402,
    [8] = 90022012502,
    [9] = 90022012602,
    [10] = 90022012702
}

local tipsID = {
    PreChapter = 110102,
    TeamLv = 110103,
    PreOnLock = 210106
}

local ImagePath = {
    FX = 90022012802,
    KSJQ = 90022012902,
    TG = 90022013202,
    WM = 90022013302,
    YLQ = 90022013402
}

function ChapterSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@field ChapterID number 章节ID
function ChapterSelectView:OnCreate(ChapterID, isShowMerge, isTest)
    self.CurChapterID = ChapterID
    if self.CurChapterID == nil or self.CurChapterID == 0 then
        self.cfg = require("ChapterModel"):GetInstance():GetCurChapterCfg()
        self.CurChapterID = self.cfg.Chapter
    else
        self.cfg = _G.ConfigManager.main_chapter_cfg[self.CurChapterID]
    end
    if not self.cfg then
        self:Close()
        return
    end
    self.SectionImage = {}
    self.main_chapter_cfg = {}

    for i, v in pairs(_G.ConfigManager.main_chapter_cfg) do
        if isTest then
            if not v.is_formal then
                self.main_chapter_cfg[i] = v
            end
        else
            if v.is_formal then
                self.main_chapter_cfg[i] = v
            end
        end
    end

    for i = 1, 10 do
        self.SectionImage[i] = self.go_table.obj_ChapterImage:FindE("root/" .. i):GetComponentE(typeof(CS.AorRawImage))
        --"root/" ..
    end
    self.page = {}
    local count = 1
    for i, v in pairs(self.main_chapter_cfg) do
        _G.PoolsManager:GetInstance():Spawn(
            ChapterPage,
            _G.ePoolType.UIItem,
            self.go_table.obj_Content,
            function(trans)
                self.page[count] = _G.GetAutoGoTable(trans, _G.handlerbind(self, self.OnclickPage, count))
                trans:SetName(count)
                if count == self.cfg.ChapterNum then
                    self.page[count].obj_Cur:SetActiveE(1)
                else
                    self.page[count].obj_Cur:SetActiveE(0)
                end
                count = count + 1
            end
        )
    end
    self.ChpaterBtns = {}
    for i = 1, 8 do
        self.ChpaterBtns[string.format("@_aorbtn_%d", i)] = i
        self:AddDragEvent(
            self.go_table.obj_ChapterBtn:FindE(string.format("@_aorbtn_%d", i)):GetComponentE(typeof(CS.AorImage))
        )
    end
    self.go_table.aorrawimage_Enter:LoadImage(
        GetLangPackValue(ImagePath.KSJQ),
        function(image)
            image:SetNativeSize()
        end
    )
    self:AddDragEvent(self.go_table.aorimage_Slider)
    self.Anim = self.gameObject:FindE("ef_ChapterSelectView"):GetComponentE(typeof(CS.UnityEngine.Animator))
    self:InitView()

    if isShowMerge then
        self:SetMergeTimer()
    end
end

----设置章节碎片合并计时器
function ChapterSelectView:SetMergeTimer()
    self.Timer = _G.TimerManager:GetInstance():GetTimer(1.2, self.TimerFunc, self)
    self.Timer:Start()
end

function ChapterSelectView:TimerFunc()
    local anim = self.go_table.obj_ChapterImage:FindE("root"):GetComponentE(typeof(CS.UnityEngine.Animator))
    if anim then
        anim.enabled = true
    end
end

---注册拖拽事件
function ChapterSelectView:AddDragEvent(go)
    _G.SetEventTrigger(go, "onDragBegin", _G.handlerbind(self, self.onDragBegin_Drag))
    _G.SetEventTrigger(go, "onDrag", _G.handlerbind(self, self.onDrag_Drag))
    _G.SetEventTrigger(go, "onDragEnd", _G.handlerbind(self, self.onDragEnd_Drag))
end

---拖拽开始
function ChapterSelectView:onDragBegin_Drag(go, eventData)
    self.DragPos = eventData.position.x
end
---拖拽中
function ChapterSelectView:onDrag_Drag(go, eventData)
end
---拖拽结束
function ChapterSelectView:onDragEnd_Drag(go, eventData)
    local pos = eventData.position.x

    if self.DragPos - pos > 30 then
        ---向右
        self:ChangeChapter(1)
    elseif pos - self.DragPos > 30 then
        ---向左
        self:ChangeChapter(-1)
    end
end

---页签点击
function ChapterSelectView:OnclickPage(go, isOn, num)
    for i, v in pairs(self.main_chapter_cfg) do
        if v.ChapterNum == num then
            self.cfg = v
            self.CurChapterID = v.ID
            break
        end
    end

    self:InitView()
end

---切换章节
function ChapterSelectView:ChangeChapter(num)
    self:OnclickPage(nil, nil, self.cfg.ChapterNum + num)

    self:InitChapterRaward()
end

---初始化界面
function ChapterSelectView:InitView()
    local AllPass = true
    local count, index = 0, 0
    local singlePass = false
    for i, v in pairs(self.cfg.Section) do
        singlePass = require("ChapterModel"):GetInstance():CheckSectionPass(v)
        if singlePass then
            count = count + 1
        end

        if
            _G.ConfigManager.main_section_cfg[v].Type1 == _G.ChapterItemType.Section or
                _G.ConfigManager.main_section_cfg[v].Type1 == _G.ChapterItemType.Boss
         then
            index = index + 1
            if singlePass then
                self.SectionImage[index]:LoadImage(
                    _G.ConfigManager.main_section_cfg[v].fragment_image,
                    function(image)
                        if image == nil then
                            return
                        end
                        image:SetGray(false)
                    end
                )
            else
                AllPass = false
                self.SectionImage[index]:LoadImage(
                    _G.ConfigManager.main_section_cfg[v].fragment_image,
                    function(image)
                        if image == nil then
                            return
                        end
                        image:SetGray(true)
                    end
                )
            end
        end
    end
    self.ChapterPass = count
    if AllPass then
        self.SectionImage[9]:SetActiveE(1)
        self.SectionImage[10]:SetActiveE(0)
        self.SectionImage[9]:LoadImage(self.cfg.image_1)
    else
        self.SectionImage[9]:SetActiveE(0)
        self.SectionImage[10]:SetActiveE(1)
    end
    local num = self.cfg.ChapterNum
    local str = ""
    if num <= 10 and num > 0 then
        str = GetLangPackValue(NumToStr[num])
    elseif num > 10 and num < 20 then
        str = GetLangPackValue(NumToStr[10])
        str = str .. GetLangPackValue(NumToStr[num % 10])
    elseif num >= 20 and num < 100 then
        str = GetLangPackValue(NumToStr[_G.math.floor(num / 10)])
        str = str .. GetLangPackValue(NumToStr[10])
        str = str .. GetLangPackValue(NumToStr[num % 10])
    end
    self.go_table.aortext_ChapterNum.text = string.format(ChapterNum, str)
    self.go_table.aortext_ChapterName.text = GetLangPackValue(self.cfg.Name)
    self.go_table.aortext_ExploreProgress.text = _G.math.floor(count * 100 / #self.cfg.Section) .. "%"
    self.go_table.slider_Award.value = count / #self.cfg.Section
    for i = 1, #self.page do
        if i == self.cfg.ChapterNum then
            self.page[i].obj_Cur:SetActiveE(1)
        else
            self.page[i].obj_Cur:SetActiveE(0)
        end
    end
    self:InitChapterRaward()
end

---获取奖励点击
function ChapterSelectView:GetAward()
end

---点击碎片进入关卡
function ChapterSelectView:OnClickSection(index)
    local count = 0
    local sectionSid
    for i = 1, #self.cfg.Section do
        if
            _G.ConfigManager.main_section_cfg[self.cfg.Section[i]].Type1 == _G.ChapterItemType.Section or
                _G.ConfigManager.main_section_cfg[self.cfg.Section[i]].Type1 == _G.ChapterItemType.Boss
         then
            count = count + 1
            if count == index then
                sectionSid = self.cfg.Section[i]
            end
        end
    end
    if
        not require("ChapterModel"):GetInstance():CheckSectionPass(
            _G.ConfigManager.main_section_cfg[sectionSid].PreSection
        )
     then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.PreOnLock)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SelectSectionMapView.Name,
        self.CurChapterID,
        sectionSid,
        function()
            -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChapterSelectView.Name, self.CurChapterID)
        end
    )
    self:ClearTimer()
    self:Close()
end

---清除计时器
function ChapterSelectView:ClearTimer()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

---按钮点击事件在这里派发
function ChapterSelectView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self.Anim:SetInteger("cou", 1)
        _G.DelayDo(
            1.2,
            function()
                self:ClearTimer()
                self:Close()
            end
        )
    elseif name == "@_aorbtn_Enter" then
        if
            not require("ChapterModel"):GetInstance():CheckSectionPass(
                _G.ConfigManager.main_section_cfg[self.cfg.Section[1]].PreSection
            )
         then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.PreChapter)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SelectSectionMapView.Name,
            self.CurChapterID,
            nil,
            function()
                -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChapterSelectView.Name, self.CurChapterID)
            end
        )
        self:ClearTimer()
        self:Close()
    elseif name == "@_aorbtn_GetAward" then
        self:GetAward()
    elseif name == "@_aorbtn_ChapterRewards1" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ChapterRewardsView.Name,
            _G.EChapterRewardsType.Prop,
            self.CurChapterID,
            _G.handler(self, self.ChapterRaward_GetCall)
        )
    elseif name == "@_aorbtn_ChapterRewards2" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ChapterRewardsView.Name,
            _G.EChapterRewardsType.CardN1,
            self.CurChapterID,
            _G.handler(self, self.ChapterRaward_GetCall)
        )
    elseif self.ChpaterBtns[name] then
        self:OnClickSection(self.ChpaterBtns[name])
    end
end

-----------------------------------------------------------------------------        目标奖励

function ChapterSelectView:InitChapterRaward()
    local chapterid = self.CurChapterID

    local objSetShow_1 = false
    local objSetShow_2 = false

    if chapterid ~= 0 then
        local ChapterModel = require("ChapterModel"):GetInstance()
        -- 如果未领取
        if not ChapterModel:CheckChapterAwardIsGot(chapterid) then
            local awardtype = ChapterModel:GetChapterRawardType(chapterid)
            if awardtype == _G.EChapterRewardsType.Prop then
                local cfg = self.main_chapter_cfg[chapterid]
                if cfg ~= nil then
                    self.go_table.aortext_ChapterRewards1.text =
                        GetLangPackValue(90022200002, cfg.ChapterNum, #cfg.Section)
                end

                local parmas = ChapterModel:GetChapterRawardParmas(chapterid)
                if parmas ~= nil then
                    self.go_table.aortext_ChapterRewards11.text = "x" .. parmas[2]
                end
                objSetShow_1 = true
            elseif awardtype == _G.EChapterRewardsType.CardN1 then
                local ChapterCfg = self.main_chapter_cfg[chapterid]
                if not _G.IsNil(ChapterCfg) then
                    self.go_table.aortext_ChapterRewards2.text = GetLangPackValue(90022200003, ChapterCfg.ChapterNum)
                end
                objSetShow_2 = true
            end
        end
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_ChapterRewards1, objSetShow_1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_ChapterRewards2, objSetShow_2)
end

function ChapterSelectView:ChapterRaward_GetCall()
    self:InitChapterRaward()
end

------------------------------------------------------------------------------        目标奖励

return ChapterSelectView
