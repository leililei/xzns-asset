---@class OrderlistView : UIBaseView	副本卡牌列表界面
---@field public go_table OrderlistView_GoTable GoTable
local OrderlistView = _G.BaseClass("OrderlistView", _G.UIBaseView)
function OrderlistView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local orderList = {
    320021613,
    320021619,
    320021620,
    320021614
}
---界面的入口函数
---@field events table 事件数组
function OrderlistView:OnCreate(events)
    if _G.AppSetting.DEBUG then
        _G.Log(events, "<color=red>" .. "完成事件参数" .. "</color>")
    end
    local event
    for i = 1, #events do
        event = _G.tonumber(events[i])
        if event then
            if _G.EventManager:GetInstance():GetEventDone(event) then
                self.go_table["aorimage_gou" .. _G.table.indexof(orderList, event)]:SetActiveE(1)
            end
        end
    end
end

---按钮点击事件在这里派发
function OrderlistView:OnClickBtn(go)
    self:Close()
end

return OrderlistView
