-- 当前关卡历史星星 最高获得
---@param value int
function SectionView:ShowXX()
    --- starArr  nil  or   [1,1,1]
    local starArr = {1, 1, 1}

    local value = starArr and starArr[1] or 0
    self:setXXison(self.go_table.aorimage_xx1, value > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_tick1, value > 0)

    value = starArr and starArr[2] or 0
    self:setXXison(self.go_table.aorimage_xx2, value > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_tick2, value > 0)

    value = starArr and starArr[3] or 0
    self:setXXison(self.go_table.aorimage_xx3, value > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_tick3, value > 0)
end

-- 显示 三星条件
---@param value int
function SectionView:SetStarConditions()
    local challenge_type_cfg = _G.ConfigManager.challenge_type_cfg

    --"未配置 关卡ID:"
    local defaultStr = GetLangPackValue(90022500371) .. self.cfg.id

    local function SetInfo(go, t_hallengeinfo)
        local mStr = GetLangPackValue(t_hallengeinfo.desc)
        local str
        for _, value in pairs(t_hallengeinfo.desc_value) do
            str = GetLangPackValue(value)
            if str == nil then
                str = value
            end
            mStr = string.format(mStr, str)
        end
        if string.IsNullOrEmpty(mStr) then
            mStr = defaultStr
        end
        go.text = mStr
    end

    local t_hallengeinfo = challenge_type_cfg[self.cfg.StarCondition1]
    SetInfo(self.go_table.aortext_xx1, t_hallengeinfo)

    t_hallengeinfo = challenge_type_cfg[self.cfg.StarCondition2]
    SetInfo(self.go_table.aortext_xx2, t_hallengeinfo)

    t_hallengeinfo = challenge_type_cfg[self.cfg.StarCondition3]
    SetInfo(self.go_table.aortext_xx3, t_hallengeinfo)
end

function SectionView:GetPowerValue(PowerRecommended)
    local tPower = PowerRecommended or 0
    if tPower > 1000000 then
        tPower = _G.math.floor(tPower / 10000)
        -- "+为字体文件 万字"
        tPower = tPower .. "+"
    end
    return tPower
end

---是否显示提示框 true 显示
function SectionView:isShowTips(btn)
    local isShow = true
    if self.nowTipsShow ~= btn then
        self.nowTipsShow = btn
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_tipsbg, true)
    else
        self:ColseTips()
        isShow = false
    end

    if _G.AppSetting.DEBUG then
        _G.Log("isShowTips", "<color=red>" .. (isShow and "true" or "false") .. "</color>")
    end

    return isShow
end

---是否显示提示框 true 显示
function SectionView:ColseTips()
    if _G.AppSetting.DEBUG then
        _G.Log("ColseTips", "<color=red>" .. ">>>" .. "</color>")
    end
    ---重复点击 关闭
    -- local rect_obj = self.go_table.obj_tips:GetComponentE(typeof(CS.UnityEngine.RectTransform))

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_tipsbg, false)
    self.nowTipsShow = nil
end

--- 当前关卡历史星星  设置星星状态
function SectionView:setXXison(aorimage, isOn)
    aorimage.SpriteName = isOn and "StarLight" or "StarDark"
end
--- 当前关卡历史星星  设置星星状态
---@param str string 提示内容
---@param v3 UnityEngine.Vector3 目标坐标
function SectionView:ShowTips(str, v3)
    _G.coroutine.start(_G.handlerbind(self, self.CoOnProgress, str, v3))
end
function SectionView:CoOnProgress(str, v3)
    local rect_obj = self.go_table.obj_tips:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.go_table.aortext_tips.text = str
    local t_ContentSizeFitter = self.go_table.aortext_tips:GetComponentE(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    t_ContentSizeFitter:SetLayoutVertical()
    --防止 自适应宽高会闪一下
    _G.coroutine.waitforseconds(0.15)
    rect_obj:SetPosition(v3.x, v3.y, v3.z)
end

function SectionView:ShowRole(uid)
    if uid == nil then
        uid = 114200000
    end
    ---@type card_cfg
    local card_cfg = _G.ConfigManager.card_cfg[uid]
    if card_cfg == nil then
        return
    end
    self.go_table.aorrawimage_role.Alpha = 0

    self.go_table.aorrawimage_role:LoadImage(
        card_cfg.Portrait,
        function()
            self.go_table.aorrawimage_role:SetNativeSize()
            self.go_table.aorrawimage_role.rectTransform:SetLocalScaleXYZ(card_cfg.size2)
            local pos = Vector3.New()
            pos.x = (card_cfg.pos_portrait[1] or 0) + 450
            pos.y = card_cfg.pos_portrait[2] or 0
            pos.z = card_cfg.pos_portrait[3] or 0
            self.go_table.aorrawimage_role.rectTransform:SetLocalPosition(pos.x, pos.y, pos.z)
            -- body
            self.go_table.aortext_RoleName.text = GetLangPackValue(card_cfg.Name)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_nameBox, true)
            require("CardInfoManager"):GetInstance():RoleBreathe(self.go_table.aorrawimage_role)
        end
    )
end

