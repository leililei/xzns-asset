        _G.Log("OnClickBtn_item", "<color=red>" .. ">>>" .. "</color>")
    end
end

function SectionView:OnClickBtn_saodang(go, isOn)
end
function SectionView:OnClickBtn_tiaozhan(go, isOn)
    if self.challenge ~= nil then
        self.challenge()
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SectionView.Name)

    EmbattleController:GetInstance():OpenEmbattle(
        _G.EmbattleType.section,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.pve,
        function()
            self.back()
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SectionView.Name)
        end,
        function()
            local RoomID = nil
            if self.cfg ~= nil then
                RoomID = self.cfg.rooms[1][1]
            end
            self.battle(RoomID)
        end
    )
end

function SectionView:CloseView(go, isOn)
    local tWindow = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SelectSectionMapView.Name)
    if tWindow ~= nil then
        tWindow.View:OptSectionView(false)
    end

    self:Close()
end

---按钮点击事件在这里派发
function SectionView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
return SectionView
