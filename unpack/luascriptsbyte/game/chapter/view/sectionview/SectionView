---@class SectionView : UIBaseView	中文描述
---@field public go_table SectionView_GoTable GoTable
local SectionView = _G.BaseClass("SectionView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
function SectionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---推荐战斗力
    self.FightingPower_Text = self.go_table.obj_zl:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Text))

    ---按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        --界面关闭
        ["@_aorbtn_bgClose"] = self.CloseView,
        -- 扫荡
        ["@_aorbtn_saodang"] = self.OnClickBtn_saodang,
        --挑战
        ["@_aorbtn_tiaozhan"] = self.OnClickBtn_tiaozhan,
        -- 过关阵容
        ["@_aorbtn_guoguan"] = function(self, go)
        end,
        ["@_aorbtn_tipsbg"] = function(self, go)
            self:ColseTips()
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.LogError(go:GetName() .. " 未设置点击事件")
            end
        end
    }
end

function SectionView:OnCreate(challenge, back, enterBattle)
    self.challenge = challenge
    self.back = back
    self.battle = enterBattle
    self:SetInfo()
end

