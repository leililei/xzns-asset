        cfg = SectionCfg[ShowItemList[1]]
    end

    for i = 1, #tb.ShowItem do
        local item = tb.ShowItem[i]
        if not IsNumber(item) then
            item.gameObject:SetActiveE(0)
        end
    end

    local NowItems = cfg.reward_section
    for i = 1, #NowItems do
        local info = NowItems[i]

        if nil == tb.ShowItem[i] then
            tb.ShowItem[i] = 1
            _G.StorageManager:GetInstance():GetItemBaseView(
                info[1],
                info[2],
                tb.obj_ItemContent,
                function(item)
                    self:UpdateGetSectionAward(item, tb.index, i, tb)
                end
            )
        else
            local item = tb.ShowItem[i]
            if not IsNumber(item) then
                self:UpdateGetSectionAward(item, tb.index, i, tb)
            end
        end
    end
end

function SelectSectionMapNewView:UpdateGetSectionAward(item, index, i, tb)
    local cfg = SectionCfg[ShowItemList[index]]
    if (index <= 1) then
        cfg = SectionCfg[ShowItemList[1]]
    end
    tb.ShowItem[i] = item
    local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg(cfg.reward_section[i])
    item:UpdateData(item.gameObject, newdata)

    local isGet = ChapterModel:GetInstance():CheckIsGetSectionAward(cfg.id, i)
    item:SetGou(isGet)
    item.gameObject:SetLocalScaleXYZ(0.65)
    item.gameObject:SetActiveE(1)
    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

    local lockType
    ---放置>等级>任务
    local result, _lockType = ChapterModel:GetInstance():CheckSection(cfg.id)
    if _lockType == ConditionType.createRoleDay then
        lockType = LockType.day
    elseif _lockType == ConditionType.afk then
        lockType = LockType.Afk
    elseif _lockType == ConditionType.section then
        lockType = LockType.Section
    else
        lockType = LockType.None
    end

    if (lockType ~= LockType.None) then
        item:SetGouMask(true)
    else
        item:SetGouMask(false)
    end
    item:UpdateFunction(
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, cfg.reward_section[i][1])
        end
    )
end

function SelectSectionMapNewView:SetItemGray(tb, item)
    if (tb.lockType ~= LockType.None) then
        ---item:SetGou(true)
        ---local GouObj = {}
        local GouObj = item.go_table.transform:GetChildE(2)
        GouObj = nil
    end
end

function SelectSectionMapNewView:CareatItem(Sid, number, Parent, itemTable, isGou)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local data = {}
    data.sid = Sid
    _G.StorageManager:GetInstance():GetItemBaseView(
        Sid,
        number,
        Parent,
        function(item)
            item:SetGou(isGou)
            item.gameObject:SetLocalScaleXYZ(0.7)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            local effCfg, key = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)
            if item.go_table.EffTranDic == nil then
                item.go_table.EffTranDic = {}
            end
            local effTran = item.go_table.EffTranDic[key]
            if effTran == nil then
                self:TeXiaoShengCheng(item, effCfg, key)
            end
            table.insert(itemTable, item)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.sid)
        end
    )
end

function SelectSectionMapNewView:TeXiaoShengCheng(obj, effCfg, key)
    _G.UIUtils.LoadEffectByCfg(
        effCfg,
        obj.gameObject,
        function(trans)
            obj.go_table.EffTranDic[key] = trans
        end
    )
end

---按钮点击事件在这里派发
function SelectSectionMapNewView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        require "WorldUtils".UpdateWorldItemTip(300070001) ---更新鬼符三通头顶提示
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        if self.NowShowtb == nil then
            return
        end
        self:ShowItems(self.NowShowtb, false)
    elseif go == self.go_table.aorbtn_Pre then
        local chapterNum = self.CurChapterCfg.Order
        self:InitView(chapterNum - 1)
    elseif go == self.go_table.aorbtn_Next then
        self.go_table.looplist2_ChapterList:MovePanelToItemIndex(0)
        local chapterNum = self.CurChapterCfg.Order
        self:InitView(chapterNum + 1)
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 80)
    end
end

return SelectSectionMapNewView
