end

---初始化配置
function SelectSectionMapNewView:initCfg()
    self.CurChapterCfg = {}
    self.Cfgs = {}
    for k, v in pairs(ChapterCfg) do
        if v.ID ~= 300000000 and v.ID ~= 999999999 then
            if self.Cfgs.MaxOrder == nil then
                self.Cfgs.MaxOrder = v.ChapterNum
            else
                if self.Cfgs.MaxOrder < v.ChapterNum then
                    self.Cfgs.MaxOrder = v.ChapterNum
                end
            end
            self.Cfgs[v.ChapterNum] = {}
            self.Cfgs[v.ChapterNum].ID = v.ID
            self.Cfgs[v.ChapterNum].Section = v.Section
            self.Cfgs[v.ChapterNum].Order = v.ChapterNum
        end
    end
end

---当前章节是否有上一章和下一章
function SelectSectionMapNewView:CheckHasPreAndNextChapter()
    local pre = false
    local next = false
    local ChapterNum = self.CurChapterCfg.Order
    if ChapterNum - 1 > 0 and not _G.table.isEmptyOrNil(self.Cfgs[ChapterNum - 1].Section) then
        pre = true
    end
    if ChapterNum < self.Cfgs.MaxOrder and not _G.table.isEmptyOrNil(self.Cfgs[ChapterNum + 1].Section) then
        next = true
    end
    return pre, next
end

---@type ChapterNum number 章节num
function SelectSectionMapNewView:SetCurSections(ChapterNum)
    if not ChapterNum then
        self.CurChapterCfg.Section = self.curChapter.Section
        self.CurChapterCfg.ID = self.curChapter.ID
        self.CurChapterCfg.Order = self.curChapter.ChapterNum
        for i = 1, #self.CurChapterCfg.Section do
            if self.CurChapterCfg.Section[i] == self.curSection then
                self.index = i
            end
        end
    else
        self.CurChapterCfg = self.Cfgs[ChapterNum]
    end
end

---显示章节
---@param tb SelectSectionMapNewView._obj_chapter1_GoTable
---@param section main_section_cfg
function SelectSectionMapNewView:ShowChapter()
    self.ListCount = #self.CurChapterCfg.Section + 2
    self.MoveFunc = nil
    self.ChapterList = {}
    self.pre, self.next = self:CheckHasPreAndNextChapter()
    if self.pre or self.next then
        self.Scroll.onValueChanged:AddListener(_G.handlerbind(self, self.onValueChanged))
    end
    ---点击箭头默认位移到左边 next按钮默认隐藏 pre箭头根据状态设置
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Next, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Pre, self.pre)
    if not self.First then
        self.go_table.looplist2_ChapterList:InitListView(0, _G.handler(self, self.FreshList))
        self.First = true
    end
    if self.ChapterListCount ~= #self.CurChapterCfg.Section then
        self.go_table.looplist2_ChapterList:SetListItemCount(self.ListCount)
    else
        self.go_table.looplist2_ChapterList:RefreshAllShownItem()
    end
    self.ChapterListCount = #self.CurChapterCfg.Section
    if self.MoveFunc == nil then
        self.MoveFunc = true
    end
    _G.DelayFrameDo(
        function()
            if self.index and self.index > 3 then
                self.go_table.looplist2_ChapterList:MovePanelToItemIndex(self.index - 1)
            else
                self.go_table.looplist2_ChapterList:MovePanelToItemIndex(0)
            end
            self:MoveToNextByIndex()
        end
    )
end

---把点称动到对应接点
function SelectSectionMapNewView:MoveToNextByIndex(i)
    local canvasGroup
    if not i then
        i = 1
    else
        i = i + 1
    end
    local tb
    if self.ChapterList[i] then
        tb = self.ChapterList[i]
        if tb.gameObject:GetActiveSelf() == 0 then
            self:MoveToNextByIndex(i)
        else
            tb.obj_Root:SetLocalPosition(600, 0, 0)
            canvasGroup = tb.obj_Root:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
            canvasGroup.alpha = 0
            tb.obj_Root:SetActiveE(1)
            canvasGroup:DOFade(1, 1.1)
            tb.obj_Root:DOLocalMoveX(188, 0.09):SetEase(CS.DG.Tweening.Ease.OutExpo):OnComplete(
                function()
                    --tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator)).enabled = true
                    tb.obj_YueGuangEff:GetChildE(0):GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator)):Play(
                        "a_SelectSectionMapNewView_yueyashuaguang"
                    )
                    self:MoveToNextByIndex(i)
                end
            )
        end
    -- else
    --     return
    end
end

