        --- 根据按钮 设置坐标
        self.go_table.obj_ItemTips:SetPosition(x, y, z)
    end

    local cfg = SectionCfg[tb.section.id]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("SelectSectionMapNewView 未找到配置", tb.id))
        end
        return
    end
    self.NowShowtb = tb
    self.NowShowIndex = tb.index
    local NowItems = _G.DeepCopyCfgTable(cfg.reward_section)
    -- if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
