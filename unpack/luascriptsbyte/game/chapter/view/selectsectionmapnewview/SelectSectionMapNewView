function SelectSectionMapNewView:CheckLiHuiIsByCardPortrait(section_icon)
    local aorrawimage
    local pos
    local size
    if section_icon[1] == 1 then
        local cfg = _G.ConfigManager.card_cfg[section_icon[2]]
        aorrawimage = cfg.Portrait
        local pos1 = cfg.pos_portrait1
        pos = {pos1[1], pos1[2] + cardPosY, pos1[3]}
        size = cfg.size3
    else
        aorrawimage = ChapterPic[section_icon[2]][1]
        pos = ChapterPic[section_icon[2]][2]
        size = 1
    end
    return aorrawimage, pos, size
end

