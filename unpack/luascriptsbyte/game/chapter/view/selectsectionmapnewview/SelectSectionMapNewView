        self.itemTable[key] = nil
    end

    if tb.index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
        return
