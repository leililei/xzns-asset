---通关关卡后自动领取未领取的首通奖励
function SelectSectionMapNewView:AutoGetFisrtReward()
    for i = 1, #ShowItemList do
        local msc = _G.ConfigManager.main_section_cfg[ShowItemList[i]]
        local cur = 0
        local all = 0
        for j = 1, #msc.rooms do
            if self:CheckRoomDone(msc.rooms[j]) then
                cur = cur + 1
            end
            all = all + 1
        end

        local canGetNum = 0
        for k = 1, 4 do
            local isGet = ChapterModel:GetInstance():CheckIsGetSectionAward(ShowItemList[i], k)
            if not isGet then
                if cur / all >= k / 4 then
                    canGetNum = k
                end
            end
        end

        if canGetNum > 0 then
            ChapterModel:GetInstance():GetSectionAward(ShowItemList[i], canGetNum, nil)
        end
    end
end

function SelectSectionMapNewView:CheckRoomDone(id)
    local cfg = _G.ConfigManager.main_room_cfg[id]
    for i = 1, #cfg.battle_serial do
        if not require("ChapterModel"):GetInstance():CheckMonsterGroupFight(cfg.battle_serial[i]) then
            return false
        end
    end

    for i = 1, #cfg.task_id do
        if not _G.TaskModule:GetInstance().RoomFinishTask[cfg.task_id[i]] then
            return false
        end
    end

    local objectCfg
    for i = 1, #cfg.BoxID do
        objectCfg = _G.ConfigManager.object_world_cfg[cfg.BoxID[i]]
        if _G.tonumber(objectCfg.Type2) == 1 then --普通宝箱
            if not _G.WorldItemManager:GetInstance():GetInteractionBySid(cfg.BoxID[i]) then
                return false
            end
        end
    end
    return true
end

function SelectSectionMapNewView:FreshList(obj, index)
    if index < 0 then
        return
    end

    ---如果界面还没有检测自动领取首通奖励没有，就检测一次
    if (self.haveCheckedAutoAward == nil or self.haveCheckedAutoAward == false) then
        self:AutoGetFisrtReward()
        self.haveCheckedAutoAward = true
    end

    local item
    if index == 0 or index == self.ListCount - 1 then
        item = obj:NewListViewItem("$_obj_EmptySpace")
    else
        item = obj:NewListViewItem("$_obj_chapter")
        local x = index
        item:SetName(x)
        local cfg = SectionCfg[self.CurChapterCfg.Section[x]]
        local tb
        tb = _G.GetAutoGoTable(item)
        tb.obj_Root:SetActiveE(0)
        if self.MoveFunc == nil then
            self.ChapterList[x] = tb
        else
            tb.obj_Root:SetActiveE(1)
        end
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickChapter, tb))
        local aorrawimage, pos, size = self:CheckLiHuiIsByCardPortrait(cfg.section_icon)
        tb.aorrawimage = aorrawimage
        tb.pos = pos
        tb.size = size
        tb.index = x
        tb.section = cfg
        tb.isPassOrCurChallenge = ChapterModel:GetInstance():CheckSectionChanllenge(cfg.id)
        tb.isGet = ChapterModel:GetInstance():CheckIsGetSectionAward(cfg.id, 4)
        if (tb.ShowItem == nil) then
            tb.ShowItem = {}
        end
        self:ShowLock(tb, cfg, x)
        tb.aorrawimage_lihui:LoadImage(
            aorrawimage,
            function(trans)
                if not trans then
                    return
                end
                trans:SetNativeSize()
                local pos_portrait = _G.Vector3.New(pos[1] or 0, pos[2] or 0, pos[3] or 0)
                trans:SetLocalPosition(pos_portrait.x, pos_portrait.y, pos_portrait.z)
                local Portrait_size = size > 0 and size or 1
                trans.rectTransform:SetLocalScaleXYZ(Portrait_size)
                trans.Alpha = 1
            end
        )
        tb.aortext_Name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
        tb.aortext_Title.text = _G.LangUtil.GetLangPackValue(cfg.Tag)
        -- if (self.reListCount ~= index - 1) then
        --     self.ShowItemInitOver = true
        -- end
        --self.reListCount = index
        self:NewShowItems(tb)
    end

    return item
end

