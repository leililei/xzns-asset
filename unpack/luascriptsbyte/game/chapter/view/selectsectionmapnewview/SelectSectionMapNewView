function SelectSectionMapNewView:ClickLockBtn(tb)
    local data = tb.section
    if tb.lockType == LockType.None then
        if tb.section.Type1 == _G.ChapterItemType.Npc then
            ChapterModel:GetInstance():EnterStorySection(
                tb.section,
                function()
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SectionMapView.Name, tb.section.id, false)
        end
    elseif tb.lockType == LockType.Afk then
        local afkCfg = _G.ConfigManager.afk_cfg[data.Afk_Lock]
        if afkCfg then
            local str = string.format(_G.LangUtil.GetLangPackValue(90028010103), afkCfg.chapter, afkCfg.section)
            _G.PopWindowManager:GetInstance():ShowAllTips(280103, str)
            return
        end
    elseif tb.lockType == LockType.Section then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.PreOnLock)
    elseif tb.lockType == LockType.day then
        local content = _G.LangUtil.GetLangPackValue(90000010069, tb.section.Date_Lock)
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.DayLimit, content)
    end
end

