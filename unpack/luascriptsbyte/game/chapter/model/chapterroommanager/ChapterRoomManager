---获取卡牌基础数据(血量+怒气 百分比)
---@param uid number 卡牌uid
---@return number|number 血量百分比，怒气百分比
function ChapterRoomManager:GetCardBaseData(uid)
    local data = self.cardBaseData[uid] or {1, 1}
    return data[1], data[2]
end
local CardBaseDataRatioHP = 0.0001
local CardBaseDataRatioMP = 0.001
---设置卡牌基础数据
---@param data table 卡牌数据({uid,hp,mp})
---@param reset boolean 是否需要重置血量
function ChapterRoomManager:SetCardBaseData(data, reset)
    if data then
        for i = 1, #data do
            self.cardBaseData[data[i].uid] = {
                (data[i].hp or 0) * CardBaseDataRatioHP,
                (data[i].mp or 0) * CardBaseDataRatioMP
            }
        end
    end
    if not reset then
        return
    end
    local ids = {}
    local insert = _G.table.insert
    for id, value in pairs(self.cardBaseData) do
        if value[1] > 0 then
            insert(ids, id)
        end
    end
    for i = 1, #ids do
        self.cardBaseData[ids[i]] = nil
    end
end
---检测空房间是否进入过
---@param sid number 空房间
---@return boolean 是否进入过
function ChapterRoomManager:CheckEmptyRoomEnter(sid)
    if not self.enterEmptyRoom then
        return false
    end
    local enter = self.enterEmptyRoom[sid] or false
    if not enter then
        enter = self.rooms and self.rooms[sid] and self.rooms[sid]:CheckRoomEnter() or false
    end
    return enter
end
