-----计算所有房间的缓存资源路径
function ChapterRoomManager:CalculateAllRoomCacheRes()
    local playerSids = {}
    local WorldManagerIns = _G.WorldManager:GetInstance()
    for key, _ in pairs(self.rooms) do
        local cfg = _G.ConfigManager.main_room_cfg[key]
        if WorldManagerIns:CheckSceneSameRes(cfg.MapID) then
            local sids = self:CalculateBattleRole(cfg)
            for sid, num in pairs(sids) do
                if not playerSids[sid] then
                    playerSids[sid] = num
                elseif playerSids[sid] < num then
                    playerSids[sid] = num
                end
            end
        end
    end
    local effectRes = {}
    local playerRes = {}
    local sidArray = {}
    for sid, num in pairs(playerSids) do
        local monstercfg = _G.ConfigManager.monster_cfg[sid]
        if monstercfg == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError(" monster_cfg 未找到 id " .. sid)
            end
            return
        end
        ---@type card_cfg
        local cfg = _G.ConfigManager.card_cfg[monstercfg.CardID]
        if cfg == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError(" card_cfg 未找到 id " .. monstercfg.CardID)
            end
            return
        end
        if not playerRes[cfg.ModelPathLow] or playerRes[cfg.ModelPathLow] < num then
            playerRes[cfg.ModelPathLow] = num
        end
        _G.table.insert(sidArray, sid)
    end
    local effects = self:CalculateBattleEffect(sidArray)
    for path, _ in pairs(effects) do
        effectRes[path] = true
    end
    return playerRes, effectRes
end
-----计算战斗角色资源
function ChapterRoomManager:CalculateBattleRole(cfg)
    local playerSids = {}
    local cacheFunc = function(sids)
        for i = 1, #sids do
            if sids[i] > 0 then
                if not playerSids[sids[i]] then
                    playerSids[sids[i]] = 1
                else
                    playerSids[sids[i]] = playerSids[sids[i]] + 1
                end
            end
        end
    end
    for i = 1, #cfg.battle_serial do
        local sids = _G.BattleManager:GetInstance():GetDefaultDefenserSids(cfg.battle_serial[i])
        cacheFunc(sids)
        sids = _G.BattleManager:GetInstance():GetDefaultAttackSids(cfg.battle_serial[i])
        cacheFunc(sids)
    end
    return playerSids
end
-----计算战斗特效资源
---@param cardSids table 所有角色的sid组
function ChapterRoomManager:CalculateBattleEffect(cardSids)
    local path = _G.BattleManager:GetInstance():GetEffectPathBySid(cardSids)
    local res = {}
    for i = 0, path.Length - 1 do
        res[path[i]] = true
    end
    return res
end
function ChapterRoomManager:CacheRoom()
    if self.curRoomSid > 0 then
        local sid = _G.ConfigManager.main_room_cfg[self.curRoomSid].MapID
        if _G.WorldManager:GetInstance():CheckSceneSameRes(sid) then
            return false
        end
    end
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Default)
    coroutine.start(_G.handler(self, self.CoCacheRoomRes))
    return true
end
function ChapterRoomManager:CoCacheRoomRes()
    local playerRes, effectRes = self:CalculateAllRoomCacheRes()
    local count = 0
    local index = 0
    local loadDone = false
    local loadCallback = function()
        index = index + 1
        if index >= count then
            loadDone = true
        end
    end
    local PoolsManagerIns = _G.PoolsManager:GetInstance()
    if not _G.table.isEmptyOrNil(playerRes) then
        for path, num in pairs(playerRes) do
            count = count + num
            for i = 1, num do
                PoolsManagerIns:Preload(path, loadCallback, _G.ePoolType.World, nil, i)
            end
        end
    else
        loadCallback()
    end
    while not loadDone do
        _G.coroutine.waitforendofframe()
    end
    loadDone = false
    count = 0
    index = 0
    if not _G.table.isEmptyOrNil(effectRes) then
        for path, _ in pairs(effectRes) do
            count = count + 1
            PoolsManagerIns:Preload(path, loadCallback, _G.ePoolType.Default)
        end
    else
        loadCallback()
    end
    while not loadDone do
        _G.coroutine.waitforendofframe()
    end
    loadDone = false
    PoolsManagerIns:Preload(
        _G.ConfigManager.ui_cfg.BattleView.PrefabPath,
        function()
            loadDone = true
        end,
        _G.ePoolType.Default
    )
    while not loadDone do
        _G.coroutine.waitforendofframe()
    end
    _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    self.curRoomSid = self.joinRoomSid
    self:OnEnterWorldDone()
end
