---进入房间
---@param id number room id
---@param doorid number 传送门id
---@param immediately boolean 是否立即切换(不用镜头移动)
function ChapterRoomManager:EnterRoom(id, doorid, immediately)
    if not self.rooms[id] then
        return
    end
    self.changeRoomImmediately = immediately
    self.rooms[id]:CheckEnterRoom(_G.handlerbind(self, self.OnCheckEnterRoomCall, id, doorid))
end
---检测进入房间返回
---@param success boolean 是否进入成功
function ChapterRoomManager:OnCheckEnterRoomCall(success, sid, doorid)
    if not success then
        require "ChapterModel":GetInstance():SetBehavioralPriority(success)
        return
    end
    if self.curRoomSid > 0 then
        self.rooms[self.curRoomSid]:ExitRoom()
        if not _G.PlayerModel:GetInstance():CheckCreateRole() then
            local tb = _G.PlayerPrefsManager.GetTable(_G.LoginManager:GetInstance():GetCreatePlayerKey(), true)
            _G.table.insert(tb.empty_room, self.joinRoomSid)
            ---@type main_room_cfg
            local cfg = _G.ConfigManager.main_room_cfg[self.joinRoomSid]
            for _, v in pairs(cfg.event_id) do
                _G.table.insert(tb.event, v)
            end
            tb.cards = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.section)
            tb.last_room = sid
            _G.PlayerPrefsManager.SetTable(_G.LoginManager:GetInstance():GetCreatePlayerKey(), tb, true)
        end
    end
    self.joinRoomSid = sid
    self.changeRoomImmediately = nil
    self:DoBeforeRoomStory(self.joinRoomSid, _G.handlerbind(self, self.PlayChangeRoomEffect, doorid))
end
function ChapterRoomManager:PlayChangeRoomEffect(doorid)
    if self.curRoomSid > 0 and _G.WorldManager:GetInstance():CheckSceneSameRes(self.rooms[self.joinRoomSid].cfg.MapID) then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.FastLoadingView.Name,
            function()
                _G.WorldManager:GetInstance():EnterWorld(
                    self.rooms[self.joinRoomSid].cfg.MapID,
                    _G.handler(self, self.OnEnterWorldDone),
                    doorid,
                    nil,
                    self.curAllRoomSceneSid,
                    self.changeRoomImmediately
                )
            end
        )
    else
        _G.WorldManager:GetInstance():EnterWorld(
            self.rooms[self.joinRoomSid].cfg.MapID,
            _G.handler(self, self.OnEnterWorldDone),
            doorid,
            nil,
            self.curAllRoomSceneSid,
            self.changeRoomImmediately
        )
    end
end
---切换场景后回调
function ChapterRoomManager:OnEnterWorldDone()
    require "ChapterModel":GetInstance():SetBehavioralPriority(false)
    local cache = self:CacheRoom()
    if cache then
        return
    end
    self.curRoomSid = self.joinRoomSid
    if self.changeRoomImmediately then
        _G.WorldManager:GetInstance():HideLastScene()
    end
    self.rooms[self.curRoomSid]:EnterRoom()

    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        _G.ChapterRoomManager:GetInstance():TriggerRoomEnemyBattle(1, 707010119, _G.handler(self, self.OnBattleEnd))
    end
end
