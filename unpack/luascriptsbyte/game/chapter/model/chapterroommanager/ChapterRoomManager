---房间状态监测方法
local CheckRoomStateFunc = {
    [_G.MiniMapInfoType.npc] = function(cfg)
        --房间任务
        if #cfg.task_id > 0 then
            for i = 1, #cfg.task_id do
                if
                    not _G.GlobalConditionManager.CheckCondition(
                        _G.GlobalConditionManager.ConditionType.doneTask,
                        cfg.task_id[i]
                    )
                 then
                    return false
                end
            end
        end
        return true
    end,
    [_G.MiniMapInfoType.monster] = function(cfg)
        --敌人
        if cfg.battle_serial and #cfg.battle_serial > 0 then
            for i = 1, #cfg.battle_serial do
                if not _G.ChapterRoomManager:GetInstance():GetRoomEnemyBattle(cfg.battle_serial[i]) then
                    return false
                end
            end
        end
        return true
    end,
    [_G.MiniMapInfoType.box] = function(cfg)
        --宝箱
        local boxes = _G.WorldItemManager:GetInstance():GetItemSidsByType(_G.WorldItemType.Box, cfg.MapID)
        for i = 1, #boxes do
            if not _G.WorldItemManager:GetInstance():GetInteractionBySid(boxes[i]) then
                return false
            end
        end
        return true
    end
}

