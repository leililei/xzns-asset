--region 关卡奖励
---保存当前关卡战斗奖励
function ChapterRoomManager:SaveSectionAward(award)
    if award then
        for key, value in pairs(award) do
            if not self.curSectionAward[value[1]] then
                self.curSectionAward[value[1]] = {value[1], 0}
            end
            self.curSectionAward[value[1]][2] = self.curSectionAward[value[1]][2] + value[2]
        end
    end
end
----保存当前房间结算奖励
function ChapterRoomManager:SaveSettlementAward(award)
    self.curRoomSettlementAward = {}
    if award then
        for key, value in pairs(award) do
            _G.table.insert(self.curRoomSettlementAward, value)
        end
    end
end
