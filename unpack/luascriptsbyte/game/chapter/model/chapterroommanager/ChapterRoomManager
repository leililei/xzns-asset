--region --------------------------------------关卡房间任务--------

---是否为当前关卡重置的任务id
---@param sid number 房间sid
---@return boolean true 是重置的任务id
function ChapterRoomManager:CheckResetTaskid(taskid)
    if self.reset_tasks == nil then
        return false
    end
    local id =
        _G.table.find(
        self.reset_tasks,
        function(id)
            return id == taskid
        end
    )
    return id ~= nil
end

--endregion

--region 暂停界面相关
---手动退出关卡
function ChapterRoomManager:ExitSectionSelf(call)
    self:ExitSection()
    local instance = _G.PlayerModel:GetInstance()
    local function OnEnterCall()
        if call then
            call(
                function()
                    _G.DelayDo(
                        0.1,
                        function()
                            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
                        end
                    )
                end
            )
        else
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        end
    end
    if instance:CheckCreateRole() then
        _G.WorldManager:GetInstance():EnterWorld(instance:GetCurCitySid(), OnEnterCall)
    else
        require("PlayerNewCreateController"):GetInstance():CreatePlayer()
    end
end
--endregion

