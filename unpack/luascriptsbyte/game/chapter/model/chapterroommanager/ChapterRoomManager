---初始化关卡数据
---@param data table 关卡数据(已完成的事件，已打过的战斗,卡牌剩余血量/怒气百分比)
------@param data instance.s2c_instance_enter
function ChapterRoomManager:InitSectionData(data)
    self.joinRoomSid = data.last_room
    self.enemyBattlemMGDs = {}
    if data.pass then
        for i = 1, #data.pass do
            self.enemyBattlemMGDs[data.pass[i]] = true
        end
    end
    self.cardBaseData = {}
    if data.cards then
        self:SetCardBaseData(data.cards)
    end
    self.enterEmptyRoom = {}
    if data.empty_room then
        for i = 1, #data.empty_room do
            self.enterEmptyRoom[data.empty_room[i]] = true
        end
    end
    _G.EventManager:GetInstance():InitEventData(data.event)
    self.curSectionAward = {}
    self.curRoomSettlementAward = {}
    ---主线副本已重置任务sid
    self.reset_tasks = data.reset_tasks or {}

    --region -------------------------------------进入关卡设置任务--------
    local TaskModule = _G.TaskModule:GetInstance()
    local taskinfoArr = {}
    for i = 1, #self.reset_tasks do
        local taskid = self.reset_tasks[i]
        if TaskModule:IsCompletedTask(taskid) then
            TaskModule:DelCompletedTask(taskid)
            local taskinfo = TaskModule:GetTaskInfoWithID(taskid)
            if taskinfo ~= nil then
                table.insert(taskinfoArr, taskinfo)
            end
        end
    end
    if #taskinfoArr > 0 then
        TaskModule:RemoveTaskInfos(taskinfoArr)
    end

    --endregion-----------------------------------进入关卡设置任务--------

    self:SetisShowSectioninfo(false)
end
---初始化房间
function ChapterRoomManager:InitRoom()
    self.rooms = {}
    for i = 1, #self.sectionCfg.rooms do
        self.rooms[self.sectionCfg.rooms[i]] = ChapterRoomClass.New(self.sectionCfg.rooms[i])
    end
    self.curRoomSid = 0
    self.curAllRoomSceneSid = {}
    local cfg = nil
    for _, room in pairs(self.rooms) do
        _G.table.insert(self.curAllRoomSceneSid, room.cfg.MapID)
    end
end
---初始化跑图主控角色
function ChapterRoomManager:InitSceneRunPlayers()
    self.sceneRunPlayerSids = {}
    self:SetSceneRunPlayer(_G.PlayerModel:GetInstance():GetRoleSid(), _G.SceneRunPlayerWeight.city)
    if self.sectionCfg and self.sectionCfg.Operator > 0 then
        self:SetSceneRunPlayer(self.sectionCfg.Operator, _G.SceneRunPlayerWeight.storyBattle)
    end
end
