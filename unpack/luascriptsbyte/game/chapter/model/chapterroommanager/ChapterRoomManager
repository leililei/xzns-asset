-----进入关卡
---@param sectionSid number 关卡id
---@param exitCall function 退出回调
---@param joinRoomSid number 房间id
function ChapterRoomManager:JoinSection(sectionSid, exitCall, joinRoomSid)
    if not sectionSid or sectionSid <= 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("关卡id有错  id=" .. sectionSid and sectionSid or "nil", "ChapterRoomManager:JoinSection")
        end
        return
    end
    ---@type main_section_cfg
    self.sectionCfg = _G.ConfigManager.main_section_cfg[sectionSid]
    if not self.sectionCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到对应的main_section_cfg配置 sectionSid = " .. sectionSid, "ChapterRoomManager:JoinSection")
        end
        return
    end
    self.roomCount = #self.sectionCfg.rooms
    if self.roomCount <= 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("关卡配置房间数量为0 sectionSid = " .. sectionSid, "ChapterRoomManager:JoinSection")
        end
        self.roomCount = nil
        self.sectionCfg = nil
        return
    end
    self.exitSectionCall = exitCall
    if joinRoomSid and joinRoomSid > 0 then
        self.joinRoomSid = joinRoomSid
    else
        self.joinRoomSid = self.joinRoomSid and self.joinRoomSid ~= 0 and self.joinRoomSid or self.sectionCfg.rooms[1]
    end

    self:InitSceneRunPlayers()
    self:InitRoom()
    _G.MainManager:GetInstance():ShowFightStopIcon(_G.PlayerModel:GetInstance():CheckCreateRole())
    self:EnterRoom(self.joinRoomSid)
end
-----退出关卡
function ChapterRoomManager:ExitSection()
    ---@type EmbattleNewView
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    if ctrl then
        ctrl:QuitEmbattle()
    end
    if self.exitSectionCall then
        self.exitSectionCall()
        self.exitSectionCall = nil
    end
    if self.rooms then
        for i = 1, #self.rooms do
            self.rooms[i]:Dispose()
        end
    end
    self.rooms = nil
    self.sectionCfg = nil
    self.roomCount = nil
    self.curRoomSid = nil
    self.curSectionAward = nil
    self.curRoomSettlementAward = nil
    self.sceneRunPlayerSids = nil
    self.curAllRoomSceneSid = nil
    self.enemyBattlemMGDs = nil
    self.cardBaseData = nil
    self.curEnemyBoxAward = nil
    self.enterEmptyRoom = nil
    self.reset_tasks = nil
    -- if _G.PlayerModel:GetInstance():CheckCreateRole() then
    --     ChapterNet:GetInstance():AccessLeaveSection()
    -- end
    _G.EventManager:GetInstance():ClearEventData()
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Default)
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.World)
    _G.MainManager:GetInstance():ShowFightStopIcon(true)
    _G.StoryManager:GetInstance():StorySkipNoCall()
end
