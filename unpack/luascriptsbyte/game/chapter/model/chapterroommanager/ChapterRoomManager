--region 跑图角色相关
---设置跑图角色阵容
---@param sid number 跑图角色
---@param weight number 权重(值越大，优先取)
function ChapterRoomManager:SetSceneRunPlayer(sid, weight)
    self.sceneRunPlayerSids[weight] = sid
end
---获取跑图主控角色id
---@return number card_cfg的id
function ChapterRoomManager:GetSceneRunPlayer()
    local sid, weight
    if self.sceneRunPlayerSids then
        for key, value in pairs(self.sceneRunPlayerSids) do
            if weight == nil then
                sid = value
                weight = key
            else
                if weight < key then
                    weight = key
                    sid = value
                end
            end
        end
    end
    return sid
end
--endregion

--region 探索度相关
---获取房间探索状态
---@param id number 房间sid
---@return 变量类型 中文描述
function ChapterRoomManager:GetRoomExploreState(id)
    local cfg = _G.ConfigManager.main_room_cfg[id]
    local states = {}
    for i = 1, #cfg.Type2 do
        if CheckRoomStateFunc[cfg.Type2[i]] then
            states[cfg.Type2[i]] = CheckRoomStateFunc[cfg.Type2[i]](cfg)
        end
    end
    return states
end
---检测房间是否探索过
---@param sid number 房间sid
---@return boolean 是否探索
function ChapterRoomManager:CheckRoomDone(sid)
    if self.rooms then
        return self.rooms[sid]:CheckRoonExporeDone()
    else
        return false
    end
end
---检测房间是否进入过
---@param sid number 房间sid
---@return boolean 是否进入
function ChapterRoomManager:CheckRoomEnter(sid)
    if self.rooms then
        return self.rooms[sid]:CheckRoomEnter()
    else
        return false
    end
end

---获取当前挑战中的关卡id
---@return number _0没挑战
function ChapterRoomManager:GetNowFightScetion()
    local nowSectionID = 0
    if self.sectionCfg then
        nowSectionID = self.sectionCfg.id
    end
    return nowSectionID
end

