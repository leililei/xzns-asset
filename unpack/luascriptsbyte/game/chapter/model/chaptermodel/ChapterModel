------检测关卡是否解锁
---@param id number 关卡ID
---@return boolean 是否解锁
function ChapterModel:CheckSection(id)
    if id == 0 then
        return true
    end
    local config = _G.ConfigManager.main_section_cfg[id]
    if not config then
        return false
    end
    local CheckCondition = _G.GlobalConditionManager.CheckCondition
    local ConditionType = _G.GlobalConditionManager.ConditionType
    if config.Date_Lock and config.Date_Lock > 0 then --建号天数
        if not CheckCondition(ConditionType.createRoleDay, config.Date_Lock) then --建号天数
            return false, ConditionType.createRoleDay
        end
    end
    --放置解锁
    if config.Afk_Lock > 0 and CheckCondition(ConditionType.afk, config.Afk_Lock) == false then
        return false, ConditionType.afk
    end
    -- if config.LimitLevel > 0 then
    --     if not CheckCondition(ConditionType.playerLV, config.LimitLevel) then --玩家等级判定
    --         return false, ConditionType.playerLV
    --     end
    -- end
    -- if config.TaskCondition > 0 then
    --     return CheckCondition(ConditionType.acceptTask, config.TaskCondition), ConditionType.acceptTask --任务
    -- end
    if config.PreSection > 0 then
        if not CheckCondition(ConditionType.section, config.PreSection) then --前置关卡
            return false, ConditionType.section
        end
    end
    return true
end
