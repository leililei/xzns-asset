---房间宝箱监测方法
local CheckRoomBoxFunc = function(cfg)
    local count = #cfg.BoxID
    local NormalCount = 0
    local BattleCount = 0
    local NormalNum = 0
    local BattleNum = 0
    local objectCfg
    for i = 1, count do
        objectCfg = _G.ConfigManager.object_world_cfg[cfg.BoxID[i]]
        if _G.tonumber(objectCfg.ClickParams[1]) == 1 then --普通宝箱
            NormalCount = NormalCount + 1
            if _G.WorldItemManager:GetInstance():GetInteractionBySid(cfg.BoxID[i]) then
                NormalNum = NormalNum + 1
            end
        else --战斗宝箱
            BattleCount = BattleCount + 1
            if ChapterModel:GetInstance():CheckMonsterGroupFight(objectCfg.Params[1]) then
                BattleNum = BattleNum + 1
            end
        end
    end
    return NormalNum, NormalCount, BattleNum, BattleCount
