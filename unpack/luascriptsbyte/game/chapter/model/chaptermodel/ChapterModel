---获取房间详细探索数据
---@param id number 房间ID
---@param _type number 类型(main_room_cfg中Type2字段值)
---@return number,number 已探索数量/总数量
function ChapterModel:GetRoomExploreDetail(id, _type)
    local cfg = _G.ConfigManager.main_room_cfg[id]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("find main_room_cfg error id = " .. id, "ChapterModel:GetRoomExploreDetail")
        end
        return 0, 0
    end
    _type = _type or 0
    local num, count = 0, 0
    if _type == 0 then
        for key, value in pairs(CheckRoomStateFunc) do
            local n, c = value(cfg)
            num = num + n
            count = count + c
        end
    else
        _type = _type <= _G.MiniMapInfoType.battle and _G.MiniMapInfoType.boss or _type
        num, count = CheckRoomStateFunc[_type](cfg)
    end
    return num, count
end

