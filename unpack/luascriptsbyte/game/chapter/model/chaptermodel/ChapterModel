---进入关卡
function ChapterModel:EnterSection(call)
    local join, _type = self:CheckSection(self.curChooseSectionID)
    if not join then
        if call then
            call(join, _type)
        end
        return
    end
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        local function enter()
            ChapterNet:GetInstance():AccessEnterSection(
                self.curChooseSectionID,
                function(data)
                    if data.ack == 1 then
                        self.curSectionDoingSid = self.curChooseSectionID
                        self.curExploreSection = self.curChooseSectionID
                        _G.ChapterRoomManager:GetInstance():SetSectionData(data)
                        if call then
                            call(true)
                        end
                    else
                        _type = _G.GlobalConditionManager.ConditionType.acceptTask
                        if call then
                            call(false, _type)
                        end
                    end
                end
            )
        end
        if self.curExploreSection ~= 0 and self.curChooseSectionID ~= self.curExploreSection then
            self:ResetSection(self.curExploreSection, enter)
        else
            enter()
        end
    elseif call then
        _G.ChapterRoomManager:GetInstance():SetSectionData(
            {last_Room = 0, fight = {}, cards = {}, empty_room = {}, event = {}}
        )
        call(true)
    end
end
---进入剧情关卡
function ChapterModel:EnterStorySection(data, call)
    if not self:CheckSectionPass(data.id) then
        local msg = {}
        msg.sid = data.id
        ChapterNet:GetInstance():AccessStorySection(
            msg,
            function(data)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
            end
        )
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SelectSectionMapView.Name)

    _G.AutomaticPlayStory.PlayStoryByID(
        data.dialogue_before,
        function()
            self:SetSectionStar(data.id)
            if call then
                call()
            end
        end
    )
end
