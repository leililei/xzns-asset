function ChapterModel:GetSectionAwardCall(data, sid, index, callback)
    if data.ack ~= 1 then
        --LogError("获取首通奖励异常")
        return
    end
    if data.ack == 1 then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    end
    self.passSectionAward[sid] = {}
    for i = 1, index do
        self.passSectionAward[sid][i] = true
    end
    if (callback ~= nil) then
        callback()
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.StoryPage.id, sid)
end

