function ChapterModel:SetTotalExplore()
    local cfgs = _G.ConfigManager.main_chapter_cfg
    for _, v in pairs(cfgs) do
        if v.ID ~= 300000000 and v.ID ~= 999999999 then
            local count = #v.Section
            for i = 1, count do
                if self:CheckSection(v.Section[i]) then
                    if not self:CheckSectionPass(v.Section[i]) then
                        self.isShowChapterIconInMainView = true
                    end
                    local num, allNum = self:GetSectionExploreDetail(v.Section[i])
                    self.ExploreChapterInfo[v.Section[i]] = {}
                    self.ExploreChapterInfo[v.Section[i]].num = num
                    self.ExploreChapterInfo[v.Section[i]].count = allNum
                end
            end
        end
    end
end
function ChapterModel:SetSectionExplore(sid)
    if not self.ExploreChapterInfo[sid] then
        return
    end
    local num, allNum = self:GetSectionExploreDetail(sid)
    self.ExploreChapterInfo[sid].num = num
    self.ExploreChapterInfo[sid].count = allNum

    --region --------------------------------------任务广播 关卡探索度达到100%--------
    if num ~= 0 and num == allNum then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.Section.SectionExplore100,
                sid
            },
            1,
            false,
            true
        )
    end

    --endregion------------------------------------任务广播 关卡探索度达到100%--------
end
function ChapterModel:CheckChapterRedPoint()
    local checkfunc = function(param)
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(11) then
            return 0
        end
        if require "ChapterModel":GetInstance():CheckSection(param) then
            local num, count = require "ChapterModel":GetInstance():GetSectionExploreDetail(param)
            if num == count and require "ChapterModel":GetInstance():CheckIsGetSectionAward(param, 4) then
                return 0
            else
                return 1
            end
        else
            return 0
        end
    end
    local cfgs = _G.ConfigManager.main_chapter_cfg
    local num = 0
    for _, v in pairs(cfgs) do
        if v.ID ~= 300000000 and v.ID ~= 999999999 then
            local count = #v.Section
            for i = 1, count do
                num = num + checkfunc(v.Section[i])
            end
        end
    end
    if num > 0 then
        return true
    end
    return false
end
