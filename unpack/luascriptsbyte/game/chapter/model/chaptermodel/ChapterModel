---获取关卡所有奖励（宝箱，战斗，任务）
function ChapterModel:GetAllAward(sid)
    local cfg = _G.ConfigManager.main_section_cfg[sid]
    if not cfg then
        return nil
    end
    local award = {award = {}, got = {}}
    local function addDrop(list, dropID)
        if dropID <= 0 then
            return
        end
        local cfg = _G.ConfigManager.drop_cfg[dropID]
        if not cfg then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未找到奖励配置 id = " .. dropID)
            end
            return
        end
        for i = 1, #cfg.fixed_drop do
            _G.table.insert(list, {cfg.fixed_drop[i][1], cfg.fixed_drop[i][2]})
        end
    end
    local rCfg
    for i = 1, #cfg.rooms do
        rCfg = _G.ConfigManager.main_room_cfg[cfg.rooms[i]]
        self:HandleRoomBoxAward(rCfg, award, addDrop)
        self:HandleRoomEnemyAward(rCfg, award, addDrop)
        self:HandleRoomTaskAward(rCfg, award, addDrop)
    end
    return award
end
---获取探索、战斗奖励
function ChapterModel:GetExploreAndBattleAward(sid)
    local cfg = _G.ConfigManager.main_section_cfg[sid]
    if not cfg then
        return nil
    end
    local awardExplore = {award = {}, got = {}}
    local awardBattle = {award = {}, got = {}}
    local function addDrop(list, dropID)
        if dropID <= 0 then
            return
        end
        local cfg = _G.ConfigManager.drop_cfg[dropID]
        if not cfg then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未找到奖励配置 id = " .. dropID)
            end
            return
        end
        for i = 1, #cfg.fixed_drop do
            if cfg.fixed_drop[i][1] then
