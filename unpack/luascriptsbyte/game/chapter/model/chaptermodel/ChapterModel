function ChapterModel:GetRoomBoxDetail(id)
    local cfg = _G.ConfigManager.main_room_cfg[id]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("find main_room_cfg error id = " .. id, "ChapterModel:GetRoomBoxDetail")
