---初始化基础数据
function ChapterModel:InitBaseData()
    --默认关卡
    local defaultSectionID = _G.ConfigManager.discrete_cfg[defaultFirstSectionDiscreteSid][1][1]
    self.sections[defaultSectionID] = _G.SectionPassType.curSection
    self.curSectionSID = defaultSectionID
    --处理关卡列表
    local cfg = _G.ConfigManager.main_section_cfg
    local chapter
    for key, value in pairs(cfg) do
        if value.Chapter > 0 then
            chapter = _G.ConfigManager.main_chapter_cfg[value.Chapter]
            if chapter and chapter.is_formal then
                _G.table.insert(self.sectionPass, {sid = key, order = value.Section_order})
            end
        end
    end
    _G.table.sort(
        self.sectionPass,
        function(a, b)
            return a.order < b.order
        end
    )
    self.finalSectionSid = self.sectionPass[#self.sectionPass].sid
end
------解析服务器关卡数据
---@param data table 数据
function ChapterModel:ResolvChapterData(data)
    local sectionData = data.section_sid or {}
    local count
    for i = 1, #sectionData do
        self.sections[sectionData[i]] = 3
    end
    self:InitPassSectionAward(data.first_pass or {})
    self:InitExploreData(data)
    self:RefreshRedPoint()
end
---初始化首通奖励
function ChapterModel:InitPassSectionAward(data)
    self.passSectionAward = {}
    for _, info in pairs(data) do
        self.passSectionAward[info.k] = {}
        for i = 1, info.v do
            self.passSectionAward[info.k][i] = true
        end
    end
end
---计算当前挑战的关卡
function ChapterModel:CalculateCurSection()
    local index = 0
    for i = 1, #self.sectionPass do
        if
            self.sections[self.sectionPass[i].sid] and
                self.sections[self.sectionPass[i].sid] > _G.SectionPassType.curSection
         then
            index = index + 1
        else
            break
        end
    end
    for i = 1, index do
        _G.table.remove(self.sectionPass, 1)
    end
    if #self.sectionPass > 0 then
        self.curSectionSID = self.sectionPass[1].sid
    else
        self.curSectionSID = self.finalSectionSid
    end
    self.curChooseSectionID = self.curSectionSID
    self.curChooseChapterID = _G.ConfigManager.main_section_cfg[self.curSectionSID].Chapter
end
---解析探索相关数据
---@param data instance.s2c_instance_info 数据
function ChapterModel:InitExploreData(data)
    self.curExploreSection = data.sid
    self.battlemonsterGroupSids = {}
    if data.fight then
        for i = 1, #data.fight do
            self.battlemonsterGroupSids[data.fight[i]] = true
        end
    end
    -- self.taskAwardSids = {}
    -- if data.task then
    --     for i = 1, #data.task do
    --         self.taskAwardSids[data.task[i]] = true
    --     end
    -- end
    self.chapterAward = {}
    if data.chapter then --已领取章节奖励
        for i, value in pairs(data.chapter) do
            _G.table.insert(self.chapterAward, value.sid)
        end
    end
end
