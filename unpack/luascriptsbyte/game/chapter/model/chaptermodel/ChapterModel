---检测关卡是否通关
---@param id number 关卡id
---@return boolean 是否通关(true通关false未通关)
function ChapterModel:CheckSectionPass(id)
    if id == 0 then
        return true
    end
    return self.sections and self.sections[id] and self.sections[id] >= 0 or false
end
---检测关卡是否挑战过(已通关或者应当挑战的关卡)
---@param id number 关卡id
---@return boolean 是否挑战过(true通关false未通关)
function ChapterModel:CheckSectionChanllenge(id)
    local challenge = self:CheckSectionPass(id)
    if not challenge then
        challenge = id == self.curSectionSID
    end
    return challenge
end
------通关后设定的星级
---@param id number 关卡ID
function ChapterModel:SetSectionStar(id)
    self.sections[id] = 3
    self.curExploreSection = 0
    self:CalculateCurSection()

    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        ChapterNet:GetInstance():AccessResetSection(
            function()
                _G.TaskModule:GetInstance():ResetSectionRoomTask(id)
                _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {
                        _G.ActiveTaskEnum.ConditionEnum.Section.SectionPass,
                        id
                    },
                    --副本通关
                    --#次数#关卡id
                    1
                )
                _G.Events:GetInstance():Broadcast(
                    _G.eIllustrationsToUnlockEvent.Unlock,
                    {
                        id
                    }
                )
                _G.FunctionManager:GetInstance():DoFunctionAction(_G.FunctionTouchType.Section)
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StoryPage.id, id)
            end
        )
    else
        _G.TaskModule:GetInstance():ResetSectionRoomTask(id)
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.Section.SectionPass,
                id
            },
            --副本通关
            --#次数#关卡id
            1
        )
        _G.Events:GetInstance():Broadcast(
            _G.eIllustrationsToUnlockEvent.Unlock,
            {
                id
            }
        )
        _G.FunctionManager:GetInstance():DoFunctionAction(_G.FunctionTouchType.Section)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.StoryPage.id, id)
    end
end
---获取关卡详细探索数据
---@param id number 关卡ID
---@param _type number 类型(main_room_cfg中Type2字段值)
---@return number,number 已探索数量/总数量
function ChapterModel:GetSectionBoxDetail(id)
    local cfg = _G.ConfigManager.main_section_cfg[id]
    if not cfg then
        return 0, 0
    end
    local NormalNum, NormalCount, BattleNum, BattleCount = 0, 0, 0, 0
    for i = 1, #cfg.rooms do
        local n, nc, b, bc = self:GetRoomBoxDetail(cfg.rooms[i])
        NormalNum = NormalNum + n
        NormalCount = NormalCount + nc
        BattleNum = BattleNum + b
        BattleCount = BattleCount + bc
    end
    return NormalNum, NormalCount, BattleNum, BattleCount
end
