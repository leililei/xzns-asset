---处理房间宝箱奖励
---@param cfg main_room_cfg_Item 房间配置
---@param awardTable table 奖励Table
---@param addDrop function 添加奖励的方法
function ChapterModel:HandleRoomBoxAward(cfg, awardTable, addDrop)
    if not cfg.BoxID then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("房间配置无宝箱字段 房间sid = " .. cfg.id)
        end
        return
    end
    local boxType = 0
    local objectcfg
    local mgpID
    local mgpcfg
    for i = 1, #cfg.BoxID do
        objectcfg = _G.ConfigManager.object_world_cfg[cfg.BoxID[i]]
        if #objectcfg.ClickParams > 0 then
            boxType = _G.tonumber(objectcfg.ClickParams[1])
            if boxType == 0 then
                if _G.AppSetting.DEBUG then
                    _G.LogWarning("宝箱类型配置错误 sid = " .. cfg.BoxID[i], "ChapterModel:HandleRoomBoxAward")
                end
                break
            elseif boxType == 1 then --普通宝箱
                if _G.WorldItemManager:GetInstance():GetInteractionBySid(cfg.BoxID[i]) then
                    for j = 1, #objectcfg.Params do
                        addDrop(awardTable.got, objectcfg.Params[j])
                    end
                else
                    for j = 1, #objectcfg.Params do
                        addDrop(awardTable.award, objectcfg.Params[j])
                    end
                end
            end
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("宝箱未配置类型 sid = " .. cfg.BoxID[i], "ChapterModel:HandleRoomBoxAward")
            end
        end
    end
end
---处理房间敌人奖励
---@param cfg main_room_cfg_Item 房间配置
---@param awardTable table 奖励Table
---@param addDrop function 添加奖励的方法
function ChapterModel:HandleRoomEnemyAward(cfg, awardTable, addDrop)
    if not cfg.battle_serial then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("房间配置无battle_serial字段 房间sid = " .. cfg.id)
        end
        return
    end
    local mgpCfg
    for j = 1, #cfg.battle_serial do
        mgpCfg = _G.ConfigManager.monster_group_cfg[cfg.battle_serial[j]]
        if mgpCfg then
            if self:CheckMonsterGroupFight(cfg.battle_serial[j]) then
                for i = 1, #mgpCfg.Drop do
                    addDrop(awardTable.got, mgpCfg.Drop[i])
                end
            else
                for i = 1, #mgpCfg.Drop do
                    addDrop(awardTable.award, mgpCfg.Drop[i])
                end
            end
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未找到怪物组配置 id = " .. cfg.battle_serial[j] .. "  房间id = " .. cfg.id)
            end
        end
    end
end
---处理房间任务奖励
---@param cfg main_room_cfg_Item 房间配置
---@param awardTable table 奖励Table
function ChapterModel:HandleRoomTaskAward(cfg, awardTable)
    if not cfg.task_id then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("task_id 房间sid = " .. cfg.id)
        end
        return
    end
    local taskcfg
    for j = 1, #cfg.task_id do
        taskcfg = _G.ConfigManager.task_cfg[cfg.task_id[j]]
        if taskcfg then
            if
                _G.GlobalConditionManager.CheckCondition(
                    _G.GlobalConditionManager.ConditionType.doneTask,
                    cfg.task_id[j]
                )
             then
                for k = 1, #taskcfg.award do
                    table.insert(awardTable.got, taskcfg.award[k][1])
                end
            else
                for k = 1, #taskcfg.award do
                    table.insert(awardTable.award, taskcfg.award[k][1])
                end
            end
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未找到任务配置 任务id = " .. cfg.task_id[j] .. "     房间id = " .. cfg.id)
            end
        end
    end
end
