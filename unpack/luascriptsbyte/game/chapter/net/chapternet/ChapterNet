---@class ChapterNet : BaseGameNet	通信协议
local ChapterNet = _G.BaseClass("ChapterNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return ChapterNet ChapterNet
function ChapterNet:GetInstance()
    return self.super.super.GetInstance(self)
end
---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function ChapterNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ChapterNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---打开宝箱请求
---@param pbData table 关卡sid
---@param callback function 完成回调
function ChapterNet:AccessOpenBox(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_instance_box, pbData, callback)
end

---解锁门请求
---@param pbData table 关卡sid
---@param callback function 完成回调
function ChapterNet:AccessUnlockDoor(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_instance_door, pbData, callback)
end

---进入关卡（怪物）请求
---@param pbData table 关卡sid
---@param callback function 完成回调
function ChapterNet:AccessEnterSection(sid, callback)
    self:Access(_G.ConfigManager.net_map.game_instance_enter, {sid = sid}, callback)
end

