    self.activityBtnsInfoTab = {}
    self.activityBtnsHideTb = {}
    self.onClickBtnHandler = _G.handler(self, self.OnBtnClickBtn)
    self.onClickPageHandler = _G.handler(self, self.OnPageBtnClick)
    self.initRedTag = true
    ---从福利页面移出的活动，不需要绑定红点
    self.ignorePage = {
        [1012201] = true, --灵脉战令，移至日常
        [1010801] = true, --累计招募，移至普通招募
        [1011101] = true, --登临基金，移至整合基金
        [1011001] = true, --成长基金，移至整合基金
        [1013302] = true,  --大秘境基金，移至整合基金
        [1012101] = true, --决斗战令，移至整合基金
        [1012001] = true, --深渊战令，移至整合基金
        [1013501] = true,  --公会基金，移至整合基金
        [1013601] = true,  --建筑基金，移至整合基金
        [1014001] = true,  --奇物基金，移至整合基金
        [1013901] = true,  --战利品基金，移至整合基金
        [1014101] = true  --女仆基金，移至整合基金
    }
    ---入口移到其它父节点的红点id
    self.pageParentRedId = {
        [1012201] = 1021, --灵脉战令，移至日常 1021
        [1010801] = 1030, --累计招募，移至普通招募 1030
        [1011101] = 1243, --登临基金，移至整合基金 1243
        [1011001] = 1243, --成长基金，移至整合基金 1243
        [1013302] = 1243,  --大秘境基金，移至整合基金 1243
        [1012101] = 1243, --决斗战令，移至整合基金 1243
        [1012001] = 1243, --深渊战令，移至整合基金 1243
        [1013501] = 1243,  --公会基金，移至整合基金 1243
        [1013601] = 1243, --建筑战令，移至整合基金 1243
        [1013901] = 1243, --战利品基金，移至整合基金 1243
        [1014001] = 1243, --奇物基金，移至整合基金 1243
