--[[
    活动入口分两类
    1.主界面独立按钮
    2.活动界面内的页签
]]
local enterBtnType = {
    btn = 1,
    page = 2
}

---@class ActivitySynEnterManager : Singleton	中文描述
local ActivitySynEnterManager = _G.BaseClass("ActivitySynEnterManager", _G.Singleton)

---@return ActivitySynEnterManager ActivitySynEnterManager
function ActivitySynEnterManager:GetInstance()
    return _G.Singleton.GetInstance(self)
end

---创建对象时,入口构造函数
function ActivitySynEnterManager:__init()
