---销毁对象时,析构函数
function ActivitySynEnterManager:Dispose()
    self.activityBtnsInfoTab = nil
    self.activityPagesInfoTab = nil
    self.onClickBtnHandler = nil
    self.onClickPageHandler = nil
    self.activityBtnsHideTb = nil
end

--region 内部方法
---活动单独按钮点击回调方法
---@param tag string 按钮标签(活动ID)
function ActivitySynEnterManager:OnBtnClickBtn(tag)
    tag = _G.tonumber(tag)
    local cls = self.activityBtnsInfoTab[tag]
    if cls then
        cls:EnterActivity()
    end
end

---配置活动界面按钮点击回调方法
---@param tag string 界面名字
function ActivitySynEnterManager:OnPageBtnClick(tag)
    _G.UIManager:GetInstance():OpenWindow(tag, self.activityPagesInfoTab[tag])
end

---跳转使用
---@param tag string 界面名字
function ActivitySynEnterManager:JumpActivity(tag, index, activityID, isSingle, onlyClose)
    _G.UIManager:GetInstance():OpenWindow(tag, self.activityPagesInfoTab[tag], index, activityID, isSingle, onlyClose)
end

--region 红点
---初始化单个活动红点
---@param activity ActivitySynBase 活动对象
---@param RedPointManagerIns RedPointManager 红点管理类实例
---@param isEmptyOrNil function table.isEmptyOrNil
function ActivitySynEnterManager:InitSingleActivityRedPoint(activity, RedPointManagerIns, isEmptyOrNil)
    RedPointManagerIns = RedPointManagerIns or require("RedPointManager"):GetInstance()
    isEmptyOrNil = isEmptyOrNil or _G.table.isEmptyOrNil
    local activityType = activity:GetActivityTypeCls()
    local redpoint = activityType:GetRedPointTree()
    if not isEmptyOrNil(redpoint) then
        for i = 1, #redpoint do
            if redpoint[i] then
                local child = {}
                for k = 1, #redpoint[i] do
                    child[#child + 1] = { redpoint[i][k], "RedPointItemActivitySyn" }
                end
                RedPointManagerIns:AddRedPointSyn(
                    activityType:GetRedpointIDByIndex(i),
                    "RedPointItemActivitySyn",
                    child,
                    0,
                    false,
                    activity:GetActivityID()
                )
            else
                RedPointManagerIns:AddRedPointSyn(
                    activityType:GetRedpointIDByIndex(i),
                    "RedPointItemActivitySyn",
                    nil,
                    0,
                    false,
                    activity:GetActivityID()
                )
            end
        end
    end
end

---移除活动红点
---@param activity ActivitySynBase 活动对象
---@param RedPointManagerIns RedPointManager 红点管理类实例
---@param isEmptyOrNil function table.isEmptyOrNil
function ActivitySynEnterManager:RemoveSingleActivityRedPoint(activity, RedPointManagerIns, isEmptyOrNil)
    RedPointManagerIns = RedPointManagerIns or require("RedPointManager"):GetInstance()
    isEmptyOrNil = isEmptyOrNil or _G.table.isEmptyOrNil
    local activityType = activity:GetActivityTypeCls()
    local redpoint = activityType:GetRedPointTree()
    if not isEmptyOrNil(redpoint) then
        for i = 1, #redpoint do
            RedPointManagerIns:RemoveRedPointSyn(activityType:GetRedpointIDByIndex(i))
        end
    end
end

--endregion

--endregion

--region 对外接口
---添加一个活动按钮
---@param cls ActivitySynBase 活动对象
function ActivitySynEnterManager:AddActivityBtn(cls)
    -- if (cls.activityID == 1011601) then
    --     local activityID = cls:GetActivityID()
    --     self:InitSingleActivityRedPoint(cls)
    --     self.activityBtnsInfoTab[activityID] = cls
    -- end
    --英雄礼包转到了商城，这个临时处理下
    local typeid = cls:GetTypeId()
    if typeid and typeid == 10022 then
        return
    end
    local activityID = cls:GetActivityID()
    self:InitSingleActivityRedPoint(cls)
    if not cls:GetActivityTypeCls():IsShowBtn() then
        if not self.initRedTag then
            require "ActivitySynManager":GetInstance():AddSubActivityRedPoint(cls:GetActivityTypeCls())
        end
        self.activityBtnsHideTb[activityID] = cls
        return
    end
    local t, p1, p2, isBanner, p3 = cls:GetShowBtnType()
    if t == enterBtnType.btn then --独立按钮
        if not self.activityBtnsInfoTab[activityID] then
            local icon, name = cls:GetShowBtnInfo()
            _G.MainManager:GetInstance():AddActivitySynBtn(
                _G.tostring(activityID),
                icon,
                self.onClickBtnHandler,
                p1,
                p2,
                name,
                nil,
                cls:GetActivityTypeCls():GetRedpointIDByIndex(1),
                nil,
                isBanner,
                p3,
                typeid
            )
            self.activityBtnsInfoTab[activityID] = cls
        end
    else --页签
        local cfg = _G.ConfigManager.activity_position_cfg[p1]
        if not cfg then
            return
        end
        local page = self.activityPagesInfoTab[cfg.views]
        local id = cls:GetActivityTypeCls():GetRedpointIDByIndex(1)
        if not page then
            page = { cls, id = p1 }
            self.activityPagesInfoTab[cfg.views] = page
            if id then
                if not self.initRedTag and cfg.redpoint_id > 0 then
                    if not self.ignorePage[activityID] then
                        local redpoint = require("RedPointManager"):GetInstance():GetRedpointItem(cfg.redpoint_id)
                        if redpoint and not redpoint:GetParent() then
                            require("RedPointManager"):GetInstance():AddRedPointSyn(
                                cfg.redpoint_id,
                                nil,
                                { { id, "RedPointItemActivitySyn" } }
                            )
                        elseif not redpoint then
                            --添加活动界面的红点
                            require("RedPointManager"):GetInstance():AddRedPointSyn(cfg.redpoint_id, nil,
                                { { id, "RedPointItemActivitySyn" } })
                        end
                    elseif self.pageParentRedId[activityID] then
                        require("RedPointManager"):GetInstance():AddRedPointSyn(self.pageParentRedId[activityID], nil,
                            { { id, "RedPointItemActivitySyn" } })
                    end
                end
            end
            _G.MainManager:GetInstance():AddActivitySynBtn(
                cfg.views,
                cfg.icon,
                self.onClickPageHandler,
                cfg.position,
                cfg.display_order,
                nil,
                nil,
                cfg.redpoint_id,
                nil,
                isBanner
            )
        else
            for i = 1, #page do
                if page[i]:GetActivityID() == activityID then
                    return
                end
            end
            page[#page + 1] = cls
            if id then
                if not self.initRedTag and cfg.redpoint_id > 0 then
                    if not self.ignorePage[activityID] then
                        local redpoint = require("RedPointManager"):GetInstance():GetRedpointItem(cfg.redpoint_id)
                        if redpoint and not redpoint:GetParent() then
                            require("RedPointManager"):GetInstance():AddRedPointChild(
                                cfg.redpoint_id,
                                id
                            )
                        elseif not redpoint then
                            --添加活动界面的红点
                            require("RedPointManager"):GetInstance():AddRedPointSyn(cfg.redpoint_id, nil,
                                { { id, "RedPointItemActivitySyn" } })
                        end
                    elseif self.pageParentRedId[activityID] then
                        require("RedPointManager"):GetInstance():AddRedPointChild(self.pageParentRedId[activityID], id)
                    end
                end
            end
        end
    end
end

---移除一个活动按钮
function ActivitySynEnterManager:RemoveActivityBtn(cls)
    ---由于龙棋降世从活动入口改到了主界面入口，所以在移除活动按钮的时候会报错
    ---因此如果结束的活动是龙棋降世就跳过，但是活动id就不能改了
    -- if (cls.activityID == 1011601) then
    --     return
    -- end
    --英雄礼包转到了商城，这个临时处理下
    local typeid = cls:GetTypeId()
    if typeid and typeid == 10022 then
        return
    end
    self:RemoveSingleActivityRedPoint(cls)
    local t, p1, p2, isBanner, p3 = cls:GetShowBtnType()
    if self.activityBtnsHideTb[cls:GetActivityID()] then
        self.activityBtnsHideTb[cls:GetActivityID()] = nil
        return
    end
    if t == enterBtnType.btn then --独立按钮
        _G.MainManager:GetInstance():RemoveActivitySynBtn(_G.tostring(cls:GetActivityID()), p1, p2, isBanner, p3)
        self.activityBtnsInfoTab[cls:GetActivityID()] = nil
    else --页签
        local cfg = _G.ConfigManager.activity_position_cfg[p1]
        if not cfg then
            return
        end
        local page = self.activityPagesInfoTab[cfg.views]
        if page then
            for i = 1, #page do
                if page[i]:GetActivityID() == cls:GetActivityID() then
                    _G.table.remove(page, i)
                    break
                end
            end
            if #page == 0 then
                self.activityPagesInfoTab[cfg.views] = nil
                page[#page + 1] = cls
                _G.MainManager:GetInstance():RemoveActivitySynBtn(cfg.views, cfg.position, cfg.display_order, isBanner)
                if _G.UIManager:GetInstance():IsActiveWindow(cfg.views) then
                    _G.UIManager:GetInstance():CloseWindow(cfg.views)
                end
                if not self.initRedTag and cfg.redpoint_id > 0 then
                    require("RedPointManager"):GetInstance():RemoveRedPointSyn(cfg.redpoint_id)
                end
            else
                if not self.initRedTag and cfg.redpoint_id > 0 then
                    if not self.pageParentRedId[cls:GetActivityID()] then
                        require("RedPointManager"):GetInstance():RemoveRedPointChild(
                            cfg.redpoint_id,
                            cls:GetActivityTypeCls():GetRedpointIDByIndex(1)
                        )
                    else
                        require("RedPointManager"):GetInstance():RemoveRedPointChild(
                            self.pageParentRedId[cls:GetActivityID()],
                            cls:GetActivityTypeCls():GetRedpointIDByIndex(1)
                        )
                    end
                end
            end
        end
    end
end

---初始化红点
function ActivitySynEnterManager:InitRedPoint()
    local redpoint, activityType
    local isEmptyOrNil = _G.table.isEmptyOrNil
    local RedPointManagerIns = require("RedPointManager"):GetInstance()
    local ActivitySynManager = require "ActivitySynManager":GetInstance()
    for _, activity in pairs(self.activityBtnsInfoTab) do --初始化独立按钮红点
        self:InitSingleActivityRedPoint(activity, RedPointManagerIns, isEmptyOrNil)
        ActivitySynManager:AddSubActivityRedPoint(activity:GetActivityTypeCls())
        local sub_type = activity:GetActivityTypeCls().curActivityClass:GetJumpType()
        if sub_type == _G.ActivitySubType.Spiritual then
            RedPointManagerIns:AddRedPointChild(
                activity:GetActivityTypeCls():GetRedpointIDByIndex(1),
                1234
            )
        elseif sub_type == _G.ActivitySubType.Pet then
            RedPointManagerIns:AddRedPointChild(
                activity:GetActivityTypeCls():GetRedpointIDByIndex(1),
                _G.ConfigManager.redpoint_cfg.PetDrawGift.id
            )
        end
    end
    for _, activity in pairs(self.activityBtnsHideTb) do ---显示在某个功能里的活动
        self:InitSingleActivityRedPoint(activity, RedPointManagerIns, isEmptyOrNil)
        ActivitySynManager:AddSubActivityRedPoint(activity:GetActivityTypeCls())
    end
    local id
    local positionCfg = _G.ConfigManager.activity_position_cfg
    --TODO:初始化页签活动红点
    for _, page in pairs(self.activityPagesInfoTab) do
        local child
        for i = 1, #page do
            self:InitSingleActivityRedPoint(page[i], RedPointManagerIns, isEmptyOrNil)
            id = page[i]:GetActivityTypeCls():GetRedpointIDByIndex(1)
            if id then
                if not self.ignorePage[page[i].activityID] then ---
                    if not child then
                        child = { { id, "RedPointItemActivitySyn" } }
                    else
                        child[#child + 1] = { id, "RedPointItemActivitySyn" }
                    end
                elseif self.pageParentRedId[page[i].activityID] then
                    RedPointManagerIns:AddRedPointChild(self.pageParentRedId[page[i].activityID], id)
                end
            end
        end
        --TODO:添加活动界面和页签的红点
        if positionCfg[page.id].redpoint_id > 0 then
            RedPointManagerIns:AddRedPointSyn(positionCfg[page.id].redpoint_id, nil, child)
        end
    end
    self.initRedTag = nil
end

--endregion
return ActivitySynEnterManager
