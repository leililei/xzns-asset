-- endregion
function ActivitySynTypeBase.Create(id, activity)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogError("参数传入错误 id=nil")
        end
        return nil
    end
    local name = ActivitySynTypeClass[id]
    if name then
        return require(name).New(activity)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未定义玩法类型 id = " .. id)
        end
        return nil
    end
end

-- endregion

return ActivitySynTypeBase
