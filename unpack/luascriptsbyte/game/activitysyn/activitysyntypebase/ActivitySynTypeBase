-- region 红点
---根据定义的红点序列获取红点ID(活动id*100+index)
---@param index number 红点类型序列号
---@return number 红点ID
function ActivitySynTypeBase:GetRedpointIDByIndex(index)
    if self.redpointTree and self.redpointTree[index] ~= nil then
        return self.curActivityClass:GetActivityID() * 100 + index
    end
    return nil
end

---获取红点树结构
---@return table 结构数组
function ActivitySynTypeBase:GetRedPointTree()
    return self.redpointTree
end

---获取红点参数
---@param index number 红点类型序列号
---@return table 红点参数
function ActivitySynTypeBase:GetRedPointParams(index)
    return self:GetRedPointParamsChild(index)
end

---检测红点
---@param id number 红点ID
---@param param number 红点参数
---@return number 红点数量
function ActivitySynTypeBase:CheckRedPointNum(id, param)
    local index = id % 100
    return self:CheckRedPointNumChild(index, param)
end

---是否显示按钮(用于功能作为某一界面中的功能使用，建议将该功能设置为独立按钮)
function ActivitySynTypeBase:IsShowBtn()
    local _, _, _, _, pos = self.curActivityClass:GetShowBtnType()
    return pos ~= -1
end

---属于福利界面的活动是否在福利界面显示,不属于福利活动则不生效
function ActivitySynTypeBase:IsShowInFuliView()
    return true
end

