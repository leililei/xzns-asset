---进入活动
---@param doneCall function 进入完成后回调
---@param exitCall function 退出活动回调(手动退出)
function ActivitySynTypeBase:EnterActivity(doneCall, exitCall)
    self.onEnterDoneCall = doneCall
    self.onExitCall = exitCall
    self:OnEnterActivity()
end

---退出活动
function ActivitySynTypeBase:ExitActivity()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end

