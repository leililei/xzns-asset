---@class ActivitySynTypeBase    中文描述
---@field cfg activity.i_activity
---@field curActivityClass ActivitySynGMActivity
local ActivitySynTypeBase = _G.BaseClass("ActivitySynTypeBase", _G.LogicClass)

---类的构造函数
---@param activity ActivitySynBase
function ActivitySynTypeBase:__init(activity)
    self.curActivityClass = activity
    self:InitRedPointTree()
    if self.redpointTree then
        local isEmptyOrNil = _G.table.isEmptyOrNil
        for i = 1, #self.redpointTree do
            if self.redpointTree[i] and not isEmptyOrNil(self.redpointTree[i]) then
                for k = 1, #self.redpointTree[i] do
                    self.redpointTree[i][k] = self:GetRedpointIDByIndex(self.redpointTree[i][k])
                end
            end
        end
    end
end

---类的析构函数
function ActivitySynTypeBase:Dispose()
    self.curActivityClass = nil
    self.OnSixUpdateTag = nil
    self.endCallback = nil
    self.redpointTree = nil
    self.onExitCall = nil
end

-- region 子类重写
function ActivitySynTypeBase:GetDataFormServer()
    if _G.AppSetting.DEBUG then
        _G.LogWarning("子类没有重写GetDataFormServer方法 name = " .. self.__cname)
    end
    self:ParseData()
end

---解析数据
---@param data table 服务器返回数据
function ActivitySynTypeBase:ParseData(data)
    self:InitFunction()
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    self.endCallback = nil
    self.OnSixUpdateTag = nil
end

---重连成功调用
---@param endcall function 完成回调
function ActivitySynTypeBase:ReConnect(endcall)
    if endcall ~= nil then
        endcall(self.__cname)
    end
end

