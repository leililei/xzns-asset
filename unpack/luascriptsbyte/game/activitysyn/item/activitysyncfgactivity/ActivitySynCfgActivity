local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynBase"
---@class ActivitySynCfgActivity	中文描述
local ActivitySynCfgActivity = _G.BaseClass("ActivitySynCfgActivity", base)

---类的构造函数
function ActivitySynCfgActivity:__init()
    self:CreateActivityTypeCls(self.cfg.type_activity)
end

---类的析构函数
function ActivitySynCfgActivity:Dispose()
end
---获取活动类型id
function ActivitySynCfgActivity:GetTypeId()
    return self.cfg.type_activity
end
function ActivitySynCfgActivity:GetMainType()
    return nil
end
---获取活动类型(配置活动/GM活动)
---@return  ActivitySynManager.ActivityType 活动类型
function ActivitySynCfgActivity:GetActivityType()
    return ActivitySynManager.ActivityType.cfg
end

---初始化数据
---@param call function 完成回调
function ActivitySynCfgActivity:InitData(call)
    self.typeClass:InitData(call)
end

---检测进入额外条件是否满足
---@return boolean 是否满足进入条件
function ActivitySynCfgActivity:CheckConditionExtra()
    return _G.GlobalConditionManager.CheckConditionArrays(self.cfg.condition_extra)
end

---获取领取奖励之后是否隐藏活动
---@return boolean 是否隐藏
function ActivitySynCfgActivity:GetHideViewByAward()
    return self.cfg.is_reveal == 1
end
---获取按钮展示类型|参数
---@return number|number|any 活动按钮展示类型|参数
function ActivitySynCfgActivity:GetShowBtnType()
    return self.cfg.position[1], self.cfg.position[2], self.cfg.position[3], self.cfg.position[4], self.cfg.position[5]
end
---获取活动按钮展示信息
---@return string|string 图标icon | 活动名称
function ActivitySynCfgActivity:GetShowBtnInfo()
    return self.cfg.icon, _G.LangUtil.GetLangPackValue(self.cfg.name), self.cfg.icon2
end

---得到对应活动倒计时 前端显示使用 与数据逻辑无关 超过对应条件的时间返回0
---@param _condition ActivitySynManager.ActivitySynState
function ActivitySynCfgActivity:GetActivityDeadLineByCondition(_condition)
    local TimeUtil = _G.TimeUtil
    local t = TimeUtil.GetServerUnixTime()
    local UICountDown = self.cfg
    local noticeTime = 0
    if UICountDown.time_type == 1 then --物理时间(绝对时间戳)
        noticeTime = TimeUtil.TranslateTimeForStamp(UICountDown.time_open) - UICountDown.show_time
    elseif UICountDown.time_type == 2 then ---服务器相对时间
        noticeTime = _G.PlayerModel:GetInstance():GetServerOpenTime() + UICountDown.time_open[1] - UICountDown.show_time
    end
    local times = UICountDown.time_interval == 0 and 1 or (UICountDown.num_cycle > 1 and UICountDown.num_cycle or 1)
    local lastNoticeTime = noticeTime
    for i = 1, times do
        noticeTime = noticeTime + UICountDown.show_time
        if _condition == ActivitySynManager.State.Open then
            if times == 1 and t >= noticeTime then
                return lastNoticeTime + UICountDown.show_time, t - noticeTime
            elseif t < noticeTime then
                --这里是距离开始过了多久，而不是距离开始还要多久
                return lastNoticeTime + UICountDown.show_time, noticeTime - t
            end
        end
        lastNoticeTime = noticeTime
        noticeTime = noticeTime + UICountDown.time_duration
        if _condition == ActivitySynManager.State.Settlement and t < noticeTime then
            return noticeTime, noticeTime - t
        end
        noticeTime = noticeTime + UICountDown.end_time
        if _condition == ActivitySynManager.State.Close and t < noticeTime then
            return noticeTime, noticeTime - t
        end
        noticeTime = noticeTime + UICountDown.time_interval
    end
    return noticeTime, 0
end
return ActivitySynCfgActivity
