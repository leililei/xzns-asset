local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynBase"
---@class ActivitySynGMActivity	: ActivitySynBase
---@field cfg activity.i_activity
local ActivitySynGMActivity = _G.BaseClass("ActivitySynGMActivity", base)
---类的构造函数
function ActivitySynGMActivity:__init(_, _, _, _, realActivityId)
    self.realActivityId = realActivityId
    self:CreateActivityTypeCls(self.cfg.info.type)
    self.typeClass:HandleGMData(self.cfg.self_info)
end

---类的析构函数
function ActivitySynGMActivity:Dispose()
end
---获取活动类型id
function ActivitySynGMActivity:GetTypeId()
    return self.cfg.info.type
end
-- region 重写父类方法
---获取活动类型(配置活动/GM活动)
---@return  ActivitySynManager.ActivityType 活动类型
function ActivitySynGMActivity:GetActivityType()
    return ActivitySynManager.ActivityType.gm
end

---检测进入额外条件是否满足
---@return boolean 是否满足进入条件
function ActivitySynGMActivity:CheckConditionExtra()
    if not self.cfg.info.front or not self.cfg.info.front.con then
        return true
    end
    local GlobalConditionManager = _G.GlobalConditionManager
    local result, tipsID, content
    for i = 1, #self.cfg.info.front.con do
        local item = self.cfg.info.front.con[i]
        result, tipsID, content = GlobalConditionManager.CheckCondition(item.type, item.value)
        if not result then
            return false, tipsID, content
        end
    end
    return true
end
---活动子类型，用于区分同类型活动
function ActivitySynGMActivity:GetJumpType()
    if not self.cfg.info.front then
        return nil
    end
    return self.cfg.info.front.sub_type or nil
end

---活动子类型，用于区分同类型同sub_type活动
function ActivitySynGMActivity:GetMainType()
    if not self.cfg.info.front then
        return nil
    end
    return self.cfg.info.front.main_type or nil
end

---获取领取奖励之后是否隐藏活动
---@return boolean 是否隐藏
function ActivitySynGMActivity:GetHideViewByAward()
    if not self.cfg.info.front or not self.cfg.info.front.is_reveal then
        return false
    end
    return self.cfg.info.front.is_reveal == 1
end

---获取按钮展示类型|参数
---@return number|number|any 活动按钮展示类型|参数
function ActivitySynGMActivity:GetShowBtnType()
    local info = self.cfg.info
    -- return 1, info.group_num, info.sequence
    return info.standalone == 1 and 1 or 0, info.group_num, info.sequence, info.front and info.front.is_banner, info.front and info.front.pos and tonumber(info.front.pos)
end

---获取活动按钮展示信息
---@return 变量类型 中文描述
function ActivitySynGMActivity:GetShowBtnInfo()
    -- ZHJH-2278 修改图标返回，在福利界面返回两种状态icon
    if self.cfg.info.standalone == 0 and self.cfg.info.group_num == 105 then
        local icon = self.cfg.info.icon
        return _G.string.format(icon,"n"),self.cfg.info.name,_G.string.format(icon,"c")
    end
    return self.cfg.info.icon, self.cfg.info.name
end

function ActivitySynGMActivity:OnReConnect(endcall)
    self.onReconnectCall = endcall
    require("ActivitySynNet"):GetInstance():InitActivity(self.activityID, _G.handler(self, self.UpdateInitData))
end
-- endregion

function ActivitySynGMActivity:UpdateInitData(msg)
    if msg.ack ~= 1 then
        -- TODO:是否需要将状态修改为关闭
        if self.onReconnectCall then
            self.onReconnectCall()
        end
        return
    end
    msg = msg.activity[1]
    if not msg then
        -- TODO:没有拿到数据
        if self.onReconnectCall then
            self.onReconnectCall()
        end
        return
    end
    -- TODO:更新活动状态，如果是关闭，则关闭活动

    -- TODO:更新活动数据
    if msg.self_info then
        self.typeClass:ParseData(msg.self_info, true)
    end
    if self.onReconnectCall then
        self.onReconnectCall()
    end
end

-- region 对外接口
---得到对应活动倒计时 前端显示使用 与数据逻辑无关 超过对应条件的时间返回0
---@param _condition ActivitySynManager.ActivitySynState
function ActivitySynGMActivity:GetActivityDeadLineByCondition(_condition)
    local TimeUtil = _G.TimeUtil
    local t = TimeUtil.GetServerUnixTime()
    local UICountDown = self.cfg.time
    local noticeTime = UICountDown.start_time
    ---得到距离活动开启的倒计时
    if _condition == ActivitySynManager.State.Open then
        return noticeTime, t < noticeTime and noticeTime - t or 0
    end
    ---得到距离活动结算的倒计时
    noticeTime = noticeTime + UICountDown.run_time
    if _condition == ActivitySynManager.State.Settlement then
        return noticeTime, t < noticeTime and noticeTime - t or 0
    end
    ---得到距离活动结束的倒计时
    noticeTime = noticeTime + UICountDown.get_time
    if _condition == ActivitySynManager.State.Close then
        return noticeTime, t < noticeTime and noticeTime - t or 0
    end
    return noticeTime, 0
end

---重新获取数据
function ActivitySynGMActivity:RefreshData()
    if not _G.table.ContainsValue(ActivitySynManager.NeedRefreshType, self.cfg.info.type) then
        return
    end
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.activityID,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.cfg = msg.activity[1]
            if _G.tonumber(self.cfg.info.name) then
                self.cfg.info.name = _G.LangUtil.GetLangPackValue(_G.tonumber(self.cfg.info.name))
            end
            if _G.tonumber(self.cfg.info.title) then
                self.cfg.info.title = _G.LangUtil.GetLangPackValue(_G.tonumber(self.cfg.info.title))
            end
            if _G.tonumber(self.cfg.info.description) then
                self.cfg.info.description = _G.LangUtil.GetLangPackValue(_G.tonumber(self.cfg.info.description))
            end
            self.typeClass:HandleGMData(self.cfg.self_info)
        end
    )
end

-- endregion
return ActivitySynGMActivity
