local base = require("ActivitySynNet")

---@class ActivitySynExtraNet : BaseGameNet	通信协议
local ActivitySynExtraNet = _G.BaseClass("ActivitySynExtraNet", base)
---显示错误消息ack的tips
function ActivitySynExtraNet:ShowErrorAckTips(ack)
    if ack == 10 then
        _G.PopWindowManager:GetInstance():ShowAllTips(3067)
        return
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(ack)
end

return ActivitySynExtraNet
