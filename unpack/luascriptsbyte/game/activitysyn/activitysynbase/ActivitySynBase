---子类重写
---得到对应活动提示 前端显示使用 与数据逻辑无关
---@param _condition ActivitySynManager.ActivitySynState
function ActivitySynBase:GetActivityAllShowTips(state)
    local GetLangPackValue = _G.LangUtil.GetLangPackValue
    local GetDateTime = _G.TimeUtil.GetDateTime
    if not state or state == ActivitySynManager:GetInstance().State.Close then
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        return false
    elseif state == ActivitySynManager:GetInstance().State.Settlement then
        _G.PopWindowManager:GetInstance():ShowAllTips(650106)
        return false
    elseif state == ActivitySynManager:GetInstance().State.Notice then
        local noticetime, countdown = self:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
        local date = GetDateTime(noticetime)
        local day = noticetime - _G.TimeUtil.GetServerUnixTime()
        local timeStr
        if day < 86400 then
            local min = "0"
            if date.minute < 10 then
                min = min .. date.minute
            else
                min = date.minute
            end
            timeStr = date.hour .. ":" .. min
        else
            timeStr = GetLangPackValue(90000010300, date.month, date.day, date.hour)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(650107, GetLangPackValue(90000010356, timeStr))
        return false
    else
        return true
    end
end

