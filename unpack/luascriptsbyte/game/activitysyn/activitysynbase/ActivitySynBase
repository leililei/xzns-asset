---@param state ActivitySynManager.ActivityState 当前活动状态
---@param t number 距离下一个状态的切换时间
---@return 变量类型 中文描述
---@field changeNowTime  number 当前活动的真实浮点数时间
function ActivitySynBase:__init(id, cfg, state, t)
    self.activityID = id
    self.cfg = cfg
    self.curState = state
    self.changeStateTime = t
    self.changeNowTime = t
    self.regiestStateChangedStr = string.format("ActivitySynStateChanged%d", id)
end

---类的析构函数
function ActivitySynBase:Dispose()
    if self.typeClass then
        self.typeClass:Dispose()
    end
    self.typeClass = nil
    self.cfg = nil
    self.curState = nil
    self.activityID = nil
    self.changeStateTime = nil
    self.regiestStateChangedStr = nil
end

