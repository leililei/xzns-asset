-- region 通用活动界面点击响应判断 活动未在open和未达到解锁条件的情况下处理
function ActivitySynBase:CheckActivityInteractable()
    local state = self:GetCurActivityState()
    local tips = self:GetActivityAllShowTips(state)
    if tips then
        local enter, tipsid, content = self:CheckConditionExtra()
        if not enter then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsid, content)
            return false
        else
            return true
        end
    else
        return false
    end
end

