---@param state ActivitySynManager.ActivitySynState 活动状态
function ActivitySynBase:ChangeState(state)
    if state == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("参数传入错误 state = nil")
        end
        return
    end
    if self.curState ~= state then
        self.curState = state
        _G.Events:GetInstance():Broadcast(self.regiestStateChangedStr, state)
    end

    if state == ActivitySynManager.State.Close then      -- 当状态变为关闭或者已领奖
        require("ActivitySynEnterManager"):GetInstance():RemoveActivityBtn(self)
    elseif state == ActivitySynManager.State.Notice then -- 从关闭状态变更为展示状态
        require("ActivitySynEnterManager"):GetInstance():AddActivityBtn(self)
    elseif state == ActivitySynManager.State.Open then   ---针对特殊（如降神礼遇在消费到数量才能开启）
        require("ActivitySynEnterManager"):GetInstance():AddActivityBtn(self)
    end
end

