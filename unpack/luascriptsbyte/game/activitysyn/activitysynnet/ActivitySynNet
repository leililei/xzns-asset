---初始化单个活动数据
---@param id number 活动ID
---@param callback function 回调
function ActivitySynNet:InitActivity(id, callback)
    self:Access(_G.ConfigManager.net_map.game_activity_info, {id = id}, callback)
end
---领取活动奖励
---@param id number 活动ID
---@param params table 离散参数
---@param callback function 回调
function ActivitySynNet:GetAward(id, params, callback)
    self:Access(_G.ConfigManager.net_map.game_activity_get_award, {id = id, prams = params}, callback)
end

---资源购买
---@param id number 活动ID
---@param sid table 礼包sid
---@param callback function 回调
function ActivitySynNet:BuyGift(id, sid, callback)
    self:Access(_G.ConfigManager.net_map.game_activity_module_cash_gift_buy, {activity_id = id, item_sid = sid}, callback)
end

return ActivitySynNet
