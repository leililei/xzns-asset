---创建对象时,入口构造函数
function ActivitySynManager:__init()
    self.activityTable = {}
    self.subActivityRedPointTb = {}
    self.mainBtnShowCfg = {}
    local cfg = _G.ConfigManager.discrete_cfg[132001]
    if cfg then
        for _, v in ipairs(cfg) do
            local mainType = v[1]
            local showCfg = self.mainBtnShowCfg[mainType]
            if not showCfg then
                showCfg = { time = 86400, all = true, subTypes = {} } --默认显示小于24h的活动倒计时
                self.mainBtnShowCfg[mainType] = showCfg
            end
            for i = 2, #v do
                local subType = v[i]
                showCfg.subTypes[subType] = true
                showCfg.all = false
            end
        end
    end
    ---子活动红点
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.activity.Cmd, self.OnActivityChanged, self)
end

---销毁对象时,析构函数
function ActivitySynManager:Dispose()
    for _, value in pairs(self.activityTable) do
        value:Dispose()
    end
    self.activityTable = nil
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.activity.Cmd, self.OnActivityChanged, self)
end

