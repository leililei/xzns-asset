--返回所有活动信息
function ActivitySynManager:GetAllActivityInfo()
    return self.allActivityInfo or {}
end

function ActivitySynManager:initOneActivity(data, ActivitySynGMActiZvity, ActivitySynEnterManagerIns)
    local state, t
    local id = data.info.id
    local activity
    if self:CheckGMConditionPatams(data.info) then --展示条件通过
        state, t = self:CheckGMActivityState(data.time)
        activity = self.activityTable[id]
        if t > 0 then
            if state == ActivitySynState.Notice then
                if not self.needCheckConditionGMActivity then
                    self.needCheckConditionGMActivityList = {}
                    self.needCheckConditionGMActivity = { [id] = data }
                else
                    self.needCheckConditionGMActivity[id] = data
                end
                _G.table.insert(self.needCheckConditionGMActivityList, id)
            else
                if activity then
                    activity:ChangeActivityData(data, state, t)
                    activity.typeClass:HandleGMData(data.self_info)
                else
                    activity = ActivitySynGMActiZvity.New(data.info.id, data, state, t)
                    self.activityTable[data.info.id] = activity
                    if not activity:GetActivityTypeCls():CheckActivityAwardDone() then
                        ActivitySynEnterManagerIns:AddActivityBtn(self.activityTable[data.info.id])
                    end
                    --- 跨天拉数据时，会将之前提前显示，但是跨天后开启的活动一起获得
                    --- 导致提前显示的活动拉了两遍数据
                    if self.needCheckConditionGMActivityList and self.needCheckConditionGMActivity[data.info.id] then
                        _G.table.removebyvalue(self.needCheckConditionGMActivityList, data.info.id)
                        self.needCheckConditionGMActivity[data.info.id] = nil
                    end
                end
            end
        else
            if activity then --活动关闭了
                ActivitySynEnterManagerIns:RemoveActivityBtn(activity)
            end
        end
    else
        self.activityTable[id] = nil
        if not self.needCheckConditionGMActivity then
            self.needCheckConditionGMActivityList = {}
            self.needCheckConditionGMActivity = { [id] = data }
        else
            self.needCheckConditionGMActivity[id] = data
        end
        _G.table.insert(self.needCheckConditionGMActivityList, id)
    end
end

---检测GM活动状态
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function ActivitySynManager:CheckGMActivityState(data)
    local t = TimeUtil.GetServerUnixTime()
    local noticeTime = data.start_time
    if data.show_time > 0 and t < data.start_time then --展示时间
        return ActivitySynState.Notice, noticeTime - t
    end
    noticeTime = noticeTime + data.run_time
    if t < noticeTime then --开启时间
        return ActivitySynState.Open, noticeTime - t
    end
    noticeTime = noticeTime + data.get_time
    if t < noticeTime then --结算时间
        return ActivitySynState.Settlement, noticeTime - t
    end
    return ActivitySynState.Close, 0
end

---检测配置表活动状态
---@param cfg activity_info_cfg 活动配置数据
---@return ActivitySynState|number 活动状态|活动状态改变时间差
function ActivitySynManager:CheckCfgActivityState(cfg)
    local noticeTime = 0
    if cfg.time_type == 1 then     --物理时间(绝对时间戳)
        noticeTime = TimeUtil.TranslateTimeForStamp(cfg.time_open) - cfg.show_time
    elseif cfg.time_type == 2 then ---服务器相对时间
        noticeTime = _G.PlayerModel:GetInstance():GetServerOpenTime() + cfg.time_open[1] - cfg.show_time
    end
    local t = TimeUtil.GetServerUnixTime()
    local times = cfg.time_interval == 0 and 1 or (cfg.num_cycle > 1 and cfg.num_cycle or 1)
    for i = 1, times do
        if t < noticeTime then --展示时间之前
            return ActivitySynState.Close, noticeTime - t
        end
        noticeTime = noticeTime + cfg.show_time
        if t < noticeTime then --展示时间
            return ActivitySynState.Notice, noticeTime - t
        end
        noticeTime = noticeTime + cfg.time_duration
        if t < noticeTime then --开启时间
            return ActivitySynState.Open, noticeTime - t
        end
        noticeTime = noticeTime + cfg.end_time
        if t < noticeTime then --结算时间
            return ActivitySynState.Settlement, noticeTime - t
        end
        noticeTime = noticeTime + cfg.time_interval
    end
    return ActivitySynState.Close, 0
end

---检测限制条件
---@param params table 限制条件{{type,param},{type,param}}
---@param review number 提审模式下是否显示
---@return boolean 是否满足显示条件
function ActivitySynManager:CheckConditionParams(params, review)
    if review and review == 1 and _G.AppSetting.IsArraigned then
        ---提审模式下，review为1的活动不显示
        return false
    end
    if _G.table.isEmptyOrNil(params) then
        return true
    end
    if #params == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("活动显示判定条件参数错误")
        end
        return true
    end
    if #params == 1 then
        local cfg = _G.ConfigManager.function_open_cfg[params[1]]
        return _G.GlobalConditionManager.CheckConditionByArray(cfg.condition_type)
    end
    return _G.GlobalConditionManager.CheckCondition(params[1], params[2])
end

---检测GM活动限制条件
---@param params table 限制条件{{type=t,value=param, list = list},{type=t,value=param}}
---@return boolean 是否满足显示条件
function ActivitySynManager:CheckGMConditionPatams(params)
    params = params.front
    if not params then
        return true
    end
    params = params.con
    if not params then
        return true
    end
    for i = 1, #params do
        if not _G.GlobalConditionManager.CheckCondition(params[i].type, params[i].value, params[i].list) then
            return false
        end
    end
    return true
end

