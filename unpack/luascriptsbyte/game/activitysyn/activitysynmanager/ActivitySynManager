---相同活动类型, 不同id模板的活动
---@type (number[][])|{__cache:table<number,table<number,boolean>>}
local SameActivityTemplateIds = {
    { 10027, 10080 },
}

---是否为相同活动模板(存在同一活动, 不同模板id的情况)
---@param activity activity.i_activity    @活动配置
---@param activityId number     @活动id
---@return boolean,boolean      @是否为相同活动模板,是否为id活动自身
local function isSameActivityTemplate(activity, typeId)
    local _id = activity.info.type
    if _id == typeId then
        return true, true
    end

    if not SameActivityTemplateIds.__cache then
        --初始化模板缓存
        SameActivityTemplateIds.__cache = {}
        for i = 1, #SameActivityTemplateIds do
            local ids = SameActivityTemplateIds[i]
            local dict = {}
            for _, v in ipairs(ids) do
                dict[v] = true
                SameActivityTemplateIds.__cache[v] = dict
            end
        end
    end

    local dict = SameActivityTemplateIds.__cache[typeId]
    if not dict then
        return false, false
    end
    return dict[_id], false
end

