function ActivitySynManager:UpdateConditionActivity()
    local ids, cfg
    local ActivitySynEnterManagerIns = require("ActivitySynEnterManager"):GetInstance()
    if self.needCheckConditionActivity then
        local ActivitySynCfgActivity = require("ActivitySynCfgActivity")
        for id, condition in pairs(self.needCheckConditionActivity) do
            cfg = _G.ConfigManager.activity_info_cfg[id]
            local state, t = self:CheckCfgActivityState(cfg)
            if self:CheckConditionParams(condition, cfg.review) and state ~= ActivitySynState.Notice then
                if not ids then
                    ids = { id }
                else
                    ids[#ids + 1] = id
                end
                --TODO:检测活动开启时间

                if t > 0 then
                    self.activityTable[id] = ActivitySynCfgActivity.New(id, cfg, state, t)
                    self.activityIDArray[#self.activityIDArray + 1] = id
                    self.activityTable[id]:InitData(
                        function()
                            if state ~= ActivitySynState.Close then
                                ActivitySynEnterManagerIns:AddActivityBtn(self.activityTable[id])
                                --TODO:刷新红点
                                local item = self.activityTable[id]:GetActivityTypeCls()
                                local tree = item:GetRedPointTree()
                                if not _G.table.isEmptyOrNil(tree) then
                                    local param
                                    local RedPointManagerIns = require("RedPointManager"):GetInstance()
                                    for i = 1, #tree do
                                        param = item:GetRedPointParams(i)
                                        if param then
                                            RedPointManagerIns:RefreshNodeByAllParams(item:GetRedpointIDByIndex(i))
                                        else
                                            RedPointManagerIns:RefreshNode(item:GetRedpointIDByIndex(i))
                                        end
                                    end
                                end
                            end
                        end
                    )
                end
            end
        end
        if ids then
            for i = 1, #ids do
                self.needCheckConditionActivity[ids[i]] = nil
            end
        end
    end

    ids = nil
    if self.needCheckConditionGMActivity then
        local ActivitySynGMActivity = require("ActivitySynGMActivity")
        for k, v in ipairs(self.needCheckConditionGMActivityList) do
            local id = v
            local data = self.needCheckConditionGMActivity[v]
            if data then
                -- body
                local state, t = self:CheckGMActivityState(data.time)
                if self:CheckGMConditionPatams(data.info) and (state ~= ActivitySynState.Notice) then
                    if not ids then
                        ids = { id }
                    else
                        ids[#ids + 1] = id
                    end
                    if t > 0 then
                        self.activityTable[id] = ActivitySynGMActivity.New(id, data, state, t)
                        self.activityTable[id]:RefreshData()
                        ---有些活动在达成某些条件才会显示一开始不会显示(降神礼遇需要消费达到某个条件再显示)
                        if self.activityTable[id]:GetCurActivityState() ~= ActivitySynState.Close then
                            ActivitySynEnterManagerIns:AddActivityBtn(self.activityTable[id])
                        end
                        --TODO:刷新红点
                        local item = self.activityTable[id]:GetActivityTypeCls()
                        local tree = item:GetRedPointTree()
                        if not _G.table.isEmptyOrNil(tree) then
                            local param
                            local RedPointManagerIns = require("RedPointManager"):GetInstance()
                            for i = 1, #tree do
                                param = item:GetRedPointParams(i)
                                if param then
                                    RedPointManagerIns:RefreshNodeByAllParams(item:GetRedpointIDByIndex(i))
                                else
                                    RedPointManagerIns:RefreshNode(item:GetRedpointIDByIndex(i))
                                end
                            end
                        end
                        self:AddSubActivityRedPoint(item)
                    end
                end
            end
        end
        if ids then
            for i = 1, #ids do
                self.needCheckConditionGMActivity[ids[i]] = nil
                for index, value in ipairs(self.needCheckConditionGMActivityList) do
                    if value == ids[i] then
                        _G.table.remove(self.needCheckConditionGMActivityList, index)
                        break
                    end
                end
            end
        end
    end
    self:ClearConditionCheckArray()
end

function ActivitySynManager:ClearConditionCheckArray()
    if
        _G.table.isEmptyOrNil(self.needCheckConditionGMActivity) and
        _G.table.isEmptyOrNil(self.needCheckConditionActivity)
    then
        self.needCheckConditionActivity = nil
        self.needCheckConditionGMActivityList = nil
        self.needCheckConditionGMActivity = nil
        self.onCheckConditionType = nil
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEvent, self)
        _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerUpLevel, self.PlayerUpLevel, self)
        _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.TotalCash, self.TotalCashEvent, self)
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.VIP, self.TotalCashEvent, self)
        _G.Events:GetInstance():RemoveListener(_G.FunctionOpenDailyCheckEvent.GuildTrain, self.GuildTrain, self)
        _G.Events:GetInstance():RemoveListener(_G.FunctionOpenDailyCheckEvent.DailyActive, self.DailyActive, self)
    end
end

---活动状态改变计时器回调
function ActivitySynManager:OnActivityStateChangerTimerCall(elapsed)
    local removeIDTab
    local state, t
    --修改状态调整的时间
    for id, item in pairs(self.activityTable) do
        item:UpdateStateTime(elapsed)
        if item:GetChangeStateTime() <= 0 then
            if item:GetActivityType() == activityType.cfg then
                state, t = self:CheckCfgActivityState(item.cfg)
            else
                state, t = self:CheckGMActivityState(item.cfg.time)
            end
            if t <= 0 then
                if not removeIDTab then
                    removeIDTab = {}
                end
                removeIDTab[id] = true
            end
            --TODO：活动状态改变
            item:ChangeActivityData(nil, state, t)
        end
    end
    if removeIDTab then
        --将关闭不会再开的活动移除列表
        for id, _ in pairs(removeIDTab) do
            self.activityTable[id]:Dispose()
            self.activityTable[id] = nil
        end
    end
end

---服务器推送，GM活动数据修改
--[[
    message p2c_activity {
        required uint32 activity_id = 1;
        required uint32 state = 2;  //新的活动状态
    }
    0：活动关闭
    1：活动开启
    2：活动停止 在stop状态下不做处理，此状态用于领奖
    3：活动预热(可以提前看到)
]]
---@param msg table 活动数据
function ActivitySynManager:OnActivityChanged(msg)
    if msg.state == 0 then --关闭活动
        local item = self.activityTable[msg.activity_id]
        if item then
            item:ChangeActivityData(nil, ActivitySynState.Close, 0)
            self.activityTable[msg.activity_id] = nil
        else
            if self.needCheckConditionGMActivity and self.needCheckConditionGMActivity[msg.activity_id] then
                self.needCheckConditionGMActivity[msg.activity_id] = nil
                self:ClearConditionCheckArray()
            end
        end
    else
        ActivitySynNet:GetInstance():InitActivity(msg.activity_id, _G.handler(self, self.OnActivityChangedCall))
    end
end

---活动数据修改回调
---@param msg table 活动数据
---@param realActivityId boolean 真实活动id（针对如公平竞技场之类的活动）
function ActivitySynManager:OnActivityChangedCall(msg, realActivityId)
    if msg.ack ~= 1 then
        return
    end
    msg = msg.activity[1]
    local data = msg
    if _G.tonumber(data.info.name) then
        data.info.name = _G.GetLangPackValue(_G.tonumber(data.info.name))
    end
    if _G.tonumber(data.info.title) then
        data.info.title = _G.GetLangPackValue(_G.tonumber(data.info.title))
    end
    if _G.tonumber(data.info.description) then
        data.info.description = _G.GetLangPackValue(_G.tonumber(data.info.description))
    end
    local item = self.activityTable[msg.info.id]
    local state, t
    state, t = self:CheckGMActivityState(msg.time)
    if self:CheckGMConditionPatams(msg.info) and state ~= ActivitySynState.Notice then
        if not item then --不存在的活动
            local ActivitySynGMActivity = require "ActivitySynGMActivity"
            if t > 0 then
                item = ActivitySynGMActivity.New(msg.info.id, msg, state, t, realActivityId)
                self.activityTable[msg.info.id] = item
                ---有些活动在达成某些条件才会显示一开始不会显示
                if item:GetCurActivityState() ~= ActivitySynState.Close then
                    ActivitySynEnterManager:GetInstance():AddActivityBtn(item)
                end
                --TODO:刷新红点
                item = item:GetActivityTypeCls()
                local tree = item:GetRedPointTree()
                if not _G.table.isEmptyOrNil(tree) then
                    local param
                    local RedPointManagerIns = require("RedPointManager"):GetInstance()
                    for i = 1, #tree do
                        param = item:GetRedPointParams(i)
                        if param then
                            RedPointManagerIns:RefreshNodeByAllParams(item:GetRedpointIDByIndex(i))
                        else
                            RedPointManagerIns:RefreshNode(item:GetRedpointIDByIndex(i))
                        end
                    end
                end
                self:AddSubActivityRedPoint(item)
            end
        elseif item:GetActivityType() == activityType.gm then -- 目前只支持GM活动动态修改
            item:ChangeActivityData(msg, state, t)
        end
    else
        if not self.needCheckConditionGMActivity then
            self.needCheckConditionGMActivityList = {}
            self.needCheckConditionGMActivity = { [msg.info.id] = msg }
        else
            if _G.table.isEmptyOrNil(self.needCheckConditionGMActivity) then
                if _G.table.isEmptyOrNil(self.needCheckConditionActivity) then
                    --TODO:开启条件检测
                    local enum = _G.ActiveTaskEnum.ConditionEnum
                    self.onCheckConditionType = { enum.AFK.IsPass, enum.Section.SectionPass }
                    _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEvent, self)
                    _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerUpLevel, self.PlayerUpLevel, self)
                    _G.Events:GetInstance():AddListener(_G.eRechargeEvent.TotalCash, self.TotalCashEvent, self)
                    _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.VIP, self.TotalCashEvent, self)
                    _G.Events:GetInstance():AddListener(_G.FunctionOpenDailyCheckEvent.GuildTrain, self.GuildTrain, self)
                    _G.Events:GetInstance():AddListener(_G.FunctionOpenDailyCheckEvent.DailyActive, self.DailyActive, self)
                end
            end
            self.needCheckConditionGMActivity[msg.info.id] = msg
        end
    end
end

