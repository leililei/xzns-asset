---添加子活动红点
---@param activity ActivitySynTypeBase
---@param sub_type number 二级壳子需要指定一级壳子的sub_type
function ActivitySynManager:AddSubActivityRedPoint(activity, sub_type)
    local ids = activity:GetOtherActivityRedPointIds()
    ---活动类型
    local type = activity.curActivityClass:GetTypeId()

    ---功能类型
    local maintypes = activity:GetOtherActivityRedPointMainType()

    if type == 10067 and sub_type == nil then
        --二级壳子，需要拿子壳子的subty
        local subTypeLis = activity:GetAllChildSubType()
        for _, v in pairs(subTypeLis) do
            self:AddSubActivityRedPoint(activity, v)
        end
        ids = activity:GetDirectActivityRedPointIds()
    end
    ---子活动类型
    sub_type = sub_type or activity.curActivityClass:GetJumpType()
    local RedPointManager = require "RedPointManager":GetInstance()
    if not _G.table.isEmptyOrNil(ids) then
        if not self.subActivityRedPointTb[sub_type] then
            self.subActivityRedPointTb[sub_type] = {}
        end
        self.subActivityRedPointTb[sub_type] = {}
        local sub_activity = nil
        for k, v in pairs(ids) do
            local maintype = maintypes and maintypes[k] or nil
            sub_activity = self:GetChildAcitivity(v, sub_type,maintype)
            if
                not sub_activity or
                not RedPointManager:GetRedpointItem(sub_activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
            then
                self.subActivityRedPointTb[sub_type][v] = activity.curActivityClass:GetActivityID()
            else
                RedPointManager:AddRedPointChild(
                    activity:GetRedpointIDByIndex(1),
                    sub_activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
                )
            end
        end
    end
    if self.subActivityRedPointTb[sub_type] and self.subActivityRedPointTb[sub_type][type] then
        local parentActivity = self:GetActivityClass(self.subActivityRedPointTb[sub_type][type])
        if
            not parentActivity or
            not RedPointManager:GetRedpointItem(parentActivity:GetActivityTypeCls():GetRedpointIDByIndex(1))
        then
            return
        end
        RedPointManager:AddRedPointChild(
            parentActivity:GetActivityTypeCls():GetRedpointIDByIndex(1),
            activity:GetRedpointIDByIndex(1)
        )
        self.subActivityRedPointTb[sub_type][type] = nil
        if _G.table.isEmptyOrNil(self.subActivityRedPointTb[sub_type]) then
            self.subActivityRedPointTb[sub_type] = nil
        end
    end
end

