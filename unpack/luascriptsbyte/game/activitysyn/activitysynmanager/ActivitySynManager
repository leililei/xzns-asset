---内部方法内部方法内部方法内部方法内部方法内部方法
function ActivitySynManager:JumpActivity2(activity, isSingle)
    local positionCfg = _G.ConfigManager.activity_position_cfg
    local t, p1, p2
    if activity and activity:GetCurActivityState() ~= ActivitySynState.Close then
        t, p1, p2 = activity:GetShowBtnType()
        ---如果是独立按钮 直接走活动自己的入口
        if t == enterBtnType.btn then
            activity:EnterActivity()
        else
            ---如果是其他界面 根据配置索引进入
            if p1 then
                local cfg = positionCfg[p1]
                if cfg ~= nil and cfg.views ~= nil then
                    ActivitySynEnterManager:GetInstance():JumpActivity(
                        cfg.views,
                        p2,
                        activity:GetActivityID(),
                        isSingle
                    )
                end
            end
        end
    end
end

