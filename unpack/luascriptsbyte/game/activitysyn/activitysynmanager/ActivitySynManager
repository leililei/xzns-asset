---获得子活动
---@param type number 活动类型
---@param jumpID number 跳转ID
---@return ActivitySynGMActivity 活动Table
function ActivitySynManager:GetChildAcitivity(type, jumpId, main_type)
    if not self.activityTable then
        return nil
    end
    local sameTemplate
    for _, v in pairs(self.activityTable) do
        if v.cfg.info then
            
            if v.cfg.info.front.sub_type == jumpId then
                local ok, isSelf = isSameActivityTemplate(v.cfg, type)
                if ok and (not main_type or main_type <= 0 or main_type == v.cfg.info.front.main_type) then
                    if isSelf then
                        return v
                    end
                    sameTemplate = v --作为相同模板备选活动实例
                end
            end
        else
            if not jumpId and v.cfg.type_activity == type then
                return v
            end
        end
    end
    return sameTemplate
end

