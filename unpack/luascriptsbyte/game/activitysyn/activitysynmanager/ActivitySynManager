---重连成功调用
---@param endcall function 完成回调
function ActivitySynManager:ReConnect(endcall)
    if not self.activityIDArray then
        if endcall then
            endcall(self.__cname)
        end
        return
    end
    self.onReConnectCall = endcall
    local index = 1
    for id, _ in pairs(self.activityTable) do
        --TODO:子类重连调用ReConnect
        self.activityIDArray[index] = id
        index = index + 1
    end
    for i = index + 1, #self.activityIDArray do
        self.activityIDArray[i] = 0
    end
    self.activityReconnectIndex = 1
    if #self.activityIDArray <= 0 then
        if self.onReConnectCall then
            self.onReConnectCall(self.__cname)
            self.onReConnectCall = nil
        end
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log(self.activityIDArray, "活动要重连的id")
    end

    self.activityTable[self.activityIDArray[self.activityReconnectIndex]]:ReConnect(
        _G.handlerbind(self, self.OnReConnectCall, "one", self.activityIDArray[self.activityReconnectIndex])
    )
end

