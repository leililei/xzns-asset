    self:InitCommunityActivity()

    local list = self.communityActivity
    if not list or #list <= 0 then
        return false
    end
    for _, activity in pairs(list) do
        if activity:GetActivityTypeCls():IsShowInFuliView() then
            return true
        end
    end
    return false
