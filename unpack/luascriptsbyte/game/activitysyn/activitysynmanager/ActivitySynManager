---初始化配置活动
function ActivitySynManager:InitConfig()
    local cfgs = _G.ConfigManager.activity_info_cfg
    local state, t, condition
    local ActivitySynCfgActivity = require "ActivitySynCfgActivity"
    self.activityIDArray = {}
    local ActivitySynEnterManagerIns = ActivitySynEnterManager:GetInstance()
    for id, cfg in pairs(cfgs) do
        state, t = self:CheckCfgActivityState(cfg)
        --ZHJ-35950【拉新活动】功能优化导致新号无法进入游戏
        --原先的condition_display字段不支持复合条件配置, 此处time为新加客户端逻辑通用条件判断
        if t > 0 and (not cfg.time or #cfg.time == 0 or _G.GlobalConditionManager.CheckConditionArrays(cfg.time)) then
            --TODO:判定条件是否满足
            condition = UseConditionExtra[cfg.type_activity] and cfg.condition_extra or cfg.condition_display
            if self:CheckConditionParams(condition, cfg.review) then --满足展示条件
                local activity = self.activityTable[id]
                if not activity then
                    self.activityTable[id] = ActivitySynCfgActivity.New(id, cfg, state, t)
                    self.activityIDArray[#self.activityIDArray + 1] = id
                    if state ~= ActivitySynState.Close then
                        ActivitySynEnterManagerIns:AddActivityBtn(self.activityTable[id])
                    end
                else
                    activity:ChangeActivityData(nil, state, t)
                    self.activityIDArray[#self.activityIDArray + 1] = id
                end
            else --不满足展示条件
                if not self.needCheckConditionActivity then
                    self.needCheckConditionActivity = { [id] = cfg.condition_display }
                else
                    self.needCheckConditionActivity[id] = cfg.condition_display
                end
            end
        end
    end
    if #self.activityIDArray > 0 then
        self.activityIndex = 1
        self.activityTable[self.activityIDArray[self.activityIndex]]:InitData(
            _G.handler(self, self.OnCfgActivityDataCall)
        )
    else
        --TODO:拉取服务器活动数据
        ActivitySynNet:GetInstance():InitAllActivity(_G.handler(self, self.ParseData))
    end
end

---初始化配置数据回调
function ActivitySynManager:OnCfgActivityDataCall()
    --TODO:检测活动是否在领取完奖励后隐藏按钮
    local activity = self.activityTable[self.activityIDArray[self.activityIndex]]
    if activity.cfg.is_reveal == 1 then
        if activity:GetActivityTypeCls():CheckActivityAwardDone() then
            activity:ChangeState(ActivitySynState.Close)
        end
    end
    self.activityIndex = self.activityIndex + 1
    if self.activityIndex > #self.activityIDArray then
        --TODO:拉取服务器活动数据
        ActivitySynNet:GetInstance():InitAllActivity(_G.handler(self, self.ParseData))
    else
        self.activityTable[self.activityIDArray[self.activityIndex]]:InitData(
            _G.handler(self, self.OnCfgActivityDataCall)
        )
    end
end

---重连成功后拉取数据回调
function ActivitySynManager:OnReConnectCall(name, id)
    if _G.AppSetting.DEBUG then
        _G.Log(name .. ">>>>>>>" .. (id == nil and "" or id), "已重连完成id")
    end
    self.activityReconnectIndex = self.activityReconnectIndex + 1
    if self.activityReconnectIndex > #self.activityIDArray or self.activityIDArray[self.activityReconnectIndex] == 0 then
        if self.onReConnectCall then
            self.onReConnectCall(self.__cname)
            self.onReConnectCall = nil
        end
    else
        self.activityTable[self.activityIDArray[self.activityReconnectIndex]]:ReConnect(
            _G.handlerbind(self, self.OnReConnectCall, self.activityIDArray[self.activityReconnectIndex])
        )
    end
end

