---获取主界面按钮倒计时
---@param id number 活动ID
---@return boolean,number 是否显示倒计时, 倒计时结束时间
function ActivitySynManager:GetBtnCountDown(id)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogError("id  = nil 检查参数合法性")
        end
        return false, 0
    end
    local activity = self.activityTable[id]
    if not activity or activity:GetCurActivityState() ~= ActivitySynState.Open then
        return false, 0
    end

    --判断此类型是否显示
    ---@type number,number
    local mainType, subType = activity.GetMainType and activity:GetMainType() or activity:GetTypeId(), activity:GetJumpType()
    local showCfg = self.mainBtnShowCfg[mainType]
    if not showCfg or not showCfg.all and not showCfg.subTypes[subType] then
        return false, 0
    end
    --判断剩余时长是否满足要求
    local _, endTime = activity:GetActivityDeadLineByCondition(ActivitySynState.Close)
    if endTime >= showCfg.time then
        return false, 0
    end
    return true, _G.TimeUtil.GetServerUnixTime() + endTime
end

