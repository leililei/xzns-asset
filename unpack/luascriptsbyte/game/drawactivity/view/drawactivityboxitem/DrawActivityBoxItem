---@class DrawActivityBoxItem : Component	灵域觅宝宝箱显示
---@field go_table DrawActivityView._obj_box1_GoTable
local DrawActivityBoxItem = _G.BaseClass("DrawActivityBoxItem", _G.Component)
local TimeUtil = _G.TimeUtil
local GetLangPackValue = _G.GetLangPackValue
function DrawActivityBoxItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function DrawActivityBoxItem:OnCreate(index, call)
    self.index = index
    self.call = call
    self.RTS = 0
end

function DrawActivityBoxItem:Show()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local data = require "DrawActivityModel":GetInstance():GetBoxData(self.index)
    if not data then
        self.go_table.obj_Nil:SetActiveE(1)
        self.go_table.obj_item:SetActiveE(0)
        return
    end
    self.go_table.obj_Nil:SetActiveE(0)
    self.go_table.obj_item:SetActiveE(1)
    local time = _G.TimeUtil.GetServerUnixTime()
    local endTime = require "DrawActivityModel":GetInstance():GetBoxDurationTime(data.id) + data.time - 1
    if time >= endTime then
        self.go_table.obj_wait:SetActiveE(0)
        self.go_table.obj_over:SetActiveE(1)
    else
        self.go_table.obj_wait:SetActiveE(1)
        self.go_table.obj_over:SetActiveE(0)
        self.RTS = endTime - time
        self:UpdateTimeShow(true)
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeShow, self, false, false, true,false)
        self.timer:Start()
    end
end

---更新倒计时显示
function DrawActivityBoxItem:UpdateTimeShow(show,elapsed)
    if not show then
        self.RTS = self.RTS - elapsed
    end
    self.go_table.aortext_time.text = TimeUtil.TimeToString(Mathf.RoundToInt(self.RTS), 1)
    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self:Show()
    end
end

function DrawActivityBoxItem:OnClickBtn()
    local data = require "DrawActivityModel":GetInstance():GetBoxData(self.index)
    if self.RTS > 0 then
        return
    end
    require "DrawActivityModel":GetInstance():GetBox(data.box_id, self.call)
end

function DrawActivityBoxItem:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return DrawActivityBoxItem
