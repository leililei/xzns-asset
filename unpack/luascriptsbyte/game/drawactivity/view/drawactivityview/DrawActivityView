---@class DrawActivityView : UIBaseView	中文描述
---@field public go_table DrawActivityView_GoTable GoTable
---@field boxItems DrawActivityBoxItem[]
---@field awardItems DrawActivityAwardItem[]
local DrawActivityView = _G.BaseClass("DrawActivityView", _G.UIBaseView)
local langugageId = {
    --倒计时
    timer = 90028500004,
    --许愿次数
    xuyuanNum = 90028500003,
    --保底次数
    keep = 90028500002,
    --本次获得大奖
    isKeep = 90028500023,
    --去获得
    get = 90028500001
}
local GetLangPackValue = _G.LangUtil.GetLangPackValue

---@type DrawActivityModel
local DrawActivityModel
function DrawActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DrawActivityView:OnCreate()
    DrawActivityModel = require "DrawActivityModel"
    if not self.coinSid then
        self.coinSid = require"ThemeActivityManager":GetInstance():GetCoinSid()
    end
    self:UpdateView()
    self:CreatEffect()
    if not self.ExtendText then
        self.ExtendText = self.go_table.obj_goto:GetComponentE(_G.typeof(_G.CS.ExtendText))
        self.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))
    end
    local str = GetLangPackValue(langugageId.get)
    str = string.format(string.format("<%s@%s>", str, str))
    self.ExtendText.text = str
    self:AddListener(_G.eItemUpdata.Updata, self.UpdateConsume)
    if not _G.table.isEmptyOrNil(_G.ConfigManager.ui_cfg.DrawActivityView.resources) then
        self:AddComponent(
            self.go_table.obj_glod,
            require("ResourceCompont").New(self.go_table.obj_glod, _G.ConfigManager.ui_cfg.DrawActivityView.resources)
        )
    end
end

function DrawActivityView:CreatEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_DrawActivityView_bg, self.go_table.obj_BGEffect)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_DrawActivityView_shuye, self.go_table.obj_BGEffect)
    local tb10 = _G.GetAutoGoTable(self.go_table.obj_items10)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_DrawActivityView_icon, tb10.aorimage_bg)
    for i = 1, 5 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_box" .. i])
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_DrawActivityView_baoxiang, tb.obj_effect)
    end
end

---更新界面
function DrawActivityView:UpdateView()
    --self:UpdateBoxItems()
    self:UpdateAwardItems()
    self:UpdateConsume()
    self:UpdateNum()
    self:UpdateTime()
    -- self:UpdateTimer()
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.coinSid))
end

---更新所有宝箱显示
function DrawActivityView:UpdateBoxItems()
    if not self.boxItems then
        self.boxItems = {}
        for i = 1, 5 do
            self.boxItems[i] =
                self:AddComponent(
                self.go_table["obj_box" .. i],
                require "DrawActivityBoxItem".New(i, _G.handler(self, self.OnClickBox))
            )
        end
    end
    for _, v in pairs(self.boxItems) do
        v:Show()
    end
end

function DrawActivityView:OnClickBox()
    self:UpdateBoxItems()
    self:UpdateConsume()
end

---更新奖励显示
function DrawActivityView:UpdateAwardItems()
    if not self.awardItems then
        self.awardItems = {}
        for i = 1, 10 do
            self.awardItems[i] =
                self:AddComponent(self.go_table["obj_items" .. i], require "DrawActivityAwardItem".New(i))
        end
    end

    for _, v in pairs(self.awardItems) do
        v:Show()
    end
end

---更新消耗
function DrawActivityView:UpdateConsume()
    local Draw_num = DrawActivityModel:GetInstance():Draw_num()

    local costTb = DrawActivityModel:GetInstance():GetConsume() * Draw_num

    local all = DrawActivityModel:GetInstance():GetCoinNum()
    if costTb > all then
        self.go_table.aortext_costNum.text =
            _G.string.format("<color=#ff3c37>%s</color>", _G.TryGetLangValue(90028500019, costTb))
    else
        self.go_table.aortext_costNum.text = _G.TryGetLangValue(90028500019, costTb)
    end
    self.go_table.aortext_label.text = _G.TryGetLangValue(90028500027, Draw_num)
end

---更新次数
function DrawActivityView:UpdateNum()
    self.go_table.aortext_drawNum.text = ""
    local keepNum = DrawActivityModel:GetInstance():GetKeepNum() - DrawActivityModel:GetInstance():GetDrawNum()
    if keepNum > 0 then
        self.go_table.aortext_keepNum.text = GetLangPackValue(langugageId.keep, keepNum)
    else
        self.go_table.aortext_keepNum.text = GetLangPackValue(langugageId.isKeep)
    end
end

function DrawActivityView:UpdateTime()
    local data = _G.TimeUtil.TranslateSecond(require "ThemeActivityManager":GetInstance():GetRTS())
    if data.hour > 0 or data.min > 0 or data.sec > 0 then
        data.day = data.day + 1
    end
    self.go_table.aortext_time.text = GetLangPackValue(langugageId.timer, GetLangPackValue(90025500011, data.day, ""))
end

---更新时间
function DrawActivityView:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.RTS = require "ThemeActivityManager":GetInstance():GetRTS()
    local time = {}
    if self.RTS <= 0 then
        time.day = 0
        self.go_table.aortext_time.text = GetLangPackValue(langugageId.timer, GetLangPackValue(90025500011, 0, ""))
        return
    else
        time = _G.TimeUtil.TranslateSecond(self.RTS)
        if time.hour > 0 or time.min > 0 or time.sec > 0 then
            time.day = time.day + 1
        end
        self.go_table.aortext_time.text =
            GetLangPackValue(langugageId.timer, GetLangPackValue(90025500011, time.day, ""))
    end

    self.timer =
        _G.TimerManager:GetInstance():GetTimer(_G.TimeUtil.GetSixClockTimer(), self.UpdateTime, self, true, false, true)
    self.timer:Start()
end

---许愿
function DrawActivityView:OnDraw()
    DrawActivityModel:GetInstance():Draw(
        function()
            self:UpdateView()
        end
    )
end

function DrawActivityView:OnHrefClick()
    require "ThemeActivityManager":GetInstance():EnterActivity(_G.ThemeActivityType.Task)
    self:Close()
end

---按钮点击事件在这里派发
function DrawActivityView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_draw then
        self:OnDraw()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_awardPre then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawActivityAwardPreView.Name)
    end
end
function DrawActivityView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return DrawActivityView
