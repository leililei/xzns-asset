---@class DrawActivityAwardPreView : UIBaseView	中文描述
---@field public go_table DrawActivityAwardPreView_GoTable GoTable
local DrawActivityAwardPreView = _G.BaseClass("DrawActivityAwardPreView", _G.UIBaseView)
--_G.DrawActivityAwardPreView = DrawActivityAwardPreView
local DrawActivityModel
function DrawActivityAwardPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DrawActivityAwardPreView:OnCreate()
    DrawActivityModel = require "DrawActivityModel":GetInstance()
    self.AwardDatas = DrawActivityModel:GetPerList()
    self.itemList = {}
    self.go_table.scrollloopvectical_AwardList:InitItemData(#self.AwardDatas, _G.handler(self, self.RefreshList))
end
---刷新显示
function DrawActivityAwardPreView:RefreshList(index, obj)
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    ---@type activity_theme.i_draw_cfg
    local data = self.AwardDatas[index + 1]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.award[1].sid, data.award[1].num},
        nil,
        function(item)
            if item.item.HideOrShowStar then
                item.item:HideOrShowStar(false)
            end
            item:ShowEffect(DrawActivityModel:CheckIsMaxItem(data.id))
        end
    )
    -- local name = _G.StorageManager:GetInstance():GetItemName(data.award[1].sid)
    -- tb.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    tb.aortext_probNum.text = (DrawActivityModel:GetPerData(index + 1) * 100) .. "%"
end

---点击奖励
function DrawActivityAwardPreView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
end

---按钮点击事件在这里派发
function DrawActivityAwardPreView:OnClickBtn(go, isOn)
    self:Close()
end

return DrawActivityAwardPreView
