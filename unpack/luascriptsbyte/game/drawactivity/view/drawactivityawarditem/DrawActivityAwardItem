---@class DrawActivityAwardItem : Component	中文描述
---@field go_table DrawActivityView._obj_items1_GoTable
local DrawActivityAwardItem = _G.BaseClass("DrawActivityAwardItem", _G.Component)

local image = {
    "UI_lymb_daizi",
    "UI_lymb_daizi2"
}
function DrawActivityAwardItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function DrawActivityAwardItem:OnCreate(index)
    self.index = index
    _G.SetEventTrigger(self.go_table.aorimage_bg, "onClick", _G.handler(self, self.OnClickItem))
end

---显示
function DrawActivityAwardItem:Show()
    local data = require "DrawActivityModel":GetInstance():GetCurListItem(self.index)
    if not data then
        self.go_table.aorimage_bg.SpriteName = image[1]
        return
    end
    local type = _G.StorageManager:GetInstance():CheckSidType(data.award[1].sid)
    local path = _G.StorageManager:GetInstance():GetItemIcon(data.award[1].sid)
    if type == _G.StorageType.Card then
        path = "Images/zRoles/" .. path
    end
    self.go_table.aorrawimage_icon:LoadImage(path)
    self.go_table.aortext_num.text = "x" .. data.award[1].num
    if require "DrawActivityModel":GetInstance():CheckIsMaxItem(data.id) then
        self.go_table.aorimage_bg.SpriteName = image[2]
    else
        self.go_table.aorimage_bg.SpriteName = image[1]
    end
end

---点击物体
function DrawActivityAwardItem:OnClickItem()
    local data = require "DrawActivityModel":GetInstance():GetCurListItem(self.index)
    require "CommonTipManager":GetInstance():OpenTip(self.go_table.aorrawimage_icon, data.award[1].sid)
end

---销毁对象时,析构函数
function DrawActivityAwardItem:OnDestroy()
end

function DrawActivityAwardItem:OnClickBtn()
end

return DrawActivityAwardItem
