local base = require "ThemeActivityBaseModel"
---@class DrawActivityModel	:ThemeActivityBaseModel 灵域觅宝
---@field cfgs activity_theme.i_draw_cfg[]
---@field perSordLists activity_theme.i_draw_cfg[] 奖励排序后的表
---@field perList number[] 奖励获取概率表
local DrawActivityModel = _G.BaseClass("DrawActivityModel", base)

---@return DrawActivityModel DrawActivityModel
function DrawActivityModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function DrawActivityModel:__init()
    --当前拥有的代币数量
    self.CoinNum = 0
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.theme_award_coin.Cmd, self.P2C_award_coin, self)
end

---后端主动推送的数据
function DrawActivityModel:P2C_award_coin(data)
    if _G.IsNil(data) then
        return
    end
    self:AddCoinNum(data.coin_num)
end

---销毁对象时,析构函数
function DrawActivityModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
end

---初始化数据
---@param msg activity_theme.i_draw
function DrawActivityModel:InitData(msg)
    self.info = msg
    if not self.coinSid then
        self.coinSid = require"ThemeActivityManager":GetInstance():GetCoinSid()
    end
    ---主题活动代币数量
    self.CoinNum = 0
    self:SetCoinNum(self.info.coin_num or 0)
    self:InitDarwCfg()
    self:InitMaxPools()
    self:InitNormalPools()
    --self:UpdateCanTakeBox()
    --self:InitTimer()
end

---初始化许愿
function DrawActivityModel:InitDarwCfg()
    self.cfgs = {}
    local maxPer = 0
    self.perSordLists = {}
    self.perList = {}
    local insert = _G.table.insert
    for _, v in pairs(self.info.cfg_list) do
        self.cfgs[v.id] = v
        maxPer = maxPer + v.weight
        insert(self.perSordLists, v)
    end
    _G.SortList(
        self.perSordLists,
        function(data)
            return -data.weight, data.id
        end
    )
    for i = 1, #self.perSordLists do
        self.perList[i] = _G.math.ceil(self.perSordLists[i].weight / maxPer * 10000) / 10000
    end
end

---设置代币数量
function DrawActivityModel:SetCoinNum(num)
    self.CoinNum = num
    self:DispatchUpdateEvent(num)
    return self.CoinNum
end
---增加代币
function DrawActivityModel:AddCoinNum(num)
    self.CoinNum = self.CoinNum + num
    self:DispatchUpdateEvent(num)
    return self.CoinNum
end
---减少代币
function DrawActivityModel:RedCoinNum(num)
    self.CoinNum = self.CoinNum - num
    self:DispatchUpdateEvent(num)
    return self.CoinNum
end

---推送货币更新事件
---@param change number 更新数量
function DrawActivityModel:DispatchUpdateEvent(change)
    if change == nil then
        change = 0
    end
    local tmp = {}
    if not self.coinSid then
        self.coinSid = require "ThemeActivityManager":GetInstance():GetCoinSid()
    end
    _G.table.insert(tmp, self.coinSid)
    _G.table.insert(tmp, change)
    _G.table.insert(tmp, self.CoinNum)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
end

--返回主题活动代币数量
function DrawActivityModel:GetCoinNum()
    return self.CoinNum
end

---初始化保底奖池
function DrawActivityModel:InitMaxPools()
    self.maxPools = {}
    for _, v in pairs(self.info.max_id_list) do
        self.maxPools[v] = true
    end
end

function DrawActivityModel:InitNormalPools()
    local tb = {}
    local insert = _G.table.insert
    local tb2 = {}
    local id
    local count = #self.info.draw_id_list
    for i = 1, count do
        id = self.info.draw_id_list[i]
        if self:CheckIsMaxItem(id) then
            insert(tb, id)
        else
            insert(tb2, id)
        end
    end
    self.info.draw_id_list = tb2
    local count2 = #tb
    if count >= 10 then
        for i = 1, count2 do
            insert(self.info.draw_id_list, 10 - count2 + 1, tb[i])
        end
    else
        for i = 1, count2 do
            insert(self.info.draw_id_list, tb[i])
        end
    end
end

---初始化倒计时
function DrawActivityModel:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if not self.info.box_info then
        return
    end
    local minOffset = 0
    local offset = 0
    local time = _G.TimeUtil.GetServerUnixTime()
    for _, v in pairs(self.info.box_info) do
        if not self.canTakeBox[v.box_id] then
            offset = v.time + self:GetCfg(v.id).time - time
            if minOffset < offset then
                minOffset = offset
            end
        end
    end
    if minOffset <= 0 then
        return
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(minOffset, self.TimerOver, self, true, false, true)
    self.timer:Start()
end

---倒计时结束
function DrawActivityModel:TimerOver()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:UpdateCanTakeBox()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
    self:InitTimer()
end

---初始化可领取宝箱
function DrawActivityModel:UpdateCanTakeBox()
    self.canTakeBox = {}
    if self.info.box_info then
        local time = _G.TimeUtil.GetServerUnixTime()
        local endTime = 0
        for _, v in pairs(self.info.box_info) do
            endTime = v.time + self:GetCfg(v.id).time
            if time >= endTime then
                self.canTakeBox[v.box_id] = true
            end
        end
    end
end

---获取宝箱数据
---@return activity_theme.i_box
function DrawActivityModel:GetBoxData(index)
    if not self.info.box_info then
        return nil
    end
    return self.info.box_info[index]
end

---获取宝箱可领取时间
function DrawActivityModel:GetBoxDurationTime(id)
    if not self.cfgs[id] then
        return 0
    end
    return self.cfgs[id].time
end

---许愿
function DrawActivityModel:Draw(call)
    if self.info.box_info and #self.info.box_info >= 5 then
        _G.PopWindowManager:GetInstance():ShowAllTips(770101)
        return
    end
    if not self.coinSid then
        self.coinSid = require "ThemeActivityManager":GetInstance():GetCoinSid()
    end
    if self.info.draw_cost > self:GetCoinNum() then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.coinSid)
        return
    end
    local num = self:Draw_num()
    require "DrawActivityNet":GetInstance():Draw(
        {id = require "ThemeActivityManager":GetInstance():GetActivityID(), draw_num = num},
        _G.handlerbind(self, self.DrawCall, call, num)
    )
end

function DrawActivityModel:Draw_num()
    local Draw_num = 1
    local GetCoinNum = self:GetCoinNum()
    local GetConsume = self:GetConsume()
    if GetCoinNum > GetConsume then
        -- local Draw_num = GetCoinNum / GetConsume
        Draw_num = math.floor(GetCoinNum / GetConsume)
        if Draw_num > 10 then
            Draw_num = 10
        end
    end
    return Draw_num
end

