local base = require "BaseGameNet"

---@class DrawActivityNet : BaseGameNet	通信协议
local DrawActivityNet = _G.BaseClass("DrawActivityNet", base)

---@return DrawActivityNet DrawActivityNet
function DrawActivityNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---领取宝箱
---@param pbData activity_theme.c2s_activity_theme_box PB数据
---@param callback function 完成回调
function DrawActivityNet:GetBox(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_box
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---许愿
---@param pbData table PB数据
---@param callback function 完成回调
function DrawActivityNet:Draw(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_draw
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DrawActivityNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DrawActivityNet
_G.DrawActivityNet = DrawActivityNet
return DrawActivityNet
