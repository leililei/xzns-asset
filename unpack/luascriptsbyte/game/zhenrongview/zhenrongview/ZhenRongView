---刷新灵域巡查奖励按钮
---@return void
function ZhenRongView:RefreshAfk2RewardButton()
    if _G.IsNil(self.go_table.aorbtn_afk2Reward) then
        return
    end
    if not self:CheckOpen(_G.FunctionID.Afk2) then
        self.go_table.aorbtn_afk2Reward:SetActiveE(0)
        return
    end
    local model = require("Afk2Model"):GetInstance()
    if not model:CheckFunctionUnlock() or model:GetAfkSid() <= 0 then
        --功能未开启或未通关任何关卡
        self.go_table.aorbtn_afk2Reward:SetActiveE(0)
        return
    end
    local maxTime = model:GetAfkMaxTime()
    local duration = _G.TimeUtil.GetServerUnixTime() - model:GetAfkTime()
    if duration > maxTime then
        duration = maxTime
    elseif duration < 0 then
        duration = 0
    end
    --奖励达66%时长以上, 显示按钮
    self.go_table.aorbtn_afk2Reward:SetActiveE(duration >= maxTime * 0.66 and 1 or 0)
end

---初始化灵域巡查奖励图标
function ZhenRongView:InitAfk2RewardIcon(afk2RewardSid)
    if _G.IsNil(self.go_table.aorrawimage_afk2Reward) then
        return
    end
    if not afk2RewardSid then
        afk2RewardSid = _G.math.random() > 0.5 and 69 or 70
    end
    self.go_table.aorrawimage_afk2Reward:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(afk2RewardSid))
end

