---灵海之境
function ZhenRongView:OpenSea()
    if self:CheckOpen(16) then
        local function closeFun()
            self:Show()
        end
        local function openFun()
            self:Hide()
        end

        ---@type Params_CardDevelopView
        local data = {}
        data.closeFun = closeFun
        data.openFun = openFun
        self:SetMask(true)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardDevelopView.Name,
            data,
            function()
                self:SetMask(false)
            end
        )
    else
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(16)
    end
end

