    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_Stone"] = self.OpenGongmingStone,
        ["@_aorbtn_StarRiver"] = self.OpenStarRiver,
        --["@_aorbtn_SoulRepair"] = self.OpenSoulRepair,
        ["@_aorbtn_Sea"] = self.OpenSea,
        ["@_aorbtn_Collection"] = self.OpenCollection,
        ["@_aorbtn_Artifact"] = self.OpenArtifact,
        ["@_aorbtn_PetForest"] = self.OpenPetForest,
        ["@_aorbtn_afk2"] = self.OpenAfk2,
        ["@_aorbtn_afk2Reward"] = self.OnOpenAfk2Reward,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    UIUtils.LoadEffectByCfg(
        effPath.bg,
        self.go_table.aorrawimage_bg,
        function(tran)
        end
    )
end

