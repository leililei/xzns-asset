---按钮点击事件在这里派发
function ZhenRongView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

-- 方法
function ZhenRongView:CloseView()
    if self.callback then
        self.callback()
    end
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.InitButton, self)
    self:Close()
end

function ZhenRongView:PlayAnimUnlock(functionId, key, tb, text)
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local go = self.go_table[tb]
    if self:CheckOpen(functionId) then
        local value = _G.PlayerPrefsManager.GetInt(uid .. key)
        if value <= 0 then
            _G.PlayerPrefsManager.SetInt(uid .. key, 1)
            go:SetActiveE(1)
            self:PlayAnim(functionId, go, text)
        else
            text:SetActiveE(1)
            self:LoadBgEff(functionId)
        end
    else
        text:SetActiveE(0)
        go:SetActiveE(1)
    end
end

function ZhenRongView:PlayAnim(functionId, goTable, text)
    if functionId == 20 then
        self.unlockAnim.storne.enabled = true
    elseif functionId == 3 then
        self.unlockAnim.starRiver.enabled = true
        -- elseif functionId == 44 then
        --     self.unlockAnim.soulRepair.enabled = true
    elseif functionId == 16 then
        self.unlockAnim.Sea.enabled = true
    elseif functionId == 112 then
        self.unlockAnim.Collection.enabled = true
    elseif functionId == 145 then
        self.unlockAnim.artifact.enabled = true
    elseif functionId == 251 then
        self.unlockAnim.petForest.enabled = true
    elseif functionId == _G.FunctionID.Afk2 then
        self.unlockAnim.afk2.enabled = true
    end
    UIUtils.LoadEffectByCfg(
        ui_effect_cfg.ef_zhenrongJieSuo,
        goTable,
        nil,
        function()
            if not _G.IsNil(goTable) then
                goTable:SetActiveE(0)
                text:SetActiveE(1)
                self:LoadBgEff(functionId)
            end
        end
    )
end

