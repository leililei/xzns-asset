---@class InitialView
---@field go_table InitialView_GoTable
local InitialView = _G.BaseClass("InitialView", _G.UIBaseView)

local toggleSpriteName = "ui_hd_sc_cz_page2"
local GetLangPackValue = _G.GetLangPackValue
function InitialView:Awake()
    self.Animator = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.cashNum = require("InitialManager"):GetInstance():GetCashNum() or 0
    self.cashData = require("InitialManager"):GetInstance().cashData
    self.AwardData = require("InitialManager"):GetInstance().awardData or {}
    ---充值档位
    self.giftIdList = {}
    self.cashPriceList = {}
    local content
    for k, v in pairs(self.AwardData) do
        content = _G.GameUtil.SetPriceByChannel(v.price_id)
        self.cashPriceList[v.id] = content
        _G.table.insert(self.giftIdList, v.id)
    end
    _G.SortList(self.giftIdList, function(item) return -item end)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.curToggle = 0
    self.toggles = {}
    self.toggles[1] = _G.GetAutoGoTable(self.go_table.toggle_1)
    self.toggles[2] = _G.GetAutoGoTable(self.go_table.toggle_2)
    self.toggles[3] = _G.GetAutoGoTable(self.go_table.toggle_3)
    self:UpdateRedPoint()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    _G.Events:GetInstance():AddListener(_G.InitialEvents.RefreshUI, self.OnSixUpdate, self)

    _G.SDKManager:GetInstance():GameStepInfo(-70005)
    _G.SDKManager:GetInstance():MiniGameTrack(require("SDKDef").DotMsg.ShuShu.first_charge_popup)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function InitialView:OnCreate(callBack, jump, index)
    if callBack then
        self.callBack = callBack
    end
    if jump then
        self.jump = true
    end

    local upgradeItemNum = _G.GetAutoGoTable(self.go_table.obj_upgradeItemNum)
    upgradeItemNum.aorimage_num:SetActiveE(0)
    ---@type InitialView._obj_wupingkuang1_GoTable[]
    self.goodsTb = {}
    self.goodsTb[1] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang1, _G.handlerbind(self, self.XiangQingChaKan, 1))
    self.goodsTb[2] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang2, _G.handlerbind(self, self.XiangQingChaKan, 2))
    self.goodsTb[3] = _G.GetAutoGoTable(self.go_table.obj_wupingkuang3, _G.handlerbind(self, self.XiangQingChaKan, 3))
    self:SetToggle()

    if index then
        self.oldToggle = index
        if index ~= 3 then
            self:ChangeToggle(index)
        else
            self:OnClickSkinToggle()
        end
    else
        local checkGetAllAward = function(index)
            local _id = self.giftIdList[index]
            local data1 = self.cashData[_id]
            self.oldToggle = index
            if data1 then
                return true
            end

            return false
        end
        if checkGetAllAward(1) then
            if checkGetAllAward(2) then
                self:OnClickSkinToggle()
            else
                self:ChangeToggle(2)
            end
        else
            self:ChangeToggle(1)
        end
    end
    self:InitView()

    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_QianWangbtn, false)
end

function InitialView:SetToggle()
    if _G.table.isEmptyOrNil(self.cashData) then
        self.go_table.obj_toggles:SetActiveE(0)
    else
        self.go_table.obj_toggles:SetActiveE(1)
    end

    self.toggles[1].gameObject:SetActiveE(1)
    local id = self.giftIdList[1]
    self.toggles[2].gameObject:SetActiveE(self.cashData[id] and 1 or 0)
    self.toggles[3].gameObject:SetActiveE(self.cashData[id] and 1 or 0)
    local tb = self.toggles[2]
    if self.cashData[id] then
        tb.aorimage_isOff.SpriteName = toggleSpriteName .. "_n"
        tb.aorimage_isOn.SpriteName = toggleSpriteName .. "_c"
    end
end

function InitialView:InitView()
    local skinCfg = _G.ConfigManager.skin_cfg[113020001]
    local attrs = skinCfg.base_att
    local colorFormat = "<color=#5bdf99>%s</color>"
    local text = ""
    local str
    for i = 1, #attrs do
        if attrs[i][2] == 1 then
            str = _G.AttrType[attrs[i][1]].des .. _G.string.format(colorFormat, " +" .. attrs[i][3])
        else
            str =
            _G.AttrType[attrs[i][1]].des ..
                    _G.string.format(colorFormat, " +" .. _G.Mathf.RoundToInt(attrs[i][3] / 100) .. "%")
        end
        text = text .. str
        if i < #attrs then
            text = text .. "  "
        end
    end
    self.eff = {}
    self.isFirst = true
    if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.InitialView .. 1, "obj_prf") then
        self:InitEffAndAnimetion(1)
    end

    self.go_table.aortext_AttrInfo.text = text
    if self.jump then
        if self.cashData[self.giftIdList[2]] then
            self:OnToggle(3)
            self.go_table.toggle_3.isOn = true
            return
        end
    end
    self:OnToggle(self.oldToggle or 1)
end

function InitialView:InitEffAndAnimetion(index)
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end
    if not self.isEffLoad then
        self.isEffLoad = true
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouchongbg, self.go_table.obj_effBG1, check)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouchongbg2, self.go_table.obj_effBG2, check)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_chuxian, self.go_table.obj_chuxian, check)
    end
    if not _G.UIUtils.IsHaveChange("InitialView" .. index, "obj_prf") then
        _G.UIUtils.LoadEffectByPath(
                "WX_Role/Animation_UI/Yilidan_02_UI/prf_Yilidan_02_UI_ui",
                self.go_table.obj_prf,
                function(trans)
                    self.sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                    -- spine动画结束事件注册
                    self.sg.AnimationState:Complete("+", _G.handler(self, self.EffActionChange))
                    self.sg.AnimationState:ClearTracks()
                    self.sg.AnimationState:AddAnimation(0, "show", false, 0)
                    self.sg.AnimationState:AddAnimation(0, "idle", true, 0)

                    local boneEff = {
                        Point_tx001 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx001,
                        Point_tx002 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx002,
                        Point_tx004 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx004,
                        Point_tx005 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx005,
                        Point_tx006 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx006
                    }
                    local spObj, bone
                    for name, effCfg in pairs(boneEff) do
                        spObj = _G.InstantiateObject(self.go_table.obj_spineEff, trans)
                        bone = spObj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.BoneFollowerGraphic))
                        bone.skeletonGraphic = self.sg
                        bone.boneName = name
                        _G.UIUtils.LoadEffectByCfg(effCfg, spObj, check)
                    end
                end
        )
    else
        self.go_table.obj_prf:ClearChildren()
        _G.UIUtils.IsNeedChangeUI("InitialView" .. index, self.go_table)
    end
end

function InitialView:EffActionChange()
    if self.isFirst then
        self.isFirst = false
        for _, v in pairs(self.eff) do
            v:SetActiveE(1)
        end
    end
end

---判断当前首充是否开启
function InitialView:CoZhiPanDuan(index)
    local curData = self.cashData[self.giftIdList[index]]
    if curData == nil then
        self.go_table.aorbtn_QianWangbtn:SetActiveE(1)
        self.go_table.aorbtn_lingquBtn:SetActiveE(0)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(0)
        self.go_table.aorbtn_gray:SetActiveE(0)
        self.XuanZho = 99
    elseif not curData.index or curData.canTake > #curData.index then
        self.go_table.aorbtn_QianWangbtn:SetActiveE(0)
        self.go_table.aorbtn_lingquBtn:SetActiveE(1)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(0)
        self.go_table.aorbtn_gray:SetActiveE(0)
        self.XuanZho = curData.index and #curData.index + 1 or 1
    elseif #curData.index >= curData.canTake then
        self.go_table.aorbtn_QianWangbtn:SetActiveE(0)
        self.go_table.aorbtn_lingquBtn:SetActiveE(0)
        self.go_table.aorbtn_gray:SetActiveE(#curData.index == 3 and 1 or 0)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(#curData.index == 3 and 0 or 1)
        self.XuanZho = 99
    end
    self:CoZhiTimePanDuan(index)
end

function InitialView:OnSixUpdate()
    self.cashNum = require("InitialManager"):GetInstance():GetCashNum() or 0
    self.cashData = require("InitialManager"):GetInstance().cashData
    self.AwardData = require("InitialManager"):GetInstance().awardData
    self:UpdateRedPoint()
    self:SetToggle()
    self:CoZhiPanDuan(self.oldToggle)
    if self.oldToggle == 3 and self.initialSkinView then
        self.initialSkinView:EffectFinishCall()
        self.initialSkinView:RefreshButton()
        self.initialSkinView:Show()
    end
end

---充值时间判断
function InitialView:CoZhiTimePanDuan(index, tb, isSkinView)
    if require("InitialManager"):GetInstance():InitialBoll() == false then
        self:Close()
    end
    tb = tb or self.goodsTb
    local id = self.giftIdList[index]
    local jiangli
    for i = 1, 3 do
        jiangli = self:PanDuanBiao(id, i)
        --tb[i].aortext_theday.text = GetLangPackValue(90020400090, i)
        if _G.AppSetting.IsXzns and not isSkinView then
            tb[i].aortext_theday.text = _G.GetLangPackValue(90023800006, i)
        else
            tb[i].aortext_theday.text = "0" .. i
        end
        -- if jiangli == 0 then
        --     tb[i].aortext_tian.text = "<color=#B4C0F5>" .. GetLangPackValue(firstBtn[4]) .. "</color>"
        -- else
        --     tb[i].aortext_tian.text = "<color=#FFFFFF>" .. GetLangPackValue(firstBtn[i]) .. "</color>"
        -- end
        if self.XuanZho == i then
            tb[i].obj_wupineffect1:SetActiveE(1)
            tb[i].obj_wupineffect2:SetActiveE(1)
            if tb[i].obj_wupineffect1:GetChildCountE() < 1 then
                --_G.UIUtils.LoadEffectByCfg(
                --    _G.ConfigManager.ui_effect_cfg.ef_InitialView_kuang_loop,
                --    tb[i].obj_wupineffect1
                --)
                --_G.UIUtils.LoadEffectByCfg(
                --    _G.ConfigManager.ui_effect_cfg.ef_InitialView_kuang_loop,
                --    tb[i].obj_wupineffect2
                --)
            end
        else
            tb[i].obj_wupineffect1:SetActiveE(0)
            tb[i].obj_wupineffect2:SetActiveE(0)
        end
        if i == 1 then
            tb[i].aortext_TitleText.text = _G.GetLangPackValue(18900000088)
        else
            tb[i].aortext_TitleText.text = _G.GetLangPackValue(90025200009, _G.GameUtil.NumberToChinese(i))
        end

        self.WuXingChiShuJu = {}
        self.card_cfg = _G.ConfigManager.card_cfg
        self.WuXingChiShuJu = self.AwardData[id]["day" .. i]
        for j = 1, 4 do
            local data = self.WuXingChiShuJu[j]
            if data then
                local sid = data[1]
                local num = data[2]
                local numSid = { data[3] }
                tb[i]["aorimage_wupin" .. j]:RemoveAllChildren()
                self:tanQuanDianJi(sid, jiangli == 1, num, tb[i]["aorimage_wupin" .. j], numSid)
            end
            tb[i]["aorimage_wupin" .. j]:SetActiveE(data and 1 or 0)
        end
    end
end

--当前是一天的第几秒
function InitialView.GetSecondsOfDay(first_time)
    local now = first_time
    local zero = _G.TimeUtil.GetDayBegin(now)
    return now - zero
end

function InitialView:XiangQingChaKan(go, _, index)
    local name = go:GetName()
    if name == "@_aorbtn_diyitian" then
        self.XuanZho = index
        self:CoZhiTimePanDuan()
    end
end

---物品内容选中显示
function InitialView:tanQuanDianJi(Sid, isGou, number, Parent, numSid)
    _G.StorageManager:GetInstance():GetItemBaseView(
            Sid,
            number,
            Parent,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:SetGou(isGou)
                if item.go_table.aorrawimage_Icon then
                    item.go_table.aorrawimage_Icon:SetGray(isGou)
                end
                if item.go_table.aorimage_Color then
                    item.go_table.aorimage_Color:SetGray(isGou)
                end
                item.gameObject:SetLocalPosition(0, 0, 0)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local grade, type = _G.StorageManager:GetInstance():GetItemGrade(Sid)
                if grade > 3 or type == _G.StorageType.Spiritual or type == _G.StorageType.Artifact then
                    if item.ShowEffectOrder and not isGou then
                        item:ShowEffectOrder(true)
                    end
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid, nil, nil, numSid[1])
            end,
            numSid
    )
end

---判断是否已经领取奖励
function InitialView:PanDuanBiao(gear, day)
    if self.cashData[gear] and self.cashData[gear].index and self.cashData[gear].index[day] then
        return 1
    end
    return 0
end

function InitialView:DaKai()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.InitialView.Name)
end

---点击领取按钮
function InitialView:OnClickGetBtn()
    if self:CanTake() then
        require("InitialManager"):GetInstance():OpenTip(
                self.XuanZho,
                self.giftIdList[self.oldToggle],
                _G.handler(self, self.Updatetoggle)
        )
    end
end

---物品按钮
function InitialView:OnClickWuPin()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.InitialView.Name)
    require "CommonTipManager":GetInstance():OpenCardTip(self.WuXingChiShuJu[1].Data[1], nil, self.DaKai)
end

---按钮点击事件在这里派发
function InitialView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_guanbi" or name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_QianWangbtn" then
        local _data = self.AwardData[self.giftIdList[self.oldToggle]]
        if self.oldToggle == 1 then
            self.ClickFrist = true
        end
        require("MallManager"):GetInstance():BuyActiveGift(_data.price_id, nil, _data.id)
    elseif name == "@_aorbtn_lingquBtn" then
        self:OnClickGetBtn()
    elseif name == "@_aorbtn_mingrilingqu" then
        local content = GetLangPackValue(_G.ConfigManager.tips_system_cfg[470102].content)
        _G.PopWindowManager:GetInstance():ShowAllTips(470102, content, nil)
    elseif name == "@_aorbtn_wupin" then
        self:OnClickWuPin()
    elseif name == "@_aorbtn_yilingqu" then
        local content = GetLangPackValue(_G.ConfigManager.tips_system_cfg[470101].content)
        _G.PopWindowManager:GetInstance():ShowAllTips(470101, content, nil)
    elseif name == "$_toggle_1" then
        if isOn then
            self:OnToggle(1)
        end
    elseif name == "$_toggle_2" then
        if isOn then
            self:OnToggle(2)
        end
    elseif name == "$_toggle_3" then
        if isOn then
            self:OnClickSkinToggle()
        end
    end
end

function InitialView:ChangeToggle(index)
    if self.go_table["toggle_" .. index].isOn then
        self.go_table["toggle_" .. index].isOn = false
    end
    self.go_table["toggle_" .. index].isOn = true
end

---皮肤页签
function InitialView:OnClickSkinToggle()
    self.curToggle = 3
    self.oldToggle = 3
    if not self.initialSkinPanel then
        self.initialSkinPanel = true
        _G.PoolsManager:GetInstance():Spawn(
                _G.ConfigManager.ui_cfg.InitialSkinView.PrefabPath,
                _G.ePoolType.UIItem,
                self.go_table.obj_ViewParent,
                function(tran)
                    if self:IsNil() then
                        return
                    end
                    self.initialSkinPanel = tran
                    self.initialSkinView = self:AddComponent(tran, require("InitialSkinView").New(tran, self))
                    if not self.oldToggle or self.oldToggle == 3 then
                        self.initialSkinView:Show()
                    else
                        self.initialSkinView:Hide()
                    end
                end
        )
    elseif self.initialSkinPanel ~= true then
        self.initialSkinView:EffectFinishCall()
        self.initialSkinView:Show()
    end
    if _G.PlayerPrefsManager.GetInt("FirstCharge" .. 3, 0) == 0 then
        _G.PlayerPrefsManager.SetInt("FirstCharge" .. 3, 1)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstCharge.id)
        self:UpdateRedPoint()
    end
end

function InitialView:OnToggle(index)
    if self.curToggle == index then
        return
    end
    self.curToggle = index
    local id = self.giftIdList[index]
    local price_id = self.AwardData[id].price_id
    local cash = require "MallManager":GetInstance():GetFinalPrice(price_id)
    local curHaveCash = _G.GameUtil.RatioControl(self.cashNum)
    local isThird = index == 3 and 1 or 0

    local slogan = self.AwardData[id].slogan

    if _G.GameUtil.CheckVoucherModel() then
        slogan = self.AwardData[id].slogan_djq
    else
        if not _G.GameUtil.IsNotPlatformSpecial() then
            if _G.AppSetting.IsDouYinIos then
                slogan = self.AwardData[id].sloganios
            elseif _G.AppSetting.IsAlipayIos then
                slogan = self.AwardData[id].sloganzfb
            end
        end
    end

    if _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.InitialView .. index, "obj_prf") then
        self:InitEffAndAnimetion(index)
    end
    self.go_table.aorrawimage_txt:LoadImage(
            slogan,
            function(img)
                if self:IsNil() then
                    return
                end
                img:SetNativeSize()
            end
    )

    self.go_table.obj_textNormal:SetActiveE(isThird and 0 or 1)
    local dayColor = _G.ColorTools.FormatColorByString(isThird and "55c1e5" or "caccff")
    for i = 1, 3 do
        self.goodsTb[i].aortext_theday.color = dayColor
    end

    self.go_table.aortext_btnText.text = self.cashPriceList[id]
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_QianWangbtn, true)
    if not _G.AppSetting.IsOverseas then
        cash = _G.GameUtil.RatioControl(cash)
        curHaveCash = _G.GameUtil.RatioControl(curHaveCash)
    end
    local priceTxt = _G.GameUtil.GetPriceContentByNum(curHaveCash > cash and cash or curHaveCash, true)
    local priceCash = _G.GameUtil.GetPriceContentByNum(cash, true)
    self.go_table.aortext_tips.text = GetLangPackValue(90036300012, priceTxt, priceCash)
    if self.oldToggle then
        self.toggles[self.oldToggle].aortext_isOn:SetActiveE(0)
        self.toggles[self.oldToggle].aortext_isOff:SetActiveE(1)
    end
    self.toggles[index].aortext_isOn:SetActiveE(1)
    self.toggles[index].aortext_isOff:SetActiveE(0)
    self.oldToggle = index
    self:CoZhiPanDuan(index)
    if _G.PlayerPrefsManager.GetInt("FirstCharge" .. index, 0) == 0 then
        _G.PlayerPrefsManager.SetInt("FirstCharge" .. index, 1)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstCharge.id)
        self:UpdateRedPoint()
    end
end

function InitialView:Updatetoggle(id)
    self.cashData = require("InitialManager"):GetInstance().cashData
    -- 判断已领取奖励的次数
    if not require("InitialManager"):GetInstance():InitialBoll() then
        self:Close()
        return
    end
    local index = _G.table.indexof(self.giftIdList, id)
    if index and self.oldToggle == index then
        self:CoZhiPanDuan(index)
    else
        --首日版本屏蔽后续档位
        self.go_table["toggle_" .. index].isOn = true
    end
    if self.oldToggle == 3 then
        if self.initialSkinView then
            self.initialSkinView:EffectFinishCall()
            self.initialSkinView:RefreshButton()
            self.initialSkinView:Show()
        end
    else
        if self.initialSkinView then
            self.initialSkinView:Hide()
        end
    end
    self:UpdateRedPoint()
end

function InitialView:CanTake()
    local id = self.giftIdList[self.oldToggle]
    if self.cashData[id] then
        return self.cashData[id].canTake > self.XuanZho - 1
    else
        return false
    end
end

---响应界面关闭
function InitialView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.InitialEvents.RefreshUI, self.OnSixUpdate, self)
    if self.callBack then
        self.callBack()
    end
end

function InitialView:UpdateRedPoint(toggles)
    local child = {}
    child = require("InitialManager"):GetInstance():UpdateChild()
    toggles = toggles or self.toggles
    for i = 1, 3 do
        toggles[i].obj_redpoint:SetActiveE(child[i])
    end
end

return InitialView
