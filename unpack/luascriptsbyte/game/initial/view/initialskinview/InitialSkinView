---@class InitialSkinView : Component    中文描述
local InitialSkinView = _G.BaseClass("InitialSkinView", _G.Component)

---创建对象时,入口构造函数
function InitialSkinView:OnCreate(obj, initialView)
    self.initialView = initialView
    self.go_table = _G.GetAutoGoTable(obj, _G._G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        ["@_aorbtn_close"] = function()
            self.initialView:Close()
        end,
        ["$_toggle_tab1"] = function(self, go, isOn)
            if isOn then
                self.initialView:ChangeToggle(1)
                self:Hide()
            end
        end,
        ["$_toggle_tab2"] = function(self, go, isOn)
            if isOn then
                self.initialView:ChangeToggle(2)
                self:Hide()
            end
        end,
        ["@_aorbtn_QianWangbtn"] = function()
            local _data = self.initialView.AwardData[self.giftId]
            require("MallManager"):GetInstance():BuyActiveGift(_data.price_id, nil, _data.id)
        end,
        ["@_aorbtn_lingquBtn"] = function()
            self.initialView:OnClickGetBtn()
        end,
        ["@_aorbtn_mingrilingqu"] = function()
            local content = GetLangPackValue(_G.ConfigManager.tips_system_cfg[470102].content)
            _G.PopWindowManager:GetInstance():ShowAllTips(470102, content, nil)
        end,
        ["@_aorbtn_wupin"] = function()
            self.initialView:OnClickWuPin()
        end,
        ["@_aorbtn_yilingqu"] = function()
            local content = GetLangPackValue(_G.ConfigManager.tips_system_cfg[470101].content)
            _G.PopWindowManager:GetInstance():ShowAllTips(470101, content, nil)
        end,
        ["nilFnc"] = function()
        end
    }
    self.giftId = self.initialView.giftIdList[3]
    self:InitView()
    self:InitEffAndAnimetion()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_QianWangbtn, false)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
end

function InitialSkinView:Show()
    self.gameObject:SetActiveE(1)
    self.skinToggles[3].toggle_tab3.isOn = true
    self.initialView:CoZhiTimePanDuan(3, self.goodsTb, true)
    self.initialView:UpdateRedPoint(self.skinToggles)
    self:RefreshButton()
end

function InitialSkinView:Hide()
    self.gameObject:SetActiveE(0)
end

function InitialSkinView:InitView()
    self.goodsTb = {}
    self.goodsTb[1] = _G.GetAutoGoTable(
            self.go_table.obj_wupingkuang1,
            _G.handlerbind(self, self.initialView.XiangQingChaKan, 1)
    )
    self.goodsTb[2] = _G.GetAutoGoTable(
            self.go_table.obj_wupingkuang2,
            _G.handlerbind(self, self.initialView.XiangQingChaKan, 2)
    )
    self.goodsTb[3] = _G.GetAutoGoTable(
            self.go_table.obj_wupingkuang3,
            _G.handlerbind(self, self.initialView.XiangQingChaKan, 3)
    )
    UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.InitialSkinView, self.go_table)

    self.skinToggles = {}
    self.skinToggles[1] = _G.GetAutoGoTable(self.go_table.toggle_tab1)
    self.skinToggles[2] = _G.GetAutoGoTable(self.go_table.toggle_tab2)
    self.skinToggles[3] = _G.GetAutoGoTable(self.go_table.toggle_tab3)

    self.go_table.aortext_btnText.text = self.initialView.cashPriceList[self.giftId]
        
    if _G.GameUtil.CheckVoucherModel() then
        self.go_table.aorrawimage_title:LoadImage(
            self.initialView.AwardData[self.giftId].slogan_djq,
            function(img)
                if self.initialView:IsNil() then
                    return
                end
                img:SetNativeSize()
            end
        )
    elseif not _G.GameUtil.IsNotPlatformSpecial() then
        self.go_table.aorrawimage_title:LoadImage(
            self.initialView.AwardData[self.giftId].sloganzfb,
            function(img)
                if self.initialView:IsNil() then
                    return
                end
                img:SetNativeSize()
            end
        )
    end

    local sort = self.initialView.go_table.obj_ViewParent:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder
    self.go_table.obj_content:GetComponentE(_G.typeof(_G.Canvas)).sortingOrder = sort + 10
end

function InitialSkinView:EffectFinishCall()
    self.go_table.obj_chuxian:SetActiveE(0)
end

---初始化特效和动画
function InitialSkinView:InitEffAndAnimetion()
    local check = function(obj)
        if self.initialView:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouchongbg_skin, self.go_table.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouchongbg_skin_bg, self.go_table.obj_effBG, check)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_chuxian_skin,
            self.go_table.obj_chuxian,
            check
    )
    _G.UIUtils.LoadEffectByPath(
            "WX_Role/Animation_UI/Yilidanshizhuang_02_UI/prf_Yilidanshizhuang_02_UI_ui",
            self.go_table.obj_prf,
            function(trans)
                if not check(self.go_table.obj_prf) then
                    return
                end
                self.sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                if _G.AppSetting.IsXzns then
                    if _G.AppSetting.HeXieLevel == 0 then
                        self.sg.AnimationState:SetAnimation(0, "show2", true)
                        self.sg.AnimationState:Complete("+", function()
                            self.sg.AnimationState:SetAnimation(0, "idle", true)
                        end)
                    else
                        self.sg.AnimationState:SetAnimation(0, "idle2", true)
                    end
                else
                    -- spine动画结束事件注册
                    self.sg.AnimationState:Complete("+", _G.handler(self, self.initialView.EffActionChange))
                    self.sg.AnimationState:ClearTracks()
                    self.sg.AnimationState:AddAnimation(0, "show", false, 0)
                    self.sg.AnimationState:AddAnimation(0, "idle2", true, 0)
                end

                local boneEff = {
                    Point_tx001 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_skin_Point_tx001,
                    bone25 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_skin_Point_tx005,
                    bone31 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_skin_Point_tx006
                }
                local spObj, bone
                for name, effCfg in pairs(boneEff) do
                    spObj = _G.InstantiateObject(self.go_table.obj_spineEff, trans)
                    bone = spObj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.BoneFollowerGraphic))
                    bone.skeletonGraphic = self.sg
                    bone.boneName = name
                    _G.UIUtils.LoadEffectByCfg(effCfg, spObj, check)
                end
            end
    )
end

---判断当前首充是否开启
function InitialSkinView:RefreshButton()
    local curData = self.initialView.cashData[self.giftId]
    if curData == nil then
        self.go_table.aorbtn_QianWangbtn:SetActiveE(1)
        self.go_table.aorbtn_lingquBtn:SetActiveE(0)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(0)
        self.go_table.aorbtn_gray:SetActiveE(0)
        self.initialView.XuanZho = 99
    elseif not curData.index or curData.canTake > #curData.index then
        self.go_table.aorbtn_QianWangbtn:SetActiveE(0)
        self.go_table.aorbtn_lingquBtn:SetActiveE(1)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(0)
        self.go_table.aorbtn_gray:SetActiveE(0)
        self.initialView.XuanZho = curData.index and #curData.index + 1 or 1
    elseif #curData.index >= curData.canTake then
        self.go_table.aorbtn_QianWangbtn:SetActiveE(0)
        self.go_table.aorbtn_lingquBtn:SetActiveE(0)
        self.go_table.aorbtn_gray:SetActiveE(#curData.index == 3 and 1 or 0)
        self.go_table.aorbtn_mingrilingqu:SetActiveE(#curData.index == 3 and 0 or 1)
        self.initialView.XuanZho = 99
    end
end

---按钮点击事件在这里派发
function InitialSkinView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---销毁对象时,析构函数
function InitialSkinView:OnDestroy()
end

return InitialSkinView
