---@class InitialNet : BaseGameNet 通信协议
local InitialNet = _G.BaseClass("InitialNet", require("BaseGameNet"))
local base = require("BaseGameNet")
---@return InitialNet InitialNet
function InitialNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--领取奖励
---@param callback function 回调方法
function InitialNet:Award(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_first_get_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.AccessCall))
    self.Call[port] = callback
    -- body
end
---获取首充信息
function InitialNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_store_first_get_info
    local port = base.Access(self, item, "", _G.handlerbind(self, self.AccessCall))
    self.Call[port] = callback
    -- body
end


---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function InitialNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return InitialNet
