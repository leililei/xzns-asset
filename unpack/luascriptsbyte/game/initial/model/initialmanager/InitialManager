local base = require "GameDataModelBase"
---@class InitialManager:GameDataModelBase	中文描述
---@field card_cfg card_cfg
local InitialManager = _G.BaseClass("InitialManager", base)
local InitialNet = require "InitialNet"
local awardCfg = _G.ConfigManager.first_recharge_cfg
local insert = _G.table.insert
local isEmptyOrNil = _G.table.isEmptyOrNil
function InitialManager:__init()
    --_G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.awardData = {}
    for k, v in pairs(awardCfg) do
        local data = {}
        data.id = v.id
        data.price_id = v.price_id
        data.day1 = v.rewards_1
        data.day2 = v.rewards_2
        data.day3 = v.rewards_3
        data.slogan = v.slogan
        data.pre_sid = v.pre_sid
        data.sloganios = v.sloganios
        data.sloganzfb = v.sloganzfb
        data.slogan_djq = v.slogan_djq
        data.isActive = false
        self.awardData[v.id] = data
    end
    self.giftIdList = {}
    for k, v in pairs(self.awardData) do
        _G.table.insert(self.giftIdList, v.id)
    end
    _G.SortList(self.giftIdList, function(item) return -item end)
end

function InitialManager:GetDataFormServer()
    InitialNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---解析数据
---@param data table 服务器返回数据
function InitialManager:ParseData(data)
    self.cashNum = data.cash_num
    self.cashData = {}
    local firstCash = data.first_cash or {}
    for _, v in pairs(firstCash) do
        self.cashData[v.sid] = v
    end
    if not isEmptyOrNil(self.cashData) then
        self:SetCanGetDay()
    end
    base.ParseData(self)
    _G.Events:GetInstance():Broadcast(_G.InitialEvents.RefreshUI) --界面刷新
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstCharge.id)
end

function InitialManager:ReConnect(endcall)
    -- if endcall ~= nil then
    --     endcall(self.__cname)
    -- end
    self:InitData(endcall)
end

function InitialManager:ChuShiHua()
    self.WuXingChiShuJu = {}
    self.card_cfg = _G.ConfigManager.card_cfg
    self.discrete_cfg = _G.ConfigManager.discrete_cfg[1038]
    for key, value in pairs(self.discrete_cfg) do
        self.WuXingChiShuJu[key] = {}
        self.WuXingChiShuJu[key].Data = value
    end
end

function InitialManager:GetIndexByID(id)
    return _G.table.indexof(self.giftIdList, id)
end

--是否显示首充
function InitialManager.InitialPanDuan()
    return require("InitialManager"):GetInstance():InitialBoll()
end

---登录弹出判断
function InitialManager:TanChuPanDuan()
    --local id = _G.ConfigManager.discrete_cfg[45][1][1]
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(45) then
        if isEmptyOrNil(self.cashData) then
            return true
        end
        local DQtime = _G.TimeUtil.GetServerUnixTime()
        for k, v in pairs(self.cashData) do
            if not v.index then
                return true
            end
            if #v.index < 3 then
                self.DQKeXuanZho = _G.TimeUtil.GetInterValDayByGame(v.start, DQtime) + 1
                if self.DQKeXuanZho > #v.index then
                    return true
                end
            end
        end
    end
    return false
end

--是否显示首充.false是关闭,true是显示
function InitialManager:InitialBoll()
    local count = 0
    if isEmptyOrNil(self.cashData) then
        return true
    end
    for k, v in pairs(self.cashData) do
        if v.index and #v.index >= 3 then
            count = count + 1
        end
    end
    if count < 3 then
        return true
    else
        return false
    end
end

--是否显示首充红点.false是关闭,true是显示
function InitialManager:InitialBolls()
    if isEmptyOrNil(self.cashData) then
        return false
    end
    for k, v in pairs(self.cashData) do
        local num = self:GetIndexByID(k)
        if num == 1 then
            for i = 2, 3 do
                if _G.PlayerPrefsManager.GetInt("FirstCharge" .. i, 0) == 0 then
                    return true
                end
            end
        end
        if not v.index then
            return true
        end
        if #v.index < 3 then
            if v.canTake > #v.index then
                return true
            end
        end
    end
    return false
end

---领取奖励
---@param callback function 回调方法
function InitialManager:OpenTip(id, gear, callBack)
    ---@type store.c2s_get_first_award
    self.msg = {}
    self.msg.index = id
    self.gear = gear
    self.msg.sid = self.awardData[gear].id
    self.callback = callBack
    InitialNet:GetInstance():Award(self.msg, _G.handler(self, self.GetIllustrationNew))
end

---刷新
function InitialManager:GetIllustrationNew(msg)
    ---首充的数据
    if msg.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    local showCard = false
    if msg.award.item then
        for k, v in pairs(msg.award.item) do
            if v.type[1] == 121060000 then
                showCard = true
                break
            end
        end
    elseif msg.award.overflow then
        for k, v in pairs(msg.award.overflow) do
            if v.type[1] == 121060000 then
                showCard = true
                break
            end
        end
    end
    if showCard then
        local cardData = _G.ConfigManager.card_cfg[121060000]
        require "IllustrationModel":GetInstance():JieSuoHunJiang(121060000)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DrawResultRoleView.Name,
            cardData,
            _G.handlerbind(self, self.jiangli, msg)
        )
    else
        self:jiangli(msg)
    end
    if not self.cashData[self.gear].index then
        self.cashData[self.gear].index = {}
    end
    local index = self.msg.index
    insert(self.cashData[self.gear].index, index)
    if self:InitialBoll() == false then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.OnePay)
    end
    if self.callback then
        self.callback(self:InitLocalView(self.gear))
        self.callback = nil
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstCharge.id)
end

function InitialManager:jiangli(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
end

function InitialManager:InitLocalView(id)
    if isEmptyOrNil(self.cashData) then
        return id
    end

    if self.cashData[id] then
        if self.cashData[id].canTake > #self.cashData[id].index then
            return id
        end
    end

    for k, v in pairs(self.cashData) do
        if v.index then
            if v.canTake > #v.index then
                return k
            end
        else
            return k
        end
    end

    return self.gear or 1
end

function InitialManager:SetCanGetDay()
    local DQtime = _G.TimeUtil.GetServerUnixTime()
    local DQKeXuanZho = 0
    for k, v in pairs(self.cashData) do
        DQKeXuanZho = _G.TimeUtil.GetInterValDayByGame(v.start, DQtime) + 1
        v.canTake = DQKeXuanZho > 3 and 3 or DQKeXuanZho
        self.awardData[k].isActive = true
    end
end

function InitialManager:UpdateCashNum(sid, num)
    self.cashNum = num + self.cashNum
    for k, v in pairs(self.awardData) do
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(v.price_id)
        if v.id == sid and self.cashNum >= finalPrice and not v.isActive then
            v.isActive = true
            self:GetDataFormServer()
        end
    end
end

function InitialManager:GetCashNum()
    return self.cashNum
end

function InitialManager:UpdateChild()
    local child = { 0, 0, 0 }
    for k, v in pairs(self.cashData) do
        local index = self:GetIndexByID(k)
        if index == 1 then
            for i = 2, 3 do
                if _G.PlayerPrefsManager.GetInt("FirstCharge" .. i, 0) == 0 then
                    child[i] = 1
                end
            end
        end
        if v.index then
            if v.canTake > #v.index and #v.index < 3 then
                child[index] = 1
            end
        else
            child[index] = 1
        end
    end
    return child
end

return InitialManager
