---@class SociatyShopModel : Singleton	中文描述
local SociatyShopModel = _G.BaseClass("SociatyShopModel", _G.GameDataModelBase)

---@return SociatyShopModel SociatyShopModel
function SociatyShopModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SociatyShopModel:__init()
    self.curFunctionOpenID = _G.FunctionID.SociatyShop
    ---当前商品状态
    self.GoodsStatusEnum = {
        CanBargain = 0,
        CanPurchase = 1,
        Purchased = 2
    }
    self.goods = {}
end

function SociatyShopModel:ReConnect(endcall)
    self:InitData(endcall)
end

