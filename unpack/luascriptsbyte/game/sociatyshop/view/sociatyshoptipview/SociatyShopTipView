---@class SociatyShopTipView : UIBaseView	中文描述
---@field public go_table SociatyShopTipView_GoTable GoTable
local SociatyShopTipView = _G.BaseClass("SociatyShopTipView", _G.UIBaseView)

function SociatyShopTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyShopTipView:OnCreate()
    self:RefreshView()
end

---未砍价公会成员列表
function SociatyShopTipView:RefreshView()
    local sociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    sociatySelf:GetMemberModule():SortMemberByManager()
    local member = sociatySelf:GetMemberModule().Member
    local bargainList = require("SociatyShopModel"):GetInstance():GetBargainList()
    local bargainUidList = {}
    for _, v in pairs(bargainList) do
        bargainUidList[v.uid] = true
    end
    self.memberDataList = {}
    for _, v in ipairs(member) do
        if not bargainUidList[v.Uid] then
            _G.table.insert(self.memberDataList, v)
        end
    end

    local count = #self.memberDataList
    self.go_table.obj_empty:SetActiveE(count > 0 and 0 or 1)
    self.go_table.scrollloopvectical_member:SetActiveE(count > 0 and 1 or 0)
    if count > 0 then
        if not self.initListView then
            self.go_table.scrollloopvectical_member:InitItemData(count, _G.handler(self, self.RefreshMemberItem))
            self.initListView = true
        else
            self.go_table.scrollloopvectical_member:UpdateCount(count)
        end
    end
end

function SociatyShopTipView:RefreshMemberItem(index, obj)
    local nIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.memberDataList[nIndex]

    tb.aortext_name.text = data.Name
    tb.aortext_time.text = self:GetOfflineStateDesc(data.OfflineTime)
    tb.aorimage_bg:SetActiveE(nIndex % 2 == 0 and 1 or 0)
end

---获取离线状态描述
function SociatyShopTipView:GetOfflineStateDesc(time)
    local offlineDes
    if time > 0 then
        local left = _G.TimeUtil.GetServerUnixTime() - time
        if left < _G.TimeUtil.SECOND_OF_DAY then
            offlineDes = _G.LangUtil.GetLangPackValue(90021800065,
                math.max(math.floor(left / _G.TimeUtil.SECOND_OF_HOUR), 1))
        else
            offlineDes = _G.LangUtil.GetLangPackValue(90021800066,
                math.min(math.floor(left / _G.TimeUtil.SECOND_OF_DAY), 7))
        end
    else
        offlineDes = _G.LangUtil.GetLangPackValue(90022500846)
    end
    return offlineDes
end

---界面的销毁函数
function SociatyShopTipView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyShopTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_mask then
        self:Close()
    end
end

return SociatyShopTipView