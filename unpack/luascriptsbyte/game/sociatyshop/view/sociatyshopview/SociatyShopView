---@class SociatyShopView : UIBaseView	中文描述
---@field public go_table SociatyShopView_GoTable GoTable
local SociatyShopView = _G.BaseClass("SociatyShopView", _G.UIBaseView)

function SociatyShopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyShopView:OnCreate()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.SociatyShopView,self.go_table)
    self:PlayBubbleAnim()
    self:RefreshView()
    self:RefreshReward()
    self:RefreshButton()
    self:RefreshFinishTimer()
    self.go_table.obj_bargainredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SociatyShopBargain.id)
    self.go_table.obj_buyredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SociatyShopBuy.id)
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnMemberChange)
    self:AddListener(_G.eSociatyEvent.MasterBuildLevelChange, self.OnMemberChange)
end

---成员变化
function SociatyShopView:OnMemberChange()
    local model = require("SociatyShopModel"):GetInstance()
    local memberCount = require("SociatyModel"):GetInstance().SociatySelf.SociatyMemberModule:GetMaxMemberNum()
    self.go_table.aortext_bargain.text = _G.GetLangPackValue(90033100004, model:GetBargainNum(), memberCount)
end

---气泡出现动画
function SociatyShopView:PlayBubbleAnim()
    if not self.bubbleRect then
        self.bubbleRect = self.go_table.aorrawimage_bubble:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    end
    local price = require("SociatyShopModel"):GetInstance():GetPrice()
    if not price or price > 0 then
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90033100002)
    else
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90033100003)
    end
    self.go_table.aorrawimage_bubble:SetActiveE(1)
    self.bubbleRect:SetLocalScaleXYZ(0)
    self.bubbleRect:DOScale(1, 1, 1, 0.4)
end

---刷新砍价奖励
function SociatyShopView:RefreshReward()
    local cfg = _G.ConfigManager.guild_level_cfg[require("SociatyShopModel"):GetInstance():GetSociatyLevel()]
    if cfg then
        local sid = cfg.cut_price[1]
        self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(sid))
        self.reward = cfg.cut_reward or {}
        if not self.rewardListView then
            self.go_table.scrollloophorizontal_reward:InitItemData(#self.reward, _G.handler(self, self.RefreshRewardItem))
            self.rewardListView = self.go_table.scrollloophorizontal_reward
        else
            self.rewardListView:UpdateCount(#self.reward)
        end
    end
end

---刷新界面
function SociatyShopView:RefreshView()
    local model = require("SociatyShopModel"):GetInstance()
    local price = model:GetPrice()

    local cfg = _G.ConfigManager.guild_level_cfg[model:GetSociatyLevel()]
    if cfg.cut_price then
        local sid, num = cfg.cut_price[1], cfg.cut_price[2]
        self.curResSid = sid
        ---价格：原价
        local iconPath = _G.StorageManager:GetInstance():GetItemIcon(sid)
        self.go_table.aorrawimage_originIcon:LoadImage(iconPath)
        self.go_table.aortext_originPrice.text = num
        ---价格：现价
        self.go_table.aorrawimage_curIcon:LoadImage(iconPath)
        self.go_table.aortext_curPrice.text = price or num
    end
    self:RefreshBargainInfo()
end

---刷新砍价信息
function SociatyShopView:RefreshBargainInfo()
    local model = require("SociatyShopModel"):GetInstance()
    local memberCount = require("SociatyModel"):GetInstance().SociatySelf.SociatyMemberModule:GetMaxMemberNum()
    self.go_table.aortext_bargain.text = _G.GetLangPackValue(90033100004, model:GetBargainNum(), memberCount)

    ---砍价记录
    self.bargainList = model:GetBargainList()
    _G.SortList(self.bargainList, function(data)
        return data.price
    end)
    local totalPrice = 0
    for _, v in ipairs(self.bargainList) do
        totalPrice = totalPrice + v.price
    end
    self.go_table.aortext_price.text = totalPrice

    local recordNum = #self.bargainList
    self.go_table.obj_recordEmpty:SetActiveE(recordNum <= 0 and 1 or 0)
    self.go_table.scrollloopvectical_record:SetActiveE(recordNum > 0 and 1 or 0)
    if recordNum > 0 then
        if not self.recordListView then
            self.go_table.scrollloopvectical_record:InitItemData(#self.bargainList,
                _G.handler(self, self.RefreshBargainItem))
            self.recordListView = self.go_table.scrollloopvectical_record
        else
            self.recordListView:UpdateCount(#self.bargainList)
        end
    end
end

function SociatyShopView:RefreshRewardItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    _G.UIUtils.RemoveChildren(tb.obj_root)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.reward[index + 1],
        tb.obj_root,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran.gameObject)
                return
            end
            if tran.ShowNumText then
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        end
    )
end

function SociatyShopView:RefreshBargainItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local nIndex = index + 1
    local data = self.bargainList[nIndex]
    tb.aortext_name.text = nIndex .. "." .. data.name
    tb.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.curResSid))
    tb.aortext_price.text = data.price
    tb.aortext_status:SetActiveE(require("SociatyShopModel"):GetInstance():CheckBuy(data.uid) and 1 or 0)
end

---刷新按钮
function SociatyShopView:RefreshButton()
    local status = require("SociatyShopModel"):GetInstance():GetGoodsStatus()
    local statusEnum = require("SociatyShopModel"):GetInstance().GoodsStatusEnum
    self.go_table.aorbtn_bargain:SetActiveE(statusEnum.CanBargain == status and 1 or 0)
    self.go_table.aorbtn_buy:SetActiveE(statusEnum.CanPurchase == status and 1 or 0)
    self.go_table.aorbtn_purchased:SetActiveE(statusEnum.Purchased == status and 1 or 0)
    self.go_table.aorbtn_purchased:SetGray(statusEnum.Purchased == status)
    if statusEnum.CanPurchase == status then
        if not self.curResSid then
            local cfg = _G.ConfigManager.guild_level_cfg[require("SociatyShopModel"):GetInstance():GetSociatyLevel()]
            if cfg.cut_price then
                self.curResSid = cfg.cut_price[1]
            end
        end
        self.go_table.aorrawimage_buyRes:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.curResSid))
        self.go_table.aortext_buyPrice.text = require("SociatyShopModel"):GetInstance():GetPrice()
    end
end

---离开倒计时
function SociatyShopView:RefreshFinishTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    self.startTime, self.endTime = require("SociatyShopModel"):GetInstance():GetTime()
    if serverTime >= self.startTime and serverTime < self.endTime then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false)
        self.timer:Start()
        self:RefreshTime()
    else
        self:Close()
    end
end

function SociatyShopView:RefreshTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime < serverTime then
        self:Close()
    else
        self.go_table.aortext_countdown.text = _G.GetLangPackValue(90033100009,
            _G.TimeUtil.TranslateSecondForStr(self.endTime - serverTime))
    end
end

---砍价成功回调
function SociatyShopView:OnBargainSuc()
    self:RefreshButton()
    self:RefreshView()
end

---购买成功回调
function SociatyShopView:OnBuySuc()
    self:RefreshButton()
    self:RefreshBargainInfo()
end

---界面的销毁函数
function SociatyShopView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
    end
end

---按钮点击事件在这里派发
function SociatyShopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyShopTipView.Name)
    elseif go == self.go_table.aorbtn_bargain then
        if not require("SociatyShopModel"):GetInstance():CheckBargain() then
            return
        end
        if require("SociatyShopModel"):GetInstance():MaxBargain() then
            _G.PopWindowManager:GetInstance():ShowAllTips(8001)
            self:RefreshButton()
            return
        end
        require("SociatyShopModel"):GetInstance():SendBargain(_G.handler(self, self.OnBargainSuc))
    elseif go == self.go_table.aorbtn_buy then
        local model = require("SociatyShopModel"):GetInstance()
        local price = model:GetPrice()

        local cfg = _G.ConfigManager.guild_level_cfg[require("SociatyShopModel"):GetInstance():GetSociatyLevel()]
        if cfg then
            local sid = cfg.cut_price[1]
            local param = price .. _G.StorageManager:GetInstance():GetItemName(sid)

            _G.PopWindowManager:GetInstance():ShowAllTips(826, nil, function()
                require("SociatyShopModel"):GetInstance():SendBuy(sid, _G.handler(self, self.OnBuySuc))
            end, nil, nil, nil, param)
        end
    end
end

return SociatyShopView
