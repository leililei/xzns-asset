local base = require("BaseGameNet")

---@class SociatyShopNet : BaseGameNet	通信协议
local SociatyShopNet = _G.BaseClass("SociatyShopNet", base)
---@return SociatyShopNet SociatyShopNet
function SociatyShopNet:GetInstance()
    return  base.GetInstance(self)
end

---公会旅行商人-获取信息
---@param callback function 完成回调
function SociatyShopNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_vender_port_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---公会旅行商人-砍价
---@param callback function 完成回调
function SociatyShopNet:SendBargain(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_vender_port_bargain
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---公会旅行商人-购买
---@param callback function 完成回调
function SociatyShopNet:SendBuy(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_vender_port_buy
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SociatyShopNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SociatyShopNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return SociatyShopNet