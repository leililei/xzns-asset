local base = require "CycleBattlePassSynBaseModel"
---@class TalentBattlePassSynModel : CycleBattlePassSynBaseModel	中文描述
local TalentBattlePassSynModel = _G.BaseClass("TalentBattlePassSynModel", base)

---创建对象时,入口构造函数
function TalentBattlePassSynModel:__init()
    self.bId = self.CycleBattlePassModel.BattlePassIDEnum.Talent
    self.storeBattleId = 707001
    self.cfg = _G.ConfigManager.store_season_battle_cfg[self.storeBattleId]
    self.expBuyRate  = _G.ConfigManager.discrete_cfg[114107][1][1]
end

function TalentBattlePassSynModel:JumpToFunction()
    _G.JumpManager:GetInstance():Jump(104001)
end

function TalentBattlePassSynModel:GetMaxDayExp()
    return 0
end

function TalentBattlePassSynModel:GetExpTipStr()
    return _G.GetLangPackValue(90031100017)
end

---获取战令帮助文本id
---@overload 
---@return number
function TalentBattlePassSynModel:GetHelpId()
    return 115
end

---@overload
function TalentBattlePassSynModel:IsAddBtnShow()
    local leftTime = self:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    local time = _G.ConfigManager.discrete_cfg[114110][1][1] * 86400
    return leftTime <= time
end

return TalentBattlePassSynModel