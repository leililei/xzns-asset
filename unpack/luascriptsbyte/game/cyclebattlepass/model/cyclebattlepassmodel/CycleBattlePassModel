function CycleBattlePassModel:ChoosePath(id, path, callback)
    local pbData = {b_id = id, path = path}
    CycleBattlePassNet:GetInstance():ChoosePath(
        pbData,
        function(msg)
            if msg.ack == 1 then
                self.bpInfo[id].choose_path = path
                if callback then
                    callback()
                end
            end
        end
    )
end

---领取奖励
---@param id number 用于服务器交互的战令id
---@param awardLis cycle_battle.i_battle_award[] 奖励列表
function CycleBattlePassModel:GetAward(id, awardLis, callback)
    local pbData = {b_id = id, b_award = awardLis}
    CycleBattlePassNet:GetInstance():GetAward(
        pbData,
        function(msg)
            if msg.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                for _, v in pairs(awardLis) do
                    if v.type == 1 then
                        _G.table.insert(self.bpInfo[id].free_award, v.sid)
                    elseif v.type == 2 then
                        _G.table.insert(self.bpInfo[id].pay_award, v.sid)
                    elseif v.type == 3 then
                        _G.table.insert(self.bpInfo[id].free_award, v.sid)
                        _G.table.insert(self.bpInfo[id].pay_award, v.sid)
                    elseif v.type == 4 then
                        _G.table.insert(self.bpInfo[id].second_pay_award, v.sid)
                    elseif v.type == 5 then
                        _G.table.insert(self.bpInfo[id].free_award, v.sid)
                        _G.table.insert(self.bpInfo[id].pay_award, v.sid)
                        _G.table.insert(self.bpInfo[id].second_pay_award, v.sid)
                    end
                end
                if callback then
                    callback()
                end
            end
        end
    )
end

---购买经验
---@param id number 用于服务器交互的战令id
---@param exp number 经验值
---@param rate number x魂玉1经验倍率
function CycleBattlePassModel:BuyExp(id, exp, rate, callback)
    local pbData = {id = id, exp = exp}
    CycleBattlePassNet:GetInstance():BuyExp(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.bpInfo[id].exp = self.bpInfo[id].exp + exp
            _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, exp * rate)
            -- _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.AddBPExpEnd)
            if callback then
                callback()
            end
        end
    )
end

