---增加经验
---@param id number 用于服务器交互的战令id
---@param exp number 经验值
function CycleBattlePassModel:AddExp(id, exp)
    local info = self.bpInfo and self.bpInfo[id]
    if info == nil then
        return
    end
    if id == self.BattlePassIDEnum.Arena then
        if info.day_exp + exp > DayExpMax.Arena then
            exp = DayExpMax.Arena - info.day_exp
        end
    end
    info.day_exp = info.day_exp + exp
    info.exp = info.exp + exp
    _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.AddBPExpEnd)
end

