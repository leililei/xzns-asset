---@param sCfg store_season_battle_cfg
---@return number, number, number
function CycleBattlePassModel:GetLvExpByLv(id, sCfg, lv)
    local exp = 0
    local path = self:GetChossePath(id)
    sCfg = sCfg or _G.ConfigManager.store_season_battle_cfg[StoreSeasonID[id]]
    if path == 0 then
        path = sCfg.content[1]
    end
    local cfg = _G.ConfigManager.store_battle_theme_cfg[path]
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local lvLis = cfg.content[1]
    local conCfg, curLvMaxExp
    for _, v in pairs(lvLis) do
        conCfg = store_season_battlecon_cfg[v]
        curLvMaxExp = conCfg.conditions[2]
        if conCfg.level <= lv then
            exp = exp + curLvMaxExp
        end
    end

    return exp
end

