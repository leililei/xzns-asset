---初始化开启的战令总数
function CycleBattlePassModel:InitBattlePassNum()
    ---@type activity_info_cfg
    local cfg, funCfg
    if self.bpNum == 0 then
        self.bpOpen = {}
        for i, id in pairs(ActivityID) do
            cfg = ConfigManager.activity_info_cfg[id]
            if cfg then
                self.bpOpen[i] = 0
                funCfg = _G.ConfigManager.function_open_cfg[cfg.condition_display[1]]
                if _G.GlobalConditionManager.CheckConditionByArray(funCfg.condition_type) then
                    self.bpOpen[i] = 1
                    self.bpNum = self.bpNum + 1
                end
            end
        end
        for k, v in pairs(BpOpenId) do
            self.bpOpen[k] = 0
            if _G.GlobalConditionManager.CheckConditionByArray(ConfigManager.function_open_cfg[v].condition_type) then
                self.bpOpen[k] = 1
                self.bpNum = self.bpNum + 1
            end
        end
    end
end

---检测红点状态
---@param id number 用于服务器交互的战令id
---@param lv number 当前等级
function CycleBattlePassModel:CheckeRedPoint(id, lv)
    if self.bpInfo == nil then --尚未查明原因，添加容错
        return 0
    end
    if self.bpInfo[id] == nil then --开启新战令
        return 0
    end
    if self:GetEndTime(id) < _G.TimeUtil.GetServerUnixTime() then --开启新战令
        return 1
    end
    if _G.AppSetting.IsXzns and id == 3 then
        -- 灵脉战令（每周任务）在每日任务没有解锁时，不显示红点
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(21) then
            return 0
        end
    end
    lv = lv or self:GetLvAndCurLvExp(id)
    local path = self.bpInfo[id].choose_path
    if path == 0 then --未选择路线
        local key = "CycleBattlePassPath" .. id .. _G.PlayerModel:GetInstance():GetPlayerUid()
        local time = _G.PlayerPrefsManager.GetInt(key, 0)
        if time == _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()) then
            return 0
        end
        return 1
    end
    local content = ConfigManager.store_battle_theme_cfg[path].content[1]
    local store_season_battlecon_cfg = ConfigManager.store_season_battlecon_cfg
    local isBuy = self:GetIsBuy(id)
    ---@type store_season_battlecon_cfg
    local cfg, free, pay
    for _, v in pairs(content) do
        cfg = store_season_battlecon_cfg[v]
        if lv >= cfg.level then
            free = not self:CheckAwardIsGet(id, v, true)
            pay = isBuy and not self:CheckAwardIsGet(id, v, false)
            if free or pay then
                return 1
            end
        end
    end
    return 0
end

