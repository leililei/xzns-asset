---二档战令充值成功
---@param id number 用于服务器交互的战令id
function CycleBattlePassModel:OnHighMallCashEnd(id)
    self.bpInfo[id].is_buy_high = 1
end

function CycleBattlePassModel:CheckSingleIsOpen(id)
    return self.bpOpen[id] == 1 and self.bpInfo[id] ~= nil
end

---获取任务信息
function CycleBattlePassModel:GetTaskInfo(id)
    local pbData = {id = id}
    CycleBattlePassNet:GetInstance():GetTaskInfo(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:ClearTask(id)
            self.taskList[id] = {}
            self.finishTaskList[id] = {}
            if msg.task then
                for _, v in pairs(msg.task) do
                    _G.table.insert(
                        self.taskList[id],
                        CycleBattlePassTaskData.New(
                            v,
                            function()
                                _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPTaskFinish, id)
                            end,
                            _G.MarkTaskType.CycleBattlePass
                        )
                    )
                end
            end
            if msg.finish_task then
                local iTask
                for _, v in pairs(msg.finish_task) do
                    iTask = {sid = v, state = _G.TaskEnum.ETaskState.Submited, target = {0}}
                    _G.table.insert(
                        self.taskList[id],
                        CycleBattlePassTaskData.New(iTask, nil, _G.MarkTaskType.CycleBattlePass)
                    )
                    self.finishTaskList[id][v] = true
                end
            end
            _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPTaskUpdate, id)
        end
    )
end

---完成任务
---@param finishType number 1预完成 2提交领奖
function CycleBattlePassModel:FinishTask(id, taskIds, finishType, call)
    if _G.table.isEmptyOrNil(taskIds) then
        return
    end
    local pbData = {id = id, task_sid = taskIds, finish_type = finishType}
    CycleBattlePassNet:GetInstance():FinishTask(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local perExp = 0
            if id == self.BattlePassIDEnum.Sociaty then
                perExp = _G.ConfigManager.discrete_cfg[126302][1][1]
            elseif id == self.BattlePassIDEnum.Build then
                perExp = _G.ConfigManager.discrete_cfg[126606][1][1]
            elseif id == self.BattlePassIDEnum.Spoils then
                perExp = _G.ConfigManager.discrete_cfg[126612][1][1]
            elseif id == self.BattlePassIDEnum.FlowerGod then
                perExp = _G.ConfigManager.discrete_cfg[202102][1][1]
            end
            if msg.task_finish then
                for _, v in pairs(msg.task_finish) do
                    if v.v == 1 then
                        self.finishTaskList[id][v.k] = true
                        self:AddExp(id, perExp)
                    end
                end
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            if call then
                call(msg)
            end
        end
    )
end

---获取所有可完成的任务
function CycleBattlePassModel:GetAllCanFinishTask(id)
    local taskIds = {}
    if self.taskList[id] then
        for _, v in pairs(self.taskList[id]) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited and not self:CheckTaskIsFinish(id, v.i_task.sid) then
                _G.table.insert(taskIds, v.i_task.sid)
            end
        end
    end
    return taskIds
end

function CycleBattlePassModel:ClearTask(id)
    if self.taskList[id] == nil then
        return
    end
    for _, v in pairs(self.taskList[id]) do
        v:Dispose()
    end
    self.taskList[id] = nil
    self.finishTaskList[id] = nil
end

function CycleBattlePassModel:CheckTaskRedPoint(id)
    if self.taskList[id] == nil then
        return 0
    end
    return #self:GetAllCanFinishTask(id) > 0 and 1 or 0
end

---获取任务数据
function CycleBattlePassModel:GetTaskData(id)
    return self.taskList[id] or {}
end

function CycleBattlePassModel:CheckTaskIsFinish(id, sid)
    if self.finishTaskList[id] == nil then
        return false
    end
    return self.finishTaskList[id][sid] or false
end

---更新任务数据
function CycleBattlePassModel:UpdataTask(task)
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)
    return true
end

function CycleBattlePassModel:GetTaskByTaskid(taskid)
    for _, lis in pairs(self.taskList) do
        for _, v in pairs(lis) do
            if v.i_task.sid == taskid then
                return v
            end
        end
    end
    return nil
end

function CycleBattlePassModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.SpiritualRealmEvents.FightTimeChange, self.OnSpiritualRealmEnd, self)
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.BPArenaNormal, self.OnArenaNormalEnd, self)
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.BPArenaPeak, self.OnArenaPeakEnd, self)
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.BPActive, self.OnActiveAdd, self)
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.BPDungones, self.OnDungonesPass, self)
end

return CycleBattlePassModel
