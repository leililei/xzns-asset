---获取所有已解锁（可领取）奖励
---@param id number 用于服务器交互的战令id
---@param lv number 战令等级
---@return cycle_battle.i_battle_award[]
function CycleBattlePassModel:GetAllUnlockAwards(id, lv)
    local awardLis = {}
    local path = self.bpInfo[id].choose_path
    if path == 0 then
        return awardLis
    end
    local content = ConfigManager.store_battle_theme_cfg[path].content[1]
    local store_season_battlecon_cfg = ConfigManager.store_season_battlecon_cfg
    ---@type store_season_battlecon_cfg
    local cfg
    for _, v in pairs(content) do
        cfg = store_season_battlecon_cfg[v]
        if lv >= cfg.level then
            if cfg.rewards_high_pay and table.count(cfg.rewards_high_pay) > 0 then
                self:GetHighAwardPbArgs(awardLis,id,v)
            else
                self:GetAwardPbArgs(awardLis,id,v)
            end
        end
    end
    return awardLis
end

