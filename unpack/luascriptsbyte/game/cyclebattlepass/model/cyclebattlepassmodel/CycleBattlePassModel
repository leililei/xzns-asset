end

---二档战令的领取奖励pb参数组装
function CycleBattlePassModel:GetAwardPbArgs(awardLis,id,v)
    local isBuy = self:GetIsBuy(id)
    local free, pay
    free = not self:CheckAwardIsGet(id, v, true)
    pay = isBuy and not self:CheckAwardIsGet(id, v, false)
    if free and pay then
        _G.table.insert(awardLis, {sid = v, type = 3})
    elseif free then
        _G.table.insert(awardLis, {sid = v, type = 1})
    elseif pay then
        _G.table.insert(awardLis, {sid = v, type = 2})
    end
end

---三档战令的领取奖励pb参数组装
function CycleBattlePassModel:GetHighAwardPbArgs(awardLis,id,v)
    local isBuy = self:GetIsBuy(id)
    local isBuyHigh = self:IsBuyHigh(id)
    local free, pay,pay_high
    free = not self:CheckAwardIsGet(id, v, true)
    pay = isBuy and not self:CheckAwardIsGet(id, v, false)
    pay_high = isBuyHigh and not self:CheckHighAwardIsGet(id, v)
    if free and pay and pay_high then
        _G.table.insert(awardLis, {sid = v, type = 5})
    elseif free and pay then
        _G.table.insert(awardLis, {sid = v, type = 3})
    elseif free then
        _G.table.insert(awardLis, {sid = v, type = 1})
    elseif pay then
        _G.table.insert(awardLis, {sid = v, type = 2})
    elseif pay_high then
        _G.table.insert(awardLis, {sid = v, type = 4})
    end
end


