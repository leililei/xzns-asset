function CycleBattlePassModel:__init()
    self.bpNum = 0
    self.bpOpen = {}
    self.bpInfo = {}
    self.taskList = {}
    self.finishTaskList = {}
    self.infoCount = 0
    _G.Events:GetInstance():AddListener(_G.SpiritualRealmEvents.FightTimeChange, self.OnSpiritualRealmEnd, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPArenaNormal, self.OnArenaNormalEnd, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPArenaPeak, self.OnArenaPeakEnd, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPActive, self.OnActiveAdd, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPDungones, self.OnDungonesPass, self)
end

---@return CycleBattlePassModel CycleBattlePassModel
function CycleBattlePassModel:GetInstance()
    return self.super.GetInstance(self)
end

function CycleBattlePassModel:GetInfo(id, callback)
    self:InitBattlePassNum()
    if self.infoCount == 0 then
        CycleBattlePassNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, callback))
    else
        if callback then
            callback()
        end
    end
    self.infoCount = self.infoCount + 1
    if self.infoCount == self.bpNum then
        --都拉完后重置为0，这样重连或者跨天可以正常拉数据
        self.bpNum = 0
        self.infoCount = 0
    end
end
---@param msg cycle_battle.s2c_cycle_battle_info
function CycleBattlePassModel:GetInfoCall(msg, callback)
    local battles = msg.battles or {}
    for _, v in pairs(battles) do
        v.pay_award = v.pay_award or {}
        v.free_award = v.free_award or {}
        v.second_pay_award = v.second_pay_award or {}
        v.path = v.path or ConfigManager.store_season_battle_cfg[StoreSeasonID[v.id]].content
        self.bpInfo[v.id] = v
    end
    local unlockIds = {} --要解锁的id
    for _, id in pairs(self.BattlePassIDEnum) do
        if self.bpInfo[id] == nil and self.bpOpen[id] == 1 then
            ---首次开启，需要主动向服务器解锁
            self:UnlockBattlePass(id)
            unlockIds[id] = true
        elseif self.bpInfo[id] and self.bpInfo[id].e_time < _G.TimeUtil.GetServerUnixTime() then
            ---已过期，重新解锁购买
            self:UnlockBattlePass(id)
            unlockIds[id] = true
        end
    end
    if self.bpOpen[self.BattlePassIDEnum.Sociaty] == 1 and not unlockIds[self.BattlePassIDEnum.Sociaty] then
        self:GetTaskInfo(self.BattlePassIDEnum.Sociaty)
    end
    if self.bpOpen[self.BattlePassIDEnum.Build] == 1 and not unlockIds[self.BattlePassIDEnum.Build] then
        self:GetTaskInfo(self.BattlePassIDEnum.Build)
    end
    if self.bpOpen[self.BattlePassIDEnum.Spoils] == 1 and not unlockIds[self.BattlePassIDEnum.Spoils] then
        self:GetTaskInfo(self.BattlePassIDEnum.Spoils)
    end
    if self.bpOpen[self.BattlePassIDEnum.FlowerGod] == 1 and not unlockIds[self.BattlePassIDEnum.FlowerGod] then
        self:GetTaskInfo(self.BattlePassIDEnum.FlowerGod)
    end
    -- 广播战令数据更新事件，通知各战令模块
     for _, v in pairs(battles) do
       _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPDataUpdate, v.id)
    end
    if callback then
        callback()
    end
end

---解锁战令
---@param id number 用于服务器交互的战令id
function CycleBattlePassModel:UnlockBattlePass(id, callback)
    local pbData = {id = id}
    CycleBattlePassNet:GetInstance():UnlockBattle(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            ---@type store_season_battle_cfg
            local cfg = ConfigManager.store_season_battle_cfg[StoreSeasonID[id]]
            self.bpInfo[id] = {
                id = id,
                path = cfg.content,
                choose_path = 0,
                s_time = msg.s_time,
                e_time = msg.e_time,
                login_count = msg.login_count,
                exp = 0,
                day_exp = 0,
                is_buy = 0,
                pay_award = {},
                free_award = {},
                second_pay_award ={}
            }
            if callback then
                callback()
            end
            _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPUnlock, ActivityID[id])
            -- 广播战令数据更新事件，参数为BattlePassIDEnum
            _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPDataUpdate, id)
            if id == self.BattlePassIDEnum.Sociaty  or id == self.BattlePassIDEnum.Build or id == self.BattlePassIDEnum.FlowerGod then
                self:GetTaskInfo(id)
            end
        end
    )
end

---选择路线
---@param id number 用于服务器交互的战令id
