local base = require "CycleBattlePassSynBaseModel"
---@class AbyssBattlePassSynModel : CycleBattlePassSynBaseModel	中文描述
local AbyssBattlePassSynModel = _G.BaseClass("AbyssBattlePassSynModel", base)

---创建对象时,入口构造函数
function AbyssBattlePassSynModel:__init()
    self.bId = self.CycleBattlePassModel.BattlePassIDEnum.Abyss
    self.storeBattleId = 705001
    self.cfg = _G.ConfigManager.store_season_battle_cfg[self.storeBattleId]
    self.expBuyRate  = _G.ConfigManager.discrete_cfg[114105][1][1]
end

function AbyssBattlePassSynModel:JumpToFunction()
    _G.JumpManager:GetInstance():Jump(136001)
end

function AbyssBattlePassSynModel:GetMaxDayExp()
    return 0
end

function AbyssBattlePassSynModel:GetExpTipStr()
    return _G.GetLangPackValue(90031100002)
end

---获取战令帮助文本id
---@overload 
---@return number
function AbyssBattlePassSynModel:GetHelpId()
    return 113
end

---@overload 
function AbyssBattlePassSynModel:IsAddBtnShow()
    local leftTime = self:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    local time = _G.ConfigManager.discrete_cfg[114108][1][1] * 86400
    return leftTime <= time
end

return AbyssBattlePassSynModel