local base = require "CycleBattlePassSynBaseModel"
---@class ArenaBattlePassSynModel : CycleBattlePassSynBaseModel	中文描述
local ArenaBattlePassSynModel = _G.BaseClass("ArenaBattlePassSynModel", base)

---创建对象时,入口构造函数
function ArenaBattlePassSynModel:__init()
    self.bId = self.CycleBattlePassModel.BattlePassIDEnum.Arena
    self.storeBattleId = 706001
    self.cfg = _G.ConfigManager.store_season_battle_cfg[self.storeBattleId]
    self.expBuyRate  = _G.ConfigManager.discrete_cfg[114106][1][1]
end

function ArenaBattlePassSynModel:JumpToFunction()
    _G.JumpManager:GetInstance():Jump(178001)
end

function ArenaBattlePassSynModel:GetMaxDayExp()
    return _G.ConfigManager.discrete_cfg[114103][1][1]
end

function ArenaBattlePassSynModel:GetExpTipStr()
    return _G.GetLangPackValue(90031100004)
end

---获取战令帮助文本id
---@overload 
---@return number
function ArenaBattlePassSynModel:GetHelpId()
    return 114
end

---@overload
function ArenaBattlePassSynModel:IsAddBtnShow()
    local leftTime = self:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    local time = _G.ConfigManager.discrete_cfg[114109][1][1] * 86400
    return leftTime <= time
end

return ArenaBattlePassSynModel