local base = require "CycleBattlePassSynBaseModel"
---@class SociatyBattlePassSynModel : CycleBattlePassSynBaseModel	中文描述
local SociatyBattlePassSynModel = _G.BaseClass("SociatyBattlePassSynModel", base)

---创建对象时,入口构造函数
function SociatyBattlePassSynModel:__init()
    self.bId = self.CycleBattlePassModel.BattlePassIDEnum.Sociaty
    self.storeBattleId = 711001
    self.cfg = _G.ConfigManager.store_season_battle_cfg[self.storeBattleId]
    self.expBuyRate = _G.ConfigManager.discrete_cfg[126303][1][1]
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPTaskFinish, self.RefreshTaskRedPoint, self)
end

function SociatyBattlePassSynModel:JumpToFunction()
end

function SociatyBattlePassSynModel:GetMaxDayExp()
    return 0
end

function SociatyBattlePassSynModel:GetExpTipStr()
    return ""
end

---获取战令帮助文本id
---@return number
function SociatyBattlePassSynModel:GetHelpId()
    return nil
end

function SociatyBattlePassSynModel:IsAddBtnShow()
    local leftTime = self:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    local time = _G.ConfigManager.discrete_cfg[114114][1][1] * 86400
    return leftTime <= time
end

function SociatyBattlePassSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.RefreshRedPointEmpty, self.CheckRedPoint, self.CheckTaskRedPoint}
    self.redpointTree = {{2, 3}, false, false}
end

function SociatyBattlePassSynModel:RefreshRedPointEmpty()
    return 0
end

---刷新奖励红点
function SociatyBattlePassSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
end

---刷新任务红点
function SociatyBattlePassSynModel:RefreshTaskRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(3))
end

function SociatyBattlePassSynModel:CheckTaskRedPoint()
    return self.CycleBattlePassModel:CheckTaskRedPoint(self.bId)
end

function SociatyBattlePassSynModel:GetTaskData()
    return self.CycleBattlePassModel:GetTaskData(self.bId)
end

function SociatyBattlePassSynModel:FinishTask(taskIds, finishType, call)
    self.CycleBattlePassModel:FinishTask(
        self.bId,
        taskIds,
        finishType,
        function(msg)
            self:RefreshTaskRedPoint()
            if call then
                call(msg)
            end
        end
    )
end

function SociatyBattlePassSynModel:GetAllCanFinishTask()
    return self.CycleBattlePassModel:GetAllCanFinishTask(self.bId)
end

function SociatyBattlePassSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.BPTaskFinish, self.RefreshTaskRedPoint, self)
end

return SociatyBattlePassSynModel
