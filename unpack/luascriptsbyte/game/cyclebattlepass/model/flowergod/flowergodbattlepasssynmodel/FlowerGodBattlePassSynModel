---创建对象时,入口构造函数
function FlowerGodBattlePassSynModel:__init()
    self.bId = CycleBattlePassModel.BattlePassIDEnum.FlowerGod
    self.expireTimer = nil
    self.Cfg =  _G.ConfigManager.store_season_battle_cfg[714001]
    self.ShopId =  13 --关联商店为13
