---刷新花神战令累计登录天数任务
function FlowerGodBattlePassSynModel:FlowerGodLoginUpdate(id)
    if id ~= self.bId then
        return
    end
    local bpInfo = CycleBattlePassModel.bpInfo[self.bId]
    if bpInfo and bpInfo.login_count then
        _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.FlowerGod.FlowerGodLogin },
                bpInfo.login_count
        )
    end

end

---设置战令到期定时器
function FlowerGodBattlePassSynModel:SetupExpireTimer()
    -- 先停止之前的定时器
    self:StopExpireTimer()

    -- 获取战令数据
    local bpInfo = CycleBattlePassModel.bpInfo[self.bId]
    if not bpInfo then
        return
    end

    local endTime = bpInfo.s_time +  self.Cfg.time_duration  + 1800 + 1-- 战令开始时间+持续时间+结算时间 + 客户端比服务器晚1秒请求
    local currentServerTime = _G.TimeUtil.GetServerUnixTime()

    -- 计算剩余时间
    local remainingTime = endTime - currentServerTime
    -- 如果已经过期，直接执行重置
    if remainingTime <= 0 then
        self:OnBattlePassExpire()
        return
    end

    -- 创建一次性定时器，到期后执行重置函数
    self.expireTimer = _G.TimerManager:GetInstance():GetTimer(
        remainingTime,
        self.OnBattlePassExpire,
        self,
        true,  -- one_shot: 一次性定时器
        false, -- use_frame: 使用秒计时
        true   -- unscaled: 使用unscaledDeltaTime（不受游戏暂停影响）
    )
    self.expireTimer:Start()
    if _G.AppSetting.DEBUG then
        _G.Log(string.format("花神战令到期定时器已设置: 剩余时间=%.2f秒, 结束时间=%s",
            remainingTime,
            _G.TimeUtil.date("%Y-%m-%d %H:%M:%S", endTime)))
    end
end

