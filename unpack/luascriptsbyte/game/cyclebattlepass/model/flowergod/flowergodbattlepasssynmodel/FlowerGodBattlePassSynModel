---战令是否结算中
function FlowerGodBattlePassSynModel:IsClosing()
    local bpInfo = CycleBattlePassModel.bpInfo[self.bId]
    if bpInfo  then
        local currentServerTime = _G.TimeUtil.GetServerUnixTime()
        return bpInfo.e_time  - currentServerTime <= 0
    end
    return true
end

function FlowerGodBattlePassSynModel:OnMallCashListener(msg)
    local passID = CycleBattlePassModel.BattlePassIDEnum.FlowerGod
    local cfg = CycleBattlePassModel:GetCfg(passID)
    if msg.sid == cfg.id then
        if CycleBattlePassModel:GetIsBuy(passID) then
            --第一档已购买情况下这是第二档的购买消息
            CycleBattlePassModel:OnHighMallCashEnd(passID)
        else
            CycleBattlePassModel:OnMallCashEnd(passID)
        end
    end
end

