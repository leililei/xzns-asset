    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eShopStatus.Update, self.ShopUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.NewFunction, self.FunctionUnLock, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPTaskUpdate, self.FlowerGodLoginUpdate, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.BPTaskFinish, self.FlowerGodTaskFinish,self)
end

function FlowerGodBattlePassSynModel:GetDataFormServer()
    local pbData = {id = self.bId}
    CycleBattlePassNet:GetInstance():GetLoginCount(pbData,function(msg)
        self:ParseData(msg)
    end)
end

---解析数据
function FlowerGodBattlePassSynModel:ParseData(msg)
    if msg.ack ~= 1 then
        self.super.ParseData(self)
        return
    end
