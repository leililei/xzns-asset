---游戏过程中功能首次解锁
---@param id 功能id
function FlowerGodBattlePassSynModel:FunctionUnLock(id)
    if id == self.FuncId then
        local bpInfo = CycleBattlePassModel.bpInfo[self.bId]
        if bpInfo then
            return --有战令数据return
        end
        --请求战令解锁
        CycleBattlePassModel:UnlockBattlePass(self.bId)
