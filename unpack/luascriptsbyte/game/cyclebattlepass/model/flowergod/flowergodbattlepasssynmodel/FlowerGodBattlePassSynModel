    self:ResetBattlePass()
end

---自定义战令重置逻辑
function FlowerGodBattlePassSynModel:ResetBattlePass()
    --重新解锁战令
    CycleBattlePassModel:UnlockBattlePass(self.bId)
end

---停止到期定时器
function FlowerGodBattlePassSynModel:StopExpireTimer()
    if self.expireTimer then
        self.expireTimer:Stop()
        self.expireTimer = nil
    end
end

