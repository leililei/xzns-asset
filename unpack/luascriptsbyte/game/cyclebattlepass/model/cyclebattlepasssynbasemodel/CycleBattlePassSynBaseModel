local base = require "ActivitySynTypeBase"
---@class CycleBattlePassSynBaseModel : ActivitySynTypeBase	中文描述
---@field CycleBattlePassModel CycleBattlePassModel
---@field cfg store_season_battle_cfg
local CycleBattlePassSynBaseModel = _G.BaseClass("CycleBattlePassSynBaseModel", base)

---创建对象时,入口构造函数
function CycleBattlePassSynBaseModel:__init()
    self.bId = nil --子类重写（与后端交互的id）
    self.storeBattleId = nil --子类重写（store_season_battle_cfg的id）
    self.cfg = nil --子类重写（store_season_battle_cfg）
    self.expBuyRate = nil --子类重写（discrete_cfg）
    self.CycleBattlePassModel = require "CycleBattlePassModel":GetInstance()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.AddBPExpEnd, self.RefreshRedPoint, self)
end

--- 网络请求初始化
function CycleBattlePassSynBaseModel:GetDataFormServer()
    self.CycleBattlePassModel:GetInfo(self.bId, _G.handler(self, self.ParseData))
end

---数据解析完成
function CycleBattlePassSynBaseModel:ParseData()
    self:RefreshRedPoint()
    base.ParseData(self)
end

function CycleBattlePassSynBaseModel:InitFunction()
    self.CycleBattlePassModel:InitFunction()
end

---进入活动主体
function CycleBattlePassSynBaseModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(self.CycleBattlePassModel.ViewEnum[self.bId], self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function CycleBattlePassSynBaseModel:OnGetMainViewName()
    return self.CycleBattlePassModel.ViewEnum[self.bId]
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function CycleBattlePassSynBaseModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function CycleBattlePassSynBaseModel:CheckRedPoint()
    return self.CycleBattlePassModel:CheckeRedPoint(self.bId)
end

---刷新奖励红点
function CycleBattlePassSynBaseModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.RefreshRedPoint, self.bId)
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function CycleBattlePassSynBaseModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---选择路线
---@param path number 路线id
function CycleBattlePassSynBaseModel:ChoosePath(path, callback)
    self.CycleBattlePassModel:ChoosePath(self.bId, path, callback)
end

---领取奖励
---@param awardLis cycle_battle.i_battle_award[] 奖励列表
function CycleBattlePassSynBaseModel:GetAward(awardLis, callback)
    self.CycleBattlePassModel:GetAward(
        self.bId,
        awardLis,
        function()
            self:RefreshRedPoint()
            if callback then
                callback()
            end
        end
    )
end

---购买经验
---@param exp number 经验值
function CycleBattlePassSynBaseModel:BuyExp(exp, callback)
    self.CycleBattlePassModel:BuyExp(
        self.bId,
        exp,
        self.expBuyRate,
        function()
            self:RefreshRedPoint()
            if callback then
                callback()
            end
        end
    )
end

---是否展示加速按钮
---@return boolean
function CycleBattlePassSynBaseModel:IsAddBtnShow()
    return true
end

function CycleBattlePassSynBaseModel:Buy()
    local price_id = self.cfg.price_id
    self.CycleBattlePassModel:Buy(self.bId, price_id)
end

---获取战令配置
---@return store_season_battle_cfg
function CycleBattlePassSynBaseModel:GetCfg()
    return self.cfg
end

---获取战令帮助文本id
---@return number
function CycleBattlePassSynBaseModel:GetHelpId()
    return 0
end

---获取可选路线列表
---@return number[]
function CycleBattlePassSynBaseModel:GetAllPath()
    return self.CycleBattlePassModel:GetAllPath(self.bId)
end

---获取当前选择路线
---@return number
function CycleBattlePassSynBaseModel:GetChossePath()
    return self.CycleBattlePassModel:GetChossePath(self.bId)
end

---是否购买了高级战令
---@return boolean
function CycleBattlePassSynBaseModel:GetIsBuy()
    return self.CycleBattlePassModel:GetIsBuy(self.bId)
end

---获取战令结束时间
---@return number
function CycleBattlePassSynBaseModel:GetEndTime()
    return self.CycleBattlePassModel:GetEndTime(self.bId)
end

---获取当前等级,当前等级当前经验，当前等级总经验
---@return number, number, number
function CycleBattlePassSynBaseModel:GetLvAndCurLvExp()
    return self.CycleBattlePassModel:GetLvAndCurLvExp(self.bId, self.cfg)
end

---根据等级获取所需经验
---@return number, number, number
function CycleBattlePassSynBaseModel:GetLvExpByLv(lv)
    return self.CycleBattlePassModel:GetLvExpByLv(self.bId, self.cfg, lv)
end

---获取每日已获得经验
---@return number
function CycleBattlePassSynBaseModel:GetDayExp()
    return self.CycleBattlePassModel:GetDayExp(self.bId)
end

---获取所有已解锁（可领取）奖励
---@return cycle_battle.i_battle_award[]
function CycleBattlePassSynBaseModel:GetAllUnlockAwards(lv)
    lv = lv or self:GetLvAndCurLvExp()
    return self.CycleBattlePassModel:GetAllUnlockAwards(self.bId, lv)
end

---检查奖励是否已领取
---@param awardId number 奖励id
---@param isFree boolean 是否是免费奖励
---@return boolean
function CycleBattlePassSynBaseModel:CheckAwardIsGet(awardId, isFree)
    return self.CycleBattlePassModel:CheckAwardIsGet(self.bId, awardId, isFree)
end

---检查是否能够选择路线（未领取过任何奖励且有多条路线可选）
---@return boolean
function CycleBattlePassSynBaseModel:CheckCanSwitchPath()
    return self.CycleBattlePassModel:CheckCanSwitchPath(self.bId)
end

---高级战令购买成功监听
function CycleBattlePassSynBaseModel:OnMallCashListener(data)
    if data.sid == self.storeBattleId then
        self.CycleBattlePassModel:OnMallCashEnd(self.bId)
        self:RefreshRedPoint()
    end
end

---跳转到获取经验的功能
function CycleBattlePassSynBaseModel:JumpToFunction()
    _G.LogError("子类未重写跳转方法")
end

---获取每日可获得的经验上限（不含购买）
function CycleBattlePassSynBaseModel:GetMaxDayExp()
    _G.LogError("子类未重写获取每日经验上限方法")
end

---获取战令经验来源提示文本
function CycleBattlePassSynBaseModel:GetExpTipStr()
    _G.LogError("子类未重写经验获取途径文本方法")
end

---完成任务
function CycleBattlePassSynBaseModel:FinishTask(taskIds, finishType, call)
end

---获取所有可完成任务
function CycleBattlePassSynBaseModel:GetAllCanFinishTask()
end

function CycleBattlePassSynBaseModel:CheckTaskIsFinish(sid)
    return self.CycleBattlePassModel:CheckTaskIsFinish(self.bId, sid)
end

---销毁对象时,析构函数
function CycleBattlePassSynBaseModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.AddBPExpEnd, self.RefreshRedPoint, self)
end

return CycleBattlePassSynBaseModel
