---@class CycleBattlePassToggleView : UIBaseView    中文描述
---@field public go_table CycleBattlePassToggleView_GoTable GoTable
local CycleBattlePassToggleView = _G.BaseClass("CycleBattlePassToggleView", _G.UIBaseView)

local AState = {
    Close = 1,
    Notice = 2,
    Open = 3,
    Settlement = 4
}
function CycleBattlePassToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
end

---界面的入口函数
function CycleBattlePassToggleView:OnCreate(activityData)
    self.activityData = activityData
    self.uiNameIndex = {}
    for i, v in pairs(activityData) do
        self.uiNameIndex[v.ViewName] = i
    end
    self.views = {}
    self:InitToggle()
    self.panelInit = {}
    self.panelLua = {}
    self.toggleItem = {
        self.go_table.toggle_1,
        self.go_table.toggle_2,
        self.go_table.toggle_3
    }
    self.color = {
        require("CardInfoManager").GetColorFromRGB("400E0E"), --选中
        require("CardInfoManager").GetColorFromRGB("C6B69D")
    }
    self.go_table.toggle_1.isOn = false
    self.go_table.toggle_1.isOn = true
end

function CycleBattlePassToggleView:InitToggle()
    self.toggles = {}
    local tb, obj
    for i = 1, 3 do
        obj = self.go_table["toggle_" .. i]
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickToggle, i))
        tb.aortext_text.text = self.activityData[i] and self.activityData[i].Name or ""
        obj:SetActiveE(self.activityData[i] ~= nil and 1 or 0)
        self.toggles[i] = tb

        if self.activityData[i] ~= nil then
            local id = self.activityData[i].TypeCls:GetRedpointIDByIndex(1)
            if id then
                tb.obj_redpoint:UpdateRedPointItemIDAndParam(id)
            end
        end
    end
end

function CycleBattlePassToggleView:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aortext_text.color = isOn and self.color[1] or self.color[2]
    self.go_table["obj_view" .. key]:SetActiveE(isOn and 1 or 0)
    if isOn then
        if self.views[key] ~= nil then
            return
        end
        local data = self.activityData[key]
        if data.State == AState.Close or data.State == AState.Settlement or data.State == AState.Notice then
            data.Cls:CheckActivityInteractable()
            return
        end
        self.views[key] = true
        if data.Type == 1 then
            data.Cls:EnterActivity()
        elseif data.Type == 2 then
            data.TypeCls:EnterActivity()
        end
    end
end

function CycleBattlePassToggleView:OnUIOpened(name)
    local key = self.uiNameIndex[name]
    if key ~= nil then
        self.views[key] = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
                name,
                self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
        )
        self.views[key].transform:SetParentE(self.go_table["obj_view" .. key])
		--重新刷新下界面，不然可能sortingOrder改变之前就刷了界面里的特效导致特效层级计算错误不显示
        if _G.ConfigManager.ui_cfg[name].View == "CycleBattlePassView" then 
            self.views[key]:UpdateView()
        end     
    end
end

---按钮点击事件在这里派发
function CycleBattlePassToggleView:OnClickBtn(go, isOn)
end

function CycleBattlePassToggleView:CloseView(...)
    self:Close()
end

function CycleBattlePassToggleView:Dispose()
    for name, _ in pairs(self.uiNameIndex) do
        _G.UIManager:GetInstance():CloseWindow(name)
    end
    self:RemoveAllListener()
end

return CycleBattlePassToggleView
