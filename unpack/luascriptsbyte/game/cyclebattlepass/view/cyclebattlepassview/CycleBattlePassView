    self.canSwitch = false
    self:UpdateBattlePass()
end

function CycleBattlePassView:OnClickItem(go, isOn, id)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if self.isBuy then
            if self.typeClass:CheckAwardIsGet(id, true) then
                local payAwardLis = { { sid = id, type = 2 } }
                self:GetAward(payAwardLis)
            else
                local AllAwardLis = { { sid = id, type = 3 } }
                self:GetAward(AllAwardLis)
            end
        else
            local freeAwardLis = { { sid = id, type = 1 } }
            self:GetAward(freeAwardLis)
        end
    end
end

function CycleBattlePassView:OnClickPath(go, isOn, path, sid)
    if self.path == path then
        require "CommonTipManager":GetInstance():OpenTip(go, sid)
        return
    end
    self.path = path
    self:UpdateChoosePath()
end

---按钮点击事件在这里派发
function CycleBattlePassView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_add then
        if self.path == 0 then
            return
        end
        local content = self.pathCfg.content[1]
        local maxId = content[#content]
        local maxLv = _G.ConfigManager.store_season_battlecon_cfg[maxId].level
        if self.lv == maxLv then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        else
            --self.lua_AddExp:Show(self.lv, maxLv, self.curExp)
        end
    elseif go == self.go_table.aorbtn_getExp then
        self.typeClass:JumpToFunction()
    elseif go == self.go_table.aorbtn_buy then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_oneKey then
        self:GetAward(self.awardLis)
    elseif go == self.go_table.aorbtn_sure then
        if self.path == 0 then
            return
        end
        if self.path == self.typeClass:GetChossePath() then
            self:OnChoosePathEnd()
        end
        self.typeClass:ChoosePath(self.path, _G.handler(self, self.OnChoosePathEnd))
    elseif go == self.go_table.aorbtn_switch then
        if not self.canSwitch then
            return
        end
        self.go_table.obj_choosePath:SetActiveE(1)
        self.go_table.obj_battlePass:SetActiveE(0)
        self.go_table.aorbtn_add:SetActiveE(0)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, self.typeClass:GetHelpId())
    end
end

function CycleBattlePassView:ClickBuy()
    if self.isBuy then
        _G.PopWindowManager:GetInstance():ShowAllTips(870101)
    else
        local lv, curExp, curMaxExp = self.typeClass:GetLvAndCurLvExp()
        if self.nowLevel and self.nowLevel ~= lv then 
            if self.buyTipLua then 
                self.buyTipLua:UpdateNowLevel(lv)
            end
        end
        self.nowLevel = lv
        if not self.buyTipLua then
            self.buyTipLua = true
            local params = {}
            params.okFun = function()
                self.typeClass:Buy()
            end
            params.contentIds = self.pathCfg.content[1]
            params.goods = self.cfg.goods
            params.price_id = self.cfg.price_id
            params.name = self.cfg.name
            params.nowLevel = lv
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Task/$_obj_activeBattlePassBuyTips",
                _G.ePoolType.Temporary,
                self.go_table.obj_view,
                function(tran)
                    if self.go_table == nil then
                        _G.DestroyObject(tran)
                        return
                    end
                    local sortOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 23
                    self.buyTipLua = self:AddComponent(tran, require("ActiveBattlePassBuyTips").New(tran, params))
                end
            )
        elseif self.buyTipLua ~= true then
            self.buyTipLua:Show()
        end
    end
end

function CycleBattlePassView:CloseView()
    self:Close()
end

function CycleBattlePassView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return CycleBattlePassView
