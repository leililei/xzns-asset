                5001,
                nil,
                function()
                    self.typeClass:GetAward(awardLis, _G.handler(self, self.OnGetAwardEnd))
                end
        )
    else
        self.typeClass:GetAward(awardLis, _G.handler(self, self.OnGetAwardEnd))
    end
end

