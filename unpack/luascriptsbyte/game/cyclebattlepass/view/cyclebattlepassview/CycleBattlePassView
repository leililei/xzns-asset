function CycleBattlePassView:UpdateChoosePath()
    for k, v in pairs(self.pathItem) do
        v.obj_gou:SetActiveE(k == self.path and 1 or 0)
    end
    if self.path ~= 0 then
        self.go_table.obj_setItem:SetActiveE(1)
        self.go_table.obj_add:SetActiveE(0)
        self.pathCfg = _G.ConfigManager.store_battle_theme_cfg[self.path]
        local icon = _G.ConfigManager.item_cfg[self.pathCfg.reward_theme[1]].Icon
        self.go_table.aorrawimage_icon:LoadImage(icon)
    end
end

---刷新战令
function CycleBattlePassView:UpdateBattlePass()
    self.go_table.obj_switchPath:SetActiveE(self.canSwitch and 1 or 0)
    self.isBuy = self.typeClass:GetIsBuy()
    local rect = self.go_table.scrollloopvectical_items.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.go_table.aorbtn_buy:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        require("CardInfoManager").GetColorFromRGB(not self.isBuy and "FFFFFF" or "A9A9A9")
    self.go_table.aortext_money.color =
    require("CardInfoManager").GetColorFromRGB(not self.isBuy and "8C2D14" or "434343")
    if self.isBuy then
        self.go_table.aorbtn_buy:SetGray(true)
        -- self.go_table.aortext_money.color = _G.Color.New(65 / 255, 65 / 255, 65 / 255, 1)
        self.go_table.aortext_money.text = GetLangPackValue(90022500421)
        --self.go_table.obj_senior:SetActiveE(0)
        --self.go_table.obj_bought:SetActiveE(1)
    else
        self.go_table.aorbtn_buy:SetGray(false)
        _G.GameUtil.SetPriceByChannel(self.cfg.price_id, self.go_table.aortext_money)
        --self.go_table.obj_senior:SetActiveE(1)
        --self.go_table.obj_bought:SetActiveE(0)
    end

    local array = self.pathCfg.content[1]
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local cfg
    self.awardCfgArray = {}
    for _, v in pairs(array) do
        cfg = store_season_battlecon_cfg[v]
        _G.table.insert(self.awardCfgArray, cfg)
    end
    self.awardLis = self.typeClass:GetAllUnlockAwards(self.lv)
    self.go_table.aorbtn_oneKey:SetActiveE(#self.awardLis > 1 and 1 or 0)
    if not self.bpInit then
        self.go_table.scrollloopvectical_items:InitItemData(#self.awardCfgArray, _G.handler(self, self.RefreshList))
        self.bpInit = true
        self.go_table.scrollloopvectical_items:ScrollToIndex(self:FindFirstAwardIndex())
    else
        self.go_table.scrollloopvectical_items:UpdateAllItem()
    end
    --self:UpdateBattlePassSenior()
end

function CycleBattlePassView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local cfg = self.awardCfgArray[index]
    local id = cfg.id
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, id))
    obj:SetName(index)
    if not table.ContainsValue(self.itemList, obj) then
        self.itemList[index] = obj
    end
    for i = 1, #self.itemList do
        _G.SortList(
                self.itemList,
                function(a)
                    return -a:GetName()
                end
        )
        self.itemList[i]:SetSiblingIndexE(i)
    end

    local freeState, payState
    local lvEnough = self.lv >= cfg.level
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isBuy) and ItemState.Unlock or ItemState.Lock
    tb.freeState = self.typeClass:CheckAwardIsGet(id, true) and ItemState.Received or freeState
    tb.payState = self.typeClass:CheckAwardIsGet(id, false) and ItemState.Received or payState

    local rewards = cfg.rewards_normal
    if not tb.item1 then
        tb.item1 = BaseAwardNewItem.New(tb.obj_item1, nil, 88, tb.obj_item1)
    end
    tb.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemLoadedCall, tb, false, 1))

    rewards = cfg.rewards_pay[1]
    if not tb.item2 then
        tb.item2 = BaseAwardNewItem.New(tb.obj_item21, nil, 88, tb.obj_item21)
    end
    tb.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 21))

    rewards = cfg.rewards_pay[2]
    tb.obj_item22:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item3 then
            tb.item3 = BaseAwardNewItem.New(tb.obj_item22, nil, 88, tb.obj_item22)
        end
        tb.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 22))
    end

    ---是否显示第二个
    tb.obj_gou22:SetActiveE(rewards and 1 or 0)
    --tb.obj_suo22:SetActiveE(rewards and 1 or 0)

    ---已领打勾
    tb.obj_gou1:SetActiveE(tb.freeState == ItemState.Received and 1 or 0)
    tb.obj_gou2:SetActiveE(tb.payState == ItemState.Received and 1 or 0)
    ---可领
    tb.aorbtn_get:SetActiveE((tb.freeState == ItemState.Unlock or tb.payState == ItemState.Unlock) and 1 or 0)
    ---未解锁上锁
    --tb.obj_suo1:SetActiveE(tb.freeState == ItemState.Lock and 1 or 0)
    --tb.obj_suo2:SetActiveE(tb.payState == ItemState.Lock and 1 or 0)

    tb.aortext_lv.text = GetLangPackValue(LanguageID.Level, cfg.level)
    --等级经验
    local exp = self.typeClass:GetLvExpByLv(cfg.level)
    tb.aortext_exp.text = exp

    --进度条
    tb.aorimage_DayBar:SetActiveE(BoolToNumber(index ~= 1))
    local lv, curExp, curMaxExp = self.typeClass:GetLvAndCurLvExp()
    if cfg.level - 1 < lv then
        tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
    elseif cfg.level - 1 == lv then
        local scale = curExp / curMaxExp
        tb.aorimage_dayBar:SetLocalScale(1, scale, 1)
    else
        tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
    end
    return obj
end

function CycleBattlePassView:FindFirstAwardIndex()
    local maxIndex = self.isBuy and #self.awardCfgArray - 5 or #self.awardCfgArray - 3
    local cfg
    for i = 1, #self.awardCfgArray do
        cfg = self.awardCfgArray[i]
        if self.lv >= cfg.level then
            if not self.typeClass:CheckAwardIsGet(cfg.id, true) then
                return i > maxIndex and maxIndex - 1 or i - 1
            elseif self.isBuy and not self.typeClass:CheckAwardIsGet(cfg.id, false) then
                return i > maxIndex and maxIndex - 1 or i - 1
            end
        end
    end
    return 0
end

---刷新高级战令显示
function CycleBattlePassView:UpdateBattlePassSenior()
    local itemDic = {}
    local itemNowDic = {}
    local sid
    for i = 1, #self.awardCfgArray do
        for j = 1, #self.awardCfgArray[i].rewards_pay do
            sid = self.awardCfgArray[i].rewards_pay[j][1]
            if itemDic[sid] == nil then
                itemDic[sid] = self.awardCfgArray[i].rewards_pay[j][2]
            else
                itemDic[sid] = itemDic[sid] + self.awardCfgArray[i].rewards_pay[j][2]
            end
            if self.awardCfgArray[i].level <= self.lv then
                if itemNowDic[sid] == nil then
                    itemNowDic[sid] = self.awardCfgArray[i].rewards_pay[j][2]
                else
                    itemNowDic[sid] = itemNowDic[sid] + self.awardCfgArray[i].rewards_pay[j][2]
                end
            end
        end
    end
    for _, v in pairs(self.cfg.goods) do
        sid = v[1]
        if itemNowDic[sid] == nil then
            itemNowDic[sid] = v[2]
        else
            itemNowDic[sid] = itemNowDic[sid] + v[2]
        end
    end
    self.allRewards = {}
    for k, v in pairs(itemDic) do
        _G.table.insert(self.allRewards, { k, v })
    end
    self.nowRewards = {}
    for k, v in pairs(itemNowDic) do
        _G.table.insert(self.nowRewards, { k, v })
    end
    if not self.allAndNowInit then
        self.go_table.scrollloophorizontal_seniorAward:InitItemData(
                #self.allRewards,
                _G.handler(self, self.RefreshSeniorAllItem)
        )
        self.go_table.scrollloophorizontal_nowAward:InitItemData(
                #self.nowRewards,
                _G.handler(self, self.RefreshSeniorNowItem)
        )
        self.allAndNowInit = true
    else
        self.go_table.scrollloophorizontal_seniorAward:UpdateCount(#self.allRewards)
        self.go_table.scrollloophorizontal_nowAward:UpdateCount(#self.nowRewards)
    end
end

