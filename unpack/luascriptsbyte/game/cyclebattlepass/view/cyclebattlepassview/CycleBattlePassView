---刷新等级区显示
function CycleBattlePassView:UpdateLevel()
    local lv, curExp, curMaxExp = self.typeClass:GetLvAndCurLvExp()
    self.lv = lv
    self.curExp = curExp
    self.go_table.aortext_lv.text = lv
    self.go_table.slider_jdtdi.value = curMaxExp == 0 and 1 or curExp / curMaxExp
    self.go_table.aortext_exp.text = curMaxExp == 0 and "" or curExp .. "/" .. curMaxExp
    local maxDayExp = self.typeClass:GetMaxDayExp()
    if maxDayExp == 0 then
        self.go_table.aortext_limit.text = ""
    else
        local curDayExp = self.typeClass:GetDayExp()
        self.go_table.aortext_limit.text = GetLangPackValue(90031100007, curDayExp, maxDayExp)
    end
    self.go_table.aortext_funTips.text = self.typeClass:GetExpTipStr()
    local id = self.typeClass.bId
    self.go_table["obj_title" .. id]:SetActiveE(1)
    if id == 1 then
        self.go_table.aortext_nums1.text = GetLangPackValue(90031100024) .. "%"
        self.go_table.aorrawimage_Icon1:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(202010100))
        self.go_table.aorrawimage_Icon2:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(203010502))
        self.go_table.aortext_num1.text = "×" .. GetLangPackValue(90031100028)
    elseif id == 2 then
        self.go_table.aortext_nums2.text = GetLangPackValue(90031100029) .. "%"
    end
end

