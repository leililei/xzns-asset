---界面的入口函数
---@param activity ActivitySynCfgActivity
function CycleBattlePassView:OnCreate(activity)
    self.activity = activity
    self.typeClass = self.activity.typeClass
    self.cfg = self.activity.typeClass:GetCfg()
    --self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData)
    local key = "CycleBattlePassPath" .. self.typeClass.bId .. _G.PlayerModel:GetInstance():GetPlayerUid()
    local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    self.itemList = {}
    --if self.typeClass:GetHelpId() and self.typeClass:GetHelpId() ~= 0 then
    --    self.go_table.aorbtn_help:SetActiveE(1)
    --else
    --    self.go_table.aorbtn_help:SetActiveE(0)
    --end
    _G.PlayerPrefsManager.SetInt(key, time)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)

    self.CycleBattlePassModel = require "CycleBattlePassModel":GetInstance()
    local curViewName = self.CycleBattlePassModel.ViewEnum[self.typeClass.bId]
    local res = _G.ConfigManager.ui_cfg[curViewName].resources
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self:AddComponent(self.go_table.obj_resource, require("ResourceCompont").New(self.go_table.obj_resource, res))
    --更新视图
    self:InitView()
end

---初始化窗口，涉及特效，需要activity设置完根节点OrderInLayer后再执行，否则特效层级概率计算错误
function CycleBattlePassView:InitView()
    if self.isInit then
        return
    end
    self.isInit = true
    self.go_table.obj_ItemNum:SetActiveE(0)
    local obj, tb
    ---@type store_battle_theme_cfg
    local cfg
    self.pathItem = {}
    local paths = self.typeClass:GetAllPath()
    for _, v in pairs(paths) do
        cfg = _G.ConfigManager.store_battle_theme_cfg[v]
        if cfg then
            obj = _G.InstantiateObject(self.go_table.obj_pathItem, self.go_table.obj_path)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPath, v, cfg.reward_theme[1]))
            self.pathItem[v] = tb
            tb.item = BaseAwardNewItem.New(tb.obj_item, nil, 88, tb.obj_item)
            tb.item:ShowWithID(
                    cfg.reward_theme,
                    nil,
            ---@param item BaseAwardNewItem
                    function(item)
                        item:ShowEffect(true, 1)
                    end
            )
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("未配置战令路线" .. v)
            end
        end
    end
    self.countDown = self.typeClass:GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(0)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateView()
end

---刷新界面
function CycleBattlePassView:UpdateView()
    --if self.lua_AddExp then
    --    self.lua_AddExp:Hide()
    --end
    self.path = self.typeClass:GetChossePath()
    self.canSwitch = self.typeClass:CheckCanSwitchPath()
    self:UpdateLevel()
    if self.path == 0 and not self.canSwitch then
        ---只有一条线路
        self.path = self.typeClass:GetCfg().content[1]
        self.pathCfg = _G.ConfigManager.store_battle_theme_cfg[self.path]
        self.typeClass:ChoosePath(self.path, _G.handler(self, self.OnChoosePathEnd))
    else
        self:ShowByPath()
        self:UpdateChoosePath()
        if self.path ~= 0 then
            self:UpdateBattlePass()
            --self:UpdateBattlePassSenior()
        end
    end
    local awardSid = 202100100
    if self.typeClass.bId == self.CycleBattlePassModel.BattlePassIDEnum[2] then
        awardSid = 20201010001
    end

    local cfg = _G.ConfigManager.item_cfg[awardSid]
    if not string.IsNullOrEmpty(cfg.icon) then
        self.go_table.aorimage_awardIcon:LoadImage(cfg.icon)
    end
    local itemValue = _G.StorageManager:GetInstance():GetItemCountByID(cfg.field, awardSid)
    self.go_table.aortext_awardCount.text = itemValue
end

