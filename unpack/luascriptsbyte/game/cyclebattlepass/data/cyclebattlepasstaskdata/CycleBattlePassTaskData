local base = _G.ActiveTaskBase
---@class CycleBattlePassTaskData:ActiveTaskBase
local CycleBattlePassTaskData = _G.BaseClass("CycleBattlePassTaskData", base)

function CycleBattlePassTaskData:ParseData(task)
    ---任务对应 天数 标记任务完成用
    self.i_task = task
    self.Cfg = _G.ConfigManager.mission_extra_cfg[task.sid]
    if self.taskEnumType == nil then
        self.taskEnumType = self.Cfg.condition[1][1]
        self.taskcontentparams = self.Cfg.condition[1]
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
end

return CycleBattlePassTaskData
