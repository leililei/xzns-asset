---获取战令累计登录天数
---@param pbData table PB数据
---@param callback function 完成回调
function CycleBattlePassNet:GetLoginCount(pb,callback)
    local pbData = pb
    local item = _G.ConfigManager.net_map.game_cycle_battle_login_count
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end


---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CycleBattlePassNet:CallBack(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type CycleBattlePassNet
_G.CycleBattlePassNet = CycleBattlePassNet
return CycleBattlePassNet
