---@class CycleBattlePassNet : BaseGameNet	通信协议
local CycleBattlePassNet = _G.BaseClass("CycleBattlePassNet", require "BaseGameNet")
local base = require "BaseGameNet"

---@return CycleBattlePassNet CycleBattlePassNet
function CycleBattlePassNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取等级福利信息
---@param pbData table PB数据
---@param callback function 完成回调
function CycleBattlePassNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_cycle_battle_port_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---领取奖励
function CycleBattlePassNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_cycle_battle_port_award
