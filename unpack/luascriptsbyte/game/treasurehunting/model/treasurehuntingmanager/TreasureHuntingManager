local base = require "ThemeActivityBaseModel"
---@class TreasureHuntingManager : ActivitySynTypeBase 主题活动
---@field GetInstance fun():TreasureHuntingManager
---@field info activity_theme.artifact_hunt 主题活动数据
---@field openThemeActivityList ThemeActivityBaseModel[] 开放的活动
local TreasureHuntingManager = _G.BaseClass("TreasureHuntingManager", base)

---类的构造函数
function TreasureHuntingManager:__init()
    self.arenaClass = {}
    self.functionOpenDic = {}
end

---初始化数据
function TreasureHuntingManager:InitData(msg)
    self.TreasureData = msg
    require "DrawActivityModel":GetInstance():SetCoinNum(self.TreasureData.coin)
    self.sid = require("ThemeActivityManager"):GetInstance():GetActivityID()
    --require "DrawActivityModel":GetInstance():AddCoinNum(self.coinCount)
end

---初始化红点树{{id,lua,child}} id 红点id ,lua 红点脚本需继承RedPointBaseThemeActivity,child 子功能红点id,第一个红点必须id为1
function TreasureHuntingManager:InitRedTree()
    self.redTree = { { 1, "RedPointTreasureHuntMag", {} } }
end

---获取红点数
function TreasureHuntingManager:GetRedPointTree()
    return self.redTree
end

---检查红点
function TreasureHuntingManager:CheckRedPoint()
    if self:GetCoin() > 0 then
        return true
    end
    return false
end

function TreasureHuntingManager:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
end

---进入活动
function TreasureHuntingManager:EnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TreasureHuntingView.Name)
end

--普通奖励
function TreasureHuntingManager:GetNormal_award()
    local normal_award = {}
    if self.TreasureData and self.TreasureData.normal_award then
        normal_award = self.TreasureData.normal_award
    end
    return normal_award
end

--大奖
function TreasureHuntingManager:GetBig_award()
    local big_award = {}
    if self.TreasureData and self.TreasureData.big_award then
        big_award = self.TreasureData.big_award
    end
    return big_award
end

--当前轮次
function TreasureHuntingManager:GetRound()
    local round = 0
    if self.TreasureData and self.TreasureData.round then
        round = self.TreasureData.round
    end
    return round
end

--当前轮次
function TreasureHuntingManager:AddRound(num)
    if self.TreasureData and self.TreasureData.round then
        self.TreasureData.round = self.TreasureData.round +
            num
    else
        self.TreasureData.round = num
    end
    return self.TreasureData.round
end

--当前位置
function TreasureHuntingManager:GetPosition()
    local position = 1
    if self.TreasureData and self.TreasureData.position then
        position = self.TreasureData.position
    end
    if position == 0 then
        position = 1
    end
    return position
end

--当前位置
function TreasureHuntingManager:AddPosition(Positioning)
    if self.TreasureData and self.TreasureData.position then
        self.TreasureData.position = Positioning
    else
        self.TreasureData.position = Positioning
    end
    return self.TreasureData.position
end

--大奖选择道具sid
function TreasureHuntingManager:GetItem_sid()
    local item_sid = 0
    if self.TreasureData and self.TreasureData.index then
        item_sid = self.TreasureData.index
    end
    return item_sid
end

--大奖选择道具sid
function TreasureHuntingManager:AddItem_sid(index)
    if self.TreasureData and self.TreasureData.index then
        self.TreasureData.index = index
    end
end

--大奖选择道具sid
function TreasureHuntingManager:IsItem_sid(num)
    local item_sid = nil
    for _, value in pairs(self:GetBig_award()) do
        if value.index == num then
            item_sid = value
        end
    end
    return item_sid
end

--大奖已领取次数[{道具sid,领取次数}]
function TreasureHuntingManager:GetChoose_list()
    local choose_list = {}
    if self.TreasureData.choose_list == nil then
        -- bo
        self.TreasureData.choose_list = {}
    end
    if self.TreasureData and self.TreasureData.choose_list then
        choose_list = self.TreasureData.choose_list
    end
    return choose_list
end

--大奖已领取次数[{道具sid,领取次数}]
function TreasureHuntingManager:IsChoose_list(id)
    local choose_list = 0
    if self.TreasureData and self.TreasureData.choose_list then
        for key, value in pairs(self.TreasureData.choose_list) do
            if value.k == id then
                choose_list = value.v
            end
        end
    end
    return choose_list
end

--大奖已领取次数[{道具sid,领取次数}]
function TreasureHuntingManager:AddChoose_list(id)
    local choose_list = true
    if self.TreasureData and self.TreasureData.choose_list then
        for key, value in pairs(self.TreasureData.choose_list) do
            if value.k == id then
                value.v = value.v + 1
                choose_list = false
            end
        end
    end
    if choose_list then
        _G.table.insert(self.TreasureData.choose_list, { k = id, v = 1 })
    end
end

--大奖选择道具sid
function TreasureHuntingManager:GetCoin()
    local coin = require "DrawActivityModel":GetInstance():GetCoinNum()
    return coin or 0
end

--添加代币数量
function TreasureHuntingManager:AddCoin(num)
    require "DrawActivityModel":GetInstance():AddCoinNum(num)
    local coin = require "DrawActivityModel":GetInstance():GetCoinNum()
    return coin or 0
end

---神器寻宝-大奖选择
function TreasureHuntingManager:GetHuntChoose(param, callback)
    param.activity_id = self.sid
    require("TreasureHuntingNet"):GetInstance():HuntChoose(param, callback)
end

---神器寻宝-摇骰子
function TreasureHuntingManager:GetHuntDice(param, callback)
    param.activity_id = self.sid
    require("TreasureHuntingNet"):GetInstance():HuntDice(param, callback)
end

--- 是否快速骰子 设置
function TreasureHuntingManager.SetPlayerPrefs_CardIsAutoResolve(isAuto)
    local key = "TreasureHuntingManager" .. tostring(_G.PlayerModel:GetInstance().role_uid)
    _G.PlayerPrefsManager.SetInt(key, isAuto and 1 or 0)
end

--- 是否快速骰子 获取
---@return true 是自动分解
function TreasureHuntingManager.GetPlayerPrefs_CardIsAutoResolve()
    local key = "TreasureHuntingManager" .. tostring(_G.PlayerModel:GetInstance().role_uid)
    return _G.PlayerPrefsManager.GetInt(key, 1) == 0
end

--- 是否快速骰子 设置
function TreasureHuntingManager.SetPlayerPrefs_Zhi(isAuto)
    local key = "TreasureHuntingZhi" .. tostring(_G.PlayerModel:GetInstance().role_uid)
    _G.PlayerPrefsManager.SetInt(key, isAuto and 1 or 0)
end

--- 是否快速骰子 获取
---@return true 是自动分解
function TreasureHuntingManager.GetPlayerPrefs_Zhi()
    local key = "TreasureHuntingZhi" .. tostring(_G.PlayerModel:GetInstance().role_uid)
    return _G.PlayerPrefsManager.GetInt(key, 1) == 0
end

---是否有新奖励解锁
function TreasureHuntingManager:CheckAwardUnlockRedPoint()
    local cacheRound = self:GetAwardUnlockRedPoint()
    local curRound = self:GetRound()
    if curRound > cacheRound then
        for _, v in pairs(self:GetBig_award()) do
            if v.round <= curRound and v.round > cacheRound then
               return 1
            end
        end
    end
    return 0
end

---缓存当前轮数
function TreasureHuntingManager:SetAwardUnlockRedPoint()
    _G.PlayerPrefsManager.SetInt(
        self.sid .. "_TreasureHuntingUnlockAward",
        self:GetRound()
    )
end

---缓存当前轮数
function TreasureHuntingManager:GetAwardUnlockRedPoint()
    return _G.PlayerPrefsManager.GetInt(
        self.sid .. "_TreasureHuntingUnlockAward",
        1
    )
end

return TreasureHuntingManager
