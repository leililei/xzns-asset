---@class TreasureHuntingView
---@field go_table TreasureHuntingView_GoTable
local TreasureHuntingView = _G.BaseClass("TreasureHuntingView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
local StorageManager = _G.StorageManager:GetInstance()
function TreasureHuntingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --普通奖励
    self.normal_award = require("TreasureHuntingManager"):GetInstance():GetNormal_award()
    --大奖
    self.big_award = require("TreasureHuntingManager"):GetInstance():GetBig_award()
    --当前轮次
    self.round = require("TreasureHuntingManager"):GetInstance():GetRound()
    --当前位置
    self.position = require("TreasureHuntingManager"):GetInstance():GetPosition()
    --大奖选择道具sid
    self.item_sid = require("TreasureHuntingManager"):GetInstance():GetItem_sid()
    _G.SortList(
        self.big_award,
        function(a)
            return a.index
        end
    )
    self.itmeNum = {}
    for k, v in pairs(self.big_award) do
        local s = true
        for key, value in pairs(self.itmeNum) do
            if v.sid == value.sid then
                s = false
            end
        end
        if s then
            if _G.table.count(self.itmeNum) < 4 then
                _G.table.insert(self.itmeNum, v)
            end
        end
    end
    _G.SortList(
        self.itmeNum,
        function(a)
            local Grade = StorageManager:GetItemQuality(a.sid)
            return Grade, a.index
        end
    )

    --大奖已领取次数[{道具sid,领取次数}]
    self.choose_list = require("TreasureHuntingManager"):GetInstance():GetChoose_list()
    --大奖选择道具sid
    self.item_coin = require("TreasureHuntingManager"):GetInstance():GetCoin()
    self.normal_awardList = {}
    self:ShowNormalAward()
    self:ShowCharacterPositioning()
    self:RefreshSelectInfo()
    self:RefreshAwardRedPoint()
    self.isAuto = require("TreasureHuntingManager"):GetInstance().GetPlayerPrefs_CardIsAutoResolve() or false
    self.go_table.toggle_auto.isOn = self.isAuto
    self.isZhi = require("TreasureHuntingManager"):GetInstance().GetPlayerPrefs_Zhi() or false
    self.go_table.toggle_zhi.isOn = self.isZhi
    self.coinSid = require("TreasureHuntingManager"):GetInstance():GetItem_sid()
    ---判断物品是否存在并且是可见状态（显示各种货币）
    if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources = _G.ConfigManager.ui_cfg.TreasureHuntingView.resources
        local newResource = {}
        for i = 1, #resources do
            if resources[i] == self.coinSid then
                newResource[i] = self.coinSid
            else
                newResource[i] = resources[i]
            end
        end
        if #newResource > 0 then
            self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, newResource)
            )
        end
    end
end

function TreasureHuntingView:OnCreate()
    self:LoadEffect(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntingView_bg, self.go_table.aorrawimage_Bg_1)
    self:LoadEffect(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntingView_kuang, self.go_table.obj_raweff)
    self:LoadEffect(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntingView_tou, self.go_table.obj_TouZiEff)
    self.go_table.obj_TouZiEff:SetActiveE(0)
end

function TreasureHuntingView:LoadEffect(effect, parent)
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(effect, parent, check)
end

function TreasureHuntingView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    -- index = #self.big_award - index
    local data = self.itmeNum[index + 1]

    local gotable = _G.GetAutoGoTable(listView2)
    local award = {data.sid, data.num}
    gotable.obj_jianglis:RemoveAllChildren()
    --local isBuy = data.round < self.round
    StorageManager:GetItemBaseViewNew(
        award,
        gotable.obj_jianglis,
        function(tran)
            tran.gameObject:SetLocalScaleXYZ(1)
            --tran:SetGou(isBuy)
            tran:ShowNumText(false)
        end
    )

    return gotable
end

---骰子点击方法
function TreasureHuntingView:RollDice(msg)
    local num = 1
    if msg.is_big_award and msg.is_big_award < 1 then
        num = msg.position - self.position
    elseif msg.is_big_award >= 1 then
        -- body
        num = msg.position - self.position
        if num < 1 then
            num = 30 - self.position + msg.position
        end
        require("TreasureHuntingManager"):GetInstance():AddChoose_list(self.item_sid)
        self.item_sid = 0
        self.sid = nil
        require("TreasureHuntingManager"):GetInstance():AddItem_sid(0)
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    require("TreasureHuntingManager"):GetInstance():RefreshRedPoint()

    if not self.isAuto and not self.isZhi then
        self.ChoKa = true
        self.go_table.aorimage_TouZi:SetActiveE(0)
        local startCo =
            _G.coroutine.start(
            _G.handler(
                self,
                function()
                    self.go_table.obj_TouZiEff:SetActiveE(1)
                    _G.coroutine.waitforseconds(0.9)
                    self:TouZiAni(msg, num)
                end
            )
        )

        self.stopCoProgress = function()
            if startCo then
                _G.coroutine.stopwaiting(startCo)
                self.ChoKa = false
            end
        end
    else
        self:TouZiAni(msg, num)
    end
end

function TreasureHuntingView:TouZiAni(msg, num)
    self.go_table.obj_TouZiEff:SetActiveE(0)
    self:GenerateRandomNumber(msg.is_big_award, num, msg.position)
    self.go_table.aorimage_TouZi:SetActiveE(1)
    self:ShowCharacterPositioning(
        num,
        function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
    )

    --当前位置
    self.position = require("TreasureHuntingManager"):GetInstance():AddPosition(msg.position)
    self.item_coin = require("TreasureHuntingManager"):GetInstance():AddCoin(-msg.consume_coin)
    if msg.is_big_award and msg.is_big_award == 1 then
        self.round = require("TreasureHuntingManager"):GetInstance():AddRound(1)
    end
    self:RefreshAwardRedPoint()
    self:ShowNormalAward()
end

function TreasureHuntingView:GenerateRandomNumber(consume_coin, nums, position)
    local num = _G.math.random(1, 6)
    if consume_coin <= 1 and not self.isAuto then
        num = nums
    end
    self.go_table.aorimage_TouZi.SpriteName = "ui_tqdg_touzi_0" .. num
end

---显示人物定位
function TreasureHuntingView:ShowCharacterPositioning(Positioning, callback)
    local position = self.position
    local item = self.go_table["aorimage_" .. position]
    local x, y, z = item:GetPosition()
    y = y + 2.5
    local an = 0

    if Positioning and not self.isAuto and not self.isZhi then
        for i = 1, Positioning do
            an = 0.5 * i
            _G.DelayDo(
                an,
                function()
                    position = position + 1
                    if position > 30 then
                        position = 1
                    end
                    item = self.go_table["aorimage_" .. position]
                    x, y, z = item:GetPosition()
                    y = y + 2.5
                    self.go_table.aorrawimage_card:DoMove(x, y, z, nil, 0.5)
                end
            )
        end
        _G.DelayDo(
            an + 0.3,
            function()
                self.ChoKa = false
                -- if self.item_sid == 0 then
                --     self:OnBoxUseView()
                -- end
                if callback then
                    callback()
                end
            end
        )
    else
        if Positioning then
            -- body

            for i = 1, Positioning do
                position = position + 1
                if position > 30 then
                    position = 1
                end
                item = self.go_table["aorimage_" .. position]
                x, y, z = item:GetPosition()
                y = y + 2.5
            end
        end
        self.go_table.aorrawimage_card:SetPosition(x, y, z)
        -- if self.item_sid == 0 then
        --     self:OnBoxUseView()
        -- end
        if callback then
            callback()
        end
    end
end

---显示基础奖励
function TreasureHuntingView:ShowNormalAward()
    for i = 1, 10 do
        self:ShowAwardItem(i)
    end
end

---刷新选中信息
function TreasureHuntingView:ShowAwardItem(index)
    local item
    if self.normal_awardList[index] then
        item = self.normal_awardList[index]
    else
        item = _G.GetAutoGoTable(self.go_table["obj_raw" .. index])
        self.normal_awardList[index] = item
    end
    local award = self.normal_award[index]
    item.obj_frame:RemoveAllChildren()
    if index == 10 then
        item.aorimage_addBg:SetActiveE(self.item_sid == 0 and 1 or 0)
        if self.item_sid == 0 then
            self.go_table.obj_selectEffect:SetActiveE(1)
            self:RefreshSelectInfo()
            return
        else
            self.sid = require("TreasureHuntingManager"):GetInstance():IsItem_sid(self.item_sid)
            award = {sid = self.sid.sid, num = self.sid.num}
            self.go_table.obj_selectEffect:SetActiveE(0)
        end
    end
    local data = {award.sid, award.num}
    StorageManager:GetItemBaseViewNew(
        data,
        item.obj_frame,
        function(tran)
            if _G.IsNil(item.obj_frame) then
                _G.DestroyObject(tran)
                return
            end
            tran.gameObject:SetLocalScaleXYZ(1)
            if index <= _G.Mathf.Floor((self.position - 1) / 3) then
                tran:SetGou(true)
            else
                tran:SetGou(false)
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
end

--region 大奖选择
function TreasureHuntingView:OnBoxUseView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.TreasureHuntingSelectView.Name,
        self.sid,
        function(selectData)
            if selectData then
                self.sid = selectData
                self.item_sid = selectData.index
                self:ShowAwardItem(10)
                self:RefreshSelectInfo()
            end
        end,
        function()
            self:RefreshAwardRedPoint()
        end
    )
end

function TreasureHuntingView:RefreshSelectInfo()
    if self.item_sid and self.item_sid ~= 0 then
        self.go_table.obj_add:SetActiveE(0)
        local data = require("TreasureHuntingManager"):GetInstance():IsItem_sid(self.item_sid)
        self.go_table.aorrawimage_addIcon:LoadImage(
            _G.StorageManager:GetInstance():GetItemIcon(data.sid),
            function(image)
                image:SetActiveE(1)
            end
            )
            self.go_table.obj_ItemNum:SetActiveE(1)
            _G.UIUtils.SetItemNum(self.go_table, data.num)
    else
        self.go_table.obj_add:SetActiveE(1)
        self.go_table.aorrawimage_addIcon:SetActiveE(0)
        self.go_table.obj_ItemNum:SetActiveE(0)
    end
end

---刷新奖励红点
function TreasureHuntingView:RefreshAwardRedPoint()
    local redPoint = require("TreasureHuntingManager"):GetInstance():CheckAwardUnlockRedPoint()
    self.go_table.obj_chanegRedPoint:SetActiveE(redPoint)
    self.go_table.obj_redpoint:SetActiveE(redPoint)
end

function TreasureHuntingView:SetAutoShow(isAuto)
    isAuto = isAuto or false
    if self.isAuto == isAuto then
        return
    end
    self.isAuto = isAuto
    require("TreasureHuntingManager"):GetInstance().SetPlayerPrefs_CardIsAutoResolve(self.isAuto)
end

function TreasureHuntingView:SetZhiShow(isAuto)
    isAuto = isAuto or false
    if self.isZhi == isAuto then
        return
    end
    self.isZhi = isAuto
    require("TreasureHuntingManager"):GetInstance().SetPlayerPrefs_Zhi(self.isZhi)
end

--endregion
---按钮点击事件在这里派发
function TreasureHuntingView:OnClickBtn(go, isOn)
    local btnName = go:GetName()
    if self.ChoKa then
        return
    end
    if btnName == "@_aorbtn_CloseView" then
        self:Close()
    elseif btnName == "@_aorbtn_hunt" then
        if self.item_sid == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(2506)
            return
        end
        if self.item_coin <= 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 111)
            return
        end
        local data = {type = 1}
        if self.isAuto then
            data.type = 2
        end
    require("TreasureHuntingManager"):GetInstance():GetHuntDice(
            data,
            function(msg)
                self:RollDice(msg)
            end
        )
    elseif btnName == "@_aorbtn_Close" or btnName == "@_aorbtn_BG" then
        self.go_table.obj_BoxUseView:SetActiveE(0)
    elseif btnName == "@_aorbtn_raw" then
        self:OnBoxUseView(self.sid)
    elseif btnName == "$_toggle_auto" then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        self:SetAutoShow(isOn)
    elseif btnName == "$_toggle_zhi" then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        self:SetZhiShow(isOn)
    elseif btnName == "@_aorbtn_change" then
        self:OnBoxUseView(self.sid)
    elseif btnName == "@_aorbtn_help1" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 129)
    end
end

return TreasureHuntingView
