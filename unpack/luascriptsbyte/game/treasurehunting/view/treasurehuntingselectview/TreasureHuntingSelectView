local TreasureHuntingManager = require("TreasureHuntingManager")
---@class TreasureHuntingSelectView : UIBaseView	中文描述
---@field public go_table TreasureHuntingSelectView_GoTable GoTable
local TreasureHuntingSelectView = _G.BaseClass("TreasureHuntingSelectView", _G.UIBaseView)

function TreasureHuntingSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TreasureHuntingSelectView:OnCreate(selectData, callback, closeCallBack)
    self.selectData = selectData
    self.callback = callback
    self.closeCallBack = closeCallBack
    --大奖
    self.big_award = TreasureHuntingManager:GetInstance():GetBig_award()
    --当前轮次
    self.round = TreasureHuntingManager:GetInstance():GetRound()
    ---缓存的轮数
    self.cacheRound = TreasureHuntingManager:GetInstance():GetAwardUnlockRedPoint()
    self:InitDataList()
    self:RefreshSelectInfo()
    TreasureHuntingManager:GetInstance():SetAwardUnlockRedPoint()
    ---更新成最新值
    self.cacheRound = self.round
end

--初始化列表
function TreasureHuntingSelectView:InitDataList()
    ---解锁数据
    local unlockData = {}
    ---未解锁
    local lockData = {}
    local scrollIndex = 1
    self.dataList = {}
    for _, value in pairs(self.big_award) do
        if value.round > self.cacheRound then
            _G.table.insert(lockData, value)
        else
            _G.table.insert(unlockData, value)
        end
    end

    local StorageManager = _G.StorageManager:GetInstance()
    _G.SortList(
        unlockData,
        function(a)
            local remainNum = a.choose_num - TreasureHuntingManager:GetInstance():IsChoose_list(a.index)
            local Grade = StorageManager:GetItemQuality(a.sid)
            return (remainNum > 0 and 1 or 0), Grade, a.index
        end
    )
    _G.SortList(
        lockData,
        function(a)
            return -a.index
        end
    )

    for _, value in ipairs(unlockData) do
        _G.table.insert(self.dataList, value)
    end
    local amount = #self.dataList
    for index, value in ipairs(lockData) do
        if value.round < self.round then
            scrollIndex = index + amount
        end
        _G.table.insert(self.dataList, value)
    end
    if not self.ItemListView then
        self.go_table.scrollloopvectical_ItemList:InitItemData(#self.dataList, _G.handler(self, self.RefreshList))
        self.ItemListView = self.go_table.scrollloopvectical_ItemList
    else
        self.ItemListView:UpdateAllItem()
    end
    self.ItemListView:ScrollToIndex(scrollIndex - 1)
    self.cacheRound = TreasureHuntingManager:GetInstance():GetAwardUnlockRedPoint()
end

---刷新选中信息
function TreasureHuntingSelectView:RefreshSelectInfo()
    if self.selectData then
       self.go_table.obj_setItem:SetActiveE(1)
       self.go_table.obj_add:SetActiveE(0)
       self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.selectData.sid))
       _G.UIUtils.SetItemNum(self.go_table, self.selectData.num)
    else
        self.go_table.obj_add:SetActiveE(1)
        self.go_table.obj_setItem:SetActiveE(0)
    end
end

function TreasureHuntingSelectView:RefreshList(index, obj)
    local x = index + 1
    obj:SetActiveE(1)
    obj:SetName(x)
    local goId = obj:GetInstanceIDE()

    local data = self.dataList[x]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))
    tb.obj_itemss:RemoveAllChildren()
    local award = {data.sid, data.num}
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_itemss,
        function(tran)
            if _G.IsNil(tb.obj_itemss) or goId ~= obj:GetInstanceIDE() then
               return
            end
            tran.gameObject:SetLocalScaleXYZ(0.9)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
    if self.selectData and self.selectData.index == data.index then
        tb.aorimage_Kuang:SetActiveE(1)
    else
        tb.aorimage_Kuang:SetActiveE(0)
    end
    tb.itemData = require("TreasureHuntingManager"):GetInstance():IsChoose_list(data.index)
    tb.aortext_Names.text = _G.GetLangPackValue(90028500030, data.choose_num - tb.itemData)

    if data.round > self.round then
        tb.aorimage_suo:SetActiveE(1)
        tb.aortext_Names.text = _G.GetLangPackValue(90028500031, data.round - self.round)
    else
        if data.round > self.cacheRound then
            _G.UIUtils.LoadEffectByPath(
                _G.ConfigManager.ui_effect_cfg.ef_suo.Path,
                tb.obj_itemss,
                nil,
                function()
                    if _G.IsNil(tb.obj_itemss) or goId ~= obj:GetInstanceIDE() then
                        return
                    end
                    tb.aorimage_suo:SetActiveE(0)
                end,
                0.6
            )
        else
            tb.aorimage_suo:SetActiveE(0)
        end
    end
end

function TreasureHuntingSelectView:OnClickItem(go, _, selectData)
    if self.selectData and self.selectData.index == selectData.index or selectData.round > self.round then
        require "CommonTipManager":GetInstance():OpenTip(go, selectData.sid)
    else
        self.selectData = selectData
        self:RefreshSelectInfo()
        self.ItemListView:UpdateAllItem()
    end
end

---界面的销毁函数
function TreasureHuntingSelectView:OnDestroy()
end

function TreasureHuntingSelectView:OnCloseView()
    if self.closeCallBack then
        self.closeCallBack()
    end
    self:Close()
end

---按钮点击事件在这里派发
function TreasureHuntingSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:OnCloseView()
    elseif go == self.go_table.aorbtn_enter then
        if _G.table.isEmptyOrNil(self.selectData) then
            self:OnCloseView()
            return
        end
        local itemData = TreasureHuntingManager:GetInstance():IsChoose_list(self.selectData.index)
        if self.selectData.round > self.round then
            _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 770107)
            return
        end
        if self.selectData.choose_num - itemData <= 0 then
            return
        end
        local data = {index = self.selectData.index}
        TreasureHuntingManager:GetInstance():GetHuntChoose(
            data,
            function()
                TreasureHuntingManager:GetInstance():AddItem_sid(self.selectData.index)
                if self.callback then
                    self.callback(self.selectData)
                end
                self:OnCloseView()
            end
        )
    end
end

return TreasureHuntingSelectView