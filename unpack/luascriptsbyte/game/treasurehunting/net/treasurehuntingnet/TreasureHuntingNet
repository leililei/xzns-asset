local base = require("BaseGameNet")

---@class TreasureHuntingNet : BaseGameNet	通信协议
local TreasureHuntingNet = _G.BaseClass("TreasureHuntingNet", require("BaseGameNet"))

---@return TreasureHuntingNet TreasureHuntingNet
function TreasureHuntingNet:GetInstance()
    return base.GetInstance(self)
end

---神器寻宝-大奖选择
---@param pbdata table 发送数据
---@param callback function 回调方法
function TreasureHuntingNet:HuntChoose(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_activity_theme_artifact_hunt_choose
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---神器寻宝-摇骰子
---@param pbdata table 发送数据
---@param callback function 回调方法
function TreasureHuntingNet:HuntDice(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_activity_theme_artifact_hunt_dice
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TreasureHuntingNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return TreasureHuntingNet
