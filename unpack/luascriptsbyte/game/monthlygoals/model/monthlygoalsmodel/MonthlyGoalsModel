---@class MonthlyGoalsModel	中文描述
local MonthlyGoalsModel = _G.BaseClass("MonthlyGoalsModel", _G.Singleton)

---@return MonthlyGoalsModel MonthlyGoalsModel
function MonthlyGoalsModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function MonthlyGoalsModel:__init()
    self.isAkfPass = false
    -- _G.Events:GetInstance():AddListener(_G.MianViewState.MainViewEnable, self.MainViewEnable, self)
end

function MonthlyGoalsModel:MainViewEnable()
    if self:CheckRoleCreateTime() then
        if self.isAkfPass then
            local MainOpenViewFunItem = {}
            MainOpenViewFunItem.OpenViewFun = _G.handler(self, self.OpenGoalsView)
            _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.MonthlyGoals)
            _G.MainManager:GetInstance().InitMonthlyGoals = true
            self.isAkfPass = false
        end
    end
end

function MonthlyGoalsModel:OpenGoalsView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MonthlyGoalsView.Name)
end

function MonthlyGoalsModel:IsArriveSection(sid)
    if sid == _G.ConfigManager.discrete_cfg[100125][1][1] then
        self.isAkfPass = true
    end
end

function MonthlyGoalsModel:CheckRoleCreateTime()
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        if _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance():GetCreateRoleTime() < 30 * 86400 then
            return true
        end
    end
    return false
end

---销毁对象时,析构函数
function MonthlyGoalsModel:Dispose()
    -- _G.Events:GetInstance():RemoveListener(_G.MianViewState.MainViewEnable, self.MainViewEnable, self)
end

return MonthlyGoalsModel
