local MonthlyGoalsItem = require("MonthlyGoalsItem")

---@class MonthlyGoalsView : UIBaseView    中文描述
---@field public go_table MonthlyGoalsView_GoTable GoTable
---@field curModel number 当前模式(1排位赛2友谊赛)
local MonthlyGoalsView = _G.BaseClass("MonthlyGoalsView", _G.UIBaseView)

local ConfigManager = _G.ConfigManager

function MonthlyGoalsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MonthlyGoalsView:OnCreate()
    for i = 1, 5 do
        self:AddComponent(self.go_table["obj_item" .. i], MonthlyGoalsItem.New(self.go_table["obj_item" .. i], i))
    end
    _G.UIUtils.LoadEffectByCfg(
        ConfigManager.ui_effect_cfg.ef_MonthlyGoalsView_title,
        self.go_table.aorrawimage_title,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

---@private
function MonthlyGoalsView:OnDisable()
end

---界面的销毁函数
function MonthlyGoalsView:OnDestroy()
end

---按钮点击事件在这里派发
function MonthlyGoalsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        if self.go_table.toggle_eject.isOn then
            _G.PlayerPrefsManager.SetInt("MonthlyGoals", _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
        end
        self:Close()
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 99)
    end
end

return MonthlyGoalsView
