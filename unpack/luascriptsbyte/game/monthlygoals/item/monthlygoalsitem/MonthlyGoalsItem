local BaseAwardNewItem = require("BaseAwardNewItem")

---@class MonthlyGoalsItem    中文描述
---@field public go_table MonthlyGoalsView._obj_item1_GoTable
local MonthlyGoalsItem = _G.BaseClass("MonthlyGoalsItem", _G.Component)

local discrete_cfg = _G.ConfigManager.discrete_cfg

---类的构造函数
function MonthlyGoalsItem:__init(obj, index)
    self.index = index
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.aortext_title.text = _G.GetLangPackValue(90000010908 + index)
    local award = discrete_cfg[100123][index]
    self.item = BaseAwardNewItem.New(self.go_table.obj_item, nil, 88, self.go_table.obj_item)
    self.item:ShowWithID(
        {award[1], 0},
        nil,
        function(itemLua)
            if self.item.type == _G.StorageType.Card then
                self.item.item.star = award[2]
                self.item.item:UpdateStarBox(self.item.data)
                itemLua:ShowEffect(true)
            else
                self.item.item:ShowEffect(true)
            end
        end
    )
    local lanId = index == 5 and 90000010916 or 90000010914
    self.go_table.aortext_free.text =
        _G.GetLangPackValue(lanId, discrete_cfg[100124][1][index], self.item.data:GetName())
end

---点击按钮
function MonthlyGoalsItem:OnClickBtn(go, isOn)
end

---类的析构函数
function MonthlyGoalsItem:Dispose()
end

return MonthlyGoalsItem
