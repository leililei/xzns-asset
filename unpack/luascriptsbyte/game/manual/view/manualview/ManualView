function ManualView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_CloseView.EnableClickSound = false
end

---界面的入口函数
function ManualView:OnCreate()
    self.MaxSliderValue = {}
    for _, value in pairs(handbook_cul_cfg) do
        self.MaxSliderValue[value.id] = value.max_degree * value.weight_degree
    end

    _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.openPanel)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.SystemMaterialNewView_bgty_effect,
        self.go_table.trans_bg,
        function(eff)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(eff)
                return
            end
            --_G.GameUtil.SetActiveByCondition(self.go_table.obj_bg, false)
        end
    )
    self.oldIndex = 3
    self.pageTb = {}
    for i = 1, 3 do
        self.pageTb[i] = GetAutoGoTable(self.go_table["obj_page" .. i], _G.handlerbind(self, self.PageClick, i))
    end
    self.ManualDatas = require "ManualModel":GetInstance():GetManualDataToArray()
    self.ResourceDatas = require "ManualModel":GetInstance():GetResourcesData()
    self.SortList = require "ManualModel":GetInstance():GetSortList()
    self.pageTb[1].obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.ManualPage.id)
    self.pageTb[1].obj = GetAutoGoTable(self.go_table.obj_manual, _G.handler(self, self.OnClickBtn))
    self.pageTb[2].obj = GetAutoGoTable(self.go_table.obj_resources)
    self.pageTb[3].obj = GetAutoGoTable(self.go_table.obj_cultivate, _G.handler(self, self.OnClickBtn))
    self.pageTb[3].slider = GetAutoGoTable(self.pageTb[3].obj.slider_power)
    self:InitIndex()
    self.curGroup = 1
    self:InitGroup()
    self.curPage = 1
    self.SystemItems = {}
    self.ResourceItems = {}
    self.CultivateItems = {}
    self.taksItems = {}
    self.awardItems = {}
    self.dataCount = #self.ManualDatas
    _G.DelayFrameDo(
        function()
            ManualModel:GetAfkFromServer(
                function(data)
                    self.cardList = data
                    for k, v in pairs(self.cardList) do
                        if v.haveInfo then
                            self.curTraget = k
                            self.curData = self.cardList[self.curTraget]
                            break
                        end
                    end
                    if nil == self.curTraget then
                        self.curTraget = 1
                        self.curData = self.cardList[self.curTraget]
                    end
                    self:InitSelfCultivate(data)
                    self:UpdateCultivatePanel()
                    self:RefershCultivate()
                    self.pageTb[3].init = true
                    self.canClick = true
                end
            )
        end
    )
end

---页签点击事件
function ManualView:PageClick(go, ison, index)
    if index == self.oldIndex then
        return
    end
    if not self.canClick then
        return
    end
    if self.pageTb[self.oldIndex] then
        self.pageTb[self.oldIndex].obj_On:SetActiveE(0)
        self.pageTb[self.oldIndex].obj.gameObject:SetActiveE(0)
    end
    self.oldIndex = index
    self.pageTb[index].obj_On:SetActiveE(1)
    self.pageTb[index].obj.gameObject:SetActiveE(1)
    if index == 2 then
        if not self.pageTb[2].init then
            self.pageTb[2].obj.scrollloopvectical_resource:InitItemData(
                #self.ResourceDatas,
                _G.handler(self, self.RefreshResource)
            )
            self.pageTb[2].init = true
        end
    elseif index == 1 then
        if not self.pageTb[1].init then
            self.pageTb[1].obj.scrollloophorizontal_systemList:InitItemData(
                self.dataCount,
                _G.handler(self, self.RefreshSystemItem),
                self.curGroup - 1
            )
            self.pageTb[1].init = true
            self.pageTb[1].obj.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTaskItem))
            self.pageTb[1].obj.scrollloophorizontal_awardList:InitItemData(0, _G.handler(self, self.RefreshAward))
            self.maxPage = #self.ManualDatas
            self:UpdatePanel()
        end
    end
end

---更新评分面板
function ManualView:UpdateCultivatePanel()
    local data = self.cardList[self.curTraget]
    local sliderValue = math.floor(data.myTotalScore / data.totalMaxScore * 100 + 0.5)
    self.pageTb[3].obj.slider_power.value = sliderValue * 0.01
    if sliderValue >= 100 then
        sliderValue = 99.9
    end
    self.pageTb[3].obj.aortext_point.text = GetLangPackValue(90000010923, data.myTotalScore)
    self.pageTb[3].obj.aortext_rank.text = GetLangPackValue(90000010924, sliderValue)
    self.pageTb[3].obj.aortext_name.text = GetLangPackValue(data.card.cfg.Name)
    if not self.cultivateCard then
        ItemCardFactory:GetInstance():GetItemCard(
            ItemCardFactory.itemCardType.CardAllItem,
            self.pageTb[3].obj.obj_node,
            function(item)
                item:ShowCardData(data.card)
                item.gameObject:SetLocalScaleXYZ(0.8)
                self.cultivateCard = item
            end
        )
    else
        self.cultivateCard:ShowCardData(data.card)
    end
end

---刷新资源
function ManualView:RefreshResource(index, item)
    local newIndex = index + 1
    local instanceID = item:GetInstanceID()
    local tb = self.ResourceItems[instanceID]
    local data = self.ResourceDatas[newIndex]
    local sid = data.sid
    local itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg({sid, 1})
    if not tb then
        tb = GetAutoGoTable(item)
        AddViewBtnClick(item, _G.handlerbind(self, self.OnClickResourceItem, index, tb, itemData))
        self.ResourceItems[instanceID] = tb
        ItemFactory:GetInstance():GetItemCard(
            ItemFactory.itemType.baseItem,
            tb.obj_node,
            function(item)
                item:Show(sid, nil)
                tb.item = item
            end
        )
    else
        tb.item:Show(sid, nil)
        AddViewBtnClick(item, _G.handlerbind(self, self.OnClickResourceItem, index, tb, itemData))
    end
    local name = itemData.cfg.name or itemData.cfg.Name
    tb.aortext_name.text = GetLangPackValue(name)
    tb.aortext_desc.text = GetLangPackValue(itemData.cfg.Describe)
    return item
end

---刷新评分
function ManualView:RefershCultivate()
    local data = self.curData
    for i = 1, 10, 2 do
        local tb = self.CultivateItems[self.SortList[i]]
        if not tb then
            local Item = _G.InstantiateObject(self.go_table.obj_cultivateItems, self.pageTb[3].obj.trans_content)
            local Tb = GetAutoGoTable(Item)
            tb = GetAutoGoTable(Tb["obj_item" .. 1])
            AddViewBtnClick(
                Tb["obj_item" .. 1],
                _G.handlerbind(self, self.OnGoClick, handbook_cul_cfg[self.SortList[i]].item_way)
            )
            self.CultivateItems[self.SortList[i]] = tb

            tb = GetAutoGoTable(Tb["obj_item" .. 2])
            if self.SortList[i + 1] then
                AddViewBtnClick(
                    Tb["obj_item" .. 2],
                    _G.handlerbind(self, self.OnGoClick, handbook_cul_cfg[self.SortList[i + 1]].item_way)
                )
                self.CultivateItems[self.SortList[i + 1]] = tb
            else
                tb.gameObject:SetActiveE(0)
            end
        end
        for j = 1, 2 do
            local newIndex = i + j - 1
            local sort = self.SortList[newIndex]
            if nil ~= sort then
                local tb = self.CultivateItems[sort]
                --_G.LogError(data.score[newIndex] .. "," ..data.maxScore[newIndex] .. "," .. newIndex)
                local myValue = data.score[sort] / self.MaxSliderValue[sort]
                tb.slider_myPower.value = string.format("%.2f", myValue)
                tb.slider_maxPower.value = string.format("%.2f", (data.maxScore[sort] / self.MaxSliderValue[sort]))
                tb.aortext_point.text = GetLangPackValue(90000010923, data.score[sort])
                if myValue >= minLine then
                    tb.aortext_rank.text = GetLangPackValue(90000010924, data.weight[sort][3])
                else
                    tb.aortext_rank.text = GetLangPackValue(90026500029)
                end
                tb.aortext_name.text = GetLangPackValue(handbook_cul_cfg[sort].function_name)
                tb.aortext_desc.text = GetLangPackValue(handbook_cul_cfg[sort].function_doc)
            end
        end
    end
    _G.GameUtil.ReBuildRTF(self.pageTb[3].obj.trans_content)
end

---设置当前卡牌
function ManualView:InitSelfCultivate(data)
    if self.isFirst then
        return
    end
    self.isFirst = true
    local target
    for i = 1, #data do
        local cardData = data[i]
        ItemCardFactory:GetInstance():GetItemCard(
            ItemCardFactory.itemCardType.CardAllItem,
            self.pageTb[3].obj.obj_cards,
            function(item)
                item:ShowCardData(cardData.card, _G.handlerbind(self, self.OnClickCardItem, item, i))
                item:HideOrShowLevel(false)
                item.gameObject:SetLocalScaleXYZ(0.8)
                if i == self.curTraget then
                    target = item
                end
            end
        )
    end
    _G.DelayDo(
        0.5,
        function()
            local posx, posy = target.gameObject:GetLocalPosition()
            self.pageTb[3].obj.obj_select:SetActiveE(1)
            self.pageTb[3].obj.obj_select:SetLocalPosition(posx + 20, posy)
        end
    )
end

---点击卡牌
function ManualView:OnClickCardItem(_, item, index)
    if index == self.curTraget then
        return
    end
    if not self.cardList[index] then
        _G.PopWindowManager:GetInstance():ShowAllTips(100320)
        return
    end
    self.curData = self.cardList[index]
    self.curTraget = index
    local posx, posy = item.gameObject:GetLocalPosition()
    self.pageTb[3].obj.obj_select:SetLocalPosition(posx + 20, posy)
    self:UpdateCultivatePanel()
    self:RefershCultivate()
end

---点击资源
function ManualView:OnClickResourceItem(go, isOn, index, item, data)
    if item.show then
        item.obj_jump:SetActiveE(0)
        self.pageTb[2].obj.scrollloopvectical_resource:ChangeItemSize(index, 112)
        item.aorimage_btn.SpriteName = "ui_js_jb_xiala_btn"
        item.show = false
        return
    end
    item.obj_jump:SetActiveE(1)
    item.show = true
    item.aorimage_btn.SpriteName = "ui_js_jb_shouqi_btn"
    local wayList = _G.DeepCopyCfgTable(data.cfg.way)
    wayList = self:SortWay(wayList)
    item.obj_jump:RemoveAllChildren()
    for k, v in pairs(wayList) do
        local item = InstantiateObject(self.go_table.obj_jump, item.obj_jump)
        local tb = GetAutoGoTable(item, _G.handlerbind(self, self.OnGoClick, v))
        if tb == nil then
            return
        end
        tb.gameObject:SetActiveE(1)
        if not table.isEmptyOrNil(item_way_cfg[v].function_open) and #item_way_cfg[v].function_open >= 2 then
            if
                not _G[item_way_cfg[v].function_open[1]][item_way_cfg[v].function_open[2]](
                    ParseParam(item_way_cfg[v].function_open[3])
                )
             then
                tb.aorbtn_GO:SetActiveE(0)
            end
        end
        local t_name = GetLangPackValue(item_way_cfg[v].name)
        tb.aortext_WayName.text = t_name or GetLangPackValue(90022500393)
    end
    self.pageTb[2].obj.scrollloopvectical_resource:ChangeItemSize(index, 120 * #wayList + 112)
end

---当前往点击
function ManualView:OnGoClick(go, isOn, sid)
    _G.JumpManager:GetInstance():Jump(sid)
end

function ManualView:SortWay(wayList)
    table.sort(
        wayList,
        function(b, a)
            ---如果b未开放则不交换
            if #item_way_cfg[b].function_open >= 2 then
                if
                    not _G[item_way_cfg[b].function_open[1]][item_way_cfg[b].function_open[2]](
                        ParseParam(item_way_cfg[b].function_open[3])
                    )
                 then
                    return false
                end
            end
            ---如果b开放a未开放，则交换
            if #item_way_cfg[a].function_open >= 2 then
                if
                    not _G[item_way_cfg[a].function_open[1]][item_way_cfg[a].function_open[2]](
                        ParseParam(item_way_cfg[a].function_open[3])
                    )
                 then
                    return true
                end
            end
            ---其余情况均不交换
            return false
        end
    )
    return wayList
end

function ManualView:InitIndex()
    for i, v in ipairs(self.ManualDatas) do
        v.index = i
    end
end

function ManualView:InitGroup()
    for i, v in ipairs(self.ManualDatas) do
        if v:CheckCanTake() then
            self.curGroup = i
            break
        end
    end
end

---刷新界面显示
function ManualView:RefreshSystemItem(index, item)
    local newIndex = index + 1
    local instanceID = item:GetInstanceID()
    local tb = self.SystemItems[instanceID]
    if not tb then
        tb = GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickSystemItem, tb))
        self.SystemItems[instanceID] = tb
    end
    tb.index = newIndex
    local data = self.ManualDatas[newIndex]
    _G.GameUtil.SetActiveByCondition(tb.obj_On, data.index == self.curGroup)
    if data.index == self.curGroup then
        self.curItem = tb
    end
    tb.aortext_label.text = _G.LangUtil.GetLangPackValue(data.cfg.name)
    tb.aortext_label2.text = _G.LangUtil.GetLangPackValue(data.cfg.name)
    _G.GameUtil.SetActiveByCondition(tb.obj_mask, data.isLock)
    _G.GameUtil.SetActiveByCondition(tb.obj_gou, data.state == _G.TaskEnum.ETaskState.Submited)
    if data.isLock then
        tb.aortext_lock.text = data.lockStr
    end
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.ManualPage.id, data.cfg.id)
    return item
end

---点击系统
function ManualView:OnClickSystemItem(go, isOn, item)
    local data = self.ManualDatas[item.index]
    if data.isLock then
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(data.cfg.function_open)
    else
        if self.curItem then
            _G.GameUtil.SetActiveByCondition(self.curItem.obj_On, false)
        end
        self.curItem = item
        _G.GameUtil.SetActiveByCondition(self.curItem.obj_On, not data.isLock)

        self.curPage = 1
        self.curGroup = data.index
        self:UpdatePanel()
    end

    --  end
end
---刷新任务
function ManualView:RefreshTaskItem(index, obj)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceID()
    local tb = self.taksItems[instanceID]
    local data = self.ManualDatas[self.curItem.index]
    local task = data.taskList[newIndex]
    if not tb then
        tb = GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, tb))
        self.taksItems[instanceID] = tb
    end
    tb.index = newIndex
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(task.Cfg.desc)
    tb.aortext_label.color = _G.ColorTools.FormatColorByString(data.isLock and "555457" or "284b8c")
    if not task.i_task or task:ChekIsGet() then
        tb.slider_progress.value = 1
        tb.aortext_Slider.text = string.format("%s/%s", task.Cfg.count, task.Cfg.count)
        _G.GameUtil.SetActiveByCondition(tb.aorimage_complete, true)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_jump, false)
    else
        if task.Cfg.condition[1][#task.Cfg.condition[1]] == 0 then
            tb.slider_progress.value = math.max(task.i_task.target[1] / task.Cfg.count, 0)
        else
            tb.slider_progress.value =
                math.max(task.i_task.target[1] / (task.Cfg.condition[1][#task.Cfg.condition[1]]), 0)
        end
        tb.aortext_Slider.text = string.format("<color=#ff5656>%s</color>/%s", task.i_task.target[1], task.Cfg.count)
        _G.GameUtil.SetActiveByCondition(tb.aorimage_complete, false)
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_jump, true)
    end
end
---点击任务
function ManualView:OnClickTask(go, isOn, item)
    local data = self.ManualDatas[self.curItem.index].taskList[item.index]
    _G.JumpManager:GetInstance():Jump(data.Cfg.link)
end

function ManualView:RefreshAward(index, obj)
    local instanceID = obj:GetInstanceID()
    local tb = self.awardItems[instanceID]
    local data = self.ManualDatas[self.curItem.index].cfg.reward[index + 1]
    if not tb then
        tb = require "BaseAwardNewItem".New(obj, nil, 72)
        self.awardItems[instanceID] = tb
    end
    tb:ShowWithID(data)
    _G.GameUtil.SetActiveByCondition(tb.go_table.obj_mask, data.state == _G.TaskEnum.ETaskState.Submited)
end

---获取奖励
function ManualView:GetReward()
    local data = self.ManualDatas[self.curItem.index]
    if data.isLock or not data:CheckCanTake() then
        return
    end
    local tb = {}
    for i, v in ipairs(data.taskList) do
        tb[i] = v.Cfg.id
    end
    ManualModel:GetInstance():GetReward(
        data.id,
        function()
            self:InitGroup()
            self.pageTb[1].obj.scrollloophorizontal_systemList:ScrollToIndex(self.curGroup - 1)
            self.pageTb[1].obj.scrollloophorizontal_systemList:UpdateAllItem()
            self:UpdatePanel()
        end
    )
end

---更新界面显示
function ManualView:UpdatePanel()
    if self.oldIndex == 1 then
        local data = self.ManualDatas[self.curItem.index]
        self.pageTb[1].obj.aortext_title.text = _G.LangUtil.GetLangPackValue(data.cfg.name)
        self.pageTb[1].obj.aortext_content.text = _G.LangUtil.GetLangPackValue(data.cfg.desc[1])
        self.pageTb[1].obj.aorrawimage_one:LoadImage(data.cfg.picture[1])
        self.pageTb[1].obj.scrollloopvectical_taskList:UpdateCount(#data.taskList)
        local count = #data.cfg.reward
        self.pageTb[1].obj.scrollloophorizontal_awardList:UpdateScrollRectWeight(72 * count + 20 + 16 * (count - 1))
        self.pageTb[1].obj.scrollloophorizontal_awardList:UpdateCount(count)
        local canTake = data:CheckCanTake()
        self.pageTb[1].obj.aorbtn_get:SetGray(not canTake)
        if not canTake then
            self.pageTb[1].obj.aortext_label.text =
                "<color=#414141>" .. _G.LangUtil.TryGetLangValue(90000010016) .. "</color>"
        else
            self.pageTb[1].obj.aortext_label.text =
                "<color=#914801>" .. _G.LangUtil.TryGetLangValue(90000010016) .. "</color>"
        end
        _G.GameUtil.SetActiveByCondition(self.pageTb[1].obj.aorbtn_get, not data:CheckIsGet())
        _G.GameUtil.SetActiveByCondition(self.pageTb[1].obj.obj_complete, data:CheckIsGet())
    elseif self.oldIndex == 3 then
        ManualModel:GetAfkFromServer(
            function(data)
                self.cardList = data
                for k, v in pairs(self.cardList) do
                    if v.haveInfo then
                        self.curTraget = k
                        self.curData = self.cardList[self.curTraget]
                        break
                    end
                end
                if nil == self.curTraget then
                    self.curTraget = 1
                    self.curData = self.cardList[self.curTraget]
                end
                self:InitSelfCultivate(data)
                self:UpdateCultivatePanel()
                self:RefershCultivate()
                self.pageTb[3].init = true
                self.canClick = true
            end
        )
    end
end

function ManualView:OnStartClose()
    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
end

---按钮点击事件在这里派发
function ManualView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        self:Close()
    elseif name == "@_aorbtn_get" then
        self:GetReward()
    elseif name == "@_aorbtn_comment" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommentView.Name, self.curData.card.sid)
    elseif name == "@_aorbtn_yips" then
        self.go_table.obj_tips:SetActiveE(1)
    elseif name == "@_aorbtn_CloseTips" then
        self.go_table.obj_tips:SetActiveE(0)
    elseif name == " @_aorbtn_help" then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 91)
    end
end

function ManualView:CheckIsSection()
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    return world.Cfg.Scene_Type == _G.SceneType.Section
end

return ManualView
