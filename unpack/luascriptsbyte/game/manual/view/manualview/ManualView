---@field public go_table ManualView_GoTable GoTable
---@field public SystemItems ManualView._obj_ListItem_GoTable[]
---@field public ResourceItems 资源列表物体
---@field ManualDatas ManualData[]
local ManualView = _G.BaseClass("ManualView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local item_way_cfg = _G.ConfigManager.item_way_cfg
local handbook_cul_cfg = _G.ConfigManager.handbook_cul_cfg
local CultivateType = _G.CultivateType
local table = _G.table
--local TrackingPointModel = require("TrackingPointModel")
local InstantiateObject = _G.InstantiateObject
local GetAutoGoTable = _G.GetAutoGoTable
local ItemFactory = _G.ItemFactory
local ItemCardFactory = _G.ItemCardFactory
local AddViewBtnClick = _G.AddViewBtnClick
local minLine = _G.ConfigManager.discrete_cfg[106421][1][1] / 10000
local string = _G.string
local math = _G.math

local ParseParam = function(param)
    local tmp = tonumber(param)
    if tmp then
        return tmp
    else
        return param
    end
end
