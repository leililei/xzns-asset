---@class ManualNet : BaseGameNet	通信协议
local ManualNet = _G.BaseClass("ManualNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return ManualNet ManualNet
function ManualNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function ManualNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_handbook_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.SuccessCall))
    self.Call[port] = callback
end

---获取奖励
function ManualNet:GetReward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_handbook_unlock
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.SuccessCall))
    self.Call[port] = callback
end

function ManualNet:Finish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_handbook_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.SuccessCall))
    self.Call[port] = callback
end

function ManualNet:Getcultivate(pbData, callback)
    local item = _G.ConfigManager.net_map.game_handbook_data_stat
    local port = base.Access(self, item, {card_sid = pbData}, _G.handlerbind(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ManualNet:SuccessCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type ManualNet
return ManualNet
