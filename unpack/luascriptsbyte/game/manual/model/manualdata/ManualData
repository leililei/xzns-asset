---@class ManualData	中文描述
---@field id number 手册id
---@field cfg handbook_cfg
---@field taskList ManualTaskData[]
local ManualData = _G.BaseClass("ManualData")

---类的构造函数
function ManualData:__init()
end

function ManualData:Parse(id)
    self.id = id
    self.cfg = _G.ConfigManager.handbook_cfg[id]
    self.isLock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    self:InitTask()
    if not self.isLock then
        self:UpdateState()
    else
        self:InitLockStr()
    end
end
---初始化任务
function ManualData:InitTask()
    if not _G.table.isEmptyOrNil(self.taskList) then
        for k, v in pairs(self.taskList) do
            v:Dispose()
        end
    end
    self.taskList = {}
    for i, v in ipairs(self.cfg.mission_extra) do
        self.taskList[i] = require "ManualModel":GetInstance():GetTask(v, self.id)
        if self.taskList[i] then
            if not self.taskList[i].i_task then
                local data = {}
                data.manualId = self.id
                self.taskList[i] = require "ManualTaskData".New(self.taskList[i], nil, _G.MarkTaskType.Manual, data)
                require "ManualModel":GetInstance():ChangeTaskData(v, self.taskList[i])
            end
            self.taskList[i].manualId = self.id
            self.taskList[i].call = _G.handler(self, self.UpdateState)
        end
    end
end
---更新状态
function ManualData:UpdateState()
    if self.isLock then
        self.state = _G.TaskEnum.ETaskState.Invalide
        return
    end
    if require "ManualModel":GetInstance():CheckIsGetReward(self.id) then
        self.state = _G.TaskEnum.ETaskState.Submited
    else
        for _, v in pairs(self.taskList) do
            if not v:ChekIsGet() then
                self.state = _G.TaskEnum.ETaskState.Executing
                return
            end
        end
        self.state = _G.TaskEnum.ETaskState.Completed
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ManualPage.id, self.id)
    end
end

---检测是否可领取
function ManualData:CheckCanTake()
    return self.state == _G.TaskEnum.ETaskState.Completed
end

function ManualData:CheckIsGet()
    return require "ManualModel":GetInstance():CheckIsGetReward(self.id)
end

function ManualData:RefreshData()
    self:UpdateState()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ManualPage.id, self.id)
end
---解锁刷新数据
function ManualData:ChangeLock()
    if not self.isLock then
        return
    end
    self.isLock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    if _G.table.isEmptyOrNil(self.taskList) then
        self:InitTask()
    end
    if not self.isLock then
        self:RefreshData()
    end
end

function ManualData:InitLockStr()
    local cfg = _G.ConfigManager.function_open_cfg[self.cfg.function_open]
    local _, lockType, tipsid, content = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg.function_open)
    if cfg then
        self.lockStr, self.tipsId = _G.FunctionManager:GetInstance():GetTipsStr(cfg.Id)
    end
end

---类的析构函数
function ManualData:Dispose()
end

return ManualData
