function ManualModel:ChangeTaskData(id, data)
    self.taskList[id] = data
end

---检测是否已领取
function ManualModel:CheckIsGetReward(id)
    return self.sidList[id]
end
---检测是否可领取
function ManualModel:CheckIsCanTake(id)
    if self:CheckIsGetReward(id) then
        return false
    end

    local data = self:GetManualData(id)
    if data then
        return data:CheckCanTake()
    elseif self.isOpen then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("maunalData error : id :" .. id .. "not Find")
        end
    end
end
