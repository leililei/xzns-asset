function ManualModel:CheckTaskIsFinish(id)
    return self.finishTaskList[id]
end

---获取手册解锁奖励
function ManualModel:GetReward(id, callback)
    local data = self:GetManualData(id)
    if data then
        local tb = {}
        for i, v in ipairs(data.taskList) do
            tb[i] = v.Cfg.id
        end
        self:FinishTask(
            id,
            tb,
            function(msg)
                for i, v in ipairs(tb) do
                    if not self.finishTaskList[v] then
                        _G.PopWindowManager:GetInstance():ShowAllTips(msg.finish[i].ack)
                        return
                    end
                end
                ManualNet:GetInstance():GetReward(
                    {sid = id},
                    _G.handlerbind(self, self.GetRewardCall, id, msg, callback)
                )
            end
        )
    end
end

---获取手册解锁奖励回调
function ManualModel:GetRewardCall(msg, id, msg2, callback)
    if msg.ack ~= 1 then
        return
    end
    self:AddCompleteId(id)
    local data = self:GetManualData(id)
    data:UpdateState()
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    if msg2.award then
        if msg.award.item then
            if not msg.award.item then
                msg.award.overflow = {}
            end
            _G.table.insertto(msg.award.item, msg2.award.item)
        end
        if msg.award.overflow then
            if not msg.award.overflow then
                msg.award.overflow = {}
            end
            _G.table.insertto(msg.award.overflow, msg2.award.item)
        end
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ManualPage.id, id)
    if callback then
        callback()
    end
end

function ManualModel:AddCompleteId(id)
    self.sidList[id] = true
end
---获取任务数据
---@return ManualData
function ManualModel:GetManualData(id)
    if not self.isOpen then
        return nil
    end
    return self.ManualDatas[id]
end

function ManualModel:GetManualDataToArray()
    local tb = _G.table.toArray(self.ManualDatas)
    _G.table.sort(
        tb,
        function(a, b)
            return a.cfg.group < b.cfg.group
        end
    )
    return tb
end
---完成任务
function ManualModel:FinishTask(id, task, callback)
    local msg = {sid = id, t_sid = task, finish_type = 2}
    require "ManualNet":GetInstance():Finish(
        msg,
        function(data)
            for _, v in pairs(data.finish) do
                if v.ack == 1 then
                    self.finishTaskList[v.sid] = true
                end
            end
            if data.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
            end
            if callback then
                callback(data)
            end
        end
    )
end

---@param  task task.i_task
function ManualModel:UpdataTask(task)
    if not self.isOpen then
        return
    end
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTask(task.sid)
    if mTask == nil or not mTask.i_task then
        return isUpdata
    end
    mTask:UpdataData(task)
    return true
end

