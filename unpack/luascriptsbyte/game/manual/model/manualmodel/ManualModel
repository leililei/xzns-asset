function ManualModel:GetAfkFromServer(callback)
    local data = require("EmbattleModel"):GetInstance():GetEmbattleSidsData(self:Getcultivate())
    local getNew = false
    for k, v in pairs(data) do
        if v ~= 0 then
            if self.getNew or not self.cardList or not self.cardList[k] or self.cardList[k].card.sid ~= v then
                getNew = true
                self:GetNewCultivateInfo()
                require "ManualNet":GetInstance():Getcultivate(
                    data,
                    _G.handlerbind(self, self.GetAfkEmbattle, callback)
                )
                break
            end
        end
    end
    if not getNew then
        self.cardList = nil
        local StorageManager = _G.StorageManager:GetInstance()
        local data = require("EmbattleModel"):GetInstance():GetEmbattleDataWithoutMetatable(self:Getcultivate())
        for k, v in pairs(data) do
            if v ~= 0 then
                local card = StorageManager:GetDatasByUid(_G.StorageID.Card, v)
                if not table.isEmptyOrNil(card) then
                    self:CalculateCard(card)
                end
            end
        end
        self:CalculateCardRank()
        return callback(self.cardList)
    end
end

---获取布阵
---@param msg handbook.s2c_handbook_data_stat
function ManualModel:GetAfkEmbattle(msg, callback)
    self.cardList = {}
    self.pubCultivate = msg.pub_info
    self.cardCultivate = msg.card_info
    local data = require("EmbattleModel"):GetInstance():GetEmbattleDataWithoutMetatable(self:Getcultivate())
    CombineModel = require "CombineModel":GetInstance()
    PlayerTreeModel = require "PlayerTreeModel":GetInstance()
    CampsiteModel = require "CampsiteModel":GetInstance()
    local campsiteStar = CampsiteModel:GetAllStar()
    self.campsiteStar = {0, 0, 0, 0, 0, 0}
    if not table.isEmptyOrNil(campsiteStar) then
        self.campsiteStar = campsiteStar
    end
    self.combineLv = CombineModel:GetAllLevel() or 0
    self:CalculateInterval()
    local StorageManager = _G.StorageManager:GetInstance()
    for k, v in pairs(data) do
        if v ~= 0 then
            local card = StorageManager:GetDatasByUid(_G.StorageID.Card, v)
            if not table.isEmptyOrNil(card) then
                self:CalculateCard(card)
            end
        end
    end
    self:CalculateCardRank()
    callback(self.cardList)
end

---计算单卡自身积分
---@param card CardData
function ManualModel:CalculateCard(card)
    if not self.cardList then
        self.cardList = {}
    end
    local itemdata = {}
    if table.isEmptyOrNil(self.cardIntervalList[card.sid]) then
        itemdata.haveInfo = false
    else
        itemdata.haveInfo = true
    end
    itemdata.score = {}
    itemdata.card = card
    itemdata.score[CultivateType.Level] = card.lv * handbook_cul_cfg[CultivateType.Level].weight_degree
    itemdata.score[CultivateType.Star] = card.star * handbook_cul_cfg[CultivateType.Star].weight_degree
    local equipLv = 0
    for k, v in pairs(card.EquipBar) do
        if v.Grade then
            equipLv = equipLv + v.Grade * (1 + equipDegree * v.streng)
        end
    end
    itemdata.score[CultivateType.Equipment] = equipLv * handbook_cul_cfg[CultivateType.Equipment].weight_degree
    -- local decorationLv = 0
    -- for k, v in pairs(card.DecorationBar) do
    --     if v.Grade then
    --         decorationLv = decorationLv + v.Grade * (1 + decorationDegree * v.streng)
    --     end
    -- end
    -- itemdata.score[CultivateType.Decoration] = decorationLv * handbook_cul_cfg[CultivateType.Decoration].weight_degree
    itemdata.score[CultivateType.soulLink_lv] =
        card.soulLink_lv * handbook_cul_cfg[CultivateType.soulLink_lv].weight_degree
    itemdata.score[CultivateType.Inborn] = #card.open_inborn * handbook_cul_cfg[CultivateType.Inborn].weight_degree
    local artifact = card.ArtifactBar
    local artifactScore =
        artifact.cfg and
        artifact.cfg.Order * (1 + artifactLevelDegress * artifact.lv) * (1 + artifactStarDegress * artifact.star) or
        0
    itemdata.score[CultivateType.Artifact] = artifactScore * handbook_cul_cfg[CultivateType.Artifact].weight_degree
    itemdata.score[CultivateType.Combine] = self.combineLv * handbook_cul_cfg[CultivateType.Combine].weight_degree
    itemdata.score[CultivateType.PlayerTree] =
        PlayerTreeModel:GetLv(card.cfg.Professional) * handbook_cul_cfg[CultivateType.PlayerTree].weight_degree
    
    ---@type table<number,SpiritualData>
    local spiritualBar = card.SpiritualBar
    local spiritualScore = 0
    for index, spiritual in pairs(spiritualBar) do
        if spiritual and spiritual:GetCfg() then
            spiritualScore =
                spiritualScore +
                spiritual:GetOrder() * (1 + spiritualLevelDegress * spiritual.lv) *
                    (1 + spiritualStarDegress * spiritual.star)
        end
    end
    itemdata.score[CultivateType.Spiritual] = spiritualScore * handbook_cul_cfg[CultivateType.Spiritual].weight_degree
    table.insert(self.cardList, itemdata)
end

---@class ManualModelScoreData
---@param maxScore number
---@param interval handbook.i_interval_info[]

local CreateData = function(maxData, intervalData)
    local T = {}
    T = {}
    T.maxScore = maxData
    T.interval = {}
    for i = 1, #intervalData do
        T.interval[i] = {}
        T.interval[i].num = intervalData[i][3]
        T.interval[i].score_start = intervalData[i][1]
        T.interval[i].score_end = intervalData[i][2]
    end
    return T
end

---计算全服数据
function ManualModel:CalculateInterval()
    ---@type table<number,table<number,ManualModelScoreData>>
    self.intervalList = {}
    for k, v in pairs(self.pubCultivate or {}) do
        local data = {}
        data.maxScore = v.max_score
        data.interval = v.interval_info
        local num = math.modf(v.sid / 100)
        if v.sid % 100 == 0 then
            self.intervalList[num] = data
        else
            if not self.intervalList[num] then
                self.intervalList[num] = {}
            end
            self.intervalList[num][v.sid % 100] = data
        end
    end
    ---@type table<number,table<number,ManualModelScoreData>>
    self.cardIntervalList = {}
    for k, v in pairs(self.cardCultivate) do
        if v.card_sid ~= 0 then
            self.cardIntervalList[v.card_sid] = {}
            if v.info then
                for k, v1 in pairs(v.info) do
                    local num = math.modf(v1.sid / 100)
                    local data = {}
                    data.maxScore = v1.max_score
                    data.interval = v1.interval_info
                    self.cardIntervalList[v.card_sid][num] = data
                end
            end
        end
    end
end

---转换本地模拟数据,没有卡牌数据时从这里取
---如果表里type=1里面有对应的cardSid就取那个数据,如果没有就取type=2的数据
function ManualModel:CalculateLocalInterval(cardSid)
    if _G.table.isEmptyOrNil(self.cardLocalIntervalList) then
        self.cardLocalIntervalList = {}
        self.cardNoDataLocalInterval = {}
        for k, v in pairs(_G.ConfigManager.card_acc_info_zhj_tanwan) do
            if v.type == 1 then
                self.cardLocalIntervalList[v.card_sid] = {}
                self.cardLocalIntervalList[v.card_sid][CultivateType.Star] = CreateData(v.max_star, v.star_interval)
                self.cardLocalIntervalList[v.card_sid][CultivateType.soulLink_lv] =
                    CreateData(v.max_exclusive, v.exclusive_interval)
                self.cardLocalIntervalList[v.card_sid][CultivateType.Inborn] =
                    CreateData(v.max_talent, v.talent_interval)
            elseif v.type == 2 then
                self.cardNoDataLocalInterval[CultivateType.Star] = CreateData(v.max_star, v.star_interval)
                self.cardNoDataLocalInterval[CultivateType.soulLink_lv] =
                    CreateData(v.max_exclusive, v.exclusive_interval)
                self.cardNoDataLocalInterval[CultivateType.Inborn] = CreateData(v.max_talent, v.talent_interval)
            end
        end
    end
    return self.cardLocalIntervalList[cardSid] or self.cardNoDataLocalInterval
end

---转换本地模拟数据,其他数据没有时从这里取
function ManualModel:CalculateLocalIntervalAll()
    if self.intervalListTemp then
        return self.intervalListTemp
    end
    local cfg
    for k, v in pairs(_G.ConfigManager.public_acc_info) do 
        cfg = v
        break
    end
    self.intervalListTemp = {}
    self.intervalListTemp[_G.CultivateType.Level] = CreateData(cfg.max_level, cfg.level_interval)
    self.intervalListTemp[_G.CultivateType.Equipment] = CreateData(cfg.max_equ_score, cfg.equ_score_interval)
    self.intervalListTemp[_G.CultivateType.Artifact] = CreateData(cfg.max_art_score, cfg.art_score_interval)
    self.intervalListTemp[_G.CultivateType.Combine] = CreateData(cfg.max_combine, cfg.combine_interval)
    self.intervalListTemp[_G.CultivateType.PlayerTree] = {}
    self.intervalListTemp[_G.CultivateType.PlayerTree][1] = CreateData(cfg.max_prof_tree_1, cfg.prof_tree_interval_1) 
    self.intervalListTemp[_G.CultivateType.PlayerTree][2] = CreateData(cfg.max_prof_tree_2, cfg.prof_tree_interval_2) 
    self.intervalListTemp[_G.CultivateType.PlayerTree][3] = CreateData(cfg.max_prof_tree_3, cfg.prof_tree_interval_3) 
    self.intervalListTemp[_G.CultivateType.PlayerTree][4] = CreateData(cfg.max_prof_tree_4, cfg.prof_tree_interval_4) 
    self.intervalListTemp[_G.CultivateType.PlayerTree][5] = CreateData(cfg.max_prof_tree_5, cfg.prof_tree_interval_5) 
    self.intervalListTemp[_G.CultivateType.Spiritual] = CreateData(cfg.max_soul_score, cfg.soul_score_interval)
    return self.intervalListTemp
end

---计算单卡排行
function ManualModel:CalculateCardRank()
    for k, v in pairs(self.cardList) do
        local allRate = 0
        local totalMaxScore = 0
        local myTotalScore = 0
        for i = 1, #v.score do
            if nil ~= v.score[i] then
                local data = v.haveInfo and self.cardIntervalList[v.card.sid] or self:CalculateLocalInterval(v.card.sid)
                local intervalData = self.intervalList[i] or data[i] or self:CalculateLocalIntervalAll()[i]
                if i == _G.CultivateType.PlayerTree then
                    intervalData = intervalData[v.card.cfg.Professional]
                    
                end
                local allCount = 0
                local myCount = 0
                if intervalData and intervalData.interval then
                    for k1, v1 in pairs(intervalData.interval) do
                        allCount = allCount + v1.num
                        if v1.score_start < v.score[i] then
                            myCount = myCount + v1.num
                        end
                    end
                end
                if not v.weight then
                    v.weight = {}
                    v.maxScore = {}
                end
                local ims = intervalData and intervalData.maxScore or 0
                v.maxScore[i] = ims
                local rate = 0
                if allCount > 0 then
                    rate = myCount / allCount * 100
                elseif v.score[i] > 0 then
                    rate = 100
                    allCount = 1
                    myCount = 1
                    v.maxScore[i] = v.score[i]
                end
                rate = rate == 100 and 99.9 or rate
                -- _G.LogError(rate.." "..i)
                v.weight[i] = {myCount, allCount, string.sub(rate, 1, 4)}
                allRate = allRate + rate
                totalMaxScore = totalMaxScore + ims
                myTotalScore = myTotalScore + v.score[i]
            end
        end
        v.totalMaxScore = totalMaxScore
        v.allRate = string.format("%.1f", allRate * 0.1)
        v.myTotalScore = myTotalScore
    end
end

---获取资源图鉴数据
function ManualModel:GetResourcesData()
    if not self.resourcesCfg then
        local insert = _G.table.insert
        self.resourcesCfg = {}
        for k, v in pairs(resourcesCfg) do
            local data = {}
            data.sid = v.id
            data.order = v.order
            insert(self.resourcesCfg, data)
        end
        _G.SortList(
            self.resourcesCfg,
            function(a)
                return -a.order
            end
        )
    end
    return self.resourcesCfg
end

