---@return ManualModel ManualModel
function ManualModel:GetInstance()
    return self.super.GetInstance(self)
end

function ManualModel:__init()
    self.sidList = {}
    self.finishTaskList = {}
    self.taskList = {}
    self.curFunctionOpenID = 58
    self.isOpen = false
    self.isadd = false
    self.campsiteStar = {}
    self.SortList = {}
    for k, v in pairs(handbook_cul_cfg) do
        self.SortList[v.order] = v.id
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.UpdataOnUIShow, self)
end

function ManualModel:GetDataFormServer()
    ManualNet:GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end
function ManualModel:UpdataOnUIShow(name)
    if name == _G.ConfigManager.ui_cfg.ManualView.Name then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ManualView.Name)
        if view then
            view:UpdatePanel()
        end
    end
end
---@param msg handbook.s2c_handbook_info
function ManualModel:GetInfoCall(msg)
    self.msg = msg
    self:ParseData()
    if not self.isOpen then
        self.isOpen = true
    end
    if self.ManualDatas then
        self:InitFunction()
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ManualPage.id)
end

function ManualModel:InitFunction()
    if not self.msg then
        return
    end

    local msg = self.msg
    self:IniSidList(msg.g_sids)
    self:InitFinishTask(msg.finish)
    self:InitTask(msg.task)
    self:InitManualDatas()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ManualPage.id)
    self.msg = nil
    if not self.isadd then
        self.isadd = true
        _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.GetDataFormServer, self)
    end
end

---初始化已完成领取列表
function ManualModel:IniSidList(sids)
    if sids then
        for _, v in pairs(sids) do
            if not self.sidList[v] then
                self.sidList[v] = true
            end
        end
    end
end
---初始化任务
---@param taks task.i_task[]
function ManualModel:InitTask(task)
    if task then
        for _, v in pairs(task) do
            if not self.taskList[v.sid] then
                if _G.ConfigManager.mission_extra_cfg[v.sid] then
                    self.taskList[v.sid] = v
                end
            end
        end
    end
end
---初始化
function ManualModel:InitFinishTask(finish)
    if finish then
        for _, v in pairs(finish) do
            if not self.finishTaskList[v] then
                self.finishTaskList[v] = true
                if _G.ConfigManager.mission_extra_cfg[v] then
                    self.taskList[v] =
                        require "ManualTaskData".New(
                        {sid = v, target = {999}, state = _G.TaskEnum.ETaskState.Completed}
                    )
                end
            end
        end
    end
end
---初始化数据
function ManualModel:InitManualDatas()
    if not self.ManualDatas then
        self.ManualDatas = {}
        for _, v in pairs(_G.ConfigManager.handbook_cfg) do
            self.ManualDatas[v.id] = require "ManualData".New()
            self.ManualDatas[v.id]:Parse(v.id)
        end
    else
        for _, v in pairs(_G.ConfigManager.handbook_cfg) do
            self.ManualDatas[v.id]:ChangeLock()
        end
    end
end
