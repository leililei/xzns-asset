---进入公会战
---@return number 1为独立开启时间未达成,2function配置未达成
function SociatyBattleManager:Enter(sceneRoot)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(SociatyBattleModel.curFunctionOpenID) then
        _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(SociatyBattleModel.curFunctionOpenID)
        return 2
    end
    local state = self:GetState()
    if state == StateType.None then
        return 1
    end
    if state == StateType.Battle then
        SociatyBattleModel:GetAllBattleData(
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleMainView.Name, sceneRoot)
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleMainView.Name, sceneRoot)
    end

    if state == StateType.Battle or state == StateType.Apply then
        SociatyBattleModel:RefreshEnterRedPoint()
    end
end

