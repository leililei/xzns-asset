function SociatyBattleManager.GetHpImage(hp)
    if hp > 0.99 then
        return "ui_zd_xt_ls"
    elseif hp > 0.5 then
        return "ui_zd_xt_ls"
    elseif hp > 0.25 then
        return "ui_zd_xt_cs"
    else
        return "ui_zd_xt_hs"
    end
end

---检测驻地是否被攻破
---@param type SociatyBattleCampsiteType 按类型筛选，如果传空就是所有驻地
---@param isSelf boolean 是否为自己
function SociatyBattleManager:CheckCampsiteZero(type, isSelf)
    if nil == isSelf then
        isSelf = false
    end
    local sociatyBattleData
    if isSelf then
        sociatyBattleData = SociatyBattleModel:GetSelfScoaityData()
    else
        sociatyBattleData = SociatyBattleModel:GetEnemySociatyData()
    end
    local embattleCampsiteDatas = sociatyBattleData:GetCampsiteDic()
    local isAllZero = true
    if embattleCampsiteDatas then
        for _, v in pairs(embattleCampsiteDatas) do
            if nil == type then
                if v:GetHp() > 0 then
                    isAllZero = false
                    break
                end
            elseif v:GetType() == type then
                if v:GetHp() > 0 then
                    isAllZero = false
                    break
                end
            end
        end
    else
        isAllZero = false
    end
    return isAllZero
end

---判断当天的基偶情况
---2016年1月1日 00:00:00   时间戳  1451577600(规则设计如此)东8区
---2016年1月1日 00:00:00   时间戳  1451606400(规则设计如此)0时区
function SociatyBattleManager:CheckBasePair(time)
    local totalDay = math.floor((time - _G.TimeUtil.GetOneTimeByUTC(1451606400)) / 86400) + 1
    return totalDay
end

---获取当天的基偶用于判断 基数是战斗，偶数为非战（结算匹配）
function SociatyBattleManager:GetBasePair()
    local totalDay = self:CheckBasePair(_G.TimeUtil.GetServerUnixTime())
    _G.Log("<color=red><size=20>" .. "当天的基偶情况" .. totalDay .. "</size></color>")
    local jo = totalDay % 2
    _G.Log("<color=red><size=20>" .. "当天的基偶情况" .. jo .. "</size></color>")
    if jo == 1 then
        return 1
    else
        return 2
    end
end

---开始时间基偶转换开启时间，基数天不变，偶数天提前一天
function SociatyBattleManager:GetSociatyBattleOpenTime()
    local ot = _G.ConfigManager.discrete_cfg[101654][1][1]
    local time = _G.PlayerModel:GetInstance().main_open_time + ot * 86400

    local totalDay = self:CheckBasePair(time) - 1
    _G.Log("<color=red><size=20>" .. "公会战开启时间基偶情况" .. totalDay .. "</size></color>")
    local jo = totalDay % 2
    _G.Log("<color=red><size=20>" .. "公会战开启时间基偶情况" .. jo .. "</size></color>")
    if jo == 1 then
        return _G.PlayerModel:GetInstance().main_open_time + (ot - 1) * 86400
    else
        return _G.PlayerModel:GetInstance().main_open_time + (ot - 2) * 86400
    end
end

---检测当前时间是否过了12点
function SociatyBattleManager:CheckTime12()
    local date = _G.TimeUtil.GetDateTime(_G.TimeUtil.GetServerUnixTime())
    return date.hour >= 12
end

return SociatyBattleManager
