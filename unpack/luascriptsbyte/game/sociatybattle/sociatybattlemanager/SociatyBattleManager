---获取战报内容
---@param data guild_fight.i_log
function SociatyBattleManager.GetLogContent(data)
    if _G.table.isEmptyOrNil(data) then
        return ""
    end
    ---@type guild_battle_report_cfg
    local cfg = _G.ConfigManager.guild_battle_report_cfg[data.id]
    local tb = _G.DeepCopy(data.args)
    if cfg then
        for i = 1, #cfg.trigger do
            if cfg.trigger[i] == 3 then
                local tempCfg = _G.ConfigManager.guild_battle_campsite_cfg[_G.tonumber(data.args[i])]
                if tempCfg then
                    tb[i] = _G.LangUtil.GetLangPackValue(tempCfg.name)
                end
            elseif cfg.trigger[i] == 2 then
                local lpcid = tonumber(data.args[i])
                if lpcid == nil then
                    tb[i] = data.args[i]
                else
                    local value = _G.ConfigManager.language_package_cfg[lpcid]
                    if value then
                        tb[i] = _G.LangUtil.GetLangPackValue(lpcid)
                    else
                        tb[i] = data.args[i]
                    end
                end
            end
        end
    end

    if cfg then
        return _G.GetLangPackValue(cfg.language, _G.SafeUnpack(tb)), data.guild_uid ==
            require "SociatyManager":GetInstance():GetGuildUid() and
            "1796DD" or
            "ff5555"
    else
        return ""
    end
end

