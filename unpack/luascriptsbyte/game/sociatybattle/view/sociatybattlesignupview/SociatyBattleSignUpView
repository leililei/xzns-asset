function SociatyBattleSignUpView:StartApplyEndTimer()
    self.ApplyEndTime = require "SociatyBattleModel":GetInstance():GetNextSignUpTime()
    self.applyEndTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateApplyEndTime, self, false, false, true)
    self.applyEndTimer:Start()
end

function SociatyBattleSignUpView:UpdateApplyEndTime()
    local time = self.ApplyEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        time = 0
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90021800246, _G.TimeUtil.TransLateSMCH(time))
end

function SociatyBattleSignUpView:StartSignTimer()
    if self.signTimer then
        self.signTimer:Stop()
        self.signTimer = nil
    end
    self.SignBeginTime = 0
    if require "SociatyBattleModel":GetInstance().isFirst then
        self.go_table.obj_cehuashuozhege:SetActiveE(0)
        self.go_table.aortext_time:SetActiveE(0)
    else
        -- self.SignBeginTime = require "SociatyBattleModel":GetInstance():GetEndTime()
        -- self.signTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateSignTime, self, false, false, true)
        -- self.signTimer:Start()
        self:StartWeekTime()
        self:UpdateWeekTime()
    end
end

