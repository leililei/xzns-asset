function SociatyBattleSignUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyBattle.SociatyBattleApply, self.OnSignCall)
    self:AddListener(_G.eSociatyBattle.SociatyBattleAutoApply, self.RefreshAutoApply)
    self:AddListener(_G.eSociatyBattle.SociatyBattleState, self.ChangeState)
    self:AddListener(_G.eSociatyBattle.RefreshSociatyBattleCampsite, self.RefreshScoreAndCampSite)
    self:AddListener(_G.eSociatyBattle.SociatyBattleBattle, self.RefreshMatchInfoView)
    self:RefreshView()
end

function SociatyBattleSignUpView:OnCreate()
    self.state = require "SociatyBattleModel":GetInstance():GetState()
end

function SociatyBattleSignUpView:RefreshView()
    local resources = _G.ConfigManager.ui_cfg.SociatyBattleSignUpView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:RefreshAutoApply()
    local conditionLv, conditionMemberNumber = require "SociatyBattleModel":GetInstance():GetApplyCondition()
    self.go_table.aortext_autoApply.text = _G.GetLangPackValue(90021800248, conditionLv, conditionMemberNumber)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_xunhuan_effect, self.go_table.aorbtn_battle)
    self:RefreshStageView()
end

function SociatyBattleSignUpView:RefreshStageView()
    self:StopAllTimer()
    local SociatyBattleManager = require "SociatyBattleManager":GetInstance()
    local SociatyBattleModel = require "SociatyBattleModel":GetInstance()
    if SociatyBattleModel.realState == _G.SociatyBattleState.Settlement then
        self.go_table.obj_SignContent:SetActiveE(1)
        self.go_table.obj_MatchContent:SetActiveE(0)
        self.go_table.obj_GoldInfo:SetActiveE(1)
        self:SetApplyBtnGray(true)
        if SociatyBattleManager:IsSeasonFirstDay() then
            self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800254)
        else
            self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800256)
        end
        -- if SociatyBattleModel:GetWeek() == 1 then
        --     self:StartSignTimer()
        --     -- self:UpdateSignTime()
        -- else
        --     -- self:StartMatchTimer()
        --     -- self:UpdateMatchTime()
        -- end
        self:StartWeekTime()
        self:UpdateWeekTime()
    elseif SociatyBattleModel.realState == _G.SociatyBattleState.Match then
        self.go_table.obj_SignContent:SetActiveE(1)
        self.go_table.obj_MatchContent:SetActiveE(0)
        self.go_table.obj_GoldInfo:SetActiveE(1)
        self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800255)
        self:SetApplyBtnGray(true)
        -- self:StartMatchTimer()
        -- self:UpdateMatchTime()
        self:StartWeekTime()
        self:UpdateWeekTime()
    else
        self.curState = SociatyBattleManager:GetState()
        if self.curState == _G.SociatyBattleState.ApplyEnd then
            self:ShowApplyEnd()
        elseif self.curState == _G.SociatyBattleState.Settlement then
            self.go_table.obj_SignContent:SetActiveE(1)
            self.go_table.obj_MatchContent:SetActiveE(0)
            self.go_table.obj_GoldInfo:SetActiveE(1)
            self:SetApplyBtnGray(true)
            if SociatyBattleManager:IsSeasonFirstDay() then
                self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800254)
            else
                self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800256)
            end
            -- if SociatyBattleModel:GetWeek() == 1 then
            --     self:StartSignTimer()
            --     -- self:UpdateSignTime()
            -- else
            --     -- self:StartMatchTimer()
            --     -- self:UpdateMatchTime()
            -- end
            self:StartWeekTime()
            self:UpdateWeekTime()
        elseif self.curState == _G.SociatyBattleState.Apply then
            self.go_table.obj_SignContent:SetActiveE(1)
            self.go_table.obj_MatchContent:SetActiveE(0)
            self.go_table.obj_GoldInfo:SetActiveE(1)
            if SociatyBattleModel:GetIsApply() then
                self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800264)
                self:SetApplyBtnGray(true)
            else
                local member = require "SociatyModel":GetInstance().SociatySelf.GetMemberModule():GetSelfMember()
                if
                    member.Location == require "MemberEnum".ELocationEnum.Chairman or
                        member.Location == require "MemberEnum".ELocationEnum.CoChairman
                 then
                    self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800249)
                    self:SetApplyBtnGray(false)
                    self.go_table.aorimage_isOff:SetActiveE(1)
                    self.go_table.aortext_autoApply:SetActiveE(1)
                else
                    self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800270)
                    self:SetApplyBtnGray(true)
                    self.go_table.aorimage_isOff:SetActiveE(0)
                    self.go_table.aortext_autoApply:SetActiveE(0)
                end
            end
            -- self:StartMatchTimer()
            -- self:UpdateMatchTime()
            self:StartWeekTime()
            self:UpdateWeekTime()
        elseif self.curState == _G.SociatyBattleState.Match then
            self.go_table.obj_SignContent:SetActiveE(1)
            self.go_table.obj_MatchContent:SetActiveE(0)
            self.go_table.obj_GoldInfo:SetActiveE(1)
            self.go_table.aortext_signUp.text = _G.GetLangPackValue(90021800255)
            self:SetApplyBtnGray(true)
            -- self:StartMatchTimer()
            -- self:UpdateMatchTime()
            self:StartWeekTime()
            self:UpdateWeekTime()
        elseif self.curState == _G.SociatyBattleState.Battle then
            if require "SociatyBattleModel":GetInstance():GetSelfScoaityData() == nil then
                self:ShowApplyEnd()
            else
                self.go_table.obj_SignContent:SetActiveE(0)
                self.go_table.obj_MatchContent:SetActiveE(1)
                self.go_table.obj_GoldInfo:SetActiveE(0)
                self.go_table.aorbtn_battle:SetGray(false)
                self.go_table.aorrawimage_start:SetGray(false)
                self.go_table.aortext_stageDesc.text = _G.GetLangPackValue(90021800265, SociatyBattleModel:GetCurDay())
                self.go_table.aortext_stageTimeDesc.text = _G.GetLangPackValue(90021800250)
                self:RefreshMatchInfoView()
                self:StartSeasonTimer()
                self:UpdateSeasonTime()
                self:StartBattleTimer()
                self:UpdateBattleTime()
                self:SetJianProgress()
                self:ShowAward()
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleSignUpView_tubiao,
                    self.go_table.obj_imgjian,
                    function(obj)
                        if self:IsNil() then
                            _G.DestroyObject(obj)
                            return
                        end
                    end
                )
            end
        elseif self.curState == _G.SociatyBattleState.Rest then
            if require "SociatyBattleModel":GetInstance():GetSelfScoaityData() == nil then
                self:ShowApplyEnd()
            else
                self.go_table.obj_SignContent:SetActiveE(0)
                self.go_table.obj_MatchContent:SetActiveE(1)
                self.go_table.obj_GoldInfo:SetActiveE(0)
                self.go_table.aorbtn_battle:SetGray(true)
                self.go_table.aorrawimage_start:SetGray(true)
                self.go_table.aortext_stageDesc.text = _G.GetLangPackValue(90021800253)
                self.go_table.aortext_stageTimeDesc.text = _G.GetLangPackValue(90021800251)
                self:RefreshMatchInfoView()
                self:StartSeasonTimer()
                self:UpdateSeasonTime()
                self:StartBattleTimer()
                self:UpdateBattleTime()
                self:SetJianProgress()
                self:ShowAward()
            end
        end
    end
end

