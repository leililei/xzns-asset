function SociatyBattleSignUpView:StartWeekTime()
    if self.weekTimer then
        self.weekTimer:Stop()
        self.weekTimer = nil
    end

    local firstFlag = require "SociatyBattleModel":GetInstance().isFirst and 0 or 1
    self.go_table.obj_cehuashuozhege:SetActiveE(firstFlag)
    self.go_table.aortext_time:SetActiveE(firstFlag)

    self.weekFlag, self.lastTime = require "SociatyBattleModel":GetInstance():InitWeekTime()
    self.weekTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateWeekTime, self, false, false, true)
    self.weekTimer:Start()
end

function SociatyBattleSignUpView:UpdateWeekTime()
    local time = self.lastTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        time = 0
    end
    if self.weekFlag > 0 then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90021800333, _G.GetLangPackValue(weekStr[self.weekFlag]))
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90021800246, _G.TimeUtil.TransLateSMCH(time))
    end
end

