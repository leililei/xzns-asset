function SociatyBattleSignUpView:SetJianProgress()
    local SociatyBattleModel = require "SociatyBattleModel":GetInstance()
    local time = SociatyBattleModel:GetNextSettlementTime()
    local day = math.min(_G.TimeUtil.GetIntervalDay(_G.TimeUtil.GetServerUnixTime(), time) + 1, 3)
    local curDay = SociatyBattleModel:GetCurDay()
    if curDay ~= nil and curDay > 0 then
        self.go_table.aorimage_progress:SetLocalScale(progress[day][curDay], 1, 1)
    end

    for i = 1, 3 do
        self.go_table["aorimage_jian" .. i]:ClearChildren()
        -- if i <= day then  之前有个首次公会战特殊处理的判断 不要了
            self.go_table["aorimage_jian" .. i]:SetActiveE(1)
            -- self.go_table["aorimage_jian" .. i]:SetAnchorPosition(
            --     jianPos[day][i][1],
            --     jianPos[day][i][2],
            --     jianPos[day][i][3]
            -- )

            if i == curDay then
                self.go_table["aorimage_jian" .. curDay].Alpha = 0
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleSignUpView_jian,
                    self.go_table["aorimage_jian" .. curDay],
                    function(obj)
                        if self:IsNil() then
                            _G.DestroyObject(obj)
                        end
                        obj:SetAnchorPosition(0, -10, 0)
                    end
                )
            else
                self.go_table["aorimage_jian" .. i].Alpha = 1
            end
        -- else
        --     self.go_table["aorimage_jian" .. i]:SetActiveE(0)
        -- end
    end
end

function SociatyBattleSignUpView:ShowAward()
    local normalCfg = require "SociatyBattleModel":GetInstance():GetNormalCfg()
    local winRewards = {}
    for i = 1, #normalCfg.win_rewards do
        local award = {normalCfg.win_rewards[i][1], normalCfg.win_rewards[i][2]}
        table.insert(winRewards, award)
    end
    local node = self.go_table.trans_winContent
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #winRewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            winRewards[i],
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, winRewards[i][1])
            end
        )
    end

    local loseRewards = {}
    for i = 1, #normalCfg.lose_rewards do
        local award = {normalCfg.lose_rewards[i][1], normalCfg.lose_rewards[i][2]}
        table.insert(loseRewards, award)
    end
    node = self.go_table.trans_loseContent
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #loseRewards do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            loseRewards[i],
            node,
            function(item)
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, loseRewards[i][1])
            end
        )
    end
end

function SociatyBattleSignUpView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_help" then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 105)
    elseif name == "@_aorbtn_autoApply" then
        local SociatyBattleModel = require "SociatyBattleModel":GetInstance()
        if SociatyBattleModel.realState == _G.SociatyBattleState.Settlement then
            _G.PopWindowManager:GetInstance():ShowAllTips(250136)
            return
        elseif SociatyBattleModel.realState == _G.SociatyBattleState.Match then
            _G.PopWindowManager:GetInstance():ShowAllTips(250135)
            return
        end
        local member = require "SociatyModel":GetInstance().SociatySelf.GetMemberModule():GetSelfMember()
        if
            member.Location == require "MemberEnum".ELocationEnum.Chairman or
                member.Location == require "MemberEnum".ELocationEnum.CoChairman
         then
            require "SociatyBattleModel":GetInstance():SetAutoApply(_G.handler(self, self.RefreshAutoApply))
        end
    elseif name == "@_aorbtn_signUp" then
        self:OnSign()
    elseif name == "@_aorbtn_battle" then
        require "SociatyBattleModel":GetInstance():GetAllBattleData(
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleMainView.Name)
            end
        )
    elseif name == "@_aorbtn_rank" then
        require "SociatyBattleModel":GetInstance():GetRank(
            function(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleRankView.Name, msg)
            end
        )
    elseif name == "@_aorbtn_award" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattlePassView.Name)
    elseif name == "@_aorbtn_signaward" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattlePassView.Name)
    end
end

