    if self.signTimer then
        self.signTimer:Stop()
        self.signTimer = nil
    end
    if self.matchTimer then
        self.matchTimer:Stop()
        self.matchTimer = nil
    end
    if self.battleTimer then
        self.battleTimer:Stop()
        self.battleTimer = nil
    end
    if self.seasonTimer then
        self.seasonTimer:Stop()
        self.seasonTimer = nil
    end
    if self.weekTimer then
        self.weekTimer:Stop()
        self.weekTimer = nil
    end
end

function SociatyBattleSignUpView:ChangeState()
    if require "SociatyBattleModel":GetInstance():GetState() == _G.SociatyBattleState.Apply then
        self:RefreshStageView()
    else
        require "SociatyBattleManager":GetInstance():Enter()
        self:CloseView()
    end
end

function SociatyBattleSignUpView:EscClose()
    self:CloseView()
end

function SociatyBattleSignUpView:CloseView()
    self:Close()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
end

function SociatyBattleSignUpView:OnDestroy()
    self:StopAllTimer()
end

return SociatyBattleSignUpView
