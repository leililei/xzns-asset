---@class SociatyBattleStartView : UIBaseView	中文描述
---@field public go_table SociatyBattleStartView_GoTable GoTable
local SociatyBattleStartView = _G.BaseClass("SociatyBattleStartView", _G.UIBaseView)
--_G.SociatyBattleStartView = SociatyBattleStartView

function SociatyBattleStartView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleStartView:OnCreate(index, callback)
    self.index = index or 1
    if callback then
        self:OnBattleBegin(callback)
    end
end

function SociatyBattleStartView:OnDestroy()
    self.index = nil
end

function SociatyBattleStartView:OnBattleEnd()
    self.index = self.index + 1
end

function SociatyBattleStartView:PlayAni(call)
    self.go_table.obj_ani:SetActiveE(1)
    self.go_table.obj_ani:SetAnchorPosition(0, -150, 0)
    self.co1 =
        _G.DelayDo(
        0.1,
        function()
            -- self.go_table.obj_ani:DOLocalMoveY(0, 0.5)
            -- self.co2 =
            --     _G.DelayDo(
            --     1,
            --     function()
            --     end
            --     )
                self.go_table.obj_ani:DOLocalMoveY(
                    500,
                    0.5,
                    function()
                        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Eff, true)
                        self.co3 =
                            _G.DelayDo(
                            1.5,
                            function()
                                if call then
                                    call()
                                end
                            end
                        )
                    end
                )
        end
    )
end

function SociatyBattleStartView:OnBattleBegin(callback)
    if self.delay then
        _G.coroutine.stopwaiting(self.delay)
        self.delay = nil
    end
    if self:IsNil() then
        return
    end
    self.go_table.aortext_num.text = _G.GetLangPackValue(90031700039, _G.GameUtil.NumberToChinese(self.index))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_start, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Eff, false)
    self:PlayAni(
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_start, false)
            if callback then
                callback()
            end
        end
    )
end

function SociatyBattleStartView:OnStartClose()
    if self.co1 then
        _G.coroutine.stopwaiting(self.co1)
    end
    if self.co2 then
        _G.coroutine.stopwaiting(self.co2)
    end
    if self.co3 then
        _G.coroutine.stopwaiting(self.co3)
    end
end

function SociatyBattleStartView:OnClickBtn()
    -- body
end

return SociatyBattleStartView
