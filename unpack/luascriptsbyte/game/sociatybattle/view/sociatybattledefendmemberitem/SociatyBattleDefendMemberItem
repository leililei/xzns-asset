---@class SociatyBattleDefendMemberItem : Component	中文描述
---@field go_table SociatyBattleDefendView._obj_member_GoTable
---@field data SociatyBattleCampsiteData 驻地数据
local SociatyBattleDefendMemberItem = _G.BaseClass("SociatyBattleDefendMemberItem", _G.Component)

function SociatyBattleDefendMemberItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SociatyBattleDefendMemberItem:OnCreate(onclick, begin, drag, over)
    self.clickCall = onclick
    self.dragBegin = begin
    self.drag = drag
    self.dragEnd = over
    -- _G.SetEventTrigger(self.go_table.aorbtn_click, "onDragBegin", _G.handler(self, self.OnDragBegin))
    -- _G.SetEventTrigger(self.go_table.aorbtn_click, "onDrag", _G.handler(self, self.OnDrag))
    -- _G.SetEventTrigger(self.go_table.aorbtn_click, "onDragEnd", _G.handler(self, self.OnDragEnd))
    -- _G.SetEventTrigger(self.go_table.aorbtn_click, "onUp", _G.handler(self, self.OnUp))
    -- _G.SetEventTrigger(self.go_table.aorbtn_click, "onDeSelect", _G.handler(self, self.OnDeSelect))
end

---显示界面
---@param data guild_fight.i_role_battlefield
function SociatyBattleDefendMemberItem:Show(data, isCampsited)
    self.data = data
    self.isCampsited = isCampsited
    _G.UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase,
        {frame = self.data.frame, style = self.data.style, uid = self.data.role_uid},
        nil,
        true,
        false,
        false,
        function()
            -- body
        end
    )
    self.go_table.aortext_name.text = self.data.role_name
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.data.role_power)
    self.go_table.obj_mask:SetActiveE(self.isCampsited and 1 or 0)
end

---开始拖拽
function SociatyBattleDefendMemberItem:OnDragBegin(go, ed)
    self.dragTag = true
    if self.dragBegin then
        self.dragBegin(self, ed)
    end
end

---拖拽中
function SociatyBattleDefendMemberItem:OnDrag(go, ed)
    if not self.dragTag then
        return
    end
    if self.drag then
        self.drag(ed)
    end
end

---拖拽结束
function SociatyBattleDefendMemberItem:OnDragEnd(go, ed)
    if self.dragTag then
        self.dragTag = false
        if self.dragEnd then
            self.dragEnd(self, ed)
        end
    end
end

---手指抬起
function SociatyBattleDefendMemberItem:OnUp(go, ed)
    if self.dragTag then
        self.dragTag = false
        if self.dragEnd then
            self.dragEnd(self)
        end
    end
end

---丢失手指选择
function SociatyBattleDefendMemberItem:OnDeSelect(go, ed)
    if self.dragTag then
        self.dragTag = false
        if self.dragEnd then
            self.dragEnd(self)
        end
    end
end

function SociatyBattleDefendMemberItem:OnClickBtn()
    if self.clickCall then
        self.clickCall(self.data)
    end
end

return SociatyBattleDefendMemberItem
