---界面的入口函数
function SociatyBattleMainView:OnCreate(sceneRoot)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyBattleCampsite, _G.GetAutoGoTable(self.go_table.obj_campsite))
    self.isSelf = false
    self.RankSS = true
    self.scoreAwardSS = true
    self.ScoreAwardIndex = 1
    self.ScoreAwardType = {3, 2, 1}
    if sceneRoot then
        self.sceneRoot = sceneRoot
        self:SetSceneRoot(false)
    end
    self:ShowView()
end

function SociatyBattleMainView:OnEnable()
    if self.curView and self.curView.Name ~= WindowName.Main then
        local curView = self.curView
        self.curView = _G.UIManager:GetInstance():GetWindow(WindowName.Main)
        self:ChangeView(WindowDic[curView.Name])
    end
end

---初始化数据
function SociatyBattleMainView:InitData()
    self.selfSociatyData = SociatyBattleModel:GetInstance():GetSelfScoaityData()
    self.enemySociatyData = SociatyBattleModel:GetInstance():GetEnemySociatyData()
    self.curCampsiteSociatyData = self.isSelf and self.selfSociatyData or self.enemySociatyData
    self.state = SociatyBattleModel:GetInstance():GetState()
end

---显示界面
function SociatyBattleMainView:ShowView()
    self:InitData()
    self.go_table.obj_scoreAward:SetActiveE(0)
    local params = _G.ConfigManager.discrete_cfg[101629][1]
    ---如果有匹配数据
    if SociatyBattleModel:GetInstance().enemySociatyBattleData and SociatyBattleModel:GetInstance().mySociatyBattleData then
        if self.state == StateType.Battle then
            self:ShowBattle()
        else
            self:ShowMacthed()
        end
        self:UpdateTimer()
        self.go_table.aorbtn_Award:SetActiveE(1)
        self.go_table.aorbtn_Rank:SetActiveE(1)
        self.go_table.aorbtn_Log:SetActiveE(1)
        self:ShowBtn()
    else
        ---如果满足匹配条件
        if require "SociatyModel":GetInstance().SociatySelf.SevenDayLive >= params[2] then
            if self.state == StateType.Battle then
                self:ShowNilDataState1()
                self:UpdateTimer1()
                self.go_table.aorbtn_Info:SetActiveE(0)
                self.go_table.aorbtn_Defense:SetActiveE(0)
                self.go_table.aorbtn_Award:SetActiveE(1)
                self.go_table.aorbtn_Rank:SetActiveE(1)
                self.go_table.aorbtn_Log:SetActiveE(0)
            else
                self:ShowOtherState()
                self:UpdateTimer()
                self.go_table.aorbtn_Award:SetActiveE(1)
                self.go_table.aorbtn_Rank:SetActiveE(1)
                self.go_table.aorbtn_Log:SetActiveE(1)
                self:ShowBtn()
            end
        else
            self:ShowNilDataState()
            self.go_table.aorbtn_Info:SetActiveE(0)
            self.go_table.aorbtn_Defense:SetActiveE(0)
            self.go_table.aorbtn_Award:SetActiveE(1)
            self.go_table.aorbtn_Rank:SetActiveE(1)
            self.go_table.aorbtn_Log:SetActiveE(0)
        end
    end

    self.go_table.aorbtn_buff:SetActiveE(0)
    self.go_table.slider_skill:SetActiveE(0)
    self.go_table.obj_option:SetActiveE(
        require "SociatyModel":GetInstance().SociatySelf:GetMemberModule():GetSelfMember().CfgItem.sign_up and 1 or 0
    )
    if not self.isInited then
        self.go_table.trans_content:SetAnchorPosition(0, self:GetMoveEnd(), 0)
    end
    self.isInited = true
    self.curView = _G.UIManager:GetInstance():GetWindow(WindowName.Main)
    self:SetSceneRoot(false)
end

