---更新单个据点
---@param go_table SociatyBattleMainView._obj_campsite_GoTable
---@param id number 据点id
function SociatyBattleMainView:UpdateSingleCampsite(id)
    local go_table = self.campsiteItemDic[id]
    if not go_table then
        return
    end
    local data = self.curCampsiteSociatyData:GetCampsiteData(id)
    if data:GetType() == _G.SociatyBattleCampsiteType.Main then
        local isAllZero =
            require("SociatyBattleManager"):GetInstance():CheckCampsiteZero(
            _G.SociatyBattleCampsiteType.Importance,
            self.isSelf
        )
        if isAllZero then
            go_table.aorimage_lock:SetActiveE(0)
        else
            go_table.aorimage_lock:SetActiveE(1)
        end
        go_table.aorimage_thename:SetActiveE(0)
        go_table.obj_thename:SetActiveE(1)
        if self.isSelf then
            go_table.obj_box:SetActiveE(0)
        else
            if _G.AppSetting.IsXzns then
                go_table.obj_box:SetLocalPosition(83, 115, 0)
            else
                go_table.obj_box:SetLocalPosition(28.5, 69, 0)
            end
            go_table.obj_box:SetActiveE(1)
        end
        go_table.aorimage_box.SpriteName = "ui_zb_cheng"
        local isGet = require "SociatyBattleModel":GetInstance():CheckBoxAward(id)
        --TODO 宝箱领取状态
        go_table.aorimage_boxget:SetActiveE(isGet and 1 or 0)
        if isGet then
            go_table.aortext_atplayername.text = _G.GetLangPackValue(90021800482)
        else
            go_table.aortext_atplayername.text =
                data.attack_role_name and _G.GetLangPackValue(90021800481) or _G.GetLangPackValue(90021800480)
        end
    elseif data:GetType() == _G.SociatyBattleCampsiteType.Importance then
        go_table.aorimage_lock:SetActiveE(0)
        go_table.aorimage_thename:SetActiveE(0)
        go_table.obj_thename:SetActiveE(1)
        if self.isSelf then
            go_table.obj_box:SetActiveE(0)
        else
