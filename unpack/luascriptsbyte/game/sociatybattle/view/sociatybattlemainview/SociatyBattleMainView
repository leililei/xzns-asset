        local content, color = require "SociatyBattleManager".GetLogContent(msg)
        self.chatGo_Table.aortext_pindao.text =
            _G.string.AddColor(_G.string.format("[%s]", _G.GetLangPackValue(9002060026)), color)
        self.chatGo_Table.aortext_info.text = _G.string.AddColor(content, color)
    end
end

