function SociatyBattleMainView:InitBattleEffect()
    if not self.isSelf then
        if self.blueEffect and self.blueEffect ~= true then
            self.blueEffect:SetActiveE(0)
        end
        if self.redEffect == nil then
            self.redEffect = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleMainView_red,
                self.go_table.obj_mapBg,
                function(obj)
                    if self:IsNil() then
                         return
                    end
                    self.redEffect = obj
                    self.redEffect:SetLocalPosition(0, 760, 0)
                    self.redEffect:AddComponentE(_G.typeof(_G.CS.BackScaleEffectSet))
                    self.redEffect:SetActiveE(self.isSelf and 0 or 1)
                 end
            )
        elseif self.redEffect ~= true then
            self.redEffect:SetActiveE(1)
        end
    else
        if self.redEffect and self.redEffect ~= true then
            self.redEffect:SetActiveE(0)
        end
        if self.blueEffect == nil then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_SociatyBattleMainView_blue,
                self.go_table.obj_mapBg,
                function(obj)
                    if self:IsNil() then
                        return
                    end
                    self.blueEffect = obj
                    self.blueEffect:SetLocalPosition(0, 760, 0)
                    self.blueEffect:AddComponentE(_G.typeof(_G.CS.BackScaleEffectSet))
                    self.blueEffect:SetActiveE(self.isSelf and 1 or 0)
                end
            )
        elseif self.blueEffect ~= true then
            self.blueEffect:SetActiveE(1)
        end
    end
end

