---更新计时器
function SociatyBattleMainView:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.nextime = SociatyBattleModel:GetInstance():GetEndTime()
    local now = _G.TimeUtil.GetServerUnixTime()
    local date = _G.TimeUtil.GetDateTime(now)
    if self.state == StateType.Battle then
        if date.hour < 12 then
            local t = _G.ConfigManager.discrete_cfg[101626]
            self.nextime = self.nextime - (t[1][3] - 12) * 3600
            self.go_table.aortext_attimeLabel.text = _G.GetLangPackValue(90032800125)
        else
            self.go_table.aortext_attimeLabel.text = _G.GetLangPackValue(90032800126)
        end
    else
        self.go_table.aortext_attimeLabel.text = _G.GetLangPackValue(90032800127)
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeShow, self, false, false, true)
    self.timer:Start()
    self:UpdateTimeShow()
end

---更新时间显示
function SociatyBattleMainView:UpdateTimeShow()
    local offset = self.nextime - _G.TimeUtil.GetServerUnixTime()
    if offset <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    end
    if self.state == StateType.Battle then
        local time = TimeToString(offset, 1)
        self.go_table.aortext_timerTop.text = time
        self.go_table.aortext_attime.text = time
    elseif self.state == StateType.Settlement then
        local time = TranslateSecond(offset)
        self.go_table.aortext_attime.text = ""
        if time.hour == 0 and time.min <= 0 then
            time.min = 1
        end
        self.go_table.aortext_timer.text =
        GetLangPackValue(LanguageIDs.Time,
                GetLangPackValue(90022100002, time.hour, time.min))
    else
        local time = TranslateSecond(offset)
        if time.hour == 0 and time.min <= 0 then
            time.min = 1
        end
        self.go_table.aortext_timer.text =
            GetLangPackValue(LanguageIDs.Time,
                    "<color=#96ce51>" .. GetLangPackValue(90022100002, time.hour, time.min) .. "</color>")
        local time = TimeToString(offset, 1)
        self.go_table.aortext_attime.text = time
    end
end

