function SociatyBattleMainView:CloseBuff()
    self.go_table.obj_buffList:SetActiveE(0)
    self.go_table.obj_clickBuffOther:SetActiveE(0)
end

function SociatyBattleMainView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer1 then
        self.timer1:Stop()
        self.timer1 = nil
    end
    if self.tweer then
        self.tweer:Kill()
        self.tweer = nil
    end
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ArenaPanelView.Name)
    self:SetSceneRoot(true)
    self:RemoveAllListener()
end

return SociatyBattleMainView
