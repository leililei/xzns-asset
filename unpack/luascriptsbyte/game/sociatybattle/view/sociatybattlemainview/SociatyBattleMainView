---更新据点
function SociatyBattleMainView:UpdateCampsite()
    if _G.AppSetting.IsXzns then--星座改为敌我方显示不同背景
        self.go_table.obj_BlueMap:SetActiveE(self.isSelf and 1 or 0)
        self.go_table.obj_RedMap:SetActiveE(self.isSelf and 0 or 1)
    end
    if not self.campsiteItemDic then
        self.campsiteItemDic = {}
        self.BoxCampsiteId = {}
        for _, v in pairs(_G.ConfigManager.guild_battle_campsite_cfg) do
            if not self.campsiteItemDic[v.id] then
                local obj = _G.InstantiateObject(self.go_table.obj_campsite, self.go_table.trans_map)
                self.campsiteItemDic[v.id] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCampsite, v.id))
            end
            if v.type >= 2 then
                table.insert(self.BoxCampsiteId, v)
            end
        end
        _G.SortList(
            self.BoxCampsiteId,
            function(d)
                return -d.type, -d.id
            end
        )
    end

    for k, _ in pairs(self.campsiteItemDic) do
        self:UpdateSingleCampsite(k)
    end
    --默认滑动至最上方
    local _, y = self.go_table.trans_content:GetRectTransformSize()
    self.go_table.trans_content:DOLocalMoveY(-y, 0)
end

