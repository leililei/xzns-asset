function SociatyBattleMainView:DisplayAllCampsite(isShow)
    if self.campsiteItemDic then
        for k, v in pairs(self.campsiteItemDic) do
            v.gameObject:SetActiveE(isShow and 1 or 0)
        end
    end
end

function SociatyBattleMainView:GetMoveEnd(isEnd)
    local x, y = self.go_table.trans_content:GetParent():GetRectTransformSize()
    local width = 1600 - y / 2
    local move = 0
    if not self.isSelf then
        local id = SociatyBattleModel:GetInstance().markid or 0
        if id > 0 then
            local campsite = self.curCampsiteSociatyData:GetCampsiteData(id)
            if campsite and campsite:GetHp() > 0 then
                local pos = tonumber(campsite.cfg.coordinate[2])
                if pos + 1600 > width / 2 then
                    move = 1600 + pos - width / 2 - 100
                else
                    move = 0
                end
            end
        end
    end
    return -move
end

---切换窗口
function SociatyBattleMainView:ChangeView(name)
    if self.curView == nil then
        self.curView = _G.UIManager:GetInstance():GetWindow(WindowName.Main)
    end
    local curName = self.curView.Name
    if WindowName[name] == curName then
        return
    end
    self.sortingOrder = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    local windowName = WindowName[curName]
    local UIManager = _G.UIManager:GetInstance()
    if name == "Defense" then
        require "SociatyBattleManager":GetInstance():SetDefend()
    else
        windowName = WindowName[name]
        local canChange = name == "Rank" or name == "Info" or name == "Main"
        local view
        local changeFunction = function()
            if canChange then
                self.go_table.obj_BgEff:SetActiveE(name == "Main" and 1 or 0)
                self.go_table[ImgDic[windowName]].SpriteName = "ui_icon_c_" .. IconDic[windowName]
                self.go_table[ImgDic[curName]].SpriteName = "ui_icon_n_" .. IconDic[curName]
                if AppSetting.IsXzns and BtnbgDic[windowName]  then 
                    self.go_table[BtnbgDic[windowName]]:SetActiveE(1)
                    self.go_table[BtnbgDic[curName]]:SetActiveE(0)
                    self.go_table[BtntextDic[windowName]].color=_G.ColorTools.FormatColorByString("4F351E")
                    self.go_table[BtntextDic[curName]].color=_G.ColorTools.FormatColorByString("343A48")
                end 
                self.go_table[ToggleDic[windowName]]:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_gn_c_frame"
                self.go_table[ToggleDic[curName]]:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_gn_frame"
                if curName ~= WindowName.Main and name ~= "Defense" and windowName ~= curName then
                    UIManager:HideWindow(curName)
                end
                self.curView = view
            end
        end
        if name == "Rank" then
            require "SociatyBattleModel":GetInstance():GetRank(
                function(msg)
                    view = UIManager:OpenWindow(windowName, msg)
                    changeFunction()
                end
            )
        else
            view = UIManager:OpenWindow(windowName)
            changeFunction()
        end
    end
end

function SociatyBattleMainView:SetSceneRoot(isShow)
    if self.sceneRoot then
        self.sceneRoot:SetActiveE(isShow and 1 or 0)
    end
end

function SociatyBattleMainView:OnUIOpened(name)
    local dic = WindowDic[name]
    if dic then
        if dic == "Defense" or dic == "Main" then
            return
        end
        if not self.sortingOrder then
            self.sortingOrder = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        end
        local isLower = dic == "Rank" or dic == "Info" or dic == "Main"
        local order = isLower and self.sortingOrder - 5 or self.sortingOrder + 565
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, order)
        --self.curView = _G.UIManager:GetInstance():GetWindow(name)
    end
end

---按钮点击事件在这里派发
function SociatyBattleMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
        for _, window in pairs(WindowName) do
            local view = _G.UIManager:GetInstance():GetWindow(window)
            if view then
                _G.UIManager:GetInstance():CloseWindow(window)
            end
        end
    elseif go == self.go_table.aorbtn_last then
        self:OnChange()
    elseif go == self.go_table.aorbtn_next then
        self:OnChange()
    elseif go == self.go_table.aorbtn_mark then
        self:OnMark()
    elseif go == self.go_table.aorbtn_bufang then
        SociatyBattleModel:GetInstance():GetEmbattleData(
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleDefendView.Name)
            end
        )
    elseif go == self.go_table.aorbtn_buff then
        self:OnBuff()
    elseif go == self.go_table.aorbtn_chatView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleChatView.Name)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 105)
    elseif go == self.go_table.aorbtn_Main then
        self:ChangeView("Main")
    elseif go == self.go_table.aorbtn_Defense then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        self:ChangeView("Defense")
    elseif go == self.go_table.aorbtn_Rank then
        self:ChangeView("Rank")
    elseif go == self.go_table.aorbtn_Log then
        self:ChangeView("Log")
    elseif go == self.go_table.aorbtn_Award then
        self:ChangeView("Award")
    elseif go == self.go_table.aorbtn_Info then
        self:ChangeView("Info")
        self.RankSS = not self.RankSS
        --if self.RankSS then
        --    self.go_table.obj_scorerank:SetAnchorPosition(-320, 159, 0)
        --else
        --    self.go_table.obj_scorerank:SetAnchorPosition(0, 159, 0)
        --end
        --TODO 判断宝箱状态做不同表现
        local isGet = require "SociatyBattleModel":GetInstance():CheckBoxAward(self.BoxCampsiteId[3].id)
        local campsite = self.curCampsiteSociatyData:GetCampsiteData(self.BoxCampsiteId[3].id)

        if not isGet and campsite:GetHp() <= 0 then
            local msg = {}
            msg.b_id = self.BoxCampsiteId[3].id
            require "SociatyBattleNet":GetInstance():GetBoxAward(
                msg,
                function(data)
                    if data.ack == 1 then
                        self.go_table.aorimage_boxget3:SetActiveE(1)
                        require "SociatyBattleModel":GetInstance().AwardBoxList[self.BoxCampsiteId[3].id] = true
                        _G.StorageManager:GetInstance():ReceiveAwardData(data)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                        self:UpdateSingleCampsite(self.BoxCampsiteId[3].id)
                        self:UpdateBoxInfo()
                    end
                end
            )
        else
            local id
            local len = #self.BoxCampsiteId[3].preview
            for i = 1, len do
                local info = self.BoxCampsiteId[3].preview[i]
                if self.selfSociatyData.allScore >= info[1] and self.selfSociatyData.allScore <= info[2] then
                    id = info[3]
                    break
                end
            end
            if id then
                --require "CommonTipManager":GetInstance():OpenTip(self.go_table.aorbtn_box3.gameObject, id)
            end
        end
    elseif go == self.go_table.aorbtn_scoreAward then
        self.scoreAwardSS = not self.scoreAwardSS
        if self.scoreAwardSS then
            self.go_table.obj_scoreAward:SetAnchorPosition(0, 160, 0)
            self.go_table.aorbtn_scoreAward:SetLocalScale(1, 1, 1)
        else
            self.go_table.obj_scoreAward:SetAnchorPosition(-255, 160, 0)
            self.go_table.aorbtn_scoreAward:SetLocalScale(-1, 1, 1)
        end
    elseif go == self.go_table.aorbtn_type1 then
        self.ScoreAwardIndex = 1
        self:OnShowScoreAward()
    elseif go == self.go_table.aorbtn_type2 then
        self.ScoreAwardIndex = 2
        self:OnShowScoreAward()
    elseif go == self.go_table.aorbtn_type3 then
        self.ScoreAwardIndex = 3
        self:OnShowScoreAward()
    end
end

