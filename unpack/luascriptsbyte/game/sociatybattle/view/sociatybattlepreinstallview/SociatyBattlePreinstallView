local ItemCardAllView = require("ItemCardAllView")

local CombineData = require("CombineData")

---@class SociatyBattlePreinstallView : UIBaseView	公会站编队编辑
---@field public go_table SociatyBattlePreinstallView  go_table
---@field curEmbattleItem EmbattleItemSociatyFormat 布阵信息
---@field closeCall function 界面关闭回调
---@field TogType number 卡片1和合击技2页签类型
---@field ChooseTeamIndex number 选中队伍节点索引
---@field ChooseTeamGoTable UIGoTable 选中队伍节点对象
---@field ChooseTeamCard table 选中队伍卡片
---@field ChooseTeamSkill table 选中队伍技能
---@field CardType number 卡片五行类型
---@field SkillType number 合击技主动被动类型
local SociatyBattlePreinstallView = _G.BaseClass("SociatyBattlePreinstallView", _G.UIBaseView)

function SociatyBattlePreinstallView:OnCreate(item, call, index)
    self.curEmbattleItem = item
    self.closeCall = call

    self.TogType = 1

    self.ChooseTeamIndex = index or 1
    self.ChooseTeamGoTable = nil

    self.ChooseTeamCard = {}
    self.ChooseTeamSkill = {}

    local count = self.curEmbattleItem:GetEmbattleTypeCount()

    for i = 1, count do
        local cardData = self.curEmbattleItem:GetEmbattleData(i)
        local combSkill = self.curEmbattleItem:GetCombSkillData(i)

        local cd = {}
        for d = 1, #cardData do
            cd[d] = {}
            cd[d].level = cardData[d].level
            cd[d].power = cardData[d].power
            cd[d].sid = cardData[d].sid
            cd[d].soulLink_lv = cardData[d].soulLink_lv
            cd[d].star = cardData[d].star
            cd[d].tag = cardData[d].tag
            cd[d].uid = cardData[d].uid
        end

        local cs = {}
        for s = 1, #combSkill do
            cs[s] = {}
            cs[s].cskillID = combSkill[s].cskillID
            cs[s].id = combSkill[s].id
            cs[s].lv = combSkill[s].lv
            cs[s].tag = combSkill[s].tag
        end

        table.insert(self.ChooseTeamCard, cd)
        table.insert(self.ChooseTeamSkill, cs)
    end

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_table.scrollloopvectical_teamgroup:InitItemData(count, _G.handler(self, self.RefreshItem))
    self.go_table.scrollloopvectical_teamgroup:ScrollToIndex(self.ChooseTeamIndex - 1)

    self.CardType = 0
    self.CardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self.CardUidList = {}
    self.CardUidElementsList = {}
    for i, v in pairs(self.CardList) do
        table.insert(self.CardUidList, i)
        if nil == self.CardUidElementsList[v.cfg.Elements] then
            self.CardUidElementsList[v.cfg.Elements] = {}
        end
        table.insert(self.CardUidElementsList[v.cfg.Elements], i)
    end

    _G.SortList(
        self.CardUidList,
        function(uid)
            ---@type CardData
            local cardData = self.CardList[uid]
            local _, s = self:CheckCardInCurTeam(uid)
            return s, cardData:GetPower(), cardData.quality, cardData:GetStar(), cardData:GetLevel(), cardData.sid
        end
    )
    self.go_table.scrollloopvectical_cardgroup:InitItemData(#self.CardUidList, _G.handler(self, self.RefreshCardList))

    self.SkillType = 1
    self.CombineDatas = {}
    for _, v in pairs(_G.ConfigManager.combine_cfg) do
        if nil == self.CombineDatas[v.classify] then
            self.CombineDatas[v.classify] = {}
        end
        table.insert(self.CombineDatas[v.classify], v)
    end

    self.go_table.scrollloopvectical_skillgroup:InitItemData(
        #self.CombineDatas[self.SkillType],
        _G.handler(self, self.RefreshSkillList)
    )

    self.go_table.obj_cardpanel:SetActiveE(1)
    self.go_table.obj_skillpanel:SetActiveE(0)
end

---判断技能是否激活
function SociatyBattlePreinstallView:CheckSkillActive(id)
    local isActive = require "CombineModel":GetInstance():GetIsActive(id)
    return isActive
end

---初始化队伍
function SociatyBattlePreinstallView:RefreshItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, index)

    local cardData = self.ChooseTeamCard[index]
    local combSkill = self.ChooseTeamSkill[index]
    tb.aorimage_name.SpriteName = "ui_bz_btn_yusheduiwu" .. index

    if self.ChooseTeamIndex == index then
        if nil ~= self.ChooseTeamGoTable then
            self.ChooseTeamGoTable.obj_choose:SetActiveE(0)
        end
        self.ChooseTeamGoTable = tb
        tb.obj_choose:SetActiveE(1)
    else
        tb.obj_choose:SetActiveE(0)
    end

    local name = require "EmbattleController":GetInstance():GetGroupName(index)
    if name then
        tb.aortext_NO.text = name
    else
        tb.aortext_NO.text =
            _G.string.format(_G.TryGetLangValue(90024900011), _G.GameUtil.NumberToWordByLanguage(index))
    end

    for i = 1, 3 do
        local data = cardData[i]
        if data.uid > 0 then
            local cfg = _G.ConfigManager.att_equity_cfg[6]
            ---@type CardData
            local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
            --cardData:SetLevel(cfg.level)
            local skin

            if caradata and caradata.skin ~= 0 then
                skin = true
            else
                skin = false
            end
            local card = ItemCardAllView.New(tb["obj_card_node" .. i])
            card:Show(
                data.sid,
                nil,
                data.star,
                caradata.soulLink_lv,
                --data.level,
                cfg.level,
                data.uid,
                skin,
                caradata.soulLink_IsActivate,
                caradata.open_inborn
            )
            tb["obj_card_node" .. i]:SetActiveE(1)
        else
            tb["obj_card_node" .. i]:SetActiveE(0)
        end
        local skill = combSkill[i]
        if skill.id > 0 then
            local cfg = _G.ConfigManager.card_skills_cfg[combSkill[i].cskillID]
            tb["aorrawimage_icon" .. i]:LoadImage(cfg.icon)
            cfg = _G.ConfigManager.battle_skill_cfg[cfg.skills[1]]
            tb["aortext_type" .. i].text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            tb["obj_skill" .. i]:SetActiveE(1)
            tb["obj_typebg" .. i]:SetActiveE(1)
            tb["aortext_type" .. i]:SetActiveE(1)
        else
            tb["obj_skill" .. i]:SetActiveE(0)
            tb["obj_typebg" .. i]:SetActiveE(0)
            tb["aortext_type" .. i]:SetActiveE(0)
        end
    end
end

function SociatyBattlePreinstallView:ClickItemBtn(go, isOn, tb, index)
    local name = go:GetName()
    if nil ~= self.ChooseTeamGoTable then
        self.ChooseTeamGoTable.obj_choose:SetActiveE(0)
    end
    self.ChooseTeamGoTable = tb
    self.ChooseTeamIndex = index
    self.ChooseTeamGoTable.obj_choose:SetActiveE(1)

    if self.TogType == 1 then
        if self.CardType == 0 then
            _G.SortList(
                self.CardUidList,
                function(uid)
                    ---@type CardData
                    local cardData = self.CardList[uid]
                    local _, s = self:CheckCardInCurTeam(uid)
                    return s, cardData:GetPower(), cardData.quality, cardData:GetStar(), cardData:GetLevel(), cardData.sid
                end
            )
        else
            _G.SortList(
                self.CardUidElementsList[self.CardType],
                function(uid)
                    ---@type CardData
                    local cardData = self.CardList[uid]
                    local _, s = self:CheckCardInCurTeam(uid)
                    return s, cardData:GetPower(), cardData.quality, cardData:GetStar(), cardData:GetLevel(), cardData.sid
                end
            )
        end
        self.go_table.scrollloopvectical_cardgroup:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_skillgroup:UpdateAllItem()
    end

    if name == "@_aorbtn_card1" then
        self:ClickLeftAndChangeRightCard(1)
    elseif name == "@_aorbtn_card2" then
        self:ClickLeftAndChangeRightCard(2)
    elseif name == "@_aorbtn_card3" then
        self:ClickLeftAndChangeRightCard(3)
    elseif name == "@_aorbtn_skill1" then
        self:ClickLeftAndChangeRightSkill(1)
    elseif name == "@_aorbtn_skill2" then
        self:ClickLeftAndChangeRightSkill(2)
    elseif name == "@_aorbtn_skill3" then
        self:ClickLeftAndChangeRightSkill(3)
    end
end

---点击左侧并刷新右侧卡片
function SociatyBattlePreinstallView:ClickLeftAndChangeRightCard(index)
    if self.TogType ~= 1 then
        self.go_table.toggle_card.isOn = true
    end
    local chooseTeam = self.ChooseTeamCard[self.ChooseTeamIndex]

    if chooseTeam[index].uid > 0 then
        chooseTeam[index].level = 0
        chooseTeam[index].power = 0
        chooseTeam[index].sid = 0
        chooseTeam[index].soulLink_lv = 0
        chooseTeam[index].star = 0
        chooseTeam[index].tag = 0
        chooseTeam[index].uid = 0
        --self.go_table.scrollloopvectical_teamgroup:UpdateAllItem()
        self.go_table.scrollloopvectical_teamgroup:UpdateItemSingle(self.ChooseTeamIndex - 1)
        if self.CardType ~= 0 then
            self.CardType = 0
            _G.SortList(
                self.CardUidList,
                function(uid)
                    ---@type CardData
                    local cardData = self.CardList[uid]
                    local _, s = self:CheckCardInCurTeam(uid)
                    return s, cardData:GetPower(), cardData.quality, cardData:GetStar(), cardData:GetLevel(), cardData.sid
                end
            )
            self.go_table.scrollloopvectical_cardgroup:UpdateCount(#self.CardUidList)
            local x, y, z = self.go_table.aorbtn_all:GetLocalPosition()
            self.go_table.trans_choose:SetLocalPosition(x, y, z)
        else
            self.go_table.scrollloopvectical_cardgroup:UpdateAllItem()
        end
    end
end

---点击队伍列表更新数据和显示
function SociatyBattlePreinstallView:ClickLeftAndChangeRightSkill(index)
    if self.TogType ~= 2 then
        self.go_table.toggle_skill.isOn = true
    end
    local chooseTeam = self.ChooseTeamSkill[self.ChooseTeamIndex]
    if chooseTeam[index].id > 0 then
        local id = chooseTeam[index].id
        chooseTeam[index].cskillID = 0
        chooseTeam[index].id = 0
        chooseTeam[index].lv = 0
        chooseTeam[index].tag = 0
        --self.go_table.scrollloopvectical_teamgroup:UpdateAllItem()
        self.go_table.scrollloopvectical_teamgroup:UpdateItemSingle(self.ChooseTeamIndex - 1)
        local cfg = _G.ConfigManager.combine_cfg[id]
        if cfg.classify == 1 then
            if self.SkillType ~= 1 then
                self.go_table.toggle_skillType1.isOn = true
            else
                self.go_table.scrollloopvectical_skillgroup:UpdateAllItem()
            end
        elseif cfg.classify == 2 then
            if self.SkillType ~= 2 then
                self.go_table.toggle_skillType2.isOn = true
            else
                self.go_table.scrollloopvectical_skillgroup:UpdateAllItem()
            end
        elseif cfg.classify == 3 then
            if self.SkillType ~= 3 then
                self.go_table.toggle_skillType3.isOn = true
            else
                self.go_table.scrollloopvectical_skillgroup:UpdateAllItem()
            end
        end
    end
end

---判断卡片是否在队伍中
function SociatyBattlePreinstallView:CheckCardInCurTeam(uid)
    local chooseTeam = self.ChooseTeamCard[self.ChooseTeamIndex]
    for i = 1, #chooseTeam do
        if uid == chooseTeam[i].uid then
            return true, 1
        end
    end
    return false, 0
end

---判断技能是否在队伍中
function SociatyBattlePreinstallView:CheckSkillInCurTeam(id)
    local chooseTeam = self.ChooseTeamSkill[self.ChooseTeamIndex]
    for i = 1, #chooseTeam do
        if id == chooseTeam[i].id then
            return true, 1
        end
    end
    return false, 0
end

---刷新卡牌列表
function SociatyBattlePreinstallView:RefreshCardList(index, obj)
    index = index + 1
    local uid
    if self.CardType == 0 then
        uid = self.CardUidList[index]
    else
        uid = self.CardUidElementsList[self.CardType][index]
    end
    local cardData = self.CardList[uid]
    ---@type ArtifactWearView._obj_ListItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    tb["_onclick"] = _G.handlerbind(self, self.OnClickCard, tb, index, cardData)
    tb.lua = ItemCardAllView.New(tb.obj_card_node)
    tb.lua:ShowCardData(cardData)

    local cfg = _G.ConfigManager.att_equity_cfg[6]
    tb.lua:ShowLevel(cfg.level)
    tb.obj_card_node:SetLocalScaleXYZ(0.65, 0.65, 1)
    local select = 0
    if self:CheckCardInCurTeam(cardData.uid) ~= false then
        select = 1
    end
    tb.obj_select:SetActiveE(select)
end

---点击卡牌列表中的卡牌
---@param cardData CardData
function SociatyBattlePreinstallView:OnClickCard(go, isOn, tb, index, cardData)
    local iscancel = false
    local chooseTeam = self.ChooseTeamCard[self.ChooseTeamIndex]

    for i = 3, 1, -1 do
        if chooseTeam[i].uid > 0 then
            if chooseTeam[i].uid == cardData.uid then
                chooseTeam[i].level = 0
                chooseTeam[i].power = 0
                chooseTeam[i].sid = 0
                chooseTeam[i].soulLink_lv = 0
                chooseTeam[i].star = 0
                chooseTeam[i].tag = 0
                chooseTeam[i].uid = 0
                tb.obj_select:SetActiveE(0)
                iscancel = true
                break
            end
        end
    end
    if iscancel then
        --self.go_table.scrollloopvectical_teamgroup:UpdateAllItem()
        self.go_table.scrollloopvectical_teamgroup:UpdateItemSingle(self.ChooseTeamIndex - 1)
        return
    end

    for i = 1, 3 do
        if chooseTeam[i].sid == cardData.sid then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("不能上阵相同编队的卡牌")
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(220101)
            return
        end
    end

    if chooseTeam[1].uid > 0 and chooseTeam[2].uid > 0 and chooseTeam[3].uid > 0 then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("当前编队已存在3个卡片")
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(140111)
        return
    end

    tb.obj_select:SetActiveE(1)

    for i = 1, 3 do
        if chooseTeam[i].uid <= 0 then
            chooseTeam[i].level = cardData:GetLevel()
            chooseTeam[i].power = cardData:GetPower()
            chooseTeam[i].sid = cardData.sid
            chooseTeam[i].soulLink_lv = cardData.soulLink_lv
            chooseTeam[i].star = cardData.star
            chooseTeam[i].tag = 0
            chooseTeam[i].uid = cardData.uid
            break
        end
    end
    --self.go_table.scrollloopvectical_teamgroup:UpdateAllItem()
    self.go_table.scrollloopvectical_teamgroup:UpdateItemSingle(self.ChooseTeamIndex - 1)
end

function SociatyBattlePreinstallView:RefreshSkillList(index, obj)
    index = index + 1
    ---@type combine_cfg
    local combine = self.CombineDatas[self.SkillType][index]
    if nil == combine then
        return
    end
    ---@type card_skills_cfg
    local skillCfg = _G.ConfigManager.card_skills_cfg[combine.skills[1]]
    if nil == skillCfg then
        return
    end
    local tb = _G.GetAutoGoTable(obj)
    tb["_onclick"] = _G.handlerbind(self, self.OnClickSkill, tb, skillCfg, combine, index)
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(skillCfg.name1)
    tb.aorrawimage_icon:LoadImage("")
    tb.aorrawimage_icon:LoadImage(skillCfg.icon)

    local languageId = _G.ConfigManager.battle_skill_cfg[skillCfg.skills[1]].Brief
    tb.aortext_type.text = _G.ConfigManager.language_package_cfg[languageId]

    tb.aortext_type2.text = _G.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][combine.classify])

    local select = 0
    if self:CheckSkillInCurTeam(combine.id) ~= false then
        select = 1
    end
    tb.obj_shadow:SetActiveE(select)

    local isActive = 0
    if self:CheckSkillActive(combine.id) == false then
        isActive = 1
    end
    tb.obj_mask:SetActiveE(isActive)

    tb.aorbtn_skill.LongPress = true
    tb.aorbtn_skill.onLongPress = _G.handlerbind(self, self.OnLongPress_ShowSkillTips, tb)

    --_G.SetEventTrigger(tb.aorbtn_skill, "onClick", _G.handlerbind(self, self.OnClickSkill, tb, skillCfg, combine, index))

    local combineData = CombineData.New()
    combineData:ParseData(combine, self:CheckSkillActive(combine.id))
    tb.combineData = combineData
end

function SociatyBattlePreinstallView:OnLongPress_ShowSkillTips(tb)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CombineTipView.Name, tb.combineData)
end

function SociatyBattlePreinstallView:OnClickSkill(go, isOn, tb, skillCfg, combine, index)
    if _G.AppSetting.DEBUG then
        Log("点击技能" .. GetLangPackValue(skillCfg.name1))
    end

    local isActive = self:CheckSkillActive(combine.id)
    if not isActive then
        _G.PopWindowManager:GetInstance():ShowAllTips(1305)
        return
    end

    local iscancel = false
    local chooseTeam = self.ChooseTeamSkill[self.ChooseTeamIndex]

    local i = combine.classify

    if chooseTeam[i].id > 0 then
        if chooseTeam[i].id == combine.id then
            chooseTeam[i].cskillID = 0
            chooseTeam[i].id = 0
            chooseTeam[i].lv = 0
            chooseTeam[i].tag = 0
            tb.obj_shadow:SetActiveE(0)
            iscancel = true
        end
    end
    if iscancel then
        --self.go_table.scrollloopvectical_teamgroup:UpdateAllItem()
        self.go_table.scrollloopvectical_teamgroup:UpdateItemSingle(self.ChooseTeamIndex - 1)
        return
    end

    local isSameType = false

    if chooseTeam[i].id > 0 then
        local cfg = _G.ConfigManager.combine_cfg[chooseTeam[i].id]
        if cfg.classify == combine.classify then
            isSameType = true
        end
    end

    if isSameType then
        if _G.AppSetting.DEBUG then
            LogWarning("已存在相同类型合击技")
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(250141)
        return
    end

    if chooseTeam[1].id > 0 and chooseTeam[2].id > 0 and chooseTeam[3].id > 0 then
        if _G.AppSetting.DEBUG then
            LogWarning("当前编队已存在3个合击技")
        end
        --_G.PopWindowManager:GetInstance():ShowAllTips(140111)
        return
    end

    tb.obj_shadow:SetActiveE(1)

    if chooseTeam[i].id <= 0 then
        chooseTeam[i].cskillID = combine.skills[1]
        chooseTeam[i].id = combine.id
        chooseTeam[i].lv = 1
        chooseTeam[i].tag = 0
    end
    --self.go_table.scrollloopvectical_teamgroup:UpdateAllItem()
    self.go_table.scrollloopvectical_teamgroup:UpdateItemSingle(self.ChooseTeamIndex - 1)
end

function SociatyBattlePreinstallView:Dispose()
end

function SociatyBattlePreinstallView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if _G.AppSetting.DEBUG then
        Log("点击按钮" .. name)
    end
    if name == "@_aorbtn_close" then
        local count = self.curEmbattleItem:GetEmbattleTypeCount()

        for i = 1, count do
            self.curEmbattleItem:InitEmbattleData(self.ChooseTeamCard[i], i)
            self.curEmbattleItem:SetCombSkillData(self.ChooseTeamSkill[i], i)
        end

        self.curEmbattleItem:SaveEmbattle(
            function()
                if _G.AppSetting.DEBUG then
                    Log("保存完成")
                end
                if self.closeCall then
                    self.closeCall()
                end
            end
        )

        self:Close()
    elseif name == "@_toggle_card" then
        --self.go_table.scrollloopvectical_cardgroup:UpdateAllItem()
        ---卡片
        self.go_table.obj_cardpanel:SetActiveE(1)
        self.go_table.obj_skillpanel:SetActiveE(0)
        self.TogType = 1
    elseif name == "@_toggle_skill" then
        --self.go_table.scrollloopvectical_skillgroup:UpdateAllItem()
        ---合击技
        self.go_table.obj_cardpanel:SetActiveE(0)
        self.go_table.obj_skillpanel:SetActiveE(1)
        self.TogType = 2
    elseif name == "@_aorbtn_all" then
        ---全部
        self.CardType = 0
        _G.SortList(
            self.CardUidList,
            function(uid)
                ---@type CardData
                local cardData = self.CardList[uid]
                local _, s = self:CheckCardInCurTeam(uid)
                return s, cardData:GetPower(), cardData.quality, cardData:GetStar(), cardData:GetLevel(), cardData.sid
            end
        )
        self.go_table.scrollloopvectical_cardgroup:UpdateCount(#self.CardUidList)
        local x, y, z = self.go_table.aorbtn_all:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_aorbtn_lei" then
        ---雷
        self.CardType = 1
        self:UpdateElementsGroup()
        local x, y, z = self.go_table.aorbtn_lei:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_aorbtn_feng" then
        ---风
        self.CardType = 2
        self:UpdateElementsGroup()
        local x, y, z = self.go_table.aorbtn_feng:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_aorbtn_shui" then
        ---水
        self.CardType = 3
        self:UpdateElementsGroup()
        local x, y, z = self.go_table.aorbtn_shui:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_aorbtn_huo" then
        ---火
        self.CardType = 4
        self:UpdateElementsGroup()
        local x, y, z = self.go_table.aorbtn_huo:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_aorbtn_tu" then
        ---土
        self.CardType = 5
        self:UpdateElementsGroup()
        local x, y, z = self.go_table.aorbtn_tu:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_aorbtn_shen" then
        ---神
        self.CardType = 6
        self:UpdateElementsGroup()
        local x, y, z = self.go_table.aorbtn_shen:GetLocalPosition()
        self.go_table.trans_choose:SetLocalPosition(x, y, z)
    elseif name == "@_toggle_skillType1" then
        ---合击技主动
        self.SkillType = 1
        if self.CombineDatas[self.SkillType] then
            self.go_table.scrollloopvectical_skillgroup:UpdateCount(#self.CombineDatas[self.SkillType])
        else
            self.go_table.scrollloopvectical_skillgroup:UpdateCount(0)
        end
    elseif name == "@_toggle_skillType2" then
        ---合击技被动
        self.SkillType = 2
        if self.CombineDatas[self.SkillType] then
            self.go_table.scrollloopvectical_skillgroup:UpdateCount(#self.CombineDatas[self.SkillType])
        else
            self.go_table.scrollloopvectical_skillgroup:UpdateCount(0)
        end
    elseif name == "@_toggle_skillType3" then
        ---合击技镇魂
        self.SkillType = 3
        if self.CombineDatas[self.SkillType] then
            self.go_table.scrollloopvectical_skillgroup:UpdateCount(#self.CombineDatas[self.SkillType])
        else
            self.go_table.scrollloopvectical_skillgroup:UpdateCount(0)
        end
    end
end

function SociatyBattlePreinstallView:UpdateElementsGroup()
    _G.SortList(
        self.CardUidElementsList[self.CardType],
        function(uid)
            ---@type CardData
            local cardData = self.CardList[uid]
            local _, s = self:CheckCardInCurTeam(uid)
            return s, cardData:GetPower(), cardData.quality, cardData:GetStar(), cardData:GetLevel(), cardData.sid
        end
    )
    self.go_table.scrollloopvectical_cardgroup:UpdateCount(#self.CardUidElementsList[self.CardType])
end

return SociatyBattlePreinstallView
