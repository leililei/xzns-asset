local SociatyBattleModel = require "SociatyBattleModel"
---@class SociatyBattlePassView_GXPanel_GXPanel : Component	中文描述
---@field go_table SociatyBattlePassView._obj_gx_GoTable
local SociatyBattlePassView_GXPanel = _G.BaseClass("SociatyBattlePassView_GXPanel", _G.Component)

--_G.SociatyBattlePassView_GXPanel = SociatyBattlePassView_GXPanel
local GxLanguageID = 90021800305
local NeedxLanguageID = 90021800307
local GetLangPackValue = _G.GetLangPackValue
function SociatyBattlePassView_GXPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattlePassView_GXPanel:OnCreate()
    self.cfg = SociatyBattleModel:GetInstance().seasonCfg
    self.awardList = {}
    self.score = SociatyBattleModel:GetInstance():GetSorce()
    local cfgs = _G.ConfigManager.guild_battle_reward_cfg
    local cfg
    local offset

    for _, v in ipairs(self.cfg.reward_season) do
        cfg = cfgs[v]
        if cfg.conditions[1] > self.score then
            if not offset or (offset and offset > cfg.conditions[1]) then
                offset = cfg.conditions[1]
                self.nextId = v
            end
        end
        _G.table.insert(self.awardList, cfg)
    end
    _G.table.sort(
        self.awardList,
        function(a, b)
            return a.level < b.level
        end
    )
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self:ShowView()
end

function SociatyBattlePassView_GXPanel:ShowView()
    self:UpdateNextGet()

    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.awardList)
    --self.go_table.slider_progress.value = self.score / self.awardList[#self.awardList].conditions[1]
    self.go_table.aortext_num.text = self.score

    _G.DelayFrameDo(
        function()
            self.go_table.scrollloopvectical_itemList:ScrollToIndex(self.AwardIndex - 1)
        end
    )
end

function SociatyBattlePassView_GXPanel:UpdateNextGet()
    self.curGet = self.nextId
    self.AwardIndex = 1
    for k, v in ipairs(self.awardList) do
        if self.score >= v.conditions[1] and not SociatyBattleModel:GetInstance():CheckGetAward(v.id) then
            self.curGet = v.id
            self.AwardIndex = k
            break
        end
    end
end
---刷新物体显示
function SociatyBattlePassView_GXPanel:RefreshItem(index, obj)
    local data = self.awardList[index + 1]
    ---@type SociatyBattlePassView_GXPanel._obj_item_GoTable
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickAward, index))
    item.aortext_num.text = GetLangPackValue(GxLanguageID) .. _G.UIUtils.NumberToUnitStrBag(data.conditions[1])
    item.aorbtn_unGet:SetGray(true)
    if SociatyBattleModel:GetInstance():CheckGetAward(data.id) then
        item.aorimage_geted:SetActiveE(1)
        item.aorbtn_get:SetActiveE(0)
        item.obj_unGet:SetActiveE(0)
    elseif self.score >= data.conditions[1] then
        item.aorimage_geted:SetActiveE(0)
        item.aorbtn_get:SetActiveE(1)
        item.obj_unGet:SetActiveE(0)
    elseif self.nextId == data.id then
        item.aorimage_geted:SetActiveE(0)
        item.aorbtn_get:SetActiveE(0)
        item.obj_unGet:SetActiveE(1)
        item.aortext_need.text =
            GetLangPackValue(NeedxLanguageID) .. _G.UIUtils.NumberToUnitStrBag(data.conditions[1] - self.score)
    else
        item.aorimage_geted:SetActiveE(0)
        item.aorbtn_get:SetActiveE(0)
        item.obj_unGet:SetActiveE(0)
    end
    item.aorimage_choose:SetActiveE(self.curGet == data.id and 1 or 0)
    item.trans_content:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data.rewards_normal[1],
        item.trans_content,
        function(obj)
            if self.go_table == nil then
                _G.DestroyObject(obj.go_table.gameObject)
                return
            end
            if obj.ShowNumText then
                obj:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    )
end

function SociatyBattlePassView_GXPanel:OnClickAward(_, _, index)
    local data = self.awardList[index + 1]
    if SociatyBattleModel:GetInstance():CheckGetAward(data.id) or self.score < data.conditions[1] then
        return
    end
    SociatyBattleModel:GetInstance():GetAward(
        data.id,
        function()
            if data.id == self.curGet then
                self:UpdateNextGet()
            end
            self.go_table.scrollloopvectical_itemList:UpdateAllItem()
        end
    )
end

---按钮点击事件在这里派发
function SociatyBattlePassView_GXPanel:OnClickBtn(go)
end

return SociatyBattlePassView_GXPanel
