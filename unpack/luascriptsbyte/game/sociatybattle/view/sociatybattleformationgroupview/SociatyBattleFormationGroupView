local EmbattleController = require "EmbattleController"
local EmbattleModel = require "EmbattleModel"
local numSpriteName = "ui_bz_btn_yusheduiwu%d"
--region单个编组
local SociatyBattleFormationItem = _G.BaseClass("SociatyBattleFormationItem")
local skillDicIndex = {obj = 1, icon = 2, _type = 3, lock = 4}

function SociatyBattleFormationItem:__init(obj, onChoose, unlock, callback)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.onChooseCall = onChoose
    self.unLock = unlock
    self.ChangeCallBack = callback

    self.curEquityCfg = _G.ConfigManager.att_equity_cfg[6]
    self.cardDic = {
        self.go_table.trans_card1,
        self.go_table.trans_card2,
        self.go_table.trans_card3
    }
    self.effectDic = {
        self.go_table.obj_EffectAdd1,
        self.go_table.obj_EffectAdd2,
        self.go_table.obj_EffectAdd3
    }
    for _, ef in pairs(self.effectDic) do
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_daitianjia,
            ef,
            function(trans)
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        )
    end
    self.skillDic = {
        {
            self.go_table.obj_skill1,
            self.go_table.aorrawimage_icon1,
            self.go_table.aortext_type1,
            self.go_table.obj_lock1
        },
        {
            self.go_table.obj_skill2,
            self.go_table.aorrawimage_icon2,
            self.go_table.aortext_type2,
            self.go_table.obj_lock2
        },
        {
            self.go_table.obj_skill3,
            self.go_table.aorrawimage_icon3,
            self.go_table.aortext_type3,
            self.go_table.obj_lock3
        }
    }
    self.cardItems = {false, false, false, false, false}
end
function SociatyBattleFormationItem:Dispose()
    self.go_table = nil
    self.onChooseCall = nil
    self.index = nil
    self.skillDic = nil
    self.cardDic = nil
end
function SociatyBattleFormationItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_edit then
        --使用编队
        if not self.grayTag then
            self:UseEmbattle()
        end
    elseif go == self.go_table.aorbtn_skill1 then
        self:OnSkillBtnClick(1)
    elseif go == self.go_table.aorbtn_skill2 then
        self:OnSkillBtnClick(2)
    elseif go == self.go_table.aorbtn_skill3 then
        self:OnSkillBtnClick(3)
    elseif go == self.go_table.aorbtn_name then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.EmbattleGroupNameView.Name,
            _G.handler(self, self.OnChangeNameCall),
            self.go_table.aortext_NO.text,
            self.index
        )
    else
        self:EditEmbattle()
    end
end
function SociatyBattleFormationItem:OnSkillBtnClick(index)
    if self.unLock[index] > 0 then
        local afkCfg = _G.ConfigManager.afk_cfg[self.unLock[index]]
        _G.PopWindowManager:GetInstance():ShowAllTips(140116, nil, nil, nil, nil, nil, afkCfg.chapter, afkCfg.section)
        return
    end
    self:EditEmbattle()
end
function SociatyBattleFormationItem:OnChangeNameCall(name)
    self.go_table.aortext_NO.text = name
    EmbattleController:GetInstance():SetGroupName(self.index, name)
end
---展示布阵
---@param index number 序列号
---@param item EmbattleItemGroup 布阵对象
function SociatyBattleFormationItem:Show(item, index)
    self.index = index
    self.curEmbattleItem = item
    self.grayTag = self.curEmbattleItem:CheckContains(index)
    self.go_table.aorbtn_edit:SetGray(self.grayTag)
    self.combSkill = item:GetCombSkillData(self.index)
    self.onSkillCloseHandler = _G.handler(self, self.OnCombCloseCall)
    self.onCardCallHandler = _G.handler(self, self.OnCardCall)
    self.go_table.aorimage_name.SpriteName = _G.string.format(numSpriteName, index)
    self.go_table.aorimage_name:SetNativeSize()
    local name = EmbattleController:GetInstance():GetGroupName(index)
    if name then
        self.go_table.aortext_NO.text = name
    else
        self.go_table.aortext_NO.text =
            _G.string.format(_G.TryGetLangValue(90024900011), _G.GameUtil.NumberToWordByLanguage(index))
    end
    self:ShowSkill()
    self:ShowCard()
end
---展示技能
function SociatyBattleFormationItem:ShowSkill()
    local cfg, lv, id
    for i = 1, #self.combSkill do
        if self.unLock[i] == 0 then
            self.skillDic[i][skillDicIndex.lock]:SetActiveE(0)
            id = self.combSkill[i].id
            if id > 0 then
                self.skillDic[i][skillDicIndex.obj]:SetActiveE(1)
                cfg = _G.ConfigManager.card_skills_cfg[self.combSkill[i].cskillID]
                self.skillDic[i][skillDicIndex.icon]:LoadImage(cfg.icon)
                cfg = _G.ConfigManager.battle_skill_cfg[cfg.skills[1]]
                self.skillDic[i][skillDicIndex._type].text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            else
                self.skillDic[i][skillDicIndex.obj]:SetActiveE(0)
            end
        else
            self.skillDic[i][skillDicIndex.lock]:SetActiveE(1)
        end
    end
end
---展示卡牌
function SociatyBattleFormationItem:ShowCard()
    self.cardData = self.curEmbattleItem:GetEmbattleData(self.index)
    self.cardIndex = 1
    self:HandleCardOneByOne()
end
function SociatyBattleFormationItem:HandleCardOneByOne()
    if self.cardIndex > #self.cardData then
        self.cardData = nil
        self.cardIndex = nil
        return
    end
    if self.cardIndex > #self.effectDic then
        return
    end
    self.effectDic[self.cardIndex]:SetActiveE(1)
    local data = self.cardData[self.cardIndex]
    if data.uid > 0 then
        self.effectDic[self.cardIndex]:SetActiveE(0)
        local card = self.cardItems[self.cardIndex]
        if card then
            card.gameObject:SetActiveE(1)
            ---@type CardData
            local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
            --caradata:SetLevel(self.curEquityCfg.level)
            local skin

            if caradata and caradata.skin ~= 0 then
                skin = true
            else
                skin = false
            end
            card:Show(
                data.sid,
                nil,
                data.star,
                --data.level,
                self.curEquityCfg.level,
                nil,
                caradata.soulLink_lv,
                skin,
                caradata.soulLink_IsActivate,
                caradata.open_inborn
            )
            self.cardIndex = self.cardIndex + 1
            self:HandleCardOneByOne()
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.levelItem,
                self.cardDic[self.cardIndex],
                self.onCardCallHandler
            )
        end
    else
        if self.cardItems[self.cardIndex] then
            self.cardItems[self.cardIndex].gameObject:SetActiveE(0)
        end
        self.cardIndex = self.cardIndex + 1
        self:HandleCardOneByOne()
    end
end
function SociatyBattleFormationItem:OnCardCall(card)
    self.cardItems[self.cardIndex] = card
    card.transform:SetLocalPositionToZero()
    local data = self.cardData[self.cardIndex]
    local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
    --caradata:SetLevel(self.curEquityCfg.level)
    local skin

    if caradata and caradata.skin ~= 0 then
        skin = true
    else
        skin = false
    end
    self.cardItems[self.cardIndex]:Show(
        data.sid,
        nil,
        data.star,
        --data.level,
        self.curEquityCfg.level,
        nil,
        caradata.soulLink_lv,
        skin,
        caradata.soulLink_IsActivate,
        caradata.open_inborn
    )
    self.cardIndex = self.cardIndex + 1
    self:HandleCardOneByOne()
end
---使用编队
function SociatyBattleFormationItem:UseEmbattle()
    self.onChooseCall(self.index)
end
---打开合击技
function SociatyBattleFormationItem:OpenCombSkillView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name,
        self.combSkill,
        self.onSkillCloseHandler
    )
end
---当合击技界面关闭
---@param data table 合击技ID
function SociatyBattleFormationItem:OnCombCloseCall(data)
    self.combSkill = data
    self:ShowSkill()
end
---编辑编队
function SociatyBattleFormationItem:EditEmbattle()
    -- 预制体：SociatyBattlePreinstallView ui 配置里已经加上了这一条
    _G.UIManager:GetInstance():OpenWindow(
        "SociatyBattlePreinstallView",
        self.curEmbattleItem,
        function()
            local count = self.curEmbattleItem:GetEmbattleTypeCount()

            for i = 1, count do
                self.ChangeCallBack(i)
            end
        end,
        self.index
    )
end
--endregion

