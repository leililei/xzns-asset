---@class SociatyBattleFormationGroupView : UIBaseView    中文描述
---@field public go_table EmbattleFormationGroupView_GoTable GoTable
local SociatyBattleFormationGroupView = _G.BaseClass("SociatyBattleFormationGroupView", _G.UIBaseView)

function SociatyBattleFormationGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function SociatyBattleFormationGroupView:OnCreate(item, call)
    self.curEmbattleItem = item
    self.closeCall = call
    self.itemChooseHandler = _G.handler(self, self.OnGroupChoose)
    self.groupItems = {}
    self.skillUnLockTag = {false, false, false}
    for i = 1, #self.skillUnLockTag do
        if EmbattleModel:GetInstance():CheckSkillPosUnLock(i) then
            self.skillUnLockTag[i] = 0
        else
            self.skillUnLockTag[i] = EmbattleModel:GetInstance():GetSkillPosUnLockParam(i)
        end
    end
    local count = self.curEmbattleItem:GetEmbattleTypeCount()
    _G.DelayDo(
        0.25,
        function()
            self.go_table.scrollloopvectical_group:InitItemData(count, _G.handler(self, self.OnGroupItemCall))
        end
    )
end
function SociatyBattleFormationGroupView:OnDestroy()
    self.curEmbattleItem = nil
    self.closeCall = nil
    self.itemChooseHandler = nil
    self.groupItems = nil
end
---按钮点击事件在这里派发
function SociatyBattleFormationGroupView:OnClickBtn(go)
    self:Close()
end
function SociatyBattleFormationGroupView:OnGroupItemCall(index, obj)
    local insID = obj:GetInstanceID()
    local item = self.groupItems[insID]
    if not item then -- itemChooseHandler self.OnGroupChoose
        item =
            SociatyBattleFormationItem.New(
            obj,
            self.itemChooseHandler,
            self.skillUnLockTag,
            _G.handler(self, self.UpdateGroup)
        )
        self.groupItems[insID] = item
    end
    index = index + 1
    item:Show(self.curEmbattleItem, index)
end
---选择编队
---@param index number 编队序列
---@param edit boolean 是否编辑
---@return 变量类型 中文描述
function SociatyBattleFormationGroupView:OnGroupChoose(index)
    self.closeCall(index, false)
    self:Close()
    self.closeCall = nil
    -- if edit then
    --     self:Hide()
    -- else
    --     self:Close()
    --     self.closeCall = nil
    -- end
end
function SociatyBattleFormationGroupView:UpdateGroup(index)
    self.go_table.scrollloopvectical_group:UpdateItemSingle(index - 1)
end
return SociatyBattleFormationGroupView
