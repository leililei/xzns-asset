---@class SociatyBattleAtkRecordView : UIBaseView	中文描述
---@field public go_table SociatyBattleAtkRecordView_GoTable GoTable
---@field fightArgs fight.i_fight_arg 战斗参数
local SociatyBattleAtkRecordView = _G.BaseClass("SociatyBattleAtkRecordView", _G.UIBaseView)
--_G.SociatyBattleAtkRecordView = SociatyBattleAtkRecordView
local GetAutoGoTable = _G.GetAutoGoTable
function SociatyBattleAtkRecordView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param msg fight.i_fight_arg 战斗参数
---@param result boolean[] 战斗结果
function SociatyBattleAtkRecordView:OnCreate(roleInfoSelf, roleInfo, data, isAttack, isSelf)
    self.fightArgs = data
    if roleInfo.win_list then
        self.result = _G.DeepCopy(roleInfo.win_list)
    else
        self.result = {true, true, true}
    end
    self.winCount = 0
    self.loseCount = 0
    self.isAttack = isAttack
    if not self.isAttack then
        for i = 1, #self.result do
            self.result[i] = not self.result[i]
        end
    end
    self.isSelf = isSelf
    self:ShowResult(self.result)
    self:ShowRoleInfo(roleInfoSelf, roleInfo)
    local count = data.attack_team and #data.attack_team or 0
    self.go_table.scrollloopvectical_arrayList:InitItemData(count, _G.handler(self, self.RefreshItem))
    self.go_table.aorbtn_statistics:SetActiveE(0)
end

function SociatyBattleAtkRecordView:ShowRoleInfo(roleInfoSelf, roleInfo)
    _G.UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase1,
        {style = roleInfoSelf.style, frame = roleInfoSelf.frame, title = self:GetTitle(roleInfoSelf.title)},
        nil,
        true,
        true
    )
    _G.UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase2,
        {style = roleInfo.style, frame = roleInfo.frame, title = self:GetTitle(roleInfo.title)},
        nil,
        true,
        true
    )
    self.go_table.aortext_name1.text = roleInfoSelf.role_name or roleInfoSelf.name
    self.go_table.aortext_name2.text = roleInfo.role_name
    local selfData = require "SociatyBattleModel":GetInstance():GetSelfScoaityData():GetSociatyInfoData()
    local enemyData = require "SociatyBattleModel":GetInstance():GetEnemySociatyData():GetSociatyInfoData()
    if not self.isSelf then
        local tempData = selfData
        selfData = enemyData
        enemyData = tempData
    end
    local selfStr = "[" .. _G.ServerManager:GetInstance():GetServerNameByServerID(selfData.guild_server) .. "]" .. selfData.guild_name
    local enemyStr = "[" .. _G.ServerManager:GetInstance():GetServerNameByServerID(enemyData.guild_server) .. "]" .. enemyData.guild_name
    self.go_table.aortext_server1.text = selfStr
    self.go_table.aortext_server2.text = enemyStr
end

---显示阵容
function SociatyBattleAtkRecordView:RefreshItem(index, obj)
    ---@type SociatyBattleAtkRecordView._obj_item_GoTable
    local item = GetAutoGoTable(obj)
    if self.isAttack then
        self:ShowTeamCard(self.fightArgs.attack_team, item.obj_my, index)
        self:ShowTeamCard(self.fightArgs.defence_team, item.obj_enemy, index)
    else
        self:ShowTeamCard(self.fightArgs.attack_team, item.obj_enemy, index)
        self:ShowTeamCard(self.fightArgs.defence_team, item.obj_my, index)
    end
    local isWin = self.result[index + 1]
    self.winCount = self.winCount + (isWin and 1 or 0)
    self.loseCount = self.loseCount + (isWin and 0 or 1)
    item.obj_resultF:SetActiveE(isWin and 0 or 1)
    item.obj_resultV:SetActiveE(isWin and 1 or 0)
    item.aorrawimage_di:SetActiveE(index % 2 == 0 and 0 or 1)
    --item.aorimage_di.SpriteName = isWin and "haby_hongdi" or "haby_heidi"
    if index + 1 == #self.result then
        self:ShowAward()
    end
end

---显示战斗奖励
function SociatyBattleAtkRecordView:ShowAward()

end

---显示队伍卡牌
---@param team  fight.i_fight_team[] 队伍数据
function SociatyBattleAtkRecordView:ShowTeamCard(team, obj, index)
    local datas = team[index + 1]
    ---@type _obj_item._obj_my_GoTable
    local item = GetAutoGoTable(obj)
    if not item.cardList then
        item.cardList = {}
    end
    local count = datas.card_list and #datas.card_list or 0
    if count < #item.cardList then
        count = #item.cardList
    end
    for i = 1, count do
        self:SetCardShow(item.cardList, i, datas.card_list and datas.card_list[i] or nil, obj)
    end
    --item.aortext_array.text = _G.GetLangPackValue(90021800275, _G.GameUtil.NumberToChinese(index + 1))
    item.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(datas.power)
end

---显示卡牌
function SociatyBattleAtkRecordView:SetCardShow(itemList, index, data, parent)
    if data then
        local talentNum
        if _G.table.isEmptyOrNil(data.skills) then
            talentNum = data.born_skill_num
        else
            talentNum = self:GetTalentsNum(data.card_sid, data.skills)
        end
        if not itemList[index] then
            ---@param card ItemCardAllView
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                parent,
                function(card)
                    itemList[index] = card
                    card:Show(
                        data.card_sid,
                        nil,
                        data.star,
                        data.soul_lv,
                        data.card_lv,
                        data.card_sid,
                        true,
                        data.soul_state,
                        talentNum
                    )
                end
            )
        else
            itemList[index]:Show(
                data.card_sid,
                nil,
                data.star,
                data.soul_lv,
                data.card_lv,
                data.card_sid,
                true,
                data.soul_state,
                talentNum
            )
            itemList[index].gameObject:SetActiveE(1)
        end
    else
        if itemList[index] then
            itemList[index].gameObject:SetActiveE(0)
        end
    end
end

---获取激活大天赋数量
---@param sid number 卡牌sid
---@param skills table fight_arg中的卡牌技能组
---@return number 激活的大天赋数量
function SociatyBattleAtkRecordView:GetTalentsNum(sid, skills)
    local cfg = _G.ConfigManager.card_cfg[sid]
    if cfg == nil then
        return 0
    end
    local attrCfg = _G.ConfigManager.attribute_cfg
    local tCfg
    local num = 0
    for i, node in pairs(cfg.talent) do
        for j, talent in pairs(node) do
            tCfg = attrCfg[talent]
            if tCfg.skill > 0 and _G.table.ContainsValue(skills, tCfg.skill) then
                num = num + 1
            end
        end
    end
    return num
end

function SociatyBattleAtkRecordView:GetTitle(title)
    local newTitle
    if _G.IsNumber(title) then
        newTitle = {sid = title}
    else
        newTitle = title
    end
    return newTitle
end

---显示结果
---@param result boolean[] 结果
function SociatyBattleAtkRecordView:ShowResult(result)
    self.WinNum = 0
    if result then
        for i = 1, #result do
            if result[i] then
                self.WinNum = self.WinNum + 1
            end
        end
        self.isWin = self.WinNum > #result - self.WinNum
    end

    self.go_table.obj_resultV:SetActiveE(self.isWin and 1 or 0)
    self.go_table.obj_resultF:SetActiveE(self.isWin and 0 or 1)

