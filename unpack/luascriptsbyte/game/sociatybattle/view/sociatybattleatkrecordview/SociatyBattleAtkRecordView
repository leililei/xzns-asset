--设置战斗结果
function SociatyBattleAtkRecordView:SetWintable()
    local array = {}
    for i = 1, #self.result do
        if self.result[i] then
            _G.table.insert(array, 0)
        else
            _G.table.insert(array, 1)
        end
    end
    return array
end

---按钮点击事件在这里派发
function SociatyBattleAtkRecordView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return SociatyBattleAtkRecordView
