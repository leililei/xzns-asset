---@class SociatyBattleChatView : UIBaseView	公会战聊天窗口
---@field private go_table SociatyBattleChatView_GoTable  go_table
---@field private chatView ChatView     聊天窗口
---@field logs guild_fight.i_log[]
local SociatyBattleChatView = _G.BaseClass("SociatyBattleChatView", _G.UIBaseView)

function SociatyBattleChatView:Awake()
    ---工会站集火公告 每个字时间(用于x移动)
    self.topinfoInterval = 0.01
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyBattle.SociatyBattleState, self.ChangeState)

    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatView.Name, _G.ChatType.unionbattle)
end
function SociatyBattleChatView:Dispose()
    self:RemoveListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:RemoveListener(_G.eSociatyEvent.SociatyBattleState, self.ChangeState)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
end

---监听打开的窗口名称
---@param name string
function SociatyBattleChatView:OnViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ChatView.Name then
        return
    end
    ---@type ChatView
    self.chatView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if not self.chatView or _G.IsNil(self.gameObject) then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)

    self.chatView.transform:SetParentE(self.gameObject)
    self.chatView:SetUnionMode()
    self.chatView:SetCloseCallback(_G.handler(self, self.Close))
end
---关闭聊天窗口
function SociatyBattleChatView:CloseChatView()
    if not self.chatView then
        return
    end
    self.chatView:Close()
end

---被踢出
function SociatyBattleChatView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        self:CloseChatView()
        self:Close()
    end
end

function SociatyBattleChatView:ChangeState()
    if require "SociatyBattleModel":GetInstance():GetState() ~= _G.SociatyBattleState.Battle then
        self:CloseChatView()
        self:Close()
    end
end

return SociatyBattleChatView
