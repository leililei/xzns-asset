local SociatyBattleDefendMemberItem = require "SociatyBattleDefendMemberItem"
---@class SociatyBattleDefendView : UIBaseView	中文描述
---@field public go_table SociatyBattleDefendView_GoTable GoTable
---@field sociatyBattleData SociatyBattleData 公会驻地数据
---@field embattleCampsiteDatas SociatyBattleEmbattleData[] 公会战编队数据
---@field mainCampsiteDatas SociatyBattleEmbattleData[]重要驻地数据
---@field normalCampsiteDatas SociatyBattleEmbattleData[]普通驻地数据
---@field memberDatas guild_fight.i_role_battlefield[] 成员数据
---@field memberItemList SociatyBattleDefendMemberItem[] 成员个体
local SociatyBattleDefendView = _G.BaseClass("SociatyBattleDefendView", _G.UIBaseView)
--_G.SociatyBattleDefendView = SociatyBattleDefendView
local CampsiteType = _G.SociatyBattleCampsiteType
local CheckMousePointInRect = _G.CS.UIUtils.CheckMousePointInRect
function SociatyBattleDefendView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnRefreLocation)
end

---界面的入口函数
function SociatyBattleDefendView:OnCreate()
    SociatyBattleDefendMemberItem = require "SociatyBattleDefendMemberItem"
    self.memberItemList = {}
    self:InitData()
    self:ShowView()
    self.memberScrollRect =
        self.go_table.scrollloophorizontal_memberList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
end

---初始化数据
function SociatyBattleDefendView:InitData()
    self.sociatyBattleData = require "SociatyBattleModel":GetInstance():GetSelfScoaityData()
    self.embattleCampsiteDatas = self.sociatyBattleData:GetEmbattleCampsiteDic()
    self.memberDatas = self.sociatyBattleData:GetEmbattleRoleData()
    self.mainCampsiteDatas = {}
    self.normalCampsiteDatas = {}

    local insert = _G.table.insert
    for _, v in pairs(self.embattleCampsiteDatas) do
        if v:GetType() == CampsiteType.Importance or v:GetType() == CampsiteType.Main then
            insert(self.mainCampsiteDatas, v)
        else
            insert(self.normalCampsiteDatas, v)
        end
    end
    _G.table.sort(
        self.mainCampsiteDatas,
        function(a, b)
            return a.id > b.id
        end
    )
    _G.table.sort(
        self.normalCampsiteDatas,
        function(a, b)
            return a.id > b.id
        end
    )
    ---@param data guild_fight.i_role_battlefield
    _G.SortList(
        self.memberDatas,
        function(data)
            return data.role_power, -data.role_uid
        end
    )
end

---显示界面
---@param data SociatyBattleData
function SociatyBattleDefendView:ShowView()
    self:ShowMainCampsite()
    self.go_table.scrollloopvectical_campsiteList:InitItemData(
        #self.normalCampsiteDatas,
        _G.handler(self, self.RefreshNormalCampsiteItem)
    )
    self.go_table.scrollloophorizontal_memberList:InitItemData(#self.memberDatas, _G.handler(self, self.RefreshMember))
end

---显示重要驻地
function SociatyBattleDefendView:ShowMainCampsite()
    for i, v in ipairs(self.mainCampsiteDatas) do
        self:ShowCampsiteItem(self.go_table["obj_campsiteItem" .. i], v)
    end
end

---刷新驻地
function SociatyBattleDefendView:RefreshNormalCampsiteItem(index, obj)
    self:ShowCampsiteItem(obj, self.normalCampsiteDatas[index + 1])
end
---更新显示
---@param data SociatyBattleEmbattleData
function SociatyBattleDefendView:ShowCampsiteItem(obj, data)
    if not data then
        obj:SetActiveE(0)
        return
    end
    obj:SetActiveE(1)
    ---@type SociatyBattleDefendView._obj_campsiteItem1_GoTable
    local item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickCampsite, data))
    item.data = data
    if not data:CheckHaveRole() then
        item.obj_role:SetActiveE(0)
        item.obj_no:SetActiveE(1)
    else
        local role = data:GetRoleInfo()
        item.obj_role:SetActiveE(1)
        item.obj_no:SetActiveE(0)
        _G.UIUtils.SetPlayerHeadItemNew(
            item.obj_HeadItemBase,
            role,
            nil,
            true,
            false,
            false,
            function()
                self:OnClickMember({role_uid = role.uid})
            end
        )
        item.aortext_name.text = role.name
        item.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(role.power)
    end
    item.aortext_campsiteName.text = _G.GetLangPackValue(data.cfg.name)
end

---点击驻地
---@param data SociatyBattleEmbattleData
function SociatyBattleDefendView:OnClickCampsite(go, _, data)
    local name = go:GetName()
    if name == "@_aorbtn_check" then
        local role = data:GetRoleInfo()
        if role then
            require "SociatyBattleModel":GetInstance():GetEmbattleCampsiteInfo(
                role.uid,
                require "SociatyBattleModel":GetInstance().sociatyUid,
                function(msg)
                    data:SetEmbattle(msg)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.SociatyBattleCampsiteView.Name,
                        data,
                        self.sociatyBattleData:GetEmbattleInCampsiteId(role.uid),
                        true
                    )
                end
            )
        end
    end
end

---刷新成员显示
function SociatyBattleDefendView:RefreshMember(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.memberItemList[id]
    if not item then
        item =
            self:AddComponent(
            obj,
            SociatyBattleDefendMemberItem.New(
                _G.handler(self, self.OnClickMember)
                -- _G.handler(self, self.OnBeginDrag),
                -- _G.handler(self, self.OnDrag),
                -- _G.handler(self, self.OnEndDrag)
            )
        )
        self.memberItemList[id] = item
    end
    local data = self.memberDatas[index + 1]
    item:Show(data, self.sociatyBattleData:GetEmbattleInCampsiteId(data.role_uid) > 0)
end

---点击成员
---@params data guild_fight.i_role_battlefield
function SociatyBattleDefendView:OnClickMember(data)
    if not data then
        return
    end
    local id = self.sociatyBattleData:GetEmbattleInCampsiteId(data.role_uid)
    if id > 0 then
        self.sociatyBattleData:SetEmabttleCampsite(id)
        self:RefreshAll()
    else
        for _, v in ipairs(self.mainCampsiteDatas) do
            if not v:CheckHaveRole() then
                id = v.id
                break
            end
        end
        if id <= 0 then
            for i, v in ipairs(self.normalCampsiteDatas) do
                if not v:CheckHaveRole() then
                    id = v.id
                    break
                end
            end
        end
        self.sociatyBattleData:SetEmabttleCampsite(id, data)
        if id > 0 then
            self:RefreshAll()
        end
    end
end

function SociatyBattleDefendView:RefreshAll()
    self:ShowMainCampsite()
    self.go_table.scrollloopvectical_campsiteList:UpdateAllItem()
    self.go_table.scrollloophorizontal_memberList:UpdateAllItem()
end

---按钮点击事件在这里派发
function SociatyBattleDefendView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_clear then
        self:OnClear()
    elseif go == self.go_table.aorbtn_autoPlay then
        self:OnAuto()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 106)
    end
end

---关闭界面
function SociatyBattleDefendView:CloseView()
    local tb = {}
    for k, v in pairs(self.sociatyBattleData.embattleRoleDic) do
        _G.table.insert(tb, {b_id = v, role_uid = k})
    end
    if _G.table.isEmptyOrNil(tb) then
        _G.PopWindowManager:GetInstance():ShowAllTips(250130)
        return
    end
    require "SociatyBattleModel":GetInstance():SaveEmbattleData(
        tb,
        function()
            self:Close()
        end
    )
end

---清除
function SociatyBattleDefendView:OnClear()
    for _, v in ipairs(self.embattleCampsiteDatas) do
        self.sociatyBattleData:SetEmabttleCampsite(v.id)
    end
    self:RefreshAll()
end

---一键上阵
function SociatyBattleDefendView:OnAuto()
    local count = #self.embattleCampsiteDatas
    local count2 = #self.mainCampsiteDatas
    for i = 1, count do
        if not self.embattleCampsiteDatas[i] then
            return
        end
        if i <= count2 then
            self.sociatyBattleData:SetEmabttleCampsite(self.mainCampsiteDatas[i].id, self.memberDatas[i])
        else
            self.sociatyBattleData:SetEmabttleCampsite(self.normalCampsiteDatas[i - count2].id, self.memberDatas[i])
        end
    end
    self:RefreshAll()
end

---开始拖拽
---@param item SociatyBattleDefendMemberItem
function SociatyBattleDefendView:OnBeginDrag(item, ed)
    if self.OnDragBeginTag then
        return
    end
    self.isDragMember = false
    self.OnDragBeginTag = true
    self.dragObj = item.go_table.obj_HeadItemBase
    self.startPointy = ed.position.y
    self.memberScrollRect:OnBeginDrag(ed)
end
---拖拽中
function SociatyBattleDefendView:OnDrag(ed)
    if not self.OnDragBeginTag then
        return
    end
    if not self.isDragMember then
        if not self.dragObj or math.abs(self.startPointy - ed.position.y) < 20 then
            self.memberScrollRect:OnDrag(ed)
            return
        else
            if self.dragObj then
                self.dragObj:SetParentE(self.go_table.trans_choose)
            end
            self.isDragMember = true
        end
    end
    self.dragPosX, self.dragPosY =
        _G.CS.UIUtils.ScreenPointToLocalPointInRectangle(self.go_table.trans_choose:GetParent())
    self.go_table.trans_choose:SetLocalPosition(self.dragPosX, self.dragPosY, 0)
end
---卡牌拖拽结束
---@param item SociatyBattleDefendMemberItem
function SociatyBattleDefendView:OnEndDrag(item, ed)
    if not self.OnDragBeginTag then
        return
    end
    if not self.isDragMember then
        self.isDragMember = false
        self.memberScrollRect:OnEndDrag(ed)
    else
        local obj = self:CheckDargObj()
        if obj then
            ---@type SociatyBattleDefendView._obj_campsiteItem1_GoTable
            local campsite = _G.GetAutoGoTable(obj)
            self.sociatyBattleData:SetEmabttleCampsite(campsite.data.id, item.data)
        end
        self.dragObj:SetParentE(item.go_table.obj_content)
        self.dragObj:SetAsFirstSiblingE()

        self:RefreshAll()
    end
    self.dragObj = nil
    self.OnDragBeginTag = false
end

---检测拖拽到哪
function SociatyBattleDefendView:CheckDargObj()
    local _, y = self.go_table.trans_choose:GetLocalPosition()
    if y < -128 then
        return
    end
    local count = self.go_table.trans_mainCampsiteList:GetChildCountE()
    for i = 1, count do
        if CheckMousePointInRect(self.go_table.trans_mainCampsiteList:GetChildE(i - 1)) then
            ---显示区域问题
            return self.go_table.trans_mainCampsiteList:GetChildE(i - 1)
        end
    end
    count = self.go_table.obj_content:GetChildCountE()
    for i = 1, count do
        if CheckMousePointInRect(self.go_table.obj_content:GetChildE(i - 1)) then
            return self.go_table.obj_content:GetChildE(i - 1)
        end
    end
end

---职位变动
---@param data guild.p2c_guild_position
function SociatyBattleDefendView:OnRefreLocation(data)
    if not data then
        return
    end
    local member = require "SociatyModel":GetInstance().SociatySelf.GetMemberModule():GetSelfMember()
    if not member.CfgItem.sign_up then
        self:Close()
        _G.PopWindowManager:GetInstance():ShowAllTips(250120)
    end
end

return SociatyBattleDefendView
