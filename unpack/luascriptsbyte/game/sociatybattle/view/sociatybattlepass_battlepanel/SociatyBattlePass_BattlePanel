    --for _, value in ipairs(jclist) do
    --    if data.rank >= value[1] and data.rank <= value[2] then
    --        go_table.aortext_getjctext.text = "奖励*" .. _G.Mathf.FloorToInt(value[3] / 100) .. "%"
    --        theRank = 1
    --        break
    --    end
    --end

    go_table.aorimage_getjc:SetActiveE(0)
end

function SociatyBattlePass_BattlePanel:OnClickItem(go, _, index)
    local name = go:GetName()
    local data = self.battleAwardList[index]
    if name == "@_aorbtn_get" then
        require "SociatyBattleNet":GetInstance():GetBattleAward(
            {uid = data.uid},
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                local jclist = _G.ConfigManager.discrete_cfg[101652]
                local theRank = 0
                for _, value in ipairs(jclist) do
                    if data.rank >= value[1] and data.rank <= value[2] then
                        theRank = _G.Mathf.FloorToInt(value[3] / 100)
                        break
                    end
                end
                local rankAward = {}
                rankAward.rank = data.rank
                rankAward.theRank = theRank
                require "CommonTipManager".OpenCommonAwardView(msg, nil, nil, nil, nil, nil, nil, nil, nil, rankAward)
                data.state = 1
                self.go_table.scrollloopvectical_itemList:UpdateItemSingle(index - 1)
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.GuildBattleRewards.id
                )
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg.GuildBattleContribute.id
                )
            end
        )
    elseif name == "@_aorbtn_check" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleResultAwardView.Name, data)
    end
end

---显示公会
---@param data guild_fight.i_fight_award_guild
function SociatyBattlePass_BattlePanel:ShowSociaty(obj, data)
    ---@type _obj_battleItem._obj_self_GoTable
    local go_table = GetAutoGoTable(obj)
    ---@type guild_portrait_cfg
    local cfg = _G.ConfigManager.guild_portrait_cfg[data.banner]
    go_table.aorrawimage_icon:LoadImage(cfg.portrait)
    go_table.aortext_score.text = _G.GetLangPackValue(90025700027, "<color=#984904>" .. data.guild_score .. "</color>")
    if data.guild_uid < 10000000 then
        go_table.aortext_name.text = _G.GetLangPackValue(data.guild_name)
    else
        go_table.aortext_name.text = data.guild_name
    end
    go_table.slider_progress.value = data.guild_score / 10000
end

function SociatyBattlePass_BattlePanel:OnClickBtn(go)
end

return SociatyBattlePass_BattlePanel
