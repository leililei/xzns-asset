---@class SociatyBattlePass_BattlePanel : Component	中文描述
---@field go_table SociatyBattlePassView._obj_battle_GoTable
---@field battleAwardList guild_fight.i_fight_award[]
local SociatyBattlePass_BattlePanel = _G.BaseClass("SociatyBattlePass_BattlePanel", _G.Component)
local GetAutoGoTable = _G.GetAutoGoTable
function SociatyBattlePass_BattlePanel:Awake()
    self.go_table = GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SociatyBattlePass_BattlePanel:OnCreate()
    self.maxNum = #_G.ConfigManager.guild_battle_campsite_cfg
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---显示界面
function SociatyBattlePass_BattlePanel:ShowView()
    self.battleAwardList = require "SociatyBattleModel":GetInstance():GetBattleAwardList()
    local count = #self.battleAwardList
    self.go_table.scrollloopvectical_itemList:UpdateCount(count)
    self.go_table.obj_no:SetActiveE(count == 0 and 1 or 0)
end

---刷新显示
function SociatyBattlePass_BattlePanel:RefreshItem(index, obj)
    ---@type obj _obj_battle._obj_battleItem_GoTable
    local go_table = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index + 1))
    local data = self.battleAwardList[index + 1]
    self:ShowSociaty(go_table.obj_self, data.guild_info[1])
    self:ShowSociaty(go_table.obj_enemy, data.guild_info[2])
    go_table.obj_resultF:SetActiveE(data.winner and 0 or 1)
    go_table.obj_resultV:SetActiveE(data.winner and 1 or 0)
    go_table.aorbtn_get:SetActiveE(data.state == 0 and 1 or 0)
    go_table.aorbtn_check:SetActiveE(data.state > 0 and 1 or 0)

