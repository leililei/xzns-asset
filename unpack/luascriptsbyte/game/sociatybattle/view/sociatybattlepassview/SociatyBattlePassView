---@class SociatyBattlePassView : UIBaseView	中文描述
---@field public go_table SociatyBattlePassView_GoTable GoTable
---@field public awardList store_season_battlecon_cfg[] 奖励显示
local SociatyBattlePassView = _G.BaseClass("SociatyBattlePassView", _G.UIBaseView)

function SociatyBattlePassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattlePassView:OnCreate(type)
    if not type then
        type = 1
    end
    if type == 1 then
        self.go_table.toggle_battle.isOn = true
        self:OnBattle(true)
    else
        self.go_table.toggle_gx.isOn = true
        self:OnGx(true)
    end
end

function SociatyBattlePassView:OnBattle(isOn)
    self.go_table.aorbtn_award:SetActiveE(1)
    self:ShowToggles(self.go_table.toggle_battle, isOn)
    self.go_table.obj_battle:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.battlePanel then
        self.battlePanel = self:AddComponent(self.go_table.obj_battle, require "SociatyBattlePass_BattlePanel".New())
    end
    self.battlePanel:ShowView()
end

function SociatyBattlePassView:OnGx(isOn)
    self.go_table.aorbtn_award:SetActiveE(0)
    self:ShowToggles(self.go_table.toggle_gx, isOn)
    self.go_table.obj_gx:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.gxPanel then
        self.gxPanel = self:AddComponent(self.go_table.obj_gx, require "SociatyBattlePassView_GXPanel".New())
    end
    self.gxPanel:ShowView()
end

---显示标签
function SociatyBattlePassView:ShowToggles(obj, isOn)
    local item = _G.GetAutoGoTable(obj)
    item.aorimage_isOn:SetActiveE(isOn and 1 or 0)
end

---按钮点击事件在这里派发
function SociatyBattlePassView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_battle then
        self:OnBattle(isOn)
    elseif go == self.go_table.toggle_gx then
        self:OnGx(isOn)
    elseif go == self.go_table.aorbtn_award then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleAwardsOverviewView.Name)
    end
end

return SociatyBattlePassView
