local EmbattleController =require "EmbattleController"
---@class SociatyBattleEmbattleView : UIBaseView	中文描述
---@field public go_table SociatyBattleEmbattleView_GoTable GoTable
local SociatyBattleEmbattleView = _G.BaseClass("SociatyBattleEmbattleView", _G.UIBaseView)
--_G.SociatyBattleEmbattleView = SociatyBattleEmbattleView

function SociatyBattleEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.animator = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.animator.enabled = false
end

---界面的入口函数
function SociatyBattleEmbattleView:OnCreate(embattleTypes, embattleItemType, exit, battle, data, viewName)
    self.onExitCall = exit
    self.onBattleCall = battle
    self.changeViewName = viewName
    self.enemyData = data
    self.go_table.aorbtn_change:SetActiveE(0)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    EmbattleController:GetInstance():OpenEmbattle(
        embattleTypes,
        _G.EmbattleSaveType.server,
        false,
        embattleItemType,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        _G.ConfigManager.arena_info_cfg[2].battle_sences,
        data and data.garray or nil
    )
    self.isinited = true
end

function SociatyBattleEmbattleView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
    self.changeViewName = nil
    self.enemyData = nil
    self.animator = nil
end

---按钮点击事件在这里派发
function SociatyBattleEmbattleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_change then
        local embattleItem = EmbattleController:GetInstance():GetCurEmbattleItem()
        local combSkill = embattleItem:GetCombSkillData()
        local lv = 1
        local battleSkills = {{0, 0, 0}, {0, 0, 0}, {0, 0, 0}}
        local CombineModelIns = require "CombineModel":GetInstance()
        local combCfgs = _G.ConfigManager.combine_cfg
        for i = 1, #combSkill do
            for j = 1, #combSkill[i] do
                if combSkill[i][j].id > 0 then
                    battleSkills[i][j] = combSkill[i][j].cskillID
                end
            end
        end
        _G.UIManager:GetInstance():OpenWindow(
            self.changeViewName,
            _G.handler(self, self.OnChangeCall),
            embattleItem:GetAllEmbattleData(),
            embattleItem:GetAllEnemyEmbattleData(),
            self.enemyData,
            battleSkills
        )
    end
end

---监听界面打开
---@param name string 界面名称
function SociatyBattleEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.embattleView:RegiestChooseViewOpen(_G.handler(self, self.OnChooseViewOpen))
        self.embattleView:SetInitDoneCall(_G.handler(self, self.OnEmbattleInitDone))
        self.embattleView:SetEffLoadCall(_G.handler(self, self.OnEmbattleCloseCall))
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
    end
end

function SociatyBattleEmbattleView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
    end
end

function SociatyBattleEmbattleView:OnBattleCall()
    self:Close()
    if self.onBattleCall then
        self.onBattleCall()
    end
end
function SociatyBattleEmbattleView:OnEmbattleCloseCall()
    self.animator:Play("a_ArenaEmbattleSeniorView_close")
end
function SociatyBattleEmbattleView:OnEmbattleInitDone()
    self.animator.enabled = true
    self.animator:Play("a_ArenaEmbattleSeniorView_open")
    self.go_table.aorbtn_change:SetActiveE(1)
end
---改变位置回调
---@param indexes table 调整后得位置序列组{1，2，3}
function SociatyBattleEmbattleView:OnChangeCall(indexes)
    for i = 1, #indexes - 1 do
        if i ~= indexes[i] then
            EmbattleController:GetInstance():GetCurEmbattleItem():ChangeGroup(indexes)
            break
        end
    end
    self.embattleView:UpdateMyFormation()
end
function SociatyBattleEmbattleView:OnChooseViewOpen(show)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change, not show)
end
function SociatyBattleEmbattleView:OnLeagueChanged()
    if not self.enemyData then
        return
    end
    local UIManager = _G.UIManager:GetInstance()
    local uicfg = _G.ConfigManager.ui_cfg
    UIManager:CloseWindow(uicfg.EmbattleView.Name)
    UIManager:CloseWindow(uicfg.EmbattleChooseView.Name)
    UIManager:CloseWindow(uicfg.EmbattleFormationGroupView.Name)
    UIManager:CloseWindow(uicfg.CombSkillTipsView.Name)
    UIManager:CloseWindow(uicfg.CombSkillEmbattleView.Name)
    self:OnExitCall()
end
return SociatyBattleEmbattleView