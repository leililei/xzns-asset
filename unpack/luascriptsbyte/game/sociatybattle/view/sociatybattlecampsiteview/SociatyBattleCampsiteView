---进攻
function SociatyBattleCampsiteView:OnAttack()
    if require "SociatyBattleModel":GetInstance():GetState() ~= _G.SociatyBattleState.Battle then
        _G.PopWindowManager:GetInstance():ShowAllTips(250126)
        self:Close()
        return
    end
    if self.isSelf then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        require "SociatyBattleManager":GetInstance():Fight(
            SociatyBattleModel:GetInstance():GetSelfScoaityData():GetSociatyInfoData().guild_uid,
            self.data,
            true
        )
    else
        if self.data:GetHp() <= 0 then
            local isAllZero = require("SociatyBattleManager"):GetInstance():CheckCampsiteZero()

            ---判断是否为全驻地攻破
            if isAllZero then
                if _G.MainManager:GetInstance():IsFighting(true) then
                    return
                end
                --镇魂街ZHJ-27879 Alpha_JT BUG合集ZHJ-35255
                --【公会战】据点全部攻破后，重新进攻的弹窗内容错误
                -- _G.PopWindowManager:GetInstance():ShowAllTips(
                --     250129,
                --     nil,
                --     function()
                --         require "SociatyBattleManager":GetInstance():Fight(
                --             SociatyBattleModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                --             self.data
                --         )
                --     end
                -- )
                require "SociatyBattleManager":GetInstance():Fight(
                    SociatyBattleModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                    self.data
                )
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(250137)
                return
            end
        else
            if self.data:GetType() == _G.SociatyBattleCampsiteType.Main then
                local isAllZero =
                    require("SociatyBattleManager"):GetInstance():CheckCampsiteZero(
                        _G.SociatyBattleCampsiteType.Importance
                    )

                ---判断是否为重要驻地都攻破
                if isAllZero then
                    if _G.MainManager:GetInstance():IsFighting(true) then
                        return
                    end
                    require "SociatyBattleManager":GetInstance():Fight(
                        SociatyBattleModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                        self.data
                    )
                else
                    if _G.AppSetting.DEBUG then
                        Log("重要驻地未全攻破，不能攻主城")
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(250138)
                end
            else
                if _G.MainManager:GetInstance():IsFighting(true) then
                    return
                end
                require "SociatyBattleManager":GetInstance():Fight(
                    SociatyBattleModel:GetInstance():GetEnemySociatyData():GetSociatyInfoData().guild_uid,
                    self.data
                )
            end
        end
    end
end

---按钮点击事件在这里派发
function SociatyBattleCampsiteView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_battle then
        if not self.isSelf then
            if not require "SociatyBattleManager":GetInstance():CheckTime12() then
                _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90021800547))
                return
            end
            if self.data:GetRoleInfo().uid == _G.PlayerModel:GetInstance().role_uid then
                _G.PopWindowManager:GetInstance():ShowAllTips(250311)
                return
            end
        end
        self:OnAttack()
    elseif go == self.go_table.aorbtn_record then
        local roleInfo = _G.DeepCopy(self.data:GetRoleInfo())
        roleInfo.arena_peak_dan = self.data:GetArenaPeakDan()
        local uid1 = SociatyBattleModel:GetInstance():GetEnemySociatyData():GetUid()
        local uid2 = require "SociatyManager":GetInstance():GetGuildUid()
        if not self.isSelf then
            uid1, uid2 = uid2, uid1
        end
        SociatyBattleModel:GetInstance():GetFightRecord(
            uid1,
            uid2,
            self.data.id,
            function(msg)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SociatyBattleMessageView.Name,
                    msg,
                    roleInfo,
                    false,
                    self.power,
                    self.isSelf
                )
            end
        )
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 105)
    end
end

