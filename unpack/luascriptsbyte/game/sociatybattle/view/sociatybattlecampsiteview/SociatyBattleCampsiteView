function SociatyBattleCampsiteView:OnBekied(uid)
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        local exit, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if exit then
            view.View:QuitEmbattle()
        end
        self:Close()
    end
end

