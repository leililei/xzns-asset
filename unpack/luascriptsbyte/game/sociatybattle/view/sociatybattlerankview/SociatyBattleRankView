        if v.uid == _G.GetPlayerUid() then
            self.selfRank = k
            break
        end
    end
    if self.selfRank > 0 then
        local data = self.memberData[self.selfRank]
        self:ShowMember(tb, data, self.selfRank, true)
    else
        tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rankNum.text = _G.GetLangPackValue(90022900040)
