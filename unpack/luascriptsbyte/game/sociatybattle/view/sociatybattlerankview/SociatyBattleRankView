---界面的入口函数
function SociatyBattleRankView:OnCreate(data, index)
    self.curSeasonID = require "SociatyBattleModel":GetInstance():GetSeasonId()
    self.seasonLis = {}
    for i = self.curSeasonID - 4, self.curSeasonID do
        if i > 0 then
            _G.table.insert(self.seasonLis, i)
        end
    end
    self.rankDatas = {}
    self.rankDatas[self.curSeasonID] = data.ranks or {}
    self.myServer = _G.ServerManager:GetInstance().CurServer.ServerName
    self.RewardDatas = {}
    self.SociatySelf = require "SociatyModel":GetInstance().SociatySelf
    self.myIndex = 0
    self.score = 0
    local awardList = guild_entrance_cfg[_G.ScoaityActivityType.SociatyBattle].rank
    for k, v in pairs(awardList) do
        local data = arena_rank_cfg[v]
        table.insert(self.RewardDatas, data)
    end
    _G.SortList(
        self.RewardDatas,
        function(a)
            return -a.min_rank
        end
    )
    self:InitToggle()
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        if nil == index then
            self.go_table.toggle_rank.isOn = true
        else
            self.go_table.toggle_memberRank.isOn = true
        end
    end
    local resources = _G.ConfigManager.ui_cfg.SociatyBattleRankView.resources
    if resources then
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:AddComponent(self.go_table.obj_PlayerHead, require("PlayerComponent").New(self.go_table.obj_PlayerHead))
end

function SociatyBattleRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
        )
    self.Toggles["Member"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_memberRank,
            _G.handlerbind(self, self.OnToggle, "Member", _G.handler(self, self.OnMember))
        )
    self.go_table.toggle_zoneRank:SetActiveE(0)
    self:OnToggle(self, true, "Rank", _G.handler(self, self.OnRank))
end

---点击Togggle
function SociatyBattleRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

function SociatyBattleRankView:OnReward(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRewardRank then
        _G.PoolsManager:GetInstance():Spawn(
            require "ZoneRankModel".GetRewardPrefabPath(),
            _G.ePoolType.Temporary,
            self.go_table.obj_Reward,
            function(trans)
                if self:IsNil() then
                    return
                end
                local view = self:AddComponent(trans.gameObject, require "ZoneRankRewardView".New(trans, self))
                view:InitView(nil, nil, self.RewardDatas, GetLangPackValue(90021800292))
                self.ZoneRewardRank = view
            end
        )
    end
end

---刷新排行显示
---@param listView2 SuperScrollView.LoopListView2
function SociatyBattleRankView:RefrshItem(listView2, index)
    local newIndex = index + 1
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local instance = item:GetInstanceIDE()
    if not self.itemList[instance] then
        self.itemList[instance] = _G.GetAutoGoTable(item, _G.handler(self, self.OnClickAward))
        self.itemList[instance].itemList = {}
        self.itemList[instance].itemCount = 0
    end
    local tb = self.itemList[instance]
    local data = self.cfg[newIndex]
    tb.aorimage_rankIcon:DisposeChildren()
    if data.min_rank <= 3 and data.min_rank == data.max_rank then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, true)
        tb.aortext_rankItem.text = ""
        tb.aorimage_rankIcon.SpriteName = "uui_tz_maoxian_shd_paiming" .. data.min_rank
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[rankEffect[data.min_rank]], tb.aorimage_rankIcon)
    else
        _G.GameUtil.SetActiveByCondition(tb.aorimage_rankIcon, false)
        tb.aortext_rankItem.text = GetLangPackValue(90022500407, data.min_rank, data.max_rank)
    end
    local count = #data.reward_daily
    local curItemCount = tb.itemCount
    if count > curItemCount then
        for i = curItemCount + 1, count do
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWiFthCount,
                tb.trans_content,
                function(tran)
                    tb.itemCount = tb.itemCount + 1
                    tb.itemList[i] = item
                    tran:Show(data.reward_daily[i][1], nil, data.reward_daily[i][2])
                end
            )
        end
    else
        for i = 1, curItemCount do
            if i <= count then
                _G.GameUtil.SetActiveByCondition(tb.itemList[i].go_table.gameObject, true)
                tb.itemList[i]:Show(data.reward_daily[i][1], nil, data.reward_daily[i][2])
            else
                _G.GameUtil.SetActiveByCondition(tb.itemList[i].go_table.gameObject, false)
            end
        end
    end
    return item
end

---大区排行
function SociatyBattleRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.MonsterSiege, self.activie:GetActivityID())
                self.ZoneRank = view
            end
        )
    end
end

---排行
function SociatyBattleRankView:OnRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank, _G.handler(self, self.OnClickRank))
        self.rankList = {}
        local count = #self.rankDatas[self.curSeasonID]
        self.Rank.scrollloopvectical_rankList:InitItemData(count, _G.handler(self, self.RefreshRank))
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, count <= 0)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_topBg, count > 0)
        self.Rank.aortext_curDanZone.text = GetLangPackValue(90029400052, self.curSeasonID)
        self:InitPlayer()
    end
end

function SociatyBattleRankView:OnMember(isOn)
    self.go_table.obj_MemberRank:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.MemberRank then
        ---@type SociatyBattleRankView._obj_MemberRank_GoTable
        self.MemberRank = _G.GetAutoGoTable(self.go_table.obj_MemberRank, _G.handler(self, self.OnClickMemberRank))
        require "SociatyBattleModel":GetInstance():GetRoleRank(
            function(msg)
                if msg.ack == 1 then
                    self.memberData = msg.rank or {}
                    self.maxScore = 0
                    self.totalScore = 0
                    local score
                    for i = #self.memberData, 1, -1 do
                        score = self.memberData[i].score
                        if score == 0 then
                            _G.table.remove(self.memberData, i)
                        else
                            if score > self.maxScore then
                                self.maxScore = score
                            end
                            self.totalScore = self.totalScore + score
                        end
                    end
                    local count = #self.memberData
                    --if count > 3 then
                    --    count = 3 + math.ceil((count - 3) / 2)
                    --end
                    self:InitPlayerRank()
                    self.MemberRank.scrollloopvectical_rankList:InitItemData(
                        count,
                        _G.handler(self, self.RefreshMemberRank)
                    )
                    _G.GameUtil.SetActiveByCondition(self.MemberRank.obj_no, #self.memberData <= 0)
                    _G.GameUtil.SetActiveByCondition(self.MemberRank.obj_topBg, #self.memberData > 0)
                end
            end
        )
    end
end

--region ------------- 公会排行 -------------

function SociatyBattleRankView:UpdateRankView()
    if self.Rank then
        self.Rank.scrollloopvectical_rankList:UpdateCount(#self.rankDatas[self.curSeasonID])
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas[self.curSeasonID] <= 0)
        self.Rank.aortext_curDanZone.text = GetLangPackValue(90029400052, self.curSeasonID)
        self:InitPlayer()
    end
end

function SociatyBattleRankView:HeadClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid, 600)
            end
        end
    elseif name == "@_aorbtn_qice" then
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                local cardteams = _G.StorageManager:GetInstance():GetCardDataSortList()
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DungonesRelicView.Name,
                    data.params,
                    true,
                    cardteams,
                    true
                )
            else
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DungonesRelicView.Name,
                    data.params,
                    true,
                    data.teamcards,
                    true
                )
            end
        end
    elseif name == "@_aorbtn_huifang" then
        --- 70 = 恶灵入侵
        require "DungonesModel":GetInstance():PlayRankHuiFang(70, data.uid)
    elseif name == "@_aorbtn_click" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyInfoPreviewView.Name, data.guild_uid)
    end
end

---刷新排行
function SociatyBattleRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb1 = self.rankList[instanceID]
    if not self.rankList[instanceID] then
        tb1 = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.HeadClick, tb1))
        self.rankList[instanceID] = tb1
    end
    local tb = self.rankList[instanceID]
    local data = self.rankDatas[self.curSeasonID][newindex]
    local server = _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id)
    tb.rankData = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rank, newindex <= 3)
    _G.GameUtil.SetActiveByCondition(tb.aortext_rankNum, newindex > 3)
    if newindex <= 3 then
        tb.aorimage_rankBg.SpriteName = "ui_diban" .. newindex
        tb.aorimage_rankBg:SetRectTransformSize(702, 144)
        tb.aorimage_rank.SpriteName = rankIcon[newindex]
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == newindex and 1 or 0)
        end
        self:ShowTopRank(data, newindex)
    else
        tb.aortext_rankNum.text = newindex
        tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
        tb.aorimage_rankBg:SetRectTransformSize(692, 132)
    end
    tb.aortext_name.text = data.guild_name
    tb.aortext_server.text = "【" .. server .. "】"
    tb.aortext_score.text = GetLangPackValue(90000010438, "<color=#5F7E2A>" .. data.guild_score .. "</color>")
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)

    local rankAwardList
    local list = _G.ConfigManager.discrete_cfg[101644][1]
    for _, id in ipairs(list) do
        local ral = _G.ConfigManager.arena_rank_cfg[id]
        if ral.min_rank <= newindex and ral.max_rank >= newindex then
            rankAwardList = ral.reward_daily
            break
        end
    end
    self:ShowAwardRank(tb, tb.obj_Award, rankAwardList)
end

---添加排行奖励显示
function SociatyBattleRankView:ShowAwardRank(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

---显示前三名公会信息
function SociatyBattleRankView:ShowTopRank(data, rank)
    local topItem = _G.GetAutoGoTable(self.Rank["obj_info" .. rank])
    topItem.aortext_name.text = data.guild_name
    topItem.obj_score:SetActiveE(1)
    topItem.obj_Banner:SetActiveE(1)
    topItem.aortext_score.text = GetLangPackValue(90000010438, data.guild_score)
    topItem.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
end

---显示玩家所在公会信息
function SociatyBattleRankView:InitPlayer()
    self:GetSelfRank()
    if not self.player then
        self.player = _G.GetAutoGoTable(self.Rank.obj_player)
    end
    local tb = self.player
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[self.SociatySelf.Banner].portrait)
    local newindex = self.myIndex
    -- local score = require "SociatyBattleModel":GetInstance():GetSelfScoaityData():GetSorce()
    -- score = _G.GameUtil.NumberToUnitStr(score)

    local rankAwardList
    if newindex == 0 then
        tb.aortext_rankNum.text = GetLangPackValue(90022900040)
        local list = _G.ConfigManager.discrete_cfg[101644][1]
        local id = list[#list]
        local ral = _G.ConfigManager.arena_rank_cfg[id]
        rankAwardList = ral.reward_daily
        tb.aorimage_rank:SetActiveE(0)
    else
        local list = _G.ConfigManager.discrete_cfg[101644][1]
        for _, id in ipairs(list) do
            local ral = _G.ConfigManager.arena_rank_cfg[id]
            if ral.min_rank <= newindex and ral.max_rank >= newindex then
                rankAwardList = ral.reward_daily
                break
            end
        end
        tb.aortext_rankNum:SetActiveE(newindex <= 3 and 0 or 1)
        tb.aorimage_rank:SetActiveE(newindex <= 3 and 1 or 0)
        if newindex <= 3 then
            tb.aorimage_rankBg.SpriteName = "ui_diban" .. newindex
            tb.aorimage_rankBg:SetRectTransformSize(702, 144)
            tb.aorimage_rank.SpriteName = rankIcon[newindex]
            for i = 1, 3 do
                tb["aortext_rankNum" .. i]:SetActiveE(i == newindex and 1 or 0)
            end
        else
            tb.aortext_rankNum.text = newindex
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
            tb.aorimage_rankBg:SetRectTransformSize(692, 132)
        end
    end

    local server = self.myServer
    if self.selfRank then
        server = _G.ServerManager:GetInstance():GetServerNameByServerID(self.selfRank.server_id)
    end
    tb.aortext_server.text = "【" .. server .. "】"
    tb.aortext_score.text = GetLangPackValue(90000010438, "<color=#5F7E2A>" .. self.score .. "</color>")
    tb.aortext_name.text = self.SociatySelf.Name

    self:ShowAwardRank(tb, tb.obj_Award, rankAwardList)
end

function SociatyBattleRankView:GetSeasonRank()
    if not self.rankDatas[self.curSeasonID] then
        require "SociatyBattleModel":GetInstance():GetRank(
            function(msg)
                self.rankDatas[self.curSeasonID] = msg.ranks or {}
                self:UpdateRankView()
            end,
            self.curSeasonID
        )
    else
        self:UpdateRankView()
    end
end

function SociatyBattleRankView:GetSelfRank()
    for i, v in pairs(self.rankDatas[self.curSeasonID]) do
        if v.guild_uid == self.SociatySelf.Uid then
            self.score = v.guild_score
            self.myIndex = i
            self.selfRank = v
            break
        end
    end
end

