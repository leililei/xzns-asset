                false,
                false,
                false,
                true,
                true,
                true,
                true,
                true
            ),
            nil,
            true,
            false
        )
        tb.slider_proportion.value = 0
        tb.aortext_rate.text = "0%"
        tb.aortext_score.text = GetLangPackValue(90000010438, "<color=#5F7E2A>0</color>") --_G.GameUtil.NumberToUnitStrFight(data.power)
