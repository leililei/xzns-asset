---按钮点击事件在这里派发
function SociatyBattleRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_Info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleMatchView.Name)
    elseif go == self.go_table.aorbtn_Defense then
        require "SociatyBattleManager":GetInstance():SetDefend()
    elseif go == self.go_table.aorbtn_record then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleNewsView.Name)
    elseif go == self.go_table.aorbtn_reward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattlePassView.Name)
    end
end

return SociatyBattleRankView
