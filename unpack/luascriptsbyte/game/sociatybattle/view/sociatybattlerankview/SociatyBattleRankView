    local tb = obj.aorimage_rank and obj or _G.GetAutoGoTable(obj)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, nil, true, false)
    tb.aorimage_rank:SetActiveE(rank <= 3 and 1 or 0)
    if rank <= 3 then
        tb.aortext_rankNum.text = ""
        tb.aorimage_rankBg.SpriteName = "ui_diban" .. rank
        tb.aorimage_rankBg:SetRectTransformSize(702, 144)
        tb.aorimage_rank.SpriteName = rankIcon[rank]
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == rank and 1 or 0)
        end
        self:ShowTopMemberRank(data, rank)
    else
        tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
        tb.aorimage_rankBg:SetRectTransformSize(692, 132)
        tb.aortext_rankNum.text = rank
    end
    --tb.aorimage_isMe:SetActiveE(data.uid == _G.GetPlayerUid() and 1 or 0)
    tb.aortext_name.text = data.name
    tb.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(data.power)
    tb.aortext_score.text = GetLangPackValue(90000010438, "<color=#5F7E2A>" .. data.score .. "</color>") --_G.GameUtil.NumberToUnitStrFight(data.power)
    local rate = data.score / self.maxScore
    tb.slider_proportion.value = rate
    tb.aortext_rate.text = _G.string.format("%.0f%%", data.score / self.totalScore * 100)
    --if isSingle then
    --    tb.aortext_rate:SetLocalPosition(251 - (1 - rate) * 298, -1, 0)
    --else
    --    tb.aortext_rate:SetLocalPosition(-48 - (1 - rate) * 100, 1, 0)
    --end
    local buff
    for _, v in pairs(AwardRate) do
        if rank >= v[1] and rank <= v[2] then
            buff = GetLangPackValue(90021800358) ..
                _G.string.format(": <color=#5F7E2A>%d%%</color>", v[3] / 100)
            break
        end
    end
    tb.aortext_awardRate.text = buff
    --tb.aorimage_awardRateBg:SetActiveE(buff and 1 or 0)
    tb.aortext_awardRate:SetActiveE(buff and 1 or 0)
end

---显示前三名玩家信息
function SociatyBattleRankView:ShowTopMemberRank(data, rank)
    local topItem = _G.GetAutoGoTable(self.MemberRank["obj_info" .. rank], function()
        if data.uid and data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    end)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyBattleRankItem .. rank, topItem)
    topItem.obj_score:SetActiveE(1)
    topItem.aortext_name.text = data.name
    topItem.aortext_score.text = GetLangPackValue(90000010438, data.score)
    require("SystemSettingNet"):GetInstance():GetPlayerInfo(
        { uid = data.uid },
        function(msg)
            if not msg.info then
                return
            end
            local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
            local scale = cfg.size2
            local pos = cfg.pos_portrait
            topItem.trans_role:ClearChildren()
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
            if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
                scale = cfg.size4
                pos = { 0, 0, 0 }
            end
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                nil,
                function(trans)
                    if trans == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    SociatyBattleRankView LoadRoleScene")
                        end
                        return
                    end
                    if _G.IsNil(self) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetParentE(topItem.trans_role)
                    trans:SetLocalPosition(pos[1], pos[2], pos[3])
                    trans:SetLocalScaleXYZ(scale)
                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = msg.info.god_halo
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                        end
                        if not table.isEmptyOrNil(msg.info.artifact_skin) then
                            _G.UIUtils.LoadArtifacteffect(trans,nil,msg.info.artifact_skin[1],msg.info.artifact_skin[2])
                        end
                    end
                end
            )
        end
    )
end

