function SociatyBattleRankView:ShowSelect()
    if self.Rank.obj_isDanSelect:GetActiveSelf() == 0 then
        ---展开
        self.Rank.obj_isDanSelect:SetActiveE(1)
        self.Rank.aorimage_danArrow:SetRotation(0, 0, 180)
