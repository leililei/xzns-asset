local SociatyBattleModel = require("SociatyBattleModel")
local ArenaPeakModel = require("ArenaPeakModel")

---@class SociatyBattleMessageView : UIBaseView	中文描述
---@field public go_table SociatyBattleMessageView_GoTable GoTable
local SociatyBattleMessageView = _G.BaseClass("SociatyBattleMessageView", _G.UIBaseView)

function SociatyBattleMessageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local GetAutoGoTable = _G.GetAutoGoTable
local handlerbind = _G.handlerbind

---界面的入口函数
---@param data guild_fight.s2c_guild_fight_role_record
function SociatyBattleMessageView:OnCreate(data, roleInfo, isAttack, power, isSelf)
    self.go_table.toggle_def:SetActiveE(0)
    self.roleInfo = roleInfo
    self.isAttack = isAttack
    self.power = power and power or 0
    self.isSelf = isSelf
    local title
    if _G.IsNumber(roleInfo.title) then
        title = {sid = roleInfo.title}
    else
        title = roleInfo.title
    end
    _G.UIUtils.SetPlayerHeadItemNew(
        self.go_table.obj_HeadItemBase,
        {uid = roleInfo.uid, style = roleInfo.style, frame = roleInfo.frame, title = title},
        nil,
        true,
        true
    )
    if roleInfo.name ~= _G.GetLangPackValue(90010700001) then
        self.go_table.aortext_score:SetActiveE(1)
        self.go_table.aortext_name:SetLocalPosition(78, 36, 0)
        self.go_table.aortext_power:SetLocalPosition(-88, -2, 0)
        local roleUid = roleInfo.role_uid and roleInfo.role_uid or roleInfo.uid
        require("SystemSettingNet"):GetInstance():GetPlayerInfo(
                {uid = roleUid},
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    self.power = msg.info.power
                end
        )
    else
        self.go_table.aortext_name:SetLocalPosition(78, 17, 0)
        self.go_table.aortext_power:SetLocalPosition(-88, -19, 0)
        self.go_table.aortext_score:SetActiveE(0)
    end
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrBag(self.power)
    self.go_table.aortext_name.text = roleInfo.name or roleInfo.role_name
    local score = roleInfo.score and roleInfo.score or 0
    self.go_table.aortext_score.text = _G.GetLangPackValue(90021800305) .. score
    --ArenaPeakModel:GetInstance():ShowDan(self.go_table.obj_dan, nil, nil, nil, roleInfo.arena_peak_dan)
    self.recordLis = data.record_list or {}
    for _, v in pairs(self.recordLis) do
        if v.role_name == "90010700001" then --后端说加type要清档，这里暴力判断一下
            v.role_name = _G.GetLangPackValue(v.role_name)
        end
    end
    self.go_table.aortext_noText.text =
        self.isAttack and _G.GetLangPackValue(90021800360) or _G.GetLangPackValue(90021800366)
    local tb = GetAutoGoTable(self.go_table.toggle_atk)
    tb.aortext_togDesc1.text = self.isAttack and _G.GetLangPackValue(90021800351) or _G.GetLangPackValue(90021800365)
    tb.aortext_togDesc2.text = self.isAttack and _G.GetLangPackValue(90021800351) or _G.GetLangPackValue(90021800365)
    self.curPage = 1
    self.go_table.obj_no:SetActiveE(#self.recordLis == 0 and 1 or 0)
    self.go_table.scrollloopvectical_playerList:InitItemData(#self.recordLis, _G.handler(self, self.RefreshItem))
    self.go_table.toggle_atk.isOn = true
end

function SociatyBattleMessageView:RefreshItem(index, obj)
    index = index + 1
    ---@type SociatyBattleMessageView._obj_playerItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickItem, index))
    local data = _G.DeepCopy(self.recordLis[index])
    tb.obj_player:SetActiveE(self.curPage == 1 and 1 or 0)
    tb.obj_array:SetActiveE(self.curPage == 2 and 1 or 0)

    if not self.isAttack then
        for i = 1, #data.win_list do
            data.win_list[i] = not data.win_list[i]
        end
    end
    local winNum = 0
    for _, v in pairs(data.win_list) do
        if v then
            winNum = winNum + 1
        end
    end
    tb.aortext_record.text = _G.GetLangPackValue(90021800352, winNum, #data.win_list - winNum)
    if self.curPage == 1 then
        _G.UIUtils.SetPlayerHeadItemNew(
            tb.obj_HeadItemBase,
            {frame = data.frame, style = data.style, title = {sid = data.title}},
            nil,
            true,
            true
        )
        tb.aortext_name.text = data.role_name
    else
        for i = 1, 3 do
            if tb["card" .. i] then
                tb["card" .. i]:Show(data[i], nil, 24, nil, 300, nil, false)
            else
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                    tb["obj_card" .. i],
                    function(item)
                        tb["card" .. i] = item
                        item:Show(data[i], nil, 24, nil, 300, nil, false)
                    end
                )
            end
        end
    end
    tb.gameObject:SetActiveE(1)
end

function SociatyBattleMessageView:OnClickItem(go, isOn, index)
    if self.curPage == 1 then
        SociatyBattleModel:GetInstance():GetRecordDetail(
            self.recordLis[index].id,
            function(msg)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SociatyBattleAtkRecordView.Name,
                    self.roleInfo,
                    self.recordLis[index],
                    msg,
                    self.isAttack,
                    self.isSelf
                )
            end
        )
    end
end

function SociatyBattleMessageView:OnAtk(isOn)
    self:ShowToggles(self.go_table.toggle_atk, isOn)
    if not isOn then
        return
    end
    self.curPage = 1
    -- self.go_table.scrollloopvectical_playerList:UpdateCount(0)
end

function SociatyBattleMessageView:OnDef(isOn)
    self:ShowToggles(self.go_table.toggle_def, isOn)
    if not isOn then
        return
    end
    self.curPage = 2
    -- self.go_table.scrollloopvectical_playerList:UpdateCount(0)
end
---显示标签
function SociatyBattleMessageView:ShowToggles(obj, isOn)
    local item = _G.GetAutoGoTable(obj)
    item.aorimage_isOn:SetActiveE(isOn and 1 or 0)
end

---按钮点击事件在这里派发
function SociatyBattleMessageView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_atk then
        self:OnAtk(isOn)
    elseif go == self.go_table.toggle_def then
        self:OnDef(isOn)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyBattleMessageView
