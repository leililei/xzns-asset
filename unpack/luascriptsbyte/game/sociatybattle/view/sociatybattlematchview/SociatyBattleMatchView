function SociatyBattleMatchView:StartBattleTimer()
    self.BattleShowTime = require "SociatyBattleModel":GetInstance():GetEndTime()
    self.battleTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateBattleTime, self, false, false, true)
    self.battleTimer:Start()
end

function SociatyBattleMatchView:UpdateBattleTime()
    local time = self.BattleShowTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        time = 0
    end
    self.go_table.aortext_stateTime.text = _G.TimeUtil.TransLateSMCH(time)
end

function SociatyBattleMatchView:StartSeasonTimer()
    self.SeasonEndTime = require "SociatyBattleModel":GetInstance():GetSeasonEndTime()
    self.seasonTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateSeasonTime, self, false, false, true)
    self.seasonTimer:Start()
end

function SociatyBattleMatchView:UpdateSeasonTime()
    local time = self.SeasonEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        time = 0
    end
    self.go_table.aortext_seasonLeftTime.text = _G.GetLangPackValue(90021800252, _G.TimeUtil.TransLateSMCH(time))
end

function SociatyBattleMatchView:StopAllTimer()
    if self.battleTimer then
        self.battleTimer:Stop()
        self.battleTimer = nil
    end
    if self.seasonTimer then
        self.seasonTimer:Stop()
        self.seasonTimer = nil
    end
end

function SociatyBattleMatchView:EscClose()
    self:CloseView()
end

function SociatyBattleMatchView:CloseView()
    self:Close()
end

function SociatyBattleMatchView:OnDestroy()
    self:StopAllTimer()
end

return SociatyBattleMatchView
