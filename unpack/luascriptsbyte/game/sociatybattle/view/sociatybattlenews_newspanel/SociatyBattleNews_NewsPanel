---@class SociatyBattleNews_NewsPanel : Component	中文描述
---@field public go_table SociatyBattleNewsView._obj_news_GoTable GoTable
---@field data guild_fight.i_log_info[]
local SociatyBattleNews_NewsPanel = _G.BaseClass("SociatyBattleNews_NewsPanel", _G.Component)
local GetAutoGoTable = _G.GetAutoGoTable
function SociatyBattleNews_NewsPanel:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
end

---创建对象时,入口构造函数
function SociatyBattleNews_NewsPanel:OnCreate()
    self.data = require "SociatyBattleModel":GetInstance():GetLog()
    self:AddListener(_G.eSociatyBattle.SociatyBattleLog, self.addLog)
    self.go_table.scrollloopvectical_newsList:InitItemData(0, _G.handler(self, self.RefreshNewsItem))
    self.loopList = self.go_table.scrollloopvectical_newsList
    self.sociatyUid = require "SociatyBattleModel":GetInstance().sociatyUid
end
---显示界面
function SociatyBattleNews_NewsPanel:ShowView()
    local count = #self.data
    self.go_table.scrollloopvectical_newsList:UpdateCount(#self.data, count - 1)
end
---刷新战报显示
function SociatyBattleNews_NewsPanel:RefreshNewsItem(index, obj)
    local go_table = GetAutoGoTable(obj)
    local data = self.data[index + 1]
    local content, color = require "SociatyBattleManager".GetLogContent(data)
    go_table.aortext_content.text =
        _G.string.AddColor(_G.string.format("【%s】", _G.GetLangPackValue(9002060026)) .. content, color)

    _G.GameUtil.ReBuildRTF(obj)
    local _, y = obj:GetRectTransformSize()
    self.loopList:ChangeItemSize(index, y)
end
---添加日志
function SociatyBattleNews_NewsPanel:AddLog()
    self.go_table.scrollloopvectical_newsList:AddItem(1)
    local count = #self.data
    if self.go_table.scrollloopvectical_newsList:GetMaxShowIndex() >= count - 1 then
        self.go_table.scrollloopvectical_newsList:ScrollToItem(count - 1)
    end
end

return SociatyBattleNews_NewsPanel
