---@class SociatyBattleFightAwardView : UIBaseView	中文描述
---@field public go_table SociatyBattleFightAwardView_GoTable GoTable
local SociatyBattleFightAwardView = _G.BaseClass("SociatyBattleFightAwardView", _G.UIBaseView)
--_G.SociatyBattleFightAwardView = SociatyBattleFightAwardView

function SociatyBattleFightAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleFightAwardView:OnCreate()
    --local cfg = require "SociatyBattleModel":GetInstance():GetNormalCfg()
    local cfg = _G.ConfigManager.guild_battle_normal_cfg[1]
    self:ShowAward(cfg.win_rewards, self.go_table.trans_win)
    self:ShowAward(cfg.lose_rewards, self.go_table.trans_lose)
end

---显示奖励
---@param datas number[][] 奖励
---@param parent UnityEngine.Transform 父对象
function SociatyBattleFightAwardView:ShowAward(datas, parent)
    if not datas then
        return
    end
    parent:ClearChildren()
    for i = 1, #datas do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            datas[i],
            parent,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function SociatyBattleFightAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyBattleFightAwardView
