---@class SociatyBattleResultAwardView : UIBaseView	中文描述
---@field public go_table SociatyBattleResultAwardView_GoTable GoTable
local SociatyBattleResultAwardView = _G.BaseClass("SociatyBattleResultAwardView", _G.UIBaseView)
--_G.SociatyBattleResultAwardView = SociatyBattleResultAwardView

function SociatyBattleResultAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data  guild_fight.i_fight_award
function SociatyBattleResultAwardView:OnCreate(data)
    self:ShowView(data)
end
---显示界面
---@param data  guild_fight.i_fight_award
function SociatyBattleResultAwardView:ShowView(data)
    self.data = data
    if data.winner then
        self.go_table.aortext_content.text = _G.GetLangPackValue(90021800310)
    else
        self.go_table.aortext_content.text = _G.GetLangPackValue(90021800311)
    end
    self.go_table.obj_resultV:SetActiveE(self.data.winner and 1 or 0)
    self.go_table.obj_resultF:SetActiveE(self.data.winner and 0 or 1)
    ---@type guild_battle_normal_cfg
    local cfg
    for _, v in pairs(_G.ConfigManager.guild_battle_normal_cfg) do
        if v.min <= self.data.max_score and v.max >= self.data.max_score then
            cfg = v
            break
        end
    end
    if cfg then
        local rewardList = data.winner and cfg.win_rewards or cfg.lose_rewards
        --计算公会内部排名加成
        local rank, rankAddition = data.rank, 0
        for _, v in pairs(_G.ConfigManager.discrete_cfg[101652] or {}) do
            if v and #v >= 3 and rank >= v[1] and rank <= v[2] then
                rankAddition = v[3] * 0.0001
                break
            end
        end

        for _, v in ipairs(rewardList) do
            if rankAddition > 0 and #v >= 2 then
                v = _G.GlobalInterface.GetNewArray(v)
                v[2] = math.floor(v[2] * rankAddition)
            end
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                self.go_table.trans_content,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.go_table.gameObject)
                    end
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    item.go_table.gameObject:SetRectTransformSize(88, 88)
                end
            )
        end
    end
end

function SociatyBattleResultAwardView:EscClose()
    self:Close()
end

---按钮点击事件在这里派发
function SociatyBattleResultAwardView:OnClickBtn()
    self:EscClose()
end

return SociatyBattleResultAwardView
