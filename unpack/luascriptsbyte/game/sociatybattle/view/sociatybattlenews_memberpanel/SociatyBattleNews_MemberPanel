local SociatyBattleModel = require("SociatyBattleModel")
local ArenaPeakModel = require("ArenaPeakModel")

---@class SociatyBattleNews_MemberPanel : UIBaseView	中文描述
---@field public go_table SociatyBattleNewsView._obj_member_GoTable GoTable
local SociatyBattleNews_MemberPanel = _G.BaseClass("SociatyBattleNews_MemberPanel", _G.Component)
--_G.SociatyBattleNews_MemberPanel = SociatyBattleNews_MemberPanel
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local HOUR_OF_DAY = 24
local SECOND_OF_HOUR = 3600
local SECOND_OF_DAY = HOUR_OF_DAY * SECOND_OF_HOUR

function SociatyBattleNews_MemberPanel:Awake()
    self.go_table = GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param msg guild_fight.s2c_guild_fight_member_list
function SociatyBattleNews_MemberPanel:OnCreate()
    self.maxNum = require "SociatyBattleModel":GetInstance().maxChallengeNum
    self.isSelect = false
    self.go_table.scrollloopvectical_memberList:InitItemData(0, _G.handler(self, self.RefreshMemberItem))
    self:AddListener(_G.eSociatyEvent.MemberRefresh, self.Refresh)
end
---显示界面
function SociatyBattleNews_MemberPanel:ShowView()
    require "SociatyBattleNet":GetInstance():GetMemberList(
        function(msg)
            self.memberList = msg.role_list or {}
            self:SortList()
            self.go_table.scrollloopvectical_memberList:UpdateCount(#self.memberList)
        end
    )
end

---刷新
function SociatyBattleNews_MemberPanel:RefreshMemberItem(index, obj)
    index = index + 1
    ---@type _obj_member._obj_memberItem_GoTable
    local item = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local data = self.memberList[index]
    _G.UIUtils.SetPlayerHeadItemNew(
        item.obj_HeadItemBase,
        {uid = data.role_uid, style = data.style, frame = data.frame, title = {sid = data.title}},
        nil,
        true,
        true
    )
    item.aortext_name.text = data.role_name
    item.aortext_gx.text = _G.GetLangPackValue(90021800305) .. data.score
    local times = data.fight_times or 0
    item.aortext_attimes.text = _G.GetLangPackValue(90032100090, times)
    -- item.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.role_power)
    -- item.aortext_num.text = self.maxNum - data.fight_times or 0
    local content
    if data.is_online > 0 then
        local left = _G.TimeUtil.GetServerUnixTime() - data.is_online
        if left < SECOND_OF_DAY then
            content = "<color=#787877>" ..
                    GetLangPackValue(90021800065, math.max(math.floor(left / SECOND_OF_HOUR), 1))
                    .. "</color>"
        else
            content = "<color=#787877>" ..
                    GetLangPackValue(90021800066, math.min(math.floor(left / SECOND_OF_DAY), 7))
                    .. "</color>"
        end
    else
        content = GetLangPackValue(90022500846)
    end 
    item.aortext_state.text = content
    local isInbattle = SociatyBattleModel:GetInstance().IsMatched and SociatyBattleModel:GetInstance():GetState() == _G.SociatyBattleState.Battle
    item.aorbtn_message:SetActiveE(isInbattle and 1 or 0)
    --ArenaPeakModel:ShowDan(item.obj_dan, nil, nil, nil, data.arena_peak_dan)
end
---点击箭头
function SociatyBattleNews_MemberPanel:OnArrow()
    self.isSelect = not self.isSelect
    self.go_table.aorimage_arrow:SetLocalScaleXYZ(self.isSelect and -1 or 1)
    self:SortList()
    self.go_table.scrollloopvectical_memberList:UpdateCount(#self.memberList)
end
---数据排序
function SociatyBattleNews_MemberPanel:SortList()
    local scale = self.isSelect and 1 or -1
    local index
    _G.SortList(
        self.memberList,
        function(data)
            if data.is_online == 0 then
                index = 2
            else
                index = 1
            end

            return -scale * index, data.score, data.role_power, -scale * data.is_online, data.role_uid
        end
    )
end

---按钮点击事件在这里派发
function SociatyBattleNews_MemberPanel:OnClickItem(go, isOn, index)
    if SociatyBattleModel:GetInstance():GetState() ~= _G.SociatyBattleState.Battle then
        return
    end
    if SociatyBattleModel:GetInstance():GetEnemySociatyData() == nil then
        return
    end
    SociatyBattleModel:GetInstance():GetFightRecord(
        require "SociatyManager":GetInstance():GetGuildUid(),
        SociatyBattleModel:GetInstance():GetEnemySociatyData():GetUid(),
        self.memberList[index].role_uid,
        function(msg)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SociatyBattleMessageView.Name,
                msg,
                self.memberList[index],
                true,
                msg.array_power
            )
        end
    )
end

---按钮点击事件在这里派发
function SociatyBattleNews_MemberPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_arrow then
        self:OnArrow()
    end
end

return SociatyBattleNews_MemberPanel
