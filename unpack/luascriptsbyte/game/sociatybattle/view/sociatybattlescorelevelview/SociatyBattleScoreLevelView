---@class SociatyBattleScoreLevelView : UIBaseView	中文描述
---@field public go_table SociatyBattleScoreLevelView_GoTable GoTable

local SociatyBattleScoreLevelView = _G.BaseClass("SociatyBattleScoreLevelView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local AwardRate = _G.ConfigManager.discrete_cfg[101652]

function SociatyBattleScoreLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyBattleScoreLevelView:OnCreate()
    self:InitView()
end

function SociatyBattleScoreLevelView:InitView()
    self.go_table.scrollloopvectical_rank:InitItemData(#AwardRate, _G.handler(self, self.RefreshList))
end

function SociatyBattleScoreLevelView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = AwardRate[index]
    if data[1] == data[2] then
        if data[1] < 4 then
            tb.aorimage_rank:SetActiveE(1)
            tb.aortext_rank.text = ""
            tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. data[1]
        else
            tb.aorimage_rank:SetActiveE(0)
            tb.aortext_rank.text = data[1]
        end
    else
        tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rank.text = data[1] .. "-" .. data[2]
    end
    local buff = GetLangPackValue(90021800355, _G.string.format("%d%%", data[3] / 100))
    tb.aortext_buff.text = buff
end


---按钮点击事件在这里派发
function SociatyBattleScoreLevelView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SociatyBattleScoreLevelView
