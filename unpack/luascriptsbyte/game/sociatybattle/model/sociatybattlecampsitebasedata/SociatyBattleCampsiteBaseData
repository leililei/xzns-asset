---@class SociatyBattleCampsiteBaseData	公会据点基础数据
---@field id number 驻地id
---@field cfg guild_battle_campsite_cfg 驻地配置
---@field role role.i_role 驻地玩家
---@field arenaPeak_dan number 巅峰演武段位
---@field type SociatyBattleCampsiteType 驻地类型
local SociatyBattleCampsiteBaseData = _G.BaseClass("SociatyBattleCampsiteBaseData", _G.LogicClass)
---初始化其他数据
---@param msg guild_fight.i_battlefield 驻地信息
function SociatyBattleCampsiteBaseData:InitOther(msg)
    -- body
end

---解析数据
---@param msg guild_fight.i_battlefield 驻地信息
function SociatyBattleCampsiteBaseData:ParseData(msg)
    if not self.id then
        self.id = msg.b_id
        self.cfg = _G.ConfigManager.guild_battle_campsite_cfg[self.id]
        self.type = self.cfg.type
    end
    self.arenaPeak_dan = msg.arena_peak_dan or 1
    self.attack_role_name  = msg.attack_role_name
    self:InitRoleInfo(msg)
    self:InitOther(msg)
end

---初始化玩家信息
---@param msg guild_fight.i_battlefield 驻地信息
function SociatyBattleCampsiteBaseData:InitRoleInfo(msg)
    if not msg then
        return
    end
    if not self.role then
        self.role = {}
    end
    self.role.uid = msg.role_uid
    self.role.name = msg.role_name
    if self.role.uid < 1000000000 then
        self.role.name = _G.GetLangPackValue(_G.ConfigManager.guild_battle_robot_cfg[self.role.uid].name)
    end
    self.role.style = msg.style
    self.role.power = msg.role_power
    self.role.title = msg.title and {sid = msg.title}
    self.role.frame = msg.frame
end
---初始化其他数据
---@param msg guild_fight.i_battlefield 驻地信息
function SociatyBattleCampsiteBaseData:InitOther(msg)
    -- body
end

---获取buff信息
function SociatyBattleCampsiteBaseData:GetHp()
    return self.cfg.hp
end

---获取玩家信息
function SociatyBattleCampsiteBaseData:GetRoleInfo()
    return self.role
end
---获取巅峰演武段位
function SociatyBattleCampsiteBaseData:GetArenaPeakDan()
    if not self.arenaPeak_dan then
        self.arenaPeak_dan = 1
    end
    return math.max(self.arenaPeak_dan, 1)
end
---获取类型
function SociatyBattleCampsiteBaseData:GetType()
    return self.type
end

---类的析构函数
function SociatyBattleCampsiteBaseData:Dispose()
    self.id = nil
    self.cfg = nil
    self.role = nil
end

---获取消息
function SociatyBattleCampsiteBaseData:GetMsg()
    ---@type guild_fight.i_battlefield
    local tb = {}
    tb.b_id = self.id
    tb.is_breach = self.state == _G.SociatyBattleCampsiteState.Destory and 1 or 0
    tb.role_uid = self.role and self.role.uid or 0
    tb.role_name = self.role and self.role.name or ""
    tb.style = self.role and self.role.style or 0
    tb.role_power = self.role and self.role.power or 0
    tb.blood = self.hp
    return tb
end

---设置阵容
---@param msg guild_fight.s2c_guild_fight_array 阵容信息
function SociatyBattleCampsiteBaseData:SetEmbattle(msg)
    self.embattle = {}
    if msg.array_list then
        for _, v in pairs(msg.array_list) do
            self.embattle[v.arr_index] = v
            local tb = {}
            for i = 1, 5 do
                tb[i] = {card_sid = 0}
            end
            if v.card_list then
                for i = 1, #v.card_list do
                    tb[v.card_list[i].index] = v.card_list[i]
                end -- body
            end
            v.card_list = tb
        end
    end
end

---获取驻地布阵数据
---@return guild_fight.i_array[]
function SociatyBattleCampsiteBaseData:GetEmbattleDatas()
    return self.embattle
end

function SociatyBattleCampsiteBaseData:GetEmbattlePower()
    if self.embattle == nil then
        return 0
    end
    local normalcfg = require "SociatyBattleModel":GetInstance():GetNormalCfg()
    local power = 0
    for i, v in ipairs(self.embattle) do
        if i <= normalcfg.team_number then
            power = power + (v.power or 0)
        end
    end
    return power
end

return SociatyBattleCampsiteBaseData
