local base = require "SociatyBattleCampsiteBaseData"
---@class SociatyBattleCampsiteData :SociatyBattleCampsiteBaseData 公会据点信息
---@field hp number 驻地血量
---@field type SociatyBattleCampsiteType 驻地类型
---@field cfg guild_battle_campsite_cfg 驻地配置
---@field state SociatyBattleCampsiteState 驻地状态
---@field id number 驻地id
---@field role role.i_role 驻地玩家
---@field enemy guild_fight.i_array[] 地方志荣
---@field attackTime number 上次进攻时间戳
local SociatyBattleCampsiteData = _G.BaseClass("SociatyBattlePointData", base)

---@param msg guild_fight.p2c_guild_fight_send_station
---@return boolean 结果
function SociatyBattleCampsiteData:ParseChange(msg)
    --防止服务器因网络延迟导致后打的信息先到了
    if self.attackTime and self.attackTime > msg.station.attack_time then
        return
    end
    self.hp = msg.station.hp

    self.attackTime = msg.station.attack_time
    self.attack_role_name = msg.station.attack_role_name
    if self.hp <= 0 then
        self:SetState(_G.SociatyBattleCampsiteState.Destory)
    end
end

---初始化其他数据
---@param msg guild_fight.i_battlefield 驻地信息
function SociatyBattleCampsiteData:InitOther(msg)
    self.hp = msg.blood
    self.attackTime = msg.last_attack_time or 0
end

---获取buff信息
function SociatyBattleCampsiteData:GetBuff()
    return self.cfg.effect
end

---获取hp
function SociatyBattleCampsiteData:GetHp()
    return self.hp
end

---更改血量
---@param result boolean 是否胜利
function SociatyBattleCampsiteData:ChangeHp(result)
    local reduceHp, baseReduceHp = self:GetReduceHp(result)
    self.hp = _G.math.max(self.hp - reduceHp, 0)
    if self.hp <= 0 then
        self:SetState(_G.SociatyBattleCampsiteState.Destory)
        self.attack_role_name = _G.PlayerModel:GetInstance().role_name
    end
    return reduceHp, baseReduceHp
end

---获取减少生命值
---@return number, number 总扣血，基础扣血
function SociatyBattleCampsiteData:GetReduceHp(result)
    local loseNum = 0
    local winNum = 0
    for _, v in ipairs(result) do
        if v then
            winNum = winNum + 1
        else
            loseNum = loseNum + 1
        end
    end
    local hpData = self.cfg.win_points[winNum + 1]
    local hp = _G.Mathf.RoundToInt(hpData[1] / (1 + hpData[2] / 10000))
    return hpData[1], hp
end

---获取减少生命百分比
---@return number
function SociatyBattleCampsiteData:GetReduceHpPer(result)
    local loseNum = 0
    local winNum = 0
    for _, v in ipairs(result) do
        if v then
            winNum = winNum + 1
        else
            loseNum = loseNum + 1
        end
    end
    return self.cfg.win_points[winNum + 1][1] / self.cfg.hp
end

---设置驻地状态
function SociatyBattleCampsiteData:SetState(state)
    self.state = state
end

---获取驻地状态
---@return SociatyBattleCampsiteState 驻地状态
function SociatyBattleCampsiteData:GetState()
    return self.state
end

---获取上次进攻时间
function SociatyBattleCampsiteData:GetAttackTime()
    return self.attackTime
end

--endregion

return SociatyBattleCampsiteData
