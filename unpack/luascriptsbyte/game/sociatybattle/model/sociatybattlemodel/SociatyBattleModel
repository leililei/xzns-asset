    tab.role_info = {uid = 0}
    tab.union_id = log.guild_uid
    tab.args = log.args
    tab.type = _G.ChatInfoType.system
    local titleLang = log.guild_uid == self.sociatyUid and 90021800336 or 90021800337
    tab.unionbattle = _G.LangUtil.GetLangPackValue(titleLang)
    local content, color = require "SociatyBattleManager".GetLogContent(log)
    tab.n_content = _G.string.AddColor(content, color)
    return tab
