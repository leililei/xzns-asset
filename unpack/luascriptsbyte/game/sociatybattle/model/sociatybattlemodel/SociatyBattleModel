function SociatyBattleModel:SetMark(id, isSelf)
    local last = self.markid or -1
    if self.tempMark == id then
        self.markid = -1
    else
        self.markid = id
    end
    self.tempMark = nil
    if not isSelf then
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.SociatyBattleMark, self.markid, last)
    else
        _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.SociatyBattleMarkSelf, self.markid, last)
    end
