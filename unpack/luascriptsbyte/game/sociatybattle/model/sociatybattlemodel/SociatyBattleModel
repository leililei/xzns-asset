---获取据点数据
---@param uid number 公会uid
---@param id number 驻地uid
---@param roleUid number 玩家uid
function SociatyBattleModel:GetCampsiteData(uid, id, roleUid, call)
    local sociatybattleData = self:GetSelfScoaityData()
    if uid ~= self.sociatyUid then
        sociatybattleData = self:GetEnemySociatyData()
    end
    local campsiteData = sociatybattleData:GetCampsiteData(id)
    local role = campsiteData:GetRoleInfo()
    if role.uid < 1000000000 then
        ---@type guild_fight.s2c_guild_fight_array
        local msg2 = {}
        msg2.array_list = {}
        ---@type guild_battle_robot_cfg
        local cfg = _G.ConfigManager.guild_battle_robot_cfg[role.uid]
        ---@type att_equity_cfg
        local attEquity = _G.ConfigManager.att_equity_cfg[7]
        if cfg then
            ---@type guild_fight.i_array
            local tb
            for i, v in ipairs(cfg.monsters_id) do
                tb = {}
                tb.arr_index = i
                tb.card_list = {}
                local power = 0
                for i2, v2 in ipairs(v) do
                    ---@type guild_fight i_array_card
                    local card = {}
                    local cardCfg = _G.ConfigManager.card_cfg[v2]
                    card.index = i2
                    card.card_sid = v2
                    tb.card_list[i2] = card
                    if cardCfg then
                        card.card_lv = attEquity.level
                        card.star = attEquity.star
                        card.soul_lv = attEquity.card_exclusive_lv
                        card.born_skill_num = attEquity.talent
                        card.soul_state = attEquity.card_exclusive
                        local data = _G.CardData.New()
                        local open_inborn = {}
                        if cardCfg and card.born_skill_num > 0 then
                            local index = 0
                            for k = 1, #cardCfg.talent do
                                for j = 1, #cardCfg.talent[k] do
                                    index = index + 1
                                    open_inborn[index] = cardCfg.talent[k][j]
                                    if index >= card.born_skill_num then
                                        break
                                    end
                                end
                                if index >= card.born_skill_num then
                                    break
                                end
                            end
                        end
                        local equipment
                        if attEquity.equip_grade > 0 then
                            equipment = {}
                            local count = _G.table.count(_G.EquipmentPart)
                            for e = 1, count do
                                if e ~= 3 then
                                    ---@type prop.i_equipment
                                    local data2 = {}
                                    data2.sid =
                                        201000000 + attEquity.equip_grade + cardCfg.EquipmentType * 1000 + e * 100
                                    data2.uid = 0
                                    data2.streng = attEquity.equip_stren
                                    data2.exp = 0
                                    if attEquity.equip_ele > 0 then
                                        data2.element = cardCfg.Elements
                                    else
                                        data2.element = 0
                                    end

                                    data2.reset_element = 0
                                    _G.table.insert(equipment, data2)
                                end
                            end
                        end
                        local artifactList = {}
                        if attEquity.artifact_grade > 0 then
                            local artifact = {}
                            artifact.sid = 255000100 + 100000 * attEquity.artifact_grade + 10000 * cardCfg.Professional
                            artifact.uid = 0
                            artifact.num = 1
                            artifact.level = attEquity.artifact_level
                            artifact.star = attEquity.artifact_star
                            artifact.awaken = 0
                            artifactList[1] = artifact
                        end

                        ---觉醒等级
                        local tempawaken_lv =
                            require "CardInfoManager":GetInstance():GetAttPotential(attEquity.potential_lv)

                        data:Parse(
                            {
                                uid = v2,
                                sid = v2,
                                star = card.star,
                                soul_chain_lv = card.soul_lv,
                                soul_state = card.soul_state,
                                lv = card.card_lv,
                                open_inborn = open_inborn,
                                equipments = equipment,
                                artifact = artifactList,
                                awaken_lv = tempawaken_lv
                            }
                        )
                        data:OnInitMutuallyData(true)
                        data:CalcNowSumProp()
                        power = power + data:GetPower()
                    end
                end
                tb.skill_index = cfg.combine[i] or {0, 0, 0}

                tb.power = power
                msg2.array_list[i] = tb
            end
        end
        campsiteData:SetEmbattle(msg2)
        if call then
            call(campsiteData)
        end
    else
        local msg = {
            role_uid = roleUid,
            guild_uid = uid
        }
        SociatyBattleNet:GetInstance():GetCampsiteInfo(
            msg,
            function(msg2)
                campsiteData:SetEmbattle(msg2)
                if call then
                    call(campsiteData)
                end
            end
        )
    end
end
