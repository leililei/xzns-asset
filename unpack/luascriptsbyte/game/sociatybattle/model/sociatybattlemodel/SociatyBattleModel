---战斗结束
---@param result boolean 结果
function SociatyBattleModel:BattleEnd()
    local result = require "SociatyBattleManager":GetInstance().fightMsg.winner
    self.challengeNum = self.challengeNum - 1
    local campsiteData = self:GetEnemySociatyData():GetCampsiteData(self.fightCampsiteId)
    local soicaty = require "SociatyModel":GetInstance().SociatySelf

    --local JoinTime = soicaty.GetMemberModule():GetSelfMember().JoinTime

    self.score = self.score + campsiteData.cfg.contribute[1]
    local time = _G.TimeUtil.GetServerUnixTime()
    if time - soicaty.CreateTime >= 86400 then --or time - JoinTime >= 86400 then
        self.changeScore = 0
        local isAllZero = require("SociatyBattleManager"):GetInstance():CheckCampsiteZero()
        if not isAllZero then
            self.changeScore = self:GetSelfScoaityData():SetAttackResult(self.fightCampsiteId, result)
        else
            self.changeScore = self:GetSelfScoaityData():SetAttackResult(self.fightCampsiteId, result, true)
        end
        self.isZero = campsiteData:GetHp() <= 0 --进攻空驻地

        self.changeHp, self.changeBaseHp =
            self:GetEnemySociatyData():SetDefendResult(self.fightCampsiteId, result, not isAllZero)
    else
        self.changeHp = 0
        self.changeBaseHp = 0
        self.changeScore = 0
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.SociatyBattleBattle)
    require "RedPointManager":GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleRewards].id
    )
    require "RedPointManager":GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleContribute].id
    )
end

---增加赛季效果(次数)
function SociatyBattleModel:AddExtraFightTimes()
    local times = 0
    local isOpen = require "SociatyBattleLeagueModel":GetInstance():GetLeagueIsOpen()
    if self.ExtraFightTimes == nil and isOpen == true then
        local cfg = require "SociatyBattleLeagueModel":GetInstance():GetSeasonCfg()
        for k, v in ipairs(cfg.store_battle_pass) do
            local data = cfg.UseParameter[k]
            if v == 2 then
                for _, v in pairs(_G.ConfigManager.guild_battle_campsite_cfg) do
                    if v.type >= 2 then
                        local dataCampsite = self:GetSelfScoaityData():GetCampsiteData(v.id)
                        if dataCampsite.role.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                            if data[1] == 1 then
                                times = times + data[2]
                            elseif data[1] == 2 then
                                times = times - data[2]
                            end
                            break
                        end
                    end
                end
            end
        end
        self.maxChallengeNum = self.maxChallengeNum + times
        self.ExtraFightTimes = true
    end
    return times
end

---增加赛季效果（积分）
function SociatyBattleModel:AddExtraSorce()
    local score = self.changeScore
    local isOpen = require "SociatyBattleLeagueModel":GetInstance():GetLeagueIsOpen()
    if isOpen == true then
        local cfg = require "SociatyBattleLeagueModel":GetInstance():GetSeasonCfg()
        local num = 0
        for k, v in ipairs(cfg.store_battle_pass) do
            local data = cfg.UseParameter[k]
            if v == 1 then
                local fightTimes = self.maxChallengeNum - self.challengeNum
                if fightTimes <= data[1] then
                    score = score * data[2] / 10000
                end
            elseif v == 2 then
                for _, v in pairs(_G.ConfigManager.guild_battle_campsite_cfg) do
                    if v.type >= 2 then
                        local dataCampsite = self:GetSelfScoaityData():GetCampsiteData(v.id)
                        if dataCampsite.role.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                            score = score * data[3] / 10000
                            break
                        end
                    end
                end
            elseif v == 4 and self.isZero == false then
                for _, v in pairs(_G.ConfigManager.guild_battle_campsite_cfg) do
                    if v.type == data[2] then
                        local dataCampsite = self:GetEnemySociatyData():GetCampsiteData(v.id)
                        if dataCampsite:GetHp() <= 0 then
                            num = num + 1
                        end
                    end
                end
                local campsiteData = self:GetEnemySociatyData():GetCampsiteData(self.fightCampsiteId)
                if
                    num >= data[1] and _G.ConfigManager.guild_battle_campsite_cfg[self.fightCampsiteId].type ~= 2 and
                        campsiteData:GetHp() <= 0
                 then
                    score = score + data[3]
                end
            elseif v == 6 then
                --镇魂街ZHJ-38762 【主任务】”SP夏铃“主题天下联赛赛季ZHJ-38770
                --【后端】天下联赛赛季新增赛季效果”6“
                --按少上阵人头数积分页分比增加
                local sr = 0
                for i = 1, 5 do
                    local array = self:GetAttackGarray(i).array

                    local sra = 3
                    for j = 1, #array do
                        if array[j] > 0 then
                            sra = sra - 1
                        end
                    end
                    if sra < 0 then
                        sra = 0
                    end
                    sr = sr + sra
                end

                if sr > 0 then
                    score = score + sr * data[1] / 10000 * score
                end
            end
        end
    end
    return score - self.changeScore
end

