---初始化匹配信息
---@param msg guild_fight.i_guild_match_info
function SociatyBattleModel:InitMatchInfo(msg)
    if not msg then
        self.curDay = 0
        return
    end
    self.IsMatched = true
    --self.isApply = true
    for _, v in ipairs(msg.guild) do
        if v.guild_uid ~= self.sociatyUid then
            if not self.enemySociatyBattleData then
                self.enemySociatyBattleData = require "SociatyBattleData".New()
            end
            self.enemySociatyBattleData:ParseSociatyData(v)
        else
            if not self.mySociatyBattleData then
                self.mySociatyBattleData = require "SociatyBattleData".New()
            end
            self.mySociatyBattleData:ParseSociatyData(v)
        end
    end
    self.battleTime = msg.start_time or 0
    self.curDay = math.min(_G.TimeUtil.GetIntervalDay(self.battleTime, _G.TimeUtil.GetServerUnixTime()) + 1, 3)
    self:InitNormalCfg(msg)
end
