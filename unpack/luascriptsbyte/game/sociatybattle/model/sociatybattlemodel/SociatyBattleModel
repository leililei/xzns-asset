---获取数据
function SociatyBattleModel:GetInfo(call)
    if _G.PlayerModel:GetInstance().main_open_time == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("<color=red><size=20>" .. "未分配赛区，公会战不能打开，分配赛区后再试（本条为提示日志非报错）" .. "</size></color>")
        end
        return
    end
    if not require "SociatyManager":GetInstance():HasSociaty() then
        self.super.ParseData(self)
        self:RefreshEnterRedPoint()
        require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleRewards].id
        )
        require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleContribute].id
        )
        return
    end

    local sbot = require("SociatyBattleManager"):GetInstance():GetSociatyBattleOpenTime()
    local residue = sbot - _G.TimeUtil.GetServerUnixTime()
    residue = math.ceil(residue / 86400) - 1
    if residue > 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=20>" .. "公会战未开始，不能拿数据" .. "</size></color>")
        end
        return
    end
    SociatyBattleNet:GetInstance():GetInfo(
        {uid = require "SociatyManager":GetInstance():GetGuildUid()},
        _G.handlerbind(self, self.GetInfoCall, call)
    )
end

---获取信息回调
---@param msg guild_fight.s2c_guild_fight_info
function SociatyBattleModel:GetInfoCall(msg, call)
    self:ParseData(msg)
    if call then
        call()
    end
end

---解析数据
---@param msg guild_fight.s2c_guild_fight_info
function SociatyBattleModel:ParseData(msg)
    if msg.is_open == 1 or not msg.season_info then
        ---事件未到不能初始化
        self.state = StateType.None
        self:InitTime(true)
        return
    end
    self.sociatyUid = require "SociatyManager":GetInstance():GetGuildUid()
    self:InitSeason(msg.season_info)
    self:InitRoleFightInfo(msg.role_guild_fight_info)
    --self:InitApply(msg.fight_info)
    if self.state == StateType.Settlement then
        self.IsMatched = false
        msg.math_info = nil
    end
    self:InitMatchInfo(msg.math_info)
    self:InitLog()
    self:InitBattleAward()
    if msg.math_info then
        self:GetDefendGarrayData(
            function()
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleDefend].id
                )
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleFirst].id
                )
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleRewards].id
                )
                require "RedPointManager":GetInstance():RefreshNode(
                    _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleContribute].id
                )
            end
        )
    else
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleDefend].id
        )
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
            _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleFirst].id
        )
        require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleRewards].id
        )
        require "RedPointManager":GetInstance():RefreshNode(
            _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleContribute].id
        )
    end

    _G.SystemSettingManager:GetInstance():GetOtherPlayerData(
        _G.PlayerModel:GetInstance():GetPlayerUid(),
        function(msg2)
            self.background_id = msg2.background_id
        end
    )
    _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.ScoiatyBattleChallengeNum)
    _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.SociatyBattleState)
    self.super.ParseData(self)
end

