---贡献奖励
function SociatyBattleModel:CheckRedPointMatch()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end
    if self.seasonCfg == nil then
        return false
    end
    local cfgs = _G.ConfigManager.guild_battle_reward_cfg
    local cfg
    local score = self:GetSorce()
    if nil ~= self.seasonCfg then
        for _, v in ipairs(self.seasonCfg.reward_season) do
            cfg = cfgs[v]
            if cfg.conditions[1] <= score and not self:CheckGetAward(v) then
                return true
            end
        end
    end
    return false
end

---对战奖励
function SociatyBattleModel:CheckRedPointAward()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end
    if self.battleAwardList then
        for _, v in ipairs(self.battleAwardList) do
            if v.state == 0 then
                return true
            end
        end
    end
    return false
end

---检测首次进红点
function SociatyBattleModel:CheckRedPointFirst()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end
    if self.state == StateType.Battle then
        if _G.PlayerPrefsManager.HasKey(Key) then
            local time = _G.PlayerPrefsManager.GetFloat(Key)
            return _G.TimeUtil.GetInterValDayByGame(time, _G.TimeUtil.GetServerUnixTime()) > 0
        else
            return true
        end
    end
end

---检测防守阵容
---@param type number 红点类型
function SociatyBattleModel:CheckRedPointTeam()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end

    local total = _G.StorageManager:GetInstance():CheckCanEmbattleCardCount()
    local isok = false
    local isemnum = 0
    if self.defendGrrayDic then
        for _, v in pairs(self.defendGrrayDic) do
            local isHaveNum = 0
            if v.array then
                for _, v2 in pairs(v.array) do
                    if _G.IsNumber(v2) then
                        if v2 > 0 then
                            isHaveNum = isHaveNum + 1
                            isemnum = isemnum + 1
                        end
                    else
                        if v2.uid > 0 then
                            isHaveNum = isHaveNum + 1
                            isemnum = isemnum + 1
                        end
                    end
                end
                if isHaveNum < 3 then
                    isok = true
                end
            else
                isok = true
            end
        end
    end
    return isok and total > isemnum
end

---刷新挑战红点
function SociatyBattleModel:RefreshEnterRedPoint()
    local key = self.state == StateType.Battle and Key or ApplyKey
    _G.PlayerPrefsManager.SetFloat(key, _G.TimeUtil.GetServerUnixTime())
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleFirst].id
    )
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleDefend].id
    )
    require "RedPointManager":GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleRewards].id
    )
    require "RedPointManager":GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleContribute].id
    )
end
---设置攻击事件
function SociatyBattleModel:SetAttackTime(time)
    self:GetEnemySociatyData():GetCampsiteData(self.fightCampsiteId).attackTime = time
end
---驻地变化
---@params msg guild_fight.p2c_guild_fight_send_station
function SociatyBattleModel:OnCampsiteChangeData(msg)
    local sociatyData =
        msg.station.guild_uid == self.sociatyUid and self:GetSelfScoaityData() or self:GetEnemySociatyData()
    sociatyData:SetP2CCampsiteChange(msg)
    sociatyData = msg.station.guild_uid ~= self.sociatyUid and self:GetSelfScoaityData() or self:GetEnemySociatyData()
    sociatyData:SetAttackResult(msg.station.b_id, msg.station.winner)
    _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.RefreshSociatyBattleCampsite, msg.station.b_id)
end

--region 编队

---获取编队数据
function SociatyBattleModel:GetEmbattleData(call)
    SociatyBattleNet:GetInstance():SignEmbattlData(
        {type = 1},
        function(msg)
            if msg.role_uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(250121)
                return
            end
            SociatyBattleNet:GetInstance():GetEmbattlData(
                {guild_uid = self.sociatyUid},
                function(msg)
                    self.mySociatyBattleData:InitEmbattle(msg)
                    if call then
                        call()
                    end
                end
            )
        end
    )
end
---刷新防守红点
function SociatyBattleModel:RefreshDefendRed()
    if self.defendTimer then
        return
    end
    self.defendTimer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshDefendRed2, self, true, true, true)
    self.defendTimer:Start()
end

function SociatyBattleModel:RefreshDefendRed2()
    self.defendTimer = nil
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg[RedPointKey.GuildBattleDefend].id
    )
end

---保存编队阵容
function SociatyBattleModel:SaveEmbattleData(data, call)
    local msg = {guild_uid = self.sociatyUid, battlefield_list = data}
    SociatyBattleNet:GetInstance():SaveEmbattlData(
        msg,
        function(msg2)
            if msg2.ack ~= 1 then
                return
            end

            if call then
                call()
            end
            SociatyBattleNet:GetInstance():SignEmbattlData({type = 0})
        end
    )
end
