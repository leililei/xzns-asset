function SociatyBattleModel:SaveDefendGarray(garray, skill, pets, call, beasts)
    local snedMsg = {update_array_list = {}}
    local isAdd
    local tb
    for i, v in ipairs(garray) do
        isAdd = false
        tb = {}
        tb.arr_index = i
        tb.card_list = {}
        tb.pet = pets[i] or {0, 0, 0}
        if _G.AppSetting.IsXzns then
            tb.beast = beasts[i] or {0, 0, 0}
        end
        tb.skill_index = skill[i] or {0, 0, 0}
        for k, v2 in ipairs(v) do
            if v2 > 0 then
                isAdd = true
                _G.table.insert(tb.card_list, {index = k, card_uid = v2})
            end
        end
        if isAdd then
            _G.table.insert(snedMsg.update_array_list, tb)
        end
    end
    SociatyBattleNet:GetInstance():SetDefendGarray(
        snedMsg,
        function(msg)
            if msg.ack ~= 1 then
                if call then
                    call(-1)
                end
                return
            end
            if call then
                call(0)
            end
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
            self:GetDefendGarrayData(
                function()
                    self:RefreshDefendRed()
                end
            )
        end
    )
end

