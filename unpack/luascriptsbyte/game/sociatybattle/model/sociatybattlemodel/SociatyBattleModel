---获取奥山之战是否开启，如果没有开启，则返回提示字符串
---@return boolean,string|nil
function SociatyBattleModel:GetFuncIsOpen()
    local isOpen,str = true,""
    local funcCfg = _G.ConfigManager.function_open_cfg[self.curFunctionOpenID]
    local type, params
    for _, v in pairs(funcCfg.condition_type) do
        if v[1] == 4 then
            type = v[1]
            params = v[2]
        end
    end
    if not _G.GlobalConditionManager.CheckMainEventCondition(type,params) then
        str = _G.FunctionManager:GetInstance():GetStrWithType(type, params)
        isOpen = false
    end
    local time =
        require("SociatyBattleManager"):GetInstance():GetSociatyBattleOpenTime()
        - _G.TimeUtil.GetServerUnixTime()
    if time > 0 then
        if str ~= "" then
            str = str .. _G.GetLangPackValue(9002010024)
                .. _G.GetLangPackValue(90028300082, _G.TimeUtil.TranslateSecondForStr(time))
        else
            str = _G.GetLangPackValue(90028300082, _G.TimeUtil.TranslateSecondForStr(time))
        end
            isOpen = false
    end
    return isOpen, str
end

