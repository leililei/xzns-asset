---初始化时间
function SociatyBattleModel:InitTime(isInit)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    local time = _G.TimeUtil.GetServerUnixTime()
    local startTime = _G.TimeUtil.GetDayBegin(time)
    ---判断
    local jo = require "SociatyBattleManager":GetInstance():GetBasePair()

    if not isInit then
        self.state = StateType.None
        self.nexTime = 0
        local id = DiscreteIDs.Time[jo]
        local timeParams = _G.ConfigManager.discrete_cfg[id]
        ---0点开始算差值时间，用来判断是否在阶段范围内
        local czTime = time - startTime
        local isCur = false
        for k, v in ipairs(timeParams) do
            if v[2] * 3600 <= czTime and v[3] * 3600 > czTime then
                self.state = v[1]
                if timeParams[k + 1] then
                    self.nexTime = startTime + timeParams[k + 1][2] * 3600
                end
                self.startTime = startTime + v[2] * 3600
                break
            end
            if v[3] * 3600 > czTime then
                isCur = true
            end
        end
        if self.nexTime <= 0 then
            if isCur then
                timeParams = _G.ConfigManager.discrete_cfg[DiscreteIDs.Time[jo]]
                self.nexTime = startTime + timeParams[1][2] * 3600
                self.startTime = startTime
            else
                local newJdId
                if jo == 1 then
                    newJdId = 2
                elseif jo == 2 then
                    newJdId = 1
                end
                timeParams = _G.ConfigManager.discrete_cfg[DiscreteIDs.Time[newJdId]]
                self.nexTime = startTime + 86400 + timeParams[1][2] * 3600
                self.startTime = startTime + 86400
            end
        end
        if self.state == StateType.None then
            self.state = StateType.Match
        end
    else
        self.nexTime = startTime + 86400
    end
    --self.realState = self.state
    self.timer = _G.TimerManager:GetInstance():GetTimer(self.nexTime - time + 1, self.OnTimerOver, self, true)
    self.timer:Start()
end

