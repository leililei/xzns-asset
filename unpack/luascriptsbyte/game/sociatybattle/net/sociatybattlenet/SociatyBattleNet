---报名推送
---@param msg guild_fight.p2c_guild_fight_send_sign_station
function SociatyBattleNet:OnP2CAppkly()
    require "SociatyBattleModel":GetInstance().isApply = true
    _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.SociatyBattleApply, true)
end

---自动报名推送
---@param msg guild_fight.p2c_guild_fight_send_auto_application
function SociatyBattleNet:OnP2CAutoApply(msg)
    require "SociatyBattleModel":GetInstance().isAutoApply = msg.State == 1
    _G.Events:GetInstance():Broadcast(_G.eSociatyBattle.SociatyBattleAutoApply)
end

