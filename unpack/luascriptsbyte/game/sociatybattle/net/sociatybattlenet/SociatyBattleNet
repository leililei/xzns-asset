local base = require "BaseGameNet"
---@class SociatyBattleNet : BaseGameNet	通信协议
local SociatyBattleNet = _G.BaseClass("SociatyBattleNet", base)

---添加所有后端主动推的网络消息监听接口
function SociatyBattleNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.game_guild_fight_send_log.Cmd, self.OnP2CLog)
    self:AddMessageListener(_G.ConfigManager.net_map.game_guild_fight_send_station.Cmd, self.OnP2CCampsite)
    self:AddMessageListener(_G.ConfigManager.net_map.game_guild_fight_send_application.Cmd, self.OnP2CAppkly)
    self:AddMessageListener(_G.ConfigManager.net_map.game_guild_fight_send_auto_application.Cmd, self.OnP2CAutoApply)
    self:AddMessageListener(_G.ConfigManager.net_map.game_guild_fight_send_sign_station.Cmd, self.OnP2CMark)
end

---@return SociatyBattleNet SociatyBattleNet
function SociatyBattleNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---发送信息
function SociatyBattleNet:SendMsg(pbData, item, callback)
    if not pbData then
        pbData = self:GetEmptyPB()
    end
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function SociatyBattleNet:GetInfo(pbData, callback)
    self:SendMsg(pbData, _G.ConfigManager.net_map.game_guild_fight_info, callback)
end

