---@class TransitionGuidedDiaryView : UIBaseView    中文描述
---@field public go_table TransitionGuidedDiaryView_GoTable GoTable
local TransitionGuidedDiaryView = _G.BaseClass("TransitionGuidedDiaryView", _G.UIBaseView)

---构造函数
---@protected
function TransitionGuidedDiaryView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TransitionGuidedDiaryView:OnCreate(activityClass, call)
    self.call = call
    self.activityClass = activityClass
    self.typeClass = activityClass.typeClass
    self.spellCode = self.typeClass:GetOfficialAccount() or "关注公众号关注公众号"
    self.spellCode = _G.string.getStringCharArr(self.spellCode)
    self.maxLen = #self.spellCode
    self.isTurning = false
    self.curIndex = 0
    self.wordindex=0
    for i = 1, self.maxLen do
        if self.go_table["aortext_spell" .. i] ~= nil then
            self.go_table["aortext_spell" .. i].text = self.spellCode[i]
        end
    end
    self:InitView()
end

function TransitionGuidedDiaryView:InitView()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OpenNext, self, false, false, true)
    self.timer:Start()
    self:OpenNext()
    self:ShowAward()
end

---初始化页面
function TransitionGuidedDiaryView:OpenNext()
    if self.curIndex >= self.maxLen then
        self.canClose = true
    end

    self.curIndex = self.curIndex + 1
    self.wordindex=self.wordindex+1
    if self.wordindex> self.maxLen then
        self.wordindex=1
    end
    for i = 1, self.maxLen do
        if self.go_table["aortext_spell" .. i] ~= nil then
            self.go_table["aortext_spell" .. i]:SetActiveE(self.wordindex == i and 1 or 0)
        end
    end
end

function TransitionGuidedDiaryView:ShowAward()
    local award = _G.ConfigManager.discrete_cfg[135012]
     for j = 1, #award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award[j],
            self.go_table.obj_AwardNode,
            function(item)
                if self:IsNil() then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                if item.cfg then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---界面的销毁函数
function TransitionGuidedDiaryView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---
---@protected
function TransitionGuidedDiaryView:CloseView()
    if self.call then
        self.call()
    end
    self:Close()
end

---按钮点击事件在这里派发
function TransitionGuidedDiaryView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.canClose then
            self:CloseView()
        end
    elseif go == self.go_table.aorbtn_share then
        --_G.CS.UnityEngine.GUIUtility.systemCopyBuffer = self.typeClass:GetOfficialAccount()
        local strcount =self.typeClass:GetOfficialAccount()
        local count=string.getStringCharCount(strcount)
        strcount=string.utf8sub(strcount,count-4,5)
        _G.GameUtil.CopyContent(strcount)
        _G.PopWindowManager:GetInstance():ShowAllTips(1150002)
    end
end

return TransitionGuidedDiaryView