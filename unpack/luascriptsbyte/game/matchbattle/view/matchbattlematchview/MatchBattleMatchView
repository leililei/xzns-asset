local MatchBattleManager = require "MatchBattleManager"

local timeImageNames = {
    SpriteNames = {
        ["0"] = "red0",
        ["1"] = "red1",
        ["2"] = "red2",
        ["3"] = "red3",
        ["4"] = "red4",
        ["5"] = "red5",
        ["6"] = "red6",
        ["7"] = "red7",
        ["8"] = "red8",
        ["9"] = "red9"
    }
}

---@class MatchBattleMatchView : UIBaseView	中文描述
---@field public go_table MatchBattleMatchView_GoTable GoTable
local MatchBattleMatchView = _G.BaseClass("MatchBattleMatchView", _G.UIBaseView)
function MatchBattleMatchView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.waitTimeImages = {self.go_table.aorimage_mathTime}
    self.successTimeImages = {self.go_table.aorimage_time}
end

---界面的入口函数
function MatchBattleMatchView:OnCreate()
    MatchBattleManager:GetInstance():Match()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_match, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_matchsuccess, false)
    self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
    self.waitTimer:Start()
    self.waitTime = 0
    self:ShowWaitTime()
end

function MatchBattleMatchView:OnDestroy()
    self.waitTime = nil
    if self.waitTimer then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end
    self.waitTimeImages = nil
    self.successTimeImages = nil
end

---按钮点击事件在这里派发
function MatchBattleMatchView:OnClickBtn(go)
    MatchBattleManager:GetInstance():CancelMatch()
    self:Close()
end

function MatchBattleMatchView:ShowWaitTime(elapsed)
    _G.UIUtils.SetImageFont(self.waitTimeImages, _G.tostring(Mathf.RoundToInt(self.waitTime)), timeImageNames)
    self.waitTime = self.waitTime + (elapsed or 1)
end

function MatchBattleMatchView:ShowMatchSuccesView()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_match, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_matchsuccess, true)
end

function MatchBattleMatchView:ShowJoinTime(time)
    _G.UIUtils.SetImageFont(self.successTimeImages, _G.tostring(time), timeImageNames)
end

return MatchBattleMatchView
