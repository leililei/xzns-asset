local barLength = 108
local barHeoght = 6.86
local MatchBattleStatisticsHeroItem = _G.BaseClass("MatchBattleStatisticsHeroItem")
function MatchBattleStatisticsHeroItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end
function MatchBattleStatisticsHeroItem:Dispose()
    self.go_table = nil
end
function MatchBattleStatisticsHeroItem:Show(data, max)
    self.Uid = _G.Mathf.Floor(data.Uid / 10)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.levelItem,
        self.go_table.trans_card,
        _G.handler(self, self.OnItemCall)
    )
    self.go_table.rect_attack:SetRectTransformSize(barLength * data.DmgOut / max.DmgOut, barHeoght)
    self.go_table.rect_defence:SetRectTransformSize(barLength * data.DmgIn / max.DmgIn, barHeoght)
    self.go_table.rect_cure:SetRectTransformSize(barLength * data.HpRecover / max.HpRecover, barHeoght)
    self.go_table.aortext_attack.text = _G.GameUtil.NumberToUnitStr(data.DmgOut)
    self.go_table.aortext_defence.text = _G.GameUtil.NumberToUnitStr(data.DmgIn)
    self.go_table.aortext_cure.text = _G.GameUtil.NumberToUnitStr(data.HpRecover)
end
function MatchBattleStatisticsHeroItem:OnItemCall(card)
    self.cardItem = card
    local cfg = _G.ConfigManager.arena_equity_card_cfg[self.Uid]
    self.cardItem:Show(cfg.CardID, nil, cfg.Stars, cfg.Level, self.Uid, cfg.soulLink_lv)
    self.cardItem.transform:SetLocalPositionToZero()
    self.Uid = nil
end
--endregion

