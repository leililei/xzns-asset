local MatchBattleStatisticsItem = _G.BaseClass("MatchBattleStatisticsItem")
local resultBgName = {win = "ui-cz-bg-zhanlidihong", lose = "ui-cz-bg-zhanlidilan"}
local resultTagName = {win = "ui_zdpp_txt_sheng", lose = "ui_zdpp_txt_bai"}
function MatchBattleStatisticsItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self.dataItem = {
        MatchBattleStatisticsHeroItem.New(self.go_table.obj_single1),
        MatchBattleStatisticsHeroItem.New(self.go_table.obj_single2),
        MatchBattleStatisticsHeroItem.New(self.go_table.obj_single3),
        MatchBattleStatisticsHeroItem.New(self.go_table.obj_single4),
        MatchBattleStatisticsHeroItem.New(self.go_table.obj_single5),
        MatchBattleStatisticsHeroItem.New(self.go_table.obj_single6)
    }
end
function MatchBattleStatisticsItem:Dispose()
    self.go_table = nil
    for i = 1, #self.dataItem do
        self.dataItem:Dispose()
    end
    self.dataItem = nil
end
---展示数据
---@param baseinfo table 基础信息
---@param data table 统计数据
---@param isleft boolean 是否显示在左边
---@param max table 最大值
function MatchBattleStatisticsItem:Show(baseinfo, data, isleft, max, win)
    if win then
        self.go_table.aorimage_resultBg.SpriteName = resultBgName.win
        if not isleft then
            self.go_table.aorimage_resultBg:SetLocalScale(-1, 1, 1)
        else
            self.go_table.aorimage_resultBg:SetLocalScale(1, 1, 1)
        end
        self.go_table.aorimage_Result.SpriteName = resultTagName.win
    else
        self.go_table.aorimage_Result.SpriteName = resultTagName.lose
        self.go_table.aorimage_resultBg.SpriteName = resultBgName.lose
        if isleft then
            self.go_table.aorimage_resultBg:SetLocalScale(-1, 1, 1)
        else
            self.go_table.aorimage_resultBg:SetLocalScale(1, 1, 1)
        end
    end
    self:ShowBase(baseinfo)
    self:ShowData(data, max)
end

function MatchBattleStatisticsItem:ShowBase(info)
    local cfg = _G.ConfigManager.player_portrait_cfg[info.headID]
    local icon = cfg.portrait1
    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    self.go_table.aorimage_Icon.SpriteName = icon
    cfg = _G.ConfigManager.player_frame_cfg[info.frameID]
    self.go_table.aorrawimage_frame.Alpha = 0
    require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_frame, cfg.frame)
    self.go_table.aortext_Name.text = info.name
    self.go_table.aortext_Level.text = info.level
end

function MatchBattleStatisticsItem:ShowData(data, max)
    for i = 1, #data do
        self.dataItem[i]:Show(data[i], max)
    end
end
--endregion
local MatchBattleManager = require "MatchBattleManager"
---@class MatchBattleStatisticsView : UIBaseView	中文描述
---@field public go_table MatchBattleStatisticsView_GoTable GoTable
local MatchBattleStatisticsView = _G.BaseClass("MatchBattleStatisticsView", _G.UIBaseView)
function MatchBattleStatisticsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MatchBattleStatisticsView:OnCreate(data, max, win)
    self.myItem = MatchBattleStatisticsItem.New(self.go_table.obj_mItem)
    self.enemyItem = MatchBattleStatisticsItem.New(self.go_table.obj_eItem)
    self.myItem:Show(MatchBattleManager:GetInstance():GetMyBaseInfo(), data.Attacker, true, max, win)
    self.enemyItem:Show(MatchBattleManager:GetInstance():GetEnemyBaseInfo(), data.Defender, false, max, not win)
end

---按钮点击事件在这里派发
function MatchBattleStatisticsView:OnClickBtn(go)
    self:Close()
end

return MatchBattleStatisticsView
