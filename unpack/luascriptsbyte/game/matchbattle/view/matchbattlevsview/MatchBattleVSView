local MatchBattleManager = require "MatchBattleManager"
---界面停留时间
local showTime = 3

---@class MatchBattleVSView : UIBaseView	中文描述
---@field public go_table MatchBattleVSView_GoTable GoTable
local MatchBattleVSView = _G.BaseClass("MatchBattleVSView", _G.UIBaseView)
function MatchBattleVSView:Awake()
end

---界面的入口函数
function MatchBattleVSView:OnCreate(call)
    self.onCloseCall = call
    self:Show()
    _G.TimerManager:GetInstance():GetTimer(showTime, self.Close, self, true):Start()
end

function MatchBattleVSView:OnDisable()
    if self.onCloseCall then
        self.onCloseCall()
    end
end

local handleIcon = function(icon)
    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    return icon
end

function MatchBattleVSView:Show()
    local data = MatchBattleManager:GetInstance():GetMyBaseInfo()
    local cfg = _G.ConfigManager.player_portrait_cfg[data.headID]
    local icon = cfg.portrait1
    self.go_table.aorimage_mIcon.SpriteName = handleIcon(icon)
    self.go_table.aortext_mName.text = data.name
    ---@type card_cfg
    cfg = require "CardCommentManager":GetInstance():GetCfgs(data.cardID)
    local mcardSize = cfg.size2
    local mcardPos = cfg.pos_portrait
    self.go_table.aorrawimage_m:LoadImage(
        cfg.Portrait,
        function()
            self.go_table.aorrawimage_m:SetNativeSize()
            self.go_table.aorrawimage_m:SetLocalScale(mcardSize, mcardSize, 1)
            self.go_table.aorrawimage_m:SetLocalPosition(mcardPos[1], mcardPos[2], 0)
        end
    )
    cfg = _G.ConfigManager.player_frame_cfg[data.frameID]
    icon = cfg.frame
    self.go_table.aorimage_mFrame.SpriteName = handleIcon(icon)

    data = MatchBattleManager:GetInstance():GetEnemyBaseInfo()
    cfg = _G.ConfigManager.player_portrait_cfg[data.headID]
    local icon = cfg.portrait1
    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    self.go_table.aorimage_eIcon.SpriteName = handleIcon(icon)
    self.go_table.aortext_eName.text = data.name
    ---@type card_cfg
    cfg = require "CardCommentManager":GetInstance():GetCfgs(data.cardID)
    local ecardSize = cfg.size2
    local ecardPos = cfg.pos_portrait
    self.go_table.aorrawimage_e:LoadImage(
        cfg.Portrait,
        function()
            self.go_table.aorrawimage_e:SetNativeSize()
            self.go_table.aorrawimage_e:SetLocalScale(ecardSize, ecardSize, 1)
            self.go_table.aorrawimage_e:SetLocalPosition(-ecardPos[1], ecardPos[2], 0)
        end
    )
    cfg = _G.ConfigManager.player_frame_cfg[data.frameID]
    icon = cfg.frame
    self.go_table.aorimage_eFrame.SpriteName = handleIcon(icon)
end

return MatchBattleVSView
