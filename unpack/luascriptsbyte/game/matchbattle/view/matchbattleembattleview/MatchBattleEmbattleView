local timeNumName = "yellow"
local startTimeNumName = "red"
local ShowTipsTime = 3
local ShowTimesLanguageID = 90023600001
local ShowWaitLanguageID = 90023600002
local ShowBattleStartTipsLanguageID = 90023600005
local ShowEmbattleTipsID = 430101
local timePosEmbattle = {0, 0}
local timePosChoose = {-200, 64}
local stageImageName = {"ui_zdpp_txt_01jd", "ui_zdpp_txt_02jd", "ui_zdpp_txt_03jd", "ui_zdpp_font_zhandouks"}
local maxEmbattleStage = 3

local MatchBattleManager = require "MatchBattleManager"
local EmbattleController = require "EmbattleController"

---@class MatchBattleEmbattleView : UIBaseView	中文描述
---@field public go_table MatchBattleEmbattleView GoTable
local MatchBattleEmbattleView = _G.BaseClass("MatchBattleEmbattleView", _G.UIBaseView)
function MatchBattleEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.locks = {
        self.go_table.obj_lock1,
        self.go_table.obj_lock2,
        self.go_table.obj_lock3,
        self.go_table.obj_lock4,
        self.go_table.obj_lock5,
        self.go_table.obj_lock6
    }
end

---界面的入口函数
function MatchBattleEmbattleView:OnCreate()
    self:OpenEmbattleView()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_embattle, true)
    MatchBattleManager:GetInstance():GetEmbattleTime(_G.handler(self, self.ShowTime))
    self:ShowName()
    self:ShowTimesTips(1)
end

function MatchBattleEmbattleView:OnDestroy()
    self.embattleView = nil
    MatchBattleManager:GetInstance():GetEmbattleTime(nil)
    self.mCanvas = nil
    self.locks = nil
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnChooseCloseCall, self)
end

---按钮点击事件在这里派发
function MatchBattleEmbattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_sure then
        if MatchBattleManager:GetInstance():CheckCurEmbattle() then
            MatchBattleManager:GetInstance():OnSureEmbattleClick(_G.handler(self, self.ShowWaitTips))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(ShowEmbattleTipsID)
        end
    elseif go == self.go_table.aorbtn_embattle then
        self:ShowChooseEmbattle()
    elseif go == self.go_table.aorbtn_choosesure then
        if MatchBattleManager:GetInstance():CheckCurEmbattle() then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(ShowEmbattleTipsID)
        end
    end
end
function MatchBattleEmbattleView:ShowName()
    local data = MatchBattleManager:GetInstance():GetMyBaseInfo()
    self.go_table.aortext_mName.text = data.name
    data = MatchBattleManager:GetInstance():GetEnemyBaseInfo()
    self.go_table.aortext_eName.text = data.name
end
---选人界面层级调整值
local embattleChooseViewAddSortingOrder = 15
---监听界面打开
---@param name string 界面名称
function MatchBattleEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.mCanvas = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, self.mCanvas.sortingOrder)
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
    elseif name == _G.ConfigManager.ui_cfg.EmbattleChooseView.Name then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.mCanvas.sortingOrder + embattleChooseViewAddSortingOrder
        )
        view.transform:SetParentE(self.go_table.trans_view)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_embattle, false)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        self.go_table.trans_time:SetLocalPosition(timePosChoose[1], timePosChoose[2], 0)
    end
end
function MatchBattleEmbattleView:ShowTimesTips(times)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_times, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_times, true)
    self.go_table.aorimage_times.SpriteName = stageImageName[times]
    self.go_table.aorimage_timesmain.SpriteName = stageImageName[times]
    _G.TimerManager:GetInstance():GetTimer(ShowTipsTime, self.OnShowTipsEnd, self, true):Start()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_timesTip, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_startTime, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_waitTip, false)
end
function MatchBattleEmbattleView:ShowBattleStartTime(time)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_times, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_times, true)
    self.go_table.aorimage_times.SpriteName = stageImageName[#stageImageName]
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_timesTip, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_startTime, true)
    self.go_table.aorimage_startTime.SpriteName = startTimeNumName .. time
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_waitTip, false)
end
---显示轮次
---@param time number 战斗开始倒计时
function MatchBattleEmbattleView:ShowEmbattleTips(time)
    if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name) then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name)
    else
        if not time then
            self:UpdateMyFormation()
        end
    end
    local times = MatchBattleManager:GetInstance():GetCurEmbattleIndex()
    if times <= maxEmbattleStage then
        self:ShowTimesTips(times)
    else
        self:ShowBattleStartTime(time)
    end
    self.showEmbattleTips = true
end
---当轮次显示完
function MatchBattleEmbattleView:OnShowTipsEnd()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_times, false)
end
---显示等待
function MatchBattleEmbattleView:ShowWaitTips()
    if self.showEmbattleTips then
        self.showEmbattleTips = nil
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_times, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_waitTip, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_timesTip, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_startTime, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_times, false)
end
---当时间结束后，自动布阵完的刷新
function MatchBattleEmbattleView:OnTimeEndFresh()
    if _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name) then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.EmbattleChooseView.Name)
    else
        self:UpdateMyFormation()
    end
end
--region 布阵界面
---打开布阵界面
function MatchBattleEmbattleView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnChooseCloseCall, self)
    EmbattleController:GetInstance():OpenEmbattle(
        _G.EmbattleType.matchBattle,
        _G.EmbattleSaveType.temporary,
        true,
        _G.EmbattleControllerItemType.match
    )
end
---刷新敌方布阵显示
function MatchBattleEmbattleView:RefreshEnemy()
    self.embattleView.eEmbattleFormationView:Init()
    self:UpdateMyFormation()
end
--endregion
--region选择界面
---打开选人界面
function MatchBattleEmbattleView:ShowChooseEmbattle()
    local item = EmbattleController:GetInstance():GetCurEmbattleItem()
    EmbattleController:GetInstance():OpenChooseCardView(item, 1)
end
---当选人界面关闭
function MatchBattleEmbattleView:OnChooseCloseCall(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleChooseView.Name then
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_embattle, true)
    self.go_table.trans_time:SetLocalPosition(timePosEmbattle[1], timePosEmbattle[2], 0)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    self:UpdateMyFormation()
end
--endregion
function MatchBattleEmbattleView:UpdateMyFormation()
    self.embattleView.mEmbattleFormationView:Init()
    local item = EmbattleController:GetInstance():GetCurEmbattleItem()
    local data = item:GetEmbattleData()
    local curStage = MatchBattleManager:GetInstance():GetCurEmbattleIndex()
    for i = 1, #data.heroes do
        if i <= 2 * (curStage - 1) then
            _G.GameUtil.SetActiveByCondition(self.locks[data.pos[i]], true)
        else
            _G.GameUtil.SetActiveByCondition(self.locks[data.pos[i]], false)
        end
    end
    if 2 * curStage > #data.heroes then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_sure, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_embattle, false)
        return
    end
    if data.heroes[curStage * 2].uid > 0 and data.heroes[curStage * 2 - 1].uid > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_sure, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_embattle, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_sure, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_embattle, true)
    end
    self.embattleView:ShowAllPower()
end
---倒计时
---@param time number 倒计时
function MatchBattleEmbattleView:ShowTime(time)
    self.go_table.aorimage_10.SpriteName = timeNumName .. _G.Mathf.Floor(time / 10)
    self.go_table.aorimage_1.SpriteName = timeNumName .. time % 10
    self.go_table.aorimage_10:SetNativeSize()
    self.go_table.aorimage_1:SetNativeSize()
end

return MatchBattleEmbattleView
