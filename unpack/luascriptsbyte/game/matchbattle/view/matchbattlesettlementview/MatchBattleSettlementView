---@class MatchBattleSettlementView : UIBaseView	中文描述
---@field public go_table MatchBattleSettlementView_GoTable GoTable
local MatchBattleSettlementView = _G.BaseClass("MatchBattleSettlementView", _G.UIBaseView)
function MatchBattleSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MatchBattleSettlementView:OnCreate(iSWin, AwardData, call)
    self.onCloseCall = call
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnShowAwardViewOpen, self)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        iSWin,
        AwardData,
        _G.handler(self, self.OnShowAwardViewClose),
        false
    )
    self.myWin = iSWin
end
function MatchBattleSettlementView:OnDestroy()
    self.statisticsData = nil
    self.onCloseCall = nil
    self.statisticsMax = nil
    self.myWin = nil
end

function MatchBattleSettlementView:OnShowAwardViewOpen(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnShowAwardViewOpen, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder =
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 40
        view.transform:SetParentE(self.go_table.trans_view)
    end
end

---按钮点击事件在这里派发
function MatchBattleSettlementView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
        self:OnShowAwardViewClose()
    else
        self:ShowStatisticsView()
    end
end
function MatchBattleSettlementView:ShowStatisticsView()
    if self.statisticsData == nil then
        self.statisticsData = _G.BattleManager:GetInstance():GetStatistics()
        self.statisticsData = self.statisticsData.FighterInfo[1]
        self.statisticsMax = {DmgOut = 0, DmgIn = 0, HpRecover = 0}
        for i = 1, #self.statisticsData.Attacker do
            if self.statisticsMax.DmgOut < self.statisticsData.Attacker[i].DmgOut then
                self.statisticsMax.DmgOut = self.statisticsData.Attacker[i].DmgOut
            end
            if self.statisticsMax.DmgOut < self.statisticsData.Defender[i].DmgOut then
                self.statisticsMax.DmgOut = self.statisticsData.Defender[i].DmgOut
            end
            if self.statisticsMax.DmgIn < self.statisticsData.Attacker[i].DmgIn then
                self.statisticsMax.DmgIn = self.statisticsData.Attacker[i].DmgIn
            end
            if self.statisticsMax.DmgIn < self.statisticsData.Defender[i].DmgIn then
                self.statisticsMax.DmgIn = self.statisticsData.Defender[i].DmgIn
            end
            if self.statisticsMax.HpRecover < self.statisticsData.Attacker[i].HpRecover then
                self.statisticsMax.HpRecover = self.statisticsData.Attacker[i].HpRecover
            end
            if self.statisticsMax.HpRecover < self.statisticsData.Defender[i].HpRecover then
                self.statisticsMax.HpRecover = self.statisticsData.Defender[i].HpRecover
            end
        end
        if self.statisticsMax.DmgOut == 0 then
            self.statisticsMax.DmgOut = 1
        end
        if self.statisticsMax.DmgIn == 0 then
            self.statisticsMax.DmgIn = 1
        end
        if self.statisticsMax.HpRecover == 0 then
            self.statisticsMax.HpRecover = 1
        end
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MatchBattleStatisticsView.Name,
        self.statisticsData,
        self.statisticsMax,
        self.myWin
    )
end
function MatchBattleSettlementView:OnShowAwardViewClose()
    if self.onCloseCall then
        self.onCloseCall()
    end
    self:Close()
end

-- function MatchBattle

return MatchBattleSettlementView
