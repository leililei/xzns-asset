require "BaseGameNet"
local base = require("BaseGameNet")

---@class MatchBattleNet : BaseGameNet	通信协议
local MatchBattleNet = _G.BaseClass("MatchBattleNet", base)

---@return MatchBattleNet MatchBattleNet
function MatchBattleNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function MatchBattleNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MatchBattleNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---匹配
---@param call function 匹配回调
function MatchBattleNet:Match(call)
    self:Access(_G.ConfigManager.net_map.game_match_fight_queue_in, self:GetEmptyPB(), call)
end
---取消匹配
function MatchBattleNet:CancelMatch()
    self:Access(_G.ConfigManager.net_map.game_match_fight_queue_abort, self:GetEmptyPB())
end
---设置阵容
---@param sits table 布阵数据
function MatchBattleNet:SetGarry(sits, call)
    -- call({ack = 1})
    self:Access(_G.ConfigManager.net_map.game_match_fight_set_garray, {sits = sits}, call)
end
---战斗
---@param call function 战斗回调
function MatchBattleNet:Fight(call)
    return self:Access(_G.ConfigManager.net_map.game_match_fight_fight, self:GetEmptyPB(), call)
end
---结束
---@param call function 战斗回调
function MatchBattleNet:Result(call)
    self:Access(_G.ConfigManager.net_map.game_match_fight_result, self:GetEmptyPB(), call)
end

---@type MatchBattleNet
return MatchBattleNet
