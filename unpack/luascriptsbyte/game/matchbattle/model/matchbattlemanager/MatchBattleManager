local MatchBattleNet = require "MatchBattleNet"
local EmbattleController = require "EmbattleController"
---说明ID
local instuctionID = 14
---匹配成功后的进入倒计时离散表ID
local matchSuccessTimeID = 103104
---匹配战斗开始倒计时离散表id
local matchBattleStartTimeID = 103105
local maxEmbattleStage = 3

---@class MatchBattleManager : Singleton	中文描述
local MatchBattleManager = _G.BaseClass("MatchBattleManager", _G.Singleton)

---@return MatchBattleManager MatchBattleManager
function MatchBattleManager:GetInstance()
    return self.super.GetInstance(self)
end
---创建对象时,入口构造函数
function MatchBattleManager:__init()
end
---销毁对象时,析构函数
function MatchBattleManager:Dispose()
end
---初始化数据(定义当前会用到的字段)
function MatchBattleManager:InitData()
    self.curEmbattleIndex = 0
    self.curAutoChange = EmbattleController:GetInstance():GetChangeAuto()
    self.enemyBaseInfo = nil
    self.enemyEmbattleData = nil
    self.curEmbattleEndTime = nil
    self.onEmbattleTimeCall = nil
    self.embattleState = false
end
---清理数据(释放内存)
function MatchBattleManager:ClearData()
    self.curEmbattleIndex = nil
    self.curAutoChange = nil
    self.enemyBaseInfo = nil
    self.enemyEmbattleData = nil
    self.curEmbattleEndTime = nil
    self.onEmbattleTimeCall = nil
    self.embattleState = nil
end
---当匹配成功后倒计时回调
function MatchBattleManager:OnMatchSuccessTimerCall(elapsed)
    self.matchView:ShowJoinTime(math.ceil(self.matchSuccessTime))
    if self.matchSuccessTime <= 0 then
        self.matchSuccessTime = nil
        self.matchSuccessTimer:Stop()
        self.matchSuccessTimer = nil
        self.matchView = nil
        _G.TimerManager:GetInstance():GetTimer(1, self.GetTimerCallBackMatch, self, true, true):Start()
    else
        self.matchSuccessTime = self.matchSuccessTime - (elapsed or 1)
    end
end

function MatchBattleManager:GetTimerCallBackMatch()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MatchBattleVSView.Name,
        _G.handler(self, self.OnVSViewClosed)
    )
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MatchBattleMatchView.Name)
end

---当匹配成功回调
---@param 变量名 变量类型 中文描述
function MatchBattleManager:OnMatchSuccessCall(data, success)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.match_fight_role.Cmd, self.OnMatchSuccessCall, self)
    if success == false then
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.match_fight_garry.Cmd, self.OnGarryCall, self)
    else
        self:InitData()
        self.enemyBaseInfo = data.tar_role
        self.curEmbattleIndex = 1
        self.curEmbattleEndTime = data.end_time - _G.TimeUtil.GetServerUnixTime()
        self.curAutoChange = EmbattleController:GetInstance():GetChangeAuto()
        if not self.curAutoChange then
            EmbattleController:GetInstance():SetChangeAuto(true, false)
        end
        self.embattleState = true
        if self.curEmbattleTimer == nil then
            self.curEmbattleTimer = _G.TimerManager:GetInstance():GetTimer(1, self.HandleEmbattleTime, self)
            self.curEmbattleTimer:Start()
        end
        self.matchView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MatchBattleMatchView.Name)
        self.matchSuccessTime = _G.ConfigManager.discrete_cfg[matchSuccessTimeID][1][1]
        self.matchView:ShowMatchSuccesView()
        self:OnMatchSuccessTimerCall()
        self.matchSuccessTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnMatchSuccessTimerCall, self)
        self.matchSuccessTimer:Start()
    end
end
---当匹配成功界面关闭时回调
function MatchBattleManager:OnVSViewClosed()
    EmbattleController:GetInstance():SetHelpInstructionID(instuctionID)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MatchBattleEmbattleView.Name)
end

---当每轮结束推送
---@param data p2c_match_fight_garry 当前轮已布阵数据(敌方)+当前轮截止时间戳
function MatchBattleManager:OnGarryCall(data)
    self.curEmbattleIndex = self.curEmbattleIndex + 1
    self.enemyEmbattleData = data.tar_garry
    local item = EmbattleController:GetInstance():GetCurEmbattleItem()
    item:InitEmbattleData(data.my_garry)
    EmbattleController:GetInstance():GetCurEmbattleItem():InitEnemyEmbattleData()
    self.curEmbattleEndTime = data.end_time - _G.TimeUtil.GetServerUnixTime() - 2
    self.embattleState = true
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MatchBattleEmbattleView.Name)
    view:RefreshEnemy()
    if self.curEmbattleIndex > maxEmbattleStage then
        self.embattleState = false
        self.battleStartTime = _G.ConfigManager.discrete_cfg[matchBattleStartTimeID][1][1]
        view:ShowEmbattleTips(self.battleStartTime)
        self.battleStartTimer = _G.TimerManager:GetInstance():GetTimer(1, self.BattleStart, self)
        self.battleStartTimer:Start()
        if self.curEmbattleTimer then
            self.curEmbattleTimer:Stop()
            self.curEmbattleTimer = nil
        end
        self.onEmbattleTimeCall = nil
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.match_fight_garry.Cmd, self.OnGarryCall, self)
    else
        view:ShowEmbattleTips()
    end
end
---开启战斗
function MatchBattleManager:BattleStart(elapsed)
    self.battleStartTime = self.battleStartTime - elapsed
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MatchBattleEmbattleView.Name)
    view:ShowEmbattleTips(Mathf.RoundToInt(self.battleStartTime))
    if self.battleStartTime <= 0 then
        self.battleStartTimer:Stop()
        self.battleStartTimer = nil
        self.battleStartTime = nil
        _G.TimerManager:GetInstance():GetTimer(1, self.GetTimerCallBack, self, true, true):Start()
    end
end

function MatchBattleManager:GetTimerCallBack()
    EmbattleController:GetInstance():SetChangeAuto(self.curAutoChange, false)
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.MatchBattle)
end

---处理每轮布阵时间
function MatchBattleManager:HandleEmbattleTime(elapsed)
    self.curEmbattleEndTime = self.curEmbattleEndTime - elapsed
    if self.curEmbattleEndTime < 0 then
        self.curEmbattleEndTime = 0
    elseif Mathf.RoundToInt(self.curEmbattleEndTime) == 0 then
        if self.embattleState then
            local item = EmbattleController:GetInstance():GetCurEmbattleItem()
            local data = item:GetEmbattleData()
            if data.heroes[self.curEmbattleIndex * 2].uid == 0 then
                local list = item:GetCardList()
                for i = 1, #list do
                    if list[i].cfg.UnitType == _G.HeroType.Guardian and not item:CheckUidInEmbattle(list[i].uid) then
                        item:SetEmbattleDataSingle(self.curEmbattleIndex * 2, list[i].uid)
                        break
                    end
                end
            end
            if data.heroes[self.curEmbattleIndex * 2 - 1].uid == 0 then
                local list = item:GetCardList(_G.HeroType.Hero)
                for i = 1, #list do
                    if list[i].cfg.UnitType == _G.HeroType.Hero and not item:CheckUidInEmbattle(list[i].uid) then
                        item:SetEmbattleDataSingle(self.curEmbattleIndex * 2 - 1, list[i].uid)
                        break
                    end
                end
            end
        end
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MatchBattleEmbattleView.Name)
        view:ShowEmbattleTips()
        self:OnSureEmbattleClick()
    end
    if self.onEmbattleTimeCall then
        self.onEmbattleTimeCall(math.ceil(self.curEmbattleEndTime))
    end
end
---匹配队列回调
---@param data table 匹配队列数据
function MatchBattleManager:OnMatchResultCall(data)
    if data.ack ~= 1 then
        _G.Events:GetInstance():RemoveListener(
            _G.ConfigManager.net_map.match_fight_role.Cmd,
            self.OnMatchSuccessCall,
            self
        )
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.match_fight_garry.Cmd, self.OnGarryCall, self)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MatchBattleMatchView.Name)
    end
end
--region对外接口
---匹配
function MatchBattleManager:Match()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.match_fight_role.Cmd, self.OnMatchSuccessCall, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.match_fight_garry.Cmd, self.OnGarryCall, self)
    MatchBattleNet:GetInstance():Match(_G.handler(self, self.OnMatchResultCall))
end
---取消匹配
function MatchBattleManager:CancelMatch()
    self:OnMatchSuccessCall(nil, false)
    MatchBattleNet:GetInstance():CancelMatch()
end
---获取敌方基础信息
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function MatchBattleManager:GetEnemyBaseInfo()
    return {
        headID = self.enemyBaseInfo.style,
        name = self.enemyBaseInfo.name,
        cardID = self.enemyBaseInfo.city_style_id,
        frameID = self.enemyBaseInfo.frame,
        level = self.enemyBaseInfo.level
    }
end
---获取自己的基础信息
---@return table 基础信息(头像，名称)
function MatchBattleManager:GetMyBaseInfo()
    local player = _G.PlayerModel:GetInstance()
    return {
        headID = player:GetRoleStyle(),
        name = player.role_name,
        cardID = player:GetRoleSid(),
        frameID = player:GetCurFrame(),
        level = player:GetLevel()
    }
end
---获取倒计时
---@param callback function 倒计时回调
function MatchBattleManager:GetEmbattleTime(callback)
    self.onEmbattleTimeCall = callback
    if callback then
        callback(self.curEmbattleEndTime)
    end
end
---确认当前布局
---@param sits table 布阵数据
---@param scallits function 确认回调
function MatchBattleManager:OnSureEmbattleClick(call)
    if not self.embattleState then
        return
    end
    self.embattleState = false
    local sits = {}
    local data = EmbattleController:GetInstance():GetCurEmbattleItem():GetEmbattleData()
    for i = 1, #data.heroes do
        _G.table.insert(sits, data.heroes[i].uid > 0 and data.heroes[i].uid * 10 + data.pos[i] or 0)
    end
    MatchBattleNet:GetInstance():SetGarry(
        sits,
        function(data)
            local success = false
            if data.ack ~= 1 then
                self.embattleState = true
                success = true
            end
            if call then
                call(success)
            end
        end
    )
end
---检测当前轮次是否布阵
---@return boolean 是否完成布阵
function MatchBattleManager:CheckCurEmbattle()
    local item = EmbattleController:GetInstance():GetCurEmbattleItem()
    local data = item:GetEmbattleData()
    if data.heroes[self.curEmbattleIndex * 2].uid == 0 or data.heroes[self.curEmbattleIndex * 2 - 1].uid == 0 then
        return false
    end
    return true
end
---获取战斗统计数据
---@return table 统计数据
function MatchBattleManager:GetBattleStatisticsData()
end
---获取敌方布阵数据
---@return table 敌方布阵
function MatchBattleManager:GetEnemyEmbattleData()
    return self.enemyEmbattleData
end
---获取当前布阵状态
---@return boolean 是否可以布阵
function MatchBattleManager:GetCurEmbattleState()
    return self.embattleState
end
---获取当前轮次
---@return number 轮次
function MatchBattleManager:GetCurEmbattleIndex()
    return self.curEmbattleIndex
end
