---@class MiniSectionGameManager :Singleton
local MiniSectionGameManager = _G.BaseClass("MiniSectionGameManager", _G.Singleton)

---@return MiniSectionGameManager MiniSectionGameManager
function MiniSectionGameManager:GetInstance()
    return self.super.GetInstance(self)
end

local GameModel = {
    [1001] = require("SwordCasualModel"), --剑之修行
    [1002] = require("MiniGameXKTSModel"),--虚空吞噬
    [1003] = "",                          --英雄之塔
    [1004] = "",                          --巨物横行
    [1005] = require("MiniFireGameModel") --火枪之怒
}

function MiniSectionGameManager:__init()
end

---检测是否全部通关
function MiniSectionGameManager:CheckIsAllPass(gameId)
    local model = GameModel[gameId]
    if not model or type(model) ~= "table" then
        return true
    end
    return model:GetInstance():CheckIsAllPass()
end

---获取当前待挑战关卡下标
function MiniSectionGameManager:GetCurSectionIndex(gameId)
    local model = GameModel[gameId]
    if not model or type(model) ~= "table" then
        return 0
    end
    return model:GetInstance():GetCurSectionIndex()
end

---挑战
function MiniSectionGameManager:Challenge(gameId, sectionId)
    local model = GameModel[gameId]
    if not model or type(model) ~= "table" then
        if _G.AppSetting.DEBUG then
            _G.LogError("挑战的游戏gameId不存在: " .. tostring(gameId))
        end
        return
    end
    model:GetInstance():Challenge(sectionId)
end

---获取关卡配置
function MiniSectionGameManager:GetSectionCfgs(gameId)
    local model = GameModel[gameId]
    if not model or type(model) ~= "table" then
        if _G.AppSetting.DEBUG then
            _G.LogError("挑战的游戏gameId不存在: " .. tostring(gameId))
        end
        return {}
    end
    return model:GetInstance():GetSectionCfgs()
end

function MiniSectionGameManager:Dispose()
end

return MiniSectionGameManager
