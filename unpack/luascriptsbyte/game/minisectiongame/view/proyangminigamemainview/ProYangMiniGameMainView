---@class ProYangMiniGameMainView : UIBaseView	中文描述
---@field public go_table FestivalRedBoundMainView_GoTable GoTable
local ProYangMiniGameMainView = _G.BaseClass("ProYangMiniGameMainView", _G.UIBaseView)
local FestivalRedBoundModel
function ProYangMiniGameMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    FestivalRedBoundModel = require "FestivalRedBoundModel":GetInstance()
end

---界面的入口函数
function ProYangMiniGameMainView:OnCreate(activity)
    self.activity = activity
    self.activityID = self.activity.curActivityClass:GetActivityID()
    
    
    self.go_table.aortext_name.text = activity.curActivityClass.cfg.info.name
    self:UpdateView()
end

function ProYangMiniGameMainView:UpdateView()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local taskActivitys =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.activity.curActivityClass:GetJumpType(), 4)
    if taskActivitys then 
        self.go_table.obj_bagRedpoint:UpdateRedPointItemIDAndParam(taskActivitys:GetActivityTypeCls():GetRedpointIDByIndex(1)) 
        local allTask = taskActivitys.typeClass:GetAllTaskDatas()
        local taskBol
        local nextScore = 0
        local nowScore = 0
        for k, v in pairs(allTask) do 
            if v.taskEnumType == 192 then 
                taskBol = true
                nowScore = math.max(nowScore, v.i_task.target[1])
                if v.i_task.state == _G.TaskEnum.ETaskState.Claimed then 
                    nextScore = nextScore ~= 0 and math.min(nextScore, v.Cfg.count) or v.Cfg.count
                end
            end
        end
        if taskBol then 
            self.go_table.obj_next:SetActiveE(1)
            if nextScore == 0 then 
                -- self.go_table.aortext_next1.text = ""
                -- self.go_table.aortext_next2.text = _G.GetLangPackValue(90034533009)
                self.go_table.aortext_next1:SetActiveE(0)
                self.go_table.aortext_next3:SetActiveE(1)
            else 
                self.go_table.aortext_next1.text = string.format("<color=#96ce51>%s</color>/<color=#e6dab5>%s</color>", nowScore, nextScore)
                self.go_table.aortext_next1:SetActiveE(1)
                self.go_table.aortext_next3:SetActiveE(0)
            end
        else 
            self.go_table.obj_next:SetActiveE(0)
        end 
    end
    
    self.lastTime = self.activity.curActivityClass.cfg.time.start_time + self.activity.curActivityClass.cfg.time.run_time - _G.TimeUtil.GetServerUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.TimerFunc, self, false)
    self:TimerFunc(0)
    self.timer:Start()
    self.go_table.aortext_max.text = self.activity.maxScore or 0
    self.go_table.aortext_today.text = self.activity.dayScore or 0
end

function ProYangMiniGameMainView:TimerFunc(elapsed)
    self.lastTime = self.lastTime - elapsed
    if self.lastTime < 0 then
        self:CloseView()
    else
        local time = _G.TimeUtil.TranslateSecondForDHMOrHMS(self.lastTime)
        self.go_table.aortext_time.text = GetLangPackValue(90027600008, time)
    end
end

function ProYangMiniGameMainView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function ProYangMiniGameMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_startGame then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ProYangMiniGameView.Name,
            nil,
            _G.handler(self, self.UpdateView),
            {{20203, 2, self.activity}}
        )
    elseif go == self.go_table.aorbtn_task then
        self:OpenTask()
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 201)
    end
end

function ProYangMiniGameMainView:OpenTask()
    local taskActivitys =
        require "ActivitySynManager":GetInstance():GetChildAcitivity(10007, self.activity.curActivityClass:GetJumpType(), 4)
    if taskActivitys then 
        taskActivitys:GetActivityTypeCls():OnEnterActivity()
    end
end

function ProYangMiniGameMainView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

return ProYangMiniGameMainView