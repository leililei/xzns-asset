local MiniSectionGameManager = require("MiniSectionGameManager")

---@class MiniSectionGameView : UIBaseView	灵域试炼（材料副本）
---@field public go_table MiniSectionGameView_GoTable GoTable
local MiniSectionGameView = _G.BaseClass("MiniSectionGameView", _G.UIBaseView)

function MiniSectionGameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MiniSectionGameView:OnCreate()
    self.sectionItems = {}
    self.sectionCfgs = {}
    self:InitCfgs()
    self:InitToggle()
    self.toggleItems[1]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
    self.playerHead =
        self:AddComponent(
        self.go_table.trans_PlayerHead,
        require("PlayerComponent").New(self.go_table.trans_PlayerHead)
    )
    self:AddListener(_G.eMiniSectionGame.MiniSectionPass, self.OnSectionPass)
end

function MiniSectionGameView:InitCfgs()
    self.cfgs = {}
    for _, v in pairs(_G.ConfigManager.game_show_title_cfg) do
        if v.type == 0 then
            _G.table.insert(self.cfgs, v)
        end
    end
    _G.SortList(
        self.cfgs,
        function(a)
            return -a.display, a.id
        end
    )
end

function MiniSectionGameView:InitToggle()
    self.toggles = {}
    self.toggleItems = {}
    ---@type MiniSectionGameView._toggle_temp_GoTable
    local tb
    local obj, cfg
    for i = 1, #self.cfgs do
        cfg = self.cfgs[i]
        obj = _G.InstantiateObject(self.go_table.toggle_temp, self.go_table.togglegroup_Content)
        obj:SetActiveE(1)
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickToggle, i))
        tb.aorimage_iconOn.SpriteName = cfg.c_icon
        tb.aorimage_iconOff.SpriteName = cfg.n_icon
        tb.aortext_name.text = _G.GetLangPackValue(cfg.Name)
        self.toggles[i] = tb
        self.toggleItems[i] = obj
    end
end

function MiniSectionGameView:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        self.curId = key
        self.curCfg = self.cfgs[self.curId]
        self:UpdateView()
    end
end

function MiniSectionGameView:UpdateView()
    self:UpdateBackground()
    self.curIsPass = MiniSectionGameManager:GetInstance():CheckIsAllPass(self.curCfg.Id)
    self.curSection = MiniSectionGameManager:GetInstance():GetCurSectionIndex(self.curCfg.Id)
    self.curIndex = self.curSection
    if not self.sectionCfgs[self.curId] then
        self.sectionCfgs[self.curId] = MiniSectionGameManager:GetInstance():GetSectionCfgs(self.curCfg.Id)
        -- if not _G.string.IsNullOrEmpty(self.curCfg.config) then
        --     local cfgs = _G.ConfigManager[self.curCfg.config]
        --     for _, v in pairs(cfgs) do
        --         _G.table.insert(self.sectionCfgs[self.curId], v)
        --     end
        -- elseif _G.AppSetting.DEBUG then
        --     _G.LogError("小游戏缺少关卡配置, 检查game_show_title_cfg的config字段")
        -- end
    end
    self.curSectionCfgs = self.sectionCfgs[self.curId]
    if not self.listInit then
        self.go_table.scrollloopvectical_ItemList:InitItemData(
            #self.curSectionCfgs,
            _G.handler(self, self.RefreshSection),
            self.curIndex - 1
        )
    else
        self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.curSectionCfgs, self.curIndex - 1)
    end
end

---更新spine
function MiniSectionGameView:UpdateBackground()
    self.go_table.aorrawimage_bg:LoadImage(self.curCfg.bg)
    self.go_table.obj_spine:ClearChildren()
    self.go_table.aorrawimage_name:LoadImage(self.curCfg.title_img)
    local cardCfg = _G.ConfigManager.card_cfg[self.curCfg.hero_id]
    local scale = cardCfg.size2
    local pos = cardCfg.pos_portrait
    local path = _G.UIUtils.GetBattleSpine(cardCfg, _G.UseBattleSpine.RankView)
    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
        scale = cardCfg.size4
        pos = {0, 0, 0}
    end
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Temporary,
        self.go_table.obj_spine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            trans:SetLocalScaleXYZ(scale)
            trans:SetLocalPosition(_G.table.unpack(pos))
        end
    )
end

---通关后刷新界面 --TODO:添加通关监听
function MiniSectionGameView:OnSectionPass()
    self.curIsPass = MiniSectionGameManager:GetInstance():CheckIsAllPass(self.curCfg.Id)
    self.curSection = MiniSectionGameManager:GetInstance():GetCurSectionIndex(self.curCfg.Id)
    self.curIndex = self.curSection
    self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
    self.go_table.scrollloopvectical_ItemList:ScrollToIndex(self.curSection - 1)
end

function MiniSectionGameView:RefreshSection(index, obj)
    index = index + 1
    local cfg = self.curSectionCfgs[index]
    local ide = obj:GetInstanceIDE()
    ---@type MiniSectionGameView._obj_item_GoTable
    local tb = self.sectionItems[ide]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSection, index))
        self.sectionItems[ide] = tb
        tb.awardItems = {}
    end
    tb.obj_isOn:SetActiveE(index == self.curIndex and 1 or 0)
    tb.aortext_floor.text = _G.GetLangPackValue(90049100011, index)
    if index < self.curSection then
        tb.aortext_state.text = _G.GetLangPackValue(90000000118)
    elseif index > self.curSection then
        tb.aortext_state.text = _G.GetLangPackValue(90049100012)
    else
        if index == #self.curSectionCfgs and self.curIsPass then
            tb.aortext_state.text = _G.GetLangPackValue(90000000118)
        else
            tb.aortext_state.text = _G.GetLangPackValue(90000010806)
        end
    end
    tb.awards = cfg.reward
    if not tb.awardInit then
        tb.scrollloophorizontal_award:InitItemData(#tb.awards, _G.handlerbind(self, self.RefreshAward, tb))
        tb.awardInit = true
    else
        tb.scrollloophorizontal_award:UpdateCount(#tb.awards)
    end
end

function MiniSectionGameView:RefreshAward(index, obj, tbSec)
    index = index + 1
    local data = tbSec.awards[index]
    local ide = obj:GetInstanceIDE()
    local tb = tbSec.awardItems[ide]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        tb.award = require "BaseAwardNewItem".New(tb.obj_Root)
        tbSec.awardItems[ide] = tb
    end
    tb.award:ShowWithID(
        data,
        nil,
        function(tran)
        end
    )
end

function MiniSectionGameView:OnClickSection(go, isOn, index)
    self.curIndex = index
    self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
end

---按钮点击事件在这里派发
function MiniSectionGameView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_challenge then
        if self.curIndex > self.curSection then
            return
        end
        MiniSectionGameManager:GetInstance():Challenge(self.curCfg.Id, self.curSectionCfgs[self.curIndex].id)
    elseif go == self.go_table.aorbtn_help then
        local helpId = self.curCfg.Intr
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, helpId)
    end
end

function MiniSectionGameView:OnDestroy()
    self:RemoveAllListener()
end

return MiniSectionGameView
