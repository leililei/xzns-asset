---@class CellUtilities @单元格静态工具类
local CellUtilities = {}

---@type function @CS一侧提供的创建单元格的静态方法
local CSCreateNormalCell = CS.GeneralModule.Cell.CellUtilities.CreateNormalCell

---Lua测提供创建CS单元格的统一接口
---@param cellprefab UnityEngine.GameObject @单元格模板
---@param container GeneralModule.Cell.BaseContainer @滚动容器
---@param luacell LuaBaseCell @Lua层的单元格对象
---@param width number @单元格宽度(默认不穿是预制件宽度)
---@param height number @单元格高度(默认不穿是预制件高度)
---@return GeneralModule.Cell.BaseCell @CS层的单元格对象
function CellUtilities.CreateNormalCell(cellprefab, container, luacell, width, height)
    width = width or 0
    height = height or 0
    return CSCreateNormalCell(cellprefab, container, luacell, width, height)
end

---@type CellUtilities @单元格静态工具类
_G.CellUtilities = CellUtilities

---@type CellUtilities @单元格静态工具类
return CellUtilities
