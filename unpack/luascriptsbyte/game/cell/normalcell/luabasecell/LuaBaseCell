---@class LuaBaseCell @Lua层单元格基类
---@field CSBaseCell CS.FFramework.Unity.BaseCell @CS层单元格对象
---@field Components table @UIBinder的那套组件绑定方式(子类里重新定义类型达到Emmylua提示的目的)
---@field Data any @Lua层单元格数据
local LuaBaseCell = _G.BaseClass("LuaBaseCell")
LuaBaseCell.CSBaseCell = nil
LuaBaseCell.Components = {}
LuaBaseCell.Data = nil

---构造函数
function LuaBaseCell:__init(data)
    --("LuaBaseCell:__init()")
    self.Data = data
end

---绑定CS测的Lua函数(请勿重写)
---Note:
---默认不绑定OnVisibleScroll方法(避免CS频繁调用Lua测)
---如需绑定请子类重写DIYBindCSLuaFuncs(csbasecell)和DIYUnbindCSLuaFuncs(csbasecell)
---@param csbasecell GeneralModule.Cell.BaseCell @CS测单元格对象
function LuaBaseCell:BindCS(csbasecell)
    --("LuaBaseCell:BindCS()")
    local precsbasecell = self.CSBaseCell
    self.CSBaseCell = csbasecell
    if not _G.IsNil(csbasecell) then
        --("not _G.IsNil(csbasecell)")
        csbasecell.LuaCell_Init = self.Init
        csbasecell.LuaCell_OnShow = self.OnShow
        csbasecell.LuaCell_OnHide = self.OnHide
        csbasecell.LuaCell_OnDestroy = self.OnDestroy
        self:DIYBindCSLuaFuncs(csbasecell)
    else
        --("_G.IsNil(csbasecell)")
        if precsbasecell ~= nil then
            precsbasecell.LuaCell_Init = nil
            precsbasecell.LuaCell_OnShow = nil
            precsbasecell.LuaCell_OnHide = nil
            precsbasecell.LuaCell_OnDestroy = nil
            self:DIYUnbindCSLuaFuncs(precsbasecell)
        end
    end
end

---自定义绑定CS测的特殊lua函数(e.g. OnVisibleScroll)
---如需绑定子类自己重写
function LuaBaseCell:DIYBindCSLuaFuncs(csbasecell)
end

---自定义解绑定CS测的特殊lua函数(e.g. OnVisibleScroll)
---如需解绑定子类自己重写
function LuaBaseCell:DIYUnbindCSLuaFuncs(csbasecell)
end

---缓存CS层的单元格对象(CS测绑定触发)
---@param csbasecell CS.FFramework.Unity.BaseCell @CS层的单元格脚本
function LuaBaseCell:SetCell(csbasecell)
    --("LuaBaseCell:SetCell()")
    self:BindCS(csbasecell)
end

---单元格初始化(CS测绑定触发)
function LuaBaseCell:Init()
    self:CacheComponent()
    self:AddListeners()
end

---缓存组件(Lua测流程)
function LuaBaseCell:CacheComponent()
    -- UIBinder的组件绑定代码在CS层而非Lua层
end

---清除组件(Lua测流程)
function LuaBaseCell:ClearComponent()
    -- UIBinder绑定的组件在Lua层这里置空而非CS层
    for k, v in pairs(self.Components) do
        self[k] = nil
    end
end

---添加监听(Lua测流程)
function LuaBaseCell:AddListeners()
end

---移除监听(Lua测流程)
function LuaBaseCell:RemoveListeners()
end

---Cell显示(CS测绑定触发)
function LuaBaseCell:OnShow()
end

---可见滚动刷新(CS测绑定触发--默认不绑定，需要手动绑定和解绑)
---@param scrollindexvalue number @当前滚动到的单元格索引值
function LuaBaseCell:OnVisibleScroll(scrollindexvalue)
end

---Cell隐藏(CS测绑定触发)
function LuaBaseCell:OnHide()
    self:RemoveListeners()
    self:ClearComponent()
end

---Cell销毁(CS测绑定触发)
function LuaBaseCell:OnDestroy()
    self:RemoveListeners()
    self:ClearComponent()
    self.CSBaseCell = nil
    self.Components = nil
    self.Data = nil
end

---@type LuaBaseCell @Lua层单元格基类
_G.LuaBaseCell = LuaBaseCell

---@type LuaBaseCell @Lua层单元格基类
return LuaBaseCell
