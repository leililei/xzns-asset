function TeamUniteBattlePassView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self:IsNil() then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    if _G.AppSetting.IsXzns then
        time = _G.string.AddColor(_G.TimeUtil.TranslateSecondForStrMiaoHui(time), "5bdf99")
        self.go_table.aortext_remainTime.text = _G.GetLangPackValue(90049500026, time)
    else
        time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51")
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90025500007, time)
    end
    self:UpdateAddBtnShow()
end

function TeamUniteBattlePassView:OnAniEnd()
    --ZHJH-7257 动画缩放导致遮罩对特效的遮挡效果更新异常，延迟加载道具特效
    _G.DelayDo(0.5, function()
        self.loadEff = true
        self:UpdateBattlePass()
    end)
end

---充值成功监听
function TeamUniteBattlePassView:OnMallCashListener(msg)
    self:UpdateView()
end

---选线后刷新
function TeamUniteBattlePassView:OnPrePrecessEnd()
    self:ShowByPath()
    self:UpdateBattlePass()
end

function TeamUniteBattlePassView:OnGetAwardEnd()
    self.ctrl:InitData()
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self:UpdateBattlePass()
end

function TeamUniteBattlePassView:OnBPUnlock(id)
    if id == self.ctrl.type then
        self:InitView()
    end
end

function TeamUniteBattlePassView:OnClickItem(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if not self.ctrl:CheckItemCondition(cfg) then
            return
        end
        if self.isBuy then
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        elseif self.ctrl:CheckAwardIsGet(cfg.id, true) then --弹出购买
            self.ctrl:Buy(self)
        else
            -- self.ctrl:GetAward(cfg.id, true)
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        end
    elseif name == "@_aorbtn_buySenior" then
        self.ctrl:Buy(self)
    end
end

---按钮点击事件在这里派发
function TeamUniteBattlePassView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Back then
        self:Close()
    elseif go == self.go_table.aorbtn_add then
        if self.path == 0 then
            return
        end
        local content = self.pathCfg.content[1]
        local maxId = content[#content]
        local maxLv = _G.ConfigManager.store_season_battlecon_cfg[maxId].level
        if self.lv == maxLv then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        else
            --self.lua_AddExp:Show(self.lv, maxLv, self.curExp)
        end
    elseif go == self.go_table.aorbtn_getExp then
        self.ctrl:JumpGetExp()
    elseif go == self.go_table.aorbtn_buy then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_oneKey then
        self.awardLis = self.awardLis or {}
        if #self.awardLis > 0 then 
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        end
    elseif go == self.go_table.aorbtn_switch then
        if not self.canSwitch then
            return
        end
        self.go_table.obj_choosePath:SetActiveE(1)
        self.go_table.obj_battlePass:SetActiveE(0)
        self.go_table.aorbtn_add:SetActiveE(0)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, self.ctrl:GetHelpId())
    end
end

function TeamUniteBattlePassView:ClickBuy()
    self.ctrl:Buy(self)
end

function TeamUniteBattlePassView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.ctrl:OnUIClosed()
    _G.Events:GetInstance():RemoveListener(_G.eTeamUnite.Refresh, self.InitView, self)
end

return TeamUniteBattlePassView
