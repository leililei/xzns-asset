local BaseAwardNewItem = require("BaseAwardNewItem")

---@class TeamUniteBattlePassView : UIBaseView    中文描述
---@field public go_table TeamUniteBattlePassView_GoTable GoTable
---@field ctrl IntegrateBpFdControllerBase
local TeamUniteBattlePassView = _G.BaseClass("TeamUniteBattlePassView", _G.UIBaseView)

local ItemState = {
    Lock = 1, --未解锁
    Unlock = 2, --可领取
    Received = 3 --已领取
}

local effectShowSids = _G.ConfigManager.discrete_cfg[114113][1]

function TeamUniteBattlePassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eTeamUnite.Refresh, self.InitView, self)
end

---界面的入口函数
---@param activity IntegrateBpFdControllerBase
function TeamUniteBattlePassView:OnCreate()
    self.ctrl = require("TeamUniteBpFdController").New()
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener)
    self:AddListener(_G.BattlePassExpEvents.BPUnlock, self.OnBPUnlock)
    --更新视图
    self.ctrl:InitData()
    self:InitView()
    self.ctrl:OnViewOpened()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    self:OnAniEnd()
end

---初始化窗口，涉及特效，需要activity设置完根节点OrderInLayer后再执行，否则特效层级概率计算错误
function TeamUniteBattlePassView:InitView()
    self.showItemExp = self.ctrl:IsShowItemExp()
    local countDown, size = self.ctrl:GetRemainingTime()
    if countDown then
        self.go_table.aortext_countDown.fontSize = size
        self.countDown = countDown
        self:UpdateTime(0)
        if self.timer == nil then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
        end
    else
        if _G.AppSetting.IsXzns then
            self:AddComponent(self.go_table.obj_playerInfo,
                    require("PlayerComponent").New(self.go_table.obj_playerInfo))
            self.countDown = require("TeamUniteModel"):GetInstance():GetEndTime() - _G.TimeUtil.GetServerUnixTime()
            self:UpdateTime(0)
            if self.timer == nil then
                self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
                self.timer:Start()
            end
        end
        local des, size = self.ctrl:GetProgressDes()
        self.go_table.aortext_countDown.text = des
        self.go_table.aortext_countDown.fontSize = size
    end
    --self.go_table.aortext_title.text = self.ctrl:GetName()
    self.go_table.aortext_rebate.text = self.ctrl:GetRebateNum()
    self.go_table.aortext_des.text = self.ctrl:GetRebateDes()
    self.go_table.aorbtn_getExp:SetActiveE(self.ctrl:IsShowBtnGetExp() and 1 or 0)
    self.go_table.aortext_lisTitle1.text = self.ctrl:GetLvTitle() 
    --self.go_table.aorrawimage_topBg:LoadImage(self.ctrl:GetIcon())
    --self.go_table.aorbtn_help:SetActiveE(self.ctrl:GetHelpId() and 1 or 0)
    self:UpdateView()
    self:InitEffect()
end

function TeamUniteBattlePassView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_wanchengrenwu,
            self.go_table.obj_EffNode,
            function (obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return false
                end
            end
    )
end

