---刷新战令
function TeamUniteBattlePassView:UpdateBattlePass()
    self.go_table.aortext_des.text = self.ctrl:GetRebateDes()
    self.isBuy = self.ctrl:CheckIsBuy()
    self.go_table.obj_senior:SetActiveE(self.isBuy and 0 or 1)
    local x, y, z = self.go_table.aorbtn_buy:GetLocalPosition()
    self.go_table.aorbtn_buy:SetLocalPosition(self.isBuy and 0 or 202, y, z)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetPriceByChannel(self.ctrl:GetPrice(), self.go_table.aortext_money)
    else
        self.go_table.aortext_money.text = self.ctrl:GetPrice()
    end

    self.awardCfgArray = self.ctrl:GetAwardList()

    self.awardLis = self.ctrl:GetAllUnlockAwards(self.lv)
    -- self.go_table.aorbtn_oneKey:SetActiveE(#self.awardLis > 1 and 1 or 0)
    self.go_table.aorbtn_oneKey:SetActiveE((self.isBuy and #self.awardLis > 1) and 1 or 0)
    self.go_table.aorbtn_buy:SetActiveE(self.isBuy and 0 or 1)
    self.go_table.obj_btns:SetActiveE(((self.isBuy and #self.awardLis > 1) or not self.isBuy) and 1 or 0)
    local jumpIndex = self:FindFirstAwardIndex()
    self.go_table.scrollloopvectical_items:SetRectTransformOffset(20,((self.isBuy and #self.awardLis > 1) or not self.isBuy) and 146 or 17,-20,-66)
    if not self.bpInit then
        self.go_table.scrollloopvectical_items:InitItemData(#self.awardCfgArray, _G.handler(self, self.RefreshList), jumpIndex)
        self.bpInit = true
    else
        self.go_table.scrollloopvectical_items:UpdateCount(#self.awardCfgArray, jumpIndex)
    end

    if not self.isBuy then
        if not self.seniorInit then
            self.seniorInit = true
            self.seniorAwards = self.ctrl:GetSeniorAwardList()
            self.go_table.scrollloophorizontal_seniorAward:InitItemData(#self.seniorAwards, _G.handler(self, self.RefreshSeniorItem))
        end
    end
end

function TeamUniteBattlePassView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local cfg = self.awardCfgArray[index]
    local id = cfg.id
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, cfg))

    local freeState, payState
    local lvEnough = self.ctrl:CheckItemCondition(cfg)
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isBuy) and ItemState.Unlock or ItemState.Lock
    tb.freeState = self.ctrl:CheckAwardIsGet(id, true) and ItemState.Received or freeState
    tb.payState = self.ctrl:CheckAwardIsGet(id, false) and ItemState.Received or payState

    local rewards = cfg.rewards_normal
    if not tb.item1 then
        tb.item1 = BaseAwardNewItem.New(tb.obj_item1, nil, 88, tb.obj_item1)
    end
    tb.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemLoadedCall, tb, false, 1, rewards[1]))

    rewards = cfg.rewards_pay[1]
    if not tb.item2 then
        tb.item2 = BaseAwardNewItem.New(tb.obj_item21, nil, 88, tb.obj_item21)
    end
    tb.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 21, rewards[1]))

    rewards = cfg.rewards_pay[2]
    tb.obj_item22:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item3 then
            tb.item3 = BaseAwardNewItem.New(tb.obj_item22, nil, 88, tb.obj_item22)
        end
        tb.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 22, rewards[1]))
    end

    ---是否显示第二个
    tb.obj_gou22:SetActiveE(rewards and 1 or 0)
    --tb.obj_suo22:SetActiveE(rewards and 1 or 0)

    ---已领打勾
    tb.obj_gou1:SetActiveE(tb.freeState == ItemState.Received and 1 or 0)
    tb.obj_gou2:SetActiveE(tb.payState == ItemState.Received and 1 or 0)
    ---可领
    tb.aorbtn_get:SetActiveE((tb.freeState == ItemState.Unlock or tb.payState == ItemState.Unlock) and 1 or 0)
    tb.aorbtn_notAchieved:SetActiveE(lvEnough and 0 or 1)
    if not _G.AppSetting.IsXzns then
        tb.aorbtn_notAchieved:SetGray(not lvEnough) 
    end
    
    tb.aorbtn_buySenior:SetActiveE((tb.freeState == ItemState.Received and tb.payState == ItemState.Lock) and 1 or 0)
    tb.aorimage_hasGetAll:SetActiveE((tb.freeState == ItemState.Received and tb.payState == ItemState.Received) and 1 or 0)
    ---未解锁上锁
    --tb.obj_suo1:SetActiveE(tb.freeState == ItemState.Lock and 1 or 0)
    --tb.obj_suo2:SetActiveE(tb.payState == ItemState.Lock and 1 or 0)

    tb.aortext_lv.text = self.ctrl:GetItemLvContent(index, cfg)
    --等级经验
    if _G.AppSetting.IsXzns then
        local exp = cfg.conditions[2]
        tb.aortext_lv.text = exp
        tb.obj_itemExp:SetActiveE(1)
    else
        if self.showItemExp then
            local exp = self.ctrl:GetLvExpByLv(cfg)
            tb.aortext_exp.text = exp
            tb.obj_itemExp:SetActiveE(1)
        else
            tb.obj_itemExp:SetActiveE(0)
        end
    end

    --进度条
    if _G.AppSetting.IsXzns then
        tb.aorimage_DayBar:SetActiveE(index == 1 and 0 or 1)
        if index - 1 < self.lv then
            tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
            tb.aorrawimage_lvBg:LoadImage("ImagesH5/hSpringFestival/ui_myzt_zljm_fk")
        elseif index - 1 == self.lv then
            local scale = self.curExp / self.curMaxExp
            tb.aorimage_dayBar:SetLocalScale(1, scale, 1)
            tb.aorrawimage_lvBg:LoadImage("ImagesH5/hSpringFestival/ui_myzt_zljm_fk2")
        else
            tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
            tb.aorrawimage_lvBg:LoadImage("ImagesH5/hSpringFestival/ui_myzt_zljm_fk2")
        end
    else
        tb.aorimage_DayBar:SetActiveE(index == 1 and 0 or 1)
        --tb.aorimage_DayBar:SetRectTransformSize(22, self.showItemExp and 78 or 85)
        if index - 1 < self.lv then
            tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
        elseif index - 1 == self.lv then
            local scale = self.curExp / self.curMaxExp
            tb.aorimage_dayBar:SetLocalScale(1, scale, 1)
        else
            tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
        end
    end
    return obj
end

function TeamUniteBattlePassView:RefreshSeniorItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.seniorAwards[index]
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(data, tb.obj_item, _G.handler(self, self.SeniorItemCall))
end

function TeamUniteBattlePassView:FindFirstAwardIndex()
    local maxIndex = self.isBuy and #self.awardCfgArray - 4 or #self.awardCfgArray - 3
    local index = self.ctrl:GetFirstAwardIndex(self.lv, self.awardCfgArray)
    return index > maxIndex and maxIndex - 1 or index - 1
end


