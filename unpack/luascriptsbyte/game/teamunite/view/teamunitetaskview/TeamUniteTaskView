local TeamUniteTaskModel = require "TeamUniteTaskModel"
---@class TeamUniteTaskView : UIBaseView	中文描述
---@field public go_table TeamUniteTaskView_GoTable GoTable
---@field cfg season_cfg
local TeamUniteTaskView = _G.BaseClass("TeamUniteTaskView", _G.UIBaseView)

local GetLangPackValue = _G.GetLangPackValue
function TeamUniteTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TeamUniteTaskView:OnCreate(hideFun, openFun)
    if hideFun then
        hideFun()
    end
    if openFun then
        self.openFun = openFun
    end
    self.Datas = {}
    self.ItemList = {}
    self.RewardItemList = {}
    self.RewardItemListMirror = {}
    self.BoxEffectList = {}
    self.LiuGuangEffectList = {}
    self:InitView()
end

function TeamUniteTaskView:OnDestroy()
    self.ItemList = nil
    self.RewardItemList = nil
    self.RewardItemListMirror = nil
    self.Datas = nil
    self.curIndex = nil
    self.CurIndex = nil
end

---初始化界面
function TeamUniteTaskView:InitView()
    self.Datas = TeamUniteTaskModel:GetInstance():GetTaskDatas()
    self.CurIndex = self:SetCurTaskingIndex() ---当前进行的最大index
    self.curIndex = self.CurIndex or 1
    self.go_table.scrollloopvectical_itemList:InitItemData(#self.Datas, _G.handler(self, self.RefreshItem), self
    .curIndex)
    self:InitEffect()
end

function TeamUniteTaskView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jijierenwy,
        self.go_table.obj_EffNode,
        function(obj)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(obj)
                return
            end
        end
    )
end

function TeamUniteTaskView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local data
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickIce, index))
    self.ItemList[index] = tb
    data = self.Datas[index]

    tb.aortext_title.text = GetLangPackValue(data.Cfg.desc)

    local IsGet = TeamUniteTaskModel:GetInstance():CheckIsGet(data.sid)
    local iscantake = TeamUniteTaskModel:GetInstance():CheckIsCanTake(data.sid)

    if iscantake then
        -- 能够领取
        tb.aorbtn_get:SetActiveE(1)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(0)
    elseif IsGet then
        -- 已经领取
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(0)
        tb.aorimage_got:SetActiveE(1)
    else
        -- 没有完成
        tb.aorbtn_get:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(1)
        tb.aorimage_got:SetActiveE(0)
        tb.aortext_title.text = tb.aortext_title.text .. string.format("(%d/%d)", data.i_task.target[1], data.Cfg.count)
    end
    tb.obj_awards:RemoveAllChildren()
    for _, v in pairs(data.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_awards,
            function(item)
                if not tb.obj_awards then
                    _G.DestoryObject(item)
                    return
                end
                item:SetGou(IsGet)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                item.gameObject:SetLocalScaleXYZ(0.8)
            end)
    end
end

---计算当前正在进行的任务索引
function TeamUniteTaskView:SetCurTaskingIndex()
    local index = 0
    if table.isEmptyOrNil(self.Datas) then
        return nil
    else
        for k, v in pairs(self.Datas) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
                if TeamUniteTaskModel:GetInstance():CheckIsCanTake(v.sid) then
                    break
                end
            elseif v.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                break
            end
            index = index + 1
        end
        return index
    end
end

---按钮点击事件在这里派发
function TeamUniteTaskView:ClickIce(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        local ids = {}
        for i = 1, #self.Datas do
            if TeamUniteTaskModel:GetInstance():CheckIsCanTake(self.Datas[i].sid) then
                table.insert(ids,{sid=self.Datas[i].sid,finish_type = 2})
            end
        end
        TeamUniteTaskModel:GetInstance():FinishTask(
            ids,
            function()
                self.go_table.scrollloopvectical_itemList:UpdateAllItem()
                local index = self:SetCurTaskingIndex()
                self.go_table.scrollloopvectical_itemList:ScrollToIndex(index)
                TeamUniteTaskModel:GetInstance():RefreshRedPoint()
                require("TeamUniteBattlePassModel"):GetInstance():RefreshRedPoint()
                
            end
        )
    elseif name == "@_aorbtn_go" then
        local link = self.Datas[index].Cfg.link
        if link > 0 then
            _G.JumpManager:GetInstance():Jump(
                link,
                function()
                    self:Close()
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SeasonView.Name)
                end
            )
        end
    end
end

---按钮点击事件在这里派发
function TeamUniteTaskView:OnClickBtn(go, isOn)
    if not self.isclick then
        if go == self.go_table.aorbtn_Back then
            self:Close()
            if self.openFun then
                self.openFun()
            end
        elseif go == self.go_table.aorbtn_close then
            self:Close()
            if self.openFun then
                self.openFun()
            end
        elseif go == self.go_table.aorbtn_close2 then
            self:Close()
            if self.openFun then
                self.openFun()
            end
        elseif go == self.go_table.aorbtn_way then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 44)
        end
    end
end

return TeamUniteTaskView
