---@class TeamUniteView : UIBaseView
local TeamUniteView = _G.BaseClass("TeamUniteView", _G.UIBaseView)

local model = require("TeamUniteModel"):GetInstance()

function TeamUniteView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function TeamUniteView:OnCreate()
    self:InitView()
end

function TeamUniteView:InitData()
    self:UpdateTime()
end

function TeamUniteView:InitView()
    self:InitData()
    self:FreshView()
    self:InitEffect()
end

function TeamUniteView:InitEffect()
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end
    local effBtnList = {1, 2, 5}
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_liuguangbeijin, self.go_table.obj_BgEff, check)
    for _, v in pairs(effBtnList) do
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_xiaoduijijieshi, self.go_table["obj_BtnEff_" .. v], check)
    end
end

function TeamUniteView:FreshView()
    self.go_table.obj_redpoint1:UpdateRedPointItemIDAndParam(model.activity.typeClass:GetRedpointIDByIndex(2))
    self.go_table.obj_redpoint2:UpdateRedPointItemIDAndParam(model.activity.typeClass:GetRedpointIDByIndex(3))
    self.go_table.obj_redpoint3:UpdateRedPointItemIDAndParam(model.activity.typeClass:GetRedpointIDByIndex(4))
end

---更新赛季事件
function TeamUniteView:UpdateTime()
    self.countDown = model:GetTime().endTime - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
end

function TeamUniteView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.Mathf.RoundToInt(self.countDown))
    if self.go_table then 
        self.go_table.aortext_time.text = _G.GetLangPackValue(
            90025800003, 
            _G.string.AddColor(time, _G.AppSetting.IsXzns and "FFFFFF" or "96CE51")
        )
    end
end

---更新按钮状态
function TeamUniteView:UpdateBtn()
end

function TeamUniteView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    end
    for i = 1, 5 do 
        if name == "@_aorbtn_" .. i then  
            model:OpenView(i)
        end 
    end
end

function TeamUniteView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return TeamUniteView