---@class TeamUniteLoginView : UIBaseView
---@field seasonCfg team_cfg
---@field cfg season_login_cfg
local TeamUniteLoginView = _G.BaseClass("TeamUniteLoginView", _G.UIBaseView)

local model = require("TeamUniteModel"):GetInstance()

function TeamUniteLoginView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eTeamUnite.Refresh, self.InitView, self)
    self.go_table.aorbtn_Get:SetActiveE(0)
end

function TeamUniteLoginView:OnCreate(hideFun, openFun)
    if hideFun then
        hideFun()
    end
    if openFun then
        self.openFun = openFun
    end
    self:InitView()
end

function TeamUniteLoginView:InitData()
    self.curSeason = model.seasonID
    self.curDay = model.curDay
    self.seasonCfg = _G.ConfigManager.team_cfg[self.curSeason]
    self.cfg = _G.ConfigManager.season_login_cfg
    self:UpdateTime()
end

function TeamUniteLoginView:InitView()
    self:InitData()
    self:FreshView()
    self:InitEffect()
end

function TeamUniteLoginView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_bingshuangbeijin,
            self.go_table.obj_EffNode,
            function(obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
            end
    )
end

---更新赛季事件
function TeamUniteLoginView:UpdateTime()
    self.countDown = model:GetTime().endTime - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
end

function TeamUniteLoginView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.Mathf.RoundToInt(self.countDown))
    if self.go_table then
        if _G.AppSetting.IsXzns then
            self.go_table.aortext_time.text = time
            _G.GameUtil.ReBuildRTF(self.go_table.obj_TimeBg)
        else
            self.go_table.aortext_time.text = _G.GetLangPackValue(90025800003, _G.string.AddColor(time, "96CE51"))
        end
    end
end

---更新按钮状态
function TeamUniteLoginView:UpdateBtn()
    local hasAward = self:GetAwardState()
    require("RedPointManager"):GetInstance():RefreshNode(model.activity.typeClass:GetRedpointIDByIndex(2))
    self.go_table.obj_redPoint:SetActiveE(hasAward and 1 or 0)
    self.go_table.aorimage_Get:SetGray(not hasAward)
    self.go_table.aorimage_Get.color = _G.ColorTools.FormatColorByString(hasAward and "FFFFFF" or "A9A9A9")
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_Get.color = _G.ColorTools.FormatColorByString(hasAward and "FFFFFF" or "434343")
        self.go_table.aortext_Get:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient)).enabled = hasAward
    else
        self.go_table.aortext_Get.color = _G.ColorTools.FormatColorByString(hasAward and "8C2D14" or "434343")
    end
end

---更新单个奖励显示
function TeamUniteLoginView:UpdateAward(index)
    local tb = _G.GetAutoGoTable(self.go_table["obj_Award_" .. index], _G.handlerbind(self, self.GetAllAward))
    local isGet = model:CheckGetLoginAward(index)
    local canGet = not isGet and self.curDay >= index
    tb.aorbtn_Click:SetActiveE(canGet and 1 or 0)
    tb.obj_isGet:SetActiveE(isGet and 1 or 0)
    tb.aortext_Day.text = _G.GetLangPackValue(90023800006, index)
    tb.obj_AwardRoot:ClearChildren()
    local item = require("BaseAwardNewItem").New(tb.obj_AwardRoot)
    item:ShowWithID(self.cfg[self.seasonCfg.login[index]].rewards[1])
    if _G.AppSetting.IsXzns then
        if isGet then
            tb.aorimage_Bg.SpriteName = "myzt_xsqd_db_01"
            tb.aortext_state:SetActiveE(0)
        elseif canGet then
            tb.aortext_state.text = _G.GetLangPackValue(90023900016)
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                item.gameObject,
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                    trans:SetLocalScaleXYZ(1.1)
                end
            )
            self.hasAward = true
        else
            tb.aortext_state.text = _G.GetLangPackValue(90025800006)
        end
    else
        if canGet then
            tb.aortext_Day.text = _G.GetLangPackValue(90028500022)
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, item.gameObject)
            self.hasAward = true
        end
    end
end

---合并奖励
function TeamUniteLoginView:AddAward(source, new)
    local result = source
    local ItemDic = {}
    for k, v in pairs(source.award.item) do
        local type = v.type[1]
        if not ItemDic[type] then
            ItemDic[type] = k
        end
    end
    for _, v in pairs(new.award.item) do
        local type = v.type[1]
        if ItemDic[v.type[1]] then
            local Dic = ItemDic[type]
            local Item = result.award.item[Dic]
            result.award.item[Dic].type[2] = Item.type[2] + v.type[2]
            result.award.item[Dic].type[3] = Item.type[3] + v.type[2]
        else
            local count = #result.award.item + 1
            result.award.item[count] = { type = {} }
            for i = 1, 5 do
                table.insert(result.award.item[count].type, v.type[i])
            end
            ItemDic[type] = #result.award.item
        end
    end

    return result
end

---检测指定期数是否有可领取奖励
function TeamUniteLoginView:GetAwardState()
    for i = 1, 5 do
        if model:CheckCanTakeLoginAward(i) then
            return true
        end
    end
    return false
end

---一键领取
function TeamUniteLoginView:GetAllAward()
    if not self.hasAward then
        return
    end
    local canGet = {}
    local indexT = {}
    for i = 1, 5 do
        if model:CheckCanTakeLoginAward( i) then
            _G.table.insert(canGet, self.seasonCfg.login[i])
            _G.table.insert(indexT, i)
        end
    end
    require("TeamUniteNet"):GetInstance():GetSignReward(
        { activity_id = model:GetActivityID(),index = canGet },
        function (msg)
            if msg.ack == 1 then
                for k, _index in ipairs(canGet) do
                    model.signAward[_index] = true
                    self:UpdateAward(indexT[k])
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                for k, v in pairs(msg.award.item) do
                    if v.type[1] == 71 then
                        require("FlyingChessModel"):GetInstance():AddCoin(v.type[2])
                    end
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:UpdateBtn()
                self:InitView()
            end
        end
    )
end

---切换期数
function TeamUniteLoginView:FreshView()
    self.hasAward = false
    for i = 1, 5 do
        self:UpdateAward(i)
    end
    self.go_table.aorbtn_Get:SetActiveE(1)
    self:UpdateBtn()
end

function TeamUniteLoginView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
        if self.openFun then
            self.openFun()
        end
    elseif name == "@_aorbtn_Get" then
        if not self.hasAward then
            _G.PopWindowManager:GetInstance():ShowAllTips(25)
            return
        else
            self:GetAllAward()
        end
    end
end

function TeamUniteLoginView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eTeamUnite.Refresh, self.InitView, self)
end

return TeamUniteLoginView