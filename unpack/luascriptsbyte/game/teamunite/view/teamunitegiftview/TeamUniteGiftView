function TeamUniteGiftView:OnClick_item(itemGoTable, isOn, data)
    if data.price_id == 0 then
        MallManager:GetInstance():Buy(data.id, function(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            MallManager:GetInstance():OnUpMallBuy(msg, data.id)
            self:OnMallCashListener(msg)
        end)
    else
        MallManager:GetInstance():BuyActiveGift(data.price_id, nil, data.id)
    end
    self.buyData = data
end

function TeamUniteGiftView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@aorbtn_Close" then
        self:CloseView()
    elseif name == "@_aorbtn_guanbi" then
        self:CloseView()
    end
end

function TeamUniteGiftView:OnMallCashListener(data)
    for k, v in pairs(data.award.item) do
        if v.type[1] == 71 then
            require("FlyingChessModel"):GetInstance():AddCoin(v.type[2])
        end
    end
    --更新礼包状态
    self:UpdateView(true)
    --刷新抽奖次数
    if self.call then
        self.call()
    end
    local TeamUniteGiftModel = require("TeamUniteGiftModel"):GetInstance()
    TeamUniteGiftModel:RefreshRedPoint()
end

---函数功能注释
function TeamUniteGiftView:SortGiftData(call)
    _G.SortList(
        self.infocfgsDown,
        function(data)
            local buyCount = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset) or 0
            local state = buyCount >= data.count_limit and 0 or 1
            return state, -data.id
        end
    )
    if call then
        call()
    end
end

function TeamUniteGiftView:EscClose()
    self:CloseView()
end

function TeamUniteGiftView:CloseView()
    self:Close()
end

function TeamUniteGiftView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.eTeamUnite.Refresh, self.InitView, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:CloseView()
end

return TeamUniteGiftView
