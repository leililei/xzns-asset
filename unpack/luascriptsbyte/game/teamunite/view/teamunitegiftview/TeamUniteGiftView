function TeamUniteGiftView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsDown[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    local node = itemGoTable.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.goods do
        local award = data.goods[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award,
            node,
            function(item)
                item.gameObject:SetLocalScale(0.9, 0.9, 0.9)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local cfg = item.cfg or item.data.cfg
                item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                if _G.AppSetting.IsXzns then
                    local getNode = item.go_table.obj_gou
                    local isGet = getNode:GetChildCountE() > 0 and getNode:GetChildE(0) or nil
                    if not isGet then
                        isGet = _G.InstantiateObject(itemGoTable.obj_isGet, getNode)
                    end
                    isGet:SetActiveE(data.count_limit - MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset) <= 0 and 1 or 0)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
            end
        )
    end

    ---@type number 付费礼包存储在Model中, 免费礼包存储在MallManager中, 需要单独处理
    local buyCount
    --if data.price > 0 then
    --    buyCount = DrawModel:GetInstance():GetGiftBuyCount(data.id)
