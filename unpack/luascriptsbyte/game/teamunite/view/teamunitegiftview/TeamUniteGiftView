local TeamUniteGiftView = _G.BaseClass("TeamUniteGiftView", _G.UIBaseView)
local model = require("TeamUniteGiftModel"):GetInstance()
local MallManager = require("MallManager")

function TeamUniteGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.eTeamUnite.Refresh, self.InitView, self)
end

function TeamUniteGiftView:OnCreate(call)
    self.call = call
    --self.go_table.aortext_time.text = _G.GetLangPackValue(90000011174)
    self.countDown = require "TeamUniteModel":GetInstance():GetTime().endTime - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
    self:InitView()
end

---更新赛季时间
function TeamUniteGiftView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local time = _G.TimeUtil.TranslateSecondForStrMiaoHui(_G.Mathf.RoundToInt(self.countDown))
    if self.countDown > 0 then
        if self.go_table then
            self.go_table.aortext_Timer.text = string.format("%s%s", _G.GetLangPackValue(90000000988), _G.string.AddColor(time, "96CE51"))  
        end
    else
        self:Close()
    end
end

function TeamUniteGiftView:InitView()
    model:GetDataFromCfg()
    self:UpdateView()
    self:InitEffect()
end

function TeamUniteGiftView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_chaozhi,
        self.go_table.obj_EffNode,
        function(obj)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(obj)
                return
            end
        end
    )
end

function TeamUniteGiftView:UpdateView(updateFlag)
    self.infocfgs = model.model_cfg or {}

    --策划说第一个礼包有特殊框体
    self.infocfgsTop = { self.infocfgs[1] }
    self.infocfgsDown = {}

    local FisrtItemCfg = self.infocfgs[1]
    local FisrtBuyCount = MallManager:GetInstance():GetItemBuyTimes(FisrtItemCfg.id, FisrtItemCfg.type_reset)
    if FisrtItemCfg.count_limit - FisrtBuyCount == 0 then
        for i = 1, #self.infocfgs do
            _G.table.insert(self.infocfgsDown, self.infocfgs[i])
        end
    else
        for i = 2, #self.infocfgs do
            _G.table.insert(self.infocfgsDown, self.infocfgs[i])
        end
    end
    local topHeight, itemHeight
    if FisrtBuyCount == FisrtItemCfg.count_limit then
        topHeight = 0
        itemHeight = _G.AppSetting.IsXzns and 708 or 620
    else
        topHeight = 194
        itemHeight = _G.AppSetting.IsXzns and 530 or 440
    end

    self:SortGiftData(function()
        if FisrtBuyCount ~= self.FisrtBuyCount then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(topHeight)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(itemHeight)
            self.FisrtBuyCount = FisrtBuyCount
        end
    end)
    if updateFlag then
         if #self.infocfgsDown ~= self.infoCount then
            self.go_table.scrollloopvectical_item:UpdateCount(#self.infocfgsDown)
        else
            self.go_table.scrollloopvectical_item:UpdateAllItem()
        end
        self.go_table.scrollloopvectical_top:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_top:InitItemData(#self.infocfgsTop, _G.handler(self, self.RefreshListTop))
        self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
    end
    self.infoCount = #self.infocfgsDown
end


