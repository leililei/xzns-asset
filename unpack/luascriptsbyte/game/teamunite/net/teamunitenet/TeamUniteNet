local base = require "BaseGameNet"
---@class TeamUniteNet : BaseGameNet	通信协议
local TeamUniteNet = _G.BaseClass("TeamUniteNet", base)

---@return TeamUniteNet TeamUniteNet
function TeamUniteNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取签到奖励
function TeamUniteNet:GetSignReward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_checkers_sign_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---战令领奖
function TeamUniteNet:GetBattlePassReward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_checkers_battle_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---交任务领奖
function TeamUniteNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_checkers_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end


---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TeamUniteNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type TeamUniteNet
_G.TeamUniteNet = TeamUniteNet
return TeamUniteNet
