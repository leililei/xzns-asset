---检测是否有可领取的奖励
function TeamUniteModel:CheckHaveSignReward()
    if not self.cfg then
        return false
    end
    for _, v in pairs(self.cfg.login) do
        local cfg = _G.ConfigManager.season_login_cfg[v]
        if cfg then
            if self:CheckCanTakeLoginAward(cfg.day) then
                return true
            end
        end
    end
    return false
end

function TeamUniteModel:GetTotalCoin()
    return self.infoData.battle_info[1].battle_exp or 0
end

function TeamUniteModel:AddCoin(data)
    for _, v in pairs(data) do
        if v.type[1] ==  _G.ResPropID.TeamUniteExp then
            self.infoData.battle_info[1].battle_exp = self.infoData.battle_info[1].battle_exp + v.type[2]
        end
    end
end

return TeamUniteModel
