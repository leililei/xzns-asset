---购买经验
function TeamUniteBattlePassModel:GetBuyExp(lv, consume)
    ---@type store_season_battle.c2s_store_season_battle_buy_exp
    local pbdata = {}
    pbdata.lv = lv
    require("SeasonLvNet"):GetInstance():GetBuyExp(
        pbdata,
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, consume)
                self:OnSixClockUpdate(_G.handler(self, self.OnInitFunction))
            end
        end
    )
end

---领奖
---@param id number 奖励id
---@param isUp boolean 奖励类型 true，豪华
function TeamUniteBattlePassModel:GetAward(id, isUp)
    ---@type store_season_battle.c2s_store_season_battle_award
    local pbdata = {
        activity_id = require("TeamUniteModel"):GetInstance():GetActivityID(),
        award_ids = {id},
        type = isUp and 2 or 1,
        battle_sid = self.store.sid
    }
    require("TeamUniteNet"):GetInstance():GetBattlePassReward(
        pbdata,
        function(data)
            if data.ack == 1 then
                self:SetAward(id, isUp)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                self:UpdataView()
                self:RefreshRedPoint()

            end
        end
    )
end

---一键领奖
---@param id number 奖励id
---@param isUp boolean 奖励类型 true，豪华
function TeamUniteBattlePassModel:GetAwardAll(awards, call)
    local pbdata = {
        activity_id = require("TeamUniteModel"):GetInstance():GetActivityID(),
        type = self:GetIsUp() and 3 or 1,
        award_ids = awards,
        battle_sid = self.store.sid
    }

    require("TeamUniteNet"):GetInstance():GetBattlePassReward(
        pbdata,
        function(data)
            if data.ack == 1 then
                self:SetAllAward()
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                for k, v in pairs(data.award.item) do
                    if v.type[1] == 71 then
                        require("FlyingChessModel"):GetInstance():AddCoin(v.type[2])
                    end
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                self:OnSixClockUpdate(_G.handler(self, self.OnInitFunction))
                self:RefreshRedPoint()
                if call then 
                    call()
                end
            end
        end
    )
end
---获取等级
---@return  number,number,number  等级, 当前经验, 最大经验
function TeamUniteBattlePassModel:GetLvExp(sumexp)
    if not self.countCfgArr then
        ---@type store_season_battle_cfg
        local cfg = _G.ConfigManager.store_season_battle_cfg[self.store.sid]
        local content = table.values(cfg.content)
        --table.sort(content)
        local conIds = content

        local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
        ---@type store_season_battlecon_cfg[]
        self.countCfgArr = {}
        ---@type store_season_battlecon_cfg
        local cfgItem
        local id
        for i = 1, #conIds do
            id = conIds[i]
            if id == nil or id == 0 then
                if _G.AppSetting.DEBUG then
                    _G.LogError(" 配置id 无效  store_season_battlecon_cfg.content id:" .. tostring(id))
                end
                cfgItem = nil
            else
                cfgItem = store_season_battlecon_cfg[conIds[i]]
            end
            if cfgItem then
                table.insert(self.countCfgArr, cfgItem)
            end
        end
    end

    local lv = 0
    local max = 0
    local exp = 0
    local sumexp = sumexp or require("TeamUniteModel"):GetInstance():GetTotalCoin()
    local cfginfo
    for i = 1, #self.countCfgArr do
        cfginfo = self.countCfgArr[i]
        local subexp = cfginfo.conditions[2]
        if subexp == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("未配置经验 store_season_battlecon_cfg." .. cfginfo.id)
            end
            subexp = 0
            sumexp = 0
        end
        if sumexp >= subexp then
            lv = cfginfo.level
        else
            exp = sumexp - subexp
            max = subexp
            break
        end
    end

    return lv, exp, max
end

