function TeamUniteBattlePassModel:CheckRedPoint()
    --判断是否存在赛季活动
    if not self:CheckIsOpen() then
        return false
    end
    -- --判断是否存在赛季战令并且未点击过
    -- local redCheckOpen = _G.PlayerPrefsManager.GetInt("TeamUniteLv" .. self.store.sid, 0)
    -- if redCheckOpen == 0 then
    --     return true
    -- end
    --判断是否有可领取
    local lv = self:GetLvExp()
    local id = self.store.sid
    ---@type store_season_battle_cfg
    local cfg = _G.ConfigManager.store_season_battle_cfg[id]
    local content = cfg.content
    local isCanGet = false
    for i = 1, #content do
        local info = _G.ConfigManager.store_season_battlecon_cfg[content[i]]
        if lv >= info.level then
            local isGet1 = require("TeamUniteBattlePassModel"):GetInstance():IsAward(info.id, false)
            if not isGet1 then
                isCanGet = true
                break
            end
            local isGet2 = require("TeamUniteBattlePassModel"):GetInstance():IsAward(info.id, true)
            if not isGet2 and self:GetIsUp() then
                isCanGet = true
                break
            end
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log(isCanGet, "是否可以领取战令")
    end
    return isCanGet
end

