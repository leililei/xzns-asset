---数据解析完成
---@param data TeamUniteBattlePassModel_storeinfo
function TeamUniteBattlePassModel:ParseData(data)
    self.isOpen = data ~= nil

    data = data or {}
    local parameters = require("TeamUniteModel"):GetInstance():GetCfg()
    self.redPointId = require("TeamUniteModel"):GetInstance():GetRedpointIDByIndex(3)
    --- 战令id
    self.store.sid = parameters.store_battle_pass[1]

    self.store.time = data.time or 0
    self.store.is_buy = data.pay and 1 or 0

    ---当前玩家累计经验
    self.store.exp = require("TeamUniteModel"):GetInstance():GetTotalCoin() or 0

    if data.free_award ~= nil then
        for i = 1, #data.free_award do
            self:SetAward(data.free_award[i], false)
        end
    end

    if data.pay_award ~= nil then
        for i = 1, #data.pay_award do
            self:SetAward(data.pay_award[i], true)
        end
    end

    local seasonCfg = require("TeamUniteModel"):GetInstance():GetCfg()
    self.EndTime = require("TeamUniteModel"):GetInstance():GetEndTime()

    if _G.PlayerPrefsManager.GetInt("TeamUniteLvStart", 0) == 0 then
        if self.isOpen then
            _G.PlayerPrefsManager.SetInt("TeamUniteLv" .. self.store.sid, 0)
        else
            _G.PlayerPrefsManager.SetInt("TeamUniteLv" .. self.store.sid, 1)
        end
        _G.PlayerPrefsManager.SetInt("TeamUniteLvStart", 1)

    end

    self.super.ParseData(self)
end

