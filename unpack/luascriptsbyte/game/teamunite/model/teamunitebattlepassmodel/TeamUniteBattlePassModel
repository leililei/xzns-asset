    self:UpdataView()
end

function TeamUniteBattlePassModel:UpdataView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TeamUniteBattlePassView.Name)
    if view then
        view:UpdataView()
    end
end

---打开界面
function TeamUniteBattlePassModel:OpenView()
    _G.PlayerPrefsManager.SetInt("TeamUniteLv" .. self.store.sid, 1)

    if self.isOpen ~= true then
        _G.PopWindowManager:GetInstance():ShowAllTips(400101)
        return
    end
    if self.EndTime <= _G.TimeUtil.GetServerUnixTime() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620101)
        return
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamUniteBattlePassView.Name)
end

---@return boolean true已购买豪华
function TeamUniteBattlePassModel:GetIsUp()
    return self.store.is_buy == 1
end

function TeamUniteBattlePassModel:SetIsUp()
    self.store.is_buy = 1
    self:RedCheck()
end

---是否领取奖励
function TeamUniteBattlePassModel:IsAward(id, isUp)
    if isUp then
        return self.store.up_award_list[id] == true
    else
        return self.store.normal_award_list[id] == true
    end
end

function TeamUniteBattlePassModel:CheckUpArawd(id)
    if self:GetIsUp() and not self.store.up_award_list[id] then
       return true
    end

    return false
end

---获取未领取的奖励id列表
---@param countCfgArr store_battle_content_cfg 配置
---@return aidList 奖励id列表
function TeamUniteBattlePassModel:GetAwardList(countCfgArr)
    local aidList = {}
    for _, v in ipairs(countCfgArr) do
        local isPass = require("TeamUniteModel"):GetInstance():GetTotalCoin() >= v.conditions[2]
        if isPass and (not self:IsAward(v.id) or self:CheckUpArawd(v.id)) then
            _G.table.insert(aidList, v.id)
        end
    end
    return aidList
end

---设置已领取
function TeamUniteBattlePassModel:SetAward(id, isUp)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogError("TeamUniteBattlePassModel:SetAward id无效:" .. tostring(id))
        end
        return
    end
    if isUp then
        self.store.up_award_list[id] = true
    else
        self.store.normal_award_list[id] = true
    end
end

---设置所有满足条件的奖励为已购买
function TeamUniteBattlePassModel:SetAllAward()
    local lv = self:GetLvExp()
    local id = self.store.sid
    ---@type store_season_battle_cfg
    local cfg = _G.ConfigManager.store_season_battle_cfg[id]
    local content = cfg.content
    for i = 1, #content do
        local info = _G.ConfigManager.store_season_battlecon_cfg[content[i]]
        if lv >= info.level then
            self:SetAward(info.id, false)
            if self:GetIsUp() then
                self:SetAward(info.id, true)
            end
        end
    end
end

function TeamUniteBattlePassModel:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_season_battle_cfg[data.sid]
    if cfg ~= nil and data.sid==self.store.sid then
        self:SetIsUp()
        self:RefreshRedPoint()
    end
end

