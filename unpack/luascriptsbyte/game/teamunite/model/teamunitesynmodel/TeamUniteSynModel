local base = require("ActivitySynTypeBase")
---@class TeamUniteSynModel : ActivitySynTypeBase	中文描述
---@field redpointId number 子功能红点的父红点id
local TeamUniteSynModel = _G.BaseClass("TeamUniteSynModel",base)

---类的构造函数
function TeamUniteSynModel:__init()
    ---@type TeamUniteModel
    self.model = require("TeamUniteModel"):GetInstance()
end

function TeamUniteSynModel:GetDataFormServer()
    base.ParseData(self)
end

function TeamUniteSynModel:OnHandleGMData()
    self.model:GetInfoCall(self.curActivityClass)
end

function TeamUniteSynModel:InitRedPointTree()

    self.redpointTree = {{2,3,4,5,6,7},false,false,{5,6,7},false,false,false}
end

function TeamUniteSynModel:CheckRedPointNumChild(index,param)
    if index == 2 then
        return require("TeamUniteModel"):GetInstance():CheckHaveSignReward() and 1 or 0
    elseif index == 3 then
        self.ctrl = require("TeamUniteBpFdController").New()
        self.ctrl:InitData()
        local t = self.ctrl:GetAllUnlockAwards() or {}
        return #t > 0 and 1 or 0
    elseif index == 5 then
        return require("TeamUniteGiftModel"):GetInstance():CheckFreeGift() and 1 or 0
    elseif index == 6 then
        return require("TeamUniteTaskModel"):GetInstance():IsCanTake() and 1 or 0
    elseif index == 7 then
        local model = require "FlyingChessModel":GetInstance()
        if model.circle then
            return (_G.StorageManager:GetOtherItemCountBySid(71)>=10 and model.circle<=model.maxcircle) and 1 or 0
        end
        return 0
    end
    return 0
end

