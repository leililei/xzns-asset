---从配置表读取数据
---@private
function TeamUniteGiftModel:GetDataFromCfg()
    self.model_cfg = {}
    local TeamUniteModelIns = require "TeamUniteModel":GetInstance()
    ---@type store_active_cfg[]
    local cfgs = _G.ConfigManager.store_active_cfg
    local active = TeamUniteModelIns:GetCfg().active
    ---@type store_active_cfg
    local tempCfg
    for _, v in pairs(active) do
        tempCfg = cfgs[v]
        _G.table.insert(self.model_cfg, tempCfg)
    end
    self.model_cfg = _G.table.toArray(self.model_cfg)
end

