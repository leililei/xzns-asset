---是否存在可/未充值项
---@return boolean 是否存在可充值项
function TeamUniteGiftModel:CheckOtherConditionExtra()
    local flag = false
    for i = 1, #self.model_cfg do
        local data = self.model_cfg[i]
        local buyNum = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset)
        if buyNum ~= data.count_limit then
            flag = true
            break
        end
    end
    return flag
end

---是否存在免费礼包可领取
---@return boolean 是否存在免费礼包可领取
function TeamUniteGiftModel:CheckFreeGift()
    local flag = false
    for i = 1, #self.model_cfg do
        local data = self.model_cfg[i]
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(data.price_id)
        if finalPrice <= 0 then 
            local buyNum = MallManager:GetInstance():GetItemBuyTimes(data.id, data.type_reset)
            if buyNum ~= data.count_limit then
                flag = true
                break
            end
        end
    end
    return flag
end

---返回礼包sid的购买次数
---@param sid number 礼包Sid
---@return number 已购买次数
function TeamUniteGiftModel:GetItemBuyTimes(sid)
    if self.buyTimes and self.buyTimes[sid] then
        return self.buyTimes[sid]
    end
    local data = _G.ConfigManager.store_active_cfg[sid]
    local buyNum = MallManager:GetInstance():GetItemBuyTimes(sid, data.type_reset)
    return buyNum or 0
end

---充值
function TeamUniteGiftModel:Recharge(giftInfo, call)
    local cfg = _G.ConfigManager.store_active_cfg[giftInfo.id]
    MallManager:GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
end


