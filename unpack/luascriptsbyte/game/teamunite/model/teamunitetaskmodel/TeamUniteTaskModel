function TeamUniteTaskModel:OnTaskAaction(id, parmas)
    if not self.MissionCfg then
        return
    end
    local cfg = _G.ConfigManager.mission_extra_cfg
    for k, v in pairs(self.MissionCfg) do
        if cfg[v].condition[1][1] == id[1] then
            self:RefreshRedPoint()
        end
    end
end

