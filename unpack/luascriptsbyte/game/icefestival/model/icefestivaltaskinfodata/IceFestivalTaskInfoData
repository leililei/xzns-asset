---@class IceFestivalTaskInfoData
local IceFestivalTaskInfoData = _G.BaseClass("IceFestivalTaskInfoData",  _G.LogicClass)

function IceFestivalTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function IceFestivalTaskInfoData:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.IceFestivalTaskView.Name, self.curActivityClass)
end
---领取奖励
function IceFestivalTaskInfoData:GetAward(ids, call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            for _, v in pairs(ids) do
                self.activity.finishTask[v] = true
            end
            local activity =
                require "ActivitySynManager":GetInstance():GetChildAcitivity(
                self:GetJumpModelType(),
                self.curActivityClass:GetJumpType()
            )
            local ActivityID = activity:GetActivityID()
            local coins = {}
            local exp = 0
            for _, v in pairs(self.activity.taskList) do
                if _G.table.ContainsValue(ids, v.i_task.sid) then
                   local data = self.activity:GetCfg(v.i_task.sid)
                   if data.other_award then
                        if data.other_award[2] then 
                            local coinId = 106 --默认值
                            if data.other_award[3] then
                                coinId = data.other_award[3].num
                            end
                            if coins[coinId] == nil then
                                coins[coinId] = 0
                            end
                            coins[coinId] = coins[coinId] + data.other_award[2].num
                            _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, {coinId, data.other_award[2].num})
                            local tb = _G.StorageManager:GetInstance():SimulationAward(coinId, data.other_award[2].num)
                            msg.award = msg.award or {}
                            msg.award.item = msg.award.item or {}
                            _G.table.insert(msg.award.item, {type = tb})
                        end
                        if data.other_award[1] then 
                            exp = exp + data.other_award[1].num
                        end
                    end

                end
            end
            --require "IceFestivalPuzzleManager":GetInstance():SetCoin(coins)
            require "CommonTipManager".OpenCommonAwardView(msg)
            require "JointActivityDrawUpModel":GetInstance():AddExp(ActivityID, exp)
            self.activity:RefreshRedPoint()
            if call then
                call()
            end
        end
    )
end
function IceFestivalTaskInfoData:GetJumpModelType()
    return 10044
end
return IceFestivalTaskInfoData
