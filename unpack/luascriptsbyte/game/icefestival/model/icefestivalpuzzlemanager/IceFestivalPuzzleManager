local ActivitySynManager = require "ActivitySynManager"
---@class IceFestivalPuzzleManager : Singleton	中文描述
local IceFestivalPuzzleManager = _G.BaseClass("IceFestivalPuzzleManager", _G.GameDataModelBase)
_G.IceFestivalPuzzleManager = IceFestivalPuzzleManager

---@return IceFestivalPuzzleManager IceFestivalPuzzleManager
function IceFestivalPuzzleManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function IceFestivalPuzzleManager:__init()
    self.viewList = {}
    _G.Events:GetInstance():AddListener(_G.eArena.SetDrawUp, self.AddCoins, self)
end

function IceFestivalPuzzleManager:GetInfoCall(info, curActivityClass)
   self.viewList = _G.string.split(curActivityClass.cfg.info.front.precast, "#")
    self.curActivityClass = curActivityClass
    local data = info.puzzle
    self.indexes = {}
    if data.indexes then
        for _, v in ipairs(data.indexes) do
            self.indexes[v] = true
        end
    end
    self.puzzle_awards = {}
    if data.puzzle_awards then
        for _, v in ipairs(data.puzzle_awards) do
            self.puzzle_awards[v] = true
        end
    end
    self.puzzles = {}
    for _, v in ipairs(data.cfg_puzzles) do
        self.puzzles[v.index] = v
    end
    self.awards = {}
    for _, v in ipairs(data.cfg_awards) do
        self.awards[v.index] = v
    end
    -- self.coin1_id = data.coin1_id
    -- self.coin2_id = data.coin2_id
    self.coins = {}
    -- self.coins[data.coin1_id] = data.coin_1 or 0
    -- self.coins[data.coin2_id] = data.coin_2 or 0
    for i = 1, #data.coin do 
        self["coin"..i.."_id"] = data.coin[i].k
        self.coins[data.coin[i].k] = data.coin[i].v or 0
    end
    self.buy_consume = data.buy_consume
    self.day_limit = data.day_limit
end

function IceFestivalPuzzleManager:AddCoins(data)
    for k, v in pairs(self.coins) do 
        if data[1] == k then 
            local coin = {}
            coin[data[1]] = data[2]
            self:SetCoin(coin)
            self.curActivityClass.typeClass:UpdateRedpoint()
            break
        end
    end
end

function IceFestivalPuzzleManager:GetViewByIndex(index)
    return self.viewList[index]
end

---点亮拼图
---@param callback function 回调
function IceFestivalPuzzleManager:UnlockIndex(index, callback)
    require "IceFestivalPuzzleNet":GetInstance():UnlockIndex(
        {activity_id = self.curActivityClass:GetActivityID(), index = index},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.indexes[index] = true
            local data = self.puzzles[index]
            _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, {self["coin"..data.type.."_id"], -data.num})
            require "CommonTipManager".OpenCommonAwardView(msg)
            if callback then
                callback()
            end
        end
    )
end

function IceFestivalPuzzleManager:UpdateRedpoint()
    self.curActivityClass.typeClass:UpdateRedpoint()
end

---领取奖励
---@param callback function 回调
function IceFestivalPuzzleManager:GetAward(index, callback)
    self.curActivityClass.typeClass:GetActivityAward({1, index}, function(msg)
        if msg.ack ~= 1 then 
            return 
        end
        self.puzzle_awards[index] = true
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        if callback then
            callback(msg)
            self.curActivityClass.typeClass:UpdateRedpoint()
        end
    end
    )
end

---购买道具
---@param callback function 回调
function IceFestivalPuzzleManager:BuyAward(sid, num, callback)
    self.curActivityClass.typeClass:GetActivityAward({2, sid, num}, function(msg)
        if callback then
            callback(msg)
            self.curActivityClass.typeClass:UpdateRedpoint()
        end
    end
    )
end

---获取拼图信息
function IceFestivalPuzzleManager:GetPuzzleData()
    return self.puzzles
end

---获取拼图信息
function IceFestivalPuzzleManager:GetBoxData(index)
    local data = {}
    data.progress = 1
    data.received = self.puzzle_awards[index]
    if self.puzzle_awards[index] == nil then
        for _, v in ipairs(self.awards[index].conditions) do
            if self.indexes[v] == nil then
                data.progress = 0
                break
            end
        end
    end
    return data
end
 
 ---获取奖励信息
 function IceFestivalPuzzleManager:GetAwardsData()
     return self.awards
 end

---自身活动代币增加（如锻造豪礼）
function IceFestivalPuzzleManager:SetCoin(coins)
    if coins then
        for k, v in pairs(coins) do
            if self.coins[k] then
                self.coins[k] = self.coins[k] + v
                local tmp = {}
                _G.table.insert(tmp, k)
                _G.table.insert(tmp, v)
                _G.table.insert(tmp, self.coins[k])
                _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
            end
        end
        self.curActivityClass.typeClass:UpdateRedpoint()
    end
end

---获取拼图道具1
function IceFestivalPuzzleManager:GetCoinNum1()
    return self.coins[self["coin1_id"]]
end


---获取拼图道具1 ID
function IceFestivalPuzzleManager:GetCoin1()
    return self["coin1_id"]
end

---获取拼图道具2
function IceFestivalPuzzleManager:GetCoinNum2()
    return self.coins[self["coin2_id"]]
end

function IceFestivalPuzzleManager:GetNeedCoinNum()
    local needNum = 0
    for i = 1, 20 do 
        if self.indexes[i] == nil then
            needNum = needNum + self.puzzles[i].num
        end
    end
    local num = needNum - self:GetCoinNum1() 
    local one = self:GetUnlockOneCoinNum()
    if num > 0 then 
        num = _G.math.ceil(num / one) * one
    end
    return num < 0 and 0 or num 
end

function IceFestivalPuzzleManager:GetUnlockOneCoinNum()
    for i = 1, 20 do 
        if self.indexes[i] == nil then
            return self.puzzles[i].num
        end
    end
    return self.puzzles[1].num
end

---获取点亮消耗
function IceFestivalPuzzleManager:GetComsume(index)
    if index then 
        return self.puzzles[index].num
    else 
        return self.puzzles[1].num
    end
end

function IceFestivalPuzzleManager:GetRedPointNum()
    if not require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10039) then
        return 0
    end
    for i = 1, 9 do
        if self.puzzle_awards[i] == nil then
            local isCanGet = true
            for _, v in ipairs(self.awards[i].conditions) do
                if self.indexes[v] == nil then
                    isCanGet = false
                    break
                end
            end
            if isCanGet then
                return 1
            end
        end
    end
    for i = 1, 20 do
        local iscanClick = false
        if self.indexes[i] == nil then
            local data = self.puzzles[i]
            local sid = self["coin"..data.type.."_id"]
            iscanClick = self.coins[sid] >= IceFestivalPuzzleManager:GetInstance():GetUnlockOneCoinNum()
        end
        if iscanClick then
            return 1
        end
    end
    return 0
end

function IceFestivalPuzzleManager:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

---销毁对象时,析构函数
function IceFestivalPuzzleManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eArena.SetDrawUp, self.AddCoins, self)
end

return IceFestivalPuzzleManager
