local IceFestivalPuzzleManager = require "IceFestivalPuzzleManager"
local base = require "ActivitySynTypeBase"
local ActivitySynManager = require("ActivitySynManager")
---@class IceFestivalPuzzleModel : Component	中文描述
local IceFestivalPuzzleModel = _G.BaseClass("IceFestivalPuzzleModel", base)

---创建对象时,入口构造函数
function IceFestivalPuzzleModel:OnCreate()
end

function IceFestivalPuzzleModel:OnHandleGMData(info)
    self:ParseData(info)
end

function IceFestivalPuzzleModel:ParseData(info)
    self.activity = self.curActivityClass
    self.activityID = self.curActivityClass.activityID
    base.ParseData(self)
    require "IceFestivalPuzzleManager":GetInstance():GetInfoCall(info, self.curActivityClass)
end

---进入活动主体
function IceFestivalPuzzleModel:OnEnterActivity()
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10007, self.activity:GetJumpType(self.activityID))
    _G.UIManager:GetInstance():OpenWindow(IceFestivalPuzzleManager:GetInstance():GetViewByIndex(1), activity)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function IceFestivalPuzzleModel:OnGetMainViewName()
    return IceFestivalPuzzleManager:GetInstance():GetViewByIndex(1)
end

---绑定子活动
function IceFestivalPuzzleModel:GetOtherActivityRedPointIds()
    return {10007}
end

---初始化红点
function IceFestivalPuzzleModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckPuzzleReward}
    self.redpointTree = {false, false}
end

---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function IceFestivalPuzzleModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function IceFestivalPuzzleModel:UpdateRedpoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointPuzzle.id)
end

function IceFestivalPuzzleModel:CheckPuzzleReward()
    local puzzleRed = IceFestivalPuzzleManager:GetInstance():GetRedPointNum()
    return puzzleRed > 0 and 1 or 0
end
function IceFestivalPuzzleModel:IsShowBtn()
    return false
end


---销毁对象时,析构函数
function IceFestivalPuzzleModel:OnDestroy()
end

return IceFestivalPuzzleModel
