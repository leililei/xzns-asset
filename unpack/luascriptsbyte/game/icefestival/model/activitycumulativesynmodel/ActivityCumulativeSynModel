---灵兽效率
---@param order number 灵兽品质
---@param star number 灵兽星级
---@param type number k效率 v加成 不传同时获取两个数据
function ActivityCumulativeSynModel:GetPetEfficiency(order, star, type)
    local id = order * 100 + star
    if type then
        return self.petEfficiency[id] and self.petEfficiency[id][type] or 0
    end
    return self.petEfficiency[id] or {}
end

---神器效率
---@param order number 神器品质
---@param star number 神器星级
---@param type number k效率 v加成 不传同时获取两个数据
function ActivityCumulativeSynModel:GetArtifactEfficiency(order, star, type)
    local id = order * 100 + star
    if type then
        return self.artifactEfficiency[id] and self.artifactEfficiency[id][type] or 0
    end
    return self.artifactEfficiency[id] or {}
end

---每分钟的总效率/总加成
---@param type number 1效率 2效率加成
function ActivityCumulativeSynModel:GetTotalEfficiency(type)
    local total = 0
    for _, v in pairs(self.artifactSlots) do
        if v.artifact then
            local config = _G.ConfigManager.artifact_cfg[v.artifact.sid]
            total = total + self:GetArtifactEfficiency(config.Order, v.artifact.star, type)
        end
    end
    for _, v in pairs(self.petSlots) do
        if v.pet then
            local config = _G.ConfigManager.pet_cfg[v.pet.sid]
            total = total + self:GetPetEfficiency(config.Order, v.pet.star, type)
        end
    end
    return total
end

---总收益
function ActivityCumulativeSynModel:GetTotalAward(serverTime, totalEfficiency, bonus)
    local endTime = self.awardTime + self.maxTime
    if serverTime > endTime then
        serverTime = endTime
    end
    local time = serverTime - self.previewTime
    if time < 0 then
        time = 0
    end
    local num = _G.Mathf.Floor(time / 60) * (totalEfficiency / 10000)
    return _G.Mathf.Floor(num * (1 + bonus / 10000)) + self.previewAward
end

---最大收益
function ActivityCumulativeSynModel:GetMaxAwardRedTime()
    return self.awardTime + self.maxTime*0.8
end

---最大收益时间
function ActivityCumulativeSynModel:GetMaxTime()
    return self.maxTime
end

---上一次领奖的收益时间
function ActivityCumulativeSynModel:GetPreviewTime()
    return self.previewTime
end

function ActivityCumulativeSynModel:GetEfficiencyEndTime()
    return self.awardTime + self.maxTime
end

---当前收益时间
function ActivityCumulativeSynModel:GetCurEfficiencyTime()
    local time = _G.TimeUtil.GetServerUnixTime() - self.awardTime
    if time > self.maxTime then
        time = self.maxTime
    end
    return time
end

---是否有收益产出
function ActivityCumulativeSynModel:CheckHaveEfficiency()
    if _G.table.isEmptyOrNil(self.artifactSlots) and _G.table.isEmptyOrNil(self.petSlots) then
        return true
    end
    return false
end

---放置
function ActivityCumulativeSynModel:PutSlot(slotIndex, data, type, callBack)
    local slotId
    if type == self.type.Artifact then
        ---叠加的神器上阵后神器就会独立；独立神器需要判断背包是否有足够的空间
        if data.sid == data.uid and not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, 1) then
            _G.PopWindowManager:GetInstance():ShowAllTips(270801)
            return
        end
        slotId = self:GetArtifactSlotId(slotIndex)
    else
        slotId = self:GetPetSlotId(slotIndex)
    end
    if not slotId or slotId <= 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("ActivityCumulativeSynModel:PutSlot 找不到槽位id的配置")
        end
        return
    end
    local slots = {
        { slot_id = slotId, uid = data.uid or data.sid }
    }
    require("IceFestivalNet"):GetInstance():PutSlot(
        { activity_id = self.activityId, slots = slots },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:ParseRoleInfo(msg.role_info)
            if type == self.type.Artifact then
                self:ParseArtifactUnstack(msg.uid_change, { data })
            end
            _G.Events:GetInstance():Broadcast(_G.eIceFestival.PutSlot, type, slotIndex)
            if callBack then
                callBack()
            end
        end
    )
end

---卸下
function ActivityCumulativeSynModel:TakeOffSlot(slotIndex, type, callBack)
    local slotId
    if type == self.type.Artifact then
        slotId = self:GetArtifactSlotId(slotIndex)
    else
        slotId = self:GetPetSlotId(slotIndex)
    end
    require("IceFestivalNet"):GetInstance():TakeOffSlot(
        { activity_id = self.activityId, slot_id = { slotId } },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:ParseRoleInfo(msg.role_info)
            if msg.add_num and msg.add_num > 0 then
                self:ShowAward(msg.add_num)
            end
            _G.Events:GetInstance():Broadcast(_G.eIceFestival.TakeOffSlot, type, slotIndex)
            if callBack then
                callBack()
            end
        end
    )
end

---一键放置
---@param datas (ArtifactData|PetData)[]
---@param isReplace boolean 空槽位是否置空, 默认false
function ActivityCumulativeSynModel:PutAllSlots(datas, type, callback, isReplace)
    local maxSlotIndex = 6 --最大槽位序号

    local slots = {}
    if type == self.type.Artifact then
        local freeNum, isStack = 1, false
        for slotIndex = 1, maxSlotIndex do
            local slotId = self:GetArtifactSlotId(slotIndex)
            if slotId then
                ---叠加的神器上阵后神器就会独立；独立神器需要判断背包是否有足够的空间
                local canPut = false
                if datas[slotIndex] then
                    canPut = datas[slotIndex].sid ~= datas[slotIndex].uid
                    if not canPut then
                        if _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, freeNum) then
                            freeNum = freeNum + 1
                            canPut = true
                        else
                            isStack = true --有堆叠中的神器
                        end
                    end
                end
                if canPut then
                    local v = datas[slotIndex]
                    table.insert(slots, { slot_id = slotId, uid = v.uid or v.sid })
                elseif isReplace then
                    table.insert(slots, { slot_id = slotId, uid = 0 })
                end
            end
        end
        if #slots <= 0 and isStack then
            _G.PopWindowManager:GetInstance():ShowAllTips(270801)
            if callback then
                callback(nil)
            end
            return
        end
    else
        for slotIndex = 1, maxSlotIndex do
            local slotId = self:GetPetSlotId(slotIndex)
            if slotId then
                if datas[slotIndex] then
                    local uid = datas[slotIndex].uid or datas[slotIndex].sid
                    table.insert(slots, { slot_id = slotId, uid = uid })
                elseif isReplace then
                    table.insert(slots, { slot_id = slotId, uid = 0 })
                end
            end
        end
    end
    if #slots <= 0 then
        return
    end
    require("IceFestivalNet"):GetInstance():PutSlot(
        { activity_id = self.activityId, slots = slots },
        function(msg)
            if not msg or msg.ack ~= 1 then
                if callback then
                    callback(msg)
                end
                return
            end
            self:ParseRoleInfo(msg.role_info)
            if type == self.type.Artifact then
                self:ParseArtifactUnstack(msg.uid_change, datas)
            end
            for slotIndex = 1, maxSlotIndex do
                _G.Events:GetInstance():Broadcast(_G.eIceFestival.PutSlot, type, slotIndex)
            end
            if callback then
                callback()
            end
        end
    )
end

---一键卸载
function ActivityCumulativeSynModel:TakeOffAllSlots(type, callback)
    local maxSlotIndex = 6 --最大槽位序号

    ---遍历所有槽位
    local slotIds = {}
    if type == self.type.Artifact then
        if self.artifactSlots then
            for slotIndex = 1, maxSlotIndex do
                local slotId = self:GetArtifactSlotId(slotIndex)
                if slotId and self.artifactSlots[slotIndex] then
                    table.insert(slotIds, slotId)
                end
            end
        end
    else
        if self.petSlots then
            for slotIndex = 1, maxSlotIndex do
                local slotId = self:GetPetSlotId(slotIndex)
                if slotId and self.petSlots[slotIndex] then
                    table.insert(slotIds, slotId)
                end
            end
        end
    end
    if #slotIds <= 0 then
        if callback then
            callback(nil)
        end
        return
    end

    require("IceFestivalNet"):GetInstance():TakeOffSlot(
        { activity_id = self.activityId, slot_id = slotIds },
        function(msg)
            if msg.ack ~= 1 then
                if callback then
                    callback(msg)
                end
                return
            end
            self:ParseRoleInfo(msg.role_info)
            if msg.add_num and msg.add_num > 0 then
                self:ShowAward(msg.add_num)
            end
            for slotIndex = 1, maxSlotIndex do
                _G.Events:GetInstance():Broadcast(_G.eIceFestival.PutSlot, type, slotIndex)
            end
            if callback then
                callback()
            end
        end
    )
end

---领奖
function ActivityCumulativeSynModel:GetCumulativeAward(callBack)
    require("IceFestivalNet"):GetInstance():GetCumulativeAward(
        { activity_id = self.activityId },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:ParseRoleInfo(msg.role_info)
            if msg.add_num and msg.add_num > 0 then
                self:ShowAward(msg.add_num)
            end
            self:RefreshRedPoint(1)
            self:SetAwardTimer()
            if callBack then
                callBack()
            end
        end
    )
end

function ActivityCumulativeSynModel:ShowAward(addNum)
    local msg = {}
    msg.award = {}
    msg.award.item = {}
    local tb = _G.StorageManager:GetInstance():SimulationAward(
        self.coinType,
        addNum
    )
    _G.table.insert(msg.award.item, { type = tb })
    _G.UIUtils.ShowCommonAward(msg)
end

---百分比转换
function ActivityCumulativeSynModel:formatDecimalToString(num)
    -- 使用 string.format 保留两位小数
    local formatted = _G.string.format("%.1f", num)
    -- 移除末尾的零
    formatted = formatted:gsub("0*$", "")
    -- 如果小数点后面没有数字，则移除小数点
    if formatted:sub(-1) == "." then
        formatted = formatted:sub(1, -2)
    end
    return formatted
end

