    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(param))
end

---进入活动刷新红点
function ActivityCumulativeSynModel:RefreshFirstRedPoint()
    if _G.PlayerPrefsManager.GetInt("ActivityCumulativeSynModel_" .. self.activityId, 0) == 0 then
        _G.PlayerPrefsManager.SetInt("ActivityCumulativeSynModel_" .. self.activityId, 1)
        self:RefreshRedPoint(1)
    end
end

---销毁对象时,析构函数
function ActivityCumulativeSynModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.send_cumulative_award_change.Cmd, self.OnCumulativeAwardChange, self)
    _G.Events:GetInstance():RemoveListener(_G.eArena.SetDrawUp, self.OnLimitedExchange, self)
    _G.Events:GetInstance():RemoveListener(_G.ArtifactShow.GainArtifact, self.RefreshRedPoint, self)
    _G.Events:GetInstance():RemoveListener(_G.ePetUpStar.PetUpStarRefresh, self.RefreshRedPoint, self)
end

return ActivityCumulativeSynModel
