local base = require "ActivitySynTypeBase"
---@class ActivityCumulativeSynModel : ActivitySynTypeBase	锁心试炼-挂机收益
---@field artifactSlotCfg activity_cumulative_award.i_slot_cfg 神器槽位配置
---@field petSlotCfg activity_cumulative_award.i_slot_cfg 灵兽槽位配置
---@field awardTime number 上次领奖时间戳
---@field previewTime number 上次奖励结算时间戳
---@field artifactSlots activity_cumulative_award.i_slot 神器槽位信息
---@field petSlots activity_cumulative_award.i_slot 灵兽槽位信息
---@field coinType number 代币类型
---@field maxTime number 最大挂机时间
local ActivityCumulativeSynModel = _G.BaseClass("ActivityCumulativeSynModel", base)

---创建对象时,入口构造函数
function ActivityCumulativeSynModel:__init()
    self.activityId = self.curActivityClass:GetActivityID()
    self.type = {
        Artifact = 1,
        Pet = 2
    }
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.send_cumulative_award_change.Cmd, self.OnCumulativeAwardChange, self)
    _G.Events:GetInstance():AddListener(_G.eArena.SetDrawUp, self.OnLimitedExchange, self)
    _G.Events:GetInstance():AddListener(_G.ArtifactShow.GainArtifact, self.RefreshRedPoint, self)
    _G.Events:GetInstance():AddListener(_G.ePetUpStar.PetUpStarRefresh, self.RefreshRedPoint, self)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
end

function ActivityCumulativeSynModel:OnActivityStateChanged(state)
    if state == require("ActivitySynManager").State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(self.viewName or _G.ConfigManager.ui_cfg.ActivityCumulativeAwardView.Name)
        if view then
            view:OnCloseActivity(self.activityId)
        end
        require("ActivityCumulativeModel"):GetInstance():OnCloseActivity(self.activityId)
    end
end

---数据变更推送
function ActivityCumulativeSynModel:OnCumulativeAwardChange(msg)
    if msg.activity_id == self.activityId then
        self:ParseRoleInfo(msg.role_info)
    end
end

function ActivityCumulativeSynModel:OnLimitedExchange(param)
    if param[1] and self.coinType == param[1] then
        self.coinNum = self.coinNum + param[2]
        local tmp = {}
        _G.table.insert(tmp, self.coinType)
        _G.table.insert(tmp, param[2])
        _G.table.insert(tmp, self.coinNum)
        _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, { { type = tmp } })
    end
end

---获取GM数据
function ActivityCumulativeSynModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function ActivityCumulativeSynModel:ParseData(info)
    if info.cumulative_award then
        local slotCfg = info.cumulative_award.slot_cfg or {}
        if not self.petEfficiency then
            self.petEfficiency = {}
        end
        if not self.artifactEfficiency then
            self.artifactEfficiency = {}
        end
        for _, v in pairs(slotCfg) do
            ---@type slot_type 槽位类型1:神器 2:灵兽
            if v.slot_type == self.type.Artifact then
                self.artifactSlotCfg = v.slots
                if v.efficiencies then
                    for _, value in pairs(v.efficiencies) do
                        self.artifactEfficiency[value.sid] = value.efficiency_value
                    end
                end
            elseif v.slot_type == self.type.Pet then
                self.petSlotCfg = v.slots
                if v.efficiencies then
                    for _, value in pairs(v.efficiencies) do
                        self.petEfficiency[value.sid] = value.efficiency_value
                    end
                end
            end
        end
        self.coinType = info.cumulative_award.coin_type
        self.maxTime = info.cumulative_award.max_time

        local roleInfo = info.cumulative_award.role_info or {}
        self:ParseRoleInfo(roleInfo)
    end
    require("ActivityCumulativeModel"):GetInstance():ParseData(self.curActivityClass)
    self:SetAwardTimer()
    base.ParseData(self)
end

---红点计时
function ActivityCumulativeSynModel:SetAwardTimer()
    if self.efficiencyTimer then
        self.efficiencyTimer:Stop()
        self.efficiencyTimer = nil
    end
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local maxTime = self:GetMaxAwardRedTime()
    if serverTime < maxTime then
        self.efficiencyTimer = _G.TimerManager:GetInstance():GetTimer(1, function()
            if _G.TimeUtil.GetServerUnixTime() >= maxTime then
                self:RefreshRedPoint(1)
                self.efficiencyTimer:Stop()
                self.efficiencyTimer = nil
            end
        end, self, false, false)
        self.efficiencyTimer:Start()
    end
end

function ActivityCumulativeSynModel:ParseRoleInfo(roleInfo)
    self.awardTime = roleInfo.award_time
    self.previewTime = roleInfo.preview_time
    self.previewAward = roleInfo.preview_award or 0
    local isChange = self.coinNum == nil or (roleInfo.coin_num ~= nil and self.coinNum ~= roleInfo.coin_num)
    self.coinNum = roleInfo.coin_num or 0
    local slots = roleInfo.slots or {}
    self.artifactSlots = {}
    self.petSlots = {}
    for _, v in pairs(slots) do
        if v.slot_type == self.type.Artifact then
            local index = _G.table.indexof(self.artifactSlotCfg, v.slot_id)
            if index then
                self.artifactSlots[index] = v
            end
        elseif v.slot_type == self.type.Pet then
            local index = _G.table.indexof(self.petSlotCfg, v.slot_id)
            if index then
                self.petSlots[index] = v
            end
        end
    end
    self:RefreshRedPoint(1)
    _G.Events:GetInstance():Broadcast(_G.eIceFestival.RefreshCumulativeAward, isChange)
end

---锁心猎场, 上阵堆叠神器后变成独立实例
---@param changeUids public.i_kv_64 中文描述
---@param datas ArtifactData[]
function ActivityCumulativeSynModel:ParseArtifactUnstack(changeUids, datas)
    if not changeUids then
        return
    end
    local uids = {}
    for _, d in pairs(changeUids) do
        uids[d.key] = d.value
    end
    for _, data in pairs(datas) do
        if data.sid == data.uid and uids[data.sid] then
            local newMsg = data.GetMsg(data)
            local newData = _G.ArtifactData.New()
            newData:Parse(newMsg)
            newData.uid = uids[data.sid]
            _G.StorageManager:GetInstance():AddItemByArtifactData(newData)
            _G.StorageManager:GetInstance():ConsumeItem(data.sid, data.uid, 1)
        end
    end
end

