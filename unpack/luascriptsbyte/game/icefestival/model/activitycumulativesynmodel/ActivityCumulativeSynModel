---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ActivityCumulativeSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---是否有可装上的神器
function ActivityCumulativeSynModel:CheckArtifactRedPoint()
    local time = self.curActivityClass.cfg.time
    if (time.start_time + time.run_time) < _G.TimeUtil.GetServerUnixTime() then
        return 0
    else
        local haveEmptySlot = #self.artifactSlotCfg == _G.table.count(self.artifactSlots)
        if not haveEmptySlot then
            local slotArtifactUid = {}
            for _, v in pairs(self.artifactSlots) do
                if v.artifact then
                    slotArtifactUid[v.artifact.uid] = true
                end
            end
            local allArtifact = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
            for _, v in pairs(allArtifact) do
                if not slotArtifactUid[v.uid] then
                    return 1
                end
            end
        end
        return 0
    end
end

---灵兽红点
function ActivityCumulativeSynModel:CheckPetRedPoint()
    local time = self.curActivityClass.cfg.time
    if (time.start_time + time.run_time) < _G.TimeUtil.GetServerUnixTime() then
        return 0
    else
        local haveEmptySlot = #self.petSlotCfg == _G.table.count(self.petSlots)
        if not haveEmptySlot then
            local slotPetSid = {}
            for _, v in pairs(self.petSlots) do
                if v.pet then
                    slotPetSid[v.pet.sid] = true
                end
            end
            local allPet = require("PetModel"):GetInstance():GetAllActivePets()
            for _, v in pairs(allPet) do
                if not slotPetSid[v.sid] then
                    return 1
                end
            end
        end
        return 0
    end
end

---奖励红点
function ActivityCumulativeSynModel:CheckAwardRedPoint()
    local time = self.curActivityClass.cfg.time
    if (time.start_time + time.run_time) < _G.TimeUtil.GetServerUnixTime() then
        return 0
    else
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        local maxTime = self:GetMaxAwardRedTime()
        if serverTime >= maxTime then
            return 1
        end
        return 0
    end
end

function ActivityCumulativeSynModel:CheckRedPoint()
    local time = self.curActivityClass.cfg.time
    if (time.start_time + time.run_time) < _G.TimeUtil.GetServerUnixTime() then
        return 0
    else
        local firstStatus = _G.PlayerPrefsManager.GetInt("ActivityCumulativeSynModel_" .. self.activityId, 0)
        if firstStatus == 0 then
            return 1
        end


        if self:CheckArtifactRedPoint() == 1 then
            return 1
        end

        if self:CheckPetRedPoint() == 1 then
            return 1
        end

        if self:CheckAwardRedPoint() == 1 then
            return 1
        end

        return 0
    end
end

