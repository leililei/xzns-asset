--region=======网络接口============================

---领取宝箱进度奖励
---@param index number 宝箱序号
---@param callback fun(msg: public.s2c_common_ack):void
function ActivityTrialSynModel:GetBoxAward(index, callback)
    local sid = self.cfg.self_info.celebration_single.cfg_award[index].sid
    local pbData = { activity_id = self.activityId, id = sid }
    require("ActivityTrialNet"):GetInstance():GetAward(
        pbData,
        function(data)
            if data.ack ~= 1 then
                return
            end
            local otherAward = { award = { item = {} } }
            local newAward = { award = { item = {} } }
            if data.award then
                for _, v in pairs(data.award.item) do
                    if v.type[1] == 0 then
                        _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.type[3], v.type[4] })
                        local tb = _G.StorageManager:GetInstance():SimulationAward(
                            v.type[3],
                            v.type[4]
                        )
                        _G.table.insert(newAward.award.item, { type = tb })
                    else
                        _G.table.insert(newAward.award.item, v)
                        _G.table.insert(otherAward.award.item, v)
                    end
                end
            end
            if not _G.table.isEmptyOrNil(otherAward.award.item) then
                _G.StorageManager:GetInstance():ReceiveAwardData(otherAward)
            end

            --记录缓存
            if not self.receivedBoxAward then
                self.receivedBoxAward = {}
            end
            table.insert(self.receivedBoxAward, sid)

            --刷新红点信息
            self:RefreshRedPoint(1)
            if callback then
                callback(newAward)
            end
        end
    )
end

---获取排行榜数据
---@param page number 页码
function ActivityTrialSynModel:GetRankInfo(page, callback)
    require("ActivityTrialNet"):GetInstance():GetRankInfo(
        { id = self.activityId, page = page },
        function(data)
            if callback then
                callback(data)
            end
        end
    )
end

function ActivityTrialSynModel:GetSelfRank(callback)
    require("ActivityTrialNet"):GetInstance():GetSelfRank(
        { type = self.activityId },
        function(data)
            if callback then
                callback(data)
            end
        end
    )
end

function ActivityTrialSynModel:PlayBack(uid)
    require("ActivityTrialNet"):GetInstance():PlayBack(
        { activity_id = self.activityId, uid = uid },
        function(msg)
            if msg.ack == 1 then
                self.fight_arg = msg.data
                self:UpdateData(_G.BattleManager:GetInstance():GetStatisticsRecord(msg.data))
            end
        end
    )
end

function ActivityTrialSynModel:UpdateData(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(90022100129)
        return
    end
    self.maxCountRank = _G.table.count(data.FighterInfo)
    self.PveData = {}
    local damage, win = _G.GameUtil.ShowStatisticsView(data)
    self.PveData = damage
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        win,
        function() end,
        nil,
        self.otherPlayer,
        1,
        true,
        self.fight_arg
    )
end

--endregion

function ActivityTrialSynModel:CheckRedPoint()
    local firstStatus = _G.PlayerPrefsManager.GetInt("ActivityTrialSynModel_" .. self.activityId, 0)
    if firstStatus == 0 then
        return 1
    end

    local stage = _G.PlayerPrefsManager.GetInt(
        string.format("ActivityTrialView_%s", self.activityId),
        0
    )
    if stage ~= self:GetBossInfo() then
        return 1
    end

    if self:CheckTaskRedPoint() == 1 then
        return 1
    end

    for index, _ in pairs(self.celebrationSingle.cfg_award) do
        if self:CheckBoxAwardState(index) == 2 then
            return 1
        end
    end

    return 0
end

function ActivityTrialSynModel:CheckTaskRedPoint()
    for _, v in pairs(self.taskList) do
        if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
            return 1
        end
    end
    return 0
end

---刷新奖励红点
function ActivityTrialSynModel:RefreshRedPoint(param)
    local id = self:GetRedpointIDByIndex(param or 1) or 0
    require("RedPointManager"):GetInstance():RefreshNode(id)
end

---进入活动刷新红点
function ActivityTrialSynModel:RefreshFirstRedPoint()
    if _G.PlayerPrefsManager.GetInt("ActivityTrialSynModel_" .. self.activityId, 0) == 0 then
        _G.PlayerPrefsManager.SetInt("ActivityTrialSynModel_" .. self.activityId, 1)
        self:RefreshRedPoint(1)
    end
end

---销毁对象时,析构函数
function ActivityTrialSynModel:Dispose()
end

return ActivityTrialSynModel
