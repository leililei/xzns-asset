local base = require "ActivitySynTypeBase"
---@class ActivityTrialSynModel : ActivitySynTypeBase	雪域欢歌-雪域试炼
---@field activityId number
---@field cfg activity.i_activity
---@field receivedBoxAward number[] 已领取的宝箱奖励
---@field damage number 今日最高伤害
---@field curTaskValue any[] 任务列表
---@field taskList any[] 任务列表
local ActivityTrialSynModel = _G.BaseClass("ActivityTrialSynModel", base)

---创建对象时,入口构造函数
function ActivityTrialSynModel:__init()
    self.activityId = self.curActivityClass:GetActivityID()
    self.cfg = self.curActivityClass.cfg
end

---获取GM数据
function ActivityTrialSynModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
---@param info activity.i_activity_self_info
function ActivityTrialSynModel:ParseData(info)
    if self.cfg then
        self.cfg.self_info = info
    end
    self.celebrationSingle = info.celebration_single or {}
    self.receivedBoxAward = info.celebration_single.times_award or {}
    self.damage = info.celebration_single.day_high_dps or 0
    self.bossData = info.celebration_single.cfg_boss or {}
    self.finishList = info.celebration_single.finish or {}
    self.allPassTimes = info.celebration_single.all_pass_times
    self.fightAwardTimes = info.celebration_single.fight_times_cfg - info.celebration_single.fight_times
    if self.fightAwardTimes < 0 then
        self.fightAwardTimes = 0
    end
    _G.SortList(
        self.bossData,
        function(data)
            return -data.continue_time[1]
        end
    )
    self.maxBossStage = _G.table.count(self.bossData)

    self:InitTask(info.celebration_single.curr, info.celebration_single.cfg_task)
    base.ParseData(self)
end

--region=======重写父类方法=========================

function ActivityTrialSynModel:OnEnterActivity()
    local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if _type == _G.JointActivityType.SummerFire then
        self.viewName = _G.ConfigManager.ui_cfg.SummerFireTrialView.Name
    else
        self.viewName = _G.ConfigManager.ui_cfg.ActivityTrialView.Name
    end
    _G.UIManager:GetInstance():OpenWindow(self.viewName, self.curActivityClass)
    self:RefreshFirstRedPoint()
    base.OnEnterActivity(self)
end

function ActivityTrialSynModel:OnGetMainViewName()
    local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if _type == _G.JointActivityType.SummerFire then
        return _G.ConfigManager.ui_cfg.SummerFireActivityView.Name
    else
        return _G.ConfigManager.ui_cfg.IceFestivalActivityView.Name
    end
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ActivityTrialSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint, self.CheckTaskRedPoint }
    self.redpointTree = { { 2 }, false }
end

---隐藏按钮
function ActivityTrialSynModel:IsShowBtn()
    return false
end

---检测红点
---@param index number 红点类型序列号
---@return number 红点数量
function ActivityTrialSynModel:CheckRedPointNumChild(index)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return nil
end

--endregion


--region=======任务接口============================

---解析战斗结果（任务用）
---@param msg fight.s2c_fight_result
function ActivityTrialSynModel:ParseFightResult(msg)
    if not msg or msg.ack ~= 1 then
        return
    end
    if not self.taskList then
        return
    end
    for _, v in pairs(self.taskList) do
        if v.i_task.state ~= _G.TaskEnum.ETaskState.Completed then
            if v.i_task.sid == 1 then
                v.i_task.target[1] = v.i_task.target[1] + 1
            elseif v.i_task.sid == 2 then
                if v.i_task.target[1] < msg.args[1] / 1000 then
                    v.i_task.target[1] = Mathf.Floor(msg.args[1] / 1000)
                end
            elseif v.i_task.sid == 3 then
                if v.i_task.target[1] < msg.atk_dps then
                    v.i_task.target[1] = msg.atk_dps
                end
            end
            if v.i_task.target[1] >= v.count and v.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                v.i_task.state = _G.TaskEnum.ETaskState.Submited
            end
        end
    end
    self:RefreshRedPoint(2)
end

---初始化任务
---@private
---@param curr public.i_kv_64[]
---@param taskData activity_theme.i_celebration_task[]
function ActivityTrialSynModel:InitTask(curr, taskData)
    self.curTaskValue = {}
    if curr then
        for _, v in pairs(curr) do
            if v.key == 2 then
                self.curTaskValue[v.key] = math.floor(v.value / 1000)
            else
                self.curTaskValue[v.key] = v.value
            end
        end
    end

    self.taskList = {}
    _G.SortList(
        taskData,
        function(a)
            return a.condition[1], a.condition[2]
        end
    )
    for _, v in pairs(taskData) do
        local item = {}
        item.type = v.condition[1]
        item.count = v.condition[2]
        item.award = v.award
        local task = {}
        task.sid = v.sid
        task.target = { self.curTaskValue[task.sid] or 0 }
        task.time = 0
        task.state = self:GetTaskState(task.sid, item.count, task.target[1])
        item.i_task = task
        _G.table.insert(self.taskList, item)
    end
end

---获取任务状态
---@private
---@return TaskEnum.ETaskState
function ActivityTrialSynModel:GetTaskState(sid, target, cur)
    if _G.table.ContainsValue(self.finishList, sid) then
        return _G.TaskEnum.ETaskState.Completed
    elseif cur >= target then
        return _G.TaskEnum.ETaskState.Submited
    else
        return _G.TaskEnum.ETaskState.Claimed
    end
end

---获取任务列表
---@return any[]
function ActivityTrialSynModel:GetTaskList()
    return self.taskList
end

---获取所有能够获取奖励的任务sid
---@return number[]
function ActivityTrialSynModel:GetAllCanGetAwardTaskSidList()
    local tb = {}
    local insert = _G.table.insert
    local state = _G.TaskEnum.ETaskState.Submited
    for _, v in pairs(self.taskList) do
        if v.i_task.state == state and not _G.table.ContainsValue(self.finishList, v.i_task.sid) then
            insert(tb, v.i_task.sid)
        end
    end
    return tb
end

---完成任务
---@param sids number[]
function ActivityTrialSynModel:FinishTask(sids, callback)
    local pbData = { activity_id = self.activityId, sid = sids }
    require("ActivityTrialNet"):GetInstance():FinishTask(
        pbData,
        function(msg)
            --获取奖励
            local otherAward = { award = { item = {} } }
            local newAward = { award = { item = {} } }
            if msg.award then
                for _, v in pairs(msg.award.item) do
                    if v.type[1] == 0 then
                        _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.type[3], v.type[4] })
                        local tb = _G.StorageManager:GetInstance():SimulationAward(
                            v.type[3],
                            v.type[4]
                        )
                        _G.table.insert(newAward.award.item, { type = tb })
                    else
                        _G.table.insert(newAward.award.item, v)
                        _G.table.insert(otherAward.award.item, v)
                    end
                end
            end
            if not _G.table.isEmptyOrNil(otherAward.award.item) then
                _G.StorageManager:GetInstance():ReceiveAwardData(otherAward)
            end

            --更新任务状态
            if self.taskList then
                for _, task in pairs(self.taskList) do
                    if _G.table.ContainsValue(sids, task.i_task.sid) then
                        task.i_task.state = _G.TaskEnum.ETaskState.Completed
                    end
                end
            end
            --刷新红点
            self:RefreshRedPoint()
            self:RefreshRedPoint(2)

            if callback then
                callback(newAward)
            end
        end
    )
end

--endregion

--region=======数据接口============================

---获取当前挑战boss的序号和阶段
---固定每三天轮换boss, 且每天更换一个阶段
---@return number,number @(0,0)表示没有任何可用boss
function ActivityTrialSynModel:GetBossInfo()
    --获取当前boss信息
    local index = self.maxBossStage
    for idx, cfg in ipairs(self.bossData) do
        if cfg.boss_id == self.celebrationSingle.boss_id then
            index = idx
            break
        end
    end
    return index
end

---获取活动开启时长(秒)
---@return number
function ActivityTrialSynModel:GetOpenDuration()
    local duration = _G.TimeUtil.GetServerUnixTime() - _G.TimeUtil.GetDayBySix(self.cfg.time.start_time)
    if duration <= 0 then
        duration = 1
    end
    return duration
end

---获取活动剩余时长(秒)
---@return number
function ActivityTrialSynModel:GetRemainDuration()
    local overtime = _G.TimeUtil.GetDayBySix(self.cfg.time.start_time) + self.cfg.time.run_time
    local remain = overtime - _G.TimeUtil.GetServerUnixTime()
    if remain <= 0 then
        remain = 0
    end
    return remain
end

---获取宝箱奖励进度百分比
---@return number 返回值0-100
function ActivityTrialSynModel:GetBoxAwardPercentage()
    return self.allPassTimes
end

function ActivityTrialSynModel:AddPassTime(num)
    self.allPassTimes = self.allPassTimes + num
end

function ActivityTrialSynModel:ConsumeFightAwardTimes()
    self.fightAwardTimes = self.fightAwardTimes - 1
    if self.fightAwardTimes < 0 then
        self.fightAwardTimes = 0
    end
end

function ActivityTrialSynModel:GetAllPassTimes(call)
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.activityId,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local selfInfo = msg.activity[1].self_info
            if selfInfo then
                self.allPassTimes = selfInfo.celebration_single.all_pass_times
            end
            _G.Events:GetInstance():Broadcast(_G.eCelebration.CelebrationHotChange)
            if call then
                call()
            end
        end
    )
end

function ActivityTrialSynModel:GetFightAwardTimes()
    return self.fightAwardTimes
end

---获取宝箱状态
---@param index number 宝箱序号
---@return number   @1.未解锁, 2.可领取, 3.已领取
function ActivityTrialSynModel:CheckBoxAwardState(index)
    if
        not self.receivedBoxAward or
        self:GetBoxAwardPercentage() < self.cfg.self_info.celebration_single.cfg_award[index].condition
    then
        return 1
    end
    local sid = self.cfg.self_info.celebration_single.cfg_award[index].sid
    if _G.table.ContainsValue(self.receivedBoxAward, sid) then
        return 3
    end
    return 2
end

---获取距离下一个进度宝箱的进度
function ActivityTrialSynModel:GetNextGapTime()
    local time = self.allPassTimes
    for k, v in pairs(self.cfg.self_info.celebration_single.cfg_award) do
        if v.condition > time then
            return v.condition - time
        end
    end
    return 0
end

---获取最大进度值
---@return number
function ActivityTrialSynModel:GetMaxGapTime()
    local count = 0
    for k, v in pairs(self.cfg.self_info.celebration_single.cfg_award) do
        if v.condition > count then
            count = v.condition
        end
    end
    return count
end

function ActivityTrialSynModel:GetBoxData(index)
    return self.cfg.self_info.celebration_single.cfg_award[index]
end

---获取伤害
function ActivityTrialSynModel:GetDamage()
    return self.damage or 0
end

---更新伤害
function ActivityTrialSynModel:UpdateDamage(damage)
    if self.damage then
        if self.damage < damage then
            self.damage = damage
        end
    else
        self.damage = damage
    end
end

---获取排行榜奖励数据
function ActivityTrialSynModel:GetRankAward()
    for _, cfg in ipairs(self.bossData) do
        if cfg.boss_id == self.celebrationSingle.boss_id then
            return cfg.rank_list
        end
    end
    return {}
end

