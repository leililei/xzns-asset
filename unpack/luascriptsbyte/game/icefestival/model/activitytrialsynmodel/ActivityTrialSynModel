--region=======战斗接口============================

---获取当前挑战的boss怪物组ID
---@return number
function ActivityTrialSynModel:GetMonsterGroupId()
    if not self.curActivityClass:GetFunctionOpen() then
        return 0
    end
    local bossIndex = self:GetBossInfo()
    if bossIndex <= 0 then
        return 0
    end
    local cfg = self.cfg.self_info.celebration_single.cfg_boss[bossIndex]
    return cfg.monster_id
end

---发起战斗挑战
---@return void
function ActivityTrialSynModel:Fight()
    if not self.curActivityClass:GetFunctionOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        return
    end
    local monsterGroupId = self:GetMonsterGroupId()

    --复用主题活动-庆典试炼布阵逻辑
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():OpenEmbattle(
        _G.EmbattleType.ActivityTrial,
        _G.EmbattleSaveType.server,
        true,
        _G.EmbattleControllerItemType.ActivityTrial,
        _G.handler(self, self.ExitEmbattle),
        function(_, _, skipBattle)
            if skipBattle then
                self:SkipFight(monsterGroupId)
            else
                self:EnterFight(monsterGroupId)
            end
        end,
        monsterGroupId,
        self.curActivityClass
    )
end

---进入战斗
---@param monsterGroupId number    挑战的怪物组ID
---@return void
function ActivityTrialSynModel:EnterFight(monsterGroupId)
    ---检测活动是否结束
    if not self.curActivityClass:GetFunctionOpen() or monsterGroupId ~= self:GetMonsterGroupId() then
        if monsterGroupId ~= self:GetMonsterGroupId() then
            --TODO: 非当前进度boss
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        _G.UIManager:GetInstance():CloseWindow(self.curActivityClass:GetGameMainViewName())
        _G.UIManager:GetInstance():CloseWindow(self.viewName or _G.ConfigManager.ui_cfg.ActivityTrialView.Name)
        return
    end

    _G.BattleManager:GetInstance():EnterFight(
        _G.BattleControllerType.ActivityTrial,
        self.curActivityClass,
        monsterGroupId
    )
end

---进入战斗
---@param monsterGroupId number    挑战的怪物组ID
---@return void
function ActivityTrialSynModel:SkipFight(monsterGroupId)
    ---检测活动是否结束
    if not self.curActivityClass:GetFunctionOpen() or monsterGroupId ~= self:GetMonsterGroupId() then
        if monsterGroupId ~= self:GetMonsterGroupId() then
            --TODO: 非当前进度boss
        end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        _G.UIManager:GetInstance():CloseWindow(self.curActivityClass:GetGameMainViewName())
        _G.UIManager:GetInstance():CloseWindow(self.viewName or _G.ConfigManager.ui_cfg.ActivityTrialView.Name)
        return
    end

    _G.BattleManager:GetInstance():SetInBattle(true)
    require("ActivityTrialNet"):GetInstance():Fight({ activity_id = self.activityId }, function(msg)
        if not msg or msg.ack ~= 1 then
            _G.BattleManager:GetInstance():SetInBattle(false)
            return
        end
        --计算战斗结果
        _G.BattleManager:GetInstance():SetArgDataAutoCmd(msg.fight_arg)
        local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
        if not record or not record.result then
            _G.BattleManager:GetInstance():SetInBattle(false)
            return
        end

        ---@type BattleControllerActivityTrial
        local controller = _G.require(_G.BattleControllerType.ActivityTrial).New()
        controller:OnHandleParams(self.curActivityClass, monsterGroupId)
        controller.curFightState = 4 --设置战斗结束

        _G.BattleManager:GetInstance():SetArgData(msg.fight_arg)
        _G.BattleManager:GetInstance():SetStatisticsCached(record)
        _G.BattleManager:GetInstance():SetBattleController(controller)
        --显示结算界面
        controller:FightResultFunc(record.result)
    end
    )
end

---退出布阵
---@return void
function ActivityTrialSynModel:ExitEmbattle()
    self:ReturnPanel(false)
end

---监听界面打开
---@param name string
function ActivityTrialSynModel:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.UIManager:GetInstance():HideWindow(self.curActivityClass:GetGameMainViewName())
    _G.UIManager:GetInstance():HideWindow(self.viewName or _G.ConfigManager.ui_cfg.ActivityTrialView.Name)
end

---更换界面
---@param isWin boolean
---@param monsterGroupId? number    挑战的怪物组ID
function ActivityTrialSynModel:ReturnPanel(isWin, monsterGroupId)
    ---检测活动是否结束
    if not self.curActivityClass:GetFunctionOpen() then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
        _G.UIManager:GetInstance():CloseWindow(self.curActivityClass:GetGameMainViewName())
        _G.UIManager:GetInstance():CloseWindow(self.viewName or _G.ConfigManager.ui_cfg.ActivityTrialView.Name)
        return
    end

    _G.UIManager:GetInstance():ShowWindow(self.curActivityClass:GetGameMainViewName())
    _G.UIManager:GetInstance():ShowWindow(self.viewName or _G.ConfigManager.ui_cfg.ActivityTrialView.Name)
    if not isWin then
        return
    end
end

