---@class ActivityCumulativeModel : Singleton	中文描述
local ActivityCumulativeModel = _G.BaseClass("ActivityCumulativeModel", _G.Singleton)

---@return ActivityCumulativeModel ActivityCumulativeModel
function ActivityCumulativeModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ActivityCumulativeModel:__init()
end

---解析数据
---@param activityClass ActivitySynBase
function ActivityCumulativeModel:ParseData(activityClass)
    if not self.activityList then
        self.activityList = {}
    end
    local activityId = activityClass:GetActivityID()
    if not self.activityList[activityId] then
        self.activityList[activityId] = activityClass.typeClass
    end
end

---关闭活动
function ActivityCumulativeModel:OnCloseActivity(activityId)
    if not self.activityList then
        return
    end
    self.activityList[activityId] = nil
end

---获取代币类型
function ActivityCumulativeModel:CheckCoinType(coinType)
    if self.activityList then
        for _, v in pairs(self.activityList) do
            if v:GetCoinType() == coinType then
                return true
            end
        end
    end
    return false
end

---获取代币数量
function ActivityCumulativeModel:GetCoinNum(coinType)
    if self.activityList then
        for _, v in pairs(self.activityList) do
            if v:GetCoinType() == coinType then
                return v:GetCoinNum()
            end
        end
    end
    return 0
end

---销毁对象时,析构函数
function ActivityCumulativeModel:Dispose()
end

return ActivityCumulativeModel