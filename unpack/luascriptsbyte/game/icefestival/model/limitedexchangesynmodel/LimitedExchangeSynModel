    return (self.lhPath or self.lhSpine), self.lhPath ~= nil
end

---获取立绘资源坐标
function LimitedExchangeSynModel:GetLiHuiPos()
    return self.lhPos
end

---获取立绘资源缩放
function LimitedExchangeSynModel:GetLiHuiScale()
    return self.lhScale
end

---获取资源货币
function LimitedExchangeSynModel:GetResources()
    local resources = {}
    for _, v in pairs(self.needMoneyType) do
        _G.table.insert(resources, v)
    end
    return resources
end

---
---@protected
function LimitedExchangeSynModel:CheckItemGou()
    if self.precast and self.precast[1] and (self.precast[1] == "MTExchangeView" or self.precast[1] == "SpringExchangeView")  then
        return true
    end
    local main_type = self.curActivityClass.cfg.info.front.main_type
    if main_type and main_type == 2 then
        return true
    end
    return false
end

---资源变更
function LimitedExchangeSynModel:ResUpdata(data)
    for _, value in pairs(data) do
        local sid = value.type[1]
        if self.needMoneyType[sid] then
            self:RefreshRedPointExchange()
        end
    end
end

function LimitedExchangeSynModel:GetCurActivitySelfData()
    local selfData = {}
    local checkArray
    for _, v in ipairs(self.itemData) do
        if v.con then
            checkArray = {}
            for _, value in ipairs(v.con) do
                _G.table.insert(checkArray, value.condition)
            end
            if _G.GlobalConditionManager.CheckConditionByArray(checkArray) then
                _G.table.insert(selfData, v)
            end
        else
            _G.table.insert(selfData, v)
        end
    end
    return selfData
end

---获取道具数量
---@param type number 活动类型
function LimitedExchangeSynModel:GetCoinNum(type, subType, sid)
    subType = subType or self.curActivityClass:GetJumpType()
    local activity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(type, subType)
    if activity then
        if activity.typeClass.GetCoinNum then
            return activity.typeClass:GetCoinNum(sid)
        elseif activity.typeClass.GetCoin then
            return activity.typeClass:GetCoin(sid)
        end
    end

    return 0
end

