local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class LimitedExchangeSynModel : ActivitySynTypeBase    新限时兑换
local LimitedExchangeSynModel = _G.BaseClass("LimitedExchangeSynModel", base)

---创建对象时,入口构造函数
function LimitedExchangeSynModel:__init()
    self.activityId = self.curActivityClass:GetActivityID()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    _G.Events:GetInstance():AddListener(_G.eIceFestival.RefreshCumulativeAward, self.OnCumulativeAwardChanged, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.SixUpdate, self)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
end

function LimitedExchangeSynModel:OnActivityStateChanged(state)
    self:RefreshRedPointExchange()
    self:StateChanged(state)
end

function LimitedExchangeSynModel:OnCumulativeAwardChanged(isChange)
    if isChange then
        self:RefreshRedPointExchange()
    end
end

function LimitedExchangeSynModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        if self.precast and self.precast[1] and self.precast[1] == "BlackMarketExchangeView" then
            self:RefreshRedPointExchange()
            for k, v in ipairs(self.curActivityClass.cfg.info.front.con) do
                --如果开启条件里面有每天重置的，跨天关闭入口先
                if _G.table.ContainsValue(_G.FunctionOpenDailyCheckID, v.type) then
                    --require("ActivitySynEnterManager"):GetInstance():RemoveActivityBtn(self.curActivityClass)
                    _G.Events:GetInstance():Broadcast(_G.eBlackMarketExchange.BlackMarketExchangeOpen)
                    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(self.precast[1])
                    if ctrl then
                        ctrl:Close()
                    end
                    return
                end
            end
        end
    elseif state == ActivitySynManager.State.Open then
        if self.precast and self.precast[1] and self.precast[1] == "BlackMarketExchangeView" then
            _G.Events:GetInstance():Broadcast(_G.eBlackMarketExchange.BlackMarketExchangeOpen)
        end
    end
end

function LimitedExchangeSynModel:SixUpdate()
    if self.precast and self.precast[1] and self.precast[1] == "BlackMarketExchangeView" then
        self:RefreshRedPointExchange()
        for k, v in ipairs(self.curActivityClass.cfg.info.front.con) do
            --如果开启条件里面有每天重置的，跨天关闭入口先
            if _G.table.ContainsValue(_G.FunctionOpenDailyCheckID, v.type) then
                --require("ActivitySynEnterManager"):GetInstance():RemoveActivityBtn(self.curActivityClass)
                local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(self.precast[1])
                if ctrl then
                    ctrl:Close()
                end
                return
            end
        end
    end
end

function LimitedExchangeSynModel:OnHandleGMData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---@param info msg
function LimitedExchangeSynModel:SetSelfData(info)
    self.precast = self.curActivityClass.cfg.info.front.precast ~= nil and _G.string.split(self.curActivityClass.cfg.info.front.precast, "#") or nil
    self.needMoneyType = {}
    ---@type activity_new_exchange.i_activity_new_exchange
    local exchange = info.new_exchange or {}
    self.boughtTimes = exchange.bought_times or {}
    self.itemData = exchange.items or {}
    for _, v in pairs(self.itemData) do
        for _, consume in pairs(v.consumes) do
            if consume.type[1] == 0 then
                ---代币[0, 活动类型, 活动子类型， 代币id, 数量]
                self.needMoneyType[consume.type[4]] = consume.type[4]
            else
                ---普通物品[物品id, 数量]
                self.needMoneyType[consume.type[1]] = consume.type[1]
            end
        end
        v.exchangeTimes = 0
        v.state = 1
        for _, a in pairs(self.boughtTimes) do
            if a.sid == v.item_sid then
                v.exchangeTimes = a.times
                v.state = a.times < v.count_limit and 1 or 0
            end
        end
        local isGou = _G.PlayerPrefsManager.GetInt(
            "LimitTimeExchangeModelGou" .. self.activityId .. v.item_sid, -1)
        if isGou == -1 and v.remind then
            if v.remind == 2 then
                isGou = 1
            end
        end
        if isGou == -1 then
            isGou = 0
        end
        v.isGou = isGou
        v.showGou = true
        if v.remind then
            v.showGou = v.remind ~= 1
        end
        if v.description then
            v.description = tonumber(v.description) or 0
        end
    end
    local exchangeShow = self.curActivityClass.cfg.info.front.exchange_show
    if exchangeShow then
        self.lhPath = exchangeShow.pos
        self.lhSpine = exchangeShow.spe
        self.mainType = exchangeShow.main_type
    end
    if exchangeShow and exchangeShow.dev then
        local dev = _G.string.split(exchangeShow.dev, "#")
        self.lhPos = { _G.tonumber(dev[1] or 0), _G.tonumber(dev[2] or 0), _G.tonumber(dev[3] or 0) }
        self.lhScale = _G.tonumber(dev[4] or 1)
    end
    if exchangeShow and exchangeShow.description then
        self.showType = exchangeShow.description.type
        if exchangeShow.description.spine then
            local strT = _G.string.split(exchangeShow.description.spine, "?")
            self.roleStr = strT[1]
            self.rolePos = _G.string.split(strT[2], "#")
            self.bubbleStr = _G.string.split(strT[3], "#") or {}
            for k, v in pairs(self.bubbleStr) do
                self.bubbleStr[k] = _G.tonumber(v) or 0
            end
            self.bubbleTime1 = _G.tonumber(strT[4]) or 1
            self.bubbleSwitchStr = _G.string.split(strT[5], "#") or {}
            for k, v in pairs(self.bubbleSwitchStr) do
                self.bubbleSwitchStr[k] = _G.tonumber(v) or 0
            end
            self.bubbleTime2 = _G.tonumber(strT[6]) or 1
        end
    end
    if self.precast and self.precast[1] and self.precast[1] == "BlackMarketExchangeView" then
        _G.Events:GetInstance():Broadcast(_G.eBlackMarketExchange.BlackMarketExchangeOpen)
    end
    self:RefreshRedPointExchange()
end

---主活动类型
function LimitedExchangeSynModel:GetMainType()
    return self.mainType
end

