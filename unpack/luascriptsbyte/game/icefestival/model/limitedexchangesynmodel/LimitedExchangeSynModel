function LimitedExchangeSynModel:GetItemSidAndNum(data)
    if data.type[1] == 0 then
        return data.type[4], data.type[5]
    end
    return data.type[1], data.type[2]
end

function LimitedExchangeSynModel:Exchange(data, call, cost)
    local itemSid = self:GetItemSidAndNum(data.consumes[1])
    require "ExchangeNet":GetInstance():Exchange(
        data.item_sid,
        cost.num,
        self.activityId,
        function(_data)
            if _data.ack == 1 then
                if data.consumes[1].type[1] == 0 then
                    _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { itemSid, -cost.count })
                    --暂时不改变_G.eArena.SetDrawUp事件发送, 此次活动对应model已声明JointActivitySuperSynModel:SetCoin, 这里就直接走StorageManager处理了
                    local consume = _G.DeepCopy(data.consumes[1])
                    consume.type[5] = consume.type[5] * cost.num
                    _G.StorageManager:GetInstance():Consume(consume)
                else
                    _G.StorageManager:GetInstance():ConsumeItem(itemSid, 0, cost.count)
                end
                data.exchangeTimes = data.exchangeTimes + cost.num
                if data.exchangeTimes >= data.count_limit then
                    data.exchangeTimes = data.count_limit
                    data.state = 0
                end
                local otherAward = { award = { item = {} } }
                local newAward = { award = { item = {} } }
                if _data.award then
                    for _, v in pairs(_data.award.item) do
                        if v.type[1] == 0 then
                            _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.type[3], v.type[4] })
                            local tb = _G.StorageManager:GetInstance():SimulationAward(
                                v.type[3],
                                v.type[4]
                            )
                            _G.table.insert(newAward.award.item, { type = tb })
                        else
                            _G.table.insert(newAward.award.item, v)
                            _G.table.insert(otherAward.award.item, v)
                        end
                    end
                end
                if not _G.table.isEmptyOrNil(otherAward.award.item) then
                    _G.StorageManager:GetInstance():ReceiveAwardData(otherAward)
                end
                require "CommonTipManager".OpenCommonAwardView(newAward)
                self:RefreshRedPointExchange()
                if call then
                    call(_data)
                end
            end
        end
    )
    -- self:RefreshRedPointExchange()
end

---新兑换方法，代币直接走五参绑定活动逻辑
function LimitedExchangeSynModel:ExchangeNew(data, call, num)
    require "ExchangeNet":GetInstance():Exchange(
        data.item_sid,
        num,
        self.activityId,
        function(_data)
            if _data.ack == 1 then
                local T = _G.DeepCopy(data.consumes)
                for k, v in pairs(T) do
                    if v.type[1] == 0 then
                        v.type[5] = v.type[5] * num
                    else
                        v.type[2] = v.type[2] * num
                    end
                    _G.StorageManager:GetInstance():Consume(v)
                end
                data.exchangeTimes = data.exchangeTimes + num
                if data.exchangeTimes >= data.count_limit then
                    data.exchangeTimes = data.count_limit
                    data.state = 0
                end
                -- if _data.award then
                --     _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                --     require "CommonTipManager".OpenCommonAwardView(_data)
                -- end
                -- self:RefreshRedPointExchange()
                if call then
                    call(true, _data)
                end
            end
        end
    )
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function LimitedExchangeSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckHaveExchangeItem }
    self.redpointTree = { false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function LimitedExchangeSynModel:CheckRedPointNumChild(index)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function LimitedExchangeSynModel:CheckCondition(data)
    if not data.con then
        return true
    end
    local checkArray = {}
    for _, value in ipairs(data.con) do
        _G.table.insert(checkArray, value.condition)
    end
    if _G.GlobalConditionManager.CheckConditionByArray(checkArray) then
        return true
    end
    return false
end

---是否有可以足够兑换次数可以兑换的item
function LimitedExchangeSynModel:CheckHaveExchangeItem()
    if self.curActivityClass:GetCurActivityState() ~= require "ActivitySynManager".State.Open then
        return 0
    else
        if self.precast and self.precast[1] and self.precast[1] == "BlackMarketExchangeView" then
            local time = _G.PlayerPrefsManager.GetInt("BlackMarketExchangeViewRedPoint" .. self.curActivityClass:GetActivityID(), 0)
            if time == 0 then
                return 1
            end
            return time < _G.TimeUtil.GetDayBegin(_G.GetNowUnixTime()) and 1 or 0
        end
        local check = self:CheckItemGou()
        local CloseRedPoint = _G.PlayerPrefsManager.GetInt("LimitTimeExchangeCloseRedPoint" .. self.curActivityClass:GetActivityID(), 0)
        if CloseRedPoint == 1 and check == false then
            return 0
        end
        if self.showType ~= 2 then
            local serverTime = _G.TimeUtil.GetServerUnixTime()
            local locationTime = _G.PlayerPrefsManager.GetInt("LimitTimeExchangeModelDaily" .. self.curActivityClass:GetActivityID())
            if locationTime == 0 then
                return 1
            else
                if _G.TimeUtil.GetInterValDayByGame(serverTime, locationTime) >= 1 then
                    return 1
                end
            end
        end
        if not _G.table.isEmptyOrNil(self.itemData) then
            for _, v in pairs(self.itemData) do
                local haveBol = true
                if (check == true and v.isGou == 1 and self:CheckCondition(v)) or check == false then
                    for key, value in ipairs(v.consumes) do
                        local needItem = value and value.type or {}
                        local haveCount
                        local needCount
                        if self.curActivityClass:GetJumpType() and needItem[1] == 0 then
                            haveCount = self:GetCoinNum(needItem[2], needItem[3], needItem[4])
                            needCount = needItem[5]
                        else
                            local _, storageId = _G.StorageManager:GetInstance():CheckSidType(needItem[1])
                            haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, needItem[1])
                            needCount = needItem[2]
                        end
                        if not haveCount or haveCount == 0 then
                            haveCount = _G.StorageManager:GetInstance():GetOtherItemCountBySid(needItem[4]) or 0
                        end

                        if haveCount < needCount then
                            haveBol = false
                        end
                    end
                    if haveBol and v.exchangeTimes < v.count_limit and v.isGou > 0 then
                        return 1
                    end
                end
            end
        end
        return 0
    end
end

---获取红点树结构
---@return table 结构数组
function LimitedExchangeSynModel:GetRedPointTree()
    if self.precast and self.precast[1] and self.precast[1] == "BlackMarketExchangeView" then
        _G.Events:GetInstance():Broadcast(_G.eBlackMarketExchange.BlackMarketExchangeOpen)
    end
    return self.redpointTree
end

---刷新奖励红点
function LimitedExchangeSynModel:RefreshRedPointExchange()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function LimitedExchangeSynModel:OnEnterActivity()
    local main_type = self.curActivityClass.cfg.info.front.main_type
    local subtype = self.curActivityClass:GetJumpType()
    if self.showType and self.showType == 2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTLimitedExchangeView.Name, self.curActivityClass)
    elseif subtype == 100156 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NationalDayExchangeView.Name, self.curActivityClass)
    elseif subtype == 100209 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayExchangeView.Name, self.curActivityClass)
    elseif self.precast and self.precast[1] then
        _G.UIManager:GetInstance():OpenWindow(self.precast[1], self.curActivityClass)
    elseif main_type and main_type == 2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WinterExchangeView.Name, self.curActivityClass)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedExchangeView.Name, self.curActivityClass)
    end
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function LimitedExchangeSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.LimitedExchangeView.Name
end

---销毁对象时,析构函数
function LimitedExchangeSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    _G.Events:GetInstance():RemoveListener(_G.eIceFestival.RefreshCumulativeAward, self.OnCumulativeAwardChanged, self)
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
end

return LimitedExchangeSynModel
