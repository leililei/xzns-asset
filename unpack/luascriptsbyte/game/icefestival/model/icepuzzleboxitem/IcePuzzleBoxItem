local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
local IceFestivalPuzzleManager = require("IceFestivalPuzzleManager"):GetInstance()

---@class IcePuzzleBoxItem    中文描述
---@field public go_table TreasureHuntView._obj_BoxItem201_GoTable
local IcePuzzleBoxItem = _G.BaseClass("IcePuzzleBoxItem", _G.Component)

---类的构造函数
---@field data TreasureHuntBoxData
function IcePuzzleBoxItem:__init(obj, id, callback, data, award)
    self.id = id
    self.callback = callback
    self.data = data
    self.progress = self.data.progress
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function IcePuzzleBoxItem:Show()
    local data = IceFestivalPuzzleManager:GetBoxData(self.id)
    if data then 
        self.data = data
        self.progress = self.data.progress
    end
    self.go_table.aorimage_CloseBox:SetActiveE(0)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_CloseBox, not self.data.received)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_OpenBox, self.data.received)

    self.award = IceFestivalPuzzleManager:GetAwardsData()[self.id].award
    -- if self.data.received then
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.award[1].type,
        self.go_table.obj_root,
        function(tran)
            if not self.go_table then
                _G.DestroyObject(tran)
                return
            end
            tran.gameObject:SetLocalScaleXYZ(0.8)
            tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            tran:SetGou(self.data.received)
        end
    )
    -- end

    -- if self.progress == 1 and not self.data.received then
    --     if self.go_table.obj_eff:GetChildCountE() == 0 then
    --         _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_baoxiang, self.go_table.obj_eff, function()
    --             if _G.IsNil(self) then
    --                 _G.UIUtils.RemoveEffect(self.go_table.obj_eff)
    --             end
    --         end)
    --     end
    -- end
end

---@private
function IcePuzzleBoxItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_Open then
        if self.progress == 1 and not self.data.received then
            IceFestivalPuzzleManager:GetAward(self.id, _G.handler(self, self.Show))
        elseif self.progress < 1 or self.data.received then
            require "CommonTipManager":GetInstance():OpenTip(self.go_table.gameObject, self.award[1].type[1])
            -- if self.callback then
            --     self.callback(self.id, self.data.received)
            -- end
        end
    end
end

---类的析构函数
function IcePuzzleBoxItem:Dispose()
end

return IcePuzzleBoxItem