---@class LimitedExchangeBuyView : UIBaseView    中文描述
---@field public go_table LimitedExchangeBuyView_GoTable GoTable
---@field cfg exchange_cfg
local LimitedExchangeBuyView = _G.BaseClass("LimitedExchangeBuyView", _G.UIBaseView)
local storageManager

local color = {
    [1] = "<color=#097a04>%s</color>",
    [2] = "<color=#ff5c5a>%s</color>"
}
function LimitedExchangeBuyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function LimitedExchangeBuyView:OnCreate(data, buyCall, typeClass)
    self.TypeCls = typeClass
    self.data = data
    self.BuyNum = 0
    if not self.data then
        self:Close()
    end
    storageManager = _G.StorageManager:GetInstance()
    local itemSid = typeClass:GetItemSidAndNum(data.award[1])
    local itemdata = storageManager:GetStorageItemData(itemSid)

    local consumeSid, consumeNum = typeClass:GetItemSidAndNum(data.consumes[1])
    self.coinData = _G.ConfigManager.currency_type_client_cfg[consumeSid] or _G.ConfigManager.currency_type_cfg[consumeSid]
    local needItem = data.consumes[1] and data.consumes[1].type or {}
    if needItem[1] == 0 then
        self.curHave = typeClass:GetCoinNum(needItem[2], needItem[3])
        if not self.curHave or self.curHave == 0 then
            self.curHave = _G.StorageManager:GetInstance():GetOtherItemCountBySid(consumeSid) or 0
        end
    else
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(needItem[1])
        self.curHave = _G.StorageManager:GetInstance():GetItemCountByID(storageId, needItem[1])
    end
    self.curNumber = 0
    self.buyEndCall = buyCall
    self.curExChangeID = data.Sid
    self.needCost = consumeNum
    local maxCanChange = math.floor(self.curHave / self.needCost)
    self.maxExchangeTimes = data.count_limit - data.exchangeTimes
    self.maxExchangeTimes = self.maxExchangeTimes > maxCanChange and maxCanChange or self.maxExchangeTimes

    self.curNumber = self.maxExchangeTimes
    -- self.go_table.aortext_Number:SetActiveE(1)
    self.go_table.aortext_haveNum:SetActiveE(0)
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    self:ShowItem(itemdata)
    self:ChangeNum(1)
end

local btnFunc = {
    ["@_aorbtn_close"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Close"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_propMax"] = function(self)
        self:ChangeMaxNum()
    end,
    ["@_aorbtn_Sub1"] = function(self)
        self:ChangeNum(-1)
    end,
    ["@_aorbtn_Add1"] = function(self)
        self:ChangeNum(1)
    end,
    ["@_aorbtn_Cancel"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Done"] = function(self)
        self:Buy()
    end,
    ["@_aorbtn_shadow"] = function(self)
        self:Close()
    end
}

---按钮点击事件在这里派发
function LimitedExchangeBuyView:OnClickBtn(go)
    local name = go:GetName()
    if btnFunc[name] then
        btnFunc[name](self)
    end
end

function LimitedExchangeBuyView:ShowItem(item)
    if not item then
        self:Close()
    end
    self.go_table.aortext_name.text = item.name
    self.go_table.aortext_describe.text = _G.GetLangPackValue(item.Cfg.Describe or item.Cfg.Instruction)
    local itemSid, itemNum = self.TypeCls:GetItemSidAndNum(self.data.award[1])
    storageManager:GetItemBaseView(itemSid, itemNum, self.go_table.obj_Item)
    self.go_table.aorrawimage_cost:LoadImage(self.coinData.icon)
end

function LimitedExchangeBuyView:ChangeNum(num)
    self.curNumber = self.curNumber + num
    if self.curNumber > self.maxExchangeTimes then
        self.curNumber = self.maxExchangeTimes
    elseif self.curNumber < 1 then
        self.curNumber = 1
    end
    local curNum = self.curNumber == 0 and 1 or self.curNumber
    local cost = curNum * self.needCost
    self.go_table.input_userNum.text = curNum
    local str = self.curHave >= cost and 1 or 2
    self.go_table.aortext_cost.text = string.format(color[str], self.curHave) .. "/" .. cost
    self.cost = {}
    self.cost.num = self.curNumber
    self.cost.count = cost
end

function LimitedExchangeBuyView:ChangeMaxNum()
    self.curNumber = self.maxExchangeTimes
    local curNum = self.curNumber == 0 and 1 or self.curNumber
    local cost = curNum * self.needCost
    self.go_table.input_userNum.text = curNum
    local str = self.curHave >= cost and 1 or 2
    self.go_table.aortext_cost.text = string.format(color[str], self.curHave) .. "/" .. cost
    self.cost = {}
    self.cost.num = self.curNumber
    self.cost.count = cost
end

function LimitedExchangeBuyView:OnEndEditorDeclaration(input)
    -- 输入不是数字
    if not tonumber(input) or input == nil then
        input = self.BuyNum
    end
    local num = tonumber(input)
    local max = self.maxExchangeTimes
    local min = 0
    if num >= max then
        num = max
    elseif num <= min then
        num = min
    end
    self.curNumber = num
    local curNum = self.curNumber == 0 and 1 or self.curNumber
    local cost = curNum * self.needCost
    self.go_table.input_userNum.text = curNum
    local str = self.curHave >= cost and 1 or 2
    self.go_table.aortext_cost.text = string.format(color[str], self.curHave) .. "/" .. cost
    self.cost = {}
    self.cost.num = self.curNumber
    self.cost.count = cost
end

function LimitedExchangeBuyView:Buy()
    local pan = false
    if self.cost.count == 0 or self.cost.num == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(650103)
        --self:Close()
        return
    end
    if self.curNumber * self.needCost > self.curHave then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
            self.coinData.id
        )
        return
    end
    if self.data and self.data.consumes then
        local itemSid, num = self.TypeCls:GetItemSidAndNum(self.data.consumes[1])
        local id = itemSid
        local data = _G.ConfigManager.item_cfg[id]
        if data then
            id = _G.tonumber(data.UseParameter[1][2])
        end

        pan = _G.StorageManager:GetInstance():GetIDMax(itemSid, id)
        if pan then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                622,
                nil,
                function()
                    self.TypeCls:Exchange(self.data, _G.handler(self, self.OnBuyCall), self.cost)
                end
            )
        else
            self.TypeCls:Exchange(self.data, _G.handler(self, self.OnBuyCall), self.cost)
        end
    end
end

function LimitedExchangeBuyView:OnBuyCall(data)
    if self.buyEndCall then
        self.buyEndCall(data)
    end
    self:Close()
end
return LimitedExchangeBuyView
