---放置/卸下回调
function ActivityCumulativeAwardView:OnSlotChangeCall(type, slotIndex)
    if type == self.activitySynModel.type.Pet then
        self.petSlots = self.activitySynModel:GetPetSlots()
        self.petRedPoint = self.activitySynModel:CheckPetRedPoint()
        self:RefreshPetItem(self.petItemList[slotIndex], slotIndex)
        for i, v in pairs(self.petItemList) do
            if i ~= slotIndex then
                v.obj_redpoint:SetActiveE(not self.petSlots[i] and self.petRedPoint or 0)
            end
        end
    else
        self.artifactSlots = self.activitySynModel:GetArtifactSlots()
        self.artifactRedPoint = self.activitySynModel:CheckArtifactRedPoint()
        self:RefreshArtifactItem(self.artifactItemList[slotIndex], slotIndex)
        for i, v in pairs(self.artifactItemList) do
            if i ~= slotIndex then
                v.obj_redpoint:SetActiveE(not self.artifactSlots[i] and self.artifactRedPoint or 0)
            end
        end
    end
end

function ActivityCumulativeAwardView:UpdateActivityTime()
    local time = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - _G.GetNowUnixTime()
    self.go_table.aortext_activityTime.text = _G.TimeUtil.TranslateSecondForStr(time)
end

---奖励界面刷新
function ActivityCumulativeAwardView:OnCumulativeAward()
    self:RefreshEfficiency()
end

---活动结束，关闭界面
function ActivityCumulativeAwardView:OnCloseActivity(activityId)
    if self.activityId == activityId then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityCumulativeAwardSelectView.Name)
        if view then
            view:Close()
        end

        self:Close()
    end
end

---界面的销毁函数
function ActivityCumulativeAwardView:OnDestroy()
    self:RemoveAllListener()
    if self.efficiencyTimer then
        self.efficiencyTimer:Stop()
        self.efficiencyTimer = nil
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function ActivityCumulativeAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        local num = self.activitySynModel:GetTotalAward(_G.TimeUtil.GetServerUnixTime(), self.totalEfficiency, self
            .bonus)
        if num <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1000105)
            return
        end
        self.activitySynModel:GetCumulativeAward(function ()
            self.IsUpdateRedPointBox = false
            self.go_table.obj_redpointGet:SetActiveE(0)
        end)
    elseif go == self.go_table.aorbtn_exchange then
        _G.GlobalInterface.JumpActivityByGM(10048, self.activity:GetJumpType(self.activityId))
    elseif go == self.go_table.aorbtn_help then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 157)
    end
end

return ActivityCumulativeAwardView
