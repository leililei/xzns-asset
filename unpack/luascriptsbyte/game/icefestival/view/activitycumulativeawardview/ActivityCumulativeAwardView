---@class ActivityCumulativeAwardView : UIBaseView	中文描述
---@field public go_table ActivityCumulativeAwardView_GoTable GoTable
local ActivityCumulativeAwardView = _G.BaseClass("ActivityCumulativeAwardView", _G.UIBaseView)

---槽位数量
local SLOT_NUM = 6
---定义宠物品质框
local PetOrderFrame = {
    [0] = "TY_Background_kuang_bai",
    [1] = "ui_js_txk_zi",
    [2] = "ui_js_txk_cheng",
    [3] = "ui_js_txk_hong",
    [4] = "ui_js_txk_cai"
}
local efficiencyStr = "<color=#eec398>+%.1f%%</color>"
local artifactEffect = {_G.ConfigManager.ui_effect_cfg.ef_ActivityCumulativeAwardView_block_bg, _G.ConfigManager.ui_effect_cfg.ef_ActivityCumulativeAwardView_block}

function ActivityCumulativeAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.IsUpdateRedPointBox = false
end

---界面的入口函数
function ActivityCumulativeAwardView:OnCreate(activity)
    self.activity = activity
    self.activitySynModel = activity.typeClass
    self.activityId = activity:GetActivityID()
    self.artifactEffectRoot = {self.go_table.obj_artifactEffect1, self.go_table.obj_artifactEffect2, self.go_table.obj_artifactEffect3,
    self.go_table.obj_artifactEffect4, self.go_table.obj_artifactEffect5, self.go_table.obj_artifactEffect6}
    self.petEffectRoot = {self.go_table.obj_petEffect1, self.go_table.obj_petEffect2, self.go_table.obj_petEffect3,
    self.go_table.obj_petEffect4, self.go_table.obj_petEffect5, self.go_table.obj_petEffect6}
    self:AddComponent(
        self.go_table.trans_resources,
        require("ResourceCompont").New(
            self.go_table.trans_resources,
            _G.ConfigManager.ui_cfg.ActivityCumulativeAwardView.resources
        )
    )
    self:RefreshView()
    self.activitySynModel:RefreshFirstRedPoint(1)
    self:AddListener(_G.eIceFestival.PutSlot, self.OnSlotChangeCall)
    self:AddListener(_G.eIceFestival.TakeOffSlot, self.OnSlotChangeCall)
    self:AddListener(_G.eIceFestival.RefreshCumulativeAward, self.OnCumulativeAward)
    local num = self.activitySynModel:GetTotalAward(_G.TimeUtil.GetServerUnixTime(), self.totalEfficiency, self
    .bonus)
    self:LoadBtnEffect(num)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1,self.UpdateActivityTime,self,false,false,true)
    self.timer:Start()
    self:UpdateActivityTime()
end

function ActivityCumulativeAwardView:RefreshView()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Pet) then
        self.go_table.obj_petGrid:SetActiveE(1)
        self:RefreshPet()
    else
        self.go_table.obj_petGrid:SetActiveE(0)
    end
    self:RefreshArtifact()
    self:RefreshEfficiency()
end

---刷新灵兽
function ActivityCumulativeAwardView:RefreshPet()
    if not self.petItemList then
        self.petItemList = {}
    end
    self.petSlots = self.activitySynModel:GetPetSlots()
    self.petRedPoint = self.activitySynModel:CheckPetRedPoint()
    for i = 1, SLOT_NUM do
        local tb = self.petItemList[i]
        if not tb then
            tb = _G.GetAutoGoTable(
                self.go_table["obj_petItem" .. i],
                _G.handler(self, self.OnClickPetItem)
            )
            self.petItemList[i] = tb
        end
        self:RefreshPetItem(tb, i)
    end
end

---刷新灵兽item
function ActivityCumulativeAwardView:RefreshPetItem(tb, index)
    ---@type pet.i_pet 灵兽数据
    local petData = self.petSlots[index] and self.petSlots[index].pet
    tb.obj_redpoint:SetActiveE(not petData and self.petRedPoint or 0)
    local effect = self.petEffectRoot[index]:GetChildCountE()
    if petData then
        local config = _G.ConfigManager.pet_cfg[petData.sid]
        tb.aorimage_bg.SpriteName = PetOrderFrame[config.Order]
        tb.aorrawimage_icon:LoadImage(
            config.Icon,
            function(image)
                if self:IsNil() then
                    return
                end
                image:SetActiveE(1)
            end
        )
        for i = 1, 5 do
            tb["obj_star" .. i]:SetActiveE(petData.star >= i and 1 or 0)
        end
        local value = self.activitySynModel:GetPetEfficiency(config.Order, petData.star, "v")
        tb.aortext_cumulative.text = _G.string.format(efficiencyStr, (value or 0) / 100)
        tb.aortext_cumulative.color = _G.ColorTools.FormatColorByString("eec398")
        self.petEffectRoot[index]:SetActiveE(1)
        if effect <= 0 then 
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_ActivityCumulativeAwardView_ring,
                self.petEffectRoot[index],
                function(trans)
                    if _G.IsNil(self.go_table) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLocalPosition(0, 0, 0)
                end
            )
        end
    else
        tb.aorimage_bg.SpriteName = PetOrderFrame[0]
        tb.aorrawimage_icon:SetActiveE(0)
        tb.aortext_cumulative.text = _G.GetLangPackValue(90000011712)
        tb.aortext_cumulative.color = _G.ColorTools.FormatColorByString("E6DAB5")
        self.petEffectRoot[index]:SetActiveE(0)
    end
    tb.obj_add:SetActiveE(petData and 0 or 1)
    tb.obj_starParent:SetActiveE(petData and 1 or 0)
end

function ActivityCumulativeAwardView:OnClickPetItem(_, _)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ActivityCumulativeAwardSelectView.Name,
        self.activitySynModel,
        self.activitySynModel.type.Pet
    )
end

---刷新神器
function ActivityCumulativeAwardView:RefreshArtifact()
    if not self.artifactItemList then
        self.artifactItemList = {}
    end
    self.artifactSlots = self.activitySynModel:GetArtifactSlots()
    self.artifactRedPoint = self.activitySynModel:CheckArtifactRedPoint()
    for i = 1, SLOT_NUM do
        local tb = self.artifactItemList[i]
        if not tb then
            tb = _G.GetAutoGoTable(
                self.go_table["obj_artifactItem" .. i],
                _G.handlerbind(self, self.OnClickArtifactItem, i)
            )
            self.artifactItemList[i] = tb
        end
        self:RefreshArtifactItem(tb, i)
    end
end

---刷新神器item
function ActivityCumulativeAwardView:RefreshArtifactItem(tb, index)
    ---@type prop.i_artifact 神器数据
    local data = self.artifactSlots[index] and self.artifactSlots[index].artifact
    tb.obj_redpoint:SetActiveE(not data and self.artifactRedPoint or 0)
    local effect = tb.aorimage_bg:GetChildCountE()
    if data then
        if not tb.itemLua then
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemArtifactBase,
                tb.obj_item,
                function(itemLua)
                    if self:IsNil() then
                        _G.ItemFactory:GetInstance():SetItemCard(itemLua)
                        return
                    end
                    tb.itemLua = itemLua
                    itemLua:Show(data.sid, data.star, data.level, data.awaken, data.num,
                        function()
                            _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.ActivityCumulativeAwardSelectView.Name,
                                self.activitySynModel,
                                self.activitySynModel.type.Artifact
                            )
                        end
                    )
                    itemLua:HideCardBound()
                end
            )
        else
            tb.itemLua:Show(data.sid, data.star, data.level, data.awaken, data.num,
                function()
                    self:OnClickArtifactItem()
                end
            )
            tb.itemLua:HideCardBound()
        end
        self.artifactEffectRoot[index]:SetActiveE(1)
        if effect <= 0 then 
            -- _G.UIUtils.LoadEffectByCfg(
            --     artifactEffect[1],
            --     tb.aorimage_bg.gameObject,
            --     function(trans)
            --         if _G.IsNil(self.go_table) then
            --             _G.DestroyObject(trans)
            --             return
            --         end
            --         trans:SetLocalPosition(0, 48, 0)
            --     end
            -- )
            -- _G.UIUtils.LoadEffectByCfg(
            --     artifactEffect[2],
            --     self.artifactEffectRoot[index],
            --     function(trans)
            --         if _G.IsNil(self.go_table) then
            --             _G.DestroyObject(trans)
            --             return
            --         end
            --         trans:SetLocalPosition(0, 48, 0)
            --     end
            -- )
        else 
            tb.aorimage_bg:GetChildE(0):SetActiveE(1)
        end
        local config = _G.ConfigManager.artifact_cfg[data.sid]
        local value = 0
        if config then
            value = self.activitySynModel:GetArtifactEfficiency(config.Order, data.star, "k")
        end
        tb.aortext_time.text =
        "+" .. self.activitySynModel:formatDecimalToString(_G.GameUtil.FormatNum((value or 0) / 10000)) ..
        _G.GetLangPackValue(90022014302)
        tb.aortext_time.color = _G.ColorTools.FormatColorByString("EEC398")
    else
        self.artifactEffectRoot[index]:SetActiveE(0)
        if effect > 0 then 
            tb.aorimage_bg:GetChildE(0):SetActiveE(0)
        end
        tb.aortext_time.text = _G.GetLangPackValue(90000011712)
        tb.aortext_time.color = _G.ColorTools.FormatColorByString("e6dab5")
    end
    tb.obj_empty:SetActiveE(data and 0 or 1)
    tb.obj_item:SetActiveE(data and 1 or 0)
end

function ActivityCumulativeAwardView:OnClickArtifactItem(_, _)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ActivityCumulativeAwardSelectView.Name,
        self.activitySynModel,
        self.activitySynModel.type.Artifact
    )
end

---效率/加成
function ActivityCumulativeAwardView:RefreshEfficiency()
    self.go_table.aortext_totalcumulative.text = _G.GetLangPackValue(90000011715)
    local coinType = self.activitySynModel:GetCoinType()
    if coinType then
        local iconPath = _G.StorageManager:GetInstance():GetItemIcon(coinType)
        self.go_table.aorrawimage_icon1:LoadImage(iconPath)
        self.go_table.aorrawimage_icon:LoadImage(iconPath)
    end
    self.totalEfficiency = self.activitySynModel:GetTotalEfficiency("k")
    self.bonus = self.activitySynModel:GetTotalEfficiency("v")
    self.go_table.aortext_add.text = _G.GetLangPackValue(
        90000011714,
        self.bonus / 100
    )
    local total =  self.totalEfficiency / 10000 * (1 + self.bonus / 10000)
    self.go_table.aortext_total.text =
        self.activitySynModel:formatDecimalToString(total) .. _G.GetLangPackValue(90022014302)
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local num = self.activitySynModel:GetTotalAward(serverTime, self.totalEfficiency, self
    .bonus)
    self.go_table.aortext_cumulative.text = num
    local maxTime =self.activitySynModel:GetMaxAwardRedTime()
    if serverTime >= maxTime and false == self.IsUpdateRedPointBox then
        self.IsUpdateRedPointBox = true
    end
    self.go_table.obj_redpointGet:SetActiveE(self.IsUpdateRedPointBox == true and 1 or 0)
    if self.efficiencyTimer then
        self.efficiencyTimer:Stop()
        self.efficiencyTimer = nil
    end
    if self.activitySynModel:CheckHaveEfficiency() then
        self.go_table.aortext_time.text = ""
    else
        if serverTime < self.activitySynModel:GetEfficiencyEndTime() then
            self.efficiencyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false)
            self.efficiencyTimer:Start()
        end
        self.go_table.aortext_time.text = _G.TimeUtil.TranslateSecondForStr(
            self.activitySynModel:GetCurEfficiencyTime()
        )
    end
end

function ActivityCumulativeAwardView:UpdateTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local num = self.activitySynModel:GetTotalAward(serverTime, self.totalEfficiency, self
            .bonus)
    self.go_table.aortext_cumulative.text = num
    local maxTime =self.activitySynModel:GetMaxAwardRedTime()
    if serverTime >= maxTime and false == self.IsUpdateRedPointBox then
        self.IsUpdateRedPointBox = true
    end
    self.go_table.obj_redpointGet:SetActiveE(self.IsUpdateRedPointBox == true and 1 or 0)
    self:LoadBtnEffect(num)
    if serverTime > self.activitySynModel:GetEfficiencyEndTime() then
        if self.efficiencyTimer then
            self.efficiencyTimer:Stop()
            self.efficiencyTimer = nil
        end
        self.go_table.aortext_time.text = _G.TimeUtil.TranslateSecondForStr(
            self.activitySynModel:GetMaxTime()
        )
        return
    end
    self.go_table.aortext_time.text = _G.TimeUtil.TranslateSecondForStr(
        self.activitySynModel:GetCurEfficiencyTime()
    )
end
