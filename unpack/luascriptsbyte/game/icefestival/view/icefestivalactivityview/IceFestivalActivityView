local ActivitySynManager = require "ActivitySynManager"
---@class IceFestivalActivityView : UIBaseView	中文描述
---@field public go_table IceFestivalActivityView_GoTable GoTable
local IceFestivalActivityView = _G.BaseClass("IceFestivalActivityView", _G.UIBaseView)

function IceFestivalActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function IceFestivalActivityView:OnCreate(activity)
    self.activityId = activity:GetActivityID()
    self.activity = activity
    self:InitActivityTime()
    self:InitActivityItem()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.InitActivityItem, self)
    self.go_table.aorrawimage_title:ClearChildren()
    self.item = {self.go_table.obj_activityItem1, self.go_table.obj_activityItem2, self.go_table.obj_activityItem3, self.go_table.obj_activityItem4, self.go_table.obj_activityItem5}

    self.resource = self:AddComponent(
        self.go_table.obj_GoldInfo,
        require("ResourceCompont").New(self.go_table.obj_GoldInfo,
            _G.ConfigManager.ui_cfg.IceFestivalActivityView.resources)
    )

    self:AddComponent(self.go_table.obj_PlayerInfo,
        require("PlayerComponent").New(self.go_table.obj_PlayerInfo))
end

---开始时间~结束时间  (日月)
function IceFestivalActivityView:InitActivityTime()
    local starTime = self.activity.cfg.time.start_time
    local start = _G.TimeUtil.GetDateTime(starTime)
    local endt = _G.TimeUtil.GetDateTime(starTime + self.activity.cfg.time.run_time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(
        90025800003,
        _G.string.AddColor(start.month .. "." .. start.day .. "~" .. endt.month .. "." .. endt.day, "96CE51")
    )
end

---初始化活动Item
function IceFestivalActivityView:InitActivityItem()
    if not self.activityItemList then
        self.activityItemList = {}
    end
    self:RefreshActivityItem(10010, self.go_table.obj_activityItem1)
    self:RefreshActivityItem(10047, self.go_table.obj_activityItem2)
    self:RefreshActivityItem(10044, self.go_table.obj_activityItem3)
    self:RefreshActivityItem(10039, self.go_table.obj_activityItem4)
    self:RefreshActivityItem(10046, self.go_table.obj_activityItem5)
end

function IceFestivalActivityView:RefreshActivityItem(jumpType, obj)
    local tb = self.activityItemList[jumpType]
    if not self.activityItemList[jumpType] then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickActivity, jumpType))
        self.activityItemList[jumpType] = tb
    end
    tb.interValDay = 0
    tb.tipContent = nil
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(jumpType,
        self.activity:GetJumpType(self.activityId))
    if activity then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
        tb.obj_lock:SetActiveE(0)
    else
        activity = ActivitySynManager:GetInstance():GetNotOpenAcitivity(jumpType,
            self.activity:GetJumpType(self.activityId))
        if activity then
            tb.obj_lock:SetActiveE(1)
            tb.obj_eff:SetActiveE(0)
            local isPass, content = self:CheckConditionPatams(activity.info)
            if not isPass then
                tb.tipContent = content
                tb.aortext_lockTip.text = content
            else
                tb.interValDay = _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(),
                activity.time.start_time)
                tb.aortext_lockTip.text = _G.GetLangPackValue(
                    90028300082,
                    tb.interValDay
                )
            end
        else
            tb.obj_lock:SetActiveE(0)
            tb.obj_eff:SetActiveE(1)
        end
    end
end

---检测GM活动限制条件
---@param params table 限制条件{{type=t,value=param, list = list},{type=t,value=param}}
---@return boolean 是否满足显示条件
function IceFestivalActivityView:CheckConditionPatams(params)
    params = params.front
    if not params then
        return true
    end
    params = params.con
    if not params then
        return true
    end
    for i = 1, #params do
        local isPass, _, content = _G.GlobalConditionManager.CheckConditionArrays(
            { { params[i].type, params[i].value, params[i].list } }
        )
        if not isPass then
            return false, content
        end
    end
    return true
end

function IceFestivalActivityView:OnClickActivity(_, _, type)
    if self.activityItemList[type] then
        if self.activityItemList[type].tipContent then
            _G.PopWindowManager:GetInstance():ShowAllTips(1515, self.activityItemList[type].tipContent)
            return
        end
        if self.activityItemList[type].interValDay > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1515,
                nil,
                nil,
                nil,
                nil,
                nil,
                self.activityItemList[type].interValDay
            )
            return
        end
    end
    _G.GlobalInterface.JumpActivityByGM(type, self.activity:GetJumpType(self.activityId))
end

function IceFestivalActivityView:OnCloseActivity(activityId)
    if self.activityId == activityId then
        self:Close()
    end
end

---界面的销毁函数
function IceFestivalActivityView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function IceFestivalActivityView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 155)
    end
end

return IceFestivalActivityView
