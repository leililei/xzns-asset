---按钮点击事件在这里派发
function IceFestivalDrawUpView:OnClickBtn(go)
    for i = 1, 12 do
        if go == self.go_table["aorbtn_Award" .. i] then
            require "CommonTipManager":GetInstance():OpenTip(go, self.AwardSidList[i])
        end
    end

    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_selectCard then
        ---切换心愿灵兽
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        local sid = JointActivityDrawUpModel:GetInstance():GetItemId(self.activityID)
        local type = _G.StorageManager:GetInstance():CheckSidType(sid)
        local uiName
        if type == _G.StorageType.Card then
            uiName = _G.ConfigManager.ui_cfg.JoinActivityDrawUpMainSelectView.Name
        else
            uiName = _G.ConfigManager.ui_cfg.SpringDrawUpSelectView.Name
        end
        _G.UIManager:GetInstance():OpenWindow(
            uiName,
            self.activityID,
            function()
                self:SwitchImage()
                self:SetTipInfo()
            end
        )
    elseif go == self.go_table.aorbtn_DrawOnce then
        ---抽一次
        if self.playType == DrawPlayType.Play and self.eff then
            return
        end
        self:DrawCard(_G.DrawType.once)
    elseif go == self.go_table.aorbtn_DrawTenTimes then
        ---抽十次
        if self.playType == DrawPlayType.Play and self.eff then
            return
        end
        self:DrawCard(_G.DrawType.TenTimes)
    elseif go == self.go_table.aorbtn_baodian then
        ---宝典
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(
            10027,
            self.activity:GetJumpType(),
            nil,
            self.activity:GetMainType()
        )
    elseif go == self.go_table.aorbtn_LiBao then
        ---礼包
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(
            10014,
            self.activity:GetJumpType(),
            nil,
            self.activity:GetMainType()
        )
    elseif go == self.go_table.aorbtn_task then
        ---任务
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(
            10007,
            self.activity:GetJumpType(),
            nil,
            self.activity:GetMainType()
        )
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateDrawPlayBtn(1 - self.playType)
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 154)
    elseif self.go_table.aorbtn_Yulan and go == self.go_table.aorbtn_Yulan then
        local limitedRollerCfg = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DrawUpAwardPreView.Name,
            limitedRollerCfg.id,
            -1 --显示所有限时物品
        )
    end
end

---界面的入口函数
function IceFestivalDrawUpView:OnCreate(activity)
    ---@type ActivitySynGMActivity
    self.activity = activity
    self.activityID = activity.activityID
    self.activityCls = self.activity:GetActivityTypeCls()
    self.lastTime = self.activity.cfg.time.run_time + self.activity.cfg.time.start_time - _G.TimeUtil.GetServerUnixTime()
    --- 是否允许使用代币
    self.IsUseCoin = self.activityCls:GetIsUseCoin()
    self.coinId = JointActivityDrawUpModel:GetInstance():GetCoinId(self.activityID)
    self.rewards_count = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID).rewards_count
    self.rewards_goods = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID).rewards_item
    self:SwitchImage()
    self.rewardItemList = {}
    self:InitResources()
    self:RefreshView()
    -- self:InitExtendText()
    self:UpdateTimer(0)
    self:SetRewardPoolView()
    self:UpdateDrawPlayBtn()
    if not self.activityTimer then
        self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.activityTimer:Start()
    end

    if self.go_table.obj_rewardShow ~= nil then
        self.effAutoAni = self.go_table.obj_rewardShow:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end

    if self.go_table.obj_bg ~= nil then
        self.aniBg = self.go_table.obj_bg:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        if _G.IsNil(self.aniBg) then
            self.aniBg = nil
        end
    end

    ---设置红点参数
    -- self.go_table.obj_redpointLiBao:UpdateRedPointItemIDAndParam(
    --     self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2)
    -- )

    --背景特效
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_yanhua2,
        self.go_table.obj_effect,
        function(tran)
            if _G.IsNil(self.go_table) then
                tran:DestroyObject()
                return
            end
        end
    )

    self.go_table.aortext_free.text = _G.GetLangPackValue(90000011702, 1)
    self.go_table.aortext_tipText.text = _G.GetLangPackValue(90000011703, "")

    --玩法名称
    if self.go_table.aortext_name then
        local name = self.activity.cfg.info.name
        local langugageId = tonumber(name)
        self.go_table.aortext_name.text = langugageId and _G.GetLangPackValue(langugageId, "") or name
    end


    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixHotRefresh, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.LoadConsumesInfos, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.ResRefresh, self.LoadConsumesInfos, self)
end

function IceFestivalDrawUpView:OnSixHotRefresh()
