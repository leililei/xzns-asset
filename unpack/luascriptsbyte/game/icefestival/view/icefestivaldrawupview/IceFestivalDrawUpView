---奖励
function IceFestivalDrawUpView:SetRewardView()
    self.numTotle = JointActivityDrawUpModel:GetInstance():GetTotalTimes(self.activityID)
    if self.InitRewardList == nil then
        self.go_table.scrollloophorizontal_Award:InitItemData(#self.rewards_goods,
            _G.handler(self, self.OnRefreshLoopListItem))
        self.InitRewardList = true
        self.go_table.scrollloophorizontal_Award:ScrollToIndex(#self.rewards_goods - 1)
    else
        self.go_table.scrollloophorizontal_Award:UpdateAllItem()
    end
    local isGet
    for i = 1, #self.rewards_count do
        isGet = JointActivityDrawUpModel:GetInstance():IsReceiveAward(self.activityID, i)
        if not isGet or self.totalTimes <= self.rewards_count[i] then
            self.go_table.scrollloophorizontal_Award:ScrollToIndex(i - 1)
            break
        end
    end
    -- local slider = 0
    -- local maxNum = self.rewards_count[#self.rewards_goods]
    -- slider = self.totalTimes / maxNum
    -- self.go_table.slider_jindu.value = slider
end

function IceFestivalDrawUpView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end
    local eIndex = i + 1
    local side = eIndex % 2
    if side == 0 then
        side = 2
    end
    local id = item:GetInstanceIDE()
    local ctrl = self.rewardItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickAwardBtn, ctrl))
        self.rewardItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local go_table = ctrl
    local num = self.rewards_count[eIndex]
    go_table.aortext_numDraw.text = _G.GetLangPackValue(90027000004, num)
    local isGet = JointActivityDrawUpModel:GetInstance():IsReceiveAward(self.activityID, eIndex)

    local score = self.rewards_count[eIndex]
    local canGet = not isGet and self.numTotle >= score
    go_table.aorbtn_click:SetActiveE((not isGet) and 1 or 0)
    go_table.obj_redpoint:SetActiveE(canGet and 1 or 0)
    go_table.obj_itemRoot:RemoveAllChildren()

    local list = self.rewards_goods[eIndex]
    if #list > 3 then
        local test = {}
        table.insert(test, list[4])
        table.insert(test, list[5])
        list = test
    end

    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        list,
        go_table.obj_itemRoot,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            tran:ShowEffect(canGet)
            tran:SetGou(isGet)
            tran.gameObject:SetLocalScaleXYZ(0.7)
        end
    )

    local slider
    local beforNum = self.rewards_count[eIndex - 1] or 0
    if self.totalTimes <= beforNum then
        slider = 0
    elseif self.totalTimes >= num then
        slider = 1
    else
        slider = (self.totalTimes - beforNum) / (num - beforNum)
    end
    go_table.aorimage_jindu:SetLocalScale(slider, 1, 1)
    return item
end

---奖励点击
function IceFestivalDrawUpView:OnClickAwardBtn(_, _, tb)
    local index = tb.index
    -- 判断是否满足领取条件
    local score = self.rewards_count[index]
    local isGet = JointActivityDrawUpModel:GetInstance():IsReceiveAward(self.activityID, index)
    if self.numTotle >= score and not isGet then
        self.activityCls:GetAward(
            { index },
            function(msg)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                JointActivityDrawUpModel:GetInstance():InAward(self.activityID, index)
                self:SetRewardView()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
                self.activityCls:RefreshRedPoint(2)
            end
        )
    else
        local sid = self.rewards_goods[index][1]
        if #self.rewards_goods[index] > 3 then
            sid = self.rewards_goods[index][4]
        end
        require "CommonTipManager":GetInstance():OpenTip(tb.gameObject, sid)
    end
end

---奖励item
function IceFestivalDrawUpView:SetRewardItem(go_table, data, call)
    local sid = data[1]
    local icon, quality = self:GetItemQuality(sid)
    go_table.aorimage_bg.SpriteName = iconQualityBg[quality]
    go_table.aortext_num.text = data[2]
    if _G.ConfigManager.card_cfg[sid] ~= nil then
        if go_table.obj_role then
            go_table.obj_role:SetActiveE(1)
        end
        if go_table.obj_item then
            go_table.obj_item:SetActiveE(0)
        end
        if go_table.aorrawimage_role then
            go_table.aorrawimage_role:LoadImage(icon, function()
                if call then
                    call()
                end
            end)
        else
            if call then
                call()
            end
        end
    else
        if go_table.obj_role then
            go_table.obj_role:SetActiveE(0)
        end
        if go_table.obj_item then
            go_table.obj_item:SetActiveE(1)
        end
        go_table.aorrawimage_icon:LoadImage(icon, function()
            if call then
                call()
            end
        end)
    end
end

---函数功能注释
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function IceFestivalDrawUpView:GetItemQuality(sid)
    local icon
    local quality
    if _G.ConfigManager.item_cfg[sid] ~= nil then
        icon = _G.ConfigManager.item_cfg[sid].Icon
        quality = _G.ConfigManager.item_cfg[sid].Quality
    elseif _G.ConfigManager.artifact_cfg[sid] ~= nil then
        icon = _G.ConfigManager.artifact_cfg[sid].Icon
        quality = _G.ConfigManager.artifact_cfg[sid].Order
    elseif _G.ConfigManager.card_cfg[sid] ~= nil then
        icon = _G.ConfigManager.card_cfg[sid].Photo
        quality = _G.ConfigManager.card_cfg[sid].Order
    elseif _G.ConfigManager.spiritual_cfg[sid] ~= nil then
        icon = _G.ConfigManager.spiritual_cfg[sid].Icon
        quality = _G.ConfigManager.spiritual_cfg[sid].Order
    else
        icon = _G.ConfigManager.currency_type_cfg[sid].icon
        quality = _G.ConfigManager.currency_type_cfg[sid].Quality
    end
    return icon, quality
end

---特效显示隐藏
---@param award award.i_award_item[]
function IceFestivalDrawUpView:IsEff(num, call, award)
    if award and #award > 0 then
        --将限定奖励提取到最前方
        ---@type limited_roller_cfg
        local cfg = JointActivityDrawUpModel:GetInstance():Getlimited_roller_cfg(self.activityID)
        if cfg and cfg.limited_item and #cfg.limited_item > 0 then
            local function isLimitedItem(sid)
                for _, v in ipairs(cfg.limited_item) do
                    if v[1] == sid then
                        return true
                    end
                end
                return false
            end
            for i = #award, 1, -1 do
                if isLimitedItem(award[i].type[1]) then
                    award[i].type.sort = 99 --限定物品排到最前面
                end
            end
        end
    end

    if self.playType == DrawPlayType.Play and (not self.eff) then
        if self.aniBg then
            self.aniBg.enabled = false
            self.aniBg.enabled = true
        end
        if self.effAutoAni then
            self.effAutoAni:SetTrigger("draw")
            self.go_table.obj_drawEff:SetActiveE(0)
            self.go_table.obj_drawEff:SetActiveE(1)
            self.eff = _G.TimerManager:GetInstance():GetTimer(2, self.EffClose, self, true, false, true, call, award)
            self.eff:Start()
        else
            if call then
                call()
            end
        end
        -- self.effAutoAni.enabled = true
        -- self.go_table.aorrawimage_Card:SetActiveE(0)
        -- self.go_table.aorrawimage_Card:SetActiveE(1)
        -- call()
    else
        if call then
            call()
        end
    end
end

function IceFestivalDrawUpView:EffClose(call, award)
    if self:IsNil() then
        return
    end

    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
    if call then
        call()
    end
end

