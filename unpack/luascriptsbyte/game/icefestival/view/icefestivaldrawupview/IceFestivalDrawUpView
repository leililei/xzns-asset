function IceFestivalDrawUpView:ParseSimpleAward(data)
    local itemType = data.type or data
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            table.insert(
                self.awardData,
                {
                    sid = itemType[1],
                    uid = itemType[2],
                    star = itemType[3],
                    number = 1,
                    type = 1,
                    quality = 1,
                    ispri = itemType.ispri,
                    skinIs = self.skinIs
                }
            )
        elseif type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            --武器品质
            if type == _G.StorageType.Equipment then
                local len = itemType[3] or 1
                for i = 1, len do
                    table.insert(
                        self.awardData,
                        {
                            sid = itemType[1],
                            uid = itemType[2],
                            number = 1,
                            type = 1,
                            quality = 1,
                            ispri = itemType.ispri
                        }
                    )
                end
            else
                --刻魂品质
                table.insert(
                    self.awardData,
                    { sid = itemType[1], uid = itemType[2], number = 1, type = 1, quality = 1, ispri = itemType.ispri }
                )
            end
        elseif type == _G.StorageType.Artifact then
            table.insert(self.awardData, { sid = itemType[1], uid = itemType[2], number = itemType[3] })
        elseif type == _G.StorageType.Spiritual then
            for i = 1, itemType[3] do
                _G.table.insert(self.awardData, { sid = itemType[1], uid = itemType[2], number = 1 })
            end
        else
            local addNum = itemType[2] or itemType[3]
            if self.isNotMerge then
                -- (self.awardData)
                -- ("没有合并奖励时的奖励队列")
                table.insert(
                    self.awardData,
                    { sid = itemType[1], number = addNum, type = 1, quality = 1, ispri = itemType.ispri }
                )
            else
                -- ("合并后的奖励队列")
                -- (self.awardData)
                if self.checkAward[itemType[1]] == nil then
                    table.insert(
                        self.awardData,
                        { sid = itemType[1], number = addNum, type = 1, quality = 1, ispri = itemType.ispri }
                    )
                    self.checkAward[itemType[1]] = self.awardData[#self.awardData]
                else
                    self.checkAward[itemType[1]].number = self.checkAward[itemType[1]].number + addNum
                end
            end
        end
        --type=1,卡牌，type=2，神器，type=3,货币，type=4,道具，type=5,装备，type=6，刻魂, type=7,灵契
        for i = 1, #self.awardData do
            ---取sid前三位判断是什么类型
            self.SortSid = {}
            if self.awardData[i].sid > _G.ItemSidJudgeSection.ResPropMax then
                self.SortSid = self.awardData[i].sid
                repeat
                    self.SortSid = self.SortSid / 10
                until self.SortSid < 1000
                local a, b = math.modf(self.SortSid)
                self.SortSid = a
            else
                self.SortSid = self.awardData[i].sid
            end
            if self.awardData[i].sid <= _G.ItemSidJudgeSection.ResPropMax then
                --self.awardData.type=2，货币资源
                self.awardData[i].type = TypeEnum.Currency
            elseif self.SortSid >= 100 and self.awardData[i].sid <= 200 then
                --self.awardData.type=1，卡牌
                self.awardData[i].type = TypeEnum.Card
            elseif self.SortSid == 201 then
                --self.awardData.type=4，装备
                self.awardData[i].type = TypeEnum.Equipment
            elseif self.SortSid == 251 then
                self.awardData[i].type = TypeEnum.Decoration
            elseif self.SortSid == 255 then --神器
                self.awardData[i].type = TypeEnum.Artifact
            elseif self.SortSid == 256 then
                ---灵契
                self.awardData[i].type = TypeEnum.Spiritual
            elseif self.SortSid >= 202 then
                --self.awardData.type=3，道具
                self.awardData[i].type = TypeEnum.Prop
                --self.awardData.type=5,刻魂
            end
        end
        --获取品质
        for i = 1, #self.awardData do
            local list = self.awardData[i]
            if list.type == TypeEnum.Card then
                if currencySids[list.sid] then
                    list.type = TypeEnum.Prop
                    self.awardData[i].quality = _G.ConfigManager.currency_type_client_cfg[list.sid].quality
                else
                    self.awardData[i].quality = _G.ConfigManager.card_cfg[list.sid].Order
                end
            elseif list.type == TypeEnum.Currency then
                if currencySids[list.sid] then
                    list.type = TypeEnum.Prop
                    self.awardData[i].quality = _G.ConfigManager.currency_type_client_cfg[list.sid].quality
                else
                    self.awardData[i].quality = _G.ConfigManager.currency_type_cfg[list.sid].Quality
                end
            elseif list.type == TypeEnum.Prop then
                self.awardData[i].quality = _G.ConfigManager.item_cfg[list.sid].Quality
            elseif list.type == TypeEnum.Equipment then
                self.awardData[i].quality = _G.ConfigManager.equipment_cfg[list.sid].grade
            elseif list.type == TypeEnum.Decoration then
                self.awardData[i].quality = _G.ConfigManager.decoration_cfg[list.sid].grade
            elseif list.type == TypeEnum.Artifact then
                self.awardData[i].quality = _G.ConfigManager.artifact_cfg[list.sid].Order
            elseif list.type == TypeEnum.Spiritual then
                self.awardData[i].quality = _G.ConfigManager.spiritual_cfg[list.sid].Order
            end
        end
        if not self.isNotSort then
            _G.SortList(
                self.awardData,
                function(a)
                    return -a.type, a.quality, -a.sid
                end
            )
        end
    end
end

function IceFestivalDrawUpView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixHotRefresh, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.LoadConsumesInfos, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.LoadConsumesInfos, self)
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
end

return IceFestivalDrawUpView
