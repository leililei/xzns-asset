---@class IceFestivalItemBuyView : UIBaseView	中文描述
---@field public go_table IceFestivalItemBuyView_GoTable GoTable
---@field cfg exchange_cfg
local IceFestivalItemBuyView = _G.BaseClass("IceFestivalItemBuyView", _G.UIBaseView)
local IceFestivalPuzzleManager = require "IceFestivalPuzzleManager":GetInstance()
--_G.ItemBugView = ItemBugView

local CS = _G.CS
local typeof = _G.typeof

function IceFestivalItemBuyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_Max:SetActiveE(0)
end
function IceFestivalItemBuyView:OnDestroy()
end
---界面的入口函数
function IceFestivalItemBuyView:OnCreate(id, buyCall, cfg)
    self.cfg = cfg or _G.ConfigManager.exchange_cfg[id]
    if not self.cfg then
        self:Close()
    end
    self.buyEndCall = buyCall
    self.curExChangeID = id
    self.curNumber = 0
    self.singleNum = self.cfg.get_item[1][2]
    self.need_tiem_const = _G.Mathf.RoundToInt(self.cfg.need_item[1][2] / self.singleNum)
    self.need_item_id = self.cfg.need_item[1][1]
    self:ChangeNum(1)
    self:ShowItem()
end

local btnFunc = {
    ["@_aorbtn_CloseView"] = function(self)
        self:Close()
    end,
    -- ["@_aorbtn_Max"] = function(self)
    --     self:ChangeNum(self:GetMax())
    -- end,
    ["@_aorbtn_Sub10"] = function(self)
        self:ChangeNum(-10)
    end,
    ["@_aorbtn_Add10"] = function(self)
        self:ChangeNum(10)
    end,
    ["@_aorbtn_Sub1"] = function(self)
        self:ChangeNum(-1)
    end,
    ["@_aorbtn_Add1"] = function(self)
        self:ChangeNum(1)
    end,
    ["@_aorbtn_Cancel"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Done"] = function(self)
        self:Buy()
    end,
    ["@_aorbtn_shadow"] = function(self)
        self:Close()
    end
}

---按钮点击事件在这里派发
function IceFestivalItemBuyView:OnClickBtn(go)
    local name = go:GetName()
    if btnFunc[name] then
        btnFunc[name](self)
    end
end

function IceFestivalItemBuyView:ShowItem()
    local itemSid = self.cfg.get_item[1][1]
    local storageManager = _G.StorageManager:GetInstance()
    local _, storageID = storageManager:CheckSidType(itemSid)
    local count = IceFestivalPuzzleManager:GetCoinNum1()
    local item = storageManager:GetItemDataClass(itemSid, count)
    if not item then
        self:Close()
    end
    self.go_table.aortext_ItemName.text = item:GetName()
    -- self.go_table.aortext_describe.text = item:GetDescribe()
    self.go_table.aortext_ItemNum.text = count
    storageManager:GetItemBaseView(itemSid, 0, self.go_table.obj_Item, _G.handler(self, self.OnItemShowCall))
    item = storageManager:GetItemDataClass(self.cfg.need_item[1][1])
    self.cfg.count_limit = IceFestivalPuzzleManager:GetNeedCoinNum()
    -- self.go_table.aorrawimage_cost:LoadImage(item:GetIconPath())
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Limit, self.cfg.count_limit >= 0)
    if self.cfg.count_limit >= 0 then
        self.go_table.aortext_LimitNum.text = self.cfg.count_limit
    end
end

---拥有的金币 / 消耗的金币
function IceFestivalItemBuyView:GetMaxLimit()
    local money = 0
    local num = -1
    local storageManager = _G.StorageManager:GetInstance()
    local itemSid = self.cfg.need_item[1][1]
    for i = 1, #self.cfg.need_item do
        local _, storageId = storageManager:CheckSidType(self.cfg.need_item[i][1])
        money = storageManager:GetItemCountByID(storageId, self.cfg.need_item[i][1])
        money = money / self.cfg.need_item[i][2]
        if num > money then 
            itemSid = self.cfg.need_item[i][1]
        end
        if money <= self.singleNum then -- itemSid == 0 or num > money then
            itemSid = self.cfg.need_item[i][1]
        end
        num = num < 0 and money or (num > money and money or num)
    end
    num = _G.Mathf.Floor(num)
    local finalNum
    local one = IceFestivalPuzzleManager:GetNeedCoinNum()
    if self.cfg.count_limit >= 0 then
        finalNum =
            _G.math.min(
            num,
            one
        )
    end
    return finalNum, itemSid, num
end

function IceFestivalItemBuyView:GetMax()
    local money = 0
    local num = -1
    local storageManager = _G.StorageManager:GetInstance()
    local itemSid = 0
    for i = 1, #self.cfg.need_item do
        local _, storageId = storageManager:CheckSidType(self.cfg.need_item[i][1])
        money = storageManager:GetItemCountByID(storageId, self.cfg.need_item[i][1])
        money = money / self.cfg.need_item[i][2] * self.singleNum
        if money <= self.singleNum and itemSid == 0 then -- itemSid == 0 or num > money then
            itemSid = self.cfg.need_item[i][1]
        end
        num = num < 0 and money or (num > money and money or num)
    end
    num = _G.Mathf.Floor(num)
    local _, storageId = storageManager:CheckSidType(self.cfg.get_item[1][1])
    money = storageManager:GetItemCountByID(storageId, self.cfg.get_item[1][1])
    local item = storageManager:GetItemDataClass(self.cfg.get_item[1][1], money)
    if item.maxCount > 0 then
        num = (item.maxCount - item.count) < num and item.maxCount - item.count or num
    end
    local finalNum
    if self.cfg.count_limit >= 0 then
        finalNum =
            _G.math.min(
            num,
            IceFestivalPuzzleManager:GetNeedCoinNum()
        )
    end
    return finalNum, itemSid
end
function IceFestivalItemBuyView:ChangeNum(num)
    local ratio = IceFestivalPuzzleManager:GetComsume()
    num = num * ratio
    self.curNumber = self.curNumber + num
    if self.curNumber < ratio then
        self.curNumber = ratio
    end
    self.go_table.aortext_Number.text = self.curNumber
    self:SetCost()
end
---设置花费金币 和 拥有的金币数量
function IceFestivalItemBuyView:SetCost()
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(self.cfg.need_item[1][1])
    local money = _G.StorageManager:GetInstance():GetItemCountByID(storageId, self.cfg.need_item[1][1])
    local str = ""
    local max = self:GetMaxLimit()
    max = max * self.singleNum
    money = _G.GameUtil.NumberToUnitStr(money)
    local num = _G.GameUtil.NumberToUnitStr(self.curNumber * self.need_tiem_const)
    if self.curNumber > max then
        str = money .. " / <color=#e33f3f>" .. num .. "</color>"
    else
        str = money .. " / <color=#515268>" .. num .. "</color>"
    end
    self.go_table.aortext_cost.text = str
end
function IceFestivalItemBuyView:Buy()
    ---检测限购次数
    if IceFestivalPuzzleManager:GetNeedCoinNum() <= 0 then 
        _G.PopWindowManager:GetInstance():ShowAllTips(310117)
        return
    end
    local finalNum, sid, num = self:GetMaxLimit()
    if self.curNumber > IceFestivalPuzzleManager:GetNeedCoinNum() then
        _G.PopWindowManager:GetInstance():ShowAllTips(310117) --超出购买限制
        return 
    elseif self.curNumber > num then 
        if sid > 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, sid)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(540102) --可购买的数量
        end
        return 
    end
    IceFestivalPuzzleManager:BuyAward(
        self.curExChangeID,
        _G.Mathf.RoundToInt(self.curNumber / self.singleNum),
        _G.handler(self, self.OnBuyCall)
    )
end
function IceFestivalItemBuyView:OnItemShowCall(view)
    view:ShowNumText(false)
    view.transform:SetLocalPosition(0, 0, 0)
end
function IceFestivalItemBuyView:OnBuyCall(msg)
    if msg.ack == 1 then
        local awardData = {award = {item = {}}}
        awardData.award.item = {{type = {self.curExChangeID, _G.Mathf.RoundToInt(self.curNumber / self.singleNum)}}}
        _G.StorageManager:GetInstance():ConsumeItem(self.cfg.need_item[1][1], 0, _G.Mathf.RoundToInt(self.curNumber / self.singleNum) * self.cfg.need_item[1][2])
        --_G.StorageManager:GetInstance():ReceiveAwardData(awardData)
        local coins = {}
        coins[self.curExChangeID] = _G.Mathf.RoundToInt(self.curNumber / self.singleNum)
        IceFestivalPuzzleManager:SetCoin(coins)
        require("CommonTipManager"):GetInstance():OpenDropTip(awardData)
    end
    if self.buyEndCall then
        self.buyEndCall(msg.ack)
    end
    self:Close()
end
return IceFestivalItemBuyView
