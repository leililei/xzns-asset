function LimitedExchangeView:InitTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local curActivity
    local jumpType = self.activity:GetJumpType()
    if not jumpType or not self.activitySynModel:GetMainType() then
        curActivity = self.activity
    else
        curActivity = ActivitySynManager:GetInstance():GetChildAcitivity(
            self.activitySynModel:GetMainType(),
            jumpType
        )
        if not curActivity then
            curActivity = self.activity
        end
    end
    local _startTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local startTime = _G.TimeUtil.GetDateTime(_startTime)
    local _settlementTime = curActivity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    local settlementTime = _G.TimeUtil.GetDateTime(_settlementTime)
    local text1 = GetLangPackValue(90000010300, startTime.month, startTime.day, startTime.hour)
        .. "-" .. GetLangPackValue(90000010300, settlementTime.month, settlementTime.day, settlementTime.hour)
    self.go_table.aortext_activityTime.text = GetLangPackValue(90025800003, text1)

    local _endTime = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local endTime = _G.TimeUtil.GetDateTime(_endTime)
    local text2 = GetLangPackValue(90000010300, startTime.month, startTime.day, startTime.hour)
        .. "-" .. GetLangPackValue(90000010300, endTime.month, endTime.day, endTime.hour)
    self.go_table.aortext_settlementTime.text = GetLangPackValue(90000010889, text2)
end

function LimitedExchangeView:Sortfunc(data)
    if not _G.table.isEmptyOrNil(data) then
        _G.SortList(
            data,
            function(a)
                return a.state == 0 and 0 or 1, -a.item_sid
            end
        )
    end
end

function LimitedExchangeView:RefreshView()
    self.itemDatas = self.activitySynModel:GetCurActivitySelfData()
    self:Sortfunc(self.itemDatas)
    local count = #self.itemDatas
    if not self.count then
        self.go_table.scrollloopvectical_ItemList:InitItemData(
            count,
            _G.handler(self, self.RefreshItem)
        )
        self.count = count
    else
        if self.count ~= count then
            self.go_table.scrollloopvectical_ItemList:UpdateCount(count)
            self.count = count
        else
            self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
        end
    end

    if self.resComponent then
        local res = self.activitySynModel:GetResources()
        self.resComponent:RestRs(res)
    end
end

function LimitedExchangeView:RefreshItem(index, obj)
    local instanceId = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickItemBtn, index + 1))
    if self.itemDatas[x] then
        tb.data = self.itemDatas[x]
        -- tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        -- self:CreateItem(tb, instanceId)
        tb.obj_itemRoot:RemoveAllChildren()
        local sid, num = self.activitySynModel:GetItemSidAndNum(tb.data.award[1])
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, num },
            tb.obj_itemRoot,
            function(tran)
                if self:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        )
        tb.aortext_itemname.text = _G.StorageManager:GetInstance():GetItemName(sid)
        tb.aortext_num.text = _G.GetLangPackValue(90021600055) .. tb.data.count_limit - tb.data.exchangeTimes
        local consume_sid, consume_num = self.activitySynModel:GetItemSidAndNum(tb.data.consumes[1])
        tb.aorrawimage_Material:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(consume_sid))
        tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(consume_num)

        tb.obj_SellOut:SetActiveE(tb.data.state ~= 1 and 1 or 0)
        tb.aorimage_recommend:SetActiveE(tb.data.remind == 2 and 1 or 0)
    end
end

function LimitedExchangeView:CreateItem(tb, instanceId)
    local data = tb.data
    local item = self.itemList[instanceId]
    local getItem = function(_data, p, type, eff)
        if eff ~= nil then
            if item then
                if item.eff then
                    _G.PoolsManager:GetInstance():Despawn(item.eff.gameObject, _G.ePoolType.UIEffect)
                end
                _G.PoolsManager:GetInstance():Despawn(item.gameObject, _G.ePoolType.UIItem)
            end
        else
            for i = 1, p:GetChildCountE() do
                _G.PoolsManager:GetInstance():Despawn(p:GetChildE(i - 1), _G.ePoolType.UIItem)
            end
        end
        if _data then
            for _, v in pairs(_data) do
                local sid, num = self.activitySynModel:GetItemSidAndNum(v)
                _G.StorageManager:GetInstance():GetItemBaseView(
                    sid,
                    num,
                    p,
                    function(tran)
                        tran.gameObject:SetName(sid)
                        tran.sid = sid
                        if type then
                            tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                        end
                        self.itemList[instanceId] = tran
                        if eff == true then
                            self:LoadEff(tran, sid)
                        end
                        tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                    end,
                    function(go)
                        require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
                    end
                )
            end
        end
    end
    local needItem = data.consumes[1] and data.consumes[1].type or {}
    local haveCount
    local needCount
    if self.activity:GetJumpType() and needItem[1] == 0 then
        haveCount = self.activitySynModel:GetCoinNum(needItem[2], needItem[3])
        needCount = needItem[5]
    else
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(needItem[1])
        haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, needItem[1])
        needCount = needItem[2]
    end
    local isCanTake = haveCount >= needCount and data.state == 1
    _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, data.isGou > 0)
    tb.aorbtn_exchange:SetActiveE(data.state == 1 and 1 or 0)
    tb.aorbtn_gray:SetGray(data.state == 0)
    tb.aorbtn_gray:SetActiveE(data.state == 0 and 1 or 0)
    tb.exchange = nil
    tb.obj_isTips:SetActiveE(data.showGou and 1 or 0)
    tb.aorbtn_gou:SetActiveE(data.showGou and 1 or 0)
    _G.GameUtil.SetActiveByCondition(tb.obj_getEff, data.showGou and isCanTake and data.isGou > 0)
    if haveCount >= needCount then
        tb.aortext_rootPercent.text = needCount
    else
        tb.exchange = tipId.noItem
        tb.aortext_rootPercent.text = needCount
    end
    ---剩余可兑换次数
    local remainCount = data.count_limit - data.exchangeTimes
    if data.state == 1 then
        if remainCount <= 0 then
            tb.aortext_percent.text = GetLangPackValue(90000000961) ..
                "(" .. "<color=red>" .. remainCount .. "</color>" .. "/" .. data.count_limit .. ")"
        else
            tb.aortext_percent.text = GetLangPackValue(90000000961) .. "(" .. remainCount .. "/" .. data.count_limit .. ")"
        end
    else
        tb.exchange = tipId.limitCount
        if remainCount <= 0 then
            tb.aortext_percentGray.text = GetLangPackValue(90000000961) .. "(<color=red>" .. remainCount .. "</color>/" .. data.count_limit .. ")"
        else
            tb.aortext_percentGray.text = GetLangPackValue(90000000961) .. "(" .. remainCount .. "/" .. data.count_limit .. ")"
        end
    end
    getItem(data.consumes, tb.obj_itemfrom, false)
    getItem(data.award, tb.obj_itemto, true, isCanTake)
end

function LimitedExchangeView:LoadEff(tran, Sid)
    local num = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)

    _G.UIUtils.LoadEffectByCfg(
        num,
        tran.gameObject,
        function(trans)
            tran.eff = trans
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    )
end

function LimitedExchangeView:OnExchange(_data)
    local pan = false
    if _data and _data.consumes then
        local itemSid = self.activitySynModel:GetItemSidAndNum(_data.consumes[1])
        local id = itemSid
        local data = _G.ConfigManager.item_cfg[id]
        if data then
            id = _G.tonumber(data.UseParameter[1][2])
        end

        pan = _G.StorageManager:GetInstance():GetIDMax(itemSid, id)
        if pan then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                622,
                nil,
                function()
                    self.TypeCls:Exchange(_data, _G.handler(self, self.OnBuyCall), self.cost)
                end
            )
        else
            self.TypeCls:Exchange(_data, _G.handler(self, self.OnBuyCall), self.cost)
        end
    end
end

