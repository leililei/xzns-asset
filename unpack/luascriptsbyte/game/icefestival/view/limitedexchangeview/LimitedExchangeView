---界面的销毁函数
function LimitedExchangeView:OnDestroy()
    if self.jumpCor then
        _G.coroutine.stopwaiting(self.jumpCor)
    end
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshView, self)
end

function LimitedExchangeView:CloseView()
    self:Close()
end

local CloseCall = function()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
    if view then
        view:Close()
    end
end

function LimitedExchangeView:OnClickGoBtn()
    if not self.activity:CheckActivityInteractable() then
        return
    end
    local actionIDs = ActivitySynManager:GetInstance():GetAllActivityByType(10004)
    if actionIDs then
        ActivitySynManager:GetInstance():JumpActivity(
            actionIDs[1],
            function()
                local GuessGameView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GuessGameView.Name)
                self.jumpCor = _G.coroutine.start(
                    function()
                        while (_G.IsNil(GuessGameView.View.gameObject)) do
                            _G.coroutine.waitforendofframe()
                        end
                        CloseCall()
                    end
                )
            end
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
    end
end

function LimitedExchangeView:OpenTips()
    ---打开玩法说明页面
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 81)
end

---按钮点击事件在这里派发
function LimitedExchangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close2 then
        self:CloseView()
    elseif go == self.go_table.go then
        self:OnClickGoBtn()
    elseif go == self.go_table.aorbtn_help then
        self:OpenTips()
    end
end

return LimitedExchangeView
