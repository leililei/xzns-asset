local ActivitySynManager = require "ActivitySynManager"
local base = require("LimitedExchangeView")
---@class BlackMarketExchangeView : UIBaseView    中文描述
---@field public go_table BlackMarketExchangeView_GoTable GoTable
local BlackMarketExchangeView = _G.BaseClass("BlackMarketExchangeView", base)

function BlackMarketExchangeView:InitView(activity)
    base.InitView(self, activity)
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10017, self.activity:GetJumpType(self.activity:GetActivityID()))
    activity.typeClass:GetCashAward(function()

    end, 3)
    self.RTS = 86400 - _G.TimeUtil.GetSecondsOfDay()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.timer:Start()
    self:UpdateTimer(0)
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    -- 111030000 亡刃刺客
    local cfg = _G.ConfigManager.card_cfg[114100000]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.UIItem,
        self.go_table.obj_role,
        function(obj)
            if not self.go_table then
                _G.DestroyObject(obj)
                return
            end
        end
    )
    _G.PlayerPrefsManager.SetInt("BlackMarketExchangeViewRedPoint" .. self.activity:GetActivityID(), _G.GetNowUnixTime())
    self.activity:GetActivityTypeCls():RefreshRedPointExchange()
end

function BlackMarketExchangeView:UpdateTimer(elapsed)
    self.RTS = self.RTS - elapsed
    if self.RTS <= 0 then
        self.timer:Stop()
        self.timer = nil
        self:Close()
        return
    end
    self.go_table.aortext_Timer.text = _G.TimeUtil.GiftPackGroupTime(self.RTS)
end

function BlackMarketExchangeView:RefreshItem(index, obj)
    local instanceId = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickItemBtn, index + 1))
    if self.itemDatas[x] then
        tb.data = self.itemDatas[x]
        -- tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        -- self:CreateItem(tb, instanceId)
        tb.obj_itemRoot:RemoveAllChildren()
        local sid, num = self.activitySynModel:GetItemSidAndNum(tb.data.award[1])
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, num },
            tb.obj_itemRoot,
            function(tran)
                if self:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        )
        tb.aortext_itemname.text = _G.StorageManager:GetInstance():GetItemName(sid)
        tb.aortext_num.text = _G.GetLangPackValue(90021600055) .. tb.data.count_limit - tb.data.exchangeTimes
        local consume_sid, consume_num = self.activitySynModel:GetItemSidAndNum(tb.data.consumes[1])
        tb.aorrawimage_Material:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(consume_sid))
        tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(consume_num)

        tb.obj_SellOut:SetActiveE(tb.data.state ~= 1 and 1 or 0)
        tb.aorimage_discount:SetActiveE(0)
    end
end

function BlackMarketExchangeView:OpenTips()
    ---打开玩法说明页面
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 200)
end

function BlackMarketExchangeView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return BlackMarketExchangeView