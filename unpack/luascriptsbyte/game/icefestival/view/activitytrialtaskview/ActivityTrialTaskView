---@class ActivityTrialTaskView : UIBaseView    雪域欢歌-雪域试炼任务列表
---@field go_table ActivityTrialTaskView_GoTable GoTable
---@field model ActivityTrialSynModel
---@field activity ActivityTrialData
---@field taskData any[]
---@field taskItems table<number,ActivityTrialTaskView._obj_task_GoTable>
local ActivityTrialTaskView = _G.BaseClass("ActivityTrialTaskView", _G.UIBaseView)

function ActivityTrialTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local desLang = { 90028900006, 90028900004, 90028900005 } -- 1、挑战X次BOSS 2、存活达到XX秒 3、单次伤害达到XX

---界面的入口函数
function ActivityTrialTaskView:OnCreate(activity)
    self.model = activity:GetActivityTypeCls()
    self.activity = activity

    self:InitTaskList()
    self.go_table.scrollloopvectical_taskList:InitItemData(#self.taskData, _G.handler(self, self.RefreshTask))
end

function ActivityTrialTaskView:InitTaskList()
    self.taskData = self.model:GetTaskList() or {}
    _G.table.sort(
        self.taskData,
        function(a, b)
            local isGetA = a.i_task.state == _G.TaskEnum.ETaskState.Completed
            local isGetB = b.i_task.state == _G.TaskEnum.ETaskState.Completed
            local isOverA = a.i_task.state == _G.TaskEnum.ETaskState.Submited
            local isOverB = b.i_task.state == _G.TaskEnum.ETaskState.Submited
            if a.i_task.state == b.i_task.state then
                return a.i_task.sid < b.i_task.sid
            elseif isOverA or isOverB then
                return isOverA
            elseif isGetA or isGetB then
                return not isGetA
            end
        end
    )
end

---刷新奖励
---@param obj UnityEngine.GameObject
function ActivityTrialTaskView:RefreshTask(index, obj)
    if not self.taskItems then
        self.taskItems = {}
    end
    local item = self.taskItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask, item))
        self.taskItems[obj:GetInstanceIDE()] = item
        item.awardList = {}
        item.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAward, item))
    end
    local data = self.taskData[index + 1]
    item.index = index + 1
    item.aortext_name.text = _G.LangUtil.GetLangPackValue(desLang[data.type], data.count)
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited or data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        item.slider_progress.value = 1
        item.aortext_Slider.text = data.count .. "/" .. data.count
    else
        item.slider_progress.value = data.i_task.target[1] / data.count
        item.aortext_Slider.text = data.i_task.target[1] .. "/" .. data.count
    end
    item.aortext_text:SetActiveE(1)
    item.aorimage_get:SetActiveE(1)
    item.aorbtn_get:SetActiveE(1)
    item.aorimage_over:SetActiveE(0)
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        item.aortext_text.text = _G.GetLangPackValue(90027500003)
        item.aortext_text.color = _G.ColorTools.FormatColorByString("8C2D14")
        item.aorimage_get.SpriteName = "ui_ty_kuang_00"
    elseif data.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        item.aortext_text.text = _G.GetLangPackValue(90022200010)
        item.aortext_text.color = _G.ColorTools.FormatColorByString("E9CFAD")
        item.aorimage_get.SpriteName = "ui_ty_kuang_01"
    elseif data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        item.aortext_text:SetActiveE(0)
        item.aorimage_get:SetActiveE(0)
        item.aorbtn_get:SetActiveE(0)
        item.aorimage_over:SetActiveE(1)
    end

    local count = #data.award
    item.scrollloophorizontal_awardList:UpdateCount(count)
end

---显示奖励
---@param tb  ActivityTrialTaskView._obj_task_GoTable
function ActivityTrialTaskView:RefreshAward(index, obj, tb)
    local id = obj:GetInstanceIDE()
    ---@type BaseAwardNewItem
    local item = tb.awardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 74)
        tb.awardList[id] = item
    end
    local taskData = self.taskData[tb.index]
    local awardData = taskData.award[index + 1]
    local sid, num = self:GetItemSidAndNum(awardData)
    awardData = { sid, num }
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
    item:Show(data)
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_gou, taskData.i_task.state == _G.TaskEnum.ETaskState.Completed)
end

---点击领取奖励
---@param item ActivityTrialTaskView._obj_task_GoTable
function ActivityTrialTaskView:OnClickTask(_, _, item)
    local state = self.taskData[item.index].i_task.state
    if state == _G.TaskEnum.ETaskState.Submited then
        -- 可领取
        local taskData = self.taskData[item.index]
        self.model:FinishTask(self.model:GetAllCanGetAwardTaskSidList(), function(msg)
            _G.UIUtils.ShowCommonAward(msg)
            self:InitTaskList()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
        end)
    elseif state == _G.TaskEnum.ETaskState.Claimed then
        -- 任务没有完成
        self:Close()
    end
end

function ActivityTrialTaskView:GetItemSidAndNum(data)
    if data.type[1] == 0 then
        return data.type[4], data.type[5]
    end
    return data.type[1], data.type[2]
end

---按钮点击事件在这里派发
function ActivityTrialTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ActivityTrialTaskView
