local ActivitySynManager = require "ActivitySynManager"
local IceFestivalPuzzleManager = require "IceFestivalPuzzleManager"
local IcePuzzleBoxItem = require "IcePuzzleBoxItem"
---@class IceFestivalPuzzleView : UIBaseView	中文描述
---@field public go_table FestivalPuzzleView_GoTable GoTable
local IceFestivalPuzzleView = _G.BaseClass("IceFestivalPuzzleView", _G.UIBaseView)


local stroageID2Tip = {
    [_G.StorageID.Card] = _G.TipType.Card,
    [_G.StorageID.Prop] = _G.TipType.Prop,
    [_G.StorageID.ResProp] = _G.TipType.ResProp,
    [_G.StorageID.Equipment] = _G.TipType.Equipment,
    [_G.StorageID.Material] = _G.TipType.Prop,
    [_G.StorageID.Decoration] = _G.TipType.Decoration,
    [_G.StorageID.Artifact] = _G.TipType.Artifact,
    [_G.StorageID.Spiritual] = _G.TipType.Spiritual,
    [_G.StorageID.Debris] = _G.TipType.Prop

}
function IceFestivalPuzzleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eItemUpdata.Updata,self.SetPuzzleView)
end

---界面的入口函数
function IceFestivalPuzzleView:OnCreate(activity)
    self.curIndex = 1
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.isInited = false
    self.scrollInit = true
    self.itemTable = {}
    self.lastIndex = 1
    self.lastBoxId = 0
    local component=self:AddComponent(
        self.go_table.obj_GoldInfo,
        require "ResourceCompont".New(self.go_table.obj_GoldInfo, _G.ConfigManager.ui_cfg.IceFestivalPuzzleView.resources)
    )
    component:SetClickCallback(_G.handler(self, self.SpecialHandling))
    self:RefreshRedPoint()
    self:SetPuzzleView()
    self:SetPuzzleRewardView()
    self:XianShiTiem()
end

function IceFestivalPuzzleView:SpecialHandling(sid)
    if sid == IceFestivalPuzzleManager:GetInstance().coin1_id and self.time<IceFestivalPuzzleManager:GetInstance().day_limit*86400 then
        local _,type =  _G.StorageManager:GetInstance():CheckSidType(sid)
        type=stroageID2Tip[type]
        local data= require "TipBaseModel".New()
        data:Init(sid, self.go_table.gameObject)
        local currencysid=IceFestivalPuzzleManager:GetInstance().buy_consume[1].type[1]
        local currencyData=_G.StorageManager:GetInstance():GetStorageItemData(currencysid)
        local buydata={price=IceFestivalPuzzleManager:GetInstance().buy_consume[1].type[2],
                       currencyIcon=currencyData.Cfg.icon,
                       limit=9999,BuyTime=0,count=1}
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.ShopItemTipsView.Name,
                type,
                buydata,
                data,
                function(count,call)
                    local data={award={item={{IceFestivalPuzzleManager:GetInstance().coin1_id,count}}}}
                    local addData={[IceFestivalPuzzleManager:GetInstance().coin1_id]=count}
                    if not _G.StorageManager:GetInstance():CheckItem(currencysid, buydata.price * count) then
                        _G.PopWindowManager:GetInstance():ShowAllTips(230303)
                        _G.UIManager:GetInstance():OpenWindow(
                                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                                currencysid
                        )
                        return
                    end
                    IceFestivalPuzzleManager:GetInstance():BuyAward(sid,count,function()
                        IceFestivalPuzzleManager:GetInstance():SetCoin(addData)
                        _G.StorageManager:GetInstance():ConsumeItem(currencysid, 0, buydata.price * count)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,data)
                        if call then
                            call(true)
                        end
                    end)
                end,
                function()
                    local num=IceFestivalPuzzleManager:GetInstance():GetCoinNum1()
                    local buyNum=num>=100 and 1 or 100-num
                    return num,buyNum
                end
        )
        return true
    else
        return false
    end
end

function IceFestivalPuzzleView:SetPuzzleView()
    self.puzzleDatas = IceFestivalPuzzleManager:GetInstance():GetPuzzleData()
    self.awardsData = IceFestivalPuzzleManager:GetInstance():GetAwardsData()
    self.indexes = IceFestivalPuzzleManager:GetInstance().indexes
    self.puzzle_awards = IceFestivalPuzzleManager:GetInstance().puzzle_awards
    if self.scrollInit then
        self.go_table.scrollloophorizontal_Jigsaw:InitItemData(20, _G.handler(self, self.RefreshScrollItem))
        self.scrollInit = false
    else
        self.go_table.scrollloophorizontal_Jigsaw:UpdateAllItem()
    end
end

---刷新拼图item
---@private
function IceFestivalPuzzleView:RefreshScrollItem(index, obj)
    index = index + 1
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPuzzle, index))
    local canReceived = IceFestivalPuzzleManager:GetInstance():GetCoinNum1() >= IceFestivalPuzzleManager:GetInstance():GetUnlockOneCoinNum()
    local received = self.indexes[index] == nil
    go_table.obj_IsLock:SetActiveE(received and 1 or 0)
    go_table.obj_GetAward:SetActiveE(canReceived and received and 1 or 0)
    go_table.obj_Unlocked:SetActiveE(not received and 1 or 0)
    if canReceived and not received then
        go_table.obj_effGet:SetActiveE(1)
        if go_table.obj_effGet:GetChildCountE() == 0 then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TreasureHuntView_biankuang, go_table.obj_effGet, function()
                if _G.IsNil(go_table) then
                    _G.UIUtils.RemoveEffect(go_table.obj_effGet)
                end
            end)
        end
    else
        go_table.obj_effGet:SetActiveE(0)
    end
end

---点亮拼图
function IceFestivalPuzzleView:OnClickPuzzle(go, isOn, index)
    if self.indexes[index] == nil then
        local iscanClick = IceFestivalPuzzleManager:GetInstance():GetCoinNum1() >= IceFestivalPuzzleManager:GetInstance():GetUnlockOneCoinNum()
        if iscanClick then
            IceFestivalPuzzleManager:GetInstance():UnlockIndex(
                index,
                function()
                    self:SetPuzzleView()
                    self:SetPuzzleRewardView()
                end
            )
        else
            local sid = IceFestivalPuzzleManager:GetInstance():GetCoin1()
            local currencysid=IceFestivalPuzzleManager:GetInstance().buy_consume[1].type[1]
            local currencyData=_G.StorageManager:GetInstance():GetStorageItemData(currencysid)
            if self.time>IceFestivalPuzzleManager:GetInstance().day_limit*86400 then
                _G.PopWindowManager:GetInstance():ShowAllTips(650103)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, sid)
            else
                local _,type =  _G.StorageManager:GetInstance():CheckSidType(sid)
                type=stroageID2Tip[type]
                local data= require "TipBaseModel".New()
                data:Init(sid, self.go_table.gameObject)
                local buydata={price=IceFestivalPuzzleManager:GetInstance().buy_consume[1].type[2],
                               currencyIcon=currencyData.Cfg.icon,
                               limit=9999,BuyTime=0,count=1}
                _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.ShopItemTipsView.Name,
                        type,
                        buydata,
                        data,
                        function(count,call)
                            local data={award={item={{IceFestivalPuzzleManager:GetInstance().coin1_id,count}}}}
                            local addData={[IceFestivalPuzzleManager:GetInstance().coin1_id]=count}
                            if not _G.StorageManager:GetInstance():CheckItem(currencysid, buydata.price * count) then
                                _G.PopWindowManager:GetInstance():ShowAllTips(230303)
                                _G.UIManager:GetInstance():OpenWindow(
                                        _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                                        currencysid
                                )
                                return
                            end
                            IceFestivalPuzzleManager:GetInstance():BuyAward(sid,count,function()
                                IceFestivalPuzzleManager:GetInstance():SetCoin(addData)
                                _G.StorageManager:GetInstance():ConsumeItem(currencysid, 0, buydata.price * count)
                                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,data)
                                if call then
                                    call(true)
                                end
                            end)
                        end,
                        function()
                            local num=IceFestivalPuzzleManager:GetInstance():GetCoinNum1()
                            local buyNum=num>=100 and 1 or 100-num
                            return num,buyNum
                        end
                )
            end

        end
    end
end

function IceFestivalPuzzleView:SetPuzzleRewardView()
    --拼图奖励
    local data = {}
    self.boxList = self.boxList or {}
    for i = 1, 9 do 
        data.progress = 1
        data.received = self.puzzle_awards[i]
        if self.puzzle_awards[i] == nil then
            for _, v in ipairs(self.awardsData[i].conditions) do
                if self.indexes[v] == nil then
                    data.progress = 0
                    break
                end
            end
        end
        if not self.boxList[i] then 
            self.boxList[i] =
                self:AddComponent(
                self.go_table["obj_BoxItem" .. i],
                IcePuzzleBoxItem.New(self.go_table["obj_BoxItem" .. i], i, _G.handler(self, self.ShowBoxAward), data)
            )
        end
        self.boxList[i]:Show(data)
    end 
end

function IceFestivalPuzzleView:RefreshRedPoint()
    local activity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(10007, self.activity:GetJumpType(self.activityID),2)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(activity.typeClass:GetRedpointIDByIndex(1))
end

---点击显示宝箱奖励
function IceFestivalPuzzleView:ShowBoxAward(id, isGou)
    if id ~= self.lastBoxId then
        self.lastBoxId = id
        for key, value in pairs(self.itemTable) do
            _G.DestroyObject(value.gameObject)
        end
        local x, y, z = self.go_table["obj_BoxItem" .. id]:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y + 1.5, z)
        self.itemTable = {}
        if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
            local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            if not _G.IsNil(tf) then
                tf:SetSizeWithCurrentAnchors(
                    _G.CS.UnityEngine.RectTransform.Axis.Horizontal,
                    #self.awardsData[id].award * 90
                )
            end
        end
        self.go_table.aorbtn_TipsView:SetActiveE(1)
        for _, v in pairs(self.awardsData[id].award) do
            local info = {v.type[1], v.type[2]}
            self:CreateItem(info, isGou, self.go_table.obj_Parent, self.itemTable)
        end
        _G.UIUtils.SetOffScreenRectPosition(self.go_table.obj_ItemTips)
    else
        self.go_table.aorbtn_TipsView:SetActiveE(1 - self.go_table.aorbtn_TipsView:GetActiveSelf())
    end
end

---创建宝箱奖励显示item
function IceFestivalPuzzleView:CreateItem(data, isGou, Parent, itemTable)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.7)
                item.gameObject:SetActiveE(1)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                table.insert(itemTable, item)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
        )
    end
end

---设置任务进度
function IceFestivalPuzzleView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (186) or 0, 14)
end

---点击任务
function IceFestivalPuzzleView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[index]
    if name == "@_aorbtn_get" then
        self.activityCls:GetAward(
            { data.i_task.sid },
            function()
                self:SetPuzzleView()
            end
        )
    elseif name == "@_aorbtn_way" then
        ---策划需求（跳转到对应的界面（专门针对跳当前页面设置（黄东要求，紫薯提议！）
        -- if 162001 == data.Cfg.link then
        --     self:Close()
        --     return
        -- end

        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

---显示时间更新
function IceFestivalPuzzleView:XianShiTiem()
    local t
    t, self.time = IceFestivalPuzzleManager:GetInstance().curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.go_table.aortext_CountDown.text = _G.LangUtil.GetLangPackValue(90000011044, _G.TimeUtil.GiftPackGroupTime(self.time))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    --local QD = _G.TimeUtil.GetInterValDayByGame(KaiFu + ZuiDa, _G.TimeUtil:GetServerUnixTime())
    if self.go_table.aorbtn_buyItem:GetActiveSelf() ~= 1 and self.time < IceFestivalPuzzleManager:GetInstance().day_limit * 3600 * 24 and IceFestivalPuzzleManager:GetInstance():GetNeedCoinNum() > 0 then 
        self.go_table.aorbtn_buyItem:SetActiveE(1)
    end
end

function IceFestivalPuzzleView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.go_table.aorbtn_buyItem:GetActiveSelf() ~= 1 and self.time < IceFestivalPuzzleManager:GetInstance().day_limit * 3600 * 24 and IceFestivalPuzzleManager:GetInstance():GetNeedCoinNum() > 0 then 
        self.go_table.aorbtn_buyItem:SetActiveE(1)
    end
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_CountDown.text = _G.LangUtil.GetLangPackValue(90000011044, _G.TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.time))) 
    end
end

---界面的销毁函数
function IceFestivalPuzzleView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function IceFestivalPuzzleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_puzzle then
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.activityID),nil, 2)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
    elseif go == self.go_table.aorbtn_buyItem then 
        local buyConsume = IceFestivalPuzzleManager:GetInstance().buy_consume
        _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.IceFestivalItemBuyView.Name,
        IceFestivalPuzzleManager:GetInstance():GetCoin1(),
        _G.handler(self, self.OnBuyTicketCall),
        {id = 10001, type_system = 0, need_item = {{buyConsume[1].type[1], buyConsume[1].type[2]}}, get_item = {{IceFestivalPuzzleManager:GetInstance():GetCoin1(),1}}, count_limit = IceFestivalPuzzleManager:GetInstance():GetUnlockOneCoinNum()}
    )
    elseif go == self.go_table.aorbtn_help then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 156)
    end
end

function IceFestivalPuzzleView:OnBuyTicketCall()
    self:SetPuzzleView()
end

return IceFestivalPuzzleView