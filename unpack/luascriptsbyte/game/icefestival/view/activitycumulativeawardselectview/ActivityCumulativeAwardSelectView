local ItemArtifactBase = require("ItemArtifactBase")
local ItemPetBase = require("ItemPetBase")
---@class ActivityCumulativeAwardSelectView : UIBaseView	中文描述
---@field public go_table ActivityCumulativeAwardSelectView_GoTable GoTable
local ActivityCumulativeAwardSelectView = _G.BaseClass("ActivityCumulativeAwardSelectView", _G.UIBaseView)
local efficiencyStr = "+%.1f%%"
function ActivityCumulativeAwardSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityCumulativeAwardSelectView:OnCreate(activitySynModel, type)
    self.activitySynModel = activitySynModel
    self.type = type
    self.itemType = {
        [self.activitySynModel.type.Artifact] = _G.ItemFactory.itemType.ItemArtifactBase,
        [self.activitySynModel.type.Pet] = _G.ItemFactory.itemType.ItemPetBase,
    }
    self.tipKey = {
        [self.activitySynModel.type.Artifact] = 90000011709,
        [self.activitySynModel.type.Pet] = 90000011711,
    }
    self.emptyKey = {
        [self.activitySynModel.type.Artifact] = 90000011720,
        [self.activitySynModel.type.Pet] = 90031300021,
    }
    self.selectSlotIdx = 1
    self.selectItem = nil
    self:RefreshView(true)
    self.go_table.scrollloopvectical_slot:InitItemData(6, _G.handler(self, self.RefreshSlotItem))
    self.go_table.aortext_tip.text = _G.GetLangPackValue(self.tipKey[type])
    self:AddListener(_G.eIceFestival.PutSlot, self.OnSlotChangeCall)
    self:AddListener(_G.eIceFestival.TakeOffSlot, self.OnSlotChangeCall)
end

function ActivityCumulativeAwardSelectView:RefreshView(isInit)
    self.slotData = {}
    self.allData = {}
    if self.type == self.activitySynModel.type.Pet then
        self.slotData = self.activitySynModel:GetPetSlots()
        local slotPetSid = {}
        for _, v in pairs(self.slotData) do
            slotPetSid[v.pet.sid] = true
        end
        local allPet = require("PetModel"):GetInstance():GetAllActivePets()
        for _, v in pairs(allPet) do
            if not slotPetSid[v.sid] then
                _G.table.insert(self.allData, v)
            end
        end
    else
        self.slotData = self.activitySynModel:GetArtifactSlots()
        local slotArtifactUid = {}
        for _, v in pairs(self.slotData) do
            slotArtifactUid[v.artifact.uid] = true
        end
        local allArtifact = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
        for _, v in pairs(allArtifact) do
            if v.type ~= _G.ArtifactDataType.Timer and not slotArtifactUid[v.uid] then
                _G.table.insert(self.allData, v)
            end
        end
    end
    _G.SortList(
        self.allData,
        function(data)
            return data.cfg and data.cfg.Order or 0, data.star, data.sid
        end
    )
    local count = #self.allData
    if isInit then
        self.go_table.obj_emptyList:SetActiveE(count > 0 and 0 or 1)
        self.go_table.aortext_emptyList.text = _G.GetLangPackValue(self.emptyKey[self.type])
        for i = 1, 6 do
            if not self.slotData[i] then
                self.selectSlotIdx = i
                break
            end
        end
    end
    if not self.itemListView then
        self.go_table.scrollloopvectical_item:InitItemData(count, _G.handler(self, self.RefreshItem))
        self.itemListView = self.go_table.scrollloopvectical_item
    else
        if self.lastRefreshCount and self.lastRefreshCount ~= count then
            self.itemListView:UpdateCount(count)
            self.go_table.obj_emptyList:SetActiveE(count > 0 and 0 or 1)
        else
            self.itemListView:UpdateAllItem()
        end
    end
    self.lastRefreshCount = count
    self:RefreshSettleBtn()
end

---结算按钮
function ActivityCumulativeAwardSelectView:RefreshSettleBtn()
    if not self.selectSlotIdx then
        self.go_table.aorbtn_auto:SetActiveE(#self.allData > 0 and 1 or 0)

        self.go_table.aorbtn_settle:SetActiveE(0)
        return
    end

    if self.slotData and self.slotData[self.selectSlotIdx] then
        self.go_table.aorbtn_auto:SetActiveE(0)
        self.go_table.aorbtn_settle:SetActiveE(1)
        self.go_table.aortext_settle.text = _G.GetLangPackValue(90031300040)
    else
        self.go_table.aorbtn_auto:SetActiveE(#self.allData > 0 and 1 or 0)
        self.go_table.aorbtn_settle:SetActiveE(self.selectItem and 1 or 0)
        self.go_table.aortext_settle.text = _G.GetLangPackValue(90024100018)
    end
end

function ActivityCumulativeAwardSelectView:RefreshSlotItem(index, obj)
    local nIndex = index + 1
    local data = self.slotData[nIndex]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSlotItem, nIndex))
    tb.obj_info:SetActiveE(data and 1 or 0)
    tb.obj_empty:SetActiveE(data and 0 or 1)
    if data then
        local itemData = data.pet or data.artifact
        if tb.obj_item:GetChildCountE() == 0 then
            _G.ItemFactory:GetInstance():GetItemCard(
                self.itemType[self.type],
                tb.obj_item,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    tb.lua = item
                    if self.type == self.activitySynModel.type.Artifact then
                        item:Show(itemData.sid, itemData.star, itemData.level, itemData.awaken, 1)
                        item:HideLevel()
                        item:HideCardBound()
                    elseif self.type == self.activitySynModel.type.Pet then
                        item:Show(itemData.sid, itemData.star)
                    end
                    item:ShowOrHideProfessional(false)
                end
            )
        else
            if tb.lua == nil then
                if self.type == self.activitySynModel.type.Artifact then
                    tb.lua = ItemArtifactBase.New(tb.obj_item:GetChildE())
                elseif self.type == self.activitySynModel.type.Pet then
                    tb.lua = ItemPetBase.New(tb.obj_item:GetChildE())
                end
            end
            if self.type == self.activitySynModel.type.Artifact then
                tb.lua:Show(itemData.sid, itemData.star, itemData.level, itemData.awaken, 1)
                tb.lua:HideLevel()
                tb.lua:HideCardBound()
            elseif self.type == self.activitySynModel.type.Pet then
                tb.lua:Show(itemData.sid, itemData.star)
            end
            tb.lua:ShowOrHideProfessional(false)
        end
        local value = 0
        if self.type == self.activitySynModel.type.Artifact then
            local config = _G.ConfigManager.artifact_cfg[itemData.sid]
            value = self.activitySynModel:GetArtifactEfficiency(config.Order, itemData.star, "k")
            tb.aortext_efficiency.text =
            self.activitySynModel:formatDecimalToString(value / 10000) .. _G.GetLangPackValue(90022014302)
            tb.aortext_cumulative:SetActiveE(0)
        elseif self.type == self.activitySynModel.type.Pet then
            local config = _G.ConfigManager.pet_cfg[itemData.sid]
            value = self.activitySynModel:GetPetEfficiency(config.Order, itemData.star, "k")
            tb.aortext_efficiency.text = 
            self.activitySynModel:formatDecimalToString(value / 10000) .. _G.GetLangPackValue(90022014302)
            value = self.activitySynModel:GetPetEfficiency(config.Order, itemData.star, "v")
            tb.aortext_cumulative:SetActiveE(1)
            tb.aortext_cumulative.text = _G.string.format(efficiencyStr, (value or 0) / 100)
        end
        local coinType = self.activitySynModel:GetCoinType()
        if coinType then
            local path = _G.StorageManager:GetInstance():GetItemIcon(coinType) or ""
            tb.aorrawimage_efficiency:LoadImage(path)
        end
    end
    tb.obj_select:SetActiveE(self.selectSlotIdx and self.selectSlotIdx == nIndex and 1 or 0)
end

function ActivityCumulativeAwardSelectView:OnClickSlotItem(_, _, nIndex)
    if self.selectSlotIdx and self.selectSlotIdx == nIndex then
        return
    end
    local lastSelectSlot = self.selectSlotIdx
    self.selectSlotIdx = nIndex
    if lastSelectSlot then
        self.go_table.scrollloopvectical_slot:UpdateItemSingle(lastSelectSlot - 1)
    end
    self.go_table.scrollloopvectical_slot:UpdateItemSingle(nIndex - 1)
    self:RefreshSettleBtn()
end

function ActivityCumulativeAwardSelectView:RefreshItem(index, obj)
    local nIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.allData[nIndex]
    if tb.obj_root:GetChildCountE() == 0 then
        _G.ItemFactory:GetInstance():GetItemCard(
            self.itemType[self.type],
            tb.obj_root,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                tb.lua = item
                item:ShowData(data, function()
                    self:OnClickArtifact(nIndex)
                end)
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:SetGouScroll(self.selectItem and self.selectItem == nIndex)
                if item.HideCount then
                    item:HideCount()
                end
                if item.HideLevel then
                    item:HideLevel()
                end
                if item.HideCardBound then
                    item:HideCardBound()
                end
                if item.ShowOrHideProfessional then
                    item:ShowOrHideProfessional(false)
                end
            end
        )
    else
        if tb.lua == nil then
            if self.type == self.activitySynModel.type.Artifact then
                tb.lua = ItemArtifactBase.New(tb.obj_root:GetChildE())
            elseif self.type == self.activitySynModel.type.Pet then
                tb.lua = ItemPetBase.New(tb.obj_root:GetChildE())
            end
        end
        tb.lua:ShowData(data, function()
            self:OnClickArtifact(nIndex)
        end)
        tb.lua:SetGouScroll(self.selectItem and self.selectItem == nIndex)
        if tb.lua.HideCount then
            tb.lua:HideCount()
        end
        if tb.lua.HideLevel then
            tb.lua:HideLevel()
        end
        if tb.lua.HideCardBound then
            tb.lua:HideCardBound()
        end
        if tb.lua.ShowOrHideProfessional then
            tb.lua:ShowOrHideProfessional(false)
        end
    end
end

function ActivityCumulativeAwardSelectView:OnClickArtifact(nIndex)
    if not self.selectSlotIdx or (self.selectItem and self.selectItem == nIndex) then
        return
    end
    local lastSelectItem = self.selectItem
    self.selectItem = nIndex
    if lastSelectItem then
        self.go_table.scrollloopvectical_item:UpdateItemSingle(lastSelectItem - 1)
    end
    self.go_table.scrollloopvectical_item:UpdateItemSingle(nIndex - 1)
    self:RefreshSettleBtn()
end

---放置/卸下回调
function ActivityCumulativeAwardSelectView:OnSlotChangeCall(type, slotIndex)
    if type == self.type then
        self.selectItem = nil
        self:RefreshView()
        self.go_table.scrollloopvectical_slot:UpdateItemSingle(slotIndex - 1)
    end
end

---界面的销毁函数
function ActivityCumulativeAwardSelectView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function ActivityCumulativeAwardSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_settle then
        if not self.selectSlotIdx then
            return
        end
        if self.slotData[self.selectSlotIdx] then
            self.activitySynModel:TakeOffSlot(self.selectSlotIdx, self.type)
        else
            if not self.selectItem then
                return
            end
            local data = self.allData[self.selectItem]
            if not data then
                return
            end
            self.activitySynModel:PutSlot(self.selectSlotIdx, data, self.type)
        end
    elseif go == self.go_table.aorbtn_auto then
        ---@type {data:PetData|ArtifactData, efficiency:number}[],number
        local sortList, minEfficiency = {}, 0
        ---加入队列
        ---@param data ArtifactData|PetData
        ---@param efficiency number
        local function addData(data, efficiency)
            local isInsert = false
            for i = 1, #sortList do
                if efficiency >= sortList[i].efficiency then
                    table.insert(sortList, i, { data = data, efficiency = efficiency })
                    isInsert = true
                    break
                end
            end
            if not isInsert then
                --加入队末
                table.insert(sortList, { data = data, efficiency = efficiency })
            end
            --移除多余的数据
            if #sortList > 6 then
                table.remove(sortList, #sortList)
            end
        end

        if self.type == self.activitySynModel.type.Artifact then
            local allArtifact = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
            ---@param artifactData ArtifactData
            for _, artifactData in pairs(allArtifact) do
                local v = self.activitySynModel:GetArtifactEfficiency(artifactData.cfg.Order, artifactData.star, "k")
                if v > minEfficiency then
                    addData(artifactData, v)
                    if #sortList >= 6 then
                        minEfficiency = sortList[#sortList].efficiency
                    end
                end
            end
        elseif self.type == self.activitySynModel.type.Pet then
            local allPet = require("PetModel"):GetInstance():GetAllActivePets()
            ---@param petData PetData
            for _, petData in pairs(allPet) do
                local v = self.activitySynModel:GetPetEfficiency(petData.cfg.Order, petData.star, "k")
                if v > minEfficiency then
                    addData(petData, v)
                    if #sortList >= 6 then
                        minEfficiency = sortList[#sortList].efficiency
                    end
                end
            end
        end
        if _G.table.isEmptyOrNil(sortList) then
            return
        end

        local datas = {}
        for i = 1, #sortList do
            datas[i] = sortList[i].data
        end
        self.activitySynModel:TakeOffAllSlots(self.type, function(msg)
            if msg and msg.ack ~= 1 then
                return
            end
            self.activitySynModel:PutAllSlots(datas, self.type)
        end)
    end
end

return ActivityCumulativeAwardSelectView
