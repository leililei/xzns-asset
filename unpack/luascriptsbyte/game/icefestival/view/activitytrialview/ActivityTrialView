---@class ActivityTrialView : UIBaseView    雪域欢歌-雪域试炼
---@field go_table ActivityTrialView_GoTable
---@field model ActivityTrialSynModel
---@field activity ActivityTrialData
---@field boxItems ActivityTrialView._obj_box1_GoTable[]
local ActivityTrialView = _G.BaseClass("ActivityTrialView", _G.UIBaseView)

function ActivityTrialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityTrialView:OnCreate(activity)
    self.model = activity:GetActivityTypeCls()
    self.activity = activity
    self.go_table.aorbtn_help:SetActiveE(1)
    self.activityType = require("ActivitySynManager"):GetInstance():GetChildAcitivity(10043,activity:GetJumpType()).typeClass:GetType()

    --刷新界面显示
    self:UpdateRoleView()
    self:UpdateStageView()
    self:UpdateAwardView()
    self.model:GetAllPassTimes()

    self:UpdateTime(0)

    self.timer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateTime, self, false, false, true)
    self.timer:Start()

    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.model:GetRedpointIDByIndex(2))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eCelebration.CelebrationHotChange, self.UpdateAwardView, self)
    self.resource = self:AddComponent(
        self.go_table.obj_GoldInfo,
        require("ResourceCompont").New(self.go_table.obj_GoldInfo,
            _G.ConfigManager.ui_cfg.IceFestivalActivityView.resources)
    )

    self:AddComponent(self.go_table.obj_PlayerInfo,
        require("PlayerComponent").New(self.go_table.obj_PlayerInfo))
end

---界面的销毁函数
function ActivityTrialView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eCelebration.CelebrationHotChange, self.UpdateAwardView, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---初始化buff显示
---@return void
function ActivityTrialView:InitBuffStates()
    self.go_table.aortext_buff1:SetActiveE(1)
    self.go_table.aortext_buff2:SetActiveE(1)
    self.go_table.aortext_buff1:SetLocalPosition(0, 20, 0)
    self.go_table.aortext_buff2:SetLocalPosition(0, -15, 0)
    self.go_table.aortext_buff1.text = ""
    self.go_table.aortext_buff2.text = ""
end

---更新角色立绘显示
---@private
---@return void
function ActivityTrialView:UpdateRoleView()
    local bossIndex = self.model:GetBossInfo()

    local pos = self.model.bossData[bossIndex].pos
    local array1 = _G.string.split(pos, "|")
    local array2 = _G.string.split(array1[2], "#")
    if array1[3] == "1" then
        self.go_table.aorrawimage_role:LoadImage(
            array1[1],
            function(tran)
                if self:IsNil() then
                    return
                end
                tran:SetNativeSize()
                tran:SetLocalPosition(tonumber(array2[1]) or 0, tonumber(array2[2]) or 0, tonumber(array2[3]) or 0)
                tran:SetLocalScaleXYZ(tonumber(array2[4]) or 0)
                tran:SetActiveE(1)
            end
        )
    else
        self.go_table.aorrawimage_role:SetActiveE(0)
        self.go_table.obj_role:SetLocalPosition(
            tonumber(array2[1]) or 0,
            tonumber(array2[2]) or 0,
            tonumber(array2[3]) or 0
        )
        self.go_table.obj_role:SetLocalScaleXYZ(tonumber(array2[4]) or 0)
        _G.UIUtils.LoadEffectByPath(
            array1[1],
            self.go_table.obj_role,
            function(tran)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(tran)
                end
            end
        )
    end

    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_ActivityTrialView_bg,
    --     self.go_table.obj_eff,
    --     function(tran)
    --         if self:IsNil() then
    --             _G.UIUtils.RemoveEffect(tran)
    --         end
    --     end
    -- )
end

---更新buff和阶段显示
---@return void
function ActivityTrialView:UpdateStageView()
    local bossStage = self.model:GetBossInfo()
    --更新buff显示
    if self.bossStage ~= bossStage then
        self.bossStage = bossStage
        self:InitBuffStates()
        local buffList = self.model.bossData[bossStage].buff_list
        if buffList then
            if #buffList == 1 then
                self.go_table.aortext_buff1:SetLocalPosition(0, 2.5, 0)
                self.go_table.aortext_buff1.text =
                    _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[buffList[1]].describe1)
                self.go_table.aortext_buff2:SetActiveE(0)
            else
                self.go_table.aortext_buff1:SetLocalPosition(0, 24, 0)
                self.go_table.aortext_buff2:SetLocalPosition(0, -19, 0)
                self.go_table.aortext_buff1.text =
                    _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[buffList[1]].describe1)
                self.go_table.aortext_buff2.text =
                    _G.GetLangPackValue(_G.ConfigManager.card_skills_cfg[buffList[2]].describe1)
                self.go_table.aortext_buff2:SetActiveE(1)
            end
        end
    end

    if not self.stageListView then
        self.go_table.scrollloopvectical_stage:InitItemData(
            self.model.maxBossStage,
            _G.handler(self, self.RefreshStageItem)
        )
        self.stageListView = self.go_table.scrollloopvectical_stage
    else
        self.stageListView:UpdateCount(self.model.maxBossStage)
    end
    self.stageListView:ScrollToIndex(bossStage - 1)

    --新阶段红点信息
    if bossStage >= 1 and bossStage <= self.model.maxBossStage then
        _G.PlayerPrefsManager.SetInt(
            string.format("ActivityTrialView_%s", self.activity:GetActivityID()),
            bossStage
        )
        self.model:RefreshRedPoint()
    end
end

function ActivityTrialView:RefreshStageItem(index, obj)
    local tb = _G.GetAutoGoTable(obj,_G.handlerbind(self,self.OnLeftItemClick,index))
    local nIndex = index + 1
    local bossCfg = self.model.bossData[nIndex]
    tb.aorimage_icon.SpriteName = stageIconPath[self.activityType][nIndex].icon
    tb.aortext_name.text = _G.GetLangPackValue(stageIconPath[self.activityType][nIndex].name)
    tb.aortext_time:SetActiveE(0)
    if nIndex < self.bossStage or not bossCfg then
        tb.aortext_stage.text = _G.GetLangPackValue(90028900001)
    elseif nIndex == self.bossStage then
        tb.aortext_time:SetActiveE(1)
        self.countDown = bossCfg.continue_time[2] * 86400 - self.model:GetOpenDuration()
        self.curStageObj = tb.aortext_stage
        tb.aortext_stage.text = _G.GetLangPackValue(90000011696)
        tb.aortext_time.text = _G.TimeUtil.GodSpecialGiftForStr(self.countDown)
    else
        local time = _G.TimeUtil.TranslateSecond(
            bossCfg.continue_time[1] * 86400 - self.model:GetOpenDuration()
        )
        tb.aortext_stage.text = _G.GetLangPackValue(90000011697, time.day > 0 and time.day or 1)
    end
    -- _G.GameUtil.ReBuildRTF(tb.aortext_stage)
    -- _G.GameUtil.ReBuildRTF(tb.aortext_time)
    -- local w = tb.aortext_stage:GetRectTransformSize()
    -- tb.aortext_stage:SetRectTransformSize(w + 40, 26)
end

function ActivityTrialView:OnLeftItemClick(_, _, index)
    local nIndex = index + 1
    local bossCfg = self.model.bossData[nIndex]
    if nIndex < self.bossStage or not bossCfg then
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
    elseif nIndex == self.bossStage then
    else
        local time = _G.TimeUtil.TranslateSecond(
            bossCfg.continue_time[1] * 86400 - self.model:GetOpenDuration()
            )
        _G.PopWindowManager:GetInstance():ShowAllTips(650105,nil,nil,nil,nil,nil, time.day > 0 and time.day or 1)
    end
end

---更新奖励视图
---@return void
function ActivityTrialView:UpdateAwardView()
    local percentage = self.model:GetBoxAwardPercentage()
    local maxPercentage = math.max(100, self.model:GetMaxGapTime())
    --显示进度条
    self.go_table.slider_award.value = percentage / maxPercentage
    local tb = _G.GetAutoGoTable(self.go_table.slider_award)
    tb.obj_Fill:SetActiveE(percentage > 0 and 1 or 0)

    --显示宝箱状态
    if not self.boxItems then
        self.boxItems = {
            _G.GetAutoGoTable(self.go_table.obj_box1),
            _G.GetAutoGoTable(self.go_table.obj_box2),
            _G.GetAutoGoTable(self.go_table.obj_box3),
            _G.GetAutoGoTable(self.go_table.obj_box4)
            -- _G.GetAutoGoTable(self.go_table.obj_box5)
        }
        for id, item in ipairs(self.boxItems) do
            _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.ClickBoxAwardItem, item, id))
        end
    end
    for id, item in ipairs(self.boxItems) do
        self:RefreshBoxAwardItem(item, id)
    end

    local curGapValue = self.model:GetBoxAwardPercentage()
    self.go_table.aortext_text.text = _G.GetLangPackValue(90000011699, curGapValue, self.model:GetNextGapTime())
    if self.go_table.aortext_hot then
        self.go_table.aortext_hot.text = curGapValue
    end
    if self.go_table.aortext_awardTimes then
        self.go_table.aortext_awardTimes.text = _G.GetLangPackValue(90000012023, self.model:GetFightAwardTimes())
    end
end

---刷新宝箱状态
---@param item ActivityTrialView._obj_box1_GoTable
---@param index number
function ActivityTrialView:RefreshBoxAwardItem(item, index)
    local state = self.model:CheckBoxAwardState(index)
    item.aorimage_box1:SetActiveE(state == 1 and 1 or 0)
    item.aorimage_box2:SetActiveE(state == 2 and 1 or 0)
    item.aorimage_box3:SetActiveE(state == 3 and 1 or 0)
    item.obj_eff:SetActiveE(state == 2 and 1 or 0)
    local data = self.model:GetBoxData(index)
    item.aortext_progess.text = data.condition
    if state == 2 and not item.__loadEffect then
        item.__loadEffect = true
    end
end

---点击显示宝箱奖励
function ActivityTrialView:ShowBoxAward(index, isGou)
    if index == self.lastBoxId then
        self.go_table.aorbtn_TipsView:SetActiveE(1 - self.go_table.aorbtn_TipsView:GetActiveSelf())
        return
    end

    self.lastBoxId = index
    --销毁之前加载的物品信息
    if self.itemTable then
        for key, value in pairs(self.itemTable) do
            _G.DestroyObject(value.gameObject)
        end
    end

    --加载现在的物品信息
    local award = self.activity.cfg.self_info.celebration_single.cfg_award[index].award
    local x, y, z = self.go_table["obj_box" .. index]:GetPosition()
    self.go_table.obj_ItemTips:SetPosition(x, y + 1.5, z)
    self.itemTable = {}
    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        if not _G.IsNil(tf) then
            tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, #award * 68)
        end
    end
    self.go_table.aorbtn_TipsView:SetActiveE(1)

    local itemTable = self.itemTable
    for _, v in ipairs(award) do
        local sid, num = self:GetItemSidAndNum(v)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, num },
            self.go_table.obj_Parent,
            function(item)
                if itemTable ~= self.itemTable then
                    if not _G.IsNil(item) then
                        _G.DestroyObject(item.gameObject)
                    end
                    return
                end

                item.gameObject:SetLocalScaleXYZ(0.6)
                item.gameObject:SetActiveE(1)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                table.insert(itemTable, item)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
            end
        )
    end
    _G.UIUtils.SetOffScreenRectPosition( self.go_table.obj_ItemTips)
end

function ActivityTrialView:GetItemSidAndNum(data)
    if data.type[1] == 0 then
        return data.type[4], data.type[5]
    end
    return data.type[1], data.type[2]
end

---跨天六点刷新
---@private
function ActivityTrialView:OnSixUpdate()
    self:UpdateRoleView()
    self:UpdateStageView()
    self:UpdateAwardView()
end

---更新时间
---@private
---@return void
function ActivityTrialView:UpdateTime(elapsed)
    if not self.activity:GetFunctionOpen() then
        self:Close()
        return
    end

    --活动结束倒计时
    self.go_table.aortext_time.text = utils.formatTimeString(self.model:GetRemainDuration())

    --当前阶段倒计时
    self.countDown = self.countDown - elapsed
    self.curStageObj.text = _G.GetLangPackValue(90000011696)
end

---点击宝箱事件
---@param item ActivityTrialView._obj_box1_GoTable
---@param index number
function ActivityTrialView:ClickBoxAwardItem(go, isOn, item, index)
    if self.model:CheckBoxAwardState(index) == 2 then
        self.model:GetBoxAward(
            index,
            function(newAward)
                _G.UIUtils.ShowCommonAward(newAward)
                self:UpdateAwardView()
            end
        )
    else
        self:ShowBoxAward(index, false)
    end
end

---按钮点击事件在这里派发
function ActivityTrialView:OnClickBtn(go)
    if go == self.go_table.aorbtn_fight then
        self.model:Fight()
    elseif go == self.go_table.aorbtn_rank then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonRankView.Name,
            _G.CommonRankType.ActivityTrial,
            self.activity
        )
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTrialTaskView.Name, self.activity)
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
    elseif go == self.go_table.aorbtn_help then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 173)
    end
end

