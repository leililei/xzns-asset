local utils = {
    ---格式化时长娴熟
    ---@param seconds number 秒
    ---@return string
    formatTimeString = function(seconds)
        local time = _G.TimeUtil.TranslateSecond(seconds)
        if time.day > 0 then
            return _G.GetLangPackValue(90025500011, time.day, _G.GetLangPackValue(90022100002, time.hour, time.min))
        elseif time.hour > 0 then
            return _G.GetLangPackValue(90022100002, time.hour, time.min)
        else
            return _G.GetLangPackValue(90000010394, time.min > 0 and time.min or 1)
        end
    end
}

