local base = require("BaseGameNet")

---@class IceFestivalPuzzleNet : BaseGameNet	通信协议
local IceFestivalPuzzleNet = _G.BaseClass("IceFestivalPuzzleNet", base)
---@return IceFestivalPuzzleNet IceFestivalPuzzleNet
function IceFestivalPuzzleNet:GetInstance()
    return  base.GetInstance(self)
end

---点亮拼图
---@param pbData table PB数据
---@param callback function 完成回调
function IceFestivalPuzzleNet:UnlockIndex(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_puzzle_unlock_index
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function IceFestivalPuzzleNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return IceFestivalPuzzleNet