local base = require("BaseGameNet")

---@class ActivityTrialNet : BaseGameNet	通信协议
local ActivityTrialNet = _G.BaseClass("ActivityTrialNet", base)
---@return ActivityTrialNet ActivityTrialNet
function ActivityTrialNet:GetInstance()
    return base.GetInstance(self)
end

---发起战斗
function ActivityTrialNet:Fight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_celebration_single_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---领取奖励
function ActivityTrialNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_celebration_single_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务
function ActivityTrialNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_celebration_single_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---排行榜
function ActivityTrialNet:GetRankInfo(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_rank_celebration_single, pbdata, callBack)
end

---获取个人排名
function ActivityTrialNet:GetSelfRank(pbdata, callback)
    self:Access(_G.ConfigManager.net_map.game_rank_get_rank_num, pbdata, callback)
end

function ActivityTrialNet:PlayBack(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_celebration_single_playback, pbdata, callBack)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function ActivityTrialNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ActivityTrialNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return ActivityTrialNet
