local base = require("BaseGameNet")

---@class IceFestivalNet : BaseGameNet	通信协议
local IceFestivalNet = _G.BaseClass("IceFestivalNet", base)
---@return IceFestivalNet IceFestivalNet
function IceFestivalNet:GetInstance()
    return base.GetInstance(self)
end


---锁心猎场-放置
function IceFestivalNet:PutSlot(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_cumulative_award_port_put_slot, pbdata, callBack)
end

---锁心猎场-卸下
function IceFestivalNet:TakeOffSlot(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_cumulative_award_port_take_off, pbdata, callBack)
end

---锁心猎场-领奖
function IceFestivalNet:GetCumulativeAward(pbdata, callBack)
    self:Access(_G.ConfigManager.net_map.game_activity_cumulative_award_port_get_award, pbdata, callBack)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function IceFestivalNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function IceFestivalNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return IceFestivalNet
