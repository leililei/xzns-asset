local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentEmbattleNewView : UIBaseView    中文描述
---@field public go_table ActivityDispatchEmbattleNewView_GoTable GoTable
local ActivityTournamentEmbattleNewView = _G.BaseClass("ActivityTournamentEmbattleNewView", _G.UIBaseView)

function ActivityTournamentEmbattleNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityTournamentEmbattleNewView:OnCreate(embattletype, itemType, exit, battle)
    self.onExitCall = exit
    self.onBattleCall = battle
    self.embattletype = embattletype

    self.itemType = itemType
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        embattletype,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.ActivityTournament,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        500000001
    )
end

function ActivityTournamentEmbattleNewView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
end

---监听界面打开
---@param name string 界面名称
function ActivityTournamentEmbattleNewView:OnEmbattleOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.mCanvas = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, self.mCanvas.sortingOrder)
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
    end
    ActivityTournamentModel:GetInstance():OnEmbattleOpened(name)
end

function ActivityTournamentEmbattleNewView:OnBattleCall(sid, multiple, index)
    self:Close()
    if self.onBattleCall then
        self.onBattleCall()
    end
end

function ActivityTournamentEmbattleNewView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
    end
end

---按钮点击事件在这里派发
function ActivityTournamentEmbattleNewView:OnClickBtn(go)
end

return ActivityTournamentEmbattleNewView
