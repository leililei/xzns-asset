local ActivityTournamentModel = require("ActivityTournamentModel")
local ActivityTourGuessTaskItem = require("ActivityTourGuessTaskItem")

---@class ActivityTourGuessTaskView : UIBaseView 窗口
---@field private go_table ActivityTourGuessTaskView_GoTable GoTable
local ActivityTourGuessTaskView = BaseClass("ActivityTourGuessTaskView",UIBaseView)

function ActivityTourGuessTaskView:__init()

end

function ActivityTourGuessTaskView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
    --self:GetData()
end

function ActivityTourGuessTaskView:InitData(msg)
    ---@type ActivityTournamentGuessView
    self.view = msg.view
    self.model = ActivityTournamentModel:GetInstance()
    self.StageData = self.model.StageData
    ---@type ActivityTourGuessTaskData[]
    self.taskData = {}
    self.taskData = self.model.taskData[self.model.stage]
    if self.model.stage == 3 then
        self.data = self.StageData.eliminate_info
    elseif self.model.stage == 4 or self.model.stage == 5 then
        self.data = self.StageData.champion_info
        self.taskData = self.model.taskData[4]
    end

    local showIds = self.model.cfg.preselect_task
    local showIdDict = {}
    if self.model.stage >= 3 then
        showIds = self.model.cfg.champion_task
    end
    for i = 1, #showIds do
        showIdDict[showIds[i]] = true
    end
    
    ---@type ActivityTourGuessTaskData[]
    self.showData = {}

    for i = 1, #self.taskData do
        if showIdDict[self.taskData[i].Cfg.id] then
              table.insert(self.showData ,self.taskData[i])
        end
    end

    ---@type table<number,boolean>
    self.compTask = {}
    self.compTaskNum = 0
    for i = 1, #self.showData do
        local state = self.showData[i]:GetState()
        if state == _G.TaskEnum.ETaskState.Claimed then
            self.compTask[self.showData[i].Cfg.id] = true
            self.compTaskNum = self.compTaskNum + 1
        end
    end

    ---@type activity_tournament.process_award_info[]
    self.propData = self.model.cfg.process_award
    table.sort(self.propData,function(a,b)
        return a.process < b.process
    end)
    self.MaxTaskNum = self.propData[#self.propData].process

    ---@type ActivityTourGuessTaskItem[]
    self.itemList = {}
    self.CaCheLoadAwardList = {}
end

---@param data task.i_task
function ActivityTourGuessTaskView:IsClaimed(data)
    if data.state ==  _G.TaskEnum.ETaskState.Claimed then
        return true
    end
end

function ActivityTourGuessTaskView:RefreshData()
    ---@type table<number,boolean>
    self.compTask = {}
    self.compTaskNum = 0
    for i = 1, #self.showData do
        local state = self.showData[i]:GetState()
        if state == _G.TaskEnum.ETaskState.Claimed then
            self.compTask[self.showData[i].Cfg.id] = true
            self.compTaskNum = self.compTaskNum + 1
        end
    end
    self.process_state = {}
    if self.data.process_state then
        for k, v in pairs(self.data.process_state) do
            self.process_state[v] = true
        end
    end

    table.sort(self.showData,function(a,b)
        local state1 = a:GetState()
        local state2 = b:GetState()
        if state1 == state2 then
            return a.Cfg.id < b.Cfg.id
        else
            if state1 == _G.TaskEnum.ETaskState.Completed then
                return true
            elseif state2 == _G.TaskEnum.ETaskState.Completed then
                return false
            elseif state1 == _G.TaskEnum.ETaskState.Claimed then
                return false
            elseif state2 == _G.TaskEnum.ETaskState.Claimed then
                return true
            else
                return a.Cfg.id < b.Cfg.id
            end
        end
    end)
end

function ActivityTourGuessTaskView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))

    ---@type ActivityTourGuessTaskView._aorbtn_box1_GoTable[]
    self.boxList = {}
    for i = 1, 5 do
        local item = self.go_table["aorbtn_box" .. i]
        table.insert(self.boxList,GetAutoGoTable(item,handlerbind(self,self.Onlick_box,i)))
    end
    self.go_table.scrollloopvectical_Group:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function ActivityTourGuessTaskView:Onlick_box(go,isOn,index)
    if self.propData[index] then
        local active = self.propData[index].process
        self.getRewards = {}
        for i = 1, #self.propData do
            if self.propData[i].process < active and self.process_state[self.propData[i].process] == nil  then
                table.insert(self.getRewards,self.propData[i].process)
            end
        end
        table.insert(self.getRewards,active)
        if self.compTaskNum >= active then
            self.model:GetTaskProcessAward(self.getRewards,function(msg)
                --解析奖励
                if self.data.process_state == nil then
                    self.data.process_state = {}
                end
                for i = 1, #self.getRewards do
                    self.process_state[self.getRewards[i]] = true
                    self.data.process_state[#self.data.process_state  + 1] = self.getRewards[i]
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CommonAwardView.Name,msg)
                local redPointId = self.model.curActivityClass.typeClass:GetRedpointIDByIndex(8)
                require("RedPointManager"):GetInstance():RefreshNode(redPointId)
                self:RefreshData()
                self:RefreshUI()
                self.view:RefreshData()
                self.view:RefreshUI()
            end)
        else
            self:ShowItems(self.boxList[index].transform,index,false)
        end
    end
end

function ActivityTourGuessTaskView:ShowItems(btn,Index, isGou)
    if Index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    local x, y, z = btn:GetPosition()
    self.go_table.obj_ItemTips:SetPosition(x, y, z)

    self.NowShowIndex = Index
    local NowItems = {}
    local award = self.propData[Index].award
    if award and award[1] and award[1].type then
        for i = 1, #award do
            table.insert(NowItems,{award[i].type[4],award[i].type[5]})
        end
    end

    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end

    self.go_table.obj_Parent:ClearChildren()
    for i = 1, #NowItems do
        local info = NowItems[i]
        local num = info[2]
        self:CareatItem(
                info,
                isGou,
                self.go_table.obj_Parent,
                function(item)
                    item.gameObject:SetRectTransformSize(88, 88)
                    item.gameObject:SetLocalScaleXYZ(0.6)
                end
        )
    end
    ---@type UnityEngine.RectTransform
    -- local rect =  self.go_table.obj_itemBg:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.go_table.obj_itemBg:SetRectTransformSize((#NowItems) * 75, 80)
    self.go_table.obj_ItemTips:SetRectTransformSize((#NowItems) * 75, 80)
    _G.UIUtils.SetOffScreenRectPosition(self.go_table.obj_ItemTips)
end

function ActivityTourGuessTaskView:CareatItem(data, isGou, Parent, backCall)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    local id = Parent:GetInstanceID()
    if self.CaCheLoadAwardList[id] then
        if self.CaCheLoadAwardList[id][Sid] then
            return
        end
    else
        self.CaCheLoadAwardList[id] = {}
    end
    self.CaCheLoadAwardList[id][Sid] = true
    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data,
                Parent,
                function(item)
                    if _G.IsNil(Parent) then
                        _G.DestroyImmediate(item.gameObject)
                        return
                    end
                    self.CaCheLoadAwardList[id][Sid] = false
                    item.gameObject:SetLocalScaleXYZ(0.8)
                    item.gameObject:SetActiveE(1)
                    item:SetPri(data.isPri)
                    item:SetGou(isGou)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    if item.SetGradeNew then
                        item:SetGradeNew(false)
                    end
                    if backCall then
                        backCall(item)
                    end
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
                end
        )
    end
    --end
end

function ActivityTourGuessTaskView:RefreshItem(index,obj)
    local newIndex = index + 1
    local data = self.showData[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = ActivityTourGuessTaskItem.New(obj)
    end
    item:RefreshItem(data,handler(self,self.GetData))
end

function ActivityTourGuessTaskView:RefreshUI()
    self.go_table.scrollloopvectical_Group:UpdateCount(#self.showData)
    self.go_table.aorimage_activeSchedule.fillAmount = self.compTaskNum/self.MaxTaskNum - 0.05
    self.go_table.aortext_nowActive.text = self.compTaskNum
    for i = 1, #self.boxList do
        if self.propData[i] then
            self.boxList[i].transform:SetActiveE(1)
            self.boxList[i].aortext_active.text = self.propData[i].process
            local isGetData = self.process_state[self.propData[i].process]
            local iconId = i
            if iconId > 4 then
                iconId = 4
            end
            local anim = self.boxList[i].aorrawimage_box:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
            if isGetData then
                anim.enabled = false
                self.boxList[i].aorrawimage_box:LoadImage("ImagesH5/hActiveTask/richangdakai" .. iconId)
                self.boxList[i].aorrawimage_box:SetGray(true)
            else

                local active =  self.propData[i].process
                if self.compTaskNum >= active then
                    anim.enabled = true
                else
                    anim.enabled = false
                end
                self.boxList[i].aorrawimage_box:LoadImage("ImagesH5/hActiveTask/richangbaoxiang" .. iconId)
                self.boxList[i].aorrawimage_box:SetGray(false)
            end
        else
            self.boxList[i].transform:SetActiveE(0)
        end
    end
end

function ActivityTourGuessTaskView:onClick(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_TipsView then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
    end
end

