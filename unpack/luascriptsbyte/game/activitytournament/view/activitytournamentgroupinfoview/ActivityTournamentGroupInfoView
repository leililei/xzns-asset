local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentGroupInfoView : UIBaseView    中文描述
---@field public go_table ActivityTournamentGroupInfoView_GoTable GoTable
local ActivityTournamentGroupInfoView = _G.BaseClass("ActivityTournamentGroupInfoView", _G.UIBaseView)

local indexType = {
    [9] = 1,
    [10] = 1,
    [11] = 1,
    [12] = 1,
    [13] = 2,
    [14] = 2,
    [15] = 3,
}

local gussImg = {
    [1] = "ui_jsbl_grph_jjq",
    [2] = "ui_jsbl_grph_jjq",
    [3] = "ui_jsbl_grph_jj",
}

local gussName = {
    [1] = 90049900086,
    [2] = 90049900087,
    [3] = 90049900088,
}

local posArray = {
    [9] = { 1, 2 },
    [10] = { 3, 4 },
    [11] = { 5, 6 },
    [12] = { 7, 8 },
    [13] = { 9, 10 },
    [14] = { 11, 12 },
    [15] = { 13, 14 },
}

---构造函数
---@protected
function ActivityTournamentGroupInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityTournament.GuessChange, self.GuessChange)
    self:AddListener(_G.eActivityTournament.GroupInfoChange, self.GuessChange)
    self.timeBattleKey = _G.ConfigManager.discrete_cfg[138008][1][2]
end

---界面的入口函数
function ActivityTournamentGroupInfoView:OnCreate()
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
    self.toggles = {}
    self.itemList = {}
    self.self_round = ActivityTournamentModel:GetInstance().self_round
    self:SetTime()
    self.type = self.stage == 3 and 1 or 2
    self.groupIndex = 0
    self.timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]][2]
    local index = ActivityTournamentModel:GetInstance():GetGroupIndex()
    for i = 1, 8 do
        local obj = _G.InstantiateObject(self.go_table.toggle_tag, self.go_table.togglegroup_Content)
        obj:SetActiveE(1)
        self.toggles[i] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickToggle, i))
        self.toggles[i].aortext_label1.text = _G.GetLangPackValue(90049900025, _G.GameUtil.NumberToChinese(i))
        self.toggles[i].aortext_label2.text = _G.GetLangPackValue(90049900025, _G.GameUtil.NumberToChinese(i))
        self.toggles[i].obj_self:SetActiveE(index == i and 1 or 0)
    end
    self:RefreshPage()
    self:GuessTag()
    self.go_table.aorbtn_guess:SetActiveE(self.stage > 3 and 1 or 0)
    self.go_table.obj_redpointGuess:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(4))
end

---
---@protected
function ActivityTournamentGroupInfoView:GuessTag()
    local data = ActivityTournamentModel:GetInstance().GuessData
    if data and data.guess_pub then
        local tagIndex = 0
        for i, v in ipairs(data.guess_pub) do
            if v.round == 1 and v.index == self.roundIndex then
                tagIndex = v.group_index
                break
            end
        end
        for i = 1, 8 do
            self.toggles[i].obj_guss:SetActiveE(tagIndex == i and 1 or 0)
        end
    end
end

---
---@protected
function ActivityTournamentGroupInfoView:GuessChange()
    if self.round == 1 then
        self:GuessTag()
    end
    self:SetGroupInfoView()
end

function ActivityTournamentGroupInfoView:RefreshPage()
    self.go_table.obj_ToggleList:SetActiveE(self.type == 1 and 1 or 0)
    self.go_table.aorimage_title.SpriteName = self.type == 1 and "ui_kfzf_txt_jjs" or "ui_kfzf_txt_gjs"
    for i = 1, 2 do
        self.go_table["obj_choose" .. i]:SetActiveE(self.type == i and 1 or 0)
    end
    if self.type == 2 then
        self:SetGroupInfoView()
    else
        if self.groupIndex == 0 then
            local index = ActivityTournamentModel:GetInstance():GetGroupIndex()
            if index == 0 then
                index = 1
            end
            self.toggles[index].gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
            if index > 3 then
                local x = -500 - (index - 4) * 213
                self.go_table.togglegroup_Content:SetLocalPosition(x, 39, 0)
            end
        else
            self:SetGroupInfoView()
        end
    end
    if self.stage ~= 5 then
        self:UpdateTimer()
    end
end

---监听Toggle点击事件
---@param key string
---@param callback function
function ActivityTournamentGroupInfoView:OnClickToggle(_, isOn, key)
    if isOn then
    end
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)

    if isOn then
        if self.groupIndex == key then
            return
        end
        self.groupIndex = key
        self:SetGroupInfoView()
    end
end

function ActivityTournamentGroupInfoView:SetTime()
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()

    self.round = ActivityTournamentModel:GetInstance():GetRound()
    self.roundIndex = ActivityTournamentModel:GetInstance():GetRoundIndex()

    self.go_table.aorimage_title.SpriteName = self.stage == 3 and "ui_kfzf_txt_jjs" or "ui_kfzf_txt_gjs"

    --self.go_table.obj_time:SetActiveE(self.stage ~= 5 and 1 or 0)
    if self.stage ~= 5 then
        if not self.timer then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
            self.timer:Start()
        end
        self:UpdateTimer()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90049900089)
        self.go_table.obj_redpointEmbattle:SetActiveE(0)
    end
end

function ActivityTournamentGroupInfoView:UpdateTimer()
    local time = self.stageEndTime - _G.TimeUtil.GetServerUnixTime()
    if self.round == 1 and self.type == 1 then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.TranslateSecondForStr(time))
    elseif self.round == 1 and self.type == 2 then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90010050330, _G.TimeUtil.TranslateSecondForStr(time))
    elseif self.round == 2 and self.type == 1 then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90049900089)
    elseif self.round == 2 and self.type == 2 then
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.TranslateSecondForStr(time))
    end

    if self.self_round ~= 0 then
        self.go_table.obj_redpointEmbattle:SetActiveE(((_G.TimeUtil.GetSecondsOfDay() <= self.timeBattleKey) and (ActivityTournamentModel:GetInstance().isOpenEmbattle == nil)) and 1 or 0)
    end

    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
end

---
---@protected
function ActivityTournamentGroupInfoView:IsHide(index, isHide)
    if (self.type == self.round and indexType[index] ~= nil and indexType[index] == self.roundIndex and isHide == true) or
        (self.type == 2 and self.round == 1 and self.roundIndex == 3 and indexType[index] == nil and isHide == true) then
        return true
    end
    return false
end

function ActivityTournamentGroupInfoView:SetGroupInfoView()
    ActivityTournamentModel:GetInstance():GetGroupInfo(self.type, self.type == 2 and 1 or self.groupIndex, function(data)
        self.GroupInfo = data
        for i = 1, 15 do
            if self.itemList[i] == nil then
                self.itemList[i] = _G.GetAutoGoTable(self.go_table["obj_item" .. i], _G.handlerbind(self, self.OnClickItem, i))
            end
            self.itemList[i].obj_headParent:SetActiveE(0)
            self.itemList[i].obj_emptyHead:SetActiveE(1)
            self.itemList[i].obj_line:SetActiveE(0)
            self.itemList[i].obj_gray:SetActiveE(0)
            self.itemList[i].aortext_name.text = ""
            if self.itemList[i].aortext_text then
                if self.type == 2 and i < 9 then
                    if self.GroupInfo[i] == nil or self.GroupInfo[i].role_info == nil then
                        self.itemList[i].aortext_text.text = _G.GetLangPackValue(90049900023, _G.GameUtil.NumberToChinese(i))
                    else
                        self.itemList[i].aortext_text.text = ""
                    end
                elseif i == 15 then
                    self.itemList[i].aortext_text.text = self.type == 1 and _G.GetLangPackValue(90049900084) or _G.GetLangPackValue(90049900076)
                else
                    self.itemList[i].aortext_text.text = ""
                end
            end
            if i > 8 then
                local list = posArray[i]
                local leftData = self.GroupInfo[list[1]]
                local rightData = self.GroupInfo[list[2]]
                self.itemList[i].aorbtn_Reply:SetActiveE((leftData ~= nil and rightData ~= nil) and 1 or 0)
            end
        end
        local data = ActivityTournamentModel:GetInstance().GuessData

        local roleKV = {}
        if data and data.guess_role then
            for i, v in ipairs(data.guess_role) do
                if v.round == self.type then
                    roleKV[v.index] = {}
                    for k2, v2 in ipairs(v.info) do
                        roleKV[v.index][v2.target] = true
                    end
                end
            end
        end
        for k, v in pairs(self.GroupInfo) do
            if v.role_info ~= nil then
                self.itemList[k].obj_headParent:SetActiveE(1)
                self.itemList[k].obj_emptyHead:SetActiveE(0)
                local scale
                if k < 9 then
                    scale = 0.6
                elseif k >= 9 and k < 13 then
                    scale = 0.7
                elseif k >= 13 and k < 15 then
                    scale = 0.8
                elseif k == 13 then
                    scale = 0.85
                end

                if v.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.UIUtils.SetPlayerHeadItemNew(self.itemList[k].obj_HeadItemBase, _G.PlayerModel:GetInstance():GetIRroleTable(), scale, true, true, true)
                    self.itemList[k].aortext_name.text = _G.PlayerModel:GetInstance():GetName()
                else
                    _G.UIUtils.SetPlayerHeadItemNew(self.itemList[k].obj_HeadItemBase, v.role_info, scale, true, true, true)
                    self.itemList[k].aortext_name.text = v.role_info.name
                end
                local itemGoTable = _G.GetAutoGoTable(self.itemList[k].obj_HeadItemBase)
                itemGoTable.aorimage_portrait:SetGray(v.result ~= nil and v.result.result == 2)

                self.itemList[k].obj_line:SetActiveE((v.result ~= nil and v.result.result == 1) and 1 or 0)

                local index = indexType[k] and indexType[k] + 1 or 1

                if self.itemList[k].obj_guss then
                    self.itemList[k].obj_guss:SetActiveE((roleKV[index] and roleKV[index][v.role_info.uid]) and 1 or 0)
                end

                if roleKV[index] and roleKV[index][v.role_info.uid] then
                    local state = 1
                    if v.result ~= nil and v.result.result == 1 then
                        state = 2
                    elseif v.result ~= nil and v.result.result == 0 then
                        state = 3
                    end

                    self.itemList[k].aorimage_guss.SpriteName = gussImg[state]
                    self.itemList[k].aortext_guss.text = _G.GetLangPackValue(gussName[state])
                end
                if k ~= 15 then
                    local cpNum = (k % 2) == 0 and (k - 1) or (k + 1)
                    if self.GroupInfo[cpNum] == nil or self.GroupInfo[cpNum].role_info == nil then
                        self.itemList[cpNum].aortext_name.text = _G.GetLangPackValue(90049900080)
                        self.itemList[cpNum].obj_gray:SetActiveE(1)
                    end
                end
            end
        end
    end)
end

function ActivityTournamentGroupInfoView:OnClickItem(go, _, posIndex)
    local name = go:GetName()
    if name == "@_aorbtn_Reply" then
        if self.GroupInfo[posIndex] then
            ActivityTournamentModel:GetInstance():GetReportEliminate(self.type, indexType[posIndex], self.GroupInfo[posIndex].role_info.uid, function(msg)
                if msg.reports == nil then
                    _G.PopWindowManager:GetInstance():ShowAllTips(1080602)
                end
            end)
        else
            local requestNum = 2
            local list = posArray[posIndex]
            local ReportData = {}
            local leftData = self.GroupInfo[list[1]].role_info
            local rightData = self.GroupInfo[list[2]].role_info
            if leftData then
                ActivityTournamentModel:GetInstance():GetEnemyGarray(leftData.uid, nil, function(msg)
                    ---@type s2c_get_target_array[]
                    ReportData[1] = msg
                    requestNum = requestNum - 1
                    if requestNum <= 0 then
                        ---@type ActivityTourReportView
                        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ActivityTourReportView.Name, {
                            ReportData = ReportData,
                            curStage = 1,
                            leftData = leftData,
                            rightData = rightData
                        })
                    end
                end)
            end
            if rightData then
                ActivityTournamentModel:GetInstance():GetEnemyGarray(rightData.uid, nil, function(msg)
                    ReportData[2] = msg
                    requestNum = requestNum - 1
                    if requestNum <= 0 then
                        ---@type ActivityTourReportView
                        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ActivityTourReportView.Name, {
                            ReportData = ReportData,
                            curStage = 1,
                            leftData = leftData,
                            rightData = rightData
                        })
                    end
                end)
            end
        end
    end
end

---界面的销毁函数
function ActivityTournamentGroupInfoView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function ActivityTournamentGroupInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Tag1 then
        self.type = 1
        self:RefreshPage()
    elseif go == self.go_table.aorbtn_Tag2 then
        self.type = 2
        self:RefreshPage()
    elseif go == self.go_table.aorbtn_embattle then
        ActivityTournamentModel:GetInstance():OpenEmbattleDefence()
        ActivityTournamentModel:GetInstance().isOpenEmbattle = true
    elseif go == self.go_table.aorbtn_guess then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentChampionGuessView.Name)
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 219)
    end
end

return ActivityTournamentGroupInfoView