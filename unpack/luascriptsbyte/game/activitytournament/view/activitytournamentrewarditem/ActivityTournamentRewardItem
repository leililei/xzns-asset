---@param data arena_rank_cfg
function ActivityTournamentRewardItem:RefreshItem(data, index)
    self.rewardList = self:GetShowCfgRewardList(data)
    self.data = data
    self.index = index

    RankUtils.SetRankItemBgIcon(self.go_table.aorimage_bg, index)

    local id = _G.ConfigManager.discrete_cfg[138016][1][index]
    self.go_table.aortext_rank.text = GetLangPackValue(id)

    GameUtil.ReBuildRTF(self.go_table.obj_nameNode)

    self:RefreshRewardNode()

    self.isLoadTitle = false
    self:LoadTitle()
end

function ActivityTournamentRewardItem:LoadTitle()
    if self.isLoadTitle then
        return
    end
    self.isLoadTitle = true
    self.go_table.obj_TitleNode:RemoveAllChildren()

    self.reward_appearance = self.data.reward_appearance
    if self.reward_appearance and self.reward_appearance[1] then
        local AppearanceType = self.reward_appearance[1]
        if AppearanceType[1] == 13 then
            --称号
            local player_frame = _G.ConfigManager.player_title_effect_cfg[AppearanceType[2]]
            self.go_table.obj_TitleNode:RemoveAllChildren()
            if player_frame then
                _G.UIUtils.LoadEffectTitleOrFrame(
                    player_frame.title,
                    self.go_table.obj_TitleNode,
                    function(trans)
                        trans:SetLocalScaleXYZ(0.7)
                        self.isLoadTitle = false
                    end
                )
            end
        elseif AppearanceType[1] == 14 then
            --光环

        end
    end
end

