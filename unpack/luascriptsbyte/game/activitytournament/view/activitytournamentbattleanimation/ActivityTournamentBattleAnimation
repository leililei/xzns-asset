local ActivityDispatchModel = require("ActivityDispatchModel")
---@class ActivityTournamentBattleAnimation : UIBaseView    中文描述
---@field public go_table ActivityDispatchBattleAnimation_GoTable GoTable
local ActivityTournamentBattleAnimation = _G.BaseClass("ActivityTournamentBattleAnimation", _G.UIBaseView)

---构造函数
---@protected
function ActivityTournamentBattleAnimation:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityDispatch.FightAllEnd, self.SetEnd)
end

---界面的入口函数
function ActivityTournamentBattleAnimation:OnCreate(enemyHeadInfo)
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(50, self.UpdateTimer, self, true, false, true)
        self.timer:Start()
    end
    self:InitView(enemyHeadInfo)
    self:LoadEffect()
end

function ActivityTournamentBattleAnimation:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_zhangezhengfeng_yijiantiaozhan, self.go_table
                                                                                                     .obj_effect, check)
end

function ActivityTournamentBattleAnimation:UpdateTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityTournamentSettlementView.Name)
    if view then
        view:CloseView()
    end
    self:Close()
end

---
---@protected
function ActivityTournamentBattleAnimation:InitView(enemyHeadInfo)
    for i = 1, 3 do
        local cfg = require "CardCommentManager":GetInstance():CardData(enemyHeadInfo.city_style_id, false)
        self:LoadRoleModel(cfg, i, enemyHeadInfo)
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.prf_Mulading_zg,
        self.go_table.obj_left,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posIndex number 摆放的位置
---@param data activity_dispatch.i_target_role 玩家信息
function ActivityTournamentBattleAnimation:LoadRoleModel(cfg, posIndex, data)
    if cfg then
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            nil,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(self.go_table["obj_anemy_" .. posIndex])
                --trans:SetParentE(self.go_table.obj_right)
                trans:SetLocalPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(1)
            end
        )
    end
end

---
---@protected
function ActivityTournamentBattleAnimation:SetEnd(msg)
    self.msg = msg
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

---界面的销毁函数
function ActivityTournamentBattleAnimation:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function ActivityTournamentBattleAnimation:OnClickBtn(go)
end

return ActivityTournamentBattleAnimation
