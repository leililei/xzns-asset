local DrawUpBattlePassTaskView = require("DrawUpBattlePassTaskView")
local ActivityTournamentModel = require("ActivityTournamentModel")

---@class ActivityTourTaskView : DrawUpBattlePassTaskView 窗口
---@field private go_table ActivityTourTaskView_GoTable GoTable
local ActivityTourTaskView = BaseClass("ActivityTourTaskView",DrawUpBattlePassTaskView)

function ActivityTourTaskView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

function ActivityTourTaskView:InitData(msg)
    self.model =  ActivityTournamentModel:GetInstance()
end

function ActivityTourTaskView:RefreshData()
    ---@type ActivityTourGuessTaskData[]
    self.taskDatas = self.model:GetCurShowTaskData()

end

function ActivityTourTaskView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))
end

function ActivityTourTaskView:RefreshUI()
    self:RefreshTask()
end

---任务刷新
function ActivityTourTaskView:RefreshTask()
    self:SortTask()
    if self.isInited == nil then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
        self.isInited = true
    else
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.taskDatas)
    end
end

function ActivityTourTaskView:RefreshTaskItem(index, obj)
    ---@type DrawUpBattlePassTaskView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local data = self.taskDatas[index + 1]
    --go_table.aortext_hzExp.text = data.Cfg.other_award[1].num
    local state = data:GetState()
    if state == _G.TaskEnum.ETaskState.Completed then
        --self:SetTaskItemjd(go_table.aorimage_jd, data.Cfg.count, data.Cfg.count)
        --go_table.aortext_jd.text = _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        go_table.aortext_info.text = GetLangPackValue(data.Cfg.desc) .. _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = false
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    elseif state == _G.TaskEnum.ETaskState.Claimed then
        go_table.aortext_info.text =  GetLangPackValue(data.Cfg.desc).. _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = true
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        --self:SetTaskItemjd(go_table.aorimage_jd, data.i_task.target[1], data.Cfg.count)
        --go_table.aortext_jd.text = _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aortext_info.text =  GetLangPackValue(data.Cfg.desc) .. _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        --if data.Cfg.link and data.Cfg.link ~= 0 then
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90023300110)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.Cfg.reward[i],
                go_table.obj_items,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.8)
                    --if data.Cfg.reward[i] > 1 then
                    --    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    --else
                    --    tran:ShowNumText(false)
                    --end
                    tran:ShowNumText(true,require("ItemViewBase").NumTextAnchor.RightDown)
                    local state = data:GetState()
                    tran:SetGou(state == _G.TaskEnum.ETaskState.Claimed)
                    if tran.ShowEffectOrder and tran.cfg then
                        tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                    end
                end
        )
    end
end

function ActivityTourTaskView:SortTask()
    ---@param data ActivityTourGuessTaskData
    _G.SortList(
            self.taskDatas,
            function(data)
                local index = 1
                local state = data:GetState()
                if state == _G.TaskEnum.ETaskState.Completed then
                    index = 2
                elseif state == _G.TaskEnum.ETaskState.Claimed then
                    index = -1
                end
                return index, -data.i_task.sid
            end
    )
end

function ActivityTourTaskView:onClick(go)
    if go == self.go_table.aorbtn_close2 or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

