local PersonalRankFullView = require("PersonalRankFullView")
local ItemViewBase = require("ItemViewBase")

---@class ActivityTourRankRewardView : PersonalRankFullView
---@field private go_table PersonalRankFullView_GoTable GoTable
---@field private super PersonalRankFullView GoTable
local ActivityTourRankRewardView = BaseClass("ActivityTourRankRewardView", PersonalRankFullView)

function ActivityTourRankRewardView:InitCfgData()
    ActivityTourRankRewardView.super.InitCfgData(self)
    if self.data.isShowPlayRankNode == 0 then
        self.go_table.rect_rankList:SetRectTransformOffset(2, 127.5, 2, -207.8)
    else
        --self.go_table.scrollloopvectical_rankList:SetRectTransformSize(720,207)
    end
    self.selfNode.looplist2_reard:InitListView(0, _G.handler(self, self.OnRefreshRewardList))
end

function ActivityTourRankRewardView:OnRefreshRewardList(listView2, index)
    local item = listView2:NewListViewItem("$_obj_ListItem")
    --local tb = _G.GetAutoGoTable(item)
    item:RemoveAllChildren()
    --local newindex = index + 1
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
    --self.myRankReward[self.rewardCount - index],
        self.myRankReward[index + 1],
        item,
        function(tran)
            if self.go_table == nil then
                DestroyObject(tran)
            end
            self:SetRewardItem(tran)
        end
    )
    return item
end

function ActivityTourRankRewardView:RefreshRewardNode()
    if self.isLoadIng then
        return
    end
    self.isLoadIng = true
    self.AsCount = 0
    self.AddCountComp = false
    local rewards = self.myRankReward
    local length = #rewards
    self.selfNode.obj_ContentItem:RemoveAllChildren()
    for i = 1, length do
        self.AsCount = self.AsCount + 1
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewards[length - i + 1],
            self.selfNode.obj_ContentItem,
            function(tran)
                if self.go_table == nil then
                    DestroyObject(tran)
                end
                self:SetRewardItem(tran)
                self.AsCount = self.AsCount - 1
                if self.AsCount == 0 and self.AddCountComp then
                    self.isLoadIng = false
                end
            end
        )
    end
    self.AddCountComp = true
end

---@param item ItemViewBase
function ActivityTourRankRewardView:SetRewardItem(item)
    item.gameObject:SetLocalScaleXYZ(0.75)
    --item:ShowNumText(true)
    item:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
end

function ActivityTourRankRewardView:RefreshMyRankAndMilitaryMerit()
    self.selfNode.aortext_Military:SetActiveE(0)
    if self.data == nil or self.data.myRank == nil or self.data.myRank == 0 then
        self.selfNode.aortext_rank:SetActiveE(0)
        self.selfNode.aortext_noRank:SetActiveE(1)
        self.selfNode.aortext_noRank.text = _G.GetLangPackValue(90049900079)
    else
        self.selfNode.aortext_rank:SetActiveE(1)
        self.selfNode.aortext_noRank:SetActiveE(0)

        local cfg = _G.ConfigManager.discrete_cfg[138017]
        for i, v in ipairs(cfg) do
            if self.data.myRank >= v[1] and self.data.myRank <= v[2] then
                self.selfNode.aortext_rank.text = _G.GetLangPackValue(v[3])
                break
            end
        end
    end

    ---@type table[]
    self.myRankReward = self:GetShowCfgRewardList(self:GetMyRankReward())
    if self.myRankReward == nil then
        self.rewardCount = 0
        self.selfNode.looplist2_reard:SetListItemCount(0, true)
        return
    end
    self.rewardCount = #self.myRankReward
    --self.selfNode.looplist2_reard:SetListItemCount(self.rewardCount, true)
    self:RefreshRewardNode()
end

---@return arena_rank_cfg
function ActivityTourRankRewardView:GetMyRankReward()
    local rank
    if self.data == nil or self.data.myRank == nil or self.data.myRank == 0 then
        rank = 99999
    else
        rank = self.data.myRank
    end
    for i, v in ipairs(self.cfgs) do
        if v.min_rank <= rank and v.max_rank >= rank then
            return v
        end
    end
    return nil
end

---@return ActivityTourRankRewardView
return ActivityTourRankRewardView