local ActivityTournamentModel = require("ActivityTournamentModel")
local ActivityTourGuessRecordItem = require("ActivityTourGuessRecordItem")
local ActivityTourGuessSwitchItem = require("ActivityTourGuessSwitchItem")

---@class ActivityTourGuessSwitchView : UIBaseView 窗口
---@field private go_table ActivityTourGuessSwitchView_GoTable GoTable
local ActivityTourGuessSwitchView = BaseClass("ActivityTourGuessSwitchView",UIBaseView)

function ActivityTourGuessSwitchView:__init()

end

function ActivityTourGuessSwitchView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
    self:GetData()
end

function ActivityTourGuessSwitchView:GetData()
    
end

function ActivityTourGuessSwitchView:GetTeamScope()
    if self.model.roundIndex == 1 then
        return 1,8,4
    elseif self.model.roundIndex == 2 then
        return 9,12,2
    elseif self.model.roundIndex == 3 then
        return 13,14,1
    end
end

function ActivityTourGuessSwitchView:InitData(msg)
    self.curSelectGroup = msg.selectGroup
    self.callBack = msg.callBack
    ---@type ActivityTournamentModel
    self.model = ActivityTournamentModel:GetInstance()

    --self.guess_pub = self.model.GuessData.guess_pub[#self.model.GuessData.guess_pub]
    self.round = self.model.round --1是淘汰轮2是冠军轮
    ---@type ActivityTourGuessSwitchItem[]
    self.itemList = {}

    ---@type table<number,number,number>
    self.roleDict = {}
    self.listCount = 0
    if self.round == 2 then
        self.model:GetGroupInfo(2,1,function(data)
            self.roleData = data
            local starId,endId,groupCount = self:GetTeamScope()
            self.roleRoundData = {}
            for i = 1, groupCount do
                self.roleRoundData[i] = {
                    left = self.roleData[starId + (i - 1) * 2] and self.roleData[starId + (i - 1) * 2].role_info or nil,
                    right = self.roleData[starId + (i - 1) * 2  + 1] and self.roleData[starId + (i - 1) * 2  + 1].role_info or nil,
                }
                if  self.roleRoundData[i].left or self.roleRoundData[i].right then
                    self.listCount =  self.listCount + 1
                end
            end
            self:RefreshData()
            self:RefreshUI()
        end)
    else
        for i = 1, #self.model.GuessData.guess_pub do
            local data = self.model.GuessData.guess_pub[i]
            if self.roleDict[data.index] == nil then
                self.roleDict[data.index] = {}
            end
            for j = 1, #data.info do
                local info = data.info[j]
                self.roleDict[data.index][info.left.uid] = info.left
                self.roleDict[data.index][info.right.uid] = info.right
            end
            self.listCount = self.listCount + 1
        end
    end

    self.guessRoleDict = {}
    if self.model.GuessData.guess_role then
        for i = 1, #self.model.GuessData.guess_role do
            local data = self.model.GuessData.guess_role[i]
            if data.round == self.model.round and data.index == self.model.roundIndex then
                self.guessRoleDict[data.info[1].target] = true
            end
        end
    end
end

function ActivityTourGuessSwitchView:RefreshData()

end

function ActivityTourGuessSwitchView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))
    self.go_table.scrollloopvectical_Group:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function ActivityTourGuessSwitchView:RefreshItem(index,obj)
    local newIndex = index + 1
    local data = {}
    if self.round == 2 then
        data = self.roleRoundData[newIndex]
    else
        data = self.model.GuessData.guess_pub[newIndex].info
    end
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = ActivityTourGuessSwitchItem.New(obj)
    end
    item:RefreshItem(data,self.model.round,self.model.roundIndex,newIndex,self.roleDict,handler(self,self.SelectGroup),self.guessRoleDict)
end

function ActivityTourGuessSwitchView:SelectGroup(group)
    if  self.callBack then
        self.callBack(group)
    end
    self:Close()
end

function ActivityTourGuessSwitchView:RefreshUI()
    self.go_table.scrollloopvectical_Group:UpdateCount(self.listCount)
end

function ActivityTourGuessSwitchView:onClick(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

---@return ActivityTourGuessSwitchView
return ActivityTourGuessSwitchView