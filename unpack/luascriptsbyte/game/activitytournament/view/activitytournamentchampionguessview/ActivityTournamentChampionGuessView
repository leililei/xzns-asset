local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentChampionGuessView : UIBaseView    中文描述
---@field public go_table ActivityTournamentChampionGuessView_GoTable GoTable
local ActivityTournamentChampionGuessView = _G.BaseClass("ActivityTournamentChampionGuessView", _G.UIBaseView)

---构造函数
---@protected
function ActivityTournamentChampionGuessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    self.data = {}
end

---界面的入口函数
function ActivityTournamentChampionGuessView:OnCreate()
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()
    self.target = ActivityTournamentModel:GetInstance():GetPredict()
    self.RoundIndex = ActivityTournamentModel:GetInstance():GetRoundIndex()
    self.timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]][2]
    self.curTarget = self.target
    self:CheckIsOpen()
    ActivityTournamentModel:GetInstance():GetGroupInfo(2, 1, function(data)
        self.GroupInfo = data
        for i = 1, 8 do
            if self.GroupInfo[i] and self.GroupInfo[i].role_info then
                local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_root)
                obj:SetActiveE(1)
                self.itemList[i] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, i))
                _G.UIUtils.SetPlayerHeadItemNew(self.itemList[i].obj_HeadItemBase, self.GroupInfo[i].role_info, 1, true, true, true)
                self.itemList[i].aortext_name.text = self.GroupInfo[i].role_info.name
                self.itemList[i].obj_guess:SetActiveE(self.target == self.GroupInfo[i].role_info.uid and 1 or 0)
            end
        end
        self.isAward = false
        self.topUid = self.GroupInfo[15] and self.GroupInfo[15].role_info.uid or 0
        if (self.stage == 4 and self.RoundIndex == 3 and _G.TimeUtil.GetSecondsOfDay() >= self.timeKey) or self.stage == 5 then
            self.isAward = true
        end
        self:SetChooseView()
        self:SetAwardView()

        if self.isOpen == true then
            self:UpdateTimer()
            if not self.timer then
                self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
                self.timer:Start()
            end
        end
    end)
end

function ActivityTournamentChampionGuessView:UpdateTimer()
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    local time = self.timeKey - curTime
    self.go_table.aortext_time.text = _G.GetLangPackValue(90049900144, _G.TimeUtil.TranslateSecondForStr(time))
    if time <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.go_table.aortext_time.text = ""
        self:CheckIsOpen()
        self:SetChooseView()
    end
end

---
---@protected
function ActivityTournamentChampionGuessView:SetAwardView()
    local award = ActivityTournamentModel:GetInstance():GetCfg().predict_award
    for i, v in ipairs(award) do
        self.data[v.type] = v.award
    end
    for k, v in ipairs(self.data) do
        _G.UIUtils.RemoveChildren(self.go_table["obj_reward" .. k])
        for k2, v2 in ipairs(v) do
            local sid = v2.type[1] == 0 and v2.type[4] or v2.type[1]
            local num = v2.type[1] == 0 and v2.type[5] or v2.type[2]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, num },
                self.go_table["obj_reward" .. k],
                function(tran)
                    if self.go_table == nil then
                        _G.DestroyObject(tran)
                    end
                    tran.gameObject:SetLocalScaleXYZ(1)
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    tran:SetGou((self.target ~= 0 and self.PredictState == 1 and self.topUid == self.target and k == 1) or (self.target ~= 0 and self.PredictState == 1 and self.topUid ~= self.target and k == 2))
                end
            )
        end
    end
end

---
---@protected
function ActivityTournamentChampionGuessView:CheckIsOpen()
    self.isOpen = false
    if self.RoundIndex == 1 and _G.TimeUtil.GetSecondsOfDay() < self.timeKey then
        self.isOpen = true
    end
end

---
---@protected
function ActivityTournamentChampionGuessView:SetChooseView()
    for i = 1, 8 do
        if self.itemList[i] then
            self.itemList[i].obj_choose:SetActiveE((self.curTarget and self.curTarget == self.GroupInfo[i].role_info.uid) and 1 or 0)
            self.itemList[i].aorbtn_click:SetActiveE(self.isOpen == true and 1 or 0)
        end
    end
    self:SetChooseBtnView()
end

function ActivityTournamentChampionGuessView:SetChooseBtnView()
    self.go_table.aorbtn_choose:SetActiveE(0)
    if self.isOpen == true then
        self.go_table.aorbtn_choose:SetActiveE(1)
        self.go_table.aorbtn_choose:SetGray(self.curTarget == 0)
        if self.curTarget ~= 0 and self.curTarget == self.target then
            for i = 1, 8 do
                if self.target == self.GroupInfo[i].role_info.uid then
                    self.go_table.aortext_des.text = _G.GetLangPackValue(90049900072, self.GroupInfo[i].role_info.name)
                    break
                end
            end
            self.go_table.aorbtn_choose:SetActiveE(0)
            self.go_table.aortext_des:SetActiveE(1)
        else
            self.go_table.aortext_choose.text = _G.GetLangPackValue(90049900035)
            self.go_table.aorbtn_choose:SetActiveE(1)
            self.go_table.aortext_des:SetActiveE(0)
        end
    end
    if self.isAward == true then
        self.PredictState = ActivityTournamentModel:GetInstance():GetPredictState()
        self.go_table.aorbtn_choose:SetActiveE((self.target ~= 0 and self.PredictState == 0) and 1 or 0)
        if self.target ~= nil and self.PredictState == 0 then
            self.go_table.aortext_choose.text = _G.GetLangPackValue(90022100029)
            self.go_table.aorbtn_choose:SetActiveE(1)
            self.go_table.aortext_des:SetActiveE(0)
        end
        if self.target == 0 then
            self.go_table.aortext_des.text = _G.GetLangPackValue(90049900073)
            self.go_table.aorbtn_choose:SetActiveE(0)
            self.go_table.aortext_des:SetActiveE(1)
        end
    end
end

function ActivityTournamentChampionGuessView:OnClickItem(go, _, posIndex)
    local name = go:GetName()
    if name == "@_aorbtn_click" then
        if self.target == 0 then
            if self.curTarget ~= self.GroupInfo[posIndex].role_info.uid then
                self.curTarget = self.GroupInfo[posIndex].role_info.uid
                self:SetChooseView()
            else
                if self.curTarget == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                else
                    _G.SystemSettingManager:GetInstance():OpenView(self.curTarget)
                end
            end
        else
            if self.GroupInfo[posIndex].role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(self.GroupInfo[posIndex].role_info.uid)
            end
        end
    end
end

---界面的销毁函数
function ActivityTournamentChampionGuessView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function ActivityTournamentChampionGuessView:OnClickBtn(go)
    if go == self.go_table.aorbtn_choose then
        if self.isAward == true and self.PredictState == 0 then
            ActivityTournamentModel:GetInstance():GetChampionGuessAward(function()
                self:SetChooseBtnView()
                self:SetAwardView()
            end)
            return
        end
        self:CheckIsOpen()
        if self.isOpen == true and self.curTarget ~= self.target then
            ActivityTournamentModel:GetInstance():ChampionGuess(self.curTarget, function()
                self.target = self.curTarget
                for i = 1, 8 do
                    if self.itemList[i] then
                        self.itemList[i].obj_guess:SetActiveE(self.target == self.GroupInfo[i].role_info.uid and 1 or 0)
                    end
                end
                self:SetChooseBtnView()
            end)
        end
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ActivityTournamentChampionGuessView