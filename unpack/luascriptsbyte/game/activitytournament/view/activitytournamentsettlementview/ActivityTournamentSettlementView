function ActivityTournamentSettlementView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Close" then
        self:CloseCall(SettlementModel.FunctionEnum.None)
        local redPointId = ActivityTournamentModel:GetInstance().curActivityClass.typeClass:GetRedpointIDByIndex(11)
        require("RedPointManager"):GetInstance():RefreshNode(redPointId)
    elseif name == "@_aorbtn_fight" then
        ActivityTournamentModel:GetInstance():EnterFight(self.EnemyHeadInfo)
    elseif name == "@_aorbtn_clickBg" then
        if self.curType == 1 then
            self:CloseCall(SettlementModel.FunctionEnum.None)
        end
    end
end

