function ActivityTournamentSettlementView:OnClickStatistics(itemGoTable, data, isWin, index)
    --获取对战双方的名称
    local leftName, rightName = _G.PlayerModel:GetInstance():GetName(),
    self.EnemyHeadInfo and self.EnemyHeadInfo.name or ""
    local defUid = self.resultDatas and self.resultDatas[1] and self.resultDatas[1].data.def_uid
    if defUid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        --当前玩家为防守方(防守战报), 交换名称
        local tempName = leftName
        leftName = rightName
        rightName = tempName
    end
    if self.enterType ~= 2 then
        _G.BattleManager:GetInstance():SetArgData(data)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            _G.BattleManager:GetInstance():ParseStatistics(),
            isWin and { 0 } or { 1 },
            function()
                --self.onBtnClick = false
                --self:StartTimer()
            end,
            nil,
            nil,
            1,
            true,
            data,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            { leftName, rightName } --reportParams
        )
    else
        local SetOtherPlayer = function(data)
            local otherPlayer = {}
            otherPlayer.frame = data.frame
            otherPlayer.name = data.name
            otherPlayer.lv = data.level
            otherPlayer.style = data.style
            return otherPlayer
        end
        local battleInfo = {}
        local winnerTb = {}
        for _, v in pairs(self.FightArgs) do
            local isWin = v.winner and v.winner[1] or false
            if self.isObserverAtk then
                isWin = not isWin
            end
            _G.table.insert(battleInfo, _G.BattleManager:GetInstance():GetStatisticsRecord(v))
            _G.table.insert(winnerTb, isWin and 0 or 1)
        end
        local fightData = self:InitData(battleInfo)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            fightData,
            winnerTb,
            function()
            end,
            nil,
            SetOtherPlayer(self.report),
            index,
            true,
            self.FightArgs,
            nil,
            { self.resultDatas[index].playbackUid },
            10,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            { leftName, rightName } --reportParams
        )
    end
end

function ActivityTournamentSettlementView:InitData(data)
    local tb = {}
    local count = _G.table.count(data)
    for i = 1, count do
        local tempData = data[i].FighterInfo[1]
        local temp = {}
        temp.AtkUid = data[i].AtkUid
        temp.DefUid = data[i].DefUid
        temp.statisticsMax = { DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1 }
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

---@param index number
function ActivityTournamentSettlementView:OnClickChange(itemGoTable, index, nextIndex)
    local now = _G.EmbattleType.ActivityTournamentPrepare1 + index
    local next = _G.EmbattleType.ActivityTournamentPrepare1 + nextIndex
    local nowEm = require("EmbattleModel"):GetInstance():GetEmbattleData(now)
    local nextEm = require("EmbattleModel"):GetInstance():GetEmbattleData(next)
    local nowSkill = require("EmbattleModel"):GetInstance():GetSkillIndex(now)
    local nextSkill = require("EmbattleModel"):GetInstance():GetSkillIndex(next)
    local nowPet = require("EmbattleModel"):GetInstance():GetPetSkillIndex(now)
    local nextPet = require("EmbattleModel"):GetInstance():GetPetSkillIndex(next)
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    EmbattleModelIns:SetEmbattleByUids(nextEm, now)
    EmbattleModelIns:SetEmbattleByUids(nowEm, next)
    EmbattleModelIns:SetSkillIndex(now, nextSkill)
    EmbattleModelIns:SetSkillIndex(next, nowSkill)
    EmbattleModelIns:SetPetSkillIndex(now, nextPet)
    EmbattleModelIns:SetPetSkillIndex(next, nowPet)
    EmbattleModelIns:SaveEmbattleDataTable(
        { now, next },
        _G.handlerbind(self, self.OnSaveEnd, index + 1, nextIndex + 1)
    )
end

function ActivityTournamentSettlementView:OnSaveEnd(ack, nowIndex, nextIndex)
    self.myEmbattleDatas[nowIndex], self.myEmbattleDatas[nextIndex] = self.myEmbattleDatas[nextIndex], self.myEmbattleDatas[nowIndex]
    self:ShowAdjustView(true)
end

function ActivityTournamentSettlementView:StopAllTimer()
    if self.seasonTimer then
        self.seasonTimer:Stop()
        self.seasonTimer = nil
    end
end

function ActivityTournamentSettlementView:EscClose()
    self:CloseView()
end

function ActivityTournamentSettlementView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function ActivityTournamentSettlementView:OnDestroy()
    self:StopAllTimer()
end

return ActivityTournamentSettlementView
