---显示阵容
function ActivityTournamentSettlementView:RefreshItem(index, obj)
    ---@type ActivityTournamentSettlementView._obj_item_GoTable
    local item = _G.GetAutoGoTable(obj)
    item.obj_di:SetActiveE(index % 2 == 1 and 1 or 0)
    _G.SetEventTrigger(item.obj_my, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(item.obj_my, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(item.obj_my, "onDragEnd", _G.handler(self, self.OnDragEnd))
    if self.curType == 1 then
        if not item.isShowEffZhuang then
            item.isShowEffZhuang = true
            obj:SetActiveE(0)
            _G.DelayDo(
                0.2 * index,
                function()
                    if obj == nil or item == nil then
                        return
                    end
                    obj:SetActiveE(1)
                    local ani = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
                    if ani then
                        ani:Play("a_SpiritualRealmSettlementView_zhuang")
                    end
                end
            )
        end
        local attacker_team, defender_team = self.FightArgs[index + 1].attacker_team,
        self.FightArgs[index + 1].defender_team
        if self.isObserverAtk then
            attacker_team = self.FightArgs[index + 1].defender_team
            defender_team = self.FightArgs[index + 1].attacker_team
        end
        local a_cards = {}
        if self.FightArgs[index + 1].cardsShow then
            for i, v in ipairs(self.FightArgs[index + 1].cardsShow) do
                a_cards[v.uid] = v
            end
        end
        local b_cards = {}
        if self.FightArgs[index + 1].defender_cardsShow then
            for i, v in ipairs(self.FightArgs[index + 1].defender_cardsShow) do
                b_cards[v.uid] = v
            end
        end
        local isWin = self.result[index + 1]
        self:ShowTeamCard(attacker_team, item.obj_my, index, a_cards, isWin == false)
        self:ShowTeamCard(defender_team, item.obj_enemy, index, b_cards, isWin == true)
        item.obj_resultF:SetActiveE(isWin and 0 or 1)
        item.obj_resultV:SetActiveE(isWin and 1 or 0)
        --结果
        item.aorbtn_statistics:SetActiveE(1)
        item.obj_team:SetActiveE(0)
        --item.obj_botArrow:SetActiveE(0)
        --item.obj_topArrow:SetActiveE(0)
        if item.addClick == nil then
            item.aorbtn_statistics.onClick:AddListener(_G.handlerbind(self, self.OnClickStatistics, item, self.FightArgs[index + 1], isWin, index + 1))
            item.addClick = true
        end
    elseif self.curType == 2 then
        if not item.isShowEffOpen then
            item.isShowEffOpen = true
            obj:SetActiveE(0)
            _G.DelayDo(
                0.2 * index,
                function()
                    if obj == nil or item == nil then
                        return
                    end
                    obj:SetActiveE(1)
                    local ani = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
                    ani:Play("a_ActivityTournamentSettlementView_open")
                end
            )
        end
        self:ShowTeamCard(self.myEmbattleDatas[index + 1], item.obj_my, index)
        self:ShowTeamCard(self.enemyEmbattleDatas[index + 1], item.obj_enemy, index)
        item.obj_resultF:SetActiveE(0)
        item.obj_resultV:SetActiveE(0)
        item.aorbtn_statistics:SetActiveE(0)
        item.obj_team:SetActiveE(0)
        item.aortext_team.text = index + 1
        --local len = #self.myEmbattleDatas
        --if len == 1 then
        --    item.obj_botArrow:SetActiveE(0)
        --    item.obj_topArrow:SetActiveE(0)
        --else
        --    item.aorbtn_change.onClick:RemoveAllListeners()
        --    item.aorbtn_change.onClick:AddListener(_G.handlerbind(self, self.OnClickChange, item, index + 1))
        --    if index + 1 == 1 then
        --        item.obj_botArrow:SetActiveE(1)
        --        item.obj_topArrow:SetActiveE(0)
        --    elseif index + 1 == len then
        --        item.obj_botArrow:SetActiveE(0)
