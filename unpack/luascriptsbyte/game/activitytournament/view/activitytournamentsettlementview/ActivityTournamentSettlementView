---界面的入口函数
function ActivityTournamentSettlementView:OnCreate(call, ...)
    self.callback = call
    self.winCount = 0
    self.isWin = false
    self.ScrollRect = self.go_table.scrollloopvectical_arrayList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    local args = { ... }
    if args[1] == 1 then
        --从战斗进入
        self.enterType = 1
        self:ParseResultData(args[2], args[3], args[4])
        ---@type Params_PlayerHeadItem
        self.PlayerHeadInfo = {}
        self.PlayerHeadInfo.level = _G.PlayerModel:GetInstance():GetLevel()
        self.PlayerHeadInfo.name = _G.PlayerModel:GetInstance():GetName()
        self.PlayerHeadInfo.frame = _G.PlayerModel:GetInstance():GetCurFrame()
        self.PlayerHeadInfo.style = _G.PlayerModel:GetInstance():GetRoleStyle()
    elseif args[1] == 2 then
        --从战报进入
        self.enterType = 1
        self:ParseResultData(args[2], args[3])
        if args[4] == nil then
            ---@type Params_PlayerHeadItem
            self.PlayerHeadInfo = {}
            self.PlayerHeadInfo.level = _G.PlayerModel:GetInstance():GetLevel()
            self.PlayerHeadInfo.name = _G.PlayerModel:GetInstance():GetName()
            self.PlayerHeadInfo.frame = _G.PlayerModel:GetInstance():GetCurFrame()
            self.PlayerHeadInfo.style = _G.PlayerModel:GetInstance():GetRoleStyle()
        else
            self.PlayerHeadInfo = {}
            self.PlayerHeadInfo.level = args[4].level
            self.PlayerHeadInfo.name = args[4].name
            self.PlayerHeadInfo.frame = args[4].frame
            self.PlayerHeadInfo.style = args[4].style
        end
        if args[5] ~= nil then
            self.hideResult = true
        end
        self.ScrollRect.vertical = true
    elseif args[1] == 3 then
        --调整界面
        self.enterType = 3
        ---@type Params_PlayerHeadItem
        self.EnemyHeadInfo = args[2].role_info
        self.mathType = args[2].match_type
        local myScore = ActivityTournamentModel:GetInstance():GetScore()
        if self.mathType == 1 then
            self.EnemyHeadInfo.name = _G.GetLangPackValue(self.EnemyHeadInfo.name)
            self.Scores = {
                myScore,
                myScore,
                myScore,
                myScore
            }
        else
            self.Scores = {
                myScore,
                myScore,
                args[2].score,
                args[2].score
            }
        end
        self.myEmbattleDatas = args[3]
        self.enemyEmbattleDatas = args[4]
        ---@type Params_PlayerHeadItem
        self.PlayerHeadInfo = {}
        self.PlayerHeadInfo.level = _G.PlayerModel:GetInstance():GetLevel()
        self.PlayerHeadInfo.name = _G.PlayerModel:GetInstance():GetName()
        self.PlayerHeadInfo.frame = _G.PlayerModel:GetInstance():GetCurFrame()
        self.PlayerHeadInfo.style = _G.PlayerModel:GetInstance():GetRoleStyle()
    end
    self:InitView()
end

function ActivityTournamentSettlementView:ParseResultData(results, report, scores)
    self.isObserverAtk = false
    --local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid(0)
    --if results and results[1] and results[1].data and results[1].data.def_uid == selfUid then
    --    self.isObserverAtk = true
    --end

    self.resultDatas = results
    self.report = report
    ---@type Params_PlayerHeadItem
    self.EnemyHeadInfo = {}
    self.EnemyHeadInfo.level = self.report.level
    self.EnemyHeadInfo.name = self.report.name
    self.EnemyHeadInfo.frame = self.report.frame
    self.EnemyHeadInfo.style = self.report.style

    self.Scores = scores
    self.result = {}
    self.FightArgs = {}
    for i = 1, #self.resultDatas do
        table.insert(self.FightArgs, self.resultDatas[i].data)
        if self.resultDatas[i].winner == 1 then
            self.winCount = self.winCount + 1
            table.insert(self.result, true)
        else
            table.insert(self.result, false)
        end
    end

    if self.winCount > #self.resultDatas / 2 then
        self.isWin = true
    end
    --如果当前是防守方, 则翻转战斗结果(战报存储以进攻方的视角)
    if self.isObserverAtk then
        self.isWin = not self.isWin
        self.winCount = #self.resultDatas - self.winCount
        for i = 1, #self.result do
            self.result[i] = not self.result[i]
        end
    end
end

