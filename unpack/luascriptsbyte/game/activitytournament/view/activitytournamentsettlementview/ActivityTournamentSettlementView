---获取激活大天赋数量
---@param sid number 卡牌sid
---@param skills table fight_arg中的卡牌技能组
---@return number 激活的大天赋数量
function ActivityTournamentSettlementView:GetTalentsNum(sid, skills)
    local cfg = _G.ConfigManager.card_cfg[sid]
    if cfg == nil then
        return 0
    end
    local attrCfg = _G.ConfigManager.attribute_cfg
    local tCfg
    local num = 0
    for i, node in pairs(cfg.talent) do
        for j, talent in pairs(node) do
            tCfg = attrCfg[talent]
            if tCfg.skill > 0 and _G.table.ContainsValue(skills, tCfg.skill) then
                num = num + 1
            end
        end
    end
    return num
end

function ActivityTournamentSettlementView:AdjustToResult(results, report, scores)
    self.ScrollRect.vertical = true
    self:ParseResultData(results, report, scores)
    self:ShowResultView()
end

function ActivityTournamentSettlementView:OnDragBegin(item, ed, index)
    if self.OnDragBeginTag or self.curType == 1 then
        self.ScrollRect:OnBeginDrag(ed)
        return
    end
    self.isDragTeam = false
    self.OnDragBeginTag = true
    self.DragIndex = 0
    local count = self.go_table.obj_Content:GetChildCountE()
    for i = 1, count do
        local tb = _G.GetAutoGoTable(self.go_table.obj_Content:GetChildE(i - 1))
        if tb.obj_my == item then
            self.DragIndex = i - 1
        end
    end
    self.dragObj = item
    self.startPointy = ed.position.y
    self.ScrollRect:OnBeginDrag(ed)
end

function ActivityTournamentSettlementView:OnDrag(item, ed)
    if not self.OnDragBeginTag then
        self.ScrollRect:OnDrag(ed)
        return
    end
    if not self.isDragTeam then
        if not self.dragObj or math.abs(self.startPointy - ed.position.y) < 20 then
            self.ScrollRect:OnDrag(ed)
            return
        else
            if self.dragObj then
                self.dragObj:SetParentE(self.go_table.trans_choose)
            end
            self.isDragTeam = true
        end
    end
    self.dragPosX, self.dragPosY = _G.CS.UIUtils.ScreenPointToLocalPointInRectangle(self.go_table.trans_choose:GetParent())
    self.go_table.trans_choose:SetLocalPosition(self.dragPosX, self.dragPosY, 0)
end

function ActivityTournamentSettlementView:OnDragEnd(item, ed)
    if not self.OnDragBeginTag then
        self.ScrollRect:OnEndDrag(ed)
        return
    end
    if not self.isDragTeam then
        self.isDragTeam = false
        self.ScrollRect:OnEndDrag(ed)
    else
        local obj = self:CheckDragObj()
        local tb = _G.GetAutoGoTable(self.go_table.obj_Content:GetChildE(self.DragIndex))
        self.dragObj:SetParentE(tb.obj_root)
        if obj and self.DragIndex ~= self.newDragIndex then
            self:OnClickChange(nil, self.DragIndex, self.newDragIndex)
        end
    end
    self.dragObj = nil
    self.OnDragBeginTag = false
end

function ActivityTournamentSettlementView:CheckDragObj()
    local _, y = self.go_table.trans_choose:GetLocalPosition()
    local count = self.go_table.obj_Content:GetChildCountE()
    for i = 1, count do
        if _G.CS.UIUtils.CheckMousePointInRect(self.go_table.obj_Content:GetChildE(i - 1)) then
            self.newDragIndex = i - 1
            return self.go_table.obj_Content:GetChildE(i - 1)
        end
