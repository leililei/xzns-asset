---@param data card.i_show_card
function ActivityTourReportView:SetCardShow(itemList, index, data, parent)
    if itemList == nil then
        itemList = {}
    end
    if data then
        if not itemList[index] then
            ---@param card ItemCardAllView
            _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    parent,
                    function(card)
                        itemList[index] = card
                        card:Show(
                                data.sid,
                                nil,
                                data.star,
                                data.soul_chain_lv,
                                data.level,
                                data.sid,
                                data.soul_state,
                                data.uid,
                                self:GetTalentsNum(data.sid, data.skills)
                        )
                    end
            )
        else
            itemList[index]:Show(
                    data.sid,
                    nil,
                    data.star,
                    data.soul_chain_lv,
                    data.level,
                    data.sid,
                    data.soul_state,
                    data.uid,
                    self:GetTalentsNum(data.sid, data.skills)
            )
            itemList[index].gameObject:SetActiveE(1)
        end
    else
        --if itemList[index] then
        --    itemList[index].gameObject:SetActiveE(0)
        --end
    end
end

