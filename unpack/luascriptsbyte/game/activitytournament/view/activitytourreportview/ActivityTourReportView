function ActivityTourReportView:InitData(msg)
    ---@type activity_tournament.s2c_get_target_array[]|activity_dispatch.s2c_get_target_array[]
    self.ReportData = msg.ReportData
    ---@type ActivityTournamentGuessView.curStage
    self.curStage = msg.curStage
    self.model =  ActivityTournamentModel:GetInstance()
    self.leftRole = msg.leftData
    self.rightRole = msg.rightData
    if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
        self.data = self.model.GuessReport
        self.ReportCount = #self.data.reports
        self.leftWinNum = 0
        self.rightWinNum = 0
        self.GetReportNum = 0
        ---@type
        self.cardDatas = {}
        for i = 1, self.ReportCount do
            local data = self.data.reports[i]
            if data.winner == 0 then
                self.leftWinNum = self.leftWinNum + 1
            else
                self.rightWinNum = self.rightWinNum + 1
            end
        end
        for i = 1, #self.ReportData do
            ---@type fight.i_fight_arg
            local battleData = self.ReportData[i].data
            self.cardDatas[i] = {}
            self.cardDatas[i].attacker_team = battleData.attacker_team
            self.cardDatas[i].defender_team = battleData.attacker_team
        end
    else
        self.data = {}
        self.arraysNumber = #self.ReportData[1].arrays
        ---@type ActivityTourReportView.itemData[]
        self.itemData = {}
        for i = 1, self.arraysNumber do
            ---@type fight.i_fight_arg
            local team1 = self.ReportData[1].arrays[i].team
            local team2 = self.ReportData[2].arrays[i].team
            self.itemData[i] = {}
            self.itemData[i].leftPower = self.ReportData[1].arrays[i].power
            self.itemData[i].rightPower = self.ReportData[2].arrays[i].power
            self.itemData[i].leftIsWin = nil
            self.itemData[i].attacker_team = team1
            self.itemData[i].defender_team = team2
        end
    end
end

