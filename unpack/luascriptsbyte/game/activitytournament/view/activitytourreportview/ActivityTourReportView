function ActivityTourReportView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))
    self.go_table.scrollloopvectical_arrayList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

function ActivityTourReportView:RefreshUI()
    if self.data then
        local obj_myPlayer =  GetAutoGoTable(self.go_table.obj_myPlayer)
        _G.UIUtils.SetPlayerHeadItemNew(obj_myPlayer.obj_myHeadRoot:GetChildE(0), self.leftRole, 0.75, true, true, false)
        local obj_enemyPlayer =  GetAutoGoTable(self.go_table.obj_enemyPlayer)
        _G.UIUtils.SetPlayerHeadItemNew(obj_enemyPlayer.obj_enemyHeadRoot:GetChildE(0), self.rightRole, 0.75, true, true, false)

        self:RefreshHeadNode(obj_myPlayer,self.leftRole)
        self:RefreshHeadNode(obj_enemyPlayer,self.rightRole)

        if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
            self.go_table.aortext_score:SetActiveE(1)
            self.go_table.aortext_score.text = string.format("%s:%s",self.leftWinNum,self.rightWinNum)
            self.go_table.scrollloopvectical_arrayList:UpdateCount(self.ReportCount)
        else
            self.go_table.aortext_score:SetActiveE(0)
            self.go_table.scrollloopvectical_arrayList:UpdateCount(#self.itemData)
        end
    end
end

---@param gotable ActivityTourReportView._obj_myPlayer_GoTable
---@param data role.i_role
function ActivityTourReportView:RefreshHeadNode(gotable,data)
    gotable.aortext_Name.text = data.name
    gotable.aortext_power.text =  GetLangPackValue(90027300033) .. _G.GameUtil.NumberToUnitStrFight(data.power)
    local severname = _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id)
    if severname then
        gotable.aortext_servername:SetActiveE(1)
        gotable.aortext_servername.text = GetLangPackValue(90027300035) ..":".. severname
    else
        gotable.aortext_servername:SetActiveE(0)
    end
end

function ActivityTourReportView:RefreshItem(index, obj)
    local newindex = index + 1
    if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
        local data = self.data.reports[newindex]
        ---@type SpiritualRealmSettlementView._obj_item_GoTable
        local item = _G.GetAutoGoTable(obj,handlerbind(self,self.BattlePlayBack,data,data.winner == 0))
        item.obj_di:SetActiveE(index % 2 == 1 and 1 or 0)
        item.obj_resultV:SetActiveE(data.winner == 0 and 1 or 0)
        item.obj_resultF:SetActiveE(data.winner == 0 and 0 or 1)
        item.aorbtn_statistics:SetActiveE(1)
        ---@type _obj_item._obj_my_GoTable
        local leftGotable = GetAutoGoTable(item.obj_my)
        local rightGotable = GetAutoGoTable(item.obj_enem)
        self:RefreshRoleNode(leftGotable,self.leftRole,newindex,self.cardDatas[newindex].attacker_team)
        self:RefreshRoleNode(rightGotable,self.rightRole,newindex,self.cardDatas[newindex].defender_team)
    else
        ---@type SpiritualRealmSettlementView._obj_item_GoTable
        local item = _G.GetAutoGoTable(obj)
        item.obj_di:SetActiveE(index % 2 == 1 and 1 or 0)
        ---@type ActivityTourReportView.itemData
        local data = self.itemData[newindex]
        item.obj_resultV:SetActiveE(0)
        item.obj_resultF:SetActiveE(0)
        item.aorbtn_statistics:SetActiveE(0)
        local leftGotable = GetAutoGoTable(item.obj_my)
        local rightGotable = GetAutoGoTable(item.obj_enemy)
        self:RefreshRoleNode2(leftGotable,data.leftPower,newindex,data.attacker_team)
        self:RefreshRoleNode2(rightGotable,data.rightPower,newindex,data.defender_team)
    end
end

---@param node _obj_item._obj_my_GoTable
function ActivityTourReportView:RefreshRoleNode(node,data,newindex,team)
    node.aortext_array.text = _G.GetLangPackValue(90021800275,newindex)
    node.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(data.power)
    for i = 1, #team.fights do
        self:SetCardShow(node.cardList, newindex, team.fights and team.fights[i] or nil, node.obj_CardContent)
    end
    if node.addClick == nil then
        --node.aorbtn_statistics.onClick:AddListener(_G.handlerbind(self, self.OnClickStatistics,self.cardDatas[newindex], self.data.reports[newindex].winner))
        node.aorbtn_statistics.onClick:AddListener(_G.handlerbind(self, self.BattlePlayBack,self.cardDatas[newindex], self.data.reports[newindex].winner))
        node.addClick = true
    end
end

