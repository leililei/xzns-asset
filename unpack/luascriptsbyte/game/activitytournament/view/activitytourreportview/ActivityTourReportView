    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            _G.BattleManager:GetInstance():ParseStatistics(),
            isWin and {0} or {1},
            function()
                --self.onBtnClick = false
                --self:StartTimer()
            end,
            nil,
            nil,
            1,
            true,
            data,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            { leftName, rightName } --reportParams
    )
end

function ActivityTourReportView:onClick(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

