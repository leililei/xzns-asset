local ActivityTournamentModel = require("ActivityTournamentModel")
local ActivityTourGuessRecordItem = require("ActivityTourGuessRecordItem")

---@class ActivityTourGuessRecordView : UIBaseView 窗口
---@field private go_table ActivityTourGuessRecordView_GoTable GoTable
local ActivityTourGuessRecordView = BaseClass("ActivityTourGuessRecordView",UIBaseView)

function ActivityTourGuessRecordView:__init()

end

function ActivityTourGuessRecordView:OnCreate(msg)
    self:InitData(msg)
    self:GetData()
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
    if self.openBack then
        self.openBack()
    end
end

---@class ActivityTourGuessRecordView.showData
---@field index number 轮次
---@field left role.i_role
---@field right role.i_role
---@field isLeft boolean 是否竞猜左边
---@field round number 轮次
---@field isLeftWin boolean 左边是否胜利
---@field numberBets number 本轮奖励货币数量
---@field score number[] 比分 1:left [2]:right
---@field left_num number 左边的押注数量
---@field right_num number 左边的押注数量
---@field isBattleEnd boolean 战斗是否结束


function ActivityTourGuessRecordView:GetData()
    --self.model:GetGuessData(function()
    --
    --end)
    self.data = self.model.GuessData.guess_role
    ---@type ActivityTourGuessRecordItem[]
    self.itemList = {}
    self.guess_pub = self.model.GuessData.guess_pub

    ---@type activity_tournament.activity_tournament_guess_info[]
    self.roleDict = {}
    ---@type ActivityTourGuessRecordView.showData[]
    self.showData = {}
    ---@type table<number,table<number,activity_tournament.activity_tournament_guess_info>>
    self.roleDicts = {}

    self.totalRevenue = 0

    for i = 1, #self.model.GuessData.guess_pub do
        local data = self.model.GuessData.guess_pub[i]
        self.roleDict[data.index] = data.info
        if self.roleDicts[data.index] == nil then
            self.roleDicts[data.index] = {}
        end
        if data.info.right then
            self.roleDicts[data.index][data.info.right.uid] = data.info
        end
        if data.info.left then
            self.roleDicts[data.index][data.info.left.uid] = data.info
        end
    end
    if self.data then
        for i = 1, #self.data do
            local data = self.data[i]
            for j = 1, #data.info do
                local uid = data.info[j].target
                local roleData = self.roleDict[data.index]
                if roleData and ((roleData.left and roleData.left.uid == uid) or (roleData.right and roleData.right.uid == uid)) and data.round == 1 then
                    local left = roleData.left
                    local right = roleData.right
                    local numberBetsl = 0
                    if roleData.result ~= 0 then
                        if (roleData.result == 1 and left and uid == left.uid) or (roleData.result == 2 and right and  uid == right.uid) then
                            numberBetsl = data.info[j].num * self.oddsDict[1][i].data.key/10000
                        else
                            numberBetsl = data.info[j].num * self.oddsDict[1][i].data.value/10000
                        end
                        numberBetsl = numberBetsl - data.info[j].num
                    end
                    self.totalRevenue = self.totalRevenue + numberBetsl
                    if left or right then
                        local isLeft = false
                        if left and left.uid == uid then
                            isLeft = true
                        end
                        table.insert(self.showData,{
                            index = data.index,
                            left = left,
                            right = right,
                            isLeft = isLeft,
                            round = 1,
                            left_num = roleData.left_num,
                            right_num = roleData.right_num,
                            isLeftWin = roleData.result == 1,
                            isBattleEnd = roleData.result ~= 0,
                            numberBets = numberBetsl,
                            score = {
                                [1] = roleData.compare.key,
                                [2] = roleData.compare.value,
                            }
                        })
                    end
                end
            end
        end
    end

    self.roleDict = {}
    if self.model.round == 2 then
        self.roleDict[1] = {}
        self.roleDict[2] = {}
        self.roleDict[3] = {}
        local groupIndex1 = 1
        local groupIndex2 = 1
        local groupIndex3 = 1
        for i = 1, #self.roleList do
            if i % 2 == 0 then
                local left = self.roleList[i - 1].role_info
                local right = self.roleList[i].role_info
                if i <= 8 then
                    self.roleDict[1][groupIndex1] = {
                        left = left,
                        right = right,
                        TeamIndex = i,
                    }
                    groupIndex1 = groupIndex1  + 1
                elseif i <= 12 then
                    self.roleDict[2][groupIndex2] = {
                        left = left,
                        right = right,
                        TeamIndex = i,
                    }
                    groupIndex2 = groupIndex2  + 1
                elseif i <= 14 then
                    self.roleDict[3][groupIndex3] = {
                        left = left,
                        right = right,
                        TeamIndex = i,
                    }
                    groupIndex3 = groupIndex3  + 1
                end
            end
        end
    end

    self.isState5 = self.model.stage == 5 and true or false
    if self.data then
        if self.model.round == 2 then
            local count = #self.data
            for i = 1, count do
                local data = self.data[i]
                if self.roleDict[data.index] and data.info and data.info[1] and data.round == 2 then
                    for j = 1, #self.roleDict[data.index] do
                        local left = self.roleDict[data.index][j].left
                        local right = self.roleDict[data.index][j].right
                        local guessRole = data.info[1].target
                        local otherData = self.roleDicts[data.index][left.uid]
                        if otherData == nil then
                            otherData = self.roleDicts[data.index][right.uid]
                        end
                        if (left and left.uid == guessRole) or (right and right.uid == guessRole) then
                            local numberBetsl = 0
                            if otherData.result ~= 0 then
                                if (otherData.result == 1 and left and guessRole == left.uid) or (otherData.result == 2 and right and guessRole == right.uid) then
                                    numberBetsl = data.info[1].num * (self.oddsDict[1][i].data.key/10000)
                                else
                                    numberBetsl = data.info[1].num * (self.oddsDict[1][i].data.value/10000)
                                end
                                numberBetsl = numberBetsl - data.info[1].num
                            end
                            self.totalRevenue = self.totalRevenue + numberBetsl
                            local isleft = false
                            if left and guessRole == left.uid then
                                isleft = true
                            end
                            table.insert(self.showData,{
                                index = data.index,
                                left = left,
                                right = right,
                                isLeft = isleft,
                                round = 2,
                                left_num = otherData.left_num,
                                right_num = otherData.right_num,
                                isLeftWin = otherData.result == 1,
                                isBattleEnd = otherData.result ~= 0,
                                numberBets = numberBetsl,
                                score = {
                                    [1] = otherData.compare.key,
                                    [2] = otherData.compare.value,
                                }
                            })
                        end
                    end
                end
            end
        end
    end
    self.coin = self.totalRevenue
end

function ActivityTourGuessRecordView:InitData(msg)
    self.curSelectGroup = msg.selectGroup
    self.roleList = msg.roleList
    self.openBack = msg.openBack
    ---@type table<number,table<number,activity_tournament.guess_ratio>>
    self.oddsDict = msg.oddsDict
    self.model =  ActivityTournamentModel:GetInstance()
    self.coin = self.model:GetCoinNum(191)
    self.coinData = StorageManager:GetInstance():GetStorageItemData(191)
end

function ActivityTourGuessRecordView:RefreshData()

end

function ActivityTourGuessRecordView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject,handler(self,self.onClick))
    self.go_table.scrollloopvectical_Group:InitItemData(0, _G.handler(self, self.RefreshItem))

    ---@type ActivityTourGuessRecordView._obj_currency_GoTable
    self.Obj_currency = GetAutoGoTable(self.go_table.obj_currency)
end

function ActivityTourGuessRecordView:RefreshItem(index,obj)
    local newIndex = index + 1
    local cfg = self.showData[newIndex]
    --local cfg = self.guess_pub[newIndex]
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if item == nil then
        item = ActivityTourGuessRecordItem.New(obj)
    end
    item:RefreshItem(cfg,cfg.round,self.roleDict)
end

function ActivityTourGuessRecordView:RefreshUI()
    self.go_table.scrollloopvectical_Group:UpdateCount(#self.showData)
    --self.coin = self.model:GetCoinNum(191)
    self.Obj_currency.aortext_num.text = self.coin
    self.Obj_currency.aorrawimage_icon:LoadImage(self.coinData.Icon)
end

function ActivityTourGuessRecordView:onClick(go)
    if go == self.go_table.aorbtn_close2 or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

---@return ActivityTourGuessRecordView
return ActivityTourGuessRecordView