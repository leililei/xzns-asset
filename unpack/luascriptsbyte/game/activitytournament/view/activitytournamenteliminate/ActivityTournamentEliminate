---界面的入口函数
function ActivityTournamentEliminate:OnCreate(toggle)
    self.toggle = toggle
    self.itemList = {}
    for i = 1, 6 do
        self.itemList[i] = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
    end
    self.timeKey = { _G.ConfigManager.discrete_cfg[138008][1][1] }
    for i, v in ipairs(_G.ConfigManager.discrete_cfg[138008]) do
        _G.table.insert(self.timeKey, v[2])
    end
    self:UpdateTimer()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer:Start()
    end
    --LogError(ActivityTournamentModel:GetInstance():CheckPreparePopView())
    if ActivityTournamentModel:GetInstance():CheckPreparePopView() == true then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentPreparePopView.Name, self.toggle)
    end
end

function ActivityTournamentEliminate:UpdateTimer()
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    local index = 0
    local endTime = 0
    for i, v in ipairs(self.timeKey) do
        if curTime <= v then
            index = i - 1
            endTime = v + 1
            break
        end
    end
    if index == 0 then
        self.go_table.aortext_time.text = ""
        return
    else
        local time = endTime - curTime
        self.go_table.aortext_time.text = _G.GetLangPackValue(timeDes[index], _G.TimeUtil.TranslateSecondForStr(time))
    end
end

