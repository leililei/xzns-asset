local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentChampionAwardView : UIBaseView    中文描述
---@field public go_table ActivityTournamentChampionAwardView_GoTable GoTable
local ActivityTournamentChampionAwardView = _G.BaseClass("ActivityTournamentChampionAwardView", _G.UIBaseView)

---构造函数
---@protected
function ActivityTournamentChampionAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityTournamentChampionAwardView:OnCreate()
    self.data = {}
    self.choose = {}
    self.type = 1
    self.num = {}
    self.typeNumMax = {}
    self.cfgQ = _G.ConfigManager.discrete_cfg[138015][1]
    local num = 0
    for k, v in ipairs(_G.ConfigManager.discrete_cfg[138010][1]) do
        self.num[k] = v
        for i = 1, v do
            num = num + 1
            self.typeNumMax[num] = { k = k, v = i }
        end
    end
    self:InitView()
    self:RefreshTagView()
    self:RefreshPage()
end

---
---@protected
function ActivityTournamentChampionAwardView:InitView()
    local award = ActivityTournamentModel:GetInstance():GetCfg().champion_award
    for i, v in ipairs(award) do
        if self.data[v.type] == nil then
            self.data[v.type] = {}
        end
        _G.table.insert(self.data[v.type], v.base_award.award)
    end
end

function ActivityTournamentChampionAwardView:RefreshTagView()
    if self.initTag == nil then
        self.go_table.scrollloophorizontal_tagList:InitItemData(#self.typeNumMax, _G.handler(self, self.RefreshTagItem))
        self.initTag = true
    else
        self.go_table.scrollloophorizontal_tagList:UpdateAllItem()
    end
end

function ActivityTournamentChampionAwardView:RefreshPage()
    if self.init == nil then
        self.go_table.scrollloopvectical_item:InitItemData(#self.data[self.type], _G.handler(self, self.RefreshItemList))
        self.init = true
    else
        self.go_table.scrollloopvectical_item:UpdateCount(#self.data[self.type])
    end
    self.go_table.aortext_des.text = _G.GetLangPackValue(90049900047, self.num[self.type])
end

function ActivityTournamentChampionAwardView:RefreshTagItem(index, obj)
    local x = index + 1
    local data = self.typeNumMax[x]
    local tb
    tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTagItem, x))
    tb.obj_root:RemoveAllChildren()
    local item = self.choose[data.k] and self.choose[data.k][data.v] or nil
    tb.obj_root:SetActiveE(item ~= nil and 1 or 0)
    tb.obj_nil:SetActiveE(item ~= nil and 0 or 1)
    tb.aorimage_ColorBG.SpriteName = _G.ItemBaseIconName[self.cfgQ[data.k]]
    if item ~= nil then
        local v = self.data[data.k][item]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { v.type[1], v.type[2] },
            tb.obj_root,
            function(tran)
                if self.go_table == nil then
                    _G.DestroyObject(tran)
                end
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        )
    end
end

---物品点击事件
function ActivityTournamentChampionAwardView:OnClickTagItem(go, isOn, index)
    self.type = self.typeNumMax[index].k
    self:RefreshPage()
end

function ActivityTournamentChampionAwardView:RefreshItemList(index, obj)
    local x = index + 1
    local data = self.data[self.type][x]
    local tb
    tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb, x))
    tb.obj_item:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { data.type[1], data.type[2] },
        tb.obj_item,
        function(tran)
            if self.go_table == nil then
                _G.DestroyObject(tran)
            end
            local ischoose = self.choose[self.type] ~= nil and _G.table.ContainsValue(self.choose[self.type], x)
            tran:SetGou(ischoose)
            tran.gameObject:SetLocalScaleXYZ(1)
            tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
        end
    )
end

---物品点击事件
function ActivityTournamentChampionAwardView:OnClickItem(go, isOn, tb, index)
    local isChange = false
    if self.choose[self.type] ~= nil and _G.table.ContainsValue(self.choose[self.type], index) then
        _G.table.removebyvalue(self.choose[self.type], index)
        isChange = true
    elseif self.choose[self.type] == nil or (self.choose[self.type] ~= nil and _G.table.count(self.choose[self.type]) < self.num[self.type]) then
        if self.choose[self.type] == nil then
            self.choose[self.type] = {}
        end
        _G.table.insert(self.choose[self.type], index)
        isChange = true
    else
        --超过数量了
    end
    if isChange == true then
        self.go_table.scrollloopvectical_item:UpdateAllItem()
        self:RefreshTagView()
    end
end

---界面的销毁函数
function ActivityTournamentChampionAwardView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityTournamentChampionAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_sure then
        local data = {}
        for k, v in pairs(self.choose) do
            for k2, v2 in ipairs(v) do
                local value = {}
                value.key = k
                value.value = self.data[k][v2].type[1]
                _G.table.insert(data, value)
            end
        end
        if #data < #self.typeNumMax then
            --飘字
            _G.PopWindowManager:GetInstance():ShowAllTips(1080601)
        else
            ActivityTournamentModel:GetInstance():ChooseChampionAward(data, function()
                self:Close()
            end)
        end
    elseif go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return ActivityTournamentChampionAwardView