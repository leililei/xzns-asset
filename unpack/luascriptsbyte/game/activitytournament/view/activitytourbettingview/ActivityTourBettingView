local ActivityTournamentModel = require("ActivityTournamentModel")
local RankUtils = require("RankUtils")

---@class ActivityTourBettingView : UIBaseView 窗口
---@field private go_table ActivityTourBettingView_GoTable GoTable
local ActivityTourBettingView = BaseClass("ActivityTourBettingView", UIBaseView)

function ActivityTourBettingView:__init()

end

function ActivityTourBettingView:OnCreate(msg)
    self:InitData(msg)
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

function ActivityTourBettingView:InitData(msg)
    ---@type role.i_role
    self.curSelectRole = msg.openRoleData
    self.model = ActivityTournamentModel:GetInstance()
    local GuessData = self.model.GuessData
    if GuessData.guess_role and GuessData.guess_role[msg.selectGroup] then
        for i = 1, #GuessData.guess_role do
            local dta = GuessData.guess_role[i]
            if dta.round == self.model.round and dta.index == self.model.roundIndex and dta.guess_count == msg.openRoleData then
                self.data = GuessData.guess_role[msg.selectGroup]
            end
        end
    end
    self.curSelectGroup = msg.selectGroup
    self.Odds = msg.Odds
    self.failureOdds = msg.failureOdds --失败比例
    self.callback = msg.callback
    self.coin = self.model:GetCoinNum(191)
    --self.coinData = StorageManager:GetInstance():GetStorageItemData( self.coin.key)
    self.coinData = StorageManager:GetInstance():GetStorageItemData(191)

    --单次最小加注
    self.UnitMin = self.model.cfg.limit.value
    --最大加注
    self.UpperLimit = self.model.cfg.limit.key
end

function ActivityTourBettingView:RefreshData()
    self.curNumberBets = 0
    self.curSelectNum = 0
    if self:GetIsHasRole(self.curSelectRole.uid) then
        self.curNumberBets = self.data.info[1].num
    end
    self.CurPlayGoldNum = self.coin
    self.curMaxNumber = self.UpperLimit - self.curNumberBets
    if self.curMaxNumber > self.CurPlayGoldNum then
        self.curMaxNumber = self.CurPlayGoldNum
    end
    self.isPlaceBet = self.curNumberBets == 0 and true or false
end

function ActivityTourBettingView:InitUI()
    self.go_table = _G.GetAutoGoTable(self.gameObject, handler(self, self.onClick))
    self.go_table.slider_bgMusic.onValueChanged:AddListener(_G.handler(self, self.SliderLvChange))
    --_G.SetEventTrigger(self.go_table.slider_bgMusic,"onUp",_G.handler(self,self.SliderDragEnd))
    self.go_table.aorrawimage_moneyIcon1:LoadImage(self.coinData.Icon)
    self.go_table.aorrawimage_moneyIcon2:LoadImage(self.coinData.Icon)
    self.go_table.aorrawimage_moneyIcon3:LoadImage(self.coinData.Icon)
    if self.isPlaceBet then
        self.go_table.aortext_Name1.text = GetLangPackValue(90049900097)
    else
        self.go_table.aortext_Name1.text = GetLangPackValue(90049900098)
    end
end

function ActivityTourBettingView:OnDestroy()
    --self.go_table.slider_bgMusic.onValueChanged:Re(_G.handler(self,self.SliderLvChange))
end

function ActivityTourBettingView:SliderLvChange(value)
    self.curSelectNum = math.ceil(value )
    local curTotalBet = self.curSelectNum
    self.go_table.aortext_money1.text = self.curMaxNumber - curTotalBet
    self.go_table.aortext_money2.text = curTotalBet * self.Odds
    self:SetAortext_money3(self.curSelectNum)
end

function ActivityTourBettingView:SetAortext_money3(num)
    if num > self.CurPlayGoldNum then
        self.go_table.aortext_money3.text = tostring(num):AddColor("E53737")
    else
        self.go_table.aortext_money3.text = num
    end
end

function ActivityTourBettingView:RefreshUI()
    local roleData = RankUtils.i_record_rankToi_role(self.curSelectRole)
    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase,
        self.curSelectRole
    , 1, true, true, true)
    self.go_table.aortext_name.text = roleData.name
    self.go_table.aortext_server.text = _G.ServerManager:GetInstance():GetServerNameByServerID(roleData.server_id)
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.curSelectRole.power)
    self.go_table.slider_bgMusic.maxValue = self.curMaxNumber
    if self.curMaxNumber == 0 and self.curSelectNum == 0 then
        self.go_table.slider_bgMusic.value = 0
    else
        self.go_table.slider_bgMusic.value = self.curSelectNum
    end
    local curTotalBet = self.curSelectNum
    self.go_table.aortext_money1.text = self.curMaxNumber - curTotalBet
    self.go_table.aortext_money2.text = curTotalBet * self.Odds
    if self.failureOdds == 0 then
        self.go_table.aortext_money4:SetActiveE(0)
    else
        self.go_table.aortext_money4:SetActiveE(1)
        self.go_table.aortext_money4.text = GetLangPackValue(90049900141,curTotalBet * self.failureOdds)
    end
    self:SetAortext_money3(self.curSelectNum)
end

function ActivityTourBettingView:GetIsHasRole(uid)
    if self.data and self.data.info then
        for i = 1, #self.data.info do
            if self.data.info[i].target == uid and self.data.round == self.model.round and self.data.roundIndex == self.model.roundIndex then
                return true
            end
        end
    end
    return false
end

function ActivityTourBettingView:onClick(go)
    if go == self.go_table.aorbtn_back or go == self.go_table.aorbtn_backx or go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        local curTotalBet = self.curSelectNum -- + self.curNumberBets
        if curTotalBet > self.CurPlayGoldNum then
            _G.PopWindowManager:GetInstance():ShowAllTips(1080605)
        end
        if curTotalBet == 0 then
            --_G.PopWindowManager:GetInstance():ShowAllTips(1080606,GetLangPackValue(90023030301))
            return
        end
        if self.curSelectNum < self.UnitMin then
            --最小加注
            _G.PopWindowManager:GetInstance():ShowAllTips(1080612)
            return
        end
        if self.curSelectNum > self.UpperLimit then
            --_G.PopWindowManager:GetInstance():ShowAllTips(1080612)
            return
        end
        self.model:TakeGuess(self.curSelectRole.uid, curTotalBet, function()
            if self:GetIsHasRole(self.curSelectRole.uid) then
                self.data.info[1] = {
                    target = self.curSelectRole.uid,
                    num = curTotalBet + self.curNumberBets
                }
                self.data.guess_count = self.data.guess_count + 1
                --self:RefreshData()
                --self:RefreshUI()
            else
                ---@type activity_tournament.activity_tournament_guess_role
                local data = {
                    round = self.model.round,
                    index = self.model.roundIndex,
                    guess_count = 0,
                    state = 0,
                    info = {
                        [1] = {
                            target = self.curSelectRole.uid,
                            num = curTotalBet,
                        }
                    }
                }
                if self.model.GuessData.guess_role == nil then
                    self.model.GuessData.guess_role = {}
                    self.model.GuessData.guess_role[1] = data
                else
                    table.insert(self.model.GuessData.guess_role, data)
                end
            end
            _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { 191, -curTotalBet })
            _G.Events:GetInstance():Broadcast(_G.eActivityTournament.GuessChange)
            _G.PopWindowManager:GetInstance():ShowAllTips(1080613)
            local redPointId = self.model.curActivityClass.typeClass:GetRedpointIDByIndex(8)
            require("RedPointManager"):GetInstance():RefreshNode(redPointId)
            if self.callback then
                self.callback()
            end
            self:Close()
        end)
    elseif go == self.go_table.aorbtn_propSub then
        if self.curSelectNum > 1 then
            self.curSelectNum = self.curSelectNum - 1
        end
        self:RefreshUI()
    elseif go == self.go_table.aorbtn_propAdd then
        if self.curSelectNum < self.curMaxNumber then
            self.curSelectNum = self.curSelectNum + 1
        end
        self:RefreshUI()
    elseif go == self.go_table.aorbtn_propMax then
        --self.curSelectNum = self.curMaxNumber
        self.curSelectNum = self.CurPlayGoldNum
        if self.curSelectNum > self.UpperLimit then
            self.curSelectNum = self.UpperLimit
        end
        if self.curSelectNum < 0 then
            self.curSelectNum = 0
        elseif self.curSelectNum > self.CurPlayGoldNum then
            self.curSelectNum = self.CurPlayGoldNum
        end
        self:RefreshUI()
    end
end

---@return ActivityTourBettingView
return ActivityTourBettingView