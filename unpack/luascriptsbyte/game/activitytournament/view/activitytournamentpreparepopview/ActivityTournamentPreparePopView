local RankUtils = require("RankUtils")
local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentPreparePopView : UIBaseView    中文描述
---@field public go_table ActivityTournamentPreparePopView_GoTable GoTable
local ActivityTournamentPreparePopView = _G.BaseClass("ActivityTournamentPreparePopView", _G.UIBaseView)

local index = {
    [1] = 64,
    [2] = 32,
    [3] = 16,
    [4] = 8,
    [5] = 4,
    [6] = 2,
}

local title = {
    [1] = 90049900016,
    [2] = 90049900015,
    [3] = 90049900014,
    [4] = 90049900013,
    [5] = 90049900012,
    [6] = 90049900011,
}

---构造函数
---@protected
function ActivityTournamentPreparePopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityTournamentPreparePopView:OnCreate(toggle)
    self.toggle = toggle
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    self.round = ActivityTournamentModel:GetInstance():GetRound()
    self.roundIndex = ActivityTournamentModel:GetInstance():GetRoundIndex()
    self.index = self.round == 1 and self.roundIndex or (self.roundIndex + 3)
    LogError(self.index)

    self.model = require("RecordRankModel"):GetInstance()
    self.model:GetListInfo(RankUtils.RankType.CrossServiceCompAlliance, function()
        self.rankData = self.model:GetRankData(RankUtils.RankType.CrossServiceCompAlliance)
        self.rankList = {}
        local pos = index[self.index]
        local selfIndex
        self.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for i, v in ipairs(self.rankData.listRankDatas) do
            if v.value <= pos then
                if v.role_info.uid == self.uid then
                    selfIndex = v
                else
                    _G.table.insert(self.rankList, v)
                end
            end
        end
        if selfIndex ~= nil then
            _G.table.insert(self.rankList, 1, selfIndex)
        end
        self:InitView()
        self.go_table.aortext_des.text = _G.GetLangPackValue(90049900136, _G.GetLangPackValue(title[self.index]))
    end)
    self.go_table.toggle_eject.isOn = ActivityTournamentModel:GetInstance():CheckPreparePopView() == false
end

---
---@protected
function ActivityTournamentPreparePopView:InitView()
    self.go_table.scrollloopvectical_rankList:InitItemData(#self.rankList, _G.handler(self, self.RefreshItem))
end

function ActivityTournamentPreparePopView:RefreshItem(index, obj)
    local newIndex = index + 1

    local data = self.rankList[newIndex].role_info
    local tb = _G.GetAutoGoTable(obj)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_head, data, 1, true, true, true)
    tb.aortext_name.text = data.name
    local severname = _G.ServerManager:GetInstance():GetServerNameByServerID(data.server_id)
    if severname then
        tb.aortext_server:SetActiveE(1)
        tb.aortext_server.text = "[" .. severname .. "]"
    else
        tb.aortext_server:SetActiveE(0)
    end
    tb.obj_Promotion:SetActiveE(data.uid == self.uid and 1 or 0)
end

---界面的销毁函数
function ActivityTournamentPreparePopView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityTournamentPreparePopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_skip then
        self.toggle.isOn = true
        self:Close()
    end
    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("ActivityTournamentPreparePopView" .. self.activityID,
            _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return ActivityTournamentPreparePopView