---@protected
function ActivityTournamentChampionView:SetAwardView()
    self.go_table.obj_award:SetActiveE((self.curToggle == self.season and self.stage == 5) and 1 or 0)
    if self.curToggle == self.season and self.stage == 5 then
        self.worship_award = ActivityTournamentModel:GetInstance():GetWorshipAward()
        if self.worship_award == nil then
            local isTop = self.playerList[1].uid == _G.PlayerModel:GetInstance():GetPlayerUid()
            self.go_table.aorbtn_choose:SetActiveE(isTop == true and 1 or 0)
            self.go_table.aortext_time:SetActiveE(isTop == true and 0 or 1)
            if isTop == false then
                self:UpdateTimer()
                if not self.timer then
                    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
                    self.timer:Start()
                end
            end
        else
            self.worship_award_state = ActivityTournamentModel:GetInstance():GetWorshipAwardState()
            --self.go_table.scrollloopvectical_logList:SetActiveE(self.worship_award_state == 1 and 1 or 0)
            self.go_table.aorbtn_get:SetActiveE(self.worship_award_state == 1 and 0 or 1)
            self.go_table.aorbtn_choose:SetActiveE(0)
            --if self.worship_award_state == 1 then
            --    if self.logList == nil then
            --        ActivityTournamentModel:GetInstance():GetChampionAwardLog(function(msg)
            --            self.logList = msg.logs or {}
            --            self.go_table.scrollloopvectical_logList:InitItemData(#self.logList, _G.handler(self, self.RefreshLogItem))
            --        end)
            --    end
            --end
        end
    end
end

function ActivityTournamentChampionView:RefreshLogItem(index, objGame)
    if index < 0 then
        return
    end
    local id = objGame:GetInstanceID()
    objGame:SetName(id)
    local goTable = _G.GetAutoGoTable(objGame)
    local data = self.logList[index + 1]
    if data.role_info.uid == data.champion.uid then
        goTable.aortext_log.text = _G.GetLangPackValue(90049900074, data.role_info.name, _G.StorageManager:GetInstance():GetItemName(data.award.item[1].type[1]) .. "x" .. data.award.item[1].type[2])
    else
        local quality = _G.StorageManager:GetInstance():GetItemQuality(data.award.item[1].type[1])
        local index = 3
        if quality >= self.qualityLog[1] then
            index = 1
        elseif quality >= self.qualityLog[2] then
            index = 2
        end
        local str = qualityLogStr[index]
        goTable.aortext_log.text = _G.GetLangPackValue(str, data.role_info.name, data.champion.name, _G.StorageManager:GetInstance():GetItemName(data.award.item[1].type[1]) .. "x" .. data.award.item[1].type[2])
    end
end

function ActivityTournamentChampionView:UpdateTimer()
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    local time = self.timeKey - curTime
    self.go_table.aortext_time.text = _G.GetLangPackValue(90049900041, _G.TimeUtil.TranslateSecondForStr(time))
    if time <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        ActivityTournamentModel:GetInstance():WorshipChange()
    end
end

---tips
function ActivityTournamentChampionView:SetTipsView(isShow)
    self.go_table.obj_TipView:SetActiveE(isShow and 1 or 0)
    if self.TipView == nil then
        self.TipView = _G.GetAutoGoTable(self.go_table.obj_TipView, _G.handlerbind(self, function()
            self.go_table.obj_TipView:SetActiveE(0)
        end))
        self.boxAwardPool = ActivityTournamentModel:GetInstance():GetWorshipAward()
        self.TipView.scrollloopvectical_item:InitItemData(#self.boxAwardPool, _G.handler(self, self.RefreshList))
    end
end

function ActivityTournamentChampionView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        self.boxAwardPool[index].type,
        tb.obj_item,
        function(item)
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end)
end

---按钮点击事件在这里派发
function ActivityTournamentChampionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_choose then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentChampionAwardView.Name)
    elseif go == self.go_table.aorbtn_get then
        ActivityTournamentModel:GetInstance():GetChampionAward(function()
            self:SetAwardView()
        end)
    elseif go == self.go_table.aorbtn_boxAward then
        --奖励预览
        self:SetTipsView(true)
    elseif go == self.go_table.aorbtn_dropdown then
        ---下拉列表
        self.unfold = not self.unfold
        self:RefreshDropDown()
    end
end

---界面的销毁函数
function ActivityTournamentChampionView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timer2 then
        self.timer2:Stop()
        self.timer2 = nil
    end
end

return ActivityTournamentChampionView