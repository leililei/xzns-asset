local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentChampionView : UIBaseView    中文描述
---@field public go_table ActivityTournamentChampionView_GoTable GoTable
local ActivityTournamentChampionView = _G.BaseClass("ActivityTournamentChampionView", _G.UIBaseView)

local qualityLogStr = {
    [1] = 90049900043,
    [2] = 90049900044,
    [3] = 90049900045,
}

local scale = {
    [1] = 1,
    [2] = 0.9,
    [3] = 0.9,
    [4] = 0.78,
    [5] = 0.78,
    [6] = 0.78,
    [7] = 0.78,
}

---构造函数
---@protected
function ActivityTournamentChampionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityTournament.WorshipStageChange, self.SetAwardView)
    self:AddListener(_G.eActivityTournament.StageChange, self.InitView)
end

---界面的入口函数
function ActivityTournamentChampionView:OnCreate()
    self.curToggle = 1
    self.season = ActivityTournamentModel:GetInstance():GetSeason()
    self.timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]][2]
    self.qualityLog = _G.ConfigManager.discrete_cfg[138014][1]
    self.playerNames = {}
    self:RefreshDropDown()
    self:InitView()
end
---
---@protected
function ActivityTournamentChampionView:InitView()
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()
    self:OpenView()
    if self.stage == 5 then
        self:UpdateTimer2()
        if not self.timer2 then
            self.timer2 = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer2, self, false, false, true)
            self.timer2:Start()
        end
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_mawduel_enter,
        self.go_table.obj_effNode,
        function(obj)
            if self:IsNil() then
                DestroyObject(obj)
                return
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_mawduel_permanent,
        self.go_table.obj_shadow,
        function(obj)
            if self:IsNil() then
                DestroyObject(obj)
                return
            end

        end
    )
    self.go_table.obj_time:SetActiveE(self.stage == 5 and 1 or 0)
end

function ActivityTournamentChampionView:UpdateTimer2()
    local time = self.stageEndTime - _G.TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time2.text = _G.GetLangPackValue(90049900096, _G.TimeUtil.TranslateSecondForStr(time))
    if time <= 0 then
        self.timer2:Stop()
        self.timer2 = nil
        return
    end
end

---刷新下拉列表
function ActivityTournamentChampionView:RefreshDropDown()
    self.go_table.aorbtn_dropdown:SetActiveE(self.season > 1 and 1 or 0)
    if self.season == 1 then
        return
    end

    self.go_table.aorbtn_down:SetActiveE(not self.unfold and 1 or 0)
    self.go_table.aorbtn_up:SetActiveE(self.unfold and 1 or 0)
    self.go_table.obj_options:SetActiveE(self.unfold and 1 or 0)
    self.go_table.aortext_dropdown.text = _G.GetLangPackValue(90049900036, self.curToggle)
    local num = self.stage == 5 and self.season or self.season - 1
    if self.unfold then
        if not self.optionListView then
            self.go_table.scrollloopvectical_optation:InitItemData(
                num,
                _G.handler(self, self.RefreshOptionItem)
            )
            self.optionListView = self.go_table.scrollloopvectical_optation
        else
            self.optionListView:UpdateCount(num)
        end
    end
end

function ActivityTournamentChampionView:RefreshOptionItem(index, obj)
    local eIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOption, eIndex))
    local str = _G.GetLangPackValue(90049900036, _G.GameUtil.NumberToChinese(eIndex))
    tb.aortext_label.text = str
    if self.curToggle == eIndex then
        tb.aortext_label.text = "<color=#96ce51>" .. str .. "</color>"
    else
        tb.aortext_label.text = "<color=#e6e0dc>" .. str .. "</color>"
    end
    --tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.Technologyupgrade.id, eIndex)
end

function ActivityTournamentChampionView:OnClickOption(_, _, eIndex)
    if self.curToggle ~= eIndex then
        self.curToggle = eIndex
        self.unfold = not self.unfold
        self:RefreshDropDown()
        self:OpenView()
    end
end

function ActivityTournamentChampionView:OpenView()
    ActivityTournamentModel:GetInstance():GetHistoryDetails(self.curToggle, function(data)
        if self.curToggle == self.season and self.stage ~= 5 then
            self.playerList = {}
        else
            self.playerList = data
        end
        self:SetTopPlayerView()
        self:SetPlayerListView()
        self:SetAwardView()
        if self.stage == 5 and self.init == nil and ActivityTournamentModel:GetInstance():CheckChampionPopView() == true then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentChampionPopView.Name, self.playerList[1])
            self.init = true
        end
    end)
end

function ActivityTournamentChampionView:SetTopPlayerView()
    local player = self.playerList[1]
    if self.topPlayerItem == nil then
        self.topPlayerItem = _G.GetAutoGoTable(self.go_table.obj_info)
        _G.AddViewBtnClick(
            self.topPlayerItem.gameObject,
            _G.handlerbind(self, self.OnLinkClickBtn, player)
        )
    end
    self.topPlayerItem.obj_nil:SetActiveE(player == nil and 1 or 0)
    if player then
        local tempCount = self.topPlayerItem.trans_role:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(self.topPlayerItem.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
        if self.title then
            _G.PoolsManager:GetInstance():Despawn(self.title.gameObject, _G.ePoolType.Temporary)
            self.title = nil
        end
        self.topPlayerItem.aortext_name.text = player.name
        local severname = _G.ServerManager:GetInstance():GetServerNameByServerID(player.server_id)
        if severname then
            self.topPlayerItem.aortext_server:SetActiveE(1)
            self.topPlayerItem.aortext_server.text = "[" .. severname .. "]"
        else
            self.topPlayerItem.aortext_server:SetActiveE(0)
        end
        self:UpdateTop3Title(self.topPlayerItem, player.title)
        local cfg = require "CardCommentManager":GetInstance():CardData(player.city_style_id, false)
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        self:LoadRoleModel(path, cfg.size4, self.topPlayerItem.trans_role)
    else
        self.topPlayerItem.aortext_name.text = _G.GetLangPackValue(90000010159)
        self.topPlayerItem.aortext_server.text = ""
    end
end

function ActivityTournamentChampionView:OnLinkClickBtn(go, _, item)
    if item == nil then
        return
    end
    _G.SystemSettingManager:GetInstance():OpenView(item.uid)
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function ActivityTournamentChampionView:LoadRoleModel(rolepath, scale, trans_role)
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(trans_role)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
        end
    )
end

---生成称号
---@param item table
function ActivityTournamentChampionView:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle == nil or (self.curShowEffTitle ~= nil and self.curShowEffTitle ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                    self.title = trans
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---
---@protected
function ActivityTournamentChampionView:SetPlayerListView()
    for i = 1, 7 do
        local player = self.playerList[i + 1]
        self.go_table["obj_HeadItemBase" .. i]:SetActiveE(player ~= nil and 1 or 0)
        self.go_table["obj_HeadItemBase" .. i]:SetActiveE(player ~= nil and 1 or 0)
        self.go_table["obj_name" .. i]:SetActiveE(player ~= nil and 1 or 0)
        if player ~= nil then
            _G.UIUtils.SetPlayerHeadItemNew(self.go_table["obj_HeadItemBase" .. i], player, scale[i], true, true, true)
            if self.playerNames[i] == nil then
                self.playerNames[i] = _G.GetAutoGoTable(self.go_table["obj_name" .. i])
            end
            self.playerNames[i].aortext_name.text = player.name
            local severname = _G.ServerManager:GetInstance():GetServerNameByServerID(player.server_id)
            if severname then
                self.playerNames[i].aortext_server:SetActiveE(1)
                self.playerNames[i].aortext_server.text = "[" .. severname .. "]"
            else
                self.playerNames[i].aortext_server:SetActiveE(0)
            end
        end
    end
end

