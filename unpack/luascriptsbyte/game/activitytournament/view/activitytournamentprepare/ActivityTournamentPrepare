local ActivityTournamentModel = require("ActivityTournamentModel")
local RankUtils = require("RankUtils")
---@type numebr 顶级玩家展示数量
local TOP_PLAYER_COUNT = 3
---@class ActivityTournamentPrepare : UIBaseView    中文描述
---@field public go_table ActivityTournamentPrepare_GoTable GoTable
local ActivityTournamentPrepare = _G.BaseClass("ActivityTournamentPrepare", _G.Component)

---构造函数
---@protected
function ActivityTournamentPrepare:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eActivityTournament.ScoreChange, self.SetRankView)
end

---界面的入口函数
function ActivityTournamentPrepare:OnCreate()
    self.title = {}
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
end
function ActivityTournamentPrepare:SetTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.refreshTime = _G.ConfigManager.discrete_cfg[138002][1][1]
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    local delayTime = 0

    if ((_G.TimeUtil.GetServerUnixTime() - self.activity.cfg.time.start_time) < 86400) and curTime < self.refreshTime then
        delayTime = self.refreshTime - curTime
        self.go_table.aorbtn_battle:SetGray(true)
    else
        self.go_table.aorbtn_battle:SetGray(false)
    end
    if delayTime > 0 then
        self.timer = _G.TimerManager:GetInstance():GetTimer(delayTime, self.ChangeStage, self, true, false, true)
        self.timer:Start()
    end
end

---阶段转换
function ActivityTournamentPrepare:ChangeStage()
    self:SetTime()
end

---
---@protected
function ActivityTournamentPrepare:UpdateView()
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()
    if self.stage ~= 1 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    end
    self:SetTime()
    self:SetRankView()
end

function ActivityTournamentPrepare:SetRankView()
    require("RankUtils").ClearAllRankData()
    self.model = require("RecordRankModel"):GetInstance()
    self.model:GetListInfo(RankUtils.RankType.CrossServiceCompPerson, function()
        self.rankData = self.model:GetRankData(RankUtils.RankType.CrossServiceCompPerson)
        self.rank = self.rankData:GetMyRank() or 0
        self:InitTopInfos()
        self:SetRank()
    end)
    self:SetScore()
    self:SetFightNum()
end

---
---@protected
function ActivityTournamentPrepare:SetFightNum()
    local numMax = _G.ConfigManager.discrete_cfg[138011][1][1]
    self.go_table.aortext_fightNum:SetActiveE(numMax ~= 0 and 1 or 0)
    if numMax ~= 0 then
        local curNum = ActivityTournamentModel:GetInstance():GetFightNum()
        self.go_table.aortext_fightNum.text = _G.GetLangPackValue(90049900031, (numMax - curNum) .. "/" .. numMax)
        if ((_G.TimeUtil.GetServerUnixTime() - self.activity.cfg.time.start_time) < 86400) and _G.TimeUtil.GetSecondsOfDay() < self.refreshTime then
        else
            self.go_table.aorbtn_battle:SetGray(curNum >= numMax)
        end
    end
end

---初始化前三玩家数据
---@return void
function ActivityTournamentPrepare:InitTopInfos()
    --初始化前三玩家
    self.topPlayerDatas = {}
    for i = 1, TOP_PLAYER_COUNT do
        if self.rankData.listRankDatas[i] then
            table.insert(self.topPlayerDatas, { data = self.rankData.listRankDatas[i] })
        else
            break
        end
    end
    if not self.topPlayerItems then
        self.topPlayerItems = {}
        for i = 1, TOP_PLAYER_COUNT do
            self.topPlayerItems[i] = _G.GetAutoGoTable(self.go_table["obj_info" .. i])
            self.topPlayerItems[i].rank = i
            _G.AddViewBtnClick(
                self.topPlayerItems[i].gameObject,
                _G.handlerbind(self, self.OnLinkClickBtn, self.topPlayerItems[i])
            )
        end
    end

    for i = 1, TOP_PLAYER_COUNT do
        --回收角色模型
        ---@type RecordRankListView._obj_info1_GoTable
        local temp = self.topPlayerItems[i]
        local tempCount = temp.trans_role:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
        if self.title and self.title[i] then
            _G.PoolsManager:GetInstance():Despawn(self.title[i].gameObject, _G.ePoolType.Temporary)
            self.title[i] = nil
        end
    end

    for i = 1, TOP_PLAYER_COUNT do
        local tb = self.topPlayerItems[i]
        local player = self.topPlayerDatas[i] and self.topPlayerDatas[i].data
        if player then
            tb.data = player
            tb.gameObject:SetActiveE(1)
            tb.aortext_name.text = player.role_info.name
            tb.aortext_desc.text = _G.GetLangPackValue(90000010438, player.value)
            self:UpdateTop3Title(tb, player.role_info.title, i)
            local cfg = require "CardCommentManager":GetInstance():CardData(player.role_info.city_style_id, false)
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
            self:LoadRoleModel(path, i, cfg.size4, tb.trans_role)
        else
            tb.data = nil
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
            tb.aortext_desc.text = ""
        end
    end
end

---处理点赞事件
---@param item {rank:number, data:RecordRankData, aorbtn_playerInfo:AorButton, aorbtn_link:AorButton}
function ActivityTournamentPrepare:OnLinkClickBtn(go, _, item)
    if not item.data then
        return
    end

    if go == item.aorbtn_playerInfo and item.data.role_info then
        _G.SystemSettingManager:GetInstance():OpenView(item.data.role_info.uid)
    end
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function ActivityTournamentPrepare:LoadRoleModel(rolepath, posIndex, scale, trans_role)
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self.go_table == nil then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(trans_role)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
            --self.roleTrans[posIndex] = trans
        end
    )
end

---生成称号
---@param item table
function ActivityTournamentPrepare:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                    self.title[index] = trans
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

function ActivityTournamentPrepare:SetScore()
    self.go_table.aortext_score.text = _G.GetLangPackValue(90049900006, _G.GameUtil.NumberToUnitStrFight(ActivityTournamentModel:GetInstance():GetScore()))
end

function ActivityTournamentPrepare:SetRank()
    local str = _G.GetLangPackValue(90049900007, self.rank == 0 and _G.GetLangPackValue(90022900040) or self.rank)
    if self.rank ~= 0 and self.rank <= 64 then
        str = str .. _G.GetLangPackValue(90049900008)
    end
    self.go_table.aortext_rank.text = str
end

---@param arena_layer_enemy_array arena_layer.s2c_arena_layer_enemy_array
---@param arena_layer_match arena_layer.s2c_arena_layer_match
function ActivityTournamentPrepare:OnBattleClick(arena_layer_enemy_array, arena_layer_match)
    local enter, index = ActivityTournamentModel:GetInstance():CheckEnterMatch()
    if enter then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ActivityTournamentMatchView.Name,
            arena_layer_enemy_array,
            arena_layer_match,
            true
        )
    else
        ActivityTournamentModel:GetInstance():OpenEmbattleDefence()
    end
end

---按钮点击事件在这里派发
function ActivityTournamentPrepare:OnClickBtn(go)
    if go == self.go_table.aorbtn_battle then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        self.refreshTime = _G.ConfigManager.discrete_cfg[138002][1][1]
        local curTime = _G.TimeUtil.GetSecondsOfDay()
        if ((_G.TimeUtil.GetServerUnixTime() - self.activity.cfg.time.start_time) < 86400) and curTime < self.refreshTime then
        else
            local numMax = _G.ConfigManager.discrete_cfg[138011][1][1]
            local curNum = ActivityTournamentModel:GetInstance():GetFightNum()
            if numMax == 0 or curNum < numMax then
                ActivityTournamentModel:GetInstance():Match(_G.handler(self, self.OnBattleClick))
            end
        end
    end
end

---界面的销毁函数
function ActivityTournamentPrepare:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return ActivityTournamentPrepare