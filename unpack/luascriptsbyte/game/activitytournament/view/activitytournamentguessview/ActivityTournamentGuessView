function ActivityTournamentGuessView:OnClick_send(num)

    ---@type chat.c2s_chat dsd
    local param = {}
    param.channel = self:GetNowPindao()
    --local rwLater = _G.CS.DenyWordModel.Instance:ReplaceWord(self.go_table.input_input.text)
    --
    -- if _G.AppSetting.DEBUG then
    --     _G.Log(rwLater, "全局消息屏蔽完成后??????????")
    -- end
    param.content = self.go_table.input_input.text
    param.f_uid = 0
    --_G.PlayerModel:GetInstance().role_uid

    param.voice = 0

    ---@type ClintSendChatInfo 本地自己的消息 先显示 忽略服务器广播 防止延迟
    local msg = {}
    msg.channel = param.channel
    msg.n_content = param.content
    msg.f_uid = param.f_uid
    if num ~= nil then
        msg.type = num
        param.type = num
    else
        msg.type = 1
        param.type = 1
    end
    local tipsid
    msg, tipsid = self.ChatManager:GetNewChatInfo(msg)

    if msg == nil then
        return _G.PopWindowManager:GetInstance():ShowAllTips(tipsid)
    end

    local scene
    if param.channel == _G.ChatType.privateChat then
        scene="5"
    else
        scene="4"
    end
    _G.GameUtil.SecCheck(param.content, scene,function()
        require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
    end)
end

---发送消息 网络回调
---@param param chat.s2c_chat PB数据
function ActivityTournamentGuessView:CallSendChat(param, msg)
    if _G.IsNil(param) or _G.IsNil(param.ack) then
        _G.PopWindowManager:GetInstance():ShowAllTips(160105)
        return
    end
    if param.ack == 1 then
        self.ChatManager:SetPinDaoSendTime(self:GetNowPindao())

        self:Start_sendTimer(self.ChatManager:GetPinDaoSendTime(self:GetNowPindao(), true))
        if self.MyChannelRecordStrArr ~= nil then
            self.ChatManager.SaveMyChannelRecordKey(self.MyChannelRecordStrArr)
        end

        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end

        self.model:GetTaskData(function()
            _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {
                        _G.ActiveTaskEnum.ConditionEnum.ActivityTour.CumulativeSpeechDay
                    },
                    1
            )
            local redPointId = self.model.curActivityClass.typeClass:GetRedpointIDByIndex(8)
            require("RedPointManager"):GetInstance():RefreshNode(redPointId)
        end)

        self.ChatManager:P2C_NewChat(msg)
        -- elseif param.ack == "chat_open_fun_condition" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160106)
        -- elseif param.ack == "chat_content_none" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160107)
        -- elseif param.ack == "chat_size_limit" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160108)
        -- elseif param.ack == "chat_channel_error" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160109)
        -- elseif param.ack == "chat_time_err" then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(160110)
        -- else
        --     _G.PopWindowManager:GetInstance():ShowAllTips(1001, param.ack)
    end
    self.MyChannelRecordStrArr = nil
end

---//开始发送间隔倒计时
function ActivityTournamentGuessView:Start_sendTimer(t_Time)
    if self.timersend ~= nil then
        _G.coroutine.stopwaiting(self.timersend)
    end

    if t_Time <= 0 then
        --_G.GameUtil.SetActiveByCondition(self.go_table.aorimage_sendTimebg, false)
        return
    end
    self.SendTime = t_Time

    ----弹提示 发送频繁提示  不再显示倒记时
    -- self.go_table.aortext_sendTime.text = self.SendTime .. "s"
    -- if self.go_table.aorimage_sendTimebg:GetctiveInHierarchy() == 0 then
    --     _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_sendTimebg, true)
    -- end

    self.timersend = _G.coroutine.start(_G.handler(self, self.TimerSend))
end

function ActivityTournamentGuessView:TimerSend()
    _G.coroutine.waitforseconds(0.2)
    while true do
        _G.coroutine.waitforseconds(1)
        if self.SendTime >= 0 then
            self.SendTime = self.SendTime - 1
            -- self.go_table.aortext_sendTime.text = self.SendTime .. "s"
            if self.SendTime == 0 then
                -- _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_sendTimebg, false)
                _G.coroutine.stopwaiting(self.timersend)
                self.timersend = nil
                return
            end
        end
    end
end

