function ActivityTournamentGuessView:RefreshList_phiz(index, objGame)
    if index < 0 then
        return
    end
    ---@type expression_cfg
    local cfg = self.PhizArr[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_phiz, cfg))
    itemGoTable.Phiz_id = cfg.id

    ---设置升级按钮 长按事件
    -- _G.SetEventTrigger(itemGoTable.aorbtn_btn, "onDown", _G.handler(self, self.onDown_Uplv))
    itemGoTable.aorbtn_btn.LongPress = true
    itemGoTable.aorbtn_btn.onLongPress = _G.handlerbind(self, self.onLongPressS_Uplv, cfg.id)
    itemGoTable.addClick = true

    if cfg.gif == 0 then
        itemGoTable.aorrawimage_icon:SetActiveE(1)
        itemGoTable.obj_spine:SetActiveE(0)
        itemGoTable.aorrawimage_icon.Alpha = 0
        itemGoTable.aorrawimage_icon:LoadImage(cfg.img_path)
    elseif cfg.gif == 1 then
        itemGoTable.aorrawimage_icon:SetActiveE(0)
        itemGoTable.obj_spine:SetActiveE(1)
        itemGoTable.obj_spine:ClearChildren()
        _G.UIUtils.LoadEffectByPath(cfg.img_path, itemGoTable.obj_spine)
    end
    local is = self.ChatManager:IsExpressionLike(cfg.id)
    if is and self.Phiz_initID == 1 then
        itemGoTable.aorimage_isOn:SetActiveE(1)
    else
        itemGoTable.aorimage_isOn:SetActiveE(0)
    end
    return objGame
end

