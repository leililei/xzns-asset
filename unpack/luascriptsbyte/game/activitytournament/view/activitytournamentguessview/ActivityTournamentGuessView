function ActivityTournamentGuessView:UpdateTime()
    if self.curStage == ActivityTournamentGuessView.curStage.PlaceBet then
        self.refreshTimer = self.refreshTimer + 1
        if self.refreshTimer > self.uiRefreshTime then
            self.refreshTimer = 0
            self.model:GetGuessData(function()
                self:RefreshData()
                self:RefreshUI()
            end)
        end
    end

    self:UpdateTimer()
end

function ActivityTournamentGuessView:UpdateView()
    self.round = self.model:GetRound()
    self.roundIndex =self.model:GetRoundIndex()
    self.index = self.round == 1 and self.roundIndex or (self.roundIndex + 3)
    self.stage, self.stageEndTime = self.model:GetStateInfo()
    if self.stage == 5 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    end
    self.go_table.aortext_state.text = _G.GetLangPackValue(title[self.index])
end

function ActivityTournamentGuessView:UpdateTimer()
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    local index = 0
    local endTime = 0
    for i, v in ipairs(self.timeKey) do
        if curTime <= v then
            index = i - 1
            endTime = v + 1
            break
        end
    end
    if index == 0 then
        self.go_table.aortext_timer.text = ""
        self.go_table.aorbtn_info:SetActiveE(0)
        return
    else
        local time = endTime - curTime
        self.go_table.aortext_timer.text = _G.GetLangPackValue(timeDes[index], _G.TimeUtil.TranslateSecondForStr(time))
        if index == 1 then
            self.go_table.aorbtn_info:SetActiveE(1)
        else
            self.go_table.aorbtn_info:SetActiveE(0)
        end
    end
end

