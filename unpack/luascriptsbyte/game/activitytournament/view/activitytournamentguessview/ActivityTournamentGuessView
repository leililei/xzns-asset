function ActivityTournamentGuessView:OnRefreshChatItem(listView2, index)

    local newIndex = index + 1
    local data = self.chatlist[newIndex]

    local item = listView2:NewListViewItem("$_obj_chatL")
    ---@type ActivityTournamentGuessView._obj_chatL_GoTable
    local goTable = _G.GetAutoGoTable(item)

    local m_Textinfo = goTable.obj_Textinfo:GetComponentE(typeof(CS.ExtendText))
    m_Textinfo.text = ""

    if data.type == _G.ChatInfoType.PlayerEmoji then
        goTable.aorrawimage_phiz:SetActiveE(1)
        goTable.aorimage_phiz:SetActiveE(0)
        goTable.aorimage_bg:SetActiveE(1)
        m_Textinfo.text = data.role_info.name:AddColor("dda752") .. ":"
        ---@type  expression_cfg
        local expression_cfg = self.ChatManager:Phiz_Get(tonumber(data.n_content))
        goTable.Params_phizPath = nil
        if expression_cfg ~= nil then
            goTable.aorimage_phiz:SetActiveE(1)
            goTable.Params_phizPath = expression_cfg.img_path
            goTable.aorrawimage_phiz:ClearChildren()
            goTable.aorrawimage_phiz:LoadImage(
                    goTable.Params_phizPath,
                    function(image)
                        if image then
                            image:SetNativeSize()
                        end
                        if goTable then
                            ---防止异步延迟 在判断一次
                            -- _G.GameUtil.SetActiveByCondition(goTable.aorrawimage_phiz, goTable.Params_phizPath ~= nil)
                        end
                    end
            )
        end
    elseif data.type == _G.ChatInfoType.chat then
        goTable.aorimage_bg:SetActiveE(1)
        goTable.aorrawimage_phiz:SetActiveE(0)
        goTable.aorimage_phiz:SetActiveE(0)
        m_Textinfo.text = data.role_info.name:AddColor("dda752") .. ":" .. data.n_content:AddColor("e6dab5")
    elseif data.type == _G.ChatInfoType.system then
        goTable.aorimage_bg:SetActiveE(1)
        goTable.aorrawimage_phiz:SetActiveE(0)
        goTable.aorimage_phiz:SetActiveE(0)
        m_Textinfo.text = data.n_content:AddColor("e6dab5")
    end
    goTable.obj_bg:ForceRebuildLayoutImmediate()
    goTable.obj_node:ForceRebuildLayoutImmediate()
    --item:ForceRebuildLayoutImmediate()
    --_G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(item)
    _G.GameUtil.ReBuildRTF(m_Textinfo)
    _G.GameUtil.ReBuildRTF(goTable.obj_bg)
    _G.GameUtil.ReBuildRTF(goTable.obj_node)
    _G.GameUtil.ReBuildRTF(item)
    return item
end

function ActivityTournamentGuessView:RefreshUI()
    if self.data then
        local guess_pub = {
            info= {
                right_num = 0,
                left_num = 0,
            }
        }
        if self.data.guess_pub and self.data.guess_pub[self.curSelectRound] and self.data.guess_pub[self.curSelectRound].round == self.model.round then
            guess_pub = self.data.guess_pub[self.curSelectRound]
        end
        local leftRoleData = self:GetRoleData(true)
        local rightRoleData = self:GetRoleData(false)

        if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
            self.roleNodel:RefreshItem(leftRoleData,true,self.leftIsWin)
            self.roleNoder:RefreshItem(rightRoleData,true,not self.leftIsWin)
        else
            self.roleNodel:RefreshItem(leftRoleData)
            self.roleNoder:RefreshItem(rightRoleData)
        end
        local count = guess_pub.info.left_num + guess_pub.info.right_num
        self.go_table.aorimage_progLeft.fillAmount = guess_pub.info.left_num/count
        self.go_table.aorimage_progRight.fillAmount = guess_pub.info.right_num/count

        self.go_table.aortext_oddsL.text = GetLangPackValue(90032100018,self.leftOdds)
        self.go_table.aortext_oddsR.text = GetLangPackValue(90032100018,self.rightOdds)
        --self.go_table.aortext_state.text = self:GetStateName()
        self.go_table.obj_haveGuessNodeL:SetActiveE(self.isHasGuessRoleL and 1 or 0)
        self.go_table.obj_haveGuessNodeR:SetActiveE(self.isHasGuessRoleR and 1 or 0)

        self.go_table.aortext_goldnum.text = self.coin
        self.go_table.aorrawimage_gold:LoadImage(self.coinData.Icon)
        self.go_table.aorbtn_Set:SetActiveE(self.round == 2 and 1 or 0)

        if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd and self.selectGuess_role then
            self.go_table.aortext_GuessResults:SetActiveE(1)
            if self.myIsWin then
                self.go_table.aortext_GuessResults.text = GetLangPackValue(90049900087)
            else
                self.go_table.aortext_GuessResults.text = GetLangPackValue(90049900088)
            end
        else
            self.go_table.aortext_GuessResults:SetActiveE(0)
        end

        self.go_table.aorbtn_leftdice:SetGray(not self.isShowCorL)
        self.go_table.aorbtn_rightdice:SetGray(not self.isShowCorR)
    end
end

--刷新表情
function ActivityTournamentGuessView:RefreshPhiz()
    if self.Phiz_initID == 1 then
        self.PhizArr = self.ChatManager:Phiz_GetAll()
    elseif self.Phiz_initID == 2 then
        self.PhizArr = self.ChatManager:Phiz_GetGif()
    end

    self.PhizArr = _G.table.values(self.PhizArr)
