function ActivityTournamentGuessView:OnEnable()
    if not self.IsAddEvents then
        _G.Events:GetInstance():AddListener(_G.eChatStatus.newChat, self.OnAddMinChatItem, self)
        _G.Events:GetInstance():AddListener(_G.eChatStatus.DelChat, self.UpdateChatInfoAll, self)
        self:AddListener(_G.eActivityTournament.StageChange, self.UpdateView)
        self.IsAddEvents = true
    end
    self:RefreshData()
    self:RefreshUI()
end

function ActivityTournamentGuessView:OnDisable()
    if self.timersend ~= nil then
        _G.coroutine.stopwaiting(self.timersend)
        self.timersend = nil
    end
    if self.updateDelayCor then
        _G.coroutine.stopwaiting(self.updateDelayCor)
        self.updateDelayCor = nil
    end
    if self.IsAddEvents then
        _G.Events:GetInstance():RemoveListener(_G.eChatStatus.newChat, self.OnAddMinChatItem, self)
        _G.Events:GetInstance():RemoveListener(_G.eChatStatus.DelChat, self.UpdateChatInfoAll, self)
        self:RemoveListener(_G.eActivityTournament.StageChange, self.UpdateView)
        self.IsAddEvents = false
    end
    self.isHide = true
end

function ActivityTournamentGuessView:OnCreate(msg)
    self:InitData(msg)
    self:InitUI()
    self:GetData()
    self.isGetData = true
    self:RefreshData()
    self:RefreshUI()
end

