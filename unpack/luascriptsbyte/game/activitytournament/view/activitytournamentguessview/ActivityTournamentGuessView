    self.uiRefreshTime = 60
    self.refreshTimer = 0
end

function ActivityTournamentGuessView:RefreshStage(back)
    self.isCanGuess = false
    local dayTime = TimeUtil.GetSecondsOfDay()
    if dayTime > self.timeCfg[2][1] and dayTime < self.timeCfg[2][2] then
        self.isCanGuess = true
    end
    for i = 1, #self.timeCfg do
        if dayTime > self.timeCfg[i][1] and dayTime <= self.timeCfg[i][2] then
            self.curStage = i
            self.curStageEndTime = self.timeCfg[i][2] + TimeUtil.GetDayBegin(TimeUtil.GetServerUnixTime())
        elseif dayTime > self.timeCfg[i][2] then
            self.curStage = i + 1
            self.curStageEndTime = 86400 + TimeUtil.GetDayBegin(TimeUtil.GetServerUnixTime())
        end
    end
    if self.curStage >= ActivityTournamentGuessView.curStage.settlementEnd then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.ActivityTour.CorrectGuessWinCount
            },
            1
        )
    end
    if back then
        back()
    end
end

---@return role.i_role
function ActivityTournamentGuessView:GetRoleData(isleft)
    if self.round == 2 then
        local leftData = self.roleRoundData[self.curSelectRound].left.role_info
        local rightData = self.roleRoundData[self.curSelectRound].right.role_info
        if isleft then
            return leftData
        else
            return rightData
        end
    else
        local guess_pub = self.data.guess_pub[self.curSelectRound]
        local leftData = guess_pub.info.left
        local rightData = guess_pub.info.right
        if isleft then
            return leftData
        else
            return rightData
        end
    end
end

function ActivityTournamentGuessView:GetGuessReport(isleft)
    ---@type activity_tournament.tournament_competitor_result
    local leftData = self.roleRoundData[self.curSelectRound].left.result
    local rightData = self.roleRoundData[self.curSelectRound].right.result
    if isleft then
        return leftData.result == 1
    else
        return rightData.result == 1
    end
end

function ActivityTournamentGuessView:GetTeamScope()
    if self.model.roundIndex == 1 then
        return 1,8,4
    elseif self.model.roundIndex == 2 then
        return 9,12,2
    elseif self.model.roundIndex == 3 then
        return 13,14,1
    end
end

function ActivityTournamentGuessView:GetData()
    self.data = self.model.GuessData
    self.round = self.model.round --1是淘汰轮2是冠军轮
    self.roundIndex = self.model.roundIndex -- 轮次
    if self.roundIndex == 0 then
        self.roundIndex = 1
    end

    if self.round == 2 then
        ---@type tournament_competitor[]
        self.model:GetGroupInfo(2,1,function(data)
            self.roleData = data
            local starId,endId,groupCount = self:GetTeamScope()
            self.roleRoundData = {}
            for i = 1, groupCount do
                self.roleRoundData[i] = {
                    left = self.roleData[starId + (i - 1) * 2],
                    right = self.roleData[starId + (i - 1) * 2  + 1],
                }
            end
            if self.isGetData then
                self:RefreshData()
                self:RefreshUI()
            end
        end)
    else
        self.curSelectRole = nil
        if self.data.guess_role then
            local guess_role = self.data.guess_role[#self.data.guess_role]
            if guess_role.info and guess_role.info[self.curSelectRound] then
                self.curSelectRole = guess_role.info[self.curSelectRound].target
            end
        end
    end

    self.ChatManager:GetActivityTournamentChatInfo(function(msg)
        self.chatData = msg
        ---@type chat.i_chat_msg[]
        self.chatlist = self.ChatManager.Chat_InfoAll[self:GetNowPindao()]
        self:RefreshChatList()
    end)


    self.model:GetTaskData(function(msg)
        local isHasReward = self:IsHasGuessResultsReward()
        local back = nil
        if isHasReward == 1 then
            back = function(msg)
                local data = self.data.guess_role[#self.data.guess_role]
                data.state = 1
                --self.model.curActivityClass:UpdateRedpoint(10)
            end
        end
        self:GetGuessReward()
        --if self.model.StageData.eliminate_info then
        --    if self.model.StageData.eliminate_info.day_guess_state == 0 or isHasReward == 1 then
        --        self:GetGuessReward( self.model.StageData.eliminate_info,back)
        --    end
        --elseif self.model.StageData.activity_tournament_champion then
        --    if self.model.StageData.activity_tournament_champion.day_guess_state == 0 or isHasReward == 1 then
        --        self:GetGuessReward( self.model.StageData.activity_tournament_champion,back)
        --    end
        --elseif self.model.StageData.champion_info then
        --    if self.model.StageData.champion_info.day_guess_state == 0 or isHasReward == 1 then
        --        self:GetGuessReward( self.model.StageData.champion_info,back)
        --    end
        --end
    end)
end

function ActivityTournamentGuessView:IsHasGuessResultsReward()
    if self.curStage >= ActivityTournamentGuessView.curStage.settlementEnd and self.data.guess_role then
    --if self.data.guess_role then
        if self.round == 1 then
            local data = self.data.guess_role[#self.data.guess_role]
            if data.state == 0 then
                return 1
            end
        else
            local isNeedGet = 0
            for i = 1, #self.data.guess_role do
                local data = self.data.guess_role[i]
                if data.index == self.roundIndex then
                    if data.state == 1 then
                        --当前轮次已经领取过奖励
                        return 0
                    else
                        isNeedGet = 1
                    end
                end
            end
            return isNeedGet
        end
    end
    return 0
end

function ActivityTournamentGuessView:GetGuessReward(data,call)
    self.model:GetGuessReward(function(msg)
        if data then
            data.day_guess_state = 1
        end
        local isPop = false
        if msg.award then
            local value= msg.award.item[1]
            --self.model:SetCoin({[value.type[3]] = value.type[4]})
            if value.type[4] ~= 0 then
                isPop = true
            end
        end
        if msg.guess_award then
            local value = msg.guess_award.item[1]
            self.model:SetCoin({[value.type[3]] = value.type[4]})
            if value.type[4] ~= 0 then
                isPop = true
            end
        end
        if isPop then
            --打开竞猜记录界面
            if self.oddsDict == nil then
                self:InitOddsDict()
            end
            UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.ActivityTourGuessRecordView.Name,{
                selectGroup = self.curSelectRound,
                roleList = self.roleData,
                oddsDict = self.oddsDict,
                openBack = function()
                    UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CommonAwardView.Name,msg)
                end
            })
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        if self.isGetData then
            self:RefreshData()
            self:RefreshUI()
        end
        if call then
            call()
        end
    end)
end

function ActivityTournamentGuessView:StartTimer()
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false)
        self.timer:Start()
    end
end

---@param list activity_tournament.activity_tournament_guess_role_info[]
function ActivityTournamentGuessView:GetIsHasRole(list,uid)
    if list then
        for i = 1, #list do
            if list[i].target == uid then
                return true
            end
        end
    end
    return false
end

function ActivityTournamentGuessView:InitOddsDict()
    self.failureOdds = 0

    if self.data == nil then
        return
    end

    ---@type table<number,table<number,activity_tournament.guess_ratio>>
    self.oddsDict = {}

    local acfg = self.model:GetCfg()
    if acfg.guess_ratio then
        for i = 1, #acfg.guess_ratio do
            local data = acfg.guess_ratio[i]
            if data.round == self.model.round and data.index == self.model.roundIndex then
                --self.leftOdds = acfg.guess_ratio[self.model]
                self.leftOdds = data.data.key/10000
                self.rightOdds = data.data.key/10000
                self.failureOdds = data.data.value/10000
            end
            if self.oddsDict[data.round] == nil then
                self.oddsDict[data.round] ={}
            end
            self.oddsDict[data.round][data.index] = data
        end
    end
end

function ActivityTournamentGuessView:RefreshData()
    self.leftOdds = self.oddsList[1][self.roundIndex]/10000
    self.rightOdds = self.oddsList[1][self.roundIndex]/10000

    if self.data == nil then
        return
    end

    self:InitOddsDict()

    self.isHasGuessRoleL = false
    self.isHasGuessRoleR = false
    self.isShowCorL = false
    self.isShowCorR = false
    self.curBetsNumber = 0
    self.leftIsWin = false
    self.isSetLeftRight = false
    self.myIsWin = false
    if self.round == 2 then
        self.curSelectRole = nil
        local leftRoleData = self:GetRoleData(true)
        local RightRoleData = self:GetRoleData(false)
        local leftUid = leftRoleData and leftRoleData.uid or nil
        local rightUid = RightRoleData and RightRoleData.uid or nil
        self.selectGuess_role = nil
        if self.data.guess_role then
            for i = 1, #self.data.guess_role do
                local guess_role = self.data.guess_role[i]
                if guess_role.index == self.model.roundIndex and guess_role.info and guess_role.info[1] and guess_role.round == 2 then
                    local uid = guess_role.info[1].target
                    if uid == leftUid or uid == rightUid then
                        self.selectGuess_role = guess_role
                        self.curSelectRole = guess_role.info[#guess_role.info].target
                        self.curBetsNumber = guess_role.info[#guess_role.info].num
                        break
                    end
                end
            end
        end
        if self.selectGuess_role and self.selectGuess_role.guess_count == 1 then
            self.isSetLeftRight = true
        end
        if self.curSelectRole and leftUid == self.curSelectRole then
            self.isHasGuessRoleL = true
            if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
                self.myIsWin = self:GetGuessReport(true)
            end
        elseif self.curSelectRole and rightUid == self.curSelectRole then
            self.isHasGuessRoleR = true
            if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
                self.myIsWin = self:GetGuessReport(false)
            end
        end
        if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd then
            self.leftIsWin = self:GetGuessReport(true)
        end
    else
        self.curSelectRole = nil
        self.selectGuess_role = nil
        self.curSelectRound = self.model.roundIndex
        if self.data.guess_role then
            for i = 1, #self.data.guess_role do
                local guess_role = self.data.guess_role[i]
                if guess_role.info and self.model.roundIndex == guess_role.index  then
                    self.selectGuess_role = guess_role
                    self.curSelectRole = guess_role.info[#guess_role.info].target
                    self.curBetsNumber = guess_role.info[#guess_role.info].num
                    break
                end
            end
        end
        if self.selectGuess_role and self.selectGuess_role.guess_count == 1 then
            self.isSetLeftRight = true
        end
        local guess_pub = self.data.guess_pub[self.curSelectRound]
        local rightUid = nil
        local leftUid = nil
        if guess_pub == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("当前回合：" .. self.curSelectRound)
            end
        end
        if guess_pub.info then
            rightUid = guess_pub.info.right and guess_pub.info.right.uid or nil
            leftUid = guess_pub.info.left and guess_pub.info.left.uid or nil
        end
        if self.curSelectRole and leftUid == self.curSelectRole then
            self.isHasGuessRoleL = true
        elseif self.curSelectRole and rightUid == self.curSelectRole then
            self.isHasGuessRoleR = true
        end
        if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd or self.curStage == ActivityTournamentGuessView.curStage.Settlement then
            if guess_pub.info.result == 1 and leftUid == self.curSelectRole then
                self.myIsWin = true
            elseif guess_pub.info.result == 2 and rightUid == self.curSelectRole then
                self.myIsWin = true
            end
        end
    end

    if self.curStage == ActivityTournamentGuessView.curStage.PlaceBet and self.curSelectRole == nil and self.model.stage <= 4 then
        self.isShowCorL = true
        self.isShowCorR = true
    else
        self.isShowCorL = self.isHasGuessRoleL and self.isHasGuessRoleL or false
        self.isShowCorR = self.isHasGuessRoleR and self.isHasGuessRoleR or false
    end

    if self.curStage == ActivityTournamentGuessView.curStage.settlementEnd and self.round == 1 then
        local guess_pub = self.data.guess_pub[self.curSelectRound]
        if guess_pub.info.result == 1 then
            self.leftIsWin = true
        end
    end
    ---@type public.i_kv_64
    self.coin = self.model:GetCoinNum(191)
    self.coinData = StorageManager:GetInstance():GetStorageItemData(191)
end

