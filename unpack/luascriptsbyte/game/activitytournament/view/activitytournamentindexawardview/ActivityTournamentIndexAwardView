local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentIndexAwardView : UIBaseView    中文描述
---@field public go_table ActivityTournamentIndexAwardView_GoTable GoTable
local ActivityTournamentIndexAwardView = _G.BaseClass("ActivityTournamentIndexAwardView", _G.UIBaseView)

local title = {
    [1] = 90049900016,
    [2] = 90049900015,
    [3] = 90049900014,
    [4] = 90049900013,
    [5] = 90049900012,
    [6] = 90049900011,
}

---构造函数
---@protected
function ActivityTournamentIndexAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityTournamentIndexAwardView:OnCreate()
    self:InitView()
end

---
---@protected
function ActivityTournamentIndexAwardView:InitView()
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
    self.cfg = ActivityTournamentModel:GetInstance():GetCfg()
    self.startTime = self.activity.cfg.time.start_time + self.cfg.preselect_time + self.cfg.preselect_settlement_time
    self.round = ActivityTournamentModel:GetInstance():GetRound()
    self.roundIndex = ActivityTournamentModel:GetInstance():GetRoundIndex()
    self.index = self.round == 1 and self.roundIndex or (self.roundIndex + 3)
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()
    local award = ActivityTournamentModel:GetInstance():GetCfg().eliminate_award
    self.states = ActivityTournamentModel:GetInstance():GetRankAwardState()

    local getAwardIndex = 0
    for i = 1, self.index do
        if not _G.table.ContainsValue(self.states, i) and getAwardIndex == 0 then
            getAwardIndex = i
            break
        end
    end

    self.data = {}
    for i, v in ipairs(award) do
        if self.data[v.type] == nil then
            self.data[v.type] = {}
        end
        _G.table.insert(self.data[v.type], v.award.type)
    end
    if self.init == nil then
        self.go_table.scrollloopvectical_item:InitItemData(#self.data,
            _G.handler(self, self.OnInitItem))
        self.init = true
    else
        self.go_table.scrollloopvectical_item:UpdateCount(#self.data)
    end
end

function ActivityTournamentIndexAwardView:OnInitItem(index, obj)
    local data = self.data[index + 1]
    local num = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickFuncPreview))
    local dt = _G.TimeUtil.GetDateTime(self.startTime + 86400 * (num - 1))
    tb.aortext_title.text = dt.month .. "/" .. dt.day .. "  " .. _G.GetLangPackValue(title[num])

    tb.obj_award:RemoveAllChildren()
    tb.num = num
    for k2, v2 in ipairs(data) do
        local sid = v2[1] == 0 and v2[4] or v2[1]
        local num = v2[1] == 0 and v2[5] or v2[2]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, num },
            tb.obj_award,
            function(tran)
                if self.go_table == nil then
                    _G.DestroyObject(tran)
                end
                tran:SetGou(_G.table.ContainsValue(self.states, tb.num))
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                if _G.table.ContainsValue(self.states, tb.num) == false and tb.num <= self.index then
                    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kelingqukuang, tran.go_table.obj_uieffect)
                end
            end,
            function(go)
                self.round = ActivityTournamentModel:GetInstance():GetRound()
                self.roundIndex = ActivityTournamentModel:GetInstance():GetRoundIndex()
                self.index = self.round == 1 and self.roundIndex or (self.roundIndex + 3)
                if _G.table.ContainsValue(self.states, tb.num) == false and tb.num <= self.index then
                    ActivityTournamentModel:GetInstance():GetIndexAward({ tb.num }, function()
                        self:InitView()
                    end)
                else
                    local sid = go.sid
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
                end
            end
        )
    end
end

---界面的销毁函数
function ActivityTournamentIndexAwardView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityTournamentIndexAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        local ids = {}
        for i = 1, #self.data do
            if _G.table.ContainsValue(self.states, i) == false and i <= self.index then
                _G.table.insert(ids, i)
            end
        end
        if #ids > 0 then
            ActivityTournamentModel:GetInstance():GetIndexAward(ids, function()
                self:InitView()
            end)
        end
    end
end

return ActivityTournamentIndexAwardView