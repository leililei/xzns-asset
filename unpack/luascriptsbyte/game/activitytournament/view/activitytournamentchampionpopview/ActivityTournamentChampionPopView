local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentChampionPopView : UIBaseView    中文描述
---@field public go_table ActivityTournamentChampionPopView_GoTable GoTable
local ActivityTournamentChampionPopView = _G.BaseClass("ActivityTournamentChampionPopView", _G.UIBaseView)

---构造函数
---@protected
function ActivityTournamentChampionPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ActivityTournamentChampionPopView:OnCreate(player)
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
    if self.topPlayerItem == nil then
        self.topPlayerItem = _G.GetAutoGoTable(self.go_table.obj_info)
    end
    if player then
        local tempCount = self.topPlayerItem.trans_role:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(self.topPlayerItem.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
        if self.title then
            _G.PoolsManager:GetInstance():Despawn(self.title.gameObject, _G.ePoolType.Temporary)
            self.title = nil
        end
        self.topPlayerItem.aortext_name.text = player.name
        local severname = _G.ServerManager:GetInstance():GetServerNameByServerID(player.server_id)
        if severname then
            self.topPlayerItem.aortext_server:SetActiveE(1)
            self.topPlayerItem.aortext_server.text = "[" .. severname .. "]"
        else
            self.topPlayerItem.aortext_server:SetActiveE(0)
        end
        self:UpdateTop3Title(self.topPlayerItem, player.title)
        local cfg = require "CardCommentManager":GetInstance():CardData(player.city_style_id, false)
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        self:LoadRoleModel(path, cfg.size4, self.topPlayerItem.trans_role)
    else
        self.topPlayerItem.aortext_name.text = _G.GetLangPackValue(90000010159)
        self.topPlayerItem.aortext_server.text = ""
    end
    self.go_table.aortext_des.text = _G.GetLangPackValue(90049900138, player.name)
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function ActivityTournamentChampionPopView:LoadRoleModel(rolepath, scale, trans_role)
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(trans_role)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
        end
    )
end

---生成称号
---@param item table
function ActivityTournamentChampionPopView:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle == nil or (self.curShowEffTitle ~= nil and self.curShowEffTitle ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                    self.title = trans
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---界面的销毁函数
function ActivityTournamentChampionPopView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityTournamentChampionPopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_skip then
        self:Close()
    end
    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("ActivityTournamentChampionPopView" .. self.activityID,
            _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return ActivityTournamentChampionPopView