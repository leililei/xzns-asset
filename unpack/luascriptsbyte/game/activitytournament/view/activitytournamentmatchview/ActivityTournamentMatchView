---@class ActivityTournamentMatchView : UIBaseView    中文描述
local ActivityTournamentMatchView = _G.BaseClass("ActivityTournamentMatchView", _G.UIBaseView)
local format = _G.string.format
function ActivityTournamentMatchView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param arena_layer_enemy_array arena_layer.s2c_arena_layer_enemy_array
---@param arena_layer_match arena_layer.s2c_arena_layer_match
---@param skipBattle boolean 是否跳过战斗
function ActivityTournamentMatchView:OnCreate(arena_layer_enemy_array, arena_layer_match, skipBattle)
    --匹配5秒显示
    self.enterTiming = 3
    self.number = 0
    self.EnemyGarray = arena_layer_enemy_array
    self.EnemyInfo = arena_layer_match
    self.skipBattle = skipBattle
    self:InitView()
end

---初始化界面
function ActivityTournamentMatchView:InitView()
    if self.EnemyInfo.is_first == 0 then
        self.go_table.obj_matchContent:SetActiveE(0)
        self.go_table.obj_DuelContent:SetActiveE(0)
    else
        self.go_table.obj_matchContent:SetActiveE(1)
        self.go_table.obj_DuelContent:SetActiveE(0)
    end
    local msg = {}
    msg.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    require "SystemSettingNet":GetInstance():GetPlayerInfo(msg, _G.handlerbind(self, self.ShowView))
end

function ActivityTournamentMatchView:ShowView(data)
    self.playerRoleInfo = data
    if self.EnemyInfo.is_first == 0 then
        self:OnShowPlayerTimer()
    else
        self.refreshTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimer, self, false, false, true)
        self.refreshTimer:Start()

        self.headIconIndex = 1
        self.headIconList = _G.ConfigManager.discrete_cfg[107916][1]
        self.showHeadTimer = _G.TimerManager:GetInstance():GetTimer(0.15, self.ShowCardHeadIcon, self)
        self.showHeadTimer:Start()
    end
end

---展示头像
function ActivityTournamentMatchView:ShowCardHeadIcon()
    if self and self.go_table then
        local player_portrait = _G.ConfigManager.player_portrait_cfg[self.headIconList[self.headIconIndex]]
        if player_portrait then
            self.go_table.aorimage_portrait.SpriteName = player_portrait.portrait1
        end
        self.headIconIndex = self.headIconIndex + 1
        if self.headIconIndex > #self.headIconList then
            self.headIconIndex = 1
        end
    end
end

function ActivityTournamentMatchView:OnTimer(elapsed)
    if elapsed == nil then
        elapsed = 1
    end
    self.number = self.number + elapsed
    self.go_table.aortext_timing.text = self.enterTiming - math.floor(self.number)
    if self.number > self.enterTiming then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
        self.showHeadTimer:Stop()
        self.showHeadTimer = nil
        self:OnTimerOver()
        self.ShowPlayerTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnShowPlayerTimer, self, true, false, true)
        self.ShowPlayerTimer:Start()
    end
end

function ActivityTournamentMatchView:OnTimerOver()
    self.go_table.obj_head:SetActiveE(1)
    self.go_table.aorimage_portrait:SetActiveE(0)
    self.go_table.aorimage_iconBg:SetActiveE(0)
    self.go_table.obj_IsMating:SetActiveE(0)
    self.go_table.obj_MateSuccess:SetActiveE(1)
    self.go_table.obj_HeadItemBase:SetActiveE(1)

    if self.SetPlayerHead == nil then

        self.go_table.aortext_name.text = self.EnemyInfo.role_info.name

        self.SetPlayerHead = true
        ---@type Params_PlayerHeadItem
        local Params_PlayerHeadItem = {}
        Params_PlayerHeadItem.frame = self.EnemyInfo.role_info.frame
        Params_PlayerHeadItem.lv = nil
        Params_PlayerHeadItem.style = self.EnemyInfo.role_info.style
        Params_PlayerHeadItem.sid = nil
        Params_PlayerHeadItem.uid = nil
        _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, Params_PlayerHeadItem, 1, true, true, false, NONE)
    end
end

function ActivityTournamentMatchView:OnShowPlayerTimer()
    self.go_table.obj_matchContent:SetActiveE(0)
    self.go_table.obj_DuelContent:SetActiveE(1)
    self.go_table.obj_vs:SetActiveE(1)
    self.go_table.aortext_countDown.text = ""
    local playerScore = ActivityTournamentModel:GetInstance():GetScore()
    self:ShowRole(self.go_table.obj_mine, self.playerRoleInfo.info, playerScore)
    self:ShowRole(self.go_table.obj_enemy, self.EnemyInfo.role_info, self.EnemyInfo.score)

    self.countDown = 2
    self.numAni = self.go_table.obj_Middle:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnBPViewOpened, self)
    local check = function(trans)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(trans)
            return
        end
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

---@param info role.i_role
function ActivityTournamentMatchView:ShowRole(obj, info, score)
    local tb = _G.GetAutoGoTable(obj)

    tb.aortext_name.text = info.name

    tb.aortext_guild.text = _G.GetLangPackValue(90022500401, info.guild_name ~= "" and info.guild_name or _G.GetLangPackValue(90021300086))
    tb.aortext_score.text = score
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, info, 0.7, true, true, false, NONE)
    --local arena_layer_league_cfg = SpiritualRealmModel:GetInstance():GetGradeCfg(score)
    --tb.aorrawimage_dan:LoadImage(arena_layer_league_cfg.icon)
    --tb.aortext_rank.text = _G.GetLangPackValue(arena_layer_league_cfg.name)
end

function ActivityTournamentMatchView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self:CloseView()
        ActivityTournamentModel:GetInstance():Fight(self.EnemyGarray, self.EnemyInfo, self.skipBattle)
    elseif self.countDown <= 3 then
    end
end

