local ActivityTournamentModel = require("ActivityTournamentModel")
local ActivitySynManager = require "ActivitySynManager"
local RankUtils = require("RankUtils")
---@class ActivityTournamentView : UIBaseView    中文描述
---@field public go_table ActivityTournamentView_GoTable GoTable
local ActivityTournamentView = _G.BaseClass("ActivityTournamentView", _G.UIBaseView)

local viewName = {
    [3] = _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name,
    [4] = _G.ConfigManager.ui_cfg.ActivityTournamentChampionView.Name,
    [5] = _G.ConfigManager.ui_cfg.ExchangeShopView.Name,
    [6] = _G.ConfigManager.ui_cfg.ActivityTournamentGuessView.Name,
    [7] = _G.ConfigManager.ui_cfg.ActivityTournamentGroupInfoView.Name,
}

local stageTag = {
    [1] = { 1, 2, 3, 4, 5 },
    [2] = { 1, 3, 4, 5, 6, 7 },
    [3] = { 3, 4, 5, 6, 7 },
}

local stageTitle = {
    [1] = 90049900002,
    [3] = 90049900003,
    [4] = 90049900004,
}

local stageTitle2 = {
    [1] = 90049900128,
    [2] = 90049900127,
    [3] = 90049900129,
    [4] = 90049900130,
    [5] = 90049900131,
}

---构造函数
---@protected
function ActivityTournamentView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpen, self)
    self:AddListener(_G.eActivityTournament.StageChange, self.SetStageInfo)
    self.toggles = {}
end

---界面的入口函数
function ActivityTournamentView:OnCreate()
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
    self.cfg = ActivityTournamentModel:GetInstance():GetCfg()
    self.activityID = self.activity.activityID
    self.activityCls = self.activity:GetActivityTypeCls()
    self.season = ActivityTournamentModel:GetInstance():GetSeason()
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()
    self.views = { [1] = { gameObject = self.go_table.obj_mainView } }
    for i = 1, 7 do
        self.toggles[i] = _G.GetAutoGoTable(self.go_table["toggle_tag" .. i], _G.handlerbind(self, self.OnClickToggle, i))
    end
    self:SetTagView()

    self.go_table.aorrawimage_bg:LoadImage(
        self.stage == 1 and "ImagesH5/hActivityTournament/ui_kfzf_zjm_bg" or "ImagesH5/hActivityTournament/ui_kfzf_zjm_bg2"
    )
    --self.endTime = self.stageEndTime
    --self:InitActivityTime()
    --self:UpdateTimer()
    --if not self.timer then
    --    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    --    self.timer:Start()
    --end
    local resources = _G.ConfigManager.ui_cfg.ActivityTournamentView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
        )
    end
    self.go_table.obj_serverList:GetComponentE(_G.typeof(_G.CS.ExtendText)).text = string.format("<%s@1>", _G.GetLangPackValue(90033500130))
    self:SetTag()
    --兑换
    self.activityExchange = ActivitySynManager:GetInstance():GetChildAcitivity(10005, self.activity:GetJumpType(self.activityID))
    if self.activityExchange then
        self.toggles[5].obj_redpoint:UpdateRedPointItemIDAndParam(self.activityExchange:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
    --荣誉殿堂
    self.toggles[4].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(5))
    self.toggles[4].obj_redpoint2:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(6))
    --主页签
    self.toggles[1].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2))
    self.toggles[1].obj_redpoint2:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(3))
    --赛程
    if self.stage > 3 then
        self.toggles[7].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(4))
    end
    --战报
    self.go_table.obj_redpointlog:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(2))
    --竞猜
    self.toggles[6].obj_redpoint:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(8))
    _G.PlayerPrefsManager.SetInt(
        "ActivityTournamentDaily" .. self.activity:GetActivityID(),
        _G.TimeUtil.GetServerUnixTime()
    )
    self.go_table.obj_redpointtask:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(11))
    self.activityCls:UpdateRedpoint(1)

    local delayTime = 0
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    if ((_G.TimeUtil.GetServerUnixTime() - self.activity.cfg.time.start_time) < 86400) and curTime < self.refreshTime then
        delayTime = self.refreshTime - curTime
    end
    if delayTime > 0 then
        self.timerTitle = _G.TimerManager:GetInstance():GetTimer(delayTime, self.SetTitleName, self, true, false, true)
        self.timerTitle:Start()
    end
end

