---@protected
function ActivityTournamentView:SetTitleName()
    self.refreshTime = _G.ConfigManager.discrete_cfg[138002][1][1]
    if self.itemList == nil then
        self.itemList = {}
        for i = 1, 5 do
            self.itemList[i] = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
            self.itemList[i].aortext_name.text = _G.GetLangPackValue(stageTitle2[i])
            local dt
            if i == 1 or i == 2 then
                dt = _G.TimeUtil.GetDateTime(self.activity.cfg.time.start_time)
            elseif i == 3 then
                dt = _G.TimeUtil.GetDateTime(self.activity.cfg.time.start_time + self.cfg.preselect_time + self.cfg.preselect_settlement_time)
            elseif i == 4 then
                dt = _G.TimeUtil.GetDateTime(self.activity.cfg.time.start_time + self.cfg.preselect_time + self.cfg.eliminate_time + self.cfg.preselect_settlement_time)
            elseif i == 5 then
                dt = _G.TimeUtil.GetDateTime(self.activity.cfg.time.start_time + self.cfg.preselect_time + self.cfg.eliminate_time + self.cfg.champion_time + self.cfg.preselect_settlement_time)
            end
            self.itemList[i].aortext_time.text = dt.month .. "/" .. dt.day
        end
    end
    local isPre = false
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    if ((_G.TimeUtil.GetServerUnixTime() - self.activity.cfg.time.start_time) < 86400) and curTime < self.refreshTime then
        isPre = true
    end
    local stage = isPre == true and 2 or self.stage
    for i = 1, 5 do
        local isGray = i ~= stage
        self.itemList[i].aorimage_icon.SpriteName = isGray == true and "ui_kfzf_zjm_frame1" or "ui_kfzf_zjm_frame2"
        self.itemList[i].obj_choose:SetActiveE(isGray == true and 0 or 1)
        self.itemList[i].aortext_time.color = isGray == true and _G.ColorTools.FormatColorByString("B9B5B3") or _G.ColorTools.FormatColorByString("FFE369")
        self.itemList[i].aortext_name.color = isGray == true and _G.ColorTools.FormatColorByString("B9B5B3") or _G.ColorTools.FormatColorByString("FFE369")
    end
end

---
---@protected
function ActivityTournamentView:SetTag()
    local default = self.stage ~= 5 and 1 or 4
    self:OnClickToggle(nil, true, default)
    if self.stage ~= 5 then
        self:InitView()
    else
        self.go_table["toggle_tag" .. default].isOn = true
    end
end

---设置阶段信息
function ActivityTournamentView:SetStageInfo()
    self.stage, self.stageEndTime = ActivityTournamentModel:GetInstance():GetStateInfo()
    self.endTime = self.stageEndTime
    if self.stage == 2 then
        self:Close()
    elseif self.stage == 5 then
        if self.prepareView ~= nil then
            self.prepareView:UpdateView()
        end
        if self.prepareView ~= nil then
            self.eliminateView:UpdateView()
        end
    end
    self:SetTagView()
    self:SetTag()
end

function ActivityTournamentView:SetTagView()
    local tagIndex = 2
    if self.stage == 1 then
        tagIndex = 1
    elseif self.stage == 5 then
        tagIndex = 3
    end
    for i = 1, 7 do
        if i == 4 then
            if self.season ~= 1 or (self.season == 1 and self.stage == 5) then
                self.go_table["toggle_tag" .. i]:SetActiveE(1)
            else
                self.go_table["toggle_tag" .. i]:SetActiveE(0)
            end
        else
            self.go_table["toggle_tag" .. i]:SetActiveE(_G.table.ContainsValue(stageTag[tagIndex], i) == true and 1 or 0)
        end
    end
end

---监听Toggle点击事件
---@param key string
---@param callback function
function ActivityTournamentView:OnClickToggle(_, isOn, key)
    local tb = self.toggles[key]
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    local lastToggle = self.curToggle
    self.curToggle = key

    --节点显隐
    if view then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn then
        self:OpenView()
    end
end

---开始时间~结束时间  (日月)
function ActivityTournamentView:InitActivityTime()
    local starTime = self.activity.cfg.time.start_time
    local start = _G.TimeUtil.GetDateTime(starTime)
    local endt = _G.TimeUtil.GetDateTime(starTime + self.activity.cfg.time.run_time - 1)
    local color = "<color=#96ce51>"
    if _G.AppSetting.IsXzns then
        color = "<color=#1ACC55>"
    end
    self.go_table.aortext_time2.text = _G.GetLangPackValue(
        90025800003, color .. string.format("%s</color>", _G.GetLangPackValue(90032100011, start.month, start.day) .. " " .. string.format("%02d:%02d:%02d", start.hour, start.minute, start.second) .. "~" .. _G.GetLangPackValue(90032100011, endt.month, endt.day) .. " " .. string.format("%02d:%02d:%02d", endt.hour, endt.minute, endt.second)))
end

function ActivityTournamentView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90049900005, _G.TimeUtil.TranslateSecondForStr(time))
    if time <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    end
end

function ActivityTournamentView:OpenView()
    local view = self.views[self.curToggle]
    self.openView = viewName[self.curToggle]
    if not view then
        if self.curToggle == 2 then
            --防守阵容
            ActivityTournamentModel:GetInstance():OpenEmbattleDefence()
        elseif self.curToggle == 3 then
            --奖励
            local rankStr = RankUtils.RankStrDefault.MilitaryIndustry
            local model = require("ActivityTournamentModel"):GetInstance()
            local Scope = model:GetRankAwardCfgIdScope()
            local rankId = self.stage == 1 and 104 or RankUtils.RankType.CrossServiceCompAlliance
            local isShowSelf = self.stage ~= 1 and 1 or 0
            -----@type RewardPreviewView.OpenData[]
            local OpenData = {--TODO 排行榜 常量
                RankUtils.GetData(20, 0, 0, rankStr, nil, _G.ConfigManager.arena_rank_cfg, Scope.min, Scope.max, isShowSelf, rankId),
            }
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RewardPreviewFullView.Name, OpenData, 1, nil, nil, nil, true)
        elseif self.curToggle == 4 then
            --荣誉殿堂
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentChampionView.Name)
        elseif self.curToggle == 5 then
            --兑换
            --self.openView = self.activityExchange:GetActivityTypeCls():OnGetMainViewName()
            _G.GlobalInterface.JumpActivityByGM(10005, self.activity:GetJumpType(self.activityID))
        elseif self.curToggle == 6 then
            --竞猜
            ActivityTournamentModel:GetInstance():GetGuessData(function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentGuessView.Name)
            end)
        elseif self.curToggle == 7 then
            --赛程
            ActivityTournamentModel:GetInstance():GetGuessData(function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentGroupInfoView.Name)
            end)
        end
    end
end

function ActivityTournamentView:OnUIOpen(name)
    if name ~= self.openView then
        return
    end

    if name == _G.ConfigManager.ui_cfg.RewardPreviewFullView.Name then
        --ActivityTournamentModel:GetInstance():ChangeAwardShowRed()
    end

    _G.UIManager:GetInstance():ChangeCanvasOrder(
        self.openView,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
    )
    self.views[self.curToggle] = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.views[self.curToggle].transform:SetParentE(self.go_table.obj_windows)
    self.views[self.curToggle].transform:SetAsLastSiblingE()
end

function ActivityTournamentView:InitView()
    self.go_table.obj_prepare:SetActiveE(self.stage == 1 and 1 or 0)
    self.go_table.obj_eliminate:SetActiveE(self.stage ~= 1 and 1 or 0)
    if self.stage == 1 then
        if self.prepareView == nil then
            self.prepareView = self:AddComponent(self.go_table.obj_prepare, require("ActivityTournamentPrepare").New())
            self.prepareView:UpdateView()
        else
            self.prepareView:UpdateView()
        end
    end
    if self.stage ~= 1 then
        if self.prepareView == nil then
            ---@type ActivityTournamentEliminate
            self.eliminateView = self:AddComponent(self.go_table.obj_eliminate, require("ActivityTournamentEliminate").New(self.go_table.toggle_tag7))
            self.eliminateView:UpdateView()
        else
            self.eliminateView:UpdateView()
        end
    end
    self.go_table.aortext_des.text = _G.GetLangPackValue(stageTitle[self.stage])
    self.go_table.aorbtn_rank:SetActiveE(self.stage == 1 and 1 or 0)
    self.go_table.aorbtn_prepare:SetActiveE(self.stage ~= 1 and 1 or 0)
    self.go_table.aorbtn_log:SetActiveE(self.stage == 1 and 1 or 0)
    self.go_table.aorbtn_indexAward:SetActiveE(self.stage ~= 1 and 1 or 0)
    if self.stage ~= 1 then
        self.go_table.obj_redpointIndexAward:UpdateRedPointItemIDAndParam(self.activity:GetActivityTypeCls():GetRedpointIDByIndex(3))
    end
    if self.stage >= 3 then
        UIManager:GetInstance():CloseWindow(ConfigManager.ui_cfg.ActivityTourTaskView.Name)
    end
    self.go_table.aorbtn_task:SetActiveE(self.stage < 3 and 1 or 0)
    self:SetTitleName()
end

---界面的销毁函数
function ActivityTournamentView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timerTitle then
        self.timerTitle:Stop()
        self.timerTitle = nil
    end
    self:RemoveAllListener()
    --关闭内嵌页面
    if self.views then
        for k, view in pairs(self.views) do
            if k ~= 1 then
                view:Close()
            end
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function ActivityTournamentView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        local index = self.stage == 5 and 4 or 1
        if self.curToggle ~= index then
            self.go_table["toggle_tag" .. index].isOn = true
            return
        end
        self:Close()
        --关闭内嵌页面
        if self.views then
            for k, view in pairs(self.views) do
                if k ~= 1 then
                    view:Close()
                end
            end
            self.views = nil
        end
    elseif go == self.go_table.aorbtn_serverList then
        require("ActivityTournamentNet"):GetInstance():GetServerList(
            { activity_id = self.activityID },
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamServerListView.Name, data)
            end
        )
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 218)
    elseif go == self.go_table.aorbtn_log then
        --todo:战报
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CrossServiceReportPanel.Name)
        ActivityTournamentModel:GetInstance():ChangeLogRedStage()
    elseif go == self.go_table.aorbtn_task then
        --todo:任务
        --ActivityTournamentModel:GetInstance().curActivityTakeClass:OnEnterActivity()
        ActivityTournamentModel:GetInstance():GetTaskData(function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTourTaskView.Name)
        end)
    elseif go == self.go_table.aorbtn_rank then
        --todo:排行
        require("RankUtils").ClearAllRankData()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CrossServiceCompRankView.Name)
        if self.stage == 1 then
            if self.prepareView ~= nil then
                self.prepareView:SetRankView()
            end
        end
    elseif go == self.go_table.aorbtn_indexAward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentIndexAwardView.Name)
    elseif go == self.go_table.aorbtn_prepare then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentPreparePopView.Name, self.go_table.toggle_tag7)
    end
end

return ActivityTournamentView