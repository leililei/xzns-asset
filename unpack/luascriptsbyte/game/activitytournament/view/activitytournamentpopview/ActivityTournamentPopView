local ActivityTournamentModel = require("ActivityTournamentModel")
---@class ActivityTournamentPopView : UIBaseView    中文描述
---@field public go_table ActivityDispatchPopView_GoTable GoTable
local ActivityTournamentPopView = _G.BaseClass("ActivityTournamentPopView", _G.UIBaseView)

---构造函数
---@protected
function ActivityTournamentPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
--
---界面的入口函数
function ActivityTournamentPopView:OnCreate()
    self.activity = ActivityTournamentModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
end
--
---界面的销毁函数
function ActivityTournamentPopView:OnDestroy()
end

---按钮点击事件在这里派发
function ActivityTournamentPopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_skip then
        self.activity = ActivityTournamentModel:GetInstance():GetActivity()
        if self.activity ~= nil then
            _G.GlobalInterface.JumpActivityByGM(10085, self.activity:GetJumpType(self.activity.activityID))
            self:Close()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        end
    end

    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("ActivityTournamentPopView" .. self.activityID,
            _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return ActivityTournamentPopView