function ActivityTournamentSynModel:SetTipTbActive(isShow)
    if self.MainTipTb then
        self.MainTipTb.obj_tips:SetActiveE(isShow == true and 1 or 0)
    end
end

---销毁对象时,析构函数
function ActivityTournamentSynModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.StateChanged), self)
    end
end

function ActivityTournamentSynModel:SetCoin(coins)
    ActivityTournamentModel:GetInstance():SetCoin({ [coins.key] = coins.value })
end

return ActivityTournamentSynModel
