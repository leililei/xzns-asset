---竞猜任务进度奖励
function ActivityTournamentSynModel:CheckRed_IsHasGuessProgTake()
    local model = ActivityTournamentModel:GetInstance()
    ---@type process_award_info[]
    local propData = model.cfg.process_award
    local curProg = 0
    if model.taskData == nil then
        if model.stage == 5 then
            model:GetTaskData(function()
                self:UpdateRedpoint(9)
            end,4)
        else
            model:GetTaskData(function()
                self:UpdateRedpoint(9)
            end)
        end
    else
        local taskData = model:GetCurShowTaskData(true)

        local data = nil
        if model.stage == 3 then
            data = model.StageData.eliminate_info
        elseif model.stage == 4 or model.stage == 5 then
            data = model.StageData.champion_info
        end
        local process_state = {}
        if data then
            if data.process_state then
                for k, v in pairs(data.process_state) do
                    process_state[v] = true
                end
            end
        end

        for i = 1, #taskData do
            ---@type ActivityTourGuessTaskData
            local data = taskData[i]
            ---@type mission_extra_cfg
            local cfg = data.Cfg
            local isCallGet = data.i_task.target[1] >= cfg.count
            local isReceived = data:GetState() == _G.TaskEnum.ETaskState.Claimed
            if isCallGet and isReceived then
                curProg = curProg + 1
            end
        end
        for i = 1, #propData do
            if curProg >= propData[i].process and process_state[propData[i].process] == nil then
                return 1
            end
        end
    end
    return 0
end

---是否有竞猜结果奖励
function ActivityTournamentSynModel:CheckRed_IsHasGuessResultsReward()
    local model = ActivityTournamentModel:GetInstance()
    local stage = self:GetStage()
    if stage == 5 then
        local data = model.GuessData.guess_role[#model.GuessData.guess_role]
        if data.state == 0 then
            return 1
        end
    end
    return 0
end

function ActivityTournamentSynModel:GetStage()
    local dayTime = TimeUtil.GetSecondsOfDay()
    local stageTimeCfg = ConfigManager.discrete_cfg[138008]
    for i = 1, #stageTimeCfg do
        if dayTime > stageTimeCfg[i][1] and dayTime <= stageTimeCfg[i][2] then
            return i
        elseif dayTime > stageTimeCfg[i][2] then
            return i + 1
        end
    end
end

--是否有每日任务奖励
function ActivityTournamentSynModel:CheckRed_IsHasDayTaskReward()
    local model = ActivityTournamentModel:GetInstance()
    if model.taskData == nil then
        model:GetTaskData(function()
            self:UpdateRedpoint(11)
        end)
    else
        ---@type ActivityTourGuessTaskData[]
        local curStageTask = model:GetCurShowTaskData()
        if curStageTask then
            for i = 1, #curStageTask do
                if curStageTask[i]:GetState() == _G.TaskEnum.ETaskState.Completed then
                    return 1
                end
            end
        end
    end
    return 0
end

---绑定子活动
function ActivityTournamentSynModel:GetOtherActivityRedPointIds()
    return { 10005 }
end

---刷新红点
function ActivityTournamentSynModel:UpdateRedpoint(index)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(index))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ActivityTournamentSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

