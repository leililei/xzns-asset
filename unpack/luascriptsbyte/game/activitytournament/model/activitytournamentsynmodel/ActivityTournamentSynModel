function ActivityTournamentSynModel:SetTipTb(tb)
    self.MainTipTb = tb
    self.MainTipTb.aortext_tips.text = _G.GetLangPackValue(90049900091)
    ActivityTournamentModel:GetInstance():RefreshActivityBtnTips()
end

---
