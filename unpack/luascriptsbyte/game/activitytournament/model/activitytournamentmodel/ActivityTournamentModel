                    if i <= num then
                        local data = rankData.listRankDatas[num - i + 1]
                        _G.table.insert(list, data.role_info)
                    end
                end
                self.historyDetails[index] = list
                if call then
                    call(self.historyDetails[index])
                end
            end)
        else
            ActivityTournamentNet:GetInstance():GetHistoryDetails(
                { season = index },
                function(msg)
                    if msg.ack == 1 then
                        self.historyDetails[index] = msg.role
                        if call then
                            call(self.historyDetails[index])
                        end
                    end
                end
            )
        end
    end
end

