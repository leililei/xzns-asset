function ActivityTournamentModel:EnterFight(enemyHeadInfo, skipBattle)
    ActivityTournamentNet:GetInstance():Fight({ activity_id = self.curActivityClass.activityID },
        _G.handlerbind(self, self.OnFightCall, false, enemyHeadInfo, skipBattle))
end

---进入战斗回调
---@param msg arena_layer.s2c_arena_layer_fight
---@param joinType number 加入的竞技场类型
---@param isEmptyEnemy boolean 单场的战斗敌方阵容是否为空
---@param skipBattle boolean 是否跳过战斗
function ActivityTournamentModel:OnFightCall(msg, isEmptyEnemy, enemyHeadInfo, skipBattle)
    if msg.ack ~= 1 then
        self:ExitEmbattle()
        return
    end
    if msg.fight_result ~= nil then
        _G.SortList(
            msg.fight_result,
            function(a)
                return -a.index
            end
        )
        self.fight = self.fight + 1
        --_G.Events:GetInstance():Broadcast(_G.SpiritualRealmEvents.FightTimeChange)
        ActivityTournamentNet:GetInstance():FightResult({ activity_id = self.curActivityClass.activityID },
            _G.handlerbind(self, self.OnFightResultCall, msg, isEmptyEnemy, skipBattle)
        )
        _G.DelayDo(1, function()
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityTournamentBattleAnimation.Name)
            if view then
                view:SetEnd(msg)
            end
        end)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTournamentBattleAnimation.Name, enemyHeadInfo)
    end
end

---进入战斗回调
---@param msg arena_layer.s2c_arena_layer_result
---@param arena_layer_fight arena_layer.s2c_arena_layer_fight
---@param joinType number 加入的竞技场类型
---@param isEmptyEnemy boolean 单场的战斗敌方阵容是否为空
---@param skipBattle boolean 是否跳过战斗
function ActivityTournamentModel:OnFightResultCall(msg, arena_layer_fight, isEmptyEnemy, skipBattle)
    if msg.ack ~= 1 then
        self:ExitEmbattle2()
        return
    end
    self:ScoreChange(msg.args[2] - msg.args[1])
    --结算
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityTournamentSettlementView.Name)
    if view then
        local hp = arena_layer_fight.hp
        for i, v in ipairs(arena_layer_fight.fight_result) do
            v.data.cardsShow = hp[v.index].cards
            v.data.defender_cardsShow = hp[v.index].defender_cards
        end
        view:AdjustToResult(arena_layer_fight.fight_result, msg.report, msg.args)
    end
end

function ActivityTournamentModel:ScoreChange(changeScore)
    if changeScore == 0 then
        return
    else
        self.score = self.score + changeScore
        _G.Events:GetInstance():Broadcast(_G.eActivityTournament.ScoreChange)
    end
end

