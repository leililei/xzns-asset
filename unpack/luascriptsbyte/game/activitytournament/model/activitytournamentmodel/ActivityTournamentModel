                return
            end

            ---@type activity_tournament.s2c_activity_tournament_info
            self.StageData = msg
            ---@type ActivityTournamentModel.taskData[]
            self.taskData = {}
            self:RefreshTakeData(1, msg.preselect_info)
            self:RefreshTakeData(3, msg.eliminate_info)
            self:RefreshTakeData(4, msg.champion_info)
            self:RefreshTakeData(5, msg.worship_info)
            if call then
                call(msg)
            end
        end
    )
end

---@param data
function ActivityTournamentModel:RefreshTakeData(stage, data)
    if self.taskData[stage] == nil then
        self.taskData[stage] = {}
        self.taskData[stage].dict = {}
        self.taskData[stage].finish_task = {}
        if data then
            if data.task then
                for i = 1, #data.task do
                    self:CreatTaskData(data.task[i], self.taskData[stage])
                end
            end
            if data.finish_task then
                for i = 1, #data.finish_task do
                    if self.taskData[stage].dict[data.finish_task[i]] == nil then
                        local cfg = _G.ConfigManager.mission_extra_cfg[data.finish_task[i]]
                        self:CreatTaskData({
                            sid = data.finish_task[i],
                            state = _G.TaskEnum.ETaskState.Submited,
                            target = {
                                cfg.count
                            }
                        }, self.taskData[stage])
                    end
                    self.taskData[stage].finish_task[data.finish_task[i]] = true
                end
            end
        end
    else
        if data then
            if data.task then
                for i = 1, #data.task do
                    if self.taskData[stage].dict[data.task[i].sid] then
                        self.taskData[stage].dict[data.task[i].sid]:ParseData(data.task[i])
                    else
                        self:CreatTaskData(data.task[i], self.taskData[stage])
                    end
                end
            end
            if data.finish_task then
                for i = 1, #data.finish_task do
                    local cfg = _G.ConfigManager.mission_cfg[data.finish_task[i]]
                    self:CreatTaskData({
                        sid = data.finish_task[i],
                        state = _G.TaskEnum.ETaskState.Submited,
                        target = {
                            cfg.count
                        }
                    }, self.taskData[stage])
                    self.taskData[stage].finish_task[data.finish_task[i]] = true
                end
            end
        end
    end
end

