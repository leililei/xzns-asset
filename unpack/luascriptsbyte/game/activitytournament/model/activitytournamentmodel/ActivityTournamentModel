---自身活动代币增加
function ActivityTournamentModel:SetCoin(coins)
    if coins then
        for k, v in pairs(coins) do
            if self.coins[k] then
                self.coins[k] = self.coins[k] + v
                if k == 74 and v > 0 then
                    self.hisCoinNum = self.hisCoinNum + v
                end
                local tmp = {}
                _G.table.insert(tmp, k)
                _G.table.insert(tmp, v)
                _G.table.insert(tmp, self.coins[k])
                _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, { { type = tmp } })
            end
        end
    end
end

function ActivityTournamentModel:AddCoins(data)
    if self.coins and self.coins[data[1]] then
        local coin = {}
        coin[data[1]] = data[2]
        self:SetCoin(coin)
    end
end

