---挑战
function ActivityTournamentModel:Fight(arena_layer_enemy_array, arena_layer_match, skipBattle)
    local teamNum = self:GetCurTeamNum()
    local embattleTypeName = self:GetCurEmbattleTypeName()
    --打开调整界面
    local embattleDatas = {}
    for tnIndex = 1, teamNum do
        ---@type EmbattleType
        local embattleType = _G.EmbattleType[embattleTypeName .. tnIndex]
        table.insert(embattleDatas, require("EmbattleModel"):GetInstance():GetEmbattleData(embattleType))
    end

    for i = 1, #embattleDatas do
        for j = 1, #embattleDatas[i] do
            if embattleDatas[i][j] > 0 then
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, embattleDatas[i][j])
                if card then
                    embattleDatas[i][j] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        power = card:GetPower(),
                        soulLink_IsActivate = card.soulLink_IsActivate,
                        open_inborn = card.open_inborn,
                        tag = 0
                    }
                else
                    embattleDatas[i][j] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        power = 0,
                        soulLink_IsActivate = 0,
                        open_inborn = 0,
                        tag = 0
                    }
                end
            else
                embattleDatas[i][j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    soulLink_IsActivate = 0,
                    open_inborn = 0,
                    tag = 0
                }
            end
        end
    end

    local datas = {}
    if arena_layer_enemy_array.arrays ~= nil then
        for m = 1, #arena_layer_enemy_array.arrays do
            local data = { false }
            datas[m] = data
            local emptyTag = true
            local teams = arena_layer_enemy_array.arrays[m]
            if teams.team then
                for i = 1, #teams.team do
                    data[i] = {
                        uid = teams.team[i].sid,
                        sid = teams.team[i].sid,
                        level = teams.team[i].level or 0,
                        star = teams.team[i].star or 0,
                        power = teams.team[i].power,
                        soulLink_lv = teams.team[i].soul_lv or 0,
                        soulLink_IsActivate = teams.team[i].soul_state or 0,
                        artifact = teams.team[i].artifact or {},
                        open_inborn = teams.team[i].born_skill_num or 0
                    }
                    if emptyTag and teams.team[i].sid > 0 then
                        emptyTag = false
                    end
                end
            end
            if teams.power then
                data.power = teams.power
            end
        end
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ActivityTournamentSettlementView.Name,
        nil,
        3,
        arena_layer_match,
        embattleDatas,
        datas
    )
end

