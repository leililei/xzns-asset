function ActivityTournamentModel:GetHistoryDetails(index, call)
    if self.historyDetails[index] ~= nil then
        if call then
            call(self.historyDetails[index])
        end
    else
        if index == self.season and self.stage < 5 then
            local model = require("RecordRankModel"):GetInstance()
            local RankUtils = require("RankUtils")
            model = require("RecordRankModel"):GetInstance()
            model:GetListInfo(RankUtils.RankType.CrossServiceCompAlliance, function()
                local rankData = model:GetRankData(RankUtils.RankType.CrossServiceCompAlliance)
                local list = {}
