end

function ActivityTournamentModel:OnReplayReportCall(msg, data, round, index)
    if msg.ack ~= 1 then
        return
    end
    if #msg.data > 1 then
        local timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]][1]
        local showNum = (self.stage ~= 5 and self.round == round and self.roundIndex == index) and math.floor((_G.TimeUtil.GetSecondsOfDay() - timeKey) / self.timeLogCache) or #msg.data
        local fightArgs = {}

        local hp = msg.hp
        for k, v in ipairs(msg.data) do
            v.cardsShow = hp[k].cards
            v.defender_cardsShow = hp[k].defender_cards
            _G.table.insert(fightArgs,
                { data = v, index = k, winner = (v.winner and v.winner[1]) and 1 or 0, playbackUid = data.playback_uid })
            if k >= showNum then
                break
            end
        end
        local hide = showNum < #msg.data and true or nil
        local PlayerHeadInfo = {}
        PlayerHeadInfo.level = _G.PlayerModel:GetInstance():GetLevel()
        PlayerHeadInfo.name = _G.PlayerModel:GetInstance():GetName()
        PlayerHeadInfo.frame = _G.PlayerModel:GetInstance():GetCurFrame()
        PlayerHeadInfo.style = _G.PlayerModel:GetInstance():GetRoleStyle()
        local leftRole = data.left and data.left or (data.report_type == 0 and PlayerHeadInfo or data.role)
        local rightRole = data.right and data.right or (data.report_type == 0 and data.role or PlayerHeadInfo)
        ---@type ActivityTournamentSettlementView
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ActivityTournamentSettlementView.Name,
            nil,
            2,
            fightArgs,
            rightRole,
            leftRole,
            hide
        )
    end
end

