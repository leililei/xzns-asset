---解析简要信息
---@param msg activity_dispatch.i_activity_dispatch_brief
function ActivityTournamentModel:ParseSimpleData(msg, activity)
    self.stage = msg.stage
    if self.stage == 0 then
        self.stage = 1
    end
    self.stageEndTime = msg.end_time
    self.season = msg.season
    self.coins = {}
    self.GroupInfo = {}
    self.historyDetails = {}
    local list = { msg.cfg.coin }
    for i, v in ipairs(list) do
        self.coins[v] = 0
    end
    if msg.coins then
        for i, v in ipairs(msg.coins) do
            self.coins[v.key] = v.value
        end
    end
    ---@type activity_tournament.activity_tournament_cfg
    self.cfg = msg.cfg
    if self.stage == 5 then
        self:GetHistoryDetails(self.season)
    end
    self:ParseData(msg)
    if activity ~= nil then
        ---@type ActivityTournamentSynModel
        self.curActivityClass = activity
    else
        _G.Events:GetInstance():Broadcast(_G.eActivityTournament.StageChange)
        --self.curActivityClass.typeClass:UpdateRedpoint(2)
    end
    self.rankAwardCfg = msg.cfg.rank_award_cfg
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.stage < 5 then
        self:SetTimer()
    end
    if self.stage == 5 then
        ActivityTournamentNet:GetInstance():GetStageInfo({ activity_id = self.curActivityClass.activityID, stage = 4 }, _G.handlerbind(self, self.ParseData))
    end
    if self.stage == 4 or self.stage == 5 then
        ActivityTournamentNet:GetInstance():GetStageInfo({ activity_id = self.curActivityClass.activityID, stage = 3 }, function(msg)
            if msg.eliminate_info.self_round ~= 0 then
                self.group_index = msg.eliminate_info.group_index
            end
        end)
    end
    if self.stage > 1 then
        self:SetTimer2()
    end
    self.curActivityClass.typeClass:UpdateRedpoint(2)
    self.curActivityClass.typeClass:UpdateRedpoint(3)
end

---解析详细信息
---@param msg activity_tournament.activity_tournament_preselect
function ActivityTournamentModel:ParseData(msg)
    if msg.preselect_info then
        self.score = msg.preselect_info.score
        self.fight = msg.preselect_info.count
        if not require "EmbattleModel":GetInstance():CheckEmbattleData(msg.preselect_info.garrays[1].id) then
            require "EmbattleModel":GetInstance():ParseData(msg.preselect_info.garrays or {})
        end
    end
    if msg.eliminate_info then
        self.round = msg.eliminate_info.round
        self.roundIndex = math.ceil(((_G.TimeUtil.GetServerUnixTime() - (self.stageEndTime - self.cfg.eliminate_time)) / 86400))
        self.branch_state = msg.eliminate_info.branch_state
        self.fight_time = msg.eliminate_info.start_time
        self.self_round = msg.eliminate_info.self_round
        if self.self_round ~= 0 then
            self.group_index = msg.eliminate_info.group_index
        end
        self.day_guess_state = msg.eliminate_info.day_guess_state
        self.rank_award_state = msg.eliminate_info.rank_award_state
        self.guess_num = msg.eliminate_info.guess_num
        self:SetGroupInfo(msg.eliminate_info.group_info, 1, msg.eliminate_info.group_info.group_index)
    end
    if msg.champion_info then
        self.round = msg.champion_info.round
        self.roundIndex = math.ceil(((_G.TimeUtil.GetServerUnixTime() - (self.stageEndTime - self.cfg.champion_time)) / 86400))
        self.branch_state = msg.champion_info.branch_state
        self.fight_time = msg.champion_info.start_time
        self.self_round = msg.champion_info.self_round
        self.day_guess_state = msg.champion_info.day_guess_state
        self.rank_award_state = msg.champion_info.rank_award_state
        self.predict = msg.champion_info.predict
        self.predict_state = msg.champion_info.predict_state
        self:SetGroupInfo(msg.champion_info.group_info, 2, msg.champion_info.group_info.group_index)
    end
    if self.stage == 5 then
        self.round = 2
        self.roundIndex = 3
    end
    if msg.worship_info then
        self.predict = msg.worship_info.predict
        self.predict_state = msg.worship_info.predict_state
        self.worship_award_state = msg.worship_info.award_state
        self.worship_award = msg.worship_info.award
    end
end

---赛程数据
---@protected
function ActivityTournamentModel:SetGroupInfo(data, type, index)
    local timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]][2]
    if self.GroupInfo[type] == nil then
        self.GroupInfo[type] = {}
    end
    if self.GroupInfo[type][index] == nil then
        self.GroupInfo[type][index] = {}
    end
    if data == nil or data.competitor == nil or #data.competitor == 0 then
        return
    end
    local list = self.GroupInfo[type][data.group_index]
    for k, v in ipairs(data.competitor) do
        list[v.index] = { role_info = v.role_info }
        if v.result then
            for k2, v2 in ipairs(v.result) do
                if type == v2.round then
                    local isHide = (self.stage == 3 or self.stage == 4) and (_G.TimeUtil.GetSecondsOfDay() < timeKey) and v2.round == self.round and v2.index == self.roundIndex
                    --if v2.index == v.group_round then
                    --    if (_G.TimeUtil.GetSecondsOfDay() < timeKey) and v2.round == self.round and v2.index == self.roundIndex then
                    --    else
                    --        list[v.index].result = v2
                    --    end
                    --end
                    if v2.result == 1 then
                        local add = roundIndex[v.index][v2.index]
                        local index = 0
                        if v2.index == 1 then
                            index = 8 + add
                        elseif v2.index == 2 then
                            index = 12 + add
                        elseif v2.index == 3 then
                            index = 15
                        end
                        if isHide == true then
                        else
                            if list[index] == nil then
                                list[index] = { role_info = v.role_info }
                            end
                        end
                    end
                    if v2.index == 1 then
                        if isHide == true then
                        else
                            list[v.index].result = v2
                        end
                    else
                        if isHide == true then
                        else
                            local curIndex = v2.index - 1
                            local add = roundIndex[v.index][curIndex]
                            local index = 0
                            if curIndex == 1 then
                                index = 8 + add
                            elseif curIndex == 2 then
                                index = 12 + add
                            elseif curIndex == 3 then
                                index = 15
                            end
                            if list[index] == nil then
                                list[index] = { role_info = v.role_info }
                            end
                            list[index].result = v2
                        end
                    end
                end
            end
        end
    end
end

