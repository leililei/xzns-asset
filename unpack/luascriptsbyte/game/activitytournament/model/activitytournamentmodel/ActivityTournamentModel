function ActivityTournamentModel:GetRankAwardCfgIdScope()
    local Scope = {
        min = math.maxinteger,
        max = 0,
    }
    local count = #self.cfg.rank_info
    for i = 1, count do
        local id = self.cfg.rank_info[i]
        if id > Scope.max then
            Scope.max = id
        end
        if id < Scope.min then
            Scope.min = id
        end
    end
    return Scope
end

