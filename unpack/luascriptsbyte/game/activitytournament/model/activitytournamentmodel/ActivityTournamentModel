---检测能否进入匹配界面
function ActivityTournamentModel:CheckEnterMatch()
    ---@type EmbattleType[]
    local tb = {}
    local teamNum = self:GetCurTeamNum()
    local embattleTypeName = self:GetCurEmbattleTypeName()
    for tnIndex = 1, teamNum do
        table.insert(tb, _G.EmbattleType[embattleTypeName .. tnIndex])
    end
    for i = 1, #tb do
        local data = require("EmbattleModel"):GetInstance():GetEmbattleData(tb[i])
        local canMatch = false
        for j = 1, #data do
            if data[j] > 0 then
                canMatch = true
                break
            end
        end
        if not canMatch then
            return false, i
        end
    end
    return true
end

