--完成任务
function ActivityTournamentModel:CompTask(task_sid, finish_type, call)
    ActivityTournamentNet:GetInstance():GetTaskRewards(
        {
            activity_id = self.curActivityClass.activityID,
            task_sid = task_sid,
            finish_type = finish_type,
        },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            --_G.StorageManager:GetInstance():ReceiveAwardData(msg)
            --if msg.award then
            --    local value= msg.award.item[1]
            --    self:SetCoin({[value.type[3]] = value.type[4]})
            --end
            if self.taskData then
                for i = 1, #task_sid do
                    local sid = task_sid[i]
                    local taskData = self.taskData[self.stage]
                    if taskData.dict[sid] then
                        local data = taskData.dict[sid]
                        data.i_task.target[1] = data.Cfg.count
                        data.i_task.state = _G.TaskEnum.ETaskState.Submited
                    end
                    if taskData.finish_task then
                        taskData.finish_task[sid] = true
                    end
                end
            end

            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            if call then
                call(msg)
            end
        end
    )
end

