function ActivityTournamentModel:CheckChampionGuess()
    local timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]][2]
    if self.stage == 4 then
        if self.predict == 0 and self.roundIndex == 1 and _G.TimeUtil.GetSecondsOfDay() < timeKey then
            return true
        end
    end
    if (self.stage == 4 and self.roundIndex == 3 and _G.TimeUtil.GetSecondsOfDay() >= timeKey) or self.stage == 5 then
        if self.predict ~= nil and self.predict ~= 0 and self.predict_state == 0 then
            return true
        end
    end
    return false
end

