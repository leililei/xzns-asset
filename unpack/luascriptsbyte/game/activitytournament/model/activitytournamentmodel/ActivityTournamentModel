function ActivityTournamentModel:GetGuessData(call, rounds)
    if self.isGetDataIng and self.isGetDataIng == true then
        if self.GetDataCall == nil then
            self.GetDataCall = {}
        end
        table.insert(self.GetDataCall, call)
        return
    end
    local msg = {
        activity_id = self.curActivityClass.activityID,
        round = {  }
    }
    for i = 1, self.round do
        _G.table.insert(msg.round, i)
    end
    if rounds then
        msg.round = rounds
    end

    self.isGetDataIng = true
    ActivityTournamentNet:GetInstance():GetGuessData(
        msg,
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            ---@type activity_tournament.s2c_activity_tournament_guess_list
            self.GuessData = msg
            if call then
                call(msg)
            end
            if self.GetDataCall then
                for i = 1, #self.GetDataCall do
                    self.GetDataCall[i](msg)
                end
                self.GetDataCall = nil
            end
            self.isGetDataIng = false
        end
    )
end

