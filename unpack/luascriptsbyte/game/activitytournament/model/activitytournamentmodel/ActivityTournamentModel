function ActivityTournamentModel:GetGuessWinCount(back)
    local role_dict = {}
    local winCount = 0
    for i = 1, #self.GuessData.guess_role do
        local data = self.GuessData.guess_role[i]
        if role_dict[i] == nil then
            role_dict[i] = {}
        end
        if data.info then
            for j = 1, #data.info do
                role_dict[i][data.info[j].target] = true
            end
        end
    end

    if self.round == 2 then
        self:GetGroupInfo(2, 1, function(data)
            local roleData = data
            for i = 1, #self.GuessData.guess_pub do
                local data = self.GuessData.guess_pub[i]
                if role_dict[i] and data.info and data.round == 1 then
                    if data.info.result == 1 and data.info.left and role_dict[i][data.info.left.uid] then
                        winCount = winCount + 1
                    elseif data.info.result == 2 and data.info.right and role_dict[i][data.info.right.uid] then
                        winCount = winCount + 1
                    end
                end
            end

            for i = 1, self.roundIndex do
                --当前轮次
                local curRound = i
                local starId, endId, groupCount = self:GetTeamScope(curRound)
                --队伍数据
                local roleRoundData = {}
                for j = 1, groupCount do
                    roleRoundData[j] = {
                        left = roleData[starId + (j - 1) * 2],
                        right = roleData[starId + (j - 1) * 2 + 1],
                    }
                end
                role_dict = {}
                if self.GuessData and self.GuessData.guess_role then
                    for j = 1, #self.GuessData.guess_role do
                        local guess_role = self.GuessData.guess_role[j]
                        if guess_role.index == curRound and guess_role.info and guess_role.info[1] and guess_role.round == 2 then
                            local uid = guess_role.info[1].target
                            role_dict[uid] = true
                        end
                    end
                end
                for j = 1, groupCount do
                    local leftRoleData = self:GetRoleData(roleRoundData, j, true)
                    local RightRoleData = self:GetRoleData(roleRoundData, j, false)
                    local leftUid = leftRoleData and leftRoleData.uid or nil
                    local rightUid = RightRoleData and RightRoleData.uid or nil
                    if role_dict[leftUid] then
                        if self:GetIsWin(roleRoundData, j, true) then
                            winCount = winCount + 1
                        end
                    elseif role_dict[rightUid] then
                        if self:GetIsWin(roleRoundData, j, false) then
                            winCount = winCount + 1
                        end
                    end
                end
            end
            if back then
                back(winCount)
            end
        end)
    else
        for i = 1, #self.GuessData.guess_pub do
            local data = self.GuessData.guess_pub[i]
            if role_dict[i] and data.info then
                if data.info.result == 1 and data.info.left and role_dict[i][data.info.left.uid] then
                    winCount = winCount + 1
                elseif data.info.result == 2 and data.info.right and role_dict[i][data.info.right.uid] then
                    winCount = winCount + 1
                end
            end
        end
        if back then
            back(winCount)
        end
    end
end

function ActivityTournamentModel:GetTeamScope(roundIndex)
    if roundIndex == 1 then
        return 1, 8, 4
    elseif roundIndex == 2 then
        return 9, 12, 2
    elseif roundIndex == 3 then
        return 13, 14, 1
    end
end

function ActivityTournamentModel:GetIsWin(data, curSelectRound, isleft)
    ---@type activity_tournament.tournament_competitor_result
    local leftData = data[curSelectRound].left.result
    local rightData = data[curSelectRound].right.result
    if isleft then
        if leftData then
            return leftData.result == 1
        end
        return false
    else
        if rightData then
            return rightData.result == 1
        end
        return false
    end
end

---@return role.i_role
function ActivityTournamentModel:GetRoleData(data, curSelectRound, isleft)
    if self.round == 2 then
        local leftData = data[curSelectRound].left.role_info
        local rightData = data[curSelectRound].right.role_info
        if isleft then
            return leftData
        else
            return rightData
        end
    else
        local guess_pub = self.GuessData.guess_pub[curSelectRound]
        local leftData = guess_pub.info.left
        local rightData = guess_pub.info.right
        if isleft then
            return leftData
        else
            return rightData
        end
    end
end

