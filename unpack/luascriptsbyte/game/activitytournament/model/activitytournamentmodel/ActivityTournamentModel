---@protected
function ActivityTournamentModel:SetTimer()
    if not self.timer then
        if self.stageEndTime > _G.TimeUtil.GetServerUnixTime() then
            self.timer = _G.TimerManager:GetInstance():GetTimer(self.stageEndTime - _G.TimeUtil.GetServerUnixTime(), self.ChangeStage, self, true, false, true)
            self.timer:Start()
        end
    end
end

---
---@protected
function ActivityTournamentModel:SetTimer2()
    local timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]]
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    if not self.timer2 and curTime < timeKey[2] then
        local delayTime
        if curTime < timeKey[1] then
            delayTime = timeKey[1] - curTime
        else
            delayTime = timeKey[2] - curTime
        end
        self.timer2 = _G.TimerManager:GetInstance():GetTimer(delayTime, self.ChangeStage2, self, true, false, true)
        self.timer2:Start()
    end
end

---阶段转换
function ActivityTournamentModel:ChangeStage()
    require "ActivitySynNet":GetInstance():InitActivity(self.curActivityClass.activityID, function(msg)
        self:ParseSimpleData(msg.activity[1].self_info.activity_tournament_brief)
    end)
end

---阶段转换
function ActivityTournamentModel:ChangeStage2()
    if self.timer2 then
        self.timer2:Stop()
        self.timer2 = nil
    end
    local timeKey = _G.ConfigManager.discrete_cfg[138008][#_G.ConfigManager.discrete_cfg[138008]]
    local curTime = _G.TimeUtil.GetSecondsOfDay()
    if self.stage == 5 then
        if curTime >= timeKey[2] then
            if self.worship_award == nil then
                self.worship_award = {}
                self.curActivityClass.typeClass:UpdateRedpoint(4)
                self.curActivityClass.typeClass:UpdateRedpoint(5)
                self.curActivityClass.typeClass:UpdateRedpoint(6)
            end
        end
    elseif self.stage == 3 or self.stage == 4 then
        if curTime >= timeKey[2] then
            local type = self.stage == 3 and 1 or 2
            self.GroupInfo[type] = nil
            _G.Events:GetInstance():Broadcast(_G.eActivityTournament.GroupInfoChange)
        end
        self:RefreshActivityBtnTips()
    end
    if curTime < timeKey[2] then
        self:SetTimer2()
    end
end

