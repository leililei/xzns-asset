local RankUtils = require("RankUtils")

---@class ActivityTourGuessRecordItem:LuaUIItem
---@field private go_table ActivityTourGuessRecordView._obj_item_GoTable GoTable
local ActivityTourGuessRecordItem = BaseClass("ActivityTourGuessRecordItem")

---__init构造函数
---@protect
function ActivityTourGuessRecordItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))
    if self.go_table.obj_currency then
        ---@type ActivityTourGuessRecordView._obj_currency_GoTable
        self.Obj_currency = GetAutoGoTable(self.go_table.obj_currency)
    end
    ---@type _obj_HeadItemBase_GoTable[]
    self.heroNodes = {}
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function ActivityTourGuessRecordItem:OnClickBtn(go, isOn)

end

---@param data ActivityTourGuessRecordView.showData
function ActivityTourGuessRecordItem:RefreshItem(data,round,roleDict,guessRoleDict)
    self.data = data
    self.roleDict = roleDict
    self.guessRoleDict = guessRoleDict
    if round == 2 then
        self.go_table.aortext_group.text = self:GetName2(data.index)
    else
        self.go_table.aortext_group.text = self:GetName(data.index)
    end
    if self.data.isLeft then
        self.go_table.obj_guessl:SetActiveE(1)
        self.go_table.obj_guessr:SetActiveE(0)
    else
        self.go_table.obj_guessl:SetActiveE(0)
        self.go_table.obj_guessr:SetActiveE(1)
    end
    ---@type  _obj_item._obj_userInfoL_GoTable
    local leftGotable = GetAutoGoTable(self.go_table.obj_userInfoL)
    if data.left then
        self.go_table.obj_userInfoL.transform:SetActiveE(1)
        self.heroNodes[1] = self:RefreshRoleNode(leftGotable,data.left)
    else
        self.go_table.obj_userInfoL.transform:SetActiveE(0)
        leftGotable.aortext_name = ""
        leftGotable.aortext_power = ""
    end
    ---@type  _obj_item._obj_userInfoL_GoTable
    local rightGotable = GetAutoGoTable(self.go_table.obj_userInfoR)
    if data.right then
        self.go_table.obj_userInfoR.transform:SetActiveE(1)
        self.heroNodes[2] =self:RefreshRoleNode(rightGotable,data.right)
    else
        self.go_table.obj_userInfoR.transform:SetActiveE(0)
        rightGotable.aortext_name = ""
        rightGotable.aortext_power = ""
    end

    if self.data.isBattleEnd then
        self.Obj_currency.transform:SetActiveE(1)
        self.go_table.aortext_results:SetActiveE(1)
        self.coinData = StorageManager:GetInstance():GetStorageItemData(191)
        self.Obj_currency.aorrawimage_icon:LoadImage(self.coinData.Icon)
        if (self.data.isLeft and self.data.isLeftWin) or (self.data.isLeft == false and self.data.isLeftWin == false) then
            self.go_table.aortext_results.text = GetLangPackValue(90049900085) .. GetLangPackValue(90021800510)
        else
            local strg = GetLangPackValue(90049900085) .. GetLangPackValue(90021800511)
            self.go_table.aortext_results.text =  strg:AddColor("cccccc")
        end
        if data.left and self.data.isLeftWin == false then
            self:HeroItemBaseGray(self.heroNodes[1],true)
        else
            self:HeroItemBaseGray(self.heroNodes[1],false)
        end
        if data.right and self.data.isLeftWin then
            self:HeroItemBaseGray(self.heroNodes[2],true)
        else
            self:HeroItemBaseGray(self.heroNodes[2],false)
        end
        if self.data.isLeftWin then
            self.go_table.aortext_leftBattleWin:SetActiveE(1)
            self.go_table.aortext_rleftBattleFail:SetActiveE(0)
            self.go_table.aortext_rightBattleWin:SetActiveE(0)
            self.go_table.aortext_rightBattleFail:SetActiveE(1)
        else
            self.go_table.aortext_leftBattleWin:SetActiveE(0)
            self.go_table.aortext_rleftBattleFail:SetActiveE(1)
            self.go_table.aortext_rightBattleWin:SetActiveE(1)
            self.go_table.aortext_rightBattleFail:SetActiveE(0)
        end
        self.Obj_currency.aortext_num.text = self.data.numberBets // 1
        if self.data.numberBets < 0 then
            self.Obj_currency.aortext_num.text = tostring(self.data.numberBets // 1):AddColor("cccccc")
        else
            self.Obj_currency.aortext_num.text = self.data.numberBets // 1
        end
        if self.data.score[1] == 0 and self.data.score[2] == 0 then
            self.go_table.aortext_score:SetActiveE(0)
        else
            self.go_table.aortext_score:SetActiveE(1)
            self.go_table.aortext_score.text = self.data.score[1] .. ":" .. self.data.score[2]
        end
    else
        self.Obj_currency.transform:SetActiveE(0)
        self.go_table.aortext_results:SetActiveE(0)
        self.go_table.aortext_leftBattleWin:SetActiveE(0)
        self.go_table.aortext_rleftBattleFail:SetActiveE(0)
        self.go_table.aortext_rightBattleWin:SetActiveE(0)
        self.go_table.aortext_rightBattleFail:SetActiveE(0)
        self.go_table.aortext_score:SetActiveE(0)
    end
    local leftB = self.data.left_num/(self.data.left_num+ self.data.right_num)
    local rightB = self.data.right_num/(self.data.left_num+ self.data.right_num)
    self.go_table.aortext_leftRatio.text = (leftB * 100) // 1 .. "%"
    self.go_table.aortext_rightRatio.text = (rightB * 100) // 1 .. "%"
    self.go_table.aorimage_progLeft.fillAmount = tonumber(leftB)
    self.go_table.aorimage_progRight.fillAmount = tonumber(rightB)
end

---@param node _obj_HeadItemBase_GoTable
function ActivityTourGuessRecordItem:HeroItemBaseGray(node,isgray)
    node.aorimage_iconBg:SetGray(isgray)
    node.aorimage_portrait:SetGray(isgray)
end

