function ActivityTourGuessRecordItem:GetName2(roundIndex)
    if roundIndex == 1 then
        return GetLangPackValue(90049900013)
    elseif roundIndex == 2 then
        return GetLangPackValue(90049900012)
    elseif roundIndex == 3 then
        return GetLangPackValue(90049900011)
    end
    return ""
end

function ActivityTourGuessRecordItem:GetName(index)
    if index == 1 then
        return GetLangPackValue(90049900016)
    elseif index == 2 then
        return GetLangPackValue(90049900015)
    elseif index == 3 then
        return GetLangPackValue(90049900014)
    elseif index == 4 then
        return GetLangPackValue(90049900013)
    elseif index == 5 then
        return GetLangPackValue(90049900012)
    elseif index == 6 then
        return GetLangPackValue(90049900011)
    end
    return ""
end

