---@class ActivityTourGuessTaskItem:LuaUIItem
---@field private go_table ActiveTaskView_ListItem_GoTable GoTable
local ActivityTourGuessTaskItem = BaseClass("ActivityTourGuessTaskItem")

---__init构造函数
---@protect
function ActivityTourGuessTaskItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))
    self.CaCheLoadAwardList = {}
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function ActivityTourGuessTaskItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_get then
        if self.callback then
            self.callback(self.data)
        end
    end
end

---@param data ActivityTourGuessTaskData
function ActivityTourGuessTaskItem:RefreshItem(data,callback)
    self.data = data
    self.callback = callback

    ---@type mission_extra_cfg
    local cfg = data.Cfg
    self.go_table.aortext_info.text = GetLangPackValue(cfg.desc)
    local compCount = data.i_task.target[1]
    self.go_table.aorimage_jd.fillAmount = compCount/cfg.count
    self.go_table.aortext_jd.text = string.format("%s/%s",compCount,cfg.count)
    self.go_table.aortext_hzExp.text = 1
    local state = data:GetState()
    self.go_table.aorimage_get:SetGray(false)
    local gray_show = false
    if state == TaskEnum.ETaskState.Completed then
        self.go_table.aortext_text.text = GetLangPackValue(90000000122)
    elseif state == TaskEnum.ETaskState.Claimed then
        self.go_table.aortext_text.text = GetLangPackValue(90022500355)
        self.go_table.aorimage_get:SetGray(true)
        gray_show = true
    else
        self.go_table.aortext_text.text = GetLangPackValue(92010300021)
    end
    self.go_table.obj_items:ClearChildren()
    for key, value in pairs(cfg.reward) do
        self:CareatItem(value, gray_show, self.go_table.obj_items)
    end
end

function ActivityTourGuessTaskItem:CareatItem(data, isGou, Parent, backCall)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]
    local id = Parent:GetInstanceID()
    if self.CaCheLoadAwardList[id] then
        if self.CaCheLoadAwardList[id][Sid] then
            return
        end
    else
        self.CaCheLoadAwardList[id] = {}
    end
    self.CaCheLoadAwardList[id][Sid] = true
        -- body
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                if _G.IsNil(Parent) then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                self.CaCheLoadAwardList[id][Sid] = false
                item.gameObject:SetLocalScaleXYZ(0.8)
                item.gameObject:SetActiveE(1)
                item:SetPri(data.isPri)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                if backCall then
                    backCall(item)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
    )
end
    --end

---@return ActivityTourGuessTaskItem
return ActivityTourGuessTaskItem