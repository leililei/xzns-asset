---@class ActivityTourGuessRoleItem:LuaUIItem
---@field private go_table ActivityTournamentGuessView._obj_roleNodel_GoTable GoTable
local ActivityTourGuessRoleItem = BaseClass("ActivityTourGuessRoleItem")

---__init构造函数
---@protect
function ActivityTourGuessRoleItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))
    self.loadSpineObj = nil
    self.loadSpinePath = nil
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function ActivityTourGuessRoleItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_onlick then
        _G.SystemSettingManager:GetInstance():OpenView(self.data.uid)
    end
end

---@param data role.i_role
function ActivityTourGuessRoleItem:RefreshItem(data,isShowResults,isWin)
    self.data = data
    if data == nil then
        self.go_table.transform:SetActiveE(0)
        return
    else
        self.go_table.transform:SetActiveE(1)
    end
    local cfg = require "CardCommentManager":GetInstance():CardData(data.city_style_id, false)
    if cfg.ModelPathHi ~= self.loadSpinePath then
        self.loadSpinePath = cfg.ModelPathHi
        self.go_table.obj_spineNode:RemoveAllChildren()
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_spineNode,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                --trans:SetParentE(self.go_table.obj_spineNode)
                trans:SetLocalPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(cfg.size4)
            end
        )
    end

    if data.title and data.title.sid and data.title.sid > 0 then
        local title = data.title.sid
        local titleScale = 1
        local player_title = _G.ConfigManager.player_title_effect_cfg[title]
        if player_title.type_title == 1 then
            self.go_table.aorrawimage_title:LoadImage(player_title.title)
            self.go_table.aorrawimage_title:SetActiveE(1)
            self.go_table.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
            self.go_table.obj_titleEffect:ClearChildren()
            self.title = nil
        elseif player_title.type_title == 2 then
            if self.go_table.title ~= player_title.title then
                self.go_table.obj_titleEffect:ClearChildren()
                self.go_table.title = player_title.title
                UIUtils.LoadEffectTitleOrFrame(
                        player_title.title,
                        self.go_table.obj_titleEffect,
                        function(trans)
                            if self.title ~= player_title.title then
                                trans:DestroyObject()
                                return
                            end
                            local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                            parClip.NeedCheck = true
                            parClip.CheckCount = 10
                            parClip.CheckOne = 3
                            trans:SetLocalScaleXYZ(titleScale)
                        end
                )
            end
            self.go_table.aorrawimage_title:SetActiveE(0)
        end
    else
        self.go_table.obj_titleNode:SetActiveE(0)
        self.go_table.obj_titleEffect:ClearChildren()
        self.title = nil
    end


    self.go_table.aortext_name.text = data.name
    if isShowResults then
        self.go_table.aortext_win:SetActiveE(isWin and 1 or 0)
        self.go_table.aortext_failure:SetActiveE(isWin and 0 or 1)
    else
        self.go_table.aortext_win:SetActiveE(0)
        self.go_table.aortext_failure:SetActiveE(0)
    end

end

---@return ActivityTourGuessRoleItem
return ActivityTourGuessRoleItem