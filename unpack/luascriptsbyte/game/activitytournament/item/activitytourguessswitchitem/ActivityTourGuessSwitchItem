local ActivityTourGuessRecordItem = require("ActivityTourGuessRecordItem")
local RankUtils = require("RankUtils")

---@class ActivityTourGuessSwitchItem:LuaUIItem
---@field private go_table ActivityTourGuessSwitchView._obj_item_GoTable GoTable
local ActivityTourGuessSwitchItem = BaseClass("ActivityTourGuessSwitchItem",ActivityTourGuessRecordItem)

---__init构造函数
---@protect
function ActivityTourGuessSwitchItem:__init(cardRoot)
    self.root = cardRoot
    self.go_table = _G.GetAutoGoTable(self.root, handler(self, self.OnClickBtn))
end

---OnClickBtn 点击按钮
---@param go table
---@param isOn boolean
---@protect
function ActivityTourGuessSwitchItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_onlick then
        --选中组
        if self.selectBack then
            self.selectBack(self.group)
        end
    end
end

function ActivityTourGuessSwitchItem:RefreshItem(data,round,roundIndex,group,roleDict,selectBack,guessRoleDict)
    self.data = data
    self.roleDict = roleDict
    self.selectBack = selectBack
    self.group = group
    self.round = round
    self.roundIndex = roundIndex
    self.guessRoleDict = guessRoleDict

    if round == 1 then
        self.go_table.aortext_group.text = self:GetName(roundIndex)
    elseif round == 2 then
        self.go_table.aortext_group.text = self:GetName2(roundIndex)
    end
    --if guessRoleDict[data.left.uid] or guessRoleDict[data.right.uid]then
    --    self.go_table.obj_haveGuess:SetActiveE(1)
    --else
    --    self.go_table.obj_haveGuess:SetActiveE(0)
    --end
    if data.left == nil then
        self.go_table.obj_userInfoL:SetActiveE(0)
    else
        self.go_table.obj_userInfoL:SetActiveE(1)
        self:RefreshRoleNode(GetAutoGoTable(self.go_table.obj_userInfoL),data.left)
    end
    if data.right == nil then
        self.go_table.obj_userInfoR:SetActiveE(0)
    else
        self.go_table.obj_userInfoR:SetActiveE(1)
        self:RefreshRoleNode(GetAutoGoTable(self.go_table.obj_userInfoR),data.right)
    end
end

function ActivityTourGuessSwitchItem:GetName2(roundIndex)
    if roundIndex == 1 then
        return GetLangPackValue(90049900013)
    elseif roundIndex == 2 then
        return GetLangPackValue(90049900012)
    elseif roundIndex == 3 then
        return GetLangPackValue(90049900011)
    end
end

---@param node _obj_item._obj_userInfoL_GoTable
function ActivityTourGuessSwitchItem:RefreshRoleNode(node,data)
    local roleData = {}
    roleData =  RankUtils.i_record_rankToi_role(data)
    _G.UIUtils.SetPlayerHeadItemNew(node.obj_HeadItemBase,
            data
    , 0.6, true, true, true)
    node.aortext_name.text = roleData.name
    node.aortext_server.text = _G.ServerManager:GetInstance():GetServerNameByServerID(roleData.server_id)
    node.aortext_power.text = roleData.point or roleData.power
    node.obj_haveGuess:SetActiveE(self.guessRoleDict[data.uid] and 1 or 0)
end

---@return ActivityTourGuessSwitchItem
return ActivityTourGuessSwitchItem