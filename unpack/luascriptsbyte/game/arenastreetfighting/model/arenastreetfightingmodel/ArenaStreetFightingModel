local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class ArenaStreetFightingModel : ActivitySynTypeBase
---@field arenaClass ArenaSingleClassFair
local ArenaStreetFightingModel = _G.BaseClass("ArenaStreetFightingModel", base)

function ArenaStreetFightingModel:__init()
end
---获取GM数据
function ArenaStreetFightingModel:OnHandleGMData(info)
    self:SetSelfData(info)
    require "ArenaStreetFightingManager":GetInstance():OnReConnectData(self, info)

    --self:ParseData(info)
end

function ArenaStreetFightingModel:ParseData(info)
    require "ArenaStreetFightingManager":GetInstance():SetActivity(self, info)

    base.ParseData(self)
end

function ArenaStreetFightingModel:ReConnect(info)
end
---@param info activity_arcade_chaos.i_activity_arcade_chaos
function ArenaStreetFightingModel:SetSelfData(info)
    self:InitArenaClass(info)

    --self.arenaClass:SetActivity(self)
    -- require "ArenaFairManager":GetInstance():SetActivity(self)
    -- require "ArenaFairManager":GetInstance():SetCoin(info.justice.info.coin)
end
---初始化街机乱斗
function ArenaStreetFightingModel:InitArenaClass(info)
    local endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)

    self.info = info
    info.end_time = endTime
    info.open_time = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    require "ArenaStreetFightingManager":GetInstance():SetActivity(self, info)
end
function ArenaStreetFightingModel:InitFunction()
    if self.giftActivity then
        self.giftActivity:InitFunction()
    end
end

---更新街机乱斗数据
function ArenaStreetFightingModel:UpdateArenaClass(callback)
    if not self:CheckIsOpen() then
        if callback then
            callback()
        end
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArenaFairLogin.id)
        return
    end
    require "ActivitySynNet":GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:InitArenaClass(msg.activity[1].self_info)
            if callback then
                callback()
            end
        end
    )
end

---进入活动
function ArenaStreetFightingModel:OnEnterActivity()
    local GetCard_list = require "ArenaStreetFightingManager":GetInstance():GetCard_list()
    if _G.table.count(GetCard_list) < 8 and _G.table.count(GetCard_list) > 0 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaSelectSheetView.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaBrawlEnterView.Name)
    end
    base.OnEnterActivity(self)
end

-- ---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ArenaStreetFightingModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckTempleRedPoint}
    self.redpointTree = {{2}, false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ArenaStreetFightingModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新奖励红点
function ArenaStreetFightingModel:RefreshRedPointTemple()
    local countdown = 0
    if self ~= nil and self.info ~= nil and self.info.end_time ~= nil then
        countdown = self.info.end_time - _G.TimeUtil:GetServerUnixTime()
    end

    if countdown > 0 then
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    end
end

function ArenaStreetFightingModel:CheckTempleRedPoint()
    local dayLimit = _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "ArenaStreetFighting")
    if dayLimit == nil then
        dayLimit = 0
    end
    local sixClockTime = _G.TimeUtil.GetSixClockTimer()
    local now = _G.TimeUtil.GetServerUnixTime() + sixClockTime - 86400
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open then
        return 0
    end
    if now - dayLimit >= 86400 then
        return 1
    end
    local result = require "ArenaStreetFightingManager":GetInstance():IS_All_win()
    if result then
        return 1
    end
    local IS_All_Task = require "ArenaStreetFightingManager":GetInstance():IS_All_Task()
    if IS_All_Task then
        return 1
    end

    return 0
end

---检测活动是否开放
function ArenaStreetFightingModel:CheckIsOpen()
    return self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open
end

return ArenaStreetFightingModel
