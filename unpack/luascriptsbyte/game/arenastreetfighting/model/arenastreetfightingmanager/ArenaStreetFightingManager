---进入布阵
---@param call function 打开布阵界面回调
---@param fairCall function 创建布阵item对象回调
function ArenaStreetFightingManager:EnterEmbattle(call, fairCall)
    if not self:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(730101)

        return
    end
    local onOpenEmbattleView
    onOpenEmbattleView = function(_, name)
        if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, onOpenEmbattleView, self)
            if call then
                call()
            end
        end
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, onOpenEmbattleView, self)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ArenaEmbattleView.Name,
        self.matchPlayerDatas,
        fairCall
    )
end

