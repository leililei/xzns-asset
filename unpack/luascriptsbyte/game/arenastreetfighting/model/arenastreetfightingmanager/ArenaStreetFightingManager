---设置活动
function ArenaStreetFightingManager:SetActivity(activity, info)
    self.enemyRoleInfo = {}
    ---当前可选卡牌最大数
    self.Count = 8
    self.activity = activity
    self.curEmbattleTimes = nil
    --总胜利次数
    self.all_win = info.arcade_chaos.all_win or 0
    --当前奖励以领取次数
    self.award_list = info.arcade_chaos.award_list or {}
    --本轮胜利次数
    self.win_times = info.arcade_chaos.win_times or 0
    --本轮失败次数
    self.fail_times = info.arcade_chaos.fail_times or 0
    --本轮所选卡牌sid
    self.card_list = info.arcade_chaos.card_list or {}
    --任务配置
    self.task_cfg = info.arcade_chaos.task_cfg or {}
    --战令信息
    self.battle_info = info.arcade_chaos.battle_info or {}
    for key, value in pairs(self.card_list) do
        self:SetCoins(value)
    end
    --合击技
    self.combine = info.arcade_chaos.combine or {}
    --随机生成卡牌sid
    self.random_cards = info.arcade_chaos.random_cards or {}

    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArenaBrawlEnterView.Name)
    local ArenaSeasonView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ArenaSeasonView.Name)
    if ArenaSeasonView then
        ArenaSeasonView:UpdataNew()
    end
    if view then
        view:Award_list()
    end
    --断线重连：正在进行的战斗信息
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ArenaEmbattleView.Name)

    if view == nil then
        --TODO:已经在匹配中的处理
        self.curr_info = info.arcade_chaos.is_reconnect or 0
        if self.curr_info == 1 then
            local ArenaMainView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)
            if ArenaMainView then
                self:CurrInfo()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaBrawlMateView.Name)
            else
                self.onLoadingWorld = true
                _G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnWorldLoadOver, self)
            end
        end
    end
    self.onSixInitInfoTag = true
end

