---领取所有可领奖励
function ArenaStreetFightingManager:BattleAward(call)
    local free_award, pay_award = self:Award()
    if _G.table.count(free_award) > 0 or _G.table.count(pay_award) > 0 then
        local Select_cards = {}
        Select_cards.activity_id = self.activity.curActivityClass:GetActivityID()
        Select_cards.free_sids = free_award
        Select_cards.pay_sids = pay_award
        require "ArenaStreetFightingNet":GetInstance():arcade_battle_award(
            Select_cards,
            function(msg)
                if msg.ack == 1 then
                    --_G.table.insert(self.card_list, sid)
                    --self.random_cards = msg.cards
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    for key, value in pairs(free_award) do
                        _G.table.insert(self.battle_info.free_award, value)
                    end
                    for key, value in pairs(pay_award) do
                        _G.table.insert(self.battle_info.pay_award, value)
                    end
                    self:RefreshRedPointTemple()

                    if call ~= nil then
                        call()
                    end
                end
            end
        )
    end
end

---购买战令等级
function ArenaStreetFightingManager:BattleBuyLevel(add_lv, call)
    local Select_cards = {}
    Select_cards.activity_id = self.activity.curActivityClass:GetActivityID()
    Select_cards.add_lv = add_lv
    require "ArenaStreetFightingNet":GetInstance():arcade_battle_buy_level(
        Select_cards,
        function(msg)
            if msg.ack == 1 then
                self.battle_info.lv = self.battle_info.lv + add_lv
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
             
                self:RefreshRedPointTemple()

                if call ~= nil then
                    call()
                end
            end
        end
    )
end

---查询当前可以领的免费和充值奖励
function ArenaStreetFightingManager:Award()
    local free_award, pay_award = {}, {}
    local lv = self:Islv()
    for key, value in pairs(store_season_battle_cfg[self.id].content) do
        local data = store_season_battlecon_cfg[value]
        if lv >= data.level then
            local is = self:IsBut()
            if self:free_award(value) == 0 then
                _G.table.insert(free_award, value)
            end
            if is == 1 then
                if self:pay_award(value) == 0 then
                    _G.table.insert(pay_award, value)
                end
            end
        end
    end

    return free_award, pay_award
end

