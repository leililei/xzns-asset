function ArenaStreetFightingManager:GetAward(coin, call)
    self.activity:GetActivityAward(
        { coin },
        function(msg)
            local datas = {}
            datas.award = {}
            datas.award.item = {}
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            for key, value in pairs(self.task_cfg[coin].award) do
                local item = {
                    type = {
                        value.sid,
                        value.num
                    }
                }
                _G.table.insert(datas.award.item, item)
            end
            -- for key, value in pairs(msg.Cfg.reward) do
            local item1 = {
                type = {
                    107,
                    self.task_cfg[coin].battle_exp
                }
            }
            _G.table.insert(datas.award.item, item1)

            --end
            require "CommonTipManager".OpenCommonAwardView(datas)
            --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:AddAward_list(coin)
            if call then
                call()
            end
        end
    )
end

---奖励领取
function ArenaStreetFightingManager:GetAwardMax(call)
    local coin = {}

    for key, value in pairs(self.task_cfg) do
        if self.all_win >= value.condition then
            if not self:GetAward_listBool(value.sid) then
                _G.table.insert(coin, value.sid)
            end
        end
    end

    self.activity:GetActivityAward(
        coin,
        function(msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            local datas = {}
            datas.award = {}
            datas.award.item = {}
            -- _G.StorageManager:GetInstance():ReceiveAwardData(msg)

            --end

            for key, value in pairs(coin) do
                self:AddAward_list(value)
                for _, v in pairs(self.task_cfg[value].award) do
                    local item = {
                        type = {
                            v.sid,
                            v.num
                        }
                    }
                    _G.table.insert(datas.award.item, item)
                end
                -- for key, value in pairs(msg.Cfg.reward) do
                local item1 = {
                    type = {
                        107,
                        self.task_cfg[value].battle_exp
                    }
                }
                _G.table.insert(datas.award.item, item1)
            end
            require "CommonTipManager".OpenCommonAwardView(datas)
            if call then
                call()
            end
        end
    )
end

---卡牌选择
function ArenaStreetFightingManager:SelectCards(sid, call)
    local Select_cards = {}
    Select_cards.activity_id = self.activity.curActivityClass:GetActivityID()
    Select_cards.sid = sid
    require "ArenaStreetFightingNet":GetInstance():SelectCards(
        Select_cards,
        function(msg)
            if msg.ack == 1 then
                _G.table.insert(self.card_list, sid)
                self.random_cards = msg.cards
                self:SetCoins(sid)
                if call ~= nil then
                    call()
                end
            end
        end
    )
end

