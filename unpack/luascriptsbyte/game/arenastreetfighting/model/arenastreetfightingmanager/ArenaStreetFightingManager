        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        self:CurrInfo()
    end
end

function ArenaStreetFightingManager:CurrInfo(call)
    self.onLoadingWorld = false
    local Select_cards = {}
    Select_cards.activity_id = self.activity.curActivityClass:GetActivityID()

    require "ArenaStreetFightingNet":GetInstance():Curr_info(
        Select_cards,
        function(msg)
            if msg.ack == 1 then
                -- body
                --TODO:计算当前所在阶段
                self:P2C_Friendinfo(msg)
                local enter = false
                if self.curEmbattleTimes > 0 then
                    --TODO:判定当前是否还在布阵阶段
                    local time = _G.TimeUtil.GetServerUnixTime()
                    if time < msg.pub_info.end_time then --当前阶段
                        enter = true
                    else                                 --已经进入下一阶段
                        self.curEmbattleTimes = self.curEmbattleTimes + 1
                        if self.curEmbattleTimes <= 6 then
                            enter = true
                        end
                    end
                end
                if enter then
                    self:EnterEmbattle(
                        nil,
                        function()
                            self.curEmbattleTimes = msg.pub_info.round
                            self.enemyRoleInfo = msg.roles
                            self.enemyRoleInfo.score = msg.pub_info

                            self.curEmbattleEndTime = msg.pub_info.end_time
                            self.curEmbattleTimes = self.curEmbattleTimes + 1
                            local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
                            if embattleItem then
                                local my_garry, tar_garry
                                if self.matchPlayerData.pub_info.uid_a == _G.PlayerModel:GetInstance():GetPlayerUid() then
                                    my_garry = self.matchPlayerData.pub_info.array_a
                                    tar_garry = self.matchPlayerData.pub_info.array_b
                                else
                                    my_garry = self.matchPlayerData.pub_info.array_b

                                    tar_garry = self.matchPlayerData.pub_info.array_a
                                end
                                embattleItem:InitEnemyEmbattleData(tar_garry)
                                embattleItem:InitEmbattleData(my_garry)
                            end
                            --self.curr_info = nil
                        end
                    )
                else
                    self.curr_info = nil
                end
            else
                if msg.winner then
                    if msg.winner == 1 then
                        self:AddFail_times()
                    else
                        self:AddWin_times()
                    end
                end
                if call ~= nil then
                    call()
                end
            end
        end
    )
end

