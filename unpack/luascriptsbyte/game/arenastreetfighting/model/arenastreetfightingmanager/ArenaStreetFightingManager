---经验加
function ArenaStreetFightingManager:AddExp(Exp)
    self.battle_info.exp = self.battle_info.exp + Exp
    for key, value in pairs(store_season_battle_cfg[self.id].content) do
        local lv = self:expIsId(self.battle_info.lv)

        if
            store_season_battlecon_cfg[value].level == self.battle_info.lv and
            self.battle_info.exp >= store_season_battlecon_cfg[value].conditions[2]
        then
            self.battle_info.lv = store_season_battlecon_cfg[value].level + 1
            self.battle_info.exp = self.battle_info.exp - lv.conditions[2]
        elseif
            store_season_battlecon_cfg[value].level > self.battle_info.lv and
            self.battle_info.exp >= store_season_battlecon_cfg[value].conditions[2]
        then
            self.battle_info.lv = store_season_battlecon_cfg[value].level
            self.battle_info.exp = self.battle_info.exp - lv.conditions[2]
        end
        if
            key >= _G.table.count(store_season_battle_cfg[self.id].content) and
            store_season_battlecon_cfg[value].level <= self.battle_info.lv
        then
            self.battle_info.lv = store_season_battlecon_cfg[value].level
            self.battle_info.exp = store_season_battlecon_cfg[value].conditions[2]
            return
        end
    end
end

--当前等级经验
function ArenaStreetFightingManager:Expslider()
    if self.battle_info == nil then
        return 0
    end
    local data = self:expIsId(self:Islv())
    local zhi = self.battle_info.exp / data.conditions[2]
    if zhi > 1 then
        zhi = 1
    end
    return zhi, self.battle_info.exp, data.conditions[2]
end

--战令等级
function ArenaStreetFightingManager:exp()
    if self.battle_info == nil then
        return 0
    end
    return self.battle_info.exp or 0
end

--根据等级获取当前任务信息
function ArenaStreetFightingManager:expIsId(lv)
    for key, value in pairs(store_season_battle_cfg[self.id].content) do
        if key == 1 and lv <= store_season_battlecon_cfg[value].level then
            return store_season_battlecon_cfg[value]
        end
        if store_season_battlecon_cfg[value].level == lv then
            return store_season_battlecon_cfg[value]
        elseif key == _G.table.count(store_season_battle_cfg[self.id].content) then
            return store_season_battlecon_cfg[value]
        end
    end
end

