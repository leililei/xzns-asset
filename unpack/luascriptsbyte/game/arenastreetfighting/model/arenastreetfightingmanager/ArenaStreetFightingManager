---返回显示时间，最小值为一小时
function ArenaStreetFightingManager:TranslateSecondForStrMiaoHui(Time)
    local timeStr
    local t = _G.TimeUtil.TranslateSecond(Time)
    if t.day > 0 then
        timeStr = _G.GetLangPackValue(90022100001, t.day, t.hour)
    elseif t.hour > 0 then
        timeStr = _G.GetLangPackValue(90022100001, 0, t.hour)
    else
        timeStr = _G.GetLangPackValue(90022100001, 0, 1)
    end
    return timeStr
end

