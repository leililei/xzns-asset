---判断当前是否是可备战轮次
function ArenaStreetFightingManager:BoolCurEmb()
    local CurEmbattle = false
    if self.matchPlayerData.pub_info.uid_a == _G.PlayerModel:GetInstance():GetPlayerUid() then
        CurEmbattle = true
    end
    if CurEmbattle then
        if
            self.matchPlayerData.pub_info.round == 0 or self.matchPlayerData.pub_info.round == 2 or
            self.matchPlayerData.pub_info.round == 4 or
            self.matchPlayerData.pub_info.round == 6 or
            self.matchPlayerData.pub_info.round == 8
        then
            CurEmbattle = false
        end
    else
        if
            self.matchPlayerData.pub_info.round == 0 or self.matchPlayerData.pub_info.round == 1 or
            self.matchPlayerData.pub_info.round == 3 or
            self.matchPlayerData.pub_info.round == 5 or
            self.matchPlayerData.pub_info.round == 7
        then
            CurEmbattle = false
        else
            CurEmbattle = true
        end
    end
    return CurEmbattle
end

---判断当前是否先手和可备战人数
function ArenaStreetFightingManager:UnCheck()
    local NumList = _G.ConfigManager.discrete_cfg[107908]
    local CurEmbattle = 2
    if self.matchPlayerData.pub_info.uid_a == _G.PlayerModel:GetInstance():GetPlayerUid() then
        CurEmbattle = 1
    else
    end
    local OKBool = false
    local oleNume, MaxNum, jian = 0, 0, 0
    if CurEmbattle == 1 then
        jian = 1
    else
        jian = 0
    end
    for key, value in pairs(NumList[CurEmbattle]) do
        local num = key * 2 - jian
        if self.curEmbattleTimes >= num then
            oleNume = value
            MaxNum = MaxNum + value
        end
        if self.curEmbattleTimes == num then
            OKBool = true
        end
    end
    return OKBool, oleNume, MaxNum
end

---开始战斗
---@param callback function 进入战斗返回
function ArenaStreetFightingManager:StartBattle(callback)
    -- if not self:CheckIsOpen() then
    --     _G.PopWindowManager:GetInstance():ShowAllTips(730101)
    --     return
    -- end
    local BattleManagerIns = _G.BattleManager:GetInstance()
    local Select_cards = { activity_id = self.activity.curActivityClass:GetActivityID() }

    local port =
        require "ArenaStreetFightingNet":GetInstance():FightFair(
            Select_cards,
            function(msg)
                if msg.ack == 1 then
                    if callback then
                        callback(true, msg)
                    end
                    if msg then
                        msg.fight_arg.winner = msg.winner

                        if msg.winner == 1 then
                            self:AddFail_times()
                        else
                            self:AddWin_times()
                        end
                    end
                    BattleManagerIns:EnterFight(
                        _G.BattleControllerType.BattleControllerArenaEmbattle,
                        msg,
                        self.matchPlayerData
                    )
                else
                    _G.BaseBattleManager:GetInstance():ClearView(true)
                    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
                    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
                    _G.WorldManager:GetInstance():DespawnRoleParent()

                    local UIManagerIns = _G.UIManager:GetInstance()
                    local ui_cfg = _G.ConfigManager.ui_cfg
                    UIManagerIns:CloseWindow(ui_cfg.ArenaEmbattleView.Name)
                    UIManagerIns:OpenWindow(ui_cfg.MainView.Name)
                    if callback then
                        callback(false)
                    end
                end
            end
        )
    BattleManagerIns:AddLuaNetEvent(port)
end

--是否处于开放时间
function ArenaStreetFightingManager:IsTime()
    local endTime = 0
    local countdown = 0
    if self.activity ~= nil and self.activity.info ~= nil and self.activity.info.end_time ~= nil then
        endTime = self.activity.info.end_time
        countdown = self.activity.info.end_time - _G.TimeUtil:GetServerUnixTime()
    end

    if countdown < 0 then
        countdown = 0
    end
    --local countdown = self.activity.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    return endTime, countdown
end

