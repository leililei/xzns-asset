function ArenaStreetFightingManager:SetCoins(id, CardData)
    local data = require "CardCommentManager":GetInstance():CardData(id)
    local att_equity_cfg = _G.ConfigManager.att_equity_cfg[3]
    ---@type  prop.i_card 数据
    local msg = {}
    msg.sid = data.id
    msg.lv = att_equity_cfg.level
    msg.awaken = 0
    msg.unlock = 1
    msg.uid = data.id
    msg.attr_add = {}

    msg.soul_chain_lv = att_equity_cfg.card_exclusive_lv

    msg.soul_state = 1
    msg.star = att_equity_cfg.star

    msg.open_inborn = {}
    for i = 1, #data.talent do
        local tt = data.talent[i]
        for j = 1, #tt do
            table.insert(msg.open_inborn, tt[j])
        end
    end
    local artifactCfgs = _G.ConfigManager.artifact_cfg
    local artifactSid = 0
    for _, v in pairs(artifactCfgs) do
        if v.Professional == data.Professional and v.Order == att_equity_cfg.artifact_grade then
            artifactSid = v.id
            break
        end
    end
    msg.artifact = {
        {
            sid = artifactSid,
            uid = artifactSid,
            num = 1,
            level = att_equity_cfg.artifact_level,
            star = att_equity_cfg.artifact_star,
            awaken = 0,
        }
    }
    self:ChuShiHua(msg, CardData, data)
end

function ArenaStreetFightingManager:ChuShiHua(msg, cardData, data)
    self.CardData[msg.sid] = cardData

    ---@type CardData
    self.CardData[msg.sid] = _G.CardData.New()
    self.CardData[msg.sid]:ParseInitMsg(msg)
    self.CardData[msg.sid]:UpdateAttr()
    self.CardData[msg.sid].NowSumProp:OnInit(data.Elements)
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attr = attributeManager:GetAttribtueClass(data.Elements)
    ---职业树属性

    attributeManager:AddAttribute(attr, self.CardData[msg.sid].BaseProp)
    --attributeManager:AddAttribute(attr, TreeAttr)
    --魂链 是否激活
    if data.Order >= 3 then
        if self.CardData[msg.sid].soulLink_IsActivate == 1 then
            --require("CardHunLianModel"):GetInstance():InitCfgData(self.sid)

            local hunlian_exclusive =
                require("CardHunLianManger"):GetInstance():CalAttributeBase(
                    self.CardData[msg.sid].sid,
                    self.CardData[msg.sid].soulLink_lv
                )
            attributeManager:AddAttribute(attr, hunlian_exclusive)
            local hunlian_attribute =
                require("CardHunLianManger"):GetInstance():CalAttribute(
                    self.CardData[msg.sid].sid,
                    self.CardData[msg.sid].soulLink_lv
                )
            if not _G.table.isEmptyOrNil(hunlian_attribute) then
                attributeManager:AddAttribute(attr, hunlian_attribute)
            end
        end
    end

    --天赋
    local talentAttr = self.CardData[msg.sid]:GetTalentAttribute()
    attributeManager:AddAttribute(attr, talentAttr)

    --attributeManager:AddAttribute(attr, self.CardData:GetDecorationProp())
    attributeManager:AddAttribute(self.CardData[msg.sid].NowSumProp, attr)
    attributeManager:PutAttribtueClass(attr)
    self.CardData[msg.sid]:CalculateRole()
    self.CardData[msg.sid]:CalculatePower()
end

