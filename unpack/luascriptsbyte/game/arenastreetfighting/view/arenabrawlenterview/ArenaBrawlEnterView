---@class ArenaBrawlEnterView : UIBaseView	中文描述
---@field public go_table ArenaBrawlEnterView GoTable
local ArenaBrawlEnterView = _G.BaseClass("ArenaBrawlEnterView", _G.UIBaseView)
local langID = {
    --本期结束时间
    Re = "90027200011",
    --级
    deng = "90000010058"
}
local Reward = {
    [0] = 72,
    [1] = 112,
    [2] = 192,
    [3] = 280,
    [4] = 362,
    [5] = 454
}
function ArenaBrawlEnterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function ArenaBrawlEnterView:OnCreate()
    local resources = _G.ConfigManager.ui_cfg.ArenaBrawlEnterView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_ResourceRoot,
            require("ResourceCompont").New(self.go_table.obj_ResourceRoot, resources)
        )
    end
    --奖励列表
    self.award_list = _G.ConfigManager.discrete_cfg[107906][1]
    ---奖励倍速 目前写死为1
    self.award_num = 1
    ---奖励item记录，用于数据刷新
    self.awardList = {}
    self:InitView()
end

---初始化界面
function ArenaBrawlEnterView:InitView()
    ---当日点击记录
    _G.PlayerPrefsManager.SetInt(
        _G.PlayerModel:GetInstance():GetPlayerUid() .. "ArenaStreetFighting",
        _G.TimeUtil.GetServerUnixTime()
    )
    require "ArenaStreetFightingManager":GetInstance():RefreshRedPointTemple()
    local endTime, countdown = require "ArenaStreetFightingManager":GetInstance():IsTime()
    self.CountDownTime = countdown
    self.go_table.aortext_OpenTime.text =
        _G.LangUtil.GetLangPackValue(90022500333) ..
        ":" .. require "ArenaStreetFightingManager":GetInstance():TranslateSecondForStrMiaoHui(self.CountDownTime)
    self.timer = _G.TimerManager:GetInstance():GetTimer(10, self.OnTimeCall, self, false, false)
    self.timer:Start()
    self.EndTime = _G.TimeUtil.GetDateTime(endTime)
    self:InitCombSkill()
    self:HongDian()
    self:OnEnterActivity()
    --self:Award_list()
end
---进入活动
function ArenaBrawlEnterView:OnEnterActivity()
    local GetCard_list = require "ArenaStreetFightingManager":GetInstance():GetCard_list()
    if _G.table.count(GetCard_list) > 0 then
        self.go_table.aortext_EnterText.text = _G.LangUtil.GetLangPackValue(langID.deng)
    else
        self.go_table.aortext_EnterText.text = _G.LangUtil.GetLangPackValue(langID.Re)
    end
end
function ArenaBrawlEnterView:HongDian()
    local result = require "ArenaStreetFightingManager":GetInstance():IS_All_win()
    if result then
        self.go_table.obj_redpointMei:SetActiveE(1)
    else
        self.go_table.obj_redpointMei:SetActiveE(0)
    end
    local IS_All_Task = require "ArenaStreetFightingManager":GetInstance():IS_All_Task()
    if IS_All_Task then
        self.go_table.obj_redpointluan:SetActiveE(1)
    else
        self.go_table.obj_redpointluan:SetActiveE(0)
    end
end

---入场按钮点击（判断是进入选将还是主界面
function ArenaBrawlEnterView:Aorbtn_Enter()
    local Count = require "ArenaStreetFightingManager":GetInstance():GetCount()
    local GetCard_list = _G.table.count(require "ArenaStreetFightingManager":GetInstance():GetCard_list())
    if self.timer then
        self.timer:Stop()
    end
    if GetCard_list < Count then
        ---选将界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaSelectSheetView.Name)
        self:Close()
    else
        ---街机乱斗匹配战斗
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)
        self:Close()
    end
end

function ArenaBrawlEnterView:OnTimeCall(elapsed)
    if self.CountDownTime > 0 then
        self.CountDownTime = self.CountDownTime - elapsed

        self.go_table.aortext_OpenTime.text =
            _G.LangUtil.GetLangPackValue(90022500333) ..
            ":" .. require "ArenaStreetFightingManager":GetInstance():TranslateSecondForStrMiaoHui(Mathf.RoundToInt(self.CountDownTime))
    else
        self.timer:Stop()
    end
end
---奖励展示
function ArenaBrawlEnterView:Award_list()
    local GetAll_win = require "ArenaStreetFightingManager":GetInstance():GetAll_win()

    local num = 0
    for i = 1, 5 do
        local Get = 0
        if self.awardList[i] == nil then
            self.awardList[i] =
                _G.GetAutoGoTable(self.go_table["obj_card" .. i], _G.handlerbind(self, self.Award_listBtn, i))
        end
        self.awardList[i].aortext_cardProgress.text = i * self.award_num .. "勝"
        if i * self.award_num <= GetAll_win then
            num = i
            Get = 1
        end
        local bool = require "ArenaStreetFightingManager":GetInstance():GetAward_listBool(i)
        if bool then
            Get = 0
        end
        self.awardList[i].aorbtn_Get:SetActiveE(Get)

        self:tanQuanDianJi(self.award_list[1], bool, self.award_list[2], self.awardList[i].obj_card)
    end
    self.go_table.aorimage_activeSchedule:SetRectTransformSize(Reward[num], 69)
end

---物品内容选中显示
function ArenaBrawlEnterView:tanQuanDianJi(Sid, isGou, number, Parent)
    _G.StorageManager:GetInstance():GetItemBaseView(
        Sid,
        number,
        Parent,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(1)
            -- local insId = item.transform:GetParent():GetParent():GetInstanceIDE()
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:SetGou(isGou)
            if item.go_table.aorrawimage_Icon then
                item.go_table.aorrawimage_Icon:SetGray(isGou)
            end
            if item.go_table.aorimage_Color then
                item.go_table.aorimage_Color:SetGray(isGou)
            end
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid, nil, nil, Sid)
        end
    )
end

---奖励领取
function ArenaBrawlEnterView:Award_listBtn(go, _, num)
    require "ArenaStreetFightingManager":GetInstance():GetAward(num, _G.handler(self, self.Award_list))
end

--region 合击技显示
---初始化合击技
function ArenaBrawlEnterView:InitCombSkill()
    self.combSkillUnLock = require "ArenaStreetFightingManager":GetInstance():GetCombine()
    if not self.combSkillUnLock[1] then
        self.go_table.obj_combSkill:SetActiveE(0)
        return
    end
    self.go_table_skill = _G.GetAutoGoTable(self.go_table.obj_combSkill, _G.handler(self, self.OnClickBtnCombSkill))
    self.skillItems = {
        {
            btngo = self.go_table_skill.aorbtn_1,
            go = self.go_table_skill.obj_combGO1,
            icon = self.go_table_skill.aorrawimage_icon1,
            text = self.go_table_skill.aortext_type1,
            lock = self.go_table_skill.obj_lock1,
            redpoint = self.go_table_skill.obj_redpoint1,
            typeText = self.go_table_skill.aortext_type11,
            typeObj = self.go_table_skill.obj_type1,
            condition = self.go_table_skill.aortext_condition1
        },
        {
            btngo = self.go_table_skill.aorbtn_2,
            go = self.go_table_skill.obj_combGO2,
            icon = self.go_table_skill.aorrawimage_icon2,
            text = self.go_table_skill.aortext_type2,
            lock = self.go_table_skill.obj_lock2,
            redpoint = self.go_table_skill.obj_redpoint2,
            typeText = self.go_table_skill.aortext_type21,
            typeObj = self.go_table_skill.obj_type2,
            condition = self.go_table_skill.aortext_condition2
        },
        {
            btngo = self.go_table_skill.aorbtn_3,
            go = self.go_table_skill.obj_combGO3,
            icon = self.go_table_skill.aorrawimage_icon3,
            text = self.go_table_skill.aortext_type3,
            lock = self.go_table_skill.obj_lock3,
            redpoint = self.go_table_skill.obj_redpoint3,
            typeText = self.go_table_skill.aortext_type31,
            typeObj = self.go_table_skill.obj_type3,
            condition = self.go_table_skill.aortext_condition3
        }
    }

    self:ShowCombSkill()
end
---合击技技能显示
function ArenaBrawlEnterView:ShowCombSkill()
    if not self.combSkillUnLock[1] then
        return
    end
    local cfg, lv, id
    local ConfigManager = _G.ConfigManager
    for i = 1, #self.combSkillUnLock do
        if self.combSkillUnLock[i] then
            self.skillItems[i].lock:SetActiveE(0)
            self.skillItems[i].typeObj:SetActiveE(1)
            if self.combSkillUnLock[i] > 0 then
                self.skillItems[i].go:SetActiveE(1)
                cfg = ConfigManager.card_skills_cfg[self.combSkillUnLock[i]]
                self.skillItems[i].icon:LoadImage(
                    cfg.icon,
                    function(rawimage)
                        rawimage:SetNativeSize()
                    end
                )
                cfg = ConfigManager.battle_skill_cfg[cfg.skills[1]]
                self.skillItems[i].text.text = ConfigManager.language_package_cfg[cfg.Brief]
                self.skillItems[i].redpoint:SetActiveE(0)
            else
                self.skillItems[i].go:SetActiveE(0)
                _G.GameUtil.SetActiveByCondition(
                    self.skillItems[i].redpoint,
                    self.curEmbattleItem:CheckCombineSkillEquip(i, self.curEmbattleIndex)
                )
            end
            self.skillItems[i].typeText.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][i])
        else
            self.skillItems[i].go:SetActiveE(0)
            self.skillItems[i].lock:SetActiveE(1)
            self.skillItems[i].redpoint:SetActiveE(0)
            self.skillItems[i].typeObj:SetActiveE(0)
            local afk = self.curEmbattleItem:GetCombineSkillUnLockCondition(i, self.curEmbattleIndex)
            if afk then
                ---@type afk_cfg
                local cfg = _G.ConfigManager.afk_cfg[afk]
                if cfg then
                    self.skillItems[i].condition:SetActiveE(1)
                    self.skillItems[i].condition.text =
                        _G.LangUtil.GetLangPackValue(90025100003, cfg.chapter, cfg.section)
                else
                    self.skillItems[i].condition:SetActiveE(0)
                end
            else
                self.skillItems[i].condition:SetActiveE(0)
            end
        end
    end
end

---合击技点击技能展示tip
function ArenaBrawlEnterView:OnClickBtnCombSkill(go)
    local i = 0
    if go == self.go_table_skill.aorbtn_1 then
        i = 1
    elseif go == self.go_table_skill.aorbtn_2 then
        i = 2
    else
        i = 3
    end
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg[self.combSkillUnLock[i]]

    if card_skills_cfg ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(card_skills_cfg.id, nil, false)
    end
end

--endregion

---按钮点击事件在这里派发
function ArenaBrawlEnterView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.timer then
            self.timer:Stop()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Enter then ---instruction_cfg
        self:Aorbtn_Enter()
    elseif go == self.go_table.aorbtn_luandouzhanling then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaSeasonView.Name,
            _G.handler(self, self.HongDian)
        )
    elseif go == self.go_table.aorbtn_meirirenwu then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaSeasonPeakTaskView.Name,
            _G.handler(self, self.HongDian)
        )
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 63)
    end
end

return ArenaBrawlEnterView
