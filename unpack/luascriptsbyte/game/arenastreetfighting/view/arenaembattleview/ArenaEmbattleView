function ArenaEmbattleView:UpdateTipsContent()
    local OKBool, oleNume, MaxNum = self.ArenaStreetFightingManager:UnCheck()

    local content = format(_G.GetLangPackValue(90027200005), self.ArenaStreetFightingManager.curEmbattleTimes)
