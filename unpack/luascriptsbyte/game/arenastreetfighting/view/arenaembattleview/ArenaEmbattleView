---交互配置ID
local FAIRINTERACTIONID = 10001
function ArenaEmbattleView:InitChatViewEmj()
    if self.chatEmjioIDs then
        return
    end
    local cfg = require("ChatManager"):GetInstance():Phiz_GetGif()
    if #cfg <= 0 then
        cfg = require("ChatManager"):GetInstance():GetPhiz_DataID()
    end
    if #cfg <= 0 then
        self.go_tableChat.aorimage_kong:SetActiveE(1)
        return
    else
        self.go_tableChat.aorimage_kong:SetActiveE(0)
    end

    local expression_cfg = _G.ConfigManager.expression_cfg
    self.PhizArr = _G.table.values(cfg)
    _G.SortList(
        self.PhizArr,
        function(a)
            local num = require("ChatManager"):GetInstance():GetPhiz_ChatData(a.id)
            return num, -a.id
        end
    )
    if self.phiz == nil then
        self.phiz = true
        self.go_tableChat.scrollloopvectical_phiz:InitItemData(#self.PhizArr, _G.handler(self, self.RefreshList_phiz))
    else
        self.go_tableChat.scrollloopvectical_phiz:UpdateCount(#self.PhizArr)
    end
    -- self.chatEmjioIDs = _G.DeepCopyCfgTable(cfg.expression)
end

function ArenaEmbattleView:RefreshList_phiz(index, objGame)
    if index < 0 then
        return
    end
    ---@type expression_cfg
    local cfg = self.PhizArr[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_phiz, cfg))
    itemGoTable.Phiz_id = cfg.id or cfg.sid

    if cfg.gif == 0 then
        itemGoTable.aorrawimage_icon:SetActiveE(1)
        itemGoTable.obj_spine:SetActiveE(0)
        itemGoTable.aorrawimage_icon.Alpha = 0
        itemGoTable.aorrawimage_icon:LoadImage(cfg.img_path)
    elseif cfg.gif == 1 then
        itemGoTable.aorrawimage_icon:SetActiveE(0)
        itemGoTable.obj_spine:SetActiveE(1)
        itemGoTable.obj_spine:ClearChildren()
        _G.UIUtils.LoadEffectByPath(cfg.img_path, itemGoTable.obj_spine)
    end

    return objGame
end

function ArenaEmbattleView:OnClick_phiz(go, _, itemGoTable)
    local Phiz_id = itemGoTable.id or itemGoTable.sid

    ---@type expression_cfg
    local cfg = _G.ConfigManager.expression_cfg[Phiz_id]
    if cfg ~= nil then
        self:ShowChat(true, 2, cfg.id or cfg.sid)
        self.ArenaStreetFightingManager:SendChatMsg(2, cfg.id or cfg.sid)
    end
end

