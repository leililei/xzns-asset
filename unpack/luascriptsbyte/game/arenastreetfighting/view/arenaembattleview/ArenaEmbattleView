---监听界面打开
---@param name string 界面名称
function ArenaEmbattleView:OnEmbattleViewOpened(name)
    local ui_cfg = _G.ConfigManager.ui_cfg
    if name == ui_cfg.EmbattleView.Name then
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_root)
        self.embattleView:ShowCardList()
        self.embattleView:HideShackleBottom()
        self.embattleView:HideCombSkill()
        self.embattleView:HideExitBtn()
        self.embattleView:HideShackle()
        self:OnEmbattleCall(true)
        self:UpdateModelLock()
        self:CheckCurTimesEmbattle()
    elseif name == ui_cfg.EmbattleCombineSkillView.Name then
        self.go_table.obj_CombHandTips:SetActiveE(0)
        _G.UIManager:GetInstance():OpenWindow(ui_cfg.ArenaFairCombineView.Name, self.embattleItem:GetCombSkillData())
        self:CheckCurTimesEmbattle()
    end
end

---布阵数据刷新
function ArenaEmbattleView:OnEmbattleCall(notUpdate)
    self.sureEmbattleTag = false

    if not notUpdate then
        if self.embattleView then
            --TODO:刷新布阵展示数据
            self.embattleView:UpdateAllModelPub()
        end
        _G.TimerManager:GetInstance():GetTimer(1, self.UpdateModelLock, self, true, true):Start()
    end
    local times = self.ArenaStreetFightingManager:GetCurEmbattleTimes()
    if times >= 7 then --布阵轮次结束，进入战斗
        ---隐藏手势
        self:EnterBattleCall()
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineViewClosed, self)
        local UIManagerIns = _G.UIManager:GetInstance()
        local ui_cfg = _G.ConfigManager.ui_cfg
        UIManagerIns:CloseWindow(ui_cfg.ArenaFairCombineView.Name)
    else
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaFairTimesTipsView.Name, times)
        self:OnEmbattleTimesCall(times, self.ArenaStreetFightingManager:GetCurEmbattleEndTime())
    end
end

---切换到下一轮次
---@param times number 当前轮次
---@param time number 当前轮次剩余时间戳
function ArenaEmbattleView:OnEmbattleTimesCall(times, time)
    self:ShowTipsShadow()

    self.chooseTime = 0
    self.chooseTimeStamp = time
    self:HandleChoosTime()
    if self.handleChooseTimer then
        self.handleChooseTimer:Stop()
        self.handleChooseTimer = nil
    end
    self.handleChooseTimer = _G.TimerManager:GetInstance():GetTimer(1, self.HandleChoosTime, self)
    self.handleChooseTimer:Start()
end

function ArenaEmbattleView:HandleChoosTime()
    if self.ArenaStreetFightingManager:GetCurEmbattleTimes() == 0 then
        self.go_table.aortext_times.text = ""
        self:ShowSureEmbatttleTips(true)
    else
        self.chooseTime = self.chooseTimeStamp - _G.TimeUtil.GetServerUnixTime()
        if self.chooseTime > 0 then
            self.go_table.aortext_times.text = self.chooseTime
        else
            self.chooseTime = 0
            self.go_table.aortext_times.text = self.chooseTime
            if not self.sureEmbattleTag then --倒计时结束，自动确定布阵
                --TODO:确定当前轮次，展示tips界面
                self:ShowSureEmbatttleTips(true)
            end
            if self.handleChooseTimer then
                self.handleChooseTimer:Stop()
                self.handleChooseTimer = nil
            end
        end
    end
end

function ArenaEmbattleView:ShowSureEmbatttleTips(unCheck)
    self:ShowTipsShadow()
    self.sureEmbattleTag = true
    self.embattleItem:SaveEmbattleFair(_G.handler(self, self.OnSureEmbattleCall), unCheck)
end

function ArenaEmbattleView:OnSureEmbattleCall(msg)
    if msg.ack ~= 1 then --没有保存成功 则打开继续编辑
        self:ShowTipsShadow()
        return
    end

    self:UpdateModelLock()
end

function ArenaEmbattleView:OnCombineViewClosed(name)
    self:CheckCurTimesEmbattle()
end

