function ArenaEmbattleView:ShowChat(my, type, id)
    if my then
        if type == 1 then
            self.go_table.obj_chatImageLeft:SetActiveE(0)
            self.go_table.obj_chatTextLeft:SetActiveE(1)
            self.go_table.aortext_chatLeft.text = _G.GetLangPackValue(id)
            self.go_table.aortext_chatLeft1.text = _G.GetLangPackValue(id)
        else
            self.go_table.obj_chatImageLeft:SetActiveE(1)
            self.go_table.obj_chatTextLeft:SetActiveE(0)
            local cfg = _G.ConfigManager.expression_cfg[id]
            if cfg.gif == 0 then
                self.go_table.aorrawimage_chatLeft:SetActiveE(1)
                self.go_table.obj_chatLeft:SetActiveE(0)
                self.go_table.aorrawimage_chatLeft.Alpha = 0
                self.go_table.aorrawimage_chatLeft:LoadImage(cfg.img_path)
            elseif cfg.gif == 1 then
                self.go_table.aorrawimage_chatLeft:SetActiveE(0)
                self.go_table.obj_chatLeft:SetActiveE(1)
                self.go_table.obj_chatLeft:ClearChildren()
                _G.UIUtils.LoadEffectByPath(cfg.img_path, self.go_table.obj_chatLeft, nil, nil, nil,
                    { 0, -110 })
            end
        end
    else
        if type == 1 then
            self.go_table.obj_chatImageRight:SetActiveE(0)
            self.go_table.obj_chatTextRight:SetActiveE(1)
            self.go_table.aortext_chatRight.text = _G.GetLangPackValue(id)
            self.go_table.aortext_chatRight1.text = _G.GetLangPackValue(id)
        else
            self.go_table.obj_chatImageRight:SetActiveE(1)
            self.go_table.obj_chatTextRight:SetActiveE(0)

            local cfg = _G.ConfigManager.expression_cfg[id]
            if cfg.gif == 0 then
                self.go_table.aorrawimage_chatRight:SetActiveE(1)
                self.go_table.obj_chatRight:SetActiveE(0)
                self.go_table.aorrawimage_chatRight.Alpha = 0
                self.go_table.aorrawimage_chatRight:LoadImage(cfg.img_path)
            elseif cfg.gif == 1 then
                self.go_table.aorrawimage_chatRight:SetActiveE(0)
                self.go_table.obj_chatRight:SetActiveE(1)
                self.go_table.obj_chatRight:ClearChildren()
                _G.UIUtils.LoadEffectByPath(cfg.img_path, self.go_table.obj_chatRight, nil, nil, nil,
                    { 0, -110 })
            end
        end
    end
    self:OpenShowChatTimer(my)
end

---聊天展示时间离散表配置ID
local CHATSHOWTIMEDISCRETEID = 106014
---开启聊天展示计时器
---@param my boolean 是否是自己
function ArenaEmbattleView:OpenShowChatTimer(my)
    if not self.showChatTime then
        self.showChatTime = { my = 0, other = 0 }
    end
    if my then
        self.showChatTime.my = _G.ConfigManager.discrete_cfg[CHATSHOWTIMEDISCRETEID][1][1]
    else
        self.showChatTime.other = _G.ConfigManager.discrete_cfg[CHATSHOWTIMEDISCRETEID][1][1]
    end
    if not self.showChatTimer then
        self.showChatTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnShowChatTimerCall, self)
        self.showChatTimer:Start()
    else
        self.showChatTimer:Resume()
    end
end

function ArenaEmbattleView:OnShowChatTimerCall(elapsed)
    if self.showChatTime.my > 0 then
        self.showChatTime.my = self.showChatTime.my - elapsed
        if self.showChatTime.my <= 0 then
            self.showChatTime.my = 0
            self.go_table.obj_chatTextLeft:SetActiveE(0)
            self.go_table.obj_chatImageLeft:SetActiveE(0)
        end
    end
    if self.showChatTime.other > 0 then
        self.showChatTime.other = self.showChatTime.other - elapsed
        if self.showChatTime.other <= 0 then
            self.showChatTime.other = 0
            self.go_table.obj_chatImageRight:SetActiveE(0)
            self.go_table.obj_chatTextRight:SetActiveE(0)
        end
    end
    if self.showChatTime.other == 0 and self.showChatTime.my == 0 then
        self.showChatTimer:Pause()
        self.showChatTimer:Reset()
    end
end

