---界面的入口函数
---@param data CardData
function ArenaEmbattleView:OnCreate(data, itemCall)
    self.CountNum = require "ArenaStreetFightingManager":GetInstance().Count
    self:InitCombSkill()

    self.ArenaStreetFightingManager = require "ArenaStreetFightingManager":GetInstance()
    self.ArenaStreetFightingManager:RegiestChatCall(_G.handler(self, self.OnEnemyChatCall))
    self.ArenaStreetFightingManager:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
    self.ArenaStreetFightingManager:RegiestEmbattleUpdateCall(_G.handler(self, self.OnEmbattleCall))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineViewClosed, self)

    require("EmbattleController"):GetInstance():OpenEmbattle(
        0,
        _G.EmbattleSaveType.server,
        nil,
        _G.EmbattleControllerItemType.EmbattleItemArenaEmbattle,
        nil,
        nil,
        _G.ConfigManager.discrete_cfg[107904][1][1],
        data
    )
    if itemCall then
        itemCall()
    end
    self.embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
    self.embattleItem:RegiestEmbattleDataChanged(_G.handler(self, self.OnEmbattleChanged))

    self.obj_MidMasktime = _G.ConfigManager.discrete_cfg[107913][1][1]
    self.go_table.obj_MidMask:SetActiveE(1)
    self:obj_MidMask(data)
    self.TimeStarS = _G.TimerManager:GetInstance():GetTimer(1, self.TimeStar, self)
    self.TimeStarS:Start()
    self:ShowPlayerInfo(data.roles.name, data.roles.style, data.roles.frame, data.roles.fail, self.go_table.obj_enemy)
    local PlayerModelIns = _G.PlayerModel:GetInstance()
    local per = self.ArenaStreetFightingManager:GetFail_times()
    self:ShowPlayerInfo(
        PlayerModelIns:GetName(),
        PlayerModelIns:GetRoleStyle(),
        PlayerModelIns:GetCurFrame(),
        per,
        self.go_table.obj_my
    )
    -- self:InitEffect()
end

