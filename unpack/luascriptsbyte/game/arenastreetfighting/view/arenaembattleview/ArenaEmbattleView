function ArenaEmbattleView:UpdateModelLock()
    self.embattleView:RegiestMoveBtnInitCall(_G.handler(self, self.OnEmbattleMoveBtnInitDone))
end

--@_aorimage_chahuaming
function ArenaEmbattleView:OnEmbattleMoveBtnInitDone()
    --TODO:将锁定的模型展示为锁定状态
    local data = self.embattleItem:GetEmbattleData()
    local x, y
    for i = 1, #data do
        if data[i].uid > 0 then
            self.modelLockTrans[i]:SetActiveE(1)
            x, y = self.embattleView:GetEmbatlePos(i)
            self.modelLockTrans[i]:SetLocalPosition(x, y, 0)
            self.embattleView:SetModelGray(i)
            self.embattleView:HideMoveBtns(i, false)
        else
            self.modelLockTrans[i]:SetActiveE(0)
        end
    end
    data = self.embattleItem:GetEnemyEmbattleData()
    for i = 1, #data do
        if data[i].uid > 0 then
            self.modelLockTrans[i + 5]:SetActiveE(1)
            x, y = self.embattleView:GetEmbatlePos(i + 5)
            self.modelLockTrans[i + 5]:SetLocalPosition(x, y, 0)
            self.embattleView:SetModelGray(i + 5)
        else
            self.modelLockTrans[i + 5]:SetActiveE(0)
        end
    end
end

---进入战斗
function ArenaEmbattleView:EnterBattleCall()
    if self.handleChooseTimer then
        self.handleChooseTimer:Stop()
        self.handleChooseTimer = nil
    end
    --TODO:倒计时结束 自动进入战斗 可能还未关闭提示界面
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name)
    --TODO:布阵界面进入战斗
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleViewClosed, self)
    self.embattleView:OnBattleClick(true)
end

---当布阵界面关闭
function ArenaEmbattleView:OnEmbattleViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleViewClosed, self)
        self.ArenaStreetFightingManager:StartBattle()
    end
end

---界面的销毁函数
function ArenaEmbattleView:OnDestroy()
    if self.handleChooseTimer then
        self.handleChooseTimer:Stop()
        self.handleChooseTimer = nil
    end
    if self.TimeStarS then
        self.TimeStarS:Stop()
        self.TimeStarS = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCombineViewClosed, self)
    self.enemySkillobj = nil
    self.enemySkillIcon = nil
    self.CombSkillHandEff = nil
    self.enemySkillType = nil
    self:DispodChatView()
    self.ArenaStreetFightingManager:RegiestChatCall(nil)
    self.ArenaStreetFightingManager:RegiestEmbattleUpdateCall(nil)
    self.ArenaStreetFightingManager:UnRegiestReConnectCall(self.viewName)
    self.ArenaStreetFightingManager = nil
    self.embattleItem:RegiestEmbattleDataChanged(nil)
    self.embattleItem = nil
end

