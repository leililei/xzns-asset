---@class ArenaBrawlMateView : UIBaseView	中文描述
local ArenaBrawlMateView = _G.BaseClass("ArenaBrawlMateView", _G.UIBaseView)
local format = _G.string.format
function ArenaBrawlMateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ArenaStreetFightingManager = require "ArenaStreetFightingManager":GetInstance()
    self.ArenaStreetFightingManager:RegiestReConnectCall(self.viewName, _G.handler(self, self.OnReConnectCall))
    self.GetFail_times = self.ArenaStreetFightingManager:Arcade_queue_in()
end

function ArenaBrawlMateView:OnReConnectCall(enter)
    self.ArenaStreetFightingManager:CurrInfo(
        function()
            if self.refreshTimer then
                self.refreshTimer:Stop()
            end
            if self.showHeadTimer then
                self.showHeadTimer:Stop()
            end
            self:Close()
        end
    )
end

---界面的入口函数
function ArenaBrawlMateView:OnCreate()
    ---1未匹配中，2为匹配后
    self.Arcade_queue = 1
    self.number = 0
    self.enterTiming = _G.ConfigManager.discrete_cfg[107915][1][1]
    self:InitView()
end

---初始化界面
function ArenaBrawlMateView:InitView()
    self:NewData()
    self.go_table.obj_head:SetActiveE(0)
    self.go_table.aorimage_portrait:SetActiveE(1)
    if self.refreshTimer == nil then
        self.refreshTimer = _G.TimerManager:GetInstance():GetTimer(1, self.FuWuQiGuanBi, self, false, false, true)
        self.refreshTimer:Start()
    end
    self.headIconIndex = 1
    self.headIconList = _G.ConfigManager.discrete_cfg[107916][1]
    local TimerManagerIns = _G.TimerManager:GetInstance()
    self.showHeadTimer = TimerManagerIns:GetTimer(0.15, self.ShowCardHeadIcon, self)
    self.showHeadTimer:Start()
end

---展示头像
function ArenaBrawlMateView:ShowCardHeadIcon()
    if self and self.go_table then
        -- body
        --TODO:ArenaBrawlMateView
        local player_portrait = _G.ConfigManager.player_portrait_cfg[self.headIconList[self.headIconIndex]]
        if player_portrait then
            self.go_table.aorimage_portrait.SpriteName = player_portrait.portrait1
        end
        self.headIconIndex = self.headIconIndex + 1
        if self.headIconIndex > #self.headIconList then
            self.headIconIndex = 1
        end
    end
end

---定时器显示
function ArenaBrawlMateView:FuWuQiGuanBi(elapsed)
    if elapsed == nil then
        elapsed = 1
    end
    if self.Arcade_queue == 1 then
        self.number = self.number + elapsed
        self.go_table.aortext_timing.text = math.floor(self.number)
    elseif self.Arcade_queue == 2 then
        self.go_table.obj_head:SetActiveE(1)
        self.go_table.aorimage_portrait:SetActiveE(0)
        self.enterTiming = self.enterTiming - elapsed
        if self.SetPlayerHead == nil then
            self.go_table.aortext_name.text =
                require "ArenaStreetFightingManager":GetInstance().matchPlayerData.roles.name

            self.SetPlayerHead = true
            ---@type Params_PlayerHeadItem
            local Params_PlayerHeadItem = {}
            Params_PlayerHeadItem.frame = require "ArenaStreetFightingManager":GetInstance().matchPlayerData.roles.frame
            Params_PlayerHeadItem.lv = nil
            Params_PlayerHeadItem.style = require "ArenaStreetFightingManager":GetInstance().matchPlayerData.roles.style
            Params_PlayerHeadItem.sid = nil
            Params_PlayerHeadItem.uid = nil
            _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, Params_PlayerHeadItem, 1, true)
        end

        self.go_table.aortext_enterTiming.text = format(_G.GetLangPackValue(90027200008),
            Mathf.RoundToInt(self.enterTiming))
        if self.enterTiming <= 0 then
            require "ArenaStreetFightingManager":GetInstance():EnterEmbattle(
                function()
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaBrawlMateView.Name)
                end
            )
            if self.refreshTimer then
                self.refreshTimer:Stop()
            end
            if self.showHeadTimer then
                self.showHeadTimer:Stop()
            end
        end
    end
end

function ArenaBrawlMateView:EscClose()
    require "ArenaStreetFightingManager":GetInstance():Arcade_queue_abort(
        function()
            self.Arcade_queue = 2
            if self.refreshTimer then
                self.refreshTimer:Stop()
            end
            if self.showHeadTimer then
                self.showHeadTimer:Stop()
            end
            self:Close()
        end
    )
end

function ArenaBrawlMateView:NewData()
    if self.Arcade_queue == 1 then
        self.go_table.obj_IsMating:SetActiveE(1)
        self.go_table.obj_MateSuccess:SetActiveE(0)
    elseif self.Arcade_queue == 2 then
        self.go_table.obj_IsMating:SetActiveE(0)
        self.go_table.obj_MateSuccess:SetActiveE(1)
    end
end

function ArenaBrawlMateView:OnStartClose()
    self.ArenaStreetFightingManager:UnRegiestReConnectCall(self.viewName)
end

---按钮点击事件在这里派发
function ArenaBrawlMateView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_cancel then
        require "ArenaStreetFightingManager":GetInstance():Arcade_queue_abort(
            function()
                self.Arcade_queue = 2
                if self.refreshTimer then
                    self.refreshTimer:Stop()
                end
                if self.showHeadTimer then
                    self.showHeadTimer:Stop()
                end
                self:Close()
            end
        )
    end
end

return ArenaBrawlMateView
