---@class ArenaMainView : UIBaseView	中文描述
local ArenaMainView = _G.BaseClass("ArenaMainView", _G.UIBaseView)

function ArenaMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaMainView:OnCreate()
    -- 这段代码用于更新竞技场主界面的倒计时和资源信息

    -- 获取竞技场倒计时信息
    local endTime, countdown = require "ArenaStreetFightingManager":GetInstance():IsTime()
    self.CountDownTime = countdown

    -- 如果倒计时小于等于0，则关闭界面并返回
    if self.CountDownTime <= 0 then
        self:Close()
        return
    end

    -- 更新倒计时文本
    self.go_table.aortext_OpenTime.text =
        _G.LangUtil.GetLangPackValue(90022500333) ..
        ":" .. require "ArenaStreetFightingManager":GetInstance():TranslateSecondForStrMiaoHui(self.CountDownTime)

    -- 创建定时器，并在倒计时结束后调用OnTimeCall函数
    self.timer = _G.TimerManager:GetInstance():GetTimer(10, self.OnTimeCall, self, false, false)
    self.timer:Start()

    -- 获取资源列表
    local resources = _G.ConfigManager.ui_cfg.ArenaMainView.resources

    -- 如果资源列表不为空，则添加资源组件
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_ResourceRoot,
            require("ResourceCompont").New(self.go_table.obj_ResourceRoot, resources)
        )
    end

    -- 获取卡牌数量和列表
    self.CountNum = require "ArenaStreetFightingManager":GetInstance().Count
    self.card_list = require "ArenaStreetFightingManager":GetInstance():GetCard_list()

    -- 获取最大值
    self.IsMax = _G.ConfigManager.discrete_cfg[107905][1][2]
    self.IsSi = _G.ConfigManager.discrete_cfg[107905][1][1]

    -- 初始化视图
    self.CardList = {}
    self:InitView()

    -- 获取卡牌数据
    self.CardData = require "ArenaStreetFightingManager":GetInstance().CardData

    -- 初始化卡牌列表
    self.go_table.scrollloopvectical_ItemList:InitItemData(self.CountNum, _G.handlerbind(self, self.RefreshList))

    -- 初始化边框列表
    self.go_table.scrollloopvectical_YuanFrame:InitItemData(3, _G.handlerbind(self, self.Frame))

    -- 初始化组合技能
    self:InitCombSkill()
end

-- 当时间调用时的回调函数
function ArenaMainView:OnTimeCall(elapsed)
    if self.CountDownTime > 0 then
        self.CountDownTime = self.CountDownTime - elapsed

        -- 更新倒计时文本
        self.go_table.aortext_OpenTime.text =
            _G.LangUtil.GetLangPackValue(90022500333) ..
            ":" .. require "ArenaStreetFightingManager":GetInstance():TranslateSecondForStrMiaoHui(Mathf.RoundToInt(self.CountDownTime))
    else
        self.timer:Stop()
    end
end

-- 函数功能：处理竞技场主界面的结算逻辑
function ArenaMainView:JieShu()
    -- 获取胜利次数
    local GetWin_times = require "ArenaStreetFightingManager":GetInstance():GetWin_times()
    -- 判断胜利次数是否达到最大值
    if GetWin_times >= self.IsMax then
        -- 停止计时器
        if self.timer then
            self.timer:Stop()
        end
        -- 打开竞技场布阵奖励界面（类型为1）
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaEmbattleAwardView.Name, 1)
        -- 判断失败次数是否达到最大值
    elseif self.GetFail_times >= self.IsSi then
        -- 停止计时器
        if self.timer then
            self.timer:Stop()
        end
        -- 打开竞技场布阵奖励界面（类型为2）
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaEmbattleAwardView.Name, 2)
    end
end

---初始化界面
function ArenaMainView:InitView()
    -- 获取失败次数
    self.GetFail_times = require "ArenaStreetFightingManager":GetInstance():GetFail_times()
    -- 获取胜利次数
    self.GetWin_times = require "ArenaStreetFightingManager":GetInstance():GetWin_times()
    -- 更新所有滚动循环垂直元素
    self.go_table.scrollloopvectical_YuanFrame:UpdateAllItem()
    -- 更新AorimageNum
    self:AorimageNum()
    -- 结束
    self:JieShu()
end

---胜场展示
function ArenaMainView:AorimageNum()
    self.go_table.aorimage_num.SpriteName = "ui_tslb_" .. self.GetWin_times .. "_txt"
end

---战绩刷新
function ArenaMainView:Frame(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    if self.GetFail_times >= x then
        tb.aorimage_HuoYun:SetActiveE(1)
    else
        tb.aorimage_HuoYun:SetActiveE(0)
    end
end

---卡牌库刷新
function ArenaMainView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    self.CardList[x] = tb
    self:Crad_list(x)
    return item
end

-- @function Crad_list
-- @param i 索引值
-- @desc 更新卡牌列表中的数据
function ArenaMainView:Crad_list(i)
    local data = self.card_list[i]
    if data ~= nil then
        self.CardList[i].aorimage_kong:SetActiveE(0)
        self.CardList[i].obj_node:SetActiveE(1)
        self.CardList[i].lua = require("ItemCardBodyBaseView").New(self.CardList[i].obj_node)
        self.CardData[data].skinIs = false
        self.CardList[i].lua:ShowCardData(self.CardData[data], nil, true)
        self.CardList[i].lua.gameObject:SetName(self.CardData[data].sid)
    else
        self.CardList[i].obj_node:SetActiveE(0)
        self.CardList[i].aorimage_kong:SetActiveE(1)
    end
end

--region 合击技显示
---初始化合击技
function ArenaMainView:InitCombSkill()
    self.combSkillUnLock = require "ArenaStreetFightingManager":GetInstance():GetCombine()
    if not self.combSkillUnLock[1] then
        self.go_table.obj_combSkill:SetActiveE(0)
        return
    end
    self.go_table_skill = _G.GetAutoGoTable(self.go_table.obj_combSkill, _G.handler(self, self.OnClickBtnCombSkill))
    self.skillItems = {
        {
            btngo = self.go_table_skill.aorbtn_1,
            go = self.go_table_skill.obj_combGO1,
            icon = self.go_table_skill.aorrawimage_icon1,
            text = self.go_table_skill.aortext_type1,
            lock = self.go_table_skill.obj_lock1,
            redpoint = self.go_table_skill.obj_redpoint1,
            typeText = self.go_table_skill.aortext_type11,
            typeObj = self.go_table_skill.obj_type1,
            condition = self.go_table_skill.aortext_condition1
        },
        {
            btngo = self.go_table_skill.aorbtn_2,
            go = self.go_table_skill.obj_combGO2,
            icon = self.go_table_skill.aorrawimage_icon2,
            text = self.go_table_skill.aortext_type2,
            lock = self.go_table_skill.obj_lock2,
            redpoint = self.go_table_skill.obj_redpoint2,
            typeText = self.go_table_skill.aortext_type21,
            typeObj = self.go_table_skill.obj_type2,
            condition = self.go_table_skill.aortext_condition2
        },
        {
            btngo = self.go_table_skill.aorbtn_3,
            go = self.go_table_skill.obj_combGO3,
            icon = self.go_table_skill.aorrawimage_icon3,
            text = self.go_table_skill.aortext_type3,
            lock = self.go_table_skill.obj_lock3,
            redpoint = self.go_table_skill.obj_redpoint3,
            typeText = self.go_table_skill.aortext_type31,
            typeObj = self.go_table_skill.obj_type3,
            condition = self.go_table_skill.aortext_condition3
        }
    }

    self:ShowCombSkill()
end

---合击技技能显示
function ArenaMainView:ShowCombSkill()
    if not self.combSkillUnLock[1] then
        return
    end
    local cfg
    local ConfigManager = _G.ConfigManager
    for i = 1, #self.combSkillUnLock do
        if self.combSkillUnLock[i] then
            self.skillItems[i].lock:SetActiveE(0)
            self.skillItems[i].typeObj:SetActiveE(1)
            if self.combSkillUnLock[i] > 0 then
                self.skillItems[i].go:SetActiveE(1)
                cfg = ConfigManager.card_skills_cfg[self.combSkillUnLock[i]]
                self.skillItems[i].icon:LoadImage(
                    cfg.icon,
                    function(rawimage)
                        rawimage:SetNativeSize()
                    end
                )
                cfg = ConfigManager.battle_skill_cfg[cfg.skills[1]]
                self.skillItems[i].text.text = ConfigManager.language_package_cfg[cfg.Brief]
                self.skillItems[i].redpoint:SetActiveE(0)
            else
                self.skillItems[i].go:SetActiveE(0)
                _G.GameUtil.SetActiveByCondition(
                    self.skillItems[i].redpoint,
                    self.curEmbattleItem:CheckCombineSkillEquip(i, self.curEmbattleIndex)
                )
            end
            self.skillItems[i].typeText.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][i])
        else
            self.skillItems[i].go:SetActiveE(0)
            self.skillItems[i].lock:SetActiveE(1)
            self.skillItems[i].redpoint:SetActiveE(0)
            self.skillItems[i].typeObj:SetActiveE(0)
            local afk = self.curEmbattleItem:GetCombineSkillUnLockCondition(i, self.curEmbattleIndex)
            if afk then
                ---@type afk_cfg
                local cfg = _G.ConfigManager.afk_cfg[afk]
                if cfg then
                    self.skillItems[i].condition:SetActiveE(1)
                    self.skillItems[i].condition.text =
                        _G.LangUtil.GetLangPackValue(90025100003, cfg.chapter, cfg.section)
                else
                    self.skillItems[i].condition:SetActiveE(0)
                end
            else
                self.skillItems[i].condition:SetActiveE(0)
            end
        end
    end
end

---合击技点击技能展示tip
function ArenaMainView:OnClickBtnCombSkill(go)
    local i = 0
    if go == self.go_table_skill.aorbtn_1 then
        i = 1
    elseif go == self.go_table_skill.aorbtn_2 then
        i = 2
    else
        i = 3
    end
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg[self.combSkillUnLock[i]]

    if card_skills_cfg ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(card_skills_cfg.id, nil, false)
    end
end

--endregion

---按钮点击事件在这里派发
function ArenaMainView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.timer then
            self.timer:Stop()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Enter then ---instruction_cfg
        if self.timer then
            self.timer:Stop()
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaBrawlMateView.Name)
    elseif go == self.go_table.aorbtn_FangQi then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            840101,
            nil,
            function()
                require "ArenaStreetFightingManager":GetInstance():Arcade_give_up()
                if self.timer then
                    self.timer:Stop()
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaBrawlEnterView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)
            end,
            nil,
            nil,
            nil
        )
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 63)
        -- body
    end
end

return ArenaMainView
