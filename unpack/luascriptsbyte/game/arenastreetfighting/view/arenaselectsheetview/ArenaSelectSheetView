---@class ArenaSelectSheetView : UIBaseView	中文描述
local ArenaSelectSheetView = _G.BaseClass("ArenaSelectSheetView", _G.UIBaseView)

local CS = _G.CS
local typeof = _G.typeof
function ArenaSelectSheetView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面选择展示
local Eff = {
    ---初始展示
    [1] = "a_ArenaSelectSheetView_repeat",
    --选中后展示
    [2] = "a_$_obj_SingleBlack_open"
}

local ProfessionalBG = {
    [1] = "ui_ty_zhiye_lv",
    [2] = "ui_ty_zhiye_lan",
    [3] = "ui_ty_zhiye_zi",
    [4] = "ui_ty_zhiye_cheng",
    [5] = "ui_ty_zhiye_hong",
    [6] = "ui_ty_zhiye_jin",
    [7] = "ui_ty_zhiye_cai"
}
local Professional = _G.ProfessionalIcon
local elementType = _G.CardElementType
local elementImageName = {
    [elementType.Thunder] = "ui_ty_btn_shaixuan_lei",
    [elementType.Wind] = "ui_ty_btn_shaixuan_feng",
    [elementType.Water] = "ui_ty_btn_shaixuan_shui",
    [elementType.Fire] = "ui_ty_btn_shaixuan_huo",
    [elementType.Earth] = "ui_ty_btn_shaixuan_tu",
    [elementType.God] = "ui_ty_btn_shaixuan_shen"
}
---界面的入口函数
function ArenaSelectSheetView:OnCreate()
    _G.PlayerPrefsManager.SetInt(
        _G.PlayerModel:GetInstance():GetPlayerUid() .. "ArenaStreetFighting",
        _G.TimeUtil.GetSixClockTimer()
    )
    local resources = _G.ConfigManager.ui_cfg.ArenaSelectSheetView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_ResourceRoot,
            require("ResourceCompont").New(self.go_table.obj_ResourceRoot, resources)
        )
    end
    self.MaxInt = 8
    ---奖励列表
    self.award_list = _G.ConfigManager.discrete_cfg[107906][1]
    self.awardList = {}
    self.CardList = {}
    self.CountNum = require "ArenaStreetFightingManager":GetInstance().Count
    self:InitView()
    self.go_table.scrollloopvectical_ItemList:InitItemData(self.CountNum, _G.handlerbind(self, self.RefreshList))
end

---初始化界面
function ArenaSelectSheetView:InitView(id)
    self.card_list = require "ArenaStreetFightingManager":GetInstance():GetCard_list()
    if _G.table.count(self.card_list) >= self.MaxInt then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaSelectSheetView.Name)

        return
    end
    self.GetRandom_cards = require "ArenaStreetFightingManager":GetInstance():GetRandom_cards()
    self.CardData = require "ArenaStreetFightingManager":GetInstance().CardData

    self.go_table.aortext_JieSuo.text =
        _G.string.format(_G.GetLangPackValue(90027200002), _G.table.count(self.card_list) + 1)
    self:InitCombSkill(id)
    if id ~= nil then
        self:Crad_list(_G.table.count(self.card_list))
    end
    self:EffPlay()
end

function ArenaSelectSheetView:InitCombSkill(id)
    for i = 1, 3 do
        local cardData = require "CardCommentManager":GetInstance():CardData(self.GetRandom_cards[i])

        if self.awardList[i] == nil then
            self.awardList[i] =
                _G.GetAutoGoTable(self.go_table["obj_SingleBlack" .. i], _G.handlerbind(self, self.Award_listBtn, i))
        end

        self.awardList[i].aorrawimage_RenWu:LoadImage(
            cardData.Portrait,
            function(image)
                if image then
                    image:SetActiveE(1)
                    image:SetNativeSize()
                    image:SetLocalPosition(
                        cardData.pos_portrait8[1],
                        cardData.pos_portrait8[2],
                        cardData.pos_portrait8[3]
                    )
                    image:SetLocalScaleXYZ(cardData.size8)
                end
            end
        )
        local icon = ProfessionalBG[cardData.Professional]
        if icon ~= nil and self.awardList[i].aorimage_professional ~= nil then
            self.awardList[i].aorimage_professional.SpriteName = icon
            self.awardList[i].aorimage_professional:SetNativeSize()
        end
        icon = Professional[cardData.Professional]

        if icon ~= nil and self.awardList[i].aorimage_professionalIcon ~= nil then
            self.awardList[i].aorimage_professionalIcon.SpriteName = icon
            self.awardList[i].aorimage_professionalIcon:SetNativeSize()
        end
        self.awardList[i].aortext_name.text = _G.ConfigManager.language_package_cfg[_G.tonumber(cardData.Name)]
        self.awardList[i].aorimage_ShuXing.SpriteName = elementImageName[cardData.Elements]
        if cardData.Elements == 6 then
            self.awardList[i].obj_ef_1:SetActiveE(1)
            if self.awardList[i].barAnimator == nil then
                --self.barAnimator:Play(Eff[2])
                self.awardList[i].barAnimator =
                    self.awardList[i].obj_content:GetComponentE(typeof(CS.UnityEngine.Animator))
                self.awardList[i].barAnimator:Play(Eff[2])
            else
                self.awardList[i].barAnimator:Play(Eff[2])
            end
        else
            self.awardList[i].obj_ef_1:SetActiveE(0)
        end
        self.awardList[i].obj_ef_2:SetActiveE(0)
        self.awardList[i].obj_ef_3:SetActiveE(0)
        if id == i then
            self.awardList[i].obj_ef_2:SetActiveE(1)
            self.awardList[i].obj_ef_3:SetActiveE(0)
        else
            self.awardList[i].obj_ef_2:SetActiveE(0)
            self.awardList[i].obj_ef_3:SetActiveE(1)
        end
        -- self:EffPlay(i, id)
    end
end

---奖励领取
function ArenaSelectSheetView:Award_listBtn(go, _, id)
    local name = go:GetName()
    local cardData = require "CardCommentManager":GetInstance():CardData(self.GetRandom_cards[id])
    if name == "@_aorbtn_Tishi" then
        -- require("CommonTipManager"):GetInstance():OpenSkillTip(go.gameObject, cardData.id, nil, nil)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            cardData.id,
            function()
            end,
            true,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            1
        )
    elseif name == "@_aorbtn_HuangSeanniu" then
        require "ArenaStreetFightingManager":GetInstance():SelectCards(
            cardData.id,
            _G.handlerbind(self, self.InitView, id)
        )
    end
end

function ArenaSelectSheetView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    self.CardList[x] = tb
    self:Crad_list(x)
    return item
end

---针对单个item的刷新
function ArenaSelectSheetView:Crad_list(i)
    local data = self.card_list[i]
    if data ~= nil then
        self.CardList[i].aorimage_kong:SetActiveE(0)
        self.CardList[i].obj_node:SetActiveE(1)
        self.CardData[data].skinIs = false
        self.CardList[i].lua = require("ItemCardBodyBaseView").New(self.CardList[i].obj_node)
        self.CardList[i].lua:ShowCardData(self.CardData[data], nil, true)
        self.CardList[i].lua.gameObject:SetName(self.CardData[data].sid)
    else
        self.CardList[i].obj_node:SetActiveE(0)

        self.CardList[i].aorimage_kong:SetActiveE(1)
    end
end
---特效展示效果
function ArenaSelectSheetView:EffPlay(id)
    -- if self.awardList[id] == nil then
    --     return
    -- end
    if self.barAnimator == nil then
        self.barAnimator = self.go_table.gameObject:GetComponentE(typeof(CS.UnityEngine.Animator))
        -- self.barAnimator:Play(Eff[1])
        return
    end
    -- self.awardList[id].barAnimator:Play(Eff[2])

    self.barAnimator:Play(Eff[1])
end
---按钮点击事件在这里派发
function ArenaSelectSheetView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Enter then ---instruction_cfg
        self:Aorbtn_Enter()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 63)
    end
end

return ArenaSelectSheetView
