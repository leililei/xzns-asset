---@class ArenaSeasonPeakTaskView : UIBaseView	中文描述
local ArenaSeasonPeakTaskView = _G.BaseClass("ArenaSeasonPeakTaskView", _G.UIBaseView)

local langID = {
    --本期结束时间
    Time = "90002720024"
}

function ArenaSeasonPeakTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaSeasonPeakTaskView:OnCreate(call)
    -- self.battle_info = require "ArenaStreetFightingManager":GetInstance().battle_info
    if call then
        self.call = call
    end
    self:UpdataNew()
end

function ArenaSeasonPeakTaskView:LingQu()
    local coin = {}
    for key, value in pairs(require "ArenaStreetFightingManager":GetInstance().task_cfg) do
        if require "ArenaStreetFightingManager":GetInstance().all_win >= value.condition then
            if not require "ArenaStreetFightingManager":GetInstance():GetAward_listBool(value.sid) then
                _G.table.insert(coin, value.sid)
            end
        end
    end
    if #coin > 1 then
        self.go_table.aorbtn_getAll:SetActiveE(1)
    else
        self.go_table.aorbtn_getAll:SetActiveE(0)
    end
end

---页面显示
function ArenaSeasonPeakTaskView:UpdataNew()
    self.DianJie = true
    self.GetAll_win = require "ArenaStreetFightingManager":GetInstance():GetAll_win()

    self.countCfgArr = require "ArenaStreetFightingManager":GetInstance().task_cfg
    if self.P_LoopInit == nil then
        self.go_table.scrollloopvectical_taskList:InitItemData(#self.countCfgArr, _G.handler(self, self.RefreshList))
        self.P_LoopInit = true
    else
        self.go_table.scrollloopvectical_taskList:UpdateAllItem()
    end
    self:LingQu()
end
---奖励领取
function ArenaSeasonPeakTaskView:Award_listBtn(go, _, num)
    require "ArenaStreetFightingManager":GetInstance():GetAward(num, _G.handler(self, self.OnCreate))
end
function ArenaSeasonPeakTaskView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.countCfgArr[index]

    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.Award_listBtn, data.sid))

    local expslider, lvs = 0, 0
    lvs = self.GetAll_win
    if self.GetAll_win >= 0 then
        expslider = self.GetAll_win / data.condition
        if expslider > 1 then
            expslider = 1
        end
        if self.GetAll_win > data.condition then
            lvs = data.condition
        end
    end
    itemGoTable.aortext_name.text = _G.LangUtil.GetLangPackValue(langID.Time, data.condition)

    itemGoTable.slider_progress.value = expslider
    itemGoTable.aortext_Slider.text = lvs .. "/" .. data.condition
    itemGoTable.obj_AwardItem:ClearChildren()
    for key, value in pairs(data.award) do
        local tb = _G.InstantiateObject(self.go_table.obj_award, itemGoTable.obj_AwardItem)

        self:RefreshAwardItem({value.sid, value.num}, tb, data.sid)
    end
    local tb = _G.InstantiateObject(self.go_table.obj_award, itemGoTable.obj_AwardItem)

    self:RefreshAwardItem({107, data.battle_exp}, tb, data.sid)

    itemGoTable.aorimage_get:SetActiveE(0)
    itemGoTable.aortext_unGet:SetActiveE(0)
    itemGoTable.aorimage_complete:SetActiveE(0)
    itemGoTable.aorbtn_get:SetActiveE(0)
    if expslider == 1 then
        local bool = require "ArenaStreetFightingManager":GetInstance():GetAward_listBool(data.sid)
        if bool then
            itemGoTable.aorimage_complete:SetActiveE(1)
        else
            itemGoTable.aorimage_get:SetActiveE(1)
            itemGoTable.aorbtn_get:SetActiveE(1)
        end
    else
        itemGoTable.aortext_unGet:SetActiveE(1)
    end

    return objGame
end

function ArenaSeasonPeakTaskView:RefreshAwardItem(value, tb, id)
    local tbs = _G.GetAutoGoTable(tb, _G.handlerbind(self, self.BattleAward))
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        value,
        tbs.obj_Root,
        function(item)
            item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            local rect = item.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            rect:SetRectTransformSize(100, 100)
        end
    )
    tbs.gameObject:SetActiveE(1)
    local Get = 0
    local bool = require "ArenaStreetFightingManager":GetInstance():GetAward_listBool(id)

    if bool then
        Get = 1
    end
    -- local guo = require "ArenaStreetFightingManager":GetInstance():GetAward_listBool(battlecon_cfg.id)

    tbs.obj_gou:SetActiveE(Get)
end

---按钮点击事件在这里派发
function ArenaSeasonPeakTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        if self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        if self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_getAll then
        -- body
        require "ArenaStreetFightingManager":GetInstance():GetAwardMax(_G.handler(self, self.UpdataNew))
    end
end

return ArenaSeasonPeakTaskView
