---@class ArenaEmbattleAwardView : UIBaseView	中文描述
local ArenaEmbattleAwardView = _G.BaseClass("ArenaEmbattleAwardView", _G.UIBaseView)

local Reward = {
    [1] = "Images/ArenaBrawl/ui_jjld_dhqs_txt",
    [2] = "Images/ArenaBrawl/ui_jjld_tzxb_txt",
    [3] = "Images/CommonAward/ui_ty_huodetish_role_gua",
    [4] = "Images/ArenaBrawl/ui_ty_huodetish_role_gua2"
}
function ArenaEmbattleAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function ArenaEmbattleAwardView:OnCreate(num)
    self.CountNum = require "ArenaStreetFightingManager":GetInstance().Count
    self.card_list = require "ArenaStreetFightingManager":GetInstance():GetCard_list()
    self.CardList = {}
    self.CardData = require "ArenaStreetFightingManager":GetInstance().CardData
    self.go_table.scrollloopvectical_ItemList:InitItemData(self.CountNum, _G.handlerbind(self, self.RefreshList))
    if num == 1 then
        self.go_table.obj_Effect:SetActiveE(1)
    else
        self.go_table.obj_Effect:SetActiveE(0)
    end
    self.go_table.aorrawimage_font:LoadImage(
        Reward[num],
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
    self.go_table.aorrawimage_ball:LoadImage(
        Reward[num + 2],
        function(image)
            if image then
                image:SetActiveE(1)
                image:SetNativeSize()
            end
        end
    )
end

---卡牌库刷新
function ArenaEmbattleAwardView:RefreshList(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    self.CardList[x] = tb
    self:Crad_list(x)
    return item
end

function ArenaEmbattleAwardView:Crad_list(i)
    local data = self.card_list[i]
    if data ~= nil then
        self.CardList[i].aorimage_kong:SetActiveE(0)
        self.CardList[i].obj_node:SetActiveE(1)
        self.CardData[data].skinIs = false
        self.CardList[i].lua = require("ItemCardBodyBaseView").New(self.CardList[i].obj_node)
        self.CardList[i].lua:ShowCardData(self.CardData[data], nil, true)
        self.CardList[i].lua.gameObject:SetName(self.CardData[data].sid)
    else
        self.CardList[i].obj_node:SetActiveE(0)

        self.CardList[i].aorimage_kong:SetActiveE(1)
    end
end

--endregion

function ArenaEmbattleAwardView:EscClose()
    require "ArenaStreetFightingManager":GetInstance():Arcade_give_up()

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaBrawlEnterView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)

    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaEmbattleAwardView.Name)
end
---按钮点击事件在这里派发
function ArenaEmbattleAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        require "ArenaStreetFightingManager":GetInstance():Arcade_give_up()

        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ArenaBrawlEnterView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainView.Name)

        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaEmbattleAwardView.Name)
    end
end

return ArenaEmbattleAwardView
