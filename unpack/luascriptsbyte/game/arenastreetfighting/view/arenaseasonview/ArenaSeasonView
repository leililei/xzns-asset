---@class ArenaSeasonView : UIBaseView	中文描述
local ArenaSeasonView = _G.BaseClass("ArenaSeasonView", _G.UIBaseView)

local langID = {
    --本期结束时间
    Time = "90027200022",
    --级
    lv = "9002070021"
}

function ArenaSeasonView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ArenaSeasonView:OnCreate(call)
    if call then
        self.call = call
    end
    -- self.battle_info = require "ArenaStreetFightingManager":GetInstance().battle_info
    self.id = 703001
    local endTime, countdown = require "ArenaStreetFightingManager":GetInstance():IsTime()
    self.CountDownTime = countdown
    self.go_table.aortext_hdcqsj.text =
        _G.LangUtil.GetLangPackValue(
            langID.Time,
            require "ArenaStreetFightingManager":GetInstance():TranslateSecondForStrMiaoHui(self.CountDownTime)
        )

    self.timer = _G.TimerManager:GetInstance():GetTimer(10,self.OnTimeCall, self, false, false)
    self.timer:Start()

    self:UpdataNew()

    local openTime = require "ArenaStreetFightingManager":GetInstance():GetOpenTime()
    local delta = _G.ConfigManager.discrete_cfg[107917][1][1]
    self.AddBtnTime = openTime + delta
    self:ShowAddBtn()
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData)
end

---资源加载
function ArenaSeasonView:AddRest()
    self.resKey = {
        AddExp = "UI/SeasonLvView/SeasonLvView_AddExp"
    }

    if self.prb_AddExp == nil then
        self:AddResToList(self.resKey.AddExp, _G.UIResType.pool, self.resKey.AddExp, nil, self.go_table.obj_view)
    end
end

function ArenaSeasonView:SetData()
    local sc = self.ResList[self.resKey.AddExp]
    if sc ~= nil then
        self.prb_AddExp = sc
    end
    self.lua_AddExp = require("ArenaSeasonView_AddExp").New(self.prb_AddExp, self)
    self.lua_AddExp:Hide()
end

function ArenaSeasonView:ShowAddBtn()
    ---true显示加速按钮
    local isShowAddExpBtn = _G.TimeUtil.GetServerUnixTime() >= self.AddBtnTime
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_add, isShowAddExpBtn)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_task, (not isShowAddExpBtn))
end

---页面显示
function ArenaSeasonView:UpdataNew()
    self.DianJie = true
    self:is_buy()
    self:Expslider()
    self.countCfgArr = _G.ConfigManager.store_season_battle_cfg[self.id].content
    if self.P_LoopInit == nil then
        self.go_table.scrollloophorizontal_items:InitItemData(#self.countCfgArr, _G.handler(self, self.RefreshList))
        self.P_LoopInit = true
    else
        self.go_table.scrollloophorizontal_items:UpdateAllItem()
    end
    self:JumpToList()
end

--- 列表跳转函数
---@param index number 索引
function ArenaSeasonView:JumpToList()
    local free_award, pay_award = require "ArenaStreetFightingManager":GetInstance():Award()
    local index = 0
    if free_award and #free_award > 0 then
        for key, value in pairs(self.countCfgArr) do
            if value == free_award[1] then
                index = key
            end
        end
    end
    if pay_award and #pay_award > 0 then
        for key, value in pairs(self.countCfgArr) do
            if value == pay_award[1] then
                if index == 0 then
                    index = key
                elseif index > value then
                    index = key
                end
            end
        end
    end
    self.go_table.scrollloophorizontal_items:ScrollToIndex(index - 1)
end

-- 刷新列表
-- @param index 索引
-- @param objGame 游戏对象
-- @return objGame 刷新后的游戏对象
function ArenaSeasonView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    index = index + 1
    local data = self.countCfgArr[index]
    local battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg[data]
    local itemGoTable = _G.GetAutoGoTable(objGame)
    itemGoTable.aortext_lv.text = battlecon_cfg.level .. _G.LangUtil.GetLangPackValue(langID.lv)
    itemGoTable.obj_item1:ClearChildren()
    for key, value in pairs(battlecon_cfg.rewards_normal) do
        local tb = _G.InstantiateObject(self.go_table.obj_item, itemGoTable.obj_item1)

        self:RefreshAwardItem(value, tb, battlecon_cfg, 1)
    end
    itemGoTable.obj_item2:ClearChildren()

    for key, value in pairs(battlecon_cfg.rewards_pay) do
        local tb = _G.InstantiateObject(self.go_table.obj_item, itemGoTable.obj_item2)

        self:RefreshAwardItem(value, tb, battlecon_cfg, 2)
    end
    return objGame
end

-- 刷新奖励项
-- @param value 奖励值
-- @param tb 奖励项对象
-- @param battlecon_cfg 战斗配置
-- @param num 数量
function ArenaSeasonView:RefreshAwardItem(value, tb, battlecon_cfg, num)
    local tbs = _G.GetAutoGoTable(tb, _G.handlerbind(self, self.BattleAward))

    tbs.gameObject:SetActiveE(1)
    tbs.aorbtn_get:SetActiveE(1)

    local eff = false
    local guo
    if num == 1 then
        guo = require "ArenaStreetFightingManager":GetInstance():free_award(battlecon_cfg.id)
    else
        guo = require "ArenaStreetFightingManager":GetInstance():pay_award(battlecon_cfg.id)
    end
    tbs.obj_gou:SetActiveE(guo)

    if guo == 0 then
        local nums = require "ArenaStreetFightingManager":GetInstance():Islv()
        if nums < battlecon_cfg.level then
            tbs.obj_suo:SetActiveE(1)

            tbs.aorbtn_get:SetActiveE(0)
        else
            eff = true
            tbs.obj_suo:SetActiveE(0)
        end
    else
        tbs.aorbtn_get:SetActiveE(0)
    end
    if num == 2 then
        local is = require "ArenaStreetFightingManager":GetInstance():IsBut()
        if is == 0 then
            tbs.obj_gou:SetActiveE(0)
            tbs.aorbtn_get:SetActiveE(0)
            tbs.obj_suo:SetActiveE(1)
        end
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        value,
        tbs.obj_item1,
        function(item)
            item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            local rect = item.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            rect:SetRectTransformSize(100, 100)
            item:ShowEffect(eff)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, value[1], nil, nil)
        end
    )
end

---点击领取所有可领项目
function ArenaSeasonView:BattleAward()
    if self.DianJie then
        self.DianJie = false
        require "ArenaStreetFightingManager":GetInstance():BattleAward(_G.handlerbind(self, self.UpdataNew))
    end
end

---等级经验显示
function ArenaSeasonView:Expslider()
    local lv = require "ArenaStreetFightingManager":GetInstance():Islv()
    self.go_table.aortext_lv.text = lv
    local expslider, lvs, MaxLv = require "ArenaStreetFightingManager":GetInstance():Expslider()

    self.go_table.slider_jdtdi.value = expslider
    if lvs > MaxLv then
        lvs = MaxLv
    end
    self.go_table.aortext_exp.text = lvs .. "/" .. MaxLv
end

--购买按钮显示和价格刷新
function ArenaSeasonView:is_buy()
    local is = require "ArenaStreetFightingManager":GetInstance():IsBut()
    if is == 0 then
        self.go_table.aorbtn_getExp:SetActiveE(1)
    else
        self.go_table.aorbtn_getExp:SetActiveE(0)
    end
    if is == 0 then
        ---@type store_season_battle_cfg
        self.cfg = _G.ConfigManager.store_season_battle_cfg[self.id]

        _G.GameUtil.SetPriceByChannel(self.cfg.price_id, self.go_table.aortext_tips)
        self.go_table.aortext_nums.text = self.cfg.goods[1][2]

        --self.go_table.aortext_tips.text = ""
    end
end

---倒计时
function ArenaSeasonView:OnTimeCall(elapsed)
    if self.CountDownTime > 0 then
        self.CountDownTime = self.CountDownTime - elapsed

        self.go_table.aortext_hdcqsj.text =
            _G.LangUtil.GetLangPackValue(
                langID.Time,
                require "ArenaStreetFightingManager":GetInstance():TranslateSecondForStrMiaoHui(Mathf.RoundToInt(self.CountDownTime))
            )
        self:ShowAddBtn()
    else
        self.timer:Stop()
        self:Close()
    end
end

---按钮点击事件在这里派发
function ArenaSeasonView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.timer then
            self.timer:Stop()
        end
        if self.call then
            self.call()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_tishi then
        -- body
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 71)
    elseif go == self.go_table.aorbtn_task then
        -- body
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ArenaSeasonPeakTaskView.Name,
            _G.handler(self, self.UpdataNew)
        )
    elseif go == self.go_table.aorbtn_add then
        local maxLv = #self.countCfgArr
        local lv = require "ArenaStreetFightingManager":GetInstance():Islv()
        if lv == maxLv then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        else
            self.lua_AddExp:Show(lv, maxLv)
        end
    elseif go == self.go_table.aorbtn_getExp then
        require "ArenaStreetFightingManager":GetInstance():BuyUp(_G.handler(self, self.UpdataNew))
    end
end

return ArenaSeasonView
