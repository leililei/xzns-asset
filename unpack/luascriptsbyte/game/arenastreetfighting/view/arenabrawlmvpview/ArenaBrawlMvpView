local SettlementBaseView = require "SettlementBaseView"
---@class ArenaBrawlMvpView : UIBaseView	中文描述
---@field public go_table ArenaBrawlMvpView_GoTable GoTable
local ArenaBrawlMvpView = _G.BaseClass("ArenaBrawlMvpView", SettlementBaseView)

---界面的入口函数
function ArenaBrawlMvpView:OnCreateChild(data)
    self.winner = data.winner
    self.otherInfo = data.otherInfo or data.enemy
    self.re_uid = data.re_uid
    self.reportType = data.reportType

    self.defender = 1
    if data.fight_arg.atk_uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
        self.defender = 0
    end
    self.mvpData = data.mvpData
    self.GetFail_times = require "ArenaStreetFightingManager":GetInstance():GetFail_times()
    self.GetWin_times = require "ArenaStreetFightingManager":GetInstance():GetWin_times()
    self.go_table.aorimage_num.SpriteName = "ui_tslb_" .. self.GetWin_times .. "_txt"
    self.go_table.scrollloophorizontal_YuanFrame:InitItemData(3, _G.handlerbind(self, self.Frame))
    self:OpenEmbattleView()
end

---战绩刷新
function ArenaBrawlMvpView:Frame(index, listView2)
    if index < 0 then
        return
    end
    local item = listView2
    local x = index + 1
    item:SetName(x)
    local tb = _G.GetAutoGoTable(item)
    if self.GetFail_times >= x then
        tb.aorimage_HuoYun:SetActiveE(1)
    else
        tb.aorimage_HuoYun:SetActiveE(0)
    end
end
function ArenaBrawlMvpView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    local result = {}
    result.iSWin = self.winner == 0
    result.statistics = true
    result.btnDisplay = false
    result.otherInfo = self.otherInfo
    result.re_uid = self.re_uid
    result.reportType = self.reportType
    result.hidePetBtn = true
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, self.callback, result)
end

function ArenaBrawlMvpView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:NextChapterClose()
    end
end

---监听界面
---@param name string 界面名称
function ArenaBrawlMvpView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
        )
        view.transform:SetParentE(self.go_table.trans_view)
        view:SetTipsHide(false)
        view:SetFightBtnBool(0)
        self.go_table.obj_info:SetActiveE(1)
    end
end
---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function ArenaBrawlMvpView:OnShowView(name, OnSettlementEndCall, result)
    _G.UIManager:GetInstance():OpenWindow(
        name,
        OnSettlementEndCall,
        result,
        nil,
        nil,
        nil,
        nil,
        self.mvpData,
        self.defender
    )
end
---监听界面
---@param name string 界面名称
function ArenaBrawlMvpView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self:Close()
    end
end

return ArenaBrawlMvpView
