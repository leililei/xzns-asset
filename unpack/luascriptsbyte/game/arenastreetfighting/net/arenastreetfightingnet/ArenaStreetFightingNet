---@class ArenaStreetFightingNet : BaseGameNet 通信协议
local ArenaStreetFightingNet = _G.BaseClass("ArenaStreetFightingNet", require("BaseGameNet"))
local base = require("BaseGameNet")
---@return ArenaStreetFightingNet ArenaStreetFightingNet
function ArenaStreetFightingNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--领取奖励
---@param callback function 回调方法
function ArenaStreetFightingNet:SelectCards(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_arcade_select_cards
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.AccessCall))
    self.Call[port] = callback
    -- body
end

