local base = require "BaseItemData"
local LingRankItemData = require("LingRankItemData")

---@class RankData	中文描述
local RankData = _G.BaseClass("RankData", base)
_G.RankData = RankData

local CS = _G.CS
local typeof = _G.typeof

---@field type_rank_enum number 榜单类型
---@field rankList number 章节信息
---@field nodes table 节点信息
---@field award table 已领取节点
---类的构造函数
function RankData:__init()
    self.type_rank_enum = 1
    self.rankList = {}
    self.red_count = 0
end

---类的析构函数
function RankData:Dispose()
    self.type_rank_enum = nil
    self.rankList = nil
    self.award = nil
    self.red_count = nil
end
function RankData:ParseInitMsg(type)
    self:SetTypeRankEnum(type)
    self:InitRanList()
end
--region 初始化
function RankData:InitRanList()
    local cfg = _G.ConfigManager.rank_cfg
    for key, value in pairs(cfg) do
        if self.type_rank_enum == value.type_rank then
            local itemData = LingRankItemData.New()
            itemData:SetRankSid(value.id)
            itemData:SetPlayerName("")
            itemData:SetPlayerFrame(0)
            itemData:SetPlayerUid(0)
            itemData:Setplaye_level(0)
            itemData:SetPlayerHead(0)
            itemData:SetValueSid(0)
            itemData:SetCityStyle(0)
            itemData:SetHaloSid(0)
            itemData:SetGuildName("")
            itemData:SetisRank(false)
            itemData:SetTypeRankID(self.type_rank_enum)
            itemData:SetReward()
            itemData:SetAwardState(_G.rank_state_enum.nolingqu)
            itemData:SetBiaoTi()
            self:SetRankList(value.id, itemData)
        end
    end
end
--region 设置
---设置节点信息
function RankData:SetRankListNode(nodes)
    if _G.table.isEmptyOrNil(nodes) then
        return
    end
    for i = 1, #nodes do
        local itemData = LingRankItemData.New()
        itemData:SetTypeRankID(self.type_rank_enum)
        itemData:SetPlayerUid(nodes[i].role_uid)
        itemData:SetRankSid(nodes[i].sid)
        itemData:SetPlayerName(nodes[i].name)
        itemData:SetPlayerFrame(nodes[i].frame)
        itemData:Setplaye_level(nodes[i].lv)
        itemData:SetPlayerHead(nodes[i].portrait)
        itemData:SetCityStyle(nodes[i].city_style)
        itemData:SetHaloSid(nodes[i].halo_sid)
        itemData:SetValueSid(nodes[i].value)
        itemData:SetGuildName(nodes[i].guild_name)
        itemData:SetPlayerPowar(nodes[i].power)
        itemData:SetAwardState(_G.rank_state_enum.lingqu)
        itemData:SetReward()
        itemData:SetisRank(true)
        itemData:SetBiaoTi()
        itemData:SetFinshTime(nodes[i].time)
        itemData:SetPlayerTitle(nodes[i].title)
        itemData:SetSnapShotTitle(nodes[i].snapshot_title)
        itemData:SetSnapShotHalo(nodes[i].snapshot_halo)
        itemData:SetPlayerPoint(nodes[i].point)
        self.red_count = self.red_count + 1
        self:SetRankList(nodes[i].sid, itemData)
    end
end
---设置节点 是否已经领取 奖励
function RankData:SetRankAward(award)
    if _G.table.isEmptyOrNil(award) then
        return
    end
    for i = 1, #award do
        local item = self:GetRankList(award[i])
        self.red_count = self.red_count - 1
        item:SetAwardState(_G.rank_state_enum.yilingqu)
    end
end
---设置RankList
function RankData:SetRankList(sid, data)
    self.rankList[sid] = data
end
function RankData:GetRankList(sid)
    return self.rankList[sid]
end
---设置榜单类型
function RankData:SetTypeRankEnum(enum)
    self.type_rank_enum = enum
end
function RankData:GetTypeRankEnum()
    return self.type_rank_enum
end
--endregion

return RankData
