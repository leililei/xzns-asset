---获得 每个榜单的第一名
function LingRankModel:GetDataFormSeverRankFirstInfo(call)
    LingRankNet:GetInstance():AccessRankFirstInfo(_G.handlerbind(self, self.RecallbackRankFirstInfo, call))
end
function LingRankModel:RecallbackRankFirstInfo(data, call)
    if _G.table.isEmptyOrNil(data.roles) then
        return
    end
    for i = 1, #data.roles do
        local itemData = LingRankItemData.New()
        itemData:SetTypeRankID(data.roles[i].type)
        itemData:Parse(data.roles[i])
        itemData:SetPlayerName(data.roles[i].name)
        itemData:SetPlayerFrame(data.roles[i].frame)
        itemData:Setplaye_level(data.roles[i].lv)
        itemData:SetPlayerHead(data.roles[i].portrait)
        itemData:SetValueSid(data.roles[i].value)
        itemData:SetRankIsJifenHuoGuanKa()
        self.rankFirst[i] = itemData
    end
    _G.table.sort(
        self.rankFirst,
        function(a, b)
            return a:GetTypeRankId() < b:GetTypeRankId()
        end
    )
    if call then
        call()
    end
end
