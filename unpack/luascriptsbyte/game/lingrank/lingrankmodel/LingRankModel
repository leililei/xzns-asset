---递归加载数据
---@private
function LingRankModel:RecurrenceLoadData(type)
    if type < 9 then
        self:RankAllPlayerProto(
            type,
            function()
                self:GetDataFormSeverRankNodeInfo(
                    type,
                    function()
                        self:RecurrenceLoadData(type + 1)
                    end
                )
            end
        )
    else
        self:ParseData()
    end
end

function LingRankModel:ParseData()
    self.ParseCount = self.ParseCount - 1
    if self.ParseCount <= 0 then
        self.super.ParseData(self)
    end
end
---获得点赞信息
function LingRankModel:GetDataFormSeverDayPoint()
    LingRankNet:GetInstance():GetRankDayPointDone(_G.handlerbind(self, self.GetDayPointCall))
end
---每日点赞奖励是否未领取
function LingRankModel:CheckDayPointAward()
    return _G.table.isEmptyOrNil(self.ALLPointDone)
end
---玩家是否被自己点赞
---@param type number _G.type_rank_enum
---@param uid number 玩家uid
function LingRankModel:IsPointDone(uid)
    if not self.ALLPointDone then
        return
    end
    return self.ALLPointDone[uid]
end
---@return boolean 是否可以点赞
function LingRankModel:CanPoint(type, uid)
    if not self.ALLPointDone then
        return
    end
    ---现在可以点自己
    --if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
    --    _G.PopWindowManager:GetInstance():ShowAllTips(740105)
    --    return
    --end
    if self.ALLPointCount[type] then
        if self.ALLPointCount[type] < _G.ConfigManager.discrete_cfg[109102][1][2] then
            if not self.ALLPointDone[uid] then
                return true
            else
                ---已点
                _G.PopWindowManager:GetInstance():ShowAllTips(740104)
            end
        else
            ---次数已满
            _G.PopWindowManager:GetInstance():ShowAllTips(740103)
        end
    end
    return false
end
function LingRankModel:GetDayPointCall(data)
    self.ALLPointDone = {}
    self.ALLPointCount = {
        [_G.type_rank_enum.lei] = 0,
        [_G.type_rank_enum.feng] = 0,
        [_G.type_rank_enum.shui] = 0,
        [_G.type_rank_enum.huo] = 0,
        [_G.type_rank_enum.tu] = 0,
        [_G.type_rank_enum.shen] = 0,
        [_G.type_rank_enum.guanka] = 0,
        [_G.type_rank_enum.sihunTowar] = 0
    }
    if data and data.point then
        for k, v in pairs(data.point) do
            self.ALLPointCount[v.type] = #v.uids
            for _, uid in pairs(v.uids) do
                self.ALLPointDone[uid] = true
            end
        end
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RecordRankLink.id)
    if AppSetting.IsXzns then
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
        )
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
        )
    end
    self:ParseData()
end
---点赞
function LingRankModel:Point(type, uid, callback)
    if self:CanPoint(type, uid) then
        LingRankNet:GetInstance():Point(
            {type = type, uid = uid},
            _G.handlerbind(self, self.PointSuccessCall, callback, uid, type)
        )
    end
end
---点赞成功回调
function LingRankModel:PointSuccessCall(msg, call, uid, type)
    if msg.ack ~= 1 then
        return
    end
    self.ALLPointDone[uid] = uid
    self.ALLPointCount[type] = self.ALLPointCount[type] + 1
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    end
    if call then
        call(msg)
    end
end
