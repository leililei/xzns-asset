    return self.Allranks[type_rank_enum] or {}
end

---领取奖励
function LingRankModel:GetDataFormSeverRankAward(rankcfgSid, call)
    local pbData = {}
    pbData.sid = {rankcfgSid}
    LingRankNet:GetInstance():AccessRankAward(pbData, _G.handlerbind(self, self.RecallbackRankAward, rankcfgSid, call))
end
function LingRankModel:RecallbackRankAward(data, rankcfgSid, call)
    if data.ack ~= 1 then
        return
    end
    local rankN = self.rankNode:GetRankList(rankcfgSid)
    rankN:SetAwardState(_G.rank_state_enum.yilingqu)
    self.rankNode.red_count = self.rankNode.red_count - 1
    require "CommonTipManager".OpenCommonAwardView(
        data,
        function()
            ---通知界面刷新数据
            if call then
                call()
            end
            _G.PlayerModel:GetInstance():ShowRoleLvUpAward()
        end
    )
    --仓库增加道具
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    --刷新红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.RecordRankAward.id,
        self.rankNode.type_rank_enum
    )
    if AppSetting.IsXzns then
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
        )
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
        )
    end
end
--获取 积分榜单积分、放置关卡、死魂塔
function LingRankModel:GetDataFormSeverRankCurrentInfo(rankType, call)
    local pbData = {}
    if rankType >= _G.type_rank_enum.lei and rankType <= _G.type_rank_enum.shen then
        pbData.type = rankType
    end
    LingRankNet:GetInstance():AccessRankCurrentPlayer(
        pbData,
        rankType,
        _G.handlerbind(self, self.RecallbackRankCurrentInfo, rankType, call)
    )
end
function LingRankModel:RecallbackRankCurrentInfo(data, type, call)
    local score = data.score or data.high_floor or data.sid
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local frame = _G.PlayerModel:GetInstance():GetCurFrame()
    local level = _G.PlayerModel:GetInstance():GetLevel()
    local point = _G.PlayerModel:GetInstance():GetPoint()
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local name = _G.PlayerModel:GetInstance():GetName()
    local portrait = _G.PlayerModel:GetInstance():GetRoleStyle()
    local itemData = LingRankItemData.New()
    itemData:Parse()
    itemData:SetTypeRankID(type)
    itemData:SetPlayerName(name)
    itemData:SetPlayerFrame(frame)
    --itemData:SetPlayerPowar(power)
    itemData:Setplaye_level(level)
    itemData:SetPlayerHead(portrait)
    itemData:SetisRank(false)
    itemData:SetPlayerUid(uid)
    itemData:SetValueSid(score)
    itemData:SetPlayerPoint(point)
    itemData:SetIsMySelf(true)
    itemData:SetRankIsJifenHuoGuanKa()
    self.rank_cur_player = itemData
    --仓库增加道具
    if call then
        call()
    end
end

