---创建对象时,入口构造函数
---@field rankFirst table 每个榜单的 第一名
---@field rankNodes table 每个榜单的 节点信息
---@field rank_my_self table 每个榜单 自己的信息
---@field rank_all_palers table 每个榜单 所有人员的排行
---@field rank_cur_player table 当前玩家信息
---@field rankPlayerCount table<number, number> 榜单类型，上榜人数
---@field Allranks table 所有排行的节点信息
function LingRankModel:__init()
    self.endCallback = nil
    self.curFunctionOpenID = 48
    self.rankFirst = {}
    self.rankNodes = {}
    self.rank_my_self = {}
    self.rank_all_palers = {}
    self.rank_cur_player = {}
    self.rankPlayerCount = {}
    self.Allranks = {
        [_G.type_rank_enum.lei] = {},
        [_G.type_rank_enum.feng] = {},
        [_G.type_rank_enum.shui] = {},
        [_G.type_rank_enum.huo] = {},
        [_G.type_rank_enum.tu] = {},
        [_G.type_rank_enum.guanka] = {},
        [_G.type_rank_enum.sihunTowar] = {}
    }
end

---销毁对象时,析构函数
function LingRankModel:Dispose()
    self.rankFirst = nil
    self.rankNodes = nil
    self.rank_my_self = nil
    self.rank_all_palers = nil
    self.rank_cur_player = nil
    self.Allranks = nil
end

function LingRankModel:CheckFunopenIDUnLock()
    local flag = false
    flag = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID)
    return flag
end
