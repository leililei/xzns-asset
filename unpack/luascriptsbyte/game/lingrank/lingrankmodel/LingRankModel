--region 排行榜所有人员
---排行榜 所有人员
---@param type number 榜单类型
function LingRankModel:RankAllPlayerProto(type, call)
    local msg = {}
    if type == _G.type_rank_enum.guanka then
        msg.page = 1
    elseif type == _G.type_rank_enum.sihunTowar then
        msg.page = 1
    else
        msg.page = 1
    end
    LingRankNet:GetInstance():AccessRankBanDan(msg, type, _G.handlerbind(self, self.RecallBackRankPlayers, type, call))
end
function LingRankModel:RecallBackRankPlayers(data, type, call)
    self.rank_all_palers = {}
    ---检测 当前玩家有没有上榜
    local flag = false
    local uid = _G.PlayerModel:GetInstance().role_uid

    local temp = {}
    if type == _G.type_rank_enum.sihunTowar then
        if not _G.table.isEmptyOrNil(data.deads) then
            for i = 1, #data.deads do
                local te = {}
                te.frame = data.deads[i].role_info.frame
                te.lv = data.deads[i].role_info.level
                te.name = data.deads[i].role_info.name
                te.power = data.deads[i].role_info.power
                te.portrait = data.deads[i].role_info.style
                te.value = data.deads[i].count_pass
                te.uid = data.deads[i].role_info.uid
                te.title = data.deads[i].role_info.title
                te.point = data.deads[i].role_info.point
                _G.table.insert(temp, te)
            end
        end
    else
        temp = data.rankers or {}
    end
    self.rankPlayerCount[type] = #temp
    if _G.table.isEmptyOrNil(temp) then
        self:GetDataFormSeverRankCurrentInfo(type, call)
        return
    end
    for i = 1, #temp do
        local da = temp[i]
        local itemData = LingRankItemData.New()
        itemData:Parse(da)
        itemData:SetTypeRankID(type)
        itemData:SetPlayerName(da.name)
        itemData:SetPlayerFrame(da.frame)
        --itemData:SetPlayerPowar(da.power)
        itemData:Setplaye_level(da.lv or da.level)
        itemData:SetPlayerHead(da.portrait or da.style)
        itemData:SetValueSid(da.value or da.count_pass)
        itemData:SetPlayerUid(da.uid)
        itemData:SetPlayerMingCi(i)
        itemData:SetPlayerPoint(da.point)
        itemData:SetRankIsJifenHuoGuanKa()
        itemData:SetisRank(true)
        --称号
        itemData:SetPlayerTitle(da.title)

        if uid == da.uid then
            flag = true
            self.rank_cur_player = itemData
            itemData:SetIsMySelf(true)
        else
            itemData:SetIsMySelf(false)
        end
        self.rank_all_palers[i] = itemData
    end
    if not flag then
        self:GetDataFormSeverRankCurrentInfo(type, call)
    else
        call()
    end
end
