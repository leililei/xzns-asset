local LingRankModel = require("LingRankModel")
---@class LingRankView : UIBaseView	中文描述
---@field public go_table LingRankView_GoTable GoTable
local LingRankView = _G.BaseClass("LingRankView", _G.UIBaseView)
local UIUtils = _G.UIUtils
function LingRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = LingRankModel:GetInstance()
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankMainView.Name)
end

---界面的入口函数
function LingRankView:OnCreate()
    _G.DelayFrameDo(
        function()
            self.model:GetDataFormSeverRankFirstInfo(
                function()
                    self:UpdateJiFen()
                    self:UpDateGuanKa()
                end
            )
        end
    )
end
function LingRankView:CloseView()
    self:Close()
end
---按钮点击事件在这里派发
function LingRankView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
    if go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 90)
    end
end

--region 设置 与 更新
function LingRankView:UpdateJiFen()
    local node = self.go_table.obj_jifenNode
    for i = 1, 6 do
        self:SetJifenOne(node:GetChildE(i - 1), i)
    end
end
function LingRankView:UpDateGuanKa()
    local node = self.go_table.obj_guankaNode
    for i = 1, 2 do
        self:SetGuanKaOne(node:GetChildE(i - 1), i + 6)
    end
end
---设置 榜单第一名
---@param go table 对象
---@param index number 榜单类型
function LingRankView:SetGuanKaOne(go, index)
    local tb = _G.GetAutoGoTable(go)
    local rankId = index
    --go:GetName()
    --rankId = tonumber(rankId)
    local itemData = self.model.rankFirst[index]
    tb.aortext_player_name.text = itemData:GetPlayerName()
    tb.aortext_jindu_number.text = itemData:GetValueSid()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, itemData, 1, true, false, true)
    tb.aorbtn_dianji.onClick:RemoveAllListeners()
    tb.aorbtn_dianji.onClick:AddListener(_G.handlerbind(self, self.JifenOnClick, rankId))
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RecordRankMain.id, rankId)
end
---设置 榜单第一名
---@param go table 对象
---@param index number 榜单类型
function LingRankView:SetJifenOne(go, index)
    local tb = _G.GetAutoGoTable(go)
    local rankId = index
    --go:GetName()
    --rankId = tonumber(rankId)
    local itemData = self.model.rankFirst[index]
    tb.aortext_name.text = itemData:GetPlayerName()
    tb.aortext_fenshu.text = itemData:GetValueSid()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, itemData, 1, true, true, true)
    tb.aorbtn_dianji.onClick:RemoveAllListeners()
    tb.aorbtn_dianji.onClick:AddListener(_G.handlerbind(self, self.JifenOnClick, rankId))
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RecordRankMain.id, rankId)
end
function LingRankView:JifenOnClick(rankId)
    _G.AudioManager.PlayAudioByAudioCfgID(2049)
    self.model:RankAllPlayerProto(
        rankId,
        function(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RankInfoView.Name, rankId)
            -- require "RedPointManager":GetInstance():RefreshNodeByAllParams(
            --     _G.ConfigManager.redpoint_cfg.RecordRankAward.id,
            --     rankId
            -- )
        end
    )
end
--endregion
return LingRankView
