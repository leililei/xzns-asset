function RankInfoView:Paixu1()
    for i = 1, #self.lists_re do
        for j = i + 1, #self.lists_re do
            local function paixu(c)
                if c:GetAwardState() == _G.rank_state_enum.lingqu then
                    return 10
                elseif c:GetAwardState() == _G.rank_state_enum.nolingqu then
                    return 9
                elseif c:GetAwardState() == _G.rank_state_enum.yilingqu then
                    return 7
                end
            end
            local a = paixu(self.lists_re[i])
            local b = paixu(self.lists_re[j])
            if a < b or (a == b and self.lists_re[i]:GetRankSid() > self.lists_re[j]:GetRankSid()) then
                local temp = self.lists_re[i]
                self.lists_re[i] = self.lists_re[j]
                self.lists_re[j] = temp
            end
        end
    end
end
