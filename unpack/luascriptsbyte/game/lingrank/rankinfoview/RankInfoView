---@field model LingRankModel
function RankInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = LingRankModel:GetInstance()
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---界面的入口函数
---@field selfTable table<number, RankInfoView._obj_item_GoTable> 存储自己的item<type, go_table>
function RankInfoView:OnCreate(type)
    self.type = type
    self.selfTable = {}
    self.rewardLists = {}
    self:SetTitle(type, 1)
    self.go_table.scrollloopvectical_rewardList:InitItemData(0, _G.handler(self, self.RefreshRewardsNodeLists))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_reward, false)
    if _G.table.isEmptyOrNil(self.model.rank_all_palers) then
        self:SetNothing(true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Node, false)
    else
        self:SetNothing(false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Node, true)
        self:SetRankList()
    end
    self:SetCurrentTiaoRank()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_awardmask, false)
    self.go_table.aorimage_NameBg:SetNativeSize()
end

function RankInfoView:SetNothing(flag)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothing, flag)
end

function RankInfoView:SetTitle(type, onclickType)
    if onclickType == 1 then
        self.go_table.aorimage_NameBg.SpriteName = showtitel[type].rank
    else
        self.go_table.aorimage_NameBg.SpriteName = showtitel[type].reward
    end
    if self.type == _G.type_rank_enum.guanka then
        self.go_table.aortext_jindu.text = _G.LangUtil.GetLangPackValue(90025300009)
    elseif self.type == _G.type_rank_enum.sihunTowar then
        self.go_table.aortext_jindu.text = _G.LangUtil.GetLangPackValue(90025300010)
    else
        self.go_table.aortext_jindu.text = _G.LangUtil.GetLangPackValue(90025300011)
    end
    --设置红点
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RecordRankAward.id, self.type)
    self.go_table.obj_redpointAgree:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RecordRankLink.id, self.type)
end
--- 设置 listView
function RankInfoView:SetRankList()
    local row = #self.model.rank_all_palers
    if self.mList == nil then
        self.go_table.scrollloopvectical_rankList:InitItemData(row, _G.handler(self, self.RefreshItem))
        self.mList = self.go_table.scrollloopvectical_rankList
    else
        self.go_table.scrollloopvectical_rankList:UpdateAllItem()
    end
end
function RankInfoView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local item = obj
    item:SetName(index + 1)
    local data = self.model.rank_all_palers[index + 1] or {}
    self:SetRankTiaoOne(obj, data, 1)
    return item
end
--region 更新
function RankInfoView:SetCurrentTiaoRank()
    local node = self.go_table.obj_currentRank
    self:SetRankTiaoOne(node, self.model.rank_cur_player, 2)
end

---设置Item
---@param go RankInfoView._obj_item_GoTable
---@param data LingRankItemData
---@param type number 其他人1，自己2
function RankInfoView:SetRankTiaoOne(go, data, type)
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.ClickHead, data, go, type))
    if _G.table.isEmptyOrNil(data) then
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        return
    end
    if data:GetIsMySelf() and type == 2 then
        _G.GameUtil.SetActiveByCondition(tb.aortext_myRank, true)
        tb.obj_mingci1:SetLocalPosition(-416, -11, 0)
    else
        _G.GameUtil.SetActiveByCondition(tb.aortext_myRank, false)

        tb.obj_mingci1:SetLocalPosition(-416, 0, 0)
    end
    if tb.obj_redpoint then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(
            data.player_mingci == 1 and _G.ConfigManager.redpoint_cfg.RecordRankLink.id or 0,
            self.type
        )
    end
    if tb.aorimage_yizan then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_yizan, self.model:IsPointDone(data:GetPalyerUid()))
    end
    if data:GetPlayerPoint() == 0 then
        tb.aortext_num.text = self.model:IsPointDone(data:GetPalyerUid()) and 1 or 0
    else
        tb.aortext_num.text = data:GetPlayerPoint()
    end
    tb.aortext_name.text = data:GetPlayerName()
    tb.aortext_ranknumber.text = data:GetValueSid()
    local flag = false
    if data:GetIsRank() then
        local mingci = data:GetPlayermingCi()
        if mingci <= 3 then
            flag = true
            _G.GameUtil.SetActiveByCondition(tb.aorimage_paiming, true)
            if mingci == 1 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_01"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_02"
            elseif mingci == 2 then
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_02"
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_03"
            elseif mingci == 3 then
                tb.aorimage_bg.SpriteName = "tz_qjhs_di_04"
                tb.aorimage_paiming.SpriteName = "tz_qjhs_phb_mingci_03"
            end
            tb.aortext_rank_paiming.text = ""
        else
            flag = false
            tb.aortext_rank_paiming.text = mingci
        end
    else
        flag = false
        tb.aortext_rank_paiming.text = _G.ConfigManager.language_package_cfg[90022900040]
    end

    _G.GameUtil.SetActiveByCondition(tb.obj_mingci, not flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBiaozhi, flag)
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,data,1,true,true,true)
    if data.isMySelf then
        self.selfTable[type] = tb
    end
end
--endregion

--region 点击
---按钮点击事件在这里派发
function RankInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self:CloseView()
    elseif name == "@_aorbtn_closeview" then
        self:CloseView()
    elseif name == "$_toggle_paihang" then
        self:OnToogleRank(go, isOn)
        if isOn then
            self:SetTitle(self.type, 1)
        end
    elseif name == "$_toggle_reward" then
        self:OnToogleReward(go, isOn)
        if isOn then
            self:SetTitle(self.type, 2)
        end
    end
end
function RankInfoView:CloseView()
    self:Close()
end
--endregion

--region 排行，奖励按钮 切换
--顶部toggle切换效果
function RankInfoView:OnToogleSet(go, isOn, call)
    local table = _G.GetAutoGoTable(self.go_table.toggle_paihang)
    table.aortext_togDesc2:SetActiveE(0)
    table = _G.GetAutoGoTable(go)
    table.aortext_togDesc2:SetActiveE(1)
    _G.GameUtil.SetActiveByCondition(table.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(table.aorimage_isOn, isOn)
    if call then
        call(go, isOn)
    end
end
---排行
function RankInfoView:OnToogleRank(go, isOn)
    self:OnToogleSet(
        go,
        isOn,
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_paihang, isOn)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_reward, not isOn)
        end
    )
end
---奖励
function RankInfoView:OnToogleReward(go, isOn)
    self:OnToogleSet(
        go,
        isOn,
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_paihang, not isOn)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_reward, isOn)
            self:InitRankReward()
        end
    )
end

