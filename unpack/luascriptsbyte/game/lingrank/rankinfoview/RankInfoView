---排行奖励 节点信息
function RankInfoView:InitRankReward()
    self.model:GetDataFormSeverRankNodeInfo(
        self.type,
        function()
            self.rewardLists = {}
            self.ranksid = 100000 + self.model.rankNode.type_rank_enum * 1000
            self:RefreshNodeReward()
        end
    )
end
--节点 信息 回调
function RankInfoView:RefreshRewardsNodeLists(index, obj)
    if index < 0 then
        return
    end
    self:SetNode(obj, index)
    return obj
end
function RankInfoView:ClickHead(go, ref, data, tb, type)
    local uid = data:GetPalyerUid()
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if uid > 0 then
            if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(uid)
            end
        end
    elseif name == "@_aorbtn_zan" then
        self.model:Point(
            self.type,
            uid,
            function(msg)
                local go_table = _G.GetAutoGoTable(tb)
                data:SetPlayerPoint(data:GetPlayerPoint() + 1)
                ---同步至另一处自己（排行榜或底部）
                local selfTb
                if type == 1 and data.isMySelf then
                    selfTb = self.selfTable[2]
                elseif type == 2 and self.selfTable[1] then
                    selfTb = self.selfTable[1]
                end
                if selfTb then
                    selfTb.aortext_num.text = data:GetPlayerPoint()
                    if selfTb.aorimage_yizan then
                        _G.GameUtil.SetActiveByCondition(selfTb.aorimage_yizan, true)
                    end
                end

                go_table.aortext_num.text = data:GetPlayerPoint()
                if go_table.aorimage_yizan then
                    _G.GameUtil.SetActiveByCondition(go_table.aorimage_yizan, true)
                end
                if msg.award then
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RecordRankLink.id
                    )
                    if AppSetting.IsXzns then
                        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
                        )
                        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
                        )
                    end
                    require "CommonTipManager".OpenCommonAwardView(msg)
                end
            end
        )
    end
end
function RankInfoView:SetNode(go, index)
    if index < 0 then
        return
    end
    local id = go:GetInstanceID()
    local tb = _G.GetAutoGoTable(go, _G.handlerbind(self, self.ClickHead, self.lists_re[index + 1], go))
    local sid = self.ranksid + index + 1
    go:SetName(sid)
    local itemData = self.lists_re[index + 1]
    local flag = false
    local str = ""
    if itemData:GetIsRank() then
        flag = true
        tb.aortext_name_palyer.text = itemData:GetPlayerName()
        tb.aortext_time.text = itemData:GetFinshTime()
        UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase,itemData,1,true,true,true)
        local reward = itemData:GetReward()
        self:CreateItem(tb.obj_itemNode, reward, itemData:GetAwardState() == _G.rank_state_enum.yilingqu, itemData, id)
    else
    end
    tb.aortext_name.text = itemData:GetBiaoTi()
    _G.GameUtil.SetActiveByCondition(tb.aortext_name_palyer, flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_itemNode, flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_HeadItem, flag)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_Finsh, flag)
    _G.GameUtil.SetActiveByCondition(tb.aortext_kong, not flag)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_kong, not flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_text, flag)

    -- if itemData:GetAwardState() == _G.rank_state_enum.yilingqu then
    -- elseif itemData:GetAwardState() == _G.rank_state_enum.nolingqu then
    -- elseif itemData:GetAwardState() == _G.rank_state_enum.lingqu then
    -- end
end
function RankInfoView:CreateItem(Parent, data, isLingqu, itemData, objid)
    if self.rewardLists[objid] == nil then
    else
        --require("ItemViewBase").Despawn(self.rewardLists[objid])
        _G.DestroyObject(self.rewardLists[objid].gameObject)
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            self.rewardLists[objid] = {}
            self.rewardLists[objid] = item
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:SetGou(isLingqu)
            if itemData:GetAwardState() == _G.rank_state_enum.lingqu then
                item:ShowEffect()
            else
                item:ShowOrHideEffect(false)
            end
        end,
        function(go, isOn)
            if itemData:GetAwardState() == _G.rank_state_enum.lingqu then
                self:LingQuOnClick(itemData:GetRankSid())
            else
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
            end
        end
    )
end
---领取按钮
---@param sid number rank_cfg 中的sid
function RankInfoView:LingQuOnClick(sid)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_awardmask, true)
    self.model:GetDataFormSeverRankAward(
        sid,
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_awardmask, false)
            self:RefreshNodeReward()
        end
    )
end

return RankInfoView
