local LingRankModel = require("LingRankModel")
---@class LingRankInfoView : UIBaseView	中文描述
---@field public go_table LingRankInfoView_GoTable GoTable
local LingRankInfoView = _G.BaseClass("LingRankInfoView", _G.UIBaseView)
_G.LingRankInfoView = LingRankInfoView

local CS = _G.CS
local typeof = _G.typeof

function LingRankInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.model = LingRankModel:GetInstance()
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_close"] = self.CloseView,
        ["@_aorbtn_paihang"] = self.PaiHangOnClick,
        ["@_aorbtn_LeftBtn"] = self.RightOnClick,
        ["@_aorbtn_RightBtn"] = self.LeftOnClick,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.ranksid = 100000 + self.model.rankNode.type_rank_enum * 1000
    self.curr_Index = 0
    self.isNothing = false
end

---界面的入口函数
function LingRankInfoView:OnCreate()
    self:UpdateNodeInfo()
end
function LingRankInfoView:CloseView()
    self:Close()
end
---刷新 nothing
function LingRankInfoView:UpDateNothing()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothing, self.isNothing)
end
--刷新节点信息
function LingRankInfoView:UpdateNodeInfo()
    self.isNothing = false
    local node = self.go_table.obj_node
    for i = 1, 6 do
        self:SetNode(node:GetChildE(i - 1), self.curr_Index * 6 + i)
    end
end
---设置单个的信息
function LingRankInfoView:SetNode(go, index)
    local tb = _G.GetAutoGoTable(go)
    local rankId = go:GetName()
    rankId = tonumber(rankId)
    local sid = self.ranksid + index
    local itemData = self.model.rankNode.rankList[sid]
    if _G.table.isEmptyOrNil(itemData) then
        self.isNothing = true
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        return
    end
    _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
    local flag = false
    if itemData:GetIsRank() then
        flag = true
        tb.aortext_name_palyer.text = itemData:GetPlayerName()
        tb.aorrawimage_portrait:LoadImage(itemData:GetPlayerHead())
        tb.aorrawimage_frame:LoadImage(itemData:GetPlayerFrame())
        local reward = itemData:GetReward()
        self:CreateItem(tb.obj_itemNode, reward)
    end
    tb.aortext_name.text = itemData:GetBiaoTi()
    _G.GameUtil.SetActiveByCondition(tb.aortext_name_palyer, flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_itemNode, flag)
    _G.GameUtil.SetActiveByCondition(tb.obj_HeadItem, flag)
    if itemData:GetAwardState() == _G.rank_state_enum.yilingqu then
    elseif itemData:GetAwardState() == _G.rank_state_enum.nolingqu then
    elseif itemData:GetAwardState() == _G.rank_state_enum.lingqu then
    end
end

function LingRankInfoView:CreateItem(Parent, data)
    if Parent:GetChildCountE() then
        for i = 1, Parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(Parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:SetGrade(false)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
        end
    )
end
--region 点击
---按钮点击事件在这里派发
function LingRankInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
---领取按钮
function LingRankInfoView:LingQuOnClick(go, sid, index)
    self.model:GetDataFormSeverRankAward(
        sid,
        index,
        function(ind)
            self:SetNode(go, index)
        end
    )
end
---点击 排行事件
function LingRankInfoView:PaiHangOnClick()
    self.model:RankAllPlayerProto(
        self.model.rankNode.type_rank_enum,
        function(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RankInfoView.Name)
        end
    )
end
function LingRankInfoView:LeftOnClick()
    self.curr_Index = self.curr_Index + 1
    local row = Mathf.Ceil(20 / 6)
    if self.curr_Index >= row then
        self.curr_Index = row
        return
    end
    self:UpdateNodeInfo()
    self:UpDateNothing()
end
function LingRankInfoView:RightOnClick()
    self.curr_Index = self.curr_Index - 1
    if self.curr_Index < 0 then
        self.curr_Index = 0
        return
    end
    self:UpdateNodeInfo()
    self:UpDateNothing()
end
--endregion
return LingRankInfoView
