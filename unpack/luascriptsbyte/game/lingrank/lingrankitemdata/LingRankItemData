---排行榜显示队伍卡牌的 简略信息
---@field i_card_simple rank_report.i_card_simple 卡牌数组信息
---@field i_card_info rank_report.i_card_info 卡牌简略信息
function LingRankItemData:SetTeamCard(sids)
    if sids == nil then
        return
    end
    self.teamcards = {}
    for i = 1, #sids do
        local card = _G.CardData.New()
        local msg = {}
        msg.sid = sids[i].sid
        msg.lv = sids[i].level
        msg.star = sids[i].star
        msg.soul_state = sids[i].soul_state
        msg.soul_chain_lv = sids[i].soul_lv
        msg.open_inborn = sids[i].born_skill_num
        card:ParseInitMsg(msg)
        _G.table.insert(self.teamcards, card)
    end
end
function LingRankItemData:GetTeamCard()
    return self.teamcards
end
