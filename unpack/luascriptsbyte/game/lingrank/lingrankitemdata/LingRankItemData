function LingRankItemData:GetValueSid()
    local str = ""
    if self.type_rank_id == _G.type_rank_enum.guanka then
        local cfg = _G.ConfigManager.afk_cfg
        if self.value_sid == 0 then
            str = self.value_sid
        else
            str = cfg[self.value_sid].chapter .. "-" .. cfg[self.value_sid].section
        end
    elseif self.type_rank_id == _G.type_rank_enum.sihunTowar then
        if self.value_sid < 90000 then
            str = self.value_sid
        else
            local cfg = _G.ConfigManager.tower_cfg
            str = cfg[self.value_sid].layer
        end
    else
        str = self.value_sid
    end
    return str
end
