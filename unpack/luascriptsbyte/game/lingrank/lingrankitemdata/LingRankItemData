        self.role={
            uid=self:GetPalyerUid(),
            name=self:GetPlayerName(),
            style=self:GetPlayerHeadSid(),
            level=self:GetPlayerLevel(),
            power=self:GetPlayerPowar(),
            frame=self:GetCurFrameSid(),
            city_style_id=self:GetCityStyle(),
            title=self:GetPlayerTitle(),
            artifact_skin=self:GetArtifactskin()
        }
    end
    return self.role
end
