function LingRankItemData:GetFinshTime()
    local str = ""
    if self.finshTime == 0 then
        return str
    end
    local nowTime = _G.TimeUtil.GetDateTime(self.finshTime)
    if nowTime.hour < 10 then
        nowTime.hour = "0" .. nowTime.hour
    end
    if nowTime.minute < 10 then
        nowTime.minute = "0" .. nowTime.minute
    end
    if nowTime.second < 10 then
        nowTime.second = "0" .. nowTime.second
    end
    str =
        nowTime.year ..
        "-" ..
            nowTime.month .. "-" .. nowTime.day .. " " .. nowTime.hour .. ":" .. nowTime.minute .. ":" .. nowTime.second
    return str
end
