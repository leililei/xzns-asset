function LingRankItemData:GetDungeonsReward()
    local award = {}
    local cfg = _G.ConfigManager.dungeons_boss_cfg
    if self.player_mingci == 1 then
        award = cfg[10001].reward_daily
    else
        for key, value in pairs(cfg) do
            if self.player_mingci >= value.min_rank and self.player_mingci <= value.max_rank then
                award = value.reward_daily
            end
        end
    end
    return award
end

