---设置标题
function LingRankItemData:SetBiaoTi()
    local cfg = {}
    cfg = _G.ConfigManager.rank_cfg
    if self.type_rank_id == 1 then
        self.biaoti = GetLangPackValue(90025300003, cfg[self.sid].params)
    elseif self.type_rank_id == 2 then
        self.biaoti = GetLangPackValue(90025300004, cfg[self.sid].params)
    elseif self.type_rank_id == 3 then
        self.biaoti = GetLangPackValue(90025300005, cfg[self.sid].params)
    elseif self.type_rank_id == 4 then
        self.biaoti = GetLangPackValue(90025300006, cfg[self.sid].params)
    elseif self.type_rank_id == 5 then
        self.biaoti = GetLangPackValue(90025300007, cfg[self.sid].params)
    elseif self.type_rank_id == 6 then
        self.biaoti = GetLangPackValue(90025300008, cfg[self.sid].params)
    elseif self.type_rank_id == _G.type_rank_enum.guanka then
        local afkId = cfg[self.sid].params
        local afkCfg = _G.ConfigManager.afk_cfg[afkId]
        if afkCfg then
            self.biaoti = GetLangPackValue(90025300002, afkCfg.chapter)
        end
    elseif self.type_rank_id == _G.type_rank_enum.sihunTowar then
        local towersid = cfg[self.sid].params
        local towercfg = _G.ConfigManager.tower_cfg
        self.biaoti = GetLangPackValue(90025300001, towercfg[towersid].layer)
    end
end
