local base = require("BaseGameNet")
---@class LingRankNet : BaseGameNet	通信协议
local LingRankNet = _G.BaseClass("LingRankNet", base)

---@return LingRankNet
function LingRankNet:GetInstance()
    return base.GetInstance(self)
end

---获取 排行榜 一级界面 信息
---@param pbData table PB数据
---@param callback function 完成回调
--- @field   type number 排行榜类型
--- @field   value number 进度（积分或者放置关卡sid,死魂塔层数）
--- @field   name string 玩家昵称
--- @field   lv number 玩家等级
--- @field   portrait number 玩家头像
--- @field   frame number 玩家头像框
function LingRankNet:AccessRankFirstInfo(callback)
    local item = _G.ConfigManager.net_map.game_record_rank_first_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBackInfo))
    self.Call[port] = callback
end
