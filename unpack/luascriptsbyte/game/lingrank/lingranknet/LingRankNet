---排行榜 放置 积分
function LingRankNet:AccessRankBanDan(pbdata, type, callback)
    local pb = {}
    if _G.table.isEmptyOrNil(pbdata) then
        pb = self:GetEmptyPB()
    else
        pb = pbdata
    end
    local item
    if type == _G.type_rank_enum.guanka then
        item = _G.ConfigManager.net_map.game_rank_rank_afk
    elseif type == _G.type_rank_enum.lei then
        item = _G.ConfigManager.net_map.game_rank_rank_l
    elseif type == _G.type_rank_enum.feng then
        item = _G.ConfigManager.net_map.game_rank_rank_f
    elseif type == _G.type_rank_enum.shui then
        item = _G.ConfigManager.net_map.game_rank_rank_s
    elseif type == _G.type_rank_enum.huo then
        item = _G.ConfigManager.net_map.game_rank_rank_h
    elseif type == _G.type_rank_enum.tu then
        item = _G.ConfigManager.net_map.game_rank_rank_t
    elseif type == _G.type_rank_enum.shen then
        item = _G.ConfigManager.net_map.game_rank_rank_god
    elseif type == _G.type_rank_enum.sihunTowar then
        item = _G.ConfigManager.net_map.game_rank_rank_dead_island
    end
    local port = base.Access(self, item, pb, _G.handler(self, self.CallBackInfo))
    self.Call[port] = callback
end
