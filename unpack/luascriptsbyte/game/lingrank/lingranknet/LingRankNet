---当前玩家的 排行信息(积分、放置、厮混他)
function LingRankNet:AccessRankCurrentPlayer(pbdata, type, callback)
    local pb = {}
    if not _G.table.isEmptyOrNil(pbdata) then
        pb = pbdata
    else
        pb = self:GetEmptyPB()
    end
    local item
    if type == _G.type_rank_enum.guanka then
        item = _G.ConfigManager.net_map.game_afk_info
    elseif type == _G.type_rank_enum.sihunTowar then
        item = _G.ConfigManager.net_map.game_dead_soul_island
    else
        item = _G.ConfigManager.net_map.game_record_rank_score_info
    end
    local port = base.Access(self, item, pb, _G.handler(self, self.CallBackInfo))
    self.Call[port] = callback
end

----推送 消息
function LingRankNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.record_rank_node.Cmd, self.RecCallBack)
end
---红点刷新
function LingRankNet:RecCallBack(data)
    local LingRankID = data.type
    --重新拉取 服务器具体榜单的数据
    require "LingRankModel":GetInstance():GetDataFormSeverRankNodeInfo(
        LingRankID,
        function()
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankAward.id,
                LingRankID
            )
            if AppSetting.IsXzns then
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
                )
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
                )
            end
            -- if LingRankID == _G.type_rank_enum.guanka then
            --     require "PingDingLingYuModel":GetInstance():GetInfo()
            -- end
        end
    )
end
