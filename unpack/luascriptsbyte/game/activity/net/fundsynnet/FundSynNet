local base = require("BaseGameNet")

---@class FundSynNet : BaseGameNet	通信协议
local FundSynNet = _G.BaseClass("FundSynNet", base)

---@return FundSynNet FundSynNet
function FundSynNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function FundSynNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

--获取基金的信息
---@param callback function 完成回调
function FundSynNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_store_grow_battle_info, self:GetEmptyPB(), callback)
end

---领取奖励
---@param pbData table PB数据
---@param callback function 完成回调
function FundSynNet:GetAwardByCfg(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_grow_battle_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function FundSynNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type FundSynNet
-- _G.FundSynNet = FundSynNet
return FundSynNet
