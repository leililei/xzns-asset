local base = require("BaseGameNet")

---@class LimitTimeTaskNet : BaseGameNet	通信协议
local LimitTimeTaskNet = _G.BaseClass("LimitTimeTaskNet", base)
---@return LimitTimeTaskNet LimitTimeTaskNet
function LimitTimeTaskNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function LimitTimeTaskNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function LimitTimeTaskNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
---领取活动奖励
---@param id number 兑换id
---@param num number 数量
---@param callback function 回调
function LimitTimeTaskNet:FinishTask(pbdata, callback)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_activity_task_finish, pbdata, callback)
end
return LimitTimeTaskNet
