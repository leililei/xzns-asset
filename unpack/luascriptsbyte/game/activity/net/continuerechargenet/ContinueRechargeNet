local base = require("BaseGameNet")

---@class ContinueRechargeNet : BaseGameNet	通信协议
local ContinueRechargeNet = _G.BaseClass("ContinueRechargeNet", base)
---@return ContinueRechargeNet ContinueRechargeNet
function ContinueRechargeNet:GetInstance()
    return base.GetInstance(self)
end

---请求充值信息
---@param callback function 回调方法
function ContinueRechargeNet:GetCashInfo(callback)
    local item = _G.ConfigManager.net_map.game_day_cash_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---领取奖励
---@param pbdata table 发送数据
---@param callback function 回调方法
function ContinueRechargeNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_day_cash_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---解锁功能
function ContinueRechargeNet:UnlockDayCash(callback)
    local item = _G.ConfigManager.net_map.game_day_cash_unlock
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ContinueRechargeNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return ContinueRechargeNet
