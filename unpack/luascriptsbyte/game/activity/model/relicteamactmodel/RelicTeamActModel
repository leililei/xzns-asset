local base = require "ActivitySynTypeBase"
---@class RelicTeamActModel : ActivitySynTypeBase	
local RelicTeamActModel = _G.BaseClass("RelicTeamActModel", base)

---创建对象时,入口构造函数
function RelicTeamActModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    require "RelicTeamModel":GetInstance():GetDataFormServer()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamChangeStatus, self.RefreshRedPoint, self)
    --self:RefreshRedPoint()
end

---获取服务器数据
function RelicTeamActModel:GetDataFormServer()
    self:ParseData()
    --require "RelicTeamModel":GetInstance():GetDataFormServer()
end

function RelicTeamActModel:OnEnterActivity()
    local RelicTeamModel = require "RelicTeamModel":GetInstance()
    if RelicTeamModel:GetLaterGetDataBol() then 
        RelicTeamModel:GetInfo(_G.handler(self, self.EnterFunc))
    else 
        self:EnterFunc()
    end
end

function RelicTeamActModel:EnterFunc()
    self:SetRedTime()
    self:RefreshRedPoint()
    self:RefreshActRedPoint()
    local RelicTeamModel = require "RelicTeamModel":GetInstance()
    RelicTeamModel:SetLaterGetDataBol(false)
    local camp = RelicTeamModel:GetCamp()
    local status = RelicTeamModel:GetStatusAndNextTimeLine()
    local teamInfo = RelicTeamModel:GetTeamInfo()
    local autoCreateBol
    if RelicTeamModel:CheckInEggAwrdStatus() then 
        local rankType = require("RankUtils").RankType.AncientGodPersonalPoints
        if not self.CurRankData then 
            require("RecordRankModel"):GetInstance():GetListInfoByPage(rankType, 
                function()
                    self.CurRankData = require("RecordRankModel"):GetInstance():GetRankData(rankType)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamChampionView.Name, self.CurRankData)
                end,
                1
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamChampionView.Name, self.CurRankData)
        end
        return 
    end
    if (status == RelicTeamModel.relicStatus.idle or status == RelicTeamModel.relicStatus.explore) and not teamInfo then 
        autoCreateBol = true
    else 
        autoCreateBol = false 
    end
    local createTeamFunc = function()
        local msg = {}
        msg.name = _G.GetPlayerName()
        msg.type = 1
        msg.power = 0
        RelicTeamModel:CreateTeam(msg, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
        end)
    end
    if RelicTeamModel:CheckAutoTeamStatus() then 
        _G.PopWindowManager:GetInstance():ShowAllTips(1070022)  
    elseif not camp or camp == 0 then 
        local T = {camp = 1}
        RelicTeamModel:ChooseCamp(T, function()
            if autoCreateBol then 
                createTeamFunc()
            else 
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
            end
        end)
    elseif camp and camp ~= 0 then 
        if autoCreateBol then 
            createTeamFunc()
        else 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
        end
    elseif status == RelicTeamModel.relicStatus.settle or status == RelicTeamModel.relicStatus.close then 
        _G.PopWindowManager:GetInstance():ShowAllTips(1070022, _G.GetLangPackValue(90031400001))  
    else 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
    end
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

---初始化红点树
function RelicTeamActModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---所有活动解析完成后运行
function RelicTeamActModel:LaterInitFunction()
    local redPointId = self:GetRedpointIDByIndex(1)
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.RelicTeamTeam.id)
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.RelicTeamRelic.id)
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.RelicTeamAttacked.id)
    local giftActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, 100081)
    if giftActivity then 
        require "RedPointManager":GetInstance():AddRedPointChild(redPointId, giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
end

function RelicTeamActModel:ReConnect(endcall)
    if endcall ~= nil then
        endcall(self.__cname)
    end
    require "RelicTeamModel":GetInstance():GetDataFormServer()
end

---解析数据
---@param data table 服务器返回数据
function RelicTeamActModel:ParseData(data)
    self:InitFunction()
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    require "RelicTeamModel":GetInstance():GetDataFormServer()
    self.endCallback = nil
    self.OnSixUpdateTag = nil
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function RelicTeamActModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function RelicTeamActModel:CheckRedPoint()
    if require "RelicTeamModel":GetInstance():CheckInEggAwrdStatus() then 
        if not require "RelicTeamModel":GetInstance().EggAwardFlag then 
            return 1
        end
    end
    if self.curActivityClass:GetCurActivityState() ~= require "ActivitySynManager".State.Open then
        return 0
    end
    local now = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    
    local dayLimit =
    _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RelicTeamRedFreshTime, 0)
    if now > dayLimit then
        return 1
    end
    return 0
end

---红点刷新时间写入
function RelicTeamActModel:SetRedTime()
    local endTime = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(
        _G.PlayerPrefsKey.RelicTeamRedFreshTime,
        endTime
    )
end

---刷新奖励红点
function RelicTeamActModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamRequest.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamInvite.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamFullEnergy.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamAssist.id)
    --require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function RelicTeamActModel:RefreshActRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function RelicTeamActModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamChangeStatus, self.RefreshRedPoint, self)
    self.super.Dispose(self)
end

return RelicTeamActModel
