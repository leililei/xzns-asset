local base = require "ActivitySynTypeBase"
---@class SpBoxSynModel : ActivitySynTypeBase	惊喜宝箱GM活动
local SpBoxSynModel = _G.BaseClass("SpBoxSynModel", base)
local boxType = {
    ["new"] = 1,
    ["upgrating"] = 2,
    ["canOpen"] = 3
}

---创建对象时,入口构造函数
function SpBoxSynModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    self:SetSelfData(self.curActivityClass.cfg.self_info)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self:RefreshRedPoint()
end

---获取服务器数据
function SpBoxSynModel:GetDataFormServer()
    self:ParseData()
end

---解析数据
---@param data table 服务器返回数据
function SpBoxSynModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

function SpBoxSynModel:SetSelfData(info)
    self.coins = {}
    info = info.surprise_box
    self.maxTimes = info.max_times
    self.up_list = info.up_list
    self.coins = {}
    self.coinIndex = {}
    self.gm_cfg = info.gm_cfg
    self.up_times = info.up_times or 0
    self.open_num = info.open_num or 0
    self.max_num = info.max_num or 0
    for k, v in ipairs(info.coin_list or {}) do
        self.coins[v.key] = v.value
    end
    for k, v in ipairs(info.gm_cfg) do
        if not v.next_sid or v.next_sid == 0 then
            self.coinIndex[1] = v.sid
        end
        if not self.coins[v.sid] then
            self.coins[v.sid] = 0
        end
    end
    for i = 2, #info.gm_cfg do
        for k, v in ipairs(info.gm_cfg) do
            if v.next_sid == self.coinIndex[i - 1] then
                self.coinIndex[i] = v.sid
                break
            end
        end
    end

    require("SpBoxManager"):GetInstance():SetActivityModel(self)
end

