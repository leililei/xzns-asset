function SpBoxSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpBoxView.Name, self.curActivityClass)
    self:RefreshRedPoint()
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function SpBoxSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.SpBoxView.Name
end

