---@class ActivityManager	中文描述
local ActivityManager = _G.BaseClass("ActivityManager", _G.Singleton)
_G.ActivityManager = ActivityManager

local ModelInstance = {
    {model = require "TrainingModel":GetInstance(), funcName = "IsFinish"}
}
---初始化活动开始
function ActivityManager:InitActivityOpen()
    for _, v in pairs(ModelInstance) do
        if v.model[v.funcName] and not v.model[v.funcName](v.model) then
            return true
        end
    end
    return false
end

return ActivityManager
