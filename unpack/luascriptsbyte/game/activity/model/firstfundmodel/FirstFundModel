local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class FirstFundModel : ActivitySynTypeBase	成长基金
local FirstFundModel = _G.BaseClass("FirstFundModel", base)
-- _G.FirstFundModel = FirstFundModel

---创建对象时,入口构造函数
function FirstFundModel:__init()
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end
function FirstFundModel:OnActivityStateChanged(_, state)
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FirstFundView.Name)
        if view then
            if view.curActivityId and view.curActivityId == self.curActivityClass:GetActivityID() then
                view:InitView(self.curActivityClass)
            end
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---是否是GM活动
function FirstFundModel:CheckIsGMActivity()
    return self.isGMActivity
end
function FirstFundModel:OnHandleGMData(info)
    self.isGMActivity = true
    self:ParseData(info)
end
--region 重写父类方法
--- 网络请求初始化
function FirstFundModel:GetDataFormServer()
    self.isGMActivity = false
    require("FundSynNet"):GetInstance():GetInfo(
        function(data)
            if data.ack ~= 1 then
                self.super.ParseData(self)
                return
            end
            self:ParseData(data)
        end
    )
end
function FirstFundModel:InitStoreDataByGM(data)
    self.StoreContentCfg = {}
    local temp
    if data.items then
        for k, v in pairs(data.items) do
            if v.type == 1 then
                self.sid = v.sid
                if not self.cfg then
                    self.cfg = {}
                end
                self.cfg.price_id = v.price_id
                self.cfg.goods = {v.goods}
                self.cfg.content = {}
            else
                temp = {}
                temp.id = v.day
                temp.conditions = {50, v.day}
                temp.rewards_normal = {v.free_award}
                temp.rewards_pay = {v.pay_award}
                self.StoreContentCfg[v.day] = temp
                self.cfg.content[v.day] = v.day
            end
        end
    end
    ---@type store_battle_pass_cfg
    self.store = {
        ---基金的id
        sid = self.sid,
        ---是否是豪华 （0:不是 1：是）
        unlock_rmb = 0,
        ---已经领取的普通奖励id
        normal_award_list = {},
        ---已经领取的豪华奖励id
        up_award_list = {}
    }
    self.store.unlock_rmb = data.is_up
    if data.get_free_award ~= nil then
        for i = 1, #data.get_free_award do
            self:SetAward(data.get_free_award[i], false)
        end
    end

    if data.get_pay_award ~= nil then
        for i = 1, #data.get_pay_award do
            self:SetAward(data.get_pay_award[i], true)
        end
    end
    self:Check()
end
function FirstFundModel:InitStoreDataByCfg(store)
    self.sid = store.sid
    ---@type store_battle_pass_cfg
    self.cfg = _G.ConfigManager.store_battle_pass_cfg[store.sid]
    self.store = {
        ---基金的id
        sid = self.sid,
        ---是否是豪华 （0:不是 1：是）
        unlock_rmb = 0,
        ---已经领取的普通奖励id
        normal_award_list = {},
        ---已经领取的豪华奖励id
        up_award_list = {}
    }
    self.store.sid = store.sid
    self.store.unlock_rmb = store.unlock_rmb
    if store.normal_award_list ~= nil then
        for i = 1, #store.normal_award_list do
            self:SetAward(store.normal_award_list[i], false)
        end
    end

    if store.up_award_list ~= nil then
        for i = 1, #store.up_award_list do
            self:SetAward(store.up_award_list[i], true)
        end
    end
    self:Check()
end
---数据解析完成
function FirstFundModel:ParseData(data)
    data = data.store_battle
    if self:CheckIsGMActivity() then
        self:InitStoreDataByGM(data)
    else
        if data.store then
            self:InitStoreDataByCfg(data.store)
        end
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FirstFundView.Name)
    if view then
        if view.curActivityId and view.curActivityId == self.curActivityClass:GetActivityID() then
            view:InitView(self.curActivityClass)
        end
    end
    self.super.ParseData(self)
end
function FirstFundModel:GetHaveGetIndex()
    --- or nil
    return self.HaveGetIndex
end
function FirstFundModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FirstFundView.Name, self.curActivityClass)
end
function FirstFundModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.FirstFundView.Name
end
---@return boolean true已购买豪华
function FirstFundModel:GetIsUp()
    return self.store.unlock_rmb == 1
end
---是否领取奖励
function FirstFundModel:IsAward(id, isUp)
    if isUp then
        return self.store.up_award_list[id] == true
    else
        return self.store.normal_award_list[id] == true
    end
end

function FirstFundModel:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_battle_pass_cfg[data.sid]
    if cfg and cfg.display_priority == 3 then
        self.store.unlock_rmb = 1
        self:Check()
    end
end

---购买豪华
function FirstFundModel:BuyUp(id, call)
    if self:CheckIsGMActivity() then
        require("MallManager"):GetInstance():BuyActiveGift(self.cfg.price_id, self.curActivityClass:GetActivityID(), id)
    else
        local cfg = _G.ConfigManager.store_battle_pass_cfg[id]
        if cfg ~= nil then
            require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
        end
    end
end
function FirstFundModel:CheckRed()
    return self:IsHaveGet() == true and 1 or 0
end

function FirstFundModel:IsHaveGet()
    return self.isHaveGet == true
end
---初始化红点
function FirstFundModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRed}
    self.redpointTree = {false}
end
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function FirstFundModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
function FirstFundModel:CheckActivityInteractable()
    return self.curActivityClass:CheckActivityInteractable()
end
---获取活动结束倒计时
function FirstFundModel:GetTimeCountDown()
    return self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
end

---设置已领取
function FirstFundModel:SetAward(id, isUp)
    if isUp then --[id =  store_battle_content_cfg  中 id]
        self.store.up_award_list[id] = true
    else
        self.store.normal_award_list[id] = true
    end
end

function FirstFundModel:CheckIsOpen()
    return self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open
end
function FirstFundModel:Check()
    local cfg
    local store_battle_content_cfg
    ---True有可领取
    self.isHaveGet = false
    ---可领取 索引 方便显示跳转
    self.HaveGetIndex = nil
    if self:CheckIsGMActivity() then
        cfg = self.cfg
        store_battle_content_cfg = self.StoreContentCfg
    else
        ---@type store_battle_pass_cfg
        cfg = _G.ConfigManager.store_battle_pass_cfg[self.sid]
        store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg
    end
    ---@type store_battle_content_cfg
    local cfgitem
    local cType, cValue, id
    for i = 1, #cfg.content do
        ---奖励内容id
        id = cfg.content[i]
        cfgitem = store_battle_content_cfg[id]
        ---条件类型
        cType = cfgitem.conditions[1]
        ---条件参数
        cValue = cfgitem.conditions[2]
        if _G.GlobalConditionManager.CheckCondition(cType, cValue) then
            ---如果解锁了 就记录是否已领取
            if self.isHaveGet == false then
                ---如果 有一个奖励没领 就标记
                if not self:IsAward(id, false) then
                    self.isHaveGet = true
                    self.HaveGetIndex = i
                elseif self:GetIsUp() and not self:IsAward(id, true) then
                    self.isHaveGet = true
                    self.HaveGetIndex = i
                end
            end
        end
    end
    self:CheckIsShow()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---领取奖励
---@param sid number  基金id
---@param type number  奖励类型 （0,普通 1，豪华）
---@param aid number  奖励的id
function FirstFundModel:GetAward(type, aid, call)
    ---@type store_battle.c2s_store_battle_award
    local pb = {}
    pb.aid = {aid}
    pb.type = type
    local GetAwardSuccess = function(_, data)
        if data.ack ~= 1 then
            return
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        self:SetAward(aid, type == 1)
        self:Check()
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
            data,
            function()
                call(self.curActivityClass)
            end
        )
    end
    if self:CheckIsGMActivity() then
        require "ActivitySynNet":GetInstance():GetAward(
            self.curActivityClass:GetActivityID(),
            {type, aid},
            _G.handler(self, GetAwardSuccess)
        )
    else
        require("FundSynNet"):GetInstance():GetAwardByCfg(pb, _G.handler(self, GetAwardSuccess))
    end
end
---@return boolean true奖励已全部领完
function FirstFundModel:CheckIsOvers()
    local cfg = self:CheckIsGMActivity() and self.cfg or _G.ConfigManager.store_battle_pass_cfg[self.sid]
    local count = #cfg.content
    local c1 = table.count(self.store.normal_award_list)
    local c2 = table.count(self.store.up_award_list)
    return count == c1 and count == c2
end
function FirstFundModel:CheckIsShow()
    if self:CheckIsOpen() == true and self:CheckIsOvers() == true then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
end

---销毁对象时,析构函数
function FirstFundModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return FirstFundModel
