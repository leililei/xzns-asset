local base = require "ActivitySynTypeBase"
---@class ContinueRechargeSyncModel : ActivitySynTypeBase
local ContinueRechargeSyncModel = _G.BaseClass("ContinueRechargeSyncModel", base)

---创建对象时,入口构造函数
function ContinueRechargeSyncModel:__init()
    self.ContinueRechargeActModel = require("ContinueRechargeActModel"):GetInstance()
    self.ContinueRechargeActModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
    self.ContinueRechargeActModel:SetActivityId(self.curActivityClass:GetActivityID())
end

---获取服务器数据
function ContinueRechargeSyncModel:GetDataFormServer()
    self.ContinueRechargeActModel:GetCashInfo(self.curActivityClass:GetActivityID(), _G.handler(self, self.ParseData))
end

function ContinueRechargeSyncModel:ParseData()
    base.ParseData(self)
end

---进入活动主体
function ContinueRechargeSyncModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ContinueRechargeActView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function ContinueRechargeSyncModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ContinueRechargeActView.Name
end

function ContinueRechargeSyncModel:InitFunction()
    self.ContinueRechargeActModel:InitFunction()
end

---初始化红点树结构
function ContinueRechargeSyncModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function ContinueRechargeSyncModel:CheckRedPoint()
    return self.ContinueRechargeActModel:CheckRedPoint()
end

---刷新奖励红点
function ContinueRechargeSyncModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@return number 红点数量
function ContinueRechargeSyncModel:CheckRedPointNumChild(index)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
return ContinueRechargeSyncModel