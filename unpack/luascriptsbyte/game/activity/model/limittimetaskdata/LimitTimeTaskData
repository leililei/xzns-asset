require "ActiveTaskBase"
---@class LimitTimeTaskData:ActiveTaskBase	中文描述
local LimitTimeTaskData = _G.BaseClass("LimitTimeTaskData", _G.ActiveTaskBase)
function LimitTimeTaskData:Init(data)
    self.activityTaskModel = data.taskModel
    self.MarkTaskType = _G.MarkTaskType.GMActivityTask
end
---类的析构函数
function LimitTimeTaskData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
end
---类的析构函数
---解析
---@param task task.i_task 任务id
function LimitTimeTaskData:ParseData(task)
    self.Cfg = task.cfg
    self.i_task = task
    if self.taskEnumType == nil then
        self.taskEnumType = self.Cfg.condition[1].con[1]
        self.taskcontentparams = self.Cfg.condition[1].con
    end
    if self.i_task.taskEnumType == nil then
        self.i_task.taskEnumType = self.Cfg.condition[1].con[1]
        self.i_task.taskcontentparams = self.Cfg.condition[1].con
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
    self.jumpId = task.link
    self.id = self.Cfg.id
    self.count = self.Cfg.count
end
---获取任务进度
function LimitTimeTaskData:GetProgress()
    if self.i_task.state == _G.TaskEnum.ETaskState.Completed or self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        return 1
    end
    local v1, v2 = self:GetCount()
    return v1 / v2
end
---@param isfh boolean true解析多组id
function LimitTimeTaskData:OnAactionEnent(id, parmas, isfh, isSet)
    if self:IsCheckTaskTarget(id[1]) then
        ---该任务枚举 有变动后 用通用检测 (死魂塔 参数2复杂(全塔 主塔 五行塔)  不好各参数全部广播)
        return
    end
    if isfh then
        local array = table.toArray(id)
        table.sort(
            array,
            function(a, b)
                return a < b
            end
        )
        local index = table.indexof(array, self.Cfg.condition[1].con)
        if false ~= index then
            local keys = {array[index]}
            for i = 2, #parmas[index] do
                table.insert(keys, parmas[index][i])
            end
            self:DoOne(keys, parmas[index][1], isSet)
        end
    else
        self:DoOne(id, parmas, isSet)
    end
end
---@param isSet boolean true设置进度(检测类条件且有数量要求 初始化)
function LimitTimeTaskData:DoOne(id, parmas, isSet)
    ---isSet  更新设置当前任务进度
    ---例:指定N张卡 升到指定X级  55#10#3   指定3张卡升到10级
    ---检测背包有2张 直接设置当前任务进度为2  而不是累计
    local condition = self.Cfg.condition[1].con

    if id[1] == condition[1] then
        if self.i_task.state ~= _G.TaskEnum.ETaskState.Claimed then
            return
        end

        if _G.AppSetting.DEBUG then
            _G.LogUtilities.LogError(
                _G.EModuleName.TaskModule,
                string.format(" LimitTimeTaskData 任务id %s", tostring(id))
            )
            _G.LogUtilities.LogError(
                _G.EModuleName.TaskModule,
                string.format(" LimitTimeTaskData %s", tostring(parmas))
            )
        end
        local value = parmas or 0
        local num = 0

        if isSet == true then
            num = value
        else
            ---累加的就直接加
            if self.Cfg.type_calculate == 1 or self.Cfg.type_calculate == 0 then
                num = self.i_task.target[1] + value
            else
                if value >= self.i_task.target[1] then
                    num = value
                else
                    num = self.i_task.target[1]
                end
            end
        end

        local numS = self:IsCheckTaskTargets(num)
        self.i_task.target[1] = numS
        self:CheckTaskState()
    end
end
--- 检测任务状态
function LimitTimeTaskData:CheckTaskState()
    if self.i_task == nil then
        return
    end
    ---35#10010,1,竞技场分数达到段数
    ---target[1]=10004

    --- 防止 抽卡0/5 任务  十连   服务器记录10/5
    if self.i_task.target[1] > self.Cfg.count then
        self.i_task.target[1] = self.Cfg.count
    end

    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.i_task.target[1] >= self.Cfg.count then
        else
            --- 次数没达到 不算完成
            return
        end

        self.i_task.state = _G.TaskEnum.ETaskState.Submited
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)

        if self.MarkTaskType == _G.MarkTaskType.none then
            if _G.AppSetting.DEBUG then
                _G.LogError("MarkTaskType  未定义")
            end
        else
            local pbData = {}
            pbData.finish_type = 1
            pbData.activity_id = self.activityTaskModel.TypeCls.ActivityID
            pbData.task_sid = self.i_task.sid
            require "LimitTimeTaskNet":GetInstance():FinishTask(pbData)
        end

        if self.call ~= nil then
            _G.TaskModule:GetInstance():SetCompletedTask(self.i_task.sid)
            self.call(self.i_task.sid)
            self.call = nil
        end
    elseif self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        ---如果已标记为完成 就设置进度为完成
        if self.i_task.target[1] == 0 then
            ---只有没进度 才这样 防止 频繁刷新 数据不对
            local value = self.taskcontentparams[#self.taskcontentparams] or 0
            local num = value
            if self.Cfg and self.Cfg.count then
                if num >= self.Cfg.count then
                    num = self.Cfg.count
                end
            end
            self.i_task.target[1] = num
        end
    end
end
function LimitTimeTaskData:GetCount()
    if self.i_task.state == _G.TaskEnum.ETaskState.Completed or self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        return self.count, self.count
    end
    if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.AFK.IsPass then
        local id = require "AfkModel":GetInstance().LastSid
        local endId = self.taskcontentparams[#self.taskcontentparams]
        local cfg = _G.ConfigManager.afk_cfg[endId]

        if cfg then
            if id >= endId then
                return cfg.chapter, cfg.chapter
            else
                local cfg2 = _G.ConfigManager.afk_cfg[id]
                if cfg2 then
                    if not _G.ConfigManager.afk_cfg[id + 1] then
                        return cfg2.chapter, cfg.chapter
                    else
                        return cfg2.chapter - 1, cfg.chapter
                    end
                else
                    return 0, cfg.chapter
                end
            end
        else
            return 1, 1
        end
    else
        return self.i_task.target[1], self.count
    end
end
---检测是否可以领奖
function LimitTimeTaskData:CheckIsCanTake()
    if self:CheckIsGet() then
        return false
    end
    return self.i_task.state == _G.TaskEnum.ETaskState.Completed or self.i_task.state == _G.TaskEnum.ETaskState.Submited
end

---检测是否已经领过奖
function LimitTimeTaskData:CheckIsGet()
    return self.activityTaskModel:CheckIsFinish(self.id)
end

return LimitTimeTaskData
