    [1] = "DrawUpBattlePassData",              --限时招募_战令
    [2] = "ArtifactBattlePassData",            --限时神器_战令
    [3] = "PetDrawUpBattlePassData",           --限时灵兽_战令
    [4] = "JoinActivityDrawUpBattlePassData",  --通用限时招募(全屏)_战令
    [5] = "TenOneGMBattlePassData",            --小游戏
    [6] = "JoinActivityDrawUpBattlePassData2", --通用限时招募(弹窗)_战令
}

--GM活动类型
