---@param msg activity.i_activity_self_info
function NewDrawUpBattlePassModel:InitTypeData(msg)
    if not DataType[msg.battle.cfg_list.main_type] then
        self.data = require(DataType[4]).New(self)
        return
    end
    self.data = require(DataType[msg.battle.cfg_list.main_type]).New(self)
    self.main_type = msg.battle.cfg_list.main_type
end

