function NewDrawUpBattlePassModel:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---获取GM数据
function NewDrawUpBattlePassModel:OnHandleGMData(info)
    -- ZHJH-11051 GM活动的多语言调整需求
    if info.battle2 then 
        info.battle = info.battle2
    end
    local cfg = _G.ConfigManager.store_gear_cfg[info.battle.cfg_list.price]
    info.battle.cfg_list.price = cfg and cfg.price or info.battle.cfg_list.price

    if not self.data then
        self:InitTypeData(info)
    end
    self.data:ParseData(info, self.curActivityClass:GetTypeId())
end

---@param msg activity.i_activity_self_info
function NewDrawUpBattlePassModel:ParseData(msg)
    if msg.battle2 then 
        msg.battle = msg.battle2
    end
    if not self.data then
        self:InitTypeData(msg)
    end
    self.data:ParseData(msg)
    base.ParseData(self)
    local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpBattlePassView.Name)
    if window then
        window:FreshView()
    end
end

