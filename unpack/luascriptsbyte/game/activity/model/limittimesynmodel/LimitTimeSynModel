local LimitTimeTaskData = require "LimitTimeTaskData"
local LimitTimeTaskNet = require "LimitTimeTaskNet"
local TaskModel = _G.BaseClass("TaskModel")
---@param data i_activity_exchange
function TaskModel:__init(obj, data, TypeCls)
    self:Init(data, TypeCls)
end
function TaskModel:Init(data, TypeCls)
    if not _G.table.isEmptyOrNil(self.taskList) then
        for k, v in pairs(self.taskList) do
            v:Dispose()
        end
    end
    self.TypeCls = TypeCls
    self.finishTaskList = {}
    self.taskList = {}
    self.TaskCfg = {}
    self:InitTaskCfg(data)
    self:InitFinishTask(data.finish_task)
    self:InitCurTask(data.task_curr)
    self:UpdateView()
    self.TypeCls:RefreshRedPointLimit(2)
end
function TaskModel:CheckRedPoint()
    if self.TypeCls:GetActivityState() ~= ActivitySynManager.State.Open then
        return 0
    end
    if not isEmptyOrNil(self.taskList) then
        for k, v in pairs(self.taskList) do
            if v:CheckIsCanTake() then
                return 1
            end
        end
    end
    return 0
end
function TaskModel:OnInitFunction()
end
function TaskModel:UpdateView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LimitTimeMission.Name)
    if view and view.gameObject:GetActiveSelf() == 1 then
        view:UpdateView(self)
    end
end
function TaskModel:OnEnterLimitView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitTimeMission.Name, self)
end
function TaskModel:InitTaskCfg(data)
    local initCfgFunc = function(task, type)
        local _task
        for k, v in pairs(task) do
            _task = {}
            _task.id = v.sid
            _task.name = v.name
            _task.desc = v.desc
            _task.type_calculate = v.type_calculate
            _task.condition = v.complete
            _task.count = v.count
            _task.reward = v.award
            _task.link = v.link
            _task.function_open = 0
            _task.taskType = type
            self.TaskCfg[v.sid] = _task
        end
    end
    initCfgFunc(data.task, 2)
    initCfgFunc(data.task_daily, 1)
end
function TaskModel:InitCurTask(task)
    if task then
        for _, v in pairs(task) do
            if self.TaskCfg[v.sid] then
                self.taskList[v.sid] =
                    LimitTimeTaskData.New(
                    {sid = v.sid, target = v.target, state = v.state, cfg = self.TaskCfg[v.sid], taskModel = self}
                )
            end
        end
    end
end
function TaskModel:InitFinishTask(finish)
    if finish then
        for _, v in pairs(finish) do
            if not self.finishTaskList[v] then
                self.finishTaskList[v] = true
                if self.TaskCfg[v] then
                    self.taskList[v] =
                        LimitTimeTaskData.New(
                        {
                            sid = v,
                            target = {999},
                            state = _G.TaskEnum.ETaskState.Completed,
                            cfg = self.TaskCfg[v],
                            taskModel = self
                        }
                    )
                end
            end
        end
    end
end
---检测任务是否完成
function TaskModel:CheckIsFinish(id)
    return self.finishTaskList[id]
end

---完成任务
---@param data HellRoadTaskData
function TaskModel:FinishTask(sid, callback)
    LimitTimeTaskNet:GetInstance():FinishTask(
        {activity_id = self.TypeCls.ActivityID, task_sid = sid, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                if callback then
                    callback()
                end
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.finishTaskList[sid] = true
            self:ChangeSingleTaskState(sid, _G.TaskEnum.ETaskState.Submited)
            if callback then
                callback(msg)
            end
            self.TypeCls:RefreshRedPointLimit(2)
        end
    )
end
---更新任务状态
function TaskModel:ChangeSingleTaskState(sid, state)
    self.taskList[sid].state = state
    self.taskList[sid]:CheckTaskState()
end
---获取任务信息
function TaskModel:GetTaskInfo(sid)
    if not self.taskList then
        return nil
    end
    return self.taskList[sid]
end
function TaskModel:UpdateTask(taskinfo)
    if self.taskList[taskinfo.sid] then
        self.taskList[taskinfo.sid]:UpdataData(taskinfo)
    end
    self.TypeCls:RefreshRedPointLimit(2)
end
function TaskModel:OnActivityStateChanged(state)
    self.TypeCls:RefreshRedPointLimit(2)
end
function TaskModel:Dispose()
    self.taskList = nil
    self.TaskCfg = nil
    self.finishTaskList = nil
end

