local ExchangeModel = _G.BaseClass("ExchangeModel")
---@param data i_activity_exchange
function ExchangeModel:__init(obj, data, TypeCls)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    ---策划要求 仅第一登录有红点判断
    self:Init(data, TypeCls)
end
function ExchangeModel:Init(data, TypeCls)
    self.TypeCls = TypeCls
    self.Data = {}
    self:InitData(data, TypeCls)
end
function ExchangeModel:OnInitFunction()
end
function ExchangeModel:UpdateView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LimitTimeETG.Name)
    if view and view.gameObject:GetActiveSelf() == 1 then
        view:SetView()
    end
end
function ExchangeModel:InitData(data)
    local _data
    self.NeedMoneyType = {}
    self.ExchangeType = data.type
    for _, v in pairs(data.item) do
        _data = {}
        _data.Sid = v.sid
        ---@type prop.i_item
        _data.NeedItem = v.need_item
        if not self.CoinSid then
            self.CoinSid = v.need_item[1].sid
        end
        if not self.NeedMoneyType[v.need_item[1].sid] then
            self.NeedMoneyType[v.need_item[1].sid] = v.need_item[1].sid
        end
        ---@type prop.i_item
        _data.GetItem = v.get_item
        _data.LimitTime = v.count_limit
        _data.ExchangeTime = 0
        _data.State = 1
        _data.isGou = _G.PlayerPrefsManager.GetInt("LimitTimeSynModelExchange" .. self.TypeCls.ActivityID .. v.sid)
        if not isEmptyOrNil(data.bought_times) then
            for _, a in pairs(data.bought_times) do
                if a.sid == v.sid then
                    _data.ExchangeTime = a.times
                    _data.State = a.times < v.count_limit and 1 or 0
                end
            end
        end
        _G.table.insert(self.Data, _data)
    end
end
function ExchangeModel:ResUpdata(data)
    for _, value in pairs(data) do
        local sid = value.type[1]
        if self.NeedMoneyType[sid] then
            self.TypeCls:RefreshRedPointLimit(1)
        end
    end
end
function ExchangeModel:GetCoinSid()
    return self.CoinSid
end
function ExchangeModel:CheckRedPoint()
    if self.TypeCls:GetActivityState() ~= ActivitySynManager.State.Open then
        return 0
    else
        local curDate = _G.TimeUtil.GetServerUnixTime()
        local locationTime = _G.PlayerPrefsManager.GetInt("LimitTimeSynModelDaily" .. self.TypeCls.ActivityID)
        if locationTime == 0 then
            return 1
        else
            if _G.TimeUtil.GetInterValDayByGame(curDate, locationTime) >= 1 then
                return 1
            end
        end
        local myCount
        if not isEmptyOrNil(self.Data) then
            for k, v in pairs(self.Data) do
                for i = 1, #v.NeedItem do
                    if v.NeedItem[i].sid == 101 then --活动代币（恶灵入侵）
                        myCount = require "MonsterSiegeManager":GetInstance():GetCoinActivity()
                    else
                        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(v.NeedItem[i].sid)
                        myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, v.NeedItem[i].sid)
                    end
                    if myCount >= v.NeedItem[i].num and v.ExchangeTime < v.LimitTime and v.isGou > 0 then
                        return 1
                    end
                end
            end
        end
        return 0
    end
end
function ExchangeModel:OnEnterLimitView()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.LimitTimeETG.Name,
        self.TypeCls:GetActivityCommonData()
    )
    self.TypeCls:RefreshRedPointLimit(1)
end
function ExchangeModel:OnActivityStateChanged(state)
    self.TypeCls:RefreshRedPointLimit(1)
end
function ExchangeModel:Exchange(data, award, call)
    local sid = data.Sid
    require "ExchangeNet":GetInstance():Exchange(
        sid,
        1,
        self.TypeCls.ActivityID,
        function(_data)
            if _data.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                _G.StorageManager:GetInstance():ConsumeItem(award.sid, 0, award.num)
                data.ExchangeTime = data.ExchangeTime + 1
                if data.ExchangeTime >= data.LimitTime then
                    data.ExchangeTime = data.LimitTime
                    data.State = 0
                end
                if call then
                    call(_data)
                end
            else
                if call then
                    call()
                end
            end
        end
    )
    self.TypeCls:RefreshRedPointLimit(1)
end

