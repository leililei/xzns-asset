end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function LimitTimeSynModel:CheckRedPointNumChild(index, param)
    if self.SelfData[LimitTimeEnum[index]] then
        return self.SelfData[LimitTimeEnum[index]]:CheckRedPoint()
    end
    return 0
end
---刷新奖励红点
function LimitTimeSynModel:RefreshRedPointLimit(index)
    if index == 1 then
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(index))
        return
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(index))
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---刷新任务数据
function LimitTimeSynModel:UpdateTask(taskinfo)
    if self.SelfData["task"] then
        self.SelfData["task"]:UpdateTask(taskinfo)
    else
        if _G.AppSetting.DEBUG then
            _G.Log("活动里没有对应任务模块或数据", taskinfo.sid)
        end
    end
end
