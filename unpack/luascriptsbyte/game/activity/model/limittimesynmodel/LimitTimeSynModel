        return self.SelfData["exchange"]:GetCoinSid()
    end
end
---购买免费礼包
function LimitTimeSynModel:BuyActivityGiftFree(sid, call)
    if self.SelfData["cash_gift"] then
        self.SelfData["cash_gift"]:BuyActivityGiftFree(sid, call)
    end
end
function LimitTimeSynModel:BuyGift(good, index)
    if self.SelfData["cash_gift"] then
        self.SelfData["cash_gift"]:BuyGift(good, index)
    end
    if self.SelfData["exchange"] then
        self.SelfData["exchange"]:UpdateView()
    end
