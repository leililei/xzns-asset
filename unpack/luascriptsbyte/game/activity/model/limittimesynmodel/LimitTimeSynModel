    for k, v in pairs(info.cash_task_exchange) do
        if not self.SelfData[k] then
            self.SelfData[k] = LimitTimeModels[k]:New(v, self)
        else
            self.SelfData[k]:Init(v, self)
        end
    end
    self.curActivityState = true
end
