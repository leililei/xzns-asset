local XianGouText = {
    [1] = "90021600007",
    [2] = "90021600008",
    [3] = "90021600009",
    [4] = "90021600010"
}
local GiftModel = require "GiftModel"
local CashGiftModel = _G.BaseClass("CashGiftModel")
---@param data i_activity_exchange
function CashGiftModel:__init(obj, data, TypeCls)
    self:Init(data, TypeCls)
    self.redpoint = false
end
function CashGiftModel:Init(data, TypeCls)
    self.Data = {}
    self.BuyTimeList = {}
    self.TypeCls = TypeCls
    self:InitData(data)
end
function CashGiftModel:OnInitFunction()
end
function CashGiftModel:InitData(data)
    local _data
    self:SetGiftBuyTime(data.times)
    if data.gifts then
        for k, v in pairs(data.gifts) do
            _data = {}
            _data.sid = v.sid
            _data.icon = v.icon
            _data.award = self:GetAward(v.award)
            _data.conditons = v.condition
            _data.name = v.name
            _data.count = v.count
            _data.price = v.price
            _data.type_reset = v.type_reset
            _data.discount = v.discount
            _data.sellout = self:CheckGiftSellOut(v.sid, v.count)
            _data.limit = self:GetLimit(v.sid, v.type_reset, v.count)
            _G.table.insert(self.Data, _data)
        end
    end
    self:SortGoods()
    if self.TypeCls:GetActivityState() == ActivitySynManager.State.Open then
        GiftModel:GetInstance():AddLimitGift(self.Data, self.TypeCls.ActivityID, 90010050031)
        require("MallManager"):GetInstance():UpdataView(_G.MallViewPage.gift)
    end
    self.TypeCls:RefreshRedPointLimit(3)
end
function CashGiftModel:GetAward(award)
    local _award = {}
    for i = 1, #award do
        _award[i] = {}
        for _, v in pairs(award[i].type) do
            _G.table.insert(_award[i], v)
        end
    end
    return _award
end
function CashGiftModel:GetLimit(sid, type_reset, count)
    if type_reset then
        local buytime = self:GetGiftBuyTime(sid)
        return _G.LangUtil.GetLangPackValue(XianGouText[type_reset], buytime, count)
    else
        return nil
    end
end
function CashGiftModel:SetBuyTime(sid, time)
    if not self.BuyTimeList[sid] then
        self.BuyTimeList[sid] = {sid = sid, times = time}
    else
        self.BuyTimeList[sid].times = time
    end
end
function CashGiftModel:BuyGift(good, index)
    good.sellout = self:CheckGiftSellOut(good.id, good.count)
    good.limit = self:GetLimit(good.id, good.type_reset, good.count)
    require "GiftModel":GetInstance():Sortfunc(index)
    self:SortGoods()
end
function CashGiftModel:SortGoods()
    _G.SortList(
        self.Data,
        function(a)
            local res = a.sellout == true and 0 or 1
            return res, -a.price
        end
    )
end
function CashGiftModel:SetGiftBuyTime(times)
    if not times then
        self.BuyTimeList = {}
        return
    end
    for k, v in pairs(times) do
        if not self.BuyTimeList[v.k] then
            self.BuyTimeList[v.k] = {}
        end
        self.BuyTimeList[v.k] = {sid = v.k, times = v.v}
    end
end
function CashGiftModel:CheckGiftSellOut(sid, count)
    local good = self.BuyTimeList[sid]
    if good then
        return not (good.times < count)
    else
        return false
    end
end
function CashGiftModel:GetGiftBuyTime(sid)
    local good = self.BuyTimeList[sid]
    if good then
        return good.times
    else
        return 0
    end
end
function CashGiftModel:SetItemBuyTimes(sid)
    local time = self:GetGiftBuyTime(sid)
    self:SetBuyTime(sid, time + 1)
end
function CashGiftModel:CheckRedPoint()
    if self.TypeCls:GetActivityState() ~= ActivitySynManager.State.Open then
        return 0
    else
        if not self.redpoint then
            if not isEmptyOrNil(self.Data) then
                for k, v in pairs(self.Data) do
                    if not v.sellout then
                        return 1
                    end
                end
                return 0
            else
                return 0
            end
        else
            return 0
        end
    end
end
function CashGiftModel:OnEnterLimitView()
    self.redpoint = true
    GiftModel:GetInstance():JumpToActivityPage(self.TypeCls.ActivityID)
    self.TypeCls:RefreshRedPointLimit(3)
    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.gift)
end
function CashGiftModel:OnActivityStateChanged(state)
    self.TypeCls:RefreshRedPointLimit(3)
    if state ~= ActivitySynManager.State.Open then
        GiftModel:GetInstance():RemoveLimitGift(self.TypeCls.ActivityID)
        require("MallManager"):GetInstance():UpdataView(_G.MallViewPage.gift)
    end
end
function CashGiftModel:BuyActivityGiftFree(sid, call)
    require "ActivitySynNet":GetInstance():GetAward(
        self.TypeCls.ActivityID,
        {sid},
        function(data)
            if data.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                require "CommonTipManager".OpenCommonAwardView(data)
                self:SetItemBuyTimes(sid)
                if call then
                    call()
                end
            end
        end
    )
end

function CashGiftModel:Dispose()
end
