local base = require "ActivitySynTypeBase"
---@class TapTapJumpSynModel : ActivitySynTypeBase	TAPTAP界面跳转
local TapTapJumpSynModel = _G.BaseClass("TapTapJumpSynModel", base)

---创建对象时,入口构造函数
function TapTapJumpSynModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self:RefreshRedPoint()
end

---获取服务器数据
function TapTapJumpSynModel:GetDataFormServer()
    ---B站与渠道去掉TAP跳转,渠道策划改配置屏蔽
    if _G.CS.Launcher.Inst.IsSDK then
        local channelId = _G.ServerManager:GetInstance().AppInfo.Platform
        if channelId == 352 then
            self.curActivityClass:ChangeState(require("ActivitySynManager"):GetInstance().State.Close)
        end
    end
    base.ParseData(self)
end

function TapTapJumpSynModel:OnEnterActivity()
    self:SetWeekRed()
    self:RefreshRedPoint()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TapTapJumpView.Name, self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function TapTapJumpSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.TapTapJumpView.Name
end

---初始化红点树
function TapTapJumpSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function TapTapJumpSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function TapTapJumpSynModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() ~= require "ActivitySynManager".State.Open then
        return 0
    end
    local dayLimit =
        _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "TapTapJump" .. self.ActivityId)
    local now = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    if now > dayLimit then
        return 1
    end
    return 0
end

---红点刷新时间写入
function TapTapJumpSynModel:SetWeekRed()
    local endTime = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(
        _G.PlayerModel:GetInstance():GetPlayerUid() .. "TapTapJump" .. self.ActivityId,
        endTime
    )
end

---刷新奖励红点
function TapTapJumpSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function TapTapJumpSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.super.Dispose(self)
end

return TapTapJumpSynModel
