local base = require("ActivitySynTypeBase")

---@class MiniGameSynModel : ActivitySynTypeBase	国庆接红包小游戏
---@field gameType number 游戏类型: 1接红包, 2送外卖
---@field takeOutGame MiniTakeOutGameModel  GM小游戏_赛车
local MiniGameSynModel = _G.BaseClass("MiniGameSynModel", base)

--小游戏类型
local GmaeTypes = {
    FestivalRedBound = 1, --接红包小游戏
    TakeOutGame = 2,      --送外卖/赛车小游戏
    MTSwordCasual = 3,    --MT联动_剑之修行
    SnowBallBigWar = 101,    --雪球大作战
    FlowerCarParade = 4      --花车巡礼
}

---创建对象时,入口构造函数
function MiniGameSynModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    if self.curActivityClass.cfg.self_info.mini_game then
        self.gameType = self.curActivityClass.cfg.self_info.mini_game.base_cfg.type
    else
        self.gameType = GmaeTypes.FestivalRedBound --默认活动类型(兼容以前的配置)
    end

    --LogError(self.gameType)
    --self.gameType = 4

    if self.gameType == GmaeTypes.FestivalRedBound then
        --FestivalRedBoundModel是通用小游戏接口, 因涉及较多模块, 名称暂时不作修改
        require "FestivalRedBoundModel":GetInstance():ParseData(self.curActivityClass)
    elseif self.gameType == GmaeTypes.TakeOutGame or
        self.gameType == GmaeTypes.MTSwordCasual or self.gameType == GmaeTypes.FlowerCarParade then
        --送外卖/赛车小游戏与MT联动_剑之修行结构相同
        self.takeOutGame = require("MiniTakeOutGameModel").New(self.curActivityClass)
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        ---雪球
        require "SnowBallRedBoundModel":GetInstance():ParseData(self.curActivityClass)
    end

    --刷新红点状态
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    self:RefreshRedPoint()
end

---获取服务器数据
function MiniGameSynModel:GetDataFormServer()
    base.ParseData(self)
end

function MiniGameSynModel:InitFunction()
    if self.gameType == GmaeTypes.FestivalRedBound then
        require "FestivalRedBoundModel":GetInstance():ParseData(self.curActivityClass)
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        ---雪球
        require "SnowBallRedBoundModel":GetInstance():ParseData(self.curActivityClass)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未知的小游戏类型: " .. tostring(self.gameType))
        end
    end
end

