function MiniGameSynModel:OnEnterActivity()
    self:RefreshRedPoint()
    local type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    local name
    if self.gameType == GmaeTypes.FestivalRedBound then
        if type == _G.JointActivityType.SpringFestival then
            name = _G.ConfigManager.ui_cfg.SpringFestivalRedBoundMainView.Name
            _G.UIManager:GetInstance():OpenWindow(
                    name,
                    self.curActivityClass
            )
        else
            name = _G.ConfigManager.ui_cfg.FestivalRedBoundMainView.Name
            _G.UIManager:GetInstance():OpenWindow(
                    name,
                    self.curActivityClass
            )
        end
    elseif self.gameType == GmaeTypes.TakeOutGame then
        name = _G.ConfigManager.ui_cfg.TakeOutGameMainView.Name
        _G.UIManager:GetInstance():OpenWindow(
            name,
            self.curActivityClass,
            self.takeOutGame
        )
    elseif self.gameType == GmaeTypes.FlowerCarParade then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.FlowerCarParadeMainView.Name,
            self.curActivityClass,
            self.takeOutGame
        )
    elseif self.gameType == GmaeTypes.MTSwordCasual then
        if type==_G.JointActivityType.SpringFestival then
            name = _G.ConfigManager.ui_cfg.SpringSwordCasualMainView.Name
            _G.UIManager:GetInstance():OpenWindow(
                    name,
                    self.curActivityClass,
                    self.takeOutGame
            )
        else
            name = _G.ConfigManager.ui_cfg.MTSwordCasualMainView.Name
            _G.UIManager:GetInstance():OpenWindow(
                    name,
                    self.curActivityClass,
                    self.takeOutGame
            )
        end
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SnowBallRedBoundMainView.Name,
            self.curActivityClass,
            self.takeOutGame
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未知的小游戏类型: " .. tostring(self.gameType))
        end
    end
    if name and _G.AppSetting.IsXzns then
        require("RescueGoddessModel"):GetInstance():SetPlayingView(name)
    end
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function MiniGameSynModel:IsShowBtn()
    return false
end

function MiniGameSynModel:OnGetMainViewName()
    if self.gameType == GmaeTypes.FestivalRedBound then
        return _G.ConfigManager.ui_cfg.FestivalRedBoundView.Name
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        return _G.ConfigManager.ui_cfg.SnowBallRedBoundMainView.Name
    end
end

---初始化红点树
function MiniGameSynModel:InitRedPointTree()
    self.checkRedPointFunc = {
        self.CheckRedPoint,
        nil,
        self.CheckCoinRedPoint,
        self.CheckExtraAwardRedPoint,
        self.CheckChallengeRedPoint
    }
    self.redpointTree = {
        { 2, 3, 4, 5 }, --主红点
        false,         --用于挂载战令丶战令任务
        false,         --挑战/扫荡按钮
        false,         --额外奖励
        false,         --是否可以进行首通挑战
    }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function MiniGameSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self, param)
    end
    return 0
end

---监听活动状态改变
function MiniGameSynModel:OnActivityStateChanged(_, state)
    local type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if state == require("ActivitySynManager").State.Close then
        if self.gameType == GmaeTypes.FestivalRedBound then
            if  type == _G.JointActivityType.SpringFestival then
                _G.UIManager:GetInstance():CloseWindow(
                        _G.ConfigManager.ui_cfg.SpringFestivalRedBoundMainView.Name
                )
            else
                _G.UIManager:GetInstance():CloseWindow(
                        _G.ConfigManager.ui_cfg.FestivalRedBoundMainView.Name
                )
            end
        elseif self.gameType == GmaeTypes.TakeOutGame then
            _G.UIManager:GetInstance():CloseWindow(
                _G.ConfigManager.ui_cfg.TakeOutGameMainView.Name
            )
        elseif self.gameType == GmaeTypes.FlowerCarParade then
            _G.UIManager:GetInstance():CloseWindow(
                _G.ConfigManager.ui_cfg.FlowerCarParadeMainView.Name
            )
        elseif self.gameType == GmaeTypes.MTSwordCasual then
            if type== _G.JointActivityType.SpringFestival then
                _G.UIManager:GetInstance():CloseWindow(
                        _G.ConfigManager.ui_cfg.SpringSwordCasualMainView.Name
                )
            else
                _G.UIManager:GetInstance():CloseWindow(
                        _G.ConfigManager.ui_cfg.MTSwordCasualMainView.Name
                )
            end
        elseif self.gameType == GmaeTypes.SnowBallBigWar then
            _G.UIManager:GetInstance():CloseWindow(
                _G.ConfigManager.ui_cfg.SnowBallRedBoundView.Name
            )
            _G.UIManager:GetInstance():CloseWindow(
                _G.ConfigManager.ui_cfg.SnowBallRedBoundBattlePassGiftView.Name
            )
            _G.UIManager:GetInstance():CloseWindow(
                _G.ConfigManager.ui_cfg.SnowBallRedBoundMainView.Name
            )
        end
        --活动已关闭
        --_G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

---检查红点
function MiniGameSynModel:CheckRedPoint(param)
    if self.gameType == GmaeTypes.FestivalRedBound then
        local FestivalRedBoundModel = require("FestivalRedBoundModel"):GetInstance()
        if #FestivalRedBoundModel:GetBattleGift(self.ActivityId) > 0 then
            local battleActivitys = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10027,
                self.curActivityClass:GetJumpType(),
                self.curActivityClass:GetMainType()
            )
            if battleActivitys then
                local activityTypeLua = battleActivitys:GetActivityTypeCls()
                if activityTypeLua and activityTypeLua:GetIsUp(battleActivitys:GetActivityID()) then
                    return 1
                end
            end
        end
        self.getTicketBol, self.nextTime = FestivalRedBoundModel:CheckCanGetTicket(self.ActivityId)
        if self.getTicketBol then
            return 1
        end
        local T = FestivalRedBoundModel:GetCanGetSectionAwardList(self.ActivityId)
        if #T > 0 then
            return 1
        end
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        local SnowBallRedBoundModel = require("SnowBallRedBoundModel"):GetInstance()
        if #SnowBallRedBoundModel:GetBattleGift(self.ActivityId) > 0 then
            local battleActivitys = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10027,
                self.curActivityClass:GetJumpType(),
                self.curActivityClass:GetMainType()
            )
            if battleActivitys then
                local activityTypeLua = battleActivitys:GetActivityTypeCls()
                if activityTypeLua and activityTypeLua:GetIsUp(battleActivitys:GetActivityID()) then
                    return 1
                end
            end
        end
        self.getTicketBol, self.nextTime = SnowBallRedBoundModel:CheckCanGetTicket(self.ActivityId)
        if self.getTicketBol then
            return 1
        end
        local T = SnowBallRedBoundModel:GetCanGetSectionAwardList(self.ActivityId)
        if #T > 0 then
            return 1
        end
    end
    return 0
end

---是否可以开启挑战(有代币)
---@return number 红点数量
function MiniGameSynModel:CheckCoinRedPoint(param)
    if self.gameType == GmaeTypes.TakeOutGame or
        self.gameType == GmaeTypes.MTSwordCasual or self.gameType == GmaeTypes.FlowerCarParade then
        --有代币可用
        if self.takeOutGame:GetCoinNumber() > 0 then
            return 1
        end
    end
    return 0
end

---是否可以进行首通关卡
function MiniGameSynModel:CheckChallengeRedPoint(param)
    if self.gameType == GmaeTypes.TakeOutGame or
        self.gameType == GmaeTypes.MTSwordCasual or self.gameType == GmaeTypes.FlowerCarParade then
        --新关卡已解锁
        if not self.takeOutGame:IsLock(self.takeOutGame:GetStageIndex()) and not self.takeOutGame:IsPass(self.takeOutGame:GetStageSid()) then
            return 1
        end
    end
    return 0
end

---是否有额外奖励
---@return number 红点数量
function MiniGameSynModel:CheckExtraAwardRedPoint(param)
    if self.gameType == GmaeTypes.TakeOutGame or
        self.gameType == GmaeTypes.MTSwordCasual or self.gameType == GmaeTypes.FlowerCarParade then
        local extraAward = self.takeOutGame:GetExtraAwardData()
        if extraAward and #extraAward > 0 then
            --检查是否已购买战令
            local battlePass = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10088,
                self.curActivityClass:GetJumpType(),
                self.curActivityClass:GetMainType()
            )
            if battlePass and battlePass:GetActivityTypeCls().isBuy then
                return 1
            end
            return 0
        end
    end
    return 0
end

---刷新奖励红点
function MiniGameSynModel:RefreshRedPoint()
    --刷新所有子红点
    local redPointManager = require("RedPointManager"):GetInstance()
    for i = #self.redpointTree, 1, -1 do
        local redpointId = self:GetRedpointIDByIndex(i)
        redPointManager:RefreshNode(redpointId)
    end
end

---增加门票
function MiniGameSynModel:AddCoin(num)
    if self.gameType == GmaeTypes.FestivalRedBound then
        require("FestivalRedBoundModel"):GetInstance():AddCoin(num, self.ActivityId)
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        require("SnowBallRedBoundModel"):GetInstance():AddCoin(num, self.ActivityId)
    elseif self.gameType == GmaeTypes.TakeOutGame or
        self.gameType == GmaeTypes.MTSwordCasual or self.gameType == GmaeTypes.FlowerCarParade  then
        self.takeOutGame:AddCoinNumber(num)
    end
end

---获取当前代币数量
---@return number
function MiniGameSynModel:GetCoinNumber()
    if self.gameType == GmaeTypes.FestivalRedBound then
        return require("FestivalRedBoundModel"):GetInstance():GetCoin(self.ActivityId)
    elseif self.gameType == GmaeTypes.SnowBallBigWar then
        return require("SnowBallRedBoundModel"):GetInstance():GetCoin(self.ActivityId)
    elseif self.gameType == GmaeTypes.TakeOutGame or
        self.gameType == GmaeTypes.MTSwordCasual or self.gameType == GmaeTypes.FlowerCarParade then
        return self.takeOutGame:GetCoinNumber()
    end
    return 0
end

function MiniGameSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.super.Dispose(self)
end

---获取活动剩余时间
---@return number
function MiniGameSynModel:GetRemianDuration()
    local timeCfg = self.curActivityClass.cfg.time
    local endTime = timeCfg.start_time +
        timeCfg.run_time +
        timeCfg.get_time +
        timeCfg.show_time
    return math.max(0, endTime - _G.TimeUtil.GetServerUnixTime())
end

return MiniGameSynModel
