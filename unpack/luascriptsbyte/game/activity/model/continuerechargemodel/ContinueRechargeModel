function ContinueRechargeModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ContinueRecharge.Name, self:GetActivityCommonData())
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function ContinueRechargeModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ContinueRecharge.Name
end
---处理活动私有信息
---@type i_activity_exchange
function ContinueRechargeModel:SetSelfData(info)
    self.SelfData = {}
    local _data
    local cash = 0
    ---当前充值挡位
    self.CurCashSid = info.day_cash.cash_sid
    self.curActivityState = true
    for _, v in pairs(info.day_cash.item) do
        _data = {}
        _data.Sid = v.day
        ---@type prop.i_award_item
        _data.Award = v.award
        _data.CashNum = v.cash_num
        _data.State = self.CurCashSid == 0 and 1 or 0
        _G.table.insert(self.SelfData, _data)
    end
    _G.SortList(
        self.SelfData,
        function(a)
            return -a.Sid
        end
    )
    ---@return boolean 是否已领取
    local checkIsGet = function(sid, _table)
        if not _G.table.isEmptyOrNil(_table) then
            for _, v in pairs(_table) do
                ---解析已完成已领取的档位
                if v == sid then
                    return true
                end
            end
            return false
        else
            return false
        end
    end
    if self.CurCashSid ~= 0 then
        for k, v in pairs(self.SelfData) do
            ---小于当前档位的 又不在已领取档位中的 即可以领取
            if v.Sid < self.CurCashSid then
                if checkIsGet(v.Sid, info.day_cash.get_sids) then
                    v.State = 1
                else
                    v.State = 2
                end
            elseif v.Sid == self.CurCashSid then
                if checkIsGet(v.Sid, info.day_cash.get_sids) then
                    v.State = 1
                end
            end
        end
        ---根据当前正在进行的档位的对应累计充值金额判断当前档位完成情况
        local c = true ---停止符
        for _, data in pairs(self.SelfData) do
            if c then
                if not _G.table.isEmptyOrNil(info.day_cash.cash_info) then
                    for _, cashinfo in pairs(info.day_cash.cash_info) do
                        if cashinfo.k == self.CurCashSid and cashinfo.k == data.Sid and data.State ~= 1 then
                            cash = cashinfo.v
                            if cash >= data.CashNum then
                                data.State = 2
                            end
                            c = false
                            break
                        end
                    end
                else
                    break
                end
            else
                break
            end
        end
    end
    if self:CheckActivityState() and self.curActivityClass:GetHideViewByAward() then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
    self.SelfData.curCashInfo = {self.CurCashSid, cash}
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ContinueRecharge.Name)
        if view then
            view.View:InitView(self:GetActivityCommonData())
        end
    end
    ---ZHJ-22428 移除免费赠礼
    --require "FreeGiftManager":GetInstance():Add(
    --    _G.FreeGiftID.ContinueRecharge,
    --    info.day_cash.day_award,
    --    function(call)
    --        require "ActivitySynNet":GetInstance():GetAward(
    --            self.curActivityClass:GetActivityID(),
    --            {0},
    --            function(msg)
    --                if call then
    --                    call(msg)
    --                end
    --            end
    --        )
    --    end,
    --    self:GetRedpointIDByIndex(1),
    --    self.curActivityClass:GetActivityID()
    --)
    if self.CallBack ~= nil then
        self.CallBack()
    end
    self:RefreshRedPointContinueRecharge()
end
function ContinueRechargeModel:CheckActivityState()
    for i = 1, #self.SelfData do
        if self.SelfData[i].State ~= 1 then
            return false
        end
    end
    return true
end
function ContinueRechargeModel:GetAward(parms, call)
    require "ActivitySynNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        parms,
        function(msg)
            if call then
                call(msg)
            end
            self:RefreshRedPointContinueRecharge()
        end
    )
end
function ContinueRechargeModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.DayCash, self.OnCash, self)
    self.curActivityState = nil
    self.SelfData = nil
end

return ContinueRechargeModel
