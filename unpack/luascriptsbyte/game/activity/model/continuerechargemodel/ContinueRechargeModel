local ActivitySynNet = require "ActivitySynNet"
local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class ContinueRechargeModel : Singleton
local ContinueRechargeModel = _G.BaseClass("ContinueRechargeModel", base)
function ContinueRechargeModel:__init()
    _G.Events:GetInstance():AddListener(_G.eRechargeEvent.DayCash, self.OnCash, self)
    self.curActivityState = false
    self.curActivityClass:AddStateChanged(self.StateChange, self)
end
---当状态改变
function ContinueRechargeModel:StateChange(state)
    if state == ActivitySynManager.State.Close then
        require "FreeGiftManager":GetInstance():Remove(
            _G.FreeGiftID.ContinueRecharge,
            self.curActivityClass:GetActivityID()
        )
    end
end

---@param msg s2c_activity_recruiting_info
function ContinueRechargeModel:OnHandleGMData(info)
    self:ParseData(info)
end
function ContinueRechargeModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end
function ContinueRechargeModel:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.UpdateInitData)
    )
end
function ContinueRechargeModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end
function ContinueRechargeModel:OnCash()
    self:GetInfo(_G.handler(self, self.RefreshRedPointContinueRecharge))
end
---初始化功能逻辑
function ContinueRechargeModel:InitFunction()
    if not self.curActivityState then
        return
    end
end
function ContinueRechargeModel:GetActivityCommonData()
    return self.curActivityClass
end
function ContinueRechargeModel:GetCurActivitySelfData()
    return self.SelfData
end
-- ---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ContinueRechargeModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckHaveAwardItem}
    self.redpointTree = {{2}, false}
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ContinueRechargeModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
---刷新奖励红点
function ContinueRechargeModel:RefreshRedPointContinueRecharge()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---是否有可以足够兑换次数可以兑换的item
