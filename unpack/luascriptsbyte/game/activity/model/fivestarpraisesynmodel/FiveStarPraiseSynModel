local base = require "ActivitySynTypeBase"
---@class FiveStarPraiseSynModel : ActivitySynTypeBase	五星好评
local FiveStarPraiseSynModel = _G.BaseClass("FiveStarPraiseSynModel", base)

---创建对象时,入口构造函数
function FiveStarPraiseSynModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self:RefreshRedPoint()
end

function FiveStarPraiseSynModel:IsShowBtn()
    local channelId = _G.tonumber(_G.ServerManager:GetInstance().AppInfo.Platform)
    local cfg = _G.ConfigManager.function_block_cfg
    if cfg[channelId] and not _G.string.IsNullOrEmpty(cfg[channelId].good_rating) then
        return true
    end
    return false
end

---获取服务器数据
function FiveStarPraiseSynModel:GetDataFormServer()
    require("FiveStarPraiseNet"):GetInstance():GetInfo(
        function(data)
            self:ParseData(data)
        end
    )
end

function FiveStarPraiseSynModel:ParseData(data)
    self.IsOpinion = 0
    self.IsAward = 0
    if data then
        self.IsOpinion = data.is_opinion or 0
        self.IsAward = data.is_award or 0
    end
    self.super.ParseData(self)
    --ZHJH-12581 领取过奖励就关闭活动
    if self.IsAward == 1 then
        self.curActivityClass:ChangeState(require("ActivitySynManager"):GetInstance().State.Close)
    end
end

function FiveStarPraiseSynModel:OnEnterActivity()
    self:SetWeekRed()
    self:RefreshRedPoint()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FiveStarPraiseTipsView.Name, self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function FiveStarPraiseSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.FiveStarPraiseTipsView.Name
end

---初始化红点树
function FiveStarPraiseSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function FiveStarPraiseSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function FiveStarPraiseSynModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() ~= require "ActivitySynManager".State.Open then
        return 0
    end
    if self.IsAward == 1 then
        return 0
    end
    local dayLimit =
        _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "fivesatrpraise" .. self.ActivityId)
    local now = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    if now > dayLimit then
        return 1
    end
    return 0
end

---红点刷新时间写入
function FiveStarPraiseSynModel:SetWeekRed()
    local endTime = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(
        _G.PlayerModel:GetInstance():GetPlayerUid() .. "fivesatrpraise" .. self.ActivityId,
        endTime
    )
end

---刷新奖励红点
function FiveStarPraiseSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function FiveStarPraiseSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.super.Dispose(self)
end

return FiveStarPraiseSynModel
