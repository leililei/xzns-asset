local base = require "ActivitySynTypeBase"
---@class SevenGiftGMModel : ActivitySynTypeBase	七日礼包GM活动
local SevenGiftGMModel = _G.BaseClass("SevenGiftGMModel", base)

---创建对象时,入口构造函数
function SevenGiftGMModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self:RefreshRedPoint()
    require "SevenGiftGMSynModel":GetInstance():AddActivity(self.curActivityClass)
end

---获取服务器数据
function SevenGiftGMModel:GetDataFormServer()
    base.ParseData(self)
end

function SevenGiftGMModel:InitFunction()
    require "SevenGiftGMSynModel":GetInstance():AddActivity(self.curActivityClass)
end

function SevenGiftGMModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SevenGiftGMView.Name, self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function SevenGiftGMModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.SevenGiftGMView.Name
end

function SevenGiftGMModel:IsShowBtn()
    return false 
end

---初始化红点树
function SevenGiftGMModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function SevenGiftGMModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function SevenGiftGMModel:CheckRedPoint()
    return 0
end

---刷新奖励红点
function SevenGiftGMModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function SevenGiftGMModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    require "SevenGiftGMSynModel":GetInstance():CloseActive(self.ActivityId)
    self.super.Dispose(self)
end

return SevenGiftGMModel
