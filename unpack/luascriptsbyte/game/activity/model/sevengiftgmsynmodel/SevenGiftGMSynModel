---购买礼包
function SevenGiftGMSynModel:BuyGift(data, sid, callBack)
    self.curBuyGift = data
    self.curSid = sid
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require("MallManager"):GetInstance():BuyActiveGift(data.price_id, self.curSid, data.id)
end

function SevenGiftGMSynModel:OnMallCashListener(data)
    if data.sid == self.curBuyGift.id then
        local curGiftData = self.GiftList[self.curSid]
        curGiftData.buyList[data.sid] = 1
        curGiftData.buyCount = curGiftData.buyCount + 1

        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end

        if curGiftData.buyCount == _G.table.count(curGiftData.giftList) then
            self:CloseActive(self.curSid)
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

