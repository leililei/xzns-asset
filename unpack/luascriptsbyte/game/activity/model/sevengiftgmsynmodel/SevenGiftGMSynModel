    for k, v in ipairs(self.OpenGift or {}) do
        if v.id == sid then
            index = k
            changeBol = true
        end
    end
    if changeBol then
        table.remove(self.OpenGift, index)
        _G.MainManager:GetInstance():UpdateSevenGiftGMIcon()
        if #self.OpenGift == 0 then
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.SevenGiftGM)
        end
    end
