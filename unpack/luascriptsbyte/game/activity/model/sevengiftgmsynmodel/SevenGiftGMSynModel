function SevenGiftGMSynModel:AddActivity(act)
    self.GiftList = self.GiftList or {}
    if not self.GiftList[act.cfg.self_info.seven_gift.cfg.id] then
        local data = {}
        local temp1
        local temp2 = {}
        data.id = act.activityID
        data.gift_name = tonumber(act.cfg.self_info.seven_gift.cfg.gift_name)
        data.product_art_resources = act.cfg.self_info.seven_gift.cfg.product_art_resources
        data.scaling_translation_1 = _G.string.split(act.cfg.self_info.seven_gift.cfg.scaling_translation_1, "#")
        data.artistic_lettering = _G.string.split(act.cfg.self_info.seven_gift.cfg.artistic_lettering, "#")
        temp1 = _G.string.split(act.cfg.self_info.seven_gift.cfg.scaling_translation_2, "|")
        data.scaling_translation_2 = {}
        for i = 1, #temp1 do
            data.scaling_translation_2[i] = _G.string.split(temp1[i], "#")
        end
        temp1 = _G.string.split(act.cfg.self_info.seven_gift.cfg.label_translation, "|")
        data.label_translation = {}
        for i = 1, #temp1 do
            data.label_translation[i] = _G.string.split(temp1[i], "#")
        end
        data.label_name = _G.string.split(act.cfg.self_info.seven_gift.cfg.label_name, "#")
        data.main_icon = act.cfg.self_info.seven_gift.cfg.main_icon
        data.type = act.cfg.self_info.seven_gift.cfg.type
        data.type1 = _G.string.split(act.cfg.self_info.seven_gift.cfg.type1, "#")
        data.giftList = act.cfg.self_info.seven_gift.cfg.store_extra
        --data.continueTime = v.disappear
        data.state = StateType.unOpen
        data.buyList = {}
        data.curDay = 0
        data.buyCount = 0
        data.startTime = act.cfg.time.start_time
        data.endTime = act.cfg.time.start_time + act.cfg.time.run_time + act.cfg.time.get_time + act.cfg.time.show_time
        data.activity = act
        if act.cfg.self_info.seven_gift.times then
            for i = 1, #act.cfg.self_info.seven_gift.times do
                if act.cfg.self_info.seven_gift.times[i].v > 0 then
                    data.buyList[act.cfg.self_info.seven_gift.times[i].k] = 1
                    data.buyCount = data.buyCount + 1
                end
            end
        end
        self.GiftList[data.id] = data
    end
end

