local base = require "ActivitySynTypeBase"
---@class CDKeyModel
local CDKeyModel = _G.BaseClass("CDKeyModel", base)
local ActivitySynManager = require "ActivitySynManager"
---入口构造函数
function CDKeyModel:__init()
    self.CodeInfo = {}
    self.CDKeyFunc = nil
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
end

---析构函数
function CDKeyModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerUpLevel, self.PlayerUpLevel, self)
    _G.Events:GetInstance():RemoveListener(_G.eAfkEvents.Pass, self.PlayerUpLevel, self)
end

function CDKeyModel:PlayerUpLevel()
    local condition
    if self.type == 1 then
        condition = _G.PlayerModel:GetInstance():GetLevel()
    elseif  self.type == 4 then
        condition = require("AfkModel"):GetInstance():GetLastSection()
    elseif self.type == 50 then 
        local openTime = _G.PlayerModel:GetInstance():GetServerOpenTime()
        local curTime = _G.TimeUtil.GetServerUnixTime()
        condition = _G.TimeUtil.GetInterValDayByGame(openTime,curTime)
    elseif self.type == 52 then
        condition = _G.PlayerModel:GetInstance():DayCount()
    end
    if self.Needcondition <= condition then
        local value = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "CDKeyRedPoint",2)
        if value ~= 2 then
            return
        end
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "CDKeyRedPoint", 0)
        self.RedPoint = true
        self:LvRedPoint()
    end
end
function CDKeyModel:OnActivityStateChanged(state)
    if state == ActivitySynManager.State.Open then
        _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "CDKeyRedPoint", 0)
    end
end

function CDKeyModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CDKeyView.Name, self.curActivityClass)
end

function CDKeyModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.CDKeyView.Name
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function CDKeyModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckIsGet}
    self.redpointTree = {false}
end
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function CDKeyModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
---点击后刷新红点
function CDKeyModel:UpdateRedPoint()
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "CDKeyRedPoint", 1)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---等级更新后刷新红点
function CDKeyModel:LvRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---检测礼包码是否被领取
function CDKeyModel:CheckIsGet()
    local value = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "CDKeyRedPoint")
    local flag =
        require "ActivitySynManager":GetInstance():CheckActivityConditionExtra(self.curActivityClass:GetActivityID())
    if flag and value == 0 then
        return 1
    else
        return 0
    end
end

---获取数据
function CDKeyModel:HandleGMData(info)
    self:SetData(info)
    base.ParseData(self)
end
---处理兑换码活动信息
function CDKeyModel:SetData(data)
    self.CodeInfo = data
    self.IsGet = data.gift_code.is_get
    self.type = data.gift_code.condition[1].k
    self.Needcondition = data.gift_code.condition[1].v
    local curCondition
    if self.type == 1 then --等级
        curCondition = _G.PlayerModel:GetInstance():GetLevel()
        if self.Needcondition ~= nil and curCondition < self.Needcondition then
            _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerUpLevel, self.PlayerUpLevel, self)
        end
    elseif self.type == 4 then --放置关卡
        curCondition = require("AfkModel"):GetInstance():GetLastSection()
        if self.Needcondition ~= nil and curCondition < self.Needcondition then
            _G.Events:GetInstance():AddListener(_G.eAfkEvents.Pass, self.PlayerUpLevel, self)
        end
    -- elseif self.type == 50 then 
    --     local openTime = _G.PlayerModel:GetInstance():GetServerOpenTime()
    --     local curTime = _G.TimeUtil.GetServerUnixTime()
    --     curCondition = _G.TimeUtil.GetInterValDayByGame(openTime,curTime)
    -- elseif self.type == 52 then --登录天数
    --     curCondition = _G.PlayerModel:GetInstance():DayCount()
    end
    self:PlayerUpLevel()
end

return CDKeyModel
