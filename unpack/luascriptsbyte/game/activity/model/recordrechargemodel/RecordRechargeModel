local ActivitySynNet = require "ActivitySynNet"
local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class RecordRechargeModel : ActivitySynTypeBase
local RecordRechargeModel = _G.BaseClass("RecordRechargeModel", base)
function RecordRechargeModel:__init()
    _G.Events:GetInstance():AddListener(_G.eRechargeEvent.TotalCash, self.OnCash, self)
    self.curActivityState = false
    self.curActivityClass:AddStateChanged(self.StateChange, self)
end
---当状态改变
function RecordRechargeModel:StateChange(state)
    if state == ActivitySynManager.State.Close then
        require "FreeGiftManager":GetInstance():Remove(
            _G.FreeGiftID.RecordRecharge,
            self.curActivityClass:GetActivityID()
        )
    end
end
---@param msg s2c_activity_recruiting_info
function RecordRechargeModel:OnHandleGMData(info)
    self:ParseData(info)
end
function RecordRechargeModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end
function RecordRechargeModel:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.UpdateInitData)
    )
end
function RecordRechargeModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end
function RecordRechargeModel:OnCash()
    self:GetInfo(_G.handler(self, self.RefreshRedPointRecordRecharge))
end
---初始化功能逻辑
function RecordRechargeModel:InitFunction()
    if not self.curActivityState then
        return
    end
end
function RecordRechargeModel:GetActivityCommonData()
    return self.curActivityClass
end
function RecordRechargeModel:GetCurActivitySelfData()
    return self.SelfData
end
-- ---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function RecordRechargeModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckHaveAwardItem}
    self.redpointTree = {{2}, false}
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function RecordRechargeModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
---刷新奖励红点
function RecordRechargeModel:RefreshRedPointRecordRecharge()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---是否有可以足够兑换次数可以兑换的item
function RecordRechargeModel:CheckHaveAwardItem()
    ---免费礼包
    --if
    --    require "FreeGiftManager":GetInstance():CheckCanTake(
    --        _G.FreeGiftID.RecordRecharge,
    --        self.curActivityClass:GetActivityID()
    --    )
    -- then
    --    return 1
    --end
    if not _G.table.isEmptyOrNil(self.SelfData) then
        for i = 1, #self.SelfData do
            if self.SelfData[i].State == 2 then
                return 1
            end
        end
    end
    return 0
end
function RecordRechargeModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRecharge.Name, self:GetActivityCommonData())
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function RecordRechargeModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.RecordRecharge.Name
end
---处理活动私有信息
---@type i_activity_exchange
function RecordRechargeModel:SetSelfData(info)
    self.SelfData = {}
    local _data
    self.curActivityState = true
    self.SelfData.TotalCash = info.total_cash.total_cash
    for _, v in pairs(info.total_cash.item) do
        _data = {}
        _data.Sid = v.sid
        ---@type prop.i_award_item
        _data.Award = v.award
        _data.CashNum = v.cash_num
        _data.State = 0
        if not _G.table.isEmptyOrNil(info.total_cash.get_sid) then
            for _, a in pairs(info.total_cash.get_sid) do
                if a == v.sid then
                    _data.State = 1
                end
            end
        end
        
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(v.cash_num)

        if _data.State == 0 and self.SelfData.TotalCash >= finalPrice then
            _data.State = 2
        end
        _G.table.insert(self.SelfData, _data)
    end
    _G.SortList(
        self.SelfData,
        function(a)
            return -a.Sid
        end
    )
    if self:CheckActivityState() and self.curActivityClass:GetHideViewByAward() then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
    end
    require "FreeGiftManager":GetInstance():Add(
        _G.FreeGiftID.RecordRecharge,
        info.total_cash.day_award,
        function(call)
            require "ActivitySynNet":GetInstance():GetAward(
                self.curActivityClass:GetActivityID(),
                {0},
                function(msg)
                    if call then
                        call(msg)
                    end
                end
            )
        end,
        self:GetRedpointIDByIndex(1),
        self.curActivityClass:GetActivityID()
    )
    if self.CallBack ~= nil then
        self.CallBack()
    end
    self:RefreshRedPointRecordRecharge()
end
function RecordRechargeModel:CheckActivityState()
    for i = 1, #self.SelfData do
        if self.SelfData[i].State ~= 1 then
            return false
        end
    end
    return true
end
function RecordRechargeModel:GetAward(parms, call)
    require "ActivitySynNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        parms,
        function(msg)
            if call then
                call(msg)
            end
            self:RefreshRedPointRecordRecharge()
        end
    )
end
function RecordRechargeModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eRechargeEvent.TotalCash, self.OnCash, self)
    self.curActivityState = nil
    self.SelfData = nil
end

return RecordRechargeModel
