local ActivitySynNet = require "ActivitySynNet"
local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
---@class TempleSynTypemManager : Singleton
local TempleSynTypemManager = _G.BaseClass("TempleSynTypemManager", base)
local GameOpenView = {
    "eventcureview",
    "TakeOutGameView",
    "RedPaperView"
}
local GameOpenType = {
    EventCureView = 1,
    TakeOutGameView = 2,
    RedPaperView = 3
}
TempleSynTypemManager.OpenView = GameOpenView
TempleSynTypemManager.OpenType = GameOpenType
function TempleSynTypemManager:__init()
    self.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.curActivityState = false
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    self.ActivityId = self.curActivityClass:GetActivityID()
    self.MIndex = 0
    self.MyRankData = nil
    self.Mscore = 0
    self.OpenType = nil
    self.GameId = 0
end
---@param msg s2c_activity_recruiting_info
function TempleSynTypemManager:OnActivityStateChanged(state)
    self:RefreshRedPointTemple()
    if state ~= ActivitySynManager.State.Open then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TempleView.Name)
        if view then
            view:CloseView()
        end
    end
end

---@param msg s2c_activity_recruiting_info
function TempleSynTypemManager:OnHandleGMData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

function TempleSynTypemManager:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(self.ActivityId, _G.handler(self, self.UpdateInitData))
end

function TempleSynTypemManager:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end

---初始化功能逻辑
function TempleSynTypemManager:InitFunction()
    if not self.curActivityState then
        return
    end
end
function TempleSynTypemManager:GetActivityCommonData()
    return self.curActivityClass
end

function TempleSynTypemManager:GetCurActivitySelfData()
    return self.SelfData
end

-- ---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function TempleSynTypemManager:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckTempleRedPoint}
    self.redpointTree = {{2}, false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function TempleSynTypemManager:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新奖励红点
function TempleSynTypemManager:RefreshRedPointTemple()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function TempleSynTypemManager:CheckTempleRedPoint()
    ---只要有一个积分奖励没达到领取条件 每天上线就通知一次红点
    local dayLimit =
        _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "TempleGame" .. self.ActivityId)
    local sixClockTime = _G.TimeUtil.GetSixClockTimer()
    local now = _G.TimeUtil.GetServerUnixTime() + sixClockTime - 86400
    if self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open then
        return 0
    end
    if now - dayLimit >= 86400 and self:CheckAllBox() then
        return 1
    end
    local result = self:CheckAllAward()
    if result then
        return 1
    end
    if self.Mscore and self.Mscore == 0 then
        return 1
    end
    return 0
end

function TempleSynTypemManager:OnEnterActivity()
    if self.curActivityClass:CheckActivityInteractable() then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TempleView.Name, self:GetActivityCommonData())
        if self.onEnterDoneCall then
            self.onEnterDoneCall()
            self.onEnterDoneCall = nil
        end
    end
end
---当日第一次上线 所有积分奖励是否全部完成 1
function TempleSynTypemManager:CheckAllBox()
    if not _G.table.isEmptyOrNil(self.SelfData.ScoreInfo) then
        for k, v in pairs(self.SelfData.ScoreInfo) do
            if v.State ~= 1 then
                return true
            end
        end
        return false
    else
        return false
    end
end
---是否有可领取的奖励 2
function TempleSynTypemManager:CheckAllAward()
    if not _G.table.isEmptyOrNil(self.SelfData.ScoreInfo) then
        for k, v in pairs(self.SelfData.ScoreInfo) do
            if v.State == 2 then
                return true
            end
        end
        return false
    else
        return false
    end
end

function TempleSynTypemManager:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.TempleView.Name
end

function TempleSynTypemManager:GetProgress()
    local _progress = 0.25
    local index = 0
    for k, v in pairs(self.SelfData.ScoreInfo) do
        if v.State > 0 then
            index = index + 1
        end
    end
    return index > 0 and (index + 1) * _progress or 0
end

---处理活动私有信息
---@type i_activity_exchange
function TempleSynTypemManager:SetSelfData(info)
    self.SelfData = {}
    ---@type min_game_cfg
    self.GameId = _G.ConfigManager.min_game_cfg[1].game_params[1]
    local _data
    self.curActivityState = true
    self.Mscore = info.miaohui.score
    self.OpenType = info.miaohui.type
    local v
    local ScoreInfo = {}
    for i = 1, #info.miaohui.sa do
        v = info.miaohui.sa[i]
        _data = {}
        _data.index = i
        _data.target = v.con
        _data.award = v.award
        _data.State = self.Mscore >= v.con and 2 or 0
        if not _G.table.isEmptyOrNil(info.miaohui.index) then
            for _, a in pairs(info.miaohui.index) do
                if a == i then
                    _data.State = 1
                end
            end
        end
        _G.table.insert(ScoreInfo, _data)
    end
    _G.SortList(
        ScoreInfo,
        function(a)
            return a.index
        end
    )
    self.SelfData.ScoreInfo = ScoreInfo
    local rankData = {}
    for k, v in pairs(info.miaohui.ra) do
        _data = {}
        _data.min_rank = v.min_r
        _data.max_rank = v.max_r
        _data.rewards = v.award
        _G.table.insert(rankData, _data)
    end
    _G.SortList(
        rankData,
        function(a)
            return -a.min_rank
        end
    )
    self.SelfData.RankInfo = rankData
    --self:SubmitScore(20000)
    if self.CallBack ~= nil then
        self.CallBack()
    end
end
function TempleSynTypemManager:SubmitScore(score, callback)
    local Score = _G.ConfigManager.discrete_cfg[105605][self.OpenType]
    if score > Score[2] then
        score = Score[2]
    end
    if self.curActivityClass:GetCurActivityState() == ActivitySynManager.State.Open then
        if score > self.Mscore then
            require "TempleNet":GetInstance():SubmitScore(
                score,
                self.ActivityId,
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    self.Mscore = score
                    self:ChangeBoxState()
                    if callback then
                        callback()
                    end
                end
            )
        end
    end
end

function TempleSynTypemManager:ChangeBoxState()
    if self.SelfData and self.SelfData.ScoreInfo then
        for k, v in pairs(self.SelfData.ScoreInfo) do
            if self.Mscore >= v.target and v.State == 0 then
                v.State = 2
            end
        end
    end
end

function TempleSynTypemManager:GetTempleRankInfo(call)
    require "TempleNet":GetInstance():AccessRankBanDan(
        {page = 1, id = self.ActivityId},
        _G.handlerbind(self, self.RecallBackRankPlayers, call)
    )
end
function TempleSynTypemManager:RecallBackRankPlayers(data, call)
    if not self.rank_all_palers then
        self.rank_all_palers = {}
    end
    ---检测 当前玩家有没有上榜
    if not self.MyRankData then
        self.MyRankData = {}
    end
    self.MyRankData.mingci = 0
    self.MyRankData.name = _G.PlayerModel:GetInstance():GetName()
    self.MyRankData.style = _G.PlayerModel:GetInstance():GetRoleStyle()
    self.MyRankData.frame = _G.PlayerModel:GetInstance():GetCurFrame()
    self.MyRankData.isMy = true
    self.MyRankData.value = self.Mscore or 0
    self.MyRankData.uid = self.uid
    if not _G.table.isEmptyOrNil(data.ranker) then
        for i = 1, #data.ranker do
            self.rank_all_palers[i] = {}
            self.rank_all_palers[i].isMy = false
            self.rank_all_palers[i].name = data.ranker[i].name
            self.rank_all_palers[i].style = data.ranker[i].portrait
            self.rank_all_palers[i].value = data.ranker[i].value
            self.rank_all_palers[i].frame = data.ranker[i].frame
            self.rank_all_palers[i].uid = data.ranker[i].uid
            if self.uid == data.ranker[i].uid then
                self.rank_all_palers[i].name = _G.PlayerModel:GetInstance():GetName()
                self.rank_all_palers[i].style = _G.PlayerModel:GetInstance():GetRoleStyle()
                self.rank_all_palers[i].frame = _G.PlayerModel:GetInstance():GetCurFrame()
                self.MIndex = i
                self.rank_all_palers[i].isMy = true
                self.MyRankData = self.rank_all_palers[i]
                self.MyRankData.mingci = i
            end
        end
    end
    call()
end

function TempleSynTypemManager:SetNewRankData(score, call)
    local Score = _G.ConfigManager.discrete_cfg[105605][self.OpenType]
    score = Score[2] > score and score or Score[2]
    if self.MIndex > 0 then
        _G.table.remove(self.rank_all_palers, self.MIndex)
    end
    local data = {}
    self.MIndex = 0
    data.isMy = true
    data.name = _G.PlayerModel:GetInstance():GetName()
    data.style = _G.PlayerModel:GetInstance():GetRoleStyle()
    data.value = score
    data.frame = _G.PlayerModel:GetInstance():GetCurFrame()
    data.uid = self.uid
    if _G.table.isEmptyOrNil(self.rank_all_palers) then
        self.rank_all_palers = {}
        self.MIndex = 1
        _G.table.insert(self.rank_all_palers, data)
    else
        for k, v in pairs(self.rank_all_palers) do
            if score > v.value then
                self.MIndex = k
                break
            end
        end
        if self.MIndex == 0 then
            _G.table.insert(self.rank_all_palers, data)
            self.MIndex = #self.rank_all_palers
        else
            _G.table.insert(self.rank_all_palers, self.MIndex, data)
        end
    end
    if _G.table.isEmptyOrNil(self.MyRankData) then
        self.MyRankData = {}
        self.MyRankData.name = _G.PlayerModel:GetInstance():GetName()
        self.MyRankData.style = _G.PlayerModel:GetInstance():GetRoleStyle()
        self.MyRankData.frame = _G.PlayerModel:GetInstance():GetCurFrame()
        self.MyRankData.isMy = true
        self.MyRankData.value = score
        self.MyRankData.mingci = self.MIndex
        self.MyRankData.uid = _G.PlayerModel:GetInstance():GetPlayerUid()()
    else
        self.MyRankData.mingci = self.MIndex
        self.MyRankData.value = score
    end
    if call then
        call()
    end
end
function TempleSynTypemManager:GetCurListIndex()
    return self.MIndex
end
function TempleSynTypemManager:GetAward(parms, call)
    local param = {parms[2]}
    local index = parms[1]
    ActivitySynNet:GetInstance():GetAward(
        self.ActivityId,
        param,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.SelfData.ScoreInfo[index].State = 1
            if call then
                call()
            end
            self:RefreshRedPointTemple()
        end
    )
end
function TempleSynTypemManager:Dispose()
    self.curActivityState = nil
    self.OpenType = nil
    self.SelfData = nil
    self.ActivityId = nil
    self.MIndex = nil
    self.MyRankData = nil
    self.Mscore = nil
    self.OpenType = nil
    self.GameId = nil
end

return TempleSynTypemManager
