local base = require "ActivitySynTypeBase"
---@class LimitTimeDropSynModel : ActivitySynTypeBase	TAPTAP界面跳转
local LimitTimeDropSynModel = _G.BaseClass("LimitTimeDropSynModel", base)

---创建对象时,入口构造函数
function LimitTimeDropSynModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    --_G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.RefreshCoin, self)
end

---获取服务器数据
function LimitTimeDropSynModel:GetDataFormServer()
    base.ParseData(self)
end

function LimitTimeDropSynModel:OnHandleGMData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

function LimitTimeDropSynModel:SetSelfData(info)
    self.info = info.afk_limited_drop
    for k, v in pairs(info.afk_limited_drop.coin or {}) do 
        self:SetCoin({key = v.k, value = v.v})
    end
    self:RefreshRedPoint()
end

function LimitTimeDropSynModel:SetCoin(data)
    require("LimitTimeDropCoinModel"):GetInstance():SetCoin(self.ActivityId, data)
end

function LimitTimeDropSynModel:GetCoin(sid)
    return require("LimitTimeDropCoinModel"):GetInstance():GetCoin(self.ActivityId, sid)
end

function LimitTimeDropSynModel:CheckOpenCondition()
    if self.info.open_sid and not require("AfkModel"):GetInstance():CheckSectionIsPass(self.info.open_sid) then 
        return false 
    end
    return true
end

function LimitTimeDropSynModel:OnEnterActivity()
    local subType = self.curActivityClass:GetJumpType()
    LogError(subType)
    if subType >= 100201 and subType <= 100205 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTLimitTimeDropView.Name, self.curActivityClass)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitTimeDropView.Name, self.curActivityClass)
    end
end

function LimitTimeDropSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.LimitTimeDropView.Name
end

---初始化红点树
function LimitTimeDropSynModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
    require("RedPointManager"):GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.NoviceGiftPack.id, self:GetRedpointIDByIndex(1))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function LimitTimeDropSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function LimitTimeDropSynModel:CheckRedPoint()
    local _, time1 = self.curActivityClass:GetActivityDeadLineByCondition(require "ActivitySynManager".State.Close)
    if time1 > 0 then 
        local act = require "ActivitySynManager":GetInstance():GetChildAcitivity(10005,10052)
        if not act then 
            return 0
        end
        local _, time2 = act:GetActivityDeadLineByCondition(require "ActivitySynManager".State.Close)
        if time2 > 0 then 
            local num = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
            for k, v in ipairs(act.typeClass.SelfData) do 
                if v.State == 1 and v.GetItem[1].num <= num then 
                    return 1
                end
            end
        end
    end
    return 0
end

function LimitTimeDropSynModel:RefreshCoin(data)
    for _, v in pairs(data) do
        if v.type[1] == 125 then
            self:RefreshRedPoint()
        end
    end
end

---刷新奖励红点
function LimitTimeDropSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function LimitTimeDropSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.RefreshCoin, self)
    self.super.Dispose(self)
end

return LimitTimeDropSynModel
