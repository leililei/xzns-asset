---@class FirstFundView : UIBaseView	中文描述
---@field public go_table FirstFundView_GoTable GoTable
local FirstFundView = _G.BaseClass("FirstFundView", _G.UIBaseView)
--_G.FirstFundView = FirstFundView
local GetLangPackValue = _G.GetLangPackValue
function FirstFundView:Awake()
    self.UiDic = {
        --登录第%s天
        dldxt = 90025200009,
        --活动结束倒计时：<color=#5BDF99>%s</color>
        hddjs = 90026100001,
        name = GetLangPackValue(90025700023)
    }

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.obj_item:SetActiveE(0)

    --按钮点击对应的方法
    self.clickFunction = {
        [self.go_table.aorbtn_btn:GetName()] = self.ShowBuyTips,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---@class params_FirstFundView Data

---界面的入口函数
---@param  Data params_FirstFundView
function FirstFundView:OnCreate(activity)
    self.go_table.scrollloophorizontal_items:InitItemData(0, _G.handler(self, self.RefreshList))
    self:InitView(activity)
end
function FirstFundView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
end
function FirstFundView:OnEnable()
    self:ScrollToIndex()
end
function FirstFundView:InitView(activity)
    self.curActivityId = activity:GetActivityID()
    self.activity = activity
    self.typeClass = activity.typeClass
    self.id = self.typeClass.sid
    if self.typeClass:CheckIsGMActivity() then
        self.StoreContentCfg = self.typeClass.StoreContentCfg
        self.cfg = self.typeClass.cfg
    else
        self.StoreContentCfg = _G.ConfigManager.store_battle_content_cfg
        ---@type store_battle_pass_cfg
        self.cfg = _G.ConfigManager.store_battle_pass_cfg[self.id]
    end
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function()
        self:BuyUp()
    end
    Params_FundBuyTips.contentIds = self.cfg.content
    Params_FundBuyTips.goods = self.cfg.goods
    Params_FundBuyTips.price = self.cfg.price
    Params_FundBuyTips.name = self.UiDic.name
    Params_FundBuyTips.cfg = self.StoreContentCfg
    Params_FundBuyTips.id = self.id
    if not self.Lua_buyTips then
        self.Lua_buyTips = require("FundBuyTips").New(self.go_table.obj_FundBuyTips, self, Params_FundBuyTips)
    else
        self.Lua_buyTips:Parse(Params_FundBuyTips)
    end
    ---@type store_battle_content_cfg[]
    self.countCfgArr = {}
    local content = self.cfg.content
    ---@type store_battle_content_cfg
    local cfgItem
    local id
    for i = 1, #content do
        id = content[i]
        if id == nil or id == 0 then
            if _G.AppSetting.DEBUG then
                _G.LogError(" 配置id 无效  store_battle_content_cfg.content id:" .. tostring(id))
            end
            cfgItem = nil
        else
            cfgItem = self.StoreContentCfg[content[i]]
        end
        if cfgItem then
            table.insert(self.countCfgArr, cfgItem)
        end
    end

    local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(self.cfg.price)
    if info then
        self.go_table.aortext_rmb.text = info.formattedPrice
    else
        local curPrice = _G.GameUtil.RatioControl(self.cfg.price)
        if _G.AppSetting.IsOverseas then
            self.go_table.aortext_rmb.text = GetLangPackValue(90000010807) .. GetLangPackValue(90025500017, curPrice)
        else
            self.go_table.aortext_rmb.text = GetLangPackValue(90025500017, GetLangPackValue(90000010819, curPrice))
        end
    end

    ---true 已购买豪华
    self.isUp = self.typeClass:GetIsUp()
    local _, countdown = self.typeClass:GetTimeCountDown()
    ---可领取的index 方便跳转
    self.Params_GetIndex = self.typeClass:GetHaveGetIndex()
    if self.Params_GetIndex and self.Params_GetIndex >= 7 then
        self.Params_GetIndex = self.Params_GetIndex - 3
    else
        self.Params_GetIndex = 0
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_btn, self.isUp == false)
    if countdown > 86400 then
        countdown = math.ceil(countdown / 86400)
    elseif countdown > 0 then
        countdown = 1
    else
        countdown = 0
    end
    if countdown == 0 then
        self.go_table.aortext_tips.text = GetLangPackValue(90000010290)
    else
        self.go_table.aortext_tips.text = GetLangPackValue(self.UiDic.hddjs, (GetLangPackValue(90022010703, countdown)))
    end
    if self.Co then
        _G.coroutine.stopwaiting(self.Co)
        self.Co = nil
    end
    ---防止item同步产生 导致特效层级被减两次
    self.Co =
        _G.DelayFrameDo(
        function()
            if not self.count then
                self.go_table.scrollloophorizontal_items:UpdateCount(
                    #self.countCfgArr,
                    _G.handler(self, self.RefreshList)
                )
                self.count = #self.countCfgArr
            else
                if self.count ~= #self.countCfgArr then
                    self.go_table.scrollloophorizontal_items:UpdateCount(
                        #self.countCfgArr,
                        _G.handler(self, self.RefreshList)
                    )
                    self.count = #self.countCfgArr
                else
                    self.go_table.scrollloophorizontal_items:UpdateAllItem()
                end
            end

            self:ScrollToIndex()
        end
    )
end

function FirstFundView:ScrollToIndex()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.UpdateDesc,
        self,
        true,
        true
    )
    self.timer:Start()
end
function FirstFundView:UpdateDesc()
    self.go_table.scrollloophorizontal_items:ScrollToIndex(self.Params_GetIndex)
end

function FirstFundView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.countCfgArr[index + 1]

    local itemGoTable = _G.GetAutoGoTable(objGame)

    if itemGoTable.addClick == nil then
        itemGoTable.aorbtn_get1.onClick:AddListener(_G.handlerbind(self, self.OnClick_item, itemGoTable, false))
        itemGoTable.aorbtn_get2.onClick:AddListener(_G.handlerbind(self, self.OnClick_item, itemGoTable, true))
        itemGoTable.addClick = true
    end

    itemGoTable.data = data
    itemGoTable.ispass = _G.GlobalConditionManager.CheckCondition(data.conditions[1], data.conditions[2])
    itemGoTable.isGet1 = self.typeClass:IsAward(data.id, false)
    itemGoTable.isGet2 = self.typeClass:IsAward(data.id, true)

    ---设置可领取
    local isGet1 = false
    local isGet2 = false

    if itemGoTable.ispass then
        isGet1 = itemGoTable.isGet1 == false
        isGet2 = itemGoTable.isGet2 == false and self.isUp == true
    end

    local rewards = data.rewards_normal
    _G.StorageManager:GetInstance():GetItem(
        itemGoTable.obj_item1,
        rewards[1][1],
        rewards[1][2],
        _G.handlerbind(self, self.itemCall, itemGoTable, false)
    )
    rewards = data.rewards_pay
    _G.StorageManager:GetInstance():GetItem(
        itemGoTable.obj_item2,
        rewards[1][1],
        rewards[1][2],
        _G.handlerbind(self, self.itemCall, itemGoTable, true),
        _G.handlerbind(self, self.ShowBuyTips, itemGoTable)
    )

    _G.GameUtil.SetActiveByCondition(itemGoTable.aorbtn_get1, isGet1)
    _G.GameUtil.SetActiveByCondition(itemGoTable.aorbtn_get2, isGet2)

    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou1, itemGoTable.isGet1 == true)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_gou2, itemGoTable.isGet2 == true)
    _G.GameUtil.SetActiveByCondition(itemGoTable.obj_suo2, itemGoTable.isGet2 == false and isGet2 == false)
    local str = GetLangPackValue(self.UiDic.dldxt, data.conditions[2])
    itemGoTable.aortext_1.text = str
    itemGoTable.aortext_2.text = str

    ---true可领取豪华奖励 显示可领取标志 不显示领取章节
    local isShowGetTips = (itemGoTable.ispass and itemGoTable.isGet2 == false)
    itemGoTable.aorimage_geticon.SpriteName = isShowGetTips and "UI_czjj_bt_02" or "UI_czjj_title_01"
    itemGoTable.aorimage_geticon:SetNativeSize()
    _G.GameUtil.SetActiveByCondition(itemGoTable.aortext_2, isShowGetTips == false)

    return objGame
end

---@param isUp boolean true是豪华奖励
function FirstFundView:itemCall(itemLua, storageType, itemGoTable, isUp)
    if storageType == _G.StorageType.Material or storageType == _G.StorageType.ResProp then
        ---@type ItemViewBase
        local lua = itemLua
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

        local isShowEffect = false
        if itemGoTable.ispass then
            if isUp then
                if ----，麻烦加个判断，就是下面的奖励目标达到后也加上特效，不管是否解锁豪华基金
                    -- self.isUp and
                    itemGoTable.isGet2 == false then
                    isShowEffect = true
                end
            else
                if itemGoTable.isGet1 == false then
                    isShowEffect = true
                end
            end
        end
        if isShowEffect then
            lua:ShowEffect()
        else
            lua:ShowOrHideEffect(false)
        end
    end
end

function FirstFundView:OnClick_item(itemGoTable, isUp)
    local open = self.typeClass:CheckActivityInteractable()
    if not open then
        return
    end
    local type = isUp == true and 1 or 0
    local aid = itemGoTable.data.id
    self.typeClass:GetAward(
        type,
        aid,
        function(activity)
            self:InitView(activity)
        end
    )
end

function FirstFundView:ShowBuyTips(itemlua, btnObj, isOn, itemGoTable)
    if itemGoTable == nil or itemGoTable.ispass and itemGoTable.isGet2 == false and self.isUp == false then
        self.Lua_buyTips:Show()
    else
        require("CommonTipManager"):GetInstance():OpenPropTip(itemlua.gameObject, itemlua.sid)
    end
end

function FirstFundView:BuyUp()
    local id = self.id
    self.typeClass:BuyUp(
        id
        -- ,
        -- function(activity)
        --     self:InitView(activity)
        -- end
    )
end

function FirstFundView:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_battle_pass_cfg[data.sid]
    if cfg and cfg.display_priority == 3 then
        self:InitView(self.typeClass.curActivityClass)
    end
end

function FirstFundView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function FirstFundView:OnClickBtn(go, isOn)
    local open = self.typeClass:CheckActivityInteractable()
    if not open then
        return
    end
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return FirstFundView
