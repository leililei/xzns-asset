---@class TapTapJumpView : UIBaseView	中文描述
---@field public go_table TapTapJumpView_GoTable GoTable
local TapTapJumpView = _G.BaseClass("TapTapJumpView", _G.UIBaseView)

function TapTapJumpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TapTapJumpView:OnCreate()
    self.award = _G.ConfigManager.discrete_cfg[105409]
    for i = 1, 7 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            self.award[i],
            tb.obj_root,
            function(item)
                if _G.IsNil(tb.obj_root) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                    item:ShowEffect(true)
                end
            end
        )
    end
end

function TapTapJumpView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function TapTapJumpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_enter then
        _G.CS.UnityEngine.Application.OpenURL(_G.GetLangPackValue(90000011397))
    end
end

return TapTapJumpView