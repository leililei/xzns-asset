function ActiveTaskToggleView:OnCreate(activity,toggleTab,jumptype)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.GetJumpType =
    require "ActivitySynManager":GetInstance():GetChildAcitivity(
            self.activityCls:GetJumpModelType(),
            self.activity:GetJumpType()
    )
    self.toggleTab=toggleTab
    self:InitView(jumptype)
end
function ActiveTaskToggleView:InitView(jumptype)
    for k,v in pairs(self.toggleTab) do
        local toggleItem=_G.InstantiateObject(self.go_table.toggle_Item,self.go_table.obj_Toggles)
        v.toggle=_G.GetAutoGoTable(
                toggleItem,
                _G.handlerbind(self, self.OnClickToggle, v.tasktype, _G.handler(self, self.SelectToggle)))
        if v.toggletxt then
            v.toggle.aortext_off.text=v.toggletxt
            v.toggle.aortext_on.text=v.toggletxt
        end
        require("RedPointManager"):GetInstance():RefreshNode(self.activityCls:GetRedpointIDByIndex(_G.eActiveTaskPanelRed[v.tasktype]))
        v.toggle.obj_redpoint:UpdateRedPointItemIDAndParam(self.activityCls:GetRedpointIDByIndex(_G.eActiveTaskPanelRed[v.tasktype]))
        v.toggle.isOn=false
        v.toggle.gameObject:SetActiveE(1)

    end
    for k,v in pairs(self.toggleTab) do
        if jumptype and  v.tasktype==jumptype then
            v.toggle.toggle_Item.isOn=false
            v.toggle.toggle_Item.isOn=true
            break
        elseif(not jumptype and not self.ShowType) then
            v.toggle.toggle_Item.isOn=false
            v.toggle.toggle_Item.isOn=true
            break
        end
    end
    self.go_table.obj_Toggles:SetActiveE(table.count(self.toggleTab)>1 and 1 or 0)
end
function ActiveTaskToggleView:OnClickToggle(_, isOn, key)
    local tb = table.find(self.toggleTab,function(a) return a.tasktype==key  end)
    tb.toggle.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.toggle.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if tb.panel then
         local panel=tb.panel
        panel.gameObject:SetActiveE(isOn and 1 or 0)
        self.ShowType=key
    end
    if isOn  then
        if tb.panel then

        else
            _G.PoolsManager:GetInstance():Spawn(
                    tb.PanelPrefarb,
                    _G.ePoolType.UIItem,
                    self.go_table.obj_panel,
                    function(trans)
                        if not trans or trans:GetctiveInHierarchy() ~= 1 then
                            _G.DestroyObject(trans)
                            return
                        end
                        tb.panel= self:AddComponent(trans, require(tb.PanelView).New(trans,self,tb.tasktype,tb.title,tb.taskDes))
                    end
            )
        end
    end
end
