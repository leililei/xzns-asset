    --    _G.FreeGiftID.ContinueRecharge,
    --    self.go_table.obj_freeGift,
    --    activity:GetActivityID()
    --)
end
function ContinueRecharge:OnDestroy()
    self.CommonInfo = nil
    self.Info = nil
    --self.Data = nil
    self.Time = nil
end
function ContinueRecharge:InitTime()
    local GetLangPackValue = _G.LangUtil.GetLangPackValue
    local startTime, _ = self.Activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local endTime, countdown = self.Activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.EndTime = _G.TimeUtil.GetDateTime(endTime)
    local str =
        GetLangPackValue(90023800032) .. "<color=#96ce51>" ..
        GetLangPackValue(90000010300, self.StartTime.month, self.StartTime.day, self.StartTime.hour) .. "~" ..
        GetLangPackValue(90000010300, self.EndTime.month, self.EndTime.day, self.EndTime.hour) .. "</color>"
    self.go_table.aortext_activeTime.text = str
end
function ContinueRecharge:InitView(activity)
    self.Activity = activity
    self.TypeCls = activity:GetActivityTypeCls()
    self.go_table.aortext_activeDesc.text = activity.cfg.info.description
    self.continuedDay = 0
    self:Sortfunc()
    self:InitTime()
    if not self.count then
        self.go_table.scrollloopvectical_ShowItem:InitItemData(
            #self.TypeCls:GetCurActivitySelfData(),
            _G.handler(self, self.RefreshItem)
        )
        self.count = #self.TypeCls:GetCurActivitySelfData()
    else
        if self.count ~= #self.TypeCls:GetCurActivitySelfData() then
            self.go_table.scrollloopvectical_ShowItem:UpdateCount(#self.TypeCls:GetCurActivitySelfData())
            self.count = #self.TypeCls:GetCurActivitySelfData()
        else
            self.go_table.scrollloopvectical_ShowItem:UpdateAllItem()
        end
    end
end

function ContinueRecharge:Sortfunc()
    local data = self.TypeCls:GetCurActivitySelfData()
    if not _G.table.isEmptyOrNil(data) then
        _G.SortList(
                data,
                function(a)
                    local IsEnd = 0
                    if a.State == 2 then
                        IsEnd = 2
                    elseif a.State == 0 then
                        IsEnd = 1
                    elseif a.State == 1 then
                        IsEnd = 0
                    end
                    return IsEnd, -a.Sid
                end
        )
    end
end

function ContinueRecharge:RefreshItem(index, obj)
    local x = index + 1
    local data = self.TypeCls:GetCurActivitySelfData()
    local tb = _G.GetAutoGoTable(obj)
    if data[x] then
        tb.data = data[x]
        tb.curDay = x
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        self:CreateItem(tb)
    end
end
function ContinueRecharge:ClickItemBtn(go, isOn, tb)
    if not self.Activity:CheckActivityInteractable() then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_Get" then
        self.TypeCls:GetAward(
            {tb.data.Sid},
            function(data)
                if data.ack == 1 then
                    tb.data.State = 1
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    require "CommonTipManager".OpenCommonAwardView(data)
                    self:CreateItem(tb)
                    self:InitView(self.Activity)
                end
            end
        )
    elseif name == "@_aorbtn_Go" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.recharge)
        local MallView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MallView.Name)
        self.JumpCo =
            _G.coroutine.start(
            function()
                while (_G.IsNil(MallView.View.gameObject)) do
                    _G.coroutine.waitforendofframe()
                end
                CloseCall()
            end
        )

        if _G.CS.Launcher.Inst.IsSDK then
            local json =
            _G.Table2Json(
                    {
                        role_uid = _G.PlayerModel:GetInstance().role_uid,
                        role_level = _G.PlayerModel:GetInstance():GetLevel(),
                        role_vip = _G.PlayerModel:GetInstance().vipLv,
                        server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                        channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                        phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                        user_type = 1,
                        record_time = _G.TimeUtil.GetServerUnixTime(),
                        parent_interface = "ContinueRecharge"
                    }
            )
            if _G.AppSetting.DEBUG then
                _G.Log(json, "进入商城界面打点")
            end
            _G.SDKManager:GetInstance():DoShushuData_track("enter_shop_interface", json)
        end

    end
end

function ContinueRecharge:CreateItem(tb)
    local data = tb.data
    local getItem = function(_data, p, isGou)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            _data,
            p,
            function(tran)
                tran.sid = _data[1]
                tran.gameObject:SetLocalPosition(0, 0, 0)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                tran:SetGou(isGou)
                local haveEffect = false
                if not isGou then
                    local Quality = _G.StorageManager:GetInstance():GetItemQuality(tran.sid)
                    if Quality >= 4 then
                        haveEffect = true
                    end
                end
                tran:ShowEffect(haveEffect)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    if data.State == 0 then
        local CashInfo = self.TypeCls:GetCurActivitySelfData().curCashInfo
        local RatioControl = _G.GameUtil.RatioControl
        local cashNum = data.CashNum
        local needCash = CashInfo[2]
        if version == 1 then
            self.go_table.obj_tips:SetActiveE(0)
            cashNum = RatioControl(cashNum)
            needCash = RatioControl(needCash)
            tb.aortext_Desc.text = _G.LangUtil.GetLangPackValue(_G.GameUtil.GetVoucherArg(90023800126, 90036300035), needCash)
            if CashInfo[1] == data.Sid then
                if CashInfo[2] < data.CashNum then
                    tb.aortext_percent.text =
                    "<color=red>" .. needCash .. "</color>" .. "/" .. cashNum
                end
            else
                tb.aortext_percent.text = "<color=red>0</color>" .. "/" .. cashNum
            end
        elseif version == 2 then
            self.go_table.obj_tips:SetActiveE(1)
            tb.aortext_Desc.text = _G.LangUtil.GetLangPackValue(90000010810, cashNum)
            if CashInfo[1] == data.Sid then
                if CashInfo[2] < data.CashNum then
                    tb.aortext_percent.text =
                    "<color=red>" .. needCash .. "</color>" .. "/" .. cashNum
                end
            else
                tb.aortext_percent.text = "<color=red>0</color>" .. "/" .. cashNum
            end
        end
    else
        self.continuedDay = tb.curDay
    end
    --self:SetDayIcon(data.Sid, tb)
    --tb.aorimage_day.SpriteName = string.format(DayIcon, data.Sid)
    tb.aorbtn_Get:SetActiveE(data.State == 2 and 1 or 0)
    tb.aorbtn_Go:SetActiveE(data.State == 2 and 0 or 1)
    tb.aorbtn_Go:SetGray(data.State == 2 and 0 or 1)
    tb.aorimage_isGet:SetActiveE(data.State == 1 and 1 or 0)
    tb.aortext_Desc:SetActiveE(data.State == 0 and 1 or 0)
    tb.aortext_Title.text =
    _G.GetLangPackValue(18900000029) .. "<color=882710>" .. tb.curDay .. "</color>"
            .. _G.GetLangPackValue(90000000122) .. " ( " .. self.continuedDay .. "/" .. tb.curDay .. " )"
    for i = 1, tb.obj_itemRoot:GetChildCountE() do
        tb.obj_itemRoot:GetChildE(i - 1):DestroyObject()
    end
    for k, v in pairs(data.Award) do
        getItem(v.type, tb.obj_itemRoot, data.State == 1)
    end
end

function ContinueRecharge:SetDayIcon(day, tb)
    local days = {}
    local floor = _G.math.floor
    local _day = string.len(tostring(day))
    if day <= 10 then
        _day = 1
    elseif _day == 2 and (day % 10) ~= 0 and floor((day / 10)) > 1 then
        _day = 3
    elseif day < 20 then
        _day = 4
    else
        _day = 2
    end
    local num = day
    local wei
    if _day == 3 then
        _G.table.insert(days, floor(num / 10))
        _G.table.insert(days, 10)
        _G.table.insert(days, floor(num % 10))
    elseif _day == 2 then
        _G.table.insert(days, floor(num / 10))
        _G.table.insert(days, 10)
    elseif _day == 4 then
        _G.table.insert(days, 10)
        _G.table.insert(days, floor(num % 10))
    else
        _G.table.insert(days, num)
    end
    if not _G.table.isEmptyOrNil(days) then
        for i = 1, 3 do
            tb["aorimage_day" .. i]:SetActiveE(days[i] and 1 or 0)
            if days[i] then
                tb["aorimage_di" .. i]:SetActiveE(i == 1 and 1 or 0)
                tb["aorimage_tian" .. i]:SetActiveE(i == #days and 1 or 0)
                tb["aorimage_day" .. i].SpriteName = string.format(DayIcon, days[i])
                tb["aorimage_day" .. i]:SetNativeSize()
            end
        end
    end
end
function ContinueRecharge:CloseView()
    self:Close()
end
function ContinueRecharge:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    else
        name = "nilFnc"
    end
    if go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 96)
    end
end

function ContinueRecharge:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.prf_meizi, self.go_table.trans_spine, check)
end
return ContinueRecharge
