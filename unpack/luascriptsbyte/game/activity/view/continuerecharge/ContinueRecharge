local ContinueRecharge = _G.BaseClass("ContinueRecharge", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"
local CS = _G.CS
local typeof = _G.typeof
local tipId = {
    noItem = 650103,
    limitCount = 650102
}
local DayIcon = "ui_lxcz_txt_%d"
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
function ContinueRecharge:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.CloseView
        }
    }
end
local CloseCall = function()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
    if view then
        view:Close()
    end
end
