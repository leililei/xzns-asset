---@field public go_table ActivityView_GoTable GoTable
local ActivityView = _G.BaseClass("ActivityView", _G.UIBaseView)
function ActivityView:Awake()
    _G.Events:GetInstance():AddListener(BroadcastEnum.ItemUiOpened, self.OnUIOpen, self)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
---@param data activityPagesInfoTab
---@param isSingle boolean 是否只显示当前活动
function ActivityView:OnCreate(data, index, jumpActivityId, isSingle)
    self.ActivityList = {}
    self.JumpActivityId = jumpActivityId or 0
    self.isSingle = self.JumpActivityId > 0 and isSingle == true
    self.Index = index or 1
    self:ParseData(data)
end
function ActivityView:ParseData(data)
    self.UIList = {}
    self.ActivityData = {}
    if data then
        local _, _, index = 0
        ---解析活动框架数据
        for i = 1, #data do
            local _data = {}
            local v = data[i]
            ---type ==1 活动
            _data.ActivityID = v.activityID
            _data.Cls = v
            _data.Icon, _data.Name = v:GetShowBtnInfo()
            _, _, index = v:GetShowBtnType()
            ---序号
            _data.Index = index
            ---活动位置索引
            _data.index = index
            _data.ViewName = v:GetGameMainViewName()
            -- _data.view = nil
            _data.State = v.curState
            _data.TypeCls = v:GetActivityTypeCls()
            -- 特训特殊进入 在额外条件未通过时 不能进入特训子界面
            _data.Type = _data.TypeCls.isTrain and 2 or 1
            --暂时屏蔽魂将诏令ZHJ-19372
            if _data.ViewName == "TheSoulWillDecreeView" then
            else
                if self.isSingle then
                    if _data.ActivityID == self.JumpActivityId then
                        _G.table.insert(self.ActivityData, _data)
                    end
                else
                    _G.table.insert(self.ActivityData, _data)
                end
            end
        end
    end
    if #self.ActivityData == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError(_G.string.format("activity %s is not exist", self.JumpActivityId))
        end
        self:Close()
        return
    end
    _G.SortList(
        self.ActivityData,
        function(a)
            return -a.Index, a.ActivityID
        end
    )
    for i = 1, #self.ActivityData do
        self.ActivityData[i].index = i
    end
    self:InitActivityItem()
end
function ActivityView:OnUIOpen(view)
    -- local canvas = view.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    -- canvas.sortingOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1

    _G.UIManager:GetInstance():ChangeCanvasOrder(
        view.viewName,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
    )
    view.transform:SetParentE(self.go_table.obj_view)
    view.transform:SetAsLastSiblingE()
    ---初始化窗口，涉及特效，需要activity设置完根节点OrderInLayer后再执行，否则特效层级概率计算错误
    if view.OnInitView then
        view:OnInitView()
    end
end

function ActivityView:InitActivityItem()
    if _G.table.isEmptyOrNil(self.ActivityData) then
        return
    end
    for k, v in pairs(self.ActivityData) do
        local obj = _G.InstantiateObject(self.go_table.obj_ActivityTab, self.go_table.obj_Content)
        local activityItem = self:GetComponent(obj, ActivityItem)
        if activityItem == nil then
            activityItem = self:AddComponent(obj, ActivityItem.New(obj, v))
        end
        _G.table.insert(self.ActivityList, activityItem)
    end
    local openByIndex = (self.Index ~= nil) or (self.JumpActivityId ~= 0)
    for i = 1, #self.ActivityList do
        if not openByIndex then
            if self.ActivityList[i].State == ActivityState.Open then
                self.ActivityList[i]:DoActivityBtn()
                break
            end
        elseif self.JumpActivityId ~= 0 then
            if self.ActivityList[i].ActivityID == self.JumpActivityId then
                self.ActivityList[i]:DoActivityBtn()
                break
            end
        elseif self.ActivityList[i].index == self.Index then
            self.ActivityList[i]:DoActivityBtn()
            break
        end
    end
    self.go_table.obj_ActivityTab:SetActiveE(0)
end
function ActivityView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Back" then
        self:Close()
    end
end

function ActivityView:EscClose()
    self:Close()
end

function ActivityView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(BroadcastEnum.ItemUiOpened, self.OnUIOpen, self)
    for k, v in pairs(self.ActivityList) do
        v:OnDispose()
    end
    self.ActivityList = nil
    self.ActivityData = nil
    self.Index = nil
end

return ActivityView
