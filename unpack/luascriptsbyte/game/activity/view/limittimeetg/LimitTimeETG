---@class LimitTimeETG : UIBaseView 角色评论
---@field public go_table LimitTimeETG_GoTable GoTable
local LimitTimeETG = _G.BaseClass("LimitTimeETG", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"
local CS = _G.CS
local typeof = _G.typeof
local tipId = {
    noItem = 650103,
    limitCount = 650102
}
local GetLangPackValue = _G.LangUtil.GetLangPackValue
function LimitTimeETG:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        ["@_aorbtn_task"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.OpenTaskView
        },
        ["@_aorbtn_gift"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.JumpMallGift
        }
    }
end
local CloseCall = function()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
    if view then
        view:Close()
    end
end
function LimitTimeETG:OnCreate(data)
    self.ItemList = {}
    _G.PlayerPrefsManager.SetInt("LimitTimeSynModelDaily" .. data.typeClass.ActivityID, _G.TimeUtil.GetServerUnixTime())
    self:InitView(data)
end
function LimitTimeETG:InitView(activity)
    self.TypeCls = activity.typeClass
    self.TypeCls:RefreshRedPointLimit(1)
    local resSid = self.TypeCls:GetCoinSid()
    if resSid then
        if self.resource then
            self.resource:RestRs({resSid})
        else
            self.resource =
                self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, {resSid})
            )
        end
    end
    self.ExchangeModel = self.TypeCls:GetModel("exchange")
    self:InitTime()
    self.go_table.aortext_activeDesc.text = self.TypeCls:GetActivityDescription()
    self.go_table.aorbtn_task:SetActiveE(1)
    self.go_table.obj_taskRed:UpdateRedPointItemIDAndParam(self.TypeCls:GetRedpointIDByIndex(2))
    self.go_table.aorbtn_gift:SetActiveE(1)
    self.go_table.obj_giftRed:UpdateRedPointItemIDAndParam(self.TypeCls:GetRedpointIDByIndex(3))
    self:SetView()
end
function LimitTimeETG:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.CommonInfo = nil
    self.Info = nil
    self.count = nil
    self.Time = nil
    self.CountDownTime = nil
end
function LimitTimeETG:OnTimeCall(elapsed)
    if self.CountDownTime > 0 then
        self.CountDownTime = self.CountDownTime - elapsed
        self.go_table.aortext_daojishi.text =
            GetLangPackValue(90022500333) .. ":" .. _G.TimeUtil.TranslateSecondForStrDHMS(Mathf.RoundToInt(self.CountDownTime))
    else
        self.timer:Stop()
    end
end
function LimitTimeETG:InitTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local startTime, _ = self.TypeCls:GetActivityTime(ActivitySynManager.State.Open)
    local endTime, countdown = self.TypeCls:GetActivityTime(ActivitySynManager.State.Close)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.EndTime = _G.TimeUtil.GetDateTime(endTime)
    self.CountDownTime = countdown
    local str =
        GetLangPackValue(90023800032) ..
        GetLangPackValue(90023800033, self.StartTime.month, self.StartTime.day, self.EndTime.month, self.EndTime.day)
    -- self.go_table.aortext_activeTime.text = str
    self.go_table.aortext_daojishi.text =
        GetLangPackValue(90022500333) .. ":" .. _G.TimeUtil.TranslateSecondForStrDHMS(self.CountDownTime)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeCall, self, false, false)
    self.timer:Start()
end
function LimitTimeETG:SetView()
    local count = #self.ExchangeModel.Data
    self:Sortfunc(self.ExchangeModel.Data)
    if not self.count then
        self.go_table.scrollloopvectical_ShowList:InitItemData(count, _G.handler(self, self.RefreshItem))
        self.count = count
    else
        if self.count ~= count then
            self.go_table.scrollloopvectical_ShowList:UpdateCount(count)
            self.count = count
        else
            self.go_table.scrollloopvectical_ShowList:UpdateAllItem()
        end
    end
end
function LimitTimeETG:RefreshItem(index, obj)
    local ide = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local data = self.ExchangeModel.Data
    local tb = _G.GetAutoGoTable(obj)
    if data[x] then
        tb.data = data[x]
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, ide)
        self:CreateItem(tb, ide)
    end
end
function LimitTimeETG:Sortfunc(data)
    if not _G.table.isEmptyOrNil(data) then
        _G.SortList(
            data,
            function(a)
                local NeedItem = a.NeedItem[1]
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(NeedItem.sid)
                local myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, NeedItem.sid)
                local isEnd = a.State == 0 and 0 or 1
                --return isCanTake, NeedItem.num
                return isEnd, NeedItem.num, a.Sid
            end
        )
    end
end
function LimitTimeETG:ClickItemBtn(go, isOn, tb, ide)
    if not self.TypeCls:CheckActivityEnabled() then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_exchange" then
        if tb.exchange then
            _G.PopWindowManager:GetInstance():ShowAllTips(tb.exchange)
            return
        end
        if not self.clickbtn then
            self.clickbtn = true
            local award = tb.data.NeedItem[1]
            self.ExchangeModel:Exchange(
                tb.data,
                award,
                function(data)
                    if data then
                        self:SetView()
                        require "CommonTipManager".OpenCommonAwardView(
                            data,
                            function()
                                self.clickbtn = false
                            end
                        )
                    else
                        self.clickbtn = false
                    end
                end
            )
        end
    elseif name == "@_aorbtn_gou" then
        if tb.data then
            local data = tb.data
            local myCount = 0
            tb.data.isGou = tb.data.isGou > 0 and 0 or 1
            _G.PlayerPrefsManager.SetInt(
                "LimitTimeSynModelExchange" .. self.TypeCls.ActivityID .. tb.data.Sid,
                tb.data.isGou
            )
            _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, tb.data.isGou > 0)
            if data.NeedItem[1].sid == 101 then --活动代币（恶灵入侵）
                myCount = require "MonsterSiegeManager":GetInstance():GetCoinActivity()
            else
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(data.NeedItem[1].sid)
                myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, data.NeedItem[1].sid)
            end
            local IsCanTake = myCount >= data.NeedItem[1].num and data.State == 1
            _G.GameUtil.SetActiveByCondition(tb.obj_getEff, IsCanTake and data.isGou > 0)
        end
        self.TypeCls:RefreshRedPointLimit(1)
    end
end

function LimitTimeETG:CreateItem(tb, ide)
    local data = tb.data
    local item = self.ItemList[ide]
    local getItem = function(_data, p, type, eff)
        if eff ~= nil then
            if item then
                if item.eff then
                    _G.PoolsManager:GetInstance():Despawn(item.eff.gameObject, _G.ePoolType.UIEffect)
                end
                _G.PoolsManager:GetInstance():Despawn(item.gameObject, _G.ePoolType.UIItem)
            end
        else
            for i = 1, p:GetChildCountE() do
                _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
        _G.StorageManager:GetInstance():GetItemBaseView(
            _data.sid,
            _data.num,
            p,
            function(tran)
                tran.sid = _data.sid
                tran.gameObject:SetLocalPosition(0, 0, 0)
                if type then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
                self.ItemList[ide] = tran
                if eff == true then
                    self:LoadEff(tran, _data.sid)
                end
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    local NeedItem = data.NeedItem[1]
    local GetItem = data.GetItem[1]
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(NeedItem.sid)
    local myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, NeedItem.sid)
    local IsCanTake = myCount >= NeedItem.num and data.State == 1
    _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, data.isGou > 0)
    tb.aorbtn_exchange:SetActiveE(data.State == 1 and 1 or 0)
    tb.aorbtn_gray:SetGray(data.State == 0)
    tb.aorbtn_gray:SetActiveE(data.State == 0 and 1 or 0)
    tb.exchange = nil
    _G.GameUtil.SetActiveByCondition(tb.obj_getEff, IsCanTake and data.isGou > 0)
    if myCount >= NeedItem.num then
        --tb.aortext_rootPercent.text = _G.GameUtil.NumberToUnitStrFight(myCount) .. "/" .. NeedItem.num
        tb.aortext_rootPercent.text = NeedItem.num
    else
        tb.exchange = tipId.noItem
        tb.aortext_rootPercent.text =
            --"<color=red>" .. _G.GameUtil.NumberToUnitStrFight(myCount) .. "</color>" .. "/" .. NeedItem.num
        NeedItem.num
    end
    if data.State == 1 then
        if data.ExchangeTime == 0 then
            tb.aortext_percent.text =
                GetLangPackValue(90000000961) ..
                "(" .. "<color=red>" .. data.ExchangeTime .. "</color>" .. "/" .. data.LimitTime .. ")"
        else
            tb.aortext_percent.text =
                GetLangPackValue(90000000961) .. "(" .. data.ExchangeTime .. "/" .. data.LimitTime .. ")"
        end
    else
        tb.exchange = tipId.limitCount
        --tb.aortext_percent.text = data.ExchangeTime .. "/" .. data.LimitTime
        tb.aortext_percentGray.text =
            GetLangPackValue(90000000961) .. "(" .. data.ExchangeTime .. "/" .. data.LimitTime .. ")"
    end
    getItem(NeedItem, tb.obj_itemfrom, false)
    getItem(GetItem, tb.obj_itemto, true, IsCanTake)
end
function LimitTimeETG:LoadEff(tran, Sid)
    local num = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)

    _G.UIUtils.LoadEffectByCfg(
        num,
        tran.gameObject,
        function(trans)
            tran.eff = trans
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    )
end

function LimitTimeETG:CloseView()
    self:Close()
end
function LimitTimeETG:OnClickBtn(go, isOn)
    if not self.TypeCls:CheckActivityEnabled() then
        return
    end
    local name = go:GetName()
    if self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    else
        name = "nilFnc"
    end
end
function LimitTimeETG:OpenTaskView()
    self.TypeCls:EnterLimitView(2)
end
function LimitTimeETG:JumpMallGift()
    self.TypeCls:EnterLimitView(3)
end
return LimitTimeETG
