    noItem = 650103,
    limitCount = 650102
}
local GetLangPackValue = _G.GetLangPackValue
function LimitTimeExchange:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.CloseView
        },
        ["@_aorbtn_go"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.Go
        }
    }
end
local CloseCall = function()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
    if view then
        view:Close()
    end
end
function LimitTimeExchange:Go()
    if not self.Activity:CheckActivityInteractable() then
        return
    end
    local actionIDs = ActivitySynManager:GetInstance():GetAllActivityByType(10004)
    if actionIDs then
        ActivitySynManager:GetInstance():JumpActivity(
            actionIDs[1],
            function()
                local GuessGameView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.GuessGameView.Name)
                self.JumpCo =
                    _G.coroutine.start(
                    function()
                        while (_G.IsNil(GuessGameView.View.gameObject)) do
                            _G.coroutine.waitforendofframe()
                        end
                        CloseCall()
                    end
                )
            end
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
    end
end
function LimitTimeExchange:OnCreate(activity)
    self.ItemList = {}
    self:InitView(activity)
end

function LimitTimeExchange:InitEffect()
end

function LimitTimeExchange:InitView(activity)
    self.Activity = activity
    _G.PlayerPrefsManager.SetInt(
        "LimitTimeExchangeModelDaily" .. activity:GetActivityID(),
        _G.TimeUtil.GetServerUnixTime()
    )
    activity:GetActivityTypeCls():RefreshRedPointExchange()
    self.TypeCls = activity:GetActivityTypeCls()
    local resSid = self.TypeCls:GetCoinSid()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_GoldInfo, self.TypeCls.type_enum == 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_GoldInfoSpecial, self.TypeCls.type_enum == 2)
    if resSid then
        local root
        if self.TypeCls.type_enum == 1 then
            root = self.go_table.obj_GoldInfo
            if self.Goldresource then
                self.Goldresource:RestRs({resSid})
            else
                self.Goldresource = self:AddComponent(root, require("ResourceCompont").New(root, {resSid}))
            end
        elseif self.TypeCls.type_enum == 2 then
            root = self.go_table.obj_GoldInfoSpecial
            if self.SpecialGoldresource then
                self.SpecialGoldresource:RestRs({resSid})
            else
                self.SpecialGoldresource = self:AddComponent(root, require("ResourceCompont").New(root, {resSid}))
            end
        end
    end
    self.go_table.aortext_activeDesc.text = self.Activity.cfg.info.description
    -- if self.TypeCls.type_enum == 1 then --活动代币 不需要显示 前往
    --     self.go_table.aorbtn_go:SetActiveE(1)
    -- else
    --     self.go_table.aorbtn_go:SetActiveE(0)
    -- end
    self.go_table.aorbtn_go:SetActiveE(0)
    self.go_table.aorbtn_task:SetActiveE(0)
    self.go_table.aorbtn_gift:SetActiveE(0)
    self:InitLiHui()
    self:InitTime()
    self:SetView()
    if not _G.string.IsNullOrEmpty(activity.cfg.info.icon) then
        self.go_table.aorrawimage_font:LoadImage(
            "Images/" .. activity.cfg.info.icon,
            function(raw)
                raw:SetNativeSize()
            end
        )
    end
end
function LimitTimeExchange:InitLiHui()
    local path, isImage = self.TypeCls:GetLiHuiPath()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bj, path and isImage)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_spine, path and not isImage)
    if path then
        local pos = self.TypeCls:GetLiHuiPos()
        local scale = self.TypeCls:GetLiHuiScale()
        if isImage then
            self.go_table.aorrawimage_bj:LoadImage(
                path,
                function(image)
                    image:SetNativeSize()
                    image:SetLocalPosition(pos[1], pos[2], pos[3])
                    image:SetLocalScaleXYZ(scale)
                end
            )
        else
            self.go_table.trans_spine:ClearChildren()
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.UIItem,
                self.go_table.trans_spine,
                function(tran)
                    if self:IsNil() then
                        tran:DestroyObject()
                        return
                    end
                    tran:SetLocalPosition(pos[1], pos[2], pos[3])
                    tran:SetLocalScaleXYZ(scale)
                end
            )
        end
    end
end
