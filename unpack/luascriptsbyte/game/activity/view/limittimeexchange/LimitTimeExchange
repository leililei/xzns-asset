function LimitTimeExchange:InitTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local MainActive
    local jumpId = self.Activity.cfg.info.front.sub_type or 0
    local CoinSid = self.Activity.typeClass.CoinSid
    if CoinSid == 109 then ---灵弈对决
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10029, jumpId)
    elseif CoinSid == 104 then ---竞猜
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10004, jumpId)
    elseif CoinSid == 101 then ---恶灵入侵
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10012, jumpId)
    elseif CoinSid == 103 then ---公平竞技场
        MainActive = ActivitySynManager:GetInstance():GetChildAcitivity(10023, jumpId)
    end
    if not MainActive then
        MainActive = self.Activity
    end
    local startTime, _ = self.Activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local settlementTime, _ = MainActive:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    local endTime, countdown = self.Activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.SettlementTime = _G.TimeUtil.GetDateTime(settlementTime)
    self.EndTime = _G.TimeUtil.GetDateTime(endTime)
    local text1 = GetLangPackValue(90000010300,self.StartTime.month,self.StartTime.day,self.StartTime.hour)
    .."-".. GetLangPackValue(90000010300,self.SettlementTime.month,self.SettlementTime.day,self.SettlementTime.hour)
    self.go_table.aortext_activityTime.text = GetLangPackValue(90025800003,text1)
    local text2 = GetLangPackValue(90000010300,self.StartTime.month,self.StartTime.day,self.StartTime.hour)
    .."-".. GetLangPackValue(90000010300,self.EndTime.month,self.EndTime.day,self.EndTime.hour)
    self.go_table.aortext_settlementTime.text = GetLangPackValue(90000010889,text2)
end

function LimitTimeExchange:Sortfunc(data)
    if not _G.table.isEmptyOrNil(data) then
        _G.SortList(
            data,
            function(a)
                --local NeedItem = a.NeedItem[1]
                local IsEnd = a.State == 0 and 0 or 1
                --return isCanTake, a.State,-NeedItem.num
                return IsEnd
            end
        )
    end
end

function LimitTimeExchange:SetView()
    local data = self.TypeCls:GetCurActivitySelfData()
    local count = #data
    self:Sortfunc(data)
    if not self.count then
        self.go_table.scrollloopvectical_ShowList:InitItemData(
            #self.TypeCls:GetCurActivitySelfData(),
            _G.handler(self, self.RefreshItem)
        )
        self.count = count
    else
        if self.count ~= count then
            self.go_table.scrollloopvectical_ShowList:UpdateCount(count)
            self.count = count
        else
            self.go_table.scrollloopvectical_ShowList:UpdateAllItem()
        end
    end
end

function LimitTimeExchange:RefreshItem(index, obj)
    local ide = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local data = self.TypeCls:GetCurActivitySelfData()
    local tb = _G.GetAutoGoTable(obj)
    if data[x] then
        tb.data = data[x]
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, ide)
        self:CreateItem(tb, ide)
    end
end
function LimitTimeExchange:ClickItemBtn(go, isOn, tb, ide)
    if not self.Activity:CheckActivityInteractable() then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_exchange" then
        if tb.exchange then
            _G.PopWindowManager:GetInstance():ShowAllTips(tb.exchange)
            return
        end
        if not self.clickbtn then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.LimitBuyView.Name,
                tb.data,
                function(_data)
                    self:SetView()
                    require "CommonTipManager".OpenCommonAwardView(
                        _data,
                        function()
                            self.clickbtn = false
                        end
                    )
                end,
                self.TypeCls
            )
        end
    elseif name == "@_aorbtn_gou" then
        if tb.data then
            local data = tb.data
            local myCount = 0
            data.isGou = data.isGou > 0 and 0 or 1
            _G.PlayerPrefsManager.SetInt(
                "LimitTimeExchangeModelGou" .. self.Activity:GetActivityID() .. tb.data.Sid,
                tb.data.isGou
            )
            _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, tb.data.isGou > 0)
            if data.NeedItem[1].sid == 101 then --活动代币（恶灵入侵）
                myCount = require "MonsterSiegeManager":GetInstance():GetCoinActivity()
            elseif data.NeedItem[1].sid == 103 then
                myCount = require "ArenaFairManager":GetInstance():GetCoin()
            elseif data.NeedItem[1].sid == 109 then
                myCount = require "SixVsSixCoinModel":GetInstance():GetCoin()
            elseif data.NeedItem[1].sid == 104 then
                myCount = require "GuessGameModel":GetInstance():GetCoin()
            else
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(data.NeedItem[1].sid)
                myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, data.NeedItem[1].sid)
            end
            local IsCanTake = myCount >= data.NeedItem[1].num and data.State == 1
            _G.GameUtil.SetActiveByCondition(tb.obj_getEff, IsCanTake and data.isGou > 0)
        end
        self.TypeCls:RefreshRedPointExchange()
    end
end

function LimitTimeExchange:CreateItem(tb, ide)
    local data = tb.data
    local item = self.ItemList[ide]
    local getItem = function(_data, p, type, eff)
        if eff ~= nil then
            if item then
                if item.eff then
                    _G.PoolsManager:GetInstance():Despawn(item.eff.gameObject, _G.ePoolType.UIEffect)
                end
                _G.PoolsManager:GetInstance():Despawn(item.gameObject, _G.ePoolType.UIItem)
            end
        else
            for i = 1, p:GetChildCountE() do
                _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
        _G.StorageManager:GetInstance():GetItemBaseView(
            _data.sid,
            _data.num,
            p,
            function(tran)
                tran.gameObject:SetName(_data.sid)
                tran.sid = _data.sid
                tran.gameObject:SetLocalPosition(0, 0, 0)
                if type then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
                self.ItemList[ide] = tran
                if eff == true then
                    self:LoadEff(tran, _data.sid)
                end
                tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    local NeedItem = data.NeedItem[1]
    local GetItem = data.GetItem[1]
    local myCount = 0
    if NeedItem.sid == 101 then --活动代币（恶灵入侵）
        myCount = require "MonsterSiegeManager":GetInstance():GetCoinActivity()
    elseif NeedItem.sid == 103 then
        myCount = require "ArenaFairManager":GetInstance():GetCoin()
    elseif NeedItem.sid == 104 then
        myCount = require "GuessGameModel":GetInstance():GetCoin()
    elseif NeedItem.sid == 109 then
        myCount = require "SixVsSixCoinModel":GetInstance():GetCoin()
    else
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(NeedItem.sid)
        myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, NeedItem.sid)
    end
    local IsCanTake = myCount >= NeedItem.num and data.State == 1
    _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, data.isGou > 0)
    tb.aorbtn_exchange:SetActiveE(data.State == 1 and 1 or 0)
    tb.aorbtn_gray:SetGray(data.State == 0)
    tb.aorbtn_gray:SetActiveE(data.State == 0 and 1 or 0)
    tb.exchange = nil
    tb.obj_isTips:SetActiveE(data.ShowGou and 1 or 0)
    tb.aorbtn_gou:SetActiveE(data.ShowGou and 1 or 0)
    _G.GameUtil.SetActiveByCondition(tb.obj_getEff, data.ShowGou and IsCanTake and data.isGou > 0)
    if myCount >= NeedItem.num then
        -- tb.aortext_rootPercent.text = _G.GameUtil.NumberToUnitStrFight(myCount) .. "/" .. NeedItem.num
        tb.aortext_rootPercent.text = NeedItem.num
    else
        tb.exchange = tipId.noItem
        tb.aortext_rootPercent.text =
            --"<color=red>" .. _G.GameUtil.NumberToUnitStrFight(myCount) .. "</color>" .. "/" .. NeedItem.num
        NeedItem.num
    end
    local remainCount = data.LimitTime - data.ExchangeTime --剩余可兑换次数
    if data.State == 1 then
        if remainCount <= 0 then
            tb.aortext_percent.text =
                GetLangPackValue(90000000961) ..
                "(" .. "<color=red>" .. remainCount .. "</color>" .. "/" .. data.LimitTime .. ")"
        else
            tb.aortext_percent.text =
                GetLangPackValue(90000000961) .. "(" .. remainCount .. "/" .. data.LimitTime .. ")"
        end
    else
        tb.exchange = tipId.limitCount
        --tb.aortext_percent.text = remainCount .. "/" .. data.LimitTime
        if remainCount <= 0 then
            tb.aortext_percentGray.text =
                GetLangPackValue(90000000961) .. "(<color=red>" .. remainCount .. "</color>/" .. data.LimitTime .. ")"
        else
            tb.aortext_percentGray.text =
                GetLangPackValue(90000000961) .. "(" .. remainCount .. "/" .. data.LimitTime .. ")"
        end
    end
    getItem(NeedItem, tb.obj_itemfrom, false)
    getItem(GetItem, tb.obj_itemto, true, IsCanTake)
end
function LimitTimeExchange:LoadEff(tran, Sid)
    local num = _G.StorageManager:GetInstance():GetCommonLightEffect(Sid)

    _G.UIUtils.LoadEffectByCfg(
        num,
        tran.gameObject,
        function(trans)
            tran.eff = trans
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        end
    )
end
function LimitTimeExchange:CloseView()
    self:Close()
end
function LimitTimeExchange:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    else
        name = "nilFnc"
    end
    if go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 81)
    end
end

return LimitTimeExchange
