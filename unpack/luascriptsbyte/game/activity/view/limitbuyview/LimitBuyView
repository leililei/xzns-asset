---@class LimitBuyView : UIBaseView    中文描述
---@field public go_table LimitBuyView_GoTable GoTable
---@field cfg exchange_cfg
local LimitBuyView = _G.BaseClass("ItemBugView", _G.UIBaseView)
local storageManager
function LimitBuyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function LimitBuyView:OnCreate(data, buyCall, typeClass)
    self.TypeCls = typeClass
    self.data = data
    if not self.data then
        self:Close()
    end
    storageManager = _G.StorageManager:GetInstance()
    local itemdata = storageManager:GetStorageItemData(data.GetItem[1].sid)
    local NeedItem = data.NeedItem[1]
    self.coinData = _G.ConfigManager.currency_type_client_cfg[NeedItem.sid]
    if NeedItem.sid == 101 then
        --活动代币（恶灵入侵）
        local CoinModel = require "MonsterSiegeManager":GetInstance()
        self.curHave = CoinModel:GetCoinActivity()
    elseif NeedItem.sid == 103 then
        local CoinModel = require "ArenaFairManager":GetInstance()
        self.curHave = CoinModel:GetCoin()
    elseif NeedItem.sid == 104 then
        local CoinModel = require "GuessGameModel":GetInstance()
        self.curHave = CoinModel:GetCoin()
    elseif NeedItem.sid == 109 then
        local CoinModel = require "SixVsSixCoinModel":GetInstance()
        self.curHave = CoinModel:GetCoin()
    elseif NeedItem.sid == 125 then
        local CoinModel = require "LimitTimeDropCoinModel":GetInstance()
        self.curHave = CoinModel:GetCoin()
    elseif NeedItem.sid == 74 then
        self.curHave = _G.StorageManager:GetInstance():GetOtherItemCountBySid(NeedItem.sid) or 0
        self.coinData = _G.ConfigManager.currency_type_cfg[NeedItem.sid]
        if not _G.table.isEmptyOrNil(self.data.isLock) then
            self.go_table.aorbtn_Done:SetActiveE(0)
            self.go_table.aorbtn_Close:SetActiveE(0)
            self.go_table.aortext_Lock.text = self.data.isLock
        else
            self.go_table.aorbtn_Done:SetActiveE(1)
            self.go_table.aorbtn_Close:SetActiveE(1)
            self.go_table.aortext_Lock.text = ""
        end
    elseif NeedItem.sid == 19 then
        self.curHave = _G.StorageManager:GetInstance():GetOtherItemCountBySid(NeedItem.sid) or 0
        self.coinData = _G.ConfigManager.currency_type_cfg[NeedItem.sid]
        if not _G.table.isEmptyOrNil(self.data.isLock) then
            self.go_table.aorbtn_Done:SetActiveE(0)
            self.go_table.aorbtn_Close:SetActiveE(0)
            self.go_table.aortext_Lock.text = self.data.isLock
        else
            self.go_table.aorbtn_Done:SetActiveE(1)
            self.go_table.aorbtn_Close:SetActiveE(1)
            self.go_table.aortext_Lock.text = ""
        end
    elseif NeedItem.sid == 191 then
        self.curHave = _G.StorageManager:GetInstance():GetOtherItemCountBySid(NeedItem.sid) or 0
        self.coinData = _G.ConfigManager.currency_type_client_cfg[NeedItem.sid]
        if not _G.table.isEmptyOrNil(self.data.isLock) then
            self.go_table.aorbtn_Done:SetActiveE(0)
            self.go_table.aorbtn_Close:SetActiveE(0)
            self.go_table.aortext_Lock.text = self.data.isLock
        else
            self.go_table.aorbtn_Done:SetActiveE(1)
            self.go_table.aorbtn_Close:SetActiveE(1)
            self.go_table.aortext_Lock.text = ""
        end
    end
    self.curNumber = 0
    self.buyEndCall = buyCall
    self.curExChangeID = data.Sid
    self.needCost = NeedItem.num
    local maxCanChange = math.floor(self.curHave / self.needCost)
    self.maxExchangeTimes = data.LimitTime - data.ExchangeTime
    self.maxExchangeTimes = self.maxExchangeTimes > maxCanChange and maxCanChange or self.maxExchangeTimes
    if self.maxExchangeTimes < 1 then
        self.maxExchangeTimes = 1
    end
    self:ShowItem(itemdata)
    self:ChangeNum(1)
    --self.go_table.aortext_Number:SetActiveE(0)
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handler(self, self.OnInputEndEdit))
end

function LimitBuyView:OnInputEndEdit(text)
    local setCount = tonumber(text) or 0
    if setCount ~= 0 then
        self.curNumber = 0
        self:ChangeNum(setCount)
    end
end

local btnFunc = {
    ["@_aorbtn_close"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Close"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Sub10"] = function(self)
        self:ChangeNum(-10)
    end,
    ["@_aorbtn_Add10"] = function(self)
        self:ChangeNum(10)
    end,
    ["@_aorbtn_Sub1"] = function(self)
        self:ChangeNum(-1)
    end,
    ["@_aorbtn_Add1"] = function(self)
        self:ChangeNum(1)
    end,
    ["@_aorbtn_Cancel"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Done"] = function(self)
        self:Buy()
    end,
    ["@_aorbtn_shadow"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_propMax"] = function(self)
        self:ChangeNum(1, true)
    end,
}

---按钮点击事件在这里派发
function LimitBuyView:OnClickBtn(go)
    local name = go:GetName()
    if btnFunc[name] then
        btnFunc[name](self)
    end
end

function LimitBuyView:ShowItem(item)
    if not item then
        self:Close()
    end
    self.go_table.aortext_name.text = item.name
    self.go_table.aortext_describe.text = _G.GetLangPackValue(item.Cfg.Describe)
    self.go_table.aortext_haveNum.text = _G.GetLangPackValue(90022500907) ..
        _G.StorageManager:GetInstance():GetItemCountBySid(item.Cfg.ID)
    storageManager:GetItemBaseView(self.data.GetItem[1].sid, self.data.GetItem[1].num, self.go_table.obj_Item)
    self.go_table.aorrawimage_cost:LoadImage(self.coinData.icon)
end

function LimitBuyView:ChangeNum(num, maxBol)
    self.curNumber = maxBol and self.maxExchangeTimes or self.curNumber + num
    if self.curNumber > self.maxExchangeTimes then
        self.curNumber = self.maxExchangeTimes
    elseif self.curNumber < 1 then
        self.curNumber = _G.math.min(1, self.maxExchangeTimes)
    end
    local cost = self.curNumber * self.needCost
    --self.go_table.aortext_Number.text = self.curNumber
    self.go_table.input_userNum.text = self.curNumber
    local color = "<color=red>"
    if _G.AppSetting.IsXzns then
        color = "<color=#585A6F>"
    end
    if self.curHave < cost then
        self.go_table.aortext_cost.text = color .. self.curHave .. "</color>/" .. cost
    else
        self.go_table.aortext_cost.text = self.curHave .. "/" .. cost
    end
    self.cost = {}
    self.cost.num = self.curNumber
    self.cost.count = cost
end

function LimitBuyView:Buy()
    local pan = false
    if self.data and self.data.NeedItem then
        local id = _G.tonumber(self.data.GetItem[1].sid)
        local data = _G.ConfigManager.item_cfg[id]
        if data and not _G.table.isEmptyOrNil(data.UseParameter) then
            id = _G.tonumber(data.UseParameter[1][2])
        end

        pan = _G.StorageManager:GetInstance():GetIDMax(self.data.GetItem[1].sid, id)
    end

    if pan then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            622,
            nil,
            function()
                self.TypeCls:Exchange(self.data, self.data.NeedItem[1], _G.handler(self, self.OnBuyCall), self.cost)
            end
        )
    else
        self.TypeCls:Exchange(self.data, self.data.NeedItem[1], _G.handler(self, self.OnBuyCall), self.cost)
    end
end

function LimitBuyView:OnBuyCall(data)
    if self.buyEndCall then
        self.buyEndCall(data)
    end
    self:Close()
end

function LimitBuyView:OnDestroy()
    self.go_table.input_userNum.onEndEdit:RemoveListener(_G.handler(self, self.OnInputEndEdit))
end
return LimitBuyView
