local ActivitySynManager = require "ActivitySynManager"
---@class CDKeyView BaseClass 兑换码福利
---@field public go_table BaseClass GoTable
local CDKeyView = _G.BaseClass("CDKeyView", _G.UIBaseView)
local limitlanguage = {
    [1] = 90100000185,
    [4] = 90100000186,
    [50] = 90100000187,
    [52] = 90100000188
}
function CDKeyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.CodeInfo = {}
    self.ItemTb = {}
    self.Key = ""
    self.ActivityID = 0
end

---界面入口
function CDKeyView:OnCreate(activity)
    self.ActivityData = activity
    self.Info = self.ActivityData.cfg.info
    self.ActivityData.typeClass:UpdateRedPoint()
    self.CodeInfo = self.ActivityData.typeClass.CodeInfo
    self.Key = self.CodeInfo.gift_code.code
    _G.table.insert(self.ItemTb, self.CodeInfo.gift_code.award)
    self.ActivityID = self.ActivityData.activityID
    self:InitView()
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CDKeyView_bg, self.go_table.aorrawimage_BG)
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CDKeyView_text, self.go_table.aorrawimage_title)
end

function CDKeyView:CloseView()
    self:Close()
end

---初始化界面
function CDKeyView:InitView()
    local endTime = self.ActivityData:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local tb = _G.TimeUtil.GetDateTime(endTime)
    if tb.minute < 10 then
        tb.minute = "0" .. tb.minute
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90028010128, tb.month, tb.day, tb.hour, tb.minute)
    self.go_table.aortext_Key.text = _G.GetLangPackValue(90028010127, self.Key)
    local type = self.ActivityData.typeClass.type
    local Needcondition = self.ActivityData.typeClass.Needcondition
    if type == 4 then
        local afk_cfg = _G.ConfigManager.afk_cfg
        local chapter = afk_cfg[Needcondition].chapter
        local section = afk_cfg[Needcondition].section
        Needcondition = chapter .. "-" .. section
    end
    self.go_table.aortext_limit.text = _G.GetLangPackValue(limitlanguage[type], Needcondition)
    --背景图和标题图片设置
    self.go_table.aorrawimage_title:LoadImage(
        self.Info.description,
        function(tran)
            tran:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_BG:LoadImage(
        self.Info.icon,
        function(tran)
            tran:SetNativeSize()
        end
    )
    self:CreatItem()
end

---奖励物品生成
function CDKeyView:CreatItem()
    self:CleanView()
    for i = 1, #self.ItemTb[1] do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            self.ItemTb[1][i].type,
            self.go_table.obj_root,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:SetGrade(true)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:ShowName(true)
                tran.go_table.aortext_Name.color = _G.Color.New(255 / 255, 142 / 255, 67 / 255, 1)
            end
        )
    end
end

---更换页签时清空奖励item
function CDKeyView:CleanView()
    if nil ~= self.go_table.obj_root:GetChildCountE() then
        for i = 1, self.go_table.obj_root:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_root:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
end

---复制uid
function CDKeyView:CopyUid()
    local tbId = {}
    tbId.Key = self.Key
    --_G.CS.UnityEngine.GUIUtility.systemCopyBuffer = self.Key
    --_G.PopWindowManager:GetInstance():ShowAllTips(200105)
    _G.GameUtil.CopyContent(self.Key)
end

---点击事件在此触发
function CDKeyView:OnClickBtn(go)
    if nil == go then
        return
    end
    local name = go:GetName()
    if "@_aorbtn_copy" == name then
        self.ActivityData:CheckActivityInteractable(self.ActivityData:GetActivityID())
        self:CopyUid()
    elseif "@_aorbtn_skip" == name then
        self.ActivityData:CheckActivityInteractable(self.ActivityData:GetActivityID())
        --self:CopyUid()
        _G.JumpManager:GetInstance():Jump(158001,nil,self.Key)
    end
end

return CDKeyView
