---@class FiveStarPraiseTipsView : UIBaseView	中文描述
---@field public go_table FiveStarPraiseView_GoTable GoTable
local FiveStarPraiseTipsView = _G.BaseClass("FiveStarPraiseTipsView", _G.UIBaseView)

function FiveStarPraiseTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function FiveStarPraiseTipsView:OnCreate(data)
    self.Data = data
    self.award = _G.ConfigManager.discrete_cfg[131001]
    for k,v in pairs(self.award) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            self.go_table.obj_items,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                    item:ShowEffect(true)
                end
            end
        )
    end

    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "FiveStarPraiseTips"
    _G.PlayerPrefsManager.SetInt(key, 1)
    self.Data.typeClass:RefreshRedPoint()
end

function FiveStarPraiseTipsView:GetAward(msg)
    if msg.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    self.Data.typeClass.IsAward = 1
    self.Data.typeClass:RefreshRedPoint()
    self.Data:ChangeState(require "ActivitySynManager".State.Close)
    self:CloseView()
end

function FiveStarPraiseTipsView:Jump()
    if self.Data.typeClass.IsAward == 1 then
        if _G.AppSetting.DEBUG then
            _G.Log("已领取好评奖励")
        end
        return
    end
    local url = ""
    if _G.CS.Launcher.Inst.IsSDK then
        --_G.CS.UnityEngine.Application.OpenURL(_G.GetLangPackValue(90000011397))
        local channelId = _G.tonumber(_G.SDKManager:GetInstance():GetChannelId())
        if _G.AppSetting.DEBUG then
            _G.Log(channelId, "当前渠道id是>>>>>>")
        end
        local cfg = _G.ConfigManager.function_block_cfg
        if cfg[channelId] and not _G.string.IsNullOrEmpty(cfg[channelId].good_rating) then
            -- if _G.AppSetting.IsIos then
            --     -- IOS
            --     url = _G.GetLangPackValue(90036100008)
            -- else
            --     -- google
            --     url = _G.GetLangPackValue(90036100007)
            -- end
            _G.GameUtil.OpenUrl(cfg[channelId].good_rating)
        end
    end

    if _G.AppSetting.IsEditor and _G.AppSetting.DEBUG then
        -- local url = _G.ConfigManager.discrete_cfg[131002][1] or _G.ConfigManager.discrete_cfg[131002][1][1]
        -- _G.CS.UnityEngine.Application.OpenURL(url)
        _G.LogError(url)
        _G.LogError("本地测试专用，打印日志非报错")
    end

    local msg = {}
    msg.operation = 2
    require "FiveStarPraiseNet":GetInstance():GetAward(msg, _G.handler(self, self.GetAward))
end

function FiveStarPraiseTipsView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function FiveStarPraiseTipsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_jump then
        ---todo 跳转到活动页
        --_G.JumpManager:GetInstance():JumpActivity(1)
        self:Jump()
        self:CloseView()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:CloseView()
    end
end

return FiveStarPraiseTipsView
