local ContinueRechargeActView = _G.BaseClass("ContinueRechargeActView", _G.UIBaseView)
function ContinueRechargeActView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ContinueRechargeActView:OnCreate()
    local res = _G.ConfigManager.ui_cfg.ContinueRechargeActView.resources
    self.resource = self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, res)
    )
    self:AddComponent(
            self.go_table.obj_PlayerHead,
            require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
    self.go_table.obj_tips:SetActiveE(0)
    self:InitView()
    --self:InitEffect()
    UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.ContinueRechargeActView, self.go_table)
end

---初始化界面
function ContinueRechargeActView:InitView()
    self.continuedDay = ContinueRechargeActModel:GetInstance():GetContinuedDay()
    self:InitTime()
    self.rechargeData = ContinueRechargeActModel:GetInstance():GetRechargeData()
    _G.SortList(
            self.rechargeData,
            function(item)
                local state = 0
                if item.state == 2 then
                    state = 2
                elseif item.state == 0 then
                    state = 1
                end
                return state, -item.id
            end
    )
    local todaySid = ContinueRechargeActModel:GetInstance():GetTodaySid()
    for k, v in pairs(self.rechargeData) do
        if v.id == todaySid then
            if v.state ~= 0 then
                self.go_table.aortext_activeDesc.text = _G.GetLangPackValue(90036300018, _G.GameUtil.GetPriceContentByNum(v.cashNum))
            else
                self.go_table.aortext_activeDesc.text = _G.GetLangPackValue(90036300006, _G.GameUtil.GetPriceContentByNum(v.price))
            end
            break
        end
    end
    if not self.itemListView then
        self.go_table.scrollloopvectical_ShowItem:InitItemData(
                #self.rechargeData,
                _G.handler(self, self.RefreshItem)
        )
        self.itemListView = self.go_table.scrollloopvectical_ShowItem
    else
        self.itemListView:UpdateAllItem()
    end
end

function ContinueRechargeActView:RefreshItem(index, obj)
    local x = index + 1
    local data = self.rechargeData[x]
    local tb = _G.GetAutoGoTable(obj)
    tb.data = data
    --tb.curDay = x
    tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
    self:CreateItem(tb)
end

