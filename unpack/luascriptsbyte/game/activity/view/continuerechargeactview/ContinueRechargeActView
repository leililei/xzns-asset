function ContinueRechargeActView:CreateItem(tb)
    local data = tb.data
    local showDay = 0
    if data.state == 0 then
        --local price = _G.GameUtil.RatioControl(data.price)
        --tb.aortext_Desc.text = _G.LangUtil.GetLangPackValue(90000010302, price)
        if ContinueRechargeActModel:GetInstance().cash_sid == data.id then
            --tb.aortext_percent.text = "<color=red>" .. data.cashNum .. "</color>/" .. price
            local needCash = tonumber(_G.GameUtil.RatioControl((data.price - data.cashNum)))
            tb.aortext_Desc:SetActiveE(needCash > 0 and 1 or 0)
            tb.aortext_Desc.text = _G.LangUtil.GetLangPackValue(_G.GameUtil.GetVoucherArg(90023800126, 90036300035), needCash)
        else
            --tb.aortext_percent.text = "<color=red>0</color>/" .. price
            tb.aortext_Desc:SetActiveE(0)
            tb.aortext_Desc.text = ""
        end
        showDay = self.continuedDay
    else
        showDay = data.day
    end
    --self:SetDayIcon(data.day, tb)
    tb.aorbtn_Get:SetActiveE(data.state == 2 and 1 or 0)
    tb.aorimage_isGet:SetActiveE(data.state == 1 and 1 or 0)
    tb.aortext_Desc:SetActiveE(data.state == 0 and 1 or 0)
    tb.aorbtn_Go:SetActiveE(data.state == 0 and 1 or 0)

    tb.aortext_Title.text = string.format(_G.GetLangPackValue(90023800123), data.day, showDay, data.day)
    for i = 1, tb.obj_itemRoot:GetChildCountE() do
        tb.obj_itemRoot:GetChildE(i - 1):DestroyObject()
    end
    for _, v in pairs(data.rewards) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v,
                tb.obj_itemRoot,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(1)
                    if _G.IsNil(tb.obj_itemRoot) then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran.sid = v[1]
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    tran:SetGou(data.state == 1)
                    local haveEffect = false
                    if data.state ~= 1 then
                        local Quality = _G.StorageManager:GetInstance():GetItemQuality(tran.sid)
                        if Quality >= 4 then
                            haveEffect = true
                        end
                    end
                    tran.gameObject:SetRectTransformSize(88, 88)
                    tran:ShowEffect(haveEffect and data.state == 2)
                end,
                function(go)
                    require "CommonTipManager":GetInstance():OpenTip(tb.obj_itemRoot, go.sid or go[1].sid)
                end
        )
    end
end

---设置天数图标
function ContinueRechargeActView:SetDayIcon(day, tb)
    local days = {}
    local floor = _G.math.floor
    local _day = _G.string.len(_G.tostring(day))
    if day <= 10 then
        _day = 1
    elseif _day == 2 and (day % 10) ~= 0 and floor((day / 10)) > 1 then
        _day = 3
    elseif day < 20 then
        _day = 4
    else
        _day = 2
    end
    local num = day
    if _day == 3 then
        _G.table.insert(days, floor(num / 10))
        _G.table.insert(days, 10)
        _G.table.insert(days, floor(num % 10))
    elseif _day == 2 then
        _G.table.insert(days, floor(num / 10))
        _G.table.insert(days, 10)
    elseif _day == 4 then
        _G.table.insert(days, 10)
        _G.table.insert(days, floor(num % 10))
    else
        _G.table.insert(days, num)
    end
    if not _G.table.isEmptyOrNil(days) then
        for i = 1, 3 do
            tb["aorimage_day" .. i]:SetActiveE(days[i] and 1 or 0)
            if days[i] then
                tb["aorimage_di" .. i]:SetActiveE(i == 1 and 1 or 0)
                tb["aorimage_tian" .. i]:SetActiveE(i == #days and 1 or 0)
                tb["aorimage_day" .. i].SpriteName = string.format("ui_lxcz_txt_%d", days[i])
                tb["aorimage_day" .. i]:SetNativeSize()
            end
        end
    end
end

---初始化时间
function ContinueRechargeActView:InitTime()
    local startTime, endTime = ContinueRechargeActModel:GetInstance():GetActTime()
    --ZHJH-12151【客户端】部分活动的显示时间前提1秒
    endTime = endTime - 1
    local starttime, endtime
    starttime = startTime - _G.TimeUtil.GetDayBegin(startTime)
    endtime = endTime - _G.TimeUtil.GetDayBegin(endTime)
    startTime = _G.TimeUtil.GetDateTime(startTime)
    endTime = _G.TimeUtil.GetDateTime(endTime)
    local str = _G.GetLangPackValue(90023800032) .. "<color=#96ce51>"
            .. _G.GetLangPackValue(90000010300, startTime.month, startTime.day, _G.TimeUtil.TimeToString(starttime, 1))
            .. "~"
            .. _G.GetLangPackValue(90000010300, endTime.month, endTime.day, _G.TimeUtil.TimeToString(endtime, 1)) .. "</color>"
    self.go_table.aortext_activeTime.text = str
end

---初始化特效
function ContinueRechargeActView:InitEffect()
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
        end
    end
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.prf_meizi, self.go_table.trans_spine, check)
end

---界面的销毁函数
function ContinueRechargeActView:OnDestroy()
end

---按钮点击事件在这里派发
function ContinueRechargeActView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        _G.AudioManager.OnSoundPlay(_G.AudioClipTypeEnum.otherAudio)
        self:CloseView()
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 96)
    end
end

function ContinueRechargeActView:CloseView()
    self:Close()
end

return ContinueRechargeActView