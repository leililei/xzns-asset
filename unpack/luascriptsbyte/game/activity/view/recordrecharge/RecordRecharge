local RecordRecharge = _G.BaseClass("RecordRecharge", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"
local tipId = {
    noItem = 650103,
    limitCount = 650102
}
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
local GameUtil = _G.GameUtil
function RecordRecharge:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.CloseView
        },
        ["@_aorbtn_go"] = {
            ["audio"] = _G.AudioClipTypeEnum.otherAudio,
            ["CallFunction"] = self.Go
        }
    }
end

local CloseCall = function()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActivityView.Name)
    if view then
        view:Close()
    end
end
function RecordRecharge:Go()
    if not self.Activity:CheckActivityInteractable() then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.recharge)
end

function RecordRecharge:OnCreate(activity)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RecordRecharge, self.go_table)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    local res = _G.ConfigManager.ui_cfg.LimitTimeExchange.resources
    self.resource =
        self:AddComponent(self.go_table.obj_GoldInfo, require("ResourceCompont").New(self.go_table.obj_GoldInfo, res))
    self:AddComponent(
        self.go_table.obj_PlayerHead,
        require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
    self:LoadSpine()
    self:InitView(activity)
    --self:InitEffect()
    --require "FreeGiftManager":GetInstance():Show(
    --    _G.FreeGiftID.RecordRecharge,
    --    self.go_table.obj_freeGift,
    --    activity:GetActivityID()
    --)
end

----@field TypeCls RecordRechargeModel
function RecordRecharge:InitView(activity)
    self.Activity = activity
    self.TypeCls = activity:GetActivityTypeCls()
    self.Data = self.TypeCls:GetCurActivitySelfData()
    self:InitTime()
    self:SetView()
    local path = _G.GameUtil.CheckVoucherModel() and "ImagesH5/hRecharge/ui_banner_ljcz_txt_mj" or "ImagesH5/hRecharge/ui_banner_ljcz_txt"
    self.go_table.aorrawimage_Title:LoadImage(path)
end

---@private
function RecordRecharge:RefreshView()
    self.Data = self.TypeCls:GetCurActivitySelfData()
    self:InitTime()
    self:SetView()
end

function RecordRecharge:OnDestroy()
    self.CommonInfo = nil
    self.Info = nil
    self.Data = nil
    self.count = nil
    self.Time = nil
end

function RecordRecharge:LoadSpine()
    if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.RecordRecharge, "trans_bgEffect") then
        self.go_table.trans_bgEffect:RemoveAllChildren()
        _G.PoolsManager:GetInstance():Spawn(
            "WX_Role/Animation_UI/Anduyin_UI/prf_Anduyin_UI_ui",
            _G.ePoolType.Temporary,
            self.go_table.trans_bgEffect,
            function(role)
                if not self.go_table then
                    _G.DestroyObject(role)
                    return
                end
                role:SetLocalPosition(224, 715, 0)
                role:SetLocalScale(-0.45, 0.45, 0.45)
            end
        )
    end
end

function RecordRecharge:InitTime()
    local GetLangPackValue = _G.LangUtil.GetLangPackValue
    local startTime, endTime
    startTime = self.Activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    endTime = self.Activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    --ZHJH-12151【客户端】部分活动的显示时间前提1秒
    endTime = endTime - 1
    local starttime, endtime
    starttime = startTime - _G.TimeUtil.GetDayBegin(startTime)
    endtime = endTime - _G.TimeUtil.GetDayBegin(endTime)
    self.StartTime = _G.TimeUtil.GetDateTime(startTime)
    self.EndTime = _G.TimeUtil.GetDateTime(endTime)
    local str =
        GetLangPackValue(90023800032) .. "<color=#96ce51>" ..
        GetLangPackValue(90000010300, self.StartTime.month, self.StartTime.day, _G.TimeUtil.TimeToString(starttime, 1)) ..
        "~" ..
        GetLangPackValue(90000010300, self.EndTime.month, self.EndTime.day, _G.TimeUtil.TimeToString(endtime, 1)) ..
        "</color>"
    self.go_table.aortext_activeTime.text = str
end

function RecordRecharge:SetView()
    self:Sortfunc()
    self.go_table.obj_tips:SetActiveE(0)
    if version == 1 then
        --self.go_table.obj_tips:SetActiveE(0)
        self.go_table.aortext_CurRecharged.text =
            _G.LangUtil.GetLangPackValue(90036300001, GameUtil.GetPriceContentByNum(self.Data.TotalCash))
    elseif version == 2 then
        --self.go_table.obj_tips:SetActiveE(1)
        self.go_table.aortext_CurRecharged.text =
            _G.LangUtil.GetLangPackValue(90000010301, self.Data.TotalCash)
    end
    if not self.count then
        self.go_table.scrollloopvectical_ShowItem:InitItemData(
            #self.TypeCls:GetCurActivitySelfData(),
            _G.handler(self, self.RefreshItem)
        )
        self.count = self.TypeCls:GetCurActivitySelfData()
    else
        if self.count ~= #self.TypeCls:GetCurActivitySelfData() then
            self.go_table.scrollloopvectical_ShowItem:UpdateCount(#self.TypeCls:GetCurActivitySelfData())
            self.count = self.TypeCls:GetCurActivitySelfData()
        else
            self.go_table.scrollloopvectical_ShowItem:UpdateAllItem()
        end
    end
end

function RecordRecharge:Sortfunc()
    local data = self.TypeCls:GetCurActivitySelfData()
    if not _G.table.isEmptyOrNil(data) then
        _G.SortList(
            data,
            function(a)
                --local NeedItem = a.NeedItem[1]
                local IsEnd = 0
                if a.State == 2 then
                    IsEnd = 2
                elseif a.State == 0 then
                    IsEnd = 1
                elseif a.State == 1 then
                    IsEnd = 0
                end
                --return isCanTake, a.State,-NeedItem.num
                return IsEnd, -a.CashNum
            end
        )
    end
end

function RecordRecharge:RefreshItem(index, obj)
    local x = index + 1
    local data = self.Data
    local tb = _G.GetAutoGoTable(obj)
    if data[x] then
        tb.data = data[x]
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        self:CreateItem(tb)
        if not self.isinited then
            tb.gameObject:SetActiveE(0)
            if tb.timer then
                tb.timer:Stop()
                tb.timer = nil
            end
            tb.timer = _G.TimerManager:GetInstance():GetTimer(index * 0.5, self.ShowItemObj, self, true, true, true, tb)
            tb.timer:Start()
        end
    end
end

function RecordRecharge:ShowItemObj(tb)
    if tb.timer then
        tb.timer:Stop()
        tb.timer = nil
    end
    tb.gameObject:SetActiveE(1)
end

function RecordRecharge:ClickItemBtn(go, isOn, tb)
    if not self.Activity:CheckActivityInteractable() then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_Get" then
        self.TypeCls:GetAward(
            { tb.data.Sid },
            function(data)
                if data.ack == 1 then
                    tb.data.State = 1
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    require "CommonTipManager".OpenCommonAwardView(data)
                    self:CreateItem(tb)
                    self:SetView()
                end
            end
        )
    elseif name == "@_aorbtn_Go" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.rechargeDjq, nil,
            _G.handler(self, self.RefreshView))
        --local MallView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MallView.Name)
        --self.JumpCo =
        --    _G.coroutine.start(
        --    function()
        --        while (_G.IsNil(MallView.View.gameObject)) do
        --            _G.coroutine.waitforendofframe()
        --        end
        --        CloseCall()
        --    end
        --)

        if _G.CS.Launcher.Inst.IsSDK then
            local json =
                _G.Table2Json(
                    {
                        role_uid = _G.PlayerModel:GetInstance().role_uid,
                        role_level = _G.PlayerModel:GetInstance():GetLevel(),
                        role_vip = _G.PlayerModel:GetInstance().vipLv,
                        server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                        channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                        phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                        user_type = 1,
                        record_time = _G.TimeUtil.GetServerUnixTime(),
                        parent_interface = "RecordRecharge"
                    }
                )
            if _G.AppSetting.DEBUG then
                _G.Log(json, "进入商城界面打点")
            end
            _G.SDKManager:GetInstance():DoShushuData_track("enter_shop_interface", json)
        end
    end
end

function RecordRecharge:CreateItem(tb)
    local data = tb.data
    local getItem = function(_data, p, isGou)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            _data,
            p,
            function(tran)
                tran.sid = _data[1]
                tran.gameObject:SetLocalPosition(0, 0, 0)
                tran.gameObject:SetRectTransformSize(0, 0)
                tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                tran:SetGou(isGou)
                local haveEffect = false
                if not isGou then
                    local Quality = _G.StorageManager:GetInstance():GetItemQuality(tran.sid)
                    if Quality >= 4 then
                        haveEffect = true
                    end
                end
                tran:ShowEffect(haveEffect)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    local CashNum = data.CashNum
    if data.CashNum == 0 then
        tb.aortext_itemDesc.text = _G.LangUtil.GetLangPackValue(90000010354)
    else
        local content , finalPrice = _G.GameUtil.SetPriceByChannel(CashNum)
        local process = " ( " .. _G.GameUtil.RatioControl(self.Data.TotalCash) .. "/" .. finalPrice.. " )"
        if version == 1 then
            local content = _G.GameUtil.SetPriceByChannel(CashNum, nil, 90000010302)
            tb.aortext_itemDesc.text = content .. process
        elseif version == 2 then
            tb.aortext_itemDesc.text = _G.LangUtil.GetLangPackValue(90000010810, finalPrice) .. process
        end
    end
    tb.aorbtn_Get:SetActiveE(data.State == 2 and 1 or 0)
    tb.aorimage_isGet:SetActiveE(data.State == 1 and 1 or 0)
    tb.aorbtn_Go:SetActiveE(data.State == 0 and 1 or 0)
    for i = 1, tb.obj_itemRoot:GetChildCountE() do
        tb.obj_itemRoot:GetChildE(i - 1):DestroyObject()
    end
    for k, v in pairs(data.Award) do
        getItem(v.type, tb.obj_itemRoot, data.State == 1)
    end
end

function RecordRecharge:CloseView()
    self:Close()
end

function RecordRecharge:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    else
        name = "nilFnc"
    end
    if go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 95)
    end
end

function RecordRecharge:InitEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_piaodailiuguang_1, self.go_table.trans_effect, check)
    LoadEffectByCfg(ui_effect_cfg.ef_fulizitiliuguang, self.go_table.trans_effect, check)
    LoadEffectByCfg(ui_effect_cfg.ef_haolisaoguang, self.go_table.trans_effect, check)
    LoadEffectByCfg(ui_effect_cfg.ef_beijingguangxiao_1, self.go_table.trans_bgEffect, check)
    LoadEffectByCfg(ui_effect_cfg.prf_caoyanbin, self.go_table.trans_spine, check)
end

return RecordRecharge
