local base = require("ActivitySynTypeBase")
local MiniTaskGameModel = require("MiniTaskGameModel")
local MiniTaskGameNet = require("MiniTaskGameNet")

---@class MiniTaskGameSynModel : ActivitySynTypeBase	国庆接红包小游戏
---@field gameType number 游戏类型: 1接红包, 2送外卖 3打气球
---@field takeOutGame MiniTakeOutGameModel  GM小游戏_赛车
local MiniTaskGameSynModel = _G.BaseClass("MiniTaskGameSynModel", base)

--小游戏类型
local GmaeTypes = {
    RedPaper = 1,   --接红包小游戏
    TakeOut = 2,    --送外卖/赛车小游戏
    ProYang = 3,    --杨叫兽
    MTRedPaper = 4, --MT送包包(同接红包)
}

---创建对象时,入口构造函数
function MiniTaskGameSynModel:__init()
    self.activityId = self.curActivityClass:GetActivityID()
    --刷新红点状态
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
end

function MiniTaskGameSynModel:OnHandleGMData(msg)
    self:ParseData(msg)
end

function MiniTaskGameSynModel:ParseData(msg)
    MiniTaskGameModel:GetInstance():SetActivity(self, self.activityId)
    msg = msg.mini_game1 or {}
    self.gameType = msg.type
    self.dayScore = msg.score
    self.maxScore = msg.history
    require("RedPointManager"):GetInstance():RefreshNode( self:GetRedpointIDByIndex(1))
    base.ParseData(self)
end

function MiniTaskGameSynModel:OnEnterActivity()
    local name
    if self.gameType == GmaeTypes.RedPaper then
        name = _G.ConfigManager.ui_cfg.RedPaperView.Name
        _G.UIManager:GetInstance():OpenWindow(name, self)
    elseif self.gameType == GmaeTypes.TakeOut then
        name = _G.ConfigManager.ui_cfg.TakeOutGameView.Name
        _G.UIManager:GetInstance():OpenWindow(name, self)
    elseif self.gameType == GmaeTypes.ProYang then
        local type = self.curActivityClass:GetJumpType()
        if _G.AppSetting.IsXzns then
            if type == 100170 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EasterMiniGameMainView.Name, self)
            end
        elseif type == 100167 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EasterMiniGameMainView.Name, self)
        elseif type == 100170 then 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LYXZMiniGameMainView.Name, self)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ProYangMiniGameMainView.Name, self)
        end
    elseif self.gameType == GmaeTypes.MTRedPaper then
        local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
        if _type==_G.JointActivityType.SpringFestival then
            local time=_G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
            _G.PlayerPrefsManager.SetInt(string.format("%s%s",self.curActivityClass.activityID,time),1)
            require("RedPointManager"):GetInstance():RefreshNode( self:GetRedpointIDByIndex(1))
            name = _G.ConfigManager.ui_cfg.SpringFestivalRedBoundMainView.Name
            _G.UIManager:GetInstance():OpenWindow(name, self)
        else
            name = _G.ConfigManager.ui_cfg.MTRedPaperMainView.Name
            _G.UIManager:GetInstance():OpenWindow(name, self)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未知的小游戏类型: " .. tostring(self.gameType))
        end
    end
    if name and _G.AppSetting.IsXzns then
        require("RescueGoddessModel"):GetInstance():SetPlayingView(name)
    end
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function MiniTaskGameSynModel:OnGetMainViewName()
    if self.gameType == GmaeTypes.RedPaper then
        return _G.ConfigManager.ui_cfg.RedPaperView.Name
    elseif self.gameType == GmaeTypes.TakeOut then
        return _G.ConfigManager.ui_cfg.TakeOutGameView.Name
    elseif self.gameType == GmaeTypes.MTRedPaper then
        return _G.ConfigManager.ui_cfg.MTRedPaperMainView.Name
    end
end

function MiniTaskGameSynModel:LaterInitFunction()
    if self.gameType == GmaeTypes.MTRedPaper or (_G.AppSetting.IsXzns and self.gameType == GmaeTypes.ProYang) then
        --任务红点
        local taskActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
                10007,
                self.curActivityClass:GetJumpType(),
                self.curActivityClass:GetMainType()
        )
        if taskActivity then
            require("RedPointManager"):GetInstance():AddRedPointChild(
                self:GetRedpointIDByIndex(1),
                taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
            )
        end
    end
end

function MiniTaskGameSynModel:Finish(score, call)
    local pbData = {id = self.activityId, score = score}
    MiniTaskGameNet:GetInstance():Finish(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if score > self.maxScore then
                self.maxScore = score
            end
            if score > self.dayScore then
                self.dayScore = score
            end
            if call then
                call()
            end
        end
    )
end

---初始化红点树
function MiniTaskGameSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function MiniTaskGameSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self, param)
    end
    return 0
end

---监听活动状态改变
function MiniTaskGameSynModel:OnActivityStateChanged(_, state)
    if state == require("ActivitySynManager").State.Close then
        if self.gameType == GmaeTypes.RedPaper then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RedPaperView.Name)
        elseif self.gameType == GmaeTypes.TakeOut then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.TakeOutGameView.Name)
        elseif self.gameType == GmaeTypes.MTRedPaper then
            local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
            if _type==_G.JointActivityType.SpringFestival then
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SpringFestivalRedBoundMainView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SpringRedPaperView.Name)
            else
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MTRedPaperMainView.Name)
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MTRedPaperView.Name)
            end
        end
    --活动已关闭
    --_G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

---检查红点
function MiniTaskGameSynModel:CheckRedPoint(param)
    return 0
end

---刷新奖励红点
function MiniTaskGameSynModel:RefreshRedPoint()
    --刷新所有子红点
    local redPointManager = require("RedPointManager"):GetInstance()
    for i = #self.redpointTree, 1, -1 do
        local redpointId = self:GetRedpointIDByIndex(i)
        redPointManager:RefreshNode(redpointId)
    end
end

function MiniTaskGameSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.super.Dispose(self)
end

function MiniTaskGameSynModel:IsShowBtn()
    return true
end

---获取活动剩余时间
---@return number
function MiniTaskGameSynModel:GetRemianDuration()
    local timeCfg = self.curActivityClass.cfg.time
    local endTime = timeCfg.start_time + timeCfg.run_time + timeCfg.get_time + timeCfg.show_time
    return math.max(0, endTime - _G.TimeUtil.GetServerUnixTime())
end

return MiniTaskGameSynModel
