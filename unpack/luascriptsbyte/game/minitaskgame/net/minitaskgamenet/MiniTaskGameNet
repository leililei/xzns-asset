local base = require("BaseGameNet")

---@class MiniTaskGameNet : BaseGameNet	通信协议
local MiniTaskGameNet = _G.BaseClass("MiniTaskGameNet", base)
---@return MiniTaskGameNet MiniTaskGameNet
function MiniTaskGameNet:GetInstance()
    return  base.GetInstance(self)
end

---完成小游戏
---@param pbData table PB数据
---@param callback function 完成回调
function MiniTaskGameNet:Finish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_mini_game_finish_game1
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function MiniTaskGameNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return MiniTaskGameNet