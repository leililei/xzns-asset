local SpoilsModel = require "SpoilsModel"

local base = require "EventViewBase"
---@class SpoilsStarUpView : UIBaseView    升星界面
---@field public go_table SpoilsStarUpView_GoTable GoTable
local SpoilsStarUpView = _G.BaseClass("SpoilsStarUpView", base)

function SpoilsStarUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Quility = {
        [4] = "ui_js_txk_zi",
        [5] = "ui_js_txk_cheng",
        [6] = "ui_js_txk_hong"
    }
end

---界面的入口函数
function SpoilsStarUpView:OnCreate(sid, oldattr)
    ---@type SpoilsData
    self.sp = SpoilsModel:GetInstance():GetData(sid)
    self.oldattr = oldattr
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.sp.cfg.Name)
    self.go_table.aortext_level.text = ""
    self.go_table.aortext_power.text = _G.GetLangPackValue(90033900031, self.sp.power)
    self:ShowItemData()
    self:ShowProp()
    self:ShowStar()
    self:ShowUpStarEffect()

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shengxingchenggong,
        self.go_table.obj_Eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

---获得父物体画布
---@param obj UnityEngine.GameObject 子物体
function SpoilsStarUpView:GetParentCanvas(obj)
    local canvas = obj:GetComponentInParentE(_G.typeof(_G.Canvas))
    if not canvas.overrideSorting then
        return self:GetParentCanvas(canvas.transform)
    else
        return canvas
    end
end

---按钮点击事件在这里派发
function SpoilsStarUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    end
end

function SpoilsStarUpView:ShowItemData()
    --self.go_table.aorimage_Bg.SpriteName = self.Quility[self.sp.cfg.Order]
    self.go_table.aorrawimage_icon:LoadImage(self.sp.cfg.Icon,function(img)
        img:SetNativeSize()
    end)
end

function SpoilsStarUpView:ShowProp(data)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = self.sp:GetAttributeDict()
    local numStr1, numStr2,num1, num2,key, showList
    showList =AttributeClassManager:GetChangeAttrList(attribute)
    local attr=attribute:GetAttrByName(_G.AttCountType.other)
    local lastattr=self.oldattr:GetAttrByName(_G.AttCountType.other)
    self.propList = {}
    for k, v in pairs(showList) do
        key=v.key
        num1=attr[key]
        num2=lastattr[key]
        if _G.AttrType[key].percentage == 1 then
            num1 = (num1-num2) * 100
            numStr1 = tostring(num1) .. "%"
            num2 = num2*100
            numStr2 = tostring(num2) .. "%"
        else
            numStr1 = _G.GameUtil.NumberWY(num1-num2)
            numStr2 = _G.GameUtil.NumberWY(num2)
        end
        if _G.AttrType[key] then
            _G.table.insert(
                    self.propList,
                    {
                        name = _G.AttrType[key].des,
                        value = numStr1,
                        oldvalue =string.format("%s+",numStr2) 
                    }
            )
        end
    end

    attr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    lastattr=self.oldattr:GetAttrByName(_G.AttCountType.basePercent)
    for k, v in pairs(showList) do
        if _G.AttrType[key] then
            key=v.key
            num1=attr[key]
            num2=lastattr[key]
            num1 = (num1-num2)*100
            numStr1 = tostring(num1) .. "%"
            num2 = num2*100
            numStr2 = tostring(num2) .. "%"
            _G.table.insert(
                    self.propList,
                    {
                        name = _G.string.AddColor(_G.GetLangPackValue(90033800108,_G.AttrType[key].des),"ff8331"),
                        value = _G.string.AddColor(numStr1,"ff8331"),
                        oldvalue = _G.string.AddColor(string.format("%s+",numStr2),"ff8331")
                    }
            )
        end
    end

    for _, v in ipairs(self.propList) do
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            tb.aortext_Name.text = v.name
            tb.aortext_oldValue.text = v.oldvalue
            if AppSetting.IsXzns then
                tb.aortext_curValue.text = v.value
                tb.aortext_curValue.color = require "CardInfoManager".GetColorFromRGB("a7efbc")
            else
                tb.aortext_curValue.text = v.value
                tb.aortext_curValue.color = require "CardInfoManager".GetColorFromRGB("5ba4bd")
            end
            tran:SetActiveE(1)
        end
    end
end

---显示技能
function SpoilsStarUpView:ShowUpStarEffect()
    ---@type spoils_cfg
    local cfg = self.sp.cfg
    self.starEffects = {}

    for i = 1, #cfg.att_growth do
        local growth = cfg.att_growth[i] / 10000
        local prop = {}
        prop.atk = _G.Mathf.RoundToInt(cfg.atk * growth)
        prop.bre = _G.Mathf.RoundToInt(cfg.bre * growth)
        prop.def = _G.Mathf.RoundToInt(cfg.def * growth)
        prop.max_hp = _G.Mathf.RoundToInt(cfg.max_hp * growth)
        if self.sp.star == i then
            _G.table.insert(self.starEffects, prop)
        end
    end

    for i = 1, #self.starEffects do
        --if i == self.data.star then
        local obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.trans_content)
        local tb = _G.GetAutoGoTable(obj)
        tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
        local effdesc = { "atk", "bre", "def", "max_hp" }
        local enddesc = ""
        for j = 1, #effdesc do
            enddesc = enddesc .. _G.AttrType[effdesc[j]].des .. self.starEffects[i][effdesc[j]]
        end
        tb.DesExText.text = self:GetSkillDes(i, enddesc)
        if self.sp.star >= i - 1 then
            tb.DesExText.color = require "CardInfoManager".GetColorFromRGB("5ba4bd")
        end
        tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
        obj:SetActiveE(1)
        --end
    end

    if #self.starEffects == 0 then
        self.go_table.obj_skills:SetActiveE(0)
        self.go_table.obj_title2:SetActiveE(0)
    else
        GameUtil.ReBuildRTF(self.go_table.obj_title2_Layout)
    end
end

---设置星级显示
---@param isShow number
function SpoilsStarUpView:ShowStar(isShow)
    local starNum = self.go_table.obj_stars:GetChildCountE()
    local star = self.sp:GetStar()
    if star == 0 then
        for level = 2, starNum do
            self.go_table.obj_stars:GetChildE(level - 1):SetActiveE(0)
        end
    else
        local tmpstar = star % 5
        local blstar = star / 5
        if tmpstar == 0 then
            tmpstar = star
        end
        for level = 2, starNum do
            local obj = self.go_table.obj_stars:GetChildE(level - 1)
            local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if level - 1 <= tmpstar then
                obj:SetActiveE(1)
                if blstar > 1 then
                    image.SpriteName = "ui_img_bxing_hong"
                    -- _G.UIUtils.LoadEffectByCfg(
                    --     _G.ConfigManager.ui_effect_cfg.ef_xingxing_red,
                    --     obj,
                    --     function(trans)
                    --         if self:IsNil() then
                    --             _G.DestroyObject(trans)
                    --             return
                    --         end
                    --     end
                    -- )
                else
                    image.SpriteName = "ui_img_bxing"
                    -- _G.UIUtils.LoadEffectByCfg(
                    --     _G.ConfigManager.ui_effect_cfg.ef_xingxing_orange,
                    --     obj,
                    --     function(trans)
                    --         if self:IsNil() then
                    --             _G.DestroyObject(trans)
                    --             return
                    --         end
                    --     end
                    -- )
                end
            else
                obj:SetActiveE(0)
            end
        end
    end
end

---获取技能描述
function SpoilsStarUpView:GetSkillDes(index, id)
    return _G.GetLangPackValue(90022300084, self.sp.star, id)
end

---@private
function SpoilsStarUpView:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

return SpoilsStarUpView
