---刷新抽卡按钮icon
function SpoilsDrawView:UpdateDrawBtn()
    --region 多次招募
    local isFirst = _G.PlayerPrefsManager.GetInt("SpoilsFirstDraw", 0) == 0
    -- 招募道具数量
    local lastTimes = SpoilsDrawModel:GetInstance():GetLastDiamondTimes()
    local sid, num, discount = SpoilsDrawModel:GetInstance():GetDiamondCurrencyByType(1)
    local midNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid)
    if isFirst and midNum > 1 then
        midNum = 1
    end
    self.midNum = midNum
    local mIcon = ItemCfg[self.itemSid].Icon
    local diamondIcon = _G.StorageManager:GetInstance():GetItemIcon(sid)
    local leftIsDiamond = lastTimes > 0 and midNum == 0
    self.leftIsDiamond = leftIsDiamond
    local rightIsDiamond = lastTimes >= 10 and midNum == 0
    self.rightIsDiamond = rightIsDiamond

    self.go_table.aortext_Prop1Num.text = leftIsDiamond and num or 1
    self.go_table.aortext_Prop2Num.text = rightIsDiamond and num * 10 or
        (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)
    self.go_table.aortext_Prop2NumDesc.text = _G.GetLangPackValue(90022300082,
        _G.GameUtil.NumberToWordByLanguage(rightIsDiamond and 10 or
            (midNum > 0 and (midNum <= 10 and midNum or 10) or 10)))
    self.drawNum = midNum > 0 and (midNum <= 10 and midNum or 10) or 10
    -- 红点
    self.go_table.obj_hongDian:SetActiveE(self.midNum >= 10 and 1 or 0)
    --endregion

    --region 图标加载
    self.go_table.aorrawimage_Prop1:LoadImage(
        leftIsDiamond and diamondIcon or mIcon,
        function(image)
            if image and self.isFree then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aorrawimage_Prop2:LoadImage(
        rightIsDiamond and diamondIcon or mIcon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
end

function SpoilsDrawView:ShowItems(Index, isGou)
    if Index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    -- _G.CS.UnityEditor.EditorApplication.isPaused = true;
    ---@type AorButton
    local btn = self.go_table["obj_award" .. Index]
    if btn ~= nil then
        local x, y, z = btn:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y * 1.1, z)
    end

    local item = self.Rewards_item[Index]
    local NowItems = {}
    for i = 1, #item / 2 do
        _G.table.insert(NowItems, { item[i * 2 - 1], item[i * 2] })
    end

    self.NowShowIndex = Index

    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end

    self.go_table.obj_Parent:ClearChildren()
    for i = 1, #NowItems do
        local info = NowItems[i]
        local num = info[2]
        self:CareatItem(info, isGou, self.go_table.obj_Parent, function(item)
        end)
    end
    self.go_table.obj_itemBg:SetRectTransformSize((#NowItems) * 75, 80)
    self.go_table.obj_ItemTips:SetRectTransformSize((#NowItems) * 75, 80)
    _G.UIUtils.SetOffScreenRectPosition(self.go_table.obj_ItemTips)
end

function SpoilsDrawView:CareatItem(data, isGou, Parent, backCall)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    local Sid = data[1]

    if Sid ~= _G.ResPropID.ActiveAch and Sid ~= _G.ResPropID.ActiveValue then
        -- body
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            Parent,
            function(item)
                if _G.IsNil(Parent) then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.5)
                item.gameObject:SetActiveE(1)
                item:SetPri(data.isPri)
                item:SetGou(isGou)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                if backCall then
                    backCall(item)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
            end
        )
    end
    --end
end

---抽！
function SpoilsDrawView:Draw(type)
    local draw = function(counsumeType, drawNum)
        local preNeedCount = SpoilsDrawModel:GetInstance():GetWishNeedCounts()
        SpoilsDrawModel:GetInstance():Draw(
            drawNum,
            counsumeType,
            function(msg)
                if msg.ack ~= 1 then
                    self:SetDrawBtnEnabled(true)
                    return
                end
                self:UpdateDrawBtn()
                self:LoadDiamondTimes()
                self:SetNeedCount()
                self:UpdateItemJd()

                if self.playType == DrawPlayType.Play and self.isBtnDraw then
                    local isLegend = msg.need_count > preNeedCount - drawNum
                    self:PlayDrawEffect({ award = msg.award }, isLegend)
                else
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DrawAwardView.Name,
                        msg,
                        _G.handler(self, self.ClickDrawBtn),
                        true,
                        nil,
                        nil,
                        nil,
                        nil,
                        true,
                        nil,
                        nil,
                        nil,
                        nil,
                        { ItemCfg[self.itemSid].Icon, self.drawNum }
                    )
                    self:SetDrawBtnEnabled(true)
                end
            end
        )
    end

    local counsumeType = type == DrawType.one and (self.leftIsDiamond and 2 or 1) or (self.rightIsDiamond and 2 or 1)
    local num = type == DrawType.one and 1 or
        self.rightIsDiamond and 10 or (self.midNum > 0 and (self.midNum <= 10 and self.midNum or 10)) or 10
    if counsumeType == 1 then
        if not _G.StorageManager:GetInstance():CheckItem(self.itemSid, num) then
            self:SetDrawBtnEnabled(true)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.itemSid)
            return
        end
        ---抽卡次数不足1次后重置打开界面的红点
        local remainNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.itemSid) - num
        local recordNum = _G.PlayerPrefsManager.GetInt("SpoilsDrawRedPoint")
        if remainNum == 0 then
            _G.PlayerPrefsManager.DeleteKey("SpoilsDrawRedPoint")
        elseif recordNum > 0 then
            --如果剩余数量不为0且记录值也大于0则更新记录值
            _G.PlayerPrefsManager.SetInt("SpoilsDrawRedPoint", remainNum)
        end
        draw(counsumeType, num)
    elseif counsumeType == 2 then
        if SpoilsDrawModel:GetInstance():GetLastDiamondTimes() >= num then
            local rmbSid, numNeed = SpoilsDrawModel:GetInstance():GetDiamondCurrencyByType(num)

            if not _G.StorageManager:GetInstance():CheckItem(rmbSid, numNeed) then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, rmbSid,function()
                    self:SetDrawBtnEnabled(true)
                end)
                return
            end

            _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                    633,
                    function()
                        self:SetDrawBtnEnabled(false)
                        draw(counsumeType, num)
                    end,
                    function()
                        self:SetDrawBtnEnabled(true)
                    end,
                    nil,
                    true,
                    numNeed,
                    num,
                    _G.GetLangPackValue(_G.ConfigManager.item_cfg[self.itemSid].Name),
                    num
            )
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(19)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("灵兽召唤收到未定义召唤类型")
            return
        end
    end
end

---点击召唤按钮
---@param type DrawType 召唤类型
function SpoilsDrawView:ClickDrawBtn(type, isBtnDraw)
    if type == nil then
        return
    end
    self.isBtnDraw = isBtnDraw == nil and true or isBtnDraw
    self:SetDrawBtnEnabled(false)
    local wish = SpoilsDrawModel:GetInstance():GetWishsids()
    local hasNoWish = false

    if wish == 0 then
        hasNoWish = true
    end
    if hasNoWish then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            271501,
            nil,
            function()
                self:SetDrawBtnEnabled(true)
                self:OnClickWishBtn()
            end,
            function()
                --self:Draw(type)
                _G.PopWindowManager:GetInstance():ShowAllTips(1140001)
            end
        )
    else
        self:Draw(type)
    end
end

function SpoilsDrawView:SetDrawBtnEnabled(enabled)
    if enabled then
        _G.DelayDo(1, function()
            self.go_table.aorbtn_Draw1.enabled = enabled
            self.go_table.aorbtn_Draw2.enabled = enabled
        end)
    else
        self.go_table.aorbtn_Draw1.enabled = enabled
        self.go_table.aorbtn_Draw2.enabled = enabled
    end
end

---按钮点击事件在这里派发
function SpoilsDrawView:OnClickBtn(go)
    if self.DrawIng then
        return
    end
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DrawAwardView.Name)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 121)
    elseif go == self.go_table.aorbtn_Draw1 then
        self:ClickDrawBtn(DrawType.one, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw2 then
        self:ClickDrawBtn(DrawType.ten, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_Draw3 then
        self:ClickDrawBtn(DrawType.rmb, not window)
        if window then
            window.View:Close()
        end
    elseif go == self.go_table.aorbtn_autoLeft then
        self:UpdateDrawPlayBtn(1 - self.playType)
    elseif go == self.go_table.aorbtn_TipsView then
        if self.NowShowIndex == nil then
            return
        end
        self:ShowItems(self.NowShowIndex, false)
    elseif go == self.go_table.aorbtn_AD then
        require "MonthlyModel":GetInstance():CheckShowADTips(function()
            require("AdvertisementModel"):GetInstance():VideoAD(_G.AdvertisementType.SpoilsDraw,
                _G.handler(self, self.UpdateDrawBtn))
        end)
    elseif go == self.go_table.aorbtn_gift then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SpiritualDrawGiftPackView.Name,
            nil, 
            _G.ActivitySubType.SpoilsGift
        )
    elseif go == self.go_table.aorbtn_txyl then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsProbabilityView.Name)
    elseif go == self.go_table.aorbtn_BattlePass then
        local ctrl = require("IntegrateBpFdModel"):GetInstance():GetController(1013901)
        if ctrl == nil then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.IntegrateBpFdView.Name, ctrl)
    end
end

function SpoilsDrawView:PlayAni()
    local Tweening = _G.CS.DG.Tweening
    self.tweenRing = self.wishObj.obj_ringroot:DOLocalMoveY(83, 1):SetEase(Tweening.Ease.InOutSine)
        :SetLoops(
            -1,
            Tweening.LoopType.Yoyo
        )
end

function SpoilsDrawView:StopAni()
    local Tweening = _G.CS.DG.Tweening
    if self.tweenRing then
        self.tweenRing:Kill()
        self.tweenRing = nil
    end
end

function SpoilsDrawView:PlayDrawEffect(msg, isLegend)
    self.DrawIng = true
    self.go_table.obj_djeff:SetActiveE(0)
    self.go_table.obj_eff:SetActiveE(1)
    --self.go_table.obj_ringroot:SetActiveE(0)
    self.go_table.obj_info:SetActiveE(0)
    self.go_table.aorimage_autobg:SetActiveE(0)
    self.go_table.obj_btn:SetActiveE(0)

    local highq = _G.SpoilsQuilty.cheng
    local yanwu = _G.ConfigManager.ui_effect_cfg.ef_chouka_yanwu1
    for i = 1, #msg.award.item do
        local id = msg.award.item[i].type[1]
        local cfg = _G.ConfigManager.item_cfg[id]
        if cfg.Quality > highq then
            highq = cfg.Quality
        end
    end
    if highq == _G.SpoilsQuilty.cheng then
        yanwu = _G.ConfigManager.ui_effect_cfg.ef_chouka_yanwu1
    elseif highq == _G.SpoilsQuilty.hong then
        yanwu = _G.ConfigManager.ui_effect_cfg.ef_chouka_yanwu2
    elseif highq == _G.SpoilsQuilty.cai then
        yanwu = _G.ConfigManager.ui_effect_cfg.ef_chouka_yanwu3
    end

    if _G.AppSetting.DEBUG then
        _G.Log(highq, "最高品质碎片 ")
    end

    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SpiritualDrawView_shoubanzhaomu,
            self.go_table.obj_eff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
            end
        )
    self.DelayEffect = _G.DelayDo(1.5, function()
        if self:IsNil() then
            return
        end
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_SpiritualDrawView_shoubanbao,
            self.go_table.obj_eff,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
            end
        )
    end)

    self.DelayAward = _G.DelayDo(
        2.2,
        function()
            if self:IsNil() then
                return
            end

            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawAwardView.Name,
                msg,
                _G.handler(self, self.ClickDrawBtn),
                true,
                nil,
                nil,
                nil,
                nil,
                true,
                nil,
                nil,
                nil,
                nil,
                { ItemCfg[self.itemSid].Icon, self.drawNum }
            )
            self:SetDrawBtnEnabled(true)
            self.go_table.obj_daijieffect:SetActiveE(1)
            self.go_table.obj_djeff:SetActiveE(1)
            self.go_table.obj_eff:SetActiveE(0)
            --self.go_table.obj_ringroot:SetActiveE(1)
            self.DrawIng = false
            self.go_table.obj_info:SetActiveE(1)
            self.go_table.aorimage_autobg:SetActiveE(1)
            self.go_table.obj_btn:SetActiveE(1)
        end
    )
end

---更新动画播放按钮
---@param type DrawPlayType
function SpoilsDrawView:UpdateDrawPlayBtn(type)
    if type == nil then
        self.playType = _G.PlayerPrefsManager.GetInt("SpoilsDrawSkip")
        if self.playType == nil then
            self.playType = DrawPlayType.Play
        end
    else
        self.playType = type
    end
    _G.PlayerPrefsManager.SetInt("SpoilsDrawSkip", self.playType)
    local isPlay = self.playType == DrawPlayType.Play
    self.go_table.aorimage_auto.gameObject:SetLocalPosition(isPlay and 32 or -32, 0, 0)
    self.go_table.aortext_wenzi.text = _G.ConfigManager.language_package_cfg
        [isPlay and DrawPlayText.Open or DrawPlayText.Close]
    self.go_table.aorimage_skip:SetActiveE(isPlay and 1 or 0)
end

function SpoilsDrawView:OnStartClose()
    if self.DelayAward then
        _G.coroutine.stopwaiting(self.DelayAward)
        self.DelayAward = nil
    end
    if self.DelayEffect then
        _G.coroutine.stopwaiting(self.DelayEffect)
        self.DelayEffect = nil
    end
end

---修改层级
function SpoilsDrawView:ChangeBtnBack(isBack)
    if isBack then
        self.go_table.obj_btn:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = self.gameObject
            :GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 30
    else
        self.go_table.obj_btn:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = self.gameObject
            :GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 100
    end
end

function SpoilsDrawView:Dispose()
    self:RemoveListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.PrivilegeChange, self)
    self:RemoveListener(_G.eSpoilsDraw.SpoilsDrawWishRefresh, self.ShowWish, self)
    self:RemoveListener(_G.eSixUpdate.SixClockUpdate, self.PrivilegeChange, self)
    _G.Events:GetInstance():RemoveListener(_G.eAdvertisement.Refresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eSpoilsUpStar.SpoilsUpStarRefresh, self.UpdateItemWishAndJd, self)
end

return SpoilsDrawView
