function SpoilsDrawView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.cfgid = 50100
    self.itemSid = _G.ConfigManager.item_roller_cfg[self.cfgid].ticket[1]
    self.wishObj = nil
    self.AwardList = {}
    self.Rewards_item = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_item
    self.rewardsCount = _G.ConfigManager.item_roller_cfg[self.cfgid].rewards_count
    self.go_table.aorbtn_Probability:SetActiveE(0)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsTask.id)
    _G.Events:GetInstance():AddListener(_G.eAdvertisement.Refresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.ResRefresh, self.UpdateDrawBtn, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

    _G.Events:GetInstance():AddListener(_G.eSpoilsUpStar.SpoilsUpStarRefresh, self.UpdateItemWishAndJd, self)
end

---界面的入口函数
function SpoilsDrawView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    --显示货币信息
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        local currencySid = _G.ConfigManager.ui_cfg.SpoilsDrawView.resources
        self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, currencySid)
        )
    end
    -- self.playerHead = self:AddComponent(
    --     self.go_table.obj_PlayerHead,
    --     require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    -- )
    if require("MonthlyModel"):GetInstance():IsOutTimePopUp(405004) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405004)
        _G.PopWindowManager:GetInstance():ShowAllTips(240310)
    end
    self.NowShowIndex = 99

    self.go_table.aorbtn_gift:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    self.go_table.aorbtn_txyl:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)

    self:LoadDiamondTimes()
    self:UpdateDrawBtn()
    self:ShowWish()
    self:UpdateDrawPlayBtn()
    self:SetNeedCount()
    self:AddListener(_G.eLimitePrivilege.LimitePrivilegeChange, self.PrivilegeChange, self)
    self:AddListener(_G.eSpoilsDraw.SpoilsDrawWishRefresh, self.ShowWish, self)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.PrivilegeChange, self)
end

function SpoilsDrawView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.DrawAwardView.Name then
        self:ChangeBtnBack(true)
    end
end

function SpoilsDrawView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.DrawAwardView.Name then
        self:ChangeBtnBack(false)
    end
end

---加载魂玉召唤次数信息
function SpoilsDrawView:LoadDiamondTimes()
    --获取魂玉召唤次数信息
    local usedTimes = SpoilsDrawModel:GetInstance():GetDiamondTimes()
    local totalTimes = SpoilsDrawModel:GetInstance():GetDiamondTotalTimes()
    self.go_table.obj_diamondTimes:SetActiveE(totalTimes > 0 and 1 or 0)
    if totalTimes <= 0 then
        return
    end

    local remain = totalTimes - usedTimes
    self.go_table.aortext_remainDiamondTimes.text = _G.GetLangPackValue(90022300102, remain .. "/" .. totalTimes)
end

function SpoilsDrawView:PrivilegeChange()
    self:LoadDiamondTimes()
    self:ShowWish()
    self:UpdateDrawBtn()
end

function SpoilsDrawView:UpdateItemWishAndJd()
    self:ShowWish()
    self:UpdateItemJd()
end

function SpoilsDrawView:UpdateItemJd()
    if nil == self.wishObj then
        return
    end
    local wish = SpoilsDrawModel:GetInstance():GetWishsids()
    local v = wish
    if v ~= 0 then
        local sp = SpoilsModel:GetInstance():GetData(v)
        local count = _G.StorageManager:GetInstance():GetItemCountBySid(sp.cfg.materials_item)
        local needCount = not sp:IsMaxStar() and sp.cfg.material_1[sp:GetStar() + 2] or 0

        self.wishObj.aortext_progress.text = count .. "/" .. needCount

        if needCount <= count then
            self.wishObj.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
        else
            self.wishObj.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
        end
    end
end

function SpoilsDrawView:ShowWish()
    self.go_table.obj_ringroot:SetActiveE(1)
    local wish = SpoilsDrawModel:GetInstance():GetWishsids()
    --ZHJH-3048 心愿单数量改为1
    local k = 1
    local v = wish
    if not self.wishObj then
        self.wishObj = _G.GetAutoGoTable(self.go_table.obj_ringroot, _G.handlerbind(self, self.OnClickWishBtn, k))
        --self.wishObj.obj_hongDian:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SpoilsDrawWish.id, k)
    end
    if v ~= 0 then
        self.cfg = _G.ConfigManager.spoils_cfg[v]
        local path = ""
        if self.cfg then
            path = self.cfg.Icon
        end
        self.wishObj.aorrawimage_role:LoadImage(
            path,
            function()
                self.wishObj.aorrawimage_role:SetNativeSize()
            end)
        self.wishObj.aorrawimage_role:SetActiveE(1)
        self.wishObj.obj_no:SetActiveE(0)
        self.wishObj.obj_ring:SetActiveE(0)
        self.wishObj.obj_hongDian:SetActiveE(0)

        local sp = SpoilsModel:GetInstance():GetData(v)
        local isUnlock = sp:GetIsActive()
        local IsMaxStar = sp:IsMaxStar()

        --self.wishObj.obj_progress:SetActiveE(not IsMaxStar and isUnlock and 1 or 0)
        self.wishObj.obj_progress:SetActiveE(0)
        self.wishObj.obj_maxStar:SetActiveE(IsMaxStar and 1 or 0)
        self.wishObj.aortext_star.text = _G.GetLangPackValue(90000010475,
            sp:GetStar())

        local count = _G.StorageManager:GetInstance():GetItemCountBySid(sp.cfg.materials_item)
        local needCount = not sp:IsMaxStar() and sp.cfg.material_1[sp:GetStar() + 2] or 0

        self.wishObj.aortext_progress.text = count .. "/" .. needCount

        if needCount <= count then
            self.wishObj.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
        else
            self.wishObj.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
        end

        self:StopAni()
    else
        self.wishObj.aorrawimage_role:SetActiveE(0)
        self.wishObj.obj_no:SetActiveE(1)
        self.wishObj.obj_ring:SetActiveE(1)
        self.wishObj.obj_hongDian:SetActiveE(1)

        self.wishObj.obj_progress:SetActiveE(0)
        self.wishObj.obj_maxStar:SetActiveE(0)

        self:PlayAni()
    end
end

function SpoilsDrawView:SetNeedCount()
    self.go_table.aortext_num.text = SpoilsDrawModel:GetInstance():GetWishNeedCounts()
end

