local SpoilsModel = require("SpoilsModel")

---@class SpoilsRecycleListView : UIBaseView    中文描述
---@field public go_table SpoilsRecycleListView_GoTable GoTable
local SpoilsRecycleListView = _G.BaseClass("SpoilsRecycleListView", _G.UIBaseView)

function SpoilsRecycleListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshSpoilsList))

    self.Quility = {
        [_G.SpoilsQuilty.cheng] = "ui_js_txk_cheng",
        [_G.SpoilsQuilty.hong] = "ui_js_txk_hong",
        [_G.SpoilsQuilty.cai] = "ui_js_txk_cai"
    }

    self.ChooseList = {}
    self.ItemList = {}
end

---按钮点击事件在这里派发
function SpoilsRecycleListView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeX then
        ---遮罩或者关闭按钮

        self:Close()
    elseif go == self.go_table.aorbtn_help then
        ---TODO:策划还没有给id
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 118)
    elseif go == self.go_table.aorbtn_sure then
        self:Close()
        if self.back then
            self.back(self.ChooseList)
            self.back = nil
        end
    elseif go == self.go_table.aorbtn_onekey then
        local level, level_sid, exp = SpoilsModel:GetInstance():GetRecyclLevelAndExp(self.recycleCfgid)

        local levelcfg = _G.ConfigManager.spoils_technology_info[level_sid]

        local needNum = levelcfg.Number - exp
        for i = 1, #self.SpoilsDataList do
            if needNum > self.SpoilsDataList[i].value then
                local info = {}
                info.value = self.SpoilsDataList[i].value
                info.key = self.SpoilsDataList[i].key
                self.ChooseList[i] = info
                needNum = needNum - self.SpoilsDataList[i].value
            else
                local info = {}
                info.value = needNum
                info.key = self.SpoilsDataList[i].key
                self.ChooseList[i] = info
                break
            end
        end

        self.go_table.scrollloopvectical_list:UpdateCount(#self.SpoilsDataList)
    end
end

---界面的入口函数
function SpoilsRecycleListView:OnCreate(order, recycleCfgid, back, chooseList)
    self.order = order
    self.recycleCfgid = recycleCfgid
    self.back = back
    ---数据列表
    self.SpoilsDataList = SpoilsModel:GetInstance():GetOverflowByOder(order)

    if nil == chooseList then
        for i = 1, #self.SpoilsDataList do
            local info = {}
            info.value = 0
            info.key = self.SpoilsDataList[i].key
            self.ChooseList[i] = info
        end
    else
        for i = 1, #self.SpoilsDataList do
            if chooseList[i] then
                self.ChooseList[i] = chooseList[i]
            else
                local info = {}
                info.value = 0
                info.key = self.SpoilsDataList[i].key
                self.ChooseList[i] = info
            end
        end
    end
    self.go_table.scrollloopvectical_list:UpdateCount(#self.SpoilsDataList)
end

---刷新列表
function SpoilsRecycleListView:RefreshSpoilsList(index, obj)
    index = index + 1
    local info = self.SpoilsDataList[index]
    local cfg = _G.ConfigManager.item_cfg[info.key]
    ---@type SpoilsWearView._obj_artItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSpoils, index))
    tb.aorimage_Bg.SpriteName = self.Quility[cfg.Quality]
    tb.aorrawimage_Icon:LoadImage(cfg.Icon)
    local chooseInfo = self.ChooseList[index]
    if chooseInfo then
        tb.aortext_num.text = chooseInfo.value .. "/" .. self.SpoilsDataList[index].value
        if chooseInfo.value > 0 then
            tb.aorbtn_choose:SetActiveE(1)
        else
            tb.aorbtn_choose:SetActiveE(0)
        end
    else
        tb.aortext_num.text = 0 .. "/" .. self.SpoilsDataList[index].value
        tb.aorbtn_choose:SetActiveE(0)
    end
    self.ItemList[index] = tb
end

---Item点击事件
---@param index number 索引
function SpoilsRecycleListView:OnClickSpoils(obj, isOn, index)
    local name = obj:GetName()
    local tb = self.ItemList[index]
    local info = self.SpoilsDataList[index]
    local chooseInfo = self.ChooseList[index]
    if name == "@_aorbtn_clickObj" then
        if chooseInfo.value < info.value then
            chooseInfo.value = chooseInfo.value + 1
            tb.aortext_num.text = chooseInfo.value .. "/" .. info.value
        end
    elseif name == "@_aorbtn_choose" then
        chooseInfo.value = chooseInfo.value - 1
        tb.aortext_num.text = chooseInfo.value .. "/" .. info.value
    end

    if chooseInfo.value > 0 then
        tb.aorbtn_choose:SetActiveE(1)
    else
        tb.aorbtn_choose:SetActiveE(0)
    end
end

function SpoilsRecycleListView:Choose()

end

---界面的销毁函数
function SpoilsRecycleListView:OnDestroy()
end

return SpoilsRecycleListView
