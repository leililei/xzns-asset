--region ===============卡牌列表Item=======================
local SpoilsCardItem = _G.BaseClass("SpoilsCardItem")
local SpoilsModel = require("SpoilsModel")
function SpoilsCardItem:__init(obj, click)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.clickCall = click
end

function SpoilsCardItem:Dispose()
    self.clickCall = nil
    self.go_table = nil
end

function SpoilsCardItem:OnClickBtn(go)
    if self.ActiveCell >= self.index and self.suitInfo.isActive then
        self.clickCall(self.index)
    else
        if self.cardCellStarLevel[self.index] == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, _G.GetLangPackValue(90033900070))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1001,
                _G.GetLangPackValue(90033900071, self.cardCellStarLevel[self.index]))
        end
    end
end

---展示卡牌
---@param index 序列号 卡牌对象
---@param data table 卡牌对象
function SpoilsCardItem:Show(index, data, suitInfo, cardNum, cardCell, cardCellStarLevel, ActiveCell)
    self.index = index
    self.data = data
    self.suitInfo = suitInfo
    self.ActiveCell = ActiveCell
    self.cardCellStarLevel = cardCellStarLevel

    if self.data then
        self.go_table.trans_root:SetActiveE(1)
        if not self.cardItem then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.HeadItem_Select,
                self.go_table.trans_root,
                function(view)
                    if self.go_table == nil or view == nil then
                        return
                    end
                    self.cardItem = view
                    view.transform:SetLocalPositionToZero()
                    view:ShowCardData(self.data)
                    local isgou = false --SpoilsModel:GetInstance():CheckBindSuit(self.suitInfo.cfg.id, self.data.uid)
                    view:SetSelectGou(isgou)
                    view:isHave(true)
                end
            )
        else
            self.cardItem:ShowCardData(data)
            local isgou = false --SpoilsModel:GetInstance():CheckBindSuit(self.suitInfo.cfg.id, self.data.uid)
            self.cardItem:SetSelectGou(isgou)
            self.cardItem:isHave(true)
        end
    else
        self.go_table.trans_root:SetActiveE(0)
        if ActiveCell >= index and self.suitInfo.isActive then
            self.go_table.obj_lock:SetActiveE(0)
            self.go_table.aorimage_add:SetActiveE(1)
        else
            self.go_table.obj_lock:SetActiveE(1)
            self.go_table.aorimage_add:SetActiveE(0)
            if cardCellStarLevel[index] == 0 then
                self.go_table.aortext_unlocklevel.text = _G.GetLangPackValue(90033800042)
            else
                self.go_table.aortext_unlocklevel.text = _G.GetLangPackValue(90022300026, cardCellStarLevel[index])
            end
        end
    end
end

---设置卡牌置灰
---@param gray boolean 是否置灰
---@param tips number 点击tipsid
function SpoilsCardItem:SetGray(gray, tips)
    self.go_table.obj_gray:SetActiveE(gray and 1 or 0)
    self.grayTipsID = gray and tips or 0
    if self.cardItem then
        -- self.cardItem:SetGray(gray)
        if gray then
        end
    else
        if gray then
            self.grayTag = true
        end
    end
end

return SpoilsCardItem

--endregion
