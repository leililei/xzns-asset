local SpoilsModel = require("SpoilsModel")
local SpoilsNet = require("SpoilsNet")

---@class SpoilsRecycleView : UIBaseView	战利品回收养成 余烬淬炼
---@field public go_table SpoilsRecycleView_GoTable GoTable
---@field public CurRecycleCfg spoils_technology 当前选中升级项
local SpoilsRecycleView = _G.BaseClass("SpoilsRecycleView", _G.UIBaseView)

function SpoilsRecycleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsRecycleView:OnCreate()
    self.CurTag = 1
    self.CurOrder = _G.SpoilsQuilty.cheng
    self.Uping = false

    self.ChooseList = {}
    self.ChoooItems = {}

    self.V2 = _G.Vector2.New(0, 0)
    self.camera = _G.UIManager:GetInstance().UICamera
    self.NormalLayer = _G.UIManager:GetInstance().NormalLayer:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))

    self.Quility = {
        [_G.SpoilsQuilty.cheng] = "ui_js_txk_cheng",
        [_G.SpoilsQuilty.hong] = "ui_js_txk_hong",
        [_G.SpoilsQuilty.cai] = "ui_js_txk_cai"
    }

    self.RecycleCfgs = {}
    for _, v in pairs(_G.ConfigManager.spoils_technology) do
        self.RecycleCfgs[v.Sort] = v
    end

    self.CurRecycleCfg = self.RecycleCfgs[self.CurTag]
    self.go_table.scrollloophorizontal_List:InitItemData(
        0,
        _G.handler(self, self.RefreshSpoilsItem)
    )

    self:CheckToggleRedPoint()

    self:RefreshEmbers()

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_gotochoose, true)

    self:AddListener(_G.eSpoilsDraw.SpoilsDrawEnd, self.OnSpoilsDrawEnd)
    self:AddListener(_G.eItemUpdata.Updata, self.OnSpoilsDrawEnd)
end

function SpoilsRecycleView:OnSpoilsDrawEnd()
    self:CheckToggleRedPoint()
end

function SpoilsRecycleView:RefreshEmbers()
    self.go_table.aorrawimage_icon:LoadImage(self.CurRecycleCfg.Icon)

    local level, level_sid, exp = SpoilsModel:GetInstance():GetRecyclLevelAndExp(self.CurRecycleCfg.id)

    self.CurLevel = level
    self.CurLevelCfg = _G.ConfigManager.spoils_technology_info[level_sid]
    self.CurExp = exp

    local showLevel = self.CurLevelCfg.Level_show

    for i = 1, #self.CurRecycleCfg.Node_preview do
        if self.CurLevel <= self.CurRecycleCfg.Node_preview[i] then
            local levelsid = SpoilsModel:GetInstance():GetRecyclLevelSidByLevel(self.CurRecycleCfg.id,
                self.CurRecycleCfg.Node_preview[i])
            local levelcfg = _G.ConfigManager.spoils_technology_info[levelsid]

            self.go_table.aortext_allskillactive.text = _G.GetLangPackValue(90033901006, levelcfg.Level_show) ..
                _G.GetLangPackValue(90033901007, _G.AttributeClassManager.GetAttrbuteDes(levelcfg.Attribute_show))
            break
        end
    end

    if level >= self.CurRecycleCfg.Level_max then
        ---已满级
        self.go_table.aortext_skilllevel.text = showLevel
        self.go_table.aortext_level.text = _G.GetLangPackValue(90033901005, showLevel)

        self.go_table.aortext_curLevel.text = _G.GetLangPackValue(90033901018, showLevel)
        self.go_table.aortext_nextLevel.text = _G.GetLangPackValue(90033901018, showLevel + 1)

        self.go_table.aortext_curjdlevel.text = _G.GetLangPackValue(90033901018, showLevel)
        self.go_table.aortext_nextjdlevel.text = _G.GetLangPackValue(90033901018, showLevel + 1)

        self.go_table.slider_propress.value = exp / self.CurLevelCfg.Number
        self.NextLevelCfg = _G.ConfigManager.spoils_technology_info[level_sid]

        self.go_table.aortext_Slider.text = exp .. "/" .. self.CurLevelCfg.Number
    else
        self.go_table.aortext_skilllevel.text = showLevel
        self.go_table.aortext_level.text = _G.GetLangPackValue(90033901005, showLevel)

        self.go_table.aortext_curLevel.text = _G.GetLangPackValue(90033901018, showLevel)
        self.go_table.aortext_nextLevel.text = _G.GetLangPackValue(90033901018, showLevel + 1)

        self.go_table.aortext_curjdlevel.text = _G.GetLangPackValue(90033901018, showLevel)
        self.go_table.aortext_nextjdlevel.text = _G.GetLangPackValue(90033901018, showLevel + 1)

        self.go_table.slider_propress.value = exp / self.CurLevelCfg.Number

        self.go_table.aortext_Slider.text = exp .. "/" .. self.CurLevelCfg.Number

        self.NextLevelCfg = _G.ConfigManager.spoils_technology_info
            [SpoilsModel:GetInstance():GetRecyclLevelSidByLevel(self.CurRecycleCfg.id, self.CurLevel + 1)]
    end

    self:ShowProp()
end

function SpoilsRecycleView:ShowPropEffect()
    local prop = { "atk", "max_hp", "bre", "def" }

    for i, v in ipairs(prop) do
        local tran = self.go_table.obj_PropContent:GetChildE(i - 1)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            tb.obj_effect:SetActiveE(0)
            if nil == tb.propeff then
                tb.propeff = 1
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_WarTechnologyUpView_once,
                    tb.obj_effect,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                        end
                    end
                )
            end
            tb.obj_effect:SetActiveE(1)
        end
    end
end
function SpoilsRecycleView:ShowSliderEffect()
    self.go_table.obj_jindueffect:SetActiveE(0)
    self.go_table.obj_jindueffect:SetActiveE(1)
    _G.DelayDo(1,function()
        if not self:IsNil() then
            self.go_table.obj_jindueffect:SetActiveE(0)
        end
    end)
end

function SpoilsRecycleView:ShowProp()
    self.propList = {}

    local prop = { "atk", "max_hp", "bre", "def" }

    for i, v in ipairs(prop) do
        local tran = self.go_table.obj_PropContent:GetChildE(i - 1)
        if tran then
            local data = self.CurLevelCfg.Attribute[i]
            local nextdata = self.NextLevelCfg.Attribute[i]
            if data or nextdata then
                local tb = _G.GetAutoGoTable(tran)
                tran:SetActiveE(1)

                if data then
                    local attrKey = data[1]
                    local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrKey].ID]
                        .name)
                    local attrType = _G.tonumber(data[2])
                    local attrValue = _G.tonumber(data[3])

                    if attrType == 1 then
                        if _G.AttrType[attrKey].percentage == 1 then
                            tb.aortext_oldValue.text = attrValue / 100 .. "%"
                        else
                            tb.aortext_oldValue.text = attrValue
                        end
                    else
                        tb.aortext_oldValue.text = attrValue / 100 .. "%"
                    end
                else
                    tb.aortext_oldValue.text = "0"
                end

                if nextdata then
                    local attrKey = nextdata[1]
                    local attrName = _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[attrKey].ID]
                        .name)
                    local attrType = _G.tonumber(nextdata[2])
                    local attrValue = _G.tonumber(nextdata[3])

                    if attrType == 1 then
                        if _G.AttrType[attrKey].percentage == 1 then
                            tb.aortext_curValue.text = attrValue / 100 .. "%"
                        else
                            tb.aortext_curValue.text = attrValue
                        end
                    else
                        tb.aortext_curValue.text = attrValue / 100 .. "%"
                    end

                    tb.aortext_Name.text = attrName
                end
            else
                tran:SetActiveE(0)
            end
        end
    end
end

---选择卡牌后回调
---@param list [sid, num]
function SpoilsRecycleView:SelectCallBack(list)
    self.go_table.scrollloopvectical_List:UpdateCount(#list)
end

--- 检测品质子页签红点
function SpoilsRecycleView:CheckToggleRedPoint()
    self.go_table.obj_redpoint1:SetActiveE(0)
    self.go_table.obj_redpoint2:SetActiveE(0)
    self.go_table.obj_redpoint3:SetActiveE(0)

    local lists1 = SpoilsModel:GetInstance():GetOverflowByOder(_G.SpoilsQuilty.cheng)
    local max1 = SpoilsModel:GetInstance():GetStarMaxOder(_G.SpoilsQuilty.cheng)
    if max1 and #lists1 > 0 then
        self.go_table.obj_redpoint1:SetActiveE(1)
    end

    local lists2 = SpoilsModel:GetInstance():GetOverflowByOder(_G.SpoilsQuilty.hong)
    local max2 = SpoilsModel:GetInstance():GetStarMaxOder(_G.SpoilsQuilty.hong)
    if max2 and #lists2 > 0 then
        self.go_table.obj_redpoint2:SetActiveE(1)
    end

    local lists3 = SpoilsModel:GetInstance():GetOverflowByOder(_G.SpoilsQuilty.cai)
    local max3 = SpoilsModel:GetInstance():GetStarMaxOder(_G.SpoilsQuilty.cai)
    if max3 and #lists3 > 0 then
        self.go_table.obj_redpoint3:SetActiveE(1)
    end

    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.spoilsofwar.id)
end

function SpoilsRecycleView:RefreshSpoilsItem(_index, obj)
    local index = _index + 1
    local info = self.ShowChooseList[index]
    local cfg = _G.ConfigManager.item_cfg[info.key]

    local tb = _G.GetAutoGoTable(obj, _G.handler(self, self.OnSpoilsClick))
    tb.aorimage_Bg.SpriteName = self.Quility[cfg.Quality]
    tb.aorrawimage_Icon:LoadImage(cfg.Icon)
    local chooseInfo = self.ShowChooseList[index]
    tb.aortext_num.text = chooseInfo.value

    tb.aorbtn_choose:SetActiveE(0)
    self.ChoooItems[index] = obj
end

function SpoilsRecycleView:OnSpoilsClick(obj, isOn, newIndex)
    ---打开选择界面
    ---把已选择的数据再发回去

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsRecycleListView.Name, self.CurOrder,
        self.CurRecycleCfg.id,
        _G.handler(self, self.ChooseListBack), self.ChooseList)
end

---界面的销毁函数
function SpoilsRecycleView:OnDestroy()
end

---按钮点击事件在这里派发
function SpoilsRecycleView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 177)
    elseif go == self.go_table.aorbtn_prohelp then
        ---属性展示界面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsRecycleTipsView.Name, self.CurRecycleCfg.id,
            self.CurLevel)
    elseif go == self.go_table.aorbtn_onekey then
        ---一键选择
        ---数据列表
        local spoilsDataList = SpoilsModel:GetInstance():GetOverflowByOder(self.CurOrder)

        local needNum = self.CurLevelCfg.Number - self.CurExp
        for i = 1, #spoilsDataList do
            if needNum > spoilsDataList[i].value then
                local info = {}
                info.value = spoilsDataList[i].value
                info.key = spoilsDataList[i].key
                self.ChooseList[i] = info
                needNum = needNum - spoilsDataList[i].value
            else
                local info = {}
                info.value = needNum
                info.key = spoilsDataList[i].key
                self.ChooseList[i] = info
                break
            end
        end

        self:ShowList()
    elseif go == self.go_table.aorbtn_uplevel then
        if self.Uping then
            return
        end
        ---升级

        local pbData = { sid = self.CurRecycleCfg.id, consume = {} }

        for i = 1, #self.ShowChooseList do
            table.insert(pbData.consume, self.ShowChooseList[i])
        end

        self:RecordPower()
        self.lastProp = SpoilsModel:GetInstance():GetRecycleAttributeDict()

        self.Uping = true

        SpoilsNet:GetInstance():SpoilsReturnUp(pbData, _G.handler(self, self.UpdateLevelRecycle))
    elseif go == self.go_table.aorbtn_clickgotochoose then
        ---选择碎片
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsRecycleListView.Name, self.CurOrder,
            self.CurRecycleCfg.id,
            _G.handler(self, self.ChooseListBack))
    elseif name == "@_obj_Toggle1" then
        if isOn then
            self.CurTag        = 1
            self.CurRecycleCfg = self.RecycleCfgs[self.CurTag]
            self.CurOrder      = _G.SpoilsQuilty.cheng
            self:RefreshEmbers()
            self.ChooseList = {}
            self:ShowList()
        end
    elseif name == "@_obj_Toggle2" then
        if isOn then
            self.CurTag        = 2
            self.CurRecycleCfg = self.RecycleCfgs[self.CurTag]
            self.CurOrder      = _G.SpoilsQuilty.hong
            self:RefreshEmbers()
            self.ChooseList = {}
            self:ShowList()
        end
    elseif name == "@_obj_Toggle3" then
        if isOn then
            self.CurTag        = 3
            self.CurRecycleCfg = self.RecycleCfgs[self.CurTag]
            self.CurOrder      = _G.SpoilsQuilty.cai
            self:RefreshEmbers()
            self.ChooseList = {}
            self:ShowList()
        end
    end
end

function SpoilsRecycleView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function SpoilsRecycleView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

function SpoilsRecycleView:UpdateLevelRecycle(msg)
    if msg.ack ~= 1 then
        self.Uping = false
        return
    end
    if self.curdjdotwwen then
        self.curdjdotwwen:Kill(true)
        self.curdjdotwwen = nil
    end
    if self.nextdjdotwwen then
        self.nextdjdotwwen:Kill(true)
        self.nextdjdotwwen = nil
    end
    self.go_table.obj_yulanjdobj:SetActiveE(0)
    self.go_table.obj_jdobj:SetActiveE(1)
    for i = 1, #self.ChoooItems do
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_zzkj_jindutiaoglow,
            self.go_table.obj_upeffect,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                end

                local x0, y0, z0 = self.ChoooItems[i]:GetPosition()

                local nx, ny = self.camera:WorldToScreenPointE(x0, y0, z0)

                self.V2:Set(nx, ny)

                local _, outPos =
                    _G.CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(self.NormalLayer, self.V2,
                        self.camera)

                trans:SetLocalPosition(outPos.x + 49, outPos.y - 49, 0)

                local x, y, z = self.go_table.slider_propress:GetLocalPosition()
                trans:DOLocalMove(x, y, z, 1):SetEase(_G.CS.DG.Tweening.Ease.InOutQuint):OnComplete(
                    function()
                        _G.DestroyObject(trans)

                        local exp = self.CurExp
                        for i = 1, #self.ShowChooseList do
                            exp = exp + self.ShowChooseList[i].value

                            _G.StorageManager:GetInstance():ConsumeItem(self.ShowChooseList[i].key, 0,
                                self.ShowChooseList[i].value)
                        end

                        local newLevel = SpoilsModel:GetInstance():SetRecyclLevelAndExp(self.CurRecycleCfg.id,
                            self.CurLevel, exp)
                        if newLevel > self.CurLevel then
                            _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Spoils)
                            self:ShowPowerUp()

                            local curProp = SpoilsModel:GetInstance():GetRecycleAttributeDict()
                            _G.UIUtils.ShowPropUp(nil, self.lastProp, nil, { prop = curProp })

                            self:ShowPropEffect()
                            self:ShowSliderEffect()
                        end

                        self:RefreshEmbers()
                        self.ChooseList = {}
                        self:ShowList()
                        self:CheckToggleRedPoint()

                        _G.Events:GetInstance():Broadcast(_G.eSpoilsRecycle.SpoilsUpLevelRefresh)
                        self.Uping = false
                    end
                )
            end

        )
    end
end

function SpoilsRecycleView:ChooseListBack(chooseList)
    self.ChooseList = chooseList
    self:ShowList()
end

function SpoilsRecycleView:ShowList()
    self.ShowChooseList = {}
    for i = 1, #self.ChooseList do
        if self.ChooseList[i].value > 0 then
            table.insert(self.ShowChooseList, self.ChooseList[i])
        end
    end

    local hasexp = #self.ShowChooseList > 0
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_gotochoose, not hasexp)

    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_onekey, not hasexp)

    if hasexp then
        self.go_table.obj_yulanjdobj:SetActiveE(1)
        self.go_table.obj_jdobj:SetActiveE(0)

        self:ShowYulanExp()
    else
        if self.curdjdotwwen then
            self.curdjdotwwen:Kill(true)
            self.curdjdotwwen = nil
        end
        if self.nextdjdotwwen then
            self.nextdjdotwwen:Kill(true)
            self.nextdjdotwwen = nil
        end

        self.go_table.obj_yulanjdobj:SetActiveE(0)
        self.go_table.obj_jdobj:SetActiveE(1)
    end

    local sr = self.go_table.scrollloophorizontal_List:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    local glg = self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))

    glg.enabled = false
    if #self.ShowChooseList > 5 then
        sr.horizontal = true
        glg.enabled = true
    else
        sr.horizontal = false
        glg.enabled = true
    end

    self.ChoooItems = {}

    self.go_table.scrollloophorizontal_List:UpdateCount(#self.ShowChooseList)
end

function SpoilsRecycleView:ShowYulanExp()
    local exp = self.CurExp
    for i = 1, #self.ShowChooseList do
        exp = exp + self.ShowChooseList[i].value
    end

    local newlevel, newexp, level_sid = SpoilsModel:GetInstance():YulanRecyclLevelAndExp(self.CurRecycleCfg.id,
        self.CurLevel, exp)

    local levelCfg = _G.ConfigManager.spoils_technology_info[level_sid]

    self.go_table.aortext_yulancurjdlevel.text = _G.GetLangPackValue(90033901018, self.CurLevelCfg.Level_show)
    self.go_table.aortext_yulannextjdlevel.text = _G.GetLangPackValue(90033901018, levelCfg.Level_show)

    if newlevel > self.CurLevel then
        self.go_table.slider_yulanpropress.value = 1
    else
