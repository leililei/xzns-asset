local base = require "SpoilsTipView"
---@class SpoilsUpStarTipView : UIBaseView	中文描述
---@field public go_table SpoilsUpStarTipView_GoTable GoTable
local SpoilsUpStarTipView = _G.BaseClass("SpoilsUpStarTipView", base)

---展示属性
---@param data SpoilsData
function SpoilsUpStarTipView:ShowPropByCfg(data)
    local attrDic = data:GetAttributeBaseDict()
    data:CalculatePower()
    local power = "<color=#fc9948>" .. data.power .. "</color>"
    self.go_base.aortext_power.text = _G.GetLangPackValue(90020100027) .. power
    self:ShowProp(attrDic,data)
end
---展示属性变化
---@param attribute AttributeClass
---@param data SpoilsData
function SpoilsUpStarTipView:ShowProp(attribute,data)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local numStr, num, key, showList
    local growth = data.cfg.att_growth[data.star + 1] / 10000
    local growthOld = data.cfg.att_growth[data.star] / 10000
    showList =AttributeClassManager:GetChangeAttrList(attribute)
    _G.SortList(
            showList,
            function(a)
                return  _G.AttrType[a].sortid
            end
    )
    local otherattr=attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    for i = 1, #showList do
        key=showList[i]
        if table.ContainsKey(otherattr,key) then
            num = otherattr.num
            if _G.AttrType[key].percentage == 1 then
                num =  _G.Mathf.RoundToInt(num * growth) * 100
                num = _G.GameUtil.FormatNum(num)
                num = tostring(num) .. "%"
                numStr = "<color=#6effc6>" .. num .. "</color>"
            else
                local numOld = _G.math.floor(_G.Mathf.RoundToInt(num * growthOld))
                numOld = _G.GameUtil.NumberWY(numOld)
                numStr = numOld
                if growth > 1 then
                    local addNum = _G.math.floor(_G.Mathf.RoundToInt((growth - growthOld)*num))
                    numStr = numStr.. "<color=#5bdf99>+" .. (_G.GameUtil.NumberWY(addNum)) .. "</color>"
                end
            end
            self:ShowPropItem(_G.AttrType[key].des,numStr)
        end
    end
    for i = 1, #showList do
        key=showList[i]
        if table.ContainsKey(Percentattr,key) then
            num = Percentattr.num
            num =  _G.Mathf.RoundToInt(num * growth) * 100
            num = _G.GameUtil.FormatNum(num)
            num = tostring(num) .. "%"
            numStr = "<color=#6effc6>" .. num .. "</color>"
            self:ShowPropItem(G.GetLangPackValue(90033800108,_G.AttrType[key].des),numStr)
        end
    end
end
function SpoilsUpStarTipView:ShowPropItem(name,numstr)
    local tb, tran
    tran = _G.InstantiateObject(self.go_base.obj_BaseProp, self.go_base.obj_PropContent)
    tb = _G.GetAutoGoTable(tran)
    tb.aortext_Name.text = name
    tb.aortext_Num.text = numstr
end

return SpoilsUpStarTipView