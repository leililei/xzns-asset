local SpoilsModel = require("SpoilsModel")
local SpoilsCardItem = require("SpoilsCardItem")

---@class SpoilsSuitView : UIBaseView	羁绊
---@field public go_table SpoilsSuitView_GoTable GoTable
local SpoilsSuitView = _G.BaseClass("SpoilsSuitView", _G.UIBaseView)

function SpoilsSuitView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsSuitView:OnCreate()
    self.ToggleOrder = _G.SpoilsQuilty.cai
    self.cardItemList = {}

    self.ExtendText = self.go_table.obj_goto:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))

    self.ExtendDescText = self.go_table.obj_desc:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.ExtendDescText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefSkillClick))

    self.go_table.scrollloopvectical_List:InitItemData(
        0,
        _G.handler(self, self.RefreshSuitSkillItem)
    )

    self.go_table.scrollloophorizontal_card:InitItemData(0,
        _G.handler(self, self.RefreshAllCardItem)
    )
    self:UpdateAllList()

    self:CheckToggleRedPoint()

    self:AddListener(_G.eSpoilsUpStar.SpoilsUpStarRefresh, self.OnUpStar)
end

function SpoilsSuitView:OnUpStar()
    self:UpdateAllList()
    self:CheckToggleRedPoint()
end

function SpoilsSuitView:RefreshSuit()
    self.SuitSkillList = {}
    local sslist = SpoilsModel:GetInstance():GetAllActiveSuit()
    for i = 1, #sslist do
        if sslist[i].cfg.Order == self.ToggleOrder  and _G.GlobalConditionManager.CheckConditionArrays(sslist[i].cfg.condition_type) then
            table.insert(self.SuitSkillList, sslist[i])
        end
    end
    table.sort(self.SuitSkillList, function(a, b)
        if a.isActive == b.isActive then
            return a.cfg.id < b.cfg.id
        end
        return a.isActive == true
    end)


    self.ItemList = {}
    self.ChooseSkill = 1
    self:UpdateChooseSkill()
    self:UpdateSuitInfo()
end

function SpoilsSuitView:UpdateChooseSkill()
    self.ChooseSuitInfo = self.SuitSkillList[self.ChooseSkill]

    self.CardCell = 0
    self.CardCellStarLevel = {}
    self.Cards = {}
    self.CardNum = 0

    self.ActiveCell = 0
    for i = 1, #self.ChooseSuitInfo.cfg.suit_num / 2 do
        if self.ChooseSuitInfo.suitStar >= self.ChooseSuitInfo.cfg.suit_num[(i - 1) * 2 + 1] then
            self.ActiveCell = self.ActiveCell + 1
        end
        self.CardCell = self.ChooseSuitInfo.cfg.suit_num[(i - 1) * 2 + 2]

        table.insert(self.CardCellStarLevel, self.ChooseSuitInfo.cfg.suit_num[(i - 1) * 2 + 1])
    end

    local StorageManager = _G.StorageManager:GetInstance()
    local theCards = SpoilsModel:GetInstance().SpoilsSuitDatas[self.ChooseSuitInfo.cfg.id].cards
    for i = 1, #theCards do
        ---@type CardData
        local card = StorageManager:GetDatasByUid(_G.StorageID.Card, theCards[i])
        if not _G.table.isEmptyOrNil(card) then
            table.insert(self.Cards, theCards[i])
        end
    end

    self.CardNum = self.ChooseSuitInfo.cfg.suit_type == 2 and self.CardCell or 0

    if self.ChooseSuitInfo.cfg.suit_type == 1 then
        self.go_table.aortext_allskillactive:SetActiveE(1)
    else
        self.go_table.aortext_allskillactive:SetActiveE(0)
    end
end

function SpoilsSuitView:OnHrefSkillClick(id)
    local weight, height = 0, 0
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

function SpoilsSuitView:OnHrefClick(herfParam)
    if _G.tonumber(herfParam) == 1 then
        if _G.AppSetting.DEBUG then
            _G.Log("激活战利品链接！")
        end
        _G.Events:GetInstance():Broadcast(_G.eSpoils.SpoilsGotoActive, self.ChooseSuitInfo.cfg)
    end
end

function SpoilsSuitView:UpdateSuitInfo()
    local skillcfg = _G.ConfigManager.card_skills_cfg[self.ChooseSuitInfo.skillid]

    self.go_table.aorrawimage_icon:LoadImage(skillcfg.icon)
    self.go_table.aortext_skilllevel.text = self.ChooseSuitInfo.suitStar
    self.go_table.aortext_Name.text = _G.GetLangPackValue(skillcfg.name1)
    --self.go_table.aortext_desc.text = _G.GetLangPackValue(skillcfg.describe1)
    self.ExtendDescText.text = _G.GetLangPackValue(skillcfg.describe1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skillxd, self.ChooseSuitInfo.isLimit > 0)

    if self.ChooseSuitInfo.suitStar >= 10 then
        self.go_table.aorimage_ismax:SetActiveE(1)
        self.go_table.obj_goto:SetActiveE(0)
        self.go_table.aorimage_active:SetActiveE(0)
        self.go_table.aorimage_skillxd:SetGray(false)
    else
        if self.ChooseSuitInfo.isActive then
            self.go_table.aorimage_active:SetActiveE(0)
            self.go_table.aorimage_skillxd:SetGray(false)
            self.ExtendText.text = _G.GetLangPackValue(90033900068)
        else
            self.go_table.aorimage_active:SetActiveE(1)
            self.go_table.aorimage_skillxd:SetGray(true)
            self.ExtendText.text = _G.GetLangPackValue(90033900067)
        end
        self.go_table.aorimage_ismax:SetActiveE(0)
        self.go_table.obj_goto:SetActiveE(1)
    end
end

function SpoilsSuitView:OnCardClick(index)
    local carduid = self.Cards[index]
    if not carduid then
        if index <= self.CardCell then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsSelectHeroView.Name, self.Cards,
                self.ActiveCell, self.ChooseSuitInfo.cfg.id,
                _G.handler(self, self.SelectCallBack))
        end
    else
        if index <= self.CardCell then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsSelectHeroView.Name, self.Cards,
                self.ActiveCell, self.ChooseSuitInfo.cfg.id,
                _G.handlerbind(self, self.SelectCallBack, index))
        end
    end
end

---选择卡牌后回调
---@param cards [uid]
function SpoilsSuitView:SelectCallBack(cards)
    SpoilsModel:GetInstance():SkillBindCard(self.ChooseSuitInfo.cfg.id, cards, function()
        self:UpdateChooseSkill()
        if self.ChooseSuitInfo.cfg.suit_type == 1 then
            self.go_table.scrollloophorizontal_card:UpdateCount(0)
            self.go_table.aortext_allskillactive:SetActiveE(1)
        else
            self.go_table.scrollloophorizontal_card:UpdateCount(self.CardNum)
            self.go_table.aortext_allskillactive:SetActiveE(0)
        end

        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsSuidBindCard.id)

        self:CheckToggleRedPoint()
    end)
end

--- 检测品质子页签红点
function SpoilsSuitView:CheckToggleRedPoint()
    self.go_table.obj_redpoint1:SetActiveE(0)
    self.go_table.obj_redpoint2:SetActiveE(0)
    self.go_table.obj_redpoint3:SetActiveE(0)

    local qlist = SpoilsModel:GetInstance():GetBindCardsResidueofQ()

    if qlist[_G.SpoilsQuilty.cai] then
        self.go_table.obj_redpoint1:SetActiveE(1)
    end
    if qlist[_G.SpoilsQuilty.hong] then
        self.go_table.obj_redpoint2:SetActiveE(1)
    end
    if qlist[_G.SpoilsQuilty.cheng] then
        self.go_table.obj_redpoint3:SetActiveE(1)
    end
end

function SpoilsSuitView:RefreshAllCardItem(index, obj)
    local id = obj:GetInstanceID()
    local item = self.cardItemList[id]
    if not item then
        item = SpoilsCardItem.New(
            obj,
            _G.handler(self, self.OnCardClick)
        )
        self.cardItemList[id] = item
    end
    index = index + 1

    local carduid = self.Cards[index]
    if carduid then
        local carddata = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, carduid)

        item:Show(index, carddata, self.ChooseSuitInfo, #self.Cards, self.CardCell, self.CardCellStarLevel,
            self.ActiveCell)
    else
        item:Show(index, nil, self.ChooseSuitInfo, #self.Cards, self.CardCell, self.CardCellStarLevel, self.ActiveCell)
    end
end

function SpoilsSuitView:RefreshSuitSkillItem(index, obj)
    local newIndex = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSuitSkillClick, newIndex))
    local info = self.SuitSkillList[newIndex]

    table.insert(self.ItemList, tb)

    local skillcfg = _G.ConfigManager.card_skills_cfg[info.skillid]

    tb.aorrawimage_icon:LoadImage(skillcfg.icon)
    tb.aorimage_active:SetActiveE(not info.isActive and 1 or 0)
    tb.aortext_skilllevel.text = info.suitStar
    _G.GameUtil.SetActiveByCondition(tb.aorimage_skillxd, info.isLimit > 0)

    _G.GameUtil.SetActiveByCondition(tb.aorimage_choose, newIndex == self.ChooseSkill)
end

function SpoilsSuitView:OnSuitSkillClick(obj, isOn, newIndex)
    if self.ChooseSkill == newIndex then
        return
    end
    _G.GameUtil.SetActiveByCondition(self.ItemList[self.ChooseSkill].aorimage_choose, false)
    self.ChooseSkill = newIndex

    _G.GameUtil.SetActiveByCondition(self.ItemList[self.ChooseSkill].aorimage_choose, true)

    self:UpdateChooseSkill()

    self:UpdateSuitInfo()

    local info = self.SuitSkillList[newIndex]
    if info.cfg.suit_type == 1 then
        self.go_table.scrollloophorizontal_card:UpdateCount(0)
        self.go_table.aortext_allskillactive:SetActiveE(1)
    else
        self.go_table.scrollloophorizontal_card:UpdateCount(self.CardNum)
        self.go_table.aortext_allskillactive:SetActiveE(0)
    end
end

---界面的销毁函数
function SpoilsSuitView:OnDestroy()
end

---按钮点击事件在这里派发
function SpoilsSuitView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 177)
    elseif go == self.go_table.aorbtn_suithelp then
        local data = self.ChooseSuitInfo.cfg
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsSuitInfoView.Name, data)
    elseif name == "@_obj_Toggle1" then
        if isOn then
            self.ToggleOrder = _G.SpoilsQuilty.cai
            self:UpdateAllList()
        end
    elseif name == "@_obj_Toggle2" then
        if isOn then
            self.ToggleOrder = _G.SpoilsQuilty.hong
            self:UpdateAllList()
        end
    elseif name == "@_obj_Toggle3" then
        if isOn then
            self.ToggleOrder = _G.SpoilsQuilty.cheng
            self:UpdateAllList()
        end
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrSpoilsPanel.Name)
    end
end

function SpoilsSuitView:UpdateAllList()
    self:RefreshSuit()
    self.go_table.scrollloopvectical_List:UpdateCount(#self.SuitSkillList)
    self.go_table.scrollloophorizontal_card:UpdateCount(self.CardNum)
end

return SpoilsSuitView
