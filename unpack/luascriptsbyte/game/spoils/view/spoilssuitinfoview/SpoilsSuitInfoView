local SpoilsModel = require "SpoilsModel"

local base = require "EventViewBase"
local CommonTipManager = require("CommonTipManager")
---@class SpoilsSuitInfoView : UIBaseView	中文描述
---@field public go_table SpoilsSuitInfoView_GoTable GoTable
---@field suit spoils_suit_cfg
local SpoilsSuitInfoView = _G.BaseClass("SpoilsSuitInfoView", base)

function SpoilsSuitInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Quility = {
        [4] = "ui_js_txk_zi",
        [5] = "ui_js_txk_cheng",
        [6] = "ui_js_txk_hong",
        [8] = "ui_js_txk_cai"
    }
end

---界面的入口函数
function SpoilsSuitInfoView:OnCreate(suit)
    self.suit = suit
    self:InitView()
end

function SpoilsSuitInfoView:InitView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.suit.Name)

    local poilsNum = self.go_table.obj_allspoils:GetChildCountE()

    local curNum = 0
    local isLimit = 0
    local suitStar = 99
    for i = 1, poilsNum do
        local spoils = self.go_table.obj_allspoils:GetChildE(i - 1)
        local sid = self.suit.spoils_id[i]
        local spoilsTb = _G.GetAutoGoTable(spoils, _G.handlerbind(self, self.OnClickSpoils, sid))
        if sid then
            spoils:SetActiveE(1)
            local sp = SpoilsModel:GetInstance():GetData(sid)

            if sp:GetIsActive() then
                curNum = curNum + 1
            end

            local star = sp:GetStar()
            if star < suitStar then
                suitStar = star
            end
            local isActive = sp:GetIsActive()

            spoilsTb.aortext_name.text = _G.GetLangPackValue(sp.cfg.Name)
            local cfg= _G.ConfigManager.item_cfg[sp.cfg.item]
            spoilsTb.aorrawimage_icon:LoadImage(cfg.Icon)
            spoilsTb.aorimage_active:SetActiveE(not isActive and 1 or 0)
            spoilsTb.obj_stars:SetActiveE(isActive and 1 or 0)
            spoilsTb.aorimage_quelity.SpriteName = self.Quility[sp.cfg.Order]
            local starNum = spoilsTb.obj_stars:GetChildCountE()
            local star = sp:GetStar()
            if star == 0 then
                for level = 2, starNum do
                    spoilsTb.obj_stars:GetChildE(level - 1):SetActiveE(0)
                end
            else
                local tmpstar = star % 5
                local blstar = star / 5
                if tmpstar == 0 then
                    tmpstar = star
                end
                for level = 2, starNum do
                    local obj = spoilsTb.obj_stars:GetChildE(level - 1)
                    local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
                    if level - 1 <= tmpstar then
                        obj:SetActiveE(1)
                        if blstar > 1 then
                            image.SpriteName = "ui_img_xing_hong"
                        else
                            image.SpriteName = "ui_img_xing"
                        end
                    else
                        obj:SetActiveE(0)
                    end
                end
            end
            if sp.cfg.limit == 1 then
                _G.GameUtil.SetActiveByCondition(spoilsTb.aorimage_skillxd, true)
                isLimit = isLimit + 1
            else
                _G.GameUtil.SetActiveByCondition(spoilsTb.aorimage_skillxd, false)
            end
        else
            spoils:SetActiveE(0)
        end
    end
    self.suitstar = suitStar
    self.suitactive = curNum >= #self.suit.spoils_id

    self.go_table.scrollloopvectical_stareff:InitItemData(#self.suit.skill_id, _G.handler(self, self.RefreshList))
    self.go_table.scrollloopvectical_stareff:UpdateAllItem()
    self.go_table.scrollloopvectical_stareff:ScrollToIndex(0)
    local skillid
    if curNum >= #self.suit.spoils_id then
        ---激活了套装
        if suitStar >= 0 then
            skillid = self.suit.skill_id[suitStar + 1]
            if nil == skillid then
                skillid = self.suit.skill_id[#self.suit.skill_id]
            end
        else
            skillid = self.suit.skill_id[1]
        end
    else
        skillid = self.suit.skill_id[1]
    end

    local skillcfg = _G.ConfigManager.card_skills_cfg[skillid]

    self.go_table.aorrawimage_icon:LoadImage(skillcfg.icon)
    self.go_table.aortext_skilllevel.text = suitStar
    self.go_table.aortext_name.text = _G.GetLangPackValue(skillcfg.name1)
    self.go_table.aortext_desc.text = _G.GetLangPackValue(self.suit.Desc)
    self.go_table.aortext_propress.text = _G.GetLangPackValue(self.suit.Name) ..
        "(" .. curNum .. "/" .. #self.suit.spoils_id .. ")"
    if isLimit then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skillxd, isLimit > 0)
    end
end

---刷新列表
function SpoilsSuitInfoView:RefreshList(index, obj)
    index = index + 1
    local skillid = self.suit.skill_id[index]
    ---@type SpoilsSuitInfoView._obj_item_GoTable
    local tb = GetAutoGoTable(obj)
    obj:SetName("$_obj_item_" .. index)

    local skillcfg = _G.ConfigManager.card_skills_cfg[skillid]

    tb.ExtendText = tb.obj_desc:GetComponentE(_G.typeof(_G.CS.ExtendText))
    tb.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))
    tb.ExtendText.text = _G.GetLangPackValue(skillcfg.describe1)

    if self.suitactive then
        if self.suitstar >= index - 1 then
            tb.aortext_title.color = require "CardInfoManager".GetColorFromRGB("488146")
            tb.ExtendText.color = require "CardInfoManager".GetColorFromRGB("488146")
            tb.aortext_leveldesc.color = require "CardInfoManager".GetColorFromRGB("488146")
        else
            tb.aortext_title.color = require "CardInfoManager".GetColorFromRGB("343a48")
            tb.ExtendText.color = require "CardInfoManager".GetColorFromRGB("818389")
            tb.aortext_leveldesc.color = require "CardInfoManager".GetColorFromRGB("343a48")
        end
    else
        tb.aortext_title.color = require "CardInfoManager".GetColorFromRGB("343a48")
        tb.ExtendText.color = require "CardInfoManager".GetColorFromRGB("818389")
        tb.aortext_leveldesc.color = require "CardInfoManager".GetColorFromRGB("343a48")
    end

    local starNum = tb.obj_stars:GetChildCountE()
    local star = index - 1
    if star == 0 then
        for level = 2, starNum do
            tb.obj_stars:GetChildE(level - 1):SetActiveE(0)
        end

        tb.aortext_title.text = _G.GetLangPackValue(90033900022)
        tb.aortext_leveldesc.text = _G.GetLangPackValue(90033900024, _G.GetLangPackValue(skillcfg.name1))
    else
        tb.aortext_title.text = _G.GetLangPackValue(90033900023, star)
        tb.aortext_leveldesc.text = _G.GetLangPackValue(90033900025, _G.GetLangPackValue(skillcfg.name1), index)


        local tmpstar = star % 5
        local blstar = star / 5
        if tmpstar == 0 then
            tmpstar = star
        end
        for level = 2, starNum do
            local obj = tb.obj_stars:GetChildE(level - 1)
            local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if level - 1 <= tmpstar then
                obj:SetActiveE(1)
                if blstar > 1 then
                    image.SpriteName = "ui_img_xing_hong"
                else
                    image.SpriteName = "ui_img_xing"
                end
            else
                obj:SetActiveE(0)
            end
        end
    end
end

function SpoilsSuitInfoView:OnHrefClick(id)
    local weight, height = 0, 0
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

---Item点击事件
