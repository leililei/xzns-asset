---按钮点击事件在这里派发
function SpoilsSuitInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    elseif go == self.go_table.aorbtn_closeAll then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 177)
    end
end

---界面的销毁函数
function SpoilsSuitInfoView:OnDestroy()
    self:RemoveListener(_G.eSpoilsUpStar.SpoilsUpStarRefresh, self.RefreshView, self)
end

return SpoilsSuitInfoView
