    local sp = SpoilsModel:GetInstance():GetData(sid)

    -- if data:IsCanGet() then
    --     SpoilsModel:GetInstance():UpStar(data.sid, 0, false, _G.handler(self, self.RefreshView))
    -- else
    -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsInfoView.Name, sp)
    -- end
    local isActive = sp:GetIsActive()
    CommonTipManager:GetInstance():OpenSpoilsTip(self.gameObject, sp.cfg.id, nil, nil, not isActive, true)
