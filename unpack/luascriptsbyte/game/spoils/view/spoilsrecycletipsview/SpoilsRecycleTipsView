---@class SpoilsRecycleTipsView : UIBaseView
---@field public go_table SpoilsRecycleTipsView_GoTable GoTable
local SpoilsRecycleTipsView = _G.BaseClass("SpoilsRecycleTipsView", _G.UIBaseView)
local SpoilsModel = require("SpoilsModel")

function SpoilsRecycleTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsRecycleTipsView:OnCreate(sid, curlevel)
    self.sid = sid
    self.curlevel = curlevel
    self.cfg = _G.ConfigManager.spoils_technology[sid]
    self:InitView()
end

function SpoilsRecycleTipsView:InitView()
    ---@type SpoilsRecycleTipsView._obj_attrItem_GoTable|SpoilsRecycleTipsView._obj_skillItem_GoTable
    local tb
    local obj, name, value
    self.go_table.obj_attribute:SetActiveE(0)
    local skillLock
    for i = 1, #self.cfg.Node_preview do
        local levelsid = SpoilsModel:GetInstance():GetRecyclLevelSidByLevel(self.sid, self.cfg.Node_preview[i])
        local levelcfg = _G.ConfigManager.spoils_technology_info[levelsid]
        if levelcfg then
            obj = _G.InstantiateObject(self.go_table.obj_lockItem, self.go_table.obj_locks)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)

            tb.aortext_name.text = _G.GetLangPackValue(90033901006, levelcfg.Level_show)
            tb.aortext_Des.text = _G.GetLangPackValue(90033901007,
                _G.AttributeClassManager.GetAttrbuteDes(levelcfg.Attribute_show))
            skillLock = self.cfg.Node_preview[i] > self.curlevel
            tb.aortext_name.color = require("CardInfoManager").GetColorFromRGB(skillLock and "575757" or "BB3D00")
            tb.aortext_Des.color = require("CardInfoManager").GetColorFromRGB(skillLock and "1F1F1F" or "351B0A")
            tb.aorimage_bg:SetGray(skillLock)
            tb.obj_lock:SetActiveE(skillLock and 1 or 0)
        end
    end
end

---按钮点击事件在这里派发
function SpoilsRecycleTipsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function SpoilsRecycleTipsView:OnDestroy()
end

return SpoilsRecycleTipsView
