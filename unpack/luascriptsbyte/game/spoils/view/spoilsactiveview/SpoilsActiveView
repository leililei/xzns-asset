local SpoilsModel = require "SpoilsModel"

local base = require "EventViewBase"
---@class SpoilsActiveView : UIBaseView    升星界面
---@field public go_table SpoilsActiveView_GoTable GoTable
local SpoilsActiveView = _G.BaseClass("SpoilsActiveView", base)

function SpoilsActiveView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsActiveView:OnCreate(sid)
    ---@type SpoilsData
    self.sp = SpoilsModel:GetInstance():GetData(sid)
    self.go_table.aorrawimage_icon:LoadImage(self.sp.cfg.Icon,function(img)
        img:SetNativeSize()
    end)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zhanlidaoju_jihuo,
        self.go_table.obj_Eff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )

    self:ShowProp()
end

---按钮点击事件在这里派发
function SpoilsActiveView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        ---关闭按钮
        self:Close()
    end
end

function SpoilsActiveView:ShowProp()
    local attribute = self.sp:GetAttributeDict()
    self.showList={}
    local typelist=_G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    for k,v in pairs(typelist) do
        table.insert(self.showList,v.key)
    end
    _G.SortList(
            self.showList,
            function(a)
                return  -_G.AttrType[a].sortid
            end
    )
    local numStr, num, key
    local otherattr=attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    for i = 1, #self.showList do
        key=self.showList[i]
        if table.ContainsKey(otherattr,key) then
            num = otherattr[key]
            if _G.AttrType[key].percentage == 1 then
                num =  num * 100
                num = _G.GameUtil.FormatNum(num)
                numStr = tostring(num) .. "%"
            else
                local numOld = _G.math.floor(_G.Mathf.RoundToInt(num))
                numOld = _G.GameUtil.NumberWY(numOld)
                numStr = numOld
            end
            self:ShowPropItem(_G.AttrType[key].des,numStr,_G.AttrTypeIcon[key])
        end
    end
    for i = 1, #self.showList do
        key=self.showList[i]
        if table.ContainsKey(Percentattr,key) then
            num = Percentattr[key]
            num =  num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = tostring(num) .. "%"
            self:ShowPropItem(_G.string.AddColor(_G.GetLangPackValue(90033800108,_G.AttrType[key].des),"ff8331"),_G.string.AddColor(numStr,"ff8331"),_G.AttrTypeIcon[key])
        end
    end
end

function SpoilsActiveView:ShowPropItem(name,numstr,icon)
    local tb, tran
    tran = _G.InstantiateObject(self.go_table.obj_propItem,self.go_table.obj_content)
    tran:SetActiveE(1)
    tb = _G.GetAutoGoTable(tran)
    tb.aorimage_Icon.SpriteName=icon
    tb.aortext_Prop.text = name
    tb.aortext_sumProp.text = numstr
end

return SpoilsActiveView
