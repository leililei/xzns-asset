local SpoilsModel = require("SpoilsModel")

---@class SpoilsInfoView : UIBaseView    中文描述
---@field public go_table SpoilsInfoView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
---@field sp SpoilsData
local SpoilsInfoView = _G.BaseClass("SpoilsInfoView", _G.UIBaseView)

function SpoilsInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsInfoView:OnCreate(sp)
    self.sp = sp
    self:InitView()
end

---初始化页面
function SpoilsInfoView:InitView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.sp.cfg.Name)
    self.go_table.aorrawimage_spoils:LoadImage(self.sp.cfg.Icon,function(img)
        img:SetNativeSize()
    end)

    self.go_table.scrollloopvectical_propList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    self:UpdateProp()
    self:UpdateAll()
end

function SpoilsInfoView:UpdateProp()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = self.sp:GetAttributeDict()
    local nextAttribute = self.sp:GetAttributeDictNext()
    local numStr1, numStr2,num1, num2,key, showList
    showList =AttributeClassManager:GetChangeAttrList(attribute)
    local attr=attribute:GetAttrByName(_G.AttCountType.other)
    local nextattr=nextAttribute:GetAttrByName(_G.AttCountType.other)
    self.propList = {}
    for k, v in pairs(showList) do
        key=v.key
        num1=attr[key]
        num2=nextattr[key]
        if _G.AttrType[key].percentage == 1 then
            num1 = num1*100
            numStr1 = tostring(num1) .. "%"
            num2 = num2*100
            numStr2 = tostring(num2) .. "%"
        else
            numStr1 = _G.GameUtil.NumberWY(num1)
            numStr2 = _G.GameUtil.NumberWY(num2)
        end
        if _G.AttrType[key] then
            _G.table.insert(
                self.propList,
                {
                    name = _G.AttrType[key].des,
                    value = numStr1,
                    nextValue = numStr2
                }
            )
        end
    end

    attr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    nextattr=nextAttribute:GetAttrByName(_G.AttCountType.basePercent)
    for k, v in pairs(showList) do
        if _G.AttrType[key] then
            key=v.key
            num1=attr[key]
            num2=nextattr[key]
            num1 = num1*100
            numStr1 = tostring(num1) .. "%"
            num2 = num2*100
            numStr2 = tostring(num2) .. "%"
            _G.table.insert(
                    self.propList,
                    {
                        name =_G.string.AddColor( _G.GetLangPackValue(90033800108,_G.AttrType[key].des),"ff7011"),
                        value =_G.string.AddColor(numStr1,"ff7011"),
                        nextValue = _G.string.AddColor(numStr2,"ff7011")
                    }
            )
        end
    end
    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
end

function SpoilsInfoView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    if self.sp:IsMaxStar() then
        self.propList[index + 1].nextValue = _G.GetLangPackValue(90022300065)
    end
    tb.aorimage_di:SetActiveE((index%2)==0 and 1 or 0)
    tb.aortext_propName.text = self.propList[index + 1].name
    tb.aortext_curValue.text = self.propList[index + 1].value
    if tb.aortext_nextValue then
        tb.aortext_nextValue.text = self.propList[index + 1].nextValue or _G.GetLangPackValue(90033900043)
    end

    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(self.sp.cfg.Order))
    ctm:SetItemTextGradient(self.go_table.aortext_name, self.sp.cfg.Order)
    --self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor

    --tb.aorimage_di:SetActiveE((index + 1) % 2)
end

function SpoilsInfoView:UpdateAll()
    local starNum = self.go_table.obj_stars:GetChildCountE()
    local star = self.sp:GetStar()
    if star == 0 then
        for level = 2, starNum do
            self.go_table.obj_stars:GetChildE(level - 1):SetActiveE(0)
        end
    else
        local tmpstar = star % 5
        local blstar = star / 5
        if tmpstar == 0 then
            tmpstar = star
        end
        for level = 2, starNum do
            local obj = self.go_table.obj_stars:GetChildE(level - 1)
            local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if level - 1 <= tmpstar then
                obj:SetActiveE(1)
                if blstar > 1 then
                    image.SpriteName = "ui_img_xing_hong"
                else
                    image.SpriteName = "ui_img_xing"
                end
            else
                obj:SetActiveE(0)
            end
        end
    end

    local starNumNext = self.go_table.obj_starsnext:GetChildCountE()
    local starnext = self.sp:GetStar() + 1
    if self.sp:IsMaxStar() then
        starnext = self.sp.cfg.Star_max
    end
    local tmpstar = starnext % 5
    local blstar = starnext / 5
    if tmpstar == 0 then
        tmpstar = starnext
    end

    for level = 2, starNumNext do
        local obj = self.go_table.obj_starsnext:GetChildE(level - 1)
        local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
        if level - 1 <= tmpstar then
            obj:SetActiveE(1)
            if blstar > 1 then
                image.SpriteName = "ui_img_xing_hong"
            else
                image.SpriteName = "ui_img_xing"
            end
        else
            obj:SetActiveE(0)
        end
    end
    if self.sp:IsMaxStar() then
        self.go_table.aorimage_maxstar:SetActiveE(1)
        self.go_table.aorbtn_star:SetActiveE(0)
        self.go_table.obj_Matrial:SetActiveE(0)
    else
        self.go_table.aorimage_maxstar:SetActiveE(0)
        self.go_table.aorbtn_star:SetActiveE(1)
        self.go_table.obj_Matrial:SetActiveE(1)
        local datas = { { self.sp.cfg.materials_item, self.sp.cfg.material_1[self.sp:GetStar() + 2] or 0 } }

        local consumeResList = {}
        for _, v in ipairs(datas) do
            if v[2] > 0 then
                _G.table.insert(consumeResList, { v[1], false, v[2] })
            end
        end
        if not self.resConsume then
            self.resConsume = self:AddComponent(
                self.go_table.obj_Matrial,
                require("ConsumeCompont").New(self.go_table.obj_Matrial, consumeResList, nil, nil, true,
                    { textColorType = 4, showNow = true })
            )
        else
            self.resConsume:RestRs(consumeResList)
        end
    end

    local suitInfo = SpoilsModel:GetInstance():GetActiveSuitBySid(self.sp.cfg.suit_id)
    local skillcfg
    if suitInfo.skillid then
        skillcfg = _G.ConfigManager.card_skills_cfg[suitInfo.skillid]
    else
        skillcfg = _G.ConfigManager.card_skills_cfg[suitInfo.cfg.skill_id[1]]
    end

    if skillcfg then
        self.go_table.aorrawimage_icon:LoadImage(skillcfg.icon)
    end
    self.go_table.aortext_skilllevel.text = suitInfo.suitStar

    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skillxd, suitInfo.isLimit > 0)

    self.go_table.aortext_tips.text = _G.GetLangPackValue(90033900042, suitInfo.suitStar + 1)
end

---按钮点击事件在这里派发
function SpoilsInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_star then
        if not self.sp:IsCanStarUp() then
            local quickUseBox = _G.StorageManager:GetInstance():SpoilsFastCheckItem(self.sp.cfg.id, function()
                self:UpdateAll()
            end)
            if quickUseBox then
                return
            end
            --_G.JumpManager:GetInstance():Jump(221002)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.sp.cfg
            .materials_item)
        else
            local _,lastProp,curProp
            _,lastProp = SpoilsModel:GetInstance():GetAllOtherProp()
            self:RecordPower()
            local oldsuit = SpoilsModel:GetInstance():GetActiveSuitBySid(self.sp.cfg.suit_id)
            SpoilsModel:GetInstance():UpStar(self.sp.cfg.id, self.sp:GetStar() + 1, function()
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Spoils)
                self:UpdateProp()
                self:UpdateAll()
                self:ShowPowerUp()
                _,curProp = SpoilsModel:GetInstance():GetAllOtherProp()
                _G.UIUtils.ShowPropUp(nil, lastProp, nil, { prop = curProp })

                local newsuit = SpoilsModel:GetInstance():GetActiveSuitBySid(self.sp.cfg.suit_id)
                if oldsuit.skillid and newsuit.skillid and newsuit.suitStar > oldsuit.suitStar then
                    ---新数据套装成了
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsSuitUpView.Name,
                        self.sp.cfg.suit_id,
                        true, oldsuit, newsuit)

                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsSuidBindCard
                        .id)

                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                        .SpoilsCanUp.id)

                    _G.Events:GetInstance():Broadcast(_G.eSpoilsUpStar.SpoilsUpStarRefresh)
                end
            end)
        end
    elseif go == self.go_table.aorbtn_ShowTips then
        self.suitCfg = _G.ConfigManager.spoils_suit_cfg
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsSuitInfoView.Name,
            self.suitCfg[self.sp.cfg.suit_id])
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

function SpoilsInfoView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function SpoilsInfoView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

---@private
function SpoilsInfoView:OnDestroy()
end

return SpoilsInfoView
