function SpoilsMainView:CheckCanChooseIndexByQuilty(quilty)
    local suitNum = 0
    local suitDatas = {}
    for _, v in pairs(self.suitCfg) do
        if quilty == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            local channel = v.channel_id
            if #channel == 0 or _G.table.ContainsValue(channel, tonumber(_G.SDKManager:GetInstance():GetChannelId())) then
                suitNum = suitNum + 1
                suitDatas[suitNum] = v
            end
        end
    end
    for i = 1, #suitDatas do
        local data = suitDatas[i]
        for j = 1, #data.spoils_id do
            local sid = data.spoils_id[j]
            local sp = SpoilsModel:GetInstance():GetData(sid)
            if sp:IsCanActive() or sp:IsCanStarUp() then
                return i
            end
        end
    end

    return -1
end

function SpoilsMainView:CheckCanChooseIndex()
    local suitNum = 0
    local suitDatas = {}
    for _, v in pairs(self.suitCfg) do
        if _G.SpoilsQuilty.cai == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            local channel = v.channel_id
            if #channel == 0 or _G.table.ContainsValue(channel, tonumber(_G.SDKManager:GetInstance():GetChannelId())) then
                suitNum = suitNum + 1
                suitDatas[suitNum] = v
            end
        end
    end
    for i = 1, #suitDatas do
        local data = suitDatas[i]
        for j = 1, #data.spoils_id do
            local sid = data.spoils_id[j]
            local sp = SpoilsModel:GetInstance():GetData(sid)
            if sp:IsCanActive() or sp:IsCanStarUp() then
                return _G.SpoilsQuilty.cai, i - 1
            end
        end
    end

    suitNum = 0
    suitDatas = {}
    for _, v in pairs(self.suitCfg) do
        if _G.SpoilsQuilty.hong == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            local channel = v.channel_id
            if #channel == 0 or _G.table.ContainsValue(channel, tonumber(_G.SDKManager:GetInstance():GetChannelId())) then
                suitNum = suitNum + 1
                suitDatas[suitNum] = v
            end
        end
    end
    for i = 1, #suitDatas do
        local data = suitDatas[i]
        for j = 1, #data.spoils_id do
            local sid = data.spoils_id[j]
            local sp = SpoilsModel:GetInstance():GetData(sid)
            if sp:IsCanActive() or sp:IsCanStarUp() then
                return _G.SpoilsQuilty.hong, i - 1
            end
        end
    end

    suitNum = 0
    suitDatas = {}
    for _, v in pairs(self.suitCfg) do
        if _G.SpoilsQuilty.cheng == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            local channel = v.channel_id
            if #channel == 0 or _G.table.ContainsValue(channel, tonumber(_G.SDKManager:GetInstance():GetChannelId())) then
                suitNum = suitNum + 1
                suitDatas[suitNum] = v
            end
        end
    end
    for i = 1, #suitDatas do
        local data = suitDatas[i]
        for j = 1, #data.spoils_id do
            local sid = data.spoils_id[j]
            local sp = SpoilsModel:GetInstance():GetData(sid)
            if sp:IsCanActive() or sp:IsCanStarUp() then
                return _G.SpoilsQuilty.cheng, i - 1
            end
        end
    end

    return 0, 0
end

function SpoilsMainView:UpdateAll()
    ---判断是不是初始化了
    if not self.Init then
        self.go_table.scrollloopvectical_all:InitItemData(self.SuitNum, _G.handler(self, self.RefreshList))
        self.Init = true
    else
        self.go_table.scrollloopvectical_all:UpdateCount(self.SuitNum)
    end

    self.go_table.scrollloopvectical_all:ScrollToIndex(self.actionIndex)

    self:CheckToggleRedPoint()
end

function SpoilsMainView:RefreshList(index, obj)
    index = index + 1
    obj:SetName("$_obj_Item_" .. index)

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOneSuit, index))

    if tb.spoilList == nil then
        tb.spoilList = {}
    end
    for i = 1, #tb.spoilList do
        tb.spoilList[i].gameObject:SetActiveE(0)
    end
    local data = self.SuitDatas[index]

    UIUtils.RemoveChildren(tb.obj_info)

    local curNum = 0
    local isLimit = 0
    local suitStar = 99
    for i = 1, #data.spoils_id do
        local sid = data.spoils_id[i]
        local sp = SpoilsModel:GetInstance():GetData(sid)
        if sp:GetIsActive() then
            curNum = curNum + 1
        end

        local spoils = _G.InstantiateObject(self.go_table.obj_spoilsItem, tb.obj_info)
        local spoilsTb = _G.GetAutoGoTable(spoils, _G.handlerbind(self, self.OnClickOneSpoils, sp, index))

        if sp.cfg.Order == self.ToggleOrder then
            spoilsTb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SpoilsCanUp.id, sid)

            -- _G.SetEventTrigger(spoilsTb.aorbtn_spoils, "onLongPress", _G.handlerbind(self, self.OnLongPress, sid))
            -- _G.SetEventTrigger(spoilsTb.aorbtn_spoils, "onDown", _G.handler(self, self.OnDown))

            local starNum = spoilsTb.obj_stars:GetChildCountE()
            local star = sp:GetStar()
            if star < suitStar then
                suitStar = star
            end
            if star == 0 then
                for level = 2, starNum do
                    spoilsTb.obj_stars:GetChildE(level - 1):SetActiveE(0)
                end
            else
                local tmpstar = star % 5
                local blstar = star / 5
                if tmpstar == 0 then
                    tmpstar = star
                end
                for level = 2, starNum do
                    local obj = spoilsTb.obj_stars:GetChildE(level - 1)
                    local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
                    if level - 1 <= tmpstar then
                        obj:SetActiveE(1)
                        if blstar > 1 then
                            image.SpriteName = "ui_img_xing_hong"
                        else
                            image.SpriteName = "ui_img_xing"
                        end
                    else
                        obj:SetActiveE(0)
                    end
                end
            end

            if sp.cfg.limit == 1 then
                isLimit = isLimit + 1
            end

            local aorimage_skillxd = spoilsTb.aorimage_skillxd
            if AppSetting.IsXzns then
                _G.GameUtil.SetActiveByCondition(aorimage_skillxd, false)
            else
                if spoilsTb.aorimage_skillxd2 then
                    spoilsTb.aorimage_skillxd2:SetActiveE(0)
                    spoilsTb.aorimage_skillxd:SetActiveE(0)
                    aorimage_skillxd = (self.uiModel and spoilsTb.aorimage_skillxd2) and spoilsTb.aorimage_skillxd2 or spoilsTb.aorimage_skillxd
                end

                _G.GameUtil.SetActiveByCondition(aorimage_skillxd, sp.cfg.limit == 1)
            end

            --     spoilsTb.aorimage_quelity.SpriteName = self.Quility[_G.SpoilsQuilty.cai]
            -- else
            spoilsTb.aorimage_quelity.SpriteName = self.Quility[sp.cfg.Order]
            -- end

            spoilsTb.aortext_name.text = _G.GetLangPackValue(sp.cfg.Name)
            spoilsTb.aorrawimage_icon:LoadImage(sp.cfg.Icon, function(img)
                img:SetNativeSize()
                local trans = img:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
                trans:SetLocalScaleXYZ(sp.cfg.size)
            end)

            local hasNum = _G.StorageManager:GetInstance():GetItemCountBySid(sp.cfg.materials_item)
            local needNum = not sp:IsMaxStar() and sp.cfg.material_1[star + 2] or 0

            spoilsTb.aortext_Slider.text = hasNum .. "/" .. needNum
            local ctm = require "CommonTipManager":GetInstance()
            local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
                    :GetTipTypeNameOutLineColorByGrade(sp.cfg.Order))
            local rgb
            --ctm:SetItemTextGradient(spoilsTb.aortext_name, sp.cfg.Order)
            spoilsTb.slider_propress.value = hasNum / needNum
            if sp:GetIsActive() then
                if sp:IsMaxStar() then
                    --spoilsTb.obj_stars:SetActiveE(0)
                    spoilsTb.slider_propress:SetActiveE(0)
                    spoilsTb.aortext_starnot:SetActiveE(0)
                    spoilsTb.obj_starmax:SetActiveE(1)
                else
                    spoilsTb.obj_stars:SetActiveE(1)
                    spoilsTb.slider_propress:SetActiveE(1)
                    spoilsTb.aortext_starnot:SetActiveE(0)
                    spoilsTb.obj_starmax:SetActiveE(0)
                end
                self:SetIconGray(spoilsTb.aorrawimage_icon)
                -- spoilsTb.aorimage_quelity:SetGray(false)
                if sp.cfg.limit == 1 then
                    rgb = self.NameColor[_G.SpoilsQuilty.cai]
                else
                    rgb = self.NameColor[sp.cfg.Order]
                end

                spoilsTb.obj_speff:SetActiveE(1)
                if not spoilsTb.activeeff then
                    spoilsTb.activeeff = 1
                    _G.UIUtils.LoadEffectByCfg(
                            self.Effectcfg[sp.cfg.Order],
                            spoilsTb.obj_speff,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                            end
                    )
                end
            else
                spoilsTb.obj_speff:SetActiveE(0)
                spoilsTb.obj_stars:SetActiveE(0)
                spoilsTb.slider_propress:SetActiveE(1)
                spoilsTb.obj_starmax:SetActiveE(0)

                if hasNum >= needNum then
                    spoilsTb.aortext_starnot:SetActiveE(0)
                    spoilsTb.aortext_canactive:SetActiveE(1)
                    self:SetIconGray(spoilsTb.aorrawimage_icon)
                    -- spoilsTb.aorimage_quelity:SetGray(false)
                    if sp.cfg.limit == 1 then
                        rgb = self.NameColor[_G.SpoilsQuilty.cai]
                    else
                        rgb = self.NameColor[sp.cfg.Order]
                    end
                else
                    spoilsTb.aortext_starnot:SetActiveE(1)
                    spoilsTb.aortext_canactive:SetActiveE(0)
                    self:SetIconGray(spoilsTb.aorrawimage_icon, true)
                    -- spoilsTb.aorimage_quelity:SetGray(true)
                    -- spoilsTb.aorimage_quelity.SpriteName = self.Quility[_G.SpoilsQuilty.cheng]
                    rgb = self.NameColor[sp.cfg.Order]
                end
                -- outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
                --     :GetTipTypeNameOutLineColorByGrade(1))
                -- ctm:SetItemTextGradient(spoilsTb.aortext_name, 1)
            end
            if AppSetting.IsXzns then
                --spoilsTb.aortext_name.color=_G.ColorTools.FormatColorByString(rgb)
            else
                spoilsTb.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
            end
        else
            spoilsTb.gameObject:SetActiveE(0)
        end
    end
    tb.aortext_name.text = _G.GetLangPackValue(data.Name) .. "(" .. curNum .. "/" .. #data.spoils_id .. ")"
    if isLimit then
        local aorimage_skillxd = tb.aorimage_skillxd
        if tb.aorimage_skillxd2 then
            tb.aorimage_skillxd2:SetActiveE(0)
            tb.aorimage_skillxd:SetActiveE(0)
            aorimage_skillxd = (self.uiModel and tb.aorimage_skillxd2) and tb.aorimage_skillxd2 or tb.aorimage_skillxd
        end
        _G.GameUtil.SetActiveByCondition(aorimage_skillxd, isLimit > 0)
    end

    local skillid
    tb.aorrawimage_icon:SetGray(true)
    if curNum >= #data.spoils_id then
        ---激活了套装
        if suitStar >= 0 then
            skillid = data.skill_id[suitStar + 1]
            if nil == skillid then
                skillid = data.skill_id[#data.skill_id]
