        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    elseif name == _G.ConfigManager.ui_cfg.SpoilsRecycleView.Name then
        local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, canvas.sortingOrder - 5)
    end
end

function SpoilsMainView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function SpoilsMainView:ShowPowerUp()
    ---临时等级提升不显示战力变化
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

function SpoilsMainView:ChangeView(name)
    if name == self.curView.Name then
        return
    end
    local UIManager = _G.UIManager:GetInstance()
    local canvas = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))

    if name == self.WindowName.Treasury then
        local ctrl = require("IntegrateBpFdModel"):GetInstance():GetController(_G.Spoils.SpoilsBp)
        _G.UIManager:GetInstance():OpenWindow(ctrl:GetViewName(), ctrl)
    else
        local view = UIManager:OpenWindow(name)
        local icon = self.go_table[self.ToggleDic[name]]:FindE("Icon"):GetComponentE(_G.typeof(_G.CS.AorImage))
        local nowIcon = self.go_table[self.ToggleDic[self.curView.Name]]:FindE("Icon"):GetComponentE(_G.typeof(_G.CS.AorImage))
        local bg = self.go_table[self.ToggleDic[name]]:FindE("bg"):GetComponentE(_G.typeof(_G.CS.AorImage))
        local nowBg = self.go_table[self.ToggleDic[self.curView.Name]]:FindE("bg"):GetComponentE(_G.typeof(_G.CS.AorImage))
        bg:SetActiveE(1)
        nowBg:SetActiveE(0)
        icon.SpriteName = self.IconDic[name] .. "_c_icon"
        nowIcon.SpriteName = self.IconDic[self.curView.Name] .. "_n_icon"
        --if view.LayerSorting >= canvas.sortingOrder then
        --view.LayerSorting = canvas.sortingOrder - 5
        --end

        if self.curView.Name ~= self.WindowName.Main and name ~= self.WindowName.Treasury and name ~= self.curView.Name then
            UIManager:HideWindow(self.curView.Name)
        end
        self.curView = view
    end
end

--- 检测品质子页签红点
function SpoilsMainView:CheckToggleRedPoint()
    self.go_table.obj_redpoint1:SetActiveE(0)
    self.go_table.obj_redpoint2:SetActiveE(0)
    self.go_table.obj_redpoint3:SetActiveE(0)
    local data = SpoilsModel:GetInstance():GetAllDatas()
    for k, v in pairs(data) do
        local sp = v
        if sp:CheckOpen() then
            if sp:IsCanActive() or sp:IsCanStarUp() then
                if sp.cfg.Order == _G.SpoilsQuilty.cai then
                    self.go_table.obj_redpoint1:SetActiveE(1)
                elseif sp.cfg.Order == _G.SpoilsQuilty.hong then
                    self.go_table.obj_redpoint2:SetActiveE(1)
                elseif sp.cfg.Order == _G.SpoilsQuilty.cheng then
                    self.go_table.obj_redpoint3:SetActiveE(1)
                end
            end
        end
    end
end

---按钮点击事件在这里派发
function SpoilsMainView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    local name = go:GetName()
    if go == self.go_table.aorbtn_close then
        self:Close()
        for _, window in pairs(self.WindowName) do
            local view = UIManager:GetWindow(window)
            if view then
                UIManager:CloseWindow(window)
            end
        end
    elseif go == self.go_table.aorbtn_help then
        if self.go_table.obj_prop:GetActiveSelf() == 1 then
            self.go_table.obj_prop:SetActiveE(0)
        else
            self.go_table.obj_prop:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_main then
        self:ChangeView(self.WindowName.Main)
    elseif go == self.go_table.aorbtn_suit then
        self:ChangeView(self.WindowName.Suit)
    elseif go == self.go_table.aorbtn_draw then
        self:ChangeView(self.WindowName.Draw)
    elseif go == self.go_table.aorbtn_treasury then
        self:ChangeView(self.WindowName.Treasury)
    elseif go == self.go_table.aorbtn_recycle then
        self:ChangeView(self.WindowName.Recycle)
    elseif go == self.go_table.aorbtn_closeProp then
        self.go_table.obj_prop:SetActiveE(0)
    elseif go == self.go_table.aorbtn_helpTip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 176)
    elseif name == "@_obj_Toggle1" then
        if isOn then
            self:OnClickToggle(_G.SpoilsQuilty.cai)
        end
    elseif name == "@_obj_Toggle2" then
        if isOn then
            self:OnClickToggle(_G.SpoilsQuilty.hong)
        end
    elseif name == "@_obj_Toggle3" then
        if isOn then
            self:OnClickToggle(_G.SpoilsQuilty.cheng)
        end
    elseif go == self.go_table.aorbtn_AttrDetail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrSpoilsPanel.Name)
    end
end
function SpoilsMainView:OnClickToggle(toggletag)
    local isnowtag = toggletag == self.ToggleOrder
    self.ToggleOrder = toggletag
    self.SuitNum = 0
    for _, v in pairs(self.suitCfg) do
        if self.ToggleOrder == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            self.SuitNum = self.SuitNum + 1
            self.SuitDatas[self.SuitNum] = v
        end
    end
    local actionIndex = 0

    for i = 1, #self.SuitDatas do
        local data = self.SuitDatas[i]
        for j = 1, #data.spoils_id do
            local sid = data.spoils_id[j]
            local sp = SpoilsModel:GetInstance():GetData(sid)
            if sp:IsCanActive() or sp:IsCanStarUp() then
                actionIndex = i - 1
                break
            end
        end
    end
    if not isnowtag or actionIndex ~= 0 then
        self.actionIndex = actionIndex
    end
    self.go_table.scrollloopvectical_all:UpdateCount(self.SuitNum)
    self.go_table.scrollloopvectical_all:ScrollToIndex(self.actionIndex)
end
---@private
function SpoilsMainView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    if self.moveTween then
        for k, v in pairs(self.moveTween) do
            v:Kill()
        end
        self.moveTween = nil
    end
end

return SpoilsMainView
