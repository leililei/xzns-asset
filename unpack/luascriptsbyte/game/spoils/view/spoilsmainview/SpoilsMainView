---界面的入口函数
function SpoilsMainView:OnCreate(name)
    self.uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    self:InitView()
    self.curView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SpoilsMainView.Name)
    if name then
        self:ChangeView(name)
    else
        local icon = self.go_table[self.ToggleDic[self.WindowName.Main]]:FindE("Icon"):GetComponentE(_G.typeof(_G.CS.AorImage))
        local bg = self.go_table[self.ToggleDic[self.WindowName.Main]]:FindE("bg"):GetComponentE(_G.typeof(_G.CS.AorImage))
        icon.SpriteName = self.IconDic[self.WindowName.Main] .. "_c_icon"
        bg:SetActiveE(1)
    end

    self:CheckToggleRedPoint()
    self:AddListener(_G.eSpoilsUpStar.SpoilsUpStarRefresh, self.OnUpStar)
    self:AddListener(_G.eSpoils.SpoilsGotoActive, self.ChangeToggle)
    self:AddListener(_G.eSpoilsDraw.SpoilsDrawEnd, self.OnSpoilsDrawEnd)
    self:AddListener(_G.eItemUpdata.Updata, self.OnSpoilsDrawEnd)

    self:AddListener(_G.eSpoilsRecycle.SpoilsUpLevelRefresh, self.OnRecycleLevelUp)

    self:CheckRecycle()

    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_zhanlipin_quanjihuo,
    --     self.go_table.obj_bgEff,
    --     function(trans)
    --         if self:IsNil() then
    --             _G.DestroyObject(trans)
    --             return
    --         end
    --     end
    -- )

    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

