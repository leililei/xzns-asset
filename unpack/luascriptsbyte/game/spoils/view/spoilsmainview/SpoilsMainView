---@param sp SpoilsData
function SpoilsMainView:OnClickOneSpoils(obj, _, sp, _index)
    if _G.AppSetting.Debug then
        Log(_G.GetLangPackValue(sp.cfg.Name), "点击战利品")
    end
    local isActive = SpoilsModel:GetInstance():GetData(sp.cfg.id):GetIsActive()
    self.actionIndex = _index - 1
    if sp:GetIsActive() then
        local data = {}
        data.data = require("SpoilsModel"):GetInstance():GetData(sp.cfg.id)

        local btnDevelop = {
            name = _G.GetLangPackValue(90022300042),
            func = _G.handlerbind(self, self.clickStarUp, sp),
            close = true
        }
        data.btn = { middle = btnDevelop }
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, { data }, 6)
    else
        if sp:IsCanActive() then
            local oldsuit = SpoilsModel:GetInstance():GetActiveSuitBySid(sp.cfg.suit_id)
            local _,lastProp,curProp
            _,lastProp= SpoilsModel:GetInstance():GetAllOtherProp()
            self:RecordPower()
            SpoilsModel:GetInstance():UpStar(sp.cfg.id, 0, function()
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Spoils)
                self:UpdateProp()
                local tag, index = self:CheckCanChooseIndex()
                if tag == 0 or self:CheckCanChooseIndexByQuilty(self.ToggleOrder) > -1 then
                    --self.actionIndex = _index
                    self:UpdateAll()
                else
                    if tag == _G.SpoilsQuilty.hong then
                        self.go_table.obj_Toggle2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
                    elseif tag == _G.SpoilsQuilty.cheng then
                        self.go_table.obj_Toggle3:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
                    elseif tag == _G.SpoilsQuilty.cai then
                        self.go_table.obj_Toggle1:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
                    end
                    self:CheckToggleRedPoint()
                end
                self:ShowPowerUp()
                _,curProp = SpoilsModel:GetInstance():GetAllOtherProp()
                _G.UIUtils.ShowPropUp(nil, lastProp, nil, { prop = curProp })

                local newsuit = SpoilsModel:GetInstance():GetActiveSuitBySid(sp.cfg.suit_id)
                if nil == oldsuit.skillid and newsuit.skillid then
                    ---新数据套装成了
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsSuitUpView.Name, sp.cfg.suit_id,
                            false, oldsuit, newsuit)

                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsSuidBindCard
                                                                          .id)

                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                                                                                      .SpoilsCanUp.id)

                    _G.Events:GetInstance():Broadcast(_G.eSpoilsUpStar.SpoilsUpStarRefresh)
                end

                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsActiveView.Name, sp.cfg.id)
            end)
        else
            CommonTipManager:GetInstance():OpenSpoilsTip(self.gameObject, sp.cfg.id, nil, nil, not isActive, true)
        end
    end
end

