---升级后
function SpoilsMainView:OnRecycleLevelUp()
    self:CheckRecycle()
end

function SpoilsMainView:OnSpoilsDrawEnd()
    local tag, index = self:CheckCanChooseIndex()
    if tag == 0 or self:CheckCanChooseIndexByQuilty(self.ToggleOrder) > -1 then
        --self.actionIndex = index
        self:UpdateAll()
    else
        if tag == _G.SpoilsQuilty.hong then
            self.go_table.obj_Toggle2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        elseif tag == _G.SpoilsQuilty.cheng then
            self.go_table.obj_Toggle3:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        elseif tag == _G.SpoilsQuilty.cai then
            self.go_table.obj_Toggle1:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        end
        self:CheckToggleRedPoint()
    end

    ---如果按钮未显示就显示才处理
    if self.go_table.aorbtn_recycle:GetActiveSelf() ~= 1 then
        self:CheckRecycle()
    end
end

---@param suitcfg spoils_suit_cfg
function SpoilsMainView:ChangeToggle(suitcfg)
    self:ChangeView(self.WindowName.Main)

    if suitcfg.Order == _G.SpoilsQuilty.cai then
        local toggle = self.go_table.obj_Toggle1:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
        toggle.isOn = true
    elseif suitcfg.Order == _G.SpoilsQuilty.hong then
        local toggle = self.go_table.obj_Toggle2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
        toggle.isOn = true
    else
        local toggle = self.go_table.obj_Toggle3:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle))
        toggle.isOn = true
    end

    local suitNum = -1
    for _, v in pairs(self.suitCfg) do
        if suitcfg.Order == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
            suitNum = suitNum + 1
            if suitcfg.id == v.id then
                break
            end
        end
    end

    self.go_table.scrollloopvectical_all:ScrollToIndex(suitNum)
end

function SpoilsMainView:OnUpStar()
    self:UpdateProp()

    local tag, index = self:CheckCanChooseIndex()
    if tag == 0 or self:CheckCanChooseIndexByQuilty(self.ToggleOrder) > -1 then
        --self.actionIndex = index
        self:UpdateAll()
    else
        if tag == _G.SpoilsQuilty.hong then
            self.go_table.obj_Toggle2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        elseif tag == _G.SpoilsQuilty.cheng then
            self.go_table.obj_Toggle3:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        elseif tag == _G.SpoilsQuilty.cai then
            self.go_table.obj_Toggle1:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        end
        self:CheckToggleRedPoint()
    end
end

---初始化页面
function SpoilsMainView:InitView()
    local tag, index = self:CheckCanChooseIndex()
    if tag == 0 or tag == _G.SpoilsQuilty.cai then
        self.ToggleOrder = _G.SpoilsQuilty.cai
        self.actionIndex = index
        self.SuitNum = 0
        for _, v in pairs(self.suitCfg) do
            if self.ToggleOrder == v.Order and _G.GlobalConditionManager.CheckConditionArrays(v.condition_type) then
                local channel = v.channel_id
                if #channel == 0 or _G.table.ContainsValue(channel, tonumber(_G.SDKManager:GetInstance():GetChannelId())) then
                    self.SuitNum = self.SuitNum + 1
                    self.SuitDatas[self.SuitNum] = v
                end
            end
        end

        self:UpdateAll()
    else
        self.SuitNum = 0
        if not self.Init then
            self.go_table.scrollloopvectical_all:InitItemData(self.SuitNum, _G.handler(self, self.RefreshList))
            self.Init = true
        end
        if tag == _G.SpoilsQuilty.hong then
            self.go_table.obj_Toggle2:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        elseif tag == _G.SpoilsQuilty.cheng then
            self.go_table.obj_Toggle3:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
        end
        self:CheckToggleRedPoint()
    end
    self:UpdateProp()
end

