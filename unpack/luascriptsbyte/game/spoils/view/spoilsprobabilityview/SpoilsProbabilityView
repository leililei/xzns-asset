---@private
function SpoilsProbabilityView:RefreshList(index, obj)
	index = index + 1
    local instanceID = obj:GetInstanceIDE()
    local tb = self.itemList[instanceID]
    local data = self.probList[index]
    if not data then
        return
    end
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.itemList[instanceID] = tb
        ---@type BaseAwardNewItem
        tb.item = require "BaseAwardNewItem".New(tb.obj_itemBase, _G.handler(self, self.OnClickItem), 96)
    end
    ---@param item BaseAwardNewItem
    tb.item:ShowWithID(
        {data.sid, data.num},
        nil,
        function(item)
            if item.item.HideLevel then
                item.item:HideLevel()
                item.item:HideStar()
            end
        end
    )
    tb.aortext_prob.text = string.format("%.2f", data.prob) .. "%"
end

---@private
function SpoilsProbabilityView:OnClickItem(go, isOn)
    local level = #_G.ConfigManager.artifact_level_cfg
    require "CommonTipManager":GetInstance():OpenTip(go.gameObject, go.data.sid,nil,nil,{level})
end

---@private
function SpoilsProbabilityView:OnClickTag(index)
    if self.init then
        return
    end
    for i = 1, 3 do
        local tb = GetAutoGoTable(self.go_table["toggle_order" .. i])
        tb.aorimage_isOn:SetActiveE(i == index and 1 or 0)
        tb.aorimage_isOff:SetActiveE(i == index and 0 or 1)
        self.go_table.scrollloopvectical_artifact:UpdateCount(#self.probList)
    end
end

---按钮点击事件在这里派发
function SpoilsProbabilityView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_order1 then
        self:OnClickTag(1)
    elseif go == self.go_table.toggle_order2 then
        self:OnClickTag(2)
    elseif go == self.go_table.toggle_order3 then
        self:OnClickTag(3)
    end
end

return SpoilsProbabilityView
