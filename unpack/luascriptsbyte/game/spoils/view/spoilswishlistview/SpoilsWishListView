function SpoilsWishListView:OnClickBtnTip(storageType, cardList, itemData)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.WearCardList,
        storageType,
        cardList,
        itemData
    )
end

---发送消息
function SpoilsWishListView:OnSend()
    SpoilsDrawModel:GetInstance():SetWish(self.selecID)
end

---界面的销毁函数
function SpoilsWishListView:OnDestroy()
end

return SpoilsWishListView
