local ItemSpoilsBase = require("ItemSpoilsBase")
local SpoilsDrawModel = require "SpoilsDrawModel"
local PlayerTreeID = _G.PlayerTreeID
local GetAutoGoTable = _G.GetAutoGoTable
local handlerbind = _G.handlerbind
local CardInfoManager = require("CardInfoManager"):GetInstance()
local SpoilsModel = require("SpoilsModel")

---@class SpoilsWishListView : UIBaseView    中文描述
---@field public go_table SpoilsWishListView_GoTable GoTable
local SpoilsWishListView = _G.BaseClass("SpoilsWishListView", _G.UIBaseView)

function SpoilsWishListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshSpoilsList))
    ---数据列表
    self.SpoilsDataList = {}

    ---可选中的数量
    self.selectSpoilsNum = 1
    ---已选中Item
    self.selectSpoilsItem = {}

    self.Quility = {
        [_G.SpoilsQuilty.cheng] = "ui_js_txk_cheng",
        [_G.SpoilsQuilty.hong] = "ui_js_txk_hong",
        [_G.SpoilsQuilty.cai] = "ui_js_txk_cai"
    }

    self.EmbattleModel = require "EmbattleModel":GetInstance()
end

---按钮点击事件在这里派发
function SpoilsWishListView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeX then
        ---遮罩或者关闭按钮

        self:Close()
    elseif go == self.go_table.aorbtn_help then
        ---TODO:策划还没有给id
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 118)
    elseif go == self.go_table.aorbtn_sure then
        self:OnSend()
        self:Close()
    end
end

---界面的入口函数
function SpoilsWishListView:OnCreate()
    self:InitData()
    ---已选中的数据,0是未选择（TODO:临时测试数据）
    self.selectData = SpoilsDrawModel:GetInstance():GetWishsids()
    self.selecID = self.selectData
    self.go_table.scrollloopvectical_list:UpdateCount(#self.SpoilsDataList)
    self:RefreshSelect()
end

---初始化数据
function SpoilsWishListView:InitData()
    local wishItemData = _G.ConfigManager.item_roller_cfg[50100].wish_item
    local SpoilsConfig = _G.ConfigManager.spoils_cfg
    for _, id in pairs(wishItemData) do
        local cfg = SpoilsConfig[id]
        if cfg then
            _G.table.insert(self.SpoilsDataList, id)
        end
    end
end

---刷新列表
function SpoilsWishListView:RefreshSpoilsList(index, obj)
    index = index + 1
    local spoilsSid = self.SpoilsDataList[index]
    local cfg = _G.ConfigManager.spoils_cfg[spoilsSid]
    ---@type SpoilsWearView._obj_artItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickSpoils, spoilsSid))
    tb.aortext_name.text = _G.GetLangPackValue(cfg.Name)
    tb.aorimage_Bg.SpriteName = self.Quility[cfg.Order]
    local itemcfg= _G.ConfigManager.item_cfg[cfg.item]
    tb.aorrawimage_Icon:LoadImage(itemcfg.Icon)

    local suitcfg = _G.ConfigManager.spoils_suit_cfg[cfg.suit_id]
    local skillcfg = _G.ConfigManager.card_skills_cfg[suitcfg.skill_id[1]]
    tb.aorrawimage_skill:LoadImage(skillcfg.icon)

    if self.selecID == spoilsSid then
        tb.aorimage_choose:SetActiveE(1)
    else
        tb.aorimage_choose:SetActiveE(0)
    end

    tb.obj_limit:SetActiveE(0)

    local sp = SpoilsModel:GetInstance():GetData(spoilsSid)
    local IsMaxStar = sp:IsMaxStar()

    tb.obj_progress:SetActiveE(not IsMaxStar and sp:GetIsActive() and 1 or 0)
    tb.obj_maxStar:SetActiveE(IsMaxStar and 1 or 0)
    tb.aortext_starnot:SetActiveE(sp:GetIsActive() and 0 or 1)
    tb.aortext_star.text = _G.GetLangPackValue(90000010475, sp:GetStar())

    local count = _G.StorageManager:GetInstance():GetItemCountBySid(sp.cfg.materials_item)
    local needCount = not IsMaxStar and sp.cfg.material_1[sp:GetStar() + 2] or 0
    tb.aortext_progress.text = count .. "/" .. needCount

    if needCount <= count then
        tb.aorimage_activeSchedule:SetLocalScale(1, 1, 1)
    else
        tb.aorimage_activeSchedule:SetLocalScale(count / needCount, 1, 1)
    end


    ---@type UnityEngine.UI.ScrollRect
    local scorll = self.go_table.scrollloopvectical_list:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))

    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDrag", function(s, event)
        scorll:OnDrag(event)
    end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragEnd", function(s, event)
        scorll:OnEndDrag(event)
    end)
    _G.SetEventTrigger(tb.aorbtn_clickObj, "onDragBegin", function(s, event)
        scorll:OnBeginDrag(event)
    end)
end

