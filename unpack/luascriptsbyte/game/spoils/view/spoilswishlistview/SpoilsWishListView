---Item点击事件
---@param spoilsSid number sid
function SpoilsWishListView:OnClickSpoils(obj, isOn, spoilsSid)
    if self.selecID == spoilsSid then
        require("CommonTipManager"):GetInstance():OpenSpoilsTip
        (obj, spoilsSid, nil, nil, not isActive, true)
    else
        self.selecID = spoilsSid
        self:RefreshSelect()
        self.go_table.scrollloopvectical_list:UpdateAllItem()
    end
end

