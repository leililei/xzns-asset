---@class SpoilsSuitUpView : UIBaseView    中文描述
---@field public go_table SpoilsSuitUpView_GoTable GoTable
local SpoilsSuitUpView = _G.BaseClass("SpoilsSuitUpView", _G.UIBaseView)

function SpoilsSuitUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsSuitUpView:OnCreate(suitid, isup, oldsuit, newsuit)
    self.SuitId = suitid
    self.IsUp = isup
    self.Cfg = _G.ConfigManager.spoils_suit_cfg[self.SuitId]

    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_taozhuangshengji,
    --     self.go_table.obj_Eff,
    --     function(trans)
    --         if self:IsNil() then
    --             _G.DestroyObject(trans)
    --             return
    --         end
    --     end)

    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg.ef_taozhuangjihuo,
    --     self.go_table.obj_Eff,
    --     function(trans)
    --         if self:IsNil() then
    --             _G.DestroyObject(trans)
    --             return
    --         end
    --     end
    -- )

    self.ExtendDescText = self.go_table.obj_desc:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.ExtendDescText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefSkillClick))
    if isup then
        self.go_table.aorimage_title.SpriteName = "ui_zlp_tcsjtc_txt_tzsj"
        self.go_table.aorimage_skillnext:SetActiveE(1)
        self.go_table.aorimage_skill:SetLocalPosition(129, 13, 0)

        local skilltb = _G.GetAutoGoTable(self.go_table.aorimage_skill)

        local skillcfg = _G.ConfigManager.card_skills_cfg[oldsuit.skillid]

        skilltb.aorrawimage_icon:LoadImage(skillcfg.icon)
        skilltb.aortext_skilllevel.text = oldsuit.suitStar

        _G.GameUtil.SetActiveByCondition(skilltb.aorimage_skillxd, oldsuit.isLimit > 0)

        local skilltbnext = _G.GetAutoGoTable(self.go_table.aorimage_skillnext)

        local skillcfgnext = _G.ConfigManager.card_skills_cfg[newsuit.skillid]

        skilltbnext.aorrawimage_icon:LoadImage(skillcfgnext.icon)
        skilltbnext.aortext_skilllevel.text = newsuit.suitStar

        _G.GameUtil.SetActiveByCondition(skilltbnext.aorimage_skillxd, newsuit.isLimit > 0)
        self.go_table.aortext_name.text=_G.GetLangPackValue(skillcfg.name1)
        --self.go_table.aortext_desc.text = _G.GetLangPackValue(skillcfgnext.describe1)
        self.ExtendDescText.text = _G.GetLangPackValue(skillcfgnext.describe1)
    else
        self.go_table.aorimage_title.SpriteName = "ui_zlp_tcsjtc_txt_tzjh"
        self.go_table.aorimage_skillnext:SetActiveE(0)
        self.go_table.aorimage_skill:SetLocalPosition(225, 13, 0)

        local skilltb = _G.GetAutoGoTable(self.go_table.aorimage_skill)

        local skillcfg = _G.ConfigManager.card_skills_cfg[newsuit.skillid]

        skilltb.aorrawimage_icon:LoadImage(skillcfg.icon)
        skilltb.aortext_skilllevel.text = newsuit.suitStar

        _G.GameUtil.SetActiveByCondition(skilltb.aorimage_skillxd, newsuit.isLimit > 0)
        self.go_table.aortext_name.text=_G.GetLangPackValue(skillcfg.name1)
        --self.go_table.aortext_desc.text = _G.GetLangPackValue(skillcfg.describe1)
        self.ExtendDescText.text = _G.GetLangPackValue(skillcfg.describe1)
    end
end

function SpoilsSuitUpView:OnHrefSkillClick(id)
    local weight, height = 0, 0
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

---按钮点击事件在这里派发
function SpoilsSuitUpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

---@private
function SpoilsSuitUpView:OnDestroy()
end

return SpoilsSuitUpView
