---判断是不是开放
function SpoilsData:CheckOpen()
    local suit = _G.ConfigManager.spoils_suit_cfg[self.cfg.suit_id]
    return _G.GlobalConditionManager.CheckConditionArrays(suit.condition_type)
end

---是否激活
---@return boolean 是否激活
function SpoilsData:GetIsActive()
    return self.active
end

---获取星级
---@return number 星级
function SpoilsData:GetStar()
    return self.star
end

---获取名称
---@return string 名称
function SpoilsData:GetName()
    return _G.GetLangPackValue(self.cfg.Name)
end

---是否可激活
function SpoilsData:IsCanActive()
    if self.active then
        return false
    end
    local hasNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.materials_item)
    local needNum = self.cfg.material_1[self.star + 1]

    ---没有激活并且材料够用
    if hasNum >= needNum then
        return true
    end
    return false
end

---是否可升星
function SpoilsData:IsCanStarUp()
    if not self.active then
        return false
    end
    local hasNum = _G.StorageManager:GetInstance():GetItemCountBySid(self.cfg.materials_item)
    if not self:IsMaxStar() then
        local needNum = self.cfg.material_1[self.star + 2]

        ---激活了还没有满星并且材料也够用
        if not self:IsMaxStar() then
            if hasNum >= needNum then
                return true
            end
        end
    end
    return false
end

---是否已满星
function SpoilsData:IsMaxStar()
    return self:GetStar() == self.cfg.Star_max
end

--endregion ----------- 访问数据 end -----------

--region ------------- 增删改 -------------

---合成激活
function SpoilsData:DoActive()
    self.active = true
    self.star = 0
    self:UpdateAttribute()
end

---升星
function SpoilsData:UpStar(star)
    if star then
        self.star = star
    else
        self.star = self.star + 1
    end
    if self.star > self.cfg.Star_max then
        self.star = self.cfg.Star_max
    end
    self:UpdateAttribute()
end

--endregion ----------- 增删改 end -----------

---类的析构函数
function SpoilsData:Dispose()
end

return SpoilsData
