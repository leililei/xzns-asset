---@class SpoilsData    中文描述
---@field cfg spoils_cfg
---@field active boolean 是否激活
---@field star number 星级
local SpoilsData = _G.BaseClass("SpoilsData")


---类的构造函数
function SpoilsData:__init()
    self.active = false
    self.star = 0
end

function SpoilsData:InitCfg(sid)
    self.sid = sid
    self.cfg = _G.ConfigManager.spoils_cfg[self.sid]
end

---数据解析
---@param msg spoils.i_spoils 数据
function SpoilsData:Parse(msg)
    self.active = true
    self.star = msg.star
    self.sid = msg.sid
    self.cfg = _G.ConfigManager.spoils_cfg[self.sid]
    self:UpdateAttribute()
end

---更新属性
function SpoilsData:UpdateAttribute()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self.attribute:OnInit(nil, _G.PowerType.equipment)
    self:GetAttribute(self.attribute)
    self:CalculatePower()
end

-----计算战力
---@param item EquipmentItem 装备item
function SpoilsData:CalculatePower()
    self.power = self.attribute:CalculatePower()
end

function SpoilsData:GetPower()
    if not self.power or self.power == 0 then
        self:UpdateAttribute()
        self.power = self.attribute:CalculatePower()
    end
    return self.power
end

--region ------------- 访问数据 -------------

---获取基础属性
---@param attribute AttributeClass
function SpoilsData:GetAttribute(attribute)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if attribute == nil then
        attribute = AttributeClassManager:GetAttribtueClass()
    end
    local growth = self.cfg.att_growth[self.star + 1] / 10000
    local cfg = self.cfg
    local atk = cfg.atk
    local bre = cfg.bre
    local def = cfg.def
    local maxHp = cfg.max_hp
    if growth > 1 then
        atk = cfg.atk * growth
        bre = cfg.bre * growth
        def = cfg.def * growth
        maxHp = cfg.max_hp * growth
    end
    attribute:AddValueByName("atk", _G.Mathf.RoundToInt(atk), false)
    attribute:AddValueByName("bre", _G.Mathf.RoundToInt(bre), false)
    attribute:AddValueByName("def", _G.Mathf.RoundToInt(def), false)
    attribute:AddValueByName("max_hp", _G.Mathf.RoundToInt(maxHp), false)
    for k,v in pairs(self.cfg.att) do
        attribute:AddValueByName(v[1], AttributeClassManager:GetValueWithName(v[1], tonumber(v[3])*(self.star + 1), tonumber(v[2])), false,tonumber(v[2]))
    end
    return attribute
end

---获取属性字典下一星的临时数据
---@return table 属性
function SpoilsData:GetAttributeDictNext()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if not self.active then
        attribute:AddValueByName("atk", 0, false,_G.AttCountType.other)
        attribute:AddValueByName("bre", 0, false,_G.AttCountType.other)
        attribute:AddValueByName("def", 0, false,_G.AttCountType.other)
        attribute:AddValueByName("max_hp", 0, false,_G.AttCountType.other)
        return attribute
    end
    if not self:IsMaxStar() then
        local growth = self.cfg.att_growth[self.star + 2] / 10000
        attribute:AddValueByName("atk", _G.Mathf.RoundToInt(self.cfg.atk * growth), false,_G.AttCountType.other)
        attribute:AddValueByName("bre", _G.Mathf.RoundToInt(self.cfg.bre * growth), false,_G.AttCountType.other)
        attribute:AddValueByName("def", _G.Mathf.RoundToInt(self.cfg.def * growth), false,_G.AttCountType.other)
        attribute:AddValueByName("max_hp", _G.Mathf.RoundToInt(self.cfg.max_hp * growth), false,_G.AttCountType.other)
        for k,v in pairs(self.cfg.att) do
            attribute:AddValueByName(v[1], AttributeClassManager:GetValueWithName(v[1], tonumber(v[3])*(self.star + 2), tonumber(v[2])), false,tonumber(v[2]))
        end
    end
    return attribute
end

