---通过碎片id获取当前id
function SpoilsModel:GetIdByPropId(propId)
    return self.RelationShipList[propId]
end

---获取升星进度
function SpoilsModel:GetUpStarByPropId(propId)
    local sid = self:GetIdByPropId(propId)
    local spData = self.SpoilsDatas[sid]
    if spData:IsMaxStar() then
        return true, 0
    end

    return false, spData:GetUpCostNum()
end

---获取溢出战利品碎片
function SpoilsModel:GetOverflowByOder(order)
    local list = {}
    for _, sp in pairs(self.SpoilsDatas) do
        if order == sp.cfg.Order then
            local hasNum = _G.StorageManager:GetInstance():GetItemCountBySid(sp.cfg.materials_item)
            local info = {}
            if sp:IsMaxStar() then
                info.key = sp.cfg.materials_item
                info.value = hasNum
            else
                local needNum = 0
                local startStar = 1
                if sp:GetIsActive() then
                    startStar = sp:GetStar() + 2
                else
                    startStar = sp:GetStar() + 1
                end
                for i = startStar, sp.cfg.Star_max + 1 do
                    needNum = needNum + sp.cfg.material_1[i] or 0
                end
                info.key = sp.cfg.materials_item
                info.value = hasNum - needNum
            end
            if info.value > 0 then
                table.insert(list, info)
            end
        end
    end
    return list
end

---获取是否满星战利品
function SpoilsModel:GetStarMaxOder(order)
    for _, sp in pairs(self.SpoilsDatas) do
        if order == sp.cfg.Order then
            if sp:IsMaxStar() then
                return true
            end
        end
    end
    return false
end

return SpoilsModel
