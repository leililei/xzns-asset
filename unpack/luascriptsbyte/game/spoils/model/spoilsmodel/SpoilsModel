function SpoilsModel:SkillBindCard(sid, cards, call)
    local spoils_suit = { suit_sid = sid, cards = {} }
    for uid, v in pairs(cards) do
        table.insert(spoils_suit.cards, uid)
    end
    local pbData = { spoils_suit = spoils_suit }
    SpoilsNet:GetInstance():SkillBindCard(pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self:ClearBindSuit(sid)
            for uid, v in pairs(cards) do
                self:AddBindSuit(sid, uid)
            end
            if call then
                call()
            end
        end
    )
end

function SpoilsModel:UpStar(sid, star, call)
    local pbData = { sid = sid, new_star = star }
    SpoilsNet:GetInstance():UpStar(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local oldsp = SpoilsModel:GetInstance():GetData(sid)
            local oldattr = oldsp:GetAttributeDict()
            if star == 0 then
                self.SpoilsDatas[sid]:DoActive()
            else
                self.SpoilsDatas[sid]:UpStar(star)
            end
            if star > 0 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpoilsStarUpView.Name, sid, oldattr)
            end

            local cfg = _G.ConfigManager.spoils_cfg[sid]
            _G.StorageManager:GetInstance():ConsumeItem(cfg.materials_item, 0, cfg.material_1[star + 1] or 0)
            _G.Events:GetInstance():Broadcast(_G.eSpoilsUpStar.SpoilsUpStarRefresh, sid)

            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SpoilsCanUp.id, sid)
            if call then
                call()
            end
        end
    )
end

---获取数据
---@return SpoilsData
function SpoilsModel:GetData(sid)
    local sp = self.SpoilsDatas[sid]
    if nil == sp then
        if _G.AppSetting.DEBUG then
            _G.LogError(sid, "套装中不存在对应的战利品")
        end
        for sid, _ in pairs(_G.ConfigManager.spoils_cfg) do
            sp = SpoilsData.New()
            sp:InitCfg(sid)
            break
        end
    end
    return sp
end

---获取所有数据
---@return SpoilsData[]
function SpoilsModel:GetAllDatas()
    return self.SpoilsDatas
end

---判断是否还有空余的绑定卡片位置
function SpoilsModel:CheckBindCardsResidue()
    for k, v in pairs(self.SpoilsSuitDatas) do
        if v.cfg.suit_type == 2 then
            local suitInfo = self:GetActiveSuitBySid(v.cfg.id)
            if suitInfo.skillid then
                local gz = 0
                for i = 1, #v.cfg.suit_num / 2 do
                    if suitInfo.suitStar >= v.cfg.suit_num[(i - 1) * 2 + 1] then
                        gz = v.cfg.suit_num[(i - 1) * 2 + 2]
                    end
                end
                if gz > #v.cards then
                    return true
                end
            end
        end
    end
    return false
end

---判断是否还有空余的绑定卡片位置返回成立的品质
function SpoilsModel:GetBindCardsResidueofQ()
    local qlist = {}
    for k, v in pairs(self.SpoilsSuitDatas) do
        if v.cfg.suit_type == 2 then
            local suitInfo = self:GetActiveSuitBySid(v.cfg.id)
            if suitInfo.skillid then
                local gz = 0
                for i = 1, #v.cfg.suit_num / 2 do
                    if suitInfo.suitStar >= v.cfg.suit_num[(i - 1) * 2 + 1] then
                        gz = v.cfg.suit_num[(i - 1) * 2 + 2]
                    end
                end
                if gz > #v.cards then
                    qlist[suitInfo.cfg.Order] = true
                end
            end
        end
    end
    return qlist
end

function SpoilsModel:GetBindSuit(suitid)
    for k, v in pairs(self.SpoilsSuitDatas) do
        if v.cfg.id == suitid then
            return v.cards
        end
    end
    return {}
end

function SpoilsModel:ClearBindSuit(suitid)
    for k, v in pairs(self.SpoilsSuitDatas) do
        if v.cfg.id == suitid then
            v.cards = {}
        end
    end
end

function SpoilsModel:AddBindSuit(suitid, uid)
    for k, v in pairs(self.SpoilsSuitDatas) do
        if v.cfg.id == suitid then
            if false == table.indexof(v.cards, uid) then
                table.insert(v.cards, uid)
            end
        end
    end
end

function SpoilsModel:CheckBindSuit(suitid, uid)
    for k, v in pairs(self.SpoilsSuitDatas) do
        if v.cfg.id == suitid then
            if false ~= table.indexof(v.cards, uid) then
                return true
            end
        end
    end
    return false
end

function SpoilsModel:CheckAllSuitBindSuit(uid)
    local suitcfg = _G.ConfigManager.spoils_suit_cfg
    for suitid, _ in pairs(suitcfg) do
        for k, v in pairs(self.SpoilsSuitDatas) do
            if v.cfg.id == suitid then
                if false ~= table.indexof(v.cards, uid) then
                    return true
                end
            end
        end
    end
    return false
end

---获取当前战利品激活套装
function SpoilsModel:GetActiveSuitBySid(sid)
    local suitcfg = _G.ConfigManager.spoils_suit_cfg[sid]
    local curNum = 0
    local isLimit = 0
    local suitStar = 99
    local info = {}
    for i = 1, #suitcfg.spoils_id do
        local sid = suitcfg.spoils_id[i]
        local sp = self:GetData(sid)

        if sp:GetIsActive() then
            curNum = curNum + 1
        end

        local st = sp:GetStar()
        if st < suitStar then
            suitStar = st
        end
        if sp.cfg.limit == 1 then
            isLimit = isLimit + 1
        end
    end

    local skillid
    if curNum >= #suitcfg.spoils_id then
        ---激活了套装
        if suitStar >= 0 then
            skillid = suitcfg.skill_id[suitStar + 1]
            if nil == skillid then
                skillid = suitcfg.skill_id[#suitcfg.skill_id]
            end
        end
    end

    if skillid and skillid > 0 then
        info.skillid = skillid
    end
    info.suitStar = suitStar
    info.isLimit = isLimit
    info.cfg = suitcfg
    return info
end

---获取所有激活套装
function SpoilsModel:GetAllActiveSuit()
    local suitcfg = _G.ConfigManager.spoils_suit_cfg
    local list = {}
    for _, v in pairs(suitcfg) do
        local curNum = 0
        local isLimit = 0
        local suitStar = 99
        local isActive = false
        for i = 1, #v.spoils_id do
            local sid = v.spoils_id[i]
            local sp = self:GetData(sid)

            if sp:GetIsActive() then
                curNum = curNum + 1
            end

            local st = sp:GetStar()
            if st < suitStar then
                suitStar = st
            end
            if sp.cfg.limit == 1 then
                isLimit = isLimit + 1
            end
        end

        local skillid
        if curNum >= #v.spoils_id then
            isActive = true
            ---激活了套装
            if suitStar >= 0 then
                skillid = v.skill_id[suitStar + 1]
                if nil == skillid then
                    skillid = v.skill_id[#v.skill_id]
                end
            else
                skillid = v.skill_id[1]
            end
        else
            skillid = v.skill_id[1]
        end

        local info = {}
        info.isLimit = isLimit
        info.skillid = skillid
        info.suitStar = suitStar
        info.isActive = isActive
        info.cfg = v

        table.insert(list, info)
    end
    return list
end

---获取所有固定值加成
function SpoilsModel:GetAllOtherProp()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    local prop={}
    for _, spData in pairs(self.SpoilsDatas) do
        prop = spData:GetAttributeDict()
        AttributeClassManager:AddAttribute(attribute, prop, false)
    end
    return attribute,attribute:GetAttrByName(_G.AttCountType.base)
end

---获取所有属性加成
function SpoilsModel:GetAllAttribute()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute = AttributeClassManager:GetAttribtueClass()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Spoils) then
        local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
        return attribute, changeAttrTypes
    end
    ---战利品原始属性
    local prop = self:GetAllOtherProp()
    AttributeClassManager:AddAttribute(attribute, prop, false)

    ---战利品回收养成属性
    for _, v in pairs(self.RecycleDatas) do
        local cfg = _G.ConfigManager.spoils_technology_info[v.level_sid]

        for _, v in pairs(cfg.Attribute) do
            attribute:AddValueByName(
                v[1],
                AttributeClassManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                false,
                _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
            )
        end

        for _, v in pairs(cfg.Attribute_extra) do
            attribute:AddValueByName(
                v[1],
                AttributeClassManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                false,
                _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
            )
        end
    end

    local changeAttrTypes = _G.AttributeClassManager:GetInstance():GetChangeAttrTypes(attribute)
    return attribute, changeAttrTypes
end

function SpoilsModel:GetRecycleAttributeDict()
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local allProp = { atk = 0, bre = 0, def = 0, max_hp = 0 }
    for _, v in pairs(self.RecycleDatas) do
        local cfg = _G.ConfigManager.spoils_technology_info[v.level_sid]

        for _, v in pairs(cfg.Attribute) do
            allProp[v[1]] = allProp[v[1]] + AttributeClassManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2]))
        end
    end

    return allProp
end

