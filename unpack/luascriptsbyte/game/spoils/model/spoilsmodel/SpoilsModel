local SpoilsNet = require("SpoilsNet")
local SpoilsData = require("SpoilsData")

local base = _G.GameDataModelBase
---@class SpoilsModel : GameDataModelBase
---@field SpoilsDatas SpoilsData[]
local SpoilsModel = _G.BaseClass("SpoilsModel", base)

---@return SpoilsModel SpoilsModel
function SpoilsModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SpoilsModel:__init()
    self.curFunctionOpenID = _G.FunctionID.Spoils
    self.cfg = _G.ConfigManager.spoils_cfg
    self.suitCfg = _G.ConfigManager.spoils_suit_cfg
    self.SpoilsDatas = {}
    for sid, v in pairs(self.cfg) do
        if v.suit_id > 0 then
            local sp = SpoilsData.New()
            sp:InitCfg(sid)
            self.SpoilsDatas[sid] = sp
        end
    end
    self.SpoilsSuitDatas = {}
    for sid, v in pairs(self.suitCfg) do
        local sp = {}
        sp.cfg = v
        sp.cards = {}
        self.SpoilsSuitDatas[sid] = sp
    end
    ---战利品关系列表，list<战利品碎片id， 战利品id>
    self.RelationShipList = {}
    for _, v in pairs(_G.ConfigManager.spoils_cfg) do
        self.RelationShipList[v.materials_item] = v.id
    end

    ---回收养成数据
    self.RecycleDatas = {}
    for _, v in pairs(_G.ConfigManager.spoils_technology) do
        local data = { sid = v.id, level_sid = self:GetRecyclLevelSidByLevel(v.id, 1), exp = 0 }
        self.RecycleDatas[v.id] = data
    end
end

---从服务器拉取数据
function SpoilsModel:GetDataFormServer()
    SpoilsNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
end

---@param msg spoils.s2c_spoils_info
function SpoilsModel:ParseData(msg)
    local list = msg.spoils_list or {}
    for i = 1, #list do
        ---@type SpoilsData
        local sp = self.SpoilsDatas[list[i].sid]
        if sp then
            sp:Parse(list[i])
        end
    end
    local suitList = msg.suit_list or {}
    for i = 1, #suitList do
        local spsuit = self.SpoilsSuitDatas[suitList[i].suit_sid]
        if spsuit then
            spsuit.cards = suitList[i].cards or {}
        end
    end

    local rlist = msg.return_list or {}
    for i = 1, #rlist do
        local rdata = rlist[i]
        self.RecycleDatas[rdata.sid] = rdata
    end
    self.super.ParseData(self)
end

---获取回收数据
function SpoilsModel:GetRecyclData(sid)
    local info = self.RecycleDatas[sid]
    return info
end

---设置回收数据
function SpoilsModel:SetRecyclData(sid, level_sid, exp)
    local info = self.RecycleDatas[sid]
    if info then
        info.sid = sid
        info.level_sid = level_sid
        info.exp = exp
    else
        local rdata = { sid = sid, level_sid = level_sid, exp = exp }
        self.RecycleDatas[rdata.sid] = rdata
    end
end

---设置等级和经验
function SpoilsModel:SetRecyclLevelAndExp(sid, level, exp)
    local info = self.RecycleDatas[sid]
    local cfg = _G.ConfigManager.spoils_technology[sid]
    local tempexp = exp
    local totalexp = 0
    local newlevel = 0
    for i = level, #cfg.Level_info + 1 do
        local levelcfg = _G.ConfigManager.spoils_technology_info[cfg.Level_info[i]]
        totalexp = totalexp + levelcfg.Number
        if exp < totalexp then
            info.level_sid = cfg.Level_info[i]
            info.exp = tempexp
            newlevel = i
            break
        elseif exp == totalexp then
            info.level_sid = cfg.Level_info[i + 1]
            info.exp = 0
            newlevel = i + 1
            break
        else
            tempexp = tempexp - levelcfg.Number
        end
    end
    return newlevel
end

---预览等级和经验
function SpoilsModel:YulanRecyclLevelAndExp(sid, level, exp)
    local level_sid, newexp
    local cfg = _G.ConfigManager.spoils_technology[sid]
    local tempexp = exp
    local totalexp = 0
    local newlevel = 0
    for i = level, #cfg.Level_info + 1 do
        local levelcfg = _G.ConfigManager.spoils_technology_info[cfg.Level_info[i]]
        totalexp = totalexp + levelcfg.Number
        if exp < totalexp then
            level_sid = cfg.Level_info[i]
            newexp = tempexp
            newlevel = i
            break
        elseif exp == totalexp then
            level_sid = cfg.Level_info[i + 1]
            newexp = 0
            newlevel = i + 1
            break
        else
            tempexp = tempexp - levelcfg.Number
        end
    end
    return newlevel, newexp, level_sid
end

---获取对应页签等级和经验
function SpoilsModel:GetRecyclLevelAndExp(sid)
    local info = self.RecycleDatas[sid]
    if info then
        return self:GetRecyclLevelByLevelSid(sid, info.level_sid), info.level_sid, info.exp
    else
        return 1, self:GetRecyclLevelSidByLevel(sid, 1), 0
    end
end

