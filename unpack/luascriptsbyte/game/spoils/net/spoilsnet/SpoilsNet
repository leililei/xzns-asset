local base = require("BaseGameNet")

---@class SpoilsNet : BaseGameNet	通信协议
local SpoilsNet = _G.BaseClass("SpoilsNet", base)
---@return SpoilsNet SpoilsNet
function SpoilsNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function SpoilsNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_spoils_spoils_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

