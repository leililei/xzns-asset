local SoulSupportNet = require("SoulSupportNet"):GetInstance()
local ActivitySynNet = require("ActivitySynNet"):GetInstance()

---@class SoulSupportManager : Singleton    中文描述
local SoulSupportManager = _G.BaseClass("SoulSupportManager", _G.Singleton)

SoulSupportManager.state = {
    Before = 1, --应援前
    Support = 2, --已应援
    Battle = 3, --战斗中
    Unclaimed = 4, --未领奖
    Claimed = 5, --已领奖
    NotClaimable = 6 --不可领奖（未参与应援）
}

SoulSupportManager.stage = {
    Pre = 1, --应援前
    InBattle = 2, --战斗中
    Ended = 3 --当日已结束
}

---@return SoulSupportManager SoulSupportManager
function SoulSupportManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function SoulSupportManager:__init()
end

---选择队伍
function SoulSupportManager:SelectArray(times, arrayId, callback)
    local pbData = { id = self.activity:GetActivityID(), times = times, bet = arrayId }
    SoulSupportNet:SupportSelect(pbData, function(msg)
        local cost = _G.ConfigManager.discrete_cfg[108303][1]
        _G.StorageManager:GetInstance():ConsumeItem(cost[1], 0, cost[2])
        if callback then
            callback(msg)
        end
    end)
end

---获取应援热度
function SoulSupportManager:GetArrayHeat(times, callback)
    local pbData = { id = self.activity:GetActivityID(), times = times }
    SoulSupportNet:GetHeat(pbData, function(msg)
        if callback then
            callback(msg)
        end
    end)
end

---获取详细阵容信息
function SoulSupportManager:GetArrayDetail(times, arrayId, callback)
    local pbData = { id = self.activity:GetActivityID(), times = times, team_sid = arrayId }
    SoulSupportNet:GetArrayDetail(pbData, function(msg)
        if callback then
            callback(msg)
        end
    end)
end

---战斗回放
function SoulSupportManager:Playback(times, arrayId, callback)
    local pbData = { id = self.activity:GetActivityID(), times = times, team_sid = arrayId }
    SoulSupportNet:Playback(pbData, function(msg)
        self.fight_arg = msg.data
        self:OpenStatistics(_G.BattleManager:GetInstance():GetStatisticsRecord(msg.data))
        if callback then
            callback(msg)
        end
    end)
end

function SoulSupportManager:OpenStatistics(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCountRank = _G.table.count(data.FighterInfo)
    self.PveData = {}
    local damage, win = _G.GameUtil.ShowStatisticsView(data)
    self.PveData = damage
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
            self.PveData,
            win,
            function()
            end,
            nil,
            self.otherPlayer,
            1,
            true,
            self.fight_arg
    )
end

---获取应援记录
function SoulSupportManager:GetSupportRecord(callback)
    local pbData = { id = self.activity:GetActivityID() }
    SoulSupportNet:GetSupportRecord(pbData, function(msg)
        if callback then
            callback(msg)
        end
    end)
end

---获取弹幕信息
function SoulSupportManager:GetChatData(callback)
    local pbData = { id = self.activity:GetActivityID() }
    SoulSupportNet:GetBulletInfo(pbData, function(msg)
        if callback then
            callback(msg.info)
        end
    end)
end

---发送弹幕
function SoulSupportManager:SendChatInfo(type, content, isAuto, callback)
    local pbData = { id = self.activity:GetActivityID(), type = type, content = type == 1 and content or nil, sid = type == 2 and content or nil }
    SoulSupportNet:SendBullet(pbData, function(msg)
        if callback then
            callback(msg)
        end
    end)
end

---进入下一场
function SoulSupportManager:EnterNext(callback)
    local pbData = { id = self.activity:GetActivityID() }
    SoulSupportNet:EnterNext(pbData, function(msg)
        if callback then
            callback(msg)
        end
    end)
end

---领取宝箱奖励
function SoulSupportManager:OpenBox(boxId, callback)
    ActivitySynNet:GetAward(self.activity:GetActivityID(), { boxId }, function(msg)
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        if callback then
            callback(msg)
        end
    end)
end

---获取排行榜数据
function SoulSupportManager:GetRank(callback)
    local pbData = { page = 1, id = self.activity:GetActivityID() }
    SoulSupportNet:GetRank(pbData, function(data)
        if callback then
            callback(data)
        end
    end)
end

---获取玩家个人名次
function SoulSupportManager:GetPlayerRank(callback)
    local pbData = { type = self.activity:GetActivityID() }
    SoulSupportNet:GetPlayerRank(pbData, function(data)
        self.activity.playerRank = data
        if callback then
            callback(data)
        end
    end)
end

---获取某场次数据
function SoulSupportManager:GetTimesRank(times, callback)
    local pbData = { id = self.activity:GetActivityID(), times = times }
    SoulSupportNet:GetTimesRank(pbData, function(data)
        self.activity.playerRank = data
        if callback then
            callback(data)
        end
    end)
end

---@return boolean 是否开启
function SoulSupportManager:CheckChatOpened()
    self.onChatWindowOpenTag = true
    return self.onChatWindowOpenTag
end

---设置弹幕是否开启
---@param open boolean 中文描述
function SoulSupportManager:SetChatOpenedTag(open)
    self.onChatWindowOpenTag = open
    --TODO:保存弹幕设置状态
    if open then
        _G.PlayerPrefsManager.DeleteKey("SoulSupportSaveChatTag")
    else
        _G.PlayerPrefsManager.SetInt("SoulSupportSaveChatTag", _G.TimeUtil.GetServerUnixTime())
    end
end

---销毁对象时,析构函数
function SoulSupportManager:Dispose()
end
---设置活动
function SoulSupportManager:SetActivity(activity)
    self.activity = activity
end

return SoulSupportManager
