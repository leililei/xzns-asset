    self.chatMsgMaxCount = discrete_cfg[108311][1][1]
    self.moveChatWindowX = moveChatWindowRange[2]
    self.moveChatWindowSpeed = discrete_cfg[108310][1][1] * moveChatWindowRange[2]
    self.chatWindowStartTime = discrete_cfg[108313][1][1]
    self.stage, self.lastTime, self.step = self.activity:ChangeStateByStage()
    self.curChoose = self.activity:GetCurChoose()
    self.effects = {
        blue = {"ef_bluelight", self.go_table.obj_leftEff},
        red = {"ef_redlight", self.go_table.obj_rightEff},
        vs = {"ef_vsflash", self.go_table.obj_midEff},
        vsBoom = {"ef_vsboom", self.go_table.obj_midEff},
        box = {"ef_BoxSmoke", self.go_table.obj_awardDesk},
        smoke = {"ef_SoulSupportViewSmoke", self.go_table.obj_awardDesk},
        boxRed = {"ef_boxRedpoint", self.go_table.aorrawimage_boxOpen}
    }
    local res = _G.ConfigManager.ui_cfg.SoulSupportView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
    self:InitView()
end

---初始化页面
function SoulSupportView:InitView()
    local state = self.activity.state
    self.go_table.obj_choose:SetActiveE(0)
    self.go_table.aorrawimage_icon:LoadImage(ConfigManager.currency_type_cfg[self.cost[1]].icon)
    --self.go_table.aortext_costOrTimes.text = GetLangPackValue(90029100005, self.activity:GetLastTimes())
    self:ShowSoulCard()
    self:ShowByState()
    self:RefreshSlider()
    if state == sEnum.Support then
        self:ShowChooseArray()
    end
    self:ShowChatWindow(SoulSupportManagerIns:CheckChatOpened())
    self:UpdateTime()
    if self.lastTime > 0 then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self.chooseInit = false
    self.go_table.obj_recordRedpoint:UpdateRedPointItemIDAndParam(self.activity:GetRedpointIDByIndex(2))
    self.go_table.obj_boxRedpoint:UpdateRedPointItemIDAndParam(self.activity:GetRedpointIDByIndex(3))
end

---每秒刷新
function SoulSupportView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    self.lastTime = self.lastTime - (elapsed or 1)
    if self.lastTime <= 0 then
        --if self.activity.isInBattle then
        --    return
        --end
        self.stage, self.lastTime, self.step = self.activity:ChangeStateByStage()
        self:ShowByState()
        self:RefreshSlider()
    --self.activity:RefreshRedPointRecord()
    --self.activity:RefreshRedPointBox()
    end
    if self.stage == SoulSupportManager.stage.Pre then
        self.go_table.aortext_countDown.text = GetLangPackValue(90028900002, TimeUtil.TimeToString(Mathf.RoundToInt(self.lastTime), 1))
    elseif self.stage == SoulSupportManager.stage.InBattle then
        self.go_table.aortext_countDown.text = GetLangPackValue(90029100016, TimeUtil.TimeToString(Mathf.RoundToInt(self.lastTime), 1))
    else
        self.go_table.aortext_countDown.text = GetLangPackValue(90029100027)
    end
end

---根据状态进行显隐
function SoulSupportView:ShowByState()
    local state = self.activity.state
    local isNotOver = self.activity:GetLastTimes() > 0
    --魂将相关
    SetActiveByCondition(self.go_table.obj_Middle, true)
    SetActiveByCondition(
        self.go_table.obj_Top,
        state == sEnum.Before or state == sEnum.Support or state == sEnum.Battle or
            self.stage == SoulSupportManager.stage.Ended
    )
    SetActiveByCondition(self.go_table.aorrawimage_leftBg, state == sEnum.Before or state == sEnum.Support)
    SetActiveByCondition(self.go_table.aorrawimage_rightBg, state == sEnum.Before or state == sEnum.Support)
    SetActiveByCondition(self.go_table.aortext_noSupport, state == sEnum.Before)
    SetActiveByCondition(self.go_table.obj_array, state == sEnum.Support)
    SetActiveByCondition(self.go_table.aorbtn_showDetail, state == sEnum.Support)
    --领奖桌相关
    --SetActiveByCondition(self.go_table.obj_awardDesk, state == sEnum.Unclaimed or state == sEnum.Claimed or state == sEnum.NotClaimable)
    SetActiveByCondition(self.go_table.aortext_rankNum, state == sEnum.Unclaimed or state == sEnum.Claimed)
    SetActiveByCondition(self.go_table.aortext_rankTxt, state == sEnum.Unclaimed or state == sEnum.Claimed)
    SetActiveByCondition(self.go_table.aortext_noRank, state == sEnum.NotClaimable)
    --SetActiveByCondition(self.go_table.aorrawimage_boxOpen, state == sEnum.Unclaimed)
    --SetActiveByCondition(self.go_table.aorrawimage_boxClose, state == sEnum.Claimed or state == sEnum.NotClaimable)
    self.go_table.aorrawimage_boxOpen:LoadImage(
        state == sEnum.Unclaimed and "Images/nSoulSupport/ui_hjyy_bx_kai" or "Images/nSoulSupport/ui_hjyy_bx_guan"
    )
    --战斗按钮
    SetActiveByCondition(
        self.go_table.aorbtn_fight,
        isNotOver and
            (state == sEnum.Before or state == sEnum.Unclaimed or state == sEnum.Claimed or state == sEnum.NotClaimable)
    )
    --SetActiveByCondition(self.go_table.aorimage_enterBg, state == sEnum.Before)
    SetActiveByCondition(self.go_table.aorimage_enterBg, false)
    if state == sEnum.Before then
        self.go_table.aorrawimage_enter:LoadImage(self.fightImage.Sup)
    else
        self.go_table.aorrawimage_enter:LoadImage(self.fightImage.Next)
    end
    self.go_table.aortext_rankNum.text = self.activity:GetCurRank()

    self:ShowEff(self.effects.blue, true)
    self:ShowEff(self.effects.red, true)
    self:ShowEff(self.effects.vs, true)
    self:ShowEff(self.effects.vsBoom, true)
    ---特效绑在了动画上，只能麻烦点了
    if self.lastState == sEnum.Unclaimed and state == sEnum.Claimed then
        self:ShowEff(self.effects.boxRed, false)
        SetActiveByCondition(
            self.go_table.obj_awardDesk,
            state == sEnum.Unclaimed or state == sEnum.Claimed or state == sEnum.NotClaimable
        )
    elseif self.lastState == sEnum.Unclaimed and state == sEnum.Unclaimed then
    else
        if state == sEnum.Unclaimed then
            self.go_table.obj_awardDesk:SetActiveE(0)
            self:ShowEff(
                self.effects.boxRed,
                state == sEnum.Unclaimed,
                function()
                    self:ShowEff(
                        self.effects.box,
                        state == sEnum.Unclaimed,
                        function()
                            self:ShowEff(
                                self.effects.smoke,
                                state == sEnum.Unclaimed,
                                function()
                                    SetActiveByCondition(
                                        self.go_table.obj_awardDesk,
                                        state == sEnum.Unclaimed or state == sEnum.Claimed or
                                            state == sEnum.NotClaimable
                                    )
                                end
                            )
                        end
                    )
                end
            )
        else
            self:ShowEff(self.effects.boxRed, false)
            self:ShowEff(self.effects.box, false)
            self:ShowEff(self.effects.smoke, false)
            SetActiveByCondition(
                self.go_table.obj_awardDesk,
                state == sEnum.Unclaimed or state == sEnum.Claimed or state == sEnum.NotClaimable
            )
        end
    end
    self.lastState = state
end

---@private
function SoulSupportView:ShowEff(eff, isShow, callback)
    if eff[3] then
        eff[3]:SetActiveE(isShow and 1 or 0)
        if eff == self.effects.boxRed or eff == self.effects.box or eff == self.effects.smoke then
            if not isShow then
                _G.DestroyObject(eff[3])
                eff[3] = nil
            end
        end
    elseif isShow then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[eff[1]],
            eff[2],
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                eff[3] = trans
                if callback then
                    callback()
                end
            end
        )
        return
    end
    if callback then
        callback()
    end
end

---刷新进度条显示
function SoulSupportView:RefreshSlider()
    if self.stage == SoulSupportManager.stage.Ended then
        self.go_table.slider_schedule.value = sliderStep[#sliderStep]
    else
        self.go_table.slider_schedule.value = sliderStep[self.step + 1]
    end
    local inBattle
    for i = 1, 2 do
        inBattle = self.step == i and self.stage == SoulSupportManager.stage.InBattle
        SetActiveByCondition(self.go_table["aorimage_yFire" .. i], self.step >= i and not inBattle)
        SetActiveByCondition(self.go_table["aorimage_bFire" .. i], not inBattle)
        SetActiveByCondition(self.go_table["obj_effBattle" .. i], inBattle)
    end
end

---显示魂将
function SoulSupportView:ShowSoulCard()
    local role, boss = self.activity:GetCurSoulCard()
    self.go_table.aorrawimage_leftRole:LoadImage(
        role[1],
        function(trans)
            trans:SetNativeSize()
            trans:SetLocalPosition(role[2][1], role[2][2], role[2][3])
            trans:SetLocalScaleXYZ(role[3])
            trans.Alpha = 1
        end
    )
    self.go_table.aorrawimage_rightRole:LoadImage(
        boss[1],
        function(trans)
            trans:SetNativeSize()
            trans:SetLocalPosition(boss[2][1], boss[2][2], boss[2][3])
            trans:SetLocalScaleXYZ(boss[3])
            trans.Alpha = 1
        end
    )

    local bossSkill, bossName = self.activity:GetCurBossSkill()
    local skillCfg
    for i = 1, 4 do
        skillCfg = _G.ConfigManager.card_skills_cfg[bossSkill[i]]
        local tb =
            _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, bossSkill[i]))
        _G.GameUtil.SetActiveByCondition(tb.aorimage_nuqi, skillCfg.skill_pos == 1)
        require("CardInfoManager").LoadRawImage(tb.aorrawimage_skill, skillCfg.icon)
    end

    self.go_table.aortext_leftName.text = GetLangPackValue(90029100018)
    self.go_table.aortext_rightName.text = GetLangPackValue(bossName)
end

