---点击应援队伍
function SoulSupportView:OnClickArray(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_choose" then
        self.curChoose = self.curAllArray[index].sid
        for i = 1, #self.arrayItem do
            SetActiveByCondition(self.arrayItem[i].aorimage_curChoose, i == index)
            SetActiveByCondition(self.arrayItem[i].aorbtn_choose, i ~= index)
        end
    elseif name == "@_aorbtn_showDetail" then
        if self.activity.state >= sEnum.Battle then
            PopWindowManager:ShowAllTips(850102)
            self:HideChoose()
            return
        end
        SoulSupportManagerIns:GetArrayDetail(
            self.activity:GetCurTimes(),
            self.curAllArray[index].sid,
            function(msg)
                if msg.ack == 1 then
                    UIManager:OpenWindow(ConfigManager.ui_cfg.SoulSupportDetailView.Name, msg)
                end
            end
        )
    end
end

function SoulSupportView:OnSixUpdateCall()
    --TODO:信息刷新 需要刷新界面
    if self.activity:CheckIsOpen() then
        self.stage, self.lastTime, self.step = self.activity:ChangeStateByStage()
