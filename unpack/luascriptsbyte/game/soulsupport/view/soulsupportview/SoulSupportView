        Sup = "Images/nSoulSupport/ui_hjyy_txt_yingyuan",
        Up = "Images/nSoulSupport/ui_hjyy_txt_shangzhen",
        Next = "Images/nSoulSupport/ui_hjyy_txt_xiayichang"
    }
    self.cost = ConfigManager.discrete_cfg[108303][1]
    ---@type SoulSupportView._obj_arrayItem_GoTable[]
