---显示选择应援队伍
function SoulSupportView:ShowChoose()
    self.curChoose = nil
    self.go_table.aorimage_enterBg:SetActiveE(1)
    self.go_table.obj_choose:SetActiveE(1)
    SoulSupportManagerIns:GetArrayHeat(
        self.activity:GetCurTimes(),
        function(msg)
            self.curAllArray = self.activity:GetCurAllArray()
            if not self.chooseInit then
                self.go_table.scrollloopvectical_supArray:InitItemData(
                    #self.curAllArray,
                    _G.handler(self, self.RefreshArray)
                )
                self.chooseInit = true
            else
                self.go_table.scrollloopvectical_supArray:UpdateAllItem()
            end
        end
    )
end

---刷新应援队伍item
function SoulSupportView:RefreshArray(index, obj)
    index = index + 1
    ---@type SoulSupportView._obj_arrayItem_GoTable
    local tb = GetAutoGoTable(obj, handlerbind(self, self.OnClickArray, index))
    self.arrayItem[index] = tb
    local curArray = self.curAllArray[index]
    SetActiveByCondition(self.arrayItem[index].aorimage_curChoose, self.curChoose == curArray.sid)
    SetActiveByCondition(self.arrayItem[index].aorbtn_choose, self.curChoose ~= curArray.sid)
    tb.aortext_popularity.text = curArray.heat
    local team = ConfigManager.support_equity_cfg[curArray.sid].cards_id
    local card
    for i = 1, 5 do
        card = require("ItemCardAllView").New(tb["obj_card" .. i])
        card:Show(team[i], nil, 24, nil, 300, nil, false)
    end
end

