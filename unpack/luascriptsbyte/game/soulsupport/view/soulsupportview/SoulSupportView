---是否打开弹幕
---@param show boolean 是否打开弹幕
function SoulSupportView:ShowChatWindow(show)
    self.chatMsgList = {}
    if not self.activity:CheckActivityOpened() then
        return
    end
    --弹幕开关取消显示
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_chatOpen, show)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_chatClose, not show)
    if show then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_chatWindow, true)
        if _G.table.isEmptyOrNil(self.chatMsgList) then
            SoulSupportManagerIns:GetChatData(_G.handler(self, self.OnGetChatDataCall))
        else
            self:MoveChatWindow(true)
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_chatWindow, false)
        self:MoveChatWindow(false)
    end
    SoulSupportManagerIns:SetChatOpenedTag(show)
end
function SoulSupportView:MoveChatWindow(move)
    if move then
        if self.moveChatWindowTimer then
            self.moveChatWindowTimer:Resume()
        else
            self.moveChatWindowTimer =
                _G.TimerManager:GetInstance():GetTimer(1, self.OnChatWindowMove, self, false, true)
            self.moveChatWindowTimer:Start()
        end
    else
        if self.moveChatWindowTimer then
            self.moveChatWindowTimer:Pause()
        end
        if self.onResetChatTimer then
            self.onResetChatTimer:Stop()
            self.onResetChatTimer = nil
        end
    end
end
---打开聊天频道
function SoulSupportView:ShowChatView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnChatViewClosed, self)
    --TODO:打开聊天界面 并选中活动页签，展示特殊的弹幕界面
    --TODO:拼接聊天信息
    local tab, tab2
    local channel = _G.ChatType.events
    local t = _G.TimeUtil.GetServerUnixTime()
    self.chatViewMsgTab = self.chatViewMsgTab or {}
    local index = 1
    for i = 1, #self.chatMsgList do
        tab = self.chatMsgList[i]
        if tab.role.uid > 0 then
            tab2 = self.chatViewMsgTab[index]
            if not tab2 then
                tab2 = {
                    ["channel"] = channel,
                    ["voice"] = 0,
                    ["type"] = 1,
                    ["time"] = 0,
                    ["n_content"] = {0, 0},
                    ["role_info"] = false
                }
            end
            if not tab2.n_content or type(tab2.n_content) == "string" then
                tab2.n_content = {0, 0}
            end
            tab2.role_info = tab.role
            tab2.n_content[1] = tab.type
            tab2.n_content[2] = tab.type == 1 and tab.content or tab.sid
            tab2.time = t
            self.chatViewMsgTab[index] = tab2
            index = index + 1
        end
    end
    for i = index, #self.chatViewMsgTab do
        self.chatViewMsgTab[i] = nil
    end
    self.chatView =
        _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ChatView.Name,
        _G.ChatType.support,
        self.chatViewMsgTab,
        _G.handler(self, self.OnChatCall)
    ).View
end
function SoulSupportView:OnChatViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.ChatView.Name then
