---按钮点击事件在这里派发
function SoulSupportView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        UIManager:OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 65)
    elseif not self.activity:CheckIsOpen() then
        PopWindowManager:ShowAllTips(870102)
        return
    end
    if go == self.go_table.aorbtn_showDetail then
        --显示应援队伍详情
        SoulSupportManagerIns:GetArrayDetail(
            self.activity:GetCurTimes(),
            self.curChoose,
            function(msg)
                if msg.ack == 1 then
                    UIManager:OpenWindow(ConfigManager.ui_cfg.SoulSupportDetailView.Name, msg)
                end
            end
        )
    elseif go == self.go_table.aorbtn_award then
        --打开奖励预览
        UIManager:OpenWindow(ConfigManager.ui_cfg.SoulSupportAwardPreView.Name)
    elseif go == self.go_table.aorbtn_record then
        --打开应援记录
        UIManager:OpenWindow(
            ConfigManager.ui_cfg.SoulSupportRecordView.Name,
            self.activity,
            function()
                if not self.onChoose then
                    self.stage, self.lastTime, self.step = self.activity:ChangeStateByStage()
                    self:ShowByState()
                end
            end
        )
    elseif go == self.go_table.aorbtn_rank then
        --打开排行榜
        UIManager:OpenWindow(ConfigManager.ui_cfg.SoulSupportRankView.Name)
    elseif go == self.go_table.aorbtn_curRank then
        --打开本场结果排行
        UIManager:OpenWindow(ConfigManager.ui_cfg.SoulSupportCurRankView.Name, self.activity)
    elseif go == self.go_table.aorbtn_chat then
        self:ShowChatView()
    elseif go == self.go_table.aorbtn_openBox then
        --领取奖励
        if self.activity.state == sEnum.NotClaimable then
            PopWindowManager:ShowAllTips(850103)
        elseif self.activity.state == sEnum.Claimed then
            PopWindowManager:ShowAllTips(500101)
        elseif self.activity.state == sEnum.Unclaimed then
            SoulSupportManagerIns:OpenBox(
                self.activity:GetCurTimeId(),
                function()
                    self.activity:OpenBoxHandler(self.activity:GetCurTimeId())
                    self:ShowByState()
                end
            )
        end
    elseif go == self.go_table.aorbtn_fight then
        --应援/上阵/下一场
        if self.onChoose then
            --上阵
            if self.activity.state >= sEnum.Battle then
                PopWindowManager:ShowAllTips(850102)
                self:HideChoose()
            elseif not self.curChoose then
                PopWindowManager:ShowAllTips(850104)
            elseif self.cost[2] > _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, self.cost[1]) then
                UIManager:OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.cost[1])
                self:HideChoose()
            else
                SoulSupportManagerIns:SelectArray(
                    self.activity:GetCurTimes(),
                    self.curChoose,
                    function(msg)
                        if msg.ack ~= 1 then
                            return
                        end
                        self.onChoose = false
                        self.activity:SelectArrayHandler(self.curChoose)
                        self.go_table.aorbtn_fight:SetActiveE(0)
                        self.go_table.aorimage_enterBg:SetActiveE(0)
                        self.go_table.aorrawimage_icon:SetActiveE(0)
                        self.go_table.aortext_costOrTimes.text = ""
                        self.go_table.obj_choose:SetActiveE(0)
                        self:ShowChooseArray()
                        self.activity:RefreshRedPointSupport()
                    end
                )
            end
        elseif self.activity.state == sEnum.Before then
            --应援
            self.onChoose = true
            self.go_table.aorrawimage_enter:LoadImage(self.fightImage.Up)
            self.go_table.aorrawimage_icon:SetActiveE(1)
            self.go_table.aortext_costOrTimes.text = GameUtil.NumberToUnitStr(self.cost[2])
            self:ShowChoose()
        elseif self.activity.state == sEnum.Unclaimed then
            PopWindowManager:ShowAllTips(850101)
        elseif self.activity.state == sEnum.Battle then
            PopWindowManager:ShowAllTips(850102)
        else
            --下一场
            SoulSupportManagerIns:EnterNext(
                function()
                    self.activity:EnterNextHandler()
                    self:ShowSoulCard()
                    self:ShowByState()
                    --self.go_table.aortext_costOrTimes.text = GetLangPackValue(90029100005, self.activity:GetLastTimes())
                end
            )
        end
    end
end

