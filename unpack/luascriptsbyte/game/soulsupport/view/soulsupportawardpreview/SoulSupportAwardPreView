---@class SoulSupportAwardPreView : UIBaseView    中文描述
---@field public go_table SoulSupportAwardPreView_GoTable GoTable
---@field awards discrete_cfg[] 奖励配置
local SoulSupportAwardPreView = _G.BaseClass("SoulSupportAwardPreView", _G.UIBaseView)

local ConfigManager = _G.ConfigManager
local table = _G.table
local SetActiveByCondition = _G.GameUtil.SetActiveByCondition

function SoulSupportAwardPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SoulSupportAwardPreView:OnCreate()
    self:InitView()
end

---初始化页面
function SoulSupportAwardPreView:InitView()
    local awardKeys = {108304, 108305, 108306, 108307}
    self.awards = {}
    for _, k in pairs(awardKeys) do
        table.insert(self.awards, ConfigManager.discrete_cfg[k])
    end
    local awardTb = _G.GetAutoGoTable(self.go_table.obj_Rank)
    awardTb.scrollloopvectical_rankList:InitItemData(#self.awards, _G.handler(self, self.RefreshAward))
end

---刷新item
function SoulSupportAwardPreView:RefreshAward(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    SetActiveByCondition(tb.aorimage_rankBg, index <= 3)
    SetActiveByCondition(tb.obj_rankBg2, index > 3)
    if index <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (index + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rankNum.text = index
    end
    self:ShowAward(tb, tb.obj_Award, self.awards[index])
end

---显示奖励item
function SoulSupportAwardPreView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            SetActiveByCondition(tb.list[i].gameObject, true)
        else
            SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

---按钮点击事件在这里派发
function SoulSupportAwardPreView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return SoulSupportAwardPreView
