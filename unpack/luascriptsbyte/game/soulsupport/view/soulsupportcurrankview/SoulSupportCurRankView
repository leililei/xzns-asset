local SoulSupportManager = require("SoulSupportManager"):GetInstance()

---@class SoulSupportCurRankView : UIBaseView    中文描述
---@field public go_table SoulSupportCurRankView_GoTable GoTable
---@field awards discrete_cfg[] 奖励配置
local SoulSupportCurRankView = _G.BaseClass("SoulSupportCurRankView", _G.UIBaseView)

local ConfigManager = _G.ConfigManager
local table = _G.table
local SetActiveByCondition = _G.GameUtil.SetActiveByCondition

function SoulSupportCurRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eBattleState.RecordStart, self.StartRecord)
    self:AddListener(_G.eBattleState.RecordEnd, self.EndRecord)
end

---界面的入口函数
function SoulSupportCurRankView:OnCreate(activity)
    self.activity = activity
    self.rankList = {}
    self.times = self.activity:GetCurTimes()
    SoulSupportManager:GetTimesRank(
        self.times,
        function(msg)
            self.rankData = msg.team_list or {}
            _G.SortList(
                self.rankData,
                function(a)
                    return -a.rank
                end
            )
            self:InitView()
        end
    )
end

---初始化页面
function SoulSupportCurRankView:InitView()
    local rankTb = _G.GetAutoGoTable(self.go_table.obj_Rank)
    rankTb.scrollloopvectical_rankList:InitItemData(#self.rankData, _G.handler(self, self.RefreshRank))
end

---刷新item
function SoulSupportCurRankView:RefreshRank(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = self.rankList[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.RankItemClick, index))
        self.rankList[instanceID] = tb
    end
    SetActiveByCondition(tb.aorimage_rankBg, index <= 3)
    SetActiveByCondition(tb.obj_rankBg2, index > 3)
    if index <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (index + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
    else
        tb.aortext_rankNum.text = index
    end
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(self.rankData[index].dps)
    self:ShowTeam(tb.trans_cardnode, self.rankData[index])
    if index == self.activity:GetCurRank() then
        tb.aorimage_my:SetActiveE(1)
    end
end

function SoulSupportCurRankView:ShowTeam(parent, data)
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    local teamCard = ConfigManager.support_equity_cfg[data.sid].cards_id
    for i = 1, 5 do
        if teamCard[i] then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                parent,
                function(item)
                    item:Show(teamCard[i], nil, 24, nil, 300, nil, false)
                end
            )
        end
    end
end

function SoulSupportCurRankView:RankItemClick(go, ref, index)
    local name = go:GetName()
    if name == "@_aorbtn_huifang" then
        SoulSupportManager:Playback(self.times, self.rankData[index].sid)
    end
end

---按钮点击事件在这里派发
function SoulSupportCurRankView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

---开始回放
function SoulSupportCurRankView:StartRecord()
    self:Hide()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SoulSupportView.Name)
end

---
function SoulSupportCurRankView:EndRecord()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SoulSupportView.Name)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
end

return SoulSupportCurRankView
