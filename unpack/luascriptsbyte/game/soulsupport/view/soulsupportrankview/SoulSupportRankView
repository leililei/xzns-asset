---奖励
function SoulSupportRankView:OnReward(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    if not self.Reward then
        self.RewardDatas = {}
        for _, v in pairs(_G.ConfigManager.support_rank_cfg) do
            _G.table.insert(self.RewardDatas, v)
        end
        _G.table.sort(
            self.RewardDatas,
            function(a, b)
                return a.condition_level > b.condition_level
            end
        )
        self.Reward = _G.GetAutoGoTable(self.go_table.obj_Reward)
        self.rewardList = {}
        self.rewardList_Reward = {}
        self.Reward.scrollloopvectical_itemList:InitItemData(#self.RewardDatas, _G.handler(self, self.RefreshReward2))
    end
end
---刷新奖励2
function SoulSupportRankView:RefreshReward2(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type support_rank_cfg
    local data = self.RewardDatas[newindex]
    if not self.rewardList[instanceID] then
        self.rewardList[instanceID] = _G.GetAutoGoTable(obj)
    -- self.rewardList[instanceID].scrollloophorizontal_AwardList:InitItemData(
    --     0,
    --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rewardList[instanceID])
    -- )
    end
    local tb = self.rewardList[instanceID]
    tb.data = data
    tb.aortext_rank.text = _G.GetLangPackValue(data.name)
    tb.aortext_score.text = data.condition_level

    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.reward_daily)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
end

---按钮点击事件在这里派发
function SoulSupportRankView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

---大区排行
function SoulSupportRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.SoulSupport, nil)
                self.ZoneRank = view
            end
        )
    end
end

return SoulSupportRankView
