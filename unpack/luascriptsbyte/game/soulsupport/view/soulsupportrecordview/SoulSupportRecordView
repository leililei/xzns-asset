local SoulSupportManager = require("SoulSupportManager"):GetInstance()

---@class SoulSupportRecordView : UIBaseView    中文描述
---@field public go_table SoulSupportRecordView_GoTable GoTable
---@field awards discrete_cfg[] 奖励配置
local SoulSupportRecordView = _G.BaseClass("SoulSupportRecordView", _G.UIBaseView)

local ConfigManager = _G.ConfigManager
local table = _G.table
local SetActiveByCondition = _G.GameUtil.SetActiveByCondition

function SoulSupportRecordView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SoulSupportRecordView:OnCreate(activity, callback)
    self.activity = activity
    self.callback = callback
    self.rankList = {}
    SoulSupportManager:GetSupportRecord(function(msg)
        self.activity:ParseRecord(msg)
        self.rankData = msg.info or {}
        self:InitView()
    end)
end

---初始化页面
function SoulSupportRecordView:InitView()
    local rankTb = _G.GetAutoGoTable(self.go_table.obj_Rank)
    SetActiveByCondition(rankTb.obj_no, #self.rankData <= 0)
    rankTb.scrollloopvectical_rankList:InitItemData(#self.rankData, _G.handler(self, self.RefreshRank))
    for i = 1, #self.rankData do
        if self.rankData[i].award == 0 then
            rankTb.scrollloopvectical_rankList:ScrollToIndex(_G.Mathf.Max(i - 1, 0))
            break
        end
    end
end

---刷新item
function SoulSupportRecordView:RefreshRank(index, obj)
    index = index + 1
    ---@type _obj_Rank._obj_rankItem_GoTable
    local tb = self.rankList[index]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.RankItemClick, index))
        self.rankList[index] = tb
    end
    local data = self.rankData[index]
    local rankNum = data.rank
    SetActiveByCondition(tb.aorbtn_award, data.award == 0)
    SetActiveByCondition(tb.aorimage_rankBg, rankNum <= 3)
    SetActiveByCondition(tb.obj_rankBg2, rankNum > 3)
    if rankNum <= 3 then
        tb.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (rankNum + 1)
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. rankNum
    else
        tb.aortext_rankNum.text = rankNum
    end
    local card
    local mgCfg = ConfigManager.monster_group_cfg[data.boss_sid]
    local bossSid = 101
    for _, v in pairs(mgCfg.DefaultDefenserSids[1]) do
        if v ~= 0 then
            bossSid = v
            break
        end
    end
    local bossCardSid = ConfigManager.monster_cfg[bossSid].CardID
    card = require("ItemCardAllView").New(tb.obj_cardBoss)
    card:Show(bossCardSid, nil, 24, nil, 300)
    local team = ConfigManager.support_equity_cfg[data.team_sid].cards_id
    for i = 1, 5 do
        card = require("ItemCardAllView").New(tb["obj_card" .. i])
        card:Show(team[i], nil, 24, nil, 300)
    end
end

function SoulSupportRecordView:RankItemClick(go, ref, index)
    local name = go:GetName()
    if not self.activity:CheckIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(870102)
        return
    end
    if name == "@_aorbtn_award" then
        SoulSupportManager:OpenBox(self.rankData[index].time, function(msg)
            self.activity:OpenBoxHandler(self.rankData[index].time)
            self.rankList[index].aorbtn_award:SetActiveE(0)
        end)
    end
end

---按钮点击事件在这里派发
function SoulSupportRecordView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    if go == self.go_table.aorbtn_close then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        if self.callback then
            self.callback()
        end
        self:Close()
    end
end

return SoulSupportRecordView
