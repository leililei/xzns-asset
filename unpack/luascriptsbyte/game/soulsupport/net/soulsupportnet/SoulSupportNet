local base = require("BaseGameNet")

---@class SoulSupportNet : BaseGameNet	通信协议
local SoulSupportNet = _G.BaseClass("SoulSupportNet", base)
---@return SoulSupportNet SoulSupportNet
function SoulSupportNet:GetInstance()
    return  base.GetInstance(self)
end

---确认选择应援队伍
function SoulSupportNet:SupportSelect(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_support_bet
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

