---@class WorldBossCardData	中文描述
---@field isPut boolean 是否上阵
---@field canChoose boolean 是否能选择(若当天以上上过阵则无法选择)
local WorldBossCardData = _G.BaseClass("WorldBossCardData")

---类的构造函数
function WorldBossCardData:__init()
    self.sid = 0
    self.uid = 0
    self.cardData = nil
    self.isPut = false
    self.canChoose = false
    self.power = 0
end

---类的析构函数
function WorldBossCardData:Dispose()
    self.sid = nil
    self.uid = nil
    self.cardData = nil
    self.isPut = nil
    self.canChoose = nil
    self.power = nil
end

---@param data CardData
function WorldBossCardData:Parse(data)
    self.sid = data.sid
    self.uid = data.uid
    self.lv = data.lv
    self.star = data.star
    self.cardData = data
    self.isPut = false
    self.canChoose = not require "WorldBossModel":GetInstance():CheckIsPut(data.sid)
    self.power = data:GetPower()
    self.pro = data.cfg.Professional
    self.element = data.cfg.Elements
    self.type = data.cardType
end

function WorldBossCardData:UpdateCanChoose()
    self.canChoose = not require "WorldBossModel":GetInstance():CheckIsPut(self.sid)
end

return WorldBossCardData
