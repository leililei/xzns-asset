---@class WorldBossCrusadeData	中文描述
---@field cfg boss_cfg
---@field id number boss_cfg id
---@field index number 区域
local WorldBossCrusadeData = _G.BaseClass("WorldBossCrusadeData")
local GetLangPackValue = _G.GetLangPackValue
---类的构造函数
function WorldBossCrusadeData:__init()
    self.isLock = true
    self.id = 0
    self.index = 0
end

---初始化数据
function WorldBossCrusadeData:Parse(index, cfg)
    self.index = index
    self.id = cfg.id
    self.cfg = cfg
    self:UpdateLock()
end

function WorldBossCrusadeData:UpdateLock()
    if self.index > 1 then
        self.isLock = self.id > require "WorldBossModel":GetInstance().wordData.difficulty
        if self.isLock then
            local str = GetLangPackValue(self.cfg.grade_name)
            self.LockStr = GetLangPackValue(90022500437, str)
        end
    else
        self.isLock = not require "WorldBossManager":GetInstance():CheckEnterWorldBossCrusadeView()
    end
end

---类的析构函数
function WorldBossCrusadeData:Dispose()
    self.isLock = nil
    self.id = nil
    self.index = nil
end

return WorldBossCrusadeData
