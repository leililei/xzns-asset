---@class WorldBossData	中文描述
---@field cfg boss_cfg
---@field tipID number 提示id
---@field str string 提示内容
---@field grade number 难度
---@field id number
---@field reward_first table<sid,number > 奖励
---@field skills_preview table<number> 技能
local WorldBossData = _G.BaseClass("WorldBossData")

---类的构造函数
function WorldBossData:__init()
end

---类的析构函数
function WorldBossData:Dispose()
    self.cfg = nil
    self.str = nil
    self.tipID = nil
end

---@param cfg boss_cfg
function WorldBossData:Parse(cfg)
    self.id = cfg.id
    self.cfg = cfg
    self.grade = cfg.grade
    self.isLock = self:CheckIsLock()
    self.reward_preview = cfg.reward_preview
    self.skills_preview = cfg.skills_preview
end

function WorldBossData:CheckIsLock()
    if not _G.table.isEmptyOrNil(self.cfg.limit_condition) then
        local isLock =
            not _G.GlobalConditionManager.CheckCondition(self.cfg.limit_condition[1], self.cfg.limit_condition[2])
        if isLock then
            if self.cfg.limit_condition[1] == 4 then
                local cfg = _G.ConfigManager.afk_cfg[self.cfg.limit_condition[2]]
                if cfg then
                    self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900050), cfg.chapter, cfg.section)
                end
            else
                self.lockStr = _G.string.format(_G.LangUtil.GetLangPackValue(90022900052), self.cfg.limit_condition[2])
            end
        end
        return isLock
    else
        return false
    end
end
---更新上锁状态
function WorldBossData:UpdateLock()
    self.isLock = self:CheckIsLock()
end
---显示提示
function WorldBossData:ShowTip()
    if #self.cfg.limit_condition > 0 then
        if not self.str then
            self.str, self.tipID =
                _G.FunctionManager:GetInstance():GetStrWithType(
                self.cfg.limit_condition[1],
                self.cfg.limit_condition[2]
            )
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipID, self.str)
    end
end
return WorldBossData
