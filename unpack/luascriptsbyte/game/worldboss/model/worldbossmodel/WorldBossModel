---获取敌人数据
function WorldBossModel:GetEmbattleEnemyData()
    local insert = _G.table.insert
    local data = {}
    ---@type monster_group_cfg
    local cfg
    ---@type monster_cfg
    local cfg2
    for i = 1, 3 do
        if self.BossDatas[i].isLock then
            break
        end
        data[i] = {}
        ---@type monster_group_cfg
        cfg = _G.ConfigManager.monster_group_cfg[self.BossDatas[i].cfg.monster_group]

        for j = 1, #cfg.DefaultDefenserSids[1] do
            local temp = {
                sid = 0,
                level = 0,
                star = 0,
                soulLink_lv = 0,
                power = 0
            }
            if cfg.DefaultDefenserSids[1][j] > 0 then
                cfg2 = _G.ConfigManager.monster_cfg[cfg.DefaultDefenserSids[1][j]]
                temp.sid = cfg2.CardID
                temp.level = cfg2.Level
                temp.star = cfg2.Stars
                temp.power = cfg2.Power
            end
            insert(data[i], temp)
        end
    end
    return data
end

