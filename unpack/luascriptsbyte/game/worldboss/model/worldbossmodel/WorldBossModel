function WorldBossModel:FightWin(atk_dps)
    if not self.wordData.score or self.wordData.score <= atk_dps then
        self.wordData.score = atk_dps
    end
    self.wordData.fight_num = self.wordData.fight_num + 1
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WorldBoss.id, 0)
    _G.Events:GetInstance():Broadcast("WorldBossModelRresh")
end

