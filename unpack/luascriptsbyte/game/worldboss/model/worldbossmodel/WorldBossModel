---获取其他使用
function WorldBossModel:GetOtherUseCombineSkill(index)
    local tb = {}
    local index2 = 1
    for i = 1, 3 do
        if i ~= index then
            local data = require "EmbattleModel":GetInstance():GetSkillIndex(60 + i)
            tb[index2] = data
            index2 = index2 + 1
        end
    end
    local skills = {}
    local data
    for i = 1, #tb do
        data = tb[i]
        for j = 1, #data do
            if data[j] > 0 then
                skills[data[j]] = true
            end
        end
    end
    return skills
end

