local WorldBossNet = require "WorldBossNet"
local WorldBossCardData = require "WorldBossCardData"
local WorldBossData = require "WorldBossData"
---@class WorldBossModel : Singleton	中文描述
---@field wordData world_boss.s2c_get_info
---@field curDiffculty number 当前难度
---@field bossCfg boss_cfg 当前难度配置表
---@field rankData rank.i_boss_rank[]
---@field playerRank rank.s2c_get_rank_num
---@field checkIsPutResult table<sid,boolean>
