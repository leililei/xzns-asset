---@class WorldBossNet : BaseGameNet	通信协议
local WorldBossNet = _G.BaseClass("WorldBossNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return WorldBossNet WorldBossNet
function WorldBossNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取排行榜数据
---@param callback function 完成回调
function WorldBossNet:GetRank(pbData, callback)
    local item = _G.ConfigManager.net_map.game_rank_world_boss
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取玩家在排行榜上的名次
function WorldBossNet:GetPlayerRank(callback)
    local pbData = {type = 10}
    local item = _G.ConfigManager.net_map.game_rank_get_rank_num
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取世界Boss信息
---@param callback function 完成回调
function WorldBossNet:GetWorldBossInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_world_boss_port_get_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end
---讨伐Boss
function WorldBossNet:FightCrusadeFight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_world_boss_port_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function WorldBossNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type WorldBossNet
_G.WorldBossNet = WorldBossNet
return WorldBossNet
