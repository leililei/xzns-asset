function WorldBossCrusadeView:UpdateRankAndChallengeNum()
    if self.rankPanel then
        self.rankPanel:RefreshRank()
    end
    self:UpdateChallengeNum()
end

---更新挑战次数
function WorldBossCrusadeView:UpdateChallengeNum()
    self.go_table.aortext_challengeNum.text = require "WorldBossModel":GetInstance():GetCrusadeNum()
    self.go_table.obj_label:SetActiveE(WorldBossModel:GetInstance():CheckIsFirst() and 1 or 0)
end
function WorldBossCrusadeView:RefreshPanel()
    self.wordData = WorldBossModel:GetInstance().wordData
    self.curBossCfg = WorldBossModel:GetInstance().bossCfg
    self:UpdateChallengeNum()
    self:ShowUnLockArea()
    if self.rankPanel then
        self.rankPanel:RefreshRank()
    end
end

---显示已解锁区域
function WorldBossCrusadeView:ShowUnLockArea()
    self:UpdateBossInfo()
end

---刷新boss信息
function WorldBossCrusadeView:UpdateBossInfo()
    self.go_table.aortext_bossName.text = _G.GetLangPackValue(self.curBossCfg.name)
    --self.go_table.aorrawimage_boss:LoadImage(self.curBossCfg.boss_preview)
    --self.go_table.aorrawimage_boss:SetNativeSize()
    local curCfg = _G.ConfigManager.system_cfg[functionId]
    local curId = self.curBossCfg.id
    local spine = curCfg.boss_picture[curId]
    local pos = curCfg.pos_portrait[curId]
    _G.PoolsManager:GetInstance():Spawn(
        spine,
        _G.ePoolType.Temporary,
        self.go_table.trans_CardSpine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            GameUtil.SetCardUiSpineAnimation(trans,"stand_1",true)
            self.go_table.trans_CardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
            self.go_table.trans_CardSpine:SetLocalScaleXYZ(pos[4])
        end
    )
end

---初始化奖励
function WorldBossCrusadeView:InitReward()
    self.go_table.scrollloophorizontal_Award:InitItemData(
        #self.curBossCfg.reward_preview,
        _G.handler(self, self.RefreshAward)
    )
end

---刷新奖励显示
function WorldBossCrusadeView:RefreshAward(index, trans)
    local newIndex = index + 1
    local instanceID = trans:GetInstanceIDE()
    local data = self.curBossCfg.reward_preview[newIndex]
    local item = self.DifficultyItems[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(trans, _G.handler(self, self.OnClickAward), 88, trans)
        self.DifficultyItems[instanceID] = item
    end
    local data = _G.StorageManager:GetInstance():GetItemDataClass(data, 0)
    item:Show(data)
end

---点击奖励回调
function WorldBossCrusadeView:OnClickAward(tb)
    CommonTipManager:GetInstance():OpenTip(tb.gameObject, tb.data.sid)
end

function WorldBossCrusadeView:InitRank()
    self.rankData = WorldBossModel:GetInstance().rankData or {}
    local count = #self.rankData
    self.go_table.looplist2_RankList:InitListView(count, _G.handler(self, self.RefreshRankItem))
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_No, count == 0)
    self:InitPlayer()

end

---按钮点击事件在这里派发
function WorldBossCrusadeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_challenge then
        if require "WorldBossModel":GetInstance():GetBossData(1).isLock then
            return
        end
        if WorldBossManager:GetInstance():CheckIsStop() then
            return
        end
        if require "WorldBossModel":GetInstance():GetCrusadeNum() <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(310110)
            return
        end
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        --是否满足跳过战斗开启条件
        local showSkipBattle = self:IsShowSkipBattle()
        WorldBossManager:GetInstance():OnCrusade(showSkipBattle)
    elseif go == self.go_table.aorbtn_rankDetail then
        WorldBossModel:GetInstance():UpdateRank(
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name, _G.CommonRankType.WorldBoss)
                -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossRankView.Name)
            end
        )
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossIntroduceView.Name, 204)
    end
end

---刷新跳过战斗状态
---@return void
function WorldBossCrusadeView:RefreshSkipBattleState()
    --读取解锁配置并显示文本
    local params = _G.ConfigManager.discrete_cfg[115603]
    if not params then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    local ok, content = _G.GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    if ok then
        self.go_table.obj_skipBg:SetActiveE(0)
        return
    end
    if content then
        self.go_table.aortext_skipTip.text = content
    end
    self.go_table.obj_skipBg:SetActiveE(content and 1 or 0)
end
---是否显示跳过战斗按钮
---@return boolean
function WorldBossCrusadeView:IsShowSkipBattle()
    local params = _G.ConfigManager.discrete_cfg[115603]
    if not params then
        return false
    end
    local ok = _G.GlobalConditionManager.CheckConditionArrays(params)
    return ok
end

function WorldBossCrusadeView:OnDestroy()
    _G.Events:GetInstance():RemoveListener("WorldBossUpdate", self.RefreshPanel, self)

    if self.refreshViewTimer then
        self.refreshViewTimer:Stop()
        self.refreshViewTimer = nil
    end
end

return WorldBossCrusadeView
