function WorldBossCrusadeView:Awake()
    _G.AddViewBtnClick(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.RankList = {}
    self.DifficultyItems = {}

    --添加倒计时定时器(跳过战斗解锁可配置时间)
    if not self:IsShowSkipBattle() then
        self.refreshViewTimer =
            _G.TimerManager:GetInstance():GetTimer(1, self.RefreshSkipBattleState, self, false, true)
        self.refreshViewTimer:Start()
    end
end

---界面的入口函数
function WorldBossCrusadeView:OnCreate()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.WorldBossCrusadeView, self.go_table)
    WorldBossModel:GetInstance():UpdateBossData()
    self.wordData = WorldBossModel:GetInstance().wordData
    self.curBossCfg = WorldBossModel:GetInstance().bossCfg
    self:InitPanel()
    self:UpdateChallengeNum()
    self.rankPanel =
        self:AddComponent(
        self.go_table.obj_littleZonePanel,
        require "LittleZoneRankView".New(_G.ZoneRankType.WorldBoss)
    )
    _G.Events:GetInstance():AddListener("WorldBossUpdate", self.RefreshPanel, self)
    self:AddListener("WorldBossModelRresh", self.UpdateRankAndChallengeNum)
    self.go_table.obj_inforedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CopyExplain.id, 204)
    local res = _G.ConfigManager.ui_cfg.WroldBossView.resources
    self:AddComponent(self.go_table.obj_GoldInfo, require("ResourceCompont").New(self.go_table.obj_GoldInfo, res))
    self:AddComponent(self.go_table.obj_PlayerHead, require("PlayerComponent").New(self.go_table.obj_PlayerHead))
    self:RefreshSkipBattleState()

end

---初始化Panel显示
function WorldBossCrusadeView:InitPanel()
    self:ShowUnLockArea()
    self:InitReward()
    self:InitEffect()
    self:InitToggle()
end

function WorldBossCrusadeView:InitToggle()
    self.go_table.aorbtn_rank:SetActiveE(0)

    local check = function(o)
        o:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
        if self:IsNil() then
            RemoveEffect(o)
        end
    end

    if not self.Toggles then
        self.Toggles = {
            _G.GetAutoGoTable(self.go_table.toggle_1),
            _G.GetAutoGoTable(self.go_table.toggle_2),
            _G.GetAutoGoTable(self.go_table.toggle_3)
        }
    end
    local curIndex = self.curBossCfg.id
    self.go_table["toggle_" .. curIndex].isOn = true

    for i, v in ipairs(self.Toggles) do
        ---@type WorldBossData
        local data = require "WorldBossModel":GetInstance():GetBossData(i)
        _G.GameUtil.SetActiveByCondition(v.obj_lock, data.isLock)
        if AppSetting.IsXzns then 
            self.Toggles[i].aortext_label1.text= _G.LangUtil.GetLangPackValue(data.cfg.grade_name)
            self.Toggles[i].aortext_label2.text=_G.LangUtil.GetLangPackValue(data.cfg.grade_name)
        end
        self.Toggles[i].aorimage_isOff:SetActiveE(i == curIndex and 0 or 1)
        self.Toggles[i].aorimage_isOn:SetActiveE(i == curIndex and 1 or 0)
        if (i > 1) then
            self.go_table["slider_Progress" .. i - 1].value = data.isLock and 0 or 1
        end
        if data.isLock then
            v.aortext_lock.text = data.lockStr
            v.aorimage_isOff.SpriteName = "ui_box_yeqian1"
            v.aorimage_isOff:SetGray(true)
            v.aortext_label1.color = _G.ColorTools.FormatColorByString("222222")
        else
            if v.obj_eff:GetChildCountE() > 0 then
                v.obj_eff:SetActiveE(0)
                v.obj_eff:SetActiveE(1)
            else
                --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_fubentongyongjiesuo, v.obj_eff, check)
            end
            v.aorimage_isOff:SetGray(false)
            v.aorimage_isOff.SpriteName = "ui_box_yeqian0"
            v.aortext_label1.color = _G.ColorTools.FormatColorByString("400E0E")
            v.obj_lock:SetActiveE(1)
            v.aorimage_suo:SetActiveE(0)
            local cfg = _G.ConfigManager.afk_cfg[data.cfg.limit_condition[2]]
            v.aortext_lock.text =
                _G.string.format(_G.LangUtil.GetLangPackValue(90022900050), cfg.chapter, cfg.section)
            v.obj_lock:SetActiveE(0)
        end
    end
end

