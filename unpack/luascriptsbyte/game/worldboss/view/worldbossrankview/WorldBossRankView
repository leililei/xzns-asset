function WorldBossRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.itemList = {}
    self:AddListener(_G.eBattleState.RecordStart, self.RecordStart)
    self:AddListener(_G.eBattleState.RecordEnd, self.RecordEnd)
    self:IsBool()
end

function WorldBossRankView:RecordStart()
    self:Hide()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
end

function WorldBossRankView:RecordEnd()
    self:Show()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
end

---界面的入口函数
function WorldBossRankView:OnCreate()
    self.RewardDatas = _G.table.toArray(_G.ConfigManager.boss_rank_cfg)
    _G.table.sort(
        self.RewardDatas,
        function(a, b)
            return a.id < b.id
        end
    )
    self:InitToggle()
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
    ---排行回放 不会关闭 挑战界面
    local ChangllengeView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    if ChangllengeView then
        ChangllengeView:Hide()
    end
end

function WorldBossRankView:InitToggle()
    self.Toggles = {}
    self.Toggles["Rank"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnToggle, "Rank", _G.handler(self, self.OnRank))
        )
    self.Toggles["Reward"] =
        _G.GetAutoGoTable(
            self.go_table.toggle_reward,
            _G.handlerbind(self, self.OnToggle, "Reward", _G.handler(self, self.OnReward))
        )
    if require "ZoneRankModel":GetInstance():CheckIsOpen(_G.ZoneRankType.WorldBoss) then
        self.go_table.toggle_zoneRank:SetActiveE(1)
        self.Toggles["ZoneRank"] =
            _G.GetAutoGoTable(
                self.go_table.toggle_zoneRank,
                _G.handlerbind(self, self.OnToggle, "ZoneRank", _G.handler(self, self.OnZoneRank))
            )
    else
        self.go_table.toggle_zoneRank:SetActiveE(0)
    end
    self.go_table.toggle_rank:SetActiveE(
        require "ZoneRankModel":GetInstance():CheckIsShowSingle(_G.ZoneRankType.WorldBoss) and 1 or 0
    )
end

---点击Togggle
function WorldBossRankView:OnToggle(go, isOn, key, call)
    local tb = self.Toggles[key]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    if call then
        call(isOn)
    end
end

---大区排行
function WorldBossRankView:OnZoneRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, isOn)
    if not isOn then
        return
    end
    if not self.ZoneRank then
        local name = "UI/ZoneRank/$_obj_zoneRank"
        _G.PoolsManager:GetInstance():Spawn(
            name,
            _G.ePoolType.Temporary,
            self.go_table.obj_ZoneRank,
            function(trans)
                _G.GameUtil.SetActiveByCondition(trans, true)
                local view = self:AddComponent(trans.gameObject, require "ZoneRankView".New(trans, self))
                view:InitView(_G.ZoneRankType.WorldBoss, nil)
                self.ZoneRank = view
            end
        )
    end
end

---排行
function WorldBossRankView:OnRank(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
        self.rankList = {}
        self.rewardList_Rank = {}
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.RefreshRank))
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer()
    end
end

