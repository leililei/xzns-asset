function WorldBossRankView:RankItemClick(go, ref, tb)
    local data = tb.rankData
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.uid > 0 then
            if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.uid)
            end
        end
    elseif name == "@_aorbtn_huifang" then
        require "DungonesModel":GetInstance():PlayRankHuiFang(10, data.uid)
    end
end

function WorldBossRankView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

function WorldBossRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in ipairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示玩家排行
function WorldBossRankView:InitPlayer()
    self.playerRank = require "WorldBossModel":GetInstance().playerRank
    if not self.player then
        self.player =
            _G.GetAutoGoTable(
                self.Rank.obj_player,
                _G.handlerbind(self, self.RankItemClick,
                    { rankData = { uid = _G.PlayerModel:GetInstance():GetPlayerUid() } })
            )
        -- self.player.scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.player)
        -- )
    end
    local tb = self.player
    local newindex = self.playerRank.index
    tb.data = self:GetRankData(newindex)
    if newindex == 0 then
        tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
    else
        tb.aortext_rankNum.text = newindex
    end
    local playerModel = _G.PlayerModel:GetInstance()
    local playerData = {}
    tb.aortext_name.text = playerModel:GetName()
    playerData.frame = playerModel:GetCurFrame()
    playerData.style = playerModel:GetRoleStyle()
    playerData.uid = playerModel:GetPlayerUid()
    playerData.lv = playerModel:GetLevel()
    playerData.title = playerModel:GetTitle()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, playerData, 1, true, true, true)
    tb.aortext_damage.text = _G.GameUtil.NumberToUnitStr(self.playerRank.value)
    if tb.data then
        self:ShowAward(tb, tb.obj_item, tb.data.reward_daily, tb.obj_item:GetChildE(0))
    else
        self:ShowAward(tb, tb.obj_item, {}, tb.obj_item:GetChildE(0))
    end
end

---刷新奖励
function WorldBossRankView:RefreshReward(index, obj, list, tb)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.reward_daily[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end

---奖励
function WorldBossRankView:OnReward(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Reward, isOn)
    if not isOn then
        return
    end
    local str = _G.LangUtil.GetLangPackValue(91200001501)
    if not self.ZoneRewardRank then
        _G.PoolsManager:GetInstance():Spawn(
            require "ZoneRankModel".GetRewardPrefabPath(),
            _G.ePoolType.Temporary,
            self.go_table.obj_Reward,
            function(trans)
                if self:IsNil() then
                    return
                end
                local view = self:AddComponent(trans.gameObject, require "ZoneRankRewardView".New(trans, self))
                view:InitView(_G.ZoneRankType.MonsterSiege, nil, self.RewardDatas, str)
                self.ZoneRewardRank = view
            end
        )
    end
end

---刷新奖励2
function WorldBossRankView:RefreshReward2(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    ---@type boss_rank_cfg
    local data = self.RewardDatas[newindex]
    if not self.rewardList[instanceID] then
        self.rewardList[instanceID] = _G.GetAutoGoTable(obj)
        -- self.rewardList[instanceID].scrollloophorizontal_AwardList:InitItemData(
        --     0,
        --     _G.handlerbind(self, self.RefreshReward, self.rewardList_Rank, self.rewardList[instanceID])
        -- )
    end
    local tb = self.rewardList[instanceID]
    tb.data = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rank, newindex <= 3)
    if newindex <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. newindex
        tb.aortext_rank.text = ""
    elseif data.min_rank == data.max_rank then
        tb.aortext_rank.text = newindex
    else
        tb.aortext_rank.text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.reward_daily)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
end

---按钮点击事件在这里派发
function WorldBossRankView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)

    if go == self.go_table.aorbtn_close then
        self:Close()
        ---排行回放 不会关闭 挑战界面
        local ChangllengeView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        if ChangllengeView then
            ChangllengeView:Show()
        end
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
        if window then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
        end
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
        ---排行回放 不会关闭 挑战界面
        local ChangllengeView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        if ChangllengeView then
            ChangllengeView:Show()
        end
        local window = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
        if window then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.WorldBossBattleView.Name)
        end
    end
end

return WorldBossRankView
