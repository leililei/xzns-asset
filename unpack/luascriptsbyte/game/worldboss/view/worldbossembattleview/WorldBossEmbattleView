function WorldBossEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Areas = {}
    self.CardItems = {}
end

---界面的入口函数
function WorldBossEmbattleView:OnCreate()
    self.worldData = WorldBossModel:GetInstance().wordData
    self.bossCfg = WorldBossModel:GetInstance().bossCfg
    self.realPower = 0
    self.maxArea = 3
    self.isOver = false
    self:InitArea()
    self:InitCard()
    self.changeNum = WorldBossModel:GetInstance():GetCrusadeNum()
    self:UpdateChangllengeNun()
end

function WorldBossEmbattleView:UpdateChangllengeNun()
    self.go_table.aortext_changllengeNum.text = require "WorldBossModel":GetInstance():GetCrusadeNum()
end
---初始化战区
function WorldBossEmbattleView:InitArea()
    WorldBossModel:GetInstance():UpdateCombineSkillState()
    local tb = WorldBossModel:GetInstance().BossDatas
    local count = #tb
    for i = 1, count do
        local area =
            WorldBossWorldArea.New(
            self.go_table["obj_Area" .. i],
            i,
            self.go_table.trans_moveParent,
            _G.handler(self, self.OnClickAreaPos),
            _G.handler(self, self.OnMoveEnd)
        )
        area:Show(tb[i])
        self.Areas[i] = area
    end
end

---一键上阵
function WorldBossEmbattleView:OnAuto()
    if self.isOver then
        _G.PopWindowManager:GetInstance():ShowAllTips(310109)
        return
    end
    local Cards =
        WorldBossModel:GetInstance():GetAutoCard(
        self.CardDatas.Hero,
        self.CardDatas.Guardian,
        WorldBossModel:GetInstance().maxTeamNum
    )
    if _G.table.count(Cards) == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(310111)
        return
    end
    for i = 1, 3 do
        if self.Areas[i]:GetIsLock() then
            break
        end
        for j = 1, 5 do
            if not self.Areas[i]:GetCardIsEmpty(j) then
                local data = self.Areas[i]:GetItem(j).data
                if data.type == _G.HeroType.Hero then
                    self:ChangeOtherCard(data.sid, data.uid, true, self.CardDatas.Hero)
                else
                    self:ChangeOtherCard(data.sid, data.uid, true, self.CardDatas.Guardian)
                end
            end
        end
        self.Areas[i]:Clear()
    end
    for i = 1, 3 do
        if self.Areas[i]:GetIsLock() then
            break
        end
        for j = 1, 5 do
            local data = Cards[j + (i - 1) * 5]
            if data then
                if data.type == _G.HeroType.Hero then
                    self:ChangeOtherCard(data.sid, data.uid, false, self.CardDatas.Hero)
                else
                    self:ChangeOtherCard(data.sid, data.uid, false, self.CardDatas.Guardian)
                end
            end
            self.Areas[i]:UpdateCard(j, data)
        end
    end
    self.curIndex = 1
    self.curGrounp = 1
    self.isOver = true
    self:SortCard()
end

---讨伐
function WorldBossEmbattleView:OnPlay()
    if require "WorldBossModel":GetInstance():GetCrusadeNum() <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(310110)
        return
    end
    local ids = {}
    local data = {}
    for i, v in ipairs(self.Areas) do
        if not v:GetIsLock() then
            local isHave = false
            for _, v2 in pairs(v.Items) do
                if not v2:GetIsEmpty() then
                    isHave = true
                    break
                end
            end
            if isHave then
                _G.table.insert(ids, 60 + v.cfg.id)
            end

            data[i] = {}
            for j = 1, 5 do
                local item = v:GetItem(j)
                if item:GetIsEmpty() then
                    data[i][j] = 0
                else
                    data[i][j] = item.data.uid
                end
            end
        end
    end

    if self:CheckArea() then
        require "EmbattleModel":GetInstance():SaveEmbattleDataTable(
            ids,
            function()
                self:StartCrusade(ids)
            end,
            data
        )
    else
        if _G.table.count(ids) == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(310108)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(310112)
        end
    end
end
---检测战区是否上人
function WorldBossEmbattleView:CheckArea()
    if self.maxArea <= 1 then
        return true
    end
    local isEmptyTB = {}
    for i = 1, 3 do
        if self.Areas[i]:GetIsLock() then
            isEmptyTB[i] = true
        else
            for j = 1, 5 do
                if not self.Areas[i]:GetCardIsEmpty(j) then
                    isEmptyTB[i] = false
                    break
                elseif j == 5 then
                    isEmptyTB[i] = true
                end
            end
        end
    end
    if not isEmptyTB[1] then
        if not isEmptyTB[3] and isEmptyTB[2] then
            return false
        end
        return true
    end
    if isEmptyTB[1] or isEmptyTB[2] then
        return false
    end
    return true
end

function WorldBossEmbattleView:StartCrusade(ids)
    WorldBossManager:GetInstance():StartCrusade(
        ids,
        function()
            self:CloseView()
        end
    )
end
---检测是否有卡牌上阵
function WorldBossEmbattleView:CheckIsPut()
    local isPut = false
    local isAll = true
    for i = 1, 3 do
        local area = self.Areas[i]
        if area:GetIsLock() then
            break
        end
        for j = 1, 5 do
            if not area:GetCardIsEmpty(j) then
                isPut = true
            else
                isAll = false
            end
        end
    end
    return isPut, isAll
end

