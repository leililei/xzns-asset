function WorldBossEmbattleView:SetImageFont(ValueStr, aorImageFont)
    local index = 1
    if ValueStr ~= nil then
        if aorImageFont == nil then
            return
        end
        local names = aorImageFont.SpriteNames
        local Count = string.len(ValueStr)
        for i = 1, Count do
            local nowstr = string.sub(ValueStr, i, i)
            if names[nowstr] ~= nil then
                if i > #self.FontImage_lv then
                    local obj =
                        _G.InstantiateObject(
                        self.FontImage_lv[1].gameObject,
                        self.FontImage_lv[1].gameObject:GetParent()
                    )
                    _G.table.insert(self.FontImage_lv, _G.GetAutoGoTable(obj))
                end
                self.FontImage_lv[index].gameObject:SetActiveE(1)
                self.FontImage_lv[index].aorimage_power.SpriteName = names[nowstr]
                self.FontImage_lv[index].aorimage_power1.SpriteName = names[nowstr]
                self.FontImage_lv[index].aorimage_power:SetNativeSize()
                self.FontImage_lv[index].aorimage_power1:SetNativeSize()
                index = index + 1
            end
        end
    end

    if index <= #self.FontImage_lv then
        for i = index, #self.FontImage_lv do
            self.FontImage_lv[i].gameObject:SetActiveE(0)
        end
    end
end

