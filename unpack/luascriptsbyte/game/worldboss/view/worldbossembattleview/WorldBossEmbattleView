---按钮点击事件在这里派发
function WorldBossEmbattleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_autoPut then
        self:OnAuto()
    elseif go == self.go_table.aorbtn_play then
        if WorldBossManager:GetInstance():CheckIsStop() then
            return
        end
        self:OnPlay()
    end
end

function WorldBossEmbattleView:CloseView()
    if self.refreshPowerTimer then
        self.refreshPowerTimer:Stop()
        self.refreshPowerTimer = nil
    end
    self:Close()
end

---更新卡牌显示
function WorldBossEmbattleView:InitCard()
    self.Card = _G.GetAutoGoTable(self.go_table.obj_choose, _G.handler(self, self.OnClickChoose))
    self.CardDatas, self.initPut = WorldBossModel:GetInstance():GetCardData()
    self.cardType = _G.CardElementType.None
    self.curCardDatas = self.CardDatas[self.cardType]

    self:SetCurIndex(1, 1)
    self:InitPut()
    self.Card.scrollloophorizontal_card:InitItemData(#self.curCardDatas, _G.handler(self, self.RefreshCardItem))
end

function WorldBossEmbattleView:InitPut()
    local Cards = self.initPut
    self.isOver = true
    for i = 1, 3 do
        if self.Areas[i]:GetIsLock() then
            break
        end
        if Cards[i] then
            for j = 1, 5 do
                local data = Cards[i][j]

                if data then
                    if data.type == _G.HeroType.Hero then
                        self:ChangeOtherCard(data.sid, data.uid, false, self.CardDatas.Hero)
                    else
                        self:ChangeOtherCard(data.sid, data.uid, false, self.CardDatas.Guardian)
                    end
                else
                    self.isOver = false
                end
                self.Areas[i]:UpdateCard(j, data)
            end
        else
            self.isOver = false
        end
    end
end

function WorldBossEmbattleView:OnClickChoose(go, isOn)
    local type = _G.CardElementType.None
    if go == self.Card.aorbtn_all then
        type = _G.CardElementType.None
    elseif go == self.Card.aorbtn_feng then
        type = _G.CardElementType.Wind
    elseif go == self.Card.aorbtn_lei then
        type = _G.CardElementType.Thunder
    elseif go == self.Card.aorbtn_shui then
        type = _G.CardElementType.Water
    elseif go == self.Card.aorbtn_huo then
        type = _G.CardElementType.Fire
    elseif go == self.Card.aorbtn_tu then
        type = _G.CardElementType.Earth
    elseif go == self.Card.aorbtn_shen then
        type = _G.CardElementType.God
    end
    if type == self.cardType then
        return
    end
    self.cardType = type
    self.curCardDatas = self.CardDatas[self.cardType] or {}
    local x = go:GetLocalPosition()
    self.Card.trans_choose:SetAnchorPosition(x, 124)
    self.Card.scrollloophorizontal_card:UpdateCount(#self.curCardDatas)
end

---更新卡牌显示
---@param listView2 SuperScrollView.LoopListView2
function WorldBossEmbattleView:RefreshCardItem(index, item)
    local newIndex = index + 1
    local instanceID = item:GetInstanceIDE()
    local data = self.curCardDatas[newIndex]
    if not self.CardItems[instanceID] then
        local tb = require "WorldBossEmabttleCardItem".New(item, _G.handler(self, self.OnClickCard))
        self.CardItems[instanceID] = tb
        tb:Show(data, newIndex)
    else
        local tb = self.CardItems[instanceID]
        tb:Show(data, newIndex)
    end
end

---点击下部卡牌
function WorldBossEmbattleView:OnClickCard(tb)
    local data = self.curCardDatas[tb.index]
    if data.isPut then
        self:UnPut(data)
        return
    end
    if self.isOver then
        _G.PopWindowManager:GetInstance():ShowAllTips(310109)
        return
    end

    if not data.canChoose then
        _G.PopWindowManager:GetInstance():ShowAllTips(310111)
        return
    end
    self.Areas[self.curGrounp]:UpdateCard(self.curIndex, data)

    self:ChangeOtherCard(data.sid, data.uid, false)
    local index, grounp = self:ChengeNext(self.curIndex, self.curGrounp)
    self:SetCurIndex(index, grounp)
    require "WorldBossModel":GetInstance():SortAllCard()
    self.Card.scrollloophorizontal_card:UpdateAllItem()
end
---下阵卡牌
---@param data WorldBossCardData
function WorldBossEmbattleView:UnPut(data)
    if not data.isPut then
        return
    end
    data.isPut = false
    local isFind = false
    local grounp, index = 0, 0
    for i, v in ipairs(self.Areas) do
        if not v:GetIsLock() then
            grounp = i
            for j, v2 in ipairs(v.Items) do
                if not v2:GetIsEmpty() and v2.data.uid == data.uid then
                    index = j
                    v2:UnPut()
                    isFind = true
                    break
                end
            end
        end
        if isFind then
            break
        end
    end
    if data.type == _G.HeroType.Hero then
        self:ChangeOtherCard(data.sid, data.uid, true, self.CardDatas.Hero)
    else
        self:ChangeOtherCard(data.sid, data.uid, true, self.CardDatas.Guardian)
    end
    self:SetCurIndex(index, grounp)
    require "WorldBossModel":GetInstance():SortAllCard()
    self.Card.scrollloophorizontal_card:UpdateAllItem()
    self.isOver = false
end

---隐藏同sid的卡牌
function WorldBossEmbattleView:ChangeOtherCard(sid, uid, bool, cardData)
    local cardDataTB = nil
    if cardData then
        cardDataTB = cardData
    else
        cardDataTB = self.curCardDatas
    end

    for _, v in pairs(cardDataTB) do
        if v.sid == sid and v.uid ~= uid then
            v.canChoose = bool
        end
    end
end

---点击卡牌区域
function WorldBossEmbattleView:OnClickAreaPos(index, grounp, data)
    self:SetCurIndex(index, grounp)

    if data then
        self:ChangeOtherCard(data.sid, data.uid, true)
    end
    self:SortCard()
    self.isOver = false
end

function WorldBossEmbattleView:SortCard()
    require "WorldBossModel":GetInstance():SortAllCard()
    self.Card.scrollloophorizontal_card:UpdateAllItem()
end

---移动卡牌结束
function WorldBossEmbattleView:OnMoveEnd(index, grounp)
    local newIndex, newGrounp = 0
    for i = 1, 3 do
        newGrounp = i
        if self.Areas[i]:GetIsLock() then
            break
        end
        newIndex = self.Areas[i]:CheckInRect(index, grounp)
        if newIndex > 0 then
            break
        end
    end
    if newIndex > 0 then
        self:ChangePos(index, grounp, newIndex, newGrounp)
    else
        self.Areas[grounp].Items[index]:ResetItemPos()
    end
end

---更换卡牌位置
function WorldBossEmbattleView:ChangePos(index1, grounp1, index2, grounp2)
    local item1 = self.Areas[grounp1]:GetItem(index1)
    local item2 = self.Areas[grounp2]:GetItem(index2)
    local cardItem = item1.cardItem
    local data = item1.data
    item1:SetData(item2.data, item2.cardItem)
    item2:SetData(data, cardItem)
    local index, grounp = self:ChengeNext(self.curIndex, self.curGrounp)
    self:SetCurIndex(index, grounp)
end

---设置当前位置卡牌
function WorldBossEmbattleView:SetCurIndex(index, grounp)
    if self.curIndex == index and self.curGrounp == grounp then
        return
    end
    self.curIndex = index
    self.curGrounp = grounp
end

---切换到下个位置
function WorldBossEmbattleView:ChengeNext(index, _grounp)
    local grounp = _grounp

    if grounp > 3 or self.Areas[grounp]:GetIsLock() then
        for i = 1, 3 do
            if self.Areas[i]:GetIsLock() then
                break
            end
            for j = 1, 5 do
                if self.Areas[i]:GetCardIsEmpty(j) then
                    return j, i
                end
            end
        end
        self.isOver = true
        return self.curIndex, self.curGrounp
    end

    for i = index, 5 do
        if self.Areas[grounp]:GetCardIsEmpty(i) then
            return i, grounp
        end
    end
    return self:ChengeNext(1, grounp + 1)
end

