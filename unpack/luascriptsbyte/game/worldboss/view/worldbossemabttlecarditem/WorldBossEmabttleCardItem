---@class WorldBossEmabttleCardItem	中文描述
local WorldBossEmabttleCardItem = _G.BaseClass("WorldBossEmabttleCardItem")

---类的构造函数
function WorldBossEmabttleCardItem:__init(obj, call)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.call = call
end
---@param data WorldBossCardData
function WorldBossEmabttleCardItem:Show(data, index)
    self.data = data
    self.index = index
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            self.go_table.trans_root,
            function(view)
                self.item = view
                self.item:ShowCardData(data.cardData)
            end
        )
    else
        self.item:ShowCardData(data.cardData)
    end
    self:ShowCardLock()
end

function WorldBossEmabttleCardItem:ShowCardLock()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_shadow, self.data.isPut)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_sameTips, not self.data.canChoose)
    if not self.data.canChoose then
        if require "WorldBossModel":GetInstance():CheckIsPut(self.data.sid) then
            self.go_table.aortext_same.text = _G.LangUtil.GetLangPackValue(90022900037)
        else
            self.go_table.aortext_same.text = _G.LangUtil.GetLangPackValue(90024900021)
        end
    end
end

function WorldBossEmabttleCardItem:OnClickBtn()
    if self.call then
        self.call(self)
    end
end

---类的析构函数
function WorldBossEmabttleCardItem:Dispose()
end
return WorldBossEmabttleCardItem
