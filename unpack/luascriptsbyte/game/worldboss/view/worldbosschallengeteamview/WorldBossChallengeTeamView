local WorldBossTeamCreate = realRequire "WorldBossTeamCreate"
---@class WorldBossChallengeTeamView : UIBaseView	中文描述
---@field public go_table WorldBossChallengeTeamView_GoTable GoTable
local WorldBossChallengeTeamView = _G.BaseClass("WorldBossChallengeTeamView", _G.UIBaseView)

function WorldBossChallengeTeamView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldBossChallengeTeamView:OnCreate(changeCall, data, enemyTeam, enemyInfo, combSkill, groupState)
    self.onChangeCall = changeCall
    self.curShowIndex = { 1, 2, 3 }
    self.team = WorldBossTeamCreate(self.go_table.obj_mTeam, true, _G.handler(self, self.OnTeamChanged), groupState)
    self.team:Show(data, combSkill)
    self.enemyTeam = WorldBossTeamCreate(self.go_table.obj_eTeam)
    self.enemyTeam:Show(enemyTeam, { {}, {}, {} })
    self:ShowInfo(enemyInfo)
end

function WorldBossChallengeTeamView:OnDestroy()
    self.team:Dispose()
    self.team = nil
    self.onChangeCall = nil
    self.curShowIndex = nil
    self.enemyTeam:Dispose()
    self.enemyTeam = nil
end

---按钮点击事件在这里派发
function WorldBossChallengeTeamView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        self:Close()
    elseif go == self.go_table.aorbtn_Done then
        self:Close()
        self.onChangeCall(self.curShowIndex)
    end
end

function WorldBossChallengeTeamView:OnTeamChanged(index1, index2)
    self.curShowIndex[index1] = self.curShowIndex[index1] + self.curShowIndex[index2]
    self.curShowIndex[index2] = self.curShowIndex[index1] - self.curShowIndex[index2]
    self.curShowIndex[index1] = self.curShowIndex[index1] - self.curShowIndex[index2]
end

function WorldBossChallengeTeamView:ShowInfo(data)
    local PlayerModel = _G.PlayerModel:GetInstance()
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[PlayerModel:GetRoleStyle()]
    if portraitCfg then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_mhead, portraitCfg.portrait1)
    end
    self.go_table.aortext_mlv.text = PlayerModel:GetLevel()
    self.go_table.aortext_mName.text = PlayerModel:GetName()

    if data.style then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_ehead, data.style)
    end
    self.go_table.aortext_elv.text = data.level
    self.go_table.aortext_eName.text = data.name
end

function WorldBossChallengeTeamView:OnLeagueChanged()
    self:Close()
end

return WorldBossChallengeTeamView
