---@class WorldBossCrusadeInfoView : UIBaseView    中文描述
---@field public go_table WorldBossCrusadeInfoView_GoTable GoTable
---@field monsterCfg monster_cfg
---@field cfg boss_cfg
---@field skillList WorldBossCrusadeInfoView._obj_skill1_GoTable[]
local WorldBossCrusadeInfoView = _G.BaseClass("WorldBossCrusadeInfoView", _G.Component)

function WorldBossCrusadeInfoView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function WorldBossCrusadeInfoView:OnCreate(cfg)
    self.cfg = cfg
    --self.go_table.scrollloopvectical_SkillList:InitItemData(0, _G.handler(self, self.RefreshSkill))
    self.skillList = {}
end

---显示
function WorldBossCrusadeInfoView:Show()
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg.boss_name[self.curPage])
    self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(self.cfg.strategy_tab[1])
    if self.cfg.subtitle[self.curPage] then
        self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(self.cfg.subtitle[self.curPage])
    end
    --_G.GameUtil.SetActiveByCondition(self.go_table.aortext_desc, self.cfg.subtitle[self.curPage])

    self.go_table.trans_CardSpine:ClearChildren()
    local spine = self.cfg.boss_picture[self.curPage]
    local pos = self.cfg.pos_portrait1[self.curPage]
    _G.PoolsManager:GetInstance():Spawn(
            spine,
            _G.ePoolType.Temporary,
            self.go_table.trans_CardSpine,
            function(trans)
                GameUtil.SetCardUiSpineAnimation(trans, "stand_1", true)
                self.go_table.trans_CardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
                self.go_table.trans_CardSpine:SetLocalScaleXYZ(pos[4])
            end
    )
    --self.go_table.aorrawimage_monster:LoadImage(
    --    self.cfg.boss_picture[self.curPage],
    --    function()
    --        self.go_table.aorrawimage_monster:SetNativeSize()
    --    end
    --)
    self:ShowSkill()
end
--3adb3
---更新技能显示
function WorldBossCrusadeInfoView:ShowSkill()
    --self.go_table.scrollloopvectical_SkillList:UpdateCount(#self.cfg.boss_skill[self.curPage])
    if table.isEmptyOrNil(self.skillList) then
        self.skillList = {}
    end
    for i, v in pairs(self.skillList) do
        v:SetActiveE(0)
    end
    for i = 1, table.count(self.cfg.boss_skill[self.curPage]) do
        local tb
        if table.ContainsKey(self.skillList, i) then
            tb = self.skillList[i]
        else
            tb = _G.InstantiateObject(self.go_table.obj_skill1, self.go_table.obj_skillContent)
            self.skillList[i] = tb
        end
        tb:SetActiveE(1)
        self:ShowSingleSkill(_G.GetAutoGoTable(tb), i)
    end
end

function WorldBossCrusadeInfoView:RefreshSkill(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.skillList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.skillList[id] = tb
    end
    self:ShowSingleSkill(tb, index + 1)
end

---更新单个技能显示
---@param tb WorldBossCrusadeInfoView._obj_skill1_GoTable
function WorldBossCrusadeInfoView:ShowSingleSkill(tb, index)
    local id = self.cfg.boss_skill[self.curPage][index]
    if id and id > 0 then
        local cfg = _G.ConfigManager.card_skills_cfg[id]
        if cfg then
            tb.aorrawimage_icon:LoadImage(cfg.icon)
            tb.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.brief]
            tb.aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name1)
            tb.aortext_des.text = _G.LangUtil.GetLangPackValue(cfg.describe1)
        end
    end
end

---更新战区显示
function WorldBossCrusadeInfoView:ChangePage(page)
    self.curPage = page
    self:Show()
end

---按钮点击事件在这里派发
function WorldBossCrusadeInfoView:OnClickBtn(go, isOn)
end

function WorldBossCrusadeInfoView:EscClose()
    self:Close()
end

return WorldBossCrusadeInfoView
