local TrackingPointModel = require("TrackingPointModel")

local WorldBossManager = require "WorldBossManager"
---@class WorldBossView : UIBaseView	中文描述
---@field public go_table WorldBossView_GoTable GoTable
---@field ViewItems  WorldBossView._toggle_2_GoTable[]
local WorldBossView = _G.BaseClass("WorldBossView", _G.UIBaseView)
--_G.WorldBossView = WorldBossView

function WorldBossView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldBossView:OnCreate(index)
    if not require "WorldBossModel":GetInstance().wordData then
        self:Close()
        return
    end

    -- self.ViewItems = {}
    -- self:InitViewName()
    --self:InitTb(index or 1)
    self:ShowView()
    --self:InitEffect()
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
end

function WorldBossView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shijiebossjiemian_beijing,
        self.go_table.trans_effectRoot
    )
end

---
function WorldBossView:InitViewName()
    local uiCfg = _G.ConfigManager.ui_cfg
    self.Views = {
        {ViewName = uiCfg.WorldBossChangllengeView.Name},
        {ViewName = uiCfg.WorldBossCrusadeView.Name}
    }
end

function WorldBossView:InitTb(index)
    if index == 1 and require "WorldBossManager":GetInstance():CheckChangllengeIsPass() then
        index = 2
    end
    if index == 2 and require "WorldBossManager":GetInstance():CheckTime() then
        index = 1
    end
    for i = 1, 2 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_" .. i])
        self.ViewItems[i] = tb
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.OnClickToggle, i))
        if i == 2 then
            _G.GameUtil.SetActiveByCondition(
                tb.aorimage_lock,
                not require "WorldBossManager":GetInstance():CheckEnterWorldBossCrusadeView()
            )
        end
    end
    self:OnClickToggle(nil, nil, index)
end

function WorldBossView:OnClickToggle(go, isOn, index)
    if self.curToggleIndex == index then
        return
    end
    if index == 2 and not require "WorldBossManager":GetInstance():CheckEnterWorldBossCrusadeView() then
        _G.PopWindowManager:GetInstance():ShowAllTips(310116)
        return
    end
    local view = self.Views[index]
    if
        index > 0 and view.ViewName == _G.ConfigManager.ui_cfg.WorldBossCrusadeView.Name and
            WorldBossManager:GetInstance():CheckIsStop()
     then
        return
    end
    self:ShowWindos(index)
    self.curViewName = view.ViewName
    --    _G.GameUtil.SetActiveByCondition(self.go_table.obj_panelshadow, true)
    self.nextPageIndex = index
    local window = _G.UIManager:GetInstance():GetWindow(self.Views[index].ViewName)
    if window then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.CoSetViewParent, self)
        _G.UIManager:GetInstance():ShowWindow(view.ViewName)
    else
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.CoSetViewParent, self)
        _G.UIManager:GetInstance():OpenWindow(view.ViewName)
    end
end

function WorldBossView:ShowView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.CoSetViewParent, self)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossCrusadeView.Name)
end

function WorldBossView:ShowWindos(index)
    for i, v in ipairs(self.ViewItems) do
        _G.GameUtil.SetActiveByCondition(v.obj_off, not (i == index))
        _G.GameUtil.SetActiveByCondition(v.obj_on, i == index)
    end
end

---打开界面设置路径
function WorldBossView:CoSetViewParent(name)
    if name == _G.ConfigManager.ui_cfg.WorldBossCrusadeView.Name then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        if not view.transform:GetParent() or view.transform:GetParent():GetName() ~= self.go_table.trans_panel.name then
            view.transform:SetParentE(self.go_table.trans_panel)
        end
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
        )
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.CoSetViewParent, self)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.obj_panelshadow, false)
    end
end

---按钮点击事件在这里派发
function WorldBossView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.WorldBossCrusadeView.Name)
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:Close()
    elseif go == self.go_table.aorbtn_playerWay then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 15)
    end
end

return WorldBossView
