local WorldBossTeamItem = _G.BaseClass("WorldBossTeamItem")

---类的构造函数
function WorldBossTeamItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.teams = {
        WorldBossTeamItem2.New(self.go_table.obj_team1),
        WorldBossTeamItem2.New(self.go_table.obj_team2),
        WorldBossTeamItem2.New(self.go_table.obj_team3),
        WorldBossTeamItem2.New(self.go_table.obj_team4),
        WorldBossTeamItem2.New(self.go_table.obj_team5),
    }
end

---类的析构函数
function WorldBossTeamItem:Dispose()
    self.go_table = nil
    self.gameObject = nil
end

function WorldBossTeamItem:Show(data, skills)
    for i = 1, 5 do
        self:ShowOne(data[i], i, skills[i])
    end
end

function WorldBossTeamItem:ShowOne(data, index, skill)
    self.teams[index]:Show(data, skill)
end

--endregion

