---@class WorldBossTeamItemDrag	中文描述
local WorldBossTeamItemDrag = _G.BaseClass("WorldBossTeamItemDrag")

---类的构造函数
function WorldBossTeamItemDrag:__init(obj, call, groupStates)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.groupStates = groupStates
    self.teamPos = {
        { self.go_table.obj_team1:GetLocalPosition() },
        { self.go_table.obj_team2:GetLocalPosition() },
        { self.go_table.obj_team3:GetLocalPosition() },
        { self.go_table.obj_team4:GetLocalPosition() },
        { self.go_table.obj_team5:GetLocalPosition() },
    }
    local dragBegin = _G.handler(self, self.OnDragBegin)
    local dragEnd = _G.handler(self, self.OnDragEnd)
    self.teams = {}
    for i = 1, 5 do
        self.teams[i] = WorldBossDragItem.New(self.go_table["obj_team" .. i], dragBegin, dragEnd, i,
            (groupStates and groupStates[i] or nil))
    end
    self.onChangeCall = call
end

---类的析构函数
function WorldBossTeamItemDrag:Dispose()
    self.go_table = nil
    self.teamPos = nil
    self.go_table = nil
    self.gameObject = nil
end

function WorldBossTeamItemDrag:Show(data, skills)
    self.data = data
    self.combSkill = skills
    for i = 1, 5 do
        self:ShowOne(data[i], i, self.combSkill[i])
    end
end

function WorldBossTeamItemDrag:ShowOne(data, index, skills)
    self.teams[index]:Show(data, index, skills)
end

function WorldBossTeamItemDrag:OnDragBegin(index)
    self.dragIndex = index
    self.teams[index].gameObject:SetParentE(self.go_table.trans_drag, 1)
end

function WorldBossTeamItemDrag:OnDragEnd(index)
    for i = 1, #self.teams do
        if i ~= index then
            if
                (self.groupStates == nil or self.groupStates[i] == nil or (self.groupStates[i] ~= nil and self.groupStates[i] == false)) and self.teams[i].gameObject:GetActiveSelf() == 1 and
                _G.CS.UIUtils.ChecklocalPositionInRect(
                    self.teams[index].gameObject,
                    self.teams[i].gameObject,
                    false
                )
            then
                local moveIndex = self.teams[index]:GetDataIndex()
                local targetIndex = self.teams[i]:GetDataIndex()
                self.teams[index]:Show(self.data[targetIndex], targetIndex, self.combSkill[targetIndex])
                self.teams[i]:Show(self.data[moveIndex], moveIndex, self.combSkill[moveIndex])
                self.onChangeCall(index, i)
                break
            else
                if _G.CS.UIUtils.ChecklocalPositionInRect(
                        self.teams[index].gameObject,
                        self.teams[i].gameObject,
                        false
                    ) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(140120)
                end
            end
        end
    end
    self.teams[index].gameObject:SetParentE(self.go_table.trans_root, 1)
    local pos = self.teamPos[index]
    self.teams[index].gameObject:SetLocalPosition(pos[1], pos[2], pos[3])
end

--endregion

---创建对象
---@param obj UnityEngine.GameObject 节点
---@param drag boolean 是否可拖拽
---@param call function 拖拽后的回调
---@return ArenaSeniorTeamItem|WorldBossTeamItemDrag 中文描述
local function WorldBossTeamCreate(obj, drag, call, groupState)
    if drag then
        return WorldBossTeamItemDrag.New(obj, call, groupState)
    end
    return WorldBossTeamItem.New(obj)
end

return WorldBossTeamCreate
