--region 阵容展示卡牌
local WorldBossCardItem = _G.BaseClass("WorldBossCardItem")
---类的构造函数
function WorldBossCardItem:__init(obj)
    self.transform = obj
end

---类的析构函数
function WorldBossCardItem:Dispose()
    if self.card then
        self.card:Dispose()
        self.card = nil
    end
    self.transform = nil
end

---展示卡牌头像
---@param sid number 卡牌sid
---@param lv number 卡牌等级
---@param star number 卡牌星级
---@param soulLink_lv number 卡牌魂链等级
function WorldBossCardItem:Show(sid, lv, star, soulLink_lv)
    if sid <= 0 then
        if self.card then
            _G.GameUtil.SetActiveByCondition(self.card.transform, false)
        end
        return
    end
    if self.card then
        self.card:Show(sid, nil, star, soulLink_lv, lv)
        _G.GameUtil.SetActiveByCondition(self.card.transform, true)
    else
        local ItemCardFactory = _G.ItemCardFactory
        ItemCardFactory:GetInstance():GetItemCard(
            ItemCardFactory.itemCardType.CardAllItem,
            self.transform,
            function(item)
                self.card = item
                self.card:Show(sid, nil, star, soulLink_lv, lv)
            end
        )
    end
end

--endregion

--region 阵容展示组
local WorldBossTeamItem2 = _G.BaseClass("WorldBossTeamItem")

---类的构造函数
function WorldBossTeamItem2:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self.cards = {
        WorldBossCardItem.New(self.go_table.trans_card1),
        WorldBossCardItem.New(self.go_table.trans_card2),
        WorldBossCardItem.New(self.go_table.trans_card3),
        WorldBossCardItem.New(self.go_table.trans_card4),
        WorldBossCardItem.New(self.go_table.trans_card5)
    }
    self.skill = {
        { obj = self.go_table.obj_skill1, icon = self.go_table.aorrawimage_icon1, desc = self.go_table.aortext_type1, desc2 = self.go_table.aortext_type11, name = self.go_table.aortext_name1 },
        { obj = self.go_table.obj_skill2, icon = self.go_table.aorrawimage_icon2, desc = self.go_table.aortext_type2, desc2 = self.go_table.aortext_type21, name = self.go_table.aortext_name2 },
        { obj = self.go_table.obj_skill3, icon = self.go_table.aorrawimage_icon3, desc = self.go_table.aortext_type3, desc2 = self.go_table.aortext_type31, name = self.go_table.aortext_name3 }
    }
    for i = 1, #self.skill do
        self.skill[i].obj:SetActiveE(0)
    end
end

---类的析构函数
function WorldBossTeamItem2:SetMaskState(isShow)
    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(isShow == true and 1 or 0)
    end
end

---类的析构函数
function WorldBossTeamItem2:Dispose()
    self.go_table = nil
    for i = 1, #self.cards do
        self.cards[i]:Dispose()
    end
end

---展示
---@param data table 展示数据
function WorldBossTeamItem2:Show(data, skills, showPower, showMask)
    if data == nil then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
        return
    end
    local card
    local power = 0
    for i = 1, #data do
        card = data[i]
        self.cards[i]:Show(card.sid, card.level, card.star, card.soulLink_lv)
        if card.power then
            power = power + card.power
        end
    end
    if self.go_table.aortext_power then
        if showPower then
            self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
        else
            self.go_table.aortext_power.text = "???"
        end
    end

    local cfg
    for i = 1, #skills do
        if skills[i] > 0 then
            local petData = require("PetModel"):GetInstance():GetPet(skills[i])
            local petCfg = petData and petData.cfg or _G.ConfigManager.pet_cfg[skills[i]]
            if petCfg == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError(self.Info, "未查询到魔兽配置, id:")
                end
                self.go_table.obj_petSkills:SetActiveE(0)
                return
            end
            local skillId
            if petData then
                local skillIdx, maxSkillIdx = petData.star + 1, #petCfg.skill_id
                skillId = petCfg.skill_id[skillIdx < 1 and 1 or skillIdx <= maxSkillIdx and skillIdx or maxSkillIdx]
            else
                skillId = petCfg.skill_id[1]
            end
            local cfgt = _G.ConfigManager.card_skills_cfg[skillId]
            cfg = _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]

            self.skill[i].icon:LoadImage(petCfg.Icon)
            self.skill[i].desc.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            self.skill[i].name.text = _G.GetLangPackValue(petCfg.Name)
            self.skill[i].obj:SetActiveE(1)
        else
            self.skill[i].obj:SetActiveE(0)
        end
    end
    self:SetMaskState(showMask)
end

--endregion

--region 阵容展示组(可拖拽)
local WorldBossDragItem = _G.BaseClass("WorldBossDragItem", WorldBossTeamItem2)
local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
---类的构造函数
function WorldBossDragItem:__init(obj, dragBegin, dragEnd, index, groupState)
    self.objIndex = index
    self.gameObject = obj
    self.onDragBegin = dragBegin
    self.onDragEnd = dragEnd
    self.groupState = groupState
    -- if groupState ~= nil and groupState == true then
    -- else
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
    -- end
end

---类的析构函数
function WorldBossDragItem:Dispose()
    self.gameObject = nil
    self.onDragBegin = nil
    self.onDragEnd = nil
    self.objIndex = nil
end

function WorldBossDragItem:Show(data, index, skills)
    if data == nil then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
        return
    end
    self.dataIndex = index
    WorldBossTeamItem2.Show(self, data, skills, true, self.groupState ~= nil and self.groupState == true)
end

function WorldBossDragItem:GetDataIndex()
    return self.dataIndex
end

function WorldBossDragItem:OnDragBegin()
    if self.groupState ~= nil and self.groupState == true then
        _G.PopWindowManager:GetInstance():ShowAllTips(140120)
        return
    end
    if self.onDragBegin then
        self.onDragBegin(self.objIndex)
    end
end

function WorldBossDragItem:OnDrag(go, ed)
    if self.groupState ~= nil and self.groupState == true then
        return
    end
    self.gameObject:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end

function WorldBossDragItem:OnDragEnd()
    if self.groupState ~= nil and self.groupState == true then
        return
    end
    if self.onDragEnd then
        self.onDragEnd(self.objIndex)
    end
end

--endregion

