local EmbattleController = require "EmbattleController"
local EmbattleModel = require "EmbattleModel"
---@class WorldBossEmbattleNewView : UIBaseView	中文描述
---@field go_table WorldBossEmbattleNewView_GoTable GoTable
---@field embattleView EmbattleNewView
local WorldBossEmbattleNewView = _G.BaseClass("WorldBossEmbattleNewView", _G.UIBaseView)

function WorldBossEmbattleNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldBossEmbattleNewView:OnCreate(grounp, exit, battle, data, viewName, skipBattle)
    self.onExitCall = exit
    self.onBattleCall = battle
    self.changeViewName = viewName
    self.enemyData = data
    self.skipBattle = skipBattle
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change, false)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():OpenEmbattle(
        grounp,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.worldBoss,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        require "WorldBossModel":GetInstance():GetEmbattleEnemyId(),
        data,
        skipBattle
    )
end

function WorldBossEmbattleNewView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
    self.changeViewName = nil
    self.enemyData = nil
end

---按钮点击事件在这里派发
function WorldBossEmbattleNewView:OnClickBtn(go)
    if go == self.go_table.aorbtn_change then
        local embattleItem = EmbattleController:GetInstance():GetCurEmbattleItem()
        local combSkill = embattleItem:GetCombSkillData()
        local lv = 1
        local battleSkills = embattleItem:GetAllPetSkillData()
        local CombineModelIns = require "CombineModel":GetInstance()
        local combCfgs = _G.ConfigManager.combine_cfg
        for i = 1, #combSkill do
            for j = 1, #combSkill[i] do
                if combSkill[i][j].id > 0 then
                    battleSkills[i][j] = combSkill[i][j].cskillID
                end
            end
        end
        local data
        for _, v in pairs(embattleItem:GetAllEnemyEmbattleData()[1]) do
            if v.sid > 0 then
                data = v
                break
            end
        end
        ---@type card_cfg
        local cfg = _G.ConfigManager.card_cfg[data.sid]
        _G.UIManager:GetInstance():OpenWindow(
            self.changeViewName,
            _G.handler(self, self.OnChangeCall),
            embattleItem:GetAllEmbattleData(),
            embattleItem:GetAllEnemyEmbattleData(),
            {level = data.level, name = _G.LangUtil.GetLangPackValue(cfg.Name), style = cfg.Icon},
            battleSkills
        )
    end
end

---监听界面打开
---@param name string 界面名称
function WorldBossEmbattleNewView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.embattleView:RegiestChooseViewOpen(_G.handler(self, self.OnChooseViewOpen))
        self.embattleView:RegiestChangeGroup(_G.handler(self, self.OnChangeGroup))
        self.embattleView:SetInitDoneCall(_G.handler(self, self.OnEmbattleInitDone))
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)

        --默认展示第一队队伍信息
        self:OnChangeGroup(1)
    end
end

function WorldBossEmbattleNewView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
    end
end

function WorldBossEmbattleNewView:OnBattleCall(...)
    self:Close()
    if self.onBattleCall then
        self.onBattleCall(...)
    end
end

function WorldBossEmbattleNewView:OnEmbattleInitDone()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change, true)
end

---改变位置回调
---@param indexes table 调整后得位置序列组{1，2，3}
function WorldBossEmbattleNewView:OnChangeCall(indexes)
    for i = 1, #indexes - 1 do
        if i ~= indexes[i] then
            EmbattleController:GetInstance():GetCurEmbattleItem():ChangeGroup(indexes)
            break
        end
    end
    self.embattleView:UpdateMyFormation()
end

function WorldBossEmbattleNewView:OnChooseViewOpen(show)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_change, not show)
end

--队伍切换事件
function WorldBossEmbattleNewView:OnChangeGroup(index)
    if not self.embattleView then
        return
    end
    local left = _G.PlayerModel:GetInstance():GetName()
    local right = require("WorldBossManager"):GetInstance():GetBossName(index);
    self.embattleView:SetVsDescription(left, right)
end

