local WorldBossModel = require "WorldBossModel"
local WorldBossManager = require "WorldBossManager"
local CommonTipManager = require "CommonTipManager"
---@class WorldBossChangllengeView : UIBaseView	中文描述
---@field public go_table WorldBossChangllengeView_GoTable GoTable
---@field SkillItems  WorldBossChangllengeView._obj_skill1_GoTable[] 所有技能物体
---@field DifficultyItems _obj_ListItem._toggle_item_GoTable[] 所有难度
---@field AwardItems WorldBossChangllengeView._obj_ListItem_GoTable[]
---@field curDiffculty _obj_ListItem._toggle_item_GoTable 当前选中的难度
---@field maxDiffulty boss_cfg 已通关的最大难度
---@field BossDatas WorldBossData[]
local WorldBossChangllengeView = _G.BaseClass("WorldBossChangllengeView", _G.UIBaseView)
--_G.WorldBossChangllengeView = WorldBossChangllengeView

function WorldBossChangllengeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.AwardItems = {}
    self.DifficultyItems = {}
end

---界面的入口函数
function WorldBossChangllengeView:OnCreate()
    if not WorldBossModel:GetInstance().wordData then
        WorldBossModel:GetInstance():GetWorldBossData(_G.handler(self, self.Init))
    else
        self:Init()
    end
    _G.Events:GetInstance():AddListener("WorldBossUpdate", self.RefreshPanel, self)
end
---更新界面
function WorldBossChangllengeView:RefreshPanel()
    self.curDiffculty = WorldBossModel:GetInstance():GetCurDiffculty()
    self.go_table.scrollloophorizontal_Award:UpdateAllItem()
    self:UpdatePanel()
end

---初始化
function WorldBossChangllengeView:Init()
    self.maxDiffulty = WorldBossModel:GetInstance():GetCurDiffculty()
    self.curDiffculty = self.maxDiffulty
    self.curBossCfg = _G.ConfigManager.boss_cfg[self.maxDiffulty]
    self.BossDatas = WorldBossModel:GetInstance().BossDatas
    -- self.go_table.looplist2_DifficultyList:InitListView(count, _G.handler(self, self.RefreshDifficulty))
    self.go_table.scrollloophorizontal_Award:InitItemData(0, _G.handler(self, self.RefreshAward))
    self:UpdatePanel()
    self:InitEffect()
end

function WorldBossChangllengeView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shijiebossjiemian_tiaozhananniu,
        self.go_table.aorbtn_onClick,
        function(trans)
            _G.GameUtil.SetActiveByCondition(trans, false)
            self.startEff = trans
        end
    )
end

---更新界面显示
function WorldBossChangllengeView:UpdatePanel()
    self:ShowBoss()
    self:UpdateAward()
    self:UpdateToggle()
end

function WorldBossChangllengeView:UpdateToggle()
    if not self.Toggles then
        self.Toggles = {
            _G.GetAutoGoTable(self.go_table.toggle_1, _G.handlerbind(self, self.OnClickDifficulty, 1)),
            _G.GetAutoGoTable(self.go_table.toggle_2, _G.handlerbind(self, self.OnClickDifficulty, 2)),
            _G.GetAutoGoTable(self.go_table.toggle_3, _G.handlerbind(self, self.OnClickDifficulty, 3)),
            _G.GetAutoGoTable(self.go_table.toggle_4, _G.handlerbind(self, self.OnClickDifficulty, 4)),
            _G.GetAutoGoTable(self.go_table.toggle_5, _G.handlerbind(self, self.OnClickDifficulty, 5))
        }
    end

    local chooseToggle
    for i = 1, 5 do
        local data = self.BossDatas[i]
        if not self.Toggles[i].toggle then
            self.Toggles[i].toggle = self.Toggles[i]["toggle_" .. i]
            _G.GameUtil.SetActiveByCondition((self.Toggles[i].aorimage_isOn), false)
        end
        self.Toggles[i].data = data
        if i == self.curDiffculty then
            chooseToggle = self.Toggles[i].toggle
        end
        if data.isLock then
            self.Toggles[i].aortext_lock.text = data.lockStr
        end
        _G.GameUtil.SetActiveByCondition(self.Toggles[i].obj_lock, data.isLock)
    end
    chooseToggle.isOn = true
end

---更新奖励
function WorldBossChangllengeView:UpdateAward()
    self.go_table.scrollloophorizontal_Award:UpdateCount(#self.curBossCfg.reward_first)
end

---刷新奖励显示
function WorldBossChangllengeView:RefreshAward(index, obj)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = self.curBossCfg.reward_first[newIndex]
    local item = self.DifficultyItems[instanceID]

    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 88, obj)
        self.DifficultyItems[instanceID] = item
    end
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)
    item:Show(data)
end

---点击奖励回调
function WorldBossChangllengeView:OnClickAward(tb)
    CommonTipManager:GetInstance():OpenTip(tb.gameObject, tb.data.sid)
end

---刷新难度显示
---@param listView2 SuperScrollView.LoopListView2
---@param index number
function WorldBossChangllengeView:RefreshDifficulty(listView2, index)
    local newIndex = index + 1
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local instanceID = item:GetInstanceIDE()
    if not self.DifficultyItems[instanceID] then
        local tb = _G.GetAutoGoTable(item)

        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickDifficulty, tb))
        self.DifficultyItems[instanceID] = tb
    end

    local tb = self.DifficultyItems[instanceID]
    local data = self.BossDatas[newIndex]
    tb.aortext_level1.text = data.grade
    tb.aortext_level2.text = data.grade
    tb.data = data
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, data.id == self.curBossCfg.id)
    if data.id == self.curBossCfg.id then
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, true)
        self.curDiffcultyTb = tb
    else
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, false)
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_Lock, data.isLock)
    return item
end

---切换难度
---@param tb  _obj_ListItem._toggle_item_GoTable
function WorldBossChangllengeView:OnClickDifficulty(go, isOn, index)
    local tb = self.Toggles[index]
    if not tb.data then
        return
    end
    if self.curDiffcultyTb and self.curDiffcultyTb.data.id == tb.data.id then
        return
    end
    if tb.data.id > self.maxDiffulty then
        _G.PopWindowManager:GetInstance():ShowAllTips(310106)
        return
    elseif tb.data.isLock then
        tb.data:ShowTip()
        return
    end
    if self.curDiffcultyTb then
        _G.GameUtil.SetActiveByCondition(self.curDiffcultyTb.aorimage_isOn, false)
        _G.GameUtil.SetActiveByCondition(self.curDiffcultyTb.aorimage_isOff, true)
    end
    self.curDiffcultyTb = tb
    _G.GameUtil.SetActiveByCondition(self.curDiffcultyTb.aorimage_isOn, true)
    _G.GameUtil.SetActiveByCondition(self.curDiffcultyTb.aorimage_isOff, false)
    self.curBossCfg = tb.data.cfg
    self:UpdatePanel()
end

---按钮点击事件在这里派发
function WorldBossChangllengeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_challenge then
        self:OnChanglleng()
    end
end
---开始挑战
function WorldBossChangllengeView:OnChanglleng()
    if self.curDiffcultyTb.data.id < self.maxDiffulty or WorldBossManager:GetInstance():CheckChangllengeIsPass() then
        _G.PopWindowManager:GetInstance():ShowAllTips(310107)
        return
    end
    WorldBossManager:GetInstance():StartChangllenge(_G.handler(self, self.OnChangllengCall))
end
---战斗回调
function WorldBossChangllengeView:OnChangllengCall()
    self.maxDiffulty = WorldBossModel:GetInstance():GetCurDiffculty()
end

---更改Boss显示
function WorldBossChangllengeView:ShowBoss()
    --TODO
end

---初始化技能
function WorldBossChangllengeView:InitSkill()
    self.SkillItems = {}
    for i = 1, 3 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_skill" .. i])
        tb.index = i
        self.SkillItems[i] = tb
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.OnClickSkill, tb))
    end
end

---点击技能
function WorldBossChangllengeView:OnClickSkill(go, isOn, tb)
    local sid = self.curBossCfg.skills_preview[tb.index]
    if sid then
        CommonTipManager:GetInstance():OpenSkillTip(sid)
    end
end

function WorldBossChangllengeView:OnDestroy()
    _G.Events:GetInstance():RemoveListener("WorldBossUpdate", self.RefreshPanel, self)
end

---更新难度显示
function WorldBossChangllengeView:UpdateLevel()
end

return WorldBossChangllengeView
