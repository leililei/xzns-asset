---@class WorldBossBattleView : UIBaseView	中文描述
---@field public go_table WorldBossBattleView_GoTable GoTable
local WorldBossBattleView = _G.BaseClass("WorldBossBattleView", _G.UIBaseView)
--_G.WorldBossBattleView = WorldBossBattleView

local CS = _G.CS
local typeof = _G.typeof

local TitleIcon = {
    "ui_zdks_xkwm_txt",
    "ui_zdks_mgzb_txt",
    "ui_zdks_sgzy_txt"
}

function WorldBossBattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldBossBattleView:OnCreate()
    self.index = 1
end
function WorldBossBattleView:OnDestroy()
    self.index = 1
end
---按钮点击事件在这里派发
function WorldBossBattleView:OnClickBtn()
end

function WorldBossBattleView:OnBattleEnd()
    self.index = self.index + 1
end

function WorldBossBattleView:PlayAni(call)
    self.go_table.obj_ani:SetActiveE(1)
    self.go_table.obj_ani:SetLocalPosition(0, -150, 0)
    _G.DelayDo(
        0.1,
        function()
            self.go_table.obj_ani:DOLocalMoveY(0, 0.5)
            _G.DelayDo(
                2,
                function()
                    self.go_table.obj_ani:DOLocalMoveY(
                        900,
                        0.5,
                        function()
                            if call then
                                call()
                            end
                        end
                    )
                end
            )
        end
    )
end

function WorldBossBattleView:OnBattleBegin(callback)
    if self.delay then
        _G.coroutine.stopwaiting(self.delay)
        self.delay = nil
    end
    self.go_table.aorimage_title.SpriteName = TitleIcon[self.index]
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_start, true)
    self:PlayAni(
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_start, false)
            if callback then
                callback()
            end
            if self.index == 3 then
                self:Close()
            end
        end
    )
    -- self.delay =
    --     _G.DelayDo(
    --     1,
    --     function()
    --         _G.GameUtil.SetActiveByCondition(self.go_table.obj_start, false)
    --         if callback then
    --             callback()
    --         end
    --         if self.index == 3 then
    --             self:Close()
    --         end
    --     end
    -- )
end

return WorldBossBattleView
