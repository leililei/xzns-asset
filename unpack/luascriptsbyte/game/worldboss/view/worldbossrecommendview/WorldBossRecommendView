---@class WorldBossRecommendView : UIBaseView	魂将推荐
---@field public go_table WorldBossRecommendView_GoTable GoTable
local WorldBossRecommendView = _G.BaseClass("WorldBossRecommendView", _G.Component)

function WorldBossRecommendView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldBossRecommendView:OnCreate(cfg, page)
    self.curPage = 1
    self.cfg = cfg
    self.HunJiangList = {}
    self.Cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self.go_table.scrollloophorizontal_card:InitItemData(0, _G.handler(self, self.RefreshCard))
    --self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(self.cfg.strategy_tab[2])
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg.boss_name[self.curPage])

    --self.go_table.aorrawimage_monster:LoadImage(
    --        self.cfg.boss_picture[self.curPage],
    --        function()
    --            self.go_table.aorrawimage_monster:SetNativeSize()
    --        end
    --)
end

function WorldBossRecommendView:SetView()
    local des = _G.LangUtil.GetLangPackValue(self.cfg.apply_doc[self.curPage])
    self.go_table.aortext_des.text = des

    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.cfg.boss_name[self.curPage])
    --self.go_table.aorrawimage_monster:LoadImage(
    --        self.cfg.boss_picture[self.curPage],
    --        function()
    --            self.go_table.aorrawimage_monster:SetNativeSize()
    --        end
    --)
    self.go_table.trans_CardSpine:ClearChildren()
    local spine = self.cfg.boss_picture[self.curPage]
    local pos = self.cfg.pos_portrait1[self.curPage]
    _G.PoolsManager:GetInstance():Spawn(
            spine,
            _G.ePoolType.Temporary,
            self.go_table.trans_CardSpine,
            function()
                self.go_table.trans_CardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
                self.go_table.trans_CardSpine:SetLocalScaleXYZ(pos[4])
            end
    )
    self:SetCard()
end
---@type CardData
---设置推荐卡牌
function WorldBossRecommendView:SetCard()
   self.cardcfg = self.cfg.apply_role[self.curPage]
   self.cardDataList = {}
   for _, v in pairs(self.Cards) do
    if _G.table.ContainsValue(self.cardcfg, v.sid) then
        if self.cardDataList[v.sid] then
            if v.star > self.cardDataList[v.sid].star then
                self.cardDataList[v.sid] = v
            end
        else
            self.cardDataList[v.sid] = v
        end
    end
   end
   self.go_table.scrollloophorizontal_card:UpdateCount(#self.cardcfg)
end

function WorldBossRecommendView:RefreshCard(index, obj)
    index = index + 1
    local tb_i = _G.GetAutoGoTable(obj)
    local headTrans = tb_i.trans_root
    local data = self.cardDataList[self.cardcfg[index]]
    local id = obj:GetInstanceIDE()
   --判断是否解锁
    _G.GameUtil.SetActiveByCondition(tb_i.aorimage_Click, (not data))
    if self.HunJiangList[id] == nil then
        self:showItemBaseHeadInfo(headTrans, data, id,self.cardcfg[index])
    else
        self:SetCardShow(self.HunJiangList[id],data,self.cardcfg[index])
    end
end

---展示卡牌
---@param item ItemCardAllView 卡牌item
---@param data CardData 卡牌数据
function WorldBossRecommendView:SetCardShow(item,data,sid)
    if data then
        item:ShowCardData(data, _G.handlerbind(self, self.OnClickCard, sid))
    elseif _G.ConfigManager.card_cfg[sid] then
        local star = _G.ConfigManager.card_cfg[sid].Star or 1
        item:Show(sid, _G.handlerbind(self, self.OnClickCard, sid), star)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("在card_cfg中未找到sid为" .. sid .. "的卡牌配置")
        end
    end
    item:HideOrShowLevel(false)
end

function WorldBossRecommendView:OnClickCard(sid)
    require "CommonTipManager":GetInstance():OpenCardTip(sid)
end

---卡牌更新
function WorldBossRecommendView:showItemBaseHeadInfo(headTrans, cardData, ints, sid)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        headTrans,
        function(item)
            item.transform:SetLocalScale(1, 1, 1)
            self:SetCardShow(item,cardData,sid)
            self.HunJiangList[ints] = item
        end
    )
end


---更新页面显示
function WorldBossRecommendView:ChangePage(page)
    self.curPage = page
    self:SetView()
end

---界面的销毁函数
function WorldBossRecommendView:OnDestroy()
end

---按钮点击事件在这里派发
function WorldBossRecommendView:OnClickBtn(go)
end

return WorldBossRecommendView