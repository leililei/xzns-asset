---@class WorldBossBattleGuideView : UIBaseView	战斗指引
---@field public go_table WorldBossBattleGuideView_GoTable GoTable
local WorldBossBattleGuideView = _G.BaseClass("WorldBossBattleGuideView", _G.UIBaseView)

function WorldBossBattleGuideView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WorldBossBattleGuideView:OnCreate(cfg)
    self.curPage = 1
    self.curIndex = 1
    self.cfg = cfg
    self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(self.cfg.strategy_tab[3])
end

function WorldBossBattleGuideView:SetView()
    local condition = self.cfg.open_condition[self.curPage]
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_desc,condition ~= 0)
    if condition and condition ~= 0 then
        self.go_table.aortext_desc.text =_G.LangUtil.GetLangPackValue(condition)
    end
    self:SetContent()
end

---内容展示
function WorldBossBattleGuideView:SetContent()
    self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(self.cfg.guide_doc[self.curPage][self.curIndex*2])
    self.go_table.aorrawimage_guide:LoadImage(
        self.cfg.guide_picture[self.curPage][self.curIndex*2],
        function()
        end
    )
end


---更新页面显示
function WorldBossBattleGuideView:ChangePage(page)
    self.curPage = page
    self.maxCount = (#self.cfg.guide_doc[self.curPage])/2
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_right, self.maxCount > 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_left, self.maxCount > 1)
    if self.curIndex > self.maxCount then
        self.curIndex = self.maxCount
    end
    self:SetView()
end

---更新引导页面显示
function WorldBossBattleGuideView:ChangeIndex(offset)
    if offset then
        self.curIndex = offset + self.curIndex
        if self.curIndex > self.maxCount then
            self.curIndex = 1
        elseif self.curIndex <= 0 then
            self.curIndex = self.maxCount
        end
    end
    self:SetContent()
end

---界面的销毁函数
function WorldBossBattleGuideView:OnDestroy()
end

---按钮点击事件在这里派发
function WorldBossBattleGuideView:OnClickBtn(go, isOn)
   if go == self.go_table.aorbtn_left then
        self:ChangeIndex(-1)
    elseif go == self.go_table.aorbtn_right then
        self:ChangeIndex(1)
    end
end

return WorldBossBattleGuideView