local barLength = 108
local barHeoght = 6.86
local WorldBossBattleStatisticsHeroItem = _G.BaseClass("WorldBossBattleStatisticsHeroItem")
function WorldBossBattleStatisticsHeroItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
end
function WorldBossBattleStatisticsHeroItem:Dispose()
    self.go_table = nil
end
function WorldBossBattleStatisticsHeroItem:Show(data, max)
    if not data then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
        return
    end
    self.Uid = data.Uid
    self.Sid = data.Sid
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.levelItem,
        self.go_table.trans_card,
        _G.handler(self, self.OnItemCall)
    )
    self.go_table.rect_attack:SetRectTransformSize(barLength * data.DmgOut / max.DmgOut, barHeoght)
    self.go_table.rect_defence:SetRectTransformSize(barLength * data.DmgIn / max.DmgIn, barHeoght)
    self.go_table.rect_cure:SetRectTransformSize(barLength * data.HpRecover / max.HpRecover, barHeoght)
    self.go_table.aortext_attack.text = _G.GameUtil.NumberToUnitStr(data.DmgOut)
    self.go_table.aortext_defence.text = _G.GameUtil.NumberToUnitStr(data.DmgIn)
    self.go_table.aortext_cure.text = _G.GameUtil.NumberToUnitStr(data.HpRecover)
end

function WorldBossBattleStatisticsHeroItem:ItemSet_MonsterCfg()
    local sid = self.Sid or 114200000
    local cfg = _G.ConfigManager.monster_cfg[sid]
    if cfg ~= nil then
        self.cardItem:Show(cfg.CardID, nil, cfg.Stars, cfg.Level, self.Uid)
    end
end
function WorldBossBattleStatisticsHeroItem:ItemSet_Card()
    local CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, tonumber(self.Uid))
    if CardData ~= nil then
        self.cardItem:Show(CardData.sid, nil, CardData.star, CardData.lv, CardData.uid, CardData.soulLink_lv)
    end
end

function WorldBossBattleStatisticsHeroItem:OnItemCall(card)
    self.cardItem = card

    if self.Uid ~= nil and self.Uid > 0 then
        --- 我方 可能有背包卡牌  与剧情战斗卡牌
        if string.len(tostring(self.Uid)) < 12 then
            -- 121010000
            self:ItemSet_MonsterCfg()
        else
            -- 281483566645270
            self:ItemSet_Card()
        end
    else
        self:ItemSet_MonsterCfg()
    end
    self.cardItem.transform:SetLocalPositionToZero()
    self.Uid = nil
end
--endregion

