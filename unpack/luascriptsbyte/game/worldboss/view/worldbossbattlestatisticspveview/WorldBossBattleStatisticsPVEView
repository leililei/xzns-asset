local WorldBossBattleStatisticsItem = _G.BaseClass("WorldBossBattleStatisticsItem")
local resultBgName = {win = "ui-cz-bg-zhanlidihong", lose = "ui-cz-bg-zhanlidilan"}
local resultTagName = {win = "ui_zdpp_txt_sheng", lose = "ui_zdpp_txt_bai"}
function WorldBossBattleStatisticsItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self:InitDataItem()
end

function WorldBossBattleStatisticsItem:InitDataItem()
    self.dataItem = {}
    for i = 1, 18 do
        if self.go_table["obj_single" .. i] then
            self.dataItem[i] = WorldBossBattleStatisticsHeroItem.New(self.go_table["obj_single" .. i])
        end
    end
end

function WorldBossBattleStatisticsItem:Dispose()
    self.go_table = nil
    for i = 1, #self.dataItem do
        self.dataItem:Dispose()
    end
    self.dataItem = nil
end
---展示数据
---@param baseinfo table 基础信息
---@param data table 统计数据
---@param isleft boolean 是否显示在左边
---@param max table 最大值
function WorldBossBattleStatisticsItem:Show(baseinfo, data, isleft, max, win)
    if win then
        self.go_table.aorimage_resultBg.SpriteName = resultBgName.win
        if not isleft then
            self.go_table.aorimage_resultBg:SetLocalScale(-1, 1, 1)
        else
            self.go_table.aorimage_resultBg:SetLocalScale(1, 1, 1)
        end
        self.go_table.aorimage_Result.SpriteName = resultTagName.win
    else
        self.go_table.aorimage_Result.SpriteName = resultTagName.lose
        self.go_table.aorimage_resultBg.SpriteName = resultBgName.lose
        if isleft then
            self.go_table.aorimage_resultBg:SetLocalScale(-1, 1, 1)
        else
            self.go_table.aorimage_resultBg:SetLocalScale(1, 1, 1)
        end
    end
    if isleft then
        self:ShowBase_L(baseinfo)
    else
        self:ShowBase_R(baseinfo)
    end
    self:ShowData(data, max)
end

function WorldBossBattleStatisticsItem:ShowBase_L(info)
    local cfg = _G.ConfigManager.player_portrait_cfg[info.headID]
    local icon = cfg.portrait1
    -- if _G.string.contains(icon, "/") then
    --     icon = _G.string.split2tbl(icon, "/")
    --     icon = icon[#icon]
    -- end
    require("CardInfoManager").LoadRawImage(self.go_table.aorimage_Icon, icon)
    -- self.go_table.aorimage_Icon.SpriteName = icon
    cfg = _G.ConfigManager.player_frame_cfg[info.frameID]
    self.go_table.aorrawimage_frame.Alpha = 0
    require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_frame, cfg.frame)
    self.go_table.aortext_Name.text = info.name
    self.go_table.aortext_Level.text = "Lv." .. info.level
end
function WorldBossBattleStatisticsItem:ShowBase_R(info)
    ---@type card_cfg
    local cfg = require "CardCommentManager":GetInstance():GetCfgs(_G.ConfigManager.card_cfg[info.cardID])
    local icon = cfg.Icon
    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    self.go_table.aorimage_Icon.SpriteName = icon

    self.go_table.aortext_Name.text = info.name
    self.go_table.aortext_Level.text = "Lv." .. info.level
end

function WorldBossBattleStatisticsItem:ShowData(data, max)
    for i = 1, #self.dataItem do
        local info = data[i]
        if info ~= nil then
            self.dataItem[i]:Show(info, max)
        end
        _G.GameUtil.SetActiveByCondition(self.dataItem[i].go_table.gameObject, info ~= nil)
    end
end
--endregion

---@class WolrdBossBattleStatisticsPVEView : UIBaseView	中文描述
---@field public go_table BattleStatisticsPVEView_GoTable GoTable
local WolrdBossBattleStatisticsPVEView = _G.BaseClass("WolrdBossBattleStatisticsPVEView", _G.UIBaseView)
function WolrdBossBattleStatisticsPVEView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WolrdBossBattleStatisticsPVEView:OnCreate(data, max, win)
    self.myItem = WorldBossBattleStatisticsItem.New(self.go_table.obj_mItem)
    self.enemyItem = WorldBossBattleStatisticsItem.New(self.go_table.obj_eItem)
    local MyBaseInfo = self:GetMyBaseInfo()
    self.myItem:Show(MyBaseInfo, data.Attacker, true, max, win)
    local tagerInfo = self:GetTagerBaseInfo(data.Defender)
    self.enemyItem:Show(tagerInfo, data.Defender, false, max, not win)
end

---获取自己的基础信息
---@return table 基础信息(头像，名称)
function WolrdBossBattleStatisticsPVEView:GetMyBaseInfo()
    local player = _G.PlayerModel:GetInstance()
    return {
        headID = player:GetRoleStyle(),
        name = player.role_name,
        cardID = player:GetRoleSid(),
        frameID = player:GetCurFrame(),
        level = player:GetLevel()
    }
end

---获取自己的基础信息
---@return table 基础信息(头像，名称)
function WolrdBossBattleStatisticsPVEView:GetTagerBaseInfo(Defender)
    if Defender == nil or #Defender == 0 then
        if _G.AppSetting.DEBUG then
            _G.LogError("WolrdBossBattleStatisticsPVEView:GetTagerBaseInfo Defender 非有效数组")
        end
        return
    end

    local monsterCfgDic = {}

    _G.SortList(
        Defender,
        function(a)
            local sid = a.Sid
            ---@param cfg monster_cfg_Item
            local cfg = nil
            cfg = monsterCfgDic[sid]
            if cfg == nil then
                cfg = _G.ConfigManager.monster_cfg[sid]
                monsterCfgDic[sid] = cfg
            end
            return cfg.MonsterType
            -- body
        end
    )
    local data = {
        headID = nil,
        name = nil,
        cardID = nil,
        frameID = nil,
        level = nil
    }
    local cfg = _G.ConfigManager.monster_cfg[Defender[1].Sid]
    data.headID = 0
    data.name = _G.LangUtil.GetLangPackValue(cfg.Name)
    data.cardID = cfg.CardID
    data.frameID = 0
    data.level = cfg.Level
    return data
end

---按钮点击事件在这里派发
function WolrdBossBattleStatisticsPVEView:OnClickBtn(go)
    self:Close()
end

return WolrdBossBattleStatisticsPVEView
