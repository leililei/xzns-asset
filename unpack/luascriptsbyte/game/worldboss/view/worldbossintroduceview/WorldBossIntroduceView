---@class WorldBossIntroduceView : UIBaseView	中文描述
---@field public go_table WorldBossIntroduceView_GoTable GoTable
---@field monsterCfg monster_cfg
---@field cfg boss_cfg
---@field skillList WorldBossIntroduceView._obj_skill1_GoTable[]
local WorldBossIntroduceView = _G.BaseClass("WorldBossIntroduceView", _G.UIBaseView)

local pageName = {
    "WorldBossCrusadeInfoView",
    "WorldBossRecommendView"
}

function WorldBossIntroduceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---界面的入口函数
function WorldBossIntroduceView:OnCreate(functionId,page)
    self.uiView = {}
    self.toggles = {}
    self.curPage = 1
    if page then
        self.curPage = page
    end
    self.cfg = _G.ConfigManager.system_cfg[functionId]
    self.maxCount = page and 1 or #self.cfg.boss_name
    self.toggleList = self.cfg.strategy_tab
    self.tag = 0
    local defaultTag = 0
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_right, self.maxCount > 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_left, self.maxCount > 1)
    for i = 1, 2 do
        _G.GameUtil.SetActiveByCondition(self.go_table["toggle_"..i], self.toggleList[i] ~= 0)
        if self.toggleList[i] ~= 0 then
            local gaTable = _G.GetAutoGoTable(self.go_table["toggle_"..i])
            self.toggles[i] = gaTable
            local name = _G.LangUtil.GetLangPackValue(self.toggleList[i] )
            gaTable.aortext_isOn.text = name
            gaTable.aortext_isOff.text = name
            if defaultTag == 0 then
                defaultTag = i
            end
        end
    end
    self.toggles[defaultTag]["toggle_"..defaultTag].isOn = true
    self:OnToggle(defaultTag)
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "_WorldBossIntroduce"..functionId,functionId)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CopyExplain.id, functionId)
end

function WorldBossIntroduceView:SetPageView()
    for i = 1, 2 do
        local name = pageName[i]
        _G.GameUtil.SetActiveByCondition(self.go_table["obj_"..name], self.tag == i)
    end
    if not self.uiView[self.tag] then
        local name = pageName[self.tag]
        self.uiView[self.tag] = self:AddComponent(self.go_table["obj_"..name], require(name).New(self.cfg))
    end
    self.uiView[self.tag]:ChangePage(self.curPage)
end

---更新显示
function WorldBossIntroduceView:ChangePage(offset)
    if offset then
        self.curPage = offset + self.curPage
        if self.curPage > self.maxCount then
            self.curPage = 1
        elseif self.curPage <= 0 then
            self.curPage = self.maxCount
        end
    end
    self.uiView[self.tag]:ChangePage(self.curPage)
end

---按钮点击事件在这里派发
function WorldBossIntroduceView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_left then
        self:ChangePage(-1)
    elseif go == self.go_table.aorbtn_right then
        self:ChangePage(1)
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_1 then
        self:OnToggle(1)
    elseif go == self.go_table.toggle_2 then
        self:OnToggle(2)
    elseif go == self.go_table.toggle_3 then
        self:OnToggle(3)
    end
end

function WorldBossIntroduceView:OnToggle(index)
    if self.tag == index then
        return
    end
    if self.tag ~= 0 then
        self.toggles[self.tag].aortext_isOn:SetActiveE(0)
        self.toggles[self.tag].aortext_isOff:SetActiveE(1)
    end
    self.toggles[index].aortext_isOn:SetActiveE(1)
    self.toggles[index].aortext_isOff:SetActiveE(0)
    self.tag = index
    self.tag = index
    self:SetPageView(index)
end

function WorldBossIntroduceView:EscClose()
    self:Close()
end

return WorldBossIntroduceView
