---@class WorldBossEmbattleItem	中文描述
---@field isEmpty boolean 是否为空
---@field cardItem ItemCardAllView
local WorldBossEmbattleItem = _G.BaseClass("WorldBossEmbattleItem")

---类的构造函数
function WorldBossEmbattleItem:__init(go, index, grounp, moveParent, onMoveEnd, onClick)
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
    self.isEmpty = true
    self.index = index
    self.grounp = grounp
    self.gameObject = go
    self.onMoveEnd = onMoveEnd
    self.widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
    _G.SetEventTrigger(self.go_table.aorbtn_mPos, "onDragBegin", _G.handler(self, self.onDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_mPos, "onDrag", _G.handler(self, self.onDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_mPos, "onDragEnd", _G.handler(self, self.onDragEnd))
    self.clickFunction = onClick
    self.mvoeParent = moveParent
end

---类的析构函数
function WorldBossEmbattleItem:Dispose()
end

function WorldBossEmbattleItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_mPos then
        self:OnClickItem()
    end
end

function WorldBossEmbattleItem:OnClickItem()
    if self.move then
        return
    end
    local data = self.data
    if self.data then
        self.data.isPut = false
        self:UnPut()
        if self.clickFunction then
            self.clickFunction(self.index, self.grounp, data)
        end
    else
        if self.clickFunction then
            self.clickFunction(self.index, self.grounp, data)
        end
    end
end

function WorldBossEmbattleItem:UnPut()
    self:Show(self.data)
end

function WorldBossEmbattleItem:OnEnter()
end

---拖拽开始
function WorldBossEmbattleItem:onDragBegin(go, ed)
    if not self.data then
        return
    end
    self.drag = true
    self.move = true
    local sx, sy, sz = self.go_table.trans_mPos:GetPosition()
    self.mvoeParent:SetPosition(sx, sy, sz)

    self.cardItem.transform:SetParentE(self.mvoeParent)
end

---拖拽
function WorldBossEmbattleItem:onDrag(go, ed)
    if not self.move then
        return
    end
    self.mvoeParent:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * self.widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end

---拖拽结束
function WorldBossEmbattleItem:onDragEnd(go, ed)
    if not self.move then
        return
    end
    self.drag = false
    self.move = false
    if self.onMoveEnd then
        self.onMoveEnd(self.index, self.grounp)
    end
end

---展示头像
---@param data WorldBossCardData
function WorldBossEmbattleItem:Show(data)
    if self.data and self.data.uid == data.uid or not data then
        if self.cardItem then
            _G.GameUtil.SetActiveByCondition(self.cardItem.gameObject, false)
        end
        if self.data then
            self.data.isPut = false
            self.data = nil
        end
        self.isEmpty = true
        return
    end

    self.data = data
    self.data.isPut = true
    if self.cardItem then
        _G.GameUtil.SetActiveByCondition(self.cardItem.gameObject, true)
        self.cardItem:ShowCardData(data.cardData)
    else
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.trans_mPos,
            function(view)
                self.cardItem = view
                self.cardItem:ShowCardData(data.cardData)
                self.cardItem.transform:SetLocalScaleXYZ(0.583)
            end
        )
    end
    self.isEmpty = false
end

function WorldBossEmbattleItem:GetIsEmpty()
    return self.isEmpty
end

---更改卡牌
function WorldBossEmbattleItem:SetData(data, cardItem)
    self.data = data
    self.cardItem = cardItem
    if cardItem then
        cardItem.gameObject:SetParentE(self.go_table.trans_mPos)
        cardItem.gameObject:SetRectOffSetToZero()
    end
    if not self.data then
        self.isEmpty = true
    else
        self.isEmpty = false
    end
end

---重置头像位置
function WorldBossEmbattleItem:ResetItemPos()
    self.cardItem.transform:SetParentE(self.go_table.trans_mPos)
    self.cardItem.transform:SetLocalPositionToZero()
end

function WorldBossEmbattleItem:Clear()
    self.isEmpty = true
    if self.data then
        self.data:UpdateCanChoose()
        self.data.isPut = false
        self.data = nil
    end
    if self.cardItem then
        _G.GameUtil.SetActiveByCondition(self.cardItem.gameObject, false)
    end
end

return WorldBossEmbattleItem
