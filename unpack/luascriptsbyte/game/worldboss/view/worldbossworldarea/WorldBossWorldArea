local WorldBossEmbattleItem = require "WorldBossEmbattleItem"
---@class WorldBossWorldArea	中文描述
---@field go_table WorldBossEmbattleView._obj_Area1_GoTable
---@field Items WorldBossEmbattleItem[]
---@field cfg boss_cfg
---@field data WorldBossData
---@field skillList  _obj_Area2._obj_skill2_GoTable[]
local WorldBossWorldArea = _G.BaseClass("WorldBossWorldArea")

---类的构造函数
function WorldBossWorldArea:__init(go, index, moveParent, onClick, onMoveEnd)
    self.gameObject = go
    self.go_table = _G.GetAutoGoTable(go)
    self.index = index
    self.Items = {}
    self.onClick = onClick
    self.onMoveEnd = onMoveEnd
    self.moveParent = moveParent
end

---类的析构函数
function WorldBossWorldArea:Dispose()
end
---界面显示
---@param data WorldBossCrusadeData
function WorldBossWorldArea:Show(data)
    self.data = data
    self.cfg = data.cfg
    self.state = require "WorldBossModel":GetInstance():GetCombineSkillState()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_leftLock, data.isLock)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Skill, not data.isLock)
    if data.isLock then
        self.go_table.aortext_content.text = ""
        self.go_table.aortext_lockContent.text = data.LockStr
    end
    if not data.isLock then
        self:InitPos()
        self:UpdateSkills()
    end
end

function WorldBossWorldArea:UpdateSkills()
    if not self.skillList then
        self.skillList = {}
        self.skillDatas = require "EmbattleModel":GetInstance():GetSkillIndex(60 + self.cfg.id)
        for i = 1, 3 do
            self.skillList[i] =
                _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnClickSkill, i))
        end
    end
    for i = 1, 3 do
        self:UpdateEquipSkill(self.skillList[i], self.skillDatas[i], i)
    end
end

function WorldBossWorldArea:OnClickSkill(go, isOn, index)
    local tb = {}
    local list = require "CombineModel":GetInstance():GetUnLockCombine()
    if list then
        for k, v in pairs(list) do
            _G.table.insert(tb, {k, v})
        end
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name,
        require "EmbattleModel":GetInstance():GetSkillIndex(60 + self.cfg.id),
        _G.handler(self, self.OnCombSkillViewCloseCall),
        require "WorldBossModel":GetInstance():GetOtherUseCombineSkill(self.cfg.id),
        tb,
        self.state,
        index
    )
end

function WorldBossWorldArea:OnCombSkillViewCloseCall(skill)
    require "EmbattleModel":GetInstance():SetSkillIndex(60 + self.cfg.id, skill)
    self.skillDatas = skill
    self:UpdateSkills()
end
---@param tb  _obj_Area2._obj_skill2_GoTable
---@param id number
function WorldBossWorldArea:UpdateEquipSkill(tb, id, index)
    _G.GameUtil.SetActiveByCondition(tb.obj_lock, not self.state[index])
    if self.state[index] then
        ---@type combine_cfg
        local cfg = _G.ConfigManager.combine_cfg[id]
        if cfg then
            _G.GameUtil.SetActiveByCondition(tb.obj_show, true)
            ---@type card_skills_cfg
            local card_skills_cfg = _G.ConfigManager.card_skills_cfg[cfg.skills[1]]
            local battleCfg = _G.ConfigManager.battle_skill_cfg[card_skills_cfg.skills[1]]
            tb.aorrawimage_icon:LoadImage(card_skills_cfg.icon)
            tb.aortext_type.text = _G.ConfigManager.language_package_cfg[battleCfg.Brief]
            tb.aortext_type2.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][index])
        else
            _G.GameUtil.SetActiveByCondition(tb.obj_show, false)
        end
    end
end

function WorldBossWorldArea:GetIsLock()
    return self.data.isLock
end

---初始化所有位置
function WorldBossWorldArea:InitPos()
    require "EmbattleModel":GetInstance():SetSkillIndex(60 + self.cfg.id, {0, 0, 0})
    for i = 1, 5 do
        self.Items[i] =
            WorldBossEmbattleItem.New(
            self.go_table["obj_root" .. i],
            i,
            self.index,
            self.moveParent,
            self.onMoveEnd,
            self.onClick
        )
    end
end

---更新卡牌
---@param index number 更新卡牌位置
---@param data WorldBossCardData
function WorldBossWorldArea:UpdateCard(index, data)
    self.Items[index]:Show(data)
end

function WorldBossWorldArea:Clear()
    for i = 1, 5 do
        self.Items[i]:Clear()
    end
end

---获取该位置是否已经上阵卡牌
---@param index number
---@return boolean
function WorldBossWorldArea:GetCardIsEmpty(index)
    return self.Items[index]:GetIsEmpty()
end

function WorldBossWorldArea:GetProType(index)
    local item = self.Items[index]
    if item:GetIsEmpty() then
        return 0
    else
        return item.data.pro
    end
end

function WorldBossWorldArea:GetElementType(index)
    local item = self.Items[index]
    if item:GetIsEmpty() then
        return 0
    else
        return item.data.element
    end
end
---获取卡牌uid
function WorldBossWorldArea:GetCardUid(index)
    local item = self.Items[index]
    if item:GetIsEmpty() then
        return 0
    else
        return item.data.uid
    end
end

---检测物体是否在该区域
function WorldBossWorldArea:CheckInRect(index, group)
    if self:GetIsLock() then
        return 0
    end

    if _G.CS.UIUtils.ChecklocalPositionInRect(self.moveParent, self.go_table.aorrawimage_BG.gameObject, false) then
        for i = 1, 5 do
            if not (i == index and self.index == group) then
                if _G.CS.UIUtils.ChecklocalPositionInRect(self.moveParent, self.Items[i].gameObject, false) then
                    return i
                end
            end
        end
    end
    return 0
end

---获取物体
---@return WorldBossEmbattleItem
function WorldBossWorldArea:GetItem(index)
    return self.Items[index]
end

function WorldBossWorldArea:PlayEffect()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_leftLock.gameObject, true)
    self.go_table.aorrawimage_leftLock.enabled = false
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shijiebossjiemian_jiesuo,
        self.go_table.aorrawimage_leftLock,
        nil,
        function()
            _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_leftLock, false)
            _G.PlayerPrefsManager.DeleteKey("WorldBossEffect")
        end
    )
end

return WorldBossWorldArea
