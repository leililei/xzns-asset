---开始讨伐
---@param cards WorldBossCardData[]
function WorldBossManager:StartCrusade()
    self.curPage = 0
    local tb = require "WorldBossModel":GetInstance():GetEmbattleSid()

    local port =
        WorldBossNet:GetInstance():FightCrusadeFight(
            { gids = tb },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                ---存储战报数据, 用于结算页面展示mvp信息
                self.fightArg = msg.fight_arg
                self:OnNextPage()
            end
        )

    _G.BattleManager:GetInstance():AddLuaNetEvent(port)
end

