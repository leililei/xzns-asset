---开始挑战
function WorldBossManager:StartChangllenge(callback)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.WroldBossView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        _G.EmbattleType.worldBoss,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.pve,
        _G.handler(self, self.ExitEmbattle),
        _G.handler(self, self.EnterFight),
        WorldBossModel:GetInstance().bossCfg.monster_group
    )
    self.fightCall = callback
end

---检测是否能挑战
function WorldBossManager:OpenEmbattleView(callback)
    if
        self.isFirstChangllenge and
            _G.StorageManager:GetInstance():GetPlayerPower() >= WorldBossModel:GetInstance().monsterCfg.Power and
            not WorldBossModel:GetInstance():CheckChangllengeIsPass()
     then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            310302,
            nil,
            function()
                if callback then
                    callback()
                end
            end,
            function()
            end
        )
        self.isFirstChangllenge = false
    else
        if callback then
            callback()
        end
    end
end

