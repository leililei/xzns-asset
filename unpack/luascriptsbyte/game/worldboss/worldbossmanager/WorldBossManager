---@param skipBattle boolean    @是否显示跳过战斗按钮
function WorldBossManager:OnCrusade(skipBattle)
    local tb, cfgs = require "WorldBossModel":GetInstance():GetEmbattleSid()
    local enemy = require "WorldBossModel":GetInstance():GetEmbattleEnemyData()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.WorldBossEmbattleNewView.Name,
        tb,
        _G.handler(self, self.OnExitCall),
        function(_, _, _skipBattle)
            if _skipBattle then
                self:SkipCrusadeFight()
            else
                self:StartCrusade()
            end
        end,
        enemy,
        _G.ConfigManager.ui_cfg.WorldBossChallengeTeamView.Name,
        skipBattle
    )
end

function WorldBossManager:OnExitCall()
    self:ReturnPanel()
end

---获取最大伤害的卡牌sid
function WorldBossManager:GetMaxDamageSid()
    local statistics = _G.BattleManager:GetInstance():GetStatistics()
    local damage = -1
    local score = 0
    local uid = 0
    for _, v in pairs(statistics.FighterInfo) do
        for _, v2 in pairs(v.Attacker) do
            score = score + v2.DmgOut
            if damage < v2.DmgOut then
                damage = v2.DmgOut
                uid = v2.Uid
            end
        end
    end
    WorldBossModel:GetInstance().wordData.score = score
    return _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid).sid
end

function WorldBossManager:GetDamage()
    local statistics = _G.BattleManager:GetInstance():GetStatistics()
    local score = 0
    for _, v in pairs(statistics.FighterInfo) do
        for _, v2 in pairs(v.Attacker) do
            score = score + v2.DmgOut
        end
    end
    return score
end

---切换下个阶段的战斗
function WorldBossManager:OnNextPage()
    _G.BattleManager:GetInstance():EnterFight(
        _G.BattleControllerType.worldBossCrusade,
        60 + self.curPage,
        _G.PlayerModel:GetInstance():GetName(),
        self:GetBossName()
    )
end

function WorldBossManager:CheckUids(tb)
    if not tb then
        return false
    end
    for _, v in pairs(tb) do
        if v.uid > 0 then
            return true
        end
    end
    return false
end

---检测是否为休战期(讨伐模式)
function WorldBossManager:CheckIsStop()
    if self:CheckTime() then
        _G.PopWindowManager:GetInstance():ShowAllTips(310105)
        return true
    end
    return false
end

function WorldBossManager:CheckTime()
    local time = _G.TimeUtil.GetSixClockTimer()
    if time < 3600 and time > 0 then
        return true
    end
    return false
end

---获取世界boss名字
---@param index? number  @第几波, 如果传nil则表示获取所有boss名称(列表)
---@return string|string[]
function WorldBossManager:GetBossName(index)
    local enemy = require("WorldBossModel"):GetInstance():GetEmbattleEnemyData()
    if not enemy then
        return nil
    end
    --取指定序号boss名称
    if index then
        if not enemy[index] then
            return nil
        end
        local name
        if enemy and enemy[index] then
            for _, v in pairs(enemy[index]) do
                local cfg = v.sid > 0 and _G.ConfigManager.card_cfg[v.sid]
                if cfg and (not name or cfg.UnitType == 5) then
                    name = _G.LangUtil.GetLangPackValue(cfg.Name)
                end
            end
        end
        return name
    else
        --获取所有boss名称
        local names = {}
        for i = 1, #enemy do
            local name
            for _, v in pairs(enemy[i]) do
                local cfg = v.sid > 0 and _G.ConfigManager.card_cfg[v.sid]
                if cfg and (not name or cfg.UnitType == 5) then
                    name = _G.LangUtil.GetLangPackValue(cfg.Name)
                end
            end
            table.insert(names, name or "")
        end
        return names
    end
end

return WorldBossManager
