---@class SociatyFeastData	中文描述
---@field food guild.i_food
---@field cfgs guild_feast_cfg[]
---@field curCfg guild_feast_cfg
---@field relCfg guild_feast_cfg
---@field canTake boolean 是否能领取奖励
local SociatyFeastData = _G.BaseClass("SociatyFeastData")

---类的构造函数
function SociatyFeastData:__init()
end

---类的析构函数
function SociatyFeastData:Dispose()
    self.data = nil
    self.sequence = nil
    self.cfgs = nil
    self.curCfg = nil
end

---@param data guild.i_food
---@param cfg guild_level_cfg
function SociatyFeastData:Parse(data, cfg)
    self.food = data
    self.sequence = data.location
    local curId = cfg.feast[self.sequence]
    self:InitCfg(curId)
    _G.SortList(
        self.cfgs,
        function(a)
            return -a.quality
        end
    )
    self.canTake = self.food.count == self.food.need
end

---获取所有当前位置的配置
function SociatyFeastData:InitCfg(curId)
    self.cfgs = {}
    self.curCfg = nil
    for _, v in pairs(_G.ConfigManager.guild_feast_cfg) do
        if v.sequence == self.sequence then
            _G.table.insert(self.cfgs, v)
            if v.id == self.food.fid then
                self.curCfg = v
            end
            if v.id == curId then
                self.relCfg = v
            end
        end
    end
end

return SociatyFeastData
