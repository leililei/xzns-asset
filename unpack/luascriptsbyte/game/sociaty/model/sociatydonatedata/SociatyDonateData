---@class SociatyDonateData	中文描述
---@field donate number 捐献值
---@field awardDonateIds table 以领取捐献id
---@field donateIds table<number> 已捐献id
local SociatyDonateData = _G.BaseClass("SociatyDonateData")
---类的构造函数
function SociatyDonateData:__init()
    self.donate = 0
    self.awardDonateIds = {}
    self.donateIds = {}
    self.isDonate = false
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.RefreshDonate, self.UpdateDonate, self)
end
---解析数据
---@param msg guild.s2c_guild_donate_info
function SociatyDonateData:ParseData(msg)
    self.donate = msg.info.donate
    self:InitAwardDonateId(msg.info.award_list)
    self:InitDonateId(msg.info.donate_list)
end
---初始化已领取奖励列表
function SociatyDonateData:InitAwardDonateId(data)
    self.awardDonateIds = {}
    if data then
        for _, v in pairs(data) do
            self.awardDonateIds[v] = true
        end
    end
end

---初始化已捐献id
---@param data table<number>
function SociatyDonateData:InitDonateId(data)
    self.donateIds = {}
    if data then
        self.isDonate = true
        for _, v in pairs(data) do
            self.donateIds[v] = true
        end
    else
        self.isDonate = false
    end
end

---添加捐献id
function SociatyDonateData:AddDonateId(id)
    if not id then
        return
    end
    self.isDonate = true
    self.donateIds[id] = true
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildDonation.id)
end

---检测是否捐献
function SociatyDonateData:CheckIsDonate(id)
    return self.donateIds[id]
end

---检测是否领取奖励
function SociatyDonateData:CheckIsGet(id)
    return self.awardDonateIds[id]
end
---添加领取捐献奖励id
function SociatyDonateData:AddAwardDonateId(id)
    self.awardDonateIds[id] = true
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildDonation.id)
end

function SociatyDonateData:UpdateDonate(data)
    if data then
        self.donate = self.donate + data.donate_num
    end
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildDonation.id)
end

---类的析构函数
function SociatyDonateData:Dispose()
    self.donateIds = nil
    self.donate = nil
    self.awardDonateIds = nil
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RefreshDonate, self.UpdateDonate, self)
end
---获取可领取列表
function SociatyDonateData:GetCanTakeList()
    local tb={}
    local tb2={}
    local guildCfg= require "SociatyModel":GetInstance().SociatySelf.LevelCfg
    local cfgs=_G.ConfigManager.guild_donate_goal_cfg
    local cfg
    for k, v in pairs(guildCfg.donate_goal) do
        cfg=cfgs[v]
        if cfg and cfg.point_donate <= self.donate and not self:CheckIsGet(k) then
            _G.table.insert(tb,v)
            tb2[v]=k
        end
    end
    return tb,tb2
end

return SociatyDonateData
