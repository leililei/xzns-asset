---@class SociatyStorageData	仓库货物数据
---@field cfg guild_warehouse_cfg_Item 货物配置
---@field goodData guild.i_good 货物数据
---@field propCfg item_cfg_Item 碎片对应的道具配置
---@field cardCfg card_cfg 碎片对应的卡牌配置
local SociatyStorageData = _G.BaseClass("SociatyStorageData")
_G.SociatyStorageData = SociatyStorageData

---类的构造函数
function SociatyStorageData:__init()
    self.cfg = nil
    self.goodData = nil
end

---@param data guild.i_good
function SociatyStorageData:Parse(data)
    self.goodData = data
    self.cfg = _G.ConfigManager.guild_warehouse_cfg[data.id]
    self.propCfg = _G.ConfigManager.item_cfg[data.id]
    self.cardCfg = _G.ConfigManager.card_cfg[tonumber(self.propCfg.UseParameter[1][2])]
end

---类的析构函数
function SociatyStorageData:Dispose()
end

return SociatyStorageData
