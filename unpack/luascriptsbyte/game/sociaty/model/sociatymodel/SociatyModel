end
---领取同名系统目标奖励
function SociatyModel:GetHomeTargetAward(callback)
    local pb={award_id=self:GetAllCanGetHomoTargetIds()}
    SociatyNet:GetInstance():GetHonoAward(pb,function(msg)
        if msg.ack==1 then
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            
            if not self.SociatyRoleSelf.name_award then
                self.SociatyRoleSelf.name_award = {}
            end
            for i = 1, #pb.award_id do
                table.insert(self.SociatyRoleSelf.name_award,pb.award_id[i])
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SocaityMemberHonoRedPoint.id)
            if callback then
                callback()
            end
        end
    end)
end
---公会成员同名修改推送
function SociatyModel:MemberUpDateName(msg)
    local member=table.find(self.SociatySelf.prefix_role,function(a) return a.role_uid==msg.role.role_uid end)
    if member then
        member.role_name=msg.role.role_name
    else
        table.insert(self.SociatySelf.prefix_role,{role_uid= msg.role.role_uid,role_name=msg.role.role_name})
    end
    self.SociatySelf.SociatyMemberModule.MemberDic[msg.role.role_uid].Name=msg.role.role_name
    local memberitem=table.find(self.SociatySelf.SociatyMemberModule.Member,
            function(a) return a.Uid == msg.role.role_uid end)
    memberitem.Name=msg.role.role_name
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SocaityMemberHonoRedPoint.id)
end

---公会会长同名前缀修改推送
function SociatyModel:HomoUpDateName(msg)
    self.SociatySelf.guild_prefix=msg.prefix
end
---获取同名系统达到目标所有可领取的奖励id
function SociatyModel:GetAllCanGetHomoTargetIds()
    local guild_name_cfg = _G.ConfigManager.guild_name_cfg
    local ids={}
    for id,cfg  in pairs(guild_name_cfg) do
        if not table.ContainsValue(self.SociatyRoleSelf.name_award,id) 
        and table.count(self.SociatySelf.prefix_role)>=cfg.condition then
            table.insert(ids,id)
        end
    end
    return ids
end
---判断是否存在同名系统目标奖励未领取
function SociatyModel:CheckHasAwardCanGetInHomo()
    local guild_name_cfg = _G.ConfigManager.guild_name_cfg
    for id,cfg  in pairs(guild_name_cfg) do
        if not table.ContainsValue(self.SociatyRoleSelf.name_award,id)
                and table.count(self.SociatySelf.prefix_role)>=cfg.condition then
            return 1
        end
    end
    return 0
end
---通过id判断同名目标奖励是否已经领取
function SociatyModel:CheckHomoAwardIsGetById(id)
    local isget= table.ContainsValue(self.SociatyRoleSelf.name_award,id)
    return isget and 1 or 0
end

---通过id判断同名目标奖励是否可领取
function SociatyModel:CheckHomoAwardCanGetById(id)
    return table.ContainsValue(self.SociatyRoleSelf.name_award,id) and 1 or 0
end
---通过时间戳判断玩家是否第一次改名
function SociatyModel:CheckChooseNameIsFirstByTime()
    return self.SociatySelf.prefix_time>=self.SociatyRoleSelf.update_name_time
end
function SociatyModel:CheckIsShowHomoNameBtn()
    return self.SociatySelf.Level>=_G.ConfigManager.discrete_cfg[201301][1][1] and 1 or 0
end
function SociatyModel:GetNowHonoMemberNum()
    return table.isEmptyOrNil(self.SociatySelf.prefix_role) and 0 or table.count(self.SociatySelf.prefix_role)
end
function SociatyModel:CheckMemberHonoRedPoint()
    if table.isEmptyOrNil(self.SociatySelf) then
        return 0
    end
    if self:CheckIsShowHomoNameBtn()==0 then
        return 0
    end
    if _G.PlayerPrefsManager.GetInt("MemberHonoRedPoint",0)==0 then
        return 1
    end
    return self:CheckHasAwardCanGetInHomo()
end
