---数据回调
---@param msg guild.s2c_get_guild 公会相关数据
function SociatyModel:ParseData(msg)
    if msg then
        self.SociatyRoleSelf = msg.role_guild
        self.SociatyRoleSelf.requests = msg.role_guild.requests or {}
        self:InitLike()
        self:ParseSociatySelf(msg.guild)
        if self.CardChat then
            self.CardChat = false
            require "ChatManager":GetInstance():GetSociatyChat()
        end
        self.FameData = nil
    else
        self.super.ParseData(self)
    end
    self:UpdateBuildAwardLevels()
    --刷新红点信息
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildGlory.id)
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefreshSociatyInfo)
end

---初始化雕像数据
function SociatyModel:InitLike()
    self.likeList = {}
    self.likeCount = 5
    if self.SociatyRoleSelf.statue_points then
        for _, v in pairs(self.SociatyRoleSelf.statue_points) do
            self.likeList[v] = true
        end
    end
    self.likeCount = self.maxLike - _G.table.count(self.likeList)
end

---公会boss挑战
---@param sid number 公会Boss sid
function SociatyModel:OnChallenge(sid, isTest)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SociatyWitchTrialsView.Name)
    self.curBossCfg = _G.ConfigManager.guild_boss_cfg[sid]
    self.isTest = isTest

    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        _G.EmbattleType.sociatyBoss,
        _G.EmbattleSaveType.server,
        false,
        _G.EmbattleControllerItemType.sociatyBoss,
        _G.handler(self, self.ExitEmbattle),
        _G.handler(self, self.EnterFight),
        self.curBossCfg.monster_group
    )
end

function SociatyModel:OnEmbattleOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
    ---@type EmbattleNewView
    local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if embattleView then
        embattleView:SetVsDescription(_G.PlayerModel:GetInstance():GetName(), _G.GetLangPackValue(90021800374))
    end
end

---退出布阵
function SociatyModel:ExitEmbattle()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SociatyWitchTrialsView.Name) then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SociatyWitchTrialsView.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyWitchTrialsView.Name)
    end
end

