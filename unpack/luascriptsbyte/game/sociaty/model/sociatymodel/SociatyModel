function SociatyModel:CheckDonateRedPoint()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end

    if not self.donateData then
        return false
    end

    if not self.donateData.isDonate then
        for _, v in pairs(_G.ConfigManager.guild_donate_cfg) do
            --只检测魂币捐献
            if
                v.consume[1] == _G.ResPropID.Coin and
                _G.StorageManager:GetInstance():CheckItem(v.consume[1], v.consume[2]) and
                not self.donateData:CheckIsDonate(v.id)
            then
                return true
            end
        end
        ---@type guild_level_cfg
        local guildCfg = self.SociatySelf.LevelCfg
        ---@type guild_donate_goal_cfg
        local cfg
        for _, v in pairs(guildCfg.donate_goal) do
            cfg = _G.ConfigManager.guild_donate_goal_cfg[v]
            if cfg.point_donate <= self.donateData.donate and not self.donateData:CheckIsGet(v % 100) then
                return true
            end
        end
    else
        ---@type guild_level_cfg
        local guildCfg = self.SociatySelf.LevelCfg
        ---@type guild_donate_goal_cfg
        local cfg
        for _, v in pairs(guildCfg.donate_goal) do
            cfg = _G.ConfigManager.guild_donate_goal_cfg[v]
            if cfg.point_donate <= self.donateData.donate and not self.donateData:CheckIsGet(v % 100) then
                return true
            end
        end
    end
    return false
end

---公会雕像点赞玩家
---@param uid number 玩家uid
function SociatyModel:Like(uid, call)
    if self.likeList[uid] then
        _G.PopWindowManager:GetInstance():ShowAllTips(740101)
        return
    end
    if self.likeCount <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(740102)
        return
    end
    require "SociatyNet":GetInstance():Like(
        { uid = uid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.likeCount = self.likeCount - 1
            self.likeList[uid] = true
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PlayerModel:GetInstance():AddPoint(1)
            end
            if call then
                call(msg)
            end
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildStatue.id)
        end
    )
end

function SociatyModel:OnSixClockUpdate(endcall)
    if not require "SociatyManager":GetInstance():HasSociaty() then
        if endcall then
            endcall()
        end
        return
    end
    self:InitYHModel()
    self:InitDonateModel()
    self:InitGuildStatue()
    self:InitSevenDayLiveRank()
    self.LeagueModelCor = _G.DelayDo(5, function()
        self:InitSociatyBattleLeagueModel()
    end)

    self.likeList = {}
    self.likeCount = self.maxLike
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefreshLike)
    if endcall then
        endcall()
    end
end

function SociatyModel:Dispose()
    if self.LeagueModelCor then
        _G.coroutine.stopwaiting(self.LeagueModelCor)
        self.LeagueModelCor = nil
    end
    SociatyModel = nil
end

function SociatyModel:ReConnect(endcall)
