---退出公会就把个人所在公会数据清理
---@param isKick boolean 是否踢出
function SociatyModel:ClearSociatySelf(isKick)
    self.SociatySelf:Dispose()
    self.SociatySelf = nil

    if not self.SociatyRoleSelf.exit_num then
        self.SociatyRoleSelf.exit_num = 0
    end
    self.SociatyRoleSelf = {
        ["uid"] = 0,
        ["exit_time"] = TimeUtil.GetServerUnixTime(),
        ["requests"] = {},
        ["position"] = 0,
        ["liveness"] = 0,
        ["week_liveness"] = 0,
        ["exit_num"] = self.SociatyRoleSelf.exit_num + 1,
        ["update_name_time"]=self.SociatyRoleSelf.update_name_time or 0,
        ["name_award"] =self.SociatyRoleSelf.name_award or {},
        ["enter_time"] =self.SociatyRoleSelf.enter_time or 0
    }
    ---ZHJH-7897 首次退出（解散）无加入CD
    local isFirst = self.SociatyRoleSelf.exit_num == 1 and not isKick
    ---如果被踢了就不存在CD
    if isKick or isFirst then
        self.SociatyRoleSelf.exit_time = 0
    end
end

