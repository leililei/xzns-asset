---获取弹劾信息
function SociatyModel:GetImpeachInfo(call)
    self.ImpeachUidList = {}
    self.ImpeachNum = 0
    SociatyNet:GetInstance():GetImpeachInfo(
        function(msg)
            if msg.ack == 1 then
                local ilt = msg.impeach_list
                if ilt then
                    for i = 1, #ilt do
                        table.insert(self.ImpeachUidList, ilt[i])
                    end
                end
                self.ImpeachNum = #self.ImpeachUidList
                self.ImpeachInfo = msg
                if call then
                    call(msg.is_open)
                end
            else
                if call then
                    call(0)
                end
            end
        end
    )
end

---弹劾
function SociatyModel:DoImpeach(uid, call)
    SociatyNet:GetInstance():DoImpeach(
        function(msg)
            if msg.ack == 1 then
                if false == table.indexof(self.ImpeachUidList, uid) then
                    table.insert(self.ImpeachUidList, uid)
                end

                self.ImpeachNum = msg.curr

                ---自己是最后一个弹劾的，不会有推送，自行处理职位变更
                if self.ImpeachNum >= self.ImpeachInfo.need_num then
                    ---@type guild.p2c_guild_position
                    local guild_p2c_guild_position = {
                        ["pos"] = {
                            {
                                ["uid"] = self.SociatySelf:GetChairman().Uid,
                                ["pos"] = ELocationEnum.Member
                            },
                            {
                                ["uid"] = self.ImpeachInfo.role.uid,
                                ["pos"] = ELocationEnum.Chairman
                            }
                        }
                    }

                    self.SociatySelf.SociatyMemberModule:OnSetPosition(guild_p2c_guild_position)
                end
                if call then
                    call(msg)
                end
            elseif msg.ack == 829 then
                if call then
                    call(msg)
                end
            end
        end
    )
end

---是否参与了弹劾
function SociatyModel:IsImpeach(uid)
    if false ~= table.indexof(self.ImpeachUidList, uid) then
        return true
    end
    return false
end

