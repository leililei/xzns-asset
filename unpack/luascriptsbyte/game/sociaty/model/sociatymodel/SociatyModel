function SociatyModel:GetBuildLevelCfg()
    local cfg = _G.ConfigManager.guild_unit_cfg[1].conditions
    self.buildLevelCfg = { [1] = { 1, 1, 1, 1, 1 } }
    for k, v1 in pairs(cfg) do
        if v1[1] ~= 0 then
            if not self.buildLevelCfg[k] then
                self.buildLevelCfg[k] = {}
            end
            for i = 2, 5 do
                self.buildLevelCfg[k][i] = self.buildLevelCfg[k - 1][i]
            end
            for i = 1, #v1, 2 do
                self.buildLevelCfg[k][v1[i]] = v1[i + 1]
            end
        end
    end
    return self.buildLevelCfg
end

