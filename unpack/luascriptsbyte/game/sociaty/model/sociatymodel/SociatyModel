---检测是否点在
function SociatyModel:CheckIsLikeWithIndex(index)
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return
    end
    if require "SociatyManager".CheckGuideIsLock() or _G.table.isEmptyOrNil(self.roles) then
        return false
    end
    if require "SociatyManager":GetInstance():GetLikeNum() <= 0 then
        return
    end
    local role = self.roles[index]
    if role then
        return not self.likeList[role.uid]
    end
    return false
end

