---是否在入会CD中
function SociatyModel:IsCding()
    ---没有时间可以看成无CD
    if self.SociatyRoleSelf.exit_time <= 0 then
        return false
    end
    local severTime = TimeUtil.GetServerUnixTime()
    local cdTime = _G.ConfigManager.discrete_cfg[101604][1][1]
    ---离线时间+冷却时间
    local cdtime = self.SociatyRoleSelf.exit_time + cdTime - severTime
    if cdtime > 0 then
        return true, TimeUtil.TimeToStringHMS(cdtime)
    end
    return false
end

