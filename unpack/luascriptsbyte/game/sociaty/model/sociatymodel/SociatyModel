---检测是否能战斗（有公会试炼boss结算期）
function SociatyModel:CheckBattleTime(isPopTip)
    if isPopTip == nil then
        isPopTip = true
    end
    if _G.TimeUtil.GetSecondsOfDay() < _G.ConfigManager.discrete_cfg[124401][1][1] * 3600 then
        return true
    end
    if isPopTip then
        _G.PopWindowManager:GetInstance():ShowAllTips(827)
    end
    return false
end

---
---@protected
function SociatyModel:SetYHBattleCdTimer()
    if self.YHBattleCdTimer == nil then
        local curTime = _G.TimeUtil.GetSecondsOfDay()
        local cdTime = _G.ConfigManager.discrete_cfg[124401][1][1] * 3600
        if curTime < cdTime then
            local time = cdTime - curTime
            self.YHBattleCdTimer = _G.TimerManager:GetInstance():GetTimer(time, self.YHBattleCdTimerFunc, self, true,
                false, true)
            self.YHBattleCdTimer:Start()
        end
    end
end

function SociatyModel:YHBattleCdTimerFunc()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.GuildchallengeButton.id
    )
    if self.YHBattleCdTimer then
        self.YHBattleCdTimer:Stop()
        self.YHBattleCdTimer = nil
    end
end

---检测公会试炼伤害排行奖励红点
function SociatyModel:CheckSociatyDamageRankAward()
    if self.feastData then
        local awardList = {}
        local ids = _G.ConfigManager.discrete_cfg[124501][1]
        local cfg = _G.ConfigManager.system_rank_cfg
        local awardRank = 0
        for i, v in ipairs(ids) do
            local data = cfg[v]
            _G.table.insert(awardList, data)
            if awardRank < data.max_rank then
                awardRank = data.max_rank
            end
        end
        if self.feastData.last_rank > 0 and self.feastData.last_rank <= awardRank and self.feastData.rank_award == false then
            return true
        end
    end
    return false
end

---获取未领取（可领取）宝箱
function SociatyModel:CreateUnopenedBox()
    self.unopenedBox = {}
    if _G.table.isEmptyOrNil(self.feastData.get_foods) then
        self.feastData.get_foods = {}
    end
    local boxCondition = {}
    for _, v in pairs(_G.ConfigManager.guild_level_cfg[self.SociatySelf.Level].feast) do
        _G.table.insert(boxCondition, _G.ConfigManager.guild_feast_cfg[v])
    end
    local getNum = #self.feastData.get_foods
    for i = 1, #boxCondition do
        local need = boxCondition[i].materials[2]
        if self.feastData.fight_times >= need then
            if getNum < i then
                _G.table.insert(self.unopenedBox, i)
            end
        end
    end
end

---检查是否有宴会宝箱未开
function SociatyModel:CheckHaveBox()
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return false
    end
    if self.unopenedBox then
        return #self.unopenedBox > 0
    end
    return false
end

---移除开启奖励的宴会宝箱
function SociatyModel:RemoveHadBox(index)
    if not require "SociatyManager":GetInstance():HasSociaty() then
        return
    end
    for i = 1, #self.unopenedBox do
        if self.unopenedBox[i] == index then
            table.remove(self.unopenedBox, i)
            break
        end
    end
end

