---@return SociatyModel SociatyModel
function SociatyModel:GetInstance()
    return self.super.GetInstance(self)
end

---公会数据类构造函数
function SociatyModel:__init()
    self.SociatySelf = nil
    self.CardChat = true
    self.SociatyRoleSelf = {
        ["uid"] = 0,
        ["exit_time"] = 0,
        ["requests"] = {},
        ["position"] = 0,
        ["liveness"] = 0,
        ["week_liveness"] = 0,
        ["exit_num"] = 0,
        ["update_name_time"] = 0,
        ["name_award"]={},
        ["enter_time"]=0
    }
    self.maxLike = _G.ConfigManager.discrete_cfg[102703][1][1]
    self.ImpeachUidList = {}
    self.ImpeachNum = 0

    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.RefreshDonate, self.OnUpdateDonate, self)
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.RefreshBuild, self.OnRefreshBuild, self)
end

function SociatyModel:Dispose()
    if self.YHBattleCdTimer then
        self.YHBattleCdTimer:Stop()
        self.YHBattleCdTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RefreshDonate, self.OnUpdateDonate, self)
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RefreshBuild, self.OnRefreshBuild, self)
end

---初始化自己的公会信息
---@param msg guild.i_guild 公会数据
function SociatyModel:ParseSociatySelf(msg)
    if nil ~= msg then
        local SociatyData = require("SociatyData")
        self.SociatySelf = SociatyData.New()
        self.SociatySelf:Parse(msg)
        self:InitSociatyOtherModel()
        self.super.ParseData(self)
        require("SociatyManager"):GetInstance():OnP2CEnterGuildNew()
    else
        self.super.ParseData(self)

        if _G.AppSetting.DEBUG then
            _G.Log("现在还没有公会")
        end
    end
end

---初始化公会其他数据
function SociatyModel:InitSociatyOtherModel()
    if self.SociatyRoleSelf.uid <= 0 then
        return
    end
    self:InitRequest()
    self:InitYHModel()
    self:InitDonateModel()
    self:InitBountyModel()
    self:InitGuildStatue()
    self:InitProfound()
    self:InitSociatyBattleModel()
    self:InitSociatyMobaModel()
    self:InitSociatyBattleLeagueModel()
    self:InitSociatyMazeModel()
    self:InitSociatyShopModel()
end

---初始化公会请求
function SociatyModel:InitRequest()
    if
        self.SociatyRoleSelf.position == require "MemberEnum".ELocationEnum.Chairman or
        self.SociatyRoleSelf.position == require "MemberEnum".ELocationEnum.CoChairman
    then
        require("SociatyNet"):GetInstance():GetRequests(
            function(data)
                if data.ack ~= 1 then
                    return
                end
                self.SociatySelf.GetMemberModule().Requests = data.requests or {}
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
            end
        )
    end
end

---初始化YH数据
function SociatyModel:InitYHModel(callback)
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ScoaityYH) then
        require "SociatyNet":GetInstance():GetFeastInfo(
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self.feastData = msg.feast_info
                _G.Events:GetInstance():Broadcast(_G.FunctionOpenDailyCheckEvent.GuildTrain)
                --登录报错, 容错处理
                if not self.feastData.last_rank then
                    self.feastData.last_rank = 0
                end
                self.SociatyYHNum = _G.ConfigManager.discrete_cfg[102801][1][1]
                local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP
                    .GongHui_Boss })
                if not _G.table.isEmptyOrNil(data) then
                    self.SociatyYHNum = self.SociatyYHNum + data[1]
                end
                self.SociatyYHNum = self.SociatyYHNum - msg.feast_info.challenge_times
                self:CreateUnopenedBox()
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.GuildchallengeButton.id
                )
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.SociatyTrialRankAward.id
                )
                self:SetYHBattleCdTimer()
                if self:CheckBattleTime(false) then
                    if callback then
                        callback(msg, true)
                    end
                else
                    if _G.AppSetting.DEBUG then
                        _G.Log("公会试炼结算中")
                    end
                    if callback then
                        callback(msg, false)
                    end
                end
            end
        )
    end
end

