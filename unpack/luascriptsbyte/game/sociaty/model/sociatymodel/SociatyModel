---@param callback fun(msg:any):void
function SociatyModel:OnDonateCallback(msg, index, callback)
    if msg.ack ~= 1 then
        if callback then
            callback(nil)
        end
        return
    end
    local cfg = _G.ConfigManager.guild_donate_cfg[index]
    --获取奖励/消费物品
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.StorageManager:GetInstance():ConsumeItem(cfg.consume[1], nil, cfg.consume[2])

    ---获得建筑币
