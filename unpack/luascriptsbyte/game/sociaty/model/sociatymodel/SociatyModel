---拿公会数据
function SociatyModel:GetSociatyInfo()
    if require("SociatyManager"):GetInstance():CheckFunctionIsUnlock(FunctionID.Sociaty) then
        SociatyNet:GetInstance():GetGuild(_G.handler(self, self.ParseData))
    else
        self:ParseData()

        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>不满足公会开放等级，拿到不公会数据</color>")
        end
    end
