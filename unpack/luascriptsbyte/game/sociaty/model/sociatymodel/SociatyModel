---处理建筑币奖励
function SociatyModel:ReceiveBuildCoin(msg)
    if msg.award then
        local buildCoinId = self:GetBuildCoinCfg()
        for _, d in ipairs(msg.award.item) do
            local id, change, total = table.unpack(d.type)
            if id == buildCoinId then
                self:SetBuildCoin(total, change)
                break
            end
        end
    end
end

--- 自动使用建筑币建设公会大厅
function SociatyModel:AutoUseBuildCoin()
    -- 根据大厅最高等级所需经验，计算能够使用的建筑币
    local _, _, maxNeedExp = self:GetBuildExp(1)
    local coinId, coinExp = self:GetBuildCoinCfg()
    local maxNum, ownNum, curNum
    if coinId > 0 and coinExp > 0 then
        maxNum = math.ceil(maxNeedExp / coinExp)
        ownNum = _G.StorageManager:GetInstance():GetOtherItemCountBySid(coinId)
    else
        maxNum = 999999
        ownNum = 0
    end
    curNum = ownNum
    if curNum > ownNum then
        curNum = ownNum
    elseif curNum < 0 then
        curNum = 0
    end
    if curNum > maxNum then
        curNum = maxNum
    end

    if curNum <= 0 then
        return
    end
    local lastLevel = self:GetBuildLevel(1)
    self:BuildUp(
        1,
        curNum,
        function()
            self:SetDefaultBuildState()

            --显示tip
            local buildName = _G.GetLangPackValue(_G.ConfigManager.guild_unit_cfg[1].name)
            _G.PopWindowManager:GetInstance():ShowAllTips(250145, nil, nil, nil, nil, nil, buildName)

            --更新建筑页面
            ---@type SociatyBuildView
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBuildView.Name)
            if view then
                view:UpdateView()
                local curLevel = self:GetBuildLevel(1)
                if curLevel > lastLevel then
                    view:ShowUpgradeFlashEffect()
                end
                view:ShowUpgradeUseEffect()
            end
        end
    )
end

