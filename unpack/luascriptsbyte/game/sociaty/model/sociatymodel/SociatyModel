---设置建筑币数量更改
---@private
---@param total number      当前货币总数
---@param change number     change数量
function SociatyModel:SetBuildCoin(total, change)
    if not self.SociatyRoleSelf then
        return
    end
    if change == nil then
        change = total - (self.SociatyRoleSelf.build_coin or 0)
    end
    self.SociatyRoleSelf.build_coin = total

    local coinId = self:GetBuildCoinCfg()
    --推送货币状态
    local tmp = {}
    _G.table.insert(tmp, coinId)
    _G.table.insert(tmp, change)
    _G.table.insert(tmp, total)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, { { type = tmp } })
end

---获取建筑特权加成
---@private
---@param buildId number 建筑ID
---@param privilegeId number 特权ID
---@return number
function SociatyModel:GetBuildPrivilege(buildId, privilegeId)
    if not self.SociatySelf then
