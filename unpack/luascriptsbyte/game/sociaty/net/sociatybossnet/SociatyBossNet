---@class SociatyBossNet : BaseGameNet	通信协议
local SociatyBossNet = _G.BaseClass("SociatyBossNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return SociatyBossNet SociatyBossNet
function SociatyBossNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function SociatyBossNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.guild_boss_dps.Cmd, self.P2CMaxDps)
end

---获取boss信息
---@param pbData table PB数据
---@param callback function 完成回调
function SociatyBossNet:GetBossInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_feast_boss_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---挑战Boss
function SociatyBossNet:ChallengeBossFight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_guild_port_boss_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---扫荡
function SociatyBossNet:SweepBossFight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_guild_port_boss_sweep
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取公会战斗日志
function SociatyBossNet:GetLog(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guild_feast_log
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---回放战斗
function SociatyBossNet:Review(pbData, callback)
    local item = _G.ConfigManager.net_map.game_guild_feast_review
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---推送dps的刷新
function SociatyBossNet:P2CMaxDps(msg)
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefreshDps, msg)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SociatyBossNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type SociatyBossNet
return SociatyBossNet
