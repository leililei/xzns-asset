---拒绝申请(公会权限成员接收)
---@param msg guild.p2c_guild_refuse_request
function SociatyNet:P2CGuildRefuseRequest(msg)
    local SociatyModel = require("SociatyModel")
    local md = SociatyModel:GetInstance().SociatySelf.SociatyMemberModule
    md:OnDealRequest({msg.uid})
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefuseRequest, {msg.uid})
end

---拒绝申请（申请人）
---@param msg guild.p2c_guild_role_request_refuse
function SociatyNet:P2CGuildRoleRefuseRequest(msg)
    ---清除申请列表记录中的公会数据
    local SociatyModel = require("SociatyModel")
    for k, v in pairs(SociatyModel:GetInstance().SociatyRoleSelf.requests) do
        if v.uid == msg.guild_uid then
            table.remove(SociatyModel:GetInstance().SociatyRoleSelf.requests, k)
        end
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RoleRefuseRequest, msg)
end

---设置条件推送
