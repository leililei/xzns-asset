---加入军团给所有已入会的人的推送
---@param msg guild.p2c_enter_guild_old
function SociatyNet:P2CEnterGuildOld(msg)
    local SociatyModel = require("SociatyModel")
    if SociatyModel:GetInstance().SociatySelf then
        local md = SociatyModel:GetInstance().SociatySelf.SociatyMemberModule
        md:OnEnterNewMember(msg)
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.Enter, msg)
end

---加入军团给新入会的人的推送
---@param msg guild.p2c_enter_guild_new
function SociatyNet:P2CEnterGuildNew(msg)
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {_G.ActiveTaskEnum.ConditionEnum.Guild.joinOrCreate},
        1
    )
    --TODO 加入公会相关逻辑
    ---@param msgguild guild.s2c_get_guild
    self:GetGuild(
        function(msgguild)
            require("BountyGroupModel"):GetInstance():GetDataFormServer()
            local SociatyModel = require("SociatyModel")
            SociatyModel:GetInstance():ParseData(msgguild)
            if msgguild.guild.is_check == 0 then
                local content =
                    _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[250146].content, msgguild.guild.name)
                _G.PopWindowManager:GetInstance():ShowAllTips(250146, content)
            end
            _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.JoinGroup)
        end
    )
end

---公会公告修改推送给公会成员
---@param msg guild.p2c_guild_notice
function SociatyNet:P2CGuildNotice(msg)
    local SociatyModel = require("SociatyModel")
    if msg.type == 1 then
        SociatyModel:GetInstance().SociatySelf.JoinDeclaration = msg.notice
    else
        SociatyModel:GetInstance().SociatySelf.Declaration = msg.notice
    end

    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeNotice, msg)
end

