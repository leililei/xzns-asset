---@class SociatyRankView : UIBaseView 描述
---@field public go_table SociatyManagerView._obj_Apply_GoTable GoTable
---@field public Requests guild.i_request_guild[] 申请数据
---@field public InfoPanelCtrls SociatyRankView._obj_InfoPanel_GoTable
---@field public SociatyItemList SociatyRankView._obj_SociatyItem_GoTable[] 滚动组件元素
local SociatyRankView = _G.BaseClass("SociatyRankView", _G.Component)
local SociatyData = require("SociatyData")
local UIUtils = _G.UIUtils
---@type SociatyRankView_GoTable
local Ctrl

---@type SociatyMemberModule
local MD

local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}

local Gradient = {
    [1] = { "FFCB28", "ffffff", "110802" },
    [2] = { "E930FF", "ffffff", "110802" },
    [3] = { "1F7296", "ffffff", "110802" },
}

function SociatyRankView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    Ctrl = self.go_table
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ChooseIndex = 1
end

---界面的入口函数
---@param data guild.s2c_guild_get_requests 返回PB数据
function SociatyRankView:OnCreate(view)
    self.SociatyInfoPanel = view.SociatyInfoPanel
    -- require("SociatyNet"):GetInstance():GetGuildRankList(
    --     function(data)
    --         self:Show(data)
    --         self:OnItemClickBtn(nil, nil)
    --     end
    -- )
end

function SociatyRankView:Show(data)
    MD = SociatyData.GetMemberModule()
    self.SociatyItemList = {}
    self.Ranks = data.guilds or {}
    local len = #self.Ranks
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_NoNum, len <= 0)
    self.go_table.scrollloopvectical_memberList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_rank" .. i])
        if self.Ranks[i] then
            local data = self.Ranks[i]
            item.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
            item.aortext_name.text = data.name
            item.aortext_active.text = data.seven_day_live or 0
            item.obj_have:SetActiveE(1)
            item.aortext_nil:SetActiveE(0)
        else
            item.obj_have:SetActiveE(0)
            item.aortext_nil:SetActiveE(1)
        end
    end
    self:SetSelfInfo()
end

function SociatyRankView:SetSelfInfo()
    local data = require("SociatyModel"):GetInstance().SociatySelf
    if data then
        local selfRankNum = 100000
        for k, v in ipairs(self.Ranks) do
            if v.uid == data.Uid then
                selfRankNum = k
                break
            end
        end

        self.go_table.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
        self.go_table.aortext_name.text = data.Name
        self.go_table.aortext_active.text = data.SevenDayLive or 0
        self.go_table.aorimage_rankBg:SetActiveE(selfRankNum <= 3 and 1 or 0)
        self.go_table.aortext_Rank:SetActiveE(selfRankNum <= 3 and 1 or 0)
        self.go_table.obj_rankBg2:SetActiveE(selfRankNum <= 3 and 0 or 1)
        self:SetItemRankInfo(self.go_table, selfRankNum)
    end
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function SociatyRankView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type SociatyRankView._obj_SociatyItem_GoTable
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.SociatyItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.Ranks[eIndex]
    if data then
        ctrl.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        ctrl.aortext_name.text = data.name
        ctrl.aortext_president.text = data.roles[1].role.name
        ctrl.aortext_level.text = _G.LangUtil.GetLangPackValue(9002010022, data.level)
        ctrl.aortext_active.text = data.seven_day_live or 0
        ctrl.aortext_num.text = data.num .. "/" .. _G.ConfigManager.guild_level_cfg[data.level].num_player
        ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_Rank:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.obj_rankBg2:SetActiveE(eIndex <= 3 and 0 or 1)
        local LevelCfg = _G.ConfigManager.guild_level_cfg[data.level]
        if data.num >= LevelCfg.num_player then
            ctrl.aortext_member.text = _G.LangUtil.GetLangPackValue(90022501044) .. "：" .. "<color=#076815>" ..
                LevelCfg.num_player .. "</color>/" ..
                LevelCfg.num_player
        else
            ctrl.aortext_member.text = _G.LangUtil.GetLangPackValue(90022501044) .. "：" .. "<color=#076815>" ..
                data.num .. "</color>/" ..
                LevelCfg.num_player
        end
        local power = data.guild_power or 0
        ctrl.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
        self:SetItemRankInfo(ctrl, eIndex)
        if self.ChooseIndex == eIndex then
            --屏蔽公会点击选中
            --_G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, true)
            self.ChooseSociatyGoTable = ctrl
        else
            _G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, false)
        end
        ctrl.uid = data.uid
        ctrl.aorbtn_click:SetActiveE(1)
    end
    return item
end

function SociatyRankView:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]

        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    elseif eIndex == 100000 then
        ctrl.aortext_rankNum.text = _G.ConfigManager.language_package_cfg[90022900040]
    else
        ctrl.aortext_rankNum.text = eIndex
    end
end

---公会点击选中
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function SociatyRankView:OnItemClickBtn(_, _, tb)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyInfoPreviewView.Name, tb.uid)
end

function SociatyRankView:OnDestroy()
end

---析构函数
function SociatyRankView:Dispose()
    Ctrl = nil
    MD = nil
end

---@return SociatyRankView
return SociatyRankView
