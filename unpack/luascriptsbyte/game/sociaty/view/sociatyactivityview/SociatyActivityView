                    ---未拉到数据
                    tb.aortext_LastTxt.text = _G.GetLangPackValue(90011611104)
                    openFunction = false
                end
            end
            if not openFunction then
                tb.aortext_last.text = ""
                tb.aortext_time.text = ""
