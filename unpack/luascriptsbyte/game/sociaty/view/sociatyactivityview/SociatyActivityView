function SociatyActivityView:UpdateLeagueTxt(tb, data)
    local desc
    local time = 0
    local times = -1
    local stageState = require "SociatyBattleLeagueModel":GetInstance():GetStageState()
    local state = require "SociatyBattleLeagueModel":GetInstance():GetState()
    local IsJoin = require "SociatyBattleLeagueModel":GetInstance().IsJoin
    local IsLeagueOpen = require "SociatyBattleLeagueModel":GetInstance().IsLeagueOpen

    self.LeagueStageState = stageState
    self.LeagueState = state
    self.ShowTime = false
    self.LeagueTime = 0

    local lock = false
    if stageState == _G.SociatyBattleLeagueStageState.None or nil == IsLeagueOpen or IsLeagueOpen == -1 then
        desc = _G.GetLangPackValue(90032100035)
        lock = true
    elseif IsLeagueOpen == 0 then
        desc = _G.GetLangPackValue(90032100042)
        lock = true
    else
        -- if stageState == _G.SociatyBattleLeagueStageState.None then
        --     desc = _G.GetLangPackValue(90032100035)
        --     lock = true
        -- else
        if stageState == _G.SociatyBattleLeagueStageState.Select then
            desc = _G.GetLangPackValue(90032100025)
            time = require "SociatyBattleLeagueModel":GetInstance():GetEndTime()
        elseif stageState == _G.SociatyBattleLeagueStageState.Preparing then
            desc = _G.GetLangPackValue(90032100026)
            time = require "SociatyBattleLeagueModel":GetInstance():GetEndTime()
        elseif stageState == _G.SociatyBattleLeagueStageState.End then
            desc = _G.GetLangPackValue(90032100035)
            lock = true
        else
            if state == _G.SociatyBattleLeagueState.Match then
                desc = _G.GetLangPackValue(90021800473)
            elseif state == _G.SociatyBattleLeagueState.Guess then
                if IsJoin then
                    desc = _G.GetLangPackValue(90021800473)
                else
                    desc = _G.GetLangPackValue(90032100028)
                end
            elseif state == _G.SociatyBattleLeagueState.Battle then
                if IsJoin then
                    desc = GetLangPackValue(data.number)
                    times = SociatyModel:GetTargetActivityTimes(data.id)
                else
                    desc = _G.GetLangPackValue(90032100029)
                end
            elseif state == _G.SociatyBattleLeagueState.Settlement then
                desc = _G.GetLangPackValue(90032100030)
            else
                desc = _G.GetLangPackValue(90100000005)
            end
        end
    end

    local curSession = require "SociatyBattleLeagueManager":GetInstance():GetCurSession()

    if lock and curSession < 1 then
        tb.aorrawimage_bg:SetGray(true)
        tb.aorrawimage_icon:SetGray(true)
        --tb.aorimage_namebg:SetGray(true)
        tb.obj_Award:SetActiveE(0)
    else
        tb.aorrawimage_bg:SetGray(false)
        tb.aorrawimage_icon:SetGray(false)
        --tb.aorimage_namebg:SetGray(false)
        tb.obj_Award:SetActiveE(1)
    end

    tb.aortext_LastTxt:SetActiveE(1)
    tb.aortext_LastTxt.text = desc
    --tb.aorimage_lastBg:SetActiveE(0)
    tb.aortext_time.text = ""
    tb.aortext_last.text = ""
    if time > 0 then
        --tb.aorimage_lastBg:SetActiveE(1)
        local stime = time - _G.TimeUtil.GetServerUnixTime()
        if stime <= 0 then
            stime = 0
        end
        self.ShowTime = true
        self.LeagueTime = time

        tb.aortext_time.text = _G.TimeUtil.TransLateSMCH(stime)
    elseif times >= 0 then
        tb.aortext_time.text = times
        --tb.aorimage_lastBg:SetActiveE(1)
    end
end

---转换时间
function SociatyActivityView:FormateTime(residue)
    local timeStr
    local t = _G.TimeUtil.TranslateSecond(residue)
    if t.day > 0 then
        timeStr = GetLangPackValue(90028010131, t.day)
    elseif t.hour > 0 then
        timeStr = _G.GetLangPackValue(90000011264, t.hour)
    else
        timeStr = _G.GetLangPackValue(90031700237, t.min, t.sec)
    end
    return timeStr
end

function SociatyActivityView:RefreshFuncTimer()
    if _G.table.isEmptyOrNil(self.lockItemList) then
        return
    end
    if not self.funcTimer then
        self.funcTimer =
            _G.TimerManager:GetInstance():GetTimer(
                1,
                function()
                    if self:IsNil() then
                        if self.funcTimer then
                            self.funcTimer:Stop()
                            self.funcTimer = nil
                        end
                        return
                    end
                    for index, v in pairs(self.lockItemList) do
                        local leftTime = v.sbot - _G.TimeUtil.GetServerUnixTime()
                        if v.id == _G.ScoaityActivityType.SociatyBattle then
                            leftTime = leftTime - 86400
                        end
                        if leftTime < 0 then
                            if self.lockItemList[index].id == _G.ScoaityActivityType.SociatyMobaBattle then
                                local startTime = require("SociatyMobaModel"):GetInstance().seasonStartTime
                                if not startTime or startTime == 0 then--跨天的时候这一秒还没拉取到赛季时间，不刷新界面
                                    return
                                end
                            end
                            self.lockItemList[index] = nil
                            self:RefreshList(index, v.obj)
                        else
                            v.tb.aortext_condition.text = self:FormateTime(leftTime)
                        end
                    end
                    if _G.table.isEmptyOrNil(self.lockItemList) then
                        self.funcTimer:Stop()
                        self.funcTimer = nil
                    end
                end,
                self,
                false,
                false
            )
        self.funcTimer:Start()
    end
end

---获取标题
function SociatyActivityView:GetMobaLastText()
    local model = require("SociatyMobaModel"):GetInstance()
    local battleState = model:GetMobaBattleStage()
    if battleState == model.SociatyMobaBattleState.Match then
        ---匹配中
        return _G.GetLangPackValue(90021800255)
    elseif
        battleState == model.SociatyMobaBattleState.Embattle or
        battleState == model.SociatyMobaBattleState.EmbattleAllDay
    then
        ---战斗准备中
        return _G.GetLangPackValue(90031700067)
    elseif battleState == model.SociatyMobaBattleState.Adjustline or battleState == model.SociatyMobaBattleState.Prepare then
        ---战斗即将开始
        return _G.GetLangPackValue(90031700068)
    elseif battleState == model.SociatyMobaBattleState.Fighting then
        ---战斗中
        return _G.GetLangPackValue(90031700069)
    elseif battleState == model.SociatyMobaBattleState.Settlement then
        ---结算中
        return _G.GetLangPackValue(90000010091)
    elseif battleState == model.SociatyMobaBattleState.Grading then
        ---定段中
        return _G.GetLangPackValue(90031700070)
    elseif battleState == model.SociatyMobaBattleState.SeasonSettlement then
        ---赛季结算中
        return _G.GetLangPackValue(90011611104)
    end

    return ""
end

function SociatyActivityView:SetMobaTimeTxt(tb)
    local model = require("SociatyMobaModel"):GetInstance()
    local battleState, nextStateTime = model:GetMobaBattleStage()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.nextTime = 0
    self.mobaBattleTb = tb
    if battleState == model.SociatyMobaBattleState.Match then
        ---匹配中显示距离布阵阶段的倒计时
        self.nextTime = nextStateTime
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    elseif battleState == model.SociatyMobaBattleState.Embattle then
        ---显示距离锁定阵容阶段倒计时,如果是星期天则显示下一次定段开始的时间
        if _G.TimeUtil.GetWeekDay() == 7 then
            self.nextTime = model:GetGradingStartTime()
            tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
        else
            self.nextTime = nextStateTime
            tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
        end
    elseif battleState == model.SociatyMobaBattleState.EmbattleAllDay then
        ---显示距离定段阶段倒计时
        self.nextTime = model:GetGradingStartTime()
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    elseif battleState == model.SociatyMobaBattleState.Adjustline or battleState == model.SociatyMobaBattleState.Prepare then
        ---距离战斗开始的倒计时
        self.nextTime = model:GetBattleStartTime()
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    elseif battleState == model.SociatyMobaBattleState.Fighting then
        ---打野行动次数
        self.nextTime = nextStateTime
        -- tb.aortext_time.text = _G.GetLangPackValue(90021800211) .. model:GetWildTimes()
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    elseif battleState == model.SociatyMobaBattleState.Settlement then
        ---显示结算结束倒计时
        self.nextTime = model:GetSettlementEndTime()
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    elseif battleState == model.SociatyMobaBattleState.Grading then
        ---定段结束倒计时
        self.nextTime = model:GetGradingEndTime()
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    elseif battleState == model.SociatyMobaBattleState.SeasonSettlement then
        ---赛季结算倒计时
        self.nextTime = nextStateTime
        tb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    end

    if self.nextTime >= servertime then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimerCall, self, false, false)
        self.timer:Start()
    end
end

function SociatyActivityView:OnTimerCall()
    local servertime = _G.TimeUtil.GetServerUnixTime()
    if self.nextTime > servertime then
        self.mobaBattleTb.aortext_time.text = _G.TimeUtil.TranslateSecondForStrDHMS(self.nextTime - servertime)
    else
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.go_table.scrollloopvectical_activity:UpdateAllItem()
    end
end

function SociatyActivityView:OnSociatyBattleTimerCall(elapsed)
    self.sociatyBattleCountDown = self.sociatyBattleCountDown - elapsed
    if self.sociatyBattleCountDown < 0 then
        self.sociatyBattleCountDown = 0
        self.sociattBattleTb.aortext_time.text = ""
    else
        self.sociattBattleTb.aortext_time.text = self:FormateTime(_G.Mathf.RoundToInt(self.sociatyBattleCountDown))
    end
end

---其他功能界面关闭后刷新活动入口界面列表
function SociatyActivityView:OnUIClosed(name)
    if name ~= _G.ConfigManager.ui_cfg.SociatyBattleMainView.Name and
            name ~= _G.ConfigManager.ui_cfg.SociatyMazeMainView.Name and
            name ~= _G.ConfigManager.ui_cfg.SociatyMobaBattleView.Name and
            name ~= _G.ConfigManager.ui_cfg.SociatyBattleLeagueMainView.Name then
        return
    end
    for k, v in pairs(self.refreshItemList) do
        self:RefreshList(k, v.obj)
    end
end

---界面的销毁函数
function SociatyActivityView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.funcTimer then
        self.funcTimer:Stop()
        self.funcTimer = nil
    end
    if self.LeagueTimer then
        self.LeagueTimer:Stop()
        self.LeagueTimer = nil
    end
    if self.sociatyBattleTimer then
        self.sociatyBattleTimer:Stop()
        self.sociatyBattleTimer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function SociatyActivityView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

function SociatyActivityView:OnclickPage(_, _, type, lock)
    if type == _G.ScoaityActivityType.SociatyBattle then
        --_G.Log("争霸天下", "<color=red>" .. ">>>" .. "</color>")
        if lock then
            return
        end

        require "RequestSubscribeModel":GetInstance():DoRS(2)
        require "SociatyBattleManager":GetInstance():Enter(self.sceneRoot)
    elseif type == _G.ScoaityActivityType.SociatyMobaBattle then
        if lock then
            return
        end
        require("SociatyMobaModel"):GetInstance():EnterView()
    elseif type == _G.ScoaityActivityType.SociatyMaze then
        if lock then
            return
        end
        local startTime = require("SociatyMazeModel"):GetInstance():GetTime()
        if not startTime or startTime <= 0 then
            ---未拉到数据
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyMazeMainView.Name)
    elseif type == _G.ScoaityActivityType.SociatyBattleLeague then
        if lock then
            return
        end

        local stageState = require "SociatyBattleLeagueModel":GetInstance():GetStageState()
        local curSession = require "SociatyBattleLeagueManager":GetInstance():GetCurSession()

        if stageState == _G.SociatyBattleLeagueStageState.None or stageState == _G.SociatyBattleLeagueStageState.End then
            if curSession <= 0 then
                return
            end
        end
        require("SociatyBattleLeagueManager"):GetInstance():Enter()
    end
end

return SociatyActivityView
