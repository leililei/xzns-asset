        end
        self.sociattBattleTb = tb
        if not self.sociatyBattleTimer then
            self.sociatyBattleTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnSociatyBattleTimerCall, self)
            self.sociatyBattleTimer:Start()
        end
