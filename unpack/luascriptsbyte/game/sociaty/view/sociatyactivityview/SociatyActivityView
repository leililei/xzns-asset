local SociatyActivityItem = require("SociatyActivityItem")

---@class SociatyActivityView : UIBaseView	中文描述
---@field public go_table SociatyActivityView_GoTable GoTable
local SociatyActivityView = _G.BaseClass("SociatyActivityView", _G.UIBaseView)
local guild_entrance_cfg = _G.ConfigManager.guild_entrance_cfg
local SociatyModel
local GetLangPackValue = _G.GetLangPackValue
local StorageManager
local color = {
    [39] = { "fff2b7", "76694c" },
    [147] = { "ffddd8", "6e463d" },
    [252] = { "fff2b7", "76694c" } --颜色照着39填的，解决报错
}
function SociatyActivityView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyActivityView:OnCreate(sceneRoot)
    SociatyModel = require "SociatyModel":GetInstance()
    StorageManager = _G.StorageManager:GetInstance()
    ---@type guild_entrance_cfg[]
    self.activityCfg = {}
    if sceneRoot then
        self.sceneRoot = sceneRoot
    end

    --- ZHJH-9801 、跨服奥山活动期间，排序默认置顶，活动结束后再按配置的顺序进行显示
    local SociatyBattleOrder = 5
    local lock = require("SociatyBattleLeagueModel"):GetInstance():GetIsLock()
    local curSession = require "SociatyBattleLeagueManager":GetInstance():GetCurSession()
    if not lock then
        SociatyBattleOrder = 0
    end


    local sortIndexList = {}
    for _, v in pairs(guild_entrance_cfg) do
        _G.table.insert(self.activityCfg, v)
        sortIndexList[v.id] = v.order
        if v.id == _G.ScoaityActivityType.SociatyBattleLeague then
            sortIndexList[v.id] = SociatyBattleOrder
        end
    end
    table.sort(
        self.activityCfg,
        function(a, b)
            local aOrder = sortIndexList[a.id]
            local bOrder = sortIndexList[b.id]
            return aOrder < bOrder
        end
    )

    self.lockItemList = {}
    self.refreshItemList = {}
    --self.go_table.scrollloopvectical_activity:SetRectTransformSize(800, 720)
    self.go_table.scrollloopvectical_activity:InitItemData(#self.activityCfg, _G.handler(self, self.RefreshList))
    local resources = _G.ConfigManager.ui_cfg.SociatyActivityView.resources
    if #resources > 0 then
        local goldInfo =
            self:AddComponent(
                self.go_table.obj_GoldInfo,
                require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
            )
        goldInfo.RsCompont:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup)).constraint =
            _G.CS.UnityEngine.UI.GridLayoutGroup.Constraint.FixedRowCount
    end
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeSettle, self.OnSociatyMazeSettle, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeInfo, self.OnSociatyMazeInfo, self)
    self:AddListener(_G.eSociatyBattleLeague.SociatyBattleStateLeague, self.OnSociatyLeagueInfo, self)
    self:AddListener(_G.eSociatyBattleLeague.SociatyBattleBattleLeague, self.OnSociatyLeagueInfo, self)
    self:AddListener(_G.eSociatyMaze.SociatyMazeRestoreChange, self.OnSociatyMazeInfo, self)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
end

function SociatyActivityView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
    end
end

---已结算-本期时间已结束
function SociatyActivityView:OnSociatyMazeSettle()
    self:Close()
end

---刷新界面
function SociatyActivityView:OnSociatyMazeInfo()
    self.go_table.scrollloopvectical_activity:UpdateAllItem()
end

---刷新界面
function SociatyActivityView:OnSociatyLeagueInfo()
    self.go_table.scrollloopvectical_activity:UpdateAllItem()
end

function SociatyActivityView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local newIndex = index + 1
    local data = self.activityCfg[newIndex]
    local lock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(data.function_id)
    local lockOpenTime = false
    local sbot = 0
    local endTime = 0
    local residue = 0
    local settlementTime = 0
    local seasonTime = 0
    if data.function_id == 147 then
        sbot = require("SociatyBattleManager"):GetInstance():GetSociatyBattleOpenTime()
        residue = sbot - _G.TimeUtil.GetServerUnixTime()
        residue = _G.math.ceil(residue / 86400) - 1
        endTime = require("SociatyBattleModel"):GetInstance():GetEndTime() - _G.TimeUtil.GetServerUnixTime()
        settlementTime =
            require("SociatyBattleModel"):GetInstance():GetNextSettlementTime() - _G.TimeUtil.GetServerUnixTime()
        seasonTime = require("SociatyBattleModel"):GetInstance():GetSeasonEndTime() - _G.TimeUtil.GetServerUnixTime()
        if residue <= 0 then
            lock = false
        end
    elseif data.function_id == 252 then
        sbot = require("SociatyMobaModel"):GetInstance():GetSociatyMobaOpenTime()
        residue = sbot - _G.TimeUtil.GetServerUnixTime()
        residue = _G.math.ceil(residue / 86400)
        if residue <= 0 then
            lock = false
        end
    elseif data.function_id == 278 then
        lock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(data.function_id)
    end
    if residue > 0 then
        lock = true
        lockOpenTime = true
    end
    local lockStr, _ = _G.FunctionManager:GetInstance():GetTipsStr(data.function_id)
    if not lock and data.function_id == 278 then
        local level = _G.ConfigManager.discrete_cfg[116111][1][1]
        local isLock, _, content =
            _G.GlobalConditionManager.CheckConditionArrays({ { _G.GlobalConditionManager.ConditionType.guildLv, level } })
        if not isLock then
            lock = true
            lockStr = content
        end
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnclickPage, data.id, lock))
    ---@type SociatyActivityItem
    local item = SociatyActivityItem.New(obj)
    item:RefreshItem(data, self.OnclickPage, lock, self)
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(data.redpoint_cfg)
    if not _G.string.IsNullOrEmpty(data.tab) then
        tb.aorrawimage_bg:LoadImage(
            data.tab,
            function(tran)
                if _G.IsNil(tran) then
                    return
                end
                tran:SetNativeSize()
            end
        )
    end
    if not _G.string.IsNullOrEmpty(data.image_sub) then
        tb.aorrawimage_icon:LoadImage(
            data.image_sub,
            function(tran)
                if _G.IsNil(tran) then
                    return
                end
                tran:SetNativeSize()
            end
        )
    end
    --tb.aorimage_namebg.SpriteName = data.base
    tb.obj_Lock:SetActiveE(lock and 1 or 0)
    tb.obj_Open:SetActiveE(lock and 0 or 1)
    tb.aortext_Name.text = GetLangPackValue(data.name)
    --tb.aortext_Name.color = require("CardInfoManager").GetColorFromRGB(color[data.function_id][1])
    tb.aortext_test:SetActiveE(0)
    tb.aortext_SeasonTime:SetActiveE(0)
    tb.aortext_Show:SetActiveE(0)
    if data.id == _G.ScoaityActivityType.SociatyMobaBattle then
        tb.aortext_LastTxt.text = self:GetMobaLastText()
        self:SetMobaTimeTxt(tb)
        tb.aortext_last.text = ""
        local model = require("SociatyMobaModel"):GetInstance()
        if not lock and model.SociatyMobaBattleState.EmbattleAllDay ~= model:GetMobaBattleStage() then
            tb.aortext_SeasonTime:SetActiveE(1)
            local time = model:GetSeasoDurationTime()
            tb.aortext_SeasonTime.text = time
            tb.aortext_SeasonTime:SetActiveE(time == _G.GetLangPackValue(90032200055) and 0 or 1)
        end
    elseif data.id == _G.ScoaityActivityType.SociatyBattle then
