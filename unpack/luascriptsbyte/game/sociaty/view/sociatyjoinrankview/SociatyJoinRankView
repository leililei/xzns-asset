---申请加入回调
---@param msg guild.s2c_guild_request
function SociatyJoinRankView:RequestBack(msg)
    if msg.ack == 1 then
        ---加到申请列表中
        local severTime = _G.TimeUtil.GetServerUnixTime()
        for _, v in pairs(msg.guild_uid) do
            table.insert(SociatyModel:GetInstance().SociatyRoleSelf.requests, { uid = v, time = severTime })
        end

        self.go_table.scrollloopvectical_memberList:UpdateCount(#self.Ranks)

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyJoinView.Name)
        if view then
            view.go_table.scrollloopvectical_SociatyList:UpdateAllItem()
        end
    end
end

---申请加入公会
function SociatyJoinRankView:RequestJoin(data)
    local sociaty = data
    if nil == sociaty then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>推荐列表数据空</color>")
        end
        return
    end
    -- if sociaty:IsMax() then
    --     ---申请公会人满了
    --     _G.PopWindowManager:GetInstance():ShowAllTips(250101)
    --     return
    -- end
    local cd, time = SociatyModel:GetInstance():IsCding()

    if _G.AppSetting.DEBUG then
        _G.Log("是否CD中")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(cd)
    end

    if _G.AppSetting.DEBUG then
        _G.Log(time, "cd时间")
    end
    if cd then
        ---入会冷却
        _G.PopWindowManager:GetInstance():ShowAllTips(250301, _G.LangUtil.GetLangPackValue(90021800008, time))
        return
    end
    local roleNum = _G.ConfigManager.discrete_cfg[101602][1][1]
    if #SociatyModel:GetInstance().SociatyRoleSelf.requests >= roleNum then
        ---申请上限了
        _G.PopWindowManager:GetInstance():ShowAllTips(250108)
        return
    end
    self.JoinSociatyId = sociaty.Uid
    ---申请加入
    ---@type guild.c2s_guild_request
    local msg = {}
    msg.uid = { sociaty.uid }
    SociatyNet:GetInstance():Request(msg, _G.handler(self, self.RequestBack))
end

