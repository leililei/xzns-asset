function SociatyJoinRankView:Show(data)
    MD = SociatyData.GetMemberModule()
    self.SociatyItemList = {}
    self.Ranks = data.guilds or {}
    local len = #self.Ranks
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_NoNum, len <= 0)
    self.go_table.scrollloopvectical_memberList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
    self.go_table.obj_IsNil:SetActiveE(len > 0 and 0 or 1)
    self.go_table.obj_title:SetActiveE(len > 0 and 1 or 0)
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_rank" .. i])
        if self.Ranks[i] then
            local data = self.Ranks[i]
            item.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
            item.aortext_name.text = data.name
            item.aortext_active.text = data.seven_day_live or 0
            item.obj_have:SetActiveE(1)
            item.aortext_nil:SetActiveE(0)
        else
            item.obj_have:SetActiveE(0)
            item.aortext_nil:SetActiveE(1)
        end
    end
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function SociatyJoinRankView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type SociatyJoinRankView._obj_SociatyItem_GoTable
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.SociatyItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.Ranks[eIndex]
    if data then
        ctrl.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        ctrl.aortext_name.text = data.name
        ctrl.aortext_president.text = data.roles[1].role.name
        ctrl.aortext_level.text = _G.LangUtil.GetLangPackValue(9002010022, data.level)
        ctrl.aortext_active.text = data.seven_day_live or 0
        ctrl.aortext_num.text = data.num .. "/" .. _G.ConfigManager.guild_level_cfg[data.level].num_player
        ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.aortext_Rank:SetActiveE(eIndex <= 3 and 1 or 0)
        ctrl.obj_rankBg2:SetActiveE(eIndex <= 3 and 0 or 1)
        local LevelCfg = _G.ConfigManager.guild_level_cfg[data.level]
        if data.num >= LevelCfg.num_player then
            ctrl.aortext_member.text = _G.LangUtil.GetLangPackValue(90022501044) .. "：" .. "<color=#076815>" ..
                LevelCfg.num_player .. "</color>/" ..
                LevelCfg.num_player
        else
            ctrl.aortext_member.text = _G.LangUtil.GetLangPackValue(90022501044) .. "：" .. "<color=#076815>" ..
                data.num .. "</color>/" ..
                LevelCfg.num_player
        end
        ctrl.aortext_condition.text = self:GetConditionStr(data.afk_chapter or 1)
        local power = data.guild_power or 0
        ctrl.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
        _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_Applyed, false)

        local curChapter = require "AfkModel":GetInstance():GetCurAfkChapter()
        ctrl.aortext_condition:SetActiveE(0)
        local canJoin = true

        if data.afk_chapter > _G.PlayerModel:GetInstance().role_lv or
            data.afk_chapter > curChapter or
            data.is_check == 2
        then
            if data.join_lv > _G.PlayerModel:GetInstance().role_lv or data.afk_chapter > curChapter then
                --ctrl.aorimage_limit:SetGray(true)
                ctrl.aortext_condition:SetActiveE(1)
                canJoin = false
            end
        end
        _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_Join, canJoin)

        if self:IsInRequests(data.uid) then
            ctrl.aorbtn_Join:SetActiveE(0)
            ctrl.aorbtn_Applyed:SetActiveE(1)
        end
        self:SetItemRankInfo(ctrl, eIndex)
        if self.ChooseIndex == eIndex then
            --屏蔽公会点击选中
            --_G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, true)
            self.ChooseSociatyGoTable = ctrl
        else
            _G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, false)
        end
    end
    return item
end

---审核方式字符串
---@param approval number 限制条件
function SociatyJoinRankView:GetConditionStr(limitchapter)
    local str = _G.LangUtil.GetLangPackValue(90022600040) .. limitchapter .. "-1"
    return str
end

---获取请求列表是否有这个对应公会id
---@param uid number 公会id
function SociatyJoinRankView:IsInRequests(uid)
    for i = 1, #SociatyModel:GetInstance().SociatyRoleSelf.requests do
        if SociatyModel:GetInstance().SociatyRoleSelf.requests[i].uid == uid then
            return true
        end
    end
    return false
end

function SociatyJoinRankView:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]

        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    elseif eIndex == 100000 then
        ctrl.aortext_rankNum.text = _G.ConfigManager.language_package_cfg[90022900040]
    else
        ctrl.aortext_rankNum.text = eIndex
    end
end

