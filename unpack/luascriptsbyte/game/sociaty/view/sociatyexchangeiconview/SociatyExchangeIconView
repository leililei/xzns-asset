---@class SociatyExchangeIconView : UIBaseView
---@field go_table SociatyExchangeIconView_GoTable
---@field IconItemList table[] 图标列表
local SociatyExchangeIconView = _G.BaseClass("SociatyExchangeIconView", _G.UIBaseView)

local ItemHelper = require("ItemHelper")

function SociatyExchangeIconView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

-- 启动
function SociatyExchangeIconView:OnCreate(...)
    local args = {...}
    ---@type SociatyData
    self.SociatyData = args[1]
    self.IsLobby = args[2] or false
    self.curProtraitID = args[3] or 1001
    self.useProtraitID = self.curProtraitID
    self.callback = args[4]
    self.IconItemList = {}
    self.Conditions = {}
    self.PortraitInfo = {}
    local gpc = _G.ConfigManager.guild_portrait_cfg
    for _, portraitItem in pairs(gpc) do
        -- local isTrue = true
        -- for i = 1, #portraitItem.conditon, 2 do
        --     local ctype = portraitItem.conditon[i]
        --     local param = portraitItem.conditon[i + 1]
        --     if ctype == 1 then
        --         if self.SociatyLevel < param then
        --             isTrue = false
        --             break
        --         end
        --     end
        -- end
        -- if isTrue then
        --     table.insert(self.PortraitInfo, portraitItem)
        -- end
        table.insert(self.PortraitInfo, portraitItem)
    end

    ---@param portraitItem guild_portrait_cfg_Item
    _G.SortList(
        self.PortraitInfo,
        function(portraitItem)
            return -portraitItem.display_priority
        end
    )
    self.go_table.scrollloopvectical_iconList:InitItemData(#self.PortraitInfo, _G.handler(self, self.RefreshRenItem))
    self.index = 1
    local count = #self.PortraitInfo
    for i = 1, count do
        if self.PortraitInfo[i].ID == self.curProtraitID then
            self.index = i
            break
        end
    end
end

---@param item UnityEngine.Transform 滚动组件item
---@param index number 该数据的索引
function SociatyExchangeIconView:RefreshRenItem(index, item)
    local id = item:GetInstanceIDE()
    local itemGotable = self.IconItemList[id]

    if not itemGotable then
        itemGotable = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, itemGotable))
        self.IconItemList[id] = itemGotable
    end
    itemGotable.index = index + 1
    ---@type guild_portrait_cfg
    local portraitItem = self.PortraitInfo[index + 1]
    itemGotable.aorrawimage_icon:LoadImage(portraitItem.portrait)
    if not self.Conditions[portraitItem.ID] then
        for i = 1, #portraitItem.conditon, 2 do
            local ctype, cid, cparam =
                portraitItem.conditon[i],
                _G.math.modf(portraitItem.conditon[i + 1] / 10000),
                portraitItem.conditon[i + 1] % 10000
            if ctype == 58 then
                --公会建筑达指定等级
                --公会未创建时, 公会大厅默认等级为1级(self.SociatyData为nil)
                if self.SociatyData and self.SociatyData:GetBuildLevel(cid) >= cparam or cid == 1 and cparam == 1 then
                    self.Conditions[portraitItem.ID] = true
                    _G.GameUtil.SetActiveByCondition(itemGotable.obj_lock, false)
                else
                    self.Conditions[portraitItem.ID] = false
                    _G.GameUtil.SetActiveByCondition(itemGotable.obj_lock, true)
                    itemGotable.aortext_lock.text = _G.GetLangPackValue(90022900052, cparam)
                end
            end
        end
    else
        _G.GameUtil.SetActiveByCondition(itemGotable.obj_lock, not self.Conditions[portraitItem.ID])
    end
    _G.GameUtil.SetActiveByCondition(itemGotable.obj_use, portraitItem.ID == self.useProtraitID)
    _G.GameUtil.SetActiveByCondition(itemGotable.obj_choose, portraitItem.ID == self.curProtraitID)
    if portraitItem.ID == self.curProtraitID then
        self.item = itemGotable
    end
end

---公会点击选中
function SociatyExchangeIconView:OnItemClickBtn(go, isOn, tb)
    ---@type guild_portrait_cfg
    local data = self.PortraitInfo[tb.index]
    ---解锁了就可以选
    if self.Conditions[data.ID] then
        self.curProtraitID = data.ID
        if self.item then
            _G.GameUtil.SetActiveByCondition(self.item.obj_choose, false)
        end
        self.item = tb
        _G.GameUtil.SetActiveByCondition(self.item.obj_choose, true)
    else
        if _G.AppSetting.DEBUG then
            _G.Log("图标未解锁")
        end
    end
end

--- 按钮单击事件--
function SociatyExchangeIconView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Close" then
        ---关闭
        self:Close()
    elseif name == "@_aorbtn_Choose" then
        local portraitItem = self.PortraitInfo[self.item.index]
        if not self.callback then

            ---@type guild_portrait_cfg_Item

            if not self.IsLobby then
                _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeIcon, portraitItem.portrait, portraitItem.ID)
                self:Close()
            else
                if self.curProtraitID ~= self.useProtraitID then
                    ---@type guild.c2s_guild_set_banner
                    local msg = {}
                    msg.banner = portraitItem.ID
                    local SociatyNet = require("SociatyNet")
                    SociatyNet:GetInstance():SetBanner(
                        msg,
                        function()
                            require("SociatyModel"):GetInstance().SociatySelf.Banner = self.curProtraitID
                            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeIcon, self.curProtraitID)
                            self:Close()
                        end
                    )
                else
                    self:Close()
                end
            end
        else
            self.callback(portraitItem)
            self:Close()
        end
    end
end

function SociatyExchangeIconView:OnDestroy()
end

function SociatyExchangeIconView:EscClose()
    self:Close()
end

return SociatyExchangeIconView
