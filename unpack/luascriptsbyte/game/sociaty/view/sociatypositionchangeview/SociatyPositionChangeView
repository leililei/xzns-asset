local SociatyData = require("SociatyData")
local MemberEnum = require("MemberEnum")
local ELocationEnum = MemberEnum.ELocationEnum

local base = require "EventViewBase"
---@class SociatyPositionChangeView : UIBaseView	中文描述
---@field public go_table SociatyPositionChangeView_GoTable GoTable
local SociatyPositionChangeView = _G.BaseClass("SociatyPositionChangeView", base)

function SociatyPositionChangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnMemberRefresh)
end

---职位变动推送
---@param data guild.p2c_guild_position
function SociatyPositionChangeView:OnMemberRefresh(data)
    ---@param v role.i_role
    for i, v in ipairs(data.pos) do
        if v.uid == self.memberData.Uid and v.pos ~= 1 then
            self:BtnsState()
            break
        end
    end
end

function SociatyPositionChangeView:OnBeKicked(uid)
    if uid == self.memberData.Uid then
        self:Close()
    end
end

---界面的入口函数
function SociatyPositionChangeView:OnCreate(memberData)
    self.BtnsList = {}
    self.BtnsList[1] = _G.GetAutoGoTable(self.go_table.aorbtn_transfer)
    self.BtnsList[2] = _G.GetAutoGoTable(self.go_table.aorbtn_appoint)
    self.BtnsList[3] = _G.GetAutoGoTable(self.go_table.aorbtn_appoint2)
    self.BtnsList[4] = _G.GetAutoGoTable(self.go_table.aorbtn_kick)
    self.posData = {}
    self.memberData = memberData
    self:Show()
    self:BtnsState()
end

---按钮显示
function SociatyPositionChangeView:Show()
    self.data = SociatyData:GetMemberModule():GetSelfMember()
    self.MD = SociatyData.GetMemberModule()

    self.btnsInfo = {}
    for i = 1, 4 do
        self.btnsInfo[i] = {}
        self.btnsInfo[i].isMax = false
        self.btnsInfo[i].isSelfPosition = false
        if i == 1 then
            self.btnsInfo[i].show = self.data.CfgItem.id  == 1
        elseif i == 4 then
            self.btnsInfo[i].show = self.data.CfgItem.kick_out == true
        else
            self.btnsInfo[i].show = self.data.CfgItem.id <= (i - 1)
        end
        self.BtnsList[i].gameObject:SetActiveE(self.btnsInfo[i].show and 1 or 0)
    end
end

---函数功能注释
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function SociatyPositionChangeView:BtnsState()
    local posDataList = self.MD:GetAllOfficer()
    for _, v in ipairs(posDataList) do
        self.posData[v.Pos] = v
    end
    for index = 2, 3 do
       local isMax = (index < 4) and (self.posData[index].Cur >= self.posData[index].Max)
       self.btnsInfo[index].isMax = isMax
       local isSelfPosition = self.memberData.Location ~= 1 and self.memberData.Location == index
       self.btnsInfo[index].isSelfPosition = isSelfPosition
       self.BtnsList[index].aorimage_isOff:SetGray(isMax and (not isSelfPosition)) 
       self.BtnsList[index].aorimage_isOffBg:SetGray(isMax and (not isSelfPosition))
       _G.GameUtil.SetActiveByCondition(self.BtnsList[index].aorimage_isOffBg, isMax and (not isSelfPosition))
       local name = _G.LangUtil.GetLangPackValue(_G.ConfigManager.guild_position_cfg[index].name)
       local text = isSelfPosition and _G.LangUtil.GetLangPackValue(90021800447, name) or _G.LangUtil.GetLangPackValue(90021800446, name)
       self.BtnsList[index].aortext_title.text = (isMax and (not isSelfPosition)) and string.format("<color=#414141>%s</color>",text) or text
    end
    for i = 2, 4 do
        if i == 1 and self.btnsInfo[i].show then
            self:OnToggle(i)
            break
        elseif (i > 1 and i < 4) and self.btnsInfo[i].show and (self.btnsInfo[i].isSelfPosition == true or (self.btnsInfo[i].isMax == false and self.btnsInfo[i].isSelfPosition == false)) then
            self:OnToggle(i)
            break
        elseif i == 4 then
            self:OnToggle(4)
            break
        end
    end
end

---函数功能注释
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function SociatyPositionChangeView:SendMsg()
    if self.index == 1 then
        self.MD:SwitchChairman(
            self.memberData.Uid,
            function()
                _G.PopWindowManager:GetInstance():ShowAllTips(250153)
                self:Close()
            end
        )
    elseif self.index == 2 then
        if self.btnsInfo[self.index].isSelfPosition == true then
            self.MD:DoAppoint(self.memberData.Uid, ELocationEnum.Member, _G.handlerbind(self, self.Close))
        else
            self.MD:DoAppoint(self.memberData.Uid, ELocationEnum.CoChairman, _G.handlerbind(self, self.Close))
        end
    elseif self.index == 3 then
        if self.btnsInfo[self.index].isSelfPosition == true then
            self.MD:DoAppoint(self.memberData.Uid, ELocationEnum.Member, _G.handlerbind(self, self.Close))
        else
            self.MD:DoAppoint(self.memberData.Uid, ELocationEnum.Elder, _G.handlerbind(self, self.Close))
        end
    elseif self.index == 4 then
        self.MD:KickOut(self.memberData, _G.handlerbind(self, self.Close))
    end
end

function SociatyPositionChangeView:OnToggle(index)
    if (index > ELocationEnum.Chairman and index < ELocationEnum.Member) and (self.btnsInfo[index].isSelfPosition == false) and self.posData[index] and self.posData[index].Cur >= self.posData[index].Max then
        local content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[250142].content,_G.LangUtil.GetLangPackValue(_G.ConfigManager.guild_position_cfg[index].name))
       _G.PopWindowManager:GetInstance():ShowAllTips(250142, content)
       return
    end

    for i = 1, #self.BtnsList do
        local tb = self.BtnsList[i]
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, i == index)
    end
    self.index = index
end

---按钮点击事件在这里派发
function SociatyPositionChangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_transfer then
        self:OnToggle(1)
    elseif go == self.go_table.aorbtn_appoint then
        self:OnToggle(2)
    elseif go == self.go_table.aorbtn_appoint2 then
        self:OnToggle(3)
    elseif go == self.go_table.aorbtn_kick then
        self:OnToggle(4)
    elseif go == self.go_table.aorbtn_sure then
        self:SendMsg()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function SociatyPositionChangeView:Dispose()
    self:RemoveAllListener()
end

return SociatyPositionChangeView