local ColorType = {
    "ui-ghck-icon-hui",
    "ui-ghck-icon-lan",
    "ui-ghck-icon-zi",
    "ui-ghck-icon-cheng",
    "ui-ghck-icon-hong"
}
---@class SociatyStorageTakeView : UIBaseView	中文描述
---@field public go_table SociatyStorageTakeView_GoTable GoTable
---@field data SociatyStorageData 道具数据
---@field curNum number 当前要取出的数量
---@field maxNum number 可以取出最大数量
---@field callback function 回调
local SociatyStorageTakeView = _G.BaseClass("SociatyStorageTakeView", _G.UIBaseView)
--_G.SociatyStorageTakeView = SociatyStorageTakeView

local CS = _G.CS
local typeof = _G.typeof

function SociatyStorageTakeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data SociatyStorageData
---@param point number 玩家的积分点数
---@param callback function 回调
function SociatyStorageTakeView:OnCreate(data, point, callback)
    self.data = data
    self.curNum = 1
    self.maxNum =
        math.min(
        math.floor(point / self.data.cfg.point_fetch),
        self.data.cfg.num_limit - self.data.goodData.get_nums,
        self.data.goodData.num
    )
    self.callback = callback
    self:UpdateCard()
    self:UpadteTakeNum()
end

function SociatyStorageTakeView:UpdateCard()
    local card = require("BaseAwardItem").CreatAwardItem(self.go_table.obj_cardInfo)
    card:UpdateItem({sid = self.data.goodData.id, number = 1}, nil, true)
    card.go_table.aorimage_element = ColorType[card.cfg.Order]
    self.go_table.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(self.data.propCfg.Name)

    if self.data.goodData.get_nums < self.data.cfg.num_limit then
        self.go_table.aortext_ItemNum.text =
            string.format("%d/%d", self.data.goodData.get_nums, self.data.cfg.num_limit)
    else
        self.go_table.aortext_ItemNum.text =
            string.format("<color=#ec2525>%d</color>/%d", self.data.cfg.num_limit, self.data.cfg.num_limit)
    end
end

---更新取出数量
function SociatyStorageTakeView:UpadteTakeNum()
    self.go_table.aortext_Number.text = self.curNum
    self.go_table.aortext_cost.text = _G.GameUtil.NumberToUnitStr(self.curNum * self.data.cfg.point_fetch)
end

---数量增加
function SociatyStorageTakeView:ModifyNumber(count)
    if self.curNum + count <= self.maxNum then
        self.curNum = math.max(1, self.curNum + count)
    else
        self.curNum = self.maxNum
    end
    self:UpadteTakeNum()
end

---按钮点击事件在这里派发
function SociatyStorageTakeView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Add1" then
        self:ModifyNumber(1)
    elseif name == "@_aorbtn_Add10" then
        self:ModifyNumber(10)
    elseif name == "@_aorbtn_Sub1" then
        self:ModifyNumber(-1)
    elseif name == "@_aorbtn_Sub10" then
        self:ModifyNumber(-10)
    elseif name == "@_aorbtn_Max" then
        self:ModifyNumber(self.maxNum)
    elseif name == "@_aorbtn_Min" then
        self:ModifyNumber(1)
    elseif name == "@_aorbtn_CloseView" or name == "@_aorbtn_Cancel" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        if self.data.goodData.get_nums == self.data.cfg.num_limit then
            _G.PopWindowManager:GetInstance():ShowAllTips(250113)
            return
        end
        if self.callback then
            self.callback(self.data, self.curNum)
        end
        self:Close()
    end
end

return SociatyStorageTakeView
