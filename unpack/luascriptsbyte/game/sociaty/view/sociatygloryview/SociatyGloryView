---@class SociatyGloryView : UIBaseView	公会职位一览视图
---@field go_table SociatyGloryView_GoTable
local SociatyGloryView = _G.BaseClass("SociatyGloryView", _G.UIBaseView)

function SociatyGloryView:__init()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end
function SociatyGloryView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end

function SociatyGloryView:OnCreate(...)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyGloryTopView.Name, ...)
end

function SociatyGloryView:OnTopViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.SociatyGloryTopView.Name then
        self:Close()
    end
end

return SociatyGloryView
