local SociatyModel = require("SociatyModel")

---@class WitchTrialsBoxDetail : UIBaseView	中文描述
---@field public go_table WitchTrialsBoxDetail_GoTable GoTable
---@field BoxItems SociatyNewYHView._obj_ListItem_GoTable[]
local WitchTrialsBoxDetail = _G.BaseClass("WitchTrialsBoxDetail", _G.UIBaseView)

function WitchTrialsBoxDetail:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.BoxInfo, self.ViewAnimationFinish, self)
end

---界面的入口函数
function WitchTrialsBoxDetail:OnCreate(callback,data)
    self.callData = {}
    self.callback = callback
    self.call = false
    self:InitData(data)
end

---界面的销毁函数
function WitchTrialsBoxDetail:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.BoxInfo, self.ViewAnimationFinish, self)
end

function WitchTrialsBoxDetail:ViewAnimationFinish()
    if self.rewardLists then
        for _, v in pairs(self.rewardLists) do
            if v.canTake then
                v:ShowEffectOrder(true)
            end
        end
    end

    --self.go_table.scrollloopvectical_boxList:AddLocalPosition(0,-20,0)
end

---按钮点击事件在这里派发
function WitchTrialsBoxDetail:OnClickBtn(go)
    if go == self.go_table.aorbtn_anyclose then
        self:CloseView()
    elseif go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_oneclick then
        if not _G.table.isEmptyOrNil(self.canGet) then
            self:OnClickItem()
        end
    end
end

function WitchTrialsBoxDetail:CloseView()
    if self.call then
        self.callback(self.callData)
    end
    self:Close()
end

function WitchTrialsBoxDetail:InitData(data)
    self.BoxItems = {}
    self.canGet = {}
    self.rewardLists = {}
    self.canTakeAll = false
    local level = require "SociatyModel":GetInstance().SociatySelf.Level
    self.feastData = data.feast_info
    self.getFoods = self.feastData.get_foods
    if _G.table.isEmptyOrNil(self.getFoods) then
        self.getFoods = {}
    end
    self.cfg = _G.ConfigManager.guild_level_cfg[level]
    self.feastCfg = _G.ConfigManager.guild_feast_cfg
    self:InitBoxData()
    self.go_table.scrollloopvectical_boxList:InitItemData(
        #self.cfg.feast,
        _G.handler(self, self.RefreshBox),
        self.curBox - 1
    )
    self:ShowAutoBtn()
end

---初始化宝箱数据
function WitchTrialsBoxDetail:InitBoxData()
    self.BoxDatas = {}
    local insert = _G.table.insert
    for _, v in pairs(self.cfg.feast) do
        insert(self.BoxDatas, self.feastCfg[v])
    end
    self.curBox = self:CurBox()
    self:CheckCanGet()
end

function WitchTrialsBoxDetail:RefreshBox(index, item)
    local newIndex = index + 1
    item:SetName(newIndex)
    local instanceID = item:GetInstanceIDE()
    local tb = self.BoxItems[instanceID]
    if not tb then
        tb = _G.GetAutoGoTable(item)
        --_G.AddViewBtnClick(item, _G.handlerbind(self, self.OnClickItem, tb))
        self.BoxItems[instanceID] = tb
    --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_kapaifaguang_loop, tb.obj_choose)
    end
    tb.data = self.BoxDatas[newIndex]
    tb.aorimage_box.SpriteName = tb.data.icon
    tb.aortext_name.text = _G.LangUtil.GetLangPackValue(tb.data.name)
    if newIndex == self.curBox then
        tb.aorimage_current:SetActiveE(1)
    end
    if newIndex == 5 and self.getFoods[5] then
        tb.aorimage_current:SetActiveE(0)
    end
    self.member = tb
    local totalNum = #self.member.data.reward
    for i = 1, totalNum do
        if self.rewardLists[instanceID .. i] == nil then
        else
            _G.DestroyObject(self.rewardLists[instanceID .. i].gameObject)
        end
        local data = self.member.data.reward[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            self.member.data.reward[i],
            self.member.obj_Content,
            function(tran)
                local isTake = self.getFoods[newIndex] ~= nil
                local canTake = self.canGet[newIndex] ~= nil
                self.rewardLists[instanceID .. i] = {}
                self.rewardLists[instanceID .. i] = tran
                tran:ShowName(false)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:SetGou(isTake)
                tran.canTake = canTake
                --tran:ShowEffectOrder(canTake)
            end,
            function(go)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
            end
        )
    end
    local addRatio = require("SociatyModel"):GetInstance():GetBuildBoxAdd()
    --如果有宝箱加成，把加成的数据加到最后显示
    local tab = {}
    if addRatio > 0 then 
        for i = 1, totalNum do 
            local num = math.floor(self.member.data.reward[i][2] * addRatio) 
            if num > 1 then 
                table.insert(tab, {self.member.data.reward[i][1], num})
            end
        end
    end
    if not _G.table.isEmptyOrNil(tab) then 
        for i = 1, #tab do
            if self.rewardLists[instanceID .. (i + totalNum)] == nil then
            else
                _G.DestroyObject(self.rewardLists[instanceID .. (i + totalNum)].gameObject)
            end
            local data = tab[i]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                tab[i],
                self.member.obj_Content,
                function(tran)
                    local isTake = self.getFoods[newIndex] ~= nil
                    local canTake = self.canGet[newIndex] ~= nil
                    self.rewardLists[instanceID .. (i + totalNum)] = {}
                    self.rewardLists[instanceID .. (i + totalNum)] = tran
                    tran:ShowName(false)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    tran:SetGou(isTake)
                    tran.canTake = canTake
                    tran:SetPri(true)
                    --tran:ShowEffectOrder(canTake)
                end,
                function(go)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
                end
            )
        end
    end
    return item
end

