function WitchTrialsBoxDetail:CurBox()
    local fight_times = self.feastData.fight_times
    local count = #self.BoxDatas
    for i = 1, count do
        local need = self.BoxDatas[i].materials[2]
        if fight_times < need then
            return i
        end
    end
    self.canTakeAll = true
    return count
end

function WitchTrialsBoxDetail:ShowAutoBtn()
    if self:CheckCanGet() then
        self.go_table.aorbtn_oneclick:SetGray(false)
        self.go_table.aortext_onclick.color = _G.ColorTools.FormatColorByString("823A0F")
    else
        self.go_table.aorbtn_oneclick:SetGray(true)
        self.go_table.aortext_onclick.color = _G.ColorTools.FormatColorByString("444444")
    end
end

function WitchTrialsBoxDetail:CheckCanGet()
    self.canGet = {}
    local count = self.curBox
    for i = 1, count - 1 do
        if not self.getFoods or not self.getFoods[i] then
            self.canGet[i] = self.BoxDatas[i].id
        end
    end
    if self.canTakeAll and not self.getFoods[5] then
        self.canGet[5] = self.BoxDatas[5].id
    end
    return not _G.table.isEmptyOrNil(self.canGet)
end

function WitchTrialsBoxDetail:OnClickItem()
    local msg = {fid = {}}
    msg.fid = _G.table.toArray(self.canGet)
    require "SociatyNet":GetInstance():GetFeastAward(
        msg,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            SociatyModel:GetInstance().unopenedBox = {}
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.GuildchallengeButton.id
            )
        end
    )
    if self.getFoods == nil then
        self.getFoods = {}
    end
    for _, v in pairs(self.canGet) do
        _G.table.insert(self.getFoods, v)
    end
    self.call = true
    self.callData = self.canGet
    self:ShowAutoBtn()
    self.go_table.scrollloopvectical_boxList:UpdateAllItem()
end

return WitchTrialsBoxDetail
