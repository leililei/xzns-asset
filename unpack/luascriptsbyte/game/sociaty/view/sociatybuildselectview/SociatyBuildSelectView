---定义标题语言键id, 对应language_package_cfg
local TitleLanguage = {
    [1] = 90021800376, --公会大厅
    [2] = 90021800377, --铁匠铺
    [3] = 90021800378, --公会仓库
    [4] = 90021800379, --魔女试炼
    [5] = 90021800487 --冥界纷争
}

---@class SociatyBuildSelectView : UIBaseView	公会建造选择数量视图
---@field curId number                                              @当前选中的建筑id
---@field curNum number                                             @当前选择数量
---@field ownNum number                                             @自身拥有的道具数量
---@field maxNum number                                             @升至满级还需要多少个
---@field go_table SociatyBuildSelectView_GoTable
local SociatyBuildSelectView = _G.BaseClass("SociatyBuildSelectView", _G.UIBaseView)

function SociatyBuildSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
end
function SociatyBuildSelectView:OnDestroy()
    self:RemoveAllListener()
end
---监听被踢出公会
function SociatyBuildSelectView:OnBeKicked()
    self:Close()
end

function SociatyBuildSelectView:OnCreate(id, maxNeedExp)
    self.curId = id
    --计算最多还需要多少代币
    local coinId, coinExp = require("SociatyModel"):GetInstance():GetBuildCoinCfg()
    if coinId > 0 and coinExp > 0 then
        self.maxNum = math.ceil(maxNeedExp / coinExp)
        self.ownNum = _G.StorageManager:GetInstance():GetOtherItemCountBySid(coinId)
    else
        self.maxNum = 999999
        self.ownNum = 0
    end
    self.curNum = self.ownNum

    self:InitStates()
    self:UpdateNumber()

    --添加输入事件
    self.changeInputText = false
    self.go_table.aorinputfield_number.onEndEdit:AddListener(_G.handler(self, self.OnInputEndEdit))
end

---初始化面板状态
---@return void
function SociatyBuildSelectView:InitStates()
    local model = require("SociatyModel"):GetInstance()

    for index, id in ipairs(model:GetBuildIds()) do
        self.go_table["obj_build" .. index]:SetActiveE(self.curId == id and 1 or 0)
    end
    self.go_table.aortext_name.text = _G.GetLangPackValue(TitleLanguage[self.curId])

    --建筑币图标
    local buildCoinId = model:GetBuildCoinCfg()
    local path = _G.StorageManager:GetInstance():GetItemIcon(buildCoinId)
    self.go_table.aorrawimage_consumeIcon:LoadImage(path)
end

---更新数量状态显示
---@return void
function SociatyBuildSelectView:UpdateNumber()
    if self.curNum > self.ownNum then
        self.curNum = self.ownNum
    elseif self.curNum < 0 then
        self.curNum = 0
    end
    if self.curNum > self.maxNum then
        self.curNum = self.maxNum
    end

    local model = require("SociatyModel"):GetInstance()
    local _, coinExp = model:GetBuildCoinCfg()
    local exp, needExp = model:GetBuildExp(self.curId)
    local finalExp = exp + self.curNum * coinExp
    self.go_table.aortext_consume.text = string.format("%s/%s", self.curNum, self.ownNum)
    --等级信息
    self.go_table.aortext_level.text = string.format("<color=#400E0E>%s+</color>%s", exp, self.curNum * coinExp)
    self.go_table.aorimage_level:SetLocalScale((finalExp > needExp or needExp <= 0) and 1 or finalExp / needExp, 1, 1)

    self.changeInputText = true
    self.go_table.aorinputfield_number.text = tostring(self.curNum)
    self.changeInputText = false
end

---监听升级成功回调
---@param lastLevel number 捐献之前的等级
---@return void
function SociatyBuildSelectView:OnUpgradeCallback(_, lastLevel)
    self:Close()

    local model = require("SociatyModel"):GetInstance()
    model:SetDefaultBuildState()

    --显示tip
    local buildName = _G.GetLangPackValue(_G.ConfigManager.guild_unit_cfg[self.curId].name)
    _G.PopWindowManager:GetInstance():ShowAllTips(250145, nil, nil, nil, nil, nil, buildName)

    --更新建筑页面
    ---@type SociatyBuildView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyBuildView.Name)
    if view then
        view:UpdateView()
        local curLevel = require("SociatyModel"):GetInstance():GetBuildLevel(self.curId)
        if curLevel > lastLevel then
            view:ShowUpgradeFlashEffect()
        end
        view:ShowUpgradeUseEffect()
    end

--[[    --更新主页面
    ---@type SociatyMainView
    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    if mainView then
        mainView:UpdateLevelView()
    end]]
end

---处理按钮事件
function SociatyBuildSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 or go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_sub1 then
        self.curNum = self.curNum - 1
        self:UpdateNumber()
    elseif go == self.go_table.aorbtn_sub10 then
        self.curNum = self.curNum - 10
        self:UpdateNumber()
    elseif go == self.go_table.aorbtn_add1 then
        self.curNum = self.curNum + 1
        self:UpdateNumber()
    elseif go == self.go_table.aorbtn_add10 then
        self.curNum = self.curNum + 10
        self:UpdateNumber()
    elseif go == self.go_table.aorbtn_max then
        self.curNum = self.maxNum
        self:UpdateNumber()
    elseif go == self.go_table.aorbtn_confirm then
        if self.curNum <= 0 then
            return
        end
        local model = require("SociatyModel"):GetInstance()
        local curLevel = model:GetBuildLevel(self.curId)
        model:BuildUp(self.curId, self.curNum, _G.handlerbind(self, self.OnUpgradeCallback, curLevel))
    end
end
---处理输入事件
function SociatyBuildSelectView:OnInputEndEdit(text)
    if self.changeInputText then
        return
    end
    self.curNum = tonumber(text) or self.curNum
    self:UpdateNumber()
end

return SociatyBuildSelectView
