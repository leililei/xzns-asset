---@class SociatyCheckView : UIBaseView 描述
---@field public go_table SociatyManagerView._obj_Apply_GoTable GoTable
---@field public Requests guild.i_request_guild[] 申请数据
---@field public InfoPanelCtrls SociatyCheckView._obj_InfoPanel_GoTable
---@field public SociatyItemList SociatyCheckView._obj_SociatyItem_GoTable[] 滚动组件元素
local SociatyCheckView = _G.BaseClass("SociatyCheckView", _G.Component)
local SociatyData = require("SociatyData")
local UIUtils = _G.UIUtils
---@type SociatyCheckView_GoTable
local Ctrl

---@type SociatyMemberModule
local MD

---@type SociatyData
local SociatySelf

function SociatyCheckView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    Ctrl = self.go_table
end

---界面的入口函数
---@param data guild.s2c_guild_get_requests 返回PB数据
function SociatyCheckView:OnCreate()
    require "SociatyData".GetMemberModule():ShowCheckView(
        function(data)
            self:Show(data)
            _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
        end
    )
    self:AddListener(_G.eSociatyEvent.RefuseRequest, self.OnDealRequest)
    self:AddListener(_G.eSociatyEvent.Enter, self.OnEnter)
    self:AddListener(_G.eSociatyEvent.RoleRequest, self.OnRoleRequest)
end

function SociatyCheckView:Show(data)
    MD = SociatyData.GetMemberModule()
    SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.SociatyItemList = {}
    self.Requests = data.requests or {}
    self:SortRequest()
    local len = #self.Requests
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_NoNum, len <= 0)
    self.go_table.scrollloopvectical_memberList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
    self.go_table.obj_have:SetActiveE(len > 0 and 1 or 0)
    self.go_table.obj_NoNum:SetActiveE(len == 0 and 1 or 0)
    self:ShowBtn()
    self.go_table.toggle_autoApply.isOn = SociatySelf.NeedApproval == 0
end

function SociatyCheckView:SortRequest()
    ---@param a guild.i_request_guild
    _G.SortList(
        self.Requests,
        function(a)
            return a.role.power, a.role.afk, a.time
        end
    )
end

---当有成员加入时
---@param msg guild.p2c_enter_guild_old[]
function SociatyCheckView:OnEnter(msg, isAll)
    if isAll then
        self:OnDealRequest(nil, isAll)
    else
        if not msg then
            return
        end
        self:OnDealRequest(msg)
    end
    local len = #self.Requests
    self.go_table.obj_have:SetActiveE(len > 0 and 1 or 0)
    self.go_table.obj_NoNum:SetActiveE(len == 0 and 1 or 0)
end

---当有玩家申请时,添加显示数据
---@param msg guild.p2c_guild_request
function SociatyCheckView:OnRoleRequest(msg, isCancel)
    if not next(msg) then
        return
    end

    for k, v in ipairs(self.Requests) do
        if v.role.uid == msg.role.uid then
            if not isCancel then
                if _G.AppSetting.DEBUG then
                    _G.LogError("SociatyCheckView:OnRoleRequest v.role.uid == msg.role.uid")
                end
                return
            else
                table.remove(self.Requests, k)
                break
            end
        end
    end

    msg.time = _G.TimeUtil.GetServerUnixTime()
    if not isCancel then
        table.insert(self.Requests, msg)
    end

    self:SortRequest()
    local count=#self.Requests
    self.go_table.scrollloopvectical_memberList:UpdateCount(count)
    self.go_table.obj_NoNum:SetActiveE(count==0 and 1 or 0)
    self.go_table.obj_have:SetActiveE(count > 0 and 1 or 0)
    self:ShowBtn()
end

---当同意/拒绝申请时
---@param uid number
function SociatyCheckView:OnDealRequest(uids, isAll)
    if not isAll then
        if _G.table.isEmptyOrNil(uids) then
            return
        end
        local count = #uids
        local del = function(uid)
            local index
            --(self.Requests, "申请列表数据")
            for i, v in pairs(self.Requests) do
                if v.role.uid == uid then
                    index = i
                    break
                end
            end

            if index then
                table.remove(self.Requests, index)
            end
        end
        local isTb = _G.type(uids[1]) == "table"
        for i, v in ipairs(uids) do
            if isTb then
                del(v.role and v.role.role.uid or v)
            else
                del(v)
            end

            if i == count then
                local count2 = #self.Requests
                self.go_table.scrollloopvectical_memberList:UpdateCount(count2)
                self:ShowBtn()
            end
        end
    else
        self.Requests = {}
        self.go_table.scrollloopvectical_memberList:UpdateCount(0)
        self:ShowBtn()
    end
    local len = #self.Requests
    self.go_table.obj_have:SetActiveE(len > 0 and 1 or 0)
    self.go_table.obj_NoNum:SetActiveE(len == 0 and 1 or 0)
end

function SociatyCheckView:ShowBtn()
    local data = require("SociatyData").GetMemberModule():GetSelfMember()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_set, data.CfgItem.set_join)
    _G.GameUtil.SetActiveByCondition(self.go_table.toggle_autoApply, data.CfgItem.set_join)
    --self.go_table.aortext_num.text = count
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function SociatyCheckView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    ---@type SociatyCheckView._obj_SociatyItem_GoTable
    local ctrl = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnCellClickBtn, eIndex))
    local data = self.Requests[eIndex]
    if data then
        ctrl.aortext_name.text = data.role.name
        ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.role.power)
        -- local serverCfg = _G.ConfigManager.server_list_cfg[data.role.server_id]
        -- if serverCfg then
        --     ctrl.aortext_sever.text = _G.LangUtil.GetLangPackValue(serverCfg.ServerName)
        -- else
        --     local server = _G.ServerManager:GetInstance():GetLastServer()
        --     ctrl.aortext_sever.text = server.ServerName
        -- end
        if data.role.afk then
            local cfg = _G.ConfigManager.afk_cfg[data.role.afk]
            if cfg then
                ctrl.aortext_afk.text = _G.string.format("%s-%s", cfg.chapter, cfg.section)
            else
                ctrl.aortext_afk.text = "1-1"
            end
        else
            ctrl.aortext_afk.text = "1-1"
        end
        UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data.role, 0.57, true, true, true)
        ctrl.aortext_state.text = _G.TimeUtil.GetOfflineStateDesc(data.is_online)
    end
    self.SociatyItemList[eIndex] = ctrl
    return item
end

---滚动组件按钮派发
---@param go UnityEngine.GameObject 按钮
---@param isOn boolean
---@param index number
function SociatyCheckView:OnCellClickBtn(go, isOn, index)
    ---@type SociatyCheckView._obj_SociatyItem_GoTable
    local ctrl = self.SociatyItemList[index]
    local role = self.Requests[index].role

    if go == ctrl.aorbtn_yes then
        MD:DoAgreeRequest(
            {role.uid},
            self.Requests,
            nil,
            function(data)
                if not _G.table.isEmptyOrNil(data) and data[1].ack ~= 1 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(250117)
                end
            end
        )
        return
    end

    -- if go == ctrl.aorbtn_no then
    --     MD:DoRefuseRequest({role.uid})
    --     return
    -- end
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject 按钮
---@param isOn boolean toggle
function SociatyCheckView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_yes then
        local tb = {}
        for _, v in pairs(self.Requests) do
            _G.table.insert(tb, v.role.uid)
        end
        if #tb > 0 then
            MD:DoAgreeRequest(tb, self.Requests, true)
        end
    elseif go == self.go_table.aorbtn_no then
        local tb = {}
        for _, v in pairs(self.Requests) do
            _G.table.insert(tb, v.role.uid)
        end
        if #tb > 0 then
            MD:DoRefuseRequest(tb, true)
        end
    elseif go == self.go_table.aorbtn_set then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyLimiteChapterView.Name)
    elseif go == self.go_table.toggle_autoApply then
        require "SociatyData".GetMemberModule():SaveCondition(
            SociatySelf.LimitLevel,
            SociatySelf.LimitChapter,
            isOn == true and 0 or 1,
            function()
                _G.PopWindowManager:GetInstance():ShowAllTips(200116)
            end
        )
    end
end

function SociatyCheckView:OnDestroy()
end

---析构函数
function SociatyCheckView:Dispose()
    Ctrl = nil
    MD = nil
    self:RemoveAllListener()
end

---@return SociatyCheckView
return SociatyCheckView
