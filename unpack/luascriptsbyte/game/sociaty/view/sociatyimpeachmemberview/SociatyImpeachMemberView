---@class SociatyImpeachMemberView : UIBaseView    中文描述
local SociatyImpeachMemberView = _G.BaseClass("SociatyImpeachMemberView", _G.UIBaseView)
local SociatyData = require("SociatyData")
local SociatyMemberBase = require("SociatyMemberBase")

function SociatyImpeachMemberView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_memberList:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---创建对象时,入口构造函数
function SociatyImpeachMemberView:OnCreate()
    self:Show()
end

function SociatyImpeachMemberView:Show()
    self.data = SociatyData:GetMemberModule():GetSelfMember()
    self:InitData()
    self.go_table.scrollloopvectical_memberList:UpdateCount(#self.Member)
end
---初始化数据
function SociatyImpeachMemberView:InitData()
    local model = require("SociatyModel"):GetInstance()
    self.MD = SociatyData.GetMemberModule()
    self.MD:SortMemberByManager()
    self.Member = _G.DeepCopy(self.MD.Member)
    local chairData = model.SociatySelf.GetMemberModule():GetChairman()
    --ZHJH5ZHJH-9536 【主任务】公会会长弹劾优化制作ZHJH-10667
    --【会长弹劾】会长弹劾中成员列表中剔除会长
    for i = 1, #self.Member do
        if self.Member[i].Uid == chairData.Uid then
            table.remove(self.Member, i)
            break
        end
    end
    for i = 1, #self.Member do
        self.Member[i].sortbyimpeach = model:IsImpeach(self.Member[i].Uid) and 1 or 0
        self.Member[i].sortbytime =
            chairData.OfflineTime > 0 and (_G.TimeUtil.GetServerUnixTime() - chairData.OfflineTime) or 0
    end

    _G.SortList(
        self.Member,
        function(a)
            return -a.sortbyimpeach, -a.sortbytime
        end
    )

    self.SociatyItemList = {}
end

function SociatyImpeachMemberView:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    ---@type SociatyLobbyView._obj_SociatyItem_GoTable
    local ctrl = _G.GetAutoGoTable(item)
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.SociatyItemList[id] = ctrl
    --self.IndexToId[eIndex] = id
    self:RefreshItemShow(ctrl, eIndex)
end

---刷新单元格文本颜色显示
---@param ctrl SociatyLobbyView._obj_SociatyItem_GoTable
---@param eIndex number
function SociatyImpeachMemberView:RefreshItemShow(ctrl, eIndex)
    local data = self.Member[eIndex]
    if data then
        ctrl.aortext_name.text = data.Name
        ctrl.aortext_online.text = data.OfflineDesc1
        ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.Power)

        for i = 1, 4 do
            ctrl["aorimage_title" .. i]:SetActiveE(0)
        end

        local model = require("SociatyModel"):GetInstance()
        --是否为名人堂玩家
        if data.Location > 3 then
            local isFame = model:IsFameMember(data)
            if isFame then
                ctrl.aortext_pro:SetActiveE(0)
                ctrl.obj_proimage:SetActiveE(1)
                ctrl["aorimage_title4"]:SetActiveE(1)
            else
                ctrl.aortext_pro:SetActiveE(1)
                ctrl.obj_proimage:SetActiveE(0)
                ctrl.aortext_pro.text = SociatyMemberBase:GetLocationName(data.Location)
            end
        else
            ctrl.aortext_pro:SetActiveE(0)
            ctrl.obj_proimage:SetActiveE(1)
            ctrl["aorimage_title" .. data.Location]:SetActiveE(1)
        end

        local isipch = model:IsImpeach(data.Uid)
        if isipch then
            ctrl.aortext_impeachstate.text = _G.GetLangPackValue(90021800537)
        else
            ctrl.aortext_impeachstate.text = "<color=#ff0000>" .. _G.GetLangPackValue(90021800543) .. "</color>"
        end

        _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data, 0.7, true, true, true)
    end
end

function SociatyImpeachMemberView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---销毁对象时,析构函数
function SociatyImpeachMemberView:OnDestroy()
end

return SociatyImpeachMemberView
