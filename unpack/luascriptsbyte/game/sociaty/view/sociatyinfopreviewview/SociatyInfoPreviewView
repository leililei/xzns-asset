---@class SociatyInfoPreviewView : UIBaseView	中文描述
---@field public go_table SociatyInfoPreviewView_GoTable GoTable
local SociatyInfoPreviewView = _G.BaseClass("SociatyInfoPreviewView", _G.UIBaseView)

local officialBg = {
    "ui_gh_mrt_hzq",
    "ui_gh_mrt_fhzq",
}

local officialColor = {
    _G.ColorTools.FormatColorByString("FFE486"),
    _G.ColorTools.FormatColorByString("F4E1FF")
}

local officialOutlineColor = {
    _G.ColorTools.FormatColorByString("640707"),
    _G.ColorTools.FormatColorByString("3A056B")
}

function SociatyInfoPreviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyInfoPreviewView:OnCreate(uid)
    require("SociatyNet"):GetInstance():GetOtherGuildInfo({uid = uid}, _G.handler(self, self.InitView))
    -- self:InitView()
end

function SociatyInfoPreviewView:InitView(msg)
    local info = msg.other
    if info == nil then
        self:Close()
        return
    end
    local applyType = {
        [0] = _G.GetLangPackValue(90021800392), --自动
        [1] = _G.GetLangPackValue(90021800526), --手动
        [3] = _G.GetLangPackValue(90021800527) --拒绝
    }
    self.members = info.roles
    _G.table.sort(self.members, function(a, b)
        if a.pos ~= nil and b.pos ~= nil then
            if a.pos == b.pos then
                return a.role.power > b.role.power
            end
            return a.pos < b.pos
        elseif a.pos ~= nil then
            return true
        elseif b.pos ~= nil then
            return false
        else
            return a.role.power > b.role.power
        end
    end)
    local memberNum = #self.members
    self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[info.banner].portrait)
    self.go_table.aortext_name.text = info.name
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitWord(info.guild_power or 0)
    self.go_table.aortext_memberNum.text = memberNum .. "/" .. _G.ConfigManager.guild_level_cfg[info.level].num_player
    self.go_table.aortext_lv.text = info.level
    local threshold = _G.string.AddColor(_G.GetLangPackValue(90021800344, info.afk_chapter), "BA5411")
    self.go_table.aortext_threshold.text = _G.GetLangPackValue(90021800522, threshold)
    self.go_table.aortext_approvalType.text = _G.GetLangPackValue(90021800523, _G.string.AddColor(applyType[info.is_check], "BA5411"))
    --ZHJH-9440 删除公告区域
    --self.go_table.aortext_notice.text = info.public_notice ~= "" and info.public_notice or _G.LangUtil.GetLangPackValue(90021800022)
    for i = 1, memberNum do
        if self.members[i].pos == 1 then
            self.go_table.aortext_chairmanName.text = self.members[i].role.name
            break
        end
    end
    self.go_table.scrollloopvectical_member:InitItemData(memberNum, _G.handler(self, self.RefreshMember))
end

function SociatyInfoPreviewView:RefreshMember(index, obj)
    index = index + 1
    ---@type SociatyInfoPreviewView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.members[index]
    tb.aortext_power.text = _G.GameUtil.NumberToUnitWord(data.role.power)
    local isOfficial = data.pos ~= nil
    tb.aortext_name.text = isOfficial and data.role.name or _G.GetLangPackValue(90021800525)
    tb.aortext_member:SetActiveE(isOfficial and 0 or 1)
    tb.obj_emptyHead:SetActiveE(isOfficial and 0 or 1)
    tb.obj_HeadItemBase:SetActiveE(isOfficial and 1 or 0)
    tb.aorimage_official:SetActiveE(isOfficial and 1 or 0)
    tb.aortext_online:SetActiveE(isOfficial and 1 or 0)
    if isOfficial then
        _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role, 0.75, true, false, true)
        tb.aorimage_official.SpriteName = officialBg[data.pos]
        tb.aortext_online.text = _G.TimeUtil.GetOfflineStateDesc(data.is_online, "3D7422", "351B0A")
        tb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[data.pos].name)
        tb.aortext_offName.color = officialColor[data.pos]
        tb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
    end
end

---按钮点击事件在这里派发
function SociatyInfoPreviewView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_bg then
        self:Close()
    end
end

---界面的销毁函数
function SociatyInfoPreviewView:OnDestroy()
end

return SociatyInfoPreviewView
