---@class SociatyShowLogView : Component 公户公告界面
---@field public go_table SociatyShowLogView_GoTable GoTable
---@field public LogDatas guild.i_guild_log[] 日志数据
---@field public SociatyItemList SociatyShowLogView._obj_LogItem_GoTable[] 日志loopListItem
local SociatyShowLogView = _G.BaseClass("SociatyShowLogView", _G.Component)

function SociatyShowLogView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
end

---界面的入口函数
---@param data guild.s2c_guild_get_logs
function SociatyShowLogView:OnCreate()
    self.lstData = {}
    local dataLog
    require("SociatyModel"):GetInstance():GetLog(
        1,
        function(data)
            _G.table.sort(data.logs,function (a, b)
                return a.value2 > b.value2
            end
            )
            dataLog = data
            local msg = self:LogFilter(dataLog.logs)
            ---@type table<string,ViewData> 日期映射字典
            local parentMapping = {}
            ---@param date string       日期
            ---@param time string       时间
            ---@param text string       消息内容主体
            local function addChild(date, time, text)
                local parent = parentMapping[date]
                if not parent then
                    parent = {
                        type = "parent",
                        text = date,
                        children = {},
                        expand = false
                    }
                    parentMapping[date] = parent
                    table.insert(self.lstData, parent)
                end
                table.insert(
                    parent.children,
                    {
                        type = "child",
                        time = time,
                        text = text
                    }
                )
            end

            ---@param sid number
            local function getLogText(eIndex)
                local name
                local typeKey = {
                    [1] = _G.LangUtil.GetLangPackValue(90021800073),
                    [2] = _G.LangUtil.GetLangPackValue(90021800085),
                    [3] = _G.LangUtil.GetLangPackValue(90021800106),
                    [4] = _G.LangUtil.GetLangPackValue(90021800161),
                    [6] = _G.LangUtil.GetLangPackValue(90021800405)
                }
                local data = msg[eIndex]
                if data then
                    local typeStr = typeKey[data.type]
                    local nameColor = "ebb551"
                    local typeColor = "b6826a"
                    if _G.AppSetting.IsXzns then
                        nameColor = "E18E00"
                        typeColor = "E18E00"
                    end
                    local userName = _G.string.AddColor(data.value1, nameColor)

                    typeStr = _G.string.AddColor(typeStr, typeColor)
                    if data.type == 4 or data.type == 6 then
                        name = _G.string.format(typeStr, userName)
                    elseif data.type == 3 then
                        name = _G.string.format(typeStr, userName, data.value5)
                    elseif data.type == 2 then
                        name = _G.string.format(typeStr, userName)
                    else
                        name = userName .. typeStr
                    end
                end
                return name
            end

            --时间格式化字符串: os.date("%Y-%m-%d %H:%M:%S", os.time())
            --示例: 2024-08-01 00:00:00
            for k, log in ipairs(msg) do
                addChild(_G.TimeUtil.date("%Y-%m-%d", log.value2), _G.TimeUtil.date("%H:%M", log.value2), getLogText(k))
            end
            
            --展开所有 parent 节点并插入它们的 children 到相应位置
            local i = 1
            while i <= #self.lstData do
                local parent = self.lstData[i]
                if parent and parent.type == "parent" and type(parent.children) == "table" then
                    local numChildren = #parent.children
                    if numChildren > 0 then
                        parent.expand = true
                        -- 插入 children 到 parent 后面
                        for j = 1, numChildren do
                            local child = parent.children[j]
                            if child then
                                table.insert(self.lstData, i + j, child)
                            end
                        end
                        i = i + numChildren -- 跳过新插入的 children
                    end
                end
                i = i + 1
            end
            
            self.SociatyItemList = {}
            local len = self.lstData and #self.lstData or 0
            self.go_table.scrollloopvectical_list:InitItemData(len, _G.handler(self, self.OnRefreshItem))
        end
    )
end

---刷新列表元素
---@return void
function SociatyShowLogView:OnRefreshItem(index, obj)
    if not self.itemMapping then
        self.itemMapping = {}
    end
    local item = self.itemMapping[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        --_G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnClickListBtn, item))
        self.itemMapping[obj:GetInstanceIDE()] = item
    end

    --C#下标从0开始, lua下标从1开始
    local data = self.lstData[index + 1]
    item.data = data
    item.obj_title:SetActiveE(data.type == "parent" and 1 or 0)
    item.obj_content:SetActiveE(data.type == "child" and 1 or 0)

    if data.type == "parent" then
        item.aortext_title.text = data.text
        item.aorbtn_reduce:SetActiveE(0)--(data.expand and 1 or 0)
        item.aorbtn_expand:SetActiveE(0)--(data.expand and 0 or 1)
    else
        item.aortext_date.text = data.time
        item.aortext_details.text = data.text
    end
end

---处理标题点击事件
function SociatyShowLogView:OnClickListBtn(_, _, item)
    ---@type ViewData
    local data = item.data
    local index = -1
    for i, d in pairs(self.lstData) do
        if data == d then
            index = i
            break
        end
    end
    if index < 0 then
        return
    end

    if data.expand then
        data.expand = false
        for i = 1, #data.children do
            table.remove(self.lstData, index + 1)
        end
    else
        data.expand = true
        for i, child in ipairs(data.children) do
            table.insert(self.lstData, index + i, child)
        end
    end
    ---更新列表显示
    self.go_table.scrollloopvectical_list:UpdateCount(#self.lstData)
    --self.go_table.scrollloopvectical_list:UpdateAllItem()
end

---日志过滤
---@param logs guild.i_guild_log[] 日志
---@param blackList number[] //日志类型 1进入公会 2退出公会 3被踢出公会 4创建公会
---@return guild.i_guild_log[] 过滤后日志
function SociatyShowLogView:LogFilter(logs, blackList)
    local newLogs = {}
    if logs then
        for _, v in pairs(logs) do
            if blackList then
                if not _G.table.ContainsValue(blackList, v.type) then
                    newLogs[#newLogs + 1] = v
                end
            else
                newLogs[#newLogs + 1] = v
            end
        end
    end
    return newLogs
end

function SociatyShowLogView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        --self:Close()
        return
    end
end

function SociatyShowLogView:OnDestroy()
end

---析构函数
function SociatyShowLogView:Dispose()
end

---@return SociatyShowLogView
return SociatyShowLogView
