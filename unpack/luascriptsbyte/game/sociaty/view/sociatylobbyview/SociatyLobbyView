---@class SociatyLobbyView : UIBaseView 公会大厅界面
---@field go_table SociatyLobbyView_GoTable GoTable
---@field SociatyInfoPanel SociatyLobbyInfoPanel 公会信息组件
---@field Member SociatyMemberBase[] 公会成员信息
---@field CurIndex number 当前选中单元格索引
---@field CurUid number 当前选中单元格玩家uid
local SociatyLobbyView = _G.BaseClass("SociatyLobbyView", _G.UIBaseView)
local SociatyLobbyInfoPanel = require("SociatyLobbyInfoPanel")
local SociatyData = require("SociatyData")
local SociatyMemberBase = require("SociatyMemberBase")
local UIUtils = _G.UIUtils
---@type SociatyLobbyView_GoTable
local Ctrl

---@type SociatyMemberModule
local MD

---@type SociatyData
local SociatyDataSelf

local titlePath = {
    [1] = "Images/nSociaty/ui_gh_txt_gonghuidating",
    [2] = "Images/nSociaty/ui_gh_ghjc_gonghuishiwu_txt",
    [3] = "Images/nSociaty/ui_gh_ghjc_gonghuipaihang_txt",
}

function SociatyLobbyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    Ctrl = self.go_table
end

---界面的入口函数
function SociatyLobbyView:OnCreate(index)
    self.SociatyInfoPanel = self:AddComponent(Ctrl.obj_LobbyInfoPanel, SociatyLobbyInfoPanel.New(self))
    local defaultIndex = index and index or 1
    self:InitData()
    self.LimitLevel = _G.ConfigManager.discrete_cfg[101682][1][1]
    if nil == SociatyDataSelf then
        self.go_table.obj_Toggle:SetActiveE(0)
        defaultIndex = 3
        --[[        self.go_table.aorrawimage_title:LoadImage(titlePath[3],
        function(trans)
            trans:SetNativeSize()
        end)]]
    else
        self.CurUid = MD:GetMemberByIndex(1).Uid
        ---@see SociatyLobbyInfoPanel#OnCreate
        self.SociatyInfoPanel:Refresh(SociatyDataSelf)
        -- self.go_table.scrollloopvectical_memberList:InitItemData(#self.Member, _G.handler(self, self.RefreshItem))
        self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
        self:AddListener(_G.eSociatyEvent.MemberRefresh, self.OnMemberRefresh)
        --[[        self.go_table.aorrawimage_title:LoadImage(titlePath[2],
        function(trans)
            trans:SetNativeSize()
        end)]]
    end
    self:AddListener(_G.eSociatyEvent.RefreshSevenDayLiveRank, self.UpdateRank)

    _G.GetAutoGoTable(self.go_table.obj_LobbyInfoPanel).input_Declaration.text = require("SociatyModel"):GetInstance()
        .SociatySelf.Declaration
    _G.GameUtil.InputFieldCharacterLimit(_G.GetAutoGoTable(self.go_table.obj_LobbyInfoPanel).input_Declaration, 38, nil,
        true, false)
    _G.GetAutoGoTable(self.go_table.obj_LobbyInfoPanel).input_Declaration.onValueChanged:AddListener(_G.handlerbind(self,
        self.OnValueChanged))

    self.go_table.toggle_info.isOn = defaultIndex == 1
    self.go_table.toggle_member.isOn = defaultIndex == 2
    self.go_table.toggle_rank.isOn = defaultIndex == 3
    if defaultIndex == 3 then
        self:OnToggle(self.go_table.toggle_rank, true, self.ShowRank)
    end
end

---输入检测设置条件
function SociatyLobbyView:OnValueChanged()
    if require("SociatyModel"):GetInstance()
        .SociatySelf.Level < self.LimitLevel then
        _G.PopWindowManager:GetInstance():ShowAllTips(250155, nil, nil, nil, nil, false, self.LimitLevel)
        _G.GetAutoGoTable(self.go_table.obj_LobbyInfoPanel).input_Declaration.text = _G.GetLangPackValue(90021800022)
    end
end

---当单元格回收
---@param go UnityEngine.GameObject
---@param index number
function SociatyLobbyView:OnRecycleItem(go, index)
    local ctrl = _G.GetAutoGoTable(go)
    if ctrl then
        _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_choose, false)
        _G.GameUtil.SetActiveByCondition(ctrl.toggle_choose, false)
        ctrl.toggle_choose.isOn = false
        _G.GameUtil.SetActiveByCondition(ctrl.toggle_choose, true)
    end
end

---初始化数据
function SociatyLobbyView:InitData()
    SociatyDataSelf = require("SociatyModel"):GetInstance().SociatySelf
    if nil == SociatyDataSelf then
        -- if _G.AppSetting.DEBUG then
        --     _G.LogError("SociatyDataSelf is nil")
        -- end
        return
    end

    MD = SociatyData.GetMemberModule()
    if nil == MD then
        -- if _G.AppSetting.DEBUG then
        --     _G.LogError("MD is nil")
        -- end
        return
    end
    MD:SortMemberByOffline()

    self.Member = MD.Member
    self.SociatyItemList = {}
    self.CurIndex = nil
    self.CurUid = nil
end

---当职位发生变动
function SociatyLobbyView:OnMemberRefresh()
    self:RefreshLoopList()
end

---踢出
---@param uid number
---@param isKick boolean 是否踢出
function SociatyLobbyView:OnBeKicked(uid, isKick)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
        return
    end

    if isKick then
        self.CurIndex = nil
        self.CurUid = nil
    end
end

function SociatyLobbyView:UpdateRank()
    if self.SociatyRankView then
        require("SociatyNet"):GetInstance():GetGuildRankList(
            function(data)
                self.SociatyRankView:Show(data)
            end
        )
    end
end

---刷新
function SociatyLobbyView:RefreshLoopList()
    --self.go_table.scrollloopvectical_memberList:UpdateCount(#self.Member)
end

---@param looplist2 SuperScrollView.LoopListView2 滚动组件
---@param index number 该数据的索引  0起始
function SociatyLobbyView:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    ---@type SociatyLobbyView._obj_SociatyItem_GoTable
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
    end
    self:RefreshItemShow(ctrl, eIndex)
end

---刷新单元格文本颜色显示
---@param ctrl SociatyLobbyView._obj_member_GoTable
---@param eIndex number
function SociatyLobbyView:RefreshItemShow(ctrl, eIndex)
    ctrl.index = eIndex
    local data = MD:GetMemberByIndex(eIndex)
    if data then
        ctrl.aortext_name.text = data.Name
        ctrl.aortext_point.text = data.WeekVp
        ctrl.aortext_online.text = data.OfflineDesc1
        ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.Power)
        ctrl.aortext_pro.text = SociatyMemberBase:GetLocationName(data.Location)
        ctrl.aortext_donate.text = data.donate
        ctrl.aortext_progress.text = _G.LangUtil.GetLangPackValue(90021800344, data.progress)
        --ctrl.aorrawimage_position:LoadImage(_G.SociatyPositionIconName[data.Location])
        --ctrl.aorbtn_appoint:SetActiveE((data.CfgItem.position_set and data.uid ~= _G.PlayerModel:GetInstance():GetPlayerUid()) and 1 or 0)
        ctrl.aorbtn_appoint:SetActiveE(0)
        UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data, 0.66, true, true, true)
        ctrl.uid = data.uid
    end
end

---滚动组件按钮派发
---@param go UnityEngine.GameObject 按钮
---@param isOn boolean
---@param index number
function SociatyLobbyView:OnItemClickBtn(go, isOn, tb)
    local data = MD:GetMemberByIndex(tb.index)
    if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620109)
    else
        _G.SystemSettingManager:GetInstance():OpenView(tb.uid)
    end
end

---显示成员
function SociatyLobbyView:ShowMember(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Member, isOn)
    if not isOn then
        return
    end
    if not self.SociatyMemberView then
        self.SociatyMemberView = self:AddComponent(self.go_table.obj_Member, require "SociatyMemberView".New(self))
    else
        self.SociatyMemberView:Show()
    end
    self.SociatyInfoPanel:SetTagIndex(1)
    --self.SociatyInfoPanel:Refresh(SociatyDataSelf)
end

---显示信息设置
function SociatyLobbyView:ShowRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_rank, isOn)
    if not isOn then
        return
    end
    if not self.SociatyRankView then
        self.SociatyRankView = self:AddComponent(self.go_table.obj_rank, require "SociatyRankView".New(self))
        self.SociatyInfoPanel:SetTagIndex(3)
        require("SociatyNet"):GetInstance():GetGuildRankList(
            function(data)
                self.SociatyRankView:Show(data)
                --屏蔽公会点击选中
                --self.SociatyRankView:OnItemClickBtn(nil, nil)
            end
        )
    else
        self.SociatyInfoPanel:SetTagIndex(3)
        require("SociatyNet"):GetInstance():GetGuildRankList(
            function(data)
                --屏蔽公会点击选中
                --self.SociatyRankView:OnItemClickBtn(nil, nil)
            end
        )
    end
end

---显示入会申请
function SociatyLobbyView:ShowApply(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Apply, isOn)
    if not isOn then
        return
    end
    if not self.SociatyCheckView then
        self.SociatyCheckView = self:AddComponent(self.go_table.obj_Apply, require "SociatyManagerView".New())
    end
    self.SociatyInfoPanel:SetTagIndex(2)
end

function SociatyLobbyView:OnToggle(go, isOn, callback)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    callback(self, isOn)
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject 按钮
function SociatyLobbyView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:Close()
        return
    end

    if name == "@_aorbtn_ShowLog" then
        self:DoShowLog()
        return
    end
    if name == "@_aorbtn_Check" then
        require "SociatyManager":GetInstance():OpenOtherSociaty()
        -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyJoinView.Name, true)
        return
    end
    if go == self.go_table.toggle_info then
        self:OnToggle(go, isOn, self.ShowMember)
    elseif go == self.go_table.toggle_member then
        self:OnToggle(go, isOn, self.ShowApply)
    elseif go == self.go_table.toggle_rank then
        self:OnToggle(go, isOn, self.ShowRank)
    end
end

---显示公会成员信息
---@param index number 索引
function SociatyLobbyView:DoShowMemberInfo(index)
    ---@type SociatyMemberBase
    local data = MD:GetMemberByIndex(index)
    if data then
        if self.CurIndex ~= index then
            local name = _G.ConfigManager.ui_cfg.SociatyMemberInfoView.Name
            ---@see SociatyMemberInfoView#OnCreate
            _G.UIManager:GetInstance():OpenWindow(name, data)
        end
        self.CurIndex = index
        self.CurUid = data.Uid
    end
end

---退出公会
function SociatyLobbyView:DoExit()
    MD:DoQuit()
end

---显示公会日志
function SociatyLobbyView:DoShowLog()
    MD:DoShowLogWindow()
end

---析构函数
function SociatyLobbyView:Dispose()
    Ctrl = nil
    MD = nil
    self:RemoveAllListener()
end

---@return SociatyLobbyView
return SociatyLobbyView
