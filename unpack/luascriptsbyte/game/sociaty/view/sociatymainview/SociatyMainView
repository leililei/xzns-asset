        "Effect/Battle/WX_FX_B_Scene/zhudiguanghuan_effect/ef_zhudiguanghuan",
        _G.ePoolType.Temporary,
        self.sceneRoot,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
            local pos = self.roleParams.cMoveArea[1]
            tran:SetPosition(pos[1] - 0.72, pos[2] + 0.72, 0)
            tran:SetEulerAngles(0, 0, 45)
        end
    )
