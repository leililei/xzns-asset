    name == uiCfg.SociatyGloryTopView.Name or name == uiCfg.SociatyBattleMainView.Name or
        (name == uiCfg.SociatyActivityView.Name and isNotOpenSociatyBattleMainView)
    then
        self.gameObject:SetActiveE(1)
        self:ShowOrHideScene(true)
    end
