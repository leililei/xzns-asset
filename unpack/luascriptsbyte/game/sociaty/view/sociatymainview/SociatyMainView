function SociatyMainView:OnUIOpened(name)
    if not windowsList[name] then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    if self.parent then
        local window = _G.UIManager:GetInstance():GetWindow(name)
        window.gameObject:SetParentE(self.parent)
        if
        name == uiCfg.SociatyBuildView.Name or name == uiCfg.SociatyDonateView.Name or
            name == uiCfg.SociatyActivityView.Name or
            name == uiCfg.GamePlayDescribeView.Name or
            name == uiCfg.SociatyWitchTrialsView.Name or
            name == uiCfg.SociatyProfoundView.Name
        then
            --不需要左上角显示公会基本信息的
            _G.UIManager:GetInstance():ChangeCanvasOrder(name, 250)
        else
            --需要左上角显示公会基本信息的
            _G.UIManager:GetInstance():ChangeCanvasOrder(name, 200)
        end
    end
    if name == uiCfg.SociatyGloryTopView.Name or name == uiCfg.SociatyActivityView.Name then
        self:ShowOrHideScene(false)
    end
end

