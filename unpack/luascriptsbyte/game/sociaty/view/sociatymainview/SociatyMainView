---更新UIspine人员显示(弃用)
---@return void
function SociatyMainView:InitUIRoleModel()
    if not self.roleModels then
        self.roleModels = {}
    end
    --没有任何数据, 清空模型
    if _G.table.isEmptyOrNil(self.memberList) then
        for i = 1, 5 do
            local model = self.roleModels[i]
            if model then
                self.roleModels[i] = nil
                _G._G.PoolsManager:GetInstance():Despawn(model, _G.ePoolType.Temporary)
            end
            ---@type UnityEngine.GameObject
            local parent = self.go_table["obj_pos" .. i]
            parent:SetActiveE(0)
            parent:SetName("0")
        end
        return
    end

    --开始加载模型
    local loadingId = "loadid_" .. math.random()
    self.roleLoadingId = loadingId --异步加载限制
    for i = 1, 5 do
        ---@type UnityEngine.GameObject
        local parent = self.go_table["obj_pos" .. i]
        local uid = 0
        if self.memberList[i] then
            uid = self.memberList[i].Style or uid
        end
        --如果模型未加载或sid不一致, 则重新进行加载
        if parent:GetName() ~= _G.tostring(uid) then
            local model = self.roleModels[i]
            if model then
                self.roleModels[i] = nil
                _G._G.PoolsManager:GetInstance():Despawn(model, _G.ePoolType.Temporary)
            end
            parent:SetActiveE(0)

            ---@type CardData
            local cardData = uid > 0 and _G.ConfigManager.card_cfg[uid] or nil
            if cardData then
                self.go_table["aortext_name" .. i].text = self.memberList[i].Name
                self.go_table["aortext_pos" .. i]:SetActiveE(
                    self.memberList[i].Location <= require "MemberEnum".ELocationEnum.Elder and 1 or 0
                )
                self.go_table["obj_light" .. i]:SetActiveE(
                    self.memberList[i].Location == require "MemberEnum".ELocationEnum.Chairman and 1 or 0
                )
                self.go_table["aortext_pos" .. i].text = _G.GetLangPackValue(
                    require("SociatyModel"):GetInstance():GetLocationLanguage(self.memberList[i].Location)
                )
                parent:SetActiveE(1)
                local filpX = (i == 2 or i == 5) and -1 or 1 --是否需要翻转x轴
                local scale = cardData.size4
                _G._G.PoolsManager:GetInstance():Spawn(
                    cardData.ModelPathHi,
                    _G.ePoolType.Temporary,
                    parent,
                    function(trans)
                        if trans == nil then
                            if _G.AppSetting.DEBUG then
                                _G.LogError("角色模型加载失败, 角色sid=" .. uid .. ", 路径=" .. cardData.ModelPathHi)
                            end
                            return
                        end
                        if _G.IsNil(self.gameObject) or self.roleLoadingId ~= loadingId then
                            _G._G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                            return
                        end
                        trans:SetLocalScale(filpX * scale, scale, scale)
                        trans:SetLocalPosition(42, -4, 0)
                        trans:SetSiblingIndexE(2)
                        parent:SetName(_G.tostring(uid))
                        parent:SetActiveE(1)
                        self.roleModels[i] = trans
                    end
                )
            else
                parent:SetName("0")
            end
        end
    end
end

