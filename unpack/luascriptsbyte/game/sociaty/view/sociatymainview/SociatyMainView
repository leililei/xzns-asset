function SociatyMainView:InitScene()
    _G.GameUtil.ReBuildRTF(self.go_table.rect_moveRoot)
    self.Role = {}
    self.RoleAni = {}
    self.sceneRoot = _G.GameObject("SociatyMainRoot")
    local path = "Scenes/Gonghuizhudi/prefabs/Gonghuizhudi"
    --_G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        function(trans)
            if _G.IsNil(self.sceneRoot) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:ChangeCameraAdaption()
            self.curSceneTrans = trans
            trans:SetLocalPositionToZero()
            _G.TimerManager:GetInstance():GetTimer(1, self.InitRoleModel, self, true, true):Start()
            _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
            --相机高度降低固定值
            self.camera = self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
            )

            --公会大厅 3.47 3.92
            --公会建设 6.24 8.86
            --公会试炼 8.42 4.17
            --公会奥义 7.3 -1.83
            --捐献 -0.99 9.36
            --名人堂 -0.62 5.12
            --公会纷争 -1.27 0.67
            _G.DelayFrameDo(
                function()
                    local posPath = "Scene/static/fbx_Gonghuizhudi_01/"
                    local obj
                    for i = 1, 8 do
                        obj = self.curSceneTrans:FindE(posPath .. i)
                        if obj and AppSetting.IsXzns == false then
                            local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(obj, self.go_table.rect_moveRoot)
                            self.builds[i]:SetAnchorPosition(x, y, 0)
                        end
                        self.builds[i]:SetActiveE(1)
                    end
                end
            )
        end
    )
end

function SociatyMainView:GetCameraMovement(go)
    local component = go:GetComponentE(_G.typeof(_G.CS.CameraMovement))
    if _G.IsNil(component) then
        component = go:AddComponentE(_G.typeof(_G.CS.CameraMovement))
    end
    return component
end

