function SociatyMainView:CreateRoleModel(index, isChairman)
    if index > 5 then
        return
    end
    local sid, name, god_halo
    if isChairman then
        if self.chairman then
            sid = self.chairman.Style
            name = self.chairman.Name
            god_halo = self.chairman.god_halo
        end
    else
        if self.memberList[index] then
            sid = self.memberList[index].Style
            name = self.memberList[index].Name
            god_halo = self.memberList[index].god_halo or 0
        end
    end
    if sid == nil then
        return
    end
    local path = CardInfoManager.GetBattleModelPath(sid, true)
    CardInfoManager.GetRole(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        _G.RoleEffTypeEnum.Fight,
        function(role)
            if self:IsNil() and sid ~= self.chairman.Style then
                _G.DestroyObject(role)
                return
            end
            self.curMemIndex[index] = index
            local line = (index + 1) // 2
            local area = isChairman and self.roleParams.cMoveArea[1] or self.roleParams.moveX[line]
            local isRight
            if isChairman then
                role:SetPosition(area[1], area[2], 0)
            else
                isRight = index % 2 == 1
                role:SetPosition(area, 0, isRight and -5 or 5)
            end
            role:SetLocalScaleXYZ(self.roleParams.scale)
            self.Role[index] = role
            self.RoleAni[index] = _G.RoleAnimatorController.GetOrCreateAnimatorController(role)
            local head = self:FindModelPoint(role)
            local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(head, self.go_table.rect_moveRoot)
            self.RoleTitle[index]:SetActiveE(1)
            self.RoleTitle[index]:SetLocalPosition(x, y + 50, 0)
            local tb = _G.GetAutoGoTable(self.RoleTitle[index])
            tb.aortext_name.text = name

            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                --- 暂时屏蔽此模型神环
                -- local godHaloID = god_halo
                -- local cfg = _G.ConfigManager.card_cfg[sid]
                -- if cfg == nil then
                --     cfg = _G.ConfigManager.card_cfg[_G.ConfigManager.skin_cfg[sid].card]
                -- end
                -- if godHaloID ~= 0 then
                --     local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                --     --- 神环路径，父级路径(加载角色的下面)
                --     _G.UIUtils.LoadGodHalo(effCfg, role, cfg.god_halo_set)
                -- end
            end

            -- if isChairman and self.chairman.OfflineTime > 0 then --会长离线
            if isChairman then
                --会长不动
                self:SetToward(index, true)
                if self.ChairmanRole then--如果已经生成了会长的模型就删掉之前生成的
                    _G.DestroyImmediate(self.ChairmanRole)
                end
                self.ChairmanRole = role
                self.oldChairmanRoleId = sid
                if not table.isEmptyOrNil(self.chairman.artifact_skin) then
                    _G.CS.BattleManager.Utils.UpdateArtifact(role,self.chairman.artifact_skin[1],self.chairman.artifact_skin[2])
                end
            else
                if AppSetting.IsXzns then
                    role:SetActiveE(0)
                    return
                end
                -- self:PlayMove(index, isChairman, isRight)
                if self.startTime[line] == nil then
                    self.startTime[line] = self:Random(self.roleParams.startTime[1], self.roleParams.startTime[2])
                end
                -- local isRight = _G.math.random(0, 1) == 0
                self:SetToward(index, isRight)
                _G.DelayDo(self.startTime[line], _G.handlerbind(self, self.PlayMove, index, isChairman, isRight))
            end
            self:CreateRoleModel(index + 1, false)
        end
    )
end

function SociatyMainView:PlayMove(index, isChairman, isRight)
    if self:IsNil() then
        return
    end
    -- 记录状态为跑步
    self.RoleState[index] = "run"
    self.RoleAni[index]:Play("run_1", true)
    local moveTime = self:Random(self.roleParams.moveTime[1], self.roleParams.moveTime[2])
    local moveDis = moveTime * self.roleParams.speed
    self:DoMoving(index, isChairman, isRight, moveDis)
end

function SociatyMainView:DoMoving(index, isChairman, isRight, lastDis)
    if self:IsNil() then
        return
    end
    local role = self.Role[index]
    local x, y, z = role:GetPosition()
    local z1
    if isRight then
        z1 = isChairman and self.roleParams.cMoveArea[1][3] or self.roleParams.moveArea[2]
    else
        z1 = isChairman and self.roleParams.cMoveArea[2][3] or self.roleParams.moveArea[1]
    end
    local dis = _G.math.abs(z1 - z)
    if lastDis > dis then
        --一次走不完，需调头
        local time = dis / self.roleParams.speed
        local xt, yt = _G.CS.UIUtils.WorldPointToLocalPointInRect(x, y, z1, self.go_table.rect_moveRoot)
        role:DOLocalMoveZ(z1, time):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
            function()
                self:UpdateRoleModel(index, not isRight, isChairman, lastDis - dis)
                -- self:SetToward(index, not isRight)
                -- self:DoMoving(index, isChairman, not isRight, lastDis - dis)
            end
        )
        self.RoleTitle[index]:DOLocalMoveX(xt, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    else
        local z2 = isRight and z + lastDis or z - lastDis
        local time = lastDis / self.roleParams.speed
        local xt, yt = _G.CS.UIUtils.WorldPointToLocalPointInRect(x, y, z2, self.go_table.rect_moveRoot)
        role:DOLocalMoveZ(z2, time):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
            function()
                self:PlayIdle(index, isChairman, isRight)
            end
        )
        self.RoleTitle[index]:DOLocalMoveX(xt, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    end
end

function SociatyMainView:PlayIdle(index, isChairman, isRight)
    if self:IsNil() then
        return
    end
    -- 记录状态为待机
    self.RoleState[index] = "idle"
    self.RoleAni[index]:Play("idle_1", true)
    local idleTime = self:Random(self.roleParams.idleTime[1], self.roleParams.idleTime[2])
    _G.DelayDo(idleTime, _G.handlerbind(self, self.PlayMove, index, isChairman, isRight))
end

function SociatyMainView:Random(a, b)
    return a + (b - a) * _G.math.random()
end

function SociatyMainView:SetToward(index, isRight)
    if isRight then
        self.Role[index]:SetLocalEulerAngles(0, 0, self.angle)
    else
        self.Role[index]:SetLocalEulerAngles(0, 180, -self.angle)
    end
end

---销毁/创建新模型
function SociatyMainView:UpdateRoleModel(index, isRight, isChairman, lastDis)
    if self:IsNil() then
        return
    end
    local memIndex = self:GetNextMemberIndex(index)
    if memIndex == index then
        --无可更换
        self:SetToward(index, isRight)
        self:DoMoving(index, isChairman, isRight, lastDis)
        return
    end
    _G.DestroyObject(self.Role[index])
    self.Role[index] = nil
    local sid = self.memberList[memIndex].Style
    local name = self.memberList[memIndex].Name
    local path = CardInfoManager.GetBattleModelPath(sid, true)
    self.curMemIndex[index] = memIndex
    CardInfoManager.GetRole(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        _G.RoleEffTypeEnum.Fight,
        function(role)
            if self:IsNil() then
                _G.DestroyObject(role)
            end
            local line = (index + 1) // 2
            local area = self.roleParams.moveX[line]
            role:SetPosition(area, 0, isRight and self.roleParams.moveArea[1] or self.roleParams.moveArea[2])
            role:SetLocalScaleXYZ(self.roleParams.scale)
            self.Role[index] = role
            self.RoleAni[index] = _G.RoleAnimatorController.GetOrCreateAnimatorController(role)
            local head = self:FindModelPoint(role)
            local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(head, self.go_table.rect_moveRoot)
            self.RoleTitle[index]:SetActiveE(1)
            self.RoleTitle[index]:SetLocalPosition(x, y + 50, 0)
            local tb = _G.GetAutoGoTable(self.RoleTitle[index])
            tb.aortext_name.text = name
            self:SetToward(index, isRight)
            self:PlayMove(index, isChairman, isRight)
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(sid)
                if godHaloID ~= 0 then
                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                    --- 神环路径，父级路径(加载角色的下面)
                    _G.UIUtils.LoadGodHalo(effCfg, role, godHaloID)
                end
                _G.UIUtils.LoadArtifacteffect(role,sid,nil,nil)
            end
        end
    )
end

function SociatyMainView:GetNextMemberIndex(index)
    local sum = #self.memberList
    if sum <= 5 then
        return index
    end
    local ready = {}
    local num = 0
    for i = 1, sum do
        if not _G.table.ContainsValue(self.curMemIndex, i) then
            _G.table.insert(ready, i)
            num = num + 1
        end
    end
    return ready[_G.math.random(1, num)]
end

function SociatyMainView:GetCameraAngleX()
    ---@type UnityEngine.Camera
    local mainCamera
    if _G.CS.FrameWork.Graphic.GraphicsManager.Instance then
        mainCamera = _G.CS.FrameWork.Graphic.GraphicsManager.Instance.MainCamera
    end
    return _G.CS.CameraUtils.GetCameraAngleX(mainCamera)
end

function SociatyMainView:FindModelPoint(trans, forceUpdate)
    local rp = trans:GetComponentInChildrenE(_G.typeof(_G.CS.SkeletonBoneReferences))
    if not rp then
        return nil
    end
    local node = rp:Get("Point_Hp")
    if not _G.IsNil(node) then
        rp:ForceUpdate(1) --立即同步一次骨骼位置
        return node
    end
    local node = rp:Get("Point_Head")
    if not _G.IsNil(node) then
        rp:ForceUpdate(1) --立即同步一次骨骼位置
        return node
    end
    return nil
end

function SociatyMainView:ShowOrHideScene(show)
    if self.sceneRoot then
        self.sceneRoot:SetActiveE(show and 1 or 0)
        if show then
            -- 延迟确保Animator已激活
            _G.DelayDo(
                0.01,
                function()
                    if not _G.TableIsEmpty(self.RoleAni) then
                        for index, controller in ipairs(self.RoleAni) do
                            if controller and not _G.IsNil(controller) then
                                -- 确保Animator初始化
                                self.RoleAni[index]:UpdateAnimator()
                                if self.RoleState[index] == "run" then
                                    self.RoleAni[index]:PlayForce("run_1", true)
                                elseif self.RoleState[index] == "idle" then
                                    self.RoleAni[index]:PlayForce("idle_1", true)
                                end
                            end
                        end
                    end
                end
            )
        end
    end
end

function SociatyMainView:OnUIClosed(name)
    local isNotOpenSociatyBattleMainView = _G.UIManager:GetInstance():IsActiveWindow(_G.ConfigManager.ui_cfg.SociatyBattleMainView.Name) == false
