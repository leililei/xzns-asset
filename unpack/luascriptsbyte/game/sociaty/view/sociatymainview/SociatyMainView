function SociatyMainView:RefreshRoleSpine()
    if self.oldChairmanRoleId then
        self.SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
        self.memberModel = self.SociatySelf.GetMemberModule()
        self.memberModel:SortMemberByView()
        self.memberList = {}
        local locationEnum = require "MemberEnum".ELocationEnum
        for _, v in pairs(self.memberModel.Member) do
            if v.Location == locationEnum.Chairman then
                self.chairman = v
            else
                _G.table.insert(self.memberList, v)
            end
        end
        _G.SortList(
            self.memberList,
            function(a)
                return a.OfflineTime == 0 and 1 or 0, -a.Location, a.Power
            end
        )
        if self.oldChairmanRoleId ~= self.chairman.Style then
            DestroyObject(self.ChairmanRole)
            self.ChairmanRole = nil
            self.oldChairmanRoleId = nil
            self:CreateRoleModel(0, true)
        end
    end
end

---初始化特效及按钮
function SociatyMainView:InitBtns()
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end

    local key = "SociatyMainView"
    for _, v in pairs(funcBtnList) do
        local tb = _G.GetAutoGoTable(self.go_table[v])
        --local lock = tb.obj_suo:GetComponentE(typeof(CS.UnityEngine.Animator))
        --lock.enabled = false
        local isLock, str = false, nil
        if v == "aorbtn_guide" then
            isLock, str = require "SociatyManager".CheckGuideIsLock()
            tb.obj_mask:SetActiveE(isLock and 1 or 0)
            tb.aortext_lock.text = str
        elseif v == "aorbtn_shop" then
            --公会奥义
            isLock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SociatyProfound)
            tb.obj_mask:SetActiveE(isLock and 1 or 0)
            tb.aortext_lock.text = isLock and _G.FunctionManager:GetInstance():GetTipsStr(_G.FunctionID.SociatyProfound) or ""
        elseif v == "aorbtn_newShop" then
            ---旅行商人
            isLock = not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SociatyShop)
            tb.obj_mask:SetActiveE(0)
            -- tb.aortext_lock.text = isLock and _G.FunctionManager:GetInstance():GetTipsStr(_G.FunctionID.SociatyShop) or ""
            if isLock then
                tb.aortext_time.text = ""
            else
                self.sociatyShopTb = tb
                self:RefreshSociatyShopTimer()
            end
        else
            tb.obj_mask:SetActiveE(0)
        end
        if not isLock and _G.PlayerPrefsManager.GetInt(key .. v, 0) == 0 then
            _G.PlayerPrefsManager.SetInt(key .. v, 1)
            tb.obj_mask:SetActiveE(1)
            --lock.enabled = true
            _G.DelayDo(
                0.5,
                function()
                    tb.obj_mask:SetActiveE(0)
                end
            )
        end
        if v == "aorbtn_fenzheng" then
            self.ItemShow = tb.aortext_show
            self.ItemGuess = tb.obj_guessIcon
            self:UpdateSociatyIcon()
        end
    end

    for i = 1, 8 do
        self.builds[i]:SetActiveE(0)
    end
end

---公会商店倒计时
function SociatyMainView:RefreshSociatyShopTimer()
    if self.shopTimer then
        self.shopTimer:Stop()
        self.shopTimer = nil
    end
    self.shopStartTime, self.shopEndTime = require("SociatyShopModel"):GetInstance():GetTime()
    self.shopTimer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshShopTime, self, false, false)
    self.shopTimer:Start()
    self:RefreshShopTime()
end

function SociatyMainView:RefreshShopTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime > self.shopEndTime then
        self:LoadSociatyShopSpine()
        self.shopStartTime, self.shopEndTime = require("SociatyShopModel"):GetInstance():GetTime()
    end
    if serverTime <= self.shopStartTime then
        self.sociatyShopTb.aortext_time.text = _G.TimeUtil.TimeToString(self.shopStartTime - serverTime, 1)
    else
        self.sociatyShopTb.aortext_time.text = _G.TimeUtil.TimeToString(self.shopEndTime - serverTime, 1)
    end
end

---地精商人
function SociatyMainView:LoadSociatyShopSpine()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    self.shopStartTime, self.shopEndTime = require("SociatyShopModel"):GetInstance():GetTime()
    if serverTime >= self.shopStartTime and serverTime < self.shopEndTime then
        self.showShopSpine = true
    else
        self.showShopSpine = false
    end

    if not self.shopSpine then
        self.shopSpine = self.curSceneTrans:FindE("Scene/static/wujian/prf_Dijinshangren")
    end
    self.shopSpine:SetActiveE(self.showShopSpine and 1 or 0)
end

---刷新公会战图标
function SociatyMainView:UpdateSociatyIcon()
    if self.ItemShow then
        self.ItemShow:SetActiveE(0)
        local SociatyModel = require "SociatyModel":GetInstance()
        local SociatyBattleModel = require "SociatyBattleModel":GetInstance()
        local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel":GetInstance()
        if not SociatyBattleLeagueModel.SociatyUpdate then
            SociatyBattleLeagueModel.SociatyUpdate = _G.handler(self, self.UpdateSociatyIcon)
        end
        local state = SociatyBattleModel:GetState()
        local isShow = false
        if SociatyBattleModel.enemySociatyBattleData and SociatyBattleModel.mySociatyBattleData then
            if state == _G.SociatyBattleState.Battle then
                if SociatyModel:GetTargetActivityTimes(_G.ScoaityActivityType.SociatyBattle) > 0 then
                    isShow = require "SociatyBattleManager":GetInstance():CheckTime12()
                end
            end
        end

        local isShowLeague = false
        if SociatyBattleLeagueModel.IsLeagueOpen then
            if not self.LeagueModel then
                self.LeagueModel = SociatyBattleLeagueModel
            end
            state = self.LeagueModel:GetState()
            if state == _G.SociatyBattleLeagueState.Battle then
                if self.LeagueModel.enemySociatyBattleData and self.LeagueModel.mySociatyBattleData then
                    if SociatyModel:GetTargetActivityTimes(_G.ScoaityActivityType.SociatyBattleLeague) > 0 then
                        isShowLeague = require "SociatyBattleLeagueManager":GetInstance():CheckTime12()
                    end
                end
            end
            if state == _G.SociatyBattleLeagueState.Guess then
                local canGuess = self.LeagueModel:CheckCanGuess(0) or self.LeagueModel:CheckCanGuess(1)
                self.ItemGuess:SetActiveE(canGuess and 1 or 0)
            end
        end

        local isJoin = SociatyBattleLeagueModel.IsJoin

        self.ItemShow:SetActiveE((isShow or (isShowLeague and isJoin)) and 1 or 0)
    end
end

