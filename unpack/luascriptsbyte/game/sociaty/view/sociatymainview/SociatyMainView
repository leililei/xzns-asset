function SociatyMainView:InitRoleModel()
    self.RoleState = {} -- 每个角色的当前状态
    self.angle = self:GetCameraAngleX()
    self.curMemIndex = {}
    self.startTime = {}
    self:CreateRoleModel(0, true)
