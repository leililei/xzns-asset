---
function SociatyWitchTrialsView:CurBox()
    local fight_times = self.feastData.fight_times
    local count = 0
    local tb = _G.GetAutoGoTable(self.go_table.obj_isOn)
    self.go_table.obj_boxLight:SetActiveE(SociatyModel:GetInstance():CheckHaveBox() and 1 or 0)
    for i = 1, #self.Boxcondition do
        local need = self.Boxcondition[i].materials[2]
        if fight_times >= need then
            tb["aorimage_progress" .. i]:SetActiveE(1)
            count = i
        end
    end
    return count + 1 > 5 and 5 or count + 1
end

function SociatyWitchTrialsView:BoxClick(go)
    local name = go:GetName()
    local GetAwardList = {fid = {}}
    local GetIndexList = {}
    local clickIndex = 0
    for i = 1, 5 do
        if not self.getFoodIndex[i] and self.feastData.fight_times >= self.Boxcondition[i].materials[2] then
            _G.table.insert(GetAwardList.fid,self.Boxcondition[i].id)
            _G.table.insert(GetIndexList,i)
        end
        if name == "@_aorbtn_btn" .. i then
            clickIndex = i
        end
    end
    if #GetAwardList.fid >= 1 then
        require "SociatyNet":GetInstance():GetFeastAward(
            GetAwardList,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                for _, i in pairs(GetIndexList) do
                    self.getFoodIndex[i] = i
                    SociatyModel:GetInstance():RemoveHadBox(i)
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    msg
                )
                self:SetBoxProgress()
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.GuildchallengeButton.id
                )
            end
        )
    else
        self:ShowItems(clickIndex, self.feastData.fight_times >= self.Boxcondition[clickIndex].materials[2], go)
    end
end

function SociatyWitchTrialsView:SetBoxProgress()
    local tb = _G.GetAutoGoTable(self.go_table.obj_isOff, _G.handler(self, self.BoxClick))
    --宝箱图片
    for i = 1, #self.Boxcondition do
        local data = self.Boxcondition[i]
        tb["aorimage_awardBox" .. i].SpriteName = data.icon
        tb["aortext_num" .. i].text = data.materials[2]
        _G.GameUtil.SetActiveByCondition(tb["aorimage_get" .. i], self.getFoodIndex[i] ~= nil)
        tb["obj_eff" .. i]:RemoveAllChildren()
        if not self.getFoodIndex[i] and self.feastData.fight_times >= self.Boxcondition[i].materials[2] then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                tb["obj_eff" .. i],
                function(obj)
                    if self:IsNil() then
                        _G.DestroyObject(obj)
                        return
                    end
                    obj:SetLocalPositionToZero()
                end
            )
        end
    end

    local curProgress = self:CurBox()
    local lastNeed = 0
    if curProgress > 1 then
        lastNeed = self.Boxcondition[curProgress - 1].materials[2]
    end
    local need = self.Boxcondition[curProgress].materials[2]
    --self.go_table.aortext_boxname.text = _G.LangUtil.GetLangPackValue(self.Boxcondition[curProgress].name)
    self.go_table.aorimage_box.SpriteName = self.Boxcondition[curProgress].icon
    self.go_table.aortext_progress.text = self.feastData.fight_times .. "/" .. need ---改为显示总进度，策划接受文本超框
    --_G.LangUtil.GetLangPackValue(90021800179, )
    self:SliderProgress(curProgress, self.feastData.fight_times - lastNeed, need - lastNeed)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.GuildchallengeButton.id
    )
end

function SociatyWitchTrialsView:SliderProgress(level, now, need)
    if level == 1 then
        self.go_table.slider_boxprogress.value = 0.13 + (0.22 / need) * now
    else
        self.go_table.slider_boxprogress.value = 0.35 + (0.15 / need) * now + 0.15 * (level - 2)
    end
end

---展示公会试炼排行页面
function SociatyWitchTrialsView:ShowWitchTrialsRankView()
    local model = require("SociatyModel"):GetInstance()

    local CommonRankDataOfSociatyWitchTrials = require("CommonRankDataOfSociatyWitchTrials")
    local ranks = CommonRankDataOfSociatyWitchTrials.ParseRanks(model.SociatySelf.WitchTrialsRankList)
    local selfRankIndex = model.SociatySelf:GetMyRank()
    local selfRank = selfRankIndex >= 1 and ranks[selfRankIndex] or
        CommonRankDataOfSociatyWitchTrials.ParseSelfRank(selfRankIndex, 0)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonRankDefaultView.Name,
        {
            title = 90021800374,
            ranks = ranks,
            selfRank = selfRank,
            ---@param member CommonRankDataOfSociatyWitchTrials
            playback = function(member)
                model:GetWitchTrialsPlayback(member.role.uid, function(msg)
                    if not msg or msg.ack ~= 1 then
                        return
                    end
                    local leftName, rightName = member.role.name, _G.GetLangPackValue(90021800374)
                    --展示统计面板
                    local record = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.arg)
                    local statisticsData, winner = _G.GameUtil.ShowStatisticsView(record)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
                        statisticsData,
                        winner,
                        nil,
                        nil,
                        nil,
                        nil,
                        true,
                        msg.arg,
                        nil,
                        nil,
                        nil,
                        nil,
                        nil,
