    self.go_table.aortext_changllenge.text = self.curTimes == 0 and _G.GetLangPackValue(90033100042) or _G.GetLangPackValue(90023300047)
end

---按钮点击事件在这里派发
function SociatyWitchTrialsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_clickSociatyIcon then
        local SociatyData = SociatyModel:GetInstance().SociatySelf
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyExchangeIconView.Name,
            SociatyData,
            true,
            SociatyData.Banner,
            function(data)
                if data and data.ID ~= SociatyData.Banner then
                    ---@type guild.c2s_guild_set_banner
                    local msg = {}
                    msg.banner = data.ID
                    local SociatyNet = require("SociatyNet")
                    SociatyNet:GetInstance():SetBanner(
                        msg,
                        function()
                            SociatyModel:GetInstance().SociatySelf.Banner = data.ID
                            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeIcon, data.ID)
                            _G.PopWindowManager:GetInstance():ShowAllTips(200116)
                        end
                    )
                end
            end
        )
    elseif go == self.go_table.aorbtn_members then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WitchTrialsRank.Name)
    elseif go == self.go_table.aorbtn_box then
        -- require "SociatyNet":GetInstance():GetFeastInfo(
        --     function(data)
        --         _G.UIManager:GetInstance():OpenWindow(
        --             _G.ConfigManager.ui_cfg.WitchTrialsBoxDetail.Name,
        --             function(data)
        --                 self.go_table.obj_boxLight:SetActiveE(0)
        --                 for k, v in pairs(data) do
        --                     _G.table.insert(self.feastData.get_foods, v)
        --                 end
        --             end,
        --             data
        --         )
        --     end
        -- )
    elseif go == self.go_table.aorbtn_changllenge then
        if SociatyModel:GetInstance():CheckBattleTime() then
            self:OnChangllenge()
        end

    elseif go == self.go_table.aorbtn_sweep then
        if SociatyModel:GetInstance():CheckBattleTime() then
            self:OnSweep()
        end
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 17)
    elseif go == self.go_table.toggle_sweepAll then
        _G.PlayerPrefsManager.SetInt(SweepAllKey, isOn and 1 or 0)
    elseif go == self.go_table.aorbtn_TipsView then
        if self.NowShowIndex == nil then
            return
        end
        self:ShowItems(self.NowShowIndex, false)
    elseif go == self.go_table.aorbtn_rankDetail then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonRankTopView.Name, 22)
        local model = require("SociatyModel"):GetInstance()
        SociatyModel:GetInstance():InitYHModel(function(msg)
            if not model.SociatySelf then
                return
            end
            model.SociatySelf:GetRankList(msg.feast_info)
            self:ShowWitchTrialsRankView()
        end)
    elseif go == self.go_table.aorbtn_rank then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyDamageRankView.Name, self.DamageRankList)
    end
end

function SociatyWitchTrialsView:ShowItems(Index, isGou, btn)
    if Index == self.NowShowIndex and self.go_table.aorbtn_TipsView:GetActiveSelf() == 1 then
        self.go_table.aorbtn_TipsView:SetActiveE(0)
        return
    end

    if btn ~= nil then
        local x, y, z = btn:GetPosition()
        self.go_table.obj_ItemTips:SetPosition(x, y, z)
        --- 根据按钮 设置坐标
        -- self:BoxTipSetPos(self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)), {x, y + 1, z})
    end

    local data = self.Boxcondition[Index]
    if data == nil then
        return
    end
    self.NowShowIndex = Index

    if self.go_table.aorbtn_TipsView:GetActiveSelf() == 0 then
        self.go_table.aorbtn_TipsView:SetActiveE(1)
    end

    self.go_table.obj_Parent:ClearChildren()
    for i = 1, #data.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.reward[i],
            self.go_table.obj_Parent,
            function(item)
                item.gameObject:SetRectTransformSize(88, 88)
                item.gameObject:SetLocalScaleXYZ(0.65)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                item:SetGou(isGou)
            end
        )
    end
    ---@type UnityEngine.RectTransform
    local rect = self.go_table.obj_itemBg:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    rect:SetRectTransformSize((#data.reward) * 75, 80)
end

---挑战
function SociatyWitchTrialsView:OnChangllenge()
    if self.curTimes <= 0 then
        _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
            831,
            function()
                SociatyModel:GetInstance():OnChallenge(1, true)
            end,
            nil,
            nil,
            true
        )
        return
    end
    if _G.MainManager:GetInstance():IsFighting(true) then
        return
    end
    self.isChangllenge = true
    SociatyModel:GetInstance():OnChallenge(1)
end

---扫荡
function SociatyWitchTrialsView:OnSweep()
    if self.curTimes <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(250116)
        return
    end
    if self.feastData.dps < 0 then
        return
    end
    -- if not _G.GlobalConditionManager.CheckCondition(4, _G.ConfigManager.discrete_cfg[102802][1][1]) then
    --
    if _G.AppSetting.DEBUG then
        _G.Log("", "<color=red>" .. "需要解锁1-1" .. "</color>")
    end
    --     return
    -- end
    local num = self.go_table.toggle_sweepAll.isOn and self.curTimes or 1
    local msg = { boss_id = 1, sweep_num = num }
    require("SociatyNet"):GetInstance():SweepBossFight(
        msg,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            SociatyModel:GetInstance().SociatySelf:RefreshRankList()
            self:RefreshRankList()
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self.curTimes = self.curTimes - num
            self.feastData.challenge_times = self.feastData.challenge_times + num
            self.feastData.fight_times = self.feastData.fight_times + num
            _G.Events:GetInstance():Broadcast(_G.FunctionOpenDailyCheckEvent.GuildTrain)
            SociatyModel:GetInstance():CreateUnopenedBox()
            SociatyModel:GetInstance():UpdateSociatyYHNum(self.curTimes)
            self:SetFightNumView()
            self:SetBoxProgress()
        end
    )
end

