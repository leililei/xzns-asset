function SociatyWitchTrialsView:InitProgress()
    self.Boxcondition = {}
    --self.go_table.obj_isOn:SetActiveE(1)
    local insert = _G.table.insert
    for _, v in pairs(self.cfg.feast) do
        insert(self.Boxcondition, self.feastCfg[v])
    end
