function SociatyWitchTrialsView:InitData(data)
    if data.ack ~= 1 or _G.IsNil(self.go_table) then
        self:Close()
        return
    end
    self.feastData = data.feast_info
    self.ranklist = SociatyModel:GetInstance().SociatySelf:GetRankList(data.feast_info)
    self:InitRankList()
    if _G.table.isEmptyOrNil(self.feastData.get_foods) then
        self.feastData.get_foods = {}
    end
    local isOpen = self.feastData.dps > _G.ConfigManager.guild_boss_reward_cfg[1].damage and
        require "AfkModel":GetInstance():CheckSectionIsPass(_G.ConfigManager.discrete_cfg[102802][1][1])
    self.go_table.obj_sweep:SetActiveE(isOpen and 1 or 0)
    local params = _G.ConfigManager.discrete_cfg[sweepAllId]
    if not _G.GlobalConditionManager.CheckConditionArrays(params) then
        self.go_table.toggle_sweepAll.enabled = false
        ---@type afk_cfg
        local cfg = _G.ConfigManager.afk_cfg[params[1][2]]
        --self.go_table.aortext_togDesc.text = GetLangPackValue(LanguageIds.UnLockSweepAll, cfg.chapter, cfg.section)
        self.go_table.toggle_sweepAll:SetActiveE(0)
    else
        -- self.go_table.aortext_togDesc.text = GetLangPackValue(LanguageIds.SweepAll)
        self.go_table.toggle_sweepAll.enabled = true
        self.go_table.toggle_sweepAll:SetActiveE(1)
    end
    self.go_table.toggle_sweepAll.isOn = _G.PlayerPrefsManager.GetInt(SweepAllKey, 0) == 1
    local level = SociatyModel:GetInstance().SociatySelf.Level
    self.cfg = _G.ConfigManager.guild_level_cfg[level]
    self.feastCfg = _G.ConfigManager.guild_feast_cfg
    self.maxTimes = _G.ConfigManager.discrete_cfg[102801][1][1]
    local vipData = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.VIP.GongHui_Boss })
    if not _G.table.isEmptyOrNil(vipData) then
        self.maxTimes = self.maxTimes + vipData[1]
    end

    --self.curSequence = self:GetCurSequence()
    self.curTimes = self.maxTimes - self.feastData.challenge_times
    self:SetFightNumView()
    -- self:InitFeastData(level)
    -- self:InitView()
    SociatyModel:GetInstance():UpdateSociatyYHNum(self.curTimes)
    self:InitProgress()
    self:InitReward()
    self:SetBossSkill()
end

