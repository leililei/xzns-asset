---界面的入口函数
function SociatyWitchTrialsView:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyWitchTrialsView, self.go_table)
    SociatyModel:GetInstance():InitYHModel(_G.handler(self, self.InitData))
    --require "SociatyNet":GetInstance():GetFeastInfo(_G.handler(self, self.InitData))
    self:SetAward()

    self:InitInfoView()
    self:UpdateLevelView()
    self:AddListener(_G.eSociatyEvent.ExchangeIcon, self.InitInfoView)
    self:AddListener(_G.eSociatyEvent.ExchangeName, self.InitInfoView)
    self:AddListener(_G.eSociatyEvent.ExchangeNotice, self.InitInfoView)
    self:AddListener(_G.eSociatyEvent.MemberRefresh, self.InitInfoView)
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.InitInfoView)

    self:AddListener(_G.eSociatyEvent.ExchangeNotice, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeName, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeIcon, self.RefreshPanel)
    self:RefreshPanel()
    self:SetBossSpine()
    self:SetDamageRankList()
end

---
---@protected
function SociatyWitchTrialsView:SetDamageRankList()
    require("SociatyNet"):GetInstance():GetGuildDamageRankList(
        function(data)
            self.DamageRankList = data.guilds or {}
            local uid = SociatyModel:GetInstance().SociatySelf.Uid
            local selfRankNum
            for k, v in ipairs(self.DamageRankList) do
                if v.uid == uid then
                    selfRankNum = k
                    break
                end
            end
            local isRank = selfRankNum == nil or selfRankNum > _G.ConfigManager.discrete_cfg[124502][1][1]
            self.go_table.aortext_rankNil:SetActiveE(isRank and 1 or 0)
            self.go_table.aortext_rankNum:SetActiveE(isRank and 0 or 1)
            if selfRankNum then
                self.go_table.aortext_rankNum.text = selfRankNum
            end
        end
    )
end

function SociatyWitchTrialsView:InitInfoView()
    self.SociatySelf = SociatyModel:GetInstance().SociatySelf
    self.memberModel = self.SociatySelf.GetMemberModule()
    self.memberModel:SortMemberByView()
    self.memberList = {}
    local locationEnum = require "MemberEnum".ELocationEnum
    for _, v in pairs(self.memberModel.Member) do
        if v.Location == locationEnum.Chairman then
            self.chairman = v
        else
            _G.table.insert(self.memberList, v)
        end
    end
    _G.SortList(
        self.memberList,
        function(a)
            return a.OfflineTime == 0 and 1 or 0, -a.Location, a.Power
        end
    )
    self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[self.SociatySelf.Banner].portrait)
    self.go_table.aortext_sociatyName.text = self.SociatySelf.Name
    self.go_table.aortext_memberNum.text = self.SociatySelf.SociatyMemberModule:GetMemberDesc()
end

---更新等级信息
function SociatyWitchTrialsView:UpdateLevelView()
    local level = self.SociatySelf:GetMasterBuildLevel()
    local exp, needExp = self.SociatySelf:GetBuildExp(self.SociatySelf:GetMasterBuildId())

    self.go_table.aortext_level.text = tostring(level)
    if needExp == 0 then
        self.go_table.aortext_exp.text = _G.GetLangPackValue(9002050021)
    else
        self.go_table.aortext_exp.text = _G.string.format("%s/%s", exp, needExp > 0 and needExp or exp)
    end
    self.go_table.slider_progress.value = needExp > 0 and exp / needExp or 1
end

function SociatyWitchTrialsView:SetAward()
    require "SociatyNet":GetInstance():GetFeastInfo(
        function(data)
            if data.ack ~= 1 then
                return
            end
            local foods = data.feast_info.get_foods or {}
            for k, v in pairs(foods) do
                self.getFoodIndex[v] = v
            end
            self:SetBoxProgress()
        end
    )
end

function SociatyWitchTrialsView:SetBossSpine()
    _G.UIUtils.RemoveChildren(self.go_table.obj_role)
    if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.SociatyWitchTrialsView, "obj_role") then
        local path = _G.ConfigManager.card_cfg[150050000].ModelPathHi
        _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_role,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                    trans:SetLocalScaleXYZ(0.38)
                end
        )
    end

end

