--region
function SociatyWitchTrialsView:InitRankList()
    if not self.ranktb then
        self.ranktb = _G.GetAutoGoTable(self.go_table.obj_littleZonePanel)
    end
    local count = #self.ranklist
    count = count > 3 and count or 3
    if self.RankScroll then
        if self.rankCount == count then
            self.RankScroll:UpdateAllItem()
        else
            self.RankScroll:UpdateCount(count)
            self.rankCount = count
        end
    else
        self.ranktb.scrollloopvectical_rank:InitItemData(count, _G.handler(self, self.InitRankItem))
        self.RankScroll = self.ranktb.scrollloopvectical_rank
        self.rankCount = count
    end
    local myrank = SociatyModel:GetInstance().SociatySelf:GetMyRank()
    if myrank > 0 then
        self.ranktb.aortext_rank.text = myrank
    else
        self.ranktb.aortext_rank.text = _G.GetLangPackValue(90022900040)
    end
end

function SociatyWitchTrialsView:InitRankItem(index, trans)
    index = index + 1
    local tb = _G.GetAutoGoTable(trans)
    if index <= 3 then
        tb.aorimage_rank:SetActiveE(1)
        tb.aortext_rank:SetActiveE(0)
        tb.aorimage_rank.SpriteName = rankIcon[index]
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == index and 1 or 0)
        end
    else
        tb.aorimage_rank:SetActiveE(0)
        tb.aortext_rank:SetActiveE(1)
        tb.aortext_rank.text = index
    end
    tb.aortext_name:SetActiveE(#self.ranklist >= index and 1 or 0)
    tb.aortext_no:SetActiveE(#self.ranklist >= index and 0 or 1)
    if #self.ranklist >= index then
        tb.aortext_name.text = self.ranklist[index].role.Name
    end
end

function SociatyWitchTrialsView:RefreshRankList()
    self.ranklist = SociatyModel:GetInstance().SociatySelf.WitchTrialsRankList
    self:InitRankList()
end

--endregion

return SociatyWitchTrialsView
