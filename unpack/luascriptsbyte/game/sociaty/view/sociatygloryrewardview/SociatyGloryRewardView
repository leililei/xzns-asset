local ELocationEnum = require("MemberEnum").ELocationEnum

---@class SociatyGloryRewardView : UIBaseView	公会奖励视图
---@field go_table SociatyGloryRewardView_GoTable
local SociatyGloryRewardView = _G.BaseClass("SociatyGloryRewardView", _G.UIBaseView)

function SociatyGloryRewardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
end
function SociatyGloryRewardView:OnDestroy()
    self:RemoveAllListener()
end

function SociatyGloryRewardView:OnCreate()
    self:InitBaseRewards()
    self:InitJobRewards()

    self:UpdateStates()
end
---监听被踢出公会
function SociatyGloryRewardView:OnBeKicked()
    self:Close()
end

---初始化状态
function SociatyGloryRewardView:UpdateStates()
    --今日是否已领取工资
    local isGet = require("SociatyModel"):GetInstance():IsGetReward()

    self.go_table.obj_claimed:SetActiveE(isGet and 1 or 0)
    self.go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
end
---初始化公会基础福利
---@return void
function SociatyGloryRewardView:InitBaseRewards()
    local model = require("SociatyModel"):GetInstance()
    --公会福利加成(百分比)
    local percentage = 0
    local unitCfg = _G.ConfigManager.guild_unit_cfg[model:GetMasterBuildId()]
    if unitCfg then
        local privilege = unitCfg.privilege[model:GetMasterBuildLevel()]
        if privilege then
            for i = 1, #privilege, 2 do
                if privilege[i] == 1 then --1为公会福利加成类型
                    percentage = privilege[i + 1] * 0.0001
                end
            end
        end
    end
    self.go_table.aortext_privilege.text = _G.GetLangPackValue(90021800420, _G.math.floor(percentage * 100) .. "%")
    --读取配置表
    local cfg = _G.ConfigManager.discrete_cfg[101670]
    if not cfg then
        return
    end

    for _, data in ipairs(cfg) do
        local id, num = table.unpack(data)
        if percentage > 0 then
            num = math.floor(num * (1 + percentage))
        end
        self:LoadRewardItem(self.go_table.obj_reward1, id, num)
    end
end
---初始化公会职位福利
---@return void
function SociatyGloryRewardView:InitJobRewards()
    local model = require("SociatyModel"):GetInstance()
    local selfData = model:GetSelfMember()
    --是否为名人堂玩家
    local isFame = model:IsFameMember(selfData)
    ---职位描述
    self.go_table.aortext_job.text =
        isFame and _G.GetLangPackValue(90021800418) or
        _G.GetLangPackValue(90021800417, _G.GetLangPackValue(model:GetLocationLanguage(selfData.Location)))

    --职位加成百分比
    local percentage = 0
    if isFame then
        --名人堂福利加成配置
        local cfg = _G.ConfigManager.discrete_cfg[101672]
        percentage = cfg and cfg[1][1] * 0.0001 or 0
    elseif selfData.Location ~= ELocationEnum.Member then
        --职位福利加成配置
        local cfg = _G.ConfigManager.discrete_cfg[101671]
        if cfg then
            for _, d in pairs(cfg) do
                if d[1] == selfData.Location then
                    percentage = d[2] * 0.0001
                    break
                end
            end
        end
    end

    self.go_table.obj_reward2Empty:SetActiveE(percentage <= 0 and 1 or 0)

    if percentage > 0 then
        --读取配置表(公会基础福利)
        local cfg = _G.ConfigManager.discrete_cfg[101670]
        if not cfg then
            return
        end

        for _, data in ipairs(cfg) do
            local id, num = table.unpack(data)
            if percentage > 0 then
                num = math.floor(num * percentage)
            end
            if num > 0 then
                self:LoadRewardItem(self.go_table.obj_reward2, id, num)
            end
        end
    end
end

---加载奖励节点
---@param parent Transform|GameObject
---@param id number
---@param num number
function SociatyGloryRewardView:LoadRewardItem(parent, id, num)
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        parent,
        function(item)
            if not parent or parent:IsNull() then
                if item and item.gameObject and not item.gameObject:IsNull() then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                end
                return
            end
            item:Show(id, nil, num)

            local data = _G.StorageManager:GetInstance():GetStorageItemData(id)
            local isShowEffect =
                data and data.Cfg and (data.Cfg.ef_item == 1 or data.Cfg.ef_item == "1") and true or false
            item:ShowFrameEffect(id, isShowEffect)
        end
    )
end

---领取工资后的回调
---@return void
function SociatyGloryRewardView:OnRewardCallback()
    self:UpdateStates()

    --刷新外层UI状态
    ---@type SociatyGloryTopView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyGloryTopView.Name)
    if view then
        view:UpdateButtonStates()
    end

    --刷新红点信息
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildGlory.id)
end

---处理按钮事件
function SociatyGloryRewardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        require("SociatyModel"):GetInstance():GetReward(_G.handler(self, self.OnRewardCallback))
    end
end

return SociatyGloryRewardView
