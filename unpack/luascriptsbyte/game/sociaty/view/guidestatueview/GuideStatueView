--- 释放
function GuideStatueView:OnDestroy()
    for i = 1, #self.nodeArrays do
        local count = self.nodeArrays[i].transform:GetChildCountE()
        if count > 0 then
            _G.PoolsManager:GetInstance():Despawn(self.nodeArrays[i].transform:GetChildE(0), _G.ePoolType.Default)
        end
    end
    self.fightArrays = nil
    self.nodeArrays = nil
    self.roles = nil
end
