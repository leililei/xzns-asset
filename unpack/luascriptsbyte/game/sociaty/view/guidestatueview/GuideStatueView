---视图 更新--
function GuideStatueView:InitView()
    --local count = #self.roles
    local hlImageNodes = self.go_table.trans_rankPanel
    local fightNodes = self.go_table.trans_FightingPanel
    local fightTitle = self.go_table.trans_FightTitle
    local count = self.rankCountLimit
    if count > 5 then
        count = 5
    end
    --TODO:计算缩放比例
    local scale = 1
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        scale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end

    for i = 1, 5 do
        local data = {}
        if not _G.table.isEmptyOrNil(self.roles) and i <= count then
            data = self.roles[i]
            if not _G.table.isEmptyOrNil(data) then
                ---@type card_cfg

                local cfg = require "CardCommentManager":GetInstance():CardData(data.city_style_id, false)
                LoadRoleScene(self, cfg.ModelPathHi, i, scale)
                --按钮 事件
                _G.PoolsManager:GetInstance():Spawn(
                    objRankInfoPath,
                    _G.ePoolType.UIItem,
                    self.nodeArrays[i].transform,
                    function(tr)
                        tr = _G.GetAutoGoTable(tr)
                        if _G.table.isEmptyOrNil(data) then
                            _G.GameUtil.SetActiveByCondition(tr.trans_node, false)
                        else
                            ---@type card_cfg
                            local cfg = _G.ConfigManager.card_cfg[data.city_style_id]

                            _G.AddViewBtnClick(tr.gameObject, _G.handlerbind(self, self.OnclickRankItem, data.uid))
                        end
                    end
                )
            end
        end
        if _G.table.isEmptyOrNil(data) and i <= count then
            --self.rankNameArrays[i].text = _G.LangUtil.GetLangPackValue(90021800103)
            _G.GameUtil.SetActiveByCondition(fightNodes.gameObject:GetChildE(i - 1), false)
        elseif i > count then
            --self.rankNameArrays[i].text = string.format(_G.LangUtil.GetLangPackValue(90021800104), level)
            _G.GameUtil.SetActiveByCondition(fightNodes.gameObject:GetChildE(i - 1), false)
            local level = 0
            for j = 1, #self.unloclRanks do
                if i == self.unloclRanks[j].num_statue then
                    level = self.unloclRanks[j].level
                    break
                end
            end
        else
            --self.rankNameArrays[i].text = data.name
            _G.GameUtil.SetActiveByCondition(fightNodes.gameObject:GetChildE(i - 1), true)
            _G.GameUtil.SetActiveByCondition(fightTitle.gameObject:GetChildE(i - 1), true)
            self.fightArrays[i].text =
                _G.string.replace(
                _G.UIUtils.NumberToUnitStr_CardFightNum(data.power),
                _G.ConfigManager.language_package_cfg[90023100001],
                "+"
            )
        end
        if _G.table.isEmptyOrNil(data) and i <= count then
            _G.GameUtil.SetActiveByCondition(self.yingziNode[i], false)
        else
            _G.GameUtil.SetActiveByCondition(self.yingziNode[i], true)
        end
    end
end

