---解锁雕像最低等级
function GuideStatueView:UnLockMinLevel()
    local guildCfg = _G.ConfigManager.guild_level_cfg
    local unLockRank = {}
    local insert = _G.table.insert
    local sort = _G.table.sort
    for i = 1, 5 do
        local temp = {}
        for j = 1, #guildCfg do
            if guildCfg[j].num_statue == i then
                local t1 = {}
                t1.level = guildCfg[j].level
                t1.num_statue = guildCfg[j].num_statue
                insert(temp, t1)
            end
        end
        sort(
            temp,
            function(a, b)
                if a.level < b.level then
                    return true
                end
                return false
            end
        )
        insert(unLockRank, temp[1])
    end
    return unLockRank
end

