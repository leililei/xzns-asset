function GuideStatueView:SetData(Data)
    if self.sceneTrans == nil then
        LoadEmbattleScene(
            self,
            function(sceneTrans)
                self.MainCamera = _G.Camera.main
                self.MainCamera.depth = 55
                local count = sceneTrans:GetChildCountE()
                self.rankTrans = sceneTrans:GetChildE(count - 1)
                SociatyNet:GetInstance():GetGuildRank(_G.handler(self, self.InitRankData))
            end
        )
    end
end

function GuideStatueView:CloseView()
    self.MainCamera.depth = 0
    local roleCount = self.rankTrans:GetChildCountE()
    for i = 1, roleCount do
        local temp = self.rankTrans:GetChildE(i - 1)
        local tempCount = temp:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp:GetChildE(0), _G.ePoolType.Temporary)
        end
    end
    _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
    self:Close()
    for i = 1, #self.nodeArrays do
        local count = self.nodeArrays[i].transform:GetChildCountE()
        if count > 0 then
            _G.PoolsManager:GetInstance():Despawn(self.nodeArrays[i].transform:GetChildE(0), _G.ePoolType.Default)
        end
    end
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.GuideStatueAgreeView.Name)
end

