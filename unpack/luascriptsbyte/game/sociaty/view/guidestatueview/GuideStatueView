-----加载场景
---@param  view ChangeRoleView 界面对象
---@field camera _G.Camera
local function LoadEmbattleScene(view, callback)
    _G.PoolsManager:GetInstance():Spawn(
        view.ScenePrefabPath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("场景无法加载 path:" .. view.ScenePrefabPath .. "    CardInfoView LoadEmbattleScene")
                end
                return
            end
            --TODO:重定位节点坐标
            local x, y, z, hit
            local count = trans:GetChildCountE()
            local parent = trans:GetChildE(count - 1)
            count = parent:GetChildCountE()
            local roleTrans
            for i = 0, count - 1 do
                roleTrans = parent:GetChildE(i)
                x, y, z = view.yingziNode[i + 1]:GetPosition()
                hit, x, y, z = _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(0, 0, 0, x, y)
                if hit then
                    roleTrans:SetPosition(x, y, z)
                end
            end
            _G.GameUtil.SetActiveByCondition(view.gameObject, true)
            view.sceneTrans = trans
            if callback then
                callback(trans)
            end
        end
    )
end

---加载角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
local function LoadRoleScene(view, rolepath, posIndex, scale)
    --view:RoleRecycle()
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            local count = view.rankTrans:GetChildCountE()
            trans:SetParentE(view.rankTrans:GetChildE(posIndex - 1))
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
        end
    )
end

