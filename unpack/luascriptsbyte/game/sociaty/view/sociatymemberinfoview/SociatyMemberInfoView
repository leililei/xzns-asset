---@class SociatyMemberInfoView : UIBaseView 描述
---@field public go_table SociatyMemberInfoView_GoTable GoTable
---@field public Target SociatyMemberBase 查看公会成员的数据
---@field public MineData SociatyMemberBase 自身数据
---@field public BtnCtrls table<number,SociatyMemberInfoView._aorbtn_Item_GoTable> 可操作的按钮
---@field public IsInitPosList boolean
local SociatyMemberInfoView = _G.BaseClass("SociatyMemberInfoView", _G.UIBaseView)
local MemberEnum = require("MemberEnum")
local EAuthorityEnum = MemberEnum.EAuthorityEnum
local ELocationEnum = MemberEnum.ELocationEnum
local SociatyData = require("SociatyData")
local SociatyMemberBase = require("SociatyMemberBase")

---@type SociatyMemberModule
local MD

---@type SociatyMemberInfoView_GoTable
local Ctrl

local EAuthorityEnumBtnKey = {
    AddFriend = _G.LangUtil.GetLangPackValue(90021800067),
    Chat = _G.LangUtil.GetLangPackValue(90021800068),
    Switch = _G.LangUtil.GetLangPackValue(90021800069),
    Appoint = _G.LangUtil.GetLangPackValue(90021800070),
    Dismiss = _G.LangUtil.GetLangPackValue(90021800071),
    KickOut = _G.LangUtil.GetLangPackValue(90021800072)
}

function SociatyMemberInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    Ctrl = self.go_table
end

---界面的入口函数
---@param data SociatyMemberBase
function SociatyMemberInfoView:OnCreate(data)
    MD = SociatyData.GetMemberModule()
    assert(MD, "MD is nil")
    self.Target = data
    self.IsInitPosList = false
    self.BtnCtrls = {}
    self.MineData = MD:GetMember(_G.PlayerModel:GetInstance().role_uid)
    self:RefreshView()
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnMemberLocationRefresh)
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyEvent.AddFriendSuccess, self.RefreshBtns)
end

---踢出
---@param uid number
function SociatyMemberInfoView:OnBeKicked(uid)
    if uid == _G.PlayerModel:GetInstance().role_uid then
        self:Close()
    end

    if uid == self.Target.Uid then
        self:Close()
    end
end

---职位变动推送
---@param data guild.p2c_guild_position
function SociatyMemberInfoView:OnMemberLocationRefresh(data)
    local isRefresh = false

    ---@param v role.i_role
    for i, v in ipairs(data.pos) do
        if v.uid == self.Target.Uid then
            isRefresh = true
            break
        end
    end

    if isRefresh then
        self.Target = MD:GetMember(self.Target.Uid)
        self:HideAppointView()
    end

    self:RefreshBtns()
end

---刷新界面
function SociatyMemberInfoView:RefreshView()
    local path = _G.ConfigManager.player_portrait_cfg[self.Target.IconSid].portrait1
    Ctrl.aorrawimage_Icon:LoadImage(path)
    Ctrl.aortext_Name.text = self.Target.Name
    Ctrl.aortext_Power.text =
        _G.string.replace(
        _G.GameUtil.NumberToUnitStrFight(self.Target.Power),
        _G.LangUtil.GetLangPackValue("90023100001"),
        "+"
    )
    Ctrl.aortext_Lv.text = self.Target.Level
    GameUtil.ReBuildRTF(Ctrl.obj_leveldi)

    self:RefreshBtns()
end

---显示按钮
function SociatyMemberInfoView:RefreshBtns()
    local data, num = self.MineData:GetAuthority(self.Target)

    for i, v in pairs(self.BtnCtrls) do
        _G.GameUtil.SetActiveByCondition(v.gameObject, false)
    end

    for i, v in ipairs(data) do
        if not self.BtnCtrls[v] then
            ---@type UnityEngine.GameObject
            local obj = Ctrl.aorbtn_Item:InstantiatE(Ctrl.obj_Root)
            local showName = table.keyof(EAuthorityEnum, v)
            obj:SetName(showName)

            ---@type SociatyMemberInfoView._aorbtn_Item_GoTable
            local cell = _G.GetAutoGoTable(obj, handlerbind(self, self.OnClickBtnCell, v))
            cell.aortext_Name.text = EAuthorityEnumBtnKey[showName]
            self.BtnCtrls[v] = cell
        end

        self.BtnCtrls[v].gameObject:SetAsLastSiblingE()
        _G.GameUtil.SetActiveByCondition(self.BtnCtrls[v].gameObject, true)
    end
    _G.GameUtil.ReBuildRTF(Ctrl.obj_Root)
end

---各个功能点击
---@param go UnityEngine.GameObject
---@param isOn boolean
---@param v EAuthorityEnum
function SociatyMemberInfoView:OnClickBtnCell(go, isOn, v)
    if v == EAuthorityEnum.AddFriend then
        MD:AddFriend(self.Target.Uid)
        return
    end

    if v == EAuthorityEnum.Chat then
        MD:DoChat(self.Target.Uid)
        return
    end

    if v == EAuthorityEnum.KickOut then
        MD:KickOut(self.Target)
        return
    end

    if v == EAuthorityEnum.Switch then
        MD:SwitchChairman(
            self.Target.Uid,
            function()
                self:Close()
            end
        )
        return
    end

    if v == EAuthorityEnum.Dismiss then
        --self:ShowAppointView()
        MD:DoAppoint(self.Target.Uid, ELocationEnum.Member)
        return
    end

    if v == EAuthorityEnum.Appoint then
        self:ShowAppointView()
        return
    end
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject 按钮
function SociatyMemberInfoView:OnClickBtn(go)
    if go == Ctrl.aorbtn_Close then
        self:Close()
    end
end

---隐藏任职界面
function SociatyMemberInfoView:HideAppointView()
    _G.GameUtil.SetActiveByCondition(Ctrl.obj_SetPosViewGroup, false)
end

---显示任职界面
function SociatyMemberInfoView:ShowAppointView()
    self:RefreshAppointView()

    if _G.AppSetting.DEBUG then
        _G.Log("<color=red><size=10>" .. "SociatyMemberInfoView 显示任职界面" .. "</size></color>")
    end
    _G.GameUtil.SetActiveByCondition(Ctrl.obj_SetPosViewGroup, true)
end

---刷新任职界面
function SociatyMemberInfoView:RefreshAppointView()
    if not self.IsInitPosList then
        _G.GameUtil.RefreshLoopList(Ctrl.looplist2_Pos, #MD:GetAllOfficer(), _G.handler(self, self.RefreshPosItem))
        self.IsInitPosList = true
    end
end

---@param looplist2 SuperScrollView.LoopListView2 滚动组件
---@param index number 该数据的索引  0起始
function SociatyMemberInfoView:RefreshPosItem(looplist2, index)
    if index < 0 then
        return
    end
    local eIndex = index + 1
    local item = looplist2:NewListViewItem("$_obj_ListItem")

    ---@type OfficerCell
    local data = MD:GetAllOfficer()[eIndex]

    ---@type SociatyMemberInfoView._obj_ListItem_GoTable
    local ctrl = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnCellClickBtn, data))

    if data then
        ctrl.aortext_PosName.text = SociatyMemberBase:GetLocationName(data.Pos)
        ctrl.aortext_PosNumber.text = string.format("%s/%s", data.Cur, data.Max)
        if data.Cur >= data.Max then
            string.AddColor(ctrl.aortext_PosNumber.text, "bf4419")
            _G.GameUtil.SetActiveByCondition(ctrl.obj_Full, true)
            _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_Appoint, false)
            _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_Dismiss, false)
        else
            string.AddColor(ctrl.aortext_PosNumber.text, "d4ddff")
            _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_Appoint, data.Pos ~= self.Target.Location)
            _G.GameUtil.SetActiveByCondition(ctrl.aorbtn_Dismiss, false)
            _G.GameUtil.SetActiveByCondition(ctrl.obj_Full, false)
        end
    end
    return item
end

---任命功能点击
---@param go UnityEngine.GameObject
---@param isOn boolean
---@param data OfficerCell
function SociatyMemberInfoView:OnCellClickBtn(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_Dismiss" then
        MD:DoAppoint(self.Target.Uid, ELocationEnum.Member)
        return
    end

    if name == "@_aorbtn_Appoint" then
        MD:DoAppoint(self.Target.Uid, ELocationEnum.CoChairman)
        return
    end
end

---析构函数
function SociatyMemberInfoView:Dispose()
    Ctrl = nil
    MD = nil
end

---@return SociatyMemberInfoView
return SociatyMemberInfoView
