local SociatyDonateCardItem = _G.BaseClass("SociatyDonateCardItem")

function SociatyDonateCardItem:__init()
end

function SociatyDonateCardItem:Dispose()
end

---初始化
---@param data PropData
function SociatyDonateCardItem:Init(data)
    if self.card == nil then
        self.card = ItemCardBaseView.New(self.transform)
    end
    self.data = data
    self.card.go_table.aorimage_Color.SpriteName = itemColorIconName[self.data.Order]
    self.card.go_table.aorimage_ColorBg.SpriteName = itemColorDiIconName[self.data.Order]
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[tonumber(data.cfg.UseParameter[1][2])]
    self.card:Show(cfg.id, _G.handlerbind(self, self.ClickItem, data), cfg.Star, 0, data)

    self.go_table.aorimage_sui.SpriteName = ColorType[data.Grade]
end

---点击物体
---@param item BaseAwardItem
function SociatyDonateCardItem:ClickItem()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SociatyStorageDonateView.Name,
        self.data,
        self.donateCallback
    )
end

function SociatyDonateCardItem.Craete(trans, donateCallback)
    local item = SociatyDonateCardItem.New(trans)
    item.transform = trans
    item.go_table = _G.GetAutoGoTable(item.transform)
    item.donateCallback = donateCallback
    return item
end

---@class SociatyDonateView : UIBaseView	中文描述
---@field public go_table SociatyDonateView_GoTable GoTable
---@field PropDatas PropData[] 卡牌碎片数据
---@field CardLists SociatyDonateCardItem[]
---@field callback function 捐献后的回调
---@field RecordData guild.i_guild_record[]
---@field RecordItems RecordItem_GoTable[]
local SociatyDonateView = _G.BaseClass("SociatyDonateView", _G.UIBaseView)
--_G.SociatyDonateView = SociatyDonateView

local CS = _G.CS
local typeof = _G.typeof

function SociatyDonateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyDonateView:OnCreate(callback)
    self.isInited = false
    self.callback = callback
    self.PropDatas = nil
    self.CardItems = {}

    self:Init()
end

---初始化
function SociatyDonateView:Init()
    self:InitCardData()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_No, #self.PropDatas == 0)
    self.go_table.aorlooplist_StrogeList:StartUpdataDragInfo(
        math.ceil(#self.PropDatas),
        _G.handler(self, self.RefreshCardItem)
    )
end

---初始化卡牌碎片
function SociatyDonateView:InitCardData()
    local tb = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Prop)
    local keys = _G.table.keys(_G.ConfigManager.guild_warehouse_cfg)
    self.PropDatas =
        _G.table.chooseToArray(
        tb,
        function(k, v)
            return _G.table.ContainsValue(keys, k)
        end
    )
    _G.table.sort(
        self.PropDatas,
        function(a, b)
            if a.cfg.Quality == b.cfg.Quality then
                return a.sid > b.sid
            else
                return a.cfg.Quality > b.cfg.Quality
            end
        end
    )
end

function SociatyDonateView:RefreshCardItem(trans, index)
    local instanceID = trans:GetInstanceIDE()
    if not self.CardItems[instanceID] then
        self.CardItems[instanceID] = SociatyDonateCardItem.Craete(trans, _G.handler(self, self.DonateCall))
    end
    self.CardItems[instanceID]:Init(self.PropDatas[index + 1])
end

---捐献回调
function SociatyDonateView:DonateCall(cardData, num)
    local msg = {id = cardData.sid, num = num}

    require("SociatyNet"):GetInstance():DonateSociatyStorageInfo(
        msg,
        function(data)
            if data.ack ~= 1 then
                return
            end
            _G.Events:GetInstance():Broadcast(
                _G.eSociatyEvent.RefreshRecord,
                {
                    record = {
                        role_name = _G.PlayerModel:GetInstance().role_name,
                        type = 1,
                        time = _G.TimeUtil.GetServerUnixTime(),
                        id = cardData.sid,
                        num = num
                    }
                },
                true
            )
            _G.StorageManager:GetInstance():ConsumeItem(cardData.sid, cardData.uid, num)
            self:InitCardData()
            local count = #self.PropDatas
            self.go_table.aorlooplist_StrogeList:RefreshAllShowItem(count)
            if self.callback then
                self.callback(cardData.sid, num)
            end
            if count == 0 then
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_No, true)
            end
        end
    )
end

---关闭界面
function SociatyDonateView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function SociatyDonateView:OnClickBtn()
    self:CloseView()
end

return SociatyDonateView
