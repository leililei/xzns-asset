---@class SameNameGiftPackView : UIBaseView    中文描述
---@field public go_table SameNameGiftPackView_GoTable GoTable
------@field  itemTransDic BaseAwardNewItem[]
local SameNameGiftPackView = _G.BaseClass("SameNameGiftPackView", _G.UIBaseView)
---@type SevenGiftGMSynModel


function SameNameGiftPackView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SameNameGiftPackView:OnCreate()
    self.giftId = 556001
    self:InitView()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SameNameGiftPackView:InitView()
    local store_extra_cfg = _G.ConfigManager.store_extra_cfg[self.giftId]
    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(store_extra_cfg.price_id)
    local buyCount

    buyCount = require "MallManager":GetInstance():GetItemBuyTimes(store_extra_cfg.id, store_extra_cfg.type_reset)
    local restCount = store_extra_cfg.count_limit - buyCount
    if store_extra_cfg.type_price == 1 then
        _G.GameUtil.SetPriceByChannel(store_extra_cfg.price_id, self.go_table.aortext_charge)
    end

    if restCount <= 0 then
        self.go_table.aortext_charge.text = _G.GetLangPackValue(90033400092)
    end
    self.go_table.aorbtn_buy:SetGray(restCount <= 0)
    self.restCount = restCount
    local awrad = store_extra_cfg.goods
    for i = 1, self.go_table.obj_AwardNode:GetChildCountE() do
        _G.DestroyImmediate(self.go_table.obj_AwardNode:GetChildE(0).gameObject)
    end
    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awrad[j],
            self.go_table.obj_AwardNode,
            function(item)
                if not self.go_table then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                item:ShowEffectOrder(item.cfg and item.cfg.ef_item == 1 and true or false)
            end
        )
    end
end

---界面的销毁函数
function SameNameGiftPackView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---按钮点击事件在这里派发
function SameNameGiftPackView:OnClickBtn(go)
    if go == self.go_table.aorbtn_buy then
        if self.restCount <= 0 then
            return
        end
        local priceId = _G.ConfigManager.store_extra_cfg[self.giftId].price_id
        require("MallManager"):GetInstance():BuyActiveGift(priceId, nil, self.giftId)
    elseif go == self.go_table.aorbtn_closeView then
        self:CloseView()
    end
end

function SameNameGiftPackView:OnMallCashListener(data)
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    local cfg = _G.ConfigManager.store_extra_cfg[self.giftId]
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    local count = require "MallManager":GetInstance():GetItemBuyTimes(cfg.id, cfg.type_reset)
    
    require "MallManager":GetInstance():SetItemBuyTimes(cfg.id, cfg.type_reset, count + 1)
    self:InitView()
end

function SameNameGiftPackView:CloseView()
    self:Close()
end

return SameNameGiftPackView
