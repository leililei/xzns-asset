---@class SociatyStorageItem 货物
---@field go_table SociatyStorageItem_GoTable GoTable
---@field data SociatyStorageData 货物数据
---@field callback function 点击回调
---@field card BaseAwardItem 卡牌显示
local SociatyStorageItem = _G.BaseClass("SociatyStorageItem")

---初始化
---@param data SociatyStorageData
function SociatyStorageItem:Init(data)
    if self.data and self.data.goodData.id == data.goodData.id then
        self:UpdateNum()
        return
    end
    self.data = data
    self:UpdateCard()
    self:UpdateNum()
    self.go_table.aortext_num.text = _G.GameUtil.NumberToUnitStr(self.data.cfg.point_fetch)
    self.go_table.aortext_Name.text =
        string.format(
        "<color=%s>%s</color>",
        Color[self.data.propCfg.Quality],
        GetLangPackValue(self.data.propCfg.Name)
    )
    self.data = self.data
end
function SociatyStorageItem:UpdateCard()
    if not self.card then
        self.card = require("BaseAwardItem").CreatAwardItem(self.go_table.obj_cardInfo)
    end
    local data = {sid = self.data.goodData.id, number = self.data.goodData.num}
    self.card:UpdateItem(data, nil, true)
end

---更新数量
function SociatyStorageItem:UpdateNum()
    self.go_table.aortext_StrogeNum.text =
        GetLangPackValue(90022500424) .. _G.GameUtil.NumberToUnitStr(self.data.goodData.num)
end

function SociatyStorageItem:OnClickBtn()
    if self.callback then
        self.callback(self)
    end
end

function SociatyStorageItem.CreateItem(trans, callback)
    local item = SociatyStorageItem.New()
    item.go_table = _G.GetAutoGoTable(trans, _G.handler(item, item.OnClickBtn))
    item.callback = callback
    return item
end

---@class SociatyStorageView : UIBaseView	公会仓库
---@field public go_table SociatyStorageView_GoTable GoTable
---@field stroageData guild.s2c_guild_warehouse_info 仓库信息
---@field GoodDatas SociatyStorageData[] 所有货物数据
---@field curGoodDatas SociatyStorageData[] 当前显示的货物数据
---@field GoodItems SociatyStorageItem[]
---@field RecordItems RecordItem_GoTable[]
---@field ElementType CardElementType 元素属性
---@field ProfType CardProfType 卡牌职业
---@field NowSxList View_CardSx_NowSxList 当前选择的职业及五行
local SociatyStorageView = _G.BaseClass("SociatyStorageView", _G.UIBaseView)
--_G.SociatyStorageView = SociatyStorageView

local CS = _G.CS
local typeof = _G.typeof

function SociatyStorageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Guard.NotNull(self, "参数错误： self 为必传项")
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.RefreshRecord, self.P2CRecord, self)
end

---界面的入口函数
function SociatyStorageView:OnCreate()
    self.GoodItems = {}
    self.GoodDatas = nil
    self.NowSxList = nil
    self.ElementType = _G.CardElementType.None
    self.ProfType = _G.CardProfType.None
    self.isInited = false
    require("SociatyNet"):GetInstance():GetSociatyStorageInfo(_G.handler(self, self.Init))
end

---@param msg guild.s2c_guild_warehouse_info
function SociatyStorageView:Init(msg)
    if msg.ack ~= 1 then
        self:CloseView()
        return
    end
    self.stroageData = msg
    if not self.stroageData.records then
        self.stroageData.records = {}
    end
    if not self.stroageData.goods then
        self.stroageData.goods = {}
    end
    self:Parse(msg)
    self.curGoodDatas = self.GoodDatas
    self.go_table.aorlooplist_StrogeList:StartUpdataDragInfo(0, _G.handler(self, self.RefreshGood))
    if self.stroageData.goods then
        self:UpdateStroageItems(#self.stroageData.goods)
    else
        self:UpdateStroageItems(0)
    end

    self:InitRecord()
end

---解析数据
---@param msg guild.s2c_guild_warehouse_info
function SociatyStorageView:Parse(msg)
    if msg.goods then
        local count = #msg.goods
        self.GoodDatas = {}
        self.RecordItems = {}
        for i = 1, count do
            local data = SociatyStorageData.New()
            data:Parse(msg.goods[i])
            self.GoodDatas[i] = data
        end
    end
end

---更新玩家点数
function SociatyStorageView:UpadtePoint()
    self.go_table.aortext_CoinNum.text = _G.GameUtil.NumberToUnitStr(self.stroageData.point)
end

---更新仓库道具
function SociatyStorageView:UpdateStroageItems(count)
    self:UpadtePoint()
    if count == 0 then
        if #self.stroageData.goods == 0 then
            _G.GameUtil.SetActiveByCondition((self.go_table.aorimage_none), true)
            _G.GameUtil.SetActiveByCondition((self.go_table.aorimage_none2), false)
            _G.GameUtil.SetActiveByCondition((self.go_table.aorlooplist_StrogeList), false)
        else
            _G.GameUtil.SetActiveByCondition((self.go_table.aorimage_none), false)
            _G.GameUtil.SetActiveByCondition((self.go_table.aorimage_none2), true)
            _G.GameUtil.SetActiveByCondition((self.go_table.aorlooplist_StrogeList), false)
        end
        return
    end
    _G.GameUtil.SetActiveByCondition((self.go_table.aorlooplist_StrogeList), true)
    _G.GameUtil.SetActiveByCondition((self.go_table.aorimage_none), false)
    _G.GameUtil.SetActiveByCondition((self.go_table.aorimage_none2), false)
    if count then
        self.go_table.aorlooplist_StrogeList:RefreshAllShowItem(count)
    else
        self.go_table.aorlooplist_StrogeList:RefreshAllShowItem()
    end
end

---刷新货物显示信息
function SociatyStorageView:RefreshGood(trans, index)
    index = index + 1
    local instanceID = trans:GetInstanceIDE()
    if not self.GoodItems[instanceID] then
        self.GoodItems[instanceID] = SociatyStorageItem.CreateItem(trans, _G.handler(self, self.ClickGoodCall))
    end
    self.GoodItems[instanceID]:Init(self.curGoodDatas[index])
end

---点击货物
---@param item SociatyStorageItem
function SociatyStorageView:ClickGoodCall(item)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SociatyStorageTakeView.Name,
        item.data,
        self.stroageData.point,
        _G.handler(self, self.TakeGoodCall)
    )
end

---获取货物回调
---@param data SociatyStorageData
function SociatyStorageView:TakeGoodCall(data, num)
    local msg = {id = data.goodData.id, num = num}
    require("SociatyNet"):GetInstance():TakeOfSociatyStorag(
        msg,
        function(data2)
            if data2.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data2)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data2)
            data.goodData.get_nums = data.goodData.get_nums + num
            self:P2CRecord(
                {
                    record = {
                        role_name = _G.PlayerModel:GetInstance().role_name,
                        type = 0,
                        time = _G.TimeUtil.GetServerUnixTime(),
                        id = data.goodData.id,
                        num = num
                    }
                },
                true
            )
        end
    )
end

---按钮点击事件在这里派发
function SociatyStorageView:OnClickBtn(go, isOn)
    local name = go:GetName()
    -- self.clickFunction = {
    --     ["@_aorbtn_CloseView"] = self.CloseView,
    --     ["@_aorbtn_profession"] = self.CloseView,
    --     ["@_aorbtn_elements"] = self.CloseView,
    --     ["@_aorbtn_donate"] = self.OnDonate
    -- }
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_profession" then
        self:OnProfession(go, isOn)
    elseif name == "@_aorbtn_elements" then
        self:OnElement(go, isOn)
    elseif name == "@_aorbtn_donate" then
        self:OnDonate()
    elseif name == "@_aorbtn_closeChoose" then
        self:CloseElements()
        self:ClosePro()
    elseif name == "@_aorbtn_choose" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.View_CardSx.Name,
            self.NowSxList,
            _G.handler(self, self.OnFilterCall)
        )
    elseif name == "@_aorbtn_close" then
        self:CloseView()
    end
end

---筛选后的回调
---@param data View_CardSx_NowSxList
function SociatyStorageView:OnFilterCall(data)
    self.NowSxList = data
    self.ElementType = data.Elements
    self.ProfType = data.Professional
    self:ChangeFiltrate()
end

---筛选事件
function SociatyStorageView:ChangeFiltrate()
    self:UpdateCardList()
    self:UpdateStroageItems(#self.curGoodDatas)
end

---筛选后更新仓库列表
function SociatyStorageView:UpdateCardList()
    if self.ElementType == _G.CardElementType.None and self.ProfType == _G.CardProfType.None then
        self.curGoodDatas = self.GoodDatas
    elseif self.ElementType == _G.CardElementType.None then
        self.curGoodDatas =
            _G.table.chooseToArray(
            self.GoodDatas,
            function(k, v)
                return v.cardCfg.Professional == self.ProfType
            end
        )
    elseif self.ProfType == _G.CardProfType.None then
        self.curGoodDatas =
            _G.table.chooseToArray(
            self.GoodDatas,
            function(k, v)
                return v.cardCfg.Elements == self.ElementType
            end
        )
    else
        self.curGoodDatas =
            _G.table.chooseToArray(
            self.GoodDatas,
            function(k, v)
                return v.cardCfg.Elements == self.ElementType and v.cardCfg.Professional == self.ProfType
            end
        )
    end
end

---关闭职业筛选
function SociatyStorageView:ClosePro()
    _G.GameUtil.SetActiveByCondition((self.go_table.aorbtn_closeChoose), false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ElementPanel, false)
    self.go_table.aorimage_arrow1:SetRotation(0, 0, 0)
    if self.ProfType ~= _G.CardProfType.None then
        _G.GameUtil.SetActiveByCondition((self.go_table.aorrawimage_profession), true)
        self.go_table.aorrawimage_profession:LoadImage(ProfIcon[self.ProfType])
    else
        _G.GameUtil.SetActiveByCondition((self.go_table.aorrawimage_profession), false)
    end
end

---关闭五行筛选
function SociatyStorageView:CloseElements()
    _G.GameUtil.SetActiveByCondition((self.go_table.aorbtn_closeChoose), false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ProfPanel, false)
    self.go_table.aorimage_arrow2:SetRotation(0, 0, 0)
    if self.ElementType ~= _G.CardElementType.None then
        _G.GameUtil.SetActiveByCondition((self.go_table.aorrawimage_element), true)
        self.go_table.aorrawimage_element:LoadImage(ElementIcon[self.ElementType])
    else
        _G.GameUtil.SetActiveByCondition((self.go_table.aorrawimage_element), false)
    end
end

---初始化仓库记录
function SociatyStorageView:InitRecord()
    self.recordCount = 0
    if self.stroageData.records then
        self.stroageData.records = _G.table.reverseTable(self.stroageData.records)
        self.recordCount = #self.stroageData.records
    end
    self.go_table.looplist2_RecordList:InitListView(0, _G.handler(self, self.RefreshRecordItem))
    self.go_table.looplist2_RecordList:SetListItemCount(self.recordCount, true, true)
end

---刷新仓库记录
function SociatyStorageView:RefreshRecordItem(listView2, index)
    local item = listView2:NewListViewItem("$_obj_RecordItem")
    local instanceID = item:GetInstanceIDE()
    if not self.RecordItems[instanceID] then
        self.RecordItems[instanceID] = _G.GetAutoGoTable(item)
    end
    local data = self.stroageData.records[index + 1]
    if data.type == 0 then
        self.RecordItems[instanceID].aortext_content.text =
            string.format(GetLangPackValue(90021800091), data.role_name, "")
    else
        self.RecordItems[instanceID].aortext_content.text =
            string.format(GetLangPackValue(90021800090), data.role_name, "")
    end
    self:UpdateRecordItem(self.RecordItems[instanceID].aortext_content2, data)
    if index + 1 == self.recordCount then
        if not self.isInited then
            self.isInited = true
        end
    end
    return item
end

---更新记录的显示内容
---@param aorText AorText
---@param data guild.i_guild_record
function SociatyStorageView:UpdateRecordItem(aorText, data)
    local itemData = _G.ConfigManager.item_cfg[data.id]
    local str = ""
    local str2 =
        string.format(
        "%s<color=%s>%sx%d</color>",
        str,
        Color[itemData.Quality],
        GetLangPackValue(itemData.Name),
        data.num
    )
    aorText.text = str2
end

---推送捐献或者获取信息
---@param msg guild.p2c_guild_record
function SociatyStorageView:P2CRecord(msg, isSelf)
    local name = _G.PlayerModel:GetInstance().role_name
    if not isSelf and msg.record.role_name == name then
        return
    end
    ---更新仓库纪录
    local change = self.recordCount < 100
    if not change then
        _G.table.remove(self.stroageData.records, 1)
        self.stroageData.records[100] = msg.record
    else
        self.recordCount = self.recordCount + 1
        self.stroageData.records[self.recordCount] = msg.record
    end
    local count = change and self.recordCount - 2 or self.recordCount - 1
    self.go_table.looplist2_RecordList:SetListItemCount(self.recordCount, true, true)

    ---移除或添加道具 并更新点数
    count = #self.stroageData.goods
    local cfg = _G.ConfigManager.guild_warehouse_cfg[msg.record.id]
    for i = 1, count do
        if self.stroageData.goods[i].id == msg.record.id then
            if msg.record.type == 0 then
                self.stroageData.point = self.stroageData.point - msg.record.num * cfg.point_fetch
                self.stroageData.goods[i].num = self.stroageData.goods[i].num - msg.record.num
                if self.stroageData.goods[i].num <= 0 then
                    _G.table.remove(self.stroageData.goods, i)
                    _G.table.remove(self.GoodDatas, i)
                    self:UpdateCardList()
                    self:UpdateStroageItems(#self.curGoodDatas)
                else
                    self:UpdateStroageItems()
                end
            else
                self.stroageData.point = self.stroageData.point + msg.record.num * cfg.point_deposit
                self.stroageData.goods[i].num = self.stroageData.goods[i].num + msg.record.num
                self:UpdateStroageItems()
            end
            return
        end
    end
    local data = {id = msg.record.id, num = msg.record.num, get_nums = 0}
    self.stroageData.goods[count + 1] = data
    local storageData = SociatyStorageData.New()
    storageData:Parse(data)
    self.GoodDatas[count + 1] = storageData
    self.stroageData.point = self.stroageData.point + msg.record.num * cfg.point_deposit
    self:UpdateCardList()
    self:UpdateStroageItems(#self.curGoodDatas)
end

---捐献
---@param id number 道具id
---@param num number 捐献的数量
function SociatyStorageView:OnDonate()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyDonateView.Name)
end

function SociatyStorageView:AddPoint(id, num)
    local cfg = _G.ConfigManager.guild_warehouse_cfg[id]
    self.stroageData.point = self.stroageData.point + cfg.point_deposit * num
    self:UpadtePoint()
end

function SociatyStorageView:OnProfession(go, isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ProfPanel, true)
    _G.GameUtil.SetActiveByCondition((self.go_table.aorbtn_closeChoose), true)
    self.go_table.aorimage_arrow1:SetRotation(0, 0, 180)
end
function SociatyStorageView:OnElement(go, isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ElementPanel, true)
    _G.GameUtil.SetActiveByCondition((self.go_table.aorbtn_closeChoose), true)
    self.go_table.aorimage_arrow2:SetRotation(0, 0, 180)
end

---关闭界面
function SociatyStorageView:CloseView()
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RefreshRecord, self.P2CRecord, self)
    self:Close()
end

return SociatyStorageView
