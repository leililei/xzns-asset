---@class SociatyDamageRankAwardView : UIBaseView    中文描述
---@field public go_table SociatyDamageRankAwardView_GoTable GoTable
local SociatyDamageRankAwardView = _G.BaseClass("SociatyDamageRankAwardView", _G.UIBaseView)

local rankIcon = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan"
}

local color = {
    "914801",
    "8C2D14",
    "444444"
}

---构造函数
---@protected
function SociatyDamageRankAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyDamageRankAwardView:OnCreate()
    if AppSetting.IsXzns then
        color = {
            "50351E",
            "8C2D14",
            "444444"
        }
    end
    self.feastData = require "SociatyModel":GetInstance().feastData
    self.awardList = {}
    local ids = _G.ConfigManager.discrete_cfg[124501][1]
    local cfg = _G.ConfigManager.system_rank_cfg
    local awardRank = 0
    for i, v in ipairs(ids) do
        local data = cfg[v]
        _G.table.insert(self.awardList, data)
        if awardRank < data.max_rank then
            awardRank = data.max_rank
        end
    end
    if self.feastData.last_rank > awardRank then
        self.state = 1
    elseif self.feastData.rank_award == true then
        self.state = 3
    else
        self.state = 2
    end
    self:InitAward()
    self:ShowAwardState()
    if self.feastData.last_rank == 0 then
        self.go_table.aortext_playerRank.text = _G.GetLangPackValue(90022900040)
    elseif self.feastData.last_rank > _G.ConfigManager.discrete_cfg[124502][1][1] then
        self.go_table.aortext_playerRank.text = _G.GetLangPackValue(90033100025)
    else
        self.go_table.aortext_playerRank.text = _G.GetLangPackValue(90022100031, self.feastData.last_rank)
    end
end

---
---@protected
function SociatyDamageRankAwardView:ShowAwardState()
    local gray = self.state == 1 or self.state == 3 or self.feastData.last_rank == 0
    self.go_table.aorbtn_award:SetGray(gray)
    self.go_table.aortext_text.color = _G.ColorTools.FormatColorByString(gray and color[3] or color[1])
    self.go_table.aortext_text.text = self.state == 3 and _G.GetLangPackValue(90000010221) or _G.GetLangPackValue(90025600002)
end

---@param msg zone.s2c_zone_rank_index
function SociatyDamageRankAwardView:InitAward()
    if not self.inited then
        self.go_table.scrollloopvectical_listBase:InitItemData(
            #self.awardList,
            _G.handler(self, self.RefreshReward)
        )
        self.inited = true
    else
        self.go_table.scrollloopvectical_listBase:UpdateCount(#self.awardList)
    end
end

---刷新奖励
function SociatyDamageRankAwardView:RefreshReward(index, obj)
    local newindex = index + 1
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    local tb = _G.GetAutoGoTable(obj1)
    ---@type boss_rank_cfg
    local data = self.awardList[newindex]
    tb.data = data
    tb.aorimage_rank:SetActiveE((newindex <= 3 and data.max_rank == data.min_rank) and 1 or 0)
    local text
    if newindex <= 3 and data.max_rank == data.min_rank then
        tb.aorimage_rank.SpriteName = rankIcon[newindex]
        text = ""
        for i = 1, 3 do
            tb["aortext_rankNum" .. i]:SetActiveE(i == newindex and 1 or 0)
        end
    elseif data.min_rank and data.min_rank == data.max_rank then
        text = newindex
    elseif data.ranks and data.ranks[1] and data.ranks[2] then
        text = _G.string.format("%s~%s", data.ranks[1], data.ranks[2])
    else
        text = _G.string.format("%s~%s", data.min_rank, data.max_rank)
    end
    tb.aortext_score.text = text ~= "" and _G.GetLangPackValue(90022100031, text) or ""
    if tb.data then
        self:ShowAward(tb, tb.obj_Award, tb.data.rewards or tb.data.reward_daily or tb.data.award)
    else
        self:ShowAward(tb, tb.obj_Award, {})
    end
    if data.min_rank <= 3 then
        tb.aorimage_Bg_nor1:SetActiveE(1)
        tb.aorimage_Bg_nor1.SpriteName = "ui_diban" .. newindex
    else
        tb.aorimage_Bg_nor1:SetActiveE(0)
    end
end

function SociatyDamageRankAwardView:ShowAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 58, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data), function()
                -- item.item:ShowEffectOrder(true)
            end)
            item.gameObject:SetActiveE(1)
        end
    end
end

---界面的销毁函数
function SociatyDamageRankAwardView:OnDestroy()
end

---按钮点击事件在这里派发
function SociatyDamageRankAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_award then
        if self.state == 2 and self.feastData.last_rank ~= 0 then
            require("SociatyNet"):GetInstance():GetGuildDamageRankAward(
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    self.state = 3
                    self.feastData.rank_award = true
                    self:ShowAwardState()
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.SociatyTrialRankAward.id
                    )
                    require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                            _G.ConfigManager.redpoint_cfg.GuildchallengeButton.id
                    )
                end
            )
        end
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return SociatyDamageRankAwardView