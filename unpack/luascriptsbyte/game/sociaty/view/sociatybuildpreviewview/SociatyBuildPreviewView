---@class SociatyBuildPreviewView : UIBaseView	公会建造等级预览视图
---@field curId number                                              @当前选中的建筑id
---@field curLevel number                                           @当前选中的建筑等级
---@field titlePool  ObjectPool<SociatyBuildPreviewView._obj_title_GoTable>
---@field rewardPool  ObjectPool<SociatyBuildPreviewView._obj_reward_GoTable>
---@field descPool  ObjectPool<SociatyBuildPreviewView._obj_desc_GoTable>
---@field splitPool  ObjectPool<SociatyBuildPreviewView._obj_split_GoTable>
---@field go_table SociatyBuildPreviewView_GoTable
local SociatyBuildPreviewView = _G.BaseClass("SociatyBuildPreviewView", _G.UIBaseView)

function SociatyBuildPreviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
end
function SociatyBuildPreviewView:OnDestroy()
    self:RemoveAllListener()
end
---监听被踢出公会
function SociatyBuildPreviewView:OnBeKicked()
    self:Close()
end

function SociatyBuildPreviewView:OnCreate(id, level,gotAwardCallBack)
    self.curId = id
    self.curLevel = level
    self.gotAwardCallBack = gotAwardCallBack
    self.cfg = _G.ConfigManager.guild_unit_cfg[self.curId]
    self:InitView()
end

---初始化视图
function SociatyBuildPreviewView:InitView()
    if not self.cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("guild_unit_cfg 中没有" .. "self.curId 相关配置")
        end
        return
    end

    self:UpdateView()
end

function SociatyBuildPreviewView:UpdateView()
    local item
    self.go_table.obj_Content:RemoveAllChildren()
    for k = 1 ,#self.cfg.privilege do
        item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Content)
        self:RefreshList(k,item)
    end
    require("RedPointManager"):GetInstance():RefreshNode(201311,1)
end

function SociatyBuildPreviewView:RefreshList(index,go)
    if index < 0 then
        return
    end
    local tb = _G.GetAutoGoTable(go)
    local data = self.cfg.privilege[index]
    local rewards = {}

    local vaildate = false --是否有任何内容显示
    local descText = ""
    tb.aortext_title.text = _G.GetLangPackValue(90021800050) .. index
    if index > self.curLevel then
        tb.aortext_title.color = _G.ColorTools.FormatColorByString("7B706B")
        tb.aortext_desc.color = _G.ColorTools.FormatColorByString("7B706B")
        tb.aortext_rewardText.color = _G.ColorTools.FormatColorByString("7B706B")
    else
        tb.aortext_title.color = _G.ColorTools.FormatColorByString("211006")
        tb.aortext_desc.color = _G.ColorTools.FormatColorByString("211006")
        tb.aortext_rewardText.color = _G.ColorTools.FormatColorByString("211006")
    end
    if AppSetting.IsXzns then
        tb.aortext_title.color = _G.ColorTools.FormatColorByString("343A48")
        tb.aortext_desc.color = _G.ColorTools.FormatColorByString("818389")
    end
    if require("SociatyModel"):GetInstance():IsMasterBuild(self.curId) then
        vaildate = true
        local levelCfg = _G.ConfigManager.guild_level_cfg[index]
        --等级
        descText =
            descText ..
            (index <= self.curLevel and
            (_G.GetLangPackValue(90031500001) .. "<color=#0B6901>" .. index .. "</color>") or
            (_G.GetLangPackValue(90031500001) .. "<color=#0B6901>" .. index .. "</color>"))
            .. "\n"
        --人数
        descText =
            descText ..
            (index <= self.curLevel and
            (_G.GetLangPackValue(90031500002) .. "<color=#0B6901>" .. levelCfg.num_player .. "</color>") or
            (_G.GetLangPackValue(90031500002) .. "<color=#0B6901>" .. levelCfg.num_player .. "</color>"))
            .. "\n"
        --捐献上限
        descText =
            descText ..
            (index <= self.curLevel and
            (_G.GetLangPackValue(90031500003) .. "<color=#0B6901>" .. levelCfg.limit .. "</color>") or
            (_G.GetLangPackValue(90031500003) .. "<color=#0B6901>" .. levelCfg.limit .. "</color>"))
    end

    --描述展示
    local tempIndex = 1
    local itemNum = self.curId == 5 and 3 or 2
    for i = 1, #data, itemNum do
        if descText ~= "" then
            descText = descText .. "\n"
        end
        local type = data[i]
        if type ~= 5 and type ~= 8 then
            vaildate = true
            local title = _G.GetLangPackValue(self.cfg.describe[index][tempIndex])
            local value = math.ceil(data[i + 1] * 0.01) .. "%"
            if index <= self.curLevel then
                if data[i + 1] > 0 then
                    descText = descText .. title .. "<color=#0B6901>" .. value .. "</color>"
                else
                    descText = descText .. title .. "<color=#0B6901>" .. value .. "</color>"
                end
            else
                descText = descText .. title .. "<color=#0B6901>" .. value .. "</color>"
            end
        elseif type == 5 then
            --如果上一级已经存在的商品, 则不进行显示(前一级和后一级的物品顺序强相关)
            local lastPrivilege = index > 1 and self.cfg.privilege[index - 1] or nil
            if not lastPrivilege or not lastPrivilege[i] or lastPrivilege[i] <= 0 or lastPrivilege[i + 1] <= 0 then
                if data[i + 1] > 0 then
                    table.insert(rewards, _G.ConfigManager.shop_pools_cfg[data[i + 1]].item)
                end
            end
        elseif type == 8 then
            if data[i + 1] > 0 then
                table.insert(rewards, {data[i + 1], data[i + 2]})
            end
        end
        tempIndex = tempIndex + 1
    end

    tb.aortext_desc.text = descText

    --商店物品展示
    if #rewards > 0 then
        tb.obj_reward:SetActiveE(1)
        vaildate = true
        self:ShowReward(tb.obj_reward, rewards)
        local TextKey
        if self.curId == 3 then
            TextKey = 90032800147
        elseif self.curId == 5 then
            TextKey = 90032800148
        else
            tb.aortext_rewardText:SetActiveE(0)
        end
        tb.aortext_rewardText.text = _G.GetLangPackValue(TextKey)
    else
        tb.obj_reward:SetActiveE(0)
        tb.aortext_rewardText.text = ""
    end

    -- 等级奖励显示
    tb.obj_award:RemoveAllChildren()
    local reward = self.cfg.reward and self.cfg.reward[index] or {}
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        reward,
        tb.obj_award,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
            tran:ShowNumText(true,require("ItemViewBase").NumTextAnchor.RightDown)
            tran.gameObject:SetLocalScaleXYZ(0.64)
            local gotLevelList = require("SociatyModel"):GetInstance():GetBuildAwardLevels()
            local isGot = gotLevelList[index] and true or false
            if isGot then
                tran:SetGou(true)
            elseif index <= self.curLevel then
                tran:SetGou(false)
                tran:ShowEffect(true)
            end
        end,
        function()
            local gotLevelList = require("SociatyModel"):GetInstance():GetBuildAwardLevels()
            if not gotLevelList[index] and self.curLevel >= index then
                local list = {}
                for i = 1, self.curLevel do
                    if not gotLevelList[i] then
                        _G.table.insert(list,i)
                    end
                end
                require("SociatyModel"):GetInstance():GetBuildAward(list,
                function()
                    self:UpdateView()
                    if self.gotAwardCallBack then
                        self.gotAwardCallBack()
                    end
                end
                )
            else
                require "CommonTipManager":GetInstance():OpenTip(self.gameObject, reward[1])
            end
        end
    )

    if vaildate then
        --分割线
        tb.obj_split:SetActiveE(1)
    else
        tb.gameObject:SetActiveE(0)
    end
end

---加载奖励显示
---@param parent SociatyBuildPreviewView._obj_reward_GoTable
---@param rewards number[][]
function SociatyBuildPreviewView:ShowReward(parent, rewards)
    --显示奖励列表
    for i = 1, #rewards do
        local id, num = table.unpack(rewards[i])
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            parent,
            function(item)
                if self:IsNil() then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                    return
                end
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:Show(id, nil, num)

                local data = _G.StorageManager:GetInstance():GetStorageItemData(id)
                local isShowEffect =
                    data and data.Cfg and (data.Cfg.ef_item == 1 or data.Cfg.ef_item == "1") and true or false
                item:ShowFrameEffect(id, isShowEffect)
                item.gameObject:SetSiblingIndexE(0)
            end
        )
    end
end

---处理按钮事件
function SociatyBuildPreviewView:OnClickBtn(go)
    self:Close()
end

return SociatyBuildPreviewView
