---回收所有State节点
---@return void
function SociatyGloryTopView:ReleaseAllPlayerItems()
    if not self.activePlayerItems then
        return
    end
    if not self.releasePlayerItems then
        self.releasePlayerItems = {}
    end
    for _, state in pairs(self.activePlayerItems) do
        table.insert(self.releasePlayerItems, state)
        state.transform:SetParentE(self.go_table.obj_player:GetParent())
        state.gameObject:SetActiveE(0)
    end
    self.activePlayerItems = nil
end

---获取一个State节点
---@param parent Transform|GameObject 父节点
---@return SociatyGloryTopView._obj_player_GoTable
function SociatyGloryTopView:GetPlayerItem(parent)
    ---@type SociatyGloryTopView._obj_player_GoTable
    local state
    if self.releasePlayerItems and #self.releasePlayerItems > 0 then
        state = table.remove(self.releasePlayerItems, 1)
    end
    if not state then
        if AppSetting.IsXzns then
            state = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_player2,
                self.go_table.obj_player:GetParent()))
            UIUtils.IsNeedChangeUI(IsNeedChangeUI.SociatyGloryTopViewRoleNode, state)
        else
            state = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_player, self.go_table.obj_player:GetParent()))
        end
        _G.AddViewBtnClick(state.gameObject, _G.handlerbind(self, self.OnMemberClickBtn, state))
    end

    if not self.activePlayerItems then
        self.activePlayerItems = {}
    end
    table.insert(self.activePlayerItems, state)
    state.gameObject:SetActiveE(1)
    if parent then
        state.transform:SetParentE(parent)
        state.transform:SetAsLastSiblingE()
    end
    return state
end

