end

---@class SociatyGloryTopView : UIBaseView	公会职位一览视图
---@field go_table SociatyGloryTopView_GoTable
---@field fameCount number                                          @名人堂人数配置
---@field masterData SociatyMemberBase                              @会长玩家数据
---@field masterPlayerData any                                      @会长角色数据
---@field scale number                                              @模型缩放倍率
---@field titleScale number                                         @称号缩放倍率
---@field famePlayerItems SociatyGloryTopView._obj_player_GoTable[]     @名人堂Player节点
---@field activePlayerItems SociatyGloryTopView._obj_player_GoTable[]   @使用中的Player节点
---@field releasePlayerItems SociatyGloryTopView._obj_player_GoTable[]  @未使用的Player节点

local SociatyGloryTopView = _G.BaseClass("SociatyGloryTopView", _G.UIBaseView)

function SociatyGloryTopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    ---计算基准缩放倍率
    self.scale = 0.8
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        self.scale = self.scale * _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end

    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    self.RoleTitle = {
        [1] = self.go_table.obj_roleTitle1,
        [2] = self.go_table.obj_roleTitle2,
        [3] = self.go_table.obj_roleTitle3,
        [4] = self.go_table.obj_roleTitle4,
        [5] = self.go_table.obj_roleTitle5
    }
    local discrete_cfg = _G.ConfigManager.discrete_cfg
    self.roleParams = {
        moveX = discrete_cfg[101698][1],    --成员移动X轴
        moveArea = { -6, 6 },               --成员移动Z轴
        idleTime = discrete_cfg[101692][1], --成员驻足时间区间
        moveTime = discrete_cfg[101693][1], --成员移动时间区间
        speed = discrete_cfg[101695][1][1], --移动速度(z值变化/秒)
        scale = discrete_cfg[101696][1][1], --缩放
        startTime = discrete_cfg[101699][1] --缩放
    }

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnMemberRefresh)
end

function SociatyGloryTopView:OnDisable()
    if self.sceneTrans then
        self.sceneTrans:SetActiveE(0)
    end
end

function SociatyGloryTopView:OnEnable()
    if self.sceneTrans then
        self.sceneTrans:SetActiveE(1)
    end
end

function SociatyGloryTopView:OnDestroy()
    self:RemoveAllListener()
end

function SociatyGloryTopView:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyGloryView, self.go_table)
    local model = require("SociatyModel"):GetInstance()

    self.go_table.obj_player:SetActiveE(0)
    self:InitMemebers()

    local masterData = model:GetChairman()
    self:SetMasterData(masterData)
    self:SetMasterPlayerData(masterData)
    self:SetSelfData(model:GetSelfMember())

    self:UpdateMasterModel()

    self:UpdateButtonStates()

    --获取名人堂成员(有职位的不算)
    require("SociatyModel"):GetInstance():GetFameMembers(_G.handler(self, self.InitFameMembers))

    self:AddListener(_G.eSociatyEvent.ExchangeNotice, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeName, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeIcon, self.RefreshPanel)
    self:RefreshPanel()
    self:InitScene()
end

---监听被踢出公会
function SociatyGloryTopView:OnBeKicked()
    self:Close()
end

---监听成员状态刷新
function SociatyGloryTopView:OnMemberRefresh()
    self:InitMemebers()
    self:InitFameMembers()
end

---初始化公会职位信息: 副会长/长老/名人堂
function SociatyGloryTopView:InitMemebers()
    self:ReleaseAllPlayerItems()

    local model = require("SociatyModel"):GetInstance()
    local cfg = _G.ConfigManager.guild_level_cfg[model:GetMasterBuildLevel()]
    if not cfg then
        return
    end
    --副会长/长老: 通过配置
    for index, jobs in ipairs(cfg.num_position) do
        local position, num = table.unpack(jobs)
        local memebers = model:GetMembersByPosition(position)
        --按照目前的美术图工会长老只放得下2个
        local maxNum = 2 --model:GetMaxLocationNum(position)
        for j = 1, maxNum do
            local item = self:GetPlayerItem(self.go_table["obj_type" .. index])
            item.location = position
            item.isFame = false
            item.index = j
            if j > num then
                item.lock = true
            end
            self:SetMemeberData(item, memebers and memebers[j] or nil)
        end
    end
    --名人堂(战力最高的n位玩家, 有职位的不算)
    self.famePlayerItems = {}
    for j = 1, model:GetFameCount() do
        local item = self:GetPlayerItem(self.go_table.obj_type3)
        item.location = ELocationEnum.Member
        item.isFame = true
        item.index = j
        table.insert(self.famePlayerItems, item)
        self:SetMemeberData(item, nil)
    end
end

---加载模型
function SociatyGloryTopView:LoadModels(tb, uid, isChairman, datas)
    if uid then
        ---@type card_cfg 获取角色配置
        local cfg = require "CardCommentManager":GetInstance():CardData(uid, false)
        local cardsid = cfg.card and cfg.card or cfg.id
        ---@type card_cfg
        local cfg_show = require("CardInfoManager").GetCardSkin_ShowCfg(nil, uid)
        local scale = cfg_show.size2 or 1
        -- 清空目标节点
        tb:ClearChildren()
        if not isChairman then
            _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyGloryView .. "Member", _G.GetAutoGoTable(tb:GetParent()))
        end
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.SociatyGloryView)
        -- 加载模型
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            tb,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(tb)
                trans:SetLocalPosition(0, 0, 0)
                if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.SociatyGloryView) then
                    trans:SetLocalScaleXYZ(cfg.size4)
                else
                    trans:SetLocalScale(scale, scale, scale)
                end
                local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                if rolePoint == nil then
                    rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                end
                --- 只有星座女神有神环
                if _G.AppSetting.IsXzns then
                    local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cardsid)
                    if godHaloID ~= 0 then
                        local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                        --- 神环路径，父级路径(加载角色的下面)
                        _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                    end
                    _G.UIUtils.LoadArtifacteffect(trans,cardsid,nil,nil)
                end
            end
        )
    end
end

---初始化名人堂信息
---@param roles role.i_role[]
function SociatyGloryTopView:InitFameMembers(roles)
    local model = require("SociatyModel"):GetInstance()

    if self.famePlayerItems then
        for i = 1, #self.famePlayerItems do
            local uid = roles and roles[i] and roles[i].uid or 0
            local data = uid ~= 0 and model:GetMemberByUid(uid) or nil
            self:SetMemeberData(self.famePlayerItems[i], data and data.Location == ELocationEnum.Member and data or nil)
        end
    end

    --更新自己的信息
    self:SetSelfData(model:GetSelfMember())
end

