---更新公会详细信息
function SociatyGloryTopView:Refresh(data)
    self.go_table.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
    local member =
        self.isRank and data.num .. "/" .. _G.ConfigManager.guild_level_cfg[data.level].num_player or
        data.SociatyMemberModule:GetMemberDesc()
    self.go_table.aortext_Member.text = member

    local level = data:GetMasterBuildLevel()
    local exp, needExp = data:GetBuildExp(data:GetMasterBuildId())

    self.go_table.aortext_SociatyLv.text = tostring(level)
    if needExp == 0 then
        self.go_table.aortext_Ex.text = _G.GetLangPackValue(9002050021)
    else
        self.go_table.aortext_Ex.text = _G.string.format("%s/%s", exp, needExp > 0 and needExp or exp)
    end
    self.go_table.slider_progress.value = needExp > 0 and exp / needExp or 1

    local notice =
        self.isRank and (data.provate_notice ~= "" and data.provate_notice or _G.LangUtil.GetLangPackValue(90021800022)) or
        data.Declaration
    self.go_table.input_Declaration.text = notice
    self.go_table.input_Declaration.enabled = false

    local name = data.Name
    self.go_table.aortext_sociatyName.text = name
end

