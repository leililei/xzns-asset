---刷新会长光环
---@return void
function SociatyGloryTopView:UpdateMasterHalo(rolePoint)
    if self.halo then
        _G.PoolsManager:GetInstance():Despawn(self.halo, _G.ePoolType.Temporary)
        self.halo = nil
    end
    local haloId = self.masterPlayerData and self.masterPlayerData.halo and self.masterPlayerData.halo.sid
    if not haloId or haloId <= 0 then
        return
    end

    local parent = self.roleTrans
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[haloId]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo = trans
            if cfg.type_halo == 2 then
                self.halo:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo:GetParent():GetLocalScale()
                local rate = self.scale
                self.halo:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo:GetChildE(0):SetActiveE(1)
            self.halo:SetEulerAngles(0, 0, 0)
            self.halo:SetLocalPositionToZero()
        end
    )
end

---刷新会长称号
---@return void
function SociatyGloryTopView:UpdateMasterTitle(rolePoint)
    local titleId = self.masterPlayerData and self.masterPlayerData.title and self.masterPlayerData.title.sid

    local parent = self.roleTrans
    if not self.title or _G.IsNil(self.title.gameObject) then
        if not titleId or titleId <= 0 then
            return
        end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if (_G.IsNil(parent)) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.title = go_table
                self:SetTitlePos(self.title, rolePoint)
                go_table.aortext_TextName.text = ""

                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[titleId]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale * self.scale)
                            end
                        )
                        if self.title.item then
                            _G.DestroyObject(self.title.item)
                            self.title.item = nil
                        end
                        self.title.aorrawimage_Title:SetActiveE(1)
                    else
                        self.title.aorrawimage_Title:SetActiveE(0)
                        if self.title.item then
                            _G.DestroyObject(self.title.item)
                            self.title.item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.title.gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.title.item = trans
                                local x, y, z = self.title.aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.title.item:SetLocalScaleXYZ(self.titleScale * self.scale)
                                trans:SetActiveE(1)
                            end
                        )
                    end
                end
            end
        )
    elseif self.title then
        if self.title.item then
            _G.DestroyObject(self.title.item)
            self.title.item = nil
        end
        if not titleId or titleId <= 0 then
            self.title.aorrawimage_Title:SetActiveE(0)
            return
        end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[titleId]
        if cfg.type_title == 1 then
            self.title.aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.title.aorrawimage_Title:SetNativeSize()
                    self.title.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale * self.scale)
                end
            )
            self.title.aorrawimage_Title:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.title.gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.title.item = trans
                    local x, y, z = self.title.aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.title.item:SetLocalScaleXYZ(self.titleScale * self.scale)
                    trans:SetActiveE(1)
                end
            )
            self.title.aorrawimage_Title:SetActiveE(0)
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function SociatyGloryTopView:SetTitlePos(title, rolePoint)
    _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if title and not _G.IsNil(title.gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans
                    if parent == nil then ---快速切换角色时gameObj可能被置位nil
                        return
                    end
                    local position = {}
                    position.x = x
                    position.z = z
                    position.y = y - 0.19
                    local scale = parent:GetLocalScale()
                    local rate = self.scale
                    title.gameObject:SetLocalScaleXYZ(rate * 0.8 / scale)
                    title.transform:SetLocalPositionToZero()
                    title.transform:SetPosition(position.x, position.y, position.z)
                    local lookAt = title.transform:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
                    if _G.IsNil(lookAt) then
                        lookAt = title.transform:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
                    end
                    lookAt:SetData(self.camera.transform, parent)
                end
            end
        end
    )
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function SociatyGloryTopView:LoadRoleModel(rolepath, posIndex, scale)
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() or not self.rankTrans then
                _G.DestroyObject(trans)
                return
            end
            self.roleTrans = trans
            trans:SetParentE(self.rankTrans:GetChildE(posIndex - 1))
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end

            -- self:UpdateMasterHalo(rolePoint)
            -- self:UpdateMasterTitle(rolePoint)
            --- 只有星座女神有神环
        end
    )
end

---清除场景中的角色模型
function SociatyGloryTopView:ClearRoleModel()
    if not self.rankTrans then
        return
    end
    if self.halo then
        _G.PoolsManager:GetInstance():Despawn(self.halo, _G.ePoolType.Temporary)
        self.halo = nil
    end
    if self.title then
        _G.PoolsManager:GetInstance():Despawn(self.title.gameObject, _G.ePoolType.Temporary)
        self.title = nil
    end

    local roleCount = self.rankTrans:GetChildCountE()
    for i = 1, roleCount do
        local temp = self.rankTrans:GetChildE(i - 1)
        local tempCount = temp:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp:GetChildE(0), _G.ePoolType.Temporary)
        end
    end
end

