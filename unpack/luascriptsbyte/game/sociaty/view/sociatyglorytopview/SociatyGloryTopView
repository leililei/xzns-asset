function SociatyGloryTopView:InitScene()
    self.Role = {}
    self.RoleAni = {}
    self.sceneRoot = _G.GameObject("SociatyGloryTopRoot")
    local path = "Scenes/Mingrentang/prefabs/Mingrentang"
    --_G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        function(trans)
            if _G.IsNil(self.sceneRoot) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:ChangeCameraAdaption()
            self.curSceneTrans = trans
            trans:SetLocalPositionToZero()
            _G.TimerManager:GetInstance():GetTimer(1, self.InitRoleModel, self, true, true):Start()
            _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
            --相机高度降低固定值
            self.camera =
                self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                    _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
                )
        end
    )
end

---初始化场景模型
function SociatyGloryTopView:InitRoleModel()
    local SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    local memberModel = SociatySelf.GetMemberModule()
    self.memberList =
        _G.table.chooseToArray(
            memberModel.Member,
            function(_, a)
                return a.Location == ELocationEnum.Member
            end
        )
    _G.SortList(
        self.memberList,
        function(a)
            return a.OfflineTime == 0 and 1 or 0, a.Power
        end
    )
    self.angle = self:GetCameraAngleX()
    self.curMemIndex = {}
    self.startTime = {}
    self:CreateRoleModel(1)
end

function SociatyGloryTopView:CreateRoleModel(index)
    if index > 5 then
        return
    end
    local sid, name, god_halo
    if self.memberList[index] then
        sid = self.memberList[index].Style
        name = self.memberList[index].Name
        god_halo = self.memberList[index].god_halo
    end
    if sid == nil then
        return
    end
    local path = CardInfoManager.GetBattleModelPath(sid, true)
    CardInfoManager.GetRole(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        _G.RoleEffTypeEnum.Fight,
        function(role)
            if self:IsNil() then
                _G.DestroyObject(role)
            end
            self.curMemIndex[index] = index
            local line = (index + 1) // 2
            local area = self.roleParams.moveX[line]
            local isRight = index % 2 == 1
            role:SetPosition(area, 0, isRight and -5 or 5)
            role:SetLocalScaleXYZ(self.roleParams.scale)
            self.Role[index] = role
            self.RoleAni[index] = _G.RoleAnimatorController.GetOrCreateAnimatorController(role)
            local head = self:FindModelPoint(role)
            local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(head, self.go_table.rect_moveRoot)
            self.RoleTitle[index]:SetActiveE(1)
            self.RoleTitle[index]:SetLocalPosition(x, y + 50, 0)
            local tb = _G.GetAutoGoTable(self.RoleTitle[index])
            tb.aortext_name.text = name
            local model = require("SociatyModel"):GetInstance()
            --是否为名人堂玩家
            local isFame = model:IsFameMember(self.memberList[index])

            if isFame then
                tb.aorimage_title:SetActiveE(1)
            else
                tb.aorimage_title:SetActiveE(0)
            end
            self:SetToward(index, isRight)
            if self.startTime[line] == nil then
                self.startTime[line] = self:Random(self.roleParams.startTime[1], self.roleParams.startTime[2])
            end
            _G.DelayDo(self.startTime[line], _G.handlerbind(self, self.PlayMove, index, isRight))
            -- self:PlayMove(index, isRight)
            self:CreateRoleModel(index + 1, false)
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                --- 此处模型有问题 需要再看
                -- local godHaloID = god_halo
                -- local cfg = _G.ConfigManager.card_cfg[sid]
                -- if godHaloID ~= 0 then
                --     local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                --     --- 神环路径，父级路径(加载角色的下面)
                --     _G.UIUtils.LoadGodHalo(effCfg, role, cfg.god_halo_set)
                -- end
                if not table.isEmptyOrNil(self.memberList[index].artifact_skin) then
                    _G.CS.BattleManager.Utils.UpdateArtifact(role,self.memberList[index].artifact_skin[1],self.memberList[index].artifact_skin[2])
                end
            end
        end
    )
end

function SociatyGloryTopView:PlayMove(index, isRight)
    if self:IsNil() then
        return
    end
    self.RoleAni[index]:Play("run_1", true)
    local moveTime = self:Random(self.roleParams.moveTime[1], self.roleParams.moveTime[2])
    local moveDis = moveTime * self.roleParams.speed
    self:DoMoving(index, isRight, moveDis)
end

function SociatyGloryTopView:DoMoving(index, isRight, lastDis)
    if self:IsNil() then
        return
    end
    local role = self.Role[index]
    local x, y, z = role:GetPosition()
    local z1 = isRight and self.roleParams.moveArea[2] or self.roleParams.moveArea[1]
    local dis = _G.math.abs(z1 - z)
    if lastDis > dis then --一次走不完，需调头
        local time = dis / self.roleParams.speed
        local xt, yt = _G.CS.UIUtils.WorldPointToLocalPointInRect(x, y, z1, self.go_table.rect_moveRoot)
        role:DOLocalMoveZ(z1, time):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
            function()
                self:UpdateRoleModel(index, not isRight, lastDis - dis)
                -- self:SetToward(index, not isRight)
                -- self:DoMoving(index, not isRight, lastDis - dis)
            end
        )
        self.RoleTitle[index]:DOLocalMoveX(xt, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    else
        local z2 = isRight and z + lastDis or z - lastDis
        local time = lastDis / self.roleParams.speed
        local xt, yt = _G.CS.UIUtils.WorldPointToLocalPointInRect(x, y, z2, self.go_table.rect_moveRoot)
        role:DOLocalMoveZ(z2, time):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
            function()
                self:PlayIdle(index, isRight)
            end
        )
        self.RoleTitle[index]:DOLocalMoveX(xt, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    end
end

function SociatyGloryTopView:PlayIdle(index, isRight)
    if self:IsNil() then
        return
    end
    self.RoleAni[index]:Play("idle_1", true)
    local idleTime = self:Random(self.roleParams.idleTime[1], self.roleParams.idleTime[2])
    _G.DelayDo(idleTime, _G.handlerbind(self, self.PlayMove, index, isRight))
end

function SociatyGloryTopView:Random(a, b)
    return a + (b - a) * _G.math.random()
end

function SociatyGloryTopView:SetToward(index, isRight)
    if isRight then
        self.Role[index]:SetLocalEulerAngles(0, 0, self.angle)
    else
        self.Role[index]:SetLocalEulerAngles(0, 180, -self.angle)
    end
end

---销毁/创建新模型
function SociatyGloryTopView:UpdateRoleModel(index, isRight, lastDis)
    if self:IsNil() then
        return
    end
    local memIndex = self:GetNextMemberIndex(index)
    if memIndex == index then --无可更换
        self:SetToward(index, isRight)
        self:DoMoving(index, isRight, lastDis)
        return
    end
    _G.DestroyObject(self.Role[index])
    self.Role[index] = nil
    local sid = self.memberList[memIndex].Style
    local name = self.memberList[memIndex].Name
    local path = CardInfoManager.GetBattleModelPath(sid, true)
    self.curMemIndex[index] = memIndex
    CardInfoManager.GetRole(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        _G.RoleEffTypeEnum.Fight,
        function(role)
            if self:IsNil() then
                _G.DestroyObject(role)
            end
            local line = (index + 1) // 2
            local area = self.roleParams.moveX[line]
            role:SetPosition(area, 0, isRight and self.roleParams.moveArea[1] or self.roleParams.moveArea[2])
            role:SetLocalScaleXYZ(self.roleParams.scale)
            self.Role[index] = role
            self.RoleAni[index] = _G.RoleAnimatorController.GetOrCreateAnimatorController(role)
            local head = self:FindModelPoint(role)
            local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(head, self.go_table.rect_moveRoot)
            self.RoleTitle[index]:SetActiveE(1)
            self.RoleTitle[index]:SetLocalPosition(x, y + 50, 0)
            local tb = _G.GetAutoGoTable(self.RoleTitle[index])
            tb.aortext_name.text = name
            local model = require("SociatyModel"):GetInstance()
            --是否为名人堂玩家
            local isFame = model:IsFameMember(self.memberList[index])

            if isFame then
                tb.aorimage_title:SetActiveE(1)
            else
                tb.aorimage_title:SetActiveE(0)
            end
            self:SetToward(index, isRight)
            self:PlayMove(index, isRight)
        end
    )
end

function SociatyGloryTopView:GetNextMemberIndex(index)
    local sum = #self.memberList
    if sum <= 5 then
        return index
    end
    local ready = {}
    local num = 0
    for i = 1, sum do
        if not _G.table.ContainsValue(self.curMemIndex, i) then
            _G.table.insert(ready, i)
            num = num + 1
        end
    end
    return ready[_G.math.random(1, num)]
end

function SociatyGloryTopView:GetCameraAngleX()
    ---@type UnityEngine.Camera
    local mainCamera
    if _G.CS.FrameWork.Graphic.GraphicsManager.Instance then
        mainCamera = _G.CS.FrameWork.Graphic.GraphicsManager.Instance.MainCamera
    end
    return _G.CS.CameraUtils.GetCameraAngleX(mainCamera)
end

function SociatyGloryTopView:FindModelPoint(trans, forceUpdate)
    local rp = trans:GetComponentInChildrenE(_G.typeof(_G.CS.SkeletonBoneReferences))
    if not rp then
        return nil
    end
    local node = rp:Get("Point_Hp")
    if not _G.IsNil(node) then
        rp:ForceUpdate(1) --立即同步一次骨骼位置
        return node
    end
    local node = rp:Get("Point_Head")
    if not _G.IsNil(node) then
        rp:ForceUpdate(1) --立即同步一次骨骼位置
        return node
    end
    return nil
end

