---设置自己的状态
function SociatyGloryTopView:SetSelfData(data)
    self.go_table.aortext_name.text = data.Name
    self.go_table.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.Power)
    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data, 0.65, true, false, true, NONE)

    local model = require("SociatyModel"):GetInstance()
    --是否为名人堂玩家
    local isFame = model:IsFameMember(data)
    --职位信息
    self.go_table.aortext_job.text =
        isFame and _G.GetLangPackValue(91300001707) or _G.GetLangPackValue(model:GetLocationLanguage(data.Location))

    if isFame then
        self.go_table.obj_jobBG1:SetActiveE(0)
        self.go_table.obj_jobBG2:SetActiveE(0)
        self.go_table.obj_jobBG3:SetActiveE(0)
        self.go_table.obj_jobBG9:SetActiveE(0)
        self.go_table.obj_jobBG4:SetActiveE(1)
    else
        self.go_table.obj_jobBG1:SetActiveE(data.Location == ELocationEnum.Chairman and 1 or 0)
        self.go_table.obj_jobBG2:SetActiveE(data.Location == ELocationEnum.CoChairman and 1 or 0)
        self.go_table.obj_jobBG3:SetActiveE(data.Location == ELocationEnum.Elder and 1 or 0)
        self.go_table.obj_jobBG9:SetActiveE(data.Location == ELocationEnum.Member and 1 or 0)
        self.go_table.obj_jobBG4:SetActiveE(0)
    end
end

