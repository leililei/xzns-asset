function SociatyGloryTopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_clickSociatyIcon then
        local SociatyData = require("SociatyModel"):GetInstance().SociatySelf
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyExchangeIconView.Name,
            SociatyData,
            true,
            SociatyData.Banner,
            function(data)
                if data and data.ID ~= SociatyData.Banner then
                    ---@type guild.c2s_guild_set_banner
                    local msg = {}
                    msg.banner = data.ID
                    local SociatyNet = require("SociatyNet")
                    SociatyNet:GetInstance():SetBanner(
                        msg,
                        function()
                            require("SociatyModel"):GetInstance().SociatySelf.Banner = data.ID
                            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeIcon, data.ID)
                            _G.PopWindowManager:GetInstance():ShowAllTips(200116)
                        end
                    )
                end
            end
        )
    elseif go == self.go_table.aorbtn_reward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyGloryRewardView.Name)
    elseif go == self.go_table.aorbtn_socmain then
        self:Close()
        ---公会大厅
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyLobbyView.Name)
        local smv = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if smv then
            smv:DoOpenWindow(_G.ConfigManager.ui_cfg.SociatyLobbyView.Name)
        end
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 128)
    end
end

