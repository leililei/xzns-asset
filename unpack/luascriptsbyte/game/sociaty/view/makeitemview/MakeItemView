---@class MakeItemView : UIBaseView	宴会制作选择界面
---@field public go_table MakeItemView_GoTable GoTable
---@field public cfg guild_feast_cfg_Item 宴会配置
local MakeItemView = _G.BaseClass("MakeItemView", _G.UIBaseView)

function MakeItemView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MakeItemView:OnCreate(id, info, buyCall)
    self.cfg = _G.ConfigManager.guild_feast_cfg[id]
    if not self.cfg then
        self:Close()
    end
    self.Info = info
    self.buyEndCall = buyCall
    self.curNumber = 0
    self:ShowItem()
    self:ChangeNum(1)
end

local btnFunc = {
    ["@_aorbtn_CloseView"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Max"] = function(self)
        self:ChangeNum(self:GetMax())
    end,
    ["@_aorbtn_Sub10"] = function(self)
        self:ChangeNum(-10)
    end,
    ["@_aorbtn_Add10"] = function(self)
        self:ChangeNum(10)
    end,
    ["@_aorbtn_Sub1"] = function(self)
        self:ChangeNum(-1)
    end,
    ["@_aorbtn_Add1"] = function(self)
        self:ChangeNum(1)
    end,
    ["@_aorbtn_Cancel"] = function(self)
        self:Close()
    end,
    ["@_aorbtn_Done"] = function(self)
        self:Buy()
    end
}

---按钮点击事件在这里派发
function MakeItemView:OnClickBtn(go)
    local name = go:GetName()
    if btnFunc[name] then
        btnFunc[name](self)
    end
end

function MakeItemView:ShowItem()
    local itemSid = self.cfg.materials[1]
    local storageManager = _G.StorageManager:GetInstance()
    local _, storageID = storageManager:CheckSidType(itemSid)
    local count = storageManager:GetItemCountByID(storageID, itemSid)
    self.HasMatNum = count
    local item = storageManager:GetItemDataClass(itemSid, count)
    if not item then
        self:Close()
    end
    self.go_table.aortext_ItemName.text = item:GetName()
    self.go_table.aortext_describe.text = item:GetDescribe()
    self.go_table.aortext_ItemNum.text = count
    storageManager:GetItemBaseView(itemSid, 0, self.go_table.obj_Item, _G.handler(self, self.OnItemShowCall))
end

function MakeItemView:GetMax()
    local needNum = self.cfg.materials[2] - self.Info.count
    if needNum <= 0 then
        needNum = self.HasMatNum
    else
        if self.HasMatNum < needNum then
            needNum = self.HasMatNum
        end
    end
    return needNum
end

function MakeItemView:ChangeNum(num)
    self.curNumber = self.curNumber + num

    local max = self:GetMax()
    if self.curNumber > max then
        self.curNumber = max
    end
    self.go_table.aortext_Number.text = self.curNumber
end

function MakeItemView:Buy()
    if self.curNumber > 0 then
        ---@type guild.c2s_guild_feast_submit
        local msg = {}
        msg.fid = self.cfg.id
        msg.mid = self.cfg.materials[1]
        msg.m_num = self.curNumber
        require("SociatyNet"):GetInstance():SubmitMaterial(msg, _G.handler(self, self.OnBuyCall))
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("没有选数量")
        end
    end
end

function MakeItemView:OnItemShowCall(view)
    view:ShowNumText(false)
    view.gameObject:SetLocalPosition(0, 0, 0)
end

function MakeItemView:OnBuyCall(data)
    _G.StorageManager:GetInstance():ConsumeItem(203060100, 0, self.curNumber)
    if data.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    end
    if self.buyEndCall then
        self.buyEndCall(self.curNumber)
    end
    self:Close()
end

return MakeItemView
