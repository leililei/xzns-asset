---@class SociatyBuildRecordView : UIBaseView	公会建造日志视图
---@field go_table SociatyBuildRecordView_GoTable
---@field lstData ViewData[]                                                @显示列表数据
---@field itemMapping table<any,SociatyBuildRecordView._obj_item_GoTable>   @GoTable实例映射列表
local SociatyBuildRecordView = _G.BaseClass("SociatyBuildRecordView", _G.UIBaseView)

function SociatyBuildRecordView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_table.obj_nothing:SetActiveE(0)

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
end
function SociatyBuildRecordView:OnDestroy()
    self:RemoveAllListener()
end
---监听被踢出公会
function SociatyBuildRecordView:OnBeKicked()
    self:Close()
end

function SociatyBuildRecordView:OnCreate()
    --初始化列表
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.OnRefreshItem))

    --请求日志数据
    require("SociatyModel"):GetInstance():GetLog(2, _G.handler(self, self.OnLogCallback))
end

---监听日志回调事件
---@param msg guild.s2c_guild_get_logs
function SociatyBuildRecordView:OnLogCallback(msg)
    self.lstData = {}
    if not msg or not msg.logs then
        self.go_table.scrollloopvectical_list:UpdateCount(0)
        self.go_table.obj_nothing:SetActiveE(1)
        return
    end

    --按照时间从大到小排序(时间戳越大日期越靠后)
    _G.SortList(
        msg.logs,
        function(v)
            return v.value2
        end
    )

    ---@type table<string,ViewData> 日期映射字典
    local parentMapping = {}
    ---@param date string       日期
    ---@param time string       时间
    ---@param text string       消息内容主体
    local function addChild(date, time, text)
        local parent = parentMapping[date]
        if not parent then
            parent = {
                type = "parent",
                text = date,
                children = {},
                expand = false
            }
            parentMapping[date] = parent
            table.insert(self.lstData, parent)
        end
        table.insert(
            parent.children,
            {
                type = "child",
                time = time,
                text = text
            }
        )
    end

    ---@type table<number,string> 建筑名称映射
    local buildNameMapping = {}
    ---@param sid number
    local function getBuildName(sid)
        local name = buildNameMapping[sid]
        if not name then
            name = _G.GetLangPackValue(_G.ConfigManager.guild_unit_cfg[sid].name)
            buildNameMapping[sid] = name
        end
        return name
    end

    ---捐献模板字符串
    local detailModel = _G.GetLangPackValue(90031500046)

    --时间格式化字符串: os.date("%Y-%m-%d %H:%M:%S", os.time())
    --示例: 2024-08-01 00:00:00
    for _, log in ipairs(msg.logs) do
        addChild(
        _G.TimeUtil.date("%Y-%m-%d", log.value2),
        _G.TimeUtil.date("%H:%M", log.value2),
            string.format(detailModel, log.value1, getBuildName(log.value3), log.value4)
        )
    end

    --默认展开第一个大节点
    local first = self.lstData[1]
    if first then
        first.expand = true
        for index, child in ipairs(first.children) do
            table.insert(self.lstData, index + 1, child)
        end
    end

    self.go_table.scrollloopvectical_list:UpdateCount(#self.lstData)
    --self.go_table.scrollloopvectical_list:UpdateAllItem()

    self.go_table.obj_nothing:SetActiveE(#self.lstData == 0 and 1 or 0)
end

---刷新列表元素
---@return void
function SociatyBuildRecordView:OnRefreshItem(index, obj)
    if not self.itemMapping then
        self.itemMapping = {}
    end
    local item = self.itemMapping[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnClickListBtn, item))
        self.itemMapping[obj:GetInstanceIDE()] = item
    end

    --C#下标从0开始, lua下标从1开始
    local data = self.lstData[index + 1]
    item.data = data
    item.obj_title:SetActiveE(data.type == "parent" and 1 or 0)
    item.obj_content:SetActiveE(data.type == "child" and 1 or 0)

    if data.type == "parent" then
        item.aortext_title.text = data.text
        item.aorbtn_reduce:SetActiveE(data.expand and 1 or 0)
        item.aorbtn_expand:SetActiveE(data.expand and 0 or 1)
    else
        item.aortext_date.text = data.time
        item.aortext_details.text = data.text
    end
end

---处理标题点击事件
function SociatyBuildRecordView:OnClickListBtn(_, _, item)
    ---@type ViewData
    local data = item.data
    local index = -1
    for i, d in pairs(self.lstData) do
        if data == d then
            index = i
            break
        end
    end
    if index < 0 then
        return
    end

    if data.expand then
        data.expand = false
        for i = 1, #data.children do
            table.remove(self.lstData, index + 1)
        end
    else
        data.expand = true
        for i, child in ipairs(data.children) do
            table.insert(self.lstData, index + i, child)
        end
    end
    ---更新列表显示
    --self.go_table.scrollloopvectical_list:UpdateCount(#self.lstData)
    self.go_table.scrollloopvectical_list:SetCount(#self.lstData, 1)
    --self.go_table.scrollloopvectical_list:UpdateAllItemNew()
end
---处理按钮事件
function SociatyBuildRecordView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    end
end

--region ------------------类型定义------------------

---@class ViewData  定义数据类型
---@field type "parent"|"child"
---@field text string       定义主要文本内容:
---@field time string       定义消息时间
---@field children ViewData[] 子内容数据
---@field expand boolean    是否已展开子消息

--endregion

return SociatyBuildRecordView
