---@class SociatyDamageRankView : UIBaseView    中文描述
---@field public go_table SociatyDamageRankView_GoTable GoTable
local SociatyDamageRankView = _G.BaseClass("SociatyDamageRankView", _G.UIBaseView)
---@type SociatyDamageRankView_GoTable

---@type SociatyMemberModule

local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}
local rankBg = {
    [1] = "ui_diban1",
    [2] = "ui_diban2",
    [3] = "ui_diban3",
    [4] = "TY_img_kuang"
}

local Gradient = {
    [1] = { "FFCB28", "ffffff", "110802" },
    [2] = { "E930FF", "ffffff", "110802" },
    [3] = { "1F7296", "ffffff", "110802" },
}

function SociatyDamageRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data guild.s2c_guild_get_requests 返回PB数据
function SociatyDamageRankView:OnCreate(data)
    self.feastData = require "SociatyModel":GetInstance().feastData
    self:Show(data)
    self:InitInfoView()
    self:UpdateLevelView()
end

function SociatyDamageRankView:InitInfoView()
    self.SociatySelf = require("SociatyModel"):GetInstance().SociatySelf
    self.memberModel = self.SociatySelf.GetMemberModule()
    self.memberModel:SortMemberByView()
    self.memberList = {}
    local locationEnum = require "MemberEnum".ELocationEnum
    for _, v in pairs(self.memberModel.Member) do
        if v.Location == locationEnum.Chairman then
            self.chairman = v
        else
            _G.table.insert(self.memberList, v)
        end
    end
    _G.SortList(
        self.memberList,
        function(a)
            return a.OfflineTime == 0 and 1 or 0, -a.Location, a.Power
        end
    )
    self.go_table.aorrawimage_icon1:LoadImage(_G.ConfigManager.guild_portrait_cfg[self.SociatySelf.Banner].portrait)
    self.go_table.aortext_sociatyName.text = self.SociatySelf.Name
    self.go_table.aortext_memberNum.text = self.SociatySelf.SociatyMemberModule:GetMemberDesc()
end

---更新等级信息
function SociatyDamageRankView:UpdateLevelView()
    local level = self.SociatySelf:GetMasterBuildLevel()
    local exp, needExp = self.SociatySelf:GetBuildExp(self.SociatySelf:GetMasterBuildId())

    self.go_table.aortext_level.text = tostring(level)
    if needExp == 0 then
        self.go_table.aortext_exp.text = _G.GetLangPackValue(9002050021)
    else
        self.go_table.aortext_exp.text = _G.string.format("%s/%s", exp, needExp > 0 and needExp or exp)
    end
    self.go_table.slider_progress.value = needExp > 0 and exp / needExp or 1
end

function SociatyDamageRankView:Show(data)
    self.SociatyItemList = {}
    self.Ranks = data or {}
    local len = #self.Ranks
    self.go_table.scrollloopvectical_memberList:InitItemData(_G.math.max(len,3), _G.handler(self, self.OnRefreshLoopListItem))
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_rank" .. i])
        if self.Ranks[i] then
            local data = self.Ranks[i]
            item.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
            item.aortext_name.text = data.name
            item.aortext_active.text = data.seven_day_live or 0
            item.aortext_damage.text = data.value[1] and _G.GameUtil.NumberToUnitStr(data.value[1]) or 0
            item.obj_have:SetActiveE(1)
            item.aortext_nil:SetActiveE(0)
        else
            item.obj_have:SetActiveE(0)
            item.aortext_nil:SetActiveE(1)
        end
    end
    self:SetSelfInfo()
end

function SociatyDamageRankView:SetSelfInfo()
    local data = require("SociatyModel"):GetInstance().SociatySelf
    if data then
        local selfRankNum = 100000
        local selfRankDamage
        for k, v in ipairs(self.Ranks) do
            if v.uid == data.Uid then
                selfRankNum = k
                selfRankDamage = v.value[1]
                break
            end
        end
        if selfRankDamage == nil then
            selfRankDamage = 0
            if self.feastData.dps_rank then
                for i, v in ipairs(self.feastData.dps_rank) do
                    selfRankDamage = selfRankDamage + v.value
                end
            end
        end
        self.go_table.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
        self.go_table.aortext_name.text = data.Name
        self.go_table.aortext_num.text = _G.GameUtil.NumberToUnitStr(selfRankDamage)
        self.go_table.aorimage_rankBg:SetActiveE(selfRankNum <= 3 and 1 or 0)
        self.go_table.aortext_Rank:SetActiveE(selfRankNum <= 3 and 1 or 0)
        self.go_table.obj_rankBg2:SetActiveE(selfRankNum <= 3 and 0 or 1)
        self:SetItemRankInfo(self.go_table, selfRankNum)
    end
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function SociatyDamageRankView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type SociatyDamageRankView._obj_SociatyItem_GoTable
    local ctrl = self.SociatyItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.SociatyItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.Ranks[eIndex]
    ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
    ctrl.aortext_Rank:SetActiveE(eIndex <= 3 and 1 or 0)
    ctrl.obj_rankBg2:SetActiveE(eIndex <= 3 and 0 or 1)
    if data then
        ctrl.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
        ctrl.aortext_name.text = data.name
        --ctrl.aortext_president.text = data.roles[1].role.name
        --ctrl.aortext_level.text = _G.LangUtil.GetLangPackValue(9002010022, data.level)
        --ctrl.aortext_active.text = data.seven_day_live or 0
        ctrl.aortext_num.text = _G.GameUtil.NumberToUnitStr(data.value[1])
        ctrl.uid = data.uid
        ctrl.aorbtn_click:SetActiveE(1)
        ctrl.obj_icon:SetActiveE(1)
        ctrl.aortext_no:SetActiveE(0)
    else
        ctrl.aortext_name.text = ""
        ctrl.aortext_num.text = ""
        ctrl.obj_icon:SetActiveE(0)
        ctrl.aortext_no:SetActiveE(1)
    end
    self:SetItemRankInfo(ctrl, eIndex)
    return item
end

function SociatyDamageRankView:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_bg.SpriteName = rankBg[eIndex <= 3 and eIndex or 4]
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]
        ctrl.aorimage_bg.SpriteName = rankBg[eIndex <= 3 and eIndex or 4]
        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    elseif eIndex == 100000 then
        ctrl.aortext_rankNum.text = _G.ConfigManager.language_package_cfg[90022900040]
    else
        ctrl.aortext_rankNum.text = eIndex
    end
end

function SociatyDamageRankView:OnItemClickBtn(go, isOn, tb)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyInfoPreviewView.Name, tb.uid)
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject 按钮
function SociatyDamageRankView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        self:Close()
        return
    elseif name == "@_aorbtn_award" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyDamageRankAwardView.Name)
    end
end

function SociatyDamageRankView:OnDestroy()
end

---析构函数
function SociatyDamageRankView:Dispose()
end

return SociatyDamageRankView