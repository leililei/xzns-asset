local base = require "EventViewBase"
---@class SociatyLimiteChapterView : UIBaseView	中文描述
---@field public go_table SociatyLimiteChapterView_GoTable GoTable
local SociatyLimiteChapterView = _G.BaseClass("SociatyLimiteChapterView", base)

function SociatyLimiteChapterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyLimiteChapterView:OnCreate(doneCall, closeCall)
    base.OnCreate(self, doneCall, closeCall)
    self.maxLimitChapter = _G.ConfigManager.discrete_cfg[101651][1][1]
    self.go_table.input_level1.onEndEdit:AddListener(_G.handler(self, self.OnEndInputChapter))
    self.go_table.aorbtn_add1.LongPress = true
    self.go_table.aorbtn_add1.onLongPress = function()
        self:ChangeChapter(1)
    end
    self.go_table.aorbtn_reduce1.LongPress = true
    self.go_table.aorbtn_reduce1.onLongPress = function()
        self:ChangeChapter(-1)
    end

    self.SociatyDataSelf = require("SociatyModel"):GetInstance().SociatySelf

    self.limitChapter = self.SociatyDataSelf.LimitChapter or 1
    self.go_table.input_level1.text = _G.LangUtil.GetLangPackValue(90021800344, self.limitChapter)
end

function SociatyLimiteChapterView:ChangeChapter(num)
    self.limitChapter = self.limitChapter + num
    if self.limitChapter <= 1 then
        self.limitChapter = 1
    elseif self.limitChapter >= self.maxLimitChapter then
        self.limitChapter = self.maxLimitChapter
    end
    self.go_table.input_level1.text = _G.LangUtil.GetLangPackValue(90021800344, self.limitChapter)
end


function SociatyLimiteChapterView:OnEndInputChapter(input)
    local chapter = _G.tonumber(input)
    if nil ~= chapter then
        self.limitChapter = chapter
    end
    self:ChangeChapter(0)
end

---按钮点击事件在这里派发
function SociatyLimiteChapterView:OnClickBtn(go)
    if go == self.go_table.aorbtn_add1 then
        self:ChangeChapter(1)
    elseif go == self.go_table.aorbtn_reduce1 then
        self:ChangeChapter(-1)
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_cancel then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if self.SociatyDataSelf.LimitChapter ~= self.limitChapter then
            require "SociatyData".GetMemberModule():SaveCondition(
                self.SociatyDataSelf.LimitLevel,
                self.limitChapter,
                self.SociatyDataSelf.NeedApproval,
                function()
                    self:Close()
                    _G.PopWindowManager:GetInstance():ShowAllTips(250153)
                end
            )
        end
    end
end

return SociatyLimiteChapterView