function SociatyMemberView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_down then
        MD:DoAppoint(self.chooseData.Uid, ELocationEnum.Member)
    elseif go == self.go_table.aorbtn_kick then
        MD:KickOut(self.chooseData)
    elseif go == self.go_table.aorbtn_up then
        MD:DoAppoint(self.chooseData.Uid, ELocationEnum.CoChairman)
    elseif go == self.go_table.aorbtn_switch then
        MD:SwitchChairman(
            self.chooseData.Uid,
            function()
                self.owerView:Close()
            end
        )
    end
end

