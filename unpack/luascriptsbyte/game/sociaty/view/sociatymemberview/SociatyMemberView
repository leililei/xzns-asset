function SociatyMemberView:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local id = item:GetInstanceIDE()
    local eIndex = index + 1
    ---@type SociatyLobbyView._obj_SociatyItem_GoTable
    local ctrl = _G.GetAutoGoTable(item)
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl, eIndex))
    self.SociatyItemList[id] = ctrl
    --self.IndexToId[eIndex] = id
    self:RefreshItemShow(ctrl, eIndex)
end

function SociatyMemberView:OnItemClickBtn(go, _, ctrl, eIndex)
    -- ctrl.index = eIndex
    local data = MD:GetMemberByIndex(eIndex)
    -- if data.uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
    --     _G.PopWindowManager:GetInstance():ShowAllTips(620109)
    -- else
    --     _G.SystemSettingManager:GetInstance():OpenView(data.uid)
    -- end
    if go == ctrl.aorbtn_appoint then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyPositionChangeView.Name, data)
    end
    if go == ctrl.aorbtn_appoint1 then
        local isPositionSet = self.data.CfgItem.position_set and (data.Uid ~= _G.PlayerModel:GetInstance():GetPlayerUid()) and
            self.data.Location < data.Location
        local isKick = self.data.CfgItem.kick_out and (data.Uid ~= _G.PlayerModel:GetInstance():GetPlayerUid()) and
            self.data.Location < data.Location
        if isPositionSet or isKick then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyPositionChangeView.Name, data)
        end
    end
end
---更新按钮显示
function SociatyMemberView:ShowBtns()
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_up,
        self.chooseData and self.sociatyData.CfgItem.position_set and
            self.chooseData.Location == require "MemberEnum".ELocationEnum.Member
    )
    local curNum = MD:GetOfficerCount(require "MemberEnum".ELocationEnum.CoChairman)
    local maxNum = MD:GetLocationMax(require "MemberEnum".ELocationEnum.CoChairman)
    if maxNum <= curNum then
        self.go_table.aorbtn_up:SetGray(true)
        self.go_table.aortext_up.color = _G.ColorTools.FormatColorByString("414141")
    else
        self.go_table.aorbtn_up:SetGray(false)
        self.go_table.aortext_up.color = _G.ColorTools.FormatColorByString("862F26")
    end

    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_kick,
        self.chooseData and self.sociatyData.CfgItem.kick_out and self.sociatyData.Location < self.chooseData.Location
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_switch,
        self.chooseData and self.sociatyData.CfgItem.position_set and
            self.chooseData.Location ~= require "MemberEnum".ELocationEnum.Chairman
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_down,
        self.chooseData and self.sociatyData.CfgItem.position_set and
            self.chooseData.Location == require "MemberEnum".ELocationEnum.CoChairman
    )
end

---刷新单元格文本颜色显示
---@param ctrl SociatyLobbyView._obj_SociatyItem_GoTable
---@param eIndex number
function SociatyMemberView:RefreshItemShow(ctrl, eIndex)
    ctrl.index = eIndex
    local data = MD:GetMemberByIndex(eIndex)
    if data then
        ctrl.aortext_name.text = data.Name
        ctrl.aortext_point.text = data.WeekVp
        ctrl.aortext_online.text = data.OfflineDesc1
        ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.Power)

        for i = 1, 4 do
            ctrl["aorimage_title" .. i]:SetActiveE(0)
        end

        local model = require("SociatyModel"):GetInstance()
        --是否为名人堂玩家
        if data.Location > 3 then
            local isFame = model:IsFameMember(data)
            if isFame then
                ctrl.aortext_pro:SetActiveE(0)
                ctrl.obj_proimage:SetActiveE(1)
                ctrl["aorimage_title4"]:SetActiveE(1)
            else
                ctrl.aortext_pro:SetActiveE(1)
                ctrl.obj_proimage:SetActiveE(0)
                ctrl.aortext_pro.text = SociatyMemberBase:GetLocationName(data.Location)
            end
        else
            ctrl.aortext_pro:SetActiveE(0)
            ctrl.obj_proimage:SetActiveE(1)
            ctrl["aorimage_title" .. data.Location]:SetActiveE(1)
        end
        ctrl.aortext_donate.text = data.donate
        if data.progress then
            local cfg = _G.ConfigManager.afk_cfg[data.progress]
            if cfg then
                ctrl.aortext_progress.text = _G.string.format("%s-%s", cfg.chapter, cfg.section)
            else
                ctrl.aortext_progress.text = "1-1"
            end
        else
            ctrl.aortext_progress.text = "1-1"
        end
        --ctrl.aorrawimage_position:LoadImage(_G.SociatyPositionIconName[data.Location])
        local isPositionSet = self.data.CfgItem.position_set and (data.Uid ~= _G.PlayerModel:GetInstance():GetPlayerUid()) and
            self.data.Location < data.Location
        local isKick = self.data.CfgItem.kick_out and (data.Uid ~= _G.PlayerModel:GetInstance():GetPlayerUid()) and
            self.data.Location < data.Location
        --ctrl.aorbtn_appoint:SetActiveE((isPositionSet or isKick) and 1 or 0)
        ctrl.aorbtn_appoint:SetActiveE(0)
        UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data, 0.57, true, true, true)
        -- if data.Uid == self.chooseData.Uid then
        --     self.chooseItem = ctrl
        --     _G.GameUtil.SetActiveByCondition(ctrl.obj_choose, true)
        -- else
        --     _G.GameUtil.SetActiveByCondition(ctrl.obj_choose, false)
        -- end
    end
end

