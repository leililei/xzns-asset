        ---@type SociatyData
        local soc = self.SociatyList[i]
        if _G.PlayerModel:GetInstance().role_lv >= soc.LimitLevel and not soc:IsMax() then
            if not self:IsInRequests(soc.Uid) then
                if soc.NeedApproval == 0 then
                    chooseSociaty[index] = soc.Uid
                    index = index + 1
                    if index > max then
                        break
                    end
                else
                    _G.table.insert(other, soc.Uid)
                end
            end
        end
    end
    --4299262263306
    local count = #chooseSociaty
    if count < max then
        local coutn2 = #other
        for i = 1, coutn2 do
            chooseSociaty[index] = other[i]
            index = index + 1
            if index > max then
                break
            end
        end
    end
    return chooseSociaty
end

---根据搜索字符查询匹配公会
----@param str string 搜索关键字
function SociatyJoinView:GetSociatyByStr(str)
    local list = {}
    for _, v in pairs(self.SociatyList) do
        if _G.string.contains(v.Name, str) then
            table.insert(list, v)
        end
    end
    return list
end

function SociatyJoinView:OnDestroy()
    for _, value in pairs(self.SociatyList) do
        value:Dispose()
    end
    self.SociatyList = nil
    self.SociatyItemGotableList = nil
    self.SociatyItemList = nil
end

return SociatyJoinView
