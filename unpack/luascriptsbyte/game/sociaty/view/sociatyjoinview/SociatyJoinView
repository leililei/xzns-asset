---返回推荐列表
---@param msg rank.s2c_rank_get_guild_recommend 结构
---@param isUpdate boolean 是否为更新方式请求
---@param resetPos boolean 刷新位置
function SociatyJoinView:GetGuildRecommendBack(msg, isUpdate, resetPos)
    self.go_table.obj_panel:SetActiveE(1)
    self:InitTimer()
    self.SociatyList = {}
    if msg.guilds then
        for i = 1, #msg.guilds do
            ---@type guild.i_guild
            local guild = msg.guilds[i]
            -- local levelCfg = _G.ConfigManager.guild_level_cfg[guild.level]
            ---人满了也需要显示出来
            -- if guild.num < levelCfg.num_player then
            ---@type SociatyData
            local sociaty = SociatyData.New()
            sociaty:Parse(guild)
            table.insert(self.SociatyList, sociaty)
            -- end
        end
    else
        self.GetGuildIndex = self.GetGuildDragEndIndex

        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>查询推荐列表数据空</color>")
        end
        if #self.SociatyList <= 0 then
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_IsNil, true)
            --_G.GameUtil.SetActiveByCondition(self.go_table.obj_SociatyInfoPanel, false)
        end
        return
    end

    -- ---排序规则：本周活跃>等级（人数已满的公会隐藏）>人数>id
    -- ---@param sociaty SociatyData
    -- _G.SortList(
    --     self.SociatyList,
    --     function(sociaty)
    --         return sociaty.SevenDayLive, sociaty.Level, sociaty.SociatyMemberModule:GetCurMemberCount(), sociaty.Uid
    --     end
    -- )
    ---乱序排列
    _G.SortList(
            self.SociatyList,
            function(sociaty)
                local num = _G.math.random(1, 40)
                return -num, sociaty.Uid
            end
    )
    local count = #self.SociatyList
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_IsNil, count <= 0)
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_SociatyInfoPanel, count > 0)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_have, count > 0)

    if nil == self.ChooseIndex then
        self.ChooseIndex = 1
    end
    ---更新的话直接刷新
    if isUpdate then
        self.go_table.scrollloopvectical_SociatyList:UpdateCount(#self.SociatyList)
    else
        self.go_table.scrollloopvectical_SociatyList:InitItemData(
                #self.SociatyList,
                _G.handler(self, self.RefreshRenItem)
        )
        self.InitLoopList = true
    end

    ---选择一个公会

    --if _G.AppSetting.DEBUG then
    --    _G.Log(self.ChooseIndex, "当前选中公会")
    --end
    --self:OnItemClickBtn(nil, nil)
end

---@param looplist2 SuperScrollView.LoopListView2 滚动组件
---@param index number 该数据的索引   0起始
function SociatyJoinView:RefreshRenItem(index, item)
    if index < 0 then
        return
    end
    local eIndex = index + 1
    local id = item:GetInstanceIDE()
    ---@type SociatyJoinView._obj_SociatyItem_GoTable
    local itemGotable = self.SociatyItemList[id]
    if not itemGotable then
        itemGotable = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, itemGotable))
        self.SociatyItemList[id] = itemGotable
    end
    self.SociatyItemList[eIndex] = item

    itemGotable.index = eIndex
    ---@type SociatyData
    local sociaty = self.SociatyList[eIndex]
    itemGotable.aortext_name.text = sociaty.Name
    --itemGotable.aortext_lv.text = sociaty.Level
    itemGotable.aortext_president.text = sociaty.SociatyMemberModule.Member[1].Name
    itemGotable.aorrawimage_icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[sociaty.Banner].portrait)
    if sociaty:IsMax() then
        itemGotable.aortext_num.text = _G.LangUtil.GetLangPackValue(90022501044) .. "：" .. "<color=#076815>" ..
                sociaty.SociatyMemberModule:GetMaxMemberNum() .. "</color>/" ..
                sociaty.SociatyMemberModule:GetMaxMemberNum()
    else
        itemGotable.aortext_num.text = _G.LangUtil.GetLangPackValue(90022501044) .. "：" .. "<color=#076815>" ..
                sociaty.SociatyMemberModule:GetCurMemberCount() .. "</color>/" ..
                sociaty.SociatyMemberModule:GetMaxMemberNum()
    end
    local power = sociaty.GuildPower or 0
    itemGotable.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
    --itemGotable.aortext_point.text = sociaty.SevenDayLive
    --itemGotable.aortext_approve.text = self:GetApprovalStr(sociaty.NeedApproval)
    itemGotable.aortext_condition.text = self:GetConditionStr(sociaty.LimitChapter or 1)

    itemGotable.aortext_level.text = _G.LangUtil.GetLangPackValue(9002010022, sociaty.Level)
    _G.GameUtil.SetActiveByCondition(itemGotable.aorbtn_Applyed, false)

    local curChapter = require "AfkModel":GetInstance():GetCurAfkChapter()
    itemGotable.aortext_condition:SetActiveE(0)
    local canJoin = true

    if sociaty.LimitLevel > _G.PlayerModel:GetInstance().role_lv or
            sociaty.LimitChapter > curChapter or
            sociaty.NeedApproval == 2
    then
        if sociaty.LimitLevel > _G.PlayerModel:GetInstance().role_lv or sociaty.LimitChapter > curChapter then
            --itemGotable.aorimage_limit:SetGray(true)
            itemGotable.aortext_condition:SetActiveE(1)
            canJoin = false
        end
    end
    _G.GameUtil.SetActiveByCondition(itemGotable.aorbtn_Join, canJoin)

    if self:IsInRequests(sociaty.Uid) then
        itemGotable.aorbtn_Join:SetActiveE(0)
        itemGotable.aorbtn_Applyed:SetActiveE(1)
    end
    itemGotable.uid = sociaty.Uid
    return item
end

