function SociatyJoinView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.GetGuildIndex = 1
    self.GetGuildDragEndIndex = 1
    self.ListType = 1
    self.InitLoopList = false
    self.ChooseIndex = 1
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
end

-- 启动
function SociatyJoinView:OnCreate(isHide)
    ---是否还有更多的重名公会
    self.Page = 1
    self.SociatyList = {}
    self.SociatyItemGotableList = {}
    self.SociatyItemList = {}
    self.ListType = 1
    self.isHide = isHide
    --self.SociatyInfoPanel = self:AddComponent(self.go_table.obj_SociatyInfoPanel, SociatyInfoPanel.New(self))
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_input, 60, nil, true)
    self.go_table.obj_panel:SetActiveE(0)
    self:GetSociatyRecommedList()
    --self:AddListener(_G.eSociatyEvent.RoleRefuseRequest, self.DoRoleRefuseRequest)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_show, not self.isHide)
    if isHide then
        self.go_table.aortext_nil.text = _G.LangUtil.GetLangPackValue(90021800168)
    else
        self.go_table.aortext_nil.text = _G.LangUtil.GetLangPackValue(90021800063)
    end
    self:InitView()
end

function SociatyJoinView:OnEnable()
end

function SociatyJoinView:OnDisable()
    if self.joinTimer then
        self.joinTimer:Stop()
        self.joinTimer = nil
    end
end

function SociatyJoinView:InitView()
    local resources = _G.ConfigManager.ui_cfg.SociatyJoinView.resources
    self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
    )
    self:AddComponent(
            self.go_table.obj_PlayerHead,
            require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )
    self:ChangeView()
end

function SociatyJoinView:InitTimer()
    local cd, time = SociatyModel:GetInstance():IsCding()
    self.go_table.aortext_time:SetActiveE(cd and 1 or 0)
    if cd then
        self:UpdateJoinTime()
        if not self.joinTimer then
            self.joinTimer = _G.TimerManager:GetInstance():GetTimer(
                    1,
                    self.UpdateJoinTime,
                    self,
                    false,
                    false,
                    true
            )
            self.joinTimer:Start()
        end
    end
end

---嵌入主界面公会面板
function SociatyJoinView:ChangeView()
    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if mainView then
        if not SociatyModel:GetInstance().parent then
            SociatyModel:GetInstance().parent = mainView.go_table.obj_sociaty
        end
        mainView.go_table.toggle_sociaty.isOn = true
        mainView.go_table.obj_sociaty:SetActiveE(1)
        for _, v in pairs(otherName) do
            mainView.go_table["toggle_" .. v].isOn = false
            mainView.go_table["obj_" .. v]:SetActiveE(0)
        end
        self.gameObject:SetParentE(SociatyModel:GetInstance().parent)
        _G.UIManager:GetInstance():ChangeCanvasOrder(_G.ConfigManager.ui_cfg.SociatyJoinView.Name, 50, true)
    end
end

