---快速搜索检测
---@param guilds guild.i_guild[]
function SociatyJoinView:CheckQJoin(guilds)
    ---@type guild.i_guild
    local chooseSociaty
    for i = 1, #guilds do
        ---@type guild.i_guild
        local soc = guilds[i]
        local levelCfg = _G.ConfigManager.guild_level_cfg[soc.level]
        if _G.PlayerModel:GetInstance().role_lv >= soc.join_lv and soc.is_check == 0 and soc.num < levelCfg.num_player then
            chooseSociaty = soc
            break
        end
    end

    if _G.AppSetting.DEBUG then
        _G.Log(chooseSociaty, "快速加入筛选结果")
    end
    if chooseSociaty then
        if self:IsInRequests(chooseSociaty.uid) then
            return
        end
        local msg = {}
        msg.uid = { chooseSociaty.uid }
        SociatyNet:GetInstance():Request(msg, _G.handler(self, self.RequestBack))
    else
        --end

        if _G.AppSetting.DEBUG then
            _G.Log("没有找到可快速进入的公会")
        end
        -- if self.TempIndex < self.TempMaxIndex then
        --     self:GetRecommedMore()
        -- else
        _G.PopWindowManager:GetInstance():ShowAllTips(250103)
    end
end

---搜索回调
---@param msg guild.s2c_guild_select
function SociatyJoinView:SelectBack(msg)
    if msg.guilds then
        self.ListType = 2
        self.SociatyList = {}
        self.SociatyItemGotableList = {}
        self.SociatyItemList = {}

        for i = 1, #msg.guilds do
            local guild = msg.guilds[i]
            ---@type SociatyData
            local sociaty = SociatyData.New()
            sociaty:Parse(guild)
            table.insert(self.SociatyList, sociaty)
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(250149)
        self.go_table.scrollloopvectical_SociatyList:DetectingSlippage()
        return
    end

    ---排序规则：公会等级>当前公会人数（搜索会显示人数已满）>创建时间
    ---@param sociaty SociatyData
    _G.SortList(
            self.SociatyList,
            function(sociaty)
                return sociaty.Level, sociaty.SociatyMemberModule:GetCurMemberCount(), sociaty.CreateTime
            end
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_IsNil, #self.SociatyList <= 0)
    --_G.GameUtil.SetActiveByCondition(self.SociatyInfoPanel.gameObject, #self.SociatyList > 0)
    ---没有初始化就初始化一下
    if not self.InitLoopList then
        self.go_table.scrollloopvectical_SociatyList:InitItemData(
                #self.SociatyList,
                _G.handler(self, self.RefreshRenItem)
        )
        self.InitLoopList = true
    else
        self.go_table.scrollloopvectical_SociatyList:UpdateCount(#self.SociatyList)
    end
    ---是否可以滑动刷新
    self.go_table.scrollloopvectical_SociatyList:DetectingSlippage(_G.handler(self, self.onValueChanged))
    self.ChooseIndex = 1
    --self:OnItemClickBtn(nil, nil)
end

---滑动条滑动到下方后刷新显示
function SociatyJoinView:onValueChanged(y)
    if y < 0 then
        self.Page = self.Page + 1
        self.NextPageMsg.page = self.Page
        SociatyNet:GetInstance():Select(self.NextPageMsg, _G.handler(self, self.SelectBack))
    end
end

