function SociatyJoinView:OnItemClickBtn(go, _, tb)
    local name = go:GetName()
    if name == "@_aorbtn_Join" or name == "@_aorbtn_Applyed" then
        self.ChooseIndex = tb and tb.index or self.ChooseIndex

        self:RequestJoin(self.SociatyList[self.ChooseIndex])
