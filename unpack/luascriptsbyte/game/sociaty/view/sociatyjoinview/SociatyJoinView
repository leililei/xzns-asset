---快速加入公会
function SociatyJoinView:QuickJoin()
    local cd, time = SociatyModel:GetInstance():IsCding()
    if cd then
        _G.PopWindowManager:GetInstance():ShowAllTips(250301, _G.LangUtil.GetLangPackValue(90021800008, time))
        return
    end
    local sociatys = {}
    local index = 1
    local roleLv = _G.PlayerModel:GetInstance().role_lv
    local curChapter = require "AfkModel":GetInstance():GetCurAfkChapter()
    for i = 1, #self.SociatyList do
        local data = self.SociatyList[i]
        local canJoin = data.LimitLevel <= roleLv and
                data.LimitChapter <= curChapter and data.NeedApproval ~= 2
        if canJoin and data.SociatyMemberModule.CurMemberCount < data.SociatyMemberModule.MaxMemberNum then
            sociatys[index] = data
            index = index + 1
        end
    end
    _G.SortList(
            sociatys,
            function(v)
                return v.SociatyMemberModule.CurMemberCount
            end
    )
    if #sociatys == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(250103)
    end
    for i = 1, #sociatys do
        if require("SociatyManager"):GetInstance():GetGuildName() ~= "" then
            break
        end
        self:RequestJoin(sociatys[i])
    end
end

---申请加入公会
function SociatyJoinView:RequestJoin(data)
    local sociaty = data
    if nil == sociaty then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=#ff0000>推荐列表数据空</color>")
        end
        return
    end
    -- if sociaty:IsMax() then
    --     ---申请公会人满了
    --     _G.PopWindowManager:GetInstance():ShowAllTips(250101)
    --     return
    -- end
    local cd, time = SociatyModel:GetInstance():IsCding()

    if _G.AppSetting.DEBUG then
        _G.Log("是否CD中")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(cd)
    end

    if _G.AppSetting.DEBUG then
        _G.Log(time, "cd时间")
    end
    if cd then
        ---入会冷却
        _G.PopWindowManager:GetInstance():ShowAllTips(250301, _G.LangUtil.GetLangPackValue(90021800008, time))
        return
    end
    local roleNum = _G.ConfigManager.discrete_cfg[101602][1][1]
    if #SociatyModel:GetInstance().SociatyRoleSelf.requests >= roleNum then
        ---申请上限了
        _G.PopWindowManager:GetInstance():ShowAllTips(250108)
        return
    end
    self.JoinSociatyId = sociaty.Uid
    ---申请加入
    ---@type guild.c2s_guild_request
    local msg = {}
    msg.uid = { sociaty.Uid }
    SociatyNet:GetInstance():Request(msg, _G.handler(self, self.RequestBack))
end

---获取请求列表是否有这个对应公会id
---@param uid number 公会id
function SociatyJoinView:IsInRequests(uid)
    for i = 1, #SociatyModel:GetInstance().SociatyRoleSelf.requests do
        if SociatyModel:GetInstance().SociatyRoleSelf.requests[i].uid == uid then
            return true
        end
    end
    return false
end

---按钮单击事件
function SociatyJoinView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        ---关闭
        self:Close()
    elseif name == "@_aorbtn_Close" then
        ---关闭
        self:Close()
    elseif name == "@_aorbtn_QJoin" then
        self:QuickJoin()
    elseif name == "@_aorbtn_Create" then
        ---创建公会
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyCreateView.Name)
    elseif name == "@_aorbtn_Search" then
        ---搜索公会
        if self.go_table.input_input.text == "" then
            _G.PopWindowManager:GetInstance():ShowAllTips(250104)
            return
        end
        ---@type guild.c2s_guild_select
        local msg = {}
        msg.name = self.go_table.input_input.text
        msg.page = self.Page
        self.NextPageMsg = msg
        SociatyNet:GetInstance():Select(msg, _G.handler(self, self.SelectBack))
    elseif name == "@_aorbtn_rank" then
        ---公会排行
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyJoinRankView.Name)
    end
end

