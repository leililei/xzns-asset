function SociatyInfoView:InitData()
    self.SociatyDataSelf = require("SociatyModel"):GetInstance().SociatySelf
end

function SociatyInfoView:Show()
    self:InitData()
    self.go_table.input_content.text = self.SociatyDataSelf.JoinDeclaration
    self.go_table.input_name.text = self.SociatyDataSelf.Name
    self.limitLevel = self.SociatyDataSelf.LimitLevel
    self.go_table.input_level.text = self.limitLevel
    self.limitChapter = self.SociatyDataSelf.LimitChapter or 1
    self.go_table.input_level1.text = _G.LangUtil.GetLangPackValue(90021800344, self.limitChapter)
    local cfg = _G.ConfigManager.guild_portrait_cfg[self.SociatyDataSelf.Banner]
    if cfg then
        self.go_table.aorrawimage_icon:LoadImage(cfg.portrait)
    end
    self.go_table["toggle_" .. self.SociatyDataSelf.NeedApproval].isOn = true
end

function SociatyInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_change then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyExchangeIconView.Name,
            self.SociatyDataSelf,
            true,
            self.SociatyDataSelf.Banner,
            function(data)
                ---@type  guild_portrait_cfg
                self.iconData = data
                if self.iconData then
                    self.go_table.aorrawimage_icon:LoadImage(self.iconData.portrait)
                end
            end
        )
    elseif go == self.go_table.aorbtn_enter then
        self.count = 0
        self:UpdateName()
    elseif go == self.go_table.aorbtn_share then
        local isUnlock, dataStr1 = require("ChatManager"):GetInstance():IsUnLock(1)
        if not isUnlock then
            _G.PopWindowManager:GetInstance():ShowAllTips(410, dataStr1)
            return
        end
        ---分享公会
        local data = {}
        data.shareType = 1
        data.uid = self.SociatyDataSelf.Uid
        data.name = self.SociatyDataSelf.Name
        data.banner = self.SociatyDataSelf.Banner
        data.level = self.SociatyDataSelf.Level
        data.curPop = self.SociatyDataSelf.SociatyMemberModule.CurMemberCount
        data.maxPop = self.SociatyDataSelf.SociatyMemberModule.MaxMemberNum

        local dataStr = _G.Table2Json(data)

        ---@type chat.c2s_chat dsd
        local param = {}
        param.channel = 1
        param.content = dataStr
        param.f_uid = 0
        param.type = 3
        param.voice = 0
        param.share_id = 0
        param.share_type = _G.ChatShareType.Guild
        param.uid = self.SociatyDataSelf.Uid

        ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
        local msg = {}
        msg.channel = 1
        msg.n_content = dataStr
        msg.f_uid = 0
        msg.type = 3
        msg.voice = 0
        msg.share_id = 0
        msg.share_type = _G.ChatShareType.Guild
        msg.uid = self.SociatyDataSelf.Uid
        msg = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
        require("ChatManager"):GetInstance():CheckIsCanShare(
            _G.ChatShareType.Guild,
            self.SociatyDataSelf.Uid,
            function()
                require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
            end
        )
    elseif go == self.go_table.aorbtn_clickname then
        ---@type SociatyChangeNameView_Params
        local param = {}
        local count = _G.ConfigManager.discrete_cfg[101603][1][1]
        param.encterCall = function(name)
            if _G.StorageManager:GetInstance():CheckItemNew(_G.ResPropID.Diamond, count) then
                ---@type guild.c2s_guild_set_name
                local pb = {
                    ["name"] = name
                }
                require("SociatyNet"):GetInstance():SetName(
                    pb,
                    function()
                        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, count)
                        require("SociatyModel"):GetInstance().SociatySelf.Name = name
                        self.go_table.input_name.text = name
                        _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeName)
                        _G.PopWindowManager:GetInstance():ShowAllTips(200116)
                    end
                )
            end
        end
        param.limit = 7
        param.title = _G.GetLangPackValue(90021800200)
        param.consumeId = _G.ResPropID.Diamond
        param.consumeContent = _G.GetLangPackValue(90028500019, count)
        param.Placeholder = _G.GetLangPackValue(90021800177)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyChangeNameView.Name, param)
    elseif go == self.go_table.aorbtn_add then
        self:ChangeLevel(10)
    elseif go == self.go_table.aorbtn_reduce then
        self:ChangeLevel(-10)
    elseif go == self.go_table.aorbtn_add1 then
        self:ChangeChapter(1)
    elseif go == self.go_table.aorbtn_reduce1 then
        self:ChangeChapter(-1)
    end
end

function SociatyInfoView:ChangeLevel(num)
    self.limitLevel = self.limitLevel + num
    if self.limitLevel <= 1 then
        self.limitLevel = 1
    elseif self.limitLevel >= self.maxLimitLevel then
        self.limitLevel = self.maxLimitLevel
    end
    self.go_table.input_level.text = self.limitLevel
end

function SociatyInfoView:ChangeChapter(num)
    self.limitChapter = self.limitChapter + num
    if self.limitChapter <= 1 then
        self.limitChapter = 1
    elseif self.limitChapter >= self.maxLimitChapter then
        self.limitChapter = self.maxLimitChapter
    end
    --LogError(_G.LangUtil.GetLangPackValue(90021800344, self.limitChapter))
    self.go_table.input_level1.text = _G.LangUtil.GetLangPackValue(90021800344, self.limitChapter)
end

function SociatyInfoView:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(413)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

function SociatyInfoView:ShowTips()
    self.count = self.count - 1
    if self.count <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(200116)
    end
end
---更新名字
function SociatyInfoView:UpdateName()
    self:UpdateContent()
    self:UpdateIcon()
    self:UpdateLimit()
    if self.count == 0 then
        self:ShowTips()
    end
end
---更新内容
function SociatyInfoView:UpdateContent()
    if self.SociatyDataSelf.JoinDeclaration ~= self.go_table.input_content.text then
        self.count = self.count + 1
        self.SociatyDataSelf.SociatyMemberModule:SetNotice(
            self.go_table.input_content.text,
            1,
            function()
                self:ShowTips()
            end
        )
    end
end

function SociatyInfoView:UpdateIcon()
    if self.iconData and self.iconData.ID ~= self.SociatyDataSelf.Banner then
        self.count = self.count + 1
        ---@type guild.c2s_guild_set_banner
        local msg = {}
        msg.banner = self.iconData.ID
        local SociatyNet = require("SociatyNet")
        SociatyNet:GetInstance():SetBanner(
            msg,
            function()
                require("SociatyModel"):GetInstance().SociatySelf.Banner = self.iconData.ID
                _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeIcon, self.iconData.ID)
                self:ShowTips()
            end
        )
    end
end

function SociatyInfoView:UpdateLimit()
    local id = 0
    for i = 0, 2 do
        if self.go_table["toggle_" .. i].isOn then
            id = i
            break
        end
    end
    if
        id ~= self.SociatyDataSelf.NeedApproval or self.SociatyDataSelf.LimitLevel ~= self.limitLevel or
            self.SociatyDataSelf.LimitChapter ~= self.limitChapter
     then
        self.count = self.count + 1
        require "SociatyData".GetMemberModule():SaveCondition(
            self.limitLevel,
            self.limitChapter,
            id,
            function()
                self:ShowTips()
            end
        )
    end
end

---销毁对象时,析构函数
function SociatyInfoView:OnDestroy()
end

return SociatyInfoView
