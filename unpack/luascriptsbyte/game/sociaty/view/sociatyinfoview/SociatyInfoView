---@class SociatyInfoView : Component	中文描述
---@field go_table SociatyManagerView._obj_info_GoTable
local SociatyInfoView = _G.BaseClass("SociatyInfoView", _G.Component)
function SociatyInfoView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---创建对象时,入口构造函数
function SociatyInfoView:OnCreate()
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_name, 7, nil, true)
    local limit = _G.ConfigManager.discrete_cfg[101401][1][1]
    _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_content, limit)
    self.maxLimitLevel = #_G.ConfigManager.player_level_cfg
    self.go_table.input_level.onEndEdit:AddListener(_G.handler(self, self.OnEndInputLevel))
    self.go_table.aorbtn_add.LongPress = true
    self.go_table.aorbtn_add.onLongPress = function()
        self:ChangeLevel(10)
    end
    self.go_table.aorbtn_reduce.LongPress = true
    self.go_table.aorbtn_reduce.onLongPress = function()
        self:ChangeLevel(-10)
    end

    self.maxLimitChapter = _G.ConfigManager.discrete_cfg[101651][1][1]
    self.go_table.input_level1.onEndEdit:AddListener(_G.handler(self, self.OnEndInputChapter))
    self.go_table.aorbtn_add1.LongPress = true
    self.go_table.aorbtn_add1.onLongPress = function()
        self:ChangeChapter(1)
    end
    self.go_table.aorbtn_reduce1.LongPress = true
    self.go_table.aorbtn_reduce1.onLongPress = function()
        self:ChangeChapter(-1)
    end

    self:Show()

    --local isUnlock, dataStr = require("ChatManager"):GetInstance():IsUnLock(1)
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_share,isUnlock)
end

function SociatyInfoView:OnEndInputLevel(input)
    self.limitLevel = _G.tonumber(input)
    self:ChangeLevel(0)
end

function SociatyInfoView:OnEndInputChapter(input)
    local chapter = _G.tonumber(input)
    if nil ~= chapter then
        self.limitChapter = chapter
    end
    self:ChangeChapter(0)
end

