local ELocationEnum = require("MemberEnum").ELocationEnum

---@class SociatyGloryPreviewView : UIBaseView	公会职位权限预览视图
---@field go_table SociatyGloryPreviewView_GoTable
---@field data SociatyMemberBase                公会成员信息
---@field isFame boolean                        是否名人堂玩家
---@field location number                       职位信息
local SociatyGloryPreviewView = _G.BaseClass("SociatyGloryPreviewView", _G.UIBaseView)

function SociatyGloryPreviewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnMemberRefresh)
end
function SociatyGloryPreviewView:OnDestroy()
    self:RemoveAllListener()
end
function SociatyGloryPreviewView:OnCreate(data, isFame, location)
    self.data = data
    self.isFame = isFame
    self.location = location
    Log(self.location)

    self:UpdateButtonState()
    self:UpdatePlayerState()
    self:UpdatePrivilegeState()
end

---监听被踢出公会
function SociatyGloryPreviewView:OnBeKicked()
    self:Close()
end
---监听成员状态刷新
function SociatyGloryPreviewView:OnMemberRefresh()
    --目标职业变动
    if not self.data or self.data.Location == self.location then
        self:UpdateButtonState()
        self:UpdatePlayerState()
        self:UpdatePrivilegeState()
    else
        --职位已变动, 关闭此页面
        self:Close()
    end
end

---更新按钮状态
---@return void
function SociatyGloryPreviewView:UpdateButtonState()
    local hasEditPrivilege = self:HasEditPrivilege()
    self.go_table.aorbtn_install:SetActiveE(hasEditPrivilege and not self.data and 1 or 0)
    self.go_table.aorbtn_uninstall:SetActiveE(hasEditPrivilege and self.data and 1 or 0)
    self.go_table.aortext_des:SetActiveE(self.location == ELocationEnum.Member and 1 or 0)
end
---更新玩家状态
---@return void
function SociatyGloryPreviewView:UpdatePlayerState()
    self.go_table.obj_empty:SetActiveE(self.data and 0 or 1)
    self.go_table.obj_player:SetActiveE(self.data and 1 or 0)
    if self.data then
        local data = self.data
        local tb = _G.GetAutoGoTable(self.go_table.obj_player)

        tb.aortext_name.text = data.Name
        tb.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.Power)
        _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.65, true, false, true)

        local model = require("SociatyModel"):GetInstance()
        --职位信息
        tb.aortext_job.text =
            self.isFame and _G.GetLangPackValue(91300001707) or
            _G.GetLangPackValue(model:GetLocationLanguage(data.Location))
        tb.obj_jobBG1:SetActiveE(
            (data.Location == ELocationEnum.Chairman or data.Location == ELocationEnum.CoChairman) and 1 or 0
        )
        tb.obj_jobBG2:SetActiveE(data.Location == ELocationEnum.Elder and 1 or 0)
        tb.obj_jobBG3:SetActiveE(self.isFame and 1 or 0)
        tb.obj_jobBG9:SetActiveE(data.Location == ELocationEnum.Member and not self.isFame and 1 or 0)
    end
end
---更新职位权限状态
---@return void
function SociatyGloryPreviewView:UpdatePrivilegeState()
    local cfg = _G.ConfigManager.guild_position_cfg[self.location]
    if not cfg then
        self.go_table.aortext_content.text = ""
        return
    end

    local stringModel = "%s.%s"

    --根据职位显示加成信息
    ---@type string[]
    local descs = {}
    --公会信息调整
    if cfg.modify_portrait or cfg.modify_name or cfg.modify_notice then
        table.insert(descs, string.format(stringModel, #descs + 1, _G.GetLangPackValue(90021800423)))
    end
    --职位设置
    if cfg.position_set then
        local languageId = self.location == ELocationEnum.Chairman and 90021800424 or 90021800429
        table.insert(descs, string.format(stringModel, #descs + 1, _G.GetLangPackValue(languageId)))
    end
    --管理成员加入和踢出
    if cfg.check or cfg.kick_out then
        table.insert(descs, string.format(stringModel, #descs + 1, _G.GetLangPackValue(90021800425)))
    end
    --入会条件设置
    if cfg.set_join then
        table.insert(descs, string.format(stringModel, #descs + 1, _G.GetLangPackValue(90021800426)))
    end
    --职位加成福利
    local locationCfg = _G.ConfigManager.discrete_cfg[101671] --职位福利加成配置
    if locationCfg then
        local percentage = 0
        for _, d in pairs(locationCfg) do
            if d[1] == self.location then
                percentage = _G.math.floor(d[2] * 0.01) 
                break
            end
        end
        if percentage > 0 then
            table.insert(
                descs,
                string.format(stringModel, #descs + 1, _G.GetLangPackValue(90021800432, percentage .. "%"))
            )
        end
    end
    --名人堂福利加成配置
    local fameCfg = self.isFame and _G.ConfigManager.discrete_cfg[101672]
    if fameCfg then
        local percentage = fameCfg and _G.math.floor(fameCfg[1][1] * 0.01) or 0
        if percentage > 0 then
            table.insert(
                descs,
                string.format(stringModel, #descs + 1, _G.GetLangPackValue(90021800432, percentage .. "%"))
            )
        end
    end
    --公会加成福利(基础)

    self.go_table.aortext_content.text = table.concat(descs, "\n")
end

---检查自己是否有编辑权限, 以及是否大于目标的权限等级
function SociatyGloryPreviewView:HasEditPrivilege()
    if self.isFame then
        return false
    end

    local model = require("SociatyModel"):GetInstance()
    local cfg1 = _G.ConfigManager.guild_position_cfg[model:GetSelfMember().Location]
    if not cfg1 or not cfg1.position_set then
        return false
    end

    --检查目标的权限等级
    if not self.data then
        return true
    end
    local cfg2 = _G.ConfigManager.guild_position_cfg[self.data.Location]
    return not cfg2 or cfg1.rank < cfg2.rank
end

---处理按钮事件
function SociatyGloryPreviewView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_uninstall then
        require("SociatyModel"):GetInstance().SociatySelf:GetMemberModule():DoAppoint(
            self.data.Uid,
            ELocationEnum.Member
        )
    elseif go == self.go_table.aorbtn_install or go == self.go_table.aorbtn_empty then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyLobbyView.Name)
        --关闭面板
        self:Close()
        -- local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyGloryTopView.Name)
        -- if view then
        --     view:Close()
        -- end
    end
end

return SociatyGloryPreviewView
