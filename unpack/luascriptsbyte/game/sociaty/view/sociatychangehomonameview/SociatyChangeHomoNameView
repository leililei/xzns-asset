---@class SociatyChangeHomoNameView : UIBaseView	中文描述
---@field public go_table SociatyChangeHomoNameView_GoTable GoTable
local SociatyChangeHomoNameView = _G.BaseClass("SociatyChangeHomoNameView", _G.UIBaseView)

function SociatyChangeHomoNameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyChangeHomoNameView:OnCreate(callback)
    self.callback=callback
    self:initChangeName()
end

local StorageManager=_G.StorageManager:GetInstance()

function SociatyChangeHomoNameView:initChangeName()
    local cost = _G.ConfigManager.discrete_cfg[201303]
    self.go_table.aortext_free:SetActiveE(0)
    self.go_table.aortext_consume:SetActiveE(1)
    self.custome = cost[1][2]
    self.custid = cost[1][1]
    self.go_table.aortext_consume.text=string.format("%s/%s",_G.GameUtil.NumberToUnitStr(StorageManager:GetItemCountBySid(self.custid)),self.custome)
    local costItemCfg=StorageManager:GetItemDataClassByCfg(cost[1])
    self.go_table.aorrawimage_useicon:LoadImage(costItemCfg.Icon or costItemCfg.icon)
    self.go_table.input_Name.text = ""
    local cfg = _G.ConfigManager.discrete_cfg[201303][1]
    local limitNum = cfg[1]
    _G.GameUtil.InputFieldCharacterLimit(
            self.go_table.input_Name,
            limitNum,
            nil,
            true,
            nil,
            nil,
            true
    )
end
---确定
function SociatyChangeHomoNameView:EnterName()
    local msg = {}
    msg.name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(msg.name) then
        _G.PopWindowManager:GetInstance():ShowAllTips(200117)
        return
    end
    _G.GameUtil.SecCheck(msg.name, "1",function()
        require("SociatyModel"):GetInstance():ChangeHonoName(
                self.go_table.input_Name.text,
                _G.handler(self, self.EnterNameCallBack)
        )
    end)
end


function SociatyChangeHomoNameView:EnterNameCallBack(data)
    local name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(name) then
        return
    end
    if data.ack == 1 then
        if self.callback then
            self.callback(self.go_table.input_Name.text)
        end
        StorageManager:ConsumeItem(self.custid, 0, self.custome)
        self:Close()
    elseif data.ack == 2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.custid)
    end
end

---按钮点击事件在这里派发
function SociatyChangeHomoNameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_concel then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if StorageManager:GetItemCountBySid(self.custid) >= self.custome then
            self:EnterName()
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.custid)
        end
    end
end

return SociatyChangeHomoNameView
