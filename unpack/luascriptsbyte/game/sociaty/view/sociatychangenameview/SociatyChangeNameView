---@class SociatyChangeNameView : UIBaseView	中文描述
---@field public go_table SociatyChangeNameView_GoTable GoTable
local SociatyChangeNameView = _G.BaseClass("SociatyChangeNameView", _G.UIBaseView)

function SociatyChangeNameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---@field consumeContent number 消耗资源描述
---@field consumeId number 消耗资源id
---@field cancelCall function 失败回调
---@field encterCall function 成功回调
---@field title string 标题
---@field limit number 限制输入字符
---@field Placeholder string 占位字符
---@class SociatyChangeNameView_Params

---界面的入口函数
---@param param SociatyChangeNameView_Params
function SociatyChangeNameView:OnCreate(param)
    self.param = param
    self:UpdateView()
    _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_Name, param.limit)
end

function SociatyChangeNameView:UpdateView()
    if self.param.consumeId then
        self.go_table.aorrawimage_coin:LoadImage(
            _G.StorageManager:GetInstance():GetItemIcon(self.param.consumeId),
            function(raw)
                if raw then
                    raw:SetNativeSize()
                end
            end
        )
    else
        self.go_table.aorrawimage_coin:LoadImage("")
    end
    if self.param.consumeContent then
        self.go_table.aortext_content.text = self.param.consumeContent
    else
        self.go_table.aortext_content.text = ""
    end
    self.go_table.aortext_title.text=self.param.title
    self.go_table.aortext_Placeholder.text=self.param.Placeholder
end

---按钮点击事件在这里派发
function SociatyChangeNameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_enter then
        if self.param.encterCall then
            self.param.encterCall(self.go_table.input_Name.text)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        if self.param.cancelCall then
            self.param.cancelCall()
        end
        self:Close()
    end
end

return SociatyChangeNameView
