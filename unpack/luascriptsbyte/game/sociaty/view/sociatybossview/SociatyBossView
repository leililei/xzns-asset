local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function SociatyBossAwardItem:__init(trans)
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.transform, _G.handler(self, self.OnClickBtn))
end
---@param data table[sid,number]
function SociatyBossAwardItem:InitData(sid, number)
    self.data = sid
    local num = number or 1
    self.itemData = _G.StorageManager:GetInstance():GetItemDataClass(sid, num)
    self.go_table.aorrawimage_Icon:LoadImage(self.itemData:GetIconPath())
    --  self.go_table.aortext_Count.text = self.itemData:GetCount()
end

function SociatyBossAwardItem:OnClickBtn(go, isOn)
    require("CommonTipManager"):GetInstance():OpenTip(go, self.data)
end

---类的析构函数
function SociatyBossAwardItem:Dispose()
end

---@class SociatyBossView : UIBaseView	中文描述
---@field public go_table SociatyBossView_GoTable GoTable
---@field maxTimes number 每日最大挑战次数
---@field challengeTimes number 今日剩余挑战次数
---@field Skills Skill_GoTable[] GoTable
---@field bossCfg guild_boss_cfg_Item boss数据
---@field role role.i_role 造成最高伤害玩家信息
---@field maxDamage number 造成最高伤害
---@field ExtraDatas table<sid,number>额外奖励
---@field AwardItemList SociatyBossAwardItem[] 挑战奖励
---@field ExtraAwardItemList SociatyBossAwardItem[] 额外挑战奖励
local SociatyBossView = _G.BaseClass("SociatyBossView", _G.UIBaseView)
--_G.SociatyBossView = SociatyBossView

local CS = _G.CS
local typeof = _G.typeof

function SociatyBossView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.RefreshDps, self.P2CMaxDps, self)
end

---界面的入口函数
function SociatyBossView:OnCreate()
    self.AwardItemList = {}
    self.ExtraAwardItemList = {}
    self.go_table.aorlooplist_AwardList:StartUpdataDragInfo(0, _G.handler(self, self.RefreshAward))
    self.go_table.aorlooplist_ExtraAwardList:StartUpdataDragInfo(0, _G.handler(self, self.RefreshExtraAward))
    require("SociatyBossNet"):GetInstance():GetBossInfo(_G.handler(self, self.Init))
end

---初始化
---@param msg guild_boss.s2c_boss_info
function SociatyBossView:Init(msg)
    if self.go_table == nil then
        return
    end
    self.maxTimes = _G.ConfigManager.discrete_cfg[102801][1][1]
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.VIP.GongHui_Boss})
    if not _G.table.isEmptyOrNil(data) then
        self.maxTimes = self.maxTimes + data[1]
    end

    self.challengeTimes = self.maxTimes - msg.times
    self.role = msg.top_role
    self.maxDamage = msg.max_dps
    self.isFirst = msg.role_max_dps == 0
    self:InitBoss()
    self:UpdateChallengeNum()
    self:UpdateAward()
    self:UpdateOtherAward()
    self:UpdateRole()
end

---初始化Boss
function SociatyBossView:InitBoss()
    self.bossCfg = _G.ConfigManager.guild_boss_cfg[1]
    -- self.go_table.aorrawimage_monster:LoadImage(_G.ConfigManager.card_cfg[_G.ConfigManager.monster_cfg[self.bossCfg.monster].CardID].Portrait,function (trans)
    --     self.go_table.aorrawimage_monster:SetNativeSize()
    -- end)
    self:UpdateSkill()
    self:UpdateSweep()
end
---更新扫荡显示
function SociatyBossView:UpdateSweep()
    if self.isFirst or not _G.GlobalConditionManager.CheckCondition(4, _G.ConfigManager.discrete_cfg[102802][1][1]) then
        self.go_table.aorbtn_sweep:GetChildE(0):GetComponentE(typeof(CS.AorImage)):SetGray(true)
    else
        self.go_table.aorbtn_sweep:GetChildE(0):GetComponentE(typeof(CS.AorImage)):SetGray(false)
    end
end

---更新技能
function SociatyBossView:UpdateSkill()
    if not self.Skills then
        self.Skills = {
            _G.GetAutoGoTable(self.go_table.obj_skill1, _G.handler(self, self.OnClickSkill)),
            _G.GetAutoGoTable(self.go_table.obj_skill2, _G.handler(self, self.OnClickSkill)),
            _G.GetAutoGoTable(self.go_table.obj_skill3, _G.handler(self, self.OnClickSkill))
        }
    end
    for i = 1, 3 do
        local cfg = _G.ConfigManager.card_skills_cfg[self.bossCfg.skill[i]]
        if cfg then
            self.Skills[i].aorimage_icon.SpriteName = cfg.icon
            self.Skills[i].aortext_name.text = _G.LangUtil.GetLangPackValue(cfg.name1)
        else
            _G.GameUtil.SetActiveByCondition(self.Skills[i].gameObject, false)
        end
    end
end

function SociatyBossView:OnClickSkill(go, isOn)
    local str = string.replace(go:GetTransform():GetParent():GetName(), "$_obj_skill", "")
    local index = tonumber(str)
    require("CommonTipManager"):GetInstance():OpenSkillTip(self.bossCfg.skill[index])
end
---更新挑战次数
function SociatyBossView:UpdateChallengeNum()
    self.go_table.aortext_challengeNum.text =
        "挑战次数：<color=#27891A>" .. self.challengeTimes .. "</color>/" .. self.maxTimes
end

---更新挑战奖励
function SociatyBossView:UpdateAward()
    self.go_table.aorlooplist_AwardList:RefreshAllShowItem(#self.bossCfg.reward_preview)
end

---刷新挑战奖励
function SociatyBossView:RefreshAward(trans, index)
    local instanceID = trans:GetInstanceIDE()
    if not self.AwardItemList[instanceID] then
        self.AwardItemList[instanceID] = SociatyBossAwardItem.New(trans)
    end
    self.AwardItemList[instanceID]:InitData(self.bossCfg.reward_preview[index + 1])
end

---更新额外结算奖励
function SociatyBossView:UpdateOtherAward()
    if self.role then
        self.ExtraDatas = self:GetExtraAward()
        if self.ExtraDatas then
            self.go_table.aorlooplist_ExtraAwardList:RefreshAllShowItem(#self.ExtraDatas)
            self.go_table.aorlooplist_ExtraAwardList:SetActiveE(1)
            self.go_table.obj_noOtherAward:SetActiveE(0)
        else
            self.go_table.aorlooplist_ExtraAwardList:SetActiveE(0)
            self.go_table.obj_noOtherAward:SetActiveE(1)
        end
    else
        self.go_table.aorlooplist_ExtraAwardList:SetActiveE(0)
        self.go_table.obj_noOtherAward:SetActiveE(1)
    end
end

---更新额外奖励
function SociatyBossView:RefreshExtraAward(trans, index)
    local instanceID = trans:GetInstanceIDE()
    if not self.ExtraAwardItemList[instanceID] then
        self.ExtraAwardItemList[instanceID] = SociatyBossAwardItem.New(trans)
    end
    local data = self.ExtraDatas[index + 1]
    self.ExtraAwardItemList[instanceID]:InitData(data[1], data[2])
end

---获取额外奖励数据
function SociatyBossView:GetExtraAward()
    local cfgs = _G.ConfigManager.guild_boss_reward_cfg
    local count = #cfgs
    local award = {}
    for i = 1, count do
        if self.maxDamage < cfgs[i].damage then
            break
        end
        _G.table.insert(award, cfgs[i].reward_extra)
    end
    return award
end

---更新最高伤害信息
function SociatyBossView:UpdateRole()
    if self.role then
        self.go_table.obj_role:SetActiveE(1)
        self.go_table.obj_noRole:SetActiveE(0)
        self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.player_portrait_cfg[self.role.style].portrait1)
        self.go_table.aortext_name.text = self.role.name
        self.go_table.aortext_damageNum.text = self.maxDamage
        self.go_table.aorrawimage_kuang:LoadImage(_G.ConfigManager.player_frame_cfg[self.role.frame].frame)
    else
        self.go_table.obj_role:SetActiveE(0)
        self.go_table.obj_noRole:SetActiveE(1)
    end
end

---扫荡
function SociatyBossView:OnSweep()
    if self.challengeTimes <= 0 then
        return
    end
    if not _G.GlobalConditionManager.CheckCondition(4, _G.ConfigManager.discrete_cfg[102802][1][1]) then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "需要解锁1-1" .. "</color>")
        end
        return
    end
    local msg = {boss_id = self.bossCfg.id}
    require("SociatyBossNet"):GetInstance():SweepBossFight(
        msg,
        function(msg)
            if msg.ack ~= 1 then
                if _G.AppSetting.DEBUG then
                    _G.Log("", "<color=red>" .. "不在公会boss开启时间" .. "</color>")
                end
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self.challengeTimes = self.challengeTimes - 1
            self:UpdateChallengeNum()
        end
    )
end

---挑战
function SociatyBossView:OnChallenge()
    local SociatyModel = require("SociatyModel")
    SociatyModel:GetInstance():OnChallenge(self.bossCfg.id)
end

---关闭界面
function SociatyBossView:CloseView()
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RefreshDps, self.P2CMaxDps, self)
    self:Close()
end

---接收推送
---@param msg guild_boss.p2c_guild_boss_dps
function SociatyBossView:P2CMaxDps(msg)
    self.role = msg.tar_role
    self.maxDamage = msg.max_dps
    self:UpdateRole()
end

---按钮点击事件在这里派发
function SociatyBossView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_sweep" then
        self:OnSweep()
    elseif name == "@_aorbtn_challenge" then
        self:OnChallenge()
    elseif name == "@_aorbtn_log" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBattleLogView.Name, self.maxDamage)
    elseif name == "@_aorbtn_CloseView" then
        self:CloseView()
    end
end

return SociatyBossView
