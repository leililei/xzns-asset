---@class SociatyMemberHomoNameView : UIBaseView	中文描述
---@field public go_table SociatyMemberHomoNameView_GoTable GoTable
local SociatyMemberHomoNameView = _G.BaseClass("SociatyMemberHomoNameView", _G.UIBaseView)

function SociatyMemberHomoNameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyMemberHomoNameView:OnCreate()
    self.cfg = _G.ConfigManager.guild_name_cfg
    self.model = require("SociatyModel"):GetInstance()
    self:SortList()
    self.go_table.scrollloopvectical_task:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.go_table.scrollloopvectical_task:UpdateCount(#self.sortcfg)
    self:RefreshMessage()
    _G.PlayerPrefsManager.SetInt("MemberHonoRedPoint", 1)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SocaityMemberHonoRedPoint.id)

    local res = {}
    _G.table.insert(res, 89)
    self:AddComponent(self.go_table.obj_GoldInfo, require("ResourceCompont").New(self.go_table.obj_GoldInfo, res))
end

function SociatyMemberHomoNameView:RefreshMessage()
    local memberDate = self.model.SociatySelf.SociatyMemberModule:GetMember(_G.PlayerModel:GetInstance().role_uid)
    local positioncfg = _G.ConfigManager.guild_position_cfg[memberDate.Location]
    self.go_table.aortext_homo.text = self.model.SociatySelf.guild_prefix
    self.go_table.aortext_name.text = _G.PlayerModel:GetInstance().role_name
    self.go_table.aortext_statu.text = _G.GetLangPackValue(positioncfg.name)

    if string.IsNullOrEmpty(self.model.SociatySelf.guild_prefix) then
        self.go_table.aorbtn_ChangeMemberName:SetActiveE(0)
    end
    self.go_table.aorbtn_ChangeHomoName:SetActiveE(positioncfg.position_set and 1 or 0)
end

function SociatyMemberHomoNameView:RefreshItem(index, obj)
    local _index = index + 1
    local cfg = self.sortcfg[_index]
    ---@type ActiveTaskPanel._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, cfg.id))
    go_table.obj_items:ClearChildren()
    go_table.aortext_info.text = _G.GetLangPackValue(90000012055, cfg.condition)
    if self.model:CheckHomoAwardIsGetById(cfg.id) == 1 then
        go_table.aortext_jd.text = ""
        --_G.string.format("(%s/%s)", cfg.condition, cfg.condition)
        go_table.aortext_slidervalue.text = _G.string.format("(%s/%s)", cfg.condition, cfg.condition)
        go_table.aorimage_slider:SetRectTransformSize(192, 13)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_over:SetActiveE(1)
    else
        local num = self.model:GetNowHonoMemberNum()
        go_table.aortext_jd.text = ""
        --_G.string.format("(%s/%s)", num>=cfg.condition and cfg.condition or num, cfg.condition)
        go_table.aortext_slidervalue.text = _G.string.format("(%s/%s)", num >= cfg.condition and cfg.condition or num,
            cfg.condition)
        go_table.aorimage_slider:SetRectTransformSize(
            192 * ((num >= cfg.condition and cfg.condition or num) / cfg.condition),
            13)
        go_table.aorbtn_get:SetActiveE(num >= cfg.condition and 1 or 0)
        go_table.aorbtn_way:SetActiveE(num >= cfg.condition and 0 or 1)
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, #cfg.rewards do
        local rewarditem = cfg.rewards[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            rewarditem,
            go_table.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(self.taskawardlocalsize and self.taskawardlocalsize or 0.7)
                if rewarditem[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.model:CheckHomoAwardIsGetById(cfg.id) == 1)
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

function SociatyMemberHomoNameView:OnClickTask(go, isOn, id)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        self.model:GetHomeTargetAward(function()
            self:SortList()
            self.go_table.scrollloopvectical_task:UpdateCount(#self.sortcfg)
        end)
    end
end

function SociatyMemberHomoNameView:SortList()
    local sortcfg = {}
    for k, v in pairs(self.cfg) do
        table.insert(sortcfg, v)
    end
    _G.SortList(sortcfg, function(a)
        local iscanget = self.model:CheckHasAwardCanGetInHomo(a.id)
        local isget = self.model:CheckHomoAwardIsGetById(a.id)
        return iscanget - isget, -a.id
    end)
    self.sortcfg = sortcfg
end

function SociatyMemberHomoNameView:ShowMemberName()
    self.memberlist = self.model.SociatySelf.prefix_role
    self:SortHonoMemberName()
    if not self.initMemberList then
        self.go_table.scrollloopvectical_member:InitItemData(0, _G.handler(self, self.RefreshMemberNameItem))
        self.go_table.scrollloopvectical_member:UpdateCount(#self.memberlist)
        self.initMemberList = true
    else
        self.go_table.scrollloopvectical_member:UpdateCount(#self.memberlist)
    end
end

function SociatyMemberHomoNameView:RefreshMemberNameItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_name.text = self.memberlist[index + 1].role_name
end

function SociatyMemberHomoNameView:SortHonoMemberName()
    local Chairman = self.model.SociatySelf:GetChairman()
    _G.SortList(self.memberlist, function(a)
        return Chairman.Uid == a.role_uid and 1 or 0
    end)
end

---按钮点击事件在这里派发
function SociatyMemberHomoNameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_ChangeHomoName then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyChangeHomoNameView.Name, function()
            self.go_table.aortext_homo.text = self.model.SociatySelf.guild_prefix
            self:RefreshMessage()
            self:SortList()
            self.go_table.scrollloopvectical_task:UpdateCount(#self.sortcfg)
        end)
    elseif go == self.go_table.aorbtn_ChangeMemberName then
        if string.IsNullOrEmpty(self.model.SociatySelf.guild_prefix) then

        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyChangeMemberNameView.Name, function()
                self.go_table.aortext_name.text = _G.PlayerModel:GetInstance().role_name
                self:SortList()
                self.go_table.scrollloopvectical_task:UpdateCount(#self.sortcfg)
            end)
        end
    elseif go == self.go_table.aorbtn_Member then
        self.go_table.obj_Member_panle:SetActiveE(1)
        self:ShowMemberName()
    elseif go == self.go_table.aorbtn_closeMember then
        self.go_table.obj_Member_panle:SetActiveE(0)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1006)
    end
end

return SociatyMemberHomoNameView
