---@class SociatyYHView : UIBaseView
---@field go_table SociatyYHView_GoTable 公会宴会
local SociatyYHView = BaseClass("SociatyYHView", UIBaseView)
local SociatyNet = require("SociatyNet")
local DeadsoulTowerModel = require("DeadsoulTowerModel")

function SociatyYHView:Awake()
    AddViewBtnClick(self.go_table.gameObject, handler(self, self.OnClickBtn))
end

-- 启动
function SociatyYHView:OnCreate(...)
    local now = CS.YoukiaCore.TimeKit.GetNowUnixTime() - _G.TimeUtil.GAME_DAY_TIME
    local tb = TimeUtil.GetDateTime(now)
    DeadsoulTowerModel:GetInstance().CurWeek = tb.week == 0 and 7 or tb.week
    self.PressList = {16, 14, 20, 15, 35}
    self.GetList = {}
    SociatyNet:GetInstance():GetFeastInfo(_G.handler(self, self.GetFeastInfoBack))
end

function SociatyYHView:GetFeastInfoBack(msg)
    if msg.ack == 1 then
        self.Foods = msg.foods
        self.GetFoodIds = msg.get_foods or {}

        if _G.AppSetting.DEBUG then
            _G.Log(DeadsoulTowerModel:GetInstance().CurWeek, "当前周信息")
        end

        local weeks = _G.ConfigManager.discrete_cfg[102602][1]

        ---周六周天开盛宴
        if false ~= table.indexof(weeks, DeadsoulTowerModel:GetInstance().CurWeek) then
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_make, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_get, true)
            self:UpdateGetView()
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_make, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_get, false)
            self:UpdateMakeView()
        end
    end
end

function SociatyYHView:UpdateMakeView()
    self.ChooseIndex = 0
    self.ChooseInfo = nil
    local foodsTrans = self.go_table.obj_foods
    local childCount = foodsTrans:GetChildCountE()
    self.IsFull = true
    self.MakeNum = 0
    self.MaxPress = 100
    for i = 1, childCount do
        local tmpItem = foodsTrans:GetChildE(i - 1)
        local tb = _G.GetAutoGoTable(tmpItem)
        local food = self.Foods[i]
        ---@type guild_feast_cfg_Item
        local cfg = _G.ConfigManager.guild_feast_cfg[i]
        if cfg.type == 1 then
            tb.aorimage_icon.SpriteName = cfg.icon
            if food then
                if food.count >= food.need then
                    food.state = 1
                end
                tb.aorimage_icon:SetGray(false)

                if nil == self.ChooseInfo and food.state == 0 then
                    self.ChooseIndex = i
                    self.ChooseInfo = food
                end

                if food.state == 1 then
                    _G.GameUtil.SetActiveByCondition(tb.obj_unlock, false)
                    _G.GameUtil.SetActiveByCondition(tb.obj_lock, false)
                    _G.GameUtil.SetActiveByCondition(tb.obj_isget, true)
                    self.MakeNum = self.MakeNum + self.PressList[i]
                else
                    self.IsFull = false
                    _G.GameUtil.SetActiveByCondition(tb.obj_unlock, true)
                    _G.GameUtil.SetActiveByCondition(tb.obj_lock, false)
                    _G.GameUtil.SetActiveByCondition(tb.obj_isget, false)
                    if food.count >= food.need then
                        self.MakeNum = self.MakeNum + self.PressList[i]
                    else
                        self.MakeNum = self.MakeNum + self.PressList[i] * (food.count / food.need)
                    end
                end
            else
                tb.aorimage_icon:SetGray(true)
                _G.GameUtil.SetActiveByCondition(tb.obj_unlock, false)
                _G.GameUtil.SetActiveByCondition(tb.obj_lock, true)
                _G.GameUtil.SetActiveByCondition(tb.obj_isget, false)
                self.MakeNum = self.MakeNum + 0
                tb.aortext_locklevel.text = _G.GetLangPackValue(90021800104, cfg.condition)
            end
        end
    end

    if nil == self.ChooseInfo then
        local food = self.Foods[1]
        self.ChooseIndex = 1
        self.ChooseInfo = food
    end

    local storageManager = _G.StorageManager:GetInstance()
    local _, storageID = storageManager:CheckSidType(203060100)
    self.MatNum = storageManager:GetItemCountByID(storageID, 203060100)
    self.go_table.aortext_Stone.text = self.MatNum

    if self.ChooseIndex == 1 then
        self.go_table.aorimage_press1.fillAmount = (self.MakeNum) / self.MaxPress * 12.5
        self.go_table.aorimage_press2.fillAmount = (self.MakeNum - 8) / self.MaxPress * 2
    else
        self.go_table.aorimage_press1.fillAmount = 1
        self.go_table.aorimage_press2.fillAmount = (self.MakeNum / self.MaxPress)
    end

    self.go_table.aortext_pressText.text = self.ChooseInfo.count .. "/" .. self.ChooseInfo.need
end

function SociatyYHView:UpdateGetView()
    local foodsTrans = self.go_table.obj_foodsget
    local childCount = foodsTrans:GetChildCountE()
    for i = 1, childCount do
        local tmpItem = foodsTrans:GetChildE(i - 1)
        ---@type guild_feast_cfg_Item
        local cfg = _G.ConfigManager.guild_feast_cfg[i]
        local tb =
            _G.GetAutoGoTable(
            tmpItem,
            function()
                if cfg.type == 1 then
                    local food = self.Foods[i]
                    if food and food.state == 1 then
                        ---@type guild.c2s_guild_feast_award
                        local msg = {}
                        msg.fid = i
                        require("SociatyNet"):GetInstance():GetFeastAward(msg, _G.handlerbind(self, self.OnGetCall, i))
                    end
                else
                    if table.indexof(self.GetFoodIds, i) == false then
                        ---@type guild.c2s_guild_feast_award
                        local msg = {}
                        msg.fid = i
                        require("SociatyNet"):GetInstance():GetFeastAward(msg, _G.handlerbind(self, self.OnGetCall, i))
                    end
                end
            end
        )
        table.insert(self.GetList, tb)

        tb.aorimage_icon.SpriteName = cfg.icon

        if cfg.type == 1 then
            local food = self.Foods[i]
            if food then
                tmpItem:SetActiveE(1)
                if food.state == 1 then
                    if table.indexof(self.GetFoodIds, i) == false then
                        self:GetState(tb, 3)
                    else
                        self:GetState(tb, 2)
                    end
                else
                    self:GetState(tb, 1)
                end
            else
                tmpItem:SetActiveE(0)
                self:GetState(tb, 1)
            end
        else
            if table.indexof(self.GetFoodIds, i) == false then
                self:GetState(tb, 3)
            else
                self:GetState(tb, 2)
            end
        end
    end
end

function SociatyYHView:UpdateGetState()
    for i = 1, #self.GetList do
        local tb = self.GetList[i]
        local cfg = _G.ConfigManager.guild_feast_cfg[i]
        if cfg.type == 1 then
            local food = self.Foods[i]
            if food then
                if food.state == 1 then
                    if table.indexof(self.GetFoodIds, i) == false then
                        self:GetState(tb, 3)
                    else
                        self:GetState(tb, 2)
                    end
                else
                    self:GetState(tb, 1)
                end
            else
                self:GetState(tb, 1)
            end
        else
            if table.indexof(self.GetFoodIds, i) == false then
                self:GetState(tb, 3)
            else
                self:GetState(tb, 2)
            end
        end
    end
end

function SociatyYHView:GetState(tb, type)
    _G.GameUtil.SetActiveByCondition(tb.obj_lose, type == 1)
    _G.GameUtil.SetActiveByCondition(tb.obj_sucess, type == 2)
    _G.GameUtil.SetActiveByCondition(tb.obj_canget, type == 3)
end

function SociatyYHView:OnGetCall(data, i)
    table.insert(self.GetFoodIds, i)
    self:UpdateGetState()
    if data.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    end
end

---按钮单击事件
function SociatyYHView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        ---关闭
        self:Close()
    elseif name == "@_aorbtn_Help" then
        ---功能说明
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 4)
    elseif name == "@_aorbtn_Make" then
        ---制作
        --材料够
        if self.MatNum > 0 then
            --如果满了
            if self.IsFull then
                if self.ChooseIndex > 0 then
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.MakeItemView.Name,
                        self.ChooseIndex,
                        self.ChooseInfo,
                        function(num)
                            local food = self.Foods[self.ChooseIndex]
                            food.count = food.count + num

                            if food.count >= food.need then
                                food.state = 1
                            end
                            self:UpdateMakeView()
                        end
                    )
                end
            else
                self.curNumber = self:GetMax(self.ChooseIndex)
                local cfg = _G.ConfigManager.guild_feast_cfg[self.ChooseIndex]
                ---@type guild.c2s_guild_feast_submit
                local msg = {}
                msg.fid = cfg.id
                msg.mid = cfg.materials[1]
                msg.m_num = self.curNumber
                require("SociatyNet"):GetInstance():SubmitMaterial(msg, _G.handler(self, self.OnBuyCall))
            end
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 203060100)
        end
    end
end

function SociatyYHView:OnBuyCall(data)
    _G.StorageManager:GetInstance():ConsumeItem(203060100, 0, self.curNumber)
    if data.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    end
    local food = self.Foods[self.ChooseIndex]
    food.count = food.count + self.curNumber

    if food.count >= food.need then
        food.state = 1
    end
    self:UpdateMakeView()
end

function SociatyYHView:GetMax(id)
    local cfg = _G.ConfigManager.guild_feast_cfg[id]
    local needNum = cfg.materials[2] - self.ChooseInfo.count
    if self.MatNum < needNum then
        needNum = self.MatNum
    end
    return needNum
end

function SociatyYHView:OnDestroy()
end

return SociatyYHView
