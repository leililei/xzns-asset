local ColorType = {
    "ui-ghck-icon-hui",
    "ui-ghck-icon-lan",
    "ui-ghck-icon-zi",
    "ui-ghck-icon-cheng",
    "ui-ghck-icon-hong"
}
---@class SociatyStorageDonateView : UIBaseView	仓库卡牌捐献弹出界面
---@field public go_table SociatyStorageDonateView_GoTable GoTable
---@field data PropData 物品数据
---@field cfg guild_warehouse_cfg_Item
---@field curNum number 当前要取出的数量
---@field maxNum number 可以取出最大数量
---@field callback function 回调
local SociatyStorageDonateView = _G.BaseClass("SociatyStorageDonateView", _G.UIBaseView)
--_G.SociatyStorageDonateView = SociatyStorageDonateView

local CS = _G.CS
local typeof = _G.typeof

function SociatyStorageDonateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data CardData
function SociatyStorageDonateView:OnCreate(data, callback)
    self.data = data
    self.curNum = 1
    self.maxNum = data:GetCount()
    self:UpdateCard()
    self.cfg = _G.ConfigManager.guild_warehouse_cfg[data.sid]
    self.callback = callback
    self:UpadteDonateNum()
    self.go_table.aortext_ItemNum.text = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, data.sid)
end

function SociatyStorageDonateView:UpdateCard()
    local card = require("BaseAwardItem").CreatAwardItem(self.go_table.obj_cardInfo)
    card:UpdateItem({sid = self.data.sid, number = 1}, nil, true)
    card.go_table.aorimage_element = ColorType[card.cfg.Order]
    self.go_table.aortext_ItemName.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.item_cfg[self.data.sid].Name)
end

---更新捐献可获得积分点数
function SociatyStorageDonateView:UpadteDonateNum()
    self.go_table.aortext_cost.text = self.curNum * self.cfg.point_deposit
    self.go_table.aortext_Number.text = self.curNum
end

---数量增加
function SociatyStorageDonateView:ModifyNumber(count)
    if self.curNum + count <= self.maxNum then
        self.curNum = math.max(1, self.curNum + count)
    else
        self.curNum = self.maxNum
    end
    self:UpadteDonateNum()
end

---按钮点击事件在这里派发
function SociatyStorageDonateView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Add1" then
        self:ModifyNumber(1)
    elseif name == "@_aorbtn_Add10" then
        self:ModifyNumber(10)
    elseif name == "@_aorbtn_Sub1" then
        self:ModifyNumber(-1)
    elseif name == "@_aorbtn_Sub10" then
        self:ModifyNumber(-10)
    elseif name == "@_aorbtn_Max" then
        self:ModifyNumber(self.maxNum)
    elseif name == "@_aorbtn_Min" then
        self.curNum = 1
        self:UpadteDonateNum()
    elseif name == "@_aorbtn_CloseView" or name == "@_aorbtn_Cancel" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        if self.callback then
            self.callback(self.data, self.curNum)
        end
        self:Close()
    end
end

return SociatyStorageDonateView
