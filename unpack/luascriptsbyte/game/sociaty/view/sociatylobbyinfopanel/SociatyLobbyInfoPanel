---@class SociatyLobbyInfoPanel : Component 描述
---@field private go_table SociatyLobbyView._obj_LobbyInfoPanel_GoTable go_table
---@field private OwnerView SociatyJoinView|SociatyLobbyView
---@field private SociatyData SociatyData
local SociatyLobbyInfoPanel = _G.BaseClass("SociatyLobbyInfoPanel", _G.Component)
local MemberEnum = require("MemberEnum")
local ELocationEnum = MemberEnum.ELocationEnum

---New构造
function SociatyLobbyInfoPanel:OnCreate(ownerView)
    self.OwnerView = ownerView
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    _G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_Declaration, 50)
    self:AddListener(_G.eSociatyEvent.ExchangeNotice, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeName, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.ExchangeIcon, self.RefreshPanel)
    --self:AddListener(_G.eSociatyEvent.MemberRefresh, self.RefreshPanel)
end

---函数功能注释
function SociatyLobbyInfoPanel:SetTagIndex(index)
    self.go_table.obj_Declaration:SetActiveE(index ~= 3 and 1 or 0)
    self.go_table.obj_btns:SetActiveE(index == 1 and 1 or 0)
    self.isRank = index == 3
end

function SociatyLobbyInfoPanel:Dispose()
    self.go_table = nil
    self.OwnerView = nil
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject 按钮
function SociatyLobbyInfoPanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_ShowList then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyManagerView.Name)
        return
    elseif go == self.go_table.aorbtn_clickSociatyName then
        ---@type SociatyChangeNameView_Params
        local param = {}
        local count = _G.ConfigManager.discrete_cfg[101603][1][1]
        param.encterCall = function(name)
            if _G.StorageManager:GetInstance():CheckItemNew(_G.ResPropID.Diamond, count) then
                ---@type guild.c2s_guild_set_name
                local pb = {
                    ["name"] = name
                }
                require("SociatyNet"):GetInstance():SetName(
                    pb,
                    function()
                        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, count)
                        require("SociatyModel"):GetInstance().SociatySelf.Name = name
                        self.go_table.input_SociatyName.text = name
                        _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeName)
                        _G.PopWindowManager:GetInstance():ShowAllTips(200116)
                    end
                )
            end
        end
        param.limit = 7
        param.title = _G.GetLangPackValue(90021800200)
        param.consumeId = _G.ResPropID.Diamond
        param.consumeContent = _G.GetLangPackValue(90028500019, count)
        param.Placeholder = _G.GetLangPackValue(90021800177)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyChangeNameView.Name, param)
    elseif go == self.go_table.aorbtn_presidentInfo then
        local uid = self.isRank and self.ChairmanData.uid or self.ChairmanData.Uid
        _G.SystemSettingManager:GetInstance():OpenView(uid)
    elseif go == self.go_table.aorbtn_clickSociatyIcon then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyExchangeIconView.Name,
            self.SociatyData,
            true,
            self.SociatyData.Banner,
            function(data)
                if data and data.ID ~= self.SociatyData.Banner then
                    ---@type guild.c2s_guild_set_banner
                    local msg = {}
                    msg.banner = data.ID
                    local SociatyNet = require("SociatyNet")
                    SociatyNet:GetInstance():SetBanner(
                        msg,
                        function()
                            require("SociatyModel"):GetInstance().SociatySelf.Banner = data.ID
                            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeIcon, data.ID)
                            _G.PopWindowManager:GetInstance():ShowAllTips(200116)
                        end
                    )
                end
            end
        )
    elseif go == self.go_table.aorbtn_exit then
        require("SociatyData").GetMemberModule():DoQuit()
    elseif go == self.go_table.aorbtn_share then
        local isUnlock, dataStr1 = require("ChatManager"):GetInstance():IsUnLock(1)
        if not isUnlock then
            _G.PopWindowManager:GetInstance():ShowAllTips(410, dataStr1)
            return
        end
        ---分享公会
        local data = {}
        data.shareType = 1
        data.uid = self.SociatyData.Uid
        data.name = self.SociatyData.Name
        data.banner = self.SociatyData.Banner
        data.level = self.SociatyData.Level
        data.curPop = self.SociatyData.SociatyMemberModule.CurMemberCount
        data.maxPop = self.SociatyData.SociatyMemberModule.MaxMemberNum

        local dataStr = _G.Table2Json(data)

        ---@type chat.c2s_chat dsd
        local param = {}
        param.channel = 1
        param.content = dataStr
        param.f_uid = 0
        param.type = 3
        param.voice = 0
        param.share_id = 0
        param.share_type = _G.ChatShareType.Guild
        param.uid = self.SociatyData.Uid

        ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
        local msg = {}
        msg.channel = 1
        msg.n_content = dataStr
        msg.f_uid = 0
        msg.type = 3
        msg.voice = 0
        msg.share_id = 0
        msg.share_type = _G.ChatShareType.Guild
        msg.uid = self.SociatyData.Uid
        msg = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
        require("ChatManager"):GetInstance():CheckIsCanShare(
            _G.ChatShareType.Guild,
            self.SociatyData.Uid,
            function()
                require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
            end
        )
    elseif go == self.go_table.aorbtn_impeach then
    end
end

function SociatyLobbyInfoPanel:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(413)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

---更新公会详细信息
---@param data SociatyData 中文描述
function SociatyLobbyInfoPanel:Refresh(data)
    self.SociatyData = data

    local banner = self.isRank and data.banner or data.Banner
    local lv = self.isRank and data.level or data.Level
    local notice =
        self.isRank and (data.provate_notice ~= "" and data.provate_notice or _G.LangUtil.GetLangPackValue(90021800022)) or
        data.Declaration
    local name = self.isRank and data.name or data.Name

    -- if self.isRank then
    --     for i = 1, #data.roles do
    --         if data.roles[i].pos == ELocationEnum.Chairman then
    --             self.ChairmanData = data.roles[i].role
    --             break
    --         end
    --     end
    -- else
    self.ChairmanData = data:GetChairman()
    -- end

    local president = self.ChairmanData and self.ChairmanData.Name or _G.GetLangPackValue(90021800512)

    local member = data.SociatyMemberModule:GetMemberDesc()

    self.go_table.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[banner].portrait)
    self.go_table.aortext_Member.text = member
    self.go_table.aortext_SociatyLv.text = _G.string.format(_G.LangUtil.GetLangPackValue(90020600039), lv)

    self.go_table.aortext_Ex.text = _G.string.format("%s/%s", data.Exp, data.LevelCfg.exp)
    self.go_table.slider_progress.value = data.LevelCfg.exp > 0 and data.Exp / data.LevelCfg.exp or 1

    self.go_table.input_Declaration.text = notice
    self.go_table.input_SociatyName.text = name
    --self.go_table.aortext_ID.text = data.Uid
    self.go_table.aortext_president.text = president

    self.go_table.input_SociatyName.enabled = false

    if self.isRank then
        self.go_table.input_Declaration.enabled = false
        self.go_table.obj_inputTag:SetActiveE(0)
        self.go_table.aorimage_inputSociatyName:SetActiveE(0)
        self.go_table.aorbtn_clickSociatyName:SetActiveE(0)
        self.go_table.aorbtn_clickSociatyIcon:SetActiveE(0)
    else
        local mineData = data.SociatyMemberModule:GetSelfMember()
        if mineData.CfgItem.modify_notice then
            self.go_table.input_Declaration.enabled = true
            self.go_table.input_Declaration.onEndEdit:RemoveAllListeners()
            self.go_table.input_Declaration.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
        else
            self.go_table.input_Declaration.enabled = false
        end

        self.go_table.obj_inputTag:SetActiveE(mineData.CfgItem.modify_notice and 1 or 0)
        self.go_table.aorimage_inputSociatyName:SetActiveE(mineData.CfgItem.modify_name and 1 or 0)
        self.go_table.aorbtn_clickSociatyName:SetActiveE(mineData.CfgItem.modify_name and 1 or 0)
        self.go_table.aorbtn_clickSociatyIcon:SetActiveE(mineData.CfgItem.modify_portrait and 1 or 0)
    end
end

---编辑公会公告
---@param input string
function SociatyLobbyInfoPanel:OnEndEditorDeclaration(input)
    self.SociatyData.SociatyMemberModule:SetNotice(input, 0)
end

---编辑公会名字
---@param input string
function SociatyLobbyInfoPanel:OnEndEditorSociatyName(input)
    self.SociatyData.SociatyMemberModule:SetName(input, 0)
end

---刷新界面
function SociatyLobbyInfoPanel:RefreshPanel()
    local data = require("SociatyModel"):GetInstance().SociatySelf
    self:Refresh(data)
end

---@return SociatyLobbyInfoPanel
return SociatyLobbyInfoPanel
