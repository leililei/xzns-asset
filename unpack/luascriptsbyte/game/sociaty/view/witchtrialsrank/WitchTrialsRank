---@class WitchTrialsRank : UIBaseView	中文描述
---@field public go_table WitchTrialsRank_GoTable GoTable
local WitchTrialsRank = _G.BaseClass("WitchTrialsRank", _G.UIBaseView)
local SociatyData = require("SociatyData")
local SociatyMemberBase = require("SociatyMemberBase")
local UIUtils = _G.UIUtils
---@type SociatyMemberModule
local MD

function WitchTrialsRank:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WitchTrialsRank:OnCreate()
    require "SociatyNet":GetInstance():GetFeastInfo(_G.handlerbind(self, self.InitData))
end

function WitchTrialsRank:InitData(data)
    local Member = data.feast_info.fights
    MD = SociatyData.GetMemberModule()
    local insert = _G.table.insert
    self.Member = MD.Member
    if nil == MD then
        if _G.AppSetting.DEBUG then
            _G.LogError("MD is nil")
        end
        return
    end
    for _, v in pairs(self.Member) do
        v.fight_times = 0
        v.acttime = 99999999
    end
    if Member ~= nil then
        for _, v in pairs(self.Member) do
            for _, v2 in pairs(Member) do
                if v2.role.uid == v.Uid then
                    v.fight_times = v2.fight_times
                    v.acttime = v2.time
                end
            end
        end
    end
    table.sort(
        self.Member,
        function(a, b)
            if a.fight_times ~= b.fight_times then
                return a.fight_times > b.fight_times
            end

            if a.acttime ~= b.acttime then
                return a.acttime < b.acttime
            end

            return a.Location < b.Location
        end
    )
    self.go_table.scrollloopvectical_memberList:InitItemData(#self.Member, _G.handler(self, self.RefreshItem))
end

---界面的销毁函数
function WitchTrialsRank:OnDestroy()
end

---@param looplist2 SuperScrollView.LoopListView2 滚动组件
---@param index number 该数据的索引  0起始
function WitchTrialsRank:RefreshItem(index, item)
    if index < 0 then
        return
    end
    local eIndex = index + 1
    local ctrl = nil
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
    end
    self:RefreshItemShow(ctrl, eIndex)
end

---滚动组件按钮派发
---@param go UnityEngine.GameObject 按钮
---@param isOn boolean
---@param index number
function WitchTrialsRank:OnItemClickBtn(go, isOn, tb)
    local data = MD:GetMemberByIndex(tb.index)
    if data.Uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620109)
    else
        _G.SystemSettingManager:GetInstance():OpenView(data.Uid)
    end
end

---刷新单元格文本颜色显示
---@param ctrl SociatyLobbyView._obj_SociatyItem_GoTable
---@param eIndex number
function WitchTrialsRank:RefreshItemShow(ctrl, eIndex)
    ctrl.index = eIndex
    local data = self.Member[eIndex]
    if data then
        ctrl.aortext_name.text = data.Name
        ctrl.aortext_point.text = _G.GetLangPackValue(90021800180, data.fight_times)
        ctrl.aortext_posts.text = _G.GetLangPackValue(90021800181, SociatyMemberBase:GetLocationName(data.Location))
        UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase,data,0.7,true,false,true)
    end
end

---按钮点击事件在这里派发
function WitchTrialsRank:OnClickBtn(go)
    if go == self.go_table.aorbtn_AnyClose then
        self:CloseView()
    elseif go == self.go_table.aorbtn_close then
        self:CloseView()
    end
end

function WitchTrialsRank:CloseView()
    self:Close()
end

return WitchTrialsRank
