---@class SociatyImpeachView : UIBaseView    中文描述
local SociatyImpeachView = _G.BaseClass("SociatyImpeachView", _G.UIBaseView)
local SociatyMemberBase = require("SociatyMemberBase")

function SociatyImpeachView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SociatyImpeachView:OnCreate()
    self:Show()
end

function SociatyImpeachView:Show()
    self:ShowMemberNum()
    self:ShowMemberItem()
end

---弹劾人数
function SociatyImpeachView:ShowMemberNum()
    local model = require("SociatyModel"):GetInstance()
    if model.ImpeachInfo then
        self.go_table.aortext_impeachnum.text =
            _G.GetLangPackValue(90021800544, model.ImpeachNum, model.ImpeachInfo.need_num)
    else
        self.go_table.aortext_impeachnum.text = ""
    end
    local isipch = model:IsImpeach(_G.PlayerModel:GetInstance().role_uid)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_ido, not isipch)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_impeached, isipch)
end

function SociatyImpeachView:ShowMemberItem()
    ---@type SociatyLobbyView._obj_SociatyItem_GoTable
    local ctrl = _G.GetAutoGoTable(self.go_table.obj_member)
    self:RefreshItemShow(ctrl)
end

---刷新单元格文本颜色显示
---@param eIndex number
function SociatyImpeachView:RefreshItemShow(ctrl)
    local model = require("SociatyModel"):GetInstance()
    local data = model.SociatySelf.SociatyMemberModule:GetMember(model.ImpeachInfo.role.uid)
    if data then
        ctrl.aortext_name.text = data.Name
        ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.Power)

        for i = 1, 4 do
            ctrl["aorimage_title" .. i]:SetActiveE(0)
        end

        --是否为名人堂玩家
        if data.Location > 3 then
            local isFame = model:IsFameMember(data)
            if isFame then
                ctrl.aortext_pro:SetActiveE(0)
                ctrl.obj_proimage:SetActiveE(1)
                ctrl["aorimage_title4"]:SetActiveE(1)
            else
                ctrl.aortext_pro:SetActiveE(1)
                ctrl.obj_proimage:SetActiveE(0)
                ctrl.aortext_pro.text = SociatyMemberBase:GetLocationName(data.Location)
            end
        else
            ctrl.aortext_pro:SetActiveE(0)
            ctrl.obj_proimage:SetActiveE(1)
            ctrl["aorimage_title" .. data.Location]:SetActiveE(1)
        end

        _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data, 0.7, true, true, true)
    end
end

function SociatyImpeachView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_ido then
        --弹劾
        local model = require("SociatyModel"):GetInstance()
        model:DoImpeach(
            _G.PlayerModel:GetInstance().role_uid,
            function(msg)
                self:ShowMemberNum()
                if msg.ack == 829 then
                    self:Close()
                    local chairData = model.SociatySelf.GetMemberModule():GetChairman()
                    chairData.OfflineTime = 0
                    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ImpeachEnd)
                end
            end
        )
    elseif go == self.go_table.aorbtn_member then
        --弹劾成员
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyImpeachMemberView.Name)
    elseif go == self.go_table.aorbtn_share then
        --分享弹劾信息

        local isUnlock, dataStr1 = require("ChatManager"):GetInstance():IsUnLock(1)
        if not isUnlock then
            _G.PopWindowManager:GetInstance():ShowAllTips(410, dataStr1)
            return
        end

        local model = require("SociatyModel"):GetInstance()
        ---分享公会弹劾信息
        local data = {}
        data.shareType = 1
        data.curImpeachNum = model.ImpeachNum
        data.needImpeachNum = model.ImpeachInfo.need_num

        local dataStr = _G.Table2Json(data)

        ---@type chat.c2s_chat dsd
        local param = {}
        param.channel = 3
        param.content = dataStr
        param.f_uid = 0
        param.type = _G.ChatInfoType.GuildImpeach
        param.voice = 0
        param.share_id = 0
        --param.share_type = _G.ChatShareType.GuildImpeach
        param.uid = model.SociatySelf.Uid

        ---@type ClintSendChatInfo ---本地自己的消息 先显示 忽略服务器广播 防止延迟
        local msg = {}
        msg.channel = 3
        msg.n_content = dataStr
        msg.f_uid = 0
        msg.type = _G.ChatInfoType.GuildImpeach
        msg.voice = 0
        msg.share_id = 0
        --msg.share_type = _G.ChatShareType.GuildImpeach
        msg.uid = model.SociatySelf.Uid
        msg = require("ChatManager"):GetInstance():GetNewChatInfo(msg)
        require("ChatManager"):GetInstance():CheckIsCanShare(
            _G.ChatShareType.Guild,
            model.SociatySelf.Uid,
            function()
                require("ChatViewNet"):GetInstance():SendCHAT(param, _G.handlerbind(self, self.CallSendChat, msg))
            end
        )
    end
end

function SociatyImpeachView:CallSendChat(param, msg)
    if param.ack == 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(830)
        --- 以服务器返回的内容为准  (违禁字 处理后)
        if not _G.IsNil(param.content) and not string.IsNullOrEmpty(param.content) then
            msg.chat.n_content = param.content
        end
        if not _G.IsNil(param.time) then
            msg.chat.time = param.time
        end
        require("ChatManager"):GetInstance():P2C_NewChat(msg)
    end
end

---销毁对象时,析构函数
function SociatyImpeachView:OnDestroy()
end

return SociatyImpeachView
