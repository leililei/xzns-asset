local sociatyManager = require "SociatyManager"
---@class GuideStatueAgreeView : UIBaseView	中文描述
---@field public go_table GuideStatueAgreeView_GoTable GoTable
local GuideStatueAgreeView = _G.BaseClass("GuideStatueAgreeView", _G.UIBaseView)
--_G.GuideStatueAgreeView = GuideStatueAgreeView
local CommonTipManager = require "CommonTipManager"

function GuideStatueAgreeView:Awake()
    self.rankNameArrays = {
        self.go_table.aortext_name1,
        self.go_table.aortext_name2,
        self.go_table.aortext_name3,
        self.go_table.aortext_name4,
        self.go_table.aortext_name5
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data guild.s2c_guild_statue
function GuideStatueAgreeView:OnCreate(data)
    if not _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.GuideStatueView.Name) then
        self:Close()
        return
    end
    self.roles = data.roles or {}
    sociatyManager = require "SociatyManager"
    self:UpdateView()
    self:AddListener(_G.eSociatyEvent.RefreshLike, self.UpdateView)
    self:SetName()
end
function GuideStatueAgreeView:UpdateView()
    for i = 1, 5 do
        if self.roles[i] then
            self.go_table["aortext_agreeCount" .. i].text = self:GetPointStr(self.roles[i].point)
            self.go_table["aorimage_agreed" .. i]:SetActiveE(
                sociatyManager:GetInstance():CheckIsLike(self.roles[i].uid) and 1 or 0
            )
            self.go_table["obj_agreebg" .. i]:SetActiveE(1)
        else
            self.go_table["aortext_agreeCount" .. i].text = 0
            self.go_table["aorimage_agreed" .. i]:SetActiveE(0)
            self.go_table["obj_agreebg" .. i]:SetActiveE(0)
        end
    end
    -- self.go_table.aortext_agree.text =_G.LangUtil.GetLangPackValue(90028300085)..  sociatyManager:GetInstance():GetLikeNum()
end

function GuideStatueAgreeView:GetPointStr(point)
    if point > 999 then
        return "999+"
    else
        return point
    end
end

function GuideStatueAgreeView:OnLike(index)
    if self.roles[index] then
        require "SociatyModel":GetInstance():Like(
            self.roles[index].uid,
            function(msg)
                CommonTipManager.ShowSecretFloatTips(msg)
                self.roles[index].point = self.roles[index].point + 1
                self:UpdateView()
            end
        )
    end
end

---按钮点击事件在这里派发
function GuideStatueAgreeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_agree1 then
        self:OnLike(1)
    elseif go == self.go_table.aorbtn_agree2 then
        self:OnLike(2)
    elseif go == self.go_table.aorbtn_agree3 then
        self:OnLike(3)
    elseif go == self.go_table.aorbtn_agree4 then
        self:OnLike(4)
    elseif go == self.go_table.aorbtn_agree5 then
        self:OnLike(5)
    end
end

function GuideStatueAgreeView:InitRankData(data)
    if data.ack == 1 then
        self.roles = data.roles
    else
        _G.FloatTipsModel:Show(data.ack)
    end
end

---ZHJ-19472【公会雕像】第4、5名玩家的昵称被模型轻微遮挡
---设置玩家昵称
function GuideStatueAgreeView:SetName()
    local level = require("SociatyModel"):GetInstance().SociatySelf.Level
    self.rankCountLimit = _G.ConfigManager.guild_level_cfg[level].num_statue
    local count = self.rankCountLimit
    if count < 5 then
        count = 5
    end
    for i = 1, 5 do
        local data = {}
        if not _G.table.isEmptyOrNil(self.roles) and i <= count then
            data = self.roles[i]
        end
        if _G.table.isEmptyOrNil(data) and i <= count then
            self.rankNameArrays[i].text = _G.LangUtil.GetLangPackValue(90021800103)
        elseif i > count then
            self.rankNameArrays[i].text = string.format(_G.LangUtil.GetLangPackValue(90021800104), level)
        else
            self.rankNameArrays[i].text = data.name
        end
    end
end

function GuideStatueAgreeView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GuideStatueView.Name)
    view:EscClose()
end

return GuideStatueAgreeView
