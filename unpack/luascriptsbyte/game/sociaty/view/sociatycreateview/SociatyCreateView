local SociatyNet = require("SociatyNet")
local ChatManager = require("ChatManager")
---@class SociatyCreateView : UIBaseView
local SociatyCreateView = _G.BaseClass("SociatyCreateView", _G.UIBaseView)

function SociatyCreateView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, handler(self, self.OnClickBtn))
end

-- 启动
function SociatyCreateView:OnCreate(...)
    --- 公会解散
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.ExchangeIcon, self.OnExchangeIcon, self)
    ---展示第一个图标
    self.Banner = 1001
    local path = _G.ConfigManager.guild_portrait_cfg[self.Banner].portrait
    self.go_table.aorrawimage_Icon:LoadImage(path)
    self.StoneNum = _G.ConfigManager.discrete_cfg[101601][1][1]
    local count = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
    self.go_table.aortext_Stone.text = (self.StoneNum <= count and self.StoneNum or _G.string.AddColor("x" .. self.StoneNum, "e33f3f"))
    --self.ZAnimator = self.go_table.obj_ani:GetComponentE(typeof(CS.UnityEngine.Animator))
    _G.AudioManager.PlayAudioByAudioCfgID(2041)
    _G.GameUtil.InputFieldCharacterLimit(self.go_table.input_Name, 7, nil, true)
    self.go_table.input_Name.onEndEdit:AddListener(_G.handler(self, self.UpdatePlaceholder))
    _G.SetEventTrigger(self.go_table.input_Name, "onDown", _G.handler(self, self.UpdateNetSign))
    --_G.ResPropID.Diamond
    --公会公告输入框
    --_G.GameUtil.InputFieldCharacterLimitNew(self.go_table.input_Declaration, 50)
    _G.SetEventTrigger(self.go_table.input_Declaration, "onDown", _G.handler(self, self.UpdateNetSign2))
    self.go_table.input_Declaration.enabled = true
    self.go_table.input_Declaration.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    --入会章节限制
    self.go_table.input_limitLevel.onEndEdit:AddListener(_G.handler(self, self.OnEndInputChapter))
    self.limitChapter = 1
    self.maxLimitChapter = _G.ConfigManager.discrete_cfg[101651][1][1]
    self.go_table.input_limitLevel.text = _G.LangUtil.GetLangPackValue(90021800344, self.limitChapter)
    --限制章节调节加减按钮
    self.go_table.aorbtn_add.LongPress = true
    self.go_table.aorbtn_add.onLongPress = function()
        self:ChangeChapter(1)
    end
    self.go_table.aorbtn_reduce.LongPress = true
    self.go_table.aorbtn_reduce.onLongPress = function()
        self:ChangeChapter(-1)
    end
    --是否自动审批
    self.toggleNeedApproval = true
    self.go_table.toggle_autoApply.isOn = self.toggleNeedApproval
    --创造条件
    local condition = _G.ConfigManager.discrete_cfg[101689]
    local cfg = _G.ConfigManager.limit_type_cfg[4]
    local tipscfg = _G.ConfigManager.tips_system_cfg[cfg.tipsid]
    local afkCfg = _G.ConfigManager.afk_cfg[condition[2][2]]
    local stage = _G.GetLangPackValue(tipscfg.content, afkCfg.chapter, afkCfg.section)
    local finalPrice = require("MallManager"):GetInstance():GetFinalPrice(condition[1][2])
    self.go_table.aortext_createLimit.text = _G.GetLangPackValue(90036300007, _G.GameUtil.GetPriceContentByNum(finalPrice), stage)
end

function SociatyCreateView:UpdateNetSign()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Placeholder, false)
end

function SociatyCreateView:UpdatePlaceholder()
    if _G.string.IsNullOrEmpty(self.go_table.input_Name.text) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Placeholder, true)
    end
end

---更换图标
function SociatyCreateView:OnExchangeIcon(path, id)
    self.Banner = id
    self.go_table.aorrawimage_Icon:LoadImage(path)
end

---编辑公会公告
---@param input string
function SociatyCreateView:OnEndEditorDeclaration(input)
    --检测是否满足修改条件
    local condition = _G.ConfigManager.discrete_cfg[101650]
    local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(condition)
    if not pass then
        local tipscfg = _G.ConfigManager.tips_system_cfg[817]
        _G.PopWindowManager:GetInstance():ShowAllTips(817, _G.GetLangPackValue(tipscfg.content, content))
        self.go_table.input_Declaration.text = ""
    else
        _G.GameUtil.SecCheck(input, "1",function()
            self.SociatyInfoText = input == "" and _G.GetLangPackValue(90021800022) or input
        end)
    end

    if _G.string.IsNullOrEmpty(self.go_table.input_Declaration.text) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Placeholder2, true)
    end
end

function SociatyCreateView:UpdateNetSign2()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Placeholder2, false)
end

---根据输入的num加减入会限制的数字
function SociatyCreateView:ChangeChapter(num)
    self.limitChapter = self.limitChapter + num
    if self.limitChapter <= 1 then
        self.limitChapter = 1
    elseif self.limitChapter >= self.maxLimitChapter then
        self.limitChapter = self.maxLimitChapter
    end
    self.go_table.input_limitLevel.text = _G.LangUtil.GetLangPackValue(90021800344, self.limitChapter)
end

---直接输入 入会限制
function SociatyCreateView:OnEndInputChapter(input)
    local chapter = _G.tonumber(input)
    if nil ~= chapter then
        self.limitChapter = chapter
    end
    self:ChangeChapter(0)
end

---按钮单击事件
function SociatyCreateView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Cancel" or name == "@_aorbtn_close" then
        ---取消
        -- local ani = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        -- ani:Play("a_SociatyCreateView_hide")
        -- _G.DelayDo(
        --     0.5,
        --     function()
        --         self:Close()
        --     end
        -- )
        self:Close()
    elseif name == "@_aorbtn_Create" then
        ---创建公会
        --检测是否满足修改条件
        local condition = _G.ConfigManager.discrete_cfg[101689]
        local pass = _G.GlobalConditionManager.CheckConditionArrays(condition)
        if _G.AppSetting.IsXzns then--星座需求改为两个条件为或关系
            pass = _G.GlobalConditionManager.CheckConditionArrays({ condition[1] }) or 
                    _G.GlobalConditionManager.CheckConditionArrays({ condition[2] })
        end
        if not pass then
            local _, tip1 = _G.GlobalConditionManager.GetTipsText(table.unpack(condition[1]))
            local _, tip2 = _G.GlobalConditionManager.GetTipsText(table.unpack(condition[2]))
            local tipscfg = _G.ConfigManager.tips_system_cfg[250159]
            local lanId = _G.GameUtil.GetVoucherArg(tipscfg.content, 90036300007)
            _G.PopWindowManager:GetInstance():ShowAllTips(250159, _G.GetLangPackValue(lanId, tip1, tip2))
            return
        end

        local count = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond)
        if count >= self.StoneNum then
            if self.go_table.input_Name.text ~= "" then
                -- else
                --     _G.PopWindowManager:GetInstance():ShowAllTips(250106)
                -- end
                -- local isIllegal = _G.CS.DenyWordModel.Instance:IsIllegal(self.go_table.input_Name.text)
                -- if not isIllegal then
                _G.GameUtil.SecCheck(self.go_table.input_Name.text, "1",function()
                    self.go_table.aorbtn_Create.enabled = false
                    ---@type guild.c2s_guild_create
                    local msg = {}
                    msg.name = self.go_table.input_Name.text
                    msg.banner = self.Banner
                    SociatyNet:GetInstance():Create(msg, _G.handler(self, self.CreateBack))
                end)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(250104)
            end
        else
            ---钻石不够
            --    _G.PopWindowManager:GetInstance():ShowAllTips(230303)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
        end
    elseif name == "@_aorbtn_Exchange" then
        ---更换图标
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SociatyExchangeIconView.Name,
            nil,
            false,
            self.Banner
        )
    elseif name == "@_aorbtn_goto" then
        _G.JumpManager:GetInstance():Jump(108001)
    elseif name == "@_toggle_autoApply" then
        self.toggleNeedApproval = isOn
    elseif name == "@_aorbtn_add" then
        self:ChangeChapter(1)
    elseif name == "@_aorbtn_reduce" then
        self:ChangeChapter(-1)
    end
end

---创建公会回调
---@param msg guild.s2c_guild_create
function SociatyCreateView:CreateBack(msg)
    if msg.ack == 1 then
        -- elseif msg.ack == "guild_same_name" then
        --     self.go_table.aorbtn_Create.enabled = true
        --     _G.PopWindowManager:GetInstance():ShowAllTips(250105)
        -- elseif msg.ack == "has_mask_words" then
        --     self.go_table.aorbtn_Create.enabled = true
        --     --名字包含违禁字
        --     _G.PopWindowManager:GetInstance():ShowAllTips(250106)
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.Guild.joinOrCreate },
            1
        )
        
        _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.JoinGroup)

        --进入公会大厅 msg.uid
        ---@param msgguild guild.s2c_get_guild
        SociatyNet:GetInstance():GetGuild(
            function(msgguild)
                local SociatyModel = require("SociatyModel")
                SociatyModel:GetInstance():ParseData(msgguild)

                require("SociatyManager"):GetInstance():EnterSociaty()
                ChatManager:GetInstance():OnJoinSociaty()

                local data = SociatyModel:GetInstance().SociatySelf
                if data then
                    --修改公会公告
                    if self.SociatyInfoText ~= nil and self.SociatyInfoText ~= "" then
                        data.SociatyMemberModule:SetNotice(self.SociatyInfoText, 0)
                    end
                    --修改入会限制与是否自动审核
                    require "SociatyData".GetMemberModule():SaveCondition(
                        data.LimitLevel,
                        self.limitChapter,
                        self.toggleNeedApproval == true and 0 or 1,
                        function()

                        end
                    )
                end
                _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, self.StoneNum)
                self:Close()
            end
        )
    else
        self.go_table.aorbtn_Create.enabled = true
    end
end

function SociatyCreateView:OnDestroy()
    --- 公会图标更换
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.ExchangeIcon, self.OnExchangeIcon, self)
end

function SociatyCreateView:EscClose()
    self:Close()
end

return SociatyCreateView
