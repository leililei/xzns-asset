local SociatyDonateNewView = _G.BaseClass("SociatyDonateNewView", _G.UIBaseView)
--_G.SociatyDonateNewView = SociatyDonateNewView
local effectTb = {
    "ef_Sociaty_hunbi_loop",
    "ef_Sociaty_hunyu_loop",
    "ef_Sociaty_zhizun_loop"
}
function SociatyDonateNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
    self.pri = require "PrivilegeManager":GetInstance():GetPrivilegeDataNew({_G.PrivilegeType.Sociaty.donateCoin, 16})
end

---界面的入口函数
function SociatyDonateNewView:OnCreate()
    require "SociatyModel":GetInstance():InitDonateModel(_G.handler(self, self.Init))
end

function SociatyDonateNewView:Init()
    self.data = require "SociatyModel":GetInstance().donateData
    self.guildCfg = require "SociatyModel":GetInstance().SociatySelf.LevelCfg
    self.donateItems = {}
    self.count = #self.guildCfg.donate_goal + 1
    self.endDonateNum = _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[self.count - 1]].point_donate
    self.go_table.scrollloophorizontal_itemList:InitItemData(self.count, _G.handler(self, self.RefreshItem))
    self:InitSlider()
    self:UpdateDonateNumShow(true)
    self:InitDonateShow()
    self:UpdateBuildState()
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
    self:AddListener(_G.eSociatyEvent.RefreshDonate, self.UpdateDonate)
--[[    self:AddComponent(
        self.go_table.obj_goldInfo,
        require("ResourceCompont").New(self.go_table.obj_goldInfo, _G.ConfigManager.ui_cfg.SociatyDonateView.resources)
    )]]
end

---刷新显示
function SociatyDonateNewView:RefreshItem(index, obj)
    local instandId = obj:GetInstanceIDE()
    local tb = self.donateItems[instandId]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
        self.donateItems[instandId] = tb
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_content, index > 0)
    _G.GameUtil.SetActiveByCondition(tb.aortext_num, index > 0)
    --_G.GameUtil.SetActiveByCondition(tb.obj_point, index > 0)
    tb.index = index
    if not tb.item then
        tb.item = require "BaseAwardNewItem".New(tb.obj_Root, nil, 100)
    end
    if index > 0 then
        ---@type guild_donate_goal_cfg
        tb.cfg = _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[index]]
        tb.isGet = self.data:CheckIsGet(index)
        tb.item:ShowWithID(tb.cfg.rewards[1])
        _G.GameUtil.SetActiveByCondition(tb.obj_mask, tb.isGet)
        tb.aortext_num.text = tb.cfg.point_donate
        if tb.effect then
            _G.DestroyObject(tb.effect)
        end
        if not tb.isGet and self.data.donate >= tb.cfg.point_donate then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                tb.obj_Root,
                function(trans)
                    tb.effect = trans
                    trans:SetAnchorPosition(0, 0)
                    -- 动画原因，会导致特效显示不完整，原理不明
                    trans:SetActiveE(0)
                    _G.DelayDo(
                        0.1,
                        function()
                            trans:SetActiveE(1)
                        end
                    )
                end
            )
        end
    else
        tb.aortext_num.text = 0
    end
end
---更新捐献
---@param data guild.p2c_guild_donate
function SociatyDonateNewView:UpdateDonate(data)
    if not data then
        self.guildCfg = require "SociatyModel":GetInstance().SociatySelf.LevelCfg
        self.count = #self.guildCfg.donate_goal + 1
        self.endDonateNum =
            _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[self.count - 1]].point_donate
        self.go_table.scrollloophorizontal_itemList:UpdateCount(self.count)
    end
    if not self.isEffect then
        self:UpdateSlider()
        self:UpdateDonateNumShow()
    end

    if data then
        self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
    end
end
---更新捐献
function SociatyDonateNewView:InitSlider()
    self.unit = 156.4
    self.maxValue = 6 + (self.count - 1) * 156.4
    self.go_table.slider_Chapter.maxValue = self.maxValue
    self:UpdateSlider()
end

function SociatyDonateNewView:UpdateSlider()
    local count = 0
    local nextDonate = _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[self.count - 1]].point_donate
    local lastDonate = 0
    for i = self.count - 1, 1, -1 do
        if _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[i]].point_donate <= self.data.donate then
            count = i
            lastDonate = _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[i]].point_donate
            break
        else
            nextDonate = _G.ConfigManager.guild_donate_goal_cfg[self.guildCfg.donate_goal[i]].point_donate
        end
    end
    if self.data.donate >= self.endDonateNum then
        self.go_table.slider_Chapter.value = self.maxValue
    else
        self.go_table.slider_Chapter.value =
            6 + count * self.unit + self.unit * ((self.data.donate - lastDonate) / (nextDonate - lastDonate))
    end
end

function SociatyDonateNewView:UpdateDonateNumShow(notPlayer)
    if notPlayer or self.data.lastDonate > self.data.donate then
        self.data.lastDonate = self.data.donate
        self.go_table.aortext_num.text = _G.GameUtil.NumberToUnitStr(self.data.lastDonate)
    else
        if self.tweer then
            self.tweer:Kill()
            self.tweer = nil
        end
        self.tweer =
            _G.DOTween.To(
            function()
                return self.data.lastDonate
            end,
            function(x)
                if self:IsNil() then
                    return
                end
                self.data.lastDonate = _G.math.floor(x)
                self.go_table.aortext_num.text = _G.GameUtil.NumberToUnitStr(self.data.lastDonate)
            end,
            self.data.donate,
            (self.data.donate - self.data.lastDonate) / 5 * 0.2
        ):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    end
end

---点击物体
---@param tb SociatyDonateView._obj_item_GoTable
function SociatyDonateNewView:OnClickItem(go, isOn, tb)
    if tb.isGet or self.data.donate < tb.cfg.point_donate then
        require "CommonTipManager":GetInstance():OpenTip(go, tb.cfg.rewards[1][1])
    else
        local datas, posTb = self.data:GetCanTakeList()
        if _G.table.isEmptyOrNil(datas) then
            return
        end
        require "SociatyNet":GetInstance():GetDonateAward(
            {a_id = datas},
            function(data)
                if data.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                require "CommonTipManager".OpenCommonAwardView(data)
                for _, v in pairs(datas) do
                    self.data:AddAwardDonateId(posTb[v])

                    self.go_table.scrollloophorizontal_itemList:UpdateItemSingle(posTb[v])
                end

                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.GuildDonation.id
                )
            end
        )
    end
end

function SociatyDonateNewView:InitDonateShow()
    self:UpdateSingleDonateShow(self.go_table.obj_donateItem1, 1, true)
    self:UpdateSingleDonateShow(self.go_table.obj_donateItem2, 2, true)
    self:UpdateSingleDonateShow(self.go_table.obj_donateItem3, 3, true)
end

function SociatyDonateNewView:UpdateSingleDonateShow(go, index, isInit)
    ---@type SociatyDonateView._obj_donateItem1_GoTable
    local tb = _G.GetAutoGoTable(go)
    if isInit then
        _G.AddViewBtnClick(go, _G.handlerbind(self, self.OnClickDonate, index))
        ---@type guild_donate_cfg
        local cfg = _G.ConfigManager.guild_donate_cfg[index]
        --宝箱名字
        tb.aortext_title.text = _G.GetLangPackValue(cfg.name)
        --宝箱图片
        tb.aorrawimage_icon:LoadImage(cfg.icon)
        --贡献值
        local path = _G.StorageManager:GetInstance():GetItemIcon(cfg.rewards[1][1])
        tb.aorrawimage_donate:LoadImage(path)
        tb.aortext_donateNum.text = _G.GameUtil.NumberToUnitStr(cfg.rewards[1][2])
        --公会币
        path = _G.StorageManager:GetInstance():GetItemIcon(cfg.rewards[2][1])
        tb.aorrawimage_coin:LoadImage(path)
        local count = cfg.rewards[2][2]
        local isPri = not _G.table.isEmptyOrNil(self.pri)
        if isPri then
            count = _G.Mathf.RoundToInt(count * (1 + self.pri[1][3] / 10000))
        end
        tb.aorimage_pri:SetActiveE(isPri and 1 or 0)
        tb.aortext_coinNum.text = _G.GameUtil.NumberToUnitStr(count)
        --建设工具
        if cfg.rewards[3] then
            path = _G.StorageManager:GetInstance():GetItemIcon(cfg.rewards[3][1])
            tb.aorrawimage_build:LoadImage(path)
            tb.aortext_buildNum.text = _G.GameUtil.NumberToUnitStr(cfg.rewards[3][2])
        else
            tb.aorrawimage_build:GetParentE():SetActiveE(0)
        end

        --消耗
        path = _G.StorageManager:GetInstance():GetItemIcon(cfg.consume[1])
        tb.aorrawimage_consume:LoadImage(path)
        --tb.aortext_consumeNum.text = _G.GetLangPackValue(90021800442, _G.GameUtil.NumberToUnitStr(cfg.consume[2]))
        tb.aortext_consumeNum.text = _G.GameUtil.NumberToUnitStr(cfg.consume[2])
        --_G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[effectTb[index]], tb.trans_effect)
        --_G.GameUtil.ReBuildRTF(tb.obj_price)
    end
    _G.GameUtil.SetActiveByCondition(tb.obj_donated, self.data:CheckIsDonate(index))
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_donate, not self.data:CheckIsDonate(index))
    --_G.GameUtil.SetActiveByCondition(tb.trans_effect, not self.data:CheckIsDonate(index))
end

---更新建设工具获取状态
function SociatyDonateNewView:UpdateBuildState()
    local model = require("SociatyModel"):GetInstance()
    --捐献上限值
    local cfg = _G.ConfigManager.guild_level_cfg[model:GetMasterBuildLevel()]
    self.go_table.aortext_buildNum.text = _G.GetLangPackValue(90021800444, model.SociatySelf.BuildCoin, cfg.limit)

    --建设工具图标
    local buildCoinId = model:GetBuildCoinCfg()
    local path = _G.StorageManager:GetInstance():GetItemIcon(buildCoinId)
    self.go_table.aorrawimage_buildIcon:LoadImage(path)
end

function SociatyDonateNewView:OnClickDonate(go, isOn, index)
    local cfg = _G.ConfigManager.guild_donate_cfg[index]
    self.isEffect = true
    if _G.StorageManager:GetInstance():CheckItem(cfg.consume[1], cfg.consume[2]) then
        if cfg.consume[1] == 12 then
            _G.GlobalInterface.ConsumeHYShowTips(
                _G.ComsumeHYType.SociatyDonate,
                cfg.consume[2],
                _G.handlerbind(self, self.Donate, index, cfg, go)
            )
        else
            self:Donate(index, cfg, go)
        end
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, cfg.consume[1])
    end
end
function SociatyDonateNewView:Donate(index, cfg, go)
    require "SociatyModel":GetInstance():Donate(
        index,
        function(msg)
            if not msg or msg.ack ~= 1 then
                self.isEffect = false
                self:UpdateDonateNumShow()
                self:UpdateSlider()
                return
            end

            require "CommonTipManager".OpenCommonAwardView(
                msg,
                function()
                    self:PlayAwardEffect(go, index)
                end
            )
            self.data:AddDonateId(index)
            local mineData = require("SociatyData").GetMemberModule():GetSelfMember()
            mineData.donate = mineData.donate + cfg.rewards[1][2]
            self:UpdateSingleDonateShow(self.go_table["obj_donateItem" .. index], index)
            self:UpdateBuildState()
        end
    )
end
