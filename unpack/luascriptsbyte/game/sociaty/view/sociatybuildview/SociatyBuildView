---检查建筑是否已解锁
---@return boolean
function SociatyBuildView:CheckIsUnlock(id)
    return true
end

---处理按钮事件
function SociatyBuildView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.toggle_priority then
        local model = require("SociatyModel"):GetInstance()
        if self.pausePriorityEvent then
            return
        end
        if (not isOn) and model:IsPriorityBuild(self.curId) then
            self.go_table.toggle_priority.isOn = true
            _G.PopWindowManager:GetInstance():ShowAllTips(250157)
            return
        end
        if isOn and model:IsPriorityBuild(self.curId) then
            return
        end
        local cfg = _G.ConfigManager.guild_unit_cfg[self.curId]
        if model:GetBuildLevel(self.curId) > #cfg.exp then
            if isOn then
                self.go_table.toggle_priority.isOn = false
                _G.PopWindowManager:GetInstance():ShowAllTips(250156)
            end
        else
            require("SociatyModel"):GetInstance():SetBuildPriority(self.curId, isOn, _G.handler(self, self.UpdateView))
        end
    elseif go == self.go_table.aorbtn_build then
        self:Close()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyDonateView.Name)
    elseif go == self.go_table.aorbtn_preview then
        local level = require("SociatyModel"):GetInstance():GetBuildLevel(self.curId)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBuildPreviewView.Name, self.curId, level,
        function()
        if self.curId == 1 then
            local gotLevelList = require("SociatyModel"):GetInstance():GetBuildAwardLevels()
            local hasAward = false
            local curlevel = require("SociatyModel"):GetInstance():GetBuildLevel(self.curId)
            for i = 1 ,curlevel do
                if not gotLevelList[i] then
                    hasAward = true
                end
            end
            self.go_table.obj_redpoint:SetActiveE(hasAward and 1 or 0)
        else
            self.go_table.obj_redpoint:SetActiveE(0)
        end
        end)
    elseif go == self.go_table.aorbtn_record then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyBuildRecordView.Name)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 127)
    end
end
---切换页签事件
function SociatyBuildView:OnClickTabBtn(go)
    local targetId = -1

    local name = go:GetName()
    for _, item in pairs(self.tabItems) do
        if name == item.gameObject:GetName() then
            targetId = item.cfg.id
            break
        end
    end
    if targetId < 0 or self.curId == targetId then
        return
    end
    --检查当前建筑是否已解锁
    if not self:CheckIsUnlock(targetId) then
        --TODO: 建筑尚未解锁
        return
    end

    self.curId = targetId
    self:UpdateTabs()
    self:UpdateCurrentUnit()
end

