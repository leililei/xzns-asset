---@class SociatyBuildView : UIBaseView	公会建造视图
---@field go_table SociatyBuildView_GoTable
---@field curId number                                              @当前选中的建筑id
---@field tabItems UnitItem[]                                       @建筑tab
---@field activeState1Items SociatyBuildView._obj_state1_GoTable[]      @使用中的state1节点
---@field releaseState1Items SociatyBuildView._obj_state1_GoTable[]     @未使用的state1节点
---@field activeState2Items SociatyBuildView._obj_state2_GoTable[]      @使用中的state2节点
---@field releaseState2Items SociatyBuildView._obj_state2_GoTable[]     @未使用的state2节点
---@field activeState3Items SociatyBuildView._obj_state3_GoTable[]      @使用中的state3节点
---@field releaseState3Items SociatyBuildView._obj_state3_GoTable[]     @未使用的state3节点
local SociatyBuildView = _G.BaseClass("SociatyBuildView", _G.UIBaseView)

local descTest = {
    [1] = "",
    [2] = _G.GetLangPackValue(90032800140),
    [3] = _G.GetLangPackValue(90032800141),
    [4] = _G.GetLangPackValue(90032800142),
    [5] = _G.GetLangPackValue(90032800143)
}

function SociatyBuildView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:InitTabs()

    self.go_table.obj_state1:SetActiveE(0)
    self.go_table.obj_state2:SetActiveE(0)
    self.go_table.obj_state3:SetActiveE(0)
    self.go_table.obj_upgradeFlash:SetActiveE(0)

    local model = require("SociatyModel"):GetInstance()
    model:SetDefaultBuildState()
    self.curId = model:GetMasterBuildId()

    self:UpdateTabs()
    self:UpdateCurrentUnit()

    --更新建筑状态
    model:GetBuildInfo(_G.handler(self, self.OnBuildInfoCallback))

    self:AddListener(_G.eSociatyEvent.BeKicked, self.OnBeKicked)
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.OnMemberRefresh)
end

function SociatyBuildView:OnCreate(callback)
    self.callback = callback
end

function SociatyBuildView:OnDestroy()
    self:RemoveAllListener()
end
---监听被踢出公会
function SociatyBuildView:OnBeKicked()
    self:Close()
end
---监听成员状态刷新
function SociatyBuildView:OnMemberRefresh()
    self:UpdateTabs()
    self:UpdateCurrentUnit()
end

function SociatyBuildView:OnBuildInfoCallback()
    local model = require("SociatyModel"):GetInstance()
    model:SetDefaultBuildState()
    self.curId = model:GetMasterBuildId()

    self:UpdateView()

    --更新主页面
    ---@type SociatyMainView
--[[    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
    if mainView then
        mainView:UpdateLevelView()
    end]]
end

---初始化tab标签和建筑图片
---@return void
function SociatyBuildView:InitTabs()
    local buildIds = require("SociatyModel"):GetInstance():GetBuildIds()

    self.tabItems = {}
    for index, id in ipairs(buildIds) do
        local cfg = _G.ConfigManager.guild_unit_cfg[id]
        if cfg then
            ---@type UnitItem
            local item = _G.GetAutoGoTable(self.go_table["aorbtn_tag" .. index], _G.handler(self, self.OnClickTabBtn))
            item.cfg = cfg
            item.aortext_name.text = _G.GetLangPackValue(cfg.name)
            item.aortext_selectname.text = _G.GetLangPackValue(cfg.name)
            self.tabItems[index] = item
            -- 建筑图片
            self.go_table["aorrawimage_build" .. index]:LoadImage(cfg.unit,
                    function(image)
                        image:SetNativeSize()
                    end
            )
        else
            self.go_table["aorbtn_tag" .. index]:SetActiveE(0)
        end
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SociatyBuildView, self.go_table)
end

---更新页面状态
---@return void
function SociatyBuildView:UpdateView()
    self:UpdateTabs()
    self:UpdateCurrentUnit()

    --更新主页面
    if self.callback then
        self.callback()
    end
end

---展示升级闪光特效
---@return void
function SociatyBuildView:ShowUpgradeFlashEffect()
    self.go_table.obj_upgradeFlash:SetActiveE(1)
    if self.activeState1Items then
        for _, item in pairs(self.activeState1Items) do
            item.obj_upgradeFlash:SetActiveE(1)
        end
    end
end

---展示使用建设道具特效
---@return void
function SociatyBuildView:ShowUpgradeUseEffect()
    if self.eff then
        self.eff:SetActiveE(0)
        self.eff:SetActiveE(1)
    else
        self.eff = 0
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_jueseshengji,
                self.go_table.obj_eff,
                function(trans)
                    self.eff = trans
                end
        )
    end
end

---更新tab标签状态
---@return void
function SociatyBuildView:UpdateTabs()
    local model = require("SociatyModel"):GetInstance()
    for _, item in pairs(self.tabItems) do
        local id = item.cfg.id
        item.aortext_level.text = string.format("%s%s", _G.GetLangPackValue(90021800050), model:GetBuildLevel(id))
        item.obj_selected:SetActiveE(id == self.curId and 1 or 0)
        -- item.obj_priority:SetActiveE(model:IsPriorityBuild(id) and 1 or 0)
        item.obj_lock:SetActiveE(self:CheckIsUnlock(id) and 0 or 1)
    end

    self.go_table.aortext_desc.text = descTest[self.curId]
end

---更新当前建筑状态展示
---@return void
function SociatyBuildView:UpdateCurrentUnit()
    local cfg = _G.ConfigManager.guild_unit_cfg[self.curId]
    if not cfg then
        return
    end

    local model = require("SociatyModel"):GetInstance()
    local level = model:GetBuildLevel(self.curId)
    --基础信息
    self.go_table.aortext_name.text =
        string.format("%s%s %s", _G.GetLangPackValue(90021800050), level, _G.GetLangPackValue(cfg.name))
    for index, id in ipairs(model:GetBuildIds()) do
        self.go_table["aorrawimage_build" .. index]:SetActiveE(id == self.curId and 1 or 0)
    end
    if self.curId == 1 then
        self.go_table.obj_build:SetActiveE(1)
        --等级信息
        local exp, needExp = model:GetBuildExp(self.curId)
        self.go_table.aorimage_level:SetLocalScale((exp > needExp or needExp <= 0) and 1 or exp / needExp, 1, 1)
        local finalExp = model:GetfinalLvExp(self.curId)
        self.go_table.aortext_level.text = string.format("%s/%s", needExp <= 0 and finalExp or exp, needExp <= 0 and finalExp or needExp)
    else
        self.go_table.obj_build:SetActiveE(0)
    end

    --建筑效果信息
    local curPrivilege, nextPrivilege = cfg.privilege[level], cfg.privilege[level + 1] or {}
    local curDescribe, nextDescribe = cfg.describe[level], cfg.describe[level + 1] or {}

    self:ReleaseAllState1Items()
    self:ReleaseAllState2Items()
    self:ReleaseAllState3Items()
    --显示升级条件
    if self.curId ~= 1 then
        ---@type string[]
        local desc,levelCfg
        levelCfg = model:GetBuildLevelCfg()
        for k, v in pairs(levelCfg) do
            if v[self.curId] > level then
                desc = _G.GetLangPackValue(
                    90021800452,
                    _G.GetLangPackValue(_G.ConfigManager.guild_unit_cfg[1].name),
                    k
                )
                break
            end
        end
        local item = self:GetState3Item()
        if desc and desc ~= "" then
            item.aortext_content.text = desc
        else
            item.aortext_content.text = _G.GetLangPackValue(90021800456)
        end
    end
    --如果是公会大厅, 额外显示等级丶人数和捐献上限
    if model:IsMasterBuild(self.curId) then
        local levelCfg, nextLevelCfg =
            _G.ConfigManager.guild_level_cfg[level],
            _G.ConfigManager.guild_level_cfg[level + 1]
        --等级
        local item1 = self:GetState1Item()
        item1.obj_upgradeFlash:SetActiveE(0)
        item1.aortext_name.text = _G.GetLangPackValue(90031500001)
        item1.aortext_before.text = levelCfg and tostring(level) or "-"
        item1.aortext_after.text = nextLevelCfg and tostring(level + 1) or _G.GetLangPackValue(90021800456)
        --人数
        local item2 = self:GetState1Item()
        item2.obj_upgradeFlash:SetActiveE(0)
        item2.aortext_name.text = _G.GetLangPackValue(90031500002)
        item2.aortext_before.text = levelCfg and tostring(levelCfg.num_player) or "-"
        item2.aortext_after.text = nextLevelCfg and tostring(nextLevelCfg.num_player) or _G.GetLangPackValue(90021800456)
        --捐献上限
        local item3 = self:GetState1Item()
        item3.obj_upgradeFlash:SetActiveE(0)
        item3.aortext_name.text = _G.GetLangPackValue(90031500003)
        item3.aortext_before.text = levelCfg and tostring(levelCfg.limit) or "-"
        item3.aortext_after.text = nextLevelCfg and tostring(nextLevelCfg.limit) or _G.GetLangPackValue(90021800456)
    end

    --是否为商店且已升至满级
    local isMaxShop = false
    ---@type number[]   商店解锁物品列表
    local rewards = {}
    local count, index = math.max(#curPrivilege, #nextPrivilege), 1
    local itemNum = self.curId == 5 and 3 or 2
    for i = 1, count, itemNum do
        local type = curPrivilege[i] or nextPrivilege[i]
        if type ~= 5 and type ~= 8 then
            local item = self:GetState1Item()
            item.obj_upgradeFlash:SetActiveE(0)
            item.aortext_name.text = _G.GetLangPackValue(curDescribe[index] or nextDescribe[index])
            item.aortext_before.text = curPrivilege[i + 1] and (math.floor(curPrivilege[i + 1] * 0.01) .. "%") or "-"
            item.aortext_after.text = nextPrivilege[i + 1] and (math.floor(nextPrivilege[i + 1] * 0.01) .. "%") or _G.GetLangPackValue(90021800456)
        elseif type == 5 then
            --if curPrivilege[i + 1] then
            --table.insert(rewards, _G.ConfigManager.shop_pools_cfg[curPrivilege[i + 1]].item)
            --end
            isMaxShop = not nextPrivilege[i + 1]
            --只显示新增的物品
            if nextPrivilege[i + 1] and (not curPrivilege[i + 1] or curPrivilege[i] == 0 or curPrivilege[i + 1] == 0) then
                if nextPrivilege[i + 1] > 0 then
                    table.insert(rewards, _G.ConfigManager.shop_pools_cfg[nextPrivilege[i + 1]].item)
                end
            end
        elseif type == 8 then
            isMaxShop = not nextPrivilege[i + 1]
            if nextPrivilege[i + 1] and nextPrivilege[i + 1] > 0 then
                table.insert(rewards, {nextPrivilege[i + 1], nextPrivilege[i + 2]})
            end
        end
        index = index + 1
    end
    --商店物品展示
    if #rewards > 0 then
        local item = self:GetState2Item()
        if self.curId == 3 then
            item.aortext_name.text = _G.GetLangPackValue(90021800382)
        elseif self.curId == 5 then
            item.aortext_name.text = _G.GetLangPackValue(90021800486)
        end
        self:ShowReward(item, rewards)
    elseif isMaxShop then
        local item = self:GetState1Item()
        item.obj_upgradeFlash:SetActiveE(0)
        -- item.aortext_name.text = _G.GetLangPackValue(90021800382)
        item.aortext_before.text = ""
        item.aortext_after.text = _G.GetLangPackValue(90021800456)
        if self.curId == 3 then
            item.aortext_name.text = _G.GetLangPackValue(90021800382)
        elseif self.curId == 5 then
            item.aortext_name.text = _G.GetLangPackValue(90021800486)
        end
    end
    if self.curId == 1 then
        local gotLevelList = model:GetBuildAwardLevels()
        local hasAward = false
        local level = model:GetBuildLevel(self.curId)
        for i = 1 ,level do
            if not gotLevelList[i] then
                hasAward = true
            end
        end
        self.go_table.obj_redpoint:SetActiveE(hasAward and 1 or 0)
    else
        self.go_table.obj_redpoint:SetActiveE(0)
    end

    for i = 1, 3 do
        self.go_table["aorimage_bg"..i]:SetActiveE(0)
    end
    local itemsNum = self.activeState1Items and #self.activeState1Items or 0 + (self.activeState2Items and #self.activeState2Items or 0) + (self.activeState3Items and #self.activeState3Items or 0)
    if itemsNum > 0 then
        for i = 1, itemsNum do
            if i == 1 then
                self.go_table["aorimage_bg"..1]:SetActiveE(1)
            elseif i == 3 then
                self.go_table["aorimage_bg"..2]:SetActiveE(1)
            elseif i == 5 then
                self.go_table["aorimage_bg"..3]:SetActiveE(1)
            end
        end
    end
end

---加载奖励显示
---@param parent SociatyBuildView._obj_state2_GoTable
---@param rewards number[][]
function SociatyBuildView:ShowReward(parent, rewards)
    --回收所有节点
    if parent.awardItems then
        for _, item in ipairs(parent.awardItems) do
            if item.gameObject and not item.gameObject:IsNull() then
                item.gameObject:SetLocalScale(1, 1, 1)
                _G.ItemFactory:GetInstance():SetItemCard(item)
            end
        end
        parent.awardItems = nil
    end

    --显示奖励列表
    parent.awardItems = {}
    local cacheItems = parent.awardItems
    for i = 1, #rewards do
        local id, num = table.unpack(rewards[i])
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            parent.obj_reward,
            function(item)
                if cacheItems ~= parent.awardItems or not parent.gameObject or parent.gameObject:IsNull() then
                    if item and item.gameObject and not item.gameObject:IsNull() then
                        _G.ItemFactory:GetInstance():SetItemCard(item)
                    end
                    return
                end
                table.insert(cacheItems, item)
                item.gameObject:SetLocalScale(0.6, 0.6, 0.6)
                item:Show(id, nil, num)

                local data = _G.StorageManager:GetInstance():GetStorageItemData(id)
                local isShowEffect =
                    data and data.Cfg and (data.Cfg.ef_item == 1 or data.Cfg.ef_item == "1") and true or false
                item:ShowFrameEffect(id, isShowEffect)
            end
        )
    end
end

--region -----------------对象池相关-----------------------

---回收所有state1节点
---@return void
function SociatyBuildView:ReleaseAllState1Items()
    if not self.activeState1Items then
        return
    end
    if not self.releaseState1Items then
        self.releaseState1Items = {}
    end
    for _, state in pairs(self.activeState1Items) do
        table.insert(self.releaseState1Items, state)
        state.gameObject:SetActiveE(0)
    end
    self.activeState1Items = nil
end
---获取一个state1节点
---@return SociatyBuildView._obj_state1_GoTable
function SociatyBuildView:GetState1Item()
    ---@type SociatyBuildView._obj_state1_GoTable
    local state
    if self.releaseState1Items and #self.releaseState1Items > 0 then
        state = table.remove(self.releaseState1Items, 1)
    end
    if not state then
        state = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_state1, self.go_table.obj_state1:GetParent()))
    end

    if not self.activeState1Items then
        self.activeState1Items = {}
    end
    table.insert(self.activeState1Items, state)
    state.gameObject:SetActiveE(1)
    state.transform:SetAsLastSiblingE()
    return state
end

