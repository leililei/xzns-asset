---@class SociatyInfoPanel : Component 描述
---@field private go_table SociatyInfoPanel_GoTable go_table
---@field private OwnerView SociatyJoinView|SociatyLobbyView
---@field private SociatyData SociatyData
local SociatyInfoPanel = _G.BaseClass("SociatyInfoPanel", _G.Component)
local SociatyData = require("SociatyData")

---New构造
---@param ownerView SociatyJoinView|SociatyLobbyView
---@param data SociatyData
function SociatyInfoPanel:OnCreate(ownerView, data)
    self.OwnerView = ownerView
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    self:Refresh(data)
    self:AddListener(_G.eSociatyEvent.ExchangeNotice, self.RefreshPanel)
    self:AddListener(_G.eSociatyEvent.MemberRefresh, self.RefreshPanel)
    if self.OwnerView.isHide then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Join, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Joining, false)
    end
    self.go_table.aorbtn_max:SetGray(true)
end

function SociatyInfoPanel:Dispose()
    self.OwnerView = nil
    self.go_table = nil
end

---刷新界面
function SociatyInfoPanel:RefreshPanel()
    local data = require("SociatyModel"):GetInstance().SociatySelf
    self:Refresh(data)
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject 按钮
function SociatyInfoPanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_Join then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=10>" .. "aorbtn_Join" .. "</size></color>")
        end
        self.OwnerView:OnClickBtn(go)
    elseif go == self.go_table.aorbtn_Call then
        ---@type SociatyMemberBase
        local chairman = self.SociatyData:GetChairman()
        require("FriendManager"):GetInstance():GoChatOfFriendView(chairman.uid)
    elseif go == self.go_table.aorbtn_Joining then
        self.OwnerView:OnClickBtn(go)
    elseif go == self.go_table.aorbtn_presidentInfo then
        --self.OwnerView:OnClickBtn(go)
        _G.SystemSettingManager:GetInstance():OpenView(self.SociatyData.SociatyMemberModule.Member[1].Uid)
    end
end

---更新公会详细信息
---@param data SociatyData 中文描述
function SociatyInfoPanel:Refresh(data)
    ---创建面板时不一定有数据
    if nil == data then
        return
    end

    self.SociatyData = data
    --self.go_table.aortext_Lv.text = data.Level
    --_G.LangUtil.GetLangPackValue(90020300005) .. data.Level
    self.go_table.aortext_SociatyName.text = data.Name
    self.go_table.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
    self.go_table.aortext_Declaration.text = data.JoinDeclaration
    self.go_table.aortext_Condition.text =
        self:GetApprovalStr(data.NeedApproval, data.LimitLevel, data.LimitChapter or 1)

    self.go_table.aortext_president.text = data.SociatyMemberModule.Member[1].Name
end
---审核方式字符串
---@param approval number 限制条件
function SociatyInfoPanel:GetApprovalStr(approval, limitLevel, limitchapter)
    local str = ""
    local ll = _G.LangUtil.GetLangPackValue(90021800201, limitLevel)
    local lc = _G.LangUtil.GetLangPackValue(90021800345, limitchapter)
    if approval == 0 then
        if limitLevel > 1 or limitchapter > 1 then
            str = ll .. "\n\n" .. lc
        else
            str = _G.LangUtil.GetLangPackValue(90021800014)
        end
    elseif approval == 1 then
        if limitLevel > 1 or limitchapter > 1 then
            str = ll .. "\n\n" .. lc
        else
            str = _G.LangUtil.GetLangPackValue(90021800015)
        end
    elseif approval == 2 then
        str = _G.LangUtil.GetLangPackValue(90021800013)
    end
    return str
end

---更新一下申请按钮状态
---@param data SociatyData 中文描述
function SociatyInfoPanel:UpdateButtonText(data)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Join, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Joining, false)

    local curChapter = require "AfkModel":GetInstance():GetCurAfkChapter()
    self.go_table.obj_max:SetActiveE(0)
    self.go_table.obj_limitLevel:SetActiveE(0)

    self.go_table.aorimage_gou1:SetActiveE(0)
    self.go_table.aorimage_gou2:SetActiveE(0)

    if
        self.OwnerView.isHide or data.LimitLevel > _G.PlayerModel:GetInstance().role_lv or
            data.LimitChapter > curChapter or
            data.NeedApproval == 2
     then
        if data.LimitLevel > _G.PlayerModel:GetInstance().role_lv or data.LimitChapter > curChapter then
            self.go_table.obj_limitLevel:SetActiveE(1)
            _G.GameUtil.SetActiveByCondition(
        self.go_table.aorimage_gou1,
        tonumber(_G.PlayerModel:GetInstance().role_lv) >= tonumber(data.LimitLevel)
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_gou2, curChapter >= data.LimitChapter)
        end
        return
    end
    -- if data:IsMax() then
    --     --self.go_table.aortext_CanotJoinText.text = _G.LangUtil.GetLangPackValue(90021800025)
    --     self.go_table.obj_max:SetActiveE(1)
    -- else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Join, true)
    -- end
end

---点击加入后
function SociatyInfoPanel:ShowClickJoinText()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Joining, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Join, false)
end

---点击加入后
function SociatyInfoPanel:ShowCancelClickJoinText()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Joining, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Join, true)
end

---@return SociatyInfoPanel
return SociatyInfoPanel
