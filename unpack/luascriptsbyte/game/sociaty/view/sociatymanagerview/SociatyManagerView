---@class SociatyManagerView : Component	中文描述
---@field public go_table SociatyManagerView_GoTable GoTable
---@field sociatyData SociatyMemberBase
local SociatyManagerView = _G.BaseClass("SociatyManagerView", _G.Component)

function SociatyManagerView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyManagerView:OnCreate(data)
    self.sociatyData = require("SociatyData").GetMemberModule():GetSelfMember()
    self.go_table.toggle_log.isOn = false
    self.go_table.toggle_log.isOn = true
    self.go_table.toggle_apply:SetActiveE(self.sociatyData.CfgItem.check and 1 or 0)
    self:AddListener(_G.eSociatyEvent.MemberLocationRefresh, self.CheckToggle)
    self.go_table.aortext_condition.gameObject:SetActiveE(1) 
    self:FreshCondition()
    _G.Events:GetInstance():AddListener(_G.eSociatyEvent.RefreshCondition, self.FreshCondition, self)
end

---检测权限
function SociatyManagerView:CheckToggle()
    self.go_table.toggle_apply:SetActiveE(self.sociatyData.CfgItem.check and 1 or 0)
    if self.sociatyData.CfgItem.check == false and self.go_table.toggle_apply.isOn == true then
        self.go_table.toggle_log.isOn = true
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_applyList, false)
    end
end

---刷新入会条件显示
function SociatyManagerView:FreshCondition()
    self.go_table.aortext_condition.text = _G.GetLangPackValue(90021800464, require("SociatyModel"):GetInstance().SociatySelf.LimitChapter or 1)
end

---显示日志
function SociatyManagerView:ShowInfo(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_log, isOn)
    if not isOn then
        return
    end
    if not self.SociatyShowLogView then
        self.SociatyShowLogView = self:AddComponent(self.go_table.obj_log, require "SociatyShowLogView".New())
    -- else
    --     self.SociatyShowLogView:Show()
    end
end
---显示入会申请
function SociatyManagerView:ShowApply(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_applyList, isOn)
    if not isOn then
        return
    end
    if not self.SociatyCheckView then
        self.SociatyCheckView = self:AddComponent(self.go_table.obj_applyList, require "SociatyCheckView".New())
    else
        require "SociatyData".GetMemberModule():ShowCheckView(
            function(data)
                self.SociatyCheckView:Show(data)
            end
        )
    end
end

function SociatyManagerView:OnToggle(go, isOn, callback)
    local tb = _G.GetAutoGoTable(go)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, not isOn)
    callback(self, isOn)
end

---按钮点击事件在这里派发
function SociatyManagerView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_log then
        self:OnToggle(go, isOn, self.ShowInfo)
    elseif go == self.go_table.toggle_apply then
        self:OnToggle(go, isOn, self.ShowApply)
    end
end
---踢出
function SociatyManagerView:OnBeKicked(uid)
    if uid == self.sociatyData.Uid then
        self:Close()
        return
    end
end
---@param data guild.p2c_guild_position
function SociatyManagerView:MemberLocationRefresh(data)
    for _, v in pairs(data.pos) do
        if data.pos.uid == self.sociatyData.Uid and data.pos.pos == require "MemberEnum".ELocationEnum.Member then
            self:Close()
            break
        end
    end
end

function SociatyManagerView:Dispose()
    self:RemoveAllListener()
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RefreshCondition, self.FreshCondition, self)
    self.go_table.aortext_condition.gameObject:SetActiveE(0) 
end

return SociatyManagerView
