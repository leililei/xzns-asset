---@class SociatyChangeMemberNameView : UIBaseView	中文描述
---@field public go_table SociatyChangeMemberNameView_GoTable GoTable
local SociatyChangeMemberNameView = _G.BaseClass("SociatyChangeMemberNameView", _G.UIBaseView)

function SociatyChangeMemberNameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SociatyChangeMemberNameView:OnCreate(callback)
    self.callback=callback
    self:InitChangeName()
end

local StorageManager=_G.StorageManager:GetInstance()

function SociatyChangeMemberNameView:InitChangeName()
    self.SociatyModel=require("SociatyModel"):GetInstance()
    local cost = _G.ConfigManager.discrete_cfg[201304]
    self.firstFlag = self.SociatyModel:CheckChooseNameIsFirstByTime()
    self.go_table.aortext_free:SetActiveE(self.firstFlag and 1 or 0)
    self.go_table.aortext_consume:SetActiveE(self.firstFlag and 0 or 1)
    self.custome = cost[1][2]
    self.custid = cost[1][1]
    local costItemCfg=StorageManager:GetItemDataClassByCfg(cost[1])
    self.go_table.aorrawimage_useicon:LoadImage(costItemCfg.Icon or costItemCfg.icon)
    self.go_table.aortext_consume.text = string.format("%s/%s",_G.GameUtil.NumberToUnitStr(StorageManager:GetItemCountBySid(self.custid)),self.custome)
    self.go_table.aortext_homo.text= self.SociatyModel.SociatySelf.guild_prefix
    self.go_table.input_Name.text = ""
    local cfg = _G.ConfigManager.discrete_cfg[100145][1]
    local limitNum = _G.GameUtil.GetIsUseChinese() and cfg[1] or cfg[2]
    limitNum=limitNum-string.getStringCharCount(self.SociatyModel.SociatySelf.guild_prefix)
    _G.GameUtil.InputFieldCharacterLimit(
            self.go_table.input_Name,
            limitNum,
            nil,
            true,
            nil,
            nil,
            true
    )
end
---确定
function SociatyChangeMemberNameView:EnterName()
    local msg = {}
    --msg.name = self.go_table.input_Name.text
    msg.name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(msg.name) then
        _G.PopWindowManager:GetInstance():ShowAllTips(200117)
        return
    end
    local firstFlag = _G.PlayerModel:GetInstance().update_name_times > 0
    local str=string.format("%s%s",self.SociatyModel.SociatySelf.guild_prefix,self.go_table.input_Name.text)
    _G.GameUtil.SecCheck(str, "1",function()
        require("SociatyModel"):GetInstance():ChangePlayerName(
                str,
                _G.handler(self, self.EnterNameCallBack)
        )
    end)
end

function SociatyChangeMemberNameView:EnterNameCallBack(data)
    local name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(name) then
        return
    end
    if data.ack == 1 then
        if self.callback then
            self.callback()
        end
        if not self.firstFlag then
            StorageManager:ConsumeItem(self.custid, 0, self.custome)
        end
        self:Close()
    elseif data.ack == 2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.custid)
    end
end

---按钮点击事件在这里派发
function SociatyChangeMemberNameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_concel then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if StorageManager:GetItemCountBySid(self.custid) >= self.custome then
            self:EnterName()
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.custid)
        end
    end
end

return SociatyChangeMemberNameView
