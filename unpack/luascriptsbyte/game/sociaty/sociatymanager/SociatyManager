---创建一个公会
function SociatyManager:CreateSociaty()
    _G.PoolsManager:GetInstance():Preload(
            _G.ConfigManager.ui_cfg.SociatyJoinView.PrefabPath,
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyJoinView.Name)
                local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SociatyJoinView.Name)
                if window then
                    window.View:GetSociatyRecommedList()
                end
                _G.UIManager:GetInstance():ChangeCanvasOrder(_G.ConfigManager.ui_cfg.SociatyJoinView.Name, 50, true)
            end,
            _G.ePoolType.UIItem
    )
end

---判断功能是否解锁
---@param sid number function_open_cfg 表Id
function SociatyManager:CheckFunctionIsUnlock(sid)
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(sid) then
        return true
    end
    return false, _G.ConfigManager.function_open_cfg[sid].condition_params
end

---是否在公会里面
function SociatyManager:HasSociaty()
    return SociatyModel:GetInstance().SociatyRoleSelf.uid ~= 0
end

---获取公会成员
---@return SociatyMemberBase
function SociatyManager:GetMember(uid)
    if not self:HasSociaty() then
        return nil
    end
    return require "SociatyData".GetMemberModule():GetMember(uid)
end
---刷新红点显示
function SociatyManager:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
end
---检测是否有申请
function SociatyManager:CheckHaveApply()
    if not self:HasSociaty() then
        return false
    end
    local location = SociatyModel:GetInstance().SociatyRoleSelf.position
    if _G.ConfigManager.guild_position_cfg[location].check then
        return #SociatyModel:GetInstance().SociatySelf.GetMemberModule().Requests > 0
    end
    return false
end
---检测是否有挑战次数
function SociatyManager:CheckSociatyYHNum()
    if not self:HasSociaty() then
        return false
    end
    ---入口页签
    if SociatyModel:GetInstance().SociatyYHNum == nil then
        return false
    end
    if _G.TimeUtil.GetSecondsOfDay() >= _G.ConfigManager.discrete_cfg[124401][1][1] * 3600 then
        return false
    end
    return SociatyModel:GetInstance().SociatyYHNum > 0
end

function SociatyManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSociatyEvent.RoleRequest, self.RefreshRedPoint, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end
---获取在线的公会成员
---@return table <SociatyMemberBase>
function SociatyManager:GetOnlineMember(call)
    if not self:HasSociaty() then
        if call then
            call()
        end
        return
    end
    SociatyNet:GetInstance():GetGuild(
            function(msgguild)
                SociatyModel:GetInstance():ParseData(msgguild)
                local md = SociatyModel:GetInstance().SociatySelf.GetMemberModule()
                if call then
                    call(md:GetOnlineMember())
                end
            end
    )
end
