---检测 公会雕像是否解锁
function SociatyManager.CheckGuideIsLock()
    local cfgLevel = _G.ConfigManager.discrete_cfg[102702][1][1]
    local level = SociatyModel:GetInstance().SociatySelf.Level
    return level < cfgLevel, _G.string.format(
            _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[250115].content),
            cfgLevel
    )
end

---去加入公会
---@param name string 操作界面(用于条件满足时关闭)
function SociatyManager:GotoJoin(name)
    local isTrue, level = self:CheckFunctionIsUnlock(_G.FunctionID.Sociaty)
    if isTrue then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SociatyJoinView.Name)
        _G.UIManager:GetInstance():CloseWindow(name)
        if view then
            view:ChangeView()
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SociatyJoinView.Name)
        end
    else
        local str, tipsID = _G.FunctionManager:GetInstance():GetTipsStr(_G.FunctionID.Sociaty)
        if not _G.string.IsNullOrEmpty(str) then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID, str)
        end
    end
end

--- 有数据的情况
function SociatyManager:GetSociatyInfoBack()
    if SociatyModel:GetInstance().SociatyRoleSelf.uid ~= 0 then
        SociatyNet:GetInstance():GetGuild(
                function(msgguild)
                    SociatyModel:GetInstance():ParseData(msgguild)
                    if msgguild.role_guild.uid > 0 then
                        self:EnterScence()
                    else
                        OpenJoinView()
                    end
                end
        )
    else
        OpenJoinView()
    end
end

