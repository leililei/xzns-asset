function SociatyManager:ChecktFairAwardBoxState()
    if not self:HasSociaty() then
        return false
    end
    ---获取公平竞技场宝箱状态 1,没有奖励，2 有公平竞技场奖励 3 有奖励已领完
    return SociatyModel:GetInstance().SociatySelf.curFairAwardBox ~= 1
end
---判定是否有奖励可领
---@return boolean 是否有奖励可领
function SociatyManager:CheckFairAwardGotState()
    if not self:HasSociaty() then
        return false
    end
    ---获取公平竞技场宝箱状态 1,没有奖励，2 有公平竞技场奖励 3 有奖励已领完
    if SociatyModel:GetInstance().SociatySelf.curFairAwardBox == 2 then
        local data = SociatyModel:GetInstance().SociatyRoleSelf
        return data.award == nil
    end
    return false
end
---设置自己宝箱领取状态
function SociatyManager:SetFairAwardGotState()
    if not self:HasSociaty() then
        return
    end
    ---获取公平竞技场宝箱状态 1,没有奖励，2 有公平竞技场奖励 3 有奖励已领完
    if SociatyModel:GetInstance().SociatySelf.curFairAwardBox == 2 then
        local data = SociatyModel:GetInstance().SociatyRoleSelf
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for i = 1, #data do
            if uid == data[i].uid then
                data[i].award = true
                break
            end
        end
    end
end
