---添加玩家镜像
function SociatyManager:AddCopyPlayer()
    ---@type MainWorld
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    local count1 = _G.table.count(world.AllWorldItems)
    local count2 = _G.ConfigManager.discrete_cfg[101618][1][1]
    if count1 >= count2 then
        return
    end
    local index = math.min(_G.ConfigManager.discrete_cfg[101619][1][1], world.Cfg.display_screen - count1)
    local member = SociatyModel:GetInstance().SociatySelf.GetMemberModule().Member
    local tb = _G.table.chooseToArray(
            member,
            function(k, v)
                return not world.AllWorldItems[v.Uid]
            end
    )
    _G.SortList(
            tb,
            function(item)
                return -item.OfflineTime, item.WeekVp, item.Power
            end
    )
    for _, v in pairs(tb) do
        ---@type scene.i_scene_user
        local user = {}
        user.role_uid = v.Uid
        user.title = v.Title
        user.circle = { sid = 0 }
        user.skin = v.Style
        user.role_name = v.Name
        user.start_point = 0
        user.start_time = 0
        user.end_point = 0
        user.hell_id = v.HellId
        world:CreateOtherPlayer(
                user,
                function()
                    ---@type WorldOtherPlayerItem
                    local item = world:GetItemInfo(user.role_uid)
                    local x = _G.math.random(
                            _G.ConfigManager.discrete_cfg[101615][2][1],
                            _G.ConfigManager.discrete_cfg[101615][1][1]
                    )
                    local z = _G.math.random(
                            _G.ConfigManager.discrete_cfg[101615][2][3],
                            _G.ConfigManager.discrete_cfg[101615][1][3]
                    )
                    item.Transform:SetPosition(x, 0, z)
                    item:OpenSociatyTimer()
                end
        )
        index = index - 1
        if index == 0 then
            break
        end
    end
end

---离开场景
function SociatyManager:ExitScence(uid, callback)
    --_G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)

    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if mainView then
        mainView:LeaveAndCloseSociaty(uid)
    end

    if callback then
        callback()
    end
end

