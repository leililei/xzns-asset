--- 加入军团给新入会的人的推送
function SociatyManager:OnP2CEnterGuildNew()
    local names = {
        _G.ConfigManager.ui_cfg.SociatyJoinView.Name,
        _G.ConfigManager.ui_cfg.SociatyCreateView.Name,
        _G.ConfigManager.ui_cfg.SociatyExchangeIconView.Name,
        _G.ConfigManager.ui_cfg.SociatyJoinRankView.Name
    }

    local isOpenLobby = false
    for _, name in ipairs(names) do
        local window = _G.UIManager:GetInstance():GetWindow(name)
        if window and window.Active then
            _G.UIManager:GetInstance():CloseWindow(name)
            isOpenLobby = true
        end
    end

    if isOpenLobby then
        self:EnterSociaty()
        ChatManager:GetInstance():OnJoinSociaty()
    end
end

