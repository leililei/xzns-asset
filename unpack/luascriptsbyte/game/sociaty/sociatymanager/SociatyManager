--- 点击进入公会
function SociatyManager:EnterSociaty(View)
    local isTrue, level = self:CheckFunctionIsUnlock(_G.FunctionID.Sociaty)
    if isTrue then
        if View then
            self.ChildView = View
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        end
        ---如果解锁就加入公会
        ---如果登录拿了数据
        if nil ~= SociatyModel:GetInstance().SociatyRoleSelf then
            self:GetSociatyInfoBack()
        else
            SociatyModel:GetInstance():InitData(_G.handlerbind(self, self.GetSociatyInfoBack))
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("公会没有开启")
        end
    end
end

function SociatyManager:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.SociatyMainView.Name then
        if self.ChildView then
            _G.UIManager:GetInstance():OpenWindow(self.ChildView)
        end
        self.ChildView = nil
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    elseif name == _G.ConfigManager.ui_cfg.SociatyJoinView.Name then
        self.ChildView = nil
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    end
end

