---职位变动推送
---@param data guild.p2c_guild_position
function SociatyMemberModule:OnSetPosition(data)
    ---@param v guild.i_position
    for _, v in ipairs(data.pos) do
        local member = self:GetMember(v.uid)
        if member then
            if member == self:GetSelfMember() then
                self:OnSelfRefreshLocation(v.pos)
            end
            member:RefreshLocation(v.pos)
        end
    end

    self:SortMember()
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.MemberLocationRefresh, data)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
end

