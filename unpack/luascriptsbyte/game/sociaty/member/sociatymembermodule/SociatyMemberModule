---@class SociatyMemberModule 公会成员模块
---@field Member SociatyMemberBase[] 公会成员数组
---@field MemberDic table<number,SociatyMemberBase> 公会成员字典
---@field MaxMemberNum string 公会最大成员数量
---@field CurMemberCount number 公会成员数量
---@field Requests role.i_role[]
local SociatyMemberModule = _G.BaseClass("SociatyMemberModule")
local MemberEnum = require("MemberEnum")
local SociatyMemberBase = require("SociatyMemberBase")
local ELocationEnum = MemberEnum.ELocationEnum
local ChatManager = require("ChatManager")

---@field RemoveMember fun(obj:SociatyMemberModule,uid:number) 删除成员
local RemoveMember

function SociatyMemberModule:__init()
    self.Member = {}
    self.MemberDic = {}
    self.MaxMemberNum = 0
    self.CurMemberCount = 0
    self.Requests = {}
    self:RefreshCurMemberCount()
end

---析构函数
function SociatyMemberModule:Dispose()
    self.Member = nil
    self.MemberDic = nil
    self.Requests = nil
end

local HOUR_OF_DAY = 24
local SECOND_OF_HOUR = 3600
local SECOND_OF_DAY = HOUR_OF_DAY * SECOND_OF_HOUR

---获取会长
---@return SociatyMemberBase
function SociatyMemberModule:GetChairman()
    for i = 1, #self.Member do
        if self.Member[i].Location == ELocationEnum.Chairman then
            return self.Member[i]
        end
    end
end

---公会最大成员数量
---@return number
function SociatyMemberModule:GetMaxMemberNum()
    return self.MaxMemberNum
end

---取得某个职位的数量
---@param pos number 职位
---@return number,SociatyMemberBase[]
function SociatyMemberModule:GetOfficerCount(pos)
    local tbl = {}
    for _, v in ipairs(self.Member) do
        if v.Location == pos then
            table.insert(tbl, v)
        end
    end

    return #tbl, tbl
end

---取得所有非普通成员
---@return OfficerCell[]
function SociatyMemberModule:GetAllOfficer()
    ---@class OfficerCell
    ---@param Max number 上限
    ---@param Cur number 当前人数
    ---@param Pos number 职位

    ---@type OfficerCell[]
    local res = {}

    ---@type guild_position_cfg_Item[]
    local willSet = {}
    for _, v in pairs(ConfigManager.guild_position_cfg) do
        if v.id > ELocationEnum.Chairman and v.id < ELocationEnum.Member then
            table.insert(willSet, v)
        end
    end

    ---@param a guild_position_cfg_Item
    ---@param b guild_position_cfg_Item
    table.sort(
        willSet,
        function(a, b)
            return a.display_priority < b.display_priority
        end
    )

    for _, v in ipairs(willSet) do
        ---@type OfficerCell
        local cell = {}
        cell.Pos = v.id
        cell.Max = self:GetLocationMax(v.id)
        cell.Cur = (self:GetOfficerCount(v.id))

        table.insert(res, cell)
    end

    return res
end

---获取某项职位数量上限
---@param id number
function SociatyMemberModule:GetLocationMax(id)
    if require("SociatyModel"):GetInstance().SociatySelf then
        local cfg = require("SociatyModel"):GetInstance().SociatySelf.LevelCfg.num_position
        for _, v in ipairs(cfg) do
            local _id = v[1]
            if _id == id then
                return v[2]
            end
        end
    end

    return 0
end

---设置当前成员数
---@param v number 推荐公会时只会设置这个数字
function SociatyMemberModule:RefreshCurMemberCount(v)
    if v and v ~= 0 then
        self.CurMemberCount = v
        return
    end

    if next(self.Member) then
        self.CurMemberCount = #self.Member
    end
end

---取得当前成员数
---@return number
function SociatyMemberModule:GetCurMemberCount()
    return self.CurMemberCount
end

---取得当前成员数显示字段
---@return string
function SociatyMemberModule:GetMemberDesc()
    local str = string.format("%s/%s", self:GetCurMemberCount(), self:GetMaxMemberNum())
    return str
end

---是否满人
---@return boolean
function SociatyMemberModule:IsMax()
    if _G.AppSetting.DEBUG then
        _G.Log(self:GetCurMemberCount(), "成员当前数量")
    end

    if _G.AppSetting.DEBUG then
        _G.Log(self:GetMaxMemberNum(), "成员最大数量")
    end
    return self:GetCurMemberCount() >= self:GetMaxMemberNum()
end

---取得成员索引
---@param uid number
---@return number
function SociatyMemberModule:GetIndex(uid)
    if not self.MemberDic[uid] then
        if _G.AppSetting.DEBUG then
            _G.LogError(uid, "成员不存在,uid = ")
        end
        return nil
    end

    for i, v in ipairs(self.Member) do
        if v.Uid == uid then
            return i
        end
    end

    return nil
end

---添加成员
---@param pb guild.i_guild_member
function SociatyMemberModule:AddMember(pb)
    if _G.AppSetting.DEBUG then
        _G.Log(pb, "添加成员")
    end
    local uid = pb.role.uid
    assert(uid, "uid is nil")

    if self.MemberDic[uid] then
        self.MemberDic[uid]:Refresh(pb)

        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("重复添加,uid = %s,执行刷新流程", uid))
        end
        return
    end

    if self:IsMax() then
        if _G.AppSetting.DEBUG then
            _G.LogError("超过数量限制")
        end
        return
    end

    ---@see SociatyMemberBase#__init
    local data = SociatyMemberBase.New(pb)
    self.MemberDic[uid] = data
    table.insert(self.Member, data)
    self:RefreshCurMemberCount()
end

---成员排序
function SociatyMemberModule:SortMember()
    if not next(self.Member) then
        return
    end

    ---@param a SociatyMemberBase
    ---@param b SociatyMemberBase
    table.sort(
        self.Member,
        function(a, b)
            if a.CfgItem.rank ~= b.CfgItem.rank then
                return a.CfgItem.rank < b.CfgItem.rank
            end

            if a.Power ~= b.Power then
                return a.Power > b.Power
            end

            if a.WeekVp ~= b.WeekVp then
                return a.WeekVp > b.WeekVp
            end

            return a.JoinTime < b.JoinTime
        end
    )
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.MemberRefresh)
end

---以离线时间为主的成员排序 在线>离线时间（时间从小至大）>活跃>职位>战力
function SociatyMemberModule:SortMemberByOffline()
    if not next(self.Member) then
        return
    end

    ---@param a SociatyMemberBase
    ---@param b SociatyMemberBase
    table.sort(
        self.Member,
        function(a, b)
            local levelA = self:TimeToDescLevel(a.OfflineTime)
            local levelB = self:TimeToDescLevel(b.OfflineTime)
            if levelA ~= levelB then
                return levelA < levelB
            end
            if a.WeekVp ~= b.WeekVp then
                return a.WeekVp > b.WeekVp
            end
            if a.CfgItem.rank ~= b.CfgItem.rank then
                return a.CfgItem.rank < b.CfgItem.rank
            end
            return a.Power > b.Power
        end
    )
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.MemberRefresh)
end

---以活跃度为主的成员排序(职位>在线>离线时间（时间从小至大）>活跃)
function SociatyMemberModule:SortMemberByWeekVp()
    if not next(self.Member) then
        return
    end

    ---@param a SociatyMemberBase
    ---@param b SociatyMemberBase
    table.sort(
        self.Member,
        function(a, b)
            if a.CfgItem.rank ~= b.CfgItem.rank then
                return a.CfgItem.rank < b.CfgItem.rank
            end
            local levelA = self:TimeToDescLevel(a.OfflineTime)
            local levelB = self:TimeToDescLevel(b.OfflineTime)
            if levelA ~= levelB then
                return levelA < levelB
            end
            return a.WeekVp > b.WeekVp
        end
    )
end

