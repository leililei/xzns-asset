---设置审核类型
---@param level number
---@param type number
function SociatyMemberModule:SaveCondition(level, afk_chapter, type, call)
    local mineData = self:GetSelfMember()
    if not mineData.CfgItem.set_join then
        if _G.AppSetting.DEBUG then
            _G.LogError("没有设置申请条件限制权限")
        end
        return
    end

    if require("SociatyModel"):GetInstance().SociatySelf then
        ---@type guild.c2s_guild_set_condition
        local pb = {
            ["type"] = type,
            ["lv"] = level,
            ["afk_chapter"] = afk_chapter
        }
        require("SociatyNet"):GetInstance():SetJoinCondition(
            pb,
            function()
                require("SociatyModel"):GetInstance().SociatySelf.NeedApproval = type
                require("SociatyModel"):GetInstance().SociatySelf.LimitLevel = level
                require("SociatyModel"):GetInstance().SociatySelf.LimitChapter = afk_chapter
                _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefreshCondition)
                if call then
                    call()
                end
            end
        )
    end
end

