---@param uid number
---@return SociatyMemberBase
function SociatyMemberModule:GetMember(uid)
    return self.MemberDic[uid]
end

---取得自身的公会数据
---@return SociatyMemberBase
function SociatyMemberModule:GetSelfMember()
