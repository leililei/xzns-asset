---转让会长
---@param uid number
---@param callBack fun()
function SociatyMemberModule:SwitchChairman(uid, callBack)
    local mineData = self:GetSelfMember()
    if not mineData.CfgItem.position_transfer then
        if _G.AppSetting.DEBUG then
            _G.LogError("不是会长无法执行此操作")
        end
        return
    end

    local other = self:GetMember(uid)
    if not other then
        if _G.AppSetting.DEBUG then
            _G.LogError("merber is nil   uid is " .. uid)
        end
        return
    end

    if other.Location == ELocationEnum.Chairman then
        if _G.AppSetting.DEBUG then
            _G.LogError("other is Chairman   uid is " .. uid)
        end
        return
    end

    local num = 250302
    local id = _G.ConfigManager.tips_system_cfg[num].content
    local desc = _G.GetLangPackValue(id, other.Name)

    local function confirmFunc()
        ---@type guild.c2s_guild_set_position
        local pb = {
            ["type"] = 0,
            ["uid"] = uid
        }

        require("SociatyNet"):GetInstance():SetPosition(
            pb,
            function()
                ---@type guild.p2c_guild_position
                local guild_p2c_guild_position = {
                    ["pos"] = {
                        {
                            ["uid"] = mineData.Uid,
                            --['pos'] = other.Location,
                            ---转让会长，策划需求原会长变为会员！！！！
                            ["pos"] = ELocationEnum.Member
                        },
                        {
                            ["uid"] = uid,
                            ["pos"] = ELocationEnum.Chairman
                        }
                    }
                }

                if callBack then
                    callBack()
                end
                self:OnSetPosition(guild_p2c_guild_position)
            end
        )
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(num, desc, confirmFunc)
end

---任命职位
---@param uid number
---@param pos_id number
function SociatyMemberModule:DoAppoint(uid, pos_id, callback)
    local mineData = self:GetSelfMember()
    if not mineData.CfgItem.position_set then
        if _G.AppSetting.DEBUG then
            _G.LogError("会员无法执行此操作")
        end
        return
    end

    local other = self:GetMember(uid)
    if not other then
        if _G.AppSetting.DEBUG then
            _G.LogError("merber is nil   uid is " .. uid)
        end
        return
    end
    ---@type guild.c2s_guild_set_position
    local pb = {
        ["type"] = 1,
        ["uid"] = uid,
        ["pos"] = pos_id
    }

    require("SociatyNet"):GetInstance():SetPosition(
        pb,
        function()
            ---@type guild.p2c_guild_position
            local guild_p2c_guild_position = {
                ["pos"] = {
                    {
                        ["uid"] = uid,
                        ["pos"] = pos_id
                    }
                }
            }
            self:OnSetPosition(guild_p2c_guild_position)
            if callback then
                callback()
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(250153)
        end
    )
end

