---修改公会名称
---@param name string
---@return boolean
function SociatyMemberModule:SetName(name)
    ---@type SociatyMemberBase
    local mineData = self:GetSelfMember()
    local SociatyModel = require("SociatyModel")
    if SociatyModel:GetInstance().SociatySelf then
        if not mineData.CfgItem.modify_name then
            if _G.AppSetting.DEBUG then
                _G.Log("<color=red><size=10>" .. "没有 修改公会名称 权限" .. "</size></color>")
            end
        end

        local need = _G.ConfigManager.discrete_cfg[101603][1][1]
        local isEnough = _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, need)
        if not isEnough then
            if _G.AppSetting.DEBUG then
                _G.Log("<color=red><size=10>" .. "Diamond 不够" .. "</size></color>")
            end
            return
        end

        if SociatyModel:GetInstance().SociatySelf.Name == name then
            if _G.AppSetting.DEBUG then
                _G.Log("<color=red><size=10>" .. "公会名未被修改" .. "</size></color>")
            end
            return
        end

        _G.GameUtil.SecCheck(name, "1",function()
            local pb = {
                ["name"] = name
            }

            require("SociatyNet"):GetInstance():SetName(
                    pb,
                    function()
                        _G.StorageManager:GetInstance():ConsumeItem(_G.ResPropID.Diamond, 0, need)
                        SociatyModel:GetInstance().SociatySelf.Name = name
                        _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeName)
                    end
            )
        end)

        -- local isIllegal = _G.CS.DenyWordModel.Instance:IsIllegal(name)
        -- if isIllegal then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(200118)
        -- else
        ---@type guild.c2s_guild_set_name
        
        --end
    end
end

---设置公告/入会说明
---@param notice string
---@param type number @类型 0:公会内部公告，1：入户说明
function SociatyMemberModule:SetNotice(notice, type, call)
    ---@type SociatyMemberBase
    local mineData = self:GetSelfMember()
    if require("SociatyModel"):GetInstance().SociatySelf then
        if type == 0 then
            if not mineData.CfgItem.modify_notice then
                if _G.AppSetting.DEBUG then
                    _G.LogError("没有 设置公告 权限")
                end
                return
            end
            local condition = _G.ConfigManager.discrete_cfg[101650]
            local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(condition)
            if not pass then
                local tipscfg = _G.ConfigManager.tips_system_cfg[817]

                _G.PopWindowManager:GetInstance():ShowAllTips(817, _G.GetLangPackValue(tipscfg.content, content))
                if call then
                    ---这里界面上的公告已经被改了，调用call把公告还原
                    call()
                end
                return
            end
            if require("SociatyModel"):GetInstance().SociatySelf.Declaration == notice then
                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red><size=10>" .. "设置 公会内部公告 没有变化" .. "</size></color>")
                end
                return
            end
        elseif type == 1 then
            if not mineData.CfgItem.set_join then
                if _G.AppSetting.DEBUG then
                    _G.LogError("没有设置 入会说明 权限")
                end
                return
            end
            local condition = _G.ConfigManager.discrete_cfg[101650]
            local pass, tipSid, content = _G.GlobalConditionManager.CheckConditionArrays(condition)
            -- if not pass then
            --     local tipscfg = _G.ConfigManager.tips_system_cfg[817]
            --     _G.PopWindowManager:GetInstance():ShowAllTips(817, _G.GetLangPackValue(tipscfg.content, content))
            --     return
            -- end
            if require("SociatyModel"):GetInstance().SociatySelf.JoinDeclaration == notice then
                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red><size=10>" .. "设置 入会说明 没有变化" .. "</size></color>")
                end
                return
            end
        end
        local limit = _G.ConfigManager.discrete_cfg[101401][1][1]
        local res, len = string.filterStringWithCharacterLimit(notice, limit)
        if len < 1 then
            if _G.AppSetting.DEBUG then
                _G.Log("<color=red><size=10>" .. "输入为空" .. "</size></color>")
            end
            notice = ""
        elseif len > _G.ConfigManager.discrete_cfg[101401][1][1] then
            if _G.AppSetting.DEBUG then
                _G.Log("<color=red><size=10>" .. "超过限制长度" .. "</size></color>")
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(250107)
            return
        end

        _G.GameUtil.SecCheck(notice, "1",function()
            ---@type guild.c2s_guild_set_notice
            local pb = {
                ["type"] = type,
                ["notice"] = notice
            }
            require("SociatyNet"):GetInstance():SetNotice(
                    pb,
                    function()
                        if type == 0 then
                            require("SociatyModel"):GetInstance().SociatySelf.Declaration = #notice > 0 and notice or _G.LangUtil.GetLangPackValue(90021800022)
                        elseif type == 1 then
                            require("SociatyModel"):GetInstance().SociatySelf.JoinDeclaration = #notice > 0 and notice or _G.LangUtil.GetLangPackValue(90021800022)
                        end

                        ---@type guild.p2c_guild_notice
                        local msg = {
                            ["type"] = type,
                            ["time"] = _G.TimeUtil.GetServerUnixTime(),
                            ["notice"] = notice
                        }
                        _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.ExchangeNotice, msg)
                        if call then
                            call()
                        end
                    end
            )
        end)
        -- local isIllegal = _G.CS.DenyWordModel.Instance:IsIllegal(notice)
        -- if isIllegal then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(250106)
        -- else
        
        --end
    end
end

