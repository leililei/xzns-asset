---成员退出
---@param data guild.p2c_guild_quit
---@param isKick boolean 是否踢出
function SociatyMemberModule:OnQuit(data, isKick)
    local uid = data.uid
    if isKick then
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=10>" .. uid .. " 踢出出了公会,销毁公会数据" .. "</size></color>")
        end
    else
        if _G.AppSetting.DEBUG then
            _G.Log("<color=red><size=10>" .. uid .. " 退出了公会,销毁公会数据" .. "</size></color>")
        end
    end

    if uid == _G.PlayerModel:GetInstance().role_uid then
        _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.BeKicked, uid)
        self:Dispose()
        require("SociatyModel"):GetInstance():ClearSociatySelf(isKick)
        ChatManager:GetInstance():ClearSociatyChat()
        local cursId = _G.PlayerModel:GetInstance():GetCurCitySid()

        if _G.AppSetting.DEBUG then
            _G.Log(cursId, "场景id")
        end
        ---临时的
        require("SociatyManager"):GetInstance():ExitScence(uid)
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainGuild.id)
        return
    end

    local member = self:GetMember(uid)
    if member then
        RemoveMember(self, uid)
    end
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world and world.Cfg.Sid == require("SociatyManager"):GetInstance().ScenceId then
        world:RemoveWorldItems(uid)
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.BeKicked, uid, isKick)
end

