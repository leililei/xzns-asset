function SociatyMemberModule:AddFriend(uid)
    local other = self:GetMember(uid)
    if not other then
        if _G.AppSetting.DEBUG then
            _G.LogError("merber is nil   uid is " .. uid)
        end
        return
    end

    local isFriend = other:RefreshFriendState(other)
    if isFriend then
        if _G.AppSetting.DEBUG then
            _G.LogError("merber is isFriend   uid is " .. uid)
        end
        return
    end

    ---@type friend.c2s_friend_apply
    local pb = {}
    pb.f_uid = { uid }

    ---@param ack string 中文描述
    require("FriendManager"):GetInstance():AddFriendApply(
        pb,
        function(ack)
            if ack == 1 then
                _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.AddFriendSuccess)
            end
        end
    )
end

