---时间转换（用于比较）
---@param offlineTime number 离线时间戳
---@return number 描述比较
function SociatyMemberModule:TimeToDescLevel(offlineTime)
    local level = 0
    if offlineTime > 0 then
        local left = _G.TimeUtil.GetServerUnixTime() - offlineTime
        if left < SECOND_OF_DAY then
            level = level + math.max(math.floor(left / SECOND_OF_HOUR), 1)
        else
            level = level + math.min(math.floor(left / SECOND_OF_DAY), 7) * 100
        end
    end
    return level
end

---@param self SociatyMemberModule
---@param uid number
function RemoveMember(self, uid)
    local index = self:GetIndex(uid)
    if index then
        table.remove(self.Member, index)
        self.MemberDic[uid] = nil
    end
    self:SortMember()
    self:RefreshCurMemberCount()
end

---取得成员
---@param index number
---@return SociatyMemberBase
function SociatyMemberModule:GetMemberByIndex(index)
    return self.Member[index]
end

