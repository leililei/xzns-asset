    return mineData
end

--region -------------退出/踢出-------------
---踢出
---@param role SociatyMemberBase
function SociatyMemberModule:KickOut(role, callBack)
    local uid = role.Uid
    local other = self:GetMember(uid)
    if not other then
        if _G.AppSetting.DEBUG then
            _G.LogError("merber is nil   uid is " .. uid)
        end
        return
    end

    if other.Location == ELocationEnum.Chairman then
        if _G.AppSetting.DEBUG then
            _G.LogError("你在踢出一个会长" .. uid)
        end
        return
    end

    local mineData = self:GetSelfMember()
    if not mineData.CfgItem.kick_out then
        if _G.AppSetting.DEBUG then
            _G.LogError("自身没有踢出权限")
        end
        return
    end

    ---联赛中不能解散
    if not require "SociatyBattleLeagueManager":GetInstance():CheckCanQuitState() then
        _G.PopWindowManager:GetInstance():ShowAllTips(250133)
        return
    end

    local num = 250303
    local id = _G.ConfigManager.tips_system_cfg[num].content
    local desc = _G.GetLangPackValue(id, role.Name)
    local function confirmFunc()
        ---@type guild.c2s_guild_kickout
        local data = {
            ["uid"] = uid
        }

        require("SociatyNet"):GetInstance():KickOut(
            data,
            function()
                _G.PopWindowManager:GetInstance():ShowAllTips(250153)
                self:OnQuit(data, true)
                if callBack then
                    callBack()
                end
            end
        )
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(num, desc, confirmFunc)
end

---主动退出
function SociatyMemberModule:DoQuit()
    local mineData = self:GetSelfMember()
    if mineData then
        if self:GetCurMemberCount() == 1 then
            ---公会战期间无法解散
            ---@type StateType
            local state = require("SociatyBattleModel"):GetInstance():GetState()
            if state == _G.SociatyBattleState.Battle or state == _G.SociatyBattleState.Rest then
                _G.PopWindowManager:GetInstance():ShowAllTips(250133)
                return
            end

            ---冥界纷争匹配到对手无法解散
            if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SociatyMoba) then
                if require("SociatyMobaModel"):GetInstance():IsMatchGuild() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(950102)
                    return
                end
            end

            ---联赛中不能解散
            if not require "SociatyBattleLeagueManager":GetInstance():CheckCanBreakUpState() then
                _G.PopWindowManager:GetInstance():ShowAllTips(250133)
                return
            end
        end

        ---联赛中不能退出
        if not require "SociatyBattleLeagueManager":GetInstance():CheckCanQuitState() then
            _G.PopWindowManager:GetInstance():ShowAllTips(250133)
            return
        end

        local num = 250304

        ---是否需要转让会长
        local needSwitch = false
        if mineData.Location == ELocationEnum.Chairman then
            if self:GetCurMemberCount() > 1 then
                needSwitch = true
                num = 250102
            end
        end

        if self:GetCurMemberCount() == 1 then
            num = 250309
        end

        local function confirmFunc(isCheck)
            if needSwitch then
                _G.PopWindowManager:GetInstance():ShowAllTips(250102)
                return
            end

            if isCheck ~= nil and isCheck == false then
                _G.PopWindowManager:GetInstance():ShowAllTips(250143)
                return
            end

            require("SociatyNet"):GetInstance():Quit(
                function()
                    ---@type guild.p2c_guild_quit
                    local guild_p2c_guild_quit = {
                        ["uid"] = mineData.Uid
                    }
                    self:OnQuit(guild_p2c_guild_quit, false)
                end
            )
        end
        --ZHJH-8039 首次退出和解散不弹tips直接确认
        local isFirst = require("SociatyModel"):GetInstance().SociatyRoleSelf.exit_num == 0
        if not isFirst then
            _G.PopWindowManager:GetInstance():ShowAllTips(num, nil, confirmFunc)
        else
            confirmFunc(true)
        end
        -- _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.BeKicked,mineData.Uid)
    end
end

