---显示查看申请列表窗口
function SociatyMemberModule:ShowCheckView(callback)
    local mineData = self:GetSelfMember()
    if not mineData.CfgItem.check then
        if _G.AppSetting.DEBUG then
            _G.LogError("没有验证公会申请消息权限")
        end
        return
    end

    ---@param data guild.s2c_guild_get_requests
    local function showWindow(data)
        if data.ack ~= 1 then
            if _G.AppSetting.DEBUG then
                _G.LogError(data, "GetRequests error ")
            end
            return
        end

        if not data.requests then
            data.requests = {}
        end
        self.Requests = data.requests
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
        if callback then
            callback(data)
        end
    end

    require("SociatyNet"):GetInstance():GetRequests(showWindow)
end

---同意申请
---@param uid number
function SociatyMemberModule:DoAgreeRequest(uid, requests, isAll, call)
    if self:IsMax() then
        _G.PopWindowManager:GetInstance():ShowAllTips(803)
        return
    end
    ---@type guild.c2s_guild_check_request
    local pb = {
        ["type"] = 1,
        ["uid"] = uid
    }

    ---@param msg guild.s2c_guild_check_request
    require("SociatyNet"):GetInstance():DealRequest(
        pb,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            local tb = {}
            local tb2 = {}
            for _, v in pairs(msg.reply) do
                for _, v2 in pairs(requests) do
                    if v2.role.uid == v.uid then
                        if v.ack == 1 then
                            ---@type guild.p2c_enter_guild_old
                            local msg2 = {
                                ["role"] = {
                                    role = v2.role,
                                    pos = 9,
                                    is_online = 0,
                                    week_liveness = 0,
                                    week_donate = 0,
                                    enter_time = _G.TimeUtil.GetServerUnixTime()
                                }
                            }

                            if _G.AppSetting.DEBUG then
                                _G.Log(v2.role.uid, "加入成员UID>>>>")
                            end
                            _G.table.insert(tb, msg2)
                        else
                            _G.table.insert(tb2, v.uid)
                        end
                        break
                    end
                end
            end
            if call then
                call(msg.reply)
            end
            self:OnDealRequest(uid)
            self:OnEnterMultiNewMember(tb)
            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.Enter, tb, isAll)
            ---用于移除对象
            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefuseRequest, uid, isAll)
            if isAll and not _G.table.isEmptyOrNil(tb2) then
                self:DoRefuseRequest(uid, isAll)
            end
        end
    )
end

---拒绝申请
---@param uid number
function SociatyMemberModule:DoRefuseRequest(uid, isAll)
    ---@type guild.c2s_guild_check_request
    local pb = {
        ["type"] = 0,
        ["uid"] = uid
    }

    require("SociatyNet"):GetInstance():DealRequest(
        pb,
        function()
            self:OnDealRequest(uid)
            _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RefuseRequest, uid, isAll)
        end
    )
end

