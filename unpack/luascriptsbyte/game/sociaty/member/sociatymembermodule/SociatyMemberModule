---玩家请求推送
---@param data guild.p2c_guild_request
function SociatyMemberModule:OnRoleRequest(data)
    _G.table.insert(self.Requests, data)
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RoleRequest, data)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
end

---玩家取消请求推送
---@param data guild.p2c_guild_role_request_cancel
function SociatyMemberModule:OnRoleCancelRequest(data)
    local msg = nil
    for i, v in pairs(self.Requests) do
        if v.role.uid == data.role_uid then
            _G.table.remove(self.Requests, i)
            msg = v
            break
        end
    end
    if not msg then
        LogError("self.Requests not" .. data.role_uid)
        return
    end
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.RoleRequest, msg, true)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
end

---处理请求
---@param msg
function SociatyMemberModule:OnDealRequest(uids)
    for _, v in pairs(uids) do
        for i, v2 in ipairs(self.Requests) do
            if v2.role.uid == v then
                _G.table.remove(self.Requests, i)
                break
            end
        end
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.JoinGuildButton.id, 0)
end

---获取在线的公会成员
---@return SociatyMemberBase
function SociatyMemberModule:GetOnlineMember()
    local tb = {}
    for _, v in pairs(self.MemberDic) do
        if v.OfflineTime == 0 then
            _G.table.insert(tb, v)
        end
    end
    return tb
end

---获取活跃成员
---@param time number 活跃时间检测
function SociatyMemberModule:GetActivityMember(time)
    local tb = {}
    local curTime = _G.TimeUtil.GetServerUnixTime()
    for _, v in pairs(self.MemberDic) do
        if curTime - v.OfflineTime < time or v.OfflineTime == 0 then
            _G.table.insert(tb, v)
        end
    end
    return tb
end

