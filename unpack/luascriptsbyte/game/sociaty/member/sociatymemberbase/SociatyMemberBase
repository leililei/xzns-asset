---设置基础信息
---@param role role.i_role
function SociatyMemberBase:RefreshRoleData(role,artifact_skin)
    self.Uid = role.uid
    self.Name = role.name or "None"
    self.style = role.style or 0
    self.frame = role.frame or 0
    self.lv = role.level or 0
    self.Power = role.power or 0
    self.ServerId = role.server_id or 0
    self.title = role.title or {}
    self.Style = role.city_style_id
    self.HellId = role.hell_id or 0
    self.god_halo = role.god_halo or 0
    self.artifact_skin=artifact_skin or {}
end

---析构函数
function SociatyMemberBase:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerChangeFrame, self.RefreshRoleFrame, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerChangeTitle, self.RefreshRoleTitle, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerChangeName, self.RefreshRoleName, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayerStatus.PlayerChangeIcon, self.RefreshRoleIcon, self)
    _G.Events:GetInstance():RemoveListener(_G.GlobalEvents.PlayerCorePowerSyn, self.RefreshRolePower, self)
end

---刷新
---@param pb guild.i_guild_member
function SociatyMemberBase:Refresh(pb)
    if pb then
        local uid = pb.role.uid
        if uid ~= self.Uid then
            if _G.AppSetting.DEBUG then
                _G.LogError("SociatyMemberBase:Refresh uid ~= self.Uid")
            end
        else
            self:RefreshRoleData(pb.role)
            self:RefreshLocation(pb.pos)
            self:RefreshWeekVp(pb.week_liveness)
            self:RefreshOfflineState(pb.is_online)
            self:RefreshOfflineStateDesc(pb.is_online)
        end
    end
end

local HOUR_OF_DAY = 24
local SECOND_OF_HOUR = 3600
local SECOND_OF_DAY = HOUR_OF_DAY * SECOND_OF_HOUR

---刷新离线状态描述1
---@param is_online number
function SociatyMemberBase:RefreshOfflineState(is_online)
    self.OfflineTime = is_online
    self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800064)
    self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "009a55")

    if _G.AppSetting.DEBUG then
        _G.Log(self.OfflineTime, "离线时间戳")
    end
    if self.OfflineTime > 0 then
        local left = _G.TimeUtil.GetServerUnixTime() - self.OfflineTime

        if _G.AppSetting.DEBUG then
            _G.Log(left, "离线时间")
        end
        if left <= SECOND_OF_HOUR then
            self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800065, 1)
            self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "009a55")
            return
        end

        if left > SECOND_OF_HOUR and left < SECOND_OF_DAY then
            local hour = math.floor(left / SECOND_OF_HOUR)
            self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800065, hour)
            self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "009a55")
            return
        end

        if left > SECOND_OF_DAY then
            local day = math.floor(left / SECOND_OF_DAY)
            if day < 3 then
                self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800066, 1)
                self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "009a55")
                return
            end

            if day < 5 then
                self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800066, 3)
                self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "009a55")
                return
            end

            if day < 7 then
                self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800066, 5)
                self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "009a55")
                return
            end

            if day >= 7 then
                self.OfflineDesc = _G.LangUtil.GetLangPackValue(90021800066, 7)
                self.OfflineDesc = _G.string.AddColor(self.OfflineDesc, "bf4419")
                return
            end
        end
    end
end

