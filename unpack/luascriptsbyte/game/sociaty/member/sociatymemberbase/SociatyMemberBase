---刷新是否是好友
---@param other SociatyMemberBase 其他公会成员数据
---@return boolean
function SociatyMemberBase:RefreshFriendState(other)
    local haveData = require("FriendManager"):GetInstance():GetFriendInfoByUid(other.Uid)
    if haveData then
        return true
    end

    return false
end

