local SociatyMemberBase = _G.BaseClass("SociatyMemberBase")
local MemberEnum = require("MemberEnum")
local EAuthorityEnum = MemberEnum.EAuthorityEnum
local ELocationEnum = MemberEnum.ELocationEnum

---@param pb guild.i_guild_member
function SociatyMemberBase:__init(pb)
    if nil ~= pb then
        self:Init(pb)
        ---不知道作者为什么不传参，先注释掉
        -- self:Refresh()
        self:RefreshOfflineStateDesc(pb.is_online)
    end
end

---@param pb guild.i_guild_member
function SociatyMemberBase:Init(pb)
    self:RefreshRoleData(pb.role,pb.artifact_skin)
    self.Location = pb.pos or ELocationEnum.Member
    self.OfflineTime = pb.is_online or 0
    self.WeekVp = pb.week_liveness or 0
    self.JoinTime = pb.enter_time or 0
    self.CfgItem = _G.ConfigManager.guild_position_cfg[self.Location]
    if self.Uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerChangeFrame, self.RefreshRoleFrame, self)
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerChangeTitle, self.RefreshRoleTitle, self)
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerChangeName, self.RefreshRoleName, self)
        _G.Events:GetInstance():AddListener(_G.ePlayerStatus.PlayerChangeIcon, self.RefreshRoleIcon, self)
        _G.Events:GetInstance():AddListener(_G.GlobalEvents.PlayerCorePowerSyn, self.RefreshRolePower, self)
    end
    self.donate = pb.week_donate
    self.progress = pb.role.afk
end

function SociatyMemberBase:RefreshPlayerData()
    self:RefreshRoleData({uid = _G.PlayerModel:GetInstance():GetPlayerUid()})
    _G.Events:GetInstance():Broadcast(_G.eSociatyEvent.MemberRefresh)
end

