--region -------------对其他公会成员的权限-------------

---取得对其他公会成员的权限
---@param other SociatyMemberBase 其他公会成员数据
---@return EAuthorityEnum
function SociatyMemberBase:GetAuthority(other)
    local number = 0
    local tbl = {}

    if other.Uid == _G.PlayerModel:GetInstance().role_uid then
        return tbl, number
    end

    local enum = EAuthorityEnum
    local l_enum = ELocationEnum

    local isFriend = self:RefreshFriendState(other)
    if not isFriend then
        table.insert(tbl, enum.AddFriend)
        number = number + enum.AddFriend
    end

    table.insert(tbl, enum.Chat)
    number = number + enum.Chat

    ---其他公会成员职位比玩家低
    local isRank = other.CfgItem.rank > self.CfgItem.rank

    if self.CfgItem.position_transfer and isRank then
        table.insert(tbl, enum.Switch)
        number = number + enum.Switch
    end

    if self.CfgItem.position_set then
        local con2 = other.CfgItem.id == l_enum.Member
        local haveFreePos = true
        --if self.Owenr then
        --    haveFreePos = #(self.Owenr.SociatyMemberModule:GetAllOfficer()) > 0
        --end

        if isRank and con2 and haveFreePos then
            table.insert(tbl, enum.Appoint)
            number = number + enum.Appoint
        elseif isRank and con2 == false then
            table.insert(tbl, enum.Dismiss)
            number = number + enum.Dismiss
        end
    end

    if self.CfgItem.kick_out and isRank then
        table.insert(tbl, enum.KickOut)
        number = number + enum.KickOut
    end

    return tbl, number
end

--endregion

---@return SociatyMemberBase
