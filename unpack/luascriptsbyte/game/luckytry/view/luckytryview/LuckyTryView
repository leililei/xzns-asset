---@class LuckyTryView : UIBaseView	中文描述
---@field public go_table LuckyTryView_GoTable GoTable
local LuckyTryView = _G.BaseClass("LuckyTryView", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"
local coinID = 11

function LuckyTryView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.Close, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

---界面的入口函数
function LuckyTryView:OnCreate(activity)
    self.activity = activity
    self.model = activity.typeClass
    self:InitView()
    --self:InitAni()
    self:UpdateView()
end

function LuckyTryView:OnEnable()
    if self.awardAni then
        self.awardAni:Play("award_ruchang")
    end
end

---界面创建时的初始化方法
function LuckyTryView:InitView()
    self.items = {}
end

---播放初始动画
function LuckyTryView:InitAni()
    self.awardAni = self.go_table.obj_award:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    if self.awardAni then
        self.awardAni:Play("award_ruchang")
    end
end

---界面的更新方法
function LuckyTryView:UpdateView()
    self.awardCfg = self.model:GetAwardCfg()
    self.id = self.model:Getid()
    -- item生成
    local count = 1
    for type, v in pairs(self.awardCfg) do
        self:UpdateItem(self.go_table["obj_item" .. count], type, v)
        count = count + 1
    end

    self:FreshTaskBtn()
    self:FreshDrawBtn()
end

function LuckyTryView:FreshTaskBtn()
    local subType = self.activity:GetJumpType()
    self.taskAct = ActivitySynManager:GetInstance():GetChildAcitivity(10007, subType)
    if self.taskAct then
        self.go_table.aorbtn_task:SetActiveE(1)
        self.go_table.obj_redpoint5:UpdateRedPointItemIDAndParam(
            self.taskAct:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    else 
        self.go_table.aorbtn_task:SetActiveE(0)
    end
end

-- 按钮更新
function LuckyTryView:FreshDrawBtn()
    coinID = self.model.consume_list[1].key
    self.go_table.aorrawimage_Prop1:LoadImage(
        _G.StorageManager:GetInstance():GetItemIcon(coinID),
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    local coinCount = _G.StorageManager:GetInstance():GetItemCountBySid(coinID)
    local nowNeedCount = self.model:GetNowNeedCount()
    if coinCount >= nowNeedCount then
        self.go_table.aortext_Prop1Num.text = string.format("%s/%s", coinCount, nowNeedCount)
        self.go_table.aorbtn_draw:SetGray(false)
        self.go_table.aortext_Prop1NumDesc.text = _G.GetLangPackValue(90001008404)
        self.go_table.aortext_Prop1NumDesc.color = _G.ColorTools.FormatColorByString("8C2D14")
    elseif self.taskAct and not self.taskAct.typeClass:CheckTaskOver() then
        self.go_table.aortext_Prop1Num.text = string.format("<color=red>%s</color>/%s", coinCount, nowNeedCount)
        -- 今日任务没有交完
        self.go_table.aorbtn_draw:SetGray(false)
        self.go_table.aortext_Prop1NumDesc.text = _G.GetLangPackValue(90001008403)  --前往任务
        self.go_table.aortext_Prop1NumDesc.color = _G.ColorTools.FormatColorByString("8C2D14")
    else
        self.go_table.aortext_Prop1Num.text = string.format("<color=red>%s</color>/%s", coinCount, nowNeedCount)
        -- 今日次数已获得，且次数用完
        self.go_table.aorbtn_draw:SetGray(true)
        self.go_table.aortext_Prop1NumDesc.text = _G.GetLangPackValue(90001008406)
        self.go_table.aortext_Prop1NumDesc.color = _G.ColorTools.FormatColorByString("434343")
    end
end

---播放重置奖励动画
function LuckyTryView:PlayResetAwardAni()
    if self.awardAni then
        self.awardAni:Play("award_chongzhi")
    end
end

function LuckyTryView:UpdateItem(obj, index1, awards)
    if not obj then
        return
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ItemOnClick, index1))

    if self.items[index1] then
        -- item已生成
        self:SetItem(tb, index1, awards)
    else
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.obj_award,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item)
                    return
                end
                self.items[index1] = item
                self:SetItem(tb, index1, awards)
            end)
    end
end

function LuckyTryView:SetItem(tb, index1, awards)
    local item = self.items[index1]
    tb.obj_award:SetActiveE(1)
    item:Show(awards[1], nil, awards[2])
    item:SetGou(self.model:CheckAward(index1))
end

--- item点击方法
function LuckyTryView:ItemOnClick(_, _, index1)
    if not (self.awardCfg[index1]) then
        return
    end
    -- 弹出tip
    require "CommonTipManager":GetInstance():OpenTip(self.gameObject, self.awardCfg[index1][1])
end

function LuckyTryView:ResUpdata(data)
    for _, v in pairs(data) do
        if v.type[1] == coinID then
            self:FreshDrawBtn()
        end
    end
end

---界面的销毁函数
function LuckyTryView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.Close, self)
end

---按钮点击事件在这里派发
function LuckyTryView:OnClickBtn(go)
    if go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 165)
    elseif go == self.go_table.aorbtn_draw then
        local coinCount = _G.StorageManager:GetInstance():GetItemCountBySid(coinID)
        local nowNeedCount = self.model:GetNowNeedCount()
        if coinCount >= nowNeedCount then
            -- 抽奖
            self.model:Draw({activity_id = self.activity:GetActivityID()}, function()
                self:UpdateView()
            end)
        else
            if self.taskAct and not self.taskAct.typeClass:CheckTaskOver() then 
            -- 前往任务
                self.taskAct.typeClass:OnEnterActivity()
            end
        end
        -- 明日再来
    elseif go == self.go_table.aorbtn_task then 
        self.taskAct.typeClass:OnEnterActivity()
    end
end

return LuckyTryView
