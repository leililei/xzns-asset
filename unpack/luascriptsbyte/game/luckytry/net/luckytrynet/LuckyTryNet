local base = require("BaseGameNet")

---@class LuckyTryNet : BaseGameNet	通信协议
local LuckyTryNet = _G.BaseClass("LuckyTryNet", base)
---@return LuckyTryNet LuckyTryNet
function LuckyTryNet:GetInstance()
    return  base.GetInstance(self)
end

---抽奖
function LuckyTryNet:Draw(pb, callback)
    local item = _G.ConfigManager.net_map.game_activity_try_luck_execute
    local port = base.Access(self, item, pb, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function LuckyTryNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return LuckyTryNet