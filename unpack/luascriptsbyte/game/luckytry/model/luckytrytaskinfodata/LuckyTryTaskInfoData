---@class LuckyTryTaskInfoData
local LuckyTryTaskInfoData = _G.BaseClass("LuckyTryTaskInfoData",  _G.LogicClass)

function LuckyTryTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function LuckyTryTaskInfoData:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LuckyTryTaskView.Name, self.curActivityClass)
end
---领取奖励
function LuckyTryTaskInfoData:GetAward(ids, call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            for _, v in pairs(ids) do
                self.activity.finishTask[v] = true
            end
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.activity:RefreshRedPoint()
            if call then
                call()
            end
        end
    )
end
function LuckyTryTaskInfoData:GetJumpModelType()
    return 10044
end
return LuckyTryTaskInfoData
