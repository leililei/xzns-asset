---@param msg rank.s2c_rank_record_rank
---@param nowPage number 现在传过来的是第几页的排行
function AllianceTribesRankData:RefreshServerData(msg, nowPage)
    if msg.ranks then
        nowPage = nowPage or 1
        self.serverData = self.serverData or {}
        self.serverData[nowPage] = msg
        --nowPage表明现在传过来的是第几页的排行，所以要在rank字段加上前面页数的排名
        local first = nowPage and (self:GetPageNum() * (nowPage - 1)) or 0
        for rank, d in ipairs(msg.ranks) do
            local Roledatas={}
            for i = 1, #d.role_info do
                table.insert( Roledatas,{
                    playData={uid = d.role_info[i].role_info.uid,
                              name =   d.role_info[i].role_info.name,
                              portrait =  d.role_info[i].role_info.style,
                              frame =   d.role_info[i].role_info.frame,
                              lv =   d.role_info[i].role_info.level,
                              title =   d.role_info[i].role_info.title},
                    score=  d.role_info[i].score})
            end
            local RankData = {
                rank = rank + first,
                playData = Roledatas,
                t_name = d.t_name,
                gem = d.gem
            }
            self.listRankDatas[rank + first] = RankData
        end
        self:RefreshRankData()
    end
end

function AllianceTribesRankData:RefreshRankData()
    local uid = self:GetUid()
    local count = #self.listRankDatas
    local curIntegral = 0
    ---@type ArchaeoIntegralRankData.RankData
    local curRankData = nil
    for i = 1, count do
        if self.listRankDatas[i].playData[1].playData.uid == uid then
            curIntegral = self.listRankDatas[i].value
            curRankData = self.listRankDatas[i]
            break
        end
    end
    local rankIntegral = self:GetMyIntegral()
    if curRankData ~= nil and rankIntegral ~= curIntegral then
        curRankData.value = rankIntegral
        table.sort(self.listRankDatas,function(a,b)
            if a.gem ~= b.gem then
                return a.gem > b.gem
            else
                return a.rank < b.rank
            end
        end)
        local count = #self.listRankDatas
        for i = 1, count do
            self.listRankDatas[i].rank = i
        end
    end
    return curIntegral
end

function AllianceTribesRankData:GetMyRank()
    if self.listRankDatas == 0 then
        return nil
    end
    --local uid = PlayerModel:GetPlayerUid()
    local rank = nil
    local uid = self:GetUid()
    local count = #self.listRankDatas
    for i = 1, count do
        local RoleCount=#self.listRankDatas[i].playData
        for j = 1, RoleCount do
            if self.listRankDatas[i].playData[j].playData.uid == uid then
                rank =  i
                break
            end
        end
    end
    return rank
end
function AllianceTribesRankData:GetMyTeam()
    local team_info = require "RelicTeamModel":GetInstance().team_info
    local Roledatas={}
    local gem=0
    if not team_info then
       return nil
    end
    for i = 1, #team_info.member_list do
        table.insert( Roledatas,{
            playData={uid = team_info.member_list[i].role_info.uid,
                      name =   team_info.member_list[i].role_info.name,
                      portrait =  team_info.member_list[i].role_info.style,
                      frame =   team_info.member_list[i].role_info.frame,
                      lv =   team_info.member_list[i].role_info.level,
                      title =   team_info.member_list[i].role_info.title},
            score=  team_info.member_list[i].jewel})
        gem=gem+team_info.member_list[i].jewel
    end
    local RankData = {
        rank = team_info.rank,
        playData = Roledatas,
        t_name = string.format("%s%s", team_info.name, _G.GetLangPackValue(90033500235)),
        gem = gem
    }
    return RankData
end

return AllianceTribesRankData