function BattleSongRankData:playIsOnList()
    local count = self.listRankDatas and #self.listRankDatas or 0
    local role_id = PlayerModel:GetInstance().role_uid
    for i = 1, count do
        if i then
            if self.listRankDatas[i].playData.role_uid == role_id then
                return true
            end
        end
    end
    return false
end

function BattleSongRankData:GetItemShowName(rank)

    local name = ""
    local data = self.listRankDatas[rank]
    if rank == nil then
        name = PlayerModel:GetInstance().role_name
    else
        if data ~= nil then
            name = data.playData.name
        end
    end
    return name
end

function BattleSongRankData:RefreshRankData()

    local uid = self:GetUid()
    local CurScore = self:GetMyIntegral()
    local RankScore = 0

    local count = #self.listRankDatas
    local curRankData = nil
    for i = 1, count do
        local data = self.listRankDatas[i]
        if data.playData.uid == uid then
            RankScore = data.value
            curRankData = data
            break
        end
    end

    if curRankData ~= nil and RankScore ~= CurScore then
        curRankData.value = CurScore
        LogError(self.listRankDatas)
        table.sort(self.listRankDatas, function(a, b)
            if a.value ~= b.value then
                return a.value > b.value
            else
                return a.rank < b.rank
            end
        end)
        local count = #self.listRankDatas
        for i = 1, count do
            self.listRankDatas[i].rank = i
        end
    end
    return CurScore
end

