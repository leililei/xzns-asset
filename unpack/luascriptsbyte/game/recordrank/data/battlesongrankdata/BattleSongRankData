---@param msg rank.s2c_rank_record_rank
function BattleSongRankData:RefreshServerData(msg)
    if RankUtils.RankType.BattleSongHordeSquad == self.rankType then
        if msg.member then
            self.serverData = msg
            for rank, d in ipairs(msg.member) do
                local RankData = {
                    rank = rank,
                    playData = {
                        uid = d.role.uid,
                        name = d.role.name,
                        portrait = d.role.style,
                        frame = d.role.frame,
                        lv = d.role.level,
                        title = d.role.title
                    },
                    value = d.score,
                    camp = d.camp
                }
                self.listRankDatas[rank] = RankData
            end
            self:RefreshRankData()
        end
    else
        BattleSongRankData.super.RefreshServerData(self, msg)
    end
    self.isOnList = self:playIsOnList()
end

