function GMArenaPeakRankData:GetMyRank()
    if self.listRankDatas == 0 then
        return nil
    end
    --local uid = PlayerModel:GetPlayerUid()
    local rank = nil
    local uid = self:GetUid()
    local count = #self.listRankDatas
    for i = 1, count do
        if self.listRankDatas[i].playData.uid == uid then
            rank = i
            break
        end
    end
    local GMArenaPeakModel = require("GMArenaPeakModel"):GetInstance()
    if rank and GMArenaPeakModel:CheckScoreIsKing() and GMArenaPeakModel.rankNum ~= rank then 
        GMArenaPeakModel.rankNum = rank 
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
        if ctrl then 
            ctrl:UpdateView()
        end
    end
    return rank
end

function GMArenaPeakRankData:GetItemShowName(rank)
    if rank == nil then
        return _G.PlayerModel:GetInstance().role_name
    end
    if self.listRankDatas[rank] == nil then
        return ""
    end
    return self.listRankDatas[rank].playData.name or self.listRankDatas[rank].t_name
end

