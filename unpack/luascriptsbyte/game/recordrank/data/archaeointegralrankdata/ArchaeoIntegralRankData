function ArchaeoIntegralRankData:GetMyRank()
    if self.listRankDatas == 0 then
        return nil
    end
    --local uid = PlayerModel:GetPlayerUid()
    local rank = nil
    local uid = self:GetUid()
    local count = #self.listRankDatas
    for i = 1, count do
        if self.listRankDatas[i].playData.uid == uid then
            rank = i
            break
        end
    end
    return rank
end

