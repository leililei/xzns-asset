function ArchaeoIntegralRankData:RefreshRankData()
    local uid = self:GetUid()
    local count = #self.listRankDatas
    local curIntegral = 0
    ---@type ArchaeoIntegralRankData.RankData
    local curRankData = nil
    for i = 1, count do
        if self.listRankDatas[i].playData.uid == uid then
            curIntegral = self.listRankDatas[i].value
            curRankData = self.listRankDatas[i]
            break
        end
    end
    local rankIntegral = self:GetMyIntegral()
    if curRankData ~= nil and rankIntegral ~= curIntegral then
        curRankData.value = rankIntegral
        table.sort(self.listRankDatas, function(a, b)
            if a.value ~= b.value then
                return a.value > b.value
            else
                return a.rank < b.rank
            end
        end)
        local count = #self.listRankDatas
        for i = 1, count do
            self.listRankDatas[i].rank = i
        end
    end
    return curIntegral
end

