local ArchaeoIntegralRankData = BaseClass("ArchaeoIntegralRankData", RankDataBase)

---@class ArchaeoIntegralRankData.RankData
---@field rank number 排名
---@field playData rank.i_record_rank 玩家数据
---@field value number 积分值
---@field camp number 阵营

function ArchaeoIntegralRankData:InitData()
    self.IsActive = true

    self.listRankDatas = {}
end

---@param msg rank.s2c_rank_record_rank
---@param nowPage number 现在传过来的是第几页的排行
function ArchaeoIntegralRankData:RefreshServerData(msg, nowPage)
    if msg.ranks then
        nowPage = nowPage or 1
        self.serverData = self.serverData or {}
        self.serverData[nowPage] = msg
        --nowPage表明现在传过来的是第几页的排行，所以要在rank字段加上前面页数的排名
        local first = nowPage and (self:GetPageNum() * (nowPage - 1)) or 0
        for rank, d in ipairs(msg.ranks) do
            local RankData = {
                rank = rank + first,
                playData = {
                    uid = d.role_info.uid,
                    name = d.role_info.name,
                    portrait = d.role_info.style,
                    frame = d.role_info.frame,
                    lv = d.role_info.level,
                    title = d.role_info.title,
                    power = d.role_info.power,
                    city_style_id = d.role_info.city_style_id,
                    artifact_skin=d.artifact_skin or {}
                },
                value = d.score,
                camp = d.camp
            }
            self.listRankDatas[rank + first] = RankData
        end
        self:RefreshRankData()
    end
end

