local RankDataBase = require("RankDataBase")
---@class CrossServiceCompPerson:RankDataBase
local CrossServiceCompPerson = BaseClass("CrossServiceCompPerson",RankDataBase)


---@class CrossServiceCompPerson.RankData
---@field role_info role.i_role
---@field score number 排行值

function CrossServiceCompPerson:GetCmd()
    local model = require("ActivityTournamentModel"):GetInstance()
    local state = model.stage
    if state >= 4 then
        return ConfigManager.net_map.game_rank_rank_tournament_eliminate
    else
        return ConfigManager.net_map.game_rank_rank_tournament_preselect
    end
end

function CrossServiceCompPerson:InitData()
    self.IsActive = true

    ---@type CrossServiceCompPerson.RankData[]
    self.listRankDatas = {}
end

---@return bool
function CrossServiceCompPerson:GetPlayIsOnRank()
    local uid = _G.PlayerModel:GetInstance().role_uid
    local count = #self.listRankDatas
    for i = 1, count do
        if self.listRankDatas[i].role_info.uid == uid then
            return true ,self.listRankDatas[i],i
        end
    end
    return false
end

---@param msg rank.s2c_rank_pub_info
---@param nowPage number 现在传过来的是第几页的排行
function CrossServiceCompPerson:RefreshServerData(msg, nowPage)
    if msg.ranks then
        nowPage = nowPage or 1
        self.serverData[nowPage] = msg.ranks
        self.listRankDatas = msg.ranks
        self:RefreshRankData()
    end
end

function CrossServiceCompPerson:RefreshRankData()
    local uid = _G.PlayerModel:GetInstance().role_uid
    local count = #self.listRankDatas
    local curIntegral = 0
    ---@type ArchaeoIntegralRankData.RankData
    local curRankData = nil
    for i = 1, count do
        if self.listRankDatas[i].role_info.uid == uid then
            curIntegral = self.listRankDatas[i].value[1]
            curRankData = self.listRankDatas[i]
            break
        end
    end
    local rankIntegral = self:GetMyIntegral()
    if curRankData ~= nil and rankIntegral ~= curIntegral and count > 0 then
        curRankData.value[1] = rankIntegral
        table.sort(self.listRankDatas,function(a,b)
            if a.value[1] ~= b.value[1] then
                return a.value[1] > b.value[1]
            else
                return a.role_info.uid < b.role_info.uid
            end
        end)
        local count = #self.listRankDatas
        for i = 1, count do
            self.listRankDatas[i].rank = i
        end
    end
    return curIntegral
end

---获取我的积分
function CrossServiceCompPerson:GetMyIntegral()
    local model = require("ActivityTournamentModel"):GetInstance()
    local integral = model:GetScore()
    return integral and integral or 0
end

function CrossServiceCompPerson:GetMyRank()
    local uid = _G.PlayerModel:GetInstance().role_uid
    local count = #self.listRankDatas
    for i = 1, count do
        if self.listRankDatas[i].role_info.uid == uid then
           return i
        end
    end
    return nil
end

