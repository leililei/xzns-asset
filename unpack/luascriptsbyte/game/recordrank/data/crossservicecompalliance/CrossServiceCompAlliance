local CrossServiceCompAlliance = BaseClass("CrossServiceCompAlliance", CrossServiceCompPerson)

function CrossServiceCompAlliance:GetCmd()
    return ConfigManager.net_map.game_rank_rank_tournament_eliminate
end

---@param msg rank.s2c_rank_pub_info
---@param nowPage number 现在传过来的是第几页的排行
function CrossServiceCompAlliance:RefreshServerData(msg, nowPage)
    if msg.ranks then
        nowPage = nowPage or 1
        self.serverData[nowPage] = msg.ranks
        self.listRankDatas = msg.ranks
        self:RefreshRankData()
    end
end

function CrossServiceCompAlliance:RefreshRankData()
    local count = #self.listRankDatas
    local curIntegral = 0

    if count > 0 then
        for i = 1, count do
            self.listRankDatas[i].rank = i
        end
    end
    return curIntegral
end

function CrossServiceCompAlliance:GetMyRank()
    local uid = _G.PlayerModel:GetInstance().role_uid
    local count = #self.listRankDatas
    for i = 1, count do
        if self.listRankDatas[i].role_info.uid == uid then
            return self.listRankDatas[i].value
        end
    end
    return nil
end

return CrossServiceCompAlliance