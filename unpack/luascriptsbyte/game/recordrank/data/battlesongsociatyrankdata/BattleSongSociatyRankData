function BattleSongSociatyRankData:GetMyIntegral()
    if SociatyManager:GetInstance():HasSociaty() then
        local uid = self:GetUid()
        local count = #self.listRankDatas
        local RankScore = 0
        for i = 1, count do
            local data = self.listRankDatas[i]
            if data.uid == uid then
                RankScore = data.score
                break
            end
        end
        return RankScore
    end
    return 0
end

