---回调监听点赞记录
---@param msg record_rank.s2c_record_day_point
---@param callback fun():void
function RecordRankModel:OnLinkRecordInfoCall(msg, callback)
    if not msg then
        return
    end
    self.linkDatas = {}
    self.linkCounts = {}
    if msg.point then
        for _, v in pairs(msg.point) do
            ---@type RecordRankLinkData
            local d = { count = #v.uids, state = {} }
            for _, uid in pairs(v.uids) do
                d.state[uid] = 1
                self.linkCounts[uid] = (self.linkCounts[uid] or 0) + 1
            end
            self.linkDatas[v.type] = d
        end
    end

    if callback then
        callback()
    end
end

