    local value = msg.score or msg.high_floor or msg.sid

    ---死魂塔此处传的是tower_cfg.id, 需要转为层数
    if rankId == 8 then
        if value and value > 0 then
            local cfg = _G.ConfigManager.tower_cfg[value]
