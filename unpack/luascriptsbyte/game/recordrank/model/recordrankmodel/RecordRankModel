---从服务器拉取数据
function RecordRankModel:GetDataFormServer()
    --初始化状态
    local count = 0
    local function callback()
        count = count + 1
        if count >= 3 then
            self:ParseData() --全部初始化完成, 调用ParseData进入下一步
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RecordRankMainView.Name)
            if view then
                view:UpdateAllRank()
            end
            view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RecordRankListView.Name)
            if view then
                view:SetRank(view.rankId)
                view:SetView("rank")
            end
        end
    end

    self:GetLinkRecordInfo(callback)
    self:GetAllDataOfRecursive({ 1, 2, 3, 4, 5, 6, 7, 8, 9 }, callback)
    self:GetAllBookInfo(callback)
end

---递归的拉取每个排行榜的数据(拉取排行榜数据和奖励数据)
---@param list number[]             需要请求的排行榜列表
---@param callback fucntion         结束后执行回调函数
function RecordRankModel:GetAllDataOfRecursive(list, callback)
    if not list or #list <= 0 then
        if callback then
            callback()
        end
        return
    end
    local rankId = table.remove(list, 1)

    local count = 0
    local function finish()
        count = count + 1
        if count >= 2 then
            self:GetAllDataOfRecursive(list, callback)
        end
    end
    self:GetListInfo(rankId, finish)
    self:GetAwardInfo(rankId, finish)
end

---注册监听, 玩家达成排行榜目标(刷新红点)
---@param rankId number
function RecordRankModel:OnAwardNodeUpdate(rankId)
    if not rankId then
        return
    end
    --拉取排行榜, 刷新红点
    self:GetAwardInfo(
        rankId,
        function()
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankAward.id,
                rankId
            )
            if AppSetting.IsXzns then
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
                )
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
                )
            end
            -- if rankId == 7 then
            --     --如果是放置关卡, 刷新放置首通状态
            --     require "PingDingLingYuModel":GetInstance():GetInfo()
            -- end
        end
    )
end

---注册监听, 玩家达成首通目标
---@param data record_rank.i_node[]
function RecordRankModel:OnFirstClearUpdate(data)
    if not data then
        return
    end

    if not self.bookDatas then
        self.bookDatas = {}
    end
    for _, d in pairs(data) do
        self.bookDatas[d.sid] = d
    end

    --刷新红点信息
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RecordRankBook.id)

    if AppSetting.IsXzns then
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
        )
    end
end

