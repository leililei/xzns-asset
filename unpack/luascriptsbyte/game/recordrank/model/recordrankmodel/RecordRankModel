---回调监听奖励记录
---@param msg record_rank.s2c_record_rank_node_info
---@param rankId number     排行榜类型
---@param callback fun(msg:any):void
function RecordRankModel:OnAwardInfoCallback(msg, rankId, callback)
    if not self.awardDatas then
        self.awardDatas = {}
    end
    local awardData = self.awardDatas[rankId]
    if not awardData then
        awardData = { get = {}, records = {} }
        self.awardDatas[rankId] = awardData
    end

    if msg.nodes then
        for _, node in pairs(msg.nodes) do
            awardData.records[node.sid] = {
                time = node.time,
                role_info = {
                    uid = node.uid,
                    name = node.name,
                    style = node.portrait,
                    frame = node.frame,
                    level = node.lv,
                    title = node.title
                }
            }
        end
    end
    if msg.award then
        for _, sid in pairs(msg.award) do
            awardData.get[sid] = true
        end
    end
    if callback then
        callback()
    end
end

