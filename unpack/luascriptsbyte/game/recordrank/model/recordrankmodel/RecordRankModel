function RecordRankModel:OnCardPowerChange(uid)
    if self.powerTipTimer then
        return
    end
    if self:GetListData(9) == nil then
        return
    end
    if not require("CardResonanceModel"):GetInstance():CheckCardIsInPos(uid) then
        return
    end
    self.powerTipTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdatePowerRank, self, true, false, true)
    self.powerTipTimer:Start()
end

function RecordRankModel:UpdatePowerRank()
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local rank = 0
    local err = true
    for i, v in pairs(self.listRankDatas[9]) do
        if v.value then
            if power > v.value then
                rank = i
                break
            end
        else
            if _G.AppSetting.DEBUG and err then
                err = false
                _G.LogError(v, "灵域簿排行榜数据乱码, 联系下后台")
            end
        end
    end
    if rank > 0 then
        if self.lastPowerRank == nil or rank < self.lastPowerRank then
            self.lastPowerRank = rank
            --local content = _G.GetLangPackValue(90025700058, rank)
            --require("CommonTipManager").OpenRankUpView(content)
        end
    end
    self.powerTipTimer:Stop()
    self.powerTipTimer = nil
end

