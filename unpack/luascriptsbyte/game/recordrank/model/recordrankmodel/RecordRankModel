---回调监听点赞
---@param msg public.s2c_common_ack
---@param callback fun(msg:any):void
function RecordRankModel:OnLinkCallback(msg, rankId, uid, callback)
    if not msg or msg.ack ~= 1 then
        return
    end

    --记录点赞状态
    if not self.linkDatas then
        self.linkDatas = {}
    end
    local linkRecord = self.linkDatas[rankId]
    if not linkRecord then
        linkRecord = { count = 0, state = {} }
        self.linkDatas[rankId] = linkRecord
    end
    linkRecord.count = linkRecord.count + 1
    linkRecord.state[uid] = 1
    --对某玩家的总点赞次数
    if not self.linkCounts then
        self.linkCounts = {}
    end
    self.linkCounts[uid] = (self.linkCounts[uid] or 0) + 1

    --同步点赞次数
    --因为排行榜不会很快同步状态, 因此不应该直接增加次数(下次打开页面又会还原)
    --此处做法为使用"点赞次数"+"自己今日对uid点赞次数"作为总次数计算
    --服务器约2小时同步一次, 此做法存在一定逻辑问题但不大, 实际运营时更是问题不大, 作为性能优化手段是合理的
    --local rankList = self.listRankDatas and self.listRankDatas[rankId]
    --if rankList then
    --    for _, d in pairs(rankList) do
    --        if uid == d.role_info.uid then
    --            d.point = d.point + 1
    --            break
    --        end
    --    end
    --end
    --同步自己的点赞次数
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        --local selfData = self.selfRankDatas and self.selfRankDatas[rankId]
        --if selfData then
        --    selfData.point = selfData.point + 1
        --end
        _G.PlayerModel:GetInstance():AddPoint(1)
    end

    --如果有奖励
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    end

    if callback then
        callback(msg)
    end
end

