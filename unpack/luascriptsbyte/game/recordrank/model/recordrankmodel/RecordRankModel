local RecordRankNet = require("RecordRankNet")
local RankUtils = require("RankUtils")

---@class RecordRankModel : Singleton
---@field GetInstance fun():RecordRankModel
---@field mainRankDatas table<number, record_rank.i_first>      主界面数据
---@field listRankDatas table<RankUtils.RankType, RecordRankData[]>         各排行榜数据
---@field selfRankDatas table<number, RecordRankData>           自己的排行榜数据
---@field linkDatas table<number, RecordRankLinkData>           各排行榜点赞记录, table<排行榜类型,记录数据>
---@field linkCounts table<number, number>                      今日点赞状态, table<玩家uid, 次数>
---@field awardDatas table<number, RecordRankAwardData>         各排行榜奖励记录, table<排行榜类型,奖励数据>
---@field lstAwardCfg table<number, rank_cfg[]>                 各排行奖励配置表
---@field bookDatas table<number, record_rank.i_achieve>        灵域薄首通数据
---@field bookAwardDatas table<number, boolean>                 灵域薄首通奖励
---@field lstBookCfg table<number, rank_achievement[]>          灵域薄配置表
local RecordRankModel = _G.BaseClass("RecordRankModel", _G.GameDataModelBase)
local PowerToTheTopModel = require("PowerToTheTopModel"):GetInstance()

function RecordRankModel:__init()
    self.lstAwardCfg = {}

    ---@type table<RankUtils.RankType, RankDataBase>   各排行榜数据缓存
    self.rankDataDict = {}
    for _, cfg in pairs(_G.ConfigManager.rank_cfg) do
        local lst = self.lstAwardCfg[cfg.type_rank]
        if not lst then
            lst = {}
            self.lstAwardCfg[cfg.type_rank] = lst
        end
        table.insert(lst, cfg)
    end

    self.lstBookCfg = {}
    for _, cfg in pairs(_G.ConfigManager.rank_achievement) do
        local lst = self.lstBookCfg[cfg.tab]
        if not lst then
            lst = {}
            self.lstBookCfg[cfg.tab] = lst
        end
        table.insert(lst, cfg)
    end
    --对id进行从小到大排序
    for _, lst in pairs(self.lstBookCfg) do
        table.sort(
            lst,
            function(a, b)
                return a.id < b.id
            end
        )
    end

    --注册事件
    _G.Events:GetInstance():AddListener(_G.eRecordRankEvent.RecordRankAwardUpdate, self.OnAwardNodeUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eRecordRankEvent.RecordRankFirstClearUpdate, self.OnFirstClearUpdate, self)
end

function RecordRankModel:Dispose()
    self.mainRankDatas = nil
    self.listRankDatas = nil
    self.selfRankDatas = nil
    self.linkDatas = nil
    self.linkCounts = nil
    self.bookDatas = nil
    self.bookAwardDatas = nil

    --移除事件
    _G.Events:GetInstance():RemoveListener(_G.eRecordRankEvent.RecordRankAwardUpdate, self.OnAwardNodeUpdate, self)
    _G.Events:GetInstance():RemoveListener(
        _G.eRecordRankEvent.RecordRankFirstClearUpdate,
        self.OnFirstClearUpdate,
        self
    )
end

---获取主界面排行信息
---@param rankId number
---@return record_rank.i_first
function RecordRankModel:GetMainData(rankId)
    if not self.mainRankDatas then
        return nil
    end
    local d = self.mainRankDatas[rankId]
    if d and d.value <= 0 then
        d = nil --无效进度值, 置为nil
    end
    return d
end

---获取排行榜数据
---@param rankId number
---@return RecordRankData[]
function RecordRankModel:GetListData(rankId)
    if not self.listRankDatas then
        return nil
    end
    return self.listRankDatas[rankId]
end

---获取自己的排行数据
---@param rankId number
---@param inRankCache boolean       在排行榜缓存数据中取值
---@return RecordRankData,number    自己的数据, 自己的排名
function RecordRankModel:GetSelfData(rankId, inRankCache)
    if not inRankCache then
        if not self.selfRankDatas then
            return nil, -1
        end
        return self.selfRankDatas[rankId], -1
    end
    --从排行榜缓存中取值
    local list = self:GetListData(rankId)
    if not list then
        return nil
    end
    local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for rank, d in pairs(list) do
        if d.role_info.uid == selfUid then
            return d, rank
        end
    end
    return nil, -1
end

---获取自己的空数据
---@param rankId number
---@return RecordRankData
function RecordRankModel:GetSelfEmptyData(rankId)
    return {
        type = rankId,
        value = 0,
        point = _G.PlayerModel:GetInstance():GetPoint(),
        role_info = _G.PlayerModel:GetInstance():GetIRroleTable()
    }
end

---清空自己的排行数据
---@return void
function RecordRankModel:ClearSelfData()
    self.selfRankDatas = nil
end

---是否已对目标角色进行点赞
---@param rankId number
---@param uid number
---@return boolean
function RecordRankModel:IsLinked(rankId, uid)
    if not self.linkDatas then
        return false
    end
    local linkRecord = self.linkDatas[rankId]
    if not linkRecord then
        return false
    end

    return linkRecord.state[uid] and linkRecord.state[uid] > 0 or false
end

---能否对目标角色进行点赞, 如不能返回tip_id
---@param rankId number
---@param uid number
---@return boolean,number   是否可以点赞, 对应的tip_id
function RecordRankModel:CanLink(rankId, uid)
    if not self.linkDatas then
        return false, 0
    end
    local linkRecord = self.linkDatas[rankId]
    if not linkRecord then
        return true, 0
    end

    --检查次数是否已满
    local maxCount = _G.ConfigManager.discrete_cfg[109102][1][2]
    if linkRecord.count >= maxCount then
        return false, 740103
    end
    --检查是否已经点赞
    if linkRecord.state[uid] and linkRecord.state[uid] > 0 then
        return false, 740104
    end
    
    return true, 0
end

---是否有点赞奖励
---@return boolean
function RecordRankModel:HasLinkAward()
    return self:GetLinkCount(1) <= 0
end

---获取今日对某玩家总共点赞次数
