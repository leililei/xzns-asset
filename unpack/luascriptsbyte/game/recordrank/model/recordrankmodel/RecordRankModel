---获取节点达成记录(返回nil则表示无人达成)
---@param rankId number
---@param id number         奖励ID
---@return RecordRankAwardRecordData
function RecordRankModel:GetAwardRecord(rankId, id)
    if not self.awardDatas then
        return nil
    end
    local recordData = self.awardDatas[rankId]
    if not recordData then
        return nil
    end
    return recordData.records[id]
end

---能否领取节点奖励
---@param rankId number
---@param id number         奖励ID
---@return RecordRankAwardRecordData
function RecordRankModel:CanGetAward(rankId, id)
    if not self.awardDatas then
        return false
    end
    local recordData = self.awardDatas[rankId]
    return not recordData or not recordData.get[id]
end

---获取上榜人数
---@param rankId number
---@return number
function RecordRankModel:GetRankPlayerCount(rankId)
    if not self.listRankDatas then
        return 0
    end
    local lst = self.listRankDatas[rankId]
    if not lst then
        return 0
    end
    return #lst
end

---是否有可领取奖励
---@param rankId number
---@return boolean
function RecordRankModel:HasAwardReceive(rankId)
    if not self.awardDatas then
        return false
    end
    local awardRecord = self.awardDatas[rankId]
    if not awardRecord then
        return false
    end
    for id, _ in pairs(awardRecord.records) do
        if not awardRecord.get[id] then
            return true
        end
    end
    return false
end

---获取今日已点赞总数
---@param defaultValue number   未初始化时的返回值, 默认: 0
---@return number
function RecordRankModel:GetLinkCount(defaultValue)
    if not self.linkDatas then
        return defaultValue or 0
    end
    local count = 0
    for _, d in pairs(self.linkDatas) do
        count = count + d.count
    end
    return count
end

