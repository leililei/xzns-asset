---获取排行榜列表数据(page填几就拉几页的数据)
---@param rankId number
---@param callback fun():void
function RecordRankModel:GetListInfoByPage(rankId, callback, page)
    self.nowGettingPage = self.nowGettingPage or {}
    if not self.nowGettingPage[rankId] then 
        if self.listRankDatas then
            self.listRankDatas[rankId] = nil
        end
        self.nowGettingPage[rankId] = 1
        RecordRankNet:GetInstance():GetListInfo(rankId, 1, _G.handlerbind(self, self.GetListInfoByPageCallBack, rankId, callback,page, self.nowGettingPage[rankId]))
    else 
        self.nowGettingPage[rankId] = self.nowGettingPage[rankId] + 1
        RecordRankNet:GetInstance():GetListInfo(rankId, self.nowGettingPage[rankId], _G.handlerbind(self, self.GetListInfoByPageCallBack, rankId, callback,page, self.nowGettingPage[rankId]))
    end
end

function RecordRankModel:GetListInfoByPageCallBack(msg, rankId, callback, page, nowPage)
    self:OnListInfoCallback(msg, rankId, nil, nowPage)
    local num = 0
    if msg.rankers then 
        num = #msg.rankers
    elseif  msg.ranks then
        num = #msg.ranks
    elseif  msg.deads then
        num = #msg.deads
    end
    if page == nowPage or num < self.rankDataDict[rankId]:GetPageNum() then 
        if callback then 
            callback()
        end
        self.nowGettingPage[rankId] = nil
    else 
        self:GetListInfoByPage(rankId, callback, page)
    end
end

---回调监听排行列表数据
---@param msg rank.s2c_rank_record_rank
---@param callback fun():void
function RecordRankModel:OnListInfoCallback(msg, rankId, callback, nowPage)
    if not self.listRankDatas then
        self.listRankDatas = {}
        if self.refreshPowerRankTime then
            _G.coroutine.stopwaiting(self.refreshPowerRankTime)
            self.refreshPowerRankTime = nil
        end
    end

    if self:GetRankData(rankId) then
        --nowPage表明现在传过来的是第几页的排行
        self.rankDataDict[rankId]:RefreshServerData(msg, nowPage)
    else
        self.rankDataDict[rankId] = RankUtils.NewRankDataBase(rankId,msg)
    end
    --nowPage表明现在传过来的是第几页的排行，所以要在rank字段加上前面页数的排名
    local first = nowPage and (self.rankDataDict[rankId]:GetPageNum() * (nowPage - 1)) or 0
    if msg.rankers then
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        local lst = {}
        for rank, d in ipairs(msg.rankers) do
            lst[rank + first] = {
                type = d.type,
                value = d.value,
                point = d.point,
                role_info = {
                    uid = d.uid,
                    name = d.name,
                    style = d.portrait,
                    frame = d.frame,
                    level = d.lv,
                    title = d.title
                }
            }
            if rankId == 9 and d.uid == uid then
                self.lastPowerRank = rank
            end
        end
        self.listRankDatas[rankId] = lst
    elseif msg.deads then
        local lst = {}
        --死魂岛或者死魂试炼排行榜
        for rank, d in ipairs(msg.deads) do
            lst[rank + first] = {
                type = rankId,
                value = d.count_pass,
                point = d.role_info.point,
                role_info = d.role_info
            }
        end
        self.listRankDatas[rankId] = lst
    elseif msg.ranks then
        for rank, d in ipairs(msg.ranks) do
            d.point = 0
            if d.value then
                d.value = d.value[1]
            end
        end
        self.listRankDatas[rankId] = msg.ranks
    else
        self.listRankDatas[rankId] = nil
    end
    self:RefreshPowerRank()

    if callback then
        callback()
    end
end

--- 监测自己的排行榜有没有提升
function RecordRankModel:CheckSelfRank(type, value, lanID)
    if self.listRankDatas == nil or self.listRankDatas[type] == nil then
        return
    end

    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(146) then
        if PowerToTheTopModel.PowerToTheTopPanDuan() then
            return
        end
    end

    local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()

    local oldRank = 0

    for k, v in pairs(self.listRankDatas[type]) do
        if v.role_info.uid == selfUid then
            oldRank = k
        end
    end

    local newRank
    for i, v in pairs(self.listRankDatas[type]) do
        if value > v.value then
            newRank = i
            break
        end
    end

    if newRank then
        if newRank < oldRank or oldRank == 0 then
            oldRank = newRank
            local content = _G.GetLangPackValue(lanID, newRank)
            require("CommonTipManager").OpenRankUpView(content)
        end
        --- 排名有变化，立刻去拉取对应排行数据
        self.powerRank = type
        self:GetListInfo(type)
    end
end

function RecordRankModel:RefreshPowerRank()
    if self.refreshPowerRankTime then
        return
    end
    self.refreshPowerRankTime = DelayDo(1,function()
        if  self.powerRank == nil or self.listRankDatas[self.powerRank] == nil then
            return
        end
        local selfUid = _G.PlayerModel:GetInstance():GetPlayerUid()

        local power = 0
        local cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
        for _, v in pairs(cards) do
            power = power + v.power
        end
        local newtable = self.listRankDatas[self.powerRank]
        for k, v in pairs(self.listRankDatas[self.powerRank]) do
            if v.role_info.uid == selfUid then
                v.value = power
                break
            end
        end

        table.sort(newtable,function(a,b)
            if a.value == b.value then
                return true
            end
            return a.value > b.value
        end)
        self.listRankDatas[self.powerRank] = newtable
        self.powerRank = nil
        self.refreshPowerRankTime = nil
    end)
end

