---获取进度描述信息
---@param rankId number @1-5雷风水火土死魂塔, 6神, 7冒险, 8死魂塔主塔
---@param value number  @进度值（积分或者放置关卡sid,死魂塔层数）
---@param shortText boolean  生成短文本
---@return string
function RecordRankModel:GetProgressDescription(rankId, value, shortText)
    if rankId >= 1 and rankId <= 6 then
        --积分榜
        return shortText and tostring(value) or _G.GetLangPackValue(90025700025, value)
    elseif rankId == 7 then
        local cfg = _G.ConfigManager.afk_cfg[value]
        if cfg then
            local progress = cfg.chapter .. "-" .. cfg.section
            return shortText and progress or _G.GetLangPackValue(90025311601, progress)
        end
    elseif rankId == 8 then
        --local cfg = _G.ConfigManager.tower_cfg[value]
        --if cfg then
        --    local progress = tostring(cfg.layer)
        --    return shortText and progress or _G.GetLangPackValue(90025311701, progress)
        --end
        local progress = tostring(value)
        return shortText and progress or _G.GetLangPackValue(90025311701, progress)
    elseif rankId == 9 then
        value = _G.UIUtils.NumberToUnitStr_CardFightNum(value)
        return shortText and value or _G.GetLangPackValue(90025700007, value)
    elseif rankId == 10 then
        if value > 0 then
            value = require "SecretRealmModel":GetInstance():GetName(value)
        else
            value = ""
        end
        return value
    elseif self:GetRankData(rankId) then
        return self:GetRankData(rankId):GetProgressDescription(value, shortText)
    end
    return tostring(value)
end

