---回调监听领取奖励
---@param msg public.s2c_common_ack
---@param rankId number     排行榜类型
---@param callback fun(msg:any):void
function RecordRankModel:OnAwardCallback(msg, idList, callback)
    if msg.ack ~= 1 then
        return
    end
    for _, id in ipairs(idList) do
        local cfg = _G.ConfigManager.rank_cfg[id]
        if not cfg then
            if _G.AppSetting.DEBUG then
                _G.LogError("unknown rank_cfg.id=" .. id)
            end
        else
            --更新领取状态
            if not self.awardDatas then
                self.awardDatas = {}
            end
            local awardData = self.awardDatas[cfg.type_rank]
            if not awardData then
                awardData = { get = {}, records = {} }
                self.awardDatas[cfg.type_rank] = awardData
            end
            awardData.get[id] = true
        end
    end

    --如果有奖励
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    end

    if callback then
        callback(msg)
    end
end

