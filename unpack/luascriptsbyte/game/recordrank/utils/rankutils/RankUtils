function RankUtils.SetRankItemBgIcon(bgicon, rank)
    if rank and rank > 3 then
        bgicon:SetActiveE(0)
        --bgicon.SpriteName =RankUtils.RankBgIconName[4] --可能图集不符合
        return
    end
    bgicon:SetActiveE(1)
    bgicon.SpriteName = RankUtils.RankBgIconName[rank]
end

---@param gotable _obj_SpecialRankNode_GoTable
---@param rank number
function RankUtils.SetObj_SpecialRankNode(gotable, rank)
    if rank > 3 then
        return
    end
    gotable.aorimage_rank:LoadSprite(RankUtils.SpecialRankIcon[rank])
    for i = 1, 3 do
        gotable["aortext_rank" .. i]:SetActiveE(rank == i and 1 or 0)
    end
end

---设置前三名显示
function RankUtils.SetTop3RankStyle(index, objImage, objText)
    if index > 3 or index < 1 then
        return
    end
    objImage.SpriteName = RankUtils.SpecialRankIcon[index]
    objText.text = index
    require("CommonTipManager"):GetInstance():SetTextGradient(
        RankUtils.RankGradientColors[index],
        RankUtils.RankGradientAlpha,
        objText
    )
end

