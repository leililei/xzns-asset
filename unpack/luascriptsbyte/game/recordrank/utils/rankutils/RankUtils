---@return RewardPreviewView.OpenData|RewardPreviewView.OpenBaseRankData
function RankUtils.GetData(id, myRank, myRankValue, myRankValueStr, data, configref, stratId, Endid, isShowPlayRankNode, RankType)
    if RankUtils.RewardPreviewConfig[id] == nil then
        return nil
    end
    local config = RankUtils.RewardPreviewConfig[id]
    if myRank ~= nil then
        ---@type RewardPreviewView.OpenBaseRankData
        local data = {
            id = id,
            uiPath = config.uiPath,
            luaName = config.luaName,
            tagName = config.tagName,
            myRank = myRank, --我的排名
            myRrankValue = myRankValue, --军功值 text = GetLangPackValue(myRankValueStr,myRankValue)
            myRankValueStr = config.myRankStr or myRankValueStr, --右下角显示的key,目前是“军功：%s”
            ItemLua = config.ItemName,
            datas = data, --自定义数据
            config = configref, --奖励配置
            configStartId = stratId, --从励配置的那个id开始取奖励
            configEndId = Endid,
            isShowPlayRankNode = isShowPlayRankNode or 1, --是否显示玩家排名节点
            RankType = RankType, --排行榜类型
        }
        return data
    end
    return RankUtils.RewardPreviewConfig[id]
end

