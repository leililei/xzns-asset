local base = require("BaseGameNet")
---@class RecordRankNet : BaseGameNet    通信协议
---@field GetInstance fun():RecordRankNet
local RecordRankNet = _G.BaseClass("RecordRankNet", base)

---注册服务器推送消息
function RecordRankNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.record_rank_node.Cmd, self.P2CAwardNodeUpdate)
    self:AddMessageListener(_G.ConfigManager.net_map.record_rank_achievement.Cmd, self.P2CFirstClearUpdate)
end
---注册监听, 玩家达成排行榜目标
---@param msg record_rank_p2c_record_rank_node
function RecordRankNet:P2CAwardNodeUpdate(msg)
    _G.Events:GetInstance():Broadcast(_G.eRecordRankEvent.RecordRankAwardUpdate, msg.type)
end
---注册监听, 玩家达成首通目标
---@param msg record_rank.p2c_record_rank_achievement
function RecordRankNet:P2CFirstClearUpdate(msg)
    _G.Events:GetInstance():Broadcast(_G.eRecordRankEvent.RecordRankFirstClearUpdate, msg.achieve)
end

---获取 排行榜一级界面 信息
---@param callback function 回调函数
function RecordRankNet:GetMainInfo(callback)
    local item = _G.ConfigManager.net_map.game_record_rank_first_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---获取排行榜数据
---@param rankId RankUtils.RankType     排行榜类型
---@param page number       请求页数
---@param callback function 回调函数
function RecordRankNet:GetListInfo(rankId, page, callback)
    local item = rankId == 1 and _G.ConfigManager.net_map.game_rank_rank_l or
        rankId == 2 and _G.ConfigManager.net_map.game_rank_rank_f or
        rankId == 3 and _G.ConfigManager.net_map.game_rank_rank_s or
        rankId == 4 and _G.ConfigManager.net_map.game_rank_rank_h or
        rankId == 5 and _G.ConfigManager.net_map.game_rank_rank_t or
        rankId == 6 and _G.ConfigManager.net_map.game_rank_rank_god or
        rankId == 7 and _G.ConfigManager.net_map.game_rank_rank_afk or
        rankId == 8 and _G.ConfigManager.net_map.game_rank_rank_dead_island or
        rankId == 9 and _G.ConfigManager.net_map.game_rank_role_power or
        rankId == 10 and _G.ConfigManager.net_map.game_rank_secret_realm or
        nil
    if item == nil then
        local model = require("RecordRankModel"):GetInstance()
        local data = model:GetRankData(rankId)
        item = data:GetCmd()
    end
    if not item then
        if _G.AppSetting.DEBUG then
            _G.LogError("unknown rank type: " .. rankId)
        end
        return
    end
    local port = base.Access(self, item, { page = page }, _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---获取自己的排行数据
---@param rankId number     排行榜类型
---@param callback function 回调函数
function RecordRankNet:GetSelfInfo(rankId, callback)
    local item, pbData
    if rankId == 7 then
        pbData = self:GetEmptyPB()
        item = _G.ConfigManager.net_map.game_afk_info
    elseif rankId == 8 then
        pbData = self:GetEmptyPB()
        item = _G.ConfigManager.net_map.game_dead_soul_island
    else
        pbData = { type = rankId }
        item = _G.ConfigManager.net_map.game_record_rank_score_info
    end
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---获取灵域薄点赞记录
---@param callback function 回调函数
function RecordRankNet:GetLinkRecordInfo(callback)
    local item = _G.ConfigManager.net_map.game_get_record_day_point
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---灵域簿点赞
---@param rankId number     排行榜类型
---@param uid numerb        玩家uid
---@param callback function 回调函数
function RecordRankNet:DoLink(rankId, uid, callback)
    local item = _G.ConfigManager.net_map.game_record_day_point
    local port = base.Access(self, item, { type = rankId, uid = uid }, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---获取奖励数据
---@param rankId number     排行榜类型
---@param callback function 回调函数
function RecordRankNet:GetAwardInfo(rankId, callback)
    local item = _G.ConfigManager.net_map.game_record_rank_node_info
    local port = base.Access(self, item, { type = rankId, info_type = 0 }, _G.handler(self, self.Callback))
    self.Call[port] = callback
