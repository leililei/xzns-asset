---获取灵域薄首通状态详情(排行数据)
---@param sid number        rank_achievement.id
---@param callback function 回调函数
function RecordRankNet:GetBookDetailsInfo(sid, callback)
    local item = _G.ConfigManager.net_map.game_record_rank_achieve_rank
    local port = base.Access(self, item, { sid = sid }, _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---领取灵域薄奖励
---@param sid number        rank_achievement.id
---@param callback function 回调函数
function RecordRankNet:GetBookAward(sid, callback)
    local item = _G.ConfigManager.net_map.game_record_rank_achieve_award
    local port = base.Access(self, item, { sid = sid }, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---处理回调回调
function RecordRankNet:Callback(port, data, error)
    if error then
        return
    end

    local callback = self.Call[port]
    if callback then
        self.Call[port] = nil
        callback(data)
    end
end

return RecordRankNet
