            self.rankId == 8 and 90037010118 or      --通关层数
            self.rankId == 7 and 90021300109 or      --关卡
            self.rankId == 9 and 90020300107 or      --战力
            self.rankId == 10 and 90032800138 or     --大秘境层数
            nil                                      --积分
        )
        if tip == "nil" then
            tip = _G.GetLangPackValue(self.rankData:GetRankTitle3Tip())
        end
        --标题信息
        self.go_table.aortext_rankTitle3.text = tip
        --elseif view == "award" then
        --    utils.forceUpdateScrollRectHeight(self.go_table.scrollloopvectical_awardList)
        --    self:InitAward()
    end
end

---初始化前三玩家数据
---@return void
function RecordRankListView:InitTopInfos()
    --初始化前三玩家
    self.topPlayerDatas = {}
    for i = 1, TOP_PLAYER_COUNT do
        if self.rankDatas[i] then
            table.insert(self.topPlayerDatas, { data = self.rankDatas[i] })
        else
            break
        end
    end
    self:GetTopInfos()
end

---获取前三玩家角色形象信息(全部完成后执行模型加载逻辑)
---@return void
function RecordRankListView:GetTopInfos()
    if not self.topPlayerDatas or self:IsNil() then
        return
    end
    local players = self.topPlayerDatas

    for i = 1, TOP_PLAYER_COUNT do
        local player = players[i]
        if player and player.data and not player.role then
            require("SystemSettingNet"):GetInstance():GetPlayerInfo(
                { uid = player.data.role_info.uid },
                function(msg)
                    if players ~= self.topPlayerDatas then
                        --加载逻辑已被中断
                        return
                    end
                    if not msg.info then
                        return
                    end
                    player.role = msg.info
                    self:GetTopInfos() --拉取下一个玩家的信息
                end
            )
            return
        end
    end

    --所有角色数据已加载完毕
    self:ClearAllRoleModel()
    self:UpdateTopInfos()
    self:UpdateAllRoleModel()
end

---更新前三玩家UI信息
---@return void
function RecordRankListView:UpdateTopInfos()
    if not self.topPlayerItems then
        self.topPlayerItems = {}
        for i = 1, TOP_PLAYER_COUNT do
            self.topPlayerItems[i] = _G.GetAutoGoTable(self.go_table["obj_info" .. i])
            self.topPlayerItems[i].rank = i
            _G.AddViewBtnClick(
                self.topPlayerItems[i].gameObject,
                _G.handlerbind(self, self.OnLinkClickBtn, self.topPlayerItems[i])
            )
        end
    end
    local model = require("RecordRankModel"):GetInstance()
    for i = 1, TOP_PLAYER_COUNT do
        local tb = self.topPlayerItems[i]
        local player = self.topPlayerDatas[i]
        if player and player.data then
            tb.data = player.data
            tb.gameObject:SetActiveE(1)
            tb.aortext_name.text = player.data.role_info.name
            tb.aortext_desc.text = self.model:GetProgressDescription(self.rankId, player.data.value, true)
            --点赞状态
            local uid = player.data.role_info.uid
            local isLinked = self.model:IsLinked(self.rankId, uid)
            local point = player.data.point + self.model:GetLinkPlayerCount(uid)
            if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                point = _G.PlayerModel:GetInstance():GetPoint()
            end
            tb.obj_link:SetActiveE(self.rankId ~= 10 and 1 or 0)
            tb.aortext_linkNum.text = tostring(point)
            tb.aorbtn_link:SetActiveE(isLinked and 0 or 1)
            tb.obj_linked:SetActiveE(isLinked and 1 or 0)
            tb.obj_redpoint:SetActiveE((isLinked or not model:HasLinkAward()) and 0 or 1)
            self:UpdateTop3Title(tb, player.role.title, i)
        else
            tb.data = nil
            tb.obj_link:SetActiveE(0)
            tb.aortext_name.text = _G.GetLangPackValue(90000010159)
            tb.aortext_desc.text = ""
            tb.obj_redpoint:SetActiveE(0)
        end
        if _G.AppSetting.IsXzns then
            GameUtil.SetUiHeXieMask(tb)
        end
    end
end

---生成称号
---@param item table
function RecordRankListView:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

--region 排行榜视图

---初始化排行榜数据
function RecordRankListView:InitRank()
    local count = #self.rankDatas - TOP_PLAYER_COUNT
    if count < EMPTY_LIST_COUNT then
        count = EMPTY_LIST_COUNT
    end
    self.go_table.scrollloopvectical_rankList:UpdateCount(count)
end

---刷新排行榜节点
---@param index number      数据序号(C#从0开始)
---@param obj UnityEngine.GameObject
function RecordRankListView:RefreshRankItem(index, obj)
    if not self.rankItems then
        self.rankItems = {}
    end

    local item = self.rankItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnLinkClickBtn, item))
        self.rankItems[obj:GetInstanceIDE()] = item
    end

    local rank = index + 1 + TOP_PLAYER_COUNT
    local data = self.rankDatas and self.rankDatas[rank] or nil
    self:ShowRankItem(item, rank, data)
end

---设置排行榜节点数据
---@param item RecordRankListView._obj_rankItem_GoTable
---@param rank number
---@param data RecordRankData
function RecordRankListView:ShowRankItem(item, rank, data)
    item.rank = rank
    item.data = data

    --排名
    item.aortext_rank.text = tostring(rank)
    item.aortext_rank:SetActiveE(rank >= 1 and 1 or 0)
    if item.obj_noRank then
        item.obj_noRank:SetActiveE(rank >= 1 and 0 or 1)
    end
    --人物数据
    if data then
        item.aortext_desc.text = self.model:GetProgressDescription(self.rankId, data.value)
        item.aortext_name.text = data.role_info.name or "???"
        if item.aortext_Power then
            item.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.role_info.power)
        end
        --点赞状态
        local uid = data.role_info.uid
        local isLinked = self.model:IsLinked(self.rankId, uid)
        local point = data.point + self.model:GetLinkPlayerCount(uid)
        if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            point = _G.PlayerModel:GetInstance():GetPoint()
            _G.UIUtils.SetPlayerHeadItemNew(
                item.obj_head,
                _G.PlayerModel:GetInstance():GetIRroleTable(),
                1,
                true,
                true,
                true
            )
        else
            _G.UIUtils.SetPlayerHeadItemNew(item.obj_head, data.role_info, 1, true, true, true)
        end
        item.aortext_linkNum.text = tostring(point)
        item.aortext_linkNum.color = _G.ColorTools.FormatColorByString(isLinked and "5d463a" or "cc551b")
        item.aorbtn_link:SetActiveE(isLinked and 0 or 1)
        item.obj_linked:SetActiveE(isLinked and 1 or 0)
    end
    item.obj_content:SetActiveE(data and 1 or 0)
    if item.obj_noBody then
        item.obj_noBody:SetActiveE(data and 0 or 1)
    end

    --红点
    if item.obj_redpoint and self.rankId ~= 10 then
        local hasLinkAward = data and self.model:CanLink(self.rankId, data.role_info.uid) and self.model:HasLinkAward()
        item.obj_redpoint:SetActiveE(hasLinkAward and 1 or 0)
    end
end

---更新自己的排名状态
---@return void
function RecordRankListView:UpdateSelfRank()
    --获取自己的排行信息
    local selfData, selfRank = self.model:GetSelfData(self.rankId, true)
    if not selfData then
        selfData, selfRank = self.model:GetSelfData(self.rankId, false)
    end
    self:ShowRankItem(self.selfRankItem, selfRank, selfData or self.model:GetSelfEmptyData())
    if not selfData then
        --从服务器重新拉取数据
        self.model:GetSelfInfo(
            self.rankId,
            function()
                selfData, selfRank = self.model:GetSelfData(self.rankId, false)
                self:ShowRankItem(self.selfRankItem, selfRank, selfData or self.model:GetSelfEmptyData())
            end
        )
    end
end

