---@type numebr 顶级玩家展示数量
local TOP_PLAYER_COUNT = 3

---@type number 列表显示玩家不足以下数量时, 强制显示以下数量
local EMPTY_LIST_COUNT = 10 - TOP_PLAYER_COUNT

---@type number 传奇排行榜id
local GOD_RANK_ID = 6

local utils = {
    ---强制更新一次Canvas, 然后重新计算ScrollView的大小
    ---@param view ScrollLoopVertical
    forceUpdateScrollRectHeight = function(view)
        _G.CS.UnityEngine.Canvas.ForceUpdateCanvases()
        local _, height = view.transform:GetRectTransformSize()
        view:UpdateScrollRectHeight(height)
    end
}

---@class RecordRankListView : UIBaseView    灵域薄排行视图
---@field go_table RecordRankListView_GoTable
---@field model RecordRankModel
---@field showAllTag boolean                                                        @是否展示所有标签
---@field rankId number                                                             @排行榜类型, 1-5雷风水火土死魂塔, 6神, 7冒险, 8死魂塔主塔
---@field rankItems table<any,RecordRankListView._obj_rankItem_GoTable>             @排行榜列表节点
---@field selfRankItem RecordRankListView._obj_rankItem_GoTable                     @自己的排行节点
---@field rankDatas RecordRankData[]                                                @排行榜列表数据
---@field awardDatas rank_cfg[]                                                     @奖励列表数据
---@field topPlayerItems RecordRankListView._obj_info2_GoTable[]                    @顶级玩家节点
---@field topPlayerDatas TopPlayerData[]                                            @顶级玩家数据
---@field typeTogs table<string,RecordRankListView._toggle_type1_GoTable>           @排行榜类型toggle
---@field view "rank"|"award"                                                       @当前视图模式
local RecordRankListView = _G.BaseClass("RecordRankListView", _G.UIBaseView)

function RecordRankListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    local resources = _G.ConfigManager.ui_cfg.RecordRankListView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function RecordRankListView:OnDestroy()
    self:ClearAllRoleModel()
    self.roleTrans = nil
    _G.PoolsManager:GetInstance():ClearPoolAll(_G.ePoolType.Temporary)
end

function RecordRankListView:OnCreate(rankId, allTag, showTagList)
    for i = 1, TOP_PLAYER_COUNT do
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RecordRankItem .. i,
            _G.GetAutoGoTable(self.go_table["obj_info" .. i]))
    end
    for i = 1, TOP_PLAYER_COUNT do
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RecordRankItem .. i, _G.GetAutoGoTable(self.go_table["obj_info" .. i]))
    end
    self.model = require("RecordRankModel"):GetInstance()
    --初始化
    self.rankId = rankId
    self.rankData = self.model:GetRankData(rankId)
    self.showAllTag = allTag or false
    ---@type RankUtils.RankType[]
    self.showTagDict = showTagList
    if showTagList == nil then
        showTagList = { rankId }
    end
    utils.forceUpdateScrollRectHeight(self.go_table.scrollloopvectical_rankList)
    self:Init()
    self:SetRank(rankId)
    self:SetView("rank")
    --滑动视图到最左边
    if rankId <= 3 and self.showAllTag then
        ---@type UnityEngine.UI.ScrollRect
        local component = self.go_table.obj_type:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
        if not _G.IsNil(component) then
            --_G.CS.UnityEngine.Canvas.ForceUpdateCanvases()
            component.horizontalNormalizedPosition = 0
            component:StopMovement()
        end
    end
end

function RecordRankListView:Init()
    self.go_table.obj_rankItem:SetActiveE(0)

    self.selfRankItem = _G.GetAutoGoTable(self.go_table.obj_selfRank)

    --是否显示"传奇"标签, 以开服天数为准
    local showGod = true
    local cfg = _G.ConfigManager.discrete_cfg[106706]
    if not cfg or _G.PlayerModel:GetInstance():GetServerOpenDuration() <= cfg[1][1] * 86400 then
        showGod = false
    end

    --rank type
    self.typeTogs = {}
    for i = 1, 9 do
        local temp = self.go_table["toggle_type" .. i]
        if temp then
            temp:SetName(tostring(i))
            ---@type RecordRankListView._toggle_type1_GoTable
            local tb = _G.GetAutoGoTable(temp)
            self.typeTogs[temp:GetName()] = tb
            if self.rankId == i then
                temp.isOn = true
            else
                --if self.showTagDict[i] == nil then
                --    tb.gameObject:SetActiveE(0)
                --else
                --    tb.gameObject:SetActiveE(1)
                --end
                if not self.showAllTag or i == GOD_RANK_ID and not showGod then
                    tb.gameObject:SetActiveE(0)
                end
            end
            tb.aorimage_isOn:SetActiveE(self.rankId == i and 1 or 0)
            tb.aorimage_isOff:SetActiveE(self.rankId ~= i and 1 or 0)
        end
    end

    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshRankItem))
end

---切换rank id
---@return void
function RecordRankListView:SetRank(rankId)
    self.rankId = rankId
    self.RankData = self.model:GetRankData(rankId)
    self.rankDatas = self.model:GetListData(self.rankId) or {}
    self.awardDatas = self.model:GetAwardCfg(self.rankId) or {}
    --初始化前三玩家
    self:InitTopInfos()
    --初始化红点系统
    self.go_table.obj_redpointAward:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.RecordRankAward.id,
        rankId
    )
    --self.go_table.obj_redpointRank:UpdateRedPointItemIDAndParam(
    --    _G.ConfigManager.redpoint_cfg.RecordRankLink.id,
    --    rankId
    --)
end

---切换视图状态
---@param view "rank"|"award"   @切换至视图
---@return void
function RecordRankListView:SetView(view)
    self.view = view
    self.go_table.scrollloopvectical_rankList:SetActiveE(view == "rank" and 1 or 0)
    --self.go_table.scrollloopvectical_awardList:SetActiveE(view == "award" and 1 or 0)
    self.go_table.aorbtn_award:SetActiveE((view == "rank" and self.rankId ~= 10) and 1 or 0)
    --self.go_table.aorbtn_rank:SetActiveE(view == "award" and 1 or 0)
    --self.go_table.obj_tip:SetActiveE(view == "award" and 1 or 0)
    self.go_table.obj_selfRoot:SetActiveE(view == "rank" and 1 or 0)
    --标题
    --local type = view == "rank" and 1 or view == "award" and 2 or 0
    --self.go_table.aortext_title.text = self.model:GetTitleDescription(self.rankId, type)

    --刷新视图
    if view == "rank" then
        utils.forceUpdateScrollRectHeight(self.go_table.scrollloopvectical_rankList)
        self:InitRank()
        self:UpdateSelfRank()

