---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function RecordRankListView:LoadRoleModel(rolepath, posIndex, scale,cfg,data)
    ---@type RecordRankListView._obj_info1_GoTable
    local info = _G.GetAutoGoTable(self.go_table["obj_info" .. posIndex])
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(info.trans_role)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
            self.roleTrans[posIndex] = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            -- self:UpdateHalo(posIndex, rolePoint)
            -- self:UpdateTitle(posIndex, rolePoint)
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local godHaloID = data.role.god_halo
           
                if godHaloID ~= 0 then
                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                    --- 神环路径，父级路径(加载角色的下面)
                    _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                end
                if not table.isEmptyOrNil(data.role.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,data.role.artifact_skin[1],data.role.artifact_skin[2])
                end
            end
        end
    )
end

function RecordRankListView:UpdateHalo(pos, rolePoint)
    if self.halo[pos] then
        _G.PoolsManager:GetInstance():Despawn(self.halo[pos], _G.ePoolType.Temporary)
        self.halo[pos] = nil
    end
    local haloId = self.topPlayerDatas[pos].role.halo.sid
    if haloId == nil or haloId <= 0 then
        return
    end
    local parent = self.roleTrans[pos]
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[haloId]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo[pos] = trans
            if cfg.type_halo == 2 then
                self.halo[pos]:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo[pos]:GetParent():GetLocalScale()
                local rate = 1
                self.halo[pos]:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo[pos]:GetChildE(0):SetActiveE(1)
            self.halo[pos]:SetEulerAngles(0, 0, 0)
            self.halo[pos]:SetLocalPositionToZero()
        end
    )
end

function RecordRankListView:UpdateTitle(pos, rolePoint)
    local titleId = self.topPlayerDatas[pos].role.title.sid
    local parent = self.roleTrans[pos]
    if not self.title[pos] or _G.IsNil(self.title[pos].gameObject) then
        if not titleId or titleId <= 0 then
            return
        end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if (_G.IsNil(parent)) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.title[pos] = go_table
                self:SetTitlePos(pos, rolePoint)
                go_table.aortext_TextName.text = ""

                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[titleId]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(self.titleScale)
                            end
                        )
                        if self.title[pos].item then
                            _G.DestroyObject(self.title[pos].item)
                            self.title[pos].item = nil
                        end
                        self.title[pos].aorrawimage_Title:SetActiveE(1)
                    else
                        self.title[pos].aorrawimage_Title:SetActiveE(0)
                        if self.title[pos].item then
                            _G.DestroyObject(self.title[pos].item)
                            self.title[pos].item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.title[pos].gameObject,
                            function(trans)
                                if self:IsNil() then
                                    _G.DestroyObject(trans)
                                    return
                                end
                                trans:SetLayerAndChild(30)
                                self.title[pos].item = trans
                                local x, y, z = self.title[pos].aorrawimage_Title:GetPosition()
                                trans:SetPosition(x, y + 0.2, z)
                                self.title[pos].item:SetLocalScaleXYZ(self.titleScale)
                                trans:SetActiveE(1)
                            end
                        )
                    end
                end
            end
        )
    elseif self.title[pos] then
        if self.title[pos].item then
            _G.DestroyObject(self.title[pos].item)
            self.title[pos].item = nil
        end
        if not titleId or titleId <= 0 then
            self.title[pos].aorrawimage_Title:SetActiveE(0)
            return
        end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[titleId]
        if cfg.type_title == 1 then
            self.title[pos].aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.title[pos].aorrawimage_Title:SetNativeSize()
                    self.title[pos].aorrawimage_Title:SetLocalScaleXYZ(self.titleScale)
                end
            )
            self.title[pos].aorrawimage_Title:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.title[pos].gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.title[pos].item = trans
                    local x, y, z = self.title[pos].aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.title[pos].item:SetLocalScaleXYZ(self.titleScale)
                    trans:SetActiveE(1)
                end
            )
            self.title[pos].aorrawimage_Title:SetActiveE(0)
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function RecordRankListView:SetTitlePos(pos, rolePoint)
    _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if self.title[pos] and not _G.IsNil(self.title[pos].gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans[pos]
                    if parent == nil then
                        ---快速切换角色时gameObj可能被置位nil
                        return
                    end
                    local position = {}
                    position.x = x
                    position.z = z
                    position.y = y - 0.19
                    local scale = parent:GetLocalScale()
                    local rate = 1
                    self.title[pos].gameObject:SetLocalScaleXYZ(rate * 0.8 / scale)
                    self.title[pos].transform:SetLocalPositionToZero()
                    self.title[pos].transform:SetPosition(position.x, position.y, position.z)
                end
            end
        end
    )
end

---刷新所有角色
function RecordRankListView:UpdateAllRoleModel()
    if not self.title then
        self.title = {}
    end
    if not self.halo then
        self.halo = {}
    end
    if not self.roleTrans then
        self.roleTrans = {}
    end

    for i = 1, TOP_PLAYER_COUNT do
        local data = self.topPlayerDatas[i]
        if data and data.role then
            local cfg = require "CardCommentManager":GetInstance():CardData(data.role.city_style_id, false)
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
            self:LoadRoleModel(path, i, cfg.size4, cfg,data)
        else
        end
    end
end

function RecordRankListView:ClearAllRoleModel()
    for i = 1, TOP_PLAYER_COUNT do
        --回收角色模型
        ---@type RecordRankListView._obj_info1_GoTable
        local temp = _G.GetAutoGoTable(self.go_table["obj_info" .. i])
        local tempCount = temp.trans_role:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
        if self.halo and self.halo[i] then
            _G.PoolsManager:GetInstance():Despawn(self.halo[i], _G.ePoolType.Temporary)
            self.halo[i] = nil
        end
        if self.title and self.title[i] then
            _G.PoolsManager:GetInstance():Despawn(self.title[i].gameObject, _G.ePoolType.Temporary)
            self.title[i] = nil
        end
    end
end

