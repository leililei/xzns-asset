---处理按钮事件
function RecordRankListView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
        --elseif go == self.go_table.aorbtn_rank then
        --    self:SetView("rank")
    elseif go == self.go_table.aorbtn_award then
        --self:SetView("award")
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordAwardListView.Name, self.rankId)
    else
        --rank type
        local goName = go:GetName()
        ---@type RecordRankListView._toggle_type1_GoTable
        local typeTog = self.typeTogs and self.typeTogs[goName]
        if typeTog then
            typeTog.aorimage_isOn:SetActiveE(isOn and 1 or 0)
            typeTog.aorimage_isOff:SetActiveE(not isOn and 1 or 0)
            if isOn then
                local rankId = tonumber(goName)
                if rankId == self.rankId then
                    return
                end
                self:ClearAllRoleModel()
                --重新刷新列表
                self:SetRank(rankId)
                self:SetView(self.view or "rank")
            end
        end
    end
end

---处理点赞事件
---@param item {rank:number, data:RecordRankData, aorbtn_playerInfo:AorButton, aorbtn_link:AorButton}
function RecordRankListView:OnLinkClickBtn(go, _, item)
    if not item.data then
        return
    end

    if go == item.aorbtn_link then
        local playerUid = item.data.role_info.uid
        ---检查能否点赞
        local ok, tipId = self.model:CanLink(self.rankId, playerUid)
        if not ok then
            if tipId and tipId > 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipId)
            end
            return
        end
        ---执行点赞请求
        self.model:DoLink(
            self.rankId,
            playerUid,
            function(msg)
                --刷新节点状态
                self:UpdateSelfRank()
                self.go_table.scrollloopvectical_rankList:UpdateAllItem()

                --如果是顶级玩家, 更新其状态
                if item.rank <= TOP_PLAYER_COUNT then
                    self:UpdateTopInfos()
                end
                --如果是自己
                if playerUid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                    self:UpdateSelfRank()
                end

                --如果有奖励信息
                if msg and msg.award then
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                        _G.ConfigManager.redpoint_cfg.RecordRankLink.id
                    )
                    if AppSetting.IsXzns then
                        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
                        )
                        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
                        )
                    end
                    _G.UIUtils.ShowCommonAward(msg)
                end
            end
        )
    elseif go == item.aorbtn_playerInfo and item.data.role_info then
        _G.SystemSettingManager:GetInstance():OpenView(item.data.role_info.uid)
    end
end

