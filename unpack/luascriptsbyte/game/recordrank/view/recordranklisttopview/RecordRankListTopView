---@class RecordRankListTopView : UIBaseView	灵域薄排行视图
---@field go_table RecordRankListTopView_GoTable
---@field model RecordRankModel
---@field rankId number                                                             @排行榜类型, 1-5雷风水火土死魂塔, 6神, 7冒险, 8死魂塔主塔
---@field rankItems table<any,RecordRankListTopView._obj_rankItem_GoTable>          @排行榜列表节点
---@field rankDatas RecordRankData[]                                                @排行榜列表数据
local RecordRankListTopView = _G.BaseClass("RecordRankListTopView", _G.UIBaseView)

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "0ui_icon_diyi",
    "0ui_icon_dier",
    "0ui_icon_disan"
}
function RecordRankListTopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function RecordRankListTopView:OnCreate(data)
    self.data = data
    self.rankId = data.id
    self.model = require("RecordRankModel"):GetInstance()

    --初始化
    self.rankDatas = {}
    self.model:GetBookDetailsInfo(self.rankId, function(msg)
        self.rankDatas = msg
        self:InitRank()
    end)
    self:InitAward()
end

function RecordRankListTopView:InitRank()
    self.go_table.scrollloopvectical_rankList:InitItemData(5, _G.handler(self, self.RefreshRankItem))
end

--region 排行榜视图

---刷新排行榜节点
---@param index number      数据序号(C#从0开始)
---@param obj UnityEngine.GameObject
function RecordRankListTopView:RefreshRankItem(index, obj)
    if not self.rankItems then
        self.rankItems = {}
    end

    local item = self.rankItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnLinkClickBtn, item))
        self.rankItems[obj:GetInstanceIDE()] = item
    end

    local rank = index + 1
    local data = self.rankDatas and self.rankDatas[rank] or nil
    self:ShowRankItem(item, rank, data)
end
---设置排行榜节点数据
---@param item RecordRankListTopView._obj_rankItem_GoTable
---@param rank number
---@param data RecordRankData
function RecordRankListTopView:ShowRankItem(item, rank, data)
    if rank > 5 or rank < 1 then
        return
    end
    item.rank = rank
    item.data = data

    --排名
    if rank > 3 then
        item.aortext_rankNum.text = rank
        item.aorimage_Bg.SpriteName = "TY_img_kuang"
        item.aorimage_Bg:SetRectTransformSize(588, 116)
    elseif rank >= 1 then
        item.aorimage_rank.SpriteName = RANK_ICON_IMAGES[rank]
        item.aorimage_Bg:SetRectTransformSize(596, 124)
        item.aorimage_Bg.SpriteName = "ui_diban" .. rank
    end
    item.aorimage_rank:SetActiveE(rank >= 1 and rank <= 3 and 1 or 0)
    for i = 1, 3 do
        item["aortext_rankNum" .. i]:SetActiveE(i == rank and 1 or 0)
    end
    --人物数据
    if data then
        item.obj_noBody:SetActiveE(0)
        item.obj_content:SetActiveE(1)
        local time = _G.TimeUtil.GetDateTime(data.time)
        item.aortext_desc.text = string.format("%s-%02d-%02d-%02d:%02d:%02d", time.year, time.month, time.day, time.hour, time.minute, time.second)
        item.aortext_name.text = data.name or "???"
        local uid = data.role_uid
        if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            _G.UIUtils.SetPlayerHeadItemNew(
                    item.obj_head,
                    _G.PlayerModel:GetInstance():GetIRroleTable(),
                    1,
                    true,
                    true,
                    true
            )
        else
            _G.UIUtils.SetPlayerHeadItemNew(item.obj_head, data, 1, true, true, true)
        end
    else
        item.obj_noBody:SetActiveE(1)
        item.obj_content:SetActiveE(0)
    end
    item.obj_content:SetActiveE(data and 1 or 0)
    if item.obj_noBody then
        item.obj_noBody:SetActiveE(data and 0 or 1)
    end

    --红点
    if item.obj_redpoint then
        local hasLinkAward = data and self.model:CanLink(self.rankId, data.role_info.uid) and self.model:HasLinkAward()
        item.obj_redpoint:SetActiveE(hasLinkAward and 1 or 0)
    end
end
--endregion

--region 奖励视图

function RecordRankListTopView:InitAward()
    for _, d in ipairs(self.data.reward) do
        local sid, num = table.unpack(d)

        local item = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_awardParent))
        item.gameObject:SetActiveE(1)
        self:ShowAwardItem(item, {sid = sid, num = num}, true)
    end
    for _, d in ipairs(self.data.reward1) do
        local sid, num = table.unpack(d)

        local item = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_awardParent))
        item.gameObject:SetActiveE(1)
        self:ShowAwardItem(item, {sid = sid, num = num}, false)
    end
end

function RecordRankListTopView:ShowAwardItem(item, data, isFirst)
    item.data = data

    item.aortext_tag.text = isFirst and _G.GetLangPackValue(90025300019) or _G.GetLangPackValue(90025300025)
    ---@type itemViewNewWithCount
    local awardItem = item["awardItem"]
    if not awardItem then
        awardItem = require("itemViewNewWithCount").New(item.gameObject:GetChildE(0))
        item["awardItem"] = awardItem
    end
    awardItem:Show(data.sid, nil, data.num)

    local itemData = _G.StorageManager:GetInstance():GetStorageItemData(data.sid)
    local isShowEffect =
    itemData and itemData.Cfg and (itemData.Cfg.ef_item == 1 or itemData.Cfg.ef_item == "1") and true or false
    awardItem:ShowFrameEffect(data.sid, isShowEffect)
end

--endregion

---处理按钮事件
function RecordRankListTopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Close then
        self:Close()
    end
end


