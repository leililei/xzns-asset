---@class RecordRankTipView : UIBaseView	灵域薄达成视图
---@field go_table RecordRankTipView_GoTable
---@field model RecordRankModel
---@field data rank_achievement
---@field callback fun():void
---@field titleCfg player_title_effect_cfg                                  @称号配置数据
local RecordRankTipView = _G.BaseClass("RecordRankTipView", _G.UIBaseView)

function RecordRankTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
---@param data rank_achievement
---@param callback fun():void
function RecordRankTipView:OnCreate(data, callback)
    self.model = require("RecordRankModel"):GetInstance()
    self.data = data
    self.callback = callback
    self.titleCfg = nil
    --获取称号配置
    for _, d in pairs(data.reward) do
        local cfg = _G.ConfigManager.item_cfg[d[1]]
        if cfg and cfg.UseType == _G.ItemUseType.GetTitle then
            local titleId = tonumber(cfg.UseParameter[1][1])
            self.titleCfg = _G.ConfigManager.player_title_effect_cfg[titleId]
            break
        end
    end

    self:Init()
    self:ShowInfos()
    self:ShowTitleInfo()
    self:ShowUserInfo()
    self:InitAward()
end

---初始化视图状态
---@return void
function RecordRankTipView:Init()
    self.go_table.obj_awardItem:SetActiveE(0)
end
---更新基础信息
---@return void
function RecordRankTipView:ShowInfos()
    local titleName = _G.GetLangPackValue(self.titleCfg and self.titleCfg.name or 0)
    local target = self.model:GetBookTargetDescription(self.data.type, self.data.condition)
    self.go_table.aortext_desc.text =
        _G.GetLangPackValue(self.data.desc,target) .. _G.GetLangPackValue(90025300021, titleName)
end
---更新称号信息
---@return void
function RecordRankTipView:ShowTitleInfo()
    local item = self.go_table
    local cfg = self.titleCfg
    if not cfg then
        return
    end
    --加载称号
    item.aorrawimage_title:SetActiveE(cfg.type_title == 1 and 1 or 0)
    if cfg.type_title == 1 then
        item.aorrawimage_title:LoadImage(cfg.title)
        item.aorrawimage_title:SetLocalScaleXYZ(0.29)
        item.obj_titleEffect:RemoveAllChildren()
        item.title = nil
    elseif cfg.type_title == 2 then
        if item.title ~= cfg.title then
            item.obj_titleEffect:RemoveAllChildren()
            item.title = cfg.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                item.obj_titleEffect,
                function(trans)
                    if item.title ~= cfg.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(1)
                end
            )
        end
    end
end
---更新首通玩家信息
---@return void
function RecordRankTipView:ShowUserInfo()
    local record = self.model:GetBookRecord(self.data.id)
    if not record then
        return
    end
    --名字和头像
    self.go_table.aortext_name.text = record.role_info.name
    _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_head, record.role_info, 1, true, true, true)
end

--region 奖励视图

---初始化奖励数据
function RecordRankTipView:InitAward()
    self.go_table.obj_awardParent:RemoveAllChildren()

    for _, d in ipairs(self.data.reward1) do
        local sid, num = table.unpack(d)

        local item = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_awardParent))
        item.gameObject:SetActiveE(1)
        self:ShowAwardItem(item, {sid = sid, num = num})
    end
end
---设置排行榜节点数据
---@param item RecordRankTipView._obj_awardItem_GoTable
---@param data {id:number, num:number}
function RecordRankTipView:ShowAwardItem(item, data)
    item.data = data

    ---@type itemViewNewWithCount
    local awardItem = item["awardItem"]
    if not awardItem then
        awardItem = require("itemViewNewWithCount").New(item.gameObject:GetChildE(0))
        item["awardItem"] = awardItem
    end
    awardItem:Show(data.sid, nil, data.num)

    local itemData = _G.StorageManager:GetInstance():GetStorageItemData(data.sid)
    local isShowEffect =
        itemData and itemData.Cfg and (itemData.Cfg.ef_item == 1 or itemData.Cfg.ef_item == "1") and true or false
    awardItem:ShowFrameEffect(data.sid, isShowEffect)
end
--endregion

---处理按钮事件
function RecordRankTipView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_Back then
        self:Close()

        if self.callback then
            self.callback()
        end
    end
end

return RecordRankTipView
