---@class RecordRankBookDetailsView : UIBaseView	灵域薄首通详情视图
---@field go_table RecordRankBookDetailsView_GoTable
local RecordRankBookDetailsView = _G.BaseClass("RecordRankBookDetailsView", _G.UIBaseView)

function RecordRankBookDetailsView:__init()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end
function RecordRankBookDetailsView:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnTopViewClosed, self)
end

function RecordRankBookDetailsView:OnCreate(...)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankBookDetailsTopView.Name, ...)
end

function RecordRankBookDetailsView:OnTopViewClosed(name)
    if name == _G.ConfigManager.ui_cfg.RecordRankBookDetailsTopView.Name then
        self:Close()
    end
end

return RecordRankBookDetailsView
