local utils = {
    ---强制更新一次Canvas, 然后重新计算ScrollView的大小
    ---@param view ScrollLoopVertical
    forceUpdateScrollRectHeight = function(view)
        _G.CS.UnityEngine.Canvas.ForceUpdateCanvases()
        local _, height = view.transform:GetRectTransformSize()
        view:UpdateScrollRectHeight(height)
    end
}

---@class RecordAwardListView : UIBaseView    灵域薄排行视图
---@field go_table RecordAwardListView_GoTable
---@field model RecordRankModel
---@field awardItems table<any,RecordAwardListView._obj_awardItem_GoTable>           @奖励列表节点
---@field awardDatas rank_cfg[]                                                     @奖励列表数据
---@field view "rank"|"award"                                                       @当前视图模式
local RecordAwardListView = _G.BaseClass("RecordAwardListView", _G.UIBaseView)

function RecordAwardListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function RecordAwardListView:OnCreate(rankId)
    self.rankId = rankId
    self.model = require("RecordRankModel"):GetInstance()
    self.awardDatas = self.model:GetAwardCfg(self.rankId) or {}
    self:Init()
    self:InitAward()
end

function RecordAwardListView:Init()
    self.go_table.obj_awardItem:SetActiveE(0)
    self.go_table.scrollloopvectical_awardList:InitItemData(0, _G.handler(self, self.RefreshAwardItem))
end

--region 奖励视图

---初始化奖励数据
function RecordAwardListView:InitAward()
    --重新拉取奖励节点信息
    if not self.reInitAaward then
        self.reInitAaward = true
        self.model:GetAwardInfo(self.rankId, _G.handler(self, self.InitAward))
    end

    ---对数据进行排序
    _G.SortList(
            self.awardDatas,
            function(cfg)
                local completed = self.model:GetAwardRecord(self.rankId, cfg.id)
                local canGetAward = completed and self.model:CanGetAward(self.rankId, cfg.id)
                return canGetAward and 1 or 0, not completed and 1 or 0, -cfg.list
            end
    )

    self.go_table.scrollloopvectical_awardList:UpdateCount(#self.awardDatas)
end

---刷新奖励节点
---@param index number 数据序号(C#从0开始)
---@param obj UnityEngine.GameObject
function RecordAwardListView:RefreshAwardItem(index, obj)
    if not self.awardItems then
        self.awardItems = {}
    end

    local item = self.awardItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnAwardClickBtn, item))
        self.awardItems[obj:GetInstanceIDE()] = item
    end

    local data = self.awardDatas and self.awardDatas[index + 1] or nil
    self:ShowAwardItem(item, data)
end

---设置奖励节点
---@param item RecordAwardListView._obj_awardItem_GoTable
---@param data rank_cfg
function RecordAwardListView:ShowAwardItem(item, data)
    item.data = data

    local record = self.model:GetAwardRecord(self.rankId, data.id)
    --头像
    item.obj_headParent:SetActiveE(record and 1 or 0)
    item.obj_headEmpty:SetActiveE(record and 0 or 1)
    if record then
        _G.UIUtils.SetPlayerHeadItemNew(item.obj_head, record.role_info, 1, true, true, true)
    end
    --名称
    item.aortext_name.text = record and record.role_info.name or ""

    --奖励
    item.obj_awardNode:SetActiveE(#data.rewards > 0 and 1 or 0)
    if #data.rewards > 0 then
        local canGetAward = self.model:CanGetAward(self.rankId, data.id)

        local sid, num = table.unpack(data.rewards[1])
        ---@type itemViewNewWithCount
        local awardItem = item["awardItem"]
        if not awardItem then
            awardItem = require("itemViewNewWithCount").New(item.obj_awardNode:GetChildE(0))
            item["awardItem"] = awardItem
        end
        awardItem:Show(sid, _G.handlerbind(self, self.OnAwardClickBtn, item), num)
        --awardItem:ShowFrameEffect(sid, record and canGetAward or false)
        if awardItem.go_table.aorimage_Color:GetChildCountE() then
            awardItem.go_table.aorimage_Color:ClearChildren()
        end
        if record and canGetAward then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                awardItem.go_table.aorimage_Color,
                function(trans)
                    if _G.IsNil(awardItem.go_table.aorimage_Color) then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLocalScaleXYZ(1.2)
                end
            )
        end
        --是否已领取奖励
        local aleradyGet = item["aleradyGet"]
        if not aleradyGet then
            aleradyGet = item.obj_awardNode:GetChildE(1)
            item["aleradyGet"] = aleradyGet
        end
        aleradyGet:SetActiveE(record and not canGetAward and 1 or 0)
    end
    --基础信息
    item.obj_incomplete:SetActiveE(record and 0 or 1)
    local titleStr = self.model:GetTargetDescription(self.rankId, data.params)
    if not record then
        local color = "<color=#351b0a>"
        if _G.AppSetting.IsXzns then
            color = "<color=#343a48>"
        end
        titleStr = color .. titleStr .. "</color>"
    end
    item.aortext_title.text = titleStr
end

--endregion

---处理按钮事件
function RecordAwardListView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_anyClose then
        self:Close()
    end
end

---处理领奖事件
---@param item RecordAwardListView._obj_awardItem_GoTable|{data:rank_cfg}
function RecordAwardListView:OnAwardClickBtn(item)
    if not item.data then
        return
    end
    local cfgId = item.data.id
    --检查领取条件(已达成且未领取)
    if not self.model:GetAwardRecord(self.rankId, cfgId) or not self.model:CanGetAward(self.rankId, cfgId) then
        local sid = item.data.rewards[1][1]
        require("CommonTipManager"):GetInstance():OpenPropTip(item["awardItem"].gameObject or self.gameObject, sid)
        return
    end
    local idList = self:GetIdList() or {}
    --领取奖励
    if #idList > 0 then 
        self.model:GetAward(
            idList,
            function(msg)
                --刷新节点状态
                --self:ShowAwardItem(item, item.data)
                self:InitAward()
                --如果有奖励信息
                if msg and msg.award then
                    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                       _G.ConfigManager.redpoint_cfg.RecordRankAward.id
                    )
                    if AppSetting.IsXzns then
                        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
                        )
                        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
                        )
                    end
                    _G.UIUtils.ShowCommonAward(msg)
                end
            end
        )
    end
end
--获取可领取奖励的id
function RecordAwardListView:GetIdList()
    local idList = {}
    for k, v in ipairs(self.awardDatas) do 
        local completed = self.model:GetAwardRecord(self.rankId, v.id)
        local canGetAward = completed and self.model:CanGetAward(self.rankId, v.id)
        if canGetAward then 
            table.insert(idList, v.id)
        end
    end
    return idList
end

