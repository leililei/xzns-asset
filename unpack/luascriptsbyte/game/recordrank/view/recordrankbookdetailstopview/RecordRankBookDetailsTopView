---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}

---@class RecordRankBookDetailsTopView : UIBaseView	灵域薄首通详情视图
---@field go_table RecordRankBookDetailsTopView_GoTable
---@field model RecordRankModel
---@field data rank_achievement
---@field masterPlayerData any                                                      @首位达成玩家数据
---@field scale number                                                              @模型缩放倍率
---@field titleScale number                                                         @称号缩放倍率
---@field titleCfg player_title_effect_cfg                                          @称号配置数据
---@field rankItems table<any,RecordRankBookDetailsTopView._obj_rankItem_GoTable>   @排行榜列表节点
---@field rankDatas record_rank.i_node[]                                            @排行榜列表数据
local RecordRankBookDetailsTopView = _G.BaseClass("RecordRankBookDetailsTopView", _G.UIBaseView)

function RecordRankBookDetailsTopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    ---计算基准缩放倍率
    self.scale = 0.8
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        self.scale = self.scale * _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end

    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
end

function RecordRankBookDetailsTopView:OnDisable()
    if self.sceneTrans then
        self.sceneTrans:SetActiveE(0)
    end
end

function RecordRankBookDetailsTopView:OnEnable()
    if self.sceneTrans then
        self.sceneTrans:SetActiveE(1)
    end
end

function RecordRankBookDetailsTopView:OnDestroy()
end

---@param data rank_achievement
---@param callback function 在领取奖励后的回调
function RecordRankBookDetailsTopView:OnCreate(data, callback)
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.RecordRankBookDetailsTopView, self.go_table)
    self.model = require("RecordRankModel"):GetInstance()
    self.data = data
    self.titleCfg = nil
    self.callback = callback
    --获取称号配置
    for _, d in pairs(data.reward) do
        local cfg = _G.ConfigManager.item_cfg[d[1]]
        if cfg and cfg.UseType == _G.ItemUseType.GetTitle then
            local titleId = tonumber(cfg.UseParameter[1][1])
            self.titleCfg = _G.ConfigManager.player_title_effect_cfg[titleId]
            break
        end
    end


    self:Init()

    self:ShowInfos()
    self:ShowTitleInfo()
    self:ShowFirstPlayerInfo()

    --获取首通玩家角色信息
    self:SetFirstPlayerData(self.model:GetBookRecord(data.id))

    --加载场景信息
    self:UpdateFirstPlayerModel()
end

---初始化视图状态
---@return void
function RecordRankBookDetailsTopView:Init()
    self.go_table.aorbtn_awardRoot:SetActiveE(0)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ShowAwardVBGLight, self.go_table.obj_EffNode)
end

---更新基础信息
---@return void
function RecordRankBookDetailsTopView:ShowInfos()
    local desc = _G.GetLangPackValue(self.data.desc)
    if string.contains(desc, "%s") then
        self.go_table.aortext_title.text = _G.GetLangPackValue(self.data.desc, self.data.condition)
    else
        self.go_table.aortext_title.text = desc
    end
    self.go_table.aortext_desc.text = _G.GetLangPackValue(self.data.explain)

    --奖励按钮状态
    local canGetAward = self.model:GetBookRecord(self.data.id) and self.model:CanGetBookAward(self.data.id)
    self.go_table.aorbtn_award:SetActiveE(canGetAward and 1 or 0)
    self.go_table.aorbtn_awardAlready:SetActiveE(0)
end

---更新称号信息
---@return void
function RecordRankBookDetailsTopView:ShowTitleInfo()
    local item = self.go_table
    local cfg = self.titleCfg
    if not cfg then
        return
    end
    --加载称号
    item.aorrawimage_title:SetActiveE(cfg.type_title == 1 and 1 or 0)
    if cfg.type_title == 1 then
        item.aorrawimage_title:LoadImage(cfg.title)
        item.aorrawimage_title:SetLocalScaleXYZ(0.29)
        item.obj_titleEffect:RemoveAllChildren()
        item.obj_titleEffect2:RemoveAllChildren()
        item.title = nil
    elseif cfg.type_title == 2 then
        if item.title ~= cfg.title then
            item.obj_titleEffect:RemoveAllChildren()
            item.obj_titleEffect2:RemoveAllChildren()
            item.title = cfg.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                item.obj_titleEffect,
                function(trans)
                    if item.title ~= cfg.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(1)
                end
            )
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                item.obj_titleEffect2,
                function(trans)
                    if item.title ~= cfg.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(1)
                end
            )
        end
    end
end

---更新首通玩家信息
---@return void
function RecordRankBookDetailsTopView:ShowFirstPlayerInfo()
    local record = self.model:GetBookRecord(self.data.id)

    --名字
    self.go_table.aortext_name.text = record and record.role_info.name or ""
end

---设置首通玩家角色状态
---@return void
function RecordRankBookDetailsTopView:SetFirstPlayerData(data)
    self.firstPlayerData = nil
    if not data then
        return
    end
    require("SystemSettingNet"):GetInstance():GetPlayerInfo(
        { uid = data.role_info.uid },
        function(msg)
            self.firstPlayerData = msg.info
            self:UpdateFirstPlayerModel()
        end
    )
end

--region 排行榜视图

---初始化排行榜数据
function RecordRankBookDetailsTopView:InitRank()
    local count = self.rankDatas and #self.rankDatas or 0
    if count < 5 then
        count = 5
    end
    if not self.initRank then
        self.initRank = true
        self.go_table.scrollloopvectical_rankList:InitItemData(count, _G.handler(self, self.RefreshRankItem))
    else
        self.go_table.scrollloopvectical_rankList:UpdateCount(count)
    end
end

---刷新排行榜节点
---@param index number      数据序号(C#从0开始)
---@param obj UnityEngine.GameObject
function RecordRankBookDetailsTopView:RefreshRankItem(index, obj)
    if not self.rankItems then
        self.rankItems = {}
    end

    local item = self.rankItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        self.rankItems[obj:GetInstanceIDE()] = item
    end

    local rank = index + 1
    local data = self.rankDatas and self.rankDatas[rank] or nil
    self:ShowRankItem(item, rank, data)
end

---设置排行榜节点数据
---@param item RecordRankBookDetailsTopView._obj_rankItem_GoTable
---@param rank number
---@param data record_rank.i_node
function RecordRankBookDetailsTopView:ShowRankItem(item, rank, data)
    item.rank = rank
    item.data = data

    --排名
    if rank > 3 then
        item.aortext_rank.text = tostring(rank)
    elseif rank >= 1 then
        item.aorimage_rank.SpriteName = RANK_ICON_IMAGES[rank]
    end
    item.aorimage_rank:SetActiveE(rank >= 1 and rank <= 3 and 1 or 0)
    item.obj_rankBg2:SetActiveE(rank <= 3 and 0 or 1)
    --人物数据
    if data then
        item.aortext_name.text = data.name or "???"
        item.aortext_time.text = _G.TimeUtil.date("%Y-%m-%d-%H:%M:%S", data.time)
        _G.UIUtils.SetPlayerHeadItemNew(
            item.obj_head,
            {
                uid = data.uid,
                name = data.name,
                style = data.portrait,
                frame = data.frame,
                level = data.lv,
                title = data.title
            },
            1,
            true,
            true,
            true
        )
    end
    item.obj_content:SetActiveE(data and 1 or 0)
    if item.obj_noBody then
        item.obj_noBody:SetActiveE(data and 0 or 1)
    end
end

