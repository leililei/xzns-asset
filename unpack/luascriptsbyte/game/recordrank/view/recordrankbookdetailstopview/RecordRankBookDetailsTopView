---清除场景中的角色模型
function RecordRankBookDetailsTopView:ClearRoleModel()
    if not self.rankTrans then
        return
    end
    if self.halo then
        _G.PoolsManager:GetInstance():Despawn(self.halo, _G.ePoolType.Temporary)
        self.halo = nil
    end
    if self.title then
        _G.PoolsManager:GetInstance():Despawn(self.title.gameObject, _G.ePoolType.Temporary)
        self.title = nil
    end

    local roleCount = self.rankTrans:GetChildCountE()
    for i = 1, roleCount do
        local temp = self.rankTrans:GetChildE(i - 1)
        local tempCount = temp:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp:GetChildE(0), _G.ePoolType.Temporary)
        end
    end
end

