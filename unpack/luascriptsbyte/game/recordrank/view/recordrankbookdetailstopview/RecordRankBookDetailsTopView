---刷新首通玩家角色模型
---@return void
function RecordRankBookDetailsTopView:UpdateFirstPlayerModel()
    if self.firstPlayerData then
        ---@type card_cfg
        local cfg = require "CardCommentManager":GetInstance():CardData(self.firstPlayerData.city_style_id, false)
        if AppSetting.IsXzns then
            --local scale = cfg.size2 --XZNS-2164
            --local pos = cfg.pos_portrait
            local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RecordRankBookDetailsTopView)
            _G.PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Temporary,
                self.go_table.obj_cardSpine,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                    --trans:SetLocalScaleXYZ(scale)
                    --trans:SetLocalPosition(_G.table.unpack(pos))
                    --- 只有星座女神有神环
                    if _G.AppSetting.IsXzns then
                        local godHaloID = self.firstPlayerData.god_halo
                        if godHaloID ~= 0 then
                            local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                            --- 神环路径，父级路径(加载角色的下面)
                            _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                        end
                        if not table.isEmptyOrNil(self.firstPlayerData.artifact_skin) then
                            _G.UIUtils.LoadArtifacteffect(trans,nil,self.firstPlayerData.artifact_skin[1],self.firstPlayerData.artifact_skin[2])
                        end
                    end
                end
            )
            self:UpdateFirstPlayerTitle()
        else
            self:LoadRoleModel(cfg.ModelPathHi)
        end
    end
end

---刷新首通玩家光环
---@return void
function RecordRankBookDetailsTopView:UpdateFirstPlayerHalo(rolePoint)
    if self.halo then
        _G.PoolsManager:GetInstance():Despawn(self.halo, _G.ePoolType.Temporary)
        self.halo = nil
    end
    local haloId = self.firstPlayerData and self.firstPlayerData.halo and self.firstPlayerData.halo.sid
    if not haloId or haloId <= 0 then
        return
    end

    local parent = self.roleTrans
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[haloId]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo = trans
            if cfg.type_halo == 2 then
                self.halo:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo:GetParent():GetLocalScale()
                local rate = self.scale
                self.halo:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo:GetChildE(0):SetActiveE(1)
            self.halo:SetEulerAngles(0, 0, 0)
            self.halo:SetLocalPositionToZero()
        end
    )
end

---刷新首通玩家称号
---@return void
function RecordRankBookDetailsTopView:UpdateFirstPlayerTitle()
    -- local titleId = self.firstPlayerData.title.sid
    -- if not titleId or titleId == 0 then
    --     self.go_table.aorrawimage_playerTitle:SetActiveE(0)
    --     return
    -- end
    local cfg = self.titleCfg
    if not cfg then
        return
    end
    --加载称号
    self.go_table.aorrawimage_playerTitle:SetActiveE(cfg.type_title == 1 and 1 or 0)
    if cfg.type_title == 1 then
        -- 没有特效
        self.go_table.aorrawimage_playerTitle:LoadImage(cfg.title)
        self.go_table.aorrawimage_playerTitle:SetLocalScaleXYZ(0.29)
        self.go_table.obj_titleEffect:RemoveAllChildren()
        self.go_table.title = nil
    elseif cfg.type_title == 2 then
        -- 有特效
        if self.title ~= cfg.title then
            self.go_table.obj_titleEffect:RemoveAllChildren()
            self.title = cfg.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.go_table.obj_titleEffect,
                function(trans)
                    if self.title ~= cfg.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(1)
                end
            )
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function RecordRankBookDetailsTopView:SetTitlePos(title, rolePoint)
    _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if title and not _G.IsNil(title.gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans
                    if parent == nil then ---快速切换角色时gameObj可能被置位nil
                        return
                    end
                    local position = {}
                    position.x = x
                    position.z = z
                    position.y = y - 0.19
                    local scale = parent:GetLocalScale()
                    local rate = self.scale
                    title.gameObject:SetLocalScaleXYZ(rate * 0.8 / scale)
                    title.transform:SetLocalPositionToZero()
                    title.transform:SetPosition(position.x, position.y, position.z)
                    local lookAt = title.transform:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
                    if _G.IsNil(lookAt) then
                        lookAt = title.transform:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
                    end
                    lookAt:SetData(self.camera.transform, parent)
                end
            end
        end
    )
end

