---奖励领取回调
---@param msg public.s2c_common_ack
---@return void
function RecordRankBookDetailsTopView:OnAwardCallback(msg)
    self.callback()
    --刷新页面状态
    self:ShowInfos()

    --刷新父页面状态
    ---@type RecordRankBookView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RecordRankBookView.Name)
    if view then
        view:RefreshView(self.data)
    end

    --显示奖励信息
    _G.UIUtils.ShowCommonAward(msg)

    --刷新红点信息
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RecordRankBook.id)
    if AppSetting.IsXzns then
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
        )
    end
end

function RecordRankBookDetailsTopView:InitAward()
    if self.awardInit then
        return
    end
    self.awardInit = true
    self.go_table.obj_awardParent:RemoveAllChildren()

    for _, d in ipairs(self.data.reward) do
        local sid, num = table.unpack(d)

        local item = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_awardItem, self.go_table.obj_awardParent))
        item.gameObject:SetActiveE(1)
        self:ShowAwardItem(item, { sid = sid, num = num })
    end
end

---设置排行榜节点数据
---@param item RecordRankTipView._obj_awardItem_GoTable
---@param data {id:number, num:number}
function RecordRankBookDetailsTopView:ShowAwardItem(item, data)
    item.data = data

    ---@type itemViewNewWithCount
    local awardItem = item["awardItem"]
    if not awardItem then
        awardItem = require("itemViewNewWithCount").New(item.gameObject:GetChildE(0))
        item["awardItem"] = awardItem
    end
    awardItem:Show(data.sid, nil, data.num)

    local itemData = _G.StorageManager:GetInstance():GetStorageItemData(data.sid)
    local isShowEffect =
        itemData and itemData.Cfg and (itemData.Cfg.ef_item == 1 or itemData.Cfg.ef_item == "1") and true or false
    awardItem:ShowFrameEffect(data.sid, isShowEffect)
end

---处理按钮事件
function RecordRankBookDetailsTopView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_award or go == self.go_table.aorbtn_awardAlready then
        if self.model:GetBookRecord(self.data.id) and self.model:CanGetBookAward(self.data.id) then
            --检查是否可领取奖励
            self.model:GetBookAward(self.data.id, _G.handler(self, self.OnAwardCallback))
        else
            --切换奖励面板显示
            self:InitAward()
            self.go_table.aorbtn_awardRoot:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_detail then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankListTopView.Name, self.data)
    elseif go == self.go_table.aorbtn_awardRoot then
        self.go_table.aorbtn_awardRoot:SetActiveE(0)
    end
end

return RecordRankBookDetailsTopView
