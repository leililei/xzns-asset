---@alias RankItem RecordRankMainView._obj_afk_GoTable

---@class RecordRankMainView : UIBaseView	灵域薄主界面视图
---@field go_table RecordRankMainView_GoTable
---@field rankItems RankItem[]       功能节点信息
local RecordRankMainView = _G.BaseClass("RecordRankMainView", _G.UIBaseView)

---@class RecordRankMainView.TagType
RecordRankMainView.TagType = {
    Challenge = 1,
    Develop = 2,
}

function RecordRankMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self:InitItems()
    self.jumpFunc = {
        [1] = function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankBookView.Name)
        end,
        [2] = function()
            self:OnRankClickBtn(nil,nil,7)
        end,
        [3] = function()
            self:OnRankClickBtn(nil,nil,9)
        end,
        [10] = function()
            self:OnRankClickBtn(nil,nil,8)
        end,
        [11] = function()
            self:OnRankClickBtn(nil,nil,1)
        end,
        [12] = function()
            self:OnRankClickBtn(nil,nil,2)
        end,
        [13] = function()
            self:OnRankClickBtn(nil,nil,3)
        end,
        [14] = function()
            self:OnRankClickBtn(nil,nil,4)
        end
    }
    if _G.AppSetting.IsXzns then
        GameUtil.SetUiHeXieMask(self.go_table)
    end
end

---@field jumpType number 跳转类型(1:英雄榜、2：放置、10：主塔、11：人塔、12：兽塔、13：精灵塔、14：亡灵塔 )
function RecordRankMainView:OnCreate(jumpType)
    self:ShowBookTip()
    self:UpdateAllRank()

    local resources = _G.ConfigManager.ui_cfg.RecordRankMainView.resources
    self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
    )
    self.playerHead =
        self:AddComponent(
                self.go_table.trans_PlayerHead,
                require("PlayerComponent").New(self.go_table.trans_PlayerHead)
        )
    --拉取排行榜数据并刷新界面
    require("RecordRankModel"):GetInstance():GetMainInfo(_G.handler(self, self.UpdateAllRank))

    self.go_table.obj_god:SetActiveE(require("RecordRankModel"):GetInstance():CheckGodShow() and 1 or 0)
    if jumpType then
        self:JumpView(jumpType)
    end

    if AppSetting.IsXzns then
        self:InitUI()
        self:RefreshTag()
    end
end

function RecordRankMainView:InitUI()
    self.curSelectTag = RecordRankMainView.TagType.Challenge
    self.ChallengeItemList = {
        self.go_table.aorbtn_book,
        self.go_table.obj_afk,
        self.go_table.obj_power,
        self.go_table.obj_tower,
    }
    self.DevelopItemList = {
        self.go_table.obj_List1,
        self.go_table.obj_List2,
        self.go_table.obj_god
    }

    self.TagItem = {
        [RecordRankMainView.TagType.Challenge] = GetAutoGoTable(self.go_table.obj_ListItem1,handlerbind(self,self.SetTag,RecordRankMainView.TagType.Challenge)),
        [RecordRankMainView.TagType.Develop] = GetAutoGoTable(self.go_table.obj_ListItem2,handlerbind(self,self.SetTag,RecordRankMainView.TagType.Develop))
    }

    self:RefreRedPoint()
end

function RecordRankMainView:RefreshRed(id,Typelist)
    local count = #Typelist
    local RedPointManager = require("RedPointManager"):GetInstance()
    for i = 1, count do
        RedPointManager:RefreshNodeByAllParams(id,Typelist[i])
    end
end

---@param TagType RecordRankMainView.TagType
function RecordRankMainView:SetTag(go,ison,TagType)
    self.curSelectTag = TagType
    self:RefreshTag()
end

function RecordRankMainView:RefreshTag()
    local tagItem = self.TagItem[RecordRankMainView.TagType.Challenge]
    local tagItem2 = self.TagItem[RecordRankMainView.TagType.Develop]
    if self.curSelectTag == RecordRankMainView.TagType.Challenge then
        self:SetActives(self.ChallengeItemList,1)
        self:SetActives(self.DevelopItemList,0)
        tagItem.obj_Select:SetActiveE(1)
        tagItem2.obj_Select:SetActiveE(0)
        tagItem.aortext_Name.color = _G.ColorTools.FormatColorByString("50341e")
        tagItem2.aortext_Name.color = _G.ColorTools.FormatColorByString("e8e6df")
    else
        self:SetActives(self.ChallengeItemList,0)
        self:SetActives(self.DevelopItemList,1)
        tagItem.obj_Select:SetActiveE(0)
        tagItem2.obj_Select:SetActiveE(1)
        tagItem.aortext_Name.color = _G.ColorTools.FormatColorByString("e8e6df")
        tagItem2.aortext_Name.color = _G.ColorTools.FormatColorByString("50341e")
        self.go_table.obj_god:SetActiveE(require("RecordRankModel"):GetInstance():CheckGodShow() and 1 or 0)
    end
end

function RecordRankMainView:SetActives(objs,isShow)
    local count = #objs
    for i = 1, count do
        objs[i]:SetActiveE(isShow)
    end
end


function RecordRankMainView:InitItems()
    self.rankItems = {
        _G.GetAutoGoTable(self.go_table.obj_tower1),
        _G.GetAutoGoTable(self.go_table.obj_tower2),
        _G.GetAutoGoTable(self.go_table.obj_tower3),
        _G.GetAutoGoTable(self.go_table.obj_tower4),
        _G.GetAutoGoTable(self.go_table.obj_tower5),
        _G.GetAutoGoTable(self.go_table.obj_god),
        _G.GetAutoGoTable(self.go_table.obj_afk),
        _G.GetAutoGoTable(self.go_table.obj_tower),
        _G.GetAutoGoTable(self.go_table.obj_power)
    }
    for rankId, item in pairs(self.rankItems) do
        ---@param rankId RankUtils.RankType
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnRankClickBtn, rankId))
    end
end

---更新排行榜数据展示
---@return void
function RecordRankMainView:UpdateAllRank()
    local model = require("RecordRankModel"):GetInstance()
    for rankId, item in pairs(self.rankItems) do
        local d = model:GetMainData(rankId)
        self:UpdateRankData(item, d, d and model:GetProgressDescription(rankId, d.value) or "")
    end

    if AppSetting.IsXzns then
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
        )
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
        )
    end

    -- 更新红点状态
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RecordRankLink.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RecordRankMain.id)
end
---展示下一个灵域薄首通目标达成(本地缓存)
---@return void
function RecordRankMainView:ShowBookTip()
    if self:IsNil() then
        return
    end
    ---@type rank_achievement
    local cfg
    local model = require("RecordRankModel"):GetInstance()
    for type = 1, 3 do
        local lstCfg = model:GetBookCfg(type)
        if lstCfg then
            for _, _cfg in pairs(lstCfg) do
                --有可以领取的奖励, 且从未展示过(本地缓存)
                if
                    model:GetBookRecord(_cfg.id) and model:CanGetBookAward(_cfg.id) and
                        _G.PlayerPrefsManager.GetInt("RecordRankTip" .. _cfg.id, 0) ~= 1
                 then
                    cfg = _cfg
                    break
                end
            end
        end
        if cfg then
            break
        end
    end
    if not cfg then
        return
    end

    --展示目标节点
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.RecordRankTipView.Name,
        cfg,
        function()
            --存储阅读状态
            _G.PlayerPrefsManager.SetInt("RecordRankTip" .. cfg.id, 1)

            self:ShowBookTip()
        end
    )
end

---更新单个节点的数据
---@param item RankItem
---@param data record_rank.i_first
---@param desc string       进度描述信息
---@return void
function RecordRankMainView:UpdateRankData(item, data, desc)
    item.data = data
    item.obj_role:SetActiveE(data and 1 or 0)
    item.obj_nothing:SetActiveE(data and 0 or 1)
    if data then
        item.aortext_name.text = data.name
        item.aortext_content.text = desc
        _G.UIUtils.SetPlayerHeadItemNew(
            item.obj_head,
            {
                name = data.name,
                style = data.portrait,
                frame = data.frame,
                level = data.lv,
                title = data.title
            },
            1,
            true,
            true,
            true
        )
    end
end

function RecordRankMainView:JumpView(jumpType)
    self.jumpFunc[jumpType]()
end

---处理按钮事件
function RecordRankMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_book then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankBookView.Name)
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 90)
    end
end

function RecordRankMainView:RefreRedPoint()
    if AppSetting.IsXzns == false then
        return
    end
    local changTyep = {
        7,8,9
    }
    local developType = {
        1,2,3,4,6
    }
    self:RefreshRed(_G.ConfigManager.redpoint_cfg.RecordRankChallenge.id,changTyep)
    self:RefreshRed(_G.ConfigManager.redpoint_cfg.RecordRankDevelop.id,developType)
end

---@param rankId RankUtils.RankType 监听排行榜按钮事件
function RecordRankMainView:OnRankClickBtn(_, _, rankId)
    --先拉取排行榜数据, 然后再打开面板
    local model = require("RecordRankModel"):GetInstance()
    model:GetListInfo(
        rankId,
        function()
            model:ClearSelfData() --清除自己的缓存数据(之后从服务器重新拉取)
            ---@type RecordRankListView
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankListView.Name, rankId,nil,nil)
        end
    )
end

return RecordRankMainView
