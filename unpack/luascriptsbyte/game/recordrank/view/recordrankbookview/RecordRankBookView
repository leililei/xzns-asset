---@class RecordRankBookView : UIBaseView	灵域薄首通视图
---@field go_table RecordRankBookView_GoTable
---@field model RecordRankModel
---@field type number                                               当前选择类型
---@field listDatas rank_achievement[]                              视图列表数据
---@field listItems RecordRankBookView._obj_item_GoTable[]          视图列表节点
---@field GetAwardList table<number>                                当前类型中的可获取奖励
---@field GetAwardTypes table<type>                                 存在可获取奖励的类型页列表
local RecordRankBookView = _G.BaseClass("RecordRankBookView", _G.UIBaseView)

function RecordRankBookView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function RecordRankBookView:OnCreate()
    self.model = require("RecordRankModel"):GetInstance()
    self.type = 1
    self.GetAwardList = {}
    self.GetAwardTypes = {}
    self.toggerList = {}

    self.redPointItem =  require "RedPointManager":GetInstance():GetRedpointItem(_G.ConfigManager.redpoint_cfg.RecordRankBook.id)

    self:Init()
    self:UpdateView()

    self:UpdateGetAwardType()
    self:MoveToNextAward()
    --重新拉取首通状态
    self.model:GetAllBookInfo(
        function()
            self:RefreshView(nil)
        end
    )

     if not _G.IsNil(self.go_table.obj_GoldInfo) and self.go_table.obj_GoldInfo:GetctiveInHierarchy() == 1 then
         self.resource =
             self:AddComponent(
             self.go_table.obj_GoldInfo,
             require("ResourceCompont").New(self.go_table.obj_GoldInfo, _G.ConfigManager.ui_cfg.RecordRankBookView.resources)
         )
     end
     self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

---初始化视图状态
---@return void
function RecordRankBookView:Init()
    self.go_table.obj_item:SetActiveE(0)
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---移动到下一个可领取奖励的type和index
function RecordRankBookView:MoveToNextAward()
    -- 刷新view和可获取奖励列表
    self:RefreshView()
    if #self.GetAwardList ~= 0 then
        self:MoveToAwardIndex()
    else
        self:MoveToAwardType()
    end
end

--- 更新当前类型的可领取奖励列表
function RecordRankBookView:UpdateGetAwardType()
    self.GetAwardTypes = {}
    for i,v in ipairs(self.redPointItem:GetAllParams()) do
        if self.redPointItem:CheckParams(v) == 1 then
            _G.table.insert(self.GetAwardTypes,v)
        end
    end
end

--- 移动到当前type中的下一个待领取的奖励所在的index
function RecordRankBookView:MoveToAwardIndex()
    if #self.GetAwardList == 0 then
        return
    end
    _G.table.sort(self.GetAwardList, function(a, b)
        return a < b and true or false
    end)
    -- 获取从左到右，第一个奖励位置
    self:MoveToFirstAwardIndex()
end

---移动到下一个待领取的type
function RecordRankBookView:MoveToAwardType()
    if #self.GetAwardTypes == 0 then
        return
    end
    -- 如果当前type没有可领取的奖励，则将type移除
    if #self.GetAwardList == 0 then
        for i,v in ipairs(self.GetAwardTypes) do
            if v == self.type then
                _G.table.remove(self.GetAwardTypes,i)
                break
            end
        end
    end
    if #self.GetAwardTypes == 0 then
        return
    end
    self:MoveToCurrentType(self.GetAwardTypes[1])
    self:MoveToAwardIndex()
end

---移动到当前index
function RecordRankBookView:MoveToFirstAwardIndex()
    if #self.GetAwardList == 0 then
        return
    end
    local index = self.GetAwardList[1] - 1
    if index <= 0 then
        index = 0
    end
    self.go_table.scrollloopvectical_list:ScrollToIndex(index)
end

---移动到当前type
function RecordRankBookView:MoveToCurrentType(toType)
    local go = self.go_table["toggle_type" .. self.type]
    go.isOn = false

    self.type = toType
    go = self.go_table["toggle_type" .. self.type]
    go.isOn = true

    -- 重置当前页面待领取的奖励id
    self.GetAwardList = {}
    -- 更新view和可获取奖励列表
    self:UpdateView()
end

---刷新列表显示
---@param dara rank_achievement 目标data数据, 如为nil则刷新全部节点
---@retrun void
function RecordRankBookView:RefreshView(data)
    if not data then
        self.GetAwardList = {}
    end
    if data and self.listItems then
        for _, item in pairs(self.listItems) do
            if data == item.data then
                self:ShowItem(item, data)
                return
            end
        end
    end
    self.go_table.scrollloopvectical_list:UpdateAllItem()
end

---更新视图列表数据
---@return void
function RecordRankBookView:UpdateView()
    self.listDatas = self.model:GetBookCfg(self.type) or {}
    self.GetAwardList = {}
    for i, v in ipairs(self.listDatas) do
        if self.model:GetBookRecord(v.id) and self.model:CanGetBookAward(v.id) then
            _G.table.insert(
                self.GetAwardList, i
            )
        end
    end

    self.go_table.scrollloopvectical_list:UpdateCount(#self.listDatas)
end

---刷新列表节点
---@param index number      数据序号(C#从0开始)
---@param obj UnityEngine.GameObject
function RecordRankBookView:RefreshItem(index, obj)
    if not self.listItems then
        self.listItems = {}
    end

    local item = self.listItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnItemClickBtn, item))
        self.listItems[obj:GetInstanceIDE()] = item
    end
    self:ShowItem(item, self.listDatas[index + 1])
end

---刷新节点数据
---@param item RecordRankBookView._obj_item_GoTable
---@param data rank_achievement
function RecordRankBookView:ShowItem(item, data)
    item.data = data
    -- item.gameObject:SetLocalScaleXYZ(data and 1 or 0)
    if not data then
        _G.LogError("没有数据")
        return
    end

    local record = self.model:GetBookRecord(data.id)
    if record then
        item.aortext_name.text = record.role_info.name
        item.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(record.role_info.power, true)
        --local cfg = require "CardCommentManager":GetInstance():CardData(record.role_info.city_style_id, false)
        --item.aorrawimage_role:LoadImage(cfg.Photo)
         _G.UIUtils.SetPlayerHeadItemNew(item.obj_HeadItemBase, record.role_info, 0.8, true, true, true)
    end
    item.obj_power:SetActiveE(record and 1 or 0)
    item.aortext_name:SetActiveE(record and 1 or 0)
    item.obj_role:SetActiveE(record and 1 or 0)
    item.obj_headEmpty:SetActiveE(record and 0 or 1)
    item.obj_nothing:SetActiveE(record and 0 or 1)
    item.obj_HeadItemBase:SetActiveE(record and 1 or 0)

    --显示基础信息
    local target = self.model:GetBookTargetDescription(data.type, data.condition)
    local num = _G.GameUtil.GetStringCharNum(_G.ConfigManager.language_package_cfg[data.desc])
    if num > 0 then
        item.aortext_titleDesc.text = _G.GetLangPackValue(data.desc, target)
    else
        item.aortext_titleDesc.text = _G.GetLangPackValue(data.desc)
    end
    --领取状态
    local canGetAward = record and self.model:CanGetBookAward(data.id) or false
    local isSelf = record and record.role_info.uid == _G.PlayerModel:GetInstance():GetPlayerUid() or false
    -- 添加能够领取的奖励id
    local canGet = record and not isSelf and canGetAward
    if AppSetting.IsXzns then
        if record and canGetAward then
            canGet = true
        end
    end
    item.aorbtn_get:SetActiveE(canGet and 0 or 1)
    item.aorbtn_award:SetActiveE(canGet and 1 or 0)
    -- item.obj_claimed:SetActiveE(record and isSelf and not canGetAward and 1 or 0)
    --显示称号信息
    ---@type item_cfg
    local itemCfg
    for _, d in pairs(data.reward) do
        local _cfg = _G.ConfigManager.item_cfg[d[1]]
        if _cfg and _cfg.UseType == _G.ItemUseType.GetTitle then
            itemCfg = _cfg
            break
        end
    end
    if itemCfg then
        local titleId = tonumber(itemCfg.UseParameter[1][1])
        local cfg = _G.ConfigManager.player_title_effect_cfg[titleId]
        --加载称号
        item.aorrawimage_title:SetActiveE(cfg.type_title == 1 and 1 or 0)
        if cfg.type_title == 1 then
            item.aorrawimage_title:LoadImage(cfg.title)
            item.aorrawimage_title:SetLocalScaleXYZ(0.29)
            item.obj_titleEffect:RemoveAllChildren()
            item.title = nil
        elseif cfg.type_title == 2 then
            if item.title ~= cfg.title then
                item.obj_titleEffect:RemoveAllChildren()
                item.title = cfg.title
                _G.UIUtils.LoadEffectTitleOrFrame(
                    cfg.title,
                    item.obj_titleEffect,
                    function(trans)
                        if item.title ~= cfg.title then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                        trans:SetLocalScaleXYZ(1)
                    end
                )
            end
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("没有找到称号配置, rank_achievement.id= " .. data.id)
        end
    end
end

---处理按钮事件
function RecordRankBookView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_last then
        self:MoveToFirstAwardIndex()
    elseif go == self.go_table.aorbtn_next then
        self:MoveToFirstAwardIndex()
    else
        for i = 1, 3 do
            if go == self.go_table["toggle_type" .. i] then
                if not self.toggerList[i] then
                    self.toggerList[i] = _G.GetAutoGoTable(go)
                end
                local tb = self.toggerList[i]

                if isOn and i ~= self.type then
                    self.type = i

                    -- 重置当前页面待领取的奖励id
                    self.GetAwardList = {}
                    self:UpdateView()
                    self:MoveToAwardIndex()
                end
                return
            end
        end
    end
end

---处理列表事件
---@param item RecordRankBookView._obj_item_GoTable|{data:rank_achievement}
function RecordRankBookView:OnItemClickBtn(go, _, item)
    local data = item.data
    if not data then
        return
    end
    if go == item.aorbtn_get or go == item.aorbtn_award or go == item.aorbtn_details then
        if not self.model:GetBookRecord(data.id) then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankListTopView.Name, item.data)
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankBookDetailsView.Name, item.data,
            _G.handler(self, self.MoveToNextAward))
    end
end

return RecordRankBookView
