---获取当前关卡奖励
function AfkTaskModel:GetCurSetcionAward()
    if self.Data and self.Data.g_sids > 0 then
        for id, cfg in pairs(_G.pairsByKeys(_G.ConfigManager.afk_stage_cfg)) do
            if self.Data.g_sidsDic[id] then
                return cfg.reward
            end
        end
        return nil
    else
        return _G.ConfigManager.afk_stage_cfg[101001].reward
    end
end

function AfkTaskModel:GetNextGetAwardChapter()
    local cfgs = _G.ConfigManager.afk_stage_cfg
    local AfkModel = require "AfkModel":GetInstance()
    if AfkModel:GetFunctionOpen() == true then
        local afkCfg = _G.ConfigManager.afk_cfg[AfkModel:GetCurSection()]
        if afkCfg ~= nil then
            local count = #self.keys
            for i = 1, count do
                if cfgs[self.keys[i]].stage == 0 and cfgs[self.keys[i]].chapter >= afkCfg.chapter then
                    return cfgs[self.keys[i]]
                end
            end
            return cfgs[101000]
        end
    end
    return nil
end

---获取当前放置章节
function AfkTaskModel:GetCurChapter()
    local cfgs = _G.ConfigManager.afk_stage_cfg
    local chapterTb = {}
    for _, v in pairs(cfgs) do
        if not chapterTb[v.chapter] then
            chapterTb[v.chapter] = v.chapter
        end
    end
    for _, v in ipairs(chapterTb) do
        if not self:CheckChapterIsPass(v) then
            return v
        end
    end
    return chapterTb[#chapterTb]
end

---检测该章节是否领取所有的奖励
function AfkTaskModel:CheckChapterIsPass(chapter)
    local cfgs = _G.ConfigManager.afk_stage_cfg
    for _, v in pairs(cfgs) do
        if v.chapter == chapter and v.stage > 0 and not self:CheckIsGet(v.id) then
            return false
        end
    end
    return true
end

---销毁对象时,析构函数
