---获取单个奖励回调
function AfkTaskModel:ReceiveAwardCallback(msg, callback, sids, isStage2)
    if msg.ack ~= 1 then
        callback(msg)
        return
    end
    if isStage2 then
        self:UpdateGetSids2(sids)
    else
        self:UpdateGetSids(sids)
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    callback(msg)
end

---更新获取奖励列表
---@param sids number[]
function AfkTaskModel:UpdateGetSids(sids)
    for _, v in pairs(sids) do
        self.canTakeList[v].CanTake = false
        self.canTakeList[v].isGet = true
        if self.cfg[v].stage == 0 then
            --self.Data.c_sid = sid
        else
            self.Data.g_sidsDic[v] = true
        end
        self.canTakeList[v] = nil
    end
end

---更新获取奖励列表(关卡豪礼)
---@param sids number[]
function AfkTaskModel:UpdateGetSids2(sids)
    if not self.canTakeList2 then
        return
    end
    for _, sid in pairs(sids) do
        local v = self.canTakeList2[sid]
        if v then
            v.CanTake = false
            v.isGet = true
            self.Data.g_sidsDic2[v] = true
            self.canTakeList2[sid] = nil
        end
    end
end

