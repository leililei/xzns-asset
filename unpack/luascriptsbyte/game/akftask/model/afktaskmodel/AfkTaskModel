end

---检测奖励是否领取
function AfkTaskModel:CheckIsGet(id)
    if not self.Data.g_sidsDic then
        return false
    end
    return self.Data.g_sidsDic[id]
end

---检测奖励是否领取(冒险通关豪礼)
---@return boolean
function AfkTaskModel:CheckIsGet2(id)
    if not self.Data or not self.Data.g_sidsDic2 then
        return false
    end
    return self.Data.g_sidsDic2[id]
end

---获取当前可以领取奖励的id
function AfkTaskModel:GetCurSection()
    local cfgs = _G.ConfigManager.afk_stage_cfg
    if not self.Data then
        return 0
    end

    local count = #self.keys
    for i = 1, count do
        local canTake = require "AfkModel":GetInstance():CheckSectionIsPass(cfgs[self.keys[i]].afk)
        if canTake and not self:CheckIsGet(self.keys[i]) and cfgs[self.keys[i]].stage > 0 then
            return cfgs[self.keys[i]].id
        end
    end
    return 0
end

