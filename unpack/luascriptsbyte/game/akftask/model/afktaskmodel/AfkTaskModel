end

function AfkTaskModel:InitKeys()
    local cfgs = _G.ConfigManager.afk_stage_cfg
    self.keys = _G.table.keys(cfgs)
    _G.table.sort(
        self.keys,
        function(a, b)
            return a < b
        end
    )
end

---获取放置任务奖励回调
---@param msg afk.s2c_afk_info
function AfkTaskModel:GetAfkDataCallback(msg, callback)
    ---领取了奖励的奖励id afk_stage_cfg.id
    msg.g_sidsDic = {}
    local getId = msg.g_sids or 0
    if getId > 0 then
        for sid, v in pairs(_G.ConfigManager.afk_stage_cfg) do
            if sid <= getId then
                msg.g_sidsDic[sid] = true
            end
        end
    end

    --已领取的奖励id(关卡豪礼)
    msg.g_sidsDic2 = {}
    local getId = msg.g_sids2 or 0
    if getId > 0 then
        for sid, v in pairs(_G.ConfigManager.afk_stage2_cfg) do
            if sid <= getId then
                msg.g_sidsDic2[sid] = true
            end
        end
    end

    self.Data = msg
    if self.maxChapter == nil then
        local count = #self.keys
        for i = count, 1, -1 do
            local data = self.cfg[self.keys[i]]
            if data.stage > 0 then
                self.maxChapter = data.chapter
                break
            end
        end
    end
    self:InitCardShow()
    self:ParseData(msg)
    if callback then
        callback(self.afkDatas)
    end
end

function AfkTaskModel:InitCardShow()
    self.cardShow = {}
    for _, v in pairs(_G.ConfigManager.discrete_cfg[100107]) do
        self.cardShow[v[1]] = v[2]
    end
end

