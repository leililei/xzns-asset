---获取下次领奖的关卡
function AfkTaskModel:GetNextAwardSection()
    local curAfk = require "AfkModel":GetInstance():GetCurSection()
    local cfgs = _G.ConfigManager.afk_stage_cfg
    local count = #self.keys
    for i = 1, count do
        if cfgs[self.keys[i]].afk >= curAfk and cfgs[self.keys[i]].stage > 0 then
            return self.keys[i]
        end
    end
    return nil
end

---获取距离下次领奖的关卡数
function AfkTaskModel:GetNextAwardSectionNum()
    local sid = self:GetNextAwardSection()
    if not sid then
        return 0
    end
    local cfg = _G.ConfigManager.afk_stage_cfg[sid]
    local curAfk = require "AfkModel":GetInstance():GetCurSection()
    if not _G.ConfigManager.afk_cfg[curAfk + 1] then
        if curAfk == cfg.afk then
            return 1
        else
            return cfg.afk % 1000 + 1
        end
    else
        local chapter = _G.ConfigManager.afk_cfg[cfg.afk].chapter
        if chapter == _G.ConfigManager.afk_cfg[curAfk].chapter then
            return cfg.afk - curAfk + 1
        else
            local afk = 0
            for _, v in pairs(_G.ConfigManager.afk_cfg) do
                if v.chapter == chapter and v.id > afk then
                    afk = v.id
                end
            end
            return afk - curAfk + cfg.afk % 1000 + 1
        end
    end
end

function AfkTaskModel:InitFunction()
    if not self.AwardDatas then
        self:InitAwardDatas()
    end
end

--初始化奖励数据
function AfkTaskModel:InitAwardDatas()
    --初始化关卡奖励
    self.AwardDatas = {}
    self.canTakeList = {}
    local tb = _G.table.chooseToArray(_G.ConfigManager.afk_stage_cfg, function(_, v)
        return v.stage > 0
    end)
    _G.table.sort(tb, function(a, b)
        return a.id < b.id
    end)
    local ChapterRewardData = require "ChapterRewardData"
    for i = 1, #tb do
        self.AwardDatas[i] = ChapterRewardData.New()
        self.AwardDatas[i]:Parse(tb[i], false)
        if self.AwardDatas[i].CanTake then
            self.canTakeList[self.AwardDatas[i].sid] = self.AwardDatas[i]
        end
    end

    --初始化通关豪礼
    self.AwardDatas2 = {}
    self.canTakeList2 = {}
    for _, cfg in pairs(_G.ConfigManager.afk_stage2_cfg) do
        ---@type ChapterRewardData
        local v = ChapterRewardData.New()
        v:Parse(cfg, true)
        if v.CanTake then
            self.canTakeList2[v.sid] = v
        end
        table.insert(self.AwardDatas2, v)
    end
    _G.table.sort(self.AwardDatas2, function(a, b)
        return a.sid < b.sid
    end)
end

function AfkTaskModel:UpdateAfkData()
    for i, v in ipairs(self.AwardDatas) do
        if not v.CanTake and not v.isGet then
            v:UpdateCanTake()
            if v.CanTake then
                self.canTakeList[v.sid] = v
            end
            break
        end
    end
    for i, v in ipairs(self.AwardDatas2) do
        if not v.CanTake and not v.isGet then
            v:UpdateCanTake()
            if v.CanTake then
                self.canTakeList2[v.sid] = v
            end
            break
        end
    end
end

----一键领取
function AfkTaskModel:GetAllAward(callback)
    if _G.table.isEmptyOrNil(self.canTakeList) then
        if callback then
            callback()
        end
        return
    end
    local sids, maxSid = {}, 0
    for _, v in pairs(self.canTakeList) do
        _G.table.insert(sids, v.sid)
        if maxSid < v.sid then
            maxSid = v.sid
        end
    end
    AfkTaskNet:GetInstance():ReceiveAward({ sid = maxSid, type = 1 },
        _G.handlerbind(self, self.ReceiveAllAwardCall, callback, sids, false))
end

----一键领取(关卡豪礼)
function AfkTaskModel:GetAllAward2(callback)
    if _G.table.isEmptyOrNil(self.canTakeList2) then
        if callback then
            callback()
        end
        return
    end
    local sids, maxSid = {}, 0
    for _, v in pairs(self.canTakeList2) do
        _G.table.insert(sids, v.sid)
        if maxSid < v.sid then
            maxSid = v.sid
        end
    end
    AfkTaskNet:GetInstance():ReceiveAward({ sid = maxSid, type = 2 },
        _G.handlerbind(self, self.ReceiveAllAwardCall, callback, sids, true))
end

---一键领取回调
---@param data ChapterRewardData
function AfkTaskModel:ReceiveAllAwardCall(msg, callback, sidS, isStage2)
    if msg.ack ~= 1 then
        return
    end
    if isStage2 then
        for _, v in pairs(sidS) do
            self.canTakeList2[v].CanTake = false
            self.canTakeList2[v].isGet = true
        end
        self:UpdateGetSids2(sidS)
    else
        for _, v in pairs(sidS) do
            self.canTakeList[v].CanTake = false
            self.canTakeList[v].isGet = true
        end
        self:UpdateGetSids(sidS)
        _G.TaskModule:GetInstance():FinishAFkChapterTask(sidS)
    end

    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.Events:GetInstance():Broadcast(_G.eAfkEvents.Pass)
    if callback then
        callback(msg, sidS)
    end
end

