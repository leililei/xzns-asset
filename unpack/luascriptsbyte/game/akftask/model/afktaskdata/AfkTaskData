---@class AfkTaskData	中文描述
---@field id number 任务id
---@field taskState TaskState  任务状态
---@field progress number 任务进度（当任务处于进行中出现）
local AfkTaskData = _G.BaseClass("AfkTaskData")
local AfkTaskModel = require "AfkTaskModel"

local AfkCfg = _G.ConfigManager.afk_cfg
---类的构造函数
function AfkTaskData:__init()
end

---类的析构函数
function AfkTaskData:Dispose()
end

---解析数据
---@param cfg afk_stage_cfg
---@param data afk.s2c_afk_info
---@param aheadData AfkTaskData
function AfkTaskData:PaseData(cfg, data, aheadData)
    self.id = cfg.id
    self.cfg = cfg

    local TaskState = AfkTaskModel.TaskState
    if AfkCfg[self.cfg.afk] then
        self.level = AfkCfg[self.cfg.afk].chapter .. "-" .. AfkCfg[self.cfg.afk].section
    else
        self.level = 1
    end
    if self.cfg.stage > 0 and data.g_sidsDic[self.id] then
        self.taskState = TaskState.Completed
    elseif aheadData and aheadData.cfg.stage > 0 then
        if aheadData.taskState == TaskState.DNS or aheadData.taskState == TaskState.Running then
            self.taskState = TaskState.DNS
        else
            if self.cfg.afk <= data.sid then
                self.taskState = TaskState.Award
            else
                self.taskState = TaskState.Running
                self.progress = math.min((data.sid - aheadData.cfg.afk) / (self.cfg.afk - aheadData.cfg.afk), 1)
            end
        end
    elseif self.cfg.stage == 1 then
        if self.cfg.afk <= data.sid then
            self.taskState = TaskState.Award
        else
            self.taskState = TaskState.Running
            local start = self.cfg.afk - self.cfg.afk % 100
            self.progress = math.min((data.sid - start) / (self.cfg.afk - start), 1)
        end
    else
        --end
        -- if data.c_sid ~= nil and self.id <= data.c_sid then
        --     self.taskState = TaskState.Completed
        --     self.progress = 1
        -- else
        local start = self.cfg.afk - self.cfg.afk % 100
        if data.sid >= start then
            self.progress = math.min((data.sid - start) / (self.cfg.afk - start), 1)
        else
            self.progress = 0
        end

        if self.progress == 1 then
            self.taskState = TaskState.Award
        else
            self.taskState = TaskState.Running
        end
    end
end

return AfkTaskData
