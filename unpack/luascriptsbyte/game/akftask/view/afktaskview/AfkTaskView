---@class AfkTaskView : UIBaseView	中文描述
---@field public go_table AfkTaskView_GoTable GoTable
local AfkTaskView = _G.BaseClass("AfkTaskView", _G.UIBaseView)
--_G.AfkTaskView = AfkTaskView

function AfkTaskView:Awake()
    self.TaskState = require("AfkTaskModel").TaskState
    self.go_table.obj_item:SetActiveE(0)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.itemObjDic = {}

    self.go_table.scrollloopvectical_items:InitItemData(0, _G.handler(self, self.OnItemCall))
end

---@class params_AfkTaskView Data

---界面的入口函数
---@param  Data params_AfkTaskView
function AfkTaskView:OnCreate(Data)
    local AfkTaskModel = require("AfkTaskModel"):GetInstance()
    if AfkTaskModel.afkDatas then
        AfkTaskModel:InitAfkData()
        self:InitData(AfkTaskModel.afkDatas)
    else
        AfkTaskModel:GetAfkData(_G.handler(self, self.InitData))
    end

    self:MoveTo()
end

------@param afkDatas AfkTaskDatas
function AfkTaskView:InitData(afkDatas)
    ---@type AfkTaskData[]
    self.itemDatas = afkDatas.DownTasks
    local count = #self.itemDatas
    ---@type afk_cfg
    local nowCfg = _G.ConfigManager.afk_cfg[require("AfkModel"):GetInstance():GetCurSection()]
    if nowCfg ~= nil then
        --- 最多显示 下一章节奖励
        local nowChapter = nowCfg.chapter + 1
        for i = 1, #self.itemDatas do
            if self.itemDatas[i].cfg.chapter > nowChapter then
                count = i - 1
                break
            end
        end
    end

    self.go_table.scrollloopvectical_items:UpdateCount(count)
end
function AfkTaskView:OnItemCall(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemObjDic[id]
    if not item then
        item = self:AddComponent(obj, AfkTaskView_loopItem.New(obj, self))

        self.itemObjDic[id] = item
    end
    index = index + 1

    local data = self.itemDatas[index]
    item:Show(data)
end
function AfkTaskView:MoveTo()
    local index = 1
    for i = 1, #self.itemDatas do
        local data = self.itemDatas[i]
        if data.taskState ~= self.TaskState.Completed then
            index = i
            break
        end
    end
    if index > 1 then
        ---居中
        index = index - 1
    end
    --- C# 从0开始
    index = index - 1
    _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        true,
        true,
        true,
        index
    ):Start()
end

function AfkTaskView:TimerFunc(index)
    self.go_table.scrollloopvectical_items:ScrollToIndex(index)
end

function AfkTaskView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function AfkTaskView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return AfkTaskView
