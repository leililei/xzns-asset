---@class AfkTaskView_loopItem : Component	AfkTaskView_loopItem
local AfkTaskView_loopItem = _G.BaseClass("AfkTaskView_loopItem", _G.Component)

---创建对象时,入口构造函数
------@param view AfkTaskView
function AfkTaskView_loopItem:OnCreate(obj, view)
    self.TaskState = require("AfkTaskModel").TaskState
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.loopItemObjDic = {}
    --- afk_stage_cfg  id
    self.id = nil
    self.mView = view
end

---销毁对象时,析构函数
function AfkTaskView_loopItem:OnDestroy()
end
---销毁对象时,析构函数
function AfkTaskView_loopItem:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        require("AfkTaskModel"):GetInstance():ReceiveAward(
            self.id,
            function(msg)
                if msg.ack ~= 1 then
                    self:SetState()
                    return
                end
                self.data.taskState = self.TaskState.Completed
                self:SetState()
                self.mView:MoveTo()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
        )
    end
end

---@param data AfkTaskData
function AfkTaskView_loopItem:Show(data)
    self.data = data
    self.id = self.data.id
    self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(90022600041, self.data.level)
    self:SetState(self.data)
    self:CreatItem_All(self.data)
end

function AfkTaskView_loopItem:SetState()
    local isCompleted = self.data.taskState == self.TaskState.Completed
    ---已领取
    self.go_table.obj_Claimed:SetActiveE(isCompleted and 1 or 0)
    local isWaitClaim = self.data.taskState == self.TaskState.Award
    --- 可领取
    self.go_table.obj_WaitClaim:SetActiveE(isWaitClaim and 1 or 0)
    --- 进行中
    self.go_table.obj_Executing:SetActiveE((isWaitClaim == false and isCompleted == false) and 1 or 0)
end
---@param data AfkTaskData
function AfkTaskView_loopItem:CreatItem_All()
    self:DelItems()
    local reward = self.data.cfg.reward

    for i = 1, #reward do
        self:CreatItem(reward[i])
    end
end

function AfkTaskView_loopItem:CreatItem(data)
    self.loopItemObjDic[data[1]] = data[2]

    local ItemViewBase = require("ItemViewBase")
    ---@param luaItem ItemViewBase
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        self.go_table.obj_items,
        function(luaItem)
            if self.loopItemObjDic[data[1]] ~= data[2] then
                ItemViewBase.Despawn(luaItem)
                return
            end
            luaItem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            self.loopItemObjDic[data[1]] = luaItem
        end
    )
end

function AfkTaskView_loopItem:DelItems()
    local ItemViewBase = require("ItemViewBase")
    for key, luaItem in pairs(self.loopItemObjDic) do
        if luaItem.gameObject ~= nil then
            ItemViewBase.Despawn(luaItem)
        end
        self.loopItemObjDic[key] = nil
    end
end

