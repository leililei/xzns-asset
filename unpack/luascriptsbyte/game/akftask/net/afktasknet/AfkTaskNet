---@class AfkTaskNet : BaseGameNet	通信协议
local AfkTaskNet = _G.BaseClass("AfkTaskNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return AfkTaskNet AfkTaskNet
function AfkTaskNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function AfkTaskNet:GetData(pbData, item, callback)
    if pbData == nil then
        pbData = self:GetEmptyPB()
    end
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取奖励的数据
function AfkTaskNet:GetAfkData(callback)
    self:GetData(nil, _G.ConfigManager.net_map.game_afk_info, callback)
end

---获取奖励
---@field pb afk.c2s_afk_gate
function AfkTaskNet:ReceiveAward(pb, callback)
    self:GetData(pb, _G.ConfigManager.net_map.game_afk_gate, callback)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function AfkTaskNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type AfkTaskNet
return AfkTaskNet
