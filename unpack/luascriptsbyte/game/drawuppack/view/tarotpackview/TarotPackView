function TarotPackView:UIEffect()
    local RemoveEffect = UIUtils.RemoveEffect
    local LoadEffectByCfg = UIUtils.LoadEffectByCfg
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_DrawUpPackView_title, self.go_table.aorrawimage_titlebg)
    LoadEffectByCfg(ui_effect_cfg.ef_DrawUpPackView_bg, self.go_table.obj_Role)
    local lihuiPath, isImage = self.typeClass:GetLiHuiPath()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_character, lihuiPath and isImage)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_spine, lihuiPath and not isImage)
    if not _G.string.IsNullOrEmpty(lihuiPath) then
        local scale = self.typeClass:GetLiHuiScale()
        local pos = self.typeClass:GetLiHuiPos()
        if isImage then
            self.go_table.aorrawimage_character:LoadImage(
                lihuiPath,
                function(image)
                    image:SetNativeSize()
                    image:SetLocalPosition(pos[1], pos[2], pos[3])
                    image:SetLocalScaleXYZ(scale)
                end
            )
        else
            _G.PoolsManager:GetInstance():Spawn(
                lihuiPath,
                _G.ePoolType.UIItem,
                self.go_table.trans_spine,
                function(tran)
                    if self:IsNil() then
                        tran:DestroyObject()
                        return
                    end
                    tran:SetLocalPosition(pos[1], pos[2], pos[3])
                    tran:SetLocalScaleXYZ(scale)
                end
            )
        end
    end
end

---界面的销毁函数
function TarotPackView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---按钮点击事件在这里派发
function TarotPackView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    end
end

function TarotPackView:CloseView()
    self:Close()
end

function TarotPackView:itemOnClickBtn(go, isOn, giftinfo)
    if not self.data:CheckActivityInteractable() then
        return
    end
    self.cashData = giftinfo
    self.typeClass:Chongzhi(
        giftinfo,
        function()
            if self:IsNil() then
                return
            end
            --这里保留一个回调处理领奖
            self:UpDateScorllView()
            if not self.typeClass:CheckOtherConditionExtra() then
                self.data:ChangeState(1) -- 改变状态 关闭
            end
        end
    )
end

function TarotPackView:UpDateScorllView()
    self.listData = {}
    local list = {}
    for i, v in ipairs(self.model_data) do
        local buy_num = self.typeClass:GetItemBuyTimes(v.id or v.sid, v.type_reset)
        local limit = v.count_limit or v.count
        if buy_num ~= limit then
            _G.table.insert(self.listData, v)
        else
            _G.table.insert(list, v)
        end
    end
    for i, v in ipairs(list) do
        _G.table.insert(self.listData, v)
    end

    self.index = 0

    if self.mlistView2 == nil then
        self.go_table.looplist2_item:InitListView(table.count(self.listData), _G.handler(self, self.RefreshItem))
        self.mlistView2 = self.go_table.looplist2_item
    else
        -- self.mlistView2:SetListItemCount(table.count(self.model_data), true)
        self.mlistView2:RefreshAllShownItem()
    end
    -- if self.mScorll == nil then
    --     self.go_table.scrollloopvectical_item:InitItemData(#self.model_data, _G.handler(self, self.RefreshItem))
    --     self.mScorll = self.go_table.scrollloopvectical_item
    -- else
    --     self.mScorll:UpdateAllItem()
    -- end
end

function TarotPackView:OnMallCashListener(data)
    if not self.typeClass:CheckOtherConditionExtra() then
        self.data:ChangeState(1) -- 改变状态 关闭
    end
    -- self.cashData = nil
end

return TarotPackView
