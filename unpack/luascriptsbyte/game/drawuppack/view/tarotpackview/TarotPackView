local TarotManager = require("TarotManager")

---@class TarotPackView : UIBaseView    中文描述
---@field public go_table TarotPackView_GoTable GoTable
---@field model_data activity_cash_gift.i_cash_gift[]
local TarotPackView = _G.BaseClass("TarotPackView", _G.UIBaseView)

function TarotPackView:Awake()
    self.TarotClass = TarotManager:GetInstance():GetData()
    self.mScorll = nil
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]
end

---界面的入口函数
function TarotPackView:OnCreate(data, type_enum)
    if nil == data then
        local activitys = require "ActivitySynManager":GetInstance():GetChildAcitivity(
            10014,
            self.TarotClass.curActivityClass:GetJumpType(self.TarotClass.curActivityClass.activityID)
        )
        data = activitys
    end
    if nil == type_enum then
        type_enum = 2
    end
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10038, data:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1 then
        ---添加要显示的货币或者资源
        local resources
        -- = _G.ConfigManager.ui_cfg.TarotPackView.resources
        resources = { 12, _G.ConfigManager.discrete_cfg[115104][1][1] }
        if #resources > 0 then
            self:AddComponent(
                self.go_table.obj_goldInfo,
                require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
            )
        end
    end
    self:UpdateView(data, type_enum)
    if not _G.string.IsNullOrEmpty(data.cfg.info.icon) then
        self.go_table.aorrawimage_titlebg:LoadImage(
            "Images/" .. data.cfg.info.icon,
            function(raw)
                raw:SetNativeSize()
            end
        )
    end
    --self:UIEffect()
end

---@param listView2 SuperScrollView.LoopListView2
---@param index number
function TarotPackView:RefreshItem(listView2, index)
    local i = index + 1
    local data = self.listData[i]
    if data == nil then
        return
    end
    local obj
    if data.sid == self.spDataId then
        obj = listView2:NewListViewItem("$_obj_item2")
        self:UpdateCommonItem(obj, data)
    else
        obj = listView2:NewListViewItem("$_obj_item")
        self:UpdateCommonItem(obj, data)
    end
    return obj
end

---@param obj SuperScrollView.LoopListViewItem2
---@param data activity_cash_gift.i_cash_gift
function TarotPackView:UpdateCommonItem(obj, data)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemOnClickBtn, data))
    local limit = data.count_limit
    if self.type_enum == 2 then
        limit = data.count
    end

    local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)

    if limit - buy_num > self.limitTimesCond then
        tb.aortext_num:SetActiveE(0)
    else
        tb.aortext_num:SetActiveE(1)
        if data.type_reset == 1 then
            tb.aortext_num.text = _G.LangUtil.TryGetLangValue(90031400013, limit - buy_num)
        else
            tb.aortext_num.text = _G.LangUtil.TryGetLangValue(90021600042, limit - buy_num)
        end
    end
    tb.aorbtn_star:SetActiveE(limit == buy_num and 0 or 1)
    tb.obj_soldout:SetActiveE(limit == buy_num and 1 or 0)
    tb.aortext_giftname.text = data.name
    tb.aortext_discount.text = math.floor(data.discount * 0.01) .. "%"
    if data.price == 0 then
        tb.aortext_price.text = ""
        tb.aortext_price.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        _G.GameUtil.SetPriceByChannel(data.price, self.go_table.aortext_price)
    else
        tb.aortext_price.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({ data.consume_type, data.price })
        if item then
            tb.aorrawimage_icon:LoadImage(item.Icon)
        end
    end
    tb.aorrawimage_icon:SetActiveE(data.consume_type == 0 and 0 or 1)
    local awrad = data.goods
    tb.obj_AwardNode:RemoveAllChildren()
    for j = 1, #awrad do
        if awrad[j][2] > 0 then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awrad[j],
                tb.obj_AwardNode,
                function(item)
                    item.gameObject:SetLocalScaleXYZ(0.9)
                    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            )
        end
    end
end

---刷新
function TarotPackView:UpdateView(data, type_enum)
    data.typeClass:UpdateDynamicData(self.ActivityID)
    self.model_data = data.typeClass:GetModelCfgByCondition(self.ActivityID)
    if #self.model_data > 0 then
        self.spDataId = self.model_data[1].sid
        for i = 2, #self.model_data do
            if self.spDataId > self.model_data[i].sid then
                self.spDataId = self.model_data[i].sid
            end
        end
    end
    self.typeClass = data.typeClass
    self.data = data
    if type_enum then
        self.type_enum = type_enum
    else
        self.type_enum = 1
    end
    self:UpDateScorllView()
end

