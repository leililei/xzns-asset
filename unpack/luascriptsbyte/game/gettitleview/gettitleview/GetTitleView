---@class GetTitleView : UIBaseView    中文描述
---@field public go_table GetTitleView_GoTable GoTable
local GetTitleView = _G.BaseClass("GetTitleView", _G.UIBaseView)
local titles = {
    title = "Images/nNewTitleGet/ui_chzs_xchhd_txt",
    frame = "Images/nNewTitleGet/ui_chzs_xtxkhd_txt",
    halo = "Images/nNewTitleGet/ui_chzs_xghhd_txt",
    scene = "Images/nNewTitleGet/ui_chzs_xzthd_txt",
}
local scaleList = _G.ConfigManager.discrete_cfg[100510][1]
local scale
function GetTitleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GetTitleView:OnCreate(data)
    scale = 1
    self.titleData = self:CheckData(data)
    if self.titleData then
        if self.titleData.time_duration == 0 then
            self.go_table.aortext_title.text = _G.GetLangPackValue(90012501901)
        else
            local time = math.modf(self.titleData.time_duration / 86400)
            self.go_table.aortext_title.text = _G.GetLangPackValue(90012502001, time)
        end
        --ZHJH-6105 取消显示描述
        self.go_table.aortext_desc:SetActiveE(0)
        --self.go_table.aortext_desc.text = _G.GetLangPackValue(self.titleData.desc)
        if self.titleData.type == 1 then
            --self.go_table.aorrawimage_Icon:SetLocalScaleXYZ(scale)
            if self.titleData.isSprite then
                self.go_table.aorimage_Icon:SetActiveE(1)
                self.go_table.aorimage_Icon.SpriteName = self.titleData.loadpath
            else
                self.go_table.aorrawimage_Icon:LoadImage(
                    self.titleData.loadpath,
                    function(tran)
                        if tran then
                            tran:SetNativeSize()
                        end
                    end
                )
            end
            if self.titleData.loadEffPath and not _G.string.IsNullOrEmpty(self.titleData.loadEffPath) then
                _G.UIUtils.LoadEffectByPath(
                    self.titleData.loadEffPath,
                    self.go_table.obj_eff,
                    function(obj)
                        if self:IsNil() then
                            _G.DestroyObject(obj)
                            return
                        end
                    end,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    true
                )
            end
        elseif self.titleData.type == 2 then
            scale = scaleList[3]
            --self.go_table.aorrawimage_show:SetLocalScaleXYZ(scale)
            _G.UIUtils.LoadEffectTitleOrFrame(self.titleData.loadpath, self.go_table.aorrawimage_show)
        end
    else
        self:Close()
    end
end

---界面的销毁函数
function GetTitleView:OnDestroy()
end

---按钮点击事件在这里派发
function GetTitleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

---检测数据并返回要展示的图片路径
---@param table data 奖励展示数据
---@return string 返回需要加载的图片路径
function GetTitleView:CheckData(data)
    local itemData = {}
    if data.type == 1 then
        local frame_cfg = _G.ConfigManager.player_frame_cfg
        itemData.loadpath = frame_cfg[data.sid].frame
        itemData.type = frame_cfg[data.sid].type_title
        itemData.desc = frame_cfg[data.sid].desc
        itemData.time_duration = frame_cfg[data.sid].time_duration
        self:LoadTitle("frame")
    elseif data.type == 2 then
        local title_cfg = _G.ConfigManager.player_title_effect_cfg
        --self.go_table.aorrawimage_show:SetLocalPosition(0, 50, 0)
        itemData.loadpath = title_cfg[data.sid].title
        itemData.type = title_cfg[data.sid].type_title
        itemData.desc = title_cfg[data.sid].desc
        itemData.time_duration = title_cfg[data.sid].time_duration
        if itemData.time_duration > 0 then
            itemData.time_duration = _G.PlayerModel:GetInstance():GetTitleRemainDuration(data.sid)
        end
        self:LoadTitle("title")
        scale = scaleList[2]
    elseif data.type == 3 then
        local halo_cfg = _G.ConfigManager.player_halo_effect_cfg
        itemData.loadpath = halo_cfg[data.sid].icon
        itemData.type = 1
        itemData.desc = halo_cfg[data.sid].desc
        itemData.time_duration = halo_cfg[data.sid].time_duration
        if itemData.time_duration > 0 then
            itemData.time_duration = _G.PlayerModel:GetInstance():GetHaloRemainDuration(data.sid)
        end
        --self.go_table.aorrawimage_show:SetLocalScaleXYZ(1.5)
        self:LoadTitle("halo")
        scale = scaleList[1]
    elseif data.type == 4 then
        local theme_cfg = _G.ConfigManager.player_scene_cfg
        itemData.loadpath = theme_cfg[data.sid].image
        itemData.type = 1
        itemData.desc = theme_cfg[data.sid].unlock_txt
        itemData.time_duration = 0
        self:LoadTitle("scene")
        scale = scaleList[4]
    elseif data.type == 5 then
        local bubble_cfg = _G.ConfigManager.player_bubble_cfg
        itemData.loadpath = bubble_cfg[data.sid].icon
        itemData.loadEffPath = bubble_cfg[data.sid].bubble_effect[1] and bubble_cfg[data.sid].bubble_effect[1][1] or ""
        itemData.type = 1
        itemData.desc = bubble_cfg[data.sid].unlock_txt
        itemData.time_duration = bubble_cfg[data.sid].time_duration or 0
        self:LoadTitle("chatFrame")
    elseif data.type == 6 then
        local player_portrait_cfg = _G.ConfigManager.player_portrait_cfg
        local item_cfg=_G.ConfigManager.item_cfg
        local itemcfg=item_cfg[player_portrait_cfg[data.sid].unlock_params[1]]
        itemData.loadpath = itemcfg.Icon
        itemData.type = 1
        itemData.desc = ""
        itemData.time_duration = 0
    elseif data.type == 7 then
        local player_rolebox_cfg = _G.ConfigManager.player_rolebox_cfg
        itemData.loadpath = player_rolebox_cfg[data.sid].rolebox
        itemData.type = player_rolebox_cfg[data.sid].type_title
        itemData.desc = player_rolebox_cfg[data.sid].unlock_prompt
        itemData.time_duration = player_rolebox_cfg[data.sid].time_duration or 0
        if self.go_table.aorrawimage_bg then
            self.go_table.aorrawimage_bg:LoadImage(
                player_rolebox_cfg[data.sid].background,
                function(tran)
                    if tran then
                        --tran:SetNativeSize()
                    end
                end
            )
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("当前数据非光环称号头像框聊天框数据!")
        end
        return nil
    end
    return itemData
end

