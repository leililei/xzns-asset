end

function SuperValuGiftView:UpDateScorllView(isBuy, isFree)
    if not isBuy then
        self.isInited = false
    end
    if isFree then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.SuperValuGift.id)
    end
    local item = {}
    for key, value in pairs(self.model_data) do
        if _G.table.count(value.conditions) <= 0 or _G.GlobalConditionManager.CheckConditionByArray(value.conditions) then
            _G.table.insert(item, value)
        end
    end
    self.model_data = item
    _G.SortList(
        self.model_data,
        function(data)
            local num = 10
            --local buy_num = MallManager:GetInstance():GetItemBuyTimes(data.id or data.sid, data.type_reset)
            local buy_num = SuperValuGiftModel:GetInstance():GetItemBuyTimes(data.id or data.sid)
            local limit = data.count_limit or data.count
            local paixu = data.display_priority or data.price
            -- if self.type_enum == 2 then
            --     limit = data.count
            --     paixu = data.price
            -- end
            if buy_num == limit then
                num = 9
            end
            return num, -paixu
        end
    )
    _G.DelayDo(
        0.1,
        function()
            if self.mScorll == nil then
                self.AwardData = {}
                self.go_table.scrollloopvectical_item:InitItemData(#self.model_data, _G.handler(self, self.RefreshItem))
                self.mScorll = self.go_table.scrollloopvectical_item
            else
                self.AwardData = {}
                self.mScorll:UpdateAllItem()
            end
            self.isInited = true
        end
    )
end
---刷新展示的卡牌
function SuperValuGiftView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local item = obj
    item:SetName(index)
    local data = self.model_data[index]
    ---@type SuperValuGiftView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.itemOnClickBtn, data))
    tb.aortext_price.text = math.floor(data.discount * 0.0001 * 100) .. "%"
    if data.price == 0 then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(0)
        tb.aortext_buy1.text = _G.LangUtil.TryGetLangValue(90023900001)
        tb.aortext_buy.text = ""
    elseif _G.table.ContainsValue(FreeGiftId, data.id) then --特殊处理 第一个按钮 免费领取 活跃度 100
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SuperValuGift.id)
        tb.aortext_price.text = GetLangPackValue(90023900001)
        tb.aortext_buy.text = _G.LangUtil.TryGetLangValue(90023900001)
        tb.aortext_buy1.text = ""
    else
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(0)
        tb.aortext_buy1.text = ""
        local curPrice = _G.GameUtil.RatioControl(data.price)
        local dataInfo = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(data.price)
        if dataInfo then
            tb.aortext_buy.text = dataInfo.formattedPrice
        else
            if _G.AppSetting.IsOverseas then
                tb.aortext_buy.text = GetLangPackValue(90000010807) .. curPrice
            else
                tb.aortext_buy.text = GetLangPackValue(90000010819, curPrice)
            end
        end
    end
    tb.aortext_giftname.text = _G.LangUtil.TryGetLangValue(data.name)
    local buy_num = SuperValuGiftModel:GetInstance():GetItemBuyTimes(data.id or data.sid)
    --local buy_num = MallManager:GetInstance():GetItemBuyTimes(data.id or data.sid, data.type_reset)
    local limit = data.count_limit
    --购买次数
    _G.GameUtil.SetActiveByCondition(tb.aortext_buy, not (buy_num == limit))
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_buy, not (buy_num == limit))
    _G.GameUtil.SetActiveByCondition(tb.obj_gray, buy_num == limit)
    if _G.table.ContainsValue(FreeGiftId, data.id) then --特殊处理 第一个按钮 活跃度  100
        curLiveness = SuperValuGiftModel:GetInstance().liveness
        sumLivenese = data.price
        if curLiveness > sumLivenese then
            curLiveness = 100
        end
        tb.aortext_buylimitnum.text = _G.LangUtil.TryGetLangValue(90021600063, curLiveness, sumLivenese)
        if buy_num == limit then
            tb.aorimage_Gray:SetGray(curLiveness == sumLivenese)
            require("SuperValuGiftModel").buy_num = limit
        end
    else
        tb.aortext_buylimitnum.text = _G.LangUtil.TryGetLangValue(90021600042, limit - buy_num)
        tb.aorimage_Gray:SetGray(buy_num == limit)
    end
    self.CurrentAward = data.goods
    tb.obj_Content:ClearChildren()
    for key, value in pairs(self.CurrentAward) do
        obj = _G.InstantiateObject(self.go_table.obj_AwardItem, tb.obj_Content)

        self:RefreshAwardItem(value, obj)
    end

    -- if _G.IsNil(self.AwardLoopListInit[index]) then
    --     tb.scrollloophorizontal_Award:InitItemData(#self.CurrentAward, _G.handler(self, self.RefreshAwardItem))
    -- else
    --     tb.scrollloophorizontal_Award:UpdateAllItem()
    -- end
    _G.GameUtil.SetActiveByCondition(obj, false)
    if not self.isInited then
        self:DelayDo(
            0.3 * (index - 1),
            function()
                _G.GameUtil.SetActiveByCondition(obj, true)
            end
        )
    else
        _G.GameUtil.SetActiveByCondition(obj, true)
    end

    return item
end

