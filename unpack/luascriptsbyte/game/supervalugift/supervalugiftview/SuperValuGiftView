end

---按钮点击事件在这里派发
function SuperValuGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

function SuperValuGiftView:CloseView()
    SuperValuGiftModel:GetInstance():RefreshRedPoint()
    self:Close()
end

function SuperValuGiftView:OnDestroy()
    if self.timer then
        self.timer:Stop()
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return SuperValuGiftView
