function SuperValuGiftView:DelayDo(time, call)
    if not self.DelayTb then
        self.DelayTb = {}
    end
    self.DelayTb[call] =
        _G.DelayDo(
        time,
        function()
            self.DelayTb[call] = nil
            call()
        end
    )
end

