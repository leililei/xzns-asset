end

function SuperValuGiftView:OnTimeCall(elapsed)
    if IsNil(self.timer) then
        return
    end
    if self.CountDownTime > 0 then
        self.CountDownTime = self.CountDownTime - elapsed
        self.go_table.aortext_CountDown.text =
            _G.LangUtil.GetLangPackValue(90028500035, _G.TimeUtil.TranslateSecondForStrDHMS(math.floor(self.CountDownTime)))
    else
        self:InitTime()
    end
end

function SuperValuGiftView:InitTime()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local time = SeasonModel:GetInstance():GetTime()
    local duration = _G.ConfigManager.discrete_cfg[105114][1][1] * 86400
    local now = _G.TimeUtil.GetServerUnixTime()
    local curTime = now - time.startTime
    if time.settlementTime - now <= duration - curTime % duration then
        self.go_table.aortext_CountDown.text = _G.GetLangPackValue(90025500085)
    else
        while curTime > 0 do
            curTime = curTime - duration
        end
        self.CountDownTime = -curTime
        self.go_table.aortext_CountDown.text =
        GetLangPackValue(90028500035, _G.TimeUtil.TranslateSecondForStrDHMS(self.CountDownTime))
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeCall, self, false, false)
        self.timer:Start()
    end
end

