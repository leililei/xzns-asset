local base = require "ActivitySynTypeBase"
---@class TrainSuperValuModel 超值礼包
local TrainSuperValuModel = _G.BaseClass("TrainSuperValuModel", base)
---类的构造函数
function TrainSuperValuModel:__init()
    self.FirstLogin = false
end

---类的析构函数
function TrainSuperValuModel:Dispose()
end

function TrainSuperValuModel:GetDataFormServer()
    -- self.PowerToTheTopModel:GetDataFormServer(_G.handler(self, self.ParseData))
    self:ParseData()
end
---数据解析完成
function TrainSuperValuModel:ParseData()
    base.ParseData(self)
    if self.reconnectEndCall then
        self.reconnectEndCall()
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SuperValuGiftView.Name)
        if view then
            view:OnMallCashListener()
        end
    end
end
function TrainSuperValuModel:InitFunction()
    self.type_num = 1 --GM（同一个界面，2 = 是GM 1 = 配置）
    --self.PowerToTheTopModel:InitFunction()
    self:InitModelData()
    self:InitDynamicData()
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift_time"
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        local login_time = _G.CS.WechatGameCore.PlayerPrefs.GetInt(key)
        if _G.TimeUtil.CheckTheSameDay(login_time, nowtime) then
        else
            --检测是否 还有未充值的
            if self:CheckOtherConditionExtra() then
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, nowtime)
                local key2 = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
                _G.CS.WechatGameCore.PlayerPrefs.SetInt(key2, 1)
            end
        end
    else
        _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, nowtime)
        local key1 = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
        _G.CS.WechatGameCore.PlayerPrefs.SetInt(key1, 1)
    end
    -- local flag =
    --     require "ActivitySynManager":GetInstance():CheckActivityConditionExtra(self.curActivityClass:GetActivityID())
    -- if not flag then
    --     self.curActivityClass:ChangeState(1)
    -- end
    if not self:CheckOtherConditionExtra() then
        self.curActivityClass:ChangeState(1)
        local key1 = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
        _G.CS.WechatGameCore.PlayerPrefs.SetInt(key1, 0)
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    require("RedPointManager"):GetInstance():RefreshNode(0)
end

function TrainSuperValuModel:OnEnterActivity()
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SuperValuGiftView.Name)
    if window then
        window.View:UpdateView(self.curActivityClass, 1)
        window.View:Show()
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SuperValuGiftView.Name, self.curActivityClass, 1)
    end
end
function TrainSuperValuModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.SuperValuGiftView.Name
end
function TrainSuperValuModel:OnSixClockUpdate(endcall)
    base.OnSixClockUpdate(self, endcall)
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 1)
    end
end
---数据类 静态数据类
function TrainSuperValuModel:InitModelData()
    self.model_cfg = {}
    local cfg = _G.ConfigManager.store_active_cfg
    for key, value in pairs(cfg) do
        if value.type_1 == 2 then
            _G.table.insert(self.model_cfg, value)
        end
    end
    self.model_cfg = _G.table.toArray(self.model_cfg)
end
---获取动态的商场数据  购买的次数
function TrainSuperValuModel:InitDynamicData()
end

function TrainSuperValuModel:CheckOtherConditionExtra()
    local flag = false
    for i = 1, #self.model_cfg do
        local data = self.model_cfg[i]
        local buy_num = self:GetItemBuyTimes(data.id, data.type_reset)
        if buy_num ~= data.count_limit then
            flag = true
            break
        end
    end
    return flag
end
function TrainSuperValuModel:SetItemBuyTimes()
end
---获取动态的商场数据  购买的次数
function TrainSuperValuModel:GetItemBuyTimes(id, _type)
    return require "MallManager":GetInstance():GetItemBuyTimes(id, _type)
end

---充值
function TrainSuperValuModel:Chongzhi(giftinfo) --, call)
    local cfg = _G.ConfigManager.store_active_cfg[giftinfo.id]
    require "MallManager":GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
    --, call)
end

---初始化红点
function TrainSuperValuModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckFirstLogin}
    self.redpointTree = {false, false}
end
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function TrainSuperValuModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
function TrainSuperValuModel:UpdateRedpoint()
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
    _G.CS.WechatGameCore.PlayerPrefs.SetInt(key, 0)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    --require("RedPointManager"):GetInstance():RefreshNode(0)
    --require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self:GetRedpointIDByIndex(1))
end
---是否 每日的首次登录
function TrainSuperValuModel:CheckFirstLogin()
    ---检测功能是否开启
    local flag =
        require "ActivitySynManager":GetInstance():CheckActivityConditionExtra(self.curActivityClass:GetActivityID())
    if not flag then
        return 0
    end
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "SuperValuGift"
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 1 then
            return 1
        else
            return 0
        end
    else
        return 1
    end
    --return 1
end

function TrainSuperValuModel.CheckGodSpecialGiftView()
    local isForce = _G.MainManager:GetInstance():GetForceShowGodSpecialGift()
    if isForce == true then
        return true
    end
    local ActivitySynManager = require "ActivitySynManager":GetInstance()
    local godSpecialData = ActivitySynManager:GetChildAcitivity(10014)
    if godSpecialData ~= nil and godSpecialData.curState == require "ActivitySynManager".State.Open then
        return true
    end
    return false
end

function TrainSuperValuModel:ReConnect(endcall)
    -- body
    self.reconnectEndCall = endcall
    self:GetDataFormServer()
end

return TrainSuperValuModel
