---检查红点
function SuperValuGiftModel:CheckRedPoint()
    if require("SeasonModel"):GetInstance():GetSeasonTimeLeft() <= 0 then
        return false
    end
    for _, v in pairs(FreeGiftId) do
        if _G.ConfigManager.store_active_cfg[v] then
            if self:GetItemBuyTimes(v) < _G.ConfigManager.store_active_cfg[v].count_limit then
                return true
            end
            --if self.liveness >= ActiveNum and self:GetItemBuyTimes(v) < _G.ConfigManager.store_active_cfg[v].count_limit then
            --    return true
            --end
        end
    end
    -- local startTime = _G.PlayerPrefsManager.GetInt("SuperValuGift")
    -- if startTime == nil or startTime ~= require("SeasonModel"):GetInstance():GetTime().startTime then
    --     return true
    -- end
    return false
end

