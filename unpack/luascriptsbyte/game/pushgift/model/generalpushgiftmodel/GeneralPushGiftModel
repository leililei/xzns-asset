local base = require "ActivitySynTypeBase"
---@class GeneralPushGiftModel:ActivitySynTypeBase	中文描述
---@field GiftType number 礼包类型(1、普通礼包2、节日礼包): 2万圣节礼包丶3圣诞节礼包丶4感恩节礼包
---@field isFirst boolean 是否首次弹出
---@field sendBuy boolean 是否购买付费礼包
---@field isOpened boolean 是否首次弹出过
---@field sid number 配置表id
---@field freeGiftData table 免费礼包
---@field cashGiftData table 付费礼包
---@field freeTimes table 免费礼包购买次数
---@field cashTimes table 付费礼包购买次数
local GeneralPushGiftModel = _G.BaseClass("GeneralPushGiftModel", base)
---@return GeneralPushGiftModel GeneralPushGiftModel
local ActivitySynManager = require "ActivitySynManager"
local TimeUtil = _G.TimeUtil

function GeneralPushGiftModel:__init()
    self.GiftType = 0
    self.isFirst = true
    self.isOpened = false
    self.sendBuy = false
    self.freeTimes = 999
    self.cashTimes = {}
    self.freeGiftData = nil
    self.cashGiftData = {}
end

---获取GM数据
---@param info activity.i_activity_self_info
function GeneralPushGiftModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function GeneralPushGiftModel:ParseData(info)
    if info == nil then
        return
    end
    self:SetSelfData(info.send_gift2)
    base.ParseData(self)
    if self.endTime - _G.TimeUtil.GetServerUnixTime() <= 0 or self:CheckBuyAllGift() then
        local key = self.curActivityClass:GetActivityID()
        self:CheckDisconnection()
        if self.freeGiftData then
            if self.freeGiftData.count - self.freeGiftData.buyTimes < 1 then
                self:CloseActivity()
                _G.PlayerPrefsManager.SetInt(key, 0)
            end
        else
            self:CloseActivity()
            _G.PlayerPrefsManager.SetInt(key, 0)
        end
    else
        if self.isOpened then
            self:CheckDisconnection()
        else
            self:InitIsOpen()
            self.isOpened = true
        end
    end
end

---@param info activity_send_gift.i_activity_send_gift
function GeneralPushGiftModel:SetSelfData(info)
    self.GiftType = info.type
    self.sid = info.sid
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local times = info.times or {}
    local index = 1
    for _, data in pairs(info.gifts) do
        data.buyTimes = 0
        data.sindex = index
        for k, v in pairs(times) do
            if v.k == data.sid then
                data.buyTimes = v.v or 0
                break
            end
        end

        if data.price == 0 then
            self.freeTimes = data.buyTimes
        end

        local cashTimes = self.cashTimes[data.sid] or 0
        self.cashTimes[data.sid] = data.buyTimes > cashTimes and data.buyTimes or cashTimes
        self.cashGiftData[data.sid] = data
        index = index + 1
    end
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local key = self.curActivityClass:GetActivityID()
    _G.PlayerPrefsManager.SetInt(key, self.endTime)

    local T = _G.string.split(self.curActivityClass.cfg.info.front.precast, "#")
    self.bgName = T[1]
    self.titleName = T[2]
    self.titleScaleX = tonumber(T[3]) or 1
    self.titleScaleY = tonumber(T[4]) or 1
    self.giftBgNameT = {}
    for i = 5, #T do 
        self.giftBgNameT[i - 4] = T[i]
    end
end

---获取活动的结束时间
function GeneralPushGiftModel:GetActivityEndTime()
    return self.endTime
end

function GeneralPushGiftModel:AddBuyTimes(sid)
    if self.cashGiftData then
        local data = self.cashGiftData[sid]
        data.buyTimes = data.buyTimes + 1
    end
end

function GeneralPushGiftModel:CheckClose()
    if self:CheckBuyAllGift() then
        self:CloseActivity()
    end
end

---是否已全部购买完礼包
function GeneralPushGiftModel:CheckBuyAllGift()
    if self.cashGiftData then
        for _, v in pairs(self.cashGiftData) do
            if v.buyTimes < v.count then
                return false
            end
        end
    end

    return true
end

function GeneralPushGiftModel:OnEnterActivity()
    --TODO:进入到具体活动内容
    if not self:CheckThemeActivityIsOpen() then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GeneralPushGiftView.Name, self.curActivityClass)

    self.isFirst = false
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    base.OnEnterActivity(self)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function GeneralPushGiftModel:InitIsOpen()
    local MainOpenViewFunItem = {}
    MainOpenViewFunItem.OpenViewFun = function()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GeneralPushGiftView.Name, self.curActivityClass)
        self.isFirst = false
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.PushGift)
end

function GeneralPushGiftModel:CloseActivity()
    self:StopMainTimer()
    self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
end

function GeneralPushGiftModel:ChangeCoinID(coinType)
    if coinType == 1 then
        self.coinId = 104
    elseif coinType == 2 then
        self.coinId = 101
    elseif coinType == 3 then
        self.coinId = 103
    elseif coinType == 4 then
        self.coinId = 106
    elseif coinType == 6 then
        self.coinId = 109
    end
    return self.coinId
end

---物品id
---@param sid number 礼包id
function GeneralPushGiftModel:SetCoin(sid)
    if self.cashGiftData.siege_coin and self.cashGiftData.siege_coin[sid] > 0 then
        local data = {
            type = {
                [1] = self.coinId,
                [2] = self.cashGiftData.siege_coin[sid]
            }
        }
        _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
        return data
    end
    return nil
end

function GeneralPushGiftModel:BuyGift(data, callBack)
    self.sendBuy = true
    self.buyGiftId = data.sid
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require "MallManager":GetInstance():BuyActiveGift(data.price, data.activityId, data.sid)
end

function GeneralPushGiftModel:OnMallCashListener(data)
    if data.activity_id == self.curActivityClass:GetActivityID() then
        if self.cashGiftData[data.sid] then
            self.cashGiftData[data.sid].buyTimes = self.cashGiftData[data.sid].buyTimes + 1
            self.cashTimes[data.sid] = self.cashGiftData[data.sid].buyTimes
        end
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
        self.buyGiftId = nil
        self.sendBuy = false
        if self:CheckBuyAllGift() then
            self:CloseActivity()
        end
    end
end

function GeneralPushGiftModel:CheckDisconnection()
    if self.sendBuy and self.buyGiftId and self.cashTimes[self.buyGiftId] < self.cashGiftData[self.buyGiftId].buyTimes then
        if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.GeneralPushGiftView.Name) then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.GeneralPushGiftView.Name)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GeneralPushGiftView.Name, self.curActivityClass)
            local data = {}
            data.award = {}
            data.award.item = self.cashGiftData[self.buyGiftId].award
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self.cashTimes[self.buyGiftId] = self.cashGiftData[self.buyGiftId].buyTimes
