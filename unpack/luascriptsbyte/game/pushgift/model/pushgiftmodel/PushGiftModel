local base = require "ActivitySynTypeBase"
---@class PushGiftModel:ActivitySynTypeBase	中文描述
---@field GiftType number 礼包类型(1、普通礼包2、节日礼包)
---@field isFirst boolean 是否首次弹出
---@field sendBuy boolean 是否购买付费礼包
---@field isOpened boolean 是否首次弹出过
---@field sid number 配置表id
---@field freeGiftData table 免费礼包
---@field cashGiftData table 付费礼包
---@field freeTimes table 免费礼包购买次数
---@field cashTimes table 付费礼包购买次数
local PushGiftModel = _G.BaseClass("PushGiftModel", base)
---@return PushGiftModel PushGiftModel
local ActivitySynManager = require "ActivitySynManager"
local TimeUtil = _G.TimeUtil

function PushGiftModel:__init()
    self.GiftType = 0
    self.isFirst = true
    self.isOpened = false
    self.sendBuy = false
    self.freeTimes = 999
    self.cashTimes = {}
    self.freeGiftData = nil
    self.cashGiftData = {}
    _G.Events:GetInstance():AddListener(_G.eCertificateMall.Parsed, self.CheckIsHasAllGwSkin, self)
end

---获取GM数据
---@param info activity.i_activity_self_info
function PushGiftModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function PushGiftModel:ParseData(info)
    if info == nil then
        return
    end
    self:SetSelfData(info.send_gift)
    base.ParseData(self)
    if self.endTime - _G.TimeUtil.GetServerUnixTime() <= 0 or self:CheckBuyAllGift() then
        local key = self.curActivityClass:GetActivityID()
        self:CheckDisconnection()
        if self.freeGiftData then
            if self.freeGiftData.count - self.freeGiftData.buyTimes < 1 then
                self:CloseActivity()
                _G.PlayerPrefsManager.SetInt(key, 0)
            end
        else
            self:CloseActivity()
            _G.PlayerPrefsManager.SetInt(key, 0)
        end
    else
        if self.isOpened then
            self:CheckDisconnection()
        else
            self:InitIsOpen()
            self.isOpened = true
        end
    end
end

---@param info send_gift
function PushGiftModel:SetSelfData(info)
    self.GiftType = info.type
    self.sid = info.sid
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    if self.GiftType == 1 then
        local times = info.times or {}
        for _, data in ipairs(info.gifts) do
            data.buyTimes = 0
            for k, v in pairs(times) do
                if v.k == data.sid then
                    data.buyTimes = v.v or 0
                    break
                end
            end

            local cashTimes = self.cashTimes[data.sid] or 0
            self.cashTimes[data.sid] = data.buyTimes > cashTimes and cashTimes or data.buyTimes
            self.cashGiftData[data.sid] = data
        end
    elseif self.GiftType == 2 then
        local times = info.times or {}
        local index = 1
        for _, data in pairs(info.gifts) do
            data.buyTimes = 0
            data.sindex = index
            for k, v in pairs(times) do
                if v.k == data.sid then
                    data.buyTimes = v.v or 0
                    break
                end
            end

            if data.price == 0 then
                self.freeTimes = data.buyTimes
            end

            local cashTimes = self.cashTimes[data.sid] or 0
            self.cashTimes[data.sid] = data.buyTimes > cashTimes and data.buyTimes or cashTimes
            self.cashGiftData[data.sid] = data
            index = index + 1
        end
    elseif self.GiftType == 5 or self.GiftType == 6 or self.GiftType == 7 or self.GiftType == 8 then
        local times = info.times or {}
        local index = 1
        for _, data in pairs(info.gifts) do
            data.buyTimes = 0
            data.sindex = index
            for k, v in pairs(times) do
                if v.k == data.sid then
                    data.buyTimes = v.v or 0
                    break
                end
            end

            if data.price == 0 then
                self.freeTimes = data.buyTimes
            end

            local cashTimes = self.cashTimes[data.sid] or 0
            self.cashTimes[data.sid] = data.buyTimes > cashTimes and data.buyTimes or cashTimes
            self.cashGiftData[data.sid] = data
            index = index + 1
        end
        -- self.freeGiftData.buyTimes = 0
        -- self.cashGiftData.buyTimes = 0
        -- if info.times ~= nil then
        --     for _, v in pairs(info.times) do
        --         if self.freeGiftData.sid == v.k then
        --             self.freeGiftData.buyTimes = v.v
        --         elseif self.cashGiftData.sid == v.k then
        --             self.cashGiftData.buyTimes = v.v
        --         end
        --     end
        -- end
        -- self.freeTimes = self.freeGiftData.buyTimes > self.freeTimes and self.freeTimes or self.freeGiftData.buyTimes
        -- self.cashTimes = self.cashGiftData.buyTimes > self.cashTimes and self.cashTimes or self.cashGiftData.buyTimes
    end
    self.endTime = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local key = self.curActivityClass:GetActivityID()
    _G.PlayerPrefsManager.SetInt(key, self.endTime)
end

---获取活动的结束时间
function PushGiftModel:GetActivityEndTime()
    return self.endTime
end

function PushGiftModel:AddBuyTimes(sid)
    if self.cashGiftData then
        local data = self.cashGiftData[sid]
        data.buyTimes = data.buyTimes + 1
    end
end

function PushGiftModel:CheckClose()
    if self:CheckBuyAllGift() then
        self:CloseActivity()
    end
end

---是否已全部购买完礼包
function PushGiftModel:CheckBuyAllGift()
    if self.cashGiftData then
        for _, v in pairs(self.cashGiftData) do
            if v.buyTimes < v.count then
                return false
            end
        end
    end

    return true
end

---检测是否已经购买全部光武皮肤
function PushGiftModel:CheckIsHasAllGwSkin()
    if self.GiftType ~= 8 then
        return
    end
    local count = 0
    local hasCount = 0
    for _, v in pairs(self.cashGiftData) do
        count = count + 1
        for _, award in pairs(v.award) do
            local id = award.type[1]
            if _G.ConfigManager.item_cfg[id] and _G.ConfigManager.item_cfg[id].Type1 == 24 then
                local sid = _G.tonumber(_G.ConfigManager.item_cfg[id].UseParameter[1][1])
                if require("ArtifactIllustrationModel"):GetInstance():CheckIsHasSkinBySid(sid) then
                    hasCount = hasCount + 1
                end
            end
        end
    end
    if hasCount == count then
        self:CloseActivity()
    end
end

function PushGiftModel:OnEnterActivity()
    --TODO:进入到具体活动内容
    if not self:CheckThemeActivityIsOpen() then
        return
    end
    if self.GiftType == 1 then
        local cfg = _G.ConfigManager.store_holiday_cfg[self.curActivityClass.typeClass.sid]
        if cfg.style == 2 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGiftNewView.Name, self.curActivityClass)
        elseif cfg.style == 1 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGodHaloView.Name, self.curActivityClass)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGiftView.Name, self.curActivityClass)
        end
    elseif self.GiftType == 2 then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HolidayGiftView.Name, self.curActivityClass)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualFestivalGiftView.Name,
                self.curActivityClass)
    elseif self.GiftType == 5 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ValentineDayGiftView.Name,
                self.curActivityClass)
    elseif self.GiftType == 6 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WomenDayGiftView.Name,
                self.curActivityClass)
    elseif self.GiftType == 7 then
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.QingmingDayGiftView.Name,
            self.curActivityClass)
    elseif self.GiftType == 8 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGWGiftView.Name,
            self.curActivityClass)
    end

    self.isFirst = false
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    base.OnEnterActivity(self)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function PushGiftModel:isCanPopPushGiftNewView()
    local isNoPrompts = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.PushGiftViewTip, 0)
    if isNoPrompts == 0 then
        return true
    end
    local time = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.PushGiftViewTime, 0)
    local nowtime = TimeUtil.GetServerUnixTime()
    if time and time ~= 0 then
        time = TimeUtil.GetDayBegin(time)
        local left = nowtime - time
        if left > 0 then
            if left >= 86400 then
                isNoPrompts = 0
            end
        end
    end
    if isNoPrompts == 0 then
        return true
    else
        return false
    end
end

function PushGiftModel:InitIsOpen()
    local MainOpenViewFunItem = {}
    local cfg = _G.ConfigManager.store_holiday_cfg[self.curActivityClass.typeClass.sid]
    if cfg.style == 2 and self:isCanPopPushGiftNewView() == false then
        return
    end

    MainOpenViewFunItem.OpenViewFun = function()
        if self.GiftType == 1 then
            local cfg = _G.ConfigManager.store_holiday_cfg[self.curActivityClass.typeClass.sid]
            if cfg.style == 2 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGiftNewView.Name, self
                    .curActivityClass)
            elseif cfg.style == 1 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGodHaloView.Name, self
                    .curActivityClass)
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGiftView.Name, self.curActivityClass)
            end
        elseif self.GiftType == 2 then
            --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HolidayGiftView.Name, self.curActivityClass)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualFestivalGiftView.Name,
                self.curActivityClass)
        elseif self.GiftType == 5 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ValentineDayGiftView.Name,
                    self.curActivityClass)
        elseif self.GiftType == 6 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WomenDayGiftView.Name,
                    self.curActivityClass)
        elseif self.GiftType == 7 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.QingmingDayGiftView.Name,
                    self.curActivityClass)
        elseif self.GiftType == 8 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PushGWGiftView.Name,
                self.curActivityClass)
        end
        self.isFirst = false
        require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.PushGift)
end

function PushGiftModel:CloseActivity()
    self:StopMainTimer()
    self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
end

function PushGiftModel:ChangeCoinID(coinType)
    if coinType == 1 then
        self.coinId = 104
    elseif coinType == 2 then
        self.coinId = 101
    elseif coinType == 3 then
        self.coinId = 103
    elseif coinType == 4 then
        self.coinId = 106
    elseif coinType == 6 then
        self.coinId = 109
    end
    return self.coinId
end

---物品id
---@param sid number 礼包id
function PushGiftModel:SetCoin(sid)
    if self.cashGiftData.siege_coin and self.cashGiftData.siege_coin[sid] > 0 then
        local data = {
            type = {
                [1] = self.coinId,
                [2] = self.cashGiftData.siege_coin[sid]
            }
        }
        _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, data.type)
        return data
    end
    return nil
end

function PushGiftModel:BuyGift(data, callBack)
    self.sendBuy = true
    self.buyGiftId = data.sid
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.mallCall = callBack
    require "MallManager":GetInstance():BuyActiveGift(data.price, data.activityId, data.sid)
end

function PushGiftModel:OnMallCashListener(data)
    if data.activity_id == self.curActivityClass:GetActivityID() then
        if self.cashGiftData[data.sid] then
            self.cashGiftData[data.sid].buyTimes = self.cashGiftData[data.sid].buyTimes + 1
            self.cashTimes[data.sid] = self.cashGiftData[data.sid].buyTimes
        end
        if self.mallCall then
            self.mallCall()
            self.mallCall = nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
        self.buyGiftId = nil
        self.sendBuy = false
        if self:CheckBuyAllGift() then
            self:CloseActivity()
        end
    end
end

