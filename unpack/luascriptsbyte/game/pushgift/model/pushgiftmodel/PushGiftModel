function PushGiftModel:GetFreeGift(callback)
    self.call = callback
    require "ActivitySynNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        { self.freeGiftData.sid },
        function(msg)
            self:UpdateData(msg)
        end
    )
end

function PushGiftModel:UpdateData(msg)
    if msg.ack ~= 1 then
        return
    end
    self.freeTimes = self.freeTimes + 1
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonAwardView.Name,
        msg,
        function()
            require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
            if self.call then
                self.call()
                self.call = nil
            end
        end
    )
end

function PushGiftModel:CheckThemeActivityIsOpen()
    return self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Close
end

function PushGiftModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

function PushGiftModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检测红点
function PushGiftModel:CheckRedPoint()
    if self.GiftType == 1 then
        return self.isFirst and 1 or 0
    elseif self.GiftType == 2 then
        if self.isFirst then
            return 1
        else
            return self.freeTimes == 0 and 1 or 0
        end
    elseif self.GiftType == 5 or self.GiftType == 6 or self.GiftType == 7 then
        if self.isFirst then
            return 1
        else
            return self.freeTimes == 0 and 1 or 0
        end
    end
    return 0
end

---刷新奖励红点
function PushGiftModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function PushGiftModel:SetTimerTb(tb)
    self.MainTimerTb = tb
    self.residueTime = self.endTime - TimeUtil.GetServerUnixTime()
    self.MainTimerTb.aortext_time:SetActiveE(1)
    self.MainTimerTb.aortext_time.text = TimeUtil.TimeToString(self.residueTime, 1)
    self:StopMainTimer()
    self.MainTimer = _G.TimerManager:GetInstance():GetTimer(1, self.TimeCutDown, self, false, false, true)
    self.MainTimer:Start()
end

function PushGiftModel:TimeCutDown(elapsed)
    self.residueTime = self.residueTime - elapsed
    if self.residueTime <= 0 or not self.MainTimerTb then
        self:StopMainTimer()
    end
    self.MainTimerTb.aortext_time.text = TimeUtil.TimeToString(Mathf.RoundToInt(self.residueTime), 1)
end

function PushGiftModel:StopMainTimer()
    if self.MainTimer then
        self.MainTimer:Stop()
        self.MainTimer = nil
    end
end

function PushGiftModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eCertificateMall.Parsed, self.CheckIsHasAllGwSkin, self)
end

return PushGiftModel
