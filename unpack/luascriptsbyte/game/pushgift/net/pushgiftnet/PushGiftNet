local base = require("BaseGameNet")

---@class PushGiftNet : BaseGameNet	通信协议
local PushGiftNet = _G.BaseClass("PushGiftNet", base)
---@return PushGiftNet PushGiftNet
function PushGiftNet:GetInstance()
    return base.GetInstance(self)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function PushGiftNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PushGiftNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return PushGiftNet
