local ActivitySynManager = require "ActivitySynManager"
---@class PushSkinGiftView : UIBaseView    中文描述
---@field public go_table PushSkinGiftView_GoTable GoTable
local PushSkinGiftView = _G.BaseClass("PushSkinGiftView", _G.UIBaseView)

function PushSkinGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---界面的入口函数
function PushSkinGiftView:OnCreate(data, type_enum)
    --self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, data:GetJumpType())
    self.activity = data
    self.ActivityID = data.activityID
    self:UpdateView(data, type_enum)
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    data.typeClass:ChangeLoginRed()
    self:XianShiTiem()
end

---显示时间更新
function PushSkinGiftView:XianShiTiem()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateTime(0)
end

function PushSkinGiftView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    self.go_table.aortext_time.text = _G.GetLangPackValue(90027600008, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.time))
    if self.time <= 0 then
        self:Close()
    end
end

---刷新
function PushSkinGiftView:UpdateView(data, type_enum)
    data.typeClass:UpdateDynamicData(self.ActivityID)
    self.model_data = data.typeClass:GetModelCfgByCondition(self.ActivityID)
    self.typeClass = data.typeClass
    self.data = data
    if type_enum then
        self.type_enum = type_enum
    else
        self.type_enum = 1
    end
    self:SetItemView()
end

function PushSkinGiftView:SetItemView()
    self:UpdateCommonItem(self.model_data[1])
end

---@param data activity_cash_gift.i_cash_gift
function PushSkinGiftView:UpdateCommonItem(data)
    local exchangeShow = self.typeClass.curActivityClass.cfg.info.front.exchange_show
    self.lhPath = _G.string.split(exchangeShow.pos, "#")
    if exchangeShow.dev then
        local dev = _G.string.split(exchangeShow.dev, "#")
        self.lhSpinePos = { dev[1], dev[2], dev[3], dev[4] }
        self.lhEffectPos = { dev[5], dev[6], dev[7], dev[8] }
    end
    ---标题
    self.go_table.aorrawimage_title:LoadImage(
        self.lhPath[2],
        function(tran)
            if self:IsNil() then
                return
            end
            tran:SetNativeSize()
            --local pos = self.holidayData.pos_portrait1[1]
            --if pos then
            --    tran:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
            --    tran:SetLocalScaleXYZ(pos[4] or 1)
            --end
        end
    )
    ---背景
    self.go_table.aorrawimage_bg:LoadImage(
        self.lhPath[1],
        function(tran)
            if self:IsNil() then
                return
            end
            tran:SetNativeSize()
            --local pos = self.holidayData.pos_portrait1[1]
            --if pos then
            --    tran:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
            --    tran:SetLocalScaleXYZ(pos[4] or 1)
            --end
        end
    )
    ---spine
    if not self.lastSpinePath or self.lastSpinePath ~= self.lhPath[3] then
        if self.spine and self.spine ~= true then
            _G.PoolsManager:GetInstance():Despawn(self.spine, _G.ePoolType.UIEffect)
        end
        self.lastSpinePath = self.lhPath[3]
        _G.UIUtils.LoadEffectByPath(
            self.lhPath[3],
            self.go_table.obj_spine,
            function(trans)
                if self:IsNil() or self.lastSpinePath ~= self.lhPath[3] then
                    _G.PoolsManager:GetInstance():Despawn(self.spine, _G.ePoolType.UIEffect)
                    return
                end
                local pos = self.lhSpinePos
                if pos then
                    trans:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
                    trans:SetLocalScaleXYZ(pos[4] or 1)
                end
                self.spine = trans
            end
        )
    end
    ---effect
    if not self.lastEffectPath or self.lastSplastEffectPathinePath ~= self.lhPath[4] then
        if self.effect and self.effect ~= true then
            _G.PoolsManager:GetInstance():Despawn(self.effect, _G.ePoolType.UIEffect)
        end
        self.lastEffectPath = self.lhPath[4]
        _G.UIUtils.LoadEffectByPath(
            self.lhPath[4],
            self.go_table.obj_effect,
            function(trans)
                if self:IsNil() or self.lastEffectPath ~= self.lhPath[4] then
                    _G.PoolsManager:GetInstance():Despawn(self.effect, _G.ePoolType.UIEffect)
                    return
                end
                local pos = self.lhEffectPos
                if pos then
                    trans:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
                    trans:SetLocalScaleXYZ(pos[4] or 1)
                end
                self.effect = trans
            end,
            nil,
            nil,
            nil,
            nil,
            nil,
            true
        )
    end

    self.go_table.aortext_name.text = data.name
    if data.price == 0 then
        self.go_table.aortext_price.text = ""
        self.go_table.aortext_price.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        _G.GameUtil.SetPriceByChannel(data.price, self.go_table.aortext_price)
    else
        self.go_table.aortext_price.text = data.price
    end
    local awrad = data.goods
    self.go_table.obj_AwardNode:RemoveAllChildren()
    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awrad[j],
            self.go_table.obj_AwardNode,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
            end
        )
    end
end

function PushSkinGiftView:OnMallCashListener(data)
    if not self.typeClass:CheckOtherConditionExtra() then
        self.data:ChangeState(1) -- 改变状态 关闭
    end
end

---界面的销毁函数
function PushSkinGiftView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---按钮点击事件在这里派发
function PushSkinGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        if not self.data:CheckActivityInteractable() then
            return
        end
        self.typeClass:Chongzhi(
            self.model_data[1],
            function()
                if self:IsNil() then
                    return
                end
                --这里保留一个回调处理领奖
                self:SetItemView()
                --self.typeClass:ChangeLoginRed()
                self.typeClass:CheckState()
                self:Close()
            end
        )
    end
end

return PushSkinGiftView
