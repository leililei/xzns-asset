local awardBG = {
    [1] = "ui_nszl_lv_frame",
    [2] = "ui_nszl_lv_frame",
    [3] = "ui_nszl_lan_frame",
    [4] = "ui_nszl_zi_frame",
    [5] = "ui_nszl_cheng_frame",
    [6] = "ui_nszl_hong_frame",
    [7] = "ui_nszl_jin_frame",
    [8] = "ui_nszl_cai_frame",
}

local base = require("PushGiftView")
---@class PushGWGiftView : PushGiftView	中文描述
---@field public go_table PushGWGiftView_GoTable GoTable
local PushGWGiftView = _G.BaseClass("PushGWGiftView", base)

function PushGWGiftView:OnCreate(data)
    self.giftList = {}
    base.OnCreate(self, data)
    if self:CheckClose() then
        self:Close()
        return
    end
    for k, v in pairs(self.giftIdList) do
        self.giftList[k] = _G.InstantiateObject(self.go_table.aorimage_gift, self.go_table.obj_giftList):GetComponentE(
        _G.typeof(_G.CS.AorImage))
        self.giftList[k].SpriteName = "ui_zhaomu_xingliang"
    end
    self.giftList[1].SpriteName = "ui_xszm_lb_xing"
end

function PushGWGiftView:InitData()
    self.gwSid = {}
    local sidDic = {}
    local count = #self.giftIdList
    for i = count, 1, -1 do
        local data = self.cashGiftData[self.giftIdList[i]]
        local gwSid
        for _, item in pairs(data.award) do
            local id = item.type[1]
            if _G.ConfigManager.item_cfg[id] and _G.ConfigManager.item_cfg[id].Type1 == 24 then
                gwSid = id
            end
        end
        if gwSid then
            local skinId = _G.tonumber(_G.ConfigManager.item_cfg[gwSid].UseParameter[1][1])
            if require("ArtifactIllustrationModel"):GetInstance():CheckIsHasSkinBySid(skinId) then
                _G.table.remove(self.giftIdList, i)
            else
                sidDic[i] = gwSid
            end
        end
    end
    for i = 1, count do
        if sidDic[i] then
            _G.table.insert(self.gwSid, sidDic[i])
        end
    end
end

function PushGWGiftView:RefreshView()
    self:InitData()
    if self:CheckClose() then
        self:Close()
        return
    end
    local id = self.giftIdList[self.selectIndex]
    self.data = self.cashGiftData[id]
    if self.selectIndex == 1 then
        self.go_table.aorbtn_L:SetActiveE(0)
    else
        self.go_table.aorbtn_L:SetActiveE(1)
    end
    if self.selectIndex == _G.table.count(self.giftIdList) then
        self.go_table.aorbtn_R:SetActiveE(0)
    else
        self.go_table.aorbtn_R:SetActiveE(1)
    end
    
    for k, v in pairs(self.giftList) do
        if not self.giftIdList[k] then
            _G.DestroyImmediate(self.giftList[k])
            self.giftList[k] = nil
        else
            v.SpriteName = k == self.selectIndex and "ui_xszm_lb_xing" or "ui_zhaomu_xingliang"    
        end
    end
    local gwSid = self.gwSid[self.selectIndex]
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_award" .. i], _G.handlerbind(self, self.OnAwardClick, i))
        if not self.data.award[i] then
            item.gameObject:SetActiveE(0)
        else
            item.gameObject:SetActiveE(1)
            local award = self.data.award[i].type
            item.aortext_num.text = award[2]
            item.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(award[1]))
            item.aorimage_bg.SpriteName = awardBG[_G.StorageManager:GetInstance():GetItemGrade(award[1], 0)]
        end
    end
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.data.name)
    _G.GameUtil.SetPriceByChannel(self.data.price, self.go_table.aortext_charge)
    self.skinId = nil
    if gwSid then
        self.skinId = _G.tonumber(_G.ConfigManager.item_cfg[gwSid].UseParameter[1][1])
        local skinCfg = _G.ConfigManager.artifact_skin_cfg[self.skinId]
        local artifactCfg = _G.ConfigManager.artifact_cfg[skinCfg.card]
        self.go_table.aorrawimage_icon:LoadImage(artifactCfg.image_1, function(trans)
            if self:IsNil() or not trans then
                return
            end
            trans:SetNativeSize()
        end)
        if skinCfg and skinCfg.skin_id ~= 0 then
            self.go_table.obj_spine:ClearChildren()
            _G.PoolsManager:GetInstance():Spawn(
                _G.ConfigManager.skin_cfg[skinCfg.skin_id].spine[1],
                _G.ePoolType.Temporary,
                self.go_table.obj_spine,
                function(obj)
                    if self:IsNil() then
                        _G.PoolsManager:GetInstance():Despawn(obj, _G.ePoolType.Temporary)
                        return
                    end
                    if self.go_table.obj_spine:GetChildCountE() > 1 then
                        local count = self.go_table.obj_spine:GetChildCountE()
                        for i = count - 2, 0, -1 do
                            _G.DestroyObject(self.go_table.obj_spine:GetChildE(i))
                        end
                    end
                    _G.UIUtils.LoadArtifacteffect(obj, nil, self.skinId, 3)
                end
            )
        end
    end
end

function PushGWGiftView:OnAwardClick(_, _, i)
    if self.data.award[i] then
        require("CommonTipManager"):GetInstance():OpenTip(self.gameObject, self.data.award[i].type[1])
    end
end

function PushGWGiftView:TimeCutDown()
    if self.data ~= nil then
        self.Times = self.typeClass:GetActivityEndTime() - _G.TimeUtil.GetServerUnixTime()
        self.go_table.aortext_time.text =
            _G.GetLangPackValue(90000010360, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.Times))
        self:Stop_CloseTimer()
        self.Timers = _G.TimerManager:GetInstance():GetTimer(1, self.ShowTime, self, false, false, true)
        self.Timers:Start()
    end
end

function PushGWGiftView:ShowTime(elapsed)
    self.Times = self.Times - elapsed
    self.go_table.aortext_time.text =
        _G.GetLangPackValue(90000010360, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.Times))
    if self.Times <= 0 then
        self:CloseView()
    end
end

function PushGWGiftView:CheckClose()
    local isComplete = _G.table.isEmptyOrNil(self.giftIdList)
    if isComplete then
        self.typeClass:CloseActivity()
    end
    return isComplete
end

function PushGWGiftView:OnClickBtn(go)
    base.OnClickBtn(self, go)
    if go == self.go_table.aorbtn_L then
        local selectIndex = _G.math.max(1, self.selectIndex - 1)
        self:OnClickToggle(_, _, nil, selectIndex)
    elseif go == self.go_table.aorbtn_R then
        local selectIndex = _G.math.min(_G.table.count(self.giftIdList), self.selectIndex + 1)
        self:OnClickToggle(_, _, nil, selectIndex)
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1033)
    end
end

function PushGWGiftView:BuyGift()
    if require("CardCommentManager"):GetInstance():CheckSkin(_G.ConfigManager.artifact_skin_cfg[self.skinId].skin_id) then
        local giftData = {}
        local Price_id = self.data.price
        giftData.price = Price_id
        giftData.sid = self.data.sid
        giftData.activityId = self.activityID
        self.typeClass:BuyGift(
            giftData,
            function()
                _G.Events:GetInstance():Broadcast(_G.eCertificateMall.Buy, { 10, self.gwSid[self.selectIndex]})
                if self.typeClass:CheckBuyAllGift() then
                    self:Close()
                    return
                end
                local buyData = self.cashGiftData[self.giftIdList[self.selectIndex]]
                if buyData.buyTimes >= buyData.count then
                    --页签
                    self.selectIndex = 1
                end
                self:GetTabData()
                self:GetGiftData()
                self:RefreshView()
            end
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(271802)
    end
end


function PushGWGiftView:InitGodHalo()
end

function PushGWGiftView:LoadSpine()
end

return PushGWGiftView
