local PushGiftView = _G.BaseClass("PushGiftView", _G.UIBaseView)
local imagePath = "Images/nPushgift/"
function PushGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local orderDic = {
    [1] = "ui_js_b_icon",
    [2] = "ui_js_a_icon",
    [3] = "ui_js_s_icon",
    [4] = "ui_js_splus_icon",
    [5] = "ui_js_splus_icon",
    [6] = "ui_js_splus_icon"
}

---界面的入口函数
---@param data PushGiftModel
function PushGiftView:OnCreate(data)
    self.typeClass = data.typeClass
    self.activityID = data.activityID
    self.cashGiftData = self.typeClass.cashGiftData
    self.holidayData = _G.ConfigManager.store_holiday_cfg[self.typeClass.sid]
    self.selectIndex = 1
    self.isNoPrompts = 0

    self:InitAnimation()
    self:InitGmData()
    self:InitNoPrompts()
    self:GetTabData()
    self:GetGiftData()
    self:TimeCutDown()
    self:RefreshView()

    if self.holidayData.style == 1 then
        self:InitGodHalo()
    end
    if _G.CS.Launcher.Inst.IsSDK then
        local json =
            _G.Table2Json(
                {
                    role_uid = _G.PlayerModel:GetInstance().role_uid,
                    role_level = _G.PlayerModel:GetInstance():GetLevel(),
                    role_vip = _G.PlayerModel:GetInstance().vipLv,
                    server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                    channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                    phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                    user_type = 1,
                    record_time = _G.TimeUtil.GetServerUnixTime(),
                    gift_id = data.activityID
                }
            )
        if _G.AppSetting.DEBUG then
            _G.Log(json, "进入推送礼包界面打点")
        end
        _G.SDKManager:GetInstance():DoShushuData_track("enter_pushgift_interface", json)
    end
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
end

function PushGiftView:InitGodHalo()
    self.QuilityIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_jn_icon_shishi",
        [_G.SpoilsQuilty.hong] = "ui_jn_icon_chuanshuo",
        [_G.SpoilsQuilty.cai] = "ui_jn_icon_shenghua"
    }
    local godHaloCfg
    local data = _G.string.split(self.typeClass.curActivityClass.cfg.info.front.precast, "#")

    for i = 1, #self.data.award do
        local cfg = _G.ConfigManager.god_halo_cfg[self.data.award[i].type[1]]
        if cfg then
            godHaloCfg = cfg
            break
        end
    end

    if data then
        self.go_table.aorrawimage_norole:SetLocalScaleXYZ(data[4])
        self.go_table.aorrawimage_norole:SetLocalPosition(data[1], data[2], data[3])
    end

    self.go_table.aortext_Name.text = _G.GetLangPackValue(godHaloCfg.name)
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_Name, godHaloCfg.grade)

    if self.go_table.aorrawimage_norole:GetChildCountE() > 0 then
        for i = 1, self.go_table.aorrawimage_norole:GetChildCountE() do
            _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
        end
    end
    local effCfg = godHaloCfg.ui_effect_cfg
    --- 神环路径，父级路径(加载角色的下面)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[effCfg],
        self.go_table.aorrawimage_norole.gameObject,
        function()
            --- 跳转时重复加载处理
            if self.go_table.aorrawimage_norole:GetChildCountE() > 1 then
                _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
            end
        end
    )

    for i = 1, 2 do
        local tb = _G.GetAutoGoTable(self.go_table["aorimage_MidBG" .. i])

        if #godHaloCfg.halo_effect >= i then
            local effectCfg =
                _G.ConfigManager.god_halo_effect_cfg[godHaloCfg.halo_effect[i]]
            tb.aorrawimage_skillIcon2:LoadImage(effectCfg.skill_icon)
            tb.aortext_skillName2.text = _G.GetLangPackValue(effectCfg.skill_name)
            tb.aortext_skillDesc.text = _G.GetLangPackValue(effectCfg.skill_describe)
            tb.aorimage_nameGrade2.SpriteName = self.QuilityIcon[effectCfg.grade]

            self.go_table["aorimage_MidBG" .. i]:SetActiveE(1)
        else
            self.go_table["aorimage_MidBG" .. i]:SetActiveE(0)
        end
    end
end

function PushGiftView:InitAnimation()
    if _G.AppSetting.IsXzns and self.holidayData.style == 2 then
        local canvasGroup = self.go_table.obj_Info:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
        self.go_table.obj_Info:SetActiveE(0)
        canvasGroup.alpha = 0
        _G.PoolsManager:Spawn(
            "WX_Role/Animation_UI/Lachaunglian_UI/prf_Lachaunglian_UI_ui",
            _G.ePoolType.UIItem,
            self.go_table.obj_Curtains,
            function(trans)
                local delayTime = 2
                local sg = trans:GetComponentInChildrenE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                _G.DelayDo(delayTime, function()
                    if not self.go_table then
                        return
                    end
                    sg.AnimationState:SetAnimation(0, "Lachuanglian_2", false)
                    _G.DelayDo(1, function()
                        if not self.go_table then
                            return
                        end
                        self.go_table.obj_Curtains:SetActiveE(0)
                        self.go_table.obj_Info:SetActiveE(1)
                        canvasGroup:DOFade(1, 0.3):SetEase(_G.CS.DG.Tweening.Ease.Linear)
                    end)
                end)
            end
        )
    end
end

function PushGiftView:InitGmData()
    if self.typeClass.curActivityClass.cfg.info.front.precast then
        local data = _G.string.split(self.typeClass.curActivityClass.cfg.info.front.precast, "#")
        self.loadSpinePath = data[1]
        self.spineLosPos = {
            x = tonumber(data[2]),
            y = tonumber(data[3]),
            z = tonumber(data[4]),
        }
        self.spineScale = tonumber(data[5])
    end
end

function PushGiftView:InitNoPrompts()
    self.isNoPrompts = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.PushGiftViewTip, 0)
    if self.isNoPrompts == 0 then
        return
    end
    local time = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.PushGiftViewTime, 0)
    local nowtime = TimeUtil.GetServerUnixTime()
    if time and time ~= 0 then
        time = TimeUtil.GetDayBegin(time)
        local left = nowtime - time
        if left > 0 then
            if left >= 86400 then
                self.isNoPrompts = 0
            end
        end
    else
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.PushGiftViewTime, nowtime)
    end
end

---获取页签数据
function PushGiftView:GetTabData()
    self.giftIdList = {}
    for _, v in pairs(self.cashGiftData) do
        if v.buyTimes < v.count then
            _G.table.insert(self.giftIdList, v.sid)
        end
    end
    _G.SortList(
        self.giftIdList,
        function(item)
            return -item
        end
    )

    if #self.giftIdList == 2 then
        self.go_table.obj_Viewport:SetLocalPosition(-160, 42)
        self.go_table.obj_Viewport:SetRectTransformSize(-170, 84)
    else
        self.go_table.obj_Viewport:SetLocalPosition(-250, 42)
        self.go_table.obj_Viewport:SetRectTransformSize(0, 84)
    end
end

---初始化数据
function PushGiftView:GetGiftData()
    local id = self.giftIdList[self.selectIndex]
    self.data = self.cashGiftData[id]
    local count = #self.data.award
    self.curCardId = nil
    self.curSkinId = nil
    for i = 1, count do
        local itemcfg = ConfigManager.item_cfg[self.data.award[i].type[1]]
        if itemcfg and table.isEmptyOrNil(itemcfg.UseParameter) == false then
            local skinSid = tonumber(itemcfg.UseParameter[1][1])
            local skincfg = ConfigManager.skin_cfg[skinSid]
            if skincfg then
                self.curCardId = skincfg.card
                self.curSkinId = skinSid
            end
        end
    end
end

---界面的销毁函数
function PushGiftView:OnDestroy()
    self:Stop_CloseTimer()
end

function PushGiftView:LoadSpine(spinePath, isSetPos, x, y, z, scale)
    _G.PoolsManager:GetInstance():Spawn(
        spinePath,
        _G.ePoolType.Temporary,
        self.go_table.obj_spine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            --配置里没有sid，根据路径反向查找
            local cfgList = _G.ConfigManager.skin_cfg
            local sid
            for _, v in pairs(cfgList) do
                if v.ModelPathHi == spinePath then
                    sid = v.id
                end
            end
            GameUtil.SetCardUiSpineAnimation(trans, "idle", true, sid)
            if isSetPos then
                trans:SetLocalPosition(x or 0, y or 0, z or 0)
                trans:SetLocalScaleXYZ(scale or 1)
            end
        end
    )
    self.lastSpinePath = spinePath
end

function PushGiftView:InitText()
    ---策划说了折扣不会出现除了10以内整数的其他情况(如1.5、8.8等)
    if self.holidayData then
        local rawimages = self.holidayData.store_Image
        self.go_table.aorrawimage_title:LoadImage(
            rawimages[1],
            function(tran)
                if self:IsNil() then
                    return
                end
                --tran:SetNativeSize()
                local pos = self.holidayData.pos_portrait1[1]
                if pos then
                    tran:SetLocalPosition(pos[1] or 0, pos[2] or 0, pos[3] or 0)
                    tran:SetLocalScaleXYZ(pos[4] or 1)
                end
            end
        )

        if not self.lastSpinePath and self.lastSpinePath ~= self.loadSpinePath and self.loadSpinePath ~= nil then
            self:LoadSpine(self.loadSpinePath, true, self.spineLosPos.x, self.spineLosPos.y, self.spineLosPos.z,
                self.spineScale)
        elseif not self.lastSpinePath or self.lastSpinePath ~= rawimages[2] then
            if self.holidayData.pos_portrait1[2] then
                local pos = self.holidayData.pos_portrait1[2]
                self:LoadSpine(rawimages[2], true, pos[1], pos[2], pos[3], pos[4])
            else
                self:LoadSpine(rawimages[2])
            end
        end
        self.go_table.aortext_tip.text = _G.GetLangPackValue(self.holidayData.subtitle[1])
    end
    --self.go_table.aorimage_num.SpriteName = "ui_hd_tslbtc_txt_" .. math.modf(self.data.discount / 1000)
    --self.go_table.aorimage_num:SetNativeSize()
    local numresult = self.data.discount / 1000
    local result = string.format("%.1f", numresult)
    local zs, xs = math.modf(numresult)
    if _G.AppSetting.DEBUG then
        _G.Log(result, "折扣结果")
        _G.Log(zs, "整数部分")
        _G.Log(xs, "小数部分")
    end
    if xs >= 0.1 then
        self.go_table.aortext_num.text = tonumber(result)
    else
        self.go_table.aortext_num.text = tonumber(zs)
    end
    --ZHJH-10440 中英文图片资源大小不同，需要加载后手动设置原图大小
    self.go_table.aorimage_discount:LoadAtlasSprite(
        "AtlasH5/hPushGift_Language/hPushGift_LanguageAtlas",
        "ui_hd_tslbtc_txt_zhe",
        1,
        function(img)
            img:SetNativeSize()
        end
    )
    self.go_table.aorimage_discount:SetNativeSize()
    _G.GameUtil.SetPriceByChannel(self.data.price, self.go_table.aortext_charge)
    self.go_table.aortext_limited.text = _G.GetLangPackValue(90023800079, self.data.buyTimes, self.data.count)
end

function PushGiftView:TimeCutDown()
    if self.data ~= nil then
        self.Times = self.typeClass:GetActivityEndTime() - _G.TimeUtil.GetServerUnixTime()
        self.go_table.aortext_time.text =
            _G.GetLangPackValue(90020800048, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.Times))
        self:Stop_CloseTimer()
        self.Timers = _G.TimerManager:GetInstance():GetTimer(1, self.ShowTime, self, false, false, true)
        self.Timers:Start()
    end
end

function PushGiftView:ShowTime(elapsed)
    self.Times = self.Times - elapsed
    self.go_table.aortext_time.text =
        _G.GetLangPackValue(90020800048, _G.TimeUtil.TranslateSecondForDHMOrHMS(self.Times))
    if self.Times <= 0 then
        self:CloseView()
    end
end

function PushGiftView:Stop_CloseTimer()
    if self.Timers ~= nil then
        self.Timers:Stop()
        self.Timers = nil
    end
end

---按钮点击事件在这里派发
function PushGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_buy then
        self:BuyGift()
    elseif go == self.go_table.aorbtn_noPrompts then
        if self.isNoPrompts == 0 then
            self.isNoPrompts = 1
        else
            self.isNoPrompts = 0
        end
        self:SaveNoPrompts()
        self:RefreshNoPromptsNode()
    elseif go == self.go_table.aorbtn_godHaloShow then
        local data
        for i = 1, #self.data.award do
            local cfg = _G.ConfigManager.god_halo_cfg[self.data.award[i].type[1]]
            if cfg then
                data = cfg
                break
            end
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloShowView.Name, data, nil, nil, nil, nil,
            true)
    elseif go == self.go_table.aorbtn_Wenhao and self.curCardId then
        --- 获取卡牌数据 查找此皮肤是否已经挂载在卡牌上了
        local cardData = require("CardData").GetPreviewData(self.curCardId)
        local skinList = cardData.cfg.skin
        local show = #skinList > 0 and cardData.type ~= _G.CardType.Timer
        local haveSkin = false
        if show then
            for i = 1, #skinList do
                if skinList[i] == self.curSkinId then
                    haveSkin = true
                end
            end
        end

        if haveSkin then
            cardData:SetSkin(0)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CardShowView.Name,
                { CardData = cardData },
                nil,
                true,
                nil,
                self.curSkinId
            )
        end
    end
end

function PushGiftView:SaveNoPrompts()
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.PushGiftViewTip, self.isNoPrompts)
    if self.isNoPrompts == 1 then
        local nowtime = TimeUtil.GetServerUnixTime()
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.PushGiftViewTime, nowtime)
    end
end

function PushGiftView:CreatEffect()
end

function PushGiftView:CloseView()
    self:Stop_CloseTimer()
    self:Close()
end

function PushGiftView:EscClose()
    self:CloseView()
end

function PushGiftView:BuyGift()
    local giftData = {}
    local Price_id = self.data.price
    giftData.price = Price_id
    giftData.sid = self.data.sid
    giftData.activityId = self.activityID
    self.typeClass:BuyGift(
        giftData,
        function()
            if self.typeClass:CheckBuyAllGift() then
                self:Close()
                return
            end

            local buyData = self.cashGiftData[self.giftIdList[self.selectIndex]]
            if buyData.buyTimes >= buyData.count then
                --页签
                self.selectIndex = 1
            end
            self:GetTabData()
            self:GetGiftData()
            self:RefreshView()
        end
    )
end

function PushGiftView:RefreshView()
    if self.holidayData.style ~= 1 then
        self:InitText()
    else
        _G.GameUtil.SetPriceByChannel(self.data.price, self.go_table.aortext_charge)
    end
    self.go_table.aortext_limited.text = _G.GetLangPackValue(90023800079, self.data.buyTimes, self.data.count)

    ---礼包商品item
    local count = #self.data.award
    if not self.itemListView then
        self.go_table.scrollloophorizontal_item:InitItemData(count, _G.handler(self, self.RefreshItem))
        self.itemListView = self.go_table.scrollloophorizontal_item
    else
        self.itemListView:UpdateCount(count)
    end
    self.itemListView:UpdateScrollRectWeight(_G.Mathf.Min(count, 4) * 128)

    ---页签
    local tabCount = #self.giftIdList
    self.go_table.scrollloophorizontal_toggle:SetActiveE(tabCount > 1 and 1 or 0)
    if tabCount > 1 then
        if not self.toggleListView then
            self.go_table.scrollloophorizontal_toggle:InitItemData(tabCount, _G.handler(self, self.RefreshToggleItem))
            self.toggleListView = self.go_table.scrollloophorizontal_toggle
        else
            self.toggleListView:UpdateCount(tabCount)
        end
        local minCount = _G.Mathf.Min(count, 3)
        self.toggleListView:UpdateScrollRectWeight(minCount * 150 + (minCount - 1) * 20)
    end

    if AppSetting.IsXzns and self.holidayData.style == 2 then
        self:RefreshNoPromptsNode()
        if self.curCardId then
            local cardcfg = ConfigManager.card_cfg[self.curCardId]
            self.go_table.aortext_Name.text = GetLangPackValue(cardcfg.Name)
            self.go_table.aorimage_Orderzi.SpriteName = orderDic[cardcfg.Order]
        end
    end
end

function PushGiftView:RefreshNoPromptsNode()
    self.go_table.obj_selectIcon:SetActiveE(self.isNoPrompts)
end

function PushGiftView:RefreshItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local data = self.data.award[index + 1]
    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data.type,
        tb.obj_root,
        function(tran)
            if _G.IsNil(tb.obj_root) then
                _G.DestroyObject(tran.gameObject)
                return
            end
            tran.gameObject:SetLocalScaleXYZ(1)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if tran.SetGradeNew then
                tran:SetGradeNew()
            end
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.type[1])
        end
    )
end

function PushGiftView:RefreshToggleItem(index, obj)
    local nIndex = index + 1
    local id = self.giftIdList[nIndex]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickToggle, id, nIndex))

    local data = self.cashGiftData[id]
    local price = _G.Mathf.Floor(data.price / 100)
    tb.aortext_off.text = _G.GetLangPackValue(90000010819, price)
    tb.aortext_on.text = _G.GetLangPackValue(90000010819, price)
    tb.aorimage_isOff:SetActiveE(self.selectIndex == nIndex and 0 or 1)
    tb.aorimage_isOn:SetActiveE(self.selectIndex == nIndex and 1 or 0)
end

function PushGiftView:OnClickToggle(_, _, id, index)
    if self.selectIndex == index then
        return
    end
    self.selectIndex = index
    self:GetGiftData()
    self:RefreshView()
end

return PushGiftView
