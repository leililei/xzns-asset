---@class HolidayGiftView : UIBaseView	中文描述
---@field public go_table HolidayGiftView_GoTable GoTable
local HolidayGiftView = _G.BaseClass("HolidayGiftView", _G.UIBaseView)
local imagePath = "Images/nPushgift/"
local path = "UI/UI_effect/PushGiftView_effect/prefab/"
local StorageManager = _G.StorageManager:GetInstance()
local GetLangPackValue = _G.GetLangPackValue
local InstantiateObject = _G.InstantiateObject
local insert = _G.table.insert
local UIUtils = _G.UIUtils
local TimeUtil = _G.TimeUtil
local rawimages
local sprites
local strings
local effect
local time
function HolidayGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HolidayGiftView:OnCreate(curClass)
    _G.UIUtils.Set3DUICameraDepth(75)
    local scale = 1/_G.CS.Launcher.Inst.FovScale
    self.go_table.gameObject:SetLocalScaleXYZ(scale)
    self.buyCash = false
    self.getFree = false
    self.curActivityClass = curClass
    self.typeClass = curClass.typeClass
    self.freeGiftData = self.typeClass.freeGiftData
    self.cashGiftData = self.typeClass.cashGiftData
    self.freeTimes = self.typeClass.freeTimes
    self.cashTimes = self.typeClass.cashTimes
    self.freeGoTable = _G.GetAutoGoTable(self.go_table.obj_FreeGift)
    self.cashGoTable = _G.GetAutoGoTable(self.go_table.obj_CashGift)
    self.itemGoTable = _G.GetAutoGoTable(self.go_table.obj_item)
    local cfg = _G.ConfigManager.store_holiday_cfg
    self.holidayData = cfg[self.typeClass.sid]
    self:InitView()
    self:InitFreeGift()
    self:InitCashGift()
    self:TimeCutDown()
end

---初始化界面
function HolidayGiftView:InitView()
    if self.holidayData then
        rawimages = self.holidayData.store_Image
        sprites = self.holidayData.store_atlas
        strings = self.holidayData.subtitle
        effect = self.holidayData.store_eff
        if rawimages[1] ~= nil then
            self.go_table.aorrawimage_title:LoadImage(
              imagePath..rawimages[1],
              function(trans)
                trans:SetNativeSize()
                end)
        end
        if rawimages[2] ~= nil then
            self.go_table.aorrawimage_character:LoadImage(
              imagePath..rawimages[2],
              function(trans)
                trans:SetNativeSize()
                end)
        end
        if rawimages[3] ~= nil then
            self.go_table.aorrawimage_characterBG:LoadImage(
              imagePath..rawimages[3],
              function(trans)
                trans:SetNativeSize()
                end)
        end
        if rawimages[4] ~= nil then
            self.freeGoTable.aorrawimage_FreeGift:LoadImage(
                imagePath..rawimages[4],
                function(trans)
                  trans:SetNativeSize()
                end)
        end
        if rawimages[5] ~= nil then
            self.cashGoTable.aorrawimage_CashGift:LoadImage(
                imagePath..rawimages[5],
                function(trans)
                  trans:SetNativeSize()
                end)
        end
        self.go_table.aorimage_subtitle.SpriteName = sprites[1]
        self.go_table.aorimage_time.SpriteName = sprites[2]
        self.go_table.aorbtn_buyFree.targetGraphic.SpriteName = sprites[3]
        self.go_table.aorbtn_buyCash.targetGraphic.SpriteName = sprites[4]
        self.itemGoTable.aorimage_itemBG.SpriteName = sprites[5]
        self.itemGoTable.aorimage_nameBG.SpriteName = sprites[6]
        self.go_table.aortext_subtittle.text = GetLangPackValue(strings[1])
        time = strings[2]
        self.go_table.aortext_free.text = GetLangPackValue(strings[3])
        local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(self.cashGiftData.price)
        if info then
            self.go_table.aortext_cash.text = info.formattedPrice
        else
            local price = _G.GameUtil.RatioControl(self.cashGiftData.price)
            if _G.AppSetting.IsOverseas then
                self.go_table.aortext_cash.text = GetLangPackValue(strings[4],price)
            else
                self.go_table.aortext_cash.text = GetLangPackValue(strings[4],price)
            end
        end
        self:InitEffect()
    end
end

function HolidayGiftView:InitEffect()
    if effect[1] ~= "0" then
        self:LoadEffect(path..effect[1],self.go_table.obj_effect)
    end
    if effect[2] ~= "0" then
        self:LoadEffect(path..effect[2],self.go_table.obj_effect)
    end
end

function HolidayGiftView:LoadEffect(path,parent)
    UIUtils.LoadEffectByPath(path,
    parent,
    function(trans)
    end,
    nil,
    0,
    {0, 0, 0},
    1,
    0,
    true,
    false,
    0
    )
end

---初始化免费礼包
function HolidayGiftView:InitFreeGift()
    local award = self.freeGiftData.award
    local isBuy = self.freeTimes >= self.freeGiftData.count
    self.go_table.aorbtn_buyFree:SetGray(isBuy)
    if isBuy then
        self.go_table.aortext_free.color = _G.ColorTools.FormatColorByString("414141")
    else
        if effect[3] ~= "0" then
            self:LoadEffect(path..effect[3],self.go_table.aorbtn_buyFree)
        end
    end
    self.freeItem = {}
    for k,v in pairs(award) do
        local item = InstantiateObject(self.go_table.obj_item,self.freeGoTable["obj_item"..k])
        item:SetLocalPositionToZero()
        local tb = _G.GetAutoGoTable(item)
        tb.aorimage_itemBG:SetLocalPosition(-15,0,0)
        tb.aorimage_itemBG:SetLocalScale(-1,1,1)
        local itemdata = StorageManager:GetItemDataClassByCfg(v.type)
        local name = itemdata.cfg.Name or itemdata.cfg.name
        name = GetLangPackValue(name)
        tb.aortext_name.text = GetLangPackValue(strings[5],name)
        StorageManager:GetItemBaseViewNew(
        v.type,
        tb.obj_root,
        function(trans)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            trans:SetGou(isBuy)
            insert(self.freeItem,trans)
        end,
        function()
        end)
        if not isBuy and itemdata.cfg.ef_item == 1 then
            self:LoadEffect(
                path .. "ef_HolidayBagNewView_icon",
                tb.obj_root)
        end
    end
end

---初始化付费礼包
function HolidayGiftView:InitCashGift()
    local award = self.cashGiftData.award
    local isBuy = self.cashTimes >= self.cashGiftData.count
    self.go_table.aorbtn_buyCash:SetGray(isBuy)
    if isBuy then
        self.go_table.aortext_cash.color = _G.ColorTools.FormatColorByString("414141")
    else
        if effect[3] ~= "0" then
            self:LoadEffect(path..effect[3],self.go_table.aorbtn_buyFree)
        end
    end
    self.cashItem = {}
    for k,v in pairs(award) do
        local item = InstantiateObject(self.go_table.obj_item,self.cashGoTable["obj_item"..k])
        item:SetLocalPositionToZero()
        local tb = _G.GetAutoGoTable(item)
        local itemdata = StorageManager:GetItemDataClassByCfg(v.type)
        local name = itemdata.cfg.Name or itemdata.cfg.name
        name = GetLangPackValue(name)
        tb.aortext_name.text = GetLangPackValue(strings[5],name)
        StorageManager:GetItemBaseViewNew(
        v.type,
        tb.obj_root,
        function(trans)
            trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            trans:SetGou(isBuy)
            insert(self.cashItem,trans)
        end,
        function()
        end)
        if not isBuy and itemdata.cfg.ef_item == 1 then
            self:LoadEffect(
                path .. "ef_HolidayBagNewView_icon",
                tb.obj_root)
        end
    end
end

---界面的销毁函数
function HolidayGiftView:OnDestroy()
end

---按钮点击事件在这里派发
function HolidayGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_buyCash then
        if self.cashTimes >= self.cashGiftData.count then
            return
        end
        self.buyCash = true
        self:BuyGift()
    elseif go == self.go_table.aorbtn_buyFree then
        if self.freeTimes >= self.freeGiftData.count then
            return
        end
        self.getFree = true
        self.typeClass:GetFreeGift(_G.handler(self,self.UpdateView))
    elseif go == self.go_table.aorbtn_cash1 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.cashGiftData.award[1].type[1])
    elseif go == self.go_table.aorbtn_cash2 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.cashGiftData.award[2].type[1])
    elseif go == self.go_table.aorbtn_cash3 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.cashGiftData.award[3].type[1])
    elseif go == self.go_table.aorbtn_cash4 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.cashGiftData.award[4].type[1])
    elseif go == self.go_table.aorbtn_cash5 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.cashGiftData.award[5].type[1])
    elseif go == self.go_table.aorbtn_free1 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.freeGiftData.award[1].type[1])
    elseif go == self.go_table.aorbtn_free2 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.freeGiftData.award[2].type[1])
    elseif go == self.go_table.aorbtn_free3 then
        require("CommonTipManager"):GetInstance():OpenTip(go, self.freeGiftData.award[3].type[1])
    end
end

---计时器
function HolidayGiftView:TimeCutDown()
    if self.cashGiftData ~= nil then
        self.Times = self.cashGiftData.endTime - TimeUtil.GetServerUnixTime()
        self.go_table.aortext_time.text =GetLangPackValue(time,TimeUtil.TransDayHourMineMiaoPushGift(self.Times))
        self:Stop_CloseTimer()
        self.Timers =
            _G.TimerManager:GetInstance():GetTimer(
            1,
            self.ShowTime,
            --self.ShowTime,
            self,
            false,
            false,
            true
            -- self.go_table.aortext_timedown1
        )
        self.Timers:Start()
    end
end

---显示时间
function HolidayGiftView:ShowTime(elapsed)
    self.Times = self.Times - (elapsed or 1)
    self.go_table.aortext_time.text =GetLangPackValue(time,TimeUtil.TransDayHourMineMiaoPushGift(Mathf.RoundToInt(self.Times)))
    if self.Times <= 0 then
        self:CloseView()
    end
end

---停止倒计时
function HolidayGiftView:Stop_CloseTimer()
    if self.Timers ~= nil then
        self.Timers:Stop()
        self.Timers = nil
    end
end

---关闭界面
function HolidayGiftView:CloseView()
    _G.UIUtils.Set3DUICameraDepth(10)
    self:Stop_CloseTimer()
    self:Close()
end

---更新界面
function HolidayGiftView:UpdateView()
    if self.buyCash then
        self.cashTimes = self.cashTimes + 1
        for k,v in pairs(self.cashItem) do
            v:SetGou(true)
        end
        self.go_table.aorbtn_buyCash:SetGray(true)
        self.go_table.aortext_cash.color = _G.ColorTools.FormatColorByString("414141")
        if self.go_table.aorbtn_buyCash:GetChildCountE() > 2 then
            local item = self.go_table.aorbtn_buyCash:GetChildE(1)
            if item then
                item.gameObject:DestroyObject()
            end
        end
        self.buyCash = false
    elseif self.getFree then
        self.freeTimes = self.freeTimes + 1
        for k,v in pairs(self.freeItem) do
            v:SetGou(true)
        end
        self.go_table.aorbtn_buyFree:SetGray(true)
        self.go_table.aortext_free.color = _G.ColorTools.FormatColorByString("414141")
        if self.go_table.aorbtn_buyFree:GetChildCountE() > 2 then
            local item = self.go_table.aorbtn_buyFree:GetChildE(1)
            if item then
                item.gameObject:DestroyObject()
            end
        end
        self.getFree = false
    end
    self:RefreshView()
end

---购买礼包
function HolidayGiftView:BuyGift()
    local giftData = {}
    giftData.price = self.cashGiftData.price
    giftData.sid = self.cashGiftData.sid
    giftData.activityId = self.curActivityClass:GetActivityID()
    self.typeClass:BuyGift(
        giftData,
        function()
            self:UpdateView()
        end
    )
end

---刷新界面
function HolidayGiftView:RefreshView()
    if self.cashTimes >= self.cashGiftData.count and self.freeTimes >= self.freeGiftData.count then
        self:CloseView()
        self.typeClass:CloseActivity()
    end
end


return HolidayGiftView