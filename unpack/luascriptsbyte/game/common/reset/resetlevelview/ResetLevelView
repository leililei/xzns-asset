local ItemViewBase = require("ItemViewBase")
---@class ResetLevelView : UIBaseView	中文描述
---@field public go_table ResetLevelView_GoTable GoTable
local ResetLevelView = _G.BaseClass("ResetLevelView", _G.UIBaseView)

function ResetLevelView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ResetLevelView:OnCreate(itemData, callBack)
    self.itemData = itemData
    self.callBack = callBack
    self.StorageType = _G.StorageManager:GetInstance():CheckSidType(itemData.sid)
    ---重置资源返还比例(万分比)
    self.percentage = 10000
    if self.StorageType == _G.StorageType.Spiritual then
        self.percentage = _G.ConfigManager.discrete_cfg[114006][1][1]
    elseif self.StorageType ==  _G.StorageType.Artifact then
        self.percentage = _G.ConfigManager.discrete_cfg[101209][1][1]
    end
    self.percentage = _G.Mathf.Floor(self.percentage / 100)
    self:LoadItem()
    self:RestStar()
    self:RefreshView()
    self:ResetMaterial()
    self.go_table.toggle_resetStar.onValueChanged:AddListener(_G.handler(self, self.OnValueChanged))
end

function ResetLevelView:RestStar()
    self.go_table.toggle_resetStar:SetActiveE(self.StorageType == _G.StorageType.Spiritual and self.itemData.lv > 1 and 1 or 0)
    if self.StorageType == _G.StorageType.Spiritual then
        local resetStar = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SpiritualResetStar, 0)
        self.go_table.toggle_resetStar.isOn = resetStar == 1
    end
end

function ResetLevelView:OnValueChanged(isOn)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.SpiritualResetStar, isOn and 1 or 0)
    self:ResetMaterial()
end

function ResetLevelView:RefreshView()
    local titleStr, tipStr, resetTips = "", "", ""
    if self.StorageType == _G.StorageType.Spiritual then
        tipStr = _G.GetLangPackValue(90030900054, self.percentage .. "%")
        titleStr = _G.GetLangPackValue(90030900053)
        resetTips = _G.ConfigManager.discrete_cfg[114005][1][1]
    elseif self.StorageType ==  _G.StorageType.Artifact then
        tipStr = _G.GetLangPackValue(90022300123, self.percentage .. "%")
        titleStr = _G.GetLangPackValue(90022300122)
        resetTips = _G.ConfigManager.discrete_cfg[101208][1][1]
    end
    self.go_table.aortext_TitleName.text = titleStr
    self.go_table.aortext_tips.text = tipStr
    self.go_table.aortext_resetTips.text = resetTips
end

---加载item
function ResetLevelView:LoadItem()
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.itemData.sid,
        1,
        self.go_table.obj_Root,
        function(item)
            if _G.IsNil(self.go_table.obj_Root) then
               _G.DestroyObject(item.gameObject)
            end

            item:ShowData(self.itemData)
            item:HideCardBound()
        end
    )
end

---重置返还材料
function ResetLevelView:ResetMaterial()
    local costNum = 0
    local material
    self.oneselfMaterial = 0
    if self.StorageType == _G.StorageType.Spiritual then
        costNum = _G.ConfigManager.discrete_cfg[114005][1][1]
    elseif self.StorageType ==  _G.StorageType.Artifact then
        costNum = _G.ConfigManager.discrete_cfg[101208][1][1]
    end
    material, self.oneselfMaterial = self.itemData:GetResetMaterial()
    _G.SortList(
        material,
        function(a)
            local sid = a[1]
            local aStorageType = _G.StorageManager:GetInstance():CheckSidType(sid)
            local type = 0
            if aStorageType == _G.StorageType.Artifact or aStorageType == _G.StorageType.Spiritual then
                type = 2
            elseif aStorageType == _G.StorageType.Prop then
                type = 1
            end

            return type, _G.StorageManager:GetInstance():GetItemQuality(sid), sid
        end
    )

    local count = self.go_table.obj_item:GetChildCountE()
    for i = 1, count do
        local tran = self.go_table.obj_item:GetChildE(count - i)
        if tran then
            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
        end
    end

    for _, v in ipairs(material) do
        _G.StorageManager:GetInstance():GetItemBaseView(
            v[1],
            v[2],
            self.go_table.obj_item,
            function(item)
                if _G.IsNil(self.go_table.obj_item) then
                    _G.DestroyObject(self.go_table.obj_item)
                    return
                end

                if item.ShowNumText then
                    item:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
                end
            end
        )
    end

    ---消耗
    -- local icon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
    -- self.go_table.aorrawimage_costIcon:LoadImage(icon)
    -- if not _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Diamond, costNum) then
    --     self.go_table.aortext_costNum.text = "<color=#E33F3f>" .. costNum .. "</color>"
    -- else
    --     self.go_table.aortext_costNum.text = costNum
    -- end
end

---按钮点击事件在这里派发
function ResetLevelView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Close then
       self:Close()
    elseif go == self.go_table.aorbtn_Done then
        if self.StorageType == _G.StorageType.Artifact then
            local costNum = _G.ConfigManager.discrete_cfg[101208][1][1]
            if not _G.StorageManager:GetInstance():CheckItemNew(_G.ResPropID.Diamond, costNum) then
                _G.PopWindowManager:GetInstance():ShowAllTips(320112)
                return
            end

            if _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Artifact, self.oneselfMaterial) then
                ---本体仓库足够
                local ArtifactModel = require("ArtifactModel"):GetInstance()
                if self.itemData.cardUid and self.itemData.cardUid > 0 then
                    ---穿戴的神器需要脱下来
                    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(
                        _G.StorageID.Card,
                        self.itemData.cardUid
                    )
                    ArtifactModel:TakeOffArtifact(cardData, function()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArtifactDevelopView.Name)
                        ArtifactModel:ResetArtifact(self.itemData, function()
                            self:Close()
                        end)
                    end)
                else
                    ArtifactModel:ResetArtifact(self.itemData, function()
                        self:Close()
                    end)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(270801)
            end
        elseif self.StorageType == _G.StorageType.Spiritual then
            local costNum = _G.ConfigManager.discrete_cfg[114005][1][1]
            if not _G.StorageManager:GetInstance():CheckItemNew(_G.ResPropID.Diamond, costNum) then
                _G.PopWindowManager:GetInstance():ShowAllTips(320112)
                return
            end

            if _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Spiritual, self.oneselfMaterial) then
                ---本体仓库足够
                local SpiritualModel = require("SpiritualModel"):GetInstance()
                if self.itemData.cardUid and self.itemData.cardUid > 0 then
                    ---穿戴的灵契需要脱下来
                    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(
                        _G.StorageID.Card,
                        self.itemData.cardUid
                    )
                    SpiritualModel:TakeOffSpiritual(cardData, self.itemData, self.itemData.index, function()
                        --ZHJH-7683 如果在养成界面重置需要关闭养成界面
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SpiritualDevelopView.Name)
                        SpiritualModel:ResetSpiritual(self.itemData, function()
                            self:Close()
                        end)
                    end)
                else
                    SpiritualModel:ResetSpiritual(self.itemData, function()
                        self:Close()
                    end)
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(130303)
            end
        end
    end
end

function ResetLevelView:Dispose()
    if self.callBack then
        self.callBack()
    end
end

return ResetLevelView