---检测功能是否可以进入
function JumpManager:CheckLinkIsOpen(sid)
    local cfg = _G.ConfigManager.item_way_cfg[sid]
    if cfg then
        local count=#cfg.function_open
        if  count>= 3 then
            return  _G[cfg.function_open[1]][cfg.function_open[2]](ParseParam(cfg.function_open[3]))
        elseif count>=2 then
            return  _G[cfg.function_open[1]][cfg.function_open[2]]()
        end
    end
    return true
end

