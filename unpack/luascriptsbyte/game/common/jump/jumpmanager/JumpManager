---@class JumpManager : Singleton	中文描述
local JumpManager = _G.BaseClass("JumpManager", _G.Singleton)
_G.JumpManager = JumpManager

local jumpType = {
    view = 1,
    func = 2,
    activity = 3,
    complex = 4,
}

---@return JumpManager JumpManager
function JumpManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function JumpManager:__init()
    self.IsJumping = false
end

---销毁对象时,析构函数
function JumpManager:Dispose()
    self.callback = nil
    self.curViewName = nil
end
--region 内部方法

---接收上个界面打开消息
function JumpManager:OnViewOpened(name)
    if name ~= self.curViewName then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    self.curJumpIndex = self.curJumpIndex + 1
    self:JumpStep(nil)
end

---解析参数，判断是number类型还是string类型
local ParseParam = function(param)
    local tmp = tonumber(param)
    if tmp then
        return tmp
    else
        return param
    end
end

---使用uimanager打开
function JumpManager:JumpView(jumpTopWindowName)
    local cfg = self.cfg.link[self.curJumpIndex]
    if not cfg or #cfg < 2 then
        return
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    self.curViewName = cfg[2]
    if jumpTopWindowName ~= nil then
        _G.UIManager:GetInstance():AddJumpInfo(self.cfg.superior_window, jumpTopWindowName)
    end
    if #cfg == 2 then
        _G.UIManager:GetInstance():OpenWindow(cfg[2], _G.SafeUnpack(self.params))
    elseif #cfg == 3 then
        _G.UIManager:GetInstance():OpenWindow(cfg[2], ParseParam(cfg[3]), _G.SafeUnpack(self.params))
    elseif #cfg == 4 then
        _G.UIManager:GetInstance():OpenWindow(
                cfg[2],
                ParseParam(cfg[3]),
                ParseParam(cfg[4]),
                _G.SafeUnpack(self.params)
        )
    elseif #cfg == 5 then
        _G.UIManager:GetInstance():OpenWindow(
                cfg[2],
                ParseParam(cfg[3]),
                ParseParam(cfg[4]),
                ParseParam(cfg[5]),
                _G.SafeUnpack(self.params)
        )
    elseif #cfg == 6 then
        _G.UIManager:GetInstance():OpenWindow(
                cfg[2],
                ParseParam(cfg[3]),
                ParseParam(cfg[4]),
                ParseParam(cfg[5]),
                ParseParam(cfg[6]),
                _G.SafeUnpack(self.params)
        )
    elseif #cfg == 7 then
        _G.UIManager:GetInstance():OpenWindow(
                cfg[2],
                ParseParam(cfg[3]),
                ParseParam(cfg[4]),
                ParseParam(cfg[5]),
                ParseParam(cfg[6]),
                ParseParam(cfg[7]),
                _G.SafeUnpack(self.params)
        )
    end
end

---使用接口打开
function JumpManager:jumpFunc(jumpTopWindowName)
    local cfg = self.cfg.link[self.curJumpIndex]
    if not cfg and #cfg < 3 then
        return
    end

    local lua = _G[cfg[3]]
    if lua == nil then
        lua = require(cfg[3])
    end

    if not string.IsNullOrEmpty(cfg[2]) and cfg[2] ~= " " then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        self.curViewName = cfg[2]
    end
    if jumpTopWindowName ~= nil then
        _G.UIManager:GetInstance():AddJumpInfo(self.cfg.superior_window, jumpTopWindowName)
    end
    if #cfg == 4 then
        lua[cfg[4]]()
    elseif #cfg == 5 then
        lua[cfg[4]](ParseParam(cfg[5]), _G.SafeUnpack(self.params))
    elseif #cfg == 6 then
        lua[cfg[4]](ParseParam(cfg[5]), ParseParam(cfg[6]), _G.SafeUnpack(self.params))
    elseif #cfg == 7 then
        lua[cfg[4]](ParseParam(cfg[5]), ParseParam(cfg[6]), ParseParam(cfg[7]), _G.SafeUnpack(self.params))
    elseif #cfg == 8 then
        lua[cfg[4]](
            ParseParam(cfg[5]),
            ParseParam(cfg[6]),
            ParseParam(cfg[7]),
            ParseParam(cfg[8]),
            _G.SafeUnpack(self.params)
        )
    elseif #cfg == 9 then
        lua[cfg[4]](
            ParseParam(cfg[5]),
            ParseParam(cfg[6]),
            ParseParam(cfg[7]),
            ParseParam(cfg[8]),
            ParseParam(cfg[9]),
            _G.SafeUnpack(self.params)
        )
    end
end

---使用接口跳转活动
function JumpManager:JumpActivity(jumpTopWindowName)
    local cfg = self.cfg.link[self.curJumpIndex]
    if jumpTopWindowName ~= nil then
        _G.UIManager:GetInstance():AddJumpInfo(self.cfg.superior_window, jumpTopWindowName)
    end
    _G.GlobalInterface.JumpActivityByCfg(tonumber(cfg[2]))
end

---使用界面跳转活动
function JumpManager:JumpComplex(jumpTopWindowName)
    local cfg = self.cfg.link[self.curJumpIndex]
    if jumpTopWindowName ~= nil then
        _G.UIManager:GetInstance():AddJumpInfo(self.cfg.superior_window, jumpTopWindowName)
    end
    local activity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        ParseParam(cfg[3]),
        ParseParam(cfg[4])
    )
    if #cfg == 5 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg[cfg[2]].Name,
            activity,
            ParseParam(cfg[5])
        )
    elseif #cfg == 6 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg[cfg[2]].Name,
            activity,
            ParseParam(cfg[5]),
            ParseParam(cfg[6])
        )
    elseif #cfg == 7 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg[cfg[2]].Name,
            activity,
            ParseParam(cfg[5]),
            ParseParam(cfg[6]),
            ParseParam(cfg[7])
        )
    elseif #cfg == 8 then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ui_cfg[cfg[2]].Name,
            activity,
            ParseParam(cfg[5]),
            ParseParam(cfg[6]),
            ParseParam(cfg[7]),
            ParseParam(cfg[8])
        )
    end
end

---打开界面入口，递归
function JumpManager:JumpStep(jumpTopWindowName)
    local UImanagerIns = _G.UIManager:GetInstance()
    if not self.cfg.link[self.curJumpIndex] then
        if self.callback then
            self.callback()
        end
        UImanagerIns:HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
        return
    end
    local _type = _G.tonumber(self.cfg.link[self.curJumpIndex][1])
    if _type == jumpType.view then
        self:JumpView(jumpTopWindowName)
    elseif _type == jumpType.func then
        self:jumpFunc(jumpTopWindowName)
    elseif _type == jumpType.activity then
        self:JumpActivity(jumpTopWindowName)
    elseif _type == jumpType.complex then
        self:JumpComplex(jumpTopWindowName)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("无此类型。。。。。。type =" .. _type)
        end
    end
    UImanagerIns:HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
end
