local tipsID = {
    NotJump = 380103,
    ActivityNotJump = 3602,
}

---外部调用接口  界面跳转
---@param sid number item_way_cfg的ID
---@param call function 跳转完成回调
function JumpManager:Jump(sid, call, ...)
    self.IsJumping = true
    self.callback = call or nil
    local cfg = _G.ConfigManager.item_way_cfg[sid]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("Can't find sid by item_way_cfg of JumpManager")
        end
        self.IsJumping = false
        return
    end
    if self.CheckIgnore(cfg) then
        self.IsJumping = false
        return
    end
    if #cfg.function_open >= 3 then
        if not _G[cfg.function_open[1]][cfg.function_open[2]](ParseParam(cfg.function_open[3])) then
            if cfg.function_open[2] == "CheckFuncOpenByFuncManager" then
                _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(_G.tonumber(cfg.function_open[3]))
            elseif cfg.function_open[2] == "CheckActivityOpened" then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.ActivityNotJump)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotJump)
            end
            self.IsJumping = false
            return
        end
    end
    --ZHJH-1455【放置关卡】推图过程中点击挑战材料副本，切回放置关卡界面黑屏
    --后台可以进行战斗
    --_G.BattleManager:GetInstance():DestroyBattle()
    local UImanagerIns = _G.UIManager:GetInstance()
    local topWindowName = nil
    local isInitial_Interface = false
    local topWindow = UImanagerIns:GetTopWindowByLayer(_G.UILayers.NormalLayer.Name)
    if topWindow ~= nil then
        local topCfg = _G.ConfigManager.ui_cfg[topWindow.Name]
        if topCfg ~= nil and topCfg.Initial_Interface == 1 then
            if not _G.string.IsNullOrEmpty(cfg.superior_window) then
                isInitial_Interface = true
                UImanagerIns:HideWindow(topWindow.Name)
                topWindowName = topWindow.Name
            end
        end
    end
    if not isInitial_Interface then
      UImanagerIns:SwitchSceneCloseWindows()
    end
    UImanagerIns:ShowWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    if _G.AppSetting.IsloadScence then
        if _G.WorldManager:GetInstance():GetCurWorld().Sid == 600 then
            UImanagerIns:ShowWindow(_G.ConfigManager.ui_cfg.SociatyMainView.Name)
            UImanagerIns:HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
        elseif _G.WorldManager:GetInstance():GetCurWorld().Sid == 801 then
            UImanagerIns:ShowWindow(_G.ConfigManager.ui_cfg.MainSiegeView.Name)
            UImanagerIns:HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
        else
            UImanagerIns:ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        end
    else
        UImanagerIns:ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    end
    
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    self.cfg = cfg
    self.params = _G.SafePack(...)
    self.curJumpIndex = 1
    self:JumpStep(topWindowName)
    self.IsJumping = false
end
---特殊处理限时活动群英商店在结算时无法跳转进群英
---群英商店跳转使用
function JumpManager.AllHeroIsOpen(num)
    local SeasonModel = require "SeasonModel":GetInstance()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(num) then
        return false
    end
    if SeasonModel.infoData then
        if SeasonModel.state > _G.SeasonState.Open then
            return false
        end
    end
    return true
end
