local ChallengeTeamDragCardItem = require "ChallengeTeamDragCardItem"
local ChallengeTeamDragSkillItem = require "ChallengeTeamDragSkillItem"
local ChallengeTeamDragPetItem = require "ChallengeTeamDragPetItem"

local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH

---@class ChallengeTeamItem : Component    中文描述
local ChallengeTeamItem = _G.BaseClass("ChallengeTeamItem", _G.Component)

---创建对象时,入口构造函数
function ChallengeTeamItem:OnCreate(
    obj,
    isSelf,
    emBattle,
    combSkill,
    petSkill,
    beastSkill,
    beginBack,
    endBack,
    index,
    groupState,
    embattleControllerItemType)
    self.go_table = _G.GetAutoGoTable(obj)
    self.IsSelf = isSelf
    self.Embattle = emBattle
    self.CombSkill = combSkill
    self.PetSkill = petSkill
    if _G.AppSetting.IsXzns then
        self.BeastSkill = beastSkill
    end
    if nil == combSkill or combSkill == 0 then
        self.CombSkill = {}
    end
    if nil == petSkill or petSkill == 0 then
        self.PetSkill = {}
    end
    if _G.AppSetting.IsXzns then
        if nil == beastSkill or beastSkill == 0 then
            self.BeastSkill = {}
        end
    end
    self.BeginBack = beginBack
    self.EndBack = endBack
    self.Index = index
    self.GroupState = groupState

    ---@type _G.EmbattleControllerItemType
    self.EmbattleControllerItemType = embattleControllerItemType

    local x, y = self.go_table.gameObject:GetLocalPosition()
    self.x = x
    self.y = y

    local wx, wy, wz = self.go_table.gameObject:GetPosition()
    ---定位
    local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(wx, wy, wz)

    self.nx = nx
    self.ny = ny

    self.Parent = self.go_table.transform:GetParent()

    self.MainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonChallengeTeamView.Name)

    self.selfCardList = {}
    self.selfSkillList = {}
    self.selfPetList = {}
    if _G.AppSetting.IsXzns then
        self.selfBeastList = {}
    end

    self.go_table.gameObject:SetName(self.Index)

    self.IsPass = self.GroupState ~= nil and self.GroupState == true
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, self.IsPass)

    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))

    self:ShowInfo()

    -- self.go_table.aortext_teamname.text = _G.GetLangPackValue(90024900011, _G.GameUtil.NumberToChinese(self.Index))
    self.go_table.aortext_teamname.text = _G.GetLangPackValue(90024900062 + self.Index)
    self:UpdatePower()
end

function ChallengeTeamItem:DoCross(show)
    if show then
        self.go_table.obj_cross:SetActiveE(1)
        if nil == self.cross then
            self.go_table.obj_cross:SetLocalScale(0.84, 0.48, 0) --复用的死魂塔呼吸特效，大小不一致故缩放
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shouhuzhitakuang, self.go_table.obj_cross)
            self.cross = true
        end
    else
        self.go_table.obj_cross:SetActiveE(0)
    end
end

function ChallengeTeamItem:UpdatePower()
    if self.IsSelf then
        local totalPower = 0
        for i = 1, #self.Embattle do
            local tp = self.Embattle[i].power or 0
            totalPower = totalPower + tp
        end

        self.go_table.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(totalPower, true)
    else
        local totalPower = 0
        for i = 1, #self.Embattle do
            local tp = self.Embattle[i].power or 0
            totalPower = totalPower + tp
        end

        if totalPower > 0 then
            if self.EmbattleControllerItemType ~= _G.EmbattleControllerItemType.worldBoss then
                self.go_table.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(totalPower, true)
            else
                self.go_table.aortext_power.text = "???"
            end
        else
            self.go_table.aortext_power.text = "???"
        end
    end
end

function ChallengeTeamItem:CheckInRange(x, y)
    if _G.AppSetting.DEBUG then
        if self.IsPlace then
            _G.Log(_G.GetLangPackValue(self.Index), "交叉队伍索引")
        end
    end
    if (x >= self.nx - 142 and x <= self.nx + 142) and (y >= self.ny - 80 and y <= self.ny + 80) then
        --142和85为宽和高的一半
        if _G.AppSetting.DEBUG then
            if self.IsPlace then
                _G.Log(_G.GetLangPackValue(self.Index), "<color=red><size=20>最终交叉队伍索引</size></color>")
            end
        end
        return true
    end
    return false
end

function ChallengeTeamItem:OnDragBegin()
    if self.GroupState ~= nil and self.GroupState == true then
        --_G.PopWindowManager:GetInstance():ShowAllTips(140120)
        return
    end
    local x, y = self.Parent:GetLocalPosition()
    self.MainView.go_table.obj_dragParent:SetLocalPosition(-144, 48, 0)
    self.go_table.gameObject:SetParentE(self.MainView.go_table.obj_dragParent)
    self.go_table.aorimage_curbg:SetActiveE(1)
    if self.BeginBack then
        self.BeginBack(0, self.Index)
    end
end
function ChallengeTeamItem:OnDrag(go, ed)
    if self.GroupState ~= nil and self.GroupState == true then
        return
    end
    self.gameObject:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end
function ChallengeTeamItem:OnDragEnd(go, ed)
    if self.GroupState ~= nil and self.GroupState == true then
        return
    end

    local x, y = self.go_table.gameObject:GetPosition()

    self.go_table.gameObject:SetParentE(self.Parent)
    self.go_table.gameObject:SetLocalPosition(self.x, self.y, 0)
    self.go_table.aorimage_curbg:SetActiveE(0)
    if self.EndBack then
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        if _G.AppSetting.IsXzns then
            self.EndBack(0, nx, ny, { self.Embattle, self.CombSkill, self.PetSkill, self.BeastSkill }, self.Index)
        else
            self.EndBack(0, nx, ny, { self.Embattle, self.CombSkill, self.PetSkill }, self.Index)
        end
    end
end

