function ChallengeTeamItem:UpdateView(emBattle, combSkill, petSkill, beastSkill)
    self.Embattle = emBattle
    self.CombSkill = combSkill
    self.PetSkill = petSkill
    if _G.AppSetting.IsXzns then
        self.BeastSkill = beastSkill
    end
    if nil == combSkill or combSkill == 0 then
        self.CombSkill = {}
    end
    if nil == petSkill or petSkill == 0 then
        self.PetSkill = {}
    end
    if _G.AppSetting.IsXzns then
        if nil == beastSkill or beastSkill == 0 then
            self.BeastSkill = {}
        end
    end
    for i = 1, #self.selfCardList do
        self.selfCardList[i]:UpdateView(self.Embattle[i])
    end
    for i = 1, #self.selfSkillList do
        self.selfSkillList[i]:UpdateView(self.CombSkill[i])
    end
    for i = 1, #self.selfPetList do
        self.selfPetList[i]:UpdateView(self.PetSkill[i])
    end
    if _G.AppSetting.IsXzns then
        for i = 1, #self.selfBeastList do
            self.selfBeastList[i]:UpdateView(self.BeastSkill[i])
        end
    end

    self:UpdatePower()
end

