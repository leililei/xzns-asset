local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
---@class ChallengeTeamDragPetItem : Component	中文描述
local ChallengeTeamDragPetItem = _G.BaseClass("ChallengeTeamDragPetItem", _G.Component)

---定义宠物品质框
local PetOrderFrame = {
    [0] = "ui_js_txk_lan",
    [1] = "ui_js_txk_zi",
    [2] = "ui_js_txk_cheng",
    [3] = "ui_js_txk_hong",
    [4] = "ui_js_txk_cai"
}

---创建对象时,入口构造函数
function ChallengeTeamDragPetItem:OnCreate(obj, isSelf, info, beginBack, endBack, index, pos, groupState)
    self.go_table = _G.GetAutoGoTable(obj)
    self.IsSelf = isSelf
    self.Info = info or 0
    self.BeginBack = beginBack
    self.EndBack = endBack
    self.Index = index
    self.Pos = pos
    self.GroupState = groupState

    self.IsPass = (self.GroupState ~= nil and self.GroupState == true)

    local x, y = self.go_table.gameObject:GetLocalPosition()
    self.x = x
    self.y = y

    ---是否有人员占位
    self.IsPlace = self.Info and self.Info > 0

    local wx, wy, wz = self.go_table.gameObject:GetPosition()
    ---定位
    local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(wx, wy, wz)

    self.nx = nx
    self.ny = ny

    self.Parent = self.go_table.transform:GetParent()

    self.MainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonChallengeTeamView.Name)

    if _G.AppSetting.DEBUG then
        if self.IsSelf and self.IsPlace then
            local model
            local data
            if _G.AppSetting.IsXzns then
                model = require("BeastModel"):GetInstance()
                data = model:GetBeast(self.Info)
            else
                model = require("PetModel"):GetInstance()
                data = model:GetPet(self.Info)
            end
            self.Cfg = data.cfg
            _G.Log(_G.GetLangPackValue(data.cfg.Name), "灵宠名称")
            _G.Log(self.Info, "布阵技能信息")
            _G.Log(nx .. "+" .. ny, "定位坐标")
        end
    end

    self:ShowInfo()

    if self.IsSelf then
        _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
        _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
        _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
    end
end

function ChallengeTeamDragPetItem:DoCross(show)
    if show then
        self.go_table.obj_cross:SetActiveE(1)
        if nil == self.cross then
            -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_duiwutihuan_xz3, self.go_table.obj_cross)
            self.cross = true
        end
        self.go_table.obj_light:SetActiveE(0)
    else
        self.go_table.obj_cross:SetActiveE(0)
        if self.ItemLight then
            self.go_table.obj_light:SetActiveE(1)
        end
    end
end

function ChallengeTeamDragPetItem:DoLight(show)
    self.ItemLight = show
    if show then
        self.go_table.obj_light:SetActiveE(1)
        if nil == self.light then
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_BaseItemWithCount_cheng, self.go_table.obj_light)
            self.light = true
        end
    else
        self.go_table.obj_light:SetActiveE(0)
    end
end

function ChallengeTeamDragPetItem:CheckInRange(x, y)
    if _G.AppSetting.DEBUG then
        if self.IsPlace then
            _G.Log(_G.GetLangPackValue(self.Cfg.Name), "交叉灵宠名称")
        end
    end
    if (x >= self.nx - 61.7 / 2 and x <= self.nx + 61.7 / 2) and (y >= self.ny - 61.7 / 2 and y <= self.ny + 61.7 / 2) then
        if _G.AppSetting.DEBUG then
            if self.IsPlace then
                _G.Log(_G.GetLangPackValue(self.Cfg.Name), "<color=red><size=20>最终可交换灵宠名称</size></color>")
            end
        end
        return true
    end
    return false
end

function ChallengeTeamDragPetItem:OnDragBegin()
    if not self.IsPlace then
        return
    end
    if self.GroupState ~= nil and self.GroupState == true then
        --_G.PopWindowManager:GetInstance():ShowAllTips(140120)
        return
    end
    local x, y = self.Parent:GetLocalPosition()
    self.MainView.go_table.obj_dragParent:SetLocalPosition(x, 40 + y, 0)
    self.MainView.go_table.obj_curPetParent:SetLocalPosition(x, 40, 0)
    self.go_table.gameObject:SetParentE(self.MainView.go_table.obj_dragParent)
    if self.BeginBack then
        self.BeginBack(3, self.Index, self.Pos)
    end
end
function ChallengeTeamDragPetItem:OnDrag(go, ed)
    if not self.IsPlace then
        return
    end
    if self.GroupState ~= nil and self.GroupState == true then
        return
    end
    self.gameObject:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end
function ChallengeTeamDragPetItem:OnDragEnd(go, ed)
    if not self.IsPlace then
        return
    end
    if self.GroupState ~= nil and self.GroupState == true then
        return
    end
    
    local x, y = self.go_table.gameObject:GetPosition()

    self.go_table.gameObject:SetParentE(self.Parent)
    self.go_table.gameObject:SetLocalPosition(self.x, self.y, 0)
    if self.EndBack then
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        self.EndBack(3, nx, ny, self.Info, self.Index, self.Pos)
    end
end

function ChallengeTeamDragPetItem:UpdateView(Info)
    self.Info = Info
    ---是否有人员占位
    self.IsPlace = self.Info and self.Info > 0
    if _G.AppSetting.DEBUG then
        if self.IsPlace then
            local model
            local data
            if _G.AppSetting.IsXzns then
                model = require("BeastModel"):GetInstance()
                data = model:GetBeast(self.Info)
            else
                model = require("PetModel"):GetInstance()
                data = model:GetPet(self.Info)
            end
            self.Cfg = data.cfg
                _G.Log(_G.GetLangPackValue(self.Cfg.Name), "灵宠名称")
                _G.Log(self.Info, "布阵灵宠信息")
                _G.Log(self.nx .. "+" .. self.ny, "定位坐标")
        end
    end
    self:ShowInfo()
end

function ChallengeTeamDragPetItem:ShowInfo()
    if self.IsPlace then
        if _G.AppSetting.IsXzns then
            local beastData = require("BeastModel"):GetInstance():GetBeast(self.Info)
            local beastCfg = beastData and beastData.cfg or _G.ConfigManager.pet_xzns_cfg[self.Info]
            if beastCfg == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError(self.Info, "未查询到圣兽配置, id:")
                end
                self.go_table.obj_petSkills:SetActiveE(0)
                return
            end
            self.go_table.aorimage_beastType:SetActiveE(1)
            self.go_table.obj_type1BG:SetActiveE(0)

            self.go_table.aorrawimage_icon:LoadImage(beastData:GetIconPath())
            self.go_table.aorimage_beastType.SpriteName = beastData:GetProfessionalSpriteName()
            self.go_table.aortext_name.text = beastData:GetName()
            self.go_table.obj_petSkills:SetActiveE(1)
            self.go_table.obj_petSkills:SetName(self.Info .. "|" .. self.Pos)
            self.go_table.aorimage_bg.SpriteName = _G.EquipItemIconName[beastData:GetOrder()]
        else
            local petData = require("PetModel"):GetInstance():GetPet(self.Info)
            local petCfg = petData and petData.cfg or _G.ConfigManager.pet_cfg[self.Info]
            if petCfg == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError(self.Info, "未查询到魔兽配置, id:")
                end
                self.go_table.obj_petSkills:SetActiveE(0)
                return
            end
            local skillId
            if petData then
                local skillIdx, maxSkillIdx = petData.star + 1, #petCfg.skill_id
                skillId = petCfg.skill_id[skillIdx < 1 and 1 or skillIdx <= maxSkillIdx and skillIdx or maxSkillIdx]
            else
                skillId = petCfg.skill_id[1]
            end
            local cfgt = _G.ConfigManager.card_skills_cfg[skillId]
            local cfg = _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]

            self.go_table.aorrawimage_icon:LoadImage(petCfg.Icon)
            self.go_table.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            self.go_table.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
            self.go_table.obj_petSkills:SetActiveE(1)
            self.go_table.obj_petSkills:SetName(self.Info .. "|" .. self.Pos)
            local order = petCfg.Order
            self.go_table.aorimage_bg.SpriteName = PetOrderFrame[order]
        end
    else
        self.go_table.obj_petSkills:SetActiveE(0)
    end
end

---销毁对象时,析构函数
function ChallengeTeamDragPetItem:OnDestroy()
end
return ChallengeTeamDragPetItem
