local widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
---@class ChallengeTeamDragCardItem : Component    中文描述
local ChallengeTeamDragCardItem = _G.BaseClass("ChallengeTeamDragCardItem", _G.Component)

---创建对象时,入口构造函数
function ChallengeTeamDragCardItem:OnCreate(
    obj,
    isSelf,
    info,
    beginBack,
    endBack,
    index,
    pos,
    groupState,
    embattleControllerItemType)
    self.go_table = _G.GetAutoGoTable(obj)
    self.IsSelf = isSelf
    self.Info = info
    self.BeginBack = beginBack
    self.EndBack = endBack
    self.Index = index
    self.Pos = pos
    self.GroupState = groupState
    ---@type _G.EmbattleControllerItemType
    self.EmbattleControllerItemType = embattleControllerItemType

    self.IsPass = (self.GroupState ~= nil and self.GroupState == true)

    local x, y = self.go_table.gameObject:GetLocalPosition()
    self.x = x
    self.y = y

    ---是否有人员占位
    self.IsPlace = self.Info.uid > 0

    local wx, wy, wz = self.go_table.gameObject:GetPosition()
    ---定位
    local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(wx, wy, wz)

    self.nx = nx
    self.ny = ny

    self.Parent = self.go_table.transform:GetParent()

    self.MainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CommonChallengeTeamView.Name)

    if _G.AppSetting.DEBUG then
        if self.IsSelf and self.IsPlace then
            self.Cfg = _G.ConfigManager.card_cfg[self.Info.sid]
            _G.Log(_G.GetLangPackValue(self.Cfg.Name), "角色名称")
            _G.Log(self.Info, "布阵角色信息")
            _G.Log(nx .. "+" .. ny, "定位坐标")
        end
    end

    self:ShowInfo()

    if self.IsSelf then
        _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
        _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
        _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
    end
end

function ChallengeTeamDragCardItem:DoCross(show)
    if show then
        self.go_table.obj_cross:SetActiveE(1)
        if nil == self.cross then
            -- _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_duiwutihuan_xz1, self.go_table.obj_cross)
            self.cross = true
        end
    else
        self.go_table.obj_cross:SetActiveE(0)
    end
end

function ChallengeTeamDragCardItem:CheckInRange(x, y)
    if _G.AppSetting.DEBUG then
        if self.IsPlace then
            _G.Log(_G.GetLangPackValue(self.Cfg.Name), "交叉角色名称")
        end
    end
    if (x >= self.nx - 57.6 / 2 and x <= self.nx + 57.6 / 2) and (y >= self.ny - 57.6 / 2 and y <= self.ny + 57.6 / 2) then
        if _G.AppSetting.DEBUG then
            if self.IsPlace then
                _G.Log(_G.GetLangPackValue(self.Cfg.Name), "<color=red><size=20>最终可交换角色名称</size></color>")
            end
        end
        return true
    end
    return false
end

function ChallengeTeamDragCardItem:OnDragBegin()
    if not self.IsPlace then
        return
    end
    if self.GroupState ~= nil and self.GroupState == true then
        --_G.PopWindowManager:GetInstance():ShowAllTips(140120)
        return
    end
    local x, y = self.Parent:GetLocalPosition()
    self.MainView.go_table.obj_dragParent:SetLocalPosition(x - 144, 41 + y, 0)
    self.MainView.go_table.obj_curCardParent:SetLocalPosition(x, 40, 0)
    self.go_table.gameObject:SetParentE(self.MainView.go_table.obj_dragParent)
    if self.BeginBack then
        self.BeginBack(1, self.Index, self.Pos)
    end
end
function ChallengeTeamDragCardItem:OnDrag(go, ed)
    if not self.IsPlace then
        return
    end
    if self.GroupState ~= nil and self.GroupState == true then
        return
    end
    self.gameObject:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end
function ChallengeTeamDragCardItem:OnDragEnd(go, ed)
    if not self.IsPlace then
        return
    end
    if self.GroupState ~= nil and self.GroupState == true then
        return
    end

    local x, y = self.go_table.gameObject:GetPosition()

    self.go_table.gameObject:SetParentE(self.Parent)
    self.go_table.gameObject:SetLocalPosition(self.x, self.y, 0)
    if self.EndBack then
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        self.EndBack(1, nx, ny, self.Info, self.Index, self.Pos)
    end
end

function ChallengeTeamDragCardItem:UpdateView(Info)
    self.Info = Info
    ---是否有人员占位
    self.IsPlace = self.Info.uid > 0
    if _G.AppSetting.DEBUG then
        if self.IsPlace then
            self.Cfg = _G.ConfigManager.card_cfg[self.Info.sid]
            _G.Log(_G.GetLangPackValue(self.Cfg.Name), "角色名称")
            _G.Log(self.Info, "布阵角色信息")
            _G.Log(self.nx .. "+" .. self.ny, "定位坐标")
        end
    end
    self:ShowInfo()
end

function ChallengeTeamDragCardItem:ShowInfo()
    local sid = self.Info.sid
    local star = self.Info.star
    local soulLink_lv = self.Info.soulLink_lv
    local lv = self.Info.level
    if
    self.EmbattleControllerItemType == _G.EmbattleControllerItemType.SociatyBattleAttack or
        self.EmbattleControllerItemType == _G.EmbattleControllerItemType.SociatyBattleLeagueAttack
    then
        lv = 300
    end

    if self.IsPlace then
        self.go_table.obj_item:SetName(self.Info.uid)
        if self.card then
            self.card:Show(sid, nil, star, soulLink_lv, lv)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_item, true)
        else
            local ItemCardFactory = _G.ItemCardFactory
            ItemCardFactory:GetInstance():GetItemCard(
                ItemCardFactory.itemCardType.CardAllItem,
                self.go_table.obj_item,
                function(item)
                    self.card = item
                    self.card:Show(sid, nil, star, soulLink_lv, lv)
                    _G.GameUtil.SetActiveByCondition(self.go_table.obj_item, true)
                end
            )
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_item, false)
    end
end

---销毁对象时,析构函数
function ChallengeTeamDragCardItem:OnDestroy()
end
return ChallengeTeamDragCardItem
