---寻找相同类型的槽位或空闲槽位
---@param base ChallengeTeamDragPetItem
---@param others ChallengeTeamDragPetItem[]
---@return ChallengeTeamDragPetItem,ChallengeTeamDragPetItem[]
local function findSameTypeAndFreePetItem(base, others)
    if not base or not others then
        return nil, nil
    end
    local model = require("PetModel"):GetInstance()
    ---@type PetData
    local petData = base.Info and model:GetPet(base.Info)
    if not petData then
        return nil, nil
    end

    --当前槽位宠物类型以及序号
    local professional = petData.cfg.professional

    ---@type ChallengeTeamDragPetItem[]
    local freePetItems = {}
    for _, item in pairs(others) do
        petData = item.Info and model:GetPet(item.Info)
        if not petData or not item.IsPlace then
            table.insert(freePetItems, item)
        elseif petData.cfg.professional == professional and item ~= base then
            return item, nil
        end
    end
    return nil, freePetItems
end

---寻找相同类型的槽位或空闲槽位
---@param base ChallengeTeamDragPetItem
---@param others ChallengeTeamDragPetItem[]
---@return ChallengeTeamDragPetItem,ChallengeTeamDragPetItem[]
local function findSameTypeAndFreeBeastItem(base, others)
    if not base or not others then
        return nil, nil
    end
    local model = require("BeastModel"):GetInstance()
    ---@type PetData
    local beastData = base.Info and model:GetBeast(base.Info)
    if not beastData then
        return nil, nil
    end

    ---@type ChallengeTeamDragPetItem[]
    local freeBeastItems = {}
    for _, item in pairs(others) do
        beastData = item.Info and model:GetBeast(item.Info)
        if not beastData or not item.IsPlace then
            table.insert(freeBeastItems, item)
        elseif item ~= base then
            return item, nil
        end
    end
    return nil, freeBeastItems
end

local ChallengeTeamItem = require "ChallengeTeamItem"
---@class CommonChallengeTeamView : UIBaseView	中文描述
---@field public go_table CommonChallengeTeamView_GoTable GoTable
local CommonChallengeTeamView = _G.BaseClass("CommonChallengeTeamView", _G.UIBaseView)

function CommonChallengeTeamView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CommonChallengeTeamView:OnCreate(
    changeCall,
    emBattle,
    combSkill,
    petSkill,
    beastSkill,
    enemyEmBattle,
    ememyCombSkill,
    ememyPetSkill,
    ememyBeastSkill,
    embattleControllerItemType,
    groupState,
    enemyInfo)
    self.onChangeCall = changeCall
    self.curEmBattleInfo = _G.DeepCopy(emBattle)
    self.curCombSkillInfo = _G.DeepCopy(combSkill)
    self.curPetSkillInfo = _G.DeepCopy(petSkill)
    if _G.AppSetting.IsXzns then
        self.curBeastSkillInfo = _G.DeepCopy(beastSkill)
    end
    self.selfChangeList = {}

    self:ShowBaseInfo(enemyInfo)

    ---@type _G.EmbattleControllerItemType
    self.EmbattleControllerItemType = embattleControllerItemType

    local len = self.go_table.obj_mTeam:GetChildCountE()
    for i = 1, len do
        local item = self.go_table.obj_mTeam:GetChildE(i - 1)
        if i <= #self.curEmBattleInfo then
            local ci =
                self:AddComponent(
                item,
                ChallengeTeamItem.New(
                    item,
                    true,
                    self.curEmBattleInfo[i],
                    self.curCombSkillInfo[i],
                    self.curPetSkillInfo[i],
                    _G.AppSetting.IsXzns and self.curBeastSkillInfo[i] or nil,
                    _G.handler(self, self.BeginBack),
                    _G.handler(self, self.EndBack),
                    i,
                    groupState and groupState[i] or nil,
                    self.EmbattleControllerItemType
                )
            )
            table.insert(self.selfChangeList, ci)
            item:SetActiveE(1)
        else
            item:SetActiveE(0)
        end
    end

    local lene = self.go_table.obj_eTeam:GetChildCountE()
    for i = 1, lene do
        local item = self.go_table.obj_eTeam:GetChildE(i - 1)
        if i <= #enemyEmBattle then
            self:AddComponent(
                item,
                ChallengeTeamItem.New(
                    item,
                    false,
                    enemyEmBattle[i],
                    ememyCombSkill[i],
                    ememyPetSkill[i],
                    _G.AppSetting.IsXzns and ememyBeastSkill[i] or nil,
                    _G.handler(self, self.BeginBack),
                    _G.handler(self, self.EndBack),
                    i,
                    nil,
                    self.EmbattleControllerItemType
                )
            )
            item:SetActiveE(1)
        else
            item:SetActiveE(0)
        end
    end

    self.IsChange = false

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_curCardParent, false)
    self:UpdateCard(false)
    self:UpdateSkill()
    self:UpdatePet()

    self.TipsTimer = _G.TimerManager:GetInstance():GetTimer(0.2, self.TipsTimerFunc, self, false, false)
    self.TipsTimer:Start()
end

function CommonChallengeTeamView:ShowBaseInfo(enemyInfo)
    if enemyInfo then
        self.go_table.aortext_elv.text = enemyInfo.level or ""
        self.go_table.aortext_eName.text = enemyInfo.name or ""
        self.go_table.aorimage_ehead.SpriteName = enemyInfo.style or "0ui_jsxt_sx_icon5"
    else
        self.go_table.aortext_elv.text = ""
        self.go_table.aortext_eName.text = ""
    end
    local PlayerModel = _G.PlayerModel:GetInstance()
    local portraitCfg = _G.ConfigManager.player_portrait_cfg[PlayerModel:GetRoleStyle()]
    self.go_table.aorimage_mhead.SpriteName = portraitCfg and portraitCfg.portrait1 or "0ui_jsxt_sx_icon5"
    self.go_table.aortext_mlv.text = PlayerModel:GetLevel()
    self.go_table.aortext_mName.text = PlayerModel:GetName()
end

function CommonChallengeTeamView:TipsTimerFunc()
    if self.DragTeamIng then
        local dragItem = self.go_table.obj_dragParent:GetChildE(0)
        local index = tonumber(dragItem:GetName())
        local x, y = dragItem:GetPosition()
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        local showInfo = false
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            if not item.IsPass and item:CheckInRange(nx, ny) and item.Index ~= index then
                showInfo = true
                if nil == self.CrossTeam then
                    self.CrossTeam = item
                    self.CrossTeam:DoCross(true)
                else
                    if self.CrossTeam.Index ~= item.Index then
                        self.CrossTeam:DoCross(false)
                        self.CrossTeam = item
                        self.CrossTeam:DoCross(true)
                    end
                end
                break
            end
        end

        if showInfo then
        else
            if nil ~= self.CrossTeam then
                self.CrossTeam:DoCross(false)
                self.CrossTeam = nil
            end
        end
    elseif self.DragCardIng then
        local dragItem = self.go_table.obj_dragParent:GetChildE(0)
        local uid = tonumber(dragItem:GetChildE(0):GetName())
        local lx, ly
        local x, y = dragItem:GetPosition()
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        local showInfo = false
        local showCross = false
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            for i = 1, #item.selfCardList do
                if
                    not item.IsPass and item.selfCardList[i]:CheckInRange(nx, ny) and
                        item.selfCardList[i].Info.uid ~= uid
                 then
                    if nil == self.CrossCard then
                        self.CrossCard = item.selfCardList[i]
                        self.CrossCard:DoCross(true)
                    else
                        if self.CrossCard.Info.sid ~= item.selfCardList[i].Info.sid then
                            self.CrossCard:DoCross(false)
                            self.CrossCard = item.selfCardList[i]
                            self.CrossCard:DoCross(true)
                        else
                            if self.CrossCard.Index ~= item.selfCardList[i].Index then
                                self.CrossCard:DoCross(false)
                                self.CrossCard = item.selfCardList[i]
                                self.CrossCard:DoCross(true)
                            else
                                if self.CrossCard.Pos ~= item.selfCardList[i].Pos then
                                    self.CrossCard:DoCross(false)
                                    self.CrossCard = item.selfCardList[i]
                                    self.CrossCard:DoCross(true)
                                end
                            end
                        end
                    end
                    showCross = true
                    if item.selfCardList[i].Info.sid > 0 then
                        lx = item.selfCardList[i].x
                        ly = item.selfCardList[i].y + item.y
                        showInfo = true

                        local lv = item.selfCardList[i].Info.level

                        if
                            self.EmbattleControllerItemType == _G.EmbattleControllerItemType.SociatyBattleAttack or
                                self.EmbattleControllerItemType ==
                                    _G.EmbattleControllerItemType.SociatyBattleLeagueAttack
                         then
                            lv = 300
                        end

                        self:UpdateCard(
                            true,
                            item.selfCardList[i].Info.sid,
                            item.selfCardList[i].Info.star,
                            item.selfCardList[i].Info.soulLink_lv,
                            lv
                        )
                    end
                    break
                end
            end
        end

        if showInfo then
            self.go_table.obj_curCardParent:SetActiveE(1)
            self.TipCard.transform:SetLocalPosition(lx + 50, ly + 50, 0)
        else
            self.go_table.obj_curCardParent:SetActiveE(0)
        end
        if not showCross then
            if nil ~= self.CrossCard then
                self.CrossCard:DoCross(false)
                self.CrossCard = nil
            end
        end
    elseif self.DragSkillIng then
        local dragItem = self.go_table.obj_dragParent:GetChildE(0)
        local cskillIDAndPos = string.split(dragItem:GetChildE(0):GetName(), "|")
        local cskillID = tonumber(cskillIDAndPos[1])
        local pos = tonumber(cskillIDAndPos[2])
        local lx, ly
        local x, y = dragItem:GetPosition()
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        local showInfo = false
        local showCross = false
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            for i = 1, #item.selfSkillList do
                if
                    not item.IsPass and item.selfSkillList[i]:CheckInRange(nx, ny) and
                        item.selfSkillList[i].Info.cskillID ~= cskillID and
                        item.selfSkillList[i].Pos == pos
                 then
                    if nil == self.CrossSkill then
                        self.CrossSkill = item.selfSkillList[i]
                        self.CrossSkill:DoCross(true)
                    else
                        if self.CrossSkill.Info.cskillID ~= item.selfSkillList[i].Info.cskillID then
                            self.CrossSkill:DoCross(false)
                            self.CrossSkill = item.selfSkillList[i]
                            self.CrossSkill:DoCross(true)
                        else
                            if self.CrossSkill.Index ~= item.selfSkillList[i].Index then
                                self.CrossSkill:DoCross(false)
                                self.CrossSkill = item.selfSkillList[i]
                                self.CrossSkill:DoCross(true)
                            end
                        end
                    end
                    showCross = true
                    if item.selfSkillList[i].Info.cskillID > 0 then
                        lx = item.selfSkillList[i].x
                        ly = item.selfSkillList[i].y + item.y
                        --LogError(ly)
                        showInfo = true

                        self:UpdateSkill(true, item.selfSkillList[i].Info.cskillID)
                    end
                    break
                end
            end
        end
        if showInfo then
            self.go_table.obj_curSkillParent:SetActiveE(1)
            self.go_table.obj_TipSkill:SetLocalPosition(lx + 40, ly + 40, 0)
        else
            self.go_table.obj_curSkillParent:SetActiveE(0)
        end
        if not showCross then
            if nil ~= self.CrossSkill then
                self.CrossSkill:DoCross(false)
                self.CrossSkill = nil
            end
        end
    elseif self.DragPetIng then
        local dragItem = self.go_table.obj_dragParent:GetChildE(0)
        local iDAndPos = string.split(dragItem:GetChildE(0):GetName(), "|")
        local id = tonumber(iDAndPos[1])
        local pos = tonumber(iDAndPos[2])
        local lx, ly
        local x, y = dragItem:GetPosition()
        local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(x, y, 0)
        local showInfo = false
        local showCross = false

        local base = self.selfChangeList[self.DragPetIndex].selfPetList[self.DragPetPos]
        for k = 1, #self.selfChangeList do
            -- if k ~= self.DragPetPos then
            -- end
            local item, availableItems = findSameTypeAndFreePetItem(base, self.selfChangeList[k].selfPetList)
            if item then
                availableItems = { item }
            end
            if availableItems then
                for _, item in ipairs(availableItems) do
                    if item and id ~= item.Info and not item.IsPass and item:CheckInRange(nx, ny) then
                        if nil == self.CrossPet then
                            self.CrossPet = item
                            self.CrossPet:DoCross(true)
                        else
                            if self.CrossPet.Info ~= item.Info then
                                self.CrossPet:DoCross(false)
                                self.CrossPet = item
                                self.CrossPet:DoCross(true)
                            else
                                if self.CrossPet.Index ~= item.Index then
                                    self.CrossPet:DoCross(false)
                                    self.CrossPet = item
                                    self.CrossPet:DoCross(true)
                                end
                            end
                        end
                        showCross = true
                        if item.Info > 0 then
                            lx = item.x
                            ly = item.y + self.selfChangeList[k].y
                            showInfo = true
                            self:UpdatePet(true, item.Info)
                        end
                        break
                    end
                end
            end
        end
        if showInfo then
            self.go_table.obj_curPetParent:SetActiveE(1)
            self.go_table.obj_TipPet:SetLocalPosition(lx + 40, ly + 40, 0)
        else
            self.go_table.obj_curPetParent:SetActiveE(0)
        end
        if not showCross then
            if nil ~= self.CrossPet then
                self.CrossPet:DoCross(false)
                self.CrossPet = nil
            end
        end
    end
end

function CommonChallengeTeamView:UpdateCard(show, sid, star, soulLink_lv, lv)
    if self.TipCard then
        if not _G.IsNumber(self.TipCard) then
            if show and sid > 0 then
                self.TipCard:Show(sid, nil, star, soulLink_lv, lv)
            end
        end
    else
        self.TipCard = 1
        local ItemCardFactory = _G.ItemCardFactory
        ItemCardFactory:GetInstance():GetItemCard(
            ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_curCardParent,
            function(item)
                self.TipCard = item
                item.transform:SetLocalScale(0.7, 0.7, 0)
                if show and sid > 0 then
                    self.TipCard:Show(sid, nil, star, soulLink_lv, lv)
                end
            end
        )
    end
end

function CommonChallengeTeamView:UpdateSkill(show, cskillID)
    if show and cskillID > 0 then
        local cfgt = _G.ConfigManager.card_skills_cfg[cskillID]
        local cfg = _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]
        self.go_table.aorrawimage_iconskill:LoadImage(cfgt.icon)
        self.go_table.aortext_typeskill.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
    end
end

function CommonChallengeTeamView:UpdatePet(show, id)
    if show and id > 0 then
        local model = require("PetModel"):GetInstance()
        local data = model:GetPet(id)
        if data then
            self.go_table.aorrawimage_iconpet:LoadImage(data.cfg.Icon)
        end
        local star = data and data.star or 0
        for i = 1, 5 do
            self.go_table["obj_star" .. i]:SetActiveE(star >= i and 1 or 0)
        end

        self.go_table.obj_attack:SetActiveE(data and data.cfg.professional == 1 and 1 or 0)
        self.go_table.obj_defense:SetActiveE(data and data.cfg.professional == 2 and 1 or 0)
    end
end
function CommonChallengeTeamView:UpdateView()
    for i = 1, #self.selfChangeList do
        if _G.AppSetting.IsXzns then
            self.selfChangeList[i]:UpdateView(self.curEmBattleInfo[i], self.curCombSkillInfo[i], self.curPetSkillInfo[i], self.curBeastSkillInfo[i])
        else
            self.selfChangeList[i]:UpdateView(self.curEmBattleInfo[i], self.curCombSkillInfo[i], self.curPetSkillInfo[i])
        end
    end
end

---@param type number 0整队，1卡片，2技能，3灵兽
function CommonChallengeTeamView:BeginBack(type, index, pos)
    if type == 0 then
        self.DragTeamIng = true
    elseif type == 1 then
        self.DragCardIng = true
    elseif type == 2 then
        self.DragSkillIng = true
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            for i = 1, #item.selfSkillList do
                if index ~= item.selfSkillList[i].Index and pos == item.selfSkillList[i].Pos then
                    item.selfSkillList[i]:DoLight(true)
                end
            end
        end
    elseif type == 3 then
        self.DragPetIng = true
        self.DragPetIndex = index
        self.DragPetPos = pos
        if _G.AppSetting.IsXzns then
            local base = self.selfChangeList[index].selfBeastList[pos]
            for k = 1, #self.selfChangeList do
                if k ~= index then
                    local item, freeItems = findSameTypeAndFreeBeastItem(base, self.selfChangeList[k].selfBeastList)
                    if item then
                        item:DoLight(true)
                    elseif freeItems then
                        for _, item in pairs(freeItems) do
                            item:DoLight(true)
                        end
                    end
                end
            end
        else
            local base = self.selfChangeList[index].selfPetList[pos]
            for k = 1, #self.selfChangeList do
                if k ~= index then
                    local item, freeItems = findSameTypeAndFreePetItem(base, self.selfChangeList[k].selfPetList)
                    if item then
                        item:DoLight(true)
                    elseif freeItems then
                        for _, item in pairs(freeItems) do
                            item:DoLight(true)
                        end
                    end
                end
            end
        end
    end
end

---@param type number 0整队，1卡片，2技能，3灵兽
---@param x number 抬手位置
---@param y number 抬手位置
---@param info number 操作对象信息
---@param index number 队伍索引
---@param pos number 队伍中所在位置
function CommonChallengeTeamView:EndBack(type, x, y, info, index, pos)
    if _G.AppSetting.DEBUG then
        _G.Log(type, "交换类型")
        _G.Log(x, "交换x")
        _G.Log(y, "交换y")
        _G.Log(info, "交换信息")
        _G.Log(index, "交换队伍索引")
        _G.Log(pos, "交换布阵索引")
    end
    if type == 0 then
        self.DragTeamIng = false
        if nil ~= self.CrossTeam then
            self.CrossTeam:DoCross(false)
            self.CrossTeam = nil
        end
        local isChanged = false
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            if item.Index ~= index then
                if not item.IsPass and item:CheckInRange(x, y) and not isChanged then
                    _G.Log("可以交换队伍")
                    local dragEmInfo = _G.DeepCopy(info[1])
                    local changeEmInfo = _G.DeepCopy(item.Embattle)

                    for y0 = 1, #self.curEmBattleInfo do
                        if y0 == item.Index then
                            self.curEmBattleInfo[y0] = dragEmInfo
                            break
                        end
                    end

                    for y1 = 1, #self.curEmBattleInfo do
                        if y1 == index then
                            self.curEmBattleInfo[y1] = changeEmInfo
                            break
                        end
                    end

                    local dragSkillInfo = _G.DeepCopy(info[2])
                    local changeSkillInfo = _G.DeepCopy(item.CombSkill)

                    for y0 = 1, #self.curCombSkillInfo do
                        if y0 == item.Index then
                            self.curCombSkillInfo[y0] = dragSkillInfo
                            break
                        end
                    end

                    for y1 = 1, #self.curCombSkillInfo do
                        if y1 == index then
                            self.curCombSkillInfo[y1] = changeSkillInfo
                            break
                        end
                    end

                    if _G.AppSetting.IsXzns then
                        local dragBeastInfo = _G.DeepCopy(info[4])
                        local changeBeastInfo = _G.DeepCopy(item.BeastSkill)

                        for y0 = 1, #self.curBeastSkillInfo do
                            if y0 == item.Index then
                                self.curBeastSkillInfo[y0] = dragBeastInfo
                                break
                            end
                        end

                        for y1 = 1, #self.curBeastSkillInfo do
                            if y1 == index then
                                self.curBeastSkillInfo[y1] = changeBeastInfo
                                break
                            end
                        end
                    else
                        local dragPetInfo = _G.DeepCopy(info[3])
                        local changePetInfo = _G.DeepCopy(item.PetSkill)

                        for y0 = 1, #self.curPetSkillInfo do
                            if y0 == item.Index then
                                self.curPetSkillInfo[y0] = dragPetInfo
                                break
                            end
                        end

                        for y1 = 1, #self.curPetSkillInfo do
                            if y1 == index then
                                self.curPetSkillInfo[y1] = changePetInfo
                                break
                            end
                        end
                    end
                    isChanged = true
                    self.IsChange = true

                    self:UpdateView()
                end
            end
        end
    elseif type == 1 then
        self.DragCardIng = false
        self.go_table.obj_curCardParent:SetActiveE(0)
        if nil ~= self.CrossCard then
            self.CrossCard:DoCross(false)
            self.CrossCard = nil
        end
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            for i = 1, #item.selfCardList do
                if info.uid ~= item.selfCardList[i].Info.uid then
                    if not item.IsPass and item.selfCardList[i]:CheckInRange(x, y) then
                        _G.Log("可以交换卡片")

                        local changeTposInfo
                        local num = 0
                        for y0 = 1, #self.curEmBattleInfo do
                            if y0 == item.selfCardList[i].Index then
                                local team = self.curEmBattleInfo[y0]
                                for u = 1, #team do
                                    if u == item.selfCardList[i].Pos then
                                        changeTposInfo = team[u]
                                    end
                                    if team[u].uid > 0 then
                                        num = num + 1
                                    end
                                end
                            end
                        end

                        if
                            self.EmbattleControllerItemType == _G.EmbattleControllerItemType.SociatyBattleAttack or
                                self.EmbattleControllerItemType ==
                                    _G.EmbattleControllerItemType.SociatyBattleLeagueAttack
                         then
                            if item.selfCardList[i].Index ~= index then
                                if changeTposInfo.uid <= 0 then
                                    if num >= 3 then
                                        _G.LogError("公会战一队只能编辑3人")
                                        return
                                    end
                                end
                            end
                        end

                        local curTposInfo
                        for y1 = 1, #self.curEmBattleInfo do
                            if y1 == index then
                                local team = self.curEmBattleInfo[y1]
                                for u1 = 1, #team do
                                    if u1 == pos then
                                        local tposInfo = team[u1]
                                        curTposInfo = _G.DeepCopy(tposInfo)
                                        tposInfo.level = changeTposInfo.level
                                        tposInfo.power = changeTposInfo.power
                                        tposInfo.sid = changeTposInfo.sid
                                        tposInfo.soulLink_lv = changeTposInfo.soulLink_lv
                                        tposInfo.star = changeTposInfo.star
                                        tposInfo.tag = changeTposInfo.tag
                                        tposInfo.uid = changeTposInfo.uid
                                        break
                                    end
                                end
                            end
                        end

                        if curTposInfo.uid > 0 then
                            changeTposInfo.level = curTposInfo.level
                            changeTposInfo.power = curTposInfo.power
                            changeTposInfo.sid = curTposInfo.sid
                            changeTposInfo.soulLink_lv = curTposInfo.soulLink_lv
                            changeTposInfo.star = curTposInfo.star
                            changeTposInfo.tag = curTposInfo.tag
                            changeTposInfo.uid = curTposInfo.uid
                        else
                            changeTposInfo.level = 0
                            changeTposInfo.power = 0
                            changeTposInfo.sid = 0
                            changeTposInfo.soulLink_lv = 0
                            changeTposInfo.star = 0
                            changeTposInfo.tag = 0
                            changeTposInfo.uid = 0
                        end

                        self.IsChange = true

                        self:UpdateView()
                        break
                    end
                end
            end
        end
    elseif type == 2 then
        self.DragSkillIng = false
        self.go_table.obj_curSkillParent:SetActiveE(0)
        if nil ~= self.CrossSkill then
            self.CrossSkill:DoCross(false)
            self.CrossSkill = nil
        end
        for k = 1, #self.selfChangeList do
            local item = self.selfChangeList[k]
            for i = 1, #item.selfSkillList do
                item.selfSkillList[i]:DoLight(false)
                if
                    info.cskillID ~= item.selfSkillList[i].Info.cskillID and index ~= item.selfSkillList[i].Index and
                        pos == item.selfSkillList[i].Pos
                 then
                    if not item.IsPass and item.selfSkillList[i]:CheckInRange(x, y) then
                        _G.Log("可以交换技能")

                        local changeTposInfo
                        for y0 = 1, #self.curCombSkillInfo do
                            if y0 == item.selfSkillList[i].Index then
                                local team = self.curCombSkillInfo[y0]
                                for u = 1, #team do
                                    if u == item.selfSkillList[i].Pos then
                                        changeTposInfo = team[u]
                                        break
                                    end
                                end
                            end
                        end

                        local curTposInfo
                        for y1 = 1, #self.curCombSkillInfo do
                            if y1 == index then
                                local team = self.curCombSkillInfo[y1]
                                for u1 = 1, #team do
                                    if u1 == pos then
                                        local tposInfo = team[u1]
                                        curTposInfo = _G.DeepCopy(tposInfo)
                                        tposInfo.id = changeTposInfo.id
                                        tposInfo.cskillID = changeTposInfo.cskillID
                                        tposInfo.lv = changeTposInfo.lv
                                        tposInfo.tag = changeTposInfo.tag
                                        break
                                    end
                                end
                            end
                        end

                        if curTposInfo.cskillID > 0 then
                            changeTposInfo.id = curTposInfo.id
                            changeTposInfo.cskillID = curTposInfo.cskillID
                            changeTposInfo.lv = curTposInfo.lv
                            changeTposInfo.tag = curTposInfo.tag
                        else
                            changeTposInfo.id = 0
                            changeTposInfo.cskillID = 0
                            changeTposInfo.lv = 0
                            changeTposInfo.tag = 0
                        end

                        self.IsChange = true

                        self:UpdateView()

                        break
                    end
                end
            end
        end
    elseif type == 3 then
        if _G.AppSetting.IsXzns then
            self.DragPetIng = false
            self.go_table.obj_curPetParent:SetActiveE(0)
            if nil ~= self.CrossPet then
                self.CrossPet:DoCross(false)
                self.CrossPet = nil
            end

            local base = self.selfChangeList[index].selfBeastList[pos]
            for k = 1, #self.selfChangeList do
                --关闭特效显示
                local item = self.selfChangeList[k]
                for i = 1, #item.selfBeastList do
                    item.selfBeastList[i]:DoLight(false)
                end
                --检测交换数据
                if k ~= index then
                    local item, availableItems = findSameTypeAndFreeBeastItem(base, self.selfChangeList[k].selfBeastList)
                    if item then
                        availableItems = { item }
                    end
                    if availableItems then
                        local isOk = false
                        for _, item in ipairs(availableItems) do
                            if item and info ~= item.Info and not item.IsPass and item:CheckInRange(x, y) then
                                _G.Log("可以交换圣兽")

                                local changeTposInfo
                                for y0 = 1, #self.curBeastSkillInfo do
                                    if y0 == item.Index then
                                        local team = self.curBeastSkillInfo[y0]
                                        for u = 1, #team do
                                            if u == item.Pos then
                                                changeTposInfo = team[u]
                                                team[u] = info
                                                break
                                            end
                                        end
                                    end
                                end

                                for y1 = 1, #self.curBeastSkillInfo do
                                    if y1 == index then
                                        local team = self.curBeastSkillInfo[y1]
                                        for u1 = 1, #team do
                                            if u1 == pos then
                                                team[u1] = changeTposInfo
                                                break
                                            end
                                        end
                                    end
                                end
                                self.IsChange = true
                                self:UpdateView()

                                isOk = true
                                break
                            end
                        end
                        if isOk then
                            break
                        end
                    end
                end
            end
        else
            self.DragPetIng = false
            self.go_table.obj_curPetParent:SetActiveE(0)
            if nil ~= self.CrossPet then
                self.CrossPet:DoCross(false)
                self.CrossPet = nil
            end

            local base = self.selfChangeList[index].selfPetList[pos]
            for k = 1, #self.selfChangeList do
                --关闭特效显示
                local item = self.selfChangeList[k]
                for i = 1, #item.selfPetList do
                    item.selfPetList[i]:DoLight(false)
                end
                --检测交换数据
                if k ~= index then
                    local item, availableItems = findSameTypeAndFreePetItem(base, self.selfChangeList[k].selfPetList)
                    if item then
                        availableItems = { item }
                    end
                    if availableItems then
                        local isOk = false
                        for _, item in ipairs(availableItems) do
                            if item and info ~= item.Info and not item.IsPass and item:CheckInRange(x, y) then
                                _G.Log("可以交换灵宠")

                                local changeTposInfo
                                for y0 = 1, #self.curPetSkillInfo do
                                    if y0 == item.Index then
                                        local team = self.curPetSkillInfo[y0]
                                        for u = 1, #team do
                                            if u == item.Pos then
                                                changeTposInfo = team[u]
                                                team[u] = info
                                                break
                                            end
                                        end
                                    end
                                end

                                for y1 = 1, #self.curPetSkillInfo do
                                    if y1 == index then
                                        local team = self.curPetSkillInfo[y1]
                                        for u1 = 1, #team do
                                            if u1 == pos then
                                                team[u1] = changeTposInfo
                                                break
                                            end
                                        end
                                    end
                                end
                                self.IsChange = true
                                self:UpdateView()

                                isOk = true
                                break
                            end
                        end
                        if isOk then
                            break
                        end
                    end
                end
            end
        end
    end
end

function CommonChallengeTeamView:OnDestroy()
    if self.TipsTimer then
        self.TipsTimer:Stop()
        self.TipsTimer = nil
    end
end

---按钮点击事件在这里派发
function CommonChallengeTeamView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.IsChange then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                990101,
                nil,
                function()
                    self:Close()
                    if _G.AppSetting.IsXzns then
                        self.onChangeCall(self.curEmBattleInfo, self.curCombSkillInfo, self.curPetSkillInfo, self.curBeastSkillInfo)
                    else
                        self.onChangeCall(self.curEmBattleInfo, self.curCombSkillInfo, self.curPetSkillInfo)
                    end
                end,
                function()
                    self:Close()
                end
            )
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_Done then
        self:Close()
        if _G.AppSetting.IsXzns then
            self.onChangeCall(self.curEmBattleInfo, self.curCombSkillInfo, self.curPetSkillInfo, self.curBeastSkillInfo)
        else
            self.onChangeCall(self.curEmBattleInfo, self.curCombSkillInfo, self.curPetSkillInfo)
        end
    end
end

function CommonChallengeTeamView:OnLeagueChanged()
    self:Close()
end

return CommonChallengeTeamView
