---@class CommonUIEffect : Singleton	中文描述
local CommonUIEffect = _G.BaseClass("CommonUIEffect", _G.Singleton)
_G.CommonUIEffect = CommonUIEffect

---@return CommonUIEffect CommonUIEffect
function CommonUIEffect:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function CommonUIEffect:__init()
end

---销毁对象时,析构函数
function CommonUIEffect:Dispose()
end
---物体上升停留一段时间后渐隐消失
---@param trans  CS.UnityEngine.Transform 移动物体的transform
---@param posY number  上升或下降的高度
---@param Uptimer number 上升的时间
---@param stopTimer number 停留的时间
---@param fade any  渐隐的物体
---@param fadeTimer number 渐隐的时间
---@param callBack function 回调方法
function CommonUIEffect:UpAndFade(trans, posY, Uptimer, stopTimer, fade, fadeTimer, callBack)
    local upTween = trans:DOLocalMoveY(posY, Uptimer):SetEase(CS.DG.Tweening.Ease.Linear)

    local fadeTween =
        fade:DOFade(0, fadeTimer):SetEase(CS.DG.Tweening.Ease.Linear):OnComplete(_G.handler(self, callBack)):SetDelay(
        Uptimer + stopTimer
    ):SetUpdate(true)
    return upTween, fadeTween
end
---缩放
---@param trans CS.UnityEngine.Transform 移动物体的transform
---@param isShow boolean 当前是显示还是隐藏
---@param timer number 缩放的时间
---@param callBack function 回调方法
function CommonUIEffect:DoScale(trans, isShow, timer, callBack)
    local scale = trans:GetLocalScale()
    if isShow then
        trans:SetLocalScaleXYZ(scale * 0.5)
    else
        scale = scale * 0
    end
    trans:DOScale(scale, scale, scale, timer):OnComplete(_G.handler(self, callBack)):SetUpdate(true)
end

function CommonUIEffect:MoveList(list, moveEnd, moveTime, delay)
    for i = 1, #list do
        list[i]:DOLocalMoveX(moveEnd, moveTime):SetDelay((i - 1) * delay):SetUpdate(true)
    end
end
