---@class SpineClick    中文描述
local SpineClick = _G.BaseClass("SpineClick", _G.Component)
local CardUtils = require("CardUtils")

---类的构造函数
function SpineClick:__init(gameObject, spineParent, offPosX, offPosY, cardSid, onlickAnim, IdleAnim, Sound)
    self.gameObject = gameObject
    self.spineParent = spineParent
    self.cardSid = cardSid or 0
    self.spineSG = nil
    self.offPos = { offPosX, offPosY }
    self:AddComponent(gameObject, self)
    gameObject:GetComponentE(_G.typeof(_G.CS.AorButton)).onClick:AddListener(_G.handler(self, self.OnClick))

    if onlickAnim ~= nil then
        self.animName = onlickAnim
        self.animIdle = IdleAnim
        self.soundName = Sound
    end
end

function SpineClick:SetCardSid(cardSid)
    self.cardSid = cardSid or 0
end

function SpineClick:GetSpine()
    local count = self.spineParent:GetChildCountE()
    if count > 1 then
        if _G.AppSetting.DEBUG then
            _G.LogError("spine根目录存在一个以上游戏对象")
        end
        self.spineSG = nil
        return
    end

    self.spineSG = self.spineParent:GetComponentInChildrenE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
end

function SpineClick:SetPos(off)
    self.gameObject:SetLocalPosition(off[1] + self.offPos[1], off[2] + self.offPos[2], 0)
end

function SpineClick:ChangeCard(cardSid)
    self.cardSid = cardSid or 0
end

function SpineClick:SetParam(callback, notPlaySound)
    self.clickBack = callback
    self.notPlaySound = notPlaySound
end

function SpineClick:OnClick()
    local isOverLap, isNeedCheck, isHaveSkin, forceHeXie = false, false, false
    if self.cardSid ~= 0 then
        isOverLap, isNeedCheck, isHaveSkin, forceHeXie = _G.GameUtil.CheckSkinOverlap(self.cardSid)
        if isOverLap then
            return
        end
    end
    if self.animName ~= nil then
        self:GetSpine()
        if not self.spineSG then
            return
        end
        if _G.AppSetting.HeXieLevel <= 0 or (isNeedCheck and isHaveSkin and not forceHeXie) then
            self.spineSG.AnimationState:SetAnimation(0, self.animName, false)
            self.spineSG.AnimationState:AddAnimation(0, self.animIdle, true, 0)
        end
        self:PlaySound(nil, self.soundName)
        return
    end
    if self.cardSid == 0 then
        return
    end
    local cfg = _G.ConfigManager.card_show_cfg[self.cardSid] or _G.ConfigManager.skin_cfg[self.cardSid]
    if not cfg then
        return
    end

    if #cfg.display_click == 0 then
        -- 当配置表中没有配置点击动画时，直接返回
        return
    end

    self:GetSpine()
    if not self.spineSG then
        return
    end

    local click = cfg.display_click[1]
    local idle = cfg.display_idle[1]
    if not self:CheckSpine(click, idle) then
        return
    end

    if _G.AppSetting.HeXieLevel <= 0 or (isNeedCheck and isHaveSkin and not forceHeXie) then
        -- spine动画
        self.spineSG.AnimationState:SetAnimation(0, click, false)
        self.spineSG.AnimationState:AddAnimation(0, idle, true, 0)
    end

    if not self.notPlaySound then
        self:PlaySound(cfg.audio_enter)
        self:PlayOnlickAudio(cfg.id)
    end
    if self.clickBack then
        self.clickBack()
    end
end

-- 判断配置表中的动画是否存在
---@return boolean
function SpineClick:CheckSpine(click, idle)
    local haveClick, haveIdle = false, false
    local items = self.spineSG.Skeleton.Data.Animations.Items
    for i = 0, items.Length - 1 do
        if items[i].Name == click then
            haveClick = true
        end
        if items[i].Name == idle then
            haveIdle = true
        end
    end
    if not haveIdle or not haveClick then
        _G.LogError(not haveIdle and idle or click, "spine不存在配置表中的动画名")
        return false
    end
    return true
end
function SpineClick:PlayOnlickAudio(sid)
    --local cardCfg = ConfigManager.card_cfg[sid]
    --local isWear, skinId = require("CardCommentManager"):GetInstance():CardWearSkin(sid)
    local cfg = _G.ConfigManager.card_show_cfg[self.cardSid] or _G.ConfigManager.skin_cfg[self.cardSid]
    local interaction_enter = cfg and cfg.interaction_enter or nil
    if interaction_enter ~= nil then
        self:StopAudio(cfg)
        self:PlaySound(cfg.interaction_enter)
    end
end

function SpineClick:ClearSound()
    if self.ActionAudioArr ~= nil then
        for path, value in pairs(self.ActionAudioArr) do
            _G.AudioManager.StopSoundByPath(path)
            self.ActionAudioArr[path] = nil
        end
    end
    if self.LinesPath ~= nil then
        _G.AudioManager.Dialogue_StopPath(self.LinesPath)
    end
end
function SpineClick:PlaySound(audioCfg, soundPath)
    self:ClearSound()
    self.ActionAudioArr = {}
    if _G.string.IsNullOrEmpty(audioCfg) == false then
        local path = audioCfg
        if path ~= nil then
            self.ActionAudioArr[path] = true
            CardUtils.PlayRoleSound(path)
        end
    end
    if _G.string.IsNullOrEmpty(soundPath) == false then
        local path = soundPath
        if path ~= nil then
            self.LinesPath = path
            CardUtils.PlayRoleSound(path)
        end
    end
end

---@param cfg card_show_cfg
function SpineClick:StopAudio(cfg)
    _G.AudioManager.StopSoundByPath(cfg.interaction_enter)
    _G.AudioManager.StopSoundByPath(cfg.show_enter)
end

function SpineClick:OnDestroy()
    if not self.notPlaySound then
        self:ClearSound()
        AudioManager.RestoreBackgroundMusic()
    end
end

return SpineClick