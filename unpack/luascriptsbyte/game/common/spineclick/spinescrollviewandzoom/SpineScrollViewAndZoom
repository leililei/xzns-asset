---@class SpineScrollViewAndZoom : Component    中文描述
local SpineScrollViewAndZoom = _G.BaseClass("SpineScrollViewAndZoom", _G.Component)

---创建对象时,入口构造函数
function SpineScrollViewAndZoom:OnCreate(root, cfg, loadCall)
    self.root = root
    self:Init(cfg, loadCall)
end

function SpineScrollViewAndZoom:Init(cfg, loadCall)
    _G.PoolsManager:GetInstance():Spawn(
            "UIH5_xzns/Common/SpineScrollView",
            _G.ePoolType.Temporary,
            self.root,
            function(obj)
                if not self then
                    _G.DestroyObject(obj)
                    return
                end
                -- local scale = _G.AppSetting.SCREEN_WIDTH / 720
                -- obj:SetRectTransformSize(720,_G.math.max(1280,_G.AppSetting.SCREEN_HEIGHT / scale))
                obj:SetRectTransformSize(0, 0)
                self.go_table = _G.GetAutoGoTable(obj)
                if _G.AppSetting.IsXzns then
                    _G.GameUtil.SetUiHeXieMask(self.go_table, 3)
                end
                self.imagePinchZoom = obj:GetComponentE(_G.typeof(_G.CS.ImagePinchZoom))
                self:LoadSpine(cfg, loadCall)
            end
    )
end

function SpineScrollViewAndZoom:LoadSpine(cfg, loadCall)
    self.go_table.obj_root:ClearChildren()
    local _, _, z = self.go_table.gameObject:GetPosition()
    self.go_table.gameObject:SetPosition(0, 0, z)
    _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.obj_root,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
                self.imagePinchZoom:SetSpine(trans.gameObject)
                self.imagePinchZoom:ResetZoom()
                local spineCfg = _G.ConfigManager.card_show_cfg[cfg.id] or _G.ConfigManager.skin_cfg[cfg.id]
                local idle = spineCfg.display_idle[1]
                _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true, cfg.id)
                if loadCall then
                    loadCall(self.go_table.obj_content)
                end
            end
    )
end

return SpineScrollViewAndZoom