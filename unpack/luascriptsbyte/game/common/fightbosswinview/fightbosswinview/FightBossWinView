---@field public go_table FightBossWinView_GoTable GoTable
---@field public params FightBossWinView_Params 参数
local FightBossWinView = _G.BaseClass("FightBossWinView", _G.UIBaseView)
--_G.FightBossWinView = FightBossWinView
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local LanguageId = {
    --未上榜
    UnRank = 90022900040,
    --贡献值
    GongXian = 90001002601,
    --虚位以待
    NoRole = 90000010159
}

local EffectName = {
    ---成功特效
    Success = "ef_FightBossWinView_xjl"
}

---@class FightBossWinView_Params 参数
---@field playerRankData table {rank=1,value=2}玩家本次伤害
---@field rankDatas table {rank=1,value=2} 伤害排行榜
---@field icon string bossIcon
---@field name string boss名字
---@field type FightBossWinType type
---@field cardId number 角色id

function FightBossWinView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param params FightBossWinView_Params 参数
function FightBossWinView:OnCreate(params)
    UIUtils.IsNeedChangeUI(IsNeedChangeUI.FightBossWinView,self.go_table)
    self.params = params
    local tb = _G.PlayerPrefsManager.GetTable("FightBossWinDamage")
    --赛季boss改为显示伤害值
    --self.isGong = self.params.type == _G.FightBossWinType.SeasonBoss
    self.damage = tb.damage or 0
    self.maxDamage = tb.maxDamage or 0
    if self.params.type == _G.FightBossWinType.SeasonBoss then
        local cfg = require("SeasonModel"):GetInstance():GetBossCfg()
        self.posParams = cfg.monster_coefficient
    else
        for _, v in ipairs(_G.ConfigManager.discrete_cfg[101403]) do
            if v[1] == self.params.type then
                self.posParams = v
                break
            end
        end
    end

    -- if self.isGong then
    --     self.damage = _G.math.floor(self.damage / 10000)
    --     self.maxDamage = _G.math.floor(self.maxDamage / 10000)
    -- end
    self:ShowView()
end

---显示界面
function FightBossWinView:ShowView()
    if AppSetting.IsXzns and self.params.cardId then
        ---@type card_cfg
        local cfg = _G.ConfigManager.card_cfg[self.params.cardId]
        self.go_table.aorrawimage_boss:SetActiveE(0)
        require("CardInfoManager").GetRole(
                cfg.ModelPathHi,
            _G.ePoolType.UIItem,
            self.go_table.obj_spineNode,
            _G.RoleEffTypeEnum.RoleShow,
            function(trans)
                if trans == nil then
                    return
                end
                if self:IsNil() then
                    trans:DestroyObject()
                end
                trans:SetLocalScaleXYZ(cfg.size2)
                trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
                if _G.AppSetting.IsXzns then
                    local spineCfg = _G.ConfigManager.card_show_cfg[cfg.id] or _G.ConfigManager.skin_cfg[cfg.id]
                    if spineCfg then
                        local idle = spineCfg.display_idle[1]
                        _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true)
                    end
                    _G.GameUtil.SetUiHeXieMask(self.go_table)
                end
            end
        )
    else
        self.go_table.aorrawimage_boss:SetActiveE(1)
        self.go_table.aorrawimage_boss:LoadImage(
                self.params.icon,
                function(raw)
                    if raw then
                        raw:SetNativeSize()
                        if self.posParams then
                            raw:SetLocalPosition(self.posParams[2], self.posParams[3], self.posParams[4])
                            raw:SetLocalScaleXYZ(self.posParams[5])
                        end
                    end
                end
        )
    end
    UIUtils.SetUIModel(self.go_table.aorimage_nameBg,nil,self.go_table.aorimage_nameBg2)
    UIUtils.SetUIModelText(self.go_table.aortext_name,self.go_table.aortext_name2,self.params.name)
    local isRank = false
    local playerUid = _G.PlayerModel:GetInstance():GetPlayerUid()
    if self.damage > 0 then
        for i = 1, 3 do
            if self.params.rankDatas[i] then
                if self.params.rankDatas[i].role.uid == playerUid then
                    isRank = true
                    local otherParams = self.params.playerRankData.otherParams
                    if not _G.table.isEmptyOrNil(otherParams) then
                        if _G.tonumber(otherParams[2]) < _G.tonumber(self.damage) then
                            self.params.playerRankData.otherParams[2] = self.damage
                            --break
                        end
                        if _G.tonumber(self.params.rankDatas[i].value) < _G.tonumber(self.damage) then
                            self.params.rankDatas[i].value = self.damage
                            break
                        end
                    elseif _G.tonumber(self.params.rankDatas[i].value) < _G.tonumber(self.damage) then
                        self.params.rankDatas[i].value = self.damage
                        break
                    end
                end
            elseif not isRank then
                isRank = true
                self.params.rankDatas[i] = {
                    rank = i,
                    role = _G.PlayerModel:GetInstance():GetIRroleTable(),
                    value = self.damage
                }
                break
            end
        end
        if not isRank then
            _G.table.insert(
                self.params.rankDatas,
                {
                    rank = #self.params.rankDatas + 1,
                    role = _G.PlayerModel:GetInstance():GetIRroleTable(),
                    value = self.damage
                }
            )
        end
    end
    _G.SortList(
        self.params.rankDatas,
        function(a, b)
            local damage = a.value or a.otherParams and a.otherParams[2] or 0
            local lv = a.otherParams and a.otherParams[1] or 0
            return tonumber(lv), tonumber(damage), -tonumber(a.rank)
        end
    )
    for i, v in ipairs(self.params.rankDatas) do
        if v.role.uid == playerUid then
            self.params.playerRankData.rank = i
            v.role.rank = i
            break
        end
    end
    self.go_table.aortext_closeText:DOFade(0.2, 1):SetLoops(-1, CS.DG.Tweening.LoopType.Yoyo)
    self:ShowRank()
    self:ShowPlayerInfo()
end

---显示排名
function FightBossWinView:ShowRank()
    for i = 1, 3 do
        self:ShowSingleRank(self.go_table["obj_rank" .. i], self.params.rankDatas[i])
    end
end

function FightBossWinView:ShowSingleRank(obj, data)
    ---@type FightBossWinView._obj_rank1_GoTable
    local tb = GetAutoGoTable(obj)
    if not data then
        tb.aorimage_noRole:SetActiveE(1)
        tb.obj_HeadItemBase:SetActiveE(0)
        tb.aortext_name.text = GetLangPackValue(LanguageId.NoRole)
        tb.aortext_value:SetActiveE(0)
        tb.aortext_title:SetActiveE(0)
        tb.obj_difficulty:SetActiveE(0)
    else
        tb.aorimage_noRole:SetActiveE(0)
        tb.obj_HeadItemBase:SetActiveE(1)
        _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role or {}, 1, true, true, true)
        tb.aortext_name.text = data.role.name
        tb.aortext_value:SetActiveE(1)
        tb.aortext_title:SetActiveE(1)
        if data.otherParams and data.otherParams[2] then
            tb.aortext_value.text = _G.GameUtil.NumberToUnitStrBag(data.otherParams[2] or 0)
        else
            tb.aortext_value.text = _G.GameUtil.NumberToUnitStrBag(data.value or 0, false)
        end
        tb.obj_difficulty:SetActiveE(data.otherParams and data.otherParams[1] and 1 or 0)
        if data.otherParams and data.otherParams[1] then
            tb.aortext_difficulty.text = _G.GameUtil.FormatRomeNum(data.otherParams[1])
        end
    end
    -- if self.isGong then
    --     tb.aortext_title.text = GetLangPackValue(LanguageId.GongXian)
    -- end
end

---显示
function FightBossWinView:ShowPlayerInfo()
    local player = self.params.playerRankData or {}
    ---@type FightBossWinView._obj_player_GoTable
    local tb = GetAutoGoTable(self.go_table.obj_player)
    _G.UIUtils.SetPlayerHeadItemNew(
        tb.obj_HeadItemBase,
        _G.PlayerModel:GetInstance():GetIRroleTable(),
        1,
        true,
        true,
        true
    )
    tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
    if player.otherParams and player.otherParams[2] then
        local damage = player.otherParams[2]
        if type(damage) ~= "number" then
            damage = tonumber(damage)
        end
        tb.aortext_value.text = _G.GameUtil.NumberToUnitStrBag(damage)
        tb.aorimage_new:SetActiveE(damage > self.maxDamage and 1 or 0)
    else
    tb.aortext_value.text = _G.GameUtil.NumberToUnitStrBag(self.damage or 0, false)
        tb.aorimage_new:SetActiveE(self.damage > self.maxDamage and 1 or 0)
    end
    if player.rank and player.rank > 0 then
        tb.aortext_rankNum.text = player.rank
    else
        tb.aortext_rankNum.text = GetLangPackValue(LanguageId.UnRank)
    end

    if player.otherParams and player.otherParams[1] then
        tb.aortext_difficulty.text = _G.GameUtil.FormatRomeNum(player.otherParams[1] or 1)
    end
    tb.obj_difficulty:SetActiveE(player.otherParams and player.otherParams[1] and 1 or 0)

    -- if self.isGong then
    --     tb.aortext_title.text = GetLangPackValue(LanguageId.GongXian)
    -- end
    --ZHJH-4297 取消对应特效调用
    --_G.UIUtils.LoadEffectByCfg(
    --    _G.ConfigManager.ui_effect_cfg[EffectName.Success],
    --    tb.aorimage_new,
    --    function(effect)
    --        if self:IsNil() then
    --            _G.DestroyObject(effect)
    --        end
    --    end
    --)
end

---按钮点击事件在这里派发
function FightBossWinView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return FightBossWinView
