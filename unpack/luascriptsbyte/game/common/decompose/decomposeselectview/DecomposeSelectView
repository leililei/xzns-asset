---@class DecomposeSelectView : UIBaseView	中文描述
---@field public go_table DecomposeSelectView_GoTable GoTable
local DecomposeSelectView = _G.BaseClass("DecomposeSelectView", _G.UIBaseView)
--_G.DecomposeSelectView = DecomposeSelectView

local CS = _G.CS
local typeof = _G.typeof

function DecomposeSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecomposeSelectView:OnCreate(title, gradeList, gradeNameList, chooseList, call, id)
    self.call = call
    self.chooseList = chooseList or {}
    self.gradeList = gradeList
    self.gradeNameList = gradeNameList
    self.id = id
    self:InitGradeItem()
    self.go_table.aortext_title.text = title
end

function DecomposeSelectView:InitGradeItem()
    for _, v in pairs(self.gradeList) do
        self.go_table["aorbtn_" .. v]:SetActiveE(1)
        self.go_table["aorimage_" .. v]:SetActiveE(self.chooseList[v] and 1 or 0)
        if self.gradeNameList[v] then
            self.go_table["aortext_" .. v].text = self.gradeNameList[v]
        end
    end
end

---按钮点击事件在这里派发
function DecomposeSelectView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_queding then
        if self.call then
            self.call(self.chooseList)
        end
        self:Close()
    else
        local name = go:GetName()
        local str = _G.string.replace(name, "@_aorbtn_", "")
        local num = _G.tonumber(str)
        if num then
            if self.id and self.id == _G.StorageID.Equipment and not self.chooseList[num] then
                for _, v in pairs(self.gradeList) do
                    if num >= v and not self.chooseList[v] then
                        self:OnChooseGrade(v)
                    end
                end
            else
                self:OnChooseGrade(num)
            end
        end
    end
end

function DecomposeSelectView:OnChooseGrade(num)
    if self.chooseList[num] then
        self.go_table["aorimage_" .. num]:SetActiveE(0)
        self.chooseList[num] = nil
    else
        self.go_table["aorimage_" .. num]:SetActiveE(1)
        self.chooseList[num] = true
    end
end

return DecomposeSelectView
