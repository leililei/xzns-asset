---@class DocomposeInfoData
---@field data BaseDecomposeData
local DocomposeInfoData = _G.BaseClass("DocomposeInfoData")

local DataTypes

function DocomposeInfoData:__init(ID)
    self.List = {}
    if _G.AppSetting.IsOverseas then
        DataTypes = {
            [_G.StorageID.Equipment] = "EquipmentDecomposeData",
            [_G.StorageID.Decoration] = "DecorationDecomposeData"
        }
    else
        DataTypes = {
            [_G.StorageID.Artifact] = "ArtifactDecomposeData",
            [_G.StorageID.Equipment] = "EquipmentDecomposeData",
            [_G.StorageID.Spiritual] = "SpiritualDecomposeData",
            [_G.StorageID.Prop] = "PetDecomposeData",
            [_G.StorageID.Build] = "BuildDecomposeData",
            [_G.StorageID.Decoration] = "DecorationDecomposeData",
            [_G.StorageID.Remains] = "RemainsDecomposeData",
            [_G.ItemCfgType.BeastChip] = "BeastDecomposeData"
        }
    end
    self:Init(ID)
end

---初始化
function DocomposeInfoData:Init(ID)
    if not DataTypes[ID] then
        LogError("没有找到对应的分解数据ID:" .. ID)
        return
    end
    self.data = require(DataTypes[ID]).New()
end

---获取数据
---@return BaseItemData[]
function DocomposeInfoData:UpdateDatas()
    self.data:InitDatas()
    return self.data:GetDatas()
end

---获取数据
---@return BaseItemData[]
function DocomposeInfoData:GetDatas()
    return self.data:GetDatas()
end

---获取分解材料
function DocomposeInfoData:GetDecomposition()
    if _G.table.isEmptyOrNil(self.List) then
        LogWarning("没有选择分解的材料")
        return {}
    end
    return self.data:GetDecomposeition(self.List)
end

---设置数量
function DocomposeInfoData:ChangeNum(uid, num)
    if num <= 0 then
        self.List[uid] = nil
    else
        self.List[uid] = num
    end
end

---获取数量
function DocomposeInfoData:GetNum(uid)
    return self.List[uid] or 0
end

---分解
function DocomposeInfoData:Decompose(call)
    self.data:Decompose(self.List, function(msg)
        self.List = {}
        if call then
            call(msg)
        end
    end)
end

---获取品质列表
function DocomposeInfoData:GetGradeList()
    return self.data:GetGradeList() or {}
end

---获取品质文本列表
function DocomposeInfoData:GetGradeNameList()
    return self.data:GetGradeNameList() or {}
end

---标题
function DocomposeInfoData:GetTitle()
    return self.data:GetTitle()
end

---标题
function DocomposeInfoData:GetSelectTitle()
    return self.data:GetSelectTitle()
end

function DocomposeInfoData:GetTips()
    return self.data:GetTips()
end

---获取无物品时文本
function DocomposeInfoData:GetNothingText()
    return self.data:GetNothingText()
end

---是否显示勾选框
---@return boolean
function DocomposeInfoData:IsShowAutoToggle()
    return self.data:IsShowAutoToggle()
end

---勾选框状态以及文本显示
---@return boolean,string
function DocomposeInfoData:GetAutoToggle()
    return self.data:GetAutoToggle()
end

---勾选框状态以及文本显示
---@param isOn boolean
function DocomposeInfoData:SetAutoToggle(isOn)
    self.data:SetAutoToggle(isOn)
end

return DocomposeInfoData
