local BaseAwardNewItem = require "BaseAwardNewItem"
local DocomposeInfoData = require "DocomposeInfoData"
---@class DecomposeView : UIBaseView    中文描述
---@field public go_table DecomposeView_GoTable GoTable
---@field DecomposeSingleDatas table<uid,table>  uid,单个消耗
---@field previewItemList table<sid,ItemBaseView> 预览物体
---@field infoData DocomposeInfoData 分解数据
local DecomposeView = _G.BaseClass("DecomposeView", _G.UIBaseView)
---@type StorageManager
local StorageManager
local GetAutoGoTable = _G.GetAutoGoTable
local insert = _G.table.insert

function DecomposeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---@field ID StorageID[] 数据类型
---@field DeComposeCall function 分解回调
---@class DecomposeView_Prams 分解参数

---界面的入口函数
---@param ID StorageID 数据类型
---@param datas BaseItemData[] 数据
function DecomposeView:OnCreate(id, params)
    local newId = _G.tonumber(id)
    self.newId = newId
    StorageManager = _G.StorageManager:GetInstance()
    -- self.DeComposeCall = params and params.DeComposeCall
    self.itemList = {}
    self.previewDatas = {}
    self.previewItemList = {}
    self.DecomposeSingleDatas = {}
    self.cacheKey = tostring(_G.PlayerModel:GetInstance().role_uid) .. id .. "SelectRank"
    self:InitParams(newId, params)
    -- self.go_table.aorrawimage_gjsy:LoadImage(
    --     self.infoData:GetTitle(),
    --     function(raw)
    --         if raw then
    --             raw:SetNativeSize()
    --         end
    --     end
    -- )
    self.go_table.aortext_title.text = self.infoData:GetTips()
    self.go_table.scrollloopvectical_Items:InitItemData(#self.Datas, _G.handler(self, self.RefereshItemList))
    self.go_table.aortext_nothingDes.text = self.infoData:GetNothingText()
    if #self.Datas <= 0 then
        self.go_table.obj_Noting:SetActiveE(1)
    else
        self.go_table.obj_Noting:SetActiveE(0)
    end

    local isShowToggle = self.infoData:IsShowAutoToggle()
    self.go_table.obj_auto:SetActiveE(isShowToggle and 1 or 0)
    if isShowToggle then
        self.initToggle = true
        local isOn, desc = self.infoData:GetAutoToggle()
        self.go_table.toggle_auto.isOn = isOn
        self.go_table.aortext_autoDesc.text = desc
        self.initToggle = false
    end
end

---初始化参数
---@param params DecomposeView_Prams 分解参数
function DecomposeView:InitParams(id, params)
    if params then
        if params.DeComposeCall then
            self.DeComposeCall = params.DeComposeCall
        end
        if params.ToggleCall then
            self.ToggleCall = params.ToggleCall
        end
        if params.titleText then
            self.go_table.aortext_title1.text = _G.GetLangPackValue(params.titleText)
        end
    end
    self.id = id
    self.infoData = DocomposeInfoData.New(self.id) -- ,params.ID)
    -- params.ID
    self:UpdateData()
end

---更新数据
function DecomposeView:UpdateData()
    self.Datas = self.infoData:GetDatas()
    _G.SortList(self.Datas, function(a)
        if self.id == _G.StorageID.Prop then
            return a.Grade, a.count, a.sid
        elseif self.id == _G.StorageID.Remains then
            return a.sid
        end
        return -a:GetGrade(), a:GetCount(), a.sid
    end)
end

function DecomposeView:RefereshItemList(index, obj)
    local id = obj:GetInstanceIDE()
    local data = self.Datas[index + 1]
    local tb = GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
    tb.data = data
    if not tb.item then
        tb.item = BaseAwardNewItem.New(tb.obj_node, nil, 88, tb.obj_node)
    end
    tb.item:Show(data, function()
        if self.id == _G.StorageID.Artifact then
            tb.item.item:HideCount()
        elseif self.id == _G.StorageID.Build then
            tb.item.item:ShowNumText(false)
            -- _G.LogError(itemLua)
            -- tb.aorimage_element.SpriteName = ColorType[self.cfg.Order]
            -- tb.item.item:ShowElement()
        elseif self.id == _G.StorageID.Remains then
            tb.item.item:ShowNumText(false)
        end

        if self.id == _G.StorageID.Prop then
            tb.item.item:ShowNumText(false)
        end
        if self.id == 22 then
            tb.item.item:ShowNumText(false)
        end
    end)
    self:SetLoopItem(tb)
    tb.aorbtn_click.LongPress = true
    tb.aorbtn_click.onLongPress = _G.handlerbind(self, self.OnLongPress_Add, tb)
end

---@param isInit boolean true第一次生成 Item信息已初始化
function DecomposeView:SetLoopItem(itemGoTable)
    if itemGoTable == nil then
        return
    end

    ---@type EquipmentItem
    local ItemData = itemGoTable.data
    ---@type ItemEquipmentBase
    local lua
    ---@type ItemViewBase
    lua = itemGoTable.lua
    itemGoTable.data = ItemData
    itemGoTable.gameObject:SetName(ItemData.uid or ItemData.sid)
    self:SetItemNum(itemGoTable)
end

function DecomposeView:SetItemNum(itemGoTable)
    local ItemData = itemGoTable.data
    local num = self.infoData:GetNum(ItemData.uid or ItemData.sid)
    _G.UIUtils.SetItemNum_EquItemNum(itemGoTable, num, itemGoTable.data.count)
    itemGoTable.aorbtn_reduce:SetActiveE(num > 0 and 1 or 0)
end

function DecomposeView:OnClickItem(go, _, itemGoTable)
    if go == itemGoTable.aorbtn_click then
        self:Click_Item(itemGoTable)
    elseif go == itemGoTable.aorbtn_reduce then
        self:ReduceItem(itemGoTable)
    end
end

function DecomposeView:Click_Item(itemGoTable)
    ---@type EquipmentItem
    local ItemData = itemGoTable.data
    self:SelectOneItem(ItemData)
    self:SetItemNum(itemGoTable)
end

function DecomposeView:ReduceItem(itemGoTable)
    ---@type EquipmentItem
    local ItemData = itemGoTable.data
    local num = self.infoData:GetNum(ItemData.uid or ItemData.sid)
    if num <= 0 then
        return
    end

    self:SelectOneItem(ItemData, -1)
    self:SetItemNum(itemGoTable)
end

function DecomposeView:OnLongPress_Add(tb)
    self:Click_Item(tb)
end

---选择一格装备
------@param ItemData EquipmentItem
---@return boolean false不能在选(for时判断换格)
function DecomposeView:SelectOneItem(ItemData, num)
    local uid = ItemData.uid or ItemData.sid
    local nowNum
    -- 判断是否存在
    nowNum = self.infoData:GetNum(uid)
    if nowNum == nil then
        nowNum = 0
    end
    if num ~= nil then
        nowNum = nowNum + num
    else
        nowNum = nowNum + 1
    end
    if nowNum > ItemData.count then
        --- 数量不可超出
        return false
    end
    self.infoData:ChangeNum(uid, nowNum)
    self:OnPreview()
    if nowNum + 1 >= ItemData.count then
        --- 数量不可超出
        return false
    end
    return true
end

---分解预览
function DecomposeView:OnPreview()
    self.previewDatas = self.infoData:GetDecomposition()
    for _, v in pairs(self.previewItemList) do
        if v ~= true then
            v.go_table.gameObject:SetActiveE(0)
        end
    end
    for _, v in pairs(self.previewDatas) do
        if self.previewItemList[v[1]] then
            if v[2] > 0 then
                self.previewItemList[v[1]]:ShowCount(v[2])
                self.previewItemList[v[1]].go_table.gameObject:SetActiveE(1)
            end
        elseif v[2] > 0 and self.previewItemList[v[1]] ~= true then
            self.previewItemList[v[1]] = true
            StorageManager:GetItemBaseViewNew(v, self.go_table.trans_content, function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                self.previewItemList[v[1]] = item
                item.go_table.gameObject:SetRectTransformSize(88, 88)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end)
        end
    end
end

function DecomposeView:GetGrade(Grade)
    if not self.GradeList then
        local cfg = _G.ConfigManager.discrete_cfg[114407]
        self.GradeList = {}
        for i, v in ipairs(cfg) do
            self.GradeList[v[1]] = i
        end

        return self.GradeList[Grade]
    end

    return self.GradeList[Grade]
end

---
---@protected
function DecomposeView:CheckData(select)
    if self.newId == _G.StorageID.Artifact then
        local isSelect = true
        for _, v in pairs(self.Datas) do
            local Grade = v:GetGrade()
            if select[Grade] then
                if v.cfg.card_id and v.cfg.card_id > 0 then
                    isSelect = false
                    break
                end
            end
        end
        if isSelect == false then
            _G.PopWindowManager:GetInstance():ShowAllTips(270602, nil, function()
                self:Select(select)
            end)
        else
            self:Select(select)
        end
    else
        self:Select(select)
    end
end

function DecomposeView:Select(select)
    self.select = select
    for _, v in pairs(self.Datas) do
        local Grade = v:GetGrade()
        ---灵兽碎片是道具，且品质需要转换成宠物的品质，所以特殊处理
        if self.newId == _G.StorageID.Prop then
            Grade = self:GetGrade(Grade)
        end

        if self.newId == _G.StorageID.Build then
            if Grade == 8 then
                Grade = 7
            end
        end
        if select[Grade] then
            self.infoData:ChangeNum(v.uid or v.sid, v.count)
        else
            self.infoData:ChangeNum(v.uid or v.sid, 0)
        end
    end
    self:OnPreview()
    self.go_table.scrollloopvectical_Items:UpdateAllItem()
    _G.PlayerPrefsManager.SetTable(self.cacheKey, self.select)
end

---界面的销毁函数
function DecomposeView:OnDestroy()
end

---按钮点击事件在这里派发
function DecomposeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_screen then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeSelectView.Name,
            self.infoData:GetSelectTitle(), self.infoData:GetGradeList(), self.infoData:GetGradeNameList(),
            self:GetSelectRank(), _G.handler(self, self.CheckData), self.newId)
    elseif go == self.go_table.aorbtn_Decompose then
        self:Decompose()
    elseif go == self.go_table.toggle_auto then
        if not self.initToggle then
            self.infoData:SetAutoToggle(isOn)
            if self.ToggleCall then
                self.ToggleCall(isOn)
            end
        end
    elseif go == self.go_table.aorbtn_anyClose then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function DecomposeView:UpdateView(isForce)
    if isForce then
        -- 清除DocomposeInfoData缓存信息
        self.infoData.List = {}
        self.infoData:UpdateDatas()
    end
    self:UpdateData()
    self:OnPreview()
    self.go_table.scrollloopvectical_Items:UpdateCount(#self.Datas)
end

function DecomposeView:Decompose()
    self.infoData:Decompose(function(msg)
        StorageManager:ReceiveAwardData(msg)
        require"CommonTipManager".OpenCommonAwardView(msg)
        self:UpdateView()
        if self.DeComposeCall then
            self.DeComposeCall()
        end
        if #self.Datas == 0 then
            self:Close()
        end
    end)
end

---获取缓存的选中品质
function DecomposeView:GetSelectRank()
    if _G.table.isEmptyOrNil(self.select) then
        local selectData = _G.PlayerPrefsManager.GetTable(self.cacheKey)
        return selectData or {}
    end

    return self.select
end

return DecomposeView
