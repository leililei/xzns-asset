local SpiritualModel = require("SpiritualModel")

local base = require "BaseDecomposeData"
---@class SpiritualDecomposeData	中文描述
local SpiritualDecomposeData = _G.BaseClass("SpiritualDecomposeData", base)

function SpiritualDecomposeData:__init()
end

function SpiritualDecomposeData:InitDatas()
    local data = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual, _G.ArtifactType.NoWear)
    self.datas = {}
    self.SpiritualList = {}
    for _, v in pairs(data) do
        if not v.unlock or v.unlock == 0 then
            _G.table.insert(self.datas, v)
            self.SpiritualList[v.uid] = {uid = v.uid, num = 0, order = v.cfg.Order, sid = v.sid}
        end
    end
    _G.SortList(
        self.datas,
        function(a)
            return -a.cfg.Order, a.count, a.sid
        end
    )
end

---获取分解后的材料
---@param uids table<number,number> uid 数量  要分解的uid
function SpiritualDecomposeData:GetDecomposeition(uids)
    local materialDic = {}
    local tb = {}
    local count = _G.table.count(uids)
    for k, v in pairs(uids) do
        tb[k] = v
    end
    local material
    for _, v in ipairs(self.datas) do
        if tb[v.uid] then
            material = v:GetDecomposeData()
            for _, m in pairs(material) do
                if materialDic[m[1]] == nil then
                    materialDic[m[1]] = 0
                end
                materialDic[m[1]] = materialDic[m[1]] + m[2] * tb[v.uid]
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local datas = {}
    for k, v in pairs(materialDic) do
        _G.table.insert(datas, {k, v})
    end
    return datas
end

---分解
---@param uids table<number,number>  uid,数量
function SpiritualDecomposeData:Decompose(uids, call)
    local Spiritual_List = {}
    local value = false
    for k, v in pairs(uids) do
        local data = {uid = k, num = v}
        if self.SpiritualList[k].order >= 3 then
            value = true
        end
        table.insert(Spiritual_List, data)
    end
    if #Spiritual_List == 0 then
        return
    end
    if value then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            920104,
            nil,
            _G.handlerbind(self, self.OnDecompose, Spiritual_List, call)
        )
    else
        self:OnDecompose(Spiritual_List, call)
    end
end

function SpiritualDecomposeData:OnDecompose(Spiritual_List, call)
    SpiritualModel:GetInstance():Decompose(
        Spiritual_List,
        function(msg)
            local StorageManager = _G.StorageManager:GetInstance()
            for _, v in pairs(Spiritual_List) do
                StorageManager:ConsumeItem(self.SpiritualList[v.uid].sid, v.uid, v.num)
            end
            self:InitDatas()
            if call then
                call(msg)
            end
        end
    )
end

