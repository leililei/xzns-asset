end
---获取分解tips
function EquipmentDecomposeData:GetTips()
    return _G.GetLangPackValue(9002020023)
end

---获取无物品时文本
function EquipmentDecomposeData:GetNothingText()
    return _G.GetLangPackValue(90021800105)
end

return EquipmentDecomposeData
