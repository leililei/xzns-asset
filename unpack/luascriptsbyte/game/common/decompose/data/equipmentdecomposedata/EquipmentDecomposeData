local base = require "BaseDecomposeData"
---@class EquipmentDecomposeData	中文描述
---@field datas EquipmentItem[] 分解的数据
local EquipmentDecomposeData = _G.BaseClass("EquipmentDecomposeData", base)

function EquipmentDecomposeData:__init()
    self.param = _G.DeepCopyCfgTable(_G.ConfigManager.discrete_cfg[104902])
    self.scale = _G.ConfigManager.discrete_cfg[104901][1][1] / 10000
    _G.table.sort(
        self.param,
        function(a, b)
            return a[2] > b[2]
        end
    )
end

function EquipmentDecomposeData:InitDatas()
    self.datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    ---@param v EquipmentItem
    self.datas =
        _G.table.chooseToArray(
        self.datas,
        function(_, v)
            return v.cardUid == 0 and v.Grade < 8
        end
    )
end

---获取分解后的材料
---@param uids table<number,number> uid 数量  要分解的uid
function EquipmentDecomposeData:GetDecomposeition(uids)
    local exp = 0
    local strenExp = 0
    local tb = {}
    local count = _G.table.count(uids)
    for k, v in pairs(uids) do
        tb[k] = v
    end
    for _, v in ipairs(self.datas) do
        if tb[v.uid] then
            exp = exp + v.cfg.decomposition * tb[v.uid]
            if v.streng > 0 then
                strenExp = v:GetEquipCurStrengCfg().points_up + (v.strengExp or 0)
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local total_exp = exp + strenExp * self.scale
    local num
    local floor = math.floor
    local datas = {}
    for _, v in ipairs(self.param) do
        if total_exp > 0 then
            num = floor(total_exp / v[2])
            total_exp = total_exp - v[2] * num
            _G.table.insert(datas, {v[1], num})
        end
    end
    return datas
end

---分解
---@param uids table<number,number>  uid,数量
function EquipmentDecomposeData:Decompose(uids, call)
    local tb = {}
    local insert = _G.table.insert
    for k, v in pairs(uids) do
        if v > 0 then
            insert(tb, {uid = k, num = v})
        end
    end
    if #tb > 0 then
        require "EquipmentNet":GetInstance():Decompose(
            {ce = tb},
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                local StorageManager = _G.StorageManager:GetInstance()
                local data
                for _, v in ipairs(tb) do
                    data = StorageManager:GetDatasByUid(_G.StorageID.Equipment, v.uid)
                    StorageManager:ConsumeItem(data.sid, v.uid, v.num)
                end
                self:InitDatas()
                if call then
                    call(msg)
                end
            end
        )
    end
end

function EquipmentDecomposeData:GetGradeList()
    return _G.ConfigManager.discrete_cfg[111001][1]
end

---获取一键选择标题
function EquipmentDecomposeData:GetSelectTitle()
    return _G.GetLangPackValue(90023400065)
end

---获取分解标题
function EquipmentDecomposeData:GetTitle()
