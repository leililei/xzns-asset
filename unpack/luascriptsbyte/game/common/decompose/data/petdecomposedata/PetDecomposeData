local PetModel = require("PetModel")

local base = require("BaseDecomposeData")
---@class PetDecomposeData : BaseDecomposeData	灵兽碎片分解
local PetDecomposeData = _G.BaseClass("PetDecomposeData", base)
local table = _G.table

function PetDecomposeData:InitDatas()
    self.datas = {}
    self.petList = {}
    local model = require("PetModel"):GetInstance()
    if table.isEmptyOrNil(self.petDebrisList) then
        self.petDebrisList = model:GetDebrisCfgs()
    end
    for _, v in pairs(self.petDebrisList) do
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, v.ID)
        if not table.isEmptyOrNil(data) then
            table.insert(self.datas, data)
            self.petList[v.ID] = data
        end
    end

    ---品质对应的离散表分解材料id
    if not self.materialList then
        self.materialList = {}
        for _, v in pairs(_G.ConfigManager.discrete_cfg[114407]) do
            self.materialList[v[1]] = v[2]
        end
    end

    if not self.showTipRank then
        self.showTipRank = _G.ConfigManager.discrete_cfg[114408][1]
    end
end

---获取分解后的材料
---@param sids table<number,number> sid 数量  要分解的uid
function PetDecomposeData:GetDecomposeition(sids)
    local materialDic = {}
    local tb = {}
    local count = table.count(sids)
    for k, v in pairs(sids) do
        tb[k] = v
    end
    local material
    for _, v in ipairs(self.datas) do
        if tb[v.sid] then
            material = _G.ConfigManager.discrete_cfg[self.materialList[v.Grade]]
            for _, m in pairs(material) do
                if not materialDic[m[1]] then
                    materialDic[m[1]] = 0
                end
                materialDic[m[1]] = materialDic[m[1]] + m[2] * tb[v.sid]
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local datas = {}
    for k, v in pairs(materialDic) do
        table.insert(datas, {k, v})
    end
    return datas
end

---分解
---@param sids table<number,number>  sid,数量
function PetDecomposeData:Decompose(sids, call)
    local pet_List = {}
    local value = false
    for k, v in pairs(sids) do
        local data = {sid = k, num = v}
        if not value and table.indexof(self.showTipRank, self.petList[k].Grade) then
            value = true
        end
        table.insert(pet_List, data)
    end
    if #pet_List == 0 then
        return
    end
    if value then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            914101,
            nil,
            _G.handlerbind(self, self.OnDecompose, pet_List, call)
        )
    else
        self:OnDecompose(pet_List, call)
    end
end

function PetDecomposeData:OnDecompose(pet_List, call)
    require("PetModel"):GetInstance():DebrisDecompose(
        pet_List,
        function(msg)
            self:InitDatas()
            if call then
                call(msg)
            end
        end
    )
end

function PetDecomposeData:GetGradeList()
    return _G.ConfigManager.discrete_cfg[111001][4]
end

