local base = require "BaseDecomposeData"
---@class DecorationDecomposeData	中文描述
---@field datas DecorationData[] 分解的数据
local DecorationDecomposeData = _G.BaseClass("DecorationDecomposeData", base)
function DecorationDecomposeData:__init()
    self.param = _G.DeepCopyCfgTable(_G.ConfigManager.discrete_cfg[102902])
    self.scale = _G.ConfigManager.discrete_cfg[102901][1][1] / 10000
    _G.table.sort(
        self.param,
        function(a, b)
            return a[2] > b[2]
        end
    )
end

function DecorationDecomposeData:InitDatas(force)
    self.datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    ---@param v DecorationData
    self.datas =
        _G.table.chooseToArray(
        self.datas,
        function(_, v)
            return v.cardUid == 0 and not v.isLock
        end
    )
end

---获取分解后的材料
---@param uids table<number,number> uid 数量  要分解的uid
function DecorationDecomposeData:GetDecomposeition(uids)
    local exp = 0
    local strenExp = 0
    local tb = {}
    local count = _G.table.count(uids)
    for k, v in pairs(uids) do
        tb[k] = v
    end
    for _, v in ipairs(self.datas) do
        if tb[v.uid] then
            exp = exp + v.cfg.decomposition * tb[v.uid]
            if v.streng > 0 then
                strenExp = strenExp + v:GetCurExp()
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local total_exp = exp + strenExp * self.scale
    local num
    local floor = math.floor
    local datas = {}
    for _, v in ipairs(self.param) do
        if total_exp > 0 then
            num = floor(total_exp / v[2])
            total_exp = total_exp - v[2] * num
            _G.table.insert(datas, {v[1], num})
        end
    end
    return datas
end

---分解
---@param uids table<number,number>  uid,数量
function DecorationDecomposeData:Decompose(uids, call)
    local tb = {}
    local insert = _G.table.insert
    for k, v in pairs(uids) do
        if v > 0 then
            insert(tb, k)
        end
    end
    if #tb > 0 then
        require "DecorationNet":GetInstance():Decompose(
            {uids = tb},
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                local StorageManager = _G.StorageManager:GetInstance()
                local data
                for _, v in ipairs(tb) do
                    data = StorageManager:GetDatasByUid(_G.StorageID.Decoration, v)
                    StorageManager:ConsumeItem(data.sid, v, 1)
                end
                self:InitDatas(true)
                if call then
                    call(msg)
                end
            end
        )
    end
end

