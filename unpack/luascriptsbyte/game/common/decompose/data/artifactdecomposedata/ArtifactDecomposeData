local ArtifactModel = require("ArtifactModel")

local base = require "BaseDecomposeData"
---@class ArtifactDecomposeData	中文描述
local ArtifactDecomposeData = _G.BaseClass("ArtifactDecomposeData", base)

function ArtifactDecomposeData:__init()
end

function ArtifactDecomposeData:InitDatas()
    local data = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
    local insert = table.insert
    self.datas = {}
    self.ArtifactList = {}
    for k, v in pairs(data) do
        insert(self.datas, v)
        self.ArtifactList[v.uid] = {uid = v.uid, num = 0, order = v.cfg.Order, sid = v.sid}
    end
    _G.SortList(
        self.datas,
        function(a)
            return -a.cfg.Order, a.count, a.sid
        end
    )
end

---获取分解后的材料
---@param uids table<number,number> uid 数量  要分解的uid
function ArtifactDecomposeData:GetDecomposeition(uids)
    local materialDic = {}
    local tb = {}
    local count = _G.table.count(uids)
    for k, v in pairs(uids) do
        tb[k] = v
    end
    local material
    for _, v in ipairs(self.datas) do
        if tb[v.uid] then
            material = v:GetDecomposeData()
            for _, m in pairs(material) do
                if materialDic[m[1]] == nil then
                    materialDic[m[1]] = 0
                end
                materialDic[m[1]] = materialDic[m[1]] + m[2] * tb[v.uid]
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local datas = {}
    for k, v in pairs(materialDic) do
        _G.table.insert(datas, {k, v})
    end
    return datas
end

---分解
---@param uids table<number,number>  uid,数量
function ArtifactDecomposeData:Decompose(uids, call)
    local Artifact_List = {}
    local value = false
    for k, v in pairs(uids) do
        local data = {uid = k, num = v}
        if self.ArtifactList[k].order == 3 then
            value = true
        end
        table.insert(Artifact_List, data)
    end
    if #Artifact_List == 0 then
        return
    end
    if value then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            270601,
            nil,
            _G.handlerbind(self, self.OnDecompose, Artifact_List, call)
        )
    else
        self:OnDecompose(Artifact_List, call)
    end
end

function ArtifactDecomposeData:OnDecompose(Artifact_List, call)
    ArtifactModel:GetInstance():Decompose(
        Artifact_List,
        function(msg)
            local StorageManager = _G.StorageManager:GetInstance()
            for k, v in pairs(Artifact_List) do
                StorageManager:ConsumeItem(self.ArtifactList[v.uid].sid, v.uid, v.num)
            end
            self:InitDatas()
            if call then
                call(msg)
            end
        end
    )
end

