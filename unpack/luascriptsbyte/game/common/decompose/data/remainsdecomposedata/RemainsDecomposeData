local base = require("BaseDecomposeData")
---@class RemainsDecomposeData : BaseDecomposeData	遗物碎片分解
local RemainsDecomposeData = _G.BaseClass("RemainsDecomposeData", base)
local table = _G.table

function RemainsDecomposeData:InitDatas()
    self.datas = {}
    self.RemainsList = {}
    local model = require("RemainsModel"):GetInstance()
    if table.isEmptyOrNil(self.DebrisList) then
        self.DebrisList = model:GetDebrisCfgs()
    end
    for _, v in pairs(self.DebrisList) do
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Remains, v.ID)
        if not table.isEmptyOrNil(data) then
            local itemCfg = _G.ConfigManager.item_cfg[data.sid]

            if #itemCfg.UseParameter2 > 0 then

                local remainID = itemCfg.UseParameter2[1][1]
                local remainsData = model:GetData(remainID)
                if remainsData:GetStar() >= remainsData.cfg.degrade_star then
                    table.insert(self.datas, data)
                    self.RemainsList[v.ID] = data
                end
            end

        end
    end

    ---品质对应的离散表分解材料id
    if not self.materialList then
        self.materialList = {}
        for _, v in pairs(_G.ConfigManager.discrete_cfg[306005]) do
            self.materialList[v[1]] = v[2]
        end
    end

    if not self.showTipRank then
        self.showTipRank = _G.ConfigManager.discrete_cfg[306006][1]
    end
end

---获取分解后的材料
---@param sids table<number,number> sid 数量  要分解的uid
function RemainsDecomposeData:GetDecomposeition(sids)
    local materialDic = {}
    local tb = {}
    local count = table.count(sids)
    for k, v in pairs(sids) do
        tb[k] = v
    end
    local material
    for _, v in ipairs(self.datas) do
        if tb[v.sid] then
            local itemCfg = _G.ConfigManager.item_cfg[v.sid]

            material = _G.ConfigManager.discrete_cfg[self.materialList[itemCfg.Quality]]
            for _, m in pairs(material) do
                if not materialDic[m[1]] then
                    materialDic[m[1]] = 0
                end
                materialDic[m[1]] = materialDic[m[1]] + m[2] * tb[v.sid]
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local datas = {}
    for k, v in pairs(materialDic) do
        table.insert(datas, {k, v})
    end
    return datas
end

---分解
---@param sids table<number,number>  sid,数量
function RemainsDecomposeData:Decompose(sids, call)
    local Build_List = {}
    local value = false
    for k, v in pairs(sids) do
        local data = {
            key = k,
            value = v
        }
        if not value and table.indexof(self.showTipRank, self.RemainsList[k].Grade) then
            value = true
        end
        table.insert(Build_List, data)
    end
    if #Build_List == 0 then
        return
    end
    if value then
        _G.PopWindowManager:GetInstance():ShowAllTips(914101, nil,
            _G.handlerbind(self, self.OnDecompose, Build_List, call))
    else
        self:OnDecompose(Build_List, call)
    end
end

function RemainsDecomposeData:OnDecompose(Build_List, call)
    require("RemainsModel"):GetInstance():DebrisDecompose(Build_List, function(msg)
        self:InitDatas()
        if call then
            call(msg)
        end
    end)
end

