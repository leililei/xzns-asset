local base = require("BaseDecomposeData")
---@class BuildDecomposeData : BaseDecomposeData	灵兽碎片分解
local BuildDecomposeData = _G.BaseClass("BuildDecomposeData", base)
local table = _G.table

function BuildDecomposeData:InitDatas()
    self.datas = {}
    self.BuildList = {}
    local model = require("BuildDrawModel"):GetInstance()
    if table.isEmptyOrNil(self.BuildDebrisList) then
        self.BuildDebrisList = model:GetDebrisCfgs()
    end
    for _, v in pairs(self.BuildDebrisList) do
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, v.ID)
        if not table.isEmptyOrNil(data) and data.Grade < 7 then
            table.insert(self.datas, data)
            self.BuildList[v.ID] = data
        end
    end

    ---品质对应的离散表分解材料id
    if not self.materialList then
        self.materialList = {}
        for _, v in pairs(_G.ConfigManager.discrete_cfg[126604]) do
            self.materialList[v[1]] = v[2]
        end
    end

    if not self.showTipRank then
        self.showTipRank = _G.ConfigManager.discrete_cfg[126609][1]
    end
end

---获取分解后的材料
---@param sids table<number,number> sid 数量  要分解的uid
function BuildDecomposeData:GetDecomposeition(sids)
    local materialDic = {}
    local tb = {}
    local count = table.count(sids)
    for k, v in pairs(sids) do
        tb[k] = v
    end
    local material
    for _, v in ipairs(self.datas) do
        if tb[v.sid] then
            material = _G.ConfigManager.discrete_cfg[self.materialList[v.Grade]]
            for _, m in pairs(material) do
                if not materialDic[m[1]] then
                    materialDic[m[1]] = 0
                end
                materialDic[m[1]] = materialDic[m[1]] + m[2] * tb[v.sid]
            end
            count = count - 1
            if count <= 0 then
                break
            end
        end
    end
    local datas = {}
    for k, v in pairs(materialDic) do
        table.insert(datas, { k, v })
    end
    return datas
end

---分解
---@param sids table<number,number>  sid,数量
function BuildDecomposeData:Decompose(sids, call)
    local Build_List = {}
    local value = false
    for k, v in pairs(sids) do
        local data = { sid = k, num = v }
        if not value and table.indexof(self.showTipRank, self.BuildList[k].Grade) then
            value = true
        end
        table.insert(Build_List, data)
    end
    if #Build_List == 0 then
        return
    end
    if value then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            914101,
            nil,
            _G.handlerbind(self, self.OnDecompose, Build_List, call)
        )
    else
        self:OnDecompose(Build_List, call)
    end
end

function BuildDecomposeData:OnDecompose(Build_List, call)
    require("BuildDrawModel"):GetInstance():DebrisDecompose(
        Build_List,
        function(msg)
            self:InitDatas()
            if call then
                call(msg)
            end
        end
    )
end

function BuildDecomposeData:GetGradeList()
    return _G.ConfigManager.discrete_cfg[126610][1]
end

