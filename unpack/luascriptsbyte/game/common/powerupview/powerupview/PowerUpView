---@class PowerUpView : UIBaseView	中文描述
---@field public go_table PowerUpView_GoTable GoTable
local PowerUpView = _G.BaseClass("PowerUpView", _G.UIBaseView)
--_G.PowerUpView = PowerUpView

--特效最多3个
local MAX_ITEM_COUNT = 3

function PowerUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param power number 更改前战力
---@param addPower number 增加的战力
function PowerUpView:OnCreate(power, addPower)
    self.count = 0
    self.Items = {}
    self.delay = _G.ConfigManager.discrete_cfg[120017][1][1]
    self:Show(power, addPower)
end

function PowerUpView:GetOrCreateItem()
    -- 找空闲的
    for _, item in ipairs(self.Items) do
        if not item._inUse then
            item._inUse = true
            return item
        end
    end

    -- 检查是否超过3个的限制
    if #self.Items >= MAX_ITEM_COUNT then
        local oldItem = self.Items[1]
        self:DestroyItem(oldItem)
        table.remove(self.Items, 1)
    end

    -- 创建新的
    local newItem = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_PowerUpItem, self.transform))
    newItem._inUse = true
    table.insert(self.Items, newItem)
    return newItem
end

function PowerUpView:Show(power, addPower)
    self.count = self.count + 1
    ---@type PowerUpView._obj_PowerUpItem_GoTable
    local go_table = self:GetOrCreateItem()
    go_table.gameObject:SetActiveE(1)
    go_table.aortext_nor_power.text = self:NumToStr(power)
    local isAdd = addPower > 0 and 1 or 0
    go_table.aortext_nor_powerup:SetActiveE(isAdd)
    go_table.aortext_nor_powerdown:SetActiveE(isAdd == 0 and 1 or 0)

    if isAdd == 1 then
        go_table.aortext_nor_powerup.text = "+" .. self:NumToStr(addPower)
    else
        go_table.aortext_nor_powerdown.text = self:NumToStr(addPower)
    end

    self:ShowPowerUpEffect(go_table)

    _G.DelayDo(
            self.delay,
            function()
                if self:IsNil() then
                    return
                end
                self:ShowEnd(go_table)
            end
    )
end

function PowerUpView:ShowPowerUpEffect(go_table)
    -- 战力提升特效
    if not go_table._eff1 then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_zhanlitisheng,
                go_table.gameObject,
                function(trans)
                    if self:IsNil() or not go_table or not go_table.gameObject then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLocalPosition(208, -127, 0)
                    go_table._eff1 = trans
                end
        )
    else
        go_table._eff1:SetActiveE(0)
        go_table._eff1:SetActiveE(1)
    end

    -- 持续光特效
    if not go_table._eff2 then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_chixuguang,
                go_table.gameObject,
                function(trans)
                    if self:IsNil() or not go_table or not go_table.gameObject then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLocalPosition(208, -127, 0)
                    go_table._eff2 = trans
                end
        )
    else
        go_table._eff2:SetActiveE(0)
        go_table._eff2:SetActiveE(1)
    end
end

function PowerUpView:ShowEnd(go_table)
    go_table.gameObject:SetActiveE(0)
    go_table._inUse = false
    self.count = self.count - 1
    if self.count <= 0 then
        self:Close()
    end
end

function PowerUpView:NumToStr(num)
    if not num then
        return ""
    end
    -- num = _G.string.lower(_G.GameUtil.NumberToUnitStrFight(num))
    if num < 0 then
        return "-" .. _G.GameUtil.NumberToUnitStrFight(math.abs(num))
    end
    return _G.GameUtil.NumberToUnitStrFight(num)
end

function PowerUpView:DestroyItem(go_table)
    -- 释放特效
    if go_table._eff1 then
        _G.DestroyObject(go_table._eff1)
        go_table._eff1 = nil
    end
    if go_table._eff2 then
        _G.DestroyObject(go_table._eff2)
        go_table._eff2 = nil
    end

    _G.DestroyObject(go_table.gameObject)
end

function PowerUpView:OnDestroy()
    -- body
end

---按钮点击事件在这里派发
function PowerUpView:OnClickBtn()
end

return PowerUpView
