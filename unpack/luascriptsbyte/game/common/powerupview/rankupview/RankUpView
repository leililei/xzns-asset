---@class RankUpView : UIBaseView	中文描述
---@field public go_table RankUpView_GoTable GoTable
local RankUpView = _G.BaseClass("RankUpView", _G.UIBaseView)

function RankUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param content string 文本
function RankUpView:OnCreate(content)
    self.count = 0
    self.Items = {}
    self.contentLis = {}
    self.delay = _G.ConfigManager.discrete_cfg[120017][1][1]
    self:AddOne(content)
    self:ShowOne()
end

function RankUpView:ShowOne()
    local content = _G.table.remove(self.contentLis, 1)
    ---@type RankUpView._obj_RankUpItem_GoTable
    local go_table = self.Items[1]
    if not go_table then
        go_table = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_RankUpItem, self.transform))
    end
    if content == nil then
        self:ShowEnd(go_table)
        return
    end
    go_table.gameObject:SetActiveE(1)
    go_table.aortext_content.text = content
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_zhanlitisheng,go_table.gameObject,
    function (obj)
        obj:SetLocalPosition(208,-127,0)   
    end)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_chixuguang,go_table.gameObject,
    function (obj)
        obj:SetLocalPosition(208,-127,0)   
    end)
    
    _G.DelayDo(
        self.delay,
        function()
            if self:IsNil() then
                return
            end
            self:ShowEnd(go_table)
        end
    )
end

function RankUpView:ShowEnd(go_table)
    _G.table.insert(self.Items, go_table)
    go_table.gameObject:SetActiveE(0)
    self.count = self.count - 1
    if self.count <= 0 then
        self:Close()
    else
        self:ShowOne()
    end
end

function RankUpView:AddOne(content)
    self.count = self.count + 1
    _G.table.insert(self.contentLis, content)
end

function RankUpView:OnDestroy()
    -- body
end

---按钮点击事件在这里派发
function RankUpView:OnClickBtn()
end

return RankUpView
