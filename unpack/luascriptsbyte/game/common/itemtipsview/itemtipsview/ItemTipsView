---@class ItemTipsView : UIBaseView
local ItemTipsView = BaseClass("ItemTipsView", UIBaseView)

--region -------------成员函数-------------
function ItemTipsView:Awake()
    AddViewBtnClick(self.go_table.gameObject, handler(self, self.OnClick))
    Events:GetInstance().AddListener(eMessageNames.CloseItemInfoView, self.Close, self)
end

---启动
function ItemTipsView:OnCreate(cfg, pos, count, loadFinishEvent)
    ---用ItemHelper.OpenItemTips(传参数)来打开
    --数据整理
    self.mObj = cfg
    self.showData = ItemInfoViewData.New()

    self.panel = self.go_table.obj_Panel:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.ItemPoint = self.go_table.obj_ItemPos:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self._onTimer = nil
    self:InitPanel(pos, count)
    if (loadFinishEvent) then
        loadFinishEvent(self)
    end
end

function ItemTipsView:InitPanel(pos, count)
    local data = self.mObj
    local configType = data.id ~= nil and ItemHelper.GetItemConfigName(data.id) or ""
    if configType == "ArmamentConfig" then
        ---ArmamentData传配置
        self.showData.name = Lang.GetLang(data.name)
        self.showData.desc = Lang.GetLang(data.describe)
        self.showData.count = ""
    elseif configType == "WeaponConfig" then
        ---RoleWeaponInfo传配置
        ---@type @SoldierType _type
        local _type, _lv = WeaponModel:GetInstance():KeyConvertBack(data.id)
        self.showData.name = Lang.GetLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(_lv)
        self.showData.desc = Lang.GetLang(data.describe)
        self.showData.count = ""
    elseif configType == "RoleConfig" then
        ---RoleConfig
        self.showData.name = Lang.GetLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        self.showData.desc = Lang.GetLang(data.describe)
        self.showData.count = ""
        self.showData.iconPath = data.icon
        self.showData.iconQulity = data.quality
    elseif configType == "PeasantConfig" then
        ---农民
        self.showData.name = Lang.GetLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        self.showData.desc = Lang.GetLang(data.describe)
        self.showData.count = ""
    elseif configType == "ItemConfig" then
        --elseif iskindof(data, "OnlineGiftConfig") then
        --    self.showData.name = data.name
        --    self.showData.nameColor = Color.white
        --    self.showData.count = ""
        --    self.showData.desc = data.describe
        ---ItemData传配置
        self.showData.name = Lang.GetLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        ---@type @ItemType
        local _type = data.showType
        --武将碎片
        if _type == ItemType.heroFragment then
            local count = BagManager:GetInstance():GetItemDataCountBySid(data.id)
            local _CompoundConfig = ConfigManager.CompoundConfig[data.roleId]
            local compoundNeedCount = _CompoundConfig.CostPropArray[1][2]
            local _roleConfig = ConfigManager.RoleConfig[_CompoundConfig.id]
            local name = ColorTools.HandlerTextAddColorForquality(_roleConfig.quality, Lang.getLang(_roleConfig.name))
            self.showData.desc = Lang.Get("Common_HeroPieceDesc", count, compoundNeedCount, name)
            self.showData.count = ""
            self.go_table.aorbtn_InfoBtn:SetActiveE(1)
            SetEventTrigger(
                self,
                self.go_table.aorbtn_InfoBtn,
                "onClick",
                function()
                    self:ShowHeroInfo(_roleConfig)
                end
            )
        else
            self.showData.desc = Lang.GetLang(data.describe)
            if GameUtils.IdInEnum(ResType, data.id) then
                self.showData.count = ""
            else
                self.showData.count =
                    Lang.Get("Bag_HasCount_1", BagManager:GetInstance():GetItemDataCountBySid(data.id))
            end
        end
    elseif configType == "MountEquipConfig" then
        self.showData.name = Lang.GetLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        self.showData.desc = Lang.GetLang(data.describe)
        if GameUtils.IdInEnum(ResType, data.id) then
            self.showData.count = ""
        else
            self.showData.count = Lang.Get("Bag_HasCount_1", BagManager:GetInstance():GetItemDataCountBySid(data.id))
        end
    elseif configType == "MountConfig" then
        self.showData.name = Lang.GetLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        self.showData.desc = Lang.GetLang(data.describe)
    elseif configType == "BuffConfig" then
        self.showData.name = Lang.getLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        self.showData.count = ""
        self.showData.desc = Lang.GetLang(data.describe)

        self.showData.iconPath = data.icon
        self.showData.iconQulity = data.quality
    elseif configType == "LaborConfig" then
        self.showData.name = Lang.getLang(data.name)
        self.showData.nameColor = GameUtils.GetColorByQuality(data.quality)
        self.showData.desc = Lang.GetLang(data.describe)
    elseif iskindof(data, "Json_Goods") then
        self.showData.name = Lang.getLang(data.Name)
        self.showData.nameColor = GameUtils.GetColorByQuality(0)
        self.showData.count = ""
        self.showData.desc = ""
    elseif iskindof(data, "ItemInfoViewData") then
        self.showData = data
    end
    --数据显示
    self.go_table.aortext_Name.text = self.showData.name
    self.go_table.aortext_Name.color = self.showData.nameColor
    self.go_table.aortext_Count.text = self.showData.count
    self.go_table.aortext_Desc.text = self.showData.desc
    self.go_table.aortext_timerTip.text = self.showData.timerTip

    if #self.showData.iconPath > 0 then
        self:SetViewTransForItem()
        if self.showData.iconPath == "" then
            return
        end
        ItemHelper.ReChildrenItemComponents(
            self.ItemPoint,
            FullItem,
            1,
            function(item)
                item:RefreshItem(FullItem.NewParam(data.id))
            end
        )
    else
        self:SetPanelSizeForDesc()
    end
    self:SetShowPosition(pos)
    self:OnTimer()
    self.go_table.aortext_Count:SetActiveE(count and 1 or 0)
end

function ItemTipsView:SetPanelSizeForDesc()
    self.panel:SetRectTransformSize(544.3, Mathf.Max(163, self.go_table.aortext_Desc.preferredHeight + 75))
end

---@field RoleConfig @config
function ItemTipsView:ShowHeroInfo(config)
    CommonModel:GetInstance():OpenHeroInfoWindow(config)
    self:Close()
end

function ItemTipsView:OnTimer()
    self.go_table.aortext_timerTip.text = ""
    if IsNil(self.showData.timerTip) then
        return
    end
    local queueData = MSGQuequeManager:GetInstance():GetMSGQueue(self.showData.queueSid, self.showData.queueType)
    if IsNil(queueData) then
        return
    end
    self.go_table.aortext_timerTip.text =
        self.showData.timerTip .. GameUtils.ConvertSecondSTo_h_m_s(queueData:LeftTime())
    if IsNil(self._onTimer) then
        self._onTimer = TimerManager:GetInstance():GetTimer(1, self.OnTimer, self, false)
        self._onTimer:Start()
    end
end

function ItemTipsView:SetViewTransForItem()
    self.ItemPoint:SetLocalScaleXYZ(0.6)
    self.ItemPoint.anchoredPosition3D = Vector2.New(48.6, -82.9)

    self.go_table.aortext_Name.rectTransform.anchoredPosition3D = Vector3.New(14.7, -25, 0)
    --self.go_table.aortext_Count.rectTransform.anchoredPosition3D = Vector3.New(-64.7, -27.5, 0)
    self.go_table.aortext_Desc.rectTransform:SetRectTransformSize(281, 60)
    self.go_table.aortext_Desc.rectTransform.anchoredPosition3D = Vector3.New(-106.8, -50, 0)
    if self.go_table.aortext_Desc.preferredHeight >= 60 then
        self.panel:SetRectTransformSize(410, Mathf.Min(180, self.go_table.aortext_Desc.preferredHeight + 75))
    else
        self.panel:SetRectTransformSize(410, 60 + 75)
    end
end

function ItemTipsView:SetShowPosition(pos)
    if not Guard.NotNull(pos) then
        return
    end
    local viewPos = UIManager:GetInstance().UICamera:WorldToViewportPoint(pos)
    if viewPos.x == 0.5 and viewPos.y == 0.5 then
        self.panel:SetPivotPosition(0.5, 0)
    else
        if viewPos.x == 0.5 then
            local x = (viewPos.y > 0.5) and 1 or 0
            self.panel:SetPivotPosition(x, 0.5)
        elseif viewPos.y == 0.5 then
            local y = (viewPos.x > 0.5) and 1 or 0
            self.panel:SetPivotPosition(0.5, y)
        else
            -- 第一象限
            if viewPos.x > 0.5 and viewPos.y > 0.5 then
                -- 第二象限
                self.panel:SetPivotPosition(1, 1)
            elseif viewPos.x < 0.5 and viewPos.y > 0.5 then
                -- 第三象限
                self.panel:SetPivotPosition(0, 1)
            elseif viewPos.x < 0.5 and viewPos.y < 0.5 then
                -- 第四象限
                self.panel:SetPivotPosition(0, 0)
            elseif viewPos.x > 0.5 and viewPos.y < 0.5 then
                self.panel:SetPivotPosition(1, 0)
            end
        end
    end

    local configType = self.mObj.id ~= nil and ItemHelper.GetItemConfigName(self.mObj.id) or ""
    if configType == "ArmamentConfig" then
        self.panel:SetPivotPosition(0, 1)
    end
    self.panel:SetPosition(pos.x, pos.y, pos.z)
end

function ItemTipsView:OnClick(go)
    local name = go:GetName()
    if name == "$_aorbtn_CloseBtn" then
        self:Close()
    end
end

function ItemTipsView:Close(...)
    UIManager:GetInstance():CloseWindow(ConfigManager.ui_cfg.ItemTipsView.Name)
end

function ItemTipsView:OnDestroy()
    if not IsNil(self._onTimer) then
        self._onTimer:Stop()
    end
    self._onTimer = nil

    Events:GetInstance().RemoveListener(eMessageNames.CloseItemInfoView, self.Close, self)
end
--endregion

return ItemTipsView
