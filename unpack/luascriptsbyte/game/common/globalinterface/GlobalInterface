---新手引导播放剧情
function GlobalInterface.PlayStory(id)
    if GlobalInterface.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(GlobalInterface.WiatCoroutine)
        GlobalInterface.WiatCoroutine = nil
    end
    local function wiat()
        -- body
        local window

        while _G.IsNil(window) do
            window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            _G.coroutine.yield()
        end
        while _G.IsNil(window.View.gameObject) do
            _G.coroutine.yield()
        end

        window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        while not _G.IsNil(window) and not _G.IsNil(window.View) and not _G.IsNil(window.View.gameObject) and
            window.View.gameObject:GetActiveSelf() == 1 do
            window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
            _G.coroutine.yield()
        end

        if _G.AppSetting.DEBUG then
            _G.Log("触发引导剧情>>>>>>>>>>")
        end
        _G.AutomaticPlayStory.PlayStoryByID(tonumber(id))
        GlobalInterface.WiatCoroutine = nil
    end

    if _G.JumpManager:GetInstance().IsJumping then
        if _G.AppSetting.DEBUG then
            _G.Log("如果是跳转切到主城就不走剧情>>>>")
        end
        return
    end

    if GlobalInterface.WiatCoroutine == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("引导播放剧情需要主界面存在协程开启>>>>")
        end
        GlobalInterface.WiatCoroutine = _G.coroutine.start(wiat)
    end
end

--招募引导特效亮起
function GlobalInterface.PlayYindaoeffect()
    if GlobalInterface.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(GlobalInterface.WiatCoroutine)
        GlobalInterface.WiatCoroutine = nil
    end
    local function wiat()
        -- body
        local window
        while _G.IsNil(window) do
            window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SummonAnimationView.Name)
            _G.coroutine.yield()
        end
        while _G.IsNil(window.View.gameObject) do
            _G.coroutine.yield()
        end
        while 0 == window.View.gameObject:GetActiveSelf() do
            _G.coroutine.yield()
        end

        if _G.AppSetting.DEBUG then
            _G.Log("触发招募特效>>>>>>>>>>")
        end
        if window then
            window.View:Yindaoeffect()
        end
        GlobalInterface.WiatCoroutine = nil
    end

    if GlobalInterface.WiatCoroutine == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("引导招募特效执行等待界面协程开启>>>>")
        end
        GlobalInterface.WiatCoroutine = _G.coroutine.start(wiat)
    end
end

