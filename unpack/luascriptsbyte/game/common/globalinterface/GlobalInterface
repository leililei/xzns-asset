---怪物来袭
---@param index? number 怪物波次
function GlobalInterface.OpenMonsterShow(colseCall, monsterGroupID, notShow, index)
    local closeFun = colseCall
    ---@type params_MonsterShowView
    local data = {}
    data.closeCall = function()
        if closeFun ~= nil then
            closeFun()
            closeFun = nil
        end
    end
    data.monsterGroupID = monsterGroupID
    data.index = index

    local notShowBossCome = notShow or false
    ---@type monster_group_cfg
    local monster_group_cfg_Item = _G.ConfigManager.monster_group_cfg[monsterGroupID]
    if
        monster_group_cfg_Item == nil or monster_group_cfg_Item.BossCome == nil or
        monster_group_cfg_Item.BossCome[1] == nil or
        notShowBossCome
    then
        if index then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SociatyBattleStartView.Name)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SociatyBattleStartView.Name,
                index,
                data.closeCall
            )
        else
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.BattleStartEffect,
                _G.UIManager:GetInstance():GetUILayerTrans("TopLayer"),
                function()
                    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
                end,
                function()
                    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
                    _G.CS.BattleManager.Inst:LuaCallCsCacheRes()
                    if data.closeCall ~= nil then
                        data.closeCall()
                        data.closeCall = nil
                    end
                end
            )
        end
        return
    end

    local value = _G.PlayerPrefsManager.GetTable("MonsterShowiView")
    if value then
        value[#value + 1] = monsterGroupID
        _G.PlayerPrefsManager.SetTable("MonsterShowiView", value)
    else
        _G.PlayerPrefsManager.SetTable("MonsterShowiView", { [1] = monsterGroupID })
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MonsterShowView.Name, data)
end

