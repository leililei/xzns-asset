---返回新表
---@generic T
---@param obj T 目标对象
---@param deep boolean 深度复制(可选参数, 默认false)
---@param metatable boolean 复制metatable信息(可选参数, 默认false)
---@return T
function GlobalInterface.GetNewTable(obj, deep, metatable)
    if not obj or type(obj) ~= "table" then
        return obj
    end
    ---@type fun(v: T):T
    local copy
    if deep then
        local resolves = {}
        copy = function(value)
            if type(value) ~= "table" then
                return value
            elseif resolves[value] then
                return resolves[value]
            end
            local newValue = {}
            resolves[value] = newValue
            for _k, _v in pairs(value) do
                newValue[copy(_k)] = copy(_v)
            end
            if metatable then
                setmetatable(newValue, getmetatable(value))
            end
            return newValue
        end
    end

    local result = {}
    for k, v in pairs(obj) do
        result[k] = copy and copy(v) or v
    end
    if metatable then
        setmetatable(result, getmetatable(obj))
    end
    return result
end

---打开讨伐界面
---@param activity_id number 活动id
---@param ZoneType ZoneRankType 总榜类型
---@param name string 名字
---@param playerData table 玩家数据
---@param icon string boss立绘
---@param rankData table 排行榜数据
---@param cardId number 角色id
function GlobalInterface.OpenFightBossWinView(type, rankData, playerData, icon, name, ZoneType, activity_id, cardId)
    if ZoneType then
        ---@type FightBossWinView_Params
        local data = {
            type = type,
            icon = icon,
            name = name,
            playerRankData = {},
            rankDatas = {},
            cardId = cardId,
        }
        ---@param msg ZoneRankSingleSelfData
        require "ZoneRankModel":GetInstance():GetOutZoneSelfRankInfo(
            ZoneType,
            activity_id,
            function(msg)
                if msg then
                    local params = msg.otherParams or msg:GetParmams()
                    data.playerRankData.rank = msg:GetRank()
                    data.playerRankData.value = tonumber(params[#params])
                    data.playerRankData.otherParams = params
                end
                --data.playerRankData = msg
                local dan = (not msg.dan or msg.dan == 0) and 1 or msg.dan
                ---@param zonDatas ZoneRankData[]
                require "ZoneRankModel":GetInstance():GetOutZoneRankInfo(
                    ZoneType,
                    1,
                    msg.zone or -1,
                    activity_id,
                    dan,
                    function(zonDatas)
                        if zonDatas then
                            for i = 1, #zonDatas do
                                local params = zonDatas[i].otherParams or zonDatas[i]:GetParmams()
                                data.rankDatas[i] = {
                                    rank = zonDatas[i]:GetRank(),
                                    role = zonDatas[i]:GetRoleInfo(),
                                    value = tonumber(params[#params]),
                                    otherParams = params
                                }
                            end
                        end
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FightBossWinView.Name, data)
                    end
                )
            end
        )
    else
        local data = {}
        data.rankDatas = rankData
        data.playerData = playerData
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FightBossWinView.Name, data)
    end
end

