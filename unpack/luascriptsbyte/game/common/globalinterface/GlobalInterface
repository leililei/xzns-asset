---功能开启进入跳转
function GlobalInterface.OpenFunctionsView(id)
    if GlobalInterface.WiatCoroutine ~= nil then
        _G.coroutine.stopwaiting(GlobalInterface.WiatCoroutine)
        GlobalInterface.WiatCoroutine = nil
    end
    local function wiat()
        -- body
        local isMain = _G.MainManager:GetInstance().isInMainView

        while false == isMain do
            isMain = _G.MainManager:GetInstance().isInMainView
            _G.coroutine.yield()
        end

        if _G.AppSetting.DEBUG then
            _G.Log("触发功能开放提示添加到最界面队列>>>>")
        end

        local MainOpenViewFunItem = {}

        MainOpenViewFunItem.OpenViewFun = function()
            local functionData = _G.FunctionData.New()
            functionData.touchType = _G.FunctionTouchType.PlayerLevel
            functionData.callBack = function()
            end
            functionData.functions = { id }
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.OpenFunctionsView.Name, functionData)
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.FunctionOpen)

        GlobalInterface.WiatCoroutine = nil
    end

    if GlobalInterface.WiatCoroutine == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("引导回到主界面等待功能开放提示加到隊列协程开启>>>>")
        end
        GlobalInterface.WiatCoroutine = _G.coroutine.start(wiat)
    end
end

