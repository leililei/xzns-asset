---@class roleViewBase	用于角色、怪物list    Create 单个item
---@field public go_table BaseItemView_GoTable GoTable
local roleViewBase = _G.BaseClass("roleViewBase", _G.IRecycle)
_G.roleViewBase = roleViewBase

local CS = _G.CS
local typeof = _G.typeof
local itemPrefabPath = "UIH5/Common/ItemView/BaseItemView"
local itemColorIconName = {
    "ui_ty_box_kuang_1",
    "ui_ty_box_kuang_2",
    "ui_ty_box_kuang_3",
    "ui_ty_box_kuang_5",
    "ui_ty_box_kuang_6"
}
local itemEffectCfgName = {
    "ItemEffect_white",
    "ItemEffect_blue",
    "ItemEffect_purple",
    "ItemEffect_gloden",
    "ItemEffect_red"
}

---类的构造函数
function roleViewBase:__init()
end
---类的析构函数
function roleViewBase:Dispose()
    self.gameObject = nil
    self.transform = nil
    self.go_table = nil
    self.effectTrans = nil
    _G.ObjectPool:GetInstance():Push(self)
end

--region 对象方法
-----初始化
---@param OnBtnFun function 点击事件绑定函数 nil为默认
function roleViewBase:Init(trans, data, OnBtnFun)
    self.gameObject = trans
    self.transform = trans
    -- self.instanceID = self.gameObject:GetInstanceIDE()
    -- _G.ComponentCsListener.AddCSCalls(self.instanceID, self)
    -- _G.CS.LuaBehaviour.AddLuaBehaviour(self.gameObject, self.__cname)
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    local clickFun = OnBtnFun and OnBtnFun or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))
    self.sid = data.sid
    self.go_table.aortext_Number.text = _G.tostring(data.number)
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.sid and self.sid or 0]
    if cfg then
        self.cfg = cfg
        self.go_table.aorimage_Color.SpriteName = itemColorIconName[cfg.UnitType]
        self.go_table.aorrawimage_Icon:LoadImage(
            "Images/zRoles/" .. cfg.Icon,
            function()
                self.go_table.aorrawimage_Icon:SetNativeSize()
            end
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到对应道具的配置 sid=" .. (self.sid and self.sid or "nil"))
        end
    end
    self:SetRootPos(_G.Vector3.zero)
end
function roleViewBase:SetRootPos(pos)
    self.go_table.obj_Root:SetLocalPosition(pos.x, pos.y, pos.z)
end
function roleViewBase:SetAlpha(alpha)
    local color = _G.Color.white
    color.a = alpha
    self.go_table.aorimage_Color.color = color
    self.go_table.aorrawimage_Icon.color = color
    self.go_table.aortext_Number.color = color
end
function roleViewBase:ShowEffect()
    if self.effectTrans or (not _G.IsNil(self.effectTrans)) then
        return
    end
    self.effectTrans = true
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[itemEffectCfgName[self.cfg and self.cfg.UnitType or 4]],
        self.go_table.obj_Root,
        function()
        end,
        function(trans)
            self.effectTrans = trans
        end
    )
end
function roleViewBase:OnClickBtn(obj)
    --@--TODO:打开道具信息界面

    if _G.AppSetting.DEBUG then
        _G.Log("点击打开道具详细信息界面..sid=" .. (self.sid and self.sid or "nil"))
    end
end
--endregion

--region 私有
-- local itemViewPool = {}--走ObjectPool 统一管理
local function GetItemView()
    local item = _G.ObjectPool:GetInstance():Pop(roleViewBase)
    return item
end
--endregion
--region 类方法
-----创建item显示对象
---@param data table 构建数据{sid=0,number=0}
---@param parent UnityEngine.Transform 父节点
---@param callback function 构建完成后的回调方法，会将构建好的对象传回
---@param OnBtnFun function 点击事件绑定函数 nil为默认
function roleViewBase.Create(data, parent, callback, OnBtnFun)
    _G.PoolsManager:GetInstance():Spawn(
        itemPrefabPath,
        _G.ePoolType.UIItem,
        parent,
        function(trans)
            local item = GetItemView()
            item:Init(trans, data, OnBtnFun)
            if callback then
                callback(item)
            end
        end
    )
end
-----回收item
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function roleViewBase.Despawn(item)
    if item then
        _G.PoolsManager:GetInstance():Despawn(item, _G.ePoolType.UIItem)
    end
    item:Dispose()
end
--endregion
