---类的构造函数
function ItemRemainsBodyBaseView:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_Click:SetActiveE(self.click and 1 or 0)
    self.isGou = false
end

---类的析构函数
function ItemRemainsBodyBaseView:Dispose()
    self.isGou = nil
end

function ItemRemainsBodyBaseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
            -- else
            --     require "CommonTipManager":GetInstance():OpenTip(go, self.sid)
        end
    end
end

---参数显示
---@param sid number 神器sid
---@param star number 神器星级
---@param lv number 神器等级
---@param isAwaken boolean 神器是否觉醒
---@param count number 神器堆叠数量
---@param click function 点击回调
function ItemRemainsBodyBaseView:Show(sid, star, click, ...)
    self.sid = sid
    self.click = click
    self.go_table.aorbtn_Click:SetActiveE(self.click and 1 or 0)
    self.clickParams = {...}
    self.star = star or 0
    self.cfg = _G.ConfigManager.remains_cfg[self.sid]
    self:ShowInfo()
end

---类显示
---@param RemainsData RemainsData
function ItemRemainsBodyBaseView:ShowData(RemainsData, click, ...)
    self:Show(RemainsData.sid, RemainsData:GetStar(), click, ...)
end

---设置大小
---@param size number 大小，默认75，即0.75
function ItemRemainsBodyBaseView:SetSize(size)
    self.go_table.obj_Scale:SetLocalScaleXYZ(size / 100)
end

