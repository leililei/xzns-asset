    -- end

    self.go_table.aorimage_IconBg.SpriteName = _G.ItemBaseIconName[grade]
    -- self.go_table.aorimage_nameBg.SpriteName = BuildBgColorIconName2[self.cfg.grade]
    local ctm = require "CommonTipManager":GetInstance()
