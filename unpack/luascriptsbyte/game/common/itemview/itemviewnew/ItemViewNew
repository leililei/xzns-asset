---@class ItemViewNew	中文描述
local ItemViewNew = _G.BaseClass("ItemViewNew")
local itemGouPrefabPath = "UIH5/Common/ItemView/BaseItemView_gou"
local ColorType = {
    "ui-ghck-icon-hui",
    "ui-ghck-icon-ls",
    "ui-ghck-icon-lan",
    "ui-ghck-icon-zi",
    "ui-ghck-icon-cheng",
    "ui-ghck-icon-hong",
    "",
    "ui-ghck-icon-cai"
}
---类的构造函数
function ItemViewNew:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnBtnCall))
    self.isGou = false
end

---类的析构函数
function ItemViewNew:Dispose()
    self.gameObject = nil
    self.go_table = nil
    self.sid = nil
    self.onClick = nil
end

function ItemViewNew:OnBtnCall()
    if self.onClick then
        self.onClick()
    else
        require("CommonTipManager"):GetInstance():OpenPropTip(self.gameObject, self.sid)
    end
end

function ItemViewNew:Show(id, click)
    self.onClick = click
    self.sid = id
    self.gredeData = nil
    local color = _G.StorageManager:GetInstance():GetItemQuality(id)
    local icon = _G.StorageManager:GetInstance():GetItemIcon(id)
    local tag = _G.StorageManager:GetInstance():GetItemTag(id)

    if self.go_table.aorimage_Color ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(id)
        -- 特殊判断装备品质
        -- 装备品质为7时，颜色为彩色
        if type == _G.StorageType.Equipment then
            self.go_table.aorimage_Color.SpriteName = _G.EquipItemIconName[color]
        elseif type == _G.StorageType.Artifact then
            self.go_table.aorimage_Color.SpriteName = _G.ArtifactItemIconName[color]
        elseif type == _G.StorageType.Decoration then
            self.go_table.aorimage_Color.SpriteName = _G.RuneRankEnum[color]
        elseif type == _G.StorageType.Carving then
            self.go_table.aorimage_Color.SpriteName = _G.CarvingRankEnum[color]
        elseif type == _G.StorageType.Spiritual then
            self.go_table.aorimage_Color.SpriteName = _G.SpiritualItemIconName[color]
        elseif type == _G.StorageType.RelicTeamBuff then
            self.go_table.aorimage_Color.SpriteName = _G.EquipItemIconName[color]
        else
            self.go_table.aorimage_Color.SpriteName = _G.ItemBaseIconName[color]
        end
    end

    if self.go_table.aorimage_ColorBG ~= nil then
        self.go_table.aorimage_ColorBG.SpriteName = _G.ItemBaseIconName[color]

        if _G.AppSetting.DEBUG then
            _G.LogWarning("请修改品质框 统一改成 aorimage_Color")
        end
    end
    self.setNativeSize = false
    if id > 1000 then
        local cfg = _G.ConfigManager.item_cfg[id]
        if self.go_table.aorimage_element then
            if cfg then
                local showElement = cfg.Type1 == 6 or cfg.Type1 == 13 or cfg.Type1 == _G.ItemCfgType.PetChip or
                    cfg.Type1 == _G.ItemCfgType.BuildChip or cfg.Type1 == 19 or cfg.Type1 == _G.ItemCfgType.BeastChip or cfg.Type1 == _G.ItemCfgType.Remains
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, showElement)
                if showElement then
                    -- self.setNativeSize = true
                    self.go_table.aorimage_element.SpriteName = ColorType[cfg.Quality]
                end
            else
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, false)
            end
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_element, false)
    end
    if self.go_table.aorrawimage_Icon ~= nil then
        self.go_table.aorrawimage_Icon.Alpha = 0
        self.go_table.aorrawimage_Icon:LoadImage(
            icon,
            function()
                if self.setNativeSize then
                    self.go_table.aorrawimage_Icon:SetNativeSize()
                end
            end
        )
    end

    local aorimage_tag = self.go_table.aorimage_tag
    if self.go_table.aorimage_tag2 then
        local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
        self.go_table.aorimage_tag:SetActiveE(0)
        self.go_table.aorimage_tag2:SetActiveE(0)
        aorimage_tag = uiModel and self.go_table.aorimage_tag2 or self.go_table.aorimage_tag
    end

    if _G.string.IsNullOrEmpty(tag) then
        aorimage_tag:SetActiveE(0)
    else
        aorimage_tag:SetActiveE(1)
        aorimage_tag.SpriteName = tag
    end
end

function ItemViewNew:SetGray(isGray)
    self.go_table.aorrawimage_Icon:SetGray(isGray)
end

function ItemViewNew:SetGou(isGou)
    if self.isGou == isGou then
        return
    end

    if self.gouTran == nil then
        _G.PoolsManager:GetInstance():Spawn(
            itemGouPrefabPath,
            _G.ePoolType.UIItem,
            self.gameObject,
            function(trans)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(trans)
                    return
                end
                self.gouTran = trans
                _G.GameUtil.SetActiveByCondition(self.gouTran, isGou)
            end
        )
    else
        _G.GameUtil.SetActiveByCondition(self.gouTran, isGou)
    end
    self.isGou = isGou
end

---@param isHide bool true不显示品质特效
function ItemViewNew:SetGradeNew(isHide, parent)
    if not self.gredeData then
        self.gredeData = _G.StorageManager:GetInstance():GetStorageItemData(self.sid)
    end
    if not parent then
        parent = self.gameObject
    end
    ---不显示旧版特效
    _G.UIUtils.SetItemGradeNew(self.go_table, self.gredeData.Cfg, isHide, parent, 1)
end

---@param isShow boolean 是否显示边框特效
function ItemViewNew:ShowFrameEffect(sid, isShow)
    local effect = _G.StorageManager:GetInstance():GetCommonLightEffect(sid)
    if self.go_table.frameEffect then
        self.go_table.frameEffect:SetActiveE(0)
    end
    if not isShow then
        return
    end
    if not self.go_table.frameEffect then
        self.go_table.frameEffectCfg = effect
        if not effect then
            return
        end
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.gameObject,
            function(trans)
                if _G.IsNil(self.gameObject) or self.go_table.frameEffectCfg ~= effect then
                    _G.DestroyObject(trans)
                    return
                end
                if not isShow then
                    trans:SetActiveE(0)
                end
                self.go_table.frameEffect = trans
            end
        )
    elseif self.go_table.frameEffect then
        self.go_table.frameEffect:SetActiveE(isShow and 1 or 0)
    end
end

return ItemViewNew
