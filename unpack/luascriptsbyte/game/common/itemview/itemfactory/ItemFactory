---@class ItemFactory : Singleton	中文描述
local ItemFactory = _G.BaseClass("ItemFactory", _G.Singleton)
_G.ItemFactory = ItemFactory
_G.ItemFactory.itemType = itemType

---@return ItemFactory ItemFactory
function ItemFactory:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ItemFactory:__init()
    self.itemCallDic = {}
end

---销毁对象时,析构函数
function ItemFactory:Dispose()
    self.itemCallDic = nil
end

---@param itemType _G.ItemFactory.itemType 显示类型
---@param instanceID number 父节点实例ID
function ItemFactory:OnItemCall(trans, ref, itemType, instanceID)
    local viewName = trans:GetName()
    local typeTab = self.itemCallDic[viewName]
    if not typeTab then
        _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
        if(_G.AppSetting.DEBUG) then
            _G.LogError("加载item出现了不同的item  "..viewName)
        end
        return
    end
    local instanceTab = typeTab[instanceID]
    --如果父节点被销毁
    if _G.IsNil(trans:GetParent()) then
        _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
        if instanceTab then
            local callback = _G.table.remove(instanceTab, 1)
            callback()
            if #instanceTab == 0 then
                typeTab[instanceID] = nil
            end
        end
        return
    end

    if not instanceTab then
        _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
        if(_G.AppSetting.DEBUG) then
            _G.LogError("加载item出现了没有instanceTab  ")
        end
    else
        local view = require(ItemClass[itemType]).New(trans)
        local callback = _G.table.remove(instanceTab, 1)
        callback(view)
        if #instanceTab == 0 then
            typeTab[instanceID] = nil
        end
    end
end

local function CommonCall()
end

---创建itemcard显示对象
---@param itemType _G.ItemFactory.itemType 显示类型
---@param parent UnityEngine.Transform 父节点
---@param call function 创建回调
function ItemFactory:GetItemCard(itemType, parent, call)
    if _G.AppSetting.IsEditor then
        if _G.IsNil(parent) then
            if _G.AppSetting.DEBUG then
                _G.LogError("加载item不能不传父节点")
            end
            -- if call then
            --    call(nil)
            -- end
            return
        end
    end
    
    if call == nil then
        call = CommonCall
    end
    if itemType == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("类型为nil", "ItemFactory:GetItemCard")
        end
        call(nil)
        return
    end
    if ItemPath[itemType] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到预制路径 为防止中断，强制设置为基础类型1 itemCardType = " .. itemType, "ItemFactory:GetItemCard")
        end
        call(nil)
        return
    end
    if ItemClass[itemType] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到类 为防止中断，强制设置为基础类型1 itemCardType = " .. itemType, "ItemFactory:GetItemCard")
        end
        call(nil)
        return
    end
    local typeTab = self.itemCallDic[ItemPrefabName[itemType]]
    if typeTab == nil then
        typeTab = {}
        self.itemCallDic[ItemPrefabName[itemType]] = typeTab
    end
    local instanceID =  parent:GetInstanceIDE()
    local instanceTab = typeTab[instanceID]
    if instanceTab == nil then
        instanceTab = {}
        typeTab[instanceID] = instanceTab
    end
    _G.table.insert(instanceTab, call)
    _G.PoolsManager:GetInstance():Spawn(
        ItemPath[itemType],
        _G.ePoolType.UIItem,
        parent,
        _G.handlerbind(self, self.OnItemCall, itemType, instanceID)
    )
end
---回收对象
---@param itemCard ItemCardBaseView ItemCar显示对象
function ItemFactory:SetItemCard(itemCard)
    _G.PoolsManager:GetInstance():Despawn(itemCard.gameObject, _G.ePoolType.UIItem)
    itemCard:Dispose()
end
