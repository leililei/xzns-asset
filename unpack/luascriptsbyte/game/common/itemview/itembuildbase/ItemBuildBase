---清楚品质特效
function ItemBuildBase:RemoveEffect()
    if self.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

---品质特效
---@field isShow boolean 是否显示特效
function ItemBuildBase:ShowOrderEffect(isShow)
    self:RemoveEffect()
    if isShow then
        local effect = OrderEffectCfg[self.grade]
    end
end

---设置大小
---@param size number 大小，默认75，即0.75
function ItemBuildBase:SetSize(size)
    self.go_table.obj_Scale:SetLocalScaleXYZ(size / 100)
    self.go_table.obj_gou:SetLocalScaleXYZ(size / 100)
end

function ItemBuildBase:SetGray(bool)
    self.go_table.aorrawimage_Icon:SetGray(bool)
    self.go_table.aorimage_ColorBG:SetGray(bool)
end

function ItemBuildBase:SetGou(isGou)
    self.go_table.obj_gou:SetActiveE(isGou and 1 or 0)
end

return ItemBuildBase
