---@class ItemBuildBase	灵契item基类
---@field go_table ItemBuildBase_GoTable
local ItemBuildBase = _G.BaseClass("ItemBuildBase", require("ItemViewBase"))

local OrderEffectCfg = {
    [1] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [2] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [3] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [4] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow
}

local ProfessionalEnum = {
    [1] = "ui_zy_zhanshi_icom",
    [2] = "ui_zy_tanke_icom",
    [3] = "ui_zy_fuzhu_icom"
}

local ColorType = {
    "ui-ghck-icon-hui",
    "ui-ghck-icon-hui",
    "ui-ghck-icon-lan",
    "ui-ghck-icon-zi",
    "ui-ghck-icon-cheng",
    "ui-ghck-icon-hong",
    "ui-ghck-icon-cai",
    "ui-ghck-icon-cai"
}

---类的构造函数
function ItemBuildBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ItemBuildBase:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.callback then
            self.callback(self.clickParams)
        else
            require "CommonTipManager":GetInstance():OpenTip(go, self.sid, self.uid, nil, _G.SafeUnpack(self.clickParams))
        end
    end
end

---类的析构函数
function ItemBuildBase:Dispose()
    self:RemoveEffect()
end

---参数显示
---@param sid number 建筑sid
---@param star number 建筑星级
---@param click function 点击回调
function ItemBuildBase:Show(sid, star, callback, ...)
    self.sid = sid
    self.star = star or 0
    self.callback = callback
    self.cfg = _G.ConfigManager.manor_build_cfg[self.sid]
    self.combineSkill = self.cfg.skill_id[self.star + 1]
    self.clickParams = { ... }
    self:ShowInfo()
end

---@param petData SpiritualData
function ItemBuildBase:ShowData(petData, callback, ...)
    self.grade = petData:GetOrder() or 1
    self.uid = petData.uid or petData.sid
    self:Show(
        petData.sid,
        petData:GetStar(),
        callback,
        ...
    )
end

function ItemBuildBase:ShowInfo()
    if self.sid == 0 then
        return
    end

    local ItemIconName = {
        [5] = "TY_Background_kuang_cheng",
        [6] = "TY_Background_kuang_hong",
        [8] = "TY_Background_kuang_cai"
    }

    self.go_table.aorimage_ColorBG.SpriteName = ItemIconName[self.cfg.Order]
    self.go_table.aorrawimage_Icon.Alpha = 0
    self.go_table.aorrawimage_Icon:LoadImage(self.cfg.Icon)

    self:ShowOrHideProfessional(false)
    self:ShowStar()
    local showEffect = self.cfg.ef_item == 1
    self:ShowOrderEffect(showEffect)
    --self:ShowCombine(true)
end

function ItemBuildBase:ShowElement()
    self.go_table.aorimage_element.SpriteName = ColorType[self.cfg.Order]
    self.go_table.aorimage_element:SetActiveE(1)
end

function ItemBuildBase:HideElement()
    self.go_table.aorimage_element:SetActiveE(0)
end

---隐藏数量显示
function ItemBuildBase:HideNum()
    self.go_table.obj_ItemNum:SetActiveE(0)
end

---隐藏星级显示
function ItemBuildBase:HideStar()
    self.go_table.obj_stars:SetActiveE(0)
end

---显示星级
function ItemBuildBase:ShowStar(IsShow)
    self.go_table.obj_stars:SetActiveE(self.star > 0 and 1 or 0)
    if IsShow then
        self.go_table.obj_stars:SetActiveE(1)
    end
    if self.star > 0 or IsShow then
        for i = 1, 5 do
            local showStar = self.star >= i
            self.go_table["aorimage_starMask" .. i]:SetActiveE(not showStar and 1 or 0)
        end
    end

    if self.star - 5 > 0 then
        for i = 1, self.star - 5 do
            self.go_table["aorimage_star" .. i].SpriteName = "ui_img_xing_hong"
        end
    end
    self.go_table.aorimage_professionalIcon.SpriteName = _G.ProfessionalIcon[self.cfg.professional]
    self.go_table.aorimage_professionalIcon:SetActiveE(self.cfg.professional == 0 and 0 or 1)
end

