---@class DebrisViewBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local DebrisViewBase = _G.BaseClass("DebrisViewBase", require("ItemViewBase"))
_G.DebrisViewBase = DebrisViewBase

function DebrisViewBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemDebrisBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemDebrisBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua.sid = data.sid
                itemLua.transform = itemLua
                itemLua:ShowData(data, OnBtnFun, itemLua)
            end
            if callback then
                callback(itemLua)
            end
        end
    )
end
