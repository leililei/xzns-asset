require "ItemViewBase"
---@class CardViewBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
---@field cfg card_cfg
local CardViewBase = _G.BaseClass("CardViewBase", require("ItemViewBase"))
_G.CardViewBase = CardViewBase

local itemPrefabPath = "UIH5/Common/ItemView/CardItemView"

local itemEffectCfgName = {
    "ItemEffect_white",
    "ItemEffect_blue",
    "ItemEffect_purple",
    "ItemEffect_gloden",
    "ItemEffect_red"
}

---@param mItemCardAllView ItemCardAllView
function CardViewBase:Init(trans, data, mItemCardAllView, OnBtnFun)
    self.cardData = data
    self.gameObject = trans
    self.transform = trans
    self.mItemCardAllView = mItemCardAllView

    self.sid = data.sid
    self.number = data.number or data.fixNum
    self.uid = data.uid
    self.Star = data.star

    self.mItemCardAllView:Show(self.sid, nil, self.Star, nil, nil, self.uid)
    self.go_table = mItemCardAllView.go_table

    local clickFun = OnBtnFun and OnBtnFun or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))

    ---@type card_cfg
    local Ecfg = _G.ConfigManager.card_cfg[self.sid and self.sid or 0]
    if Ecfg then
        self.cfg = Ecfg
    end
end

local function GetEquipView()
    local item = _G.ObjectPool:GetInstance():Pop(CardViewBase)
    return item
end
function CardViewBase:ShowNew(bl)
    self.mItemCardAllView:ShowNew(bl)
end
function CardViewBase:ShowName(bl)
    self.mItemCardAllView:ShowName(bl)
end

function CardViewBase:ShowSelected(bl)
    self.mItemCardAllView:ShowSelected(bl)
end

function CardViewBase:ShowLv(bl, content)
    if content == nil then
        content = self.cardData:GetLevel()
    end
    self.mItemCardAllView:ShowLv(bl, content)
end

function CardViewBase:ShowProp(bl)
    self.mItemCardAllView:ShowProp(bl)
end

function CardViewBase:HideOrShowLevel(bl)
    self.mItemCardAllView:HideOrShowLevel(bl)
end

function CardViewBase:ShowCount(num)
    self.mItemCardAllView:ShowCount(num)
end

function CardViewBase:HideOrShowSpEffect(bl)
    self.mItemCardAllView:HideOrShowSpEffect(bl)
end

function CardViewBase:OnClickBtn()
    --弹出tips
    require "CommonTipManager":GetInstance():OpenCardTip(self.sid)
end

function CardViewBase.Create(data, parent, callback, OnBtnFun)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.ItemCardStorageView,
        parent,
        function(mItemCardAllView)
            local item
            if mItemCardAllView then
                item = GetEquipView()
                item:Init(mItemCardAllView.gameObject, data, mItemCardAllView, OnBtnFun)
            end
            if callback then
                callback(item)
            end
        end
    )
end
