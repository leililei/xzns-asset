---@class ItemPetBodyBaseView	中文描述
---@field go_table ItemPetBodyBaseView_GoTable
local ItemPetBodyBaseView = _G.BaseClass("ItemPetBodyBaseView")

local ProfessionalEnum = {
    [1] = "ui_zy_zhanshi_icom",
    [2] = "ui_zy_tanke_icom",
    [3] = "ui_zy_fuzhu_icom"
}

---类的构造函数
function ItemPetBodyBaseView:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_Click:SetActiveE(self.click and 1 or 0)
    self.isGou = false
end

---类的析构函数
function ItemPetBodyBaseView:Dispose()
    self.isGou = nil
end

function ItemPetBodyBaseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
        -- else
        --     require "CommonTipManager":GetInstance():OpenTip(go, self.sid)
        end
    end
end

---参数显示
---@param sid number 神器sid
---@param star number 神器星级
---@param lv number 神器等级
---@param isAwaken boolean 神器是否觉醒
---@param count number 神器堆叠数量
---@param click function 点击回调
function ItemPetBodyBaseView:Show(sid, star, click, ...)
    self.sid = sid
    self.click = click
    self.clickParams = {...}
    self.star = star or 0
    self.cfg = _G.ConfigManager.pet_cfg[self.sid]
    self:ShowInfo()
end

---类显示
---@param PetData PetData
function ItemPetBodyBaseView:ShowData(PetData, click, ...)
    self.grade = PetData:GetOrder() or 1
    self:Show(
        PetData.sid,
        PetData:GetStar(),
        click,
        ...
    )
end

---设置大小
---@param size number 大小，默认75，即0.75
function ItemPetBodyBaseView:SetSize(size)
    self.go_table.obj_Scale:SetLocalScaleXYZ(size / 100)
end

function ItemPetBodyBaseView:ShowInfo()
    if self.sid == 0 then
        return
    end
    self.go_table.aorimage_ColorBG.SpriteName = _G.PetBodyIconName[self.cfg.Order]
    self.go_table.aorimage_mask.SpriteName = _G.PetBodyIconName[self.cfg.Order]
    local ctm = require "CommonTipManager":GetInstance()
    local orderDic = {
        [1] = 4,
        [2] = 5,
        [3] = 6,
        [4] = 8
    }
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, orderDic[self.cfg.Order])
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.cfg.Name)
    --self.go_table.aortext_type.text = _G.GetLangPackValue(self.cfg.professional + 90024900003)
    UIUtils.SetUIModelText(self.go_table.aortext_type,self.go_table.aortext_type2, _G.GetLangPackValue(self.cfg.professional + 90024900003))
    UIUtils.SetUIModel(self.go_table.aorimage_typeBg,nil,self.go_table.aorimage_typeBg2)
    self.go_table.aorrawimage_Icon.Alpha = 0
    self.go_table.aorrawimage_Icon:LoadImage(
            self.cfg.image_1,
            function(trans)
                trans:SetNativeSize()
                local pos = self.cfg.image_portrait1
                if #pos == 4 then
                    trans:SetLocalPosition(pos[1], pos[2], pos[3])
                    trans:SetLocalScaleXYZ(pos[4])
                end
            end)
    --星级展示
    for i = 1, 5 do
        self.go_table["obj_starBackground" .. i]:SetActiveE(self.cfg.Star >= i and 1 or 0)
        self.go_table["obj_star" .. i]:SetActiveE(self.star >= i and 1 or 0)
    end

    self:ShowOrHideProfessional(true)
    -- self.showEffect = PetCfg.ef_item == 1
    -- self:ShowOrderEffect(self.showEffect)
end

---隐藏星级显示
function ItemPetBodyBaseView:HideStar()
    self.go_table.obj_stars:SetActiveE(0)
end

---显示/隐藏职业图标
---@param isShow boolean 是否显示
function ItemPetBodyBaseView:ShowOrHideProfessional(isShow)
    if isShow then
        self.go_table.aorimage_profession.SpriteName =
            ProfessionalEnum[self.cfg.professional]
    end
    self.go_table.aorimage_profession:SetActiveE(isShow and 1 or 0)
end

---外部调用 只更换信息  不更换点击
---@param PetData PetData
function ItemPetBodyBaseView:UpDataInfo(PetData)
    self.sid = PetData.sid
    self.star = PetData.star or 0
    self:ShowInfo()
end

function ItemPetBodyBaseView:SetGou(isGou)
    self.go_table.aorimage_mask:SetActiveE(isGou and 1 or 0)
    self.go_table.aorimage_gou:SetActiveE(isGou and 1 or 0)
end

function ItemPetBodyBaseView:SetMask(isMask)
    self.go_table.aorimage_mask:SetActiveE(isMask and 1 or 0)
end

function ItemPetBodyBaseView:ShowEffect(isShow)
    if isShow == nil then
        isShow = true
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    self.go_table.NowEffKey = key
    if self.go_table.EffDic == nil then
        self.go_table.EffDic = {}
    end
    if self.go_table.EffDic[key] == nil then
        self.go_table.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.go_table.obj_qualityeffect,
            function(trans)
                -- trans:SetAnchorPosition(0, 0, 0)
                self.go_table.EffDic[key] = trans
                if key ~= self.go_table.NowEffKey or isShow == false then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
            end
        )
    elseif self.go_table.EffDic[key] ~= true then
        self.go_table.EffDic[key]:SetActiveE(isShow and 1 or 0)
    end
end

function ItemPetBodyBaseView:ShowOrHideEffect(isEffect)
    if not self.go_table.EffDic then
        self.go_table.EffDic = {}
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    if self.go_table.EffDic[key] then
        self.go_table.EffDic[key]:SetActiveE(isEffect and 1 or 0)
    end
end

---滑动会生成多个对勾的 预制体
function ItemPetBodyBaseView:SetGouScroll(isGou)
   self.go_table.aorimage_mask:SetActiveE(isGou and 1 or 0)
   self.go_table.aorimage_gou:SetActiveE(isGou and 1 or 0)
end

function ItemPetBodyBaseView:SetMaskScroll(isMask)
    self.go_table.aorimage_mask:SetActiveE(isMask and 1 or 0)
end

---(预制体新增节点,根据物品品质生成特效) 滑动列表会出现不同品质的装备的特效
function ItemPetBodyBaseView:ShowEffectOrder(isShowEffect)
    self:RemoveEffect()
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    _G.UIUtils.LoadEffectByCfg(
        effect,
        self.go_table.obj_uieffect,
        function(trans)
            trans:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end
---清楚品质特效
function ItemPetBodyBaseView:RemoveEffect()
    if self.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

return ItemPetBodyBaseView
