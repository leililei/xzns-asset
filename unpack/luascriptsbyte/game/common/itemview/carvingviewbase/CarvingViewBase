---@class CarvingViewBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local CarvingViewBase = _G.BaseClass("CarvingViewBase", require("ItemViewBase"))
_G.CarvingViewBase = CarvingViewBase

function CarvingViewBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemCarvingBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemCarvingBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua:ShowData(data, OnBtnFun)
            end
            if callback then
                callback(itemLua)
            end
        end
    )
end