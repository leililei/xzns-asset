function ItemArtifactBase:SetGou(isGou)
    if self.isGou == isGou then
        return
    end

    if self.gouTran == nil then
        _G.PoolsManager:GetInstance():Spawn(
            itemGouPrefabPath,
            _G.ePoolType.UIItem,
            self.gameObject,
            function(trans)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(trans)
                    return
                end
                self.gouTran = trans
                _G.GameUtil.SetActiveByCondition(self.gouTran, isGou)
            end
        )
    else
        _G.GameUtil.SetActiveByCondition(self.gouTran, isGou)
    end
    self.isGou = isGou
end
