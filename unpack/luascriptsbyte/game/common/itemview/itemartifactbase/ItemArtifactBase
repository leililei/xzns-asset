---类的构造函数
function ItemArtifactBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.count = 1
    self.bound = 0
    self.isGou = false
    -- self.FontImage_lv = {self.go_table.aorimage_level1}
    -- for i = 2, self.go_table.obj_lvNode:GetChildCountE() do
    --     self.FontImage_lv[i] = self.go_table.obj_lvNode:GetChildE(i - 1):GetComponentE(_G.typeof(_G.CS.AorImage))
    -- end
end

---类的析构函数
function ItemArtifactBase:Dispose()
    self.isGou = nil
end

function ItemArtifactBase:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
        else
            --require "CommonTipManager":GetInstance():OpenTip(go, self.sid, self.uid)
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonTipView.Name,
                    _G.TipType.Artifact,
                    self.ArtifactData
            )
        end
    end
end

---参数显示
---@param sid number 神器sid
---@param star number 神器星级
---@param lv number 神器等级
---@param isAwaken boolean 神器是否觉醒
---@param count number 神器堆叠数量
---@param click function 点击回调
function ItemArtifactBase:Show(sid, star, lv, isAwaken, count, click, ...)
    self.sid = sid
    self.click = click
    self.clickParams = {...}
    self.star = star or 0
    self.lv = lv
    self.isAwaken = isAwaken or false
    self.count = count or 1
    self.cfg = _G.ConfigManager.artifact_cfg[self.sid]
    self:ShowInfo()
end

---类显示
---@param ArtifactData ArtifactData
function ItemArtifactBase:ShowData(ArtifactData, click, ...)
    self.ArtifactData=ArtifactData
    self.bound = ArtifactData.cardUid or 0
    self.grade = ArtifactData:GetOrder() or 1
    self.uid = ArtifactData.uid or ArtifactData.sid
    self.type = ArtifactData.type
    self:Show(
        ArtifactData.sid,
        ArtifactData:GetStar(),
        ArtifactData:GetLevel(),
        ArtifactData:GetIsAwaken(),
        ArtifactData:GetCount(),
        click,
        ...
    )
end

---设置大小
---@param size number 大小，默认75，即0.75
function ItemArtifactBase:SetSize(size)
    self.go_table.obj_Scale:SetLocalScaleXYZ(size / 100)
end

function ItemArtifactBase:ShowInfo()
    if self.sid == 0 then
        return
    end

    local artifactCfg = _G.ConfigManager.artifact_cfg[self.sid]
    self.go_table.aorimage_ColorBG.SpriteName = _G.ArtifactItemIconName[artifactCfg.Order]
    self.go_table.aorrawimage_Icon.Alpha = 0

    require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_Icon, artifactCfg.Icon)
    --星级展示
    if self.star > 5 then
        self.go_table.aortext_star.text = self.star
    else
        for i = 1, 5 do
            self.go_table["obj_starBackground" .. i]:SetActiveE(self.star >= i and 1 or 0)
            self.go_table["obj_star" .. i]:SetActiveE(self.star >= i and 1 or 0)
        end
    end
    self.go_table.obj_stars:SetActiveE(self.star <= 5 and 1 or 0)
    self.go_table.obj_highStar:SetActiveE(self.star > 5 and 1 or 0)

    self:ShowLevel()
    -- self:ShowAwaken()
    self:ShowCount()
    self:ShowCardBound(self.bound)
    -- self:ShowOrHideProfessional(true)
    self:ShowOrHideTrial(self.type == _G.ArtifactDataType.Timer)
    self.showEffect = artifactCfg.ef_item == 1
    --self:ShowOrderEffect(self.showEffect)
end

---设置特效（目前只在tip弹窗中显示）
function ItemArtifactBase:SetEffect()
    self:ShowOrderEffect(self.showEffect)
end

