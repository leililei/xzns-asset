---显示/隐藏职业图标(/del若要显示需主动调用) --ZHJ-29679 默认显示
---@param isShow boolean 是否显示
function ItemArtifactBase:ShowOrHideProfessional(isShow)
    if isShow then
        self.go_table.aorimage_professional.SpriteName =
            ProfessionalEnum[_G.ConfigManager.artifact_cfg[self.sid].Professional]
    end
    self.go_table.aorimage_professionBg:SetActiveE(isShow and 1 or 0)
    self.go_table.aorimage_professional:SetActiveE(isShow and 1 or 0)
end

---显示/隐藏试用图标
---@param isShow boolean 是否显示
---@param type number 类型 1.标准（右下），2.右上
function ItemArtifactBase:ShowOrHideTrial(isShow, type)
    type = type or 1
    self.go_table.aorimage_trial:SetActiveE(isShow and 1 or 0)
    if isShow then
        if type == 1 then
            self.go_table.aorimage_trial:SetLocalPosition(41, -14, 0)
            self.go_table.aorimage_trial:SetLocalScaleXYZ(1.111)
        else
            self.go_table.aorimage_trial:SetLocalPosition(35, 37.5, 0)
            self.go_table.aorimage_trial:SetLocalScaleXYZ(1.25)
        end
    end
end

---显示觉醒
