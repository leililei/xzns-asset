end

---卡牌绑定显示
function ItemArtifactBase:ShowCardBound(bound)
    self.bound = bound or 0
    self.go_table.aorimage_BoundBg:SetActiveE(self.bound ~= 0 and 1 or 0)
    if self.bound ~= 0 then
        ---@type CardData
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.bound)
        local cfg, star
        if cardData == nil then
            cfg = _G.ConfigManager.card_cfg[self.bound]
            if not cfg then
                return
            end
            star = cfg.Star
        else
            star = cardData:GetStar()
            cfg = _G.ConfigManager.card_cfg[cardData.sid]
        end
        if not cfg then
            return
        end
        local icon = cfg.Icon

        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_BoundIcon.SpriteName = icon
        local bg = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(star)
        self.go_table.aorimage_BoundBg.SpriteName = bg
    end
end

