function ItemArtifactBase:ShowEffect(isShow)
    if isShow == nil then
        isShow = true
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    self.go_table.NowEffKey = key
    if self.go_table.EffDic == nil then
        self.go_table.EffDic = {}
    end
    if self.go_table.EffDic[key] == nil then
        self.go_table.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.go_table.obj_qualityeffect,
            function(trans)
                -- trans:SetAnchorPosition(0, 0, 0)
                self.go_table.EffDic[key] = trans
                if key ~= self.go_table.NowEffKey or isShow == false then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
            end
        )
    elseif self.go_table.EffDic[key] ~= true then
        self.go_table.EffDic[key]:SetActiveE(isShow and 1 or 0)
    end
end

function ItemArtifactBase:ShowOrHideEffect(isEffect)
    if not self.go_table.EffDic then
        self.go_table.EffDic = {}
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    if self.go_table.EffDic[key] then
        self.go_table.EffDic[key]:SetActiveE(isEffect and 1 or 0)
    end
end

function ItemArtifactBase:ShowCount(isShow)
    local num = self.count or 1
    if num <= 1 or (isShow ~= nil and isShow == false) then
        ---数量1 不显示
        num = nil
    end
    _G.UIUtils.SetItemNum_EquItemNum(self.go_table, num)
end

function ItemArtifactBase:HideCount()
    self.go_table.aorimage_num:GetParent():SetActiveE(0)
end

---滑动会生成多个对勾的 预制体
function ItemArtifactBase:SetGouScroll(isGou)
    if self.go_table.obj_gou:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_gou:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_gou:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    _G.PoolsManager:GetInstance():Spawn(
        itemGouPrefabPath,
        _G.ePoolType.UIItem,
        self.go_table.obj_gou,
        function(trans)
            _G.GameUtil.SetActiveByCondition(trans, isGou)
        end
    )
end
---(预制体新增节点,根据物品品质生成特效) 滑动列表会出现不同品质的装备的特效
function ItemArtifactBase:ShowEffectOrder(isShowEffect)
    self:RemoveEffect()
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    -- ZHJH-2048  策划要求不调用 蓝绿特效
    if key == "ef_BaseItemWithCount_lv" or key == "ef_BaseItemWithCount_lan" or key == false then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
        effect,
        self.go_table.obj_uieffect,
        function(trans)
            trans:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end
---清楚品质特效
function ItemArtifactBase:RemoveEffect()
    if self.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

function ItemArtifactBase:ShowOrderEffect(isShow)
    self:RemoveEffect()
    if isShow then
        local effect = OrderEffectCfg[self.grade]
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.go_table.obj_uieffect,
            function(trans)
                if not self.showEffect then
                    self:RemoveEffect()
                    return
                end
                if self.go_table.obj_uieffect:GetChildCountE() > 1 then
                    _G.DestroyObject(trans)
                    return
                end
                local x, _, _ = self.go_table.obj_Scale:GetLocalScale()
                trans.gameObject:SetLocalScaleXYZ(x)
                trans:AddComponentE(typeof(CS.ParticleClipRect))
            end
        )
    end
end

---布阵界面专用
function ItemArtifactBase:EmbattleShow()
    self.isAwaken = false --不支持觉醒显示: ZHJH-19758【神器】穿戴了觉醒神器的角色在布阵界面有色块遮挡
    self:HideLevel()
    self:ShowOrHideProfessional(false)
    self:ShowAwaken()
    self:HideCardBound()
    self:ShowOrHideTrial(false)
    local artifactCfg = _G.ConfigManager.artifact_cfg[self.sid]
    self.go_table.aorimage_ColorBG.SpriteName = _G.ArtifactItemEmbattleIconName[artifactCfg.Order]
    self.go_table.obj_uieffect:SetActiveE(0)
    if self.isAwaken then
        self.go_table.obj_stars:SetActiveE(0)
        self.go_table.obj_highStar:SetActiveE(0)
    else
        if artifactCfg.Star <= 5 then
            if artifactCfg.Star == 3 then
                --星级展示
                self.go_table.obj_starBackground1:SetActiveE(0)
                self.go_table.obj_starBackground5:SetActiveE(0)
                for i = 2, 4 do
                    self.go_table["obj_star" .. i]:SetActiveE(self.star >= i - 1 and 1 or 0)
                    self.go_table["obj_starBackground" .. i]:SetActiveE(1)
                end
            elseif artifactCfg.Star == 4 then
                self.go_table.obj_starBackground3:SetActiveE(0)
                for i = 1, 5 do
                    if i < 3 then
                        self.go_table["obj_star" .. i]:SetActiveE(self.star >= i and 1 or 0)
                        self.go_table["obj_starBackground" .. i]:SetActiveE(1)
                    elseif i > 3 then
                        self.go_table["obj_star" .. i]:SetActiveE(self.star >= i - 1 and 1 or 0)
                        self.go_table["obj_starBackground" .. i]:SetActiveE(1)
                    end
                end
            end
        else
            self.go_table.aortext_star.text = self.star
        end
        self.go_table.obj_stars:SetActiveE(self.star > 0 and self.star <= 5 and 1 or 0)
        self.go_table.obj_highStar:SetActiveE(self.star > 5 and 1 or 0)
    end
    if not self.embattleEff and self.showEffect then
        self.embattleEff = true
         _G.UIUtils.LoadEffectByCfg(
             _G.ConfigManager.ui_effect_cfg.ef_sqdk_kuang_cai,
             self.go_table.aorimage_ColorBG,
             function(trans)
                 if _G.IsNil(self.go_table) then
                     _G.DestroyObject(trans)
                 end
             end
         )
    end
end

return ItemArtifactBase
