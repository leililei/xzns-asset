---@class DecorationViewBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local DecorationViewBase = _G.BaseClass("DecorationViewBase", require("ItemViewBase"))
_G.DecorationViewBase = DecorationViewBase

function DecorationViewBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemDecorationBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemDecorationBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua:ShowData(data, OnBtnFun)
            end
            if callback then
                callback(itemLua)
            end
        end
    )
end