---类的构造函数
function ItemBeastBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ItemBeastBase:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.callback then
            self.callback(self.clickParams)
        else
            require "CommonTipManager":GetInstance():OpenTip(go, self.sid, self.uid, nil, _G.SafeUnpack(self.clickParams))
        end
    end
end

---类的析构函数
function ItemBeastBase:Dispose()
    self:RemoveEffect()
end

---参数显示
---@param sid number 灵兽sid
---@param star number 灵兽星级
---@param click function 点击回调
function ItemBeastBase:Show(sid, star, callback, ...)
    self.sid = sid
    self.star = star or 0
    self.callback = callback
    self.cfg = _G.ConfigManager.pet_xzns_cfg[self.sid]
    -- self.combineSkill = self.cfg.skill_id[self.star + 1]
    self.clickParams = { ... }
    self:ShowInfo()
end

---@param petData SpiritualData
function ItemBeastBase:ShowData(petData, callback, ...)
    self.grade = petData:GetOrder() or 1
    self.uid = petData.uid or petData.sid
    self:Show(
        petData.sid,
        petData:GetStar(),
        callback,
        ...
    )
end

function ItemBeastBase:ShowInfo()
    if self.sid == 0 then
        return
    end
    self.go_table.aorimage_ColorBG.SpriteName = BGSpriteName[self.cfg.order]
    self.go_table.aorrawimage_Icon.Alpha = 0
    self.go_table.aorrawimage_Icon:LoadImage(self.cfg.icon)

    self:ShowOrHideProfessional(true)
    self:ShowStar()
    local showEffect = self.cfg.ef_item == 1
    self:ShowOrderEffect(showEffect)
    --self:ShowCombine(true)
end

---隐藏星级显示
function ItemBeastBase:HideStar()
    self.go_table.obj_stars:SetActiveE(0)
end

---显示星级
function ItemBeastBase:ShowStar(IsShow)
    self.go_table.obj_stars:SetActiveE(self.star > 0 and 1 or 0)
    if IsShow then
        self.go_table.obj_stars:SetActiveE(1)
    end
    if self.star > 0 or IsShow then
        if self.star <= 5 then
            for i = 1, 5 do
                local showStar = self.star >= i
                self.go_table["aorimage_star" .. i].SpriteName = "ui_ss_icon_xing_normal"
                self.go_table["aorimage_star" .. i]:SetActiveE(showStar and 1 or 0)
                self.go_table["aorimage_starMask" .. i]:SetActiveE(not showStar and 1 or 0)
            end
        else
            for i = 1, 5 do
                local showStar = self.star >= i
                self.go_table["aorimage_star" .. i].SpriteName = "ui_ss_icon_xing_hong"
                self.go_table["aorimage_star" .. i]:SetActiveE(showStar and 1 or 0)
                self.go_table["aorimage_starMask" .. i]:SetActiveE(not showStar and 1 or 0)
            end
        end
    end
end

---显示/隐藏职业图标
---@param isShow boolean 是否显示
function ItemBeastBase:ShowOrHideProfessional(isShow)
    if isShow then
        self.go_table.aorimage_profession.SpriteName =
            ProfessionalEnum[self.cfg.professional]
    end
    self.go_table.aorimage_profession:SetActiveE(isShow and 1 or 0)
end

