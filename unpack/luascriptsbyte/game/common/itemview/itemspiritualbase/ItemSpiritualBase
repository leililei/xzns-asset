---@class ItemSpiritualBase	灵契item基类
---@field go_table ItemSpiritualBase_GoTable
local ItemSpiritualBase = _G.BaseClass("ItemSpiritualBase", require("ItemViewBase"))

local OrderEffectCfg = {
    --[1] = _G.ConfigManager.ui_effect_cfg.ef_TY_Background_kuang_cai,
    --[2] = _G.ConfigManager.ui_effect_cfg.ef_TY_Background_kuang_cai,
    --[3] = _G.ConfigManager.ui_effect_cfg.ef_TY_Background_kuang_cai,
    [4] = _G.ConfigManager.ui_effect_cfg.ef_TY_Background_kuang_cai
}

local itemGouPrefabPath = "UIH5/Common/ItemView/BaseItemView_gou"

---类的构造函数
function ItemSpiritualBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.count = 1
    self.cardUid = 0
    -- self.FontImage_lv = {self.go_table.aorimage_level1}
    -- for i = 2, self.go_table.obj_lvNode:GetChildCountE() do
    --     self.FontImage_lv[i] = self.go_table.obj_lvNode:GetChildE(i - 1):GetComponentE(_G.typeof(_G.CS.AorImage))
    -- end
end

function ItemSpiritualBase:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.callback then
            self.callback(self.clickParams)
        else
            --require "CommonTipManager":GetInstance():OpenTip(go, self.sid, self.uid)
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.CommonTipView.Name,
                    _G.TipType.Spiritual,
                    self.spiritualData
            )
        end
    end
end

---类的析构函数
function ItemSpiritualBase:Dispose()
    self:RemoveEffect()
end

---参数显示
---@param sid number 灵契sid
---@param star number 灵契星级
---@param lv number 灵契等级
---@param count number 灵契堆叠数量
---@param click function 点击回调
function ItemSpiritualBase:Show(sid, star, lv, count, callback, ...)
    self.sid = sid
    self.star = star or 0
    self.lv = lv
    self.count = count or 1
    self.callback = callback
    self.cfg = _G.ConfigManager.spiritual_cfg[self.sid]
    self.clickParams = { ... }
    self:ShowInfo()
end

---@param spiritualData SpiritualData
function ItemSpiritualBase:ShowData(spiritualData, callback, ...)
    self.spiritualData=spiritualData
    self.cardUid = spiritualData.cardUid or 0
    self.grade = spiritualData:GetOrder() or 1
    self.uid = spiritualData.uid or spiritualData.sid
    self:Show(
        spiritualData.sid,
        spiritualData:GetStar(),
        spiritualData:GetLevel(),
        spiritualData:GetCount(),
        callback,
        ...
    )
end

function ItemSpiritualBase:ShowInfo()
    if self.sid == 0 then
        return
    end

    local spiritualCfg = _G.ConfigManager.spiritual_cfg[self.sid]
    self.go_table.aorimage_ColorBG.SpriteName = _G.SpiritualItemIconName[spiritualCfg.Order]
    self.go_table.aorrawimage_Icon.Alpha = 0
    require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_Icon, spiritualCfg.image_1)

    self:ShowLevel()
    self:HideCount()
    self:ShowStar()
    self:ShowCardBound(self.cardUid)
    self:ShowXDtag(self.cfg.suit>0)
    self.showEffect = spiritualCfg.ef_item == 1
    --self:ShowOrderEffect(self.showEffect)
end

---设置特效（目前只在tip弹窗中显示）
function ItemSpiritualBase:SetEffect()
    self:ShowOrderEffect(self.showEffect)
end

---隐藏星级显示
function ItemSpiritualBase:HideStar()
    self.go_table.obj_stars:SetActiveE(0)
    self.go_table.obj_highStar:SetActiveE(0)
end

---显示星级
function ItemSpiritualBase:ShowStar()
    self.go_table.obj_stars:SetActiveE(self.star >= 0 and self.star <= 5 and 1 or 0)
    self.go_table.obj_highStar:SetActiveE(self.star > 5 and 1 or 0)
    if self.star >= 0 and self.star <= 5 then
        for i = 1, 5 do
            self.go_table["aorimage_starMask" .. i]:SetActiveE(0)
            self.go_table["aorimage_star" .. i]:SetActiveE(self.star >= i and 1 or 0)
        end
    elseif self.star > 5 then
        self.go_table.aortext_star.text = self.star
    end
end

---显示等级
function ItemSpiritualBase:ShowLevel()
    local lv = self.lv or 1
    -- _G.UIUtils.SetImageFont(self.FontImage_lv, "v" .. tostring(lv), _G.AorImageFont.Cardlevel)
    self.go_table.aortext_level.text = "LV." .. lv
end

---隐藏等级显示
function ItemSpiritualBase:HideLevel()
    self.go_table.obj_lvNode:SetActiveE(0)
end

---显示数量
function ItemSpiritualBase:ShowCount()
    local num = self.count or 1
    if num <= 1 then
        ---数量1 不显示
        num = nil
    else
        self.go_table.obj_itemNum:SetActiveE(1)
    end
    _G.UIUtils.SetItemNum_EquItemNum(self.go_table, num)
end

---隐藏数量
function ItemSpiritualBase:HideCount()
    self.go_table.obj_itemNum:SetActiveE(0)
end

---隐藏绑定
function ItemSpiritualBase:HideCardBound()
    self.go_table.aorimage_BoundBg:SetActiveE(0)
end

---显示/隐藏边框(卡牌背包页面使用)
---@param isShow boolean 是否显示
function ItemSpiritualBase:ShowOrHideFrame(isShow)
    self.go_table.aorimage_frame:SetActiveE(isShow and 1 or 0)
    self.go_table.aorimage_ColorBG.enabled = isShow
end

---卡牌绑定显示
function ItemSpiritualBase:ShowCardBound()
    self.go_table.aorimage_BoundBg:SetActiveE(self.cardUid ~= 0 and 1 or 0)
    if self.cardUid ~= 0 then
        ---@type CardData
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.cardUid)
        local cfg, star
        if cardData == nil then
            cfg = _G.ConfigManager.card_cfg[self.cardUid]
            if not cfg then
                self:HideCardBound()
                return
            end
            star = cfg.Star
        else
            star = cardData:GetStar()
            cfg = _G.ConfigManager.card_cfg[cardData.sid]
        end
        if not cfg then
            return
        end
        local icon = cfg.Icon

        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_BoundIcon.SpriteName = icon
        local bg = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(star)
        self.go_table.aorimage_BoundBg.SpriteName = bg
    end
end

function ItemSpiritualBase:ShowXDtag(isshow)
    if isshow==nil  then
        isshow=true
    end
    if self.go_table.aorimage_xd then
        self.go_table.aorimage_xd:SetActiveE(isshow and 1 or 0)
    end
end
---清楚品质特效
function ItemSpiritualBase:RemoveEffect()
    if self.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

---品质特效
---@field isShow boolean 是否显示特效
function ItemSpiritualBase:ShowOrderEffect(isShow)
    self:RemoveEffect()
    if isShow then
        local effect = OrderEffectCfg[self.grade]
        if effect then
            _G.UIUtils.LoadEffectByCfg(
                    effect,
                    self.go_table.obj_uieffect,
                    function(trans)
                        if self.go_table.obj_uieffect:GetChildCountE() > 1 then
                            _G.DestroyObject(trans)
                            return
                        end
                        local x, _, _ = self.go_table.obj_Scale:GetLocalScale()
                        trans.gameObject:SetLocalScaleXYZ(x)
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    end
            )
        end
    end
end

---设置大小
---@param size number 大小，默认75，即0.75
function ItemSpiritualBase:SetSize(size)
    self.go_table.obj_Scale:SetLocalScaleXYZ(size / 100)
end

return ItemSpiritualBase
