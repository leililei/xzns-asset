---@class SpiritualViewBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local SpiritualViewBase = _G.BaseClass("SpiritualViewBase", require("ItemViewBase"))
_G.SpiritualViewBase = SpiritualViewBase

function SpiritualViewBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemSpiritualBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemSpiritualBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua:ShowData(data, OnBtnFun, itemLua)
            end
            if callback then
                callback(itemLua)
            end
        end
    )
end
