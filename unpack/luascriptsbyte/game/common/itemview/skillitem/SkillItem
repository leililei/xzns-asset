---@class SkillItem	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local SkillItem = _G.BaseClass("SkillItem", require("ItemViewBase"))

local itemPrefabPath = "UI/Card/SkillItem"

local itemEffectCfgName = {
    "ItemEffect_white",
    "ItemEffect_blue",
    "ItemEffect_purple",
    "ItemEffect_gloden",
    "ItemEffect_red"
}

function SkillItem:Init(trans, data, OnBtnFun)
    self.cardData = data
    self.gameObject = trans
    self.transform = trans
    -- self.instanceID = self.gameObject:GetInstanceIDE()
    -- _G.ComponentCsListener.AddCSCalls(self.instanceID, self)
    -- _G.CS.LuaBehaviour.AddLuaBehaviour(self.gameObject, self.__cname)
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    local clickFun = OnBtnFun and OnBtnFun or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))
    self.sid = data.sid
    self.lock = data.Lock
    local Ecfg = _G.ConfigManager.card_skills_cfg[self.sid and self.sid or 0]
    if Ecfg then
        self.cfg = Ecfg
        self.go_table.aorrawimage_skill:LoadImage(
            Ecfg.icon,
            function(image)
                if image ~= nil then
                    image:SetActiveE(1)
                end
            end
        )
        self.go_table.aortext_UnlockLv.text = Ecfg.condition_star
        self.go_table.aortext_UnlockLv.text = Ecfg.level
    end
    if self.lock then
        self.go_table.obj_skilllock:SetActiveE(1)
        self.go_table.aortext_UnlockLv:SetActiveE(1)
        self.go_table.aortext_UnlockLv.text = self.cfg.condition_star
    else
        self.go_table.obj_skilllock:SetActiveE(0)
    end
end

local function GetEquipView()
    local item = _G.ObjectPool:GetInstance():Pop(SkillItem)
    return item
end

function SkillItem:ShowUnlockLv(bl)
    self.go_table.aortext_UnlockLv:SetActiveE(bl and 1 or 0)
end

function SkillItem:GetSkillLv()
    if self.lock then
        return 0
    end
    return self.cfg.level
end

function SkillItem:ShowSkillkLv(bl)
    self.go_table.aorimage_skilllevel:SetActiveE(bl and 1 or 0)
end

function SkillItem.Create(data, parent, callback, OnBtnFun)
    _G.PoolsManager:GetInstance():Spawn(
        itemPrefabPath,
        _G.ePoolType.UIItem,
        parent,
        function(trans)
            local item = GetEquipView()
            item:Init(trans, data, OnBtnFun)
            if callback then
                callback(item)
            end
        end
    )
end

return SkillItem
