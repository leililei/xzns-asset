local ColorType = {
    "ui-ghck-icon-hui",
    "ui-ghck-icon-hui",
    "ui-ghck-icon-lan",
    "ui-ghck-icon-zi",
    "ui-ghck-icon-cheng",
    "ui-ghck-icon-hong",
    "",
    "ui-ghck-icon-cai"
}
---@class ItemDebrisBase : ItemViewBase	道具卡牌碎片
---@field go_table ItemDebrisBase_GoTable
local ItemDebrisBase = _G.BaseClass("ItemDebrisBase", require("ItemViewBase"))

---类的构造函数
function ItemDebrisBase:__init(go, click)
    self.gameObject = go
    self.go_table = _G.GetAutoGoTable(go)
    local clickFun = click and click or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))
end

---类的析构函数
function ItemDebrisBase:Dispose()
end

function ItemDebrisBase:Show(sid, click, count)
    local data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 0)
    self.data = data
    local clickFun = click and click or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))
    self.go_table.aorimage_Color.SpriteName = _G.ItemBaseIconName[data.Grade]
    local cfg = _G.ConfigManager.item_cfg[sid]
    self.go_table.aorrawimage_Icon:SetActiveE(0)
    self.go_table.aorrawimage_Icon:LoadImage(
        cfg.Icon,
        function(image)
            image:SetActiveE(1)
            image:SetNativeSize()
        end
    )
    require "CardInfoManager":GetInstance():Star_byParent2(self.go_table.obj_starParent, cfg.Star)
    -- self.go_table.aorrawimage_PropBG:LoadImage(_G.ConfigManager.type_elements_cfg[cfg.Elements].icon)
    self.go_table.aorimage_element.SpriteName = ColorType[data.Grade]
    if not count or count == 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_ItemNum, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_ItemNum, true)
        -- _G.UIUtils.SetItemNum(self.go_table, count)
        self.go_table.aortext_num.text = count
    end
    local tag = _G.StorageManager:GetInstance():GetItemTag(sid)
    UIUtils.SetUIModel(self.go_table.aorimage_tag,self.go_table.aorimage_tag,self.go_table.aorimage_tag2,self.go_table.aorimage_tag2,tag,_G.string.IsNullOrEmpty(tag) == false)
    --if _G.string.IsNullOrEmpty(tag) then
    --    self.go_table.aorimage_tag:SetActiveE(0)
    --else
    --    self.go_table.aorimage_tag:SetActiveE(1)
    --    self.go_table.aorimage_tag.SpriteName = tag
    --end
end

function ItemDebrisBase:ShowData(data, click)
    self:Show(data.sid, click, data.count)
end

function ItemDebrisBase:OnClickBtn(go, isOn)
    require "CommonTipManager":GetInstance():OpenPropTip(go, self.data.sid)
end

return ItemDebrisBase
