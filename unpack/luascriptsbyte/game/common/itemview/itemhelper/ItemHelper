local ItemBaseParamData = require "ItemBaseParamData"
---@class ItemHelper
local ItemHelper = {}

--获取道具组件
local function GetItemComponent(itemTrans, itemClassType)
    local goTable = _G.GetAutoGoTable(itemTrans)
    ---@type ItemCommon
    local item = goTable._luaComponent
    if (item == nil) then
        item = itemClassType.New()
        goTable._luaComponent = item
        item.itemData = _G.New(ItemBaseParamData)
        item.gameObject = itemTrans
        item.transform = itemTrans
        item.go_table = goTable
        --这里还可以模拟一次awake, 用来初始化变量
        AddViewBtnClick(
            goTable,
            function()
                item:OnClickCallBack()
            end
        )
    end
    return item
end

--获取道具组件, 并且重置
---@generic ItemClassType : ItemBase
---@param parentComponent Component
---@param itemTrans Transform
---@param itemClassType ItemClassType | "ItemCommon" | "any" @ItemBase的实现类
---@return ItemClassType
local function ReItemComponent(itemTrans, itemClassType)
    local item = GetItemComponent(itemTrans, itemClassType)
    --还原点击
    item.itemData = _G.New(ItemBaseParamData)
    --item:SetGray(false)
    item:SetItemScale(1)
    return item
end

--获取指定数量重置的道具组件
---@generic ItemClassType : ItemBase
---@param parentTrans Transform @item的父节点
---@param itemClassType ItemClassType | "ItemCommon"  | "FullItem" | "any" @ItemBase的实现类
---@param itemNumber number @item的数量
---@param canRefreshEvent (fun(item : ItemClassType):void) | "function(item, index) item:RefreshItem(paramData) end" @每个item可刷新时
function ItemHelper.ReChildrenItemComponents(parentTrans, itemClassType, itemNumber, canRefreshEvent)
    if (parentTrans == nil) then
        error("parentTrans参数 父节点不允许为null")
    end
    local isLoaded = false
    local childCount = parentTrans:GetChildCountE()
    for i = 1, itemNumber do
        if (i <= childCount) then
            local itemTrans = parentTrans:GetChildE(i - 1)
            --显示
            local item = ReItemComponent(itemTrans, itemClassType)
            if (canRefreshEvent ~= nil) then
                canRefreshEvent(item, i)
            else
                item:RefreshItem()
            end
        else
            isLoaded = true
            ItemHelper.NewItemPrefabAsync(
                itemClassType.itemPath,
                parentTrans,
                function(itemTrans)
                    itemTrans:SetLocalPositionToZero()
                    --防止重复加载(多余的进行隐藏)
                    if (i == itemNumber) then
                        childCount = parentTrans:GetChildCountE()
                        for i = itemNumber + 1, childCount do
                            local node = parentTrans:GetChildE(i - 1)
                            --隐藏
                            node:SetLocalScaleXYZ(0)
                        end
                    end
                    --显示
                    local item = ReItemComponent(itemTrans, itemClassType)
                    if (canRefreshEvent ~= nil) then
                        canRefreshEvent(item, i)
                    else
                        item:RefreshItem()
                    end
                end
            )
        end
    end
    if (isLoaded) then
        return
    end
    childCount = parentTrans:GetChildCountE()
    for i = itemNumber + 1, childCount do
        local itemTrans = parentTrans:GetChildE(i - 1)
        --隐藏
        itemTrans:SetLocalScaleXYZ(0)
    end
end

--根据指定路径, 载入配置
---构建一个prefab出来
---@param itemPath string ItemHelper.prefabPaths
---@param parent Transform
---@param newFinishEvent fun(newTrans:Transform)
function ItemHelper.NewItemPrefabAsync(itemPath, parent, newFinishEvent)
    if (parent == nil) then
        if _G.AppSetting.DEBUG then
            _G.LogError("构建prefab， 父节点不允许为null")
        end
        return
    end
    if itemPath == "UIH5/Common/ItemView/BaseItem" then
        --如果父节点为隐藏状态, 不允许分配缓存
        if (0 == parent:GetctiveInHierarchy()) then
            if _G.AppSetting.DEBUG then
                _G.LogError("不允许在隐藏节点下, 使用缓存池的对象" .. GameUtils.PopNodeNameActiveInfo(parent))
            end
            return
        end
        PoolsManager:GetInstance():Spawn(
            itemPath,
            "Static",
            parent,
            function(trans)
                --这种情况按道理不会出现
                if (parent == nil) then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("道具预制缓存 都是预分配, 回调父节点为空")
                    end
                    PoolsManager:GetInstance().Despawn(trans, ePoolType.Static)
                    return
                end
                newFinishEvent(trans)
            end
        )
    else
        _G.ResourcesManager:GetInstance():LoadGameObjAsync(
            itemPath,
            function(obj)
                --节点已被摧毁
                if (parent == nil) then
                    GameObject.Destroy(obj)
                    return
                end
                newFinishEvent(obj)
            end,
            parent
        )
    end
end

---克隆一个物体
---@param parentTrans UnityEngine.Transform 父节点
---@param childTrans UnityEngine.Transform 克隆节点
---@param itemNumber number 数量
---@param refreshEvent fun(item:UnityEngine.Transform, index:number)
function ItemHelper.ReChildrenObjcet(parentTrans, childTrans, itemNumber, refreshEvent)
    if (parentTrans == nil) then
        error("parentTrans参数 父节点不允许为null")
    end
    local childCount = parentTrans:GetChildCountE()
    for i = 1, itemNumber do
        if (i <= childCount) then
            local itemTrans = parentTrans:GetChildE(i - 1)
            itemTrans:SetLocalScaleXYZ(1)
            if (refreshEvent ~= nil) then
                refreshEvent(itemTrans, i)
            end
        else
            local child = childTrans:InstantiatE(parentTrans)
            child:SetLocalPositionToZero()
            --防止重复加载(多余的进行隐藏)
            if (i == itemNumber) then
                childCount = parentTrans:GetChildCountE()
                for i = itemNumber + 1, childCount do
                    local node = parentTrans:GetChildE(i - 1)
                    --隐藏
                    node:SetLocalScaleXYZ(0)
                end
            end
            --显示
            if (refreshEvent ~= nil) then
                refreshEvent(child, i)
            end
        end
    end
    childCount = parentTrans:GetChildCountE()
    for i = itemNumber + 1, childCount do
        local itemTrans = parentTrans:GetChildE(i - 1)
        --隐藏
        itemTrans:SetLocalScaleXYZ(0)
    end
end

