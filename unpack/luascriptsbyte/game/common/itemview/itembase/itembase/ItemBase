local ItemBaseParamData = require "ItemBaseParamData"
local ItemHelper = require("ItemHelper")

---@class ItemBase
---@field public itemParamData ItemBaseParamData
---@field private go_table table
local ItemBase = BaseClass("ItemBase")

---预置路径
ItemBase.itemPath = "UIH5/Common/ItemView/BaseItem"
---item所使用到的品质名
ItemBase.colorTbl = {
    "ty_box_kuang_1",
    "ty_box_kuang_2",
    "ty_box_kuang_3",
    "ty_box_kuang_4",
    "ty_box_kuang_5",
    "ty_box_kuang_6"
}
---图标资源地址
ItemBase.iconPath = "Images/Icon/"

---通过品质拿资源名
---@param quality number 品质
function ItemBase:GetItemQualityImg(quality)
    if quality <= 0 then
        return nil
    end
    return self.colorTbl[quality]
end

---更新item真实数据
---@param itemParamData ItemBaseParamData
function ItemBase:RefreshItem(itemParamData)
    if (itemParamData == nil) then
        itemParamData = self.NewParam()
    end
    self.itemData.config = nil
    -- 初始化基础数据
    self.itemParamData = itemParamData
    self:RefreshView()
end

---NewParam
---@param sid number 配置id
---@param number number 物品数量
---@param needShowName boolean 是否显示名字
function ItemBase.NewParam(sid, number, needShowName)
    local param = _G.New(ItemBaseParamData)
    param.sid = sid
    if (number) then
        param.number = number
    end
    if (needShowName) then
        param.needShowName = needShowName
    end
    return param
end

---添加按钮监听事件(返回 true, 将打断以下点击逻辑)
---SetClickListener
---@param clickEvent (fun():void) | "function() end"
function ItemBase:SetClickListener(clickEvent)
    self.itemData.clickCallBack = clickEvent
end

---是否打开tips
function ItemBase:SetOpenTips(value)
    self.itemData.clickOpenTips = value
end

---设置道具缩放
function ItemBase:SetItemScale(value)
    self.transform:SetLocalScaleXYZ(value)
end

---设置文字字体大小
function ItemBase:SetConentSize(size)
    self.go_table.aortext_Num.fontSize = size
end

---设置图标
function ItemBase:SetImageIcon(iconName, fullPath)
    if nil == fullPath then
        fullPath = false
    end
    if (iconName == nil) then
        iconName = ""
    end
    self.oldIconPath = iconName
    if (iconName == "") then
        self.go_table.aorimage_Icon:LoadSingleSprite(nil)
    else
        if fullPath then
            self.go_table.aorimage_Icon:LoadSingleSprite(iconName)
        else
            self.go_table.aorimage_Icon:LoadSingleSprite(self.iconPath .. iconName)
        end
    end
end

---设置品质底
function ItemBase:SetImageQuality(bgName)
    if nil == bgName then
        self.go_table.aorimage_Bg.SpriteName = ""
    else
        if self.oldBgPath ~= bgName then
            self.oldBgPath = bgName
            self.go_table.aorimage_Bg.SpriteName = bgName
        end
    end
end

---设置品质框
function ItemBase:SetFrameQuality(frameName)
    if nil == frameName then
        self.go_table.aorimage_Frame.SpriteName = ""
    else
        if self.oldFramePath ~= frameName then
            self.oldFramePath = frameName
            self.go_table.aorimage_Frame.SpriteName = frameName
        end
    end
end

function ItemBase:RefreshView()
    local itemData = self.itemData
    -- 初始化Base param
    if itemData ~= nil then
        if itemData.config ~= nil then
            local iconName = itemData.config.IconPath
            self:SetImageIcon(iconName)
            if (iconName == nil) then
                self:SetImageQuality("ty_box_kuang_1")
            else
                local quality = itemData.config.Quality
                local qualityImg = self:GetItemQualityImg(quality)
                self:SetImageQuality(qualityImg)
            end
        else
            self:SetImageIcon(nil)
            self:SetImageQuality("ty_box_kuang_1")
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("itemData Error,将不会加载基础配置！！！")
        end
        self:SetImageIcon(nil)
        self:SetImageQuality(nil)
    end

    local go_table = self.go_table
    local itemParamData = self.itemParamData
    if itemParamData == nil then
        return
    end
    --显示名字
    if itemParamData.needShowName and self.itemData.config ~= nil then
        go_table.aortext_Name.text = self.itemData.config.Name
        --设置名字的颜色
        self:SetNameColor(go_table.aortext_Name, itemData.config.Quality)
    else
        go_table.aortext_Name.text = ""
    end
    --数量
    if itemParamData.number > 0 then
        go_table.aortext_Num.text = itemParamData.number
    else
        go_table.aortext_Num.text = ""
    end
end

---设置名字的颜色
function ItemBase:SetNameColor(componentAorText, quality)
    componentAorText.color = _G.GameUtil.GetColorByQuality(quality)
end

---@private 按钮点击回调
function ItemBase:OnClickCallBack()
    -- 获取自定义参数，执行按钮回调
    local data = self.itemData
    if data ~= nil and data.clickCallBack ~= nil then
        --提供回调参数
        data.clickCallBack(self)
    end
    if data.clickOpenTips and data.config ~= nil then
        self:OpenTips()
    end
end

function ItemBase:OpenTips()
    local config = self.itemData.config
    ItemHelper.OpenItemTips(config, _G.Vector3.New(self.transform:GetPosition()))
end

return ItemBase
