local ItemBase = require "ItemBase"
local ItemCardParamData = require "ItemCardParamData"
---@class ItemCard
local ItemCard = BaseClass("ItemCard", ItemBase)

--预置路径
ItemCard.itemPath = "UIH5/Common/ItemView/CardItem"
--card所使用到的品质名
ItemCard.colorTbl = {
    "ty_box_touxiang_1",
    "ty_box_touxiang_2",
    "ty_box_touxiang_3",
    "ty_box_touxiang_4",
    "ty_box_touxiang_5",
    "ty_box_touxiang_6"
}
--图标资源地址
ItemCard.iconPath = "Images/Roles/"

---更新item真实数据
---@param itemParamData ItemCardParamData
function ItemCard:RefreshItem(itemParamData)
    if (itemParamData == nil) then
        itemParamData = self.NewParam()
    end
    if (itemParamData.sid ~= nil) then
        self.itemData.config = _G.ConfigManager.card_cfg[itemParamData.sid]
    else
        self.itemData.config = nil
    end
    -- 初始化基础数据
    self.itemParamData = itemParamData
    self:RefreshView()
end

---NewParam
---@param sid number 配置id
---@param number number 物品数量
---@param needShowName boolean 是否显示名字
function ItemCard.NewParam(sid, number, needShowName)
    local param = _G.New(ItemCardParamData)
    param.sid = sid
    if (number) then
        param.number = number
    end
    if (needShowName) then
        param.needShowName = needShowName
    end
    return param
end

function ItemCard:RefreshView()
    ItemBase.RefreshView(self)
    ---@type ItemCardParamData itemParamData
    local itemParamData = self.itemParamData
    local go_table = self.go_table
    ---卡片等级
    if itemParamData.level > 0 then
        go_table.aorimage_Level.SpriteName = "ty_icon_pingjie_" .. itemParamData.level
    else
        go_table.aorimage_Level.SpriteName = ""
    end
    --todo 品质，卡片的品质可能是动态的
    local quality = 4
    self:SetNameColor(go_table.aortext_Name, quality)
    local itemData = self.itemData
    if itemData ~= nil then
        if itemData.config ~= nil then
            local image = itemData.config.Icon
            if image ~= nil then
                self:SetImageIcon(image, false)
            else
                if _G.AppSetting.DEBUG then
                    _G.LogError("设置卡片信息未配置 card_cfg " .. image)
                end
            end
        end
    end
    local qualityImg = self:GetItemQualityImg(quality)
    self:SetImageQuality("ty_box_touxiang_0")
    self:SetFrameQuality(qualityImg)
end

return ItemCard
