---显示数量
---@param show boolean 是否显示数量
---@param anchor number 锚点类型(默认图标框下方)
---@return 变量类型 中文描述
function ItemViewBase:ShowNumText(show, anchor)
    if not self.numTexts or #self.numTexts <= 0 then
        return
    end
    if show then
        anchor = anchor or ItemViewBase.NumTextAnchor.None
        for i = 1, #self.numTexts do
            self.numTexts[i]:SetActiveE(i == anchor and 1 or 0)
        end
    else
        for i = 1, #self.numTexts do
            self.numTexts[i]:SetActiveE(0)
        end
    end
end

---显示物品名字
function ItemViewBase:ShowName(show)
    if self.cfg == nil or not self.go_table.aortext_Name then
        return
    end
    if show == nil then
        show = false
    end
    if show then
        self.go_table.aortext_Name.text = _G.LangUtil.GetLangPackValue(self.cfg.Name or self.cfg.name)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_Name, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_Name, false)
    end
end

---@param isShow boolean nil/True创建后显示特效
function ItemViewBase:ShowEffect(isShow, NeedCheck)
    if isShow == nil then
        isShow = true
    end
    if NeedCheck == nil then
        NeedCheck = false
    end
    -- if self.effectTrans or (not _G.IsNil(self.effectTrans)) then
    --     return
    -- end
    -- self.effectTrans = true
    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg[itemEffectCfgName[self.cfg and self.cfg.Quality or 4]],
    --     self.go_table.obj_Root,
    --     function()
    --     end,
    --     function(trans)
    --         self.effectTrans = trans
    --     end
    -- )
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    --ZHJH-11238 蓝色物品加载品质特效时，由于没有蓝色特效导致打印了加载失败的信息。改为没有对应特效就不加载
    if not effect then
        return
    end
    --self.go_table.NowEffKey = key
    if self.go_table.EffDic == nil then
        self.go_table.EffDic = {}
    end

    if self.go_table.EffDic[key] == nil then
        self.go_table.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.go_table.obj_qualityeffect,
            function(trans)
                -- trans:SetAnchorPosition(0, 0, 0)
                self.go_table.EffDic[key] = trans
                trans:SetName(key)
                trans:SetActiveE(0)
                if isShow == true then
                    trans:SetActiveE(1)
                end
                --这里添加一个特效需要移动和缩放，需要一直检测世界区域，用于裁减
                local particleClipRect = trans:GetComponentE(_G.typeof(_G.CS.ParticleClipRect))
                if _G.IsNil(particleClipRect) ~= true then
                    particleClipRect.NeedCheck = NeedCheck
                end
            end
        )
    elseif self.go_table.EffDic[key] ~= true then
        _G.GameUtil.SetActiveByCondition(self.go_table.EffDic[key], isShow)
    end
    if self.go_table.obj_qualityeffect then
        local len = self.go_table.obj_qualityeffect:GetChildCountE()
        for i = len, 1, -1 do
            local item = self.go_table.obj_qualityeffect:GetChildE(i - 1)
            if item:GetName() ~= key then
                item:SetActiveE(0)
            end
        end
        self.go_table.obj_qualityeffect:SetActiveE(0)
        _G.DelayDo(0.02, function()
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_qualityeffect, isShow)
        end)
    end
end

---@param isShow boolean nil/True创建后显示特效
function ItemViewBase:ShowItemCard(isShow)
    if isShow == nil then
        isShow = true
    end
    -- if self.effectTrans or (not _G.IsNil(self.effectTrans)) then
    --     return
    -- end
    -- self.effectTrans = true
    -- _G.UIUtils.LoadEffectByCfg(
    --     _G.ConfigManager.ui_effect_cfg[itemEffectCfgName[self.cfg and self.cfg.Quality or 4]],
    --     self.go_table.obj_Root,
    --     function()
    --     end,
    --     function(trans)
    --         self.effectTrans = trans
    --     end
    -- )
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)

    self.go_table.NowEffKey = key
    if self.go_table.EffDic == nil then
        self.go_table.EffDic = {}
    end

    if self.go_table.EffDic[key] == nil then
        self.go_table.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_ItemCardAllView,
            self.gameObject,
            function(trans)
                trans:SetAnchorPosition(5.5, -12, 0)
                trans:SetLocalScaleXYZ(1.3)
                self.go_table.EffDic[key] = trans
                if key ~= self.go_table.NowEffKey or isShow == false then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
            end
        )
    elseif self.go_table.EffDic[key] ~= true then
        self.go_table.EffDic[key]:SetActiveE(isShow and 1 or 0)
    end
end

function ItemViewBase:ShowOrHideEffect(isEffect)
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    local effItem = self.go_table.EffDic and self.go_table.EffDic[key]
    if effItem and effItem ~= true then
        effItem:SetActiveE(isEffect and 1 or 0)
    end

    if self.go_table.obj_qualityeffect then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_qualityeffect, isEffect)
    end
end

