--region 类方法
-----创建item显示对象
---@param data table 构建数据 {sid=0,number=0}
---@param parent UnityEngine.Transform 父节点
---@param callback function 构建完成后的回调方法，会将构建好的对象传回
---@param OnBtnFun function 点击事件绑定函数 nil为默认
function ItemViewBase.Create(data, parent, callback, OnBtnFun)
    _G.PoolsManager:GetInstance():Spawn(
        itemPrefabPath,
        _G.ePoolType.UIItem,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                -- 这里如果加载失败要回调nil 不然会有问题,加载是item是按顺序加载的，如果没有回调下一个会不执行
                if callback then
                    callback(nil)
                end
                return
            end
            local item = GetItemView()
            item:Init(trans, data, OnBtnFun)
            if callback then
                callback(item)
            end
        end
    )
end

-----回收item
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function ItemViewBase.Despawn(item)
    item:SetPri(false)
    if item.go_table.obj_gou and item.go_table.obj_gou:GetChildCountE() > 0 then
        for i = 1, item.go_table.obj_gou:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(item.go_table.obj_gou:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    if item.go_table.obj_uieffect and item.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, item.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(item.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    if item.go_table.obj_qualityeffect and item.go_table.obj_qualityeffect:GetChildCountE() > 0 then
        for i = 1, item.go_table.obj_qualityeffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(item.go_table.obj_qualityeffect:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    if not _G.IsNil(item.gouTran) then
        _G.PoolsManager:GetInstance():Despawn(item.gouTran, _G.ePoolType.UIItem)
    end
    if item.transform then
        _G.PoolsManager:GetInstance():Despawn(item.transform, _G.ePoolType.UIItem)
    end
    item:Dispose()
end

--endregion

return ItemViewBase
