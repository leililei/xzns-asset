function ItemViewBase:SetGou(isGou)
    if self.isGou == isGou then
        return
    end
    self.isGou = isGou
    if self.gouTran == nil then
        self.gouTran = 1
        _G.PoolsManager:GetInstance():Spawn(
            itemGouPrefabPath,
            _G.ePoolType.UIItem,
            self.gameObject,
            function(trans)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(trans)
                    return
                end
                self.gouTran = trans
                _G.GameUtil.SetActiveByCondition(self.gouTran, self.isGou)
            end
        )
    else
        if not IsNumber(self.gouTran) then
            _G.GameUtil.SetActiveByCondition(self.gouTran, self.isGou)
        end
    end
end

