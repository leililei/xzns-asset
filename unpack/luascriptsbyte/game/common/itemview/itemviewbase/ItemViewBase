---类的析构函数
function ItemViewBase:Dispose()
    self.gameObject = nil
    self.transform = nil
    self.go_table = nil
    self.effectTrans = nil
    ---勾选预制体
    self.gouTran = nil
    ---是否勾选
    self.isGou = nil
    ---是否为特权
    self.isPri = nil
    _G.ObjectPool:GetInstance():Push(self)
end

function ItemViewBase:UpdateData(trans, data)
    self.gameObject = trans
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.numTexts = { self.go_table.aortext_Number, self.go_table.obj_ItemNum }

    if data then
        self.sid = data.sid
        self.count = data.number or data.fixNum or data.count
        self.go_table.aortext_Number.text = "X" .. _G.tostring(self.count)
        self:ShowCount()
        local cfg = data.cfg
        if cfg then
            self.cfg = cfg
            self:SetImage(data.sid)
        end
    end

    -- 显示品质特效
    self:SetGrade()
    self:SetRootPos(_G.Vector3.zero)
    self:ShowNumText(self.count > 0)
    self:ShowNew(false)
    self:ShowName()
    self:SetGray(false)
end

---更新点击函数
function ItemViewBase:UpdateFunction(OnBtnFun)
    local clickFun = OnBtnFun and OnBtnFun or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))
end

