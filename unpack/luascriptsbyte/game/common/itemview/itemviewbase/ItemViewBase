function ItemViewBase:SetImage(sid)
    if self.go_table == nil then
        return
    end
    if self.go_table.itemLua == nil then
        ---@param itemLua ItemViewNew
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.baseItem,
            self.go_table.obj_item,
            function(itemLua)
                if not _G.IsNil(self.gameObject) then
                    self.go_table.itemLua = itemLua
                    self.go_table.itemLua:Show(sid)
                    if self.hideColor then
                        self.go_table.itemLua.go_table.aorimage_Color:SetActiveE(0)
                    end
                end
            end
        )
    else
        self.go_table.itemLua:Show(sid)
    end
end

function ItemViewBase:HideColor()
    if self.go_table.itemLua then
        self.go_table.itemLua.go_table.aorimage_Color:SetActiveE(0)
    end
end

function ItemViewBase:ShowCount(count)
    if self.go_table == nil then
        return
    end
    if count == nil then
        count = self.count
    else
        self.count = count
    end

    _G.UIUtils.SetItemNum(self.go_table, count)
end

function ItemViewBase:SetGray(isGray)
    if self.go_table and self.go_table.itemLua then
        self.go_table.itemLua:SetGray(isGray)
    end
end

