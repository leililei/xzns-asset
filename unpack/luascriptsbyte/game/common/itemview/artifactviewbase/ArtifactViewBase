---@class ArtifactViewBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local ArtifactViewBase = _G.BaseClass("ArtifactViewBase", require("ItemViewBase"))
_G.ArtifactViewBase = ArtifactViewBase

function ArtifactViewBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemArtifactBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemArtifactBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua:ShowData(data, OnBtnFun, itemLua)
            end
            if callback then
                callback(itemLua)
            end
        end
)
end
