require "ItemViewBase"
---@class MaterialBase	中文描述
---@field public go_table BaseItemView_GoTable GoTable
local MaterialBase = _G.BaseClass("MaterialBase", require("ItemViewBase"))

local itemPrefabPath = "UI/DecorationView/$_obj_Material"

function MaterialBase:Init(trans, data, OnBtnFun)
    self.data = data
    self.gameObject = trans
    self.transform = trans
    -- self.instanceID = self.gameObject:GetInstanceIDE()
    -- _G.ComponentCsListener.AddCSCalls(self.instanceID, self)
    -- _G.CS.LuaBehaviour.AddLuaBehaviour(self.gameObject, self.__cname)
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    local clickFun = OnBtnFun and OnBtnFun or self.OnClickBtn
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, clickFun))
    self.sid = data.sid
    self.cfg = data.cfg
    self.go_table.aorrawimage_Icon:LoadImage(data.cfg.icon or data.cfg.Icon)

    self.go_table.aortext_Des.text = "0/0"
end

local function GetEquipView()
    local item = _G.ObjectPool:GetInstance():Pop(MaterialBase)
    return item
end

---设置消耗
function MaterialBase:SetConsume(num)
    local ConsumeCount = _G.GameUtil.NumberToUnitStr(num)
    local _, storageID = _G.StorageManager:GetInstance():CheckSidType(self.sid)
    local haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageID, self.sid)
    if haveCount >= num then
        haveCount = _G.GameUtil.NumberToUnitStr(haveCount)
        --self.go_table.aortext_Des.text = "<color=#FFFFFF>" .. haveCount .. "</color>" .. "/" .. ConsumeCount
        self.go_table.aortext_Des.text = "<color=#FFFFFF>" .. ConsumeCount .. "</color>"
    else
        haveCount = _G.GameUtil.NumberToUnitStr(haveCount)
        --self.go_table.aortext_Des.text = "<color=#d62828>" .. haveCount .. "</color>" .. "/" .. ConsumeCount
        self.go_table.aortext_Des.text = "<color=#d62828>" .. ConsumeCount .. "</color>"
    end
end

function MaterialBase.Create(data, parent, callback, OnBtnFun)
    _G.PoolsManager:GetInstance():Spawn(
        itemPrefabPath,
        _G.ePoolType.UIItem,
        parent,
        function(trans)
            local item = GetEquipView()
            item:Init(trans, data, OnBtnFun)
            if callback then
                callback(item)
            end
        end
    )
end

return MaterialBase
