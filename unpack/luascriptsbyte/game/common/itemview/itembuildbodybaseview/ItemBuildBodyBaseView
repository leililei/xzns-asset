---类的构造函数
function ItemBuildBodyBaseView:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_Click:SetActiveE(self.click and 1 or 0)
    self.isGou = false
end

---类的析构函数
function ItemBuildBodyBaseView:Dispose()
    self.isGou = nil
end

function ItemBuildBodyBaseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
            -- else
            --     require "CommonTipManager":GetInstance():OpenTip(go, self.sid)
        end
    end
end

---参数显示
---@param sid number 神器sid
---@param star number 神器星级
---@param lv number 神器等级
---@param isAwaken boolean 神器是否觉醒
---@param count number 神器堆叠数量
---@param click function 点击回调
function ItemBuildBodyBaseView:Show(sid, star, click, ...)
    self.sid = sid
    self.click = click
    self.clickParams = { ... }
    self.star = star or 0
    self.cfg = _G.ConfigManager.manor_build_cfg[self.sid]
    self:ShowInfo()
end

---类显示
---@param BuildData BuildData
function ItemBuildBodyBaseView:ShowData(BuildData, click, ...)
    self.grade = BuildData:GetOrder() or 1
    self:Show(
        BuildData.sid,
        BuildData:GetStar(),
        click,
        ...
    )
end

---设置大小
---@param size number 大小，默认75，即0.75
function ItemBuildBodyBaseView:SetSize(size)
    self.go_table.obj_Scale:SetLocalScaleXYZ(size / 100)
end

function ItemBuildBodyBaseView:ShowInfo()
    if self.sid == 0 then
        return
    end
    -- self.go_table.aorimage_IconBg.SpriteName = _G.PetBodyIconName[self.cfg.Order]

    if not _G.AppSetting.IsXzns then
        self.go_table.aorimage_nameBg.SpriteName = BuildBgColorIconName2[self.cfg.Order]
        self.go_table.aorimage_IconBg.SpriteName = BuildBgColorIconName[self.cfg.Order]
    else
        self.go_table.aorimage_nameBg.SpriteName = BuildBgColorIconName2XZNS[self.cfg.Order]
        self.go_table.aorimage_IconBg.SpriteName = BuildBgColorIconName[self.cfg.Order]
        self.go_table.aorimage_IconBg2.SpriteName = BuildBg2ColorIconName[self.cfg.Order]
        self.go_table.aorimage_IconFlower.SpriteName = BuildFlowerIconName[self.cfg.Order]
        -- self.go_table.aorimage_IconBg:SetNativeSize()
    end

    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(self.cfg.Order))
    -- ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, self.cfg.Order)
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.cfg.Name)
    -- self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aorrawimage_Icon.Alpha = 0
    self.go_table.aorrawimage_Icon:LoadImage(
        self.cfg.image_2,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            trans:SetNativeSize()

            -- local pos = self.cfg.image_portrait1
            -- if #pos == 4 then
            --     trans:SetLocalPosition(pos[1], pos[2], pos[3])
            --     trans:SetLocalScaleXYZ(pos[4])
            -- end
        end)


    self.go_table.aorrawimage_Icon2:LoadImage(
        self.cfg.image_1,
        function(trans)
            if not self.go_table then
                _G.DestroyObject(trans)
                return
            end
            -- trans:SetNativeSize()
        end)

    --星级展示
    for i = 1, 5 do
        self.go_table["obj_starBackground" .. i]:SetActiveE(self.cfg.Star >= i and 1 or 0)
        self.go_table["aorimage_star" .. i]:SetActiveE(self.star >= i and 1 or 0)
    end

    for i = 1, 5 do
        self.go_table["aorimage_star" .. i].SpriteName = "ui_ty_kapaipinjie_1"
    end
    if self.star - 5 > 0 then
        for i = 1, self.star - 5 do
            self.go_table["aorimage_star" .. i].SpriteName = "ui_img_xing_hong"
        end
    end
    -- self.showEffect = PetCfg.ef_item == 1
    -- self:ShowOrderEffect(self.showEffect)
end

---隐藏星级显示
function ItemBuildBodyBaseView:HideStar()
    self.go_table.obj_stars:SetActiveE(0)
end

---外部调用 只更换信息  不更换点击
---@param BuildData BuildData
function ItemBuildBodyBaseView:UpDataInfo(BuildData)
    self.sid = BuildData.sid
    self.star = BuildData.star or 0
    self:ShowInfo()
end

function ItemBuildBodyBaseView:SetGou(isGou)
    self.go_table.aorimage_mask:SetActiveE(isGou and 1 or 0)
    self.go_table.aorimage_gou:SetActiveE(isGou and 1 or 0)
end

function ItemBuildBodyBaseView:SetMask(isMask)
    self.go_table.aorimage_mask:SetActiveE(isMask and 1 or 0)
end

function ItemBuildBodyBaseView:ShowEffect(isShow)
    if isShow == nil then
        isShow = true
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    self.go_table.NowEffKey = key
    if self.go_table.EffDic == nil then
        self.go_table.EffDic = {}
    end
    if self.go_table.EffDic[key] == nil then
        self.go_table.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.go_table.obj_qualityeffect,
            function(trans)
                -- trans:SetAnchorPosition(0, 0, 0)
                self.go_table.EffDic[key] = trans
                if key ~= self.go_table.NowEffKey or isShow == false then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
            end
        )
    elseif self.go_table.EffDic[key] ~= true then
        self.go_table.EffDic[key]:SetActiveE(isShow and 1 or 0)
    end
end

function ItemBuildBodyBaseView:ShowOrHideEffect(isEffect)
    if not self.go_table.EffDic then
        self.go_table.EffDic = {}
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    if self.go_table.EffDic[key] then
        self.go_table.EffDic[key]:SetActiveE(isEffect and 1 or 0)
    end
end

---滑动会生成多个对勾的 预制体
function ItemBuildBodyBaseView:SetGouScroll(isGou)
    self.go_table.aorimage_mask:SetActiveE(isGou and 1 or 0)
    self.go_table.aorimage_gou:SetActiveE(isGou and 1 or 0)
end

function ItemBuildBodyBaseView:SetMaskScroll(isMask)
    self.go_table.aorimage_mask:SetActiveE(isMask and 1 or 0)
end

---(预制体新增节点,根据物品品质生成特效) 滑动列表会出现不同品质的装备的特效
function ItemBuildBodyBaseView:ShowEffectOrder(isShowEffect)
    self:RemoveEffect()
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    _G.UIUtils.LoadEffectByCfg(
        effect,
        self.go_table.obj_uieffect,
        function(trans)
            trans:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end

---清楚品质特效
function ItemBuildBodyBaseView:RemoveEffect()
    if self.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

return ItemBuildBodyBaseView
