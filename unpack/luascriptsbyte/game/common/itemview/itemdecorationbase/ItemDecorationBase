---@class ItemDecorationBase    符文
---@field data DecorationData
---@field go_table ItemDecorationBase_GoTable
local ItemDecorationBase = _G.BaseClass("ItemDecorationBase", require("ItemViewBase"))

function ItemDecorationBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---@param data DecorationData
function ItemDecorationBase:ShowData(data, click)
    self:Show(data.sid, data.uid, click, data)
    self:ShowRoleHead(false)
end

function ItemDecorationBase:Show(sid, uid, click, data)
    self.sid = sid
    self.uid = uid or 0
    if data then
        self.data = data
    else
        if self.uid and self.uid ~= self.sid and self.uid > 0 then
            self.data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Decoration, uid)
        else
            self.data = _G.StorageManager:GetInstance():GetItemDataClass(self.sid, 1)
        end
    end
    self.click = click
    self:ShowInfo()
end

function ItemDecorationBase:ShowInfo()
    self.go_table.aorimage_Color2.SpriteName = _G.RuneRankEnum[self.data.Grade]
    self.go_table.aorrawimage_Icon:LoadImage(self.data.Icon)
    ---套装角标
    local cfg = _G.ConfigManager.decoration_suit_cfg[self.data.suit]
    if _G.string.IsNullOrEmpty(cfg.icon) then
        self.go_table.aorrawimage_suit:SetActiveE(0)
    else
        self.go_table.aorrawimage_suit:SetActiveE(1)
        self.go_table.aorrawimage_suit:LoadImage(cfg.icon)
    end
    self.go_table.obj_up:SetActiveE(0)
    self.go_table.aorimage_LvBg:SetActiveE(0)
end

function ItemDecorationBase:HidePart()
    self.go_table.aorrawimage_suit:SetActiveE(0)
end

function ItemDecorationBase:ShowSlotLevel(isShow, lv)
    self.go_table.aorimage_LvBg:SetActiveE(isShow and 1 or 0)
    if isShow then
        self.go_table.aortext_buildLv.text = lv or 1
    end
end

function ItemDecorationBase:ShowLevel(isShow, level)
    self.go_table.aortext_level:SetActiveE(isShow and 1 or 0)
    if isShow then
        local lv = level and level or self.data.level
        self.go_table.aortext_level.text = _G.GetLangPackValue(32001170403, lv)
    end
end

function ItemDecorationBase:ShowRoleHead(isShow)
    local cardData = self.data.cardUid ~= 0 and _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,self.data.cardUid) or nil
    if isShow and cardData then
        self.go_table.aorimage_BoundBg:SetActiveE(1)
        self.go_table.aorimage_BoundBg.SpriteName = _G.RuneRankEnum[_G.StorageManager:GetInstance():GetItemQuality(self.data.sid)]
        --local cfg = _G.ConfigManager.card_cfg[self.data.cardUid]
        local cfg = cardData.cfg
        if not cfg then
            return
        end
        local icon = cfg.Icon

        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_BoundIcon.SpriteName = icon
    else
        self.go_table.aorimage_BoundBg:SetActiveE(0)
    end
end

function ItemDecorationBase:ShowUp(isShow)
    self.go_table.obj_up:SetActiveE(isShow and 1 or 0)
end

function ItemDecorationBase:OnClickBtn(go, isOn)
    if self.click then
        self.click(self.clickParams)
    else
        local cfg = _G.ConfigManager.decoration_cfg[self.sid]
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name, self.data, cfg, true,nil,nil,false,true)
    end
end

---显示底框
function ItemDecorationBase:ShowFrame()
    self.go_table.aorimage_Color2.SpriteName = _G.RuneRankEnum[_G.StorageManager:GetInstance():GetItemQuality(self.data.sid)]
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Color2, true)
end

return ItemDecorationBase
