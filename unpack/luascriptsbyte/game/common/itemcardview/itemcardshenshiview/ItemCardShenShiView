local ItemCardAllView = require("ItemCardAllView")
---@class ItemCardShenShiView	中文描述
local ItemCardShenShiView = _G.BaseClass("ItemCardShenShiView", ItemCardAllView)
_G.ItemCardShenShiView = ItemCardShenShiView

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function ItemCardShenShiView:__init(obj)
    --选中
    self.selectPanel = self.go_table.trans_panel_select
    self.isSelect = false
    self.pinjieDic = {
        [1] = "ui_ty_kapai_pinjie1",
        [2] = "ui_ty_kapai_pinjie2",
        [3] = "ui_ty_kapai_pinjie3",
        [4] = "ui_ty_kapai_pinjie4"
    }
end

---类的析构函数
function ItemCardShenShiView:Dispose()
    self.cardlevel = nil
    self.hl_level = nil
    self.selectPanel = nil
end

function ItemCardShenShiView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.clickShenshi then
            self.clickShenshi(self.clickParamsShensh)
        else
        end
    end
end

---神石格子 显示 sid, click, star, awakenlv, uid,cardLevel,hlLevel
function ItemCardShenShiView:Show1(cardData, click, ...)
    local data = {}
    data.sid = cardData.sid
    data.start = cardData.star
    data.uid = cardData.uid
    data.level = cardData:GetLevel()
    data.hl_level = cardData.soulLink_lv

    self.clickShenshi = click
    self.clickParamsShensh = {...}

    --ItemCardBaseView.ShowShenshi(self, data.sid, nil, data.start, data.uid )
    self.isLvSelf = require("CardResonanceModel"):GetInstance():CheckCardIsInPos(data.uid)
    ItemCardAllView.Show(self, data.sid, nil, data.start, data.hl_level, data.level, data.uid)
end

function ItemCardShenShiView:ShowCardData(cardData, click, ...)
    self:Show1(cardData, nil, ...)
    self.clickShenshi = click
    self.clickParamsShensh = {...}
    --ItemCardBaseView.ShowCardData(self,cardData,click,...)
end
function ItemCardShenShiView:SetSelect(isbool)
    isbool = isbool == true
    if self.isSelect == isbool then
        return
    end
    _G.GameUtil.SetActiveByCondition(self.selectPanel, isbool)
    self.isSelect = isbool
end
return ItemCardShenShiView
