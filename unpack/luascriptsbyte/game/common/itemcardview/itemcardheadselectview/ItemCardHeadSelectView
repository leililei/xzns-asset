---@type ItemCardBaseView
local base = require("ItemCardAllView2")
---@class ItemCardHeadSelectView : ItemCardAllView2	中文描述
local ItemCardHeadSelectView = _G.BaseClass("ItemCardHeadSelectView", base)


---类的构造函数
function ItemCardHeadSelectView:__init()
    self.isSelect = false
end

function ItemCardHeadSelectView:ShowCardData(CardData, click, showSoulTalent, ...)
    local skinIs = false
    if CardData.type ~= _G.CardType.Timer and CardData.uid ~= CardData.sid then
        _, skinIs = require "CardCommentManager":GetInstance():CardWearSkin(CardData.sid)
        if skinIs ~= 0 then
            CardData.skinIs = skinIs
        end
    end
    base.ShowCardData(self, CardData, click, skinIs, showSoulTalent, ...)
    self:ShowOrHidePropTag(CardData.type == _G.CardType.Prop)
end

---选中黄色的框
function ItemCardHeadSelectView:SetSelect(isSelect)
    if isSelect then
        self.go_table.aorimage_select:SetActiveE(1)
    else
        self.go_table.aorimage_select:SetActiveE(0)
    end
    self.isSelect = isSelect
end

---选中对勾
function ItemCardHeadSelectView:SetSelectGou(isSelect)
    if isSelect then
        self.go_table.aorimage_gou:SetActiveE(1)
    else
        self.go_table.aorimage_gou:SetActiveE(0)
    end
    self:ShowMask(isSelect)
    self.isSelect = isSelect
end

---显示/隐藏等级
function ItemCardHeadSelectView:ShowOrHideLevel(isShow)
    if self.go_table.obj_lvNode then
        self.go_table.obj_lvNode:SetActiveE(isShow and 1 or 0)
    end
end

--- 显示/隐藏命令大厅标志
function ItemCardHeadSelectView:ShowOrHideGong(isShow)
    --屏蔽不显示
    if self.go_table.obj_gong then
        self.go_table.obj_gong:SetActiveE(isShow and 1 or 0)
    end
end

function ItemCardHeadSelectView:ShowOrHidePropTag(isShow)
    if self.go_table.aorimage_prop then
        UIUtils.SetUIModel(self.go_table.aorimage_prop,nil,self.go_table.aorimage_prop2,nil,nil,isShow)
    end
end
function ItemCardHeadSelectView:ShowName(isShow, count)
    if self.go_table.aortext_name and count then
        self.go_table.aortext_name.text=count
        self.go_table.aortext_name:SetActiveE(isShow and 1 or 0)
    end
end

---类的析构函数
function ItemCardHeadSelectView:Dispose()
end

return ItemCardHeadSelectView
