local ItemCardAllView = require "ItemCardAllView"

---@class ItemCardAllView2:ItemCardAllView	中文描述
local ItemCardAllView2 = _G.BaseClass("ItemCardAllView2", ItemCardAllView)

function ItemCardAllView2:Show(sid, click, skin, star, soulLink_lv, lv, uid, isHave, soulIsActive, talents, ...)
    ItemCardAllView.Show(self, sid, click, star, soulLink_lv, lv, uid, skin, soulIsActive, talents, ...)
    self:isHave(isHave)
end
---@param CardData CardData
function ItemCardAllView2:ShowCardData(CardData, click, skin, showSoulTalent, ...)
    self:Show(
        CardData.sid,
        click,
        skin,
        CardData.star,
        showSoulTalent and CardData.soulLink_lv or nil,
        CardData:GetLevel(),
        CardData.uid,
        CardData.isHave,
        CardData.soulLink_IsActivate,
        CardData.open_inborn,
        ...
    )
end
function ItemCardAllView2:isHave(isHave)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, not isHave)
end
return ItemCardAllView2
