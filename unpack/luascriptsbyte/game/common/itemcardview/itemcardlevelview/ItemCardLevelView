local ItemCardBaseView = require "ItemCardBaseView"

---@class ItemCardLevelView	中文描述
local ItemCardLevelView = _G.BaseClass("ItemCardLevelView", ItemCardBaseView)

local levelIconName = "ui_ty_dengjifont_"

---类的构造函数
function ItemCardLevelView:__init(obj)
    self.isLvSelf = true
    self.FontImage_lv = {self.go_table.aorimage_level1}
    self.pinjieDic = {
        [1] = "ui_ty_kapai_pinjie1",
        [2] = "ui_ty_kapai_pinjie2",
        [3] = "ui_ty_kapai_pinjie3",
        [4] = "ui_ty_kapai_pinjie4"
    }
end

---类的析构函数
function ItemCardLevelView:Dispose()
    self.FontImage_lv = nil
end

function ItemCardLevelView:Show(sid, click, star, lv, uid, soulLink_lv, skin, soulIsActive, talents)
    ItemCardBaseView.Show(self, sid, click, star, skin, soulIsActive, soulLink_lv, talents, uid)
    self.isLvSelf = require("CardResonanceModel"):GetInstance():CheckCardIsInPos(uid)
    self:ShowLevel(lv)
end

---@param isLvSelf boolean true 自身等级
function ItemCardLevelView:ShowLevel(lv, isLvSelf)
    if isLvSelf ~= nil then
        self.isLvSelf = isLvSelf
    end
    lv = lv or 1
    _G.UIUtils.SetImageFont(
        self.FontImage_lv,
        "v" .. tostring(lv),
        self.isLvSelf and _G.AorImageFont.Cardlevel or _G.AorImageFont.CardlevelLan
    )
end

function ItemCardLevelView:ShowInEmbattle(inEmbattle)
    self.go_table.aorimage_inEmbattle:SetActiveE(inEmbattle and 1 or 0)
end

return ItemCardLevelView
