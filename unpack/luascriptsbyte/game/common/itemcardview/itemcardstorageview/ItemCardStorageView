---@class ItemCardStorageView : ItemCardAllView	中文描述
---@field super ItemCardAllView
local ItemCardStorageView = _G.BaseClass("ItemCardStorageView", require("ItemCardAllView"))

function ItemCardStorageView:__init()
    self.super.__init(self)
end
function ItemCardStorageView:Show(sid, click, star, soulLink_lv, lv, uid, skin, soulIsActive, talents, ...)
    if click ~= nil then
        _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    end
    if skin == nil then
        skin = false
    end
    self.super.Show(self, sid, click, star, soulLink_lv, lv, uid, skin, soulIsActive, talents, ...)

    self.isLvSelf = require("CardResonanceModel"):GetInstance():CheckCardIsInPos(uid)
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.sid]

    local name = ""
    if cfg ~= nil then
        name = LangUtil.GetLangPackValue(cfg.Name)
    end
    self.go_table.aortext_Name.text = name
    self:ShowFrame(false)
end
function ItemCardStorageView:ShowFrame(bl)
    self.go_table.aorimage_Farme:SetActiveE(bl and 1 or 0)
end
function ItemCardStorageView:ShowNew(bl)
    self.go_table.aorimage_New:SetActiveE(bl and 1 or 0)
end
function ItemCardStorageView:ShowName(bl)
    self.go_table.aortext_Name:SetActiveE(bl and 1 or 0)
end

function ItemCardStorageView:ShowSelected(bl)
    self.go_table.obj_Selected:SetActiveE(bl and 1 or 0)
end

function ItemCardStorageView:ShowLv(bl, content)
    self.go_table.obj_lvNode:SetActiveE(bl and 1 or 0)

    if bl and content ~= nil then
        content = content or 1

        _G.UIUtils.SetImageFont(
            self.FontImage_lv,
            "v" .. tostring(content),
            self.isLvSelf and _G.AorImageFont.Cardlevel or _G.AorImageFont.CardlevelLan
        )
    end
end

function ItemCardStorageView:ShowProp(bl)
    self.go_table.aorimage_Elements:SetActiveE(bl and 1 or 0)
end

return ItemCardStorageView
