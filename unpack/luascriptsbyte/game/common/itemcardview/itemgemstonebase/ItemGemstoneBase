local GemstoneItemIconName = {
    "TY_Background_kuang_bai",
    "TY_Background_kuang_lv",
    "TY_Background_kuang_lani",
    "TY_Background_kuang_zi",
    "TY_Background_kuang_cheng",
    "TY_Background_kuang_cheng2",
    "TY_Background_kuang_hong",
    "TY_Background_kuang_hong2",
    "TY_Background_kuang_jin",
    "TY_Background_kuang_jin2",
    "TY_Background_kuang_cai",
    "TY_Background_kuang_cai2",
}

---@class ItemGemstoneBase	中文描述
local ItemGemstoneBase = _G.BaseClass("ItemGemstoneBase")
---类的构造函数
function ItemGemstoneBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function ItemGemstoneBase:Show(sid, click, star, lv, ...)
    self.sid = sid
    self.click = click
    self.clickParams = {...}
    self.star = star or 0
    self.lv = lv or 0
    self:ShowInfo()
end

------@param Equipmentdata EquipmentItem
function ItemGemstoneBase:ShowData(data, click, ...)
    self.grade = data.Grade or 1
    self.uid = data.uid or 0
    self.data = data or nil
    self:Show(data.sid, click, data.star, data.level, ...)
end

function ItemGemstoneBase:ShowInfo()
    if self.sid == 0 then
        return
    end
    local genCfg = _G.ConfigManager.gem_cfg[self.sid]
    self.go_table.aorimage_ColorBG.SpriteName = GemstoneItemIconName[genCfg.grade]

    self.go_table.aorrawimage_Icon.Alpha = 0
    self.go_table.aorrawimage_Icon:LoadImage(genCfg.icon)
    self.go_table.aortext_lv.text = _G.GetLangPackValue(90033800028, self.lv)

    for i = 1, 5 do
        local obj = self.go_table.obj_star:GetChildE(i - 1)
        obj:SetActiveE(self.star >= i and 1 or 0)
    end
    if self.data then
        local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,self.data.cardUid)
        self:ShowCardBound(cardData.sid)
    elseif self.uid and self.uid ~= 0 then
        local cardUid = require("GemstoneModel"):GetInstance():GetGemDataByUid(self.uid).cardUid
        local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,cardUid)
        self:ShowCardBound(cardData.sid)
    else
        self:ShowCardBound(0)
    end
end

--- 卡牌穿戴
function ItemGemstoneBase:ShowCardBound(sid)
    if not sid or sid == 0 then
        self.go_table.aorimage_BoundBg:SetActiveE(0)
        return
    end
    self.go_table.aorimage_BoundBg:SetActiveE(1)
    local cfg = _G.ConfigManager.card_cfg[sid]
    if not cfg then
        return
    end
    local icon = cfg.Icon

    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    self.go_table.aorimage_BoundIcon.SpriteName = icon
    local bg = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(cfg.Star, cfg.Order)
    self.go_table.aorimage_BoundBg.SpriteName = bg
end

function ItemGemstoneBase:ShowLevel(isShow)
    self.go_table.aortext_lv:SetActiveE(isShow and 1 or 0)
end

function ItemGemstoneBase:OnClickBtn(go)
    if go == self.go_table.aorbtn_Click then
        if self.click then
            self.click(_G.table.unpack(self.clickParams))
        else
            if self.data then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GemstoneTipView.Name, {data = self.data})
            end
        end
    end
end

function ItemGemstoneBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemGemstoneBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemGemstoneBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua:ShowData(data, OnBtnFun, itemLua)
            end
            if callback then
                callback(itemLua)
            end
        end
    )
end

function ItemGemstoneBase:SetPri()
end

function ItemGemstoneBase:ShowNumText()
end

return ItemGemstoneBase