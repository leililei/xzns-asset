---@class ItemCardFactory : Singleton	中文描述
local ItemCardFactory = _G.BaseClass("ItemCardFactory", _G.Singleton)
_G.ItemCardFactory = ItemCardFactory

---@class ItemCardFactory_itemCardType
---@field baseItem number 基础头像
---@field baseBodyItem  number 基础半身像
---@field levelItem  number 头像_等级
---@field BodyItem_select  number 可选中效果半身像
---@field ShenshiItem number 神石头像(类型，星级，等级，魂链等级)
---@field CardAllItem number 头像（等级 魂阁等级）
---@field CardLevelHpItem number 头像-带血条,等级
---@field ItemCardStorageView number 仓库通用创建卡牌头像 ItemCardStorageView:CardAllItem
---@field ItemCardProfessionView number 带职业的卡牌头像（神器穿戴界面） ItemCardProfessionView:CardAllItem
---@field HeadItem_Select number 可选中的人物头像
_G.ItemCardFactory.itemCardType = {
    baseItem = 1,
    baseBodyItem = 2,
    levelItem = 3,
    BodyItem_select = 4,
    ShenshiItem = 5,
    CardAllItem = 6,
    CardLevelHpItem = 7,
    ItemCardStorageView = 8,
    CardAllItem2 = 9,
    ItemCardProfessionView = 10,
    HeadItem_Select = 11
}

local ItemCardPath = {
    "UIH5/Common/ItemView/ItemCardBaseView",
    "UIH5/Common/ItemView/ItemCardBodyBaseView",
    "UIH5/Common/ItemView/ItemCardLevelView",
    "UIH5/Common/ItemView/ItemCardBodySelectView",
    "UIH5/Common/ItemView/ItemCardShenShiView", --工程里没有
    "UIH5/Common/ItemView/ItemCardAllView",
    "UIH5/Common/ItemView/ItemCardLevelHpView",
    "UIH5/Common/ItemView/ItemCardStorageView",
    "UIH5/Common/ItemView/ItemCardAllView2",
    "UIH5/Common/ItemView/ItemCardProfessionView",
    "UIH5/Common/ItemView/ItemCardHeadSelectView"
}

local ItemCardClass, ItemCardClassNames = {}, {
    "ItemCardBaseView",
    "ItemCardBodyBaseView",
    "ItemCardLevelView",
    "ItemCardBodySelectView",
    "ItemCardShenShiView",
    "ItemCardAllView",
    "ItemCardLevelHpView",
    "ItemCardStorageView",
    "ItemCardAllView2",
    "ItemCardProfessionView",
    "ItemCardHeadSelectView"
}
setmetatable(ItemCardClass, {
    __index = function(table, key)
        local v = rawget(table, key)
        if not v then
            v = require(ItemCardClassNames[key])
            rawset(table, key, v)
        end
        return v
    end
})


local ItemCardPrefabName = {
    "ItemCardBaseView",
    "ItemCardBodyBaseView",
    "ItemCardLevelView",
    "ItemCardBodySelectView",
    "ItemCardShenShiView",
    "ItemCardAllView",
    "ItemCardLevelHpView",
    "ItemCardStorageView",
    "ItemCardAllView2",
    "ItemCardProfessionView",
    "ItemCardHeadSelectView"
}

---@return ItemCardFactory ItemCardFactory
function ItemCardFactory:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function ItemCardFactory:__init()
    self.itemCardCallDic = {}
    self.cardTypeParentTab = {}
    if _G.AppSetting.IsXzns then
        ItemCardPath[_G.ItemCardFactory.itemCardType.baseBodyItem] = "UIH5_xzns/Common/ItemView/ItemCardBodyBaseView"
        ItemCardPath[_G.ItemCardFactory.itemCardType.BodyItem_select] = "UIH5_xzns/Common/ItemView/ItemCardBodySelectView"
    end
end

---销毁对象时,析构函数
function ItemCardFactory:Dispose()
    self.itemCardCallDic = nil
    self.cardTypeParentTab = nil
end

local function CommonCall()
end

function ItemCardFactory:OnItemCardCall(trans, ref, itemCardType)
    local instance = _G.IsNil(trans:GetParent()) and 0 or trans:GetParent():GetInstanceIDE()
    local viewName = trans:GetName()
    local typeTab = self.itemCardCallDic[viewName]
    if not typeTab then
        _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
        return
    end
    local instanceTab = typeTab[instance]
    --有两种情况等于0：1.本身没有传父节点 2.父节点在返回时被删除了
    if instance == 0 then
        if instanceTab then --优先满足本身没有传父节点的返回
            local view = ItemCardClass[itemCardType].New(trans)
            instanceTab[1](view)
            _G.table.remove(instanceTab, 1)
            if #instanceTab == 0 then
                typeTab[instance] = nil
            end
        else --父节点被销毁了，有些地方也需要回调 回调传nil
            _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
            local tab = self.cardTypeParentTab[itemCardType]
            if tab then
                for i = 1, #tab do
                    if _G.IsNil(tab[i][1]) then
                        instanceTab = typeTab[tab[i][2]]
                        if instanceTab then
                            instanceTab[1]()
                            _G.table.remove(instanceTab, 1)
                            if #instanceTab == 0 then
                                typeTab[instance] = nil
                            end
                            _G.table.remove(tab, 1)
                            if #tab == 0 then
                                self.cardTypeParentTab[itemCardType] = nil
                            end
                            break
                        end
                    end
                end
            end
        end
    else
        if not instanceTab then
            _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
        else
            local view = ItemCardClass[itemCardType].New(trans)
            local item = _G.table.remove(instanceTab, 1)
            item(view)
            if #instanceTab == 0 then
                typeTab[instance] = nil
            end
            local tab = self.cardTypeParentTab[itemCardType]
            if tab then
                for i = 1, #tab do
                    if tab[i][2] == instance then
                        _G.table.remove(tab, i)
                        break
                    end
                end
                if #tab == 0 then
                    self.cardTypeParentTab[itemCardType] = nil
                end
            end
        end
    end
end

---创建itemcard显示对象
---@param itemCardType _G.ItemCardFactory.itemCardType 显示类型
---@param parent UnityEngine.Transform 父节点
---@param call function 创建回调
function ItemCardFactory:GetItemCard(itemCardType, parent, call)
    if call == nil then
        call = CommonCall
    end
    if itemCardType == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("类型为nil", "ItemCardFactory:GetItemCard")
        end
        call(nil)
        return
    end
    if ItemCardPath[itemCardType] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到预制路径 为防止中断，强制设置为基础类型1 itemCardType = " .. itemCardType, "ItemCardFactory:GetItemCard")
        end
        call(nil)
        return
    end
    if ItemCardClass[itemCardType] == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到类 为防止中断，强制设置为基础类型1 itemCardType = " .. itemCardType, "ItemCardFactory:GetItemCard")
        end
        call(nil)
        return
    end
    local typeTab = self.itemCardCallDic[ItemCardPrefabName[itemCardType]]
    if typeTab == nil then
        typeTab = {}
        self.itemCardCallDic[ItemCardPrefabName[itemCardType]] = typeTab
    end
    local instanceID = _G.IsNil(parent) and 0 or parent:GetInstanceIDE()
    local instanceTab = typeTab[instanceID]
    if instanceTab == nil then
        instanceTab = {}
        typeTab[instanceID] = instanceTab
    end
    if instanceID ~= 0 then
        local tab = self.cardTypeParentTab[itemCardType]
        if not tab then
            tab = {}
            self.cardTypeParentTab[itemCardType] = tab
        end
        tab[#tab + 1] = { parent, instanceID }
    end
    _G.table.insert(instanceTab, call)
    _G.PoolsManager:GetInstance():Spawn(
        ItemCardPath[itemCardType],
        _G.ePoolType.UIItem,
        parent,
        _G.handlerbind(self, self.OnItemCardCall, itemCardType)
    )
end

---回收对象
---@param itemCard ItemCardBaseView ItemCar显示对象
function ItemCardFactory:SetItemCard(itemCard)
    _G.PoolsManager:GetInstance():Despawn(itemCard.gameObject, _G.ePoolType.UIItem)
    itemCard:Dispose()
end
