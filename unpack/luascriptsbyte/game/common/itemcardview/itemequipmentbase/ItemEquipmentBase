function ItemEquipmentBase:SetGou(isGou)
    if self.isGou == isGou then
        return
    end

    if self.gouTran == nil then
        _G.PoolsManager:GetInstance():Spawn(
            itemGouPrefabPath,
            _G.ePoolType.UIItem,
            self.gameObject,
            function(trans)
                if _G.IsNil(self.gameObject) then
                    _G.DestroyObject(trans)
                    return
                end
                self.gouTran = trans
                _G.GameUtil.SetActiveByCondition(self.gouTran, isGou)
            end
        )
    else
        _G.GameUtil.SetActiveByCondition(self.gouTran, isGou)
    end
    self.isGou = isGou
end
--endregion------------------------------------仓库创建 容错--------
function ItemEquipmentBase:ShowEffect(isShow)
    if isShow == nil then
        isShow = true
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)

    self.go_table.NowEffKey = key
    if self.go_table.EffDic == nil then
        self.go_table.EffDic = {}
    end

    if self.go_table.EffDic[key] == nil then
        self.go_table.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.gameObject,
            function(trans)
                -- trans:SetAnchorPosition(0, 0, 0)
                self.go_table.EffDic[key] = trans
                if key ~= self.go_table.NowEffKey or isShow == false then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
            end
        )
    elseif self.go_table.EffDic[key] ~= true then
        self.go_table.EffDic[key]:SetActiveE(isShow and 1 or 0)
    end
end
function ItemEquipmentBase:ShowOrHideEffect(isEffect)
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    if self.go_table.EffDic[key] then
        self.go_table.EffDic[key]:SetActiveE(isEffect)
    end
end
function ItemEquipmentBase:ShowCount()
    local num = self.count or 1
    if num <= 1 then
        ---数量1 不显示
        num = nil
    end
    _G.UIUtils.SetItemNum_EquItemNum(self.go_table, num)
end
---滑动会生成多个对勾的 预制体
function ItemEquipmentBase:SetGouScroll(isGou)
    if self.go_table.obj_gou:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_gou:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_gou:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    _G.PoolsManager:GetInstance():Spawn(
        itemGouPrefabPath,
        _G.ePoolType.UIItem,
        self.go_table.obj_gou,
        function(trans)
            _G.GameUtil.SetActiveByCondition(trans, isGou)
        end
    )
end
---(预制体新增节点,根据物品品质生成特效) 滑动列表会出现不同品质的装备的特效
function ItemEquipmentBase:ShowEffectOrder(isShowEffect)
    self:RemoveOredrEffect()
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.sid)
    -- ZHJH-2048  策划要求不调用 蓝绿特效
    if key == "ef_BaseItemWithCount_lv" or key == "ef_BaseItemWithCount_lan" or key == false then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
        effect,
        self.go_table.obj_uieffect,
        function(trans)
            trans:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end
---清楚品质特效
function ItemEquipmentBase:RemoveOredrEffect()
    if self.go_table.obj_uieffect:GetChildCountE() > 0 then
        for i = 1, self.go_table.obj_uieffect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_uieffect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

function ItemEquipmentBase:ShowGradeEffect()
    if true then --- ZHJH-1699屏蔽
        return
    end
    self:RemoveOredrEffect()
    local effect = gradeEffect[self.grade]
    _G.UIUtils.LoadEffectByCfg(
        effect,
        self.go_table.obj_uieffect,
        function(trans)
            if not trans:GetComponentE(typeof(CS.ParticleClipRect)) then
                trans:AddComponentE(typeof(CS.ParticleClipRect))
            end
        end
    )
end

---装备红点（不走红点树）
function ItemEquipmentBase:RefreshRedPoint(show)
    self.go_table.aorimage_redPoint:SetActiveE(show and 1 or 0)
end

return ItemEquipmentBase
