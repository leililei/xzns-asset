local typeof = _G.typeof
---乾坤仙  [grade]=imageName
local qkx = {
    [8] = "jsxt_icon_t1",
    [9] = "jsxt_icon_t2",
    [10] = "jsxt_icon_t3",
    [11] = "jsxt_icon_t4"
}
local gradeEffect = {
    [5] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_icon,
    [6] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_icon,
    [7] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [8] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [9] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [10] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow,
    [11] = _G.ConfigManager.ui_effect_cfg.ef_BagNewView_rainbow
}
---类的构造函数
function ItemEquipmentBase:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    self.go_table.aorimage_CardBG:SetActiveE(0)
    self.element = 0
    self.count = 1
    self.isGou = false
end

---类的析构函数
function ItemEquipmentBase:Dispose()
    self.isGou = nil
end

function ItemEquipmentBase:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
        else
            require "CommonTipManager":GetInstance():OpenEquipmenTip(self.sid, self.uid, nil, nil, nil, self.data)
        end
    end
end

function ItemEquipmentBase:Show(sid, click, streng, ...)
    self.sid = sid
    self.click = click
    self.clickParams = {...}
    self.streng = streng or 0
    self:ShowInfo()
end

------@param Equipmentdata EquipmentItem
function ItemEquipmentBase:ShowData(Equipmentdata, click, ...)
    self.bound = Equipmentdata.bound or 0
    self.element = Equipmentdata.element
    self.count = Equipmentdata.count or 1
    self.grade = Equipmentdata.Grade or 1
    self.uid = Equipmentdata.uid or 0
    self.data = Equipmentdata or nil
    self:Show(Equipmentdata.sid, click, Equipmentdata.streng, ...)
end

function ItemEquipmentBase:ShowInfo()
    if self.sid == 0 then
        return
    end
    local Equipmentcfg = _G.ConfigManager.equipment_cfg[self.sid]
    self.go_table.aorimage_ColorBG.SpriteName = _G.EquipItemIconName[Equipmentcfg.grade]

    self.go_table.aorrawimage_Icon.Alpha = 0
    require("CardInfoManager").LoadRawImage(self.go_table.aorrawimage_Icon, Equipmentcfg.icon)

    local tqkx = qkx[Equipmentcfg.grade]
    local isqkx = tqkx ~= nil
    if isqkx then
        self.go_table.aorimage_qkx.SpriteName = tqkx

        ---镇魂街ZHJ-34510 【主任务】公测版本主任务ZHJ-36087
        --【客户端】装备-装备突破4阶显示优化(策划表示到神就直接纯前端展示5星，不会再突破上限了)
        if Equipmentcfg.grade >= 11 then
            self.streng = 5
        end
    end
    self.go_table.obj_qkxBg:SetActiveE(isqkx and 1 or 0)

    self.go_table.obj_highStar:SetActiveE(self.streng > 5 and 1 or 0)
    self.go_table.obj_star:SetActiveE(self.streng > 5 and 0 or 1)
    if self.streng <= 5 then
        local xx
        for i = 1, 5 do
            xx = self.go_table[string.format("aorimage_xx (%d)", i)]
            if xx ~= nil then
                xx:SetActiveE(self.streng >= i and 1 or 0)
            else
                if _G.AppSetting.DEBUG then
                    _G.Log("不是最新装备预制体", "<color=red>" .. ">>>" .. "</color>")
                end
            end
        end
    else
        self.go_table.aortext_star.text = self.streng
    end
    self:ShowElement(self.element)
    self:ShowCardBound(self.bound)
    self:ShowGradeEffect()
end
---卡牌绑定显示
function ItemEquipmentBase:ShowCardBound(bound)
    self.bound = bound or 0
    self.go_table.aorimage_BoundBg:SetActiveE(self.bound ~= 0 and 1 or 0)
    if self.bound ~= 0 then
        local cfg = _G.ConfigManager.card_cfg[self.bound]
        if not cfg then
            return
        end
        local icon = cfg.Icon

        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_BoundIcon.SpriteName = icon
        local bg = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(cfg.Star, cfg.Order)
        self.go_table.aorimage_BoundBg.SpriteName = bg
    end
end
function ItemEquipmentBase:ShowElement(element)
    self.element = element or 0
    self.go_table.aorimage_Elements:SetActiveE(self.element ~= 0 and 1 or 0)
    require("CardInfoManager"):GetInstance():SetEquipElementsProfessional(self.go_table.aorimage_Elements, self.element)
end

---外部调用 只更换信息  不更换点击
------@param Equipmentdata EquipmentItem
function ItemEquipmentBase:UpDataInfo(Equipmentdata)
    self.sid = Equipmentdata.sid
    self.element = Equipmentdata.element
    self.count = Equipmentdata.count or 1
    self.streng = Equipmentdata.streng or 0
    self.grade = Equipmentdata.Grade or 1
    self:ShowInfo()
end

