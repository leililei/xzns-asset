local ItemCardBaseView = require "ItemCardBaseView"

---@class ItemCardAllView:ItemCardBaseView	中文描述
local ItemCardAllView = _G.BaseClass("ItemCardAllView", ItemCardBaseView)

---类的构造函数
function ItemCardAllView:__init(obj)
    self.isPri = false
end

---类的析构函数
function ItemCardAllView:Dispose()
    self.isPri = nil
end

function ItemCardAllView:Show(sid, click, star, soulLink_lv, lv, uid, skin, soulIsActive, talents, ...)
    ItemCardBaseView.Show(self, sid, click, star, skin, soulIsActive, soulLink_lv, talents, ...)

    self:ShowLevel(lv)
    if self.go_table.obj_ItemNum then 
        self.go_table.obj_ItemNum:SetActiveE(0)
    end
end
---@param CardData CardData
function ItemCardAllView:ShowCardData(CardData, click, skin, showSoulTalent, ...)
    ItemCardBaseView.ShowCardData(self, CardData, click, skin, showSoulTalent, ...)
    self:ShowLevel(CardData:GetLevel())
    self:ShowCount(CardData.count)
end

function ItemCardAllView:SetPri(isPri)
    if self.isPri == isPri then
        return
    end
    self.go_table.aorimage_pri:SetActiveE(isPri and 1 or 0)
    self.isPri = isPri
end

function ItemCardAllView:ShowLevel(lv, isLvSelf)
    if isLvSelf ~= nil then
        self.isLvSelf = isLvSelf
    end
    lv = lv or 1
    self.go_table.aortext_level.text = _G.GetLangPackValue(90025500012,lv)
    -- self.go_table.aortext_level.color = require("CardInfoManager").GetColorFromRGB(isLvSelf and "FFFFFF" or "4DF6F5")
end
---是否显示 等级
---@param isShow  boolean 等级
function ItemCardAllView:HideOrShowLevel(isShow)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_lvNode, isShow)
end

function ItemCardAllView:SetLevelText(text)
    self.go_table.aortext_level.text = text
end

---是否显示 属性
---@param isShow  boolean 属性
function ItemCardAllView:HideOrShowElements(isShow)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Elements, isShow)
end
---是否显示 星级
---@param isShow  boolean 属性
function ItemCardAllView:HideOrShowStar(isShow)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_starParent, isShow)
end
---是否显示 品质
---@param isShow  boolean 是否显示
function ItemCardAllView:HideOrShowJue(isShow)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_jue, isShow)
end

---是否显示 数量
function ItemCardAllView:ShowCount(count)
    if self.go_table == nil then
        return
    end
    if count>1 then
        if count ~=self.count then
            self.count = count
            _G.UIUtils.SetItemNum(self.go_table, count)
        end
        self.go_table.obj_ItemNum:SetActiveE(1)
    else
        self.go_table.obj_ItemNum:SetActiveE(0)
    end
end

---更改星级显示（用于如奖励item显示非初始星级等的情况）
function ItemCardAllView:UpdateStarBox()
    ItemCardBaseView.SetColorBox(self)
end

return ItemCardAllView
