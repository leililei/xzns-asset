local base = require "ItemCardAllView"

---@class ItemCardProfessionView:ItemCardAllView	中文描述
local ItemCardProfessionView = _G.BaseClass("ItemCardProfessionView", base)

local ProfessionalEnum = _G.ProfessionalIcon

---类的构造函数
function ItemCardProfessionView:__init()
end

---类的析构函数
function ItemCardProfessionView:Dispose()
end

function ItemCardProfessionView:Show(sid, click, star, soulLink_lv, lv, uid, skin, soulIsActive, talents, profession, ...)
    base.Show(self, sid, click, star, skin, soulIsActive, soulLink_lv, talents, ...)
    self.go_table.aorimage_professional.SpriteName = ProfessionalEnum[_G.ConfigManager.card_cfg[sid].Professional]
end

---@param CardData CardData
function ItemCardProfessionView:ShowCardData(CardData, click, skin, showSoulTalent, ...)
    base.ShowCardData(self, CardData, click, skin, showSoulTalent, ...)
    self.go_table.aorimage_professional.SpriteName = ProfessionalEnum[CardData:GetProfessional()]
end

return ItemCardProfessionView
