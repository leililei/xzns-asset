local ItemCardBodyBaseView = require "ItemCardBodyBaseView"

---@class ItemCardBodySelectView	中文描述
local ItemCardBodySelectView = _G.BaseClass("ItemCardBodySelectView", ItemCardBodyBaseView)

---类的构造函数
function ItemCardBodySelectView:__init(obj)
    self.isSelect = false
end

---类的析构函数
function ItemCardBodySelectView:Dispose()
end

function ItemCardBodySelectView:ShowCardData(CardData, click, showSoulTalent, ...)
    local _, skinIs = require "CardCommentManager":GetInstance():CardWearSkin(CardData.sid)
    if skinIs ~= 0 then
        CardData.skinIs = skinIs
    end
    ItemCardBodyBaseView.ShowCardData(self, CardData, click, showSoulTalent, ...)
    self:ShowCount(CardData)
    self:ShowArtifactUp(CardData)
end

---选中红色的框
function ItemCardBodySelectView:SetSelect(isSelect)
    isSelect = isSelect == true
    if self.isSelect == isSelect then
        return
    end
    if isSelect then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_select, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_select, false)
    end
    self.isSelect = isSelect
end

---选中对勾
function ItemCardBodySelectView:SetSelectGou(isSelect)
    isSelect = isSelect == true
    if self.isSelect == isSelect then
        return
    end
    if isSelect then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_gou, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_gou, false)
    end
    self.isSelect = isSelect
end

function ItemCardBodySelectView:ShowCount(CardData)
    self.go_table.aortext_num.text = ""
    if CardData.type == _G.CardType.Prop then
        if CardData:GetCount() > 999 then
            self.go_table.aortext_num.text = _G.GetLangPackValue(90028500030, "999+")
        elseif CardData:GetCount() > 0 then
            self.go_table.aortext_num.text = _G.GetLangPackValue(90028500030, CardData:GetCount())
        end
    end
end

function ItemCardBodySelectView:ShowArtifactUp(CardData)
    local isShow
    local cLv, cStar, cAwaken
    if not _G.TableIsEmpty(CardData.ArtifactBar) then
        cLv, cStar, cAwaken = CardData.ArtifactBar:CanDevelop()
        isShow = cStar
        if _G.AppSetting.IsXzns and CardData.ArtifactBar:IsMaxStar() and not isShow then
            local cfg = _G.ConfigManager.artifact_awaken_cfg[CardData.ArtifactBar.awaken + 101]
            if cfg then
                local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
                local count = cfg.materials_oneself
                for _, v in pairs(datas) do
                    if v.sid == CardData.ArtifactBar.sid and v.star == 0 then
                        count = count - 1
                        if count <= 0 then
                            break
                        end
                    end
                end
                if count == 0 then
                    isShow = true
                end
            end
        end
    end
    if self.go_table.obj_effect:GetChildCountE() == 0 and isShow then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shenbingtisheng,
            self.go_table.obj_effect,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
            end
        )
    end
    self.go_table.obj_effect:SetActiveE(isShow and 1 or 0)
    self.go_table.aortext_effcetName:SetActiveE(isShow and 1 or 0)
    
end

---显示狗粮
function ItemCardBodySelectView:ShowDogFood(isShow)
    self.go_table.aorimage_dogFood:SetActiveE(isShow and 1 or 0)
end

return ItemCardBodySelectView
