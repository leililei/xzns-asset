function ItemCardBaseView:Show(sid, click, star, skin, soulIsActive, soulLinkLv, talents, ...)
    self.sid = sid
    self.click = click
    self.clickParams = { ... }
    self.star = star or _G.ConfigManager.card_cfg[self.sid].Star
    if type(skin) == "number" and skin > 0 then
        self.skinId = skin
    elseif skin then
        local is, skins = require "CardCommentManager":GetInstance():CardWearSkin(sid)
        self.skinId = skins or 0
    else
        self.skinId = 0
    end

    if self.extend ~= nil then
        self.star = self.extend
    end
    self.ShowCfg = require("CardInfoManager").GetCardSkin_ShowCfg(self.skinId, self.sid)
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    local aorimage_type = self.go_table.aorimage_type
    if self.go_table.aorimage_type2 then
        self.go_table.aorimage_type:SetActiveE(0)
        self.go_table.aorimage_type2:SetActiveE(0)
        aorimage_type = uiModel and self.go_table.aorimage_type2 or self.go_table.aorimage_type
    end
    if _G.AppSetting.IsXzns then
        if self.ShowCfg then
            self.go_table.aorimage_professional:SetActiveE(isNormalCard(self.ShowCfg.UnitType) and 1 or 0) --圣兽丶材料卡不显示
            aorimage_type:SetActiveE(isNormalCard(self.ShowCfg.UnitType) and 1 or 0)         --圣兽丶材料卡不显示
            if self.go_table.aorimage_eleBg then
                ---添加容错，防止部分界面解绑，解绑的界面理论上也不会出现材料卡
                self.go_table.aorimage_eleBg:SetActiveE(require("CardInfoManager"):CheckMultiMatch(_G.CardElementType.Common, self.ShowCfg.Elements_new) and 0 or 1) --通用材料卡不显示
            end
        else
            self.go_table.aorimage_professional:SetActiveE(0) --圣兽丶材料卡不显示
            aorimage_type:SetActiveE(0)         --圣兽丶材料卡不显示
            if self.go_table.aorimage_eleBg then
                ---添加容错，防止部分界面解绑，解绑的界面理论上也不会出现材料卡
                self.go_table.aorimage_eleBg:SetActiveE(0) --通用材料卡不显示
            end
        end
    else
        if self.ShowCfg then
            self.go_table.aorimage_professional:SetActiveE(self.ShowCfg.UnitType == _G.HeroType.Prop and 0 or 1) --材料卡不显示
            aorimage_type:SetActiveE(self.ShowCfg.UnitType == _G.HeroType.Prop and 0 or 1) --材料卡不显示
            if self.go_table.aorimage_eleBg then
                ---添加容错，防止部分界面解绑，解绑的界面理论上也不会出现材料卡
                self.go_table.aorimage_eleBg:SetActiveE(require("CardInfoManager"):CheckMultiMatch(_G.CardElementType.Common, self.ShowCfg.Elements_new) and 0 or 1) --通用材料卡不显示
            end
        else
            self.go_table.aorimage_professional:SetActiveE(0) --材料卡不显示
            aorimage_type:SetActiveE(0) --材料卡不显示
            if self.go_table.aorimage_eleBg then
                ---添加容错，防止部分界面解绑，解绑的界面理论上也不会出现材料卡
                self.go_table.aorimage_eleBg:SetActiveE(0) --通用材料卡不显示
            end
        end
    end

    if self.go_table.aorimage_jue then
        if self.ShowCfg then
            self.go_table.aorimage_jue:SetActiveE(isBeastCard(self.ShowCfg.UnitType) and 0 or 1) --圣兽不显示
        else
            self.go_table.aorimage_jue:SetActiveE(0)
        end
    end
    self:ShowCard()
    if soulLinkLv then
        soulLinkLv = (soulIsActive and soulIsActive == 1) and soulLinkLv or -1
        self:SetSoulLinkAndTalent(soulLinkLv, talents)
    end
end

---@param CardData CardData
function ItemCardBaseView:ShowCardData(CardData, click, skin, showSoulTalent, ...)
    if skin then
        self.skinId = CardData.skin or 0
    else
        self.skinId = 0
    end
    self.CardData = CardData
    self.extend = CardData.extend
    self.isSelfLogo = CardData.isSelfLogo
    local soulChainLv, talents, soulIsActive
    if showSoulTalent then
        soulIsActive = CardData.soulLink_IsActivate
        soulChainLv = CardData.soulLink_lv
        talents = CardData.big_born_num
    end
    ItemCardBaseView.Show(
            self,
            self.CardData.sid,
            click,
            self.CardData.star,
            skin,
            soulIsActive,
            soulChainLv,
            talents,
            ...
    )

    self.isLvSelf = require("CardResonanceModel"):GetInstance():CheckCardIsInPos(CardData.uid)
    self:ShowCard_ByCardata()
end

function ItemCardBaseView:ShowCard()
