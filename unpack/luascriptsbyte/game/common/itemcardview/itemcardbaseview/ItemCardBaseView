local ItemCardBaseView = _G.BaseClass("ItemCardBaseView")

---是否为常规卡牌
---@param unitType number 卡牌类型
---@return boolean
local function isNormalCard(unitType)
    return unitType ~= _G.HeroType.Prop and
            unitType ~= _G.HeroType.Beast
end
---是否为圣兽卡
---@param unitType number 卡牌类型
---@return boolean
local function isBeastCard(unitType)
    return unitType == _G.HeroType.Beast
end

---类的构造函数
function ItemCardBaseView:__init(obj)
    self.isLvSelf = true
    self.gameObject = obj
    self.transform = obj
    self.go_table = nil
    --- 使子预制引用生效 (防止 引用此预制的延伸预制 都要手动点击gotable 刷新此新增的 @对象)
    local selfGotable = _G.GetAutoGoTable(obj)
    if selfGotable.trans_Root ~= nil then
        self.go_table = _G.GetAutoGoTable(selfGotable.trans_Root)
        table.merge(self.go_table, selfGotable)
        _G.AddViewBtnClick(selfGotable.trans_Root, _G.handler(self, self.OnClickBtn))
    else
        self.go_table = selfGotable
        if self._class_type.__cname ~= "ItemCardBaseView" then
            if _G.AppSetting.DEBUG then
                _G.LogError("ItemCardBaseView:__init 未设置 $_trans_Root节点 ")
            end
        end

        _G.AddViewBtnClick(obj, _G.handler(self, self.OnClickBtn))
    end
    self.stars = {
        self.go_table.aorimage_huo1,
        self.go_table.aorimage_huo2,
        self.go_table.aorimage_huo3,
        self.go_table.aorimage_huo4,
        self.go_table.aorimage_huo5
    }

    self.FontImage_star = { self.go_table.aorimage_star1 }

    if self.go_table.obj_logo then
        self.go_table.obj_logo:SetActiveE(0)
    end
end

---类的析构函数
function ItemCardBaseView:Dispose()
end

function ItemCardBaseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            if _G.table.isEmptyOrNil(self.clickParams) then
                self.clickParams = nil
            end
            self.click(self.clickParams)
        end
    end
end

