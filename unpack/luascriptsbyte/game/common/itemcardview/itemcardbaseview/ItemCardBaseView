            if _G.AppSetting.DEBUG then
                _G.LogError("logo异常")
            end
        end
    else
        if self.go_table.obj_logo then
            if _G.CardBodyOrderIconName[grade] then
                self.go_table.obj_logo:SetActiveE(1)
                -- self.go_table.obj_logoTxt:SetActiveE(cfg.card_logo == 1 and 1 or 0)
                self.go_table.aorimage_logo.SpriteName = _G.CardBodyOrderIconName[grade]
                self.go_table.aorimage_logo:SetNativeSize()
            else
                self.go_table.obj_logo:SetActiveE(0)
            end
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("logo异常")
            end
        end
    end]]

    self:SetColorBox()
    self:ShowStar()
    self:SetElements(cfg.Elements_new, cfg.Professional, cfg.Order)
    self:ShowQualityFlag(grade, cfg.Elements_new)
    self:LoadSPEffect(grade)
end

function ItemCardBaseView:HideOrShowSpEffect(bol)
    if not _G.table.isEmptyOrNil(self.effectSP) then
        for _, v in pairs(self.effectSP) do
            v:SetActiveE(bol and 1 or 0)
        end
    end
    self.hideSPEffectBol = not bol
end

function ItemCardBaseView:LoadSPEffect(grade)

    if grade == 7 then
        local effectSP2 = "ef_ItemCardBodyBaseViewSP_bg"
        local effectSP3 = "ef_ItemCardBodyBaseViewSPtitle1_bg"
        self.effectSP = self.effectSP or {}
        self.Grade = grade
        if not _G.table.isEmptyOrNil(self.effectSP) then
            for _, v in pairs(self.effectSP) do
                v:SetActiveE(1)
            end
        else
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[effectSP2],
                    self.go_table.aorimage_jue,
                    function(trans)
                        if _G.IsNil(self.go_table) or self.effectSP[effectSP2] then
                            _G.DestroyObject(trans)
                            return
                        end
                        --_G.table.insert(self.effect, trans)
                        self.effectSP[effectSP2] = trans
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        if self.Grade ~= 7 or self.hideSPEffectBol then
                            for _, v in pairs(self.effectSP) do
                                v:SetActiveE(0)
                            end
                        end
                    end
            )
            _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[effectSP3],
                    self.go_table.aorimage_type,
                    function(trans)
                        if _G.IsNil(self.go_table) or self.effectSP[effectSP3] then
                            _G.DestroyObject(trans)
                            return
                        end
                        --_G.table.insert(self.effect, trans)
                        self.effectSP[effectSP3] = trans
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        if self.Grade ~= 7 or self.hideSPEffectBol then
                            for _, v in pairs(self.effectSP) do
                                v:SetActiveE(0)
                            end
                        end
                    end
            )
        end
    else
        if not _G.table.isEmptyOrNil(self.effectSP) then
            for _, v in pairs(self.effectSP) do
                v:SetActiveE(0)
            end
        end
    end
end

function ItemCardBaseView:ShowStar()
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    if not self.ShowCfg or not isBeastCard(self.ShowCfg.UnitType) then
        local order, starCount = CardInfoManager:GetOrderStarCount_1(self.star)
        if order >= 7 and self.go_table.obj_highStar then
            self.go_table.obj_starParent:SetActiveE(0)
            self.go_table.obj_highStar:SetActiveE(1)
            self.go_table.aortext_star.text = starCount
        else
            local SpriteName
            for i = 1, #self.stars do
                SpriteName = CardInfoManager:GetHuoSpriteName(self.star, i, order, starCount)
                self.stars[i].SpriteName = SpriteName
                self.stars[i]:SetActiveE(SpriteName ~= nil and 1 or 0)
            end
            self.go_table.obj_starParent:SetActiveE(1)
            if self.go_table.obj_highStar then
                self.go_table.obj_highStar:SetActiveE(0)
            end
        end
    else
        local star = math.max(0, math.min(self.star, 5))
        local SpriteName = CardInfoManager:GetBeastStarSpriteName(star)
        for i = 1, #self.stars do
            self.stars[i]:SetActiveE(star >= i and 1 or 0)
            if star >= i then
                self.stars[i].SpriteName = SpriteName
            end
        end
        self.go_table.obj_starParent:SetActiveE(1)
        if self.go_table.obj_highStar then
            self.go_table.obj_highStar:SetActiveE(0)
        end
    end

    -- --- 策划说 4,5星挤一点
    -- if starCount >= 4 then
    --     if self.StarLayout == nil then
    --         self.StarLayout =
    --             self.stars[1]:GetParent():GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
    --     end

    --     if self.StarLayout ~= nil then
    --         if starCount == 5 then
    --             self.StarLayout.spacing = -8.5
    --         else
    --             self.StarLayout.spacing = -8.5
    --         end
    --     end
    -- end
    if self.go_table.obj_star2 ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 未更新为新版 半身像 ")
        end
    end
end

function ItemCardBaseView:SetPri(isPri)
    if self.isPri == isPri then
        return
    end
    self.go_table.aorimage_pri:SetActiveE(isPri and 1 or 0)
    self.isPri = isPri
end

function ItemCardBaseView:ShowCard_ByCardata()
    if self.CardData == nil then
        return
    end
    if self.go_table.obj_demo then
        self.go_table.obj_demo:SetActiveE(self.CardData.type == _G.CardType.Timer and 1 or 0)
    end
end

---是否头像是否蒙黑
---@param isShow boolean 是否蒙黑
function ItemCardBaseView:ShowMask(isShow)
    self.go_table.aorimage_mask:SetActiveE(isShow and 1 or 0)
end

function ItemCardBaseView:SetElements(Elements_new, Professional, order)
    if order then
        self.order = order
    else
        order = self.order
    end
    require("CardInfoManager"):GetInstance():SetElementsProfessional(
            self.go_table.aorimage_Elements,
            Elements_new,
            self.go_table.aorimage_professional,
            Professional
    )
    self.go_table.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(order)
end

---品质标识 品质5显示核心，品质6及以上0-核心  1-天灾  2-军团  3-巨龙  4-古神
function ItemCardBaseView:ShowQualityFlag(grade, Elements_new)
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    local aorimage_type = self.go_table.aorimage_type
    if self.go_table.aorimage_type2 then
        self.go_table.aorimage_type:SetActiveE(0)
        self.go_table.aorimage_type2:SetActiveE(0)
        aorimage_type = uiModel and self.go_table.aorimage_type2 or self.go_table.aorimage_type
    end
    aorimage_type:SetActiveE(grade >= 5 and 1 or 0)
    if grade < 5 then
        return
    end
    local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag(grade, self.sid)
    if icon then
        aorimage_type.SpriteName = icon
    end
end

---设置魂链和天赋
---@param soulLinkLv number 魂链等级，如果为-1则未激活
---@param talents number|table 天赋（大天赋数量或者天赋列表）
function ItemCardBaseView:SetSoulLinkAndTalent(soulLinkLv, talents)
    if self.go_table.obj_soulAndTalent == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("ItemCard预制体未挂载魂链和天赋预制体，无法显示")
        end
        return
    end
    self.go_table.obj_soulAndTalent:SetActiveE(1)
    require("CardInfoManager"):GetInstance():SetSoulLinkAndTalent(self.go_table, soulLinkLv, talents)
end

---获取品质框类型
function ItemCardBaseView:SetColorBox()
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local order, starCount = CardInfoManager:GetOrderStarCount(self.star)
    self.go_table.aorimage_ColorBg.SpriteName = CardInfoManager:GetHeadBgSpriteName(nil, order)
end

