    local grade = cfg and cfg.Order
    if self.skinId and self.skinId ~= 0 then
        cfg = require "CardCommentManager":GetInstance():CardData(self.skinId, false)
    end
    if not cfg then
        return
    end
    local icon

    icon = cfg.Icon

    if _G.string.contains(icon, "/") then
        icon = _G.string.split2tbl(icon, "/")
        icon = icon[#icon]
    end
    self.go_table.aorimage_Icon.SpriteName = icon
    self.go_table.aorimage_Icon:SetNativeSize()

    --[[if self.isSelfLogo == false then
        if self.go_table.obj_logo then
            self.go_table.obj_logo:SetActiveE(0)
