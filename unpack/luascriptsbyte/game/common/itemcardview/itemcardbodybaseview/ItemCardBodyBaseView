---@class ItemCardBodyBaseView	中文描述
local ItemCardBodyBaseView = _G.BaseClass("ItemCardBodyBaseView")
---类的构造函数
function ItemCardBodyBaseView:__init(obj)
    self.isLvSelf = true
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.stars = {
        self.go_table.aorimage_huo1,
        self.go_table.aorimage_huo2,
        self.go_table.aorimage_huo3,
        self.go_table.aorimage_huo4,
        self.go_table.aorimage_huo5
    }

    self.effect = {}
    self.effectSP = {}

    self.FontImage_star = {self.go_table.aorimage_star1}
    -- self.FontImage_lv = {self.go_table.aorimage_level1}
    --if _G.AppSetting.IsXzns then
    --    _G.GameUtil.SetUiHeXieMask(self.go_table)
    --end
end

---类的析构函数
function ItemCardBodyBaseView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function ItemCardBodyBaseView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.click then
            self.click(self.clickParams)
        end
    end
end

---@class params_ItemCardBodyBaseView
---@field sid number
---@field star number
---@field lv number
---@field soulLink_lv number
---@field potential number 觉醒等级，为-1时未解锁
---@field lock number _1锁
---@field skinId number 皮肤Id
---@field isDarw boolean 是否显示等级(招募 不显示等级) 默认 是true
---@field Grade number 品质 (显示绝)
---@field type number 卡牌数据类型
---@field endTime number 结束时间
---@param parmas params_ItemCardBodyBaseView
function ItemCardBodyBaseView:Show(parmas, click, ...)
    self.sid = parmas.sid
    self.star = parmas.star or 1
    self.lv = (parmas.lv or parmas.level) or 0
    self.soulLink_lv = parmas.soulLink_lv or 0
    self.potential = parmas.star >= _G.ConfigManager.discrete_cfg[120001][1][1] and parmas.potential or -1
    self.lock = parmas.lock or 0
    self.click = click
    self.clickParams = {...}
    --是否使用玩家自身的皮肤数据
    self.skinIs = parmas.skinIs
    self.newEff = parmas.newEff --如果存在，用这个参数取代配置显示特效
    if self.skinIs == nil or self.skinIs then
        self.skinId = parmas.skin
    else
        -- local vla, skinId = require "CardCommentManager":GetInstance():CardWearSkin(parmas.sid)
        self.skinId = parmas.skin or 0
    end
    -- parmas.skin = skin

    self.Grade = parmas.Grade
    self.type = parmas.type or _G.CardType.Normal
    self.time = (parmas.endTime or 0) - _G.TimeUtil.GetServerUnixTime()
    self.ShowCfg = require("CardInfoManager").GetCardSkin_ShowCfg(self.skinId, self.sid)
    self:ShowCard()
    if parmas.showSoulTalent then
        local soulLinkLv
        if parmas.soulState and parmas.soulState == 1 then
            soulLinkLv = parmas.soulLink_lv
        else
            soulLinkLv = -1
        end
        self:SetSoulLinkAndTalent(soulLinkLv, parmas.talents)
    end
end

---@param CardData CardData   CardData.skinIs:是否使用玩家自身的皮肤数据
function ItemCardBodyBaseView:ShowCardData(CardData, click, showSoulTalent, ...)
    if CardData.skinIs == nil or CardData.skinIs then
        local vla, skin = require "CardCommentManager":GetInstance():CardWearSkin(CardData.sid)

        CardData.skin = skin
    end

    ---@type params_ItemCardBodyBaseView
    local parma = {}
    parma.sid = CardData.sid
    parma.lv = CardData.lv or CardData:GetLevel()
    parma.star = CardData.star
    parma.soulLink_lv = CardData.soulLink_lv or 0
    parma.soulState = CardData.soulLink_IsActivate or 0
    parma.lock = CardData.unlock or 0
    parma.skin = CardData.skin or 0
    parma.Grade = CardData.Grade or 0
    parma.type = CardData.type or _G.CardType.Normal
    parma.endTime = CardData.endTime or 0
    parma.skinIs = CardData.skinIs
    parma.talents = CardData.big_born_num
    parma.potential = CardData:CheckCanPotential() and CardData:GetPotential() or -1
    parma.showSoulTalent = showSoulTalent
    parma.newEff = CardData.newEff --如果存在，用这个参数取代配置显示特效
    self.isLvSelf = require("CardResonanceModel"):GetInstance():CheckCardIsInPos(CardData.uid)
    ItemCardBodyBaseView.Show(self, parma, click, ...)
end

