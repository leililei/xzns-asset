--根据品质显示
function ItemCardBodyBaseView:ShowJue()
    self.go_table.aorimage_jue.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(self.Grade)
end

function ItemCardBodyBaseView:CheckJue(Grade)
    if Grade == nil then
        Grade = self.Grade
    end

    return Grade == 3
end

---显示计时
function ItemCardBodyBaseView:ShowTimer()
    if not self.go_table.obj_demo then
        return
    end
    self.go_table.obj_demo:SetActiveE(self.type == _G.CardType.Timer and 1 or 0)
    if not (self.type == _G.CardType.Timer) then
        return
    end
    self.go_table.aortext_time.text = _G.TimeUtil.TimeToString(self.time, 1)
    if self.time <= 0 then
        self.go_table.aortext_time.text = ""
        return
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

--- 只显示试用图标不显示倒计时
function ItemCardBodyBaseView:ShowTrial(state)
    if not self.go_table.obj_demo then
        return
    end

    self.go_table.obj_demo:SetActiveE(state)
    self.go_table.obj_timeBg:SetActiveE(0)
    self.go_table.aortext_time.gameObject:SetActiveE(0)
end

function ItemCardBodyBaseView:UpdateTime(elapsed)
    if _G.IsNil(self) or _G.IsNil(self.gameObject) then
        if self.timer then
            if self.timer then
                self.timer:Stop()
                self.timer = nil
            end
        end
        return
    end
    self.time = self.time - elapsed
    self.go_table.aortext_time.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.time), 1)
    if self.time <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
    end
end

