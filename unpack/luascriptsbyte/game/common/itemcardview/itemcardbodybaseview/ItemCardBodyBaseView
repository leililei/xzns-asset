function ItemCardBodyBaseView:ShowElementBg()
    self.go_table.aorimage_eleBg.SpriteName = require("CardInfoManager"):GetInstance():GetElementIconFrame(self.star)
end

---品质标识 品质5显示核心，品质6及以上0-核心  1-天灾  2-军团  3-巨龙  4-古神
function ItemCardBodyBaseView:ShowQualityFlag()
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    local aorimage_type = self.go_table.aorimage_type
    if  self.go_table.aorimage_type2 then
        self.go_table.aorimage_type2:SetActiveE(0)
        self.go_table.aorimage_type:SetActiveE(0)
        aorimage_type = uiModel and self.go_table.aorimage_type2 or self.go_table.aorimage_type
    end
    aorimage_type:SetActiveE(self.Grade >= 5 and 1 or 0)
    if self.Grade < 5 then
       return
    end
    local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag(self.Grade, self.sid)
    if icon then
        aorimage_type.SpriteName = icon
    end
end

---设置是否在线
function ItemCardBodyBaseView:SetInEmbattleStatus(uid)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(uid, _G.EmbattleType.AFKOnly)
    self.go_table.aorimage_inEmbattle:SetActiveE(inEmbattle and 1 or 0)
end

return ItemCardBodyBaseView
