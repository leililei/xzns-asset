    local grade = cfg and cfg.Order
    self.Grade = (self.Grade and self.Grade ~= 0) and self.Grade or grade
    if self.skinId and self.skinId ~= 0 then
        cfg = require "CardCommentManager":GetInstance():CardData(self.skinId, false)
    end

    if not cfg then
        return
    end

    if self.go_table.aorrawimage_role then
        self.go_table.aorrawimage_role.Alpha = 0
        require("CardInfoManager").LoadRawImage(
            self.go_table.aorrawimage_role,
            cfg.Photo,
            function(rawimage)
                rawimage:SetNativeSize()
            end
        )
    end
    -- if self.go_table.obj_logo then
    --     if _G.CardBodyOrderIconName[grade] then
    --         self.go_table.obj_logo:SetActiveE(1)
    --         -- self.go_table.obj_logoTxt:SetActiveE(self.ShowCfg.card_logo == 1 and 1 or 0)
    --         self.go_table.aorimage_logo.SpriteName = _G.CardBodyOrderIconName[grade]
    --         self.go_table.aorimage_logo:SetNativeSize()
    --     else
    --         self.go_table.obj_logo:SetActiveE(0)
    --     end
    -- else
    --     if _G.AppSetting.DEBUG then
    --         _G.LogError("logo异常")
    --     end
    -- end
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.Name)
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_desc.text = _G.GetLangPackValue(cfg.card_title)
    end
    -- local color, order = require("CardInfoManager"):GetInstance():GetNameColorByStar(self.star)
    -- self.go_table.aortext_name.color = color
    -- local gradient = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- gradient.enabled = order == 7
    self:SetColorBox()
    self:ShowStar()
    self:SetElements(cfg.Elements_new, cfg.Professional, self.star)
    self:SetPotential(self.potential)
    self:ShowJue()
    self:ShowCardLevel(self.isLvSelf, self.lv)
    self:ShowElementBg()
    self:ShowQualityFlag()
    self:LoadEffect()

    self:ShowTimer()
end

function ItemCardBodyBaseView:LoadEffect()
    local effect = require("CardInfoManager"):GetInstance():GetCardEffect(self.star)
    if self.newEff then
        for i = 1, 2 do
            --如果设置了newEff参数，按该参数名显示特效
            if self.newEff[i] then
                effect = _G.DeepCopy(effect) or {}
                effect[i] = self.newEff[i] or effect[i]
            end
        end
    end
    if _G.AppSetting.IsXzns then--星座按卡牌品质加了两个新特效，走新逻辑
        local cfg = require "CardCommentManager":GetInstance():CardData(self.sid, false)
        local grade = cfg.Order
        local unlock = {}
        if effect == nil then
            effect = {}
        end
        if not _G.table.ContainsValue(effect,"ef_pinjieSP") then
            _G.table.insert(effect, "ef_pinjieSP")
        end
        if not _G.table.ContainsValue(effect,"ef_hexinbiaoqian") then
            _G.table.insert(effect, "ef_hexinbiaoqian")
        end
        unlock["ef_pinjieSP"] = grade >= 5 and true or false
        unlock["ef_hexinbiaoqian"] = grade >= 6 and true or false
        for _, v in pairs(self.effect) do
            v:SetActiveE(0)
        end
        for k, v in pairs(effect) do
            if self.effect[v] then--已加载按显示条件启用特效
                if unlock[v] ~= nil then
                    self.effect[v]:SetActiveE(unlock[v] == true and 1 or 0)
                else
                    self.effect[v]:SetActiveE(1)
                end
            else
                local index = k > 2 and 2 or k
                if unlock[v] == nil or unlock[v] == true then
                    _G.UIUtils.LoadEffectByCfg(
                            _G.ConfigManager.ui_effect_cfg[v],
                            self.go_table["trans_effect" .. index],
                            function(trans)
                                if not self.go_table or self.effect[v] then
                                    _G.DestroyImmediate(trans)
                                    return
                                end
                                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                                self.effect[v] = trans
                            end
                    )
                end
            end
        end
    else
        local effectSP1 = "ef_ItemCardBodyBaseViewSP_kuang"
        local effectSP2 = "ef_ItemCardBodyBaseViewSP_bg"
        local effectSP3 = "ef_ItemCardBodyBaseViewSPtitle1_bg"
        if self.Grade == 7 then 
            if not _G.table.isEmptyOrNil(self.effectSP) then 
                for _, v in pairs(self.effectSP) do
                    v:SetActiveE(1)
                end
            else 
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[effectSP1],
                    self.go_table.aorrawimage_role,
                    function(trans)
                        if _G.IsNil(self.go_table) or self.effectSP[effectSP1]then
                            _G.DestroyObject(trans)
                            return
                        end
                        --_G.table.insert(self.effect, trans)
                        self.effectSP[effectSP1] = trans
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        trans:SetLocalPosition(0, 62)
                        if self.Grade ~= 7 then
                            for _, v in pairs(self.effectSP) do
                                v:SetActiveE(0)
                            end
                        end
                    end
                )
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[effectSP2],
                    self.go_table.aorimage_jue,
                    function(trans)
                        if _G.IsNil(self.go_table) or self.effectSP[effectSP2]then
                            _G.DestroyObject(trans)
                            return
                        end
                        --_G.table.insert(self.effect, trans)
                        self.effectSP[effectSP2] = trans
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        if self.Grade ~= 7 then
                            for _, v in pairs(self.effectSP) do
                                v:SetActiveE(0)
                            end
                        end
                    end
                )
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg[effectSP3],
                    self.go_table.aorimage_type,
                    function(trans)
                        if _G.IsNil(self.go_table) or self.effectSP[effectSP3]then
                            _G.DestroyObject(trans)
                            return
                        end
                        --_G.table.insert(self.effect, trans)
                        self.effectSP[effectSP3] = trans
                        trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        if self.Grade ~= 7 then
                            for _, v in pairs(self.effectSP) do
                                v:SetActiveE(0)
                            end
                        end
                    end
                )
            end
        else 
            if not _G.table.isEmptyOrNil(self.effectSP) then 
                for _, v in pairs(self.effectSP) do
                    v:SetActiveE(0)
                end
            end
        end
        if effect then
            if self.effect then
                if self.effect[effect[1]] or self.effect[effect[2]] then
                    --- 特效已经加载，直接启用使用
                    for i, v in pairs(self.effect) do
                        if self.effect[effect[1]] == v or self.effect[effect[2]] == v then
                            v:SetActiveE(1)
                        else
                            v:SetActiveE(0)
                        end
                    end
                    return
                end
            end
            for i = 1, 2 do
                if effect[i] then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg[effect[i]],
                        self.go_table["trans_effect" .. i],
                        function(trans)
                            if _G.IsNil(self.go_table) or self.effect[effect[i]]then
                                _G.DestroyObject(trans)
                                return
                            end
                            --_G.table.insert(self.effect, trans)
                            self.effect[effect[i]] = trans
                            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                            if self.effect then
                                for _, v in pairs(self.effect) do
                                    if self.effect[effect[1]] == v or self.effect[effect[2]] == v then
                                        v:SetActiveE(1)
                                    else
                                        v:SetActiveE(0)
                                    end
                                end
                            end
                        end
                    )
                end
            end
        else
            if self.effect then
                for _, v in pairs(self.effect) do
                    v:SetActiveE(0)
                end
            end
        end
    end
end

---@param isShow boolean 是否隐藏特效
function ItemCardBodyBaseView:ShowOrHideEffect(isShow)
    if isShow == nil then
        return
    end
    for i = 1, 2 do
        self.go_table["trans_effect" .. i]:SetActiveE(isShow and 1 or 0)
    end
end

function ItemCardBodyBaseView:ShowCardLevel(isSelf, level)
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_level.text = level
    else
        self.go_table.aortext_level.text = "Lv" .. level
    end
    self.go_table.aortext_level.color = require("CardInfoManager").GetColorFromRGB(isSelf and "FFFFFF" or "4DF6F5")
end

function ItemCardBodyBaseView:ShowStar()
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local order, star=CardInfoManager:GetOrderStarCount_1(self.star)
    if order>=7 and self.go_table.obj_highStar then
        self.go_table.obj_starParent:SetActiveE(0)
        self.go_table.obj_highStar:SetActiveE(1)
        self.go_table.aortext_star.text=star
    else
        local SpriteName
        for i = 1, #self.stars do
            SpriteName = CardInfoManager:GetHuoSpriteName(self.star, i)
            self.stars[i].SpriteName = SpriteName
            self.stars[i]:SetActiveE(SpriteName ~= nil and 1 or 0)
        end
        self.go_table.obj_starParent:SetActiveE(1)
        if self.go_table.obj_highStar then
            self.go_table.obj_highStar:SetActiveE(0)
        end
    end
    if self.go_table.obj_star2 ~= nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 未更新为新版 半身像 ")
        end
    end
end

function ItemCardBodyBaseView:SetElements(Elements, Professional, star)
    require("CardInfoManager"):GetInstance():SetElementsProfessional(
        self.go_table.aorimage_Elements,
        Elements,
        self.go_table.aorimage_professional,
        Professional,
        self.go_table.aorimage_professionalIcon,
        star
    )
end

---设置魂链和天赋
function ItemCardBodyBaseView:SetSoulLinkAndTalent(soulLinkLv, talents)
    if self.go_table.obj_soulAndTalent == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("ItemCard预制体未挂载魂链和天赋预制体，无法显示")
        end
        return
    end
    self.go_table.obj_soulAndTalent:SetActiveE(soulLinkLv ~= -1 and 1 or 0)
    if soulLinkLv ~= -1 then
        require("CardInfoManager"):GetInstance():SetSoulLinkAndTalent(self.go_table, soulLinkLv, talents)
    end
end

---设置觉醒等级
function ItemCardBodyBaseView:SetPotential(potential)
    -- 觉醒等级为-1时，未解锁
    if not potential or potential < 0 then
        self.go_table.aorimage_potential:SetActiveE(0)
        return
    end
    local count = require("CardPotentialModel"):GetInstance():GetIndexBySid(potential)
    self.go_table.aorimage_potential:SetActiveE(1)
    if self.go_table.aortext_potential then
        self.go_table.aortext_potential.text = count
    end
end

---获取品质框类型
function ItemCardBodyBaseView:SetColorBox()
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    self.go_table.aorimage_Color.SpriteName = CardInfoManager:GetBodyBgSpriteName(self.star)
    self.go_table.aorimage_ColorBg.SpriteName = CardInfoManager:GetBodyDownBgSpriteName(self.star)
    if _G.AppSetting.IsXzns then
        self.go_table.aorimage_ColorFrame.SpriteName = CardInfoManager:GetBodyDownBgSpriteName(self.star) .. "_frame"
    end
end

---卡牌置灰
function ItemCardBodyBaseView:SetGray(value)
    for k, v in pairs(self.go_table) do
        if
            type(v) ~= "function" and
                (v:GetComponentE(_G.typeof(_G.CS.AorImage)) or v:GetComponentE(_G.typeof(_G.CS.AorRawImage))) and
                v:GetctiveInHierarchy() == 1
         then
            v:SetGray(value)
        end
    end
    for _, v in pairs(self.stars) do
        v:SetGray(value)
    end
end

---隐藏等级
function ItemCardBodyBaseView:HideLevel()
    if self.go_table.obj_lvNode then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lvNode, false)
    end
end

---显示/隐藏等级
function ItemCardBodyBaseView:ShowOrHideLevel(isShow)
    if self.go_table.obj_lvNode then
        self.go_table.obj_lvNode:SetActiveE(isShow and 1 or 0)
    end
end

