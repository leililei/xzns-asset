function EquipViewBase.Create(data, parent, callback, OnBtnFun)
    ---@param itemLua ItemEquipmentBase
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemEquipmentBase,
        parent,
        function(itemLua)
            if itemLua then
                itemLua:ShowData(data, OnBtnFun, itemLua)
            end
            if callback then
                callback(itemLua)
            end
        end
    )
end
