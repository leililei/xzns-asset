local EquipmentSelectView = _G.BaseClass("EquipmentSelectView", _G.UIBaseView)
--_G.EquipmentSelectView = EquipmentSelectView

local CS = _G.CS
local typeof = _G.typeof

local PropItem = "UI/Equipment/$_obj_BaseProp"
local SortType = {
    Grade = 1,
    Lv = 2,
    streng = 3
}

function EquipmentSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    if not self.IsFirstD then
        self.go_table.looplist2_Equipment:InitListView(0, _G.handler(self, self.RefreshEquipList))
        self.IsFirstD = true
    end
    self.IsInitItem = {}
    self.TimerDic = {}
end

---界面的入口函数
function EquipmentSelectView:OnCreate(CardData, list, call)
    -- if not list or not CardData or table.isEmptyOrNil(list) then
    if not CardData then
        self:Close()
        if self.call then
            self.call()
        end
        return
    end
    self.cardData = CardData
    self.list = list
    self.call = call
    self.selectIndex = 1
    self.sortType = SortType.Grade
    self.go_table.aorrawimage_uiName:LoadImage("Images/TXT/zNewCommon0129/ui_ty_font_tihuan")

    self:InitView()
end

