---初始化界面
function EquipmentSelectView:InitView()
    if _G.table.isEmptyOrNil(self.list) then
        self.go_table.aorrawimage_NotItem:SetActiveE(1)
        self.go_table.looplist2_Equipment:SetActiveE(0)
        self.go_table.obj_Info:SetActiveE(0)
    else
        self:ShowEquipList()
        local data = self.list[self.EquipIndexs[self.selectIndex]]
        self.go_table.aorimage_type.SpriteName =
            require("CardInfoManager").Enum.EquipmentType[self.cardData.cfg.EquipmentType]
        self.go_table.aortext_rolename.text = data:GetName()
        ---  不显示阶级ZHJ-7672
        --.. _G.LangUtil.GetLangPackValue(ClassName[data.cfg.level])
        self.go_table.aorimage_Grade.SpriteName = _G.EquipmentGrade[data.Grade]
        -- self.go_table.aortext_TeamLv.text = _G.LangUtil.GetLangPackValue(90000000043) .. data.cfg.limit_level
        self.go_table.aorimage_ColorBG.SpriteName = _G.itemColorDiIconName[data.Grade]
        self.go_table.aorrawimage_Icon:LoadImage(data.Icon)
        self.go_table.aorimage_Color.SpriteName = _G.itemColorIconName[data.Grade]
        self.go_table.aorimage_Class.SpriteName = _G.EquipmentClass[data.cfg.level]

        _G.UIUtils.SetEquipmentStreng(self.go_table, data.streng)

        if data.cardUid ~= 0 then
            --self.go_table.aorimage_CardColor.SpriteName = _G.itemColorIconName[card.Grade]
            self.go_table.aorimage_CardBG:SetActiveE(1)
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.cardUid)
            self.go_table.aorimage_CardBG.SpriteName = _G.itemColorDiIconName[card.Grade]
            self.go_table.aorrawimage_CardIcon:LoadImage(card.Icon)
        else
            self.go_table.aorimage_CardBG:SetActiveE(0)
        end
        self.go_table.aortext_Info.text = _G.LangUtil.GetLangPackValue(data.cfg.describe)
        self.go_table.aortext_Power.text = data:GetPower()

        if _G.table.isEmptyOrNil(self.cardData.EquipBar[data.cfg.parts]) then
            self.go_table.aortext_Done.text = _G.LangUtil.GetLangPackValue(90023400020)
        else
            if data.cardUid == self.cardData.uid then
                self.go_table.aortext_Done.text = _G.LangUtil.GetLangPackValue(90022300013)
            else
                self.go_table.aortext_Done.text = _G.LangUtil.GetLangPackValue(90022300014)
            end
        end

        self:ShowProp(data)
    end
end

---设置属性
function EquipmentSelectView:ShowProp(data)
    local ContentTrans = self.go_table.obj_PropContent
    local ChildCount = ContentTrans:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(ContentTrans:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local aCfg = _G.ConfigManager.type_attribute_cfg

    local showlist = {}

    for i, v in pairs(data.prop.attribute) do
        if v > 0 then
            table.insert(showlist, {key = i, sortid = _G.AttrType[i].sortid})
        end
    end
    SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )

    for _, tb in pairs(showlist) do
        local i = tb.key
        local v = data.prop.attribute[i]
        if v > 0 then
            _G.PoolsManager:GetInstance():Spawn(
                PropItem,
                _G.ePoolType.UIItem,
                ContentTrans,
                function(tran)
                    if tran then
                        local tb = _G.GetAutoGoTable(tran)
                        tb.aorrawimage_icon:LoadImage(_G.AttrType[i].icon)
                        tb.aortext_Name.text = _G.AttrType[i].des

                        local UPProp = data.UPProp.attribute[i]
                        if UPProp and UPProp ~= 0 then
                            v = v + UPProp
                        end
                        if _G.AttrType[i].percentage == 1 then
                            v = v * 100
                            v = Mathf.RoundToInt(v)
                            v = v .. "%"
                        end
                        -- if data.UPProp.attribute[i] and data.UPProp.attribute[i] ~= 0 then
                        --     tb.aortext_Num.text = v .. "<color=#6effc6>+" .. data.UPProp.attribute[i] .. "</color>"
                        -- end

                        tb.aortext_Num.text = v
                    end
                end
            )
        end
    end
end

function EquipmentSelectView:ShowEquipList()
    self.EquipIndexs = {}
    for i, v in pairs(self.list) do
        table.insert(self.EquipIndexs, i)
    end

    if #self.EquipIndexs < 25 then
        for i = 1, 25 - #self.EquipIndexs do
            table.insert(self.EquipIndexs, 0)
        end
    end

    ---@type EquipmentItem
    local DA
    SortList(
        self.EquipIndexs,
        function(a)
            DA = self.list[a]
            if DA ~= nil then
                if self.sortType == SortType.Grade then
                    return DA.Grade, DA.streng, DA.cfg.level, DA.uid
                elseif self.sortType == SortType.Lv then
                    return DA.cfg.level, DA.Grade, DA.streng, DA.uid
                elseif self.sortType == SortType.streng then
                    return DA.streng, DA.Grade, DA.cfg.level, DA.uid
                end
            end
            ---  self.EquipIndexs 有占位空格 放到最后
            return -1, -1, -1, -1
        end
    )
    _G.DelayDo(
        0.01,
        function()
            self.go_table.looplist2_Equipment:SetListItemCount(_G.math.ceil(#self.EquipIndexs / 5))
            self.go_table.looplist2_Equipment:RefreshAllShownItem()

            self.IsInitItem["EquipmentSelectView"] = true
        end
    )
end

function EquipmentSelectView:RefreshEquipList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.list
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index * 5 + 1
    item:SetName(x)
    local tb = {}
    local data = {}

    for i = 1, 5 do
        data = list[self.EquipIndexs[x + i - 1]]
        tb =
            _G.GetAutoGoTable(
            item:FindE(string.format("$_obj_SingleEquip%d", i)),
            _G.handlerbind(self, self.OnClickEquipItem, x + i - 1)
        )
        if data then
            tb.obj_obj:SetActiveE(1)
            tb.aorimage_ColorBG.SpriteName = _G.itemColorDiIconName[data.Grade]
            tb.aortext_num.text = data.count
            tb.aorrawimage_Icon:LoadImage(data.Icon)

            require("CardInfoManager").SetRawImageTimer(
                tb,
                "EquipmentSelectView",
                x + i,
                tb.aorrawimage_Icon,
                data.Icon,
                self.IsInitItem,
                self.TimerDic
            )

            tb.aorimage_Color.SpriteName = _G.itemColorIconName[data.Grade]

            _G.UIUtils.SetEquipmentStreng(tb, data.streng)

            if data.cardUid ~= 0 then
                tb.obj_Card:SetActiveE(1)
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.cardUid)
                tb.aorrawimage_CardIcon:LoadImage(card.Icon)
            else
                tb.obj_Card:SetActiveE(0)
            end
            tb.aorimage_Class.SpriteName = _G.EquipmentClass[data.cfg.level]
            if x + i - 1 == self.selectIndex then
                tb.aorimage_Selected:SetActiveE(1)
            else
                tb.aorimage_Selected:SetActiveE(0)
            end
        else
            tb.aortext_num.text = ""
            tb.obj_obj:SetActiveE(0)
        end
    end

    return item
end

---点击装备对象
---@param data EquipmentItem 装备数据类
function EquipmentSelectView:OnClickEquipItem(go, isOn, index)
    self.selectIndex = index
    self:InitView()
end

function EquipmentSelectView:SetFiltrate(type)
    self.sortType = type
    self:InitView()
end

function EquipmentSelectView:SetEquip()
    local data = self.list[self.EquipIndexs[self.selectIndex]]
    if data.cardUid == self.cardData.uid then
        require("EquipmentModel"):GetInstance():UnfixEquip(
            self.cardData.uid,
            {data.cfg.parts},
            function()
                self:UnfixEquipCall(true)
                self:RefreshEquipRedPoint(data)
            end
        )
    else
        require("EquipmentModel"):GetInstance():DressEquip(
            self.cardData.uid,
            {data},
            function()
                self:DressEquip(true)
                self:RefreshEquipRedPoint(data)
            end
        )
    end
end

