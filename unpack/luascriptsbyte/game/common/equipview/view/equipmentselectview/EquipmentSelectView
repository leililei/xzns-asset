function EquipmentSelectView:UnfixEquipCall(bl)
    _G.AudioManager.PlayAudioByAudioCfgID(2026)
    self:Exit(bl)
end
function EquipmentSelectView:DressEquip(bl)
    _G.AudioManager.PlayAudioByAudioCfgID(2025)
    self:Exit(bl)
end

function EquipmentSelectView:Exit(bl)
    if bl == true then
        require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(self.CardData, true)
    end
    if self.call then
        self.call(bl)
    end
    self:Close()
end

---按钮点击事件在这里派发
function EquipmentSelectView:OnClickBtn(go, isOn)
    if isOn == false then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Exit(false)
    elseif name == "@_aorbtn_Done" then
        self:SetEquip()
    elseif name == "$_toggle_Grade" then
        self:SetFiltrate(SortType.Grade)
    elseif name == "$_toggle_lv" then
        self:SetFiltrate(SortType.Lv)
    elseif name == "$_toggle_Streng" then
        self:SetFiltrate(SortType.streng)
    end
end

function EquipmentSelectView:OnDestroy()
    for key, value in pairs(self.TimerDic) do
        if value ~= nil then
            _G.coroutine.stopwaiting(value)
        end
    end
end

return EquipmentSelectView
