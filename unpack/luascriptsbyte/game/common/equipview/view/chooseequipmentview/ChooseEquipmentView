---界面的入口函数
function ChooseEquipmentView:OnCreate(EquipPart, call)
    self.CardData = require("CardInfoManager"):GetInstance():GetCurCardData()
    self.CardEquipData = self.CardData.EquipBar[EquipPart]
    self.cfg = _G.ConfigManager.equipment_cfg
    self.EquipPart = EquipPart
    self.SelectedEquipUid = 1
    self.IsFirst = true
    self.EquipList = {}
    self.EquipUidList = {}
    self.Affix = {}
    self.BaseProp = {}
    self.AddProp = {}
    self.SortType = SortType.Grade
    self.call = call
    self.CardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self:CreateEquipItems()
end

---创建所有的装备
function ChooseEquipmentView:CreateEquipItems()
    self.EquipList = {}

    local EquipList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    for _, v in pairs(EquipList) do
        if v.cfg.parts == self.EquipPart and v.cfg.professional == self.CardData.cfg.EquipmentType then
            self.EquipList[v.uid] = v
        end
    end
    if table.isEmptyOrNil(self.EquipList) then
        self:Close()
        return
    end

    local isRefresh = false
    if self.EquipUidList ~= nil and #self.EquipUidList * 0.2 == table.count(self.EquipList) * 0.2 then
        isRefresh = true
    end
    self.EquipUidList = {}
    for i, _ in pairs(self.EquipList) do
        table.insert(self.EquipUidList, i)
    end
    if self.SelectedEquipUid > #self.EquipUidList then
        self.SelectedEquipUid = #self.EquipUidList
    end
    if self.SortType == SortType.Grade then
        table.sort(
            self.EquipUidList,
            function(a, b)
                local bl = false
                local ea = self.EquipList[a]
                local eb = self.EquipList[b]
                if ea.cardUid ~= 0 and eb.cardUid == 0 then
                    return true
                elseif ea.cardUid == 0 and eb.cardUid == 0 and ea.cfg.grade > eb.cfg.grade then
                    bl = true
                elseif ea.cardUid == 0 and eb.cardUid == 0 and ea.cfg.grade == eb.cfg.grade then
                    bl = ea:GetLevel() > eb:GetLevel()
                elseif ea.cardUid == 0 and eb.cardUid == 0 and ea.cfg.grade < eb.cfg.grade then
                    bl = false
                elseif ea.cardUid ~= 0 and eb.cardUid ~= 0 and ea.cfg.grade > eb.cfg.grade then
                    bl = true
                elseif ea.cardUid ~= 0 and eb.cardUid ~= 0 and ea.cfg.grade == eb.cfg.grade then
                    bl = ea:GetLevel() > eb:GetLevel()
                elseif ea.cardUid ~= 0 and eb.cardUid ~= 0 and ea.cfg.grade < eb.cfg.grade then
                    bl = false
                end
                return bl
            end
        )
    else
        table.sort(
            self.EquipUidList,
            function(a, b)
                local bl = false
                local ea = self.EquipList[a]
                local eb = self.EquipList[b]
                if ea.cardUid ~= 0 and eb.cardUid == 0 then
                    return true
                elseif ea.cardUid == 0 and eb.cardUid == 0 and ea:GetLevel() > eb:GetLevel() then
                    bl = true
                elseif ea.cardUid == 0 and eb.cardUid == 0 and ea:GetLevel() == eb:GetLevel() then
                    bl = ea.cfg.grade > eb.cfg.grade
                elseif ea.cardUid ~= 0 and eb.cardUid ~= 0 and ea:GetLevel() > eb:GetLevel() then
                    bl = true
                elseif ea.cardUid ~= 0 and eb.cardUid ~= 0 and ea:GetLevel() == eb:GetLevel() then
                    bl = ea.cfg.grade > eb.cfg.grade
                end
                return bl
            end
        )
    end

    local uid = self.EquipUidList[self.SelectedEquipUid]
    if self.EquipList[uid].cardUid == self.CardData.uid then
        self.go_table.aortext_btnName.text = GetLangPackValue(90023400032)
    elseif table.isEmptyOrNil(self.CardData.EquipBar[self.EquipPart]) then
        self.go_table.aortext_btnName.text = GetLangPackValue(90010600301)
    elseif self.CardData.EquipBar[self.EquipPart].uid > 0 then
        self.go_table.aortext_btnName.text = GetLangPackValue(90020400047)
    end

    local CardList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if self.IsFirst then
        self.go_table.looplist2_EquipList:InitListView(0, _G.handlerbind(self, self.RefreshEquipList, CardList))
        self.IsFirst = false
    end
    self.go_table.looplist2_EquipList:SetListItemCount(_G.math.ceil(#self.EquipUidList * 0.2), true)

    self.go_table.looplist2_EquipList:RefreshAllShownItem()

    self:ShowEquipInfo()
end

--当装备被点击
function ChooseEquipmentView:OnEquipClick(go, ison, index)
    self.SelectedEquipUid = index
    self:CreateEquipItems()
end

---刷新单个装备显示
function ChooseEquipmentView:RefreshEquipList(listView2, index, CardList)
    if index < 0 then
        return
    end
    local list = self.EquipList
    local item = listView2:NewListViewItem("EquipBar")
    local x = index * 5 + 1
    item:SetName(x)
    local tb = {}
    for i = 1, 5 do
        tb[i] =
            _G.GetAutoGoTable(
            item:FindE(string.format("$_obj_SingleEquip%d", i)),
            _G.handlerbind(self, self.OnEquipClick, x + i - 1)
        )
    end
    for i = 1, 5 do
        local data = list[self.EquipUidList[x + i - 1]]
        local tb_i = tb[i]
        if data == nil then
            tb_i:SetActiveE(0)
        else
            if x + i - 1 == self.SelectedEquipUid then
                tb_i.aorimage_Selected:SetActiveE(1)
            else
                tb_i.aorimage_Selected:SetActiveE(0)
            end
            tb_i:SetActiveE(1)
            tb_i.aorimage_Grade.SpriteName = _G.itemColorIconName[data.cfg.grade]
            tb_i.aorrawimage_Icon:LoadImage(
                data.cfg.icon,
                function(image)
                    if image == nil then
                        return
                    end
                    image:SetActiveE(1)
                end
            )
            -- tb_i.aortext_Lv.text = data.cfg.limit_level
            if data.streng > 0 then
                tb_i.obj_Streng:SetActiveE(1)
                tb_i.aortext_StrengLv.text = "+" .. data.streng
            else
                tb_i.obj_Streng:SetActiveE(0)
            end
            if data.cardUid > 0 then
                tb_i.obj_Card:SetActiveE(1)
                tb_i.aorrawimage_CardIcon:LoadImage(
                    CardList[data.cardUid].cfg.Icon,
                    function(image)
                        if image == nil then
                            return
                        end
                        image:SetActiveE(1)
                    end
                )
            else
                tb_i.obj_Card:SetActiveE(0)
            end
        end
    end
    return item
end

---更新装备信息界面
function ChooseEquipmentView:ShowEquipInfo()
    local data = self.EquipList[self.EquipUidList[self.SelectedEquipUid]]
    ---@type equipment_cfg_Item
    local cfg = data.cfg
    self.go_table.aorrawimage_EquipIcon:LoadImage(cfg.icon)
    -- self.go_table.aortext_LV.text = cfg.limit_level
    self.go_table.aortext_EquipName.text = data:GetName()
    -- self.ItemInfo.aortext_Des.text =GetLangPackValue(cfg.describe)
    self.go_table.aorimage_EquipColor.SpriteName = _G.itemColorIconName[cfg.grade]
    self.go_table.aorimage_Grade.SpriteName = _G.EquipmentGrade[cfg.grade]
    local power = data:GetPower()
    if power > 1000000 then
        power = power / 10000 .. GetLangPackValue(90023100001)
    end
    self.go_table.aortext_Power.text = power
    -- self.go_table.aortext_type.text =
    --     GetLangPackValue(_G.ConfigManager.type_equipment_cfg[cfg.professional].name) or ""
    -- self.go_table.aortext_type.text = "[" .. self.go_table.aortext_type.text .. "]"
    self.go_table.aorrawimage_TypeIcon:LoadImage(_G.ConfigManager.type_equipment_cfg[data.cfg.professional].icon)

    if data.streng > 0 then
        self.go_table.obj_Streng:SetActiveE(1)
        self.go_table.aortext_StrengLv.text = data.streng
    else
        self.go_table.obj_Streng:SetActiveE(0)
    end
    if data.cardUid == 0 then
        self.go_table.obj_Card:SetActiveE(0)
    else
        self.go_table.obj_Card:SetActiveE(1)
        local CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.cardUid)
        ---@type card_cfg
        local cfg1 = _G.ConfigManager.card_cfg[CardData.sid]
        self.go_table.aorrawimage_CardIcon:LoadImage(
            "Images/zRoles/" .. cfg1.Icon,
            function(image)
                if image ~= nil then
                    image:SetActiveE(1)
                end
            end
        )
    end

    self:SetEquipData(data)
end

function ChooseEquipmentView:SetEquipData(data)
    if not self.ItemInfo then
        self.ItemInfo = _G.GetAutoGoTable(self.go_table.obj_EquipmentInfo)
    end
    if not self.EquipBaseAttr then
        self.EquipBaseAttr = {}
        for i = 1, 5 do
            self.EquipBaseAttr[i] =
                _G.GetAutoGoTable(self.ItemInfo.obj_Info:FindE(string.format("$_obj_SingleField%d", i)))
        end
    end
    if not self.EquipRandomAttr then
        self.EquipRandomAttr = {}
        for i = 1, 3 do
            self.EquipRandomAttr[i] =
                _G.GetAutoGoTable(self.ItemInfo.obj_SuitInfo:FindE(string.format("$_obj_AttrField%d", i)))
        end
    end
    for _, v in pairs(self.EquipBaseAttr) do
        v.gameObject:SetActiveE(0)
    end
    for _, v in pairs(self.EquipRandomAttr) do
        v.gameObject:SetActiveE(0)
    end
    local i, n = 1, 1
    local cfg = _G.ConfigManager.equipment_add_att_cfg
    local TmpAttr = data:GetAllAttr():GetAttrByName()

    local attr = {}
    for i, v in pairs(TmpAttr) do
        if v ~= 0 then
            table.insert(attr, {key = i, value = v})
        end
    end
    table.sort(
        attr,
        function(a, b)
            return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
        end
    )

    local item
    for key, v in pairs(attr) do
        item = self.EquipBaseAttr[i]
        item.gameObject:SetActiveE(1)
        item.aorrawimage_Decorate:LoadImage(_G.AttrType[v.key].icon)
        item.aortext_Name.text = _G.AttrType[v.key].des
        item.aortext_Num.text = v.value
        i = i + 1
    end

    -- for key, v in pairs(_G.AttrType) do
    --     if data.cfg[key] and data.cfg[key] > 0 then
    --         local item = self.EquipBaseAttr[i]
    --         item.gameObject:SetActiveE(1)
    --         item.aorrawimage_Decorate:LoadImage(v.icon)
    --         item.aortext_Name.text = v.des
    --         local attr = data:GetAllAttr()
    --         item.aortext_Num.text = attr:GetValueByName(key)
    --         i = i + 1
    --     end
    -- end
    if data.addition_fixed == 0 and data.addition == 0 then
        self.ItemInfo.obj_SuitInfo:SetActiveE(0)
    else
        self.ItemInfo.obj_SuitInfo:SetActiveE(1)
    end

    if data.addition_fixed ~= 0 then
        for key, v in pairs(data.addition_fixed) do
            if v.v > 0 then
                local item = self.EquipRandomAttr[n]
                item.gameObject:SetActiveE(1)
                if _G.AttrType[cfg[v.k].type_attribute] then
                    item.aorrawimage_Decorate:LoadImage(_G.AttrType[cfg[v.k].type_attribute].icon)
                    item.aortext_Name.text = GetLangPackValue(cfg[v.k].desc)
                    item.aortext_Grade.text = GetLangPackValue(cfg[v.k].name)
                    item.aorimage_Grade.SpriteName = _G.AdditionGrade[data:GetRandomAttrGrade(v.k, v.v)]
                    if _G.AttrType[cfg[v.k].type_attribute].percentage == 1 then
                        item.aortext_Num.text = v.v * 0.01 .. "%"
                    else
                        item.aortext_Num.text = v.v
                    end
                end
                n = n + 1
            end
        end
    end
    if data.addition ~= 0 then
        for key, v in pairs(data.addition) do
            if v.v > 0 then
                local item = self.EquipRandomAttr[n]
                item.gameObject:SetActiveE(1)
                if _G.AttrType[cfg[v.k].type_attribute] then
                    item.aorrawimage_Decorate:LoadImage(_G.AttrType[cfg[v.k].type_attribute].icon)
                    item.aortext_Name.text = GetLangPackValue(cfg[v.k].desc)
                    item.aortext_Grade.text = GetLangPackValue(cfg[v.k].name)
                    item.aorimage_Grade.SpriteName = _G.AdditionGrade[data:GetRandomAttrGrade(v.k, v.v)]
                    if _G.AttrType[cfg[v.k].type_attribute].percentage == 1 then
                        item.aortext_Num.text = v.v * 0.01 .. "%"
                    else
                        item.aortext_Num.text = v.v
                    end
                end
                n = n + 1
            end
        end
    end
end

---操作装备
function ChooseEquipmentView:OnBtnClick()
    if self.EquipList[self.EquipUidList[self.SelectedEquipUid]].cardUid == self.CardData.uid then
        require("EquipmentModel"):GetInstance():UnfixEquip(
            self.CardData.uid,
            {self.EquipPart},
            function()
                if self.call ~= nil then
                    self.call(false)
                end
                self:Close()
            end
        )
    else
        if self.EquipList[self.EquipUidList[self.SelectedEquipUid]].cardUid > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                TipsID.ReplaceEqui,
                nil,
                function()
                    require("EquipmentModel"):GetInstance():DressEquip(
                        self.CardData.uid,
                        {self.EquipList[self.EquipUidList[self.SelectedEquipUid]]},
                        function()
                            if self.call ~= nil then
                                self.call(true)
                            end

                            self:Close()
                        end
                    )
                end
            )
        else
            require("EquipmentModel"):GetInstance():DressEquip(
                self.CardData.uid,
                {self.EquipList[self.EquipUidList[self.SelectedEquipUid]]},
                function()
                    if self.call ~= nil then
                        self.call(true)
                    end
                    self:Close()
                end
            )
        end
    end
end

---设置额外属性显示
function ChooseEquipmentView:SetAddPropData(tran, data, index)
    local Affix_Cfg = _G.ConfigManager.equipment_add_att_cfg
    local tb = _G.GetAutoGoTable(tran)
    table.insert(self.AddProp, {Go = tb.obj_AddProp, Name = tb.aortext_Name, num = tb.aortext_Num})
    local cfg = Affix_Cfg[data.k]
    tb.aortext_Name.text = _G.AttrType[cfg.type_attribute].des
    tb.aorrawimage_icon:LoadImage(
        _G.ConfigManager.type_attribute_cfg[_G.AttrType[Affix_Cfg[data.k].type_attribute].ID].icon
    )
    if _G.AttrType[cfg.type_attribute].proptype == 3 then
        tb.aortext_Num.text = data.v * 0.01 .. "%"
    else
        tb.aortext_Num.text = data.v
    end
end

---改变排序
---@param type enum 类型枚举
function ChooseEquipmentView:ChangeSortType(type)
    self.SortType = type
    if type == SortType.Grade then
        self.go_table.aortext_Sort.text = GetLangPackValue(90020300047)
    else
        self.go_table.aortext_Sort.text = GetLangPackValue(90020300062)
    end
    -- self.go_table.obj_menu:SetActiveE(0)
    self:CreateEquipItems()
end

---按钮点击事件在这里派发
function ChooseEquipmentView:OnClickBtn(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        if self.call ~= nil then
            self.call(false)
        end
        self:Close()
    elseif name == "@_aorbtn_Rrain" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.EquipmentUPView.Name,
            self.EquipList[self.EquipUidList[self.SelectedEquipUid]],
            _G.handler(self, self.CreateEquipItems)
        )
    elseif name == "@_aorbtn_btn" then
        self:OnBtnClick()
    elseif name == "@_aorbtn_Resolve" then
        local EquipList = {}
        for i, v in pairs(self.EquipList) do
            if v.cardUid == 0 then
                EquipList[i] = v
            end
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ResolveView.Name,
            EquipList,
            function(bl, data)
                if not bl then
                    return
                end
                -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                self:CreateEquipItems()
            end
        )
    elseif name == "@_aorbtn_Screen" then
        self.go_table.obj_menu:SetActiveE(not self.go_table.obj_menu:GetActiveSelf() == 1)
    elseif name == "@_aorbtn_BG" then
        self.go_table.obj_menu:SetActiveE(0)
    elseif name == "@_toggle_color" then
        self:ChangeSortType(SortType.Grade)
    elseif name == "@_toggle_level" then
        self:ChangeSortType(SortType.Level)
    end
end

return ChooseEquipmentView
