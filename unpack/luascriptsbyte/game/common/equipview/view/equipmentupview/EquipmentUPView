---点击洗练属性
function EquipmentUPView:OnClickResetPropBtn()
    require("EquipmentModel"):GetInstance():EquipmentReset(
        self.EquipData,
        self.SelectedResetProp[1],
        self.SelectedResetProp[2],
        function(bl, sid)
            self:ShowChooseView(bl, sid)
        end
    )
end

---显示装备词缀洗练后结果
function EquipmentUPView:ShowChooseView(bl, sid)
    if not bl then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, sid)
        return
    end
    self.ChooseView.aorrawimage_name:LoadImage(
        _G.LangUtil.GetLangPackValue(90020400001),
        function(image)
            if image ~= nil then
                image:SetNativeSize()
            end
        end
    )
    self.ChooseView:SetActiveE(1)
    local cfg = _G.ConfigManager.equipment_add_att_cfg
    if cfg ~= nil then
        local coeddicient = 1
        local str = ""
        local addition = self.EquipData:GetAddition(self.SelectedResetProp[1], self.SelectedResetProp[2])

        if _G.AttrType[cfg[addition.k].type_attribute] and _G.AttrType[cfg[addition.k].type_attribute].percentage == 1 then
            coeddicient = 0.01
            str = "%"
        end

        self.ChooseView.aortext_AfterAttr.text = _G.LangUtil.GetLangPackValue(cfg[addition.k].name) .. ":"
        self.ChooseView.aortext_BeforeAttr.text = _G.LangUtil.GetLangPackValue(cfg[self.EquipData.a_sid].name) .. ":"
        self.ChooseView.aortext_AfterAttrNum.text =
            _G.LangUtil.GetLangPackValue(cfg[addition.k].desc) .. addition.v * coeddicient .. str
        self.ChooseView.aortext_BeforeAttrNum.text =
            _G.LangUtil.GetLangPackValue(cfg[self.EquipData.a_sid].desc) .. self.EquipData.a_num * coeddicient .. str
        self.ChooseView.aorimage_AfterGrade.SpriteName =
            _G.AdditionGrade[require("EquipmentModel"):GetInstance():CalcAdditionGrade(addition.k, addition.v)]
        self.ChooseView.aorimage_BeforeGrade.SpriteName =
            _G.AdditionGrade[
            require("EquipmentModel"):GetInstance():CalcAdditionGrade(self.EquipData.a_sid, self.EquipData.a_num)
        ]
    end
end

---按钮点击事件在这里派发
function EquipmentUPView:OnClickBtn(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        if self.call then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_UP" then
        self:ShowUPView()
    elseif name == "@_aorbtn_Reset" then
        if self.EquipData.addition == 0 and self.EquipData.addition_fixed == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(NotResetID)
            return
        end
        self:ShowResetView()
    elseif name == "@_aorbtn_CloseResetPropInfo" then
        self.go_table.obj_ResetPropInfoView:SetActiveE(0)
    elseif name == "@_aorbtn_UPBtn" then
        if self.EquipData.streng == self.EquipData.cfg.strengthen_level then
            return
        end
        self:OnClickUPEquipBtn()
    elseif name == "@_aorbtn_ResetBtn" then
        self:OnClickResetPropBtn()
    end
end

return EquipmentUPView
