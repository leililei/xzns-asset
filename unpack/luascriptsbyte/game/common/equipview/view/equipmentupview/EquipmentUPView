require "EquipViewBase"
require "MaterialBase"
---@class EquipmentUPView : UIBaseView	中文描述
---@field public go_table EquipmentUPView_GoTable GoTable
local EquipmentUPView = _G.BaseClass("EquipmentUPView", _G.UIBaseView)
--_G.EquipmentUPView = EquipmentUPView

local CS = _G.CS
local typeof = _G.typeof

local PrefabsPath = {
    Star = "UI/Equipment/Star",
    UPProp = "UI/Equipment/$_obj_UPProp",
    ResetProp = "UI/Equipment/$_obj_ResetProp",
    ResetPropInfo = "UI/Equipment/$_obj_ResetPropInfo"
}

local NotResetID = 120103

function EquipmentUPView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EquipmentUPView:OnCreate(EquipData, call)
    self.call = nil
    if _G.type(call) == "function" then
        --(用于原界面刷新装备属性)
        self.call = call
    end
    self.UpMaterial = {}
    self.ResetMaterial = {}
    self.EquipData = EquipData
    self.UPProp = {}
    self.ResetProp = {}
    self.ResetPropInfo = {}
    if EquipData.reset_type == 0 then
        self.ResetPropUid = {0, 0}
    elseif EquipData.reset_type == _G.AdditionType.Fixed then
        self.ResetPropUid = {_G.AdditionType.Fixed, EquipData.index}
    elseif EquipData.reset_type == _G.AdditionType.Random then
        self.ResetPropUid = {_G.AdditionType.Random, EquipData.index}
    end
    self.SelectedResetProp = {self.ResetPropUid[1], self.ResetPropUid[2]}
    self:CreatePrefabs()
    --名字
    self.go_table.aortext_EquipName.text = _G.LangUtil.GetLangPackValue(self.EquipData.cfg.name)
    self.power = self.go_table.obj_ResetView:FindE("Power"):GetComponentE(typeof(CS.UnityEngine.UI.Text))
    self.ChooseView = _G.GetAutoGoTable(self.go_table.obj_ChooseAddition, _G.handler(self, self.OnClickChooseView))
    self:ShowUPView()
end
---显示词缀洗练结果界面
function EquipmentUPView:OnClickChooseView(go)
    local name = go:GetName()
    if name == "@_aorbtn_Close" or name == "@_aorbtn_BG1" or name == "@_aorbtn_Cencel" then
        require("EquipmentModel"):GetInstance():EquipmentChoose(
            self.EquipData,
            2,
            function()
                self.ChooseView:SetActiveE(0)
                self:ShowResetView()
            end
        )
    elseif name == "@_aorbtn_Done" then
        require("EquipmentModel"):GetInstance():EquipmentChoose(
            self.EquipData,
            1,
            function()
                self.ChooseView:SetActiveE(0)
                self:ShowResetView()
            end
        )
    end
end

---创建预制体
function EquipmentUPView:CreatePrefabs()
    if self.EquipData.addition_fixed ~= 0 then
        for i = 1, #self.EquipData.addition_fixed do
            _G.PoolsManager:GetInstance():Spawn(
                PrefabsPath.ResetProp,
                _G.ePoolType.UIItem,
                self.go_table.obj_ResetProp,
                _G.handlerbind(self, self.SaveResetProp, self.EquipData.addition_fixed[i], _G.AdditionType.Fixed, i)
            )
        end
    end
    if self.EquipData.addition ~= 0 then
        for i = 1, #self.EquipData.addition do
            _G.PoolsManager:GetInstance():Spawn(
                PrefabsPath.ResetProp,
                _G.ePoolType.UIItem,
                self.go_table.obj_ResetProp,
                _G.handlerbind(self, self.SaveResetProp, self.EquipData.addition[i], _G.AdditionType.Random, i)
            )
        end
    end

    _G.EquipViewBase.Create(
        self.EquipData,
        self.go_table.obj_EquipItem,
        function(item)
            self.EquipItem = item
            item:ShowStreng(false)
            item:ShowCardIcon(0)
        end
    )
end

---保存词缀随机属性
function EquipmentUPView:SaveResetPropInfo(tran, resRef, sid, AttSid)
    local tb = _G.GetAutoGoTable(tran)
    tb.AttSid = sid
    table.insert(self.ResetPropInfo, tb)
    self:SetResetPropInfo(tb, sid, AttSid)
end

---设置词缀随机属性
function EquipmentUPView:SetResetPropInfo(tb, sid, AttSid)
    if tb == nil then
        return
    end
    local cfg = _G.ConfigManager.equipment_add_att_cfg
    if sid ~= AttSid then
        tb.aortext_name.text = "<color=#676767>" .. _G.LangUtil.GetLangPackValue(cfg[sid].name) .. ":" .. "</color>"
        tb.aortext_des.text = "<color=#676767>" .. _G.LangUtil.GetLangPackValue(cfg[sid].desc) .. "</color>"
    else
        tb.aortext_name.text = "<color=#259685>" .. _G.LangUtil.GetLangPackValue(cfg[sid].name) .. ":" .. "</color>"
        tb.aortext_des.text = "<color=#259685>" .. _G.LangUtil.GetLangPackValue(cfg[sid].desc) .. "</color>"
    end
end

---保存词缀属性
function EquipmentUPView:SaveResetProp(tran, resRef, data, type, index)
    local tb = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnResetPropClick, type, index))
    if table.isEmptyOrNil(self.ResetProp[type]) then
        self.ResetProp[type] = {}
    end
    self.ResetProp[type][index] = tb
    self:SetResetProp(tb, data, type, index)
end
---设置词缀属性
function EquipmentUPView:SetResetProp(tb, data, type, index)
    if tb == nil then
        return
    end
    local cfg = _G.ConfigManager.equipment_add_att_cfg
    tb.aortext_ResetPropName.text = _G.LangUtil.GetLangPackValue(cfg[data.k].name) .. ":"
    tb.aortext_ResetPropDes.text = _G.LangUtil.GetLangPackValue(cfg[data.k].desc)
    if _G.AttrType[cfg[data.k].type_attribute] and _G.AttrType[cfg[data.k].type_attribute].proptype == 3 then
        tb.aortext_ResetPropNum.text = data.v * 0.01 .. "%"
    else
        tb.aortext_ResetPropNum.text = data.v
    end
    tb.aorimage_Grade.SpriteName =
        _G.AdditionGrade[require("EquipmentModel"):GetInstance():CalcAdditionGrade(data.k, data.v)]

    local IsResetProp = false
    if self.ResetPropUid[1] == type or self.SelectedResetProp[1] == type then
        if self.ResetPropUid[2] == index or self.SelectedResetProp[2] == index then
            IsResetProp = true
            tb.aorimage_ResetSelect:SetActiveE(1)
            tb.aorimage_SelectAorrw.SpriteName = "ui_ty_icon_gou"
            tb.aorimage_SelectAorrw:SetNativeSize()
            if self.EquipData.a_sid > 0 then
                tb.obj_ResetAfter:SetActiveE(1)
                tb.obj_Eff:SetActiveE(0)
            else
                tb.aortext_ResetBeforePropName:SetActiveE(0)
                tb.obj_ResetAfter:SetActiveE(1)
                tb.obj_Eff:SetActiveE(0)
            end
        end
    end

    if not IsResetProp then
        tb.aortext_ResetBeforePropName:SetActiveE(0)
        if self.EquipData.IsReset then
            tb.obj_Lock:SetActiveE(1)
            tb.obj_ResetAfter:SetActiveE(0)
        else
            tb.obj_Lock:SetActiveE(0)
            tb.obj_ResetAfter:SetActiveE(1)
        end
        tb.aorimage_ResetSelect:SetActiveE(0)
        tb.obj_Eff:SetActiveE(0)
        if self.EquipData.reset_type == 0 then
            tb.aorimage_SelectAorrw:SetActiveE(0)
        else
            tb.aorimage_SelectAorrw:SetActiveE(1)
            tb.aorimage_SelectAorrw.SpriteName = "ui-fbxt-icon-suo"
            local rect = tb.aorimage_SelectAorrw:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
            rect:SetRectTransformSize(16, 16)
        end
    end
end

---选择词缀
function EquipmentUPView:ResetSelect(type, index)
    if self.ResetPropUid[1] > 0 or self.EquipData.reset_type ~= 0 then
        return
    else
        if self.SelectedResetProp[1] ~= 0 then
            local tb = self.ResetProp[self.SelectedResetProp[1]][self.SelectedResetProp[2]]
            tb.aorimage_ResetSelect:SetActiveE(0)
            tb.aorimage_ResetSelect:SetActiveE(0)
            tb.aorimage_SelectAorrw:SetActiveE(0)
        end
        self.SelectedResetProp[1] = type
        self.SelectedResetProp[2] = index
        self.ResetProp[type][index].aorimage_ResetSelect:SetActiveE(1)
        self.ResetProp[type][index].aorimage_SelectAorrw:SetActiveE(1)
    end
    self:ShowResetView()
end
---查看词缀信息
function EquipmentUPView:ResetInfo(type, index)
    self.go_table.obj_ResetPropInfoView:SetActiveE(1)
    local EquipCfg = _G.ConfigManager.equipment_cfg[self.EquipData.sid]
    local AddCfg
    if type == _G.AdditionType.Fixed then
        AddCfg = _G.ConfigManager.equipment_add_cfg[EquipCfg.addition_fixed].sub_attribute
    elseif type == _G.AdditionType.Random then
        AddCfg = _G.ConfigManager.equipment_add_cfg[EquipCfg.addition].sub_attribute
    end
    local sid
    if type == _G.AdditionType.Fixed then
        sid = self.EquipData.addition_fixed[index].k
    elseif type == _G.AdditionType.Random then
        sid = self.EquipData.addition[index].k
    end
    if #AddCfg > #self.ResetPropInfo then
        for i = #self.ResetPropInfo + 1, #AddCfg do
            _G.PoolsManager:GetInstance():Spawn(
                PrefabsPath.ResetPropInfo,
                _G.ePoolType.UIItem,
                self.go_table.obj_ResetPropInfoPanel,
                _G.handlerbind(self, self.SaveResetPropInfo, AddCfg[i], sid)
            )
        end
    end
    for i = 1, #self.ResetPropInfo do
        if i > #AddCfg then
            self.ResetPropInfo[i]:SetActiveE(0)
        else
            self.ResetPropInfo[i]:SetActiveE(1)
            self:SetResetPropInfo(self.ResetPropInfo[i], AddCfg[i], sid)
        end
    end
end
---点击词缀
function EquipmentUPView:OnResetPropClick(go, ison, type, index)
    local name = go:GetName()
    if name == "@_aorbtn_ResetSelect" then
        self:ResetSelect(type, index)
    elseif name == "@_aorbtn_ResetInfo" then
        self:ResetInfo(type, index)
    end
end

----保存强化属性
function EquipmentUPView:SaveUPProp(tran, resRef, type)
    local tb = _G.GetAutoGoTable(tran)
    table.insert(self.UPProp, tb)
    self:SetUPProp(tb, type)
end

----设置强化属性
function EquipmentUPView:SetUPProp(tb, type)
    if tb == nil then
        return
    end
    local strengSid = 100000 + self.EquipData.cfg.parts * 1000 + self.EquipData.streng
    local cfg = _G.ConfigManager.equipment_stren_cfg[strengSid]
    if cfg == nil then
        cfg = {}
        cfg[type] = 0
    end
    tb.aorrawimage_icon:LoadImage(_G.ConfigManager.type_attribute_cfg[_G.AttrType[type].ID].icon)
    tb.aortext_Name.text = _G.AttrType[type].des
    tb.aortext_AfterNum.text = cfg[type] + self.EquipData.cfg[type]
    if self.EquipData.streng == self.EquipData.cfg.strengthen_level then
        tb.aortext_BeforeNum.text = _G.ConfigManager.language_package_cfg[90021700023]
    else
        cfg = _G.ConfigManager.equipment_stren_cfg[strengSid + 1]
        tb.aortext_BeforeNum.text = cfg[type] + self.EquipData.cfg[type]
    end
end

---保存星数
function EquipmentUPView:SaveStar(tran, num, list)
    local image = tran:GetComponentE(typeof(_G.CS.AorImage))
    table.insert(list, image)
    self:SetStar(image, num)
end

---设置星数
function EquipmentUPView:SetStar(image, num)
    if image == nil then
        return
    end
    if num > self.EquipData.streng then
        image.SpriteName = "Star2"
    else
        image.SpriteName = "Star"
    end
end

---更新强化界面
function EquipmentUPView:ShowUPView()
    self.go_table.obj_UPView:SetActiveE(1)
    self.go_table.obj_ResetView:SetActiveE(0)
    self.go_table.aorimage_UpOn:SetActiveE(1)
    self.go_table.aorimage_ResetOn:SetActiveE(0)
    --星级
    self.go_table.aortext_AfterStar.text =
        _G.ConfigManager.language_package_cfg[90024400003] .. "<color=#259685>+" .. self.EquipData.streng .. "</color>"
    if self.EquipData.streng == self.EquipData.cfg.strengthen_level then
        self.go_table.aortext_BeforeStar.text =
            "<color=#ff7646>" .. _G.ConfigManager.language_package_cfg[90021700023] .. "</color>"
    else
        self.go_table.aortext_BeforeStar.text =
            _G.ConfigManager.language_package_cfg[90024400003] ..
            "<color=#ff7646>+" .. self.EquipData.streng + 1 .. "</color>"
    end

    --属性
    local TmpAttr = self.EquipData:GetAllAttr():GetAttrByName()

    local attr = {}
    for i, v in pairs(TmpAttr) do
        if v ~= 0 then
            table.insert(attr, {key = i, value = v})
        end
    end
    table.sort(
        attr,
        function(a, b)
            return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
        end
    )
    local count = 1
    for i, v in pairs(attr) do
        if count > #self.UPProp then
            _G.PoolsManager:GetInstance():Spawn(
                PrefabsPath.UPProp,
                _G.ePoolType.UIItem,
                self.go_table.obj_UPProp,
                _G.handlerbind(self, self.SaveUPProp, v.key)
            )
        else
            self:SetUPProp(self.UPProp[count], v.key)
        end
        count = count + 1
    end

    -- local strengSid = self.EquipData.cfg.professional * 100000 + self.EquipData.cfg.parts * 1000 + self.EquipData.streng
    -- local StrengCfg = _G.ConfigManager.equipment_stren_cfg[strengSid]
    -- local count = 1
    -- for i = 1, table.count(_G.EquipmentProp) do
    --     if self.EquipData.cfg[_G.EquipmentProp[i]] > 0 or (StrengCfg ~= nil and StrengCfg[_G.EquipmentProp[i]] > 0) then
    --         if count > #self.UPProp then
    --             _G.PoolsManager:GetInstance():Spawn(
    --                 PrefabsPath.UPProp,
    --                 _G.ePoolType.UIItem,
    --                 self.go_table.obj_UPProp,
    --                 _G.handlerbind(self, self.SaveUPProp, _G.EquipmentProp[i])
    --             )
    --         else
    --             self:SetUPProp(self.UPProp[count], _G.EquipmentProp[i])
    --         end
    --         count = count + 1
    --     end
    -- end

    if not table.isEmptyOrNil(self.UpMaterial) then
        for _, v in pairs(self.UpMaterial) do
            v:Despawn()
        end
        self.UpMaterial = {}
    end
    local cfg = self.EquipData:GetEquipNextStrengCfg()
    if self.EquipData.streng < self.EquipData.cfg.strengthen_level and cfg ~= nil then
        local storageID
        for _, v in pairs(cfg.materials) do
            _, storageID = _G.StorageManager:GetInstance():CheckSidType(v[1])
            local item = _G.StorageManager:GetInstance():GetItemDataByID(storageID, v[1])
            if item == nil then
                item = _G.PropData.New()
                item:Parse({sid = v[1], num = 0})
            end
            require("MaterialBase").Create(
                item,
                self.go_table.obj_UPMaterial,
                function(tran)
                    table.insert(self.UpMaterial, tran)
                    tran:SetConsume(v[2])
                end
            )
        end
        local item = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.ResProp, _G.ResPropID.Coin)
        require("MaterialBase").Create(
            item,
            self.go_table.obj_UPMaterial,
            function(tran)
                table.insert(self.UpMaterial, tran)
                tran:SetConsume(cfg.num_coin)
            end
        )
    end
end
---更新洗练界面
function EquipmentUPView:ShowResetView()
    if self.EquipData.a_sid > 0 then
        self:ShowChooseView(true)
    end
    self.go_table.obj_UPView:SetActiveE(0)
    self.go_table.obj_ResetView:SetActiveE(1)
    self.go_table.aorimage_UpOn:SetActiveE(0)
    self.go_table.aorimage_ResetOn:SetActiveE(1)
    self.go_table.aortext_EquipmentName.text = _G.LangUtil.GetLangPackValue(self.EquipData.cfg.name)
    self.power.text = self.EquipData:GetPower()
    self.go_table.aorimage_Grade.SpriteName = _G.EquipmentGrade[self.EquipData.cfg.grade]
    local prof =
        _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_professional_cfg[self.EquipData.cfg.professional].name)
    self.go_table.aortext_EquipType.text = "[" .. prof .. "]"

    if self.EquipData.a_sid ~= 0 then
        self.go_table.aorbtn_ReplaceBtn:SetActiveE(1)
    else
        self.go_table.aorbtn_ReplaceBtn:SetActiveE(0)
    end
    --词缀
    local data
    for type, v in pairs(self.ResetProp) do
        for index, tb in pairs(v) do
            data = self.EquipData:GetAddition(type, index)
            if data ~= nil then
                self:SetResetProp(tb, data, type, index)
            end
        end
    end

    if not table.isEmptyOrNil(self.ResetMaterial) then
        for _, v in pairs(self.ResetMaterial) do
            v:Despawn()
        end
        self.ResetMaterial = {}
    end
    local cfg
    if self.SelectedResetProp[1] == _G.AdditionType.Fixed then
        cfg = _G.ConfigManager.equipment_add_cfg[self.EquipData.cfg.addition_fixed]
    elseif self.SelectedResetProp[1] == _G.AdditionType.Random then
        cfg = _G.ConfigManager.equipment_add_cfg[self.EquipData.cfg.addition]
    else
        cfg = nil
    end
    if cfg ~= nil then
        local storageID
        for _, v in pairs(cfg.materials) do
            _, storageID = _G.StorageManager:GetInstance():CheckSidType(v[1])
            local item = _G.StorageManager:GetInstance():GetItemDataByID(storageID, v[1])
            if item == nil then
                item = _G.PropData.New()
                item:Parse({sid = v[1], num = 0})
            end
            require("MaterialBase").Create(
                item,
                self.go_table.obj_ResetMaterial,
                function(tran)
                    table.insert(self.ResetMaterial, tran)
                    tran:SetConsume(v[2])
                end
            )
        end
    end
end

