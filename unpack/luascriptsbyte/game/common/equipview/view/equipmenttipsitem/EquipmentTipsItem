---设置参数
---@param dData EquipmentItem 饰品数据类
---@param isSelf boolean 是否是当前穿戴(当此参数为true，则btn不生效，反之)
---@param btn table {left = {name = string ,onclickFunc = function },right = {name = string ,onclickFunc = function }}
---@param tran transform tran
function EquipmentTipsItem:SetData(dData, isSelf, btn, tran)
    if not dData then
        return
    end
    self.data = dData
    self.isSelf = isSelf

    self.btn = btn
    self.go_table = _G.GetAutoGoTable(tran, _G.handler(self, self.OnClickBtn))
    self:InitView()
end

function EquipmentTipsItem:InitView()
    local data = self.data
    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.cardUid)
    self.go_table.aortext_rolename.text = data:GetName()
    local grade = data.cfg.grade
    -- 装备没有金色，红色之后就是彩色
    if grade >= 7 then
        grade = 8
    end
    ---@type CommonTipManager
    local ctm = require"CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_rolename.gameObject, grade)
    self.go_table.aorrawimage_di:LoadImage(ctm:GetItemBgPathByGrade(grade))
    local outlineColor = _G.ColorTools.FormatColorByString(
            require "CommonTipManager":GetInstance():GetTipTypeNameOutLineColorByGrade(grade)
    )
    self.go_table.aortext_equipmenttype:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_Power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    local effectPath = require "CommonTipManager":GetInstance():GetItemBgEffectPathByGrade(grade)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_EffNode
    )
    ---  不显示阶级ZHJ-7672
    --.. _G.LangUtil.GetLangPackValue(self.ClassName[data.cfg.level])
    --self.go_table.aortext_TeamLv.text = _G.LangUtil.GetLangPackValue(90000000043) .. data.cfg.limit_level

    ---没生成对象
    if self.CurItem_lua == nil then
        ---开始生成对象 并标记
        self.CurItem_lua = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_item,
            function(itemLua)
                self.CurItem_lua = itemLua
                self.CurItem_lua:ShowData(self.data)
            end
        )
    elseif self.CurItem_lua ~= true then
        ---已生成对象
        self.CurItem_lua:ShowData(self.data)
    end

    self.go_table.aortext_equipmenttype.text =
        _G.LangUtil.GetLangPackValue(90020400066)
    self.go_table.aorimage_professional.SpriteName = require("CardInfoManager"):GetInstance():GetCardProfession_ByEquipmentType(data.cfg.professional)
    if data.element == 0 then
        self.go_table.obj_roleUp:SetActiveE(0)
        self.go_table.aortext_roleUp:SetActiveE(0)
    else
        self.go_table.obj_roleUp:SetActiveE(1)
        self.go_table.aortext_roleUp:SetActiveE(1)

        local i = _G.LangUtil.GetLangPackValue(WuXingText[data.element])
        self.go_table.aortext_roleUp.text = string.format(_G.LangUtil.GetLangPackValue(WuXingText[99]), i, "30%")
    end

    self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(data.cfg.describe)
    self.go_table.aortext_Power.text =
        _G.LangUtil.GetLangPackValue(90000000404, _G.GameUtil.NumberToUnitStrBag(data:GetPower()))

    if self.isSelf then
        --self.go_table.obj_Self:SetActiveE(1)
        self.go_table.obj_Btn:SetActiveE(0)
    else
        --  _G.LangUtil.GetLangPackValue(90023400020)
        if self.btn == nil then
            self.go_table.obj_Btn:SetActiveE(0)
        else
            self.go_table.obj_Btn:SetActiveE(1)
            --self.go_table.obj_Self:SetActiveE(0)

            self.go_table.aorbtn_left:SetActiveE(self.btn.left ~= nil and 1 or 0)
            if self.btn.left ~= nil then
                self.go_table.aortext_BtnLeftName.text = self.btn.left.name
            end

            self.go_table.aortext_BtnRightName.text = self.btn.right.name

            if self.btn.replace ~= nil and self.btn.replace.name ~= nil then
                self.go_table.aortext_BtnReplaceName.text = self.btn.replace.name
                self.go_table.aorbtn_replace:SetActiveE(1)
            else
                self.go_table.aorbtn_replace:SetActiveE(0)
            end
        end
    end

    self:ShowProp(data)
    self:ShowRandomProp(data)
    self:ShowBoundProp(data)
end
function EquipmentTipsItem:ShowBoundProp(data)
    if data.bound == 0 then
        self.go_table.obj_Bound:SetActiveE(0)
        self.go_table.obj_boundCard:SetActiveE(0)
        self.go_table.obj_boundPropContent:SetActiveE(0)
    else
        local cfg = _G.ConfigManager.card_cfg[data.bound]
        if not cfg then
            return
        end
        local icon = cfg.Icon
        if _G.string.contains(icon, "/") then
            icon = _G.string.split2tbl(icon, "/")
            icon = icon[#icon]
        end
        self.go_table.aorimage_Icon.SpriteName = icon
        local bg = require("CardInfoManager"):GetInstance():GetHeadBgSpriteName(cfg.Star, cfg.Order)
        self.go_table.aorimage_ColorBg.SpriteName = bg
        self.go_table.obj_Bound:SetActiveE(1)
        self.go_table.obj_boundCard:SetActiveE(1)
        local ChildCount = self.go_table.obj_boundPropContent:GetChildCountE()
        if ChildCount > 0 then
            for i = 1, ChildCount do
                _G.PoolsManager:GetInstance():Despawn(
                    self.go_table.obj_boundPropContent:GetChildE(0),
                    _G.ePoolType.UIItem
                )
            end
        end
        ---@type data EquipmentItem
        local prop = data:GetCurAttributeBind()
        local showlist = {}

        for i = 1, #prop do
            table.insert(
                showlist,
                {
                    key = prop[i][1],
                    sortid = _G.AttrType[prop[i][1]].sortid,
                    value = tonumber(prop[i][3]),
                    type = tonumber(prop[i][2])
                }
            )
        end

        local numStr, upVStr, upNum, num, tb, tran, key
        for _, v in pairs(showlist) do
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_boundPropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                local attr = _G.AttrType[key]
                --tb.aorrawimage_icon:LoadImage(_G.AttrType[key].icon)
                tb.aortext_Name.text = attr.des

                num = v.value
                if attr.proptype == 1 then
                    if v.type == 1 then
                        if attr.percentage == 1 then
                            num = num / 100
                            num = _G.GameUtil.FormatNum(num)
                            num = tostring(num) .. "%"
                            numStr = "<color=#5bdf99>" .. num .. "</color>"
                        else
                            num = _G.math.floor(num)
                            num = _G.GameUtil.NumberWY(num)
                            numStr = "<color=#5bdf99>" .. tostring(num) .. "</color>"
                        end
                    elseif v.type == 2 then
                        num = math.floor(v.value / 100) .. "%"
                        numStr = "<color=#5bdf99>" .. tostring(num) .. "</color>"
                    end
                else
                    if attr.percentage == 1 then
                        num = num / 100
                        num = _G.GameUtil.FormatNum(num)
                        num = tostring(num) .. "%"
                        numStr = "<color=#5bdf99>" .. num .. "</color>"
                    else
                        num = _G.math.floor(num)
                        num = _G.GameUtil.NumberWY(num)
                        numStr = "<color=#5bdf99>" .. tostring(num) .. "</color>"
                    end
                end

                tb.aortext_Num.text = numStr
            end
        end
        self.go_table.obj_boundPropContent:SetActiveE(1)
    end
end

---设置属性
------@param data EquipmentItem
function EquipmentTipsItem:ShowProp(data)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local prop = data.prop:GetAttrByName()
    local showlist = {}

    for i, v in pairs(data.prop.attribute) do
        if v > 0 then
            table.insert(showlist, {key = i, sortid = _G.AttrType[i].sortid})
        end
    end
    SortList(
        showlist,
        function(a)
            return -a.sortid
        end
    )

    local numStr, upVStr, upNum, num, tb, tran, key
    for _, v in pairs(showlist) do
        key = v.key
        tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            tb = _G.GetAutoGoTable(tran)
            --tb.aorrawimage_icon:LoadImage(_G.AttrType[key].icon)
            tb.aortext_Name.text = _G.AttrType[key].des

            num = prop[key]
            upNum = data.UPProp:GetValueByName(key)

            upVStr = ""
            if _G.AttrType[key].percentage == 1 then
                num = num * 100
                num = _G.GameUtil.FormatNum(num)
                num = tostring(num) .. "%"
                numStr = "<color=#5bdf99>" .. num .. "</color>"

                if upNum ~= 0 then
                    upNum = upNum * 100
                    upNum = _G.GameUtil.FormatNum(upNum)
                    upNum = tostring(upNum) .. "%"
                    upVStr = "<color=#5bdf99>+" .. upNum .. "</color>"
                end
            else
                num = _G.math.floor(num)
                num = _G.GameUtil.NumberWY(num)
                numStr = "<color=#5bdf99>" .. tostring(num) .. "</color>"
                if upNum ~= 0 then
                    upNum = _G.math.floor(upNum)
                    upNum = _G.GameUtil.NumberWY(upNum)
                    upVStr = "<color=#5bdf99>+" .. tostring(upNum) .. "</color>"
                end
            end

            tb.aortext_Num.text = numStr .. upVStr
        end
    end
end

---设置属性
------@param data EquipmentItem
function EquipmentTipsItem:ShowRandomProp(data)
    local ChildCount = self.go_table.obj_randomPropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_randomPropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local additionValue = data.additionValue
    local isAdd = #additionValue > 0
    self.go_table.obj_random:SetActiveE(isAdd and 1 or 0)
    if isAdd == false then
        return
    end

    local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg
    ---@type equipment_add_att_cfg
    local equipment_add_att_cfgItem
    local numStr, upNum, tb, tran, color, grade

    for _, info in pairs(additionValue) do
        local sid = info[1]
        local num = info[2]
        tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_randomPropContent)
        if tran then
            tb = _G.GetAutoGoTable(tran)
            equipment_add_att_cfgItem = equipment_add_att_cfg[sid]

            color = require("EquipmentModel"):GetInstance():GetAddAttColor(sid, num * 10000)
            grade = require("EquipmentModel"):GetInstance():CalcAdditionGrade(sid, num * 10000)

            tb.aortext_Name.text =_G.LangUtil.GetLangPackValue(equipment_add_att_cfgItem.name)
            num = num * 100
            num = string.format("%.1f", tostring(num))
            num = tonumber(num)
            num = _G.GameUtil.FormatNum(num)
            num = tostring(num) .. "%"
            if grade == 2 then
                num = tostring(num) .. " (C)"
            elseif grade == 3 then
                num = tostring(num) .. " (B)"
            elseif grade == 4 then
                num = tostring(num) .. " (A)"
            elseif grade == 5 then
                num = tostring(num) .. " (S)"
            end
            numStr = string.format("<color=#%s>%s</color>", color, tostring(num))

            tb.aortext_Num.text = numStr
        end
    end
end

function EquipmentTipsItem:SetLockImage()
end

function EquipmentTipsItem:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_left" then
        self.btn.left.func()
    elseif name == "@_aorbtn_Right" then
        self.btn.right.func()
    elseif name == "@_aorbtn_replace" then
        self.btn.replace.func()
    elseif name == "@_aorbtn_Lock" then
        local type = 1
        if self.data.isLock == false then
            type = 0
        end
        require("DecorationModel"):GetInstance():Lock(
            self.data.cardUid,
            self.data.uid,
            type,
            _G.handler(self, self.SetLockImage)
        )
    end
end

