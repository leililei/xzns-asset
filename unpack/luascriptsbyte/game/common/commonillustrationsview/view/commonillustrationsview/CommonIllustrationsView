local function HideOtherWindow(ui_name)
    local otherWindows = {}
    for k, v in pairs(_G.UIManager:GetInstance().windows) do
        if k ~= ui_name and k ~= "ShadowView" and k ~= "CommonIllustrationsTopView" then
            if v.gameObject ~= nil and v.gameObject:GetActiveSelf() == 1 then
                _G.table.insert(otherWindows, k)
            -- _G.GameUtil.SetActiveByCondition(v.gameObject, false)
            --  cavas.enabled = false
            end
        end
    end

    for _, v in pairs(otherWindows) do
        local dc = {}
        dc.HideWorld = false
        _G.UIManager:GetInstance():HideWindow(v, dc)
    end
    return otherWindows
end
