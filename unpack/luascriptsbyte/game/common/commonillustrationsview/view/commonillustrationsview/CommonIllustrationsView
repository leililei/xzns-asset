function CommonIllustrationsView:LoadCommonEffect()
    local LoadEffectByCfg = _G.UIUtils.LoadEffectByCfg
    local RemoveEffect = _G.UIUtils.RemoveEffect
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local call = function(eff)
        if not self.go_table then
            RemoveEffect(eff)
        end
    end
    LoadEffectByCfg(ui_effect_cfg.ef_CardShowView_fire_loop, self.go_table.aorbtn_talent, call)
end

---界面的入口函数
------@param  id number
---@param NewData CardData 其他玩家的卡
---@param showBtnTb table<number> 显示的页签
---@param showSkin number 皮肤id
function CommonIllustrationsView:OnCreate(
    Id,
    call,
    isQieHuanButtonClick,
    NewData,
    GHCall,
    Cards,
    IsChat,
    cardPage,
    showBtnTb,
    JieJiLuanDuo,
    showSkin)
    self:InitEquipAndArtifactPos()
    if Id == nil or self.card_cfg[Id] == nil then
        if _G.ConfigManager.skin_cfg[Id] then
            Id = _G.ConfigManager.skin_cfg[Id].card
            NewData.sid = Id
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("卡牌ID不正确")
            end
            return
        end
    end
    if self.illustrations_card_cfg[Id] == nil and NewData == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("图鉴中卡牌ID不正确")
        end
        return
    end

    self.call = call

    if IsChat == nil then
        IsChat = false
    end
    self.GHCall = GHCall
    self.Cards = Cards
    self.IsChat = IsChat
    self.CardsPage = cardPage or 1
    ---街机乱斗专用屏蔽
    self.JieJiLuanDuo = JieJiLuanDuo
    ---当前展示卡牌数据
    ---@type card_cfg
    self.card_cfg_Data = {}
    self.illustrationsCaedData = {}
    self.card_cfg_Data = self.card_cfg[Id]
    ---如果没有在图鉴找到那说明是外部卡片数据进来做预览
    ---判断数据是否初始化
    self.go_Shuxing_Init = false
    ---判断当前页面显示为魂链还是属性页面(1是属性主界面，2是灵契。3魂链 4是刻魂)
    self.DQYeMian = 1
    self.OtherCard = not _G.IsNil(NewData)
    self:InitShowBtn(showBtnTb)
    if showSkin then
        local data, skin = CardCommentManager:CardData(showSkin, false)
        self.card_cfg_Data = data or self.card_cfg_Data
        self.showSkin = showSkin
        self.DQYeMian = 5
    end
    self.illustrationsCaedData = self.illustrations_card_cfg[Id] or self.illustrations_card_cfg[111020000]
    self:JiaShuJu(NewData)
    self.IsMoreCard = not _G.IsNil(Cards)
    if self.IsChat then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_zj, false)
        _G.GameUtil.SetActiveByCondition(self.PFgo_table.aorbtn_assignLv, false)
        self.go_table.obj_equipment:SetActiveE(1)
        self.EquipItem = {}
        self:InitEquipmentItem(_G.handlerbind(self, self.ShowEquipmentItem, NewData))
        self:InitArtifactItem(_G.handlerbind(self, self.ShowArtifactItem, NewData))
    end
    if isQieHuanButtonClick then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_L, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_R, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_yan, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_zj, false)
    else
        self:PanDuanXianShi()
    end

    if GHCall then
        _G.GameUtil.SetActiveByCondition(self.PFgo_table.aorbtn_assignLv, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_gh, true)
    end
    self:LoadCommonEffect()
end

