function CommonIllustrationsView:PanDuanXianShi()
    if not self.IsMoreCard then
        local shu = self.illustrationsCaedData.display_priority
        self.go_table.aorbtn_L:SetActiveE(1)
        self.go_table.aorbtn_R:SetActiveE(1)
        if shu == 1 then
            self.go_table.aorbtn_L:SetActiveE(0)
        end
        if shu == _G.table.count(self.illustrations_card_cfg) then
            self.go_table.aorbtn_R:SetActiveE(0)
        end
    else
        self.go_table.aorbtn_L:SetActiveE(1)
        self.go_table.aorbtn_R:SetActiveE(1)
        if self.CardsPage == 1 then
            self.go_table.aorbtn_L:SetActiveE(0)
        end
        if self.CardsPage == _G.table.count(self.Cards) then
            self.go_table.aorbtn_R:SetActiveE(0)
        end
    end
end

function CommonIllustrationsView:NewData(zhi)
    if not self.IsMoreCard then
        if self.ZeDang then
            -- body
            self.ZeDang = false
            local i = 0
            if zhi then
                i = i - 1
            else
                i = i + 1
            end
            local shu = self.illustrationsCaedData.display_priority
            for key, value in pairs(self.illustrations_card_cfg) do
                if shu + i == value.display_priority then
                    self.card_cfg_Data = {}
                    self.card_cfg_Data = self.card_cfg[key]
                    self.illustrationsCaedData = {}
                    self.illustrationsCaedData = self.illustrations_card_cfg[key]
                    ---判断数据是否初始化
                    self.go_Shuxing_Init = false
                    self:JiaShuJu()
                end
            end
            self:PanDuanXianShi()
        end
    else
        if zhi then
            self.CardsPage = self.CardsPage - 1
        else
            self.CardsPage = self.CardsPage + 1
        end

        ---判断数据是否初始化
        self.go_Shuxing_Init = false
        local cardData = self.Cards[self.CardsPage]
        self.card_cfg_Data = {}
        self.card_cfg_Data = self.card_cfg[cardData.sid]
        self:JiaShuJu(cardData)

        self:PanDuanXianShi()
    end
end

