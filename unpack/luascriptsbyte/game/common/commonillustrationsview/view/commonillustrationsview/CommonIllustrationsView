        Card.Photo,
        function(image)
            if image then
                image:SetNativeSize()
                image:SetActiveE(1)
            end
        end
    )
    local bool = self:HaveSkinDicIs(Card.id)
    if bool then
        tb.aorrawimage_Hei:SetActiveE(0)
    else
        tb.aorrawimage_Hei:SetActiveE(1)
    end

    if Card.SkinType then
        tb.aorrawimage_icon:LoadImage(
            Card.SkinType,
            function(image)
                if image then
                    image:SetNativeSize()
                    image:SetActiveE(1)
                end
            end
        )
    else
        tb.aorrawimage_icon:SetActiveE(0)
    end
    tb.gameObject:SetActiveE(1)
end

