    local data2 = {}
    data2.data = data
    data2.isSelf = false
    data2.btn = {}

    if isPy == true then
        data2.btn.left = {}
        data2.btn.left.name = _G.LangUtil.GetLangPackValue(90023400005)
        data2.btn.left.func = _G.handlerbind(self, self.Strengthen, data)
    end

    --data2.btn.right = {}
    --data2.btn.right.name = _G.LangUtil.GetLangPackValue(90020400047)
    --data2.btn.right.func = _G.handlerbind(self, self.EquipReplace, data)

    if not table.isEmptyOrNil(self.CardData.EquipBar[data.cfg.parts]) then
        data1.data = self.CardData.EquipBar[data.cfg.parts]
        if data2.data.uid ~= data1.data.uid then
            data1.isSelf = true
            data1.btn = nil
            table.insert(msg, data1)
            table.insert(msg, data2)
        else
            data1.isSelf = false
            data1.btn = {}

            if isPy == true then
                data1.btn.left = {}
                data1.btn.left.name = _G.LangUtil.GetLangPackValue(90020400065)
                data1.btn.left.func = _G.handlerbind(self, self.Strengthen, data)
            end
            --data1.btn.right = {}
            --data1.btn.right.name = _G.LangUtil.GetLangPackValue(90020400047)
            --data1.btn.right.func = _G.handlerbind(self, self.EquipReplace, data)

            --data1.btn.replace = {}
            --data1.btn.replace.name = _G.LangUtil.GetLangPackValue(90020400064)
            --data1.btn.replace.func = _G.handlerbind(self, self.EquipTakeOff, data)

            table.insert(msg, data1)
        end
    else
        table.insert(msg, data2)
    end
    if self.CardData.type == _G.CardType.Timer then
        msg = {}
        data2.isSelf = true
        data2.btn.right = {}
        table.insert(msg, data2)
    end
    --分享不需要按钮
    msg[1].btn = nil
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, msg, 1)
end

function CommonIllustrationsView:InitArtifactItem(call)
    local factoryIns = _G.ItemFactory:GetInstance()
    local type = _G.ItemFactory.itemType.ItemArtifactBase
    self.ArtifactItem = nil
    ---@param item ItemArtifactBase
    factoryIns:GetItemCard(
        type,
        self.go_table.obj_ArtifactItem,
        function(item)
            ---隐藏   不挡装备栏点击
            item.go_table.aorbtn_Click:SetActiveE(0)
            item:ShowOrHideFrame(true)
            self.ArtifactItem = item
            if call then
                call()
            end
        end
    )
end

function CommonIllustrationsView:ShowArtifactItem(NewData)
    if _G.table.isEmptyOrNil(NewData.ArtifactBar) then
        self.go_table.obj_Artifact:SetActiveE(0)
    else
        self.go_table.obj_Artifact:SetActiveE(1)
        self.go_table.obj_artifactLock:SetActiveE(0)
        self.ArtifactItem:ShowData(NewData.ArtifactBar)
        self.ArtifactItem:HideCardBound()
    end
end

function CommonIllustrationsView:OpenArtifact()
    if _G.table.isEmptyOrNil(self.CardData.ArtifactBar) then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
        _G.TipType.Artifact,
        self.CardData.ArtifactBar
    )
end

function CommonIllustrationsView:OpenSpiritual()
    if _G.table.isEmptyOrNil(self.CardData.SpiritualBar) then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DecorationTipsView.Name,
        {{data = self.CardData.SpiritualBar}},
        4
    )
end

---@param spiritualData SpiritualData
function CommonIllustrationsView:OnClickSpiritualItem(go, isOn, spiritualData)
    if not spiritualData then
        return
    end
    local data = {}
    data.data = spiritualData
    data.isSelf = true
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, {data}, 3)
end

return CommonIllustrationsView
