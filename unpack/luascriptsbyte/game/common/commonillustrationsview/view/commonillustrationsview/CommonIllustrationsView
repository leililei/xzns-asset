            end
        )
    elseif name == "@_aorbtn_shipin1" then
        self:IdTip(go, 3)
    elseif name == "@_aorbtn_shipin2" then
        self:IdTip(go, 2)
    elseif name == "@_aorbtn_shipin3" then
        self:IdTip(go, 4)
    elseif name == "@_aorbtn_shipin4" then
        self:IdTip(go, 1)
    elseif name == "@_aorbtn_Weapon" then
        self:OpenEquiip(EquipmentPart.Weapon)
    elseif name == "@_aorbtn_Head" then
        self:OpenEquiip(EquipmentPart.Head)
    elseif name == "@_aorbtn_Clothes" then
        self:OpenEquiip(EquipmentPart.Clothes)
    elseif name == "@_aorbtn_Shoes" then
        self:OpenEquiip(EquipmentPart.Shoes)
    elseif name == "@_aorbtn_Artifact" then
        self:OpenArtifact()
    elseif name == "@_aorbtn_pl" then
        self:OnClick_CommentView()
    elseif name == "@_aorbtn_attrib" then
