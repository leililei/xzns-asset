function CommonIllustrationsView:InitEquipAndArtifactPos()
    local overseas = _G.AppSetting.IsOverseas
    self.go_table.obj_equipment:SetAnchorPosition(overseas and -320 or -332, overseas and 4 or 191)
    self.go_table.obj_Weapon:SetAnchorPosition(overseas and -154 or -221, overseas and 218 or 0)
    self.go_table.obj_Head:SetAnchorPosition(overseas and -154 or -111, overseas and 82 or 0)
    self.go_table.obj_Clothes:SetAnchorPosition(overseas and 225 or -1, overseas and 218 or 0)
    self.go_table.obj_Shoes:SetAnchorPosition(overseas and 225 or 109, overseas and 82 or 0)
    -- self.go_table.obj_Artifact:SetActiveE(overseas and 0 or 1)
end

function CommonIllustrationsView:InitShowBtn(btns)
    if not btns then
        return
    end
    self.showBtnTb = {}
    local data = btns or self.btnKey
    for _, v in pairs(data) do
        self.showBtnTb[v] = true
    end
end

---设置 魂链
function CommonIllustrationsView:SetBindHunlian()
    if self.go_table.obj_Right_hl:GetChildCountE() <= 0 then
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Card/View/CardShowView_Right_HunLian",
            _G.ePoolType.UIItem,
            self.go_table.obj_Right_hl,
            function(tran)
                if self.go_table then
                    self.go_table.obj_Right_hl:SetActiveE(1)
                    ---@type CardShowView_RightView_hl
                    self.lua_Right_Hl = self:AddComponent(tran, require("CardShowView_RightView_hl").New(tran, true))
                    tran:SetParentE(self.go_table.obj_Right_hl)
                    self.lua_Right_Hl:OtherCanvasUp(self.gameObject)
                    tran:SetLocalPosition(371, 0)
                    self.go_table.obj_Right_hl:SetActiveE(0)
                    self.lua_Right_Hl.go_table.obj_redpoint:SetActiveE(0)
                    if self.OtherCard then
                        self.lua_Right_Hl.go_table.obj_Item:AddComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup)).alpha =
                            0
                        self.lua_Right_Hl.go_table.obj_Button:SetActiveE(0)
                    end
                else
                    tran:DestroyObject()
                end
            end
        )
    else
        self.go_table.obj_Right_hl:SetActiveE(0)
    end

    -- self.lua_Right_Hl = self:AddComponent(tran, require("CardShowView_RightView_hl").New(tran))
end

---@param CardData CardData
---创建一个假的cdrddata并且生成数据
function CommonIllustrationsView:JiaShuJu(CardData)
    ---@type  prop.i_card 数据
    local msg = {}
    msg.sid = self.illustrationsCaedData.id
    msg.lv = self.illustrationsCaedData.level
    msg.awaken = 0
    msg.unlock = 0
    msg.uid = self.illustrationsCaedData.id
    msg.attr_add = {}
    if self.card_cfg_Data.Order < 3 then
        msg.soul_chain_lv = 0
    else
        msg.soul_chain_lv = require "CardHunLianModel":GetInstance():GetHunLevelMax()
    end
    msg.soul_state = 1
    msg.star = self.illustrationsCaedData.star
    msg.open_inborn = {}
    for i = 1, #self.card_cfg_Data.talent do
        local tt = self.card_cfg_Data.talent[i]
        for j = 1, #tt do
            table.insert(msg.open_inborn, tt[j])
        end
    end
    self:ChuShiHua(msg, CardData)
    self.LvPropData = {}
    self.LvPropData = self.CardData.NowSumProp:GetAttrByName()
    --self:UpdataFight()
    if self.sceneTrans == nil then
        self:LoadEmbattleScene(
            function(sceneTrans)
                self:LoadRoleScene(
                    self.card_cfg_Data.ModelPathHi,
                    function(roleTrans)
                    end,
                    self.showSkin
                )
            end
        )
    else
        self:LoadRoleScene(
            self.card_cfg_Data.ModelPathHi,
            function(roleTrans)
            end
        )
    end
    if not _G.AppSetting.IsOverseas then
        if self.card_cfg_Data.Star == 5 then
            self.go_table.aorbtn_lq:SetActiveE(1)
        else
            self.go_table.aorbtn_lq:SetActiveE(0)
        end
    end
    self.go_table.aorbtn_zj:SetActiveE(1)
    self.go_table.aorbtn_kh:SetActiveE(1)
    if self.card_cfg_Data.Order < 2 then
        --self.go_table.toggle_skill:SetActiveE(0)
        --self.go_table.aorbtn_qh:SetActiveE(0)
        --self.go_table.toggle_shuxing.isOn = true
        self.go_table.aorbtn_zj:SetActiveE(0)

        self.DQYeMian = 1

        self.go_table.aorbtn_hl:SetActiveE(0)

        self.go_table.obj_view:SetActiveE(1)
        self.go_table.obj_btn:SetActiveE(0)
    elseif self.card_cfg_Data.Order < 3 then
        if self.DQYeMian == 3 then
            self.DQYeMian = 1
        end
        if self.DQYeMian then
            self.go_table.obj_Right_hl:SetActiveE(0)
        end
        self.go_table.obj_btn:SetActiveE(1)

        self.go_table.aorbtn_hl:SetActiveE(0)

    elseif self.card_cfg_Data.skin == nil or #self.card_cfg_Data.skin <= 0 then
        self.DQYeMian = 1
        self.go_table.obj_pf:SetActiveE(0)
        self.go_table.obj_viewParent:SetActiveE(1)
    else
        self.go_table.aorbtn_hl:SetActiveE(1)
        -- body
        --self.go_table.toggle_skill:SetActiveE(1)
        --if self.DQYeMian == 1 then
        --self.go_table.toggle_skill.isOn = false
        --self.DQYeMian = false
        --end
        self.go_table.aorbtn_lq:SetActiveE(1)

        self.go_table.obj_btn:SetActiveE(1)
    end
    if self.DQYeMian == 3 then
        self.go_table.obj_pf:SetActiveE(0)
        if self.card_cfg_Data.Order < 3 then
            -- self.go_table.obj_Right_hl:SetActiveE(0)

            -- self.go_table.obj_move_L:SetActiveE(1)
            -- self.go_table.obj_Right_hg:SetActiveE(0)
            -- self.go_table.obj_view:SetActiveE(1)
            self:OnClickshuxingView()
        else
            self.go_table.obj_Right_hl:SetActiveE(1)
            self.lua_Right_Hl:ShowHunLian(self.CardData)
        end
    elseif self.DQYeMian == 1 then
        --self:ViewInitShuxing()
        self.go_table.obj_pf:SetActiveE(0)
        self.go_table.obj_Right_hl:SetActiveE(0)

        self.go_table.obj_move_L:SetActiveE(1)

        self.go_table.obj_view:SetActiveE(1)

        self.go_table.obj_goldInfo:SetActiveE(0)
        self.go_table.obj_Right_lq:SetActiveE(0)
    elseif self.DQYeMian == 5 then
        --self:ViewInitShuxing()
        if self.card_cfg_Data.skin and #self.card_cfg_Data.skin > 0 then
            self.go_table.obj_move_L:SetActiveE(1)
            self.go_table.obj_goldInfo:SetActiveE(0)
            self.go_table.obj_Right_lq:SetActiveE(0)
            self.go_table.obj_pf:SetActiveE(1)
            if self.showSkin then
                self.CardData.skin = self.showSkin
            end
            self:PiFuItemNew()
        else
            self.go_table.obj_pf:SetActiveE(0)
        end
    elseif self.DQYeMian == 4 then
        self:KeHunItemNew()
        self.go_table.obj_pf:SetActiveE(0)
    elseif self.DQYeMian == 2 then
        self:SpiritualItemNew()
        self.go_table.obj_pf:SetActiveE(0)
    end
    if self.card_cfg_Data.skin and #self.card_cfg_Data.skin > 0 then
    else
        self.go_table.obj_pf:SetActiveE(0)
    end
    self:ButImage()
    if self.JieJiLuanDuo ~= nil then
        --self.go_table.aorbtn_talent:SetActiveE(0)
        self.go_table.aorbtn_kh:SetActiveE(0)
        self.go_table.aorbtn_lq:SetActiveE(0)
        self.PFgo_table.aorbtn_assignLv:SetActiveE(0)
    end
end

function CommonIllustrationsView:ChuShiHua(msg, cardData)
    if cardData then
        self.CardData = cardData
        if self.IsChat then
            self.CardData:UpdateAttr()
            self.CardData.NowSumProp:OnInit(self.card_cfg_Data.Elements)
            local attributeManager = _G.AttributeClassManager:GetInstance()
            local attr = attributeManager:GetAttribtueClass(self.card_cfg_Data.Elements)
            attributeManager:AddAttribute(attr, self.CardData.BaseProp)
            --魂链 是否激活
            if self.card_cfg_Data.Order >= 3 then
