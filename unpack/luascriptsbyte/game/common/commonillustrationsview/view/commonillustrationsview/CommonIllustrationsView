function CommonIllustrationsView:OnClickBtn(go, isOn)
    if self.YanChiDianJi == nil or self.YanChiDianJi then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        --self:RoleRecycle()
        self:RoleRecycles()
        for _, v in pairs(self.hideViews) do
            local dc = {}
            dc.HideWorld = false
            _G.UIManager:GetInstance():ShowWindow(v)

            -- v.enabled = true
        end
        self.go_table.obj_Right_hl:SetActiveE(0)
        if self.call ~= nil then
            self.call()
        end
        self:Close()
        _G.Events:GetInstance():Broadcast(_G.eTeam.TeamYulan)
    elseif name == "@_aorbtn_help" then
    elseif name == "@_aorbtn_L" then
        self:NewData(true)
    elseif name == "@_aorbtn_R" then
        self:NewData(false)
    elseif self.clickFunction[name] then
        _G.AudioManager.OnSoundPlay(self.clickFunction[name].audio)
        self.clickFunction[name].CallFunction(self, go, isOn)
    elseif go == self.go_table.aorbtn_info then
        self:OnClick_OpenPropView()
    elseif name == "@_aorbtn_GuanBiItem" then
        self.go_table.aorimage_xinxi:SetActiveE(0)
