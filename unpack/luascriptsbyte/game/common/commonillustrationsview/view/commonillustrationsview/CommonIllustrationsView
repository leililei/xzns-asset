function CommonIllustrationsView:AssignLv()
    ---@param data fight.i_fight_arg
    local data = {}
    local attacker_team = {}
    data.attacker_team = {}
    data.attacker_team[1] = attacker_team
    data.sid = _G.ConfigManager.illustrations_card_cfg[self.CardData.sid].try_game

    attacker_team.lv = _G.PlayerModel:GetLevel()
    attacker_team.name = _G.PlayerModel:GetName()
    attacker_team.team_num = 1
    attacker_team.fighter_type = 0
    attacker_team.fights = {}
    local fights = {}
    attacker_team.stone_av_lv = 0
    local num = 4
    if _G.ConfigManager.monster_group_cfg[data.sid].DefaultAttackerSids[2] == 0 then
        num = 2
    end
    attacker_team.fights[1] = fights
    fights.index = num
    fights.sid = self.CardData.sid
    fights.lv = self.CardData.lv
    fights.skin_id = self.NowPutSkin[self.NowPutSkinIndex]
    fights.order = self.card_cfg_Data.Order
    fights.attrs = self.CardData.NowSumProp.attribute
    fights.attrs.speed = self.card_cfg_Data.Speed
    fights.attrs.power = self.CardData.power
    fights.skills = {}
    for key, value in pairs(self.CardData.Skills) do
        _G.table.insert(fights.skills, value)
    end

    fights.star = self.CardData.star
    fights.soul_state = self.CardData.soulLink_IsActivate
    fights.soul_chain_lv = self.CardData.soulLink_lv
    local scene = data.sid
    self.type = _G.EBattleType.TryPlay
    _G.BattleManager:GetInstance():EnterFight(
        _G.BattleControllerType.TryPlay,
        scene,
        true,
        _G.ConfigManager.monster_group_cfg[data.sid].DefaultAttackerSids,
        _G.ConfigManager.monster_group_cfg[data.sid].DefaultDefenserSids,
        data,
        self.type,
        nil
    )

    --_G.BattleManager:GetInstance():BeginTryPlayBattle()
end

