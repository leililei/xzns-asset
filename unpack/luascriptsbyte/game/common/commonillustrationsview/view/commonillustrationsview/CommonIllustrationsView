function CommonIllustrationsView:onDragBegin(go, ed)
    self.startMousePos = ed.position.x
end

function CommonIllustrationsView:onDragEnd(go, ed)
    local offset = ed.position.x - self.startMousePos
    if _G.math.abs(offset) < 1 then
        return
    end
    if offset < 0 then
        if self.NowPutSkinIndex + 1 > #self.NowPutSkin then
        else
            self:ShowNew(self.NowPutSkinIndex + 1)
            self:StartLoadRoleScene()
        end
    else
        if self.NowPutSkinIndex - 1 >= 0 then
            self:ShowNew(self.NowPutSkinIndex - 1)
            self:StartLoadRoleScene()
        end
    end
end

