--加载角色
function CommonIllustrationsView:LoadRoleScene(rolepath, callback, str)
    self.strId = str
    self.YanChiDianJi = true
    self:RoleRecycle()
    require("CardInfoManager").GetRole(
        rolepath,
        _G.ePoolType.Temporary,
        self.sceneTrans,
        _G.RoleEffTypeEnum.RoleShow,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoself LoadRoleScene")
                end
                return
            end

            self.AnimComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(trans)
            self.State = self.AnimComponent.animator.cullingMode
            self.AnimComponent.animator.cullingMode = _G.CS.UnityEngine.AnimatorCullingMode.AlwaysAnimate
            _G.GameUtil.SetActiveByCondition(trans, true)
            trans:SetParentE(self.sceneTrans)

            trans:SetLocalPosition(0, 0, 0)
            self.roleTrans = trans

            local card_show_cfg = _G.ConfigManager.card_show_cfg
            local myCard_show_cfg = card_show_cfg[str or self.CardData.sid]

            if str then
                myCard_show_cfg = _G.ConfigManager.card_show_cfg[str]
            end
            if myCard_show_cfg == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("card_show_cfg 未找到配置 sid:" .. self.CardData.sid)
                end
            end

            self.myCard_show_cfg = myCard_show_cfg

            -- --设置  缩放
            local Scale = myCard_show_cfg.Size1 > 0 and myCard_show_cfg.Size1 or 1
            trans:SetLocalScale(Scale, Scale, Scale)
            self:InitRotPos()
            self:Init_Drag()
            self.ZeDang = true
            if callback then
                callback(trans)
            end
            self.YanChiDianJi = false
        end
    )
end

