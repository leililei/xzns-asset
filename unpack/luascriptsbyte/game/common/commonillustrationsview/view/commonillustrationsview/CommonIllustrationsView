function CommonIllustrationsView:SpiritualItemNew()
    self.DQYeMian = 2
    self.go_table.obj_move_L:SetActiveE(0)
    self.go_table.obj_Right_lq:SetActiveE(1)
    self.go_table.obj_goldInfo:SetActiveE(0)
    self:ButImage()
    if self.IsChat then
        local spiritualBar = self.CardData.SpiritualBar
        if _G.table.isEmptyOrNil(spiritualBar) then
            self.go_table.aorbtn_attrib:SetActiveE(0)
        else
            local unlockData = _G.ConfigManager.discrete_cfg[114001] or {}
            for index, _ in pairs(unlockData[1]) do
                local obj = self.go_table["obj_node_" .. index]
                local tb = _G.GetAutoGoTable(obj)
                local data = spiritualBar[index]
                tb.trans_effect:RemoveAllChildren()
                if data and data.cfg.Icon then
                    tb.aorrawimage_icon:LoadImage(
                        data.cfg.Icon,
                        function()
                            tb.aorrawimage_icon:SetActiveE(1)
                        end
                    )
                    local order = data:GetOrder()
                    self:CreateEffect(order, tb.trans_effect)
                    tb.aorimage_orderBg.SpriteName = _G.ItemSpiritualQuailty[order]
                else
                    tb.aorimage_orderBg.SpriteName = _G.ItemSpiritualQuailty[0]
                end

                _G.SetEventTrigger(obj, "onClick", _G.handlerbind(self, self.OnClickSpiritualItem, data))
            end
        end
    else
        local spirituals = self.illustrationsCaedData.spiritual
        if not _G.table.isEmptyOrNil(spirituals) then
            for index, sid in pairs(spirituals) do
                local obj = self.go_table["obj_node_" .. index]
                local tb = _G.GetAutoGoTable(obj)
                local cfg = _G.ConfigManager.spiritual_cfg[sid]
                tb.aorrawimage_icon:LoadImage(
                    cfg.Icon,
                    function()
                        tb.aorrawimage_icon:SetActiveE(1)
                    end
                )
                self:CreateEffect(cfg.Order, tb.trans_effect)

                local data = {
                    sid = sid,
                    index = index,
                    star = cfg.Star,
                    level = _G.ConfigManager.spiritual_star_cfg[100 + cfg.Star].level_limit
                }
                local spiritual = _G.SpiritualData.New()
                spiritual:Parse(data)
                self.CardData:PutOnSpiritual(spiritual)
                tb.aorimage_orderBg.SpriteName = _G.ItemSpiritualQuailty[cfg.Order]
                _G.SetEventTrigger(obj, "onClick", _G.handlerbind(self, self.OnClickSpiritualItem, spiritual))
            end
        else
            self.go_table.aorbtn_attrib:SetActiveE(0)
        end
    end
end

