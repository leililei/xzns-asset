function CommonIllustrationsView:Skill()
    local skillIdArr = {}
    local skillId
    local cardSid = self.card_cfg_Data.id
    skillId = self.CardData.Skills.skill_1
    if skillId == 0 then
        skillId = cardSid + 1 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_3
    if skillId == 0 then
        skillId = cardSid + 3 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_4
    if skillId == 0 then
        skillId = cardSid + 4 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_5
    if skillId == 0 then
        skillId = cardSid + 5 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    local objArr = {}
    local obj
    for i = 1, #skillIdArr do
        obj = self:SkillInfo(self.go_table["obj_skill" .. i], skillIdArr[i], i)
        if obj ~= nil then
            table.insert(objArr, obj)
        end
    end
    ---用于点击技能提示
