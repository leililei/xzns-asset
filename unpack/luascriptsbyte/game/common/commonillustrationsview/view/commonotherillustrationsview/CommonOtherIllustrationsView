function CommonOtherIllustrationsView:Skill()
    local skillIdArr = {}
    local skillId
    local cardSid = self.CardData.sid
    skillId = self.CardData.Skills.skill_1
    if skillId == 0 then
        skillId = cardSid + 1 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_3
    if skillId == 0 then
        skillId = cardSid + 3 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_4
    if skillId == 0 then
        skillId = cardSid + 4 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_5
    if skillId == 0 then
        skillId = cardSid + 5 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    local objArr = {}
    local obj
    for i = 1, #skillIdArr do
        obj = self:SkillInfo(self.go_table["obj_skill" .. i], skillIdArr[i], i)
        if obj ~= nil then
            table.insert(objArr, obj)
        end
    end
    ---用于点击技能提示
    self.SkillIdArr = skillIdArr
    --- Y轴调整  策划要曲线
    local yArr = {
        [1] = {-130.3},
        [2] = {-130.3, -130.3},
        [3] = {-130.3, -130.3, -130.3},
        [4] = {-130.3, -130.3, -130.3, -130.3}
    }
    --- X轴调整  策划要曲线
    local XArr = {
        [1] = {255},
        [2] = {208, 308},
        [3] = {155, 255, 355},
        [4] = {108, 208, 308, 408}
    }
    local yS = yArr[#objArr]
    local xS = XArr[#objArr]
    for i = 1, #objArr do
        objArr[i]:SetAnchorPosition(xS[i], yS[i])
    end
end

---@param skillID number _<0 为未解锁该技能
function CommonOtherIllustrationsView:SkillInfo(obj, skillID, index)
    local isShow = false
    if skillID > 0 then
        isShow = true
    else
        skillID = _G.math.abs(skillID)
    end
    local go_table = _G.GetAutoGoTable(obj)
    if go_table == nil then
        return
    end

    if go_table.SkillClick == nil then
        go_table.aorbtn_skill.onClick:AddListener(_G.handlerbind(self, self.OnClick_Skill, index))
        go_table.SkillClick = true
    end

    local nowskillCfg = _G.ConfigManager.card_skills_cfg[skillID]
    if nowskillCfg == nil then
        _G.GameUtil.SetActiveByCondition(go_table.gameObject:GetParent(), false)
        return
    end
    if nowskillCfg then
        -- if string.IsNullOrEmpty(nowskillCfg.skill_type) == false then
        -- require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skilltype, nowskillCfg.skill_type)
        -- end
        --图标

        ---先设置技能是否灰
        go_table.aorrawimage_skill.color = isShow == false and self.SkillOff or self.SkillOn
        go_table.aorrawimage_skill.Alpha = 0
        require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skill, nowskillCfg.icon)
        --等级
        go_table.aortext_skilllevel.text = nowskillCfg.level
        go_table.aorrawimage_skilltype.Alpha = 0

        go_table.aorimage_nuqi:SetActiveE(nowskillCfg.skill_pos == 1 and 1 or 0)
    else
        isShow = false
        ---设置技能是否灰
        go_table.aorrawimage_skill.color = isShow == false and self.SkillOff or self.SkillOn
    end
    --锁隐藏
    _G.GameUtil.SetActiveByCondition(go_table.obj_skilllock, not isShow)

    --等级显示
    _G.GameUtil.SetActiveByCondition(go_table.aorimage_skilllevel, isShow)
    -- --有该技能才显示技能图标
    _G.GameUtil.SetActiveByCondition(go_table.gameObject:GetParent(), true)
    return go_table.gameObject
end
function CommonOtherIllustrationsView:TimerStop_AssignLv(ishideBtn)
    if self.Timer_AssignLv ~= nil then
        self.Timer_AssignLv:Stop()
        self.Timer_AssignLv = nil
    end
    if ishideBtn and self.go_table ~= nil then
        self.go_table.aorbtn_assignLv:SetActiveE(0)
    end
end

function CommonOtherIllustrationsView:OnClick_Skill(skillindex)
    local skillid = self.SkillIdArr[skillindex]
    if skillid == nil then
        return
    end
    skillid = _G.math.abs(skillid)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg[skillid]
    if skillid ~= 0 and card_skills_cfg ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(
            skillid,
            nil,
            card_skills_cfg.condition_star > self.CardData.lv_Old
        )
    end
end
function CommonOtherIllustrationsView:ShowProp()
    local showprop = {
        _G.AttrType.atk,
        _G.AttrType.max_hp,
        _G.AttrType.bre,
        _G.AttrType.def
    }
    local key, des, num
    local desColor = _G.Color.New(169 / 255, 171 / 255, 184 / 255, 1)
    local ziColor = _G.Color.New(208 / 255, 216 / 255, 255 / 255, 1)
    for i = 1, 4 do
        key = i * 2
        des = self.PropGo["aortext_ (" .. (key - 1) .. ")"]
        num = self.PropGo["aortext_ (" .. (key) .. ")"]

        des.color = desColor
        des.text = showprop[i].des
        num.color = ziColor
        num.text = self.illustrationsCaedData.attrs[showprop[i].key]
    end
end
