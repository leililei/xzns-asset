function CommonOtherIllustrationsView:OnCreate(data, call)
    if data == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("数据为空")
        end
        return
    end

    self.call = call
    ---当前展示卡牌数据
    self.card_cfg_Data = {}
    ---@type fight.i_fight_fighter
    self.illustrationsCaedData = {}

    self.card_cfg_Data = require "CardCommentManager":GetInstance():CardData(data.sid, false)
    self.illustrationsCaedData = data
    ---判断数据是否初始化
    self.go_Shuxing_Init = false
    ---判断当前页面显示为魂链还是属性页面
    self.DQYeMian = 1
    self:JiaShuJu()
    self:PanDuanXianShi()
end

