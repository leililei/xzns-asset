    msg.sid = self.illustrationsCaedData.sid
    msg.lv = self.illustrationsCaedData.lv
    msg.awaken = 0
    msg.unlock = 0
    msg.uid = self.illustrationsCaedData.sid
    if self.card_cfg_Data.Order < 3 then
        msg.soul_chain_lv = 0
    else
        msg.soul_chain_lv = self.illustrationsCaedData.soul_chain_lv
    end
    msg.soul_state = self.illustrationsCaedData.soul_state
    msg.star = self.illustrationsCaedData.star

    self:ChuShiHua(msg)
    self.LvPropData = {}
    self.LvPropData = self.CardData.NowSumProp:GetAttrByName()
    --self:UpdataFight()
    if self.sceneTrans == nil then
        self:LoadEmbattleScene(
            function(sceneTrans)
                self:LoadRoleScene(
                    self.card_cfg_Data.ModelPathHi,
                    function(roleTrans)
                    end
                )
            end
        )
    else
        self:LoadRoleScene(
            self.card_cfg_Data.ModelPathHi,
            function(roleTrans)
            end
        )
    end

    if self.card_cfg_Data.Order < 2 then
        --self.go_table.toggle_skill:SetActiveE(0)
        --self.go_table.aorbtn_qh:SetActiveE(0)
        --self.go_table.toggle_shuxing.isOn = true

        if self.DQYeMian == 3 then
            self.DQYeMian = 1
        end

        self.go_table.obj_view:SetActiveE(1)
        self.go_table.obj_btn:SetActiveE(0)
    elseif self.card_cfg_Data.Order < 3 then
        self.go_table.obj_Right_hg:SetActiveE(0)

        if self.DQYeMian == 3 then
            self.DQYeMian = 1
        end
        if self.DQYeMian then
            self.go_table.obj_Right_hl:SetActiveE(0)
        end
        self.go_table.obj_btn:SetActiveE(1)

        self.go_table.aorbtn_hl:SetActiveE(0)
    else
        self.go_table.aorbtn_hl:SetActiveE(1)
        -- body
        --self.go_table.toggle_skill:SetActiveE(1)
        --if self.DQYeMian == 1 then
        --self.go_table.toggle_skill.isOn = false
        --self.DQYeMian = false
        --end
        self.go_table.obj_btn:SetActiveE(1)
    end
    if self.DQYeMian == 2 then
        if self.card_cfg_Data.Order < 3 then
            -- self.go_table.obj_Right_hl:SetActiveE(0)

            -- self.go_table.obj_move_L:SetActiveE(1)
            -- self.go_table.obj_Right_hg:SetActiveE(0)
            -- self.go_table.obj_view:SetActiveE(1)
            self:OnClickshuxingView()
        else
            self.go_table.obj_Right_hl:SetActiveE(1)
            self.lua_Right_Hl:ShowHunLian(self.CardData)
        end
    elseif self.DQYeMian == 1 then
        --self:ViewInitShuxing()
        self.go_table.obj_move_L:SetActiveE(1)
        self.go_table.obj_Right_hg:SetActiveE(0)
        self.go_table.obj_view:SetActiveE(1)
    elseif self.DQYeMian == 3 then
        --self:ViewInitShuxing()
        self.go_table.obj_move_L:SetActiveE(1)
        self.go_table.obj_Right_hg:SetActiveE(1)
        self.go_table.obj_view:SetActiveE(0)
        self:LiLianItemNew()
    end
    self:ButImage()
end
function CommonOtherIllustrationsView:ChuShiHua(msg)
    ---@type CardData
    self.CardData = _G.CardData.New()
    self.CardData:ParseInitMsg(msg)
    self.CardData:UpdateAttr()
    self.CardData.NowSumProp:OnInit(self.card_cfg_Data.Elements)
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attr = attributeManager:GetAttribtueClass(self.card_cfg_Data.Elements)
    ---职业树属性
    --local TreeAttr = require("PlayerTreeModel"):GetInstance():GetGrowProp(self.card_cfg_Data.Professional)
    attributeManager:AddAttribute(attr, self.CardData.BaseProp)
    --attributeManager:AddAttribute(attr, TreeAttr)
    --魂链 是否激活
    if self.card_cfg_Data.Order >= 3 then
        if self.CardData.soulLink_IsActivate == 1 then
            --require("CardHunLianModel"):GetInstance():InitCfgData(self.sid)

            local hunlian_exclusive =
                require("CardHunLianManger"):GetInstance():CalAttributeBase(
                self.CardData.sid,
                self.CardData.soulLink_lv
            )
            attributeManager:AddAttribute(attr, hunlian_exclusive)
            local hunlian_attribute =
                require("CardHunLianManger"):GetInstance():CalAttribute(self.CardData.sid, self.CardData.soulLink_lv)
            if not _G.table.isEmptyOrNil(hunlian_attribute) then
                attributeManager:AddAttribute(attr, hunlian_attribute)
            end
        end
    end

    --attributeManager:AddAttribute(attr, self.CardData:GetDecorationProp())
    attributeManager:AddAttribute(self.CardData.NowSumProp, attr)
    attributeManager:PutAttribtueClass(attr)
    self.CardData:CalculateRole()
    self.CardData:CalculatePower()
    self:BiaoTo()
    self:ShowCardInfo()
end
---按钮图片更换
function CommonOtherIllustrationsView:ButImage()
    local di, zi, isOn
    for i = 1, #self.btnKey do
        isOn = self.DQYeMian == i
        di = self.go_table["aorimage_" .. self.btnKey[i]]
        zi = self.go_table["aortext_" .. self.btnKey[i] .. "txt"]
        if di then
            di.SpriteName = isOn and self.uiDic.btndi.on or self.uiDic.btndi.off
            di:SetNativeSize()
        end
        if zi then
            zi.color = isOn and self.uiDic.ziColor.on or self.uiDic.ziColor.off
            zi.text = self.uiDic.ziText[self.btnKey[i]]
        end
    end
end

