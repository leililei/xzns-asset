                    -- )
                    -- local order = data:GetOrder()
                    --self:CreateEffect(order, tb.trans_effect)
                    --tb.aorimage_orderBg.SpriteName = _G.ItemSpiritualQuailty[order]
                    _G.ItemFactory:GetInstance():GetItemCard(
                        _G.ItemFactory.itemType.ItemSpiritualBase,
                        tb.obj_itemRoot,
