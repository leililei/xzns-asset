function CommonIllustrationsH5View:ShowSpiritualItem(NewData)
    if _G.table.isEmptyOrNil(NewData.SpiritualBar) then
        self.go_table.obj_baowu:SetActiveE(0)
    else
        self.go_table.obj_baowu:SetActiveE(1)
    end
end

function CommonIllustrationsH5View:ShowGemItem(NewData)
    local gemList = NewData.msg.gem_slot or {}
    for _, v in pairs(gemList) do
        if v.gem then
            local gem = require("GemstoneData").New()
            gem:Parse(v.gem)
            local tb = _G.GetAutoGoTable(self.go_table["obj_gemItem" .. v.index])
            _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemGemstoneBase,
                tb.obj_root,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    trans:ShowData(gem)
                end
            )
        end
    end
end
function CommonIllustrationsH5View:OpenArtifact()
    if _G.table.isEmptyOrNil(self.CardData.ArtifactBar) then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonTipView.Name,
