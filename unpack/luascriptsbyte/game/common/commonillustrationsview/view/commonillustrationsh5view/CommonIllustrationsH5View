            end
        end
    else
        local spirituals = self.illustrationsCaedData.spiritual
        if not _G.table.isEmptyOrNil(spirituals) then
            for index, sid in pairs(spirituals) do
                local obj = self.go_table["obj_node_" .. index]
                local tb = _G.GetAutoGoTable(obj)
                local cfg = _G.ConfigManager.spiritual_cfg[sid]
                -- tb.aorrawimage_icon:LoadImage(
                --     cfg.Icon,
                --     function()
                --         tb.aorrawimage_icon:SetActiveE(1)
                --     end
                -- )
                --self:CreateEffect(cfg.Order, tb.trans_effect)

                local data = {
                    sid = sid,
                    index = index,
                    star = cfg.Star,
                    level = _G.ConfigManager.spiritual_star_cfg[100 + cfg.Star].level_limit
                }
                local spiritual = _G.SpiritualData.New()
                spiritual:Parse(data)
                self.CardData:PutOnSpiritual(spiritual)
                --tb.aorimage_orderBg.SpriteName = _G.ItemSpiritualQuailty[cfg.Order]
                _G.ItemFactory:GetInstance():GetItemCard(
                    _G.ItemFactory.itemType.ItemSpiritualBase,
                    tb.obj_itemRoot,
                    function(item)
                        item:ShowData(spiritual)
                        item:SetSize(70)
                        item:ShowOrHideFrame(false)
                        item:HideLevel()
                        item.go_table.aorimage_BoundBg:SetActiveE(0)
                    end
                )
                _G.SetEventTrigger(obj, "onClick", _G.handlerbind(self, self.OnClickSpiritualItem, spiritual))
            end
        else
            --ZHJH-5587【燃烧远征】点击查看助战卡牌详情出现报错，返回野外后卡死
            --容错处理
            if self.go_table.aorbtn_attrib then
                self.go_table.aorbtn_attrib:SetActiveE(0)
            end
        end
    end
end

---@param spiritualData SpiritualData
function CommonIllustrationsH5View:OnClickSpiritualItem(go, isOn, spiritualData)
    if not spiritualData then
        return
    end
    local data = {}
    data.data = spiritualData
    data.isSelf = true
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, { data }, 3)
end

function CommonIllustrationsH5View:SpawnCard()
    self.go_table.obj_cardItem:ClearChildren()
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.baseBodyItem,
        self.go_table.obj_cardItem,
        function(itemLua)
            itemLua:ShowCardData(self.CardData, nil, true)
        end
    )
end

function CommonIllustrationsH5View:OnClick_OpenPropView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardPropTipsView.Name, self.CardData)
end

---按钮点击事件在这里派发
function CommonIllustrationsH5View:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_Close" or name == "@_aorbtn_close2" then
        if self.call ~= nil then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_Weapon" then
        self:OpenEquiip(EquipmentPart.Weapon)
    elseif name == "@_aorbtn_Head" then
        self:OpenEquiip(EquipmentPart.Head)
    elseif name == "@_aorbtn_Clothes" then
        self:OpenEquiip(EquipmentPart.Clothes)
    elseif name == "@_aorbtn_Shoes" then
        self:OpenEquiip(EquipmentPart.Shoes)
    elseif name == "@_aorbtn_Artifact" then
        self:OpenArtifact()
    elseif name == "@_aorbtn_info" then
        self:OnClick_OpenPropView()
    elseif name == "@_aorbtn_potential" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PotentialTipsView.Name, self.CardData)
    end
end

return CommonIllustrationsH5View
