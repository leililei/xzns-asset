---@class CommonIllustrationsH5View : UIBaseView	角色信息界面
---@field public go_table CardInfoView_GoTable GoTable
local CommonIllustrationsH5View = _G.BaseClass("CommonIllustrationsH5View", _G.UIBaseView)
local EquipmentPart = _G.EquipmentPart
local skin_cfg = _G.ConfigManager.skin_cfg
local language_package_cfg = _G.ConfigManager.language_package_cfg
local CardCommentManager = require "CardCommentManager":GetInstance()

function CommonIllustrationsH5View:Awake()
    self.illustrations_card_cfg = _G.ConfigManager.illustrations_card_cfg
    self.card_cfg = _G.ConfigManager.card_cfg
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
------@param  id number
---@param NewData CardData 其他玩家的卡
---@param showBtnTb table<number> 显示的页签
---@param showSkin number 皮肤id
function CommonIllustrationsH5View:OnCreate(
    Id,
    call,
    isQieHuanButtonClick,
    NewData,
    GHCall,
    Cards,
    IsChat,
    cardPage,
    showBtnTb,
    JieJiLuanDuo,
    showSkin)
    if Id == nil or self.card_cfg[Id] == nil then
        if _G.ConfigManager.skin_cfg[Id] then
            Id = _G.ConfigManager.skin_cfg[Id].card
            NewData.sid = Id
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("卡牌ID不正确")
            end
            return
        end
    end
    if self.illustrations_card_cfg[Id] == nil and NewData == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("图鉴中卡牌ID不正确")
        end
        return
    end
    if IsChat == nil then
        IsChat = false
    end
    self:GetWearItem()

    self.call = call
    self.IsChat = IsChat
    self.card_cfg_Data = {}
    self.illustrationsCaedData = {}
    self.card_cfg_Data = self.card_cfg[Id]
    self.illustrationsCaedData = self.illustrations_card_cfg[Id] or self.illustrations_card_cfg[114200000]
    self:JiaShuJu(NewData)
    self.EquipItem = {}
    if NewData then
        self:InitEquipmentItem(_G.handlerbind(self, self.ShowEquipmentItem, NewData))
        self:InitArtifactItem(_G.handlerbind(self, self.ShowArtifactItem, NewData))
        self:ShowSpiritualItem(NewData)
        self:ShowWearItem(NewData)
    end
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Gemstone) then
        self.go_table.obj_gemstone:SetActiveE(1)
        self:ShowGemItem(NewData)
    else
        self.go_table.obj_gemstone:SetActiveE(0)
    end
    self:SpawnCard()
    self:SpiritualItemNew()
    --如果打开了通用tips,要获取通用tips最上面的layer来算当前layer
    local commonTipsView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name)
    if commonTipsView then
        self.orderInLayer = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        local canvas = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        canvas.overrideSorting = true
        self.orderInLayer = commonTipsView.View.orderInLayer + 50
        canvas.sortingOrder = self.orderInLayer
    end
end

---@param CardData CardData
---创建一个假的cdrddata并且生成数据
function CommonIllustrationsH5View:JiaShuJu(CardData)
    ---@type  prop.i_card 数据
    local msg = {}
    msg.sid = self.illustrationsCaedData.id
    msg.lv = self.illustrationsCaedData.level
    msg.awaken = 0
    msg.unlock = 0
    msg.uid = self.illustrationsCaedData.id
    msg.attr_add = {}
    msg.soul_state = 1
    msg.star = self.illustrationsCaedData.star

    self:ChuShiHua(msg, CardData)
    self.LvPropData = {}
    self.LvPropData = self.CardData.NowSumProp:GetAttrByName()
end

function CommonIllustrationsH5View:ChuShiHua(msg, cardData)
    if cardData then
        self.CardData = cardData
        self.CardData:UpdateAttr()
        self.CardData.NowSumProp:OnInit(self.card_cfg_Data.Elements)
        local attributeManager = _G.AttributeClassManager:GetInstance()
        local attr = attributeManager:GetAttribtueClass(self.card_cfg_Data.Elements)
        attributeManager:AddAttribute(attr, self.CardData.BaseProp)
        self.go_table.aorbtn_potential:SetActiveE(cardData:GetIsPotential() and 1 or 0)

        --魂链 是否激活
        if self.card_cfg_Data.Order >= 3 then
            if self.CardData.soulLink_IsActivate == 1 then
                --require("CardHunLianModel"):GetInstance():InitCfgData(self.sid)

                local hunlian_exclusive =
                    require("CardHunLianManger"):GetInstance():CalAttributeBase(
                        self.CardData.sid,
                        self.CardData.soulLink_lv
                    )
                attributeManager:AddAttribute(attr, hunlian_exclusive)
                local hunlian_attribute =
                    require("CardHunLianManger"):GetInstance():CalAttribute(
                        self.CardData.sid,
                        self.CardData.soulLink_lv
                    )
                if not _G.table.isEmptyOrNil(hunlian_attribute) then
                    attributeManager:AddAttribute(attr, hunlian_attribute)
                end
            end
        end

        --天赋
        local talentAttr = self.CardData:GetTalentAttribute()
        attributeManager:AddAttribute(attr, talentAttr)

        ---装备属性
        attributeManager:AddAttribute(attr, self.CardData:GetEquipPropValueAll(), true)
        ---神器属性
        attributeManager:AddAttribute(attr, self.CardData:GetArtifactAttribute(), true)
        ---符文属性
        attributeManager:AddAttribute(attr, self.CardData:GetDecorationProp())
        attributeManager:AddAttribute(self.CardData.NowSumProp, attr)
        attributeManager:PutAttribtueClass(attr)
        self.CardData:CalculateRole()
        self.CardData:CalculatePower()
    else
        ---@type CardData
        self.CardData = _G.CardData.New()
        self.CardData:ParseInitMsg(msg)
        --皮肤默认原皮
        self.CardData:SetSkin(0)
        self.CardData:UpdateAttr()
        self.CardData.NowSumProp:OnInit(self.card_cfg_Data.Elements)
        local attributeManager = _G.AttributeClassManager:GetInstance()
        local attr = attributeManager:GetAttribtueClass(self.card_cfg_Data.Elements)
        ---职业树属性
        --local TreeAttr = require("PlayerTreeModel"):GetInstance():GetGrowProp(self.card_cfg_Data.Professional)
        attributeManager:AddAttribute(attr, self.CardData.BaseProp)
        --attributeManager:AddAttribute(attr, TreeAttr)
        --魂链 是否激活
        if self.card_cfg_Data.Order >= 3 then
            if self.CardData.soulLink_IsActivate == 1 then
                --require("CardHunLianModel"):GetInstance():InitCfgData(self.sid)

                local hunlian_exclusive =
                    require("CardHunLianManger"):GetInstance():CalAttributeBase(
                        self.CardData.sid,
                        self.CardData.soulLink_lv
                    )
                attributeManager:AddAttribute(attr, hunlian_exclusive)
                local hunlian_attribute =
                    require("CardHunLianManger"):GetInstance():CalAttribute(
                        self.CardData.sid,
                        self.CardData.soulLink_lv
                    )
                if not _G.table.isEmptyOrNil(hunlian_attribute) then
                    attributeManager:AddAttribute(attr, hunlian_attribute)
                end
            end
        end

        --天赋
        local talentAttr = self.CardData:GetTalentAttribute()
        attributeManager:AddAttribute(attr, talentAttr)

        --attributeManager:AddAttribute(attr, self.CardData:GetDecorationProp())
        attributeManager:AddAttribute(self.CardData.NowSumProp, attr)
        attributeManager:PutAttribtueClass(attr)
        self.CardData:CalculateRole()
        self.CardData:CalculatePower()
    end
    self:ShowCardInfo()
end

function CommonIllustrationsH5View:ShowCardInfo()
    self.PropGo = _G.GetAutoGoTable(self.go_table.obj_prop)
    self.SkillOff = _G.Color.New(87 / 255, 87 / 255, 87 / 255, 1)
    self.SkillOn = _G.Color.New(1, 1, 1, 1)
    self:ShowCardInfos(self.CardData)
end

---@param CardData CardData
function CommonIllustrationsH5View:ShowCardInfos(CardData, bl)
    self:ShowProp()
    local power =  string.lower(_G.UIUtils.NumberToUnitStr_CardFightNum(CardData.power, true))
    if _G.AppSetting.IsXzns then--星座用其他的位图字体显示战力，需要改一下文本内容来适配字体需求
        power = string.lower(power)
        if string.contains(power, ".") then
            local num = string.split(power, ".")
            power = num[1] .. "-" .. num[2]--小数点用-显示
        end
    end
    self.go_table.aortext_power.text = power
    local dingwei = ""
    local langid = tonumber(self.CardData.cfg.card_position1)
    if langid ~= 0 then
        dingwei = _G.LangUtil.GetLangPackValue(langid)
    end

    langid = tonumber(self.CardData.cfg.card_position2)
    if langid ~= 0 then
        dingwei = dingwei .. _G.LangUtil.GetLangPackValue(langid)
    end
    self.go_table.aortext_dingwei.text = dingwei
    self:Skill()
end

---获取穿戴item
function CommonIllustrationsH5View:GetWearItem()
    self.wearItemList = {}
    local tb
    for i = 1, 4 do
        tb = _G.GetAutoGoTable(self.go_table["obj_wearItem" .. i])
        tb.aorimage_icon.SpriteName = _G.RunePartsEnum[i]
        self.wearItemList[i] = tb
    end
end

---刷新穿戴的item
function CommonIllustrationsH5View:ShowWearItem(NewData)
    if NewData.DecorationBar then
        for part, v in pairs(NewData.DecorationBar) do
            self.wearItemList[part].obj_root:ClearChildren()
            if v and not _G.table.isEmptyOrNil(v.decoration) then
                self.wearItemList[part].obj_empty:SetActiveE(0)
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    { v.decoration.cfg.id },
                    self.wearItemList[part].obj_root,
                    function(tran)
                        if _G.IsNil(self.wearItemList[part].obj_root) then
                            _G.DestroyObject(tran.gameObject)
                            return
                        end

                        tran:ShowSlotLevel(v.slotLevel and v.slotLevel > 0, v.slotLevel)
                    end,
                    function()
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.RuneTipView.Name,
                            v.decoration,
                            v.decoration.cfg,
                            false,
                            self.cardData,
                            _G.handler(self, self.OnChangeCall),
                            false, true
                        )
                    end
                )
            else
                self.wearItemList[part].obj_empty:SetActiveE(1)
            end
        end
    end
end

function CommonIllustrationsH5View:Skill()
    local skillIdArr = {}
    local skillId
    local cardSid = self.card_cfg_Data.id
    skillId = self.CardData.Skills.skill_1
    if skillId == 0 then
        skillId = cardSid + 1 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_3
    if skillId == 0 then
        skillId = cardSid + 3 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_4
    if skillId == 0 then
        skillId = cardSid + 4 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_5
    if skillId == 0 then
        skillId = cardSid + 5 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    skillId = self.CardData.Skills.skill_8
    if skillId == 0 then
        skillId = cardSid + 8 * 100 + 1
        skillId = skillId * -1
    end
    table.insert(skillIdArr, skillId)

    local objArr = {}
    local obj
    for i = 1, #skillIdArr do
        obj = self:SkillInfo(self.go_table["obj_skill" .. i], skillIdArr[i], i)
        if obj ~= nil then
            table.insert(objArr, obj)
        end
    end
    ---用于点击技能提示
    self.SkillIdArr = skillIdArr
end

---@param skillID number _<0 为未解锁该技能
function CommonIllustrationsH5View:SkillInfo(obj, skillID, index)
    local isShow = true
    if skillID > 0 then
        isShow = true
    else
        skillID = _G.math.abs(skillID)
    end
    if obj == nil then
        return
    end
    local go_table = _G.GetAutoGoTable(obj)

    if go_table.SkillClick == nil then
        go_table.aorbtn_skill.onClick:AddListener(_G.handlerbind(self, self.OnClick_Skill, index))
        go_table.SkillClick = true
    end

    local nowskillCfg = _G.ConfigManager.card_skills_cfg[skillID]
    if nowskillCfg == nil then
        _G.GameUtil.SetActiveByCondition(go_table.gameObject, false)
        return
    end
    if nowskillCfg then
        -- if string.IsNullOrEmpty(nowskillCfg.skill_type) == false then
        -- require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skilltype, nowskillCfg.skill_type)
        -- end
        --图标

        ---先设置技能是否灰
        -- go_table.aorrawimage_skill.color = isShow == false and self.SkillOff or self.SkillOn
        -- go_table.aorrawimage_skill.Alpha = 0
        require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skill, nowskillCfg.icon)
        --等级
        go_table.aortext_skilllevel.text = nowskillCfg.level
        --go_table.aorrawimage_skilltype.Alpha = 0

        --名字
        go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(nowskillCfg.name1)

        go_table.aorimage_nuqi:SetActiveE(nowskillCfg.skill_pos == 1 and 1 or 0)
    else
        isShow = false
        ---设置技能是否灰
        --go_table.aorrawimage_skill.color = isShow == false and self.SkillOff or self.SkillOn
    end
    --锁隐藏
    go_table.obj_skilllock:SetActiveE(not isShow and 1 or 0)

    --等级显示
    go_table.aorimage_skilllevel:SetActiveE(isShow and 1 or 0)
    -- --有该技能才显示技能图标
    go_table.gameObject:GetParent():SetActiveE(1)
    return go_table.gameObject
end

function CommonIllustrationsH5View:OnClick_Skill(skillindex)
    local skillid = self.SkillIdArr[skillindex]
    if skillid == nil then
        return
    end
    skillid = _G.math.abs(skillid)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg[skillid]
    if skillid ~= 0 and card_skills_cfg ~= nil then
        require("CommonTipManager"):GetInstance():OpenSkillTip(
            skillid,
            nil,
            not require("CardInfoManager").CheckCardSkillIsUnlock(self.CardData, card_skills_cfg, true)
        )
    end
end

function CommonIllustrationsH5View:ShowProp()
    local showprop = {
        _G.AttrType.atk,
        _G.AttrType.max_hp,
        _G.AttrType.bre,
        _G.AttrType.def
    }
    local key, des, num
    for i = 1, 4 do
        key = i * 2
        des = self.PropGo["aortext_ (" .. (key - 1) .. ")"]
        num = self.PropGo["aortext_ (" .. (key) .. ")"]

        des.text = showprop[i].des
        num.text = self.CardData.NowSumProp:GetValueByID(showprop[i].ID)
    end
end

function CommonIllustrationsH5View:InitEquipmentItem(call)
    local factoryIns = _G.ItemFactory:GetInstance()
    local type = _G.ItemFactory.itemType.ItemEquipmentBase
    local count = 4
    local function InitEquipmentCall()
        count = count - 1
        if count <= 0 then
            call()
        end
        if count >= 4 then
            self.go_table.obj_Decoration:SetActiveE(0)
        end
    end
    self.EquipItem = {}
    ---@param item ItemEquipmentBase
    factoryIns:GetItemCard(
        type,
        self.go_table.obj_Weapon,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1.19)
            ---隐藏   不挡装备栏点击
            _G.GameUtil.SetActiveByCondition(item.go_table.aorbtn_Click, false)
            self.EquipItem[EquipmentPart.Weapon] = item
            InitEquipmentCall()
        end
    )
    factoryIns:GetItemCard(
        type,
        self.go_table.obj_Head,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1.19)
            ---隐藏   不挡装备栏点击
            _G.GameUtil.SetActiveByCondition(item.go_table.aorbtn_Click, false)
            self.EquipItem[EquipmentPart.Head] = item
            InitEquipmentCall()
        end
    )
    factoryIns:GetItemCard(
        type,
        self.go_table.obj_Clothes,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1.19)
            ---隐藏   不挡装备栏点击
            _G.GameUtil.SetActiveByCondition(item.go_table.aorbtn_Click, false)
            self.EquipItem[EquipmentPart.Clothes] = item
            InitEquipmentCall()
        end
    )
    factoryIns:GetItemCard(
        type,
        self.go_table.obj_Shoes,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1.19)
            ---隐藏   不挡装备栏点击
            _G.GameUtil.SetActiveByCondition(item.go_table.aorbtn_Click, false)
            self.EquipItem[EquipmentPart.Shoes] = item
            InitEquipmentCall()
        end
    )
end

function CommonIllustrationsH5View:ShowEquipmentItem(NewData)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local PropDic = AttributeClassManager:GetAttribtueClass(0, _G.PowerType.equipment)
    for i, v1 in pairs(NewData.EquipBar) do
        if self.EquipItem[i] then
            if table.isEmptyOrNil(v1) then
                self.EquipItem[i].gameObject:SetActiveE(0)
            else
                AttributeClassManager:AddAttribute(PropDic, v1.UPProp)
                AttributeClassManager:AddAttribute(PropDic, v1.prop)
                self.EquipItem[i].gameObject:SetActiveE(1)
                self.EquipItem[i]:ShowData(v1)
            end
        end
    end
end

function CommonIllustrationsH5View:OpenEquiip(EquipmentPart)
    local eqData = self.CardData.EquipBar[EquipmentPart]
    if _G.TableIsEmpty(eqData) then
        return
    else
        self:ShowEquipmentTipsItem(eqData)
    end
end

function CommonIllustrationsH5View:ShowEquipmentTipsItem(data)
    if _G.TableIsEmpty(data) then
        if _G.AppSetting.DEBUG then
            _G.LogError("CardInfoView:ShowEquipmentTipsItem  data = nil")
        end
        return
    end
    local msg = {}
    local data1 = {}

    ---true显示培养按钮  能强化 或 能重铸
    local isPy = false
    --if data.cfg.strengthen_level > 0 then
    --    isPy = true
    --elseif data.cfg.elements[1] ~= nil then
    --    isPy = true
    --elseif data.Grade >= 7 then --金色及以上品质可以洗练
    --    isPy = true
    --end

    local data2 = {}
    data2.data = data
    data2.isSelf = false
    data2.btn = {}

    if isPy == true then
        data2.btn.left = {}
        data2.btn.left.name = _G.LangUtil.GetLangPackValue(90023400005)
        data2.btn.left.func = _G.handlerbind(self, self.Strengthen, data)
    end

    --data2.btn.right = {}
    --data2.btn.right.name = _G.LangUtil.GetLangPackValue(90020400047)
    --data2.btn.right.func = _G.handlerbind(self, self.EquipReplace, data)

    if not table.isEmptyOrNil(self.CardData.EquipBar[data.cfg.parts]) then
        data1.data = self.CardData.EquipBar[data.cfg.parts]
        if data2.data.uid ~= data1.data.uid then
            data1.isSelf = true
            data1.btn = nil
            table.insert(msg, data1)
            table.insert(msg, data2)
        else
            data1.isSelf = false
            data1.btn = {}

            if isPy == true then
                data1.btn.left = {}
                data1.btn.left.name = _G.LangUtil.GetLangPackValue(90020400065)
                data1.btn.left.func = _G.handlerbind(self, self.Strengthen, data)
