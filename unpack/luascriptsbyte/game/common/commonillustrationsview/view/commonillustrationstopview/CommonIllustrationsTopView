--region 加载场景
-----加载场景
---@field camera _G.Camera
function CommonIllustrationsTopView:LoadEmbattleScene(callback)
    -- ---移动时间
    -- self.InfoMoveTime = 0.3
    ---相机坐标
    self.ControlCameraPosArr = {
        ---画面一
        [1] = {-1.54, 1.75, 7.55},
        ---画面二
        [2] = {-1.54, 1.75, 7.55}
    }
    ---相机旋转四元素
    self.ControlCameraQuaArr = {
        ---画面一
        [1] = {0.0003042822, 0.9812274, -0.00299644, 0.1928307},
        ---画面二
        [2] = {-0.0002933022, 0.9999844, -0.002997536, -0.004691169}
    }
    _G.PoolsManager:GetInstance():Spawn(
        _G.ConfigManager.ui_scens_cfg[2].Scene,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                _G.LogError(
                    "场景无法加载 path:" .. _G.ConfigManager.scene_cfg[2].Scene .. "    CardInfoView LoadEmbattleScene"
                )
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            ---固定位置 方便升星成功界面 显示模型
            -- ---设置初始相机
            self.ControlCamera = _G.GraphicsManager.Instance.CurrentVisualCamera
            local pos = self.ControlCameraPosArr[2]
            self.ControlCamera:SetPosition(pos[1], pos[2], pos[3])

            local qua = self.ControlCameraQuaArr[2]
            self.ControlCamera:SetRotation(qua[1], qua[2], qua[3], qua[4])
            trans:SetLocalPosition(900, 900, 0)
            local camera = self.ControlCamera:GetComponentE(_G.typeof(_G.CS.UnityEngine.Camera))
            camera.enabled = true
            self.sceneTrans = trans
            if callback then
                callback(trans)
            end
        end
    )
end

return CommonIllustrationsTopView
