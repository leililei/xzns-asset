---@class CommonGiftSecondView : UIBaseView	中文描述
---@field go_table CommonGiftSecondView_GoTable
local CommonGiftSecondView = _G.BaseClass("CommonGiftSecondView", _G.UIBaseView)
local MallManager = require("MallManager")

function CommonGiftSecondView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---@param args table {modelName,redPointName,RefreshListenerName,aorrawimage_TitleBg,aorrawimage_Bg,EffectPath}
--- model中必须实现 GetDataFromCfg() 方法初始化礼包数据
--- @param string modelName model名称
--- @param string redPointName 红点名称
--- @param string RefreshListenerName 监听礼包购买刷新的事件名称
--- @param string aorrawimage_TitleBg 标题路径
--- @param string aorrawimage_Bg 背景路径
--- @param string EffectPath 特效路径
--- @param string roleSpinePath 人物spine路径
function CommonGiftSecondView:OnCreate(call, args)
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]

    self.call = call

    self.modelName = args.modelName
    self.redPointName = args.redPointName
    self.RefreshListenerName = args.RefreshListenerName
    self.typeClass = require(self.modelName):GetInstance().typeClass
    self.model_cfg = require(self.modelName):GetInstance().model_cfg or {}

    ---@type _obj_MallListItems_GoTable
    self.MallListItems = GetAutoGoTable(self.go_table.obj_MallListItems)
    if args.aorrawimage_Bg then
        if self.go_table.aorrawimage_Bg then
            self.go_table.aorrawimage_Bg:LoadImage(args.aorrawimage_Bg)
        end
        if self.MallListItems.aorrawimage_Bg then
            self.MallListItems.aorrawimage_Bg:LoadImage(args.aorrawimage_Bg)
        end
    end
    if args.aorrawimage_TitleBg then
        if self.go_table.aorrawimage_TitleBg then
            self.go_table.aorrawimage_TitleBg:LoadImage(args.aorrawimage_TitleBg)
        end
        if self.MallListItems.aorrawimage_TitleBg then
            self.MallListItems.aorrawimage_TitleBg:LoadImage(args.aorrawimage_TitleBg)
        end
    end

    if args.roleSpinePath then
        if not self.roleSpine then
            require("CardInfoManager"):GetInstance().GetRole(
                args.roleSpinePath,
                _G.ePoolType.Temporary,
                self.go_table.obj_spine,
                nil,
                function(trans)
                    if _G.IsNil(self.go_table.obj_spine) then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.roleSpine = trans
                end
            )
        end
    end



    _G.Events:GetInstance():AddListener(self.RefreshListenerName, self.InitView, self)
    require("RedPointManager"):GetInstance():RefreshNode(self.redPointName)
    --self.go_table.aortext_time.text = _G.GetLangPackValue(90000011174)
    self:InitView()
    if args.EffectPath then
        self:InitEffect(args.EffectPath)
    end
end

function CommonGiftSecondView:InitView()
    -- require(self.modelName):GetInstance():GetDataFromCfg()
    self:UpdateView()
end

function CommonGiftSecondView:InitEffect(EffectPath)
    _G.UIUtils.LoadEffectByCfg(
        EffectPath,
        self.go_table.obj_EffNode,
        function(obj)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(obj)
                return
            end
        end
    )
end

function CommonGiftSecondView:UpdateView(updateFlag)
    self.infocfgsDown = require(self.modelName):GetInstance().model_cfg or {}
    if _G.AppSetting.IsXzns then
        self.specialGift = not self.specialGift and self.infocfgsDown[1] or self.specialGift
    end
    self:SortGiftData()
    if updateFlag then
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    else
        self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
    end
    self.infoCount = #self.infocfgsDown
end

function CommonGiftSecondView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsDown[index + 1]
    local tb = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    for i = 1, tb.obj_Root:GetChildCountE() do
        _G.DestroyImmediate(tb.obj_Root:GetChildE(0).gameObject)
    end
    for i = 1, #data.goods do
        local award = data.goods[i]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award,
            tb.obj_Root,
            function(item)
                if not self.go_table or tb.obj_Root:GetChildCountE() > #data.goods then
                    _G.DestroyImmediate(item.gameObject)
                end
                item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                local cfg = item.cfg or item.data.cfg
                item:ShowEffectOrder(cfg.ef_item == 1 and true or false)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, award[1])
            end
        )
    end

    local buyCount
    buyCount = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)

    local limit = data.count_limit or data.count
    tb.obj_free:SetActiveE(data.price <= 0 and (limit - buyCount) > 0 and 1 or 0)


    if (limit - buyCount) > 0 then
        tb.aorbtn_btnBuy:SetActiveE(1)
    else
        tb.aorbtn_btnBuy:SetActiveE(0)
    end

    local soldOut = limit == buyCount
    if limit - buyCount > self.limitTimesCond or soldOut then
        tb.aortext_limit:SetActiveE(0)
    else
        tb.aortext_limit:SetActiveE(1)
        local lang = data.type_reset == 1 and 90031400013 or 90021600042
        tb.aortext_limit.text = _G.LangUtil.TryGetLangValue(lang, limit - buyCount)
    end
    tb.aortext_name.text = data.name

    _G.GameUtil.AddDouYinIcon(tb.aorbtn_btnBuy, true, tb.aortext_price)
    _G.GameUtil.AddDouYinIcon(tb.aorbtn_btnBuy, true, tb.aortext_rmb)
    tb.obj_sellOut:SetActiveE(soldOut and 1 or 0)

    if _G.AppSetting.IsXzns then
        local isSpecial = self.specialGift and data == self.specialGift
        if soldOut == true then
            isSpecial = false
        end
        tb.aorimage_bg:SetActiveE(isSpecial and 0 or 1)
        tb.obj_Special:SetActiveE(isSpecial and 1 or 0)
        tb.aortext_SpecialName.text = data.name
    end
    tb.aortext_price:SetActiveE(0)
    tb.aorrawimage_price:SetActiveE(0)
    tb.aortext_rmb:SetActiveE(0)
    if data.price == 0 then
        tb.aortext_rmb:SetActiveE(1)
        tb.aortext_price.text = ""
        tb.aortext_rmb.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        tb.aortext_rmb:SetActiveE(1)
        tb.aortext_price.text = ""
        _G.GameUtil.SetPriceByChannel(data.price, tb.aortext_rmb)
    else
        tb.aortext_price:SetActiveE(1)
        tb.aorrawimage_price:SetActiveE(1)
        tb.aortext_rmb:SetActiveE(0)
        tb.aortext_price.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({ data.consume_type, data.price })
        if item then
            tb.aorrawimage_price:LoadImage(item.Icon)
        end
    end
end

function CommonGiftSecondView:OnClick_item(tb, isOn, data)
    local id = data.id or data.sid

    self.typeClass:Chongzhi(
        data,
        function()
            if self:IsNil() then
                return
            end
            self:UpdateView(true)
        end
    )
end

function CommonGiftSecondView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
end

function CommonGiftSecondView:OnMallCashListener()
    --更新礼包状态
    self:UpdateView(true)
    --刷新抽奖次数
    if self.call then
        self.call()
    end
end

---函数功能注释
function CommonGiftSecondView:SortGiftData(call)
    _G.SortList(
        self.infocfgsDown,
        function(data)
            local buyCount = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset) or 0
            local limit = data.count_limit or data.count
            local state = buyCount >= limit and 0 or 1
            local id = data.id or data.sid
            return state, -id
        end
    )
    if call then
        call()
    end
end

function CommonGiftSecondView:EscClose()
    self:CloseView()
end

function CommonGiftSecondView:CloseView()
    self:Close()
end

function CommonGiftSecondView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(self.RefreshListenerName, self.InitView, self)
    self:CloseView()
end

return CommonGiftSecondView
