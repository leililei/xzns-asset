local CS = _G.CS
local typeof = _G.typeof

--region item
local CommonAwardPreItem = _G.BaseClass("CommonAwardPreItem")
function CommonAwardPreItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
end
function CommonAwardPreItem:Show(data)
    self.gameObject:SetActiveE(1)
    local storageManager = _G.StorageManager:GetInstance()
    local item = storageManager:GetItemDataClass(data[1])
    if item then
        self.go_table.aortext_name.text = item:GetName()
    end
    storageManager:GetItemBaseViewNew(data, self.go_table.trans_itemroot)
    storageManager:GetItemBaseViewNew(data, self.go_table.trans_itemroot, _G.handler(self, self.OnItemShow))
end
function CommonAwardPreItem:OnItemShow(item)
    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    item.transform:SetLocalPosition(0, 0, 0)
end
--endregion
---@class CommonAwardPreView : UIBaseView	中文描述
---@field public go_table CommonAwardPreView_GoTable GoTable
local CommonAwardPreView = _G.BaseClass("CommonAwardPreView", _G.UIBaseView)
--_G.CommonAwardPreView = CommonAwardPreView

function CommonAwardPreView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param award table 奖励二维数组{{sid,num},{sid,num}}
function CommonAwardPreView:OnCreate(award)
    self.itemList = {}
    -- _G.table.insert(self.itemList, CommonAwardPreItem.New(self.go_table.obj_item))
    for i = 1, #award do
        local item = self:GetItem(i)
        item:Show(award[i])
    end
end

function CommonAwardPreView:EscClose()
    self:Close()
end

function CommonAwardPreView:GetItem(index)
    if index <= #self.itemList then
        return self.itemList[index]
    end
    local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.trans_content)
    local item = CommonAwardPreItem.New(obj)
    return item
end

---按钮点击事件在这里派发
function CommonAwardPreView:OnClickBtn(go)
    self:Close()
end

return CommonAwardPreView
