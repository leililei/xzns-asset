---@class FreeGiftManager : Singleton	免费礼包
---@filed timer Timer 刷新倒计时
local FreeGiftManager = _G.BaseClass("FreeGiftManager", _G.Singleton)

function FreeGiftManager:__init()
    self.giftFreeTbs = {}
    self.giftFunctions = {}
end
---释放
function FreeGiftManager:Dispose()
    self.giftFreeTbs = nil
    self.giftFunctions = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---@return FreeGiftManager FreeGiftManager
function FreeGiftManager:GetInstance()
    return self.super.GetInstance(self)
end

---增加免费礼包数据
---@param id FreeGiftID 免费赠礼id
---@param state boolean 当前奖励状态
---@param func fun() 领取奖励的方法
---@param redId number 刷新红点的id
---@param childId number 子功能id(如英雄秘典可以开多期)
function FreeGiftManager:Add(id, state, func, redId, childId)
    if not childId then
        childId = 1
    end
    if not self.giftFunctions[id] then
        self.giftFunctions[id] = {}
    end
    self.giftFunctions[id][childId] = {id = id, state = state, func = func, redId = redId, childId = childId}
    if not _G.IsNil(self.giftFreeTbs[id]) then
        self:Show(id, self.giftFreeTbs[id], childId)
    else
        self.giftFreeTbs[id] = nil
    end
end
---功能关闭后调用
function FreeGiftManager:Remove(id, childId)
    if not childId then
        childId = 1
    end
    if not self.giftFunctions[id] or self.giftFunctions[id][childId] then
        return
    end
    self.giftFunctions[id][childId] = nil
    if not _G.IsNil(self.giftFreeTbs[id]) then
        self:Show(id, self.giftFreeTbs[id], childId)
    end
end

---检测是否能领取免费礼包
function FreeGiftManager:CheckCanTake(id, childId)
    if not childId then
        childId = 1
    end
    if not self.giftFunctions[id] or not self.giftFunctions[id][childId] then
        return false
    end
    return not self.giftFunctions[id][childId].state
end

---更新显示
---@param id FreeGiftID 免费赠礼id
---@param obj UnityEngine.GameObject 物体
---@param childId number 子功能id
function FreeGiftManager:Show(id, obj, childId)
    if not self.giftFunctions[id] then
        return
    end
    if not childId then
        childId = 1
    end
    local data = self.giftFunctions[id][childId]
    if not data then
        return
    end
    ---@type _obj_freeGift_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGift, data))

    local isCan = not data.state
    go_table.aorimage_can:SetActiveE(isCan and 1 or 0)
    go_table.aorimage_no:SetGray(not isCan)
    go_table.aorimage_no:SetActiveE(isCan and 0 or 1)
    go_table.obj_redpoint:SetActiveE(isCan and 1 or 0)
    self.giftFreeTbs[id] = obj
end

---点击免费礼包
function FreeGiftManager:OnClickGift(_, _, data)
    if data.state then
        return
    end
    if data.func then
        data.func(
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                require "CommonTipManager".OpenCommonAwardView(msg)
                data.state = true
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(data.redId)
                require("RedPointManager"):GetInstance():RefreshNode(data.redId)
                self:Show(data.id, self.giftFreeTbs[data.id], data.childId)
            end
        )
    end
end

return FreeGiftManager
