--按钮点击对应的方法
local clickFunction = {
    --界面关闭
    ["@_aorbtn_colse"] = function(self, go)
        self:Close()
    end,
    ----------------------------------↑↑↑
    ["nilFnc"] = function(self, go)
        if _G.AppSetting.DEBUG then
            _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
        end
    end
}
---按钮点击事件在这里派发
function BaseTipsInfoView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if clickFunction[name] then
        clickFunction[name](self, go, isOn)
    else
        clickFunction["nilFnc"](self, go)
    end
end

return BaseTipsInfoView
