---@class SkillHyperView : UIBaseView	中文描述
---@field public go_table SkillHyperView_GoTable GoTable
local SkillHyperView = _G.BaseClass("SkillHyperView", _G.Component)

function SkillHyperView:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    --_G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --self.go_table.obj_DesItem:InstantiatE(self.gameObject)
end

function SkillHyperView:OnCreate()

end

---初始化时获取技能超链接对应的id
function SkillHyperView:Init(data, callFunction, posx, posy, isNarrow)
    self.dataTable = _G.ConfigManager.skill_link_cfg[data]
    self.rect = self.go_table.obj_info:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.desRect = self.go_table.obj_Describe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    if isNarrow then
        self.go_table.obj_Describe:SetRectTransformSize(372, 264)
    end
    -- self.rect:SetRectTransformOffsetMin(posx - 550.606, 620 - posy)
    self.rect:SetRectTransformOffsetMin(0, -posy)
    self:MakeDesItem(isNarrow)
end

function SkillHyperView:__init(transform, view)
    self.gameObject = transform
    self.view = view
end

function SkillHyperView:OnClickBtn(go, ison)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    end
end

---生成对应的超链接展示
function SkillHyperView:MakeDesItem(isNarrow)
    local desCount = #self.dataTable.noun
    for i = 1, desCount do
        local item = self.go_table.obj_DesItem:InstantiatE(self.go_table.trans_content)
        local itemTab = _G.GetAutoGoTable(item)
        if isNarrow then
            itemTab.transform:SetRectTransformSize(320, 264)
            itemTab.aortext_noun:SetRectTransformSize(320, 26)
            itemTab.aortext_des:SetRectTransformSize(248, 26)
            local layout = itemTab.obj_Bot:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.VerticalLayoutGroup))
            layout.padding.left = -64
        end
        itemTab.aortext_noun.text = _G.LangUtil.GetLangPackValue(self.dataTable.noun[i])
        itemTab.aortext_des.text = _G.LangUtil.GetLangPackValue(self.dataTable.explain[i])
        --计算文本量
        item:SetActiveE(1)
        self.testItem = itemTab
        if (i == desCount) then
            self.lastDesTab = itemTab
        end
        _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
            itemTab.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        )
    end

    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.trans_content
    )
    local _, contentHeight = self.go_table.trans_content:GetRectTransformSizeDelta()
    --超链接窗口最大300,加上85是因为底图上下有空白边缘
    contentHeight = contentHeight + 85 > 300 and 300 or contentHeight + 85
    self:ChangeSize(contentHeight)
end

function SkillHyperView:CloseTips()
    if self.callBack then
        self.callBack()
        self.callBack = nil
    end
    --只关超链接窗口
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Skill_Hyper)
end

---根据tip的文本量改变对应的大小
function SkillHyperView:ChangeSize(len)
    self.desRect:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Vertical,len)
end

function SkillHyperView:Dispose()
    self.go_table = nil
    self.dataTable = nil
    self.gameObject = nil
    self.view = nil
end

return SkillHyperView
