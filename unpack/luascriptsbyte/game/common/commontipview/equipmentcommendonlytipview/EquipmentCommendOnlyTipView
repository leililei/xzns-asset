---@class EquipmentCommendOnlyTipView : UIBaseView	中文描述
---@field public go_table EquipmentCommendOnlyView_GoTable GoTable
local EquipmentCommendOnlyTipView = _G.BaseClass("EquipmentCommendOnlyTipView", _G.Component)

function EquipmentCommendOnlyTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EquipmentCommendOnlyTipView:OnCreate()
end
---初始化界面
function EquipmentCommendOnlyTipView:Init(data)
    self.go_table.aortext_name.text = _G.GetLangPackValue(90020400107)
    self.cards = data
    self.go_table.scrollloopvectical_card:InitItemData(#data, _G.handler(self, self.RefreshList))
end

---@private
function EquipmentCommendOnlyTipView:RefreshList(index, obj)
	index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.gameObject:ClearChildren()
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        tb.gameObject,
        function(item)
            item:ShowCardData(self.cards[index], nil, true, true)
        end
    )
end

---按钮点击事件在这里派发
function EquipmentCommendOnlyTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" or name == "@_aorbtn_close" then
        self:CloseTips()
    end
end

function EquipmentCommendOnlyTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end

function EquipmentCommendOnlyTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
    --self.CoPool = {}
end

function EquipmentCommendOnlyTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

function EquipmentCommendOnlyTipView:EscClose()
    self:CloseTips()
end

return EquipmentCommendOnlyTipView
