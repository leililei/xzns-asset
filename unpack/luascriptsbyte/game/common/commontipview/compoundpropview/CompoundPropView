---@class CompoundPropView : Component	中文描述
local CompoundPropView = _G.BaseClass("CompoundPropView", _G.Component)

local CS = _G.CS
local typeof = _G.typeof
local table = _G.table
local tonumber = _G.tonumber

-- 详情滑动窗口一行的单位高度
local scrollrectUnitHeight = 125
-- 详情滑动窗口最大高度
local scrollrectMaxHeight = 125 * 2.5
-- 详情滑动列表一行的数量
local scrollrectRowNum = 4

---创建对象时,入口构造函数
function CompoundPropView:OnCreate()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.nameOutLine = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.rect = self.go_table.aorimage_itemBg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
end

---初始化礼包界面
---@param data TipBaseModel 礼包数据
function CompoundPropView:Init(data)
    self.itemTransDic = {}
    self.sid = data.sid
    self.data = data
    local order = data.cfg.Quality
    self.go_table.aortext_name.color = _G.GameUtil.GetColorByQuality(order)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
    --- @type CommonTipManager
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, data.cfg.Quality)
    local outLineColor = ctm:GetTipTypeNameOutLineColorByGrade(order)
    self.nameOutLine.OutlineColor = _G.ColorTools.FormatColorByString(outLineColor)
    self.go_table.aorrawimage_di:LoadImage(ctm:GetItemBgPathByGrade(order))
    self:RefreshBgEffect(data.cfg.Quality)
    -- ---@type UnityEngine.Component 彩色渐变框
    -- local component = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- if not _G.IsNil(component) then
    --     component.enabled = _G.GameUtil.IsGradientQuality(order)
    -- end

    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        self.go_table.aorrawimage_icon,
        function(item)
            item:Show(
                self.sid,
                function()
                end
            )
        end
    )
    self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(data.cfg.Describe)
    self.go_table.aortext_useName.text = _G.LangUtil.GetLangPackValue(data.cfg.title)
    self.go_table.aortext_haveCount.text = _G.tostring(_G.StorageManager:GetInstance():GetItemCountBySid(self.sid))

    ---根据合成的内容判断显示
    local UseParameter = data.cfg.UseParameter
    local itemSid = tonumber(UseParameter[1][2])
    local itemCfg = _G.ConfigManager.item_cfg[itemSid]
    if itemCfg then
        if itemCfg.Type1 == 4 or itemCfg.Type1 == 8 or itemCfg.Type1 == 9 then
            if itemCfg.UseType == _G.ItemUseType.ItemDrop or itemCfg.UseType == _G.ItemUseType.DrawCard then
                self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(20001000008)
            elseif itemCfg.UseType == _G.ItemUseType.GetProp or itemCfg.UseType == _G.ItemUseType.SelectProp or 
                    itemCfg.UseType == _G.ItemUseType.CardOptional
            then
                self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(20001000009)
            else
                self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(20001000007)
            end
            self:InitAwardData()
        else
            self.go_table.obj_Down:SetActiveE(0)
            self.go_table.aorimage_itemBg:SetRectTransformSize(420, 240)
        end
    else
        self.awardData = {}
        self.go_table.obj_Down:SetActiveE(0)
        self.go_table.aorimage_itemBg:SetRectTransformSize(420, 240)
    end

    -- 手动设置框体和详情中滑动窗口大小
    local row = _G.math.ceil(#self.awardData / scrollrectRowNum)
    local height = _G.math.min(row * scrollrectUnitHeight,scrollrectMaxHeight)
    self.go_table.scrollloopvectical_itemList:UpdateScrollRectHeight(height)
    local _, rectHeight = self.rect:GetRectTransformWidthHeight()
    self.rect:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Vertical, height + rectHeight)

    self.view:SetPos(self.rect, data.pos)
end

---刷新物体信息
function CompoundPropView:RefreshItem(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = require "BaseAwardNewItem".New(obj, nil, 83)
    end
    self.itemTransDic[instanceID]:ShowWithID(self.awardData[index])
    self.itemTransDic[instanceID].go_table.obj_property:SetActiveE(0)
end

---初始化奖励数据
function CompoundPropView:InitAwardData()
    self.awardData = {}
    local item_cfgItem = self.data.cfg
    local UseParameter = item_cfgItem.UseParameter
    local itemSid = tonumber(UseParameter[1][2])
    local itemCfg = _G.ConfigManager.item_cfg[itemSid]
    if not itemCfg then
        self.go_table.obj_Down:SetActiveE(0)
        self.go_table.aorimage_itemBg:SetRectTransformSize(420, 240)
        return
    end

    self.propertySum = 0
    if itemCfg.UseType == _G.ItemUseType.ItemDrop then
        ---@type drop_cfg
        local dropCfg = _G.ConfigManager.drop_cfg[tonumber(itemCfg.UseParameter[1][2])]
        if not _G.table.isEmptyOrNil(dropCfg.fixed_drop) then
            for _, v in pairs(dropCfg.fixed_drop) do
                table.insert(self.awardData, v)
            end
        end

        if not _G.table.isEmptyOrNil(dropCfg.content1) then
            for _, v in pairs(dropCfg.content1) do
                table.insert(self.awardData, v)
            end
        end

        if not _G.table.isEmptyOrNil(dropCfg.content2) then
            for _, v in pairs(dropCfg.content2) do
                table.insert(self.awardData, v)
            end
        end
    elseif itemCfg.UseType == _G.ItemUseType.ProgressChest then
        ---@type item_box_con_cfg
        local cfg = _G.ConfigManager.item_box_con_cfg[tonumber(itemCfg.UseParameter[1][1])]
        if cfg and cfg.rewards then
            for _, v in pairs(cfg.rewards) do
                table.insert(self.awardData, v)
            end
        end
    elseif itemCfg.UseType == _G.ItemUseType.DrawCard then
        ---@type lucky_pools_cfg
        local cfg = _G.ConfigManager.lucky_pools_cfg[tonumber(itemCfg.UseParameter[2][1])]
        if cfg then
            for i = 1, #cfg.cards do
                table.insert(self.awardData, { cfg.cards[i][1], 1, property = cfg.cards[i][3] })
                self.propertySum = self.propertySum + cfg.cards[i][3]
            end
            table.sort(self.awardData, function(l, r) 
                local lCfg = _G.ConfigManager.card_cfg[l[1]]
                local rCfg = _G.ConfigManager.card_cfg[r[1]]
                if lCfg.Elements ~= rCfg.Elements then
                    if lCfg.Elements == 6 then
                        return true
                    elseif rCfg.Elements == 6 then
                        return false
                    else
                        return lCfg.Elements < rCfg.Elements
                    end
                end
                if l.property ~= r.property then
                    return l.property < r.property
                end
                return l[1] < r[1]
            end)
        end
    else
        for _, v in pairs(itemCfg.UseParameter) do
            table.insert(self.awardData, v)
        end
    end

    self.go_table.scrollloopvectical_itemList:UpdateCount(#self.awardData)
end

---刷新背景特效
function CompoundPropView:RefreshBgEffect(quality)
    local effectPath = require("CommonTipManager"):GetInstance():GetItemBgEffectPathByGrade(quality)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )
end

function CompoundPropView:OnClickBtn()
    self.view:CloseTip(_G.TipType.Gift)
end

function CompoundPropView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
end

function CompoundPropView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
end

function CompoundPropView:EscClose()
    self.view:CloseTip(_G.TipType.Gift)
end

---销毁对象时,析构函数
function CompoundPropView:OnDestroy()
end

return CompoundPropView