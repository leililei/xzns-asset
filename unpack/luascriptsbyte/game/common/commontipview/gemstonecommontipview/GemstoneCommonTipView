---@class GemstoneCommonTipView : Component	中文描述
local GemstoneCommonTipView = _G.BaseClass("GemstoneCommonTipView", _G.Component)

function GemstoneCommonTipView:__init(transform, view)
    self.gameObject = transform
    self.view = view
    self.go_table = _G.GetAutoGoTable(self.gameObject,_G.handler(self, self.OnClickBtn))
end

function GemstoneCommonTipView:Init(param)
    self.data = param.data
    self.btn = param.btn
    if not self.data then
        self:Close()
        return
    end
    self:InitData()
    self:ShowAttr()
    self:ShowBtn()
end

function GemstoneCommonTipView:InitData()
    self.go_table.aortext_name.text = self.data:GetName()
    self.go_table.aortext_type.text = self.data:GetType()
    local text = self.go_table.obj_des:GetComponentE(_G.typeof(_G.CS.ExtendText))
    text.text = self.data:GetDesc()
    self.go_table.aortext_score.text = _G.GetLangPackValue(90000010923, string.AddColor(_G.GameUtil.NumberWY(_G.Mathf.RoundToInt(self.data:GetAttrScore())),"f8ea73"))
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemGemstoneBase,
        self.go_table.obj_root,
        function(trans)
            if not self.go_table then
                return
            end
            trans:ShowData(self.data, function()
            end)
        end
    )
end

function GemstoneCommonTipView:ShowAttr()
    local attr = self.data:GetBaseAttr()
    for key, v in pairs(attr) do
        for type, value in pairs(v) do
            local tb = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_attr, self.go_table.obj_baseAttr))
            tb.aortext_type.text = _G.AttrType[key].des
            if type == 1 then
                tb.aortext_value.text = _G.GameUtil.NumberWY(_G.Mathf.RoundToInt(value[3]))
            else
                tb.aortext_value.text = value[3] / 100 .. "%"
            end
        end
    end

    local extraAttr = self.data.cfg.extra_attribute
    local extraAttrList = require("GemstoneModel"):GetInstance():GetExtraAttrChangeLevel()
    local lastLevelIndex = 1
    for k, v in pairs(extraAttrList) do
        local tb = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_attrExtra, self.go_table.obj_extraAttr))
        local value = _G.GetLangPackValue(90022300026, v[1]) .. " "
        for _, attr in pairs(extraAttr) do
            value = value .. _G.AttrType[attr[1]].des
            local num = _G.tonumber(attr[3]) * (v[2] - (k == 1 and 0 or extraAttrList[k - 1][2])) / 10000
            if _G.AttrType[attr[1]].percentage == 1 then
                value = value .. _G.string.format("<color=#00721d>+ %s</color>", num / 100 .. "%")
            elseif attr[2] == "2" then
                value = value .. _G.string.format("<color=#00721d>+ %s</color>", num / 100 .. "%")
            else
                value = value .. _G.string.format("<color=#00721d>+ %s</color>", num)
            end
            value = value .. " "
        end
        tb.aortext_value.text = value
        if self.data:GetLevel() >= v[1] then
            tb.aortext_value.color = _G.ColorTools.FormatColorByString("ac5431")
            lastLevelIndex = k
        else
            tb.aortext_value.color = _G.ColorTools.FormatColorByString("6c605c")
        end
    end
    _G.DelayFrameDo(function()
        local x, _, z = self.go_table.obj_extraAttr:GetLocalPosition()
        self.go_table.obj_extraAttr:SetLocalPosition(x, (lastLevelIndex - 1) * 39, z)
    end)

    local randomAttr = self.data:GetRandomAttr()
    if not randomAttr or _G.table.count(randomAttr) == 0 then
        self.go_table.obj_random:SetActiveE(0)
    else
        self.go_table.obj_random:SetActiveE(1)
    end
    local cfg = _G.ConfigManager.gem_add_att_cfg
    for _, v in pairs(randomAttr) do
        local tb = _G.GetAutoGoTable(_G.InstantiateObject(self.go_table.obj_attr, self.go_table.obj_randomAttr))
        tb.aortext_type.text = _G.GetLangPackValue(cfg[v.sid].name)
        tb.aortext_value.text = v.value / 100 .. "%"
    end
end

function GemstoneCommonTipView:ShowBtn()
    if not self.btn then
        self.go_table.obj_btn:SetActiveE(0)
        return
    end
    if _G.type(self.btn.GoBtnCall) == "function" then
        self.go_table.aorbtn_go:SetActiveE(1)
    else
        self.go_table.aorbtn_go:SetActiveE(0)
    end
    if _G.type(self.btn.SwitchBtnCall) == "function" then
        self.go_table.aorbtn_switch:SetActiveE(1)
    else
        self.go_table.aorbtn_switch:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function GemstoneCommonTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:CloseTips()
    elseif go == self.go_table.aorbtn_go then
        self.btn.GoBtnCall()
        self:CloseTips()
    elseif go == self.go_table.aorbtn_switch then
        self.btn.SwitchBtnCall()
        self:CloseTips()
    end
end

function GemstoneCommonTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Gemstone)
end

return GemstoneCommonTipView