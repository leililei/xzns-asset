local base = require "SkillTipView"
---@class SkillAllHunLianTipView 魂链第一技能tips 提示
local SkillAllHunLianTipView = _G.BaseClass("SkillAllHunLianTipView", base)
_G.SkillAllHunLianTipView = SkillAllHunLianTipView

local OrderCfg = {
    [1] = {"Images/nArtifact/ui_sqzs_chengse", _G.ColorTools.FormatColorByString("ffdaac")}, --橙
    [2] = {"Images/nArtifact/ui_sqzs_hongse", _G.ColorTools.FormatColorByString("fcc0ae")}, --红
    [3] = {"Images/nArtifact/ui_sqzs_jinse", _G.ColorTools.FormatColorByString("8b6eae")} --金
}

local CS = _G.CS
local typeof = _G.typeof
---初始化界面
function SkillAllHunLianTipView:Init(data, callFunction, isHun)
    self.data = data.skillData
    self.callBack = callFunction
    self.skillData = data
    local skillData = self.data
    self.isSkillActive = data.isSkillActive
    self.count = 0
    self.skillCfg = _G.ConfigManager.card_skills_cfg
    self.go_table.obj_skillDescribe:GetComponentE(typeof(CS.UnityEngine.RectTransform)):SetPivotPosition(1, 0)
    self.Skill = _G.GetAutoGoTable(self.go_table.obj_Skill)
    _G.GameUtil.SetActiveByCondition(self.Skill.aorimage_skilllevel, data.lv > 0)
    self.Skill.aorrawimage_skill:LoadImage(skillData[1].icon)
    self.Skill.aortext_skilllevel.text = data.lv
    _G.GameUtil.SetActiveByCondition(self.Skill.aorimage_nuqi, skillData[1].skill_pos == 1)

    self.SkillDesExText = self.go_table.obj_SkillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.SkillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    if skillData[1].name1 > 0 and _G.LangUtil.GetLangPackValue(skillData[1].name1) then
        self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(skillData[1].name1)
        self.go_table.aortext_name.color = _G.ColorTools.FormatColorByString("f9eda7")
    else
        self.go_table.aortext_name.text = ""
    end
    if skillData[1].name2 > 0 and _G.LangUtil.GetLangPackValue(skillData[1].name2) then
        self.go_table.aortext_skillDescribe.text = _G.LangUtil.GetLangPackValue(skillData[1].name2)
        self.go_table.aortext_skillDescribe.color = _G.ColorTools.FormatColorByString("f9eda7")
    else
        self.go_table.aortext_skillDescribe.text = ""
    end

    if skillData[1].describe1 > 0 and _G.LangUtil.GetLangPackValue(skillData[1].describe1) then
        --技能描述
        if not self.isSkillActive[1].isLock and not skillData[1].skill_type ~= "Images/Icon/ui-jn-bar-heji" then
            --self.go_table.aortext_SkillDes.text =
            --    _G.LangUtil.GetLangPackValue(skillData[1].describe1) ..
            --    _G.string.AddColor("（" .. _G.LangUtil.GetLangPackValue(9002070022) .. "）", "ff5656")
            self.SkillDesExText.text =
                _G.LangUtil.GetLangPackValue(skillData[1].describe1) ..
                _G.string.AddColor("（" .. _G.LangUtil.GetLangPackValue(9002070022) .. "）", "ff5656")
        else
            --self.go_table.aortext_SkillDes.text = _G.LangUtil.GetLangPackValue(skillData[1].describe1)
            self.SkillDesExText.text = _G.LangUtil.GetLangPackValue(skillData[1].describe1)
        end
    else
        --self.go_table.aortext_SkillDes.text = ""
        self.SkillDesExText.text = ""
    end

    ---技能消耗
    local battleCfg = _G.ConfigManager.battle_skill_cfg[skillData[1].skills[1]]
    if battleCfg then
        self.go_table.aortext_consumNum.text = battleCfg.MPCost > 0 and battleCfg.MPCost or battleCfg.SPCost
    else
        self.go_table.aortext_consumNum.text = 0
    end
    self.isHun = isHun
    if isHun then
        self.go_table.obj_title:SetActiveE(1)
    else
        self.go_table.obj_title:SetActiveE(0)
    end
    self.go_table.aorrawimage_gradeBG:LoadImage(
        "Images/nArtifact/ui_sqzs_jinse02",
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end

            trans:SetActiveE(1)
        end
    )
    -- if _G.ConfigManager.card_cfg[skillData[1].card_id].UnitType == 1 then
    -- else
    -- end
    ---技能等级
    self:UpdateSkillDes(skillData, data.lv)


    self:UpdateLayout()
end
---更新技能描述
function SkillAllHunLianTipView:UpdateSkillDes(skillData, curLevel)
    local upDes = ""
    local count = #skillData
    local f = "　"
    if count <= 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lineDown, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollrect_content, false)
        return
    end
    for i = 2, count do
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/Common/CommonTipView/View/$_obj_skillItem",
            _G.ePoolType.Temporary,
            self.go_table.trans_content,
            function(trans)
                local tb = _G.GetAutoGoTable(trans)
                tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
                tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
                local color = "76daf8"
                if not self.isSkillActive[i].isLock then
                    color = "686989"
                end
                local id = skillData[i].name1
                local name = _G.LangUtil.TryGetLangValue(id)
                if not self.isSkillActive[i].isLock and self.skillData.isLock then
                    local str =
                        string.AddColor(name .. "：", color) ..
                        string.AddColor(_G.LangUtil.TryGetLangValue(skillData[i].describe1), color) ..
                            string.AddColor(
                                "（" .. _G.LangUtil.GetLangPackValue(90020300082, self.isSkillActive[i].isLockLv) .. "）",
                                "ff5656"
                            )
                    if i > 2 and (not self.isSkillActive[i - 1].isLock) then
                        str =
                            string.AddColor(name .. "：", color) ..
                            string.AddColor(_G.LangUtil.TryGetLangValue(skillData[i].describe1), color)
                    end
                    -- tb.aortext_upDes.text =
                    --     string.AddColor(name .. "：", color) ..
                    --     string.AddColor(_G.LangUtil.TryGetLangValue(skillData[i].describe1), color) ..
                    --         string.AddColor(
                    --             "（" .. _G.LangUtil.GetLangPackValue(90020300082, self.isSkillActive[i].isLockLv) .. "）",
                    --             "ff5656"
                    --         )
                    --tb.aortext_upDes.text = str
                    tb.DesExText.text = str
                else
                    tb.DesExText.text =
                        string.AddColor(name .. "：", color) ..
                        string.AddColor(_G.LangUtil.TryGetLangValue(skillData[i].describe1), color)
                    --tb.aortext_upDes.text =
                    --    string.AddColor(name .. "：", color) ..
                    --    string.AddColor(_G.LangUtil.TryGetLangValue(skillData[i].describe1), color)
                end
                if i == count then
                    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.trans_content)
                    local sizeDelta = _G.Vector2.New(self.go_table.trans_content:GetRectTransformSizeDelta())
                    local x = self.go_table.scrollrect_content:GetRectTransformSizeDelta()
                    self.go_table.scrollrect_content:SetRectTransformSize(x, math.min(sizeDelta.y + 3, 174))
                    self.go_table.obj_GameObject:SetRectTransformSize(100, math.min(sizeDelta.y + 3, 174))
                    if sizeDelta.y <= 174 then
                        self.go_table.scrollrect_content.enabled = false
                    end
                    self:UpdateLayout()
                end
            end
        )
    end
end

---打开超链接
function SkillAllHunLianTipView:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(tonumber(id), nil, weight, height)
end

return SkillAllHunLianTipView
