---@class WearCardListTipView : UIBaseView    中文描述
---@field public go_table WearCardListTipView_GoTable GoTable
local WearCardListTipView = _G.BaseClass("WearCardListTipView", _G.Component)

function WearCardListTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function WearCardListTipView:OnCreate()
end
---初始化界面
function WearCardListTipView:Init(storageType, data, itemData)
    if storageType == _G.StorageType.Spiritual then
        self.go_table.aortext_name.text = _G.GetLangPackValue(90022300125)
    elseif storageType == _G.StorageType.Artifact then
        self.go_table.aortext_name.text = _G.GetLangPackValue(90022300124)
    end
    self.storageType = storageType
    self.cards = data
    self.itemData = itemData
    -- 初始化    storageType 为 神器（_G.StorageType.Artifact） 对 data 排序，专属在前，

    if storageType == _G.StorageType.Spiritual or storageType == _G.StorageType.Artifact then
        _G.table.sort(self.cards, function(a, b)
            if a.power~=b.power then
                return a.power>b.power
            else
                if a.star~=b.star then
                    return a.star>b.star
                else
                    if a.lv~=b.lv then
                        return a.lv>b.lv
                    else
                        return a.uid>b.uid
                    end
                end
            end
        end)
    end
    if storageType == _G.StorageType.Spiritual or storageType == _G.StorageType.Artifact then
        self.go_table.scrollloopvectical_card1:InitItemData(#data, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_card:SetActiveE(0)
    else
        self.go_table.scrollloopvectical_card:InitItemData(#data, _G.handler(self, self.RefreshList))
        self.go_table.scrollloopvectical_card1:SetActiveE(0)
    end
end

---@private
function WearCardListTipView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb.obj_item:RemoveAllChildren()
    local cardData = self.cards[index]
    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_item,
            function(item)
                item:ShowCardData(cardData)
            end
    )
    if self.storageType == _G.StorageType.Spiritual or self.storageType == _G.StorageType.Artifact then
    --if false then

        --ZHJH-5832 改为只显示头像
        local haveNum = 0
        local needMaterial = 1
        local count = 0
        -- 头像下方展示文字设置
        -- 穿戴中
        tb.aortext_useText.text = _G.GetLangPackValue(90020400048)

        if self.storageType == _G.StorageType.Spiritual then
            local cfg = _G.ConfigManager.spiritual_star_cfg
            local curStar = 0
            for _, v in pairs(cardData.SpiritualBar) do
                if v.sid == self.itemData.sid then
                    curStar = v:GetStar()
                    break
                end
            end
            -- 头像下方当前灵契星级设置
            tb.aortext_num.text = _G.GetLangPackValue(90000010475, curStar + 1)
            needMaterial = cfg[curStar + 100 + 1].materials_oneself
            if curStar > 0 then
                needMaterial = needMaterial - cfg[100 + curStar].materials_oneself
            end

            local datas = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Spiritual, self.itemData.sid)
            for _, v in pairs(datas) do
                if v.star == 0 and v.lv==1 and (not v.cardUid or v.cardUid == 0) then
                    count = count + 1
                end
            end
            haveNum = count
        elseif self.storageType == _G.StorageType.Artifact then
            -- 判断是否为专属
            --local cardId = _G.ConfigManager.artifact_cfg[self.itemData.sid].card_id
            --if cardId == cardData.sid then
            --    tb.aortext_useText.text = _G.GetLangPackValue(90022300097)
            --end

            local curStar = cardData.ArtifactBar:GetStar()
            local cfg = _G.ConfigManager.artifact_star_cfg
            needMaterial = cfg[100 + curStar].materials_oneself or 0

            count = 0
            local datas = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Artifact, self.itemData.sid)
            for _, v in pairs(datas) do
                if v.star == 0 and v.lv==1 and (not v.cardUid or v.cardUid == 0) then
                    count = count + 1
                end
            end
            haveNum = count

            --头像下方当前神器星级设置/   镇魂街ZHJ-27879 Alpha_JT BUG合集ZHJ-34317  测试要求将未觉醒的神器加入快捷使用 将头像下方星级文字切换为觉醒
            if not cardData.ArtifactBar:IsMaxStar() then
                tb.aortext_num.text = _G.GetLangPackValue(90000010475, curStar + 1)
            else
                tb.aortext_num.text = _G.GetLangPackValue(90020300009)
                local awaken=cardData.ArtifactBar:GetAwaken()
                local awakencfg=_G.ConfigManager.artifact_awaken_cfg[awaken+101]
                if awakencfg then
                    needMaterial = awakencfg.materials_oneself
                else
                    needMaterial = 0
                end
            end
        end
        tb.slider_progress.value = haveNum / needMaterial
        tb.aortext_Slider.text = haveNum.. "/" .. needMaterial
    end
    tb.gameObject:SetActiveE(1)
end

---按钮点击事件在这里派发
function WearCardListTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" or name == "@_aorbtn_CloseView" then
        self:CloseTips()
    end
end

function WearCardListTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.WearCardList)
end

function WearCardListTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
end

function WearCardListTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

function WearCardListTipView:EscClose()
    self:CloseTips()
end

return WearCardListTipView
