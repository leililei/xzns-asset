---@class SkillTipView : UIBaseView	中文描述
---@field public go_table SkillTipView_GoTable GoTable
local SkillTipView = _G.BaseClass("SkillTipView", _G.Component)
local AffixColor = {
    "ff5656",
    "41ea91",
    "95e7ff"
}
local GetLangPackValue = _G.GetLangPackValue
local card_skills_cfg = _G.ConfigManager.card_skills_cfg
function SkillTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SkillTipView:OnCreate()
end
---初始化界面
function SkillTipView:Init(data, callFunction, isHun)
    self.data = data
    self.callBack = callFunction
    local skillId = self.data:GetStarSkill()
    local skillData = card_skills_cfg[skillId]
    self.count = 0
    self.go_table.obj_skillDescribe:GetComponentE(typeof(CS.UnityEngine.RectTransform)):SetPivotPosition(1, 0)
    self.Skill = _G.GetAutoGoTable(self.go_table.obj_Skill)
    --_G.GameUtil.SetActiveByCondition(self.Skill.aorimage_skilllevel, data.lv > 0)
    self.Skill.aorrawimage_skill:LoadImage(skillData.icon)
    self.Skill.aortext_skilllevel.text = data.lv
    if skillData.name1 > 0 and GetLangPackValue(skillData.name1) then
        self.go_table.aortext_name.text = GetLangPackValue(skillData.name1)
    else
        self.go_table.aortext_name.text = ""
    end
    if skillData.name2 > 0 and GetLangPackValue(skillData.name2) then
        self.go_table.aortext_skillDescribe.text = GetLangPackValue(skillData.name2)
    else
        self.go_table.aortext_skillDescribe.text = ""
    end
    local skillObj, tb, skillId
    for i = 1, self.data.Cfg.max_star + 1 do
        skillObj = _G.InstantiateObject(self.go_table.obj_skillitem, self.go_table.obj_SkillViewScroll)
        tb = _G.GetAutoGoTable(skillObj)
        local index = i -1
        skillId = self.data:GetSkillByStar(index)
        if card_skills_cfg[skillId] then
            tb.aortext_des.text = GetLangPackValue(card_skills_cfg[skillId].describe1)
        end
        if index == self.data:GetStar() then
            tb.aortext_des.color = _G.Color.New(162 / 255, 169 / 255, 218 / 255, 1)
        else
            tb.aortext_des.color = _G.Color.New(104 / 255, 105 / 255, 137 / 255, 1)
        end
        if index > 0 then
            tb.obj_Star:SetActiveE(1)
            --- 设置星级图片
            for j = 1, 5 do
                if j <= index then
                    _G.GameUtil.SetActiveByCondition(tb["aorimage_fire" .. j], true)
                else
                    _G.GameUtil.SetActiveByCondition(tb["aorimage_fire" .. j], false)
                end
                if index > self.data:GetStar() then
                    tb["obj_eff" .. j]:SetActiveE(0)
                else
                    tb["obj_eff" .. j]:SetActiveE(1)
                end
                --_G.GameUtil.SetActiveByCondition(tb["obj_eff" .. j], (not j > self.data:GetStar()))
            end
        else
            tb.obj_Star:SetActiveE(0)
        end
    end
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_SkillViewScroll:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    )
end

---按钮点击事件在这里派发
function SkillTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    end
end

function SkillTipView:CloseTips()
    if self.callBack then
        self.callBack()
        self.callBack = nil
    end
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.GeatherSoulSkill)
end

function SkillTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
    --self.CoPool = {}
end

function SkillTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
end

function SkillTipView:EscClose()
    self:CloseTips()
end

return SkillTipView
