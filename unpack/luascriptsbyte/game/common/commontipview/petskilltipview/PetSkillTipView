---@class PetSkillTipView : Component	中文描述
---@field public go_table obj_PetSkillTipView_GoTable GoTable
local PetSkillTipView = _G.BaseClass("PetSkillTipView", _G.Component)

local card_skills_cfg = _G.ConfigManager.card_skills_cfg
local GetLangPackValue = _G.GetLangPackValue
function PetSkillTipView:__init(trans,view)
    self.go_table=_G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
    self.go_base = _G.GetAutoGoTable(self.go_table.obj_PetDescribe, _G.handler(self, self.OnClickBtn))
    self.view=view
    _G.GameUtil.ReBuildRTF(self.go_base.gameObject)
    if self.go_base.obj_parent and self.go_base.obj_parent1 then
        _G.GameUtil.ReBuildRTF(self.go_base.obj_parent1)
        _G.GameUtil.ReBuildRTF(self.go_base.obj_parent)
    end
end
function PetSkillTipView:Init(data,isMax)
    self.data = data
    self.isMax=isMax and isMax or true
    self:ShowSkill()
end

---显示技能
function PetSkillTipView:ShowSkill()
    local cfg = self.data:GetCfg()
    self.starSkills = {}

    local baseSkillCfg = card_skills_cfg[cfg.skill_id[1]]
    self.go_base.aorrawimage_skill:LoadImage(baseSkillCfg.icon)

    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    self.go_base.aorimage_typeBg:SetActiveE(uiModel and 0 or 1)
    self.go_base.aorimage_typeBg1:SetActiveE(uiModel and 1 or 0)
    if uiModel then
        self.go_base.aortext_type1.text = _G.GetLangPackValue(cfg.professional + 90024900003)
    else
        self.go_base.aortext_type.text = _G.GetLangPackValue(cfg.professional + 90024900003)
    end
    self.go_base.aortext_petSkillName.text = GetLangPackValue(cfg.Name)
    local lanID, obj, tb
    for i = 1, 3 do
        lanID = cfg["pet_position" .. i]
        if lanID and lanID > 0 then
            obj = _G.InstantiateObject(self.go_base.obj_skillTagItem, self.go_base.obj_skillTagContent)
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            --tb.aorimage_bg.SpriteName = i == 1 and "ui_js_biaoqian_jnleixing" or "ui_js_biaoqian_zhanwei"
            tb.aortext_tagName.text = GetLangPackValue(lanID)
        local csf_tmp1 = tb.aortext_tagName:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter))
        _G.GameUtil.ReBuildRTF(tb.aortext_tagName)

        end
    end

    local skillDesExText = self.go_base.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text = _G.GetLangPackValue(cfg.skill_instruction[1])
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    for i = 1, #cfg.skill_id do
        _G.table.insert(self.starSkills, cfg.skill_id[i])
    end
    for i, skillId in ipairs(self.data.cfg.skill_id) do
        if i > 1 then
            _G.PoolsManager:GetInstance():Spawn(
                    "UIH5/Common/CommonTipView/View/$_obj_starSkillItem2",
                    _G.ePoolType.Temporary,
                    self.go_base.trans_content,
                    function(trans)
                        local tb = _G.GetAutoGoTable(trans)
                        local _cfg = _G.ConfigManager.card_skills_cfg[skillId]
                        tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
                        local color = self.data.star < (i - 1) and "A9A9A3" or "76DAF8"
                        tb.DesExText.color = _G.ColorTools.FormatColorByString(color)
                        tb.DesExText.text = _G.GetLangPackValue(_cfg.describe1)
                        tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
                        tb.aortext_star.text = i - 1
                    end
            )
        end
    end

    if #self.starSkills == 0 then
        self.go_base.obj_gap:SetActiveE(0)
        self.go_base.obj_skills:SetActiveE(0)
    end
    -- if not self.hideSP and self.go_base.obj_SPSkillDescribe ~= nil and cfg.card_id > 0 then
    --     self:ShowSPSkill(cfg)
    -- end
end

---点击超链接
function PetSkillTipView:OnHrefClick(id, name, asa)
    local rect = self.go_base.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY)
end

function PetSkillTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end

---按钮点击事件在这里派发
function PetSkillTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    end
end
return PetSkillTipView