local SkillTipView = require "SkillTipView"
---@class SkillHunLianTipsView : Component	中文描述
local SkillHunLianTipsView = _G.BaseClass("SkillHunLianTipsView", SkillTipView)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function SkillHunLianTipsView:OnCreate()
end

---销毁对象时,析构函数
function SkillHunLianTipsView:OnDestroy()
end

function SkillHunLianTipsView:Init(Data, callFunction)
    self.skillCfg = Data.card_sikll_cfg
    self.go_table.aorrawimage_Skill:LoadImage(self.skillCfg.icon)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.skillCfg.name1)
    self.go_table.aortext_name.color = _G.ColorTools.FormatColorByString("fcc0ae")

    self.skillDesEx = self.go_table.obj_SkillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.skillDesEx.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    self.skillDesEx.text = _G.LangUtil.GetLangPackValue(self.skillCfg.describe1)
    --self.go_table.aortext_SkillDes.text = _G.LangUtil.GetLangPackValue(self.skillCfg.describe1)
    self.go_table.aortext_skillDescribe.text = _G.LangUtil.GetLangPackValue(90020300187, self.skillCfg.level - 1)
    self.go_table.aortext_skillDescribe.color = _G.ColorTools.FormatColorByString("fcc0ae")
    --self:UpdateLayout()
    self.rect = self.go_table.obj_skill:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.go_table.aorrawimage_gradeBG:LoadImage(
        "Images/nArtifact/ui_sqzs_hongse02",
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
            trans:SetActiveE(1)
        end
    )
end
function SkillHunLianTipsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.view:CloseTip(_G.TipType.Skill_hunLian)
    end
end

---打开超链接
function SkillHunLianTipsView:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    height = height - 35
    require("CommonTipManager"):GetInstance():OpenSkillHyper(tonumber(id), nil, weight, height)
end
return SkillHunLianTipsView
