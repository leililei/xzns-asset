---@class PropTipView : Component    中文描述
---@field go_table _obj_PropTipView_GoTable
local PropTipView = _G.BaseClass("PropTipView", _G.Component)
local CommonTipManager = require "CommonTipManager"
local ZengyiTxt = 101112
function PropTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.nameOutLine = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline))
end
---创建对象时,入口构造函数
function PropTipView:OnCreate()
    self.rect = self.go_table.aorimage_itemBg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
end

---@param data2 TipBaseModel
function PropTipView:Init(data2, ...)
    self.other = { ... }
    local _zengyiTxt = ""
    self.data = data2
    local data = data2.cfg or data2.data.cfg
    local type = _G.StorageManager:GetInstance():CheckSidType(data2.sid or data2.data.sid)
    local sid = data2.sid or data2.data.sid
    local count = data2.count or data2.data.count

    ---@type number 物品品质
    local grade
    if type == _G.StorageType.Decoration then
        _G.StorageManager:GetInstance():GetItemBaseView(
                sid,
                count or 0,
                self.go_table.obj_root,
                function(item)
                    item.gameObject:SetLocalScaleXYZ(1)
                    item.gameObject:SetLocalPosition(0, 0, 0)
                end,
                function()
                end
        )
        local cfg = _G.ConfigManager.decoration_suit_cfg[data.suit]
        local attid = require "DecorationModel":GetInstance():GetGradeToValue(data.grade, cfg.att_suit2)
        if data.Type1 then
            self.go_table.aortext_haveCount.text = _G.StorageManager:GetInstance():GetItemCountByID(data.Type1, sid)
        else
            local _, storageId = _G.StorageManager:GetInstance():CheckSidType(sid)
            local PropData = _G.StorageManager:GetInstance():GetDatasBySid(storageId, sid)
            self.go_table.aortext_haveCount.text = _G.table.count(PropData)
        end
        self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.attribute_cfg[attid].describe)
        --_G.GameUtil.SetActiveByCondition(self.go_table.aortext_type, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_use, true)
        grade = data.Quality or data.grade
    else
        _G.StorageManager:GetInstance():GetItemBaseView(
                sid,
                count or 0,
                self.go_table.obj_root,
                function(item)
                    item.gameObject:SetLocalPosition(0, 0, 0)
                    item.gameObject:SetLocalScaleXYZ(1)
                    if type == _G.StorageType.Decoration then
                        --tb:ShowData(data2.data, _G.handler(self, self.OnClickBtn))
                        item.gameObject:SetLocalScaleXYZ(1)
                    else
                        --tb:Show(data.ID, _G.handler(self, self.OnClickBtn))
                    end
                end,
                function()
                end
        )
        --self.go_table.aortext_number.text = _G.GameUtil.NumberToUnitStr(data2.count)
        if self.other[1] then
            local ZengyiTable = _G.ConfigManager.discrete_cfg[ZengyiTxt]
            if not _G.table.isEmptyOrNil(ZengyiTable) then
                for i = 1, #ZengyiTable do
                    if ZengyiTable[i][1] == sid then
                        _zengyiTxt = "\n\n" .. _G.LangUtil.GetLangPackValue(ZengyiTable[i][2])
                    end
                end
            end
        end
        --self.go_table.aortext_typeName.text = _G.LangUtil.GetLangPackValue(_G.GameUtil.GetCurrencyTypeLanguageID(sid))
        if data.currency_type and data.currency_type == "vip_coin" then
            self.go_table.aortext_have:SetActiveE(0)
            self.go_table.aortext_haveCount.text = ""
        else
            local value = _G.tostring(_G.StorageManager:GetInstance():GetItemCountBySid(sid))
            -- 根据子ID或用户ID更新特定资源数量
            local otherValue = _G.StorageManager:GetInstance():GetOtherItemCountBySid(sid)
            if otherValue then
                value = otherValue
            end
            self.go_table.aortext_haveCount.text = value
        end
        self.go_table.aortext_des.text = data.Describe == nil and "" or _G.LangUtil.GetLangPackValue(data.Describe) .. _zengyiTxt

        if type == _G.StorageType.ResProp then
            --_G.GameUtil.SetActiveByCondition(self.go_table.aortext_type, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_use, true)
            --self.go_table.aortext_typeName.text =
            --    _G.LangUtil.GetLangPackValue(_G.GameUtil.GetCurrencyTypeLanguageID(sid))
            self.go_table.aortext_useName.text = _G.LangUtil.GetLangPackValue(data2.cfg.title)
        else
            local id = _G.GameUtil.GetItemTypeLanguageID(data.ID)
            --_G.GameUtil.SetActiveByCondition(self.go_table.aortext_type, id > 0)
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_use, id > 0 and data2.cfg.UseType ~= 5)
            if id > 0 then
                --self.go_table.aortext_typeName.text = _G.LangUtil.GetLangPackValue(id)
                self.go_table.aortext_useName.text = _G.LangUtil.GetLangPackValue(data2.cfg.title)
            end
        end
        grade = data.Quality or data.grade or data.quality
    end
    ---@type UnityEngine.Component 彩色渐变框
    -- local component = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- if not _G.IsNil(component) then
    --     component.enabled = _G.GameUtil.IsGradientQuality(grade)
    -- end

    local name = data.Name or data.name
    ---ZHJ-21478 【竞猜玩法】刻魂的名称显示的是1号位的，不是套装的
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.GuessBattleDetail.Name) then
        name = _G.ConfigManager.decoration_suit_cfg[data.suit].name
    end
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ArenPeakGroupStatisticsDetailView.Name) then
        name = _G.ConfigManager.decoration_suit_cfg[data.suit].name
    end
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(name)
    ---@type CommonTipManager
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, grade)
    ---@type UnityEngine.Component 彩色描边
    local outLineColor = CommonTipManager:GetInstance():GetTipTypeNameOutLineColorByGrade(grade)
    self.nameOutLine.OutlineColor = _G.ColorTools.FormatColorByString(outLineColor)
    self.go_table.aorrawimage_di:LoadImage(ctm:GetItemBgPathByGrade(grade))
    self.view:SetPos(self.rect, data2.pos)

    self:RefreshBgEffect(grade)
end
---销毁对象时,析构函数
function PropTipView:OnDestroy()
    self.other = nil
end
function PropTipView:OnClickBtn(go, isOn)
    if not go then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_close" then
        self.gameObject:SetActiveE(0)
        self.view:CloseTip(_G.TipType.Prop)
    end
end

---刷新背景特效
function PropTipView:RefreshBgEffect(quality)
    local effectPath = CommonTipManager:GetInstance():GetItemBgEffectPathByGrade(quality)
    ---没有特效的时候不加载，防止打印失败信息
    if effectPath == "" then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )
end

function PropTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
    --self.CoPool = {}
end

function PropTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.bgEffect = nil
end

function PropTipView:EscClose()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Prop)
end
return PropTipView
