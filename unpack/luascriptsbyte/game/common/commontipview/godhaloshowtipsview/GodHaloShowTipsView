local GodHaloShowTipsView = _G.BaseClass("GodHaloShowTipsView", _G.Component)


function GodHaloShowTipsView:Awake()
end

---界面的入口函数
---@param data god_halo_cfg
function GodHaloShowTipsView:OnCreate(data)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function GodHaloShowTipsView:Init(data)
    local cfg = _G.ConfigManager.god_halo_cfg
    for k, v in pairs(cfg) do
        if v.item_id == data.cfg.ID then
            self.curData = v
        end
    end

    --- 新需求 临时预览卡牌ID
    self.curCardID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)
    self:InitView()
end

---按钮点击事件在这里派发
function GodHaloShowTipsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" or name == "@_aorbtn_close" then
        self:CloseTips()
    end
end

