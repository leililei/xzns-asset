function GodHaloShowTipsView:GetIsNew(id)
    local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
    for i = 1, #newList do
        if newList[i] == id then
            return true
        end
    end
    return false
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function GodHaloShowTipsView:LoadRoleModel(rolepath, posIndex, scale, cfg)
    ---@type RecordRankListView._obj_info1_GoTable
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.go_table.trans_role)
            trans:SetLocalPosition(0, 0, 0)
            self.roleTrans = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local effCfg = self.curData.ui_effect_cfg
                local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                --- 神环路径，父级路径(加载角色的下面)
                _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                _G.UIUtils.LoadArtifacteffect(trans,cfg.id,nil,nil)
            end
        end
    )
end

function GodHaloShowTipsView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.GodHalo)
end

function GodHaloShowTipsView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function GodHaloShowTipsView:Dispose()
    self.go_base = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

function GodHaloShowTipsView:EscClose()
    self:CloseTips()
end

return GodHaloShowTipsView
