---@class VoucherDiscountTipView : Component    中文描述
---@field go_table _obj_RechargeAccumulate_GoTable
local VoucherDiscountTipView = _G.BaseClass("VoucherDiscountTipView", _G.Component)

function VoucherDiscountTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.nameOutLine = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline))
end

local Background = {
    [2001] = { "ImagesH5/hVoucherDiscount/ui_djqzkktc_jk", "ImagesH5/hVoucherDiscount/ui_djqzkktc_jk_kuang" },
    [2002] = { "ImagesH5/hVoucherDiscount/ui_djqzkktc_hjk", "ImagesH5/hVoucherDiscount/ui_djqzkktc_hjk_kuang" },
    [2003] = { "ImagesH5/hVoucherDiscount/ui_djqzkktc_bjk", "ImagesH5/hVoucherDiscount/ui_djqzkktc_bjk_kuang" }
}

function VoucherDiscountTipView:__init(transform, view, isBag)
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    self.isBag = isBag
end

---创建对象时,入口构造函数
function VoucherDiscountTipView:OnCreate()
    self.rect = self.go_table.aorrawimage_itemBg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
end

---@param data TipBaseModel
function VoucherDiscountTipView:Init(data, ...)
    self.data = data
    local sid = _G.tonumber(data.cfg.UseParameter[1][1])
    local cashCfg = _G.ConfigManager.item_accumulate_cfg[sid]
    self.cashCfg = cashCfg
    self.go_table.aorrawimage_itemBg:LoadImage(Background[sid][1])
    self.go_table.aorrawimage_outLine:LoadImage(Background[sid][2])
    self.go_table.obj_active:SetActiveE(self.isBag and 1 or 0)
    self.go_table.obj_notActive:SetActiveE(0)
    self.go_table.aortext_name.text = _G.GetLangPackValue(data.cfg.Name)
    local ratio = cashCfg.ratio_recharge / 10000
    if _G.GameUtil.GetIsUseChinese() then
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90034400030, math.floor(ratio * 10))
        self.go_table.aortext_tip2.text = _G.GetLangPackValue(90034400010, math.floor(ratio * 10))
    else
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90034400030, math.floor(ratio * 100))
        self.go_table.aortext_tip2.text = _G.GetLangPackValue(90034400010, math.floor(ratio * 100))
    end
    if self.isBag then
        self.go_table.aortext_playerName.text = _G.GetLangPackValue(90034400014, _G.GetPlayerName())
        self.go_table.aortext_playerUid.text = _G.GetLangPackValue(90034400015, _G.GetPlayerUid())
        self.countDown = data.args.time - _G.TimeUtil.GetServerUnixTime()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime(0)
    else
        local time = _G.TimeUtil.TranslateSecondForStr(cashCfg.duration * 86400)
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90022400004, _G.string.AddColor(time, "96CE51"))
    end
    if self.view.SetPos then
        self.view:SetPos(self.rect, data.pos)
    end
end

function VoucherDiscountTipView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    local time = _G.TimeUtil.TranslateSecondForStr(_G.Mathf.RoundToInt(self.countDown))
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(90000011689, _G.string.AddColor(time, "96CE51"))
end

function VoucherDiscountTipView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        local sortingOrder = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, sortingOrder + 50)
    end
end

function VoucherDiscountTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self.gameObject:SetActiveE(0)
        self.view:CloseTip(_G.TipType.RechargeAccumulate)
    elseif go == self.go_table.aorbtn_help then
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 212)
    end
end

function VoucherDiscountTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.bgEffect = nil
end

---销毁对象时,析构函数
function VoucherDiscountTipView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

function VoucherDiscountTipView:EscClose()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.RechargeAccumulate)
end
return VoucherDiscountTipView
