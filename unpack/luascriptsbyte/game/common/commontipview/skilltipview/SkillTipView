---更新界面大小
function SkillTipView:UpdateLayout()
    self.count = self.count - 1
    if self.count >= 0 then
        return
    end
    self.AllRect = {}
    self.AllContentF = self.transform:GetComponentsInChildren(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    for i = 0, self.AllContentF.Length do
        if i < self.AllContentF.Length then
            local rect = self.AllContentF[i]:GetComponentE(typeof(CS.UnityEngine.RectTransform))
            _G.table.insert(self.AllRect, rect)
        end
    end
    for i = 1, #self.AllRect do
        CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.AllRect[i])
    end
end
---@param cfg card_skills_cfg_Item
function SkillTipView:SetOtherSkill(go, cfg)
    local tb = _G.GetAutoGoTable(go)
    --local skill = {GO = go, Name = tb.aortext_name, Des = tb.aortext_SkillDes}
    local skill = {GO = go, Name = tb.aortext_name, Des = tb.obj_SkillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))}
    
    _G.table.insert(self.OtherSkills, skill)
    if cfg == nil then
        return
    end
    skill.Name.text = _G.LangUtil.GetLangPackValue(cfg.subtitle1) or ""
    if cfg.subtitle2 > 0 then
        skill.Des.text = _G.LangUtil.GetLangPackValue(cfg.subtitle2) or ""
    else
        skill.Des.text = ""
    end
    self:UpdateLayout()
end
---按钮点击事件在这里派发
function SkillTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    end
end

function SkillTipView:CloseTips()
    if self.callBack then
        self.callBack()
        self.callBack = nil
    end
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Skill)
end

function SkillTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
    --self.CoPool = {}
end

function SkillTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
end

function SkillTipView:EscClose()
    self:CloseTips()
end

---打开超链接
