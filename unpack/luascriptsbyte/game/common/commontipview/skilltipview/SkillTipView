---变身技能
function SkillTipView:UpdateChangeSkill(skillData)
    if #skillData[1].trans_skills > 0 then
        local transSkillCount = 1
        --#skillData[1].trans_skills
        local otherSkillCount = #self.OtherSkills
        self.count = self.count + transSkillCount - otherSkillCount
        self.go_table.obj_OtherSkill:SetActiveE(1)
        if #skillData[1].trans_skills > otherSkillCount then
            for i = otherSkillCount + 1, transSkillCount do
                local cfg = skillData[1]
                if cfg.subtitle1 > 0 and not string.IsNullOrEmpty(_G.LangUtil.GetLangPackValue(cfg.subtitle1)) then
                    _G.PoolsManager:GetInstance():Spawn(
                        "UI/Common/CommonTipView/$_obj_OtherskillDescribe",
                        _G.ePoolType.Default,
                        self.go_table.obj_OtherSkill,
                        function(trans)
                            self:SetOtherSkill(trans, skillData[1])
                        end
                    )
                end
            end
        end
        for i = 1, #self.OtherSkills do
            local cfg = skillData[1]
            if i > #skillData[1].trans_skills then
                if self.OtherSkills[i].GO:GetActiveSelf() == 1 or not _G.LangUtil.GetLangPackValue(cfg.subtitle1) then
                    self.OtherSkills[i].GO:SetActiveE(0)
                end
            else
                if not self.OtherSkills[i].GO:GetActiveSelf() == 1 then
                    self.OtherSkills[i].GO:SetActiveE(1)
                end
                self.OtherSkills[i].Name.text = _G.LangUtil.GetLangPackValue(cfg.subtitle1) or ""
                if cfg.subtitle2 > 0 then
                    self.OtherSkills[i].Des.text = _G.LangUtil.GetLangPackValue(cfg.subtitle2) or ""
                else
                    self.OtherSkills[i].Des.text = ""
                end
            end
        end
    else
        self.go_table.obj_OtherSkill:SetActiveE(0)
    end
end

---生成词缀
function SkillTipView:UpdateAffix(skillData)
    if _G.table.isEmptyOrNil(skillData[1].effect_unit) then
        self.go_table.aorimage_skillDetailDescribe:SetActiveE(0)
        return
    end
    self.go_table.aorimage_skillDetailDescribe:SetActiveE(1)
    if skillData[1].effect_unit then
        if #self.Affix < #skillData[1].effect_unit then
            self.count = self.count + #skillData[1].effect_unit - #self.Affix
            local count = #skillData[1].effect_unit - #self.Affix
            for i = 1, count do
                --  _G.ConfigManager.
                _G.PoolsManager:GetInstance():Spawn(
                    "UI/Common/CommonTipView/$_obj_skillDetailItem",
                    _G.ePoolType.Temporary,
                    self.go_table.aorimage_skillDetailDescribe,
                    function(trans)
                        local tb = _G.GetAutoGoTable(trans)
                        if _G.LangUtil.GetLangPackValue(skillData[1].effect_unit[i][1]) then
                            tb.aortext_Title.text =
                                string.AddColor(
                                _G.LangUtil.GetLangPackValue(skillData[1].effect_unit[i][1]),
                                AffixColor[skillData[1].effect_unit[i][3] + 1]
                            )
                            tb.aortext_Content.text = _G.LangUtil.GetLangPackValue(skillData[1].effect_unit[i][2])
                        --  tb.aorimage_titleBg.SpriteName = AffixBG[skillData[1].effect_unit[i][3] + 1]
                        end
                        _G.table.insert(
                            self.Affix,
                            {
                                GO = trans,
                                Tiltle = tb.aortext_Title,
                                Des = tb.aortext_Content,
                                TitleBG = tb.aorimage_titleBg
                            }
                        )
                        self:UpdateLayout()
                    end
                )
            end

            for i = 1, #self.Affix do
                if i > #skillData[1].effect_unit then
                    self.Affix[i].GO:SetActiveE(0)
                else
                    -- self.Affix[i].TitleBG.SpriteName = AffixBG[skillData[1].effect_unit[i][3] + 1]
                    self.Affix[i].GO:SetActiveE(1)
                    self.Affix[i].Tiltle.text =
                        string.AddColor(
                        _G.LangUtil.GetLangPackValue(skillData[1].effect_unit[i][1]),
                        AffixColor[skillData[1].effect_unit[i][3] + 1]
                    )
                    self.Affix[i].Des.text = _G.LangUtil.GetLangPackValue(skillData[1].effect_unit[i][2])
                end
            end
        end
    end
end
