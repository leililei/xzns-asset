local DecorationTipsItem = require "DecorationTipsItem"
---@class DecorationTipsView : Component	中文描述
local DecorationInfoTipsView = _G.BaseClass("DecorationInfoTipsView", _G.Component)
local decorationTipsItem = "UI/DecorationView/DecorationTipsPropItem"

function DecorationInfoTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
local iconPostion = {
    [1] = {x = -2, y = 1, z = 0},
    [2] = {x = -2, y = -1, z = 0},
    [3] = {x = 0.2, y = -1, z = 0},
    [4] = {x = 0.2, y = 1, z = 0}
}
---创建对象时,入口构造函数
function DecorationInfoTipsView:OnCreate()
end

---@param data DecorationData
function DecorationInfoTipsView:Init(data, callback)
    self.data = data
    self.callback = callback
    self.count = 0
    self:InitView()
end

function DecorationInfoTipsView:InitView()
    self.go_table.aorimage_Color2.SpriteName = _G.ItemBaseIconName_Decoration[self.data.Grade]
    self.go_table.aortext_decorationType.text = self.data:GetTxtParts()
    self.go_table.aorimage_Color.SpriteName = self.data:GetDecorationJiaoBiaoImage()
    local pos = iconPostion[self.data.cfg.parts]
    self.go_table.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    self.go_table.aorrawimage_Icon:LoadImage(self.data:GetIconPath())
    self.go_table.aortext_name.text = self.data:GetName()

    if self.data.streng > 0 then
        self.go_table.aortext_Lv.text = "+" .. self.data.streng
    else
        self.go_table.aortext_Lv.text = ""
    end
    if self.data.BindCardSid ~= 0 then
        -- local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.data.BindCardSid)
        -- self.go_table.aorrawimage_CardIcon:LoadImage(cardData.Icon)
        self.go_table.obj_Card:SetActiveE(1)
    else
        self.go_table.obj_Card:SetActiveE(0)
    end
    local prop = self.data:GetProp()
    local count = 1
    if self.data.streng > 0 then
        for i, v in pairs(prop.attriOther) do
            if v > 0 then
                local str = string.format("obj_BaseProp%d", count)
                if self.go_table[str] then
                    self.go_table[str]:SetActiveE(1)
                    v = Mathf.RoundToInt(v)
                    local tb = _G.GetAutoGoTable(self.go_table[str])
                    tb.aortext_Name.text = _G.AttrType[i].des
                    tb.aortext_Num.text = v
                    count = count + 1
                end
            end
        end
    else
        for i, v in pairs(prop.attriOther) do
            if v > 0 then
                local str = string.format("obj_BaseProp%d", count)
                if self.go_table[str] then
                    self.go_table[str]:SetActiveE(1)
                    v = Mathf.RoundToInt(v)
                    local tb = _G.GetAutoGoTable(self.go_table[str])
                    tb.aortext_Name.text = _G.AttrType[i].des
                    tb.aortext_Num.text = v
                    count = count + 1
                end
            end
        end
    end
    count = 1
    local index = 1
    local suiAttributeArray = self.data:AddAttributeToArray()
    self.count = self.count + #suiAttributeArray + 1
    for i = 1, #suiAttributeArray do
        local value = suiAttributeArray[i].value
        if value ~= 0 then
            value = _G.Mathf.RoundToInt(value * 100)
            _G.PoolsManager:GetInstance():Spawn(
                decorationTipsItem,
                _G.ePoolType.UIItem,
                (self.go_table.obj_basePropContent),
                function(tran)
                    if tran then
                        local tb = _G.GetAutoGoTable(tran)
                        tb.aortext_des.text = _G.AttrType[suiAttributeArray[i].key].des
                        if count <= self.data:GetPropUnlockCount() then
                            tb.aortext_value.text = "<color=#95e7ff>" .. value .. "%" .. "</color>"
                        else
                            local dCfg = _G.ConfigManager.discrete_cfg[102903][1]
                            tb.aortext_value.text =
                                string.format(_G.LangUtil.GetLangPackValue(90022300026), dCfg[index])
                        end
                        count = count + 1
                    end
                    index = index + 1
                    self:RebuildContent()
                end
            )
        end
    end
    --套装 显示 图标 套装效果描述
    local cfg = _G.ConfigManager.decoration_suit_cfg[self.data.cfg.suit]
    local attCfg = _G.ConfigManager.attribute_cfg
    if cfg then
        --饰品套装 图标
        self.go_table.aorrawimage_suiticon:LoadImage(self.data:GetIconPath())
        --4件套效果（读attribute_cfg表；按品质蓝#紫#橙#红#金依次激活对应等级技能）
        local attid = require "DecorationModel":GetInstance():GetGradeToValue(self.data.Grade, cfg.att_suit2)
        local des2 = attCfg[attid].describe
        des2 = _G.LangUtil.GetLangPackValue(des2)
        self.go_table.aortext_des.text = des2
        self.go_table.aortext_sign.text = self.data.Grade - 2
        self:RebuildContent()
    end
end

---强制刷新界面
function DecorationInfoTipsView:RebuildContent()
    self.count = self.count - 1
    if self.count > 0 then
        return
    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_basePropContent)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_randomPropContent)
end

function DecorationInfoTipsView:SetLockImage(isLock)
    if not isLock then
        self.go_table.aorimage_icon_lock.SpriteName = "ui_sp_icon_kaisuo"
    else
        self.go_table.aorimage_icon_lock.SpriteName = "ui_sp_icon_suozhu"
    end
end

function DecorationInfoTipsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.view:CloseTip(_G.TipType.Decoration)
    elseif go == self.go_table.aorbtn_suittips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationSuitTipsView.Name, self.data)
    end
end

function DecorationInfoTipsView:__init(transform, view)
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.view = view
end

return DecorationInfoTipsView
