---tip初始化
---@param data EquipmentTipModel
function EquipmentTipView:Init(data, commends)
    if data == nil then
        return
    end
    self.count = 0
    self.equipmentData = data.equip
    self.cfg = _G.ConfigManager.equipment_cfg
    self.EquipList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    self.SelectedEquipUid = 2
    self.Affix = {}
    self.isUpdateLayout = true
    self.isSelf = data.uid ~=data.sid
    self.isShow = false
    self:ShowEquipmentInfo()
    -- if not self.isShow then
    --
    -- end
    local showCommend = commends and #commends > 0
    self.go_table.obj_commends:SetActiveE(showCommend and 1 or 0)
    --self.go_table.obj_empty3:SetActiveE(showCommend and 1 or 0)
    --self.go_table.obj_empty4:SetActiveE(showCommend and 1 or 0)
    if showCommend then
        self.cards = commends
        self.go_table.scrollloophorizontal_card:InitItemData(#commends, _G.handler(self, self.RefreshList))
    end

    self.go_table.obj_randomProp:SetActiveE(self.equipmentData.Grade >= 7 and 1 or 0)
    self.go_table.aortext_randomProp:SetActiveE((self.equipmentData.Grade >= 7 and not self.isSelf) and 1 or 0)
    self:UpdateLayout()
end

---@private
function EquipmentTipView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.gameObject,
            function(item)
                item:ShowCardData(self.cards[index], nil, true, true)
            end
    )
end

function EquipmentTipView:UpdateLayout()
    self.count = self.count - 1
    if self.count > -1 then
        return
    end
    self.AllContentF = self.transform:GetComponentsInChildren(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    self.AllRect = {}
    for i = 0, self.AllContentF.Length - 1 do
        local rect = self.AllContentF[i]:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        _G.table.insert(self.AllRect, rect)
    end
    for i = 1, #self.AllRect do
        CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.AllRect[i])
    end
    self.isUpdateLayout = false
end

