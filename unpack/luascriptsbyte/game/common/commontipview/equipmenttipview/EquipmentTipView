function EquipmentTipView:SetBasePropData(tran, data, index)
    local tb = _G.GetAutoGoTable(tran)
    table.insert(
            self.BaseProp,
            {
                Go = tran,
                Name = tb.aortext_des,
                num = tb.aortext_value,
                icon = tb.aorrawimage_icon
            }
    )
    self.BaseProp[index].Name.text = _G.AttrType[data.key].des
    local num = data.value
    --  self.BaseProp[index].icon:LoadImage(_G.ConfigManager.type_attribute_cfg[_G.AttrType[data.name].ID].icon)
    if _G.AttrType[data.key].percentage == 1 then
        num = num * 100
        num = _G.Mathf.RoundToInt(num)
        num = tostring(num) .. "%"
    else
        num = tostring(num)
    end
    self.BaseProp[index].num.text = num
    self:UpdateLayout()
end

---刷新背景特效
function EquipmentTipView:RefreshBgEffect(quality)
    local effectPath = CommonTipManager:GetInstance():GetItemBgEffectPathByGrade(quality)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )
end

