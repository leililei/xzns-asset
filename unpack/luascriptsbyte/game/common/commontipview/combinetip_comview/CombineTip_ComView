local SkillTipView = require "SkillTipView"
---@class CombineTip_ComView : Component	中文描述
local CombineTip_ComView = _G.BaseClass("CombineTipView", SkillTipView)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function CombineTip_ComView:OnCreate()
end

---销毁对象时,析构函数
function CombineTip_ComView:OnDestroy()
end
function CombineTip_ComView:Init(Data, callFunction)
    self.skillCfg = Data.skillData.cardSkillCfg
    self.go_table.aorrawimage_skill:LoadImage(self.skillCfg.icon)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(self.skillCfg.name1)
    self.go_table.aortext_SkillDes.text = _G.LangUtil.GetLangPackValue(self.skillCfg.describe1)
    local card_sids = Data.skillData.cardssids
    local icon1 = _G.ConfigManager.card_cfg[card_sids[1]].Icon
    local icon2 = _G.ConfigManager.card_cfg[card_sids[2]].Icon
    self.go_table.aorimage_head1.SpriteName = icon1
    self.go_table.aorimage_head2.SpriteName = icon2
    --self:UpdateLayout()
end
function CombineTip_ComView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.view:CloseTip(_G.TipType.Combine)
    end
end
return CombineTip_ComView
