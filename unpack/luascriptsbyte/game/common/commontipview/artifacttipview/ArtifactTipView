    end
end

---获取技能描述
function ArtifactTipView:GetSkillDes(index, id)
    if card_skills_cfg[id] then
        return GetLangPackValue(90022300084, string.format("<color=#5ecfa7>%s",index), "</color>" .. GetLangPackValue(card_skills_cfg[id].describe1))
    else
        return GetLangPackValue(90022300084, string.format("<color=#5ecfa7>%s</color>",index), "</color>" .. id)
    end
