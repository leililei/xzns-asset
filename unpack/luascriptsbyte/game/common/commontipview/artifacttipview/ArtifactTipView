---展示属性
---@param data ArtifactData
function ArtifactTipView:ShowPropByCfg(data)
    local attrDic = data:GetAttrDict()
    local numStr, num, tb, tran, key, showList
    local showProp = function(prop)
        showList = {}
        for i, v in pairs(prop) do
            _G.table.insert(showList, {key = v[1], sortId = _G.AttrType[v[1]].sortid, num = v[2], isPer = v[3]})
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        local index = 0
        for _, v in pairs(showList) do
            index = index + 1
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                if index % 2 == 0 then
                    tb.aorimage_Bg:SetActiveE(1)
                end
                tb.aortext_Name.text = _G.AttrType[key].des
                num = v.num
                if _G.AttrType[key].percentage == 1 or v.isPer then
                    num = num * 100
                    num = _G.GameUtil.FormatNum(num)
                    num = tostring(num) .. "%"
                    numStr = num
                else
                    num = _G.math.floor(num)
                    num = _G.GameUtil.NumberWY(num)
                    numStr = num
                end
                tb.aortext_Num.text = "<color=#6effc6>" .. numStr .. "</color>"
            end
        end
    end
    showProp(attrDic.base)
    showProp(attrDic.other)
end

---设置属性(弃用)
---@param data ArtifactData
function ArtifactTipView:ShowProp(data)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local numStr, num, tb, tran, key, showList
    local showProp = function(prop, isPer)
        showList = {}
        for i, v in pairs(prop) do
            if v > 0 then
                table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid})
            end
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        for _, v in pairs(showList) do
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[key].des
                num = prop[key]
                if _G.AttrType[key].percentage == 1 or isPer then
                    num = num * 100
                    num = _G.GameUtil.FormatNum(num)
                    num = tostring(num) .. "%"
                    numStr = "<color=#6effc6>" .. num .. "</color>"
                else
                    num = _G.math.floor(num)
                    num = _G.GameUtil.NumberWY(num)
                    numStr = tostring(num)
                end
                tb.aortext_Num.text = numStr
            end
        end
    end

    local prop = data.attribute:GetAttrByName()
    showProp(prop)
    prop = data.attribute:GetAttrByName(_G.AttCountType.basePercent)
    showProp(prop, true)
end

---@private
function ArtifactTipView:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

---按钮点击事件在这里派发
function ArtifactTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    end
end

function ArtifactTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end

---刷新背景特效
function ArtifactTipView:RefreshBgEffect(quality)
    local effectPath = CommonTipManager:GetInstance():GetItemBgEffectPathByGrade(quality)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )
end

function ArtifactTipView:CloseRes()
    if self.go_table.obj_bgEffect then
        self.go_table.obj_bgEffect:RemoveAllChildren()
    end
    self.go_table.trans_content:RemoveAllChildren()
    self.go_table.obj_PropContent:RemoveAllChildren()
    self.go_table.obj_item:RemoveAllChildren()
end

function ArtifactTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
    --self.CoPool = {}
end

function ArtifactTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
    self.bgEffect = nil
end

function ArtifactTipView:EscClose()
    self:CloseTips()
end

return ArtifactTipView
