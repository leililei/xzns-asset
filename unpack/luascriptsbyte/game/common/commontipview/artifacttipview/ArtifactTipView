---初始化界面
---@param data ArtifactData
---@param btn table {left = {name = string, func = function, close = boolean},right = {...}, middle = {...}}
function ArtifactTipView:Init(data, btn, hideCount, hideSP)
    self:CloseRes()
    hideSP = hideSP or false
    self.hideSP = hideSP
    self.data = data
    self.btn = btn
    self:ShowBase(hideCount)
    -- self:ShowProp(data)
    self:ShowPropByCfg(data)
    self:ShowSkill()
    self:ShowBtn()
    _G.GameUtil.ReBuildRTF(self.go_table.obj_ArtifactlDescribe)
    local order = data.cfg.Order + 4
    if order == 7 then
        order = 8
    end
    local outlineColor = _G.ColorTools.FormatColorByString(CommonTipManager:GetTipTypeNameOutLineColorByGrade(order))
    local ctm = require"CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject,order)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_level:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    local effNode = self.go_table.obj_bgEffect and self.go_table.obj_bgEffect or self.go_table.obj_EffNode
    local backBg = self.go_table.aorrawimage_di and self.go_table.aorrawimage_di or self.go_table.aorrawimage_gradeBG
    local path = ctm:GetItemBgPathByGrade(order)
    backBg:LoadImage(path)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[CommonTipManager:GetItemBgEffectPathByGrade(order)],
            effNode
    )

    ---@type UnityEngine.Component 彩色描边
    local outLineColor = ctm:GetTipTypeNameOutLineColorByGrade(order)
    self.nameOutLine.OutlineColor = _G.ColorTools.FormatColorByString(outLineColor)
    if self.go_table.obj_content then
        self.go_table.obj_content:SetLocalPositionToZero()
    end
end

