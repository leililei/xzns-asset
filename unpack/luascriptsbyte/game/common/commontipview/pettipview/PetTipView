---初始化界面
---@param data PetData
---@param btn table {left = {name = string, func = function, close = boolean},right = {...}, middle = {...}}
function PetTipView:Init(data, isMax, isNarrow, isBottom)
    if self.go_table.obj_PetTipItem then
        self.go_base = _G.GetAutoGoTable(self.go_table.obj_PetTipItem, _G.handler(self, self.OnClickBtn))
    elseif self.go_table.obj_PetDescribe then
        -- 适配宠物技能界面
        self.go_base = _G.GetAutoGoTable(self.go_table.obj_PetDescribe, _G.handler(self, self.OnClickBtn))
    else
        self.go_base = self.go_table
    end
    self.data = data
    self.isNarrow = isNarrow
    self.isBottom = isBottom
    self:ShowBase()
    self:ShowPropByCfg(data)
    self:ShowSkill()
    _G.GameUtil.ReBuildRTF(self.go_base.gameObject)
    if self.go_base.obj_parent and self.go_base.obj_parent1 then
        _G.GameUtil.ReBuildRTF(self.go_base.obj_parent1)
        _G.GameUtil.ReBuildRTF(self.go_base.obj_parent)
    end
end

---@private
function PetTipView:ShowBase()
    self.go_base.aortext_name.text = self.data:GetName()
    local order = self.data:GetOrder()
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_base.aortext_name, OrderCfg[order][2])
    ctm:SetItemTextGradient(self.go_base.aortext_order, OrderCfg[order][2])
    self.go_base.aortext_order.text = GetLangPackValue(90022300086, GetLangPackValue(OrderCfg[order][3]))
    local outlineColor = _G.ColorTools.FormatColorByString(ctm:GetTipTypeNameOutLineColorByGrade(OrderCfg[order][2]))
    self.go_base.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_base.aortext_order:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_base.aortext_power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor

    UIUtils.SetUIModel(self.go_base.aorimage_typeBg,nil,self.go_base.aorimage_typeBg2)
    UIUtils.SetUIModelText(self.go_base.aortext_type,self.go_base.aortext_type2,_G.GetLangPackValue(self.data.cfg.professional + 90024900003))
    --self.go_base.aortext_type.text = _G.GetLangPackValue(self.data.cfg.professional + 90024900003)

    -- if self.go_base.aortext_petSkillName then
    --     ctm:SetItemTextGradient(self.go_base.aortext_petSkillName.gameObject, OrderCfg[order][2])
    --     self.go_base.aortext_petSkillName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    -- end
    --背景
    local backBg = self.go_base.aorrawimage_di and self.go_base.aorrawimage_di or self.go_base.aorrawimage_gradeBG
    local path = ctm:GetItemBgPathByGrade(OrderCfg[order][2])
    if backBg then
        backBg:LoadImage(path)
    end
    
    --self.go_base.aortext_order.color = OrderCfg[order][2]
    --self.go_base.aortext_name.color = OrderCfg[order][2]
    --背景特效
    local effNode = self.go_base.obj_bgEffect and self.go_base.obj_bgEffect or self.go_base.obj_EffNode
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[require("CommonTipManager"):GetInstance():GetItemBgEffectPathByGrade(OrderCfg[order][2])],
            effNode
    )
    
    self.go_base.aorrawimage_gradeBG:LoadImage(
        OrderCfg[order][1],
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
        end
    )
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemPetBase,
        self.go_base.obj_item,
        function(item)
            item:ShowData(
                self.data,
                function()
                end
            )
            item:SetSize(90)
            item:ShowOrHideProfessional(false)
        end
    )
    local effectPath = ctm:GetItemBgEffectPathByGrade(OrderCfg[order][2])
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_base.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
            end
    )
end

---点击超链接
function PetTipView:OnHrefClick(id, name, asa)
    local rect = self.go_base.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    if self.isBottom then
        posY = posY * 1.5
    end
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY, self.isNarrow)
end

