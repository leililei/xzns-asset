---获取基本技能描述
function PetTipView:GetSkillDesBase(id)
    if card_skills_cfg[id] then
        return GetLangPackValue(card_skills_cfg[id].describe1)
    else
        return id
    end
end

---获取技能描述
function PetTipView:GetSkillDes(index, id)
    if card_skills_cfg[id] then
        return GetLangPackValue(card_skills_cfg[id].describe1)
    else
        return GetLangPackValue(90022300084, index, id)
    end
end

---展示属性
---@param data PetData
function PetTipView:ShowPropByCfg(data)
    local attrDic = data:GetAttributeDict()
    data:CalculatePower()
    local power = "<color=#fc9948>" .. data.power .. "</color>"
    self.go_base.aortext_power.text = _G.GetLangPackValue(90020100027) .. power
    local numStr, num, tb, tran, key, showList
    local showProp = function(prop)
        showList = {}
        for i, v in pairs(prop) do
            _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid, num = v})
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        for _, v in pairs(showList) do
            key = v.key
            tran = _G.InstantiateObject(self.go_base.obj_BaseProp, self.go_base.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[key].des
                num = v.num
                if _G.AttrType[key].percentage == 1 then
                    num = num * 100
                    num = _G.GameUtil.FormatNum(num)
                    num = tostring(num) .. "%"
                    numStr = "<color=#6effc6>" .. num .. "</color>"
                else
                    num = _G.math.floor(num)
                    num = _G.GameUtil.NumberWY(num)
                    numStr = num
                end
                tb.aortext_Num.text = numStr
            end
        end
    end
    showProp(attrDic)
end

---按钮点击事件在这里派发
function PetTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    end
end

function PetTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end

function PetTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function PetTipView:Dispose()
    self.go_base = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

function PetTipView:EscClose()
    self:CloseTips()
end

return PetTipView
