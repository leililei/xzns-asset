local base = require "ArtifactTipView"
---@class ArtifactUpTipView : ArtifactTipView	中文描述
---@field public go_table ArtifactUpTipView_GoTable GoTable
---@field compareData ArtifactData 用来比较的数据
local ArtifactUpTipView = _G.BaseClass("ArtifactUpTipView", base)
--_G.ArtifactUpTipView = ArtifactUpTipView
---获取用来比较的数据(较小的数据)
---@param data ArtifactData 神器数据
function ArtifactUpTipView:SetCompareData(data)
    self.compareData = data
end

function ArtifactUpTipView:ShowProp(data)
    if not self.compareData then
        base.ShowProp(self, data)
        return
    end
    local curData=data
    data=self.compareData
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local numStr, num, tb, tran, key, showList, upNum
    local showProp = function(prop, isPer, otherProp)
        showList = {}
        for i, v in pairs(prop) do
            if v > 0 then
                table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid})
            end
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        local getNum = function(keyType, curValue)
            if _G.AttrType[keyType].percentage == 1 or isPer then
                curValue = curValue * 100
                curValue = _G.GameUtil.FormatNum(curValue)
                curValue = tostring(curValue) .. "%"
            else
                curValue = _G.math.floor(curValue)
                curValue = _G.GameUtil.NumberWY(curValue)
                curValue = tostring(curValue)
            end
            return curValue
        end
        for _, v in pairs(showList) do
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[key].des
                num = prop[key]
                if otherProp[key] then
                    upNum = otherProp[key] - num
                else
                    upNum = 0
                end

                if _G.AttrType[key].percentage == 1 or isPer then
                    numStr = "<color=#5bdf99>" .. getNum(key, num) .. "</color>"
                else
                    numStr = getNum(key, num)
                end
                if upNum > 0 then
                    numStr = numStr .. "<color=#67BBD7>+" .. getNum(key, upNum) .. "</color>"
                end
                tb.aortext_Num.text = numStr
            end
        end
    end

    local prop = data.attribute:GetAttrByName()
    local compareProp = curData.attribute:GetAttrByName()
    showProp(prop, nil, compareProp)
    prop = data.attribute:GetAttrByName(_G.AttCountType.basePercent)
    compareProp = curData.attribute:GetAttrByName(_G.AttCountType.basePercent)
    showProp(prop, true, compareProp)
end

---展示属性
---@param data ArtifactData
function ArtifactUpTipView:ShowPropByCfg(data)
    if not self.compareData then
        base.ShowPropByCfg(self, data)
        return
    end
    local curData = data
    data = self.compareData
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local numStr, num, tb, tran, key, showList, upNum
    local showProp = function(prop, otherProp)
        showList = {}
        for i, v in pairs(prop) do
            table.insert(showList, {key = v[1], sortId = _G.AttrType[v[1]].sortid, num = v[2], isPer = v[3]})
        end
        _G.SortList(
            showList,
            function(a)
                return -a.sortId
            end
        )
        local getNum = function(keyType, curValue, isPer)
            if _G.AttrType[keyType].percentage == 1 or isPer then
                curValue = curValue * 100
                curValue = _G.GameUtil.FormatNum(curValue)
                curValue = tostring(curValue) .. "%"
            else
                curValue = _G.math.floor(curValue)
                curValue = _G.GameUtil.NumberWY(curValue)
                curValue = tostring(curValue)
            end
            return curValue
        end
        for _, v in pairs(showList) do
            key = v.key
            tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
            if tran then
                tb = _G.GetAutoGoTable(tran)
                tb.aortext_Name.text = _G.AttrType[key].des
                num = v.num
                upNum = 0
                for _, other in pairs(otherProp) do
                    if other[1] == key then
                        upNum = other[2] - num
                        break
                    end
                end

                if _G.AttrType[key].percentage == 1 or v.isPer then
                    numStr = "<color=#5bdf99>" .. getNum(key, num, v.isPer) .. "</color>"
                else
                    numStr = getNum(key, num)
                end
                if upNum > 0 then
                    numStr = numStr .. "<color=#67BBD7>+" .. getNum(key, upNum, v.isPer) .. "</color>"
                end
                tb.aortext_Num.text = numStr
            end
        end
    end

    local attrDic = data:GetAttrDict()
    local compareAttrDic = curData:GetAttrDict()
    showProp(attrDic.base, compareAttrDic.base)
    showProp(attrDic.other, compareAttrDic.other)
end


return ArtifactUpTipView
