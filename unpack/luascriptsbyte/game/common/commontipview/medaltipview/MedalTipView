---@class MedalTipView : Component	中文描述
local MedalTipView = _G.BaseClass("MedalTipView", _G.Component)

function MedalTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function MedalTipView:OnCreate()
end

function MedalTipView:Init(data)
    local cfg = _G.ConfigManager.player_medal_cfg[data.sid]
    if cfg then
        self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(cfg.name)
        self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(cfg.describe)
    end
    self.view:SetPos(self.go_table.obj_bg, data.pos)
end

function MedalTipView:OnClickBtn()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Medal)
end
---销毁对象时,析构函数
function MedalTipView:OnDestroy()
end

function MedalTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    ---@field public CoPool thread[] 缓存的协程
    --self.CoPool = {}
end

function MedalTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
end

return MedalTipView
