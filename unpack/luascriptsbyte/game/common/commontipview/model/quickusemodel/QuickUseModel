---@class QuickUseModel : Singleton	中文描述
local QuickUseModel = _G.BaseClass("QuickUseModel", _G.Singleton)

---@return QuickUseModel QuickUseModel
function QuickUseModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function QuickUseModel:__init()
    self.quene = {}
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.OnItemUpdata, self)
end

function QuickUseModel:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.BagNewView.Name then
        ---打开背包界面后关闭快捷使用
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.QuickUseTipView.Name)
        if view then
            view:Close()
        end
        self.quene = {}
    end
end

function QuickUseModel:OnItemUpdata(data)
    if _G.table.isEmptyOrNil(self.quene) then
        return
    end
    local front = self.quene[1]
    if front.needNum and front.itemData and front.itemData.count and front.needNum > front.itemData.count then
        _G.table.remove(self.quene, 1)
    end
    ---消耗道具时需要清除队列
    if data and data[1] then
        for _, v in pairs(data) do
            if v.type and v.type[2] <= 0 then
                local id = v.type[1]
                for i, queneData in ipairs(self.quene) do
                    if queneData.sid == id then
                        local _, storageID = _G.StorageManager:GetInstance():CheckSidType(queneData.sid)
                        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(storageID, queneData.sid)
                        if itemData then
                            queneData.itemData = itemData
                        elseif _G.AppSetting.IsXzns then--其他途径使用掉队列里的道具箱时没有从队列中移除，暂时只在星座单独修改
                            _G.table.remove(self.quene, i)
                        end

                        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.QuickUseTipView
                        .Name)
                        if _G.table.isEmptyOrNil(self.quene) then
                            if view then
                                view:Close()
                            end
                            return
                        end
                        if i == 1 then
                            ---队列第一个数据刷新了，需要刷新界面
                            if view then
                                view:RefreshView(self.quene[1])
                            end
                        end
                        break
                    end
                end
            end
        end
    end
end

---添加队列
function QuickUseModel:AddQuene(data)
    local bagView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BagNewView.Name)
    if bagView then
        ---背包界面打开时使用道具不弹快捷弹窗
        return
    end
    if data then
        local itemCfg = _G.ConfigManager.item_cfg
        local StorageManager = _G.StorageManager:GetInstance()
        for _, v in ipairs(data) do
            if itemCfg[v.sid] and itemCfg[v.sid].QuickUse then
                local _, storageID = StorageManager:CheckSidType(v.sid)
                local itemData = StorageManager:GetItemDataByID(storageID, v.sid)
                if itemData and itemData.count > 0 then
                    self:CheckAddQuene(itemData, itemCfg[v.sid], v)
                end
            end
        end
    end
end

---根据类型判断是否可以加入队列
function QuickUseModel:CheckAddQuene(itemData, itemCfg, data)
    ---已在队列中的就直接覆盖
    for i, v in ipairs(self.quene) do
        if v.sid == data.sid then
            if itemData.clickcompositing then
                local needNum = _G.tonumber(itemCfg.UseParameter[1][1])
                local num = _G.Mathf.Floor(itemData.count / needNum)
                num = num > itemCfg.limit_num and itemCfg.limit_num or num
                if num ~= v.num then
                    v.itemData = itemData
                    v.num = num
                    v.itemDatas = { { sid = data.sid, num = num } }
                    v.howItemDatas = { { sid = data.sid, num = num * needNum } }
                end
            else
                v.itemData = itemData
            end
            if i == 1 then
                ---队列第一个数据刷新了，需要刷新界面
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.QuickUseTipView.Name)
                if view then
                    view:RefreshView(v)
                end
            end
            return
        end
    end

    if itemCfg.clickcompositing and itemCfg.clickcompositing == 1 then
        ---支持一键合成的道具，即碎片需要判断是否有足够的数量可以合成
        local needNum = _G.tonumber(itemCfg.UseParameter[1][1])
        local num = _G.Mathf.Floor(itemData.count / needNum)
        num = num > itemCfg.limit_num and itemCfg.limit_num or num
        if num >= 1 then
            _G.table.insert(self.quene, 1, {
                itemDatas = { { sid = data.sid, num = num } },
                showItemDatas = { { sid = data.sid, num = num * needNum } },
                sid = data.sid,
                num = num,
                needNum = needNum,
                cfg = itemCfg,
                itemData = itemData
            })
        end
    else
        _G.table.insert(self.quene, 1, { itemData = itemData, sid = data.sid, cfg = itemCfg })
    end
end

---检查获得的道具是否可以快捷使用
function QuickUseModel:CheckCanQucikUse()
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.QuickUsePopEnbale, 1) ~= 1 then --不弹
        return
    end
    if _G.table.isEmptyOrNil(self.quene) then
        return
    end

    local bag = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BagNewView.Name)
    if bag then
        return
    end
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.QuickUseTipView.Name)
    if not view then
        self.topData = self.quene[1]
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.QuickUseTipView.Name, self.topData)
    else
        local _data = self.quene[1]
        if self.topData and self.topData.sid ~= _data.sid then
            self.topData = _data
            view:RefreshView(_data)
        end
    end
end

---获取队列第一个数据
function QuickUseModel:PopQuene()
    return self.quene[1]
end

---移除第一个
function QuickUseModel:RemoveTopQuene()
    _G.table.remove(self.quene, 1)
end

---销毁对象时,析构函数
function QuickUseModel:Dispose()
    self.quene = {}
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.OnItemUpdata, self)
end

return QuickUseModel
