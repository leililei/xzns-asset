---@class SkillHunLianTipModel	魂链tips 点击第一数据
---@field lv number 技能等级
---@field skillData card_skills_cfg_item[] 所有技能
---@param isLock boolean 技能是否解锁
local SkillHunLianTipModel = _G.BaseClass("SkillTipModel")

---类的构造函数
function SkillHunLianTipModel:__init()
end

---类的析构函数
function SkillHunLianTipModel:Dispose()
end
---@param isLock boolean 魂链是否激活
---@param lv number 魂链等级
---@param hunlianSkill tb 魂链技能的 解锁的等级
function SkillHunLianTipModel:Init(sid, isLock, lv, hunlianSkill)
    self.isLock = isLock
    self.lv = lv
    self.hunlianSkill = hunlianSkill
    self.skillData = self:UpdataGetSkills(sid)
end

function SkillHunLianTipModel:UpdataGetSkills(sid)
    self.isSkillActive = {
        [1] = {
            isLockLv = 0,
            isLock = false
        },
        [2] = {
            isLockLv = 0,
            isLock = false
        },
        [3] = {
            isLockLv = 0,
            isLock = false
        },
        [4] = {
            isLockLv = 0,
            isLock = false
        }
    }
    local cardSkillCfg = _G.ConfigManager.card_skills_cfg
    local skills = {}
    local startId = sid - sid % 10
    for i = 1, 10 do
        local data = cardSkillCfg[startId + i]
        if data == nil then
            break
        else
            local flag = false
            if self.isLock and self.lv >= self.hunlianSkill[i] then
                flag = true
            end
            self.isSkillActive[i].isLock = flag
            self.isSkillActive[i].isLockLv = self.hunlianSkill[i]
            _G.table.insert(skills, data)
        end
    end
    return skills
end

return SkillHunLianTipModel
