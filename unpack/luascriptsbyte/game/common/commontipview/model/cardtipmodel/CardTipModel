local CardTipData = require "CardTipData"
---@class CardTipModel	中文描述
local CardTipModel = _G.BaseClass("CardTipModel")
_G.CardTipModel = CardTipModel

---类的构造函数
function CardTipModel:__init()
    self.cardData = nil
end

---类的析构函数
function CardTipModel:Dispose()
end

function CardTipModel:Init(sid, uid)
    self.sid = sid
    self.uid = uid or 0
    if self.uid > 0 then
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.uid)
        if card then
            self.cardData = card
        end
    end
    if not self.cardData then
        self.cardData = CardTipData.New()
        self.cardData:Parse({sid = sid})
    end
end

return CardTipModel
