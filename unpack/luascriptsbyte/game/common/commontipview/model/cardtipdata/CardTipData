require "CardData"

---@class CardTipModel	中文描述
---@field cardData CardData
local CardTipData = _G.BaseClass("CardTipModel", _G.CardData)

function CardTipData:GetLevel()
    return 1
end

function CardTipData:CalcNowSumProp()
    self.lv = self:GetLevel()
    self:UpdateAttr()
    self.NowSumProp:OnInit(self.cfg.Elements)
    local attr = _G.AttributeClassManager:GetInstance():GetAttribtueClass(self.cfg.Elements)
    _G.AttributeClassManager:GetInstance():AddAttribute(attr, self.BaseProp)
    _G.AttributeClassManager:GetInstance():AddAttribute(self.NowSumProp, attr)
    _G.AttributeClassManager:GetInstance():PutAttribtueClass(attr)
    self:CalculateRole()
    self:CalculatePower()
end

return CardTipData
