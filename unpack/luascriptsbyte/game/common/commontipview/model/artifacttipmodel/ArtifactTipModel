local ArtifactData = require("ArtifactData")

---@class ArtifactTipModel	中文描述
---@field sid number
---@field cfg item_cfg|currency_type_cfg
---@field count number
---@field obj UnityEngine.Component|UnityEngine.GameObject|UnityEngine.Transform
local ArtifactTipModel = _G.BaseClass("ArtifactTipModel")

---类的构造函数
function ArtifactTipModel:__init()
end

function ArtifactTipModel:Dispose()
end

---道具(包括礼物) 装备，技能  ,神器 sid,
function ArtifactTipModel:Init(sid, uid, obj)
    self.sid = sid
    self.uid = uid
    local flag = true
    if uid and uid > 0 then
        local artifact = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Artifact, uid)
        if not _G.table.isEmptyOrNil(artifact) then
            flag = false
            self.data = artifact
        end
    end
    if flag then
        self.data = ArtifactData.New()
        self.data:Parse({sid = sid})
    end

    self.pos = _G.Vector3.New(obj:GetPosition())
end

return ArtifactTipModel
