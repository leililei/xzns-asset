---@class TipBaseModel	中文描述
---@field sid number
---@field cfg item_cfg|currency_type_cfg
---@field count number
---@field obj UnityEngine.Component|UnityEngine.GameObject|UnityEngine.Transform
local TipBaseModel = _G.BaseClass("TipBaseModel")

---类的构造函数
function TipBaseModel:__init()
end

function TipBaseModel:Dispose()
end
---道具(包括礼物) 装备，技能  ,神器 sid,
function TipBaseModel:Init(sid, obj)
    self.sid = sid
    self.cfg =
        _G.ConfigManager.item_cfg[self.sid] or _G.ConfigManager.currency_type_cfg[self.sid] or
        _G.ConfigManager.currency_type_client_cfg[self.sid] or _G.ConfigManager.relic_effect_cfg[self.sid]
    local _, id = _G.StorageManager:GetInstance():CheckSidType(self.sid)
    self.count = _G.StorageManager:GetInstance():GetItemCountByID(id, self.sid)
    self.pos = Vector3.New(obj:GetPosition())
end

return TipBaseModel
