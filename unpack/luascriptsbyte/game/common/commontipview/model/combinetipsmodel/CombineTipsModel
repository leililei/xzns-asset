---@class CombineTipsModel	合击技tips
local CombineTipsModel = _G.BaseClass("CombineTipsModel")
_G.CombineTipsModel = CombineTipsModel
---类的构造函数
function CombineTipsModel:__init()
end

---类的析构函数
function CombineTipsModel:Dispose()
end
function CombineTipsModel:Init(sid, cardskillid)
    self.skillData = self:UpdataGetSkills(sid, cardskillid)
end

function CombineTipsModel:UpdataGetSkills(sid, cardskillid)
    local cfg = _G.ConfigManager.combine_cfg[sid]
    local cardSkillCfg = _G.ConfigManager.card_skills_cfg[cardskillid]
    local skills = {cfg = cfg, cardSkillCfg = cardSkillCfg, cardssids = cfg.activation}
    return skills
end

return CombineTipsModel
