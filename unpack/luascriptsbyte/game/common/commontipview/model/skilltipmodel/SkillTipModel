---@class SkillTipModel	中文描述
---@field lv number 技能等级
---@field skillData card_skills_cfg_item[] 所有技能
---@param isLock boolean 技能是否解锁
local SkillTipModel = _G.BaseClass("SkillTipModel")

---类的构造函数
function SkillTipModel:__init()
end

---类的析构函数
function SkillTipModel:Dispose()
end

function SkillTipModel:Init(sid, isLock, ...)
    self.skillData = self:UpdataGetSkills(sid)
    if isLock then
        self.isLock = isLock
        self.lv = 0
    else
        self.isLock = false
    end
    local args = {...}
    self.pos = args[2]
end

function SkillTipModel:UpdataGetSkills(sid)
    local cardSkillCfg = _G.ConfigManager.card_skills_cfg
    local skills = {}
    local startId = sid - sid % 10
    self.lv = cardSkillCfg[sid].level
    for i = 1, 100 do
        local data = cardSkillCfg[startId + i]
        if data == nil then
            break
        else
            _G.table.insert(skills, data)
        end
    end
    if _G.table.isEmptyOrNil(skills) then
        startId = startId - startId % 10000
        for i = 1, 100 do
            local data = cardSkillCfg[startId + i * 100]
            if data == nil then
                break
            else
                _G.table.insert(skills, data)
            end
        end
    end
    if #skills <= 0 then
        skills[1] = cardSkillCfg[sid]
    end
    return skills
end

return SkillTipModel
