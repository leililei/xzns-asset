local SpiritualData = require("SpiritualData")

---@class SpiritualTipModel
local SpiritualTipModel = _G.BaseClass("SpiritualTipModel")

---类的构造函数
function SpiritualTipModel:__init()
end

function SpiritualTipModel:Dispose()
end

---道具(包括礼物) 装备，技能  ,神器 sid,
function SpiritualTipModel:Init(sid, uid, obj)
    self.sid = sid
    self.uid = uid
    local flag = true
    if uid and uid > 0 then
        local spiritual = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Spiritual, uid)
        if not _G.table.isEmptyOrNil(spiritual) then
            flag = false
            self.data = spiritual
        end
    end
    if flag then
        self.data = SpiritualData.New()
        self.data:Parse({sid = sid})
    end

    self.pos = _G.Vector3.New(obj:GetPosition())
end

return SpiritualTipModel
