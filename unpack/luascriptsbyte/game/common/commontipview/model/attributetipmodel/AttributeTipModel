---@class AttributeTipModel	属性Tip
---@field attributeData attribute_cfg_Item
---@field content string
local AttributeTipModel = _G.BaseClass("AttributeTipModel")

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function AttributeTipModel:__init()
end

---类的析构函数
function AttributeTipModel:Dispose()
end
---魂链初始化
---@param sid number 技能或属性的id
---@param type number 1 属性，2技能
function AttributeTipModel:Init(sid, type)
    self.type = type
    if type == 1 then
        --self.attributeData = _G.ConfigManager.attribute_cfg[sid]
        self:SetDataAttribute(sid)
    elseif type == 2 then
        self.card_sikll_cfg = _G.ConfigManager.card_skills_cfg[sid]
    end
end

function AttributeTipModel:SetDataAttribute(sid)
    local cfg = _G.ConfigManager.attribute_cfg[sid]
    self.icon = cfg.icon
    self.attrname = cfg.name
    self.name = _G.AttrType[cfg.attribute[1][1]].des
    local value = _G.tonumber(cfg.attribute[1][3])
    if _G.AttrType[cfg.attribute[1][1]].percentage == 1 then
        value = value * 0.0001 * 100
    else
        if _G.tonumber(cfg.attribute[1][2]) == 2 then
            value = value * 0.0001 * 100
        else
            value = value
        end
    end
    ---截取小数点后一位，策划说不会配置超过一位的（康光红说的！
    value = _G.string.format("%.1f", value)
    self.value = value
end
return AttributeTipModel
