require "EquipmentItem"
---@class EquipmentTipModel	中文描述
local EquipmentTipModel = _G.BaseClass("EquipmentTipModel")

---类的构造函数
function EquipmentTipModel:__init()
end

---类的析构函数
function EquipmentTipModel:Dispose()
end

function EquipmentTipModel:Init(sid, uid, element, dynamicCfg, datas)
    self.sid = sid
    self.uid = uid or 0
    if self.uid > 0 then
        local equips = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Equipment, sid)
        if equips then
            self.equip = equips[self.uid]
        end
    end
    if datas then
        self.equip = datas
    end
    if not self.equip then
        self.equip = _G.StorageManager:GetInstance():GetItemDataClass(sid, 1)
        if element then
            self.equip.element = element
        end
        if not _G.table.isEmptyOrNil(dynamicCfg) then
            self.equip.element = dynamicCfg[1].element
        end
    end
end

return EquipmentTipModel
