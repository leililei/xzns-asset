function CommonTipManager:OpenAttributeTip(obj, sid, CloseCallback, type)
    local data = AttributeModel.New()
    data:Init(sid, type)
    if type == 1 then
        -- local x, y, z = obj:GetPosition()
        -- local tb = {data = data, pos = {x = x, y = y, z = z}}
        self:OpenView(_G.TipType.Attribute, data, CloseCallback)
    elseif type == 2 then
        self:OpenView(_G.TipType.Skill_hunLian, data, CloseCallback)
    end
end

