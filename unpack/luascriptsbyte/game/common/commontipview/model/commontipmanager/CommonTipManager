---设置弹出tip中的物品名称渐变颜色
---@param text AorText 道具名称文本组件
---@param grade number 道具品质
function CommonTipManager:SetItemTextGradient(text, grade)
    if grade <= 0 or not ItemTextGradient[grade] then
        return
    end

    local colors = {ItemTextGradient[grade][1], ItemTextGradient[grade][2]}
    local alphas = {ItemTextGradient[grade][3], ItemTextGradient[grade][4]}
    self:SetTextGradient(colors, alphas, text)
end

---@param text AorText 道具名称文本组件
function CommonTipManager:SetTextGradient(colorList, alphaList, text, timeList)
    local gradient = text:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    local colors = {}
    local color, count
    count = #colorList
    for i = 1, #colorList do
        color = _G.CS.UnityEngine.GradientColorKey()
        color.color = _G.ColorTools.FormatColorByString(colorList[i])
        color.time = (i - 1) / count
        _G.table.insert(colors, color)
    end

    local alphas = {}
    local alpha
    count = #alphaList
    for i = 1, #alphaList do
        alpha = _G.CS.UnityEngine.GradientAlphaKey()
        alpha.alpha = alphaList[i]
        alpha.time = (i - 1) / count
        _G.table.insert(alphas, alpha)
    end

    if #colors ~= #alphas then
        if _G.AppSetting.DEBUG then
            _G.LogError("color 和 alpha 的数量不相等", "文本渐变设置")
        end
    end
    if timeList and #colors ~= #timeList then
        if _G.AppSetting.DEBUG then
            _G.LogError("color 和 time 的数量不相等", "文本渐变设置")
        end
    end
    if timeList then
        for i = 1, #timeList do
            colors[i].time = timeList[i]
            alphas[i].time = timeList[i]
        end
    end

    if gradient then
        gradient:GetGradient():SetKeys(colors, alphas)
    end
end

