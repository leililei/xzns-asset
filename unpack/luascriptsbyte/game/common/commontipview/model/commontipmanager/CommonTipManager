---@param sid number 道具sid
---@return TipType
function CommonTipManager:CheckType(sid)
    local _, type = _G.StorageManager:GetInstance():CheckSidType(sid)
    if type == nil then
        local Sid = sid
        while (Sid > 1000) do
            Sid = Sid / 10
        end
        Sid = _G.math.floor(Sid)
        if Sid == otherSidType.Pet then
            return _G.TipType.Pet
        elseif Sid == otherSidType.Build then
            return _G.TipType.Build
        end
        return
    end
    return stroageID2Tip[type]
end

function CommonTipManager:OpenView(type, data, ...)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name)
    if isExist then
        view.View:ShowTips(type, data, ...)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name, type, data, ...)
    end
end

function CommonTipManager.OpenCommonAwardView(data, ...)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data, ...)
end

---显示战力提升
function CommonTipManager.OpenPowerUpView(power, addPower, noShowRank)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.PowerUpView.Name)
    if isExist then
        view.View:Show(power, addPower)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PowerUpView.Name, power, addPower)
    end
    if not noShowRank then
        require "RecordRankModel":GetInstance():CheckAfkPowerList()
    end
end

---显示排行提升
function CommonTipManager.OpenRankUpView(content)
    local isExist, view = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.RankUpView.Name)
    if isExist then
        view.View:AddOne(content)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RankUpView.Name, content)
    end
end

---显示奖励飘字提示
function CommonTipManager.ShowSecretFloatTips(msg)
    local isExit, View = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SecretFloatTipsView.Name)
    if isExit then
        View.View:Show(msg)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretFloatTipsView.Name, msg)
    end
end

return CommonTipManager
