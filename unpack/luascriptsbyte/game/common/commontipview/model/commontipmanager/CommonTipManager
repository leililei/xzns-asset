---@param obj UnityEngine.GameObject|UnityEngine.Transform|UnityEngine.Component
---@param sid number 物品sid
function CommonTipManager:OpenPropTip(obj, sid, ...)
    local data = TipBaseModel.New()
    data:Init(sid, obj)
    local type = _G.TipType.Prop
    if data.cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 该道具 无tips窗口")
        end
        return
    end
    if data.cfg.Type1 then
        if data.cfg.Type1 == _G.ItemCfgType.BrokenStone then
            type = _G.TipType.BrokenStone
        elseif data.cfg.Type1 == _G.ItemCfgType.CardChip and data.cfg.UseType == _G.ItemUseType.CompoundProp then
            local useParameter = data.cfg.UseParameter
            if not _G.table.isEmptyOrNil(useParameter) then
                local itemSid = _G.tonumber(useParameter[1][2])
                local storageType = _G.StorageManager:GetInstance():CheckSidType(itemSid)
                if storageType and storageType == _G.StorageType.Artifact then
                    self:OpenArtifactTipsView(obj, itemSid)
                    return
                end
            end
        elseif GiftID[data.cfg.Type1] or giftUseType[data.cfg.UseType] then
            type = _G.TipType.Gift
        elseif data.cfg.Type1 == _G.ItemCfgType.PetChip then
            if data.cfg.UseParameter2[1] then
                local petSid = data.cfg.UseParameter2[1][1]
                if _G.ConfigManager.pet_cfg[petSid] then
                    self:OpenPetSkillTip(petSid)
                    return
                elseif _G.AppSetting.DEBUG then
                    _G.LogError("pet_cfg中没有sid为" .. petSid .. "的配置")
                end
            end
        elseif data.cfg.Type1 == _G.ItemCfgType.BuildChip then
            if data.cfg.UseParameter2[1] then
                local buildSid = data.cfg.UseParameter2[1][1]
                if _G.ConfigManager.manor_build_cfg[buildSid] then
                    self:OpenBuildTipsView(buildSid, true)
                    return
                elseif _G.AppSetting.DEBUG then
                    _G.LogError("manor_build_cfg中没有sid为" .. buildSid .. "的配置")
                end
            end
        elseif data.cfg.Type1 == _G.ItemCfgType.RechargeAccumulate then
            type = _G.TipType.RechargeAccumulate
        elseif data.cfg.Type1 == _G.ItemCfgType.VoucherDiscount then
            type = _G.TipType.VoucherDiscount
        end
    end

    self:OpenView(type, data, ...)
end

