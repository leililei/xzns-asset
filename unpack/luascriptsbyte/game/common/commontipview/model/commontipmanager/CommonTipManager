-- 打开提示界面
---@param obj UnityEngine.GameObject|UnityEngine.Transform|UnityEngine.Component
---@param sid number 物品sid
---@param uid number 如果有uid就传 否则传nil
---@param dynamicCfg DynamicCfg 关闭tips回调
function CommonTipManager:OpenTip(obj, sid, uid, dynamicCfg, ...)
    local args = {...}
    local type = self:CheckType(sid)
    local fun = self.OpenTipFunction[type]
    if fun then
        if type == _G.TipType.Card then
            fun(sid, uid, dynamicCfg, args[1], args[2])
        elseif type == _G.TipType.Equipment then
            fun(sid, uid, args[1], dynamicCfg, args[2])
        elseif type == _G.TipType.Decoration then
            fun(obj, sid, uid)
        elseif type == _G.TipType.Prop then
            fun(obj, sid, args[1])
        elseif type == _G.TipType.Combine then
            -- body
        elseif type == _G.TipType.Artifact then
            fun(obj, sid, uid, args[1])
        elseif type == _G.TipType.Spiritual then
            fun(sid, uid, args[1])
        elseif type == _G.TipType.Pet then
            fun(sid, args[1], args[2])
        elseif type == _G.TipType.RelicTeamBuff then
            fun(sid)
        elseif type == _G.TipType.Build then
            fun(sid, args[1], args[2])
        elseif type == _G.TipType.Remains then
            fun(sid, args[1], args[2])
        elseif type == _G.TipType.Gemstone then
            fun(sid, uid)
        else
            fun(obj, sid)
        end
    end
end

function CommonTipManager:OpenDecorationTips(obj, sid, uid, CloseCallback)
    local data
    if uid and uid > 0 and uid ~= sid then
        data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Decoration, uid)
        self:OpenView(_G.TipType.Decoration, data, CloseCallback)
    else
        data = _G.StorageManager:GetInstance():GetItemDataClass(sid, 1)
        local x, y, z = obj:GetPosition()
        local tb = {
            data = data,
            pos = {
                x = x,
                y = y,
                z = z
            }
        }
        self:OpenView(_G.TipType.Prop, tb, CloseCallback)
    end
end

-- 打开技能Tip
---@param sid number 当前技能等级的sid
---@param CloseCallback number 关闭tips回调
---@param isLock boolean 当前是否未解锁
function CommonTipManager:OpenSkillTip(sid, CloseCallback, isLock, ...)
    if sid - 410100000 > 0 then
        self:OpenAttributeTip(sid, CloseCallback, ...)
    else
        local data = SkillTipModel.New()
        data:Init(sid, isLock, ...)
        ---因为有特殊玩法配置了超过4级的技能，但是tip只显示前4级，4级后面的不显示
        if (#data.skillData > 4) then
            for i = 5, #data.skillData do
                data.skillData[i] = nil
            end
        end
        self:OpenView(_G.TipType.Skill, data, CloseCallback, ...)
    end
end

