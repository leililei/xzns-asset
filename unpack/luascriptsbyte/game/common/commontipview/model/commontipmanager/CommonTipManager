---打开灵契Tip
function CommonTipManager:OpenSpiritualTipsView(sid, uid, showMaxLevel)
    local flag = true
    local spiritualData = nil
    if uid and uid > 0 then
        local spiritual = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Spiritual, uid)
        if not _G.table.isEmptyOrNil(spiritual) then
            flag = false
            spiritualData = _G.DeepCopy(spiritual)
            if showMaxLevel then
                local config = _G.ConfigManager.spiritual_cfg[sid]
                spiritualData.star = config.Star
                spiritualData.level = _G.ConfigManager.spiritual_star_cfg[config.Star + 100].level_limit
            end
        end
    end
    if flag then
        spiritualData = SpiritualData.New()
        if showMaxLevel then
            local config = _G.ConfigManager.spiritual_cfg[sid]
            spiritualData:Parse({
                sid = sid,
                star = config.Star,
                level = _G.ConfigManager.spiritual_star_cfg[100 + config.Star].level_limit
            })
        else
            spiritualData:Parse({
                sid = sid
            })
        end
    end

    self:OpenView(_G.TipType.Spiritual, spiritualData)
end

