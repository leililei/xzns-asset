end
---创建对象时,入口构造函数
function AttributeTipView:OnCreate()
end
---初始化
---@param info AttributeTipModel
---@field info.data table 信息
---@field info.pos table 位置
---@param callback function 关闭回调
function AttributeTipView:Init(info, callback)
    local data = info
    if not data then
        return
    end
    local AttributeData = data.data
    self.callback = callback
    -- self.go_table.aorrawimage_attribute:LoadImage(AttributeData.attributeData.icon)
    -- self.go_table.aortext_AttributeDes.text=AttributeData.content
    -- self.go_table.aortext_name.text=_G.LangUtil.GetLangPackValue(AttributeData.attributeData.name)
    -- self.go_table.aortext_otherName.text=_G.LangUtil.GetLangPackValue(AttributeData.attributeData.subtitle)
    --self.go_table.aortext_title.text = data.name
    --self.go_table.aortext_des.text = "+" .. data.value .. "%"
    -- if data.type == 1 then
    --     self.view:SetPos(self.rect, info.pos)
    -- end
    self.skillDesEx = self.go_table.obj_SkillDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
    self.skillDesEx.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.attrname)
    self.go_table.aortext_name.color = _G.ColorTools.FormatColorByString("ffdaac")
    self.go_table.aortext_skillDescribe.text = ""
    self.go_table.aorrawimage_Skill:LoadImage(data.icon)
    self.skillDesEx.text = data.name .. "         +" .. data.value .. "%"
    --self.go_table.aortext_SkillDes.text = data.name .. "         +" .. data.value .. "%"
    self.rect = self.go_table.obj_skill:GetComponentE(typeof(CS.UnityEngine.RectTransform))
    self.go_table.aorrawimage_gradeBG:LoadImage(
        "Images/nArtifact/ui_sqzs_chengse02",
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
            trans:SetActiveE(1)
        end
    )
end

function AttributeTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.view:CloseTip(_G.TipType.Attribute)
    end
end

---销毁对象时,析构函数
function AttributeTipView:OnDestroy()
end

function AttributeTipView:__init(transform, view)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function AttributeTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.rect = nil
end

---打开超链接
function AttributeTipView:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(tonumber(id), nil, weight, height)
end

return AttributeTipView
