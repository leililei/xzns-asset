---@param index int 当前技能组索引
function CardInfoTipView:View_Wake_SkillTriggerOnClick(go_toggle, eventData, groupIndex, toggleindex)
    if _G.AppSetting.DEBUG then
        _G.Log("View_Wake_SkillTriggerOnClick", "<color=red>" .. ">>>" .. "</color>")
    end

    ---@type card_awaken_cfg_Item
    local tcard_awaken_cfg = _G.ConfigManager.card_awaken_cfg[self.CardData.sid + self.wakeNowSkillItem.index]
    if tcard_awaken_cfg == nil then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1001,
            "没有该觉醒配置 卡sid:" .. self.CardData.sid .. " 觉醒等级:" .. self.wakeNowSkillItem.index
        )
        return
    end
    --选择的觉醒技能id
    local tAttribute = 0
    if toggleindex == 1 then
        tAttribute = tcard_awaken_cfg.attribute1
    elseif toggleindex == 2 then
        tAttribute = tcard_awaken_cfg.attribute2
    elseif toggleindex == 3 then
        tAttribute = tcard_awaken_cfg.attribute3
    end
    local tAttribute_cfg = _G.ConfigManager.attribute_cfg[tAttribute]
    if tAttribute_cfg == nil then
        return
    end

    local icon = string.len(tAttribute_cfg.icon) > 0 and tAttribute_cfg.icon or WakeIcon.skill
    --技能图标
    self.go_Wake_skillTips.aorimage_skill.SpriteName = icon
    --技能名字
    self.go_Wake_skillTips.aortext_skillName.text = _G.LangUtil.GetLangPackValue(tAttribute_cfg.name)
    --技能描述
    self.go_Wake_skillTips.aortext_skillDes.text = _G.LangUtil.GetLangPackValue(tAttribute_cfg.describe)

    self.go_Wake_skillTips.aorbtn_ok.onClick:RemoveAllListeners()
    self.go_Wake_skillTips.aorbtn_ok.onClick:AddListener(
        _G.handler(
            self,
            function()
                _G.GameUtil.SetActiveByCondition(self.go_Wake_skillTips, false)
                ---@type card.c2s_card_choose_awaken
                local pbdata = {}
                pbdata.lv = self.wakeNowSkillItem.index
                pbdata.sid = tAttribute
                pbdata.uid = self.CardData.uid
                require("CardInfoNet"):GetInstance():CardChooseAwaken(
                    pbdata,
                    function(data)
                        if data.ack ~= 1 then
                            --_G.GameUtil.NetAckShowTips(data.ack)
                            return
                        end

                        self.CardData:CardAwakenChoose(pbdata.lv, pbdata.sid)
                        self.go_Wake.wakeSkillState[self.wakeNowSkillItem.index] = toggleindex
                        --self.mCard_awakenCfgDic   已解锁图标
                        self.wakeNowSkillItem.gotable.aorimage_skillicon.SpriteName = WakeIcon.skill
                        self:View_Wake()
                    end
                )
            end
        )
    )
    _G.GameUtil.SetActiveByCondition(self.go_Wake_skillTips, true)
end

