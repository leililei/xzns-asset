function CardInfoTipView:Init(CardData, callBack)
    self.hideViews = HideOtherWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name)
    if not self.isInit then
        self:Awake()
    end
    self.isSelf = CardData.uid > 0
    self.data = CardData
    self:SetData(CardData.cardData)

    self.callBack = callBack
end

