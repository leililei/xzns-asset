    if self.go_Shuxing.obj_starParent ~= nil then
        self.mCardInfoManager:Star_byParent(self.go_Shuxing.obj_starParent, self.CardData.star)
    end
    self:View_Shuxing_ShowSkills()
    self:View_Shuxing_ShowProp()
end

function CardInfoTipView:View_Shuxing_ShowSkills()
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local function SetSkill(gotable, nowskillCfg, isShow)
        if gotable == nil then
            return
        end
        if nowskillCfg then
            --图标
            gotable.aorrawimage_skill:LoadImage(nowskillCfg.icon)
            --等级
            gotable.aortext_skilllevel.text = nowskillCfg.level
        else
            isShow = false
        end

        --锁隐藏
        _G.GameUtil.SetActiveByCondition(gotable.obj_skilllock, not isShow)
        --等级显示
        _G.GameUtil.SetActiveByCondition(gotable.aortext_skilllevel, isShow)
        --有该技能才显示技能图标
        _G.GameUtil.SetActiveByCondition(gotable.gameObject, isShow)
    end

    --小技能1
    local skillCfg = nil
    --是否已拥有该技能
    local isHave = true
    if self.CardData.Skills.skill_3 ~= 0 then
        skillCfg = card_skills_cfg[self.CardData.Skills.skill_3]
    else
        isHave = false
        skillCfg = card_skills_cfg[self.CardData.sid + 3 * 100 + 1]
    end
    SetSkill(_G.GetAutoGoTable(self.go_Shuxing.toggle_skill1), skillCfg, isHave)

    --小技能2
    skillCfg = nil
    isHave = true
    if self.CardData.Skills.skill_4 ~= 0 then
        skillCfg = card_skills_cfg[self.CardData.Skills.skill_4]
    else
        isHave = false
        skillCfg = card_skills_cfg[self.CardData.sid + 4 * 100 + 1]
    end
    SetSkill(_G.GetAutoGoTable(self.go_Shuxing.toggle_skill2), skillCfg, isHave)

    --小技能3
    skillCfg = nil
    local isHave = true
    if self.CardData.Skills.skill_5 ~= 0 then
        skillCfg = card_skills_cfg[self.CardData.Skills.skill_5]
    else
        isHave = false
        skillCfg = card_skills_cfg[self.CardData.sid + 5 * 100 + 1]
    end
    SetSkill(_G.GetAutoGoTable(self.go_Shuxing.toggle_skill3), skillCfg, isHave)

    --绝招
    skillCfg = nil
    isHave = true
    if self.CardData.Skills.skill_1 ~= 0 then
        skillCfg = card_skills_cfg[self.CardData.Skills.skill_1]
    else
        isHave = false
        skillCfg = card_skills_cfg[self.CardData.sid + 1 * 100 + 1]
    end
