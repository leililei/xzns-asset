---@param  view EmbattleView 界面对象
---@field camera _G.Camera
local function LoadEmbattleScene(view, callback)
    _G.PoolsManager:GetInstance():Spawn(
        _G.ConfigManager.ui_scens_cfg[2].Scene,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError(
                        "场景无法加载 path:" .. _G.ConfigManager.scene_cfg[2].Scene .. "    CardInfoView LoadEmbattleScene"
                    )
                end
                return
            end
            ---固定位置 方便升星成功界面 显示模型

            trans:SetPosition(-9.24, 9993.17, 91.61)
            trans:SetEulerAngles(18.93287, 195.2338, 4.957005)
            trans:SetLocalScale(5.4, 5.4, 5.4)
            view.sceneTrans = trans
            if callback then
                callback(trans)
            end
        end
    )
end

--加载角色
local function LoadRoleScene(view, rolepath, callback)
    view:RoleRecycle()
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            trans:SetParentE(view.sceneTrans)
            trans:SetLocalPosition(0, 0, 0)

            --设置  缩放
            local Scale = view.CardData.cfg.Size1 or 1
            trans:SetLocalScale(Scale, Scale, Scale)
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
            view.roleTrans = trans
            view:InitRotPos()
            if callback then
                callback(trans)
            end
        end
    )
end
