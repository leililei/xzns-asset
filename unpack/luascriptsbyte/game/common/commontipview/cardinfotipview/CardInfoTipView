function CardInfoTipView:OnClick_shuxingView_toggleSkill(go, isOn, name)
    if not isOn then
        return
    end
    local skillid = 0
    if name == "$_toggle_skill1" then
        skillid = self.CardData.Skills.skill_3
        if skillid == 0 then
            skillid = self.CardData.sid + 3 * 100 + 1
        end
    elseif name == "$_toggle_skill2" then
        skillid = self.CardData.Skills.skill_4
        if skillid == 0 then
            skillid = self.CardData.sid + 4 * 100 + 1
        end
    elseif name == "$_toggle_skill3" then
        skillid = self.CardData.Skills.skill_5
        if skillid == 0 then
            skillid = self.CardData.sid + 5 * 100 + 1
        end
    elseif name == "$_toggle_skill4" then
        skillid = self.CardData.Skills.skill_1
        if skillid == 0 then
            skillid = self.CardData.sid + 1 * 100 + 1
        end
    end
    local toggle = go:GetComponentE(typeof(CS.UnityEngine.UI.Toggle))
    if skillid ~= 0 then
        require("CommonTipManager"):GetInstance():OpenSkillTip(
            skillid,
            function()
                toggle.isOn = false
            end,
            _G.ConfigManager.card_skills_cfg[skillid].condition_star > self.CardData.lv
        )
    end
end

