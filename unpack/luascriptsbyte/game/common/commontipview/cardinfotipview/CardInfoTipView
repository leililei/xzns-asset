function CardInfoTipView:View_Shuxing_ShowProp()
    local nowProp = self.CardData.NowSumProp
    local SetProp = function(gotable, Attrid, value)
        --描述
        gotable.aortext_des.text = _G.AttrType[Attrid].des
        --当前
        gotable.aortext_value.text = value
        gotable.aorrawimage_icon:LoadImage(_G.ConfigManager.type_attribute_cfg[_G.AttrType[Attrid].ID].icon)
    end

    for key, value in pairs(_G.AttrType) do
        local tNumber = nowProp:GetValueByName(key)
        ---暴击伤害及以后 显示百分比
        if value.percentage == 1 then
            tNumber = (tNumber * 100) .. "%"
        end
        local tTf = nil
        if value.proptype == 1 then
            tTf = self.go_Shuxing.obj_BaseProp:GetChildE(value.sortid - 1)
        else
            if self.isSelf then
                tTf = self.go_table.obj_OtherProp2:GetChildE(value.sortid - 5)
            else
                tTf = self.go_Shuxing.obj_OtherProp:GetChildE(value.sortid - 5)
            end
        end
        if tTf ~= nil then
            if tTf ~= nil then
                local tGotable = _G.GetAutoGoTable(tTf)
                SetProp(tGotable, key, tNumber)
            end
        end
    end
end

