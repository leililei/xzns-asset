local function HideOtherWindow(ui_name)
    local otherWindows = {}
    for k, v in pairs(_G.UIManager:GetInstance().windows) do
        if k ~= ui_name and k ~= "ShadowView" then
            if v.gameObject:GetActiveSelf() == 1 then
                _G.table.insert(otherWindows, v)
                _G.GameUtil.SetActiveByCondition(v.gameObject, false)
            --  _G.UIManager:GetInstance():HideWindow(k)
            --  cavas.enabled = false
            end
        end
    end
    for i = 1, #otherView do
        _G.UIManager:GetInstance():HideWindow(otherView[i])
    end

    return otherWindows
end
