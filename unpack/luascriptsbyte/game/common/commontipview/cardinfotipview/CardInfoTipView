function CardInfoTipView:OnEnable()
    if _G.WorldManager:GetInstance().CurrentWorld.GameObject:GetActiveSelf() == 1 then
        self.isHide = true
    else
        self.isHide = false
    end
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
    if self.sceneTrans ~= nil then --切换时隐藏 禁用场景摄象机
        _G.GameUtil.SetActiveByCondition(self.sceneTrans, true)
    end
