end

function CardInfoTipView:CloseView(go, isOn)
    if self.EquipView then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.EquipmentView.Name)
    end
    --  local tCardBagView = _G.UIManager:GetInstance():ShowWindow(self.CardData.viewName)
    for _, v in pairs(self.hideViews) do
        _G.GameUtil.SetActiveByCondition(v.gameObject, true)
        -- v.enabled = true
    end
    if self.isHide then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
    end
    if self.sceneTrans ~= nil then
        _G.GameUtil.SetActiveByCondition(self.sceneTrans, false)
    end
    if self.callBack then
        self.callBack()
    end
    self.view:CloseTip(_G.TipType.Card, self.CardData.viewName)
    self.gameObject:SetActiveE(0)
    --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.CommonTipView.Name)
end

