function CardInfoTipView:View_InitShuxing()
    local count = 0
    local function initFun()
        count = count - 1
        if count <= 0 then
            self.go_Shuxing_Init = true
            if self.CardData ~= nil then
                self:View_Shuxing()
            end
        end
    end

    local attrType1Count = _G.GameUtil.GetAttrTypeCount(1)
    count = attrType1Count

    for i = 1, count do
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Common/CommonTipView/EquipmentTipView_shuxingitem",
            _G.ePoolType.Default,
            self.go_Shuxing.obj_BaseProp,
            function()
                initFun()
            end
        )
    end

    count = table.count(_G.AttrType)
    for i = 1, count - attrType1Count do
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Card/CardInfoView_shuxingitem",
            _G.ePoolType.Default,
            self.go_Shuxing.obj_OtherProp,
            function()
                initFun()
            end
        )
    end

    count = table.count(_G.AttrType) + table.count(_G.AttrType) - attrType1Count

    for i = 1, table.count(_G.AttrType) - attrType1Count do
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Common/CommonTipView/CardInfoTipView_shuxingitemSec",
            _G.ePoolType.Default,
            self.go_table.obj_OtherProp2,
            function()
                initFun()
            end
        )
    end

    for i = 1, table.count(_G.AttrType) - attrType1Count do
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Common/CommonTipView/EquipmentTipView_shuxingitem",
            _G.ePoolType.Default,
            self.go_Shuxing.obj_OtherProp,
            function()
                initFun()
            end
        )
    end
end
function CardInfoTipView:View_Shuxing()
    self.go_Shuxing.aortext_rolename.text = _G.LangUtil.GetLangPackValue(self.cardCfg.Name)
    self.go_Shuxing.aortext_lv.text = self.CardData.lv
    require("CardInfoManager").LoadRawImage_elements(self.go_Shuxing.aorrawimage_zhiyedi, self.CardData)
    require("CardInfoManager").LoadRawImage_professional(self.go_Shuxing.aorrawimage_zhiye, self.CardData)
