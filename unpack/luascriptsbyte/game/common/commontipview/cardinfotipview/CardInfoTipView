function CardInfoTipView:Init_Drag() -----------------------------------------拖拽  角色旋转
    --拖拽 始角色旋转
    _G.SetEventTrigger(self.go_table.aorrawimage_drag, "onDragBegin", _G.handler(self, self.onDragBegin_Drag))
    _G.SetEventTrigger(self.go_table.aorrawimage_drag, "onDrag", _G.handler(self, self.onDrag_Drag))
    _G.SetEventTrigger(self.go_table.aorrawimage_drag, "onDragEnd", _G.handler(self, self.onDragEnd_Drag))
end

---@param eventData UnityEngine.EventSystems.PointerEventData
function CardInfoTipView:onDragBegin_Drag(go, eventData)
    self.Rotate_startPoint = eventData.position.x
end

---@param eventData UnityEngine.EventSystems.PointerEventData
function CardInfoTipView:onDrag_Drag(go, eventData)
    if eventData.position.x > self.Rotate_startPoint then
        self:Ontemp_rotate(false)
    else
        self:Ontemp_rotate(true)
    end
end
---@param eventData UnityEngine.EventSystems.PointerEventData
function CardInfoTipView:onDragEnd_Drag(go, eventData)
    self.isRoate = false
end

function CardInfoTipView:InitRotPos()
    if _G.IsNil(self.roleTrans) then
        return
    end
    self.roleTrans:SetLocalEulerAngles(0, 0, 0)
end

------角色旋转控制
---@param isRotate_L boolean true顺时针旋转 默认false
---@param Rotate_speed int 旋转速度
function CardInfoTipView:Ontemp_rotate(isRotate_L, Rotate_speed)
    if isRotate_L then
        self.Rotate_lr = 1
    else
        self.Rotate_lr = -1
    end
    if Rotate_speed then
        self.Rotate_speed = Rotate_speed
    else
        self.Rotate_speed = 5
    end

    self.isRoate = true
    if self.temp_rotate == nil then
        self.temp_rotate = _G.coroutine.start(_G.handler(self, self.RotateCoOnProgress))
    end
end
function CardInfoTipView:RotateCoOnProgress() -----------------------------------------拖拽  角色旋转
    while true do
        if self.isRoate == true and self.roleTrans ~= nil then
            if self.roleTrans ~= nil then
                self.roleTrans:Rotate(_G.Vector3.up * self.Rotate_lr, self.Rotate_speed)
            end
        end
        _G.coroutine.waitforendofframe()
    end
end

function CardInfoTipView:RoleRecycle()
    if not _G.IsNil(self.roleTrans) then
        --设置  缩放 回到 1
        local Scale = _G.Vector3.New(1, 1, 1)
        self.roleTrans:SetLocalScale(Scale.x, Scale.y, Scale.z)
        self:InitRotPos()
        _G.PoolsManager:GetInstance():Despawn(self.roleTrans, _G.ePoolType.Temporary)
        self.roleTrans = nil
    end
end

function CardInfoTipView:OnDestroy()
    self:RoleRecycle()

    if not _G.IsNil(self.sceneTrans) then
        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Temporary)
    end
end

