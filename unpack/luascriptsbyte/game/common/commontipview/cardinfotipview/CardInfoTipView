function CardInfoTipView:SetData(CardData)
    local cardid = CardData.sid
    self.cardCfg = _G.ConfigManager.card_cfg[cardid]
    if self.cardCfg == nil then
        if _G.AppSetting.DEBUG then
            _G.Log(cardid, "<color=red>" .. "该Cardid未找到" .. "</color>")
        end
        return
    end
    ---@type CardData  CardData
    self.CardData = CardData
    self.go_table.aorimage_order.SpriteName =
        require("CardInfoManager"):GetInstance():GetCardOrderIcon(self.CardData.cfg.Order)

    if self.go_Shuxing_Init and self.go_Shuxing then
        self:View_Shuxing()
    end

    ---如果初始化过了 就刷新
    -- if self.go_UpStar ~= nil then
    --     self:View_UpStar()
    -- end

    -- if self.go_Wake ~= nil then
    --     self:View_InitWake()
    --     self:View_Wake()
    -- end
    ---是自身出现装备，否则出现二级属性
    if self.isSelf then
        self:UpdateEquip(CardData)
        _G.GameUtil.SetActiveByCondition(self.go_Shuxing.obj_OthrPropContent, false)
        _G.GameUtil.SetActiveByCondition(self.go_Shuxing.obj_EquipmentView, true)
        _G.GameUtil.SetActiveByCondition(self.go_Shuxing.aorbtn_SecProp, true)
        self.go_Shuxing.aortext_midTmp.text = _G.ConfigManager.language_package_cfg[90010600301]
    else
        _G.GameUtil.SetActiveByCondition(self.go_Shuxing.obj_OthrPropContent, true)
        _G.GameUtil.SetActiveByCondition(self.go_Shuxing.obj_EquipmentView, false)
        _G.GameUtil.SetActiveByCondition(self.go_Shuxing.aorbtn_SecProp, false)
        self.go_Shuxing.aortext_midTmp.text = _G.ConfigManager.language_package_cfg[90020300084]
    end

    if self.sceneTrans == nil then
        LoadEmbattleScene(
            self,
            function(sceneTrans)
                LoadRoleScene(
                    self,
                    CardData.cfg.ModelPathHi,
                    function(roleTrans)
                    end
                )
            end
        )
    else
        LoadRoleScene(
            self,
            CardData.cfg.ModelPathHi,
            function(roleTrans)
            end
        )
    end

    --     end,
    --     self,
    --     true
