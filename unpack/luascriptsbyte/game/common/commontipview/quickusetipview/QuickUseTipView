---@class QuickUseTipView : UIBaseView    中文描述
---@field public go_table QuickUseTipView_GoTable GoTable
local QuickUseTipView = _G.BaseClass("QuickUseTipView", _G.UIBaseView)

function QuickUseTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function QuickUseTipView:OnCreate(queneData)
    self.queneData = queneData
    self:RefreshView()
end

---刷新界面
function QuickUseTipView:RefreshView(queneData)
    if queneData then
        self.queneData = queneData
    end
    if not self.queneData then
        self:Close()
        return
    end
    if self.queneData.needNum and self.queneData.itemData and self.queneData.itemData.count
            and self.queneData.needNum > self.queneData.itemData.count then
        self:ShowNextQuene()
        return
    end
    local _data = self.queneData.itemData or {}
    self.go_table.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(self.queneData.sid)
    self.go_table.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { self.queneData.sid, self.queneData.num and self.queneData.num * self.queneData.needNum or
            _data.count or 1 },
        self.go_table.obj_item,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.queneData.cfg.Cpwindow == 9 then
        self.countDown = self.queneData.itemData.args.time - _G.TimeUtil.GetServerUnixTime()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime(0)
    else
        self.go_table.aortext_use.text = _G.GetLangPackValue(90031600056)
    end
end

function QuickUseTipView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        self:Close()
    end
    local time = _G.TimeUtil.TimeToString(_G.Mathf.RoundToInt(self.countDown), 1)
    self.go_table.aortext_use.text = time
end

---展示队列下一个道具
function QuickUseTipView:ShowNextQuene()
    require("QuickUseModel"):GetInstance():RemoveTopQuene()
    self.queneData = require("QuickUseModel"):GetInstance():PopQuene()
    if not self.queneData then
        self:Close()
    else
        self:RefreshView()
    end
end

---界面的销毁函数
function QuickUseTipView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---道具弹窗
function QuickUseTipView:OpenPropwindow()
    local Cpwindow = self.queneData.cfg.Cpwindow
    if Cpwindow then
        if Cpwindow == 1 then
            ---随机道具类型宝箱弹窗
            if not self.queneData or not self.queneData.itemData or not self.queneData.itemData.count then
                if _G.AppSetting.DEBUG then
                    _G.LogError("QuickUseTipView:OpenPropwindow() queneData or itemData is nil, please check! Cpwindow = 1")
                end
                self:ShowNextQuene()
                return
            end
            _G.StorageManager:GetInstance():UsePropToServer(self.queneData.sid, self.queneData.itemData.count,
                _G.handler(self, self.Close))
            -- _G.UIManager:GetInstance():OpenWindow(
            --     _G.ConfigManager.ui_cfg.BagPropPopView.Name,
            --     self.queneData.itemData
            -- )
        elseif Cpwindow == 2 then
            ---自选宝箱类型弹窗
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagChoosePropTipView.Name,
                self.queneData.itemData
            )
        elseif Cpwindow == 3 then
            ---跳转界面使用类型道具弹窗
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagJumpTipView.Name, self.queneData.itemData)
        elseif Cpwindow == 4 then
            ---背包内直接使用的道具类型弹窗
            if not self.queneData or not self.queneData.itemData or not self.queneData.itemData.count then
                if _G.AppSetting.DEBUG then
                    _G.LogError("QuickUseTipView:OpenPropwindow() queneData or itemData is nil, please check! Cpwindow = 4")
                end
                self:ShowNextQuene()
                return
            end
            _G.StorageManager:GetInstance():UsePropToServer(self.queneData.sid, self.queneData.itemData.count,
                _G.handler(self, self.Close))
            -- _G.UIManager:GetInstance():OpenWindow(
            --     _G.ConfigManager.ui_cfg.BagUsePropTipView.Name,
            --     self.queneData.itemData
            -- )
        elseif Cpwindow == 5 then
            ---不可背包内直接使用且不支持跳转的道具类型弹窗
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagPropInfoTipView.Name,
                self.queneData.itemData)
        elseif Cpwindow == 6 then
            ---任务奖励道具类型弹窗
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagTaskTipView.Name,
                self.queneData.itemData
            )
        elseif Cpwindow == 7 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BoxUseView.Name,
                self.queneData.itemData
            )
        elseif Cpwindow == 9 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagVoucherDiscountView.Name,
                self.queneData.itemData
            )
        elseif Cpwindow == 10 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BagTradingCardsDrawView.Name,
                self.queneData.itemData
            )
        end
        self:ShowNextQuene()
    end
end

---按钮点击事件在这里派发
function QuickUseTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:ShowNextQuene()
    elseif go == self.go_table.aorbtn_use then
        ---快捷使用
        if self.queneData.showItemDatas then
            if self.queneData.num == 1 then
                _G.StorageManager:GetInstance():PropBatchUse(self.queneData.itemDatas, true, 2, nil, function()
                    if self.queneData.itemDatas then
                        for _, v in pairs(self.queneData.itemDatas) do
                            require("RedPointManager"):GetInstance():RefreshNode(
                                _G.ConfigManager.redpoint_cfg.BackpackItemDebris.id,
                                v.sid
                            )
                        end
                    end
                    self:ShowNextQuene()
                end)
            else
                _G.StorageManager:GetInstance():PropBatchUse(
                    self.queneData.itemDatas,
                    true,
                    2,
                    nil,
                    function()
                        local cfg = _G.ConfigManager.item_cfg
                        if self.queneData.itemDatas then
                            for _, v in pairs(self.queneData.itemDatas) do
                                if cfg[v.sid] and cfg[v.sid].Field == _G.StorageID.Debris then
                                    require("RedPointManager"):GetInstance():RefreshNode(
                                        _G.ConfigManager.redpoint_cfg.BackpackItemDebris.id,
                                        v.sid
                                    )
                                end
                            end
                        end
                        self:ShowNextQuene()
                    end
                )
                --ZHJH-5517 改为不弹出确认弹窗
                --_G.UIManager:GetInstance():OpenWindow(
                --        _G.ConfigManager.ui_cfg.BagBatchUseView.Name,
                --        2,
                --        self.queneData.itemDatas,
                --        self.queneData.showItemDatas,
                --        _G.handler(self, self.ShowNextQuene)
                --)
            end
        else
            self:OpenPropwindow()
        end
    end
end

return QuickUseTipView
