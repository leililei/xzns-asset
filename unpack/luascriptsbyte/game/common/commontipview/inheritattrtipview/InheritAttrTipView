---@class InheritAttrTipView : Component	中文描述
---@field public go_table _obj_InheritAttrTipView_GoTable GoTable
local InheritAttrTipView = _G.BaseClass("InheritAttrTipView", _G.Component)

function InheritAttrTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function InheritAttrTipView:OnCreate()
end
---初始化界面
---@param data card_inherit_cfg
function InheritAttrTipView:Init(data, star)
    self.cfg = data
    self.star = star
    self.go_table.aortext_title.text = _G.GetLangPackValue(90032400001, _G.GetLangPackValue(self.cfg.name))
    self.attrs = require("CardInheritModel"):GetInstance():GetAttributeDicById(self.cfg.id)
    _G.SortList(
        self.attrs,
        function(a)
            return -_G.AttrType[a[1]].sortid
        end
    )
    self.go_table.scrollloopvectical_attr:InitItemData(#self.attrs, _G.handler(self, self.RefreshItem))
end

function InheritAttrTipView:RefreshItem(index, obj)
    index = index + 1
    ---@type _obj_InheritAttrTipView._obj_attrItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_attr.text = self:GetPropStr(self.attrs[index])
end

function InheritAttrTipView:GetPropStr(attribute)
    if attribute == nil then
        return ""
    end
    local key = attribute[1]
    local num = _G.tonumber(attribute[3])
    local aType = attribute[2] == "1" and _G.AttCountType.other or _G.tonumber(attribute[2])
    num = _G.AttributeClassManager:GetInstance():GetValueWithName(key, num, aType)
    local isPer = attribute[2] == "2" and true or false
    return self:ToPropNum(key, num, isPer)
end

---属性数字转换
---@param key string 属性key
---@param num number 属性值
---@return string 属性值文本
function InheritAttrTipView:ToPropNum(key, num, isPer)
    local numStr
    if _G.AttrType[key].percentage == 1 or isPer then
        num = num * 100
        num = _G.GameUtil.FormatNum(num)
        numStr = _G.tostring(num) .. "%"
    else
        num = _G.math.floor(num)
        num = _G.GameUtil.NumberWY(num)
        numStr = _G.tostring(num)
    end
    return _G.AttrType[key].des .. "<color=#8ed36b>+" .. numStr .. "</color>"
end

---按钮点击事件在这里派发
function InheritAttrTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:CloseTips()
    end
end

function InheritAttrTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip()
end

function InheritAttrTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function InheritAttrTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
end

function InheritAttrTipView:EscClose()
    self:CloseTips()
end

return InheritAttrTipView
