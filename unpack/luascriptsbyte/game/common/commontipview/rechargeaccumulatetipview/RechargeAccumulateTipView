---@class RechargeAccumulateTipView : Component    中文描述
---@field go_table _obj_RechargeAccumulate_GoTable
local RechargeAccumulateTipView = _G.BaseClass("RechargeAccumulateTipView", _G.Component)

function RechargeAccumulateTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.nameOutLine = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline))
end

local Background = {
    [1001] = {"ImagesH5/hRechargeAccumulate/ui_hjflktc_jk", "ImagesH5/hRechargeAccumulate/ui_hjflktc_jk_kuang"},
    [1002] = {"ImagesH5/hRechargeAccumulate/ui_hjflktc_hjk", "ImagesH5/hRechargeAccumulate/ui_hjflktc_hjk_kuang"}
}

function RechargeAccumulateTipView:__init(transform, view, isBag)
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
    self.isBag = isBag
end

---创建对象时,入口构造函数
function RechargeAccumulateTipView:OnCreate()
    self.rect = self.go_table.aorrawimage_itemBg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
end

---@param data TipBaseModel
function RechargeAccumulateTipView:Init(data, ...)
    self.data = data
    local sid = _G.tonumber(data.cfg.UseParameter[1][1])
    local cashCfg = _G.ConfigManager.item_accumulate_cfg[sid]
    self.cashCfg = cashCfg
    self.go_table.aorrawimage_itemBg:LoadImage(Background[sid][1])
    self.go_table.aorrawimage_outLine:LoadImage(Background[sid][2])
    self.go_table.obj_active:SetActiveE(self.isBag and 1 or 0)
    self.go_table.obj_notActive:SetActiveE(0)
    self.go_table.aortext_name.text = _G.GetLangPackValue(data.cfg.Name)

    local gearCfg = _G.ConfigManager.store_gear_cfg[cashCfg.price_max_id]
    local ratio = cashCfg.ratio_recharge / 10000
    local max = gearCfg.price // 100
    self.go_table.aortext_ratio.text = "(" .. max .. ")"
    self.go_table.aortext_max.text = _G.string.AddColor(_G.GetLangPackValue(90034400012, max), "96CE51")
    self.go_table.aortext_tip.text = _G.GetLangPackValue(_G.GameUtil.GetVoucherArg(90034400016, 90036300042), _G.Mathf.Floor(ratio * 100) .. "%")
    if self.isBag then
        self.go_table.aortext_playerName.text = _G.GetLangPackValue(90034400014, _G.GetPlayerName())
        self.go_table.aortext_playerUid.text = _G.GetLangPackValue(90034400015, _G.GetPlayerUid())
        local notMax = data.progress < data:GetRechargeAccMaxProgress()
        self.go_table.aortext_isMax:SetActiveE(notMax and 0 or 1)
        self.go_table.aorbtn_get:SetActiveE(notMax and 0 or 1)
        self.go_table.obj_curNum:SetActiveE(notMax and 1 or 0)
        self.countDown = data:GetRechargeAccEndTime() - _G.TimeUtil.GetServerUnixTime()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime(0)
        if notMax then
            local ten = 1
            local num = _G.Mathf.Floor(data.progress * ratio // 100)
            for i = 1, 5 do
                self.go_table["aortext_n" .. i].text = _G.Mathf.Floor((num // ten) % 10)
                ten = ten * 10
            end
        end
    else
        local time = _G.TimeUtil.TranslateSecondForStr(cashCfg.duration * 86400)
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90034400011, _G.string.AddColor(time, "96CE51"))
    end
    if self.view.SetPos then
        self.view:SetPos(self.rect, data.pos)
    end
end

function RechargeAccumulateTipView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    local time = _G.TimeUtil.TranslateSecondForStr(_G.Mathf.RoundToInt(self.countDown))
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(90034400011, _G.string.AddColor(time, "96CE51"))
end

function RechargeAccumulateTipView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name then
        self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        local sortingOrder = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, sortingOrder + 50)
    end
end

function RechargeAccumulateTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self.gameObject:SetActiveE(0)
        self.view:CloseTip(_G.TipType.RechargeAccumulate)
    elseif go == self.go_table.aorbtn_help then
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 191)
    elseif go == self.go_table.aorbtn_get then
        if not self.isBag then
            return
        end
        if self.countDown == nil or self.countDown <= 0 then
            return
        end
        require("RechargeAccumulateModel"):GetInstance():GetAward(
            self.data,
            function()
                self.view:CloseTip(_G.TipType.RechargeAccumulate)
            end
        )
    end
end

function RechargeAccumulateTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.bgEffect = nil
end

---销毁对象时,析构函数
function RechargeAccumulateTipView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

function RechargeAccumulateTipView:EscClose()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.RechargeAccumulate)
end
return RechargeAccumulateTipView
