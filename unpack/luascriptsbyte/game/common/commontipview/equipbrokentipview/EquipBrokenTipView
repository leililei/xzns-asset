---@class EquipBrokenTipView : Component	中文描述
local EquipBrokenTipView = _G.BaseClass("EquipBrokenTipView", _G.Component)

local CS = _G.CS
local typeof = _G.typeof
local table = _G.table

function EquipBrokenTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function EquipBrokenTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function EquipBrokenTipView:OnCreate()
    self.rect = self.go_table.aorimage_itemBg:GetComponentE(typeof(CS.UnityEngine.RectTransform))
end

function EquipBrokenTipView:Init(data)
    self.sid = data.sid
    local count = data.count
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.sid,
        count or 0,
        self.go_table.obj_root,
        function(item)
            if _G.IsNil(self.go_table.obj_root) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalPosition(0, 0, 0)
            item.gameObject:SetLocalScaleXYZ(1)
        end,
        function()
        end
    )

    local value = _G.StorageManager:GetInstance():GetItemCountBySid(self.sid)
    self.go_table.aortext_haveCount.text = value
    local describe = data.cfg.Describe
    self.go_table.aortext_des.text = not describe and "" or _G.LangUtil.GetLangPackValue(describe)

    local id = _G.GameUtil.GetItemTypeLanguageID(data.cfg.ID)
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aortext_use,
        id > 0 and data.cfg.UseType ~= _G.ItemUseType.GetProp
    )
    if id > 0 then
        self.go_table.aortext_useName.text = _G.LangUtil.GetLangPackValue(data.cfg.title)
    end
    local grade = data.cfg.Quality
    local ctm = require "CommonTipManager":GetInstance()
    self.go_table.aorrawimage_di:LoadImage(ctm:GetItemBgPathByGrade(grade))
    local outlineColor = ctm:GetTipTypeNameOutLineColorByGrade(grade)
    ctm:SetItemTextGradient(self.go_table.aortext_name, grade)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = _G.ColorTools.FormatColorByString(outlineColor)

    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)

    local effectPath = ctm:GetItemBgEffectPathByGrade(grade)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )

    self.showEquipIndex = 1
    self.propItemDic = {}
    self:InitEquipInfo()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local delay = _G.ConfigManager.discrete_cfg[104910][1][1]
    self.timer = _G.TimerManager:GetInstance():GetTimer(delay, self.OnTimeCall, self, false, false)
    self.timer:Start()
    --self.view:SetPos(self.rect, data.pos)
end

---初始化属性
function EquipBrokenTipView:InitAttribute()
    local advance = _G.ConfigManager.stone_cfg[self.sid].advance
    local cfgs =_G.ConfigManager.equipment_cfg
    local propList = {}
    for _, v in pairs(_G.AttrType) do
        ---当前装备
        local leftEquipId = advance[self.showEquipIndex][1]
        local leftEquipCfg = cfgs[leftEquipId]
        ---突破后的装备
        local rightEquipId = advance[self.showEquipIndex][2]
        local rightEquipCfg = cfgs[rightEquipId]
        if leftEquipCfg[v.key] and leftEquipCfg[v.key] > 0 then
            ---突破前和突破后的装备属性一定是一样的，否则无法对比（不一样就是配错了）
            table.insert(propList, {
                name = v.des,
                percentage = v.percentage,
                sortid = v.sortid,
                leftNum = leftEquipCfg[v.key],
                rightNum = rightEquipCfg[v.key] or 0
            })
        end
    end

    ---装备属性显示排序
    _G.table.sort(
        propList,
        function(a, b)
            return a.sortid < b.sortid
        end
    )

    local obj
    for i, v in ipairs(propList) do
        ---生成属性条
        if not self.propItemDic[i] then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.obj_propGrid)
            _G.table.insert(self.propItemDic, obj)
        else
            obj = self.propItemDic[i]
        end

        local leftNum, rightNum
        if v.percentage == 1 then
            leftNum = _G.GameUtil.FormatNum(v.leftNum * 0.01) .. "%"
            rightNum = _G.GameUtil.FormatNum(v.rightNum * 0.01) .. "%"
        else
            leftNum = _G.math.floor(v.leftNum)
            rightNum = _G.math.floor(v.rightNum)
        end
        local go_table = _G.GetAutoGoTable(obj)
        go_table.aorimage_di:SetActiveE(i % 2 == 0 and 0 or 1)
        go_table.aortext_des.text = v.name
        go_table.aortext_num.text = leftNum
        go_table.aortext_num1.text = rightNum
        obj:SetActiveE(1)
    end

    for i = #propList + 1, #self.propItemDic do
        self.propItemDic[i]:SetActiveE(0)
    end
end

---初始化装备
function EquipBrokenTipView:InitEquipInfo()
    local advance = _G.ConfigManager.stone_cfg[self.sid].advance
    ---当前装备
    local leftEquipId = advance[self.showEquipIndex][1]
    self.go_table.obj_item1:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        leftEquipId,
        1,
        self.go_table.obj_item1,
        function(item)
            if _G.IsNil(self.go_table.obj_item1) then
                _G.DestroyObject(item.gameObject)
                return
            end

            item.gameObject:SetLocalScaleXYZ(0.8)
            local equipmentData = _G.StorageManager:GetInstance():GetDatasBySid(
                _G.StorageID.Equipment,
                leftEquipId
            )
            if table.isEmptyOrNil(equipmentData) then
                item.go_table.aortext_num.text = _G.string.format("<color=#e33f3f>%s</color>/%s", 0, 1)
            else
                local count = 0
                for _, v in pairs(equipmentData) do
                    count = v.count + count
                end
                item.go_table.aortext_num.text = count .. "/" .. 1
            end
        end
    )

    ---消耗的道具
    self.go_table.obj_item2:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.sid,
        0,
        self.go_table.obj_item2,
        function(item)
            if _G.IsNil(self.go_table.obj_item2) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.8)
        end,
        function()end
    )

    ---当前装备
    local rightEquipId = advance[self.showEquipIndex][2]
    self.go_table.obj_item3:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        rightEquipId,
        0,
        self.go_table.obj_item3,
        function(item)
            if _G.IsNil(self.go_table.obj_item3) then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.8)
        end
    )
    self:InitAttribute()
    self.refreshEquipInfo = false
end

function EquipBrokenTipView:OnTimeCall()
    self.refreshEquipInfo = true
    local advance = _G.ConfigManager.stone_cfg[self.sid].advance
    if self.showEquipIndex >= #advance then
        self.showEquipIndex = 1
    else
        self.showEquipIndex = self.showEquipIndex + 1
    end
    self:InitEquipInfo()
end

function EquipBrokenTipView:OnClcikArrow(change)
    if self.refreshEquipInfo then
       return
    end

    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end

    self.showEquipIndex = self.showEquipIndex + change
    local advance = _G.ConfigManager.stone_cfg[self.sid].advance
    if self.showEquipIndex > #advance then
        self.showEquipIndex = 1
    elseif self.showEquipIndex <= 0 then
        self.showEquipIndex = #advance
    end
    self:InitEquipInfo()
end

function EquipBrokenTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self.view:CloseTip(_G.TipType.EquipBrokenMaterial)
    elseif go == self.go_table.aorbtn_leftArrow then
        self:OnClcikArrow(-1)
    elseif go == self.go_table.aorbtn_rightArrow then
        self:OnClcikArrow(1)
    end
end

function EquipBrokenTipView:EscClose()
    self.view:CloseTip(_G.TipType.EquipBrokenMaterial)
end

---销毁对象时,析构函数
function EquipBrokenTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return EquipBrokenTipView
