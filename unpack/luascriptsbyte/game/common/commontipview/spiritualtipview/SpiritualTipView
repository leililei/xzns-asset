local SpiritualTipView = _G.BaseClass("SpiritualTipView", _G.Component)
local CommonTipManager = require("CommonTipManager"):GetInstance()
local OrderCfg = {
    [1] = {"Images/nArtifact/ui_sqzs_zise", _G.ColorTools.FormatColorByString("e399ff")}, --紫
    [2] = {"Images/nArtifact/ui_sqzs_chengse", _G.ColorTools.FormatColorByString("ffdaac")}, --橙
    [3] = {"Images/nArtifact/ui_sqzs_hongse", _G.ColorTools.FormatColorByString("fcc0ae")}, --红
    [4] = {"Images/nArtifact/ui_sqzs_caise", _G.ColorTools.FormatColorByString("b381ff")} --彩
}

function SpiritualTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local card_skills_cfg = _G.ConfigManager.card_skills_cfg
local GetLangPackValue = _G.GetLangPackValue

---界面的入口函数
function SpiritualTipView:OnCreate()
    self.rect = self.go_table.obj_SpiritualDescribe:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
end

---初始化界面
---@param data SpiritualData
---@param btn table {left = {name = string, func = function, close = boolean},right = {...}, middle = {...}}
function SpiritualTipView:Init(data, btn, hideCount)
    self.data = data
    self.btn = btn
    self:InitTopSuit()
    self:ShowBase(hideCount)
    self:ShowProp(data)
    self:ShowSkill()
    self:ShowBtn()
end

---@private
function SpiritualTipView:ShowBase(hideCount)
    local order = self.data:GetCfg().Order + 3
    if order == 7 then
        order = 8
    end
    local outlineColor = _G.ColorTools.FormatColorByString(CommonTipManager:GetTipTypeNameOutLineColorByGrade(order))
    self.go_table.aortext_name.text = self.data:GetName()
    CommonTipManager:SetItemTextGradient(self.go_table.aortext_name, order)
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_level.text = GetLangPackValue(90021800050) .. "<color=#ffd65b>" .. self.data:GetLevel() .. "</color>"
    self.go_table.aortext_level:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_power.text = GetLangPackValue(90000000404, "<color=#ffd65b>" .. _G.GameUtil.NumberToUnitStrBag(self.data:GetPower())  .. "</color>")
    self.go_table.aortext_power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    local Order = self.data:GetOrder()
    --self.go_table.aortext_name.color = OrderCfg[Order][2]
    --self.go_table.aortext_level.color = OrderCfg[Order][2]
    --self.go_table.aortext_power.color = OrderCfg[Order][2]
    
    --背景特效
    local effNode = self.go_table.obj_bgEffect and self.go_table.obj_bgEffect or self.go_table.obj_EffNode
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[CommonTipManager:GetItemBgEffectPathByGrade(order)],
            effNode
    )
    
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shipingyangcheng,
            self.go_table.obj_Eff,
            function(obj)
                if self.go_table==nil then
                    _G.DestroyObject(obj)
                    return
                else
                    obj:SetActiveE(1)
                end
            end
    )
    self.go_table.aorrawimage_gradeBG:LoadImage(
            CommonTipManager:GetItemBgPathByGrade(order),
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                end
            end
    )
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemSpiritualBase,
        self.go_table.obj_item,
        function(item)
            if not self.go_table then
                _G.ItemFactory:GetInstance():SetItemCard(item)
                return
            end
            item.gameObject:SetRectTransformAnchorMin(0.5, 0.5)
            item.gameObject:SetRectTransformAnchorMax(0.5, 0.5)
            item:ShowData(self.data, function()  end)
            item:HideLevel()
            if hideCount then
                item:HideCount()
            end
            item:SetSize(80)
            item:SetEffect()
        end
    )
    if self.data.cfg.Instruction then
        self.go_table.aortext_desc.text = _G.GetLangPackValue(self.data.cfg.Instruction)
    end
end

---点击超链接
function SpiritualTipView:OnHrefClick(id, name, asa)
    local weight, height = self.rect:GetRectTransformWidthHeight()
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

---显示技能
function SpiritualTipView:ShowSkill()
    local cfg = self.data:GetCfg()

    local skillDesExText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text = require("SpiritualModel").GetStarSkillDes(cfg.id, 0)
    local objRTF = self.go_table.obj_skill:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(objRTF)
    local x, y = objRTF:GetRectTransformSizeDelta()
--[[    if y < 150 then
        self.go_table.scrollrect_baseSkill:SetRectTransformSize(x, y, 0)
    else
        self.go_table.scrollrect_baseSkill:SetRectTransformSize(x, 150, 0)
    end]]

    for i = 1, #cfg.skill_id - 1 do
        local obj = _G.InstantiateObject(self.go_table.obj_skillItem, self.go_table.trans_content)
        local tb = _G.GetAutoGoTable(obj)
        tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
        local color = self.data.star < i and "a9a9a37F" or "76DAF8FF"
        tb.DesExText.color = _G.ColorTools.FormatColorByString(color)
        local tempStr = _G.GetLangPackValue(90000010475, i)
        if string.contains(tempStr,"星") then
            --小程序无法显示对应占位符，改为不替换文本，用改小的两个*占位
            tempStr = string.replace(tempStr,"星","<color=#00000000>**</color>")
            tb.obj_star:SetActiveE(1)
            if i >= 10 then
                tb.obj_star:SetAnchorPosition(-45, -2.5)
            else 
                tb.obj_star:SetAnchorPosition(-57, -2.5)
            end
        else 
            tb.obj_star:SetActiveE(0)
        end
        tb.DesExText.text = tempStr .. ":".. require("SpiritualModel").GetStarSkillDes(cfg.id, i)
        tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
    end

    if #cfg.skill_id <= 1 then
        self.go_table.obj_gap:SetActiveE(0)
        self.go_table.trans_content:SetActiveE(0)
    end
end

---获取基本技能描述
function SpiritualTipView:GetSkillDesBase(id)
    if card_skills_cfg[id] then
        return GetLangPackValue(card_skills_cfg[id].describe1)
    else
        return id
    end
end

---获取技能描述
function SpiritualTipView:GetSkillDes(index, id)
    if card_skills_cfg[id] then
        return GetLangPackValue(90022300084, index, GetLangPackValue(card_skills_cfg[id].describe1))
    else
        return GetLangPackValue(90022300084, index, id)
    end
end

---统计刷新
function SpiritualTipView:calcProp(prop)
    local showList = {}
    for i, v in pairs(prop) do
        if v > 0 then
            _G.table.insert(showList, {key = i, sortId = _G.AttrType[i].sortid, num = v})
        end
    end
    _G.SortList(
        showList,
        function(a)
            return -a.sortId
        end
    )
    local index = 1
    for _, v in pairs(showList) do
        index = index + 1
        local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, self.go_table.obj_PropContent)
        if tran then
            local tb = _G.GetAutoGoTable(tran)
            if index % 4 == 0 then
                tb.aorimage_Bg:SetActiveE(1)
            end
            tb.aortext_Name.text = _G.AttrType[v.key].des
            local numStr = v.num
            if _G.AttrType[v.key].percentage == 1 then
                numStr = _G.GameUtil.FormatNum(numStr * 100)
                numStr = "<color=#6effc6>" .. numStr .. "%</color>"
            else
                numStr = _G.GameUtil.NumberWY(_G.math.floor(numStr))
            end
            tb.aortext_Num.text = numStr
        end
    end
end

---设置属性
function SpiritualTipView:ShowProp(data)
    local ChildCount = self.go_table.obj_PropContent:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(self.go_table.obj_PropContent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    if data.attribute then
        local prop = self.data.attribute:GetAttrByName()
        self:calcProp(prop)
    end
end

---@private
function SpiritualTipView:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

---按钮点击事件在这里派发
function SpiritualTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_shuoming" then

           _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.RecommendHeroTipsView.Name,
            self.data.sid

        )
    end
end

function SpiritualTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end
function SpiritualTipView:InitTopSuit()
    if not self.go_table.obj_SpiritualSuit then
        return
    end
    if self.data.cfg.suit==0  then
        self.go_table.obj_SpiritualSuit:SetActiveE(0)
    else
        local suitcfg=_G.ConfigManager.spiritual_suit_cfg[self.data.cfg.suit]
        self.go_table.obj_SpiritualSuit:SetActiveE(1)
        local str=string.format("%s(%s/%s)",GetLangPackValue(suitcfg.name),#suitcfg.name2,#suitcfg.name2)
        local textcolor="60a93b"
        self.go_table.aortext_suitName.text=string.format("<color=#%s>%s</color>",textcolor,str)
        self.go_table.obj_skillitem:SetActiveE(1)
        self.go_table.obj_suitSkillContent:ClearChildren()
        for i = 1, #suitcfg.att_suit2 do
            textcolor="76DAF8"
            local skillitem=_G.InstantiateObject(self.go_table.obj_skillitem,self.go_table.obj_suitSkillContent)
            local tb=_G.GetAutoGoTable(skillitem)
            local skillcfg=_G.ConfigManager.card_skills_cfg[suitcfg.att_suit2[i][2]]
            tb.aortext_skillitem.text=string.format("<color=#%s>%s</color>",textcolor,GetLangPackValue(skillcfg.describe1))
            _G.GameUtil.ReBuildRTF(skillitem)
        end
        _G.GameUtil.ReBuildRTF(self.go_table.obj_suitSkillContent)
        self.go_table.obj_skillitem:SetActiveE(0)
        self.suitlist={}
        for i = 1, #suitcfg.name2 do
            table.insert(self.suitlist,{sid=suitcfg.name2[i],isactive=1 })
        end
        _G.SortList(self.suitlist,function(item)
            return item.isactive,item.sid
        end)
        if not self.suitinit then
            self.go_table.scrollloophorizontal_suitlist:InitItemData(#self.suitlist, _G.handler(self, self.RefreshskillItem))
            self.suitinit=true
        else
            self.go_table.scrollloophorizontal_suitlist:UpdateCount(#self.suitlist)
        end
    end
end
function SpiritualTipView:RefreshskillItem(index, obj)
    local _index=index+1
    local suititem=self.suitlist[_index]
    local tb=_G.GetAutoGoTable(obj)
    ---@type SpiritualData
    local itemdata=_G.StorageManager:GetInstance():GetItemDataClass(suititem.sid)
    tb.aortext_name.text=string.format("<color=%s>%s</color>",suititem.isactive==1 and "#fafaeb" or "#c1bed4",
            GetLangPackValue(itemdata.cfg.Name))
    tb.obj_lock:SetActiveE(suititem.isactive==1 and 0 or 1)
    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemSpiritualBase,
            tb.obj_root,
            function(item)
                if _G.IsNil(tb.obj_root) then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                    return
                end
                item:ShowData(itemdata, function() end)
                item:HideLevel()
                item:HideCount()
                item:SetSize(80)
                item:HideStar()
                item:HideCardBound()
                --item:ShowEffectOrder(itemdata:GetOrder()==4)
                item.go_table.obj_uieffect:SetLocalScale(0.8,0.8)
            end
    )
end

function SpiritualTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function SpiritualTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

function SpiritualTipView:EscClose()
    self:CloseTips()
end

return SpiritualTipView
