---@class BuildTipView : Component	中文描述
---@field public go_table _obj_BuildTipView_GoTable GoTable
local BuildTipView = _G.BaseClass("BuildTipView", _G.Component)

function BuildTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local card_skills_cfg = _G.ConfigManager.card_skills_cfg
local GetLangPackValue = _G.GetLangPackValue
local OrderCfg = {
    [5] = { "ImagesH5/hCommon/ui_img_chengse", 5, 90031300006 }, --橙
    [6] = { "ImagesH5/hCommon/ui_img_hongse", 6, 90031300007 },  --红
    [8] = { "ImagesH5/hCommon/ui_img_caise", 8, 90031300008 },   --彩
}

---界面的入口函数
function BuildTipView:OnCreate()
end

---初始化界面
---@param data BuildData
---@param btn table {left = {name = string, func = function, close = boolean},right = {...}, middle = {...}}
function BuildTipView:Init(data, isMax, isNarrow, isBottom)
    if self.go_table.obj_BuildTipItem then
        self.go_base = _G.GetAutoGoTable(self.go_table.obj_BuildTipItem, _G.handler(self, self.OnClickBtn))
    else
        self.go_base = self.go_table
    end
    self.data = data
    self.isNarrow = isNarrow
    self.isBottom = isBottom
    self:ShowBase()
    self:ShowPropByCfg(data)
    self:ShowSkill()
    self:ShowSkillTag()
    _G.GameUtil.ReBuildRTF(self.go_base.gameObject)
    if self.go_base.obj_parent and self.go_base.obj_parent1 then
        _G.DelayDo(0.2, function()
            _G.GameUtil.ReBuildRTF(self.go_base.obj_parent1)
            _G.GameUtil.ReBuildRTF(self.go_base.obj_parent)
            _G.GameUtil.ReBuildRTF(self.go_base.obj_Content)
        end)
    end
end

---@private
function BuildTipView:ShowBase()
    self.go_base.aortext_name.text = self.data:GetName()
    local order = self.data:GetOrder()
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_base.aortext_name, OrderCfg[order][2])
    ctm:SetItemTextGradient(self.go_base.aortext_order, OrderCfg[order][2])
    --self.go_base.aortext_order.text = GetLangPackValue(90022300086, GetLangPackValue(OrderCfg[order][3]))
    local outlineColor = _G.ColorTools.FormatColorByString(ctm:GetTipTypeNameOutLineColorByGrade(OrderCfg[order][2]))
    self.go_base.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    --self.go_base.aortext_order:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_base.aortext_power:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor

    --背景
    local backBg = self.go_base.aorrawimage_di and self.go_base.aorrawimage_di or self.go_base.aorrawimage_gradeBG
    local path = ctm:GetItemBgPathByGrade(OrderCfg[order][2])
    if backBg then
        backBg:LoadImage(path)
    end

    --self.go_base.aortext_order.color = OrderCfg[order][2]
    --self.go_base.aortext_name.color = OrderCfg[order][2]
    --背景特效
    local effNode = self.go_base.obj_bgEffect and self.go_base.obj_bgEffect or self.go_base.obj_EffNode
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg
        [require("CommonTipManager"):GetInstance():GetItemBgEffectPathByGrade(OrderCfg[order][2])],
        effNode
    )

    self.go_base.aorrawimage_gradeBG:LoadImage(
        OrderCfg[order][1],
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
        end
    )
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBuildBase,
        self.go_base.obj_item,
        function(item)
            item:ShowData(
                self.data,
                function()
                end
            )
            item:SetSize(90)
            item:ShowOrHideProfessional(false)
        end
    )
    local effectPath = ctm:GetItemBgEffectPathByGrade(OrderCfg[order][2])
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[effectPath],
        self.go_base.obj_bgEffect,
        function(trans)
            if _G.IsNil(trans) then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

---显示技能tag
function BuildTipView:ShowSkillTag()
    local lanID, obj, tb
    for i = 1, self.go_base.obj_skillTagContent:GetChildCountE() do
        self.go_base.obj_skillTagContent:GetChildE(i - 1):SetActiveE(0)
    end
    for i = 1, 3 do
        lanID = self.data.cfg["pet_position" .. i]
        if lanID and lanID > 0 then
            if self.go_base.obj_skillTagContent:GetChildCountE() <= i then
                obj = _G.InstantiateObject(self.go_base.obj_skillTagItem, self.go_base.obj_skillTagContent)
            else
                obj = self.go_base.obj_skillTagContent:GetChildE(i)
            end
            obj:SetActiveE(1)
            tb = _G.GetAutoGoTable(obj)
            --tb.aorimage_bg.SpriteName = i == 1 and "ui_js_biaoqian_jnleixing" or "ui_js_biaoqian_zhanwei"
            tb.aortext_tagName.text = _G.GetLangPackValue(lanID)
        end
    end
end

---点击超链接
function BuildTipView:OnHrefClick(id, name, asa)
    local rect = self.go_base.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    local posX, posY = rect:GetRectTransformWidthHeight()
    if self.isBottom then
        posY = posY * 1.5
    end
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, posX, posY, self.isNarrow)
end

---显示技能
function BuildTipView:ShowSkill()
    local cfg = self.data:GetCfg()
    self.starSkills = {}



    local skillDesExText = self.go_base.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))
    skillDesExText.text = self:GetSkillDesBase(cfg.skill_id[1])
    skillDesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

    for i = 2, #cfg.skill_id do
        _G.table.insert(self.starSkills, cfg.skill_id[i])
    end
    _G.PoolsManager:GetInstance():Spawn(
            "UIH5/Common/CommonTipView/View/$_obj_starSkillItem",
            _G.ePoolType.Temporary,
            self.go_base.trans_content,
            function(trans)
                for i = 1, #self.starSkills do
                    local obj=_G.InstantiateObject(trans,self.go_base.trans_content)
                    local tb = _G.GetAutoGoTable(obj)
                    tb.gameObject:SetRectTransformSize(320, 26)
                    tb.DesExText = tb.obj_upDes:GetComponentE(_G.typeof(_G.CS.ExtendText))
                    tb.DesExText:SetRectTransformSize(224 * 1.4, 72)
                    local color = self.data.star < i and "A9A9A3" or "76DAF8"
                    tb.DesExText.color = _G.ColorTools.FormatColorByString(color)
                    tb.DesExText.text = self:GetSkillDes(i, self.starSkills[i])
                    tb.DesExText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
                    tb.aortext_star.text = i
                end
                _G.DestroyObject(trans)
                self.go_base.trans_content:SetActiveE(#self.starSkills == 0 and 0 or 1)
                _G.GameUtil.ReBuildRTF(self.go_base.trans_content)
                _G.GameUtil.ReBuildRTF(self.go_base.obj_Content)
            end
    )
end

---获取基本技能描述
function BuildTipView:GetSkillDesBase(id)
    local baseSkillCfg = _G.ConfigManager.attribute_cfg[id]

    local LanID = baseSkillCfg.describe
    if LanID == 0 then
        LanID = _G.ConfigManager.card_skills_cfg[baseSkillCfg.skill].describe1
    end

    if baseSkillCfg then
        return GetLangPackValue(LanID)
    else
        return id
    end
end

---获取技能描述
function BuildTipView:GetSkillDes(index, id)
    local baseSkillCfg = _G.ConfigManager.attribute_cfg[id]
    local LanID = baseSkillCfg.describe
    if LanID == 0 then
        LanID = _G.ConfigManager.card_skills_cfg[baseSkillCfg.skill].describe1
    end

    if baseSkillCfg then
        return GetLangPackValue(LanID)
    else
        return GetLangPackValue(90022300084, index, id)
    end
end

---展示属性
---@param data BuildData
function BuildTipView:ShowPropByCfg(data)
    ---@type AttributeClass
    local attribute=self.data:GetAttributeDict(not self.data:GetIsActive(), true)
    local attrDic = attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    data:CalculatePower()
    local power = "<color=#fc9948>" .. data:GetCalculatePower() .. "</color>"
    self.go_base.aortext_power.text = _G.GetLangPackValue(90020100027) .. power
    local numStr, num, tb, tran, key, typelist
    local showList={}
    typelist=_G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    for k,v in pairs(typelist) do
        table.insert(showList,v.key)
    end
    _G.SortList(
            showList,
            function(a)
                return  -_G.AttrType[a].sortid
            end
    )
    local showProp = function(name,numStr,parent)
        local tran,tb
        tran = _G.InstantiateObject(self.go_base.obj_BaseProp, parent)
        tb = _G.GetAutoGoTable(tran)
        tb.aortext_Name.text = name
        tb.aortext_Num.text = numStr 
    end
    for i = 1, #showList do
        key=showList[i]
        if table.ContainsKey(attrDic,key) then
            num = attrDic[key]
            if _G.AttrType[key].percentage == 1 then
                num =  _G.Mathf.RoundToInt(num) / 100
                num = _G.GameUtil.FormatNum(num)
                numStr = tostring(num) .. "%"
            else
                local numOld = _G.math.floor(_G.Mathf.RoundToInt(num))
                numOld = _G.GameUtil.NumberWY(numOld)
                numStr = numOld
            end
            showProp(_G.AttrType[key].des,numStr,self.go_base.obj_PropContent)
        end
    end
    for i = 1, #showList do
        key=showList[i]
        if table.ContainsKey(Percentattr,key) then
            num = Percentattr[key]
            num = num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = tostring(num) .. "%"
            showProp(_G.string.AddColor(_G.GetLangPackValue(90033800108,_G.AttrType[key].des),"ff8331"),_G.string.AddColor(numStr,"ff8331"),self.go_base.obj_PropContent1)
        end
    end
end

---按钮点击事件在这里派发
function BuildTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    end
end

function BuildTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.EquipmentCommendOnly)
end

function BuildTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function BuildTipView:Dispose()
    self.go_base = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
end

function BuildTipView:EscClose()
    self:CloseTips()
end

return BuildTipView
