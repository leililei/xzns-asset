---@class GamePlayDescribeView : UIBaseView	中文描述
---@field public go_table GamePlayDescribeView_GoTable GoTable
local GamePlayDescribeView = _G.BaseClass("GamePlayDescribeView", _G.UIBaseView)
--_G.GamePlayDescribeView = GamePlayDescribeView

local CS = _G.CS
local typeof = _G.typeof

function GamePlayDescribeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GamePlayDescribeView:OnCreate(id, callback, title)
    self.callback = callback
    self:Show(id, title)
end

---按钮点击事件在这里派发
function GamePlayDescribeView:OnClickBtn(go)
    if self.callback then
        self.callback()
    end
    self:Close()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

function GamePlayDescribeView:Show(id, title)
    if not id or id <= 0 then
        return
    end
    local cfg = _G.ConfigManager.instruction_cfg[id]
    if cfg then
        local lanId = cfg.describe
        if lanId == 91200013508 then
            lanId = _G.GameUtil.GetVoucherArg(lanId, 90036300040)
        end
        self.go_table.aortext_describe.text = _G.LangUtil.GetLangPackValue(lanId)
    end

    if title then
        self.go_table.aortext_font.text = _G.LangUtil.GetLangPackValue(title)
    end
end

return GamePlayDescribeView
