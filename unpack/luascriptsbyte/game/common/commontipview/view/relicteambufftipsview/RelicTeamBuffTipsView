end
---创建对象时,入口构造函数
---@param data  equipment  装备的数据
function EquipmentTipView:OnCreate(data)

    self.rect = self.go_table.obj_relicTeamBufflDescribe:GetComponentE(typeof(CS.UnityEngine.RectTransform))
end

---tip初始化
---@param data EquipmentTipModel
function EquipmentTipView:Init(data, commends)
    if data == nil then
        return
    end
    self.count = 0
    self.sid = data
    self.cfg = _G.ConfigManager.relic_effect_cfg
    self.buffData = self.cfg[data]
    self.isUpdateLayout = true
    self:ShowInfo()
    self:UpdateLayout()
end

function EquipmentTipView:UpdateLayout()
    self.count = self.count - 1
    if self.count > -1 then
        return
    end
    self.AllContentF = self.transform:GetComponentsInChildren(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    self.AllRect = {}
    for i = 0, self.AllContentF.Length - 1 do
        local rect = self.AllContentF[i]:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        _G.table.insert(self.AllRect, rect)
    end
    for i = 1, #self.AllRect do
        CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.AllRect[i])
    end
    self.isUpdateLayout = false
end

function EquipmentTipView:ShowInfo()
    if self.buffData == nil then
        return
    end
    ---@type CommonTipManager
    self.go_table.aortext_name.text = _G.GetLangPackValue(self.buffData.name)
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, self.buffData.grade > 6 and 8 or self.buffData.grade)
    self.go_table.aorrawimage_di:LoadImage(ctm:GetItemBgPathByGrade(self.buffData.grade > 6 and 8 or self.buffData.grade))
    ---@type UnityEngine.Component 彩色描边
    local outLineColor = CommonTipManager:GetInstance():GetTipTypeNameOutLineColorByGrade(self.buffData.grade > 6 and 8 or self.buffData.grade)
    self.nameOutLine.OutlineColor = _G.ColorTools.FormatColorByString(outLineColor)
    self.go_table.aortext_haveNum:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
    _G.ColorTools.FormatColorByString(outLineColor)
    self:RefreshBgEffect(self.buffData.grade > 6 and 8 or self.buffData.grade)
    local haveNum = require "RelicTeamModel":GetInstance():GetBuffNum(self.sid)
    self.go_table.aortext_haveNum.text = _G.LangUtil.GetLangPackValue(90000010363, "<color=#72c946>" .. haveNum .. "</color>")
    -- _G.ItemFactory:GetInstance():GetItemCard(
    --         _G.ItemFactory.itemType.ItemEquipmentBase,
    --         self.go_table.trans_iconbg,
    --         function(item)
    --             -- 传入空点击回调，防止点击图标弹出tip
    --             item:ShowData(self.buffData,function() end)
    --             --item.gameObject:SetLocalScaleXYZ(1.11)
    --         end
    -- )
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.sid,
        1,
        self.go_table.trans_iconbg,
        function(item)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(item.go_table.gameObject)
                return
            end
        end,
        function()

        end
    )
    -- table.sort(
    --         attr,
    --         function(a, b)
    --             return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
    --         end
    -- )
    self.count = self.count + #self.buffData.attribute
    for i = 1, #self.buffData.attribute do
        _G.PoolsManager:GetInstance():Spawn(
            PrefabsPath.BaseProp,
            _G.ePoolType.UIItem,
            self.go_table.obj_basePropContent,
            function(trans)
                self:SetBasePropData(trans, self.buffData.attribute[i], i)
            end
        )
    end
end

function EquipmentTipView:SetBasePropData(tran, data, index)
    local tb = _G.GetAutoGoTable(tran)
    tb.aortext_des.text = _G.AttrType[data[1]].des
    tb.aortext_value.text = _G.AttributeClassManager:GetInstance():GetShowProp(data[1], data[2], data[3], 1)
    self:UpdateLayout()
end

---刷新背景特效
function EquipmentTipView:RefreshBgEffect(quality)
    local effectPath = CommonTipManager:GetInstance():GetItemBgEffectPathByGrade(quality)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )
end

---销毁对象时,析构函数
function EquipmentTipView:OnDestroy()
end

function EquipmentTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.RelicTeamBuff)
end
function EquipmentTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function EquipmentTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.bgEffect = nil
end

return EquipmentTipView
