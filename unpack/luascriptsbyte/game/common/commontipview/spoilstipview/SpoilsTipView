local SpoilsModel = require("SpoilsModel")
local CardInfoManager = require("CardInfoManager")
---@class SpoilsTipView : Component	中文描述
---@field public go_table _obj_SpoilsTipView_GoTable GoTable
local SpoilsTipView = _G.BaseClass("SpoilsTipView", _G.Component)

local OrderCfg = {
    [5] = { "ImagesH5/hCommon/ui_img_chengse", 5, 90031300006 }, --橙
    [6] = { "ImagesH5/hCommon/ui_img_hongse", 6, 90031300007 },  --红
    [8] = { "ImagesH5/hCommon/ui_img_caise", 8, 90031300008 },   --彩
}

-- tip中item背景特效，根据品阶不同
local ItemBgEffectPath = {
    [3] = "ef_TipView_lan",
    [4] = "ef_TipView_zi",
    [5] = "ef_TipView_cheng",
    [6] = "ef_TipView_hong",
    [7] = "ef_TipView_chai",
    [8] = "ef_TipView_chai"
}
function SpoilsTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SpoilsTipView:OnCreate()
    self.Quility = {
        [4] = "ui_js_txk_zi",
        [5] = "ui_js_txk_cheng",
        [6] = "ui_js_txk_hong",
        [8] = "ui_js_txk_cai",
    }
end

---初始化界面
---@param sp SpoilsData
---@param btn table {left = {name = string ,onclickFunc = function },right = {name = string ,onclickFunc = function }}
function SpoilsTipView:Init(sp)
    local ctm = require "CommonTipManager":GetInstance()
    local order = sp.cfg.Order
    local outlineColor = _G.ColorTools.FormatColorByString(ctm:GetTipTypeNameOutLineColorByGrade(OrderCfg[order][2]))
    self.sp = sp
    self.go_table.aortext_name.text = _G.GetLangPackValue(sp.cfg.Name)
    local power = sp:GetPower()
    self.go_table.aortext_power.text = _G.GetLangPackValue(90033900031, power)
    self.go_table.aorimage_bg.SpriteName = self.Quility[sp.cfg.Order]
    local cfg= _G.ConfigManager.item_cfg[sp.cfg.item]
    self.go_table.aorrawimage_icon:LoadImage(cfg.Icon)
    self.go_table.obj_stars:SetActiveE(sp:GetIsActive() and 1 or 0)
    self.go_table.obj_tips:SetActiveE(0)
    local star = sp:GetStar()
    local starNum = self.go_table.obj_stars:GetChildCountE()
    if star == 0 then
        for level = 2, starNum do
            self.go_table.obj_stars:GetChildE(level - 1):SetActiveE(0)
        end
    else
        local tmpstar = star % 5
        local blstar = star / 5
        if tmpstar == 0 then
            tmpstar = star
        end
        for level = 2, starNum do
            local obj = self.go_table.obj_stars:GetChildE(level - 1)
            local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
            if level - 1 <= tmpstar then
                obj:SetActiveE(1)
                if blstar > 1 then
                    image.SpriteName = "ui_img_xing_hong"
                else
                    image.SpriteName = "ui_img_xing"
                end
            else
                obj:SetActiveE(0)
            end
        end
    end

    ctm:SetItemTextGradient(self.go_table.aortext_name, OrderCfg[order][2])
    self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor

    local backBg = self.go_table.aorrawimage_di
    local path = ctm:GetItemBgPathByGrade(OrderCfg[order][2])
    if backBg then
        backBg:LoadImage(path)
    end
    ---边框特效
    local effectPath = ItemBgEffectPath[OrderCfg[order][2]]
    self.go_table.obj_bgEffect:RemoveAllChildren()
    if effectPath then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                --itemGoTable.bgEffect = trans
            end
        )
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect2,
            function(trans)
                if not self.go_table then
                    _G.DestroyObject(trans)
                    return
                end
                --itemGoTable.bgEffect = trans
            end
        )
    end

    self:ShowProp()
    self:ShowSuitAndSkillInfo()
    self:ShowUpStarEffect()
end

function SpoilsTipView:ShowProp()
    ---@type AttributeClass
    local attribute = self.sp:GetAttributeDictOnlyShow()
    self.showList={}
    local typelist=_G.AttributeClassManager:GetInstance():GetChangeAttrList(attribute)
    for k,v in pairs(typelist) do
        table.insert(self.showList,v.key)
    end
    _G.SortList(
            self.showList,
            function(a)
                return  -_G.AttrType[a].sortid
            end
    )
    local numStr, num, key
    local otherattr=attribute:GetAttrByName(_G.AttCountType.other)
    local Percentattr=attribute:GetAttrByName(_G.AttCountType.basePercent)
    for i = 1, #self.showList do
        key=self.showList[i]
        if table.ContainsKey(otherattr,key) then
            num = otherattr[key]
            if _G.AttrType[key].percentage == 1 then
                num =  _G.Mathf.RoundToInt(num) / 100
                num = _G.GameUtil.FormatNum(num)
                num = tostring(num) .. "%"
                numStr = "<color=#6effc6>" .. num .. "</color>"
            else
                local numOld = _G.math.floor(_G.Mathf.RoundToInt(num))
                numOld = _G.GameUtil.NumberWY(numOld)
                numStr = numOld
            end
            self:ShowPropItem(_G.AttrType[key].des,numStr,self.go_table.obj_BaseProp,self.go_table.obj_PropContent)
        end
    end
    for i = 1, #self.showList do
        key=self.showList[i]
        if table.ContainsKey(Percentattr,key) then
            num = Percentattr[key]
            num =  num * 100
            num = _G.GameUtil.FormatNum(num)
            numStr = tostring(num) .. "%"
            --numStr = "<color=#6effc6>" .. num .. "</color>"
            self:ShowPropItem(_G.GetLangPackValue(90033800108,_G.AttrType[key].des),numStr,self.go_table.obj_BaseProp1,self.go_table.obj_extraPropContent)
        end
    end
end

function  SpoilsTipView:ShowPropItem(name,numstr,child,parent)
    local tb, tran
    tran = _G.InstantiateObject(child,parent)
    tb = _G.GetAutoGoTable(tran)
    tb.aortext_Name.text = name
    tb.aortext_Num.text = numstr
    tran:SetActiveE(1)
end

function SpoilsTipView:OnHrefSkillClick(id)
    local weight, height = 0, 0
    require("CommonTipManager"):GetInstance():OpenSkillHyper(_G.tonumber(id), nil, weight, height)
end

function SpoilsTipView:ShowSuitAndSkillInfo()
    local suitInfo = SpoilsModel:GetInstance():GetActiveSuitBySid(self.sp.cfg.suit_id)
    local skillcfg
    if suitInfo.skillid then
        skillcfg = _G.ConfigManager.card_skills_cfg[suitInfo.skillid]
    else
        skillcfg = _G.ConfigManager.card_skills_cfg[suitInfo.cfg.skill_id[1]]
    end

    self.go_table.ExtendText = self.go_table.obj_baseSkill:GetComponentE(_G.typeof(_G.CS.ExtendText))

    self.go_table.aorrawimage_suiticon:LoadImage(skillcfg.icon)

    self.go_table.ExtendText.text = _G.GetLangPackValue(skillcfg.describe1)

    self.go_table.ExtendText.OnHrefClick:AddListener(_G.handler(self, self.OnHrefSkillClick))

    local ActiveNum = 0

    local spoilslist = { self.go_table.aortext_spoilsname1, self.go_table.aortext_spoilsname2, self.go_table
        .aortext_spoilsname3, self.go_table.aortext_spoilsname4 }
    for i = 1, #spoilslist do
        local spoils = suitInfo.cfg.spoils_id[i]
        _G.GameUtil.SetActiveByCondition(spoilslist[i], spoils ~= nil)
        if spoils then
            local spcfg = _G.ConfigManager.spoils_cfg[spoils]
            spoilslist[i].text = _G.GetLangPackValue(spcfg.Name)
            local suitsp = SpoilsModel:GetInstance():GetData(spoils)
            if suitsp:GetIsActive() then
                ActiveNum = ActiveNum + 1
                spoilslist[i].color = require "CardInfoManager".GetColorFromRGB("73cf64")
            else
                spoilslist[i].color = require "CardInfoManager".GetColorFromRGB("E6E6DB")
            end
        else
            spoilslist[i].text = ""
        end
    end
    self.go_table.aortext_suitname.text = string.format("%s (%s/%s)", _G.GetLangPackValue(suitInfo.cfg.Name), ActiveNum,
        #suitInfo.cfg.spoils_id)
    if ActiveNum == #suitInfo.cfg.spoils_id then
        ActiveNum = ActiveNum + 1
        self.go_table.aortext_suitname.color = require "CardInfoManager".GetColorFromRGB("73cf64")
        self.go_table.aorrawimage_isActive:SetActiveE(1)
        self.go_table.aorrawimage_isNotActive:SetActiveE(0)
    else
        self.go_table.aortext_suitname.color = require "CardInfoManager".GetColorFromRGB("E6E6DB")
        self.go_table.aorrawimage_isActive:SetActiveE(0)
        self.go_table.aorrawimage_isNotActive:SetActiveE(1)
    end

    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_xd, suitInfo.isLimit > 0)
end

---显示技能
function SpoilsTipView:ShowUpStarEffect()
    local suitInfo = SpoilsModel:GetInstance():GetActiveSuitBySid(self.sp.cfg.suit_id)
    self.go_table.aorrawimage_isActive:SetActiveE(suitInfo.skillid and 1 or 0)
    self.go_table.aorrawimage_isNotActive:SetActiveE(suitInfo.skillid and 0 or 1)


    ---@type spoils_cfg
    local cfg = self.sp.cfg
    self.starEffects = {}
    local prop = {
        {key = "atk" ,num=cfg.atk,proptype=1},
        {key = "bre" ,num=cfg.bre,proptype=1},
        {key = "def" ,num=cfg.def,proptype=1},
        {key = "max_hp" ,num=cfg.max_hp,proptype=1}
    }
    for i = 1, #cfg.att do
        table.insert(prop,{key = cfg.att[i][1] ,num=tonumber(cfg.att[i][3]),proptype=tonumber(cfg.att[i][2])})
    end
    _G.table.insert(self.starEffects, prop)
    for i = 2, #cfg.att_growth do
        local growth = cfg.att_growth[i] / 10000
        prop = {
            {key = "atk" ,num=_G.Mathf.RoundToInt(cfg.atk * growth),proptype=1},
            {key = "bre" ,num=_G.Mathf.RoundToInt(cfg.bre * growth),proptype=1},
            {key = "def" ,num=_G.Mathf.RoundToInt(cfg.def * growth),proptype=1},
            {key = "max_hp" ,num=_G.Mathf.RoundToInt(cfg.max_hp * growth),proptype=1}
        }
        for j = 1, #cfg.att do
            table.insert(prop,{key = cfg.att[j][1] ,num=tonumber(cfg.att[j][3])*i,proptype=tonumber(cfg.att[j][2])})
        end
        _G.table.insert(self.starEffects, prop)
    end
    local key,name,numStr,num,item
    for i = 1, #self.starEffects do
        local effdesc = self.starEffects[i]
        local index = #effdesc
        index = index + 1
        for j = 1, index do
            local obj = _G.InstantiateObject(self.go_table.obj_skillItem2, self.go_table.trans_content2)
            local tb = _G.GetAutoGoTable(obj)
            if j == 1 then
                name = _G.GetLangPackValue(90000010475, i - 1)
                numStr = ""
            else
                item=effdesc[j - 1]
                key=item.key
                num=item.num
                if _G.AttrType[key].percentage == 1 or item.proptype==2 then
                    num =  _G.Mathf.RoundToInt(num) / 100
                    num = _G.GameUtil.FormatNum(num)
                    numStr = tostring(num) .. "%"
                else
                    local numOld = _G.math.floor(_G.Mathf.RoundToInt(num))
                    numOld = _G.GameUtil.NumberWY(numOld)
                    numStr = numOld
                end
                if item.proptype==2 then
                    name=_G.GetLangPackValue(90033800108,_G.AttrType[key].des)
                else
                    name=_G.AttrType[key].des
                end
            end
            --- 已激活项目
            --[[if index ~= #effdesc then
                tb.aorimage_BG:SetActiveE(j % 2 == 0 and 1 or 0)
            else
                tb.aorimage_BG:SetActiveE(j % 2 == 1 and 1 or 0)
            end]]
            tb.aortext_upDes.text = name
            tb.aortext_upDes2.text = numStr

            if self.sp:GetIsActive() then
                if self.sp:GetStar() >= i - 1 then
                    tb.aortext_upDes.color = require "CardInfoManager".GetColorFromRGB("C0C0BA")
                    tb.aortext_upDes2.color = require "CardInfoManager".GetColorFromRGB("60A93B")


                    if index ~= #effdesc then
                        if j == 1 then
                            tb.aortext_upDes.color = require "CardInfoManager".GetColorFromRGB("60A93B")
                        end
                    end
                else
                    tb.aortext_upDes.color = require "CardInfoManager".GetColorFromRGB("828388")
                    tb.aortext_upDes2.color = require "CardInfoManager".GetColorFromRGB("828388")
                end
            else
                tb.aortext_upDes.color = require "CardInfoManager".GetColorFromRGB("828388")
                tb.aortext_upDes2.color = require "CardInfoManager".GetColorFromRGB("828388")
            end

            -- tb.aortext_upDes.text = self:GetSkillDes(i - 1, enddesc)




            obj:SetActiveE(1)
        end
    end
end

---获取技能描述
function SpoilsTipView:GetSkillDes(index, id)
    if index == 0 then
        return _G.GetLangPackValue(90022300041) .. ":" .. id
    else
        return _G.GetLangPackValue(90022300084, index, id)
    end
end

---@private
function SpoilsTipView:ShowBtn()
    if self.btn == nil then
        self.go_table.obj_Btn:SetActiveE(0)
        return
    end
    if self.btn.left then
        self.go_table.aorbtn_left:SetActiveE(1)
        self.go_table.aortext_BtnLeftName.text = self.btn.left.name
    end
    if self.btn.middle then
        self.go_table.aorbtn_middle:SetActiveE(1)
        self.go_table.aortext_BtnMiddleName.text = self.btn.middle.name
    end
    if self.btn.right then
        self.go_table.aorbtn_right:SetActiveE(1)
        self.go_table.aortext_BtnRightName.text = self.btn.right.name
    end
end

---按钮点击事件在这里派发
function SpoilsTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_help" then
        if self.go_table.obj_tips:GetActiveSelf() == 1 then
            self.go_table.obj_tips:SetActiveE(0)
        else
            self.go_table.obj_tips:SetActiveE(1)
        end
    end
end

function SpoilsTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Spoils)
end

function SpoilsTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function SpoilsTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
    self.bgEffect = nil
end

function SpoilsTipView:EscClose()
    self:CloseTips()
end

return SpoilsTipView
