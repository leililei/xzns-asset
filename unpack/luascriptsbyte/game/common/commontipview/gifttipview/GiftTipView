---@class GiftTipView : Component    中文描述
---@field go_table _obj_GiftTipView_GoTable
---@field itemTransDic BaseAwardNewItem[]
---@field data TipBaseModel
local GiftTipView = _G.BaseClass("GiftTipView", _G.Component)
local CommonTipManager = require "CommonTipManager"
-- 详情滑动窗口一行的单位高度
local scrollrectUnitHeight = 130
-- 详情滑动窗口最大高度
local scrollrectMaxHeight = 125 * 2.5
-- 详情滑动列表一行的数量
local scrollrectRowNum = 4

local bgColorPath = {
    "ui_biaoqian_hong",
    "ui_biaoqian_cheng",
    "ui_biaoqian_lv",
    "ui_biaoqian_zi",
}
function GiftTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_itemList:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.go_table.scrollloopvectical_itemList1:InitItemData(0, _G.handler(self, self.RefreshItem))
    self.rect = self.go_table.aorimage_itemBg:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.nameOutLine = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline))
end

---创建对象时,入口构造函数
function GiftTipView:OnCreate()
end
---初始化礼包界面
---@param data TipBaseModel 礼包数据
---@param isShowPro boolean 是否显示概率
function GiftTipView:Init(data, isShowPro)
    self.isShowPro = isShowPro
    self.itemTransDic = {}
    self.sid = data.sid
    self.data = data
    self:InitAwardData()
    local order = data.cfg.Quality
    -- self.go_table.aortext_name.color = _G.GameUtil.GetColorByQuality(order)
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name)
    --- @type CommonTipManager
    local ctm = require "CommonTipManager":GetInstance()
    ctm:SetItemTextGradient(self.go_table.aortext_name.gameObject, data.cfg.Quality)
    self.go_table.aorrawimage_di:LoadImage(ctm:GetItemBgPathByGrade(order))
    self:RefreshBgEffect(data.cfg.Quality)
    ---@type UnityEngine.Component 彩色渐变框
    -- local component = self.go_table.aortext_name:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- if not _G.IsNil(component) then
    --     component.enabled = _G.GameUtil.IsGradientQuality(order)
    -- end

    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.aorrawimage_icon,
            function(item)
                item:Show(
                        self.sid,
                        function()
                        end
                )
            end
    )
    local type, id = _G.StorageManager:GetInstance():CheckSidType( _G.tonumber(self.awardData[1][1]))
    if type==_G.StorageType.Artifact or type== _G.StorageType.Spiritual then
        self.scrollList=self.go_table.scrollloopvectical_itemList1
        self.go_table.scrollloopvectical_itemList:SetActiveE(0)
    else
        self.scrollList=self.go_table.scrollloopvectical_itemList
        self.go_table.scrollloopvectical_itemList1:SetActiveE(0)
    end
    ---@type UnityEngine.Component 彩色描边
    local outLineColor = CommonTipManager:GetInstance():GetTipTypeNameOutLineColorByGrade(data.cfg.Quality)
    self.nameOutLine.OutlineColor = _G.ColorTools.FormatColorByString(outLineColor)

    self.go_table.aortext_des.text = _G.LangUtil.GetLangPackValue(data.cfg.Describe)
    self.scrollList:UpdateCount(#self.awardData)

    -- 手动设置框体和详情中滑动窗口大小
    local row = _G.math.ceil(#self.awardData / scrollrectRowNum)
    local height = _G.math.min(row * scrollrectUnitHeight,scrollrectMaxHeight)
    self.scrollList:UpdateScrollRectHeight(height)
    local _, rectHeight = self.rect:GetRectTransformWidthHeight()
    self.rect:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Vertical, height + rectHeight)

    -- local type = _G.GameUtil.GetItemTypeLanguageID(self.sid)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aortext_type, type > 0)
    -- _G.GameUtil.SetActiveByCondition(self.go_table.aortext_use, type > 0)
    --self.go_table.aortext_typeName.text = _G.LangUtil.GetLangPackValue(_G.GameUtil.GetItemTypeLanguageID(self.sid))
    self.go_table.aortext_useName.text = _G.LangUtil.GetLangPackValue(data.cfg.title)
    self.go_table.aortext_haveCount.text = _G.tostring(_G.StorageManager:GetInstance():GetItemCountBySid(self.sid))
    if data.cfg.UseType == _G.ItemUseType.ItemDrop or data.cfg.UseType == _G.ItemUseType.DrawCard then
        self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(20001000008)
    elseif
    data.cfg.UseType == _G.ItemUseType.GetProp or data.cfg.UseType == _G.ItemUseType.SelectProp or
            data.cfg.UseType == _G.ItemUseType.CardOptional
    then
        self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(20001000009)
    else
        self.go_table.aortext_title.text = _G.LangUtil.GetLangPackValue(20001000007)
    end

    -- if type > 0 then

    -- end

    self.view:SetPos(self.rect, data.pos)
end
---刷新物体信息
function GiftTipView:RefreshItem(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.itemTransDic[instanceID] then
        self.itemTransDic[instanceID] = require "BaseAwardNewItem".New(obj, nil, 110)
    end
    self.itemTransDic[instanceID]:ShowWithID(self.awardData[index])
    if self.isShowPro then
        self.itemTransDic[instanceID].go_table.obj_property:SetActiveE(1)
        local property = 100 * self.awardData[index].property
        self.itemTransDic[instanceID].go_table.aortext_property.text = string.format("%.2f", property) .. "%"
    else
        self.itemTransDic[instanceID].go_table.obj_property:SetActiveE(0)
    end
    local tb=self.itemTransDic[instanceID]
    if self.itemTransDic[instanceID].type==_G.StorageType.Artifact then
        tb.go_table.aorimage_tipsBg.SpriteName = bgColorPath[tb.data.cfg.label[1]]
        tb.go_table.aortext_tipsname.text = _G.LangUtil.GetLangPackValue(tb.data.cfg.label[2])
        self.go_table.scrollloopvectical_itemList:ChangeItemSize(index,120)
        local cardId = tb.data.cfg.card_id
        if cardId and cardId > 0 then
            local cardCfg = _G.ConfigManager.card_cfg[cardId]
            local icon = cardCfg.Icon
            if _G.string.contains(icon, "/") then
                icon = _G.string.split2tbl(icon, "/")
                icon = icon[#icon]
            end
            tb.go_table.aorimage_cardBg:SetActiveE(1)
            tb.go_table.aorimage_cardIcon.SpriteName = icon
            tb.go_table.aorimage_cardBg.SpriteName = "ui_js_txk_cai"
        else
            tb.go_table.aorimage_cardBg:SetActiveE(0)
        end
    elseif self.itemTransDic[instanceID].type==_G.StorageType.Spiritual then
        if tb.go_table.aorimage_tipsBg then
            tb.go_table.aorimage_tipsBg.SpriteName = bgColorPath[tb.data.cfg.label[1]]
            tb.go_table.aortext_tipsname.text = _G.LangUtil.GetLangPackValue(tb.data.cfg.label[2])
        end
    end

    local sid = tonumber(self.awardData[index][1])
    local itemtb = _G.GetAutoGoTable(obj)
    local icfg = _G.ConfigManager.heroic_icons_cfg[sid]
    if icfg then
        local data = require "HeroicIconModel":GetInstance():GetHeroicIconBySid(sid)
        if data and itemtb.obj_has then
            itemtb.obj_has:SetActiveE(1)
        end
    end
end

---初始化奖励数据
function GiftTipView:InitAwardData()
    self.awardData = {}
    local item_cfgItem = self.data.cfg
    local UseParameter = item_cfgItem.UseParameter

    self.propertySum = 0
    self.poolProperty = {}
    if item_cfgItem.UseType == _G.ItemUseType.ItemDrop then
        ---掉落预览要查掉落表
        ---@type drop_cfg
        local drop_cfgItem = _G.ConfigManager.drop_cfg[tonumber(UseParameter[1][2])]
        if drop_cfgItem ~= nil then
            local info, infoS, itemData
            infoS = drop_cfgItem.fixed_drop
            for i = 1, #infoS do
                info = infoS[i]
                table.insert(self.awardData, info)
            end
            infoS = drop_cfgItem.content1
            for i = 1, #infoS do
                info = infoS[i]
                table.insert(self.awardData, info)
            end
            infoS = drop_cfgItem.content2
            for i = 1, #infoS do
                info = infoS[i]
                table.insert(self.awardData, info)
            end
        end
    elseif item_cfgItem.UseType == _G.ItemUseType.ProgressChest then
        ---@type item_box_con_cfg
        local cfg = _G.ConfigManager.item_box_con_cfg[_G.tonumber(UseParameter[1][1])]
        if cfg then
            for i = 1, #cfg.rewards do
                table.insert(self.awardData, cfg.rewards[i])
            end
        end
    elseif item_cfgItem.UseType == _G.ItemUseType.DrawCard then
        for i = 2, #UseParameter do
            ---@type lucky_pools_cfg
            local id = _G.tonumber(UseParameter[i][1])
            local cfg = _G.ConfigManager.lucky_pools_cfg[tonumber(UseParameter[i][1])]
            self.poolProperty[id] = { value = 0, poolProperty = _G.tonumber(UseParameter[i][2]) or 0 }
            if cfg then
                for i = 1, #cfg.cards do
                    table.insert(self.awardData,
                            { cfg.cards[i][1], 1, cfg.cards[i][2], property = cfg.cards[i][3], poolId = cfg.id })
                    self.poolProperty[cfg.id].value = self.poolProperty[cfg.id].value + cfg.cards[i][3]
                end
            end
            self.propertySum = self.propertySum + self.poolProperty[id].poolProperty
        end
        for k, v in pairs(self.awardData) do
            v.property = v.property / self.poolProperty[v.poolId].value
                    * self.poolProperty[v.poolId].poolProperty / self.propertySum
        end
        table.sort(self.awardData, function(l, r)
            local lCfg = _G.ConfigManager.card_cfg[l[1]]
            local rCfg = _G.ConfigManager.card_cfg[r[1]]
            if lCfg.Elements ~= rCfg.Elements then
                if lCfg.Elements == 6 then
                    return true
                elseif rCfg.Elements == 6 then
                    return false
                else
                    return lCfg.Elements < rCfg.Elements
                end
            end
            if l.property ~= r.property then
                return l.property < r.property
            end
            return l[1] < r[1]
        end)
    else
        local info, itemData
        if #UseParameter>0 then
            for i = 1, #UseParameter do
                info = UseParameter[i]
                table.insert(self.awardData, info)
            end
        elseif #UseParameter==0 and #item_cfgItem.UseParameter2>0 and #item_cfgItem.use_parameter2_con>0 then
            for i, v in pairs(item_cfgItem.UseParameter2) do
                if _G.GlobalConditionManager.CheckConditionByArray({item_cfgItem.use_parameter2_con[i]}) then
                    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(v)
                    _G.table.insert(self.awardData, v)
                end
            end
        end
    end
    self:AwardSort()
end

---刷新背景特效
function GiftTipView:RefreshBgEffect(quality)
    local effectPath = CommonTipManager:GetInstance():GetItemBgEffectPathByGrade(quality)
    if not _G.ConfigManager.ui_effect_cfg[effectPath] then
        return
    end
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effectPath],
            self.go_table.obj_bgEffect,
            function(trans)
                if _G.IsNil(trans) then
                    _G.DestroyObject(trans)
                    return
                end
                self.bgEffect = trans
            end
    )
end

---对展示内容进行排序
function GiftTipView:AwardSort()
    if self.data.cfg.ID == 203050400 then
        -- 招募百抽
        local cfg = _G.ConfigManager.card_cfg
        _G.SortList(self.awardData,
        function(a)
            return cfg[a[1]].Order
        end)
    end
end

---销毁对象时,析构函数
function GiftTipView:OnDestroy()
end

function GiftTipView:OnClickBtn()
    self.view:CloseTip(_G.TipType.Gift)
end

function GiftTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}

    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function GiftTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.bgEffect = nil
end

function GiftTipView:EscClose()
    self.view:CloseTip(_G.TipType.Gift)
end

return GiftTipView
