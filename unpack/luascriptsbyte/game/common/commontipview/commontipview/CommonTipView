function CommonTipView:HideOther()
    for _, v in pairs(self.Views) do
        _G.GameUtil.SetActiveByCondition(v.go_table.gameObject, false)
    end
end

function CommonTipView:ShowOther()
    if self:IsNil() then
        return
    end
    for _, v in pairs(self.Views) do
        _G.GameUtil.SetActiveByCondition(v.go_table.gameObject, true)
    end
end

