function CommonTipView:Awake()
    if _G.AppSetting.IsXzns then
        CommonTipView.ViewName[TipType.BeastSkill] = "obj_BeastSkillTipView"
        ComponentType[TipType.BeastSkill] = require "BeastSkillTipView"
    end
    self.Views = {}
    self.camera = nil
    self.OpenTips = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    self.viewCount = 0
    self.isSapwn = false
end

---界面的入口函数
---@param type TipType 提示类型
---@param data table  所要显示对象的数据
function CommonTipView:OnCreate(type, data, ...)
    if not data then
        return
    end
    self:ShowTips(type, data, ...)
end

function CommonTipView:ShowTips(type, data, ...)
    if self.isSapwn then
        return
    end
    if require "CommonTipManager":GetInstance().isShowCard and type ~= TipType.Skill_Hyper then
        self:HideOther()
        self:Show()
    end
  
    local Sid
    local viewName = CommonTipView.ViewName[type]
    local componentType = ComponentType[type]
    if type == TipType.RelicTeamBuff then
        Sid = data
        while (Sid > 1000) do
            Sid = Sid / 10
        end
        Sid = _G.math.floor(Sid)
        viewName = _G.NoInitTypeToTipsPrefabName[Sid] or viewName
        componentType = (require(_G.NoInitTypeToTipsLuaName[Sid])) or componentType
    end
    self.isSapwn = true
    --local name = "UI/Common/CommonTipView/View/$_" .. CommonTipView.ViewName[type]
    if _G.IsTable(data) and data.cfg then
        ---碎片合成特殊处理（配置上是一个道具，展示需要按照宝箱类型展示），因为预览需要展示合成的宝箱的奖励
        if data.cfg.UseType == _G.ItemUseType.CompoundProp then
            type = TipType.CompoundProp
        elseif data.cfg.Type1 == _G.ItemCfgType.EquipBrokenMaterial then
            type = TipType.EquipBrokenMaterial
        elseif data.cfg.Type1 == _G.ItemCfgType.EquipBrokenMaterialBox then
            type = TipType.EquipBrokenMaterialBox
        elseif data.cfg.Type1 == _G.ItemCfgType.GodHalo then
            type = TipType.GodHalo
            viewName = CommonTipView.ViewName[type]
            componentType = ComponentType[type]
        end
    end

    local name = "UIH5/Common/CommonTipView/View/$_" .. viewName
    local parmas = _G.SafePack(...)
    _G.PoolsManager:GetInstance():Spawn(
        name,
        _G.ePoolType.Temporary,
        self.go_table.trans_root,
        function(trans)
            self.isSapwn = false
            _G.GameUtil.SetActiveByCondition(trans, true)
            local canvas = trans:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
            canvas.overrideSorting = true
            self.orderInLayer = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
            self.orderInLayer = self.orderInLayer + 5 * self.go_table.trans_root:GetChildCountE()
            canvas.sortingOrder = self.orderInLayer
            trans:RequireComponentE(_G.typeof(_G.CS.AorGraphicRaycaster))
            local view = self:AddComponent(trans.gameObject, componentType.New(trans, self))
            self.viewCount = self.viewCount + 1
            self.Views[self.viewCount] = view
            view:Init(data, _G.SafeUnpack(parmas))
        end
    )
end

function CommonTipView:EscClose()
    -- body
    self:CloseTip()
end

--关闭提示
function CommonTipView:CloseTip()
    local view = self.Views[self.viewCount]
    if view then
        _G.DestroyObject(view.gameObject)
        self.Views[self.viewCount] = nil
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(_G.table.count(self.Views), "存储的tips总长度")
            _G.LogError(self.viewCount, "当前关闭的tips长度值")
        end
    end
    self.viewCount = self.viewCount - 1
    if self.viewCount < 0 then
        self.viewCount = 0
    end
    if self.viewCount == 0 then
        self:Close()
    end
end

