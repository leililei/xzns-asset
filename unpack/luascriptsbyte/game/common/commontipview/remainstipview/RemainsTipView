function RemainsTipView:RefreshRemainsItem(index, obj)
    local newIndex = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local sid = self.Cfg.remains[newIndex]
    local remainsData = RemainsModel:GetInstance():GetData(sid)
    tb.data = remainsData
    if remainsData and not tb.spawning then
        if tb.remain then
            tb.remain:ShowData(remainsData, function()
            end)
            tb.remain:HideMid()
            tb.remain:UpDateHave()
            self:SetGrayAll(tb.remain.go_table, not tb.data:GetIsActive())
            -- tb.build.go_table.aorimage_mask:SetActiveE(tb.data:GetIsActive() and 0 or 1)
        else
            tb.spawning = true
            _G.PoolsManager:GetInstance():Spawn("UIH5/Common/ItemView/ItemRemainsBodyBaseView", _G.ePoolType.UIItem,
                tb.obj_RemainItem, _G.handlerbind(self, self.OnSpawnCall, tb))
        end
    end
end

function RemainsTipView:OnSpawnCall(trans, path, tb)
    tb.spawning = false
    tb.remain = require"ItemRemainsBodyBaseView".New(trans.gameObject)
    if tb.data then
        tb.remain:ShowData(tb.data, function()
        end)
        tb.remain:HideMid()
        tb.remain:UpDateHave()
        self:SetGrayAll(tb.remain.go_table, not tb.data:GetIsActive())
    end
end

function RemainsTipView:SetGrayAll(tb, isGary)
    tb.aorrawimage_Icon:SetGray(false)
end

function RemainsTipView:UpdateProp()
    self.propList = {}
    local prop = self.sp.cfg
    for _, v in ipairs(prop.att1) do
        if _G.AttrType[v[1]] then
            local star = self.sp:GetMaxStar()
            local nextV
            if self.sp:IsMaxStar() or not self.sp:GetIsActive() then
                nextV = 0
            else
                nextV = _G.Mathf.RoundToInt(self.sp.cfg.rate[star + 1] * v[3] / 10000)
            end
            _G.table.insert(self.propList, {
                name = _G.AttrType[v[1]].des,
                value = _G.Mathf.RoundToInt(self.sp.cfg.rate[star] * v[3] / 10000),
                icon = _G.AttrTypeIcon[v[1]],
                nextValue = nextV,
                percentage = v[2],
                proptype = _G.AttrType[v[1]].proptype
            })
        end
    end

    self.go_table.scrollloopvectical_propList:UpdateCount(#self.propList)
end

function RemainsTipView:UpdateProp2()
    self.go_table.scrollloopvectical_propList1:UpdateCount(#self.Cfg.att)
end

function RemainsTipView:RefreshPropItem(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = self.propList[index + 1].value
    if self.sp:IsMaxStar() then
        self.propList[index + 1].nextValue = _G.GetLangPackValue(90022300065)
        if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
            value = _G.Mathf.RoundToInt(value / 100) .. "%"
        end
        tb.aorimage_arrow2:SetActiveE(0)
        tb.aortext_nextValue:SetActiveE(0)
    else
        local nextValue = self.propList[index + 1].nextValue
        if self.propList[index + 1].percentage == "2" or self.propList[index + 1].proptype ~= 1 then
            value = _G.Mathf.RoundToInt(value / 100) .. "%"
            nextValue = _G.Mathf.RoundToInt(nextValue / 100) .. "%"
        end
        if self.propList[index + 1].nextValue ~= 0 then
            tb.aortext_nextValue.text = nextValue
            tb.aorimage_arrow2:SetActiveE(1)
            tb.aortext_nextValue:SetActiveE(1)
        else
            tb.aorimage_arrow2:SetActiveE(0)
            tb.aortext_nextValue:SetActiveE(0)
        end
    end

    tb.aorimage_arrow2:SetActiveE(0)
    tb.aortext_nextValue:SetActiveE(0)

    tb.aorimage_icon.SpriteName = self.propList[index + 1].icon
    tb.aortext_propName.text = self.propList[index + 1].name
    tb.aortext_curValue.text = value
end

function RemainsTipView:RefreshPropItem2(index, obj)
    local tb = GetAutoGoTable(obj)
    local value = self.Cfg.att[index + 1]
    local txt
    txt = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90000010475, value[1])

    local activeNum = RemainsModel:GetInstance():GetFetterIndex(self.Cfg.id)

    if value[1] == "0" then
        txt = _G.GetLangPackValue(90020200027) .. _G.GetLangPackValue(90022300041)
    end
    local txt2
    if value[3] == "2" or _G.AttrType[value[2]].proptype ~= 1 then
        txt2 = _G.AttrType[value[2]].des .. "+" .. (tonumber(value[4]) / 100) .. "%"
    else
        txt2 = _G.AttrType[value[2]].des .. "+" .. tonumber(value[4])
    end
    tb.aortext_propName.text = txt .. ":" .. txt2

    if activeNum >= index + 1 then
        tb.aortext_propName.color = _G.ColorTools.FormatColorByString("000000")
    else
        tb.aortext_propName.color = _G.ColorTools.FormatColorByString("B3B1AB")
    end

    tb.aortext_curValue.text = ""
end

