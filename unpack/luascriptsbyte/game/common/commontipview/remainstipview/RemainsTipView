---按钮点击事件在这里派发
function RemainsTipView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:CloseTips()
    elseif name == "@_aorbtn_left" then
        self.btn.left.func()
        if self.btn.left.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_middle" then
        self.btn.middle.func()
        if self.btn.middle.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_right" then
        self.btn.right.func()
        if self.btn.right.close then
            self:CloseTips()
        end
    elseif name == "@_aorbtn_help" then
        if self.go_table.obj_tips:GetActiveSelf() == 1 then
            self.go_table.obj_tips:SetActiveE(0)
        else
            self.go_table.obj_tips:SetActiveE(1)
        end
    elseif name == "@_aorbtn_titleTip" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RemainsInfoMaxView.Name, self.sp)
    end
end

function RemainsTipView:CloseTips()
    self.gameObject:SetActiveE(0)
    self.view:CloseTip(_G.TipType.Remains)
end

function RemainsTipView:__init(transform, view)
    -- 组件集合(减少对c#测调用)
    self.Components = {}
    self.gameObject = transform
    self.transform = transform
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.CacheListener = {}
    self.view = view
end

function RemainsTipView:Dispose()
    self.go_table = nil
    self.Components = nil
    self.gameObject = nil
    self.transform = nil
    self.CacheListener = nil
    self.view = nil
    self.cards = nil
    self.bgEffect = nil
end

function RemainsTipView:EscClose()
    self:CloseTips()
end

return RemainsTipView
