-- Description  角色 等待idle状态播放 休闲动作
-- 生命周期Awake,Start, OnDisable, OnEnable, OnDispose 可根据情况自行添加
-----------------------------------------------------------------------

---@class RoleIdleAnimPlaySpecial : Component	中文描述
local RoleIdleAnimPlaySpecial = _G.BaseClass("RoleIdleAnimPlaySpecial", _G.Component)
_G.RoleIdleAnimPlaySpecial = RoleIdleAnimPlaySpecial
local CS = _G.CS
local typeof = _G.typeof

---休闲动作名字
local specialName = {
    "special_1",
    "special_1"
}

---待机 动作名字
local idleName = {
    "idle_1"
}

function RoleIdleAnimPlaySpecial:Awake()
    ---@type RoleAnimatorController 角色动画控制器
    self.roleAni = nil
    ---下次是否开始播放休闲动作   休闲 与  等待 切换判定
    self.isPlaySpecial = nil
    ---计时器
    self.PlayTimer = nil
end

function RoleIdleAnimPlaySpecial:Dispose()
end

---@param roleAni RoleAnimatorController
function RoleIdleAnimPlaySpecial:OnCreate(roleAni)
    if roleAni == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" RoleIdleAnimPlaySpecial:OnCreate(roleAni)  roleAni==nil")
        end
        return
    end
    self.roleAni = roleAni
    self.isPlaySpecial = nil

    ---当前角色 的休闲动作
    self.specialNameArr = {}
    for i = 1, #specialName do
        local sName = specialName[i]
        ---有这个休闲动作 才保存
        local ishave = self.roleAni:isHaveAni(sName)
        if ishave == true then
            table.insert(self.specialNameArr, sName)
        end
    end
end

---在等待状态 开始计时随机播放休闲动作
function RoleIdleAnimPlaySpecial:SpecialStart()
    if not _G.IsNil(self.PlayTimer) then
        if _G.AppSetting.DEBUG then
            _G.Log("已在计时中 ")
        end
        return
    end
    if #self.specialNameArr <= 0 then
        if _G.AppSetting.DEBUG then
            _G.Log("没有休闲动作 ")
        end
        return
    end

    if self.roleAni ~= nil then
        _G.AnimatorPlayEndCallback.RemoveCallback(self.roleAni:GetInstanceIDE())
    end

    _G.AnimatorPlayEndCallback.AddCallback(self.roleAni:GetInstanceIDE(), _G.handler(self, self.PlayAniCallBack))
    self:PlayAniCallBack()
end

function RoleIdleAnimPlaySpecial:PlayAniCallBack()
    if _G.IsNil(self.isPlaySpecial) then
        self.isPlaySpecial = true
    else
        self.isPlaySpecial = not self.isPlaySpecial
    end

    self:SpecialStop()

    local intervalTime = _G.math.random(3, 5)
    ---播放休闲动作回来 立即播放待机动作
    if self.isPlaySpecial == false then
        intervalTime = 0
    end

    if _G.AppSetting.DEBUG then
        _G.Log(" RoleIdleAnimPlaySpecial 间隔 " .. intervalTime .. "秒")
    end
    self.PlayTimer =
        _G.TimerManager:GetInstance():GetTimer(
        intervalTime,
        self.PlayerTimerFunc,
        self,
        true
    )
    self.PlayTimer:Start()
end

function RoleIdleAnimPlaySpecial:PlayerTimerFunc()
    if self.isPlaySpecial then
        ---只有当前在等待状态才播放
        local nowName = self.roleAni:getNowPlayName()
        if nowName ~= idleName[1] then
            if _G.AppSetting.DEBUG then
                _G.Log(" RoleIdleAnimPlaySpecial:SpecialStart() 当前不是等待状态")
            end
            self:SpecialStop()
            return
        end

        local specialRandom = _G.math.random(#self.specialNameArr)
        local nowSpecialName = specialName[1]
        self.roleAni:Play(nowSpecialName, true)
    else
        ---如果已经在等待状态 就回调 再来一次  防止play相同动作被return调 不回调
        local nowName = self.roleAni:getNowPlayName()
        if nowName == idleName[1] then
            self:PlayAniCallBack()
            return
        else
            self.roleAni:Play(idleName[1], true)
        end
    end
end

---停止
function RoleIdleAnimPlaySpecial:SpecialStop()
    if not _G.IsNil(self.PlayTimer) then
        self.PlayTimer:Stop()
        self.PlayTimer = nil
    end
end

function RoleIdleAnimPlaySpecial:OnDestroy()
    self:SpecialStop()
end

return RoleIdleAnimPlaySpecial
