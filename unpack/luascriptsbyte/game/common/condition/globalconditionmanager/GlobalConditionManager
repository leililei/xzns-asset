-- ZHJ-18793【客户端】功能开放添加复数条件及新增玩家创号天数条件
---针对参数为复数的判定接口
---@param _type table condition_type
---@param allCheckBol boolean 传true的话返回所有未通过的lockType, tipsid, content
---@return boolean 检测是否通过
---@return boolean 未通过的条件类型 和条件参数
function GlobalConditionManager.CheckConditionByArray(type, allCheckBol)
    local checkArray = {}
    for i = 1, #type do
        _G.table.insert(checkArray, type[i])
    end
    if not allCheckBol then
        SortConditionsFunc(checkArray)
    end
    local checkCount = #checkArray
    local _type, value, value1
    local _checkCount = 0
    local lockType -- {conditiontype}
    local isUnlock, tipsid, content
    local lockType1 = {}
    local tipsid1 = {}
    local content1 = {}
    for k, v in pairs(checkArray) do
        value1 = v[3]
        value = v[2]
        _type = v[1]
        if _type == 0 then
            _checkCount = _checkCount + 1
        elseif CheckFunction[_type] then
            isUnlock, tipsid, content = CheckFunction[_type]({value, value1})
            if isUnlock then
                _checkCount = _checkCount + 1
            else
                if allCheckBol then
                    table.insert(lockType1, v)
                    table.insert(tipsid1, tipsid)
                    table.insert(content1, content)
                else
                    lockType = v
                    break
                end
            end
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未检测到判定类型 type=" .. _type)
            end
        end
    end
    if allCheckBol then
        return _checkCount >= checkCount, lockType1, tipsid1, content1
    end
    return _checkCount >= checkCount, lockType, tipsid, content
end

---获取检测描述 用于显示
---@param _type number 类型
---@param params table 参数(数值)
---@return boolean,string true检测通过,描述
function GlobalConditionManager.GetTipsText(_type, ...)
    if _type == 0 then
        return nil
    end
    local str = ""
    local isPass
    ---必须返回描述
    if GetTipsText[_type] then
        local tipsid, content = GetTipsText[_type](...)
        str = content
    end
    if CheckFunction[_type] then
        local tisPass, tipsid, content = CheckFunction[_type]({...})
        isPass = tisPass
    end
    return isPass, str
end

