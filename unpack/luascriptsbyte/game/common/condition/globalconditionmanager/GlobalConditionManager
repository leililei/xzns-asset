---检查通用条件判断(自定义解锁条件描述)
---@param params number[][] 条件组
---@return boolean,string       @(是否满足所有条件, 不满足条件的tip)
function GlobalConditionManager.CheckConditionArraysCustomUnlockTip(params)
    if not params or #params <= 0 then
        return true
    end
    ---@type boolean
    local pass = true
    ---@type string
    local content

    for _, condition in pairs(params) do
        local type, value = table.unpack(condition)
        local ok, _, _content = GlobalConditionManager.CheckCondition(type, value)
        if not ok then
            pass = false
            if type == ConditionType.afk then
                local _cfg = _G.ConfigManager.afk_cfg[value]
                if _cfg then
                    content = _G.GetLangPackValue(90030700080, _cfg.chapter, _cfg.section)
                end
            elseif type == ConditionType.createRoleDay then
                -- 剩余时长
                local createDuration = _G.TimeUtil.GetServerUnixTime() -
                                           _G.TimeUtil.GetDayBySix(_G.PlayerModel:GetInstance():GetCreateRoleTime())
                local remainDuration = (value - 1) * 86400 - createDuration
                if remainDuration >= 86400 then
                    content = _G.GetLangPackValue(90030700081, math.floor(remainDuration / 86400))
                elseif remainDuration > 0 then
                    local hour = math.floor(remainDuration / 3600)
                    if hour <= 0 then
                        hour = 1
                    end
                    content = _G.GetLangPackValue(90030700082, hour)
                end
            end
            if not content then
                content = _content
            end
            if content then
                break
            end
        end
    end
    return pass, content
end
