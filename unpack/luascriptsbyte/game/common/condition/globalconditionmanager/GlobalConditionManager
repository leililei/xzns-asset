---检测条件
---@param params table 检测参数(二维数组,类型+参数)
---@return boolean 检测是否通过
function GlobalConditionManager.CheckConditionArrays(params)
    if not params or #params <= 0 then
        return true
    end
    local _t = 0
    local conditions
    local DeepCopyCfgTable = _G.DeepCopyCfgTable
    local remove = _G.table.remove
    local pass = true
    local tipsid, content
    local func
    for i = 1, #params do
        conditions = DeepCopyCfgTable(params[i])
        _t = remove(conditions, 1)
        func = CheckFunction[_t]
        if func then
            pass, tipsid, content = func(conditions)
        else
            if _G.AppSetting.DEBUG then
                _G.LogWarning("未检测到判定类型 type=" .. _t)
            end
            pass = false
        end
        if not pass then
            return false, tipsid, content
        end
    end
    return true
end

