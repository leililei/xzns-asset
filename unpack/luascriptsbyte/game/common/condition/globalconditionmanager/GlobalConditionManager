local SortConditionsFunc = function(tb)
    if not _G.table.isEmptyOrNil(tb) then
        _G.SortList(tb, function(a)
            local value = a[1]
            if value == 9 then
                value = 99
            elseif value == 50 then
                value = 98
            elseif value == 54 then
                value = 97
            elseif value == 4 then
                value = 96
            elseif value == 2 then
                value = 95
            elseif value == 1 then
                value = 94
            elseif value == 12 then
                value = 93
            end
            return value
        end)
    end
    return tb
end
_G.GlobalConditionManager.SortConditionsFunc = SortConditionsFunc
---检测方法汇总
local CheckFunction = {
    ---角色等级 >=
    [ConditionType.playerLV] = function(params)
        local lv = params[1] or 0
        local result = _G.PlayerModel:GetInstance():GetLevel() >= lv
        if not result then
            local tipsid, content = GetTipsText[1](lv)
            return false, tipsid, content
        else
            return true
        end
    end,
    ---剧情关卡是否完成
    [ConditionType.section] = function(params)
        local id = params[1] or 0
        local result = require("ChapterModel"):GetInstance():CheckSectionPass(id)
        if not result then
            local tipsid, content = GetTipsText[2](id)
            return false, tipsid, content
        else
            return true
        end
    end,
    ---vip等级 >=
    [ConditionType.vipLV] = function(params)
        local lv = params[1] or 0
        return require("VIPPrivilegeModel"):GetInstance().realVipLevel >= lv
    end,
    ---放置通关后
    [ConditionType.afk] = function(params)
        local id = (tonumber(params) or params[1]) or 0
        local result = require("AfkModel"):GetInstance():CheckSectionIsPass(id)
        if not result then
            local tipsid, content = GetTipsText[4](id)
            return false, tipsid, content
        else
            return true
        end
    end,
    ---公会等级 >=
    [ConditionType.guildLv] = function(params)
        local cfgLevel = params[1]
        local SociatyModel = require("SociatyModel")
        local level = SociatyModel:GetInstance().SociatySelf.Level
        local tipsid, content = GetTipsText[5](cfgLevel)
        if level < cfgLevel then
            return false, tipsid, content
        end
        return true
    end,
    ---角色等级 <=
    [ConditionType.playerLVLess] = function(params)
        local lv = params[1] or 0
        local result = _G.PlayerModel:GetInstance():GetLevel() < lv
        return result
    end,
    ---放置通关前
    [ConditionType.afkLess] = function(params)
        local id = (tonumber(params) or params[1]) or 0
        local result = require("AfkModel"):GetInstance():CheckSectionIsPass(id)
        if result then
            local tipsid, content = GetTipsText[4](id)
            return false, tipsid, content
        else
            return true
        end
    end,
    ---死魂塔通关id >=
    [ConditionType.DeadsoulTower] = function(params)
        local id = params[1] or 0
        local result = require("DeadsoulTowerModel"):GetInstance():GetId() >= id
        return result
    end,
    ---死魂塔通关id <=
    [ConditionType.DeadsoulTowerLess] = function(params)
        local id = params[1] or 0
        local result = require("DeadsoulTowerModel"):GetInstance():GetId() <= id
        return result
    end,
    ---大秘境通关关卡id
    [ConditionType.SecretRealmPassState] = function(params)
        local id = params[1] or 0
        local maxSid = require("SecretRealmModel"):GetInstance():GetMaxSid()
        local result = maxSid ~= 0 and maxSid >= id
        return result
    end,
    ---事件完成
    [ConditionType.event] = function(params)
        local ids = params or {}
        for i = 1, #ids do
            if not _G.EventManager:GetInstance():GetEventDone(ids[i]) then
                return false
            end
        end
        return true
    end,
    ---接受任务(包括接受，完成，提交)
    [ConditionType.acceptTask] = function(params)
        local ids = params or {}
        local TaskModuleIns = _G.TaskModule:GetInstance()
        for i = 1, #ids do
            if not TaskModuleIns:IsTaskIdAvalibleExecute(ids[i]) and not TaskModuleIns:IsTaskIdDone(ids[i]) and
                not TaskModuleIns:IsCompletedTask(ids[i]) then
                return false
            end
        end
        return true
    end,
    ---完成任务(提交)
    [ConditionType.doneTask] = function(params)
        local ids = params or {}
        local TaskModuleIns = _G.TaskModule:GetInstance()
        for i = 1, #ids do
            if not TaskModuleIns:IsCompletedTask(ids[i]) then
                return false
            end
        end
        return true
    end,
    ---持有道具
    [ConditionType.item] = function(params)
        for i = 1, #params, 2 do
            if not _G.StorageManager:GetInstance():CheckItem(params[i], params[i + 1]) then
                return false
            end
        end
        return true
    end,
    ---房间探索值
    [ConditionType.room] = function(params)
        local num = params[1] or 0
        return _G.ChapterRoomManager:GetInstance():GetPassRoomCount() >= num
    end,
    ---击败怪物组
    [ConditionType.monsterGroup] = function(params)
        local sid = params or {}
        local ChapterRoomManagerIns = _G.ChapterRoomManager:GetInstance()
        for i = 1, #sid do
            if sid[i] > 10 and not ChapterRoomManagerIns:GetRoomEnemyBattle(sid[i]) then
                return false
            end
        end
        return true
    end,
    ---领取怪物组奖励
    [ConditionType.monsterGroupAward] = function(params)
        local sid = params or {}
        local ChapterModelIns = require("ChapterModel"):GetInstance()
        for i = 1, #sid do
            if not ChapterModelIns:CheckMonsterGroupFight(sid[i]) then
                return false
            end
        end
        return true
    end,
    ---建号天数
    [ConditionType.createRoleDay] = function(params)
        local day = params[1] or 0
        local ct = 0
        if params[2] and params[2] > 0 then
            ct = params[2]
        else
            ct = _G.PlayerModel:GetInstance():GetCreateRoleTime()
        end
        if _G.TimeUtil.GetInterValDayByGame(ct, _G.TimeUtil.GetServerUnixTime()) + 1 < day then
            local tipsid, content = GetTipsText[ConditionType.createRoleDay](day)
            return false, tipsid, content
        end
        return true
    end,
    ---获取引导id是否执行过
    [ConditionType.guide] = function(params)
        local guideId = params[1] or 0
        return _G.GuideManager:GetInstance():IsDoed(guideId)
    end,
    ---获取宝箱是否交互过
    [ConditionType.box] = function(params)
        local sid = params or {}
        local WorldItemManagerIns = _G.WorldItemManager:GetInstance()
        for i = 1, #sid do
            if not WorldItemManagerIns:GetInteractionBySid(sid[i]) then
                return false
            end
        end
        return true
    end,
    [ConditionType.serverTime] = function(params)
        local result = _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time >= (params[1] - 1) *
                           86400
        if not result then
            local tipsid, content = GetTipsText[50](params[1])
            return false, tipsid, content
        else
            return true
        end
    end,
    ---对应月卡是否解锁 剩余时间是否大于对应时间
    [ConditionType.monthCard] = function(params)
        for i = 1, #params, 2 do
            return require "MonthlyModel":GetInstance():IsUnlockMonthCard(params[i], params[i + 1])
        end
    end,
    ---建号后累计登录天数
    [ConditionType.Accumulative] = function(params)
        local day = params[1] or 0
        local ct = _G.PlayerModel:GetInstance():DayCount()
        if ct < day then
            return false
        end
        return true
    end,
    [ConditionType.ReedCatkins] = function(params)
        return require "ReedCatkinsModel":GetInstance():CheckIsPass(params[1])
    end,
    [ConditionType.CardMaxStar] = function(params)
        local result = require "IllustrationModel":GetInstance():CheckMaxStarCondition(params[1])
        if not result then
            local tipsid, content = GetTipsText[ConditionType.CardMaxStar](params[1])
            return false, tipsid, content
        else
            return true
        end
    end,
    [ConditionType.battleAreaServerTime] = function(params)
        local result = _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance():GetBattleOpenTime() >=
                           (params[1] - 1) * 86400
        if _G.PlayerModel:GetInstance().main_open_time == 0 then
            result = false
        end
        if not result then
            local tipsid, content = GetTipsText[54](params[1])
            return false, tipsid, content
        else
            return true
        end
    end,
    ---地狱道等级
    [ConditionType.HellRoad] = function(params)
        local hellData = require"HellRoadModel":GetInstance().hellData
        local result = hellData and hellData.h_id >= params[1] or false
        if not result then
            local tipsid, content = GetTipsText[55](params[1])
            return false, tipsid, content
        else
            return true
        end
    end,
    ---充值金额
    [ConditionType.CashNum] = function(params)
        local curCashNum = require("MallManager"):GetInstance():GetCashRmb()
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(params[1])
        if curCashNum and curCashNum >= finalPrice then
            return true
        else
            return false, "", math.floor(finalPrice / 100)
        end
    end,
    ---指定玩家UID
    [ConditionType.PlayerUID] = function(value, params)
        if _G.table.isEmptyOrNil(params) then
            return false
        end
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        return _G.table.indexof(params, uid) ~= false
    end,
    ---公会建筑等级 >=
    [ConditionType.sociatyBuilding] = function(params)
        if not params[1] then
            return false
        end
        local T = {_G.math.modf(params[1] / 10000), params[1] % 10000}
        local SociatyModel = require("SociatyModel")
        local SociatyManager = require("SociatyManager")
        local inSociaty = SociatyManager:GetInstance():HasSociaty()
        local tipsid, content = GetTipsText[58](params[1])
        if inSociaty then
            return SociatyModel:GetInstance():GetBuildLevel(T[1]) >= T[2], tipsid, content
        else
            return false, tipsid, content
        end
        return true
    end,
    [ConditionType.serverTimeBefore] = function(params)
        local result = _G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time < (params[1] - 1) *
                           86400
        if not result then
            local tipsid, content = GetTipsText[59](params[1])
            return false, tipsid, content
        else
            return true
        end
    end,
    ---开服时间在此之前, 绝对时间戳(纯客户端判定)
    [ConditionType.ServerTimestampBefore] = function(params)
        local timestamp = params[1]
        local openTime = _G.PlayerModel:GetInstance():GetServerOpenTime()
        return openTime < timestamp
    end,
    ---开服时间在此之后, 绝对时间戳(纯客户端判定)
    [ConditionType.ServerTimestampAfter] = function(params)
        local timestamp = params[1]
        local openTime = _G.PlayerModel:GetInstance():GetServerOpenTime()
        return openTime >= timestamp
    end,
    [ConditionType.ArraignedMod] = function(params)
        local value = params and params[1] or 0
        local bool = value ~= 1 or not _G.AppSetting.IsArraigned
        if not bool and #params > 1 then
            for i = 2, #params do
                local platform = params[i]
                if platform == 0 or platform == _G.GameUtil.GetPlatform() then
                    return false
                end
            end
            bool = true
        end
        return bool
    end,
    ---战争债券大于多少
    [ConditionType.WarBonds] = function(params)
        local model = require("ActivityDispatchModel"):GetInstance()
        return model:GetHisCoinNum() >= params[1]
    end,
    ---巅峰演武兑换币大于多少
    [ConditionType.GMArenaPeakCoin] = function(params)
        local model = require("GMArenaPeakModel"):GetInstance()
        return model:GetHisCoinNum() >= params[1]
    end,
    ---英雄圣像总等级大于多少
    [ConditionType.HeroicIconLevel] = function(params)
        local model = require("HeroicIconModel"):GetInstance()
        return model:GetIconTotalLevel() >= params[1]
    end,
    ---当前赛季充值金额大于多少
    [ConditionType.CurSeasonAmount] = function(params)
        local Amount = require("SeasonRecordRechargeModel"):GetInstance():GetRecordNum()
        return Amount >= params[1]
    end,
    ---该活动运行时间大于多少
    [ConditionType.ActivityTime] = function(params)
        local activity = require "ActivitySynManager":GetInstance():GetActivityClass(params[1])
        if not activity then
            return false
        end
        local dayTime = math.ceil((_G.TimeUtil.GetServerUnixTime() - activity.cfg.time.start_time) / 86400)
        return dayTime >= params[2]
    end,
    ---日常活跃度大于多少
    [ConditionType.DailyActive] = function(params)
        local model = require("ActiveTaskManager"):GetInstance()
        return model.ActiveValue >= params[1]
    end,
    ---公会试炼次数大于多少
    [ConditionType.GuildTrain] = function(params)
        local model = require("SociatyModel"):GetInstance()
        return model:GetChallenge_times() >= params[1]
    end,
    ---当前平台是否为目标平台
    [ConditionType.Platform] = function(params)
        for _, platform in pairs(params) do
            if platform == 0 then
                -- 配0全平台开放
                return true
            end
            if platform == _G.GameUtil.GetPlatform() then
                return true
            end
        end
        return false
    end,
     ---收集奇物x品质以上y数量
    [ConditionType.RemainsGradeNum] = function(params)
        local model = require("RemainsModel"):GetInstance()
        return model:GetNumByGrade(params[1]) >= params[2]
    end,
    ---女仆毕业数量
    [ConditionType.MaidFinishNum] = function(params)
        local finishnum = require("MaidAcademyModel"):GetInstance().study_info and
                              require("MaidAcademyModel"):GetInstance().study_info[1] or 0
        return finishnum >= params[1]
    end
}

-- region 对外接口
-----检测条件是否完成
---@param _type number 类型
---@param params table 参数(二维数组)
---@return boolean 检测是否通过
function GlobalConditionManager.CheckConditionPass(_type, params)
    if _type == 0 then
        return true
    end
    local func = CheckFunction[_type]
    if func then
        local pass = true
        local tipsid, content
        for i = 1, #params do
            pass, tipsid, content = func(params[i])
            if not pass then
                return false, tipsid, content
            end
        end
        return true
    end

    if _G.AppSetting.DEBUG then
        _G.LogWarning("未检测到判定类型 type=" .. _type)
    end
    return false
end

