---显示黑名单，在其中则不显示
local blackIdList = { 79 }

function CommonAwardView:Awake()
    currencySids = {}
    local currencyCfg = _G.ConfigManager.currency_type_client_cfg
    for k, v in pairs(currencyCfg) do
        local data = v.id
        currencySids[data] = k
    end
    self.awardData = {}
    self.clickFunction = {
        ["@_aorbtn_close"] = self.OnNext
    }
    self.itemTable = {}
    self.curPage = 1
    self.maxPage = 1
    self.itemTable = {}
    self.maxCount = 1
    self.checkAward = {}
    self.AwardItems = {}

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.ItemAwardAuido)
end

---打开界面动效播放完成
function CommonAwardView:ViewAnimationFinish()
    self.go_table.obj_openEffect:SetActiveE(0)
end

---界面的入口函数
---@param data award.i_award_item 传入奖励的内容
---@param call function
---@param isNotMerge boolean 不合并奖励
---@param path string  标题
---@param isExtra bool  额外奖励显示
---@param isAdd bool 是否显示加成
---@param isFan bool 是否显示加成
---@param isNotSort bool 是否不排序
---@param skinIs bool 是否显示皮肤
---@param sbjc number 公会战奖励显示
---@param otherParam table 其他参数
function CommonAwardView:OnCreate(
    data,
    callBack,
    isNotMerge,
    path,
    isExtra,
    isAdd,
    isFan,
    isNotSort,
    skinIs,
    sbjc,
    bottomContent,
    fangzhiSortBol,
    otherParam)
    if not _G.table.isEmptyOrNil(require "IllustrationModel":GetInstance():GetPurpleCardData()) then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
    end
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DrawResultRoleView.Name) then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
    end
    if _G.table.isEmptyOrNil(data) or not data.award then
        self:Close()
        return
    end
    self.isExtra = isExtra
    self.isAdd = isAdd
    self.isFan = isFan
    self.isNotSort = isNotSort
    self.state = ViewState.PlayEffect
    self.isNotMerge = isNotMerge
    self.fangzhiSortBol = fangzhiSortBol
    self.otherParam = otherParam
    self:ParseData(data)
    self.maxCount = #self.awardData

    self.maxPage = 1

    self.content = self.go_table.obj_Content
    self.callBack = callBack
    if skinIs then
        self.skinIs = true
    else
        self.skinIs = false
    end

    self.sbjc = sbjc
    self.bottomContent = bottomContent
    self:InitAwardItem()
    self:Wait()
    require("QuickUseModel"):GetInstance():AddQuene(self.awardData)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tip, false)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
end

function CommonAwardView:ParseData(data)
    local award = data.award or data
    if award then
        local item = award.item or data
        for _, value in ipairs(item) do
            --活动代币等特殊情况第一个参数是0
            if value.type then
                local sid = value.type[1] == 0 and value.type[3] or value.type[1]
                if false == table.indexof(blackIdList, sid) then
                    self:ParseSimpleAward(value)
                end
            end
        end
        if award.overflow then
            for _, value in ipairs(award.overflow) do
                if value.type then
                    local sid = value.type[1] == 0 and value.type[3] or value.type[1]
                    if false == table.indexof(blackIdList, sid) then
                        self:ParseOverFlow(value)
                    end
                end
            end
        end
    end
end

function CommonAwardView:ParseSimpleAward(data)
    local itemType = data.type or data
    --活动代币等特殊情况第一个参数是0
    if itemType[1] == 0 then
        itemType = {
            itemType[3],
            itemType[4],
            itemType[5],
            itemType[2],
            itemType[1],
            sort = itemType.sort
        }
    end
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            table.insert(
                self.awardData,
                {
                    sid = itemType[1],
                    uid = itemType[2],
                    star = itemType[3],
                    number = 1,
                    type = 1,
                    quality = 1,
                    ispri = itemType.ispri,
                    skinIs = self.skinIs,
                    sort = itemType.sort
                }
            )
        elseif type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            --武器品质
            if type == _G.StorageType.Equipment then
                local len = itemType[3] or 1
                for i = 1, len do
                    table.insert(
                        self.awardData,
                        {
                            sid = itemType[1],
                            uid = itemType[2],
                            number = 1,
                            type = 1,
                            quality = 1,
                            ispri = itemType.ispri,
                            sort = itemType.sort
                        }
                    )
                end
            else
                --刻魂品质
                table.insert(
                    self.awardData,
                    {
                        sid = itemType[1],
                        uid = itemType[2],
                        number = 1,
                        type = 1,
                        quality = 1,
                        ispri = itemType.ispri,
                        sort = itemType.sort
                    }
                )
            end
        elseif type == _G.StorageType.Artifact then
            table.insert(self.awardData, {
                sid = itemType[1],
                uid = itemType[2],
                number = itemType[3],
                sort = itemType.sort
            })
        elseif type == _G.StorageType.Spiritual then
            for i = 1, itemType[3] do
                _G.table.insert(self.awardData, {
                    sid = itemType[1],
                    uid = itemType[2],
                    number = 1,
                    sort = itemType.sort
                })
            end
        elseif type == _G.StorageType.Gemstone then
            _G.table.insert(self.awardData, {
                sid = itemType[1],
                uid = itemType[2],
                type = TypeEnum.Gemstone,
                number = 1,
                sort = itemType.sort
            })
        else
            local addNum = itemType[2] or itemType[3]
            if self.isNotMerge then
                -- (self.awardData)
                -- ("没有合并奖励时的奖励队列")
                table.insert(
                    self.awardData,
                    {
                        sid = itemType[1],
                        number = addNum,
                        type = 1,
                        quality = 1,
                        ispri = itemType.ispri,
                        sort = itemType.sort
                    }
                )
            else
                -- ("合并后的奖励队列")
                -- (self.awardData)
                if self.checkAward[itemType[1]] == nil then
                    table.insert(
                        self.awardData,
                        {
                            sid = itemType[1],
                            number = addNum,
                            type = 1,
                            quality = 1,
                            ispri = itemType.ispri,
                            sort = itemType.sort
                        }
                    )
                    self.checkAward[itemType[1]] = self.awardData[#self.awardData]
                else
                    self.checkAward[itemType[1]].number = self.checkAward[itemType[1]].number + addNum
                end
            end
        end
        --type=1,卡牌，type=2，神器，type=3,货币，type=4,道具，type=5,装备，type=6，刻魂, type=7,灵契
        for i = 1, #self.awardData do
            ---取sid前三位判断是什么类型
            self.SortSid = {}
            if self.awardData[i].sid > _G.ItemSidJudgeSection.ResPropMax then
                self.SortSid = self.awardData[i].sid
                repeat
                    self.SortSid = self.SortSid / 10
                until self.SortSid < 1000
                local a, b = math.modf(self.SortSid)
                self.SortSid = a
            else
                self.SortSid = self.awardData[i].sid
            end
            if self.awardData[i].sid <= _G.ItemSidJudgeSection.ResPropMax then
                --self.awardData.type=2，货币资源
                self.awardData[i].type = TypeEnum.Currency
            elseif self.SortSid >= 100 and self.awardData[i].sid <= 200 then
                --self.awardData.type=1，卡牌
                self.awardData[i].type = TypeEnum.Card
            elseif self.SortSid == 201 then
                --self.awardData.type=4，装备
                self.awardData[i].type = TypeEnum.Equipment
            elseif self.SortSid == 251 then
                self.awardData[i].type = TypeEnum.Decoration
            elseif self.SortSid == 255 then
                --神器
                self.awardData[i].type = TypeEnum.Artifact
            elseif self.SortSid == 256 then
                ---灵契
                self.awardData[i].type = TypeEnum.Spiritual
            elseif _G.table.ContainsValue(_G.NoInitType, self.SortSid) then
                self.awardData[i].type = TypeEnum.RelicTeamBuff
            elseif self.SortSid == 264 then
                --神环
                self.awardData[i].type = TypeEnum.RingGod
            elseif self.SortSid == 273 then
                self.awardData[i].type = TypeEnum.Gemstone
            elseif self.SortSid >= 202 then
                --self.awardData.type=3，道具
                self.awardData[i].type = TypeEnum.Prop
                --self.awardData.type=5,刻魂
            end
        end
        --获取品质
        for i = 1, #self.awardData do
            local list = self.awardData[i]
            if list.type == TypeEnum.Card then
                if currencySids[list.sid] then
                    list.type = TypeEnum.Prop
                    self.awardData[i].quality = _G.ConfigManager.currency_type_client_cfg[list.sid].quality
                else
                    self.awardData[i].quality = _G.ConfigManager.card_cfg[list.sid].Order
                end
            elseif list.type == TypeEnum.Currency then
                if currencySids[list.sid] then
                    list.type = TypeEnum.Prop
                    self.awardData[i].quality = _G.ConfigManager.currency_type_client_cfg[list.sid].quality
                else
                    self.awardData[i].quality = _G.ConfigManager.currency_type_cfg[list.sid].Quality
                end
            elseif list.type == TypeEnum.Prop then
                self.awardData[i].quality = _G.ConfigManager.item_cfg[list.sid].Quality
            elseif list.type == TypeEnum.Equipment then
                self.awardData[i].quality = _G.ConfigManager.equipment_cfg[list.sid].grade
            elseif list.type == TypeEnum.Decoration then
                self.awardData[i].quality = _G.ConfigManager.decoration_cfg[list.sid].grade
            elseif list.type == TypeEnum.Artifact then
                self.awardData[i].quality = _G.ConfigManager.artifact_cfg[list.sid].Order
            elseif list.type == TypeEnum.Spiritual then
                self.awardData[i].quality = _G.ConfigManager.spiritual_cfg[list.sid].Order
            elseif list.type == TypeEnum.RelicTeamBuff then
                self.SortSid = {}
                if self.awardData[i].sid > 1000 then
                    self.SortSid = self.awardData[i].sid
                    repeat
                        self.SortSid = self.SortSid / 10
                    until self.SortSid < 1000
                    local a, b = math.modf(self.SortSid)
                    self.SortSid = a
                else
                    self.SortSid = self.awardData[i].sid
                end
                self.awardData[i].quality = _G.ConfigManager[_G.NoInitTypeToCfg[self.SortSid]].grade
            elseif list.type == TypeEnum.RingGod then
                self.awardData[i].quality = _G.ConfigManager.god_halo_cfg[list.sid].grade
            elseif list.type == TypeEnum.Gemstone then
                self.awardData[i].quality = _G.ConfigManager.gem_cfg[list.sid].grade
            end
        end
        if not self.isNotSort then
            if self.fangzhiSortBol then
                _G.SortList(
                    self.awardData,
                    function(a)
                        return a.sort or 0, a.quality, -a.type, -a.sid
                    end
                )
            elseif self.otherParam and self.otherParam.relicTeamSortBol then
                table.sort(self.awardData, function(a, b)
                    if a.sid == 76 and b.sid ~= 76 then
                        return true
                    elseif b.sid == 76 and a.sid ~= 76 then
                        return false
                    elseif a.type == TypeEnum.RelicTeamBuff and b.type ~= TypeEnum.RelicTeamBuff then
                        return true
                    elseif b.type == TypeEnum.RelicTeamBuff and a.type ~= TypeEnum.RelicTeamBuff then
                        return false
                    elseif a.quality ~= b.quality then
                        return a.quality > b.quality
                    elseif a.type ~= b.type then
                        return a.type < b.type
                    else
                        return a.sid < b.sid
                    end
                end)
            else
                _G.SortList(
                    self.awardData,
                    function(a)
                        return a.sort or 0, -a.type, a.quality, -a.sid
                    end
                )
            end
        end
    end
end

function CommonAwardView:ParseOverFlow(data)
    local itemType = data.type or data
    --活动代币等特殊情况第一个参数是0
    if itemType[1] == 0 then
        itemType = { itemType[3], itemType[4], itemType[5], itemType[2], itemType[1] }
    end
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            for i = 1, itemType[2] do
                table.insert(
                    self.awardData,
                    {
                        sid = itemType[1],
                        uid = 0,
                        star = itemType[3],
                        number = 1,
                        type = 1,
                        quality = 1,
                        skinIs = self.skinIs
                    }
                )
            end
        elseif type == _G.StorageType.Equipment or type == _G.StorageType.Decoration then
            for i = 1, itemType[2] do
                table.insert(
                    self.awardData,
                    { sid = itemType[1], uid = 0, element = itemType[3], number = 1, type = 1, quality = 1 }
                )
            end
        else
            local addNum = itemType[2]
            if self.isNotMerge then
                if self.isExtra then
                    local count
                    if self.checkAward[itemType[1]] == nil then
                        count = _G.math.ceil(addNum / 2)
                        table.insert(self.awardData, { sid = itemType[1], number = count, type = 1, quality = 1 })
                        if addNum > count then
                            table.insert(
                                self.awardData,
                                { sid = itemType[1], number = addNum - count, type = 1, quality = 1 }
                            )
                        end
                    else
                        table.insert(self.awardData, { sid = itemType[1], number = addNum, type = 1, quality = 1 })
                    end
                else
                    table.insert(self.awardData, { sid = itemType[1], number = addNum, type = 1, quality = 1 })
                end
            else
                if self.checkAward[itemType[1]] == nil then
                    table.insert(self.awardData, { sid = itemType[1], number = addNum, type = 1, quality = 1 })
                    self.checkAward[itemType[1]] = self.awardData[#self.awardData]
