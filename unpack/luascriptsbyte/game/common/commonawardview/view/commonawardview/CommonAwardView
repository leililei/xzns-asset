                self.awardData[i].type = TypeEnum.Equipment
            elseif self.SortSid == 251 then
                self.awardData[i].type = TypeEnum.Decoration
            elseif self.SortSid == 255 then
                --神器
                self.awardData[i].type = TypeEnum.Artifact
            elseif self.SortSid == 256 then
