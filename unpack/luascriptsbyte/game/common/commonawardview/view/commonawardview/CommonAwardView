function CommonAwardView:RefreshAwardItem(index, obj)
    local instanceID = obj:GetInstanceIDE()
    self.awardItem = self.AwardItems[instanceID]

    if not self.awardItem then
        obj:SetActiveE(0)
        local item = require "CommonAwardView_AwardItem".New(obj, itemNum)
        self.awardItem = item
        self.AwardItems[instanceID] = item
        if index < 15 then
            _G.DelayDo(
                0.1 * index,
                function()
                    if self.go_table then
                        obj:SetActiveE(1)
                        _G.DelayDo(
                            1,
                            function()
                                if self.go_table then
                                    obj:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Animator)).enabled = false
                                    --ZHJH-3380【首充】首充购买成功弹窗界面排列错误
                                    --临时解决方案: 将坐标调整到正确的位置
                                    if item.ItemList and item.ItemList[1] then
                                        ----@type ui_params_cfg
                                        item.ItemList[1].go_table.obj_Root:SetLocalPosition(-135, 0, 0)
                                        item.ItemList[1].go_table.aortext_name:GetParent():SetLocalPosition(55, 0, 0)
                                        if _G.AppSetting.IsXzns then
                                            _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CommonAwardViewReward,
                                                item.ItemList[1].go_table)
                                        else
                                            _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CommonAwardView,
                                                item.ItemList[1].go_table)
                                        end
                                        item.ItemList[1].go_table.aortext_name:GetParent():SetLocalScaleXYZ(1)
                                    end
                                end
                            end
                        )
                    end
                end
            )
        else
            obj:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Animator)).enabled = false
            obj:SetActiveE(1)
            if item.ItemList and item.ItemList[1] then
                ----@type ui_params_cfg
                item.ItemList[1].go_table.obj_Root:SetLocalPosition(-135, 0, 0)
                item.ItemList[1].go_table.aortext_name:GetParent():SetLocalPosition(55, 0, 0)
                if _G.AppSetting.IsXzns then
                    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CommonAwardViewReward, item.ItemList[1].go_table)
                else
                    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.CommonAwardView, item.ItemList[1].go_table)
                end
                item.ItemList[1].go_table.aortext_name:GetParent():SetLocalScaleXYZ(1)
            end
        end
    end
    ---@type CommonAwardView_AwardItemParames
    local params = {
        index = index + 1,
        datas = self.awardData,
        isExtra = self.isExtra,
        isAdd = self.isAdd,
        skinIs = self.skinIs
    }
    self.awardItem:Show(params)
end

function CommonAwardView:GetTable(startIndex, endIndex)
    local table = {}
    for i = 1, MaxItemNum do
        table[i] = self.awardData[startIndex + i - 1]
    end
    return table
end

---初始化界面
function CommonAwardView:OnLast()
    if self.isDrag then
        return
    end
    self.curPage = self.curPage - 1
    self:MovePos()
end

function CommonAwardView:Wait()
    if self.wait then
        _G.coroutine.stopwaiting(self.wait)
    end
    self.wait = _G.DelayDo(
        0.6,
        function()
            self.state = ViewState.Click
            if self.go_table then
                _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tip, true)
            end
        end
    )
end

function CommonAwardView:OnNext()
    if self.state ~= ViewState.Click then
        return
    end
    self.curPage = self.curPage + 1
    if self.curPage > self.maxPage then
        if self.wait then
            _G.coroutine.stopwaiting(self.wait)
        end
        if self.co then
            _G.coroutine.stopwaiting(self.co)
        end
        self:Close()
        if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.DrawResultRoleView.Name) then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DrawResultRoleView.Name)
        end
        local QuickGetRewardView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.QuickGetRewardView
            .Name)
        if QuickGetRewardView ~= nil and QuickGetRewardView.go_table.gameObject:GetctiveInHierarchy() == 1 then
            if self.callBack then
                self:CloseCallBack(self.awardItem:GetDatas())
                return
            end
        end
        if self.callBack then
            self:CloseCallBack(self.awardData)
        end
        return
    end
    if self.item then
        if self.wait then
            _G.coroutine.stopwaiting(self.wait)
        end
        _G.GameUtil.SetActiveByCondition(self.gameObject, false)
        _G.GameUtil.SetActiveByCondition(self.gameObject, true)
        local lastIndex = self.maxCount > self.curPage * MaxItemNum and self.curPage * MaxItemNum or self.maxCount
        self.state = ViewState.PlayEffect
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_tip, false)
        self.item:UpdateData(self:GetTable((self.curPage - 1) * MaxItemNum + 1, lastIndex))
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    end
end

function CommonAwardView:CloseCallBack(data)
    self.callBack(data)
end

function CommonAwardView:UpdateUpAndDown()
    if self.maxPage == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, false)
    elseif self.curPage == self.maxPage then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, true)
    elseif self.curPage == 1 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_last, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_next, true)
    end
end

--更新数据

function CommonAwardView:CloseView()
    for i, v in pairs(self.itemTable) do
        v.Dispose()
    end
    self.itemTable = nil
    self:Close()
end

---按钮点击事件在这里派发
function CommonAwardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    else
        if _G.AppSetting.DEBUG then
            _G.Log(go:GetName() .. "未触发点击事件")
        end
    end
end

function CommonAwardView:OnDestroy()
    _G.PopWindowManager:GetInstance():OnViewClose()
    _G.PopWindowManager:GetInstance():Next()
    require("QuickUseModel"):GetInstance():CheckCanQucikUse()
end

return CommonAwardView
