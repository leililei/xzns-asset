---@class BaseAwardNewItem	中文描述
local BaseAwardNewItem = _G.BaseClass("BaseAwardNewItem")
local extraAwardAorImagePath = "UIH5/Common/AwardView/ExtraItem"
local typeof = _G.typeof
local CS = _G.CS
---类的构造函数
function BaseAwardNewItem:__init(go, callback, size, parent, longcallback)
    self.gameObject = go
    self.transform = go
    if go:GetComponentE(typeof(CS.UIGoTable)) then
        self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClickBtn))
    end

    self.callback = callback
    self.size = size or 110
    if not self.go_table then
        self.parent = go
    else
        self.parent = parent or self.go_table.obj_Root
    end
    self.LongCallBack = longcallback
end

function BaseAwardNewItem:OnLongPressBigAward()
    if self.IsLong then
        return
    end
    self.IsLong = true
    if self.LongCallBack then
        self.LongCallBack()
    end
end

function BaseAwardNewItem:OnUpPressBigAward()
    self.IsLong = false
end

---类的析构函数
function BaseAwardNewItem:Dispose()
end

function BaseAwardNewItem:Show(data, loadedCall, type2, isShow, ispri)
    self.data = data
    self.isStroage = false
    self.isShow = isShow
    self.loadedCall = loadedCall
    self.ispri = ispri
    if self.data.extra ~= nil then
        self:ShowDoubleIcon()
    end
    local type = type2
    if not type then
        type = _G.StorageManager:GetInstance():CheckSidType(data.sid)
    end
    if self.item then
        if self.type == type then
            self:LoadedCall(self.item, true)
            return
        else
            _G.DestroyObject(self.item.go_table.gameObject)
            self.item = nil
        end
    end
    if self.spawnItem then
        self.spawnItem:Dispose()
        self.spawnItem = nil
    end

    self.type = type
    self.spawnItem =
        require "BaseAward_SpawnItem".New(
        type,
        data,
        self.parent,
        _G.handler(self, self.LoadedCall),
        _G.handler(self, self.OnClickItem, data)
    )
end

function BaseAwardNewItem:LoadedCall(item, isSetData)
    self.item = item
    if self.type == _G.StorageType.Card then
        item:ShowCardData(self.data, _G.handler(self, self.OnClickItem), self.data.skinIs or false)
        if self.isShow then
            _G.GameUtil.SetActiveByCondition(item.go_table.obj_lvNode, true)
        else
            _G.GameUtil.SetActiveByCondition(item.go_table.obj_lvNode, false)
        end
    elseif self.type == _G.StorageType.Decoration then
        item:ShowData(self.data)
    elseif self.type == _G.StorageType.Equipment then
        self.isStroage = true
        if isSetData then
            item:ShowData(self.data, _G.handler(self, self.OnClickItem))
        end
        if self.data.count > 0 then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        item:SetGrade(true)
    elseif self.type == _G.StorageType.Artifact then
        self.isStroage = true
        item:ShowData(self.data, _G.handler(self, self.OnClickItem))
    elseif self.type == _G.StorageType.Spiritual then
        self.isStroage = true
        item:ShowData(self.data, _G.handler(self, self.OnClickItem))
        item:HideStar()
    elseif self.type == _G.StorageType.Debris then
        self.isStroage = true
        item:ShowData(self.data, _G.handler(self, self.OnClickItem))
    elseif self.type == _G.StorageType.Gemstone then
        self.isStroage = true
        local gem = require("GemstoneModel"):GetInstance():GetGemDataByUid(self.data.uid)
        if gem then
            item:ShowData(gem, _G.handler(self, self.OnClickItem))
        else
            item:Show(self.data.sid, _G.handler(self, self.OnClickItem))
        end
    else
        self.isStroage = true
        if isSetData then
            item:Init(item.transform, self.data, _G.handler(self, self.OnClickItem))
        end
        if self.data.count > 0 then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        item:SetGrade(true)
    end
    self:ResetPoint(item)
    self:SetScale(item)
    if item.go_table.aorimage_pri then
        item.go_table.aorimage_pri:SetActiveE(self.ispri and 1 or 0)
    end

    if self.LongCallBack then
        item.go_table.aorbtn_Click.LongPress = true
        item.go_table.aorbtn_Click.onLongPress = _G.handler(self, self.OnLongPressBigAward)
    end

    if self.loadedCall then
        self.loadedCall(self)
        self.loadedCall = nil
    end
end

function BaseAwardNewItem:ShowWithID(data, uid, loaded, isHide)
    local sid = data[1] == 0 and _G.tonumber(data[4]) or _G.tonumber(data[1])
    local type, id = _G.StorageManager:GetInstance():CheckSidType(sid)
    local _data
    if uid and uid > 0 and uid ~= sid then
        _data = _G.StorageManager:GetInstance():GetItemDataByID(id, uid)
    else
        _data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)
    end
    self:Show(_data, loaded, type, isHide)
end

function BaseAwardNewItem:SetScale(item)
    item.go_table.gameObject:SetAnchorPosition(0, 0)
    if self.isStroage then
        local size = self.size / 88
        if size > 1 then
            size = 1
        end
        item.go_table.gameObject:SetLocalScaleXYZ(size)
    else
        local x = item.go_table.gameObject:GetRectTransformSizeDelta()
        item.go_table.gameObject:SetLocalScaleXYZ(self.size / x)
    end
end
function BaseAwardNewItem:ShowDoubleIcon()
    if self.data.extra ~= nil then
        _G.PoolsManager:GetInstance():Spawn(
            extraAwardAorImagePath,
            _G.ePoolType.UIItem,
            self.parent,
            function(tran)
            end
        )
    end
end
function BaseAwardNewItem:OnClickBtn()
    if self.callback then
        self.callback(self)
    end
end
---重置物体中心点
function BaseAwardNewItem:ResetPoint(item)
    item.go_table.gameObject:SetRectTransformAnchor(0.5, 0.5, 0.5, 0.5)
    item.go_table.gameObject:SetPivotPosition(0.5, 0.5)
end

function BaseAwardNewItem:OnClickItem(data)
    if self.callback then
        self.callback(self)
    else
        if self.go_table then
            require "CommonTipManager":GetInstance():OpenTip(
                self.go_table.gameObject,
                self.data.sid,
                self.data.uid,
                data
            )
        else
            require "CommonTipManager":GetInstance():OpenTip(self.gameObject, self.data.sid, self.data.uid, data)
        end
    end
end

function BaseAwardNewItem:ShowEffect(isShow, scale)
    self.isShow = isShow
    if self.EffDic == nil then
        self.EffDic = {}
    end
    local effect, key = _G.StorageManager:GetInstance():GetCommonLightEffect(self.data.sid)
    if self.EffDic[self.NowEffKey] and self.EffDic[self.NowEffKey] ~= true then
        self.EffDic[self.NowEffKey]:SetActiveE(0)
    end
    if not self.isShow then
        return
    end
    self.NowEffKey = key
    if self.EffDic[key] == nil then
        self.EffDic[key] = true
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.gameObject,
            function(trans)
                --trans:SetAnchorPosition(5.5, -12, 0)
                trans:SetLocalScaleXYZ(scale or 1.1)
                self.EffDic[key] = trans
                if key ~= self.NowEffKey or self.isShow == false then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
            end
        )
    elseif self.EffDic[key] ~= true then
        self.EffDic[key]:SetActiveE(isShow and 1 or 0)
    end
end

return BaseAwardNewItem
