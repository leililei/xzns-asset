function CardAwardTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CardAwardTipView:OnCreate(sid, callback)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.DrawResultView, self.go_table)
    self.config = _G.ConfigManager.card_cfg[sid]
    self.callback = callback
    self:RefreshView()
    self:RefreshSkill()
    ---适配刘海屏
    local x, y, z = self.go_table.aorimage_new:GetLocalPosition()
    self.go_table.aorimage_new:SetLocalPosition(x, y + Woff, z)
end

function CardAwardTipView:RefreshView()
    self.go_table.aorimage_Orderzi.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(
        self.config.Order)
    self.go_table.obj_cardSpine:SetLocalScaleXYZ(self.config.size8)
    local pos = self.config.pos_portrait8
    self.go_table.obj_cardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
    require("CardInfoManager"):GetInstance().GetRole(
        self.config.ModelPathHi,
        _G.ePoolType.Temporary,
        self.go_table.obj_cardSpine,
        nil,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
            if _G.AppSetting.IsXzns then
                local spineCfg = _G.ConfigManager.card_show_cfg[self.config.id] or _G.ConfigManager.skin_cfg[self.config.id]
                local idle = spineCfg.display_idle[1]
                _G.GameUtil.SetCardUiSpineAnimation(trans, idle, true)
                _G.GameUtil.SetUiHeXieMask(self.go_table)
            end
        end
    )
    self.go_table.aortext_Name.text = _G.GetLangPackValue(self.config.Name)
    self.go_table.aorimage_ShuXing.SpriteName = ElementsIcon[self.config.Elements]
    local SpriteName
    for i = 1, 5 do
        SpriteName = require("CardInfoManager"):GetInstance():GetHuoSpriteName(self.config.Star, i)
        if SpriteName then 
            self.go_table["aorimage_star" .. i].SpriteName = SpriteName
        end
        self.go_table["aorimage_star" .. i]:SetActiveE(SpriteName and 1 or 0)
    end
    self.go_table.aorrawimage_BG:LoadImage(
        Grade[self.config.Order].BG,
        function()
            if not self:IsNil() then
                self.go_table.aorrawimage_BG:SetActiveE(1)
            end
        end
    )
    if AppSetting.IsXzns then
        self.go_table.aorrawimage_bottombg:LoadImage(Grade[self.config.Order].Bottombg)
    end

    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.DrawResultView) then
        self.go_table.aorrawimage_portrait:RemoveAllChildren()
        self.go_table.aorrawimage_portrait.color = _G.Color.New(1, 1, 1, 0)
        _G.PoolsManager:GetInstance():Spawn(
                _G.UIUtils.GetBattleSpine(self.config),
                _G.ePoolType.Temporary,
                self.go_table.aorrawimage_portrait,
                function(trans)
                    trans:SetLocalScaleXYZ(self.config.size4)
                    trans:SetLocalPosition(0, 0, 0)
                end
        )
    else
        self.go_table.aorrawimage_portrait:LoadImage(
                self.config.Portrait,
                function()
                    if not _G.IsNil(self.go_table) then
                        self.go_table.aorrawimage_portrait:SetNativeSize()
                    end
                end
        )
        self.go_table.aorrawimage_portrait1:LoadImage(
                self.config.Portrait,
                function()
                    if not _G.IsNil(self.go_table) then
                        self.go_table.aorrawimage_portrait1:SetNativeSize()
                        local pos = self.config.pos_portrait4
                        self.go_table.aorrawimage_portrait1:SetLocalPosition(pos[1], pos[2], pos[3])
                        self.go_table.aorrawimage_portrait1:SetLocalScaleXYZ(self.config.Size)
                        self.go_table.aorrawimage_portrait1.color = _G.Color.New(1, 1, 1, 25 / 255)
                    end
                end
        )
    end
    self.go_table.aorimage_ShuXing1.SpriteName = ElementsIcon1[self.config.Elements]
    self.go_table.aortext_Professional1.text = _G.LangUtil.GetLangPackValue(ProfessionalCNTxt[self.config.Professional])
    self.go_table.aortext_Professional2.text = _G.LangUtil.GetLangPackValue(ProfessionalENTxt[self.config.Professional])
    if _G.GameUtil.GetUsedLang() == "zh-CN" then
        self.go_table.aortext_Professional2:SetActiveE(1)
    else
        self.go_table.aortext_Professional2:SetActiveE(0)
        if _G.GameUtil.GetUsedLang() == "ru" then
            self.go_table.aortext_Professional1.fontSize = 26
        end
    end
    local posText
    local posId = self.config.card_position1
    if posId > 0 then
        posText = _G.GetLangPackValue(posId)
    end
    posId = self.config.card_position2
    if posId > 0 then
        if _G.AppSetting.IsXzns then
            posText = posText .. "," .. _G.GetLangPackValue(posId)
        else
            posText = posText .. "/" .. _G.GetLangPackValue(posId)
        end
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_ProfessionalDes.text = _G.LangUtil.GetLangPackValue(ProfessionalCNTxt[self.config.Professional],
                48) .. "," .. posText
    else
        self.go_table.aortext_ProfessionalDes.text = posText
    end
    if self.config.Order < 5 then 
        self.go_table.aorimage_core:SetActiveE(0)
    else 
        self.go_table.aorimage_core:SetActiveE(1)
    end
    local icon = require("CardInfoManager"):GetInstance():GetCardGradeFlag1(self.config.Order, self.config.sid)
    if icon then
        self.go_table.aorimage_core.SpriteName = icon
    end
end

---刷新技能
function CardAwardTipView:RefreshSkill()
    local cardLevelCfg = _G.ConfigManager.card_level_cfg[800].level_skill[self.config.Order]
    local tb = {}
    tb[1] = _G.GetAutoGoTable(self.go_table.obj_skill1, _G.handlerbind(self, self.TipYe, 1))
    tb[3] = _G.GetAutoGoTable(self.go_table.obj_skill2, _G.handlerbind(self, self.TipYe, 3))
    tb[4] = _G.GetAutoGoTable(self.go_table.obj_skill3, _G.handlerbind(self, self.TipYe, 4))
    tb[5] = _G.GetAutoGoTable(self.go_table.obj_skill4, _G.handlerbind(self, self.TipYe, 5))
    self.dataIdList = {}
    for i = 1, 5 do
        if cardLevelCfg[i] == 0 then
            tb[i].gameObject:SetActiveE(0)
        elseif i ~= 2 then
            tb[i].gameObject:SetActiveE(1)
            local dataId = self.config.id + 100 * i + 1
            self.dataIdList[i] = dataId
            self:SkillInfo(tb[i], dataId, i)
            local skills = _G.ConfigManager.card_skills_cfg[dataId]
            --名字
            if skills then 
                tb[i].aortext_name.text = _G.LangUtil.GetLangPackValue(skills.name1)
            end
        end
    end
end

---@param skillID number _<0 为未解锁该技能
function CardAwardTipView:SkillInfo(obj, skillID, index)
    local isShow = false
    if skillID > 0 then
        isShow = true
    else
        skillID = _G.math.abs(skillID)
    end
    local go_table = obj
    if go_table == nil then
        return
    end

    if go_table.SkillClick == nil then
        go_table.SkillClick = true
    end

    local nowskillCfg = _G.ConfigManager.card_skills_cfg[skillID]
    if nowskillCfg == nil then
        go_table.gameObject:SetActiveE(0)
        return
    end

    if nowskillCfg then
        require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skill, nowskillCfg.icon)
        go_table.aorimage_nuqi:SetActiveE(nowskillCfg.skill_pos == 1 and 1 or 0)
    else
        isShow = false
    end
    --锁隐藏
    go_table.obj_skilllock:SetActiveE(not isShow and 1 or 0)

    --等级显示
    go_table.aorimage_skilllevel:SetActiveE(0)
    -- --有该技能才显示技能图标
    go_table.gameObject:SetActiveE(1)
    return go_table.gameObject
end

---技能tip显示
function CardAwardTipView:TipYe(go, _, dataId)
    local skillid = self.dataIdList[dataId] + 4
    for i = 1, 10 do
        if _G.ConfigManager.card_skills_cfg[skillid - i] then
            skillid = skillid - i
            break
        end
    end

    require("CommonTipManager"):GetInstance():OpenSkillTip(skillid)
end

---界面的销毁函数
function CardAwardTipView:OnDestroy()
    if self.callback then
        self.callback()
    end
end

---按钮点击事件在这里派发
function CardAwardTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return CardAwardTipView
