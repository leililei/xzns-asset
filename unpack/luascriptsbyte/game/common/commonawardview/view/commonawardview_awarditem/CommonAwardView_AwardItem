---@class CommonAwardView_AwardItem    中文描述
---@field ItemList BaseAwardNewItem[]
---@field go_table _obj_AwardItem._obj_Award_GoTable
local CommonAwardView_AwardItem = _G.BaseClass("CommonAwardView_AwardItem")
local MaxItemNum = 10
local itemNum = 1 -- 最多多少个子物体
---类的构造函数
function CommonAwardView_AwardItem:__init(obj, num)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj)
    itemNum = num
    self:InitItemList()
end

---初始化itemList
function CommonAwardView_AwardItem:InitItemList()
    self.ItemList = {}
    local count = itemNum
    for i = 1, count do
        self.ItemList[i] = require "BaseAwardNewItem".New(self.transform:GetChildE(i - 1))
    end
end

---@field index number 下标
---@field datas table 所有奖励数据
---@field isExtra boolean 是否为双倍资源
---@field isAdd boolean 是否为加成资源
---@class CommonAwardView_AwardItemParames

---更新显示
---@param params CommonAwardView_AwardItemParames
function CommonAwardView_AwardItem:Show(params)
    local extra
    self.isExtra = params.isExtra
    self:InitData(params.datas)
    for i, v in ipairs(self.ItemList) do
        local data = self.datas[i + (params.index - 1) * itemNum]
        if not data then
            _G.GameUtil.SetActiveByCondition(v.gameObject, false)
        else
            local pri = data.ispri
            if data.extra ~= nil then
                extra = 1
            end
            if data.uid and data.uid > 0 and data.uid ~= data.sid then
                local type, id = _G._G.StorageManager:GetInstance():CheckSidType(data.sid)
                local temp = type ~= _G.StorageType.Card and --卡牌被消耗后, 其内部的数据将被清空
                    _G.StorageManager:GetInstance():GetItemDataByID(id, data.uid)
                if temp then
                    data = temp
                else
                    data = _G.StorageManager:GetInstance():GetItemDataClass(data.sid, data.number,
                        { data.star or data.element })
                end
            else
                data = _G.StorageManager:GetInstance():GetItemDataClass(data.sid, data.number, { data.star or data.element })
            end
            data.extra = extra
            local type, id = _G._G.StorageManager:GetInstance():CheckSidType(data.sid)
            if type == _G.StorageType.Card then
                v.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.Name or data.cfg.name)
            else
                v.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.cfg.name or data.cfg.Name)
            end
            if v.go_table.obj_add then
                if params.isAdd then
                    _G.GameUtil.SetActiveByCondition(
                        v.go_table.obj_add,
                        not _G.table.isEmptyOrNil(
                            require "PrivilegeManager":GetInstance():GetPrivilegeData(
                                { _G.PrivilegeType.Dungones.Item, data.sid }
                            )
                        )
                    )
                else
                    _G.GameUtil.SetActiveByCondition(v.go_table.obj_add, false)
                end
            end
            data.skinIs = params.skinIs
            v:Show(data, nil, nil, nil, pri)
            local Quality = _G.StorageManager:GetInstance():GetItemQuality(data.sid)
            if Quality >= 5 then
                --v:ShowEffect(true)
            end
            if _G.AppSetting.IsXzns then
                if _G.ConfigManager.item_cfg[data.sid] and _G.ConfigManager.item_cfg[data.sid].Type1 == 22 and data.count >= 60 then
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_daojukuang_xuancai,
                        v.gameObject,
                        function (obj)
                            if not self.go_table then
                                _G.DestroyObject(obj)
                                return
                            end
                        end
                    )
                end
            end
            _G.GameUtil.SetActiveByCondition(v.gameObject, true)
        end
    end
end

function CommonAwardView_AwardItem:GetDatas()
    local tb = {}
    for i = 1, MaxItemNum do
        if self.ItemList[i] and self.ItemList[i].gameObject:GetActiveSelf() == 1 then
            self:SaveData(self.ItemList[i], tb)
        end
    end
    return tb
end

---@param awardItem BaseAwardItem
function CommonAwardView_AwardItem:SaveData(awardItem, tb)
    tb[#tb + 1] = { Pos = _G.Vector3.New(awardItem.gameObject:GetPosition()), data = awardItem.classData }
end

function CommonAwardView_AwardItem:InitData(datas)
    local awards = {}
    local extraAward = {}
    self.datas = datas
    if self.isExtra then
        local tmp
        for _, v in pairs(datas) do
            if not awards[v.sid] then
                awards[v.sid] = v
            else
                if awards[v.sid].number >= v.number then
                    v.extra = 1
                    extraAward[v.sid] = v
                else
                    awards[v.sid].extra = 1
                    tmp = extraAward[v.sid]
                    extraAward[v.sid] = awards[v.sid]
                    awards[v.sid] = tmp
                end
            end
        end
        local sum = {}
        for i, v in pairs(awards) do
            _G.table.insert(sum, v)
        end
        if not _G.table.isEmptyOrNil(extraAward) then
            for i, v in pairs(extraAward) do
                _G.table.insert(sum, v)
            end
        end
        self.datas = sum
    end
end

---类的析构函数
function CommonAwardView_AwardItem:Dispose()
end

return CommonAwardView_AwardItem
