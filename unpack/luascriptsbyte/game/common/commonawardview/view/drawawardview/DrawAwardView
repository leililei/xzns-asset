-- 重写父类的 InitAwardItem
function DrawAwardView:InitAwardItem()
    local itemCount = #self.awardData

    self.go_table.obj_AwardItem:ClearChildren()
    for i = 1, itemCount do
        local obj = _G.InstantiateObject(self.go_table.obj_Award, self.go_table.obj_AwardItem)
        local instance = obj:GetInstanceIDE()
        if self.AwardItems[instance] == nil then
            self.AwardItems[instance] = require("CommonAwardView_AwardItem").New(obj, 1)--, nil, 110)
        end

        ---@type CommonAwardView_AwardItemParames
        local params = {
            index = i,
            datas = self.awardData,
            isExtra = self.isExtra,
            isAdd = self.isAdd,
            skinIs = self.skinIs
        }
        self.AwardItems[instance]:Show(params)
        _G.DelayDo(0.1, function()
            if self.go_table then
                obj:SetActiveE(1)
                if self.AwardItems[instance].ItemList and self.AwardItems[instance].ItemList[1] then
                    --物品位置
                    self.AwardItems[instance].ItemList[1].gameObject:SetLocalPosition(
                        pos[itemCount][i].x,
                        pos[itemCount][i].y
                    )

                    --文字颜色
                    local itemType, grade
                    if self.awardData[i] and self.awardData[i].sid then
                        itemType = _G.StorageManager:GetInstance():CheckSidType(self.awardData[i].sid)
                        grade = self.awardData[i].quality
                        local color, isColor = _G.GameUtil.GetColorByQualityNewH5(itemType, grade)
                        if _G.AppSetting.IsXzns then
                            if color[1] then
                                _G.UIUtils.ChangeUIMethod({ 4, color[1], color[2] }, self.AwardItems[instance].ItemList[1].go_table.aortext_name)
                            else
                                _G.UIUtils.ChangeUIMethod({ 4, "FFFFFF", "FFFFFF" }, self.AwardItems[instance].ItemList[1].go_table.aortext_name)
                                self.AwardItems[instance].ItemList[1].go_table.aortext_name.color = color
                            end
                        else
                            self.AwardItems[instance].ItemList[1].go_table.aortext_name.color = color
                        end

                        --local Quality = _G.StorageManager:GetInstance():GetItemQuality(self.awardData[i].sid)
                        local isEffect = false
                        if itemType == _G.StorageType.Artifact then
                            isEffect = true
                        elseif itemType == _G.StorageType.Spiritual and grade >= 2 then
                            isEffect = true
                        elseif self.awardData[i].sid == 202090100 then
                            --神器粉尘橙色但不显示特效
                            isEffect = false
                        elseif self.awardData[i].sid == 202100100 then
                            --饰品粉尘不显示特效
                            isEffect = false
                        elseif (grade > 4 and self.awardData[i].number >= 1) or (grade > 3 and self.awardData[i].number >= 60) then
                            --召唤魔兽的碎片大于20才显示特效
                            isEffect = true
                        end
                        if isEffect then
                            self.AwardItems[instance].ItemList[1]:ShowEffect(true)
                        end
                    end
                end
            end
        end)
    end

    --招募消耗材料
    self.go_table.aorrawimage_Prop1:LoadImage(self.otherParam[1])
    self.go_table.aorrawimage_Prop2:LoadImage(self.otherParam[1])
    --10次消耗
    self.go_table.aortext_Prop1Num.text = 1
    self.go_table.aortext_Prop2Num.text = self.otherParam[2]
    self.go_table.aortext_Prop2NumDesc.text = _G.GetLangPackValue(90000011229, _G.GameUtil.NumberToWordByLanguage(self.otherParam[2]))

    if self.bottomContent then
        self.go_table.obj_tip:SetActiveE(1)
        self.go_table.aortext_tip.text = self.bottomContent
    else
        self.go_table.obj_tip:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function DrawAwardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Draw1" then
        -- 招募一次
        if self.callBack then
            self.callBack(DrawType.one, false)
        end
        self:Close()
    elseif name == "@_aorbtn_Draw2" then
        -- 招募十次
        if self.callBack then
            self.callBack(DrawType.ten, false)
        end
        self:Close()

    elseif name == "@_aorbtn_close" then
        self:Close()
        if self.callBack then
            self.callBack()
        end
    end
end

function DrawAwardView:CloseCallBack(data)

end

return DrawAwardView
