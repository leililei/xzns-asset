---类的构造函数
function BaseAwardItem:__init()
end

---类的析构函数
function BaseAwardItem:Dispose()
end

function BaseAwardItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function BaseAwardItem.CreatAwardItem(obj, callback)
    local list = BaseAwardItem.New()
    list.gameObject = obj
    list.transform = obj
    list.itemTransDic = {}
    list:Awake()
    list.callBack = callback
    return list
end
---@param data table<sid,uid,number> 奖励数据
---@param type StorageType 道具类型
---@param isOther  boolean 不用填
function BaseAwardItem:UpdateItem(data, type, isOther)
    if data == nil then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, false)
        return
    end
    if self.go_table.gameObject:GetActiveSelf() == 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.gameObject, true)
    end
    self.sid = data.sid
    local id = _G.StorageID.Prop
    self.type, id = _G.StorageManager:GetInstance():CheckSidType(data.sid)
    self.star = data.star
    self.uid = data.uid
    if data.GetCount then
        self.number = data:GetCount()
    else
        self.number = data.number or data.fixNum
    end

    self.data = data
    if self.uid and self.uid > 0 then
        self.classData = _G.StorageManager:GetInstance():GetItemDataByID(id, self.uid)
    else
        self.classData = _G.StorageManager:GetInstance():GetItemDataClass(self.sid, self.number)
    end

    if self.go_table.aortext_Number then
        if isOther == nil or not isOther then
            self.go_table.aortext_Number.text = "X" .. _G.GameUtil.NumberToUnitStr(self.number)
        else
            if self.number == 1 or not self.number then
                self.go_table.aortext_Number.text = ""
            else
                self.go_table.aortext_Number.text = "x" .. _G.GameUtil.NumberToUnitStr(self.number)
            end
        end
    end

    -- if
    --     type == _G.StorageType.Card and
    --         not _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageType.Card, self.awardData.sid)
    --  then
    --     _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_New, true)
    -- else
    --     _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_New, false)
    -- end

    if self.type == _G.StorageType.Material then
        self:InitCfg(_G.ConfigManager.item_cfg)
        self:ShowMaterial()
    elseif self.type == _G.StorageType.Equipment then
        self.equipmentData = _G.EquipmentItem.New()
        self.equipmentData:Parse(data)
        self:InitCfg(_G.ConfigManager.equipment_cfg)
        self:ShowEquipment()
    elseif self.type == _G.StorageType.Prop then
        self:InitCfg(_G.ConfigManager.item_cfg)
        if self.type == _G.StorageType.Card then
            self:ShowCard()
        else
            self:ShowProp()
        end
    elseif self.type == _G.StorageType.Card then
        self:InitCfg(_G.ConfigManager.card_cfg)
        self:ShowCard()
    else
        if data.sid < 100 and _G.ConfigManager.currency_type_cfg[data.sid] ~= nil then
            self:InitCfg(_G.ConfigManager.currency_type_cfg)
        else
            self:InitCfg(_G.ConfigManager.item_cfg)
        end

        self:ShowProp()
    end

    self:ShowNew()
end

function BaseAwardItem:InitCfg(cfgTable, color)
    local sid = self.sid

    -- if self.sid < 100 then
    --     sid = _G.ResourceItemID[self.sid]
    -- else
    --     sid = self.sid and self.sid or 0
    -- end
    ---@type card_cfg
    local cfg = cfgTable[sid]
    if cfg then
        if self.go_table.aorimage_ColorDi then
            if self.type == _G.StorageType.Card then
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Color, true)
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_ColorDi, true)
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Color2, false)
            else
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Color, false)
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_ColorDi, false)
                _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Color2, true)
            end
        end
        local icon = cfg.Icon and cfg.Icon or cfg.icon
        if self.type == _G.StorageType.Card then
            local star = self.classData and self.classData.star or cfg.Star
            require "CardInfoManager":GetInstance():SetCardColor(
                star,
                self.go_table.aorimage_Color,
                self.go_table.aorimage_ColorDi
            )
            icon = "Images/zRoles/" .. icon
        elseif self.type == _G.StorageType.Equipment then
            if self.go_table.aorimage_Color2 then
                self.go_table.aorimage_Color2.SpriteName = _G.itemColorIconName[cfg.grade]
            else
                self.go_table.aorimage_Color.SpriteName = _G.itemColorIconName[cfg.grade]
            end
        else
            if self.go_table.aorimage_Color2 then
                self.go_table.aorimage_Color2.SpriteName = _G.itemColorIconName[cfg.Quality]
            else
                self.go_table.aorimage_Color.SpriteName = _G.itemColorIconName[cfg.Quality]
            end
        end
        if self.type == _G.StorageType.Prop and cfg.Type1 and cfg.Type1 == 6 and cfg.UseType ~= 9 then
            cfg = _G.ConfigManager.card_cfg[tonumber(cfg.UseParameter[1][2])]
        end
        self.cfg = cfg

        if not string.IsNullOrEmpty(icon) then
            self.go_table.aorrawimage_Icon:LoadImage(icon)
        end
    end
end
---材料更新
function BaseAwardItem:ShowMaterial()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_starParent, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_PropBG, false)

    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(0)
    end
end
---装备更新
function BaseAwardItem:ShowEquipment()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_starParent, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_PropBG, false)
    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(1)
    end
    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(0)
    end
end
---道具更新
function BaseAwardItem:ShowProp()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_starParent, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_PropBG, false)
    if self.go_table.aortext_Number and not self.go_table.aortext_Number then
        self.go_table.aortext_Number:SetActiveE(1)
    end

    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(0)
    end
end
---卡牌更新
function BaseAwardItem:ShowCard()
    self.FontImage_lv = {self.go_table.aorimage_level1}
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_starParent, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_PropBG, true)
    --self.go_table.aortext_Lv.text = self.cfg.Star
    require("CardInfoManager"):GetInstance():Star_byParent2(self.go_table.obj_starParent, self.star)
    self.go_table.aorrawimage_PropBG:LoadImage(_G.ConfigManager.type_elements_cfg[self.cfg.Elements].icon)
    --   self.go_table.aorrawimage_Prop:LoadImage(_G.ConfigManager.type_professional_cfg[self.cfg.Professional].icon)

    if self.data.uid then
        local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.data.uid)
        if self.go_table.aorimage_level1 then
            if not _G.table.isEmptyOrNil(data) then
                _G.UIUtils.SetImageFont(self.FontImage_lv, "v" .. tostring(data.lv), _G.AorImageFont.Cardlevel)
            else
                _G.UIUtils.SetImageFont(self.FontImage_lv, "v" .. tostring(1), _G.AorImageFont.Cardlevel)
            end
        else
            if not _G.table.isEmptyOrNil(data) then
                self.go_table.aortext_Lv.text = data.lv
            else
                self.go_table.aortext_Lv.text = 1
            end
        end
    elseif self.go_table.aorimage_level1 then
        _G.UIUtils.SetImageFont(self.FontImage_lv, "v" .. tostring(1), _G.AorImageFont.Cardlevel)
    else
        self.go_table.aortext_Lv.text = 1
    end
    -- if self.go_table. then
    --     -- body
    -- end
    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(1)
    end
end
---资源更新
function BaseAwardItem:ShowResProp()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_starParent, false)
    if self.go_table.obj_mask then
        self.go_table.obj_mask:SetActiveE(0)
    end
end

---设置初始位置
function BaseAwardItem:SetRootPos(pos)
    self.go_table.obj_Root:SetLocalPosition(pos.x, pos.y, pos.z)
end

---是否显示全新
function BaseAwardItem:ShowNew()
    if not self.go_table.aorimage_New then
        return
    end
    if
        self.type == _G.StorageType.Card and
            not _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageType.Card, self.cfg.sid)
     then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_New, true)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_New, false)
    end
end

function BaseAwardItem:SetAlpha(alpha)
    local color = _G.Color.white
    color.a = alpha
    self.go_table.aorimage_Color.color = color
    self.go_table.aorrawimage_Icon.color = color
    self.go_table.aortext_Number.color = color
end

function BaseAwardItem:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        self:ShowItemTip(go, isOn)
    end
end
function BaseAwardItem:ShowItemTip(go, isOn)
    -- local data = {["cfg"] = self.cfg, ["sid"] = self.sid}
    --  data.viewNames = {_G.ConfigManager.ui_cfg.CommonAwardView.Name}
    if self.callBack then
        self.callBack(self)
    else
        require("CommonTipManager"):GetInstance():OpenTip(go, self.data.sid)
    end
end

return BaseAwardItem
