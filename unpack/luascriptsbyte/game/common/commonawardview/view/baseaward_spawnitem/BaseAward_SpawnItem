---@class BaseAward_SpawnData	中文描述
local BaseAward_SpawnData = _G.BaseClass("BaseAward_SpawnData")
---类的构造函数
function BaseAward_SpawnData:__init(type, data, parent, loadedCall, click)
    self:Show(type, data, parent, loadedCall, click)
end

function BaseAward_SpawnData:Show(type, data, parent, loadedCall, click)
    self.type = type
    self.data = data
    self.parent = parent
    if type == _G.StorageType.Card then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.parent,
            function(item)
                if _G.IsNil(self.data) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                if loadedCall then
                    loadedCall(item)
                end
            end
        )
    elseif type == _G.StorageType.Decoration then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemDecorationBase,
            self.parent,
            function(item)
                if _G.IsNil(self.data) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                if loadedCall then
                    loadedCall(item)
                end
            end
        )
    elseif type == _G.StorageType.Equipment then
        self.isStroage = true
        local _data = {self.data.element}
        _G.StorageManager:GetInstance():GetItemBaseView(
            self.data.sid,
            self.data.count,
            self.parent,
            function(item)
                if _G.IsNil(self.data) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                if loadedCall then
                    loadedCall(item)
                end
            end,
            click,
            _data,
            data.uid
        )
    elseif type == _G.StorageType.Gemstone then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemGemstoneBase,
            self.parent,
            function(item)
                if _G.IsNil(self.data) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                if loadedCall then
                    loadedCall(item)
                end
            end
        )
    else
        self.isStroage = true
        _G.StorageManager:GetInstance():GetItemBaseView(
            self.data.sid,
            self.data.count,
            self.parent,
            function(item)
                if _G.IsNil(self.data) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                if loadedCall then
                    loadedCall(item)
                end
            end,
            click
        )
    end
end

---类的析构函数
function BaseAward_SpawnData:Dispose()
    self.data = nil
end

return BaseAward_SpawnData
