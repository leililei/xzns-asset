---@class SpawnItem	中文描述
---@field childs SpawnItem[]
local SpawnItem = _G.BaseClass("SpawnItem")
---类的构造函数
function SpawnItem:__init(resPath, poolType, parent, callback)
    self.isSpawn = false
    self.childs = {}
    self:Spawn(resPath, poolType, parent, callback)
end
---生成物体
---@param resPath string 对象路径
---@param poolType ePoolType 对象池类型,参见ePoolType，默认Default
---@param parent Transform 加载物体后设置的父节点
---@param callback fun(obj:UnityEngine.Transform) 加载物体后的回调
---@param isDespawn boolean 是否回收
function SpawnItem:Spawn(resPath, poolType, parent, callback, isDespawn)
    if _G.string.IsNullOrEmpty(resPath) or self.isSpawn then
        return
    end
    self.call = callback
    self.poolType=poolType
    self.isDespawn = isDespawn
    self.isSpawn = true
    _G.PoolsManager:GetInstance():Spawn(resPath, poolType, parent, _G.handler(self, self.SpawnCall))
end

function SpawnItem:SpawnCall(trans, ...)
    if not self.isSpawn then
        if self.isDespawn then
            if self.isDespawn then
                _G.PoolsManager:GetInstance():Despawn(trans,self.poolType)
                return
            end
        end
        _G.DestroyObject(trans)
        return
    end
    self.item = trans
    if self.call then
        self.call(trans, ...)
    end
end

function SpawnItem:Dispose(isNotItem)
    self.call = nil
    self.isSpawn = nil
    if not isNotItem then
        self:DisposeItem(true)
    end
    if self.childs then
        for _, v in pairs(self.childs) do
            v:Dispose(true,isNotItem)
        end
    end
    self.childs = nil
end
---添加子物体
function SpawnItem:AddChilds(item)
    if not item then
        return
    end
    _G.table.insert(self.childs, item)
end
---移除物体
function SpawnItem:DisposeItem(isNotChild)
    self.isSpawn = nil
    if not _G.IsNil(self.item) then
        _G.DestroyObject(self.item)
        self.item = nil
    end
    if not isNotChild then
        if self.childs then
            for _, v in pairs(self.childs) do
                v:DisposeItem()
            end
        end
    end
end

return SpawnItem
