require "AttributeClass"

---@class AttributeClassManager : Singleton	中文描述
local AttributeClassManager = _G.BaseClass("AttributeClassManager", _G.Singleton)
_G.AttributeClassManager = AttributeClassManager

---@return AttributeClassManager AttributeClassManager
function AttributeClassManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function AttributeClassManager:__init()
    self:InitAttribute()
end

---销毁对象时,析构函数
function AttributeClassManager:Dispose()
end

--region 对外接口

--region 对象管理

---获取属性对象
---@return AttributeClass 属性实例对象
function AttributeClassManager:GetAttribtueClass(eType, pType)
    return _G.ObjectPool:GetInstance():Pop(_G.AttributeClass, eType, pType)
end

---放入属性对象
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function AttributeClassManager:PutAttribtueClass(ac)
    _G.ObjectPool:GetInstance():Push(ac)
end

---初始化属性
function AttributeClassManager:InitAttribute()
    ---@type type_attribute_cfg[]
    local cfgs = _G.ConfigManager.type_attribute_cfg
    self.attributeTypes = {}
    for _, v in pairs(cfgs) do
        self.attributeTypes[v.attribute_type] = v
    end
end

--endregion

--region 对象操作

---两个属性相加(该操作会改变属性对象a)
---@param a AttributeClass 原始属性a
---@param b AttributeClass 增加属性b
function AttributeClassManager:AddAttribute(a, b, isNotUpdatePower)
    a:Add(b, not isNotUpdatePower)
end

---两个属性相加(该操作会重新创建对象)
---@param a AttributeClass 原始属性a
---@param b AttributeClass 增加属性b
---@return AttributeClass 新对象
function AttributeClassManager:AddAttributeByNew(a, b, isNotUpdatePower)
    local ac = a:Clone()
    ac:Add(b, not isNotUpdatePower)
    return ac
end

---两个属性相减(该操作会改变属性对象a)
---@param a AttributeClass 原始属性a
---@param b AttributeClass 增加属性b
function AttributeClassManager:RemoveAttribute(a, b, isNotUpdatePower)
    a:Remove(b, not isNotUpdatePower)
end

---获取属性id
---@return type_attribute_cfg
function AttributeClassManager:GetAttaributeCfgWithName(name)
    return self.attributeTypes[name]
end

---获取数值
---@param name string 属性类型
---@param value number 改变的数值
---@param type number 属性的计算方式
function AttributeClassManager:GetValueWithName(name, value, type)
    value = _G.tonumber(value)
    type = _G.tonumber(type)
    local cfg = self:GetAttaributeCfgWithName(name)
    if cfg then
        if cfg.value_type == 1 then
            if type and type == 2 then
                value = value / 10000
            end
            return value
        elseif cfg.value_type == 2 then
            return value / 10000
        end
    end
    return value
end

---根据字段名称和传输类型来判断是否进行百分百显示
---@param name string 属性类型
---@param type number 属性的显示方式（
---@param num number 改变的数值
---@param prop number 百分比显示
---@param scale number 属性倍率
---@param floorBol boolean 百分比保留整数
---和服务端约定的属性规则，属性类型1表示加法运算，2表示乘法运算；其中四维属性1数值，
---2表示百分比 ；其他属性只有1，且表示百分比。可参考装备属性显示，刻魂属性显示等通用规则
function AttributeClassManager:GetShowProp(name, type, num, prop, scale, floorBol)
    num = _G.tonumber(num)
    type = _G.tonumber(type)
    if not scale then
        scale = 0.0001
    end
    --取表值 value_type 1类型为可改变值，2类型为只能百分比显示
    local cfg = self:GetAttaributeCfgWithName(name)
    if cfg then
        if cfg.value_type == 1 then
            if type and type == 2 then
                num = self:Percentage(num, prop, floorBol)
            else
                num = _G.Mathf.Floor(num * scale)
            end
        elseif cfg.value_type == 2 then
            num = self:Percentage(num, prop, floorBol)
        end
    end
    return num
end

---百分比显示
function AttributeClassManager:Percentage(num, prop, floorBol)
    if num % 1000000 ~= 0 and not floorBol then
        --保留一位小数
        num = _G.string.format("%.1f", num * prop)
    else
        num = _G.Mathf.Floor(num * prop)
    end
    return num .. "%"
end

---获取功能属性中有效的属性字段
---@param attr AttributeClass
function AttributeClassManager:GetChangeAttrTypes(attr)
    return attr
end

---获取功能属性中有效的属性字段
---@param attr AttributeClass
function AttributeClassManager:GetChangeAttrList(attr)
    local changeAttrTypes = {}
    if attr.attribute then
        for k, v in pairs(attr.attribute) do
            if v > 0 and not changeAttrTypes[k] then
                changeAttrTypes[k] = _G.AttrType[k]
            end
        end
    end
    if attr.attributePercent then
        for k, v in pairs(attr.attributePercent) do
            if v > 0 and not changeAttrTypes[k] then
                changeAttrTypes[k] = _G.AttrType[k]
            end
        end
    end
    if attr.attriOther then
        for k, v in pairs(attr.attriOther) do
            if v > 0 and not changeAttrTypes[k] then
                changeAttrTypes[k] = _G.AttrType[k]
            end
        end
    end
    return changeAttrTypes
end

---比较两条attribute_cfg, 计算属性增量，有技能变动则返回技能
---@param attrId1 number 高属性id
---@param attrId2 number 低属性id
---@return boolean, table|number 是否是技能变动，属性数组|技能id
function AttributeClassManager.CalAddedAttribute(attrId1, attrId2)
    ---@type attribute_cfg
    local cfg1 = _G.ConfigManager.attribute_cfg[attrId1]
    ---@type attribute_cfg
    local cfg2 = _G.ConfigManager.attribute_cfg[attrId2]
    if cfg1.skill > 0 and cfg1.skill ~= cfg2.skill then
        return true, cfg1.skill
    end
    local attrDic = {}
    for _, v in pairs(cfg1.attribute) do
        if attrDic[v[1]] == nil then
            attrDic[v[1]] = {}
        end
        if attrDic[v[1]][v[2]] == nil then
            attrDic[v[1]][v[2]] = _G.tonumber(v[3])
        else
            attrDic[v[1]][v[2]] = attrDic[v[1]][v[2]] + _G.tonumber(v[3])
        end
    end
    for _, v in pairs(cfg2.attribute) do
        if attrDic[v[1]] and attrDic[v[1]][v[2]] then
            attrDic[v[1]][v[2]] = attrDic[v[1]][v[2]] - _G.tonumber(v[3])
        end
    end
    local attribute = {}
    for key, v in pairs(attrDic) do
        for _type, num in pairs(v) do
            if num > 0 then
                _G.table.insert(attribute, { key, _type, _G.tostring(num) })
            end
        end
    end
    return false, attribute
end

---比较两条attribute_cfg, 计算属性增量，有技能变动则返回技能
---@param attrId1 number 高属性id
---@param attrId2 number 低属性id
---@return boolean, table|number 是否是技能变动，属性数组|技能id
function AttributeClassManager.CalAddedAttribute2(attrId1, attrId2)
    ---@type attribute_cfg
    local cfg1 = _G.ConfigManager.attribute_cfg[attrId1]
    ---@type attribute_cfg
    local cfg2 = _G.ConfigManager.attribute_cfg[attrId2]
    if cfg1.skill > 0 and cfg1.skill ~= cfg2.skill then
        return true, cfg1.skill
    end
    local attrDic = {}
    for _, v in pairs(cfg1.attribute) do
        if attrDic[v[1]] == nil then
            attrDic[v[1]] = {}
        end
        if attrDic[v[1]][v[2]] == nil then
            attrDic[v[1]][v[2]] = _G.tonumber(v[3])
        else
            attrDic[v[1]][v[2]] = attrDic[v[1]][v[2]] + _G.tonumber(v[3])
        end
    end
    for _, v in pairs(cfg2.attribute) do
        if attrDic[v[1]] and attrDic[v[1]][v[2]] then
            attrDic[v[1]][v[2]] = attrDic[v[1]][v[2]] - _G.tonumber(v[3])
        end
    end
    local attribute = {}
    --- 找出有变化的key
    for key, v in pairs(attrDic) do
        for _type, num in pairs(v) do
            if num > 0 then
                _G.table.insert(attribute, { key, _type, _G.tostring(num) })
            end
        end
    end

    for i = 1, #attribute do
        attribute[i].minAttr = 0
        for _, v in pairs(cfg1.attribute) do
            if v[1] == attribute[i][1] and v[2] == attribute[i][2] then
                attribute[i].maxAttr = v[3]
            end
        end
        for _, v in pairs(cfg2.attribute) do
            if v[1] == attribute[i][1] and v[2] == attribute[i][2] then
                attribute[i].minAttr = v[3]
            end
        end
    end


    return false, attribute
end

---属性加成文本
---@param attribute string[][]
function AttributeClassManager.GetAttrbuteDes(attribute)
    local str = ""
    local num, aType, numStr
    for i, v in pairs(attribute) do
        num = _G.tonumber(v[3])
        aType = v[2] == "1" and _G.AttCountType.other or _G.tonumber(v[2])
        num = _G.AttributeClassManager:GetInstance():GetValueWithName(v[1], num, aType)
        if _G.AttrType[v[1]].percentage == 1 or v[2] == "2" then
            num = _G.GameUtil.FormatNum(num * 100)
            numStr = _G.string.format("%s%%", num)
        else
            num = _G.GameUtil.NumberWY(_G.math.floor(num))
            numStr = _G.tostring(num)
        end
        if i > 1 then
            numStr = _G.string.format(" %s+%s", _G.AttrType[v[1]].des, numStr)
        else
            numStr = _G.string.format("%s+%s", _G.AttrType[v[1]].des, numStr)
        end
        str = str .. numStr
    end
    return str
end

