---计算装备战力 需要用到随机属性 评分
---@return number 战力值
function AttributeClass:CalculatePowerEquipment_2(scoreArr)
    ---装备评分=（攻击*a+破甲*c+防御*b+生命*d）*（1+装备百分比属性补偿系数（命中率+暴击率+闪避率+抗暴率+附加属性1评分/1000000+附加属性2评分/1000000+附加属性3评分/1000000+绑定参数/10000))
    --discrete[104908] 装备百分比属性补偿系数，绑定参数
    local propParams = _G.ConfigManager.discrete_cfg[104908][1]
    local atk = self:GetValueByName("atk") * GetParamsPowerByName("atk")
    local bre = self:GetValueByName("bre") * GetParamsPowerByName("bre")
    local def = self:GetValueByName("def") * GetParamsPowerByName("def")
    local max_hp = self:GetValueByName("max_hp") * GetParamsPowerByName("max_hp")

    local hit_rate = self:GetValueByName("hit_rate")
    local cri_rate = self:GetValueByName("cri_rate")
    local avd_rate = self:GetValueByName("avd_rate")
    local cri_r_rate = self:GetValueByName("cri_r_rate")

    ---（命中率+暴击率+闪避率+抗暴率
    local otehr = hit_rate + cri_rate + avd_rate + cri_r_rate
    if scoreArr ~= nil then
        for i = 1, #scoreArr do
            otehr = otehr + scoreArr[i] * 0.000001
        end
    end
    otehr = otehr + _G.tonumber(propParams[2]) / 10000
    local v = (atk + bre + def + max_hp) * (1 + _G.tonumber(propParams[1]) * otehr)
    -- (
    --     string.format(
    --         "（%s+%s+%s+%s）*（1+20*（%s+%s+%s+%s+%s/1000000+%s/1000000))=%s",
    --         tostring(atk),
    --         tostring(bre),
    --         tostring(def),
    --         tostring(max_hp),
    --         tostring(hit_rate),
    --         tostring(cri_rate),
    --         tostring(avd_rate),
    --         tostring(cri_r_rate),
    --         tostring(scoreArr and scoreArr[1] or 0),
    --         tostring(scoreArr and scoreArr[2] or 0),
    --         tostring(v)
    --     )
    -- )
    return v
end

---计算神器战力
---@return number 战力值
function AttributeClass:CalculateArtifactPower()
    ---神器评分=（攻击*a+破甲*c+防御*b+生命*d）*（1+神器百分比属性补偿系数*（命中率+暴击率+闪避率+抗暴率+暴击伤害*e+暴伤减免*e+伤害增加+物伤减免*50%+法伤减免*50%+急速+PVP伤害增加*f+PVP伤害减免*f+治愈*g+受愈*g+韧性*h)）
    local atk = self:GetValueByName("atk") * GetParamsPowerByName("atk")
    local bre = self:GetValueByName("bre") * GetParamsPowerByName("bre")
    local def = self:GetValueByName("def") * GetParamsPowerByName("def")
    local max_hp = self:GetValueByName("max_hp") * GetParamsPowerByName("max_hp")

    local atk_rate = self:GetValueByName("atk", _G.AttCountType.basePercent)
    local bre_rate = self:GetValueByName("bre", _G.AttCountType.basePercent)
    local def_rate = self:GetValueByName("def", _G.AttCountType.basePercent)
    local max_hp_rate = self:GetValueByName("max_hp", _G.AttCountType.basePercent)
    local hit_rate = self:GetValueByName("hit_rate")
    local cri_rate = self:GetValueByName("cri_rate")
    local avd_rate = self:GetValueByName("avd_rate")
    local cri_r_rate = self:GetValueByName("cri_r_rate")
    local cri_dmg = self:GetValueByName("cri_dmg") * GetParamsPowerByName("cri_dmg")
    local cri_dmg_r = self:GetValueByName("cri_dmg_r") * GetParamsPowerByName("cri_dmg_r")
    local dmg_inc = self:GetValueByName("dmg_inc")
    local psy_d_r = self:GetValueByName("psy_d_r") * 0.5
    local mag_d_r = self:GetValueByName("mag_d_r") * 0.5
    local all_speed = self:GetValueByName("all_speed")
    local pvp_dmg = self:GetValueByName("pvp_dmg") * GetParamsPowerByName("pvp_dmg")
    local pvp_dmg_r = self:GetValueByName("pvp_dmg_r") * GetParamsPowerByName("pvp_dmg_r")
    local recover_rate = self:GetValueByName("recover_rate") * GetParamsPowerByName("recover_rate")
    local recover_suffer = self:GetValueByName("recover_suffer") * GetParamsPowerByName("recover_suffer")
    local control_dec = self:GetValueByName("control_dec") * GetParamsPowerByName("control_dec")

    local coef = _G.ConfigManager.discrete_cfg[101206][1][1]
    local v = (atk + bre + def + max_hp) * (1 + coef * (atk_rate + bre_rate + def_rate + max_hp_rate + hit_rate + cri_rate + avd_rate + cri_r_rate + cri_dmg + cri_dmg_r + dmg_inc + psy_d_r + mag_d_r + all_speed + pvp_dmg + pvp_dmg_r + recover_rate + recover_suffer + control_dec))
    self.power = _G.Mathf.RoundToInt(v)
    return self.power
end

---IRecycle出池构造函数
function AttributeClass:OnInit(eType, pType)
    ---基础属性值  _G.AttCountType.base （卡牌升级升星属性+共鸣神石属性+装备基础属性+装备强化属性）
    self.attribute = {}
    ---百分比 _G.AttCountType.basePercent
    ---基础属性百分比  (52% 存值0.52)
    self.attributePercent = {}
    ---各处数值 _G.AttCountType.other
    self.attriOther = {}
    self.power = 0
    self.elementsType = eType or 1
    self.powerType = pType or _G.PowerType.card
end

---IRecycle进池析构函数
function AttributeClass:OnDispose()
    --属性计算 （基础属性数值）*（1+∑基础属性数值百分比）+∑各处数值
    --       （∑base）*（1+∑basePercent）+∑other

    --- 基础属性 （卡牌升级升星属性+共鸣神石属性+装备基础属性+装备强化属性）
    self.attribute = nil
    --- 基础属性百分比
    self.attributePercent = nil
    --- 其他固定数值  (装备随机属性 …… )
    self.attriOther = nil
    self.power = 0
end

--region 对外接口

---根据类型获取属性表
---@param countType AttCountType 属性类型
---@return table 属性
function AttributeClass:GetAttrByName(AttCountType)
    if AttCountType == _G.AttCountType.basePercent then
        if self.attributePercent == nil then
            self.attributePercent = {}
        end
        return self.attributePercent
    elseif AttCountType == _G.AttCountType.other then
        if self.attriOther == nil then
            self.attriOther = {}
        end
        return self.attriOther
    else --默认  _G.AttCountType.base
        if self.attribute == nil then
            self.attribute = {}
        end
        return self.attribute
    end
end

---根据名称获取属性值
---@param name string 属性名字(type_attribute_cfg中attribute_type值)
---@param countType AttCountType 属性类型
---@return number 属性值
function AttributeClass:GetValueByName(name, AttCountType)
    local attr = self:GetAttrByName(AttCountType)
    -- if _G.table.isEmptyOrNil(attr) then
    --     return 0
    -- end
    if not next(attr) then
        return 0
    end

    if nil == name then
        return 0
    end
    if nil == attr[name] then
        return 0
    end
    return attr[name]
end

---Equipment 根据名称获取 战斗力计算 属性值
---@param name string 属性名字(type_attribute_cfg中attribute_type值)
---@return number 属性值
function AttributeClass:GetValuePowerEquipmentByName(name)
    -- 装备战斗力计算   单个属性数值=   base+other
    return self:GetValueByName(name, _G.AttCountType.base) + self:GetValueByName(name, _G.AttCountType.other)
end

---根据id获取属性值
---@param id number 属性ID(type_attribute_cfg中id值)
---@param countType AttCountType 属性类型
---@return number 属性值
function AttributeClass:GetValueByID(id, AttCountType)
    if attrCfg[id] == nil then
        return 0
    end
    local key = attrCfg[id].attribute_type
    return self:GetValueByName(key, AttCountType)
end

---通过名称设置属性值
---@param name string 属性名字(type_attribute_cfg中attribute_type值)
---@param value number 属性值
---@param updatePower boolean 刷新战力(默认不刷新,在设置完所有值之后调用一次战力计算接口)
---@param countType AttCountType 属性类型
function AttributeClass:SetValueByName(name, value, updatePower, AttCountType)
    local attr = self:GetAttrByName(AttCountType)
    attr[name] = value
    if updatePower then
        self:CalculatePower()
    end
end

---通过id设置属性值
---@param id number 属性ID(type_attribute_cfg中id值)
---@param value number 属性值
---@param updatePower boolean 刷新战力
---@param countType AttCountType 属性类型
function AttributeClass:SetValueByID(id, value, updatePower, AttCountType)
    if attrCfg[id] == nil then
        return 0
    end
    local key = attrCfg[id].attribute_type
    self:SetValueByName(key, value, updatePower, AttCountType)
end

---通过名称Add属性值
---@param name string 属性名字(type_attribute_cfg中attribute_type值)
---@param value number 属性值
---@param updatePower boolean 刷新战力(默认不刷新,在设置完所有值之后调用一次战力计算接口)
---@param countType AttCountType 属性类型
function AttributeClass:AddValueByName(name, value, updatePower, AttCountType)
    local attr = self:GetAttrByName(AttCountType)
    attr[name] = self:GetValueByName(name, AttCountType) + value
    if updatePower then
        self:CalculatePower()
    end
end

---通过idAdd属性值
---@param id number 属性ID(type_attribute_cfg中id值)
---@param value number 属性值
---@param updatePower boolean 刷新战力
---@param countType AttCountType 属性类型
function AttributeClass:AddValueByID(id, value, updatePower, AttCountType)
    local key = attrCfg[id].attribute_type
    self:AddValueByName(key, value, updatePower, AttCountType)
end

---获取战力值
---@return number 战力
function AttributeClass:GetPower()
    return self.power
end

---计算战力
---@return number 战力
function AttributeClass:CalculatePower()
    if self.powerType == _G.PowerType.card then
        self.power = CalculatePowerAttack(self) + CalculatePowerDefence(self)
    elseif self.powerType == _G.PowerType.equipment then
        self.power = CalculatePowerEquipment(self)
    end
    self.power = _G.Mathf.RoundToInt(self.power)
    return self.power
end

---计算装备战力 需要用到随机属性 评分
---@return number 战力
function AttributeClass:CalculateEquipmentPower(scoreArr)
    self.power = self:CalculatePowerEquipment_2(scoreArr)
    self.power = _G.Mathf.RoundToInt(self.power)
    return self.power
end

---对象相加 改变自己的值
---@param b AttributeClass 属性对象
---@param updatePower boolean 刷新战力
function AttributeClass:Add(b, updatePower)
    for key, value in pairs(b.attribute) do
        self.attribute[key] = (self.attribute[key] or 0) + value
    end
    for key, value in pairs(b.attributePercent) do
        self.attributePercent[key] = (self.attributePercent[key] or 0) + value
    end

    for key, value in pairs(b.attriOther) do
        self.attriOther[key] = (self.attriOther[key] or 0) + value
    end

    if updatePower then
        self:CalculatePower()
    end
end

---对象相加 改变自己的值
---@param b AttributeClass 属性对象
---@param updatePower boolean 刷新战力
function AttributeClass:Remove(b, updatePower)
    for key, value in pairs(b.attribute) do
        self.attribute[key] = (self.attribute[key] or 0) - value
    end
    for key, value in pairs(b.attributePercent) do
        self.attributePercent[key] = (self.attributePercent[key] or 0) - value
    end

    for key, value in pairs(b.attriOther) do
        self.attriOther[key] = (self.attriOther[key] or 0) - value
    end

    if updatePower then
        self:CalculatePower()
    end
end

---基础属性 乘倍数  (装备 同五行 增加30%加成)
---@param num num 刷新战力
function AttributeClass:AddBaseMultiply(num)
    for key, value in pairs(self.attribute) do
        if value > 0 then
            self.attribute[key] = _G.GameUtil.FormatNum(value * num)
        end
    end
end

---将（基础属性数值） 转成 其他地方数值
---即最终属性=（基础属性数值）*（1+∑属性百分比）+∑其他地方数值
---卡牌计算装备属性  装备固定数值 为∑其他地方数值
function AttributeClass:AttributeToOther()
    self.attriOther = self.attribute
    self.attribute = {}
end

---根据属性表id增加属性
---@param id number 属性表id
function AttributeClass:AddValueByAttributeCfgID(id, updatePower)
    local attributeInfo = _G.ConfigManager.attribute_cfg[id]
    if attributeInfo then
        updatePower = updatePower or false
        local tmp
        tmp = attributeInfo.attribute[1][3]
        if _G.AttrType[attributeInfo.attribute].proptype == 1 then
            if attributeInfo.attribute_type == 1 then
                self:AddValueByName(attributeInfo.attribute[1][1], tmp, updatePower, _G.AttCountType.other)
            else
                tmp = tmp * 0.0001
                self:AddValueByName(attributeInfo.attribute[1][1], tmp, updatePower, _G.AttCountType.basePercent)
            end
        else
            tmp = tmp * 0.0001
            self:AddValueByName(attributeInfo.attribute[1][1], tmp, updatePower, _G.AttCountType.basePercent)
        end
    end
end

---根据属性表id组增加属性
---@param id ta 属性表id组
function AttributeClass:AddValueByAttributeCfgIDs(ids, updatePower)
    for i = 1, #ids do
        self:AddValueByAttributeCfgID(ids[i])
    end
    if updatePower then
        self:CalculatePower()
    end
end

---获取 全属性最终值
---@param name string 属性名字(type_attribute_cfg中attribute_type值)
function AttributeClass:CalculateAttrAll()
    local sumAttr = {}

    for key, _ in pairs(_G.AttrType) do
        sumAttr[key] = self:CalculateAttr_1(key)
    end
    return sumAttr
end

---获取单属性最终值  计算方式1
function AttributeClass:CalculateAttr_1(name)
    local t_attribute = self:GetValueByName(name, _G.AttCountType.base)
    local t_attributePercent = self:GetValueByName(name, _G.AttCountType.basePercent)
    local t_attriOther = self:GetValueByName(name, _G.AttCountType.other)

    local value

    if _G.AttrType[name].proptype == 3 then
        value = t_attribute + t_attributePercent + t_attriOther
    else
        value = t_attribute * (1 + t_attributePercent) + t_attriOther
        ---四舍五入
        value = _G.string.format("%.1f", value)
    end

    return value
end

---拷贝
---@return AttributeClass 新实例
function AttributeClass:Clone()
    local ac = AttributeClass.New()
    ac.attribute = _G.DeepCopy(self.attribute)
    ac.attributePercent = _G.DeepCopy(self.attributePercent)
    ac.attriOther = _G.DeepCopy(self.attriOther)
    ac.power = self.power
    ac.elementsType = self.elementsType
    ac.powerType = self.powerType
    return ac
end

---获取当前属性
function AttributeClass:GetAllAttr()
    return _G.DeepCopy(self.attribute)
end

function AttributeClass:toString()
    local str = ""
    str = str .. " attribute :\n"
    for key, value in pairs(self.attribute) do
        str = str .. key .. " " .. value .. "\n"
    end

    str = str .. " attributePercent :\n"
    for key, value in pairs(self.attributePercent) do
        str = str .. key .. " " .. value .. "\n"
    end

    str = str .. " attriOther :\n"
    for key, value in pairs(self.attriOther) do
        str = str .. key .. " " .. value .. "\n"
    end
    return str
end
