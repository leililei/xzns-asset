local DmgAttackType = {
    --（1-雷；2-风；3-水；4-火；5-土）
    "thd_dmg",
    "air_dmg",
    "water_dmg",
    "fire_dmg",
    "earth_dmg"
}
local DmgDefenceType = {
    --（1-雷；2-风；3-水；4-火；5-土）
    "thd_d_r",
    "air_d_r",
    "water_d_r",
    "fire_d_r",
    "earth_d_r"
}

local attrCfg = _G.ConfigManager.type_attribute_cfg

---通过名字获取战力计算公式
local function GetParamsPowerByName(name)
    local xs = 1
    local aty = _G.AttrType[name]
    if aty then
        if attrCfg[aty.ID] then
            local params_power = attrCfg[aty.ID].params_power
            if params_power ~= 0 then
                xs = params_power * 0.0001
            end
        end
    end
    return xs
end

-- ---获取当前卡牌属性*系数
local function GetValueParamsPowerByName(ac, name)
    return ac:GetValueByName(name) * GetParamsPowerByName(name)
end

---通过五行 获取 五行默认克制(兵种克制不在卡牌属性中) 增减伤
local function GetElementsAttByName(elements)
    return _G.ConfigManager.elements_att_cfg[elements]
end

---计算攻击属性战斗力
---@param ac AttributeClass 属性实例对象
---@return number 战斗力
local function CalculatePowerAttack(ac)
    --（（攻击*a+破甲*c）*（命中率+暴击率)*（1+暴击伤害*e）*（1+伤害增加）*（1+or(雷伤增加，风伤增加，水伤增加，火伤增加，土伤增加））攻击属性战斗力=（攻击*a+破甲*c）*（命中率+暴击率)*（1+暴击伤害*e）*（1+伤害增加）*（1+or(雷伤增加，风伤增加，水伤增加，火伤增加，土伤增加））*（1+急速）*（1+f*PVP伤害增加+g*治愈）

    local atk = GetValueParamsPowerByName(ac, _G.AttrType.atk.key)
    local bre = GetValueParamsPowerByName(ac, _G.AttrType.bre.key)

    local hit_rate = GetValueParamsPowerByName(ac, _G.AttrType.hit_rate.key)
    local cri_rate = GetValueParamsPowerByName(ac, _G.AttrType.cri_rate.key)

    local cri_dmg = GetValueParamsPowerByName(ac, _G.AttrType.cri_dmg.key)

    local dmg = GetValueParamsPowerByName(ac, _G.AttrType.dmg_inc.key)

    local all_speed = GetValueParamsPowerByName(ac, _G.AttrType.all_speed.key)
    local pvp_dmg = GetValueParamsPowerByName(ac, _G.AttrType.pvp_dmg.key)
    local recover_rate = GetValueParamsPowerByName(ac, _G.AttrType.recover_rate.key)

    local elements_atk = 0
    local elements_att_cfg = GetElementsAttByName(ac.elementsType)
    if elements_att_cfg ~= nil then
        local DmgAttack = DmgAttackType[ac.elementsType]
        if DmgAttack ~= nil then
            elements_atk = elements_att_cfg[DmgAttack]
        end
    end

    local sum =
        (atk + bre) * (hit_rate + cri_rate) * (1 + cri_dmg) * (1 + dmg) * (1 + elements_atk) * (1 + all_speed) *
        (1 + pvp_dmg + recover_rate)
    -- (
    --     string.format(
    --         "(%s + %s) * ( %s + %s) * (1 + %s) * (1 + %s) * (1 + %s) = %s",
    --         tostring(atk),
    --         tostring(bre),
    --         tostring(hit_rate),
    --         tostring(cri_rate),
    --         tostring(cri_dmg),
    --         tostring(dmg),
    --         tostring(elements_atk),
    --         tostring(sum)
    --     )
    -- )
    return sum
end

---计算防御属性战斗力
---@param ac AttributeClass 属性实例对象
---@return number 战斗力
local function CalculatePowerDefence(ac)
    --（生命*b+防御*d）*（1+闪避率+抗暴率）*（1+暴伤减免*e）*（1+物伤减免*50%+法伤减免*50%）*（1+（雷伤减免+风伤减免+水伤减免+火伤减免+土伤减免）/5）*（1+急速）*（1+f*PVP伤害减免f+g*受愈+h*韧性）

    local max_hp = GetValueParamsPowerByName(ac, _G.AttrType.max_hp.key)
    local def = GetValueParamsPowerByName(ac, _G.AttrType.def.key)

    local avd_rate = GetValueParamsPowerByName(ac, _G.AttrType.avd_rate.key)
    local cri_r_rate = GetValueParamsPowerByName(ac, _G.AttrType.cri_r_rate.key)

    local cri_dmg_r = GetValueParamsPowerByName(ac, _G.AttrType.cri_dmg_r.key)

    local psy_d_r = GetValueParamsPowerByName(ac, _G.AttrType.psy_d_r.key)
    local mag_d_r = GetValueParamsPowerByName(ac, _G.AttrType.mag_d_r.key)

    local thd_d_r = GetValueParamsPowerByName(ac, _G.AttrType.thd_d_r.key)
    local air_d_r = GetValueParamsPowerByName(ac, _G.AttrType.air_d_r.key)
    local water_d_r = GetValueParamsPowerByName(ac, _G.AttrType.water_d_r.key)
    local fire_d_r = GetValueParamsPowerByName(ac, _G.AttrType.fire_d_r.key)
    local earth_d_r = GetValueParamsPowerByName(ac, _G.AttrType.earth_d_r.key)

    local all_speed = GetValueParamsPowerByName(ac, _G.AttrType.all_speed.key)
    local pvp_dmg_r = GetValueParamsPowerByName(ac, _G.AttrType.pvp_dmg_r.key)
    local recover_suffer = GetValueParamsPowerByName(ac, _G.AttrType.recover_suffer.key)
    local control_dec = GetValueParamsPowerByName(ac, _G.AttrType.control_dec.key)

    local elements = GetElementsAttByName(ac.elementsType)
    if elements ~= nil then
        thd_d_r = thd_d_r + elements.thd_d_r * 0.0001
        air_d_r = air_d_r + elements.air_d_r * 0.0001
        water_d_r = water_d_r + elements.water_d_r * 0.0001
        fire_d_r = fire_d_r + elements.fire_d_r * 0.0001
        earth_d_r = earth_d_r + elements.earth_d_r * 0.0001
    end
    --1896.45   855.75  0.15    0.0 0.0 0.0 0.0
    --2752.2  *  1.15  *1*1*1
    --3165.03

    ---1896+855   *   1.15
    ---3162
    ---max_hp   1896.45
    ---def   855.75
    ---avd_rate   0.15

    local sum =
        (max_hp + def) * (1 + avd_rate + cri_r_rate) * (1 + cri_dmg_r) * (1 + psy_d_r * 0.5 + mag_d_r * 0.5) *
        (1 + (thd_d_r + air_d_r + water_d_r + fire_d_r + earth_d_r) * 0.2) *
        (1 + all_speed) *
        (1 + pvp_dmg_r + recover_suffer + control_dec)

    -- (
    --     string.format(
    --         " (%s + %s) * (1 + %s + %s) * (1 + %s) * (1 + %s * 0.5 + %s * 0.5) * (1 + (%s + %s + %s + %s + %s) * 0.2)=%s",
    --         tostring(max_hp),
    --         tostring(def),
    --         tostring(avd_rate),
    --         tostring(cri_r_rate),
    --         tostring(cri_dmg_r),
    --         tostring(psy_d_r),
    --         tostring(mag_d_r),
    --         tostring(thd_d_r),
    --         tostring(air_d_r),
    --         tostring(water_d_r),
    --         tostring(fire_d_r),
    --         tostring(earth_d_r),
    --         tostring(sum)
    --     )
    -- )

    return sum
end

---计算装备战力
---@param ac AttributeClass 中文描述
---@return number 战力值
local function CalculatePowerEquipment(ac)
    ---（攻击*a+破甲*c+防御*b+生命*d）*（1+20*（命中率+暴击率+闪避率+抗暴率））

    local atk = ac:GetValueByName("atk") * GetParamsPowerByName("atk")
    local bre = ac:GetValueByName("bre") * GetParamsPowerByName("bre")
    local def = ac:GetValueByName("def") * GetParamsPowerByName("def")
    local max_hp = ac:GetValueByName("max_hp") * GetParamsPowerByName("max_hp")

    local hit_rate = ac:GetValueByName("hit_rate")
    local cri_rate = ac:GetValueByName("cri_rate")
    local avd_rate = ac:GetValueByName("avd_rate")
    local cri_r_rate = ac:GetValueByName("cri_r_rate")

    local v = (atk + bre + def + max_hp) * (1 + 20 * (hit_rate + cri_rate + avd_rate + cri_r_rate))
    return v
end

