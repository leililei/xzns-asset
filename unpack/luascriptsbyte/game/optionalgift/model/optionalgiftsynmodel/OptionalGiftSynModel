local base = require("ActivitySynTypeBase")
---@class OptionalGiftSynModel : ActivitySynTypeBase	中文描述
---@field ActivitySynManager ActivitySynManager
---@field curActivityClass ActivitySynBase
---@field model OptionalGiftModel
local OptionalGiftSynModel = _G.BaseClass("OptionalGiftSynModel",base)
local ActivitySynManager = require("ActivitySynManager")
---类的构造函数
function OptionalGiftSynModel:__init()
    self.model = require("OptionalGiftModel"):GetInstance()
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
end

function OptionalGiftSynModel:GetDataFormServer()
    base.ParseData(self)
end

function OptionalGiftSynModel:OnHandleGMData()
    self.model:GetInfoCall(self.curActivityClass)
    base.ParseData(self)
end

function OptionalGiftSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end
function OptionalGiftSynModel:CheckRedPointNumChild(index,param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self,param)
    end
    return 0
end
function OptionalGiftSynModel:CheckRedPoint()
    return self.model:ToDayIsFristEnter()
end

---进入活动主体
function OptionalGiftSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.OptionalGiftView.Name,self.curActivityClass)
end
function OptionalGiftSynModel:OnActivityStateChanged(_, state)
    if state == ActivitySynManager:GetInstance().State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.OptionalGiftView.Name)
        if view then
            view:Close()
        end
        --活动已关闭
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

return OptionalGiftSynModel