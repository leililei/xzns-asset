local base = require("BaseGameNet")

---@class OptionalGiftNet : BaseGameNet	通信协议
local OptionalGiftNet = _G.BaseClass("OptionalGiftNet", base)
---@return OptionalGiftNet OptionalGiftNet
function OptionalGiftNet:GetInstance()
    return base.GetInstance(self)
end

---请求保存数据
---@param pbData table PB数据
---@param callback function 完成回调
function OptionalGiftNet:AccessSave(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_optional_gift_port_set_choose_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function OptionalGiftNet:CallInfo(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return OptionalGiftNet