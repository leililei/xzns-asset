---@class OptionalGiftView : UIBaseView
---@field go_table OptionalGiftView_GoTable
local OptionalGiftView = _G.BaseClass("OptionalGiftView", _G.UIBaseView)

function OptionalGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function OptionalGiftView:OnCreate(activity)
    self.active = activity
    ---@type OptionalGiftModel
    self.model = self.active.typeClass.model
    if self.model:ToDayIsFristEnter()==1 then
        _G.PlayerPrefsManager.SetString("OptionalGiftDay",tostring(_G.TimeUtil.GetServerUnixTime()))
        require("RedPointManager"):GetInstance():RefreshNode(self.active.typeClass:GetRedpointIDByIndex(1))
    end
    self:InitToggle()
    local precast= _G.string.split(self.active.cfg.info.front.precast, ";")
    local pos=_G.string.split(precast[3], "#")
    local scale=_G.string.split(precast[4], "#")
    local language=_G.string.split(precast[5],"#")
    self.go_table.aortext_name.text=_G.GetLangPackValue(tonumber(language[1]))
    if tonumber(precast[1])==1 then
        self.go_table.aorrawimage_role:LoadImage(precast[2],function(img)
            if img then
                img:SetNativeSize()
            end
        end)
        self.go_table.aorrawimage_role:SetAnchorPosition(tonumber(pos[1]), tonumber(pos[2]))
        self.go_table.aorrawimage_role:SetLocalScale(tonumber(scale[1]),tonumber(scale[2]),tonumber(scale[3]))
    elseif tonumber(precast[1])==0 then
        _G.PoolsManager:GetInstance():Spawn(
                precast[2],
                _G.ePoolType.Temporary,
                self.go_table.obj_role
        )
        self.go_table.obj_role:SetAnchorPosition(tonumber(pos[1]), tonumber(pos[2]))
        self.go_table.obj_role:SetLocalScale(tonumber(scale[1]),tonumber(scale[2]),tonumber(scale[3]))
    end
    self:InitView()
    self:UpdateTime()
end
function OptionalGiftView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
end

---更新赛季事件
function OptionalGiftView:UpdateTime()
    self.countDown = self.model.active_EndTime - _G.TimeUtil.GetServerUnixTime()
    self:RefreshTime(0)
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshTime, self, false, false, true)
        self.timer:Start()
    end
end

function OptionalGiftView:RefreshTime(elapsed)
    self.countDown = self.countDown - elapsed
    local str = Mathf.RoundToInt(self.countDown)
    if self.countDown <= 0 then
        str = _G.LangUtil.TryGetLangValue(90023800055)
        self.go_table.aortext_time.text = str
    else
        str = _G.TimeUtil.TransDayHourMineMiao(math.ceil(self.countDown))
        self.go_table.aortext_time.text =GetLangPackValue(90022900045,str)
    end
end

function OptionalGiftView:InitToggle()
    self.toggles = {}
    if table.count(self.model.gifts)>1 then
        self.go_table.obj_bottom:SetActiveE(1)
        for k,v in pairs(self.model.gifts) do
            local obj=_G.InstantiateObject(self.go_table.toggle_item,self.go_table.obj_toggleGroup)
            self.toggles[k] =
            _G.GetAutoGoTable(
                    obj,
                    _G.handlerbind(self, self.OnClickToggle, k)
            )
            local GiftroleInfo=self.model:GetRoleInfoBySid(k)
            self.toggles[k].aorrawimage_type:SetActiveE(self.model:CheckGiftIsShowType(k) and 1 or 0)
            if v.buy_type>0 then
                self.toggles[k].aorrawimage_icon_off:SetActiveE(1)
                self.toggles[k].aorrawimage_icon_on:SetActiveE(1)
                local data=_G.StorageManager:GetInstance():GetItemDataClass(v.buy_type)
                if data and data.cfg then
                    self.toggles[k].aorrawimage_icon_on:LoadImage(data.cfg.icon)
                    self.toggles[k].aorrawimage_icon_off:LoadImage(data.cfg.icon)
                end
                if GiftroleInfo and  v.count==GiftroleInfo.count then
                    self.toggles[k].aortext_price_off.text=_G.string.AddColor(
                            _G.GetLangPackValue(90023030201), "434343")
                    self.toggles[k].aortext_price_on.text=_G.string.AddColor(
                            _G.GetLangPackValue(90023030201), "434343")
                    self.toggles[k].aorrawimage_icon_off:SetActiveE(0)
                    self.toggles[k].aorrawimage_icon_on:SetActiveE(0)
                    self.toggles[k].aorimage_isOff:SetGray(true)
                    self.toggles[k].aorimage_isOn:SetGray(true)
                else
                    self.toggles[k].aortext_price_off.text=tostring(v.price)
                    self.toggles[k].aortext_price_on.text=tostring(v.price)
                    self.toggles[k].aorrawimage_icon_off:SetActiveE(1)
                    self.toggles[k].aorrawimage_icon_on:SetActiveE(1)
                end
            else
                self.toggles[k].aorrawimage_icon_off:SetActiveE(0)
                self.toggles[k].aorrawimage_icon_on:SetActiveE(0)
                if GiftroleInfo and  v.count==GiftroleInfo.count then
                    self.toggles[k].aortext_price_off.text=_G.string.AddColor(
                            _G.GetLangPackValue(90023030201), "434343")
                    self.toggles[k].aortext_price_on.text=_G.string.AddColor(
                            _G.GetLangPackValue(90023030201), "434343")
                    self.toggles[k].aorimage_isOff:SetGray(true)
                    self.toggles[k].aorimage_isOn:SetGray(true)
                else
                    _G.GameUtil.SetPriceByChannel(v.price, self.toggles[k].aortext_price_off)
                    _G.GameUtil.SetPriceByChannel(v.price, self.toggles[k].aortext_price_on)
                end
            end
            _G.GameUtil.ReBuildRTF(self.toggles[k].obj_priceContent1)
            _G.GameUtil.ReBuildRTF(self.toggles[k].obj_priceContent2)
        end
        if not self.curGift then
            self.curGift=self.model:GetNowShowGift()
        end
        for k,v in pairs(self.toggles) do
            v.toggle_item.isOn = false
            if k==self.curGift.sid then
            v.toggle_item.isOn = true
            end
        end
    else
        self.go_table.obj_bottom:SetActiveE(0)
        self.curGift=self.model.data.gifts[1]
    end
end
function OptionalGiftView:OnClickToggle(go,isOn,key,Callback)
    for k,v in pairs(self.toggles) do
        v.aorimage_isOff:SetActiveE(k==key and 0 or 1)
        v.aorimage_isOn:SetActiveE(k==key and 1 or 0)
    end
    if self.curGift.sid~=key and isOn then
        self.curGift=self.model:GetOneGift(key)
        self:InitView()
    end
end

function OptionalGiftView:InitView()
    self:RefreshGiftShow()
    self:UpdateView()
end
function OptionalGiftView:RefreshGiftShow()
    self.go_table.aorrawimage_bk1:SetActiveE(self.curGift.buy_type>0 and 1 or 0)
    self.go_table.aorrawimage_bk2:SetActiveE(self.curGift.buy_type>0 and 0 or 1)
    self.go_table.aortext_value:SetActiveE(self.curGift.buy_type>0 and 0 or 1)
    self.go_table.aortext_value.text=self.curGift.value//100 .."%"
    local GiftroleInfo=self.model:GetRoleInfoBySid(self.curGift.sid)
    self.go_table.aorbtn_Buy:SetActiveE((not GiftroleInfo or GiftroleInfo.count<self.curGift.count) and 1 or 0)
    self.go_table.obj_sellout:SetActiveE((not GiftroleInfo or GiftroleInfo.count<self.curGift.count) and 0 or 1)
    if self.curGift.buy_type>0 then
        self.go_table.aorrawimage_icon:SetActiveE(1)
        local data=_G.StorageManager:GetInstance():GetItemDataClass(self.curGift.buy_type)
        if data and data.cfg then
            self.go_table.aorrawimage_icon:LoadImage(data.cfg.icon)
        end
        self.go_table.aortext_price.text=tostring(self.curGift.price)
    else
        self.go_table.aorrawimage_icon:SetActiveE(0)
        _G.GameUtil.SetPriceByChannel(self.curGift.price, self.go_table.aortext_price)
        _G.GameUtil.SetPriceByChannel(self.curGift.price, self.go_table.aortext_price)
    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_priceContent)
end
function OptionalGiftView:UpdateView()
    self.go_table.obj_Content:ClearChildren()
    self.go_table.obj_ChooseAward:ClearChildren()
    self.awardcount=table.count(self.curGift.base_award)+self.curGift.choose_count
    self.curAward= {}
    for i = 1, self.awardcount do
        local obj=nil
        if i<=self.curGift.choose_count then
            obj=_G.InstantiateObject(self.go_table.obj_item,self.go_table.obj_ChooseAward)
        else
            obj=_G.InstantiateObject(self.go_table.obj_item,self.go_table.obj_Content)
        end
        self:InitAwardItem(obj,i)
    end
end
function OptionalGiftView:InitAwardItem(obj,index)
    local award=nil
    local GiftroleInfo=self.model:GetRoleInfoBySid(self.curGift.sid)
    if index>self.curGift.choose_count then
        award=self.curGift.base_award[index-self.curGift.choose_count].type
    else
        if GiftroleInfo and not table.isEmptyOrNil(GiftroleInfo.choose_index) then
            award=self.curGift.choose_pool[1].award[GiftroleInfo.choose_index[index]].type
        end
    end
    self.curAward[index]=award
    local tb=_G.GetAutoGoTable(obj,_G.handlerbind(self,self.OnClickAwardItem,index))
    tb.aorbtn_choose:SetActiveE(index>self.curGift.choose_count and 0 or 1)
    tb.aorimage_choose1:SetActiveE(award and 0 or 1)
    tb.aorimage_choose2:SetActiveE((award and GiftroleInfo and GiftroleInfo.count < self.curGift.count) and 1 or 0)
    tb.aorimage_choose3:SetActiveE((GiftroleInfo and GiftroleInfo.count == self.curGift.count) and 1 or 0)
    if award then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                award,
                tb.obj_itemRoot,
                function(item)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
        )
    end
end
function OptionalGiftView:BuyBackUpData()
    local GiftroleInfo=self.model:GetRoleInfoBySid(self.curGift.sid)
    self.go_table.aorbtn_Buy:SetActiveE((not GiftroleInfo or GiftroleInfo.count<self.curGift.count) and 1 or 0)
    self.go_table.obj_sellout:SetActiveE((not GiftroleInfo or GiftroleInfo.count<self.curGift.count) and 0 or 1)
    for k,v in pairs(self.model.gifts) do
        local toggle=self.toggles[k]
        local GiftInfo=self.model:GetRoleInfoBySid(k)
        if GiftInfo and GiftInfo.count==v.count then
            toggle.aortext_price_off.text=_G.string.AddColor(
                            _G.GetLangPackValue(90023030201), "434343")
            self.toggles[k].aortext_price_on.text=_G.string.AddColor(
                            _G.GetLangPackValue(90023030201), "434343")
            self.toggles[k].aorimage_isOff:SetGray(true)
            self.toggles[k].aorimage_isOn:SetGray(true)
            self.toggles[k].aorrawimage_icon_off:SetActiveE(0)
            self.toggles[k].aorrawimage_icon_on:SetActiveE(0)
            _G.GameUtil.ReBuildRTF(self.toggles[k].obj_priceContent1)
            _G.GameUtil.ReBuildRTF(self.toggles[k].obj_priceContent2)
        end
    end
    self:UpdateView()
end
function OptionalGiftView:OnClickAwardItem(go, isOn, index)
    local GiftroleInfo=self.model:GetRoleInfoBySid(self.curGift.sid)
    if not GiftroleInfo or GiftroleInfo.count<self.curGift.count then
        if index<=self.curGift.choose_count then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.OptionalGiftSelect.Name,index,self.curGift.sid,self.active)
        end
    elseif self.curAward[index] then
        require("CommonTipManager"):GetInstance():OpenTip(go,self.curAward[index][1])
    end
end
function OptionalGiftView:OnClickBtn(go, isOn)
    if go==self.go_table.aorbtn_Close then
        self:Close()
    elseif go==self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1032)
    elseif go==self.go_table.aorbtn_Buy then
        local GiftroleInfo=self.model:GetRoleInfoBySid(self.curGift.sid)
        if not GiftroleInfo or #GiftroleInfo.choose_index<self.curGift.choose_count then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.OptionalGiftSelect.Name,1,self.curGift.sid,self.active)
        else
            self.model:BuyGift(self.curGift.sid)
        end
    end
end
return OptionalGiftView