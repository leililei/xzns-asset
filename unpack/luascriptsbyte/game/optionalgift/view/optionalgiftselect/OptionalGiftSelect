---@class OptionalGiftSelect : UIBaseView	定制礼包 选择商品界面
---@field public go_table OptionalGiftSelect_GoTable GoTable
local OptionalGiftSelect = _G.BaseClass("OptionalGiftSelect", _G.UIBaseView)
local CS = _G.CS
local typeof = _G.typeof

function OptionalGiftSelect:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.objs_awrads={}
end

---界面的入口函数
---@field cur_index number 三个槽位当前点击的位置
function OptionalGiftSelect:OnCreate(index, sid, activity)
    self.specialIndex = {}
    self.activity = activity
    self.giftinfo = activity.typeClass.model:GetOneGift(sid)
    self.giftmsg=activity.typeClass.model:GetRoleInfoBySid(sid)
    self.choose_index={}
    ---槽位
    if table.isEmptyOrNil(self.giftmsg) or table.isEmptyOrNil(self.giftmsg.choose_index) then
        self.cur_index = 0
    else
        self.cur_index = index<=#self.giftmsg.choose_index and index or #self.giftmsg.choose_index
        for i = 1, #self.giftmsg.choose_index do
            table.insert(self.choose_index,self.giftmsg.choose_index[i])
        end
    end
    local x = 540
    if self.giftinfo.choose_count<=3 then
        x=127*self.giftinfo.choose_count+(self.giftinfo.choose_count-1)*47
    end
    local tf =self.go_table.obj_selectScroll:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    if not _G.IsNil(tf) then
        tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, x)
    end
    self:UpdateView()
end

function OptionalGiftSelect:CloseTips()
    local num = 0
    local lists = self.giftinfo:GetCurAwardPools_selec()
    for i = 1, #lists do
        if lists[i] > 0 then
            num = num + 1
        end
    end
    if self.isReplace then
        if num >= self.giftinfo.totale_select then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                100305,
                nil,
                function()
                    self:SureBtnOnClick()
                    self:Close()
                end,
                function()
                    self.giftinfo:ClearrData()
                    self:Close()
                end
            )
        else
            self.giftinfo:ClearrData()
            self:Close()
        end
    else
        self:Close()
    end
end

---按钮点击事件在这里派发
function OptionalGiftSelect:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        -- body
        if #self.choose_index==self.giftinfo.choose_count then
            self.activity.typeClass.model:SaveGiftInfo(self.giftinfo.sid, self.choose_index)
            self:Close()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(1260001)
        end
    elseif go == self.go_table.aorbtn_check then
        if self.boxData then
            require "CommonTipManager":GetInstance():OpenTip(self.go_table.aorbtn_check, self.boxData.Cfg.ID)
        end
    end
end


function OptionalGiftSelect:OnclickBtnAddHave(go, go1, ison, index)
    if not table.isEmptyOrNil(self.choose_index) and index and #self.choose_index>=index then
        self:OnClickBtnAdd(nil, nil, index)
    end
end

---点击槽位切换
function OptionalGiftSelect:OnClickBtnAdd(go, isOn, index)
    if self.cur_index == index then
        return
    end
    local tb = _G.GetAutoGoTable(self.objs_awrads[self.cur_index])
    tb.obj_select:SetActiveE(0)
    self.cur_index = index
    tb=_G.GetAutoGoTable(self.objs_awrads[self.cur_index])
    tb.obj_select:SetActiveE(1)
    self:SetDes()
end

function OptionalGiftSelect:UpdateView()
    self:SetDes()
    self:SetUnAwardObj()
    self:SetScrollView()
end

---设置奖励池子的物品
function OptionalGiftSelect:SetScrollView()
    self.gift_lists = self.giftinfo.choose_pool[1].award
    if self.scrollView == nil then
        self.go_table.scrollloopvectical_items:InitItemData(#self.gift_lists, _G.handler(self, self.RefreshItem))
        self.scrollView = self.go_table.scrollloopvectical_items
    else
        --self.scrollView:UpdateAllItem()
        self.scrollView:UpdateCount(#self.gift_lists)
    end
end

---滑动列表更新 (奖励池子)
function OptionalGiftSelect:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local _index=index+1
    local gift_info = self.gift_lists[_index]
    if gift_info == nil then
        obj:SetActiveE(0)
        return
    else
        obj:SetActiveE(1)
    end
    obj:SetName(index)
    --- local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index + 1, gift_info.index))
    local tb = _G.GetAutoGoTable(obj)

    if tb.obj_root:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(tb.obj_root:GetChildE(), _G.ePoolType.UIItem)
    end
    local award = gift_info.type
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_root,
        function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function() 
            self:OnClickItem(_index)
        end
    )
    tb.obj_select:SetActiveE(table.ContainsValue(self.choose_index,_index) and 1 or 0)
    return obj
end

---@param index number 界面中显示的下标
---@param award_index_pools number 所在池子的下标
function OptionalGiftSelect:OnClickItem(index)
    if self.cur_index>0 and #self.choose_index==self.giftinfo.choose_count then
        if not table.ContainsValue(self.choose_index,index) then
            self.choose_index[self.cur_index]=index
        else
            table.removebyvalue(self.choose_index,index)
        end
    elseif self.cur_index>0 and #self.choose_index<self.giftinfo.choose_count  then
        if not table.ContainsValue(self.choose_index,index) then
            table.insert(self.choose_index,index)
        else
            table.removebyvalue(self.choose_index,index)
        end
    elseif self.cur_index==0 then
        table.insert(self.choose_index,index)
        self.cur_index=1
    end
    self:UpdateView()
end

---设置非固定的奖励
function OptionalGiftSelect:SetUnAwardObj()
    for i = 1, self.giftinfo.choose_count do
        self:SetUnAwardObjOne(i)
    end
end

---设置单个的奖励状态
function OptionalGiftSelect:SetUnAwardObjOne(index)
    local tb ={}
    if table.isEmptyOrNil(self.objs_awrads) or #self.objs_awrads<index then
        local obj=_G.InstantiateObject(self.go_table.obj_root,self.go_table.obj_AwardNode)
        self.objs_awrads[index]=obj
        tb=_G.GetAutoGoTable(self.objs_awrads[index], _G.handlerbind(self, self.OnclickBtnAddHave, index))
    else
        tb=_G.GetAutoGoTable(self.objs_awrads[index], _G.handlerbind(self, self.OnclickBtnAddHave, index))
    end
    if tb.obj_itemroot:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(tb.obj_itemroot:GetChildE(), _G.ePoolType.UIItem)
    end
    tb.aorbtn_add:SetActiveE(#self.choose_index<index and 1 or 0)
    tb.aorbtn_Replace:SetActiveE(0)
    tb.obj_select:SetActiveE(self.cur_index==index and 1 or 0)
    if #self.choose_index>=index then
        local award = self.giftinfo.choose_pool[1].award[self.choose_index[index]].type
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                award,
                tb.obj_itemroot,
                function(item)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end,
                _G.handlerbind(self, self.OnclickBtnAddHave, index)
        )
    end
end

---设置描述
function OptionalGiftSelect:SetDes()
    local strDesc, strname, starnum = "", "", ""
    local data = nil
    if #self.choose_index > 0 then
        local index=self.choose_index[self.cur_index] and self.cur_index or #self.choose_index
        local awrad = self.giftinfo.choose_pool[1].award[self.choose_index[index]].type
        data = _G.StorageManager:GetInstance():GetStorageItemData(awrad[1])
        strDesc = _G.LangUtil.GetLangPackValue(data.Cfg.Describe or data.Cfg.describe or data.Cfg.biographies1[2])
        local count = _G.StorageManager:GetInstance():GetItemCountBySid(awrad[1])
        starnum = _G.LangUtil.GetLangPackValue(90000010363, count)
        strname = data.name
    else
        strname = _G.LangUtil.GetLangPackValue(90000010362)
        starnum = _G.LangUtil.GetLangPackValue(90000010363, 0)
    end
    self.boxData = nil
    if data then
        if data.Cfg.Type1 == 4 or data.Cfg.Type1 == 8 or data.Cfg.Type1 == 9 then
            self.boxData = data
            self.go_table.aorbtn_check:SetActiveE(1)
        else
            self.go_table.aorbtn_check:SetActiveE(0)
        end
    else
        self.go_table.aorbtn_check:SetActiveE(0)
    end
    self.go_table.aortext_itemSpace:SetActiveE(#self.choose_index > 0 and 0 or 1)
    self.go_table.obj_itemDesc:SetActiveE(#self.choose_index > 0 and 1 or 0)
    self.go_table.aortext_title:SetActiveE(#self.choose_index > 0 and 0 or 1)
    self.go_table.aortext_num.text = starnum
    self.go_table.aortext_itemDesc.text = strDesc
    self.go_table.aortext_itemName.text = strname
end


return OptionalGiftSelect
