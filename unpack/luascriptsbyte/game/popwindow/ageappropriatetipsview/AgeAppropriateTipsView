---@class AgeAppropriateTipsView : UIBaseView	适龄提示
---@field public go_table AgeAppropriateTipsView_GoTable GoTable
local AgeAppropriateTipsView = _G.BaseClass("AgeAppropriateTipsView", _G.UIBaseView)
--_G.AgeAppropriateTipsView = AgeAppropriateTipsView

local CS = _G.CS
local typeof = _G.typeof

function AgeAppropriateTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        [self.go_table.aorbtn_1:GetName()] = self.CloseView,
        ["@_aorbtn_Close"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---@class params_AgeAppropriateTipsView Data

---界面的入口函数
---@param  Data params_AgeAppropriateTipsView
function AgeAppropriateTipsView:OnCreate(Data)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
end
---资源加载
function AgeAppropriateTipsView:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function AgeAppropriateTipsView:SetData(Data)
    self.go_table.aortext_Content.text = LangUtil.GetLangPackValue(90021100031)
end

function AgeAppropriateTipsView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function AgeAppropriateTipsView:OnClickBtn(go, isOn)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)

    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return AgeAppropriateTipsView
