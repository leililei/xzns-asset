---@class FloatTipsView	中文描述
local FloatTipsitem = _G.BaseClass("FloatTipsitem")

---类的构造函数
function FloatTipsitem:__init(obj, view)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj)
    self.view = view
    self.canvasGrounp = self.gameObject:GetComponentE(typeof(CS.UnityEngine.CanvasGroup))
end

---类的析构函数
function FloatTipsitem:Dispose()
end

function FloatTipsitem:Show(content)
    self.go_table.aortext_content.text = content
    self.transform:SetLocalPosition(0, 0, 0)
    self.canvasGrounp.alpha = 1
    self.gameObject:SetActiveE(1)
    self.transform:SetAsLastSiblingE()
    self:MoveEffect()
end
function FloatTipsitem:MoveEffect()
    self.upTween, self.fadeTween =
        _G.CommonUIEffect:GetInstance():UpAndFade(
        self.transform,
        111.9,
        0.2,
        1,
        self.canvasGrounp,
        1,
        _G.handler(self, self.ShowEnd)
    )
end
function FloatTipsitem:Delety()
    if self.showTimer then
        self.showTimer:Reset()
    else
        self.showTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowEndEffect, self, true)
        self.showTimer:Start()
    end
end
function FloatTipsitem:ShowEndEffect()
    self.tween =
        self.canvasGrounp:DOFade(0, 1):SetEase(CS.DG.Tweening.Ease.Linear):OnComplete(_G.handler(self, self.ShowEnd))
end
function FloatTipsitem:ShowEnd()
    if _G.IsNil(self.gameObject) then
        return
    end
    self.gameObject:SetActiveE(0)
    if self.showTimer then
        self.showTimer:Stop()
        self.showTimer = nil
    end
    if self.upTween then
        self.upTween:Kill()
    end
    if self.fadeTween then
        self.fadeTween:Kill()
    end
    self.view:ShowEnd(self)
end

---@class FloatTipsView : UIBaseView	中文描述
---@field public go_table FloatTipsView_GoTable GoTable
local FloatTipsView = _G.BaseClass("FloatTipsView", _G.UIBaseView)
--_G.FloatTipsView = FloatTipsView

local TipItemPath = "UIH5/PopView/$_obj_TipItem"

function FloatTipsView:Awake()
    _G.FloatTipsModel:GetInstance():SetView(self)
end

---界面的入口函数
function FloatTipsView:OnCreate(content)
    self.Tips = {}
    self.ShowTips = {}
    self.showCount = 0
    self:Show(content)
end

function FloatTipsView:OnDestroy()
    if self.tween ~= nil then
        self.tween:Kill(true)
        self.tween = nil
    end
    _G.FloatTipsModel:GetInstance():SetView(nil)
end

function FloatTipsView:ShowEnd(item)
    if self:IsNil() then
        return
    end
    self.showCount = self.showCount - 1
    _G.table.insert(self.Tips, item)
    _G.table.remove(self.ShowTips, 1)
    if self.showCount == 0 then
        self.gameObject:SetActiveE(0)
    end
end

--region 对外接口
function FloatTipsView:Show(content)
    self.gameObject:SetActiveE(1)

    self.showCount = self.showCount + 1
    if #self.Tips == 0 then
        if #self.ShowTips < 1 then
            _G.PoolsManager:GetInstance():Spawn(
                TipItemPath,
                _G.ePoolType.Default,
                self.transform,
                function(trans)
                    local item = FloatTipsitem.New(trans, self)
                    item:Show(content)
                    _G.table.insert(self.ShowTips, item)
                end
            )
            return
        else
            self.ShowTips[1]:ShowEnd()
        end
    end
    self.Tips[1]:Show(content)
    _G.table.insert(self.ShowTips, self.Tips[1])
    _G.table.remove(self.Tips, 1)
end

--endregion
return FloatTipsView
