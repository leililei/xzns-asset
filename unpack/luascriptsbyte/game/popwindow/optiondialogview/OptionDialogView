require "CommonUIEffect"
---@class OptionDialogView : UIBaseView    中文描述
---@field public go_table OptionDialogView_GoTable GoTable
local OptionDialogView = _G.BaseClass("OptionDialogView", _G.UIBaseView)

---账号被顶号，踢人等操作
local accountTip = {
    [180301] = true,
    [180305] = true,
    [180103] = true,
    [180104] = true,
    [680101] = true,
    ---防沉迷的提示
    [290302] = true,
    [180107] = true
}

function OptionDialogView:Awake()
    self.btnPos = {
        {_G.Vector3.New(0, -50, 0)},
        {_G.Vector3.New(130, -50, 0), _G.Vector3.New(-130, -50, 0)},
        {_G.Vector3.New(165, -50, 0), _G.Vector3.New(0, -50, 0), _G.Vector3.New(-165, -50, 0)}
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.btns = {self.go_table.aorbtn_1, self.go_table.aorbtn_2, self.go_table.aorbtn_3}
    self.btnNames = {self.go_table.aortext_Name1, self.go_table.aortext_Name2, self.go_table.aortext_Name3}
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---@class OptionDialogViewParams
---@field title string 标题
---@field content string 正文
---@field btns number[] 按钮
---@field callback table<number,fun()> @按钮回调 key按钮索引,value按钮
---@field time table<number,number> @按钮显示倒计时 key按钮索引,value倒计时
---@field isAnimator boolean 是否播放动画(开启点击空白处关闭界面)
---@field inputText string 输入指定文本

---界面的入口函数
---@param params OptionDialogViewParams 参数
function OptionDialogView:OnCreate(params)
    if not _G.string.IsNullOrEmpty(params.title) then
        self.go_table.aortext_TitleName.text = params.title
    end
    self.id = params.id
    self.isAnimator = params.isAnimator
    self.callbacks = params.callback
    self.btnLength = #params.btns
    if params.extendParam then
        self.noBgClose = params.extendParam.noBgClose
        self.notCall = params.extendParam.notCall
        self.showExtendText = params.extendParam.showExtendText
        self.extendTextCall = params.extendParam.extendTextCall
        self.closeCall = params.extendParam.closeCall
    end
    self:ShowContent(params.content)

    for i = 1, self.btnLength do
        self.btnNames[i].text = params.btns[i]
        self.btns[i]:SetActiveE(1)
        self.btns[i]:SetLocalPosition(
            self.btnPos[self.btnLength][i].x,
            self.btnPos[self.btnLength][i].y,
            self.btnPos[self.btnLength][i].z
        )
        if self.btnLength > 2 then
            self.btns[i]:SetLocalScaleXYZ(0.9, 0.9, 0.9)
        else
            self.btns[i]:SetLocalScaleXYZ(1, 1, 1)
        end
    end
    for i = #params.btns + 1, #self.btns do
        self.btns[i]:SetActiveE(0)
    end
    self.go_table.aortext_Time:SetActiveE(0)
    if params.time and #params.time > 0 then
        for i = 1, #params.time do
            if params.time[i] > 0 then
                self.timeIndex = i
                self.time = params.time[i]
                self:ShowTime()
                break
            end
        end
    end
    if accountTip[params.id] then -- 防沉迷隐藏关闭按钮
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_CloseView, false)
    end
end
function OptionDialogView:OnDisable()
    if self.timeTimer then
        self.timeTimer:Stop()
    end
    self.timeTimer = nil
end
function OptionDialogView:ShowContent(str)
    if self.showExtendText then
        if not self.linkContentExtend then
            self.linkContentExtend = self.go_table.obj_linkContent:GetComponentE(_G.typeof(_G.CS.ExtendText))
            self.linkContentExtend.OnHrefClick:AddListener(_G.handler(self, self.OnHrefClick))
        end
        self.linkContentExtend.text = str
        self.go_table.aortext_Content.text= ""
    else
        self.go_table.aortext_Content.text = str
    end
end

function OptionDialogView:OnHrefClick(herfParam)
    if self.extendTextCall then
       self.extendTextCall(herfParam) 
    end
end

function OptionDialogView:ShowTime()
    self.go_table.aortext_Time:SetActiveE(1)
    self.go_table.aortext_Time.text = string.format("(%ds)", self.time)
    local x, y, z = self.btns[self.timeIndex]:GetLocalPosition()
    local pos = {x = x, y = y, z = z}
    local rectTran = self.btnNames[self.timeIndex]:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.btnNames[self.timeIndex]:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter)):SetLayoutHorizontal()
    x, y = rectTran:GetRectTransformSizeDelta()
    pos.x = pos.x + x * 0.5
    self.go_table.aortext_Time:SetLocalPosition(pos.x, pos.y, pos.z)
    self.timeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GetTimerCallBack, self)
    self.timeTimer:Start()
end

function OptionDialogView:GetTimerCallBack(elapsed)
    self.time = self.time - elapsed
    self.go_table.aortext_Time.text = "(" .. Mathf.RoundToInt(self.time) .. "s)"
    if self.time <= 0 then
        if self.callbacks[self.timeIndex] then
            self.callbacks[self.timeIndex]()
        end
        self.timeTimer:Stop()
        self:Close()
    end
end

---按钮点击事件在这里派发
function OptionDialogView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        if self.btnLength > 1 then
        else
            if self.callbacks[1] then
                self.callbacks[1]()
            end
        end
        if self.isAnimator then
            return
        end
        if go == self.go_table.aorbtn_close and self.noBgClose then 
            return 
        end
        _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
        if self.closeCall then
            self.closeCall()
            return
        end
        if self.notCall then
            return
        end
        if self.btns[2]:GetActiveSelf() == 1 then
            if self.callbacks[2] then
                self.callbacks[2]()
            end
        elseif not (self.btns[3]:GetActiveSelf() == 1) then
            if self.callbacks[1] then
                self.callbacks[1]()
            end
        end
    else
        _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
        if go == self.go_table.aorbtn_1 then
            if self.callbacks[1] then
                self.callbacks[1]()
            end
        elseif go == self.go_table.aorbtn_2 then
            if self.callbacks[2] then
                self.callbacks[2]()
            end
        elseif go == self.go_table.aorbtn_3 then
            if self.callbacks[3] then
                self.callbacks[3]()
            end
        elseif go == self.go_table.aorbtn_CloseView then
            if self.btns[2]:GetActiveSelf() == 1 then
                if self.callbacks[2] then
                    self.callbacks[2]()
                end
            elseif not (self.btns[3]:GetActiveSelf() == 1) then
                if self.callbacks[1] then
                    self.callbacks[1]()
                end
            end
        end
    end
end

---显示确认上方的文字
---@param param table<{content: string, sid: number|nil}> 道具参数列表，每项包含内容和可选的道具ID
function OptionDialogView:ShowDown(param)
    local item, go
    for _,v in pairs(param) do
        item = _G.InstantiateObject(self.go_table.obj_item,self.go_table.obj_down)
        go = _G.GetAutoGoTable(item)
        go.aortext_text.text = v.content
        if v.sid then
            go.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(v.sid))
        else
            go.aorrawimage_icon:SetActiveE(0)
        end
    end
end

---自定义内容
---@param call func<transform> 将回调自定义对象
function OptionDialogView:CustomContent(call)
    self.go_table.aortext_Content:SetActiveE(0)
    if call then
        call(self.go_table.obj_content)
    end
end

return OptionDialogView
