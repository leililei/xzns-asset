---更新资源显示(仿照背包)
function FastUseItemView:UpdateRes(resData)
    if (resData ~= nil) then
        if self.sidType == SidType.Normal then
            self:UpdateResNormal(resData)
        elseif self.sidType == SidType.MultiBox then
            self:UpdateResMultiBox(resData)
        end
    end
end

function FastUseItemView:UpdateResNormal(resData)
    local objitem = self.go_table.obj_Res
    self.go_table.obj_ResList:ClearChildren()
    for _, v in pairs(self.UseParameter) do
        local obj = _G.InstantiateObject(objitem, self.go_table.obj_ResList)
        local item = _G.GetAutoGoTable(obj)
        local AfkEff, itemData
        itemData = _G.StorageManager:GetInstance():GetItemDataClass(_G.tonumber(v[1]), 1)
        if self.PropData.cfg and self.PropData.cfg.UseType and self.PropData.cfg.UseType == 8 then
            AfkEff = require("AfkModel"):GetInstance():GetCurEfficiency({_G.tonumber(v[1]), _G.tonumber(v[2])})
            self.ParamsPRop_AfkBaseNum = AfkEff
        else
            self.ParamsPRop_AfkBaseNum = _G.tonumber(v[2])
        end
        item.aorrawimage_resIcon:LoadImage(itemData.Icon)
        if self.ParamsPRop_AfkBaseNum ~= nil then
            item.aortext_resHave.text = _G.GameUtil.NumberToUnitStr(self.ParamsPRop_AfkBaseNum * self.useNum)
        end
    end
end

function FastUseItemView:UpdateResMultiBox(resData)
    local childSid = self:FindChildSidByGetSid(self.UseParameter)
    local objitem = self.go_table.obj_BoxRes
    self.go_table.obj_BoxResList:ClearChildren()
    for i = 1, #self.UseParameter do
        local v = self.UseParameter[i]
        local obj = _G.InstantiateObject(objitem, self.go_table.obj_BoxResList)
        local item = _G.GetAutoGoTable(obj)
        local AfkEff, itemData
        itemData = _G.StorageManager:GetInstance():GetItemDataClass(_G.tonumber(v[1]), 1)
        if self.PropData.cfg and self.PropData.cfg.UseType and self.PropData.cfg.UseType == 8 then
            AfkEff = require("AfkModel"):GetInstance():GetCurEfficiency({_G.tonumber(v[1]), _G.tonumber(v[2])})
            self.ParamsPRop_AfkBaseNum = AfkEff
        else
            self.ParamsPRop_AfkBaseNum = _G.tonumber(v[2])
        end
        -- item.aorrawimage_resIcon:LoadImage(itemData.Icon)
        _G.StorageManager:GetInstance():GetItem(item.obj_item, itemData.sid, 1, _G.handler(self, self.ItemCall))
        if self.ParamsPRop_AfkBaseNum ~= nil then
            if itemData.sid == childSid then
                self.boxUseIndex = i
                self.getBoxNum = self.ParamsPRop_AfkBaseNum * self.useNum
                item.aortext_resHave.text = _G.GameUtil.NumberToUnitStr(self.getBoxNum)
                -- _G.UIUtils.LoadEffectByCfg(
                --     _G.ConfigManager.ui_effect_cfg.ef_DailyDeliveryView_icon,
                --     item.obj_item
                -- )
                self:UpdateBoxGetNum(_G.GameUtil.NumberToUnitStr(self.getBoxNum * self:GetBoxGetNum()))
                item.aorimage_choose:SetActiveE(1)
            else
                item.aortext_resHave.text = 0
                item.aorimage_choose:SetActiveE(0)
            end
        end
    end
end

--更新直接获得的道具数量显示
function FastUseItemView:UpdateBoxGetNum(num)
    local objitem = self.go_table.obj_Res
    self.go_table.obj_BoxNumResList:ClearChildren()
    local obj = _G.InstantiateObject(objitem, self.go_table.obj_BoxNumResList)
    local item = _G.GetAutoGoTable(obj)
    local AfkEff, itemData
    itemData = _G.StorageManager:GetInstance():GetItemDataClass(self.getSid, 1)
    item.aorrawimage_resIcon:LoadImage(itemData.Icon)
    item.aortext_resHave.text = num
end

--获取单次使用直接获得的道具数量
function FastUseItemView:GetBoxGetNum()
    if not self.childBoxAwardNum then 
        local childSid = self:FindChildSidByGetSid(self.UseParameter)
        local itemCfg = _G.ConfigManager.item_cfg[childSid]
        for k, v in ipairs(itemCfg.UseParameter) do
            if _G.tonumber(v[1]) == self.getSid then 
                if itemCfg.UseType and itemCfg.UseType == 8 then
                    local AfkEff = require("AfkModel"):GetInstance():GetCurEfficiency({_G.tonumber(v[1]), _G.tonumber(v[2])})
                    self.childBoxAwardNum = AfkEff
                else
                    self.childBoxAwardNum = _G.tonumber(v[2])
                end
                --self.childBoxAwardNum = require("AfkModel"):GetInstance():GetCurEfficiency({_G.tonumber(v[1]), _G.tonumber(v[2])})
            end
        end
    end
    return self.childBoxAwardNum
end


---多选多宝箱通过资源sid查找子宝箱sid
function FastUseItemView:FindChildSidByGetSid(resData)
    local params = _G.ConfigManager.discrete_cfg[100507]
    local items
    for i = 1, #params do
        if params[i][1] == self.getSid then
            items = params[i]
            break
        end
    end
    local sid
    for _, v in pairs(resData) do
        sid = _G.tonumber(v[1])
        if _G.table.ContainsValue(items, sid) then
            return sid
        end
    end
end

return FastUseItemView
