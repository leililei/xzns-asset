local SidType = {
    Normal = 1, --常规
    MultiBox = 2 --Type1=9且UseType=6（多选多宝箱）
}

function FastUseItemView:Awake()
    ---每次使用消耗数量根据配置 道具UseType
    self.Prop_UseNumDic = {
        [_G.ItemUseType.ItemDrop] = true,
        [_G.ItemUseType.DrawCard] = true,
        [_G.ItemUseType.CompoundCard] = true
    }

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_table.aorbtn_propSub.LongPress = true
    self.go_table.aorbtn_propSub10.LongPress = true
    self.go_table.aorbtn_propAdd.LongPress = true
    self.go_table.aorbtn_propAdd10.LongPress = true

    self.go_table.aorbtn_propSub.onLongPress = function()
        self:OnClick_PropUse_Sub()
    end
    self.go_table.aorbtn_propSub10.onLongPress = function()
        self:OnClick_PropUse_Sub(10)
    end
    self.go_table.aorbtn_propAdd.onLongPress = function()
        self:OnClick_PropUse_Add()
    end
    self.go_table.aorbtn_propAdd10.onLongPress = function()
        self:OnClick_PropUse_Add(10)
    end

    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = function()
            self:CloseView()
        end,
        ["@_aorbtn_CloseView2"] = function()
            self:CloseView()
        end,
        [self.go_table.aorbtn_propSub:GetName()] = function()
            self:OnClick_PropUse_Sub()
        end,
        [self.go_table.aorbtn_propSub10:GetName()] = function()
            self:OnClick_PropUse_Sub(10)
        end,
        [self.go_table.aorbtn_propAdd:GetName()] = function()
            self:OnClick_PropUse_Add()
        end,
        [self.go_table.aorbtn_propAdd10:GetName()] = function()
            self:OnClick_PropUse_Add(10)
        end,
        [self.go_table.aorbtn_propMax:GetName()] = function()
            self:OnClick_PropUse_Max()
        end,
        [self.go_table.aorbtn_1:GetName()] = function()
            self:PropUse()
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

function FastUseItemView:OnStartClose()
    if self.Call then
        self.Call()
        self.Call = nil
    end
end

---@field Call function 使用道具后回调
---@field sid number 要使用的道具id
---@field getSid number 要获取的资源id
---@class params_FastUseItemView Data

---界面的入口函数
---@param  Data params_FastUseItemView
function FastUseItemView:OnCreate(Data)
    Data = Data or {}
    self.sid = Data.sid
    self.getSid = Data.getSid
    self.Call = Data.Call

    if self.sid == nil then
        self:CloseView()
        return
    end

    self.sidType = SidType.Normal
    ---@type item_cfg
    local cfg = _G.ConfigManager.item_cfg[self.sid]
    if cfg.Type1 == 9 and cfg.UseType == 6 then
        self.sidType = SidType.MultiBox
    end
    self:InitView()

    self:SetData()
    self.go_table.input_useNum.onEndEdit:AddListener(_G.handler(self, self.OnEndEditorDeclaration))
    -- if (Data.from ~= nil) then
    --     if (Data.from == _G.ConfigManager.ui_cfg.CardGuangMingShenShi.Name) then
    --         self:GuangMingShenShiAdjust()
    --     end
    -- end
end

function FastUseItemView:InitView()
    if self.sidType == SidType.MultiBox then
        self.go_table.aorimage_bg:SetRectTransformSize(633, 595) --原始h433
        self.go_table.obj_useCount:SetAnchorPosition(0, 56, 0) --原始y-35
        self.go_table.aorimage_BoxResBg:SetActiveE(1)
    end
end

function FastUseItemView:OnDestroy()
    self.go_table.input_useNum.onEndEdit:RemoveListener(_G.handler(self, self.OnEndEditorDeclaration))
end

function FastUseItemView:OnEndEditorDeclaration(input)
    local num = _G.tonumber(input)
    if num > self.maxNum then
        num = self.maxNum
    elseif num < self.minNum then
        num = self.minNum
    end
    self.useNum = num
    self:ShowNum()
    self:UpdateRes(self.UseParameter)
end

function FastUseItemView:SetData()
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(self.sid)
    self.PropData = _G.StorageManager:GetInstance():GetItemDataByID(storageId, self.sid)

    _, storageId = _G.StorageManager:GetInstance():CheckSidType(self.getSid)
    self.GetPropData = _G.StorageManager:GetInstance():GetItemDataByID(storageId, self.getSid)
    if not self.GetPropData then
        self.GetPropData = _G.StorageManager:GetInstance():GetItemDataClass(self.getSid, 0)
    end
    self.maxNum = self:PropUse_GetMaxCount()
    self.minNum = self:PropUse_GetMinCount()

    local name = self.PropData:GetName()
    local getname = self.GetPropData:GetName()

    self.go_table.aortext_Content.text = _G.LangUtil.GetLangPackValue(90020300112, getname, name, getname)

    ---默认使用最大
    self.useNum = self.maxNum
    self:ShowNum()

    _G.StorageManager:GetInstance():GetItem(self.go_table.obj_item, self.sid, 1, _G.handler(self, self.ItemCall))
    self.UseParameter = self.PropData.cfg.UseParameter
    self:UpdateRes(self.UseParameter)
end

function FastUseItemView:ShowNum()
    --self.go_table.aortext_useNum.text = self.useNum
    self.go_table.input_useNum.text = self.useNum
end

function FastUseItemView:ItemCall(itemlua, storageType)
    itemlua:ShowNumText(false)
end

--region --------------------------------------使用次数--------

function FastUseItemView:OnClick_PropUse_Add(num)
    if self.useNum >= self.maxNum then
        return
    end
    num = num or 1
    self.useNum = self.useNum + num
    if self.useNum > self.maxNum then
        self.useNum = self.maxNum
    end
    self:ShowNum()
    self:UpdateRes(self.UseParameter)
end
function FastUseItemView:OnClick_PropUse_Sub(num)
    if self.useNum <= self.minNum then
        return
    end
    num = num or 1

    self.useNum = self.useNum - num
    if self.useNum < self.minNum then
        self.useNum = self.minNum
    end
    self:ShowNum()
    self:UpdateRes(self.UseParameter)
end

function FastUseItemView:OnClick_PropUse_Max()
    if self.useNum >= self.maxNum then
        return
    end
    self.useNum = self:PropUse_GetMaxCount()
    self:ShowNum()
    self:UpdateRes(self.UseParameter)
end

----返回可使用的最小次数
function FastUseItemView:PropUse_GetMinCount()
    local num = self.PropData.count

    local baseNum = 1
    ---- 3 9  使用每次消耗根据配置
    if self.Prop_UseNumDic[self.PropData.cfg.UseType] == true then
        baseNum = tonumber(self.PropData.cfg.UseParameter[1][1])
    end
    local hcCount = math.floor(num / baseNum)
    if hcCount > 0 then
        hcCount = 1
    end
    return hcCount
end
----返回可使用的最大次数
function FastUseItemView:PropUse_GetMaxCount()
    local num = self.PropData.count
    -- if self.PropData.cfg.limit_num and num > self.PropData.cfg.limit_num then
    --     num = self.PropData.cfg.limit_num
    -- end

    local baseNum = 1
    ---- 3 9  使用每次消耗根据配置
    if self.Prop_UseNumDic[self.PropData.cfg.UseType] == true then
        baseNum = tonumber(self.PropData.cfg.UseParameter[1][1])
    end
    local hcCount = math.floor(num / baseNum)
    if self.PropData.cfg.limit_num and hcCount > self.PropData.cfg.limit_num then
        hcCount = self.PropData.cfg.limit_num
    end
    return hcCount
end

--endregion------------------------------------使用次数--------

--region --------------------------------------确认使用--------

function FastUseItemView:PropUse()
    if self.useNum > 0 then
        local param
        local useFunc = function()
            self:CloseView(true)
        end
        local hideAwardBol
        if self.sidType == SidType.MultiBox then
            param = {[self.boxUseIndex] = self.useNum}
            local childSid = self:FindChildSidByGetSid(self.UseParameter)
            useFunc = function()
                _G.StorageManager:GetInstance():UsePropToServer(
                childSid,
                self.getBoxNum and self.getBoxNum or self.useNum,
                function()
                    self:CloseView(true)
                end)
            end
            hideAwardBol = true
        end
        
        _G.StorageManager:GetInstance():UsePropToServer(
            self.sid,
            self.useNum,
            useFunc,
            param,
            nil,
            hideAwardBol
        )
    end
end

--endregion------------------------------------确认使用--------

---按钮点击事件在这里派发
function FastUseItemView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function FastUseItemView:CloseView(isUse)
    if isUse ~= true then
        ---没使用道具 就不回调
        self.Call = nil
    end
    self:Close()
end

