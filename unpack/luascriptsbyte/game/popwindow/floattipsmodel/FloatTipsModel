function FloatTipsModel:Dispose()
end

--region对外接口
function FloatTipsModel:Show(content)
    local nowWindow = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    if nowWindow then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(content, "加载过程中不提示")
        end
        return
    end
    if self.view then
        self.view:Show(content)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FloatTipsView.Name, content)
    end

    if _G.AppSetting.DEBUG then
        _G.Log(content, "提示音添加>>>>>>>>>>>>>>>>>")
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.promptAuido)
end
function FloatTipsModel:SetView(view)
    self.view = view
end
--endregion
