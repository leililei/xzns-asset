local FloatTipsModel = _G.BaseClass("FloatTipsModel", _G.Singleton)
_G.FloatTipsModel = FloatTipsModel

local CS = _G.CS
local typeof = _G.typeof

---@return FloatTipsModel FloatTipsModel
function FloatTipsModel:GetInstance()
    return self.super.GetInstance(self)
end

