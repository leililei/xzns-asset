local base = require "OptionDialogView"
---@class OptionDialogConsumeView : UIBaseView	中文描述
---@field public go_table OptionDialogConsumeView_GoTable GoTable
local OptionDialogConsumeView = _G.BaseClass("OptionDialogConsumeView", base)
--_G.OptionDialogConsumeView = OptionDialogConsumeView

---@class OptionDialogConsumeViewParams
---@field title string 标题
---@field content string 正文
---@field btns number[] 按钮
---@field consume number 消耗品id
---@field consumeCount number 消耗数量
---@field callback table<number,fun()> @按钮回调 key按钮索引,value按钮
---@field time table<number,number> @按钮显示倒计时 key按钮索引,value倒计时
function OptionDialogConsumeView:OnCreate(params)
    base.OnCreate(self, params)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_consume, params.consume)
    if params.consume then
        self.go_table.aorrawimage_consume:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(params.consume))
        local consumeCount = params.consumeCount or 0
        local allCount = _G.StorageManager:GetInstance():GetItemCountBySid(params.consume)
        if consumeCount <= allCount then
            self.go_table.aortext_num.text = _G.string.format("%s/%s", consumeCount, allCount)
        else
            self.go_table.aortext_num.text = _G.string.format("<color=#e33f3f>%s</color>/%s", consumeCount, allCount)
        end
    end
end

---按钮点击事件在这里派发
function OptionDialogConsumeView:OnClickBtn(go)
    _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)

    if go == self.go_table.aorbtn_1 then
        if self.callbacks[1] then
            self.callbacks[1]()
        end
    elseif go == self.go_table.aorbtn_2 then
        if self.callbacks[2] then
            self.callbacks[2]()
        end
    elseif go == self.go_table.aorbtn_3 then
        if self.callbacks[3] then
            self.callbacks[3]()
        end
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_bg then
        if self.btns[2]:GetActiveSelf() == 1 then
            if self.callbacks[2] then
                self.callbacks[2]()
            end
        elseif not self.btns[3]:GetActiveSelf() == 1 then
            if self.callbacks[1] then
                self.callbacks[1]()
            end
        end
    end
end

return OptionDialogConsumeView
