require "CommonUIEffect"
---@class DialogTableListView : UIBaseView    中文描述
---@field public go_table DialogTableListView_GoTable GoTable
local DialogTableListView = _G.BaseClass("DialogTableListView", _G.UIBaseView)

function DialogTableListView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

---@class DialogTableListViewParams
---@field title string 标题
---@field content string 正文
---@field list number[][] 列表
---界面的入口函数
---@param data DialogTableListViewParams 参数
function DialogTableListView:OnCreate(data)
    self.id = data.cfg.id
    self.title = _G.LangUtil.GetLangPackValue(data.cfg.title)
    self.content = data.content
    self.list = self:MergeAward(data.list)
    if not _G.string.IsNullOrEmpty(self.title) then
        self.go_table.aortext_TitleName.text = self.title
    end
    self:ShowContent(self.content)
    self.go_table.scrollloopvectical_Table:InitItemData(0, _G.handler(self, self.FreshList))
    self.go_table.scrollloopvectical_Table:UpdateCount(#self.list)
end
function DialogTableListView:MergeAward(params)
    local list = {}
    for _, v in pairs(params.award) do
        _G.table.insert(list, v)
    end
    for _, v in pairs(params.got) do
        v.got = true
        _G.table.insert(list, v)
    end
    return list
end
function DialogTableListView:ShowContent(str)
    self.go_table.aortext_Content.text = str
end

function DialogTableListView:FreshList(index, obj)
    if index < 0 then
        return
    end
    local tb = _G.GetAutoGoTable(obj)
    local x = index + 1
    local cfg = self.list[x]
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        cfg,
        tb.obj_root,
        function(tran)
            if cfg.got then
                tran:SetGou(true)
            end
            tb.sid = cfg[1]
            tran.gameObject:SetLocalPosition(0, 0, 0)
            tran.gameObject:SetLocalScaleXYZ(1)
            tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function()
            require("CommonTipManager"):GetInstance():OpenTip(tb.gameObject, tb.sid)
        end
    )
end
---按钮点击事件在这里派发
function DialogTableListView:OnClickBtn(go)
    _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

return DialogTableListView
