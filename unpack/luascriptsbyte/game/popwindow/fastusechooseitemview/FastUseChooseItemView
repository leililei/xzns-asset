end

---界面的入口函数
---@param Data params_FastChooseUseItemView 道具id
---@param call function 使用成功回调
function FastUseChooseItemView:OnCreate(Data)
    if not Data then
        self:Close()
        return
    end
    self.sid = Data.sid
    self.call = Data.Call
    self.cfg = _G.ConfigManager.item_cfg[self.sid]
    self.itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, self.sid)
    self.CurSelect = {}
    self.CurSelectNum = 1
    self.Index = 0
    self.SelectItems = {}
    self.needCount = Data.count
    self.UseTape = self.cfg.UseType or 0
    if not self.GetPropData then
        self.GetPropData = _G.StorageManager:GetInstance():GetItemDataClass(Data.getSid, 0)
    end
    local name = self.itemData:GetName()
    local getname = self.GetPropData:GetName()
    self.go_table.aortext_Content.text = _G.LangUtil.GetLangPackValue(90020300112, getname, name, getname)
    if self.cfg.UseType == _G.ItemUseType.GetProp then
        self.CurSelectNum = 1
        self.go_table.obj_useCount:SetActiveE(1)
    elseif self.cfg.UseType == _G.ItemUseType.SelectProp then
        self.CurSelectNum = 0
        self.go_table.obj_useCount:SetActiveE(0)
    end

    self.go_table.input_userNum.onEndEdit:RemoveAllListeners()
    self.go_table.input_userNum.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclaration))

    self.go_table.input_userNum.text = self.CurSelectNum
    ---@param itemLua itemViewNewWithCount
    _G.ItemFactory:GetInstance():GetItemCard(
        _G.ItemFactory.itemType.ItemBaseWithCount,
        self.go_table.obj_item,
        function(itemLua)
            self.go_table.item = itemLua
            itemLua:Show(self.sid)
        end
    )

    self:CreateItem()
    self.go_table.aortext_ItemNum.text = string.format("%d/%d ", self.CurSelectNum, self.itemData.count)
end

