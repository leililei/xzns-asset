---增减数量
function FastUseChooseItemView:SetSelectOne(index, num)
    if self.CurSelectNum + num > self.itemData.count or self.CurSelectNum + num < 0 then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.OverMaxCount)
        return
    end
    if not self.CurSelect[index] and num < 0 then
        return
    end

    if self.CurSelect[index] == 0 and num < 0 then
        return
    end

    if not self.CurSelect[index] then
        self.CurSelect[index] = 0
    end

    self.CurSelect[index] = self.CurSelect[index] + num
    self.CurSelectNum = self.CurSelectNum + num
    self.SelectItems[index].input_Name.text = self.CurSelect[index]
    self.go_table.aortext_ItemNum.text = string.format("%d/%d ", self.CurSelectNum, self.itemData.count)
    --_G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_numdi.rectTransform)
end
---改变选择
---@param index number 下标
---@param num number 增减数量
function FastUseChooseItemView:SetSelect(num)
    if self.CurSelectNum + num > self.itemData.count or self.CurSelectNum + num < 1 then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.OverMaxCount)
        return
    end
    -- if num < 0 then
    --     return
    -- end
    self.CurSelectNum = self.CurSelectNum + num
    if self.CurSelectNum > 9999 then
        self.CurSelectNum = 9999
    end
    self.go_table.input_userNum.text = self.CurSelectNum
    self.go_table.aortext_ItemNum.text = string.format("%d/%d ", self.CurSelectNum, self.itemData.count)
    --_G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_numdi.rectTransform)
end

---点击选择道具增减
---@param index number 下标
function FastUseChooseItemView:ClickSelectItem(go, isOn, index, sid, param)
    local name = go:GetName()
    if name == "@_aorbtn_Sub" then
        self:SetSelectOne(index, -1)
    elseif name == "@_aorbtn_Add" then
        self:SetSelectOne(index, 1)
    elseif name == "@_aorbtn_ShowTips" then
        if self.cfg.UseType == _G.ItemUseType.SelectProp then
            require("CommonTipManager"):GetInstance():OpenTip(go, tonumber(sid), nil, nil, _G.tonumber(param))
        else
            self.Index = index
            if self.CurSelectNum == nil then
                self.CurSelectNum = 1
            else
                if self.itemData.count <= self.CurSelectNum then
                    self.CurSelectNum = self.itemData.count
                end
            end
            self.go_table.input_userNum.text = self.CurSelectNum
            self:KuangXianShi()
        end
    elseif name == "@_aorbtn_DianJi" then
        if self.UseTape == _G.ItemUseType.GetProp then
            self.Index = index
            if self.CurSelectNum == nil then
                self.CurSelectNum = 1
            end
            self.go_table.aortext_ItemNum.text = string.format("%d/%d ", self.CurSelectNum, self.itemData.count)
            self:KuangXianShi()
        end
    end
end
---亮框显示
function FastUseChooseItemView:KuangXianShi()
    for key, value in pairs(self.SelectItems) do
        if key == self.Index and self.cfg.UseType == _G.ItemUseType.GetProp then
            value.aorimage_Kuang:SetActiveE(1)
        else
            value.aorimage_Kuang:SetActiveE(0)
        end
    end
    -- self.go_table.obj_useCount:SetActiveE(1)
end

---选择完毕确认使用
function FastUseChooseItemView:Done()
    local list = {}
    for i, v in pairs(self.CurSelect) do
        if v ~= 0 then
            list[i] = v
        end
    end
    if _G.table.count(list) < 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        local item = {}
        item[self.Index] = self.CurSelectNum
        _G.StorageManager:GetInstance():UsePropToServer(
            self.sid,
            self.CurSelectNum,
            function()
                if self.call then
                    self.call()
                end
                self:Close()
            end,
            list
        )
    end
end

---选择完毕确认使用
function FastUseChooseItemView:DoneUseTape()
    if self.Index == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.NotSelect)
        return
    else
        _G.StorageManager:GetInstance():UsePropToServer(
            self.sid,
            self.CurSelectNum,
            function()
                if self.call then
                    self.call()
                end
                self:Close()
            end,
            {1},
            self.Index
        )
    end
end

---按钮点击事件在这里派发
function FastUseChooseItemView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_BG" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        if self.UseTape == _G.ItemUseType.GetProp then
            self:DoneUseTape()
        elseif self.CurSelect ~= 0 then
            self:Done()
        end
    elseif name == "@_aorbtn_propSub" then
        self:SetSelect(-1)
    elseif name == "@_aorbtn_propAdd" then
        self:SetSelect(1)
    elseif name == "@_aorbtn_propMax" then
        self.CurSelectNum = self.itemData.count > 9999 and 9999 or self.itemData.count
        self.go_table.input_userNum.text = self.CurSelectNum
        self.go_table.aortext_ItemNum.text = string.format("%d/%d ", self.CurSelectNum, self.itemData.count)
        --_G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_numdi.rectTransform)
    end
end

return FastUseChooseItemView
