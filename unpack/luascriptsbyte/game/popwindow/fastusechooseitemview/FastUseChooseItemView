---创建可选择的道具
function FastUseChooseItemView:SetItem(tran, data, i)
    local go_table, itemData
    local _data = {}

    itemData = _G.StorageManager:GetInstance():GetItemDataClassByCfg(data)
    if self.SelectItems[i] == nil then
        self.SelectItems[i] = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.ClickSelectItem, i, data[1], data[3]))
    end
    go_table = self.SelectItems[i]

    local itemName = _G.StorageManager:GetInstance():GetItemName(_G.tonumber(data[1]))
    go_table.aortext_Name.text = itemName
    if self.UseTape == _G.ItemUseType.GetProp then
        -- body
        go_table.obj_LeiXing:SetActiveE(0)
        --go_table.aorimage_Name:SetActiveE(0)

    else
        --go_table.aorimage_Name:SetActiveE(0)
    end
    if i == self.Index and self.cfg.UseType == _G.ItemUseType.GetProp then
        go_table.aorimage_Kuang:SetActiveE(1)
    else
        go_table.aorimage_Kuang:SetActiveE(0)
    end
    if self.cfg.UseType == _G.ItemUseType.SelectProp then
        go_table.obj_LeiXing:SetActiveE(1)
    else
        go_table.obj_LeiXing:SetActiveE(0)
    end

    go_table.input_Name.onEndEdit:RemoveAllListeners()
    go_table.input_Name.onEndEdit:AddListener(_G.handlerbind(self, self.OnEndEditorDeclarationOen, i, data[1]))

    go_table.input_Name.text = 0
    if not go_table.item then
        for k, v in pairs(data) do
            _G.table.insert(_data, _G.tonumber(v))
        end
        local sid = table.remove(_data, 1)
        local num = table.remove(_data, 1)
        if self.GetPropData and sid == self.GetPropData.sid and self.needCount then
            self:SetSelectOne(i,self.needCount)
        end
        _G.StorageManager:GetInstance():GetItemBaseView(
            sid,
            num,
            go_table.obj_item,
            function(itemLua)
                go_table.item = itemLua
                if itemLua.ShowNumText then
                    itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end,
            nil,
            _data
        )
    else
        _G.GameUtil.SetActiveByCondition(go_table.item.go_table.gameObject, true)
        go_table.item:ShowData(itemData)
    end
end
---多选多改变输入值
function FastUseChooseItemView:OnEndEditorDeclarationOen(input, index, nums)
    local num = _G.tonumber(input)
    if num == nil then
        return
    elseif num <= 0 then
        num = 1
    end
    local max = self.itemData.count - self.CurSelectNum
    if self.CurSelect[index] ~= nil then
        max = max + self.CurSelect[index]
    end

    local min = 0
    if num >= max then
        num = max
    elseif num < min then
        num = min
    end
    if num > 9999 then
        num = 9999
    end
    if self.CurSelect[index] == nil then
        self.CurSelectNum = num + self.CurSelectNum
    else
        self.CurSelectNum = num + self.CurSelectNum - self.CurSelect[index]
    end

    self.CurSelect[index] = num
    self.SelectItems[index].input_Name.text = num
    self.go_table.aortext_ItemNum.text = string.format("%d/%d ", self.CurSelectNum, self.itemData.count)
    --_G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aorimage_numdi.rectTransform)
end

