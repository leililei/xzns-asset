require "CommonUIEffect"
local OptionDialogView = require "OptionDialogView"
---@class ConsumeItemsView : OptionDialogView    中文描述
---@field public go_table ConsumeItemsView_GoTable GoTable
local ConsumeItemsView = _G.BaseClass("ConsumeItemsView", OptionDialogView)

---@class ConsumeItemsViewParams
---@field title string 标题
---@field content string 正文
---@field btns number[] 按钮
---@field callback table<number,fun()> @按钮回调 key按钮索引,value按钮
---@field time table<number,number> @按钮显示倒计时 key按钮索引,value倒计时

---界面的入口函数
---@param params ConsumeItemsViewParams 参数
function ConsumeItemsView:OnCreate(params)
    if not string.IsNullOrEmpty(params.title) then
        self.go_table.aortext_TitleName.text = params.title
    end
    local subList = {}
    table.insert(subList, {params.content[2].id, false, params.content[2].num})

    if self.go_table.ResConsume == nil then
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        self.go_table.ResConsume =
            self:AddComponent(
            self.go_table.trans_item,
            require("ConsumeCompont").New(self.go_table.trans_item, subList, 1, nil, true, data)
        )
    end

    self.go_table.aortext_Content.text = params.content[1]
    self.callbacks = params.callback
    self.btnLength = #params.btns
    for i = 1, self.btnLength do
        self.btnNames[i].text = params.btns[i]
        self.btns[i]:SetActiveE(1)
        self.btns[i]:SetLocalPosition(
            self.btnPos[self.btnLength][i].x,
            self.btnPos[self.btnLength][i].y,
            self.btnPos[self.btnLength][i].z
        )
        if self.btnLength > 2 then
            self.btns[i]:SetLocalScaleXYZ(0.9, 0.9, 0.9)
        else
            self.btns[i]:SetLocalScaleXYZ(1, 1, 1)
        end
    end
    for i = #params.btns + 1, #self.btns do
        self.btns[i]:SetActiveE(0)
    end
    self.go_table.aortext_Content.text = params.content[1]
    self.go_table.aortext_Time:SetActiveE(0)
    if params.time and #params.time > 0 then
        for i = 1, #params.time do
            if params.time[i] > 0 then
                self.timeIndex = i
                self.time = params.time[i]
                self:ShowTime()
                break
            end
        end
    end
    if params.id == 290302 then -- 防沉迷隐藏关闭按钮
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_CloseView, false)
    end
    self.isAnimator = params.isAnimator or false
end

return ConsumeItemsView
