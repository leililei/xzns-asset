local PopWindowManager = _G.BaseClass("PopWindowManager", base)
_G.PopWindowManager = PopWindowManager
---本地保存勾选项
local SaveToggleWindowTimeLocalKey = "SaveToggleWindowTimeLocalKey"
local SaveToggleWindowIdsLocalKey = "SaveToggleWindowIdsLocalKey"

