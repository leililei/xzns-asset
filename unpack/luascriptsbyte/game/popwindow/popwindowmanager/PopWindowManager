    [7] = function(self, data) --显示奖励/道具/卡牌列表
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DialogTableListView.Name, data)
    end,
    [8] = function(self, data)
        local MainOpenViewFunItem = {}

        MainOpenViewFunItem.checkFun = function()
            local CurrentWorld = _G.WorldManager:GetInstance():GetCurWorld()
            return CurrentWorld.Cfg.Scene_Type == _G.SceneType.MainWorld
        end
        MainOpenViewFunItem.OpenViewFun = function()
            _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.Illustration)
