function PopWindowManager:HandleServerMsgByOne(data)
    local key = _G.tonumber(data.con_key)
    local cfg = _G.ConfigManager.tips_system_cfg[key]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到对应的配置数据 id=" .. key)
        end
        return
    end
    self:ShowAllTips(key, HandleContent(_G.LangUtil.GetLangPackValue(cfg.content), data.con, key))
end

local function HandleData(data)
    ---@type OptionDialogViewParams
    local params = {}
    params.id = data.cfg.id
    params.title = data.cfg.title > 0 and _G.LangUtil.GetLangPackValue(data.cfg.title) or nil
    params.content = data.content
    params.isAnimator = data.isAnimator
    params.extendParam = data.extendParam
    if data.cfg.button_type == 1 or data.cfg.button_type == 4 then --单按钮
        params.btns = { data.cfg.button1 }
        params.callback = { data.sure }
        if data.cfg.button_type == 4 then
            params.time = { data.cfg.time }
        end
    elseif data.cfg.button_type == 2 or data.cfg.button_type == 5 or data.cfg.button_type == 6 then --双按钮
        params.btns = { data.cfg.button2, data.cfg.button1 }
        params.callback = { data.sure, data.cancle }
        if data.cfg.button_type == 5 then
            params.time = { data.cfg.time, 0 }
        elseif data.cfg.button_type == 6 then
            params.time = { 0, data.cfg.time }
        end
    elseif
        data.cfg.button_type == 3 or data.cfg.button_type == 7 or data.cfg.button_type == 8 or data.cfg.button_type == 9
    then --三按钮
        params.btns = { data.cfg.button2, data.cfg.button1, data.cfg.button3 }
        params.callback = { data.sure, data.cancle, data.extra }
        if data.cfg.button_type == 7 then
            params.time = { 0, data.cfg.time, 0 }
        elseif data.cfg.button_type == 8 then
            params.time = { data.cfg.time, 0, 0 }
        elseif data.cfg.button_type == 9 then
            params.time = { 0, 0, data.cfg.time }
        end
    end

    --带勾选框的弹窗
    if data.cfg.type1 == 5 then
        if type(data.extra) == "boolean" then
            data.isOn = data.extra
            data.extra = nil
        end
        if data.cfg.button4 and data.cfg.button4 > 0 then
            params.toggleDesc = _G.LangUtil.GetLangPackValue(data.cfg.button4)
        end
    end

    if params.btns == nil then
        params.btns = {}
        if _G.AppSetting.DEBUG then
            _G.LogError(params.id, "[容错打印]tip_system_cfg的button_type配置错误!")
        end
    end
    for i = 1, #params.btns do
        if params.btns[i] > 0 then
            params.btns[i] = _G.LangUtil.GetLangPackValue(params.btns[i])
        end
    end
    if data.cfg.type1 == 9 then
        params.inputText = data.cfg.button4
    end
    params.isOn = data.isOn
    return params
end
local OpenToggleViewList = {}
local function OnOptionDialogByToggleViewClose(self, name)
    if name ~= _G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.OptionDialogByToggleView.Name,
        HandleData(OpenToggleViewList[1])
    )
    _G.table.remove(OpenToggleViewList, 1)
    if #OpenToggleViewList == 0 then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, OnOptionDialogByToggleViewClose, self)
    end
end
local OpenOptionViewList = {}
local function OnOptionDialogViewClose(self, name)
    if name ~= _G.ConfigManager.ui_cfg.OptionDialogView.Name then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.OptionDialogView.Name,
        HandleData(OpenOptionViewList[1])
    )
    _G.table.remove(OpenOptionViewList, 1)
    if #OpenOptionViewList == 0 then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, OnOptionDialogViewClose, self)
    end
end
local showFunc = {
    [1] = function(self, data) --文字提示
        _G.FloatTipsModel:GetInstance():Show(data.content)
    end,
    [2] = function(self, data) --跑马灯
        _G.ScrollerManager:GetInstance():AddLocalScroller(data.content)
    end,
    [3] = function(self, data) --二次确认框
        local UImanagerIns = _G.UIManager:GetInstance()
        local name = _G.ConfigManager.ui_cfg.OptionDialogView.Name
        if not UImanagerIns:IsActiveWindow(name) then
            _G.UIManager:GetInstance():OpenWindow(name, HandleData(data))
        else
            OpenOptionViewList[#OpenOptionViewList + 1] = data
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OnOptionDialogViewClose, self)
        end
    end,
    [4] = function(self, data)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ConsumeItemsView.Name, HandleData(data))
    end,
    [5] = function(self, data) --带勾选项的二次确认框
