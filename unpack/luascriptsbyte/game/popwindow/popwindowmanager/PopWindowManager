---抽卡展示包含toggle的二次确认框
---@param id number tips_system_cfg的ID
---@param type number 抽奖类型
---@param poolId number 奖池类型
---@param drawTimes number 抽卡次数
---@param sure function 右边边按钮的回调方法
---@param cancle function 左边边边按钮的回调方法
---@param doCall function 勾选不在提示后的回调方法(nil就调sure方法)
function PopWindowManager:ShowDrawWindowByToggle(
    id,
    type,
    poolId,
    drawTimes,
    diamondNum,
    sure,
    cancle,
    doCall,
    ignoreFunctionOpen)
    local newId = id * 10 + type
    if not self:CheckToggleWindow(newId, ignoreFunctionOpen) then
        if doCall then
            doCall()
        elseif sure then
            sure()
        end
        return
    end
    local cfg = _G.ConfigManager.tips_system_cfg[id]
    local content = ""
    local config = {}
    if type == _G.DrawRollerType.NormalDraw then
        local exchange_cfg = _G.ConfigManager.exchange_cfg[poolId]
        config.buy_time = exchange_cfg.get_item[2]
    elseif
        type == _G.DrawRollerType.GodDraw or type == _G.DrawRollerType.DrawUp or type == _G.DrawRollerType.PetDrawUp or
        type == _G.DrawRollerType.ArtifactDrawUp or type == _G.DrawRollerType.JointActivity
    then
        config = _G.ConfigManager.limited_roller_cfg[poolId]
    elseif type == _G.DrawRollerType.PetDraw or type == _G.DrawRollerType.ArtifactDraw or _G.DrawRollerType.SpoilsDraw then
        config = _G.ConfigManager.item_roller_cfg[poolId]
    end
    if not _G.table.isEmptyOrNil(config.buy_time) then
        local name = _G.StorageManager:GetInstance():GetItemName(config.buy_time[1])
        local awardNum = config.buy_time[2]
        if type ~= _G.DrawRollerType.NormalDraw then
            awardNum = awardNum * drawTimes
        end
        content = _G.LangUtil.GetLangPackValue(cfg.content, diamondNum, name, awardNum, drawTimes)
    else
        if sure then
            sure()
        end
        return
    end
    local data = {
        cfg = cfg,
        content = content,
        isOn = true,
        sure = function(toggle)
            if toggle then
                self.toggleDic.ids[newId] = true
                _G.PlayerPrefsManager.SetInt(SaveToggleWindowTimeLocalKey, self.toggleDic.t)
                _G.PlayerPrefsManager.SetTable(SaveToggleWindowIdsLocalKey, self.toggleDic.ids)
            end
            if sure then
                sure()
            end
        end,
        cancle = function()
            if cancle then
                cancle()
            end
        end
    }
    showFunc[5](self, data)
end

local popWindowIndexT = {
    [_G.ConfigManager.ui_cfg.CommonAwardView.Name] = 1,
    [_G.ConfigManager.ui_cfg.RoleLevelUpView.Name] = 2,
    [_G.ConfigManager.ui_cfg.AfkLvUpPopView.Name] = 3,
    [_G.ConfigManager.ui_cfg.VIPPrivilegeUpLevelView.Name] = 4
}

local popWindowSortT = {
    _G.ConfigManager.ui_cfg.CommonAwardView.Name,
    _G.ConfigManager.ui_cfg.RoleLevelUpView.Name,
    _G.ConfigManager.ui_cfg.AfkLvUpPopView.Name,
    _G.ConfigManager.ui_cfg.VIPPrivilegeUpLevelView.Name
}

function PopWindowManager:InsertWindow(name, waitTime, ...)
    self.popFuncList = self.popFuncList or {}
    self.popFuncList[popWindowIndexT[name]] = ...
    _G.DelayDo(
        waitTime or 1,
        function()
            self:Next()
        end
    )
end

function PopWindowManager:Next()
    self.popFuncList = self.popFuncList or {}
    if not self.nowPopping then
        local count = table.count(popWindowIndexT)
        for i = 1, count do
            if self.popFuncList[i] then
                _G.UIManager:GetInstance():OpenWindow(popWindowSortT[i], self.popFuncList[i])
                self.popFuncList[i] = nil
                self.nowPopIndex = i
                self.nowPopping = true
                return
            end
        end
    end
end

function PopWindowManager:SetNowPopping(bol, index)
    self.nowPopping = bol
    self.nowPopIndex = index
end

function PopWindowManager:GetNowPopping()
    return self.nowPopping
end

---添加弹窗队列
---@param params table table<checkFun = 检测函数，OpenViewFun =执行函数>
---@param showOrder PopViewShowOrder 显示优先级
function PopWindowManager:AddPopWindowQuene(params, showOrder)
    if not self.popWindowQuene then
        self.popWindowQuene = {}
    end
    if not self.popWindowQuene[showOrder] then
        self.popWindowQuene[showOrder] = {}
    end
    ---弹窗覆盖，只存最新的
    if showOrder ~= _G.PopViewShowOrder.AwardView then
        if self.popWindowQuene[showOrder][1] then
            self.popWindowQuene[showOrder][1] = params
        else
            _G.table.insert(self.popWindowQuene[showOrder], params)
        end
    else
        _G.table.insert(self.popWindowQuene[showOrder], params)
    end

    self:CheckPopQunue()
end

---检测是否有队列
function PopWindowManager:IsPopQueueFun()
    if _G.table.isEmptyOrNil(self.popWindowQuene) then
        self.HasPopDisplayQueue = false
        return false
    end
    return true
end

---检查是否等级提升弹窗
function PopWindowManager:CheckHaveLevelPop()
    return self.popWindowQuene[_G.PopViewShowOrder.PlayerLevelUp] or self.popWindowQuene[_G.PopViewShowOrder.AfkLevelUp] or
        self.popWindowQuene[_G.PopViewShowOrder.VipLevelUp]
end

function PopWindowManager:CheckPopQunue()
    if not self:IsPopQueueFun() or self.HasPopDisplayQueue then
        return
    end

    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    self:RefreshCheckTimer()
end

---@param forceCheck boolean 强制执行弹窗
function PopWindowManager:RefreshCheckTimer(forceCheck)
    if self:IsPopQueueFun() then
        local fun, id = self:GetPopWindowQueue(true)
        if fun then
            if forceCheck or not require("AfkBattleManager"):GetInstance():IsFighting() or
                not require("AfkBattleManager"):GetInstance():ShowFighting() then
                fun, id = self:GetPopWindowQueue()
                self.HasPopDisplayQueue = true
                _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
                fun(function()
                    self.HasPopDisplayQueue = false
                    self:CheckPopQunue()
                end)
                self:StopTimerCheckOpen()
                return
            end
        else
            if _G.AppSetting.DEBUG then
                _G.Log(id, "<size=20>当前队列检测,队列函数为空</size>")
            end
        end
    end
    self.HasPopDisplayQueue = false
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowView.Name)
    self:StopTimerCheckOpen()
end

function PopWindowManager:GetPopWindowQueue(isCheck)
    local fun = nil
    local id = 0
    local count = _G.MainViewShowOrder.End

    local delIndexArr = {}
    local insert = _G.table.insert
    local remove = _G.table.remove
    for i = 1, count do
        if self.popWindowQuene[i] then
            for index, value in pairs(self.popWindowQuene[i]) do
                if value.DelFun and value.DelFun() == true then
                    insert(delIndexArr, index)
                else
                    local checkFun = value.checkFun
                    if not checkFun or checkFun() then
                        fun = value.OpenViewFun
                        id = i
                        if not isCheck then
                            insert(delIndexArr, index)
                        end
                    end
                end
                for k = #delIndexArr, 1, -1 do
                    remove(self.popWindowQuene[i], delIndexArr[k])
                end
                --赋空 防止误判
                if #self.popWindowQuene[i] == 0 then
                    self.popWindowQuene[i] = nil
                end
                if fun then
                    return fun, id
                end
            end
            delIndexArr = {}
        end
    end

    return fun, id
end

---奖励弹窗
function PopWindowManager:AddAwardPopQuene(data, callback, args)
    local popQueneFunItem = {}
    args = args or {}
    popQueneFunItem.OpenViewFun = function()
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
            data,
            function()
                self.HasPopDisplayQueue = false
                if callback then
                    callback(data)
                end
                self:CheckPopQunue()
            end,
            _G.table.unpack(args)
        )
    end
    self:AddPopWindowQuene(popQueneFunItem, _G.PopViewShowOrder.AwardView)
end

---界面关闭时调用
function PopWindowManager:OnViewClose()
    if self.HasPopDisplayQueue then
        self.HasPopDisplayQueue = false
        self:CheckPopQunue()
    end
end

---首充弹窗
function PopWindowManager:AddInitialPopQuene()
    if _G.AppSetting.IsArraigned then
        return
    end
    if _G.MainManager:GetInstance().InitInitial then
        return
    end
    if _G.PlayerPrefsManager.GetInt("FirstOpenInitialPop", 0) == 1 then
        return
    end
    if not require("InitialManager"):GetInstance():TanChuPanDuan() then
        return
    end
    local popQueneFunItem = {}
    popQueneFunItem.OpenViewFun = function(callback)
        _G.PlayerPrefsManager.SetInt("FirstOpenInitialPop", 1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.InitialView.Name)
        _G.MainManager:GetInstance().InitInitial = true
        if callback then
            callback()
        end
    end
    self:AddPopWindowQuene(popQueneFunItem, _G.PopViewShowOrder.OnePay)
end

