            local name = _G.ConfigManager.ui_cfg.OptionDialogView.Name
            if not UImanagerIns:IsActiveWindow(name) then
                _G.UIManager:GetInstance():OpenWindow(name, HandleData(data))
            else
                OpenOptionViewList[#OpenOptionViewList + 1] = data
                _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OnOptionDialogViewClose, self)
            end
        end
        _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.OptionDialogView)
