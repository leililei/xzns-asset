-----添加消息监听
function PopWindowManager:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.broadcast.Cmd, self.ReceiveScrollerData, self)
    _G.Events:GetInstance():AddListener(_G.FightPlayState.FightStart, self.ChckFightingPop, self)
    self.openToggleView = true
    self.popWindowQuene = {}
end

function PopWindowManager:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.broadcast.Cmd, self.ReceiveScrollerData, self)
    _G.Events:GetInstance():RemoveListener(_G.FightPlayState.FightStart, self.ChckFightingPop, self)
    self:StopTimerCheckOpen()
    self.popWindowQuene = {}
end

---从服务器拉取数据
function PopWindowManager:GetDataFormServer()
    self.toggleDic = {}
    self.toggleDic.t = _G.PlayerPrefsManager.GetInt(SaveToggleWindowTimeLocalKey)
    if self.toggleDic.t == nil then
        self.toggleDic.t = _G.TimeUtil.GetServerUnixTime()
        self.toggleDic.ids = {}
    else
        local curT = _G.TimeUtil.GetServerUnixTime()
        self.toggleDic.ids = _G.PlayerPrefsManager.GetTable(SaveToggleWindowIdsLocalKey)
        if _G.TimeUtil.GetInterValDayByGame(self.toggleDic.t, curT) > 0 then
            self.toggleDic.t = curT
            self.toggleDic.ids = {}
        end
    end
    base.ParseData(self)
end

-----服务器提示推送
---@param msg table 数据推送
function PopWindowManager:ReceiveScrollerData(msg)
    local tips = msg.items or {}
    for i = 1, #tips do
        self:HandleServerMsgByOne(tips[i])
    end
end

---@param _type number 1神器2饰品3魔兽4圣兽（星座）
local function GetArtifactSpiritualColorName(sid, _type)
    local cfg
    if _type == 1 then
        cfg = _G.ConfigManager.artifact_cfg[sid]
    elseif _type == 2 then
        cfg = _G.ConfigManager.spiritual_cfg[sid]
    elseif _type == 3 then
        cfg = _G.ConfigManager.pet_cfg[sid]
    elseif _G.AppSetting.IsXzns and _type == 4 then
        cfg = _G.ConfigManager.pet_xzns_cfg[sid]
    end
    if cfg then
        local order = cfg.Order or cfg.order
        if _type == 1 then
            order = order + 4
        elseif _type == 2 then
            order = order + 3
        elseif _type == 3 then
            order = order + 3
        end
        local color
        if order == 6 then     --传说
            color = "b23934"
        elseif order == 7 then --神话
            color = "b381ff"
        else
            color = "ffffff"
        end
        return _G.string.AddColor("【" .. _G.GetLangPackValue(cfg.Name or cfg.name) .. "】", color)
    end
    return "【】"
end

