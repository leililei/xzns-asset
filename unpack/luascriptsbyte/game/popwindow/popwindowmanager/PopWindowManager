        local name = _G.ConfigManager.ui_cfg.OptionInputDialogView.Name
        if not UImanagerIns:IsActiveWindow(name) then
            _G.UIManager:GetInstance():OpenWindow(name, HandleData(data))
        else
            OpenOptionViewList[#OpenOptionViewList + 1] = data
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, OnOptionDialogViewClose, self)
        end
    end
}
---增加显示通用组件显示列表
---@param id number 配置表ID
---@param content string 显示内容(如果传nil或者"" 则显示配置的content)
---@param list number[][] id,num
function PopWindowManager:ShowTableList(id, content, list, ...)
    local cfg = _G.ConfigManager.tips_system_cfg[id]
    if not cfg then
        if _G.AppSetting.DEBUG then
            if id ~= 0 then
                _G.LogError("未找到对应的提示配置 id=" .. id)
            end
        end
        return
    end
    local args = { ... }
    content =
        content or
        (#args > 0 and _G.string.format(_G.LangUtil.GetLangPackValue(cfg.content), ...) or
            _G.LangUtil.GetLangPackValue(cfg.content))
    local data = {
        cfg = cfg,
        content = content,
        list = list
    }
    showFunc[cfg.type1](self, data)
end

---显示提示(根据配置类型)
---@param id number 配置表ID
---@param content string 显示内容(如果传nil或者"" 则显示配置的content)
---@param sure function 确定按钮
---@param cancle function 取消按钮
---@param extra function|boolean 额外按钮(第三个按钮), 对于type1=5此项对应勾选框选中状态
---@param isAnimator boolean 是否播放动画
---@param ... number|string 参数
function PopWindowManager:ShowAllTips(id, content, sure, cancle, extra, isAnimator, ...)
    local cfg = _G.ConfigManager.tips_system_cfg[id]
    if not cfg then
        if _G.AppSetting.DEBUG then
            if id ~= 0 then
                _G.LogError("未找到对应的提示配置 id=" .. id)
            end
        end
        return
    end
    if #cfg.channel > 0 then
        local ChatManager = require("ChatManager"):GetInstance()
        for i = 1, #cfg.channel do
            ---@type ClintSendChatInfo
            local msg = {
                channel = cfg.channel[i],
                n_content = content or _G.LangUtil.GetLangPackValue(cfg.content),
                r_uid = 0
            }
            msg = ChatManager:GetNewChatInfo(msg)
            msg.chat.type = _G.ChatInfoType.system
            msg = ChatManager:NewChatProcess(msg)
            ChatManager:AddChatInfo(cfg.channel[i], msg)
        end
    end
    local args = { ... }
    content =
        content or
        (#args > 0 and _G.string.format(_G.LangUtil.GetLangPackValue(cfg.content), ...) or
            _G.LangUtil.GetLangPackValue(cfg.content))
    local data = {
        cfg = cfg,
        content = content,
        sure = sure,
        cancle = cancle,
        extra = extra,
        isAnimator = isAnimator
    }
    local dofun = showFunc[cfg.type1]
    if dofun then
        dofun(self, data)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(id, "tips_system_cfg配置类型异常>>>")
        end
    end
end

---显示提示(根据配置类型) 加了一个关闭二次确认框背景退出按钮的参数
---@param id number 配置表ID
---@param content string 显示内容(如果传nil或者"" 则显示配置的content)
---@param sure function 确定按钮
---@param cancle function 取消按钮
---@param extra function|boolean 额外按钮(第三个按钮), 对于type1=5此项对应勾选框选中状态
---@param isAnimator boolean 是否播放动画
---@param extendParam table 扩展参数（防止部分窗口需要新增参数，难以修改）
---@param ... number|string 参数
function PopWindowManager:ShowAllTipsExtend(id, content, sure, cancle, extra, isAnimator, extendParam, ...)
    local cfg = _G.ConfigManager.tips_system_cfg[id]
    if not cfg then
        if _G.AppSetting.DEBUG then
            if id ~= 0 then
                _G.LogError("未找到对应的提示配置 id=" .. id)
            end
        end
        return
    end
    if #cfg.channel > 0 then
        local ChatManager = require("ChatManager"):GetInstance()
        for i = 1, #cfg.channel do
            ---@type ClintSendChatInfo
            local msg = {
                channel = cfg.channel[i],
                n_content = content or _G.LangUtil.GetLangPackValue(cfg.content),
                r_uid = 0
            }
            msg = ChatManager:GetNewChatInfo(msg)
            msg.chat.type = _G.ChatInfoType.system
            msg = ChatManager:NewChatProcess(msg)
            ChatManager:AddChatInfo(cfg.channel[i], msg)
        end
    end
    local args = { ... }
    content =
        content or
        (#args > 0 and _G.string.format(_G.LangUtil.GetLangPackValue(cfg.content), ...) or
            _G.LangUtil.GetLangPackValue(cfg.content))
    local data = {
        cfg = cfg,
        content = content,
        sure = sure,
        cancle = cancle,
        extra = extra,
        isAnimator = isAnimator,
        extendParam = extendParam or {} ---扩展参数 如RelicView中使用了noBgClose = true
    }
    local dofun = showFunc[cfg.type1]
    if dofun then
        dofun(self, data)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(id, "tips_system_cfg配置类型异常>>>")
        end
    end
end

