local BtnWindowByToggleFunctionID = 46

---检测是否能弹勾选二次确认窗口
---@param id number tips_system_cfg的ID
---@param  ignoreFunctionOpen boolean 是否忽略功能开放判定
---@return boolean 是否可以弹出
function PopWindowManager:CheckToggleWindow(id, ignoreFunctionOpen)
    local show = self.openToggleView
    if not show then
        return false
    end
    if id and id > 0 then
        show = self.toggleDic and self.toggleDic.ids[id]
    end
    if show then
        return false
    end
    show = true
    if not ignoreFunctionOpen then
        show = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(BtnWindowByToggleFunctionID)
    end
    return show
end

---获取二次确认框数据data
---@param id number tips_system_cfg的ID
---@param sure function 右边边按钮的回调方法
---@param cancle function 左边边边按钮的回调方法
---@param doCall function 勾选不在提示后的回调方法(nil就调sure方法)
function PopWindowManager:GetWindowByToggleData(id, sure, cancle, doCall, ignoreFunctionOpen, ...)
