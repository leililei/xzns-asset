local base = require "OptionDialogView"
---@class OptionInputDialogView : OptionDialogView	中文描述
---@field public go_table OptionInputDialogView_GoTable GoTable
local OptionInputDialogView = _G.BaseClass("OptionInputDialogView", base)

function OptionInputDialogView:OnCreate(params)
    base.OnCreate(self, params)
    self.inputText = _G.LangUtil.GetLangPackValue(params.inputText)
    self.go_table.aortext_Placeholder.text = _G.LangUtil.GetLangPackValue(90021800411,self.inputText)
end

---按钮点击事件在这里派发
function OptionInputDialogView:OnClickBtn(go)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    if go == self.go_table.aorbtn_close then
        if self.btnLength > 1 then
        else
            if self.callbacks[1] then
                self.callbacks[1]()
            end
        end
        if self.isAnimator then
            return
        end
        _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
        if self.notCall then
            return
        end
        if self.btns[2]:GetActiveSelf() == 1 then
            if self.callbacks[2] then
                self.callbacks[2]()
            end
        elseif not self.btns[3]:GetActiveSelf() == 1 then
            if self.callbacks[1] then
                self.callbacks[1]()
            end
        end
    else
        _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
        if go == self.go_table.aorbtn_1 then
            if self.callbacks[1] then
                self.callbacks[1](self.go_table.input_Name.text == self.inputText)
            end
        elseif go == self.go_table.aorbtn_2 then
            if self.callbacks[2] then
                self.callbacks[2]()
            end
        elseif go == self.go_table.aorbtn_3 then
            if self.callbacks[3] then
                self.callbacks[3]()
            end
        elseif go == self.go_table.aorbtn_CloseView then
            if self.btns[2]:GetActiveSelf() == 1 then
                if self.callbacks[2] then
                    self.callbacks[2]()
                end
            elseif not self.btns[3]:GetActiveSelf() == 1 then
                if self.callbacks[1] then
                    self.callbacks[1]()
                end
            end
        end
    end
end

return OptionInputDialogView