local OptionDialogView = require "OptionDialogView"
---@class OptionDialogByToggleView : UIBaseView	中文描述
---@field public go_table OptionDialogByToggleView_GoTable GoTable
local OptionDialogByToggleView = _G.BaseClass("OptionDialogByToggleView", OptionDialogView)

function OptionDialogByToggleView:Awake()
    self.btnPos = {
        {_G.Vector3.New(0, -50, 0)},
        {_G.Vector3.New(130, -50, 0), _G.Vector3.New(-130, -50, 0)},
        {_G.Vector3.New(-165, -50, 0), _G.Vector3.New(0, -50, 0), _G.Vector3.New(165, -50, 0)}
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.btns = {self.go_table.aorbtn_1, self.go_table.aorbtn_2, self.go_table.aorbtn_3}
    self.btnNames = {self.go_table.aortext_Name1, self.go_table.aortext_Name2, self.go_table.aortext_Name3}
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
end

function OptionDialogByToggleView:OnCreate(params)
    OptionDialogView.OnCreate(self, params)
    self.choose = params.isOn or false
    self.go_table.toggle_choose.isOn = self.choose
    self.go_table.toggle_choose.onValueChanged:AddListener(_G.handler(self, self.OnValueChanged))
    if params.toggleDesc then
        self.go_table.aortext_togDesc.text = params.toggleDesc
    end
    if params.extendParam then 
        self.notCall = params.extendParam.notCall    
        self.cancleToggleBol = params.extendParam.cancleToggleBol
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_CloseView, false)
end

function OptionDialogByToggleView:OnValueChanged(isOn)
    self.choose = isOn
end

---按钮点击事件在这里派发
function OptionDialogByToggleView:OnClickBtn(go)
    if go == self.go_table.toggle_choose then
        return
    end
    --_G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)

    if go == self.go_table.aorbtn_1 then
        if self.callbacks[1] then
            self.callbacks[1](self.choose)
        end
    elseif go == self.go_table.aorbtn_2 then
        -- ZHJH-8525 策划要求点击空白或取消时，不记录勾选
        if self.callbacks[2] then
            if self.cancleToggleBol then 
                self.callbacks[2](self.choose)
            else 
                self.callbacks[2](false)
            end
        end
    elseif go == self.go_table.aorbtn_3 then
        if self.callbacks[3] then
            self.callbacks[3](self.choose)
        end
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        if self.notCall then
            self:Close()
            return
        end
        -- ZHJH-8525 策划要求点击空白或取消时，不记录勾选
        if self.btns[2]:GetActiveSelf() == 1 then
            if self.callbacks[2] then
                self.callbacks[2](false)
            end
        elseif not self.btns[3]:GetActiveSelf() == 1 then
            if self.callbacks[1] then
                self.callbacks[1](false)
            end
        end
    end
    self:Close()
end

---@private
function OptionDialogByToggleView:EscClose()
    _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, false, 0.2, _G.handler(self, self.Close))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.jiemianTopAuido)
    if self.callbacks[1] then
        self.callbacks[1](self.choose)
    end
end

return OptionDialogByToggleView
