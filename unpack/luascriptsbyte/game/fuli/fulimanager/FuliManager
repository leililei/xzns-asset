---@class FuliManager	中文描述
local FuliManager = _G.BaseClass("FuliManager", _G.Singleton)
_G.FuliManager = FuliManager

local ModelInstance = {
    {model = require "DailyDeliveryModel":GetInstance(), funcName = "CheckIsOver"},
    {model = require "LevelActivityModel":GetInstance(), funcName = "CheckIsFinish"},
    {model = require "WeekSigninModel":GetInstance(), funcName = "CheckActivityFinish"},
    {model = require "RecordTotalZhaomuModel":GetInstance(), funcName = "CheckIsOver"}
}
---初始化活动开始
function FuliManager:InitActivityOpen()
    for _, v in pairs(ModelInstance) do
        if v.model[v.funcName] and not v.model[v.funcName](v.model) then
            return true
        end
    end
    return false
end

return FuliManager
