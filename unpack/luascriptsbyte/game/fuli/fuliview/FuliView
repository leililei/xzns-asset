        view.viewName,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
    )
    view.transform:SetParentE(self.go_table.obj_view)
    view.transform:SetAsLastSiblingE()
end

function FuliView:RefreshRedPoint(id)
    local model = require "CycleBattlePassModel":GetInstance()
    if model.BattlePassIDEnum.Abyss == id or model.BattlePassIDEnum.Arena == id then
        if self.ActivityList then
            for _, activityItem in pairs(self.ActivityList) do
                if activityItem and activityItem.data and activityItem.data.isBattlePass then
                    activityItem:InitRedPoint()
                    break
                end
            end
        end
    end
end

function FuliView:InitActivityItem()
    if _G.table.isEmptyOrNil(self.ActivityData) then
        return
    end
    local isFund = false
    if #self.ActivityData > 4 then
        self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter)).enabled = true
    end
    for k, v in pairs(self.ActivityData) do
        local activityItem
        if v.ActivityID ~= 1011001 and v.ActivityID ~= 1011101 then
            local obj = _G.InstantiateObject(self.go_table.obj_ActivityTab, self.go_table.obj_Content)
            activityItem = self:GetComponent(obj, ActivityItem)
            if activityItem == nil then
                activityItem = self:AddComponent(obj, ActivityItem.New(obj, v))
                if _G.table.ContainsValue(BattlePassId, v.ActivityID) then
                    activityItem:SetMultiData(self.battlePassData)
                end
            end
            _G.table.insert(self.ActivityList, activityItem)
        else
            -- ZHJH-2064 成长基金和降临基金合并
            if not isFund then
                isFund = true
                local activityItem
                local obj = _G.InstantiateObject(self.go_table.obj_ActivityTab, self.go_table.obj_Content)
                v.Icon = "ImagesH5/nFuli/ui_fl_jijin_n_icon"
                v.Icon2 = "ImagesH5/nFuli/ui_fl_jijin_c_icon"
                activityItem = self:GetComponent(obj, ActivityItem)
                if activityItem == nil then
                    activityItem = self:AddComponent(obj, ActivityItem.New(obj, v))
                    if _G.table.ContainsValue(BattlePassId, v.ActivityID) then
                        activityItem:SetMultiData(self.battlePassData)
                    end
                end
                _G.table.insert(self.ActivityList, activityItem)
            end
        end
    end

    local openByIndex = (self.Index ~= nil) or (self.JumpActivityId ~= 0)
    for i = 1, #self.ActivityList do
        if not openByIndex then
            if self.ActivityList[i].State == ActivityState.Open then
                self.ActivityList[i]:DoActivityBtn()
                break
            end
        elseif self.JumpActivityId ~= 0 then
            if self.ActivityList[i].ActivityID == self.JumpActivityId then
                self.ActivityList[i]:DoActivityBtn()
                break
            end
        elseif self.ActivityList[i].index == self.Index then
            self.ActivityList[i]:DoActivityBtn()
            break
        end
    end
    self.go_table.obj_ActivityTab:SetActiveE(0)
end

function FuliView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
end

function FuliView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(BroadcastEnum.ItemUiOpened, self.OnUIOpen, self)
    _G.Events:GetInstance():RemoveListener(_G.BattlePassExpEvents.RefreshRedPoint, self.RefreshRedPoint, self)
    for k, v in pairs(self.ActivityList) do
        v:OnDispose()
    end
    self.ActivityList = nil
    self.ActivityData = nil
    self.Index = nil
    if not self.onlyClose then 
        --MainView返回上一个页签
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView and _G.MainManager:GetInstance():IsToggledBenefitWindow(false) then
            mainView:BackBeforeToggle()
        end
    end
end

return FuliView
