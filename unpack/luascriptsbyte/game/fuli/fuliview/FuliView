local ActivityState = {
    Close = 1,
    Notice = 2,
    Open = 3,
    Settlement = 4
}
local BroadcastEnum = {
    ItemChanged = "ActivityItemChanged",
    ItemUiOpened = "ActivityItemUiOpened"
}
local GetLangPackValue = _G.LangUtil.GetLangPackValue
local ActivitySynManager = require "ActivitySynManager"
---@class ActivityItem : Component	中文描述
local ActivityItem = _G.BaseClass("ActivityItem", _G.Component)
function ActivityItem:__init(obj, data)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnActivityBtnClick))
    _G.Events:GetInstance():AddListener(BroadcastEnum.ItemChanged, self.OnItemClick, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUiOpenCall, self)
    obj:SetName(data.Index)
    self:InitData(data)
    --local id = self.ActivityTypeCls:GetRedpointIDByIndex(1)
    --if id then
    --    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.ActivityTypeCls:GetRedpointIDByIndex(1))
    --end

    self:InitRedPoint()
    self.go_table.aortext_name.text = data.Name
    self.go_table.aortext_nameOn.text = data.Name

    local icon1 = not _G.string.IsNullOrEmpty(data.Icon) and data.Icon or nil
    if icon1 then
        self.go_table.aorrawimage_icon1:LoadImage(
            icon1,
            function(img)
                if _G.IsNil(img) then
                    return
                end
                img:SetNativeSize()
            end
        )
    end
    local icon2 = not _G.string.IsNullOrEmpty(data.Icon2) and data.Icon2 or icon1
    if icon2 then
        self.go_table.aorrawimage_icon2:LoadImage(
            icon2,
            function(img)
                if _G.IsNil(img) then
                    return
                end
                img:SetNativeSize()
            end
        )
    end
end

function ActivityItem:InitData(data)
    if data.Cls and not data.IsNormal then
        self.ActivityClass = data.Cls
        self.ActivityClass:AddStateChanged(self.OnStateChanged, self)
    end
    self.Type = data.Type
    self.ViewName = data.ViewName
    self.ActivityID = data.ActivityID
    self.Index = data.Index
    self.index = data.index
    self.State = data.State
    self.ActivityTypeCls = data.TypeCls
    self.IsNormal = data.IsNormal
    self.data = data
end

function ActivityItem:InitRedPoint()
    self.go_table.obj_redpoint:SetActiveE(self.data.isBattlePass and 0 or 1)
    if self.data and self.data.isBattlePass then
        local model = require "CycleBattlePassModel":GetInstance()
        if model:CheckeRedPoint(model.BattlePassIDEnum.Abyss) == 1 or model:CheckeRedPoint(model.BattlePassIDEnum.Arena) == 1 then
            self.go_table.obj_battlePassredpoint:SetActiveE(1)
        else
            self.go_table.obj_battlePassredpoint:SetActiveE(0)
        end
    else
        self.go_table.obj_battlePassredpoint:SetActiveE(0)
        if self.IsNormal then
        else
            local redPointId = self.ActivityTypeCls:GetRedpointIDByIndex(1)
            if redPointId then
                self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(redPointId)
            else
                self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(0)
            end
        end 
    end
end

function ActivityItem:OnStateChanged(state)
    self.State = state
end

function ActivityItem:OnDispose()
    if self.co_open then
        _G.coroutine.stopwaiting(self.co_open)
    end
    if self.ActivityClass and not self.IsNormal then
        self.ActivityClass:RemoveStateChanged(self.OnStateChanged, self)
        self.ActivityClass = nil
    end
    if self.View then
        if self.View.CloseView then
            self.View:CloseView()
        else
            self.View:Close()
        end
        self.View = nil
    end
    self.Index = nil
    self.index = nil
    self.State = nil
    _G.Events:GetInstance():RemoveListener(BroadcastEnum.ItemChanged, self.OnItemClick, self)
end

function ActivityItem:OnItemClick(viewName, index)
    if self.index ~= index then
        self.isCur = false
    end
    if self.ViewName ~= viewName then
        if self.View then
            self.View:Hide()
            if self.ViewName == _G.ConfigManager.ui_cfg.SuperValuGiftView.Name then
                self.View:UpdateRedPoint()
            end
        end
    else
        -- end
        --     if self.View then
        --         if self.View.InitView then
        --             self.View:InitView(self.ActivityClass)
        --         end
        if self.View then
            self.View:Show()
        end
        if viewName == _G.ConfigManager.ui_cfg.OneChongZhiView.Name then
            self.View:ShowUIEffect()
        elseif viewName == _G.ConfigManager.ui_cfg.HeroMegganView.Name then
            self.View:ShowUIEffect()
        elseif viewName == _G.ConfigManager.ui_cfg.SuperValuGiftView.Name then
            self.View:UpdateRedPoint()
        end
    end
    self.go_table.aorimage_isOn:SetActiveE(self.index == index and 1 or 0)
    self.go_table.aorimage_isOff:SetActiveE(self.index ~= index and 1 or 0)
end

function ActivityItem:DoActivityBtn()
    if not self.isCur then
        if
            self.State == ActivityState.Close or self.State == ActivityState.Settlement or
                self.State == ActivityState.Notice
         then
            if not self.IsNormal then
                self.ActivityClass:CheckActivityInteractable()
            end
            return
        end
        self.isCur = true
        if not self.View then
            if self.IsNormal then
                _G.UIManager:GetInstance():OpenWindow(self.ViewName)
            elseif self.data.isBattlePass then
                _G.UIManager:GetInstance():OpenWindow(self.ViewName, self.multiData)
            elseif self.Type == 1 then
                self.ActivityClass:EnterActivity()
            elseif self.Type == 2 then
                self.ActivityTypeCls:EnterActivity()
            end
            self.co_open =
                _G.coroutine.start(
                function()
                    local view = _G.UIManager:GetInstance():GetWindow(self.ViewName)
                    while (_G.IsNil(view.View.gameObject)) do
                        _G.coroutine.yield()
                    end
                    _G.Events:GetInstance():Broadcast(BroadcastEnum.ItemChanged, self.ViewName, self.index)
                end
            )
        else
            _G.Events:GetInstance():Broadcast(BroadcastEnum.ItemChanged, self.ViewName, self.index)
            if self.View.InitView then
                self.View:InitView(self.ActivityClass, self.ActivityClass.typeClass.type_num)
            end
        end
    end
end

function ActivityItem:OnActivityBtnClick()
    _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)

    self:DoActivityBtn()
end

function ActivityItem:OnUiOpenCall(name)
    if self.IsNormal then
        if name == self.ViewName then
            self:SetView(name)
        end
    elseif self.data.isBattlePass then
        if name == self.ViewName then --两个if一定要分开
            self:SetView(name)
        end
    elseif name == self.ActivityTypeCls:OnGetMainViewName() then
        self:SetView(name)
    end
end

function ActivityItem:SetView(name)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUiOpenCall, self)
    self.View = _G.UIManager:GetInstance():GetWindowCtrl(name)
    _G.Events:GetInstance():Broadcast(BroadcastEnum.ItemUiOpened, self.View)
end

---多个活动数据
function ActivityItem:SetMultiData(MultiData)
    self.multiData = MultiData
end

local BattlePassId = {1012001, 1012101, 1012201}

---常驻活动id
local NormalActivityId = {
    1013008
}

local NormalCls = {
    [1013008] = "MonthlyModel"
}

---@class FuliView : UIBaseView	中文描述
---@field public go_table FuliView_GoTable GoTable
local FuliView = _G.BaseClass("FuliView", _G.UIBaseView)
function FuliView:Awake()
    _G.Events:GetInstance():AddListener(BroadcastEnum.ItemUiOpened, self.OnUIOpen, self)
    _G.Events:GetInstance():AddListener(_G.BattlePassExpEvents.RefreshRedPoint, self.RefreshRedPoint, self)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data activityPagesInfoTab
function FuliView:OnCreate(data, index, jumpActivityId, isSingle, onlyClose)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.FuliView .. "Tab", _G.GetAutoGoTable(self.go_table.obj_ActivityTab))
    self.ActivityList = {}
    self.JumpActivityId = jumpActivityId or 0
    self.Index = index or 1
    self.onlyClose = onlyClose
    self:ParseData(data)
    -- self:AddNormalData()
    _G.SortList(
        self.ActivityData,
        function(a)
            return -a.Index, a.ActivityID
        end
    )
    for i = 1, #self.ActivityData do
        self.ActivityData[i].index = i
    end
    self:InitActivityItem()
end

function FuliView:ParseData(data)
    local IgnoreId = require("ActivitySynEnterManager"):GetInstance().ignorePage ---特殊处理不展示的活动id，灵脉战令移至日常
    local hasBattlePass = false
    self.UIList = {}
    self.ActivityData = {}
    self.battlePassData = {}
    if data then
        local _, _, index = 0
        ---解析活动框架数据
        for i = 1, #data do
            local _data = {}
            local v = data[i]
            ---type ==1 活动
            _data.ActivityID = v.activityID
            _data.Cls = v
            _data.Icon, _data.Name, _data.Icon2 = v:GetShowBtnInfo()
            _, _, index = v:GetShowBtnType()
            ---序号
            _data.Index = index or i
            ---活动位置索引
            _data.index = index or i
            _data.ViewName = v:GetGameMainViewName()
            -- _data.view = nil
            _data.State = v.curState
            _data.TypeCls = v:GetActivityTypeCls()
            -- 特训特殊进入 在额外条件未通过时 不能进入特训子界面
            _data.Type = _data.TypeCls.isTrain and 2 or 1
            for k, id in pairs(NormalActivityId) do
                if id == v.activityID then
                    _data.IsNormal = true
                    _data.Cls = require(NormalCls[id])
                    _data.ViewName = _data.Cls:GetInstance():GetGameMainViewName()
                end
            end
            if _data.TypeCls:IsShowInFuliView() then
                if not IgnoreId[v.activityID] then
                    if _G.table.ContainsValue(BattlePassId, v.activityID) then
                        if not hasBattlePass then
                            local tempData = _G.DeepCopy(_data)
                            tempData.Name = _G.GetLangPackValue(9002090013) --活动战令
                            tempData.ViewName = _G.ConfigManager.ui_cfg.CycleBattlePassToggleView.Name
                            tempData.isBattlePass = true
                            _G.table.insert(self.ActivityData, tempData)
                            hasBattlePass = true
                        end
                        _G.table.insert(self.battlePassData, _data)
                    elseif v.activityID == 1012501 or v.activityID == 1012601 then
                        -- 拉新活动根据渠道开启
                        if _G.table.ContainsValue(_G.ConfigManager.discrete_cfg[v.activityID == 1012501 and 100316 or 100317][1], _G.GameUtil:GetPlatform()) then
                            _G.table.insert(self.ActivityData, _data)
                        end
                    else
                        if not v.curState or v.curState ~= require("ActivitySynManager"):GetInstance().State.Close then
                            _G.table.insert(self.ActivityData, _data)
                        end
                    end
                end
            end
        end
    end
end

---添加常驻功能
function FuliView:AddNormalData()
    local _data
    for k, v in pairs(NormalCls) do
        _data = {}
        _data.ActivityID = v
        _data.Cls = require(v)
        _data.Icon, _data.Name, _data.Icon2 = _data.Cls:GetInstance():GetShowBtnInfo()
        ---序号
        _data.Index = k
        ---活动位置索引
        _data.index = k
        _data.ViewName = _data.Cls:GetInstance():GetGameMainViewName()
        _data.State = ActivityState.Open
        _data.IsNormal = true
        _G.table.insert(self.ActivityData, _data)
    end
end

function FuliView:OnUIOpen(view)
    -- local canvas = view.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    -- canvas.sortingOrder = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1

