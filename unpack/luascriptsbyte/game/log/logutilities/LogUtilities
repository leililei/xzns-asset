require "Debug"

-- 模块名
local EModuleNameSource = {
    "TaskModule",
    "StoryModule",
    "HudModule"
}

---@class EModuleName @模块名
---@field TaskModule number @任务模块名
---@field StoryModule number @剧情模块名
---@field HudModule number @Hud模块名
_G.EModuleName = _G.CreatEnumTable(EModuleNameSource)

-- 主要用于封装一层Log，支持各大模块独立的Log开关控制
---@class LogUtilities @Log工具类
---@field public ModuleLogSwitchMap table<EModuleName, boolean> @模块Log开关映射Map(Key为模块名)
local LogUtilities = {}
LogUtilities.ModuleLogSwitchMap = {}

---Log工具初始化
function LogUtilities.Init()
    for k, modulename in pairs(_G.EModuleName) do
        LogUtilities.ModuleLogSwitchMap[modulename] = false
        --
        if _G.AppSetting.DEBUG then
            _G.Log(string.format("模块名:%s Log开关初始化:%s", modulename, LogUtilities.ModuleLogSwitchMap[modulename]))
        end
    end
end

--Log工具初始化
LogUtilities.Init()

---region Log相关方法
---切换模块Log开关
---@param modulename EModuleName @模块名
function LogUtilities.ChangeSwitchModuleLog(modulename)
    assert(modulename, "不允许传空模块名!")
    if LogUtilities.ModuleLogSwitchMap[modulename] ~= nil then
        LogUtilities.ModuleLogSwitchMap[modulename] = not LogUtilities.ModuleLogSwitchMap[modulename]
        print(string.format("切换模块名:%s的Log开关到:%s", modulename, LogUtilities.ModuleLogSwitchMap[modulename]))
    else
        print(string.format("找不到模块名:%s开关!", modulename))
    end
end

---@param modulename EModuleName @模块名
---@param context string 内容
---@param description string 说明
function LogUtilities.Log(modulename, context, description)
    if LogUtilities.ModuleLogSwitchMap[modulename] == true then
        if _G.AppSetting.DEBUG then
            _G.Log(context, description)
        end
    end
end

---@param modulename EModuleName @模块名
---@param context string 内容
---@param description string 说明
function LogUtilities.LogWarning(modulename, context, description)
    if LogUtilities.ModuleLogSwitchMap[modulename] == true then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(context, description)
        end
    end
end

---@param modulename EModuleName @模块名
---@param context string 内容
---@param description string 说明
function LogUtilities.LogError(modulename, context, description)
    if LogUtilities.ModuleLogSwitchMap[modulename] == true then
        if _G.AppSetting.DEBUG then
            _G.LogError(context, description)
        end
    end
end

---@param modulename EModuleName @模块名
-- @param value table 内容
-- @param description string 描述
-- @param nesting int 深度
function LogUtilities.dump(modulename, value, description, nesting)
    if LogUtilities.ModuleLogSwitchMap[modulename] == true then
        _G.dump(value, description, nesting)
    end
end
---endregion

---@type LogUtilities @Log工具类
_G.LogUtilities = LogUtilities
---@type LogUtilities @Log工具类
return LogUtilities
