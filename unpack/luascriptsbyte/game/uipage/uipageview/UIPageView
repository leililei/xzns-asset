local CS = _G.CS
local typeof = _G.typeof

--region toggleitemclass
local ToggleItem = _G.BaseClass("ToggleItem", _G.IRecycle)
function ToggleItem:OnInit(index, trans, onChoose)
    self.gameObject = trans
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    self.index = index
    self.onChoose = onChoose
    trans:SetName(_G.tostring(index))
    self.go_table.toggle_com.onValueChanged:AddListener(_G.handler(self, self.OnValueChanged))
end
function ToggleItem:SetName(name)
    self.go_table.aortext_downDesc.text = name
    self.go_table.aortext_togDesc.text = name
end
function ToggleItem:SetGroup(group)
    self.go_table.toggle_com.group = group
end
function ToggleItem:SetRedPointParam(id)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(id)
end
function ToggleItem:OnValueChanged(isOn)
    if isOn and self.onChoose then
        self.onChoose(self.index)
    end
end
function ToggleItem:SetIsOn(isOn)
    self.go_table.toggle_com.isOn = isOn
end
function ToggleItem:Dispose()
    self.go_table.toggle_com.onValueChanged:RemoveAllListeners()
    self.go_table.toggle_com.isOn = false
    self.gameObject:DestroyObject()
    _G.ObjectPool:GetInstance():Push(self)
end
--endregion

---@class UIPageView : UIBaseView	中文描述
---@field public go_table UIPageView_GoTable GoTable
local UIPageView = _G.BaseClass("UIPageView", _G.UIBaseView)

local togglePath1 = "UI/Common/PageView/$_toggle_com"

function UIPageView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    _G.Events:GetInstance():AddListener(_G.eShenshiEvents.OtherOnclick, self.OtherBtnClick_Events, self)
end

---界面的入口函数
function UIPageView:OnCreate(id, view)
    if _G.type(id) == "table" then
        view = id[2]
        id = id[1]
    elseif _G.type(id) == "string" then
        id = _G.tonumber(id)
    end
    self.cfg = _G.ConfigManager.ui_page_cfg[id]
    self.go_table.aorrawimage_tag:LoadImage(self.cfg.Name)
    view = view or self.cfg.Views[1]
    self.curToggleIndex = 0
    local index = 1
    if not _G.string.IsNullOrEmpty(view) then
        for i = 1, #self.cfg.Views do
            if self.cfg.Views[i] == view then
                index = i
                self:InitToggle(i)
                break
            end
        end
    end

    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
    _G.AudioManager.PlayAudioByAudioCfgID(self.cfg.Music)
end
function UIPageView:OnDisable()
    _G.Events:GetInstance():RemoveListener(_G.eShenshiEvents.OtherOnclick, self.OtherBtnClick_Events, self)
    _G.UIManager:GetInstance():HideWindow(self.cfg.Views[self.curToggleIndex])
end

function UIPageView:OnEnable()
    if self.curToggleIndex > 0 then
        _G.UIManager:GetInstance():ShowWindow(self.cfg.Views[self.curToggleIndex])
    end
end

function UIPageView:OnDestroy()
    for i = 1, #self.toggles do
        self.toggles[i]:Dispose()
    end
    self.toggles = nil
end
---按钮点击事件在这里派发
function UIPageView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        for i = 1, #self.cfg.Views do
            _G.UIManager:GetInstance():CloseWindow(self.cfg.Views[i])
        end
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        self:Close()
    end
end

function UIPageView:InitToggle(choose)
    self.toggles = {}
    local index = 1
    local createToggle
    createToggle = function()
        _G.PoolsManager:GetInstance():Spawn(
            togglePath1,
            _G.ePoolType.Temporary,
            self.go_table.togglegroup_Content,
            function(trans)
                self.toggles[index] =
                    _G.ObjectPool:GetInstance():Pop(ToggleItem, index, trans, _G.handler(self, self.OnToggleSelect))
                self.toggles[index]:SetGroup(self.go_table.togglegroup_Content)
                self.toggles[index]:SetName(_G.LangUtil.GetLangPackValue(self.cfg.Pages[index]))
                self.toggles[index]:SetRedPointParam(self.cfg.RedPointID[index] or 0)
                if not _G.FunctionManager:GetInstance():CheckIsDisplay(self.cfg.FunctionID[index], trans) then
                    trans:SetActiveE(0)
                else
                    trans:SetActiveE(1)
                end
                index = index + 1
                if index <= #self.cfg.Pages then
                    createToggle()
                else
                    self:InitToggleDone(choose)
                end
            end
        )
    end
    createToggle()
end
function UIPageView:InitToggleDone(choose)
    for i = 1, #self.toggles do
        self.toggles[i]:SetIsOn(i == choose)
    end
end
function UIPageView:OnToggleSelect(index)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.pageSwitchAuido)
    if self.curToggleIndex == index then
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_panelshadow, 1)
    self.nextPageIndex = index
    local window = _G.UIManager:GetInstance():GetWindow(self.cfg.Views[index])
    if window then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIShow, self.CoSetViewParent, self)
        _G.UIManager:GetInstance():ShowWindow(self.cfg.Views[index])
    else
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.CoSetViewParent, self)
        _G.UIManager:GetInstance():OpenWindow(
            self.cfg.Views[index],
            self.go_table.trans_background,
            _G.handler(self, self.OnViewShowDone)
        )
    end
end
function UIPageView:CoSetViewParent(name)
    if name == self.cfg.Views[self.nextPageIndex] then
        if self.curToggleIndex > 0 then
            _G.UIManager:GetInstance():HideWindow(self.cfg.Views[self.curToggleIndex])
        end
        self.curToggleIndex = self.nextPageIndex
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        if not view.transform:GetParent() or view.transform:GetParent():GetName() ~= self.go_table.trans_panel.name then
            view.transform:SetParentE(self.go_table.trans_panel)
        end
        view.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder =
            self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 50
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.CoSetViewParent, self)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIShow, self.CoSetViewParent, self)
    end
end
function UIPageView:OnViewShowDone()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_panelshadow, false)
end

--region 事件过来
function UIPageView:OtherBtnClick_Events(flag)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_panelshadow, flag)
end
--endregin
return UIPageView
