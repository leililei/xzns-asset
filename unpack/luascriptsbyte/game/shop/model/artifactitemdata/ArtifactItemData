---@class ArtifactItemData	中文描述
local ArtifactItemData = _G.BaseClass("ArtifactItemData", _G.BaseItemData)
local CS = _G.CS
local typeof = _G.typeof
function ArtifactItemData:Init()
end

---类的构造函数
function ArtifactItemData:__init(index)
    self.index = index
end

---道具数据解析(类重写数据解析)
---@param msg prop.NormalProp 物品PB数据
function ArtifactItemData:Parse(msg)
    self.sid = msg.sid or msg.good_id

    self.BuyTime = msg.buy_times or msg.buyTime or 0
    self.cfg = msg
    local cfg = _G.ConfigManager.artifact_shop_cfg[self.sid]
    if cfg then
        self.count = cfg.get_item[2]
        self.discount = 0
        self.price = cfg.need_item[2]
        self.cfg.currency_type = cfg.need_item[1]
        self.cfg.price = cfg.need_item[2]
        -- self.Order = self.cfg.order or self.cfg.Order
        self.Restrict = cfg.restrict
        self.tag = cfg.tag or 0

        self.limit = cfg.count_limit
        local itemdata = _G.StorageManager:GetInstance():GetStorageItemData(cfg.get_item[1])
        if itemdata ~= nil then
            self.ItemCfg = itemdata.Cfg
            self.name = itemdata.name
            self.Icon = itemdata.Icon
            self.Grade = itemdata.Grade
        end

        itemdata = _G.StorageManager:GetInstance():GetStorageItemData(cfg.need_item[1])
        if itemdata ~= nil then
            self.currencyIcon = itemdata.Icon
        end
    end
end

---类的析构函数
function ArtifactItemData:Dispose()
end

return ArtifactItemData
