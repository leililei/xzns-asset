---@class ShopItemData:BaseItemData	道具类
---@field RefreshTime number 商品下次刷新时间（秒）
---@field RefreshType number 商品刷新类型
local ShopItemData = _G.BaseClass("ShopItemData", _G.BaseItemData)
local base = _G.BaseItemData
local ShopModel = require "ShopModel":GetInstance()

function ShopItemData:Init()
end
function ShopItemData:__init(index)
    self.index = index
    self.HasItemRefresh = false
    self.RefreshTime = 0
end

---道具数据解析(类重写数据解析)
---@param msg prop.NormalProp 物品PB数据
---@param ShopID number 物品PB数据
function ShopItemData:Parse(msg, ShopID)
    self.sid = msg.sid or msg.good_id

    self.BuyTime = msg.buy_times or msg.buyTime or 0
    self.sp = msg.sp
    self.cfg = _G.ConfigManager.shop_pools_cfg[self.sid]
    local goods1
    local goods2
    if ShopID then
        goods1 = _G.ConfigManager.shop_list_cfg[ShopID] and _G.ConfigManager.shop_list_cfg[ShopID].goods1 or {}
        goods2 = _G.ConfigManager.shop_list_cfg[ShopID] and _G.ConfigManager.shop_list_cfg[ShopID].goods2 or {}
    end
    if self.cfg then
        self.count = self.cfg.item[2]
        self.discount = self.cfg.discount * 0.001
        self.price = self.cfg.price
        local StorageType = _G.StorageManager:GetInstance():CheckSidType(self.cfg.item[1])

        local itemdata = _G.StorageManager:GetInstance():GetStorageItemData(self.cfg.item[1])
        if itemdata ~= nil then
            self.ItemCfg = itemdata.Cfg
            self.name = itemdata.name
            self.Icon = itemdata.Icon
            self.Grade = itemdata.Grade
        end

        itemdata = _G.StorageManager:GetInstance():GetStorageItemData(self.cfg.currency_type)
        if itemdata ~= nil then
            self.currencyIcon = itemdata.Icon
        end
        self.limit = 1
        if self.sp then
            if not _G.table.isEmptyOrNil(goods2) then --good2配置了 good1配置必须为null，两者只能同时配置一个
                for i = 1, #goods2 do
                    if goods2[i][1] == self.sid then
                        self.limit = goods2[i][2] or 1
                        self.RefreshTime = ShopModel:GetGoodNextRefreshTime(goods2[i][3],goods2[i][4])
                        self.RefreshType = goods2[i][3]
                        self.HasItemRefresh = true
                        break
                    end
                end
            else
                if not _G.table.isEmptyOrNil(goods1) then
                    for i = 1, #goods1 do
                        if goods1[i][1] == self.sid then
                            self.limit = goods1[i][2] or 1
                            break
                        end
                    end
                else
                    _G.LogError("ShopID参数或者特殊商品栏配置有问题")
                end
            end
        end
        self.conditions = self.cfg.conditions or {}
    end
end

---商品能否刷新
---@return boolean
function ShopItemData:CanRefresh()
    if self.HasItemRefresh then
        local left = self.RefreshTime - _G.TimeUtil.GetServerUnixTime()
        --if left <= 86400 then
        --    LogError("剩余时间"  .. left)
        --end
        return left <= 0
    end
    return false
end


---@return string 商店限购tips
function ShopItemData:GetLimitTip()
    local str  = ""
    if self.RefreshType == 1 then
        --每日限购
        str = _G.GetLangPackValue(90021800098)
    elseif self.RefreshType == 2 then
        --每月限购
        str = _G.GetLangPackValue(22290000132)
    elseif self.RefreshType == 3 then
        str = _G.GetLangPackValue(22290000133)
    end
    return str
end

---类的析构函数
function ShopItemData:Dispose()
    self.HasItemRefresh = nil
    self.RefreshType = nil
end

return ShopItemData
