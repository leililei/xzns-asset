---@class SeasonShopItemData:BaseItemData	中文描述
local SeasonShopItemData = _G.BaseClass("SeasonShopItemData", _G.BaseItemData)
local base = _G.SeasonShopItemData

function SeasonShopItemData:Init()
end

function SeasonShopItemData:__init(index)
    self.index = index
end

---道具数据解析(类重写数据解析)
---@param msg prop.NormalProp 物品PB数据
function SeasonShopItemData:Parse(data)
    if data then
        self.sid = data.id
        self.BuyTime = 0
        self.discount = (data.discount or 0) * 0.001
        self.count = data.get_item[2]
        self.price = data.need_item[2]
        self.limit = data.count_limit
        self.condition = data.condition_limit
        self.cfg = {}
        self.cfg.currency_type = data.need_item[1]
        self.cfg.price = data.need_item[2]
        self.Order = data.order or data.Order
        --self.Restrict = data.restrict
        ---解锁（暂时只有巅峰演武有
        self.Restrict = data.restrict
        self.tag = data.tag or 0
        local StorageType = _G.StorageManager:GetInstance():CheckSidType(data.get_item[1])
        local itemdata = _G.StorageManager:GetInstance():GetStorageItemData(data.get_item[1])
        if itemdata ~= nil then
            self.ItemCfg = itemdata.Cfg
            self.name = itemdata.name
            self.Icon = itemdata.Icon
            self.Grade = itemdata.Grade
        end

        itemdata = _G.StorageManager:GetInstance():GetStorageItemData(data.need_item[1])
        if itemdata ~= nil then
            self.currencyIcon = itemdata.Icon
        end
    end
end

---类的析构函数
function SeasonShopItemData:Dispose()
end

return SeasonShopItemData
