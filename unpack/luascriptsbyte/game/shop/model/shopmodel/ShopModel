---检查商店商品是否已解锁
---@param shopId number 商店ID
---@param data ShopItemData
---@param getTip boolean 获取tip信息
---@return boolean,string
function ShopModel:CheckShopItemUnlock(shopId, data, getTip)
    if shopId ~= 7 and shopId ~= 9 or not data.Restrict or not data.Restrict[1] then
        return true, nil
    end

    ---@type boolean,string
    local isLock, tip = false
    if data.Restrict[1][1] == 2 then
        local nowChpater = require("AfkModel"):GetInstance():GetCurAfkChapter() or 1
        if data.Restrict[1][2] <= nowChpater then
            isLock = true
            if getTip then
                local afk = _G.ConfigManager.afk_cfg[data.Restrict[1][2]]
                tip = _G.GetLangPackValue(90029400059, afk.chapter, afk.section)
            end
        end
    elseif data.Restrict[1][1] == 1 then
        local achieve, ConfigManager =
            require("ArenaPeakModel"):GetInstance():GetAchieveDan(data.Restrict[1][2])
        if not achieve then
            isLock = true
            if getTip then
                tip = _G.GetLangPackValue(90029400098, _G.GetLangPackValue(ConfigManager.name))
            end
        end
    elseif data.Restrict[1][1] == 3 then
        local achieve =
            require("ArenaPeakModel"):GetInstance().seasonStartTime or _G.TimeUtil.GetServerUnixTime()
        local num = _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(), achieve)
        if data.Restrict[1][2] - num > 0 then
            isLock = true
            if getTip then
                tip = _G.GetLangPackValue(90029400066, data.Restrict[1][2] - num)
            end
        end
    elseif data.Restrict[1][1] >= 4 and data.Restrict[1][1] <= 6 then --问鼎灵域历史参与段位
        local achieve, cfg = require("SpiritualRealmModel"):GetInstance():CheckHistoryRank(data.Restrict[1])
        if not achieve then
            isLock = true
            if getTip then
                tip = _G.GetLangPackValue(90029400098, _G.GetLangPackValue(90030700000 + data.Restrict[1][1] - 3))
            end
        end
    end

    return not isLock, tip
end

