---商店计时器每一秒进行刷新 检测是否有需要刷新的商店数据
function ShopModel:UpdateTime()
    local needGetDataIds = {}
    for k, v in pairs(self.shop) do
        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg[v.sid].function_open) then
            if v.sid ~= 6 and v.sid ~= 7 and v.sid ~= 9 then
                if v.time + v.interval_time - _G.TimeUtil.GetServerUnixTime() < 0 then
                    _G.table.insert(needGetDataIds, v.sid)
                end
            end
            if v.spInterval_time > 0 and v.spTime then
                if v.spTime + v.spInterval_time - _G.TimeUtil.GetServerUnixTime() < 0 and not _G.table.ContainsValue(needGetDataIds, v.sid) then
                    _G.table.insert(needGetDataIds, v.sid)
                end
            end

            -- 在现有商店级刷新检测后，新增商品级刷新检测
            -- 检测特殊商品的商品级刷新
            ---@type ShopItemData[]
            local spItemList = v.SPitem
            if spItemList then
                for _, itemData in ipairs(spItemList) do
                    if itemData:CanRefresh() then
                        -- 该商品需要刷新，加入请求队列
                        if not _G.table.ContainsValue(needGetDataIds, v.sid) then
                            _G.table.insert(needGetDataIds, v.sid)
                        end
                        break  -- 该商店已加入队列，跳过其他商品检测
                    end
                end
            end
        end
    end
    if #needGetDataIds > 0 then
        for i = 1, #needGetDataIds do
            local msg = { shop_id = needGetDataIds[i] }
            if self.InitParseList[needGetDataIds[i]] == nil then
                self.InitParseList[needGetDataIds[i]] = true
            end
            if self.InitParseList[needGetDataIds[i]] then
                self.InitParseList[needGetDataIds[i]] = false
                ShopNet:GetInstance():GetShopInfo(msg, _G.handlerbind(self, self.InitUpdateParseData, needGetDataIds[i]))
            end
        end
    end
end

function ShopModel:InitUpdateParseData(data, ShopID, idIs)
    if idIs then
        if self.InitParseList[idIs] == nil or self.InitParseList[idIs] == false then
            self.InitParseList[idIs] = true
        end
    end
    if _G.table.isEmptyOrNil(self.shop) then
        self:InitShopData()
    end
    self:ParseData(data, ShopID)
    self:CheckShopViewOpenToFresh()
    _G.Events:GetInstance():Broadcast(_G.eShopStatus.Update,ShopID)
end

