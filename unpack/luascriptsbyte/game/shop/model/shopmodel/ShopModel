---刷新红点状态
---@param params number?    刷新指定参数, 不传则刷新所有参数
function ShopModel:RefreshRedPoint(params)
    local redpointManager = require("RedPointManager"):GetInstance()
    if not params then
        redpointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Shop.id)
        return
    end

    local shopIds = self.redPointParams and self.redPointParams[params]
    if not shopIds then
        shopIds = { params }
    end

    for _, param in ipairs(shopIds) do
        redpointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.Shop.id, param)
    end
end

---获取红点状态
---@param params number
function ShopModel:GetRedPoint(params)
    if not self.redPointStates then
        return 0
    end

    local shopIds = self.redPointParams and self.redPointParams[params]
    if not shopIds then
        shopIds = { params }
    end

    local num = 0
    for _, shopId in ipairs(shopIds) do
        local states = self.redPointStates[shopId]
        if states then
            num = num + #states
        end
    end
    return num
end

---更新商品红点状态
---@param shopId number
---@param force boolean 是否强制刷新全部状态
---@param refreshRedpoint boolean?  是否刷新红点
function ShopModel:UpdateRedPointStates(shopId, force, refreshRedpoint)
    local shopData = self.shop and self.shop[shopId]
    if shopData then
        self:CheckRefreshRed(shopData, force)
    end
    if refreshRedpoint then
        self:RefreshRedPoint(shopId)
    end
end

---获取商品是否提示红点
---@param shopId number
---@param itemIndex number
---@return boolean
function ShopModel:IsItemRedPoint(shopId, itemIndex)
    local states = self.redPointStates and self.redPointStates[shopId]
    if not states or not _G.table.indexof(states, itemIndex) then
        return false
    end
    return true
end

---移除商品红点
---@param shopId number
---@param itemIndex number
---@param saveStates boolean?   保存红点状态到磁盘
---@param refreshRedpoint boolean?  是否刷新红点
function ShopModel:RemoveItemRedPoint(shopId, itemIndex, saveStates, refreshRedpoint)
    local states = self.redPointStates and self.redPointStates[shopId]
    if not states then
        return
    end
    local index = _G.table.indexof(states, itemIndex)
    if not index then
        return
    end
    _G.table.remove(states, index)
    if saveStates then
        self:SaveRedPointStates(shopId, states)
    end
    if refreshRedpoint then
        self:RefreshRedPoint(shopId)
    end
end

