---创建对象时,入口构造函数
function ShopModel:__init()
    self.cfg = _G.ConfigManager.shop_list_cfg
    self.shop = {}
    self.curFunctionOpenID = 25
    self.UnlockFunsId = {}
    ---商店红点 有第一次功能解锁 每次刷新倒计时结束 两个条件
    self.redPointStates = {}
    self.InitParseList = {}
    self.pageList = {}
    for k, v in pairs(self.cfg) do
        local data = v
        if not self.pageList[v.tab] then
            self.pageList[v.tab] = {}
            self.pageList[v.tab].list = {}
            self.pageList[v.tab].name = data.name
            self.pageList[v.tab].show = false
            self.pageList[v.tab].tab = data.tab
            self.pageList[v.tab].spriteName = data.image
            self.pageList[v.tab].id = k
        end
        --ZHJH-5308 联赛商店拆分成三个页签
        if v.function_open == 152 then
            for i = 1, 3 do
                self.pageList[v.tab].list[i] = {}
                self.pageList[v.tab].list[i].subname = 90021600078 + i
                self.pageList[v.tab].list[i].shopID = data.id
                self.pageList[v.tab].list[i].show = true
            end
        else
            self.pageList[v.tab].list[v.order] = {}
            self.pageList[v.tab].list[v.order].subname = data.subname
            self.pageList[v.tab].list[v.order].shopID = data.id
            self.pageList[v.tab].list[v.order].id = k
        end
        if v.function_open == 158 then
            ---和策划约定规则：功能id是158的都直接显示
            self.pageList[v.tab].list[v.order].show = true
        else
            self.pageList[v.tab].list[v.order].show = false
        end
    end
    ---shopid={true or false}

    --初始化红点参数列表
    self.redPointParams = {}
    ---@type table<number,number[]>   <tab标签丶商店ID列表>
    local tabsList = {}
    for _, v in pairs(self.cfg) do
        self.redPointParams[v.id] = { v.id }
        local tabs = tabsList[v.tab]
        if tabs then
            _G.table.insert(tabs, v.id)
        else
            tabsList[v.tab] = { v.id }
        end
    end
    local tabMergeIndex = 1000
    for _, tabs in pairs(tabsList) do
        if #tabs > 1 then
            local mergeIndex = tabMergeIndex
            tabMergeIndex = tabMergeIndex + 1
            for _, sid in pairs(tabs) do
                --在列表头部插入合并参数
                _G.table.insert(self.redPointParams[sid], 1, mergeIndex)
            end
            --存储合并参数对应的商店ID列表
            self.redPointParams[mergeIndex] = tabs
        end
    end
end

function ShopModel:InitFunction()
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
    _G.Events:GetInstance():AddListener(_G.eAFKAactionEnum.AfkSectionPass, self.OnAactionEnent, self)
    if not self.updateTimer then
        self.updateTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.updateTimer:Start()
    end
end

---初始数据
function ShopModel:InitShopData()
    for i, v in pairs(self.cfg) do
        self.shop[i] = {
            sid = self.cfg[i].id,
            name = _G.LangUtil.GetLangPackValue(self.cfg[i].name),
            interval_time = self.cfg[i].interval_time * 3600,
            count_refresh = self.cfg[i].count_refresh,
            currency_type = self.cfg[i].currency_type,
            price_refresh = _G.DeepCopyCfgTable(self.cfg[i].price_refresh),
            type = self.cfg[i].type,
            Unlock = false,
            RefreshCount = 0,
            bubble_chat = self.cfg[i].bubble_chat,
            bubble_upgrade = self.cfg[i].bubble_upgrade,
            bubble_end = self.cfg[i].bubble_end,
            bubble_continuous = self.cfg[i].bubble_continuous,
            bubble_hidden = self.cfg[i].bubble_hidden,
            tab = self.cfg[i].tab,
            order = self.cfg[i].order,
            curLevel = self:SetShopLevel(i),
            Material = {},
            time = 0,
            item = {},
            freeTimes = 0,
            function_open = self.cfg[i].function_open,
            spInterval_time = self.cfg[i].time * 3600,
        }
        self.UnlockFunsId[i] = self.cfg[i].function_open
        for n = 1, self.shop[i].count_refresh + 1 do
            if n > #self.shop[i].price_refresh then
                self.shop[i].Material[n] = self.shop[i].price_refresh[#self.shop[i].price_refresh]
            else
                self.shop[i].Material[n] = self.shop[i].price_refresh[n]
            end
        end
    end
end

---监听玩家行为
function ShopModel:OnAactionEnent()
