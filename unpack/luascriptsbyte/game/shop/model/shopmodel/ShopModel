end

---购买物品
function ShopModel:BuyItem(ShopID, item, count, call)
    if item == nil then
        return
    end
    if item.cfg then
        if not _G.StorageManager:GetInstance():CheckItem(item.cfg.currency_type, item.cfg.price) then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.CoinLimit)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                item.cfg.currency_type
            )
            return
        end
    end
    local msg = {}
    msg.items = {}
    local itemCur = {}
    itemCur.buy_num = count
    itemCur.buy_type = item.sp and 2 or 1
    if item.cfg.item then
        msg.shop_id = ShopID
        itemCur.index = item.index
    else
        msg.shop_id = ShopID
        itemCur.id = item.sid
    end
    -- msg.buy_type = item.sp and 2 or 1
    if count < 1 then
        count = 1
    end
    -- msg.buy_num = count


    table.insert(msg.items, itemCur)

    if item.cfg.currency_type == 12 then
        --     end
        -- )
        -- _G.GlobalInterface.ConsumeHYShowTips(
        --     _G.ComsumeHYType.Token,
        --     item.price,
        --     function()
        ShopNet:GetInstance():BuyItem(msg, _G.handlerbind(self, self.BuyItemSuc, item, count, ShopID, call))
    else
        ShopNet:GetInstance():BuyItem(msg, _G.handlerbind(self, self.BuyItemSuc, item, count, ShopID, call))
    end
end

---购买物品返回
function ShopModel:BuyItemSuc(data, item, count, ShopID, call)
    if data.ack ~= 1 then
