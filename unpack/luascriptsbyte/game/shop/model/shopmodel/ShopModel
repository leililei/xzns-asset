                    value.show=self.cfg[value.id].is_hide==0
                elseif value.show then
                    value.show=self.cfg[v.id].is_hide==0
                end
            end
        end
    end
    return self.pageList
end

---获取商品下次刷新时间
---@param type number 1为日刷-2为周刷-3为月刷
---@param target number 对应type参数的目标日
function ShopModel:GetGoodNextRefreshTime(type,target)
    local nextTime = 0
    if type == 1 then
        --日刷
        nextTime = TimeUtil.GetNextDayHourTime(target)
    elseif type == 2 then
        --周刷
        nextTime = TimeUtil.GetNextWeekdayTime(target)
    elseif type == 3 then
        --月刷
        nextTime = TimeUtil.GetNextMonthDayTime(target)
    else
        _G.LogError("ShopID商品刷新参数配置有问题")
    end
    return nextTime
end

