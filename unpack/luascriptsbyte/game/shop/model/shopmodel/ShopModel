--- 根据 shop_pools_cfg 中的 order 字段，对item进行排序,并将其返回
---@param itemList table 待排序的item列表
---@return table
function ShopModel:OrderSort(itemList)
    if not itemList then
        return itemList
    end
    local goodsList = {}
    local goods = {}
    local goodsIndexs = {}
    for _, v in ipairs(itemList) do
        if v.cfg and v.cfg.order and v.cfg.order > 0 then
            -- 固定排序
            if not goods[v.cfg.order] then
                -- 记录出现的固定排序
                goods[v.cfg.order] = {}
                _G.table.insert(goodsIndexs, v.cfg.order)
            end
            -- 记录固定排序出现的item
            _G.table.insert(goods[v.cfg.order], v)
        else
            -- 默认排序
            _G.table.insert(goodsList, v)
        end
    end
    -- 如果没有固定排序的物品，直接返回原列表
    if goodsIndexs then
        -- 升序排列出现的固定排序
        _G.table.sort(goodsIndexs)
        --- 排序后的goodsList
        local var2 = {}
        --- 默认排序的item列表的取值进度
        local index = 1
        -- 使用固定排序进行重新排列
        for _, v in ipairs(goodsIndexs) do
            -- 如果列表中的物品数量小于当前物品的排序，则使用默认排序的物品将对应缺少的物品数量补上
            if v > #var2 + 1 then
                -- 默认排序的物品不足时，跳过
                if index - 1 < #goodsList then
                    local minNum = _G.math.min(#goodsList, v - 1)
                    _G.table.move(goodsList, index, minNum, #var2 + 1, var2)
                    index = minNum + 1
                end
            end
            -- 将同一排列顺序的物品插入尾部
            _G.table.move(goods[v], 1, #goods[v], #var2 + 1, var2)
        end
        -- 将剩下的默认排序的物品插入尾部
        if index - 1 < #goodsList then
            _G.table.move(goodsList, index, #goodsList, #var2 + 1, var2)
        end
        return var2
    end
    return itemList
end

