end

---销毁对象时,析构函数
function ShopModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eAFKAactionEnum.AfkSectionPass, self.OnAactionEnent, self)
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
    self:ClearShopTimer()
end

--region 子类重写
function ShopModel:GetDataFormServer()
    if _G.table.isEmptyOrNil(self.shop) then
        self:InitShopData()
    end
    self.ParseCount = 0
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(25) then
        local allShopCount = 0
        for i, v in _G.pairs(self.shop) do
            if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg[i].function_open) then
                if v.type == 2 or v.type == 3 or v.type == 4 then
                    self.shop[i].Unlock = false
                else
                    self.ParseCount = self.ParseCount + 1
                end
                allShopCount = allShopCount + 1
            end
        end
        if allShopCount >= #self.shop then
            _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnEvent_CheckLock, self)
        end
        for i, v in _G.pairs(self.shop) do
            if self.cfg[i].function_open == 158 or _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.cfg[i].function_open) then
                if v.type == 2 or v.type == 3 or v.type == 4 then
                else
                    local msg = { shop_id = i }
                    ShopNet:GetInstance():GetShopInfo(msg, _G.handlerbind(self, self.InitParseData, function() end, v
                        .sid))
                end
            end
        end
    else
        self.super.ParseData(self)
    end
end

---当前放置通关 是否解锁新商店等级
function ShopModel:CheckShopFreshByAfk()
    if not self:GetFunctionOpen() then
        return
    end
    local maxCount = 0
    local newAfkId
    if self.shop then
        for k, v in pairs(self.shop) do
            newAfkId = self:SetShopLevel(v.sid)
            if newAfkId then
                if v.curLevel < newAfkId then
                    v.curLevel = newAfkId
                end
            else
                maxCount = maxCount + 1
            end
        end
    end
    if maxCount == #self.shop then
        _G.Events:GetInstance():RemoveListener(_G.eAFKAactionEnum.AfkSectionPass, self.OnAactionEnent, self)
    end
end

---设置商店当前等级 返回下一等级放置条件
function ShopModel:SetShopLevel(shopid)
    local AfkModelIns = require "AfkModel":GetInstance()
    local curAfkSid = AfkModelIns:GetLastSection()
    if #self.cfg[shopid].bubble_up_con > 0 then
        local bubble_up_con = _G.DeepCopyCfgTable(self.cfg[shopid].bubble_up_con)
        _G.table.sort(
            bubble_up_con,
            function(a, b)
                return a < b
            end
        )
        for k, v in pairs(bubble_up_con) do
            if v > curAfkSid then
                return v
            end
        end
    end
    return nil
end

---监听功能开放
function ShopModel:OnEvent_CheckLock(id)
    for k, v in _G.pairs(self.UnlockFunsId) do
        if v == id then
            self.ParseCount = self.ParseCount + 1
            local msg = { shop_id = k }
            ShopNet:GetInstance():GetShopInfo(msg, _G.handlerbind(self, self.InitParseData, function()
                self:RefreshRedPoint(k)
            end, k))
        end
    end
end

---解析数据
function ShopModel:InitParseData(data, call, ShopID, idIs)
    if idIs then
        if self.InitParseList[idIs] == nil or self.InitParseList[idIs] == false then
            self.InitParseList[idIs] = true
        end
    end
    self.ParseCount = self.ParseCount - 1
    self:ParseData(data, ShopID)
    if self.ParseCount == 0 then
        if call then
            call()
        end
        self.super.ParseData(self)
        self:CheckShopViewOpenToFresh()
    end
    _G.Events:GetInstance():Broadcast(_G.eShopStatus.Update,ShopID)
end

---当所有商店数据解析完成
function ShopModel:ParseData(data, ParseCount)
    if not _G.table.isEmptyOrNil(data) and data.ack == 1 then
        if _G.table.isEmptyOrNil(data.info) then
            local shop, shopLis, itemCfg
            if _G.ShopID.PvpAllHeros == ParseCount then
                shop = self.shop[_G.ShopID.PvpAllHeros]
                shopLis = require "SeasonModel":GetInstance():GetCfg().shop
                itemCfg = _G.ConfigManager.season_shop_cfg
            elseif _G.ShopID.ArenaPeak == ParseCount then
                shop = self.shop[_G.ShopID.ArenaPeak]
                shopLis = require "ArenaPeakModel":GetInstance():GetCfg().shop
                itemCfg = _G.ConfigManager.arena_shop_cfg
            elseif _G.ShopID.SpiritualRealm == ParseCount then
                shop = self.shop[_G.ShopID.SpiritualRealm]
                shopLis = require "SpiritualRealmModel":GetInstance():GetShopItemList()
                itemCfg = _G.ConfigManager.arena_shop_cfg
            end
            --local Id = require "SeasonModel":GetInstance():GetCurSeasonId()
            --local seasonId = Id * 100
            if not shop then
                _G.LogError("shop数据为空， 商店Id: " .. tostring(ParseCount))
                return
            end
            shop.Unlock = true
            shop.RefreshCount = 0
            shop.curLevel = self:SetShopLevel(shop.sid)
            shop.item = {}
            local buys = data.s_info.buys
            local i = 1
            for _, v in pairs(shopLis) do
                shop.item[i] = require("SeasonShopItemData").New(i)
                shop.item[i]:Parse(itemCfg[v])
                i = i + 1
            end
            if buys then
                for i = 1, #buys do
                    for _, v in pairs(shop.item) do
                        if buys[i].id == v.sid then
                            v.BuyTime = buys[i].buy_times
                            break
                        end
                    end
                end
            end
            _G.SortList(
                shop.item,
                function(a)
                    return -a.Order
                end
            )
            self.pageList[shop.tab].show = true
            self.pageList[shop.tab].list[shop.order].show = true
            -- 排序
            shop.item = self:OrderSort(shop.item)
            shop.SPitem = self:OrderSort(shop.SPitem)
            self:CheckRefreshRed(shop, false)
            return
        end
        local shop = self.shop[data.info.shop_id]
        shop.Unlock = true
        shop.RefreshCount = data.info.refresh_times
        shop.curLevel = self:SetShopLevel(shop.sid)
        shop.time = data.info.refresh_second
        shop.spTime = data.info.refresh_second1
        shop.item = {}
        shop.SPitem = {}
        if data.info.shop_item_id then
            for i = 1, #data.info.shop_item_id do
                shop.item[i] = require("ShopItemData").New(i)
                shop.item[i]:Parse(data.info.shop_item_id[i], ParseCount)
                shop.freeTimes =
                    require "HellRoadModel":GetInstance():GetNumber({ _G.PrivilegeType.Shop.Refresh, data.info.shop_id }) -
                    data.info.free_times
            end
        end
        if data.info.shop_item_id1 then
            for i = 1, #data.info.shop_item_id1 do
                shop.SPitem[i] = require("ShopItemData").New(i)
                data.info.shop_item_id1[i].sp = true
                shop.SPitem[i]:Parse(data.info.shop_item_id1[i], ParseCount)
            end
        end
        self.pageList[shop.tab].show = true
        self.pageList[shop.tab].list[shop.order].show = true
        -- 排序
        shop.item = self:OrderSort(shop.item)
        shop.SPitem = self:OrderSort(shop.SPitem)
        for i = #shop.SPitem, 1, -1 do
            table.insert(shop.item, 1, shop.SPitem[i])
        end
        self:CheckRefreshRed(shop, false)
    end
end

