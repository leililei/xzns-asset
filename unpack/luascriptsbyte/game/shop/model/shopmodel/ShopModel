---刷新商店成功
function ShopModel:RefreshShopSuc(data, ShopID, call)
    if data.ack ~= 1 then
        return
    end
    if not table.isEmptyOrNil(data) then
        local shop = self.shop[data.info.shop_id]
        shop.RefreshCount = data.info.refresh_times
        if shop.freeTimes <= 0 then
            _G.StorageManager:GetInstance():ConsumeItem(shop.currency_type, 0, shop.Material[shop.RefreshCount])
        end
        shop.time = data.info.refresh_second
        shop.spTime = data.info.refresh_second1
        shop.freeTimes =
            require "HellRoadModel":GetInstance():GetNumber({ _G.PrivilegeType.Shop.Refresh, data.info.shop_id }) -
            data.info.free_times
        shop.item = {}
        local temp = {}
        if not _G.table.isEmptyOrNil(data.info.shop_item_id) then
            for i = 1, #data.info.shop_item_id do
                local cfg = _G.ConfigManager.shop_pools_cfg[data.info.shop_item_id[i].good_id]
                if not _G.table.isEmptyOrNil(cfg.conditions) then
                    local bool_checkRoleLevel =
                        _G.GlobalConditionManager.CheckCondition(cfg.conditions[1][1], cfg.conditions[1][2])
                    if not bool_checkRoleLevel then
                    else
                        temp = {}
                        temp = require("ShopItemData").New(i)
                        temp:Parse(data.info.shop_item_id[i], ShopID)
                        table.insert(shop.item, temp)
                    end
                else
                    temp = {}
                    temp = require("ShopItemData").New(i)
                    temp:Parse(data.info.shop_item_id[i], ShopID)
                    table.insert(shop.item, temp)
                end
            end
        end
        --data.info.shop_item_id1 = data.info.shop_item_id1 or {}
        if not _G.table.isEmptyOrNil(data.info.shop_item_id1) then
            shop.SPitem = {}
            for i = 1, #data.info.shop_item_id1 do
                local cfg = _G.ConfigManager.shop_pools_cfg[data.info.shop_item_id1[i].good_id]
                data.info.shop_item_id1[i].sp = true
                temp = {}
                temp = require("ShopItemData").New(i)
                temp:Parse(data.info.shop_item_id1[i], ShopID)
                table.insert(shop.SPitem, temp)
            end
        end
        shop.item = self:OrderSort(shop.item)
        shop.SPitem = self:OrderSort(shop.SPitem)
        for i = #shop.SPitem, 1, -1 do
            table.insert(shop.item, 1, shop.SPitem[i])
        end

        --更新红点状态
        self:CheckRefreshRed(shop, true)
        self:RefreshRedPoint(ShopID)
    end
    if call ~= nil then
        call()
    end
end

