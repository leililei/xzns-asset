---@class ShopBuyEquipView : UIBaseView	中文描述
---@field public go_table ShopBuyEquipView_GoTable GoTable
local ShopBuyEquipView = _G.BaseClass("ShopBuyEquipView", _G.UIBaseView)

function ShopBuyEquipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ShopBuyEquipView:OnCreate(data, call)
    self.IsFirst = true
    self.Item = data
    self.call = call
    self.IsShowCard = false
    self.go_table.aorimage_Grade.SpriteName = _G.itemColorIconName[data.Grade]
    self.go_table.aorrawimage_Icon:LoadImage(
        data.Icon,
        function(image)
            if image then
                image:SetActiveE(1)
            end
        end
    )
    self.go_table.aortext_Lv.text = data.ItemCfg.limit_level
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_Prop.text = data.ItemCfg.limit_level
    self.go_table.aorimage_EquipGrade.SpriteName = _G.EquipmentGrade[data.Grade]
    self.go_table.aorrawimage_EquipType:LoadImage(_G.ConfigManager.type_equipment_cfg[data.ItemCfg.professional].icon)
    self.go_table.aortext_equipmmentDes.text = _G.LangUtil.GetLangPackValue(data.ItemCfg.describe)
    self.go_table.aorrawimage_MaterialIcon:LoadImage(data.currencyIcon)
    self.go_table.aortext_MaterialNum.text = "x" .. data.price
    self.EquipBaseAttr = {}
    for i = 1, 5 do
        self.EquipBaseAttr[i] = _G.GetAutoGoTable(self.go_table.obj_Info:FindE(string.format("$_obj_SingleField%d", i)))
    end

    for _, v in pairs(self.EquipBaseAttr) do
        v.gameObject:SetActiveE(0)
    end
    local i = 1
    for key, v in pairs(_G.AttrType) do
        if data.ItemCfg[key] and data.ItemCfg[key] > 0 then
            local item = self.EquipBaseAttr[i]
            item.gameObject:SetActiveE(1)
            item.aorrawimage_Decorate:LoadImage(v.icon)
            item.aortext_Name.text = v.des
            item.aortext_Num.text = data.ItemCfg[key]
            i = i + 1
        end
    end
end

---展示需要的卡牌列表
function ShopBuyEquipView:ShowCardList()
    self.IsShowCard = not self.IsShowCard
    self.go_table.obj_CardList:SetActiveE(self.IsShowCard and 1 or 0)
    if not self.IsShowCard then
        return
    end
    local tmpList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    local CardList = {}
    local bl = false
    for _, v in pairs(tmpList) do
        bl = false
        if v.cfg.EquipmentType == self.Item.ItemCfg.professional then
            if
                table.isEmptyOrNil(v.EquipBar[self.Item.ItemCfg.parts]) or
                    v.EquipBar[self.Item.ItemCfg.parts].cfg.grade < self.Item.ItemCfg.grade
             then
                if not table.isEmptyOrNil(CardList) then
                    for i = 1, #CardList do
                        if v.sid == CardList[i].sid then
                            if CardList[i].star < v.star then
                                CardList[i] = v
                            end
                            bl = true
                        end
                    end
                end
                if not bl then
                    table.insert(CardList, v)
                end
            end
        end
    end
    table.sort(
        CardList,
        function(b, a)
            if b:GetPower() > a:GetPower() then
                return true
            elseif b:GetPower() == a:GetPower() and b:GetLevel() > a:GetLevel() then
                return true
            elseif b:GetPower() == a:GetPower() and b:GetLevel() == a:GetLevel() and b.star > a.star then
                return true
            elseif b:GetPower() == a:GetPower() and b:GetLevel() == a:GetLevel() and b.star == a.star and b.sid > a.sid then
                return true
            else
                return false
            end
        end
    )
    self:ShowCard(CardList)
end

---显示货物
function ShopBuyEquipView:ShowCard(CardList)
    if self.IsFirst then
        self.go_table.looplist2_CardList:InitListView(0, _G.handlerbind(self, self.RefreshGoodsList, CardList))
        self.IsFirst = false
    end

    self.go_table.looplist2_CardList:SetListItemCount(table.count(CardList))
    self.go_table.looplist2_CardList:RefreshAllShownItem()
end

---刷新单个卡牌
function ShopBuyEquipView:RefreshGoodsList(listView2, index, CardList)
    if index < 0 then
        return
    end
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local x = index + 1
    item:SetName(x)
    local tb_i = {}
    local data = {}
    data = CardList[x]
    tb_i = _G.GetAutoGoTable(item)
    if data == nil then
        tb_i.gameObject:SetActiveE(0)
    else
        tb_i.gameObject:SetActiveE(1)
        tb_i.aorimage_Color.SpriteName = _G.itemColorIconName[data.cfg.Order]
        tb_i.aorimage_ColorBg.SpriteName = _G.itemColorDiIconName[data.cfg.Order]
        tb_i.aorrawimage_Icon:LoadImage(data.cfg.Icon)
        require("CardInfoManager"):GetInstance():Star_byParent2(tb_i.obj_starParent, data.star)
        tb_i.aortext_Number.text = data:GetLevel()
        require("CardInfoManager"):GetInstance():AddSetCardDataWakeLv(tb_i, data, true, 1)
        require("CardInfoManager").LoadRawImage_elements(tb_i.aorrawimage_elements, data)
        require("CardInfoManager").LoadRawImage_professional(tb_i.aorrawimage_professional, data)
    end

    return item
end

---按钮点击事件在这里派发
function ShopBuyEquipView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        if self.call then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_Seek" then
        self:ShowCardList()
    end
end

return ShopBuyEquipView
