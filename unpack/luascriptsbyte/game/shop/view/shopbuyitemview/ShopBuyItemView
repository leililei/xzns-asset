---@class ShopBuyItemView : UIBaseView	中文描述
---@field public go_table ShopItemBuyView_GoTable GoTable
local ShopBuyItemView = _G.BaseClass("ShopBuyItemView", _G.UIBaseView)
--_G.ShopBuyItemView = ShopBuyItemView

local CS = _G.CS
local typeof = _G.typeof

function ShopBuyItemView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function ShopBuyItemView:OnCreate(data, call)
    self.call = call
    self.go_table.aortext_ItemDes.text = _G.LangUtil.GetLangPackValue(data.ItemCfg.Describe)
    self.go_table.aorrawimage_MaterialIcon:LoadImage(data.currencyIcon)
    self.go_table.aortext_MaterialNum.text = "x" .. data.price
    self.go_table.aortext_ItemName.text = data.name
    local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(data.ItemCfg.ID)
    self.go_table.aortext_ItemNum.text =
        _G.StorageManager:GetInstance():GetItemCountByID(StorageID, data.ItemCfg.ID or data.ItemCfg.id)
    self.go_table.aorimage_Border.SpriteName = _G.itemColorIconName[data.Grade]
    self.go_table.aorrawimage_ItemIcon:LoadImage(data.Icon)
end

---按钮点击事件在这里派发
function ShopBuyItemView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_BG" then
        self:Close()
    elseif name == "@_aorbtn_Done" then
        -- _G.UIUtils.PlayAudio(2013)
        if self.call then
            self.call()
        end
        self:Close()
    end
end

return ShopBuyItemView
