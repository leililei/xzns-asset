    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ShopNet:AccessCall(port, data, error)
    if error then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log(data.ack)
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type ShopNet
return ShopNet
