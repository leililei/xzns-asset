---@class ShopNet : BaseGameNet	通信协议
local ShopNet = _G.BaseClass("ShopNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return ShopNet ShopNet
function ShopNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取单个商店信息
---@param callback function 完成回调
function ShopNet:GetShopInfo(pbData, callback)
    local item = _G.ConfigManager.net_map.game_shop_new_get
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---购买道具
---@param callback function 完成回调
function ShopNet:BuyItem(pbData, callback)
    local item = _G.ConfigManager.net_map.game_shop_new_buy
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

---商店刷新
---@param callback function 完成回调
function ShopNet:RefreshShop(pbData, callback)
    local item = _G.ConfigManager.net_map.game_shop_new_refresh
    local port = base.Access(self, item, pbData, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
