local RedPointManager = require("RedPointManager")
---@class RedPointItemBase	中文描述
---@field id number 红点ID
---@field child table 子节点ID组
---@field parent number 父节点ID
---@field num number 无参数红点数量
---@field paramNums table 参数和对应红点数量
---@field state boolean 红点状态, 如果红点状态未改变则不再想上层传递(默认nil)
---@field paramStates table<number,boolean> 红点状态, 如果红点状态未改变则不再想上层传递(默认nil)
---@field paramStatesSyncTime table<number,number> 上一次同步红点的时间
local RedPointItemBase = _G.BaseClass("RedPointItemBase", _G.LogicClass)

---构造方法
---@param id number 红点ID
---@param child table 子节点ID组
---@return 变量类型 中文描述
function RedPointItemBase:__init(id, child, funcid)
    self.id = id
    self.child = {}
    self.num = 0
    self.paramNums = {}
    self.functionID = funcid
    if child then
        for i = 1, #child do
            self.child[i] = child[i]
        end
    end
end

---类的析构函数
function RedPointItemBase:Dispose()
    self.id = nil
    self.child = nil
    self.parent = nil
    self.num = nil
    self.paramNums = nil
end

--region对外接口
---初始化红点数据
function RedPointItemBase:InitData()
    self:InitAllParams()
    self:Check()
end
---刷新红点数据
---@param param number 参数
function RedPointItemBase:UpdateData(param)
    self:Check(param)
end
---获取节点红点显示数量(包含子节点的数量)
---@param param number 参数(为nil 则返回CheckAll)
---@param isparentparam boolean 是否为父节点参数
---@return number 红点数量
function RedPointItemBase:GetRedPointNum(param, isparentparam)
    local num
    if param then
        if isparentparam then
            num = self:GetRedPointNumByParentParam(param)
        else
            num = self.paramNums[param] or 0
        end
    else
        num = self.num
    end
    if self.child and #self.child > 0 then
        local redPointManager = RedPointManager:GetInstance()
        for i = 1, #self.child do
            num = num + redPointManager:GetNodeNum(self.child[i], param, true)
            if num > 0 then
                break
            end
        end
    end
    return num
end
---获取父节点ID
---@return number 父节点ID
function RedPointItemBase:GetParent()
    return self.parent
end
---设置父节点ID
---@param id number 父节点ID
function RedPointItemBase:SetParent(id)
    self.parent = id
end
---设置子节点
---@param child table 子节点数组
function RedPointItemBase:SetChild(child)
    self.child = child
end
function RedPointItemBase:GetChild()
    return self.child
end
---移除一个子节点
---@param id number 红点ID
function RedPointItemBase:RemoveChild(id)
    if _G.table.isEmptyOrNil(self.child) then
        return
    end
    for i = 1, #self.child do
        if self.child[i] == id then
            _G.table.remove(self.child, i)
            break
        end
    end
end
---新增一个子节点
---@param 变量名 变量类型 中文描述
function RedPointItemBase:AddChild(id)
    if _G.table.isEmptyOrNil(self.child) then
        self.child = {id}
        return
    end
    for i = 1, #self.child do
        if self.child[i] == id then
            return
        end
    end
    self.child[#self.child + 1] = id
end
---获取所有带参数的红点数量
---@return table 参数红点数据
function RedPointItemBase:GetAllParamsNum()
    return self.paramNums
end
---添加新的参数(动态 比如邮箱新增邮件)
---@param param number 参数
function RedPointItemBase:AddParam(param)
    self:Check(param)
end
---移除参数(动态 比如邮箱删除邮件)
---@param param number 参数
function RedPointItemBase:RemoveParam(param)
    self.paramNums[param] = nil
end
--endregion

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemBase:GetAllParams()
    return nil
end
---检测全部
---@return number 红点数量
function RedPointItemBase:CheckAll()
    local num = 0
    for _, _num in pairs(self.paramNums) do
        num = num + _num
    end
    return num
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemBase:CheckParams(param)
    return 0
end
---解析参数返回给父节点
---@param param number 子节点参数
---@return number[] 父节点参数
function RedPointItemBase:ParseParamForParent(param)
    return nil
end
---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointItemBase:GetRedPointNumByParentParam(param)
    return self.paramNums[param] or 0
end
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemBase:CheckFunctionOpenExtra()
    return true
end
--endregion

--region内部方法
---初始化所有参数
function RedPointItemBase:InitAllParams()
    local params = self:GetAllParams()
    if params then
        local manager = _G.FunctionManager:GetInstance()
        for i = 1, #params do
            self:Check(params[i], manager)
        end
    end
end
---设置红点数量
---@param param number 判定参数
function RedPointItemBase:SetNum(num, param)
    if param and param >= 0 then
        self.paramNums[param] = num
    else
        self.num = num
    end
end
---检测红点展示
---@param param number 参数(为nil 则需要做一次全检测)
---@return number 红点展示数量
function RedPointItemBase:Check(param, manager)
    manager = manager or _G.FunctionManager:GetInstance()
    if param == nil then
        if
            self:CheckFunctionOpenExtra() and
                (not self.functionID or self.functionID <= 0 or manager:CheckFunctionIsUnlock(self.functionID))
         then
            self:SetNum(self:CheckAll())
        else
            self:SetNum(0)
        end
    else
        if
            self:CheckFunctionOpenExtra() and
                (not self.functionID or self.functionID <= 0 or manager:CheckFunctionIsUnlock(self.functionID))
         then
            self:SetNum(self:CheckParams(param), param)
        else
            self:SetNum(0, param)
        end
    end
end
--endregion

return RedPointItemBase
