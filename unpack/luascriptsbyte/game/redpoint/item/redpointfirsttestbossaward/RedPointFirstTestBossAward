local base = require "RedPointItemBase"
---@class RedPointFirstTestBossAward	中文描述
local RedPointFirstTestBossAward = _G.BaseClass("RedPointFirstTestBossAward", base)

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointFirstTestBossAward:CheckAll()
    return require "FirstTestBossModel":GetInstance():CheckAwardRedPoint() and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointFirstTestBossAward:CheckFunctionOpenExtra()
    return require "SeasonManager".CheckSeasonIsOpen()
end

--endregion

return RedPointFirstTestBossAward
