local base = require "RedPointItemBase"
---@class RedPointPetDrawAward	中文描述
local RedPointPetDrawAward = _G.BaseClass("RedPointPetDrawAward", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointPetDrawAward:GetAllParams()
    local params = {}
    for k, v in ipairs(_G.ConfigManager.item_roller_cfg[20100].rewards_count) do
        _G.table.insert(params, k)
    end
    return params
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPetDrawAward:CheckParams(param)
    return require "PetDrawModel":GetInstance():CheckDrawAwardPointRed(param) and 1 or 0
end
--endregion

return RedPointPetDrawAward