local base = require "RedPointItemBase"
---@class RedPointCardUpStar	中文描述
local RedPointCardUpStar = _G.BaseClass("RedPointCardUpStar", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCardUpStar:GetAllParams()
    local uidLis = {}
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local insert = _G.table.insert
    for _, v in pairs(cards) do
        insert(uidLis, v.uid)
    end
    return uidLis
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCardUpStar:CheckParams(param)
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not _G.table.ContainsValue(uidLis, param) then
        return 0 
    end
    return require("CardInfoManager"):GetInstance():CheckCanUpStar(param) and 1 or 0
end

function RedPointCardUpStar:ParseParamForParent(param)
    return {param}
end

return RedPointCardUpStar
