local base = require "RedPointItemBase"
---@class RedPointSociatyBuild	建筑红点检测
---@field buildIds number[]     建筑id列表
local RedPointSociatyBuild = _G.BaseClass("RedPointSociatyBuild", base)

function RedPointSociatyBuild:__init()
    self.buildIds = {}
    for _, cfg in pairs(_G.ConfigManager.guild_unit_cfg) do
        table.insert(self.buildIds, cfg.id)
    end
end
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSociatyBuild:GetAllParams()
    return self.buildIds
end

---检测单个红点
---@param buildId number 参数
---@return number 红点数量
function RedPointSociatyBuild:CheckParams(buildId)
    if buildId ~= 1 then
        return 0
    end

    local model = require("SociatyModel"):GetInstance()
    local gotLevelList = model:GetBuildAwardLevels()
    local curLevel = model:GetBuildLevel(1)
    for i = 1 ,curLevel do
        if not gotLevelList[i] then
            return 1
        end
    end
    return 0
end
--endregion

return RedPointSociatyBuild
