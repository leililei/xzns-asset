local base = require "RedPointItemBase"
---@class RedPointSecretRealmWish    死魂塔礼包
local RedPointSecretRealmWish = _G.BaseClass("RedPointSecretRealmWish", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSecretRealmWish:GetAllParams()
    return { 0 }
end

---检测全部
---@return number 红点数量
function RedPointSecretRealmWish:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune) then
        return 0
    end
    return require("SecretRealmModel"):GetInstance():CheckWishRedPoint() and 1 or 0
end

--endregion

return RedPointSecretRealmWish