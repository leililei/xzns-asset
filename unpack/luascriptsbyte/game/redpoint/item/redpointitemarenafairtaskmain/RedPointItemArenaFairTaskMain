local base = require "RedPointItemBase"
---@class RedPointItemArenaFairTaskMain	中文描述
local RedPointItemArenaFairTaskMain = _G.BaseClass("RedPointItemArenaFairTaskMain", base)
local ArenaManager = require("ArenaManager")
---公平竞技场SID
local arenaSid = 3
--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaFairTaskMain:CheckFunctionOpenExtra()
    return ArenaManager:GetInstance():GetArenaClass(arenaSid):GetCurArenaState() == ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaFairTaskMain:CheckAll()
    local FairCls = ArenaManager:GetInstance():GetArenaClass(arenaSid)
    return FairCls:CheckHaveGetTask(2) and 1 or 0
end
--endregion

return RedPointItemArenaFairTaskMain
