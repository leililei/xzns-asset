local base = require "RedPointItemBase"

---@class RedPointRecordRankBook    中文描述
local RedPointRecordRankBook = _G.BaseClass("RedPointRecordRankBook", base)

---获取所有参数
---@return table 参数列表
function RedPointRecordRankBook:GetAllParams()
    if self.tabs then
        return self.tabs
    end
    self.tabs = {}
    for i = 1, 3 do
        table.insert(self.tabs, i)
    end
    return self.tabs
end

---@param type number 排行榜类型
function RedPointRecordRankBook:CheckParams(param)
    local model = require("RecordRankModel"):GetInstance()

        --检测是否开启
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(48) then
        return 0
    end

    local lstCfg = model:GetBookCfg(param)
    if not lstCfg then
        return 0
    end
    if param == 6 and not require("RecordRankModel"):GetInstance():CheckGodShow() then
        return 0
    end
    for _, cfg in pairs(lstCfg) do
        --检查是否有可领取的奖励
        if model:GetBookRecord(cfg.id) and model:CanGetBookAward(cfg.id) then
            return 1
        end
    end
    return 0
end

---解析参数返回给父节点
---@param param number 排行榜类型
---@return number 父节点参数
function RedPointRecordRankBook:ParseParamForParent(param)
    return {param}
end

return RedPointRecordRankBook
