local base = require "RedPointItemBase"
---@class RedPointItemHeroicIconMineSG	 : RedPointItemBase 中文描述
local RedPointItemHeroicIconMineSG = _G.BaseClass("RedPointItemHeroicIconMineSG", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemHeroicIconMineSG:GetAllParams()
    return {0}
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemHeroicIconMineSG:CheckParams()
    local ruins = require("HeroicMineModelSg"):GetInstance():GetRuinDataList()
    for _, v in pairs(ruins) do
        if v.ruinState == require("RuinData").RuinState.Get then
            return 1
        end
    end
    return 0
end
--endregion

return RedPointItemHeroicIconMineSG