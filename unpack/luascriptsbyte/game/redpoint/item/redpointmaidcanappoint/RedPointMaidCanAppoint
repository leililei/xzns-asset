local base = require "RedPointItemBase"
---@class RedPointMaidCanAppoint 放置挂机红点
local RedPointMaidCanAppoint = _G.BaseClass("RedPointMaidCanAppoint", base)


function RedPointMaidCanAppoint:GetAllParams()
    self.ids = { 101, 201, 202, 301, 302 }
    return self.ids
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointMaidCanAppoint:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Maid) then
       return 0 
    end
    return require "MaidAcademyModel":GetInstance():CanAppoint(param) or 0
end

return RedPointMaidCanAppoint