local base = require "RedPointItemBase"
---@class RedGoalTarget	七日目标 目标点的奖励
local RedGoalTarget = _G.BaseClass("RedGoalTarget", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedGoalTarget:GetAllParams()
    if self.allActionGoal then
        return self.allActionGoal
    end
    self.allActionGoal = {}
    local cfg = _G.ConfigManager.goals_active_cfg
    for _, value in pairs(cfg) do
        _G.table.insert(self.allActionGoal, value.id)
    end
    return self.allActionGoal
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedGoalTarget:CheckParams(param)
    local flag = require "ActionGoalsModel":GetInstance():CheckGoalsRedpoint(param)
    return flag and 1 or 0
    --return 0
end
function RedGoalTarget:ParseParamForParent(param)
    local qishu = math.modf(param / 100)
    return {qishu}
end

---@param param number 期数的id
function RedGoalTarget:GetRedPointNumByParentParam(param)
    local num = 0
    param = param * 100
    for i = 1, 7 do
        local pointnum = self:GetRedPointNum(param + i)
        if pointnum then
            num = num + pointnum
        end
    end
    return num
end
--endregion

return RedGoalTarget
