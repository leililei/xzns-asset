local base = require "RedPointItemBase"
local StrategyStationModel = require("StrategyStationModel")

---@class RedPointStrategyStation	每日成就页签
local RedPointStrategyStation = _G.BaseClass("RedPointStrategyStation", base)
--region子类重写

---检测全部
---@return number 红点数量
function RedPointStrategyStation:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.StrategyStation) then
        return 0
    end
    return StrategyStationModel:GetInstance():CheckRedPoint() and 1 or 0
end

return RedPointStrategyStation
