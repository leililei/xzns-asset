---获取所有参数
---@return table 参数列表
function RedPointBiography:GetAllParams()
    self.allSoulLineIDssid = {}
    -- if self.allSoulLineIDs then
    --     return self.allSoulLineIDs
    -- end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local table = _G.table
    local part_uid = 0
    self.allSoulLineIDs = {}
    for key, value in pairs(cards) do
        -- for i = 1, SoulLineNumber do
        --     part_uid = 0
        --     part_uid = value.uid * 10 + i
        --     table.insert(self.allSoulLineIDs, part_uid)
        -- end
        part_uid = 0
        part_uid = value.uid * 10 + 1
        self.allSoulLineIDssid[part_uid] = value.sid

        table.insert(self.allSoulLineIDs, part_uid)
    end
    return self.allSoulLineIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointBiography:CheckParams(param)
    if self.allSoulLineIDssid[param] then
        return require("IllustrationModel"):GetInstance():CardPanDuan(self.allSoulLineIDssid[param]) and 1 or 0
    end
end
function RedPointBiography:ParseParamForParent(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)

    return {uid}
end
