    local num = 0
    param = param * 10
    -- for i = 1, SoulLineNumber do
    --     local point = self:GetRedPointNum(param + i)
    --     if point then
    --         num = num + point
    --     end
    -- end
    local point = self:GetRedPointNum(param + 1)
    if point then
        num = num + point
    end
    return num
end
