local base = require "RedPointItemBase"
---@class RedPointItemBag : RedPointItemBase	中文描述
---@field showSidTable table<number,boolean> 总是显示红点
---@field allItemIDTab number[]     params参数
local RedPointItemBag = _G.BaseClass("RedPointItemBag", base)
---需要展示红点的使用类型
local useTypes = {
    [_G.ItemUseType.GetResprop] = true,
    [_G.ItemUseType.ItemDrop] = true,
    [_G.ItemUseType.CompoundCard] = true,
    [_G.ItemUseType.GetProp] = true,
    [_G.ItemUseType.SelectProp] = true,
    [_G.ItemUseType.DrawCard] = true,
    [_G.ItemUseType.ProgressChest] = true,
    [_G.ItemUseType.TreasureMap] = true,
    [_G.ItemUseType.InterfaceJump] = true,
    [_G.ItemUseType.CompoundProp] = true,
    [_G.ItemUseType.Collection] = true,
    [_G.ItemUseType.GetXHourAfkAward] = true,
    [_G.ItemUseType.GetFrame] = true,
    [_G.ItemUseType.GetTitle] = true,
    [_G.ItemUseType.GetHalo] = true,
}
----红点道具id {203020200,203020200,....}
local showSids = {}
---展示红点使用类型的判定方法
local useFunc = {
    ---卡牌碎片合成
    [_G.ItemUseType.CompoundCard] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Debris, id)
        if num >= _G.tonumber(cfg.UseParameter[1][1]) then
            return 1
        end
        return 0
    end,
    ---卡牌碎片合成
    [_G.ItemUseType.DrawCard] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Debris, id)
        if num >= _G.tonumber(cfg.UseParameter[1][1]) then
            return 1
        end
        return 0
    end,
    ---物品合成
    [_G.ItemUseType.CompoundProp] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Debris, id)
        if num >= _G.tonumber(cfg.UseParameter[1][1]) then
            return 1
        end
        return 0
    end,
    ---根据条件领取奖励（进度宝箱）11
    [_G.ItemUseType.ProgressChest] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, id)
        local item_box_con_cfgID = tonumber(cfg.UseParameter[1][1])
        ---@type item_box_con_cfg
        local item_box_con_cfg = _G.ConfigManager.item_box_con_cfg[item_box_con_cfgID]
        ---@type PropData
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, id)
        local NowGetNum
        if itemData == nil then
            -- NowGetNum = 0
            return 0
        else
            NowGetNum = itemData.progress or 0
        end
        ---当前已领取索引

        ---可领取索引 1->  nil不能领取
        local CurSelectNum = nil
        local ispass
        for i, v in pairs(item_box_con_cfg.rewards) do
            local condition_params = item_box_con_cfg.condition_params[i]
            if condition_params ~= nil then
                if item_box_con_cfg.condition_type == 0 then
                    ispass = _G.GlobalConditionManager.CheckCondition(
                        _G.GlobalConditionManager.ConditionType.createRoleDay, condition_params,
                        itemData:GetProgressChestArgs().time)
                else
                    ispass = _G.GlobalConditionManager.CheckCondition(item_box_con_cfg.condition_type, condition_params)
                end
                if ispass then
                    CurSelectNum = i
                else
                    break
                end
            end
        end

        if CurSelectNum ~= nil then
            if CurSelectNum > NowGetNum then
                return 1
            end
        end
        return 0
    end,
    [_G.ItemUseType.InterfaceJump] = function(id)
        ---卡牌回退道具使用类型是跳转类型，但需要显示红点，所以需要特殊处理
        local resumeCfg = _G.ConfigManager.discrete_cfg[103712][1]
        if id ~= resumeCfg[1] then
            return 0
        end

        local num = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, id)
        if num > 0 and num > _G.PlayerPrefsManager.GetInt("CardRest_Prop_RedPoint", 0) then
            return 1
        end

        return 0
    end,
    [_G.ItemUseType.Collection] = function(id)
        local data = require("CollectionModel"):GetInstance():GetAllCollections()
        local currency
        for _, value in pairs(data) do
            currency = value.cfg.unlock_params
            if id == currency[1] and _G.StorageManager:GetInstance():CheckItem(currency[1], currency[2]) then
                return 1
            end
        end
        return 0
    end,
    --使用头像框
    [_G.ItemUseType.GetFrame] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        if _G.PlayerModel:GetInstance():IsUnlockFrame(tonumber(cfg.UseParameter[1][1])) then
            return 0
        end
        return 1
    end,
    --使用光环
    [_G.ItemUseType.GetHalo] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        local haloId = tonumber(cfg.UseParameter[1][1])
        local haolCfg = _G.ConfigManager.player_halo_effect_cfg[haloId] --限时光环可叠加时间
        if _G.PlayerModel:GetInstance():GetHaloData(haloId) and (not haolCfg or haolCfg.time_duration <= 0) then
            return 0
        end
        return 1
    end,
    --使用称号
    [_G.ItemUseType.GetTitle] = function(id)
        local cfg = _G.ConfigManager.item_cfg[id]
        if not cfg then
            return 0
        end
        local titleId = tonumber(cfg.UseParameter[1][1])
        local titleCfg = _G.ConfigManager.player_title_effect_cfg[titleId] --限时称号可叠加时间
        if _G.PlayerModel:GetInstance():GetTitleData(titleId) and (not titleCfg or titleCfg.time_duration <= 0) then
            return 0
        end
        return 1
    end,
}

local insert = _G.table.insert
---构造方法
---@param id number 红点ID
---@param child table 子节点ID组
---@return 变量类型 中文描述
function RedPointItemBag:__init()
    self.showSidTable = {}
    for i = 1, #showSids do
        self.showSidTable[showSids[i]] = true
    end
end

---类的析构函数
function RedPointItemBag:Dispose()
    self.showSidTable = nil
    self.allItemIDTab = nil
end

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemBag:GetAllParams()
    if not self.allItemIDTab then
        self.allItemIDTab = {}
    end
    return self.allItemIDTab
end

---添加新的参数(动态 比如邮箱新增邮件)
---@param param number 参数
function RedPointItemBag:AddParam(param)
    insert(self.allItemIDTab, param)
    base.AddParam(self, param)
end

---移除参数(动态 比如邮箱删除邮件)
---@param param number 参数
function RedPointItemBag:RemoveParam(param)
    for i, v in pairs(self.allItemIDTab) do
        if v == param then
            _G.table.remove(self.allItemIDTab, i)
            break
        end
    end
    base.RemoveParam(self, param)
end

---检查物品是否满足使用条件
---@param useType number 物品使用类型
---@param param number 物品id
---@return number 状态
function RedPointItemBag:CheckUseType(useType, param)
    if useTypes[useType] then
        if useFunc[useType] then
            return useFunc[useType](param)
        else
            return 1
        end
    end
    return 0
end

--endregion

return RedPointItemBag
