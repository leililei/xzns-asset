local base = require "RedPointItemBase"
local RedPointStoneDevelop = _G.BaseClass("RedPointStoneDevelop", base)

---检测所有红点
function RedPointStoneDevelop:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.StoneDevelop) then
        return 0
    end
    local itemId = _G.ConfigManager.discrete_cfg[102514][1][1]
    return _G.StorageManager:GetInstance():GetItemCountBySid(itemId) > 0 and 1 or 0
end

return RedPointStoneDevelop