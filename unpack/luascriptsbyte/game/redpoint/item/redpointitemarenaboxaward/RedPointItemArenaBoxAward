local ArenaManager = require("ArenaManager")
local base = require "RedPointItemBase"
---@class RedPointItemArenaBoxAward	中文描述
local RedPointItemArenaBoxAward = _G.BaseClass("RedPointItemArenaBoxAward", base)
--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaBoxAward:CheckFunctionOpenExtra()
    return ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal):GetCurArenaState() ==
        ArenaManager.State.open
end
---获取所有参数
---@return table 参数列表
function RedPointItemArenaBoxAward:GetAllParams()
    if self.allBoxPoints then
        return self.allBoxPoints
    end
    local cfg = _G.ConfigManager.arena_info_cfg[ArenaManager.arenaType.normal]
    self.allBoxPoints = {cfg.points_con1, cfg.points_con2, cfg.points_con3}
    return self.allBoxPoints
end
---检测全部
---@return number 红点数量
function RedPointItemArenaBoxAward:CheckAll()
    local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal)
    local winTimes = arenaClass:GetWinNum()
    local num = 0
    for i = 1, #self.allBoxPoints do
        if winTimes >= self.allBoxPoints[i] and not arenaClass:GetWinBoxState(self.allBoxPoints[i]) then
            num = num + 1
        end
    end
    return num
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemArenaBoxAward:CheckParams(param)
    local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal)
    local winTimes = arenaClass:GetWinNum() or 0
    if winTimes >= param and not arenaClass:GetWinBoxState(param) then
        return 1
    end
    return 0
end
--endregion

return RedPointItemArenaBoxAward
