local base = require "RedPointItemBase"
local SociatyProfoundModel = require("SociatyProfoundModel")

---@class RedPointSociatyProfound	每日成就页签
local RedPointSociatyProfound = _G.BaseClass("RedPointSociatyProfound", base)
--region子类重写

---检测全部
---@return number 红点数量
function RedPointSociatyProfound:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SociatyProfound) then
        return 0
    end
    return SociatyProfoundModel:GetInstance():CheckRedPoint() and 1 or 0
end

return RedPointSociatyProfound
