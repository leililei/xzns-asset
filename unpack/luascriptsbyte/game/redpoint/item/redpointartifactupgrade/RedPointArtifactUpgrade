local base = require "RedPointItemBase"
local CardInfoManager = require "CardInfoManager"

---@class RedPointArtifactUpgrade	每日成就页签
local RedPointArtifactUpgrade = _G.BaseClass("RedPointArtifactUpgrade", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointArtifactUpgrade:GetAllParams()
    local uidLis = {}
    ---@type CardData[]
    local artifacts = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    local insert = _G.table.insert
    local param
    for _, v in pairs(artifacts) do
        param = v.uid * 10
        for i = 1, 3 do ---升级，升星，觉醒
            insert(uidLis, param + i)
        end
    end
    return uidLis
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointArtifactUpgrade:CheckParams(param)
    local type = param % 10
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    ---@type ArtifactData
    local artifactData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Artifact, uid)
    if artifactData == nil then
        return 0
    end
    if artifactData.cardUid == 0 then
        return 0
    end
    -- local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    -- if not _G.table.ContainsValue(uidLis, artifactData.cardUid) then
    --     return 0
    -- end

    if not CardInfoManager.IsShowEquipCultivate(artifactData.cardUid) then
        return 0
    end

    if type == 1 then
        return artifactData:CanLvUp() and 1 or 0
    elseif type == 2 then
        return artifactData:CanStarUp() and 1 or 0
    elseif type == 3 then
        return artifactData:CanAwaken() and 1 or 0
    end
    return 0
end

function RedPointArtifactUpgrade:ParseParamForParent(param)
    return {_G.GameUtil.GetDivisionNumber(param,10)}
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointArtifactUpgrade:GetRedPointNumByParentParam(param)
    param = param * 10
    local num = 0
    for i = 1, 3 do
        if table.ContainsKey(self.paramNums,param + i) then
            num = num + self.paramNums[param + i]
        end
    end
    return num
end

return RedPointArtifactUpgrade
