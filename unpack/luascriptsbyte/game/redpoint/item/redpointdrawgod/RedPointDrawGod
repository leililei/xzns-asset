local base = require "RedPointItemBase"
---@class RedPointDrawGod	中文描述
local RedPointDrawGod = _G.BaseClass("RedPointDrawGod", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointDrawGod:GetAllParams()
    return {require("DrawModel"):GetInstance():GetGodCfg().ticket[1]}
end
---检测全部
---@return number 红点数量
function RedPointDrawGod:CheckAll()
    local model = require("DrawModel"):GetInstance()
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawGod",0)
    return (model:GengXingShuJu(model:GetGodCfg().ticket[1]) and num == 0) and 1 or 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointDrawGod:CheckParams(param)
    local model = require("DrawModel"):GetInstance()
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawGod",0)
    return (model:GengXingShuJu(model:GetGodCfg().ticket[1]) and num == 0) and 1 or 0
end
--endregion

return RedPointDrawGod
