local ArenaManager = require("ArenaManager")
local base = require "RedPointItemBase"
---@class RedPointItemArenaRankAward	中文描述
local RedPointItemArenaRankAward = _G.BaseClass("RedPointItemArenaRankAward", base)

--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaRankAward:CheckFunctionOpenExtra()
    return ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal):GetCurArenaState() ==
        ArenaManager.State.open
end
---获取所有参数
---@return table 参数列表
function RedPointItemArenaRankAward:GetAllParams()
    if self.allRankIDs then
        return self.allRankIDs
    end
    self.allRankIDs = _G.table.keys(_G.ConfigManager.arena_league_cfg)
    _G.table.sort(self.allRankIDs)
    return self.allRankIDs
end
---检测全部
---@return number 红点数量
function RedPointItemArenaRankAward:CheckAll()
    local controllerIns = require("ArenaController"):GetInstance()
    local managerIns = require("ArenaManager"):GetInstance()
    local num = 0
    local cfgs = _G.ConfigManager.arena_league_cfg
    local emptyTableCheck = _G.table.isEmptyOrNil
    for i = 1, #self.allRankIDs do
        if not emptyTableCheck(cfgs[self.allRankIDs[i]].reward_level) then
            if not managerIns:GetRankAwardState(ArenaManager.arenaType.normal, self.allRankIDs[i]) then
                if controllerIns:CheckRankAwardTo(self.allRankIDs[i]) then
                    num = num + 1
                end
            end
        end
    end
    return num
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemArenaRankAward:CheckParams(param)
    if _G.table.isEmptyOrNil(_G.ConfigManager.arena_league_cfg[param].reward_level) then
        return 0
    end
    local controllerIns = require("ArenaController"):GetInstance()
    local managerIns = require("ArenaManager"):GetInstance()
    if not managerIns:GetRankAwardState(ArenaManager.arenaType.normal, param) then
        if controllerIns:CheckRankAwardTo(param) then
            return 1
        end
    end
    return 0
end
--endregion

return RedPointItemArenaRankAward
