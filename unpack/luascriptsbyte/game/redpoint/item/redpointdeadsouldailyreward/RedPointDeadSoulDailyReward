local base = require "RedPointItemBase"
local DeadsoulTowerModel = require("DeadsoulTowerModel")

---@class RedPointDeadSoulDailyReward	每日成就页签
local RedPointDeadSoulDailyReward = _G.BaseClass("RedPointDeadSoulDailyReward", base)
--region子类重写

---检测全部
---@return number 红点数量
function RedPointDeadSoulDailyReward:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.DeadsoulMain) then
        return 0
    end
    return DeadsoulTowerModel:GetInstance():CheckRedPointDailyReward() and 1 or 0
end

return RedPointDeadSoulDailyReward
