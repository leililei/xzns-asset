local base = require "RedPointItemBase"
---@class RedPointPLLTLQ	蓬莱龙桃充值返利
local RedPointPLLTLQ = _G.BaseClass("RedPointPLLTLQ", base)

function RedPointPLLTLQ:GetAllParams()
    return {0}
end

function RedPointPLLTLQ:CheckAll()
    return self:CheckParams()
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPLLTLQ:CheckParams(param)
    local plThClass = require "PenglaiTreasureHouseManager":GetInstance():GetData()
    if plThClass then
        local isCanGet = plThClass.Info.old_cash_num > 0 and plThClass.Info.is_award == 0
        if isCanGet then
            return 1
        end

        local showTime =
            _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "PengLaiShowTime", 0)

        if showTime > 0 then
            if not _G.TimeUtil.CheckTheSameDayBySix(showTime, _G.TimeUtil.GetServerUnixTime()) then
                return 1
            end
        else
            return 1
        end
    end
    return 0
end
--endregion

return RedPointPLLTLQ
