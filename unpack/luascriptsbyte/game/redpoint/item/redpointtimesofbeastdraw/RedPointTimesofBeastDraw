local base = require "RedPointItemBase"
---@class RedPointTimesofBeastDraw    中文描述
local RedPointTimesofBeastDraw = _G.BaseClass("RedPointTimesofBeastDraw", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointTimesofBeastDraw:GetAllParams()
    return {-1}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointTimesofBeastDraw:CheckAll()
    if _G.AppSetting.DEBUG then
        _G.LogError("圣兽广告红点使用魔兽广告配置")
    end
    local param = 2004
    local admodel = require("AdvertisementModel"):GetInstance()
    if admodel:CheckADShow(param) then
        local nowTimes = admodel:GetADTimes(param)
        if nowTimes > 0 then
            return 1
        end
    end
    return 0
end
--endregion

return RedPointTimesofBeastDraw
