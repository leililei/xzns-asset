local base = require "RedPointItemBase"
---@class RedPointDouYinDesk:RedPointItemBase	中文描述
local RedPointDouYinDesk = _G.BaseClass("RedPointDouYinDesk", base)

--region子类重写
---@return table 参数列表
function RedPointDouYinDesk:GetAllParams()
    return { 1 }
end

---检测全部
---@return number 红点数量
function RedPointDouYinDesk:CheckParams(param)
    local model = require("DouyinModel"):GetInstance()
    if not model:CheckDouyinAppIconBtn() or model:GetDouyinAppIconAwardBol() then
        return 0
    end
    return 1
end

--endregion

return RedPointDouYinDesk
