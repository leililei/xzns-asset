local base = require "RedPointItemBase"
---@class RedPointVip 观影台红点
local RedPointVip = _G.BaseClass("RedPointVip", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointVip:GetAllParams()
    return {1}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointVip:CheckParams(param)
    local day=_G.PlayerPrefsManager.GetInt("VIPRedTime",0,false)
    if day==0 then
        return 1
    end
    day=_G.TimeUtil.GetInterValDayByGame(day,_G.TimeUtil.GetServerUnixTime())
    if day>=7 then
        return 1
    end
    return 0
end
--endregion

return RedPointVip