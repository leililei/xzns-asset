local base = require "RedPointItemBase"
---@class RedWheelOfFortune
local RedWheelOfFortune = _G.BaseClass("RedWheelOfFortune", base)
---检测全部
---@return number 红点数量
function RedWheelOfFortune:CheckAll()
    return require("WheelOfFortuneModel"):GetInstance():WheelhongDian() and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedWheelOfFortune:CheckFunctionOpenExtra()
    return require "SeasonManager".CheckSeasonIsOpen()
end

return RedWheelOfFortune
