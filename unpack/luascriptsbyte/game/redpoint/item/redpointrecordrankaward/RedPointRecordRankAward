local base = require "RedPointItemBase"
---@class RedPointRecordRankAward	中文描述
local RedPointRecordRankAward = _G.BaseClass("RedPointRecordRankAward", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointRecordRankAward:GetAllParams()
    if self.rankIds then
        return self.rankIds
    end
    self.rankIds = {}
    for i = 1, 9 do
        table.insert(self.rankIds, i)
    end
    return self.rankIds
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointRecordRankAward:CheckParams(param)
    --检测是否开启
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(48) then
        return 0
    end
    if param == 6 and not require("RecordRankModel"):GetInstance():CheckGodShow() then
        return 0
    end
    ---检测是否有奖励
    return require("RecordRankModel"):GetInstance():HasAwardReceive(param) and 1 or 0
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointRecordRankAward:ParseParamForParent(param)
    return {param}
end

--endregion

return RedPointRecordRankAward
