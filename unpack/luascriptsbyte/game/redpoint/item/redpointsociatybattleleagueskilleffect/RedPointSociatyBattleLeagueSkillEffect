local base = require "RedPointItemBase"
---@class RedPointSociatyBattleLeagueSkillEffect	中文描述
local RedPointSociatyBattleLeagueSkillEffect = _G.BaseClass("RedPointSociatyBattleLeagueSkillEffect", base)

function RedPointSociatyBattleLeagueSkillEffect:GetAllParams()
    return {1, 2}
end

---检测全部
---@return number 红点数量
function RedPointSociatyBattleLeagueSkillEffect:CheckParams(param)
    local index = _G.PlayerPrefsManager.GetInt("SociatyBattleLeagueSkillShowViewRed"..param, 0)
    local SeasonId = require "SociatyBattleLeagueModel":GetInstance():GetSeasonId()
    if index < SeasonId then
        return 1
    end
    return 0
end

--endregion

return RedPointSociatyBattleLeagueSkillEffect