local base = require("RedPointItemBase")
local CardInfoManager = require("CardInfoManager")

---@class RedpointEquipmentPart	中文描述
local RedpointEquipmentPart = _G.BaseClass("RedpointEquipmentPart", base)
local table = _G.table

--region子类重写
---获取所有参数
---@return table 参数列表
function RedpointEquipmentPart:GetAllParams()
    if self.allEquipmentIDs then
        return self.allEquipmentIDs
    end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self.allEquipmentIDs = {}

    ---@param value CardData
    local part_uid
    for _, cardData in pairs(cards) do
        for _, v in pairs(_G.EquipmentPart) do
            if v ~= _G.EquipmentPart.Trousers then
                part_uid = cardData.uid * 10 + v
                table.insert(self.allEquipmentIDs, part_uid)
            end
        end
    end
    return self.allEquipmentIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedpointEquipmentPart:CheckParams(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    if not CardInfoManager.IsShowYc(uid) then
        ---没有勾选培养按钮
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local part = _G.math.fmod(param, 10)
    if not cardData or table.isEmptyOrNil(cardData.EquipBar[part]) then
        ---没有穿戴该部位的装备
       return 0
    end

    ---@field equipmentItem EquipmentItem
    local equipmentItem = cardData.EquipBar[part]
    if equipmentItem:IsMAxStreng() then
        ---已强化到最大等级
       return 0
    end
    return require("EquipmentModel"):GetInstance():CheckUPMaterial(equipmentItem)
end

function RedpointEquipmentPart:ParseParamForParent(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    return {uid}
end

function RedpointEquipmentPart:GetRedPointNumByParentParam(param)
    local num = 0
    for _, v in pairs(_G.EquipmentPart) do
        if v ~= _G.EquipmentPart.Trousers then
            local point = self:GetRedPointNum(param * 10 + v)
            if point then
                num = num + point
            end
        end
    end

    return num
end

return RedpointEquipmentPart
