local base = require "RedPointItemBase"
---@class RedPointDrawRewar:RedPointItemBase	累抽奖励红点
local RedPointDrawReward = _G.BaseClass("RedPointDrawReward", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointDrawReward:GetAllParams()
    return { 0 }
end

---检测全部
---@return number 红点数量
function RedPointDrawReward:CheckAll()
    ---@type DrawModel 
    local model = require("DrawModel"):GetInstance()
    -- if model:GetDrawRewardRedRead() then
    --     return 0
    -- end
    if (model.exit_num - model.NextAward.LastTime) >= model.NextAward.num then
        return 1
    end
    return 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointDrawReward:CheckParams(param)
    ---@type DrawModel 
    local model = require("DrawModel"):GetInstance()
    -- if model:GetDrawRewardRedRead() then
    --     return 0
    -- end
    if (model.exit_num - model.NextAward.LastTime) >= model.NextAward.num then
        return 1
    end
    return 0
end

return RedPointDrawReward
