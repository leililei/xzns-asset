local base = require "RedPointItemBase"
---@class RedPointFirstTestBoss	中文描述
local RedPointFirstTestBoss = _G.BaseClass("RedPointFirstTestBoss", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointFirstTestBoss:GetAllParams()
    return {0, 1}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointFirstTestBoss:CheckParams(param)
    return require "FirstTestBossModel":GetInstance():CheckRedPoint(param) and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointFirstTestBoss:CheckFunctionOpenExtra()
    return require "SeasonManager".CheckSeasonIsOpen()
end

--endregion

return RedPointFirstTestBoss
