local base = require "RedPointItemBase"
---@class RedPointRuneStrength	中文描述
local RedPointRuneStrength = _G.BaseClass("RedPointRuneStrength", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointRuneStrength:GetAllParams()
    if self.allDecorationIDs then
       return self.allDecorationIDs
    end

    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local table = _G.table
    self.allDecorationIDs = {}
    for _, value in pairs(cards) do
        table.insert(self.allDecorationIDs, value.uid)
    end
    return self.allDecorationIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointRuneStrength:CheckParams(param)
    if _G.table.indexof(self.allDecorationIDs, param) == false then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    if _G.table.isEmptyOrNil(cardData) then
        return 0
    end

    local decorationBar = cardData.DecorationBar
    if decorationBar then
        local model = require("RuneModel"):GetInstance()
        local cfg = _G.ConfigManager.decoration_stren_cfg
        local StorageManager = _G.StorageManager:GetInstance()
        for _, v in pairs(decorationBar) do
            if v and not _G.table.isEmptyOrNil(v.decoration) and cfg[v.slotLevel] and model:CheckCanStrength(cardData, v.slotLevel or 0) then
                local id, num = model:GetStrenMaterial(v.slotLevel or 0)
                if StorageManager:CheckItem(id, num) then
                    return 1
                end
            end
        end
    end
    return 0
end

function RedPointRuneStrength:AddParam(param)
    if _G.table.indexof(self.allDecorationIDs, param) == false then
        _G.table.insert(self.allDecorationIDs, param)
    end
    base.AddParam(self, param)
end

function RedPointRuneStrength:RemoveParam(param)
    for i, v in pairs(self.allDecorationIDs) do
        if v == param then
            _G.table.remove(self.allDecorationIDs, i)
            break
        end
    end
    base.RemoveParam(self, param)
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointRuneStrength:ParseParamForParent(param)
    return { param }
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointRuneStrength:GetRedPointNumByParentParam(param)
    if not require("EmbattleModel"):GetInstance():CheckInEmbattle(param, _G.EmbattleType.AFKOnly) then
        return 0
    end
    return self.paramNums[param] or 0
end

--endregion

return RedPointRuneStrength
