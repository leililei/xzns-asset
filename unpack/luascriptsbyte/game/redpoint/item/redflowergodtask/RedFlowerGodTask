---花神战令红点检测
local function FlowerGodBattlePassCheck()
    if not CycleBattlePassModel:CheckBpIsUnLock(CycleBattlePassModel.BattlePassIDEnum.FlowerGod) then
        return
    end
    local lv = CycleBattlePassModel:GetLvAndCurLvExp(CycleBattlePassModel.BattlePassIDEnum.FlowerGod)
    local awardList = CycleBattlePassModel:GetAllUnlockAwards(CycleBattlePassModel.BattlePassIDEnum.FlowerGod,lv)
    return table.count(awardList) > 0 and 1 or 0
end

---花神战令任务红点检测
local function FlowerGodTaskCheck()
    if not CycleBattlePassModel:CheckBpIsUnLock(CycleBattlePassModel.BattlePassIDEnum.FlowerGod) then
        return
    end
    local lv = CycleBattlePassModel:GetLvAndCurLvExp(CycleBattlePassModel.BattlePassIDEnum.FlowerGod)
    local taskList = CycleBattlePassModel:GetAllUnlockAwards(CycleBattlePassModel.BattlePassIDEnum.FlowerGod,lv)
    if table.count(taskList) then
        local taskIdList = CycleBattlePassModel:GetAllCanFinishTask(CycleBattlePassModel.BattlePassIDEnum.FlowerGod)
        return table.count(taskIdList) > 0 and 1 or 0
    end
    return 0
end

---花神战令商店红点检测
---@param param number
local function FlowerGodShopCheck(param)
    if not CycleBattlePassModel:CheckBpIsUnLock(CycleBattlePassModel.BattlePassIDEnum.FlowerGod) then
        return
    end
    local shopId = FlowerGodBattlePassSynModel.ShopId
    local shop = ShopModel:GetShop()
    local shopData = shop[shopId]
    local isHit = false
    if shopData then
        ---@type ShopItemData[]
        local shopDataList = shopData.SPitem
        if shopDataList then
            for _, data in pairs(shopDataList) do
                if data.limit > 0 then
                    if data.price == 0  and  data.BuyTime < data.limit then
                        --价格为0的商品显示红点
                        isHit = true
                        break
                    end
                end
            end
        end
    end
    return isHit and 1 or 0
end

