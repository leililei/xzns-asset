local base = require "RedPointItemBase"
---@class RedPointCardFetter	中文描述
local RedPointCardFetter = _G.BaseClass("RedPointCardFetter", base)
local floor = _G.math.floor
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCardFetter:GetAllParams()
    local tb = {}
    self.cardSid = {}
    local insert = _G.table.insert
    for _, v in pairs(_G.ConfigManager.card_cfg) do
        for _, v2 in pairs(v.fetter) do
            for i = 1, _G.CardFetterParams.AttrCount do
                insert(tb, v2 * 100 + i)
                self.cardSid[v2 * 100 + i] = {card_sid = v.id, fetter_sid = v2, index = i}
            end
        end
    end
    return tb
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCardFetter:CheckParams(param)
    local data = self.cardSid[param]
    if data then
        return require("CardFetterManager"):GetInstance():CheckIsCanActiveSingle(
            data.card_sid,
            data.fetter_sid,
            data.index
        ) and
            1 or
            0
    else
        return 0
    end
end

function RedPointCardFetter:ParseParamForParent(param)
    return {floor(param / 100)}
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointCardFetter:GetRedPointNumByParentParam(param)
    local num = 0
    for i = 1, _G.CardFetterParams.AttrCount do
        local point = self:GetRedPointNum(param * 100 + i)
        if point then
            num = num + point
        end
    end
    return num
end

--endregion

return RedPointCardFetter
