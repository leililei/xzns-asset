local base = require "RedPointItemBase"
---@class RedPointSpoilsRecycle	战利品抽卡红点
local RedPointSpoilsRecycle = _G.BaseClass("RedPointSpoilsRecycle", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSpoilsRecycle:GetAllParams()
    return { 0 }
end

---检测全部
---@return number 红点数量
function RedPointSpoilsRecycle:CheckAll()
    local SpoilsModel = require("SpoilsModel"):GetInstance()
    local lists1 = SpoilsModel:GetOverflowByOder(_G.SpoilsQuilty.cheng)
    local lists2 = SpoilsModel:GetOverflowByOder(_G.SpoilsQuilty.hong)
    local lists3 = SpoilsModel:GetOverflowByOder(_G.SpoilsQuilty.cai)

    local max1 = SpoilsModel:GetStarMaxOder(_G.SpoilsQuilty.cheng)
    local max2 = SpoilsModel:GetStarMaxOder(_G.SpoilsQuilty.hong)
    local max3 = SpoilsModel:GetStarMaxOder(_G.SpoilsQuilty.cai)

    local show = ((max1 and #lists1 > 0) or (max2 and #lists2 > 0) or (max3 and #lists3 > 0)) and 1 or 0

    return show
end

--endregion

return RedPointSpoilsRecycle
