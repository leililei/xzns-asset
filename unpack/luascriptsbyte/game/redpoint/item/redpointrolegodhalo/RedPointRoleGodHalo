local base = require "RedPointItemBase"
local PlayerModel = require("PlayerModel")
local CardInfoManager = require("CardInfoManager")

---@class RedPointRoleGodHalo	神环上阵红点
local RedPointRoleGodHalo = _G.BaseClass("RedPointRoleGodHalo", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointRoleGodHalo:GetAllParams()
    local uidLis = {}
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)

    local insert = _G.table.insert
    for _, v in pairs(cards) do
        insert(uidLis, v.uid)
    end
    return uidLis
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointRoleGodHalo:CheckParams(param)
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not _G.table.ContainsValue(uidLis, param) then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cardData.sid)
    
    --- 神环栏位为空且有没有被佩戴的神环展示红点
    if godHaloID == 0 then
        local godHalos = _G.PlayerModel:GetInstance():GetAllUnlockGodHalo()
        local hasUnuse = false
        for _, v in pairs(godHalos) do
            if _G.PlayerModel:GetInstance():IsGodHaloWear(v.k) == 1 then
                hasUnuse = true
                break
            end
        end
        return hasUnuse and 1 or 0
    else
        local WearSkillID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(godHaloID)
        --- 有神环且神环有技能 不展示红点
        if WearSkillID > 1 then
            return 0
        else
            return 1
        end
    end
end

function RedPointRoleGodHalo:ParseParamForParent(param)
    return { param }
end

return RedPointRoleGodHalo
