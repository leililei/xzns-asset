local base = require "RedPointItemBase"
---@class RedPointItemAchievementBadge	每日任务活跃度大宝箱
local RedPointItemAchievementBadge = _G.BaseClass("RedPointItemAchievementBadge", base)

--region子类重写
---检测全部
---@return number 红点数量
function RedPointItemAchievementBadge:CheckAll()
    self.ActiveTaskManager = require("ActiveTaskManager"):GetInstance()

    local loopValue_Max = self.ActiveTaskManager.GetCjPointLevel
    local lv, curExp, maxExp = self.ActiveTaskManager:GetLevel()
    self.BoxLevel = lv
    if loopValue_Max == _G.table.count(_G.ConfigManager.ach_stage_cfg) then
        return 0
    end

    if self.BoxLevel > loopValue_Max then
        return 1
    else
        return 0
    end
end

--endregion

return RedPointItemAchievementBadge
