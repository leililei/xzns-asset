local base = require "RedPointItemBase"
---@class RedPointArtifact	神器红点(额外检测功能是否开启, 功能开启后需要刷新)
local RedPointArtifact = _G.BaseClass("RedPointArtifact", base)

--region子类重写
---检测全部
---@return number 红点数量
function RedPointArtifact:CheckAll()
    if not self:CheckFunctionOpenExtra() then
        return 0
    end
    return base.CheckAll(self)
end
---@return number 红点数量
function RedPointArtifact:GetRedPointNum(param, isparentparam)
    if not self:CheckFunctionOpenExtra() then
        return 0
    end
    return base.GetRedPointNum(self, param, isparentparam)
end
---检测神器功能是否已开启
---@return boolean
function RedPointArtifact:CheckFunctionOpenExtra()
    return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(145)
end

--endregion

return RedPointArtifact
