local base = require "RedPointItemBase"
---@class RedPointWeixinSide:RedPointItemBase	中文描述
local RedPointWeixinSide = _G.BaseClass("RedPointWeixinSide", base)

--region子类重写
---@return table 参数列表
function RedPointWeixinSide:GetAllParams()
    return { 1 }
end

---检测全部
---@return number 红点数量
function RedPointWeixinSide:CheckParams(param)
    local model = require("DouyinModel"):GetInstance()
    if model:GetDouyinSideBarAwardBol() then
        return 0
    end
    return 1
end

--endregion

return RedPointWeixinSide
