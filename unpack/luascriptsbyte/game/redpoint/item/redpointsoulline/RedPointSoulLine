local base = require "RedPointItemBase"
---@class RedPointSoulLine : RedPointItemBase
local RedPointSoulLine = _G.BaseClass("RedPointSoulLine", base)
local CardInfoManager = require "CardInfoManager"
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSoulLine:GetAllParams()
    if self.allSoulLineIDs then
        return self.allSoulLineIDs
    end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local table = _G.table
    local part_uid
    self.limitstart = _G.ConfigManager.discrete_cfg[102401][1][1]
    self.maxstart = _G.ConfigManager.discrete_cfg[102402][1][1]
    self.limitorder = _G.ConfigManager.discrete_cfg[102403][1][1]

    self.allSoulLineIDs = {}

    ---@param value CardData
    for _, value in pairs(cards) do
        if self:CheckIsNotLimit(value) then
            part_uid = value.uid * 10 + 1
            table.insert(self.allSoulLineIDs, part_uid)
        end
    end
    return self.allSoulLineIDs
end

---@param card CardData
function RedPointSoulLine:CheckIsNotLimit(card)
    if card.cfg.Order < self.limitorder or card:GetStar() < self.limitstart or card.soulLink_lv >= self.maxstart then
        return false
    end
    return true
end

---添加一个新的参数
function RedPointSoulLine:AddParam(param)
    if false == _G.table.indexof(self.allSoulLineIDs, param) then
        local uid = _G.GameUtil.GetDivisionNumber(param,10)
        ---@type CardData
        local value = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
        if self:CheckIsNotLimit(value) then
            _G.PlayerPrefsManager.SetInt(_G.CardHunLian.CardHunLianFirstSaveKey .. param, 1)
            table.insert(self.allSoulLineIDs, param)
            base.Check(self, param)
        end
    else
        require "RedPointManager":GetInstance():RefreshNode(self.id, param)
    end
end

function RedPointSoulLine:RemoveParam(param)
    for i, v in pairs(self.allSoulLineIDs) do
        if v == param then
            table.remove(self.allSoulLineIDs, i)
            break
        end
    end
    base.RemoveParam(self, param)
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSoulLine:CheckParams(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    if not CardInfoManager.IsShowYc(uid) then
        return 0
    end
    if _G.PlayerPrefsManager.HasKey(_G.CardHunLian.CardHunLianSaveKey .. param) then
        return 0
    end
    if _G.PlayerPrefsManager.HasKey(_G.CardHunLian.CardHunLianFirstSaveKey .. param) then
        return 1
    end
    local chlm = require "CardHunLianModel":GetInstance()
    ---@type CardData
    local Card

    --(string.format("魂链红点...卡牌的id：%s", uid))
    Card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    if not self:CheckIsNotLimit(Card) then
        return 0
    end

    -- --魂链是否激活
    -- if Card.soulLink_IsActivate == 0 then
    --     return 0
    -- end
    local maxstart = self.maxstart
    if Card.soulLink_lv >= maxstart then
        return 0
    end
    if Card.shenshiPosType == _G.StonePosType.PosZero then
        --卡牌自身等级 大于1 才显示红点
        if Card:GetLevel() < 2 then
            return 0
        end
    end

    --道具 是否足够
    local limit
    local item
    if chlm:ChangeMaterial(Card.sid, Card.soulLink_lv) then
        item = chlm:GetHLItem(Card.sid, Card.soulLink_lv + 1)
        limit = item[2]
    else
        item = chlm:GetHLItem(Card.sid, Card.soulLink_lv)
        limit = chlm:GetItemLimit(Card.sid, Card.soulLink_lv)
    end
    local itemCount = chlm:GetBagItemNumber(_G.StorageID.Material, item[1])
    if itemCount >= limit then
        return 1
    end
    return 0
end
function RedPointSoulLine:ParseParamForParent(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    return {uid}
end
function RedPointSoulLine:GetRedPointNumByParentParam(param)
    local num = 0
    param = param * 10
    local point = self:GetRedPointNum(param + 1)
    if point then
        num = num + point
    end
    return num
end
--endregion

return RedPointSoulLine
