local base = require "RedPointItemBase"

---@class RedPointArtifactUpgradeAny	每日成就页签
local RedPointArtifactUpgradeAny = _G.BaseClass("RedPointArtifactUpgradeAny", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointArtifactUpgradeAny:GetAllParams()
    local uidLis = {}
    ---@type CardData[]
    local artifacts = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact)
    local insert = _G.table.insert
    for _, v in pairs(artifacts) do
        insert(uidLis, v.uid)
    end
    return uidLis
end

function RedPointArtifactUpgradeAny:ParseParamForParent(param)
    return {param}
end

return RedPointArtifactUpgradeAny
