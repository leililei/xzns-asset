local base = require "RedPointItemBase"
---@class RedPointDungeonChallengeTask    中文描述
local RedPointDungeonChallengeTask = _G.BaseClass("RedPointDungeonChallengeTask", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointDungeonChallengeTask:GetAllParams()
    if self.allIDs then
        return self.allIDs
    end
    local table = _G.table
    self.allIDs = {}
    local cfgs = _G.ConfigManager.dungeon_challenge_task_group_cfg
    for i = 1, #cfgs do
        table.insert(self.allIDs, i)
    end
    return self.allIDs
end
---检测全部
---@return number 红点数量
function RedPointDungeonChallengeTask:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.DungeonChallenge) then
        return 0
    end
    local cfgs = _G.ConfigManager.dungeon_challenge_task_group_cfg
    for i = 1, #cfgs do
        if require "DungeonChallengeModel":GetInstance():CheckTaskRedByType(i) == true then
            return 1
        end
    end
    return 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointDungeonChallengeTask:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.DungeonChallenge) then
        return 0
    end
    return require "DungeonChallengeModel":GetInstance():CheckTaskRedByType(param) == true and 1 or 0
end
--endregion

return RedPointDungeonChallengeTask