local base = require "RedPointItemBase"
---@class RedPointRecordRankMain	中文描述
local RedPointRecordRankMain = _G.BaseClass("RedPointRecordRankMain", base)

---获取所有参数
---@return table 参数列表
function RedPointRecordRankMain:GetAllParams()
    if self.allLingRankIDs then
        return self.allLingRankIDs
    end
    local table = _G.table
    self.allLingRankIDs = {}
    for i = 1, 9 do
        table.insert(self.allLingRankIDs, i)
    end
    return self.allLingRankIDs
end

return RedPointRecordRankMain
