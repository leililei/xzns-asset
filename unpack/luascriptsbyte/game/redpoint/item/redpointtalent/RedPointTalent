local base = require "RedPointItemBase"
---@class RedPointTalent	中文描述
---@field enableStar number     @达到指定星级时, 开启灵脉
local RedPointTalent = _G.BaseClass("RedPointTalent", base)
local CardInfoManager = require "CardInfoManager"

function RedPointTalent:__init()
    local cfg = _G.ConfigManager.discrete_cfg[107401]
    self.enableStar = cfg and cfg[1][1] or 999
end

--region子类重写

---获取所有参数
---@return table 参数列表
function RedPointTalent:GetAllParams()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)

    local card = {}
    for _, value in pairs(cards) do
        local order = value.cfg.Order
        local talent = value.cfg.talent
        ---满足天赋展示要求的卡片
        if order >= 3 and #talent > 0 then
            _G.table.insert(card, value.uid)
        end
    end
    return card
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointTalent:ParseParamForParent(param)
    return {param}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointTalent:CheckParams(param)
    ---@type CardData
    local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    if not data or data.cfg == nil then
        _G.LogWarning(param, "刷新天赋参数异常")
        return 0
    end

    local order = data.cfg.Order
    local talent = data.cfg.talent
    ---不满足天赋展示要求的卡片
    if order < 3 or #talent <= 0 then
        return 0
    end
    ---彩色及以上才可点灵脉
    if data:GetStar() < self.enableStar then
        return 0
    end

    local model = require "TalentModel":GetInstance()
    local everyLevelTalentNeed = model:TalenNeedNum() --每一级消耗的天赋点点数

    --培养提示: 有角色专属天赋点时不管有没有勾选直接提醒, 有通用天赋点时勾选提示才提醒
    if not CardInfoManager.IsShowYc(param) and data.inborn_num < everyLevelTalentNeed then
        return 0
    end

    --满足天赋展示要求的卡片
    for i = 1, #talent do
        local tt = talent[i]
        for j = 1, #tt do
            ---@type attribute_cfg
            local cfg = _G.ConfigManager.attribute_cfg[tt[j]]

            local isOpen = model:CheckPointOpen(cfg.id)
            if not isOpen then
                if data.inborn_num >= everyLevelTalentNeed then
                    return 1
                end

                if data.inborn_cost_num < model:MaxUseMatrialNum() then
                    local sid, num = model:MaxMatrialNum()
                    local matrialNum = _G.StorageManager:GetInstance():GetItemCountByID(102, sid)
                    if matrialNum >= num then
                        return 1
                    end
                end
            end
        end
    end
    return 0
end

--endregion

return RedPointTalent
