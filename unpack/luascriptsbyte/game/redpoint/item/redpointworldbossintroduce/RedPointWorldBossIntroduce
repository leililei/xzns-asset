local base = require "RedPointItemBase"
---@class RedPointWorldBossIntroduce	中文描述
local RedPointWorldBossIntroduce = _G.BaseClass("RedPointWorldBossIntroduce", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointWorldBossIntroduce:GetAllParams()
    local params = {}
    for _, v in ipairs(_G.ConfigManager.discrete_cfg[100133][1]) do
        _G.table.insert(params, v)
    end
    return params
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointWorldBossIntroduce:CheckParams(param)
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "_WorldBossIntroduce"..param,0)
    return num==0 and 1 or 0
end

return RedPointWorldBossIntroduce