local base = require "RedPointItemBase"
---@class RedPointSwornGift	收到礼物
local RedPointSwornGift = _G.BaseClass("RedPointSwornGift", base)

function RedPointSwornGift:GetAllParams()
    return {0}
end

function RedPointSwornGift:CheckAll()
    return self:CheckParams()
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSwornGift:CheckParams(param)
    if _G.PlayerPrefsManager.GetInt("SwornGiftBox") == 1 then
        return 1
    end
    return 0
end
--endregion

return RedPointSwornGift
