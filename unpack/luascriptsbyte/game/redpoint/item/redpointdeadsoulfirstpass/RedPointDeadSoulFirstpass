local base = require "RedPointItemBase"
---@class RedPointDeadSoulFirstpass	死魂塔 首通奖励（额外奖励）
local RedPointDeadSoulFirstpass = _G.BaseClass("RedPointDeadSoulFirstpass", base)

--region子类重写
--region子类重写
---@return table 参数列表
function RedPointDeadSoulFirstpass:GetAllParams()
    if self.allSoulLineIDs then
        return self.allSoulLineIDs
    end
    self.allSoulLineIDs = {}
    --五行塔 （1- 5）
    for i = 1, 5 do
        table.insert(self.allSoulLineIDs, i)
    end
    --主塔 9
    table.insert(self.allSoulLineIDs, 9)
    return self.allSoulLineIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointDeadSoulFirstpass:CheckParams(param)
    return require "DeadsoulTowerModel":GetInstance():CheckRedpointTowerExtraAward(param) == true and 1 or 0
end

--endregion

return RedPointDeadSoulFirstpass
