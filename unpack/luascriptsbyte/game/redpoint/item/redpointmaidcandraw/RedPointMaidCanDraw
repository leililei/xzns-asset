local base = require "RedPointItemBase"
---@class RedPointMaidCanDraw 放置挂机红点
local RedPointMaidCanDraw = _G.BaseClass("RedPointMaidCanDraw", base)

--region子类重写
---检测全部
---@return number 红点数量
function RedPointMaidCanDraw:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Maid) then
       return 0 
    end
    return require "MaidAcademyModel":GetInstance():CanDraw() or 0
end
--endregion

return RedPointMaidCanDraw