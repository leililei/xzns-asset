local base = require "RedPointItemBase"
---@class RedPointBounty	中文描述
local RedPointBounty = _G.BaseClass("RedPointBounty", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointBounty:GetAllParams()
    local tb = {}
    tb[1] = 0
    tb[2] = 1
    local datas = require "BountySystemManager":GetInstance().taskDatas
    if datas then
        for k, _ in pairs(datas) do
            _G.table.insert(tb, k)
        end
    end

    return tb
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointBounty:CheckParams(param)
    return require "BountySystemManager":GetInstance():CheckIsCanTask(param) and 1 or 0
end
--endregion

return RedPointBounty
