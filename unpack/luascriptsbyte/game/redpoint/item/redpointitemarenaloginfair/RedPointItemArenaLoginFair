local base = require "RedPointItemBase"
---@class RedPointItemArenaLoginFair	中文描述
local RedPointItemArenaLoginFair = _G.BaseClass("RedPointItemArenaLoginFair", base)
---公平竞技场SID
local arenaSid = 3
--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaLoginFair:CheckFunctionOpenExtra()
    local ArenaManager = require("ArenaManager")
    return ArenaManager:GetInstance():GetArenaClass(arenaSid):GetCurArenaState() == ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaLoginFair:CheckAll()
    return require("ArenaController"):GetInstance():CheckLoginFirstByDay(arenaSid) and 1 or 0
end
--endregion

return RedPointItemArenaLoginFair
