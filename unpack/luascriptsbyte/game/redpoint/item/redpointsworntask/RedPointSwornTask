local base = require "RedPointItemBase"
---@class RedPointSwornTask	任务
local RedPointSwornTask = _G.BaseClass("RedPointSwornTask", base)

function RedPointSwornTask:GetAllParams()
    return {0}
end

function RedPointSwornTask:CheckAll()
    return self:CheckParams()
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSwornTask:CheckParams(param)
    if _G.PlayerPrefsManager.GetInt("SwornTaskFirst") == 1 then
        return 1
    end
    local task = require "SwornModel":GetInstance().Task
    if task then
        for i = 1, #task do
            if task[i].i_task.state == _G.TaskEnum.ETaskState.Submited then
                return 1
            end
        end
    end
    return 0
end
--endregion

return RedPointSwornTask
