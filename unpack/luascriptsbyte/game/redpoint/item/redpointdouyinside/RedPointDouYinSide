local base = require "RedPointItemBase"
---@class RedPointDouYinSide:RedPointItemBase	中文描述
local RedPointDouYinSide = _G.BaseClass("RedPointDouYinSide", base)

--region子类重写
---@return table 参数列表
function RedPointDouYinSide:GetAllParams()
    return { 1 }
end

---检测全部
---@return number 红点数量
function RedPointDouYinSide:CheckParams(param)
    local model = require("DouyinModel"):GetInstance()
    if not model:CheckDouyinSideBarBtn() or model:GetDouyinSideBarAwardBol() then
        return 0
    end
    return 1
end

--endregion

return RedPointDouYinSide
