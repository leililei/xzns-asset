local base = require "RedPointItemBase"
local PetForestModel = require("PetForestModel")

---@class RedPointPetForestBetterPosition	灵兽之森-一键上阵
local RedPointPetForestPositionBetter = _G.BaseClass("RedPointPetForestPositionBetter", base)
--region子类重写

function RedPointPetForestPositionBetter:GetAllParams()
    return { 0 }
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPetForestPositionBetter:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Pet) then
        return 0
    end
    return PetForestModel:GetInstance():CheckRedPointPosBetter() and 1 or 0
end

return RedPointPetForestPositionBetter
