local base = require "RedPointItemBase"
---@class RedPointWarTechnologyUpLv    死魂塔礼包
local RedPointWarTechnologyUpLv = _G.BaseClass("RedPointWarTechnologyUpLv", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointWarTechnologyUpLv:GetAllParams()
    if self.allIDs then
        return self.allIDs
    end
    local table = _G.table
    self.allIDs = {}
    local cfg = _G.ConfigManager.technology_layer_cfg
    local layerNum = #cfg
    for i = 1, layerNum do
        table.insert(self.allIDs, i)
    end
    return self.allIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointWarTechnologyUpLv:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.WarTechnology) then
        return 0
    end
    return require "WarTechnologyModel":GetInstance():GetLayerUpLvRed(param) and 1 or 0
end

---检测全部
---@return number 红点数量
function RedPointWarTechnologyUpLv:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.WarTechnology) then
        return 0
    end
    return require("WarTechnologyModel"):GetInstance():CheckUpLvRed() and 1 or 0
end

--endregion

return RedPointWarTechnologyUpLv