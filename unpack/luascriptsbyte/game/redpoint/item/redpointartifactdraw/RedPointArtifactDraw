local base = require "RedPointItemBase"
local ArtifactDrawModel = require("ArtifactDrawModel")

---@class RedPointArtifactDraw	每日成就页签
local RedPointArtifactDraw = _G.BaseClass("RedPointArtifactDraw", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointArtifactDraw:GetAllParams()
    return ArtifactDrawModel.MaterialType
end
---检测全部
---@return number 红点数量
function RedPointArtifactDraw:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw) then
        return 0
    end
    return ArtifactDrawModel:GetInstance():CheckMaterial() and 1 or 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointArtifactDraw:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ArtifactDraw) then
        return 0
    end
    return ArtifactDrawModel:GetInstance():CheckMaterial(param) and 1 or 0
end

return RedPointArtifactDraw
