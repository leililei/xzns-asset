---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointCardFetter_Extend:ParseParamForParent(param)
    local sid = self.cardSid[param]
    if not sid then
        return nil
    end
    local tb = {}
    local datas = _G.StorageManager:GetInstance():GetDatasBySid(_G.StorageID.Card, sid)
    local insert = _G.table.insert
    for _, v in pairs(datas) do
        insert(tb, v.uid)
    end
    return tb
end

function RedPointCardFetter_Extend:GetRedPointNumByParentParam(param)
    local num = 0
    local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    if data and data.cfg then
        for _, v in pairs(data.cfg.fetter) do
            local point = self:GetRedPointNum(v)
            if point then
                num = num + point
            end
        end
    end

    return num
end
