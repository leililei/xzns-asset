---@return table 参数列表
function RedPointCardFetter_Extend:GetAllParams()
    local tb = {}
    self.cardSid = {}
    local insert = _G.table.insert
    for _, v in pairs(_G.ConfigManager.card_cfg) do
        for _, v2 in pairs(v.fetter) do
            insert(tb, v2)
            self.cardSid[v2] = v.id
        end
    end
    return tb
end

