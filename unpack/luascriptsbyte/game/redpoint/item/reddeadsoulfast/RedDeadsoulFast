local base = require "RedPointItemBase"
---@class RedDeadsoulFast	中文描述
local RedDeadsoulFast = _G.BaseClass("RedDeadsoulFast", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedDeadsoulFast:GetAllParams()
    return {1}
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedDeadsoulFast:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(22) then
        return 0
    end
    local TowerInfo = require "DeadsoulTowerModel":GetInstance():InitTowerInfo(9)
    local IsFinishFloor = require "DeadsoulTowerModel":GetInstance().LandFloor or 0
    local cfg = _G.ConfigManager.tower_cfg
    if IsFinishFloor > 0 then
        if cfg[IsFinishFloor] then
        else
            return 0
        end
        IsFinishFloor = cfg[IsFinishFloor].layer
    end
    ---检测是否是最后一层
    if IsFinishFloor >= #TowerInfo then
        return 0
    end
    local floor = IsFinishFloor
    if IsFinishFloor + 1 < #TowerInfo then
        floor = IsFinishFloor + 1
    end
    if floor <= 1 then
        return 0
    end
    local flag = _G.DeadsoulTowerManager:GetInstance():CheckQuickPower(TowerInfo[floor].id) --require "DeadsoulTowerModel":GetInstance():CheckRedDeadFast()
    if flag then
        return 0
    end
    return 1
end

--endregion

return RedDeadsoulFast
