local base = require "RedPointItemBase"
---@class RedPointSpiritualRealmEmbattle	中文描述
local RedPointSpiritualRealmEmbattle = _G.BaseClass("RedPointSpiritualRealmEmbattle", base)
--region子类重写

---检测全部
---@return number 红点数量
function RedPointSpiritualRealmEmbattle:CheckAll()
    local joinType = require("SpiritualRealmModel"):GetInstance():GetJoinType()
    if joinType == 0 or joinType == nil then
        return 0
    end
    local teamNum = require("SpiritualRealmModel"):GetInstance():GetCurTeamNum()
    local total = _G.StorageManager:GetInstance():CheckCanEmbattleCardCount()
    local hasEmpty = false
    for i = 1, teamNum do
        local data = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType["SpiritualRealm" .. i])
        for j = 1, #data do
            if data[j] > 0 then
                total = total - 1
            else
                hasEmpty = true
            end
        end
    end
    if hasEmpty and total > 0 then
        return 1
    end
    return 0
end
--endregion

return RedPointSpiritualRealmEmbattle
