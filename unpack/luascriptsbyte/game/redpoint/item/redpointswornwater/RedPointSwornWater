local base = require "RedPointItemBase"
---@class RedPointSwornWater	浇水
local RedPointSwornWater = _G.BaseClass("RedPointSwornWater", base)

function RedPointSwornWater:GetAllParams()
    return {0}
end

function RedPointSwornWater:CheckAll()
    return self:CheckParams()
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSwornWater:CheckParams(param)
    if require "SwornModel":GetInstance():IsCanWater() then
        return 1
    end
    return 0
end
