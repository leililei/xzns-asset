local base = require "RedPointItemBase"
---@class RedPointPlayerScene	中文描述
local RedPointPlayerScene = _G.BaseClass("RedPointPlayerScene", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointPlayerScene:GetAllParams()
    local tb = {}
    for _, v in pairs(_G.ConfigManager.player_scene_cfg) do
        _G.table.insert(tb,v.ID)
    end
    return tb
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPlayerScene:CheckParams(param)
    if not _G.PlayerPrefsManager.HasKey("SettingTheme" .. param) then
        return
    end
    return _G.PlayerPrefsManager.GetInt("SettingTheme" .. param, 0) >= 1 and 1 or 0
end
--endregion

return RedPointPlayerScene
