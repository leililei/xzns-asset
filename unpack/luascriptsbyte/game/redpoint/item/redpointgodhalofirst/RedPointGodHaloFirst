local base = require "RedPointItemBase"
---@class RedPointGodHaloFirst	神环首次功能进入红点
local RedPointGodHaloFirst = _G.BaseClass("RedPointGodHaloFirst", base)

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointGodHaloFirst:CheckAll()
    local cfg = _G.ConfigManager.team_hall_cfg

    local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
        cfg[2].function_open
    )
    if not isOpen then
        return 0
    end

    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()

    if _G.PlayerPrefsManager.HasKey(uid .. "RedPointGodHaloFirst") then
        return 0
    else
        return 1
    end
end

--endregion

return RedPointGodHaloFirst
