local base = require "RedPointItemBase"
---@class RedPointCalendar	中文描述
local RedPointCalendar = _G.BaseClass("RedPointCalendar", base)

function RedPointCalendar:CheckAll()
    local CalendarModel= require "CalendarModel":GetInstance()
    local rolid = _G.PlayerModel:GetInstance():GetPlayerUid()
    local curTime,serverStartTime
    serverStartTime=_G.PlayerModel:GetInstance():GetServerOpenTime()
    curTime = _G.TimeUtil.GetServerUnixTime()
    local today=_G.TimeUtil.GetIntervalDay(serverStartTime,curTime)+1
    local lastday=_G.PlayerPrefsManager.GetInt("NewactTime" .. rolid)
    for i = 1, #CalendarModel.actList do
        if CalendarModel.actList[i].startDay==today and today>lastday then
            return 1
        end
    end
    return 0
end

return RedPointCalendar