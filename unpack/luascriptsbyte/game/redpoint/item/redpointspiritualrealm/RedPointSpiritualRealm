local base = require "RedPointItemBase"
---@class RedPointSpiritualRealm	问鼎灵域界面红点
local RedPointSpiritualRealm = _G.BaseClass("RedPointSpiritualRealm", base)
local SpiritualRealmModel = require("SpiritualRealmModel")
---检测全部
---@return number 红点数量
function RedPointSpiritualRealm:CheckAll()
    if not self:CheckFunctionOpenExtra() then
        return base.CheckAll(self)
    end

    --获取当前赛季结束时间
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    local saveEndTime =
        _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "SpiritualRealm", 0)
    if saveEndTime ~= timestamp then
        return 1
    end
    return base.CheckAll(self)
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointSpiritualRealm:CheckFunctionOpenExtra()
    if
        not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(152) or
            SpiritualRealmModel:GetInstance():IsSettlementTime()
     then
        return false
    end
    return base.CheckFunctionOpenExtra(self)
end
--endregion

return RedPointSpiritualRealm
