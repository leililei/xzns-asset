local base = require "RedPointItemBase"
---@class RedPointTimesofDraw    中文描述
local RedPointTimesofDraw = _G.BaseClass("RedPointTimesofDraw", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointTimesofDraw:GetAllParams()
    return {-1}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointTimesofDraw:CheckAll()
    local param = 2001
    local admodel = require("AdvertisementModel"):GetInstance()
    if admodel:CheckADShow(param) then
        local nowTimes = admodel:GetADTimes(param)
        if nowTimes > 0 then
            return 1
        end
    end
    return 0
end
