local base = require "RedPointItemBase"
---@class RedPointItemDailyTaskPage	每日任务页签
local RedPointItemDailyTaskPage = _G.BaseClass("RedPointItemDailyTaskPage", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemDailyTaskPage:GetAllParams()
    local tasks = require("ActiveTaskManager"):GetInstance().tasks
    if tasks == nil then
        return {}
    else
        ---@param v ActiveTaskBase
        return table.toArray(
            tasks,
            function(v)
                return v.i_task.sid
            end
        )
    end
end
---检测全部
---@return number 红点数量
function RedPointItemDailyTaskPage:CheckAll()
    return require("ActiveTaskManager"):GetInstance():HaveTaskSubmited() and 1 or 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemDailyTaskPage:CheckParams(param)
    local task = require("ActiveTaskManager"):GetInstance():GetTaskByTaskid(param)
    if task == nil or task.Cfg.type_mission == 1 or task.i_task.state ~= _G.TaskEnum.ETaskState.Submited then
        return 0
    else
        --- 为0 默认显示
        local isfunction_open = task.Cfg.function_open == 0
        if isfunction_open == false then
            isfunction_open = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(task.Cfg.function_open)
        end
        if isfunction_open then
            return 1
        end
        return 0
    end
end
--endregion

return RedPointItemDailyTaskPage
