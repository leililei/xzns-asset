local base = require "RedPointItemBase"
---@class RedPointMaidHasRequest 放置挂机红点
local RedPointMaidHasRequest = _G.BaseClass("RedPointMaidHasRequest", base)

--region子类重写
---检测全部
---@return number 红点数量
function RedPointMaidHasRequest:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Maid) then
       return 0 
    end
    return require "MaidAcademyModel":GetInstance():CheckHasRequest() or 0
end
--endregion

return RedPointMaidHasRequest