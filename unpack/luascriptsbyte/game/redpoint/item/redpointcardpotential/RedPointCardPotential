local base = require "RedPointItemBase"
---@class RedPointCardPotential	中文描述
local RedPointCardPotential = _G.BaseClass("RedPointCardPotential", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCardPotential:GetAllParams()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local cardList = {}
    for _, value in pairs(cards) do
        _G.table.insert(cardList, value.uid)
    end
    return cardList
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCardPotential:CheckParams(param)
    return require("CardPotentialModel"):GetInstance():CheckRedPoint(param) and 1 or 0
end

function RedPointCardPotential:ParseParamForParent(param)
    return {param}
end

return RedPointCardPotential
