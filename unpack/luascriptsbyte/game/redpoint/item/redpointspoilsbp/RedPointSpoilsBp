local base = require "RedPointItemBase"
---@class RedPointSpoilsBp	中文描述
local RedPointSpoilsBp = _G.BaseClass("RedPointSpoilsBp", base)
---CycleBattlePassModel战令枚举
local cycelEnum = 6
--region子类重写
---检测全部
---@return number 红点数量
function RedPointSpoilsBp:CheckAll()
    local model = require("CycleBattlePassModel"):GetInstance()
    if model:CheckSingleIsOpen(cycelEnum) then
        local lv = model:GetLvAndCurLvExp(cycelEnum)
        return model:CheckeRedPoint(cycelEnum,lv)
    end
    return 0
end
--endregion

return RedPointSpoilsBp