local base = require "RedPointItemBase"
local PetForestModel = require("PetForestModel")

---@class RedPointPetForestPosition	每日成就页签
local RedPointPetForestPosition = _G.BaseClass("RedPointPetForestPosition", base)
--region子类重写

function RedPointPetForestPosition:GetAllParams()
    local params = {}
    local stage = PetForestModel:GetInstance():GetMaxStage()
    local posNum = _G.ConfigManager.pet_phase_cfg[stage].pet_num
    for i = 1, posNum do
        _G.table.insert(params, i)
    end
    return params
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPetForestPosition:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Pet) then
        return 0
    end
    return PetForestModel:GetInstance():CheckRedPointPos(param) and 1 or 0
end

return RedPointPetForestPosition
