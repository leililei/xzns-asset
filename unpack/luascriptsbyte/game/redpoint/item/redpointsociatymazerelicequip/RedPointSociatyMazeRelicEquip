local base = require "RedPointItemBase"

---@class RedPointSociatyMazeRelicEquip: RedPointItemBase	公会-暗影迷宫有遗物可装备
local RedPointSociatyMazeRelicEquip = _G.BaseClass("RedPointSociatyMazeRelicEquip", base)

---检测单个红点
---@return number 红点数量
function RedPointSociatyMazeRelicEquip:CheckAll()
    --如果没有公会
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        return 0
    end

    local model = require("SociatyMazeRelicManager"):GetInstance()
    return model:CheckRelicEquipRedPoint()
end

return RedPointSociatyMazeRelicEquip
