local base = require "RedPointItemBase"
---@class RedPointBeastList 观影台红点
local RedPointBeastList = _G.BaseClass("RedPointBeastList", base)

local BeastModel = require("BeastModel"):GetInstance()

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointBeastList:GetAllParams()
    if self.beastList then
        return self.beastList
    end
    self.beastList = {}
    for _, v in pairs(_G.ConfigManager.pet_xzns_cfg) do
        local data = BeastModel:GetBeast(v.id)
        if data:GetIsActive() or data:IsCanGet() then
            _G.table.insert(self.beastList, v.id)
        end
    end
    return self.beastList
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointBeastList:CheckParams(param)
    return BeastModel:CheckListRedpoint(param)
end
--endregion

return RedPointBeastList
