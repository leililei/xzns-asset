local base = require "RedPointItemBase"
---@class RedPointChallenge	中文描述
local RedPointChallenge = _G.BaseClass("RedPointChallenge", base)

--region对外接口
---初始化红点数据
function RedPointChallenge:InitData()
    self:InitAllParams()
    self:Check()
    _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.UnLock, self)
end

---解锁新功能
function RedPointChallenge:UnLock()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ChallengePage.id)
end

function RedPointChallenge:Dispose()
    self.id = nil
    self.child = nil
    self.parent = nil
    self.num = nil
    self.paramNums = nil
    _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.UnLock, self)
end
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointChallenge:GetAllParams()
    local cfgs = _G.ConfigManager.system_cfg
    local tb = {}
    for _, v in pairs(cfgs) do
        if v.id ~= 104 and v.id < 200 then
            _G.table.insert(tb, v.id)
        end
    end
    _G.table.sort(
        tb,
        function(a, b)
            return a < b
        end
    )
    return tb
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointChallenge:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.ConfigManager.ui_page_cfg[3].FunctionID[2]) then
        return 0
    end
    if param == 104 then
        return 0
    end
    local cfg = _G.ConfigManager.system_cfg[param]
    if not cfg then
        return 0
    end
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.function_open) then
        local time = require "SystemEntranceModel":GetInstance():GetRedPoint(param)
        if time and time > 0 then
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

--endregion

return RedPointChallenge
