local base = require "RedPointItemBase"
---@class RedPointItemAllHeroesChallengeTimes	中文描述
local RedPointItemAllHeroesChallengeTimes = _G.BaseClass("RedPointItemAllHeroesChallengeTimes", base)

--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemAllHeroesChallengeTimes:CheckFunctionOpenExtra()
    return true
end
---检测全部
---@return number 红点数量
function RedPointItemAllHeroesChallengeTimes:CheckAll()
    local AllHeroesBattleManagerIns = require("AllHeroesBattleManager"):GetInstance()
    return AllHeroesBattleManagerIns:GetFightTimes() > 0 and 1 or 0
end
