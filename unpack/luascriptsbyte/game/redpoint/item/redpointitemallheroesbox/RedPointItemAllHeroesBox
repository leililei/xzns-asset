local base = require "RedPointItemBase"
---@class RedPointItemAllHeroesBox	中文描述
local RedPointItemAllHeroesBox = _G.BaseClass("RedPointItemAllHeroesBox", base)

--region子类重写
---检测全部
---@return number 红点数量
function RedPointItemAllHeroesBox:CheckAll()
    ---@type AllHeroesBattleManager
    local ahbm = require("AllHeroesBattleManager"):GetInstance()
    return ahbm:GetAwardInfo() >= ahbm:GetAwardMaxCount() and 1 or 0
end
--endregion

