local base = require "RedPointItemBase"
---@class RedPointSeasonHeroGiftPack	中文描述
local RedPointSeasonHeroGiftPack = _G.BaseClass("RedPointSeasonHeroGiftPack", base)
local SeasonHeroGiftPackModel = require "SeasonHeroGiftPackModel"
local SeasonModel = require "SeasonModel"
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSeasonHeroGiftPack:CheckAll()
    return SeasonHeroGiftPackModel:GetInstance():HongDianCanAward() and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointSeasonHeroGiftPack:CheckFunctionOpenExtra()
    return SeasonModel:GetInstance():CheckFunctionIsOpen(61)
end
--endregion

return RedPointSeasonHeroGiftPack
