local base = require "RedPointItemBase"
---@class RedPointWarTechnologyTimeAward    死魂塔礼包
local RedPointWarTechnologyTimeAward = _G.BaseClass("RedPointWarTechnologyTimeAward", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointWarTechnologyTimeAward:GetAllParams()
    return { 0 }
end

---检测全部
---@return number 红点数量
function RedPointWarTechnologyTimeAward:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.WarTechnology) then
        return 0
    end
    return require("WarTechnologyModel"):GetInstance():CheckTimeAwardRed() and 1 or 0
end

--endregion

return RedPointWarTechnologyTimeAward