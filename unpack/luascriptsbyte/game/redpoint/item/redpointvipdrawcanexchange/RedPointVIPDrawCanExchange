---检测全部
---@return number 红点数量
function RedPointVIPDrawCanExchange:CheckAll()
    local cfg = _G.ConfigManager.player_vip_shop_cfg
    for i = 1, #cfg do
        if VIPDrawModel:GetInstance():CheckTagFinish(cfg[i].shop_id) then
            for j = 1, #cfg[i].goods do
                local param = cfg[i].goods[j]

                local value = _G.PlayerPrefsManager.GetInt("VIPDrawCanExchange" .. param, 1)
                if value == 1 then
                    ---@type season_shop_cfg
                    local cfg = _G.ConfigManager.season_shop_cfg[param]
                    local id = cfg.need_item[1]
                    local num = cfg.need_item[2]
                    local hasNum = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Prop, id)

                    local buyTimes = VIPDrawModel:GetInstance():GetGoodsTimesOnlyByGoodId(param)

                    if buyTimes < cfg.count_limit and hasNum >= num then
                        return 1
                    end
                end
            end
        end
    end
    return 0
end

