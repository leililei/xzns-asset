local base = require "RedPointItemBase"
---@class RedKeynoteTarget	七日目标 目标点的奖励
local RedKeynoteTarget = _G.BaseClass("RedKeynoteTarget", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedKeynoteTarget:GetAllParams()
    -- if self.allActionGoal then
    --     return self.allActionGoal
    -- end
    self.allActionGoal = {}
    local qishu, bol = require "ActionKeynoteModel":GetInstance():GetCurrentQiShu()
    if bol then
        local cfg = _G.ConfigManager.keynote_active_cfg
        for _, value in pairs(cfg) do
            if value.group == qishu then
                _G.table.insert(self.allActionGoal, math.fmod(value.id, 100))
            end
        end
    end
    return self.allActionGoal
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedKeynoteTarget:CheckParams(param)
    local flag = require "ActionKeynoteModel":GetInstance():CheckGoalsRedpoint(param)
    return flag and 1 or 0
    --return 0
end
