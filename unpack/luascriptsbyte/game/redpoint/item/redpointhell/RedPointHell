local base = require "RedPointItemBase"
---@class RedPointHell	中文描述
local RedPointHell = _G.BaseClass("RedPointHell", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointHell:GetAllParams()
    local tb = {}
    for _, v in pairs(_G.ConfigManager.hell_title_cfg) do
        for _2, v2 in pairs(v.mission_privilege) do
            _G.table.insert(tb, v2)
        end
        --ZHJH-3475【军衔系统】任务“给英雄穿装备”完成后没有红点提示
        --mission_phase中的任务也需要处理, mission_phase指到达此军衔阶段后才开始计数
        for _2, v2 in pairs(v.mission_phase) do
            _G.table.insert(tb, v2)
        end
    end
    _G.table.insert(tb, 0)
    return tb
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointHell:CheckParams(param)
    return require "HellRoadModel":GetInstance():CheckTaskCanTake(param) and 1 or 0
end
--endregion

return RedPointHell
