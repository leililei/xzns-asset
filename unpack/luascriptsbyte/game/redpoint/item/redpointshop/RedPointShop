local base = require "RedPointItemBase"
---@class RedPointShop : RedPointItemBase	商店红点
---@field model ShopModel
---@field redpointParams number[]
local RedPointShop = _G.BaseClass("RedPointShop", base)

function RedPointShop:__init()
    self.model = require "ShopModel":GetInstance()
end

function RedPointShop:GetAllParams()
    if not self.redpointParams then
        self.redpointParams = {}
        local params = self.model:GetRedPointParams()
        if params then
            for param, _ in pairs(params) do
                _G.table.insert(self.redpointParams, param)
            end
        else
            for _, v in pairs(_G.ConfigManager.shop_list_cfg) do
                _G.table.insert(self.redpointParams, v.id)
            end
        end
    end
    return self.redpointParams
end

function RedPointShop:CheckParams(param)
    return self.model:GetRedPoint(param)
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointShop:CheckFunctionOpenExtra()
    return self.model:GetFunctionOpen()
end

return RedPointShop
