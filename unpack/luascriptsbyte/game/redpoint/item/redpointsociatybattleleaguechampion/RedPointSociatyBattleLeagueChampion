local SociatyBattleLeagueModel = require "SociatyBattleLeagueModel"
local base = require "RedPointItemBase"
---@class RedPointSociatyBattleLeagueChampion	中文描述
local RedPointSociatyBattleLeagueChampion = _G.BaseClass("RedPointSociatyBattleLeagueChampion", base)

---检测全部
---@return number 红点数量
function RedPointSociatyBattleLeagueChampion:CheckAll()
    local con = _G.ConfigManager.discrete_cfg[125303]
    if _G.GlobalConditionManager.CheckConditionArrays(con) then
        local endtime = SociatyBattleLeagueModel:GetInstance().EggEndTime
        --LogError(endtime)
        --LogError(SociatyBattleLeagueModel:GetInstance().EggAwardFlag)
        if endtime and endtime > 0 then
            if not SociatyBattleLeagueModel:GetInstance().EggAwardFlag then
                return 1
            end
        end
    end
    return 0
end

return RedPointSociatyBattleLeagueChampion
