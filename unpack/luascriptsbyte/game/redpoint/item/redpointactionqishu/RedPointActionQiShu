local base = require "RedPointItemBase"
---@class RedPointActionQiShu	中文描述
local RedPointActionQiShu = _G.BaseClass("RedPointActionQiShu", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointActionQiShu:GetAllParams()
    if self.allyeqianIDs then
        return self.allyeqianIDs
    end
    self.allyeqianIDs = {}
    for i = 1, require("ActionGoalsModel"):GetInstance().totalQiShu do
        table.insert(self.allyeqianIDs, i)
    end
    return self.allyeqianIDs
end
---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointActionQiShu:ParseParamForParent(param)
    return {param}
end
--endregion

return RedPointActionQiShu
