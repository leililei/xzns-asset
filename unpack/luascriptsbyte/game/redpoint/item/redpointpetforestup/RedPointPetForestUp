local base = require "RedPointItemBase"
local PetForestModel = require("PetForestModel")

---@class RedPointPetForestUp	每日成就页签
local RedPointPetForestUp = _G.BaseClass("RedPointPetForestUp", base)
--region子类重写

---检测全部
---@return number 红点数量
function RedPointPetForestUp:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Pet) then
        return 0
    end
    return PetForestModel:GetInstance():CheckRedPointLvUp() and 1 or 0
end

return RedPointPetForestUp
