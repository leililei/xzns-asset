local base = require "RedPointItemBase"
---@class RedPointLuckyTriads	中文描述
local RedPointLuckyTriads = _G.BaseClass("RedPointLuckyTriads", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointLuckyTriads:GetAllParams()
    return {0}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointLuckyTriads:CheckParams(param)
    local model = require("LuckyTriadsModel"):GetInstance()
    --检查轮次是否已满
    local cfg = _G.ConfigManager.lucky_triads_cfg[model:GetRound()]
    if not cfg then
        return 0
    end
    --检查是否可抽取卡牌(未达成条件也可抽取)
    for i = 1, 3 do
        if not model:GetCard(i) then
            return 1
        end
    end
    --检查是否可领取奖励
    for _, condition in ipairs(cfg.conditions) do
        if not _G.GlobalConditionManager.CheckCondition(condition[1], condition[2]) then
            return 0
        end
    end

    return 1
end
--endregion

return RedPointLuckyTriads
