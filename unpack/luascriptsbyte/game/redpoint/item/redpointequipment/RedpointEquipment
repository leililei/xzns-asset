local base = require "RedPointItemBase"
---@class RedpointEquipment	中文描述
local RedpointEquipment = _G.BaseClass("RedpointEquipment", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedpointEquipment:GetAllParams()
    local table = _G.table
    local part_uid

    local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    local uid1
    self.allEquipmentIDs = {}
    if uids ~= nil then
        for i = 1, #uids do
            uid1 = uids[i]
            if uid1 > 0 then
                for k, v in pairs(_G.EquipmentPart) do
                    if v ~= _G.EquipmentPart.Trousers then
                        part_uid = uid1 * 10 + v
                        table.insert(self.allEquipmentIDs, part_uid)
                    end
                end
            end
        end
    end
    return self.allEquipmentIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedpointEquipment:CheckParams(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    local part = math.fmod(param, 10)
    local Card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    if not Card then
       return 0
    end
    local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    local isInBattle = false
    if uids ~= nil then
        for i = 1, #uids do
            if uids[i] > 0 and uids[i] == uid then
                isInBattle = true
            end
        end
    end
    if not isInBattle then
        return 0
    end
    local equipments = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    if _G.table.isEmptyOrNil(equipments) then
        return 0
    end
    local flag = false
    --装备的部位
    local equipPart = Card.EquipBar[part]
    if _G.table.isEmptyOrNil(equipPart) then
        flag = true
    end
    local element = Card.cfg.Elements_new
    for _, value in pairs(equipments) do
        if
            value.cfg.professional == Card.cfg.EquipmentType and --  and value.cfg.limit_level <= playerLevel
                value.cfg.parts == part and
                (flag or value:GetTempElementPower(element) > equipPart:GetPower()) and
                value.cardUid == 0
         then
            return 1
        end
    end
    return 0
end

function RedpointEquipment:ParseParamForParent(param)
    local uid = _G.GameUtil.GetDivisionNumber(param,10)
    return {uid}
end

---@param param number 卡牌的 uid
function RedpointEquipment:GetRedPointNumByParentParam(param)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(param, _G.EmbattleType.AFKOnly)
    if not inEmbattle then
       return 0
    end
    local num = 0
    local part = _G.EquipmentPart
    param = param * 10
    local pointnum = self:GetRedPointNum(param + part.Head)
    if pointnum then
        num = num + pointnum
    end
    pointnum = self:GetRedPointNum(param + part.Weapon)
    if pointnum then
        num = num + pointnum
    end
    pointnum = self:GetRedPointNum(param + part.Shoes)
    if pointnum then
        num = num + pointnum
    end
    pointnum = self:GetRedPointNum(param + part.Clothes)
    if pointnum then
        num = num + pointnum
    end
    return num
end
--endregion

return RedpointEquipment
