local base = require "RedPointItemBase"
---@class RedPointItemDailyBox	每周活跃度宝箱
local RedPointItemDailyBox = _G.BaseClass("RedPointItemDailyBox", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemDailyBox:GetAllParams()
    self.ActiveTaskManager = require("ActiveTaskManager"):GetInstance()
    return table.keys(self.ActiveTaskManager.ActiveTaskBoxValue)
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemDailyBox:CheckParams(param)
    local BoxStatus = self.ActiveTaskManager:GetBoxStatus()
    ---@param value ActiveTaskBoxType
    for key, value in pairs(BoxStatus) do
        if param == key and value == _G.ActiveTaskBoxType.WaitClaim then
            return 1
        end
    end
    return 0
end
--endregion

return RedPointItemDailyBox
