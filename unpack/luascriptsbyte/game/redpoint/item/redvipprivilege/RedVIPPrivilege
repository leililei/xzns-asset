local base = require "RedPointItemBase"
---@class RedVIPPrivilege	中文描述
local RedVIPPrivilege = _G.BaseClass("RedVIPPrivilege", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedVIPPrivilege:GetAllParams()
    if self.allVIPPrivilege then
        return self.allVIPPrivilege
    end
    self.allVIPPrivilege = {}
    local cfg = _G.ConfigManager.player_vip_cfg
    for _, value in pairs(cfg) do
        _G.table.insert(self.allVIPPrivilege, value.id)
    end
    return self.allVIPPrivilege
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedVIPPrivilege:CheckParams(param)
    return require "VIPPrivilegeModel":GetInstance():CheckRedNumer(param)
end
--endregion

return RedVIPPrivilege
