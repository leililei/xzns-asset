local base = require "RedPointItemBase"
local RedPointPetFetter = _G.BaseClass("RedPointPetFetter", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointPetFetter:GetAllParams()
    local params = {}
    local allCfg = _G.ConfigManager.pet_fetter_cfg
    for _, v in pairs(allCfg) do
        _G.table.insert(params, v.id)
    end
    return params
end

---检测全部
---@return number 红点数量
function RedPointPetFetter:CheckAll()
    return self:CheckParams()
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPetFetter:CheckParams(param)
    return require("PetFetterModel"):GetInstance():CheckCanActiveFetter(param)
end

return RedPointPetFetter
