local base = require "RedPointItemBase"
---@class RedPointSwornAccept	受邀请红点
local RedPointSwornAccept = _G.BaseClass("RedPointSwornAccept", base)

function RedPointSwornAccept:GetAllParams()
    return {0}
end

function RedPointSwornAccept:CheckAll()
    return self:CheckParams()
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSwornAccept:CheckParams(param)
    if _G.PlayerPrefsManager.GetInt("SwornAccept") == 1 then
        return 1
    end

    local list = require "SwornModel":GetInstance().NewAppcetList
    return #list > 0 and 1 or 0
end
--endregion

return RedPointSwornAccept
