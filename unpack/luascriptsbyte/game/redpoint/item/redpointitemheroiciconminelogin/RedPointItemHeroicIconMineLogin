local base = require "RedPointItemBase"
---@class RedPointItemHeroicIconMineLogin	 : RedPointItemBase 中文描述
local RedPointItemHeroicIconMineLogin = _G.BaseClass("RedPointItemHeroicIconMineLogin", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemHeroicIconMineLogin:GetAllParams()
    return {1}
end

function RedPointItemHeroicIconMineLogin:CheckAll()
    return self:CheckParams()
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemHeroicIconMineLogin:CheckParams()
    if _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()) ~=
        _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicIconMineLogin, 0) 
    then
        return 1
    end
    return 0
end
--endregion

return RedPointItemHeroicIconMineLogin