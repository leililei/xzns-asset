local base = require "RedPointItemBase"
---@class RedPlayerRole    中文描述
local RedPlayerRole = _G.BaseClass("RedPlayerRole", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPlayerRole:GetAllParams()
    if self.allPlayerRoleIDs then
        return self.allPlayerRoleIDs
    end
    local cardcfg = _G.ConfigManager.card_cfg
    local table = _G.table
    self.allPlayerRoleIDs = {}
    for _, value in pairs(cardcfg) do
        if value.UnitType == 1 or value.UnitType == 2 then
            table.insert(self.allPlayerRoleIDs, value.id)
        end
    end
    return self.allPlayerRoleIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPlayerRole:CheckParams(param)
    local cardid = param
    --默认卡牌(第一张卡牌 不显示红点 曹焱兵)
    if cardid == 112060000 then
        return 0
    end
    local cfg = _G.ConfigManager.card_cfg[cardid]
    local flag = false
    for _, v in pairs(cfg.skin) do
        if require "CardCommentManager":GetInstance():CheckSkin(v) then
            local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "playerRole" .. v
            if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) ~= 0 then
                return 1
            end
        end
    end
    if require "IllustrationModel":GetInstance():HunjiangJieSuo(cardid) then
        local star = require "IllustrationModel":GetInstance():GetCardMaxStar(cardid)
        for _, v in pairs(_G.ConfigManager.discrete_cfg[101402]) do
            if cfg.Order == v[1] and star >= v[2] then
                flag = true
                break
            end
        end
    end
    if flag then
        --判断本地有没有数据 1 == 解锁 0 == 已经点过
        local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "playerRole" .. cardid
        if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
            if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
                return 0
            end
        end
    else
        return 0
    end
    return 1
end
--endregion

return RedPlayerRole
