local base = require "RedPointItemBase"
---@class RedPointItemGuessGameBet	中文描述
local RedPointItemGuessGameBet = _G.BaseClass("RedPointItemGuessGameBet", base)

--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemGuessGameBet:CheckFunctionOpenExtra()
    return require("GuessGameManager"):GetInstance():GetCurState()
end
---检测全部
---@return number 红点数量
function RedPointItemGuessGameBet:CheckAll()
    local GuessGameManagerIns = require("GuessGameManager"):GetInstance()
    local curSessionIndex = GuessGameManagerIns:GetCurFactSessionIndex()
    local info = GuessGameManagerIns:GetSessionData(curSessionIndex)
    if info.bet > 0 then
        return 0
    end
    local t = _G.TimeUtil.GetServerUnixTime()
    if t > info.time_start and t < info.time_end - GuessGameManagerIns:GetSettlementSecond() then --在竞猜时间范围内
        return 1
    end
    return 0
end
--endregion

return RedPointItemGuessGameBet
