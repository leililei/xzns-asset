local base = require "RedPointItemBase"
---@class RedLingMain	中文描述
local RedLingMain = _G.BaseClass("RedLingMain", base)

---获取所有参数
---@return table 参数列表
function RedLingMain:GetAllParams()
    if self.allLingRankIDs then
        return self.allLingRankIDs
    end
    local table = _G.table
    self.allLingRankIDs = {}
    for i = 1, 8 do
        table.insert(self.allLingRankIDs, i)
    end
    return self.allLingRankIDs
end

return RedLingMain
