local base = require "RedPointItemBase"
---@class RedPointArtifactAwaken	 : RedPointItemBase 中文描述
local RedPointArtifactAwaken = _G.BaseClass("RedPointArtifactAwaken", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointArtifactAwaken:GetAllParams()
    local datas = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
    local uids = _G.table.keys(datas.allList)
    return uids
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointArtifactAwaken:CheckParams(param)
    local CardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    if not _G.table.isEmptyOrNil(CardData.ArtifactBar) and CardData.ArtifactBar:IsMaxStar() then
        local cfg = _G.ConfigManager.artifact_cfg[CardData.ArtifactBar.sid]
        if cfg.card_id > 0 and (cfg.display and cfg.display == 1) then
            local awakenCfg = _G.ConfigManager.artifact_awaken_cfg[CardData.ArtifactBar.awaken + 101]
            if cfg and awakenCfg then
                local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
                local count = awakenCfg.materials_oneself
                for _, v in pairs(datas) do
                    if v.sid == CardData.ArtifactBar.sid and v.star == 0 then
                        count = count - 1
                        if count <= 0 then
                            break
                        end
                    end
                end
                if count == 0 then
                    return 1
                end
            end
        end
    end
    return 0
end
--endregion

return RedPointArtifactAwaken