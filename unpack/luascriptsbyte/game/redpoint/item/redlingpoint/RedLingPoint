local base = require "RedPointItemBase"
local LingRankModel = require("LingRankModel")

---@class RedLingPoint    中文描述
local RedLingPoint = _G.BaseClass("RedLingPoint", base)

---获取所有参数
---@return table 参数列表
function RedLingPoint:GetAllParams()
    if self.allLingRankIDs then
        return self.allLingRankIDs
    end
    local table = _G.table
    self.allLingRankIDs = {}
    for i = 1, 8 do
        table.insert(self.allLingRankIDs, i)
    end
    return self.allLingRankIDs
end

---@param type number 排行榜类型
function RedLingPoint:CheckParams(type)
    local count = 0
    if LingRankModel:GetInstance().rankPlayerCount[type] then
        count = LingRankModel:GetInstance().rankPlayerCount[type]
    end
    return (LingRankModel:GetInstance():CheckDayPointAward() and count > 0) and 1 or 0
end

---解析参数返回给父节点
---@param param number 排行榜类型
---@return number 父节点参数
function RedLingPoint:ParseParamForParent(param)
    return {param}
end

return RedLingPoint
