local base = require "RedPointItemBase"
---@class RedPointMaidCanCultivate 放置挂机红点
local RedPointMaidCanCultivate = _G.BaseClass("RedPointMaidCanCultivate", base)

function RedPointMaidCanCultivate:GetAllParams()
    self.indexs = { 1, 2, 3, 4 }
    return self.indexs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointMaidCanCultivate:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Maid) then
       return 0 
    end
    return require "MaidAcademyModel":GetInstance():CanCultivate(param) or 0
end

return RedPointMaidCanCultivate