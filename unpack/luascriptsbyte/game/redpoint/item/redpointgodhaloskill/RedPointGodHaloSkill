local base = require "RedPointItemBase"
---@class RedPointGodHaloSkill	神环首次功能进入红点
local RedPointGodHaloSkill = _G.BaseClass("RedPointGodHaloSkill", base)

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointGodHaloSkill:CheckAll()
    local num = _G.PlayerModel:GetInstance():GetNotWearSkillGodHaloNumber()
    return num > 1 and 1 or 0
end

--endregion

return RedPointGodHaloSkill
