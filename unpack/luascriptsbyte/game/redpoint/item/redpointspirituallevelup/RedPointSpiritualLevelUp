local base = require "RedPointItemBase"
---@class RedPointSpiritualLevelUp	中文描述
local RedPointSpiritualLevelUp = _G.BaseClass("RedPointSpiritualLevelUp", base)
local table = _G.table
local CardInfoManager = require "CardInfoManager"

function RedPointSpiritualLevelUp:GetAllParams()
    if _G.AppSetting.IsOverseas then
        return
    end

    self.params = {}
    local unlockData = _G.ConfigManager.discrete_cfg[114001][1]
    local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    local uid1, part_uid
    if uids ~= nil then
        for i = 1, #uids do
            uid1 = uids[i]
            if uid1 > 0 then
                for k, v in pairs(unlockData) do
                    part_uid = uid1 * 10 + k
                    table.insert(self.params, part_uid)
                end
            end
        end
    end

    return self.params
end

---@param param number 参数
---@return number 红点数量
function RedPointSpiritualLevelUp:CheckParams(param)
    local num = param % 10
    local uid = _G.GameUtil.GetDivisionNumber(param, 10)

    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not uidLis or not _G.table.ContainsValue(uidLis, uid) then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    if table.isEmptyOrNil(cardData) then
        return 0
    end
    if not CardInfoManager.IsSpiritualRedPointShow(cardData.uid) then
        return 0
    end

    if not CardInfoManager.IsShowEquipCultivate(cardData.uid) then
        return 0
    end

    local unlockData = _G.ConfigManager.discrete_cfg[114001]
    if cardData:GetStar() < unlockData[1][num] then
        return 0
    end

    local spiritualBar = cardData.SpiritualBar or {}

    if not table.isEmptyOrNil(spiritualBar[num]) then
        local canClickUp = require("SpiritualModel"):GetInstance():CanLevelUp(spiritualBar[num])
        local isEnough = require("SpiritualModel"):GetInstance():IsEnoughStarUpMaterial(spiritualBar[num])
        local replace = require("SpiritualModel"):GetInstance():RedPointCheckCanReplace(uid,num)
        return ((canClickUp or isEnough) and not replace) and 1 or 0
    end

    return 0
end

function RedPointSpiritualLevelUp:ParseParamForParent(param)
    local uid = _G.GameUtil.GetDivisionNumber(param, 10)
    return {uid}
end

function RedPointSpiritualLevelUp:GetRedPointNumByParentParam(param)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(param, _G.EmbattleType.AFKOnly)
    if not inEmbattle then
       return 0
    end
    if self.partNum == nil then
        self.partNum = #_G.ConfigManager.discrete_cfg[114001][1]
    end
    local pointNum
    local num = 0
    param = param * 10
    for i = 1, self.partNum do
        pointNum = self:GetRedPointNum(param + i)
        if pointNum then
            num = num + pointNum
        end
    end
    return num
end

return RedPointSpiritualLevelUp
