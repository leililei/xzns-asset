local base = require "RedPointItemBase"
---@class RedPlayerHalo	光环
local RedPlayerHalo = _G.BaseClass("RedPlayerHalo", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPlayerHalo:GetAllParams()
    if self.allPlayerHalo then
        return self.allPlayerHalo
    end
    local framcfg = _G.ConfigManager.player_halo_effect_cfg
    local table = _G.table
    self.allPlayerHalo = {}
    for key, value in pairs(framcfg) do
        table.insert(self.allPlayerHalo, value.id)
    end
    return self.allPlayerHalo
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPlayerHalo:CheckParams(param)
    local id = param
    if _G.PlayerModel:GetInstance():IsUnlockHalo(id) then
    else
        return 0
    end
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "halo" .. id
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
            return 0
        end
    end
    return 1
end
--endregion

return RedPlayerHalo
