local base = require "RedPointItemBase"
---@class RedLingRank	中文描述
local RedLingRank = _G.BaseClass("RedLingRank", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedLingRank:GetAllParams()
    if self.allLingRankIDs then
        return self.allLingRankIDs
    end
    local table = _G.table
    self.allLingRankIDs = {}
    for i = 1, 8 do
        table.insert(self.allLingRankIDs, i)
    end
    return self.allLingRankIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedLingRank:CheckParams(param)
    --检测是否开启
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(48) then
        return 0
    end
    ---检测是否有奖励
    --local rankid = param
    local rankNode = require "LingRankModel":GetInstance():GetOneRankInfo(param)
    if _G.table.isEmptyOrNil(rankNode) then
        return 0
    end
    if rankNode.red_count <= 0 then
        return 0
    end
    return 1
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedLingRank:ParseParamForParent(param)
    return {param}
end

--endregion

return RedLingRank
