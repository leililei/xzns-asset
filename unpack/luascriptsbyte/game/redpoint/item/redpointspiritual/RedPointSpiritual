local base = require "RedPointItemBase"
---@class RedPointSpiritual	中文描述
local RedPointSpiritual = _G.BaseClass("RedPointSpiritual", base)
local table = _G.table
local CardInfoManager = require "CardInfoManager"

function RedPointSpiritual:GetAllParams()
    if _G.AppSetting.IsOverseas then
        return
    end

    local unlockData = _G.ConfigManager.discrete_cfg[114001][1]
    local params = {}
    for i = 1, #unlockData do
        table.insert(params, i)
    end
    return params
end

