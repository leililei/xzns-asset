local base = require "RedPointItemBase"
---@class RedPointSociatyGlory	建筑红点检测
---@field buildIds number[]     建筑id列表
local RedPointSociatyGlory = _G.BaseClass("RedPointSociatyGlory", base)

function RedPointSociatyGlory:GetAllParams()
    return {0}
end

---检测单个红点
---@return number 红点数量
function RedPointSociatyGlory:CheckParams(param)
    local model = require("SociatyModel"):GetInstance()
    --检查是否已加入公会
    if not model.SociatyRoleSelf or model.SociatyRoleSelf.uid == 0 then
        return 0
    end
    --检查是否已领取奖励
    if model:IsGetReward() then
        return 0
    end
    return 1
end
--endregion

return RedPointSociatyGlory
