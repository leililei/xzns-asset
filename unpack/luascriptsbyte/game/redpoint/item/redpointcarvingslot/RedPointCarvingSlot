local base = require "RedPointItemBase"
---@class RedPointCarvingSlot    中文描述
local RedPointCarvingSlot = _G.BaseClass("RedPointCarvingSlot", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCarvingSlot:GetAllParams()
    local cards = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    local table = _G.table
    self.allCarvingIDs = {}
    for _, value in pairs(cards) do
        if value > 0 then
            for i = 1, 4 do
                table.insert(self.allCarvingIDs, value * 10 + i)
            end
        end
    end
    return self.allCarvingIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCarvingSlot:CheckParams(param)
    local index = param % 10
    local uid = _G.GameUtil.GetDivisionNumber(param, 10)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(uid, _G.EmbattleType.AFKOnly)
    if inEmbattle == false then
        return 0
    end
    if _G.table.indexof(self.allCarvingIDs, param) == false then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(cardData) then
        return 0
    end

    local carvingBar = cardData.CarvingBar
    if carvingBar[index] == nil or (carvingBar and carvingBar[index].carving == nil) then
        local carvingData = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Carving)
        for i, v in pairs(carvingData) do
            if (v.cardUid == nil or v.cardUid == 0) and v.parts == index then
                return 1
            end
        end
    end
    return 0
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number[] 父节点参数
function RedPointCarvingSlot:ParseParamForParent(param)
    return { _G.GameUtil.GetDivisionNumber(param, 10) }
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointCarvingSlot:GetRedPointNumByParentParam(param)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(param, _G.EmbattleType.AFKOnly)
    if inEmbattle == false then
        return 0
    end
    local num = 0
    for i = 1, 4 do
        local pointnum = self:GetRedPointNum(param * 10 + i)
        if pointnum then
            num = num + pointnum
        end
    end
    return num
end

return RedPointCarvingSlot
