---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointRecordChallenge:CheckParams(param)
    local model = require("RecordRankModel"):GetInstance()
    --检测是否开启
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(48) then
        return 0
    end
    if param == 6 and not model:CheckGodShow() then
        return 0
    end

    local rankRedNum = self:GetRankRedNum(param)
    local rewardRedNum = self:GetRewardRedNum(param)
    local GoddessRedNum = self:GetGodessRedNum(param)
    if rankRedNum ~= 0 or rewardRedNum ~= 0 or GoddessRedNum ~= 0 then
        return 1
    end

    return 0
end

function RedPointRecordChallenge:GetRewardRedNum(param)
    local model = require("RecordRankModel"):GetInstance()
    if model:HasAwardReceive(param) then
        return 1
    end
    return 0
end

function RedPointRecordChallenge:GetRankRedNum(param)
    local model = require("RecordRankModel"):GetInstance()
    --检查是否有上榜人数
    if model:GetRankPlayerCount(param) <= 0 then
        return 0
    end
    if model:HasLinkAward() == false then
        return 0
    end
    return 1
end


function RedPointRecordChallenge:GetGodessRedNum(param, manager)
    for i = 1, 3 do
        if self:GetRewardNum(i) > 0 then
            return 1
        end
    end
    return 0
end


function RedPointRecordChallenge:GetRewardNum(param)
    local model = require("RecordRankModel"):GetInstance()

    local lstCfg = model:GetBookCfg(param)
    if not lstCfg then
        return 0
    end
    if param == 6 and not require("RecordRankModel"):GetInstance():CheckGodShow() then
        return 0
    end
    for _, cfg in pairs(lstCfg) do
        --检查是否有可领取的奖励
        if model:GetBookRecord(cfg.id) and model:CanGetBookAward(cfg.id) then
            return 1
        end
    end
    return 0
end


