local base = require "RedPointItemBase"

---@class RedPointRecordRankLink    中文描述
local RedPointRecordRankLink = _G.BaseClass("RedPointRecordRankLink", base)

---获取所有参数
---@return table 参数列表
function RedPointRecordRankLink:GetAllParams()
    if self.rankIds then
        return self.rankIds
    end
    self.rankIds = {}
    for i = 1, 9 do
        table.insert(self.rankIds, i)
    end
    return self.rankIds
end

---@param type number 排行榜类型
function RedPointRecordRankLink:CheckParams(param)
    local model = require("RecordRankModel"):GetInstance()
    --检查是否有上榜人数
    if model:GetRankPlayerCount(param) <= 0 then
        return 0
    end
    if param == 6 and not require("RecordRankModel"):GetInstance():CheckGodShow() then
        return 0
    end
    if model:HasLinkAward() then
        return 1
    end
    return 0
end

---解析参数返回给父节点
---@param param number 排行榜类型
---@return number 父节点参数
function RedPointRecordRankLink:ParseParamForParent(param)
    return {param}
end

return RedPointRecordRankLink
