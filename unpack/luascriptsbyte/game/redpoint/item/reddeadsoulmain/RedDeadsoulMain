local base = require "RedPointItemBase"
---@class RedDeadsoulMain	死魂塔 五行塔开启（主塔，检测（首通，和快速挑战））
local RedDeadsoulMain = _G.BaseClass("RedDeadsoulMain", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedDeadsoulMain:GetAllParams()
    return {1}
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedDeadsoulMain:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(23) then
        return 0
    end
    if not require "DeadsoulTowerModel":GetInstance().IsOpenWx then
        return 0
    end
    local TowerInfo = require "DeadsoulTowerModel":GetInstance():InitTowerInfo(9)
    local IsFinishFloor = require "DeadsoulTowerModel":GetInstance().LandFloor or 0
    local cfg = _G.ConfigManager.tower_cfg
    if IsFinishFloor > 0 then
        if cfg[IsFinishFloor] then
        else
            return 0
        end
        IsFinishFloor = cfg[IsFinishFloor].layer
    end
    local floor = IsFinishFloor
    if IsFinishFloor + 1 < #TowerInfo then
        floor = IsFinishFloor + 1
    end
    if floor <= 1 then
        return 0
    end
    --检测的 是否有奖励物品
    if require "DeadsoulTowerModel":GetInstance():CheckRedpointTowerExtraAward(9) then
        return 1
    end
    if floor >= #TowerInfo then
        return 0
    end
    local flag = _G.DeadsoulTowerManager:GetInstance():CheckQuickPower(TowerInfo[floor].id) --require "DeadsoulTowerModel":GetInstance():CheckRedDeadFast()
    if not flag then
        return 1
    end

    return 0
end

--endregion

return RedDeadsoulMain
