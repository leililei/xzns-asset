local base = require "RedPointItemBase"
---@class RedPointDraw	每日成就页签
local RedPointDrawYouQingDian = _G.BaseClass("RedPointDrawYouQingDian", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointDrawYouQingDian:GetAllParams()
    return {_G.ResPropID.Friendship}
end
---检测全部
---@return number 红点数量
function RedPointDrawYouQingDian:CheckAll()
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawYouQingDian",0)
    return (require("DrawModel"):GetInstance():GengXingShuJu(_G.ResPropID.Friendship) and num == 0) and 1 or 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointDrawYouQingDian:CheckParams(param)
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "DrawYouQingDian",0)
    return (require("DrawModel"):GetInstance():GengXingShuJu(_G.ResPropID.Friendship) and num == 0) and 1 or 0
end

return RedPointDrawYouQingDian
