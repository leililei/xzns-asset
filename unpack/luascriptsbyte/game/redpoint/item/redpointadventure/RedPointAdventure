local base = require "RedPointItemBase"
---@class RedPointAdventure	中文描述
local RedPointAdventure = _G.BaseClass("RedPointAdventure", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointAdventure:GetAllParams()
    local cfgs = _G.ConfigManager.system_cfg
    local tb = {}
    for _, v in pairs(cfgs) do
        if v.id > 200 and v.id ~= 202 then
            _G.table.insert(tb, v.id)
        end
    end
    _G.table.sort(
        tb,
        function(a, b)
            return a < b
        end
    )
    return tb
end

---检测全部
---@return number 红点数量
function RedPointAdventure:CheckAll()
    local num = 0
    local cfgs = _G.ConfigManager.system_cfg
    for _, v in pairs(cfgs) do
        if v.id > 200 and v.id ~= 202 then
            num = num + self:CheckParams(v.id)
        end
    end
    return num
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointAdventure:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.ConfigManager.ui_page_cfg[3].FunctionID[3]) then
        return 0
    end
    local cfg = _G.ConfigManager.system_cfg[param]
    if not cfg then
        return 0
    end
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg.function_open) then
        local time = require "SystemEntranceModel":GetInstance():GetRedPoint(param)
        if time and time > 0 and param ~= 201 then
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

--endregion

return RedPointAdventure
