local base = require "RedPointItemBase"
---@class RedPointHellBattlePass	中文描述
local RedPointHellBattlePass = _G.BaseClass("RedPointHellBattlePass", base)

--region子类重写

function RedPointHellBattlePass:GetAllParams()
    local tb = {}
    for k, v in pairs(_G.ConfigManager.discrete_cfg[118002][1]) do
        _G.table.insert(tb, k)
    end
    return tb
end

---获取所有参数
---@return table 参数列表
function RedPointHellBattlePass:CheckAll()
    return require "HellRoadModel":GetInstance():CheckBPCanTake() and 1 or 0
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointHellBattlePass:CheckParams(param)
    if not _G.ConfigManager.discrete_cfg[118002][1][param] then 
        return 0 
    end
    return require "HellRoadModel":GetInstance():CheckBPCanTake(_G.ConfigManager.discrete_cfg[118002][1][param]) and 1 or 0
end
--endregion

return RedPointHellBattlePass
