local base = require "RedPointItemBase"
---@class RedPointItemArenaChallenge:RedPointItemBase	中文描述
local RedPointItemArenaChallenge = _G.BaseClass("RedPointItemArenaChallenge", base)

---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaChallenge:CheckFunctionOpenExtra()
    local ArenaManager = require("ArenaManager")
    return ArenaManager:GetInstance():GetArenaClass(1):GetCurArenaState() == ArenaManager.State.open
end

---检测全部
---@return number 红点数量
function RedPointItemArenaChallenge:CheckAll()
    local arenaCls = require("ArenaManager"):GetInstance():GetArenaClass(1)

    --如果有免费次数或挑战券
    if arenaCls:GetFreeFightTimes() > 0 or arenaCls:GetFightTicketNum() > 0 then
        return 1
    end
    return 0
end

return RedPointItemArenaChallenge
