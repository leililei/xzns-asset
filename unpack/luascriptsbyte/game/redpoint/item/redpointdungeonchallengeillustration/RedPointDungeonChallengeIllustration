local base = require "RedPointItemBase"
---@class RedPointDungeonChallengeIllustration:RedPointItemBase    中文描述
local RedPointDungeonChallengeIllustration = _G.BaseClass("RedPointDungeonChallengeIllustration", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointDungeonChallengeIllustration:GetAllParams()
    if self.allParams then
        return self.allParams
    end
    self.allParams = {}
    for i = 1, 6 do
        table.insert(self.allParams, i)
    end
    return self.allParams
end

function RedPointDungeonChallengeIllustration:CheckParams(param)
    local datas = require("DungeonChallengeIllustrationModel"):GetInstance():GetDataByType(param)
    if not datas or #datas <= 0 then
        return 0
    end
    for _, v in pairs(datas) do
        if v.is_award and v.is_award == 0 then
            return 1
        end
    end
    return 0
end

