local base = require "RedPointItemBase"
---@class RedPointWarTechnologyUpCard    死魂塔礼包
local RedPointWarTechnologyUpCard = _G.BaseClass("RedPointWarTechnologyUpCard", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointWarTechnologyUpCard:GetAllParams()
    if self.allIDs then
        return self.allIDs
    end
    local table = _G.table
    self.allIDs = {}
    for i = 1, 4 do
        table.insert(self.allIDs, i)
    end
    return self.allIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointWarTechnologyUpCard:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.WarTechnology) then
        return 0
    end
    return require "WarTechnologyModel":GetInstance():CheckUpCardRed(param) and 1 or 0
end

---检测全部
---@return number 红点数量
function RedPointWarTechnologyUpCard:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.WarTechnology) then
        return 0
    end
    for i = 1, 4 do
        if require "WarTechnologyModel":GetInstance():CheckUpCardRed(i) == true then
            return 1
        end
    end
    return 0
end

--endregion

return RedPointWarTechnologyUpCard