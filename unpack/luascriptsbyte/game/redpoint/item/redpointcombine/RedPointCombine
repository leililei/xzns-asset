local base = require "RedPointItemBase"
---@class RedPointCombine	中文描述
local RedPointCombine = _G.BaseClass("RedPointCombine", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCombine:GetAllParams()
    local tb = _G.table.keys(_G.ConfigManager.combine_cfg)
    return tb
end
function RedPointCombine:CheckAll()
    return require "CombineModel":GetInstance():CheckSkillCanUp() and 1 or 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCombine:CheckParams(id)
    return require "CombineModel":GetInstance():CheckSkillCanTakeOrActive(id) and 1 or 0
end
--endregion

return RedPointCombine
