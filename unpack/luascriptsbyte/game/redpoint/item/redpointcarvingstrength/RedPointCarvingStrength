local base = require "RedPointItemBase"
---@class RedPointCarvingStrength    中文描述
local RedPointCarvingStrength = _G.BaseClass("RedPointCarvingStrength", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCarvingStrength:GetAllParams()
    if self.allCarvingIDs then
        return self.allCarvingIDs
    end

    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local table = _G.table
    self.allCarvingIDs = {}
    for _, value in pairs(cards) do
        table.insert(self.allCarvingIDs, value.uid)
    end
    return self.allCarvingIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCarvingStrength:CheckParams(param)
    if _G.table.indexof(self.allCarvingIDs, param) == false then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    if _G.table.isEmptyOrNil(cardData) then
        return 0
    end

    local carvingBar = cardData.CarvingBar
    if carvingBar then
        local model = require("CarvingModel"):GetInstance()
        local cfg = _G.ConfigManager.carving_stren_cfg
        local StorageManager = _G.StorageManager:GetInstance()
        for _, v in pairs(carvingBar) do
            if v and not _G.table.isEmptyOrNil(v.carving) and cfg[v.slotLevel] and model:CheckCanStrength(cardData, v.slotLevel or 0) then
                local id, num = model:GetStrenMaterial(v.slotLevel or 0)
                if StorageManager:CheckItem(id, num) then
                    return 1
                end
            end
        end
    end
    return 0
end

function RedPointCarvingStrength:AddParam(param)
    if _G.table.indexof(self.allCarvingIDs, param) == false then
        _G.table.insert(self.allCarvingIDs, param)
    end
    base.AddParam(self, param)
end

function RedPointCarvingStrength:RemoveParam(param)
    for i, v in pairs(self.allCarvingIDs) do
        if v == param then
            _G.table.remove(self.allCarvingIDs, i)
            break
        end
    end
    base.RemoveParam(self, param)
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointCarvingStrength:ParseParamForParent(param)
    return { param }
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointCarvingStrength:GetRedPointNumByParentParam(param)
    if not require("EmbattleModel"):GetInstance():CheckInEmbattle(param, _G.EmbattleType.AFKOnly) then
        return 0
    end
    return self.paramNums[param] or 0
end

--endregion

return RedPointCarvingStrength
