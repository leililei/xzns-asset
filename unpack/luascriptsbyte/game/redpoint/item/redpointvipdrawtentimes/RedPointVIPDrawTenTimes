local VIPDrawModel = require "VIPDrawModel"
local base = require "RedPointItemBase"
---@class RedPointVIPDrawTenTimes	战利品抽卡红点
local RedPointVIPDrawTenTimes = _G.BaseClass("RedPointVIPDrawTenTimes", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointVIPDrawTenTimes:GetAllParams()
    return { 0 }
end

---检测全部
---@return number 红点数量
function RedPointVIPDrawTenTimes:CheckAll()
    if VIPDrawModel:GetInstance():CheckTenTimes() then
        local value = _G.PlayerPrefsManager.GetInt("VIPDrawTenTimes", 0)
        if value == 0 then
            return 1
        end
    end
    return 0
end

--endregion

return RedPointVIPDrawTenTimes
