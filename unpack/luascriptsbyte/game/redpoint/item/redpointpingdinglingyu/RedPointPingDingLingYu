local base = require "RedPointItemBase"
---@class RedPointPingDingLingYu	中文描述
local RedPointPingDingLingYu = _G.BaseClass("RedPointPingDingLingYu", base)

--region子类重写
---@return table 参数列表
function RedPointPingDingLingYu:GetAllParams()
    if self.AllLy then
        return self.AllLy
    end
    self.AllLy = {}
    local cfg = _G.ConfigManager.activity_afk_cfg
    for k, v in pairs(cfg) do
        _G.table.insert(self.AllLy, v.conditions)
    end
    return self.AllLy
end
--region子类重写
---检测全部
---@return number 红点数量
function RedPointPingDingLingYu:CheckAll()
    local cfg = _G.ConfigManager.activity_afk_cfg
    local result
    for k, v in pairs(cfg) do
        result = require("PingDingLingYuModel"):GetInstance():ComputeHaveBox(v.conditions)
        if result then
            return 1
        end
    end
    return 0
end
--endregion
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPingDingLingYu:CheckParams(param)
    return require "PingDingLingYuModel":GetInstance():ComputeHaveBox(param) == true and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointPingDingLingYu:CheckFunctionOpenExtra()
    return require "SeasonManager".CheckSeasonIsOpen()
end
--endregion
return RedPointPingDingLingYu
