local base = require "RedPointItemBase"

---@class RedPointSociatyBattleLeagueGuess	每日成就页签
local RedPointSociatyBattleLeagueGuess = _G.BaseClass("RedPointSociatyBattleLeagueGuess", base)
--region子类重写

function RedPointSociatyBattleLeagueGuess:GetAllParams()
    return {1, 2}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSociatyBattleLeagueGuess:CheckParams(param)
    return require "SociatyBattleLeagueModel":GetInstance():CheckGuessAwardUnclaimed(param) and 1 or 0
end

---检测全部
---@return number 红点数量
function RedPointSociatyBattleLeagueGuess:CheckAll()
    for i = 1, 2 do
        local red = require "SociatyBattleLeagueModel":GetInstance():CheckGuessAwardUnclaimed(i)
        if red then
            return 1
        end
    end
    return 0
end

return RedPointSociatyBattleLeagueGuess
