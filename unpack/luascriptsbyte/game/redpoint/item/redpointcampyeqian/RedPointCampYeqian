local base = require "RedPointItemBase"
---@class RedPointCampYeqian	中文描述
local RedPointCampYeqian = _G.BaseClass("RedPointCampYeqian", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCampYeqian:GetAllParams()
    if self.allyeqianIDs then
        return self.allyeqianIDs
    end
    local cfg = _G.ConfigManager.camp_cfg
    self.allyeqianIDs = {}
    for key, value in pairs(cfg) do
        _G.table.insert(self.allyeqianIDs, key)
    end
    return self.allyeqianIDs
end
---解析参数返回给父节点
---@param param number 子节点参数
---@return number[] 父节点参数
function RedPointCampYeqian:ParseParamForParent(param)
    return {param}
end
--endregion

return RedPointCampYeqian
