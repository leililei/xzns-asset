local base = require "RedPointItemBase"
---@class RedPointItemArenaReport	中文描述
local RedPointItemArenaReport = _G.BaseClass("RedPointItemArenaReport", base)

--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaReport:CheckFunctionOpenExtra()
    local ArenaManager = require("ArenaManager")
    return ArenaManager:GetInstance():GetArenaClass(1):GetCurArenaState() == ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaReport:CheckAll()
    return require("ArenaManager"):GetInstance():GetNewReport(1) and 1 or 0
end
--endregion

return RedPointItemArenaReport
