local base = require "RedPointItemBase"
---@class RedDungonesHy	千机黑煞 挑战（具体的藏品红点）
local RedDungonesHy = _G.BaseClass("RedDungonesHy", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedDungonesHy:GetAllParams()
    if self.allDungonesAward then
        return self.allDungonesAward
    end
    self.allDungonesAward = {}
    for i = 1, 3 do
        table.insert(self.allDungonesAward, i)
    end
    return self.allDungonesAward
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedDungonesHy:CheckParams(param)
    local hyData = require "PrivilegeManager":GetInstance():GetPrivilegeData({_G.PrivilegeType.Dungones.Item})
    if #hyData > 0 then
    else
        return 0
    end
    local DungonesModel = require "DungonesModel"
    local cfg = _G.ConfigManager.dungeons_cfg[DungonesModel:GetInstance().DungonesInfo.section]
    if DungonesModel:GetInstance():CheckHyIsGet(param) then
        return 0
    else
        if not cfg then
            return 0
        else
            if param > cfg.layer then
                return 0
            elseif cfg.layer == param then
                if param == 3 and DungonesModel:GetInstance().DungonesInfo.damage > 0 then
                    return 1
                elseif #cfg.after_section <= 0 then
                    return 1
                else
                    return 0
                end
            else
                return 1
            end
        end
    end
end
--endregion

return RedDungonesHy
