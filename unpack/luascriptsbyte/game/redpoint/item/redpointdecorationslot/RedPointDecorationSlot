local base = require "RedPointItemBase"
---@class RedPointDecorationSlot    中文描述
local RedPointDecorationSlot = _G.BaseClass("RedPointDecorationSlot", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointDecorationSlot:GetAllParams()
    local cards = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    local table = _G.table
    self.allDecorationIDs = {}
    for _, value in pairs(cards) do
        if value > 0 then
            for i = 1, 4 do
                table.insert(self.allDecorationIDs, value * 10 + i)
            end
        end
    end
    return self.allDecorationIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointDecorationSlot:CheckParams(param)
    local index = param % 10
    local uid = _G.GameUtil.GetDivisionNumber(param, 10)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(uid, _G.EmbattleType.AFKOnly)
    if inEmbattle == false then
        return 0
    end
    if _G.table.indexof(self.allDecorationIDs, param) == false then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(cardData) then
        return 0
    end

    local decorationBar = cardData.DecorationBar
    if decorationBar[index] == nil or (decorationBar and decorationBar[index].decoration == nil) then
        local Professional = cardData:GetProfessional()
        local decorationData = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
        for i, v in pairs(decorationData) do
            if (v.cardUid == nil or v.cardUid == 0) and v.Professional == Professional and v.parts == index then
                return 1
            end
        end
    end
    return 0
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number[] 父节点参数
function RedPointDecorationSlot:ParseParamForParent(param)
    return { _G.GameUtil.GetDivisionNumber(param, 10) }
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointDecorationSlot:GetRedPointNumByParentParam(param)
    local inEmbattle = require("EmbattleModel"):GetInstance():CheckInEmbattle(param, _G.EmbattleType.AFKOnly)
    if inEmbattle == false then
        return 0
    end
    local num = 0
    for i = 1, 4 do
        local pointnum = self:GetRedPointNum(param * 10 + i)
        if pointnum then
            num = num + pointnum
        end
    end
    return num
end

return RedPointDecorationSlot
