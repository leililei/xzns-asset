local base = require "RedPointItemBase"
---@class RedPointIceGift	中文描述
local RedPointIceGift = _G.BaseClass("RedPointIceGift", base)
local SeasonIceGiftModel = require "SeasonIceGiftModel"
local SeasonModel = require "SeasonModel"
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointIceGift:CheckAll()
    return SeasonIceGiftModel:GetInstance():RedPointCheck() and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedPointIceGift:CheckFunctionOpenExtra()
    return SeasonModel:GetInstance():CheckFunctionIsOpen(100)
end
--endregion

return RedPointIceGift
