local base = require "RedPointItemBase"
---@class RedPointEmbattleFormation	中文描述
local RedPointEmbattleFormation = _G.BaseClass("RedPointEmbattleFormation", base)

---检测所有红点
---@return number 红点数量
function RedPointEmbattleFormation:CheckAll()
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.EmbattleFormation) == 1 then
        return 0
    end
    return 1
end

return RedPointEmbattleFormation
