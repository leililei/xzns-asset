local ArenaManager = require("ArenaManager")
local defaultArenaID = 1
local base = require "RedPointItemBase"
---@class RedPointArenaChallengeTimes	中文描述
local RedPointItemArenaChallengeTimes = _G.BaseClass("RedPointItemArenaChallengeTimes", base)

--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaChallengeTimes:CheckFunctionOpenExtra()
    return ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.normal):GetCurArenaState() ==
        ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaChallengeTimes:CheckAll()
    return require("ArenaController"):GetInstance():GetFreeFightTimes(ArenaManager.arenaType.normal) > 0 and 1 or 0
end
--endregion

return RedPointItemArenaChallengeTimes
