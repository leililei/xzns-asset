local base = require "RedPointItemBase"
---@class RedPointSecretRealm    死魂塔礼包
local RedPointSecretRealm = _G.BaseClass("RedPointSecretRealm", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSecretRealm:GetAllParams()
    if self.allDecorationIDs then
        return self.allDecorationIDs
    end

    local table = _G.table
    self.allDecorationIDs = {}
    for _, value in pairs(_G.ConfigManager.secret_realm_basic_cfg) do
        table.insert(self.allDecorationIDs, value.id)
    end
    return self.allDecorationIDs
end

---检测全部
---@return number 红点数量
function RedPointSecretRealm:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune) then
        return 0
    end
    for i, v in ipairs(self.allDecorationIDs) do
        local condition = _G.ConfigManager.secret_realm_basic_cfg[v].condition
        if (#condition == 0 or _G.GlobalConditionManager.CheckConditionByArray({ condition })) and require("SecretRealmModel"):GetInstance():GetTicket(v) > 0 then
            return 1
        end
    end
    return 0
end

---@param type number
function RedPointSecretRealm:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune) then
        return 0
    end

    local condition = _G.ConfigManager.secret_realm_basic_cfg[param].condition
    if (#condition == 0 or _G.GlobalConditionManager.CheckConditionByArray({ condition })) and require("SecretRealmModel"):GetInstance():GetTicket(param) > 0 then
        return 1
    end
    return 0
end

--endregion

return RedPointSecretRealm