local base = require "RedPointItemBase"
local ArtifactModel = require("ArtifactModel")
local CardInfoManager = require("CardInfoManager")

---@class RedPointRoleArtifact	每日成就页签
local RedPointRoleArtifact = _G.BaseClass("RedPointRoleArtifact", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointRoleArtifact:GetAllParams()
    local uidLis = {}
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    --local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    --for _, v in pairs(uids) do
    --    if v > 0 then
    --        _G.table.insert(uidLis, v)
    --    end
    --end
    local insert = _G.table.insert
    for _, v in pairs(cards) do
        insert(uidLis, v.uid)
    end
    return uidLis
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointRoleArtifact:CheckParams(param)
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not _G.table.ContainsValue(uidLis, param) then
        return 0 
    end

    if not CardInfoManager.IsArtifactAutoEquip(param) then
        return 0
    end

    local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, param)
    local artifact = cardData.ArtifactBar
    if cardData.star < _G.ConfigManager.discrete_cfg[101204][1][1] then
        return 0
    end
    if _G.table.isEmptyOrNil(artifact) then
        local artifacts = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
        local count = 0
        for _, v in pairs(artifacts) do
            if v then
                count = count + 1
            end
        end
        return count > 0 and 1 or 0
    end
    ---ZHJ-32975 不显示养成
    -- if ArtifactModel:GetInstance():CheckCardArtifactCanUpgrade(param) then
    --     return 1
    -- end
    return 0
    -- return ArtifactModel:GetInstance():CheckCardCanPutOnArtifact(param) and 1 or 0
end

function RedPointRoleArtifact:ParseParamForParent(param)
    return {param}
end

return RedPointRoleArtifact
