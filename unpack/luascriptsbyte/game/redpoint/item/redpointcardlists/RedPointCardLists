local base = require "RedPointItemBase"
---@class RedPointCardLists	中文描述
local RedPointCardLists = _G.BaseClass("RedPointCardLists", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointCardLists:GetAllParams()
    if self.allyeqianIDs then
        return self.allyeqianIDs
    end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local table = _G.table
    local part_uid = 0
    self.allyeqianIDs = {}
    for key, value in pairs(cards) do
        table.insert(self.allyeqianIDs, value.uid)
    end
    return self.allyeqianIDs
end
---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointCardLists:ParseParamForParent(param)
    return {param}
end
--endregion

return RedPointCardLists
