local base = require "RedPointItemBase"
---@class RedPointChat	中文描述
local RedPointChat = _G.BaseClass("RedPointChat", base)
local notdShow = {
    [_G.ChatType.privateChat] = true,
    [_G.ChatType.team] = true
}

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointChat:GetAllParams()
    local tb = {}
    for _, v in pairs(_G.ChatType) do
        if not notdShow[v] then
            _G.table.insert(tb, v)
        end
    end
    return tb
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointChat:CheckParams(param)
    return require "ChatManager":GetInstance():CheckRedPoint(param) and 1 or 0
end
--endregion

return RedPointChat
