local base = require "RedPointItemBase"
local SpiritualDrawModel = require("SpiritualDrawModel"):GetInstance()

---@class RedPointSpiritualDrawTen	每日成就页签
local RedPointSpiritualDrawTen = _G.BaseClass("RedPointSpiritualDrawTen", base)
--region子类重写

---检测全部
---@return number 红点数量
function RedPointSpiritualDrawTen:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SpiritualDraw) then
        return 0
    end
    local material = SpiritualDrawModel:GetLocalCfg().ticket
    local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(material[1])
    return ownNum >= 10 and 1 or 0
end

return RedPointSpiritualDrawTen
