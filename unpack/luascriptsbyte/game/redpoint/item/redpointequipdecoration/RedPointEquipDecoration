---获取所有参数
---卡牌的  uid * 10 + 饰品的位置 = part_uid
---@return table 参数列表
function RedPointEquipDecoration:GetAllParams()
    self.allDecorationIDs = {}
    local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    for _, uid in pairs(uids) do
        if uid > 0 then
            _G.table.insert(self.allDecorationIDs, uid)
        end
    end
    return self.allDecorationIDs
end

