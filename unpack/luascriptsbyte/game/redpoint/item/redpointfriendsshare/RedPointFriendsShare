local base = require "RedPointItemBase"
---@class RedPointFriendsShare	中文描述
local RedPointFriendsShare = _G.BaseClass("RedPointFriendsShare", base)

---检测全部
---@return number 红点数量
function RedPointFriendsShare:CheckAll()
    local saveTime = _G.PlayerPrefsManager.GetString(tostring(_G.PlayerModel:GetInstance().role_uid) ..
        "RedPointFriendsShare")


    if saveTime ~= "" then
        local isNowday = _G.TimeUtil.CheckTheSameDay(tonumber(saveTime), _G.TimeUtil.GetServerUnixTime())
        if isNowday then
            return 0
        else
            return 1
        end
    else
        return 1
    end
end

return RedPointFriendsShare
