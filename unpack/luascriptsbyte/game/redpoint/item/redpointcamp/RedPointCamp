local base = require "RedPointItemBase"
---@class RedPointCamp	中文描述
local RedPointCamp = _G.BaseClass("RedPointCamp", base)
local posIndex = {
    Fir = 1,
    Two = 2,
    The = 3,
    Fou = 4,
    Fiv = 5,
    Six = 6
}

--region子类重写
---获取所有参数 位置 + 营地 sid
---@return table 参数列表
function RedPointCamp:GetAllParams()
    if self.allCamp then
        return self.allCamp
    end
    self.allCamp = {}
    local cfg = _G.ConfigManager.camp_cfg
    for key, value in pairs(cfg) do
        for i = 1, 6 do
            _G.table.insert(self.allCamp, key * 10 + i)
        end
    end
    return self.allCamp
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointCamp:CheckParams(param)
    return require("CampsiteModel"):GetInstance():GerRedpointCampNum(param)
end

function RedPointCamp:ParseParamForParent(param)
    local campid = _G.GameUtil.GetDivisionNumber(param,10)
    return {campid}
end
--- 检测页签 参数
---@param param number 卡牌的 uid
function RedPointCamp:GetRedPointNumByParentParam(param)
    local num = 0
    param = param * 10
    num = num + self:GetRedPointNum(param + posIndex.Fir)
    num = num + self:GetRedPointNum(param + posIndex.Two)
    num = num + self:GetRedPointNum(param + posIndex.The)
    num = num + self:GetRedPointNum(param + posIndex.Fou)
    num = num + self:GetRedPointNum(param + posIndex.Fiv)
    num = num + self:GetRedPointNum(param + posIndex.Six)
    return num
end
