local base = require "RedPointItemBase"

---钻石购买的特权卡
---@class RedPointPrivilegeCardOfDiamond : RedPointItemBase
---@field model MonthlyModel
---@field cardIds number[]  特权卡id
local RedPointPrivilegeCardOfDiamond = _G.BaseClass("RedPointPrivilegeCardOfDiamond", base)

function RedPointPrivilegeCardOfDiamond:GetAllParams()
    if self.cardIds then
        return self.cardIds
    end
    self.model = require("MonthlyModel"):GetInstance()
    self.cardIds = {}
    for id, card in pairs(_G.ConfigManager.store_month_cfg) do
        if card.type_1 == 5 and card.type_2 == 2 then --是特权卡, 且是钻石购买的
            table.insert(self.cardIds, id)
        end
    end
    return self.cardIds
end

function RedPointPrivilegeCardOfDiamond:CheckParams(cardId)
    local cfg = _G.ConfigManager.store_month_cfg[cardId]
    if not cfg or not self:CheckPrivilegeCardUnlock(cfg.display) then
        return 0
    end
    --如果已购买此卡牌, 不显示红点
    if self.model:IsHavePrivi(cardId) then
        return 0
    end
    --如果今日未查看此商品, 则显示红点
    local key = 'DiamondPrivilegeCard' .. cardId
    local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    if _G.PlayerPrefsManager.GetInt(key) ~= time then
        return 1
    end
    return 0
end

---检查特权卡是否已解锁
---@param functionId number  功能id
---@return boolean
function RedPointPrivilegeCardOfDiamond:CheckPrivilegeCardUnlock(functionId)
    if not functionId or functionId == 0 then
        return true
    end
    return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(functionId)
end

return RedPointPrivilegeCardOfDiamond
