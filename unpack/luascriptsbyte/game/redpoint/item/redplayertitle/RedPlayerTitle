local base = require "RedPointItemBase"
---@class RedPlayerTitle 称号
local RedPlayerTitle = _G.BaseClass("RedPlayerTitle", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPlayerTitle:GetAllParams()
    if self.allFrameIDs then
        return self.allFrameIDs
    end
    local framcfg = _G.ConfigManager.player_title_effect_cfg
    local table = _G.table
    self.allFrameIDs = {}
    for key, value in pairs(framcfg) do
        table.insert(self.allFrameIDs, value.id)
    end
    return self.allFrameIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPlayerTitle:CheckParams(param)
    local id = param
    if _G.PlayerModel:GetInstance():IsUnlockTitle(id) then
    else
        return 0
    end
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "title" .. id
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
            return 0
        end
    end
    return 1
end
--endregion

return RedPlayerTitle
