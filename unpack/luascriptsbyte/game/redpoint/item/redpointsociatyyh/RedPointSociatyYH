local SociatyModel = require("SociatyModel")

local base = require "RedPointItemBase"
---@class RedPointSociatyYH    中文描述
local RedPointSociatyYH = _G.BaseClass("RedPointSociatyYH", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSociatyYH:GetAllParams()
    return {0, 1}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSociatyYH:CheckParams(param)
    if param == 0 then
        return SociatyModel:GetInstance():CheckHaveBox() and 1 or 0
    else
        return (require "SociatyManager":GetInstance():CheckSociatyYHNum() or SociatyModel:GetInstance():CheckHaveBox()) and
            1 or
            0
    end
end
--endregion

return RedPointSociatyYH
