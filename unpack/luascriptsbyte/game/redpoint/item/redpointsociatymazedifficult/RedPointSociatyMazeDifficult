local base = require "RedPointItemBase"

---@class RedPointSociatyMazeDifficult: RedPointItemBase	公会-暗影迷宫难度选择
local RedPointSociatyMazeDifficult = _G.BaseClass("RedPointSociatyMazeDifficult", base)

---检测单个红点
---@return number 红点数量
function RedPointSociatyMazeDifficult:CheckAll()
    --如果没有公会
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        return 0
    end

    ---还没有获取到数据
    local startTime, _ = require("SociatyMazeModel"):GetInstance():GetTime()
    if not startTime then
        return 0
    end

    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "SociatyMazeDifficult", 0)
    return num < startTime and 1 or 0
end

return RedPointSociatyMazeDifficult
