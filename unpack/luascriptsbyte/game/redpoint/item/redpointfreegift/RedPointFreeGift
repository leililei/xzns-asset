local base = require "RedPointItemBase"
---@class RedPointFreeGift	中文描述
local RedPointFreeGift = _G.BaseClass("RedPointFreeGift", base)
local store_active_cfg = _G.ConfigManager.store_active_cfg

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointFreeGift:GetAllParams()
    self.freeGifts = {}
    for k, v in pairs(store_active_cfg) do
        ---1-每日礼包；2-每周礼包,商场的免费礼包只需要判断这两种类型即可

        if (v.type_2 == 1 or v.type_2 == 2) and v.price_id == 0 then
            _G.table.insert(self.freeGifts, v.id)
        end
    end
    return self.freeGifts
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointFreeGift:CheckParams(param)
    local num = require "MallManager":GetInstance():GetItemBuyTimes(param, store_active_cfg[param].type_2)
    local result = num < store_active_cfg[param].count_limit and 1 or 0
    require "MallManager":GetInstance():CacheFreeGoodsInfo(store_active_cfg[param].type_2, param, result == 1)
    return num < store_active_cfg[param].count_limit and 1 or 0
end

--endregion

return RedPointFreeGift
