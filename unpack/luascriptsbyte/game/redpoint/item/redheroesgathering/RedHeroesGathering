local base = require "RedPointItemBase"
---@class RedHeroesGathering
local RedHeroesGathering = _G.BaseClass("RedHeroesGathering", base)
---检测全部
---@return number 红点数量
function RedHeroesGathering:CheckAll()
    return require("HeroesGatheringModel"):GetInstance():hongDian() and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedHeroesGathering:CheckFunctionOpenExtra()
    return require "SeasonManager".CheckSeasonIsOpen()
end

return RedHeroesGathering
