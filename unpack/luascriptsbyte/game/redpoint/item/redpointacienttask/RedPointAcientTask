local base = require "RedPointItemBase"
---@class RedPointAcientTask 古之恶来任务页签红点
local RedPointAcientTask = _G.BaseClass("RedPointAcientTask", base)
local stars_mission_cfg = _G.ConfigManager.stars_mission_cfg
local AcientEvilComesModel = require("AcientEvilComesModel")
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointAcientTask:GetAllParams()
    local params = {}
    for k, v in pairs(stars_mission_cfg) do
        _G.table.insert(params, v.id)
    end
    return params
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointAcientTask:CheckParams(param)
    local isOpen = AcientEvilComesModel:GetInstance():CheckIsOpen()
    if isOpen then
        return AcientEvilComesModel:GetInstance():CheckHaveGetTask(param) and 1 or 0
    else
        return 0
    end
end

return RedPointAcientTask
