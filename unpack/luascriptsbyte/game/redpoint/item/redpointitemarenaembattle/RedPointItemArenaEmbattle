local base = require "RedPointItemBase"
---@class RedPointItemArenaEmbattle	中文描述
local RedPointItemArenaEmbattle = _G.BaseClass("RedPointItemArenaEmbattle", base)
--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaEmbattle:CheckFunctionOpenExtra()
    local ArenaManager = require("ArenaManager")
    return ArenaManager:GetInstance():GetArenaClass(1):GetCurArenaState() == ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaEmbattle:CheckAll()
    local data = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.arenaDefence)
    local defenceCardUidList = {}
    local cardNum = 0
    local totalNum = 0
    for _, v in pairs(data) do
        if v > 0 then
            defenceCardUidList[v] = true
            cardNum = cardNum + 1
        end
        totalNum = totalNum + 1
    end
    if cardNum < totalNum then
        local allCard = _G.StorageManager:GetInstance():GetCardDataSortList()
        for _, v in pairs(allCard) do
            if not defenceCardUidList[v.uid] then
                return 1
            end
        end
    end

    return 0
end
--endregion

return RedPointItemArenaEmbattle
