local base = require "RedPointItemBase"

local WorldData = require "WorldData"
---@class RedPointSotry	中文描述
local RedPointSotry = _G.BaseClass("RedPointSotry", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSotry:GetAllParams()
    local cfgs = _G.ConfigManager.main_chapter_cfg
    local tb = {}
    for _, v in pairs(cfgs) do
        if v.ID ~= 300000000 and v.ID ~= 999999999 then
            local count = #v.Section
            for i = 1, count do
                _G.table.insert(tb, v.Section[i])
            end
        end
    end
    return tb
end

---检测全部
---@return number 红点数量
function RedPointSotry:CheckAll()
    local cfgs = _G.ConfigManager.main_chapter_cfg
    local tb = {}
    local num = 0
    for _, v in pairs(cfgs) do
        if v.ID ~= 300000000 and v.ID ~= 999999999 then
            local count = #v.Section
            for i = 1, count do
                num = num + self:CheckParams(v.Section[i])
            end
        end
    end
    if num > 0 then
        _G.WorldUtils.UpdateWorldItemTip(300070001)
    end
    return num
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSotry:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(11) then
        return 0
    end
    if require "ChapterModel":GetInstance():CheckSection(param) then
        local num, count = require "ChapterModel":GetInstance():GetSectionExploreDetail(param)
        if num == count and require "ChapterModel":GetInstance():CheckIsGetSectionAward(param, 4) then
            return 0
        else
            return 1
        end
    else
        return 0
    end
end
--endregion

return RedPointSotry
