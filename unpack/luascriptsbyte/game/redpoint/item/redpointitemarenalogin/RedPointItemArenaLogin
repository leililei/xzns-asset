local base = require "RedPointItemBase"
---@class RedPointItemArenaLogin	中文描述
local RedPointItemArenaLogin = _G.BaseClass("RedPointItemArenaLogin", base)
--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaLogin:CheckFunctionOpenExtra()
    local ArenaManager = require("ArenaManager")
    return ArenaManager:GetInstance():GetArenaClass(1):GetCurArenaState() == ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaLogin:CheckAll()
    return require("ArenaController"):GetInstance():CheckLoginFirstByDay(1) and 1 or 0
end
--endregion

return RedPointItemArenaLogin
