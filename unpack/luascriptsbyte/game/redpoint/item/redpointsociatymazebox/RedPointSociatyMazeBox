local base = require "RedPointItemBase"

---@class RedPointSociatyMazeBox: RedPointItemBase	公会-暗影迷宫宝箱
local RedPointSociatyMazeBox = _G.BaseClass("RedPointSociatyMazeBox", base)

---检测单个红点
---@return number 红点数量
function RedPointSociatyMazeBox:CheckAll()
    --如果没有公会
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        return 0
    end

    local model = require("SociatyMazeBattleModel"):GetInstance()
    if model:GetBoxRedNum() == 0 then
        return 0
    end
    return 1
end

return RedPointSociatyMazeBox
