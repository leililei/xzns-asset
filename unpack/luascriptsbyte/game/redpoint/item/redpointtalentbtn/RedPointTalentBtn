local base = require "RedPointItemBase"
---@class RedPointTalentBtn	中文描述
---@field enableStar number     @达到指定星级时, 开启灵脉
local RedPointTalentBtn = _G.BaseClass("RedPointTalentBtn", base)

function RedPointTalentBtn:__init()
    local cfg = _G.ConfigManager.discrete_cfg[107401]
    self.enableStar = cfg and cfg[1][1] or 999
end

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointTalentBtn:GetAllParams()
    return {1}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointTalentBtn:CheckParams(param)
    local uid = _G.StorageManager:GetInstance().SelectCardUid
    if not uid then
        return 0
    end

    ---@type CardData
    local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, uid)
    if _G.table.isEmptyOrNil(data) then ---试玩卡不进仓库
        return 0
    end

    local order = data.cfg.Order
    local talent = data.cfg.talent
    ---不满足天赋展示要求的卡片
    if order < 3 or #talent <= 0 then
        return 0
    end
    ---彩色及以上才可点灵脉
    if data:GetStar() < self.enableStar then
        return 0
    end

    local model = require "TalentModel":GetInstance()
    local everyLevelTalentNeed = model:TalenNeedNum() --每一级消耗的天赋点点数

    --培养提示: 有角色专属天赋点时不管有没有勾选直接提醒, 有通用天赋点时勾选提示才提醒
    if not require("CardInfoManager").IsShowYc(uid) and data.inborn_num < everyLevelTalentNeed then
        return 0
    end

    --满足天赋展示要求的卡片
    for i = 1, #talent do
        local tt = talent[i]
        for j = 1, #tt do
            ---@type attribute_cfg
            local cfg = _G.ConfigManager.attribute_cfg[tt[j]]

            local isOpen = model:CheckPointOpen(cfg.id)
            if not isOpen then
                if data.inborn_num >= everyLevelTalentNeed then
                    return 1
                end

                if data.inborn_cost_num < model:MaxUseMatrialNum() then
                    local sid, num = model:MaxMatrialNum()
                    local matrialNum = _G.StorageManager:GetInstance():GetItemCountByID(102, sid)
                    if matrialNum >= num then
                        return 1
                    end
                end
            end
        end
    end
    return 0
end

--endregion

return RedPointTalentBtn
