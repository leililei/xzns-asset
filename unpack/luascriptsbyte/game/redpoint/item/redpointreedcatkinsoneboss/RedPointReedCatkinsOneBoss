local base = require "RedPointItemBase"
---@class RedPointReedCatkinsOneBoss    中文描述
local RedPointReedCatkinsOneBoss = _G.BaseClass("RedPointReedCatkinsOneBoss", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointReedCatkinsOneBoss:GetAllParams()
    local list = {}
    local len = #_G.ConfigManager.system_fairyland_chapter_cfg
    for bossId = 1, len do
        table.insert(list, bossId)
    end
    return list
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointReedCatkinsOneBoss:CheckParams(bossID)
    local model = require("SystemFairylandModel"):GetInstance()
    local typeLis = model:GetAllUnlockAwardType(bossID)

    local cfg, bossCfg = model:GetBossCfg(bossID)

    --不满足开启条件
    --目前只配了天数, 刚好六点会固定刷新符合逻辑, 但如果配了其他条件则需要动态监听其条件开放然后刷新红点
    if not cfg or not _G.GlobalConditionManager.CheckConditionArrays(bossCfg.limit_condition) then
        return 0
    end

    if bossID > 1 then
        local isLock = model:GetCurLayer(bossID - 1) ~= model.layerFinalID[bossID - 1]
        if isLock then
            return 0
        end
    end

    local canGet = false
    for i = 1, 3 do
        if _G.table.ContainsValue(typeLis, i) then
            --已解锁
            canGet = true
            break
        end
    end
    if canGet then
        return 1
    end
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    local current = model:GetCurLayerCfg(bossID)
    if not current or current.difficulty < self:GetBossMaxLevel(bossID) then
        --今日未打开过芦花幻境(六点刷新), 且有boss解锁未通关

        local enterView = _G.PlayerPrefsManager.GetInt(
            tostring(_G.PlayerModel:GetInstance().role_uid) .. "EnterSystemFairylandView" .. bossID,
            0
        )
        if enterView ~= timestamp then
            return 1
        end
    end

    if model:CheckNOFullStar() then
        local enterView = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "RedPointSupply", 0)
        if enterView ~= timestamp then
            return 1
        end
    end

    return 0
end
--endregion

---获取boss对应最大层数
---@param bossId number bossID
---@return number
function RedPointReedCatkinsOneBoss:GetBossMaxLevel(bossId)
    if not self.bossMaxLevels then
        ---@type table<number,number> boss对应最大层数
        self.bossMaxLevels = {}

        for _, v in pairs(_G.ConfigManager.system_fairyland_cfg) do
            self.bossMaxLevels[v.grade] = (self.bossMaxLevels[v.grade] or 0) + 1
        end
    end
    return self.bossMaxLevels[bossId] or 0
end

return RedPointReedCatkinsOneBoss
