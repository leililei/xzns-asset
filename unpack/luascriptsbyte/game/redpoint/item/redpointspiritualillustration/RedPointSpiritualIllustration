local base = require "RedPointItemBase"
---@class RedPointSpiritualIllustration	中文描述
local RedPointSpiritualIllustration = _G.BaseClass("RedPointSpiritualIllustration", base)
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSpiritualIllustration:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Spiritual) then
        return 0
    end
    return require"SpiritualIllustrationModel":GetInstance():RedPointCheck()
end

