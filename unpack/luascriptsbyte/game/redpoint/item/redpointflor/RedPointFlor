local base = require "RedPointItemBase"
---@class RedPointFlor	中文描述
local RedPointFlor = _G.BaseClass("RedPointFlor", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointFlor:GetAllParams()
    return {1}
end

---检测单个红点
---@return number 红点数量
function RedPointFlor:CheckAll()
    local florClass = require("DrawModel"):GetInstance():GetFiveLinesOfRecruitment()
    if florClass then
        local isCanGet = false
        if florClass.Info.award_times < 1 then
            if florClass.CurTimes >= florClass.Info.cfg.first_num then
                isCanGet = true
            end
        else
            local showTims =
                florClass.CurTimes - florClass.Info.cfg.first_num -
                (florClass.Info.award_times - 1) * florClass.Info.cfg.num

            if showTims >= florClass.Info.cfg.num then
                isCanGet = true
            end
        end
        if isCanGet then
            return 1
        end
    end
    return 0
end

