local base = require "RedPointItemBase"
---@class RedPointNitpick1 找茬红点
local RedPointNitpick1 = _G.BaseClass("RedPointNitpick1", base)

function RedPointNitpick1:GetAllParams()
    local params = { 0 }
    for _, v in pairs(require("NitpickModel"):GetInstance():GetLevelCfg()) do
        _G.table.insert(params, v.id)
    end
    return params
end

function RedPointNitpick1:CheckParams(param)
    return require("NitpickModel"):GetInstance():CheckRedpoint(param)
end

---检测全部红点
---@param param number 参数
function RedPointNitpick1:CheckAll()
    return require("NitpickModel"):GetInstance():CheckRedpoint()
end
--endregion

return RedPointNitpick1
