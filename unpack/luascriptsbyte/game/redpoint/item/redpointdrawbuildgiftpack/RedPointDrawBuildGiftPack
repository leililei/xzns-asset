local base = require "RedPointItemBase"
---@class RedPointDrawBuildGiftPack	中文描述
local RedPointDrawBuildGiftPack = _G.BaseClass("RedPointDrawBuildGiftPack", base)

---检测全部
---@return number 红点数量
function RedPointDrawBuildGiftPack:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Build) then
        return 0
    end
    
    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "BuildGiftLastRefreshTime", 0)
    if num == 0 then
        return 1
    else
        local curTime = _G.TimeUtil.GetServerUnixTime()
        local week = _G.TimeUtil.GetDateTime(num).week
        local sixTime = _G.TimeUtil.GetDayBegin(num) + _G.TimeUtil.GAME_DAY_TIME
        local weekOneTimeNext = sixTime - (week - 1) * 86400 + 604800
        if week == 1 and num <= sixTime then
            weekOneTimeNext = sixTime
        end
        if curTime >= weekOneTimeNext then
            return 1
        end
    end

    --检查是否有可领取的免费礼包
    local giftList = _G.ConfigManager.discrete_cfg[126608]
    if giftList and giftList[1] then
        --免费礼包存储在MallManager中, 付费礼包存储在DrawModel中
        local mallManager = require("MallManager"):GetInstance()
        for _, id in pairs(giftList[1]) do
            local cfg = _G.ConfigManager.store_extra_cfg[id]
            local finalPrice = require("MallManager"):GetInstance():GetFinalPrice(cfg.price_id)
            if cfg and finalPrice <= 0 and (mallManager:GetItemBuyTimes(cfg.id, cfg.type_reset) or 0) < cfg.count_limit then
                return 1
            end
        end
    end

    return 0
end

return RedPointDrawBuildGiftPack
