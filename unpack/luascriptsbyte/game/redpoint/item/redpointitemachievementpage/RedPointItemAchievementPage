local base = require "RedPointItemBase"
---@class RedPointItemAchievementPage	每日成就页签
local RedPointItemAchievementPage = _G.BaseClass("RedPointItemAchievementPage", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemAchievementPage:GetAllParams()
    local tasks = require("ActiveTaskManager"):GetInstance().tasks
    if tasks == nil then
        return {}
    else
        return _G.table.toArray(
            tasks,
            function(v)
                return v.i_task.sid
            end
        )
    end
end
---检测全部
---@return number 红点数量
function RedPointItemAchievementPage:CheckAll()
    return require("ActiveTaskManager"):GetInstance():HaveTaskSubmitedCj() and 1 or 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemAchievementPage:CheckParams(param)
    local task = require("ActiveTaskManager"):GetInstance():GetTaskByTaskid(param)

    if task == nil or task.Cfg.type_mission == 2 or task.i_task.state ~= _G.TaskEnum.ETaskState.Submited then
        return 0
    else
        local isfunction_open = task.Cfg.function_open == 0
        if isfunction_open == false then
            isfunction_open = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(task.Cfg.function_open)
        end
        if isfunction_open then
            return 1
        end
        return 0
    end
end

---@return RedPointItemAchievementPage
return RedPointItemAchievementPage
