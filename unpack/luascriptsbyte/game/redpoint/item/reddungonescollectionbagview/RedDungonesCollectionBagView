local base = require "RedPointItemBase"
---@class RedDungonesCollectionBagView	藏品背包红点
local RedDungonesCollectionBagView = _G.BaseClass("RedDungonesCollectionBagView", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedDungonesCollectionBagView:GetAllParams()
    if self.allCollection then
        return self.allCollection
    end
    local cfg = _G.ConfigManager.dungeons_item_cfg
    self.allCollection = {}
    for _, value in pairs(cfg) do
        table.insert(self.allCollection, value.id)
    end
    return self.allCollection
end
---检测单个红点
---@param param number 藏品的id
---@return number 红点数量
function RedDungonesCollectionBagView:CheckParams(param)
    local id = param
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "Collection" .. id
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
            return 0
        end
    end
    --检测藏品是否有解锁的
    local unLockA = require "DungonesModel":GetInstance():CheckCollectionIsUnLock(param)
    if not unLockA then
        return 0
    end
    return 1
end
--endregion

return RedDungonesCollectionBagView
