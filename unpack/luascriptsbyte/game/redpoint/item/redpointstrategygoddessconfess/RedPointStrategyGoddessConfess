local base = require "RedPointItemBase"
---@class RedPointStrategyGoddessConfess 女神攻略任务红点
local RedPointStrategyGoddessConfess = _G.BaseClass("RedPointStrategyGoddessConfess", base)

function RedPointStrategyGoddessConfess:GetAllParams()
    local params = { }
    local list = require("StrategyGoddessModel"):GetInstance().goddessList
    if not _G.table.isEmptyOrNil(list) then
        for _, v in pairs(list) do
            _G.table.insert(params, v.sid)
        end
    end
    return params
end

function RedPointStrategyGoddessConfess:CheckParams(param)
    return require("StrategyGoddessModel"):GetInstance():CheckRedpoint(param, true)
end

---检测全部红点
---@param param number 参数
function RedPointStrategyGoddessConfess:CheckAll()
    return require("StrategyGoddessModel"):GetInstance():CheckRedpoint(nil, true)
end
--endregion

return RedPointStrategyGoddessConfess
