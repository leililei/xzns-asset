local SpoilsModel = require "SpoilsModel"
local base = require "RedPointItemBase"
---@class RedPointSpoilsCanUp	每日成就页签
local RedPointSpoilsCanUp = _G.BaseClass("RedPointSpoilsCanUp", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSpoilsCanUp:GetAllParams()
    local ids = {}
    local data = SpoilsModel:GetInstance():GetAllDatas()
    for k, v in pairs(data) do
        table.insert(ids, k)
    end
    return ids
end

---解析参数返回给父节点
---@param param number 子节点参数
---@return number 父节点参数
function RedPointSpoilsCanUp:ParseParamForParent(param)
    return {param}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSpoilsCanUp:CheckParams(param)
    local sp = SpoilsModel:GetInstance():GetData(param)
    if sp:IsCanActive() or sp:IsCanStarUp() then
        return 1
    end
    return 0
end

return RedPointSpoilsCanUp
