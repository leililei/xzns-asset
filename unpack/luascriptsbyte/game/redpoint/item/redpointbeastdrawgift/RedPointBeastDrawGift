local base = require "RedPointItemBase"
---@class RedPointBeastDrawGift:RedPointItemBase	中文描述
local RedPointBeastDrawGift = _G.BaseClass("RedPointBeastDrawGift", base)

---检测全部
---@return number 红点数量
function RedPointBeastDrawGift:CheckAll()
    if not _G.AppSetting.IsXzns then
        return 0
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Beast) then
        return 0
    end
    if not self.redpointInit then
        self.redpointInit = true
        local data = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, _G.ActivitySubType.Beast)
        if data then
            local id = data.typeClass:GetRedpointIDByIndex(1)
            require("RedPointManager"):GetInstance():AddRedPointChild(id, _G.ConfigManager.redpoint_cfg.BeastDrawGift.id)
            require("RedPointManager"):GetInstance():RefreshNode(id)
        end
    end
    local num = _G.PlayerPrefsManager.GetInt(
        tostring(_G.PlayerModel:GetInstance().role_uid) .. "BeastGiftLastRefreshTime",
        0
    )
    if num == 0 then
        return 1
    else
        local curTime = _G.TimeUtil.GetServerUnixTime()
        local week = _G.TimeUtil.GetDateTime(num).week
        local sixTime = _G.TimeUtil.GetDayBegin(num) + _G.TimeUtil.GAME_DAY_TIME
        local weekOneTimeNext = sixTime - (week - 1) * 86400 + 604800
        if week == 1 and num <= sixTime then
            weekOneTimeNext = sixTime
        end
        if curTime >= weekOneTimeNext then
            return 1
        end
    end

    --检查是否有可领取的免费礼包
    local giftList = _G.ConfigManager.discrete_cfg[200210]
    if giftList and giftList[1] then
        --免费礼包存储在MallManager中, 付费礼包存储在DrawModel中
        local mallManager = require("MallManager"):GetInstance()
        for _, id in pairs(giftList[1]) do
            local cfg = _G.ConfigManager.store_extra_cfg[id]
            local finalPrice = require "MallManager":GetInstance():GetFinalPrice(cfg.price_id)
            if cfg and finalPrice <= 0 and (mallManager:GetItemBuyTimes(cfg.id, cfg.type_reset) or 0) < cfg.count_limit then
                return 1
            end
        end
    end

    return 0
end

return RedPointBeastDrawGift
