local base = require "RedPointItemBase"
---@class RedPointItemStarCompass	中文描述
local RedPointItemStarCompass = _G.BaseClass("RedPointItemStarCompass", base)

---类的析构函数
function RedPointItemStarCompass:Dispose()
    self.allParamsTab = nil
end

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemStarCompass:GetAllParams()
    if not self.allParamsTab then
        self.allParamsTab = {}
        local insert = _G.table.insert
        for id, _ in pairs(_G.ConfigManager.prof_tree_cfg) do
            insert(self.allParamsTab, id)
        end
    end
    return self.allParamsTab
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemStarCompass:CheckParams(param)
    local PlayerTreeModel = require("PlayerTreeModel"):GetInstance()
    local cfg
    if param ~= _G.PlayerTreeID.mainTree then
        if not PlayerTreeModel:CheckBranchTreeIsOpen() then --分支未开放
            return 0
        end
        if PlayerTreeModel.Branch[param].lv >= PlayerTreeModel.MainTree[_G.PlayerTreeID.mainTree].lv then
            return 0
        end
        cfg = PlayerTreeModel:GetTreeLvCfg(param, PlayerTreeModel.Branch[param].lv + 1)
    else
        cfg = PlayerTreeModel:GetTreeLvCfg(param, PlayerTreeModel.MainTree[param].lv + 1)
    end
    if not cfg or not _G.StorageManager:GetInstance():CheckItem(cfg.material[1], cfg.material[2]) then
        return 0
    end
    return 1
end
--endregion

return RedPointItemStarCompass
