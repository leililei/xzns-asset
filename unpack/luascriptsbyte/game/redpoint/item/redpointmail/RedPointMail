local base = require "RedPointItemBase"
---@class RedPointMail	中文描述
local RedPointMail = _G.BaseClass("RedPointMail", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointMail:GetAllParams()
    local data = require "MailModel":GetInstance().data
    local count = _G.table.count(data)
    local tb = {}
    for i = 1, count do
        table.insert(tb, tonumber(data[i].uid))
    end
    return tb
end
-- ---检测全部
-- ---@return number 红点数量
-- function RedPointMail:CheckAll()
-- end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointMail:CheckParams(param)
    local data = require "MailModel":GetInstance().data
    local mail = nil

    for _, v in pairs(data) do
        if _G.type(v) == "table" then
            if tonumber(v.uid) == param then
                mail = v
                break
            end
        end
    end
    if mail then
        if _G.table.isEmptyOrNil(mail.annex) then
            if mail.state == 0 then
                return 1
            else
                return 0
            end
        else
            if mail.state == 2 then
                return 0
            else
                return 1
            end
        end
    end
    return 0
end

---根据父节点传过来的参数获取红点数量
---@param param number 父节点参数
---@return number 红点数量
function RedPointMail:GetRedPointNumByParentParam(param)
    return self.paramNums[param] or 0
end

return RedPointMail
