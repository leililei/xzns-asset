local base = require "RedPointItemBase"
---@class RedCardHall    中文描述
local RedCardHall = _G.BaseClass("RedCardHall", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedCardHall:GetAllParams()
    if self.allIDs then
        return self.allIDs
    end
    local table = _G.table
    self.allIDs = {}
    local cfgs = _G.ConfigManager.card_hall_cfg
    for k, v in pairs(cfgs) do
        table.insert(self.allIDs, v.id)
    end
    return self.allIDs
end
---检测全部
---@return number 红点数量
function RedCardHall:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.CardHall) then
        return 0
    end
    local cfgs = _G.ConfigManager.card_hall_cfg
    for k, v in pairs(cfgs) do
        if require "CardHallModel":GetInstance():CheckRedByCardSid(v.id) then
            return 1
        end
    end
    return 0
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedCardHall:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.CardHall) then
        return 0
    end
    return require "CardHallModel":GetInstance():CheckRedByCardSid(param) and 1 or 0
end
--endregion

return RedCardHall