local base = require "RedPointItemBase"
---@class RedSeasonTable	中文描述
local RedSeasonTable = _G.BaseClass("RedSeasonTable", base)
local SeasonTurntableModel = require "SeasonTurntableModel"
local SeasonModel = require "SeasonModel"
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedSeasonTable:CheckAll()
    return SeasonTurntableModel:GetInstance():RedPointCheck() and 1 or 0
end

---额外的功能开放检测
---@return boolean 是否开放
function RedSeasonTable:CheckFunctionOpenExtra()
    return SeasonModel:GetInstance():CheckFunctionIsOpen(97)
end
--endregion

return RedSeasonTable
