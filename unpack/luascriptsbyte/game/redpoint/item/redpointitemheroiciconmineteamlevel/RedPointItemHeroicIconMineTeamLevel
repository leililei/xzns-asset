local base = require "RedPointItemBase"
---@class RedPointItemHeroicIconMineTeamLevel	 : RedPointItemBase 中文描述
local RedPointItemHeroicIconMineTeamLevel = _G.BaseClass("RedPointItemHeroicIconMineTeamLevel", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemHeroicIconMineTeamLevel:GetAllParams()
    return {0}
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemHeroicIconMineTeamLevel:CheckParams()
    if _G.AppSetting.IsXzns then
        local cfg = _G.ConfigManager.heroic_icons_team_cfg[require("HeroicMineModelSg"):GetInstance():GetLevel() + 1]
        local iconLevel = require("HeroicIconModel"):GetInstance():GetIconTotalLevel()
        if cfg and iconLevel >= cfg.exp then
            return 1
        end
        return 0
    else
        local upLevelEndTime = require("HeroicMineModelSg"):GetInstance():GetUpLevelEndTime()
        local cfg = _G.ConfigManager.heroic_icons_team_cfg[require("HeroicMineModelSg"):GetInstance():GetLevel() + 1]
        if cfg and _G.StorageManager:GetInstance():CheckItem(cfg.exp[1],cfg.exp[2]) and upLevelEndTime < _G.TimeUtil.GetServerUnixTime() then
            return 1
        end
        return 0
    end
end
--endregion

return RedPointItemHeroicIconMineTeamLevel