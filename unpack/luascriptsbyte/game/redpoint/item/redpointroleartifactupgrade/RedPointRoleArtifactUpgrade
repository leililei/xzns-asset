local base = require "RedPointItemBase"
local ArtifactModel = require("ArtifactModel")
local CardInfoManager = require "CardInfoManager"

---@class RedPointRoleArtifactUpgrade	每日成就页签
local RedPointRoleArtifactUpgrade = _G.BaseClass("RedPointRoleArtifactUpgrade", base)
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointRoleArtifactUpgrade:GetAllParams()
    local uidLis = {}
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    --local uids = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    --for _, v in pairs(uids) do
    --    if v > 0 then
    --        _G.table.insert(uidLis, v)
    --    end
    --end
    local insert = _G.table.insert
    for _, v in pairs(cards) do
        insert(uidLis, v.uid)
    end
    return uidLis
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointRoleArtifactUpgrade:CheckParams(param)
    -- local key = "ArtifactUpgradeRedPoint_" .. param
    -- if not _G.PlayerPrefsManager.HasKey(key) then
    --     return 0
    -- end
    local uidLis = require("EmbattleModel"):GetInstance():GetEmbattleData(_G.EmbattleType.AFKOnly)
    if not _G.table.ContainsValue(uidLis, param) then
        return 0
    end

    -- if not CardInfoManager.IsShowEquipCultivate(param) then
    --     return 0
    -- end

    -- if not CardInfoManager.IsArtifactAutoEquip(param) then
    --     return 0
    -- end
    if not ArtifactModel:GetInstance():CheckCardArtifactCanReplace(param) then
        if ArtifactModel:GetInstance():CheckCardArtifactCanUpgrade(param) then
            return 1
        end
    end

    return 0
end

function RedPointRoleArtifactUpgrade:ParseParamForParent(param)
    return {param}
end

return RedPointRoleArtifactUpgrade
