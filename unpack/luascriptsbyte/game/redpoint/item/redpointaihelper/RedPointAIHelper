local base = require "RedPointItemBase"
---@class RedPointAIHelper: RedPointItemBase	AI助手入口红点
local RedPointAIHelper = _G.BaseClass("RedPointAIHelper", base)

function RedPointAIHelper:GetAllParams()
    return {0}
end

---检测全部红点
function RedPointAIHelper:CheckParams(param)
    --如果功能未开启, 则不显示红点
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(262) then
        return 0
    end
    --判断平台
    local cfg = _G.ConfigManager.discrete_cfg[122001]
    local isAppSetting = cfg and _G.table.ContainsValue(cfg[1], _G.GameUtil:GetPlatform())
    if not isAppSetting then
        return 0
    end

    --以六点作为刷新时刻
    local timestamp = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    local saveTimestamp = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "AIHelper", 0)
    if timestamp ~= saveTimestamp then
        return 1
    end

    return 0
end

--endregion

return RedPointAIHelper
