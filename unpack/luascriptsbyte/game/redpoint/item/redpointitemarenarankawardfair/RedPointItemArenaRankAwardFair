local base = require "RedPointItemBase"
---@class RedPointItemArenaRankAwardFair	中文描述
local RedPointItemArenaRankAwardFair = _G.BaseClass("RedPointItemArenaRankAwardFair", base)
---公平竞技场SID
local arenaSid = 3
--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemArenaRankAwardFair:CheckFunctionOpenExtra()
    local ArenaManager = require("ArenaManager")
    return ArenaManager:GetInstance():GetArenaClass(arenaSid):GetCurArenaState() == ArenaManager.State.open
end
---检测全部
---@return number 红点数量
function RedPointItemArenaRankAwardFair:CheckAll()
    return require("SociatyManager"):GetInstance():CheckFairAwardGotState() and 1 or 0
end
--endregion

return RedPointItemArenaRankAwardFair
