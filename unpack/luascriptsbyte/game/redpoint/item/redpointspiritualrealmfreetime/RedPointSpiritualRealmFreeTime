local base = require "RedPointItemBase"
---@class RedPointSpiritualRealmFreeTime	中文描述
local RedPointSpiritualRealmFreeTime = _G.BaseClass("RedPointSpiritualRealmFreeTime", base)
local SpiritualRealmModel = require("SpiritualRealmModel")

---检测全部
---@return number 红点数量
function RedPointSpiritualRealmFreeTime:CheckAll()
    local time = SpiritualRealmModel:GetInstance():GetRestFreeFightTimes()
    if time > 0 then
        return 1
    end
    return 0
end

return RedPointSpiritualRealmFreeTime
