local base = require "RedPointItemBag"

---@class RedPointItemBagUse : RedPointItemBag	中文描述
local RedPointItemBagUse = _G.BaseClass("RedPointItemBagUse", base)

--region子类重写

---获取所有参数
---@return table 参数列表
function RedPointItemBagUse:GetAllParams()
    if self.allItemIDTab then
        return self.allItemIDTab
    end
    self.allItemIDTab = {}

    local items = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Prop)
    for key, _ in pairs(items) do
        table.insert(self.allItemIDTab, key)
    end
    return self.allItemIDTab
end

---检测单个红点
---@param param number 道具id
---@return number 红点数量
function RedPointItemBagUse:CheckParams(param)
    if not _G.StorageManager:GetInstance():CheckIsShowRedPointUseProp(param) then
        return 0
    end
    if self.showSidTable[param] then
        return 1
    end
    local cfg = _G.ConfigManager.item_cfg[param]
    if not cfg then
        return 0
    end
    return self:CheckUseType(cfg.UseType, param)
end

--endregion

return RedPointItemBagUse
