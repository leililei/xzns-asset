local base = require "RedPointItemBase"
---@class RedPointItemHeroicIconIconLvUp	英雄圣像圣像解锁
local RedPointItemHeroicIconIconLvUp = _G.BaseClass("RedPointItemHeroicIconIconLvUp", base)

--region子类重写
---获取所有参数
---@return table 参数列表
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemHeroicIconIconLvUp:CheckAll()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local value = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicIconLvUpRed, curTime - 86400)
    if _G.TimeUtil.GetDayBySix(value) ~= TimeUtil.GetDayBySix(curTime) then
        local data = self:GetAllParams()
        for k, v in pairs(data) do 
            if require "HeroicIconModel":GetInstance():GetTotalLevelCanUp(v) > 0 then 
                return 1
            end
        end
    end
    return 0
end

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemHeroicIconIconLvUp:GetAllParams()
    local table = _G.table
    self.allIDs = {}
    local data = require "HeroicIconModel":GetInstance():GetHeroicIcons() or {}
    for k, v in pairs(data) do
        if v.level > 0 then 
            table.insert(self.allIDs, v.sid)
        end
    end
    return self.allIDs
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemHeroicIconIconLvUp:CheckParams(param)
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local value = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.HeroicIconLvUpRed, curTime - 86400)
    if _G.TimeUtil.GetDayBySix(value) ~= TimeUtil.GetDayBySix(curTime) then
        local data = require "HeroicIconModel":GetInstance():GetHeroicIconBySid(param)
        if data and data.level > 0 then 
            if require "HeroicIconModel":GetInstance():GetTotalLevelCanUp(param) > 0 then 
                return 1
            end
        end
    end
    return 0
end
--endregion

return RedPointItemHeroicIconIconLvUp
