local base = require "RedPointItemBase"
---@class RedPointDrawNormalFreeTimes	中文描述
local RedPointDrawNormalFreeTimes = _G.BaseClass("RedPointDrawNormalFreeTimes", base)

---检测全部
---@return number 红点数量
function RedPointDrawNormalFreeTimes:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Draw) then
        return 0
    end

    return require("DrawModel"):GetInstance():GetDayFreeCount(101) > 0 and 1 or 0
end

return RedPointDrawNormalFreeTimes
