local base = require "RedPointItemBase"
---@class RedPointGuessGameAward	中文描述
local RedPointGuessGameAward = _G.BaseClass("RedPointGuessGameAward", base)

--region子类重写
---额外的功能开放检测
---@return boolean 是否开放
function RedPointGuessGameAward:CheckFunctionOpenExtra()
    return require("GuessGameManager"):GetInstance():GetCurState()
end
---检测全部
---@return number 红点数量
function RedPointGuessGameAward:CheckAll()
    local info = require("GuessGameManager"):GetInstance():GetAllSessionInfo()
    for i = 1, #info do
        local session = info[i]
        if session.award == 0 and session.bet > 0 and session.win > 0 then
            return 1
        end
    end
    return 0
end
--endregion

return RedPointGuessGameAward
