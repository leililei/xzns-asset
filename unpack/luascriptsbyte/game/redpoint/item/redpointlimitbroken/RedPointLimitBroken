local base = require "RedPointItemBase"
local LimitBrokenModel = require("LimitBrokenModel")

---@class RedPointLimitBroken	每日成就页签
local RedPointLimitBroken = _G.BaseClass("RedPointLimitBroken", base)
--region子类重写

function RedPointLimitBroken:GetAllParams()
    local params = {-1}
    for _, v in pairs(_G.ConfigManager.limit_broken_cfg) do
        _G.table.insert(params, v.id)
    end
    return params
end

---检测全部
---@return number 红点数量
function RedPointLimitBroken:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.LimitBroken) then
        return 0
    end
    return LimitBrokenModel:GetInstance():CheckRedPoint(-1) and 1 or 0
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointLimitBroken:CheckParams(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.LimitBroken) then
        return 0
    end
    return LimitBrokenModel:GetInstance():CheckRedPoint(param) and 1 or 0
end

return RedPointLimitBroken
