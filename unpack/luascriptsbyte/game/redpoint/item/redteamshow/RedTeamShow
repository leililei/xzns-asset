local base = require "RedPointItemBase"
---@class RedTeamShow 角色推荐红点 （）
local RedTeamShow = _G.BaseClass("RedTeamShow", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedTeamShow:GetAllParams()
    if self.allTeamShowIDs then
        return self.allTeamShowIDs
    end
    local framcfg = _G.ConfigManager.team_show_cfg
    local table = _G.table
    self.allTeamShowIDs = {}
    for key, value in pairs(framcfg) do
        table.insert(self.allTeamShowIDs, value.id)
    end
    return self.allTeamShowIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedTeamShow:CheckParams(param)
    return require "RoleTeamModel":GetInstance():CheckRedpoint(param) and 1 or 0
end
--endregion

return RedTeamShow
