local base = require "RedPointItemBase"
---@class RedPortrait    头像红点
local RedPortrait = _G.BaseClass("RedPortrait", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPortrait:GetAllParams()
    if self.allPortraitIDs then
        return self.allPortraitIDs
    end
    local portraitcfg = _G.ConfigManager.player_portrait_cfg
    local table = _G.table
    self.allPortraitIDs = {}
    for key, value in pairs(portraitcfg) do
        table.insert(self.allPortraitIDs, value.ID)
    end
    return self.allPortraitIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPortrait:CheckParams(param)
    local sid = param
    --默认第一个 不显示头像 不显示红点
    if sid == 128 then
        return 0
    end
    local cfg = _G.ConfigManager.player_portrait_cfg[sid]
    local type = cfg.unlock_type
    local flag = false
    if type == 1 then
        if cfg.unlock_params then
            for i = 1, #cfg.unlock_params do
                local constain = require "IllustrationModel":GetInstance():HunjiangJieSuo(cfg.unlock_params[i])
                if constain then
                    flag = true
                    break
                else
                    return 0
                end
            end
        else
            return 0
        end
    elseif type == 0 then
        return 0
    end
    if not flag then
        return 0
    end
    --判断本地有没有数据 1 == 解锁 0 == 已经点过
    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. "portrait" .. sid
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
            return 0
        end
    end
    return 1
end
--endregion

return RedPortrait
