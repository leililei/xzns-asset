local base = require "RedPointItemBase"
---@class RedPointSpoilsGift	中文描述
local RedPointSpoilsGift = _G.BaseClass("RedPointSpoilsGift", base)
local store_extra_cfg = _G.ConfigManager.store_extra_cfg
local giftList = _G.ConfigManager.discrete_cfg[126614][1]
--region子类重写
---检测全部
---@return number 红点数量
function RedPointSpoilsGift:CheckAll()
    for _,v in pairs(giftList) do
        if store_extra_cfg[v].price_id == 0 then
            local count = require("MallManager"):GetInstance():GetItemBuyTimes(store_extra_cfg[v].id, store_extra_cfg[v].type_reset)
            if store_extra_cfg[v].count_limit - count ~= 0 then
                return 1
            end
        end
    end
    return 0
end
--endregion

return RedPointSpoilsGift