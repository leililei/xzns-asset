local base = require "RedPointItemBase"
---@class RedPointArtifactFreeTimes	中文描述
local RedPointArtifactFreeTimes = _G.BaseClass("RedPointArtifactFreeTimes", base)

---检测全部
---@return number 红点数量
function RedPointArtifactFreeTimes:CheckAll()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.SpiritualDraw) then
        return 0
    end

    return require("ArtifactDrawModel"):GetInstance():GetDayFreeCount() > 0 and 1 or 0
end

return RedPointArtifactFreeTimes
