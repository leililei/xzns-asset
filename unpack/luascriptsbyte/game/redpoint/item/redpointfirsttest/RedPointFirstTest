local RedPointFirstTest = _G.BaseClass("RedPointFirstTest", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointFirstTest:GetAllParams()
    return {0,1,274}
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointFirstTest:CheckParams(param)
    return require "SeasonModel":GetInstance():CheckRedpoint(param) and 1 or 0
end

