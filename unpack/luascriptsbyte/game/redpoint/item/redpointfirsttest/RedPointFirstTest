---获取节点红点显示数量(包含子节点的数量)
---@param param number 参数(为nil 则返回CheckAll)
---@param isparentparam boolean 是否为父节点参数
---@return number 红点数量
function RedPointFirstTest:GetRedPointNum(param, isparentparam)
    if not self:CheckFunctionOpenExtra() then
        return 0
    end
    local num = 0
    if param then
        if isparentparam then
            num = self:GetRedPointNumByParentParam(param)
        else
            num = self.paramNums[param]
        end
    else
        num = self.num
    end
    if #self.child > 0 then
        local RedPointManager = require("RedPointManager"):GetInstance()
        for i = 1, #self.child do
            num = num + RedPointManager:GetNodeNum(self.child[i], param, true)
        end
    end
    return num
end
--endregion

return RedPointFirstTest
