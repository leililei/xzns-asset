local base = require "RedPointItemBase"
---@class RedPointAction_Sevens	中文描述  七日目标(成王之路) daybutton 页签上红点
local RedPointAction_Sevens = _G.BaseClass("RedPointAction_Sevens", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointAction_Sevens:GetAllParams()
    if self.allActionDay then
        return self.allActionDay
    end
    self.allActionDay = {}
    --期数
    local currenDay = require("ActionGoalsModel"):GetInstance().currenDay
    local curIndex = require("ActionGoalsModel"):GetInstance():GetCurrentQiShu()
    ---当前期数
    for i = 1, require("ActionGoalsModel"):GetInstance().singleDays do
        _G.table.insert(self.allActionDay, curIndex * 100 + i)
    end
    ---上一期
    if curIndex > 1 and currenDay <= _G.ConfigManager.discrete_cfg[105202][1][curIndex - 1] then
        for i = 1, require("ActionGoalsModel"):GetInstance().singleDays do
            _G.table.insert(self.allActionDay, (curIndex - 1) * 100 + i)
        end
    end
    return self.allActionDay
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointAction_Sevens:CheckParams(param)
    if require("ActionGoalsModel"):GetInstance():CheckShowCwzl() == false then
        return 0
    end

    return require("ActionGoalsModel"):GetInstance():GetRedPointActionDayNums(param)
end

function RedPointAction_Sevens:ParseParamForParent(param)
    return { param }
end

---@param param number 期数的id
function RedPointAction_Sevens:GetRedPointNumByParentParam(param)
    local num = 0
    param = param * 100
    for i = 1, 7 do
        local pointnum = self:GetRedPointNum(param + i)
        if pointnum then
            num = num + pointnum
        end
    end
    return num
end

--endregion

return RedPointAction_Sevens
