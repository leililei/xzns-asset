local base = require "RedPointItemBase"
---@class RedPointSpoilsDrawAward	中文描述
local RedPointSpoilsDrawAward = _G.BaseClass("RedPointSpoilsDrawAward", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSpoilsDrawAward:GetAllParams()
    local params = {}
    for k, v in ipairs(_G.ConfigManager.item_roller_cfg[50100].rewards_count) do
        _G.table.insert(params, k)
    end
    return params
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSpoilsDrawAward:CheckParams(param)
    return require "SpoilsDrawModel":GetInstance():CheckDrawAwardPointRed(param) and 1 or 0
end
--endregion

return RedPointSpoilsDrawAward