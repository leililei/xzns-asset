local base = require "RedPointItemBase"
---@class RedPointNewSeverSpecialOff	中文描述  七日目标(成王之路) daybutton 页签上红点
local RedPointNewSeverSpecialOff = _G.BaseClass("RedPointNewSeverSpecialOff", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointNewSeverSpecialOff:GetAllParams()
    if self.allgift then
        return self.allgift
    end
    local info= require("NewSeverSpecialOffModel"):GetInstance().info
    self.allgift={}
    for k,v in pairs(info) do
        table.insert(self.allgift,k)
    end
    return self.allgift
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointNewSeverSpecialOff:CheckParams(param)
    if require("NewSeverSpecialOffModel"):GetInstance():CheckGiftIsBuy(param) == 0 then
        return 0
    end

    return require("NewSeverSpecialOffModel"):GetInstance():CheckGiftHasGet(param)
end
function RedPointNewSeverSpecialOff:CheckAll()
    return require("NewSeverSpecialOffModel"):GetInstance():CheckShowRed()
end

--endregion

return RedPointNewSeverSpecialOff