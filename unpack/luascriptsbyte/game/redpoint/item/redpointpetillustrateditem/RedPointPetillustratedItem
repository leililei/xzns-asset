local base = require "RedPointItemBase"
---@class RedPointPetillustratedItem	中文描述
local RedPointPetillustratedItem = _G.BaseClass("RedPointPetillustratedItem", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointPetillustratedItem:GetAllParams()
    local params = {}
    for _, v in pairs(_G.ConfigManager.pet_cfg) do
        _G.table.insert(params, v.id)
    end
    return params
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointPetillustratedItem:CheckParams(param)
    return require "PetModel":GetInstance():CheckPointRed(param) and 1 or 0
end


return RedPointPetillustratedItem