local base = require "RedPointItemBase"
---@class RedPlayerRoleFrame    头像框红点
local RedPlayerRoleFrame = _G.BaseClass("RedPlayerRoleFrame", base)

--region 检测逻辑
--当玩家有新解锁的头像/头像框时，对应头像和头像框增加红点 （显示红点）
--玩家点击对应带红点的头像/头像框时，红点消失 （点击消失红点）
--endregion
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPlayerRoleFrame:GetAllParams()
    if self.allFrameIDs then
        return self.allFrameIDs
    end
    local framcfg = _G.ConfigManager.player_rolebox_cfg
    local table = _G.table
    self.allFrameIDs = {}
    for key, value in pairs(framcfg) do
        table.insert(self.allFrameIDs, value.ID)
    end
    return self.allFrameIDs
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPlayerRoleFrame:CheckParams(param)
    local sid = param
    --头像框默认第一个 不显示红点
    if sid == _G.ConfigManager.discrete_cfg[150000][1][1] then
        return 0
    end
    --判断是不已经解锁
    if _G.PlayerModel:GetInstance():IsUnlockRoleFrame(sid) then
    else
        return 0
    end

    local key = tostring(_G.PlayerModel:GetInstance().role_uid) .. _G.PlayerPrefsKey.RoleFrame .. sid
    if _G.CS.WechatGameCore.PlayerPrefs.HasKey(key) then
        if _G.CS.WechatGameCore.PlayerPrefs.GetInt(key) == 0 then
            return 0
        end
    end
    return 1
end

return RedPlayerRoleFrame
