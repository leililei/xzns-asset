local base = require "RedPointItemBase"
---@class RedPointSkinCard	中文描述
local RedPointSkinCard = _G.BaseClass("RedPointSkinCard", base)

--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointSkinCard:GetAllParams()
    if self.allSoulLineIDs then
        return self.allSoulLineIDs
    end
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local table = _G.table

    self.allSoulLineIDs = {}
    ---@param value CardData
    for _, value in pairs(cards) do
        if self:CheckIsNotLimit(value.sid) then
            table.insert(self.allSoulLineIDs, value.sid)
        end
    end
    return self.allSoulLineIDs
end

---@param card CardData
function RedPointSkinCard:CheckIsNotLimit(card)
    local skins = _G.ConfigManager.card_cfg[card].skin
    local result = false
    for _, v in pairs(skins) do
        if require "CardCommentManager":GetInstance():ChaXun(v) then
            result = true
        end
    end
    return result
end

---添加一个新的参数
function RedPointSkinCard:AddParam(param)
    if false == _G.table.indexof(self.allSoulLineIDs, param) then
        if self:CheckIsNotLimit(param) then
            table.insert(self.allSoulLineIDs, param)
            base.Check(self, param)
        end
    end
end

function RedPointSkinCard:RemoveParam(param)
    for i, v in pairs(self.allSoulLineIDs) do
        if v == param then
            table.remove(self.allSoulLineIDs, i)
            break
        end
    end
    base.RemoveParam(self, param)
end

---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointSkinCard:CheckParams(param)
    local value = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, param)

    if value and self:CheckIsNotLimit(value.sid) then
        return 1
    end

    -- --魂链是否激活
    -- if Card.soulLink_IsActivate == 0 then
    --     return 0
    -- end

    return 0
end
function RedPointSkinCard:ParseParamForParent(param)
    return {param}
end

--endregion

return RedPointSkinCard
