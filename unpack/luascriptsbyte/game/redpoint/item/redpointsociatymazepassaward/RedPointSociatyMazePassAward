local base = require "RedPointItemBase"

---@class RedPointSociatyMazePassAward: RedPointItemBase	公会-暗影迷宫通关奖励
local RedPointSociatyMazePassAward = _G.BaseClass("RedPointSociatyMazePassAward", base)

---检测单个红点
---@return number 红点数量
function RedPointSociatyMazePassAward:CheckAll()
    --如果没有公会
    if not require("SociatyManager"):GetInstance():HasSociaty() then
        return 0
    end

    local model = require("SociatyMazeBattleModel"):GetInstance()
    if not model:IsPass() or model:GetWinPoint() <= 0 or model:IsGetPassAward() then
        return 0
    end
    return 1
end

return RedPointSociatyMazePassAward
