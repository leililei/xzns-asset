local base = require "RedPointItemBase"
---@class RedPointTurnTerminal	中文描述
local RedPointTurnTerminal = _G.BaseClass("RedPointTurnTerminal", base)

function RedPointTurnTerminal:GetAllParams()
    return { 1, 2 }
end

function RedPointTurnTerminal:CheckParams(param)
    if not require("TurnTerminalModel"):GetInstance():CheckOneOpen() then
        return 0
    end
    return require("TurnTerminalModel"):GetInstance():CheckRedpoint(param)
end

---检测全部
---@return number 红点数量
function RedPointTurnTerminal:CheckAll()
    if not require("TurnTerminalModel"):GetInstance():CheckOneOpen() then
        return 0
    end
    return require("TurnTerminalModel"):GetInstance():CheckRedpoint()
end

return RedPointTurnTerminal
