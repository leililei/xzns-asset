local base = require "RedPointItemBase"
---@class RedPointAcientGoal 古之恶来任务页签红点
local RedPointAcientGoal = _G.BaseClass("RedPointAcientGoal", base)
local AcientEvilComesModel = require "AcientEvilComesModel"
--region子类重写

---检测全部
---@return number 红点数量
function RedPointAcientGoal:CheckAll()
    local isOpen = AcientEvilComesModel:GetInstance():CheckIsOpen()
    if isOpen then
        return AcientEvilComesModel:GetInstance():CheckHaveGetGoal() and 1 or 0
    else
        return 0
    end
end

return RedPointAcientGoal
