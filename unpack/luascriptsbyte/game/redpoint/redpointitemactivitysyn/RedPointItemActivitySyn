local ActivitySynManager = require("ActivitySynManager")
local base = require "RedPointItemBase"
---@class RedPointItemActivitySyn	中文描述
local RedPointItemActivitySyn = _G.BaseClass("RedPointItemActivitySyn", base)
function RedPointItemActivitySyn:__init(id, child, funcid, activityID)
    self.curActivityClass = ActivitySynManager:GetInstance():GetActivityClass(activityID)
    self.initParamsTag = true
end
function RedPointItemActivitySyn:Dispose()
    self.curActivityClass = nil
    self.initParamsTag = nil
end
--region子类重写
---获取所有参数
---@return table 参数列表
function RedPointItemActivitySyn:GetAllParams()
    if self.initParamsTag and not self.allParams then
        self.allParams = self.curActivityClass.typeClass:GetRedPointParams(self.id % 100)
        self.initParamsTag = nil
    end
    return self.allParams
end
---检测全部
---@return number 红点数量
function RedPointItemActivitySyn:CheckAll()
    return self.curActivityClass.typeClass:CheckRedPointNum(self.id)
end
---检测单个红点
---@param param number 参数
---@return number 红点数量
function RedPointItemActivitySyn:CheckParams(param)
    return self.curActivityClass.typeClass:CheckRedPointNum(self.id, param)
end
---额外的功能开放检测
---@return boolean 是否开放
function RedPointItemActivitySyn:CheckFunctionOpenExtra()
    return self.curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Close
end
--endregion

return RedPointItemActivitySyn
