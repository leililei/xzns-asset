---@class RenderTextureManager : Singleton	管理 3D 物体渲染到 2D Texture
local RenderTextureManager = _G.BaseClass("RenderTextureManager", _G.Singleton)
_G.RenderTextureManager = RenderTextureManager

local CS = _G.CS
local typeof = _G.typeof

---@return RenderTextureManager RenderTextureManager
function RenderTextureManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function RenderTextureManager:__init()
    --- 3D 物体节点的初始位置以及旋转
    self.RoleRootPos = {x = -1000, y = -1000, z = -1000}
    self.RolePos = {x = 0, y = -1.36, z = 2}
    self.RoleRot = {x = 0, y = 180, z = 0}

    --- 已渲染物体的数量
    self.RenderCount = 0
end

---销毁对象时,析构函数
function RenderTextureManager:Dispose()
end

---@param targetTransf UnityEngine.Transform 要渲染的 3D 物体
---@param rawImage UnityEngine.UI.RawImage 显示 2D Texture 的图片
---@param name string 节点的名字 没有的话 使用默认格式 rt_transf_x
function RenderTextureManager:RenderToTexture(targetTransf, rawImage, name)
    --设置 layer 只能 rt 相机渲染
    targetTransf:SetLayer(CS.UnityEngine.LayerMask.NameToLayer("RenderObj"))

    local prefPath = "CommonPrefab/RenderToTextureRoot"
    local loaded = function(parentTransf)
        if not parentTransf then
            if _G.AppSetting.DEBUG then
                _G.LogError("parentTransf nil. ")
            end
        end
        if _G.string.IsNullOrEmpty(name) then
            name = "rt_transf_" .. tostring(self.RenderCount)
        end

        parentTransf:SetLocalPosition(
            self.RoleRootPos.x - (100 * self.RenderCount),
            self.RoleRootPos.y,
            self.RoleRootPos.z
        )
        parentTransf:SetName(name)
        targetTransf:SetParentE(parentTransf)
        targetTransf:SetLocalPosition(self.RolePos.x, self.RolePos.y, self.RolePos.z)
        targetTransf:SetLocalEulerAngles(self.RoleRot.x, self.RoleRot.y, self.RoleRot.z)
        ---@type UnityEngine.Camera
        local rtcamera = parentTransf:GetComponentE(typeof(CS.UnityEngine.Camera))
        if not rtcamera then
            if _G.AppSetting.DEBUG then
                _G.LogError("rtcamera nil. ")
            end
            return
        end

        local sizex, sizey = rawImage:GetComponentE(typeof(CS.UnityEngine.RectTransform)):GetRectTransformSizeDelta()
        local mRT =
            CS.FrameWork.Graphic.Utility.RenderTextureUtility.New(
            sizex,
            sizey,
            32,
            CS.UnityEngine.RenderTextureFormat.DefaultHDR,
            CS.UnityEngine.RenderTextureReadWrite.Default,
            4
        )

        rawImage.texture = mRT
        rawImage.color = CS.UnityEngine.Color.gray

        rtcamera.targetTexture = mRT
        self.RenderCount = self.RenderCount + 1
    end
    _G.PoolsManager:GetInstance():Spawn(prefPath, _G.ePoolType.Temporary, nil, loaded)
end
