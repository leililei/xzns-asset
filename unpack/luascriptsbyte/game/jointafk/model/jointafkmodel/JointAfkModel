local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager":GetInstance()
---@class JointAfkModel : ActivitySynTypeBase	
local JointAfkModel = _G.BaseClass("JointAfkModel", base)
local JointAfkManager = require "JointAfkManager":GetInstance()

---创建对象时,入口构造函数
function JointAfkModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    self.infocfgs = self.curActivityClass.cfg.self_info.joint_afk
    JointAfkManager:ParseData(self.curActivityClass.cfg.self_info.joint_afk, self.curActivityClass)
    self:RefreshRedPoint()
end

---获取服务器数据
function JointAfkModel:GetDataFormServer()
    self:GetInfo()
end

function JointAfkModel:HandleGMData(info)
    self.infocfgs = info.joint_afk
    JointAfkManager:ParseData(info.joint_afk, self.curActivityClass)
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
    if ctrl then
        ctrl:UpdateView(self.curActivityClass)
    end
end

function JointAfkModel:ParseData(data)
    self:HandleGMData(data)
    base.ParseData(self)
end

---获取成功回调
---@param msg activity_dragon_chess.s2c_dragon_chess_info
function JointAfkModel:GetInfoCall(msg)
    if msg.ack == 1 then
        --self:ParseData(self)
        self.infocfgs = msg.activity.self_info.joint_afk
        JointAfkManager:ParseData(msg.activity.self_info.joint_afk, self.curActivityClass)
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
        if ctrl then
            ctrl:UpdateView(self.curActivityClass)
        end
    end
end

function JointAfkModel:OnEnterActivity()
    self:RefreshRedPoint()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name, self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function JointAfkModel:GetInfo(call)
    --self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.GetInfoCall)
    )
end

function JointAfkModel:GetAward(pbData, callback)
    require("JointAfkNet"):GetInstance():GetAward(pbData, callback)
end

--是否展示活动
function JointAfkModel.CheckShow()
    local curActivityClass = ActivitySynManager:GetActivityWithTypeId(10042)
    if not curActivityClass then
        return false
    end
    if curActivityClass:GetCurActivityState() ~= ActivitySynManager.State.Open then
        return false
    end
    return true
end

function JointAfkModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.jointAfkChapterView.Name
end

---初始化红点树
function JointAfkModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function JointAfkModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function JointAfkModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() ~= require "ActivitySynManager".State.Open then
        return 0
    end
    if JointAfkManager:CheckHaveCase() and JointAfkManager:GetRedFlag() == 0 then
        return 1
    end
    return 0
end

---刷新奖励红点
function JointAfkModel:RefreshRedPoint()
    local num = self:GetRedpointIDByIndex(1)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function JointAfkModel:Dispose()
end

function JointAfkModel:IsShowInFuliView()
    return false
end

return JointAfkModel
