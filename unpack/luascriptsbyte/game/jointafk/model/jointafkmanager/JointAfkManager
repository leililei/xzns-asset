---@class JointAfkManager : Singleton	中文描述
local JointAfkManager = _G.BaseClass("JointAfkManager", _G.GameDataModelBase)
local ActivitySynManager = require "ActivitySynManager"
local cfg = _G.ConfigManager.activity_joint_afk_cfg
_G.JointAfkManager = JointAfkManager

---@return JointAfkManager JointAfkManager
function JointAfkManager:GetInstance()
    return self.super.GetInstance(self)
end

function JointAfkManager:ParseData(info, curActivityClass)
    self.curActivityClass = curActivityClass
    self.info = info 
    self.info.self_info = self.info.self_info or {}
    self.info.self_info.pass_sids = self.info.self_info.pass_sids or {}
    local temp = {}
    for i = 1, #self.info.cfg_info do 
        temp[self.info.cfg_info[i].chapter_sid] = self.info.cfg_info[i]
    end
    self.info.cfg_info = temp
end
---获取下一次刷新活动页面时间
function JointAfkManager:GetNextFreshTime()
    local t = TimeUtil.GetServerUnixTime()
    for i = 1, #self.info.cfg_info do 
        local openTime = self.info.cfg_info[i].open_time
        if openTime > t then 
            return openTime
        end
    end
end
---获取对应关卡的活动代币奖励数据
function JointAfkManager:GetTokenAwardByID(caseID)
    --判定联动活动抽奖开没有，开了才发代币
    local act = ActivitySynManager:GetInstance():GetActivityWithTypeId(10044)
    local actID = act:GetActivityID()
    if not ActivitySynManager:GetInstance():CheckActivityOpened(actID) then 
        return
    end
    for i = 1, #self.info.cfg_info do 
        for j = 1, #self.info.cfg_info[i].sids do 
            if caseID == self.info.cfg_info[i].sids[j].afk_sid then 
                return self.info.cfg_info[i].sids[j].coin
            end
        end
    end
end
---获取活动代币
function JointAfkManager:AddCoin(caseID)
    --判定联动活动抽奖开没有，开了才发代币
    local act = ActivitySynManager:GetInstance():GetActivityWithTypeId(10044)
    local actID = act:GetActivityID()
    if not ActivitySynManager:GetInstance():CheckActivityOpened(actID) then 
        return
    end
    local coin = self:GetTokenAwardByID(caseID) 
    if not _G.IsNil(coin) then
        for i = 1, #coin do 
            require "JointActivityDrawUpModel":GetInstance():AddCoin(actID, coin[i].coin[3])
        end
    end
end
---获取章节数据
function JointAfkManager:GetChapterInfo(index)
    local id = self.info.cfg_info[index].sids[1].afk_sid
    return cfg[id]
end
---获取未解锁的显示文字
function JointAfkManager:GetChapterUnlockStr(index)
    local t = TimeUtil.GetServerUnixTime()
    local openTime = self.info.cfg_info[index].open_time
    local time = openTime - t
    --时间
    if time > 0 then 
        if time > 86400 then 
            time = _G.math.floor((openTime - t) / 86400)
            return _G.LangUtil.GetLangPackValue(90032200016, time)
        else 
            time = _G.math.ceil((openTime - t) / 3600)
            return _G.LangUtil.GetLangPackValue(90032200017, time)
        end
    end
    --前置关卡
    if index > 1 and not self:CheckCaseOver(self.info.cfg_info[index - 1].sids[#self.info.cfg_info[index - 1].sids].afk_sid) then
        return _G.LangUtil.GetLangPackValue(90032200014)
    end
    return true
end
---检查关卡解锁
---@param tipsBol boolean 是否显示飘字
function JointAfkManager:CheckChapterUnlock(index, tipsBol)
    local t = TimeUtil.GetServerUnixTime()
    local openTime = self.info.cfg_info[index].open_time
    if t < openTime then 
        if openTime - t > 86400 then 
            local time = _G.math.floor((openTime - t) / 86400)
            if tipsBol then 
                _G.PopWindowManager:GetInstance():ShowAllTips(1000103, nil, nil, nil, nil, nil, time)
            end
            return false
        else 
            local time = _G.math.ceil((openTime - t) / 3600)
            if tipsBol then 
                _G.PopWindowManager:GetInstance():ShowAllTips(1000104, nil, nil, nil, nil, nil, time)
            end
            return false
        end
    end
    if index > 1 and not self:CheckCaseOver(self.info.cfg_info[index - 1].sids[#self.info.cfg_info[index - 1].sids].afk_sid) then
        if tipsBol then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1000101)
        end
        return false
    end
    return true
end
---检查章节是否全通
function JointAfkManager:CheckChapterOver(index)
    for i = 1, #self.info.cfg_info[index].sids do 
        if not self:CheckCaseOver(self.info.cfg_info[index].sids[i].afk_sid) then 
            return false
        end
    end
    return true
end
---获取关卡数据
function JointAfkManager:GetCaseInfo(index)
    local list = self.info.cfg_info[index].sids
    local infoList = {}
    for i = 1, #list do 
        infoList[i] = cfg[list[i].afk_sid]
    end
    return infoList
end
---检查关卡是否解锁
function JointAfkManager:CheckCaseUnlock(id)
    local lastCase
    for i = 1, #self.info.cfg_info do 
        for j = 1, #self.info.cfg_info[i].sids do 
            if self.info.cfg_info[i].sids[j].afk_sid == id then 
                if not lastCase or (lastCase and self:CheckCaseOver(lastCase)) then 
                    return true
                end
            end
            lastCase = self.info.cfg_info[i].sids[j].afk_sid
        end
    end
    return false
end
---检查关卡是否通关
function JointAfkManager:CheckCaseOver(id)
    return _G.table.ContainsValue(self.info.self_info.pass_sids, id)
end
---根据关卡index返回点击进入关卡页面的时候选中哪个case的Index
function JointAfkManager:GetCaseIndexByChapterIndex(index)
    for j = 1, #self.info.cfg_info[index].sids do 
        if self:CheckCaseUnlock(self.info.cfg_info[index].sids[j].afk_sid) and not self:CheckCaseOver(self.info.cfg_info[index].sids[j].afk_sid) then 
            return j
        end
    end
end
---通关关卡回调（把ID加进通关ID列表）
function JointAfkManager:UpdateOverCase(id)
    _G.table.insert(self.info.self_info.pass_sids, id)
end
---战斗后恢复窗口
function JointAfkManager:ShowWindows()
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
    if ctrl then
        ctrl:UpdateView()
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.JointActivityView.Name)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
    end
end
---进入战斗
function JointAfkManager:Fight()
    self.openEmbattleState = true
    self.curEmbattleAttackTag = false
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpen, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        _G.EmbattleType.JointAfk,
        _G.EmbattleSaveType.server,
        nil,
        _G.EmbattleControllerItemType.joint,
        _G.handler(self, self.OnEmbattleQuit),
        _G.handler(self, self.OnBattle),
        cfg[self.nowCaseID].monster_group[1]
    )
end

function JointAfkManager:OnEmbattleViewOpen(name)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpen, self)
    local UIManagerIns = _G.UIManager:GetInstance()
    UIManagerIns:HideWindow(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
    UIManagerIns:HideWindow(_G.ConfigManager.ui_cfg.JointActivityView.Name)
end

