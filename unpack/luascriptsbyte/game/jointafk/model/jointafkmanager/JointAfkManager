end
---获取剧情关卡翻页的总页数
function JointAfkManager:GetChapterAllPage(id)
    if cfg[id].FrontChapterStoryID then 
        return _G.math.ceil(#cfg[id].FrontChapterStoryID / 2) 
    end
    return 0
end
---检查有没有可以打的关卡
function JointAfkManager:CheckHaveCase()
    for i = 1, #self.info.cfg_info do 
        for j = 1, #self.info.cfg_info[i].sids do 
            local case = self.info.cfg_info[i].sids[j].afk_sid
            if not self:CheckCaseOver(case) and self:CheckCaseUnlock(case) then 
                return true
            end
        end
    end
end
---红点判定，有没有进过活动页
function JointAfkManager:GetRedFlag()
    return self.redFlag or 0
end

function JointAfkManager:SetRedFlag()
    self.redFlag = 1
end

