---@class jointAfkStoryView : UIBaseView	中文描述
---@field public go_table jointAfkStoryView_GoTable GoTable
local jointAfkStoryView = _G.BaseClass("jointAfkStoryView", _G.UIBaseView)
local JointAfkManager =  require "JointAfkManager":GetInstance()
local cfg = _G.ConfigManager.activity_joint_afk_cfg

function jointAfkStoryView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function jointAfkStoryView:OnCreate(caseID, activityClass)
    if activityClass == nil then
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10042)
    else
        self.curActivityClass = activityClass
    end
    self.caseID = caseID
    self.nowPage = 1
    self.allPage = JointAfkManager:GetChapterAllPage(caseID)
    self:UpdateView()
end

function jointAfkStoryView:UpdateView()
    self:TurnPage(true)
    self:TurnPage(false)
end
function jointAfkStoryView:TurnPage(leftBol)
    local path1 = cfg[self.caseID].FrontChapterStoryID[self.nowPage * 2 - 1]
    local path2 = cfg[self.caseID].FrontChapterStoryID[self.nowPage * 2]
    if leftBol then 
        self.go_table.aorrawimage_left:LoadImage(path1)
        self.go_table.aorrawimage_left:SetActiveE(1)
    else 
        if path2 then 
            self.go_table.aorrawimage_right:LoadImage(path2)
            self.go_table.aorrawimage_right:SetActiveE(1)
        else
            self.go_table.aorrawimage_right:SetActiveE(0)
        end
        self.go_table.aorbtn_close:SetActiveE(self.nowPage == self.allPage and 1 or 0)
        self:ShowArrow()
    end
end
---刷新箭头显示
function jointAfkStoryView:ShowArrow()
    self.go_table.aorbtn_left:SetActiveE(self.nowPage == 1 and 0 or 1)
    self.go_table.aorbtn_right:SetActiveE(self.nowPage == self.allPage and 0 or 1)
end

---界面的销毁函数
function jointAfkStoryView:OnDestroy()
end

---按钮点击事件在这里派发
function jointAfkStoryView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_close" or name == "@_aorbtn_skip" then 
        if cfg[self.caseID].monster_group and #cfg[self.caseID].monster_group > 0 then 
            JointAfkManager:SetNowCase(self.caseID) 
            JointAfkManager:Fight()
            self:Close()
        elseif JointAfkManager:CheckCaseOver(self.caseID) then 
            self:Close()
        else
            local pb = {}
            pb.id = self.curActivityClass:GetActivityID()
            pb.prams = {self.caseID}
            self.curActivityClass.typeClass:GetAward(pb, _G.handlerbind(self, self.GetAwardCallBack, pb.prams))
        end
    elseif name == "@_aorbtn_left" then 
        self.nowPage = self.nowPage - 1
        self:UpdateView()
    elseif name == "@_aorbtn_right" then 
        self.nowPage = self.nowPage + 1
        self:TurnPage(false)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.prf_Fanye_spine,
            self.go_table.obj_spineRoot,
            nil,
            _G.handlerbind(self, self.TurnPage, true)
        )
        --self:UpdateView()
    end
end
---领奖回调
function jointAfkStoryView:GetAwardCallBack(data, prams)
    if data.ack ~= 1 then
        return
    end
    JointAfkManager:SetNowCaseIndex()
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    for i = 1, #prams do 
        JointAfkManager:UpdateOverCase(prams[i])
        JointAfkManager:AddCoin(prams[i])
        local coin = JointAfkManager:GetTokenAwardByID(prams[i])
        if not _G.IsNil(coin) then
            for i = 1, #coin do 
                table.insert(data.award.item, {type ={coin[i].coin[2], coin[i].coin[3]}})
            end
        end
    end
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.jointAfkChapterView.Name)
    if ctrl then
        ctrl:UpdateView()
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    self:Close()
end

return jointAfkStoryView