---@class jointAfkChapterView : UIBaseView	中文描述
---@field public go_table jointAfkChapterView_GoTable GoTable
local jointAfkChapterView = _G.BaseClass("jointAfkChapterView", _G.UIBaseView)
local JointAfkManager =  require "JointAfkManager":GetInstance()

function jointAfkChapterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.chapterObj = {}
    for i = 1, 5 do 
        self.chapterObj[i] = _G.GetAutoGoTable(self.go_table.obj_chapterList:GetChildE(i - 1), _G.handlerbind(self, self.OnClickChapter, i))
    end
    self.caseObj = {}
    self.caseAnim = {}
    --_G.UIUtils.LoadEffectByPath("UI/UI_effect/JointActivityDrawUpView_effect/ef_jointAfkChapterView_cloud", self.go_table.obj_View_TY_blackBg)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jointAfkChapterView_cloud,
        self.go_table.obj_View_TY_blackBg
    )
end

---界面的入口函数
function jointAfkChapterView:OnCreate(activityClass)
    JointAfkManager:SetRedFlag()
    if activityClass == nil then
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10042)
    else
        self.curActivityClass = activityClass
    end
    self.curActivityClass.typeClass:RefreshRedPoint()
    self:UpdateView()
    local time = self.curActivityClass.cfg.time
    self.activityFinishTime = time.start_time + time.run_time
    
    self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.activityTimer:Start()
    self.infoAnim = self.go_table.obj_chapterInfo:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self:UpdateTimer()
end

function jointAfkChapterView:UpdateTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.activityFinishTime > serverTime then
        if self.nextFreshTime and self.nextFreshTime <= serverTime then 
            self.nextFreshTime = nil
            self.curActivityClass.typeClass:GetInfo()
        end
    else
        self:Close()
    end
end

---刷新界面
function jointAfkChapterView:UpdateView()
    self.nextFreshTime = JointAfkManager:GetNextFreshTime()
    for i = 1, 5 do 
        local chapterInfo = JointAfkManager:GetChapterInfo(i)
        if not JointAfkManager:CheckChapterUnlock(i) then 
            self.chapterObj[i].obj_bg3:SetActiveE(1)
            self.chapterObj[i].obj_bg2:SetActiveE(0)
            self.chapterObj[i].obj_bg1:SetActiveE(0)
            self.chapterObj[i].aortext_name3.text = _G.LangUtil.GetLangPackValue(chapterInfo.Name[1]) 
            self.chapterObj[i].aorimage_head3.SpriteName = chapterInfo.icon
            self.chapterObj[i].aortext_time.text = JointAfkManager:GetChapterUnlockStr(i)
        elseif JointAfkManager:CheckChapterOver(i) then 
            self.chapterObj[i].obj_bg3:SetActiveE(0)
            self.chapterObj[i].obj_bg2:SetActiveE(0)
            self.chapterObj[i].obj_bg1:SetActiveE(1)
            self.chapterObj[i].aortext_name1.text = _G.LangUtil.GetLangPackValue(chapterInfo.Name[1]) 
            self.chapterObj[i].aorimage_head1.SpriteName = chapterInfo.icon
        else
            if self.chapterObj[i].obj_bg3:GetActiveSelf() == 1 then 
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_jointAfkChapterView_effect,
                    self.chapterObj[i].aorimage_suo.gameObject,
                    nil,
                    function()
                        self.chapterObj[i].obj_bg3:SetActiveE(0)
                    end
                )
            end
            --self.chapterObj[i].obj_bg3:SetActiveE(0)
            self.chapterObj[i].obj_bg2:SetActiveE(1)
            self.chapterObj[i].obj_bg1:SetActiveE(0)
            self.chapterObj[i].aortext_name2.text = _G.LangUtil.GetLangPackValue(chapterInfo.Name[1]) 
            self.chapterObj[i].aorimage_head2.SpriteName = chapterInfo.icon
        end
        
    end
    --self.go_table.obj_chapterInfo:SetActiveE(0)
    if self.go_table.obj_chapterInfo:GetActiveSelf() == 1 then 
        self:ShowCaseList(self.chooseChapterIndex, JointAfkManager:GetNowCaseIndex())
    end
    
end

---点击章节按钮
function jointAfkChapterView:OnClickChapter(_, _, index)
    local bol = JointAfkManager:CheckChapterUnlock(index, true)
    if bol then 
        self.go_table.aortext_chapter.text = _G.LangUtil.GetLangPackValue(90032200017 + index)
        self:ShowCaseList(index)
    end
    self.chooseChapterIndex = index
end
---刷新显示关卡列表
function jointAfkChapterView:ShowCaseList(index, chooseCase)
    local listInfo = JointAfkManager:GetCaseInfo(index)
    for i = 1, #listInfo do 
        if not self.caseObj[i] then 
            self.caseObj[i] = _G.InstantiateObject(self.go_table.obj_case, self.go_table.obj_content)
        end
        local params = {}
        params.info = listInfo[i]
        params.caseIndex = i
        local go_table = _G.GetAutoGoTable(self.caseObj[i], _G.handlerbind(self, self.OnClickCase, params))
        self.caseAnim[i] = go_table.gameObject:GetChildE(0):GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        go_table.obj_boss:SetActiveE(i == #listInfo and 1 or 0) 
        go_table.obj_boss1:SetActiveE(i == #listInfo and 1 or 0) 
        go_table.obj_choose:SetActiveE(0)
        go_table.aortext_caseNum.text = string.format("%s-%s", index, i)
        go_table.aortext_caseName.text = _G.LangUtil.GetLangPackValue(listInfo[i].customs_name[1])  
        local unlockBol = JointAfkManager:CheckCaseUnlock(listInfo[i].id)
        go_table.aortext_caseName.gameObject:SetActiveE(unlockBol and 1 or 0)
        go_table.aortext_lock.gameObject:SetActiveE(unlockBol and 0 or 1)
        self.caseObj[i]:GetComponentE(_G.typeof(_G.CS.AorRawImage)):SetGray(not unlockBol)
        local overBol = JointAfkManager:CheckCaseOver(listInfo[i].id)
        go_table.obj_over:SetActiveE(overBol and 1 or 0)
        go_table.aortext_caseNum1.text = string.format("%s-%s", index, i)
        go_table.aortext_caseName1.text = _G.LangUtil.GetLangPackValue(listInfo[i].customs_name[1])  
        --go_table.aorbtn_battle:SetActiveE(overBol and 0 or 1)
        local rect = self.caseObj[i]:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        rect:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical, 96)
        self.caseObj[i]:SetActiveE(0)
    end
    _G.GameUtil.ReBuildRTF(self.go_table.obj_content)
    local caseIndex = chooseCase or JointAfkManager:GetCaseIndexByChapterIndex(index)
    if caseIndex then 
        local params = {}
        params.info = listInfo[caseIndex]
        params.caseIndex = caseIndex
        self:OnClickCase(self.caseObj[caseIndex], nil, params)
    end
    self.go_table.obj_chapterInfo:SetActiveE(1)
    _G.DelayDo(
        0.1,
        function()
            --self:PlayCaseItemAnim()
            self.caseObj[1]:SetActiveE(1)
            --self.PlayCaseItemAnim(2)
        end
    )
    _G.DelayDo(
        0.13,
        _G.handlerbind(self, self.PlayCaseItemAnim, 2)
    )
end
function jointAfkChapterView:PlayCaseItemAnim(index)
    self.caseObj[index]:SetActiveE(1)
    if self.caseObj[index + 1] then 
        _G.DelayDo(
        0.03,
        _G.handlerbind(self, self.PlayCaseItemAnim, index + 1)
    )
    end
end
---物品内容选中显示
function jointAfkChapterView:ShowAward(Sid, isGou, number, Parent)
    _G.StorageManager:GetInstance():GetItemBaseView(
        Sid,
        number,
        Parent,
        function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            item.gameObject:SetLocalScaleXYZ(0.65)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:SetGou(isGou)
            if item.go_table.aorrawimage_Icon then
                item.go_table.aorrawimage_Icon:SetGray(isGou)
            end
            if item.go_table.aorimage_Color then
                item.go_table.aorimage_Color:SetGray(isGou)
            end
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            local grade, type = _G.StorageManager:GetInstance():GetItemGrade(Sid)
            if grade > 3 or type == _G.StorageType.Spiritual or type == _G.StorageType.Artifact then
                if item.ShowEffectOrder then
                    item:ShowEffectOrder(true)
                end
            end
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, Sid)
        end
    )
end
---点击关卡列表item
function jointAfkChapterView:OnClickCase(go, _, info)
    local name = go:GetName()
    if name == "$_obj_case(Clone)" then 
        local go_table = _G.GetAutoGoTable(go)
        if go_table.aortext_lock.gameObject:GetActiveSelf() == 1 then 
            _G.PopWindowManager:GetInstance():ShowAllTips(1000102)
            return
        end
        go_table.trans_awardRoot:RemoveAllChildren()
        local rewardT = _G.DeepCopyCfgTable(info.info.reward) 
        local coin = JointAfkManager:GetTokenAwardByID(info.info.id)
        if not _G.IsNil(coin) then
            for i = 1, #coin do 
                table.insert(rewardT, {coin[i].coin[2], coin[i].coin[3]})
            end
        end
        for i = 1, #rewardT do 
            self:ShowAward(rewardT[i][1],  JointAfkManager:CheckCaseOver(info.info.id),rewardT[i][2], go_table.trans_awardRoot)
        end
        local chooseCaseIndex = JointAfkManager:GetNowCaseIndex()
        if chooseCaseIndex then 
            local go_table1 = _G.GetAutoGoTable(self.caseObj[chooseCaseIndex])
            go_table1.obj_choose:SetActiveE(0)
            local rect = self.caseObj[chooseCaseIndex]:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
            rect:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical, 96)
        end
        local rect = go:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        rect:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical, 136)
        go_table.obj_choose:SetActiveE(1)
        JointAfkManager:SetNowCaseIndex(info.caseIndex)
        _G.GameUtil.ReBuildRTF(self.go_table.obj_content)
    elseif name == "@_aorbtn_battle" then 
        if info.info.type_section == 1 or (info.info.FrontChapterStoryID and #info.info.FrontChapterStoryID > 0) then 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.jointAfkStoryView.Name, info.info.id, self.curActivityClass)
        else 
            JointAfkManager:SetNowCase(info.info.id) 
            JointAfkManager:Fight()
        end
    end
end



---界面的销毁函数
function jointAfkChapterView:OnDestroy()
    if self.activityTimer then
        self.activityTimer:Stop()
        self.activityTimer = nil
    end
end

---按钮点击事件在这里派发
function jointAfkChapterView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_closeChapter" then 
        if self.infoAnim ~= nil then
            self.infoAnim:Play("a_jointAfkChapterView_close")
        end
        local chooseCaseIndex = JointAfkManager:GetNowCaseIndex()
        local go_table1 
        if chooseCaseIndex then 
            go_table1 = _G.GetAutoGoTable(self.caseObj[chooseCaseIndex])
            go_table1.trans_awardRoot:SetActiveE(0)
        end
        _G.DelayDo(
            0.3,
            function()
                self.go_table.obj_chapterInfo:SetActiveE(0)
                if chooseCaseIndex then 
                    go_table1.obj_choose:SetActiveE(0)
                    go_table1.trans_awardRoot:SetActiveE(1)
                    local rect = self.caseObj[chooseCaseIndex]:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
                    rect:SetSizeWithCurrentAnchors(CS.UnityEngine.RectTransform.Axis.Vertical, 96)
                    JointAfkManager:SetNowCaseIndex()
                end
            end
        )
    elseif name == "@_aorbtn_CloseView" then 
        self:Close()
    elseif name == "@_aorbtn_help" then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 145)
    end
end

return jointAfkChapterView