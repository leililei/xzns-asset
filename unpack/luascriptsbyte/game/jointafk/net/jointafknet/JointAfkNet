local base = require "BaseGameNet"
---@class JointAfkNet : BaseGameNet	通信协议
local JointAfkNet = _G.BaseClass("JointAfkNet", base)

---拉数据
---@param pbData table PB数据
---@param callback function 完成回调
function JointAfkNet:GetInfo(ID, callback)
    local pbData = {id = ID}
    local item = _G.ConfigManager.net_map.game_activity_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---领取奖励
---@param pbData table PB数据
---@param callback function 完成回调
function JointAfkNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_get_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---关卡挑战
---@param sid number 层数
---@param callback function 挑战回调
function JointAfkNet:Fight(activityID, sid, callback)
    --return self:Access(_G.ConfigManager.net_map.game_activity_module_port_joint_afk_fight, {activity_id = activityID ,sid = sid}, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_port_joint_afk_fight
    local port = base.Access(self, item, {activity_id = activityID ,sid = sid}, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function JointAfkNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function JointAfkNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---@type JointAfkNet
_G.JointAfkNet = JointAfkNet
return JointAfkNet
