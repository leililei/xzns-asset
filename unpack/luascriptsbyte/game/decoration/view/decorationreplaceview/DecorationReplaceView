---@class DecorationReplaceView : UIBaseView 饰品替换界面
---@field public go_table DecorationReplaceView_GoTable GoTable
local DecorationReplaceView = _G.BaseClass("DecorationReplaceView", _G.UIBaseView)
local decoration_grade = {
    none = 0,
    zise = 3,
    chengse = 4,
    red = 5
}
local GetLangPackValue = _G.GetLangPackValue
local iconPostion = {
    [1] = {x = -2, y = 1, z = 0},
    [2] = {x = -2, y = -1, z = 0},
    [3] = {x = 0.2, y = -1, z = 0},
    [4] = {x = 0.2, y = 1, z = 0}
}
function DecorationReplaceView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param uid number 卡牌的 uid
---@param type number 替换 或者 穿戴
function DecorationReplaceView:OnCreate(cardData, decoration_lits, uid_lists, call)
    self.uid = cardData.uid
    self.cardData = cardData
    self.call = call
    self.decoration_lits = decoration_lits or {}
    self.uid_lists = uid_lists
    self.flag = false
    if _G.table.isEmptyOrNil(decoration_lits) then
        self.flag = true
    else
        self.flag = false
    end
    self.grade = decoration_grade.none
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.ResItem))
    self.itemList = self.go_table.scrollloopvectical_list
    self:SetLists()
    if not self.flag then
        self.go_table.obj_nothing:SetActiveE(0)
        self:UpdateLists()
    else
        self.go_table.obj_nothing:SetActiveE(1)
    end
    --self:UpdateToggle(self.go_table.toggle_All, false)
    self:UpdateToggle(self.go_table.toggle_zise, false)
    self:UpdateToggle(self.go_table.toggle_chengse, false)
    self:UpdateToggle(self.go_table.toggle_red, false)
end
function DecorationReplaceView:SetLists()
    self.de_lits = {}
    if _G.table.isEmptyOrNil(self.decoration_lits) then
        self.flag = true
        return
    else
        self.flag = false
    end
    for i = 1, #self.uid_lists do
        local data = self.decoration_lits[self.uid_lists[i]]
        if data.Grade == self.grade and data.cardUid == 0 then
            _G.table.insert(self.de_lits, data)
        elseif self.grade == 0 and data.cardUid == 0 then
            _G.table.insert(self.de_lits, data)
        end
    end
    -- for key, value in pairs(self.decoration_lits) do
    --     if value.Grade == self.grade then
    --         _G.table.insert(self.de_lits, value)
    --     elseif self.grade == 0 then
    --         _G.table.insert(self.de_lits, value)
    --     end
    -- end
    if _G.table.isEmptyOrNil(self.de_lits) then
        self.flag = true
    else
        self.flag = false
    end
end

function DecorationReplaceView:UpdateLists()
    local DB, DA
    table.sort(
        self.de_lits,
        function(b, a)
            DB = b
            DA = a
            if DB.cardUid == 0 and DA.cardUid ~= 0 then
                return true
            elseif DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade > DA.Grade then
                return true
            elseif DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade == DA.Grade and DB.streng > DA.streng then
                return true
            elseif
                DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade == DA.Grade and DB.streng == DA.streng and
                    DB.uid > DA.uid
             then
                return true
            end

            return false
        end
    )
    local sumCount = #self.de_lits
    if self.sumCount ~= sumCount then
        if self.mlistView2 == nil then
            self.go_table.scrollloopvectical_list:InitItemData(sumCount, _G.handlerbind(self, self.ResItem))
            self.mlistView2 = self.go_table.scrollloopvectical_list
        else
            self.mlistView2:UpdateCount(sumCount)
        end
    else
        self.mlistView2:UpdateAllItem()
    end
    self.sumCount = sumCount
end

function DecorationReplaceView:ResItem(index, obj)
    if index < 0 then
        return
    end
    local item = obj:GetInstanceIDE()
    local tb = _G.GetAutoGoTable(obj)
    obj:SetName(item .. "__" .. index)
    local dData = self.de_lits[index + 1]
    tb.aortext_name.text = GetLangPackValue(dData.cfg.name)
    tb.aortext_part.text = GetLangPackValue(90022500405) .. GetLangPackValue(dData.cfg.parts)
    tb.aorbtn_check.onClick:RemoveAllListeners()
    tb.aorbtn_check.onClick:AddListener(_G.handlerbind(self, self.ChaKanTipes, obj, dData))
    tb.aorbtn_zhuangbei.onClick:RemoveAllListeners()
    tb.aorbtn_zhuangbei.onClick:AddListener(_G.handlerbind(self, self.UpOrReplace, obj, dData))

    local headItem = _G.GetAutoGoTable(tb.obj_ItemDecorationBase)
    _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
    headItem.aorimage_Color2.SpriteName = _G.ItemBaseIconName_Decoration[dData.Grade]
    headItem.aorimage_Color.SpriteName = dData:GetDecorationJiaoBiaoImage()

    local pos = iconPostion[dData.cfg.parts]
    headItem.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    headItem.aorrawimage_Icon:LoadImage(dData.Icon)
    if dData.streng > 0 then
        headItem.aortext_Lv.text = "+" .. dData.streng
    else
        headItem.aortext_Lv.text = ""
    end
    --是否 装备
    if dData.cardUid > 0 then
        _G.GameUtil.SetActiveByCondition(headItem.obj_Equip, true)
    else
        _G.GameUtil.SetActiveByCondition(headItem.obj_Equip, false)
    end
    return obj
end

---穿戴饰品 或者 替换
---@param decorationData table 饰品数据
function DecorationReplaceView:UpOrReplace(go, decorationData)
    require("DecorationModel"):GetInstance():SetDecoration(
        self.uid,
        {decorationData.cfg.parts},
        {decorationData.uid},
        function()
            self:Close()
            self.call(decorationData)
        end
    )
end
---查看按钮
---@param go table 物体
---@param data number 饰品的data
function DecorationReplaceView:ChaKanTipes(go, data)
    local msg = {}
    local data1 = {}

    local data2 = {}
    data2.data = data
    data2.isSelf = false
    data2.btn = nil
    data1.data = self.cardData.DecorationBar[data.cfg.parts]
    data1.isSelf = true
    data1.btn = nil
    table.insert(msg, data1)
    table.insert(msg, data2)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, msg)
end
function DecorationReplaceView:UpdateToggle(go, isOn)
    local tb = _G.GetAutoGoTable(go)
    -- _G.GameUtil.SetActiveByCondition(tb.aortext_togDesc1, isOn)
    -- _G.GameUtil.SetActiveByCondition(tb.aorimage_bg, isOn)
    _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, isOn)
end
---按钮点击事件在这里派发
function DecorationReplaceView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "$_toggle_All" then
        self:UpdateToggle(self.go_table.toggle_All, isOn)
        if isOn then
            self:SelectDecoration(decoration_grade.none)
        end
    elseif name == "$_toggle_zise" then
        self:UpdateToggle(self.go_table.toggle_zise, isOn)
        if isOn then
            self:SelectDecoration(4)
        end
    elseif name == "$_toggle_chengse" then
        self:UpdateToggle(self.go_table.toggle_chengse, isOn)
        if isOn then
            self:SelectDecoration(5)
        end
    elseif name == "$_toggle_red" then
        self:UpdateToggle(self.go_table.toggle_red, isOn)
        if isOn then
            self:SelectDecoration(6)
        end
    elseif name == "$_toggle_blue" then
        self:UpdateToggle(self.go_table.toggle_blue, isOn)
        if isOn then
            self:SelectDecoration(3)
        end
    elseif name == "$_toggle_jinse" then
        self:UpdateToggle(self.go_table.toggle_jinse, isOn)
        if isOn then
            self:SelectDecoration(7)
        end
    elseif name == "@_aorbtn_CloseView" then
        self:Close()
        self.call({})
    elseif name == "@_aorbtn_anyClose" then
        self:Close()
        self.call({})
    end
end
---选择饰品的 品质
function DecorationReplaceView:SelectDecoration(grade_number)
    self.grade = grade_number
    self:SetLists()
    if not self.flag then
        self.go_table.obj_nothing:SetActiveE(0)
        self.go_table.scrollloopvectical_list:SetActiveE(1)
        self:UpdateLists()
    else
        self.go_table.obj_nothing:SetActiveE(1)
        self.go_table.scrollloopvectical_list:SetActiveE(0)
    end
end

return DecorationReplaceView
