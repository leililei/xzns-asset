---@class KeHunTips : UIBaseView	中文描述
---@field public go_table KeHunTips_GoTable GoTable
local KeHunTips = _G.BaseClass("KeHunTips", _G.UIBaseView)
--_G.KeHunTips = KeHunTips

local CS = _G.CS
local typeof = _G.typeof

local keHunOneTips = "UI/DecorationView/tips"

function KeHunTips:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go.name .. "</color>")
            end
        end
    }
end

---界面的入口函数
function KeHunTips:OnCreate(Data)
    self:AddRest()
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)
    self:InitView(Data)
end
---资源加载
function KeHunTips:AddRest()
    -- self.resKey = {
    --     upStarView = "upStarView",
    --     wakeView = "wakeView"
    -- }
    -- self:AddResToList(self.resKey.upStarView, _G.UIResType.pool, "UI/Card/CardInfoView_upStarView")
end
function KeHunTips:SetData(Data)
end

function KeHunTips:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function KeHunTips:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function KeHunTips:InitView(data)
    local trans = self.go_table.trans_Content
    ---@type AttributeClass
    local attribute = data:GetDecorationProp()
    --饰品主属性
    if attribute.attriOther then
        for k, v in pairs(attribute.attriOther) do
            if v ~= 0 then
                _G.PoolsManager:GetInstance():Spawn(
                    keHunOneTips,
                    _G.ePoolType.UIItem,
                    trans,
                    function(tran)
                        local tb = _G.GetAutoGoTable(tran)
                        tb.aortext_title.text = _G.AttrType[k].des
                        tb.aortext_des.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(v))
                    end
                )
            end
        end
    end
    --
    if attribute.attributePercent then
        for k, v in pairs(attribute.attributePercent) do
            if v ~= 0 then
                _G.PoolsManager:GetInstance():Spawn(
                    keHunOneTips,
                    _G.ePoolType.UIItem,
                    trans,
                    function(tran)
                        local tb = _G.GetAutoGoTable(tran)
                        tb.aortext_title.text = _G.AttrType[k].des
                        tb.aortext_des.text = _G.Mathf.RoundToInt(v * 1000)/10 .. "%"
                    end
                )
            end
        end
    end
    if attribute.attribute then
        for k, v in pairs(attribute.attribute) do
            if v ~= 0 then
                _G.PoolsManager:GetInstance():Spawn(
                    keHunOneTips,
                    _G.ePoolType.UIItem,
                    trans,
                    function(tran)
                        local tb = _G.GetAutoGoTable(tran)
                        tb.aortext_title.text = _G.AttrType[k].des
                        tb.aortext_des.text = _G.Mathf.RoundToInt(v * 1000)/10 .. "%"
                    end
                )
            end
        end
    end
end
return KeHunTips
