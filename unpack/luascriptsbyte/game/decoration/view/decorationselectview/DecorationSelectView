        self.PropFiletrate = _G.GetAutoGoTable(self.go_table.obj_Prop, _G.handler(self, self.OnClickBtn))
        ---@type _obj_Prop._obj_propItem_GoTable[]
        self.PropFiletrateItemList = {}
        local prop = _G.ConfigManager.discrete_cfg[102905]
        local obj
        for i = 1, #prop[1] do
            obj = _G.InstantiateObject(self.PropFiletrate.obj_propItem)
            obj:SetParentE(self.PropFiletrate.trans_Content)
            obj:SetActiveE(1)
            local cfg = _G.ConfigManager.type_attribute_cfg[prop[1][i]]
            self.PropFiletrateItemList[i] =
                _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPropFiletrate, cfg.attribute_type))
            self.PropFiletrateItemList[i].aorrawimage_bg:LoadImage(cfg.icon)
            self.PropFiletrateItemList[i].aorrawimage_bg2:LoadImage(cfg.icon)
            self.PropFiletrateItemList[i].aortext_label1.text = GetLangPackValue(cfg.name)
            self.PropFiletrateItemList[i].aortext_label2.text = GetLangPackValue(cfg.name)
            self.PropFiletrateItemList[i].key = cfg.attribute_type
        end
    else
        for i, v in pairs(self.PropFiletrateItemList) do
            v.obj_off:SetActiveE(self.filtrateProp[v.key] and 0 or 1)
            v.obj_on:SetActiveE(self.filtrateProp[v.key] and 1 or 0)
        end
    end
    if self.filtrateProp[0] then
        self.PropFiletrate.aortext_label:SetActiveE(1)
        self.PropFiletrate.obj_content:SetActiveE(0)
    else
        self.PropFiletrate.aortext_label:SetActiveE(0)
        self.PropFiletrate.obj_content:SetActiveE(1)
        for i = 1, self.PropFiletrate.obj_content:GetChildCountE() do
            local trans = self.PropFiletrate["aorrawimage_prop" .. i]
            if self.PropIndexs[i] then
                trans:SetActiveE(1)
                local cfg = _G.ConfigManager.type_attribute_cfg[_G.AttrType[self.PropIndexs[i]].ID]
                trans:LoadImage(cfg.icon)
            else
                trans:SetActiveE(0)
            end
        end
    end
end
