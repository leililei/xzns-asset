function DecorationSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local toggleTemp = self.go_table.trans_toggle
    local toggleCount = toggleTemp:GetChildCountE()
    local temp
    self.toggle = {}
    for i = 1, toggleCount do
        temp = {}
        temp = toggleTemp:GetChildE(i - 1):GetComponentE(typeof(CS.UnityEngine.UI.Toggle))
        self.toggle[i] = temp
    end
    self.isInit = false
    self.cardList_bind_Component = {}
    self.cardList_bind_uieffect = {}
    self.filtrateGrade = {[0] = true}
    self.filtrateProp = {[0] = true}
    self.GradeIndexs = {}
    self.PropIndexs = {}
    self.shengjitishi = {
        [1] = self.go_table.obj_shengjitishi_1,
        [2] = self.go_table.obj_shengjitishi_2,
        [3] = self.go_table.obj_shengjitishi_3,
        [4] = self.go_table.obj_shengjitishi_4
    }
end
function DecorationSelectView:ShowUI(cardData, call)
    if not cardData then
        self:Close()
        return
    end
    self.LastCardEquipProp = _G.GameUtil.GetPropUpData(cardData)
    self.isInit = true
    self.SelectSuit = 0
    self.cardData = cardData
    self:SetFiltrate(_G.DecorationPart.all)
    self:ShowCardList()
    self:Show()
end

---界面的入口函数
