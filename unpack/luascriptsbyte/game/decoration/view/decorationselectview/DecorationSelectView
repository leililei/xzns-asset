    self.cardData = cardData
    self.call = call
    --帅选器
    self.Filtrate = {
        [_G.DecorationPart.all] = {image = self.go_table.aorimage_all, text = self.go_table.aortext_all},
        [_G.DecorationPart.ring] = {image = self.go_table.aorimage_ring, text = self.go_table.aortext_ring},
        [_G.DecorationPart.amulet] = {image = self.go_table.aorimage_amulet, text = self.go_table.aortext_amulet},
        [_G.DecorationPart.necklace] = {image = self.go_table.aorimage_necklace, text = self.go_table.aortext_necklace},
        [_G.DecorationPart.aiglet] = {image = self.go_table.aorimage_aiglet, text = self.go_table.aortext_aiglet}
    }
    --装备饰品
    self.EquipDecoration = {
        [_G.DecorationPart.ring] = _G.GetAutoGoTable(self.go_table.obj_shipin1),
        [_G.DecorationPart.necklace] = _G.GetAutoGoTable(self.go_table.obj_shipin2),
        [_G.DecorationPart.aiglet] = _G.GetAutoGoTable(self.go_table.obj_shipin3),
        [_G.DecorationPart.amulet] = _G.GetAutoGoTable(self.go_table.obj_shipin4)
    }
    self.redponitnodes = {
        [_G.DecorationPart.ring] = self.go_table.obj_redpoint1,
        [_G.DecorationPart.necklace] = self.go_table.obj_redpoint2,
        [_G.DecorationPart.aiglet] = self.go_table.obj_redpoint3,
        [_G.DecorationPart.amulet] = self.go_table.obj_redpoint4
    }
    self.LastCardEquipProp = _G.GameUtil.GetPropUpData(cardData)
    --常驻背景特效
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_CardShowView_huoyan, self.go_table.obj_effect_baoguagn)
    --添加升级动效提示
    self:AddLevelUpHintUiEffect()
    --资源显示
    local resources = _G.ConfigManager.ui_cfg.DecorationSelectView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.SelectSuit = 0
    self:SetFiltrate(_G.DecorationPart.all)
    self:ShowCardList()
    --饰品套装
    --ef_obj_suitnode
    self.Params_LoopInit = true
end
function DecorationSelectView:OnDestroy()
    if self.Params_LoopTimers then
        for i = 1, #self.Params_LoopTimers do
            self.Params_LoopTimers[i]:Stop()
        end
        self.Params_LoopTimers = nil
    end
    self.cardList_bind_Component = nil
end

function DecorationSelectView:AddLevelUpHintUiEffect()
    for i = 1, 4 do
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_keshengjijiantou, self.shengjitishi[i])
    end
end

---设置饰品筛选
---@param type _G.DecorationPart 饰品位置枚举
function DecorationSelectView:SetFiltrate(type)
    self.SelectPart = type
    for i = 1, #self.toggle do
        if (type + 1) == i then
            self.toggle[i].isOn = true
        else
            self.toggle[i].isOn = false
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_deco, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_LoopListView2Group, false)
    self:InitView()
end

---初始化界面
function DecorationSelectView:InitView()
    local isNotHaveAll = false
    for i, v in pairs(self.cardData.DecorationBar) do
        self:UpdateDecorationRedPoint(i)
        if not table.isEmptyOrNil(v) then
            self:SetDecorationBarByPart(i, v, true)
        else
            self:SetDecorationBarByPart(i, v, false)
            isNotHaveAll = true
        end
    end
    self.go_table.aorbtn_AllUnfix:SetActiveE(isNotHaveAll and 0 or 1)
    self.go_table.aorbtn_Allfix:SetActiveE(isNotHaveAll and 1 or 0)
    if self.go_table.obj_LoopListView2Group:GetActiveSelf() == 1 then
        return
    end
    if self.SelectSuit == 0 then
        self.go_table.aortext_suit.text = GetLangPackValue(90023400014)
    else
        self.go_table.aortext_suit.text = GetLangPackValue(_G.ConfigManager.decoration_suit_cfg[self.SelectSuit].name)
    end
    self:ShowDecorationList()
    self:SetProp()
    self:UpdateFiletrate()
end
---穿戴的红点 更新
---@param parts number 装备的位置
function DecorationSelectView:UpdateDecorationRedPoint(parts)
    local part_uid = self.cardData.uid * 10
    self.redponitnodes[parts]:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.EngraveSoul.id,
        part_uid + parts
    )
end
---升级提示
function DecorationSelectView:UpdateUpLevelHint(part, data, isShow)
    local flag = false
    if isShow then
        flag = true
    end
    --查看仓库数据
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)

    if decorations then
        --检测 是不是最高品质
        if flag then
            for key, value in pairs(decorations) do
                if
                    value.uid ~= data.uid and value.cardUid == 0 and value.cfg.parts == part and
                        value.cfg.grade > data.cfg.grade
                 then
                    flag = false
                    break
                end
            end
        end
    else
        flag = false
    end
    if flag then
        flag = require("DecorationModel"):GetInstance():CheckUpLevelHint(data)
        _G.GameUtil.SetActiveByCondition(self.shengjitishi[part], flag)
    else
        _G.GameUtil.SetActiveByCondition(self.shengjitishi[part], false)
    end
end

---设置属性
function DecorationSelectView:SetProp()
    local ContentTrans = (self.go_table.obj_CardProp)
    local ChildCount = ContentTrans:GetChildCountE()
    if ChildCount > 0 then
        for i = 1, ChildCount do
            _G.PoolsManager:GetInstance():Despawn(ContentTrans:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    if self.cardData:GetDecorationCount() > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotProp, false)
        local datas = self.cardData:GetDecorationProp()
        local aCfg = _G.ConfigManager.type_attribute_cfg
        for i, v in pairs(datas.attriOther) do
            if v > 0 then
                _G.PoolsManager:GetInstance():Spawn(
                    propItem,
                    _G.ePoolType.UIItem,
                    ContentTrans,
                    function(tran)
                        if tran then
                            local tb = _G.GetAutoGoTable(tran)
                            --tb.aorrawimage_Icon:LoadImage(_G.AttrType[i].icon)
                            tb.aortext_name.text = _G.AttrType[i].des
                            tb.aortext_value.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(v))
                        end
                    end
                )
            end
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotProp, true)
    end
    local suit_tips = 0
    if not table.isEmptyOrNil(self.cardData:GetDecorationSuit()) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSuit, false)

        local suits = self.cardData:GetDecorationSuit()
        for i = 1, #suits do
            local suitcount = suits[i].count
            if suitcount < 4 then
                self.go_table.aortext_Suit_des.text = ""
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSuit, true)
                self.go_table.obj_suit_tips:SetActiveE(0)
                return
            end
            for j = 1, suitcount do
                if j == 4 then
                    suit_tips = j
                    local grade = self.cardData:GetDecorationLowerGarde()
                    local des, lID, cfg, cfg1
                    cfg1 = _G.ConfigManager.decoration_suit_cfg[suits[i].id]
                    lID = require "DecorationModel":GetInstance():GetGradeToValue(grade, cfg1.att_suit2)
                    cfg = _G.ConfigManager.attribute_cfg
                    des = GetLangPackValue(cfg[lID].describe)
                    self.go_table.aortext_Suit_des.text = des
                end
            end
        end
    else
        self.go_table.aortext_Suit_des.text = ""
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSuit, true)
    end
    self.go_table.obj_suit_tips:SetActiveE(suit_tips == 4 and 1 or 0)
end

---设置饰品item
---@param part _G.DecorationPart 饰品位置枚举
---@param dData DecorationData 饰品数据类
---@param isShow boolean 是否显示
function DecorationSelectView:SetDecorationBarByPart(part, dData, isShow)
    if isShow then
        _G.GameUtil.SetActiveByCondition((self.EquipDecoration[part].transform), true)
        self.EquipDecoration[part].aorrawimage_Icon:LoadImage(dData.Icon)
        self.EquipDecoration[part].aorimage_Color.SpriteName = dData:GetDecorationJiaoBiaoImage()
        if dData.streng > 0 then
            self.EquipDecoration[part].aortext_Lv.text = "+" .. dData.streng
        else
            self.EquipDecoration[part].aortext_Lv.text = ""
        end
    else
        _G.GameUtil.SetActiveByCondition((self.EquipDecoration[part].transform), false)
    end
    self:UpdateUpLevelHint(part, dData, isShow)
end

