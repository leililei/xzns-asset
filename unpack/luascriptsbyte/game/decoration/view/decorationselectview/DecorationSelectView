function DecorationSelectView:SetDecoration(data)
    local part_uid = self.cardData.uid * 10
    if data.cardUid ~= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            420301,
            nil,
            function()
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
                require("DecorationModel"):GetInstance():SetDecoration(
                    self.cardData.uid,
                    {data.cfg.parts},
                    {data.uid},
                    function()
                        --属性飘字
                        UIUtils.ShowPropUp(self.cardData, self.LastCardEquipProp)
                        self.LastCardEquipProp = _G.GameUtil.GetPropUpData(self.cardData)

                        --特效
                        self:UpLevelEffect()
                        part_uid = part_uid + data.cfg.parts
                        --第一次穿戴饰品
                        if self.cardData.soulLink_sign == false then
                            self.cardData.soulLink_sign = true
                        end
                        require("RedPointManager"):GetInstance():RefreshNode(
                            _G.ConfigManager.redpoint_cfg.EngraveSoul.id,
                            part_uid
                        )
                        self:UIEffectSuitActive()
                        self:InitView()
                        self.go_table.scrollloopvectical_cardlist:UpdateAllItem()
                    end
                )
            end
        )
    else
        require("DecorationModel"):GetInstance():SetDecoration(
            self.cardData.uid,
            {data.cfg.parts},
            {data.uid},
            function()
                --属性飘字
                UIUtils.ShowPropUp(self.cardData, self.LastCardEquipProp)
                --特效
                self:UpLevelEffect()
                part_uid = part_uid + data.cfg.parts
