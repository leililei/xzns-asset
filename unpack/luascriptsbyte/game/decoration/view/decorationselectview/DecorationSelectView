function DecorationSelectView:InitFun(item, x)
    self:ResDecorationItem(item, x)
end

function DecorationSelectView:RefreshDecorationList(index, obj, Dlist)
    if index < 0 then
        return
    end
    local item = obj
    local x = index + 1
    item:SetName(x)

    _G.GameUtil.SetActiveByCondition(obj, false)
    if self.isInit == false then
        _G.TimerManager:GetInstance():GetTimer(0.5, self.InitFun, self, true, true, true, item, x):Start()
    else
        self:ResDecorationItem(item, x)
    end
    return item
end

---饰品选着界面
function DecorationSelectView:ResDecorationItem(item, x)
    local data = {}
    data = self.Dlist[self.DecorationUids[x]]
    if data == nil then
        _G.GameUtil.SetActiveByCondition(item, false)
        return
    end
    local tb = _G.GetAutoGoTable(item, _G.handlerbind(self, self.OnClickDecorationItem, data))
    _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
    tb.aorimage_Color2.SpriteName = _G.ItemBaseIconName_Decoration[data.Grade]
    tb.aorimage_Color.SpriteName = data:GetDecorationJiaoBiaoImage()
    local pos = iconPostion[data.cfg.parts]
    tb.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    tb.aorrawimage_Icon:LoadImage(data.Icon)
    if data.streng > 0 then
        tb.aortext_Lv.text = "+" .. data.streng
    else
        tb.aortext_Lv.text = ""
    end

    if data.cardUid ~= 0 then
        _G.GameUtil.SetActiveByCondition(tb.obj_Equip, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.obj_Equip, false)
    end

    if data.BindCardSid ~= 0 then
        _G.GameUtil.SetActiveByCondition(tb.obj_Card, true)
    else
        _G.GameUtil.SetActiveByCondition(tb.obj_Card, false)
    end
end

---点击饰品对象
---@param data DecorationData 饰品数据类
function DecorationSelectView:OnClickDecorationItem(go, isOn, data)
    local msg = {}
    local data1 = {}

    local data2 = {}
    data2.data = data
    data2.isSelf = false
    data2.btn = {}
    data2.btn.left = {}
    data2.btn.right = {}
    data2.btn.left.name = GetLangPackValue(90023400005)
    data2.btn.left.func = _G.handlerbind(self, self.train, data)
    data2.btn.right.name = GetLangPackValue(90023400020)
    data2.btn.right.func = _G.handlerbind(self, self.SetDecoration, data)

    if not table.isEmptyOrNil(self.cardData.DecorationBar[data.cfg.parts]) then
        data1.data = self.cardData.DecorationBar[data.cfg.parts]
        if data2.data.uid ~= data1.data.uid then
            data1.isSelf = true
            data1.btn = nil
            data2.btn.right.name = GetLangPackValue(90020400047)
            table.insert(msg, data1)
            table.insert(msg, data2)
        else
            data1.isSelf = false
            data1.btn = {}
            data1.btn.left = {}
            data1.btn.right = {}
            data1.btn.left.name = GetLangPackValue(90023400032)
            data1.btn.left.func = _G.handlerbind(self, self.Unfix, data)

            data1.btn.right.name = GetLangPackValue(90023400005)
            data1.btn.right.func = _G.handlerbind(self, self.train, data1.data)
            table.insert(msg, data1)
        end
    else
        table.insert(msg, data2)
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, msg)
end

