                    _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGradeFiletrate, 0))
                self.GradeFFiletrateItemList[i].aortext_label1.text = GetLangPackValue(90020200027)
                self.GradeFFiletrateItemList[i].aortext_label2.text = GetLangPackValue(90020200027)
                self.GradeFFiletrateItemList[i].obj_off:SetActiveE(0)
                self.GradeFFiletrateItemList[i].obj_on:SetActiveE(1)
                self.GradeFFiletrateItemList[i].grade = 0
            end
        end
    else
        for i, v in pairs(self.GradeFFiletrateItemList) do
            v.obj_off:SetActiveE(self.filtrateGrade[v.grade] and 0 or 1)
            v.obj_on:SetActiveE(self.filtrateGrade[v.grade] and 1 or 0)
        end
    end
    if self.filtrateGrade[0] then
        self.GradeFiletrate.aortext_label:SetActiveE(1)
        self.GradeFiletrate.obj_content:SetActiveE(0)
        self.GradeIndexs = {}
    else
        self.GradeFiletrate.aortext_label:SetActiveE(0)
        self.GradeFiletrate.obj_content:SetActiveE(1)
        local grade = _G.ConfigManager.discrete_cfg[102904]
        for i = 1, self.GradeFiletrate.obj_content:GetChildCountE() do
            local trans = self.GradeFiletrate["aortext_grade" .. i]
            if self.GradeIndexs[i] then
                trans:SetActiveE(1)
                trans.text = GetLangPackValue(grade[2][self.GradeIndexs[i] - grade[1][1] + 1])
            else
                trans:SetActiveE(0)
            end
        end
    end
end

