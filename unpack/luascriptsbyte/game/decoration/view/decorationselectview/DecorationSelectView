function DecorationSelectView:ShowDecorationList()
    local DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    --背包 是否 有 饰品
    if DList and table.count(DList) > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Noting, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_obtain, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_deco, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Noting2, false)
        self.go_table.obj_Prop:SetActiveE(1)
        self.go_table.obj_Grade:SetActiveE(1)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Noting, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_obtain, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_deco, false)
        self.go_table.obj_Prop:SetActiveE(0)
        self.go_table.obj_Grade:SetActiveE(0)
        return
    end
    self.DecorationUids = {}
    local isHaveGrade = false
    local isHaveProp = false
    for _, v in pairs(DList) do
        isHaveGrade = self.filtrateGrade[0] or self.filtrateGrade[v.cfg.grade]
        if self.filtrateProp[0] then
            isHaveProp = true
        else
            isHaveProp = true
            for k, _ in pairs(self.filtrateProp) do
                if not v.propKeyList[k] then
                    isHaveProp = false
                    break
                end
            end
        end
        if isHaveGrade and isHaveProp then
            if self.SelectSuit ~= 0 then
                if v.cfg.suit == self.SelectSuit then
                    if self.SelectPart == _G.DecorationPart.all then
                        table.insert(self.DecorationUids, v.uid)
                    elseif self.SelectPart == v.cfg.parts then
                        table.insert(self.DecorationUids, v.uid)
                    end
                end
            else
                if self.SelectPart == _G.DecorationPart.all then
                    table.insert(self.DecorationUids, v.uid)
                elseif self.SelectPart == v.cfg.parts then
                    table.insert(self.DecorationUids, v.uid)
                end
            end
        end
    end
    --检测 饰品套装对应部分是否有 饰品
    if _G.table.isEmptyOrNil(self.DecorationUids) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_Noting, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_obtain, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.scrollloopvectical_deco, false)
        if self.isFiltrate then
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_Noting2, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_Noting, false)
        else
            self.go_table.obj_Prop:SetActiveE(0)
            self.go_table.obj_Grade:SetActiveE(0)
        end

        return
    end
    local tb = {}
    for k, _ in pairs(self.filtrateProp) do
        if _G.AttrType[k] then
            tb[k] = _G.AttrType[k].ID
        else
            tb[k] = 0
        end
    end
    ---@type DecorationData
    local DB, DA
    _G.SortList(
        self.DecorationUids,
        function(id)
            DB = DList[id]
            local use = 10
            if DB.cardUid == 0 then
                use = 10
            else
                use = 9
            end
            local prop = 1

            if not self.filtrateProp[0] then
                local max = 0
                local propValue = 0
                local isAdd = false
                for k, _ in pairs(self.filtrateProp) do
                    if DB:CheckHasPropType(k) and tb[k] > max then
                        max = tb[k]
                        propValue = DB.activeAttr[k] or 0
                    end
                end
                prop = prop + max * 10 + propValue / 10000
            end
            return use, prop, DB.streng, DB.Grade, -DB.cfg.suit, -DB.cfg.id
        end
    )
    --排列规则优化：品质>等级>未穿戴>已穿戴>位置（按一二三四的位置进行排列）
    -- table.sort(
    --     self.DecorationUids,
    --     function(b, a)
    --         DB = DList[b]
    --         DA = DList[a]
    --         if DB.cardUid == 0 and DA.cardUid ~= 0 then
    --             return true
    --         elseif DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade > DA.Grade then
    --             return true
    --         elseif DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade == DA.Grade and DB.streng > DA.streng then
    --             return true
    --         elseif
    --             DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade == DA.Grade and DB.streng == DA.streng and
    --                 DB.cfg.parts > DB.cfg.parts
    --          then
    --             return true
    --         elseif
    --             DB.cardUid == 0 and DA.cardUid == 0 and DB.Grade == DA.Grade and DB.streng == DA.streng and
    --                 DB.cfg.parts > DA.cfg.parts and
    --                 DB.uid > DA.uid
    --          then
    --             return true
    --         end

    --         return false
    --     end
    -- )
    self.Dlist = DList
    local sumCount = #self.DecorationUids
    if self.sumCount ~= sumCount then
        if self.mlistView2 == nil then
            self.go_table.scrollloopvectical_deco:InitItemData(
                sumCount,
                _G.handlerbind(self, self.RefreshDecorationList)
            )
            self.mlistView2 = self.go_table.scrollloopvectical_deco
        else
            self.mlistView2:UpdateCount(sumCount)
        end
    else
        self.mlistView2:UpdateAllItem()
    end
