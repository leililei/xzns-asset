---点击属性筛选
function DecorationSelectView:OnClickPropFiletrate(_, _, prop)
    local count = _G.table.count(self.filtrateProp)
    if count >= 5 and not self.filtrateProp[prop] then
        --TODO 提示
        return
    end
    self.filtrateProp[0] = nil
    if self.filtrateProp[prop] then
        self.filtrateProp[prop] = nil
        for k, v in pairs(self.PropIndexs) do
            if v == prop then
                _G.table.remove(self.PropIndexs, k)
                break
            end
        end
        if count - 1 == 0 then
            self.filtrateProp = {[0] = true}
            if self.filtrateGrade[0] then
                self.isFiltrate = false
            end
        end
    else
        self.filtrateProp[prop] = true
        _G.table.insert(self.PropIndexs, prop)
        self.isFiltrate = true
    end
    self:InitView()
end
---点击品质筛选
function DecorationSelectView:OnClickGradeFiletrate(_, _, grade)
    if grade == 0 then
        self.filtrateGrade = {[0] = true}
        if self.filtrateProp[0] then
            self.isFiltrate = false
        end
    else
        local count = _G.table.count(self.filtrateGrade)
        if count >= 5 and not self.filtrateGrade[grade] then
            --TODO 提示
            return
        end
        self.filtrateGrade[0] = nil
        if self.filtrateGrade[grade] then
            self.filtrateGrade[grade] = nil
            for k, v in pairs(self.GradeIndexs) do
                if v == grade then
                    _G.table.remove(self.GradeIndexs, k)
                    break
                end
            end
            if count - 1 == 0 then
                self.filtrateGrade = {[0] = true}
                if self.filtrateProp[0] then
                    self.isFiltrate = false
                end
            end
        else
            self.filtrateGrade[grade] = true
            _G.table.insert(self.GradeIndexs, grade)
            self.isFiltrate = true
        end
    end
    self:InitView()
end

