---卡牌列表检测 是否有可以升级
function DecorationSelectView:UpdateCardListUpLevelHint(carddata, obj_red)
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    if _G.table.isEmptyOrNil(decorations) then
        return false
    end
    local count = 0
    local count_parts = 0
    for i, v in pairs(carddata.DecorationBar) do
        count_parts = count_parts + 1
        if not table.isEmptyOrNil(v) then
            local flag1 = false
            --检测 是不是最高品质
            for key, value in pairs(decorations) do
                if value.uid ~= v.uid and value.cardUid == 0 and value.cfg.parts == i and value.cfg.grade > v.cfg.grade then
                    flag1 = true
                    break
                end
            end
            if flag1 then
                return false
            end
        else
            return false
        end
        --检测 金币是否足够
        local flag = require("DecorationModel"):GetInstance():CheckUpLevelHint(v)
        if flag then
            count = count + 1
        end
        if count_parts == 4 then
            if count ~= 0 then
                return true
            end
        end
    end
    return false
end

