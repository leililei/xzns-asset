---@class DecorationShaiXuan : UIBaseView	中文描述
---@field public go_table DecorationShaiXuan_GoTable GoTable
local DecorationShaiXuan = _G.BaseClass("DecorationShaiXuan", _G.UIBaseView)

function DecorationShaiXuan:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param selectButton table 筛选的 结果 1 红色 2 橙色 3 紫色
function DecorationShaiXuan:OnCreate(call, selectButton)
    self.callDeco = call
    self.isShow = false
    if _G.table.isEmptyOrNil(selectButton) then
        self.selectButton = {
            [1] = {grade = 7, isShow = false},
            [2] = {grade = 6, isShow = false},
            [3] = {grade = 5, isShow = false},
            [4] = {grade = 4, isShow = false},
            [5] = {grade = 3, isShow = false}
        }
    else
        self.selectButton = selectButton
    end

    self.select_obj = {
        [1] = self.go_table.aorimage_2_1,
        [2] = self.go_table.aorimage_2_2,
        [3] = self.go_table.aorimage_2_3,
        [4] = self.go_table.aorimage_2_4,
        [5] = self.go_table.aorimage_2_5
    }
    self:UpdateButton()
end

---按钮点击事件在这里派发
function DecorationShaiXuan:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        for i = 1, #self.selectButton do
            if self.selectButton[i].isShow then
                self.isShow = true
                break
            end
        end
        if self.callDeco then
            self.callDeco(self.isShow, self.selectButton)
        end
        self:Close()
    elseif name == "@_aorbtn_queding" then
        for i = 1, #self.selectButton do
            if self.selectButton[i].isShow then
                self.isShow = true
                break
            end
        end
        if self.callDeco then
            self.callDeco(self.isShow, self.selectButton)
        end
        self:Close()
    elseif name == "@_aorbtn_hongse" then
        self.selectButton[2].isShow = not self.selectButton[2].isShow
        _G.GameUtil.SetActiveByCondition(self.select_obj[2], self.selectButton[2].isShow)
    elseif name == "@_aorbtn_cheng" then
        self.selectButton[3].isShow = not self.selectButton[3].isShow
        _G.GameUtil.SetActiveByCondition(self.select_obj[3], self.selectButton[3].isShow)
    elseif name == "@_aorbtn_zi" then
        self.selectButton[4].isShow = not self.selectButton[4].isShow
        _G.GameUtil.SetActiveByCondition(self.select_obj[4], self.selectButton[4].isShow)
    elseif name == "@_aorbtn_jinse" then
        self.selectButton[1].isShow = not self.selectButton[1].isShow
        _G.GameUtil.SetActiveByCondition(self.select_obj[1], self.selectButton[1].isShow)
    elseif name == "@_aorbtn_lanse" then
        self.selectButton[5].isShow = not self.selectButton[5].isShow
        _G.GameUtil.SetActiveByCondition(self.select_obj[5], self.selectButton[5].isShow)
    end
end
function DecorationShaiXuan:UpdateButton()
    if _G.table.isEmptyOrNil(self.selectButton) then
        return
    end
    for i = 1, #self.selectButton do
        _G.GameUtil.SetActiveByCondition(self.select_obj[i], self.selectButton[i].isShow)
    end
end

return DecorationShaiXuan
