---计算目标等级经验
function DecorationTargetEnhanceView:CalTargetExp(targetLv)
    self.SelectList = {}
    local DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    local DB, DA
    table.sort(
        self.uidLis,
        function(b, a)
            if not b.isD or not a.isD then
                return false
            else
                DB = DList[b.id]
                DA = DList[a.id]
                if DB.Grade < DA.Grade then
                    return true
                elseif DB.Grade == DA.Grade and DB.streng < DA.streng then
                    return true
                end
            end
            return false
        end
    )
    local exp = 0
    local targetExp = self.data:CheckNextNeedExp(targetLv)
    local flag = false
    local data, eatExp, coin
    for i = 1, #self.uidLis do
        if not self.uidLis[i].isD then --材料
            data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Material, self.uidLis[i].id)
            --检测材料的数据
            if data and data.count > 0 then
                for j = 1, data.count do
                    exp = exp + self.UpMaterial[data.sid].exp
                    self.SelectList[data.sid] = j
                    if exp >= targetExp then
                        flag = true
                        break
                    end
                end
                if flag then
                    break
                end
            end
        else --饰品
            if self.SelectList[self.uidLis[i].id] == nil then
                eatExp, coin = self:CalcOfferExpByUid(self.uidLis[i].id, DList)
                --eatExp, coin = require("DecorationModel"):GetInstance():CalcOfferExpByUidsAndMaterials({self.uidLis[i].id})
                --exp = exp + DList[self.uidLis[i].id].cfg.decomposition
                exp = exp + eatExp
                self.SelectList[self.uidLis[i].id] = true
                if exp >= targetExp then
                    flag = true
                    break
                end
            end
        end
    end
    return flag, exp
end

---通过传入饰品uid组合material组返回升级提供经验(优化计算，大批量时用这个）
---@param dUids number 消耗饰品组
---@param mats number 消耗材料组
---@param dList table 刻魂列表（传入可避免重复从仓库获取）
---@return number,number 获得经验，消耗金币
function DecorationTargetEnhanceView:CalcOfferExpByUid(uid, dList)
    local exp, coin = 0, 0
    local dData, strength, strengthExp
    dData = dList[uid]
    if dData then
        strength = dData.streng
        strengthExp = 0
        if strength > 0 then
            for k, val in pairs(strengthCfg[strength].points_up) do
                if val[1] == dData.Grade then
                    strengthExp = val[2]
                    break
                end
            end
        end
        ---当前经验 * 百分比 + 基础经验
        exp = exp + dData.cfg.decomposition + floor((dData.exp + strengthExp) * percent + 0.5)
        coin = coin + dData.cfg.coin
    end
    return exp, coin
end

---计算能升到的最大等级
function DecorationTargetEnhanceView:GetCanMaxLv()
    local maxLv = self.data.cfg.strengthen_level
    local delta = maxLv - self.data.streng
    local flag, exp = self:CalTargetExp(delta)
    if flag then
        self.canMaxLv = maxLv
    else
        maxLv = self.data.streng
        for lv = 1, delta do
            if exp > self.data:CheckNextNeedExp(lv) then
                maxLv = self.data.streng + lv
            end
        end
        self.canMaxLv = maxLv
    end
end

---@private
function DecorationTargetEnhanceView:Enhance()
    if self.data:CheckLvIsMax() then
        _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        return
    end
    if self.lv > self.canMaxLv then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 202060100)
        return
    end
    self:CalTargetExp(self.lv - self.data.streng)
    self:Up()
end

---检测是否是材料
function DecorationTargetEnhanceView:CheckIsMaterial(sid)
    return self.UpMaterial[sid] ~= nil
end

---获取强化消耗的
function DecorationTargetEnhanceView:SelectMaterial()
    local dUids = {}
    local mats = {}
    for i, v in pairs(self.SelectList) do
        if v then
            if self:CheckIsMaterial(i) then
                mats[i] = v
            else
                table.insert(dUids, i)
            end
        end
    end
    return dUids, mats
end

---强化
function DecorationTargetEnhanceView:Up()
    local dUids, mats = self:SelectMaterial()
    local DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    local flag = false
    local gr = 1
    if _G.table.isEmptyOrNil(dUids) then
    else
        for i = 1, #dUids do
            local grade = DList[dUids[i]].cfg.grade
            if grade >= 6 then
                flag = true
                gr = grade
                break
            end
        end
    end
    ---检测消费的金币是否 足够
    --local coinData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.ResProp, _G.ResPropID.Coin)
    if flag then
        local str = ""
        if gr == 6 then
            str = _G.LangUtil.TryGetLangValue(9002020017)
        else
            str = _G.LangUtil.TryGetLangValue(9002020016)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(
            420302,
            nil,
            function()
                self:UpDecorationLevel(dUids, mats)
            end,
            nil,
            nil,
            nil,
            str
        )
    else
        self:UpDecorationLevel(dUids, mats)
    end
end

---增加饰品等级
function DecorationTargetEnhanceView:UpDecorationLevel(dUids, mats)
    self.oldData = _G.DeepCopy(self.data)
    require("DecorationModel"):GetInstance():DecorationUp(
        self.data,
        dUids,
        mats,
        function(_dUids, _mats)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DecorationUpView.Name,
                self.oldData,
                self.data,
                0,
                function()
                    require("DecorationModel"):GetInstance():ShowPowerAndUp(self.data)
                end
            )
            if self.data.streng >= self.data.cfg.strengthen_level then
                self:Close()
            else
                self:ConsumeUid()
                self:InitView()
            end
        end
    )
end

---@private
function DecorationTargetEnhanceView:ConsumeUid()
    local newUidLis = {}
    for i = 1, #self.uidLis do
        if not self.uidLis[i].isD then
            _G.table.insert(newUidLis, self.uidLis[i])
        elseif not self.SelectList[self.uidLis[i].id] then
            _G.table.insert(newUidLis, self.uidLis[i])
        end
    end
    self.uidLis = newUidLis
end

---@private
function DecorationTargetEnhanceView:OnClickLv(go, isOn, index)
    if self.lvItems[index].clickEnable then
        self.effect:SetParentE(self.lvItems[index].gameObject)
        self.effect:SetActiveE(1)
        self:SetLv(self.lvDic[index])
    elseif self.lvDic[index] > self.canMaxLv then
        _G.PopWindowManager:GetInstance():ShowAllTips(120123)
    end
end

---按钮点击事件在这里派发
function DecorationTargetEnhanceView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_closeView" then
        self:Close()
        if self.trainCall then
            self.trainCall({})
        end
    elseif name == "@_aorbtn_anyClose" then
        self:Close()
        if self.trainCall then
            self.trainCall({})
        end
    elseif name == "@_aorbtn_add" then
        self:AddLv(1)
    elseif name == "@_aorbtn_sub" then
        self:AddLv(-1)
    elseif name == "@_aorbtn_enhance" then
        --self:Enhance()
        self:Close()
        self:CalTargetExp(self.lv - self.data.streng)
        if self.trainCall then
            self.trainCall(self.SelectList)
        end
    end
end

