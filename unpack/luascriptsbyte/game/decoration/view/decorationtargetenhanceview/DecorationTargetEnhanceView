---界面的入口函数
---@param data DecorationData
function DecorationTargetEnhanceView:OnCreate(data, uidLis, call)
    self.data = data
    self.uidLis = uidLis
    self.trainCall = call
    self.lvCfg = _G.ConfigManager.discrete_cfg[102903][1]
    local maxLv = self.data.cfg.strengthen_level
    self.UpMaterial = {}
    for _, v in pairs(_G.ConfigManager.discrete_cfg[102902]) do
        self.UpMaterial[v[1]] = {exp = v[2], coin = v[3]}
    end
    self.lvDic = {}
    ---@type DecorationTargetEnhanceView._obj_fastLv_GoTable[]
    self.lvItems = {}
    local obj
    local index = 1
    for i, v in pairs(self.lvCfg) do
        if v <= maxLv then
            obj = _G.InstantiateObject(self.go_table.obj_fastLv, self.go_table.obj_lvButton)
            self.lvDic[index] = v
            self.lvItems[index] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickLv, index))
            self.lvItems[index].aortext_lv.text = "+" .. v
            self.lvItems[index].gameObject:SetActiveE(1)
            index = index + 1
        end
    end
    ---@type DecorationTargetEnhanceView._obj_decorationItem_GoTable
    self.decorationItem = _G.GetAutoGoTable(self.go_table.obj_decorationItem)
    self.decorationItem.aorimage_Color2.SpriteName = _G.ItemBaseIconName_Decoration[self.data.Grade]
    self.decorationItem.aorimage_Color.SpriteName = self.data:GetDecorationJiaoBiaoImage()
    local pos = iconPosition[self.data.cfg.parts]
    self.decorationItem.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    self.decorationItem.aorrawimage_Icon:LoadImage(self.data:GetIconPath())
    ---@type Params_ConsumeCompont
    self.resConsume =
        self:AddComponent(
        self.go_table.obj_consume,
        require("ConsumeCompont").New(
            self.go_table.obj_consume,
            {{_G.ResPropID.Coin, false, 0}},
            nil,
            nil,
            true,
            {showNow = true}
        )
    )
    self.sumCoinLis = {}
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DecorationTargetEnhanceView_xuanzhong,
        self.go_table.obj_panel,
        function(tran)
            if self:IsNil() then
                _G.DestroyObject(tran)
                return
            end
            --tran:SetActiveE(0)
            self.effect = tran
            --_G.DelayDo(0.01, function()
            local panel = self.go_table.obj_panel:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
            self:GetCanMaxLv()
            self:InitView()
            panel.alpha = 1
            --end)
        end
    )
end

---@private
function DecorationTargetEnhanceView:InitView()
    self.decorationItem.aortext_Lv.text = self.data.streng > 0 and "+" .. self.data.streng or ""
    self:SetLv(self.data.streng + 1)
    for i = 1, #self.lvItems do
        if self.lvDic[i] < self.lv then
            self:SetGrayOrBlue(self.lvItems[i], spriteType.gray)
        elseif self.lvDic[i] > self.canMaxLv then
            self:SetGrayOrBlue(self.lvItems[i], spriteType.gray)
        else
            self:SetGrayOrBlue(self.lvItems[i], spriteType.blue)
        end
    end
    self.effect:SetActiveE(0)
    self.go_table.aorbtn_enhance:SetGray(self.lv > self.canMaxLv)
    self.sumCoinLis = {}
    self.sumCoin = 0
end

---@param item DecorationTargetEnhanceView._obj_fastLv_GoTable
function DecorationTargetEnhanceView:SetGrayOrBlue(item, type)
    item.aorimage_bg.SpriteName = type[1]
    item.aortext_lv.color = _G.ColorTools.FormatColorByString(type[2])
    local outLine = item.aortext_lv:GetComponentE(_G.typeof(_G.CS.TextOutline))
    outLine.OutlineColor = _G.ColorTools.FormatColorByString(type[3])
    outLine:GetModifiedMaterial()
    item.clickEnable = type == spriteType.blue
end

---刷新等级文本
function DecorationTargetEnhanceView:UpdateNumText()
    self.go_table.aortext_num.text = "+" .. self.lv
end

---增减等级
function DecorationTargetEnhanceView:AddLv(num)
    self.effect:SetActiveE(0)
    self.lv = self.lv + num
    self:CheckLv()
    self.go_table.aorbtn_enhance:SetGray(self.lv > self.canMaxLv)
end

---设置等级
function DecorationTargetEnhanceView:SetLv(num)
    self.lv = num
    self:CheckLv()
    self.go_table.aorbtn_enhance:SetGray(self.lv > self.canMaxLv)
end

