    if self.lv > self.data.cfg.strengthen_level then
        self.lv = self.data.cfg.strengthen_level
    end
    self:UpdateNumText()
    if self.sumCoinLis[self.lv] then
        self.sumCoin = self.sumCoinLis[self.lv]
