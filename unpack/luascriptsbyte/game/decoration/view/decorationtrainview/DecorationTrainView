---点击饰品强化材料
---@param data DecorationData 饰品数据类
function DecorationTrainView:OnClickMaterial(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_Sub" then
        if self.SelectList[data.sid] then
            self.SelectList[data.sid] = self.SelectList[data.sid] - 1
        end
    elseif name == "@_aorbtn_Click" then
        ---满级检测是否已满级
        if self.data:CheckLvIsMax() then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
            return
        end
        if self.data:CheckUpLvIsMax(self.up_Leve) then
            _G.PopWindowManager:GetInstance():ShowAllTips(120113)
            return
        end
        if not self.SelectList[data.sid] then
            self.SelectList[data.sid] = 0
        end
        self.SelectList[data.sid] = self.SelectList[data.sid] + 1
        local count = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Material, data.sid)
        if self.SelectList[data.sid] > count then
            self.SelectList[data.sid] = self.SelectList[data.sid] - 1
            return
        end
    end
    self:InitView()
    self:UpdateQianghuaOrXuanZhe()
    --self:ExpLineEffect()
end

---该饰品或材料道具是否被选中
---@param uid number 饰品uid或者道具sid
function DecorationTrainView:CheckIsSelected(uid)
    for i, v in pairs(self.SelectList) do
        if i == uid then
            return v
        end
    end
    if self:CheckIsMaterial(uid) then
        return 0
    else
        return false
    end
end

