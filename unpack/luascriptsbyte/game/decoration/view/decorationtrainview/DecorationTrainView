---一键选择(ZHJ-27564 更改为目标强化TargetEnhance，此方法暂不使用）
function DecorationTrainView:AllSelect()
    ---满级检测是否已满级
    if self.data:CheckLvIsMax() then
        _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        return
    end
    ---选中物品检测是否已满级
    if self.data:CheckUpLvIsMax(self.up_Leve) then
        _G.PopWindowManager:GetInstance():ShowAllTips(120113)
        return
    end
    ---检测下金币
    if _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Coin, self.sumCoin) == false then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Coin)
        return
    end
    local DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    local DB, DA
    table.sort(
        self.DecorationUids,
        function(b, a)
            if not b.isD or not a.isD then
                return false
            else
                DB = DList[b.id]
                DA = DList[a.id]
                if DB.Grade < DA.Grade then
                    return true
                elseif DB.Grade == DA.Grade and DB.streng < DA.streng then
                    return true
                end
            end
            return false
        end
    )
    --self.SelectList = {}
    --计算当前已经选中的经验值
    local dUis, mats = self:SelectMaterial()
    local exp_old, coin = require("DecorationModel"):GetInstance():CalcOfferExpByUidsAndMaterials(dUis, mats)
    local exp = 0
    for i = 1, #self.DecorationUids do
        if not self.DecorationUids[i].isD then --材料
            local data =
                _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Material, self.DecorationUids[i].id)
            local count = 0
            ---是否选择了材料
            if self.SelectList[data.sid] then
                count = self.SelectList[data.sid]
            end
            --检测材料的数据
            local remain_count = data.count - count
            if remain_count > 0 then
                local flag = false
                for i = 1, remain_count do
                    exp = exp + self.UpMaterial[data.sid].exp
                    count = count + 1
                    self.SelectList[data.sid] = count
                    if self.up_Leve == 0 then
                        if exp >= (self.data:CheckNextNeedExp(1) - exp_old) then
                            self.up_Leve = self.up_Leve + 1
                            flag = true
                            break
                        end
                    else
                        if exp >= (self.data:CheckNextNeedExp(self.up_Leve + 1) - exp_old) then
                            self.up_Leve = self.up_Leve + 1
                            flag = true
                            break
                        end
                    end
                end
                if flag then
                    break
                end
            end
        else --饰品
            if self.SelectList[self.DecorationUids[i].id] then
            else
                exp = exp + DList[self.DecorationUids[i].id].cfg.decomposition
                self.SelectList[self.DecorationUids[i].id] = true
                if self.up_Leve == 0 then
                    if exp >= (self.data:CheckNextNeedExp(1) - exp_old) then
                        self.up_Leve = self.up_Leve + 1
                        break
                    end
                else
                    if exp >= (self.data:CheckNextNeedExp(self.up_Leve + 1) - exp_old) then
                        self.up_Leve = self.up_Leve + 1
                        break
                    end
                end
            end
        end
        -- if exp >= self.data:CheckNextNeedExp(self.up_Leve) then
        --     self.up_Leve = self.up_Leve + 1
        --     break
        -- end
    end
    if _G.table.isEmptyOrNil(self.SelectList) then
        return
    end
    self:UpdateQianghuaOrXuanZhe()
    self:InitView()
    --self:ExpLineEffect()
end
---强化
function DecorationTrainView:Up()
    local dUids, mats = self:SelectMaterial()
    local DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    local flag = false
    local gr = 1
    if _G.table.isEmptyOrNil(dUids) then
    else
        for i = 1, #dUids do
            local grade = DList[dUids[i]].cfg.grade
            if grade >= 6 then
                flag = true
                gr = grade
                break
            end
        end
    end
    ---检测消费的金币是否 足够
    --local coinData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.ResProp, _G.ResPropID.Coin)
    if flag then
        local str = ""
        if gr == 6 then
            str = _G.LangUtil.TryGetLangValue(9002020017)
        else
            str = _G.LangUtil.TryGetLangValue(9002020016)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(
            420302,
            nil,
            function()
                self:UpDecorationLevel(dUids, mats)
            end,
            nil,
            nil,
            nil,
            str
        )
    else
        self:UpDecorationLevel(dUids, mats)
    end
end
---增加饰品等级
function DecorationTrainView:UpDecorationLevel(dUids, mats)
    self.oldData = _G.DeepCopy(self.data)
    require("DecorationModel"):GetInstance():DecorationUp(
        self.data,
        dUids,
        mats,
        function(dUids, mats)
            self:PlayUpLevelEffect(
                function()
                    if self.isShowNexAttr then
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.DecorationUpView.Name,
                            self.oldData,
                            self.data,
                            0,
                            function()
                                require("DecorationModel"):GetInstance():ShowPowerAndUp(self.data)
                            end
                        )
                    end
                    self:UpSc(dUids, mats)
                end
            )
            -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_AllSelect, true)
            -- _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Done, false)
        end
    )
end
---播放升级特效
function DecorationTrainView:PlayUpLevelEffect(call)
    if _G.table.isEmptyOrNil(self.changeList) then
        call()
        return
    end
    local UIUtils = _G.UIUtils
    local sao = _G.ConfigManager.ui_effect_cfg.ef_DecorationTrainView_tiaomu
    local bao = _G.ConfigManager.ui_effect_cfg.ef_DecorationTrainView_gaoliang
    local isOver = false
    for _, v in pairs(self.changeList) do
        UIUtils.LoadEffectByCfg(
            sao,
            v[1],
            function(trans)
                trans:SetLocalScaleXYZ(0.8)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
            end,
            function()
                if v[2] then
                    UIUtils.LoadEffectByCfg(
                        bao,
                        v[2],
                        function(trans)
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                                return
                            end
                            -- local x = v[3]:GetRectTransformSize()
                            trans:SetAnchorPosition(0, 0)
                        end,
                        function()
                            if v[3] then
                                UIUtils.LoadEffectByCfg(
                                    bao,
                                    v[3],
                                    function(trans)
                                        if self:IsNil() then
                                            _G.DestroyObject(trans)
                                            return
                                        end
                                        -- local x = v[3]:GetRectTransformSize()
                                        trans:SetAnchorPosition(0, 0)
                                    end,
                                    function()
                                        if not isOver then
                                            isOver = true
                                            if call then
                                                call()
                                            end
                                            return
                                        end
                                    end
                                )
                            end
                        end
                    )
                else
                    self:UpdateRandom()
                end
            end
        )
    end
end

