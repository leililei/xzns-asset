    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_MainPorp:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
    )
    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        self.go_table.obj_RandomProp:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
    )
