---界面的入口函数
---@param isRoandom boolean 是否显示预览(随机属性 值 区间)
---@param grade  table  筛选界面 选择的品质
---@param selectButton table 筛选界面 选择的按钮
function DecorationTrainView:OnCreate(data, call, dataList)
    self.grade = false
    self.selectButton = {}
    if not data then
        self:Close()
        return
    end
    self.data = data
    self.call = call
    self.sortType = SortType.up
    self.UpMaterial = {}
    for _, v in pairs(_G.ConfigManager.discrete_cfg[102902]) do
        self.UpMaterial[v[1]] = {exp = v[2], coin = v[3]}
    end
    self.tianchongItem = {
        [1] = self.go_table.obj_tianchong1,
        [2] = self.go_table.obj_tianchong2,
        [3] = self.go_table.obj_tianchong3,
        [4] = self.go_table.obj_tianchong4
    }
    self.isRoandom = false
    self.SelectList = {}
    self.lv = self.data.streng
    self.sumCoin = 0
    if self.go_table.ResConsume == nil then
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        self.go_table.ResConsume =
            self:AddComponent(
            self.go_table.obj_consume,
            require("ConsumeCompont").New(
                self.go_table.obj_consume,
                {{_G.ResPropID.Coin, false, 0}},
                nil,
                nil,
                true,
                data
            )
        )
    end
    self.randomObjProp = {}
    self.up_Leve = 0
    self:InitDecorationList(dataList)
    self:InitView()
    --self.expSl = self.go_table.obj_ExpSlider:GetComponentE(_G.typeof(_G.CS.AorImage))
    --self.expImage = self.go_table.obj_ExpImage:GetComponentE(_G.typeof(_G.CS.AorImage))
    ---按下多久 触发长按
    self.DownClickLimit = 3
    ---按下多久 触发一次 事件
    self.DownTimeClickTimeLimit = 0.5
    ---隐藏 消耗金币使用(选择材料，等级已满)
    self.isDone = false
end

---刷新显示
function DecorationTrainView:UpdataRes()
    if self.go_table.ResConsume ~= nil then
        self.go_table.ResConsume:RestRs({{_G.ResPropID.Coin, false, self.sumCoin}})
    end
end
---初始化界面
function DecorationTrainView:InitView()
    local dUis, mats = self:SelectMaterial()
    local exp, coin = require("DecorationModel"):GetInstance():CalcOfferExpByUidsAndMaterials(dUis, mats)
    self.sumCoin = coin
    self:UpdataRes()

    self.lv = require("DecorationModel"):GetInstance():CalcLv(self.data:GetCurExp() + exp, self.data.Grade)
    self.go_table.aorimage_Color.SpriteName = self.data:GetDecorationJiaoBiaoImage()
    local pos = iconPostion[self.data.cfg.parts]
    self.go_table.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    self.go_table.aorrawimage_Icon:LoadImage(self.data:GetIconPath())
    self.go_table.aortext_name.text = self.data:GetName()
    self.go_table.aortext_Lv.text = _G.LangUtil.GetLangPackValue(90020300005) .. ":"
    self.go_table.aortext_LvAfter.text = _G.LangUtil.GetLangPackValue(90020600039, self.data.streng)

    local limit1 = require("DecorationModel"):GetInstance():GetUpLevelLimit(self.data.streng, self.data.Grade)
    local limit2 = 0
    self.isShowNexAttr = false
    self.up_Leve = self.lv - self.data.streng
    if self.lv - self.data.streng == 0 then
        self.isShowNexAttr = false
        limit2 = require("DecorationModel"):GetInstance():GetUpLevelLimit(self.data.streng + 1, self.data.Grade)
    else
        if self.lv >= self.data.cfg.strengthen_level then
            self.lv = self.data.cfg.strengthen_level
            limit2 = require("DecorationModel"):GetInstance():GetUpLevelLimit(self.lv, self.data.Grade)
        else
            limit2 = require("DecorationModel"):GetInstance():GetUpLevelLimit(self.lv + 1, self.data.Grade)
        end

        limit1 = require("DecorationModel"):GetInstance():GetUpLevelLimit(self.lv, self.data.Grade)
        self.go_table.aortext_LvAfter.text = _G.LangUtil.GetLangPackValue(90020600039, self.lv)
        self.isShowNexAttr = true
    end
    --满级
    -- local AmountNumber = (self.data:GetCurExp() + exp - limit1) / limit2
    local AmountNumber = (self.data:GetCurExp() + exp) / limit2
    local str = self.data:GetCurExp() + exp .. "/" .. limit2
    local flagLvMax = false
    if self.data:CheckUpLvIsMax(self.up_Leve) then
        AmountNumber = 1
        str = limit2 .. "/" .. limit2
        flagLvMax = true
    --_G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_AllSelect, false)
    end
    self:ShowDecorationList()
    self:ShowProp(self.lv, self.isShowNexAttr)
    --self:UpdateSelectItem()
    if not flagLvMax then
        self.go_table.aortext_LimitLevel.text = str
    else
        self.go_table.aortext_LimitLevel.text = ""
    end
    self.go_table.aorimage_maxLevel:SetActiveE(flagLvMax and 1 or 0)
    self.go_table.aorimage_ExpImage.fillAmount = AmountNumber
    if self.data:CheckLvIsMax() then
        self.go_table.obj_consume:SetActiveE(0)
    else
        self.go_table.obj_consume:SetActiveE(1)
    end
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_consume, not flagLvMax)
    --self:UpdateQianghuaOrXuanZhe()
end
---显示属性
function DecorationTrainView:ShowProp(lv, isShow)
    self.changeList = {}
    local tran = (self.go_table.obj_MainPorp)
    local childCount = tran:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(tran:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local attr = self.data:GetBaseProp()
    local cfgA = self.data:GetLvCfg()
    local cfgB = self.data:GetLvCfg(lv - self.data.streng)

    local itemCount = 0
    local itemSucCount = 0
    for i, v in pairs(attr.attriOther) do
        if v > 0 then
            itemCount = itemCount + 1
            _G.PoolsManager:GetInstance():Spawn(
                UpPropItem,
                _G.ePoolType.UIItem,
                tran,
                function(trans)
                    itemSucCount = itemSucCount + 1
                    if trans then
                        local tb = _G.GetAutoGoTable(trans)
                        local res = _G.AttrType[i].icon
                        --tb.aorrawimage_icon:LoadImage(_G.AttrType[i].icon)
                        tb.aortext_Name.text = _G.AttrType[i].des
                        local pacent = cfgA and cfgA.att_growth or 10000
                        tb.aortext_AfterNum.text = _G.math.floor(v * pacent * 0.0001 + 0.5)
                        if isShow == true then
                            _G.table.insert(self.changeList, {trans, tb.aortext_AfterNum, tb.aortext_BeforeNum})
                            _G.GameUtil.SetActiveByCondition(tb.obj_BG2, true)
                            _G.GameUtil.SetActiveByCondition((tb.aortext_BeforeNum), true)
                            if cfgB then
                                --tb.aortext_BeforeNum.text = "<color=#018e43>" .. _G.math.floor(v) .. "</color>"
                                tb.aortext_BeforeNum.text = "+" .. _G.math.floor(v * cfgB.att_growth * 0.0001 + 0.5)
                                _G.GameUtil.SetActiveByCondition(tb.obj_BG2, true)
                                _G.GameUtil.SetActiveByCondition((tb.aortext_BeforeNum), true)
                            else
                                --tb.aortext_BeforeNum.text =
                                --"<color=#7b5252>" .. _G.math.floor(v * pacent * 0.0001 + 0.5) .. "</color>"
                                _G.GameUtil.SetActiveByCondition(tb.obj_BG2, false)
                                _G.GameUtil.SetActiveByCondition((tb.aortext_BeforeNum), false)
                            end
                        else
                            _G.GameUtil.SetActiveByCondition(tb.obj_BG2, false)
                            _G.GameUtil.SetActiveByCondition((tb.aortext_BeforeNum), false)
                        end
                    end
                    if itemSucCount == itemCount then
                        self:UpdateRectHeight()
                    end
                end
            )
        end
    end
    -- self.randomList = {}
    self:UpdateRandom(itemCount, itemSucCount)
end

function DecorationTrainView:UpdateRandom(itemCount, itemSucCount)
    local tran = (self.go_table.obj_RandomProp)
    local childCount = tran:GetChildCountE()
    if childCount > 0 then
        for i = 1, childCount do
            _G.PoolsManager:GetInstance():Despawn(tran:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    local count = 0
    local attr = self.data:GetProp()
    local dCfg = _G.ConfigManager.discrete_cfg[102903][1]
    local suiAttributeArray = self.data:AddAttributeToArray()
    for i = 1, #suiAttributeArray do
        local value = suiAttributeArray[i].value
        if value > 0 then
            -- if suiAttributeArray[i].value_type == 1 then
            -- else
            --     --value = Mathf.RoundToInt(value * 100)
            -- end
            value = value * 0.01
            value = string.format("%.1f", value)
            if itemCount then
                itemCount = itemCount + 1
            end
            _G.PoolsManager:GetInstance():Spawn(
                UpPropItem,
                _G.ePoolType.UIItem,
                tran,
                function(trans)
                    if itemSucCount then
                        itemSucCount = itemSucCount + 1
                    end

                    if trans then
                        count = count + 1
                        local tb = _G.GetAutoGoTable(trans)
                        local str = ""
                        local gradename =
                            self.data:GetDeco_add_cfgAttributeGrade(
                            suiAttributeArray[i].deco_att_id,
                            suiAttributeArray[i].deco_att_value
                        )
                        tb.aortext_Name.text = _G.AttrType[suiAttributeArray[i].key].des
                        --and count == index
                        tb.aorimage_sprite:SetActiveE(0)
                        if self.isRoandom then
                            if self.lv >= dCfg[count] then
                                if count <= self.data:GetPropUnlockCount() then
                                    tb.aorimage_sprite:SetActiveE(1)
                                    tb.aorimage_sprite.SpriteName = gradename
                                    str = "<color=#018e43>" .. value .. "%</color>"
                                    tb.aortext_BeforeNum.text = str
                                else
                                    --随机属性 预览 区间 强化属性条展示
                                    local index = self.data:GetPropUnlockCount()
                                    local maxIndex = self.data:GetPropPreviewCount(lv)
                                    if index == maxIndex then
                                        index = maxIndex
                                    else
                                        index = count
                                    end
                                    --local des = self.data:GetTxtArea(index)
                                    local des = _G.GetLangPackValue(90023400064)
                                    str = "<color=#3d57aa>" .. des .. "</color>"
                                    tb.aortext_BeforeNum.text = str
                                    _G.table.insert(self.changeList, {trans})
                                end
                            else
                                tb.aorimage_sprite:SetActiveE(0)
                                str =
                                    "<color=#6d6d6d>" ..
                                    string.format(_G.LangUtil.GetLangPackValue(90022300026), dCfg[count]) .. "</color>"
                                tb.aortext_BeforeNum.text = str
                            end
                        else
                            if count <= self.data:GetPropUnlockCount() then
                                tb.aorimage_sprite:SetActiveE(1)
                                tb.aorimage_sprite.SpriteName = gradename
                                str = "<color=#018e43>" .. value .. "%</color>"
                                tb.aortext_BeforeNum.text = str
                            else
                                tb.aorimage_sprite:SetActiveE(0)
                                str =
                                    "<color=#6d6d6d>" ..
                                    string.format(_G.LangUtil.GetLangPackValue(90022300026), dCfg[count]) .. "</color>"
                                tb.aortext_BeforeNum.text = str
                            end
                        end

                        _G.GameUtil.SetActiveByCondition(tb.obj_BG2, false)
                        _G.GameUtil.SetActiveByCondition((tb.aortext_AfterNum), false)
                    end
                    if itemCount then
                        if itemSucCount == itemCount then
                            self:UpdateRectHeight()
                        end
                    end
                end
            )
        end
    end
    if #suiAttributeArray > 2 then
        self.go_table.aorimage_bg2:SetActiveE(1)
    else
        self.go_table.aorimage_bg2:SetActiveE(0)
    end
end

