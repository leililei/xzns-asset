function DecorationTrainView:UpSc(dUids, mats)
    self.up_Leve = 0
    self.sumCoin = 0
    if dUids then
        for i, v in pairs(dUids) do
            self.SelectList[v] = nil
        end
    end
    if mats then
        for i, v in pairs(mats) do
            self.SelectList[i] = 0
        end
    end
    self:InitView()
    self:UpLevelEffect()
end

---获取强化消耗的
function DecorationTrainView:SelectMaterial()
    local dUids = {}
    local mats = {}

    for i, v in pairs(self.SelectList) do
        if v then
            if self:CheckIsMaterial(i) then
                mats[i] = v
            else
                table.insert(dUids, i)
            end
        end
    end
    return dUids, mats
end

---检测是否是材料
function DecorationTrainView:CheckIsMaterial(sid)
    return self.UpMaterial[sid] ~= nil
end

---初始化刻魂列表
function DecorationTrainView:InitDecorationList(decorationBar)
    self.decorations = {}
    if decorationBar == nil then
        _G.table.insert(self.decorations, self.data)
    else
        for i, v in pairs(decorationBar) do
            if not _G.table.isEmptyOrNil(v) then
                _G.table.insert(self.decorations, v)
                if v == self.data then
                    self.curIndex = #self.decorations
                end
            end
        end
    end
    self.go_table.obj_switch:SetActiveE((#self.decorations > 1 and self.curIndex ~= nil) and 1 or 0)
end

function DecorationTrainView:SwitchDecoration(delta)
    self.curIndex = (self.curIndex + delta) % #self.decorations
    if self.curIndex == 0 then
        self.curIndex = #self.decorations
    end
    self.data = self.decorations[self.curIndex]
    self:InitView()
end

function DecorationTrainView:OnClickShuaiXuan()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DecorationShaiXuan.Name,
        function(isShow, selectButton)
            self.grade = isShow
            self.selectButton = selectButton
            self:InitView()

            local cacheKey = tostring(_G.PlayerModel:GetInstance().role_uid) .. "DecorationTrain_SelectButton"
            _G.PlayerPrefsManager.SetTable(cacheKey, selectButton)
        end,
        self:GetSelectButtonData()
    )
end

function DecorationTrainView:GetSelectButtonData()
    if not _G.table.isEmptyOrNil(self.selectButton) then
        return self.selectButton
    end

    local cacheKey = tostring(_G.PlayerModel:GetInstance().role_uid) .. "DecorationTrain_SelectButton"
    local selectButtonData =_G.PlayerPrefsManager.GetTable(cacheKey, selectButton)
    return selectButtonData or {}
end

---按钮点击事件在这里派发
function DecorationTrainView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView_1" then
        if self.call then
            self.call()
        end
        self:Close()
    elseif name == "@_aorbtn_Up" then
        --self:SetSort()
    elseif name == "@_aorbtn_AllSelect" then
        self.isRoandom = true
        --self:AllSelect()
        self:TargetEnhance()
    elseif name == "@_aorbtn_shaixuan" then
        self:OnClickShuaiXuan()
    elseif go == self.go_table.aorbtn_preE then
        self:SwitchDecoration(-1)
    elseif go == self.go_table.aorbtn_nextE then
        self:SwitchDecoration(1)
    elseif name == "@_aorbtn_Done" then
        -- if self.data:CheckUpLvIsMax(self.up_Leve) then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(420102)
        --     return
        -- end
        ---满级检测是否已满级
        if self.data:CheckLvIsMax() then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
            return
        end
        if _G.StorageManager:GetInstance():CheckItem(_G.ResPropID.Coin, self.sumCoin) == false then
            if not _G.StorageManager:GetInstance():FastCheckItem(_G.ResPropID.Coin) then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Coin)
            end
            return
        end
        if self.sumCoin == 0 then
            --未选择强化材料
            _G.PopWindowManager:GetInstance():ShowAllTips(120118)
            return
        end
        self.isRoandom = false
        self.isDone = true
        self:Up()
    end
end

return DecorationTrainView
