---显示饰品列表
function DecorationTrainView:ShowDecorationList()
    self.DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    self.DecorationUids = {}
    local isSelect = false
    for s = 1, #self.selectButton do
        if self.selectButton[s].isShow then
            isSelect = true
            break
        end
    end
    if not isSelect then
        for i, v in pairs(self.UpMaterial) do
            local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Material, i)
            if data ~= nil and data.count > 0 then
                table.insert(self.DecorationUids, {id = i, isD = false, isSelect = 0}) --isD 是否 是饰品
            end
        end
    end
    if self.DList then
        for i, v in pairs(self.DList) do
            if (not self.grade) and v.uid ~= self.data.uid and v.cardUid == 0 and v.isLock == false then
                table.insert(self.DecorationUids, {id = i, isD = true, isSelect = 0})
            else
                if v.uid ~= self.data.uid and v.cardUid == 0 and v.isLock == false then
                    for j = 1, #self.selectButton do
                        if self.selectButton[j].isShow and v.Grade == self.selectButton[j].grade then
                            table.insert(self.DecorationUids, {id = i, isD = true, isSelect = 0})
                            break
                        end
                    end
                end
            end
        end
    end
    if #self.DecorationUids > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothing, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_shaixuan, true)
    else
        if not self.grade then
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_shaixuan, false)
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_nothing, true)
    end
    local DB, DA = {}, {}
    ---选中的 饰品在前
    for key, value in pairs(self.SelectList) do
        for i = 1, #self.DecorationUids do
            if self.DecorationUids[i].isD and self.DecorationUids[i].id == key then
                if value then
                    self.DecorationUids[i].isSelect = 1
                else
                    self.DecorationUids[i].isSelect = 0
                end
                break
            end
        end
    end
    _G.SortList(
        self.DecorationUids,
        function(dec)
            local item = {}
            local selectID = 0
            if dec.isSelect == 0 then
                selectID = 9
            else
                selectID = 10
            end
            local isDecoration = 0
            if not dec.isD then
                local data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Material, dec.id)
                item.Grade = data.cfg.Quality
                item.streng = 0
                item.cfg = {}
                item.cfg.suit = 0
                item.cfg.id = 0
                item.uid = data.uid
                isDecoration = 2
            else
                item = self.DList[dec.id]
                isDecoration = 1
            end
            return isDecoration, selectID, item.streng, item.Grade, -item.cfg.suit, -item.cfg.id
        end
    )
    local amount = #self.DecorationUids
    if not self.IsFirstD then
        self.go_table.scrollloopvectical_DectorationItemList:InitItemData(
            amount,
            _G.handlerbind(self, self.RefreshDecorationList, self.DList)
        )
        self.IsFirstD = true
    else
        if not self.lastAmount or self.lastAmount ~= amount then
            self.go_table.scrollloopvectical_DectorationItemList:UpdateCount(amount)
        else
            self.go_table.scrollloopvectical_DectorationItemList:UpdateAllItem()
        end
    end
    self.lastAmount = amount
end
function DecorationTrainView:RefreshDecorationList(index, obj, Dlist)
    if index < 0 then
        return
    end
    local item = obj
    local x = index + 1
    item:SetName(x)
    local tb = obj
    local data = {}
    local tindex = index + 1
    if self.DecorationUids[tindex] and self.DecorationUids[tindex].isD then
        data = Dlist[self.DecorationUids[tindex].id]
        if data == nil then
            _G.GameUtil.SetActiveByCondition((tb), false)
        else
            _G.GameUtil.SetActiveByCondition((tb), true)
            tb = _G.GetAutoGoTable(tb, _G.handlerbind(self, self.OnClickDecorationItem, data))
            -- ---设置物品长安 事件
            tb.aorbtn_Click.LongPress = true
            tb.aorbtn_Click.onLongPress = _G.handlerbind(self, self.ChaKanTipes, data)
            local _, sid = _G.StorageManager:GetInstance():CheckSidType(data.sid)
            local pos = iconPostion2[data.cfg.parts]
            tb.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
            tb.aorimage_Color_kuang.SpriteName = _G.ItemBaseIconName_Decoration[data.Grade]
            if sid == _G.StorageID.Decoration then
                tb.aorrawimage_Icon:LoadImage(data.Icon)
                _G.GameUtil.SetActiveByCondition(tb.aorimage_Color, true)
                tb.aorimage_Color.SpriteName = data:GetDecorationJiaoBiaoImage()
            else
                tb.aorimage_Color.SpriteName = _G.EquipItemIconName[data.Grade]
                _G.GameUtil.SetActiveByCondition(tb.aorimage_ColorBG1, false)
                _G.GameUtil.SetActiveByCondition(tb.aorimage_Color, true)
            end
            _G.GameUtil.SetActiveByCondition(tb.aorrawimage_IconItem, not sid == _G.StorageID.Decoration)

            if data.streng > 0 then
                tb.aortext_Lv.text = "+" .. data.streng
            else
                tb.aortext_Lv.text = ""
            end

            if data.BindCardSid ~= 0 then
                _G.GameUtil.SetActiveByCondition(tb.obj_Card, true)
            else
                _G.GameUtil.SetActiveByCondition(tb.obj_Card, false)
            end
            if self:CheckIsSelected(data.uid) then
                _G.GameUtil.SetActiveByCondition(tb.obj_Equip, true)
            else
                _G.GameUtil.SetActiveByCondition(tb.obj_Equip, false)
            end
            _G.GameUtil.SetActiveByCondition(tb.obj_Material, false)
        end
    elseif self.DecorationUids[tindex] then
        data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Material, self.DecorationUids[tindex].id)

        if data == nil or data.count == 0 then
            _G.GameUtil.SetActiveByCondition(tb, false)
        else
            _G.GameUtil.SetActiveByCondition(tb, true)
            tb = _G.GetAutoGoTable(tb, _G.handlerbind(self, self.OnClickMaterial, data))
            tb.aorbtn_Click.LongPress=false
            _G.GameUtil.SetActiveByCondition(tb.aorrawimage_IconItem, true)
            _G.GameUtil.SetActiveByCondition(tb.aorimage_Color, false)
            _G.GameUtil.SetActiveByCondition(tb.aorimage_Color_kuang, true)
            tb.aorimage_Color_kuang.SpriteName = _G.ItemBaseIconName_Decoration[data.Grade]
            tb.aorrawimage_IconItem:LoadImage(data.Icon)
            tb.aortext_Lv.text = ""
            _G.GameUtil.SetActiveByCondition(tb.obj_Card, false)

            _G.GameUtil.SetActiveByCondition(tb.obj_Material, true)
            if self:CheckIsSelected(data.sid) ~= 0 then
                _G.GameUtil.SetActiveByCondition(tb.obj_Equip, true)
                _G.GameUtil.SetActiveByCondition((tb.aorbtn_Sub), true)
                tb.aortext_MaterialNum.text =
                    "<color=#f83645>" ..
                    self:CheckIsSelected(data.sid) ..
                        "</color>/" .. _G.UIUtils.NumberToUnitStr_CardFightNum(data.count, true)
            else
                _G.GameUtil.SetActiveByCondition((tb.aorbtn_Sub), false)
                _G.GameUtil.SetActiveByCondition(tb.obj_Equip, false)
                tb.aortext_MaterialNum.text =
                    self:CheckIsSelected(data.sid) .. "/" .. _G.UIUtils.NumberToUnitStr_CardFightNum(data.count, true)
            end
        end
    else
        _G.GameUtil.SetActiveByCondition((tb), false)
    end

    return item
end

