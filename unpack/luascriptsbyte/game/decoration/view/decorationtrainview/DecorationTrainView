function DecorationTrainView:ExpLineEffect()
    local trans_expline = self.expSl
    if trans_expline:GetActiveSelf() then
        if self.playAniUpLevel == nil then
            self.playAniUpLevel = trans_expline:DOFade(0.2, 0.7):SetLoops(-1, _G.CS.DG.Tweening.LoopType.Yoyo)
        end
    end
    --self:PauseEffect()
end
---暂停 特效
function DecorationTrainView:PauseEffect()
    local tranComp = self.expSl
    if self.playAniUpLevel ~= nil then
        if self.SelectList == nil then
            tranComp:DOPause()
        else
            for key, value in pairs(self.SelectList) do
                if value ~= false and value ~= 0 then
                    tranComp:DOPlay()
                    return
                end
            end
            tranComp:DOPause()
        end
    end
end
