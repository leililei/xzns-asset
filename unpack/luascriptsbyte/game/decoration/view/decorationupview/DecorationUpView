---按钮点击事件在这里派发
function DecorationUpView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_confirm" or name == "@_aorbtn_CloseView" then
        if self.newLoadCompleted then
            self:Close()
            if self.corDelay then
                _G.coroutine.stopwaiting(self.corDelay)
            end
            if self.callback then
                self.callback()
            end
        end
    end
end

return DecorationUpView
