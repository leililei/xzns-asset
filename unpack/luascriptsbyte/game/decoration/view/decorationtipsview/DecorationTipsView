---@class DecorationTipsView : UIBaseView	中文描述
---@field public go_table DecorationTipsView_GoTable GoTable
local DecorationTipsView = _G.BaseClass("DecorationTipsView", _G.UIBaseView)
--_G.DecorationTipsView = DecorationTipsView

local CS = _G.CS
local typeof = _G.typeof

---以下部分皆为obj_count显示相关所用数值
---默认宽度
local defalutWidth = 1280
---默认高度
local defalutHeight = 720
---默认缩放值
local defalutSmallScale = 0.75
---最大缩放值
local maxSetScale = 0.85
---默认Y轴偏移
local defalutMoveY = 70

function DecorationTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param datas table {Data = {},isSelf = false, btn = {left = {name = string ,onclickFunc = function },right = {name = string ,onclickFunc = function }}
function DecorationTipsView:OnCreate(datas, TipsItemType)
    local Itemlua = require("DecorationTipsItem")
    local Prefabs = "UI/DecorationView/DecorationTipsItem"
    if TipsItemType == 1 then
        Itemlua = require "EquipmentTipsItem"
        Prefabs = "UIH5/Equipment/EquipmentTipsItem"
    elseif TipsItemType == 2 then
        Itemlua = require "ArtifactTipsItem"
        Prefabs = "UIH5/Artifact/ArtifactDevelop/$_obj_ArtifactTipItem"
    elseif TipsItemType == 3 then
        Itemlua = require "SpiritualTipsItem"
        Prefabs = "UIH5/Spiritual/$_obj_SpiritualTipsItem"
    elseif TipsItemType == 4 then
        Itemlua = require "SpiritualEffectTipItem"
        Prefabs = "UIH5/Spiritual/$_obj_SpiritualEffectTipItem"
    elseif TipsItemType == 5 then
        Itemlua = require "ArtifactTipsItem"
        Prefabs = "UI/Artifact/ArtifactDevelop/$_obj_ArtifactTipWearItem"
    elseif TipsItemType == 6 then
        Itemlua = require "SpoilsTipsItem"
        Prefabs = "UIH5_xzns/Spoils/$_obj_SpoilsTipsItem"
    end
    if table.isEmptyOrNil(datas) then
        self:Close()
        return
    end
    self.Items = {}
    for _, v in pairs(datas) do
        _G.PoolsManager:GetInstance():Spawn(
            Prefabs,
            _G.ePoolType.UIItem,
            (self.go_table.obj_count),
            function(tran)
                local item = Itemlua.New()
                table.insert(self.Items, item)
                if TipsItemType == 2 then
                    item:SetData(v.data, v.isSelf, v.btn, tran, v.hideSP)
                elseif TipsItemType == 5 then
                    item:SetData(v.data, v.isSelf, v.btn, tran, v.hideSP)
                elseif TipsItemType == 6 then
                    item:SetData(v.data, v.btn, tran)
                else
                    item:SetData(v.data, v.isSelf, v.btn, tran)
                end
            end
        )
    end

    if TipsItemType == 5 then
        for _, v in pairs(datas) do
            if v.setSmallScale then
                local nowWidth = _G.AppSetting.SCREEN_WIDTH
                local nowHeight = _G.AppSetting.SCREEN_HEIGHT
                local nowScale = tonumber(string.format("%0.2f", nowWidth / nowHeight))
                local defalutScale = tonumber(string.format("%0.2f", defalutWidth / defalutHeight))
                if nowScale == defalutScale then
                    self.go_table.obj_count:SetLocalScale(defalutSmallScale, defalutSmallScale, defalutSmallScale)
                    self.go_table.obj_count:SetLocalPosition(0, defalutMoveY, 0)
                else
                    local xScale = tonumber(string.format("%0.2f", nowWidth / defalutWidth))
                    local newScale = xScale * defalutSmallScale
                    if newScale > 0.9 then
                        newScale = 0.9
                    end
                    self.go_table.obj_count:SetLocalScale(newScale, newScale, newScale)
                    self.go_table.obj_count:SetLocalPosition(0, 0.35 * defalutMoveY, 0)
                end
                return
            end
        end
    end
    self.go_table.obj_count:SetLocalScale(1, 1, 1)
    self.go_table.obj_count:SetLocalPosition(0, 0, 0)
end

---按钮点击事件在这里派发
function DecorationTipsView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    end
end

return DecorationTipsView
