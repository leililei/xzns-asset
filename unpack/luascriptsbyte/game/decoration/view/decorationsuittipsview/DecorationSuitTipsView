---@class DecorationSuitTipsView : UIBaseView	中文描述
---@field public go_table DecorationSuitTipsView_GoTable GoTable
local DecorationSuitTipsView = _G.BaseClass("DecorationSuitTipsView", _G.UIBaseView)
local CS = _G.CS
local typeof = _G.typeof

local iconPostion = {
    [1] = {x = -2, y = 1, z = 0},
    [2] = {x = -2, y = -1, z = 0},
    [3] = {x = 0.2, y = -1, z = 0},
    [4] = {x = 0.2, y = 1, z = 0}
}

local obj_tips_item_height = {
    [1] = 62.76,
    [2] = 100
}

function DecorationSuitTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.suitDes_objs = {
        self.go_table.obj_tips_item_1,
        self.go_table.obj_tips_item_2,
        self.go_table.obj_tips_item_3,
        self.go_table.obj_tips_item_4,
        self.go_table.obj_tips_item_5
    }
end

---界面的入口函数
---@param level number 等级 == (刻魂的品质 - 2)
---@param name  number 刻魂名字
function DecorationSuitTipsView:OnCreate(data)
    self.suitid = data.cfg.suit
    self.suit_level = data.Grade - 2
    self.name = data.cfg.name
    self.data = data
    self:InitSuitItem()
    self:InitView()
end

---按钮点击事件在这里派发
function DecorationSuitTipsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

function DecorationSuitTipsView:InitSuitItem()
    local cfg = _G.ConfigManager.decoration_suit_cfg
    local attCfg = _G.ConfigManager.attribute_cfg
    local tb = _G.GetAutoGoTable(self.go_table.obj_tips_item_1)
    local str = ""
    local cfg1 = cfg[self.suitid]
    local attid = require "DecorationModel":GetInstance():GetGradeToValue(self.data.Grade, cfg1.att_suit2)
    str = _G.LangUtil.TryGetLangValue(attCfg[attid].describe)
    str = "<color=#686989>" .. str .. "</color>"
    tb.aortext_desc.text = str
    self:UpdateLayout()
    local sizeDeltax2, sizey2 = tb.aortext_desc:GetRectTransformSizeDelta()
    sizey2 = math.ceil(sizey2)
    self.grid_group = self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    self.go_table.scrollloopvectical_desc:InitBaseData(-7, 13, 400, sizey2, 20, 10)
    --self.grid_group.enabled = true
end
--- Content Size Fitter组件 动态改变时，在下一帧 刷新，需要强制刷新一次
function DecorationSuitTipsView:UpdateLayout()
    local tb = self.go_table.obj_tips_item_1
    CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(
        tb:GetComponentE(typeof(_G.CS.UnityEngine.RectTransform))
    )
end
function DecorationSuitTipsView:InitView()
    local cfg = _G.ConfigManager.decoration_suit_cfg
    --名字
    self.go_table.aortext_decoName.text = _G.LangUtil.TryGetLangValue(self.name)
    local name = _G.LangUtil.TryGetLangValue(cfg[self.suitid].name)
    self.go_table.aortext_decorationType.text = _G.LangUtil.TryGetLangValue(90023400045, name)

    self.go_table.aorimage_Color2.SpriteName = _G.ItemBaseIconName_Decoration[self.data.Grade]
    self.go_table.aorimage_Color.SpriteName = self.data:GetDecorationJiaoBiaoImage()
    self.go_table.aorrawimage_Icon:LoadImage(self.data:GetIconPath())
    local pos = iconPostion[self.data.cfg.parts]
    self.go_table.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    if self.data.streng > 0 then
        self.go_table.aortext_Lv.text = "+" .. self.data.streng
    else
        self.go_table.aortext_Lv.text = ""
    end
    self.count = cfg[self.suitid].att_suit2
    self.go_table.scrollloopvectical_desc:InitItemData(#self.count, _G.handler(self, self.RefreshNode))
end
function DecorationSuitTipsView:RefreshNode(index, obj)
    if index < 0 then
        return
    end
    local cfg = _G.ConfigManager.decoration_suit_cfg
    local attCfg = _G.ConfigManager.attribute_cfg
    local tb = _G.GetAutoGoTable(obj)
    local level = ""
    local str = ""
    local cfg1 = cfg[self.suitid]
    local attid = require "DecorationModel":GetInstance():GetGradeToValue(self.data.Grade, cfg1.att_suit2)
    local i = index + 1
    str = _G.LangUtil.TryGetLangValue(attCfg[attid].describe)
    if self.suit_level == i then
        str = "<color=#d0d8ff>" .. str .. "</color>"
        --str = _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#686989>")
        level = "<color=#d0d8ff>" .. i .. _G.LangUtil.TryGetLangValue(9002070021) .. "</color>"
    else
        attid = cfg1.att_suit2[i][2]
        str = _G.LangUtil.TryGetLangValue(attCfg[attid].describe)
        str = _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#686989>")
        str = "<color=#686989>" .. str .. "</color>"
        level = "<color=#686989>" .. i .. _G.LangUtil.TryGetLangValue(9002070021) .. "</color>"
    end
    tb.aortext_level.text = level
    tb.aortext_desc.text = str
    if i == #self.count then
        self.grid_group.enabled = false
        self.grid_group.enabled = true
    end
    return obj
end

return DecorationSuitTipsView
