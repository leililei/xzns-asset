require "DecorationModel"

---@class DecorationTipsItem	中文描述
local DecorationTipsItem = _G.BaseClass("DecorationTipsItem")
local CS = _G.CS
local typeof = _G.typeof

local decorationTipsPropItem = "UI/DecorationView/DecorationTipsPropItem"

local iconPostion = {
    [1] = {x = -2, y = 1, z = 0},
    [2] = {x = -2, y = -1, z = 0},
    [3] = {x = 0.2, y = -1, z = 0},
    [4] = {x = 0.2, y = 1, z = 0}
}

local RomanNum = {
    [1] = "I",
    [2] = "II",
    [3] = "III",
    [4] = "IV",
    [5] = "V",
    [6] = "VI",
    [7] = "VII",
    [8] = "VIII",
}

local attrNameSort = {
    "max_hp",
    "def",
    "atk",
    "bre",
}

---类的构造函数
function DecorationTipsItem:__init()
end

---设置参数
---@param dData DecorationData 饰品数据类
---@param isSelf boolean 是否是当前穿戴(当此参数为true，则btn不生效，反之)
---@param btn table {left = {name = string ,onclickFunc = function },right = {name = string ,onclickFunc = function }}
---@param tran transform tran
function DecorationTipsItem:SetData(dData, isSelf, btn, tran)
    if not dData then
        return
    end
    self.data = dData
    self.isSelf = isSelf
    self.btn = btn
    self.transform = tran
    self.go_table = _G.GetAutoGoTable(tran, _G.handlerbind(self, self.OnClickBtn))
    self:InitView()
    self:UpdateLayout()
end
--- Content Size Fitter组件 动态改变时，在下一帧 刷新，需要强制刷新一次
function DecorationTipsItem:UpdateLayout()
    self.AllContentF = self.transform:GetComponentsInChildren(typeof(CS.UnityEngine.UI.ContentSizeFitter))
    self.AllRect = {}
    for i = 0, self.AllContentF.Length - 1 do
        local rect = self.AllContentF[i]:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        _G.table.insert(self.AllRect, rect)
    end
    for i = 1, #self.AllRect do
        CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.AllRect[i])
    end
end

function DecorationTipsItem:InitView()
    self.go_table.aorimage_Color2.SpriteName = _G.ItemBaseIconName_Decoration[self.data.Grade]
    self.go_table.aorimage_Color.SpriteName = self.data:GetDecorationJiaoBiaoImage()
    self.go_table.aortext_decorationType.text = self.data:GetTxtParts()
    local pos = iconPostion[self.data.cfg.parts]
    self.go_table.aorrawimage_Icon:SetLocalPosition(pos.x, pos.y, pos.z)
    self.go_table.aorrawimage_Icon:LoadImage(self.data:GetIconPath())
    self.go_table.aortext_name.text = self.data:GetName()
    if self.data.streng > 0 then
        self.go_table.aortext_Lv.text = "+" .. self.data.streng
    else
        self.go_table.aortext_Lv.text = ""
    end
    if self.data.BindCardSid ~= 0 then
        self.go_table.obj_Card:SetActiveE(1)
        local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.data.BindCardSid)
        self.go_table.aorrawimage_CardIcon:LoadImage(cardData.Icon)
    else
        self.go_table.obj_Card:SetActiveE(0)
    end

    if self.isSelf then
        self.go_table.obj_Self:SetActiveE(1)
        self.go_table.obj_Btn:SetActiveE(0)
    else
        self.go_table.obj_Self:SetActiveE(0)
        if self.btn == nil then
            self.go_table.obj_Btn:SetActiveE(0)
            self.go_table.obj_Skill:SetActiveE(0)
        else
            self.go_table.obj_Btn:SetActiveE(1)
            self.go_table.aortext_BtnLeftName.text = self.btn.left.name
            self.go_table.aortext_BtnRightName.text = self.btn.right.name
            local count = _G.table.count(self.btn)
            if count >= 3 then
                _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_replace, true)
                self.go_table.aortext_BtnReplaceName.text = self.btn.replace.name
            else
                _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_replace, false)
            end
        end
    end

    local prop = self.data:GetProp()
    local count = 1
    if self.data.streng > 0 then
        for _, i in pairs(attrNameSort) do
            local v = prop.attriOther[i]
            if v > 0 then
                local str = string.format("obj_BaseProp%d", count)
                if self.go_table[str] then
                    self.go_table[str]:SetActiveE(1)
                    v = Mathf.RoundToInt(v)
                    local tb = _G.GetAutoGoTable(self.go_table[str])
                    tb.aortext_Name.text = _G.AttrType[i].des
                    tb.aortext_Num.text = v
                    count = count + 1
                end
            end
        end
    else
        for _, i in pairs(attrNameSort) do
            local v = prop.attriOther[i]
            if v > 0 then
                local str = string.format("obj_BaseProp%d", count)
                if self.go_table[str] then
                    self.go_table[str]:SetActiveE(1)
                    v = Mathf.RoundToInt(v)
                    local tb = _G.GetAutoGoTable(self.go_table[str])
                    tb.aortext_Name.text = _G.AttrType[i].des
                    tb.aortext_Num.text = v
                    count = count + 1
                end
            end
        end
    end
    count = 1
    local index = 1
    local suiAttributeArray = self.data:AddAttributeToArray()
    for i = 1, #suiAttributeArray do
        local value = suiAttributeArray[i].value
        if value ~= 0 then
            -- if suiAttributeArray[i].value_type == 1 then
            -- else
            --     --value = Mathf.RoundToInt(value * 0.0001 * 100)
            -- end
            value = value * 0.01
            value = string.format("%.1f", value)
            _G.PoolsManager:GetInstance():Spawn(
                decorationTipsPropItem,
                _G.ePoolType.UIItem,
                (self.go_table.obj_basePropContent),
                function(tran)
                    if tran then
                        local tb = _G.GetAutoGoTable(tran)
                        if count <= self.data:GetPropUnlockCount() then
                            tb.aortext_des.text =
                                "<color=#d0d8ff>" .. _G.AttrType[suiAttributeArray[i].key].des .. "</color>"
                            tb.aortext_value.text = "<color=#95e7ff>" .. value .. "%" .. "</color>"
                            local gradename =
                                self.data:GetDeco_add_cfgAttributeGrade(
                                suiAttributeArray[i].deco_att_id,
                                suiAttributeArray[i].deco_att_value
                            )
                            tb.aorimage_grade.SpriteName = gradename
                            tb.aorimage_grade:SetActiveE(1)
                        else
                            tb.aorimage_grade:SetActiveE(0)
                            tb.aortext_des.text =
                                "<color=#686989>" .. _G.AttrType[suiAttributeArray[i].key].des .. "</color>"
                            local dCfg = _G.ConfigManager.discrete_cfg[102903][1]
                            tb.aortext_value.text =
                                string.format(_G.LangUtil.GetLangPackValue(90022300026), dCfg[index])
                        end
                        count = count + 1
                    end
                    index = index + 1
                    self:UpdateLayout()
                end
            )
        end
    end

    --套装 显示 图标 套装效果描述
    local cfg = _G.ConfigManager.decoration_suit_cfg[self.data.cfg.suit]
    local attCfg = _G.ConfigManager.attribute_cfg
    if cfg then
        self.go_table.aorrawimage_suiticon:LoadImage(self.data:GetIconPath())
        --4件套效果（读attribute_cfg表；按品质蓝#紫#橙#红#金依次激活对应等级技能）
        local attid = require "DecorationModel":GetInstance():GetGradeToValue(self.data.Grade, cfg.att_suit2)
        local des2 = attCfg[attid].describe
        des2 = _G.LangUtil.GetLangPackValue(des2)
        self.go_table.aortext_des.text = des2
        self.go_table.aortext_sign.text = RomanNum[self.data.Grade - 2]
    end
    local type = 1
    if self.data.isLock == false then
        type = 0
    else
        type = 1
    end
    self:SetLockImage(type)
end

function DecorationTipsItem:SetLockImage(type)
    if type == 0 then
        self.go_table.aorimage_icon_lock.SpriteName = "ui_ty_icon_suo7"
    else
        self.go_table.aorimage_icon_lock.SpriteName = "ui_ty_icon_suo3"
    end
end

function DecorationTipsItem:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_left" then
        self.btn.left.func()
    elseif name == "@_aorbtn_Right" then
        self.btn.right.func()
    elseif name == "@_aorbtn_replace" then
        self.btn.replace.func()
    elseif name == "@_aorbtn_suittips" then
        --
        if _G.AppSetting.DEBUG then
            _G.LogError("弹出饰品套装 tips 描述")
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationSuitTipsView.Name, self.data)
    elseif name == "@_aorbtn_Lock" then
        local type = 1
        if self.data.isLock == false then
            type = 1
        else
            type = 0
        end
        require("DecorationModel"):GetInstance():Lock(
            self.data.cardUid,
            self.data.uid,
            type,
            _G.handlerbind(self, self.SetLockImage, type)
        )
    end
end

---类的析构函数
function DecorationTipsItem:Dispose()
end

return DecorationTipsItem
