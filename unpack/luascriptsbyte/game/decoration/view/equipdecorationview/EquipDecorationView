    )
end
---按钮回调，卸下
function EquipDecorationView:Unfix(data)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
    require("DecorationModel"):GetInstance():SetDecoration(
        self.cardData.uid,
        {data.cfg.parts},
        {0},
        function()
            --local part_uid = self.cardData.uid * 10 + data.cfg.parts

            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.EngraveSoul.id
            )
            self:InitView()
            self:UpLevelEffect()
        end
    )
end
---穿戴，替换，卸下 特效
function EquipDecorationView:UpLevelEffect()
    local effect_UpLevel_Name = "ef_kehunReplace"
    local cfg = _G.ConfigManager.ui_effect_cfg[effect_UpLevel_Name]
    _G.UIUtils.LoadEffectByCfg(cfg, self.go_table.obj_effect_baoguang, nil, nil)
end
---属性详情
function EquipDecorationView:ArrtibuteXiangQing(data)
    --检测 是否有饰品
    if _G.table.isEmptyOrNil(self.attributeTable) then
        _G.PopWindowManager:GetInstance():ShowAllTips(420104)
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.KeHunTips.Name, data)
end

---按钮点击事件在这里派发
function EquipDecorationView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_shipin1" then
        self:OpenSelectDecorationView(_G.DecorationPart.aiglet)
    elseif name == "@_aorbtn_shipin2" then
        self:OpenSelectDecorationView(_G.DecorationPart.necklace)
    elseif name == "@_aorbtn_shipin3" then
        self:OpenSelectDecorationView(_G.DecorationPart.amulet)
    elseif name == "@_aorbtn_shipin4" then
        self:OpenSelectDecorationView(_G.DecorationPart.ring)
    elseif name == "@_aorbtn_enter" then
        self:OpenSelectDecorationViewOnClick()
    elseif name == "@_aorbtn_tips" then
        self:ArrtibuteXiangQing(self.cardData)
    end
end
---隐藏界面
function EquipDecorationView:HideOrShowGameObject(number)
    self.go_table.gameObject:SetActiveE(number)
end

return EquipDecorationView
