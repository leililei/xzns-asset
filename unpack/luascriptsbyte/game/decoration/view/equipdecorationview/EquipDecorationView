---设置红点 相同数据 sid 不同 param 展示界面位置
function EquipDecorationView:SetRedpointParam()
    local tran = self.go_table.trans_shipin
    local part_uid = self.cardData.uid * 10
    for key, value in pairs(_G.DecorationPart) do
        if value ~= 0 then
            local obj = tran:GetChildE(value - 1)
            obj:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.EngraveSoul.id, part_uid + value)
        end
    end
end
---初始化界面
function EquipDecorationView:InitView()
    local dData = self.cardData:GetDecorationByPart(_G.DecorationPart.ring)
    local part_uid = self.cardData.uid * 10
    if not table.isEmptyOrNil(dData) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin1, true)
        self:SetDecoration(dData, _G.DecorationPart.ring)
        _G.table.insert(self.attributeTable, dData)
        self:UpdateUpLevelHint(_G.DecorationPart.ring, dData, true)
    else
        self:UpdateUpLevelHint(_G.DecorationPart.ring, dData, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin1, false)
    end
    dData = self.cardData:GetDecorationByPart(_G.DecorationPart.amulet)
    if not table.isEmptyOrNil(dData) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin4, true)
        self:SetDecoration(dData, _G.DecorationPart.amulet)
        _G.table.insert(self.attributeTable, dData)
        self:UpdateUpLevelHint(_G.DecorationPart.amulet, dData, true)
    else
        self:UpdateUpLevelHint(_G.DecorationPart.amulet, dData, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin4, false)
    end
    dData = self.cardData:GetDecorationByPart(_G.DecorationPart.necklace)
    if not table.isEmptyOrNil(dData) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin2, true)
        self:SetDecoration(dData, _G.DecorationPart.necklace)
        _G.table.insert(self.attributeTable, dData)
        self:UpdateUpLevelHint(_G.DecorationPart.necklace, dData, true)
    else
        self:UpdateUpLevelHint(_G.DecorationPart.necklace, dData, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin2, false)
    end
    dData = self.cardData:GetDecorationByPart(_G.DecorationPart.aiglet)
    if not table.isEmptyOrNil(dData) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin3, true)
        self:SetDecoration(dData, _G.DecorationPart.aiglet)
        _G.table.insert(self.attributeTable, dData)
        self:UpdateUpLevelHint(_G.DecorationPart.aiglet, dData, true)
    else
        self:UpdateUpLevelHint(_G.DecorationPart.aiglet, dData, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_shipin3, false)
    end
    self:SetPropAndSuit()
end
---升级提示
function EquipDecorationView:UpdateUpLevelHint(part, data, isShow)
    local flag = false
    if isShow then
        flag = true
    end
    --查看仓库数据
    local decorations = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)

    if decorations then
        --检测 是不是最高品质
        if flag then
            for key, value in pairs(decorations) do
                if
                    value.uid ~= data.uid and value.cardUid == 0 and value.cfg.parts == part and
                        value.cfg.grade > data.cfg.grade
                 then
                    flag = false
                    break
                end
            end
        end
    else
        flag = false
    end
    if flag then
        flag = require("DecorationModel"):GetInstance():CheckUpLevelHint(data)
        _G.GameUtil.SetActiveByCondition(self.shengjitishi[part], flag)
    else
        _G.GameUtil.SetActiveByCondition(self.shengjitishi[part], false)
    end
end

---设置属性和套装
function EquipDecorationView:SetPropAndSuit()
    local trans = (self.go_table.obj_CardProp)
    local count = trans:GetChildCountE()
    if count ~= 0 then
        for i = 1, count do
            _G.PoolsManager:GetInstance():Despawn(trans:GetChildE(0), _G.ePoolType.UIItem)
        end
    end

    if self.cardData:GetDecorationCount() ~= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotProp, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotProp, true)
    end
    if not table.isEmptyOrNil(self.cardData:GetDecorationSuit()) then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSuit, false)
    else
        self.go_table.aortext_taozhuang.text = ""
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSuit, true)
    end

    self.Props = {}

    local attribute = self.cardData:GetDecorationProp()
    --饰品主属性
    if attribute.attriOther then
        for k, v in pairs(attribute.attriOther) do
            if v ~= 0 then
                _G.PoolsManager:GetInstance():Spawn(
                    DecorationPropItem,
                    _G.ePoolType.UIItem,
                    trans,
                    function(tran)
                        local tb = _G.GetAutoGoTable(tran)
                        --tb.aorrawimage_Icon:LoadImage(_G.AttrType[k].icon)
                        tb.aortext_name.text = _G.AttrType[k].des
                        tb.aortext_value.text = _G.GameUtil.NumberToUnitStr(_G.Mathf.RoundToInt(v))
                        self.Props[k] = tb
                    end
                )
            end
        end
    end

    local suit_tips = 0
    local suits = self.cardData:GetDecorationSuit()
    for i = 1, #suits do
        local suitcount = suits[i].count
        if suitcount < 4 then
            self.go_table.aortext_taozhuang.text = ""
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_NotSuit, true)
            return
        end
        for j = 1, suitcount do
            if j == 4 then
                suit_tips = 4
                local grade = self.cardData:GetDecorationLowerGarde()
                local des, lID, cfg, cfg1
                cfg1 = _G.ConfigManager.decoration_suit_cfg[suits[i].id]
                lID = require "DecorationModel":GetInstance():GetGradeToValue(grade, cfg1.att_suit2)
                cfg = _G.ConfigManager.attribute_cfg
                des = _G.LangUtil.GetLangPackValue(cfg[lID].describe)
                self.go_table.aortext_taozhuang.text = des
            -- _G.PoolsManager:GetInstance():Spawn(
            --     SuitDesNewItem,
            --     _G.ePoolType.UIItem,
            --     trans,
            --     function(tran)
            --         _G.GetAutoGoTable(tran)
            --         local tb = _G.GetAutoGoTable(tran)
            --         self.SuitItem[suits[i].id] = tb
            --         local des, lID, cfg
            --         if j == 4 then

            --         end
            --     end
            -- )
            end
        end
    end
end

---设置饰品
---@param dData DecorationData 饰品数据类
---@param part _G.DecorationPart 饰品位置枚举
function EquipDecorationView:SetDecoration(dData, part)
    if not dData or not part then
        return
    end
    self.DecorationItem[part].aorrawimage_Icon:LoadImage(dData.Icon)
    self.DecorationItem[part].aorimage_Color.SpriteName = dData:GetDecorationJiaoBiaoImage()

    if dData.streng > 0 then
        self.DecorationItem[part].aortext_Lv.text = "+" .. dData.streng
    else
        self.DecorationItem[part].aortext_Lv.text = ""
    end
end

---进入刻魂(饰品) 界面
function EquipDecorationView:OpenSelectDecorationViewOnClick()
    for i = 1, 4 do
        require "DecorationModel":GetInstance():UpdateFirstRedpoint(self.cardData, i)
    end
    self:HideOrShowGameObject(0)
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DecorationSelectView.Name)
    if window then
        window.View:ShowUI(
            self.cardData,
            function()
                self:HideOrShowGameObject(1)
                self:InitView()
            end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DecorationSelectView.Name,
            self.cardData,
            function()
                self:HideOrShowGameObject(1)
                self:InitView()
            end
        )
    end
end
---打开饰品选择界面
---@param part _G.DecorationPart 饰品位置枚举
function EquipDecorationView:OpenSelectDecorationView(part)
    if not part then
        return
    end
    --ZHJ-15397 【客户端】刻魂系统的红点添加 只检测首次(显示红点),其他不在显示红点
    --设置
    require "DecorationModel":GetInstance():UpdateFirstRedpoint(self.cardData, part)
    local DData = self.cardData:GetDecorationByPart(part)
    if table.isEmptyOrNil(DData) then
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DecorationSelectView.Name)
        if window then
            window.View:ShowUI(
                self.cardData,
                function()
                    self:HideOrShowGameObject(1)
                    self:InitView()
                end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DecorationSelectView.Name,
                self.cardData,
                function()
                    self:HideOrShowGameObject(1)
                    self:InitView()
                end
            )
        end
        self:HideOrShowGameObject(0)
    else
        local data2 = {}
        data2.data = DData
        data2.isSelf = false
        data2.btn = {}
        data2.btn.left = {}
        data2.btn.right = {}
        data2.btn.right.name = _G.LangUtil.GetLangPackValue(90023400005)
        data2.btn.right.func = _G.handlerbind(self, self.train, DData)
        data2.btn.left.name = _G.LangUtil.GetLangPackValue(90023400032)
        data2.btn.left.func = _G.handlerbind(self, self.Unfix, DData)
        data2.btn.replace = {}
        data2.btn.replace.name = _G.LangUtil.GetLangPackValue(90020400047)
        data2.btn.replace.func = _G.handlerbind(self, self.replace, DData)
        _G._G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name, {data2})
    end
end
function EquipDecorationView:replace(data)
    local part = data.cfg.parts
    local DList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    self.DecorationUids = {}
    for _, v in pairs(DList) do
        if part == v.cfg.parts and v.cardUid == 0 then
            table.insert(self.DecorationUids, v.uid)
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_effect_baoguang, false)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_DecorationPanel, false)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DecorationReplaceView.Name,
        self.cardData,
        DList,
        self.DecorationUids,
        function(data)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_effect_baoguang, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_DecorationPanel, true)
            if _G.table.isEmptyOrNil(data) then
                return
            end
            self:UpLevelEffect()
            self:InitView()
            --local part_uid = self.cardData.uid * 10
            --part_uid = part_uid + part
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                _G.ConfigManager.redpoint_cfg.EngraveSoul.id
            )
        end
    )
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DecorationTipsView.Name)
end
