require "BaseGameNet"
---@class DecorationNet : BaseGameNet	通信协议
local DecorationNet = _G.BaseClass("DecorationNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return DecorationNet DecorationNet
function DecorationNet:GetInstance()
    return self.super.super.GetInstance(self)
end

function DecorationNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.send_decoration_update.Cmd, self.P2CDecorationUpdate)
end

function DecorationNet:P2CDecorationUpdate(msg)
    require("DecorationModel"):GetInstance():P2CDecorationUpdate(msg)
end

---穿戴饰品请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function DecorationNet:SetDecorationAccess(pbdata, callback)
    local item = _G.ConfigManager.net_map.game_decoration_set_decoration
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

