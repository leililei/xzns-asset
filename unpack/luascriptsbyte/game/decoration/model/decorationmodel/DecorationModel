            require "CommonTipManager".OpenPowerUpView(power, _G.StorageManager:GetInstance():GetPlayerPower() - power)
        end
    end
end

---转换  根据出入的品质 获得对应的数据信息
---@param grade number 品质
---@param target table 需要转换的数据
function DecorationModel:GetGradeToValue(grade, target)
    if target == nil then
        return nil
    end
    local tmep = {}
    for i = 1, #target do
        local id = target[i][1]
        if tmep[id] == nil then
            tmep[id] = 0
        end
        tmep[id] = target[i][2]
    end
    if tmep[grade] then
        return tmep[grade]
    else
        return nil
    end
end

---获取套装数量
---@return number 数量
function DecorationModel:GetSuitCount(sid)
    local count = 0
    local dList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)

    for _, v in pairs(dList) do
        if v.cfg.suit == sid then
            count = count + 1
        end
    end
    return count
end

function DecorationModel:GetUpLevelLimit(lv, grade)
    local cfg = _G.ConfigManager.decoration_stren_cfg
    local limit = 0
    if lv == 0 then
        limit = 0
    elseif lv > 0 then
        if cfg[lv] then
            limit = self:GetGradeToValue(grade, cfg[lv].points_up)
        else
            limit = 0
        end
    end
    return limit
end

