---@class DecorationModel : GameDataModelBase
local DecorationModel = _G.BaseClass("DecorationModel", _G.GameDataModelBase)

function DecorationModel:__init()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    require("DecorationNet"):GetInstance():StartUp()
end

---被销毁时
function DecorationModel:Dispose()
    self.super:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

function DecorationModel:ResUpdata(data)
    if not self.materialId then
        ---强化材料每级都相同所以直接取一级的
        local cfg = _G.ConfigManager.decoration_stren_cfg[1]
        self.materialId = cfg.cost[1]
    end
    for _, value in pairs(data) do
        local sid = value.type[1]

        if sid == self.materialId then
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RuneStrength
                                                                              .id)
            return
        end
    end
end

