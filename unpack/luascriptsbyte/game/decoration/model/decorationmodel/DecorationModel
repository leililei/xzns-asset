---强化饰品返回
function DecorationModel:DecorationUpSuc(data, cardData, slot, cost, call)
    if data.ack ~= 1 then
        return
    end
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    for _, v in pairs(slot) do
        if not _G.table.isEmptyOrNil(cardData.DecorationBar[v.k]) then
            cardData.DecorationBar[v.k].slotLevel = v.v
        end
    end
    cardData:CalcNowSumProp(_G.AttrFunType.Decoration)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(cardData, true)
    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(power, offset)
    end

    for _, v in pairs(cost) do
        _G.StorageManager:GetInstance():ConsumeItem(v[1], v[1], v[2])
    end
    if call then
        call()
    end
end

