    local msg = { uid = cardData.uid, d_index = { { index = index, uid = 0 } } }
    require("DecorationNet"):GetInstance():SetDecorationAccess(
        msg,
        _G.handlerbind(self, self.TakeOffDecorationSuc, cardData, index, decorationData, call)
    )
end

--卸下符文回调
function DecorationModel:TakeOffDecorationSuc(msg, cardData, index, decorationData, call)
    if msg.ack ~= 1 then
        return
    end

    cardData.DecorationBar[index].decoration = nil
    if decorationData then
        decorationData:PutCard(0)
    end
    cardData:CalcNowSumProp(_G.AttrFunType.Decoration)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(cardData, true)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RuneStrength.id, cardData.uid)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DecorationSlot.id)
    if call then
        call()
    end
end

