---饰品锁操作
---@param decoData DecorationData 饰品
---@param type number 操作类型0：设置为空闲，1：设置为锁定
---@param call function 回调函数
function DecorationModel:Lock(cardData, decoData, type, call)
    cardData = cardData or {}
    local msg = {}
    msg.d_uid = decoData.uid
    msg.type = type
    require("DecorationNet"):GetInstance():LockAccess(
        msg,
        _G.handlerbind(self, self.LockSuc, cardData, decoData, type, call)
    )
end

---饰品锁操作成功
---@param data table 服务器返回消息
---@param cardData CardData 卡牌数据
---@param decoData DecorationData 饰品
---@param type number 操作类型0：设置为空闲，1：设置为锁定
---@param call function 回调函数
function DecorationModel:LockSuc(data, cardData, decoData, type, call)
    if data.ack ~= 1 then
        return
    end
    decoData.lock = type
    if not _G.table.isEmptyOrNil(cardData) then
        local decorationBar = cardData.DecorationBar[decoData.parts]
        if decorationBar and not _G.table.isEmptyOrNil(decorationBar.decoration) then
            decorationBar.decoration.lock = type
        end
    end
    if call then
        call()
    end
end

