---分解符文
function DecorationModel:Decompose(selectUid, uids, callback, isNoTip)
    require("DecorationNet"):GetInstance():Decompose(
        { uids = uids },
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            local StorageManager = _G.StorageManager:GetInstance()
            for uid, v in pairs(selectUid) do
                StorageManager:ConsumeItem(v.sid, uid, 1)
            end
            StorageManager:ReceiveAwardData(msg)
            if not isNoTip then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DecorationSlot.id)
            if callback then
                callback(msg)
            end
        end
    )
end

---穿戴/替换符文(单个)
---@param cardData CardData 卡牌数据类
---@param index number 穿戴部位
---@param decorationData DecorationData 符文数据类
function DecorationModel:PutOnDecoration(cardData, index, decorationData, call)
    if cardData == nil or cardData.uid == nil then
        _G.LogError("【容错】符文穿戴卡牌uid为空！")
        return 
    end
    if decorationData == nil or decorationData.uid == nil then
        _G.LogError("【容错】符文穿戴符文uid为空！")
        return 
    end
    local msg = { uid = cardData.uid, d_index = { { index = index, uid = decorationData.uid } } }
    require("DecorationNet"):GetInstance():SetDecorationAccess(
        msg,
        _G.handlerbind(self, self.PutOnDecorationSuc, cardData, index, decorationData, call)
    )
end

---穿戴/替换符文(多个)
---@param cardData CardData 卡牌数据类
---@param index number 穿戴部位
---@param decorationDatas DecorationData[] 符文数据类
function DecorationModel:PutOnDecorations(cardData, decorationDatas, call)
    if cardData == nil or cardData.uid == nil then
        _G.LogError("【容错】符文穿戴卡牌uid为空！")
        return
    end
    if decorationDatas == nil or decorationDatas[1] == nil or decorationDatas[1].uid == nil then
        _G.LogError("【容错】符文穿戴符文uid为空！")
        return
    end
    local count = #decorationDatas
    local msg = { uid = cardData.uid, d_index = {} }
    local indexs = {}
    for i = 1, count do
        local decorationData = decorationDatas[i]
        local index = decorationData.cfg.parts
        local msg_item = { index = index, uid = decorationData.uid }
        table.insert(msg.d_index, msg_item)
        table.insert(indexs, index)
    end
    require("DecorationNet"):GetInstance():SetDecorationAccess(
            msg,
            _G.handlerbind(self, self.PutOnDecorationSucs, cardData, indexs, decorationDatas, call)
    )
end

function DecorationModel:PutOnDecorationSucs(msg, cardData, indexs, decorationDatas, call)
    if msg.ack ~= 1 then
        return
    end

    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local count = #decorationDatas
    for i = 1, count do
        local decorationData = decorationDatas[i]
        self:PutOnDecorationSuc(msg, cardData, indexs[i], decorationData)
    end

    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 and call then
        call(power, offset)
    end

end

--穿戴/替换符文回调
function DecorationModel:PutOnDecorationSuc(msg, cardData, index, decorationData, call)
    if msg.ack ~= 1 then
        return
    end
    local decoData = cardData.DecorationBar[index]
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    if _G.table.isEmptyOrNil(decoData) or _G.table.isEmptyOrNil(decoData.decoration) then
        ---被替换的符文被其他卡牌穿戴，需要卸下穿戴的符文即可
        if decorationData.cardUid ~= 0 then
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, decorationData.cardUid)
            if card then
                decoData.decoration = nil
            end
        end
    else
        ---替换符文,先把身上穿戴的符文卸下来
        local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Decoration, decoData.decoration.uid)
        if data then
            data:PutCard(0)
        end
        if decorationData.cardUid ~= 0 then
            ---被替换的符文在其他卡牌身上需要卸下来
            if decorationData.cardUid ~= cardData.uid then
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, decorationData.cardUid)
                if card then
                    card.DecorationBar[index].decoration = nil
                end
            end
        end
    end

    decoData.decoration = decorationData or {}
    if not decoData.slotLevel then
        decoData.slotLevel = 0
        decoData.index = index
    end
    decorationData:PutCard(cardData.uid)

    cardData:CalcNowSumProp(_G.AttrFunType.Decoration)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(cardData, true)
    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    --if offset > 0 then
    --    require "CommonTipManager".OpenPowerUpView(power, offset)
    --end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RuneStrength.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DecorationSlot.id)
    if call then
        call(power, offset)
    end
end

