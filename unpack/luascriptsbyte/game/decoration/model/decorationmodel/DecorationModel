---@param cardData CardData 卡牌数据
---@param call function 回调函数
function DecorationModel:ResetSlotSuc(msg, cardData, call)
    if msg.ack ~= 1 then
        return
    end

    for _, v in pairs(cardData.DecorationBar) do
        v.slotLevel = 0
    end
    cardData:CalcNowSumProp(_G.AttrFunType.Decoration)
    require("CardInfoManager"):GetInstance():Updata_CardViewUpdataFun(cardData, true)

    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RuneStrength.id)
    if call then
        call()
    end
end

--卡牌重置/升星等操作回退符文都放到服务器上，客户端更新数据即可
function DecorationModel:P2CDecorationUpdate(msg)
    if msg.decoration_update then
        local decoData
        local cardUid
        local StorageManager = _G.StorageManager:GetInstance()
        for _, v in pairs(msg.decoration_update) do
            decoData = StorageManager:GetDatasByUid(_G.StorageID.Decoration, v.uid)
            if decoData then
                if not cardUid then
                    cardUid = decoData.cardUid
                end
                decoData:Parse(v)
            end
        end

        ---重置卡牌上的数据
        if cardUid then
            local cardData = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, cardUid)
            if cardData and cardData.DecorationBar then
                for _, v in pairs(cardData.DecorationBar) do
                    if v and v.decoration then
                        v.decoration = nil
                    end
                end
            end
        end
        self.IsRebirth = true
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DecorationSlot.id)
    end
end

