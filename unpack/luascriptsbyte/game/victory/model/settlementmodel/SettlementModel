--region
---结算
---@param sis SettlementType 结算类型
---@param callback function 结算完成回调
---@return 变量类型 中文描述
function SettlementModel:Settlement(sis, callback, ...)
    local settlementItem = _G.require(sis)
    if settlementItem then
        settlementItem.New(callback, ...)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("未定义的结算类型 sis = " .. sis)
        end
    end
end

--endregion

