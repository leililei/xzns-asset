local SettlementBaseView = _G.BaseClass("SettlementBaseView", _G.UIBaseView)
local battleManager = _G.BattleManager:GetInstance()
function SettlementBaseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---相机坐标
    self.ControlCameraPosArr = {
        ---画面一
        -- [1] = {-4.5, 1.75,7}
        [1] = {-1.54, 1.75, 7.55}
    }
    ---@type card_show_cfg
    ---角色展示特效表
    self.myCard_show_cfg = nil
    ---角色展示临时特效 缓存  清空
    self.ActionEffTempArr = {}
    ---角色展示 音效 缓存  清空
    self.ActionAudioArr = {}
    ---相机旋转四元素
    self.ControlCameraQuaArr = {
        ---画面二
        -- [1] = {-0.0004539362, 0.9718232, -0.004639211, 0.235665}
        [1] = {-0.0002933022, 0.9999844, -0.002997536, -0.004691169}
    }
    self.ControlCamera = nil
    self.sceneTrans = nil
    self.RoleTrans = nil
end

---界面的入口函数
function SettlementBaseView:OnCreate(call, ...)
    self.callback = call
    self:OnCreateChild(...)
end
--region 子类重写
function SettlementBaseView:OnCreateChild(...)
end
function SettlementBaseView:OnDestroy()
end
---@param enemyGarray table 数据统计界面需支持多场战斗
function SettlementBaseView:SetEnemyInfo(enemyGarray)
    local list = {}
    for _, v in pairs(enemyGarray) do
        list[v.sid] = v
    end
    return {list}
end
function SettlementBaseView:SetSettleSceneShow(isShow)
    if self.sceneTrans then
        _G.GameUtil.SetActiveByCondition(self.sceneTrans, isShow)
    end
end
--战斗场景隐藏和取消摄像机控制
function SettlementBaseView:SetScene(isShow)
    if self.isClose then
        return
    end
    local GetCurrentEnvironmentSetting = _G.GetCurrentEnvironmentSetting()
    if not GetCurrentEnvironmentSetting then
        return
    end
    if GetCurrentEnvironmentSetting:GetParent():FindE("Static_MeshMeraged") then
        _G.GameUtil.SetActiveByCondition(GetCurrentEnvironmentSetting:GetParent():FindE("Static_MeshMeraged"), isShow)
    end
    if GetCurrentEnvironmentSetting:GetParent():FindE("Static") then
        _G.GameUtil.SetActiveByCondition(GetCurrentEnvironmentSetting:GetParent():FindE("Static"), isShow)
    end
    if GetCurrentEnvironmentSetting:FindE("Post Processing_2") then
        _G.GameUtil.SetActiveByCondition(GetCurrentEnvironmentSetting:FindE("Post Processing_2"), isShow)
    end
end
--回放战斗场景隐藏和取消摄像机控制
function SettlementBaseView:SetRecordScene(isShow)
    self:SetScene(isShow)
    battleManager:SetCineAndVisualCam(isShow)
    --battleManager:HideFighterRootItem(isShow)
    battleManager:SetSceneObjActive(isShow)
end
---按钮点击事件在这里派发
function SettlementBaseView:OnClickBtn()
end
---结算资源回收
function SettlementBaseView:DisposeReource()
end
--endregion
---关闭界面时调用
---@param id SettlementModel.FunctionEnum 功能ID
function SettlementBaseView:CloseCall(id)
    if self.isClose then
        return
    end
    self:DisposeReource()
    SettlementBaseView.super.Close(self)
    self.isClose = true
    if self.callback then
        self.callback(id)
        self.callback = nil
    end
    _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
end

return SettlementBaseView
