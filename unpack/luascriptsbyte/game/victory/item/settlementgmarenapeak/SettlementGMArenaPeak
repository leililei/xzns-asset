---@class SettlementGMArenaPeak : SettlementItemBase    中文描述
local SettlementGMArenaPeak = _G.BaseClass("SettlementGMArenaPeak", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementGMArenaPeak:__init()
end

---销毁对象时,析构函数
function SettlementGMArenaPeak:Dispose()
end

function SettlementGMArenaPeak:ParseSettlementData(data, isNotWin, result)
    if result.ack ~= 1 then
        require "GMArenaPeakModel":GetInstance():ReturnPanel()
        return
    end
    self.data = data
    self.isNotWin = not result.reports.winner
    self.result = result
    self:ShowView()
end

function SettlementGMArenaPeak:ShowView()
    if not require "GMArenaPeakModel":GetInstance():GetBackIng() then 
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
        if ctrl then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
        end
    end
    self:OnShowView(_G.ConfigManager.ui_cfg.GMArenaPeakSettlementView.Name, self.result)
    --if not self.isNotWin then
    --    local result = {}
    --    result.statistics = true
    --
    --else
    --    self:OnShowView(_G.ConfigManager.ui_cfg.GMArenaPeakSettlementView.Name, self.result)
    --end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementGMArenaPeak:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

function SettlementGMArenaPeak:SettlementEnd()
    --if self.damage then
    --    require "ArenaPeakModel":GetInstance():UpdateDamages(self.damage)
    --end
    require "GMArenaPeakModel":GetInstance():RefreshRedPoint()
    require "GMArenaPeakModel":GetInstance():ReturnPanel(true)
end

return SettlementGMArenaPeak
