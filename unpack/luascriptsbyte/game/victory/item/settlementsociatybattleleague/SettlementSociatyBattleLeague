---@class SettlementSociatyBattleLeague:SettlementItemBase	中文描述
local SettlementSociatyBattleLeague = _G.BaseClass("SettlementSociatyBattleLeague", _G.SettlementItemBase)
---创建对象时,入口构造函数
function SettlementSociatyBattleLeague:__init()
end

---销毁对象时,析构函数
function SettlementSociatyBattleLeague:Dispose()
end

function SettlementSociatyBattleLeague:ParseSettlementData(data, isRecord, fightArgs, fightData)
    self.isRecord = isRecord
    self.data = data
    self.fightArgs = fightArgs
    self.fightData = fightData
    self:ShowView()
end

function SettlementSociatyBattleLeague:ShowView()
    local SociatyBattleLeagueManager = require "SociatyBattleLeagueManager"
    local winNum = 0
    local result = {}
    if self.fightData and self.fightData.role then
        --分享战报
        result.reportType = 22
        if SociatyBattleLeagueManager:GetInstance().isTestFight then
            result.reportType = 0
        end
        result.otherInfo = {
            sid = self.fightArgs.sid,
            name = self.fightData.role.name,
            frame = self.fightData.role.frame,
            style = self.fightData.role.style
        }
    end

    local fightMsg = SociatyBattleLeagueManager:GetInstance().fightMsg
    if self.data.skip then
        self.isWin = winNum > #fightMsg.winner - winNum
    else
        self.isWin = winNum > #self.data.multiplyWinner - winNum
    end
    if SociatyBattleLeagueManager:GetInstance():CheckIsTestFight() then
        for _, v in ipairs(self.data.multiplyWinner) do
            if v then
                winNum = winNum + 1
            end
        end
        self:OnShowView(
            _G.ConfigManager.ui_cfg.SociatyBattleLeagueResultView.Name,
            self.fightArgs,
            not _G.table.isEmptyOrNil(self.data.multiplyWinner) and self.data.multiplyWinner or fightMsg.winner,
            nil,
            result
        )
    else
        winNum = 0
        for _, v in ipairs(fightMsg.winner) do
            if v then
                winNum = winNum + 1
            end
        end
        self.isWin = winNum > #fightMsg.winner - winNum
        self:OnShowView(
            _G.ConfigManager.ui_cfg.SociatyBattleLeagueResultView.Name,
            self.fightArgs,
            fightMsg.winner,
            nil,
            result
        )
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSociatyBattleLeague:GetResult()
    return self.isWin
end

function SettlementSociatyBattleLeague:SettlementEnd()
end

return SettlementSociatyBattleLeague
