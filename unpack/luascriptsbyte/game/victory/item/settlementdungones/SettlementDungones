---@class SettlementDungones:SettlementItemBase    中文描述
local SettlementDungones = _G.BaseClass("SettlementDungones", _G.SettlementItemBase)

---类的构造函数
function SettlementDungones:__init()
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

---类的析构函数
function SettlementDungones:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
    self.data = nil
end

function SettlementDungones:ParseSettlementData(data, monsterGroupCfg, fightArg)
    self.data = data
    self.monsterGroupCfg = monsterGroupCfg
    self.fightArg = fightArg
    self:ShowView()
end

function SettlementDungones:ShowView()
    local result = {}
    local extraAward
    if not args and self.data == nil then
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
        return
    end
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            if require("DungonesModel"):GetInstance().isTime then --在活动中倒计时结束
                require "DungonesModel":GetInstance():GetDungonesInfo(
                    function()
                        require "DungonesManager":GetInstance():ReturnMian()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                        self:OnSettlementEndCall()
                    end
                )
                return
            end
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.RelicList = _data.args
                self.data.winner = _data.winner[1]
                result.iSWin = self.data.winner
                result.statistics = true

                self.data.damage = _data.atk_dps
                _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                if
                    not require "DoubleResourcesModel":GetInstance():CheckIsOvers() and
                        require "DoubleResourcesModel":GetInstance().sid == 105
                 then
                    self.double = true
                end
                result.AwardData, extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data, self.double)
                local model = require("DungonesModel"):GetInstance()
                if model.CurIsBoss then
                    --分享战报(boss才能分享)
                    result.reportType = 14
                    --对战人物信息
                    result.otherInfo = self:GetShareEnemyInfo()

                    --("千机伤害：" .. self.atk_dps)
                    result.damage = self.data.damage
                    result.maxDamage = model.DungonesInfo.damage
                    if model.DungonesInfo.damage == 0 then
                        _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPDungones, 3)
                    end
                    if self.data.damage > model.DungonesInfo.damage then
                        model.DungonesInfo.damage = self.data.damage
                    end
                    self:OnShowView(
                        _G.ConfigManager.ui_cfg.Dungeons_boss_win.Name,
                        result.AwardData,
                        extraAward,
                        self.data.damage,
                        result,
                        self.fightArg
                    )

                    local awardData = result.AwardData or {}
                    ---存在奖励就认为他是首次
                    if _G.table.count(awardData) > 0 then
                        require "PopUpGiftBagModel":GetInstance():IsPassDungones()
                    end
                else
                    if self.data.winner then
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
                            result,
                            extraAward,
                            nil,
                            nil,
                            self.fightArg and { self.fightArg } or nil
                        )
                    else
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
                            result,
                            nil,
                            nil,
                            nil,
                            self.fightArg and { self.fightArg } or nil
                        )
                    end
                    local cfg = require "DungonesManager":GetInstance().CurDoDungCfg
                    if cfg.group == 9 and cfg.layer < 3 then
                        _G.Events:GetInstance():Broadcast(_G.BattlePassExpEvents.BPDungones, cfg.layer)
                    end
                end
                if _data.defender_cards then
                    model.CurEventInfo.defender_cards = _data.defender_cards
                end
                if _data.cards then
                    model.DungonesInfo.cards = _data.cards
                end
            elseif _data.ack == 5 then --- 千机黑煞 时间结束 还在战斗中 返回 code == 5 提出到主界面
                require "DungonesModel":GetInstance():GetDungonesInfo(
                    function()
                        require "DungonesManager":GetInstance():ReturnMian()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
                    end
                )
            end
        end
    )
end

---获取战报分享敌方信息
function SettlementDungones:GetShareEnemyInfo()
    if not self.monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(self.monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementDungones:GetResult()
    return self.data.winner
end

---关闭功能界面
function SettlementDungones:CloseFunWindow()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DungonesRuningView.Name)
    if view then
        view:Close()
    end
    view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DungonesView.Name)
    if view then
        view:Close()
    end
    _G.JumpManager:GetInstance():Jump(119001)
end

function SettlementDungones:SettlementEnd()
    if self:GetResult() then
        require "DungonesManager":GetInstance():FightWin(self.RelicList)
    else
        require "DungonesManager":GetInstance():FightLose()
    end
end

return SettlementDungones
