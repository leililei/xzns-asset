---@class SettlementArenaGlobal:SettlementItemBase	中文描述
local SettlementArenaGlobal = _G.BaseClass("SettlementArenaGlobal", _G.SettlementItemBase)
---创建对象时,入口构造函数
function SettlementArenaGlobal:__init()
end

---销毁对象时,析构函数
function SettlementArenaGlobal:Dispose()
end

function SettlementArenaGlobal:ParseSettlementData(data, isRecord, fightArgs, enemyData)
    self.isRecord = isRecord
    self.data = data
    self.fightArgs = fightArgs
    self.enemyData = enemyData
    self:ShowView()
end

function SettlementArenaGlobal:ShowView()
    local ArenaGlobalModel = require "ArenaGlobalModel"
    local fightMsg = ArenaGlobalModel:GetInstance().fightMsg
    self.isWin = fightMsg.report.a_win
    local viewName =
        self.isWin and _G.ConfigManager.ui_cfg.ArenaGlobalSettlementVictoryView.Name or
        _G.ConfigManager.ui_cfg.ArenaGlobalSettlementFailView.Name
    self:OnShowView(viewName, self.data, fightMsg, self.enemyData)
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementArenaGlobal:GetResult()
    return self.isWin
end
function SettlementArenaGlobal:SettlementEnd(id)
    local enum = require("SettlementModel").FunctionEnum
    if id == enum.DevelopRole or id == enum.DevelopEquip then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaGlobalView.Name)
    end
    require "ArenaGlobalModel":GetInstance():ReturnPanel()
end

return SettlementArenaGlobal
