---@class SettlementArenaStreetFighting	中文描述
local SettlementArenaStreetFighting = _G.BaseClass("SettlementArenaStreetFighting", _G.SettlementItemBase)

---类的构造函数
function SettlementArenaStreetFighting:__init()
end

---类的析构函数
function SettlementArenaStreetFighting:Dispose()
end

---解析结算数据
---@param data table 结算数据
function SettlementArenaStreetFighting:ParseSettlementData(resultMsg, enemy)
    self.result = resultMsg
    self.enemyInfo = enemy
    --分享战报
    if enemy and enemy.roles then
        local sid = resultMsg and resultMsg.fight_arg and resultMsg.fight_arg.sid or 0
        self.result.reportType = 20
        self.result.re_uid = nil --街机乱斗没有战报
        self.result.otherInfo = {
            name = enemy.roles.name,
            sid = sid,
            style = enemy.roles.style or 0,
            frame = enemy.roles.frame or 0
        }
    end

    self:ShowView()
end

function SettlementArenaStreetFighting:ShowView()
    local view = _G.ConfigManager.ui_cfg.ArenaBrawlMvpView.Name
    self:OnShowView(view, self.result, self.enemyInfo)
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementArenaStreetFighting:GetResult()
    return self.result.winner == 0
end
return SettlementArenaStreetFighting
