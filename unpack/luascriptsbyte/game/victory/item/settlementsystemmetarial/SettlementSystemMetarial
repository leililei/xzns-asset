---@class SettlementSystemMetarial:SettlementItemBase	中文描述
local SettlementSystemMetarial = _G.BaseClass("SettlementSystemMetarial", _G.SettlementItemBase)

---类的构造函数
function SettlementSystemMetarial:__init()
end

---类的析构函数
function SettlementSystemMetarial:Dispose()
    self.data = nil
end

function SettlementSystemMetarial:ParseSettlementData(data, fightArg)
    self.data = data
    self.fightArg = fightArg
    self:ShowView()
end

function SettlementSystemMetarial:ShowView()
    local result = {}
    result.iSWin = self:GetResult()
    result.statistics = true
    if self:GetResult() then
        result.btnDisplay = require "SystemMaterialController":GetInstance():CheckCanFightNext()
    else
        result.btnDisplay = true
    end

    if self.data.result then
        _G.StorageManager:GetInstance():ReceiveAwardData(self.data.data)
        result.AwardData = _G.StorageManager:GetInstance():MergeAward(self.data.data)
    end
    self:OnShowView(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        result,
        nil,
        nil,
        nil,
        self.fightArg and { self.fightArg } or nil
    )
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSystemMetarial:GetResult()
    return self.data.result
end

return SettlementSystemMetarial
