---@class SettlementBagAlone    中文描述
local SettlementBagAlone = _G.BaseClass("SettlementBagAlone", _G.SettlementItemBase)

---类的构造函数
function SettlementBagAlone:__init()
end

---类的析构函数
function SettlementBagAlone:Dispose()
    self.data = nil
end

function SettlementBagAlone:ParseSettlementData(data)
    self.data = data
    self:ShowView(data)
end
---获取战斗结果
---@return boolean 是否胜利
function SettlementBagAlone:GetResult()
    return self.data.winner
end
function SettlementBagAlone:ShowView()
    local result = {}
    result.iSWin = self:GetResult()
    result.statistics = true
    if self:GetResult() then
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    end
end

---结算完成
---@param id SettlementModel.FunctionEnum 关闭回调参数
function SettlementBagAlone:SettlementEnd(id)
    _G.BattleManager:GetInstance():DestroyBattle()
end
return SettlementBagAlone
