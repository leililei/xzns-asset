---@class SettlementSeasonBoss : Singleton	中文描述
local SettlementSeasonBoss = _G.BaseClass("SettlementSeasonBoss", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementSeasonBoss:__init()
end

---销毁对象时,析构函数
function SettlementSeasonBoss:Dispose()
end

function SettlementSeasonBoss:ParseSettlementData(data, isNotWin)
    self.data = data
    self.isNotWin = isNotWin
    self:ShowView()
end

function SettlementSeasonBoss:ShowView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnOnUIOpened, self)
    if not self.isNotWin then
        local result = {}
        result.statistics = true
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = true
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner[1]
                    if _data.winner then
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        result.btnDisplay = false
                        self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)

                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.WorldBossShowAwardView.Name,
                            self.awardItemData,
                            self.extraAward,
                            nil,
                            _data.atk_dps,
                            require "SeasonBossModel":GetInstance().infoData.day_dps
                        )
                    end
                    require "SeasonBossModel":GetInstance():UpdateDamages(_data.atk_dps)
                    require "SeasonBossModel":GetInstance():ReturnPanel()
                end
            end
        )
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, false)
        require "SeasonBossModel":GetInstance():ReturnPanel()
    end
    self.index = 0
end

function SettlementSeasonBoss:OnOnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.SeasonView.Name or name == _G.ConfigManager.ui_cfg.SeasonBossView.Name then
        if name == _G.ConfigManager.ui_cfg.SeasonView.Name then
            _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
        end
        _G.UIManager:GetInstance():HideWindow(name)
        if name == _G.ConfigManager.ui_cfg.SeasonView.Name then
            _G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
        end
        self.index = self.index + 1
        if self.index == 2 then
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnOnUIOpened, self)
        end
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSeasonBoss:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

return SettlementSeasonBoss
