---@class SettlementInital	中文描述
local SettlementInital = _G.BaseClass("SettlementInital", _G.SettlementItemBase)

---类的构造函数
function SettlementInital:__init()
end

---类的析构函数
function SettlementInital:Dispose()
    self.result = nil
end

function SettlementInital:ParseSettlementData(result)
    self.result = result
    self:ShowView()
end
function SettlementInital:ShowView()
    --self.result.iSWin = self:GetResult()
    local view = _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name
    self:OnShowView(view, {iSWin = self:GetResult(), statistics = true}, nil, self.result)
end
function SettlementInital:GetResult()
    return self.result.winner[1]
end

return SettlementInital
