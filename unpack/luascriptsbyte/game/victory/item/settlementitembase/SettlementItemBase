---奖励整合
function SettlementItemBase:CalcAward(datas)
    if datas.award == nil then
        return
    end
    local data = datas.award.item
    local awards = {}
    if data then
        for _, v in pairs(data) do
            if not awards[v.type[1]] then
                awards[v.type[1]] = v.type[2]
            else
                awards[v.type[1]] = awards[v.type[1]] + v.type[2]
            end
        end
    end
    local sum = {}
    for i, v in pairs(awards) do
        table.insert(sum, {i, v})
    end
    return sum
end
---带额外奖励的整合
function SettlementItemBase:CalcExtraAward(datas)
    if datas.award == nil then
        return
    end
    local data = datas.award.item
    local awards = {}
    local extraAward = {}
    local tmp
    if data then
        for _, v in pairs(data) do
            if not awards[v.type[1]] then
                awards[v.type[1]] = v.type[2]
            else
                --awards[v.type[1]] = awards[v.type[1]] + v.type[2]
                if awards[v.type[1]] >= v.type[2] then
                    extraAward[v.type[1]] = v.type[2]
                else
                    tmp = awards[v.type[1]]
                    extraAward[v.type[1]] = awards[v.type[1]]
                    awards[v.type[1]] = v.type[2]
                end
            end
        end
    end
    local sum = {}
    for i, v in pairs(awards) do
        table.insert(sum, {i, v})
    end
    if not _G.table.isEmptyOrNil(extraAward) then
        for i, v in pairs(extraAward) do
            table.insert(sum, {i, v, 1})
        end
    end
    return sum
end
---结算界面关闭回调
---@param id SettlementModel.FunctionEnum 关闭回调参数
function SettlementItemBase:OnSettlementEndCall(id)
    id = id or require("SettlementModel").FunctionEnum.None
    self:SettlementEnd(id)
    if self.settlementEndCallback then
        self.settlementEndCallback(self:GetResult(), id)
    end
end
---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function SettlementItemBase:OnShowView(name, ...)
    local params = _G.SafePack(...)
    if params ~= nil and params[1] ~= nil and _G.IsTable(params[1]) and params[1].isTiaoGuo then
        _G.UIManager:GetInstance():OpenWindow(
                name,
                _G.handler(self, self.OnSettlementEndCall),
                _G.SafeUnpack(params)
        )
    else
        self:CreateResultEff(
                function()
                    _G.UIManager:GetInstance():OpenWindow(
                            name,
                            _G.handler(self, self.OnSettlementEndCall),
                            _G.SafeUnpack(params)
                    )
                end
        )
    end
end
