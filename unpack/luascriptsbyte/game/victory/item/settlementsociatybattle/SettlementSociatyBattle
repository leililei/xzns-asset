---@class SettlementSociatyBattle:SettlementItemBase	中文描述
local SettlementSociatyBattle = _G.BaseClass("SettlementSociatyBattle", _G.SettlementItemBase)
---创建对象时,入口构造函数
function SettlementSociatyBattle:__init()
end

---销毁对象时,析构函数
function SettlementSociatyBattle:Dispose()
end

function SettlementSociatyBattle:ParseSettlementData(data, isRecord, fightArgs, fightData)
    self.isRecord = isRecord
    self.data = data
    self.fightArgs = fightArgs
    self.fightData = fightData
    self:ShowView()
end

function SettlementSociatyBattle:ShowView()
    local SociatyBattleManager = require "SociatyBattleManager"
    local winNum = 0
    local result = {}
    if self.fightData and self.fightData.role then
        --分享战报
        result.reportType = 19
        result.otherInfo = {
            sid = self.fightArgs.sid,
            name = self.fightData.role.name,
            frame = self.fightData.role.frame,
            style = self.fightData.role.style
        }
    end

    local fightMsg = SociatyBattleManager:GetInstance().fightMsg
    if self.data.skip then
        self.isWin = winNum > #fightMsg.winner - winNum
    else
        self.isWin = winNum > #self.data.multiplyWinner - winNum
    end
    if SociatyBattleManager:GetInstance():CheckIsTestFight() then
        for _, v in ipairs(self.data.multiplyWinner) do
            if v then
                winNum = winNum + 1
            end
        end
        self:OnShowView(
            _G.ConfigManager.ui_cfg.SociatyBattleResultView.Name,
            self.fightArgs,
            self.data.skip and self.data.multiplyWinner or fightMsg.winner,
            nil,
            result
        )
    else
        winNum = 0
        for _, v in ipairs(fightMsg.winner) do
            if v then
                winNum = winNum + 1
            end
        end
        self.isWin = winNum > #fightMsg.winner - winNum
        self:OnShowView(
            _G.ConfigManager.ui_cfg.SociatyBattleResultView.Name,
            self.fightArgs,
            fightMsg.winner,
            nil,
            result
        )
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSociatyBattle:GetResult()
    return self.isWin
end
function SettlementSociatyBattle:SettlementEnd()
end

return SettlementSociatyBattle
