---@class SettlementSixVsSix	中文描述
local SettlementSixVsSix = _G.BaseClass("SettlementSixVsSix", _G.SettlementItemBase)

---类的构造函数
function SettlementSixVsSix:__init()
end

---类的析构函数
function SettlementSixVsSix:Dispose()
    self.data = nil
end

function SettlementSixVsSix:ParseSettlementData(data)
    self.data = data
    self:ShowView()
end
function SettlementSixVsSix:ShowView()
    local SixVsSixPVPModel = require "SixVsSixPVPModel":GetInstance()
    local result = {}
    require("SixVsSixPVPNet"):GetInstance():FightResult(
        function(_data, error)
            result.iSWin = _data.winner
            self.data.winner = _data.winner
            result.enemy = SixVsSixPVPModel.enemyData
            result.enemy.garray = {}
            result.sumscore, result.score, result.enemyAddScore = SixVsSixPVPModel:ChangeScore(result.iSWin)
            result.enemyCurScore = result.iSWin and result.enemy.score - result.enemyAddScore or 0
            result.statistics = true
            result.task_curr = _data.task_curr
            --分享战报
            if _data.report then
                local name = _data.report.target_role_name
                if _data.report.target_type == 1 then   --机器人
                    name = _G.GetLangPackValue(name)
                end
                result.reportType = 8
                result.re_uid = {_data.report.playback_uid} --战报ID
                result.otherInfo = {
                    name = name,
                    sid = _data.report.target_uid or 0,
                    style = _data.report.target_style or 0,
                    frame = _data.report.frame or 0
                }
            end

            result.hideCombBtn = true
            result.hidePetBtn = true
            result.report = _data.report
            SixVsSixPVPModel:AddSingleReport(_data.report)
            if result.task_curr then
                SixVsSixPVPModel:ChangeMission(result.task_curr)
            end
            if _data.info then
                SixVsSixPVPModel:ChangeSelfInfo(_data.info)
            end
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
            -- if _data.winner[1] then
            --     local award, extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
            --     _G.StorageManager:GetInstance():ReceiveAwardData(_data)
            --     result.AwardData = award
            --     self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result, extraAward)
            -- else
            --     result.btnDisplay = true
            --     self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
            -- end
            end
            local view
            if result.iSWin then
                view = _G.ConfigManager.ui_cfg.ArenaBattleVictoryPanelView.Name
            else
                view = _G.ConfigManager.ui_cfg.ArenaBattleFailPanelView.Name
            end
            self:OnShowView(view, result)
        end
    )
    -- if self:GetResult() then
    -- else
    --     result.iSWin = false
    --     result.statistics = true
    --     self:OnShowView(_G.ConfigManager.ui_cfg.ArenaBattleFailPanelView.Name, result)

    -- end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSixVsSix:GetResult()
    return self.data.winner
end

function SettlementSixVsSix:SettlementEnd(id)
    require "SixVsSixPVPModel":GetInstance():OnExitFight(id)
end

return SettlementSixVsSix
