---@class SettlementJointAfk	中文描述
local SettlementJointAfk = _G.BaseClass("SettlementJointAfk", _G.SettlementItemBase)

---类的构造函数
function SettlementJointAfk:__init()
end

---类的析构函数
function SettlementJointAfk:Dispose()
    self.data = nil
end

function SettlementJointAfk:ParseSettlementData(data, sid, monsterId)
    self.data = data
    self.sid = sid
    self.monsterId = monsterId
    self:ShowView()
end
function SettlementJointAfk:ShowView()
    local result = {}
    if self.data == nil then
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
        return
    end
    result.statistics = true
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(msg, error)
            result.iSWin = msg.winner[1]
            if _G.string.IsNullOrEmpty(error) and msg.ack == 1 then
                if msg.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif msg.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.data.winner[1] = msg.winner[1]
                result.btnDisplay = true
                result.back = true
                if msg.winner[1] and not require("JointAfkManager"):GetInstance():CheckCaseOver(self.sid) then
                    --接收奖励数据
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    --设置缓存数据
                    local model = require("JointAfkManager"):GetInstance()
                    model:UpdateOverCase(self.sid)
                    -- if model:GetAfkFirstSid() == self.sid then
                    --     model:GetDataFormServer()
                    -- else
                    --     model:CheckBuildUnlock(self.sid)
                    -- end
                    -- --刷新红点状态
                    -- model:RefreshSectionAwardRedPoint()
                    -- --是否显示下一关
                    -- local showNextFight = model:GetAfkNextSid() > 0 and
                    --     model:GetAfkLevel() >= _G.ConfigManager.afk2_cfg[model:GetAfkNextSid()].afk2_lv
                    model:SetNowCaseIndex()
                    result.AwardData = _G.StorageManager:GetInstance():MergeAward(msg)
                    
                    result.autonextDisplay = false
                    --result.back = not showNextFight
                    
                    self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(msg)
                    self.damage = msg.atk_dps
                    model:AddCoin(self.sid)
                    local coin = model:GetTokenAwardByID(self.sid)
                    if not _G.IsNil(coin) then
                        for i = 1, #coin do 
                            table.insert(result.AwardData, {coin[i].coin[2], coin[i].coin[3]})
                        end
                    end
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                else
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                end
            end
        end
    )
end
---获取战斗结果
---@return boolean 是否胜利
function SettlementJointAfk:GetResult()
    return self.data and self.data.winner[1] or false
end
function SettlementJointAfk:SettlementEnd(id)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    require("JointAfkManager"):GetInstance():ShowWindows()
end

return SettlementJointAfk
