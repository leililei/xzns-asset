---@class SettlementFriendDuel	中文描述
local SettlementFriendDuel = _G.BaseClass("SettlementFriendDuel", _G.SettlementItemBase)

---类的构造函数
function SettlementFriendDuel:__init()
end

---类的析构函数
function SettlementFriendDuel:Dispose()
    self.result = nil
end

function SettlementFriendDuel:ParseSettlementData(result)
    self.result = result
    self:ShowView()
end

function SettlementFriendDuel:ShowView()
    --self.result.iSWin = self:GetResult()
    local view = _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name
    self:OnShowView(view, { iSWin = self:GetResult(), statistics = true }, nil)
end

function SettlementFriendDuel:GetResult()
    return self.result.winner[1]
end

return SettlementFriendDuel
