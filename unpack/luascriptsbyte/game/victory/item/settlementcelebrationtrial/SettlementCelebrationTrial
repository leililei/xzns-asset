---@class SettlementCelebrationTrial : Singleton    中文描述
local SettlementCelebrationTrial = _G.BaseClass("SettlementCelebrationTrial", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementCelebrationTrial:__init()
end

---销毁对象时,析构函数
function SettlementCelebrationTrial:Dispose()
end

function SettlementCelebrationTrial:ParseSettlementData(data, isNotWin)
    self.data = data
    self.isNotWin = isNotWin
    self:ShowView()
end

function SettlementCelebrationTrial:ShowView()
    if not self.isNotWin then
        local result = {}
        result.statistics = true
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                require "CelebrationTrialModel":GetInstance():ParseFightResult(_data)
                result.iSWin = true
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner[1]
                    if _data.winner then
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        result.btnDisplay = false
                        self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        self.damage = _data.atk_dps
                        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                        _G.PlayerPrefsManager.SetTable(
                            "FightBossWinDamage",
                            {damage = self.damage, maxDamage = require "CelebrationTrialModel":GetInstance().damage}
                        )
                    end
                    require "CelebrationTrialModel":GetInstance():UpdateDamage(_data.atk_dps)
                end
            end
        )
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, false)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementCelebrationTrial:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

function SettlementCelebrationTrial:SettlementEnd()
    --if self.damage then
    --    require "CelebrationTrialModel":GetInstance():UpdateDamages(self.damage)
    --end
    require "CelebrationTrialModel":GetInstance():RefreshRedPoint()
    require "CelebrationTrialModel":GetInstance():ReturnPanel(self:GetResult())
end

return SettlementCelebrationTrial
