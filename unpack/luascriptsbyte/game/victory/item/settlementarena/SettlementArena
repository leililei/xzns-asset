---@class SettlementArena : SettlementItemBase	中文描述
local SettlementArena = _G.BaseClass("SettlementArena", _G.SettlementItemBase)

---类的构造函数
function SettlementArena:__init()
end

---类的析构函数
function SettlementArena:Dispose()
    self.data = nil
end

function SettlementArena:ParseSettlementData(data)
    self.data = data
    self:ShowView()
end
function SettlementArena:ShowView()
    local view =
        self:GetResult() and _G.ConfigManager.ui_cfg.ArenaBattleVictoryPanelView.Name or
        _G.ConfigManager.ui_cfg.ArenaBattleFailPanelView.Name
    self:OnShowView(view, self.data)
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementArena:GetResult()
    return self.data.win
end

return SettlementArena
