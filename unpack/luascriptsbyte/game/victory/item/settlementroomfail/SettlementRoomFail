---@class SettlementRoomFail	中文描述
local SettlementRoomFail = _G.BaseClass("SettlementRoomFail", _G.SettlementItemBase)

---类的构造函数
function SettlementRoomFail:__init()
end

---类的析构函数
function SettlementRoomFail:Dispose()
end

function SettlementRoomFail:ParseSettlementData()
    self:ShowView()
end
function SettlementRoomFail:ShowView()
    local result = {}
    result.btnDisplay = true
    result.statistics = true
    result.back = true
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
end
---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function SettlementRoomFail:OnShowView(name, result)
    _G.UIManager:GetInstance():OpenWindow(name, _G.handler(self, self.OnSettlementEndCall), result)
end
return SettlementRoomFail
