local base = require "SettlementItemBase"
---@class SettlementAfkChallenge    中文描述
local SettlementAfkChallenge = _G.BaseClass("SettlementAfkChallenge", base)

local SDKDef = require("SDKDef")

---类的构造函数
function SettlementAfkChallenge:__init()
end

---类的析构函数
function SettlementAfkChallenge:Dispose()
    self.resultData = nil
end

function SettlementAfkChallenge:ParseSettlementData(data)
    self.resultData = data
    self.resultData.AwardDataSort = 0 --不要对奖励进行排序
    self:ShowView()
end

function SettlementAfkChallenge:ShowView()
    local friendModel = require("FriendHelpModel"):GetInstance()
    local embattleModel = require("EmbattleModel"):GetInstance()
    if self.resultData.iSWin then
        --全部通关时应用全部临时助战次数至永久次数
        --未全部通关时, 仅记录临时助战次数(在退出战斗时还原次数)
        if self.resultData.pass then
            friendModel:AddUseCount(_G.EmbattleType.AFKOnly, true, true)
            require "DemoModel":GetInstance():AddUseCount(_G.EmbattleType.AFKOnly, self.resultData.pass)
        else
            friendModel:AddTempCount(_G.EmbattleType.AFKOnly)
        end
    else
        friendModel:OpenNpc(nil, nil, 1)
    end
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    if self.resultData.pass then
        self:ShowSectionPassView()
        embattleModel:ClearLastAssist()
    elseif not _G.MainManager:GetInstance():IsToggledAfkWindow(true) then
        --未选中冒险选项卡: 失败直接弹结算, 胜利但布阵不完整也直接失败结算
        local afkManager = require("AfkBattleManager"):GetInstance()
        if not self:GetResult() or not afkManager:CheckCurrentEmbattleValid() then
            friendModel:RemoveTempCount()                 --移除临时助战使用次数
            afkManager:ClearStatisticsData()              --场次统计数据不完整, 直接清除
            afkManager:ClearCurFightArg()
            require("AfkModel"):GetInstance():ResetPass() --重置关卡状态
            embattleModel:ClearLastAssist()

            --强制显示失败结算
            --self.resultData.pass = true
            self.resultData.iSWin = false
            self:ShowSectionPassView()
        else
            self:ShowMonsterStepView()
        end
    else
        -- view = _G.ConfigManager.ui_cfg.AfkSettlementView.Name
        self:ShowMonsterStepView()
    end
    -- self:OnShowView(view, self.resultData)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointAfk.id)
end

---展示关卡通关结算界面
function SettlementAfkChallenge:ShowSectionPassView()
    local afkModel = require("AfkModel"):GetInstance()
    local afkManager = require("AfkBattleManager"):GetInstance()

    --上报游戏行为
    if self.resultData.pass and self.resultData.iSWin then
        --获取当前通关关卡
        local cfg = afkModel:GetPreviousSectionCfg()
        local afkId = cfg and cfg.id or 0
        _G.SDKManager:GetInstance():GameAction(SDKDef.GameAction.EveryAfkPass, afkId)
    end

    --获取战报数据
    local curFightArgTable, statisticsdata
    if self.resultData.pass then
        local cfg = afkModel:GetPreviousSectionCfg()
        curFightArgTable = afkManager:GetCurFightArg(cfg)
        statisticsdata = afkManager:GetStatisticsData(cfg)
    else
        curFightArgTable = afkManager:GetCurFightArg()
        statisticsdata = afkManager:GetStatisticsData()
    end
    local winTable = {}
    ---若为多场战斗 则下面的值不为空
    if statisticsdata then
        local insert = _G.table.insert
        for i = 1, #statisticsdata.FighterInfo do
            insert(winTable, true)
        end
    end
    self.resultData.winTable = winTable
    self.resultData.reportType = 1
    self.resultData.page = afkManager:GetPage()
    if _G.AppSetting.IsXzns then
        self.resultData.hidePlayerInfo = true
        require("RescueGoddessModel"):GetInstance():CheckPop(--星座需要先检查是否能跳转到解救女神再弹结算
                function()
                    _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.AfkSettlementPassView.Name,
                            _G.handler(self, self.OnSettlementEndCall),
                            self.resultData,
                            nil,
                            statisticsdata,
                            statisticsdata and _G.Mathf.Random(1, #statisticsdata.FighterInfo) or nil,
                            curFightArgTable
                    )
                end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.AfkSettlementPassView.Name,
                _G.handler(self, self.OnSettlementEndCall),
                self.resultData,
                nil,
                statisticsdata,
                statisticsdata and _G.Mathf.Random(1, #statisticsdata.FighterInfo) or nil,
                curFightArgTable
        )
    end
    afkManager:ClearStatisticsData()
    afkManager:ClearCurFightArg()
end

---展示怪物组通关结算界面
function SettlementAfkChallenge:ShowMonsterStepView()
    if not _G.MainManager:GetInstance():IsToggledAfkWindow(true) then
        --后台战斗, 不显示小波结算直接进入下一场
        self:OnSettlementEndCall()
        return
    end

    local result = {}
    result.iSWin = self:GetResult()
    result.statistics = true
    if result.iSWin then
        result.autonextDisplay = true
        result.btnDisplay = true
        --autonextDisplay强制和btnDisplay绑定, 这里在页面加载完成后手动处理一下按钮
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnMonsterStepViewOpened, self)
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        function() --_G.handler(self, self.OnSettlementEndCall),
            self:OnSettlementEndCall()
        end,
        result
    )
end

---监听小结算页面打开
function SettlementAfkChallenge:OnMonsterStepViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnMonsterStepViewOpened, self)

    ---@type ShowAwardWithButtonView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if view then
        if view.VEff then
            self:SetMonsterStepViewButtonClosed(view)
        else
            view:RegiestEffectViewOpen(function()
                self:SetMonsterStepViewButtonClosed(view)
            end)
        end
    end
end

---关闭小结算页面上的按钮限时
---@param view ShowAwardWithButtonView
function SettlementAfkChallenge:SetMonsterStepViewButtonClosed(view)
    if not view or not view.VEff then
        return
    end
    if view.VEff.obj_shenglibutton then
        view.VEff.obj_shenglibutton:SetActiveE(0)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementAfkChallenge:GetResult()
    return self.resultData.iSWin
end

return SettlementAfkChallenge
