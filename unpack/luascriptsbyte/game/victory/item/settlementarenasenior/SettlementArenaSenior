local base = require "SettlementItemBase"
---@class SettlementArenaSenior	中文描述
local SettlementArenaSenior = _G.BaseClass("SettlementArenaSenior", base)

---类的构造函数
function SettlementArenaSenior:__init()
end

---类的析构函数
function SettlementArenaSenior:Dispose()
    self.result = nil
    self.enemy = nil
    self.mine = nil
    self.win = nil
end

--region 子类重写接口
---解析结算数据
---@param result table 结果
---@param enemy table 敌方基本信息
---@param mine table 己方基本信息
function SettlementArenaSenior:ParseSettlementData(result, enemy, mine)
    self.win = 0
    for i = 1, #result do
        if result[i] then
            self.win = self.win + 1
        end
    end
    self.result = result
    self.enemy = enemy
    self.mine = mine
    self:ShowView()
end
---展示结算界面
function SettlementArenaSenior:ShowView()
    local data = _G.BattleManager:GetInstance():GetStatistics()
    local view
    if self:GetResult() then
        view = _G.ConfigManager.ui_cfg.ArenaBattleVictorySeniorPanelView.Name
    else
        view = _G.ConfigManager.ui_cfg.ArenaBattleFailSeniorPanelView.Name
    end
    self:OnShowView(view, self.mine, self.enemy, self.result, data)
end
---获取战斗结果
---@return boolean 是否胜利
function SettlementArenaSenior:GetResult()
    return self.win >= 2
end
--endregion

return SettlementArenaSenior
