---@class SettlementWorldBoss : SettlementItemBase	中文描述
local SettlementWorldBoss = _G.BaseClass("SettlementWorldBoss", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementWorldBoss:__init()
end

---销毁对象时,析构函数
function SettlementWorldBoss:Dispose()
end

function SettlementWorldBoss:ParseSettlementData(data, id)
    self.data = data or {}
    self.id = id
    self:ShowView()
end

function SettlementWorldBoss:ShowView()
    local DoubleResourcesModel = require("DoubleResourcesModel"):GetInstance()
    self.double = false
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                local dps = require "WorldBossModel":GetInstance().wordData.score
                require "WorldBossManager":GetInstance():FightWin(_data.atk_dps)
                self.data.winner = _data.winner[1]
                local result = {}
                --分享战报
                result.reportType = 15
                --对战人物信息
                result.otherInfo = self:GetShareEnemyInfo()

                if _data.winner then
                    _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                    if not DoubleResourcesModel:CheckIsOvers() and DoubleResourcesModel.sid == 103 then
                        self.double = true
                    end
                    self.awardItemData, self.extraAward =
                        _G.StorageManager:GetInstance():MergeExtraAward(_data, self.double)
                    self:OnShowView(
                        _G.ConfigManager.ui_cfg.FirstTestBossShowAwardView.Name,
                        self.awardItemData,
                        self.extraAward,
                        nil,
                        _data.atk_dps,
                        dps,
                        result
                    )
                end
            end
        end
    )
end

---获取战报分享敌方信息
function SettlementWorldBoss:GetShareEnemyInfo()
    local bossCfg = _G.ConfigManager.boss_cfg[1]
    if not bossCfg then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[bossCfg.monster]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementWorldBoss:GetResult()
    return true
end
function SettlementWorldBoss:SettlementEnd()
end

return SettlementWorldBoss
