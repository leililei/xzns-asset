---@class SettlementHellGuard : Singleton	中文描述
local SettlementHellGuard = _G.BaseClass("SettlementHellGuard", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementHellGuard:__init()
end

---销毁对象时,析构函数
function SettlementHellGuard:Dispose()
end

function SettlementHellGuard:ParseSettlementData(data, isNotWin, fightArg)
    self.data = data
    self.isNotWin = isNotWin
    self.fightArg = fightArg
    --跳过战斗手动清空统计数据(灵域守卫未发送跳过战斗事件, C#层未清空统计数据)
    if not data or data.skip then
        _G.BattleManager:GetInstance():SetStatisticsCached(nil)
    end

    self:ShowView()
end

function SettlementHellGuard:ShowView()
    if self.isNotWin then
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, false)
    else
        local result = {}
        result.statistics = true
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = true
                result.btnDisplay = false
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner[1]
                    if _data.winner then
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        local data2 = {kill_num = _data.kill_num, recent = _data.recent}
                        self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.HellGuardShowAwardView.Name,
                            self.awardItemData,
                            self.extraAward,
                            nil,
                            result,
                            data2,
                            self.fightArg
                        )
                    else
                        local data2 = {kill_num = self.data.kill_num, recent = _data.recent}
                    end
                    require "HellGuardModel":GetInstance():FightWin(self.data.kill_num)
                else
                    -- result.AwardData = {}
                    -- result.btnDisplay = false
                    -- local data2 = {kill_num = self.data.kill_num, recent = _data.recent}
                    -- self:OnShowView(_G.ConfigManager.ui_cfg.HellGuardShowAwardView.Name, nil, nil, nil, result, data2)
                    self:OnSettlementEndCall()
                end
            end
        )
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementHellGuard:GetResult()
    return not self.isNotWin
end

function SettlementHellGuard:SettlementEnd()
end

return SettlementHellGuard
