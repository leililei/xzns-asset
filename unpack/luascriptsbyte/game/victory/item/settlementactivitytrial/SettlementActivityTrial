---@class SettlementActivityTrial : SettlementItemBase    雪域欢歌-雪域试炼
---@field model ActivityTrialSynModel
---@field activity ActivityTrialData
---@field monsterGroupId number
local SettlementActivityTrial = _G.BaseClass("SettlementActivityTrial", _G.SettlementItemBase)


function SettlementActivityTrial:ParseSettlementData(data, isNotWin, activity, monsterGroupId)
    self.data = data
    self.isNotWin = isNotWin
    self.model = activity:GetActivityTypeCls()
    self.activity = activity
    self.monsterGroupId = monsterGroupId
    self:ShowView()
end

function SettlementActivityTrial:ShowView()
    if self.isNotWin then
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, false)
        return
    end

    local result = {}
    result.statistics = true
    result.iSWin = true

    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            self.model:ParseFightResult(_data)

            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end

                if _data.winner then
                    result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                    result.btnDisplay = false
                    _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                end
                -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, _data)
                self.model:UpdateDamage(_data.atk_dps)
                self.model:ConsumeFightAwardTimes()
                self.model:GetAllPassTimes()
                self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
            end
        end
    )
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementActivityTrial:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

function SettlementActivityTrial:SettlementEnd()
    self.model:RefreshRedPoint()
    self.model:ReturnPanel(self:GetResult(), self.monsterGroupId)
end

return SettlementActivityTrial
