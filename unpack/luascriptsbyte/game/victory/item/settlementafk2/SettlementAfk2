---@class SettlementAfk2 : Singleton    灵域巡查结算
local SettlementAfk2 = _G.BaseClass("SettlementAfk2", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementAfk2:__init()
end

---销毁对象时,析构函数
function SettlementAfk2:Dispose()
end

function SettlementAfk2:ParseSettlementData(data, sid, monsterId)
    self.data = data
    self.sid = sid
    self.monsterId = monsterId
    self:ShowView()
end

function SettlementAfk2:ShowView()
    local result = {}
    if self.data == nil then
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
        return
    end
    result.statistics = true
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(msg, error)
            result.iSWin = msg.winner[1]
            if _G.string.IsNullOrEmpty(error) and msg.ack == 1 then
                if msg.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif msg.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.data.winner[1] = msg.winner[1]

                if msg.winner[1] then
                    --接收奖励数据
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                    --设置缓存数据
                    local model = require("Afk2Model"):GetInstance()
                    model:SetAfkSid(self.sid)
                    if model:GetAfkFirstSid() == self.sid then
                        model:GetDataFormServer()
                    else
                        model:CheckBuildUnlock(self.sid)
                    end
                    --刷新红点状态
                    model:RefreshSectionAwardRedPoint()
                    --是否显示下一关
                    local showNextFight = model:GetAfkNextSid() > 0 and
                        model:GetAfkLevel() >= _G.ConfigManager.afk2_cfg[model:GetAfkNextSid()].afk2_lv

                    result.AwardData = _G.StorageManager:GetInstance():MergeAward(msg)
                    result.btnDisplay = true
                    result.autonextDisplay = showNextFight
                    result.back = not showNextFight

                    self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(msg)
                    self.damage = msg.atk_dps
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                else
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                end
            end
        end
    )
end

---获取战报分享敌方信息
function SettlementAfk2:GetShareEnemyInfo()
    local fairylandCfg = _G.ConfigManager.system_fairyland_cfg[self.sid]
    if not fairylandCfg then
        return nil
    end

    local monsterGroupCfg = _G.ConfigManager.monster_group_cfg[fairylandCfg.monster]
    if not monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementAfk2:GetResult()
    return self.data and self.data.winner[1] or false
end

function SettlementAfk2:SettlementEnd(id)
    require "Afk2Model":GetInstance():ReturnPanel(self:GetResult(), id)
end

return SettlementAfk2
