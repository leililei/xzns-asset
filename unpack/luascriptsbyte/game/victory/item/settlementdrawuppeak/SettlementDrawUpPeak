---@class SettlementDrawUpPeak : SettlementItemBase	中文描述
local SettlementDrawUpPeak = _G.BaseClass("SettlementDrawUpPeak", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementDrawUpPeak:__init()
end

---销毁对象时,析构函数
function SettlementDrawUpPeak:Dispose()
end

function SettlementDrawUpPeak:ParseSettlementData(data, isNotWin, ActivityID)
    self.data = data
    self.ActivityID = ActivityID
    self.isNotWin = isNotWin
    self:ShowView()
end

function SettlementDrawUpPeak:ShowView()
    if not self.isNotWin then
        local result = {}
        result.statistics = true
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = true
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner[1]
                    if _data.winner then
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        result.btnDisplay = false
                        self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        self.damage = _data.args[1]
                        local maxDamage = require"DrawUpMainModel":GetInstance():GetHigh_dps(self.ActivityID) 
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.FirstTestBossShowAwardView.Name,
                            self.awardItemData,
                            self.extraAward,
                            nil,
                            _data.args[1],
                            maxDamage
                        )
                        require "DrawUpMainModel":GetInstance():Atk_dps(self.ActivityID, _data.args[1])
                    -- require "BlackSourceModel":GetInstance():FightEnd()

                    -- local curMaxDamage = _data.atk_dps or require "WorldBossManager":GetInstance():GetDamage()
                    -- if curMaxDamage > maxDamage then
                    --     maxDamage = curMaxDamage
                    -- end

                    -- _G.Events:GetInstance():Broadcast(
                    --     _G.ePlayAactionEvent.PlayAaction,
                    --     {
                    --         _G.ActiveTaskEnum.ConditionEnum.BlackSource.BossSingleMaxDPS
                    --     },
                    --     maxDamage
                    -- )
                    end
                    --
                    --更新试炼红点状态
                    local activityManager = require("ActivitySynManager"):GetInstance()
                    local activity = activityManager:GetActivityClass(self.ActivityID)
                    local activityClass = activity and activityManager:GetChildAcitivity(10030, activity:GetJumpType())
                    ---@type DrawUpPeakManager
                    local activityTypeCls = activityClass and activityClass:GetActivityTypeCls()
                    if activityTypeCls and activityTypeCls.MarkPeakViewRedPoint then
                        activityTypeCls:MarkPeakViewRedPoint()
                    end
                end
            end
        )
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, false)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementDrawUpPeak:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

function SettlementDrawUpPeak:SettlementEnd()
    require "DrawUpMainModel":GetInstance():ReturnPanel()
end

return SettlementDrawUpPeak
