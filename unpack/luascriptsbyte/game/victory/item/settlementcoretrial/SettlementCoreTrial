---@class SettlementCoreTrial    中文描述
local SettlementCoreTrial = _G.BaseClass("SettlementCoreTrial", _G.SettlementItemBase)

---类的构造函数
function SettlementCoreTrial:__init()
end

---类的析构函数
function SettlementCoreTrial:Dispose()
    self.data = nil
end

function SettlementCoreTrial:ParseSettlementData(data,typeClass)
    self.data = data
    self.typeClass = typeClass
    if self.typeClass.curActivityClass:GetCurActivityState() == require "ActivitySynManager".State.Open then
        self:ShowView()
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        _G.BattleManager:GetInstance():OnEndFight()
    end
end

function SettlementCoreTrial:ShowView()
    local result = {}
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                local condition = {}
                local enemyData = {}
                if _data.args then
                    enemyData =  {_data.args[1],_data.args[2]}
                    self.data.enemyData = enemyData
                    for i = 3 ,#_data.args do
                        condition[i-2] = _data.args[i]
                    end
                end
                self.data.condition = condition
                self.data.winner = _data.winner[1]
                self.data.award = {}
                self.data.award.award = _data.award
                result.iSWin = self.data.winner
                result.statistics = true
                self.data.damage = _data.atk_dps
                self:OnShowView(_G.ConfigManager.ui_cfg.CoreTrialSettlementView.Name, self.data,self.typeClass,result)
            end
        end
    )
end
---获取战斗结果
---@return boolean 是否胜利
function SettlementCoreTrial:GetResult()
    return self.data.winner
end

function SettlementCoreTrial:SettlementEnd()
    self.typeClass:ReturnActivityView(self:GetResult(),self.data)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
end

return SettlementCoreTrial

