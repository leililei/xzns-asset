---@class SettlementMonsterSiege : Singleton 怪物攻城结算
local SettlementMonsterSiege = _G.BaseClass("SettlementMonsterSiege", _G.SettlementItemBase)
---@return SettlementMonsterSiege SettlementMonsterSiege
---创建对象时,入口构造函数
function SettlementMonsterSiege:__init()
end

---销毁对象时,析构函数
function SettlementMonsterSiege:Dispose()
    self.data = nil
end
function SettlementMonsterSiege:ParseSettlementData(data, monsterGroupCfg, isBoss)
    self.data = data
    self.monsterGroupCfg = monsterGroupCfg
    self.isBoss = isBoss
    self:ShowView()
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementMonsterSiege:GetResult()
    return self.data.winner
end
---
function SettlementMonsterSiege:SettlementEnd()
    --
    if _G.AppSetting.DEBUG then
        _G.Log("战斗结束 改变数据：", "怪物攻城")
    end
    require "MonsterSiegeManager":GetInstance():FightEndUpdate(self:GetResult())
end
function SettlementMonsterSiege:ShowView()
    local result = {}
    local extraAward
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            ---活动倒计时
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.RelicList = _data.args
                self.data.winner = _data.winner[1]
                result.iSWin = self.data.winner
                result.statistics = true
                --分享战报(Boss战才可分享)
                if self.isBoss then
                    result.reportType = 21
                    --对战人物信息
                    result.otherInfo = self:GetShareEnemyInfo()
                end

                self.data.damage = _data.atk_dps
                _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                local MonsterSiegeManager = require "MonsterSiegeManager":GetInstance()
                if MonsterSiegeManager:CheckIsBoss() then
                    local maxDps = require "MonsterSiegeManager":GetInstance():GetDps()
                    local damage = _data.atk_dps
                    MonsterSiegeManager:SetDps(damage)
                    self:OnShowView(
                        _G.ConfigManager.ui_cfg.FirstTestBossShowAwardView.Name,
                        self.awardItemData,
                        self.extraAward,
                        nil,
                        damage,
                        maxDps,
                        result
                    )
                else
                    if self.data.winner then
                        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                    else
                        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                    end
                end
            end
        end
    )
end

---获取战报分享敌方信息
function SettlementMonsterSiege:GetShareEnemyInfo()
    if not self.monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(self.monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

function SettlementMonsterSiege:GetDamage()
    local statistics = _G.BattleManager:GetInstance():GetStatistics()
    local score = 0
    for _, v in pairs(statistics.FighterInfo) do
        for _, v2 in pairs(v.Attacker) do
            score = score + v2.DmgOut
        end
    end
    return score
end
return SettlementMonsterSiege
