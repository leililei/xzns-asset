---@class SettlementArenaPeak : Singleton    中文描述
local SettlementArenaPeak = _G.BaseClass("SettlementArenaPeak", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementArenaPeak:__init()
end

---销毁对象时,析构函数
function SettlementArenaPeak:Dispose()
end

function SettlementArenaPeak:ParseSettlementData(data, isNotWin, result)
    if result.ack ~= 1 then
        require "ArenaPeakModel":GetInstance():ReturnPanel()
        return
    end
    self.data = data
    self.isNotWin = not result.reports.winner
    self.result = result
    self:ShowView()
end

function SettlementArenaPeak:ShowView()
    self:OnShowView(_G.ConfigManager.ui_cfg.ArenaPeakSettlementView.Name, self.result)
    --if not self.isNotWin then
    --    local result = {}
    --    result.statistics = true
    --
    --else
    --    self:OnShowView(_G.ConfigManager.ui_cfg.ArenaPeakSettlementView.Name, self.result)
    --end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementArenaPeak:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

function SettlementArenaPeak:SettlementEnd()
    --if self.damage then
    --    require "ArenaPeakModel":GetInstance():UpdateDamages(self.damage)
    --end
    require "ArenaPeakModel":GetInstance():RefreshRedPoint()
    require "ArenaPeakModel":GetInstance():ReturnPanel(true)
end

return SettlementArenaPeak
