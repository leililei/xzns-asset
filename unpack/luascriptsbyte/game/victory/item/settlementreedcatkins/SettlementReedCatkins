---@class SettlementReedCatkins    中文描述
local SettlementReedCatkins = _G.BaseClass("SettlementReedCatkins", _G.SettlementItemBase)

---类的构造函数
function SettlementReedCatkins:__init()
end

---类的析构函数
function SettlementReedCatkins:Dispose()
    self.data = nil
end

function SettlementReedCatkins:ParseSettlementData(data)
    self.data = data
    self:ShowView()
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementReedCatkins:GetResult()
    return self.data.winner[1]
end

function SettlementReedCatkins:ShowView()
    local DoubleResourcesModel = require("DoubleResourcesModel"):GetInstance()
    local result = {}
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            result.iSWin = _data.winner[1]
            self.data.winner[1] = _data.winner[1]
            result.statistics = true

            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                if _data.winner[1] then
                    local double = false
                    if not DoubleResourcesModel:CheckIsOvers() and DoubleResourcesModel.sid == 102 then
                        double = true
                    end
                    local award, extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data, double)
                    _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                    result.AwardData = award
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result, extraAward)
                else
                    result.btnDisplay = true
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                end
            end
        end
    )
end

---结算界面关闭回调
---@param id SettlementModel.FunctionEnum 关闭回调参数
function SettlementReedCatkins:OnSettlementEndCall(id)
    id = id or require("SettlementModel").FunctionEnum.None
    self:SettlementEnd(id)
    if self.settlementEndCallback then
        self.settlementEndCallback(self:GetResult(), id)
    end
end

function SettlementReedCatkins:SettlementEnd(id)
    if self:GetResult() then
        require("ReedCatkinsModel"):GetInstance():FightWin(id == 0)
    else
        require("ReedCatkinsModel"):GetInstance():FightLose(id == 0)
    end
end

return SettlementReedCatkins
