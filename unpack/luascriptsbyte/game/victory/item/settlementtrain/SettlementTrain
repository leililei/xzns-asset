---@class SettlementTrain : SettlementItemBase	中文描述
local SettlementTrain = _G.BaseClass("SettlementTrain", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementTrain:__init()
end

---销毁对象时,析构函数
function SettlementTrain:Dispose()
end

function SettlementTrain:ParseSettlementData(data)
    self.data = data
    self:ShowView(data)
end

function SettlementTrain:ShowView(tab)
    if tab.winner[1] then
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    if _data.winner then
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        self.data = _data
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.TrainSettlementView.Name,
                            _data.winner[1],
                            _G.StorageManager:GetInstance():MergeAward(_data),
                            false
                        )
                    else
                        self:OnShowView(_G.ConfigManager.ui_cfg.TrainSettlementView.Name, false, nil, false)
                    end
                end
            end
        )
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.TrainSettlementView.Name, false, nil, false)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementTrain:GetResult()
    return self.data.winner[1]
end
function SettlementTrain:SettlementEnd()
    if self:GetResult() then
        require "TrainingModel":GetInstance():FightWin()
    end
end

return SettlementTrain
