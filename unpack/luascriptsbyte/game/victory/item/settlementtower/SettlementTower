---@class SettlementTower:SettlementItemBase    中文描述
local SettlementTower = _G.BaseClass("SettlementTower", _G.SettlementItemBase)

---类的构造函数
function SettlementTower:__init()
end

---类的析构函数
function SettlementTower:Dispose()
    self.data = nil
end

function SettlementTower:ParseSettlementData(data, tab, monsterId, fightArg)
    self.data = data
    self.result = tab
    self.monsterId = monsterId
    self.fightArg = fightArg
    self:ShowView()
end

function SettlementTower:ShowView()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BattleView.Name)

    ---@type FriendHelpModel
    local friendModel = require "FriendHelpModel":GetInstance()
    ---@type EmbattleModel
    local embattleModel = require "EmbattleModel":GetInstance()
    ---@type DemoModel
    local demoModel = require "DemoModel":GetInstance()
    ---@type DeadsoulTowerModel
    local towerModel = require "DeadsoulTowerModel":GetInstance()

    if self.data.pass then
        ---不知道原作者为什么不直接操作self.data，新建了一个result
        local result = {}
        result.statistics = true
        if AppSetting.IsXzns then
            result.hidePlayerInfo=true
        end
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.result,
            function(_data, error)
                result.iSWin = _data.winner and _data.winner[1]
                self.data.iSWin = result.iSWin --跳过战斗时isWin=true, 此处同步服务器结果至this.data
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.result.winner = _data.winner[1]
                    if _data.winner[1] then
                        result.AwardData = self:CalcAward(_data)
                        result.btnDisplay = true
                        _G.DeadsoulTowerManager:GetInstance():SetMonsterPass(self.monsterId)
                        if _G.BattleManager:GetInstance():HasStatisticsCached() then
                            _G.DeadsoulTowerManager:GetInstance():SetCurStatisticsData(
                                _G.BattleManager:GetInstance():GetStatistics(),
                                self.monsterId
                            )
                        end
                        --当前通关关卡层数
                        local towerLayer
                        if towerModel.CurTowerType == 9 then
                            local sid = towerModel.CurTowerSid
                            require "PopUpGiftBagModel":GetInstance():IsArriveDeadTower(sid)
                            local maxtowerinfo = towerModel:GetMaxCurrentTower()
                            if (sid + 1) > maxtowerinfo.id then
                                result.back = true
                            else
                                result.back = false
                                -- local back = _G.DeadsoulTowerManager:GetInstance():CheckQuickPower(sid + 1)
                                -- if not back then
                                --     result.back = true
                                -- end
                            end
                            result.funcForecast = towerModel:GetDeadTowerFunForecast()
                            local cfg = _G.ConfigManager.tower_cfg[towerModel.LandFloor]
                            towerLayer = cfg and (cfg.layer + 1) or 0
                        else
                            --local sid = model.PracticeFloor[model.CurTowerType].high_floor
                            local sid = towerModel.CurTowerSid
                            require "PopUpGiftBagModel":GetInstance():IsElementTower(sid)
                            local towerId = towerModel.PracticeFloor[towerModel.CurTowerType].high_floor
                            local cfg = _G.ConfigManager.tower_cfg[towerId]
                            towerLayer = cfg and (cfg.layer + 1) or 0
                        end
                        result.task = self:GetBattleTask(towerModel.CurTowerSid)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        --自动推图
                        result.autonextDisplay = self.data.autonextDisplay
                        result.showTwoBtn = true
                        --ZHJH-4080【客户端】爬塔显示逻辑和奖励领取逻辑优化
                        --每10N层强制返回主页面
                        if towerLayer > 0 and towerLayer % 10 == 0 then
                            result.back = true
                            result.autonextDisplay = false
                        end
                        local statisticsdata = _G.DeadsoulTowerManager:GetInstance():GetStatisticsData()
                        local curFightArgTable = _G.DeadsoulTowerManager:GetInstance():GetCurFightArg()
                        local winTable = {}
                        if statisticsdata then
                            local insert = _G.table.insert
                            for i = 1, #curFightArgTable do
                                insert(winTable, true)
                            end
                            --分享战报
                            result.reportType = towerModel.CurTowerType == towerModel.MianTower and 11 or 12
                            --对战人物信息
                            result.otherInfo = self:GetShareEnemyInfo()

                            --战报敌方名称显示为层数
                            local cfg = _G.ConfigManager.tower_cfg[towerModel.CurTowerSid]
                            if cfg and result.otherInfo then
                                if towerModel.CurTowerType == towerModel.MianTower then
                                    result.otherInfo.name = tostring(cfg.layer)
                                elseif towerModel.CurTowerType == 1 then
                                    result.otherInfo.name = _G.GetLangPackValue(90000011280, cfg.layer)
                                elseif towerModel.CurTowerType == 2 then
                                    result.otherInfo.name = _G.GetLangPackValue(90000011281, cfg.layer)
                                elseif towerModel.CurTowerType == 3 then
                                    result.otherInfo.name = _G.GetLangPackValue(90000011282, cfg.layer)
                                elseif towerModel.CurTowerType == 4 then
                                    result.otherInfo.name = _G.GetLangPackValue(90000011283, cfg.layer)
                                elseif towerModel.CurTowerType == 5 then
                                    result.otherInfo.name = _G.GetLangPackValue(90000011284, cfg.layer)
                                end
                            end
                        end
                        result.winTable = winTable

                        if self:GetResult() then
                            _G.DeadsoulTowerManager:GetInstance():UpdateAwardCanTake()
                        end

                        _G.DeadsoulTowerManager:GetInstance():ClearStatisticsData()
                        _G.DeadsoulTowerManager:GetInstance():ClearCurFightArg()
                        local id = self:GetEmbattleId(towerModel.CurTowerType)
                        --全部通关时应用全部临时助战次数至永久次数
                        friendModel:AddUseCount(id, true, true, curFightArgTable)
                        demoModel:AddUseCount(id, true)
                        embattleModel:ClearLastAssist()

                        self:ShowSectionPassView(
                            result,
                            nil,
                            statisticsdata,
                            statisticsdata and _G.Mathf.Random(1, #statisticsdata.FighterInfo) or nil,
                            curFightArgTable
                        )
                    else
                        self.data.pass = false
                        friendModel:OpenNpc(nil, nil, 3)
                        result.btnDisplay = true
                        --result.back = true
                        if # _G.DeadsoulTowerManager:GetInstance():GetSceneID() == 1 then
                            self:ShowSectionPassView(result)
                        else
                            self:ShowMonsterStepView()
                        end
                    end
                else
                    result.btnDisplay = true
                    --result.back = true
                    self:ShowSectionPassView(result)
                end
            end
        )
    else
        if self.data.iSWin then
            local id = self:GetEmbattleId(towerModel.CurTowerType)
            --未全部通关时, 仅记录临时助战次数(在退出战斗时还原次数)
            --TODO: 需传递战报数据, 否则还是会走一次C#(纯逻辑)战斗
            friendModel:AddTempCount(id, self.fightArg and { self.fightArg } or nil)
            demoModel:AddUseCount(id)
        else
            friendModel:OpenNpc(nil, nil, 3)
        end
        local result = {}
        result.iSWin = self.data.iSWin
        result.statistics = true
        result.btnDisplay = true
        if AppSetting.IsXzns then
            result.hidePlayerInfo=true
        end
        --result.back = true
        --TODO: 战斗失败没有向服务器发送同步请求(刷新战报), 此时无法分享战报
        --分享战报
        --result.reportType = towerModel.CurTowerType == towerModel.MianTower and 11 or 12
        --对战人物信息
        --result.otherInfo = self:GetShareEnemyInfo()

        --单纯战斗失败, 直接显示结算面板(而不是小结算面板)
        if #_G.DeadsoulTowerManager:GetInstance():GetSceneID() == 1 then
            self:ShowSectionPassView(
                result,
                nil,
                nil,
                nil,
                _G.DeadsoulTowerManager:GetInstance():GetCurFightArg()
            )
        elseif not _G.MainManager:GetInstance():IsToggledWildWindow(true) then
            --未选中野外选项卡: 失败直接弹结算, 胜利但布阵不完整也直接失败结算
            local towerManager = _G.DeadsoulTowerManager:GetInstance()
            if not self:GetResult() or not towerManager:CheckCurrentEmbattleValid() then
                friendModel:RemoveTempCount()      --移除临时助战使用次数
                towerManager:ClearStatisticsData() --场次统计数据不完整, 直接清除
                towerManager:ClearCurFightArg()
                --require("AfkModel"):GetInstance():ResetPass() --重置关卡状态
                embattleModel:ClearLastAssist()

                --强制显示失败结算
                --self.resultData.pass = true
                result.iSWin = false
                self:ShowSectionPassView(
                    result,
                    nil,
                    nil,
                    nil,
                    _G.DeadsoulTowerManager:GetInstance():GetCurFightArg()
                )
            else
                self:ShowMonsterStepView()
            end
        else
            self:ShowMonsterStepView()
        end
    end
end

---@return task mission_cfg
function SettlementTower:GetBattleTask(sid)
    local task = {}
    if
    _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.ActiveTask) or
        _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Achievement)
    then
        local taskid = require "DeadsoulTowerModel":GetInstance():GetSidTaskCom(sid)
        local _i_task
        if taskid then
            _i_task = require "ActiveTaskManager":GetInstance():GetTaskByTaskid(taskid)
        end
        if _i_task then
            task.desc = _G.LangUtil.GetLangPackValue(_G.ConfigManager.mission_cfg[_i_task.i_task.sid].desc)
            task.fininsh = _i_task.i_task.state == 5
            task.progress = _i_task.i_task.state == 5 and "(1/1)" or "(0/1)"
        end
        return task
    end
end

---展示关卡通关结算界面
function SettlementTower:ShowSectionPassView(...)
    self:OnShowView(_G.ConfigManager.ui_cfg.DeadSoulSettlementPassView.Name, ...)
end

---显示小结算页面
function SettlementTower:ShowMonsterStepView()
    if not _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        --后台战斗, 不显示小波结算直接进入下一场
        self:OnSettlementEndCall()
        return
    end

    local result = {}
    result.iSWin = self:GetResult()
    result.statistics = true
    if result.iSWin then
        result.autonextDisplay = true
        result.btnDisplay = true
        --autonextDisplay强制和btnDisplay绑定, 这里在页面加载完成后手动处理一下按钮
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnMonsterStepViewOpened, self)
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        function() --_G.handler(self, self.OnSettlementEndCall),
            self:OnSettlementEndCall()
        end,
        result,
        nil,
        nil,
        nil,
        self.fightArg and { self.fightArg } or nil
    )
end

---监听小结算页面打开
function SettlementTower:OnMonsterStepViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnMonsterStepViewOpened, self)

    ---@type ShowAwardWithButtonView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if view then
        if view.VEff then
            self:SetMonsterStepViewButtonClosed(view)
        else
            view:RegiestEffectViewOpen(function()
                self:SetMonsterStepViewButtonClosed(view)
            end)
        end
    end
end

---关闭小结算页面上的按钮限时
---@param view ShowAwardWithButtonView
function SettlementTower:SetMonsterStepViewButtonClosed(view)
    if not view or not view.VEff then
        return
    end
    if view.VEff.obj_shenglibutton then
        view.VEff.obj_shenglibutton:SetActiveE(0)
    end
end

---获取塔类型基础布阵id
---@param type number 塔类型 1-5, 9
---@return number
function SettlementTower:GetEmbattleId(type)
    local id = _G.EmbattleType.Tower
    if type == 9 then
        id = _G.EmbattleType.Tower
    elseif type == 1 then
        id = _G.EmbattleType.Tower1
    elseif type == 2 then
        id = _G.EmbattleType.Tower2
    elseif type == 3 then
        id = _G.EmbattleType.Tower3
    elseif type == 4 then
        id = _G.EmbattleType.Tower4
    elseif type == 5 then
        id = _G.EmbattleType.Tower5
    end
    return id
end

---获取战报分享敌方信息
function SettlementTower:GetShareEnemyInfo()
    local monsterGroupCfg = _G.ConfigManager.monster_group_cfg[self.monsterId]
    if not monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementTower:GetResult()
    return self.data.iSWin
end

function SettlementTower:SettlementEnd(id)
    if self:GetResult() then
        if self.data.pass then
            _G.DeadsoulTowerManager:GetInstance():FightWin(id)
        end
    else
        local funid = require("SettlementModel").FunctionEnum
        if id == funid.None then
            _G.DeadsoulTowerManager:GetInstance():FightLose()
        elseif id == funid.ReEmbattle then
            ---_G.DeadsoulTowerManager:GetInstance():FightLose(
        end
    end
end

return SettlementTower
