---@class SettlementSeasonTower    中文描述
local SettlementSeasonTower = _G.BaseClass("SettlementSeasonTower", _G.SettlementItemBase)

---类的构造函数
function SettlementSeasonTower:__init()
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

---类的析构函数
function SettlementSeasonTower:Dispose()
    self.data = nil
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

function SettlementSeasonTower:ParseSettlementData(data, isNotWin, otherInfo)
    self.data = data
    self.isNotWin = isNotWin
    self.otherInfo = otherInfo
    self:ShowView()
end

function SettlementSeasonTower:ShowView()
    local result = {}
    result.reportType = 6
    if not self.isNotWin then
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner
                    result.iSWin = _data.winner[1]
                    result.statistics = true
                    result.autonextDisplay = true
                    result.btnDisplay = true
                    result.showTwoBtn = true
                    result.otherInfo = self.otherInfo

                    if self:GetResult() then
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        result.btnDisplay = true
                    else
                        result.iSWin = false
                    end

                    if  result.iSWin == false then
                        result.back = true
                    end

                    local towerLayer = require "SeasonTowerModel":GetInstance():GetCurTowerId()
                    if towerLayer > 0 and towerLayer % 10 == 0 then
                        result.back = true
                        result.autonextDisplay = false
                        result.showTwoBtn = false
                    end

                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                end
            end
        )
    else
        result.iSWin = false
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSeasonTower:GetResult()
    if self.isNotWin then
        return false
    end
    return self.data.winner[1]
end

---关闭功能界面
function SettlementSeasonTower:CloseFunWindow()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SeasonTowerView.Name)
    if view then
        view:Close()
    end
    view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SeasonView.Name)
    if view then
        view:Close()
    end
end

function SettlementSeasonTower:SettlementEnd()
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    require "SeasonTowerModel":GetInstance():FightWin(self:GetResult())
end

return SettlementSeasonTower
