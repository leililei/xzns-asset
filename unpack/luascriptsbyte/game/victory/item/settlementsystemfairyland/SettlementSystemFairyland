---@class SettlementSystemFairyland : SettlementItemBase    中文描述
local SettlementSystemFairyland = _G.BaseClass("SettlementSystemFairyland", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementSystemFairyland:__init()
end

---销毁对象时,析构函数
function SettlementSystemFairyland:Dispose()
end

function SettlementSystemFairyland:ParseSettlementData(data, bossID, sid, fightArg)
    self.data = data
    self.bossID = bossID
    self.sid = sid
    self.fightArg = fightArg
    self:ShowView()
end

function SettlementSystemFairyland:ShowView()
    local result = {}
    if self.data == nil then
        self:OnShowView(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            result,
            nil,
            nil,
            nil,
            self.fightArg and { self.fightArg } or nil
        )
        return
    end
    result.statistics = true
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            result.iSWin = _data.winner[1]
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.data.winner[1] = _data.winner[1]
                --分享战报
                result.reportType = 13
                --对战人物信息
                result.otherInfo = self:GetShareEnemyInfo()

                --战报敌方名称显示为层数
                local cfg = _G.ConfigManager.system_fairyland_cfg[self.sid]
                if cfg and result.otherInfo then
                    if cfg.grade == 1 then
                        result.otherInfo.name = _G.GetLangPackValue(90000011285, cfg.difficulty)
                    elseif cfg.grade == 2 then
                        result.otherInfo.name = _G.GetLangPackValue(90000011286, cfg.difficulty)
                    elseif cfg.grade == 3 then
                        result.otherInfo.name = _G.GetLangPackValue(90000011287, cfg.difficulty)
                    elseif cfg.grade == 4 then
                        result.otherInfo.name = _G.GetLangPackValue(90000011288, cfg.difficulty)
                    end
                end

                if _data.winner[1] then
                    require("SystemFairylandModel"):GetInstance():SetLayerPass(self.bossID, self.sid, _data.args)
                    _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                    --local allPass = require("SystemFairylandModel"):GetInstance():CheckPassMaxLayer(self.bossID)
                    result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                    result.btnDisplay = true
                    --ZHJH-4547 每一关按钮都改为返回
                    result.autonextDisplay = false
                    result.back = true

                    self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                    self.damage = _data.atk_dps
                end
                self:OnShowView(
                    _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
                    result,
                    nil,
                    nil,
                    nil,
                    self.fightArg and { self.fightArg } or nil
                )
                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ReedCatkinsOneBoss.id)
            end
        end
    )
end

---获取战报分享敌方信息
function SettlementSystemFairyland:GetShareEnemyInfo()
    local fairylandCfg = _G.ConfigManager.system_fairyland_cfg[self.sid]
    if not fairylandCfg then
        return nil
    end

    local monsterGroupCfg = _G.ConfigManager.monster_group_cfg[fairylandCfg.monster]
    if not monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSystemFairyland:GetResult()
    return self.data and self.data.winner[1] or false
end

function SettlementSystemFairyland:SettlementEnd(id)
    require "SystemFairylandModel":GetInstance():ReturnPanel(self:GetResult(), id)
end

return SettlementSystemFairyland
