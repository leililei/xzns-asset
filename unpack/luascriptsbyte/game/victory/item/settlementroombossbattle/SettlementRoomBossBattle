---@class SettlementRoomBossBattle	中文描述
local SettlementRoomBossBattle = _G.BaseClass("SettlementRoomBossBattle", _G.SettlementItemBase)

---类的构造函数
function SettlementRoomBossBattle:__init()
end

---类的析构函数
function SettlementRoomBossBattle:Dispose()
    self.result = nil
end

function SettlementRoomBossBattle:ParseSettlementData(data)
    self.result = data.result.winner
    self:ShowView()
end
function SettlementRoomBossBattle:ShowView()
    local result = {}
    result.iSWin = self:GetResult()
    result.AwardData = _G.ChapterRoomManager:GetInstance():GetCurRoomSettleAward()
    result.statistics = true
    result.back = true
    _G.ChapterRoomManager:GetInstance():SetAwardNewState()
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
end
---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function SettlementRoomBossBattle:OnShowView(name, result)
    _G.UIManager:GetInstance():OpenWindow(name, _G.handler(self, self.OnSettlementEndCall), result)
end
---获取战斗结果
---@return boolean 是否胜利
function SettlementRoomBossBattle:GetResult()
    return self.result
end

return SettlementRoomBossBattle
