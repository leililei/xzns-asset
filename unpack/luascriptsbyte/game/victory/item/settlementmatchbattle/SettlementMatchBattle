---@class SettlementMatchBattle	中文描述
local SettlementMatchBattle = _G.BaseClass("SettlementMatchBattle", _G.SettlementItemBase)

---类的构造函数
function SettlementMatchBattle:__init()
end

---类的析构函数
function SettlementMatchBattle:Dispose()
    self.result = nil
end

function SettlementMatchBattle:ParseSettlementData(result)
    self.result = result
    self:ShowView()
end
function SettlementMatchBattle:ShowView()
    local result = {}
    result.iSWin = self:GetResult()
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
end
---获取战斗结果
---@return boolean 是否胜利
function SettlementMatchBattle:GetResult()
    return self.result
end
---结算完成
---@param id SettlementModel.FunctionEnum 关闭回调参数
function SettlementMatchBattle:SettlementEnd(id)
    _G.BattleManager:GetInstance():DestroyBattle()
    require("MatchBattleManager"):GetInstance():ClearData()
end
return SettlementMatchBattle
