---@class SettlementSpiritualRealm : SettlementItemBase	中文描述
local SettlementSpiritualRealm = _G.BaseClass("SettlementSpiritualRealm", _G.SettlementItemBase)

---类的构造函数
function SettlementSpiritualRealm:__init()
end

---类的析构函数
function SettlementSpiritualRealm:Dispose()
    self.results = nil
    self.report = nil
    self.scores = nil
end

function SettlementSpiritualRealm:ParseSettlementData(results, report, scores, mvpData)
    self.results = results
    self.report = report
    self.scores = scores
    self.mvpData = mvpData
    self:ShowView()
end
function SettlementSpiritualRealm:ShowView()
    local view =
    self:GetResult() and _G.ConfigManager.ui_cfg.SpiritualRealmVictoryPanelView.Name or
            _G.ConfigManager.ui_cfg.SpiritualRealmFailPanelView.Name
    self:OnShowView(view, self.results, self.report, self.scores, self.mvpData)

    --local view = _G.ConfigManager.ui_cfg.SpiritualRealmSettlementView.Name
    --self:OnShowView(view, 1, self.results, self.report, self.scores)
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSpiritualRealm:GetResult()
    local len = #self.report.winner
    local winCount = 0
    for i = 1, len do
        if self.report.winner[i] == 0 then
            winCount = winCount + 1
        end
    end
    return winCount > len - winCount
end

return SettlementSpiritualRealm
