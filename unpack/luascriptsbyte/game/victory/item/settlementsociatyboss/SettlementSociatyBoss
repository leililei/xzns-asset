---@class SettlementSociatyBoss:SettlementItemBase    中文描述
local SettlementSociatyBoss = _G.BaseClass("SettlementSociatyBoss", _G.SettlementItemBase)

---类的构造函数
function SettlementSociatyBoss:__init()
end

---类的析构函数
function SettlementSociatyBoss:Dispose()
    self.data = nil
    self.isRecord = nil
end

function SettlementSociatyBoss:ParseSettlementData(data, IsRecord, fightArg, isTest)
    self.data = data
    self.isRecord = IsRecord
    self.fightArg = fightArg
    self.isTest = isTest
    self:ShowView()
end

function SettlementSociatyBoss:ShowView()
    local result = {}
    result.statistics = true
    if not self.isRecord then
        if self.isTest ~= nil and self.isTest == true then
            if self.data.skip ~= nil and self.data.skip == true then
                self.data = _G.BattleManager:GetInstance():GetStatistics().result
            end
            local atk_dps = 0
            for i, v in ipairs(self.data.atk_dps) do
                atk_dps = atk_dps + v
            end
            result.iSWin = self.data.winner
            result.damage = atk_dps
            result.btnDisplay = true
            result.back = true
            self:OnShowView(
                _G.ConfigManager.ui_cfg.SociatyWitchTrialsShowAwardView.Name,
                result,
                self.fightArg and { self.fightArg } or nil,
                self.isTest
            )
        else
            require("BattleNet"):GetInstance():NpcPVEFightResult(
                self.data,
                function(_data, error)
                    self.data.winner = _data.winner
                    result.iSWin = _data.winner
                    if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                        if _data.md5_error == "1" then
                            _G.PopWindowManager:GetInstance():ShowAllTips(44)
                            _G.BattleManager:GetInstance():SaveLogNew()
                        elseif _data.md5_error == "2" then
                            _G.BattleManager:GetInstance():SaveLogNew()
                        end
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        result.AwardData, result.privilegeData = self:ParseAwardData(_G.StorageManager:GetInstance():MergeAward(_data))
                        result.btnDisplay = true
                        result.back = true
                        result.damage = _data.atk_dps or 0
                        result.maxDamage = 0
                        if _G.PlayerPrefsManager.HasKey("SociatyBossMaxDamage") then
                            local maxDamage = 0
                            if not string.IsNullOrEmpty(_G.PlayerPrefsManager.GetString("SociatyBossMaxDamage")) then
                                maxDamage=tonumber(_G.PlayerPrefsManager.GetString("SociatyBossMaxDamage")) or 0
                            else
                                local num=_G.PlayerPrefsManager.GetInt("SociatyBossMaxDamage") or 0
                                maxDamage= num>0 and num or 0
                            end
                            result.maxDamage = maxDamage
                            if maxDamage < result.damage then
                                _G.PlayerPrefsManager.SetString("SociatyBossMaxDamage", tostring(result.damage))
                            end
                        else
                            _G.PlayerPrefsManager.SetString("SociatyBossMaxDamage", tostring(result.damage))
                        end
                        if result.maxDamage==0 then 
                            result.maxDamage=_data.atk_dps
                        end
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.SociatyWitchTrialsShowAwardView.Name,
                            result,
                            self.fightArg and { self.fightArg } or nil
                        )
                    end
                end
            )
        end
    else
        self:OnSettlementEndCall()
    end
end

--如果有挑战加成，把加成的道具数量分出来
function SettlementSociatyBoss:ParseAwardData(data)
    local tab1 = {}
    local tab2 = {}
    local addRatio = require("SociatyModel"):GetInstance():GetBuildChallengeAdd() + 1
    for k, v in ipairs(data) do
        local originNum = math.ceil(v[2] / addRatio)
        local privNum = v[2] - originNum
        local newData1 = _G.DeepCopy(v)
        if privNum > 0 then
            newData1[2] = originNum
            table.insert(tab1, newData1)
            local newData2 = _G.DeepCopy(v)
            newData2[2] = privNum
            table.insert(tab2, newData2)
        else
            table.insert(tab1, newData1)
        end
    end
    tab2 = #tab2 > 0 and tab2 or nil
    return tab1, tab2
end

function SettlementSociatyBoss:SettlementEnd()
    _G.BattleManager:GetInstance():DestroyBattle()
    require "SociatyModel":GetInstance():ReturnPanel()
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSociatyBoss:GetResult()
    return self.data.winner
end

return SettlementSociatyBoss
