local SettlementModel = require("SettlementModel")

---@class SettlementDungeonChallenge : SettlementItemBase    灵域巡查结算
local SettlementDungeonChallenge = _G.BaseClass("SettlementDungeonChallenge", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementDungeonChallenge:__init()
end

---销毁对象时,析构函数
function SettlementDungeonChallenge:Dispose()
end

function SettlementDungeonChallenge:ParseSettlementData(data, monsterGroupId, fightArg)
    self.data = data or { winner = {} }
    self.monsterGroupId = monsterGroupId
    self.fightArg = fightArg
    self:ShowView()
end

function SettlementDungeonChallenge:ShowView()
    local result = {}
    result.statistics = true
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(msg, error)
            result.iSWin = msg.winner[1]
            if _G.string.IsNullOrEmpty(error) and msg.ack == 1 then
                if msg.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif msg.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                self.data.winner[1] = msg.winner[1]

                if _G.AppSetting.IsXzns then
                    result.forceHideBtn = true
                end
                local model = require("DungeonChallengeBattleModel"):GetInstance()
                if msg.winner[1] then
                    --接收奖励数据
                    model:ParseSettlementData(msg)

                    if model:IsChallenging() then
                        --继续挑战
                        _G.PopWindowManager:GetInstance():ShowAllTips(1080401)
                        self:OnSettlementEndCall(SettlementModel.FunctionEnum.Back)
                    else
                        --通关挑战
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(msg)
                        result.btnDisplay = true
                        result.autonextDisplay = false
                        result.back = true

                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
                            result,
                            nil,
                            nil,
                            nil,
                            self.fightArg and { self.fightArg } or nil
                        )
                    end
                else
                    model:ClearChallenging() --战斗失败, 直接清除战斗状态

                    self:OnShowView(
                        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
                        result,
                        nil,
                        nil,
                        nil,
                        self.fightArg and { self.fightArg } or nil
                    )
                end
            end
        end
    )
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementDungeonChallenge:GetResult()
    return self.data and self.data.winner[1] or false
end

return SettlementDungeonChallenge
