---@class SettlementArenaElement	中文描述
local SettlementArenaElement = _G.BaseClass("SettlementArenaElement", _G.SettlementItemBase)

---类的构造函数
function SettlementArenaElement:__init()
end

---类的析构函数
function SettlementArenaElement:Dispose()
    self.data = nil
end

function SettlementArenaElement:ParseSettlementData(data)
    self.data = data
    self:ShowView()
end
function SettlementArenaElement:ShowView()
    local view =
        self:GetResult() and _G.ConfigManager.ui_cfg.ArenaBattleVictoryPanelView.Name or
        _G.ConfigManager.ui_cfg.ArenaBattleFailPanelView.Name
    self:OnShowView(view, self.data)
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementArenaElement:GetResult()
    return self.data.win
end
return SettlementArenaElement
