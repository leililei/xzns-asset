---@class SettlementRelicTeam:SettlementItemBase	中文描述
local SettlementRelicTeam = _G.BaseClass("SettlementRelicTeam", _G.SettlementItemBase)

---类的构造函数
function SettlementRelicTeam:__init()
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.ReEmbattle, self.ReEmbattle, self)
end

---类的析构函数
function SettlementRelicTeam:Dispose()
    self.data = nil
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.ReEmbattle, self.ReEmbattle, self)
end

function SettlementRelicTeam:ParseSettlementData(data, sid, monsterId, fightArg)
    self.data = data or {}
    self.sid = sid
    self.monsterId = monsterId
    self.fightArg = fightArg
    self:ShowView()
end

