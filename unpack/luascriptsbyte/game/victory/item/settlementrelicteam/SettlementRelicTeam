---获取战斗结果
---@return boolean 是否胜利
function SettlementRelicTeam:GetResult()
    return self.data and self.data.winner[1] or false
end

---关闭功能界面
function SettlementRelicTeam:CloseFunWindow()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.RelicTeamToggleView.Name)
    if view then
        view:Close()
    end
end

---调整阵容
function SettlementRelicTeam:ReEmbattle()
    require "RelicTeamModel":GetInstance():OnChallenge(true)
end

function SettlementRelicTeam:SettlementEnd(id)
    _G.WorldManager:GetInstance():GetCurWorld():ShowOrHideAllItem(true)
    _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
    require("RelicTeamModel"):GetInstance():ShowWindows()
end

return SettlementRelicTeam
