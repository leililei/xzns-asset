---@class SettlementBlackSource : SettlementItemBase	中文描述
local SettlementBlackSource = _G.BaseClass("SettlementBlackSource", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementBlackSource:__init()
end

---销毁对象时,析构函数
function SettlementBlackSource:Dispose()
end

function SettlementBlackSource:ParseSettlementData(data, isNotWin, monsterGroupCfg)
    self.data = data
    self.isNotWin = isNotWin
    self.monsterGroupCfg = monsterGroupCfg
    self:ShowView()
end

function SettlementBlackSource:ShowView()
    if require "BlackSourceModel":GetInstance():IsSettlement() then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            310402,
            _G.LangUtil.GetLangPackValue(90000010312, require "BlackSourceModel":GetInstance():TranslateSecond())
        )
        self:OnSettlementEndCall()
        return
    end
    if not self.isNotWin then
        local result = {}
        result.statistics = true
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = true
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner[1]

                    --分享战报
                    result.reportType = 16
                    --对战人物信息
                    result.otherInfo = self:GetShareEnemyInfo()

                    if _data.winner then
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        result.btnDisplay = false
                        self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        self.damage = _data.atk_dps
                        local maxDamage = require "BlackSourceModel":GetInstance().dps
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.FirstTestBossShowAwardView.Name,
                            self.awardItemData,
                            self.extraAward,
                            nil,
                            _data.atk_dps,
                            maxDamage,
                            result
                        )
                        require "BlackSourceModel":GetInstance():FightEnd()

                        local curMaxDamage = _data.atk_dps or require "WorldBossManager":GetInstance():GetDamage()
                        if curMaxDamage > maxDamage then
                            maxDamage = curMaxDamage
                        end

                        _G.Events:GetInstance():Broadcast(
                            _G.ePlayAactionEvent.PlayAaction,
                            {
                                _G.ActiveTaskEnum.ConditionEnum.BlackSource.BossSingleMaxDPS
                            },
                            maxDamage
                        )
                    end
                end
            end
        )
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, false)
    end
end

---获取战报分享敌方信息
function SettlementBlackSource:GetShareEnemyInfo()
    if not self.monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(self.monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end

    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementBlackSource:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

function SettlementBlackSource:SettlementEnd()
    require "BlackSourceModel":GetInstance():ReturnPanel(self:GetResult())
end

return SettlementBlackSource
