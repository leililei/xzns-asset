local SettlementItemBase = require "SettlementItemBase"
---@class SettlementSystemEquip	中文描述
local SettlementSystemEquip = _G.BaseClass("SettlementSystemEquip", SettlementItemBase)

---类的构造函数
function SettlementSystemEquip:__init()
end

---类的析构函数
function SettlementSystemEquip:Dispose()
    self.data = nil
end

function SettlementSystemEquip:ParseSettlementData(data)
    self.data = data
    self:ShowView()
end
function SettlementSystemEquip:ShowView()
    local result = {}
    require("BattleNet"):GetInstance():NpcPVEFightResult(
        self.data,
        function(_data, error)
            result.iSWin = _data.winner[1]
            if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                if _data.md5_error == "1" then
                    _G.PopWindowManager:GetInstance():ShowAllTips(44)
                    _G.BattleManager:GetInstance():SaveLogNew()
                elseif _data.md5_error == "2" then
                    _G.BattleManager:GetInstance():SaveLogNew()
                end
                if _data.winner[1] then
                    result.AwardData = self:CalcAward(_data)
                    _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                else
                    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                end
            end
        end
    )
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementItemBase:GetResult()
    return self.data.winner
end

function SettlementSystemEquip:SettlementEnd()
    _G.BattleManager:GetInstance():DestroyBattle()
    if self:GetResult() then
        require("EquipSystemModel"):GetInstance():FightWin()
    else
        require("EquipSystemModel"):GetInstance():FightLose()
    end
end

return SettlementSystemEquip
