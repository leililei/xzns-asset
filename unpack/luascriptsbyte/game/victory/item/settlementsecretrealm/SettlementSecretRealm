local base = _G.SettlementItemBase

---@class SettlementSecretRealm : SettlementItemBase    中文描述
---@field revive boolean    是否已复活
local SettlementSecretRealm = _G.BaseClass("SettlementSecretRealm", base)

---类的构造函数
function SettlementSecretRealm:__init()
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

---类的析构函数
function SettlementSecretRealm:Dispose()
    self.data = nil
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

function SettlementSecretRealm:OnSettlementEndCall(id)
    --如果是boss房结算且继续挑战, 则调用基类
    local funid = require("SettlementModel").FunctionEnum
    if id == funid.Next then
        base.OnSettlementEndCall(self, id)
        return
    end

    --先走结算逻辑, 清理战斗场景资源
    base.OnSettlementEndCall(self)

    local model = require("SecretRealmModel"):GetInstance()
    if self:GetResult() and not model:IsBossRoom() then
        --战斗胜利, 直接开始下一关(非boss关卡)
        model:ChallengeNextRoom()
    elseif self.revive then
        --战斗失败, 且已复活, 继续挑战当前关卡
        model:ChallengeCurrentRoom()
    else
        model:ExitChallenge()
    end
end

function SettlementSecretRealm:ParseSettlementData(data, fightArg, auto)
    self.data = data
    self.fightArg = fightArg
    self.auto = auto
    self:ShowView()
end

function SettlementSecretRealm:ShowView()
    local model = require("SecretRealmModel"):GetInstance()
    local isWin = self.data and self.data.isWin                                     --是否胜利
    local isTimeout = not isWin and (self.data and self.data.attack_time or 0) <= 0 --是否超时
    local reviveCount = model:GetReviveCount()                                      --可复活次数

    if isWin then
        --战斗胜利
        if model:IsBossRoom() then
            local curBattleIndex = model:GetCurBattleIndex()
            --减去挑战次数, 解锁更高难度
            model:AddTicket(-1, curBattleIndex)
            if model:GetMaxSid(curBattleIndex) == 0 or model:GetCurrentChallengeSid() > model:GetMaxSid(curBattleIndex) then
                model:SetMaxSid(model:GetCurrentChallengeSid(), curBattleIndex)
            end

            --进入boss结算页面
            self:ShowSettlementView(true)
        elseif self.data.args and #self.data.args > 0 then
            --进入选buff页面
            self:OpenChooseBuff()
            --_G.DelayDo(3, _G.handler(self, self.OpenChooseBuff))
        else
            --直接进入下一个房间
            self:OnSettlementEndCall()
        end
    elseif (isTimeout or reviveCount <= 0) then
        --超时丶无可复活次数, 直接显示失败
        self:ShowSettlementView(false)
    else
        --进入复活流程
        self:OpenChooseRevive()
    end
end

---胜利丶失败结算页面
---@param win boolean
function SettlementSecretRealm:ShowSettlementView(win)
    if self.data then
        self.data.iSWin = win and true or false
        self.data.statistics = true
        if win then
            self.data.AwardData = _G.StorageManager:GetInstance():MergeAward(self.data)
            local cfg = _G.ConfigManager.decoration_cfg
            _G.table.sort(self.data.AwardData, function(a, b)
                local cfgA = cfg[a[1]]
                local cfgB = cfg[b[1]]
                if (cfgA and cfgB == nil) or (cfgB and cfgA == nil) then
                    return cfgA
                end
                if cfgA and cfgA.grade ~= cfgB.grade then
                    return cfgA.grade > cfgB.grade
                end
                return a[1] < b[1]
            end)
            self.data.AwardDataSort = 0 --不要对奖励进行排序
            local curBattleIndex = require("SecretRealmModel"):GetInstance():GetCurBattleIndex()
            local isOpen = require("SecretRealmModel"):GetInstance():IsBattleAutoOpen(curBattleIndex)
            if isOpen then
                --自动下一关(挑战次数足够, 且不是最后一层)
                local model = require("SecretRealmModel"):GetInstance()
                if model:GetTicket(curBattleIndex) >= model:GetCurMultiple(curBattleIndex) then
                    self.data.autonextDisplay = true
                    self.data.btnDisplay = true
                    self.data.showTwoBtn = true
                end
            end
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnBattleViewOpened, self)
        end
    end
    self:OnShowView(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        self.data,
        nil,
        nil,
        nil,
        self.fightArg and { self.fightArg } or nil
    )
end

function SettlementSecretRealm:OnBattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnBattleViewOpened, self)
    local model = require("SecretRealmModel"):GetInstance()
    local pool = model:GetCurrentChallengeAwardWishPool()
    local curBattleIndex = require("SecretRealmModel"):GetInstance():GetCurBattleIndex()
    if _G.table.count(pool) == 0 or curBattleIndex ~= 1 then
        return
    end

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    view:RegiestAwardOpen(function()
        local num = model:GetCurMultiple(curBattleIndex)
        local index = 0
        for i, v in ipairs(view.AllItemGoTable) do
            if pool[v.sid] then
                _G.PoolsManager:GetInstance():Spawn(
                    "UIH5/SecretRealm/SecretRealmWishTag",
                    _G.ePoolType.Temporary,
                    v.obj_item,
                    function(obj)
                        if _G.IsNil(v.obj_item) then
                            _G.DestroyObject(obj)
                            return
                        end
                        obj:SetLocalPosition(0, -40, 0)
                    end
                )
                index = index + 1
                if index >= num then
                    break
                end
            end
        end
    end)
end

---打开选buff的页面
function SettlementSecretRealm:OpenChooseBuff()
    local buffs = self.data.args
    if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SecretRealmSettlementView.Name,
            _G.handler(self, self.OnSettlementEndCallWithTransfor),
            buffs,
            self.auto
        )
    else
        --默认直接选buff并直接进入下一场战斗
        require("SecretRealmModel"):GetInstance():ChooseBuff(
            buffs[1],
            _G.handlerbind(self, self.OnSettlementEndCall)
        )
    end
end

---打开选择复活的页面
function SettlementSecretRealm:OpenChooseRevive()
    local model = require("SecretRealmModel"):GetInstance()
    if model:GetFreeReviveCount() > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1020005,
            nil,
            _G.handlerbind(self, self.OnChooseRevive, true),
            _G.handlerbind(self, self.OnChooseRevive, false)
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("没有付费复活UI界面, 无法进行选择")
        end
        self:OnChooseRevive(false)
    end
end

---选择复活结束回调
---@param revive boolean 是否选择复活
function SettlementSecretRealm:OnChooseRevive(revive)
    self.revive = revive
    if revive then
        local model = require("SecretRealmModel"):GetInstance()
        model:Revive(function(msg)
            if msg.ack ~= 1 then
                self.revive = false
                _G.PopWindowManager:GetInstance():ShowAllTips(msg.ack)
                --self:ShowAwardWithButtonView(false)
            else
                model:UpdateFreeReviveCount(-1)
                --self:OnSettlementEndCall()
            end
            self:OnSettlementEndCall()
        end)
    else
        --放弃复活
        self:ShowSettlementView(false)
    end
end

function SettlementSecretRealm:OnSettlementEndCallWithTransfor()
    ---@type SecretRealmBattleTransforView
    local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
        _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
    )
    if transforView then
        transforView:Show()
        transforView:SetAction(
            "zoom_out",
            _G.handlerbind(self, self.OnSettlementEndCall)
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
            "zoom_out",
            _G.handlerbind(self, self.OnSettlementEndCall)
        )
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSecretRealm:GetResult()
    return self.data and self.data.isWin
end

function SettlementSecretRealm:CloseFunWindow()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
    if view then
        view:Close()
    end
    _G.JumpManager:GetInstance():Jump(119001)
end

return SettlementSecretRealm
