---@class SettlementStarSoul : Singleton	中文描述
local SettlementStarSoul = _G.BaseClass("SettlementStarSoul", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementStarSoul:__init()
end

---销毁对象时,析构函数
function SettlementStarSoul:Dispose()
end

function SettlementStarSoul:ParseSettlementData(data)
    self.data = data
    self:ShowView(data)
end

function SettlementStarSoul:ShowView(tab)
    local result = {}
    if tab.winner[1] then
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = _data.winner[1]
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    if _data.winner then
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                    end
                end
            end
        )
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementStarSoul:GetResult()
    return self.data.winner[1]
end
function SettlementStarSoul:SettlementEnd()
    _G.BattleManager:GetInstance():DestroyBattle()
    if self:GetResult() then
        require "StarSoulModel":GetInstance():FightWin()
    end
end

return SettlementStarSoul
