---@class SettlementSociatyMaze : SettlementItemBase    公会-暗影迷宫结算
local SettlementSociatyMaze = _G.BaseClass("SettlementSociatyMaze", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementSociatyMaze:__init()
end

---销毁对象时,析构函数
function SettlementSociatyMaze:Dispose()
end

function SettlementSociatyMaze:ParseSettlementData(data, uid, grade, monsterId)
    self.data = data
    self.uid = uid
    self.grade = grade
    self.monsterId = monsterId
    self:ShowView()
end

function SettlementSociatyMaze:ShowView()
    local result = {}
    result.iSWin = self:GetResult()
    result.statistics = true
    result.btnDisplay = true
    result.autonextDisplay = false
    result.back = true

    if self.data then
        --接收奖励数据
        _G.StorageManager:GetInstance():ReceiveAwardData(self.data)
        result.AwardData = _G.StorageManager:GetInstance():MergeAward(self.data)
    end

    if result.iSWin then
        --挑战关卡信息
        local info = {
            uid = self.uid,
            grade = self.grade,
            monsterId = self.monsterId
        }
        self:OnShowView(_G.ConfigManager.ui_cfg.SociatyMazeBattleShowAwardView.Name, result, info)
    else
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementSociatyMaze:GetResult()
    return self.data and self.data.winner[1] or false
end

function SettlementSociatyMaze:SettlementEnd(id)
    require "SociatyMazeBattleModel":GetInstance():ReturnPanel(self:GetResult(), id)
end

return SettlementSociatyMaze
