---@class SettlementAllHeroesBattle	中文描述
local SettlementAllHeroesBattle = _G.BaseClass("SettlementAllHeroesBattle", _G.SettlementItemBase)

---类的构造函数
function SettlementAllHeroesBattle:__init()
end

---类的析构函数
function SettlementAllHeroesBattle:Dispose()
    self.result = nil
end

function SettlementAllHeroesBattle:ParseSettlementData(
    result,
    isTiaoGuo,
    endCall,
    statisticsData,
    fightArg,
    report_uid,
    enemyPlayer)
    self.endCall = endCall
    self.result = result
    self.isTiaoGuo = isTiaoGuo
    self.statisticsData = statisticsData
    self.isReport = statisticsData and true or false
    self.fightArg = fightArg
    ---战斗战报ID
    self.report_uid = report_uid
    ---敌方目标信息
    self.enemyPlayer = enemyPlayer
    self:ShowView()
end

function SettlementAllHeroesBattle:ShowView()
    local result = {iSWin = self.result, isTiaoGuo = self.isTiaoGuo, statistics = true, isReport = true}
    if self.report_uid then
        --分享战报
        result.reportType = 18
        result.re_uid = {self.report_uid}
        --对战人物信息
        result.otherInfo = self:GetShareEnemyInfo()
    end

    self:OnShowView(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        result,
        nil,
        self.statisticsData,
        1,
        self.fightArg and { self.fightArg } or nil
    )
end

function SettlementAllHeroesBattle:GetShareEnemyInfo()
    if not self.enemyPlayer then
        return
    end
    return {
        sid = self.enemyPlayer.sid,
        name = self.enemyPlayer.name,
        frame = self.enemyPlayer.frame,
        style = self.enemyPlayer.style
    }
end

function SettlementAllHeroesBattle:GetResult()
    return self.result
end

function SettlementAllHeroesBattle:SettlementEnd()
    if self.endCall then
        self.endCall()
    end
end

return SettlementAllHeroesBattle
