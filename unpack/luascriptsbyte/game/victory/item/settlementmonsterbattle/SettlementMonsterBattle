---@class SettlementMonsterBattle	中文描述
local SettlementMonsterBattle = _G.BaseClass("SettlementMonsterBattle", _G.SettlementItemBase)

---类的构造函数
function SettlementMonsterBattle:__init()
end

---类的析构函数
function SettlementMonsterBattle:Dispose()
end

function SettlementMonsterBattle:ParseSettlementData()
    self:ShowView()
end
function SettlementMonsterBattle:ShowView()
    local result = {}
    local function OnSelectSectionViewOpened()
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnSelectSectionViewOpened, self)
    end
    result.iSWin = true
    result.AwardData = self.CurSectionAward
    result.statistics = true
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    self:SettlementEnd()
end
function SettlementMonsterBattle:SettlementEnd()
    _G.WorldManager:GetInstance():EnterWorld(
        _G.PlayerModel:GetInstance():GetCurCitySid(),
        function()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SelectSectionMapView.Name)
        end
    )
end

return SettlementMonsterBattle
