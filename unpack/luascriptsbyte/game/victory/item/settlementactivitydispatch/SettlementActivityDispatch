---@class SettlementActivityDispatch    中文描述
local SettlementActivityDispatch = _G.BaseClass("SettlementActivityDispatch", _G.SettlementItemBase)

---类的构造函数
function SettlementActivityDispatch:__init()
end

---类的析构函数
function SettlementActivityDispatch:Dispose()
    self.result = nil
end

function SettlementActivityDispatch:ParseSettlementData(
    result)
    self.result = result
    self.fight_arg = result.fight_arg
    self:ShowView()
end

function SettlementActivityDispatch:ShowView()
    if self:GetResult() == false then
        local result = { iSWin = self.result.winner[1] or false, statistics = true, AwardData = _G.StorageManager:GetInstance():MergeAward(self.result) }
        local winTable = {}
        local data = _G.BattleManager:GetInstance():GetStatistics()
        local count = #data.FighterInfo
        if count < 3 then
            _G.BattleManager:GetInstance():SetStatisticsCached(nil)
            data = _G.BattleManager:GetInstance():GetStatistics()
            count = #data.FighterInfo
        end
        for i = 1, count do
            _G.table.insert(winTable, false)
        end
        result.winTable = winTable

        self:OnShowView(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            result,
            nil,
            nil,
            nil,
            self.fightArg
        )
    else
        local view = self:GetResult() and _G.ConfigManager.ui_cfg.ActivityDispatchBattleVictoryPanelView.Name
        self:OnShowView(view, self.result)
    end
end

function SettlementActivityDispatch:GetResult()
    return self.result.winner[1]
end

function SettlementActivityDispatch:SettlementEnd()
    if self.endCall then
        self.endCall()
    end
end

return SettlementActivityDispatch
