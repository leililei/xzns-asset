---@class SettlementRoomNormalBattle	中文描述
local SettlementRoomNormalBattle = _G.BaseClass("SettlementRoomNormalBattle", _G.SettlementItemBase)

---类的构造函数
function SettlementRoomNormalBattle:__init()
end

---类的析构函数
function SettlementRoomNormalBattle:Dispose()
end

function SettlementRoomNormalBattle:ParseSettlementData()
    self:ShowView()
end
function SettlementRoomNormalBattle:ShowView()
    local function OnDropViewOpened(self, name)
        if name == _G.ConfigManager.ui_cfg.DropTipNewView.Name then
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, OnDropViewOpened, self)
            self:SettlementEnd()
        end
    end
    OnDropViewOpened(self, _G.ConfigManager.ui_cfg.DropTipNewView.Name)
end

return SettlementRoomNormalBattle
