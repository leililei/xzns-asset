---@class SettlementFirstTestBoss : Singleton    中文描述
local SettlementFirstTestBoss = _G.BaseClass("SettlementFirstTestBoss", _G.SettlementItemBase)

---创建对象时,入口构造函数
function SettlementFirstTestBoss:__init()
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():AddListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

---销毁对象时,析构函数
function SettlementFirstTestBoss:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopRole, self.CloseFunWindow, self)
    _G.Events:GetInstance():RemoveListener(_G.eSettlementFail.DevelopEquip, self.CloseFunWindow, self)
end

function SettlementFirstTestBoss:ParseSettlementData(data, isNotWin, monsterGroupCfg, fightArg)
    self.data = data or {}
    self.isNotWin = isNotWin
    self.monsterGroupCfg = monsterGroupCfg
    self.fightArg = fightArg
    self:ShowView()
end

function SettlementFirstTestBoss:ShowView()
    if not self.isNotWin then
        local result = {}
        result.statistics = true
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = true
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    self.data.winner = _data.winner[1]
                    --分享战报
                    result.reportType = 17
                    --对战人物信息
                    result.otherInfo = self:GetShareEnemyInfo()

                    if _data.winner then
                        result.AwardData = _G.StorageManager:GetInstance():MergeAward(_data)
                        result.btnDisplay = false
                        self.awardItemData, self.extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        self.damage = _data.atk_dps
                        local lastMaxDps = require "FirstTestBossModel":GetInstance().infoData.all_dps
                        if self.damage then
                            require "FirstTestBossModel":GetInstance():UpdateDamages(self.damage)
                        end
                        self:OnShowView(
                            _G.ConfigManager.ui_cfg.FirstTestBossSelfShowAwardView.Name,
                            self.awardItemData,
                            self.extraAward,
                            nil,
                            _data.atk_dps,
                            lastMaxDps,
                            result,
                            self.fightArg and { self.fightArg } or nil
                        )
                        _G.Events:GetInstance():Broadcast(
                            _G.eSeasonTask.Action,
                            {_G.SeasonTaskID.SeasonBossDamage},
                            _data.atk_dps,
                            true
                        )
                        _G.Events:GetInstance():Broadcast(_G.eSeasonTask.Action, {_G.SeasonTaskID.SeasonBoss}, 1)
                    end
                end
            end
        )
    else
        self:OnShowView(
            _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
            false,
            nil,
            nil,
            nil,
            self.fightArg and { self.fightArg } or nil
        )
    end
end

---获取战报分享敌方信息
function SettlementFirstTestBoss:GetShareEnemyInfo()
    if not self.monsterGroupCfg then
        return nil
    end
    local monsterId
    for _, id in pairs(self.monsterGroupCfg.DefaultDefenserSids[1] or {}) do
        if id > 0 then
            monsterId = id
        end
    end
    if not monsterId then
        return nil
    end
    local monsterCfg = _G.ConfigManager.monster_cfg[monsterId]
    return {
        name = _G.GetLangPackValue(monsterCfg.Name),
        sid = monsterCfg.CardID,
        style = 0,
        frame = 0
    }
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementFirstTestBoss:GetResult()
    if self.isNotWin then
        return false
    end
    return true
end

---关闭功能界面
function SettlementFirstTestBoss:CloseFunWindow()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FirstTestBossView.Name)
    if view then
        view:Close()
    end
    view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SeasonView.Name)
    if view then
        view:Close()
    end
end

function SettlementFirstTestBoss:SettlementEnd()
    require "FirstTestBossModel":GetInstance():ReturnPanel(self:GetResult())
end

return SettlementFirstTestBoss
