---@class SettlementArenaFair	中文描述
local SettlementArenaFair = _G.BaseClass("SettlementArenaFair", _G.SettlementItemBase)

---类的构造函数
function SettlementArenaFair:__init()
end

---类的析构函数
function SettlementArenaFair:Dispose()
end

---解析结算数据
---@param data table 结算数据
function SettlementArenaFair:ParseSettlementData(resultMsg, enemy)
    self.result = resultMsg
    self.enemyInfo = enemy
    --分享战报
    if enemy then
        self.result.reportType = 5
        self.result.otherInfo = {
            name = enemy.name,
            sid = enemy.uid or 0,
            style = enemy.style or 0,
            frame = enemy.frame or 0
        }
    end
    self:ShowView()
end

function SettlementArenaFair:ShowView()
    local view =
        self:GetResult() and _G.ConfigManager.ui_cfg.ArenaBattleVictoryPanelView.Name or
        _G.ConfigManager.ui_cfg.ArenaBattleFailPanelView.Name
    self:OnShowView(_G.ConfigManager.ui_cfg.ArenaFairSettlementView.Name, self.result, self.enemyInfo)
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementArenaFair:GetResult()
    return self.result.winner == 0
end
return SettlementArenaFair
