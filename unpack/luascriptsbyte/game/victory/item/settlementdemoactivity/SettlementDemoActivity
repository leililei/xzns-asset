---@class SettlementDemoActivity	中文描述
local SettlementDemoActivity = _G.BaseClass("SettlementDemoActivity", _G.SettlementItemBase)

---类的构造函数
function SettlementDemoActivity:__init()
end

---类的析构函数
function SettlementDemoActivity:Dispose()
    self.data = nil
end

function SettlementDemoActivity:ParseSettlementData(data, activity)
    self.data = data
    self.activity = activity
    self:ShowView()
end
function SettlementDemoActivity:ShowView()
    local result = {}
    result.hidePetBtn = true
    if self:GetResult() then
        require("BattleNet"):GetInstance():NpcPVEFightResult(
            self.data,
            function(_data, error)
                result.iSWin = _data.winner[1]
                self.data.winner[1] = _data.winner[1]
                result.statistics = true
                if _G.string.IsNullOrEmpty(error) and _data.ack == 1 then
                    if _data.md5_error == "1" then
                        _G.PopWindowManager:GetInstance():ShowAllTips(44)
                        _G.BattleManager:GetInstance():SaveLogNew()
                    elseif _data.md5_error == "2" then
                        _G.BattleManager:GetInstance():SaveLogNew()
                    end
                    if _data.winner[1] then
                        self.activity:FightWin()
                        local award, extraAward = _G.StorageManager:GetInstance():MergeExtraAward(_data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(_data)
                        result.AwardData = award
                        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result, extraAward)
                    else
                        result.btnDisplay = true
                        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
                    end
                end
            end
        )
    else
        result.iSWin = false
        result.statistics = true
        self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, result)
    end
end

---获取战斗结果
---@return boolean 是否胜利
function SettlementDemoActivity:GetResult()
    return self.data.winner[1]
end

function SettlementDemoActivity:SettlementEnd(id)
    self.activity:ExitEmbattle()
    if self:GetResult() and self.activity:GetIndexWithSection(self.activity:GetCurFightSectionId()) >= 3 and not self.activity:CheckIsGet() then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.DemoView.Name)
        self.activity:OnEnterActivity()
    end
end

return SettlementDemoActivity
