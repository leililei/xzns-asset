---@class PlayerTreeNet : BaseGameNet	通信协议
local PlayerTreeNet = _G.BaseClass("PlayerTreeNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return PlayerTreeNet PlayerTreeNet
function PlayerTreeNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取启示之殿数据请求
---@param pbData table PB数据
---@param callback function 完成回调
function PlayerTreeNet:GetTreeData(callback)
    local item = _G.ConfigManager.net_map.game_grow_tree_port_get_grow_tree
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---启示之殿升级请求
---@param pbData table PB数据
---@param callback function 完成回调
function PlayerTreeNet:TreeUp(pbData, callback)
    local item = _G.ConfigManager.net_map.game_grow_tree_port_up_tree_lv
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---启示之殿重置请求
---@param pbData table PB数据
---@param callback function 完成回调
function PlayerTreeNet:ResetTree(pbData, callback)
    local item = _G.ConfigManager.net_map.game_grow_tree_port_reset_tree
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---查看成长点数请求
---@param pbData table PB数据
---@param callback function 完成回调
function PlayerTreeNet:SeekGrowPoint(callback)
    local item = _G.ConfigManager.net_map.game_grow_tree_port_get_grow_point
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---收取成长点数请求
---@param pbData table PB数据
---@param callback function 完成回调
function PlayerTreeNet:GetGrowPoint(callback)
    local item = _G.ConfigManager.net_map.game_grow_tree_port_recieve_grow_point
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function PlayerTreeNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type PlayerTreeNet
return PlayerTreeNet
