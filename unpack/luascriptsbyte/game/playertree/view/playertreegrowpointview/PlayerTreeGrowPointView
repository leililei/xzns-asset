---@class PlayerTreeGrowPointView : UIBaseView	中文描述
---@field public go_table PlayerTreeGrowPointView_GoTable GoTable
local PlayerTreeGrowPointView = _G.BaseClass("PlayerTreeGrowPointView", _G.UIBaseView)
local table
function PlayerTreeGrowPointView:Awake()
    table = _G.table
    self.GetPointListScrollerRect = nil
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function PlayerTreeGrowPointView:OnCreate()
    self.GrowPoint = require("PlayerTreeModel"):GetInstance():GetGrowPoint()
    self:OpenGrowPoint()
end

---界面的销毁函数
function PlayerTreeGrowPointView:OnDestroy()
    self.GrowPoint = nil
end

---按钮点击事件在这里派发
function PlayerTreeGrowPointView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_Done" then
        require("PlayerTreeModel"):GetInstance():GetGrowPointDone(
            function()
                self:Close()
            end
        )
    end
end

function PlayerTreeGrowPointView:OpenGrowPoint()
    local GrowPoint = self.GrowPoint
    local num = table.count(GrowPoint)
    self.GetPointListScrollerRect =
        self.go_table.scrollloopvectical_GetPointCard:GetComponentE(typeof(CS.UnityEngine.UI.ScrollRect))
    self.GetPointLayout = self.go_table.obj_Content:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup))
    if num <= 6 then
        self.GetPointListScrollerRect.vertical = false
        self.GetPointLayout.enabled = true
        self.GetPointLayout.padding.top = 60
    end
    self.go_table.scrollloopvectical_GetPointCard:InitItemData(
        num,
        _G.handlerbind(self, self.RefreshPointList)
    )
    local max = 0
    for _, v in pairs(GrowPoint) do
        max = max + v.num
    end
    self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.currency_type_cfg[_G.ResPropID.ProfPoint].icon)
    self.go_table.aortext_num.text = max
end

function PlayerTreeGrowPointView:RefreshPointList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    obj:SetName(x)
    local tb = {}
    tb = _G.GetAutoGoTable(obj)
    local data = self.GrowPoint[x]
    local _data
    if data then
        tb.obj_content:SetActiveE(1)
        tb.aorrawimage_TotalPoint:LoadImage(_G.ConfigManager.currency_type_cfg[_G.ResPropID.ProfPoint].icon)
        tb.aortext_TotalPointNum.text = "+" .. data.num
        _data = _G.StorageManager:GetInstance():GetMaxStarCardBySid(data.sid.sid)
        if not _data then
            ---@type Card CardData
            local Card = _G.CardData.New()
            Card:Parse({sid = data.sid.sid, uid = data.sid.uid})
            _data = Card
        end
        if tb.lua_Prop == nil then
            ---开始生成对象 并标记
            ---@type ItemCardAllView
            tb.lua_Prop = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_Root,
                function(tran)
                    tb.lua_Prop = tran
                    tran:ShowCardData(_data)
                end
            )
        else
            tb.lua_Prop:ShowCardData(_data)
        end
    end
end

return PlayerTreeGrowPointView