---@class PlayerTreeCardComponent : Component	中文描述
local PlayerTreeCardComponent = _G.BaseClass("PlayerTreeCardComponent", _G.Component)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function PlayerTreeCardComponent:OnCreate(trans, data)
    _G.Events:GetInstance():AddListener(_G.PlayerTreeBranchCardUp.playerTreeBranchCardUp, self.OnBranchUp, self)
    _G.Events:GetInstance():AddListener(_G.PlayerTreeBranchCardUp.close, self.OnBranchExchange, self)
    self.gameObject = trans.gameObject
    self.transform = trans
    self.go_table = _G.GetAutoGoTable(self.gameObject)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem2,
        self.go_table.trans_GameObject,
        _G.handlerbind(self, self.showItemHeadInfo, data)
    )
end

function PlayerTreeCardComponent:OnBranchUp()
    if self.item.go_table.aorrawimage_bg:GetActiveSelf() ~= 1 then
        if self.gameObject:GetActiveSelf() ~= 1 then
            return
        end
        if self.go_table.obj_cardUpEff:GetActiveSelf() == 1 then
            self.go_table.obj_cardUpEff:SetActiveE(0)
            self.go_table.obj_cardUpEff:SetActiveE(1)
        else
            self.go_table.obj_cardUpEff:SetActiveE(1)
        end
        _G.DelayDo(
            0.5,
            function()
                self.go_table.obj_cardUpEff:SetActiveE(0)
            end
        )
    end
end
function PlayerTreeCardComponent:OnBranchExchange()
    if self.gameObject:GetActiveSelf() ~= 1 then
        return
    end
    if self.go_table.obj_cardUpEff:GetActiveSelf() == 1 then
        self.go_table.obj_cardUpEff:SetActiveE(0)
    end
end
function PlayerTreeCardComponent:showItemHeadInfo(item, data)
    if item ~= nil then
        self.item = item
    else
        item = self.item
    end
    if self.item == nil then
        return
    end
    self.cardData = data
    self.cardData.isHave = data.isHave
    self.item:ShowCardData(self.cardData)
end
---销毁对象时,析构函数
function PlayerTreeCardComponent:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.PlayerTreeBranchCardUp.close, self.OnBranchExchange, self)
    _G.Events:GetInstance():RemoveListener(_G.PlayerTreeBranchCardUp.playerTreeBranchCardUp, self.OnBranchUp, self)
end

return PlayerTreeCardComponent
