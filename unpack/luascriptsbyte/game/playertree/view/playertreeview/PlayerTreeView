---点击职业升级界面按钮事件
function PlayerTreeView:OnClickProfUpView(go, IsOn)
    local name = go:GetName()
    if name == "@_aorbtn_Done" then
        if self.canLevel then
            self:PropUpDone()
        end
    elseif name == "@_aorbtn_ResetProf" then
        self:ShowResetView()
    end
end

---升级确认
function PlayerTreeView:PropUpDone()
    self:LevelUpCheck()
    local ids = {}
    for k, v in pairs(self.LevelList) do
        if v ~= 0 then
            local TreeData = require("PlayerTreeModel"):GetInstance():GetDataByID(k)

            if v > TreeData.lv then
                table.insert(ids, { id = k, up_level = v })
            end
        end
    end

    if #ids > 0 then
        require("PlayerTreeModel"):GetInstance():UpPlayerTree(
            ids,
            self.MaterialList,
            function()
                _G.AudioManager.PlayAudioByAudioCfgID(2011)
                _G.AudioManager.PlayAudioByAudioCfgID(2056)
                self:ShowLvUpEffect()
                _G.Events:GetInstance():Broadcast(_G.PlayerTreeBranchCardUp.playerTreeBranchCardUp)
                if self.CurProf == _G.PlayerTreeID.mainTree then
                    self:MainProfClick(self.CurProf, true)
                else
                    self:ProfClick(self.CurProf, true)
                end
                self:Init()
            end
        )
    else
        local cfg = require("PlayerTreeModel"):GetInstance():GetTreeLvCfg(self.CurProf, 1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, cfg.material[1])
    end
end

