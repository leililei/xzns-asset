function PlayerTreeView:Awake()
    self.canLevel = true
    self.UnlockBranch = false
    self.SkillOff = _G.Color.New(87 / 255, 87 / 255, 87 / 255, 1)
    self.SkillOn = _G.Color.New(1, 1, 1, 1)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ProfUpView = _G.GetAutoGoTable(self.go_table.obj_ProfUpView, _G.handler(self, self.OnClickProfUpView))
    self.MainAnim = self.ProfUpView.obj_Main:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.BranchAnim = self.ProfUpView.obj_Branch:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    if self.IsFirst == nil or self.IsFirst == true then
        self.ProfUpView.looplist2_CardList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = false
    end
    self.ParticalClip = self.ProfUpView.looplist2_CardList:GetComponentE(_G.typeof(_G.CS.ParticleClipRect))
    _G.SortList(
        AttrType,
        function(a)
            return -a.sortid
        end
    )
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.SkillLevelUp, self.LevelUpOver, self)
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.SkillUnlock, self.UnlockSkill, self)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_PlayerTreeView_bg, self.go_table.obj_effect)
end

