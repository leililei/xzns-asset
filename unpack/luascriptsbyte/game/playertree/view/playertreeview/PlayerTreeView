---设置技能
function PlayerTreeView:SetSkill(BranchData, playEff, UnlockEff)
    local count = #BranchData.cfg.skills
    local skills = _G.ConfigManager.prof_tree_level_cfg[100000 + BranchData.cfg.id * 1000 + BranchData.lv]
    local lastSkills = _G.ConfigManager.prof_tree_level_cfg[100000 + BranchData.cfg.id * 1000 + BranchData.lv - 1]
    local obj
    local isLock = false
    for i = 1, 4 do
        --ZHJH-6110隐藏职业技能显示
        self.ProfUpView["obj_skill" .. i]:SetActiveE(0)
        if i > count then
            self.ProfUpView["obj_skill" .. i]:SetActiveE(0)
        else
            if not skills and BranchData.cfg.skills[i] then
                isLock = true
                obj =
                    self:SkillInfo(
                        self.ProfUpView["obj_skill" .. i],
                        BranchData.cfg.skills[i],
                        isLock,
                        playEff,
                        UnlockEff
                    )
            elseif skills.skills and not skills.skills[i] and BranchData.cfg.skills[i] then
                isLock = true
                obj =
                    self:SkillInfo(
                        self.ProfUpView["obj_skill" .. i],
                        BranchData.cfg.skills[i],
                        isLock,
                        playEff,
                        UnlockEff
                    )
            else
                obj =
                    self:SkillInfo(
                        self.ProfUpView["obj_skill" .. i],
                        skills.skills[i],
                        isLock,
                        playEff,
                        UnlockEff,
                        skills.skills[i] ~= lastSkills.skills[i]
                    )
            end
        end
    end
end

---@param isLock boolean 是否解锁
function PlayerTreeView:SkillInfo(obj, skillID, isLock, playEff, UnlockEff, isUp)
    local isShow = false
    if skillID > 0 then
        isShow = true
    else
        skillID = _G.math.abs(skillID)
    end
    local go_table = _G.GetAutoGoTable(obj)
    go_table.sid = skillID
    go_table.lock = isLock
    if go_table == nil then
        return
    end
    if go_table.obj_unlockEff:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(go_table.obj_unlockEff:GetChildE(0), _G.ePoolType.UIEffect)
    end
    if go_table.SkillClick == nil then
        go_table.aorbtn_skill.onClick:AddListener(_G.handlerbind(self, self.OnClickSkillItem, go_table))
        go_table.SkillClick = true
    end

    local nowskillCfg = _G.ConfigManager.card_skills_cfg[skillID]
    if nowskillCfg == nil then
        _G.GameUtil.SetActiveByCondition(go_table.gameObject:GetParent(), false)
        return
    end
    if nowskillCfg then
        -- if string.IsNullOrEmpty(nowskillCfg.skill_type) == false then
        -- require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skilltype, nowskillCfg.skill_type)
        -- end
        --图标

        ---先设置技能是否灰
        --等级
        -- if not self.curLev then
        --     self.curLev = 0
        -- end
        if isUp and playEff then
            --- 取消了展示的特效 此参数失去意义
            -- self.canLevel = false
            if go_table.obj_skillUp:GetActiveSelf() == 1 then
                go_table.obj_skillUp:SetActiveE(0)
                go_table.obj_skillUp:SetActiveE(1)
            else
                go_table.obj_skillUp:SetActiveE(1)
            end
        end
        --等级显示
        _G.GameUtil.SetActiveByCondition(go_table.aorimage_skilllevel, not go_table.lock)
        -- --有该技能才显示技能图标
        _G.GameUtil.SetActiveByCondition(go_table.gameObject:GetParent(), true)
        self.curLev = nowskillCfg.level
        go_table.Anim = go_table.obj_skilllock:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        go_table.Anim.enabled = false
        local icon = go_table.obj_skilllock:GetChildE(0)
        go_table.obj_skilllock:SetLocalScaleXYZ(1, 1, 1)
        go_table.obj_skilllock:SetLocalRotation(0, 0, 0)
        local image = icon:GetComponentE(_G.typeof(_G.CS.AorImage))
        image.Alpha = 1
        if go_table.obj_skilllock:GetActiveSelf() == 1 and not go_table.lock and UnlockEff then
            --self:UnlockSkill(go_table,nowskillCfg)
            -- self.canLevel = false
            --_G.UIUtils.LoadEffectByCfg(
            --    _G.ConfigManager.ui_effect_cfg.ef_jinengjiesuo,
            --    go_table.obj_unlockEff,
            --    function()
            --        -- self.curTable = go_table
            --        -- self.curSkillCfg = nowskillCfg
            --        -- go_table.Anim.enabled = true
            --    end,
            --    nil
            --)
            self.curTable = go_table
            self.curSkillCfg = nowskillCfg
            go_table.Anim.enabled = true
            self:LevelUpOver()
            go_table.obj_skilllock:SetActiveE(go_table.lock and 1 or 0)
            go_table.aorrawimage_skill.color = go_table.lock ~= false and self.SkillOff or self.SkillOn
        else
            --锁隐藏
            go_table.obj_skilllock:SetActiveE(go_table.lock and 1 or 0)
            go_table.aorrawimage_skill.color = go_table.lock ~= false and self.SkillOff or self.SkillOn
            go_table.aorrawimage_skill.Alpha = 0
            require("CardInfoManager").LoadRawImage(go_table.aorrawimage_skill, nowskillCfg.icon)
            go_table.aortext_skilllevel.text = self.curLev
            go_table.aorrawimage_skilltype.Alpha = 0
            go_table.aorimage_nuqi:SetActiveE(nowskillCfg.skill_pos == 1 and 1 or 0)
        end
    else
        isShow = false
        ---设置技能是否灰
        go_table.aorrawimage_skill.color = isShow == false and self.SkillOff or self.SkillOn
    end

    return go_table.gameObject
end

