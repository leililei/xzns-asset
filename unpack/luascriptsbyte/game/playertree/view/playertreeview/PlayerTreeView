                after = math.floor(after * 100)
                if cfg then
                    before = math.floor(before / 100)
                end
            end
            if _G.AppSetting.IsXzns then
                before = _G.GameUtil.NumberWY(before)
                after = _G.GameUtil.NumberWY(after)
            end
            self.Prop[i].aortext_AfterNum.text = after .. (v.percentage == 1 and "%" or "")
            if before == 0 then
                self.Prop[i].aortext_BeforeNum.text = ""
                self.Prop[i].aorimage_jia:SetActiveE(0)
            else
                -- if playEff then
                --     if self.PropEff[i] then
                --         _G.PoolsManager:GetInstance():Despawn(self.PropEff[i].gameObject, _G.ePoolType.UIEffect)
                --     end
