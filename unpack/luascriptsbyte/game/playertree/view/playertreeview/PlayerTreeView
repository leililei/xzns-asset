---刷新强化界面卡牌列表
function PlayerTreeView:UpdateCards()
    self.CardUidList = {}
    self.GetCardList = {}
    --已拥有
    self.DisGetCardList = {}
    --未拥有
    for i, v in pairs(_G.ConfigManager.card_cfg) do
        if v.UnitType <= 2 and v.is_put_into then
            if v.Professional == self.CurProf then
                if self.Cards[i] ~= nil then
                    table.insert(self.GetCardList, i)
                else
                    table.insert(self.DisGetCardList, i)
                end
            end
        end
    end

    if #self.GetCardList > 0 then
        table.sort(
            self.GetCardList,
            function(a, b)
                if self.Cards[a].star > self.Cards[b].star then
                    return true
                elseif self.Cards[a].star == self.Cards[b].star then
                    if self.Cards[a].power > self.Cards[b].power then
                        return true
                    else
                        return false
                    end
                else
                    return false
                end
            end
        )
    end
    if #self.DisGetCardList > 0 then
        table.sort(
            self.DisGetCardList,
            function(a, b)
                if _G.ConfigManager.card_cfg[a].Star > _G.ConfigManager.card_cfg[b].Star then
                    return true
                elseif _G.ConfigManager.card_cfg[a].Star == _G.ConfigManager.card_cfg[b].Star then
                    if a > b then
                        return true
                    else
                        return false
                    end
                else
                    return false
                end
            end
        )
    end
    _G.table.insertto(self.GetCardList, self.DisGetCardList)

    local CardList = {}
    for i, v in pairs(self.GetCardList) do
        local cfg = _G.ConfigManager.illustrations_card_cfg[v]

        if not _G.IsNil(cfg) then
            if not _G.IsNil(cfg.condition_type) and _G.GlobalConditionManager.CheckConditionByArray(cfg.condition_type) then
                table.insert(CardList, v)
            elseif _G.IsNil(cfg.condition_type) then
                table.insert(CardList, v)
            end
        else
            -- _G.LogError("查不到的配置" .. v)
        end
    end

    self.CardUidList = CardList
    if #self.CardUidList == self.count then
        self.ProfUpView.looplist2_CardList:RefreshAllShownItem()
    else
        self.ProfUpView.looplist2_CardList:SetListItemCount(#self.CardUidList, true)
    end

    self.count = #self.CardUidList
    -- if self.count > 4 then
    --     self.ProfUpView.aorimage_NextCard:SetActiveE(1)
    -- else
    --     self.ProfUpView.aorimage_NextCard:SetActiveE(0)
    -- end
end

function PlayerTreeView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local list = self.Cards
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local goTable = _G.GetAutoGoTable(item)
    local x = index + 1
    item:SetName(x)
    item:SetLocalScaleXYZ(1.2)
    local data = {}
    data = list[self.CardUidList[x]]
    if data == nil then
        data = _G.StorageManager:GetInstance():GetItemDataClass(self.CardUidList[x], 1)
        data.isHave = false
    else
        data.isHave = true
    end
    local tb_i = self:GetComponent(item.gameObject, PlayerTreeCardComponent)
    if tb_i == nil then
        self:AddComponent(item.gameObject, PlayerTreeCardComponent.New(item, data))
    else
        tb_i:showItemHeadInfo(nil, data)
    end
    self.ParticalClip.enabled = false
    self.ParticalClip.enabled = true
    return item
end

