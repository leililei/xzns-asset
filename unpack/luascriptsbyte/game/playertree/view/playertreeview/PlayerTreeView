function PlayerTreeView:GetNextLevel(type, level)
    local cfg = require("PlayerTreeModel"):GetInstance():GetTreeLvCfg(type, self.LevelList[type] + 1)

    if cfg ~= nil then
        if self.MaterialList[cfg.material[1]] == nil then
            self.MaterialList[cfg.material[1]] = 0
        end
    else
        return
    end
    local _, storageId = _G.StorageManager:GetInstance():CheckSidType(cfg.material[1])
    local num = _G.StorageManager:GetInstance():GetItemCountByID(storageId, cfg.material[1])

    -- 如果当前已拥有数量大于需求 递归
    if num >= self.MaterialList[cfg.material[1]] + cfg.material[2] then
        self.MaterialList[cfg.material[1]] = cfg.material[2] + self.MaterialList[cfg.material[1]]
        self.LevelList[type] = self.LevelList[type] + 1
        self:GetNextLevel(type, level)
    else
        return
    end
end

function PlayerTreeView:LevelUpCheck()
    local MainTreeData = require("PlayerTreeModel"):GetInstance():GetDataByID(_G.PlayerTreeID.mainTree)
    local materialIDList = { _G.PlayerTreeID.mainTree, _G.PlayerTreeID.tank, _G.PlayerTreeID.warrior,
        _G.PlayerTreeID.master, _G.PlayerTreeID.support, _G.PlayerTreeID.ranger }

    self.MaterialList = {}
    self.LevelList = {}
    -- 先算初始
    self.LevelList[materialIDList[1]] = MainTreeData.lv
    self:GetNextLevel(materialIDList[1])
    for i = 1, #materialIDList do
        if i > 1 then
            if self.LevelList[materialIDList[1]] >= 10 then
                local TreeData = require("PlayerTreeModel"):GetInstance():GetDataByID(materialIDList[i])
                self.LevelList[materialIDList[i]] = TreeData.lv
                self:GetNextLevel(materialIDList[i])
            end
        end
    end
end

