function PlayerTreeView:ShowUnlockEff()
    _G.AudioManager.PlayAudioByAudioCfgID(2010)
    self.go_table.obj_Mask:SetActiveE(1)
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
    for _, v in pairs(self.BranchTree) do
        v.trans_Name:SetParentE(nil)
        v.trans_Name:SetActiveE(0)
    end
    self.go_table.obj_MainView:SetActiveE(0)
    if self.Ball and not _G.IsNil(self.Ball) then
        _G.PoolsManager:GetInstance():Despawn(self.Ball, _G.ePoolType.Temporary)
        self.Ball = nil
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.PlayerTreeUnlockEff,
        self.Scene,
        function()
        end,
        function()
            if self.Ball and not _G.IsNil(self.Ball) then
                _G.PoolsManager:GetInstance():Despawn(self.Ball, _G.ePoolType.Temporary)
                self.Ball = nil
            end
            _G.PoolsManager:GetInstance():Spawn(
                _G.ConfigManager.ui_effect_cfg[SubTreeActivePath].Path,
                _G.ePoolType.Temporary,
                nil,
                _G.handlerbind(self, self.InitPos, 2)
            )
            self:Init()
            for _, v in pairs(self.BranchTree) do
                v.trans_Name:SetActiveE(1)
            end
            self.go_table.obj_MainView:SetActiveE(1)
            self.go_table.obj_Mask:SetActiveE(0)
        end
    )
end

