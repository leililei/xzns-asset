                --         function(tran)
                --             self.PropEff[i] = tran
                --         end,
                --         function()
                --         end
                --     )
                -- end
                self.Prop[i].aortext_BeforeNum.text = "+" .. before .. ((v.percentage == 1 and cfg) and "%" or "")
                self.Prop[i].aorimage_jia:SetActiveE(1)
            end
            i = i + 1
        end
    end
    for n = i, 4 do
        self.Prop[n].gameObject:SetActiveE(0)
    end
    if cfg == nil then
        self.ProfUpView.obj_Material:SetActiveE(0)
    else
