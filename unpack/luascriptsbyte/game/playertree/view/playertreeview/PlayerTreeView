function PlayerTreeView:InitToggle()
    self.toggles = {
        tree = _G.GetAutoGoTable(
            self.go_table.toggle_tree,
            _G.handlerbind(self, self.OnClickToggle, "tree", _G.handler(self, self.OnTree))
        ),
        inherit = _G.GetAutoGoTable(
            self.go_table.toggle_inherit,
            _G.handlerbind(self, self.OnClickToggle, "inherit", _G.handler(self, self.OnInherit))
        )
    }
end

function PlayerTreeView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function PlayerTreeView:OnTree(isOn)
    self.go_table.obj_tree:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
end

function PlayerTreeView:OnInherit(isOn)
    self.go_table.obj_inherit:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.panelLua.inherit then
        self.panelLua.inherit = true
        _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs.inherit,
            _G.ePoolType.UIItem,
            self.go_table.obj_inherit,
            function(trans)
                self.panelLua.inherit = self:AddComponent(trans, require(PanelLuaFile.inherit).New(trans))
            end
        )
    end
end

