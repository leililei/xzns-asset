--region 重写父类方法
------获取关卡信息
function PlayerTreeModel:GetDataFormServer()
    PlayerTreeNet:GetInstance():GetTreeData(
        function(data)
            self:ParseData(data)
        end
    )
end

function PlayerTreeModel:ParseData(data)
    if data.ack ~= 1 then
        return
    end
    for _, v in pairs(data.trees) do
        if self.MainTree[v.g_id] ~= nil then
            self.MainTree[v.g_id].lv = v.lv
            self.MainTree[v.g_id].changeType = {}
        else
            self.Branch[v.g_id].lv = v.lv
            self.Branch[v.g_id].changeType = {}
        end
    end
    local cfg = self:GetTreeLvCfg(_G.PlayerTreeID.mainTree, self.MainTree[_G.PlayerTreeID.mainTree].lv)

    local percentReckon = 0.0001

    if cfg ~= nil then
        for i, v in pairs(_G.AttrType) do
            if cfg[i] ~= nil then
                local _value = cfg[i]
                if v.percentage == 0 then
                elseif v.percentage == 1 then
                    if _value ~= nil then
                        _value = _value * percentReckon
                    end
                end

                self.MainTree[_G.PlayerTreeID.mainTree].data:SetValueByName(i, _value, false, _G.AttCountType.other)
                table.insert(self.MainTree[_G.PlayerTreeID.mainTree].changeType, v)
            end
        end
    end
    for key, value in pairs(self.Branch) do
        cfg = self:GetTreeLvCfg(key, value.lv)
        if cfg ~= nil then
            for i, v in pairs(_G.AttrType) do
                if cfg[i] ~= nil then
                    local _value = cfg[i]
                    if v.percentage == 0 then
                    elseif v.percentage == 1 then
                        if _value ~= nil then
                            _value = _value * percentReckon
                        end
                    end
                    self.Branch[key].data:SetValueByName(i, _value, false, _G.AttCountType.other)
                    table.insert(self.Branch[key].changeType, v)
                end
            end
        end
    end
    self:GetGrowPointInServer(
        function()
            self.super.ParseData(self)
        end
    )
end

