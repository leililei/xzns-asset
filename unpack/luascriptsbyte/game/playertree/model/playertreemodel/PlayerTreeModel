    self.curFunctionOpenID = 3
end

---初始化功能逻辑
function PlayerTreeModel:InitFunction()
    local FunctionManagerIns = _G.FunctionManager:GetInstance()
    if not FunctionManagerIns:CheckFunctionIsUnlock(self.curFunctionOpenID) then
        _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpen, self)
    end
end

function PlayerTreeModel:OnFunctionOpen(id)
    if id == self.curFunctionOpenID then
        _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpen, self)
        self:GetGrow()
    end
end

---类的析构函数
function PlayerTreeModel:Dispose()
    self.MainTree = nil
    self.GrowPointData = nil
    self.curFunctionOpenID = nil
    self.Branch = nil
end

---从服务器获取可领取的成长点数
function PlayerTreeModel:GetGrowPointInServer(call)
    PlayerTreeNet:GetInstance():SeekGrowPoint(
        function(data)
            self.GrowPointData = data.point
            if call ~= nil then
                call(self:GetGrowPoint())
            end
        end
    )
end

---成长星辉红点
function PlayerTreeModel:CheckRedPointGetGrowPoint()
    local cfg = self:GetMainTreeLvCfgBySid()
    local needCount = cfg.material[2]
    local growPoint = self:GetRedGrowPoint()
    if growPoint and #growPoint > 0 then
        local getCount = 0
        for i = 1, #growPoint do
            getCount = growPoint[i].num + getCount
        end
        return getCount >= needCount
    else
        return false
    end
end

---获取成长星辉 外部方法
function PlayerTreeModel:GetGrow()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        self:GetGrowPointInServer(self.RefreshGrowRedPoint)
    end
end

function PlayerTreeModel:RefreshGrowRedPoint()
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Playtree.id)
end

---获取可领取的成长点数(对外接口)
function PlayerTreeModel:GetGrowPoint()
    local GrowDatas = {}
    if not self.GrowPointData then
        return nil
    end
    for i, v in pairs(self.GrowPointData) do
        GrowDatas[i] = {}
        GrowDatas[i].sid = _G.StorageManager:GetInstance():GetItemDataClass(v.sid)
        GrowDatas[i].num = v.num
    end
    return GrowDatas
end

---获取可领取的成长点数(对外接口)
function PlayerTreeModel:GetRedGrowPoint()
    local GrowDatas = {}
    if not self.GrowPointData then
        return nil
    end
    for i, v in pairs(self.GrowPointData) do
        GrowDatas[i] = {}
        GrowDatas[i].num = v.num
    end
    return GrowDatas
end

---检测分支是否开放
function PlayerTreeModel:CheckBranchTreeIsOpen()
    local BranchLv = _G.ConfigManager.discrete_cfg[DiscreteID.BranchOpenLv][1][1]
    return BranchLv <= self.MainTree[_G.PlayerTreeID.mainTree].lv
end

---启示之殿升级
function PlayerTreeModel:UpPlayerTree(sid, MaterialList, call)
    local msg = {}
    msg.ids = sid
    PlayerTreeNet:GetInstance():TreeUp(msg, _G.handlerbind(self, self.UpPlayerTreeSuc, sid, MaterialList, call))
end

---启示之殿升级返回
function PlayerTreeModel:UpPlayerTreeSuc(data, sids, material, call)
    if data.ack ~= 1 then
        return
    end
    for k, v in pairs(material) do
        _G.StorageManager:GetInstance():ConsumeItem(k, 0, v)
    end

    local cfg

    local percentReckon = 0.0001
    local lv = 0

    for i = 1, #sids do
        local sid = sids[i].id
        local up_level = sids[i].up_level
        if self.MainTree[sid] ~= nil then
            self.MainTree[sid].lv = up_level
            lv = self.MainTree[sid].lv
            self.MainTree[sid].changeType = {}
            cfg = self:GetTreeLvCfg(sid, self.MainTree[sid].lv)
            for i, v in pairs(_G.AttrType) do
                if cfg[i] ~= nil and cfg[i] > 0 then
                    local _value = cfg[i]
                    if v.percentage == 0 then
                    elseif v.percentage == 1 then
                        if _value ~= nil then
                            _value = _value * percentReckon
                        end
                    end
                    self.MainTree[sid].data:SetValueByName(i, _value, false, _G.AttCountType.other)
                    table.insert(self.MainTree[sid].changeType, v)
                end
            end

            require "PopUpGiftBagModel":GetInstance():IsStarCompass(cfg.id)
        elseif self.Branch[sid] ~= nil then
            self.Branch[sid].lv = up_level
            lv = self.Branch[sid].lv
            self.Branch[sid].changeType = {}
            cfg = self:GetTreeLvCfg(sid, self.Branch[sid].lv)
            for i, v in pairs(_G.AttrType) do
                if cfg[i] ~= nil and cfg[i] > 0 then
                    local _value = cfg[i]
                    if v.percentage == 0 then
                    elseif v.percentage == 1 then
                        if _value ~= nil then
                            _value = _value * percentReckon
                        end
                    end
                    self.Branch[sid].data:SetValueByName(i, _value, false, _G.AttCountType.other)
                    table.insert(self.Branch[sid].changeType, v)
                end
            end
        end

        --region --------------------------------------任务广播 星河罗盘 不同池子(0:任意) 达到N级--------
        ---标记  (上面用到了该字段 修改时注意)
        lv = lv

        ----广播该池升级
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.PlayerTree.BranchLv,
                sid,
                lv
            },
            1,
            false,
            true
        )

        ----广播  通用 升级
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.PlayerTree.BranchLv,
                _G.PlayerTreeID.none,
                lv
            },
            1,
            false,
            true
        )
        --endregion------------------------------------任务广播 星河罗盘 不同池子(0:任意) 达到N级--------
    end

    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    ---主罗盘全刷，职业罗盘按职业筛选刷
    -- if sid == 9 then
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Tree)
    -- else
    _G.StorageManager:GetInstance():UpdateCardPropByProfessional(sid, _G.AttrFunType.Tree)
    -- end
    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(power, offset)
    end

    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.Playtreeprofessional.id
    )
    -- _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
    if call ~= nil then
        call()
    end
end

---启示之殿重置
function PlayerTreeModel:ResetProf(sid, call)
    local cfg = _G.ConfigManager.discrete_cfg[100803]
    if not _G.StorageManager:GetInstance():CheckItem(cfg[1][1], cfg[1][2]) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, cfg[1][1])
        return
    end
    local materila = self:GetResetReturnMaterial(sid)
    local msg = { id = sid }
    PlayerTreeNet:GetInstance():ResetTree(msg, _G.handlerbind(self, self.ResetProfSuc, sid, call))
end

---启示之殿重置返回
function PlayerTreeModel:ResetProfSuc(data, sid, call)
    if data.ack ~= 1 then
        return
    end
    for i, _ in pairs(_G.AttrType) do
        self.Branch[sid].data:OnInit()
    end
    self.Branch[sid].lv = 0
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    local cfg = _G.ConfigManager.discrete_cfg[100803]
    _G.StorageManager:GetInstance():ConsumeItem(cfg[1][1], 0, cfg[1][2])
    if call ~= nil then
        call()
    end
end

---收取成长点数
function PlayerTreeModel:GetGrowPointDone(call)
    PlayerTreeNet:GetInstance():GetGrowPoint(
        function(data)
            if data.ack ~= 1 then
                return
            end
            self.GrowPointData = {}
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            if call ~= nil then
                call()
            end
        end
    )
end

---获取根据职业属性获取不同的加成
function PlayerTreeModel:GetGrowProp(prof, mainLv, branchLv)
    local data = self.MainTree[_G.PlayerTreeID.mainTree].data
    local changeType = {}
    local changeType1 = self.MainTree[_G.PlayerTreeID.mainTree].changeType
    data.elementsType = 1
    local data2 = self.Branch[prof].data
    local changeType2 = self.Branch[prof].changeType
    for i = 1, #changeType1 do
        table.insert(changeType, changeType1[i])
    end
    if changeType2 then
        for i = 1, #changeType2 do
            if false == table.indexof(changeType, changeType2[i]) then
                table.insert(changeType, changeType2[i])
            end
        end
    end
    if mainLv then
        data = _G.DeepCopy(data)
        data.lv = mainLv
    end
    if branchLv then
        data2 = _G.DeepCopy(data2)
        data2.lv = branchLv
    end
    local attr = _G.AttributeClassManager:GetInstance():AddAttributeByNew(data, data2, true)
    return attr, changeType
end

---根据ID获取数据
function PlayerTreeModel:GetDataByID(ID)
    if self.MainTree[ID] ~= nil then
        return self.MainTree[ID]
    elseif self.Branch[ID] ~= nil then
        return self.Branch[ID]
    else
        return self.Branch
    end
end

----获取指定池当前等级(任务检测)
function PlayerTreeModel:GetLv(PlayerTreeID)
    local data
    if PlayerTreeID == _G.PlayerTreeID.mainTree then
        data = self.MainTree[PlayerTreeID]
    else
        data = self.Branch[PlayerTreeID]
    end
    if data and data.lv then
        return data.lv
    end
    return 0
end

----获取任意池最大等级(任务检测)
function PlayerTreeModel:GetMaxLv()
    local lv = self.MainTree[_G.PlayerTreeID.mainTree].lv

    for key, value in pairs(self.Branch) do
        if value.lv > lv then
            lv = value.lv
        end
    end
    return lv
end

---通过sid和等级得到配置表
function PlayerTreeModel:GetTreeLvCfg(sid, lv)
    local cfg = _G.ConfigManager.prof_tree_level_cfg
    return lv > 0 and cfg[100000 + sid * 1000 + lv] or nil
end

---获得主池下一等级配置表
function PlayerTreeModel:GetMainTreeLvCfgBySid()
    local cfg =
        _G.ConfigManager.prof_tree_level_cfg[
        100000 + _G.PlayerTreeID.mainTree * 1000 + self.MainTree[_G.PlayerTreeID.mainTree].lv + 1
        ]
    if not cfg then
        cfg =
            _G.ConfigManager.prof_tree_level_cfg[
            100000 + _G.PlayerTreeID.mainTree * 1000 + self.MainTree[_G.PlayerTreeID.mainTree].lv
            ]
    end
    return cfg
end

---获取职业重置能得到的所有材料
function PlayerTreeModel:GetResetReturnMaterial(ID)
    local BranchData = self.Branch[ID]
    local lv = BranchData.lv
    local id = 100000 + ID * 1000
    local Material
    local cfg
    while lv > 0 do
        cfg = _G.ConfigManager.prof_tree_level_cfg[id + lv]
        if Material == nil then
            Material = cfg.material[2]
        else
            Material = Material + cfg.material[2]
        end
        lv = lv - 1
    end
    return Material or 0
end

