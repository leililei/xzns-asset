        [_G.PlayerTreeID.mainTree] = {
            lv = 0,
            data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(),
            cfg = _G.ConfigManager.prof_tree_cfg[_G.PlayerTreeID.mainTree],
            changeType = {}
        }
    }
    self.Branch = {
        [_G.PlayerTreeID.tank] = {
            lv = 0,
            data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(),
            cfg = _G.ConfigManager.prof_tree_cfg[_G.PlayerTreeID.tank],
            changeType = {}
        },
        [_G.PlayerTreeID.warrior] = {
            lv = 0,
            data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(),
            cfg = _G.ConfigManager.prof_tree_cfg[_G.PlayerTreeID.warrior],
            changeType = {}
        },
        [_G.PlayerTreeID.master] = {
            lv = 0,
            data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(),
            cfg = _G.ConfigManager.prof_tree_cfg[_G.PlayerTreeID.master],
            changeType = {}
        },
        [_G.PlayerTreeID.support] = {
            lv = 0,
            data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(),
            cfg = _G.ConfigManager.prof_tree_cfg[_G.PlayerTreeID.support],
            changeType = {}
        },
        [_G.PlayerTreeID.ranger] = {
            lv = 0,
            data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(),
            cfg = _G.ConfigManager.prof_tree_cfg[_G.PlayerTreeID.ranger],
            changeType = {}
        }
    }
