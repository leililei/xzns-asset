---设置任务进度
function BathhouseGiftCumulativeAwardsView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (186) or 0, 14)
end

function BathhouseGiftCumulativeAwardsView:SortTask()
    ---@param data DrawUpBattlePassTaskData
    _G.SortList(
        self.taskDatas,
        function(data)
            local index = 1
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                index = 2
                if self.activityCls:CheckIsGet(data.i_task.sid) then
                    index = -1
                end
            end
            return index, -data.i_task.sid
        end
    )
end

function BathhouseGiftCumulativeAwardsView:OnDisable()
    self.needRefresh = true
end

function BathhouseGiftCumulativeAwardsView:OnEnable()
    if self.needRefresh then
        self.needRefresh = nil
        self:RefreshTask()
    end
end


---界面的销毁函数
function BathhouseGiftCumulativeAwardsView:OnDestroy()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

---按钮点击事件在这里派发
function BathhouseGiftCumulativeAwardsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_left then
        self.curIndex = self.curIndex - 1
        self:RefreshTaskIndex()
    elseif go == self.go_table.aorbtn_right then
        self.curIndex = self.curIndex + 1
        self:RefreshTaskIndex()
    end
end

return BathhouseGiftCumulativeAwardsView
