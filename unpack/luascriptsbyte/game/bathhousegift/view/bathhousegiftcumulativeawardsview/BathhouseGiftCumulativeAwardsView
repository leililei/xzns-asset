---构造函数
---@protected
function BathhouseGiftCumulativeAwardsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask, self.RefreshTask)
end

---界面的入口函数
function BathhouseGiftCumulativeAwardsView:OnCreate(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.curIndex = 1
    self.isInited = false
    self:RefreshTask()
    self.isInited = true
    self.subType = self.activity:GetJumpType()

    --倒计时
    self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    if self.Timer == nil then
        self:UpdateTime()
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.Timer:Start()
    end
end

function BathhouseGiftCumulativeAwardsView:UpdateTime()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
        if view1 then
            view1:Close()
        end
        return
    end
    local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, "<color=#3EA469>" .. str .. "</color>")
end

