---任务刷新
function BathhouseGiftCumulativeAwardsView:RefreshTask()
    self.taskDatas = self.activityCls:GetTaskListByPage(1)
    self:SortTask()
    self:RefreshTaskIndex()
    self:RefreshTaskItem2()
    self:UpdateProgress()
end

function BathhouseGiftCumulativeAwardsView:RefreshProgress(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local needNum = self.progressList[index]
    local showRight = false
    if self.progressList[index + 1] then
        showRight = self.buyNum >= self.progressList[index + 1]
    end
    tb.gameObject:SetName(index)
    tb.aorimage_Left:SetActiveE(index == 1 and 1 or 0)
    tb.aorimage_Right:SetActiveE(index == #self.progressList and 0 or 1)
    tb.aorimage_LeftFill:SetActiveE(self.buyNum >= needNum and 1 or 0)
    tb.aorimage_RightFill:SetActiveE(showRight and 1 or 0)
    tb.aortext_Num.text = needNum
end

function BathhouseGiftCumulativeAwardsView:RefreshTaskIndex()
    for i = 1, 3 do
        local index = (self.curIndex - 1) * 3 + i
        if index > #self.taskDatas then
            self.go_table["obj_item" .. i]:SetActiveE(0)
        else
            self.go_table["obj_item" .. i]:SetActiveE(1)
            self:RefreshTaskItem(index, self.go_table["obj_item" .. i])
        end
    end
    self.go_table.aorbtn_left:SetActiveE(self.curIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(((self.curIndex - 1) * 3 + 4) <= #self.taskDatas and 1 or 0)
end

function BathhouseGiftCumulativeAwardsView:RefreshTaskItem(index, obj)
    ---@type SpiritualDrawCumulativeAwardsView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index))
    go_table.obj_items:ClearChildren()
    go_table.obj_items2:ClearChildren()
    local data = self.taskDatas[index]
    go_table.aortext_info.text = data.Cfg.desc
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorbtn_way:SetActiveE(1)
        go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(92010300021)
        go_table.aortext_label.color = _G.ColorTools.FormatColorByString("5b5b5b")
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, 2 do
        --#data.Cfg.reward do
        local info = data.Cfg.reward[i]
        if info then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.Cfg.reward[i].type,
                go_table.obj_items,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.85)
                    if data.Cfg.reward[i].type[2] > 1 then
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    else
                        tran:ShowNumText(false)
                    end
                    tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                    if tran.ShowEffectOrder and tran.cfg then
                        tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                    end
                end
            )
        end
    end
    for i = 3, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i].type,
            go_table.obj_items2,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.85)
                if data.Cfg.reward[i].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
    if data.Cfg.other_award and data.Cfg.other_award[1] then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { data.Cfg.other_award[1].sid, data.Cfg.other_award[1].num },
            go_table.obj_items2,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.85)
                if data.Cfg.other_award[1].num > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

function BathhouseGiftCumulativeAwardsView:RefreshTaskItem2()
    ---@type SpiritualDrawCumulativeAwardsView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(self.go_table["obj_item" .. 4], _G.handlerbind(self, self.OnClickTask, 0))
    --go_table.obj_items:ClearChildren()
    local data = self.activityCls:GetTaskListByPage(2)[1]
    self.bigAward = data
    self.bigAwardCfg = _G.ConfigManager.heroic_icons_cfg[data.Cfg.reward[1].type[1]]
    local path = (self.bigAwardCfg.gift_icon and #self.bigAwardCfg.gift_icon > 0) 
                and self.bigAwardCfg.gift_icon or self.bigAwardCfg.icon
    local pos = (self.bigAwardCfg.gift_icon_coefficient and #self.bigAwardCfg.gift_icon_coefficient > 0)
                and self.bigAwardCfg.gift_icon_coefficient or nil
    go_table.aorrawimage_Portrait:LoadImage(
        path,
        function(image)
           image:SetNativeSize() 
        end
    )
    go_table.aorrawimage_Mask:LoadImage(
        path,
        function(image)
            image:SetNativeSize()
            image.Alpha = 0.6
        end
    )
    if pos then
        go_table.aorrawimage_Portrait:SetLocalPosition(pos[1], pos[2], pos[3])
        go_table.aorrawimage_Portrait:SetLocalScale(pos[4], pos[5], pos[6])
        go_table.aorrawimage_Mask:SetLocalPosition(pos[1], pos[2], pos[3])
        go_table.aorrawimage_Mask:SetLocalScale(pos[4], pos[5], pos[6])
    end
    go_table.aortext_Tip.text = _G.GetLangPackValue(
        90000011915,
        data.Cfg.count,
        "<color=#D89560>" .. _G.GetLangPackValue(self.bigAwardCfg.name) .. "</color>"
    )
    go_table.aortext_Name.text = _G.GetLangPackValue(self.bigAwardCfg.name)
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.obj_over:SetActiveE(isGet and 1 or 0)
    else
        --go_table.aortext_jd.text = _G.GetLangPackValue(92010300004, data.i_task.target[1]) --_G.string.format("<color=#AA3932>%s</color>/%s", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.obj_over:SetActiveE(0)
    end

end

function BathhouseGiftCumulativeAwardsView:GetJumpIndex()
    for k, v in pairs(self.progressList) do
        if v == self.buyNum then
            return k
        end
    end
    return 1
end

