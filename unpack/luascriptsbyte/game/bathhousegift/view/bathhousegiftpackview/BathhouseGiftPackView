local ActivitySynManager = require "ActivitySynManager"
---@class BathhouseGiftPackView : UIBaseView    中文描述
---@field public go_table BathhouseGiftPackView_GoTable GoTable
local BathhouseGiftPackView = _G.BaseClass("BathhouseGiftPackView", _G.UIBaseView)

--region 工具类方法
local utils = {
    ---获取商品限购信息
    ---@param type number 参照store_extra_cfg.type_reset
    ---@param sellout bool 商品是否已售罄
    ---@return number language_package_cfg.id
    getLanguageId = function(type, sellout)
        if type == 1 then
            return 90021600007
        elseif type == 2 then
            return 90021600008
        elseif type == 3 then
            return 90021600009
        else
            return sellout and 90000011047 or 90000011045
        end
    end
}
function BathhouseGiftPackView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function BathhouseGiftPackView:OnCreate(activityClass)
    self.buyTemp = {}
    self:UpdateView(activityClass)
end

function BathhouseGiftPackView:UpdateView(activityClass, updateFlag)
    if activityClass == nil then
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014)
    else
        self.curActivityClass = activityClass
    end
    self.subType = self.curActivityClass:GetJumpType()

    self.infocfgs = self.curActivityClass.typeClass.infocfg
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.activityEndTime = endTime
    self:StopAllTimer()
    self:UpdateTime()
    self.endTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.endTimer:Start()
    self:UpdateList(updateFlag)
end

function BathhouseGiftPackView:UpdateList(updateFlag)
    local topGift = self.infocfgs[1]
    local buyLimit = topGift.count
    local buyNum = self.curActivityClass.typeClass:GetItemBuyTimes(topGift.sid)
    if self.buyTemp[topGift.sid] then
        buyNum = buyNum + self.buyTemp[topGift.sid]
    end
    self.infocfgsDown = {}
    self.infocfgsTop = { topGift }
    local topSoldOut = buyNum >= buyLimit
    topSoldOut = true--暂时不做首个礼包置顶的效果，先屏蔽
    local startIndex = topSoldOut and 1 or 2
    for i = startIndex, #self.infocfgs do
        local data = self.infocfgs[i]
        _G.table.insert(self.infocfgsDown, data)
    end
    _G.SortList(
            self.infocfgsDown,
            function(data)
                local buyCount = self.curActivityClass.typeClass:GetItemBuyTimes(data.sid)
                local checkNum = (data.count - buyCount) > 0 and 1 or 0
                return checkNum, -data.sid
            end
    )
    local topHeight, itemHeight
    if topSoldOut then
        topHeight = 0
        itemHeight = 718
    else
        topHeight = 244
        itemHeight = 532
    end
    self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(topHeight)
    self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(itemHeight)
    if updateFlag then
        self.go_table.scrollloopvectical_top:UpdateCount(#self.infocfgsTop)
        self.go_table.scrollloopvectical_item:UpdateCount(#self.infocfgsDown)
    else
        self.go_table.scrollloopvectical_top:InitItemData(#self.infocfgsTop, _G.handler(self, self.RefreshListTop))
        self.go_table.scrollloopvectical_item:InitItemData(#self.infocfgsDown, _G.handler(self, self.RefreshList))
    end
    self.go_table.scrollloopvectical_top:SetActiveE(topSoldOut and 0 or 1)
end

function BathhouseGiftPackView:UpdateTime()
    local time = self.activityEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
        if view1 then
            view1:Close()
        end
        return
    end
    local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, "<color=#3EA469>" .. str .. "</color>")
end

function BathhouseGiftPackView:RefreshListTop(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsTop[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))
    self:ShowItem(itemGoTable, data, true)
end

function BathhouseGiftPackView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.infocfgsDown[index + 1]
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))
    self:ShowItem(itemGoTable, data, false)
end

function BathhouseGiftPackView:ShowItem(tb, data, isSpecial)
    tb.obj_normal:SetActiveE(isSpecial and 0 or 1)
    tb.obj_special:SetActiveE(isSpecial and 1 or 0)
    local node = tb.obj_Root
    if node:GetChildCountE() > 0 then
        for i = 1, node:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, #data.award do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.award[i].type,
                node,
                function(item)
                    item.gameObject:SetLocalScale(0.95, 0.95, 0.95)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.award[i].type[1])
                end
        )
    end

    local buyCount = self.curActivityClass.typeClass:GetItemBuyTimes(data.sid)
    if isSpecial then
        tb.aortext_name2.text = data.name
    else
        tb.aortext_name.text = data.name
    end
    local restCount = data.count - buyCount
    _G.GameUtil.AddDouYinIcon(tb.aorbtn_btnBuy, true, tb.aortext_price)

    if restCount > 0 then
        tb.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, false), restCount,
                data.count)
        tb.obj_free:SetActiveE(data.price <= 0 and 1 or 0)
    else
        tb.aortext_limit.text = _G.GetLangPackValue(utils.getLanguageId(data.type_reset, true), restCount,
                data.count)
        tb.obj_free:SetActiveE(0)
    end
    if buyCount >= data.count then
        tb.obj_sellOut:SetActiveE(1)
        tb.aorbtn_btnBuy:SetActiveE(0)
        tb.obj_price:SetActiveE(0)
        tb.aortext_rmb:SetActiveE(0)
        tb.aorbtn_btnBuy:SetGray(true)
        tb.aorbtn_btnBuy.enabled = false
    else
        tb.obj_sellOut:SetActiveE(0)
        tb.aorbtn_btnBuy:SetActiveE(1)
        tb.aorbtn_btnBuy:SetGray(false)
        tb.aorbtn_btnBuy.enabled = true

        if data.consume_type == 0 then
            tb.obj_price:SetActiveE(0)
            tb.aortext_rmb:SetActiveE(1)
            ---如果是海外版本用多语言美元符号，反之国服使用元作为单位
            if data.price == 0 then
                tb.aortext_rmb.text = _G.GetLangPackValue(90030800004)
            else
                _G.GameUtil.SetPriceByChannel(data.price, tb.aortext_rmb)
            end
        else
            tb.obj_price:SetActiveE(1)
            tb.aortext_rmb:SetActiveE(0)
            tb.aorrawimage_price:SetActiveE(1)
            tb.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[data.consume_type].icon)
            if data.price == 0 then
                tb.aortext_price.text = _G.GetLangPackValue(90030800004)
            else
                tb.aortext_price.text = tostring(data.price)
            end
        end
    end
end

function BathhouseGiftPackView:OnClick_item(itemGoTable, isOn, data)
    self.curActivityClass.typeClass:Chongzhi(
        data,
        function()
            if self:IsNil() then
                return
            end
            self:UpdateView(self.curActivityClass, 2)
            self.buyTemp[data.sid] = self.buyTemp[data.sid] + 1
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TavernPartyCumulativeAwardsView.Name)
            if view then
                view:RefreshTask()
            end
        end
    )
end

function BathhouseGiftPackView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_zhaomu" then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawView.Name)
        if not view then
            self:CloseView()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawView.Name, 1, nil, 4)
        end
    elseif name == "@_aorbtn_guanbi" then
        self:CloseView()
    end
end

function BathhouseGiftPackView:StopAllTimer()
    if self.endTimer then
        self.endTimer:Stop()
        self.endTimer = nil
    end
end

function BathhouseGiftPackView:EscClose()
    self:CloseView()
end

function BathhouseGiftPackView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function BathhouseGiftPackView:OnDestroy()
    self:CloseView()
end

return BathhouseGiftPackView