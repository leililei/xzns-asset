---检测合击技位置是否解锁
---@param pos number 合击技序列号
---@return boolean 是否解锁
function EmbattleModel:CheckSkillPosUnLock(pos)
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return false
    end
    if self.curSkillPosState[pos] and self.curSkillPosState[pos] ~= 0 then
        local type, param = table.unpack(self.curSkillPosState[pos])
        if type == 1 and _G.PlayerModel:GetInstance():GetLevel() >= param or
                type == 4 and require("AfkModel"):GetInstance():CheckSectionIsPass(param) or
                type == 50 and _G.PlayerModel:GetInstance():GetServerOpenDuration() >= param * 86400 or
                type == 0 then
            self.curSkillPosState[pos] = 0
        end
    end
    return self.curSkillPosState[pos] == 0
end

---获取合击技解锁放置的关卡ID
---@param pos number 合击技序列号
---@return string 提示
function EmbattleModel:GetSkillPosUnLockParam(pos)
    if not self.curSkillPosState[pos] or self.curSkillPosState[pos] == 0 then
        return nil
    end
    local type, param = table.unpack(self.curSkillPosState[pos])
    if type == 1 then
        return _G.LangUtil.GetLangPackValue(9002010022, param), type, param
    elseif type == 4 then
        ---@type afk_cfg
        local cfg = _G.ConfigManager.afk_cfg[param]
        if cfg then
            return _G.LangUtil.GetLangPackValue(90025100003, cfg.chapter, cfg.section), type, param
        end
    elseif type == 50 then
        local remainTime = param * 86400 - _G.PlayerModel:GetInstance():GetServerOpenDuration()
        if remainTime > 0 then
            return _G.GetLangPackValue(90023800019, param), type, param
        end
    end
    return nil
end

