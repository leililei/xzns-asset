--region 重写父类方法
function EmbattleModel:GetDataFormServer()
    local sits = _G.PlayerPrefsManager.GetTable(EmbattleSaveKey) or {}
    for id, sit in pairs(sits) do
        self.embattlePetSkillIndexArray[id] = sit.pet
        self.embattleSkillIndexArray[id] = sit.combine
        if _G.AppSetting.IsXzns then
            self.embattleBeastSkillIndexArray[id] = sit.beast
        end

        if sit.embattle then
            self.localEmbattleArray[id] = sit.embattle
        else
            sit.pet = nil
            sit.beast = nil
            sit.combine = nil
            self.localEmbattleArray[id] = sit
        end
    end
    for key, value in pairs(self.localEmbattleArray) do
        self.curEmbattleArray[key] = value
    end
    EmbattleNet:GetInstance():GetAllEmbattleInfo(
            function(msg)
                local data = msg.garrays or {}
                self:ParseData(data)
            end
    )
end

function EmbattleModel:ParseData(data)
    if not table.isEmptyOrNil(data) then
        for i = 1, #data do
            if not LocalEmbattleType[data[i].id] then
                self.curEmbattleArray[data[i].id] = data[i].sits
                self.curEmbattleArray[data[i].id][6] = nil
                self.embattleSkillIndexArray[data[i].id] = data[i].skill_index
                self.embattlePetSkillIndexArray[data[i].id] = data[i].pet
                if _G.AppSetting.IsXzns then
                    self.embattleBeastSkillIndexArray[data[i].id] = data[i].beast
                end
            end
        end
    end
    base.ParseData(self)
end

