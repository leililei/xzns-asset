---获取布阵最高战力角色
---@param id number 布阵类型
---@return table {sid=number,uid=number}
function EmbattleModel:GetEmbattleMaxPowerData(id)
    if not id then
        return 0
    end
    local uids = self.curEmbattleArray[id]
    local power = 0
    local uid = 114200000
    local sid = 114200000
    local card
    local StorageManager = _G.StorageManager:GetInstance()
    for i = 1, #uids do
        card = StorageManager:GetItemDataByID(_G.StorageID.Card, uids[i])
        if card then
            if card:GetPower() > power then
                power = card:GetPower()
                sid = card.sid
                uid = card.uid
            end
        end
    end
    return { sid = sid, uid = uid }
end

---保存布阵数据
---@param id number 阵型id
---@param callback function 保存回调
---@param saveType number 保存类型 nil or 0 保存服务器 1 保存本地 2临时存储
---@param NotPassServer boolean 不通知服务器
---@param data table 布阵数据(传入 则替换掉当前 不传则采用当前数据{uid,uid,uid,uid,uid,uid})
---@param firstEmbattle bool 是不是第一次设置五行竞技场阵容
function EmbattleModel:SaveEmbattleDataNew(id, callback, saveType, NotPassServer, data, firstEmbattle)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogError("传入的布阵ID为nil 保存失败")
        end
        if callback then
            callback(-1)
        end
        return
    end
    local lastTemp = self.curEmbattleArray[id] or { 0, 0, 0, 0, 0 }
    if (id == _G.EmbattleType.arenaElementAttack and firstEmbattle) then
        for index, v in pairs(data) do
            self.curEmbattleArray[id][index] = v
        end
    else
        self.curEmbattleArray[id] = data or self.curEmbattleArray[id]
    end

    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        --未创建角色，就只能作为临时阵容保存(不持久化)
        NotPassServer = true
        saveType = _G.EmbattleSaveType.temporary
    end
    local serverid = (not saveType or saveType == _G.EmbattleSaveType.server) and id or 0
    if DecorationBossEmbattleType[serverid] then
        serverid = EmbattleType.DecorationBoss
    end
    if NotPassServer and saveType ~= _G.EmbattleSaveType.server then
        if _G.EmbattleSaveType.localfile == saveType then
            self.localEmbattleArray[id] = self.curEmbattleArray[id]
            self:SaveLocalEmbattleData()
        end
        if callback then
            callback(0)
        end
    else
        data = self.curEmbattleArray[id]
        EmbattleNet:GetInstance():UpdateEmbattle(
                { serverid },
                { data },
                function(msg)
                    if msg.ack == 1 then
                        self:EmbattleidSkillCount3(id, self.embattleSkillIndexArray[id])

                        if _G.EmbattleSaveType.localfile == saveType then
                            self.localEmbattleArray[id] = self.curEmbattleArray[id]
                            self:SaveLocalEmbattleData()
                        end
                        if
                        id == _G.EmbattleType.AFKOnly or id == _G.EmbattleType.AFKGroup or
                                id == _G.EmbattleType.AFKGroup2 or
                                id == _G.EmbattleType.AFKGroup3 or
                                id == _G.EmbattleType.AFKGroup4 or
                                id == _G.EmbattleType.AFKGroup5
                        then
                            _G.Events:GetInstance():Broadcast(
                                    _G.eRedPointAFKEquip.RedPointRefreshAFkEquip,
                                    self.curEmbattleArray[id],
                                    self:GetChangePosUid(lastTemp, self.curEmbattleArray[id])
                            )
                        end
                        if callback then
                            callback(0)
                        end
                    else
                        if callback then
                            callback(-1)
                        end
                    end
                end,
                { self.embattleSkillIndexArray[id] },
                { self.embattlePetSkillIndexArray[id] },
                { _G.AppSetting.IsXzns and self.embattleBeastSkillIndexArray[id] or nil }

        )
    end
    ---当保存的是五行竞技场的防御阵容且进攻阵容是空的时候
    ---以同样的阵容保存进攻阵容
    if
    (id == _G.EmbattleType.arenaElementDefence and
            require("EmbattleController"):GetInstance():CheckArenaDefenceIsEmpty(
                    _G.EmbattleType.arenaElementAttack,
                    saveType,
                    NotPassServer,
                    _G.EmbattleControllerItemType.arenaElementAttack
            ))
    then
        self:SaveEmbattleDataNew(_G.EmbattleType.arenaElementAttack, nil, saveType, NotPassServer, data, true)
    end
end

---获取变动阵容的uids(用于更新阵容)
---@param last table 上次保存的阵容
---@param cur table 本次保存的阵容
---@return table
function EmbattleModel:GetChangePosUid(last, cur)
    local have = {}
    for _, v in pairs(cur) do
        if v > 0 then
            have[v] = true
        end
    end
    local tb = { down = {}, up = {} }
    for _, v in pairs(last) do
        if v > 0 and not have[v] then
            _G.table.insert(tb.down, v)
        elseif v > 0 and have[v] then
            have[v] = nil
        end
    end
    tb.up = _G.table.keys(have)
    return tb
end

---多组布阵数据上传
---@param ids table 布阵枚举组
---@param callback function 保存回调
---@param embattleData table 布阵数据(传入 则替换掉当前 不传则采用当前数据{{uid,uid,uid,uid,uid,uid}})
---@param saveType number 保存类型 nil or 0 保存服务器 1 保存本地 2临时存储
function EmbattleModel:SaveEmbattleDataTable(ids, callback, embattleData, saveType)
    local data = {}
    local skill = {}
    local pets = {}
    local beasts = {}
    for i = 1, #ids do
        self.curEmbattleArray[ids[i]] = embattleData and embattleData[i] or self.curEmbattleArray[ids[i]]
        data[i] = self.curEmbattleArray[ids[i]]
        skill[i] = self.embattleSkillIndexArray[ids[i]]
        pets[i] = self.embattlePetSkillIndexArray and self.embattlePetSkillIndexArray[ids[i]] or { 0, 0, 0 }
        if _G.AppSetting.IsXzns then
            beasts[i] = self.embattleBeastSkillIndexArray and self.embattleBeastSkillIndexArray[ids[i]] or { 0, 0, 0 }
        end
    end
    if not saveType or saveType == _G.EmbattleSaveType.server then
        --保存在服务器
        EmbattleNet:GetInstance():UpdateEmbattle(
                ids,
                data,
                function(msg)
                    for i = 1, #ids do
                        self:EmbattleidSkillCount3(ids[i], skill[i])
                    end
                    if callback then
                        callback(msg.ack == 1 and 0 or -1)
                    end
                end,
                skill,
                pets,
                _G.AppSetting.IsXzns and beasts or nil
        )
    else
        if saveType == _G.EmbattleSaveType.localfile then
            --保存在本地
            for i = 1, #ids do
                self.localEmbattleArray[ids[i]] = self.curEmbattleArray[ids[i]]
            end
            self:SaveLocalEmbattleData()
        end
        if callback then
            callback(0)
        end
    end
end

