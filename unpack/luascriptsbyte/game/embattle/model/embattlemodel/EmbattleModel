---获取出战卡牌SID数组
---@param id EmbattleType 布阵类型
---@return table 上阵的英雄数据SID数组
function EmbattleModel:GetEmbattleSidsData(id)
    if not id then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("未传入ID 返回默认0数据")
        end
        return { 0, 0, 0, 0, 0 }
    end
    --临时存储的UID为卡牌SID
    local sids = self.embattleTemporarySids[id]
    if sids then
        return sids
    end
    sids = _G.DeepCopy(self.curEmbattleArray[id])
    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        for i = 1, #sids do
            if sids[i] == 0 then
                sids[i] = 0
            else
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, sids[i])
                sids[i] = card and card.sid or 0
            end
        end
        return sids
    end
    return { 0, 0, 0, 0, 0 }
end

