---检测是否有布阵数据
---@param id number 是否有布阵数据
function EmbattleModel:CheckEmbattleData(id)
    if not id then
        return false
    end
    for _, v in pairs(self.curEmbattleArray[id]) do
        if v > 0 then
            ---@type CardData
            local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v)
            if cardData then
                return true
            end
        end
    end
    return false
end

