---检查宠物技是否解锁
---@param pos number 序号
---@return boolean 是否解锁
function EmbattleModel:CheckPetSkillPosUnLock(pos)
    if _G.AppSetting.IsXzns then
        -- 星座屏蔽宠物，改为使用圣兽(Beast)
        return false
    end
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return false
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(251) then
        return false
    end
    --初始化解锁条件
    if not self.curPetSkillPosState then
        self.curPetSkillPosState = {}
        --TODO: 宠物技解锁条件未配置时, 使用合击技解锁配置
        local conditions = _G.ConfigManager.discrete_cfg[114402]
        if conditions then
            for _, v in ipairs(conditions) do
                table.insert(self.curPetSkillPosState, v)
            end
        end
    end

    local condition = self.curPetSkillPosState[pos]
    if not condition or condition == 0 then
        return true
    end
    if not _G.GlobalConditionManager.CheckCondition(condition[1], condition[2]) then
        return false
    end
    self.curPetSkillPosState[pos] = 0
    return true
end

