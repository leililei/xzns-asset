---设置卡牌下阵
---@param uids table 卡牌uid数组
---@return boolean 下阵是否成功
function EmbattleModel:SetEmbattleDownByUidTable(uids)
    local typeArray = {}
    local typeArrayLocal = {}
    for i = 1, #uids do
        for etype, earray in pairs(self.curEmbattleArray) do
            for index = 1, #earray do
                local value = earray[index]
                if value == uids[i] then
                    if 400 <= etype and etype <= 409 then
                        self.curEmbattleArray[etype][index] = 0
                        typeArrayLocal[etype] = etype
                    else
                        self.curEmbattleArray[etype][index] = 0
                        typeArray[etype] = etype
                    end
                end
            end
        end
    end
    if not _G.table.isEmptyOrNil(typeArray) then
        typeArray = _G.table.toArray(typeArray)
        self:HandleEmptyEmbattle(typeArray)
        self:SaveEmbattleDataTable(typeArray, nil)
    end
    if not _G.table.isEmptyOrNil(typeArrayLocal) then
        typeArrayLocal = _G.table.toArray(typeArrayLocal)
        self:HandleEmptyEmbattle(typeArrayLocal)
        self:SaveEmbattleDataTable(typeArrayLocal, nil, nil, _G.EmbattleSaveType.localfile)
    end
    return true
end

---处理因卡牌被消耗导致的空阵容
---@param etypes table 布阵枚举组
function EmbattleModel:HandleEmptyEmbattle(etypes)
    local data
    for i = 1, #etypes do
        data = self.curEmbattleArray[etypes[i]]
        for j = 1, #data do
            if data[j] > 0 then
                break
            end
            if j == #data then
                --阵容为空了
                local func = emptyEmbattleHandle[etypes[i]]
                if func then
                    func(self)
                end
            end
        end
    end
end

