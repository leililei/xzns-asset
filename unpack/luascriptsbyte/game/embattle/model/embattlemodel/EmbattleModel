local function HandleArenaSeniorEmptyEmbattle(self, etype)
    local ets = { EmbattleType.arenaSeniorAttack1, EmbattleType.arenaSeniorAttack2, EmbattleType.arenaSeniorAttack3 }
    local maxcard
    local sids = {}
    local data
    local StorageManagerIns = _G.StorageManager:GetInstance()
    for i = 1, #ets do
        if ets[i] ~= etype then
            data = self.curEmbattleArray[ets[i]]
            for j = 1, #data do
                if data[j] > 0 then
                    maxcard = StorageManagerIns:GetItemDataByID(_G.StorageID.Card, data[j])
                    sids[maxcard.sid] = true
                end
            end
        end
    end
    maxcard = nil
    local cards = _G.StorageManager:GetInstance():GetStrongestCards()
    for i = 1, #cards do
        if not sids[cards[i].sid] then
            if not maxcard then
                maxcard = cards[i]
            elseif maxcard:GetPower() < cards[i]:GetPower() then
                maxcard = cards[i]
            end
        end
    end
    return maxcard and maxcard.uid or 0
end
