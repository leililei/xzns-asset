    if not id then
        return 0
    end
    local uids = rawget(self.curEmbattleArray, id)
    if uids == nil then
        return 0
    end
    local power = 0
    local uid = 0
    local card
    local StorageManager = _G.StorageManager:GetInstance()
    for i = 1, #uids do
        card = StorageManager:GetItemDataByID(_G.StorageID.Card, uids[i])
        if card then
            power = power + card:GetPower()
