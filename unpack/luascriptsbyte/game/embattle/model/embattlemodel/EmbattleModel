function EmbattleModel:CheckBattle(id, func)
    if func then
        return func(), true
    end
    if not id then
        return false
    end
    local uids = self.curEmbattleArray[id]
    for i = 1, #uids do
        if uids[i] > 0 then
            return true
        end
    end
    return false
end

---获取布阵战力
---@param id number 布阵类型
---@param isView boolean 是否为界面显示(用于处理试玩卡战力问题)
---@return number 战力
function EmbattleModel:GetEmbattlePower(id, isView)
    if not id then
        return 0
    end
    local uids = self.curEmbattleArray[id]
    local power = 0
    local uid = 0
    local card
    local StorageManager = _G.StorageManager:GetInstance()
    for i = 1, #uids do
        card = StorageManager:GetItemDataByID(_G.StorageID.Card, uids[i])
        if card then
            power = power + card:GetPower(isView)
        end
    end
    return power
end

