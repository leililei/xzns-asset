function EmbattleModel:__init()
    self.curEmbattleArray = {}
    setmetatable(
            self.curEmbattleArray,
            {
                __index = function(tab, key)
                    tab[key] = { 0, 0, 0, 0, 0 }
                    if needDefaultEmbattleType[key] then
                        --读取放置1队的数据
                        local data = tab[EmbattleType.AFKOnly]
                        for i = 1, #data do
                            tab[key][i] = data[i]
                        end
                    end
                    return tab[key]
                end
            }
    )
    self.embattleSkillIndexArray = {}
    setmetatable(
            self.embattleSkillIndexArray,
            {
                __index = function(tab, key)
                    tab[key] = { 0, 0, 0 }
                    if needDefaultEmbattleType[key] then
                        --读取放置1队的数据
                        local data = tab[EmbattleType.AFKOnly]
                        for i = 1, #data do
                            tab[key][i] = data[i]
                        end
                    end
                    return tab[key]
                end
            }
    )
    ---@type any 宠物技布阵数据
    self.embattlePetSkillIndexArray = {}
    setmetatable(
            self.embattlePetSkillIndexArray,
            {
                __index = function(tab, key)
                    tab[key] = { 0, 0, 0 }
                    if needDefaultEmbattleType[key] then
                        --读取放置1队的数据
                        local data = tab[EmbattleType.AFKOnly]
                        for i = 1, #data do
                            tab[key][i] = data[i]
                        end
                    end
                    return tab[key]
                end
            }
    )
    if _G.AppSetting.IsXzns then
        ---@type any 圣兽技布阵数据（星座使用）
        self.embattleBeastSkillIndexArray = {}
        setmetatable(
                self.embattleBeastSkillIndexArray,
                {
                    __index = function(tab, key)
                        tab[key] = { 0, 0, 0 }
                        if needDefaultEmbattleType[key] then
                            --读取放置1队的数据
                            local data = tab[EmbattleType.AFKOnly]
                            for i = 1, #data do
                                tab[key][i] = data[i]
                            end
                        end
                        return tab[key]
                    end
                }
        )
    end
    self.embattleTemporarySids = {}
    self.localEmbattleArray = {}
    local PlayerPrefsManager = _G.PlayerPrefsManager
