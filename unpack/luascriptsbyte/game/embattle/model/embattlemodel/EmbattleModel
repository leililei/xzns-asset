---保存本地布阵数据
function EmbattleModel:SaveLocalEmbattleData()
    local sits = {}
    for id, sit in pairs(self.localEmbattleArray) do
        sits[id] = {}
        sits[id].embattle = {}
        for i = 1, #sit do
            sits[id].embattle[i] = sit[i]
        end
        sits[id].combine = self.embattleSkillIndexArray[id]
        sits[id].pet = self.embattlePetSkillIndexArray[id]
        if _G.AppSetting.IsXzns then
            sits[id].beast = self.embattleBeastSkillIndexArray[id]
        end
    end
    _G.PlayerPrefsManager.SetTable(EmbattleSaveKey, sits)
end

