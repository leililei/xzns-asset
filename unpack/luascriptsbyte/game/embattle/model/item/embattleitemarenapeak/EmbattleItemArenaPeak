---@class EmbattleItemArenaPeak:EmbattleItemPVE	中文描述
local EmbattleItemArenaPeak = _G.BaseClass("EmbattleItemArenaPeak", require "EmbattleItemBase")
---类的构造函数

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemArenaPeak:InitEmbattleData(data, index)
    self.curEmbattleData = data or {0,0,0,0,0,0}
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i] > 0 then
            local card = self:GetCardData(self.curEmbattleData[i])
            if card then
                self.curEmbattleData[i] = {
                    uid = card.uid,
                    sid = card.sid,
                    star = card:GetStar(),
                    level = card:GetLevel(),
                    soulLink_lv = card.soulLink_lv,
                    tag = 0
                }
                self:SetCurUids(card.uid, true)
                self:SetCurSids(card.sid, true)
            else
                if _G.AppSetting.DEBUG then
                    _G.LogWarning(
                            "未找到对应uid的卡牌 uid = " .. self.curEmbattleData[i],
                            "EmbattleItemBase:InitEmbattleData"
                    )
                end
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    tag = 0
                }
            end
        else
            self.curEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 0
            }
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end

---@private
function EmbattleItemArenaPeak:InitCardList()
    local ArenaPeakModel = require("ArenaPeakModel"):GetInstance()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local supCards = ArenaPeakModel:GetSupportCards()
    self.curChooseCardList = {}
    ---@type CardData
    local newCard
    local attId = _G.ConfigManager.arena_peak_cfg[ArenaPeakModel:GetCurSeasonID()].att_equity
    local lv = _G.ConfigManager.att_equity_cfg[attId].level
    for _, card in pairs(cards) do
        if card.cfg.Order >= 3 then
            newCard = _G.DeepCopy(card)
            newCard:SetLevel(lv)
            newCard.shenshiPosType = _G.StonePosType.PosZero
            newCard:CalcNowSumProp()
            _G.table.insert(self.curChooseCardList, newCard)
        end
    end
    for _, card in pairs(supCards) do
        _G.table.insert(self.curChooseCardList, card)
    end
    --self.curChooseCardList = table.toArray(cards)
    self:SortCardList()
end

