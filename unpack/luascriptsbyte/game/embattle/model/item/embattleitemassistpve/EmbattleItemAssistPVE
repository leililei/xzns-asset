local base = require "EmbattleItemPVE"
---@class EmbattleItemAssistPVE	:EmbattleItemPVE 可助战的PVE
local EmbattleItemAssistPVE = _G.BaseClass("EmbattleItemAssistPVE", base)
---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemAssistPVE:InitCardList()
    self.putAssistUids = {}
    self.npcAssistUidList = {}
    self.maxPutCount = require "FriendHelpModel":GetInstance():GetMaxUseCount(self.curEmbattleType)
    self.putAssistCount = 0
    base.InitCardList(self)
    local datas, npcDatas = require "FriendHelpModel":GetInstance():GetBorrowCardDatas(true, 1)
    local insert = _G.table.insert
    for i = 1, #datas do
        insert(self.curChooseCardList, 1, datas[i])
        self.assistUidList[datas[i].uid] = true
    end
    for _, v in ipairs(npcDatas) do
        insert(self.curChooseCardList, 1, v)
        self.assistUidList[v.uid] = true
        self.npcAssistUidList[v.uid] = true
    end
end

---检测是否展示布阵按钮助战标识
function EmbattleItemAssistPVE:ShowEmbattleAssitTag()
    return not _G.table.isEmptyOrNil(self.assistUidList)
end

---检测卡牌是否是助战角色
function EmbattleItemAssistPVE:CheckCardAssist(uid)
    return self.assistUidList[uid]
end

---获取最大助战数
function EmbattleItemAssistPVE:GetMaxPutAssistNum()
    return require "FriendHelpModel":GetInstance():GetMaxUseAssistNum()
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemAssistPVE:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    local sits2 = {0, 0, 0, 0, 0}
    local isHave = false
    for i = 1, #self.curEmbattleData do
        if self:CheckCardAssist(self.curEmbattleData[i].uid) then
            sits2[i] = self.curEmbattleData[i].uid
            isHave = true
        else
            sits[i] = self.curEmbattleData[i].uid
        end
    end
    local skills = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    EmbattleModelIns:SetSkillIndex(self.curEmbattleType, skills)
    self.count = isHave and 2 or 1
    EmbattleModelIns:SaveEmbattleDataNew(
        self.curEmbattleType,
        _G.handler(self, self.OnSaveEnd),
        self.saveType,
        self.notPassServer,
        sits
    )
    sits = nil
    require "FriendHelpModel":GetInstance():SaveGarray(
        self.curEmbattleType,
        sits2,
        function()
            self:OnSaveEnd(0)
        end
    )
    sits2 = nil
end

function EmbattleItemAssistPVE:OnSaveEnd(result)
    if result == 0 then
        self.count = self.count - 1
    else
        self.count = 0
    end

    if self.count <= 0 then
        if self.onSaveCall then
            self.onSaveCall(0, self.monsterGroupID)
            self.onSaveCall = nil
        else
            self.onSaveCall(result, self.monsterGroupID)
        end
    end
end

---检测能否上阵助战卡
function EmbattleItemAssistPVE:CheckIsPutAssist(index, uid)
    return require "FriendHelpModel":GetInstance():CheckCanUseHelp(self.curEmbattleType, nil, nil, uid)
end

function EmbattleItemAssistPVE:GetCurEmbattleType()
    return self.curEmbattleType, _G.handler(self, self.CheckEmbattle)
end
---检测阵容
function EmbattleItemAssistPVE:CheckEmbattle()
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i].uid > 0 then
            return true
        end
    end
    return false
end

---获取编队界面卡牌列表
---@return table 卡牌列表
function EmbattleItemAssistPVE:GetGroupCardList()
    local tb = {}
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    tb = table.toArray(cards)
    _G.table.sort(tb, _G.handler(self, self.SortCardListFunc))
    return tb
end

function EmbattleItemAssistPVE:CheckAssistIsFull()
    return self.putAssistCount < self.maxPutCount
end

---设置单个位置的布阵数据
---@param index number 序列号
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return boolean 设置是否成功
function EmbattleItemAssistPVE:SetEmbattleDataSingle(index, uid, etIndex)
    local isChange = true
    if self.putAssistUids[etIndex] and self.putAssistUids[etIndex][index] then
        isChange = uid ~= self.putAssistUids[etIndex][index]
        self.putAssistUids[etIndex][index] = nil
        self.putAssistCount = self.putAssistCount - 1
    end
    if isChange and self:CheckCardAssist(uid) then
        if not self.putAssistUids[etIndex] then
            self.putAssistUids[etIndex] = {}
        end
        self.putAssistUids[etIndex][index] = uid
        self.putAssistCount = self.putAssistCount + 1
    end
    return base.SetEmbattleDataSingle(self, index, uid, etIndex)
end

function EmbattleItemAssistPVE:ClearEmbattle(index)
    base.ClearEmbattle(self, index)
    if self.putAssistUids[index] then
        self.putAssistCount = self.putAssistCount - _G.table.count(self.putAssistUids[index])
        self.putAssistUids[index] = {}
    end
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return table 卡牌数据对象
function EmbattleItemAssistPVE:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    return base.GetCardData(self, uid)
end

function EmbattleItemAssistPVE:CheckIsNpcAssist(uid)
    return self.npcAssistUidList[uid]
end

return EmbattleItemAssistPVE
