local EmbattleItemGroup = require "EmbattleItemGroup"
---@class EmbattleItemArenaSeniorDefence	中文描述
local EmbattleItemArenaSeniorDefence = _G.BaseClass("EmbattleItemArenaSeniorDefence", EmbattleItemGroup)

---类的构造函数
function EmbattleItemArenaSeniorDefence:__init()
end

---类的析构函数
function EmbattleItemArenaSeniorDefence:Dispose()
end

---获取monster_group_cfg的ID(每个布阵都应该有一个)
---@return number 怪物组ID
function EmbattleItemArenaSeniorDefence:GetMonsterGroupID(index)
    return self.monsterGroupID
end
---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemArenaSeniorDefence:InitEmbattleData(sits, index)
    if sits then
        self.curUids[index] = {}
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not self:CheckUidInEmbattle(sit.uid) and not self:CheckSidInEmbattle(sit.sid) then --不在其他阵容并且没有相同SID上阵
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    self.curUids[index][sit.uid] = true
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    EmbattleItemGroup.InitEmbattleData(self)
end

---初始化敌方布阵数据
function EmbattleItemArenaSeniorDefence:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {0, 0, 0}
    for i = 1, 3 do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            data[j] = {uid = 0, sid = 0, level = 0, star = 0}
        end
        self.curEnemyEmbattleData[i] = data
    end
end
---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemArenaSeniorDefence:CheckCardLock(uid, index)
    if self:CheckUidInEmbattle(uid, index) then --当前布阵上阵
        return 1
    end
    for i = 1, #self.curUids do
        if index ~= i then
            if self.curUids[i][uid] then --别的组上阵
                return 2, 220102, i
            end
        end
    end
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    for j = 1, #self.curEmbattleData do
        for i = 1, #self.curEmbattleData[j] do
            if self.curEmbattleData[j][i].sid == card.sid then --sid重复
                return 2, 140101
            end
        end
    end
    return 1
end

---获取当前布阵id
---@return number 布阵id
function EmbattleItemArenaSeniorDefence:GetCurEmbattleType(index)
    index = index or self.embattleIndex
    return self.curEmbattleType[index], _G.handler(self, self.CheckBattle)
end
---检测是否可以出战
function EmbattleItemArenaSeniorDefence:CheckBattle()
    local num = 0
    for j = 1, #self.curEmbattleData do
        for i = 1, #self.curEmbattleData[j] do
            if self.curEmbattleData[j][i].sid > 0 then
                num = num + 1
                break
            end
        end
        if num ~= j then
            return false, j
        end
    end
    return true
end

function EmbattleItemArenaSeniorDefence:GetCacheModelInBattle()
    return false
end
---获取挑战按钮文字图片名字
---@return string 按钮文字图片名字
function EmbattleItemArenaSeniorDefence:GetBattleImageName()
    return "ui_bz_btn_txt_queding"
end

--组间更换
function EmbattleItemArenaSeniorDefence:ChangeGroup(indexes)
    local items = {self.curEmbattleData[1], self.curEmbattleData[2], self.curEmbattleData[3]}
    local skills = {self.curCombSkillData[1], self.curCombSkillData[2], self.curCombSkillData[3]}
    for i = 1, #indexes do
        self.curEmbattleData[i] = items[indexes[i]]
        self.curCombSkillData[i] = skills[indexes[i]]
        self.curChangeEmbattleIndexes[i] = true
    end
    items = {self.curUids[1], self.curUids[2], self.curUids[3]}
    for i = 1, #indexes do
        self.curUids[i] = items[indexes[i]]
    end
    items = {self.curSids[1], self.curSids[2], self.curSids[3]}
    for i = 1, #indexes do
        self.curSids[i] = items[indexes[i]]
    end
    return true
end

---获取服务器阵容
function EmbattleItemArenaSeniorDefence:GetServerEmbattleData(id, index)
    local arenaAttackIds = {
        _G.EmbattleType.arenaSeniorAttack1,
        _G.EmbattleType.arenaSeniorAttack2,
        _G.EmbattleType.arenaSeniorAttack3
    }
    local isHave = require("EmbattleModel"):GetInstance():CheckEmbattleData(id)
    if self:CheckEmbattleData(arenaAttackIds) and not isHave then
        id = arenaAttackIds[index] or _G.EmbattleType.arenaSeniorAttack1
    end
    if id == _G.EmbattleType.arenaSeniorDefence1 and not isHave then
        id = _G.EmbattleType.AFKOnly
    end
    return EmbattleItemGroup.GetServerEmbattleData(self, id, index)
end

function EmbattleItemArenaSeniorDefence:CheckEmbattleData(ids)
    local EmbattleModel = require("EmbattleModel"):GetInstance()
    for _, v in pairs(ids) do
        if EmbattleModel:CheckEmbattleData(v) then
            return true
        end
    end
    return false
end

function EmbattleItemArenaSeniorDefence:GetSkillIndex(id)
    local arenaAttackIds = {
        _G.EmbattleType.arenaSeniorAttack1,
        _G.EmbattleType.arenaSeniorAttack2,
        _G.EmbattleType.arenaSeniorAttack3
    }
    local isNotHave = not require("EmbattleModel"):GetInstance():CheckEmbattleData(id)
    if self:CheckEmbattleData(arenaAttackIds) and isNotHave then
        id = id - 3
    end
    if id == _G.EmbattleType.arenaSeniorDefence1 and isNotHave then
        id = _G.EmbattleType.AFKOnly
    end
    return EmbattleItemGroup.GetSkillIndex(self, id)
end

return EmbattleItemArenaSeniorDefence
