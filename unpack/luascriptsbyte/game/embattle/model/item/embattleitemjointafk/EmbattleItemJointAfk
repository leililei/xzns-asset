local EmbattleItemPVE = require "EmbattleItemPVE"
---@class EmbattleItemJointAfk:EmbattleItemPVE    中文描述
local EmbattleItemJointAfk = _G.BaseClass("EmbattleItemMaterial", EmbattleItemPVE)

function EmbattleItemJointAfk:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {0, 0, 0, 0, 0}
    if self.monsterGroupID == 0 then
        for i = 1, 5 do
            self.curEnemyEmbattleData[i] = {uid = 0, sid = 0, level = 0, star = 0, boss = false}
        end
        return
    end
    local cfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
    local mcfg = nil
    local HeroType = _G.HeroType
    local monster_cfg = _G.ConfigManager.monster_cfg
    --等级通过共鸣神石去计算卡牌等级
    local model = require("CardResonanceModel"):GetInstance()
    --默认只取第一组
    for i = 1, 5 do
        if cfg.DefaultDefenserSids[1][i] and cfg.DefaultDefenserSids[1][i] > 0 then
            mcfg = monster_cfg[cfg.DefaultDefenserSids[1][i]]
            local maxLv
            if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Stone) then
                ---平均等级
                maxLv = model:GetAverageLevel()
            else
                ---共鸣神石功能未开启时候使用配置的等级
                maxLv = mcfg.Level
            end
            self.curEnemyEmbattleData[i] = {
                uid = mcfg.id,
                sid = mcfg.CardID,
                level = maxLv,
                star = mcfg.Stars,
                scale = mcfg.GlobalScale * 0.0001,
                boss = mcfg.MonsterType == HeroType.Boss or mcfg.MonsterType == HeroType.Elite
            }
        else
            self.curEnemyEmbattleData[i] = {uid = 0, sid = 0, level = 0, star = 0, boss = false}
        end
    end
end


return EmbattleItemJointAfk