---对卡牌列表排序的方法
---@param a table 卡牌列表对象
---@param b table 卡牌列表对象
---@return boolean 是否交换
function EmbattleItemRelicTeamAttack:SortCardListFunc(a, b)
    local power1 = a:GetPower()
    local power2 = b:GetPower()
    local assist1 = a.assist or 0
    local assist2 = b.assist or 0
    if assist1 == assist2 then
        if power1 == power2 then
            if a:GetStar() == b:GetStar() then
                if a.Grade == b.Grade then
                    if a:GetLevel() == b:GetLevel() then
                        if a.sid == b.sid then
                            return a.uid > b.uid
                        else
                            return a.sid > b.sid
                        end
                    else
                        return a:GetLevel() > b:GetLevel()
                    end
                else
                    return a.Grade > b.Grade
                end
            else
                return a:GetStar() > b:GetStar()
            end
        else
            return power1 > power2
        end
    else 
        return assist1 > assist2
    end
end

---获取敌方战斗力
---@return number 战斗力
function EmbattleItemRelicTeamAttack:GetEnemyEmbattlePower()
    local roleEvent = require("RelicTeamModel"):GetInstance():GetRoleEvent()
    if roleEvent and roleEvent.event and roleEvent.event.pvp_info then
        return roleEvent.event.pvp_info.power
    end
    return  0
end

return EmbattleItemRelicTeamAttack