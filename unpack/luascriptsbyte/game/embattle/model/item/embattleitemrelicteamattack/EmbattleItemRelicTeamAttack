---类的构造函数
---@param data table 敌方布阵数据{{uid=0,sid=0,level=0,star=0},power=0}
function EmbattleItemPVP:__init(eType, saveType, notPassServer, mgpID, data)
    self.curEnemyEmbattleData = data
    self:InitEnemyEmbattleData()
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemRelicTeamAttack:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local skills = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local pets = {0, 0, 0}
    if self.curPetSkillData then
        for i = 1, #self.curPetSkillData do
            pets[i] = self.curPetSkillData[i]
        end
    end
    local beasts = {0, 0, 0}
    if self.curBeastSkillData then
        for i = 1, #self.curBeastSkillData do
            beasts[i] = self.curBeastSkillData[i]
        end
    end
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    EmbattleModelIns:SetSkillIndex(self.curEmbattleType, skills)
    EmbattleModelIns:SetPetSkillIndex(self.curEmbattleType, pets)
    local garray = {id = self.curEmbattleType, sits = sits, skill_index = skills, pet = pets}
    if _G.AppSetting.IsXzns then
        EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType, beasts)
        garray = {id = self.curEmbattleType, sits = sits, skill_index = skills, pet = pets, beast = beasts}
    end
    -- EmbattleModelIns:SaveEmbattleDataNew(
    --     self.curEmbattleType,
    --     _G.handler(self, self.OnSaveEnd),
    --     self.saveType,
    --     self.notPassServer,
    --     sits
    -- )
    require("RelicTeamModel"):GetInstance():UpdateGarray(
        {garray = garray},
        _G.handler(self, self.OnSaveEnd)
    )
    sits = nil
end

---保存布阵数据回调
---@param result number 保存结果(0成功)
function EmbattleItemRelicTeamAttack:OnSaveEnd(result)
    if result == 0 then
        if self.onSaveCall then
            self.onSaveCall(0)
            self.onSaveCall = nil
        end
        require("RelicTeamModel"):GetInstance():SetMyTeamPower(self.nowPower, self.nowPowerNoBuff)
    else
        if self.onSaveCall then
            self.onSaveCall(result)
            self.onSaveCall = nil
        end
    end
end

