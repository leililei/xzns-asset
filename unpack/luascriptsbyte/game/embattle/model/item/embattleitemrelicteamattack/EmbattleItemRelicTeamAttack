function EmbattleItemRelicTeamAttack:InitCardList()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    local T = table.toArray(cards)
    self.curChooseCardList = {}
    local assistCards = require("RelicTeamModel"):GetInstance():GetMyAssistCards()
    local newCard
    for k, v in ipairs(assistCards) do 
        local card = _G.CardData.New()
        local info = v.card or v.c_info
        card:Parse(info)
        card.assist = 1
        card:SetLevel(300)
        card:SetSkin(info.skin)
        card:SaveEquipmentData(info, true)
        card:SaveDecorationData(info, true)
        if not _G.AppSetting.IsOverseas then
            card:SaveArtifactData(info, true)
            card:SaveSpiritualData(info, true)
        end
        card.relicTeamDebuff = require("RelicTeamModel"):GetInstance():CheckCardIsDebuff(card)
        card:CalcNowSumProp()
        table.insert(self.curChooseCardList, card)
    end
    for k, v in pairs(cards) do 
        newCard = _G.DeepCopy(v)
        newCard:SetLevel(300)
        newCard.shenshiPosType = _G.StonePosType.PosZero
        newCard:CalcNowSumProp()
        newCard.relicTeamDebuff = require("RelicTeamModel"):GetInstance():CheckCardIsDebuff(newCard)
        table.insert(self.curChooseCardList, newCard)
    end
    self:SortCardList()
end

---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemRelicTeamAttack:GetMyEmbattlePower(index, isView)
    local power = 0
    local uid = 0
    local card = nil
    local ratio = require("RelicTeamModel"):GetInstance():GetBuffPowerRatio()
    for i = 1, #self.curEmbattleData do
        uid = self.curEmbattleData[i].uid
        if uid > 0 then
            card = self:GetCardData(uid)
            power = power + card:GetPower(isView)
        end
    end
    uid = nil
    card = nil
    self.nowPowerNoBuff = power
    self.nowPower = math.floor(power * ratio) 
    return self.nowPower
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return CardData
function EmbattleItemRelicTeamAttack:GetCardData(uid)
    if self.curChooseCardList then
        for i = 1, #self.curChooseCardList do
            if self.curChooseCardList[i].uid == uid then
                return self.curChooseCardList[i]
            end
        end
    end
    local info = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local card
    if not info then 
        local assistCards = require("RelicTeamModel"):GetInstance():GetMyAssistCards()
        for k, v in ipairs(assistCards) do 
            if v.c_info.uid == uid then 
                info = v.card or v.c_info
                card = _G.CardData.New()
                card:Parse(info)
                card.assist = 1
                card:SetLevel(300)
                card:SetSkin(info.skin)
                card:SaveEquipmentData(info, true)
                card:SaveDecorationData(info, true)
                if not _G.AppSetting.IsOverseas then
                    card:SaveArtifactData(info, true)
                    card:SaveSpiritualData(info, true)
                end
                card:CalcNowSumProp()
                card.relicTeamDebuff = require("RelicTeamModel"):GetInstance():CheckCardIsDebuff(card)
            end
        end
    else 
        card = _G.DeepCopy(info)
        card:SetLevel(300)
        card.shenshiPosType = _G.StonePosType.PosZero
        card:CalcNowSumProp()
        card.relicTeamDebuff = require("RelicTeamModel"):GetInstance():CheckCardIsDebuff(card)
    end
    return card
end

