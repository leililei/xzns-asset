function EmbattleItemAFK:InitCardList()
    base.InitCardList(self)
    self.putAssistUids = {}
    self.putAssistCount = 0
    self.assistUidList = {}
    self.npcAssistUidList = {}
    local FriendHelpModel = require "FriendHelpModel":GetInstance()
    local datas, npcDatas = FriendHelpModel:GetBorrowCardDatas(true, 1)
    for i = 1, #datas do
        _G.table.insert(self.curChooseCardList, 1, datas[i])
        --self.curChooseCardList[#self.curChooseCardList + 1] = datas[i]
        self.assistUidList[datas[i].uid] = true
    end
    for i = 1, #npcDatas do
        _G.table.insert(self.curChooseCardList, 1, npcDatas[i])
        --self.curChooseCardList[#self.curChooseCardList + 1] = datas[i]
        self.assistUidList[npcDatas[i].uid] = true
        self.npcAssistUidList[npcDatas[i].uid] = true
    end
    local demoDatas = require("DemoModel"):GetInstance():GetAllCards()
    for _, v in pairs(demoDatas) do
        if v:GetLastUseTimes(_G.EmbattleType.AFKOnly) > 0 then
            _G.table.insert(self.curChooseCardList, 1, v)
        end
    end
