---更新助战uids
function EmbattleItemAFK:UpdateAssistUid(index, uid, etIndex)
    local isChange = true
    if self.putAssistUids[etIndex] and self.putAssistUids[etIndex][index] then
        isChange = uid ~= self.putAssistUids[etIndex][index]
        self.putAssistUids[etIndex][index] = nil
    end
    if isChange and self:CheckCardAssist(uid) then
        if not self.putAssistUids[etIndex] then
            self.putAssistUids[etIndex] = {}
        end
        self.putAssistUids[etIndex][index] = uid
    end
end

function EmbattleItemAFK:ChangeCardPos(dragpos, changepos, index)
    if base.ChangeCardPos(self, dragpos, changepos, index) then
        local uid = self.curEmbattleData[index][dragpos].uid
        self:UpdateAssistUid(dragpos, uid, index)
        uid = self.curEmbattleData[index][changepos].uid
        self:UpdateAssistUid(changepos, uid, index)
        return true
    end

    return false
end

function EmbattleItemAFK:ClearEmbattle(index)
    local curData = self.curPetSkillData
    local curbeastData
    if _G.AppSetting.IsXzns then
        curbeastData = self.curBeastSkillData
    end
    base.ClearEmbattle(self, index)
    if curData then
        curData[index] = nil
        self.curPetSkillData = curData
    end
    if _G.AppSetting.IsXzns then
        if curbeastData then
            curbeastData[index] = nil
            self.curBeastSkillData = curbeastData
        end
    end
    self.putAssistUids[index] = {}
end

function EmbattleItemAFK:CheckIsOpenNpcGuide()
    return require "FriendHelpModel":GetInstance():CheckCanShowNpcGuide()
end

function EmbattleItemAFK:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    return base.GetCardData(self, uid)
end

function EmbattleItemAFK:GetHelpId()
    return 110
end

function EmbattleItemAFK:ChangeGroup(indexes)
    local items = { self.curEmbattleData[1], self.curEmbattleData[2], self.curEmbattleData[3] }
    local skills = { self.curCombSkillData[1], self.curCombSkillData[2], self.curCombSkillData[3] }
    for i = 1, #indexes do
        self.curEmbattleData[i] = items[indexes[i]]
        self.curCombSkillData[i] = skills[indexes[i]]
        self.curChangeEmbattleIndexes[i] = true
    end
    items = { self.curUids[1], self.curUids[2], self.curUids[3] }
    for i = 1, #indexes do
        self.curUids[i] = items[indexes[i]]
    end
    items = { self.curSids[1], self.curSids[2], self.curSids[3] }
    for i = 1, #indexes do
        self.curSids[i] = items[indexes[i]]
    end
    return true
end

--endregion

return EmbattleItemAFK
