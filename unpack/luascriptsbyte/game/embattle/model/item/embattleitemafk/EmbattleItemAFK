local base = require "EmbattleItemGroupPVE"

---@class EmbattleItemAFK:EmbattleItemAssistPVE    中文描述
local EmbattleItemAFK = _G.BaseClass("EmbattleItemAFK", base)

function EmbattleItemAFK:__init()
    self.afkModelIns = require "AfkModel":GetInstance()
    local groups = self.afkModelIns:GetSceneID()
    if #groups == 1 then
        self.embattleIndex = 1
    else
        local curID = self.afkModelIns:GetCurMonsterID()
        if self.afkModelIns:CheckMonsterIsPass(curID) then
            for i = 1, #groups do
                if not self.afkModelIns:CheckMonsterIsPass(groups[i]) then
                    self.embattleIndex = i
                    break
                end
            end
        else
            for i = 1, #groups do
                if curID == groups[i] then
                    self.embattleIndex = i
                    break
                end
            end
        end
    end
    self:InitPassCardTab()
end

function EmbattleItemAFK:Dispose()
    self.afkModelIns = nil
    self.passCardTab = nil
    self.passSkillTab = nil
end

function EmbattleItemAFK:InitPassCardTab()
    if not self.passCardTab then
        self.passCardTab = {}
        self.passSkillTab = {}
        self.passBeastTab = {}
        for i = 1, #self.monsterGroupID do
            if self.afkModelIns:CheckMonsterIsPass(self.monsterGroupID[i]) then
                for j = 1, #self.curEmbattleData[i] do
                    if self.curEmbattleData[i][j].uid > 0 then
                        self.passCardTab[self.curEmbattleData[i][j].uid] = true
                    end
                end
                for j = 1, #self.curCombSkillData[i] do
                    if self.curCombSkillData[i][j].id > 0 then
                        self.passSkillTab[self.curCombSkillData[i][j].id] = true
                    end
                end
                if _G.AppSetting.IsXzns then
                    for j = 1, #self.curBeastSkillData[i] do
                        if self.curBeastSkillData[i][j] > 0 then
                            self.passBeastTab[self.curBeastSkillData[i][j]] = true
                        end
                    end
                end
            end
        end
    end

    if self.curSids then
        --获取缓存的已通过的场次中使用的uid
        --(试用角色过期后, 本地CardData和布阵数据将被清除, 导致其他队伍可重复上阵)
        for i = 1, #self.monsterGroupID do
            if self.afkModelIns:CheckMonsterIsPass(self.monsterGroupID[i]) then
                local cardSids = self.afkModelIns:GetPassCardSids(i)
                if cardSids then
                    if not self.curSids[i] then
                        self.curSids[i] = {}
                    end
                    for _, sid in pairs(cardSids) do
                        if sid > 0 then
                            self.curSids[i][sid] = true
                        end
                    end
                end
            end
        end
    end
end

