---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemAFK:InitEmbattleData(sits, index)
    if sits then
        --如果是编队设置，则会把其他队伍的角色放到这个队伍来
        self:ClearEmbattle(index)
        local data, card, sit
        data = self.curEmbattleData[index]
        for i = 1, #sits do
            sit = sits[i]
            card = data[i]
            if not sit.tag or sit.tag == 0 and card.tag == 0 then
                if sit.uid > 0 and not self.passCardTab[sit.uid] then
                    card.uid = sit.uid
                    card.sid = sit.sid
                    card.star = sit.star
                    card.level = sit.level
                    card.soulLink_lv = sit.soulLink_lv
                    card.power = sit.power or 0
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        for i = 1, #self.curEmbattleData do
            if i ~= index then
                data = self.curEmbattleData[i]
                for j = 1, #data do
                    if self.curUids[index][data[j].uid] then
                        self:SetCurUids(data[j].uid, false, i)
                        data[j].uid = 0
                        data[j].sid = 0
                        data[j].star = 0
                        data[j].level = 0
                        data[j].soulLink_lv = 0
                        data[j].power = 0
                    end
                end
            end
        end
    else
        base.InitEmbattleData(self)
        for i = 1, #self.curEmbattleData do
            for j = 1, #self.curEmbattleData[i] do
                if self.curEmbattleData[i][j] and self:CheckCardAssist(self.curEmbattleData[i][j].uid) then
                    if not self.putAssistUids then
                        self.putAssistUids = {}
                    end
                    if not self.putAssistUids[i] then
                        self.putAssistUids[i] = {}
                    end
                    self.putAssistUids[i][j] = self.curEmbattleData[i][j].uid
                end
            end
        end
    end
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
---@param swapData table 交换合击技数据
function EmbattleItemAFK:SetCombSkillData(data, index, swapData)
    if data then
        local dic, skills
        for i = 1, #data do
            skills = self.curCombSkillData[index]
            dic = skills[i]
            if data[i].tag == 0 and not self.passSkillTab[data[i].id] then
                dic.id = data[i].id
                dic.lv = data[i].lv
                dic.cskillID = data[i].cskillID
            end
        end
        if swapData then
            local data
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        data = swapData[self.curCombSkillData[i][j].id]
                        if data then
                            self.curCombSkillData[i][j] = data
                        end
                    end
                end
            end
        end
    else
        base.SetCombSkillData(self)
    end
end

