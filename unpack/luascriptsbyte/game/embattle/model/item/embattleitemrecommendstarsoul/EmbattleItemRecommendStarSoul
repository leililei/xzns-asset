local base = require "EmbattleItemRecommendBase"
---@class EmbattleItemRecommendStarSoul:EmbattleItemRecommendBase	中文描述
local EmbattleItemRecommendStarSoul = _G.BaseClass("EmbattleItemRecommendStarSoul", base)

function EmbattleItemRecommendStarSoul:GetRecordData(call, index, i_afk_recommend, monster_group_id)
    if not self.recordDataDic[index] then
        ---没有系统推荐
        require "StarSoulNet":GetInstance():GetRecord(
            {
                sid = require "SystemMaterialController":GetInstance():GetCurChallengeSid(),
                uid = self.data.uid,
                index = index
            },
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self:InitRecordData(msg, index)
                self.power = self.recordData.fight_arg.attacker_team[1].power
                if call then
                    call(self.recordData)
                end
            end
        )
    else
        self.recordData = self.recordDataDic[index].data
        self.recordCardDatas = self.recordDataDic[index].cardDatas
        self.power = self.recordData.fight_arg.attacker_team[1].power
        if call then
            call(self.recordData)
        end
    end
end

return EmbattleItemRecommendStarSoul
