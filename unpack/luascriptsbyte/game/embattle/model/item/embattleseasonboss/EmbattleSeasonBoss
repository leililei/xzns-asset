--检测是否满足加成条件
function EmbattleSeasonBoss:CheckBonusConditionIsSatisfied(index)
    local SeasonModel = require("SeasonModel"):GetInstance()
    local bossCfg = SeasonModel:GetBossCfg()
    local count = #bossCfg.cards_bonus
    ---@type EmbattleSeasonBoss.titleData
    local titles = {}
    local isPop = false
    local popBonusId = {}
    local upBounsId = {}

    for i = 1, count do
        local star = bossCfg.cards_bonus[i][3]
        local Professional = bossCfg.cards_bonus[i][4]
        ---@type CardStorage
        --local CardStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
        for k, v in pairs(self.curEmbattleData) do
            local cfg = ConfigManager.card_cfg[v.sid]
            if cfg and cfg.Professional == Professional and v.star >= star then
                popBonusId[i] = true
                break
            end
        end
        for k, v in pairs(self.initEmbattleData) do
            local cfg = ConfigManager.card_cfg[v.sid]
            if cfg and cfg.Professional == Professional and v.star >= star then
                upBounsId[i] = true
                break
            end
        end
        --for sid, v in pairs(self.curSids) do
        --    ---@type CardData[]
        --    local cardDatas = CardStorage:GetCardsBySid(sid)
        --    local card_count = #cardDatas
        --    if cardDatas and card_count > 0 then
        --        for i = 1, count do
        --            local cardData = cardDatas[i]
        --            if cardData and self.curUids[cardData.uid] and cardData.cfg.Professional == Professional and cardData.star >= star then
        --                isPop = true
        --                title = bossCfg.title[i]
        --                break
        --            end
        --        end
        --    end
        --end
    end

    for index, v in pairs(popBonusId) do
        if upBounsId[index] == nil then
            isPop = true
            table.insert(titles,{
                key = bossCfg.title[index],
                isNotReached = false
            })
        end
    end
    for index, v in pairs(upBounsId) do
        isPop = true
        if popBonusId[index] == nil then
            table.insert(titles,{
                key = bossCfg.title[index],
                isNotReached = true
            })
        end
    end

    self.initEmbattleData,self.initEmbattleSidDict = self:listCopy(self.curEmbattleData)
    return isPop,titles
end

function EmbattleSeasonBoss:listCopy(list)
    local newlist = {}
    local sidDict = {}
    for i = 1, #list do
        table.insert(newlist,_G.DeepCopy(list[i]))
        sidDict[list[i].sid] = true
    end
    return newlist,sidDict
end

