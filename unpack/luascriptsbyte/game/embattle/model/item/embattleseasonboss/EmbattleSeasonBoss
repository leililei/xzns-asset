function EmbattleSeasonBoss:CheckMyShackle(index)
    if AppSetting.IsXzns then
        local ispop,des = self:CheckBonusConditionIsSatisfied(index)
        if ispop then
            for i = 1, #des do
                _G.DelayDo(i - 1,function()

                    local extitle = GetLangPackValue(90049200099)
                    if des[i].isNotReached then
                        extitle = GetLangPackValue(90049200098)
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(620105,GetLangPackValue(des[i].key) .. extitle)
                end)
            end
        end
    end
    return EmbattleSeasonBoss.super.CheckMyShackle(self)
end


