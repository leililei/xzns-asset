---检测是否在布阵中
---@param uid number 卡牌uid
---@return boolean 是否在布阵中
function EmbattleSeasonBoss:CheckUidInEmbattle(uid, index)
    if AppSetting.IsXzns == false then
        return EmbattleSeasonBoss.super.CheckUidInEmbattle(self,uid, index)
    end
    if self.assistUidList[uid] then
        return true
    else
        return self.curUids[uid] or false
    end
end

---设置单个位置的布阵数据
---@param index number 序列号
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return boolean 设置是否成功
function EmbattleSeasonBoss:SetEmbattleDataSingle(index, uid, etIndex)
    return self:HandleEmbattleData(self.curEmbattleData, index, uid, etIndex)
end

--region 内部方法
---处理上下阵
---@param embattleArray table 布阵数据
---@param index number 布阵序列
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return 变量类型 中文描述
function EmbattleSeasonBoss:HandleEmbattleData(embattleArray, index, uid, etIndex)
    if AppSetting.IsXzns == false then
        return EmbattleSeasonBoss.super.HandleEmbattleData(self, embattleArray, index, uid, etIndex)
    end
    local card = embattleArray[index]
    if uid == 0 or card.uid == uid then --下阵
        local SeasonModel = require "SeasonModel":GetInstance()
        if card.sid == SeasonModel.CurHelpOutRoleId then
            if self.isPopTip then
                _G.PopWindowManager:GetInstance():ShowAllTips(1120004)
            end
            return false
        end
        local success = card.uid ~= 0
        if success then
            self:SetCurUids(card.uid, false, etIndex)
            self:SetCurSids(card.sid, false, etIndex)
        end
        card.uid = 0
        card.sid = 0
        card.star = 0
        card.level = 0
        card.soulLink_lv = 0
        card.power = 0
        return success
    end
    local changeCard
    for i = 1, #embattleArray do
        if i ~= index then
            changeCard = embattleArray[i]
            if uid == changeCard.uid then --交换
                changeCard.uid = card.uid
                card.uid = uid
                uid = changeCard.sid
                changeCard.sid = card.sid
                card.sid = uid
                uid = changeCard.star
                changeCard.star = card.star
                card.star = uid
                uid = changeCard.level
                changeCard.level = card.level
                card.level = uid
                uid = changeCard.soulLink_lv
                changeCard.soulLink_lv = card.soulLink_lv
                card.soulLink_lv = uid
                return true
            end
        end
    end
    local cardData = self:GetCardData(uid)
    if cardData == nil then
        return false
    end
    self:SetCurUids(card.uid, false, etIndex)
    self:SetCurSids(card.sid, false, etIndex)
    card.uid = uid
    card.sid = cardData.sid
    card.star = cardData:GetStar()
    card.level = cardData:GetLevel()
    card.soulLink_lv = cardData.soulLink_lv
    card.power = cardData.power or 0
    self:SetCurUids(card.uid, true, etIndex)
    self:SetCurSids(card.sid, true, etIndex)
    return true
end

function EmbattleSeasonBoss:CheckCardSameLock(uid, index, sid)
    if _G.AppSetting.IsXzns then
        if self.assistUidList[sid] then
            return _G.EmbattleState.Same
        end
    end
    local card = self:GetCardData(uid)
    if not self:CheckUidInEmbattle(uid, index) then
        for i = 1, #self.curEmbattleData do
            if i ~= index then
                for j = 1, #self.curEmbattleData[i] do
                    if self.curEmbattleData[i][j].sid == card.sid then
                        return _G.EmbattleState.SameInOtherGroup, i
                    end
                end
            end
        end
    end
    return _G.EmbattleState.Same
end

---一键上阵规则
function EmbattleSeasonBoss:GetAutoEmbattleData(cardList, curEmbattleIndex)
    if AppSetting.IsXzns == false then
        return EmbattleSeasonBoss.super.GetAutoEmbattleData(self,cardList, curEmbattleIndex)
    end
    local frontRow = {
        [1] = true,
        [2] = true
    }
    local backRow = {
        [3] = true,
        [4] = true,
        [5] = true,
        [9] = true
    }
    local backSort = {3, 4, 5, 1, 2}
    local oldEmbattleData = self:GetEmbattleData(curEmbattleIndex)
    ---按照战力上阵前5名角色
    _G.SortList(
            cardList,
            function(data)
                return data.power
            end
    )
    ---@type HelpNpcCardData
    local OnTrialCard = self:GetSupportingRole()

    local cardSidList = {}
    local newCardList = {}
    for _, v in pairs(cardList) do
        if not cardSidList[v.sid] and not self:CheckSidInEmbattle(v.sid) then
            if self:CheckCardAssist(v.uid) then
                local use, max = self:GetAssistNum(v.uid)
                if use < max then
                    _G.table.insert(newCardList, v)
                    cardSidList[v.sid] = true
                end
            else
                _G.table.insert(newCardList, v)
                cardSidList[v.sid] = true
            end
        end
    end
    local newEmbattleData = {}
    local max = self:GetMaxPutNum()
    local count = #oldEmbattleData
    local curindex = 0
    local rolePosDict = {}
    for i = 1, #backSort do
        rolePosDict[backSort[i]] = true
    end
    local pos = self:GetRoleDefaultPos(OnTrialCard)
    -- eq.支援角色必须上阵
    -- 使用递归的方式，获取第一个不和支援角色同sid的数据
    local getNoTrialCard = function(func,CardList)
        local CardData = _G.table.remove(CardList,1)
        if CardData and CardData.sid == OnTrialCard.sid then
            return func(func,CardList)
        else
            return CardData
        end
    end
    for index, v in ipairs(oldEmbattleData) do
        if index > max and max ~= 0 then
            break
        end
        curindex = curindex + 1
        local _cardData = getNoTrialCard(getNoTrialCard,newCardList)
        if _cardData then
            if frontRow[_cardData.cfg.Distance] then
                ---检查前排是否还有位置
                for i = 1, 5 do
                    if not newEmbattleData[i] then
                        newEmbattleData[i] = _cardData
                        rolePosDict[i] = nil
                        break
                    end
                end
            elseif backRow[_cardData.cfg.Distance] then
                for i = 1, 5 do
                    if not newEmbattleData[backSort[i]] then
                        newEmbattleData[backSort[i]] = _cardData
                        rolePosDict[backSort[i]] = nil
                        break
                    end
                end
            end
        else
            break
        end
    end
    if table.count(newEmbattleData) >= 5 then
        newEmbattleData[pos] = OnTrialCard
    else
        if newEmbattleData[pos] == nil then
            newEmbattleData[pos] = OnTrialCard
        else
            local data = newEmbattleData[pos]
            newEmbattleData[pos] = OnTrialCard
            local posid = 0
            for i, v in pairs(rolePosDict) do
                posid = i
                break
            end
            newEmbattleData[posid] = data
        end
    end

    return oldEmbattleData, newEmbattleData
end

---@param card CardData
function EmbattleSeasonBoss:GetRoleDefaultPos(card)
    local rolePos = card.cfg.Distance
    local discfg = ConfigManager.discrete_cfg[200301]
    local meleeCombat = discfg[1][1]
    local remote = discfg[1][2]
    if rolePos <= 2 then
        rolePos = meleeCombat
    elseif rolePos > 2 then
        rolePos = remote
    end
    return rolePos
end

---@retrun HelpNpcCardData
function EmbattleSeasonBoss:GetSupportingRole()
    local FriendHelpModel = require("FriendHelpModel"):GetInstance()
    local SeasonModel = require("SeasonModel"):GetInstance()
    ---@type HelpNpcCardData
    local data = FriendHelpModel:CreateCardDatas(SeasonModel.CurHelpOutRoleId)
    return data
end

function EmbattleSeasonBoss:CheckBattle(isShowTip)
    if AppSetting.IsXzns == false then
        return EmbattleSeasonBoss.super.CheckBattle()
    end
    if isShowTip == nil then
        isShowTip = true
    end
    local RoleData = self:GetSupportingRole()
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i].uid > 0 and RoleData.uid ~= self.curEmbattleData[i].uid  then
            return true
        end
    end
    if isShowTip then
        require("PopWindowManager"):GetInstance():ShowAllTips(5100101)
    end
    return false,nil,true
end

