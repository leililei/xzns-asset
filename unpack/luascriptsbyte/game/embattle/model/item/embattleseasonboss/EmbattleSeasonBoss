local EmbattleSeasonBoss = _G.BaseClass("EmbattleSeasonBoss", require "EmbattleItemPVE")
---类的构造函数
---
function EmbattleSeasonBoss:__init(eType, saveType, notPassServer, mgpID, skipBattle)
    self.skipBattle = skipBattle or false
    self.AttackName = "SeasonBoss"
    self.isPopTip = true
end

function EmbattleSeasonBoss:InitCardList()
    if AppSetting.IsXzns then
        local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
        self.curChooseCardList = table.toArray(cards)
        ---@type HelpNpcCardData
        local data = self:GetSupportingRole()
        _G.table.insert(self.curChooseCardList, 1, data)
        --self.curChooseCardList[#self.curChooseCardList + 1] = datas[i]
        self.assistUidList[data.uid] = true
        self:SortCardList()
    else
        EmbattleSeasonBoss.super.InitCardList(self)
    end
end

function EmbattleSeasonBoss:InitEmbattleData(sits, index)
    if AppSetting.IsXzns == false then
        EmbattleSeasonBoss.super.InitEmbattleData(self,sits,index)
        return
    end
    self:InitCardList()
    local SeasonModel = require "SeasonModel":GetInstance()
    ---@type HelpNpcCardData
    local OnTrialCard = self:GetSupportingRole()
    if sits then
        local uid = 0
        for k, _ in pairs(self.assistUidList) do
            uid = k
            break
        end
        for i = 1, #sits do
            if sits[i].sid == 0 then
                for _, v in pairs(self.curChooseCardList) do
                    if uid == v.uid then
                        sits[i].uid = v.uid
                        sits[i].sid = v.sid
                        sits[i].star = v.star
                        sits[i].level = v.level
                        sits[i].soulLink_lv = v.soulLink_lv
                    end
                end
                break
            end
        end
        local card, sit
        for i = 1, #sits do
            card = self.curEmbattleData[i]
            sit = sits[i]
            if card.uid > 0 then
                self:SetCurUids(card.uid, false)
                self:SetCurSids(card.sid, false)
            end
            card.uid = sit.uid
            card.sid = sit.sid
            card.star = sit.star
            card.level = sit.level
            card.soulLink_lv = sit.soulLink_lv
            if sit.uid > 0 then
                self:SetCurUids(card.uid, true)
                self:SetCurSids(card.sid, true)
            end
        end
    else
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        self.curEmbattleData = self:GetServerEmbattleData(self.curEmbattleType)
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i] > 0 then
                local card = self:GetCardData(self.curEmbattleData[i])
                if card then
                    self.curEmbattleData[i] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        tag = 0
                    }
                    self:SetCurUids(card.uid, true)
                    self:SetCurSids(card.sid, true)
                elseif self.curEmbattleData[i] == SeasonModel.CurHelpOutRoleId then
                    card = OnTrialCard
                    self.curEmbattleData[i] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        tag = 0
                    }
                    self:SetCurUids(card.uid, true)
                    self:SetCurSids(card.sid, true)
                else
                    if _G.AppSetting.DEBUG then
                        _G.LogWarning(
                                "未找到对应uid的卡牌 uid = " .. self.curEmbattleData[i],
                                "EmbattleItemBase:InitEmbattleData"
                        )
                    end
                    self.curEmbattleData[i] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    tag = 0
                }
            end
        end
        self:SetCombSkillData()
        self:SetPetSkillData()
        if _G.AppSetting.IsXzns then
            self:SetBeastSkillData()
        end
    end
    self.assistUidList = {}
    self.assistUidList[SeasonModel.CurHelpOutRoleId] = true
    if self:CheckBattle(false) == false or self:isHasHelpOutRole() == false then
        self:ClearEmbattle(1)
        self.isPopTip = false
        self:SetEmbattleDataSingle(self:GetRoleDefaultPos(OnTrialCard),SeasonModel.CurHelpOutRoleId)
        self.isPopTip = true
        self:SaveEmbattle()
    end
    self.initEmbattleData,self.initEmbattleSidDict = self:listCopy(self.curEmbattleData)
end

function EmbattleSeasonBoss:GetCardList(special)
    if self.curChooseCardList == nil then
        self:InitCardList()
    end
    return self.curChooseCardList
end

function EmbattleSeasonBoss:isHasHelpOutRole()
    ---@type HelpNpcCardData
    local OnTrialCard = self:GetSupportingRole()
    local count = #self.curEmbattleData
    for i = 1, count do
        if self.curEmbattleData[i].uid == OnTrialCard.uid then
            return true
        end
    end
    return false
end

--重置阵容
function EmbattleSeasonBoss:ResetLineup()
    self:ClearEmbattle()
    self:InitEmbattleData()
    --self:SaveEmbattle()
end

