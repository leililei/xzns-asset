---清空
---@param index number 编号(针对多布阵数据  挂机副本)
function EmbattleItemPVE_Train:ClearEmbattle(index)
    if self.Data == nil then
        return
    end

    if self.curEmbattleData == nil then
        return
    end
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.tag == 0 then
            local num = self:CheckIsSpecialEmbattle(card.uid)
            if card.uid > 0 then
                if num == 0 then
                    self:SetCurUids(card.uid, false)
                    self:SetCurSids(card.sid, false)
                end
            end
            if num == 0 then
                card.uid = 0
                card.sid = 0
                card.level = 0
                card.star = 0
                card.soulLink_lv = 0
            end
        end
    end
    if not self.curCombSkillData then
        return
    end
    local skill
    for i = 1, #self.curCombSkillData do
        skill = self.curCombSkillData[i]
        if skill.tag == 0 then
            skill.id = 0
            skill.lv = 0
            skill.cskillID = 0
        end
    end

    require("TrainingModel"):GetInstance():UpdataUpCount()
end

---获取第一个空的位置
---@param index number 多布阵序列号
---@return number 空序列
function EmbattleItemPVE_Train:GetFirstEmptyIndex(etIndex, index)
    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
        if count >= (self.Poslimit * 2) then
            return 0
        end
    end
    return EmbattleItemPVE.GetFirstEmptyIndex(self, index)
end
---获取可上阵人数
function EmbattleItemPVE_Train:GetEmbattleCount()
    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
        if count >= self.Poslimit then
            return 0
        end
    end
    return self.Poslimit - count
end
---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemPVE_Train:CheckCardLock(uid, curIndex)
    --     local data = self:GetCardData(uid)
    --     local indexS = data.cfg.UnitType == 1 and {1, 3, 5} or {2, 4, 6}

    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
        if count >= self.Poslimit then
            return 4
        end
    end
