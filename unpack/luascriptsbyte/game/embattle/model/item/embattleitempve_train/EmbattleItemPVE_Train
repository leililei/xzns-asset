---检测卡牌是否可操作（特殊阵容，固定不可移动，固定可移动）
function EmbattleItemPVE_Train:CheckCardHandle(uid)
    local num = self:CheckIsSpecialEmbattle(uid)
    if num ~= 0 then
        if num == 1 then
            _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90024300055))
        else
            _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90024300054))
        end
        return false, num
    end
    return self.super.CheckCardHandle(self, uid)
end
---特殊阵容 ( 1= 固定不可以移动，0 =  正常，-1 = 固定可以移动)
---@return 0,1 -1
function EmbattleItemPVE_Train:CheckIsSpecialEmbattle(uid)
    if self.Data == nil then
        return
    end
    local sectioncfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId]
    if sectioncfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("train_section_cfg sectionId is nil " .. tostring(self.Data.sectionId))
        end
        return
    end
    if not _G.table.isEmptyOrNil(sectioncfg.fixed_format) then
        for key, value in pairs(sectioncfg.fixed_format) do
            if value > 0 and uid == value then
                return 1
            end
        end
    end
    if not _G.table.isEmptyOrNil(sectioncfg.format_swap) then
        for key, value in pairs(sectioncfg.format_swap) do
            if value > 0 and uid == value then
                return -1
            end
        end
    end
    return 0
end

