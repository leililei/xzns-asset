---初始化布阵数据
function EmbattleItemPVE_Train:InitEmbattleData()
    self.curEmbattleData = self.curEmbattleData or {false, false, false, false, false}
    self.curUids = {}
    self.curSids = {}
    self:InitSpecialEmbattle()
    self:InitSpecialEmbattleMove()
    local data = self:GetServerEmbattleData(self.curEmbattleType)
    for j = 1, #self.curEmbattleData do
        if not self.curEmbattleData[j] then --使用布阵数据
            local ed = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 0
            }
            self.curEmbattleData[j] = ed
            if data[j] > 0 then
                local card = self:GetCardData(data[j])
                if not self.curSids[card.sid] then
                    ed.uid = card.uid
                    ed.sid = card.sid
                    ed.star = card:GetStar()
                    ed.level = card:GetLevel()
                    ed.soulLink_lv = card.soulLink_lv
                    ed.tag = 0
                    self.curUids[card.uid] = true
                    self.curSids[card.sid] = true
                end
            end
        elseif self.curEmbattleData[j].uid > 0 then --会运行两次初始化
            self.curUids[self.curEmbattleData[j].uid] = true
            self.curSids[self.curEmbattleData[j].sid] = true
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end

