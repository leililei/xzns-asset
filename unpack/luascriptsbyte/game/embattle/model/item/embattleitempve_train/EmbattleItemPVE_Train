---类的构造函数
---@param data Params_EmbattleItemPVE_Train
---@field tag number 0 = 正常，1 = 固定不可移动 -1 = 固定可以移动
function EmbattleItemPVE_Train:__init(etype, saveType, notPassServer, monsterGroupID, data)
    self.Data = data
    --- 上阵限制  1=1人1灵 共两角色
    self.Poslimit = 1
    local train_section_cfgItem = _G.ConfigManager.train_section_cfg[self.Data.sectionId]
    if train_section_cfgItem ~= nil then
        if train_section_cfgItem.num_cards > 0 then
            self.Poslimit = train_section_cfgItem.num_cards
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("  num_cards is nil , train_section_cfg id :" .. self.Data.sectionId)
        end
    end
    self:InitEnemyEmbattleData()
    self:InitEmbattleData()
    self:InitSectionId()

    require "EmbattleController":GetInstance():SetHelpInstructionID(23)
end

