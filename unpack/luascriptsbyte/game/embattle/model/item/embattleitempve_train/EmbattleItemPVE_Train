---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemPVE_Train:InitCardList()
    self.curChooseCardList = {}
    ---@type train_section_cfg
    local sectioncfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId]
    if sectioncfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("train_section_cfg sectionId is nil " .. tostring(self.Data.sectionId))
        end
        return
    end

    local monster_cfg = _G.ConfigManager.monster_cfg
    local monster_cfgItem
    local cardlist = {}
    if not _G.table.isEmptyOrNil(sectioncfg.cards_usable) then
        for i = 1, #sectioncfg.cards_usable do
            if sectioncfg.cards_usable[i] > 0 then
                _G.table.insert(cardlist, sectioncfg.cards_usable[i])
            end
        end
    end
    if not _G.table.isEmptyOrNil(sectioncfg.fixed_format) then
        for i = 1, #sectioncfg.fixed_format do
            if sectioncfg.fixed_format[i] > 0 then
                _G.table.insert(cardlist, sectioncfg.fixed_format[i])
            end
        end
    end
    if not _G.table.isEmptyOrNil(sectioncfg.format_swap) then
        for i = 1, #sectioncfg.format_swap do
            if sectioncfg.format_swap[i] > 0 then
                _G.table.insert(cardlist, sectioncfg.format_swap[i])
            end
        end
    end
    for _, monsterid in pairs(cardlist) do
        monster_cfgItem = monster_cfg[monsterid]
        if monster_cfgItem == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("monster_cfg monsterid No Find " .. tostring(monsterid))
            end
        else
            local carddata = EmbattleItemTrainTemporaryCardData.New(monster_cfgItem)
            _G.table.insert(self.curChooseCardList, carddata)
        end
    end
    self:SortCardList()
end

---初始化 固定阵容 不可移动
function EmbattleItemPVE_Train:InitSpecialEmbattle()
    if self.Data == nil then
        return
    end
    local sectioncfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId]
    if sectioncfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("train_section_cfg sectionId is nil " .. tostring(self.Data.sectionId))
        end
        return
    end
    local data = {}
    if not _G.table.isEmptyOrNil(sectioncfg.fixed_format) then
        for i = 1, #sectioncfg.fixed_format do
            _G.table.insert(data, sectioncfg.fixed_format[i])
        end
    else
        return
    end
    for j = 1, #self.curEmbattleData do
        if self.curEmbattleData[j] then --使用布阵数据
            if data[j] > 0 then
                local card = self:GetCardData(data[j])
                if not self.curSids[card.sid] then
                    self.curEmbattleData[j].uid = card.uid
                    self.curEmbattleData[j].sid = card.sid
                    self.curEmbattleData[j].star = card:GetStar()
                    self.curEmbattleData[j].level = card:GetLevel()
                    self.curEmbattleData[j].soulLink_lv = card.soulLink_lv
                    self.curEmbattleData[j].tag = 0
                    self.curUids[card.uid] = true
                    self.curSids[card.sid] = true
                end
            end
        end
    end
end
