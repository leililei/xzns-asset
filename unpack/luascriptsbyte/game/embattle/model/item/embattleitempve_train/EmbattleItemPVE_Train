--设置合击技显示数据
function EmbattleItemPVE_Train:OtherGroupSkillListNew(index)
    if self.combineSkillList then
        return self.combineSkillList
    end
    self.combineSkillList = {}
    for key, value in pairs(_G.ConfigManager.train_section_cfg[self.Data.sectionId].skills) do
        _G.table.insert(self.combineSkillList, {value[1], value[2]})
    end
    for k, v in pairs(_G.ConfigManager.train_section_cfg[self.Data.sectionId].fixed_skills) do
        _G.table.insert(self.combineSkillList, {v[1], v[2]})
    end
    return self.combineSkillList
end

function EmbattleItemPVE_Train:SetCombSkillData(data, index)
    if self.Data == nil then
        return
    end
    if data then
        local cur, last
        for i = 1, #data do
            last = self.curCombSkillData[i]
            if last.tag == 0 then
                cur = data[i]
                last.id = cur.id
                last.lv = cur.lv
                last.cskillID = cur.cskillID
            end
        end
    else
        self.curCombSkillData = self:GetSkillIndex(self.curEmbattleType)
        local CombineModelIns = require("CombineModel"):GetInstance()
        local cfgs = _G.ConfigManager.combine_cfg
        local groupCfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId].skill
        local flag = false
        if _G.table.isEmptyOrNil(groupCfg) then
            groupCfg = {}
            groupCfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId].fixed_skills
            flag = true
        end
        local skill
        for i = 1, #self.curCombSkillData do
            skill = {
                id = 0,
                lv = 0,
                cskillID = 0,
                tag = 0
            }
            if groupCfg[i] and groupCfg[i][1] ~= 0 then
                local id = groupCfg[i][1]

                if flag then
                    local id2 = self:CheckSameType(id)
                    if id2 == 0 or id < id2 then
                        skill.tag = -1
                        skill.cskillID = cfgs[id].skills[groupCfg[i][2]]
                        skill.id = groupCfg[i][1]
                        skill.lv = 0
                        self.storyBattleTag = true
                    end
                else
                    skill.tag = 1
                    skill.cskillID = cfgs[id].skills[groupCfg[i][2]]
                    skill.id = groupCfg[i][1]
                    skill.lv = 0
                end
            else
                if self.curCombSkillData[i] > 0 then
                    skill.id = self.curCombSkillData[i]
                    skill.lv = CombineModelIns:GetCombineLevel(self.curCombSkillData[i])
                    skill.cskillID = cfgs[skill.id].skills[skill.lv]
                end
            end
            self.curCombSkillData[i] = skill
        end
    end
end
---检测是否存在相同类型的合击技
function EmbattleItemPVE_Train:CheckSameType(id)
    if not id or id <= 0 then
        return 0
    end
    local type = _G.ConfigManager.combine_cfg[id].classify
    local cfg2
    for _, v in pairs(self.curCombSkillData) do
        if _G.type(v) == "table" then
            if v.id > 0 then
                cfg2 = _G.ConfigManager.combine_cfg[v.id]
                if cfg2.classify == type then
                    return v.id
                end
            end
        elseif v > 0 then
            if v > 0 then
                cfg2 = _G.ConfigManager.combine_cfg[v]
                if cfg2.classify == type then
                    return v
                end
            end
        end
    end
    return 0
end

---获取合击技能状态
---@return table 技能位置状态
function EmbattleItemPVE_Train:GetCombineSkillState()
    if self.combinePosState then
        return self.combinePosState
    end
    local count = _G.table.count(_G.ConfigManager.train_section_cfg[self.Data.sectionId].skills)
    count = count > 3 and 3 or count
    self.combinePosState = {false, false, false}
    for i = 1, count do
        self.combinePosState[i] = true
    end
    count = _G.table.count(_G.ConfigManager.train_section_cfg[self.Data.sectionId].fixed_skills)
    count = count > 3 and 3 or count
    for j = 1, count do
        self.combinePosState[j] = true
    end
    return self.combinePosState
end
function EmbattleItemPVE_Train:GetCombineSkillList()
    if not self.skills then
        self.skills = {}
        self.skillsCfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId].skills
        for k, v in pairs(self.skillsCfg) do
            self.skills[v[1]] = v[2]
        end
        self.skillsCfg = {}
        self.skillsCfg = _G.ConfigManager.train_section_cfg[self.Data.sectionId].fixed_skills
        for key, value in pairs(self.skillsCfg) do
            self.skills[value[1]] = value[2]
        end
    end
    return self.skills
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemPVE_Train:SaveEmbattle(saveCall)
    if self.storyBattleTag then
        self.onSaveCall = saveCall
        local sits = {0, 0, 0, 0, 0}
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i].tag == 0 then
                sits[i] = self.curEmbattleData[i].uid
            end
        end
        local skills = {0, 0, 0}
        for i = 1, #self.curCombSkillData do
            if self.curCombSkillData[i].tag == 0 then
                skills[i] = self.curCombSkillData[i].id
            end
        end
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        EmbattleModelIns:SetSkillIndex(self.curEmbattleType, skills)
        EmbattleModelIns:SaveEmbattleDataNew(
            self.curEmbattleType,
            _G.handler(self, self.OnSaveEnd),
            self.saveType,
            self.notPassServer,
            sits
        )
        sits = nil
    else
        require "EmbattleItemBase".SaveEmbattle(self, saveCall)
    end
end
