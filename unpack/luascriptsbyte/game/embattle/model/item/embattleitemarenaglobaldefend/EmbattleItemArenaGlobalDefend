--region override pet function
function EmbattleItemArenaGlobalDefend:GetPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local data = self.curPetSkillData[index]
    if not data then
        -- local dan = self:GetEmbattleTypeCount()
        local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
        local pet = require("ArenaGlobalModel"):GetInstance():GetDefendGarray(dan, index)
        if _G.table.isEmptyOrNil(pet) or _G.table.isEmptyOrNil(pet.pet) then
            data = {0, 0, 0}
        else
            data = _G.DeepCopy(pet.pet)
        end
        self.curPetSkillData[index] = data
    end
    return data
end
--endregion

