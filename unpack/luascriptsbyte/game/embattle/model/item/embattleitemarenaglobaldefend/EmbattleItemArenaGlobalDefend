local base = require "EmbattleItemArenaGlobalAttack"
---@class EmbattleItemArenaGlobalDefend	:EmbattleItemSociatyBattleAttack
local EmbattleItemArenaGlobalDefend = _G.BaseClass("EmbattleItemArenaGlobalDefend", base)

function EmbattleItemArenaGlobalDefend:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.embattleView:SetBattleBtnText(_G.GetLangPackValue(90032000016))
end

---初始化地方阵容
function EmbattleItemArenaGlobalDefend:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {}
    for i, v in ipairs(self.curEmbattleType) do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            data[j] = {uid = 0, sid = 0, level = 0, star = 0}
        end
        self.curEnemyEmbattleData[i] = data
    end
end
---保存阵容
function EmbattleItemArenaGlobalDefend:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local garray = {}
    local sits, skills, pets, uid
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    for i = 1, #self.curEmbattleData do
        garray[i] = {
            id = dan * 100 + i
        }
        sits = {}
        skills = {}
        pets = {0, 0, 0}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            sits[j] = uid < 0 and 0 or uid
        end
        for j = 1, #self.curCombSkillData[i] do
            skills[j] = self.curCombSkillData[i][j].id or 0
        end
        if self.curPetSkillData and self.curPetSkillData[i] then
            for j = 1, #self.curPetSkillData[i] do
                pets[j] = self.curPetSkillData[i][j]
            end
        end
        if _G.AppSetting.IsXzns then
            local beasts = {}
            if self.curBeastSkillData and self.curBeastSkillData[i] then
                for j = 1, #self.curBeastSkillData[i] do
                    beasts[j] = self.curBeastSkillData[i][j]
                end
            end
            garray[i].beast = beasts
            EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType[i], beasts)
        end
        garray[i].sits = sits
        garray[i].skill_index = skills
        garray[i].pet = pets
    end
    require "ArenaGlobalModel":GetInstance():SaveDefendGarray(dan, garray, _G.handler(self, self.OnSaveEnd))
end

function EmbattleItemArenaGlobalDefend:SetBeastSkillData(data, index)
    if not self.curBeastSkillData then
        self.curBeastSkillData = {}
    end
    if data then
        local pets = self.curBeastSkillData[index]
        if not pets then
            pets = {}
            self.curBeastSkillData[index] = pets
        end
        for i = 1, #data do
            pets[i] = data[i]
        end
    else
        -- local model = require("ArenaGlobalModel"):GetInstance()
        -- local dan = self:GetEmbattleTypeCount()
        -- local array
        for i = 1, #self.curEmbattleType do
            self.curBeastSkillData[i] = self:GetBeastSkillIndex(i)
        end
    end
end

function EmbattleItemArenaGlobalDefend:SaveEmbattleToAnother()
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local garray = {}
    local sits, skills, pets, uid
    for i = 1, #self.curEmbattleData do
        garray[i] = {
            id = dan * 100 + i
        }
        sits = {}
        skills = {0, 0, 0}
        pets = {0, 0, 0}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            if uid > 0 then
                sits[j] = uid
            else
                sits[j] = 0
            end
        end
        for j = 1, #self.curCombSkillData[i] do
            skills[j] = self.curCombSkillData[i][j].id or 0
        end
        if self.curPetSkillData and self.curPetSkillData[i] then
            for j = 1, #self.curPetSkillData[i] do
                pets[j] = self.curPetSkillData[i][j]
            end
        end
        if _G.AppSetting.IsXzns then
            local beasts = {}
            if self.curBeastSkillData and self.curBeastSkillData[i] then
                for j = 1, #self.curBeastSkillData[i] do
                    beasts[j] = self.curBeastSkillData[i][j]
                end
            end
            garray[i].beast = beasts
            local EmbattleModelIns = require("EmbattleModel"):GetInstance()
            EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType[i], beasts)
        end
        garray[i].sits = sits
        garray[i].skill_index = skills
        garray[i].pet = pets
    end
    require "ArenaGlobalModel":GetInstance():SaveAttackGarray(
        dan,
        garray,
        function()
            _G.PopWindowManager:GetInstance():ShowAllTips(1080014)
        end
    )
    require "ArenaGlobalModel":GetInstance():SaveDefendGarray(dan, garray)
end

---获取服务器阵容(多队时仅第一队使用)
function EmbattleItemArenaGlobalDefend:GetServerEmbattleData(index)
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local array
    if require("ArenaGlobalModel"):GetInstance():CheckDefendEmpty(dan) then
        array = self:GetAfkEmbattleData(index)
        local empty = true
        for i = 1, #array do
            if array[i] > 0 then
                empty = false
                break
            end
        end
        if empty then
            array = self:GetFreeUids()
        end
    else
        array = require("ArenaGlobalModel"):GetInstance():GetDefendGarray(dan, index)
        if _G.table.isEmptyOrNil(array) or _G.table.isEmptyOrNil(array.sits) then
            array = {0, 0, 0, 0, 0}
        else
            array = _G.DeepCopy(array.sits)
        end
    end
    return array
end

function EmbattleItemArenaGlobalDefend:GetSkillIndex(index)
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local skills = require("ArenaGlobalModel"):GetInstance():GetDefendGarray(dan, index)
    if _G.table.isEmptyOrNil(skills) or _G.table.isEmptyOrNil(skills.skill_index) then
        skills = {0, 0, 0}
    else
        skills = _G.DeepCopy(skills.skill_index)
    end
    return skills
end

function EmbattleItemArenaGlobalDefend:GetPetSkillIndex(index)
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local pet
    if require("ArenaGlobalModel"):GetInstance():CheckDefendEmpty(dan) then --防守为空
        pet = self:GetAfkPetData(index)
    else
        pet = require("ArenaGlobalModel"):GetInstance():GetDefendGarray(dan, index)
        if _G.table.isEmptyOrNil(pet) or _G.table.isEmptyOrNil(pet.pet) then
            pet = {0, 0, 0}
        else
            pet = _G.DeepCopy(pet.pet)
        end
    end
    return pet
end

function EmbattleItemArenaGlobalDefend:GetBeastSkillIndex(index)
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local beast
    if require("ArenaGlobalModel"):GetInstance():CheckDefendEmpty(dan) then --防守为空
        beast = self:GetAfkPetData(index)
    else
        beast = require("ArenaGlobalModel"):GetInstance():GetDefendGarray(dan, index)
        if _G.table.isEmptyOrNil(beast) or _G.table.isEmptyOrNil(beast.beast) then
            beast = {0, 0, 0}
        else
            beast = _G.DeepCopy(beast.beast)
        end
    end
    return beast
end

