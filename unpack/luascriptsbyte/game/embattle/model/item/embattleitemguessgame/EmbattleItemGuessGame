local base = require "EmbattleItemPVP"
---@class EmbattleItemGuessGame	中文描述
local EmbattleItemGuessGame = _G.BaseClass("EmbattleItemGuessGame", base)

---类的构造函数
function EmbattleItemGuessGame:__init(eType, saveType, notPassServer, mgpID, data)
    self.combinePosState = {0, 0, 0}
    self.curEmbattleInfo = data
    self:InitEmbattleData()
end

---类的析构函数
function EmbattleItemGuessGame:Dispose()
end

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemGuessGame:InitEmbattleData()
    if not self.curEmbattleInfo then
        return
    end
    self.curEmbattleData = {0, 0, 0, 0, 0}
    self.curEnemyEmbattleData = {0, 0, 0, 0, 0}
    local data
    local emdata = self.curEmbattleInfo.attacker_team[1]
    for i = 1, #self.curEmbattleData do
        data = emdata.fights[i]
        if data then
            self.curEmbattleData[i] = {
                uid = data.uid,
                sid = data.sid,
                star = data.star,
                level = data.lv,
                soulLink_lv = data.soul_chain_lv or 0,
                tag = 1
            }
        else
            self.curEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 1
            }
        end
    end
    emdata = self.curEmbattleInfo.defender_team[1]
    for i = 1, #self.curEnemyEmbattleData do
        data = emdata.fights[i]
        if data then
            self.curEnemyEmbattleData[i] = {
                uid = data.uid,
                sid = data.sid,
                star = data.star,
                level = data.lv,
                soulLink_lv = data.soul_chain_lv or 0,
                tag = 1
            }
        else
            self.curEnemyEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 1
            }
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
function EmbattleItemGuessGame:SetCombSkillData()
    local skill = self.curEmbattleInfo.attacker_team[1].combine_skill
    self.curCombSkillData = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        if skill[i] > 0 then
            self.curCombSkillData[i] = {
                id = skill[i],
                lv = 1,
                cskillID = skill[i],
                tag = 1
            }
        else
            self.curCombSkillData[i] = {
                id = 0,
                lv = 0,
                cskillID = 0,
                tag = 1
            }
        end
    end
end
---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemGuessGame:GetMyEmbattlePower(index)
    return self.curEmbattleInfo.attacker_team[1].power
end

---获取敌方战斗力
---@return number 战斗力
function EmbattleItemGuessGame:GetEnemyEmbattlePower()
    return self.curEmbattleInfo.defender_team[1].power
end

---获取布阵按钮是否展示
---@return boolean 是否可点
function EmbattleItemGuessGame:GetFormationClick()
    return false
end
---显示清空按钮
---@return boolean 是否显示清空按钮
function EmbattleItemGuessGame:ShowClearBtn()
    return false
end
---显示编队按钮
---@return boolean 是否显示编队按钮
function EmbattleItemGuessGame:ShowFormationBtn()
    return false
end
---获取合击技按钮是否可点
---@return boolean 是否可点
function EmbattleItemGuessGame:GetCombSkillBtnClick()
    return false
end

return EmbattleItemGuessGame
