---@param pos number 位置编号
---@return 变量类型 中文描述
function EmbattleItemDemoActivity:SetEmbattleDataSingle(index, uid, etIndex, pos)
    local uid1 = self.curEmbattleData[index].uid
    if self:CheckIsSpecialEmbattle(uid1) ~= 0 then
        return false
    end
