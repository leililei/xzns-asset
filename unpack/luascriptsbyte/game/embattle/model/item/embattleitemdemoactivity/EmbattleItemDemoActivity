function EmbattleItemDemoActivity:InitCardList()
    self.curChooseCardList = {}
    ---@type card_trial_cfg
    local sectioncfg = _G.ConfigManager.card_trial_cfg[self.activity:GetCurFightSectionId()]
    if sectioncfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("train_section_cfg sectionId is nil " .. tostring(self.Data.sectionId))
        end
        return
    end

    local monster_cfg = _G.ConfigManager.monster_cfg
    local monster_cfgItem
    local cardlist = {}
    if not _G.table.isEmptyOrNil(sectioncfg.cards_usable) then
        for i = 1, #sectioncfg.cards_usable do
            if sectioncfg.cards_usable[i] > 0 then
                _G.table.insert(cardlist, sectioncfg.cards_usable[i])
            end
        end
    end
    if not _G.table.isEmptyOrNil(sectioncfg.format_swap) then
        for i = 1, #sectioncfg.format_swap do
            if sectioncfg.format_swap[i] > 0 then
                _G.table.insert(cardlist, sectioncfg.format_swap[i])
            end
        end
    end
    for _, monsterid in pairs(cardlist) do
        monster_cfgItem = monster_cfg[monsterid]
        if monster_cfgItem == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("monster_cfg monsterid No Find " .. tostring(monsterid))
            end
        else
            local carddata = EmbattleItemDemoTemporaryCardData.New(monster_cfgItem)
            _G.table.insert(self.curChooseCardList, carddata)
        end
    end
    self:SortCardList()
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemDemoActivity:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end

    self.activity:SetGarray(sits)
    self:OnSaveEnd(0)
    sits = nil
end

function EmbattleItemDemoActivity:GetCurEmbattleType()
    return self.curEmbattleType, _G.handler(self, self.CheckBattle)
end

---检测是否可以出战(当前挑战的有上阵角色便可以出战)
---@return boolean|number 是否显示|哪一组未上阵角色
function EmbattleItemDemoActivity:CheckBattle()
    return self.activity:CheckCanFight()
end

function EmbattleItemDemoActivity:SetCombSkillData(data, index)
    self.curCombSkillData = self:GetSkillIndex(self.curEmbattleType)
    local skill
    for i = 1, #self.curCombSkillData do
        skill = {
            id = 0,
            lv = 0,
            cskillID = 0,
            tag = 0
        }
        self.curCombSkillData[i] = skill
    end
end

