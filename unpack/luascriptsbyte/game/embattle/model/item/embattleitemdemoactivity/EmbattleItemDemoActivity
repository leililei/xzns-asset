---@class EmbattleItemDemoTemporaryCardData
local EmbattleItemDemoTemporaryCardData = _G.BaseClass("EmbattleItemDemoTemporaryCardData")
---@param cfg monster_cfg
function EmbattleItemDemoTemporaryCardData:__init(cfg)
    self.uid = cfg.id
    self.sid = cfg.CardID
    self.cfg = _G.ConfigManager.card_cfg[self.sid]
    self.level = cfg.Level
    self.star = cfg.Stars
    self.power = cfg.Power
end
function EmbattleItemDemoTemporaryCardData:Dispose()
    self.uid = nil
    self.sid = nil
    self.cfg = nil
    self.level = nil
    self.star = nil
    self.power = nil
end
function EmbattleItemDemoTemporaryCardData:GetLevel()
    return self.level
end
function EmbattleItemDemoTemporaryCardData:GetStar()
    return self.star
end

function EmbattleItemDemoTemporaryCardData:GetPower()
    return self.power
end
local base = require "EmbattleItemPVE"
---@class EmbattleItemDemoActivity : EmbattleItemPVE
---@field activity DemoActivityModel
local EmbattleItemDemoActivity = _G.BaseClass("EmbattleItemDemoActivity", base)
---类的构造函数
function EmbattleItemDemoActivity:__init(eType, saveType, notPassServer, mgpID, activity)
    self.activity = activity
    self:InitEmbattleData()
end

function EmbattleItemDemoActivity:InitEmbattleData()
    self.curEmbattleData = self.curEmbattleData or {false, false, false, false, false}
    self.curUids = {}
    self.curSids = {}
    self:InitSpecialEmbattleMove()
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    local data = EmbattleModelIns:GetEmbattleData(self.curEmbattleType)
    for j = 1, #self.curEmbattleData do
        if not self.curEmbattleData[j] then --使用布阵数据
            local ed = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 0
            }
            self.curEmbattleData[j] = ed
            if data[j] > 0 then
                local card = self:GetCardData(data[j])
                if not self.curSids[card.sid] then
                    ed.uid = card.uid
                    ed.sid = card.sid
                    ed.star = card:GetStar()
                    ed.level = card:GetLevel()
                    ed.soulLink_lv = card.soulLink_lv
                    ed.tag = 0
                    self.curUids[card.uid] = true
                    self.curSids[card.sid] = true
                end
            end
        elseif self.curEmbattleData[j].uid > 0 then --会运行两次初始化
            self.curUids[self.curEmbattleData[j].uid] = true
            self.curSids[self.curEmbattleData[j].sid] = true
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end

---初始化 固定阵容 可移动
function EmbattleItemDemoActivity:InitSpecialEmbattleMove()
    if not self.activity then
        return
    end
    local cfg = _G.ConfigManager.card_trial_cfg[self.activity:GetCurFightSectionId()]
    if cfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("card_trial_cfgg id is nil " .. tostring(self.activity:GetCurFightSectionId()))
        end
        return
    end
    local data = {}
    self.notDownList = {}
    if not _G.table.isEmptyOrNil(cfg.format_swap) then
        for i = 1, #cfg.format_swap do
            _G.table.insert(data, cfg.format_swap[i])
            self.notDownList[cfg.format_swap[i]] = true
        end
    else
        return
    end
    for j = 1, #self.curEmbattleData do
        if self.curEmbattleData[j] then --使用布阵数据
            if data[j] and data[j] > 0 then
                local card = self:GetCardData(data[j])
                if not self.curSids[card.sid] then
                    self.curEmbattleData[j].uid = card.uid
                    self.curEmbattleData[j].sid = card.sid
                    self.curEmbattleData[j].star = card:GetStar()
                    self.curEmbattleData[j].level = card:GetLevel()
                    self.curEmbattleData[j].soulLink_lv = card.soulLink_lv
                    self.curUids[card.uid] = true
                    self.curSids[card.sid] = true
                end
            end
        end
    end
end

---检测卡牌是否可操作（特殊阵容，固定不可移动，固定可移动）
function EmbattleItemDemoActivity:CheckCardHandle(uid)
    local num = self:CheckIsSpecialEmbattle(uid)
    if num ~= 0 then
        if num == 1 then
            _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90024300055))
        else
            _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90024300054))
        end
        return false, num
    end
    return self.super.CheckCardHandle(self, uid)
end

---特殊阵容 ( 1= 固定不可以移动，0 =  正常，-1 = 固定可以移动)
---@return 0,1 -1
function EmbattleItemDemoActivity:CheckIsSpecialEmbattle(uid)
    if self.activity == nil then
        return 0
    end
    local sectioncfg = _G.ConfigManager.card_trial_cfg[self.activity:GetCurFightSectionId()]
    if sectioncfg == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("train_section_cfg sectionId is nil " .. tostring(self.Data.sectionId))
        end
        return 0
    end
    if self.notDownList and self.notDownList[uid] then
        return -1
    end
    return 0
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return EmbattleItemTrainTemporaryCardData 卡牌数据对象
function EmbattleItemDemoActivity:GetCardData(uid)
    local cfg = _G.ConfigManager.monster_cfg[uid]
    if cfg == nil then
        return nil
    end
    return EmbattleItemDemoTemporaryCardData.New(cfg)
end

---@return boolean 是否显示编队按钮
function EmbattleItemDemoActivity:ShowFormationBtn()
    return false
end

---清空
---@param index number 编号(针对多布阵数据  挂机副本)
function EmbattleItemDemoActivity:ClearEmbattle(index)
    if self.curEmbattleData == nil then
        return
    end
    _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90024300054))
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.tag == 0 then
            local num = self:CheckIsSpecialEmbattle(card.uid)
            if card.uid > 0 then
                if num == 0 then
                    self:SetCurUids(card.uid, false)
                    self:SetCurSids(card.sid, false)
                end
            end
            if num == 0 then
                card.uid = 0
                card.sid = 0
                card.level = 0
                card.star = 0
                card.soulLink_lv = 0
            end
        end
    end
    if not self.curCombSkillData then
        return
    end
    local skill
    for i = 1, #self.curCombSkillData do
        skill = self.curCombSkillData[i]
        if skill.tag == 0 then
            skill.id = 0
            skill.lv = 0
            skill.cskillID = 0
        end
    end
end

---获取第一个空的位置
---@param index number 多布阵序列号
---@return number 空序列
function EmbattleItemDemoActivity:GetFirstEmptyIndex(etIndex, index)
    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
        if count >= (self.Poslimit * 2) then
            return 0
        end
    end
    return base.GetFirstEmptyIndex(self, index)
end
---获取可上阵人数
function EmbattleItemDemoActivity:GetEmbattleCount()
    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
        if count >= self.Poslimit then
            return 0
        end
    end
    return self.Poslimit - count
end

