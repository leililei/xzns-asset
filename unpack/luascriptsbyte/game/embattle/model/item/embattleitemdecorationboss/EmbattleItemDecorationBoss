local EmbattleItemPVE = require("EmbattleItemPVE")
---@class EmbattleItemDecorationBoss : EmbattleItemPVE	终焉之末
local EmbattleItemDecorationBoss = _G.BaseClass("EmbattleItemDecorationBoss", EmbattleItemPVE)

function EmbattleItemDecorationBoss:__init(eType, saveType, notPassServer, mgpID)
    self.AttackName = "DecorationBoss"
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemDecorationBoss:InitCardList()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self.curChooseCardList = _G.table.toArray(cards)
    self:SortCardList()
end

function EmbattleItemDecorationBoss:OnSaveEnd(result)
    if result == 0 then
        require("EmbattleModel"):GetInstance():SaveEmbattleDataTable(
            { self.curEmbattleType },
            nil,
            nil,
            _G.EmbattleSaveType.localfile
        )
    end
    EmbattleItemPVE.OnSaveEnd(self, result)
end

---获取挑战按钮文字图片名字
---@return string 按钮文字图片名字
function EmbattleItemDecorationBoss:GetBattleImageName()
    return "ui_bz_btn_txt_zhandou"
end

function EmbattleItemDecorationBoss:GetCacheModelInBattle()
    return true
end

---终焉之末不显示宠物技能
function EmbattleItemDecorationBoss:GetPetSkillState()
    return { false, false }
end

---展示跳过战斗按钮
---@return boolean
function EmbattleItemDecorationBoss:GetShowSkip()
    return true
end

---获取敌方阵容战力,不展示boss战力，所以返回0
function EmbattleItemDecorationBoss:GetEnemyEmbattlePower()
    return 0
end

return EmbattleItemDecorationBoss
