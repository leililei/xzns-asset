---@class EmbattleItemSystemFairyland:EmbattleItemPVE	中文描述
local EmbattleItemSystemFairyland = _G.BaseClass("EmbattleItemSystemFairyland", require "EmbattleItemPVE")
---类的构造函数

function EmbattleItemSystemFairyland:__init(eType, saveType, notPassServer, mgpID, cfg)
    self.cfg = cfg
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemSystemFairyland:InitCardList()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    self.curChooseCardList = _G.table.toArray(cards)
    self:SortCardList()
end

function EmbattleItemSystemFairyland:GetCurEmbattleType()
    return self.curEmbattleType, _G.handler(self, self.CheckFight)
end

function EmbattleItemSystemFairyland:CheckFight()
    return true
end

---一键上阵规则
---逻辑较复杂，修改需谨慎!!!!!!!!!!!!!!!!!
function EmbattleItemSystemFairyland:GetAutoEmbattleData(cardList, curEmbattleIndex)
    ---@type FightStarEnum 条件类型枚举
    local FSE = require("SystemFairylandModel"):GetInstance().fightStarEnum
    local frontRow = {
        [1] = true,
        [2] = true
    }
    local backRow = {
        [3] = true,
        [4] = true,
        [5] = true
    }
    local backSort = {3, 4, 5, 1, 2}
    local oldEmbattleData = self:GetEmbattleData(curEmbattleIndex)
    local emNum = #oldEmbattleData

    ---生成所有条件判定字典
    local eleConDic = {} --种族数判定范围
    local proConDic = {} --职业数判定范围
    local otherDic = {} --其它判定范围
    local conIds = self.cfg.star_condition[2]
    local system_trial_star_cfg = _G.ConfigManager.system_trial_star_cfg
    local v
    for _, _id in pairs(conIds) do
        v = system_trial_star_cfg[_id].condition[1]
        if v[1] == FSE.leastEle then
            if eleConDic[v[3]] == nil then
                eleConDic[v[3]] = {0, 10000, 0} --最小值，最大值，当前值
            end
            eleConDic[v[3]][1] = _G.Mathf.Max(v[2], eleConDic[v[3]][1])
        elseif v[1] == FSE.mostEle then
            if eleConDic[v[3]] == nil then
                eleConDic[v[3]] = {0, 10000, 0}
            end
            eleConDic[v[3]][2] = _G.Mathf.Min(v[2], eleConDic[v[3]][2])
        elseif v[1] == FSE.leastPro then
            if proConDic[v[3]] == nil then
                proConDic[v[3]] = {0, 10000, 0}
            end
            proConDic[v[3]][1] = _G.Mathf.Max(v[2], proConDic[v[3]][1])
        elseif v[1] == FSE.mostPro then
            if proConDic[v[3]] == nil then
                proConDic[v[3]] = {0, 10000, 0}
            end
            proConDic[v[3]][2] = _G.Mathf.Min(v[2], proConDic[v[3]][2])
        elseif v[1] == FSE.allPro then
            proConDic[v[2]][2] = #oldEmbattleData
        elseif v[1] == FSE.noPro then
            for i = 2, 3 do
                if proConDic[v[i]] == nil then
                    proConDic[v[i]] = {0, 10000, 0}
                end
                proConDic[v[i]][2] = 0
            end
        elseif v[1] == FSE.mulEle then
            for i = 3, 6 do
                if eleConDic[v[i]] == nil then
                    eleConDic[v[i]] = {0, 10000, 0}
                end
                eleConDic[v[i]][1] = _G.Mathf.Max(1, eleConDic[v[i]][1])
            end
        elseif v[1] == FSE.diffEle then
            if otherDic.diffEleDic == nil then
                otherDic.diffEleDic = {0, 0} --至多容许几个重复种族，当前重复数量
            end
            otherDic.diffEleDic[1] = _G.Mathf.Min(emNum - v[2], otherDic.diffEleDic[1])
        elseif v[1] == FSE.appoint2 then --指定sid卡
            if otherDic.sidDic == nil then
                otherDic.sidDic = {} --sid调
            end
            otherDic.sidDic[v[2]] = true
            otherDic.sidDic[v[3]] = true
        elseif v[1] == FSE.leastOrder then
            if otherDic.orderDic == nil then
                otherDic.orderDic = {}
            end
            if otherDic.orderDic[v[3]] == nil then
                otherDic.orderDic[v[3]] = {0, 0} --需求数量，当前数量
            end
            otherDic.orderDic[v[3]][1] = _G.Mathf.Max(otherDic.orderDic[v[3]][1], v[2])
        elseif v[1] == FSE.leastStar then
            if otherDic.starDic == nil then
                otherDic.starDic = {}
            end
            if otherDic.starDic[v[3]] == nil then
                otherDic.starDic[v[3]] = {0, 0} --需求数量，当前数量
            end
            otherDic.starDic[v[3]][1] = _G.Mathf.Max(otherDic.starDic[v[3]][1], v[2])
        end
    end

    if otherDic.sidDic then
        ---按照需要的卡，战力上阵前5名角色
        _G.SortList(
            cardList,
            function(data)
                return otherDic.sidDic[data.sid] and 1 or 0, data.power
            end
        )
    else
        ---按照战力上阵前5名角色
        _G.SortList(
            cardList,
            function(data)
                return data.power
            end
        )
    end

    ---单卡是否需求检测方法
    local CheckCon = function(card)
        local checkDic = {}
        local con = eleConDic[card:GetElement()]
        if con ~= nil then
            if con[3] < con[1] then
                checkDic.ele = true
            elseif con[3] >= con[2] then
                return false
            end
        end
        con = proConDic[card:GetProfessional()]
        if con ~= nil then
            if con[3] < con[1] then
                checkDic.pro = true
            elseif con[3] >= con[2] then
                return false
            end
        end
        con = otherDic.diffEleDic
        if con ~= nil then
            if con[2] < con[1] then
                checkDic.diffEle = true
            else
                return false
            end
        end
        if otherDic.orderDic then
            checkDic.orderDic = {}
            for order, orderDic in pairs(otherDic.orderDic) do
                if card:GetGrade() >= order and orderDic[2] < orderDic[1] then
                    checkDic.orderDic[order] = true
                elseif card:GetGrade() < order then
                    return false
                end
            end
        end
        if otherDic.starDic then
            checkDic.starDic = {}
            for star, starDic in pairs(otherDic.starDic) do
                if card:GetStar() >= star and starDic[2] < starDic[1] then
                    checkDic.starDic[star] = true
                elseif card:GetStar() < star then
                    return false
                end
            end
        end

        if _G.table.isEmptyOrNil(checkDic) then
            return false
        end
        if checkDic.ele then
            con = eleConDic[card:GetElement()]
            con[3] = con[3] + 1
        end
        if checkDic.pro then
            con = proConDic[card:GetProfessional()]
            con[3] = con[3] + 1
        end
        if checkDic.orderDic then
            for k, v in pairs(checkDic.orderDic) do
                otherDic.orderDic[k][2] = otherDic.orderDic[k][2] + 1
            end
        end
        if checkDic.starDic then
            for k, v in pairs(checkDic.starDic) do
                otherDic.starDic[k][2] = otherDic.starDic[k][2] + 1
            end
        end
        if checkDic.diffEle then
            if not otherDic.tempEleNum then
                otherDic.tempEleNum = {}
            end
            local ele = card:GetElement()
            if not otherDic.tempEleNum[ele] then
                otherDic.tempEleNum[ele] = 1
            else
                otherDic.tempEleNum[ele] = otherDic.tempEleNum[ele] + 1
            end
            local maxDiff = 0
            for _, v in pairs(otherDic.tempEleNum) do
                if v > 1 then
                    maxDiff = maxDiff + v - 1
                end
            end
            otherDic.diffEleDic[2] = maxDiff
        end
        return true
    end

    ---遍历并分类
    local cardSidList = {}
    local newOtherCardList = {} --非任务刚需卡
    local newTaskCardList = {} --任务刚需卡
    local flag
    for _, v in pairs(cardList) do
        if not cardSidList[v.sid] then
            if self:CheckCardAssist(v.uid) then
                local use, max = self:GetAssistNum(v.uid)
                if use < max then
                    flag = CheckCon(v)
                    _G.table.insert(flag and newTaskCardList or newOtherCardList, v)
                    cardSidList[v.sid] = true
                end
            else
                flag = CheckCon(v)
                _G.table.insert(flag and newTaskCardList or newOtherCardList, v)
                cardSidList[v.sid] = true
            end
        end
    end

    local delta = emNum - #newTaskCardList

    if delta < 0 then --满足任务的卡数量大于布阵所需的n张，只取前n
        newTaskCardList =
            _G.table.chooseToArray(
            newTaskCardList,
            function(k, v)
                return k <= emNum
            end
        )
    end
    local conE
    local conP
    local flag
    if delta > 0 then --满足任务的卡不足以填满布阵，从非刚需里取
        for i, v in pairs(newOtherCardList) do
            flag = true
            conE = eleConDic[v:GetElement()]
            conP = proConDic[v:GetProfessional()]
            if conE ~= nil and conE[3] >= conE[2] then
                flag = false
            end
            if conP ~= nil and conP[3] >= conP[2] then
                flag = false
            end
            if otherDic.diffEleDic and otherDic.diffEleDic[2] >= otherDic.diffEleDic[1] then
                if otherDic.tempEleNum and otherDic.tempEleNum[v:GetElement()] and otherDic.tempEleNum[v:GetElement()] > 0 then
                    flag = false
                end
            end

            if flag then --非刚需的卡不能使任务条件失效（如至多xx类型）
                _G.table.insert(newTaskCardList, v)
                if conE then
                    conE[3] = conE[3] + 1
                end
                if conP then
                    conP[3] = conP[3] + 1
                end
                if otherDic.diffEleDic then
                    if not otherDic.tempEleNum then
                        otherDic.tempEleNum = {}
                    end
                    local ele = v:GetElement()
                    if not otherDic.tempEleNum[ele] then
                        otherDic.tempEleNum[ele] = 1
                    else
                        otherDic.tempEleNum[ele] = otherDic.tempEleNum[ele] + 1
                    end
                    local maxDiff = 0
                    for _, v in pairs(otherDic.tempEleNum) do
                        if v > 1 then
                            maxDiff = maxDiff + v - 1
                        end
                    end
                    otherDic.diffEleDic[2] = maxDiff
                end

                delta = delta - 1
                if delta <= 0 then
                    break
                end
            end
        end
    end

    _G.SortList(
        newTaskCardList,
        function(data)
            return data.power
        end
    )

    local newEmbattleData = {}
    for index, v in ipairs(oldEmbattleData) do
        local _cardData = newTaskCardList[index]
        if _cardData then
            if frontRow[_cardData.cfg.Distance] then
                ---检查前排是否还有位置
                for i = 1, 5 do
                    if not newEmbattleData[i] then
                        newEmbattleData[i] = _cardData
                        break
                    end
                end
            elseif backRow[_cardData.cfg.Distance] then
                for i = 1, 5 do
                    if not newEmbattleData[backSort[i]] then
                        newEmbattleData[backSort[i]] = _cardData
                        break
                    end
                end
            end
        else
            break
        end
    end
    return oldEmbattleData, newEmbattleData
end

return EmbattleItemSystemFairyland
