local EmbattleItemPVP = require "EmbattleItemPVP"

---@class EmbattleItemDungones	中文描述
local EmbattleItemDungones = _G.BaseClass("EmbattleItemDungones", EmbattleItemPVP)

---类的构造函数
function EmbattleItemDungones:__init(eType, saveType, notPassServer, mgpID, data, skipBattle)
    self.skipBattle = skipBattle or false
    self.AttackName = "Dungones"
end

---类的析构函数
function EmbattleItemDungones:Dispose()
    self.groupCardList = nil
end

--region 重写方法

---获取编队界面卡牌列表
---@return table 卡牌列表
function EmbattleItemDungones:GetGroupCardList()
    return self.groupCardList
end
---初始化敌方布阵数据
function EmbattleItemDungones:InitEmbattleData(sits, index)
    EmbattleItemPVP.InitEmbattleData(self, sits, index)
    self.curUids = {}
    self.curSids = {}
    local temp = {}
    local hasDead
    for i = 1, #self.curEmbattleData do
        local uid = self.curEmbattleData[i].uid
        if uid > 0 then
            local hpmp = require "DungonesModel":GetInstance():GetHPMP(uid)
            if hpmp.hp > 0 then
                temp[i] = self.curEmbattleData[i]
                self.curUids[temp[i].uid] = true
            else
                hasDead = true
                temp[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    tag = 0
                }
            end
        else
            temp[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                tag = 0
            }
        end
    end
    self.curEmbattleData = temp
    if hasDead then
        _G.PopWindowManager:GetInstance():ShowAllTips(1318)
    end
end

function EmbattleItemDungones:InitEnemyEmbattleData()
    if self.curEnemyEmbattleData == nil then
        return
    end
    EmbattleItemPVP.InitEnemyEmbattleData(self)
    --region 判定是不是 千机最后的 boss
    local embattle_sectioninfo = require "DungonesModel":GetInstance():GetSectionIDEmbattleInfo()
    local flagBoss = false
    local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
    if embattle_sectioninfo.sid == bossid then
        flagBoss = true
    end
    --endregion
    local temp = {}
    for i = 1, #self.curEnemyEmbattleData do
        local uid = self.curEnemyEmbattleData[i].uid
        if uid > 0 then
            if flagBoss then
                temp[i] = self.curEnemyEmbattleData[i]
            else
                local hpmp = require "DungonesModel":GetInstance():GetHPMPEmbattleEnemy(uid)
                if hpmp.hp > 0 then
                    temp[i] = self.curEnemyEmbattleData[i]
                else
                    temp[i] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        tag = 0
                    }
                end
            end
        else
            temp[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                tag = 0
            }
        end
    end
    self.curEnemyEmbattleData = temp
end

---千机黑煞检测 是否 有空位，并且 是否 还有卡牌
function EmbattleItemDungones:CheckEmptyPos()
    if self:GetIntoCount() > 0 then
        local temp_check_cardlist = {}
        local list = self:GetCardList()
        for i = 1, #list do
            local flag = false
            local card = list[i]
            local hpmp = require "DungonesModel":GetInstance():GetHPMP(card.uid)
            for j = 1, #self.curEmbattleData do
                if card.uid == self.curEmbattleData[j].uid then
                    flag = true
                    break
                end
            end
            if not flag and hpmp.hp > 0 then
                _G.table.insert(temp_check_cardlist, card)
            end
        end
        if _G.table.isEmptyOrNil(temp_check_cardlist) then
            return 0
        end
    else
        return 0
    end
    return EmbattleItemPVP.CheckEmptyPos(self)
end
---当前上阵的 数量
function EmbattleItemDungones:GetIntoCount()
    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
    end
    return count
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemDungones:CheckCardLock(uid, index)
    local hpmp = require "DungonesModel":GetInstance():GetHPMP(uid)
    if hpmp.hp <= 0 then
        return 3
    else
        return self.super.CheckCardLock(self, uid, index)
    end
end
-- ---重写父类的 ,获得卡牌的数据方法
function EmbattleItemDungones:GetCardData(uid)
    local data = self.super.GetCardData(self, uid)
    if data then
        return data
    else
        local DungonesModel = require "DungonesModel":GetInstance()
        local dungones_aid_cards = DungonesModel.dungones_aid_cards
        if dungones_aid_cards then
            for i = 1, #dungones_aid_cards do
                if dungones_aid_cards[i].uid == uid then
                    return dungones_aid_cards[i]
                end
            end
            return data
        else
            return data
        end
    end
end
---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemDungones:InitCardList()
    local DungonesModel = require "DungonesModel":GetInstance()
    self.storyCardList = {}
    local dungones_aid_cards = DungonesModel.dungones_aid_cards
    self.storyCardList = dungones_aid_cards
    self.super.InitCardList(self)
    self.groupCardList = {}
    for i = 1, #self.curChooseCardList do
        self.groupCardList[i] = self.curChooseCardList[i]
    end
    if self.storyCardList then
        _G.table.sort(self.storyCardList, _G.handler(self, self.SortCardListFunc))
        local insert = _G.table.insert
        for i = #self.storyCardList, 1, -1 do
            insert(self.curChooseCardList, 1, self.storyCardList[i])
        end
    end
    local hp
    for i = #self.curChooseCardList, 1, -1 do
        hp = DungonesModel:GetHPMP(self.curChooseCardList[i].uid)
        self.curChooseCardList[i].hp = hp.hp * 0.0001
    end
end
---检测编队界面是否展示锁住
---@param uid number 卡牌Uid
---@return boolean 是否展示锁
function EmbattleItemDungones:CheckGroupFormationLock(uid)
    return false
end

---是否显示卡牌列表血量
---@return boolean 是否显示卡牌列表中血量
function EmbattleItemDungones:ShowCardHP()
    return true
end
---获取敌方战斗力
---@return number 战斗力
function EmbattleItemDungones:GetEnemyEmbattlePower()
    local power = 0
    local CurEventId = require "DungonesModel":GetInstance().CurEventId
    local levelData = require "DungonesModel":GetInstance().DungonesInfo.adventures
    local bossid = _G.ConfigManager.discrete_cfg[103404][1][1]
    for i = 1, #levelData do
        ---临时 判断不是 最后的 boss
        if levelData[i].sid == CurEventId then
            if levelData[i].sid ~= bossid then
                power = levelData[i].defender_team[1].power
            else
                power = 0
            end
            break
        end
    end
    return power
end

---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemDungones:GetMyEmbattlePower(index,isView)
    local power = 0
    local uid = 0
    local card = nil
    for i = 1, #self.curEmbattleData do
        uid = self.curEmbattleData[i].uid
        if uid > 0 then
            card = self:GetCardData(uid)
            power = power + card:GetPower(isView)
        end
    end
    uid = nil
    card = nil
    --添加遗物战斗力增加百分比
    local num = require "DungonesModel":GetInstance():AddPower()
    local t1, t2 = _G.math.modf(tonumber(power + power * num))
    power = t1
    return power
end

---展示跳过战斗按钮
---@return boolean
function EmbattleItemDungones:GetShowSkip()
    return self.skipBattle
end

--region扩展
function EmbattleItemDungones:GetCardHPPer(uid)
    return require "DungonesModel":GetInstance():GetHPMP(uid).hp * 0.0001
end
--endregion

--endregion

function EmbattleItemDungones:ShowFormationBtn()
    return false
end


return EmbattleItemDungones
