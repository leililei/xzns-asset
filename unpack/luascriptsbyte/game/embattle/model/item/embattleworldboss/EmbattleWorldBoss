--region override pet function
function EmbattleWorldBoss:SetPetSkillData(data, index)
    if data then
        if not self.curPetSkillData then
            self.curPetSkillData = {}
        end
        local pets = self.curPetSkillData[index]
        if not pets then
            pets = {}
            self.curPetSkillData[index] = pets
        end
        for i = 1, #data do
            pets[i] = data[i]
        end
    else
        self.curPetSkillData = {}
        for i = 1, #self.curEmbattleType do
            self.curPetSkillData[i] = self:GetPetSkillIndex(self.curEmbattleType[i])
        end
    end
end

function EmbattleWorldBoss:GetPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    return self.curPetSkillData[index]
end

function EmbattleWorldBoss:GetOtherGroupPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.monsterGroupID do
        if i ~= index and self.curPetSkillData[i] then
            local data = self.curPetSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleWorldBoss:SetBeastSkillData(data, index)
    if data then
        if not self.curBeastSkillData then
            self.curBeastSkillData = {}
        end
        local beasts = self.curBeastSkillData[index]
        if not beasts then
            beasts = {}
            self.curBeastSkillData[index] = beasts
        end
        for i = 1, #data do
            beasts[i] = data[i]
        end
    else
        self.curBeastSkillData = {}
        for i = 1, #self.curEmbattleType do
            self.curBeastSkillData[i] = self:GetBeastSkillIndex(self.curEmbattleType[i])
        end
    end
end

function EmbattleWorldBoss:GetBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    return self.curBeastSkillData[index]
end

function EmbattleWorldBoss:GetOtherGroupBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.monsterGroupID do
        if i ~= index and self.curBeastSkillData[i] then
            local data = self.curBeastSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleWorldBoss:ClearEmbattle(index)
    local curData = self.curPetSkillData
    local beastData = self.curBeastSkillData
    base.ClearEmbattle(self, index)
    if curData then
        curData[index] = nil
        self.curPetSkillData = curData
    end
    if _G.AppSetting.IsXzns then
        if beastData then
            beastData[index] = nil
            self.curBeastSkillData = beastData
        end
    end
end

--endregion

return EmbattleWorldBoss
