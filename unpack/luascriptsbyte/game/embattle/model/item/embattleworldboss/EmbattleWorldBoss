local base = require "EmbattleItemGroup"
---@class EmbattleSeasonBoss:EmbattleItemGroup	中文描述
local EmbattleWorldBoss = _G.BaseClass("EmbattleWorldBoss", base)

---类的构造函数
function EmbattleWorldBoss:__init(eType, saveType, notPassServer, mgpID, enemy, skipBattle)
    self.enemy = enemy
    self.skipBattle = skipBattle
    self.AttackName = "WorldBoss"
end

---类的析构函数
function EmbattleWorldBoss:Dispose()
end

---初始化布阵数据
function EmbattleWorldBoss:InitEmbattleData(sits, index)
    if sits then
        self.curUids[index] = {}
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not self:CheckUidInEmbattle(sit.uid) and not self:CheckSidInEmbattle(sit.sid) then --不在其他阵容并且没有相同SID上阵
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    self.curEmbattleData = {}
    self.curUids = {}
    self.curSids = {}
    for i = 1, #self.curEmbattleType do
        self.curEmbattleData[i] = false
        self.curUids[i] = false
        self.curSids[i] = false
    end
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    for i = 1, #self.curEmbattleType do
        self.curEmbattleData[i] = self:GetServerEmbattleData(self.curEmbattleType[i], i)
        local uids = {}
        local sids = {}
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j] > 0 then
                local card =
                    _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.curEmbattleData[i][j])
                if card then
                    self.curEmbattleData[i][j] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        power = card:GetPower(),
                        tag = 0
                    }
                    uids[card.uid] = true
                    sids[card.sid] = true
                else
                    self.curEmbattleData[i][j] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        power = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i][j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        end
        self.curUids[i] = uids
        self.curSids[i] = sids
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
    if _G.AppSetting.IsXzns then
        self:SetBeastSkillData()
    end
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleWorldBoss:CheckCardLock(uid, index)
    if self:CheckUidInEmbattle(uid, index) then --当前布阵上阵
        return 1
    end
    for i = 1, #self.curUids do
        if index ~= i then
            if self.curUids[i][uid] then --别的组上阵
                return 2, 220102, i
            end
        end
    end
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    for j = 1, #self.curEmbattleData do
        for i = 1, #self.curEmbattleData[j] do
            if self.curEmbattleData[j][i].sid == card.sid then --sid重复
                return 2, 140101
            end
        end
    end
    return 1
end

---初始化敌方布阵数据
function EmbattleWorldBoss:InitEnemyEmbattleData()
    if not self.enemy then
        return
    end

    self.curEnemyEmbattleData = {}
    for i = 1, #self.enemy do
        self.curEnemyEmbattleData[i] = false
    end
    local card
    local cfg
    local cfgs = _G.ConfigManager.card_cfg
    for i = 1, #self.enemy do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            card = self.enemy[i][j]
            if card.sid > 0 then
                cfg = cfgs[card.sid]
            else
                cfg = nil
            end
            data[j] = {
                uid = card.sid,
                sid = card.sid,
                level = card.level,
                star = card.star,
                soulLink_lv = card.soulLV,
                power = card.power,
                scale = cfg and cfg.GlobalScale * 0.0001 or 1
            }
        end
        self.curEnemyEmbattleData[i] = data
    end
end

---获取当前布阵id
---@return number 布阵id
function EmbattleWorldBoss:GetCurEmbattleType(index)
    index = index or self.embattleIndex
    return self.curEmbattleType[index], _G.handler(self, self.CheckBattle)
end

---检测是否可以出战
function EmbattleWorldBoss:CheckBattle()
    local num = 0
    for j = 1, #self.curEmbattleData do
        for i = 1, #self.curEmbattleData[j] do
            if self.curEmbattleData[j][i].sid > 0 then
                num = num + 1
                break
            end
        end
        if num ~= j then
            return false, j
        end
    end
    return true
end

function EmbattleWorldBoss:ChangeGroup(indexes)
    local items = {self.curEmbattleData[1], self.curEmbattleData[2], self.curEmbattleData[3]}
    local skills = {self.curCombSkillData[1], self.curCombSkillData[2], self.curCombSkillData[3]}
    local petSkills = {self.curPetSkillData[1], self.curPetSkillData[2], self.curPetSkillData[3]}
    local beastSkills
    if _G.AppSetting.IsXzns then
        beastSkills = {self.curBeastSkillData[1], self.curBeastSkillData[2], self.curBeastSkillData[3]}
    end
    for i = 1, #indexes do
        self.curEmbattleData[i] = items[indexes[i]]
        self.curCombSkillData[i] = skills[indexes[i]]
        self.curPetSkillData[i] = petSkills[indexes[i]]
        if _G.AppSetting.IsXzns then
            self.curBeastSkillData[i] = beastSkills[indexes[i]]
        end
        self.curChangeEmbattleIndexes[i] = true
    end
    items = {self.curUids[1], self.curUids[2], self.curUids[3]}
    for i = 1, #indexes do
        self.curUids[i] = items[indexes[i]]
    end
    items = {self.curSids[1], self.curSids[2], self.curSids[3]}
    for i = 1, #indexes do
        self.curSids[i] = items[indexes[i]]
    end
    return true
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
function EmbattleWorldBoss:SetCombSkillData(data, index, swapData)
    if data then
        local dic
        for i = 1, #data do
            dic = self.curCombSkillData[index][i]
            if data[i].tag == 0 then
                dic.id = data[i].id
                dic.lv = data[i].lv
                dic.cskillID = data[i].cskillID
            end
        end
        if swapData then
            local data
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        data = swapData[self.curCombSkillData[i][j].id]
                        if data then
                            self.curCombSkillData[i][j] = data
                        end
                    end
                end
            end
        end
    else
        self.curCombSkillData = {}
        for i = 1, #self.curEmbattleType do
            self.curCombSkillData[i] = false
        end
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        local CombineModelIns = require("CombineModel"):GetInstance()
        local cfgs = _G.ConfigManager.combine_cfg
        local id
        for i = 1, #self.curEmbattleType do
            local skill = EmbattleModelIns:GetSkillIndex(self.curEmbattleType[i])
            for j = 1, #skill do
                id = skill[j]
                skill[j] = {
                    id = id,
                    lv = 0,
                    tag = 0,
                    cskillID = 0
                }
                if id > 0 then
                    skill[j].lv = CombineModelIns:GetCombineLevel(id)
                    skill[j].cskillID = cfgs[skill[j].id].skills[skill[j].lv]
                end
            end
            self.curCombSkillData[i] = skill
        end
    end
end

function EmbattleWorldBoss:GetShowMoreFormation()
    return #self.curEmbattleType > 1
end

---展示跳过战斗按钮
---@return boolean
function EmbattleWorldBoss:GetShowSkip()
    return self.skipBattle
end

---获取是否缓存角色模型资源
---跳过战斗时不用立即销毁场景, 将导致出现几秒的黑屏
function EmbattleWorldBoss:GetCacheModelInBattle()
    return self:IsSkipBattle()
end

