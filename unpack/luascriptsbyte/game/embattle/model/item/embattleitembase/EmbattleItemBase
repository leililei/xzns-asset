---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemBase:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local skills = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local pets = {0, 0, 0}
    if self.curPetSkillData then
        for i = 1, #self.curPetSkillData do
            pets[i] = self.curPetSkillData[i]
        end
    end
    local beasts = {0, 0, 0}
    if _G.AppSetting.IsXzns then
        if self.curBeastSkillData then
            for i = 1, #self.curBeastSkillData do
                beasts[i] = self.curBeastSkillData[i]
            end
        end
    end
    
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    EmbattleModelIns:SetSkillIndex(self.curEmbattleType, skills)
    EmbattleModelIns:SetPetSkillIndex(self.curEmbattleType, pets)
    if _G.AppSetting.IsXzns then
        EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType, beasts)
    end
    EmbattleModelIns:SaveEmbattleDataNew(
        self.curEmbattleType,
        _G.handler(self, self.OnSaveEnd),
        self.saveType,
        self.notPassServer,
        sits
    )
    sits = nil
end
