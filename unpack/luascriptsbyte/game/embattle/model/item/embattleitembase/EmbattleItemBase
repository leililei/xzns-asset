---设置临时布阵数据
---@param revert boolean 是否为还原
function EmbattleItemBase:SetTempEmbattleData(sits, index, revert)
    if revert then
        if self.tempEmbattleData then
            self:InitEmbattleData(self.tempEmbattleData, index)
            self.tempEmbattleData = nil
        end
    else
        self.tempEmbattleData = _G.DeepCopy(self.curEmbattleData)
        local card, sit
        for i = 1, #sits do
            card = self.curEmbattleData[i]
            sit = sits[i]
            if card.uid > 0 then
                self:SetCurUids(card.uid, false)
                self:SetCurSids(card.sid, false)
            end
            card.uid = sit.uid
            card.sid = sit.sid
            card.star = sit.star
            card.level = sit.level
            card.soulLink_lv = sit.soulLink_lv
            if sit.uid > 0 then
                self:SetCurUids(card.uid, true)
                self:SetCurSids(card.sid, true)
            end
        end
    end
end

