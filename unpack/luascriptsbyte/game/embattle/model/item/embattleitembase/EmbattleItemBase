function EmbattleItemBase:GetMyEmbattlePower(index, isView)
    local power = 0
    local uid = 0
    local card = nil
    for i = 1, #self.curEmbattleData do
        uid = self.curEmbattleData[i].uid
        if uid > 0 then
            card = self:GetCardData(uid)
            power = power + card:GetPower(isView)
        end
    end
    uid = nil
    card = nil
    return power
end
