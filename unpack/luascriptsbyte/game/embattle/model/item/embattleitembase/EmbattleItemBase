---清空
---@param index number 编号(针对多布阵数据  挂机副本)
function EmbattleItemBase:ClearEmbattle(index)
    if self.curEmbattleData == nil then
        return
    end
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.uid > 0 then
            self:SetCurUids(card.uid, false)
            self:SetCurSids(card.sid, false)
        end
        card.uid = 0
        card.sid = 0
        card.level = 0
        card.star = 0
        card.soulLink_lv = 0
    end

    if self.curCombSkillData then
        local skill
        for i = 1, #self.curCombSkillData do
            skill = self.curCombSkillData[i]
            skill.id = 0
            skill.lv = 0
            skill.cskillID = 0
        end
    end
    if self.curPetSkillData then
        self.curPetSkillData = nil
    end
    if _G.AppSetting.IsXzns then	
        if self.curBeastSkillData then
            self.curBeastSkillData = nil
        end
    end

end
