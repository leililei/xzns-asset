function EmbattleItemBase:GetRecommendCall(msg, call, monster_group_id)
    self.RecommendDatas = msg.recommend or {}
    self:SortRecommendDatas()
    if monster_group_id ~= nil then
        local cfg = _G.ConfigManager.monster_group_cfg[monster_group_id]
        if cfg.AdviceAttackerSids ~= nil then
            local find = false
            local cardInfos = {}
            local index = 1
            for k, v in pairs(cfg.AdviceAttackerSids) do
                local cardInfo = {}
                if v == 0 then
                    cardInfo.sid = 0
                    cardInfo.lv = 0
                    cardInfo.star = 0
                else
                    find = true
                    local monsterCfg = _G.ConfigManager.monster_cfg[v]
                    cardInfo.sid = monsterCfg.CardID
                    cardInfo.lv = monsterCfg.Level
                    cardInfo.star = monsterCfg.Stars
                end
                cardInfo.index = index
                index = index + 1
                table.insert(cardInfos, cardInfo)
            end
            if find then
                local combineSkills
                if #cfg.advice_att_combine == 0 then
                    combineSkills = {0, 0, 0}
                else
                    combineSkills = _G.DeepCopyCfgTable(cfg.advice_att_combine)
                end
                local gInfo = {}
                gInfo.c_info = cardInfos
                gInfo.combine_skill = combineSkills
                local gInfos = {[1] = gInfo}
                ---插入推荐阵容
                local data = {
                    ["uid"] = 0,
                    ["power"] = 0,
                    ["name"] = "",
                    ["portrait"] = 101,
                    ["frame"] = 100,
                    ["title"] = nil,
                    ["g_info"] = gInfos,
                    ["pass_time"] = 0
                }
                ---推荐阵容插入到第二个位置
                if #self.RecommendDatas > 1 then
                    table.insert(self.RecommendDatas, 2, data)
                else
                    table.insert(self.RecommendDatas, data)
                end
            end
        end
    end
    if call then
        call(self.RecommendDatas)
    end
end

function EmbattleItemBase:SortRecommendDatas()
    _G.SortList(
        self.RecommendDatas,
        function(a)
            return -a.pass_time, -a.power
        end
    )
    for k, v in pairs(self.RecommendDatas) do
        for m, n in pairs(v.g_info) do
            _G.SortList(
                n.c_info,
                function(a)
                    return -a.index
                end
            )
        end
    end
end

