---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemBase:InitEmbattleData(sits, index)
    if sits then
        local card, sit
        for i = 1, #sits do
            card = self.curEmbattleData[i]
            sit = sits[i]
            if card.uid > 0 then
                self:SetCurUids(card.uid, false)
                self:SetCurSids(card.sid, false)
            end
            card.uid = sit.uid
            card.sid = sit.sid
            card.star = sit.star
            card.level = sit.level
            card.soulLink_lv = sit.soulLink_lv
            if sit.uid > 0 then
                self:SetCurUids(card.uid, true)
                self:SetCurSids(card.sid, true)
            end
        end
    else
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        self.curEmbattleData = self:GetServerEmbattleData(self.curEmbattleType)
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i] > 0 then
                local card = self:GetCardData(self.curEmbattleData[i])
                if card then
                    self.curEmbattleData[i] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        tag = 0
                    }
                    self:SetCurUids(card.uid, true)
                    self:SetCurSids(card.sid, true)
                else
                    if _G.AppSetting.DEBUG then
                        _G.LogWarning(
                            "未找到对应uid的卡牌 uid = " .. self.curEmbattleData[i],
                            "EmbattleItemBase:InitEmbattleData"
                        )
                    end
                    self.curEmbattleData[i] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    tag = 0
                }
            end
        end
        self:SetCombSkillData()
        self:SetPetSkillData()
	if _G.AppSetting.IsXzns then
            self:SetBeastSkillData()
	end
    end
end

function EmbattleItemBase:SetEmbattleData(sits, index)
    local card, sit
    for i = 1, #sits do
        card = self.curEmbattleData[index][i]
        sit = sits[i]
        card.uid = sit.uid
        card.sid = sit.sid
        card.star = sit.star
        card.level = sit.level
        card.soulLink_lv = sit.soulLink_lv
        card.power = sit.power or 0
        card.tag = sit.tag or 0
    end
end

