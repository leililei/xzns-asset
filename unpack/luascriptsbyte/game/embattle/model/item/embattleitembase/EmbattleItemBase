--region 内部方法
---处理上下阵
---@param embattleArray table 布阵数据
---@param index number 布阵序列
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return 变量类型 中文描述
function EmbattleItemBase:HandleEmbattleData(embattleArray, index, uid, etIndex)
    local card = embattleArray[index]
    if uid == 0 or card.uid == uid then --下阵
        local success = card.uid ~= 0
        if success then
            self:SetCurUids(card.uid, false, etIndex)
            self:SetCurSids(card.sid, false, etIndex)
        end
        card.uid = 0
        card.sid = 0
        card.star = 0
        card.level = 0
        card.soulLink_lv = 0
        card.power = 0
        return success
    end
    local changeCard
    for i = 1, #embattleArray do
        if i ~= index then
            changeCard = embattleArray[i]
            if uid == changeCard.uid then --交换
                changeCard.uid = card.uid
                card.uid = uid
                uid = changeCard.sid
                changeCard.sid = card.sid
                card.sid = uid
                uid = changeCard.star
                changeCard.star = card.star
                card.star = uid
                uid = changeCard.level
                changeCard.level = card.level
                card.level = uid
                uid = changeCard.soulLink_lv
                changeCard.soulLink_lv = card.soulLink_lv
                card.soulLink_lv = uid
                return true
            end
        end
    end
    local cardData = self:GetCardData(uid)
    if cardData == nil then
        return false
    end
    self:SetCurUids(card.uid, false, etIndex)
    self:SetCurSids(card.sid, false, etIndex)
    card.uid = uid
    card.sid = cardData.sid
    card.star = cardData:GetStar()
    card.level = cardData:GetLevel()
    card.soulLink_lv = cardData.soulLink_lv
    card.power = cardData.power or 0
    self:SetCurUids(card.uid, true, etIndex)
    self:SetCurSids(card.sid, true, etIndex)
    return true
end
---检测羁绊
---@param data table 布阵数据
---@return number|number 五行|神
function EmbattleItemBase:CheckShackleByData(data)
    local element = {0, 0, 0, 0, 0, 0}
    local EmbattleController = require("EmbattleController"):GetInstance()
    local elementShackleIDs, godShackleIDs = EmbattleController:GetAllShackleIDs()
    local es, e
    for i = 1, #data do --统计五行数量
        if data[i].uid and data[i].uid > 0 then
            es = self:GetCardElement(data[i].sid)
            for j = 1, #es do
                e = es[j]
                element[e] = element[e] + 1
            end
        end
    end
    local elementID, godID = 0, 0
    local cfgs = _G.ConfigManager.formation_cfg
    e = _G.CardElementType.God
    if element[e] > 0 then --神职业
        for i = #godShackleIDs, 1, -1 do
            if element[e] >= cfgs[godShackleIDs[i]].num_elements[1] then
                godID = godShackleIDs[i]
                break
            end
        end
    end
    --去除神职业，判定其他五行
    element[e] = nil
    local nums, index, num
    local idIndex = {false, false, false, false, false}
    for i = #elementShackleIDs, 1, -1 do --检测五行
        nums = cfgs[elementShackleIDs[i]].num_elements
        for j = 1, #idIndex do
            idIndex[j] = false
        end
        for j = 1, #nums do
            index = 0
            num = 0
            for k = 1, #element do
                if not idIndex[k] and element[k] >= nums[j] then
                    if num == 0 or num > element[k] then
                        num = element[k]
                        index = k
                    end
                end
            end
            if index == 0 then
                break
            else
                idIndex[index] = true
            end
        end
        if index > 0 then
            elementID = elementShackleIDs[i]
            break
        end
    end
    return elementID, godID
end
