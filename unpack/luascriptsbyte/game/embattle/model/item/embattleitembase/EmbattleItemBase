---类的构造函数
---@param eType number 布阵枚举ID
---@param saveType _G.EmbattleSaveType 保存类型
---@param notPassServer boolean 是否不通知服务器
---@param mgpID number 怪物组ID(需要获取场景和布阵3D位置)
function EmbattleItemBase:__init(eType, saveType, notPassServer, mgpID)
    self.curEmbattleType = eType
    self.monsterGroupID = mgpID
    self.saveType = saveType or _G.EmbattleSaveType.server
    self.notPassServer = notPassServer
    self.curEmbattleData = nil
    self.curChooseCardList = nil
    self.curEnemyEmbattleData = nil
    self.curSids = {}
    self.curUids = {}
    self.RecommendDatas = {}
    self.assistCardList = {}
    self.assistUidList = {}
    self.npcAssistUidList = {}
    self:InitEmbattleData()
    self:InitEnemyEmbattleData()

    local eTypeName, eTypeId
    if _G.IsNumber(eType) then
        eTypeId = eType
    else
        eTypeId = eType[1]
    end
    for k, v in pairs(_G.EmbattleType) do
        if v == eTypeId then
            eTypeName = k
            break
        end
    end
    if eTypeName == nil then
        if eTypeId >= 18000 and eTypeId < 24000 then --死魂塔多队
            self.canArrayReplace = true
        end
    else
        self.canArrayReplace = ArrayReplaceCfg[eTypeName]
    end
    ---我方默认显示魂链天赋，敌方默认不显示
    self.notShowMySoulAndTalents = false
    self.showEnemySoulAndTalents = false
end

---类的析构函数
function EmbattleItemBase:Dispose()
    self.curEmbattleType = nil
