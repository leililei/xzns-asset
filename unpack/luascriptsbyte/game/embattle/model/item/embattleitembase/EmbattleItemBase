---检测计时卡牌是否已过期
function EmbattleItemBase:CheckCardTimer(func)
    local time = _G.TimeUtil.GetServerUnixTime()
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i].type == _G.CardType.Timer and time >= self.curEmbattleData[i].endTime then
            return false
        end
    end
    if func then
        return func()
    end
    return true
end

