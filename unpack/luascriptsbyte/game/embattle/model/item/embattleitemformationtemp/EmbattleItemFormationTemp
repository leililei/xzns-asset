local base = require "EmbattleItemPVE"
---@class EmbattleItemFormationTemp	中文描述
local EmbattleItemFormationTemp = _G.BaseClass("EmbattleItemFormationTemp", base)

---类的构造函数
function EmbattleItemFormationTemp:__init()
    self.maxPutNum = 0
    self.fgType = require("EmbattleController"):GetInstance().curGroupIitem:GetFormationGroupType()
    if self.fgType == _G.FormationGroupType.Three then
        self.maxPutNum = 3
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
end

function EmbattleItemFormationTemp:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if embattleView then
        embattleView:SetVsDescription(_G.PlayerModel:GetInstance():GetName(), "")
        embattleView:SetBattleBtnText(_G.GetLangPackValue(90114010161))
    end
end

function EmbattleItemFormationTemp:GetEnemyEmbattlePower()
    return nil
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemFormationTemp:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local skills = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local pets = {0, 0, 0}
    if self.curPetSkillData then
        for i = 1, #self.curPetSkillData do
            pets[i] = self.curPetSkillData[i]
        end
    end
    local beast = {0,0,0}
    if _G.AppSetting.IsXzns then
        if self.curBeastSkillData then
            for i = 1, #self.curBeastSkillData do
                beast[i] = self.curBeastSkillData[i]
            end
        end
    end
    require("EmbattleController"):GetInstance():OnGroupEditCall(self.curEmbattleData, pets, true, beast)
    self:OnSaveEnd(0)
end

---获取monster_group_cfg的ID(每个布阵都应该有一个)
---@return number 怪物组ID
function EmbattleItemFormationTemp:GetMonsterGroupID(index)
    return self.monsterGroupID
end

---获取敌方布阵数据
---@return table 地方布阵数据
function EmbattleItemFormationTemp:GetEnemyEmbattleData(index)
    return nil
end

function EmbattleItemFormationTemp:GetCacheModelInBattle()
    return false
end

---获取服务器阵容(多队时仅第一队使用)
function EmbattleItemFormationTemp:GetServerEmbattleData(id)
    self:InitGroupAndIndex()
    local uids = require("EmbattleController"):GetInstance():GetFormationUids(self.groupType, self.editIndex)
    return _G.DeepCopy(uids)
end

function EmbattleItemFormationTemp:GetSkillIndex(id)
    self:InitGroupAndIndex()
    local combine = require("EmbattleController"):GetInstance():GetFormationCombines(self.groupType, self.editIndex)
    return _G.DeepCopy(combine)
end

function EmbattleItemFormationTemp:GetPetSkillIndex(id)
    self:InitGroupAndIndex()
    local pets = require("EmbattleController"):GetInstance():GetFormationPets(self.groupType, self.editIndex)
    return _G.DeepCopy(pets)
end

function EmbattleItemFormationTemp:GetBeastSkillIndex(id)
    self:InitGroupAndIndex()
    local beasts = require("EmbattleController"):GetInstance():GetFormationBeasts(self.groupType, self.editIndex)
    return _G.DeepCopy(beasts)
end

function EmbattleItemFormationTemp:InitGroupAndIndex()
    if not self.editIndex then
        self.editIndex = require("EmbattleController"):GetInstance().curEditGroupIndex
    end
    if not self.groupType then
        self.groupType = require("EmbattleController"):GetInstance().curEditGroupType
    end
end

function EmbattleItemFormationTemp:ShowFormationBtn()
    return false
end

function EmbattleItemFormationTemp:GetMaxPutNum()
    return self.maxPutNum
end

function EmbattleItemFormationTemp:GetPetSkillState()
    if self.fgType == _G.FormationGroupType.Three then
        return {false, false, false}
    end
    return self.super:GetPetSkillState()
end

return EmbattleItemFormationTemp
