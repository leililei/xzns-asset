local base = require "EmbattleItemGroup"
---@class EmbattleItemSociatyFormat	:EmbattleItemGroup
---EmbattleItemSociatyFormat
local EmbattleItemSociatyFormat = _G.BaseClass("EmbattleItemSociatyFormat", base)

function EmbattleItemSociatyFormat:__init(eType, saveType, notPassServer, mgpID, enemy)
    self.sociatyEmbattle = true
    self.curEquityCfg = _G.ConfigManager.att_equity_cfg[6]
end

---保存布阵数据
---@param saveCall function 保存回调
function EmbattleItemSociatyFormat:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local EmbattleModel = require("EmbattleModel"):GetInstance()
    local sits = {}
    local uid
    local skill = {0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = {}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            sits[i][j] = uid < 0 and 0 or uid
        end
        for j = 1, #skill do
            skill[j] = self.curCombSkillData[i][j].id
        end
        EmbattleModel:SetSkillIndex(self.curEmbattleType[i], skill)
    end
    EmbattleModel:SaveEmbattleDataTable(
        self.curEmbattleType,
        _G.handler(self, self.OnSaveEnd),
        sits,
        _G.EmbattleSaveType.localfile
    )
end

---获取布阵数据
---@param index number 序列号
---@return table 布阵数据
function EmbattleItemSociatyFormat:GetEmbattleData(index)
    if self.curEmbattleData == nil then
        self:InitEmbattleData()
    end
    self.embattleIndex = index or self.embattleIndex
    for i = 1, #self.curEmbattleData[index] do
        if self.curEmbattleData[index][i].uid > 0 then
            self.curEmbattleData[index][i].level = self.curEquityCfg.level
        end
    end
    return self.curEmbattleData[index]
end

---获取最大可上阵数量
function EmbattleItemSociatyFormat:GetMaxPutNum()
    if not self.maxPutNum then
        self.maxPutNum = _G.ConfigManager.discrete_cfg[101636][1][1]
    end
    return self.maxPutNum
end

return EmbattleItemSociatyFormat
