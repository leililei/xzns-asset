---初始化卡牌
function EmbattleItemSociatyBattleAttack:InitCardList()
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    ---@type CardData[]
    self.curChooseCardList = {}
    for _, v in pairs(cards) do
        local msg = {}
        setmetatable(msg, { __index = v })
        rawset(msg, "lv", perLevel)
        msg.GetRealPower = msg.GetPower
        rawset(
            msg,
            "GetPower",
            function()
                if not msg.tempPower then
                    msg:CalcNowSumProp()
                    msg.tempPower = msg:GetRealPower()
                end
                return msg.tempPower
            end
        )
        rawset(
            msg,
            "GetLevel",
            function()
                return perLevel
            end
        )
        _G.table.insert(self.curChooseCardList, msg)
    end
    self:SortCardList()
end

---保存阵容
function EmbattleItemSociatyBattleAttack:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {}
    local uid = 0
    local pets = {}
    local beasts = {}
    local skill = {}
    for i = 1, #self.curEmbattleData do
        sits[i] = {}
        pets[i] = { 0, 0, 0 }
        beasts[i] = { 0, 0, 0 }
        skill[i] = {}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            sits[i][j] = uid < 0 and 0 or uid
        end
        for j = 1, #self.curCombSkillData[i] do
            skill[i][j] = self.curCombSkillData[i][j].id or 0
        end
        if self.curPetSkillData and self.curPetSkillData[i] then
            for j = 1, #self.curPetSkillData[i] do
                pets[i][j] = self.curPetSkillData[i][j]
            end
        end
        if _G.AppSetting.IsXzns then
            if self.curBeastSkillData and self.curBeastSkillData[i] then
                for j = 1, #self.curBeastSkillData[i] do
                    beasts[i][j] = self.curBeastSkillData[i][j]
                end
            end
        end
    end
    require "SociatyBattleModel":GetInstance():SaveAttackGarray(sits, skill, pets, _G.handler(self, self.OnSaveEnd),
        beasts)
end

