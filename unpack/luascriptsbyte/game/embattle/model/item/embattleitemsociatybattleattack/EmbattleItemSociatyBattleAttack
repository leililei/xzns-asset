    if curData then
        curData[index] = nil
        self.curPetSkillData = curData
    end
    if _G.AppSetting.IsXzns then
        if beastData then
            beastData[index] = nil
            self.curBeastSkillData = beastData
        end
    end
end

---一键上阵规则
function EmbattleItemSociatyBattleAttack:GetAutoEmbattleData(cardList, curEmbattleIndex)
    local frontRow = {
        [1] = true,
        [2] = true
    }
    local backRow = {
        [3] = true,
        [4] = true,
        [5] = true
    }
    local backSort = { 3, 4, 5, 1, 2 }
    local oldEmbattleData = self:GetEmbattleData(curEmbattleIndex)
    ---按照战力上阵前5名角色
    _G.SortList(
        cardList,
        function(data)
            return data.power
        end
    )
    local cardSidList = {}
    local newCardList = {}
    for _, v in pairs(cardList) do
        if not cardSidList[v.sid] and not self:CheckSidInEmbattle(v.sid) then
            if self:CheckCardAssist(v.uid) then
                local use, max = self:GetAssistNum(v.uid)
                if use < max then
                    _G.table.insert(newCardList, v)
                    cardSidList[v.sid] = true
                end
            else
                _G.table.insert(newCardList, v)
                cardSidList[v.sid] = true
            end
        end
    end

    local newEmbattleData = {}
    local max = self:GetMaxPutNum()
    local num = #oldEmbattleData
    --ZHJH-15308【战斗】-一键布阵优化
    --card表的Distance字段新增6、7、8、9、10数值，对应队伍中1、2、3、4、5号位
    local preferentCards = {}
    for i = math.min(#newCardList, num), 1, -1 do
        if newCardList[i].cfg.Distance >= 6 then
            newCardList[i].__tempIndex = i --临时记录在newCardList中的index序号
            _G.table.insert(preferentCards, 1, newCardList[i])
        end
    end
    if #preferentCards > 0 then
        --优先上阵的角色
        for index = 1, num do
            if index > max and max ~= 0 then
                break
            end
            local _cardData = preferentCards[index]
            local _cardSortIndex = _cardData and _cardData.__tempIndex or 999
            if _cardData and _cardSortIndex <= num then --卡牌存在, 且排序在num及之前
                local posIndex = _cardData.cfg.Distance - 5
                if not newEmbattleData[posIndex] then
                    newEmbattleData[posIndex] = _cardData
                    --_G.table.remove(newCardList, _cardSortIndex)
                    --如果位置已被占用(Distance相同), 移除所有相同Distance卡牌
                    for j = #newCardList, 1, -1 do
                        if newCardList[j].cfg.Distance == _cardData.cfg.Distance then
                            _G.table.remove(newCardList, j)
                        end
                    end
                end
            else
                break
            end
        end
    end

    for index, v in ipairs(oldEmbattleData) do
        if index > max and max ~= 0 then
            break
        end
        local _cardData = newCardList[index]
        if _cardData then
            if frontRow[_cardData.cfg.Distance] then
                ---检查前排是否还有位置
                for i = 1, 5 do
                    if not newEmbattleData[i] then
                        newEmbattleData[i] = _cardData
                        break
                    end
                end
            elseif backRow[_cardData.cfg.Distance] then
                for i = 1, 5 do
                    if not newEmbattleData[backSort[i]] then
                        newEmbattleData[backSort[i]] = _cardData
                        break
                    end
                end
            end
        else
            break
        end
    end
    local mynewEmbattleData = {}
    local index = 0
    for k, v in pairs(newEmbattleData) do
        mynewEmbattleData[k] = v
        index = index + 1
        if index >= 3 then
            break
        end
    end
    return oldEmbattleData, mynewEmbattleData
end

