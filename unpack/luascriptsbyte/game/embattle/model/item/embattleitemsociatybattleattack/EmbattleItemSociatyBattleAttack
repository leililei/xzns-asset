local base = require "EmbattleItemGroup"
---@class EmbattleItemSociatyBattleAttack	:EmbattleItemGroup
local EmbattleItemSociatyBattleAttack = _G.BaseClass("EmbattleItemSociatyBattleAttack", base)
local perLevel = 300
---@param enemy
function EmbattleItemSociatyBattleAttack:__init(eType, saveType, notPassServer, mgpID, enemy, enemyName, enemyInfo)
    self.enemy = enemy
    self.enemyName = enemyName
    self.enemyInfo = enemyInfo
    self.curEnemyCombineData = {}
    self:InitEnemyEmbattleData()
    self.sociatyEmbattle = true
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
end

function EmbattleItemSociatyBattleAttack:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.embattleView:SetVsDescription(_G.PlayerModel:GetInstance():GetName(), self.enemyName, self.enemyInfo)
end

---初始化地方阵容
function EmbattleItemSociatyBattleAttack:InitEnemyEmbattleData()
    if not self.enemy then
        return
    end
    self.curEnemyEmbattleData = { false, false, false }
    self.curEnemyCombineData = { false, false, false }
    local card
    local cfg
    local cfgs = _G.ConfigManager.card_cfg
    for i = 1, #self.curEmbattleType do
        local data = { 0, 0, 0, 0, 0 }
        for j = 1, #data do
            if self.enemy[i] and self.enemy[i].card_list[j] then
                card = self.enemy[i].card_list[j]
                if card.card_sid > 0 then
                    cfg = cfgs[card.card_sid]
                else
                    cfg = nil
                end
                local isweak, wsid = require "CardCommentManager":GetInstance():CardWearSkin(card.card_sid)
                data[j] = {
                    uid = card.card_sid,
                    sid = card.card_sid,
                    level = card.card_lv,
                    star = card.star,
                    soulLink_lv = card.soul_lv,
                    power = 0,
                    scale = cfg and cfg.GlobalScale * 0.0001 or 1,
                    soulLink_IsActivate = card.soul_state,
                    open_inborn = card.born_skill_num,
                    artifact = card.artifact or {},
                    skin = wsid,
                    artifact_skin= card.artifact_skin
                }
            else
                data[j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    artifact = {},
                    tag = 0
                }
            end
        end
        self.curEnemyEmbattleData[i] = data
        self.curEnemyCombineData[i] = self.enemy[i].skill_index
    end
end

---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemSociatyBattleAttack:GetEnemyEmbattlePower(index)
    return self.enemy[index] and self.enemy[index].power or 0
end

---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemSociatyBattleAttack:InitEmbattleData(sits, index)
    if sits then
        self.curUids[index] = {}
        self.curSids[index] = {}
        self:ClearEmbattle(index)
        local card, sit
        local haveRole = false
        for i = 1, #sits do
            sit = sits[i]
            if not self:CheckUidInEmbattle(sit.uid) and not self:CheckSidInEmbattle(sit.sid) then --不在其他阵容并且没有相同SID上阵
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    self.curUids[index][sit.uid] = true
                    self.curSids[index][sit.sid] = true
                end
            else
                haveRole = true
            end
        end
        if haveRole then
            _G.PopWindowManager:GetInstance():ShowAllTips(220101)
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    base.InitEmbattleData(self)
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
---@param swapData table 交换合击技数据
function EmbattleItemSociatyBattleAttack:SetCombSkillData(data, index, swapData)
    if data then
        local dic
        for i = 1, #data do
            dic = self.curCombSkillData[index][i]
            if data[i].tag == 0 then
                if not self:CheckOtherGroupSameSkill(data[i].id) then
                    dic.id = data[i].id
                    dic.lv = data[i].lv
                    dic.cskillID = data[i].cskillID
                end
            end
        end
        if swapData then
            local spdata
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        spdata = swapData[self.curCombSkillData[i][j].id]
                        if spdata then
                            self.curCombSkillData[i][j] = spdata
                        end
                    end
                end
            end
        end
        return
    end
    base.SetCombSkillData(self)
end

