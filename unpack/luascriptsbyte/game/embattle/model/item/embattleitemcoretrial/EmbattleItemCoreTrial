local EmbattleItemPVP = require "EmbattleItemPVP"

---@class EmbattleItemCoreTrial    中文描述
local EmbattleItemCoreTrial = _G.BaseClass("EmbattleItemCoreTrial", EmbattleItemPVP)

---类的构造函数
function EmbattleItemCoreTrial:__init(etype, saveType, notPassServer, data)
end

---类的析构函数
function EmbattleItemCoreTrial:Dispose()
    self.groupCardList = nil
end

--region 重写方法

---获取编队界面卡牌列表
---@return table 卡牌列表
function EmbattleItemCoreTrial:GetGroupCardList()
    return self.groupCardList
end
---初始化我方布阵数据
function EmbattleItemCoreTrial:InitEmbattleData(sits, index)
    EmbattleItemPVP.InitEmbattleData(self, sits, index)
end

function EmbattleItemCoreTrial:InitEnemyEmbattleData()
    if self.curEnemyEmbattleData == nil then
        return
    end
    EmbattleItemPVP.InitEnemyEmbattleData(self)
end

function EmbattleItemCoreTrial:CheckEmptyPos()
    if self:GetIntoCount() > 0 then
        local temp_check_cardlist = {}
        local list = self:GetCardList()
        for i = 1, #list do
            local flag = false
            local card = list[i]
            for j = 1, #self.curEmbattleData do
                if card.uid == self.curEmbattleData[j].uid then
                    flag = true
                    break
                end
            end
        end
        if _G.table.isEmptyOrNil(temp_check_cardlist) then
            return 0
        end
    else
        return 0
    end
    return EmbattleItemPVP.CheckEmptyPos(self)
end

---当前上阵的 数量
function EmbattleItemCoreTrial:GetIntoCount()
    local count = 0
    if not _G.table.isEmptyOrNil(self.curEmbattleData) then
        for i = 1, 5 do
            if self.curEmbattleData[i].uid > 0 then
                count = count + 1
            end
        end
    end
    return count
end

-- ---重写父类的 ,获得卡牌的数据方法
function EmbattleItemCoreTrial:GetCardData(uid)
    local data = self.super.GetCardData(self, uid)
    if data then
        return data
    end
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemCoreTrial:InitCardList()
    self.super.InitCardList(self)
    self.groupCardList = {}
    for i = 1, #self.curChooseCardList do
        self.groupCardList[i] = self.curChooseCardList[i]
    end
    if self.storyCardList then
        _G.table.sort(self.storyCardList, _G.handler(self, self.SortCardListFunc))
        local insert = _G.table.insert
        for i = #self.storyCardList, 1, -1 do
            insert(self.curChooseCardList, 1, self.storyCardList[i])
        end
    end
end

---检测编队界面是否展示锁住
---@param uid number 卡牌Uid
---@return boolean 是否展示锁
function EmbattleItemCoreTrial:CheckGroupFormationLock(uid)
    return false
end

---是否显示卡牌列表血量
---@return boolean 是否显示卡牌列表中血量
function EmbattleItemCoreTrial:ShowCardHP()
    return true
end

---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemCoreTrial:GetMyEmbattlePower(index, isView)
    local power = 0
    local uid = 0
    local card = nil
    for i = 1, #self.curEmbattleData do
        uid = self.curEmbattleData[i].uid
        if uid > 0 then
            card = self:GetCardData(uid)
            power = power + card:GetPower(isView)
        end
    end
    uid = nil
    card = nil
    return power
end

--endregion

return EmbattleItemCoreTrial
