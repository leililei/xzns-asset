local base = require "EmbattleItemPVP"
---@class EmbattleItemArenaAttack : EmbattleItemPVP	中文描述
local EmbattleItemArenaAttack = _G.BaseClass("EmbattleItemArenaAttack", base)

---@private
function EmbattleItemArenaAttack:__init(eType, saveType, notPassServer, mgpID, data)
    self.data = data
    self.showEnemySoulAndTalents = true
end

---保存布阵数据
---@param saveCall function 保存回调
---@param noUITip booelan 保存回调
---@return any 默认没有返回
function EmbattleItemArenaAttack:SaveEmbattle(saveCall, noUITip)
    self.mSaveCall = saveCall
    base.SaveEmbattle(self, _G.handlerbind(self, self.OnSavedCallChild, noUITip))
end

function EmbattleItemArenaAttack:OnSavedCallChild(result, noUITip)
    if result == 0 then
        local ArenaControllerIns = require("ArenaController"):GetInstance()
        --TODO:检查敌人阵容
        ArenaControllerIns:GetEnemyCardList(
            nil,
            function(data)
                local isEmptyOrNil = _G.table.isEmptyOrNil
                for i = 1, #self.curEnemyEmbattleData do
                    if not isEmptyOrNil(data[i]) then
                        if data[i].sid ~= self.curEnemyEmbattleData[i].sid then --和最新布阵数据不一致
                            result = 1
                            break
                        end
                    elseif self.curEnemyEmbattleData[i].sid > 0 then --和最新布阵数据不一致
                        result = 1
                        break
                    end
                end
                self.mSaveCall(result)
                if result ~= 0 and not noUITip then
                    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
                    view:QuitEmbattle()
                    _G.PopWindowManager:GetInstance():ShowAllTips(1513)
                end
            end
        )
    else
        self.mSaveCall(result)
    end
end

---检测是否可以出战
function EmbattleItemArenaAttack:CheckBattle()
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(1)
    if arenaClass:GetCurArenaState() ~= 1 then
        local closeFun = function()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaChanllengeView.Name)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaMainPanelView.Name)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(300301, nil, closeFun, closeFun)
        return false, nil, true
    end
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i].uid > 0 then
            return true
        end
    end
    return false
end

---获取是否展示跳过战斗
function EmbattleItemArenaAttack:GetShowSkip()
    --self.AttackName = 1
    return false
    --return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(96)
end

function EmbattleItemArenaAttack:IsShowEnemyPetSkill()
    return true
end

function EmbattleItemArenaAttack:GetEnemyPetSkillData()
    if not self.data then
        return nil
    end
    return self.data.pet
end

return EmbattleItemArenaAttack
