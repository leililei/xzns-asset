--region override pet function
function EmbattleItemRecommendBase:SetPetSkillData(data, index)
    if self.isInited then
        return
    end
    self.curPetSkillData = {}
    for i = 1, #self.data.g_info do
        self.curPetSkillData[i] = { 0, 0, 0 }
        for j = 1, 2 do
            self.curPetSkillData[i][j] = self.data.g_info[i].pet_skill[j] or 0
        end
    end
end
function EmbattleItemRecommendBase:GetPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    return self.curPetSkillData[index]
end
function EmbattleItemRecommendBase:GetOtherGroupPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.monsterGroupID do
        if i ~= index and self.curPetSkillData[i] then
            local data = self.curPetSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end
function EmbattleItemRecommendBase:ClearEmbattle(index)
    local curData = self.curPetSkillData
    base.ClearEmbattle(self, index)
    if curData then
        curData[index] = nil
        self.curPetSkillData = curData
    end
end
--endregion

return EmbattleItemRecommendBase
