local base = require "EmbattleItemGroup"
---@class EmbattleItemRecommendBase:EmbattleItemGroup
---@field data i_afk_recommend
---@field parent EmbattleItemBase
---@field recordData afk.s2c_get_afk_report
local EmbattleItemRecommendBase = _G.BaseClass("EmbattleItemRecommendBase", base)

function EmbattleItemRecommendBase:__init(_, _, _, _, parent)
    self.parent = parent
    self.isRecommend = true
end
---解析数据
---@param data afk.i_afk_recommend
function EmbattleItemRecommendBase:ParseData(data, index, monster_group_id, call)
    if not data then
        return
    end
    self.isInited = false
    self.data = data
    self.recordDataDic = {}
    self:InitEmbattleData(self.data.g_info)
    self.isInited = true
    self:GetRecordData(call, index, self.data, monster_group_id)
end

function EmbattleItemRecommendBase:GetMyEmbattlePower(index)
    return self.recordDataDic[index].data.fight_arg.attacker_team[1].power
end
---获取己方布阵数据
function EmbattleItemRecommendBase:GetEmbattleData()
    return self.curEmbattleData
end
---初始化布阵数据
---@param sits afk.i_afk_g_info[] 布阵数据
---@param index number 多布阵序列号
function EmbattleItemRecommendBase:InitEmbattleData(sits, index)
    if not self.data or self.isInited then
        return
    end
    self.curEmbattleData = {}
    local card
    ---@type afk.i_afk_g_info
    local sit
    for i = 1, #sits do
        sit = sits[i]
        self.curEmbattleData[i] = {}
        for j = 1, 5 do
            card = {}
            card.uid = 0
            card.sid = 0
            card.star = 0
            card.level = 0
            card.index = j
            card.tag = 0
            card.soulLink_IsActivate = 0
            card.soulLink_lv = 0
            card.open_inborn = 0
            self.curEmbattleData[i][j] = card
        end
        for j = 1, #sit.c_info do
            card = self.curEmbattleData[i][sit.c_info[j].index]
            card.uid = 0
            card.sid = sit.c_info[j].sid
            card.star = sit.c_info[j].star
            card.level = sit.c_info[j].level
            card.tag = 0
            card.soulLink_IsActivate = sit.c_info[j].soul_state
            card.soulLink_lv = sit.c_info[j].soul_lv
            card.open_inborn = sit.c_info[j].born_skill_num
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end
---设置合击技数据
function EmbattleItemRecommendBase:SetCombSkillData()
    if self.isInited then
        return
    end
    self.curCombSkillData = {}
    for i = 1, #self.data.g_info do
        local skill = {}
        for j = 1, 3 do
            if self.data.g_info[i].combine_skill[j] > 1 then
                skill[j] = {
                    id = _G.Mathf.RoundToInt(self.data.g_info[i].combine_skill[j] / 10000),
                    lv = 1,
                    cskillID = self.data.g_info[i].combine_skill[j],
                    tag = 0
                }
            else
                skill[j] = {
                    id = 0,
                    lv = 1,
                    cskillID = 0,
                    tag = self.data.g_info[i].combine_skill[j]
                }
            end
            self.curCombSkillData[i] = skill
        end
    end
end

---获取布阵数据
---@param index number 序列号
---@return table 布阵数据
function EmbattleItemRecommendBase:GetEmbattleData(index)
    if self.curEmbattleData == nil then
        self:InitEmbattleData()
    end
    self.embattleIndex = index or self.embattleIndex
    return self.curEmbattleData[self.embattleIndex]
end

function EmbattleItemRecommendBase:CheckCombineSkillEquip(index)
    return false
end

function EmbattleItemRecommendBase:GetRecordData(call, index, i_afk_recommend, monster_group_id)
    if not self.recordDataDic[index] then
        ---系统推荐
        if i_afk_recommend and i_afk_recommend.uid == 0 then
            self:InitRecordDataFromRecommend(i_afk_recommend, index, monster_group_id)
            self.power = i_afk_recommend.power
            if call then
                call(self.recordData)
            end
        else
            require "AfkNet":GetInstance():GetRecord(
                {sid = require "AfkModel":GetInstance():GetCurSection(), uid = self.data.uid, index = index},
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    self:InitRecordData(msg, index)
                    self.power = self.recordData.fight_arg.attacker_team[1].power
                    if call then
                        call(self.recordData)
                    end
                end
            )
        end
    else
        self.recordData = self.recordDataDic[index].data
        self.recordCardDatas = self.recordDataDic[index].cardDatas
        self.power = self.recordData.fight_arg.attacker_team[1].power
        if call then
            call(self.recordData)
        end
    end
end
---@param msg afk.s2c_get_afk_report
function EmbattleItemRecommendBase:InitRecordData(msg, index)
    self.recordData = msg
    index = index or 1
    self.recordCardDatas = {}
    for _, v in pairs(self.recordData.fight_arg.attacker_team) do
        for _, v2 in pairs(v.fights) do
            self.recordCardDatas[v2.sid] = v2
        end
    end
    self.recordDataDic[index] = {data = self.recordData, cardDatas = self.recordCardDatas}
end

function EmbattleItemRecommendBase:InitRecordDataFromRecommend(recommend, index, monster_group_id)
    local reData = {}
    local fightData = {}
    reData.fight_arg = fightData
    fightData.sid = monster_group_id
    fightData.attacker_team = {}
    local atkTeam = {}
    fightData.attacker_team[1] = atkTeam
    atkTeam.name = ""
    atkTeam.power = recommend.power
    local monsterGroupCfg = _G.ConfigManager.monster_group_cfg[monster_group_id]
    atkTeam.combine_skill = monsterGroupCfg.advice_att_combine
    atkTeam.fights = {}
    for k, v in pairs(monsterGroupCfg.AdviceAttackerSids) do
        if v > 0 then
            local fight = self:GetFightDataFromCfg(v, k)
            table.insert(atkTeam.fights, fight)
        end
    end

    self.recordData = reData
    index = index or 1
    self.recordCardDatas = {}
    for _, v in pairs(self.recordData.fight_arg.attacker_team) do
        for _, v2 in pairs(v.fights) do
            self.recordCardDatas[v2.sid] = v2
        end
    end
    self.recordDataDic[index] = {data = self.recordData, cardDatas = self.recordCardDatas}
end

function EmbattleItemRecommendBase:GetFightDataFromCfg(monster_cfg_id, index)
    local fightData = {}
    local monsterCfg = _G.ConfigManager.monster_cfg[monster_cfg_id]
    fightData.index = index
    fightData.sid = monsterCfg.CardID
    fightData.lv = monsterCfg.lv
    fightData.star = monsterCfg.Stars
    return fightData
end

function EmbattleItemRecommendBase:GetRecordCardData(sid, call)
    if not self.recordData or self.recordData.fight_arg.attacker_team[1].name ~= self.data.name then
        self:GetRecordData(
            function()
                if call then
                    call(self.recordCardDatas[sid])
                end
            end
        )
    else
        return self.recordCardDatas[sid]
    end
end

---检测羁绊
---@param data table 布阵数据
---@return number|number 五行|神
function EmbattleItemRecommendBase:CheckShackleByData(data)
    local element = {0, 0, 0, 0, 0, 0}
    local EmbattleController = require("EmbattleController"):GetInstance()
    local elementShackleIDs, godShackleIDs = EmbattleController:GetAllShackleIDs()
    local es, e
    for i = 1, #data do --统计五行数量
        if data[i].sid > 0 then
            es = self:GetCardElement(data[i].sid)
            for j = 1, #es do
                e = es[j]
                element[e] = element[e] + 1
            end
        end
    end
    local elementID, godID = 0, 0
    local cfgs = _G.ConfigManager.formation_cfg
    e = _G.CardElementType.God
    if element[e] > 0 then --神职业
        for i = #godShackleIDs, 1, -1 do
            if element[e] >= cfgs[godShackleIDs[i]].num_elements[1] then
                godID = godShackleIDs[i]
                break
            end
        end
    end
    --去除神职业，判定其他五行
    element[e] = nil
    local nums, index, num
    local idIndex = {false, false, false, false, false}
    for i = #elementShackleIDs, 1, -1 do --检测五行
        nums = cfgs[elementShackleIDs[i]].num_elements
        for j = 1, #idIndex do
            idIndex[j] = false
        end
        for j = 1, #nums do
            index = 0
            num = 0
            for k = 1, #element do
                if not idIndex[k] and element[k] >= nums[j] then
                    if num == 0 or num > element[k] then
                        num = element[k]
                        index = k
                    end
                end
            end
            if index == 0 then
                break
            else
                idIndex[index] = true
            end
        end
        if index > 0 then
            elementID = elementShackleIDs[i]
            break
        end
    end
    return elementID, godID
end

