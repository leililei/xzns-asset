local base = require "EmbattleItemGroup"
---@class EmbattleItemActivityTournament    :EmbattleItemSpiritualRealmAttack
local EmbattleItemActivityTournament = _G.BaseClass("EmbattleItemActivityTournament", base)

---初始化地方阵容
function EmbattleItemActivityTournament:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {}
    for i = 1, #self.curEmbattleType do
        local data = { 0, 0, 0, 0, 0 }
        for j = 1, #data do
            data[j] = { uid = 0, sid = 0, level = 0, star = 0 }
        end
        self.curEnemyEmbattleData[i] = data
    end
end

function EmbattleItemActivityTournament:Dispose()
end

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemActivityTournament:InitEmbattleData(sits, index)
    local attEquity = _G.ConfigManager.att_equity_cfg[14]
    if sits then
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not sit.tag or sit.tag == 0 then
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = attEquity.level
                card.soulLink_lv = sit.soulLink_lv
                card.power = sit.power or 0
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    self.curEmbattleData = { false }
    self.curUids = { false }
    self.curSids = { false }
    for i = 1, #self.curEmbattleType do
        self.curEmbattleData[i] = self:GetServerEmbattleData(self.curEmbattleType[i], i)
        local uids = {}
        local sids = {}
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j] > 0 then
                local card = self:GetCardData(self.curEmbattleData[i][j])
                if card then
                    self.curEmbattleData[i][j] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = attEquity.level,
                        soulLink_lv = card.soulLink_lv,
                        --power = card:GetPower(),
                        tag = 0
                    }
                    uids[card.uid] = true
                    sids[card.sid] = true
                else
                    self.curEmbattleData[i][j] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        power = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i][j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        end
        self.curUids[i] = uids
        self.curSids[i] = sids
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end

function EmbattleItemActivityTournament:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    return base.GetCardData(self, uid)
end

