        return nil
    end
    return self.curPetSkillData[index]
end

---获取monster_group_cfg的ID(每个布阵都应该有一个)
---@return number 怪物组ID
function EmbattleItemActivityTournament:GetMonsterGroupID(index)
    return self.monsterGroupID
end

function EmbattleItemActivityTournament:GetOtherGroupPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.curEmbattleType do
        if i ~= index and self.curPetSkillData[i] then
            local data = self.curPetSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

return EmbattleItemActivityTournament
