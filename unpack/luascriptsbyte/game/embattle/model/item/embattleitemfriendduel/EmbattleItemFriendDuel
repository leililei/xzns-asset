local base = require "EmbattleItemPVP"
---@class EmbattleItemFriendDuel : EmbattleItemPVP	中文描述
local EmbattleItemFriendDuel = _G.BaseClass("EmbattleItemFriendDuel", base)
---类的构造函数
function EmbattleItemFriendDuel:__init(eType, saveType, notPassServer, mgpID, data, uid, posid)
    self.data = data
    self.enemyUid = uid
    self.curChallengePosID = posid
    self.showEnemySoulAndTalents = true
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemFriendDuel:SaveEmbattle(saveCall)
    self.mSaveCall = saveCall
    base.SaveEmbattle(self, _G.handler(self, self.OnSavedCallChild))
end

function EmbattleItemFriendDuel:OnSavedCallChild(result, ...)
    local params = _G.SafePack(...)
    self.mSaveCall(result, _G.SafeUnpack(params))
    local BattleManagerIns = _G.BattleManager:GetInstance()

    local port =
        require "FriendsNet":GetInstance():Duel(
        {f_uid = self.enemyUid.uid},
        function(msg)
            if msg.ack == 1 then
                if msg then
                --msg.fight_arg.winner = msg.winner
                -- if msg.winner == 1 then
                --     msg.winner = 0
                -- else
                --     msg.winner = 1
                -- end
                end

                BattleManagerIns:EnterFight(_G.BattleControllerType.BattleControllerFriendDuel, msg, self.enemyUid)
            else
                _G.BaseBattleManager:GetInstance():ClearView(true)
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
                _G.WorldManager:GetInstance():GetCurWorld():ChangeCameraBattle()
                _G.WorldManager:GetInstance():DespawnRoleParent()

                local UIManagerIns = _G.UIManager:GetInstance()
                local ui_cfg = _G.ConfigManager.ui_cfg
                -- UIManagerIns:CloseWindow(ui_cfg.ArenaEmbattleView.Name)
                UIManagerIns:OpenWindow(ui_cfg.MainView.Name)
            end
        end
    )
    BattleManagerIns:AddLuaNetEvent(port)
end

---获取是否展示跳过战斗
function EmbattleItemFriendDuel:GetShowSkip()
    --self.AttackName = 1

    return false --_G.FunctionManager:GetInstance():CheckFunctionIsUnlock(96)
end

function EmbattleItemFriendDuel:IsShowEnemyPetSkill()
    return true
end

function EmbattleItemFriendDuel:GetEnemyPetSkillData()
    if not self.data then
        return nil
    end
    return self.data.pet
end

return EmbattleItemFriendDuel
