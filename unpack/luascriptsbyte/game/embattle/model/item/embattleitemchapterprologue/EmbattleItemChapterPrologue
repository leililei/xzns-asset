local EmbattleItemChapterPrologueCardData = _G.BaseClass("EmbattleItemChapterPrologueCardData")
function EmbattleItemChapterPrologueCardData:__init(cfg)
    self.uid = cfg.id
    self.sid = cfg.CardID
    self.cfg = _G.ConfigManager.card_cfg[self.sid]
    self.lv = cfg.Level
    self.star = cfg.Stars
    self.power = cfg.Power
    self.Grade = self.cfg.Order
end
function EmbattleItemChapterPrologueCardData:Dispose()
    self.uid = nil
    self.sid = nil
    self.cfg = nil
    self.lv = nil
    self.star = nil
    self.power = nil
end
function EmbattleItemChapterPrologueCardData:GetLevel()
    return self.lv
end
function EmbattleItemChapterPrologueCardData:GetStar()
    return self.star
end
function EmbattleItemChapterPrologueCardData:GetPower()
    return self.power
end
--endregion

local EmbattleItemPVE = require "EmbattleItemPVE"
---@class EmbattleItemChapterPrologue	中文描述
local EmbattleItemChapterPrologue = _G.BaseClass("EmbattleItemChapterPrologue", EmbattleItemPVE)

---类的构造函数
function EmbattleItemChapterPrologue:__init()
    self.curCombSkillData = {{id = 0}, {id = 0}, {id = 0}}
end

---类的析构函数
function EmbattleItemChapterPrologue:Dispose()
end

function EmbattleItemChapterPrologue:InitEmbattleData()
    self.curUids = {}
    local EmbattleModel = require("EmbattleModel"):GetInstance()
    local monsterCfgs = _G.ConfigManager.monster_cfg
    self.curEmbattleData = EmbattleModel:GetEmbattleData(self.curEmbattleType)
    local sid = 0
    local monCfg
    for i = 1, #self.curEmbattleData do
        sid = self.curEmbattleData[i]
        if sid > 0 then
            monCfg = monsterCfgs[sid]
            self.curEmbattleData[i] = {
                uid = sid,
                sid = monCfg.CardID,
                star = monCfg.Stars,
                level = monCfg.Level,
                soulLink_lv = 0,
                tag = 0
            }
            self.curUids[sid] = true
        else
            self.curEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 0,
                soulLink_lv = 0,
                tag = 0
            }
        end
    end
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemChapterPrologue:InitCardList()
    local groupCfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
    local list = groupCfg.DefaultAttackerSids
    local cfgs = _G.ConfigManager.monster_cfg
    self.curChooseCardList = {}
    local insert = _G.table.insert
    for i = 1, #list do
        if list[i] > 0 then
            insert(self.curChooseCardList, EmbattleItemChapterPrologueCardData.New(cfgs[list[i]]))
        end
    end
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return table 卡牌数据对象
function EmbattleItemChapterPrologue:GetCardData(uid)
    for i = 1, #self.curChooseCardList do
        if uid == self.curChooseCardList[i].uid then
            return self.curChooseCardList[i]
        end
    end
    return nil
end

---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemChapterPrologue:GetMyEmbattlePower(index)
    local power = 0
    local uid = 0
    local card = nil
    local cfgs = _G.ConfigManager.monster_cfg
    for i = 1, #self.curEmbattleData do
        uid = self.curEmbattleData[i].uid
        if uid > 0 then
            power = power + cfgs[uid].Power
        end
    end
    uid = nil
    card = nil
    return power
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param curIndex number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemChapterPrologue:CheckCardLock(uid, curIndex)
    return 1
end

