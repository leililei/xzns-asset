end

function EmbattleItemGroup:SetTempPetSkillData(data, index, revert)
    if revert then
        if self.tempPetSkillData then
            self:SetPetSkillData(self.tempPetSkillData, index)
        end
    else
        if not self.curPetSkillData then
            self.curPetSkillData = {}
        end
        local pets = self.curPetSkillData[index]
        if not pets then
            pets = {0, 0, 0}
            self.curPetSkillData[index] = pets
        end
        self.tempPetSkillData = _G.DeepCopy(self.curPetSkillData[index])
        for i = 1, #data do
            pets[i] = data[i]
        end
    end
end

