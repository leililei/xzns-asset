---检测是否还有可以上阵的合击技
---@param index number 合击技序列号
---@param embattleIndex number 布阵序列
function EmbattleItemGroup:CheckCombineSkillEquip(index, embattleIndex)
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    if not EmbattleModelIns:CheckSkillPosUnLock(index) then --锁住的
        return false
    end
    local data = self.curCombSkillData[embattleIndex]
    if data[index].id > 0 then --已经选择了合击技
        return false
    end
    local skills = require("CombineModel"):GetInstance():GetUnLockCombine()
    --未初始化合击技数据
    if not skills then
        return false
    end
    local count = 0
    local equipSkillDic = {}
    for i = 1, #self.curCombSkillData do
        if
            (i ~= embattleIndex) and EmbattleModelIns:CheckSkillPosUnLock(index) and
                self.curCombSkillData[i][index].id > 0
         then --已经解锁了并且上阵有技能
            count = count + 1
            equipSkillDic[self.curCombSkillData[i][index].id] = true
        end
    end
    local cfgs = _G.ConfigManager.combine_cfg
    for sid, level in pairs(skills) do
        if cfgs[sid] and cfgs[sid].classify == index then
            if equipSkillDic[sid] then
                count = count - 1
                if count < 0 then --超过了已选择的数量就肯定有能上阵的技能
                    return true
                end
            else
                return true
            end
        end
    end
    return false
end
---获取合击技数据
---@param index number 布阵序列
---@return table 合击技数据
function EmbattleItemGroup:GetCombSkillData(index)
    if not index then
        return self.curCombSkillData
    end
    return self.curCombSkillData[index]
end
---获取其他队伍的合击技数据
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function EmbattleItemGroup:GetOtherGroupSkillData(index)
    local skills = {}
    local data
    local stype = _G.CombineViewShowType.shadow
    for i = 1, #self.curCombSkillData do
        if i ~= index then
            data = self.curCombSkillData[i]
            for j = 1, #data do
                if data[j].id > 0 then
                    skills[data[j].id] = {stype = stype}
                end
            end
        end
    end
    return skills
end

---检测其它队伍是否已存相同合击技
---@param id number 检测合击技id
---@return boolean 是否存在
function EmbattleItemGroup:CheckOtherGroupSameSkill(id)
    local data
    for i = 1, #self.curCombSkillData do
        data = self.curCombSkillData[i]
        for j = 1, #data do
            if data[j].id == id then
                return true
            end
        end
    end
    return false
end


