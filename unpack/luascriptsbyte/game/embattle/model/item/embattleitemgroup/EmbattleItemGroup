---设置临时布阵数据
---@param revert boolean 是否为还原
function EmbattleItemGroup:SetTempEmbattleData(sits, index, revert)
    if revert then
        if self.tempEmbattleData then
            self:InitEmbattleData(self.tempEmbattleData, index)
            self.tempEmbattleData = nil
        end
    else
        self.tempEmbattleData = _G.DeepCopy(self.curEmbattleData[index])
        self.curUids[index] = {}
        self.curSids[index] = {}
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not sit.tag or sit.tag == 0 then
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                card.power = sit.power or 0
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
    end
end

