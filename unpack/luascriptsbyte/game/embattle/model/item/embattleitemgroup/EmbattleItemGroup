function EmbattleItemGroup:ChangeCardPos(dragpos, changepos, index)
    self.curChangeEmbattleIndexes[index] = true
    local data = self.curEmbattleData[index][dragpos]
    self.curEmbattleData[index][dragpos] = self.curEmbattleData[index][changepos]
    self.curEmbattleData[index][changepos] = data
    return true
