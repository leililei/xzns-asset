end
---检测是否相同SID
---@param sid number 卡牌sid
---@param outIndex number 需要排除的多组布阵序列号
---@param reverseOut number 为true则将排除视为选择，即排除outIndex之外的,契约需要用到
---@return boolean 是否存在已上阵的sid
function EmbattleItemGroup:CheckSidInEmbattle(sid, outIndex, reverseOut)
    if sid <= 0 then
        return false
    end
    outIndex = outIndex or 0
    for j = 1, #self.curEmbattleData do
        if reverseOut then
            if outIndex == j then
                if self.curSids[j][sid] then
                    return true
                end
            end
        else
            if outIndex ~= j then
                if self.curSids[j][sid] then
                    return true
                end
            end
        end
    end
    return false
end

---设置组数据
function EmbattleItemGroup:SetEmbattleData(sits, index)
    self.curUids[index] = {}
    self.curSids[index] = {}
    local card, sit
    for i = 1, #sits do
        sit = sits[i]

        card = self.curEmbattleData[index][i]
        card.uid = sit.uid
        card.sid = sit.sid
        card.star = sit.star
        card.level = sit.level
        card.soulLink_lv = sit.soulLink_lv
        if sit.uid > 0 then
            self.curUids[index][sit.uid] = true
            self.curSids[index][sit.sid] = true
        end
        card.power = sit.power or 0
        card.tag = sit.tag or 0
    end
    self.curChangeEmbattleIndexes[index] = true
end

---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemGroup:InitEmbattleData(sits, index)
    if sits then
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not sit.tag or sit.tag == 0 then
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                card.power = sit.power or 0
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    self.curEmbattleData = {false}
    self.curUids = {false}
    self.curSids = {false}
    for i = 1, #self.curEmbattleType do
        self.curEmbattleData[i] = self:GetServerEmbattleData(self.curEmbattleType[i], i)
        local uids = {}
        local sids = {}
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j] > 0 then
                local card = self:GetCardData(self.curEmbattleData[i][j])
                if card then
                    self.curEmbattleData[i][j] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        power = card:GetPower(),
                        tag = 0
                    }
                    uids[card.uid] = true
                    sids[card.sid] = true
                else
                    self.curEmbattleData[i][j] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        power = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i][j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        end
        self.curUids[i] = uids
        self.curSids[i] = sids
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
    if _G.AppSetting.IsXzns then
        self:SetBeastSkillData()
    end
end
---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
---@param swapData table 交换合击技数据
function EmbattleItemGroup:SetCombSkillData(data, index, swapData)
    if data then
        local dic
        for i = 1, #data do
            dic = self.curCombSkillData[index][i]
            if data[i].tag == 0 then
                dic.id = data[i].id
                dic.lv = data[i].lv
                dic.cskillID = data[i].cskillID
            end
        end
        if swapData then
            local data
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        data = swapData[self.curCombSkillData[i][j].id]
                        if data then
                            self.curCombSkillData[i][j] = data
                        end
                    end
                end
            end
        end
    else
        self.curCombSkillData = {false}
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        local CombineModelIns = require("CombineModel"):GetInstance()
        local cfgs = _G.ConfigManager.combine_cfg
        local id
        for i = 1, #self.curEmbattleType do
            local skill = self:GetSkillIndex(self.curEmbattleType[i])
            for j = 1, #skill do
                id = skill[j]
                skill[j] = {
                    id = id,
                    lv = 0,
                    tag = 0,
                    cskillID = 0
                }
                if id > 0 then
                    skill[j].lv = CombineModelIns:GetCombineLevel(id)
                    skill[j].cskillID = cfgs[skill[j].id].skills[skill[j].lv]
                end
            end
            self.curCombSkillData[i] = skill
        end
    end
end

---检测卡牌、合击技、宠物在其它队伍中重复上阵
function EmbattleItemGroup:CheckRepeatInOtherGroup(sits, combines, pets, index, beasts)
    local repeatPet = {}
    for _, sid in pairs(pets) do
        if sid > 0 then
            repeatPet[sid] = true
        end
    end
    if self.curPetSkillData then
        for i, v in pairs(self.curPetSkillData) do
            if i ~= index then
                for _, sid in pairs(v) do
                    if repeatPet[sid] then
                        return true
                    end
                end
            end
        end
    end

    if _G.AppSetting.IsXzns then
        local repeatBeast = {}
        for _, sid in pairs(beasts) do
            if sid > 0 then
                repeatBeast[sid] = true
            end
        end
        if self.curBeastSkillData then
            for i, v in pairs(self.curBeastSkillData) do
                if i ~= index then
                    for _, sid in pairs(v) do
                        if repeatBeast[sid] then
                            return true
                        end
                    end
                end
            end
        end
    end

    local repeatSid = {}
    local cardData
    for _, data in pairs(sits) do
        if data.uid > 0 then
            cardData = self:GetCardData(data.uid)
            if cardData then
                repeatSid[cardData.sid] = true
            end
        end
    end

    for i, v in pairs(self.curEmbattleData) do
        if i ~= index then
            for _, data in pairs(v) do
                if data.uid > 0 then
                    cardData = self:GetCardData(data.uid)
                    if cardData and repeatSid[cardData.sid] then
                        return true
                    end
                end
            end
        end
    end

    local repeatComb = {}
    for _, data in pairs(combines) do
        if data.id > 0 then
            repeatComb[data.id] = true
        end
    end
    for i, v in pairs(self.curCombSkillData) do
        if i ~= index then
            for _, data in pairs(v) do
                if repeatComb[data.id] then
                    return true
                end
            end
        end
    end
    return false
end

---保证不与其他队伍重复的情况下设置
---@param force boolean
function EmbattleItemGroup:SafeSetEmbattleData(sits, index, force)
    if force == nil then
        self:InitEmbattleData(sits, index)
        return
    end
    local repeatSid = {}
    local cardData
    for _, data in pairs(sits) do
        if data.uid > 0 then
            cardData = self:GetCardData(data.uid)
            if cardData then
                repeatSid[cardData.sid] = data
            end
        end
    end

    local sit
    for i, v in pairs(self.curEmbattleData) do
        if i ~= index then
            for _, data in pairs(v) do
                if data.uid > 0 then
                    cardData = self:GetCardData(data.uid)
                    if cardData and repeatSid[cardData.sid] then
                        sit = repeatSid[cardData.sid]
                        if force then
                            self:SetCurUids(data.uid, false, i)
                            self:SetCurSids(data.sid, false, i)
                            self:SetCurUids(sit.uid, true, index)
                            self:SetCurSids(sit.sid, true, index)
                            data.uid = 0
                            data.sid = 0
                            data.star = 0
                            data.level = 0
                            data.soulLink_lv = 0
                            data.power = 0
                        else
                            sit.uid = 0
                            sit.sid = 0
                            sit.star = 0
                            sit.level = 0
                            sit.soulLink_lv = 0
                            sit.power = 0
                        end
                    end
                end
            end
        end
    end
    self:InitEmbattleData(sits, index)
end

---保证不与其他队伍重复的情况下设置
---@param force boolean
function EmbattleItemGroup:SafeSetCombSkillData(combines, index, force)
    if force == nil then
        self:SetCombSkillData(combines, index)
        return
    end
    local repeatComb = {}
    for _, data in pairs(combines) do
        if data.id > 0 then
            repeatComb[data.id] = true
        end
    end
    for i, v in pairs(self.curCombSkillData) do
        if i ~= index then
            for _, data in pairs(v) do
                if repeatComb[data.id] then
                    if force then
                        data.id = 0
                        data.tag = 0
                        data.cskillID = 0
                        data.lv = 0
                    else
                        for _, data1 in pairs(combines) do
                            if data1.id == data.id then
                                data1.id = 0
                                data1.tag = 0
                                data1.cskillID = 0
                                data1.lv = 0
                            end
                        end
                    end
                end
            end
        end
    end
    self:SetCombSkillData(combines, index)
end

---保证不与其他队伍重复的情况下设置
---@param force boolean
function EmbattleItemGroup:SafeSetPetSkillData(pets, index, force)
    if force == nil then
        self:SetPetSkillData(pets, index)
        return
    end
    local repeatPet = {}
    for _, sid in pairs(pets) do
        if sid > 0 then
            repeatPet[sid] = true
        end
    end
    if self.curPetSkillData then
        for i, v in pairs(self.curPetSkillData) do
            if i ~= index then
                for j = 1, #v do
                    if repeatPet[v[j]] then
                        if force then
                            v[j] = 0
                        else
                            for w = 1, #pets do
                                if pets[w] == v[j] then
                                    pets[w] = 0
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    self:SetPetSkillData(pets, index)
end

