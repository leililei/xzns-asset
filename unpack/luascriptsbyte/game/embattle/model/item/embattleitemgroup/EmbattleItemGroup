---获取布阵数据
---@param index number 序列号
---@return table 布阵数据
function EmbattleItemGroup:GetEmbattleData(index)
    if self.curEmbattleData == nil then
        self:InitEmbattleData()
    end
    self.embattleIndex = index or self.embattleIndex
    return self.curEmbattleData[index]
end
---获取敌方布阵数据
---@return table 地方布阵数据
function EmbattleItemGroup:GetEnemyEmbattleData(index)
    if self.curEnemyEmbattleData == nil then
