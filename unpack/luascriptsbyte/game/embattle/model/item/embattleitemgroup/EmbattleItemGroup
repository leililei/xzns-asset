---保存布阵数据
---@param saveCall function 保存回调
function EmbattleItemGroup:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local EmbattleModel = require("EmbattleModel"):GetInstance()
    local sits = {}
    local uid = 0
    local pet = { 0, 0, 0 }
    local beast = { 0, 0, 0 }
    local skill = {0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = {}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            sits[i][j] = uid < 0 and 0 or uid
        end
        for j = 1, #skill do
            skill[j] = self.curCombSkillData[i][j].id
        end
        for j = 1, #pet do
            if self.curPetSkillData and self.curPetSkillData[i] then
                pet[j] = self.curPetSkillData[i][j]
            else
                pet[j] = 0
            end
        end
        if _G.AppSetting.IsXzns then
            for j = 1, #beast do
                if self.curBeastSkillData and self.curBeastSkillData[i] then
                    beast[j] = self.curBeastSkillData[i][j]
                else
                    beast[j] = 0
                end
            end
        end
        EmbattleModel:SetSkillIndex(self.curEmbattleType[i], skill)
        EmbattleModel:SetPetSkillIndex(self.curEmbattleType[i], pet)
        if _G.AppSetting.IsXzns then
            EmbattleModel:SetBeastSkillIndex(self.curEmbattleType[i], beast)
        end
    end
    EmbattleModel:SaveEmbattleDataTable(self.curEmbattleType, _G.handler(self, self.OnSaveEnd), sits)
end
---保存布阵数据回调
---@param result number 保存结果(0成功)
function EmbattleItemGroup:OnSaveEnd(result)
    if result == 0 then
        if self.onSaveCall then
            self.onSaveCall(0, self.embattleIndex)
            self.onSaveCall = nil
        end
    else
        if self.onSaveCall then
            self.onSaveCall(result, self.embattleIndex)
            self.onSaveCall = nil
        end
    end
end
---清空
---@param index number 编号(针对多布阵数据  挂机副本)
function EmbattleItemGroup:ClearEmbattle(index)
    if self.curEmbattleData == nil or self.curEmbattleData[index] == nil then
        return
    end
    local card
    for i = 1, #self.curEmbattleData[index] do
        card = self.curEmbattleData[index][i]
        card.uid = 0
        card.sid = 0
        card.level = 0
        card.star = 0
        card.soulLink_lv = 0
        card.power = 0
    end
    self.curUids[index] = {}
    self.curSids[index] = {}
    self.curChangeEmbattleIndexes[index] = true
    if not self.curCombSkillData and not self.curCombSkillData[index] then
        return
    end
    local skill
    for i = 1, #self.curCombSkillData[index] do
        skill = self.curCombSkillData[index][i]
        skill.id = 0
        skill.lv = 0
        skill.cskillID = 0
    end

    if self.curPetSkillData then
        for i = 1, #self.curPetSkillData[index] do
            self.curPetSkillData[index][i] = 0
        end
    end
    if _G.AppSetting.IsXzns then
        if self.curBeastSkillData then
            for i = 1, #self.curBeastSkillData[index] do
                self.curBeastSkillData[index][i] = 0
            end
        end
    end
end
---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemGroup:GetMyEmbattlePower(index, isView)
    if self.curEmbattleData == nil or self.curEmbattleData[index] == nil then
        return 0
    end
    local power = 0
    local uid = 0
    local card = nil
    for i = 1, #self.curEmbattleData[index] do
        uid = self.curEmbattleData[index][i].uid
        if uid > 0 then
            card = self:GetCardData(uid)
            power = power + card:GetPower(isView)
        end
    end
    uid = nil
    card = nil
    return power
end
---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemGroup:CheckCardLock(uid, index)
    local card = self:GetCardData(uid)
    if self:CheckUidInEmbattle(uid, index) then --当前布阵上阵
        return 1
    end
    for i = 1, #self.curEmbattleData[index] do
        if self.curEmbattleData[index][i].sid == card.sid then --sid重复
            return 2, 140101
        end
    end
    return 1
end
---检测空位是否还有可上阵的英雄
---@param index number 选择的队伍序列(默认nil 检查全部)
---@return boolean 是否有空位并且有可上阵的英雄
function EmbattleItemGroup:CheckEmptyPos(index)
    local hero, guardian
    local empty = {}
    for j = 1, #self.curEmbattleType do
        if not index or index == j then
            for i = 1, #self.curEmbattleData[j] do
                if self.curEmbattleData[j][i].uid == 0 then
                    if not empty[j] then
                        empty[j] = i
                    end
                end
            end
        end
    end
    local list = self:GetCardList()
    for inx, pos in pairs(empty) do
        for k = 1, #list do
            if not self:CheckUidInEmbattle(list[k].uid) and not self:CheckSidInEmbattle(list[k].sid) then --未上阵且SID不重复
                return pos, inx
            end
        end
    end
    return 0
end
