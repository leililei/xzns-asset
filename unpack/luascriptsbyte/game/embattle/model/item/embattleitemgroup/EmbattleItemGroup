local EmbattleItemBase = require "EmbattleItemBase"

---@class EmbattleItemGroup	:EmbattleItemBase
local EmbattleItemGroup = _G.BaseClass("EmbattleItemGroup", EmbattleItemBase)

---类的构造函数
function EmbattleItemGroup:__init()
    self.curChangeEmbattleIndexes = {}
    self.embattleIndex = 1
end

---类的析构函数
function EmbattleItemGroup:Dispose()
    self.curChangeEmbattleIndexes = nil
    self.embattleIndex = nil
end
---获取布阵类型数量
---@return number 布阵类型数量
function EmbattleItemGroup:GetEmbattleTypeCount()
    return #self.curEmbattleType
end
---获取所有的布阵数据
---@return table 布阵数据组
function EmbattleItemGroup:GetAllEmbattleData()
    if not self.curEmbattleData then
        self:InitEmbattleData()
    end
    return self.curEmbattleData
end
---获取多有敌方数据
---@return table 布阵数据组
