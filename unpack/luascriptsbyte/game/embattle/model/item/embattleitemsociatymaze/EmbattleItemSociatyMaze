local base = require("EmbattleItemPVE")

---@class EmbattleItemSociatyMaze: EmbattleItemPVE	公会-暗影迷宫布阵
---@field elements number[]                 @限定的卡类型, 如果为nil则不作任何限制
local EmbattleItemSociatyMaze = _G.BaseClass("EmbattleItemSociatyMaze", base)
---类的构造函数

function EmbattleItemSociatyMaze:__init(etype, saveType, notPassServer, mgpID, elements)
    self.AttackName = "SociatyMaze"
    self.elements = elements

    if self.elements and #self.elements > 0 then
        self:InitEmbattleData()
        self:InitCardList()
    end
end

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemSociatyMaze:InitEmbattleData(sits, index)
    -- if not self.elements or #self.elements == 0 then
    --     base.InitEmbattleData(self, sits, index)
    --     return
    -- end

    local attEquity = _G.ConfigManager.att_equity_cfg[11]
    if sits then
        for i = 1, #sits do
            local card, sit = self.curEmbattleData[i], sits[i]
            if card.uid > 0 then
                self:SetCurUids(card.uid, false)
                self:SetCurSids(card.sid, false)
            end
            --检测当前队伍是否满足五行限定要求
            ---@type CardData
            local cardData = self:GetCardData(sit.uid)
            if cardData and self:CheckElements(cardData.cfg.Elements) then
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = attEquity.level
                card.soulLink_lv = sit.soulLink_lv
                self:SetCurUids(card.uid, true)
                self:SetCurSids(card.sid, true)
            else
                card.uid = 0
                card.sid = 0
                card.star = 0
                card.level = 1
                card.soulLink_lv = 0
            end
        end
    else
        self.curEmbattleData = self:GetServerEmbattleData(self.curEmbattleType)
        --限定五行类型且队伍为空时, 布阵队伍从基础队伍中继承
        if self.curEmbattleType ~= _G.EmbattleType.sociatyMaze then
            local isEmpty = true
            for i = 1, #self.curEmbattleData do
                if self.curEmbattleData[i] > 0 then
                    isEmpty = false
                    break
                end
            end
            if isEmpty then
                self.curEmbattleData = self:GetServerEmbattleData(_G.EmbattleType.sociatyMaze)
            end
        end
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i] > 0 then
                --检测当前队伍是否满足五行限定要求
                ---@type CardData
                local cardData = self:GetCardData(self.curEmbattleData[i])
                if cardData and self:CheckElements(cardData.cfg.Elements) then
                    self.curEmbattleData[i] = {
                        uid = cardData.uid,
                        sid = cardData.sid,
                        star = cardData:GetStar(),
                        level = attEquity.level,
                        soulLink_lv = cardData.soulLink_lv,
                        tag = 0
                    }
                    self:SetCurUids(cardData.uid, true)
                    self:SetCurSids(cardData.sid, true)
                else
                    self.curEmbattleData[i] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    tag = 0
                }
            end
        end
        self:SetCombSkillData()
        self:SetPetSkillData()
        if _G.AppSetting.IsXzns then
            self:SetBeastSkillData()
        end
    end
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemSociatyMaze:InitCardList()
    -- if not self.elements or #self.elements == 0 then
    --     base.InitCardList(self)
    --     return
    -- end

    local attEquity = _G.ConfigManager.att_equity_cfg[11]

    ---@type CardData[]
    self.curChooseCardList = {}
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    for _, v in pairs(cards) do
        if self:CheckElements(v.cfg.Elements) then
            ---觉醒等级
            local tempawaken_lv =
            require "CardInfoManager":GetInstance():GetAttPotential(attEquity.potential_lv, v)
            local card = _G.DeepCopy(v)
            card:SetLevel(attEquity.level)
            card:PotentialUp(tempawaken_lv)
            card.shenshiPosType = 0
            card:CalcNowSumProp()
            _G.table.insert(self.curChooseCardList, card)
        end
    end
    self:SortCardList()
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return CardData 卡牌数据对象
function EmbattleItemSociatyMaze:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end

    if self.curChooseCardList then
        for i = 1, #self.curChooseCardList do
            if self.curChooseCardList[i].uid == uid then
                return self.curChooseCardList[i]
            end
        end
    end

    -- return _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
end

---检测编队是否能够上阵
---@return boolean ,number  _,tipsId
function EmbattleItemSociatyMaze:CheckGroupIsPut(data)
    if not self.elements or #self.elements == 0 then
        return true, 0
    end

    for _, v in pairs(data) do
        if v.uid > 0 then
            local cardData = self:GetCardData(v.uid)
            if not cardData or not self:CheckElements(cardData.cfg.Elements) then
                return true, 310405
            end
        end
    end
    return true, 0
end

---获取布阵筛选锁定五行
---@return CardElementType[] 五行枚举
function EmbattleItemSociatyMaze:GetLockElement()
    if not self.elements or #self.elements == 0 then
        return nil
    end
    return self.elements
end

---退出布阵是否缓存
---@return boolean
function EmbattleItemSociatyMaze:GetCacheModelQuitEmbattle()
    return true
end

---是否展示跳过战斗按钮
---@return boolean
function EmbattleItemSociatyMaze:GetShowSkip()
    return true
end

---检测五行是否符合需求
---@param element number
---@return boolean
function EmbattleItemSociatyMaze:CheckElements(element)
    if not self.elements or #self.elements == 0 then
        return true
    end
    local index = _G.table.indexof(self.elements, element)
    return index and index >= 0
end

return EmbattleItemSociatyMaze
