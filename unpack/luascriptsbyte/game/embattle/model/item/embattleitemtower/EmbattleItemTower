---初始化敌方布阵数据
function EmbattleItemTower:InitEmbattleData(sits, index)
    if sits then
        --如果是编队设置，则会把其他队伍的角色放到这个队伍来
        self:ClearEmbattle(index)
        local data, card, sit
        data = self.curEmbattleData[index]
        for i = 1, #sits do
            sit = sits[i]
            card = data[i]
            if not sit.tag or sit.tag == 0 and card.tag == 0 then
                if sit.uid > 0 and not self.passCardTab[sit.uid] then
                    card.uid = sit.uid
                    card.sid = sit.sid
                    card.star = sit.star
                    card.level = sit.level
                    card.soulLink_lv = sit.soulLink_lv
                    card.power = sit.power or 0
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        for i = 1, #self.curEmbattleData do
            if i ~= index then
                data = self.curEmbattleData[i]
                for j = 1, #data do
                    if self.curUids[index][data[j].uid] then
                        self:SetCurUids(data[j].uid, false, i)
                        data[j].uid = 0
                        data[j].sid = 0
                        data[j].star = 0
                        data[j].level = 0
                        data[j].soulLink_lv = 0
                        data[j].power = 0
                    end
                end
            end
        end
    else
        base.InitEmbattleData(self)
    end
    local curTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    if nil == curTowerType or curTowerType == 9 then
        for i = 1, #self.curEmbattleData do
            for j = 1, #self.curEmbattleData[i] do
                if self.curEmbattleData[i][j] and self:CheckCardAssist(self.curEmbattleData[i][j].uid) then
                    if not self.putAssistUids then
                        self.putAssistUids = {}
                    end
                    if not self.putAssistUids[i] then
                        self.putAssistUids[i] = {}
                    end
                    self.putAssistUids[i][j] = self.curEmbattleData[i][j].uid
                end
            end
        end
        return
    end
    local temp
    for i = 1, #self.curEmbattleData do
        for j = 1, #self.curEmbattleData[i] do
            temp = self.curEmbattleData[i][j]
            local uid = temp.uid
            if uid > 0 then
                local card = self:GetCardData(temp.uid)
                if card and require "CardInfoManager":GetInstance():CheckMultiMatch(curTowerType,card.cfg.Elements_new) then
                    if not self.curUids[i] then
                        self.curUids[i] = {}
                    end
                    self.curUids[i][temp.uid] = true
                    self.curSids[i][temp.sid] = true
                else
                    if self.curUids[i] then
                        self.curUids[i][temp.uid] = nil
                    end
                    if self.curSids[i] then
                        self.curSids[i][temp.sid] = nil
                    end
                    temp.uid = 0
                    temp.sid = 0
                    temp.star = 0
                    temp.level = 1
                end
            else
                temp.uid = 0
                temp.sid = 0
                temp.star = 0
                temp.level = 1
            end
        end
    end
    for i = 1, #self.curEmbattleData do
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j] and self:CheckCardAssist(self.curEmbattleData[i][j].uid) then
                if not self.putAssistUids then
                    self.putAssistUids = {}
                end
                if not self.putAssistUids[i] then
                    self.putAssistUids[i] = {}
                end
                self.putAssistUids[i][j] = self.curEmbattleData[i][j].uid
            end
        end
    end
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemTower:CheckCardLock(uid, index)
    local tmep = base.CheckCardLock(self, uid, index)
    if tmep ~= _G.EmbattleState.None then
        return tmep
    end
    local curTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    ---如果是五行塔
    if curTowerType ~= 9 then
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
        if card then
            --LogError(card.cfg.Elements_new)
            if not require "CardInfoManager":GetInstance():CheckMultiMatch(curTowerType, card.cfg.Elements_new) then
                return 2
            end
        end
    end
    return 1
end

---检测编队界面是否展示锁住
---@param uid number 卡牌Uid
---@return boolean 是否展示锁
function EmbattleItemTower:CheckGroupFormationLock(uid)
    local curTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    if curTowerType ~= 9 then
        local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
        if card then
            if not require "CardInfoManager":GetInstance():CheckMultiMatch(curTowerType, card.cfg.Elements_new) then
                return true
            end
        end
    end
    return false
end

---获取布阵筛选锁定五行
---@return CardElementType 五行枚举
function EmbattleItemTower:GetLockElement()
    local CurTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    if CurTowerType == 9 then
        return nil
    else
        return { CurTowerType }
    end
end

