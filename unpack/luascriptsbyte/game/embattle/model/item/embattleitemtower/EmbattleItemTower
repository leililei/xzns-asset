---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemTower:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    --TODO:判定是否是第一场战斗 需要重置布阵数据
    if _G.DeadsoulTowerManager:GetInstance():CheckBattleFirst() then
        require("DeadsoulTowerNet"):GetInstance():Leave(_G.handler(self, self.OnLeaveCall))
        _G.DeadsoulTowerManager:GetInstance():ClearStatisticsData()
    else
        self:OnLeaveCall()
    end
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemTower:OnLeaveCall()
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    local emdata
    local uid = 0
    local pet = { 0, 0, 0 }
    local beast= { 0, 0, 0 }
    local skill = { 0, 0, 0 }
    local sits = { 0, 0, 0, 0, 0 }
    local sits2 = { 0, 0, 0, 0, 0 }
    local saveServerTypID = 0
    --TODO:需求变更 镇魂街ZHJ-18263【放置多队保存】放置系统新增多队，阵容保存规则补充
    if #self.monsterGroupID == 1 then
        --单队挑战，保存服务器
        saveServerTypID = self.curEmbattleType[1]
    else
        --多队布阵保存本地并保存临时阵容至服务器
        --TODO:保存数据在本地
        for i = 1, #self.curEmbattleData do
            if not self.storyBattleTag[i] then
                emdata = {}
                for j = 1, #self.curEmbattleData[i] do
                    uid = self.curEmbattleData[i][j].uid
                    if self:CheckCardAssist(uid) then
                        emdata[j] = 0
                    else
                        emdata[j] = uid < 0 and 0 or uid
                    end
                end
                for j = 1, #skill do
                    if self.curCombSkillData[1][j].tag == 0 then
                        skill[j] = self.curCombSkillData[i][j].id
                    end
                end
                for j = 1, #pet do
                    if self.curPetSkillData and self.curPetSkillData[i] then
                        pet[j] = self.curPetSkillData[i][j]
                    else
                        pet[j] = 0
                    end
                end
	        if _G.AppSetting.IsXzns then
                    for j = 1, #beast do
                        if self.curBeastSkillData and self.curBeastSkillData[i] then
                            beast[j] = self.curBeastSkillData[i][j]
                        else
                            beast[j] = 0
                        end
                    end
		end
                EmbattleModelIns:SetSkillIndex(self.curEmbattleType[i], skill)
                EmbattleModelIns:SetPetSkillIndex(self.curEmbattleType[i], pet)
                if _G.AppSetting.IsXzns then
                    EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType[i], beast)
                end
                EmbattleModelIns:SaveEmbattleDataNew(
                        self.curEmbattleType[i],
                        nil,
                        _G.EmbattleSaveType.localfile,
                        true,
                        emdata
                )
            end
        end
    end
    --TODO:保存数据到服务器
    emdata = {}
    local temp = _G.GlobalInterface.GetNewArray(self.curEmbattleData[self.embattleIndex])
    local cards = self.curEmbattleData[self.embattleIndex]
    for j = 1, #cards do
        uid = cards[j].uid
        if self:CheckCardAssist(uid) then
            emdata[j] = 0
            sits2[j] = uid
        else
            sits[j] = uid < 0 and 0 or uid
            emdata[j] = uid < 0 and 0 or uid
        end
    end
    local skills = self.curCombSkillData[self.embattleIndex]
    for j = 1, #skill do
        if skills[j].tag == 0 then
            skill[j] = skills[j].id
        else
            skill[j] = 0
        end
    end
    for j = 1, #pet do
        if self.curPetSkillData and self.curPetSkillData[self.embattleIndex] then
            pet[j] = self.curPetSkillData[self.embattleIndex][j]
        else
            pet[j] = 0
        end
    end
    if _G.AppSetting.IsXzns then
        for j = 1, #beast do
            if self.curBeastSkillData and self.curBeastSkillData[self.embattleIndex] then
                beast[j] = self.curBeastSkillData[self.embattleIndex][j]
            else
                beast[j] = 0
            end
        end
    end
    self.count = 1
    EmbattleModelIns:SetSkillIndex(saveServerTypID, skill)
    EmbattleModelIns:SetPetSkillIndex(saveServerTypID, pet)
    if _G.AppSetting.IsXzns then
        EmbattleModelIns:SetBeastSkillIndex(saveServerTypID, beast)
    end
    EmbattleModelIns:SaveEmbattleDataNew(
            saveServerTypID,
            _G.handler(self, self.OnSaveEnd),
            _G.EmbattleSaveType.server,
            true,
            emdata
    )
    self.count = self.count + 1
    local id = self:GetAssistID()
    require "FriendHelpModel":GetInstance():SaveGarray(
            id,
            sits2,
            function()
                self:OnSaveEnd(0)
            end
    )
    local tb = {}
    for i = 1, #temp do
        tb[i] = temp[i].uid
    end
    ---如果是放置或者死魂塔客户端记录每一次的布阵存本地
    EmbattleModelIns:SaveLocalEmbattleDataByLastAssist(
            require "FriendHelpModel":GetInstance():GetCurBattleUseAssist(),
            self.curEmbattleType[self.embattleIndex],
            tb
    )
    local demoModel = require("DemoModel"):GetInstance()
    for embattleIndex, embattleId in ipairs(self.curEmbattleType) do
        local cards = self.curEmbattleData[embattleIndex]
        if cards then
            local uids = {}
            for j = 1, #cards do
                table.insert(uids, cards[j].uid)
            end
            demoModel:SaveTempEmbattleData(embattleId, uids)
        end
    end
    sits2 = nil
end

function EmbattleItemTower:OnSaveEnd(result)
    self.count = self.count - 1
    if self.count > 0 then
        return
    end
    if result == 0 then
        if self.count <= 0 and self.onSaveCall then
            self.onSaveCall(0, self.embattleIndex)
            self.onSaveCall = nil
        end
    else
        self.count = 0
        if self.onSaveCall then
            self.onSaveCall(result, self.embattleIndex)
            self.onSaveCall = nil
        end
        return
    end
end

---获取多队布阵状态
