function EmbattleItemTower:GetGroupState()
    if not self.groupState then
        self.groupState = {}
        local groups = _G.DeadsoulTowerManager:GetInstance():GetSceneID()
        for i = 1, #groups do
            self.groupState[i] = _G.DeadsoulTowerManager:GetInstance():CheckMonsterIsPass(groups[i])
        end
    end
    return self.groupState, 3310
end

function EmbattleItemTower:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    return base.GetCardData(self, uid)
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
---@param swapData table 交换合击技数据
function EmbattleItemTower:SetCombSkillData(data, index, swapData)
    if data then
        local dic, skills
        for i = 1, #data do
            skills = self.curCombSkillData[index]
            dic = skills[i]
            if data[i].tag == 0 and not self.passSkillTab[data[i].id] then
                dic.id = data[i].id
                dic.lv = data[i].lv
                dic.cskillID = data[i].cskillID
            end
        end
        if swapData then
            local data
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        data = swapData[self.curCombSkillData[i][j].id]
                        if data then
                            self.curCombSkillData[i][j] = data
                        end
                    end
                end
            end
        end
    else
        base.SetCombSkillData(self)
    end
end

