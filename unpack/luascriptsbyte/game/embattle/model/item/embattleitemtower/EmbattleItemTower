local base = require "EmbattleItemAssistGroupPVE"

---@class EmbattleItemTower    : EmbattleItemAssistGroupPVE
local EmbattleItemTower = _G.BaseClass("EmbattleItemTower", base)

---类的构造函数
function EmbattleItemTower:__init(eType, saveType, notPassServer, mgpID, index, towerSid)
    self.towerSid = towerSid
    local groups = _G.DeadsoulTowerManager:GetInstance():GetSceneID()
    if groups then
        if #groups == 1 then
            self.embattleIndex = 1
        else
            local curID = groups[1]
            if _G.DeadsoulTowerManager:GetInstance():CheckMonsterIsPass(curID) then
                for i = 1, #groups do
                    if not _G.DeadsoulTowerManager:GetInstance():CheckMonsterIsPass(groups[i]) then
                        self.embattleIndex = i
                        break
                    end
                end
            else
                for i = 1, #groups do
                    if curID == groups[i] then
                        self.embattleIndex = i
                        break
                    end
                end
            end
        end
    end
    if index then
        self.embattleIndex = index
    end
    self:InitPassCardTab()
end

function EmbattleItemTower:InitPassCardTab()
    if not self.passCardTab then
        self.passCardTab = {}
        self.passSkillTab = {}
        self.passBeastTab = {}
        for i = 1, #self.monsterGroupID do
            if _G.DeadsoulTowerManager:GetInstance():CheckMonsterIsPass(self.monsterGroupID[i]) then
                for j = 1, #self.curEmbattleData[i] do
                    if self.curEmbattleData[i][j].uid > 0 then
                        self.passCardTab[self.curEmbattleData[i][j].uid] = true
                    end
                end
                for j = 1, #self.curCombSkillData[i] do
                    if self.curCombSkillData[i][j].id > 0 then
                        self.passSkillTab[self.curCombSkillData[i][j].id] = true
                    end
                end
                if _G.AppSetting.IsXzns then
                    for j = 1, #self.curBeastSkillData[i] do
                        if self.curBeastSkillData[i][j] > 0 then
                            self.passBeastTab[self.curBeastSkillData[i][j]] = true
                        end
                    end 
                end
            end
        end
    end
end

