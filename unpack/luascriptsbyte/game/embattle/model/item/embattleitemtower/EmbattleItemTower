---检测是否可以出战(当前挑战的有上阵角色便可以出战)
---@return boolean|number 是否显示|哪一组未上阵角色
function EmbattleItemTower:CheckBattle()
    --现在所有队伍都需要上阵角色(后台自动战斗)
    local isValidTeam = false
    for i = 1, #self.curEmbattleData do
        isValidTeam = false
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j].sid > 0 then
                isValidTeam = true
                break
            end
        end
        if not isValidTeam then
            return false, i
        end
    end
    return true
end

