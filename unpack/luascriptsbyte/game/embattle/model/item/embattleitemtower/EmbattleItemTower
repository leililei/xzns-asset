function EmbattleItemTower:CheckIsOpenNpcGuide()
    if not require "FriendHelpModel":GetInstance():CheckCanShowNpcGuide() then
        return false
    end
    local curTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    if not (nil == curTowerType or curTowerType == 9) then
        local datas = require "FriendHelpModel":GetInstance():GetBorrowCardDatas(true, 2)
        local isHave = false
        for _, v in pairs(datas) do
            if require "CardInfoManager":GetInstance():CheckMultiMatch(curTowerType, v.cfg.Elements_new) then
                isHave = true
                break
            end
        end
        return isHave
    end
    return true
end

---检测是否展示布阵按钮助战标识
---@return 变量类型 中文描述
function EmbattleItemTower:ShowEmbattleAssitTag()
    ---@type CardData[]
    local datas = require "FriendHelpModel":GetInstance():GetBorrowCardDatas(true, 2)
    local curTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    if nil == curTowerType or curTowerType == 9 then
        return not _G.table.isEmptyOrNil(datas) and self:CheckIsPutAssist()
    else
        local isHave = false
        for _, v in pairs(datas) do
            if require "CardInfoManager":GetInstance():CheckMultiMatch(curTowerType, v.cfg.Elements_new) then
                isHave = true
                break
            end
        end
        return isHave and self:CheckIsPutAssist()
    end
end

function EmbattleItemTower:GetSkillIndex(id)
    local curTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType

    if
    curTowerType == 9 and id == _G.EmbattleType.Tower * 1000 + 1 and
            not require "EmbattleModel":GetInstance():CheckEmbattleData(id)
    then
        id = _G.EmbattleType.AFKOnly
    end
    return base:GetSkillIndex(id)
end

function EmbattleItemTower:GetAssistID()
    local id = self.curEmbattleType[1]
    if id > 1000 then
        id = _G.math.floor(id / 1000)
    end
    return id
end

--region override pet function
function EmbattleItemTower:SetPetSkillData(data, index)
    if data then
        if not self.curPetSkillData then
            self.curPetSkillData = {}
        end
        local pets = self.curPetSkillData[index]
        if not pets then
            pets = {}
            self.curPetSkillData[index] = pets
        end
        for i = 1, #data do
            pets[i] = data[i]
        end
    else
        base.SetPetSkillData(self)
    end
end

function EmbattleItemTower:SetBeastSkillData(data, index)
    if data then
        if not self.curBeastSkillData then
            self.curBeastSkillData = {}
        end
        local beast = self.curBeastSkillData[index]
        if not beast then
            beast = {}
            self.curBeastSkillData[index] = beast
        end
        for i = 1, #data do
            if not self.passBeastTab[data[i]] then
                beast[i] = data[i]
            end
        end
    else
        base.SetBeastSkillData(self)
    end
end

function EmbattleItemTower:GetPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    return self.curPetSkillData[index]
end

function EmbattleItemTower:GetBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    return self.curBeastSkillData[index]
end

function EmbattleItemTower:GetOtherGroupPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.monsterGroupID do
        if i ~= index and self.curPetSkillData[i] then
            local data = self.curPetSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleItemTower:GetOtherGroupBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.monsterGroupID do
        if i ~= index and self.curBeastSkillData[i] then
            local data = self.curBeastSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleItemTower:ClearEmbattle(index)
    local curData = self.curPetSkillData
    base.ClearEmbattle(self, index)
    if curData then
        curData[index] = nil
        self.curPetSkillData = curData
    end
end

function EmbattleItemTower:ChangeGroup(indexes)
    local items = { self.curEmbattleData[1], self.curEmbattleData[2], self.curEmbattleData[3] }
    local skills = { self.curCombSkillData[1], self.curCombSkillData[2], self.curCombSkillData[3] }
    for i = 1, #indexes do
        self.curEmbattleData[i] = items[indexes[i]]
        self.curCombSkillData[i] = skills[indexes[i]]
        self.curChangeEmbattleIndexes[i] = true
    end
    items = { self.curUids[1], self.curUids[2], self.curUids[3] }
    for i = 1, #indexes do
        self.curUids[i] = items[indexes[i]]
    end
    items = { self.curSids[1], self.curSids[2], self.curSids[3] }
    for i = 1, #indexes do
        self.curSids[i] = items[indexes[i]]
    end
    return true
end

--endregion

function EmbattleItemTower:GetAutoEmbattleData(cardList, curEmbattleIndex)
    local eleTab = self:GetLockElement()
    if eleTab == nil then
        return self.super.GetAutoEmbattleData(self, cardList, curEmbattleIndex)
    end
    local eleDic = {}
    local eleCardList = {}
    for _, v in pairs(eleTab) do
        eleDic[v] = true
    end
    for _, v in pairs(cardList) do
        if eleDic[v:GetElement()] then
            _G.table.insert(eleCardList, v)
        end
    end
    return self.super.GetAutoEmbattleData(self, eleCardList, curEmbattleIndex)
end

