        self.assistUidList[npcDatas[i].uid] = true
        self.npcAssistUidList[npcDatas[i].uid] = true
    end

    self.maxPutCount = require "FriendHelpModel":GetInstance():GetMaxUseCount(self:GetAssistID())
    local CurTowerType = require "DeadsoulTowerModel":GetInstance().CurTowerType
    local id = _G.EmbattleType.Tower
    if CurTowerType == require "DeadsoulTowerModel":GetInstance().MianTower then
        id = _G.EmbattleType.Tower
        --elseif CurTowerType == 1 then
        --    id = _G.EmbattleType.Tower1
        --elseif CurTowerType == 2 then
        --    id = _G.EmbattleType.Tower2
        --elseif CurTowerType == 3 then
        --    id = _G.EmbattleType.Tower3
        --elseif CurTowerType == 4 then
        --    id = _G.EmbattleType.Tower4
        --elseif CurTowerType == 5 then
        --    id = _G.EmbattleType.Tower5
        --end
        local demoDatas = require("DemoModel"):GetInstance():GetAllCards()
        for _, v in pairs(demoDatas) do
            if v:GetLastUseTimes(id) > 0 then
                _G.table.insert(self.curChooseCardList, 1, v)
            end
        end
    end
end

