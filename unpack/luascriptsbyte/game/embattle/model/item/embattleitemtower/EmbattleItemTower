---获取其他队伍的合击技数据
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function EmbattleItemTower:GetOtherGroupSkillData(index)
    local skills = {}
    local data, pass
    local stype = _G.CombineViewShowType
    for i = 1, #self.monsterGroupID do
        if i ~= index then
            data = self.curCombSkillData[i]
            pass = _G.DeadsoulTowerManager:GetInstance():CheckMonsterIsPass(self.monsterGroupID[i])
            for j = 1, #data do
                if data[j].id > 0 then
                    skills[data[j].id] = { stype = pass and stype.gray or stype.shadow, tipsid = pass and 3308 or nil }
                end
            end
        end
    end
    return skills
end

