    self.curEnemyEmbattleData = {}
    for i, v in ipairs(self.curEmbattleType) do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            data[j] = {uid = 0, sid = 0, level = 0, star = 0}
        end
        self.curEnemyEmbattleData[i] = data
    end
end
