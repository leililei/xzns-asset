---@class EmbattleItemActivityTrial : EmbattleItemPVE	雪域欢歌-雪域试炼
---@field model ActivityTrialSynModel
---@field activity ActivityTrialData
local EmbattleItemActivityTrial = _G.BaseClass("EmbattleItemActivityTrial", require "EmbattleItemPVE")
---类的构造函数
-----------------------------------------------------------------------

function EmbattleItemActivityTrial:__init(eType, saveType, notPassServer, mgpID, activity)
    self.model = activity:GetActivityTypeCls()
    self.activity = activity
    self.AttackName = "ActivityTrial" .. activity:GetActivityID()
end

function EmbattleItemActivityTrial:GetCurEmbattleType()
    return self.curEmbattleType, _G.handler(self, self.CheckFight)
end

function EmbattleItemActivityTrial:CheckFight()
    if not self.activity:GetFunctionOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        return false
    else
        return true
    end
end

function EmbattleItemActivityTrial:GetShowSkip()
    return true
end

return EmbattleItemActivityTrial
