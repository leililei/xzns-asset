local base = require "EmbattleItemBase"
---@class EmbattleItemDrawUpPeak	: EmbattleItemBase
local EmbattleItemDrawUpPeak = _G.BaseClass("EmbattleItemDrawUpPeak", base)

function EmbattleItemDrawUpPeak:__init(eType, saveType, notPassServer, mgpID, skipBattle)
    self.skipBattle = skipBattle or false
    self.AttackName = "DrawUpPeak"
end

function EmbattleItemDrawUpPeak:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = { 0, 0, 0, 0, 0 }
    if self.monsterGroupID == 0 then
        for i = 1, 5 do
            self.curEnemyEmbattleData[i] = { uid = 0, sid = 0, level = 0, star = 0, boss = false }
        end
        return
    end
    local cfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
    local mcfg
    --默认只取第一组
    for i = 1, 5 do
        if cfg.DefaultDefenserSids[1][i] and cfg.DefaultDefenserSids[1][i] > 0 then
            mcfg = _G.ConfigManager.monster_cfg[cfg.DefaultDefenserSids[1][i]]
            self.curEnemyEmbattleData[i] = {
                uid = mcfg.id,
                sid = mcfg.CardID,
                level = mcfg.Level,
                star = mcfg.Stars,
                scale = mcfg.GlobalScale * 0.0001,
                boss = mcfg.MonsterType == _G.HeroType.Boss
            }
        else
            self.curEnemyEmbattleData[i] = { uid = 0, sid = 0, level = 0, star = 0, boss = false }
        end
    end
end

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemDrawUpPeak:InitEmbattleData(sits, index)
    if not self.perLevel then
        self.perLevel = self:GetLevel()
    end
    if sits then
        local card, sit, cardData
        for i = 1, #sits do
            card = self.curEmbattleData[i]
            sit = sits[i]
            if card.uid > 0 then
                self:SetCurUids(card.uid, false)
                self:SetCurSids(card.sid, false)
            end
            if sit.uid > 0 then
                cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, sit.uid)
                if cardData.shenshiPosType ~= _G.StonePosType.PosZero then
                    card.uid = sit.uid
                    card.sid = sit.sid
                    card.star = sit.star
                    card.level = self.perLevel
                    card.soulLink_lv = sit.soulLink_lv
                    self:SetCurUids(card.uid, true)
                    self:SetCurSids(card.sid, true)
                else
                    card.uid = 0
                    card.sid = 0
                    card.star = 0
                    card.level = 1
                    card.soulLink_lv = 0
                end
            else
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = self.perLevel
                card.soulLink_lv = sit.soulLink_lv
            end
        end
    else
        self.curEmbattleData = self:GetServerEmbattleData(self.curEmbattleType)
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i] > 0 then
                ---@type CardData
                local card = self:GetCardData(self.curEmbattleData[i])

                if card then
                    if card.shenshiPosType ~= _G.StonePosType.PosZero then
                        self.curEmbattleData[i] = {
                            uid = card.uid,
                            sid = card.sid,
                            star = card:GetStar(),
                            level = self.perLevel,
                            soulLink_lv = card.soulLink_lv,
                            tag = 0
                        }
                        self:SetCurUids(card.uid, true)
                        self:SetCurSids(card.sid, true)
                    else
                        self.curEmbattleData[i] = {
                            uid = 0,
                            sid = 0,
                            star = 0,
                            level = 1,
                            soulLink_lv = 0,
                            tag = 0
                        }
                    end
                else
                    if _G.AppSetting.DEBUG then
                        _G.LogWarning(
                            "未找到对应uid的卡牌 uid = " .. self.curEmbattleData[i],
                            "EmbattleItemBase:InitEmbattleData"
                        )
                    end
                    self.curEmbattleData[i] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    tag = 0
                }
            end
        end
        self:SetCombSkillData()
        self:SetPetSkillData()
    end
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemDrawUpPeak:InitCardList()
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    ---@type CardData[]
    self.curChooseCardList = {}

    for _, v in pairs(cards) do
        --  if v.shenshiPosType == _G.StonePosType.PosOne or v.shenshiPosType == _G.StonePosType.PosTwo then
        ---@type CardData
        local cardData = _G.DeepCopy(v)
        _G.table.insert(self.curChooseCardList, cardData)
        cardData.shenshiPosType = _G.StonePosType.PosOne
        cardData.shenState = 0
        cardData:SetLevel(self.perLevel)
        cardData:CalcNowSumProp()
        -- end
    end
    self:SortCardList()
end

