local base = require "EmbattleItemGroup"
---@class EmbattleItemSpiritualRealmAttack	:EmbattleItemGroup
local EmbattleItemSpiritualRealmAttack = _G.BaseClass("EmbattleItemSpiritualRealmAttack", base)
---@param enemy
function EmbattleItemSpiritualRealmAttack:__init(
    eType,
    saveType,
    notPassServer,
    mgpID,
    enemy,
    index,
    skipBattle,
    reserveTypes)
    self.enemy = enemy
    self.skipBattle = skipBattle or false
    self.reserveTypes = reserveTypes
    self.AttackName = "SpiritualRealm"
    if index ~= nil then
        self.embattleIndex = index
    end
    self.curEnemyCombineData = {}
    self:InitEnemyEmbattleData()
end
---初始化地方阵容
function EmbattleItemSpiritualRealmAttack:InitEnemyEmbattleData()
    if not self.enemy then
        return
    end
    self.curEnemyEmbattleData = {false}
    self.curEnemyCombineData = {false}
    ---传的是card_skill_cfg.id, 由此反推pet_cfg和star
    self.curEnemyPetData = {false}
    self.curEnemyBeastData = {false}
    local card
    local cfg
    local cfgs = _G.ConfigManager.card_cfg
    for i = 1, #self.curEmbattleType do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            if self.enemy[i] and self.enemy[i][j] then
                card = self.enemy[i][j]
                --如果角色穿戴了皮肤, 则此处服务器传来的是skinid(需换算回card_cfg.id)
                --此处对skinid不做处理似乎也能正常运行!???
                local sid, skinId = card.sid, 0
                local isSkin, osid = require "CardCommentManager":GetInstance():GetCardSidBySkinId(sid)
                if isSkin then
                    skinId = sid
                    sid = osid
                end
                if sid > 0 then
                    cfg = cfgs[sid]
                else
                    cfg = nil
                end
                data[j] = {
                    uid = sid,
                    sid = sid,
                    level = card.level,
                    star = card.star,
                    soulLink_lv = card.soulLink_lv,
                    power = card.power,
                    scale = cfg and cfg.GlobalScale * 0.0001 or 1,
                    soulLink_IsActivate = card.soulLink_IsActivate,
                    open_inborn = card.open_inborn,
                    artifact = card.artifact,
                    skin = skinId
                }
            else
                data[j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        end
        self.curEnemyEmbattleData[i] = data
        self.curEnemyCombineData[i] = self.enemy[i].combine
        self.curEnemyPetData[i] = self.enemy[i].pet
        self.curEnemyBeastData[i] = self.enemy[i].beast
    end
end

---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemSpiritualRealmAttack:GetEnemyEmbattlePower(index)
    return self.enemy[index] and self.enemy[index].power or 0
end

---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemSpiritualRealmAttack:InitEmbattleData(sits, index)
    if sits then
        self.curUids[index] = {}
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not self:CheckUidInEmbattle(sit.uid) and not self:CheckSidInEmbattle(sit.sid) then --不在其他阵容并且没有相同SID上阵
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    base.InitEmbattleData(self)
end ---获取最大可上阵数量
