---初始化卡牌
function EmbattleItemSpiritualRealmAttack:InitCardList()
    local attEquity = _G.ConfigManager.att_equity_cfg[8]
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    ---@type CardData[]
    self.curChooseCardList = {}
    for _, v in pairs(cards) do
        local newCard = _G.CardData.New()
        local msg = require "CardInfoManager":GetInstance():GetNewCardDataByCfg(attEquity, v, newCard)
        newCard:Parse(msg)
        newCard:OnInitMutuallyData(true, nil, true)
        _G.table.insert(self.curChooseCardList, newCard)
    end
    self:SortCardList()
end
---保存阵容
function EmbattleItemSpiritualRealmAttack:SaveEmbattle(saveCall)
    ---@type number[]
    local needUpdateTypes

    --ZHJ-35759【问鼎灵域】报名了多队伍竞技场的玩家，新赛季报名单队伍，多队伍数据没清
    --将在预留队伍中的重复卡牌丶技能移除出去
    if self.reserveTypes and #self.reserveTypes > 0 then
        --获取当前上阵的数据
        ---@type number[],number[],number[]
        local cardSids, skillIds, petIds, beastIds = {}, {}, {}, {}
        for i = 1, #self.curEmbattleData do
            for j = 1, #self.curEmbattleData[i] do
                local sid = self.curEmbattleData[i][j].sid
                if sid > 0 then
                    table.insert(cardSids, sid)
                end
            end
            for j = 1, 3 do
                local id = self.curCombSkillData[i][j].id
                if id > 0 then
                    table.insert(skillIds, id)
                end
            end
            for j = 1, 3 do
                local id = self.curPetSkillData and self.curPetSkillData[i] and self.curPetSkillData[i][j] or 0
                if id > 0 then
                    table.insert(petIds, id)
                end
            end
            for j = 1, 3 do
                local id = self.curBeastSkillData and self.curBeastSkillData[i] and self.curBeastSkillData[i][j] or 0
                if id > 0 then
                    table.insert(beastIds, id)
                end
            end
        end

        --检查预留队伍中是否存在重复上阵
        needUpdateTypes = {}
        local embattleModel = require("EmbattleModel"):GetInstance()
        for i = 1, #self.reserveTypes do
            local change = false
            local cards = embattleModel:GetEmbattleData(self.reserveTypes[i])
            if cards and #cards > 0 then
                for j = #cards, 1, -1 do
                    ---@type CardData
                    local cardData = self:GetCardData(cards[j])
                    if cardData and _G.table.ContainsValue(cardSids, cardData.sid) then
                        cards[j] = 0
                        change = true
                    end
                end
            end
            local skills = embattleModel:GetSkillIndex(self.reserveTypes[i])
            if skills and #skills > 0 then
                for j = #skills, 1, -1 do
                    if _G.table.ContainsValue(skillIds, skills[j]) then
                        skills[j] = 0
                        change = true
                    end
                end
            end
            local pets = embattleModel:GetPetSkillIndex(self.reserveTypes[i])
            if pets and #pets > 0 then
                for j = #pets, 1, -1 do
                    if _G.table.ContainsValue(petIds, pets[j]) then
                        pets[j] = 0
                        change = true
                    end
                end
            end
            local beasts = embattleModel:GetBeastSkillIndex(self.reserveTypes[i])
            if beasts and #beasts > 0 then
                for j = #beasts, 1, -1 do
                    if _G.table.ContainsValue(beastIds, beasts[j]) then
                        beasts[j] = 0
                        change = true
                    end
                end
            end
            if change then
                embattleModel:SetEmbattleByUids(cards or {0, 0, 0, 0, 0}, self.reserveTypes[i])
                embattleModel:SetSkillIndex(self.reserveTypes[i], skills or {0, 0, 0})
                embattleModel:SetPetSkillIndex(self.reserveTypes[i], pets or { 0, 0, 0 })
                embattleModel:SetBeastSkillIndex(self.reserveTypes[i], beasts or { 0, 0, 0 })
                table.insert(needUpdateTypes, self.reserveTypes[i])
            end
        end
    end
    if needUpdateTypes and #needUpdateTypes > 0 then
        local embattleModel = require("EmbattleModel"):GetInstance()
        embattleModel:SaveEmbattleDataTable(
            needUpdateTypes,
            function()
                base.SaveEmbattle(
                    self,
                    function(...)
                        saveCall(..., self:IsSkipBattle())
                    end
                )
            end
        )
    else
        base.SaveEmbattle(
            self,
            function(...)
                saveCall(..., self:IsSkipBattle())
            end
        )
    end
end
