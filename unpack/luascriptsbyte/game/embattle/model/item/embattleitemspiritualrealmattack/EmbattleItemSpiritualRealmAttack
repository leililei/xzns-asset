    return self.curPetSkillData[index]
end

function EmbattleItemSpiritualRealmAttack:GetBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    return self.curBeastSkillData[index]
end

function EmbattleItemSpiritualRealmAttack:GetOtherGroupPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.curEmbattleType do
        if i ~= index and self.curPetSkillData[i] then
            local data = self.curPetSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleItemSpiritualRealmAttack:GetOtherGroupBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.curEmbattleType do
        if i ~= index and self.curBeastSkillData[i] then
            local data = self.curBeastSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleItemSpiritualRealmAttack:ClearEmbattle(index)
    local curData = self.curPetSkillData
    local curBeastData = self.curBeastSkillData
    base.ClearEmbattle(self, index)
    if curData then
        curData[index] = nil
        self.curPetSkillData = curData
    end
    if curBeastData then
        curBeastData[index] = nil
        self.curBeastSkillData = curBeastData
    end
end

function EmbattleItemSpiritualRealmAttack:IsShowEnemyPetSkill()
    local petUnlocks = self:GetPetSkillState()
    if not petUnlocks or not petUnlocks[1] then
        return false
    end
    return true
end

function EmbattleItemSpiritualRealmAttack:IsShowEnemyBeastSkill()
    local beastUnlocks = self:GetBeastSkillState()
    if not beastUnlocks or not beastUnlocks[1] then
        return false
    end
    return true
end

