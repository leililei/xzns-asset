local base = require "EmbattleItemGroup"
---@class EmbattleItemGroupPVE:	EmbattleItemGroup
local EmbattleItemGroupPVE = _G.BaseClass("EmbattleItemGroupPVE", base)

---类的构造函数
function EmbattleItemGroupPVE:__init(etype, saveType, notPassServer, monsterGroupID)
    self.storyBattleTag = {}
end

---类的析构函数
function EmbattleItemGroupPVE:Dispose()
    self.storyBattleTag = nil
end
---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemGroupPVE:InitEmbattleData(sits, index)
    if sits then
        self.curUids[index] = {}
        self.curSids[index] = {}
        self:ClearEmbattle(index)
        local data, card, sit
        data = self.curEmbattleData[index]
        for i = 1, #data do
            card = data[i]
            if card.tag == 1 then
                self:SetCurUids(card.uid, true, index)
                self:SetCurSids(card.sid, true, index)
            end
        end
        for i = 1, #sits do
            sit = sits[i]
            card = data[i]
            if not sit.tag or sit.tag == 0 and card.tag == 0 then
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                card.power = sit.power or 0
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    --region 初始化
    local cfgs = _G.ConfigManager.monster_cfg
    local mgcfgs = _G.ConfigManager.monster_group_cfg
    self.curEmbattleData = {}
    self.curUids = {}
    self.curSids = {}
    local mgcfg, mcfg, storyembattle
    for i = 1, #self.curEmbattleType do
        self.curEmbattleData[i] = {}
        mgcfg = mgcfgs[self.monsterGroupID[i]]
        storyembattle = mgcfg.DefaultAttackerSids
        ---@type number npc助战类型
        local npcType
        if self.__cname == _G.EmbattleControllerItemType.tower then
            --判断是否为死魂塔试炼
            local embattleType = self.curEmbattleType and self.curEmbattleType[1]
            if embattleType > 1000 then
                embattleType = math.floor((embattleType - 1) / 1000)
            end
            if
                embattleType == _G.EmbattleType.Tower1 or embattleType == _G.EmbattleType.Tower2 or
                    embattleType == _G.EmbattleType.Tower3 or
                    embattleType == _G.EmbattleType.Tower4 or
                    embattleType == _G.EmbattleType.Tower5
             then
                npcType = 3
            else
                npcType = 2
            end
        else
            npcType = 1
        end

        local data
        local cardData, npc = require "FriendHelpModel":GetInstance():GetBorrowCardDatas(true, npcType)
        if #cardData > 0 or #npc > 0 then
            data = require "EmbattleModel":GetInstance():GetLocalEmbattleDataByAssist(self.curEmbattleType[i])
        end
        if not data then
            data = self:GetServerEmbattleData(self.curEmbattleType[i], i)
        end
        local uids = {}
        local sids = {}
        for j = 1, #data do
            if storyembattle[j] == 1 then
                self.curEmbattleData[i][j] = {
                    uid = -1,
                    sid = 0,
                    star = 0,
                    level = 0,
                    soulLink_lv = 0,
                    power = 0,
                    tag = -1
                }
                self.storyBattleTag[i] = true
            elseif storyembattle[j] > 1 then
                if self.storyCardList == nil then
                    self.storyCardList = {}
                end
                local cfg = cfgs[storyembattle[i]]
                self.curEmbattleData[i][j] = {
                    uid = cfg.id,
                    sid = cfg.CardID,
                    star = cfg.Stars,
                    level = cfg.Level,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 1
                }
                self.storyCardList[#self.storyCardList + 1] = EmbattleItemGroupPVEStoryRoleCardData.New(cfg)
                uids[cfg.CardID] = true
                sids[cfg.id] = true
                self.storyBattleTag[i] = true
            end
        end
        for j = 1, #data do
            if not self.curEmbattleData[i][j] then
                local ed = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
                self.curEmbattleData[i][j] = ed
                if data[j] > 0 then
                    local card = self:GetCardData(data[j])
                    if card and not sids[card.sid] then
                        ed.uid = card.uid
                        ed.sid = card.sid
                        ed.star = card:GetStar()
                        ed.level = card:GetLevel()
                        ed.soulLink_lv = card.soulLink_lv
                        ed.power = card:GetPower()
                        uids[card.uid] = true
                        sids[card.sid] = true
                    end
                end
            end
        end
        self.curUids[i] = uids
        self.curSids[i] = sids
    end
    --endregion
    self:SetCombSkillData()
    self:SetPetSkillData()
    if _G.AppSetting.IsXzns then
        self:SetBeastSkillData()
    end
end
---初始化敌方布阵数据
---@return table 地方布阵数据
function EmbattleItemGroupPVE:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {}
    local mgcfgs = _G.ConfigManager.monster_group_cfg
    local mcfgs = _G.ConfigManager.monster_cfg
    local herotype = _G.HeroType
    local defenser, mcfg, card, cardCfg
    for i = 1, #self.curEmbattleType do
        local data = {
            {uid = 0, sid = 0, level = 0, star = 0, scale = 1, boss = false, power = 0},
            {uid = 0, sid = 0, level = 0, star = 0, scale = 1, boss = false, power = 0},
            {uid = 0, sid = 0, level = 0, star = 0, scale = 1, boss = false, power = 0},
            {uid = 0, sid = 0, level = 0, star = 0, scale = 1, boss = false, power = 0},
            {uid = 0, sid = 0, level = 0, star = 0, scale = 1, boss = false, power = 0}
        }
        defenser = mgcfgs[self.monsterGroupID[i]].DefaultDefenserSids[1]
        for j = 1, #data do
            if defenser[j] > 0 then
                mcfg = mcfgs[defenser[j]]
                card = data[j]
                card.uid = mcfg.id
                card.sid = mcfg.CardID
                card.level = mcfg.Level
                card.star = mcfg.Stars
                card.scale = mcfg.GlobalScale * 0.0001
                card.boss = mcfg.MonsterType == herotype.Boss or mcfg.MonsterType == herotype.Elite
                card.power = mcfg.Power
            end
        end
        self.curEnemyEmbattleData[i] = data
    end
end
---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
---@param swapData table 交换合击技数据
function EmbattleItemGroupPVE:SetCombSkillData(data, index, swapData)
    if data then
        local dic, skills
        for i = 1, #data do
            skills = self.curCombSkillData[index]
            dic = skills[i]
            if data[i].tag == 0 then
                dic.id = data[i].id
                dic.lv = data[i].lv
                dic.cskillID = data[i].cskillID
            end
        end
        if swapData then
            local data
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        data = swapData[self.curCombSkillData[i][j].id]
                        if data then
                            self.curCombSkillData[i][j] = data
                        end
                    end
                end
            end
        end
    else
        self.curCombSkillData = {}
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        local CombineModelIns = require("CombineModel"):GetInstance()
        local cfgs = _G.ConfigManager.combine_cfg
        local mgcfgs = _G.ConfigManager.monster_group_cfg
        local id, attcombine, skills, skill
        for i = 1, #self.curEmbattleType do
            attcombine = mgcfgs[self.monsterGroupID[i]].att_combine
            skills = self:GetSkillIndex(self.curEmbattleType[i])
            for j = 1, #skills do
                skill = {
                    id = 0,
                    lv = 0,
                    cskillID = 0,
                    tag = 0
                }
                if attcombine[j] and attcombine[j] ~= 0 then
                    self.storyBattleTag[i] = true
                    if attcombine[j] > 1 then
                        skill.tag = 1
                        skill.cskillID = attcombine[j]
                        skill.id = skill.cskillID
                        skill.lv = 0
                    else
                        skill.tag = -1
                    end
                else
                    if skills[j] > 0 then
                        skill.id = skills[j]
                        skill.lv = CombineModelIns:GetCombineLevel(skills[j])
                        skill.cskillID = cfgs[skill.id].skills[skill.lv]
                    end
                end
                skills[j] = skill
            end
            self.curCombSkillData[i] = skills
        end
    end
end

---清空
---@param index number 编号(针对多布阵数据  挂机副本)
function EmbattleItemGroupPVE:ClearEmbattle(index)
    local data
    if self.curEmbattleData then
        data = self.curEmbattleData[index]
        if not data then
            return
        end
    end
    local card
    for i = 1, #data do
        card = data[i]
        if card.tag == 0 then
            if card.uid > 0 then
                self:SetCurUids(card.uid, false, index)
                self:SetCurSids(card.sid, false, index)
            end
            card.uid = 0
            card.sid = 0
            card.level = 0
            card.star = 0
            card.soulLink_lv = 0
        end
    end
    self.curChangeEmbattleIndexes[index] = true
    data = nil
    if self.curCombSkillData then
        data = self.curCombSkillData[index]
        if not data then
            return
        end
    end
    local skill
    for i = 1, #data do
        skill = data[i]
        if skill.tag == 0 then
            skill.id = 0
            skill.lv = 0
            skill.cskillID = 0
        end
    end
end
---获取己方战斗力
---@param index number 布阵序列号
---@param  isView boolean 是否为布阵界面（用于试玩卡战力处理）
---@return number 战斗力
function EmbattleItemGroupPVE:GetMyEmbattlePower(index, isView)
    local power
    if self.storyBattleTag[index] then
        local mcfgs = _G.ConfigManager.monster_cfg
        local cfg, card
        power = 0
        for i = 1, #self.curEmbattleData[index] do
            card = self.curEmbattleData[index][i]
            if card.tag == 1 then
                cfg = mcfgs[card.uid]
                power = power + cfg.Power
            elseif card.tag == 0 and card.uid > 0 then
                cfg = self:GetCardData(card.uid)
                power = power + cfg:GetPower(isView)
            end
        end
    else
        power = base.GetMyEmbattlePower(self, index, isView)
    end
    return power
end
---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemGroupPVE:InitCardList()
    base.InitCardList(self)
    if self.storyCardList then
        _G.table.sort(self.storyCardList, _G.handler(self, self.SortCardListFunc))
        local insert = _G.table.insert
        for i = #self.storyCardList, 1, -1 do
            insert(self.curChooseCardList, 1, self.storyCardList[i])
        end
    end
end
---检测空位是否还有可上阵的英雄
---@param index number 选择的队伍序列(默认nil 检查全部)
---@return boolean 是否有空位并且有可上阵的英雄
function EmbattleItemGroupPVE:CheckEmptyPos(index)
    local hero, guardian
    local empty = {}
    for j = 1, #self.curEmbattleType do
        if not index or index == j then
            for i = 1, #self.curEmbattleData[j] do
                if self.curEmbattleData[j][i].uid == 0 and self.curEmbattleData[j][i].tag == 0 then
                    if not empty[j] then
                        empty[j] = i
                    end
                end
            end
        end
    end
    local list = self:GetCardList()
    for inx, pos in pairs(empty) do
        for k = 1, #list do
            if not self:CheckUidInEmbattle(list[k].uid) and not self:CheckSidInEmbattle(list[k].sid) then --未上阵且SID不重复
                return pos, inx
            end
        end
    end
    return 0
end
---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemGroupPVE:GetEnemyEmbattlePower(index)
    local power = 0
    for i = 1, #self.curEnemyEmbattleData[index] do
        power = power + self.curEnemyEmbattleData[index][i].power
    end
    return power
end
---交换卡牌位置
---@param dragpos number 拖动的卡牌位置
---@param changepos number 交换的卡牌位置
---@param index number 多布阵序列号
---@return boolean 是否交换成功
function EmbattleItemGroupPVE:ChangeCardPos(dragpos, changepos, index)
    if self.curEmbattleData[index][dragpos].tag ~= 0 or self.curEmbattleData[index][changepos].tag ~= 0 then
        return false
    end
    self.curChangeEmbattleIndexes[index] = true
    local data = self.curEmbattleData[index][dragpos]
    self.curEmbattleData[index][dragpos] = self.curEmbattleData[index][changepos]
    self.curEmbattleData[index][changepos] = data
    return true
end
---设置单个位置的布阵数据
---@param index number 序列号
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return boolean 设置是否成功
function EmbattleItemGroupPVE:SetEmbattleDataSingle(index, uid, etIndex)
    if self.curEmbattleData[etIndex][index].tag ~= 0 then
        return false
    end
    self.curChangeEmbattleIndexes[etIndex] = true
    return self:HandleEmbattleData(self.curEmbattleData[etIndex], index, uid, etIndex)
end
---获取合击技能状态
---@param index number 序列号
---@return table 技能位置状态
function EmbattleItemGroupPVE:GetCombineSkillState(index)
    if not self.combinePosState then
        self.combinePosState = {}
    end
    if not self.combinePosState[index] then
        self.combinePosState[index] = {false, false, false}
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        for i = 1, #self.combinePosState[index] do
            self.combinePosState[index][i] =
                self.curCombSkillData[index][i].tag > 0 or
                (EmbattleModelIns:CheckSkillPosUnLock(i) and self.curCombSkillData[index][i].tag == 0)
        end
    end
    return self.combinePosState[index]
end
---获取未解锁合击技解锁条件
function EmbattleItemGroupPVE:GetCombineSkillUnLockCondition(index, embattleindex)
    if not self.combinePosState or not self.combinePosState[embattleindex] then
        self:GetCombineSkillState(embattleindex)
    end
    if self.combinePosState[embattleindex][index] then
        return nil
    end
    return require("EmbattleModel"):GetInstance():GetSkillPosUnLockParam(index)
end
---检测是否展示布阵按钮助战标识
---@return 变量类型 中文描述
function EmbattleItemGroupPVE:ShowEmbattleAssitTag()
    return self.storyCardList ~= nil and #self.storyCardList > 0
end
---获取其他队伍的合击技数据
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function EmbattleItemGroupPVE:GetOtherGroupSkillData(index)
    local skills = {}
    local data
    local stype = _G.CombineViewShowType.shadow
    for i = 1, #self.curCombSkillData do
        if i ~= index then
            data = self.curCombSkillData[i]
            for j = 1, #data do
                if data[j].id > 0 then
                    skills[data[j].id] = {stype = stype}
                end
            end
        end
    end
    return skills
end

--region override pet function
function EmbattleItemGroupPVE:SetPetSkillData(data, index)
    if data then
        if not self.curPetSkillData then
            self.curPetSkillData = {}
        end
        local pets = self.curPetSkillData[index]
        if not pets then
            pets = {}
            self.curPetSkillData[index] = pets
        end
        for i = 1, #data do
            pets[i] = data[i]
        end
    else
        self.curPetSkillData = {}
        for i = 1, #self.curEmbattleType do
            self.curPetSkillData[i] = self:GetPetSkillIndex(self.curEmbattleType[i])
        end
    end
end
function EmbattleItemGroupPVE:SetBeastSkillData(data, index)
    if data then
        if not self.curBeastSkillData then
            self.curBeastSkillData = {}
        end
        local beasts = self.curBeastSkillData[index]
        if not beasts then
            beasts = {}
            self.curBeastSkillData[index] = beasts
        end
        for i = 1, #data do
            beasts[i] = data[i]
        end
    else
        self.curBeastSkillData = {}
        for i = 1, #self.curEmbattleType do
            self.curBeastSkillData[i] = self:GetBeastSkillIndex(self.curEmbattleType[i])
        end
    end
end
--endregion

return EmbattleItemGroupPVE
