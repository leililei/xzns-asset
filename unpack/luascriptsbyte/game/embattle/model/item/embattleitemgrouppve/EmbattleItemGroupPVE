local EmbattleItemGroupPVEStoryRoleCardData = _G.BaseClass("EmbattleItemGroupPVEStoryRoleCardData")
---构造方法
---@param cfg monster_cfg 怪物配置
function EmbattleItemGroupPVEStoryRoleCardData:__init(cfg)
    self.uid = cfg.id
    self.sid = cfg.CardID
    self.cfg = _G.ConfigManager.card_cfg[self.sid]
    self.lv = cfg.Level
    self.star = cfg.Stars
    self.power = cfg.Power
    self.Grade = self.cfg.Order
end
function EmbattleItemGroupPVEStoryRoleCardData:Dispose()
    self.uid = nil
    self.sid = nil
    self.cfg = nil
    self.lv = nil
    self.star = nil
    self.power = nil
    self.Grade = nil
end
function EmbattleItemGroupPVEStoryRoleCardData:GetLevel()
    return self.lv
end
function EmbattleItemGroupPVEStoryRoleCardData:GetStar()
    return self.star
end
function EmbattleItemGroupPVEStoryRoleCardData:GetPower()
    return self.power
end
