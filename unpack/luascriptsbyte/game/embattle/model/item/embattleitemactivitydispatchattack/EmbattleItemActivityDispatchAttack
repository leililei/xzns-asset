local base = require "EmbattleItemActivityDispatchDefend"
---@class EmbattleItemActivityDispatchAttack    :EmbattleItemSpiritualRealmAttack
local EmbattleItemActivityDispatchAttack = _G.BaseClass("EmbattleItemActivityDispatchAttack", base)

---@param enemy
function EmbattleItemActivityDispatchAttack:__init(eType, saveType, notPassServer, mgpID, enemy)
    self.enemy = enemy
    self.AttackName = "ActivityDispatch"
end

---初始化地方阵容
function EmbattleItemActivityDispatchAttack:InitEnemyEmbattleData()
    if not self.enemy then
        return
    end
    self.curEnemyEmbattleData = { false, false, false }
    self.curEnemyCombineData = { false, false, false }
    self.curEnemyPetData = { false, false, false }
    self.curEnemyBeastData = { false, false, false }
    local card
    local cfg
    local cfgs = _G.ConfigManager.card_cfg
    for i = 1, #self.curEmbattleType do
        local data = { 0, 0, 0, 0, 0 }
        for j = 1, #data do
            if self.enemy[i] and self.enemy[i].team[j] then
                card = self.enemy[i].team[j]
                if card.sid > 0 then
                    cfg = cfgs[card.sid]
                else
                    cfg = nil
                end
                local isweak, wsid = require "CardCommentManager":GetInstance():CardWearSkin(card.sid)
                data[j] = {
                    uid = card.sid,
                    sid = card.sid,
                    level = card.level,
                    star = card.star,
                    soulLink_lv = card.soul_lv,
                    power = card.power,
                    scale = cfg and cfg.GlobalScale * 0.0001 or 1,
                    soulLink_IsActivate = card.soul_state,
                    open_inborn = card.born_skill_num,
                    artifact = card.artifact or {},
                    skin = wsid
                }
            else
                data[j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    artifact = {},
                    tag = 0
                }
            end
        end
        self.curEnemyEmbattleData[i] = data
        self.curEnemyCombineData[i] = self.enemy[i].combine
        self.curEnemyPetData[i] = self.enemy[i].pet
        if _G.AppSetting.IsXzns then
            self.curEnemyBeastData[i] = self.enemy[i].beast
        end
        
    end
end

---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemActivityDispatchAttack:GetEnemyEmbattlePower(index)
    return self.enemy[index].power
end

function EmbattleItemActivityDispatchAttack:IsShowEnemyPetSkill()
    local petUnlocks = self:GetPetSkillState()
    if not petUnlocks or not petUnlocks[1] then
        return false
    end
    return true
end

function EmbattleItemActivityDispatchAttack:IsShowEnemyBeastSkill()
    local beastUnlocks = self:GetBeastSkillState()
    if not beastUnlocks or not beastUnlocks[1] then
        return false
    end
    return true
end

---获取挑战按钮文字图片名字
---@return string 按钮文字图片名字
function EmbattleItemActivityDispatchAttack:GetBattleImageName()
    return "ui_bz_btn_txt_queding"
end

---获取敌人的宠物技
---@return number[] 获取到的是card_skil_cfg.id, 可反推pet_cfg和star
function EmbattleItemActivityDispatchAttack:GetEnemyPetSkillData(index)
    if self.curEnemyPetData then
        return self.curEnemyPetData[index]
    end
    return nil
end

---获取敌人的圣兽技
---@return number[] 获取到的是card_skil_cfg.id, 可反推pet_xzns_cfg和star
function EmbattleItemActivityDispatchAttack:GetEnemyBeastSkillData(index)
    if self.curEnemyBeastData then
        return self.curEnemyBeastData[index]
    end
    return nil
end

function EmbattleItemActivityDispatchAttack:GetShowMoreFormation()
    return true
end

return EmbattleItemActivityDispatchAttack