local EmbattleItemPVP = require "EmbattleItemPVP"

---@class EmbattleItemSeasonTower:EmbattleItemPVP	中文描述
local EmbattleItemSeasonTower = _G.BaseClass("EmbattleItemSeasonTower", EmbattleItemPVP)

---类的构造函数
function EmbattleItemSeasonTower:__init(etype, saveType, notPassServer, data)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
end

function EmbattleItemSeasonTower:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    local tempId = require("SeasonTowerModel"):GetInstance().tempid
    local cfg = _G.ConfigManager.season_tower_cfg[tempId]
    local enemyName = _G.GetLangPackValue(90023200002, cfg.layer)
    self.embattleView:SetVsDescription(_G.PlayerModel:GetInstance():GetName(), enemyName)
end

---类的析构函数
function EmbattleItemSeasonTower:Dispose()
    self.groupCardList = nil
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
end

--region 重写方法

---获取编队界面卡牌列表
---@return table 卡牌列表
function EmbattleItemSeasonTower:GetGroupCardList()
    return self.groupCardList
end

---初始化敌方布阵数据
function EmbattleItemSeasonTower:InitEmbattleData(sits, index)
    EmbattleItemPVP.InitEmbattleData(self, sits, index)
    self.curUids = {}
    self.curSids = {}
    local temp = {}
    local hasDead
    for i = 1, #self.curEmbattleData do
        local uid = self.curEmbattleData[i].uid
        if uid > 0 then
            local hpmp = require "SeasonTowerModel":GetInstance():GetHPMP(uid)
            if hpmp.hp > 0 then
                temp[i] = self.curEmbattleData[i]
                self.curUids[temp[i].uid] = true
            else
                hasDead = true
                temp[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    tag = 0
                }
            end
        else
            temp[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                tag = 0
            }
        end
    end
    self.curEmbattleData = temp
    if hasDead then
        _G.PopWindowManager:GetInstance():ShowAllTips(1318)
    end
end

---检测空位
function EmbattleItemSeasonTower:CheckEmptyPos()
    if self:GetIntoCount() > 0 then
        local temp_check_cardlist = {}
        local list = self:GetCardList()
        for i = 1, #list do
            local flag = false
            local card = list[i]
            local hpmp = require "SeasonTowerModel":GetInstance():GetHPMP(card.uid)
            for j = 1, #self.curEmbattleData do
                if card.uid == self.curEmbattleData[j].uid then
                    flag = true
                    break
                end
            end
            if not flag and hpmp.hp > 0 then
                _G.table.insert(temp_check_cardlist, card)
            end
        end
        if _G.table.isEmptyOrNil(temp_check_cardlist) then
            return 0
        end
    else
        return 0
    end
    return EmbattleItemPVP.CheckEmptyPos(self)
end

---当前上阵的 数量
function EmbattleItemSeasonTower:GetIntoCount()
    local count = 0
    for i = 1, 5 do
        if self.curEmbattleData[i].uid > 0 then
            count = count + 1
        end
    end
    return count
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemSeasonTower:CheckCardLock(uid, index)
    local hpmp = require "SeasonTowerModel":GetInstance():GetHPMP(uid)
    if hpmp.hp <= 0 then
        return 3
    else
        return self.super.CheckCardLock(self, uid, index)
    end
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemSeasonTower:InitCardList()
    EmbattleItemPVP.InitCardList(self)

    self.groupCardList = {}
    for i = 1, #self.curChooseCardList do
        self.groupCardList[i] = self.curChooseCardList[i]
    end
    local SeasonTowerModel = require "SeasonTowerModel":GetInstance()
    local hp
    for i = #self.curChooseCardList, 1, -1 do
        hp = SeasonTowerModel:GetHPMP(self.curChooseCardList[i].uid)
        if hp then
            self.curChooseCardList[i].hp = hp.hp * 0.0001
        end
    end
end

---检测编队界面是否展示锁住
---@param uid number 卡牌Uid
---@return boolean 是否展示锁
function EmbattleItemSeasonTower:CheckGroupFormationLock(uid)
    return false
end

---是否显示卡牌列表血量
---@return boolean 是否显示卡牌列表中血量
function EmbattleItemSeasonTower:ShowCardHP()
    return true
end

---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemSeasonTower:GetMyEmbattlePower(index, isView)
    local power = 0
    local uid = 0
    local card = nil
    for i = 1, #self.curEmbattleData do
        uid = self.curEmbattleData[i].uid
        if uid > 0 then
            card = self:GetCardData(uid)
            power = power + card:GetPower(isView)
        end
    end
    uid = nil
    card = nil
    return power
end

---是否显示敌人宠物技
---@return boolean
function EmbattleItemSeasonTower:IsShowEnemyPetSkill(index)
    return false
end

---获取敌人的宠物技
---@return number[]
function EmbattleItemSeasonTower:GetEnemyPetSkillData(index)
    if not self.curEnemyEmbattleData then
        return self.super.GetEnemyPetSkillData(self, index)
    end
    return self.curEnemyEmbattleData.pet
end

--region扩展
function EmbattleItemSeasonTower:GetCardHPPer(uid)
    return require "SeasonTowerModel":GetInstance():GetHPMP(uid).hp * 0.0001
end

--endregion

--endregion

function EmbattleItemSeasonTower:ShowFormationBtn()
    return false
end

return EmbattleItemSeasonTower
