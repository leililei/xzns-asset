---初始化布阵数据
function EmbattleItemSixVsSixPVPAttack:InitEmbattleData(sits, index)
    if not self.perLevel then
        self.perLevel = self:GetLevel()
    end
    if sits then
        self.curUids = {}
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not self:CheckUidInEmbattle(sit.uid) and not self:CheckSidInEmbattle(sit.sid) then --不在其他阵容并且没有相同SID上阵
                card = self.curEmbattleData[i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    self.curUids[sit.uid] = true
                end
            end
        end
        self.curChangeEmbattleIndexes = true
        return
    end
    self.curEmbattleData = {}
    self.curEmbattleData = self:GetAttackEmbattle()
    self.curUids = {}
    self.curSids = {}
    local uids = {}
    local sids = {}
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i] > 0 then
            local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.curEmbattleData[i])
            if card then
                local target = _G.DeepCopy(card)
                target:SetLevel(300)
                target.shenshiPosType = 0
                target:CalcNowSumProp()
                self.curEmbattleData[i] = {
                    uid = target.uid,
                    sid = target.sid,
                    star = target:GetStar(),
                    level = target:GetLevel(),
                    soulLink_lv = target.soulLink_lv,
                    power = target:GetPower(),
                    tag = 0
                }
                uids[target.uid] = true
                sids[target.sid] = true
            else
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        else
            self.curEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                power = 0,
                tag = 0
            }
        end
        self.curUids = uids
        self.curSids = sids
    end
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemSixVsSixPVPAttack:CheckCardLock(uid, index)
    if self:CheckUidInEmbattle(uid, index) then --当前布阵上阵
        return 1
    end
    local i = 0
    for k, v in pairs(self.curUids) do
        i = i + 1
        if index ~= i and self.curUids[uid] then --别的组上阵
            return 2, 220102, i
        end
    end
    local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    for j = 1, #self.curEmbattleData do
        if self.curEmbattleData[j].sid == card.sid then --sid重复
            return 2, 140101
        end
    end
    return 1
end

---初始化敌方布阵数据data
function EmbattleItemSixVsSixPVPAttack:InitEnemyEmbattleData(sits)
    if sits then
        local card_cfg = _G.ConfigManager.card_cfg
        local ccfg
        for i = 1, #sits do
            if sits[i].sid > 0 then
                local item = {}
                item.uid = sits[i].uid
                item.sid = sits[i].sid
                item.star = sits[i].star
                item.level = 300
                item.soulLink_lv = sits[i].soul_lv or 0
                item.tag = 0
                --self.curEnemyUids[sits[i]] = true
                ccfg = card_cfg[sits[i].sid]
                if ccfg then
                    item.scale = ccfg.GlobalScale * 0.0001
                end
                self.curEnemyEmbattleData[i] = item
            end
        end
    else
        self.curEnemyEmbattleData = {false, false, false, false, false, false}
        for i = 1, 6 do
            self.curEnemyEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 0
            }
        end
    end
end

