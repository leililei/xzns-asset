--检测在其他队中是否有相同布阵
function EmbattleItemSixVsSixPVPAttack:CheckCardSameLock(uid, team)
    local card = self:GetCardData(uid)
    for i = 1, 3 do
        if team ~= i then
            for n = min[i], max[i] do
                if self.curEmbattleData[n].sid == card.sid then
                    return 7, i
                end
            end
        end
    end
    return 2
end

---保存阵容
function EmbattleItemSixVsSixPVPAttack:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local SixVsSixPVPModel = require("SixVsSixPVPModel"):GetInstance()
    SixVsSixPVPModel:SetAttack(sits, _G.handler(self, self.OnSaveEnd))
    local power = 0
    for k, v in pairs(sits) do
        if v > 0 then
            local card
            card = self:GetCardData(v)
            power = power + card:GetPower(true)
        end
    end
    SixVsSixPVPModel:SetSelfPower(power)
    sits = nil
end

---保存布阵数据回调
function EmbattleItemSixVsSixPVPAttack:OnSaveEnd()
    self:OnSavedCallChild(0)
end

function EmbattleItemSixVsSixPVPAttack:OnSavedCallChild(result)
    local SixVsSixPVPModel = require("SixVsSixPVPModel"):GetInstance()
    if not SixVsSixPVPModel:CheckIsOpen() then
        return
    end
    if result == 0 then
        --TODO:检查敌人阵容
        SixVsSixPVPModel:GetEnemyEmbattleArray(
            nil,
            nil,
            function(data)
                local isEmptyOrNil = _G.table.isEmptyOrNil
                local team = data.team
                if isEmptyOrNil(team) then
                    for i = 1, #self.curEnemyEmbattleData do
                        if self.curEnemyEmbattleData[i].sid ~= 0 then --和最新布阵数据不一致
                            result = 1
                            break
                        end
                    end
                else
                    for i = 1, #self.curEnemyEmbattleData do
                        if not isEmptyOrNil(team[i]) then
                            if team[i].sid ~= self.curEnemyEmbattleData[i].sid then --和最新布阵数据不一致
                                result = 1
                                break
                            end
                        elseif self.curEnemyEmbattleData[i].sid > 0 then --和最新布阵数据不一致
                            result = 1
                            break
                        end
                    end
                end
                self.onSaveCall(result)
                if result ~= 0 then
                    local view =
                        _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SixVsSixEmbattleView.Name)
                    if view then
                        view:QuitEmbattle()
                    end
                    _G.PopWindowManager:GetInstance():ShowAllTips(1513)
                end
            end
        )
    else
        self.onSaveCall(result)
    end
end

