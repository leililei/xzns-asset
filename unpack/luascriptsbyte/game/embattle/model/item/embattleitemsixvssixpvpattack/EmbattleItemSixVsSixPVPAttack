function EmbattleItemSixVsSixPVPAttack:GetMyEmbattlePower(team)
    local power = 0
    for i = min[team], max[team] do
        if self.curEmbattleData[i] then
            local uid = self.curEmbattleData[i].uid
            if uid > 0 then
                local card = self:GetCardData(uid)
                power = power + card:GetPower(true)
            end
        end
    end
    return power
end

