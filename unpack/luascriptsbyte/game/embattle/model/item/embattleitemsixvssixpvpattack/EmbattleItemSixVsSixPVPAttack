---清空布阵
function EmbattleItemSixVsSixPVPAttack:ClearEmbattle(index)
    if self.curEmbattleData == nil or self.curEmbattleData[index] == nil then
        return
    end
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        card.uid = 0
        card.sid = 0
        card.level = 0
        card.star = 0
        card.soulLink_lv = 0
        card.power = 0
    end
    self.curUids = {}
    self.curSids = {}
    self.curChangeEmbattleIndexes = true
end

