---初始化卡牌列表
function EmbattleItemSixVsSixPVPAttack:InitCardList()
    if not self.perLevel then
        self.perLevel = self:GetLevel()
    end
    self.curChooseCardList = {}
    local insert = _G.table.insert
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    local cardList = _G.table.toArray(cards)
    for k, v in pairs(cardList) do
        local card = _G.DeepCopy(v)
        card:SetLevel(300)
        card.shenshiPosType = 0
        card:CalcNowSumProp()
        insert(self.curChooseCardList, card)
    end
    self:SortCardList()
end

function EmbattleItemSixVsSixPVPAttack:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    for i = 1, #self.curChooseCardList do
        if self.curChooseCardList[i].uid == uid then
            return self.curChooseCardList[i]
        end
    end
    -- return _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
end

