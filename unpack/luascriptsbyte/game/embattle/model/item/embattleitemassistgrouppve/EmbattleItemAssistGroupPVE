local base = require "EmbattleItemGroupPVE"

---@class EmbattleItemAssistGroupPVE:EmbattleItemAssistPVE	中文描述
local EmbattleItemAssistGroupPVE = _G.BaseClass("EmbattleItemAssistGroupPVE", base)

--region 卡牌助战
---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemAssistGroupPVE:InitCardList()
    self.putAssistUids = {}
    self.npcAssistUidList = {}
    self.maxPutCount = require "FriendHelpModel":GetInstance():GetMaxUseCount(self.curEmbattleType[1])
    self.putAssistCount = 0
    base.InitCardList(self)
    local datas, npcDatas = require "FriendHelpModel":GetInstance():GetBorrowCardDatas(true, 1)
    for i = 1, #datas do
        _G.table.insert(self.curChooseCardList, 1, datas[i])
        self.assistUidList[datas[i].uid] = true
    end
    for i = 1, #npcDatas do
        _G.table.insert(self.curChooseCardList, 1, npcDatas[i])
        --self.curChooseCardList[#self.curChooseCardList + 1] = datas[i]
        self.assistUidList[npcDatas[i].uid] = true
        self.npcAssistUidList[npcDatas[i].uid] = true
    end
end

function EmbattleItemAssistGroupPVE:GetCurEmbattleType()
    return self.curEmbattleType, _G.handler(self, self.CheckBattle)
end

---检测是否展示布阵按钮助战标识
---@return 变量类型 中文描述
function EmbattleItemAssistGroupPVE:ShowEmbattleAssitTag()
    local data1, data2 = require "FriendHelpModel":GetInstance():GetBorrowCardDatas(true, 1)

    if
        ((not _G.table.isEmptyOrNil(data1) and self:CheckIsPutAssist()) or
            (not _G.table.isEmptyOrNil(data2) and
                require "FriendHelpModel":GetInstance():CheckCanUseHelp(self.curEmbattleType[1], nil, 2)))
     then
        return true
    end
    return base.ShowEmbattleAssitTag(self)
end

---检测卡牌是否是助战角色
function EmbattleItemAssistGroupPVE:CheckCardAssist(uid)
    return self.assistUidList[uid] or base.CheckCardAssist(uid)
end

---获取最大助战数
function EmbattleItemAssistGroupPVE:GetMaxPutAssistNum()
    return require "FriendHelpModel":GetInstance():GetMaxUseAssistNum()
end

---获取编队界面卡牌列表
---@return table 卡牌列表
function EmbattleItemAssistGroupPVE:GetGroupCardList()
    return base.GetGroupCardList(self)
end

---检测能否上阵助战卡
function EmbattleItemAssistGroupPVE:CheckIsPutAssist(index,uid)
    return require "FriendHelpModel":GetInstance():CheckCanUseHelp(self.curEmbattleType[1],nil,nil,uid)
end

function EmbattleItemAssistGroupPVE:CheckNpcAssistIsFull()
    return not require "FriendHelpModel":GetInstance():CheckCanUseHelp(self.curEmbattleType[1], nil, 2)
end

function EmbattleItemAssistGroupPVE:CheckAssistIsFull()
    return self.putAssistCount < self.maxPutCount
end

---设置单个位置的布阵数据
---@param index number 序列号
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return boolean 设置是否成功
function EmbattleItemAssistGroupPVE:SetEmbattleDataSingle(index, uid, etIndex)
    self:UpdateAssistUid(index, uid, etIndex)
    return base.SetEmbattleDataSingle(self, index, uid, etIndex)
end
---更新助战uids
function EmbattleItemAssistGroupPVE:UpdateAssistUid(index, uid, etIndex)
    local isChange = true
    if self.putAssistUids[etIndex] and self.putAssistUids[etIndex][index] then
        isChange = uid ~= self.putAssistUids[etIndex][index]
        self.putAssistUids[etIndex][index] = nil
        self.putAssistCount = self.putAssistCount - 1
    end
    if isChange and self:CheckCardAssist(uid) then
        if not self.putAssistUids[etIndex] then
            self.putAssistUids[etIndex] = {}
            self.putAssistCount = self.putAssistCount + 1
        end
        self.putAssistUids[etIndex][index] = uid
    end
end
---更换站位
function EmbattleItemAssistGroupPVE:ChangeCardPos(dragpos, changepos, index)
    if base.ChangeCardPos(self, dragpos, changepos, index) then
        local uid = self.curEmbattleData[index][dragpos].uid
        self:UpdateAssistUid(dragpos, uid, index)
        uid = self.curEmbattleData[index][changepos].uid
        self:UpdateAssistUid(changepos, uid, index)
        return true
    end

    return false
end

function EmbattleItemAssistGroupPVE:ClearEmbattle(index)
    base.ClearEmbattle(self, index)
    if self.putAssistUids[index] then
        self.putAssistCount = self.putAssistCount - _G.table.count(self.putAssistUids[index])
        self.putAssistUids[index] = {}
    end
end

function EmbattleItemAssistGroupPVE:CheckIsOpenNpcGuide()
    return require "FriendHelpModel":GetInstance():CheckCanShowNpcGuide()
end

function EmbattleItemAssistGroupPVE:CheckIsNpcAssist(uid)
    return self.npcAssistUidList[uid]
end

function EmbattleItemAssistGroupPVE:CheckNpcAssistIsFull()
    return not require "FriendHelpModel":GetInstance():CheckCanUseHelp(self.curEmbattleType[1], 2)
end

---获取卡牌对象
---@param uid number 卡牌uid
---@return table 卡牌数据对象
function EmbattleItemAssistGroupPVE:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    return base.GetCardData(self, uid)
end
--endregion

return EmbattleItemAssistGroupPVE
