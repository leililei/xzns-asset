---@class EmbattleItemCelebrationTrial:EmbattleItemPVE	中文描述
local EmbattleItemCelebrationTrial = _G.BaseClass("EmbattleItemCelebrationTrial", require "EmbattleItemPVE")
---类的构造函数

function EmbattleItemCelebrationTrial:GetCurEmbattleType()
    return self.curEmbattleType, _G.handler(self, self.CheckFight)
end

function EmbattleItemCelebrationTrial:CheckFight()
    local ThemeActivityManager = require("ThemeActivityManager"):GetInstance()
    if not ThemeActivityManager:CheckThemeActivityIsOpen() then
        _G.PopWindowManager:GetInstance():ShowAllTips(620105)
        return false
    else
        return true
    end
end
return EmbattleItemCelebrationTrial
