local base = require "EmbattleItemPVP"
---@class EmbattleItemArenaElementAttack	中文描述
local EmbattleItemArenaElementAttack = _G.BaseClass("EmbattleItemArenaElementAttack", base)

---@private
function EmbattleItemArenaElementAttack:__init(eType, saveType, notPassServer, mgpID, data)
    self.showEnemySoulAndTalents = true
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemArenaElementAttack:InitCardList()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    local elements = self:GetLockElement()
    local cardList = table.toArray(cards)
    self.curChooseCardList = {}
    for _, card in pairs(cardList) do
        if _G.table.ContainsValue(elements, card.cfg.Elements) then
            _G.table.insert(self.curChooseCardList, card)
        end
    end
    self:SortCardList()
end

---显示编队按钮
---@return boolean 是否显示编队按钮
function EmbattleItemArenaElementAttack:ShowFormationBtn()
    return false
end

function EmbattleItemArenaElementAttack:GetLockElement()
    local ArenaManager = require("ArenaManager")
    local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element)
    return arenaClass:GetLockElement()
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemArenaElementAttack:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local skills = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    EmbattleModelIns:SetSkillIndex(self.curEmbattleType, skills)
    EmbattleModelIns:SetEmbattleByUids(sits, self.curEmbattleType)
    local defenceUids = EmbattleModelIns:GetEmbattleDataWithoutMetatable(_G.EmbattleType.arenaElementDefence)
    if not defenceUids then
        EmbattleModelIns:SetSkillIndex(_G.EmbattleType.arenaElementDefence, skills)
        EmbattleModelIns:SetEmbattleByUids(sits, _G.EmbattleType.arenaElementDefence)
        EmbattleModelIns:SaveEmbattleDataTable(
            {self.curEmbattleType, _G.EmbattleType.arenaElementDefence},
            _G.handler(self, self.OnSaveEnd)
        )
    else
        EmbattleModelIns:SaveEmbattleDataNew(self.curEmbattleType, _G.handler(self, self.OnSaveEnd))
    end
    sits = nil
end

---保存布阵数据回调
---@param result number 保存结果(0成功)
function EmbattleItemArenaElementAttack:OnSaveEnd(result)
    if result == 0 then
        --TODO:检测敌方布阵数据
        local ArenaManager = require("ArenaManager")
        local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element)
        --TODO:检查敌人阵容
        arenaClass:GetEnemyEmbattleArray(
            arenaClass.curChallengeUid,
            function(data)
                local isEmptyOrNil = _G.table.isEmptyOrNil
                for i = 1, #self.curEnemyEmbattleData do
                    if not isEmptyOrNil(data[i]) then
                        if data[i].sid ~= self.curEnemyEmbattleData[i].sid then --和最新布阵数据不一致
                            result = 1
                            break
                        end
                    elseif self.curEnemyEmbattleData[i].sid > 0 then --和最新布阵数据不一致
                        result = 1
                        break
                    end
                end
                self.onSaveCall(result)
                if result ~= 0 then
                    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
                    view:QuitEmbattle()
                    _G.PopWindowManager:GetInstance():ShowAllTips(1513)
                end
            end,
            true
        )
    else
        if self.onSaveCall then
            self.onSaveCall(result)
            self.onSaveCall = nil
        end
    end
end

---检测是否可以出战
function EmbattleItemArenaElementAttack:CheckBattle()
    local arenaClass = require("ArenaManager"):GetInstance():GetArenaClass(require "ArenaManager".arenaType.element)
    if arenaClass:GetCurArenaState() ~= 1 then
        local closeFun = function()
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaElementChallengeView.Name)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ArenaElementMainPanelView.Name)
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(300301, nil,  closeFun, closeFun)
        return false, nil ,true
    end
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i].uid > 0 then
            return true
        end
    end
    return false
end

---获取是否展示跳过战斗
function EmbattleItemArenaElementAttack:GetShowSkip()
    self.AttackName = 2
    return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(126)
end
return EmbattleItemArenaElementAttack
