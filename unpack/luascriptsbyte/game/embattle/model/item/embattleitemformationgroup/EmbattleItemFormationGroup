local base = require "EmbattleItemGroup"
---@class EmbattleItemFormationGroup	中文描述
local EmbattleItemFormationGroup = _G.BaseClass("EmbattleItemFormationGroup", base)
--需求：编队界面如果该队全部为不可上阵的角色，则按钮会置灰
---类的构造函数
---@param uids table 不可选择的卡牌uid组
function EmbattleItemFormationGroup:__init(eType, saveType, notPassServer, mgpID, uids)
    self.containsCards = uids
end

---类的析构函数
function EmbattleItemFormationGroup:Dispose()
    self.containsCards = nil
end
---检测是否全是不可上阵的角色
---@param index number 布阵序列号
---@return boolean 是否为全不可上阵角色
function EmbattleItemFormationGroup:CheckContains(index)
    if not self.containsCards then
        return false
    end
    local cards = self.curEmbattleData[index]
    local count = 0
    for i = 1, #cards do
        if cards[i].uid > 0 then
            if not self.containsCards[cards[i].uid] then
                return false
            end
        else
            count = count + 1
        end
    end
    if count == #cards then
        return false
    end
    return true
end

---获取服务器阵容(多队时仅第一队使用)
function EmbattleItemFormationGroup:GetServerEmbattleData(id, index)
    self:InitGroupType()
    local uids = require("EmbattleController"):GetInstance():GetFormationUids(self.groupType, index)
    return _G.DeepCopy(uids)
end

function EmbattleItemFormationGroup:GetSkillIndex(id)
    self:InitGroupType()
    local index = id % 100
    local combine = require("EmbattleController"):GetInstance():GetFormationCombines(self.groupType, index)
    return _G.DeepCopy(combine)
end

function EmbattleItemFormationGroup:GetPetSkillIndex(id)
    self:InitGroupType()
    local index = id % 100
    local pets = require("EmbattleController"):GetInstance():GetFormationPets(self.groupType, index)
    return _G.DeepCopy(pets)
end
function EmbattleItemFormationGroup:GetBeastSkillIndex(id)
    self:InitGroupType()
    local index = id % 100
    local beasts = require("EmbattleController"):GetInstance():GetFormationBeasts(self.groupType, index)
    return _G.DeepCopy(beasts)
end


function EmbattleItemFormationGroup:InitGroupType()
    if not self.groupType then
        self.groupType = require("EmbattleController"):GetInstance().formationGroupType
        if self.groupType == _G.FormationGroupType.All then
            self.groupType = _G.FormationGroupType.Five
        end
    end
end

function EmbattleItemFormationGroup:ChangeGroupType(_type)
    self.groupType = _type
    self:InitEmbattleData()
end

function EmbattleItemFormationGroup:GetFormationGroupType()
    return self.groupType
end

function EmbattleItemFormationGroup:GetPetSkillState()
    if self.groupType == _G.FormationGroupType.Three then
        return {false, false, false}
    end
    return self.super:GetPetSkillState()
end

return EmbattleItemFormationGroup
