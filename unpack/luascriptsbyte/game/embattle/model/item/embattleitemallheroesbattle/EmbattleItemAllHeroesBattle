local base = require "EmbattleItemPVP"
---@class EmbattleItemAllHeroesBattle	中文描述
local EmbattleItemAllHeroesBattle = _G.BaseClass("EmbattleItemAllHeroesBattle", base)
local JumpId=105727
---类的构造函数
function EmbattleItemAllHeroesBattle:__init(eType, saveType, notPassServer, mgpID, data, uid, posid)
    self.enemyUid = uid
    self.curChallengePosID = posid
    self.showEnemySoulAndTalents = true
    self.jumpParams = _G.ConfigManager.discrete_cfg[JumpId]
end

---类的析构函数
function EmbattleItemAllHeroesBattle:Dispose()
    self.enemyUid = nil
    self.curChallengePosID = nil
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemAllHeroesBattle:SaveEmbattle(saveCall)
    base.SaveEmbattle(
        self,
        function(result, ...)
            if result == 0 then
                local params = _G.SafePack(...)
                local AllHeroesBattleNetIns = require("AllHeroesBattleNet"):GetInstance()
                AllHeroesBattleNetIns:GetEnemyEmbattleData(
                    self.enemyUid,
                    function(data)
                        local quitEmbattle = true
                        if data.ack == 1 then
                            data = data.team
                            for i = 1, #data do
                                if data[i].sid ~= self.curEnemyEmbattleData[i].sid then
                                    break
                                end
                                if i == #data then
                                    quitEmbattle = false
                                end
                            end
                        end
                        if quitEmbattle then --阵容发生变更
                            saveCall(false)
                            _G.PopWindowManager:GetInstance():ShowAllTips(620108)
                            local view =
                                _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
                            view:QuitEmbattle()
                        else
                            -- local port =
                            --     AllHeroesBattleNetIns:Challenge(
                            --     self.curChallengePosID,
                            --     self.enemyUid,
                            --     function(msg)
                            --         if msg.ack == 1 then
                            --          end
                            --     end
                            -- )
                            -- _G.BattleManager:GetInstance():AddLuaNetEvent(port)
                            saveCall(result, _G.SafeUnpack(params))
                        end
                    end
                )
            else
                saveCall(result, ...)
            end
        end
    )
end

function EmbattleItemAllHeroesBattle:GetShowSkip()
    self.AttackName = 4
    return _G.GlobalConditionManager.CheckConditionArrays( self.jumpParams)
end

return EmbattleItemAllHeroesBattle
