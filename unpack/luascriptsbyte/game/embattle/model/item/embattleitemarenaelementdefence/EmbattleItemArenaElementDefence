local base = require "EmbattleItemPVP"
---@class EmbattleItemArenaElementDefence	中文描述
local EmbattleItemArenaElementDefence = _G.BaseClass("EmbattleItemArenaElementDefence", base)

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemArenaElementDefence:InitCardList()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)
    local elements = self:GetLockElement()
    local cardList = table.toArray(cards)
    self.curChooseCardList = {}
    for _, card in pairs(cardList) do
        if _G.table.ContainsValue(elements, card.cfg.Elements) then
            _G.table.insert(self.curChooseCardList, card)
        end
    end
    self:SortCardList()
end

---显示编队按钮
---@return boolean 是否显示编队按钮
function EmbattleItemArenaElementDefence:ShowFormationBtn()
    return false
end

function EmbattleItemArenaElementDefence:GetCacheModelInBattle()
    return false
end

---获取挑战按钮文字图片名字
---@return string 按钮文字图片名字
function EmbattleItemArenaElementDefence:GetBattleImageName()
    return "ui_bz_btn_txt_queding"
end

function EmbattleItemArenaElementDefence:GetLockElement()
    local ArenaManager = require("ArenaManager")
    local arenaClass = ArenaManager:GetInstance():GetArenaClass(ArenaManager.arenaType.element)
    return arenaClass:GetLockElement()
end

return EmbattleItemArenaElementDefence
