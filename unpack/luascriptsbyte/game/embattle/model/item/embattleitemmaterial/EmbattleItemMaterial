local EmbattleItemPVE = require "EmbattleItemPVE"

---@class EmbattleItemMaterial:EmbattleItemPVE    中文描述
local EmbattleItemMaterial = _G.BaseClass("EmbattleItemMaterial", EmbattleItemPVE)

---类的构造函数
function EmbattleItemPVE:__init(etype, saveType, notPassServer, monsterGroupID, challengeSid, isStarSoul)
    self.curChallengeSid = challengeSid
    self.isStarSoul = isStarSoul
end

---检测是否开放推荐阵容
---@return boolean
function EmbattleItemMaterial:CheckIsOpenRecommend()
    return true
end

---获取推荐阵容
---@param call function
---@param monster_group_id number
function EmbattleItemMaterial:GetRecommend(call, monster_group_id)
    if self.isStarSoul then
        require "StarSoulModel":GetInstance():GetRecommend(
            function(msg)
                self:GetRecommendCall(msg, call)
            end,
            self.curChallengeSid
        )
    else
        require "SystemMaterialNet":GetInstance():GetRecommend(
            {sid = self.curChallengeSid},
            function(msg)
                self:GetRecommendCall(msg, call)
            end
        )
    end
end

function EmbattleItemMaterial:GetRecommendData()
    if not self.RecommendDatas then
        return nil
    end
    if not self.RecommendData then
        if self.isStarSoul then
            self.RecommendData =
                require "EmbattleItemRecommendStarSoul".New(
                {self.curEmbattleType},
                self.saveType,
                self.notPassServer,
                self.monsterGroupID,
                self
            )
        else
            self.RecommendData =
                require "EmbattleItemRecommendSystemMaterial".New(
                {self.curEmbattleType},
                self.saveType,
                self.notPassServer,
                self.monsterGroupID,
                self
            )
        end
    end
    return self.RecommendData
end

function EmbattleItemMaterial:ParseRecommendData(group, index, monster_group_id, call)
    self.RecommendData:ParseData(self.RecommendDatas[group], index, monster_group_id, call)
end

---获取战斗控制
function EmbattleItemMaterial:GetBattleControllType()
    return _G.BattleControllerType.SystemMetarial
end

function EmbattleItemMaterial:GetServerEmbattleData(id, index)
    if self:GetStarSoulEmbattleId() > 0 then
        id = self.starSoulEmbattleId
    end
    return EmbattleItemPVE.GetServerEmbattleData(self, id, index)
end

function EmbattleItemMaterial:GetStarSoulEmbattleId()
    if not self.starSoulEmbattleId then
        if require "SystemMaterialController":GetInstance().curChooseMaterialID == 105 then
            local pro = require "StarSoulModel":GetInstance():GetPro()
            self.starSoulEmbattleId = self.curEmbattleType * 1000 + pro
        else
            self.starSoulEmbattleId = 0
        end
    end

    return self.starSoulEmbattleId
end

function EmbattleItemMaterial:OnSaveEnd(result)
    if result == 0 and self.isStarSoul then
        local sits = {0, 0, 0, 0, 0}
        for i = 1, #self.curEmbattleData do
            sits[i] = self.curEmbattleData[i].uid
        end
        require "EmbattleModel":GetInstance():SaveEmbattleDataNew(
            self:GetStarSoulEmbattleId(),
            nil,
            _G.EmbattleSaveType.localfile,
            true,
            sits
        )
    end
    EmbattleItemPVE.OnSaveEnd(self, result)
end

---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemMaterial:SaveEmbattle(saveCall)
    if self.isStarSoul then
        local skills = {0, 0, 0}
        for i = 1, #self.curCombSkillData do
            skills[i] = self.curCombSkillData[i].id
        end
        require("EmbattleModel"):GetInstance():SetSkillIndex(self:GetStarSoulEmbattleId(), skills)
    end
    EmbattleItemPVE.SaveEmbattle(self, saveCall)
end


return EmbattleItemMaterial
