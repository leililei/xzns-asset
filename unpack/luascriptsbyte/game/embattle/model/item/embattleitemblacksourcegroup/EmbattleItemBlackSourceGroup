local base = require "EmbattleItemGroup"
---@class EmbattleItemBlackSourceGroup:EmbattleItemGroup
local EmbattleItemBlackSourceGroup = _G.BaseClass("EmbattleItemBlackSourceGroup", base)

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemBlackSourceGroup:InitEmbattleData(sits, index)
    if not self.perLevel then
        self.perLevel = self:GetLevel()
    end
    if sits then
        self.curUids[index] = {}
        self:ClearEmbattle(index)
        local card, sit
        for i = 1, #sits do
            sit = sits[i]
            if not sit.tag or sit.tag == 0 then
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = self.perLevel
                card.soulLink_lv = sit.soulLink_lv
                card.power = sit.power or 0
                if sit.uid > 0 then
                    self:SetCurUids(sit.uid, true, index)
                    self:SetCurSids(sit.sid, true, index)
                end
            end
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    self.curEmbattleData = {false, false, false}
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    self.curUids = {false, false, false}
    self.curSids = {false, false, false}
    for i = 1, #self.curEmbattleType do
        self.curEmbattleData[i] = self:GetServerEmbattleData(self.curEmbattleType[i],i)
        local uids = {}
        local sids = {}
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j] > 0 then
                local card =
                    _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.curEmbattleData[i][j])
                self.curEmbattleData[i][j] = {
                    uid = card.uid,
                    sid = card.sid,
                    star = card:GetStar(),
                    level = self.perLevel,
                    soulLink_lv = card.soulLink_lv,
                    power = card:GetPower(),
                    tag = 0
                }
                uids[card.uid] = true
                sids[card.sid] = true
            else
                self.curEmbattleData[i][j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        end
        self.curUids[i] = uids
        self.curSids[i] = sids
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
end

---获取等级
function EmbattleItemBlackSourceGroup:GetLevel()
    local cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
    local levelper = 0
    local count = 0
    for _, v in pairs(cards) do
        levelper = levelper + v:GetRealLevel()
        count = count + 1
    end
    levelper = levelper / count
    local param = _G.ConfigManager.discrete_cfg[108004][1]
    return _G.math.floor(param[1] + levelper * param[2] / 10000)
end
return EmbattleItemBlackSourceGroup
