---获取卡牌对象
---@param uid number 卡牌uid
---@return table 卡牌数据对象
function EmbattleItemArenaGlobalAttack:GetCardData(uid)
    if not self.curChooseCardList then
        self:InitCardList()
    end
    for i = 1, #self.curChooseCardList do
        if self.curChooseCardList[i].uid == uid then
            return self.curChooseCardList[i]
        end
    end
    return _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
end
---检测空位是否还有可上阵的英雄
---@param index number 选择的队伍序列(默认nil 检查全部)
---@return boolean 是否有空位并且有可上阵的英雄
function EmbattleItemArenaGlobalAttack:CheckEmptyPos(index)
    local hero, guardian
    local empty = {}
    local max = self:GetMaxPutNum()
    for j = 1, #self.curEmbattleType do
        if not index or index == j then
            local index = 0
            for i = 1, #self.curEmbattleData[j] do
                if self.curEmbattleData[j][i].uid == 0 then
                    if not empty[j] then
                        empty[j] = i
                    end
                else
                    index = index + 1
                    if index >= max then
                        empty[j] = nil
                        break
                    end
                end
            end
        end
    end
    local list = self:GetCardList()
    for inx, pos in pairs(empty) do
        for k = 1, #list do
            if not self:CheckUidInEmbattle(list[k].uid) and not self:CheckSidInEmbattle(list[k].sid) then --未上阵且SID不重复
                return pos, inx
            end
        end
    end
    return 0
end

