---获取敌方合击技数据
---@param verbose? boolean   使用复杂的结构
---@return number[]|{cs:number,id:number,lv:number}[]
function EmbattleItemArenaGlobalAttack:GetAllEnemyCombineSkillData(verbose)
    if not self.enemy then
        return {}
    end
    local results = {}
    for i, _ in pairs(self.curEmbattleType) do
        results[i] = self.enemy[i] and self.enemy[i].skill_index
        if results[i] then
            results[i] = _G.DeepCopy(results[i])
        else
            results[i] = {0, 0, 0}
        end
        if verbose then
            for j, _ in pairs(results[i]) do
                local id = results[i][j]
                if id > 0 then
                    local combineCfg = _G.ConfigManager.combine_cfg[id]
                    if combineCfg then
                        local cskillID = combineCfg.skills[1] or 0
                        results[i][j] = {
                            cskillID = cskillID,
                            id = id,
                            lv = 0,
                            tag = 0
                        }
                    else
                        local cskillID = id
                        results[i][j] = {
                            cskillID = cskillID,
                            id = 0,
                            lv = 0,
                            tag = 0
                        }
                    end
                else
                    results[i][j] = {
                        cskillID = 0,
                        id = 0,
                        lv = 0,
                        tag = 0
                    }
                end
            end
        end
    end
    return results
end

