local base = require "EmbattleItemGroup"
---@class EmbattleItemArenaGlobalAttack	:EmbattleItemGroup
local EmbattleItemArenaGlobalAttack = _G.BaseClass("EmbattleItemArenaGlobalAttack", base)
local perLevel = 300
---@param enemy
function EmbattleItemArenaGlobalAttack:__init(eType, saveType, notPassServer, mgpID, enemy, enemyName, enemyInfo, index)
    self.enemy = enemy
    self.enemyName = enemyName
    self.enemyInfo = enemyInfo
    self.embattleIndex = index
    self.curEnemyCombineData = {}
    self.AttackName = "ArenaGlobal"
    self:InitEnemyEmbattleData()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
end

function EmbattleItemArenaGlobalAttack:OnEmbattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    self.embattleView:SetVsDescription(_G.PlayerModel:GetInstance():GetName(), self.enemyName, self.enemyInfo)
end
---初始化地方阵容
function EmbattleItemArenaGlobalAttack:InitEnemyEmbattleData()
    if not self.enemy then
        self.enemy = {}
    end
    self.curEnemyEmbattleData = {}
    self.curEnemyCombineData = {false, false, false}
    self.curEnemyPetData = {false, false, false}
    local card
    local cfg
    local cfgs = _G.ConfigManager.card_cfg
    for i = 1, #self.curEmbattleType do
        self.curEnemyEmbattleData[i] = false
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            if self.enemy[i] and self.enemy[i].card[j] then
                card = self.enemy[i].card[j]
                if card.sid > 0 then
                    cfg = cfgs[card.sid]
                else
                    cfg = nil
                end
                local isweak, wsid = require "CardCommentManager":GetInstance():CardWearSkin(card.sid)
                data[j] = {
                    uid = card.sid,
                    sid = card.sid,
                    level = card.lv,
                    star = card.star,
                    soulLink_lv = card.soul_lv,
                    power = 0,
                    scale = cfg and cfg.GlobalScale * 0.0001 or 1,
                    soulLink_IsActivate = card.soul_state,
                    open_inborn = card.born_skill_num,
                    artifact = card.artifact or {},
                    skin = wsid
                }
            else
                data[j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    artifact = {},
                    tag = 0
                }
            end
        end
        self.curEnemyEmbattleData[i] = data
        self.curEnemyCombineData[i] = {0, 0, 0}
        self.curEnemyPetData[i] = {0, 0, 0}
    end
end

---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemArenaGlobalAttack:GetEnemyEmbattlePower(index)
    return self.enemy[index] and self.enemy[index].power or 0
end

---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemArenaGlobalAttack:InitEmbattleData(sits, index)
    if sits then
        self.curUids[index] = {}
        self.curSids[index] = {}
        self:ClearEmbattle(index)
        local card, sit
        local haveRole = false
        for i = 1, #sits do
            sit = sits[i]
            if not self:CheckUidInEmbattle(sit.uid) and not self:CheckSidInEmbattle(sit.sid) then --不在其他阵容并且没有相同SID上阵
                card = self.curEmbattleData[index][i]
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    self.curUids[index][sit.uid] = true
                    self.curSids[index][sit.sid] = true
                end
            else
                haveRole = true
            end
        end
        if haveRole then
            _G.PopWindowManager:GetInstance():ShowAllTips(220101)
        end
        self.curChangeEmbattleIndexes[index] = true
        return
    end
    self.curEmbattleData = {false}
    self.curUids = {}
    self.curSids = {}
    for i = 1, #self.curEmbattleType do
        self.curUids[i] = {}
        self.curSids[i] = {}
        self.curEmbattleData[i] = self:GetServerEmbattleData(self.curEmbattleType[i], i)
        for j = 1, #self.curEmbattleData[i] do
            if self.curEmbattleData[i][j] > 0 then
                local card = self:GetCardData(self.curEmbattleData[i][j])
                if card then
                    self.curEmbattleData[i][j] = {
                        uid = card.uid,
                        sid = card.sid,
                        star = card:GetStar(),
                        level = card:GetLevel(),
                        soulLink_lv = card.soulLink_lv,
                        power = card:GetPower(),
                        tag = 0
                    }
                    self.curUids[i][card.uid] = true
                    self.curSids[i][card.sid] = true
                else
                    self.curEmbattleData[i][j] = {
                        uid = 0,
                        sid = 0,
                        star = 0,
                        level = 1,
                        soulLink_lv = 0,
                        power = 0,
                        tag = 0
                    }
                end
            else
                self.curEmbattleData[i][j] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    power = 0,
                    tag = 0
                }
            end
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
    if _G.AppSetting.IsXzns then
        self:SetBeastSkillData()
    end
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
---@param swapData table 交换合击技数据
function EmbattleItemArenaGlobalAttack:SetCombSkillData(data, index, swapData)
    if data then
        local dic
        for i = 1, #data do
            dic = self.curCombSkillData[index][i]
            if data[i].tag == 0 then
                if not self:CheckOtherGroupSameSkill(data[i].id) then
                    dic.id = data[i].id
                    dic.lv = data[i].lv
                    dic.cskillID = data[i].cskillID
                end
            end
        end
        if swapData then
            local spdata
            for i = 1, #self.curCombSkillData do
                if i ~= index then
                    for j = 1, #self.curCombSkillData[i] do
                        spdata = swapData[self.curCombSkillData[i][j].id]
                        if spdata then
                            self.curCombSkillData[i][j] = spdata
                        end
                    end
                end
            end
        end
        return
    end
    base.SetCombSkillData(self)
end

---初始化卡牌
function EmbattleItemArenaGlobalAttack:InitCardList()
    ---@type CardData[]
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    ---@type CardData[]
    self.curChooseCardList = {}
    for _, v in pairs(cards) do
        local msg = {}
        setmetatable(msg, {__index = v})
        rawset(msg, "lv", perLevel)
        rawset(
            msg,
            "GetPower",
            function()
                return v:GetPowerByLevel(perLevel)
            end
        )
        rawset(
            msg,
            "GetLevel",
            function()
                return perLevel
            end
        )
        _G.table.insert(self.curChooseCardList, msg)
    end
    self:SortCardList()
end
---保存阵容
function EmbattleItemArenaGlobalAttack:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local garray = {}
    local sits, skills, pets, uid
    for i = 1, #self.curEmbattleData do
        garray[i] = {
            id = dan * 100 + i
        }
        sits = {}
        skills = {}
        pets = {0, 0, 0}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            sits[j] = uid < 0 and 0 or uid
        end
        for j = 1, #self.curCombSkillData[i] do
            skills[j] = self.curCombSkillData[i][j].id or 0
        end
        if self.curPetSkillData and self.curPetSkillData[i] then
            for j = 1, #self.curPetSkillData[i] do
                pets[j] = self.curPetSkillData[i][j]
            end
        end
        if _G.AppSetting.IsXzns then
            local beasts = {}
            if self.curBeastSkillData and self.curBeastSkillData[i] then
                for j = 1, #self.curBeastSkillData[i] do
                    beasts[j] = self.curBeastSkillData[i][j]
                end
            end
            garray[i].beast = beasts
            local EmbattleModelIns = require("EmbattleModel"):GetInstance()
            EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType[i], beasts)
        end
        garray[i].sits = sits
        garray[i].skill_index = skills
        garray[i].pet = pets
    end
    require "ArenaGlobalModel":GetInstance():SaveAttackGarray(dan, garray, _G.handler(self, self.OnSaveEnd))
end

