---获取服务器阵容(多队时仅第一队使用)
function EmbattleItemArenaGlobalAttack:GetServerEmbattleData(index)
    -- local dan = self:GetEmbattleTypeCount()
    local dan = require("ArenaGlobalModel"):GetInstance():GetCurDanCfg().id
    local array
    if require("ArenaGlobalModel"):GetInstance():CheckAttackEmpty(dan) then --进攻为空
        if require("ArenaGlobalModel"):GetInstance():CheckDefendEmpty(dan) then --防守也为空
            array = self:GetAfkEmbattleData(index)
            local empty = true
            for i = 1, #array do
                if array[i] > 0 then
                    empty = false
                    break
                end
            end
            if empty then
                array = self:GetFreeUids()
            end
        else --读取防守阵容
            array = require("ArenaGlobalModel"):GetInstance():GetDefendGarray(dan, index)
            if _G.table.isEmptyOrNil(array) or _G.table.isEmptyOrNil(array.sits) then
                array = {0, 0, 0, 0, 0}
            else
                array = _G.DeepCopy(array.sits)
            end
        end
    else
        array = require("ArenaGlobalModel"):GetInstance():GetAttackGarray(dan, index)
        if _G.table.isEmptyOrNil(array) or _G.table.isEmptyOrNil(array.sits) then
            array = {0, 0, 0, 0, 0}
        else
            array = _G.DeepCopy(array.sits)
        end
    end
    return array
end

---获取未上阵5张卡
function EmbattleItemArenaGlobalAttack:GetFreeUids()
    local array = {0, 0, 0, 0, 0}
    local index = 1
    local cards = self:GetCardList()
    for _, v in pairs(cards) do
        if not self:CheckSidInEmbattle(v.sid) then
            array[index] = v.uid
            index = index + 1
        end
        if index > 5 then
            return array
        end
    end
    return array
end

