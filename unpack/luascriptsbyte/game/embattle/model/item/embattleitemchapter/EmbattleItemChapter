local EmbattleItemPVE = require "EmbattleItemPVE"

---@class EmbattleItemChapter : EmbattleItemPVE	中文描述
local EmbattleItemChapter = _G.BaseClass("EmbattleItemChapter", EmbattleItemPVE)

local storyEmbattleType = {
    lock = 1,
    free = 0
}

---类的构造函数
function EmbattleItemChapter:__init(etype, saveType, notPassServer, monsterGroupID, objectWorldSid)
    self.objectWorldSid = objectWorldSid or 0
    self:InitForceBattle()
end

---类的析构函数
function EmbattleItemChapter:Dispose()
    self.objectWorldSid = nil
    self.isForceBattle = nil
end

function EmbattleItemChapter:InitForceBattle()
    self.isForceBattle = false
    if self.objectWorldSid ~= 0 then
        local objectCfg = _G.ConfigManager.object_world_cfg[self.objectWorldSid]
        if objectCfg.Type1 == _G.WorldItemType.Enemy and #objectCfg.Params > 1 then
            self.isForceBattle = objectCfg.Params[2] == 1
        end
    end
end
---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemChapter:InitEmbattleData(sits)
    EmbattleItemPVE.InitEmbattleData(self, sits)
    local ChapterRoomManagerIns = _G.ChapterRoomManager:GetInstance()
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.tag == 0 and card.uid > 0 and ChapterRoomManagerIns:GetCardBaseData(card.uid) <= 0 then
            self:SetCurUids(card.uid, false)
            card.uid = 0
            card.sid = 0
            card.star = 0
            card.level = 0
            card.soulLink_lv = 0
        end
    end
end

