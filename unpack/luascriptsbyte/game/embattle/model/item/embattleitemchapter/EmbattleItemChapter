end

---是否显示卡牌列表血量
---@return boolean 是否显示卡牌列表中血量
function EmbattleItemChapter:ShowCardHP()
    return true
end
---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param curIndex number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemChapter:CheckCardLock(uid, curIndex)
    local hp = _G.ChapterRoomManager:GetInstance():GetCardBaseData(uid)
    if hp <= 0 then
        return _G.EmbattleState.Dead, 140104
    end
    local lock, tips = EmbattleItemPVE.CheckCardLock(self, uid)
    if lock ~= _G.EmbattleState.None then
        return lock, tips
    end
    return _G.EmbattleState.None
end
---检测空位是否还有可上阵的英雄
---@return number 空位序列
function EmbattleItemChapter:CheckEmptyPos()
    local empty = false
    local sids = {}
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.uid == 0 and card.tag == 0 then
            if not empty then
                empty = i
            end
        elseif card.sid > 0 then
            sids[card.sid] = true
        end
    end
    if empty then
        local cfg
        local list = self:GetCardList()
        local ChapterRoomManagerIns = _G.ChapterRoomManager:GetInstance()
        for i = 1, #list do
            if
                not self.curUids[list[i].uid] and not sids[list[i].sid] and
                    ChapterRoomManagerIns:GetCardBaseData(list[i].uid) > 0
             then --未上阵
                return empty
            end
        end
    end
    return 0
end
