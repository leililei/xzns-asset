---获取合击技列表
---@return table 合击技能列表
function EmbattleItemChapter:OtherGroupSkillListNew()
    if self.combineSkillList then
        return self.combineSkillList
    end
    self.combineSkillList = {}
    local skills = _G.DeepCopy(require("CombineModel"):GetInstance():GetUnLockCombine()) or {}
    ---@type monster_group_cfg
    local groupCfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
    ---@type combine_cfg
    local cfg
    if not _G.table.isEmptyOrNil(groupCfg.att_combine) then
        for _, v in pairs(groupCfg.att_combine) do
            if v > 1 then
                local id = _G.Mathf.RoundToInt(v / 10000)
                cfg = _G.ConfigManager.card_skills_cfg[v]
                if id and cfg then
                    skills[id] = cfg.level
                end
            end
        end
    end
    local index = 1
    for sid, lv in pairs(skills) do
        self.combineSkillList[index] = {sid, lv}
        index = index + 1
    end
    for _, v in pairs(_G.ConfigManager.combine_cfg) do
        if not skills[v.id] then
            self.combineSkillList[index] = {v.id, 0}
            index = index + 1
        end
    end
    ---ZHJ-15025 显示所有的合击技
    _G.SortList(
        self.combineSkillList,
        function(a)
            return a[2], a[1]
        end
    )

    _G.table.sort(
        self.combineSkillList,
        function(a, b)
            if a[2] == b[2] then
                return a[1] > b[1]
            else
                return a[2] > b[2]
            end
        end
    )
    return self.combineSkillList
end

