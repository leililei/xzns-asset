local EmbattleItemBase = require "EmbattleItemBase"

---@class EmbattleItemPVE:EmbattleItemBase	中文描述
---@field storyBattleTag boolean 剧情战斗标识(true剧情战斗 false非剧情战斗)
---@field storyCardList table 剧情战斗卡牌列表
local EmbattleItemPVE = _G.BaseClass("EmbattleItemPVE", EmbattleItemBase)

---类的构造函数
function EmbattleItemPVE:__init(etype, saveType, notPassServer)
end

---类的析构函数
function EmbattleItemPVE:Dispose()
    self.storyBattleTag = nil
    self.curSids = nil
    self.storyCardList = nil
end

--region 重写方法

---初始化敌方布阵数据
function EmbattleItemPVE:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {0, 0, 0, 0, 0}
    if self.monsterGroupID == 0 then
        for i = 1, 5 do
            self.curEnemyEmbattleData[i] = {uid = 0, sid = 0, level = 0, star = 0, boss = false}
        end
        return
    end
    local cfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
    local mcfg = nil
    local HeroType = _G.HeroType
    local monster_cfg = _G.ConfigManager.monster_cfg
    --默认只取第一组
    for i = 1, 5 do
        if cfg.DefaultDefenserSids[1][i] and cfg.DefaultDefenserSids[1][i] > 0 then
            mcfg = monster_cfg[cfg.DefaultDefenserSids[1][i]]
            self.curEnemyEmbattleData[i] = {
                uid = mcfg.id,
                sid = mcfg.CardID,
                level = mcfg.Level,
                star = mcfg.Stars,
                scale = mcfg.GlobalScale * 0.0001,
                boss = mcfg.MonsterType == HeroType.Boss or mcfg.MonsterType == HeroType.Elite
            }
        else
            self.curEnemyEmbattleData[i] = {uid = 0, sid = 0, level = 0, star = 0, boss = false}
        end
    end
end

---初始化布阵数据
---@param sits table 布阵数据
function EmbattleItemPVE:InitEmbattleData(sits)
    self.curEmbattleData = self.curEmbattleData or {false, false, false, false, false}
    self.curUids = {}
    self.curSids = {}
    if sits then
        local data, sit
        for i = 1, #self.curEmbattleData do
            data = self.curEmbattleData[i]
            if data.tag == 1 then
                self.curSids[data.sid] = true
                self.curUids[data.uid] = true
            end
        end
        for i = 1, #sits do
            data = self.curEmbattleData[i]
            sit = sits[i]
            if data.tag == 0 then
                data.uid = sit.uid
                data.sid = sit.sid
                data.star = sit.star
                data.level = sit.level
                data.soulLink_lv = sit.soulLink_lv
                if sit.uid > 0 then
                    if self.curSids[sit.sid] then --存在相同的SID
                        data.uid = 0
                        data.sid = 0
                        data.star = 0
                        data.level = 0
                        data.soulLink_lv = 0
                    else
                        self.curSids[data.sid] = true
                        self.curUids[sit.uid] = true
                    end
                end
            end
        end
        return
    end
    local cfgs = _G.ConfigManager.monster_cfg
    local groupCfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
    local storyEmbattle = groupCfg.DefaultAttackerSids
    for i = 1, #self.curEmbattleData do
        if storyEmbattle[i] then
            if storyEmbattle[i] == 1 then
                self.curEmbattleData[i] = {
                    uid = -1,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_lv = 0,
                    tag = -1
                }
            elseif storyEmbattle[i] > 1 then
                self.storyBattleTag = true
                if self.storyCardList == nil then
                    self.storyCardList = {}
                end
                local cfg = cfgs[storyEmbattle[i]]
                self.curEmbattleData[i] = {
                    uid = cfg.id,
                    sid = cfg.CardID,
                    star = cfg.Stars,
                    level = cfg.Level,
                    soulLink_lv = 0,
                    tag = 1
                }
                self.storyCardList[#self.storyCardList + 1] = EmbattleItemPVEStoryRoleCardData.New(cfg)
                self.curSids[cfg.CardID] = true
                self.curUids[cfg.id] = true
            end
        end
    end
    local data = self:GetServerEmbattleData(self.curEmbattleType)
    for j = 1, #self.curEmbattleData do
        if not self.curEmbattleData[j] then --使用布阵数据
            local ed = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 0
            }
            self.curEmbattleData[j] = ed
            if data[j] > 0 then
                local card = self:GetCardData(data[j])
                if card and not self.curSids[card.sid] then
                    ed.uid = card.uid
                    ed.sid = card.sid
                    ed.star = card:GetStar()
                    ed.level = card:GetLevel()
                    ed.soulLink_lv = card.soulLink_lv
                    self.curUids[card.uid] = true
                    self.curSids[card.sid] = true
                end
            end
        end
    end
    self:SetCombSkillData()
    self:SetPetSkillData()
    if _G.AppSetting.IsXzns then
        self:SetBeastSkillData()
    end
end

---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
function EmbattleItemPVE:SetCombSkillData(data, index)
    if data then
        local cur, last
        for i = 1, #data do
            last = self.curCombSkillData[i]
            if last.tag == 0 then
                cur = data[i]
                last.id = cur.id
                last.lv = cur.lv
                last.cskillID = cur.cskillID
            end
        end
    else
        self.curCombSkillData = self:GetSkillIndex(self.curEmbattleType)
        local CombineModelIns = require("CombineModel"):GetInstance()
        local cfgs = _G.ConfigManager.combine_cfg
        local groupCfg = _G.ConfigManager.monster_group_cfg[self.monsterGroupID]
        local skill
        for i = 1, #self.curCombSkillData do
            skill = {
                id = 0,
                lv = 0,
                cskillID = 0,
                tag = 0
            }
            if groupCfg.att_combine[i] and groupCfg.att_combine[i] ~= 0 then
                if groupCfg.att_combine[i] > 1 then --剧情配置合击技能
                    skill.tag = 1
                    skill.cskillID = groupCfg.att_combine[i]
                    skill.id = skill.cskillID
                    skill.lv = 0
                else --锁住
                    skill.tag = -1
                end
                self.storyBattleTag = true
            else
                if self.curCombSkillData[i] > 0 then
                    skill.id = self.curCombSkillData[i]
                    skill.lv = CombineModelIns:GetCombineLevel(self.curCombSkillData[i])
                    skill.cskillID = cfgs[skill.id].skills[skill.lv]
                end
            end
            self.curCombSkillData[i] = skill
        end
    end
end
---获取己方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemPVE:GetMyEmbattlePower(index, isView)
    local power
    if self.storyBattleTag then
        local monsterCfg = _G.ConfigManager.monster_cfg
        local cfg, card
        power = 0
        for i = 1, #self.curEmbattleData do
            card = self.curEmbattleData[i]
            if card.tag == 1 then
                cfg = monsterCfg[card.uid]
                power = power + cfg.Power
            elseif card.tag == 0 and card.uid > 0 then
                cfg = self:GetCardData(card.uid)
                power = power + cfg:GetPower(isView)
            end
        end
    else
        power = EmbattleItemBase.GetMyEmbattlePower(self, index, isView)
    end
    return power
end
---获取卡牌列表
---@return table 卡牌列表
function EmbattleItemPVE:GetCardList(special)
    if self.curChooseCardList == nil then
        self:InitCardList()
    end
    return self.curChooseCardList
end
---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemPVE:InitCardList()
    EmbattleItemBase.InitCardList(self)
    if self.storyCardList then
        _G.table.sort(self.storyCardList, _G.handler(self, self.SortCardListFunc))
        local insert = _G.table.insert
        for i = #self.storyCardList, 1, -1 do
            insert(self.curChooseCardList, 1, self.storyCardList[i])
        end
    end
end
---获取敌方战斗力
---@return number 战斗力
function EmbattleItemPVE:GetEnemyEmbattlePower()
    if not self.curEnemyEmbattleData then
        return 0
    end
    local cfg, card
    local power = 0
    for i = 1, #self.curEnemyEmbattleData do
        card = self.curEnemyEmbattleData[i]
        if card.uid > 0 then
            cfg = _G.ConfigManager.monster_cfg[card.uid]
            if cfg then
                power = power + cfg.Power
            end
        end
    end
    return power
end
---检测空位是否还有可上阵的英雄
---@return number 空位序列
function EmbattleItemPVE:CheckEmptyPos()
    local empty = false
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.uid == 0 and card.tag == 0 then
            if not empty then
                empty = i
            end
        end
    end
    if empty then
        local cfg
        local list = self:GetCardList()
        for i = 1, #list do
            if not self.curUids[list[i].uid] and not self.curSids[list[i].sid] then --未上阵
                return empty
            end
        end
    end
    return 0
end
---保存布阵数据
---@param saveCall function 保存回调
---@return any 默认没有返回
function EmbattleItemPVE:SaveEmbattle(saveCall)
    if self.storyBattleTag then
        self.onSaveCall = saveCall
        local sits = {0, 0, 0, 0, 0}
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i].tag == 0 then
                sits[i] = self.curEmbattleData[i].uid
            end
        end
        local skills = {0, 0, 0}
        for i = 1, #self.curCombSkillData do
            if self.curCombSkillData[i].tag == 0 then
                skills[i] = self.curCombSkillData[i].id
            end
        end
        local EmbattleModelIns = require("EmbattleModel"):GetInstance()
        EmbattleModelIns:SetSkillIndex(0, skills)
        EmbattleModelIns:SaveEmbattleDataNew(
            0,
            _G.handler(self, self.OnSaveEnd),
            self.saveType,
            self.notPassServer,
            sits
        )
        sits = nil
    else
        EmbattleItemBase.SaveEmbattle(self, saveCall)
    end
end

function EmbattleItemPVE:OnSaveEnd(result)
    if result == 0 then
        if self.onSaveCall then
            self.onSaveCall(0, self.monsterGroupID)
            self.onSaveCall = nil
        end
    else
        if self.onSaveCall then
            self.onSaveCall(result, self.monsterGroupID)
            self.onSaveCall = nil
        end
    end
end
---交换卡牌位置
---@param dragpos number 拖动的卡牌位置
---@param changepos number 交换的卡牌位置
---@param index number 多布阵序列号
---@return boolean 是否交换成功
function EmbattleItemPVE:ChangeCardPos(dragpos, changepos, index)
    if self.curEmbattleData[dragpos].tag ~= 0 or self.curEmbattleData[changepos].tag ~= 0 then
        return false
    end
    return EmbattleItemBase.ChangeCardPos(self, dragpos, changepos)
end

---处理上下阵
---@param embattleArray table 布阵数据
---@param index number 布阵序列
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@param pos number 位置编号
---@return 变量类型 中文描述
function EmbattleItemPVE:SetEmbattleDataSingle(index, uid, etIndex, pos)
    if self.curEmbattleData[index].tag ~= 0 then
        return false
    end
    return EmbattleItemBase.HandleEmbattleData(self, self.curEmbattleData, index, uid, etIndex, pos)
end
---清空
---@param index number 编号(针对多布阵数据  挂机副本)
function EmbattleItemPVE:ClearEmbattle(index)
    if self.curEmbattleData == nil then
        return
    end
    local card
    for i = 1, #self.curEmbattleData do
        card = self.curEmbattleData[i]
        if card.tag == 0 then
            if card.uid > 0 then
                self:SetCurUids(card.uid, false)
                self:SetCurSids(card.sid, false)
            end
            card.uid = 0
            card.sid = 0
            card.level = 0
            card.star = 0
            card.soulLink_lv = 0
        end
    end
    if not self.curCombSkillData then
        return
    end
    local skill
    for i = 1, #self.curCombSkillData do
        skill = self.curCombSkillData[i]
        if skill.tag == 0 then
            skill.id = 0
            skill.lv = 0
            skill.cskillID = 0
        end
    end
end
---取助战角色表
function EmbattleItemPVE:GetAssistList()
    if self.storyCardList ~= nil and #self.storyCardList > 0 then
        return self.storyCardList
    end
    return nil
end
---检测卡牌是否是助战角色
---@return 变量类型 中文描述
function EmbattleItemPVE:CheckCardAssist(uid)
    if self.storyCardList then
        for i = 1, #self.storyCardList do
            if self.storyCardList[i].uid == uid then
                return true
            end
        end
    end
    return false
end
---检测卡牌是否可操作(上下阵，拖动换位)
---@param uid number 卡牌uid
---@return boolean 是否可操作
function EmbattleItemPVE:CheckCardHandle(uid)
    if self.storyCardList then
        for i = 1, #self.storyCardList do
            if self.storyCardList[i].uid == uid then
                return false
            end
        end
    end
    return true
end
---获取合击技能状态
---@return table 技能位置状态
function EmbattleItemPVE:GetCombineSkillState()
    self.combinePosState = self.combinePosState or {false, false, false}
    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    for i = 1, #self.combinePosState do
        self.combinePosState[i] =
            self.curCombSkillData[i].tag > 0 or
            (EmbattleModelIns:CheckSkillPosUnLock(i) and self.curCombSkillData[i].tag == 0)
    end
    return self.combinePosState
end
---检测是否展示布阵按钮助战标识
---@return 变量类型 中文描述
function EmbattleItemPVE:ShowEmbattleAssitTag()
    return self.storyCardList ~= nil and #self.storyCardList > 0
end
--endregion
---是否显示皮肤
function EmbattleItemPVE:EmbattleIs()
    self.Embattle = true
    return self.Embattle
end
return EmbattleItemPVE
