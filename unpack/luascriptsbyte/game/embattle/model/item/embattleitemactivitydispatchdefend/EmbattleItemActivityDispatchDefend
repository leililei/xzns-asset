function EmbattleItemActivityDispatchDefend:GetOtherGroupPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.curEmbattleType do
        if i ~= index and self.curPetSkillData[i] then
            local data = self.curPetSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

function EmbattleItemActivityDispatchDefend:GetOtherGroupBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    local others = {}
    for i = 1, #self.curEmbattleType do
        if i ~= index and self.curBeastSkillData[i] then
            local data = self.curBeastSkillData[i]
            for j = 1, #data do
                table.insert(others, data[j])
            end
        end
    end
    return others
end

