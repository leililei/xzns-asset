---@private
function EmbattleItemGMArenaPeak:InitCardList()
    local GMArenaPeakModel = require("GMArenaPeakModel"):GetInstance()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local supCards = GMArenaPeakModel:GetSupportCards()
    self.curChooseCardList = {}
    ---@type CardData
    local newCard
    local attId = _G.ConfigManager.arena_peak_cfg[GMArenaPeakModel:GetCurSeasonID()].att_equity
    local lv = _G.ConfigManager.att_equity_cfg[attId].level
    for _, card in pairs(cards) do
        if card.cfg.Order >= 3 then
            newCard = _G.DeepCopy(card)
            newCard:SetLevel(lv)
            newCard.shenshiPosType = _G.StonePosType.PosZero
            newCard:CalcNowSumProp()
            _G.table.insert(self.curChooseCardList, newCard)
        end
    end
    for _, card in pairs(supCards) do
        _G.table.insert(self.curChooseCardList, card)
    end
    --self.curChooseCardList = table.toArray(cards)
    self:SortCardList()
end

