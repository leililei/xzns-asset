function EmbattleItemGMArenaPeak:GetAutoArenaPeakEMData()
    local frontRow = {
        [1] = true,
        [2] = true
    }
    local backRow = {
        [3] = true,
        [4] = true,
        [5] = true
    }
    local backSort = {3, 4, 5, 1, 2}
    local oldEmbattleData = self:GetEmbattleData()
    local newCardList = {}
    for _, v in pairs(oldEmbattleData) do
        if v.uid ~= 0 then 
            _G.table.insert(newCardList, _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, v.uid))
        end
    end

    local newEmbattleData = {}
    local max = self:GetMaxPutNum()
    local num = math.max(#oldEmbattleData, 5)
    --ZHJH-15308【战斗】-一键布阵优化
    --card表的Distance字段新增6、7、8、9、10数值，对应队伍中1、2、3、4、5号位
    local preferentCards = {}
    for i = math.min(#newCardList, num), 1, -1 do
        if newCardList[i].cfg.Distance >= 6 then
            newCardList[i].__tempIndex = i --临时记录在newCardList中的index序号
            _G.table.insert(preferentCards, 1, newCardList[i])
        end
    end
    if #preferentCards > 0 then
        --优先上阵的角色
        for index = 1, num do
            if index > max and max ~= 0 then
                break
            end
            local _cardData = preferentCards[index]
            local _cardSortIndex = _cardData and _cardData.__tempIndex or 999
            if _cardData and _cardSortIndex <= num then --卡牌存在, 且排序在num及之前
                local posIndex = _cardData.cfg.Distance - 5
                if not newEmbattleData[posIndex] then
                    newEmbattleData[posIndex] = _cardData
                    --_G.table.remove(newCardList, _cardSortIndex)
                    --如果位置已被占用(Distance相同), 移除所有相同Distance卡牌
                    for j = #newCardList, 1, -1 do
                        if newCardList[j].cfg.Distance == _cardData.cfg.Distance then
                            _G.table.remove(newCardList, j)
                        end
                    end
                end
            else
                break
            end
        end
    end

    for index, v in ipairs(oldEmbattleData) do
        if _G.table.count(newEmbattleData) >= max and max ~= 0 then
            break
        end
        local _cardData = newCardList[index]
        if _cardData then
            if frontRow[_cardData.cfg.Distance] then
                ---检查前排是否还有位置
                for i = 1, 5 do
                    if not newEmbattleData[i] then
                        newEmbattleData[i] = _cardData
                        break
                    end
                end
            elseif backRow[_cardData.cfg.Distance] then
                for i = 1, 5 do
                    if not newEmbattleData[backSort[i]] then
                        newEmbattleData[backSort[i]] = _cardData
                        break
                    end
                end
            end
        else
            break
        end
    end
    --self:SetEmbattleData(newEmbattleData, 1)
    local card, sit
    if _G.table.count(newEmbattleData) >= 5 then
        for i = 1, _G.table.count(newEmbattleData) do
            card = self.curEmbattleData[i]
            sit = newEmbattleData[i]
            if sit then 
                card.uid = sit.uid
                card.sid = sit.sid
                card.star = sit.star
                card.level = sit.level
                card.soulLink_lv = sit.soulLink_lv
                card.power = sit.power or 0
                card.tag = sit.tag or 0
            end
        end
    end
    return oldEmbattleData, newEmbattleData
end

function EmbattleItemGMArenaPeak:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0}
    if not self.curEmbattleData then
        return
    end
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local skills = {0, 0, 0}
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local pets = {0, 0, 0}
    if self.curPetSkillData then
        for i = 1, #self.curPetSkillData do
            pets[i] = self.curPetSkillData[i]
        end
    end
    local beasts = {0, 0, 0}
    if _G.AppSetting.IsXzns then
        if self.curBeastSkillData then
            for i = 1, #self.curBeastSkillData do
                beasts[i] = self.curBeastSkillData[i]
            end
        end
    end

    local EmbattleModelIns = require("EmbattleModel"):GetInstance()
    EmbattleModelIns:SetSkillIndex(self.curEmbattleType, skills)
    EmbattleModelIns:SetPetSkillIndex(self.curEmbattleType, pets)
    if _G.AppSetting.IsXzns then
        EmbattleModelIns:SetBeastSkillIndex(self.curEmbattleType, beasts)
    end
    EmbattleModelIns:SaveEmbattleDataNew(
            self.curEmbattleType,
            _G.handler(self, self.OnSaveEnd),
            self.saveType,
            self.notPassServer,
            sits
    )
    sits = nil
end

return EmbattleItemGMArenaPeak
