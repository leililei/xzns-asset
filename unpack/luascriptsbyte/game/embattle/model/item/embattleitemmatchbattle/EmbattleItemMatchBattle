function EmbattleItemMatchBattle:ShowFormationBtn()
    return false
end
---交换卡牌位置
---@param dragpos number 拖动的卡牌位置
---@param changepos number 交换的卡牌位置
---@param index number 多布阵序列号
---@return boolean 是否交换成功
function EmbattleItemMatchBattle:ChangeCardPos(dragpos, changepos)
    local index = MatchBattleManager:GetInstance():GetCurEmbattleIndex()
    index = (index - 1) * 2
    if changepos <= index then
        return false
    end
    if dragpos <= index then
        return false
    end
    self.curEmbattleData.pos[dragpos] = self.curEmbattleData.pos[dragpos] + self.curEmbattleData.pos[changepos]
    self.curEmbattleData.pos[changepos] = self.curEmbattleData.pos[dragpos] - self.curEmbattleData.pos[changepos]
    self.curEmbattleData.pos[dragpos] = self.curEmbattleData.pos[dragpos] - self.curEmbattleData.pos[changepos]
    return true
end
---获取第一个空的位置
---@param index number 多布阵序列号
---@return number 空序列
function EmbattleItemMatchBattle:GetFirstEmptyIndex(etIndex, index)
    local curMatchStage = MatchBattleManager:GetInstance():GetCurEmbattleIndex()
    curMatchStage = curMatchStage * 2
    if not index then
        return curMatchStage - 1
    end
    if index == curMatchStage then
        if self.curEmbattleData.heroes[index - 1].uid > 0 then
            return index
        else
            return index - 1
        end
    else
        if self.curEmbattleData.heroes[index + 1].uid > 0 then
            return index
        else
            return index + 1
        end
    end
end

---检测卡牌状态 除了状态1 其他状态全部为lock
---@param uid number 卡牌uid
---@param index number 当前选择的分组
---@return EmbattleState  布阵卡牌状态
function EmbattleItemMatchBattle:CheckCardLock(uid)
    local index = MatchBattleManager:GetInstance():GetCurEmbattleIndex()
    index = (index - 1) * 2
    for i = 1, index do
        if self.curEmbattleData.heroes[i].uid == uid then
            return 2
        end
    end
    return 1
end

---初始化敌方布阵数据
---@return table 地方布阵数据
function EmbattleItemMatchBattle:InitEnemyEmbattleData()
    if self.curEnemyEmbattleData == nil then
        self.curEnemyEmbattleData = {heroes = {}, pos = {1, 2, 3, 4, 5, 6}}
        for i = 1, 6 do
            _G.table.insert(self.curEnemyEmbattleData.heroes, {uid = 0, sid = 0, level = 0, star = 0})
        end
    end
    local data = MatchBattleManager:GetInstance():GetEnemyEmbattleData()
    if not _G.table.isEmptyOrNil(data) then
        local uid, pos, cfg
        local containPos = {1, 2, 3, 4, 5, 6}
        local index = #data + 1
        for i = 1, #data do
            if data[i] == 0 then
                index = i
                break
            end
            uid = _G.GameUtil.GetDivisionNumber(data[i],10)
            pos = data[i] - uid * 10
            cfg = _G.ConfigManager.arena_equity_card_cfg[uid]
            self.curEnemyEmbattleData.heroes[i].uid = uid
            self.curEnemyEmbattleData.heroes[i].sid = cfg.CardID
            self.curEnemyEmbattleData.heroes[i].level = cfg.Level
            self.curEnemyEmbattleData.heroes[i].star = cfg.Stars
            self.curEnemyEmbattleData.pos[i] = pos
            containPos[pos] = 0
        end
        for i = #containPos, 1, -1 do
            if containPos[i] == 0 then
                _G.table.remove(containPos, i)
            end
        end
        for i = index, #self.curEnemyEmbattleData.pos do
            self.curEnemyEmbattleData.pos[i] = _G.table.remove(containPos, 1)
        end
    end
end

---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemMatchBattle:InitCardList()
    self.curChooseCardList = {}
    self.temporaryCardList = {}
    for key, value in pairs(_G.ConfigManager.arena_equity_card_cfg) do
        local carddata = EmbattleItemMatchBattleTemporaryCardData.New(value)
        _G.table.insert(self.curChooseCardList, carddata)
        _G.table.insert(self.temporaryCardList, carddata)
    end
    self:SortCardList()
end
---获取卡牌对象
---@param uid number 卡牌uid
---@return table 卡牌数据对象
function EmbattleItemMatchBattle:GetCardData(uid)
    local cfg = _G.ConfigManager.arena_equity_card_cfg[uid]
    if cfg == nil then
        return nil
    end
    return EmbattleItemMatchBattleTemporaryCardData.New(cfg)
end

--endregion

return EmbattleItemMatchBattle
