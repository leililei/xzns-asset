--region匹配战斗临时构建的卡牌数据类
local EmbattleItemMatchBattleTemporaryCardData = _G.BaseClass("EmbattleItemMatchBattleTemporaryCardData")
function EmbattleItemMatchBattleTemporaryCardData:__init(cfg)
    self.uid = cfg.id
    self.sid = cfg.CardID
    self.cfg = _G.ConfigManager.card_cfg[self.sid]
    self.level = cfg.Level
    self.star = cfg.Stars
    self.power = cfg.Power
    self.Grade = self.cfg.Order
end
function EmbattleItemMatchBattleTemporaryCardData:Dispose()
    self.uid = nil
    self.sid = nil
    self.cfg = nil
    self.level = nil
    self.star = nil
    self.power = nil
end
function EmbattleItemMatchBattleTemporaryCardData:GetLevel()
    return self.level
end
function EmbattleItemMatchBattleTemporaryCardData:GetStar()
    return self.star
end
function EmbattleItemMatchBattleTemporaryCardData:GetPower()
    return self.power
end
--endregion

local MatchBattleManager = require "MatchBattleManager"
local EmbattleItemBase = require "EmbattleItemBase"

---@class EmbattleItemMatchBattle	中文描述
local EmbattleItemMatchBattle = _G.BaseClass("EmbattleItemMatchBattle", EmbattleItemBase)

---类的构造函数
function EmbattleItemMatchBattle:__init()
end

---类的析构函数
function EmbattleItemMatchBattle:Dispose()
    if self.temporaryCardList then
        for i = 1, #self.temporaryCardList do
            self.temporaryCardList[i]:Dispose()
        end
        self.temporaryCardList = nil
    end
end

--region重写方法

---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemMatchBattle:InitEmbattleData(sits, index)
    self.curUids = {}
    if self.curEmbattleData == nil then
        self.curEmbattleData = {0, 0, 0, 0, 0, 0}
        for i = 1, 6 do
            _G.table.insert(self.curEmbattleData.heroes, {uid = 0, sid = 0, star = 0, level = 0})
        end
    end
    if sits then
        local uid, cfg, pos
        local containPos = {1, 2, 3, 4, 5, 6}
        local index = 1
        local needHandlePos = false
        for i = 1, #sits do
            if sits[i] > 0 then
                index = index + 1
                uid = _G.GameUtil.GetDivisionNumber(sits[i],10)
                pos = sits[i] - uid * 10
                if uid ~= self.curEmbattleData.heroes[i].uid then
                    cfg = _G.ConfigManager.arena_equity_card_cfg[uid]
                    self.curEmbattleData.heroes[i].uid = uid
                    self.curEmbattleData.heroes[i].sid = cfg.CardID
                    self.curEmbattleData.heroes[i].star = cfg.Stars
                    self.curEmbattleData.heroes[i].level = cfg.Level
                    if pos ~= self.curEmbattleData.pos[i] then
                        needHandlePos = true
                        self.curEmbattleData.pos[i] = pos
                    end
                elseif pos ~= self.curEmbattleData.pos[i] then
                    needHandlePos = true
                    self.curEmbattleData.pos[i] = pos
                end
                containPos[pos] = 0
                self:SetCurUids(uid, true)
            end
        end
        if needHandlePos then
            for i = #containPos, 1, -1 do
                if containPos[i] == 0 then
                    _G.table.remove(containPos, i)
                end
            end
            for i = index, #self.curEmbattleData.pos do
                self.curEmbattleData.pos[i] = _G.table.remove(containPos, 1)
            end
        end
    end
end
---获取布阵框是否可点击
---@param index number 布阵序列号
---@return boolean 是否可点
function EmbattleItemMatchBattle:GetFormationClick(index)
    local curMatchStage = MatchBattleManager:GetInstance():GetCurEmbattleIndex()
    if index == curMatchStage * 2 or index == curMatchStage * 2 - 1 then
        return true
    else
        index = curMatchStage * 2
        if self.curEmbattleData.heroes[index].uid == 0 then
            return true
        end
        index = curMatchStage * 2 - 1
        if self.curEmbattleData.heroes[index].uid == 0 then
            return true
        end
    end
    return false
end

---是否显示战斗力
---@return boolean 是否显示战力
function EmbattleItemMatchBattle:ShowPower()
    return false
end
---显示清空按钮
