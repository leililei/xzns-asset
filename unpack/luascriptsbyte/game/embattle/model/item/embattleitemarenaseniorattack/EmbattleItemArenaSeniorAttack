local base = require "EmbattleItemArenaSeniorDefence"
---@class EmbattleItemArenaSeniorAttack	:EmbattleItemArenaSeniorDefence
local EmbattleItemArenaSeniorAttack = _G.BaseClass("EmbattleItemArenaSeniorAttack", base)

---类的构造函数
function EmbattleItemArenaSeniorAttack:__init(eType, saveType, notPassServer, mgpID, enemy)
    self.enemy = enemy
    self:InitEnemyEmbattleData()
    self.showEnemySoulAndTalents = true
end

---类的析构函数
function EmbattleItemArenaSeniorAttack:Dispose()
    self.enemy = nil
end

---初始化敌方布阵数据
function EmbattleItemArenaSeniorAttack:InitEnemyEmbattleData()
    if self.enemy == nil then
        return
    end
    self.curEnemyEmbattleData = {false, false, false}
    local insert = _G.table.insert
    local card
    local cfg
    local cfgs = _G.ConfigManager.card_cfg
    for i = 1, #self.enemy do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            card = self.enemy[i][j]
            if card.sid > 0 then
                cfg = cfgs[card.sid]
            else
                cfg = nil
            end
            data[j] = {
                uid = card.sid,
                sid = card.sid,
                level = card.level,
                star = card.star,
                soulLink_lv = card.soulLV,
                power = card.power,
                scale = cfg and cfg.GlobalScale * 0.0001 or 1,
                soulLink_IsActivate = card.soulState,
                open_inborn = card.talents, 
                artifact = card.artifact
            }
        end
        self.curEnemyEmbattleData[i] = data
    end
end

---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemArenaSeniorAttack:GetEnemyEmbattlePower(index)
    local power = 0
    for i = 1, #self.curEnemyEmbattleData[index] do
        power = power + self.curEnemyEmbattleData[index][i].power
    end
    return power
end

function EmbattleItemArenaSeniorAttack:GetCacheModelInBattle()
    return false
end
---获取是否展示跳过战斗
function EmbattleItemArenaSeniorAttack:GetShowSkip()
    self.AttackName = 3
    return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(95)
end
---获取挑战按钮文字图片名字
---@return string 按钮文字图片名字
function EmbattleItemArenaSeniorAttack:GetBattleImageName()
    return "ui_bz_btn_txt_zhandou"
end

---获取服务器阵容
function EmbattleItemArenaSeniorAttack:GetServerEmbattleData(id, index)
    local arenaAttackIds = {
        _G.EmbattleType.arenaSeniorDefence1,
        _G.EmbattleType.arenaSeniorDefence2,
        _G.EmbattleType.arenaSeniorDefence3
    }
    local isHave = require("EmbattleModel"):GetInstance():CheckEmbattleData(id)
    if self:CheckEmbattleData(arenaAttackIds) and not isHave then
        id = arenaAttackIds[index] or _G.EmbattleType.arenaSeniorDefence1
    end

    if id == _G.EmbattleType.arenaSeniorAttack1 and not isHave then
        id = _G.EmbattleType.AFKOnly
    end
    return base.GetServerEmbattleData(self, id, index)
end

function EmbattleItemArenaSeniorAttack:GetSkillIndex(id)
    local arenaAttackIds = {
        _G.EmbattleType.arenaSeniorDefence1,
        _G.EmbattleType.arenaSeniorDefence2,
        _G.EmbattleType.arenaSeniorDefence3
    }
    local isNotHave = not require("EmbattleModel"):GetInstance():CheckEmbattleData(id)
    if self:CheckEmbattleData(arenaAttackIds) and isNotHave then
        id = id + 3
    end
    if id == _G.EmbattleType.arenaSeniorAttack1 and isNotHave then
        id = _G.EmbattleType.AFKOnly
    end
    return base.GetSkillIndex(self, id)
end
return EmbattleItemArenaSeniorAttack
