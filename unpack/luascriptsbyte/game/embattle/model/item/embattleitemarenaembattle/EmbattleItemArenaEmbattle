---类的构造函数
function EmbattleItemArenaFair:__init(eType, saveType, notPassServer, mgpID, data)
    self.ArenaStreetFightingManager = require "ArenaStreetFightingManager":GetInstance()
    self.matchData = {}
    self.matchData.cards = {}
    for key, value in pairs(self.ArenaStreetFightingManager:GetCard_list()) do
        _G.table.insert(self.matchData.cards, value)
    end

    self.matchData.target_cards = {}
    self.ItemNum = 0
    self.curEnemyUids = {}
    self.showEnemySoulAndTalents = true
end

---类的析构函数
function EmbattleItemArenaFair:Dispose()
    self.ArenaStreetFightingManager = nil
    self.matchData = nil
    self.curEnemyUids = nil
end

---初始化布阵数据
---@param sits table 布阵数据
---@param index number 多布阵序列号
function EmbattleItemArenaFair:InitEmbattleData(sits)
    if sits then
        local cfg = _G.ConfigManager.att_equity_cfg[3]
        self.curUids = {}
        self.curSids = {}
        for i = 1, #sits do
            if sits[i] > 0 then
                local item = self.curEmbattleData[i]
                item.uid = sits[i]
                item.sid = sits[i]
                item.star = cfg.star
                item.level = cfg.level
                item.soulLink_IsActivate = cfg.card_exclusive
                item.soulLink_lv = cfg.card_exclusive_lv
                item.open_inborn = 2
                item.tag = 1
                self.curUids[sits[i]] = true
                self.curSids[sits[i]] = true
            elseif self.curEmbattleData[i].uid > 0 then
                self.curUids[self.curEmbattleData[i].uid] = nil
                self.curSids[self.curEmbattleData[i].uid] = nil
                self.curEmbattleData[i] = {
                    uid = 0,
                    sid = 0,
                    star = 0,
                    level = 1,
                    soulLink_IsActivate = 0,
                    soulLink_lv = 0,
                    open_inborn = 0,
                    tag = 0
                }
            end
        end
    else
        self.curEmbattleData = {false, false, false, false, false}
        for i = 1, 5 do
            self.curEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_IsActivate = 0,
                soulLink_lv = 0,
                open_inborn = 0,
                tag = 0
            }
        end
        self:SetCombSkillData()
        self:SetPetSkillData()
    end
end
---初始化敌方布阵数据
---@return table 地方布阵数据
function EmbattleItemArenaFair:InitEnemyEmbattleData(sits)
    if sits then
        local cfg = _G.ConfigManager.att_equity_cfg[3]
        local card_cfg = _G.ConfigManager.card_cfg
        local ccfg
        for i = 1, #sits do
            if sits[i] > 0 then
                local item = self.curEnemyEmbattleData[i]
                item.uid = sits[i]
                item.sid = sits[i]
                item.star = cfg.star
                item.level = cfg.level
                item.soulLink_IsActivate = cfg.card_exclusive
                item.soulLink_lv = cfg.card_exclusive_lv
                item.open_inborn = 2
                item.tag = 0
                self.curEnemyUids[sits[i]] = true
                ccfg = card_cfg[sits[i]]
                if ccfg then
                    item.scale = ccfg.GlobalScale * 0.0001
                end
            end
        end
    else
        self.curEnemyEmbattleData = {false, false, false, false, false}
        for i = 1, 5 do
            self.curEnemyEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_IsActivate = 0,
                soulLink_lv = 0,
                open_inborn = 0,
                tag = 0
            }
        end
        self:SetEnemyCombineSkill()
    end
end
---设置合击技数据
---@param data table 合击技数据
---@param index number 布阵序列
function EmbattleItemArenaFair:SetCombSkillData(data)
    if data then
        local RoundToInt = _G.Mathf.RoundToInt
        local type = _G.type
        local combine_cfg = _G.ConfigManager.combine_cfg
        for i = 1, #data do
            if type(data[i]) == "number" then --服务器同步数据
                if data[i] > 0 then
                    local skill = self.curCombSkillData[i]
                    skill.tag = 1
                    skill.id = RoundToInt(data[i] / 10000)
                    skill.lv = RoundToInt(data[i] % 10000 / 100)
                    skill.cskillID = combine_cfg[skill.id].skills[skill.lv]
                end
            else
                if data[i].cskillID > 0 then --合击技界面传入数据
                    local skill = self.curCombSkillData[i]
                    skill.cskillID = data[i].cskillID
                    skill.tag = 1
                    skill.id = data[i].id
                    skill.lv = data[i].lv
                end
            end
        end
    else
        self.curCombSkillData = {false, false, false}
        for i = 1, #self.curCombSkillData do
            self.curCombSkillData[i] = {
                id = 0,
                lv = 0,
                cskillID = 0,
                tag = 0
            }
        end
    end
end
