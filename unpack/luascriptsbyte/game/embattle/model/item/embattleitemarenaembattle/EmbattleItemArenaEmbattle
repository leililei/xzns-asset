---设置单个位置的布阵数据
---@param index number 序列号
---@param uid number 卡牌uid
---@param etIndex number 多布阵序列号
---@return boolean 设置是否成功
function EmbattleItemArenaFair:SetEmbattleDataSingle(index, uid, etIndex)
    if self.curShowEnemyTag then
        return false
    end
    if self.curEmbattleData[index].tag == 1 then --锁定的位置不可上阵
        return false
    end
    if self.curEmbattleData[index].uid == 0 then
        local OKBool, oleNume, MaxNum = self.ArenaStreetFightingManager:UnCheck()
        local count = 0
        for i = 1, #self.curEmbattleData do
            if self.curEmbattleData[i].uid > 0 then
                count = count + 1
            end
        end

        if count == MaxNum then --达到当前轮次上限
            return false
        end
    end
    --TODO:检测上阵
    local success = self:HandleEmbattleData(self.curEmbattleData, index, uid, etIndex)
    if success then
        if self.onEmbattleDataChangedCall then
            self.onEmbattleDataChangedCall()
        end
    end
    return success
end
---初始化卡牌列表
---@return table 卡牌列表
function EmbattleItemArenaFair:InitCardList()
    local sortFunc = function(a, b)
        return a > b
    end
    _G.table.sort(self.matchData.cards, sortFunc)
    _G.table.sort(self.matchData.target_cards, sortFunc)
    local id = 0
    local cfg = _G.ConfigManager.att_equity_cfg[3]
    for i = 1, #self.matchData.cards do
        id = self.matchData.cards[i]
        self.matchData.cards[i] = EmbattleItemArenaEmbattle.New(cfg, id)
    end
    for i = 1, #self.matchData.target_cards do
        id = self.matchData.target_cards[i]
        self.matchData.target_cards[i] = EmbattleItemArenaEmbattle.New(cfg, id)
    end
    self.curChooseCardList = self.matchData.cards
end
---交换卡牌位置
---@param dragpos number 拖动的卡牌位置
---@param changepos number 交换的卡牌位置
---@param index number 多布阵序列号
---@return boolean 是否交换成功
function EmbattleItemArenaFair:ChangeCardPos(dragpos, changepos)
    if self.curEmbattleData[dragpos].tag == 1 or self.curEmbattleData[changepos].tag == 1 then --锁定的位置不可交换
        return false
    end
    local data = self.curEmbattleData[dragpos]
    self.curEmbattleData[dragpos] = self.curEmbattleData[changepos]
    self.curEmbattleData[changepos] = data
    return true
end
---检测是否在布阵中
---@param uid number 卡牌uid
---@return boolean 是否在布阵中
function EmbattleItemArenaFair:CheckUidInEmbattle(uid, index)
    if self.curShowEnemyTag then
        return self.curEnemyUids[uid] or false
    end
    return self.curUids[uid] or false
end
---检测是否相同SID
---@param sid number 卡牌sid
---@return boolean 是否存在已上阵的sid
function EmbattleItemArenaFair:CheckSidInEmbattle(sid)
    if self.curShowEnemyTag then
        return false
    end
    return self.curSids[sid] or false
end
---检测卡牌状态 除了状态1 其他状态全部为lock
