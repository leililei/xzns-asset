---检测卡牌是否可操作(上下阵，拖动换位)
---@param uid number 卡牌uid
---@return boolean 是否可操作
function EmbattleItemArenaFair:CheckCardHandle(uid)
    if self.curShowEnemyTag then --展示敌人列表
        return false
    end
    local dic, count
    count = 0
    for i = 1, #self.curEmbattleData do
        dic = self.curEmbattleData[i]
        if dic.tag == 1 then --已锁定的角色
            count = count + 1
            if dic.uid == uid then
                _G.PopWindowManager:GetInstance():ShowAllTips(670105)
                return false, 1
            end
        end
    end
    local times = self.ArenaStreetFightingManager:GetCurEmbattleTimes()
    return _G.Mathf.RoundToInt(count * 0.5) < times
end
