    self.sid = id
    self.cfg = _G.ConfigManager.card_cfg[self.sid]
    self.level = cfg.level
    self.star = cfg.star
    self.power = 0
    self.Grade = self.cfg.Order
    self.soulLink_IsActivate = cfg.card_exclusive
    self.soulLink_lv = cfg.card_exclusive_lv
    self.open_inborn = 2
end
function EmbattleItemArenaEmbattle:Dispose()
    self.uid = nil
    self.sid = nil
    self.cfg = nil
    self.level = nil
    self.star = nil
    self.power = nil
    self.Grade = nil
    self.soulLink_IsActivate = nil
    self.soulLink_lv = nil
    self.open_inborn = nil
end
function EmbattleItemArenaEmbattle:GetLevel()
