---获取合击技列表
---@return table 合击技能列表
function EmbattleItemArenaFair:OtherGroupSkillListNew()
    if self.combineSkillList then
        return self.combineSkillList
    end
    self.combineSkillList = {}
    local id = 0
    local RoundToInt = _G.Mathf.RoundToInt
    for i = 1, #self.matchData.combine do
        id = self.matchData.combine[i]
        self.combineSkillList[#self.combineSkillList + 1] = {RoundToInt(id / 10000), RoundToInt(id % 10000 / 100)}
    end
    _G.SortList(
        self.combineSkillList,
        function(a)
            return a[2], a[1]
        end
    )
    return self.combineSkillList
end
---保存布阵数据
---@param saveCall function 保存回调
function EmbattleItemArenaFair:SaveEmbattle(saveCall)
    saveCall(0)
end
function EmbattleItemArenaFair:OnSaveEmbattleCall(msg)
    if msg.ack == 1 then
        --TODO:将数据设置为不可更改状态
        local dic
        for i = 1, #self.curEmbattleData do
            dic = self.curEmbattleData[i]
            if dic.uid > 0 then
                dic.tag = 1
            end
        end
        for i = 1, #self.curCombSkillData do
            dic = self.curCombSkillData[i]
            if dic.cskillID > 0 then
                dic.tag = 1
            end
        end
    end
    if self.onSaveCall then
        self.onSaveCall(msg)
    end
end
