local EmbattleItemBase = require "EmbattleItemBase"
---@class EmbattleItemPVP : EmbattleItemBase	中文描述
local EmbattleItemPVP = _G.BaseClass("EmbattleItemPVP", EmbattleItemBase)

---类的构造函数
---@param data table 敌方布阵数据{{uid=0,sid=0,level=0,star=0},power=0}
function EmbattleItemPVP:__init(eType, saveType, notPassServer, mgpID, data)
    self.curEnemyEmbattleData = data
    self:InitEnemyEmbattleData()
end

---类的析构函数
function EmbattleItemPVP:Dispose()
end

--region 重写方法

---初始化敌方布阵数据
---@return table 地方布阵数据
function EmbattleItemPVP:InitEnemyEmbattleData()
    if self.curEnemyEmbattleData == nil then
        return
    end
    local cfgs = _G.ConfigManager.card_cfg
    local cfg, card
    for i = 1, 5 do
        card = self.curEnemyEmbattleData[i]
        if card then
            if card.sid > 0 then
                cfg = require "CardCommentManager":GetInstance():CardData(card.sid, false)
                self.curEnemyEmbattleData[i].scale = cfg.GlobalScale * 0.0001
            else
                self.curEnemyEmbattleData[i].scale = 1
            end
        else
            self.curEnemyEmbattleData[i] = {uid = 0, sid = 0, level = 0, star = 0, scale = 1, soulLink_IsActivate = 0, soulLink_lv = 0, open_inborn = nil}
        end
    end
end
---获取敌方战斗力
---@return number 战斗力
function EmbattleItemPVP:GetEnemyEmbattlePower()
    return self.curEnemyEmbattleData and self.curEnemyEmbattleData.power or 0
end

--endregion

return EmbattleItemPVP
