local base = require "EmbattleItemSociatyBattleLeagueAttack"
---@class EmbattleItemSociatyBattleLeagueDefend	:EmbattleItemSociatyBattleLeagueAttack
local EmbattleItemSociatyBattleLeagueDefend = _G.BaseClass("EmbattleItemSociatyBattleLeagueDefend", base)

---初始化地方阵容
function EmbattleItemSociatyBattleLeagueDefend:InitEnemyEmbattleData()
    self.curEnemyEmbattleData = {}
    for i, v in ipairs(self.curEmbattleType) do
        local data = {0, 0, 0, 0, 0}
        for j = 1, #data do
            data[j] = {uid = 0, sid = 0, level = 0, star = 0}
        end
        self.curEnemyEmbattleData[i] = data
    end
end
---保存阵容
function EmbattleItemSociatyBattleLeagueDefend:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {}
    local uid = 0
    local pets = {}
    local beasts = {}
    local skill = {}
    for i = 1, #self.curEmbattleData do
        sits[i] = {}
        pets[i] = {0, 0, 0}
        beasts[i] = {0, 0, 0}
        skill[i] = {}
        for j = 1, #self.curEmbattleData[i] do
            uid = self.curEmbattleData[i][j].uid
            sits[i][j] = uid < 0 and 0 or uid
        end
        for j = 1, #self.curCombSkillData[i] do
            skill[i][j] = self.curCombSkillData[i][j].id or 0
        end
        if self.curPetSkillData and self.curPetSkillData[i] then
            for j = 1, #self.curPetSkillData[i] do
                pets[i][j] = self.curPetSkillData[i][j]
            end
        end
        if _G.AppSetting.IsXzns then
            if self.curBeastSkillData and self.curBeastSkillData[i] then
                for j = 1, #self.curBeastSkillData[i] do
                    beasts[i][j] = self.curBeastSkillData[i][j]
                end
            end
        end
    end
    require "SociatyBattleLeagueModel":GetInstance():SaveDefendGarray(sits, skill, pets, _G.handler(self, self.OnSaveEnd), beasts)
end
---获取服务器阵容(多队时仅第一队使用)
function EmbattleItemSociatyBattleLeagueDefend:GetServerEmbattleData(index)
    local array = require("SociatyBattleLeagueModel"):GetInstance():GetDefendGarray(index).array
    if _G.table.isEmptyOrNil(array) then
        array = {0, 0, 0, 0, 0}
    end
    return array
end

function EmbattleItemSociatyBattleLeagueDefend:GetSkillIndex(index)
    local skills = require("SociatyBattleLeagueModel"):GetInstance():GetDefendGarray(index).skills
    if _G.table.isEmptyOrNil(skills) then
        skills = {0, 0, 0}
    end
    return skills
end

---获取敌方战斗力
---@param index number 布阵序列号
---@return number 战斗力
function EmbattleItemSociatyBattleLeagueDefend:GetEnemyEmbattlePower(index)
    return 0
end

function EmbattleItemSociatyBattleLeagueDefend:IsShowEnemyCombineSkill()
    return false
end

--region override pet function
function EmbattleItemSociatyBattleLeagueDefend:GetPetSkillData(index)
    if not self.curPetSkillData then
        return nil
    end
    local data = self.curPetSkillData[index]
    if not data then
        data = require("SociatyBattleLeagueModel"):GetInstance():GetDefendGarray(index).pet or {0, 0, 0}
        self.curPetSkillData[index] = data
    end
    return data
end
function EmbattleItemSociatyBattleLeagueDefend:GetBeastSkillData(index)
    if not self.curBeastSkillData then
        return nil
    end
    local data = self.curBeastSkillData[index]
    if not data then
        data = require("SociatyBattleLeagueModel"):GetInstance():GetDefendGarray(index).beast or {0, 0, 0}
        self.curBeastSkillData[index] = data
    end
    return data
end
--endregion

return EmbattleItemSociatyBattleLeagueDefend
