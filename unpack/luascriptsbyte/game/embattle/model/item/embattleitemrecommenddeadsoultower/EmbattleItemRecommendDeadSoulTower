local base = require "EmbattleItemRecommendBase"
---@class EmbattleItemRecommendDeadSoulTower:EmbattleItemRecommendBase	中文描述
local EmbattleItemRecommendDeadSoulTower = _G.BaseClass("EmbattleItemRecommendDeadSoulTower", base)

function EmbattleItemRecommendDeadSoulTower:GetRecordData(call, index, i_afk_recommend, monster_group_id)
    if not self.recordDataDic[index] then
        ---没有系统推荐
        require "DeadsoulTowerNet":GetInstance():GetRecord(
            {sid = require "DeadsoulTowerModel":GetInstance():GetCurTowerSid(), uid = self.data.uid, index = index},
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self:InitRecordData(msg, index)
                self.power = self.recordData.fight_arg.attacker_team[1].power
                if call then
                    call(self.recordData)
                end
            end
        )
    else
        self.recordData = self.recordDataDic[index].data
        self.recordCardDatas = self.recordDataDic[index].cardDatas
        self.power = self.recordData.fight_arg.attacker_team[1].power
        if call then
            call(self.recordData)
        end
    end
end

return EmbattleItemRecommendDeadSoulTower
