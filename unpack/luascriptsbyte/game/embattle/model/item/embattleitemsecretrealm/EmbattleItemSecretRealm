local base = require("EmbattleItemPVE")

---@class EmbattleItemSecretRealm: EmbattleItemPVE	大秘境
local EmbattleItemSecretRealm = _G.BaseClass("EmbattleItemSecretRealm", base)
---类的构造函数

function EmbattleItemSecretRealm:__init(etype, saveType, notPassServer, mgpID, embattleData, saveEmbattle)
    self.AttackName = "SecretRealm"
    self.saveEmbattle = saveEmbattle

    self:InitEmbattleDataFromData(embattleData or {})
end

function EmbattleItemSecretRealm:InitEmbattleDataFromData(embattleData)
    local sits = embattleData.sits
    local skills = embattleData.skill_index
    local pets = embattleData.pet
    local beasts
    if _G.AppSetting.IsXzns then
        beasts = embattleData.beast
    end
    ---初始化布阵卡牌
    self.curEmbattleData = { 0, 0, 0, 0, 0 }
    for i = 1, #self.curEmbattleData do
        local uid = sits and sits[i] or 0
        local cardData = uid > 0 and self:GetCardData(uid)
        if cardData then
            self.curEmbattleData[i] = {
                uid = cardData.uid,
                sid = cardData.sid,
                star = cardData:GetStar(),
                level = cardData:GetLevel(),
                soulLink_lv = cardData.soulLink_lv,
                tag = 0
            }
            self:SetCurUids(cardData.uid, true)
            self:SetCurSids(cardData.sid, true)
        else
            self.curEmbattleData[i] = {
                uid = 0,
                sid = 0,
                star = 0,
                level = 1,
                soulLink_lv = 0,
                tag = 0
            }
        end
    end
    ---初始化合击技
    self.curCombSkillData = { 0, 0, 0 }
    local combineModel = require("CombineModel"):GetInstance()
    for i = 1, #self.curCombSkillData do
        local id = skills and skills[i] or 0
        local lv, cskillID = 0, 0
        if id > 0 then
            lv = combineModel:GetCombineLevel(id)
            cskillID = _G.ConfigManager.combine_cfg[id].skills[lv]
        end
        self.curCombSkillData[i] = {
            id = id,
            lv = lv,
            cskillID = cskillID,
            tag = 0
        }
    end
    ---初始化宠物
    self.curPetSkillData = { 0, 0, 0 }
    for i = 1, #self.curPetSkillData do
        self.curPetSkillData[i] = pets and pets[i] or 0
    end
    if _G.AppSetting.IsXzns then
        ---初始化圣兽
        self.curBeastSkillData = { 0, 0, 0 }
        for i = 1, #self.curBeastSkillData do
            self.curBeastSkillData[i] = beasts and beasts[i] or 0
        end
    end
end

---保存布阵数据
---@param saveCall function 保存回调
function EmbattleItemSecretRealm:SaveEmbattle(saveCall)
    if not self.saveEmbattle then
        if saveCall then
            saveCall(0)
        end
        return
    end
    local sits = { 0, 0, 0, 0, 0 }
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local skills = { 0, 0, 0 }
    for i = 1, #self.curCombSkillData do
        skills[i] = self.curCombSkillData[i].id
    end
    local pets = { 0, 0, 0 }
    if self.curPetSkillData then
        for i = 1, #self.curPetSkillData do
            pets[i] = self.curPetSkillData[i]
        end
    end

    local beasts = { 0, 0, 0 }
    if _G.AppSetting.IsXzns then
        if self.curBeastSkillData then
            for i = 1, #self.curBeastSkillData do
                beasts[i] = self.curBeastSkillData[i]
            end
        end
    end

    self.onSaveCall = saveCall
    self.saveEmbattle({
        sits = sits,
        skills = skills,
        pets = pets,
        beasts = beasts
    }, _G.handler(self, self.OnSaveEnd))
end

---退出布阵是否缓存
---@return boolean
function EmbattleItemSecretRealm:GetCacheModelQuitEmbattle()
    return true
end

---是否展示跳过战斗按钮
---@return boolean
function EmbattleItemSecretRealm:GetShowSkip()
    return false
end

function EmbattleItemSecretRealm:GetCacheModelInBattle()
    return false
end

return EmbattleItemSecretRealm
