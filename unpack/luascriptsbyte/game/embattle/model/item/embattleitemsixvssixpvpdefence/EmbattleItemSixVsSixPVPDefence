---检测是否可以出战
function EmbattleItemSixVsSixPVPDefence:CheckBattle()
    for i = 1,3 do
        local count = 0
        for k = min[i] , max[i] do
           if self.curEmbattleData[k].uid == 0 then
                count = count + 1
           end
        end
        if count == i then
            return false,i
        end
    end
    return true
end

