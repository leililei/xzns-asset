---检测空位置
function EmbattleItemSixVsSixPVPDefence:CheckEmptyPos()
    local empty = false
    for i = 1, #self.curEmbattleData do
        if self.curEmbattleData[i].uid == 0 then
            if not empty then
                empty = i
            end
        end
    end
    if empty then
        local cfg
        local list = self:GetCardList()
        local card
        for i = 1, #list do
            card = list[i]
            if not self:CheckUidInEmbattle(card.uid) and not self:CheckSidInEmbattle(card.sid) then --未上阵
                return empty
            end
        end
    end
    return 0
end

