function EmbattleItemSixVsSixPVPDefence:SaveEmbattle(saveCall)
    self.onSaveCall = saveCall
    local sits = {0, 0, 0, 0, 0, 0}
    for i = 1, #self.curEmbattleData do
        sits[i] = self.curEmbattleData[i].uid
    end
    local SixVsSixPVPModel = require("SixVsSixPVPModel"):GetInstance()
    SixVsSixPVPModel:SetDefence(sits,_G.handler(self,self.OnSaveEnd))
    local power = 0
    for k,v in pairs(sits) do
        if v > 0 then
            local card
            card = self:GetCardData(v)
            power = power + card:GetPower(true)
        end
    end
    SixVsSixPVPModel:SetSelfPower(power)
    sits = nil
end

