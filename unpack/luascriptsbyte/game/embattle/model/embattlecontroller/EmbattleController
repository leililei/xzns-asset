function EmbattleController:AddEmbattleEffect(effect)
    if not self.embattleEffectTab then
        self.embattleEffectTab = { false, false, false, false, false, false, false, false, false, false }
    end
    for i = 1, #self.embattleEffectTab do
        if not self.embattleEffectTab[i] then
            self.embattleEffectTab[i] = effect
            break
        end
    end
end

function EmbattleController:ClearEmbattleEffect()
    if not self.embattleEffectTab then
        return
    end
    local RemoveEffect = _G.UIUtils.RemoveEffect
    for i = 1, #self.embattleEffectTab do
        if self.embattleEffectTab[i] then
            RemoveEffect(self.embattleEffectTab[i], 0)
            self.embattleEffectTab[i] = false
        end
    end
end

