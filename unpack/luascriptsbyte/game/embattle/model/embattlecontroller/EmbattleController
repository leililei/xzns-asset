---出战
---@param callback function 正确出战回调
---@param errorCall function 无法出战回调
function EmbattleController:OnEmbattleBattle(callback, errorCall)
    self.curEmbattleItem:SaveEmbattle(
        function(result, ...)
            if result == 0 then
                local isOk, showTip = EmbattleModel:GetInstance():CheckBattle(self.curEmbattleItem:GetCurEmbattleTypeNew())
                if isOk then
                    if self.onBattleCall then
                        self.onBattleCall(
                            self.curEmbattleItem:GetAssistList(),
                            ...,
                            self.curEmbattleItem:IsSkipBattle()
                        )
                        self.onBattleCall = nil
                    end
                    if callback then
                        callback()
                    end
                    self.curEmbattleItem:Dispose()
                    self.curEmbattleItem = nil
                    self.curShowInstructionID = nil
                else
                    if not showTip then
                        _G.PopWindowManager:GetInstance():ShowAllTips(140107)
                    end
                    if errorCall then
                        errorCall()
                    end
                end
            else
                if errorCall then
                    errorCall()
                end
            end
        end
    )
end

