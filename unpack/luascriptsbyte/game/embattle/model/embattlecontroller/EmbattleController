---检查五行竞技场防守/进攻阵容是否为空
---@param callback function
---@return boolean true:没有设置阵容
---@return boolean false:设置了阵容
function EmbattleController:CheckArenaDefenceIsEmpty(embattleType, saveType, notPassServer, itemType, callback, ...)
    if itemType == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("布阵参数传入错误 itemType = nil", "EmbattleController:OpenEmbattle")
        end
        if (callback) then
            callback(false)
        end
        return false
    end
    itemType = require(itemType)
    local item = itemType.New(embattleType, saveType, notPassServer, ...)
    if (_G.next(item.curSids) == nil) then
        if (callback) then
            callback(true)
        end
        return true
    else
        if (callback) then
            callback(false)
        end
        return false
    end
end

