function EmbattleController:GetGroupEmbattleData(index)
    if not self.curGroupIitem then
        return nil
    end
    index = index or self.curEditGroupIndex
    return self.curGroupIitem:GetEmbattleData(index), self.curGroupIitem:GetCombSkillData(index)
end

---获取编组名称
---@param index number 编队序列
---@return string 队伍名称
function EmbattleController:GetGroupName(index)
    if not self.groupNames then
        self.groupNames = _G.PlayerPrefsManager.GetTable(formationGroupNameKey) or {}
    end
    return self.groupNames[index]
end

---保存编组名称
---@param index number 编队序列
---@param name string 队伍名称
function EmbattleController:SetGroupName(index, name)
    if not self.groupNames then
        self.groupNames = _G.PlayerPrefsManager.GetTable(formationGroupNameKey) or {}
    end
    self.groupNames[index] = name
    _G.PlayerPrefsManager.SetTable(formationGroupNameKey, self.groupNames)
end

---检测名称是否重复
---@param name string 队伍名称
---@param index number 编队序列
---@return boolean 是否重复
function EmbattleController:CheckGroupNameRepeat(name, index)
    if not self.groupNames then
        self.groupNames = _G.PlayerPrefsManager.GetTable(formationGroupNameKey) or {}
    end
    for i, value in pairs(self.groupNames) do
        if value == name then
            if i ~= index then
                return true
            end
        end
    end
    return false
end

function EmbattleController:GetPreFormation(call)
    if self.formationInfo then
        call()
        return
    end
    EmbattleNet:GetInstance():GetPreFormation(_G.handlerbind(self, self.InitFormationData, call))
end

function EmbattleController:InitFormationData(msg, call)
    self.formationInfo = {[1] = {}, [2] = {}} ---1：5人队，2：3人队
    local group = msg.garray_group or {}
    for _, g in pairs(group) do
        if g.garrays then
            for _, v in pairs(g.garrays) do
                self.formationInfo[g.group_id][v.index] = v
            end
        end
    end
    if not formationDefaultCount then
        formationDefaultCount = _G.ConfigManager.discrete_cfg[formationCountDiscreteID][1][1]
    end
    for i = 1, 2 do
        for j = 1, formationDefaultCount do
            if not self.formationInfo[i][j] then
                self.formationInfo[i][j] = self:CreateEmptyFormation(j)
            end
        end
    end
    if call then
        call()
    end
end

function EmbattleController:CreateEmptyFormation(index, empty)
    empty = empty or {}
    empty.uid = 0
    empty.index = index
    empty.name = _G.GetLangPackValue(90114010144, _G.GameUtil.NumberToWordByLanguage(index))
    empty.sits = {0, 0, 0, 0, 0}
    empty.skill_index = {0, 0, 0}
    empty.pet = {0, 0, 0}
    if _G.AppSetting.IsXzns then
        empty.beast = {0, 0, 0}
    end
    return empty
end
function EmbattleController:UpdatePreFormation(group, index, sits, combines, pets, call, beasts)
    pets = _G.DeepCopy(pets)
    if _G.AppSetting.IsXzns then
        beasts = _G.DeepCopy(beasts)
    end
    local info = self.formationInfo[group][index]
    local uid = info.uid
    local pbData
    if uid == 0 then --新增编队
        if _G.AppSetting.IsXzns then
            pbData = {uid = uid, group_id = group, index = index, name = info.name, sits = sits, skill_index = combines, pet = pets, beast = beasts}
        else
            pbData = {uid = uid, group_id = group, index = index, name = info.name, sits = sits, skill_index = combines, pet = pets}
        end
    else
        if _G.AppSetting.IsXzns then
            pbData = {uid = uid, sits = sits, skill_index = combines, pet = pets, beast = beasts}
        else
            pbData = {uid = uid, sits = sits, skill_index = combines, pet = pets}
        end
    end
    EmbattleNet:GetInstance():UpdatePreFormation(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            info.sits = sits
            info.skill_index = combines
            info.pet = pets
            if _G.AppSetting.IsXzns then
                info.beast = beasts
            end
            if uid == 0 then
                info.uid = msg.garry_uid
            end
            if pbData.name then
                info.name = pbData.name
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(1315)
            if call then
                call()
            end
        end
    )
end

function EmbattleController:UpdatePreFormationName(group, index, name, call)
    for _, v in pairs(self.formationInfo[group]) do
        if v.name == name then
            _G.PopWindowManager:GetInstance():ShowAllTips(1314)
            return
        end
    end
    local info = self.formationInfo[group][index]
    if info.uid == 0 then
        local pbData
        if _G.AppSetting.IsXzns then
            pbData = {
                uid = info.uid,
                group_id = group,
                index = index,
                name = info.name,
                sits = info.sits,
                skill_index = info.skill_index,
                pet = info.pet,
                beast = info.beast}
        else
            pbData = {
                uid = info.uid,
                group_id = group,
                index = index,
                name = info.name,
                sits = info.sits,
                skill_index = info.skill_index,
                pet = info.pet
            }
        end
        EmbattleNet:GetInstance():UpdatePreFormation(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                info.name = name
                info.uid = msg.garry_uid
                _G.PopWindowManager:GetInstance():ShowAllTips(1312)
                if call then
                    call()
                end
            end
        )
    else
        local pbData = {uid = info.uid, name = name}
        EmbattleNet:GetInstance():UpdatePreFormationName(
            pbData,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                info.name = name
                _G.PopWindowManager:GetInstance():ShowAllTips(1312)
                if call then
                    call()
                end
            end
        )
    end
end

function EmbattleController:DelPreFormation(group, index, call)
    local info = self.formationInfo[group][index]
    if info.uid == 0 then
        return
    end
    local pbData = {uids = {info.uid}}
    EmbattleNet:GetInstance():DelPreFormation(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.formationInfo[group][index] = self:CreateEmptyFormation(index, self.formationInfo[group][index])
            if call then
                call()
            end
        end
    )
end

function EmbattleController:GetAllGroupFormation(group)
    return self.formationInfo[group] or {}
end

function EmbattleController:ExChangeGroupFormation(group, index1, index2, call)
    if self.formationInfo[group] then 
        local pb = {uid = {self.formationInfo[group][index1].uid, self.formationInfo[group][index2].uid}}
        EmbattleNet:GetInstance():ExchangePreFormation(pb, function(msg)
            if msg.ack == 1 then 
                local temp1 = _G.DeepCopy(self.formationInfo[group][index1])
                local temp2 = _G.DeepCopy(self.formationInfo[group][index2])
                self.formationInfo[group][index1] = temp2
                self.formationInfo[group][index1].index = index1
                self.formationInfo[group][index2] = temp1
                self.formationInfo[group][index2].index = index2
                if call then 
                    call()
                end
            end
        end)
    end
end

function EmbattleController:CheckCardInOtherGroupIndexFormationByUid(uid, group, nowIndex)
    group = group or self.curEditGroupType
    nowIndex = nowIndex or self.curEditGroupIndex
    if not self.formationInfo[group] then 
        return false 
    else 
        for k, v in pairs(self.formationInfo[group]) do
            if k ~= nowIndex then  
                for key, value in pairs(v.sits) do 
                    if value == uid then 
                        return true
                    end
                end
            end
        end
    end
end

