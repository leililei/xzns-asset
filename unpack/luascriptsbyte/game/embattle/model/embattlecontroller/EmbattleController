---打开布阵界面
---@param embattleType EmbattleType 布阵枚举
---@param saveType number 保存类型 nil or 0 保存服务器 1 保存本地 2临时存储
---@param notPassServer boolean 不通知服务器
---@param itemType EmbattleControllerItemType 布阵类
---@param exit function 返回回调
---@param battle function 出站回调
---@param ... any 特殊传参
function EmbattleController:OpenEmbattle(embattleType, saveType, notPassServer, itemType, exit, battle, ...)
    if itemType == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError("布阵参数传入错误 itemType = nil", "EmbattleController:OpenEmbattle")
        end
        return
    end
    --如果afk正在战斗中, 则不能打开任何布阵界面
    if _G.MainManager:GetInstance():IsFighting(false) then
        if _G.AppSetting.DEBUG then
            --检查释放从上层EmbattleView界面而来
            local trace = debug.traceback("")
            ---@type string[]
            local infos = string.split(string.gsub(trace, "\r\n", "\n"), "\n")
            for _, info in ipairs(infos) do
                if string.contains(info, "EmbattleView") and (
                        string.contains(info, "OnCreate") or
                        string.contains(info, "Awake")) then
                    _G.LogError(" 后台正在战斗中, 此时不能打开战斗布阵, 请检查是否有额外的布阵视图被打开")
                    break
                end
            end
        end
        --_G.PopWindowManager:GetInstance():ShowAllTips()
        if exit then
            exit()
        end
        return
    end

    self.openShackleView = nil
    self.onExitCall = exit
    self.onBattleCall = battle
    self.isOpenFromController = true
    itemType = require(itemType)
    local item = itemType.New(embattleType, saveType, notPassServer, ...)
    self.curEmbattleItem = item
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name, item, item.embattleIndex)
end

