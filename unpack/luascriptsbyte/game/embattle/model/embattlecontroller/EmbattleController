    self.onBattleCall = nil
    self.onEmbattleChangeCall = nil
    self.elementShackleIDs = nil
    self.godShackleIDs = nil
    self.openShackleView = nil
end

---初始化羁绊配置
function EmbattleController:InitShackleCfg()
    self.elementShackleIDs = { 1, 2, 3, 4 }
    self.godShackleIDs = { 1, 2, 3, 4, 5 }
    for id, value in pairs(_G.ConfigManager.formation_cfg) do
        if value.type_formation == 1 then
            self.elementShackleIDs[value.type_level] = id
        else
            self.godShackleIDs[value.type_level] = id
        end
    end
end

function EmbattleController:OnEmbattleChooseViewClose(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleChooseView.Name then
        if self.onEmbattleChooseViewClose then
            self.onEmbattleChooseViewClose()
        end
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleChooseViewClose, self)
    end
end

function EmbattleController:GetCombSkillIDByCardSid(sid)
    local cfg = _G.ConfigManager.monster_cfg[sid]
    if not cfg then
        return 0
    end
    local skillCfgs = _G.ConfigManager.card_skills_cfg
    local skillCfg
    local BattleResManager = _G.CS.BattleResManager.Inst
    for i = 1, #cfg.Skills do
        skillCfg = skillCfgs[cfg.Skills[i]]
        if skillCfg then
            for j = 1, #skillCfg.skills do
                if BattleResManager:CheckIDGhostSkill(skillCfg.skills[j]) then
                    return skillCfg.skills[j]
                end
            end
        end
    end
end

