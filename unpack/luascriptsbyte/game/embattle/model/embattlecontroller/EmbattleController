local formationCountDiscreteID = 103001
local formationDefaultCount = nil
local formationTypeStartIndex = _G.EmbattleType.formationGroup
local formationGroupNameKey = "FormationGroupNameKey"
---打开编队界面
---@param callback function 关闭编队回调
---@param grouptype string 非通用编队类
---@param fgType number 编队人数（0：全部，1，
---@param extra any 额外的参数
function EmbattleController:OpenFormation(callback, grouptype, fgType, embattleItem, curEmbattleIndex, extra)
    if not formationDefaultCount then
        formationDefaultCount = _G.ConfigManager.discrete_cfg[formationCountDiscreteID][1][1]
    end
    local ids = {}
    for i = 1, formationDefaultCount do
        ids[i] = formationTypeStartIndex + i - 1
    end
    self.formationGroupType = fgType
    self.onFormationGroupViewClose = callback
    self:GetPreFormation(
        function()
            if not self.curGroupIitem then
                self.curGroupIitem = require(grouptype).New(ids, nil, nil, nil, extra)
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.EmbattleFormationGroupView.Name,
                self.curGroupIitem,
                embattleItem,
                curEmbattleIndex,
                fgType,
                _G.handler(self, self.OnCloseFormationGroupView),
                _G.handler(self, self.ClearCurGroupItem)
            )
        end
    )
end

