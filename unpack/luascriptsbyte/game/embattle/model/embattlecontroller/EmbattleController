---当公会战预设编队使用分组界面关闭
---@param data table 布阵数据
---@param edit boolean 是否编辑
function EmbattleController:OnCloseSBFormationGroupView(index, edit)
    if self.onFormationGroupViewClose then
        local data = self.curGroupIitem:GetEmbattleData(index)
        local skills = self.curGroupIitem:GetCombSkillData(index)
        local petSkills = self.curGroupIitem:GetPetSkillData(index)
        local beastSkills
        if _G.AppSetting.IsXzns then
            beastSkills = self.curGroupIitem:GetBeastSkillData(index)
        end
        local jzlist = {}
        local yclist = {}
        local newdata = {}
        local jznum = 0
        local ycnum = 0
        for i = 1, #data do
            local info = data[i]
            if info.uid > 0 then
                local card = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, info.uid)
                if card.cfg.Distance == 1 then
                    jznum = jznum + 1
                    table.insert(jzlist, info)
                elseif card.cfg.Distance == 5 then
                    ycnum = ycnum + 1
                    table.insert(yclist, info)
                end
            end
        end
        if jznum == 1 and ycnum == 2 then
            newdata[1] = jzlist[1]
            newdata[2] = data[4]
            newdata[3] = yclist[1]
            newdata[4] = yclist[2]
            newdata[5] = data[5]
        elseif jznum == 2 and ycnum == 1 then
            newdata[1] = jzlist[1]
            newdata[2] = jzlist[2]
            newdata[3] = data[4]
            newdata[4] = yclist[1]
            newdata[5] = data[5]
        elseif jznum == 3 and ycnum == 0 then
            newdata[1] = jzlist[1]
            newdata[2] = jzlist[2]
            newdata[3] = data[4]
            newdata[4] = jzlist[3]
            newdata[5] = data[5]
        elseif jznum == 0 and ycnum == 3 then
            newdata[1] = data[4]
            newdata[2] = data[5]
            newdata[3] = yclist[1]
            newdata[4] = yclist[2]
            newdata[5] = yclist[3]
        else
            newdata = data
        end

        if edit then
            self.curEditGroupIndex = index
            self.onFormationGroupViewClose(newdata, skills, petSkills, edit, _G.handler(self, self.OnGroupEditCall),nil,nil,beastSkills)
        else
            self.onFormationGroupViewClose(newdata, skills, petSkills,nil,nil,nil,nil,beastSkills)
            self.curGroupIitem:Dispose()
            self.curGroupIitem = nil
            self.onFormationGroupViewClose = nil
        end
    end
end

---当分组界面关闭
---@param data table 布阵数据
---@param edit boolean 是否编辑
function EmbattleController:OnCloseFormationGroupView(group, index, edit, force)
    if self.onFormationGroupViewClose then
        local data = self.curGroupIitem:GetEmbattleData(index)
        local skills = self.curGroupIitem:GetCombSkillData(index)
        local petSkills = self.curGroupIitem:GetPetSkillData(index)
        local beastSkills
        if _G.AppSetting.IsXzns then
            beastSkills = self.curGroupIitem:GetBeastSkillData(index)
        end
        if edit then
            self.curEditGroupIndex = index
            self.curEditGroupType = group
            self.onFormationGroupViewClose(data, skills, petSkills, edit, _G.handler(self, self.OnGroupEditCall),nil,nil,beastSkills)
        else
            self.onFormationGroupViewClose(data, skills, petSkills, nil, nil, nil, force,beastSkills)
            self:ClearCurGroupItem()
            self.onFormationGroupViewClose = nil
        end
    end
end

function EmbattleController:ClearCurGroupItem()
    if self.curGroupIitem then
        self.curGroupIitem:Dispose()
        self.curGroupIitem = nil
    end
end

---编队队伍编辑回调
---@param data table 布阵数据
---@param skills table 布阵合击技
function EmbattleController:OnGroupEditCall(data, skills, isSave,beasts)
    if isSave then
        self.curGroupIitem:InitEmbattleData(data, self.curEditGroupIndex)
        self.curGroupIitem:SetPetSkillData(skills, self.curEditGroupIndex)
        if _G.AppSetting.IsXzns then
            self.curGroupIitem:SetBeastSkillData(beasts, self.curEditGroupIndex)
        end
        local sits = {}
        for i = 1, #data do
            sits[i] = data[i].uid
        end
        local combines = self.curGroupIitem:GetCombSkillData(self.curEditGroupIndex)
        local combine = {}
        for i = 1, #combines do
            combine[i] = combines[i].id
        end
        self:UpdatePreFormation(
            self.curEditGroupType,
            self.curEditGroupIndex,
            sits,
            combine,
            skills,
            function()
                local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleFormationGroupView.Name)
                view:Show()
                view:UpdateGroup(self.curEditGroupIndex)
            end,
            beasts
        )
        -- self.curGroupIitem:SaveEmbattle(
        --     function()
        --         local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleFormationGroupView.Name)
        --         view:Show()
        --         view:UpdateGroup(self.curEditGroupIndex)
        --     end
        -- )
    else
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleFormationGroupView.Name)
        view:Show()
    end
end

function EmbattleController:OnGroupClear(group, index, call)
    self:DelPreFormation(
        group,
        index,
        function()
            self.curGroupIitem:ClearEmbattle(index)
            if call then
                call()
            end
        end
    )
end

