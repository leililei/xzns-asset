local base = require("BaseGameNet")
---@class EmbattleNet : BaseGameNet	通信协议
local EmbattleNet = _G.BaseClass("EmbattleNet", base)

---@return EmbattleNet EmbattleNet
function EmbattleNet:GetInstance()
    return base.GetInstance(self)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function EmbattleNet:Callback(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

function EmbattleNet:GetAllEmbattleInfo(callback)
    local item = _G.ConfigManager.net_map.game_garray_port_get_garray
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end
---更新布阵数据
---@param id table 布阵id组
---@param uids table 布阵卡牌uid数组{{uid,uid,uid,uid,uid},{uid,uid,uid,uid,uid}}
---@param callback function 消息回调
---@param skills table 合击技数组{{0，0，0}}
---@param pets table 宠物数组{{0，0}}
function EmbattleNet:UpdateEmbattle(id, uids, callback, skills, pets,beasts)
    local item = _G.ConfigManager.net_map.game_garray_port_update_garray
    local data = {garray = {}}
    for i = 1, #id do
        --TODO: 合击技暂时默认写0
        if _G.AppSetting.IsXzns then
            data.garray[i] = {id = id[i], sits = uids[i], skill_index = skills[i], pet = pets and pets[i] or { 0, 0, 0 },beast = beasts and beasts[i] or { 0, 0, 0 }}
        else
            data.garray[i] = {id = id[i], sits = uids[i], skill_index = skills[i], pet = pets and pets[i] or { 0, 0, 0 }}
        end
    end
    local port = base.Access(self, item, data, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

