function EmbattleNewView:GetPetCount()
    local count = { 0, 0, 0 }
    local cfg = _G.ConfigManager.pet_cfg
    local pets = require("PetModel"):GetInstance():GetAllActivePets()
    for _, v in pairs(pets) do
        count[v.cfg.professional] = count[v.cfg.professional] + 1
    end
    for i = 1, self.curEmbattleItem:GetEmbattleTypeCount() do
        local petIds = self.curEmbattleItem:GetPetSkillData(i) or {}
        if #petIds ~= 0 then
            for j = 1, #petIds do
                if petIds[j] ~= 0 then
                    local profess = cfg[petIds[j]].professional
                    if i == self.curEmbattleIndex then
                        count[profess] = 0
                    elseif count[profess] > 0 then
                        count[profess] = count[profess] - 1
                    else
                        count[profess] = 0
                    end
                end
            end
        end
    end
    return count
end

function EmbattleNewView:GetBeastCount()
    local beasts = require("BeastModel"):GetInstance():GetAllActiveBeasts()
    return #beasts
end

