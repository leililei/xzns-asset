                                            _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
                                    )
                                    local win = { 0 }
                                    local fightb = {}
                                    fightb = msg.fight_arg
                                    _G.UIManager:GetInstance():OpenWindow(
                                            _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
                                            { [1] = curStatisticsData },
                                            win,
                                            function()
                                                self.onBtnFuncRun = false
                                            end,
                                            nil,
                                            nil,
                                            1,
                                            true,
                                            fightb,
                                            nil,
                                            nil,
                                            nil,
                                            nil,
                                            nil,
                                            nil,
                                            nil,
