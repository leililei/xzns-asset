        self.onAnimatorDoneTimer = nil
    end
    self.curEmbattleItem = nil
    self.curEmbattleIndex = nil
    self.cacheCardSids = nil
end

---按钮点击事件在这里派发
function EmbattleNewView:OnClickBtn(go, isOn)
    if self.onBtnFuncRun then
        return
    end
    self.onBtnFuncRun = true
    if go == self.go_table.aorbtn_mine then
        -- 打开羁绊界面
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        local eleID, goldID = self.curEmbattleItem:CheckMyShackle(self.curEmbattleIndex)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EmbattleShackleWindowView.Name, eleID, goldID)
    elseif go == self.go_table.aorbtn_enemy then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        local eleID, goldID = self.curEmbattleItem:CheckEnemyShackle(self.curEmbattleIndex)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EmbattleShackleWindowView.Name, eleID, goldID)
    elseif go == self.go_table.aorbtn_autoLeft then
        self:kaiguanbut()
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_CloseView then
        if self.onCardListHideCall then
            --退出编队预设
            self:OnFormationGroupEditEnd(false)
            return
        end
        -- 退出布阵
        if self.isRecommend then
            self:BackEmbattle()
            self.onBtnFuncRun = false
        else
            if self.onQuitCallback then
                self.onQuitCallback(
                        function(quit)
                            if quit then
                                self:QuitEmbattle()
                            end
                            self.onBtnFuncRun = false
                        end
                )
            else
                self:QuitEmbattle()
            end
        end
    elseif go == self.go_table.aorbtn_formation then
        -- 编队
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        local type, extra = self.curEmbattleItem:GetGroupType()
        local max = self.curEmbattleItem:GetMaxPutNum()
        -- if self.curEmbattleItem.sociatyEmbattle then
        --     EmbattleController:GetInstance():OpenSociatyBattleFormation(_G.handler(self, self.OnGroupChoose), extra)
        -- else
        local fgType
        if max == 0 or max == 5 then
            fgType = _G.FormationGroupType.Five
        else
            fgType = _G.FormationGroupType.Three
        end
        EmbattleController:GetInstance():OpenFormation(_G.handler(self, self.OnGroupChoose), type, fgType, self.curEmbattleItem, self.curEmbattleIndex, extra)
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_ForceBattle then
        -- 强制战斗
        _G.PopWindowManager:GetInstance():ShowAllTips(110107)
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_battle then
        if self.onCardListHideCall then
            self:OnFormationGroupEditEnd(true)
            return
        end
        -- 战斗
        local PopWindowManager = _G.PopWindowManager:GetInstance()
        local battle, index, noTip = self.curEmbattleItem:CheckBattle()
        local confirmTips = self.curEmbattleItem.confirmTips
        if not battle then
            -- 不能出战
            if not noTip then
                PopWindowManager:ShowAllTips(140107)
            end
            if index then
                self:ChangeGroupShow(index)
            end
            self.onBtnFuncRun = false
            return
        end
        if confirmTips then
            local nowtime = _G.TimeUtil.GetServerUnixTime()
            local todayTime = _G.TimeUtil.GetDayBySix(nowtime)
            local cancel = function()
                self.onBtnFuncRun = false
            end
            _G.handler(self, self.OnBattleClick)
            _G.PopWindowManager:GetInstance():ShowAllTips(confirmTips, nil, function(isChoose)
                self:OnBattleClick()
                if isChoose then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RelicTeamDebuffTips, todayTime)
                end
            end,
                    cancel)
        else
            self:OnBattleClick()
        end
        --self:OnBattleClick()
    elseif go == self.go_table.aorbtn_choose then
        -- 布阵
        self:ShowCardList()
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_recommend then
        self:RemoveListener(_G.eBattleState.RecordStart, self.OnRecordStart)
        self:AddListener(_G.eBattleState.RecordStart, self.OnRecordStart)
        local mgpID = self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)
        self.curEmbattleItem:GetRecommend(
                function(data)
                    _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.EmbattleGrounpRecommendView.Name,
                            data,
                            function(index, data, call)
