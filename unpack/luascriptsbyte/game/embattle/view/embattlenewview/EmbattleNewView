---工具类定义
local utils = {
    ---寻找模型挂点
    ---@param trans UnityEngine.Transform
    ---@param forceUpdate? boolean   是否立即更新骨骼位置
    ---@return UnityEngine.Transform
    findModelPoint = function(trans, forceUpdate)
        local rp = trans:GetComponentInChildrenE(_G.typeof(_G.CS.SkeletonBoneReferences))
        if not rp then
            return nil
        end
        local node = rp:Get("Point_Hp")
        if not _G.IsNil(node) then
            rp:ForceUpdate(1) --立即同步一次骨骼位置
            return node
        end
        local node = rp:Get("Point_Head")
        if not _G.IsNil(node) then
            rp:ForceUpdate(1) --立即同步一次骨骼位置
            return node
        end
        return nil
    end,
    ---播放模型的stand2动画(如果有)
    ---@param trans UnityEngine.Transform
    playModelStand2 = function(trans)
        local animator = trans:GetComponentInChildrenE(_G.typeof(_G.CS.UnityEngine.Animator))
        if _G.IsNil(animator) then
            return
        end
        animator:Play("stand_2", true)
    end,
    ---获取相机俯视角度
    ---@return number
    getCameraAngleX = function()
        ---@type UnityEngine.Camera
        local mainCamera
        if _G.CS.FrameWork.Graphic.GraphicsManager.Instance then
            mainCamera = _G.CS.FrameWork.Graphic.GraphicsManager.Instance.MainCamera
        end
        return _G.CS.CameraUtils.GetCameraAngleX(mainCamera)
    end,
    ---获取相机控制组件
    ---@param go UnityEngine.Obejct
    ---@return CS.CameraMovement
    getCameraMovement = function(go)
        local component = go:GetComponentE(_G.typeof(_G.CS.CameraMovement))
        if _G.IsNil(component) then
            component = go:AddComponentE(_G.typeof(_G.CS.CameraMovement))
        end
        return component
    end,
    ---数值大小比较
    ---@param x number
    ---@param y number
    ---@return number   -1: x小于y, 0: x等于y, 1:x大于y
    compareNumber = function(x, y)
        return x == y and 0 or x < y and -1 or 1
    end,
    ---寻找合适的镜头
    ---@param sceneTrans UnityEngine.Transform 场景根节点
    ---@param isUnlock boolean 是否是解锁圣兽状态
    ---@return FrameWork.Graphic.VisualCamera
    findCamera = function(sceneTrans, isUnlock)
        local camera1 = sceneTrans:FindE("Environment/Parent/Main Camera")
        local camera2 = sceneTrans:FindE("Environment/Parent2/Main Camera")
        if not _G.IsNil(camera2) then
            camera2:SetActiveE(isUnlock and 0 or 1)
        else
            camera2 = nil
        end
        if not _G.IsNil(camera1) then
            camera1:SetActiveE((isUnlock or not camera2) and 1 or 0) --如果Main Camera2相机不存在, 继续使用Main Camera
        else
            camera1 = nil
        end
        local node = not isUnlock and camera2 or camera1
        return node:GetComponentE(
                _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
        )
    end
}

