                --检测宠物数据
                if empty[index] == nil then
                    local petSkillUnlock = self.curEmbattleItem:GetPetSkillState()
                    if not petSkillUnlock[1] then
                    else
                        local curPetSkills = self.curEmbattleItem:GetPetSkillData(index) or {}
