function EmbattleNewView:OnCardItemCall(index, obj)
    local id = obj:GetInstanceID()
    local item = self.cardItemList[id]
    if not item then
        item = EmbattleViewCardItem.New(
                obj,
                _G.handler(self, self.OnCardClick),
                _G.handler(self, self.OnCardDragBegin),
                _G.handler(self, self.OnCardDrag),
                _G.handler(self, self.OnCardDragEnd)
        )
        self.cardItemList[id] = item
    end
    index = index + 1
    ---引导要求路径给于索引区别
    if _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing then
        obj:SetName(index)
    end
    --LogError(index)
    local i, tag, sameIndex = self:GetCardIndexAndTag(index, true)
    local editTag
    if self.isEdit and tag ~= EmbattleState.Embattle and tag ~= EmbattleState.None and tag ~= EmbattleState.Same then
        tag = EmbattleState.None
    end
    if self.isEdit then
        if EmbattleController:GetInstance():CheckCardInOtherGroupIndexFormationByUid(self.cardList[i].uid) then
            editTag = 1
        end
    end
    local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.cardList[i].uid)
    local skin

    if caradata and caradata.skin ~= 0 then
        skin = caradata.skin
    else
        skin = 0
    end
    local EmbattleIs = self:Recommend(skin)
    self.cardList[i].skinIs = EmbattleIs
    item:Show(index, self.cardList[i], tag, sameIndex, nil, not self.curEmbattleItem.notShowMySoulAndTalents, editTag)

    local gray, tips = self.curEmbattleItem:GetCardGrayAndTips(self.cardList[i].uid)
    item:SetGray(gray, tips)
end

