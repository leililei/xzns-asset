function EmbattleNewView:ShowPetSkills()
    local model = require("PetModel"):GetInstance()
    local petIds = self.curEmbattleItem:GetPetSkillData(self.curEmbattleIndex) or {}
    local count = self:GetPetCount()
    if not self.isRecommend then
        self.go_table.obj_petSkills:SetActiveE(self.petSkillUnlock[1] and 1 or 0)
        if not self.petSkillUnlock[1] then
            return
        end

        for index, item in ipairs(self.petSkillItems) do
            if not self.petSkillUnlock[index] then
                local str = self.curEmbattleItem:GetPetSkillUnlockCondition(index)
                self:ShowPetSkillItem(item, false, str)
                item.obj_redpoint:SetActiveE(0)
            else
                local petData = petIds[index] and petIds[index] > 1 and model:GetPet(petIds[index]) or nil
                self:ShowPetSkillItem(item, petData)
                item.obj_redpoint:SetActiveE(
                        not petData and self.curEmbattleItem:CheckPetSkillEquip(index, count) and 1 or 0
                )
            end
        end
    else
        local cardIds = self.curEmbattleItem:GetPetSkillData(self.curEmbattleIndex) or {}
        local allDiable = true
        --通关录影数据(此处存储的是card_skil_cfg.id, 可反推宠物及其星级)
        self.go_table.obj_petSkills:SetActiveE(1)
        for index, item in ipairs(self.petSkillItems) do
            local cardId = cardIds[index] or 0
            if cardId ~= 1 then
                allDiable = false
            end
            local cfg, star = model:GetPetByCardSkillId(cardId)
            local petData
            if cfg then
                petData = require("PetData").New(cfg.id)
                petData.star = star
            end
            self:ShowPetSkillItem(item, petData)
            item.obj_redpoint:SetActiveE(0)
        end

        self.go_table.obj_petSkills:SetActiveE(allDiable and 0 or 1)
    end
end

