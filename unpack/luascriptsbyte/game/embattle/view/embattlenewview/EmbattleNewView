    if self:IsNil() then
        return
    end
    local cardData = self.contactFuncList[1]
    local path = "UIH5/Card/$_obj_contactPopView"
    --local obj = _G.InstantiateObject(self.go_table.obj_contactPopView, self.go_table.obj_contactRoot)
    _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.UIItem,
            self.go_table.obj_contactRoot,
            function(tran)
                if self:IsNil() then
                    tran:DestroyObject()
                    return
                end
                tran:SetLocalPositionToZero()
                tran:SetLocalScaleXYZ(1)
                self.lua_Contact = self:AddComponent(
