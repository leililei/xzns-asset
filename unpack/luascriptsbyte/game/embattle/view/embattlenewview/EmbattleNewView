                    _G.GameUtil.NumberToUnitWord(MonsterCfg.Power))
            local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card,
                    self.modelDataArray[index].uid)
            local skin

            if caradata and caradata.skin ~= 0 then
                skin = caradata.skin
            else
                skin = 0
            end
            local Cardcfg = require "CardCommentManager":GetInstance():CardData(MonsterCfg.CardID, self:Recommend(skin))
            local cfg = _G.ConfigManager.type_professional_cfg[Cardcfg.Professional]
            self.go_table_tips.aortext_profession.text = TryGetLangValue(cfg.name)
            setsprite(self.go_table_tips.aorimage_profession, cfg.icon2)
