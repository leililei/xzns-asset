---使用编队后，更换所有模型
---@param enemy boolean 是否刷新敌方
function EmbattleNewView:UpdateAllModel(enemy)
    local monsterCfgs = _G.ConfigManager.monster_cfg

    local card, cardData
    local IsNil = _G.IsNil
    self.modelIndex = 1
    local function handleCard(cards)
        for i = 1, #cards do
            self:ClearModelCall(i + self.updateModelCount)
            card = self.modelDataArray[i + self.updateModelCount]

            if card then
                if cards[i].sid > 0 then
                    -- 新模型
                    local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cards[i].uid)
                    local skin

                    if caradata and caradata.skin ~= 0 then
                        skin = caradata.skin
                    elseif cards[i].skin ~= 0 then
                        skin = cards[i].skin
                    else
                        skin = 0
                    end
                    card.sid = cards[i].sid
                    card.path = require "CardInfoManager".GetBattleModelPath(cards[i].sid, self:Recommend(skin))
                    card.lv = cards[i].level
                    card.uid = cards[i].uid
                    card.star = cards[i].star
                    card.scale = cards[i].scale or 1
                    cardData = self.curEmbattleItem:GetCardData(cards[i].uid)
                    if cardData then
                        card.soulLinkLv = (cardData.soulLink_IsActivate and cardData.soulLink_IsActivate == 1) and
                                cardData.soulLink_lv or
                                -1
                        card.talents = cardData.open_inborn
                    else
                        card.soulLinkLv = (cards[i].soulLink_IsActivate and cards[i].soulLink_IsActivate == 1) and
                                cards[i].soulLink_lv or
                                -1
                        card.talents = cards[i].open_inborn
                    end
                else
                    card.sid = 0
                    card.path = nil
                    card.lv = 0
                    card.uid = 0
                    card.star = 0
                    card.soulLinkLv = -1
                    card.talents = nil
                end
            end
        end
    end
    local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)

    self.updateModelCount = 0
    handleCard(data)
    if _G.AppSetting.IsXzns then
        self:ClearBeastModelCall()
    end
    self.updateModelCount = #data
    if enemy then
        data = self.curEmbattleItem:GetEnemyEmbattleData(self.curEmbattleIndex)
        handleCard(data)
        self.updateModelCount = self.updateModelCount + #data
    end
    if self.modelIndex > 0 then
        self.onUpdateAllModelHandler = _G.handler(self, self.OnUpdateAllModelCall)
        self:CreateModelCall(self.modelIndex, self.onUpdateAllModelHandler, true)
    else
        self.updateModelCount = 0
        self.onBtnFuncRun = false
    end
end

function EmbattleNewView:OnUpdateAllModelCall(tran)
    if tran then
        self:SetModelData(tran)
    end
    for i = self.modelIndex + 1, self.updateModelCount do
        self.modelIndex = i
        self:CreateModelCall(self.modelIndex, self.onUpdateAllModelHandler, true)
        return
    end
    if _G.AppSetting.IsXzns then
        local data = self.curEmbattleItem:GetBeastSkillData(self.curEmbattleIndex)
        self:ChangeBeastModel(data and data[1] or 0)
    end
    self.modelIndex = 0
    self.updateModelCount = 0
    self.onUpdateAllModelHandler = nil
    self.onBtnFuncRun = false
end

---更新布阵位置
function EmbattleNewView:UpdateScenePos()
    local mgpID = self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)
    local cfg = _G.ConfigManager.monster_group_cfg[mgpID]
    if not cfg then
        return
    end
    self.centerPos = cfg.FightAreaPos
    cfg = _G.ConfigManager.pos_cfg[cfg.pos]
    for i = 1, #self.attackPos do
        self.attackPos[i][1] = cfg.AttackerPos[i][1] + self.centerPos[1]
        self.attackPos[i][2] = cfg.AttackerPos[i][2] + self.centerPos[2]
        self.attackPos[i][3] = cfg.AttackerPos[i][3] + self.centerPos[3]
    end
    for i = 1, #self.defencePos do
        self.defencePos[i][1] = cfg.DefenserPos[i][1] + self.centerPos[1]
        self.defencePos[i][2] = cfg.DefenserPos[i][2] + self.centerPos[2]
        self.defencePos[i][3] = cfg.DefenserPos[i][3] + self.centerPos[3]
    end
    if not _G.AppSetting.IsXzns then
        self.sceneRoot:SetPosition(self.centerPos[1], self.centerPos[2], self.centerPos[3])
    end
end

