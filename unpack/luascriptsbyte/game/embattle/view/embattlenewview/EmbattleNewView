---@param 变量名 变量类型 中文描述
function EmbattleNewView:ShowShackleImage(eleID, goldID, image, items)
    local cfgs = _G.ConfigManager.formation_cfg
    local goldCfg, eleCfg
    if eleID == 0 then
        -- 没有激活五行羁绊
        image.SpriteName = "ui_ydsm_pic_sz07"
    else
        eleCfg = cfgs[eleID]
        image.SpriteName = eleCfg.icon
    end
    for i = 1, #items do
        items[i]:SetActiveE(0)
    end
    if goldID > 0 then
        -- 没有激活神羁绊
        goldCfg = cfgs[goldID]
        local pos = specialShackleItemShow[goldCfg.type_level]
        if not eleCfg then
            -- 没有激活五行羁绊
            for i = 1, #pos do
                items[pos[i]]:SetActiveE(1)
            end
        else
            local count = #eleCfg.empty
            if count > #pos then
                count = #pos
            end
            for i = 1, count do
                items[eleCfg.empty[i]]:SetActiveE(1)
            end
        end
    end
end

