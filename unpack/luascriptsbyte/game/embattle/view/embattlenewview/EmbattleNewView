---点击合击技
function EmbattleNewView:ClickCombSkillBtn(index)
    if not self.combSkillUnLock[index] then
        local _, type, param = EmbattleModel:GetInstance():GetSkillPosUnLockParam(index)
        if type == 4 and param > 0 then
            --冒险关卡
            local afkCfg = _G.ConfigManager.afk_cfg[param]
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    140116,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    afkCfg.chapter,
                    afkCfg.section
            )
        elseif type == 50 then
            --服务器时间开启
            local remainTime = param * 86400 - _G.PlayerModel:GetInstance():GetServerOpenDuration()
            if remainTime > 0 then
                ---@type number
                local tip
                if remainTime >= 86400 then
                    tip = 1000103 --X天后解锁
                    remainTime = math.max(1, math.floor(remainTime / 86400))
                else
                    tip = 1000104 --X小时后解锁
                    remainTime = math.max(1, math.ceil(remainTime / 3600))
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(tip, nil, nil, nil, nil, nil, remainTime)
            end
        end
        self.onBtnFuncRun = false
        return
    end
    if self.isRecommend then
        self.onBtnFuncRun = false
        return
    end
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.EmbattleCombineSkillView.Name,
            self.curEmbattleCombSkillData,
            _G.handler(self, self.OnCombSkillViewCloseCall),
            self.curEmbattleItem:GetOtherGroupSkillData(self.curEmbattleIndex),
            self.curEmbattleItem:OtherGroupSkillListNew(self.curEmbattleIndex),
            self.curEmbattleItem:GetCombineSkillState(self.curEmbattleIndex),
            index
    )
end

---显示合击技
function EmbattleNewView:ShowCombSkill()
    -- if not self.combSkillUnLock[1] then
    --     return
    -- end
    local cfg, lv, id
    local ConfigManager = _G.ConfigManager
    for i = 1, #self.curEmbattleCombSkillData do
        if self.combSkillUnLock[i] then
            self.skillItems[i].lock:SetActiveE(0)
            if self.curEmbattleCombSkillData[i].id > 0 then
                self.skillItems[i].go:SetActiveE(1)

                cfg = ConfigManager.card_skills_cfg[self.curEmbattleCombSkillData[i].cskillID]
                self.skillItems[i].icon:LoadImage(
                        cfg.icon,
                        function(rawimage)
                            rawimage:SetNativeSize()
                            rawimage:SetRectTransformSize(50, 50)
                        end
                )
                cfg = ConfigManager.battle_skill_cfg[cfg.skills[1]]
                self.skillItems[i].typeObj:SetActiveE(1)
                self.skillItems[i].typeText.text = ConfigManager.language_package_cfg[cfg.Brief]
                self.skillItems[i].redpoint:SetActiveE(0)
            else
                self.skillItems[i].go:SetActiveE(0)
                self.skillItems[i].typeObj:SetActiveE(0)
                _G.GameUtil.SetActiveByCondition(
                        self.skillItems[i].redpoint,
                        self.curEmbattleItem:CheckCombineSkillEquip(i, self.curEmbattleIndex)
                )
            end
        else
            self.skillItems[i].go:SetActiveE(0)
            self.skillItems[i].lock:SetActiveE(1)
            self.skillItems[i].redpoint:SetActiveE(0)
            self.skillItems[i].typeObj:SetActiveE(0)
            local str = self.curEmbattleItem:GetCombineSkillUnLockCondition(i, self.curEmbattleIndex)
            if not _G.string.IsNullOrEmpty(str) then
                self.skillItems[i].condition:SetActiveE(1)
                self.skillItems[i].condition.text = str
            else
                self.skillItems[i].condition:SetActiveE(0)
            end
        end
    end
    self:ShowEnemyCombSkill()
end

