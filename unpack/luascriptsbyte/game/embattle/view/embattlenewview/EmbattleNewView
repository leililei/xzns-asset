---打开宠物上阵面板
---@param index number
function EmbattleNewView:ClickBtnPetSkill(index)
    if not self.petSkillUnlock[index] then
        local text, tipSid = self.curEmbattleItem:GetPetSkillUnlockCondition(index)
        if text or tipSid then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipSid, text)
        end
        self.onBtnFuncRun = false
        return
    end

    local curPetSkills = self.curEmbattleItem:GetPetSkillData(self.curEmbattleIndex) or {}
    ---@type number[]
    local disablePets = self.isEdit and {} or self.curEmbattleItem:GetOtherGroupPetSkillData(self.curEmbattleIndex)
    ---@type PetData[]
    local allPets = require("PetModel"):GetInstance():GetAllActivePets()

    ---获取一个未被使用的type
    ---@param preferentialType number 优先类型
    ---@return number @返回0表示无可用类型
    local function getFreeType(preferentialType)
        ---@type table<number,boolean>
        local allTypes = {}
        --所有可用类型
        for _, v in pairs(allPets) do
            allTypes[v.cfg.professional] = true
        end
        --已经穿戴的类型
        for _, sid in pairs(curPetSkills) do
            local cfg = _G.ConfigManager.pet_cfg[sid]
            if cfg then
                allTypes[cfg.professional] = false
            end
        end
        if preferentialType and allTypes[preferentialType] then
            return preferentialType
        end
        for type = 1, 3 do
            if allTypes[type] then
                return type
            end
        end
        return 0
    end

    ---获取空闲槽位
    ---@return number @返回0表示无可用槽位
    local function getFreeEquipIndex()
        for index, _ in ipairs(self.petSkillItems) do
            if not self.petSkillUnlock[index] then
                break
            end
            if not curPetSkills[index] or curPetSkills[index] == 0 then
                return index
            end
        end
        return 0
    end

    local type = getFreeType(index)
    --没有取到空闲类型或当前槽位已有宠物(选中类型1或当前槽位类型)
    if type == 0 or curPetSkills[index] and curPetSkills[index] > 0 then
        local curPetId = curPetSkills[index]
        local curPetCfg = curPetId and curPetId > 0 and _G.ConfigManager.pet_cfg[curPetId]
        if curPetCfg then
            type = curPetCfg.professional
        else
            type = 1
        end
    end
    --自动切换宠物槽位和类型
    local autoSwicthPet = true

    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.EmbattlePetSkillView.Name,
            curPetSkills,
            disablePets,
            allPets,
            type,
            index,
            function(typeIndex, sid, isReplace)
                curPetSkills[typeIndex] = sid
                self.curEmbattleItem:SetPetSkillData(curPetSkills, self.curEmbattleIndex)
                self:ShowPetSkills()
                self:UpdatePetGroupStates()

                --交换或下阵不需要自动切换
                if isReplace or not autoSwicthPet or not sid or sid == 0 then
                    return
                end
                ---有空闲槽位和空闲类型时, 切换槽位和类型
                local freeEquipIndex = getFreeEquipIndex()
                local freeType = getFreeType(freeEquipIndex)
                if freeEquipIndex > 0 and freeType > 0 then
                    ---@type EmbattlePetSkillView
                    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattlePetSkillView.Name)
                    if view then
                        view:SetCurrentEquipIndex(freeEquipIndex)
                        view:SetCurrentType(freeType)
                    end
                else
                    --autoSwicthPet = false --没有空闲槽位或空闲类型时, 关闭自动切换
                end
            end,
            self.petSkillUnlock
    )
end

