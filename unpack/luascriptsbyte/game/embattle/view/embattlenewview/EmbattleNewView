        self:ShowBattleEmbattleStatistics()
    elseif go == self.go_table.aorbtn_record then
        self:ShowRecordBattle()
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_arrayReplace then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.GeatherSoulArrayEmbattleFastView.Name,
                self.curEmbattleItem,
                self.curEmbattleIndex,
                _G.handler(self, self.ShowAllPower)
        )
    elseif go == self.go_table.aorbtn_change then
        self.groupState, self.groupTipsID = self.curEmbattleItem:GetGroupState()
        local embattleItem = self.curEmbattleItem
        local combSkill = embattleItem:GetCombSkillData()

        local petSkill = embattleItem:GetAllPetSkillData()
        local beastSkill
        if _G.AppSetting.IsXzns then
            beastSkill = embattleItem:GetAllBeastSkillData()
        end

        local ememyPetSkill = embattleItem:GetAllEnemyPetSkillData()
        local ememyBeastSkill
        if _G.AppSetting.IsXzns then
            ememyBeastSkill = embattleItem:GetAllEnemyBeastSkillData()
        end
        local ememyCombSkill = embattleItem:GetAllEnemyCombineSkillData(true)
        --兼容之前的逻辑
        if _G.table.isEmptyOrNil(ememyCombSkill) then
            ememyCombSkill = embattleItem:GetEnemyCombSkillData()
        end
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonChallengeTeamView.Name,
                _G.handler(self, self.OnChangeTeamCall),
                embattleItem:GetAllEmbattleData(),
                combSkill,
                petSkill,
                beastSkill,
                embattleItem:GetAllEnemyEmbattleData(),
                ememyCombSkill,
                ememyPetSkill,
                ememyBeastSkill,
                embattleItem.__cname,
                self.groupState,
                self.enemyInfo
        )
        --end
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_auto then
        --一键上阵
        local isChange = false
        --记录玩家当前上阵的卡牌
        local embattleCardUids = {}
        local embattleData = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
        if embattleData then
            for _, card in pairs(embattleData) do
                embattleCardUids[card.uid] = true
            end
        end
        self.curEmbattleItem:ClearEmbattle(self.curEmbattleIndex)
        local cardList = _G.table.chooseToArray(self.cardList, function(k, v)
            --助战卡不要自动上阵(玩家手动上阵除外)
            if v.type == _G.CardType.Timer and not embattleCardUids[v.uid] then
                return false
            end
            return self.curEmbattleItem:GetCardHPPer(v.uid, self.curEmbattleIndex) > 0
        end)
        local data, newEmbattleData = self.curEmbattleItem:GetAutoEmbattleData(cardList, self.curEmbattleIndex)

        if _G.AppSetting.IsXzns and self.onCardListHideCall then
            for i, v in pairs(newEmbattleData) do
                if v.uid ~= data[i].uid and v.sid ~= v.uid then
                    if self.curEmbattleItem:SetEmbattleDataSingle(i, v.uid, self.curEmbattleIndex) then
                        isChange = true
                        self:ShowCardContact(v)
                    end
                end
            end
        else
            for i, v in pairs(newEmbattleData) do
                if v.uid ~= data[i].uid then
                    if self.curEmbattleItem:SetEmbattleDataSingle(i, v.uid, self.curEmbattleIndex) then
                        isChange = true
                        self:ShowCardContact(v)
                    end
                end
            end
        end

        if isChange then
            self:UpdateCardList()
        end
        --尝试上阵合击技
        local combineSkills = require("CombineModel"):GetInstance():GetUnLockCombine()
        if not _G.table.isEmptyOrNil(combineSkills) then
            local otherSkills = self.curEmbattleItem:GetOtherGroupSkillData(self.curEmbattleIndex) or {}
            for index = 1, #self.curEmbattleCombSkillData do
                --技能已解锁且未上阵技能
                if
                self.combSkillUnLock[index] and
                        (not self.curEmbattleCombSkillData[index] or self.curEmbattleCombSkillData[index].id <= 0)
                then
                    for sid, lv in pairs(combineSkills) do
                        if not otherSkills[sid] and _G.ConfigManager.combine_cfg[sid].classify == index then
                            --上阵合击技
                            self.curEmbattleCombSkillData[index].id = sid
                            self.curEmbattleCombSkillData[index].lv = lv
                            self.curEmbattleCombSkillData[index].cskillID = _G.ConfigManager.combine_cfg[sid].skills[lv]
                            self.curEmbattleItem:SetCombSkillData(self.curEmbattleCombSkillData, self.curEmbattleIndex)
                            isChange = true
                        end
                    end
                end
            end
        end

        ---自动上阵宠物: 战力>星级>品质>sid
        local disablePets = self.curEmbattleItem:GetOtherGroupPetSkillData(self.curEmbattleIndex)
        local allPets = require("PetModel"):GetInstance():GetAllActivePets()
        local availablePets = _G.table.chooseToArray(
                allPets,
                function(k, v)
                    if _G.table.ContainsValue(disablePets, v.sid) then
                        return false
                    end
                    v:CalculatePower()
                    return true
                end
        )

        --获取当前已穿戴的宠物及其类型
        ---@type number[]
        local curPetSkills = { 0, 0, 0 }
        local curPetTypes = {} --已穿戴的类型
        for index, item in ipairs(self.petSkillItems) do
            if self.petSkillUnlock[index] and item.data then
                curPetSkills[index] = item.data.cfg.id
                curPetTypes[item.data.cfg.professional] = true
            else
                curPetSkills[index] = 0
            end
        end

        ---获取剩余可穿戴类型的宠物
        local petTypeDic = {}
        local petData
        for _, v in pairs(availablePets) do
            if not curPetTypes[v.cfg.professional] then
                if not petTypeDic[v.cfg.professional] then
                    petTypeDic[v.cfg.professional] = v
                else
                    petData = petTypeDic[v.cfg.professional]
                    --依次比较: 战力>星级>品质>sid
                    local flag = utils.compareNumber(v.star, petData.star)
                    if flag == 0 then
                        flag = utils.compareNumber(v:GetOrder(), petData:GetOrder())
                    end
                    if flag == 0 then
                        flag = utils.compareNumber(v.sid, petData.sid)
                    end
                    if flag > 0 then
                        petTypeDic[v.cfg.professional] = v
                    end
                end
            end
        end

        petTypeDic = _G.table.toArray(petTypeDic)
        _G.SortList(
                petTypeDic,
                function(a)
                    return a.star, a:GetOrder(), a.sid
                end
        )
        --槽位未穿戴宠物时, 才进行上阵
        for i = 1, #self.petSkillUnlock do
            if self.petSkillUnlock[i] then
                if not curPetSkills[i] or curPetSkills[i] <= 0 then
                    petData = _G.table.remove(petTypeDic, 1)
                    if petData then
                        curPetSkills[i] = petData.sid
                    else
                        break
                    end
                end
            else
                curPetSkills[i] = 0
            end
        end
        self.curEmbattleItem:SetPetSkillData(curPetSkills, self.curEmbattleIndex)
        self:ShowPetSkills()
        self:UpdatePetGroupStates()

        if _G.AppSetting.IsXzns then
            local allBeast = require("BeastModel"):GetInstance():GetAllActiveBeasts()
            local disableBeasts = self.isEdit and {} or self.curEmbattleItem:GetOtherGroupBeastSkillData(self.curEmbattleIndex)
            local curBeastSkills = self.curEmbattleItem:GetBeastSkillData(self.curEmbattleIndex) or { 0, 0, 0 }
            allBeast = _G.table.chooseToArray(allBeast, function(k, v)
                if _G.table.ContainsValue(disableBeasts, v.sid) then
                    return false
                end
                if _G.table.ContainsValue(curBeastSkills, v.sid) then
                    return false
                end
                return true
            end)
            _G.SortList(
                    allBeast, function(a)
                        return a:GetOrder(), a:GetStar(), a:GetLevel(), a:GetID()
                    end
            )
            for index, v in pairs(curBeastSkills) do
                if v == 0 and self.beastSkillUnlock and self.beastSkillUnlock[index] then
                    for _, data in pairs(allBeast) do
                        local id = data:GetID()
                        if not _G.table.ContainsValue(curBeastSkills, id) and not _G.table.ContainsValue(curBeastSkills, id) then
                            -- 排除被动技能为空的圣兽上阵2，3号
                            if index == 1 or (index > 1 and data:GetSkill_2()[data:GetStar() + 1] ~= 0) then
                                curBeastSkills[index] = id
                                break
                            end
                        end
                    end
                end
            end
            self.curEmbattleItem:SetBeastSkillData(curBeastSkills, self.curEmbattleIndex)
            self:ShowBeastSkills()
            self:UpdateBeastGroupStates()
        end

        if isChange then
            self:UpdateAllModel()
            self:RefreshCardList()
            self:ShowAllPower()
            self:ShowCombSkill()
            self:ShowPetSkills()
            self:CheckStateQue()
            EmbattleController:GetInstance():OnEmbattleChange(
                    self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
            )
        end
        self.onBtnFuncRun = false
    else
        self.onBtnFuncRun = false
    end
    if go == self.go_table.toggle_skip then
        local isShowSkip = self.curEmbattleItem:GetShowSkip()
        if isShowSkip then
            if isOn then
                _G.PlayerPrefsManager.SetInt(
                        tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. self.curEmbattleItem.AttackName,
                        1
                )
            else
                _G.PlayerPrefsManager.SetInt(
                        tostring(_G.PlayerModel:GetInstance().role_uid) .. "SkipBattle" .. self.curEmbattleItem.AttackName,
                        0
                )
            end
        end
    end

    if go ~= self.go_table.aorbtn_CloseView then
        if _G.CS.Launcher.Inst.IsSDK then
            local json = _G.Table2Json(
                    {
                        role_uid = _G.tostring(_G.PlayerModel:GetInstance().role_uid),
                        role_level = _G.PlayerModel:GetInstance():GetLevel(),
                        role_vip = _G.PlayerModel:GetInstance().vipLv,
                        server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                        channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                        phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                        user_type = 1,
                        record_time = _G.TimeUtil.GetServerUnixTime(),
                        button_id = "EmbattleNewView" .. go:GetName()
                    }
            )
            if _G.AppSetting.DEBUG then
                _G.Log(json, "点击布阵场景系统按钮打点")
            end
            _G.SDKManager:GetInstance():DoShushuData_track("click_prepare_system_button", json)
        end
    end
end

