---@param tempItem EmbattleItemBase 使用临时布阵类（避免修改到当前布阵类）
function EmbattleNewView:OnGroupChoose(data, skills, petSkills, edit, call, notShackle, force, beasts)
    local canPut, tipsId = self.curEmbattleItem:CheckGroupIsPut(data)
    if tipsId and tipsId > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsId)
    end
    if not canPut then
        return
    end
    self.onCardListHideCall = call
    if edit then
        self.isEdit = true
        self.curEmbattleItem:SetTempEmbattleData(data, self.curEmbattleIndex)
        self.curEmbattleItem:SetTempCombSkillData(skills, self.curEmbattleIndex)
        self.curEmbattleItem:SetTempPetSkillData(petSkills, self.curEmbattleIndex)
        if _G.AppSetting.IsXzns then
            self.curEmbattleItem:SetTempBeastSkillData(beasts, self.curEmbattleIndex)
        end
    else
        self.curEmbattleItem:SafeSetEmbattleData(data, self.curEmbattleIndex, force)
        self.curEmbattleItem:SafeSetCombSkillData(skills, self.curEmbattleIndex, force)
        self.curEmbattleItem:SafeSetPetSkillData(petSkills, self.curEmbattleIndex, force)
        if _G.AppSetting.IsXzns then
            self.curEmbattleItem:SafeSetBeastSkillData(beasts, self.curEmbattleIndex, force)
        end
        self:CheckStateQue()
    end
    self:UpdateAllModel()
    self:RefreshCardList()
    self:ShowAllPower(nil, notShackle)
    self.curEmbattleCombSkillData = self.curEmbattleItem:GetCombSkillData(self.curEmbattleIndex)
    self.curEmbattleEnemyCombSkillData = self.curEmbattleItem:GetEnemyCombSkillData(self.curEmbattleIndex)
    self:ShowCombSkill()
    self:ShowPetSkills()
    if _G.AppSetting.IsXzns then
        self:ShowBeastSkills()
    end
    if edit then
        self.srcBattleBtnTxt = self.go_table.aortext_battle.text
        self:SetBattleBtnText(_G.GetLangPackValue(90114010161))
        if not self.go_table_card then
            self.go_table.obj_choose:SetActiveE(1)
            self:InitCardList(EmbattleController:GetInstance():GetFormationGroupCardList())
        else
            self.cardList = EmbattleController:GetInstance():GetFormationGroupCardList()
            if _G.AppSetting.IsXzns and self.cardList ~= self.curEmbattleItem:GetCardList() then
                self.cardList = self.curEmbattleItem:GetCardList()
            end
            self:UpdateCardList()
        end
        self:ShowCardList()
        self.go_table.obj_group:SetActiveE(0)
        self:ShowChangeBtn(false)
        self.go_table.aorbtn_formation:SetActiveE(0)
    end
end

