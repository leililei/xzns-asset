    ---检测是否为多队布阵
    local embattleCount = self.curEmbattleItem:GetEmbattleTypeCount()
    if embattleCount <= 1 then
        return
    end
    ---@type number[] 已胜利的队伍
    local groupDisable = nil
    if self.groupState then
        groupDisable = {}
        for i = 1, embattleCount do
            if self.groupState[i] then
                table.insert(groupDisable, i)
            end
        end
    end
    --设置多队状态
    ---@type EmbattlePetSkillView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattlePetSkillView.Name)
    if not view then
        return
    end
    view:SetChooseGroup(
