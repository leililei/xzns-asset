---更换角色模型
---@param index number 序列号
---@param data CardData 卡牌数据
---@param call function 改变模型回调
function EmbattleNewView:ChangeModel(index, data, call)
    self:ClearModelCall(index)
    local dic = self.modelDataArray[index]
    if data then
        -- 创建新的模型
        local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
        local skin

        if caradata and caradata.skin ~= 0 then
            skin = caradata.skin
        else
            skin = 0
        end
        dic.path = require "CardInfoManager".GetBattleModelPath(data.sid, self:Recommend(skin))
        dic.sid = data.sid
        dic.lv = data:GetLevel()
        dic.uid = data.uid
        dic.soulLinkLv = (data.soulLink_IsActivate and data.soulLink_IsActivate == 1) and data.soulLink_lv or -1
        dic.talents = data.open_inborn
        dic.star = data:GetStar()
        self.modelIndex = index
        self.onChangeModelCall = call
        self:CreateModelCall(index, self.setModelHandler, true)
    else
        -- 创建站位特效
        _G.PoolsManager:GetInstance():Spawn(
                StarColorPaths[1],
                _G.ePoolType.Temporary,
                self.sceneRoot,
                function(tran)
                    dic.effect = tran
                    local pos = dic.pos
                    tran:SetPosition(
                            pos[1] + ShadowPositionOffsets.x,
                            pos[2] + ShadowPositionOffsets.y,
                            pos[3] + ShadowPositionOffsets.z
                    )
                end
        )
    end
end

