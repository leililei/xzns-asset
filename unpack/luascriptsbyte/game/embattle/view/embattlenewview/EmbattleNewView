---设置模型数据
---@param tran UnityEngine.Transform 模型
---@param notitle boolean 是否不同步头顶名称
function EmbattleNewView:SetModelData(tran, notitle)
    if self.onChangeModelCall then
        self.onChangeModelCall()
        self.onChangeModelCall = nil
    end
    local dic = self.modelDataArray[self.modelIndex]
    if not dic then
        tran:DestroyObject()
        return
    end
    local data = self.curEmbattleItem:GetEnemyEmbattleData(self.curEmbattleIndex)
    local artifactDic = {}
    if not _G.table.isEmptyOrNil(data) then
        for _, v in pairs(data) do
            if v and not tonumber(v) and v.uid and v.artifact then
                artifactDic[v.uid] = v.artifact
            end
        end
    end

    if self.modelIndex < #self.modelDataArray and self.modelIndex > defaultEmbattleCount then
        -- 敌人
        tran:SetLocalScaleXYZ(dic.scale)
    else
        if dic.sid > 0 then
            local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, dic.uid)
            local skin

            if caradata and caradata.skin ~= 0 then
                skin = caradata.skin
            else
                skin = 0
            end
            local cfg = require "CardCommentManager":GetInstance():CardData(dic.sid, self:Recommend(skin))
            tran:SetLocalScaleXYZ(cfg.GlobalScale * 0.0001)
        end
    end
    dic.tran = tran
    ---获取镜头俯视角度
    local angle = utils.getCameraAngleX()
    local pos = dic.pos
    tran:SetPosition(pos[1], pos[2], pos[3])
    if pos[5] == 1 then
        tran:SetLocalEulerAngles(0, 0, angle)
    elseif pos[5] == -1 then
        tran:SetLocalEulerAngles(0, 180, -angle)
    elseif pos[4] == 1 then
        tran:SetLocalEulerAngles(0, 90, 0)
    else
        tran:SetLocalEulerAngles(0, 270, 0)
    end
    dic.path = nil
    if notitle == true then
        return
    end
    dic.head = utils.findModelPoint(tran, true)
    utils.playModelStand2(tran)

    local item = self.modelTitleTable[self.modelIndex]

    if dic.isEnemy then
        local cardData = {}
        cardData.artifact = artifactDic[dic.uid] or dic.artifact
        item:Show(dic.sid, dic.lv, dic.uid, cardData, dic.isEnemy, self.curEmbattleType)
    else
        local cardData = self.curEmbattleItem:GetCardData(dic.uid)
        item:Show(dic.sid, dic.lv, dic.uid, cardData, dic.isEnemy, self.curEmbattleType)
    end

    if not self.curEmbattleItem.notShowMySoulAndTalents and self.modelIndex <= defaultEmbattleCount then
        item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
    elseif self.curEmbattleItem.showEnemySoulAndTalents and self.modelIndex > defaultEmbattleCount then
        item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
    end
    if self.modelIndex > defaultEmbattleCount then
        item:ShowBossTag(dic.boss)
        dic.boss = nil
    end
    if not _G.IsNil(dic.head) then
        local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(dic.head, self.go_table.rect_moveRoot)
        x = x < -290 and -290 or x
        x = x > 263 and 263 or x
        item.transform:SetLocalPosition(x, y, 0)
    end
end

---创建模型回调
---@param index number 序列号
---@param call function 加载回调
---@param eff boolean 是否需要创建特效
function EmbattleNewView:CreateModelCall(index, call, eff)
    local dic = self.modelDataArray[index]
    if eff and (index <= defaultEmbattleCount or dic.sid > 0) then
        local eff, star
        star = dic.star
        if star > 0 then
            star = CardInfoManager:GetInstance():GetOrderStarCount(star) + 1
        else
            star = 1
        end
        _G.PoolsManager:GetInstance():Spawn(
                StarColorPaths[star],
                _G.ePoolType.Temporary,
                self.sceneRoot,
                function(tran)
                    dic.effect = tran
                    local pos = dic.pos
                    tran:SetPosition(
                            pos[1] + ShadowPositionOffsets.x,
                            pos[2] + ShadowPositionOffsets.y,
                            pos[3] + ShadowPositionOffsets.z
                    )
                    if dic.path then
                        self:LoadRoleModel(dic, call, index)
                    else
                        call()
                    end
                end
        )
    else
        if dic.path then
            self:LoadRoleModel(dic, call, index)
        else
            call()
        end
    end
end

function EmbattleNewView:LoadRoleModel(dic, call, index)
    local role = _G.BattleManager:GetInstance():GetCacheRole(dic.sid, index < defaultEmbattleCount)
    if role then
        role:SetParentE(self.sceneRoot)
        if dic.gray then
            self:SetModelGray(index)
            dic.gray = nil
        end
        call(role)
    else
        self.Role[index] = require("CardInfoManager").GetRole(
                dic.path,
                _G.ePoolType.Static,
                self.sceneRoot,
                _G.RoleEffTypeEnum.Fight,
                function(role)
                    if EmbattleNewView == nil then
                        self.Role[index]:Dispose()
                    end
                    utils.playModelStand2(role)
                    _G.UIUtils.LoadBattleSpineArtifact(
                        role,
                        dic.sid,
                        dic.form,
                        dic.color,
                        index > 5 --敌人
                    )
                    call(role)
                    if dic.gray then
                        self:SetModelGray(index)
                        dic.gray = nil
                    end
                end
        )
    end
end

---加载圣兽模型（目前只有我方圣兽加载逻辑）
function EmbattleNewView:LoadBeastModel()
    local dic = self.beastModelDataArray[1]
    self.Beast[1] = require("CardInfoManager").GetRole(
