---@param lockStr string
function EmbattleNewView:ShowPetSkillItem(item, data, lockStr)
    item.data = data and data or nil
    item.aorrawimage_icon:SetActiveE(data and 1 or 0)
    item.obj_type:SetActiveE(data and 1 or 0)
    item.obj_lock:SetActiveE(data == false and 1 or 0)
    if data then
        local skillIndex, maxSkillIndex = data.star + 1, #data.cfg.skill_id
        local skillId = data.cfg.skill_id
        [skillIndex < 1 and 1 or skillIndex <= maxSkillIndex and skillIndex or maxSkillIndex]
        local csc = _G.ConfigManager.card_skills_cfg[skillId]
        local bsc = csc and _G.ConfigManager.battle_skill_cfg[csc.skills[1]] or nil
        --item.aorrawimage_icon:LoadImage(data.cfg and data.cfg.Icon or "")
        item.aorrawimage_icon:LoadImage(bsc and bsc.Icon or "")
        item.aortext_type.text = bsc and _G.ConfigManager.language_package_cfg[bsc.Brief] or ""
    elseif data == false then
        item.aortext_condition.text = lockStr
    end
    local star = data and data.star or 0
    for i = 1, 5 do
        item["obj_star" .. i]:SetActiveE(star >= i and 1 or 0)
    end
    --local order = data and data.cfg.Order or 0
    --item.aorimage_bg.SpriteName = PetOrderFrame[order]
    item.obj_empty:SetActiveE(data == nil and 1 or 0)
end

