            --_G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2029)
            --self.curShowShackleActiveTipsViewTag = true
            --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EmbattleShackleView.Name)
        end
