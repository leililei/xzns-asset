function EmbattleNewView:ChangeGroupShow(index)
    if self.curEmbattleIndex == index then
        self.onBtnFuncRun = false
        return
    end
    if self.groupState and self.groupState[index] then
        self.onBtnFuncRun = false
        _G.PopWindowManager:GetInstance():ShowAllTips(self.groupTipsID)
        return
    end
    --重设父节点
    local parent = self.groupIndexBtns[index]
    self.go_table_group.trans_choose:SetParentE(parent)
    self.go_table_group.trans_choose:SetAsFirstSiblingE()
    self.go_table_group.trans_choose:SetLocalPositionToZero()
    self.curEmbattleIndex = index
    ---刷新首次失败敌方详情界面
    local mgpID = self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)
    _G.Events:GetInstance():Broadcast(_G.eEmBattleGroup.ClickEmBattleGroup, mgpID)

    self:UpdateScenePos()
    self.curEmbattleCombSkillData = self.curEmbattleItem:GetCombSkillData(index)
    self.curEmbattleEnemyCombSkillData = self.curEmbattleItem:GetEnemyCombSkillData(self.curEmbattleIndex)
    self:ShowCombSkill()
    self:ShowPetSkills()
    if _G.AppSetting.IsXzns then
        self:ShowBeastSkills()
    end
    self:ShowEnemyPetSkills()

    self:UpdateAllModel(true)
    self:RefreshCardList()
    if self.isRecommend then
        self.curEmbattleItem:GetRecordData(
                function()
                    self:ShowAllPower(true)
                end,
                self.curEmbattleIndex
        )
    else
        self:ShowAllPower(true)
    end

    if self.onChangeGroupCallback then
        self.onChangeGroupCallback(index)
    end
end

