function EmbattleNewView:OnCardClick(index, tag, sameIndex)
    if self.onBtnFuncRun then
        return
    end
    if self.onCardDragBeginTag then
        return
    end
    if self.createRoleModelTag then
        return
    end
    if tag == EmbattleState.Same then
        -- 同名角色
        _G.PopWindowManager:GetInstance():ShowAllTips(140101)
        return
    elseif tag == EmbattleState.SameInOtherGroup then
        -- 同名角色但不同组
        _G.PopWindowManager:GetInstance():ShowAllTips(140118, _G.GetLangPackValue(90114010127, sameIndex))
        return
    elseif tag == EmbattleState.Full then
        --上阵已满
        _G.PopWindowManager:GetInstance():ShowAllTips(310109)
        return
    elseif tag == EmbattleState.Dead then
        --死亡角色
        return
    elseif tag == EmbattleState.Embattle then
        -- 下阵
        local uid = self.cardList[
        self            .embattleCardIndexes[
        index - #self.otherAssistCardIndexs - #self.unPutassistCardIndexes - #self.fullPutassistCardIndexes
        ]
        ]               .uid
        local flag, num = self.curEmbattleItem:CheckCardHandle(uid)
        if not flag then
            if num then
                if num ~= 0 then
                    return
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(140117)
                return
            end
        end
        local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
        for i = 1, #data do
            if data[i].uid == uid then
                if self.curEmbattleItem:SetEmbattleDataSingle(i, uid, self.curEmbattleIndex) then
                    self:ChangeModel(i)
                    self:RefreshCardList()
                    self:ShowAllPower()
                end
                break
            end
        end
        self:CheckStateQue()
        EmbattleController:GetInstance():OnEmbattleChange(self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex))
    elseif tag == EmbattleState.FullAssist then
        --助战角色已满
        _G.PopWindowManager:GetInstance():ShowAllTips(100314)
    elseif tag == EmbattleState.unPutAssist then
        local uid = self.cardList[self.unPutassistCardIndexes[index]].uid
        if require "FriendHelpModel":GetInstance():GetAssistType(uid) == _G.AssistType.Npc then
            _G.PopWindowManager:GetInstance():ShowAllTips(100317)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    100315,
                    _G.LangUtil.GetLangPackValue(90000010379, require "FriendHelpModel":GetInstance():GetRTSStr())
            )
        end
    else
        -- 上阵
        --镇魂特训 （特殊阵容）
        index = self:GetCardIndexAndTag(index)
        if not self.curEmbattleItem:CheckCardHandle(self.cardList[index].uid) then
            return
        end
        local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
        if self.curEmbattleItem:CheckCardAssist(self.cardList[index].uid) then
            for i = 1, #data do
                if data[i].sid == self.cardList[index].sid then
                    -- 找空位
                    self.curEmbattleItem:SetEmbattleDataSingle(i, data[i].uid, self.curEmbattleIndex)
                    self:ChangeModel(i)
                end
            end
        end
        local max = self.curEmbattleItem:GetMaxPutNum()
        if max > 0 then
            local num = 0
            for i = 1, #data do
                if data[i].uid > 0 then
                    num = num + 1
                end
            end
            if num >= max then
                _G.PopWindowManager:GetInstance():ShowAllTips(self.curEmbattleItem:GetMaxTips())
                return
            end
        end
        local isBack = backRow[self.cardList[index].cfg.Distance]
        local idx
        for i = 1, #data do
            idx = isBack and backSort[i] or i
            if data[idx].uid == 0 then
                -- 找空位
                if self.curEmbattleItem:SetEmbattleDataSingle(idx, self.cardList[index].uid, self.curEmbattleIndex) then
                    self.createRoleModelTag = true
                    self.onBtnFuncRun = true
                    self:ChangeModel(
                            idx,
                            self.cardList[index],
                            function()
                                self.onBtnFuncRun = false
                                self.createRoleModelTag = nil
                            end
                    )
                    self:RefreshCardList()
                    self:ShowAllPower()
                    self:ShowCardContact(self.cardList[index])
                end
                break
            else
                if i == #data then
                    _G.PopWindowManager:GetInstance():ShowAllTips(140111)
                    return
                end
            end
        end
        self:CheckStateQue()
        EmbattleController:GetInstance():OnEmbattleChange(self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex))
    end
end

--添加契约弹窗
function EmbattleNewView:ShowCardContact(cardData)
    self.contactFuncList = self.contactFuncList or {}
    for k, v in ipairs(self.contactFuncList) do
        if v.cfg.fetter[1] == cardData.cfg.fetter[1] then
            return
        end
    end
    if self.kaiguan == 1 and require("CardInfoManager").CheckContact(cardData, self.curEmbattleItem, self.curEmbattleIndex) then
        table.insert(self.contactFuncList, cardData)
        if #self.contactFuncList == 1 then
            self:PopContact()
        end
    end
end

--移除契约弹窗列表里的弹窗
function EmbattleNewView:RemoveContact()
    if self:IsNil() then
        return
    end
    table.remove(self.contactFuncList, 1)
    if #self.contactFuncList > 0 then
        self:PopContact()
    end
end

--契约弹窗
