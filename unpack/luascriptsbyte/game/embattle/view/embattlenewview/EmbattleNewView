                self.go_table_tips.aortext_profession.text = TryGetLangValue(cfg.name)
                setsprite(self.go_table_tips.aorimage_profession, cfg.icon2)
            end
        end
        local dic = self.modelDataArray[index]
        if dic and dic.tran then
            dic.tran:ShowDragEff(255, 255, 255, 1, 4)
        end
    else
        if self.moveEffectTrans then
            self.moveEffectTrans:SetActiveE(0)
        end
        self.go_table.trans_tips:SetActiveE(0)
        local dic = self.modelDataArray[index]
