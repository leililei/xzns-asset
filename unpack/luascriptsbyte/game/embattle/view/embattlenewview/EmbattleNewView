function EmbattleNewView:OnBattleClick(unCheck)
    local PopWindowManager = _G.PopWindowManager:GetInstance()
    local function func()
        if self.BattleStartCheckCall then
            if not self.BattleStartCheckCall() then
                self.onBtnFuncRun = false
                return
            end
        end
        --local animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        --animator.enabled = true
        local function loadedEffect()
            --animator:Play("a_EmbattleView_lichang_effect")
            if self.onEffLoadCall then
                self.onEffLoadCall()
            end
        end
        local function finishEffect()
            PopWindowManager.openToggleView = false
            _G.AudioManager.PlayAudioByAudioCfgID(2045)
            local EmbattleControllerIns = EmbattleController:GetInstance()
            EmbattleControllerIns:OnEmbattleBattle(
                    function()
                        _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
                        local root = _G.WorldManager:GetInstance():GetRoleParent()
                        local cacheModel = self.curEmbattleItem:GetCacheModelInBattle()
                        if not _G.IsNil(self.curSceneTrans) then
                            if cacheModel then
                                self.curSceneTrans:SetParentE(root, 1)
                            end
                            self.curSceneTrans = nil
                            --还原相机高度
                            if self.camera then
                                local cfg = _G.ConfigManager.discrete_cfg[106707]
                                local offset
                                if _G.AppSetting.IsXzns then
                                    offset = _G.ConfigManager.monster_group_cfg[self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)].Offset
                                    cfg = { offset }
                                end
                                local offsetX, offsetY, offsetZ = cfg and cfg[1][1] or 0,
                                cfg and cfg[1][2] or 0,
                                cfg and cfg[1][3] or 0
                                local x, y, z = self.camera:GetLocalPosition()
                                self.camera:SetLocalPosition(x - offsetX, y - offsetY, z - offsetZ)
                                local cm = utils.getCameraMovement(self.camera)
                                cm:SyncCameraStartPosition()
                                cm.enabled = true
                            end
                        end
                        if cacheModel then
                            local card
                            local RemoveEffect = _G.UIUtils.RemoveEffect
                            for i = 1, #self.modelDataArray do
                                card = self.modelDataArray[i]
                                if card and card.tran and not _G.IsNil(card.tran) then
                                    card.tran:SetParentE(root, 1)
                                    card.tran:ClearDragEff()
                                    card.tran = nil
                                end
                                if card and card.effect and not _G.IsNil(card.effect) then
                                    RemoveEffect(card.effect, 0)
                                    card.effect = nil
                                end
                                -- if card and card.shadow and not _G.IsNil(card.shadow) then
                                --     card.shadow:SetParentE(root, 1)
                                --     EmbattleControllerIns:AddEmbattleEffect(card.shadow)
                                -- end
                            end
                        end
                        if _G.AppSetting.IsXzns then
                            if cacheModel then
                                -- 圣兽
                                if self.beastModelDataArray then
                                    local dic
                                    for i = 1, #self.beastModelDataArray do
                                        dic = self.beastModelDataArray[i]
                                        if dic and dic.tran and not _G.IsNil(dic.tran) then
                                            dic.tran:SetParentE(root, 1)
                                            dic.tran = nil
                                        end
                                    end
                                end
                            end
                        end
                        if self.curEmbattleItem:GetShowSkip() and self.go_table.toggle_skip.isOn then
                            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
                        end
                        self.sceneRoot:Dispose()
                        self:Close()
                    end,
                    function()
                        self.onBtnFuncRun = false
                    end
            )
            PopWindowManager.openToggleView = true
        end

        --ZHJH-1191【客户端】布阵-战斗按钮点击特效&羁绊特效&魔兽上阵槽位隐藏
        -- _G.UIUtils.LoadEffectByCfg(
        --     _G.ConfigManager.ui_effect_cfg.ef_huoyanbaokai_effect,
        --     self.go_table.aorbtn_battle,
        --     function()
        --         _G.DelayDo(0.3, loadedEffect)
        --     end,
        --     finishEffect
        -- )
        loadedEffect()
        finishEffect()
    end
    if unCheck then
        func()
        return
    end
    ---检测是否有可上阵的合击技
    ---@param windowId number
    ---@return boolean 是否继续执行
    local function CheckCombinSkill(windowId)
        if not self.skillItems then
            return true
        end
        local showIndex = 0
        for i = 1, #self.skillItems do
            if self.skillItems[i].redpoint:GetActiveSelf() == 1 then
                --本队还有未上阵的合击技
                showIndex = i
                break
            end
        end
        if showIndex > 0 then
            PopWindowManager:ShowBtnWindowByToggle(
                    windowId,
                    function()
                        self:ClickCombSkillBtn(showIndex)
                        self.onBtnFuncRun = false
                    end,
                    func,
                    func
            )
            return false
        else
            return true
        end
    end
    ---检测是否有可上阵的宠物
    ---@param windowId number
    ---@return boolean 是否继续执行
    local function CheckPetSkill(windowId)
        if not self.petSkillUnlock or not self.petSkillUnlock[1] or not self.petSkillItems then
            return true
        end
        local showIndex = 0
        for i = 1, #self.petSkillItems do
            if self.petSkillItems[i].obj_redpoint:GetActiveSelf() == 1 then
                --本队还有未上阵的宠物技
                showIndex = i
                break
            end
        end
        if showIndex > 0 then
            PopWindowManager:ShowBtnWindowByToggle(
                    windowId,
                    function()
                        self:ClickBtnPetSkill(showIndex)
                        self.onBtnFuncRun = false
                    end,
                    func,
                    func
            )
            return false
        else
            return true
        end
    end

    ---检测是否有可上阵的圣兽
    ---@param windowId number
    ---@return boolean 是否继续执行
    local function CheckBeastSkill()
        if not self.beastSkillUnlock or not self.beastSkillUnlock[1] or not self.beastSkillItems then
            return true
        end
        local showIndex = 0
        for i = 1, #self.beastSkillItems do
            if require("BeastEmbattleModel"):CheckRedpoint(i) == 1 then
                --本队还有未上阵的圣兽技
                showIndex = i
                break
            end
        end

        if showIndex > 0 then
            PopWindowManager:ShowAllTipsExtend(
                    140121,
                    nil,
                    function()
                        self:ClickBtnBeastSkill(showIndex)
                        self.onBtnFuncRun = false
                    end,
                    func,
                    nil,
                    nil,
                    { closeCall = function()
                        self.onBtnFuncRun = false
                    end }
            )
            return false
        else
            return true
        end
    end
    ---显示确认窗口
    ---@param windowId number
    local function ShowConfirmCardWindow(windowId)
        PopWindowManager:ShowBtnWindowByToggle(
                windowId,
                function()
                    self:ShowCardList()
                    self.onBtnFuncRun = false
                end,
                func,
                func
        )
    end

    ---@type number @确认窗口id
    local windowId
    ---@type fun():boolean @额外检测等级
    local checkLevelWarning
    --如果是竞技场(额外检测等级, 并使用140303提示)
    if self.curEmbattleItem._class_type.__cname == _G.EmbattleControllerItemType.arenaAttack then
        windowId = 140303
        checkLevelWarning = function()
            for _, card in pairs(self.curEmbattleItem:GetCardList()) do
                if card.lv == 1 and self.curEmbattleItem:CheckUidInEmbattle(card.uid) then
                    return true
                end
            end
            return false
        end
    else
        windowId = 140301
    end

    if PopWindowManager:CheckToggleWindow(windowId) then
        if self.curEmbattleItem.sociatyEmbattle then
            local index = 0
            for i = 1, 5 do
                if self.curEmbattleItem:CheckEmptyPos(i) > 0 then
                    index = index + 1
                    break
                end
            end
            if index > 0 or checkLevelWarning and checkLevelWarning() then
                ShowConfirmCardWindow(windowId)
            elseif CheckCombinSkill(windowId) and CheckPetSkill(windowId) then
                func()
            elseif _G.AppSetting.IsXzns then
                if CheckBeastSkill() then
                    func()
                end
            end
        elseif _G.AppSetting.IsXzns then
            if CheckBeastSkill() then
                func()
            end
        else
            func()
        end
    else
        func()
    end
end

