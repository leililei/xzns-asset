---初始化场景
---@param path string 路径
---@param BattleCamera string 战斗相机路径
---@param x number 坐标X
---@param y number 坐标Y
---@param z number 坐标Z
function EmbattleNewView:InitScene(path, BattleCamera, x, y, z)
    self.sceneRoot = _G.GameObject("EmbattleRoot")
    self.sceneRoot:SetPosition(x, y, z)
    local WorldManager = _G.WorldManager:GetInstance()
    if _G.string.IsNullOrEmpty(path) then
        WorldManager:SetBaseViewVisible(false)
        local world = WorldManager:GetCurWorld()
        world:ShowOrHideAllItem(false)
        world:DisablePlayer()
        self:InitRoleModel()
        if not string.IsNullOrEmpty(BattleCamera) then
            local cameraNum = string.match(BattleCamera, "%d+")
            world.WorldSetting:ChangeCameraParams(BattleCamera, cameraNum)
        end
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    else
        _G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
        PoolsManager:GetInstance():Spawn(
                path,
                _G.ePoolType.Static,
                self.sceneRoot,
                function(trans)
                    if _G.IsNil(self.sceneRoot) then
                        PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                        return
                    end
                    trans:ChangeCameraAdaption()
                    ---如果对话结束完需要加载布阵前剧情则
                    WorldManager:SetCurrentWorldVisible(false, true)
                    local AfkBattleManager = require "AfkBattleManager":GetInstance()
                    if AfkBattleManager:GetFrontEmbattleStoryIsWaitLoad() then
                        ---是否是布阵前剧情
                        AfkBattleManager.isFrontEmbattleStory = false
                        _G.StoryManager:GetInstance():HideDialogueRootFullScreen()
                    end
                    self.curSceneTrans = trans
                    trans:SetLocalPositionToZero()
                    _G.TimerManager:GetInstance():GetTimer(1, self.InitRoleModel, self, true, true):Start()
                    if not string.IsNullOrEmpty(BattleCamera) then
                        local cameraNum = string.match(BattleCamera, "%d+")
                        local component = trans:GetComponentE(_G.typeof(_G.CS.WorldSetting))
                        if component then
                            component:ChangeCameraParams(BattleCamera, cameraNum)
                        end
                    end
                    _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
                    if self.onInitSceneCall then
                        self.onInitSceneCall()
                    end
                    --相机高度降低固定值
                    self.camera = self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                            _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
                    )
                    if self.camera then
                        local cm = utils.getCameraMovement(self.camera)
                        cm:ResetCameraPositions()
                        --ZHJH-5405【放置关卡】在镜头拉近时点击重新开始战斗，低概率出现布阵上方显示异常
                        --上一场战斗的Scene实例未被清理(enabled=false暂时禁用)
                        cm:Follow(nil, 0)
                        cm:GetComponentE(_G.typeof(_G.CS.UnityEngine.Transform)):DOKill()
                        cm.enabled = false
                        --增加偏移值
                        local cfg = _G.ConfigManager.discrete_cfg[106707]
                        local offset
                        if _G.AppSetting.IsXzns then
                            offset = _G.ConfigManager.monster_group_cfg[self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)].Offset
                            cfg = { offset }
                        end
                        local offsetX, offsetY, offsetZ = cfg and cfg[1][1] or 0,
                        cfg and cfg[1][2] or 0,
                        cfg and cfg[1][3] or 0
                        local x, y, z = self.camera:GetLocalPosition()
                        self.camera:SetLocalPosition(x + offsetX, y + offsetY, z + offsetZ)
                        -- --记录相机位置
                        cm:SetCameraStartPositionNow()
                    end
                end
        )
    end
end

