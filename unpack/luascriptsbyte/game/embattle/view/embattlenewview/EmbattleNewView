function EmbattleNewView:GetStatisticsData(data)
    self.statisticsData = data.FighterInfo[1]
    self.statisticsMax = { DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1 }
    for i = 1, #self.statisticsData.Attacker do
        if self.statisticsMax.DmgOut < self.statisticsData.Attacker[i].DmgOut then
            self.statisticsMax.DmgOut = self.statisticsData.Attacker[i].DmgOut
        end

        if self.statisticsMax.DmgIn < self.statisticsData.Attacker[i].DmgIn then
            self.statisticsMax.DmgIn = self.statisticsData.Attacker[i].DmgIn
        end

        if self.statisticsMax.HpRecover < self.statisticsData.Attacker[i].HpRecover then
            self.statisticsMax.HpRecover = self.statisticsData.Attacker[i].HpRecover
        end
        if self.statisticsMax.CreateGuard < self.statisticsData.Attacker[i].CreateGuard then
            self.statisticsMax.CreateGuard = self.statisticsData.Attacker[i].CreateGuard
        end
    end
    for i = 1, #self.statisticsData.Defender do
        if self.statisticsMax.DmgOut < self.statisticsData.Defender[i].DmgOut then
            self.statisticsMax.DmgOut = self.statisticsData.Defender[i].DmgOut
        end

        if self.statisticsMax.DmgIn < self.statisticsData.Defender[i].DmgIn then
            self.statisticsMax.DmgIn = self.statisticsData.Defender[i].DmgIn
        end

        if self.statisticsMax.HpRecover < self.statisticsData.Defender[i].HpRecover then
            self.statisticsMax.HpRecover = self.statisticsData.Defender[i].HpRecover
        end
        if self.statisticsMax.CreateGuard < self.statisticsData.Defender[i].CreateGuard then
            self.statisticsMax.CreateGuard = self.statisticsData.Defender[i].CreateGuard
        end
    end
    self.CombMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
    for i = 1, #self.statisticsData.AtkCombineSkills[1] do
        if self.CombMax.DmgOut < self.statisticsData.AtkCombineSkills[1][i].DmgOut then
            self.CombMax.DmgOut = self.statisticsData.AtkCombineSkills[1][i].DmgOut
        end

        if self.CombMax.CreateGuard < self.statisticsData.AtkCombineSkills[1][i].CreateGuard then
            self.CombMax.CreateGuard = self.statisticsData.AtkCombineSkills[1][i].CreateGuard
        end

        if self.CombMax.HpRecover < self.statisticsData.AtkCombineSkills[1][i].HpRecover then
            self.CombMax.HpRecover = self.statisticsData.AtkCombineSkills[1][i].HpRecover
        end
    end
    for i = 1, #self.statisticsData.DefCombineSkills[1] do
        if self.CombMax.DmgOut < self.statisticsData.DefCombineSkills[1][i].DmgOut then
            self.CombMax.DmgOut = self.statisticsData.DefCombineSkills[1][i].DmgOut
        end

        if self.CombMax.CreateGuard < self.statisticsData.DefCombineSkills[1][i].CreateGuard then
            self.CombMax.CreateGuard = self.statisticsData.DefCombineSkills[1][i].CreateGuard
        end

        if self.CombMax.HpRecover < self.statisticsData.DefCombineSkills[1][i].HpRecover then
            self.CombMax.HpRecover = self.statisticsData.DefCombineSkills[1][i].HpRecover
        end
    end
    self.PetMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
    for j = 1, #self.statisticsData.AtkPetSkills[1] do
        if self.PetMax.DmgOut < self.statisticsData.AtkPetSkills[1][j].DmgOut then
            self.PetMax.DmgOut = self.statisticsData.AtkPetSkills[1][j].DmgOut
        end

        if self.PetMax.CreateGuard < self.statisticsData.AtkPetSkills[1][j].CreateGuard then
            self.PetMax.CreateGuard = self.statisticsData.AtkPetSkills[1][j].CreateGuard
        end

        if self.PetMax.HpRecover < self.statisticsData.AtkPetSkills[1][j].HpRecover then
            self.PetMax.HpRecover = self.statisticsData.AtkPetSkills[1][j].HpRecover
        end
    end
    for j = 1, #self.statisticsData.DefPetSkills[1] do
        if self.PetMax.DmgOut < self.statisticsData.DefPetSkills[1][j].DmgOut then
            self.PetMax.DmgOut = self.statisticsData.DefPetSkills[1][j].DmgOut
        end

        if self.PetMax.CreateGuard < self.statisticsData.DefPetSkills[1][j].CreateGuard then
            self.PetMax.CreateGuard = self.statisticsData.DefPetSkills[1][j].CreateGuard
        end

        if self.PetMax.HpRecover < self.statisticsData.DefPetSkills[1][j].HpRecover then
            self.PetMax.HpRecover = self.statisticsData.DefPetSkills[1][j].HpRecover
        end
    end
    -- end
    local damage = {
        statisticsData = self.statisticsData,
        statisticsMax = self.statisticsMax,
        CombMax = self.CombMax,
        PetMax = self.PetMax
    }
    return damage
end

