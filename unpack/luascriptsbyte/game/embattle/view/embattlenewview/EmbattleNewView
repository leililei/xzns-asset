function EmbattleNewView:InitAllModelTitle()
    local dic, tran
    for i = 1, #self.modelDataArray do
        dic = self.modelDataArray[i]
        if dic then
            tran = dic.tran
            if tran then
                dic.head = utils.findModelPoint(tran)
                --utils.playModelStand2(tran)

                ---ZHJ-19222【灵域守卫】布阵内错误的显示了一个敌方等级标识。
                if self.onInitGuardTitle then
                    if i >= 6 and i <= 10 then
                        return
                    end
                end
                local item = self.modelTitleTable[i]

                local cardData
                if not dic.isEnemy then
                    cardData = self.curEmbattleItem:GetCardData(dic.uid)
                end

                if dic.isEnemy and _G.ConfigManager.monster_cfg[dic.uid] and _G.ConfigManager.monster_cfg[dic.uid].MonsterType == 5 then
                    item:Show(0)
                else
                    if i <= 6 then
                        if not cardData then
                            cardData = {}
                        end
                        if dic.artifact and dic.artifact.sid then
                            cardData.artifact = dic.artifact
                        end
                        item:Show(dic.sid, dic.lv, dic.uid, cardData, dic.isEnemy, self.curEmbattleType)
                    else
                        cardData = {}
                        if dic.artifact and dic.artifact.sid then
                            cardData.artifact = dic.artifact
                        end

                        item:Show(dic.sid, dic.lv, nil, cardData, dic.isEnemy, self.curEmbattleType)
                    end
                end

                if not self.curEmbattleItem.notShowMySoulAndTalents and i <= defaultEmbattleCount then
                    item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
                elseif self.curEmbattleItem.showEnemySoulAndTalents and i > defaultEmbattleCount then
                    item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
                end
                if i > defaultEmbattleCount then
                    item:ShowBossTag(dic.boss)
                    dic.boss = nil
                end
                if not _G.IsNil(dic.head) then
                    local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(dic.head, self.go_table.rect_moveRoot)
                    x = x < -290 and -290 or x
                    x = x > 263 and 263 or x
                    item.transform:SetLocalPosition(x, y, 0)
                end
            end
        end
    end
end

