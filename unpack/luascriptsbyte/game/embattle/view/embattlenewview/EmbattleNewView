                            local petCount = self:GetPetCount()
                            for i = 1, 3 do
                                local petData = curPetSkills[i] and curPetSkills[i] > 1 and model:GetPet(curPetSkills[i]) or
                                        nil
                                local v = (not petData and self.curEmbattleItem:CheckPetSkillEquip(i, petCount)) and 1 or
                                        0
                                if v == 1 then
                                    if empty[index] == nil then
                                        empty[index] = true
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
            self.groupIndexQue[index]:SetActiveE(empty[index] and 1 or 0)
        end
    end
end

function EmbattleNewView:OnFormationGroupEditEnd(save)
    if save then
        local battle, index, noTip = self.curEmbattleItem:CheckSingleBattle(self.curEmbattleIndex)
        if not battle then
            _G.PopWindowManager:GetInstance():ShowAllTips(140107)
            self.onBtnFuncRun = false
            return
        end
    end
    self.onCardListHideCall(
            self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex),
            self.curEmbattleItem:GetPetSkillData(self.curEmbattleIndex),
            save,
            _G.AppSetting.IsXzns and self.curEmbattleItem:GetBeastSkillData(self.curEmbattleIndex) or nil
    )
    self.curEmbattleItem:SetTempEmbattleData(nil, self.curEmbattleIndex, true)
    self.curEmbattleItem:SetTempCombSkillData(nil, self.curEmbattleIndex, true)
    self.curEmbattleItem:SetTempPetSkillData(nil, self.curEmbattleIndex, true)
    if _G.AppSetting.IsXzns then
        self.curEmbattleItem:SetTempBeastSkillData(nil, self.curEmbattleIndex, true)
    end
    self.isEdit = false
    self:UpdateMyFormation()
    self.onCardListHideCall = nil
    if self.curEmbattleItem:GetShowMoreFormation() then
        self.go_table.obj_group:SetActiveE(1)
        self:ShowChangeBtn(true)
    end
    self:CheckFormationShow()
    self:SetBattleBtnText(self.srcBattleBtnTxt)
    self.onBtnFuncRun = false
    self.cardList = self.curEmbattleItem:GetCardList()
    self:UpdateCardList()
end

return EmbattleNewView
