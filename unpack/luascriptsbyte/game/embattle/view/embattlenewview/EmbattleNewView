        for index = 1, count do
            if groupState ~= nil and groupState[index] == true then
            else
                --检测队伍数据
                local data = dataAll[index]
                if max > 0 then
                    local num = 0
                    for i = 1, #data do
                        if data[i].uid > 0 then
                            num = num + 1
                        end
                    end
                    if num < max then
                        if empty[index] == nil then
                            empty[index] = true
                        end
                    end
