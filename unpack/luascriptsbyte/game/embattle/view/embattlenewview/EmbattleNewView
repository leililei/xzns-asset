function EmbattleNewView:GetCardIndexAndTag(index, tag)
    local sameIndex
    if index <= #self.unPutassistCardIndexes then
        index = self.unPutassistCardIndexes[index]
        if tag then
            tag = EmbattleState.unPutAssist
        end
    else
        index = index - #self.unPutassistCardIndexes
        if index <= #self.fullPutassistCardIndexes then
            index = self.fullPutassistCardIndexes[index]
            if tag then
                tag = EmbattleState.FullAssist
            end
        else
            index = index - #self.fullPutassistCardIndexes
            if index <= #self.otherAssistCardIndexs then
                index = self.otherAssistCardIndexs[index]
                if tag then
                    tag = EmbattleState.None
                end
            else
                index = index - #self.otherAssistCardIndexs
                if index <= #self.embattleCardIndexes then
                    index = self.embattleCardIndexes[index]
                    if tag then
                        tag = EmbattleState.Embattle
                    end
                else
                    index = index - #self.embattleCardIndexes
                    if index <= #self.selectCardIndexes then
                        index = self.selectCardIndexes[index]
                        if tag then
                            tag = self.curEmbattleItem:CheckCardLock(self.cardList[index].uid, self.curEmbattleIndex)
                        end
                    else
                        index = index - #self.selectCardIndexes
                        if index <= #self.sameSidCardIndexes then
                            index = self.sameSidCardIndexes[index]
                            if tag then
                                tag, sameIndex = self.curEmbattleItem:CheckCardSameLock(
                                        self.cardList[index].uid,
                                        self.curEmbattleIndex,
                                        self.cardList[index].sid
                                )
                            end
                        else
                            index = index - #self.sameSidCardIndexes
                            index = self.deadCardIndexes[index]
                            if tag then
                                tag = EmbattleState.Dead
                            end
                        end
                    end
                end
            end
        end
    end

    return index, tag, sameIndex
end

function EmbattleNewView:UpdateCardList()
    if not self.go_table_card then
        return
    end
    local card
    local insert = _G.table.insert
    self.embattleCardIndexes = {}
    self.selectCardIndexes = {}
    self.sameSidCardIndexes = {}
    self.deadCardIndexes = {}
    self.assistCardIndexes = {}
    self.unPutassistCardIndexes = {}
    self.fullPutassistCardIndexes = {}
    self.otherAssistCardIndexs = {}
    local isFullAssist = self.curEmbattleItem:CheckAssistIsFull()
    local maxAssist = self.curEmbattleItem:GetMaxPutAssistNum()
    local joinCheck = false
    for i = 1, #self.cardList do
        joinCheck = false
        card = self.cardList[i]
        if self.chooseElementType == 0 then
            if self.lockElementType and #self.lockElementType > 0 then
                for j = 1, #self.lockElementType do
                    if require "CardInfoManager":GetInstance():CheckMultiMatch(self.lockElementType[j], card.cfg.Elements_new) then
                        --== self.lockElementType[j] then
                        if self.chooseEquipmentType == card.cfg.EquipmentType or self.chooseEquipmentType == 0 then
                            if self.chooseProfType == card.cfg.Professional or self.chooseProfType == 0 then
                                joinCheck = true
                                break
                            end
                        end
                    end
                end
            else
                if self.chooseEquipmentType == card.cfg.EquipmentType or self.chooseEquipmentType == 0 then
                    if self.chooseProfType == card.cfg.Professional or self.chooseProfType == 0 then
                        joinCheck = true
                    end
                end
            end
        elseif require "CardInfoManager":GetInstance():CheckMultiMatch(self.chooseElementType, card.cfg.Elements_new) then
            -- == self.chooseElementType then
            if self.chooseEquipmentType == card.cfg.EquipmentType or self.chooseEquipmentType == 0 then
                if self.chooseProfType == card.cfg.Professional or self.chooseProfType == 0 then
                    joinCheck = true
                end
            end
        end
        if joinCheck then
            if self.isEdit then
                if self.curEmbattleItem:CheckUidInEmbattle(self.cardList[i].uid, self.curEmbattleIndex) then
                    insert(self.embattleCardIndexes, i)
                    if self.curEmbattleItem:CheckCardAssist(self.cardList[i].uid) then
                        insert(self.assistCardIndexes, i)
                        if isFullAssist then
                            isFullAssist = #self.assistCardIndexes < maxAssist
                        end
                    end
                else
                    insert(self.selectCardIndexes, i)
                end
            else
                if self.curEmbattleItem:CheckUidInEmbattle(self.cardList[i].uid, self.curEmbattleIndex) then
                    insert(self.embattleCardIndexes, i)
                    if self.curEmbattleItem:CheckCardAssist(self.cardList[i].uid) then
                        insert(self.assistCardIndexes, i)
                        if isFullAssist then
                            isFullAssist = #self.assistCardIndexes < maxAssist
                        end
                    end
                elseif self.curEmbattleItem:CheckCardAssist(self.cardList[i].uid) then
                    if
                    self.curEmbattleItem:CheckIsNpcAssist(self.cardList[i].uid) and
                            self.curEmbattleItem:CheckNpcAssistIsFull()
                    then
                        insert(self.unPutassistCardIndexes, i)
                    else
                        if not self.curEmbattleItem:CheckIsPutAssist(nil, self.cardList[i].uid) then
                            insert(self.unPutassistCardIndexes, i)
                        elseif not isFullAssist then
                            insert(self.fullPutassistCardIndexes, i)
                        elseif self.curEmbattleItem:CheckSidInEmbattle(self.cardList[i].sid) then
                            insert(self.sameSidCardIndexes, i)
                        else
                            insert(self.otherAssistCardIndexs, i)
                        end
                    end
                elseif self.curEmbattleItem:CheckSidInEmbattle(self.cardList[i].sid) then
                    insert(self.sameSidCardIndexes, i)
                elseif self.curEmbattleItem:GetCardHPPer(self.cardList[i].uid, self.curEmbattleIndex) <= 0 then
                    insert(self.deadCardIndexes, i)
                else
                    insert(self.selectCardIndexes, i)
                end
            end
        end
    end
    self.go_table_card.scrollloopvectical_card:UpdateCount(
            #self.selectCardIndexes + #self.embattleCardIndexes + #self.sameSidCardIndexes + #self.deadCardIndexes +
                    #self.unPutassistCardIndexes +
                    #self.fullPutassistCardIndexes +
                    #self.otherAssistCardIndexs
    )
end

