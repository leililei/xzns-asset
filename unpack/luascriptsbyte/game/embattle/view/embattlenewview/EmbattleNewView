function EmbattleNewView:QuitEmbattle()
    if self.curSceneTrans then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
        if self.interpolation and self.camera then
            self.camera.Interpolation = self.interpolation
            self.camera = nil
            self.interpolation = nil
        end
        if self.curEmbattleItem:GetCacheModelQuitEmbattle() then
            PoolsManager:GetInstance():Despawn(self.curSceneTrans, _G.ePoolType.Static)
        end
        self.curSceneTrans = nil
        --还原相机高度
        if self.camera then
            local cfg = _G.ConfigManager.discrete_cfg[106707]
            local offset
            if _G.AppSetting.IsXzns then
                offset = _G.ConfigManager.monster_group_cfg[self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)].Offset
                cfg = { offset }
            end
            local offsetX, offsetY, offsetZ = cfg and cfg[1][1] or 0, cfg and cfg[1][2] or 0, cfg and cfg[1][3] or 0
            local x, y, z = self.camera:GetLocalPosition()
            self.camera:SetLocalPosition(x - offsetX, y - offsetY, z - offsetZ)
        end
    else
        local WorldManager = _G.WorldManager:GetInstance()
        WorldManager:SetBaseViewVisible(true)
        local world = WorldManager:GetCurWorld()
        world:ShowOrHideAllItem(true)
        world:EnablePlayer()
        world:ChangeCameraBattle()
    end
    local dic
    for i = 1, #self.modelDataArray do
        dic = self.modelDataArray[i]
        if dic and dic.tran and self.cacheCardSids[dic.sid] then
            require("CardInfoManager").DelRole(dic.tran, _G.ePoolType.Static)
            dic.tran = nil
        end
    end
    self.sceneRoot:Dispose()
    EmbattleController:GetInstance():OnEmbattleExit(_G.handler(self, self.Close))
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end

---调用退出回调, 然后退出布阵
---@param callback fun(ok:boolean):void     @调用成功的回调
function EmbattleNewView:QuitEmbattleCheckCallback(callback)
    if self.onQuitCallback then
        self.onQuitCallback(
                function(quit)
                    if quit then
                        self:QuitEmbattle()
                    end
                    if callback then
                        callback(quit)
                    end
                end
        )
    else
        self:QuitEmbattle()
        if callback then
            callback(true)
        end
    end
end

