local nonSkillDescID = 90114010103
local CombSkillText = 90114010109
--local CombSkillDescribe =90114010110
local EmbattleCombSkillTipsLabel = require "EmbattleCombSkillTipsLabel"
local EmbattleController = require "EmbattleController"
---@class CombSkillTipsView : UIBaseView	中文描述
---@field public go_table CombSkillTipsView_GoTable GoTable
local CombSkillTipsView = _G.BaseClass("CombSkillTipsView", _G.UIBaseView)
--_G.CombSkillTipsView = CombSkillTipsView
local newEmbattleCombSkillTipsLabel = _G.BaseClass("newEmbattleCombSkillTipsLabel", EmbattleCombSkillTipsLabel)
--override
function newEmbattleCombSkillTipsLabel:Show(heroid, guardianid)
    local skill1, skill2 = EmbattleController:GetInstance():GetCombSkill(heroid, guardianid)
    if heroid == 0 and guardianid == 0 then
        _G.GameUtil.SetActiveByCondition(self.gObject, false)
    else
        _G.GameUtil.SetActiveByCondition(self.gObject, true)
        local cfg
        if heroid == 0 then
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_heroName, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_heroSkill, false)
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_heroName, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_heroSkill, true)
            ---@type card_cfg
            cfg = _G.ConfigManager.card_cfg[heroid]
            self.go_table.aortext_heroName.text = _G.GetLangPackValue(cfg.Name)
            if skill1 == 0 then
                self.go_table.aortext_heroSkill.text = _G.GetLangPackValue(nonSkillDescID)
            else
                cfg = _G.ConfigManager.card_skills_cfg[skill1]
                self.go_table.aortext_heroSkill.text =
                    _G.GetLangPackValue(90114010110, _G.GetLangPackValue(cfg.name1)) ..
                    _G.GetLangPackValue(cfg.describe1)
            end
        end
        if guardianid == 0 then
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_guardianName, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_guardianSkill, false)
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_guardianName, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.aortext_guardianSkill, true)
            ---@type card_cfg
            cfg = _G.ConfigManager.card_cfg[guardianid]
            self.go_table.aortext_guardianName.text = _G.GetLangPackValue(cfg.Name)
            if skill2 == 0 then
                self.go_table.aortext_guardianSkill.text = _G.GetLangPackValue(nonSkillDescID)
            else
                cfg = _G.ConfigManager.card_skills_cfg[skill2]
                self.go_table.aortext_guardianSkill.text =
                    _G.GetLangPackValue(90114010110, _G.GetLangPackValue(cfg.name1)) ..
                    _G.GetLangPackValue(cfg.describe1)
            end
        end
        self.skillTipLayout.enabled = false
        _G.TimerManager:GetInstance():GetTimer(1, self.LayoutSkillTip, self, true, true):Start()
    end
end
function CombSkillTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CombSkillTipsView:OnCreate(herodata, guardiandata, closeCall, btnPos)
    self.onCloseCall = closeCall
    self:ShowSkill(herodata, guardiandata)
    local trans = self.go_table.obj_skilltips
    self:SetPos(trans, btnPos)
end

function CombSkillTipsView:OnDestroy()
    if self.combSkillTipsLabel then
        self.combSkillTipsLabel:Dispose()
        self.combSkillTipsLabel = nil
    end
    if self.onCloseCall then
        self.onCloseCall()
    end
    self.heroBodyItem = nil
    self.guardianBodyItem = nil
    self.guardianid = nil
    self.heroid = nil
end
---按钮点击事件在这里派发
function CombSkillTipsView:OnClickBtn(go)
    self:Close()
end

local setsprite = function(aorimage, name)
    aorimage:LoadImage(name)
end

function CombSkillTipsView:SetPos(rect, pos)
    local width, height = rect:GetRectTransformSizeDelta()
    local v2 = _G.Vector2.zero
    rect:SetPosition(pos.x, pos.y, pos.z)
    local x, y, z = rect:GetLocalPosition()
    rect:SetLocalPosition(x, y, 0)
    if x + width <= _G.AppSetting.CONFIG_SCREEN_WIDTH / 2 then
        v2.x = 0
    else
        v2.x = 1
    end

    if math.abs(y - height) <= _G.AppSetting.CONFIG_SCREEN_HEIGHT / 2 then
        v2.y = 1
    else
        v2.y = 0
    end

    rect:SetPivotPosition(v2.x, v2.y)
end

function CombSkillTipsView:ShowSkill(herodata, guardiandata)
    local heroid = nil
    local guardianid = nil
    if type(herodata) == "table" then
        heroid = herodata.sid
    elseif type(herodata) == "number" then
        herodata = {sid = herodata}
        heroid = herodata.sid
    end
    if type(guardiandata) == "table" then
        guardianid = guardiandata.sid
    elseif type(guardiandata) == "number" then
        guardiandata = {sid = guardiandata}
        guardianid = guardiandata.sid
    end
    local skillid1, skillid2 = require("EmbattleController"):GetInstance():GetCombSkill(heroid, guardianid)
    if skillid1 == 0 or skillid2 == 0 then
        self:Close()
        return
    end
    local cfg = _G.ConfigManager.card_skills_cfg[skillid2]
    if cfg then
        setsprite(self.go_table.aorrawimage_skill, cfg.icon)
        self.go_table.aortext_skillName.text = _G.GetLangPackValue(CombSkillText) .. _G.GetLangPackValue(cfg.name1)
    else
        self:Close()
        return
    end
    self.combSkillTipsLabel = newEmbattleCombSkillTipsLabel.New(self.go_table.obj_CombSkill)
    self.combSkillTipsLabel:Show(heroid, guardianid)
    self:InitCardBodyItem(
        herodata,
        self.heroBodyItem,
        self.go_table.trans_hero,
        function(item)
            self.heroBodyItem = item
        end
    )
    self:InitCardBodyItem(
        guardiandata,
        self.guardianBodyItem,
        self.go_table.trans_guardian,
        function(item)
            self.guardianBodyItem = item
        end
    )
end

function CombSkillTipsView:InitCardBodyItem(data, carditem, parent, callback)
    if data.sid > 0 then
        if not data.star and not data.level then
            data = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.sid)
        end
        if carditem == nil then
            carditem =
                _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                parent,
                function(item)
                    item.transform:SetLocalPositionToZero()
                    item.transform:SetLocalScale(1, 1, 1)
                    callback(item)
                    item:Show({sid = data.sid, star = data.star, lv = data.level, soulLink_lv = 0})
                end
            )
        else
            _G.GameUtil.SetActiveByCondition(carditem.GameObject, true)
            carditem:Show({sid = data.sid, star = data.star, lv = data.level, soulLink_lv = 0})
        end
    else
        if carditem then
            _G.GameUtil.SetActiveByCondition(carditem.gameObject, false)
        end
    end
end
return CombSkillTipsView
