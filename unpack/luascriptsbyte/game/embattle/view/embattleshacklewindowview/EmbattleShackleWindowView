local yellowColor = "<color=#c95f00>%s</color>"
local ElementShackleItem = _G.BaseClass("ElementShackleItem")
local format = _G.string.format
function ElementShackleItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj)
    self.desc = { self.go_table.aortext_desc }
end

function ElementShackleItem:Dispose()
    self.go_table = nil
end

---展示
---@param cfg formation_cfg 羁绊配置
---@param actID number 激活的羁绊ID
function ElementShackleItem:Show(cfg, actID)
    self.go_table.aorimage_icon.SpriteName = cfg.icon
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.describe)
    local insert = _G.table.insert
    local textType = _G.typeof(_G.CS.AorText)
    for i = 1, #cfg.describe_att do
        if i > #self.desc then
            local obj = _G.InstantiateObject(self.go_table.aortext_desc, self.go_table.trans_attRoot)
            insert(self.desc, obj:GetComponentE(textType))
        end
        self.desc[i].text = _G.GetLangPackValue(cfg.describe_att[i])
        if actID == cfg.id then
            --self.desc[i].text = format(yellowColor, self.desc[i].text)
            self.go_table.aortext_name.text = format(yellowColor, _G.GetLangPackValue(cfg.describe))
        end
    end
end

---@class EmbattleShackleWindowView : UIBaseView	中文描述
---@field public go_table EmbattleShackleWindowView_GoTable GoTable
local EmbattleShackleWindowView = _G.BaseClass("EmbattleShackleWindowView", _G.UIBaseView)

function EmbattleShackleWindowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param eleID number 五行羁绊ID
---@param goldID number 神羁绊ID
function EmbattleShackleWindowView:OnCreate(eleID, goldID)
    local elementIDs, godIDs = require("EmbattleController"):GetInstance():GetAllShackleIDs()
    self:InitElementItem(elementIDs, eleID)
    --是否显示"传奇"描述, 以开服天数为准
    local cfg = _G.ConfigManager.discrete_cfg[106706]
    if cfg and _G.GlobalConditionManager.CheckConditionArrays(cfg) then
        self.go_table.obj_godIcon:SetActiveE(1)
        self.go_table.obj_god:SetActiveE(1)
        self:InitGodItem(godIDs, goldID)
    end
end

function EmbattleShackleWindowView:OnDestroy()
    self.godTable = nil
    self.onItemCall = nil
    for _, value in pairs(self.itemDic) do
        value:Dispose()
    end
    self.itemDic = nil
end

---按钮点击事件在这里派发
function EmbattleShackleWindowView:OnClickBtn(go)
    self:Close()
end

---初始化五行羁绊
---@param elementIDs table 所有五行羁绊ID组
---@param eleID number 激活的ID
function EmbattleShackleWindowView:InitElementItem(elementIDs, eleID)
    self.elementIDs = elementIDs
    self.curActiveEleID = eleID
    self.onItemCall = _G.handler(self, self.OnItemCall)
    self.itemDic = {}
    self.go_table.scrollloopvectical_shackle:InitItemData(#elementIDs, self.onItemCall)
end

function EmbattleShackleWindowView:OnGodItemCall(index, obj)
    if index < 0 then
        return
    end
    self.go_table.obj_Content:SetRectTransformSize(0, 240)
    local id = obj:GetInstanceID()
    local item = self.itemDicGod[id]
    if not item then
        item = ElementShackleItem.New(obj)
        self.itemDicGod[id] = item
    end
end

function EmbattleShackleWindowView:OnItemCall(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local id = obj:GetInstanceID()
    local item = self.itemDic[id]
    if not item then
        item = ElementShackleItem.New(obj)
        self.itemDic[id] = item
    end
    item:Show(_G.ConfigManager.formation_cfg[self.elementIDs[index]], self.curActiveEleID)
end

---初始化神羁绊
---@param godIDs table 所有神羁绊ID组
---@param goldID number 激活的ID
function EmbattleShackleWindowView:InitGodItem(godIDs, goldID)
    self.itemDicGod = {}
    goldID = goldID or 0
    self.godTable = _G.GetAutoGoTable(self.go_table.obj_godItem)
    local strTable = { false, false, false, false, false }
    local formationCfg = _G.ConfigManager.formation_cfg
    local cfg
    local GetLangPackValue = _G.GetLangPackValue
    for i = 1, #godIDs do
        cfg = formationCfg[godIDs[i]]
        strTable[i] = format(GetLangPackValue(90024900029), cfg.num_elements[1], GetLangPackValue(cfg.describe_att[1]))
        if godIDs[i] <= goldID then
            strTable[i] = format(yellowColor, strTable[i])
        end
    end
    self.godTable.aortext_desc.text = _G.table.concat(strTable, "\n")
end

---@private
function EmbattleShackleWindowView:EscClose()
    self:Close()
end

return EmbattleShackleWindowView
