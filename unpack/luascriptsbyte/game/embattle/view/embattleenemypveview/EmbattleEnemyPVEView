--region 头像
local EmbattleEnemyPVEItem = _G.BaseClass("EmbattleEnemyPVEItem")
local bgName = {
    normal = "ui_chuzhan_buzhenpan_lansz",
    boss = "ui_chuzhan_buzhenpan_bosszhuangshi"
}
function EmbattleEnemyPVEItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj)
end
function EmbattleEnemyPVEItem:Dispose()
    self.gameObject = nil
    self.go_table = nil
    if self.cardItem then
        self.cardItem:Dispose()
        self.cardItem = nil
    end
    self.data = nil
end
function EmbattleEnemyPVEItem:Show(data)
    self.data = data
    if data.uid > 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_card, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_bg, data.boss)
        if data.boss then
            self.go_table.aorimage_bg.SpriteName = bgName.boss
        end
        if self.cardItem then
            self.cardItem:Show(data.sid, nil, data.star, data.level, data.uid)
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.levelItem,
                self.go_table.trans_card,
                _G.handler(self, self.OnItemCall)
            )
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_bg, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.trans_card, false)
    end
    self.go_table.aorimage_bg:SetNativeSize()
end

function EmbattleEnemyPVEItem:OnItemCall(item)
    self.cardItem = item
    self.cardItem:SetLocalPosition(0, 0, 0)
    self:Show(self.data)
end
--endregion

---@class EmbattleEnemyPVEView	中文描述
local EmbattleEnemyPVEView = _G.BaseClass("EmbattleEnemyPVEView")

---类的构造函数
function EmbattleEnemyPVEView:__init(go)
    self.go_table = _G.GetAutoGoTable(go)
    self.itemList = {
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos1),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos2),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos3),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos4),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos5),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos6),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos7),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos8),
        EmbattleEnemyPVEItem.New(self.go_table.obj_ePvEPos9)
    }
end

---类的析构函数
function EmbattleEnemyPVEView:Dispose()
    self.go_table = nil
    for i = 1, #self.itemList do
        self.itemList[i]:Dispose()
    end
    self.itemList = nil
end

function EmbattleEnemyPVEView:Init(item, index)
    self.curEmbattleItem = item
    self:ChangeEnemyIndex(index)
end

function EmbattleEnemyPVEView:ChangeEnemyIndex(index)
    local cardItemList = self.curEmbattleItem:GetEnemyEmbattleData(index)
    local show7, show8, show9 = false, false, false
    for i = 1, #cardItemList.heroes do
        _G.GameUtil.SetActiveByCondition(self.itemList[i].gameObject, true)
        self.itemList[cardItemList.pos[i]]:Show(cardItemList.heroes[i])
        if cardItemList.pos[i] == 7 then
            if cardItemList.heroes[i].uid > 0 then
                show7 = true
            end
        elseif cardItemList.pos[i] == 8 then
            show8 = cardItemList.heroes[i].uid > 0
        elseif cardItemList.pos[i] == 9 then
            if cardItemList.heroes[i].uid > 0 then
                show9 = true
            end
        end
    end
    if show7 then
        _G.GameUtil.SetActiveByCondition(self.itemList[1].gameObject, false)
        _G.GameUtil.SetActiveByCondition(self.itemList[2].gameObject, false)
    else
        _G.GameUtil.SetActiveByCondition(self.itemList[7].gameObject, false)
    end
    _G.GameUtil.SetActiveByCondition(self.itemList[8].gameObject, show8)
    if show9 then
        _G.GameUtil.SetActiveByCondition(self.itemList[5].gameObject, false)
        _G.GameUtil.SetActiveByCondition(self.itemList[6].gameObject, false)
    else
        _G.GameUtil.SetActiveByCondition(self.itemList[9].gameObject, false)
    end
end

return EmbattleEnemyPVEView
