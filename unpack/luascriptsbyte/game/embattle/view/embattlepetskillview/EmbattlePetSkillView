end

---展示当前已装备的宠物技
function EmbattlePetSkillView:ShowCurrentPet()
    self.go_table.obj_Content:RemoveAllChildren()
    self.go_table.obj_Content:SetLocalPositionToZero()
    --local desc = self.go_table.obj_Desc:GetComponentE(_G.typeof(_G.CS.ExtendText))
    --self.go_table.obj_Desc:SetLocalPositionToZero()
    local desc =
        _G.InstantiateObject(self.go_table.obj_Desc, self.go_table.obj_Content):GetComponentE(
            _G.typeof(_G.CS.ExtendText)
        )
    local curPetData = require("PetModel"):GetInstance():GetPet(self.curPetSelected)
    self.currentItem:SetData(curPetData)
    if curPetData then
        local lv = curPetData.star + 1
        for i, skillId in ipairs(curPetData.cfg.skill_id) do
            local cfg = _G.ConfigManager.card_skills_cfg[skillId]
            if i > 1 then
                ---@type AorText
                local aorText =
                    _G.InstantiateObject(self.go_table.obj_Desc2, self.go_table.obj_Content):GetComponentE(
                        _G.typeof(_G.CS.ExtendText)
                    )
                aorText:SetActiveE(1)
                aorText.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))

                if i > lv then
                    aorText.text =
                        _G.string.AddColor(
                            _G.string.format("%s", _G.LangUtil.GetLangPackValue(90000010475, cfg.level)) ..
                            "：" .. utils.removeColor(_G.LangUtil.GetLangPackValue(cfg.describe1)),
                            "6c615a"
                        )
                else
                    aorText.text =
                        _G.string.AddColor(_G.LangUtil.GetLangPackValue(90000010475, cfg.level), "bb500a") ..
                        "：" .. utils.removeColor(_G.LangUtil.GetLangPackValue(cfg.describe1))
                end
            else
                desc.text = utils.removeColor(_G.LangUtil.GetLangPackValue(cfg.describe1))
                desc.OnHrefClick:AddListener(_G.handlerbind(self, self.OnHrefClick))
            end
        end
    else
        desc.text = ""
    end
end

