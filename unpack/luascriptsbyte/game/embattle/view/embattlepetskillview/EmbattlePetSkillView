---展示当前按钮状态
function EmbattlePetSkillView:ShowButtonStates()
    self.go_table.aorbtn_install:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(self.curPetSelected and "FFFFFF" or "A9A9A9")
    self.go_table.aorbtn_install:SetGray(self.curPetSelected == nil)
    self.go_table.aortext_install.color =
        _G.ColorTools.FormatColorByString(self.curPetSelected and "8C2D14" or "434343")
    if not self.curPetSelected then
        self.go_table.aorbtn_install:SetActiveE(1)
        return
    end
    local curPetEquiped = self.curPets[self.curIndex]
    local noEquip = curPetEquiped == nil or curPetEquiped == 0
    local isLocked = self.disablePets and utils.includes(self.disablePets, self.curPetSelected)
    local isUsed = utils.includes(self.curPets, self.curPetSelected)

    local canReplace = not isLocked and not noEquip and not isUsed and curPetEquiped ~= self.curPetSelected or
        isLocked and self.replaceCallback

    self.go_table.aorbtn_install:SetActiveE((not isLocked and noEquip) and 1 or 0)
    self.go_table.aorbtn_replace:SetActiveE(canReplace and 1 or 0)
    self.go_table.aorbtn_uninstall:SetGray(true)
    self.go_table.aorbtn_uninstall:SetActiveE(
        (not isLocked and curPetEquiped == self.curPetSelected or isUsed) and 1 or 0
    )
end

---初始化宠物列表(可以使用的宠物)
function EmbattlePetSkillView:ShowView()
    self.petDatas = {}

    for _, d in pairs(self.allPets) do
        if d.cfg.professional == self.type then
            table.insert(self.petDatas, d)
        end
    end

    --数据排序(品质>星级)
    _G.SortList(
        self.petDatas,
        function(d)
            local disable = self.disablePets and utils.includes(self.disablePets, d.cfg.id) and 0 or 1
            return disable, d.cfg.Order, d.star
        end
    )

    if not self.curPetSelected and #self.petDatas > 0 then
        local index = self:GetEquipPetByType(self.type)
        if index > 0 then
            self.curPetSelected = self.curPets[index]
        else
            self.curPetSelected = #self.petDatas > 0 and self.petDatas[1].cfg.id or 0
        end
    end

    self.go_table.obj_nothing:SetActiveE(#self.petDatas == 0 and 1 or 0)
    self.go_table.scrollloopvectical_skill:UpdateCount(#self.petDatas)
    self.go_table.scrollloopvectical_skill:ScrollToTop()
end

---获取目标类型装备的宠物
---@param professional number   @目标宠物类型
---@return number,number   (@-1表示无穿戴, 0表示无宠物)
function EmbattlePetSkillView:GetEquipPetByType(professional)
    if not self.curPets then
        return -1, 0
    end
    for index, sid in ipairs(self.curPets) do
        if sid and sid > 0 then
            local cfg = _G.ConfigManager.pet_cfg[sid]
            if cfg and cfg.professional == professional then
                return index, sid
            end
        end
    end
    return -1, 0
end

function EmbattlePetSkillView:OnRefreshSkillItem(index, obj)
    if not self.petItems then
        self.petItems = {}
    end

    ---@type EmbattlePetSkillItem
    local item = self.petItems[obj:GetInstanceIDE()]
    if not item then
        item = EmbattlePetSkillItem.New(obj, 0)
        self.petItems[obj:GetInstanceIDE()] = item
        item:SetCallback(_G.handlerbind(self, self.OnClickItemBtn, item))
    end
    local d = self.petDatas[index + 1]
    local _, equipPetId = self:GetEquipPetByType(d.cfg.professional)
    local isLocked = self.disablePets and utils.includes(self.disablePets, d.cfg.id)

    item:SetData(d, false)
    item:SetSelected(self.curPetSelected == d.cfg.id)
    item:SetState(
        equipPetId == d.cfg.id,
        isLocked and not self.replaceCallback,
        isLocked and self.replaceCallback
    )
end

function EmbattlePetSkillView:OnRefreshSkillTypeItem(index, obj)
    if not self.typeItems then
        self.typeItems = {}
    end
    local item = self.typeItems[obj:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnClickSkillType, item))
        self.typeItems[obj:GetInstanceIDE()] = item
    end
    local idx = index + 1
    item.index = idx
    local typeId = _G.ConfigManager.discrete_cfg[105003][1][idx]
    item.aortext_label.text = _G.LangUtil.GetLangPackValue(typeId)
    item.aortext_choose.text = _G.LangUtil.GetLangPackValue(typeId)
    item.obj_select:SetActiveE(idx == self.type and 1 or 0)
    --item.obj_lock:SetActiveE(not self.posUnlockTag[idx] and 1 or 0)
end

---监听按钮回调事件
function EmbattlePetSkillView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        self:Close()
    elseif go == self.go_table.aorbtn_goto then
        if self.quiting then
            return
        end
        self.quiting = true
        --跳转灵兽召唤(关闭当前页面->关闭布阵页面->跳转灵兽召唤)
        ---@type EmbattleNewView
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
        if not view then
            return
        end
        self:Close()
        view:QuitEmbattleCheckCallback(
            function(ok)
                self.quiting = false
                if ok then
                    _G.JumpManager:GetInstance():Jump(JumpPetDrawId)
                end
            end
        )
    elseif go == self.go_table.aorbtn_install or go == self.go_table.aorbtn_replace then
        if not self.curPetSelected then
            return
        end
        ---此宠物装备在其他队伍中, 先下阵或替换其他队伍中的宠物
        local isLocked = self.disablePets and utils.includes(self.disablePets, self.curPetSelected)
        if isLocked and self.replaceCallback then
            local profession = _G.ConfigManager.pet_cfg[self.curPetSelected].professional
            local equipIndex = self:GetEquipPetByType(profession)
            if equipIndex <= 0 then
                equipIndex = self.curIndex
            end

            local newSid = self.curPets[equipIndex] or 0
            local ok = self.replaceCallback(self.curPetSelected, newSid)
            if not ok then
                return
            end
            --当前队伍的宠物数据
            if equipIndex ~= self.curIndex then
                self.curPets[equipIndex] = self.curPetSelected  --非当前选中插槽, 交换目标与其他队伍的sid
            else
                self.curPets[equipIndex] = 0
            end
            --其他队伍中的宠物
            if self.disablePets then
                utils.remove(self.disablePets, self.curPetSelected)
                if newSid > 0 then
                    table.insert(self.disablePets, newSid)
                end
            end
        end

        local profession = _G.ConfigManager.pet_cfg[self.curPetSelected].professional
        local oldEquipIndex = self:GetEquipPetByType(profession)
        if oldEquipIndex > 0 and oldEquipIndex ~= self.curIndex then
            --当前槽位穿戴的宠物id
            local oldPetId = self.curPets[self.curIndex] or 0
            --此类型装备在其他槽位中, 先下阵其他槽位中的宠物
            self.curPets[oldEquipIndex] = oldPetId
            if self.selectCallback then
                self.selectCallback(oldEquipIndex, oldPetId, true)
            end
        end

        --装备宠物
        self.curPets[self.curIndex] = self.curPetSelected
        self:ShowButtonStates()
        self:ShowView()
        if self.selectCallback then
            self.selectCallback(self.curIndex, self.curPetSelected, false)
        end
    elseif go == self.go_table.aorbtn_uninstall then
        ---ZHJH-3111 无法下阵
        -- local professional = _G.ConfigManager.pet_cfg[self.curPetSelected].professional
        -- local index = self:GetEquipPetByType(professional)
        -- self.curPets[index] = 0
        -- self:ShowButtonStates()
        -- self:ShowView()
        -- if self.selectCallback then
        --     self.selectCallback(index, 0)
        -- end
    else
        --切换组事件
        for i = 1, GroupMaxIndex do
            if go == self.go_table["aorbtn_" .. i] and self.groupChooseCallback and i ~= self.groupIndex then
                if self.groupDisable and utils.includes(self.groupDisable, i) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(3310)
                    return
                end
                self.groupChooseCallback(i, self.curIndex)
            end
        end
    end
end

