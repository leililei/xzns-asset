---@class EmbattlePetSkillItem
---@field data PetData
---@field type number 槽位默认类型, 1攻击槽位, 2防御槽位
---@field private go_table EmbattlePetSkillView._obj_skill_GoTable
---@field private callback function
local EmbattlePetSkillItem = _G.BaseClass("EmbattlePetSkillItem")

function EmbattlePetSkillItem:__init(obj, type)
    self.type = type
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---显示节点数据
---@param data PetData
function EmbattlePetSkillItem:SetData(data)
    self.data = data
    local visable = data and 1 or 0
    self.go_table.aorrawimage_icon:SetActiveE(visable)
    self.go_table.aorimage_typebg:SetActiveE(visable)
    self.go_table.aortext_name:SetActiveE(visable)
    if not data then
        self.go_table.aorimage_bg.SpriteName = PetOrderFrame[0]
        for i = 1, 5 do
            self.go_table["obj_star" .. i]:SetActiveE(0)
        end
        return
    end
    --灵兽信息
    self.go_table.aortext_name.text = _G.GetLangPackValue(data.cfg.Name)
    local order = data and data.cfg.Order or 0
    self.go_table.aorimage_bg.SpriteName = PetOrderFrame[order]
    self.go_table.aorimage_bg:SetActiveE(1)
    --灵兽技能
    local skillData = utils.findCardSkillByPetData(data)
    if not skillData then
        return
    end
    self.go_table.aorrawimage_icon:LoadImage(
        data.cfg.Icon,
        function(trans)
            trans:SetNativeSize()
        end)
    --星级
    local star = data.star
    for i = 1, 5 do
        self.go_table["obj_star" .. i]:SetActiveE(i <= star and 1 or 0)
    end
    --类型
    local bsc = _G.ConfigManager.battle_skill_cfg[skillData.skills[1]]
    self.go_table.aortext_type.text = _G.ConfigManager.language_package_cfg[bsc.Brief]
    self.go_table.aorimage_typebg:SetActiveE(1)
    local lanID
    lanID = data.cfg.pet_position1
    if lanID and lanID > 0 and self.go_table.aortext_tagName then
        --self.go_table.aorimage_skillBg.SpriteName = i == 1 and "ui_js_biaoqian_jnleixing" or "ui_js_biaoqian_zhanwei"
        self.go_table.aortext_tagName.text = _G.GetLangPackValue(lanID)
    end
end

---设置状态(需先调用SetData)
---@param used boolean @是否已装备
---@param disable boolean @显示禁用状态
---@param other boolean @是否被其他队伍使用
function EmbattlePetSkillItem:SetState(used, disable, other)
    if self.go_table.obj_used then
        self.go_table.obj_used:SetActiveE(used and 1 or 0)
    end
    if self.go_table.obj_locked then
        self.go_table.obj_locked:SetActiveE(disable and 1 or 0)
    end
    if self.go_table.obj_other then
        self.go_table.obj_other:SetActiveE(other and 1 or 0)
    end
end

---设置是否选中当前类型
function EmbattlePetSkillItem:SetSelected(active)
    if not self.go_table.obj_select then
        return
    end
    self.go_table.obj_select:SetActiveE(active and 1 or 0)
end

---设置按钮点击回调
---@param callback function
function EmbattlePetSkillItem:SetCallback(callback)
    self.callback = callback
end

---监听点击事件
function EmbattlePetSkillItem:OnClickBtn(go)
    if not self.callback then
        return
    end
    self.callback()
end

