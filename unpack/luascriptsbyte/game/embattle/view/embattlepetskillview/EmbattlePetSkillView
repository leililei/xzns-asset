---@class EmbattlePetSkillView : UIBaseView	宠物布阵选择
---@field private go_table EmbattlePetSkillView_GoTable
---@field private curPetSelected number                         当前选中的宠物
---@field private curPets number[]                      当前装备中的宠物(1表示禁用)
---@field private disablePets number[]                  已禁用的宠物(在其他场次中已使用)
---@field private allPets PetData[]                     所有宠物列表
---@field private type number                           @当前选中宠物类型:0全部, 1攻击型, 2防御型, 3辅助型
---@field private curIndex number                       @当前穿戴槽位序号
---@field private petDatas PetData[]                    所有可用(可选)宠物列表
---@field private currentItem EmbattlePetSkillItem      @当前选中的节点
---@field private petItems table<any,EmbattlePetSkillItem>    可用宠物节点
---@field private selectCallback fun(index:number, sid:number, isReplace:boolean):void    宠物装备/卸载回调
---@field private replaceCallback fun(sid:number, newSid:number):void    其他组宠物装备/卸载回调
---@field private groupIndex number                     @当前选中组的ID
---@field private groupNumber number                    @组数量
---@field private groupDisable number[]                 @已被禁用的组
---@field private groupCheckCallback fun(index:number):void     @检测组是否有可上阵宠物
---@field private groupChooseCallback fun(index:number):void    @选择组时的回调
local EmbattlePetSkillView = _G.BaseClass("EmbattlePetSkillView", _G.UIBaseView)

function EmbattlePetSkillView:OnCreate(curPets, disablePets, allPets, type, equipIndex, selectCallback, unlock)
    self.go_table.obj_group:SetActiveE(0)
    self.go_table.obj_skill:SetActiveE(0)
    --self.go_table.aorbtn_goto:SetActiveE(_G.ConfigManager.item_way_cfg[JumpPetDrawId] and 1 or 0)

    self.posUnlockTag = unlock or { true, true, true }
    self.currentItem = EmbattlePetSkillItem.New(self.go_table.obj_current, 0)

    --初始化技能列表
    self.go_table.scrollloopvectical_skill:InitItemData(0, _G.handler(self, self.OnRefreshSkillItem))

    --初始化技能类型列表
    local count = #_G.ConfigManager.discrete_cfg[105003][1]
    self.go_table.scrollloophorizontal_skillType:InitItemData(count, _G.handler(self, self.OnRefreshSkillTypeItem))

    --self:SetData(curPets, disablePets, allPets, type, selectCallback)
    _G.DelayDo(
        0.1,
        function()
            if self:IsNil() then
                return
            end
            self:SetData(curPets, disablePets, allPets, type, equipIndex, selectCallback)
        end
    )
end

function EmbattlePetSkillView:Awake()
    --初始化事件回调
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---设置当前页面状态
---@param curPets number[]
---@param disablePets number[]
---@param allPets PetData[]
---@param type number
---@param selectCallback function
---@return void
function EmbattlePetSkillView:SetData(curPets, disablePets, allPets, type, equipIndex, selectCallback)
    self.curPets = curPets or {}
    self.disablePets = disablePets or {}
    self.allPets = allPets or {}
    self.type = type or 1
    self.curIndex = equipIndex or 1
    self.selectCallback = selectCallback

    --初始化列表
    self:SetCurrentType(type)
    self:ShowCurrentPet()
    self:ShowButtonStates()
end

---设置队伍组状态, 以及切换组回调
---@param index number
---@param groupNumber number
---@param groupDisable number[]
---@param chooseCallback fun(index:number,solt:number):void
---@param checkCallback fun(index:number):boolean   @是否显示对应组的红点提示
---@return void
function EmbattlePetSkillView:SetChooseGroup(index, groupNumber, groupDisable, chooseCallback, checkCallback)
    self.groupIndex = index
    self.groupNumber = groupNumber
    self.groupDisable = groupDisable
    self.groupChooseCallback = chooseCallback
    self.groupCheckCallback = checkCallback

    --初始化节点信息
    self.go_table.obj_group:SetActiveE(1)
    for i = 1, GroupMaxIndex do
        ---@type AorButton
        local group = self.go_table["aorbtn_" .. i]
        group:SetActiveE(i <= groupNumber and 1 or 0)
        if i <= groupNumber then
            ---@type EmbattlePetSkillView._aorbtn_1_GoTable
            local groupItem = _G.GetAutoGoTable(group)
            groupItem.obj_shadow:SetActiveE(groupDisable and utils.includes(groupDisable, i) and 1 or 0)
        end
    end
    self:UpdateGroupStates()
end

---替换其他队伍中的宠物
---@param callback fun(sid:number,newSid:number):void
---@return void
function EmbattlePetSkillView:SetReplaceCallback(callback)
    self.replaceCallback = callback
end

---检测宠物组是否可上阵, 并选中当前组
---@return void
function EmbattlePetSkillView:UpdateGroupStates()
    if not self.groupIndex or not self.groupNumber then
        return
    end

    for i = 1, self.groupNumber do
        ---@type EmbattlePetSkillView._aorbtn_1_GoTable
        local groupItem = _G.GetAutoGoTable(self.go_table["aorbtn_" .. i])
        --groupItem.aorimage_que:SetActiveE(self.groupCheckCallback and self.groupCheckCallback(i) and 1 or 0)
        groupItem.obj_choose:SetActiveE(i == self.groupIndex and 1 or 0)
        --if i == self.groupIndex then
        --    self.go_table.trans_choose:SetParentE(groupItem.gameObject)
        --    self.go_table.trans_choose:SetLocalPosition(0, 0, 0)
        --end
    end
end

---设置当前选择类型
