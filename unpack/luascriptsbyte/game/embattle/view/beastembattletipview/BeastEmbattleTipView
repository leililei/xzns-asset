---@class BeastEmbattleTipView : UIBaseView	中文描述
---@field public go_table BeastEmbattleTipView_GoTable GoTable
local BeastEmbattleTipView = _G.BaseClass("BeastEmbattleTipView", _G.UIBaseView)

function BeastEmbattleTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BeastEmbattleTipView:OnCreate(data,isUp,callback,isHideBtn)
    self.data = data
    self.isUp = isUp
    self.callback = callback
    if isHideBtn then
        self.go_table.aorbtn_action:SetActiveE(0)
    end
    self:InitView()
end

function BeastEmbattleTipView:InitView()
    local item = require("ItemBeastBase").New(self.go_table.obj_item)
    item:Show(self.data:GetID(),self.data:GetStar(),function()        
    end)
    self.go_table.aortext_name.text = self.data:GetName()
    self.go_table.aortext_lv.text = _G.GetLangPackValue(90031900006,self.data:GetLevel())
    self.go_table.aortext_type.text = self.data:GetType()

    local propList = self.data:GetAttributeDict()
    local item, go
    for k, v in pairs(propList) do
        if v ~= 0 then            
            item = _G.InstantiateObject(self.go_table.obj_prop,self.go_table.obj_group)
            go = _G.GetAutoGoTable(item)
            go.aortext_name.text = _G.AttrType[k].des
            go.aortext_num.text = v
        end
    end
    local skillCfg = _G.ConfigManager.card_skills_cfg
    self.go_table.aorrawimage_icon1:LoadImage(skillCfg[self.data:GetSkill_1()[self.data:GetStar() + 1]].icon)
    local skill_3 = _G.ConfigManager.attribute_cfg[self.data:GetSkill_3()[self.data:GetStar() + 1]]
    self.go_table.aorrawimage_icon3:LoadImage(skill_3 and skill_3.icon or "")
    if self.data:GetSkill_2()[self.data:GetStar() + 1] == 0 then
        self.go_table.obj_skill2:SetActiveE(0)
    else
        self.go_table.obj_skill2:SetActiveE(1)
        self.go_table.aorrawimage_icon2:LoadImage(skillCfg[self.data:GetSkill_2()[self.data:GetStar() + 1]].icon)
    end

    self.go_table.aortext_action.text = self.isUp and _G.GetLangPackValue(90049300020) or _G.GetLangPackValue(90049300021)
end

---按钮点击事件在这里派发
function BeastEmbattleTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_action then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_skill1 then
        require("CommonTipManager"):GetInstance():OpenBeastSkillTip(self.data:GetID(), self.data:GetSkill_1()[self.data:GetStar() + 1])
    elseif go == self.go_table.aorbtn_skill2 then
        require("CommonTipManager"):GetInstance():OpenBeastSkillTip(self.data:GetID(), self.data:GetSkill_2()[self.data:GetStar() + 1])
    elseif go == self.go_table.aorbtn_skill3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.PotencyTipView.Name,self.data)
    end
end

return BeastEmbattleTipView