local EmbattleModel = require "EmbattleModel"
local EmbattleController = require "EmbattleController"
--region skillitem

local EmbattleSkillIndexItem = _G.BaseClass("EmbattleSkillIndexItem")
local shadowColor = 0.2
function EmbattleSkillIndexItem:__init(obj, index, click, dragBegin, dragEnd)
    self.onDragBegin = dragBegin
    self.onDragEnd = dragEnd
    self.onClick = click
    self.skillIndex = index
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.transform = obj
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
    self.widthScale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.SCREEN_WIDTH
    self.initPosX, self.initPosY = obj:GetLocalPosition()
end

function EmbattleSkillIndexItem:Dispose()
    self.onDragBegin = nil
    self.onDrag = nil
    self.onDragEnd = nil
    self.onClick = nil
    self.go_table = nil
    self.widthScale = nil
    self.drag = nil
    self.skillID = nil
    self.skillIndex = nil
    self.transform = nil
end

function EmbattleSkillIndexItem:OnClickBtn(go)
    if self.drag then
        return
    end
    if self.skillID == 0 then
        return
    end
    if go == self.go_table.aorbtn_drag then
        if self.active then
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_unUse, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_shadow, true)
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_unUse, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_shadow, false)
        end
        self.active = not self.active
        if self.onClick then
            self.onClick(self.skillIndex)
        end
    end
end
function EmbattleSkillIndexItem:OnDragBegin(go, ed)
    if self.skillID == 0 then
        return
    end
    self.drag = true
    if self.onDragBegin then
        self.onDragBegin(self.skillIndex)
    end
end
function EmbattleSkillIndexItem:OnDrag(go, ed)
    if not self.drag then
        return
    end
    self.transform:AddLocalPosition(
        ed.delta.x / _G.AppSetting.SCREEN_WIDTH * self.widthScale,
        ed.delta.y / _G.AppSetting.SCREEN_HEIGHT * _G.AppSetting.CONFIG_SCREEN_HEIGHT,
        0
    )
end
function EmbattleSkillIndexItem:OnDragEnd(go, ed)
    if not self.drag then
        return
    end
    self.drag = false
    if self.onDragEnd then
        self.onDragEnd(self.skillIndex)
    end
    self:ResetPos()
end
---展示技能
---@param id number 技能ID
---@param active boolean 是否激活
function EmbattleSkillIndexItem:Show(id, active)
    self.skillID = id
    self.active = active
    if id <= 0 then
        self.go_table.obj_deactive:SetActiveE(1)
        self.go_table.aorimage_skill:SetActiveE(0)
        self.go_table.obj_unUse:SetActiveE(0)
        self.go_table.obj_shadow:SetActiveE(0)
        return
    end
    self.go_table.obj_deactive:SetActiveE(0)
    self.go_table.aorimage_skill:SetActiveE(1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_unUse, not active)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_shadow, not active)
    local cfg = _G.ConfigManager.card_skills_cfg[self.skillID]
    if cfg then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_skill, cfg.icon)
    end
end
---重置位置
function EmbattleSkillIndexItem:ResetPos()
    self.transform:SetLocalPosition(self.initPosX, self.initPosY, 0)
end

--endregion

---@class EmbattleSkillIndexView : UIBaseView	中文描述
---@field public go_table EmbattleSkillIndexView_GoTable GoTable
local EmbattleSkillIndexView = _G.BaseClass("EmbattleSkillIndexView", _G.UIBaseView)

function EmbattleSkillIndexView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local click = _G.handler(self, self.OnSkillClick)
    local begin = _G.handler(self, self.OnDragBegin)
    local dragend = _G.handler(self, self.OnDragEnd)
    self.skills = {
        EmbattleSkillIndexItem.New(self.go_table.obj_skill1, 1, click, begin, dragend),
        EmbattleSkillIndexItem.New(self.go_table.obj_skill2, 2, click, begin, dragend),
        EmbattleSkillIndexItem.New(self.go_table.obj_skill3, 3, click, begin, dragend)
    }
end

---界面的入口函数
function EmbattleSkillIndexView:OnCreate(embattleData, id)
    self.embattleData = embattleData
    self.embattleType = id
    self.skillIndex, self.skillActive = EmbattleModel:GetInstance():GetSkillIndex(id)
    self.skillIDs = {0, 0, 0}
    local index = 1
    local skillID1, skillID2 = 0, 0
    for i = 1, #self.embattleData.heroes, 2 do
        if self.embattleData.heroes[i].sid > 0 and self.embattleData.heroes[i + 1].sid > 0 then
            skillID1, skillID2 =
                EmbattleController:GetInstance():GetCombSkill(
                self.embattleData.heroes[i].sid,
                self.embattleData.heroes[i + 1].sid
            )
            if skillID1 > 0 and skillID2 > 0 then
                self.skills[self.skillIndex[index]]:Show(skillID2, self.skillActive[index])
            else
                skillID2 = 0
                self.skills[self.skillIndex[index]]:Show(skillID2, self.skillActive[index])
            end
        else
            skillID2 = 0
            self.skills[self.skillIndex[index]]:Show(0, self.skillActive[index])
        end
        self.skillIDs[index] = skillID2
        index = index + 1
    end
end

---按钮点击事件在这里派发
function EmbattleSkillIndexView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        EmbattleModel:GetInstance():SetSkillIndex(
            self.embattleType,
            EmbattleModel:GetInstance():CombineSkillIndexData(self.skillIndex, self.skillActive)
        )
        self:Close()
    end
end
function EmbattleSkillIndexView:OnSkillClick(index)
    for i = 1, #self.skillIndex do
        if self.skillIndex[i] == index then
            self.skillActive[i] = not self.skillActive[i]
            break
        end
    end
end
function EmbattleSkillIndexView:OnDragBegin(index)
    self.skills[index].transform:SetParentE(self.go_table.trans_move)
end
function EmbattleSkillIndexView:OnDragEnd(index)
    self.skills[index].transform:SetParentE(self.go_table.trans_skill)
    for i = 1, #self.skills do
        if i ~= index then
            if _G.CS.UIUtils.ChecklocalPositionInRect(self.skills[index].transform, self.skills[i].transform, false) then
                local index_i, index_index
                for j = 1, #self.skillIndex do
                    if i == self.skillIndex[j] then
                        index_i = j
                    elseif index == self.skillIndex[j] then
                        index_index = j
                    end
                end
                if self.skillIDs[index_i] > 0 then
                    self.skillIndex[index_i] = self.skillIndex[index_index] + self.skillIndex[index_i]
                    self.skillIndex[index_index] = self.skillIndex[index_i] - self.skillIndex[index_index]
                    self.skillIndex[index_i] = self.skillIndex[index_i] - self.skillIndex[index_index]
                    self.skills[index]:Show(self.skillIDs[index_i], self.skillActive[index_i])
                    self.skills[i]:Show(self.skillIDs[index_index], self.skillActive[index_index])
                end
                break
            end
        end
    end
end
return EmbattleSkillIndexView
