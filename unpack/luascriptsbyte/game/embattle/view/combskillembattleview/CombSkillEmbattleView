local CombSkillText = 90114010109
local EmbattleCombSkillTipsLabel = require "EmbattleCombSkillTipsLabel"

---@class CombSkillEmbattleView : UIBaseView	中文描述
---@field public go_table CombSkillEmbattleView_GoTable GoTable
local CombSkillEmbattleView = _G.BaseClass("CombSkillEmbattleView", _G.UIBaseView)

function CombSkillEmbattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CombSkillEmbattleView:OnCreate(herodata, guardiandata, closeCall)
    self.onCloseCall = closeCall
    self:ShowSkill(herodata, guardiandata)
    _G.AudioManager.PlayAudioByAudioCfgID(2044)
end

function CombSkillEmbattleView:OnDestroy()
    if self.combSkillTipsLabel then
        self.combSkillTipsLabel:Dispose()
        self.combSkillTipsLabel = nil
    end
    if self.onCloseCall then
        self.onCloseCall()
    end

    self.heroBodyItem = nil
    self.guardianBodyItem = nil
end

---按钮点击事件在这里派发
function CombSkillEmbattleView:OnClickBtn(go)
    self:Close()
end

function CombSkillEmbattleView:ShowSkill(herodata, guardiandata)
    local heroid = herodata.sid
    local guardianid = guardiandata.sid
    local skillid1, skillid2 = require("EmbattleController"):GetInstance():GetCombSkill(heroid, guardianid)
    if skillid1 == 0 or skillid2 == 0 then
        self:Close()
        return
    end

    local cfg = _G.ConfigManager.card_skills_cfg[skillid2]
    if cfg then
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_skill, cfg.icon)
        self.go_table.aortext_skillName.text = _G.GetLangPackValue(CombSkillText) .. _G.GetLangPackValue(cfg.name1)
    else
        self:Close()
        return
    end

    self.combSkillTipsLabel = EmbattleCombSkillTipsLabel.New(self.go_table.obj_CombSkill)
    self.combSkillTipsLabel:Show(heroid, guardianid)
    self:InitCardBodyItem(
        herodata,
        self.heroBodyItem,
        self.go_table.trans_heroCard,
        function(item)
            self.heroBodyItem = item
        end
    )
    self:InitCardBodyItem(
        guardiandata,
        self.guardianBodyItem,
        self.go_table.trans_guardianCard,
        function(item)
            self.guardianBodyItem = item
        end
    )
end

function CombSkillEmbattleView:InitCardBodyItem(data, carditem, parent, callback)
    if data.uid > 0 then
        if carditem == nil then
            carditem =
                _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                parent,
                function(item)
                    item.transform:SetLocalPositionToZero()
                    item.transform:SetLocalScale(1, 1, 1)
                    callback(item)
                    item:Show({sid = data.sid, star = data.star, lv = data.level, soulLink_lv = 0})
                end
            )
        else
            _G.GameUtil.SetActiveByCondition(carditem.gameObject, true)
            carditem:Show({sid = data.sid, star = data.star, lv = data.level, soulLink_lv = 0})
        end
    else
        if carditem then
            _G.GameUtil.SetActiveByCondition(carditem.gameObject, false)
        end
    end
end

return CombSkillEmbattleView
