---界面的入口函数
function SixVsSixEmbattleView:OnCreate(item, index)
    self.Role = {}
    self.curTeam = 1
    self.cacheCardSids = EmbattleController:GetInstance():GetCacheCardSids()
    self.curEmbattleItem = item
    self.curEmbattleIndex = index or 1
    self.onBtnFuncRun = true
    self.isRecommend = false
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.EmbattleOpen, self.EmbattleOpenFinish, self)
    self:InitShackleTable()
    self:InitEmbattleView()
    self:InitDragTips()
    self:ShowDescribe()
    -- self.go_table.aorimage_battle.SpriteName = item:GetBattleImageName()
    -- self.go_table.aorimage_battle:SetNativeSize()
