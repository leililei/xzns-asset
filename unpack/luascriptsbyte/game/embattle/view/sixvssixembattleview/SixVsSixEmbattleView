---初始化场景
---@param path string 路径
---@param BattleCamera string 战斗相机路径
---@param x number 坐标X
---@param y number 坐标Y
---@param z number 坐标Z
function SixVsSixEmbattleView:InitScene(path, BattleCamera, x, y, z)
    self.sceneRoot = _G.GameObject("EmbattleRoot")
    self.sceneRoot:SetPosition(x, y, z)
    local WorldManager = _G.WorldManager:GetInstance()
    if _G.string.IsNullOrEmpty(path) then
        WorldManager:SetBaseViewVisible(false)
        local world = WorldManager:GetCurWorld()
        world:ShowOrHideAllItem(false)
        world:DisablePlayer()
        self:InitRoleModel()
        if not string.IsNullOrEmpty(BattleCamera) then
            local cameraNum = string.match(BattleCamera, "%d+")
            world.WorldSetting:ChangeCameraParams(BattleCamera, cameraNum)
        end
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    else
        _G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
        PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Static,
            self.sceneRoot,
            function(trans)
                trans:ChangeCameraAdaption()
                ---如果对话结束完需要加载布阵前剧情则
                WorldManager:SetCurrentWorldVisible(false, true)
                local AfkBattleManager = require "AfkBattleManager":GetInstance()
                if AfkBattleManager:GetFrontEmbattleStoryIsWaitLoad() then
                    ---是否是布阵前剧情
                    AfkBattleManager.isFrontEmbattleStory = false
                    _G.StoryManager:GetInstance():HideDialogueRootFullScreen()
                end
                self.curSceneTrans = trans
                trans:SetLocalPositionToZero()
                _G.TimerManager:GetInstance():GetTimer(1, self.InitRoleModel, self, true, true):Start()
                if not string.IsNullOrEmpty(BattleCamera) then
                    local cameraNum = string.match(BattleCamera, "%d+")
                    trans:GetComponentE(_G.typeof(_G.CS.WorldSetting)):ChangeCameraParams(BattleCamera, cameraNum)
                end
                _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
                if self.onInitSceneCall then
                    self.onInitSceneCall()
                end
            end
        )
    end
end
