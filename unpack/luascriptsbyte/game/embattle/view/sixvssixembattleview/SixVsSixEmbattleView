function SixVsSixEmbattleView:ChangeListType(_t)
    if self.lockElementType and #self.lockElementType > 0 then
        for i = 1, #self.lockElementType do
            if _t == self.lockElementType[i] or _t == 0 then
                break
            end
            if i == #self.lockElementType then
                _G.PopWindowManager:GetInstance():ShowAllTips(140115)
