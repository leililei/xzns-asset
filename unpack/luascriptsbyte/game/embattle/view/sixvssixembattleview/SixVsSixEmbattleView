function SixVsSixEmbattleView:InitModelDragView()
    self.modelTitleTable = {
        EmbattleViewTitle.New(self.go_table.obj_mtitle1),
        EmbattleViewTitle.New(self.go_table.obj_mtitle2),
        EmbattleViewTitle.New(self.go_table.obj_mtitle3),
        EmbattleViewTitle.New(self.go_table.obj_mtitle4),
        EmbattleViewTitle.New(self.go_table.obj_mtitle5),
        EmbattleViewTitle.New(self.go_table.obj_mtitle6),
        EmbattleViewTitle.New(self.go_table.obj_etitle1),
        EmbattleViewTitle.New(self.go_table.obj_etitle2),
        EmbattleViewTitle.New(self.go_table.obj_etitle3),
        EmbattleViewTitle.New(self.go_table.obj_etitle4),
        EmbattleViewTitle.New(self.go_table.obj_etitle5),
        EmbattleViewTitle.New(self.go_table.obj_etitle6),
        EmbattleViewTitle.New(self.go_table.obj_mtitle7)
    }
    self.moveBtns = {
        self.go_table.aorbtn_move1,
        self.go_table.aorbtn_move2,
        self.go_table.aorbtn_move3,
        self.go_table.aorbtn_move4,
        self.go_table.aorbtn_move5,
        self.go_table.aorbtn_move6
    }
    -- for i = 1, #self.moveBtns do
    --     self.moveBtns[i]:SetActiveE(0)
    -- end
    local x, y
    local pos
    self.modelDragDownHandler = _G.handler(self, self.OnDragBtnPressDown)
    self.modelDragUpHandler = _G.handler(self, self.OnDragBtnPressUp)
    self.modelDragHandler = _G.handler(self, self.OnDragBtnDrag)
    self.modelBeginDragHandler = _G.handler(self, self.OnBeginDragBtnDrag)
    self.mondelClickHandler = _G.handler(self, self.OnClick)
    local embattleData = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
    for i = 1, #embattleData do
        pos = self.attackPos[i]
        x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(pos[1], pos[2], pos[3], self.go_table.rect_moveRoot)
        self.moveBtns[i]:SetLocalPosition(x, y, 0)
        if embattleData[i].tag == 0 then
            _G.SetEventTrigger(self.moveBtns[i], "onDown", self.modelDragDownHandler)
            _G.SetEventTrigger(self.moveBtns[i], "onUp", self.modelDragUpHandler)
            _G.SetEventTrigger(self.moveBtns[i], "onDrag", self.modelDragHandler)
            _G.SetEventTrigger(self.moveBtns[i], "onDragBegin", self.modelBeginDragHandler)
            _G.SetEventTrigger(self.moveBtns[i], "onClick", self.mondelClickHandler)
        else
            self.moveBtns[i]:SetActiveE(0)
        end
    end
    if self.onMoveBtnInitDone then
        self.onMoveBtnInitDone()
        self.onMoveBtnInitDone = nil
    end
end
function SixVsSixEmbattleView:DisposeModelDragView()
    self.modelDragDownHandler = nil
    self.modelDragUpHandler = nil
    self.modelDragHandler = nil
    self.modelBeginDragHandler = nil
    self.moveBtns = nil
end
---检测按下
---@param go UnityEngine.GameObject 按钮对象
function SixVsSixEmbattleView:OnDragBtnPressDown(go, ed)
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    if self.curDragModelIndex and self.curDragModelIndex > 0 then
        return
    end
    for i = 1, #self.moveBtns do
        if self.moveBtns[i]:GetActiveSelf() == 1 then
            if go == self.moveBtns[i] then
                if not self.modelDataArray[i].tran then
                    return
                end
                --镇魂特训 (固定阵容不可移动)
                local flag, num = self.curEmbattleItem:CheckCardHandle(self.modelDataArray[i].uid)
                if not flag then
                    if num == 1 then
                        return
                    end
                end
                self.curDragModelIndex = i
                self.dragHit, self.dragPosX, self.dragPosY, self.dragPosZ =
                    _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(
                    self.centerPos[1],
                    self.centerPos[2],
                    self.centerPos[3]
                )
                if self.dragHit then
                    self:ShowDragTips(true, i)
                    self:SetModelPos(i, self.dragPosX, self.dragPosY, self.dragPosZ)
                    self.moveEffectTrans:SetActiveE(1)
                    local pos = self.modelDataArray[i].pos
                    self.moveEffectTrans:SetPosition(pos[1], pos[2], pos[3])
                end
                break
            end
        end
    end
end

---开始拖动（引导使用）
function SixVsSixEmbattleView:OnBeginDragBtnDrag()
    self.IsGuideDrag = true
end

---拖动
function SixVsSixEmbattleView:OnDragBtnDrag()
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    if not self.curDragModelIndex or self.curDragModelIndex == 0 then
        return
    end

    self.dragHit, self.dragPosX, self.dragPosY, self.dragPosZ =
        _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(self.centerPos[1], self.centerPos[2], self.centerPos[3])
    if self.dragHit then
        self:SetModelPos(self.curDragModelIndex, self.dragPosX, self.dragPosY, self.dragPosZ)
        for i = 1, #self.moveBtns do
            if self.moveBtns[i]:GetActiveSelf() == 1 and CheckMousePointInRect(self.moveBtns[i]) then -- 拖动到位置上
                self.moveEffectTrans:SetActiveE(1)
                local pos = self.modelDataArray[i].pos
                self.moveEffectTrans:SetPosition(pos[1], pos[2], pos[3])
                return
            end
        end
        self.moveEffectTrans:SetActiveE(0)
    end
end
---检测松开
---@param go UnityEngine.GameObject 按钮对象
function SixVsSixEmbattleView:OnDragBtnPressUp(go, ed)
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    ---是否是引导对应步骤
    local isGuide10013 =
        _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing and
        _G.GuideManager:GetInstance().CurGuideId == 10013
    if isGuide10013 then
        if self.IsGuideDrag then
            self.curDragModelIndex = 2
        else
            self.curDragModelIndex = 0
        end
    end
    if not self.curDragModelIndex or self.curDragModelIndex == 0 then
        return
    end
    self:ShowDragTips(false, self.curDragModelIndex)
    local curDic = self.modelDataArray[self.curDragModelIndex]
    if self.showCardListTag then -- 选人界面打开
        if not isGuide10013 then
            if CheckMousePointInRect(self.go_table.obj_choose) then -- 拖动到选人界面，下阵
                --region 镇魂特训 ，特殊阵容，手动拖拽，无法下阵
                local flag = false
                flag = self.curEmbattleItem:SetEmbattleDataSingle(self.curDragModelIndex, 0, self.curEmbattleIndex)
                if not flag then
                    local pos = curDic.pos
                    self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
                    self.curDragModelIndex = 0
                    return
                end
                --endregion
                self:ChangeModel(self.curDragModelIndex)
                self:RefreshCardList()
                self:ShowAllPower()
                self.curDragModelIndex = 0
                return
            end
        end
    end
    local dragPos = 0
    if isGuide10013 then
        dragPos = 3
    else
        for i = 1, #self.moveBtns do
            if
                i ~= self.curDragModelIndex and self.moveBtns[i]:GetActiveSelf() == 1 and
                    CheckMousePointInRect(self.moveBtns[i])
             then -- 拖动到别的位置上
                dragPos = i
                break
            end
        end
    end
    if dragPos > 0 then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        local dic = self.modelDataArray[dragPos]
        if dic.tran then -- 交换
            -- tran = curDic.shadow
            -- curDic.shadow = dic.shadow
            -- dic.shadow = tran
            local tran = curDic.tran
            curDic.tran = dic.tran
            dic.tran = tran
            curDic.sid = curDic.sid + dic.sid
            dic.sid = curDic.sid - dic.sid
            curDic.sid = curDic.sid - dic.sid
            curDic.uid = curDic.uid + dic.uid
            dic.uid = curDic.uid - dic.uid
            curDic.uid = curDic.uid - dic.uid
            curDic.lv = curDic.lv + dic.lv
            dic.lv = curDic.lv - dic.lv
            curDic.lv = curDic.lv - dic.lv
            tran = curDic.head
            curDic.head = dic.head
            dic.head = tran
            tran = curDic.effect
            curDic.effect = dic.effect
            dic.effect = tran
            local soulLinkLv = curDic.soulLinkLv
            curDic.soulLinkLv = dic.soulLinkLv
            dic.soulLinkLv = soulLinkLv
            local talents = curDic.talents
            curDic.talents = dic.talents
            dic.talents = talents
        else -- 在此上阵
            dic.tran = curDic.tran
            dic.sid = curDic.sid
            dic.lv = curDic.lv
            dic.head = curDic.head
            dic.uid = curDic.uid
            local tran = dic.effect
            dic.effect = curDic.effect
            curDic.effect = tran
            dic.soulLinkLv = curDic.soulLinkLv
            dic.talents = curDic.talents
            -- tran = dic.shadow
            -- dic.shadow = curDic.shadow
            -- curDic.shadow = tran
            curDic.tran = nil
            curDic.sid = 0
            curDic.lv = 0
            curDic.uid = 0
            curDic.head = nil
            curDic.soulLinkLv = -1
            curDic.talents = nil
        end
        local pos = dic.pos
        self:SetModelPos(dragPos, pos[1], pos[2], pos[3])
        dic.effect:SetPosition(pos[1], pos[2], pos[3])
        --dic.shadow:SetPosition(pos[1], pos[2], pos[3])
        pos = curDic.pos
        self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
        curDic.effect:SetPosition(pos[1], pos[2], pos[3])
        --curDic.shadow:SetPosition(pos[1], pos[2], pos[3])
        self.modelTitleTable[dragPos]:Show(dic.sid, dic.lv)
        self.modelTitleTable[self.curDragModelIndex]:Show(curDic.sid, curDic.lv)
        if not self.curEmbattleItem.notShowMySoulAndTalents then
            self.modelTitleTable[dragPos]:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
            self.modelTitleTable[self.curDragModelIndex]:SetSoulLinkAndTalent(curDic.soulLinkLv, curDic.talents)
        end
        -- 数据交换
        self.curEmbattleItem:ChangeCardPos(dragPos, self.curDragModelIndex, self.curEmbattleIndex)
        self.curDragModelIndex = 0
        return
    end
    local pos = curDic.pos
    self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
    self.curDragModelIndex = 0
end

function SixVsSixEmbattleView:OnClick(go, ed)
    if not self.isRecommend then
        return
    end
    local str = _G.string.replace(go:GetName(), "@_aorbtn_move", "")
    local num = _G.tonumber(str)
    local data = self.modelDataArray[num]
    if data and data.sid > 0 then
        local recordCardData = self.curEmbattleItem:GetRecordCardData(data.sid)
        ---系统推荐不点开
        if recordCardData ~= nil and recordCardData.uid ~= nil then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonOtherIllustrationsView.Name,
                recordCardData,
                function()
                    self.camera =
                        self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                        _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
                    )
                    self.interpolation = self.camera.Interpolation
                    self.camera.Interpolation = 0
                end
            )
        end
    end
end

function SixVsSixEmbattleView:SetModelPos(index, x, y, z)
    local dic = self.modelDataArray[index]
    if dic.tran then
        dic.tran:SetPosition(x, y, z)
    end
    if not _G.IsNil(dic.head) then
        x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(dic.head, self.go_table.rect_moveRoot)
        x = x < -290 and -290 or x
        x = x > 290 and 290 or x
        self.modelTitleTable[index].transform:SetLocalPosition(x, y, 0)
        if self.showDtagTipsTag then
            x, y, z = self.modelTitleTable[index].transform:GetLocalPosition()
            self.go_table.trans_tips:SetLocalPosition(x, y, z)
        end
    end
end
function SixVsSixEmbattleView:InitDragTips()
    self.go_table_tips = _G.GetAutoGoTable(self.go_table.trans_tips)
    self.go_table.trans_tips:SetActiveE(0)
    self.go_table_tips.aortext_power:SetActiveE(self.curEmbattleItem:GetShowTipsPower() and 1 or 0)
end
function SixVsSixEmbattleView:DisposeDragTips()
    self.go_table_tips = nil
end
---展示拖拽信息
---@param 变量名 变量类型 中文描述
function SixVsSixEmbattleView:ShowDragTips(show, index)
    self.showDtagTipsTag = show
    if show then
        self.go_table.trans_tips:SetActiveE(1)
        ---镇魂特训
        if
            self.curEmbattleItem.curEmbattleType ==
                (_G.EmbattleType.trainBattle + require "TrainingModel":GetInstance().Embattle_sectionId)
         then
            local MonsterCfg = _G.ConfigManager.monster_cfg[self.modelDataArray[index].uid]
            local TryGetLangValue = _G.TryGetLangValue
            self.go_table_tips.aortext_name.text = TryGetLangValue(MonsterCfg.Name)
            self.go_table_tips.aortext_power.text =
                _G.string.format(_G.GetLangPackValue(90024900045), _G.GameUtil.NumberToUnitWord(MonsterCfg.Power))
            local cardData =
                _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.modelDataArray[index].uid)
            local skin

            if cardData and cardData.skin ~= 0 then
                skin = cardData.skin
            else
                skin = 0
            end
            local Cardcfg = CardCommentManager:GetInstance():CardData(MonsterCfg.CardID, self:Recommend(skin))
            local cfg = _G.ConfigManager.type_professional_cfg[Cardcfg.Professional]
            self.go_table_tips.aortext_profession.text = TryGetLangValue(cfg.name)
            setsprite(self.go_table_tips.aorimage_profession, cfg.icon2)
        else
            local card = self.curEmbattleItem:GetCardData(self.modelDataArray[index].uid)
            --  _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.modelDataArray[index].uid)
            if card then
                local TryGetLangValue = _G.TryGetLangValue
                self.go_table_tips.aortext_name.text = TryGetLangValue(card.cfg.Name)
                self.go_table_tips.aortext_power.text =
                    _G.string.format(_G.GetLangPackValue(90024900045), _G.GameUtil.NumberToUnitWord(card:GetPower()))
                local cfg = _G.ConfigManager.type_professional_cfg[card.cfg.Professional]
                self.go_table_tips.aortext_profession.text = TryGetLangValue(cfg.name)
                setsprite(self.go_table_tips.aorimage_profession, cfg.icon2)
            end
        end
        local dic = self.modelDataArray[index]
        if dic and dic.tran then
            dic.tran:ShowDragEff(255, 255, 255, 1, 4)
        end
    else
        if self.moveEffectTrans then
            self.moveEffectTrans:SetActiveE(0)
        end
        self.go_table.trans_tips:SetActiveE(0)
        local dic = self.modelDataArray[index]
        if dic and dic.tran then
            dic.tran:HideDragEff()
        end
    end
end
