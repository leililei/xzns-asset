---展示信息
---@param sid number 卡牌SID
---@param lv number 卡牌等级
function EmbattleViewTitle:Show(sid, lv)
    if sid > 0 then
        self.transform:SetActiveE(1)
        self.go_table.aortext_level.text = lv
        local cfg = _G.ConfigManager.card_cfg[sid]
        if cfg then
            self.go_table.aorimage_element.SpriteName = elementImageName[cfg.Elements]
        end
    else
        self.transform:SetActiveE(0)
    end
end

