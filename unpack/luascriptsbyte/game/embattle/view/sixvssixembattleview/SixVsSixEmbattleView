---设置模型数据
---@param tran UnityEngine.Transform 模型
---@param notitle boolean 是否不同步头顶名称
function SixVsSixEmbattleView:SetModelData(tran, notitle)
    if self.onChangeModelCall then
        self.onChangeModelCall()
        self.onChangeModelCall = nil
    end
    local dic = self.modelDataArray[self.modelIndex]
    if not dic then
        tran:DestroyObject()
        return
    end
    if self.modelIndex < #self.modelDataArray and self.modelIndex > defaultEmbattleCount then -- 敌人
        tran:SetLocalScaleXYZ(dic.scale)
    else
        if dic.sid > 0 then
            local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, dic.uid)
            local skin

            if cardData and cardData.skin ~= 0 then
                skin = cardData.skin
            else
                skin = 0
            end
            local cfg = CardCommentManager:GetInstance():CardData(dic.sid, self:Recommend(skin))
            tran:SetLocalScaleXYZ(cfg.GlobalScale * 0.0001)
        end
    end
    dic.tran = tran
    local pos = dic.pos
    tran:SetPosition(pos[1], pos[2], pos[3])
    if pos[5] == 1 then
        tran:SetLocalEulerAngles(0, 0, 0)
    elseif pos[5] == -1 then
        tran:SetLocalEulerAngles(0, 180, 0)
    elseif pos[4] == 1 then
        tran:SetLocalEulerAngles(0, 90, 0)
    else
        tran:SetLocalEulerAngles(0, 270, 0)
    end
    dic.path = nil
    if notitle == true then
        return
    end
    local rp = tran:GetComponentE(_G.typeof(_G.CS.RolePoint))
    if rp then
        if not _G.IsNil(rp.Point_Hp) then
            dic.head = rp.Point_Hp
        elseif not _G.IsNil(rp.Point_Head) then
            dic.head = rp.Point_Head
        end
    end
    local item = self.modelTitleTable[self.modelIndex]
    item:Show(dic.sid, dic.lv)
    if not self.curEmbattleItem.notShowMySoulAndTalents and self.modelIndex <= defaultEmbattleCount then
        item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
    elseif self.curEmbattleItem.showEnemySoulAndTalents and self.modelIndex > defaultEmbattleCount then
        item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
    end
    if self.modelIndex > defaultEmbattleCount then
        item:ShowBossTag(dic.boss)
        dic.boss = nil
    end
    if not _G.IsNil(dic.head) then
        local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(dic.head, self.go_table.rect_moveRoot)
        x = x < -290 and -290 or x
        x = x > 290 and 290 or x
        item.transform:SetLocalPosition(x, y, 0)
    end
end
---创建模型回调
---@param index number 序列号
---@param call function 加载回调
---@param eff boolean 是否需要创建特效
function SixVsSixEmbattleView:CreateModelCall(index, call, eff)
    local dic = self.modelDataArray[index]
    if not dic then
        call()
        return
    end
    if eff and (index <= defaultEmbattleCount or dic.sid > 0) then
        local eff, star
        star = dic.star
        if star > 0 then
            star = CardInfoManager:GetInstance():GetOrderStarCount(star) + 1
        else
            star = 1
        end
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[starColorEffect[star]],
            self.sceneRoot,
            function(tran)
                tran.gameObject:SetActiveE(self:CheckShow(index))
                dic.effect = tran
                local pos = dic.pos
                tran:SetPosition(pos[1], pos[2], pos[3])
                -- _G.UIUtils.LoadEffectByCfg(
                --     _G.ConfigManager.ui_effect_cfg[shadowEffect],
                --     self.sceneRoot,
                --     function(shadow)
                --         dic.shadow = shadow
                --shadow:SetPosition(pos[1], pos[2], pos[3])
                if dic.path then
                    self:LoadRoleModel(dic, call, index)
                else
                    call()
                end
                --         end
                --     )
            end
        )
    else
        if dic.path then
            self:LoadRoleModel(dic, call, index)
        else
            call()
        end
    end
end

function SixVsSixEmbattleView:LoadRoleModel(dic, call, index)
    local role = _G.BattleManager:GetInstance():GetCacheRole(dic.sid, index < defaultEmbattleCount)
    if role then
        role:SetParentE(self.sceneRoot)
        if dic.gray then
            self:SetModelGray(index)
            dic.gray = nil
        end
        call(role)
    else
        self.Role[index] =
            require("CardInfoManager").GetRole(
            dic.path,
            _G.ePoolType.Static,
            self.sceneRoot,
            _G.RoleEffTypeEnum.Fight,
            function(role)
                role.gameObject:SetActiveE(self:CheckShow(index))
                if SixVsSixEmbattleView == nil then
                    self.Role[index]:Dispose()
                end
                call(role)
                if dic.gray then
                    self:SetModelGray(index)
                    dic.gray = nil
                end
            end
        )
    end
end

