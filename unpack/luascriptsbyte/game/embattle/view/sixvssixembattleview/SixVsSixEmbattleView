function SixVsSixEmbattleView:GetTeam(index)
    local pos = {}
    if index == 1 then
        insert(pos, 1)
    elseif index == 2 then
        insert(pos, 2)
        insert(pos, 3)
    elseif index == 3 then
        insert(pos, 4)
        insert(pos, 5)
        insert(pos, 6)
    else
        _G.LogError("哪来的" .. index .. "队啊")
    end
    return pos
end

---检测是否显示模型
function SixVsSixEmbattleView:CheckShow(index)
    if index == 1 then
        if self.curTeam ~= 1 then
            return 0
        end
    elseif index < 4 then
        if self.curTeam ~= 2 then
            return 0
        end
    elseif index < 7 then
        if self.curTeam ~= 3 then
            return 0
        end
    elseif index == 7 then
        if self.curTeam ~= 1 then
            return 0
        end
    elseif index < 10 then
        if self.curTeam ~= 2 then
            return 0
        end
    elseif index < 13 then
        if self.curTeam ~= 3 then
            return 0
        end
    end
    return 1
end

