end

function SixVsSixEmbattleView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.EmbattleOpen, self.EmbattleOpenFinish, self)
    self:DisposeDragTips()
    self:DisposeCardList()
    self:DisposeGroupTable()
    self:DisposeShackleTable()
    self:DisposeModelDragView()
    if self.onAnimatorDoneTimer then
        self.onAnimatorDoneTimer:Stop()
        self.onAnimatorDoneTimer = nil
    end
    self.curEmbattleItem = nil
    self.curEmbattleIndex = nil
    self.cacheCardSids = nil
end
---按钮点击事件在这里派发
function SixVsSixEmbattleView:OnClickBtn(go, isOn)
    if self.onBtnFuncRun then
        return
    end
    self.onBtnFuncRun = true
    if go == self.go_table.aorbtn_CloseView then -- 退出布阵
        if self.showCardListTag then
            self:HideCardList()
            self.onBtnFuncRun = false
        elseif self.isRecommend then
            self:BackEmbattle()
            self.onBtnFuncRun = false
        else
            if self.onQuitCallback then
                self.onQuitCallback(
                    function(quit)
                        if quit then
                            self:QuitEmbattle()
                        end
                        self.onBtnFuncRun = false
                    end
                )
            else
                self:QuitEmbattle()
            end
        end
    elseif go == self.go_table.aorbtn_ForceBattle then -- 强制战斗
        _G.PopWindowManager:GetInstance():ShowAllTips(110107)
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_clear then -- 清空布阵
        -- elseif go == self.go_table.aorbtn_formation then -- 编队
        --     _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnViewOpened, self)
        --     local type, extra = self.curEmbattleItem:GetGroupType()
        --     EmbattleController:GetInstance():OpenFormation(_G.handler(self, self.OnGroupChoose), type, extra)
        self.curEmbattleItem:ClearEmbattle(self.curEmbattleIndex)
        self:UpdateAllModel()
        self:RefreshCardList()
        self:ShowAllPower()
        local index = self.curEmbattleItem:CheckEmptyPos(self.curEmbattleIndex)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_embattleRedpoint, index > 0)
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_battle then -- 战斗
        local PopWindowManager = _G.PopWindowManager:GetInstance()
        local battle, index, noTip = self.curEmbattleItem:CheckBattle()
        if not battle then -- 不能出战
            if not noTip then
                PopWindowManager:ShowAllTips(140107)
            end
            if index then
                self:ChangeGroupShow(index)
            end
            self.onBtnFuncRun = false
            return
        end
        if self.curEmbattleItem.enemy then
            --检测敌方阵容是否为空
            local data = self.curEmbattleItem:GetEnemyEmbattleData(self.curEmbattleIndex)
            if self:CheckEmbattleEmpty(data) == false then
                self:EnemyEmptyBattle()
                return
            end
        end
        self:ChangeGroupShow(1)
        self:OnBattleClick()
    elseif go == self.go_table.aorbtn_choose then -- 布阵
        self:ShowCardList()
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_info then
        self:ShowBattleEmbattleStatistics()
    elseif go == self.go_table.aorbtn_record then
        self:ShowRecordBattle()
        self.onBtnFuncRun = false
    elseif go == self.go_table.aorbtn_unfold then
        if self.go_table.obj_move:GetActiveSelf() == 1 then
            self.go_table.obj_move:SetActiveE(0)
            self.go_table.obj_move_anniu:SetLocalPosition(0, 0, 0)
            self.go_table.obj_move:SetLocalPosition(0, 0, 0)
            _G.PlayerPrefsManager.SetInt("SixVsSix", 0)
        else
            self.go_table.obj_move:SetActiveE(1)
            self.go_table.obj_move_anniu:SetLocalPosition(-520, 0, 0)
            self.go_table.obj_move:SetLocalPosition(-520, 0, 0)
            _G.PlayerPrefsManager.SetInt("SixVsSix", 1)
        end
        self.onBtnFuncRun = false
    else
        self.onBtnFuncRun = false
    end

    if go ~= self.go_table.aorbtn_CloseView then
        if _G.CS.Launcher.Inst.IsSDK then
            local json =
                _G.Table2Json(
                {
                    role_uid = _G.tostring(_G.PlayerModel:GetInstance().role_uid),
                    role_level = _G.PlayerModel:GetInstance():GetLevel(),
                    role_vip = _G.PlayerModel:GetInstance().vipLv,
                    server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                    channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                    phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                    user_type = 1,
                    record_time = _G.TimeUtil.GetServerUnixTime(),
                    button_id = "SixVsSixEmbattleView" .. go:GetName()
                }
            )
            if _G.AppSetting.DEBUG then
                _G.Log(json, "点击布阵场景系统按钮打点")
            end
            _G.SDKManager:GetInstance():DoShushuData_track("click_prepare_system_button", json)
        end
    end
end

function SixVsSixEmbattleView:CheckEmbattleEmpty(data)
    --数据一定有6个，没有6个就一定错误
    if data == nil or data[1].sid == 0 or (data[2].sid == 0 and data[3].sid ==0) or (data[4].sid ==0 and data[5].sid ==0 and data[6].sid == 0) then
        return false
    end
    return true
end

function SixVsSixEmbattleView:EnemyEmptyBattle()
    self.curEmbattleItem:SaveEmbattle(
        function(result, ...)
            if result == 0 then
                local sixmodel = require("SixVsSixPVPModel"):GetInstance()
                sixmodel:EnterFightEmptyCall(_G.handler(self, self.EnterFightEmptyCall))
            end
        end
    )
end

function SixVsSixEmbattleView:EnterFightEmptyCall(msg)
    if msg.ack == 1 then
        local sixmodel = require("SixVsSixPVPModel"):GetInstance()
        sixmodel:OnChallengeEmptyResult(_G.handler(self, self.OnChallengeEmptyResult))
    end
end

function SixVsSixEmbattleView:OnChallengeEmptyResult(data)
    if data.ack == 1 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.BattleVictory,
            _G.UIManager:GetInstance():GetUILayerTrans("TopLayer"),
            function()
            end,
            function()
                self:QuitEmbattle()
                require("SixVsSixPVPModel"):GetInstance():UpdateData(data)
            end
        )
    end
end

function SixVsSixEmbattleView:OnBattleClick(unCheck)
    local PopWindowManager = _G.PopWindowManager:GetInstance()
    local function func()
        local animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        animator.enabled = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_huoyanbaokai_effect,
            self.go_table.aorbtn_battle,
            function()
                _G.DelayDo(
                    0.3,
                    function()
                        animator:Play("a_EmbattleView_lichang_effect")
                        if self.onEffLoadCall then
                            self.onEffLoadCall()
                        end
                    end
                )
            end,
            function()
                PopWindowManager.openToggleView = false
                _G.AudioManager.PlayAudioByAudioCfgID(2045)
                local EmbattleControllerIns = EmbattleController:GetInstance()
                EmbattleControllerIns:OnEmbattleBattle(
                    function()
                        _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
                        local root = _G.WorldManager:GetInstance():GetRoleParent()
                        local cacheModel = self.curEmbattleItem:GetCacheModelInBattle()
                        if not _G.IsNil(self.curSceneTrans) then
                            if cacheModel then
                                self.curSceneTrans:SetParentE(root, 1)
                            end
                            self.curSceneTrans = nil
                        end
                        if cacheModel then
                            local dic
                            local RemoveEffect = _G.UIUtils.RemoveEffect
                            for i = 1, #self.modelDataArray do
                                dic = self.modelDataArray[i]
                                if i == 1 or i == 7 then
                                    if dic and dic.tran and not _G.IsNil(dic.tran) then
                                        dic.tran:SetParentE(root, 1)
                                        dic.tran:ClearDragEff()
                                        dic.tran = nil
                                    end
                                    if dic and dic.effect and not _G.IsNil(dic.effect) then
                                        RemoveEffect(dic.effect, 0)
                                        dic.effect = nil
                                    end
                                else
                                    if dic and dic.tran and self.cacheCardSids[dic.sid] then
                                        require("CardInfoManager").DelRole(dic.tran, _G.ePoolType.Static)
                                        dic.tran = nil
                                    end
                                end
                            end
                        end
                        self.sceneRoot:Dispose()
                        self:Close()
                    end,
                    function()
                        self.onBtnFuncRun = false
                    end
                )
                PopWindowManager.openToggleView = true
            end
        )
    end
    func()
end

function SixVsSixEmbattleView:InitBattleEffect(callback)
    self:InitAllModelTitle()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_xunhuan_effect, self.go_table.aorbtn_battle, callback)
end

function SixVsSixEmbattleView:QuitEmbattle()
    if self.curSceneTrans then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(true, true)
        _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
        if self.interpolation and self.camera then
            self.camera.Interpolation = self.interpolation
            self.camera = nil
            self.interpolation = nil
        end
        if self.curEmbattleItem:GetCacheModelQuitEmbattle() then
            PoolsManager:GetInstance():Despawn(self.curSceneTrans, _G.ePoolType.Static)
        end
        self.curSceneTrans = nil
    else
        local WorldManager = _G.WorldManager:GetInstance()
        WorldManager:SetBaseViewVisible(true)
        local world = WorldManager:GetCurWorld()
        world:ShowOrHideAllItem(true)
        world:EnablePlayer()
        world:ChangeCameraBattle()
    end
    local dic
    for i = 1, #self.modelDataArray do
        dic = self.modelDataArray[i]
        if dic and dic.tran and self.cacheCardSids[dic.sid] then
            require("CardInfoManager").DelRole(dic.tran, _G.ePoolType.Static)
            dic.tran = nil
        end
    end
    self.sceneRoot:Dispose()
    EmbattleController:GetInstance():OnEmbattleExit(_G.handler(self, self.Close))
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name)
end
