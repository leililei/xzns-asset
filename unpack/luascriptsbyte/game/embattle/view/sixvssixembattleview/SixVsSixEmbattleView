end
function SixVsSixEmbattleView:OnClickBtnCardList(go)
    if go == self.go_table_card.aorbtn_lei then
        self:ChangeListType(elementType.Thunder)
    elseif go == self.go_table_card.aorbtn_feng then
        self:ChangeListType(elementType.Wind)
    elseif go == self.go_table_card.aorbtn_shui then
        self:ChangeListType(elementType.Water)
    elseif go == self.go_table_card.aorbtn_huo then
        self:ChangeListType(elementType.Fire)
    elseif go == self.go_table_card.aorbtn_tu then
        self:ChangeListType(elementType.Earth)
    elseif go == self.go_table_card.aorbtn_shen then
        self:ChangeListType(elementType.God)
    elseif go == self.go_table_card.aorbtn_all then
        self:ChangeListType(elementType.None)
    elseif go == self.go_table_card.aorbtn_pAll then
        self:ChangeProfListType(profType.None)
    elseif go == self.go_table_card.aorbtn_pTK then
        self:ChangeProfListType(profType.Tank)
    elseif go == self.go_table_card.aorbtn_pZS then
        self:ChangeProfListType(profType.Warrior)
    elseif go == self.go_table_card.aorbtn_pFS then
        self:ChangeProfListType(profType.Master)
    elseif go == self.go_table_card.aorbtn_pFZ then
        self:ChangeProfListType(profType.Support)
    elseif go == self.go_table_card.aorbtn_pYX then
        self:ChangeProfListType(profType.Ranger)
    elseif go == self.go_table_card.aorbtn_eAll then
        self:ChangeEquipmentListType(0)
    elseif go == self.go_table_card.aorbtn_eLiliang then
        self:ChangeEquipmentListType(equipmentType.Plank)
    elseif go == self.go_table_card.aorbtn_eMinjie then
        self:ChangeEquipmentListType(equipmentType.Coat)
    elseif go == self.go_table_card.aorbtn_eZhili then
        self:ChangeEquipmentListType(equipmentType.Cloth)
    elseif go == self.go_table_card.aorbtn_sure then
        local function func()
            local battle, index, noTip = self.curEmbattleItem:CheckBattle()
            if not battle then -- 有队伍为空
                if index == self.curTeam then
                    self:HideCardList()
                else
                    self:ChangeGroupShow(index)
                end
                self.onBtnFuncRun = false
                return
            end
            self:HideCardList()
        end
        local isEmpty = self:CheckEmptyTeamPos(self.curTeam)
        local PopWindowManager = _G.PopWindowManager:GetInstance()
        if PopWindowManager:CheckToggleWindow(900301) then
            if isEmpty then --还有可以上阵的角色
                PopWindowManager:ShowBtnWindowByToggle(
                    900301,
                    function()
                        local isAllEmpty = self:CheckAllEmpty(self.curTeam)
                        if isAllEmpty then
                            self:HideCardList()
                        end
                    end,
                    func,
                    func
                )
            else
                func()
            end
        else
            func()
        end
    elseif go == self.go_table_card.aorbtn_typeList then
        self:ShowTypeList(not self.showTypeListTag)
    end
end
---展示卡牌列表界面
function SixVsSixEmbattleView:ShowCardList()
    self.go_table.obj_choose:SetActiveE(1)
    if not self.go_table_card then
        self:InitCardList()
    end
    self:ShowBottomBtn(false)
    self:ShowGroupBtnsByOpenCardList(true)
    self.showCardListTag = true
end
---隐藏卡牌列表
---@param save boolean 是否保存
function SixVsSixEmbattleView:HideCardList(save)
    self:ShowBottomBtn(true)
    self:ShowGroupBtnsByOpenCardList(false)
    self.showCardListTag = false
    self.cardList = self.curEmbattleItem:GetCardList()
    self:UpdateCardList()
    self.go_table.obj_choose:SetActiveE(0)
end
