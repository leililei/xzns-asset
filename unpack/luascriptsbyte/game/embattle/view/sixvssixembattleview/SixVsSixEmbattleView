local EmbattleViewCardItem = _G.BaseClass("EmbattleViewCardItem")
function EmbattleViewCardItem:__init(obj, click, begin, drag, over)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.clickCall = click
    self.dragBegin = begin
    self.drag = drag
    self.dragEnd = over
    _G.SetEventTrigger(self.go_table.aorbtn_card, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_card, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_card, "onDragEnd", _G.handler(self, self.OnDragEnd))
    _G.SetEventTrigger(self.go_table.aorbtn_card, "onDeSelect", _G.handler(self, self.OnDeSelect))
    _G.SetEventTrigger(self.go_table.aorbtn_card, "onUp", _G.handler(self, self.OnUp))
end

function EmbattleViewCardItem:Dispose()
    self.clickCall = nil
    self.go_table = nil
    self.dragBegin = nil
    self.drag = nil
    self.dragEnd = nil
    self.dragTag = nil
end

function EmbattleViewCardItem:OnClickBtn(go)
    if self.dragTag then
        return
    end
    if self.grayTipsID and self.grayTipsID > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.grayTipsID)
        return
    end
    self.clickCall(self.index, self.tag, self.sameIndex)
end
function EmbattleViewCardItem:OnDragBegin(go, ed)
    self.dragTag = true
    if self.dragBegin then
        self.dragBegin(self.index, ed, self.tag)
    end
end
function EmbattleViewCardItem:OnDrag(go, ed)
    if self.drag then
        self.drag(self.index, ed, self.tag)
    end
end
function EmbattleViewCardItem:OnDragEnd(go, ed)
    if self.dragTag then
        self.dragTag = false
        if self.dragEnd then
            self.dragEnd(self.index, ed, self.tag)
        end
    end
end
---丢失手指选择
function EmbattleViewCardItem:OnDeSelect(go, ed)
    if self.dragTag then
        self.dragTag = false
        if self.dragEnd then
            self.dragEnd(self.index, ed, self.tag)
        end
    end
end
---手指抬起
function EmbattleViewCardItem:OnUp(go, ed)
    if self.dragTag then
        self.dragTag = false
        if self.dragEnd then
            self.dragEnd(self.index, ed, self.tag)
        end
    end
end
---展示卡牌
---@param index 序列号 卡牌对象
---@param data table 卡牌对象
---@param tag number 标志(0无 1以上阵 2同名角色,3已阵亡 4人数已满,5助战已满)
---@param sameIndex 不同组同名角色 保留已上阵卡牌在哪一组阵容中
function EmbattleViewCardItem:Show(index, data, tag, sameIndex, Is, showSoulTalent)
    self.index = index
    self.tag = tag
    self.sameIndex = sameIndex
    self.go_table.obj_shadow:SetActiveE(tag == EmbattleState.Embattle and 1 or 0)
    self.go_table.obj_dead:SetActiveE(tag == EmbattleState.Dead and 1 or 0)
    self.go_table.obj_sameTips:SetActiveE(
        (tag == EmbattleState.Same or tag == EmbattleState.SameInOtherGroup) and 1 or 0
    )
    self.go_table.obj_full:SetActiveE(tag == EmbattleState.Full and 1 or 0)
    local embattleItem = require "EmbattleController":GetInstance():GetCurEmbattleItem()
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_assistShadow,
        tag == EmbattleState.FullAssist or tag == EmbattleState.unPutAssist
    )
    if tag == EmbattleState.FullAssist then
        self.go_table.aortext_assist.text = _G.LangUtil.GetLangPackValue(90000010397)
    elseif tag == EmbattleState.unPutAssist then
        self.go_table.aortext_assist.text = _G.LangUtil.GetLangPackValue(90000010398)
    elseif tag == EmbattleState.SameInOtherGroup then
        self.go_table.aortext_SameTipsText.text = _G.LangUtil.GetLangPackValue(90114010126, self.sameIndex)
    elseif tag == EmbattleState.Same then
        self.go_table.aortext_SameTipsText.text = _G.LangUtil.GetLangPackValue(90024900021)
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_assist, embattleItem:CheckCardAssist(data.uid))
    if embattleItem:ShowCardHP() then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_hp, true)
        self.go_table.aorimage_hp.fillAmount = embattleItem:GetCardHPPer(data.uid)
    end
    if self.cardItem then
        self.cardItem:Show(data, nil, Is)
        if showSoulTalent then
            local soulLinkLv = -1
            if data.soulLink_IsActivate and data.soulLink_IsActivate == 1 then
                soulLinkLv = data.soulLink_lv
            end
            self.cardItem:SetSoulLinkAndTalent(soulLinkLv, data.open_inborn)
        end
    else
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.baseBodyItem,
            self.go_table.trans_root,
            function(item)
                self.cardItem = item
                self.cardItem:Show(data, nil, Is)
                if showSoulTalent then
                    local soulLinkLv = -1
                    if data.soulLink_IsActivate and data.soulLink_IsActivate == 1 then
                        soulLinkLv = data.soulLink_lv
                    end
                    self.cardItem:SetSoulLinkAndTalent(soulLinkLv, data.open_inborn)
                end
                if self.grayTag then
                    self:SetGray(true, self.grayTipsID)
                    self.grayTag = nil
                end
            end
        )
    end
end
---设置卡牌置灰
---@param gray boolean 是否置灰
---@param tips number 点击tipsid
function EmbattleViewCardItem:SetGray(gray, tips)
    self.go_table.obj_gray:SetActiveE(gray and 1 or 0)
    self.grayTipsID = gray and tips or 0
    if self.cardItem then
        -- self.cardItem:SetGray(gray)
        if gray then
            self.go_table.obj_shadow:SetActiveE(0)
            self.go_table.obj_dead:SetActiveE(0)
            self.go_table.obj_sameTips:SetActiveE(0)
            self.go_table.obj_full:SetActiveE(0)
        end
    else
        if gray then
            self.grayTag = true
        end
    end
end
