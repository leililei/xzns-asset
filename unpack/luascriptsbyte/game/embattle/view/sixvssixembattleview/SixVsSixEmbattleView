---编队界面选择
---@param data table 布阵数据
---@param skills table 技能数据
---@param edit boolean 是否编辑
---@param call function 编辑之后的回调
function SixVsSixEmbattleView:OnGroupChoose(data, edit, call, notShackle)
    local canPut, tipsId = self.curEmbattleItem:CheckGroupIsPut(data)
    if tipsId and tipsId > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsId)
    end
    if not canPut then
        return
    end
    self.onCardListHideCall = call
    self.curEmbattleItem:InitEmbattleData(data, self.curEmbattleIndex)
    self:UpdateAllModel()
    self:RefreshCardList()
    self:ShowAllPower(nil, notShackle)
    local index = self.curEmbattleItem:CheckEmptyPos(self.curEmbattleIndex)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_embattleRedpoint, index > 0)
    if edit then
        if not self.go_table_card then
            self.go_table.obj_choose:SetActiveE(1)
            self:InitCardList(EmbattleController:GetInstance():GetGroupCardList())
        else
            self.cardList = EmbattleController:GetInstance():GetGroupCardList()
            self:UpdateCardList()
        end
        self:ShowCardList()
        self.go_table.obj_group:SetActiveE(0)
    end
end

