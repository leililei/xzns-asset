    self.elementBtns = nil
    self.cardItemList = nil
    self.lockElementType = nil
    self.cardList = nil
    self.embattleCardIndexes = nil
    self.selectCardIndexes = nil
    self.deadCardIndexes = nil
    self.sameSidCardIndexes = nil
    self.showCardListTag = nil
    self.cardScrollRect = nil
    self.onChooseViewOpenCall = nil
    self.onRoleUpOrDownOpenCall = nil
