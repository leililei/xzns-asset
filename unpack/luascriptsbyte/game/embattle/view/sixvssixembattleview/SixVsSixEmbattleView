function SixVsSixEmbattleView:ChangeGroupShow(index)
    if index == self.curTeam then
        return
    end
    local team = {}
    team = self:GetTeam(index)
    local oldTeam = {}
    oldTeam = self:GetTeam(self.curTeam)
    for j = 1, #team do
        self.moveBtns[team[j]]:SetActiveE(1)
        self.modelDataArray[team[j]].effect:SetActiveE(1)
        if self.modelDataArray[team[j]].tran then
            self.modelDataArray[team[j]].tran.gameObject:SetActiveE(1)
            self.modelTitleTable[team[j]].transform:SetActiveE(1)
        end
        if self.modelDataArray[team[j] + 6].tran then
            self.modelDataArray[team[j] + 6].tran.gameObject:SetActiveE(1)
            self.modelTitleTable[team[j] + 6].transform:SetActiveE(1)
        end
        if self.modelDataArray[team[j] + 6].effect then
            self.modelDataArray[team[j] + 6].effect:SetActiveE(1)
        end
    end
    for i = 1, #oldTeam do
        if self.modelDataArray[oldTeam[i]].tran then
            self.modelDataArray[oldTeam[i]].tran.gameObject:SetActiveE(0)
        end
        if self.modelDataArray[oldTeam[i] + 6].tran then
            self.modelDataArray[oldTeam[i] + 6].tran.gameObject:SetActiveE(0)
        end
        self.moveBtns[oldTeam[i]]:SetActiveE(0)
        self.modelTitleTable[oldTeam[i]].transform:SetActiveE(0)
        self.modelTitleTable[oldTeam[i] + 6].transform:SetActiveE(0)
        self.modelDataArray[oldTeam[i]].effect:SetActiveE(0)
        if self.modelDataArray[oldTeam[i] + 6].effect then
            self.modelDataArray[oldTeam[i] + 6].effect:SetActiveE(0)
        end
    end
    self.curTeam = index
    local x, y, z = self.groupIndexBtns[index]:GetLocalPosition()
    self.go_table_group.trans_choose:SetLocalPosition(x, y, z)
    self:RefreshCardList()
    self:ChangeData(index)
    self:ShowAllPower(true)
end
