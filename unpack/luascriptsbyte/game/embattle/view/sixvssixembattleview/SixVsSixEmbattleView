function SixVsSixEmbattleView:OnCardItemCall(index, obj)
    local id = obj:GetInstanceID()
    local item = self.cardItemList[id]
    if not item then
        item =
            EmbattleViewCardItem.New(
            obj,
            _G.handler(self, self.OnCardClick),
            _G.handler(self, self.OnCardDragBegin),
            _G.handler(self, self.OnCardDrag),
            _G.handler(self, self.OnCardDragEnd)
        )
        self.cardItemList[id] = item
    end
    index = index + 1
    -- ---引导要求路径给于索引区别
    -- if _G.AppSetting.IsShowTeach and _G.GuideManager:GetInstance().IsGuideing then
    --     obj:SetName(index)
    -- end
    local i, tag, sameIndex = self:GetCardIndexAndTag(index, true)
    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.cardList[i].uid)
    local skin
    if cardData and cardData.skin ~= 0 then
        skin = cardData.skin
    else
        skin = 0
    end
    local EmbattleIs = self:Recommend(skin)
    self.cardList[i].skinIs = EmbattleIs
    item:Show(index, self.cardList[i], tag, sameIndex, nil, not self.curEmbattleItem.notShowMySoulAndTalents)
    local gray, tips = self.curEmbattleItem:GetCardGrayAndTips(self.cardList[i].uid)
    item:SetGray(gray, tips)
end

function SixVsSixEmbattleView:OnCardClick(index, tag, sameIndex)
    if self.onBtnFuncRun then
        return
    end
    if self.onCardDragBeginTag then
        return
    end
    if self.createRoleModelTag then
        return
    end
    if tag == EmbattleState.Same then -- 同名角色
        _G.PopWindowManager:GetInstance():ShowAllTips(140101)
        return
    elseif tag == EmbattleState.SameInOtherGroup then -- 同名角色但不同组
        _G.PopWindowManager:GetInstance():ShowAllTips(140118, _G.GetLangPackValue(90114010127, sameIndex))
        return
    elseif tag == EmbattleState.Full then --上阵已满
        _G.PopWindowManager:GetInstance():ShowAllTips(310109)
        return
    elseif tag == EmbattleState.Dead then --死亡角色
        return
    elseif tag == EmbattleState.Embattle then -- 下阵
        local uid =
            self.cardList[
            self.embattleCardIndexes[
                index - #self.otherAssistCardIndexs - #self.unPutassistCardIndexes - #self.fullPutassistCardIndexes
            ]
        ].uid
        local flag, num = self.curEmbattleItem:CheckCardHandle(uid)
        if not flag then
            if num then
                if num ~= 0 then
                    return
                end
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(140117)
                return
            end
        end
        local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
        for i = 1, #data do
            if data[i].uid == uid then
                if self.curEmbattleItem:SetEmbattleDataSingle(i, uid, self.curEmbattleIndex) then
                    self:ChangeModel(i)
                    self:RefreshCardList()
                    self:ShowAllPower()
                end
                break
            end
        end
    elseif tag == EmbattleState.FullAssist then --助战角色已满
        _G.PopWindowManager:GetInstance():ShowAllTips(100314)
    elseif tag == EmbattleState.unPutAssist then
        local uid = self.cardList[index].uid
        if require "FriendHelpModel":GetInstance():GetAssistType(uid) == _G.AssistType.Npc then
            _G.PopWindowManager:GetInstance():ShowAllTips(100317)
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                100315,
                _G.LangUtil.GetLangPackValue(90000010379, require "FriendHelpModel":GetInstance():GetRTSStr())
            )
        end
    else
        -- 上阵
        --镇魂特训 （特殊阵容）
        index = self:GetCardIndexAndTag(index)
        if not self.curEmbattleItem:CheckCardHandle(self.cardList[index].uid) then
            return
        end
        local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
        if self.curEmbattleItem:CheckCardAssist(self.cardList[index].uid) then
            for i = 1, #data do
                if data[i].sid == self.cardList[index].sid then -- 找空位
                    self.curEmbattleItem:SetEmbattleDataSingle(i, data[i].uid, self.curEmbattleIndex)
                    self:ChangeModel(i)
                end
            end
        end

        local teams = self:GetTeam(self.curTeam)
        for i = 1, #teams do
            if data[teams[i]].uid == 0 then -- 找空位
                if self.curEmbattleItem:SetEmbattleDataSingle(teams[i], self.cardList[index].uid, self.curEmbattleIndex) then
                    self.createRoleModelTag = true
                    self.onBtnFuncRun = true
                    self:ChangeModel(
                        teams[i],
                        self.cardList[index],
                        function()
                            self.onBtnFuncRun = false
                            self.createRoleModelTag = nil
                        end
                    )
                    self:RefreshCardList()
                    self:ShowAllPower()
                end
                break
            else
                if i == #teams then
                    _G.PopWindowManager:GetInstance():ShowAllTips(140111)
                    return
                end
            end
        end
    end
end
function SixVsSixEmbattleView:OnCardDragBegin(index, ed, tag)
    if self.onBtnFuncRun then
        return
    end
    if self.onCardDragBeginTag then
        return
    end
    self.onCardDragBeginTag = true
    local dic = self.modelDataArray[#self.modelDataArray]
    if dic then
        dic.tran = nil
        dic.path = nil
        dic.sid = 0
        dic.lv = 0
        dic.uid = 0
        dic.star = 0
        dic.soulLinkLv = -1
        dic.talents = nil
    end
    self.curDragModelIndex = 0
    index = self:GetCardIndexAndTag(index)
    if not self.curEmbattleItem:CheckCardHandle(self.cardList[index].uid) then
        self.dragStoryRoleTag = true
    end
    self.cardScrollRect:OnBeginDrag(ed)
end
function SixVsSixEmbattleView:OnCardDrag(index, ed, tag)
    if not self.onCardDragBeginTag then
        return
    end
    if
        tag and
            (tag == EmbattleState.SameInOtherGroup or tag == EmbattleState.Same or tag == EmbattleState.Dead or
                tag == EmbattleState.Full or
                tag == EmbattleState.FullAssist or
                tag == EmbattleState.unPutAssist) or
            self.dragStoryRoleTag
     then
        self.cardScrollRect:OnDrag(ed)
        return
    end
    if self.curDragModelIndex > 0 then -- 已找到模型(上阵)
        self:OnDragBtnDrag()
        return
    end
    if self.dragCreateModelTag == nil then
        self.cardScrollRect:OnDrag(ed)
        if not CheckMousePointInRect(self.go_table.obj_choose) then -- 创建模型
            self.dragCreateModelTag = true
        end
    end
    if self.dragCreateModelTag then -- 需要创建角色了
        local dic, data
        if
            index > #self.otherAssistCardIndexs + #self.unPutassistCardIndexes + #self.fullPutassistCardIndexes and
                index - #self.otherAssistCardIndexs - #self.unPutassistCardIndexes - #self.fullPutassistCardIndexes <=
                    #self.embattleCardIndexes
         then -- 已上阵角色
            data =
                self.cardList[
                self.embattleCardIndexes[
                    index - #self.otherAssistCardIndexs - #self.unPutassistCardIndexes - #self.fullPutassistCardIndexes
                ]
            ]
            for i = 1, defaultEmbattleCount do
                dic = self.modelDataArray[i]
                if dic.sid and dic.sid == data.sid then
                    self.curDragModelIndex = i
                    self:ShowDragTips(true, i)
                    self:OnDragBtnDrag()
                    return
                end
            end
        else -- 未上阵角色
            dic = self.modelDataArray[#self.modelDataArray]
            if not dic then
                self.modelDataArray[#self.modelDataArray] = {}
                dic = self.modelDataArray[#self.modelDataArray]
            end
            local pos = self:GetCardIndexAndTag(index)
            data = self.cardList[pos]
            dic.sid = data.sid
            dic.lv = data:GetLevel()
            dic.uid = data.uid
            local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
            local skin

            if cardData and cardData.skin ~= 0 then
                skin = cardData.skin
            else
                skin = 0
            end
            dic.path = require "CardInfoManager".GetBattleModelPath(data.sid, self:Recommend(skin))
            dic.star = data:GetStar()
            dic.soulLinkLv = (data.soulLink_IsActivate and data.soulLink_IsActivate == 1) and data.soulLink_lv or -1
            dic.talents = data.open_inborn
            self.dragCreateModelTag = false
            self:CreateModelCall(
                #self.modelDataArray,
                function(tran)
                    if self.dragCreateModelTag ~= false then -- 已经松开
                        tran:DestroyObject()
                        return
                    end
                    dic.tran = tran
                    local rp = tran:GetComponentE(_G.typeof(_G.CS.RolePoint))
                    if rp then
                        if not _G.IsNil(rp.Point_Hp) then
                            dic.head = rp.Point_Hp
                        elseif not _G.IsNil(rp.Point_Head) then
                            dic.head = rp.Point_Head
                        end
                    end
                    local cardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, dic.uid)
                    local skin
                    if cardData and cardData.skin ~= 0 then
                        skin = cardData.skin
                    else
                        skin = 0
                    end
                    local cfg = CardCommentManager:GetInstance():CardData(dic.sid, self:Recommend(skin))
                    tran:SetLocalScaleXYZ(cfg.GlobalScale * 0.0001)
                    self.curDragModelIndex = #self.modelDataArray
                    local item = self.modelTitleTable[self.curDragModelIndex]
                    item:Show(dic.sid, dic.lv)
                    if not self.curEmbattleItem.notShowMySoulAndTalents then
                        item:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
                    end
                    self.modelDataArray[self.curDragModelIndex] = dic
                    self:ShowDragTips(true, self.curDragModelIndex)
                    self:OnDragBtnDrag()
                end
            )
        end
    end
end
---卡牌拖拽结束
---@param index number 拖动的卡牌序列号
---@param ed  UnityEngine.EventSystems.PointerEventData 拖动的卡牌序列号
---@param tag EmbattleState 卡牌标识
function SixVsSixEmbattleView:OnCardDragEnd(index, ed, tag)
    if not self.onCardDragBeginTag then
        return
    end
    self.onCardDragBeginTag = false
    self.cardScrollRect:OnEndDrag(ed)
    if
        tag and
            (tag == EmbattleState.SameInOtherGroup or tag == EmbattleState.Same or tag == EmbattleState.Dead or
                tag == EmbattleState.Full) or
            self.dragStoryRoleTag
     then
        self.dragStoryRoleTag = nil
        self.dragCreateModelTag = nil
        return
    end
    if self.curDragModelIndex > 0 and not _G.IsNil(self.modelDataArray[self.curDragModelIndex].tran) then
        self:ShowDragTips(false, self.curDragModelIndex)
        if self.curDragModelIndex <= defaultEmbattleCount then -- 已上阵角色
            self:OnDragBtnPressUp()
        else -- 新角色
            local curDic = self.modelDataArray[self.curDragModelIndex]
            local pos = self:GetCardIndexAndTag(index)
            for i = 1, #self.moveBtns do
                if self.moveBtns[i]:GetActiveSelf() == 1 and CheckMousePointInRect(self.moveBtns[i]) then -- 新上阵角色
                    local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
                    for j = 1, #data do
                        if data[j].sid == curDic.sid then -- 找相同
                            self.curEmbattleItem:SetEmbattleDataSingle(j, data[j].uid, self.curEmbattleIndex)
                            self:ChangeModel(j)
                        end
                    end
                    -- 上阵
                    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
                    if self.curEmbattleItem:SetEmbattleDataSingle(i, curDic.uid, self.curEmbattleIndex) then
                        self:ChangeModel(i, self.cardList[pos])
                        self:RefreshCardList()
                        self:ShowAllPower()
                    end
                    self:ClearModelCall(self.curDragModelIndex)
                    self.dragCreateModelTag = nil
                    self.curDragModelIndex = 0
                    return
                end
            end
            self.modelTitleTable[self.curDragModelIndex]:Show(0)
            self:ClearModelCall(self.curDragModelIndex)
        end
