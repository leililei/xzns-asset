function SixVsSixEmbattleView:InitCardListGoTable()
    if not self.go_table_card then
        ---@type EmbattleView._obj_choose_GoTable
        self.go_table_card = _G.GetAutoGoTable(self.go_table.obj_choose, _G.handler(self, self.OnClickBtnCardList))
        self.elementBtns = {
            self.go_table_card.aorbtn_all,
            self.go_table_card.aorbtn_lei,
            self.go_table_card.aorbtn_feng,
            self.go_table_card.aorbtn_shui,
            self.go_table_card.aorbtn_huo,
            self.go_table_card.aorbtn_tu,
            self.go_table_card.aorbtn_shen
        }
        self.profBtns = {
            self.go_table_card.aorbtn_pAll,
            self.go_table_card.aorbtn_pTK, --1
            self.go_table_card.aorbtn_pZS, --2
            self.go_table_card.aorbtn_pFS, --3
            self.go_table_card.aorbtn_pFZ, --4
            self.go_table_card.aorbtn_pYX --5
        }
        self.equipmentBtns = {
            self.go_table_card.aorbtn_eAll,
            self.go_table_card.aorbtn_eLiliang,
            self.go_table_card.aorbtn_eMinjie,
            self.go_table_card.aorbtn_eZhili
        }
        self.elementViewSort = {
            elementType.None,
            elementType.Thunder,
            elementType.Wind,
            elementType.Water,
            elementType.Fire,
            elementType.Earth,
            elementType.God
        }
        self.go_table_card.scrollloophorizontal_card:InitItemData(0, _G.handler(self, self.OnCardItemCall))
        self.cardScrollRect =
            self.go_table_card.scrollloophorizontal_card:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
        self.lockElementType = self.curEmbattleItem:GetLockElement()
        if self.lockElementType and #self.lockElementType > 0 then
            local lockTab = {}
            for i = 1, #self.lockElementType do
                lockTab[self.lockElementType[i]] = true
            end
            for i = 2, #self.elementViewSort do
                if not lockTab[self.elementViewSort[i]] then
                    self.elementBtns[i]:SetAorImageColor(0.5, 0.5, 0.5, 1)
                end
            end
        end
        ---卡牌展示对象table
        self.cardItemList = {}
        ---被筛选出来的卡牌序列号组
        self.selectCardIndexes = {}
        ---已上阵的卡牌序列组
        self.embattleCardIndexes = {}
        ---死亡的卡牌
        self.deadCardIndexes = {}
        ---相同SID的卡牌
        self.sameSidCardIndexes = {}
        ---已上阵助战卡牌序列号组
        self.assistCardIndexes = {}
    end
end
