    cfg = _G.ConfigManager.pos_cfg[cfg.pos]
    self.attackPos = _G.DeepCopyCfgTable(cfg.AttackerPos)
    for i = 1, #self.attackPos do
        self.attackPos[i][1] = self.attackPos[i][1] + self.centerPos[1]
        self.attackPos[i][2] = self.attackPos[i][2] + self.centerPos[2]
        self.attackPos[i][3] = self.attackPos[i][3] + self.centerPos[3]
    end
    self.defencePos = _G.DeepCopyCfgTable(cfg.DefenserPos)
    for i = 1, #self.defencePos do
        self.defencePos[i][1] = self.defencePos[i][1] + self.centerPos[1]
        self.defencePos[i][2] = self.defencePos[i][2] + self.centerPos[2]
        self.defencePos[i][3] = self.defencePos[i][3] + self.centerPos[3]
