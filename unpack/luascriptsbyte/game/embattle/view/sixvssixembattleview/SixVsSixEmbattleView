function SixVsSixEmbattleView:OnResInitDone()
    _G.TimerManager:GetInstance():GetTimer(3, self.OnInitDoneTimerCall, self, true, true):Start()
end

function SixVsSixEmbattleView:OnInitDoneTimerCall()
    local animator = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    animator.enabled = true

    if self.onInitDoneCall then
        self.onInitDoneCall()
    end
    self.animationCanvasGroup = self.go_table.obj_topright:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    self.onAnimatorDoneTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnInitAnimatorDoneCall, self, false, true)
    self.onAnimatorDoneTimer:Start()
end

function SixVsSixEmbattleView:EmbattleOpenFinish(guid)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
    if self.curEmbattleItem:IsShowChat() and _G.PlayerModel:GetInstance():CheckCreateRole() then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChatDefultRootView.Name, {x = 45, y = 108})
