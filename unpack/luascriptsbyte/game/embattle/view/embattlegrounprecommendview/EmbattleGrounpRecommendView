--region 排位item
local EmbattleGrounpRecommendItem = _G.BaseClass("EmbattleGrounpRecommendItem")
local UIUtils = _G.UIUtils
function EmbattleGrounpRecommendItem:__init(obj, index)
    self.obj = obj
    ---@type _obj_Rank._obj_rankItem_GoTable
    self.go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem))
    local x, y, z = self.go_table.aorimage_sign:GetLocalPosition()
    self.posX = x
    self.posY = y
    self.posZ = z
end
function EmbattleGrounpRecommendItem:Dispose()
    self.go_table = nil
    self.data = nil
end
---显示
---@param data table 排行榜单个数据
---@param type string 类型
function EmbattleGrounpRecommendItem:Show(data, index, call, call_close)
    self.call = call
    self.callClose = call_close
    ---@type number
    self.index = index
    ---@type afk.i_afk_recommend
    self.recommendData = data
    UIUtils.SetPlayerHeadItemNew(self.go_table.obj_HeadItemBase, data, 0.7, true)
    self:ShowTeam(self.go_table.trans_cardnode, data.g_info[1].c_info)
    self:ShowSkill(data.g_info[1].combine_skill)
    self.go_table.aorbtn_huifang:SetActiveE(1)
    self.go_table.obj_Frame:SetActiveE(index == 1 and 1 or 0)
    if data.uid == 0 then
        self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(90026800002)
        self.go_table.obj_name_power:SetActiveE(0)
    else
        if index == 1 then
            ---首通者
            self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(90026800001)
        else
            self.go_table.aortext_desc.text = _G.LangUtil.GetLangPackValue(90026800003)
        end
        self.go_table.obj_name_power:SetActiveE(1)
    end
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_power.text = _G.UIUtils.NumberToUnitStr_CardFightNum(data.power)
end
function EmbattleGrounpRecommendItem:OnClickItem(go)
    if self.go_table.aorbtn_huifang == go then
        if self.call then
            self.call(
                self.index,
                self.recommendData,
                function()
                    if self.callClose then
                        self.callClose()
                    end
                end
            )
        end

        if _G.CS.Launcher.Inst.IsSDK then
            local json =
                _G.Table2Json(
                {
                    role_uid = _G.PlayerModel:GetInstance().role_uid,
                    role_level = _G.PlayerModel:GetInstance():GetLevel(),
                    role_vip = _G.PlayerModel:GetInstance().vipLv,
                    server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                    channel_id = _G.ServerManager:GetInstance().AppInfo.Platform,
                    phone_device = tostring(_G.ServerManager:GetInstance().AppInfo.DeviceID),
                    user_type = 1,
                    record_time = _G.TimeUtil.GetServerUnixTime()
                }
            )
            if _G.AppSetting.DEBUG then
                _G.Log(json, "点击通关录影阵容按钮打点")
            end
            _G.SDKManager:GetInstance():DoShushuData_track("click_video_lineup_button", json)
        end
    end
end

function EmbattleGrounpRecommendItem:ShowSkill(data)
    local tb = _G.GetAutoGoTable(self.go_table.obj_combSkill)
    for i = 1, 3 do
        if data[i] ~= 1 then
            local skill = _G.GetAutoGoTable(tb["obj_skill" .. i])
            local sid = data[i].id
            local lv = data[i].lv
            local cfg = _G.ConfigManager.combine_cfg[sid]
            local type
            if not cfg then
                cfg = _G.ConfigManager.card_skills_cfg[sid]
                type = require "CombineModel":GetInstance():GetTypeWithSkillId(sid)
            else
                type = cfg.classify
                sid = cfg.skills[lv]
                cfg = _G.ConfigManager.card_skills_cfg[cfg.skills[lv > 0 and lv or 1]]
            end

            skill.aortext_name.text = _G.GetLangPackValue(cfg.name1)
            skill.aorrawimage_icon:LoadImage(
                    cfg.icon,
                    function(image)
                        image:SetNativeSize()
                    end
            )
            skill.aorimage_typebg:SetActiveE(1)
            skill.aorimage_typebg2:SetActiveE(1)
            skill.aortext_type2.text = _G.GetLangPackValue(_G.ConfigManager.discrete_cfg[105003][1][type])
            cfg = _G.ConfigManager.battle_skill_cfg[cfg.skills[1]]
            skill.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
        end
    end
end

function EmbattleGrounpRecommendItem:ShowTeam(parent, data)
    if parent:GetChildCountE() > 0 then
        for i = 1, parent:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(parent:GetChildE(0), _G.ePoolType.UIItem)
        end
    end
    for i = 1, 5 do
        if data[i] then
            local cardData = data[i]
            if cardData.sid > 0 then
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                    parent,
                    function(item)
                        item:Show(cardData.sid, nil, cardData.star, cardData.soul_lv, cardData.level, nil, nil, cardData.soul_state, cardData.born_skill_num)
                    
                    end
                )
            end
        end
    end
end
--endregion

---@class EmbattleGrounpRecommendView : UIBaseView	中文描述
---@field public go_table EmbattleGrounpRecommendView_GoTable GoTable
---@field recommendDatas afk.i_afk_recommend[]
local EmbattleGrounpRecommendView = _G.BaseClass("EmbattleGrounpRecommendView", _G.UIBaseView)
function EmbattleGrounpRecommendView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data afk.s2c_get_afk_recommend
function EmbattleGrounpRecommendView:OnCreate(data, call, title, type)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.EmbattleGrounpRecommendView, self.go_table)
    self.recommendDatas = data or {}
    self.call = call
    self.title = title
    self.type = type
    self:InitRank()
end

---界面的销毁函数
function EmbattleGrounpRecommendView:OnDestroy()
    if self.rankItemTab then
        for _, value in pairs(self.rankItemTab) do
            value:Dispose()
        end
        self.rankItemTab = nil
    end
end

---按钮点击事件在这里派发
function EmbattleGrounpRecommendView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

function EmbattleGrounpRecommendView:InitRank()
    local text
    if self.type == "Afk" then
        local cfg = _G.ConfigManager.afk_cfg[require("AfkModel"):GetInstance():GetCurSection()]
        text = _G.GetLangPackValue(
                90027300044,
                cfg.chapter,
                cfg.section
        )
    elseif self.type == "Tower" then
        local cfg = _G.ConfigManager.tower_cfg[require("DeadsoulTowerModel"):GetInstance():GetCurTowerSid()]
        text = _G.GetLangPackValue(cfg.tower == 9 and 90000011279 or 90000011279 + cfg.tower, cfg.layer)
    end
    self.go_table.aortext_Process.text = text
    if self.recommendDatas == nil or #self.recommendDatas == 0 then
        self.go_table.scrollloopvectical_rankList:SetActiveE(0)
        self.go_table.obj_no:SetActiveE(1)
        if _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.EmbattleGrounpRecommendView, "obj_cardSpine") then
            return
        end
        local cfg = _G.ConfigManager.card_cfg[111010000]
        _G.PoolsManager:GetInstance():Spawn(
                cfg.ModelPathHi,
                _G.ePoolType.Temporary,
                self.go_table.obj_cardSpine,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                    trans:SetLocalScaleXYZ(cfg.size7)
                end
        )
    else
        self.go_table.scrollloopvectical_rankList:SetActiveE(1)
        self.go_table.obj_no:SetActiveE(0)
        self.rankItemTab = {}
        self:OnRankListCall(self.recommendDatas)
    end
end
function EmbattleGrounpRecommendView:OnRankListCall(list)
    self.rankDataList = list
    self.go_table.scrollloopvectical_rankList:InitItemData(#list, _G.handler(self, self.OnRankRefresh))
end
function EmbattleGrounpRecommendView:OnRankRefresh(index, obj)
    if index < 0 then
        return
    end
    local id = obj:GetInstanceIDE()
    local item = self.rankItemTab[id]
    index = index + 1
    if not item then
        item = EmbattleGrounpRecommendItem.New(obj, index)
        self.rankItemTab[id] = item
    end
    item:Show(self.rankDataList[index], index, self.call, _G.handler(self, self.Close))
end

return EmbattleGrounpRecommendView
