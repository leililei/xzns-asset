local CommonTipManager = require "CommonTipManager"
local EmbattleController = require "EmbattleController"
---@class EmbattleCombSkillView	中文描述
local EmbattleCombSkillView = _G.BaseClass("EmbattleCombSkillView")

function EmbattleCombSkillView:__init(go, onIconClick)
    self.gameObj = go
    self.go_table = _G.GetAutoGoTable(go, _G.handler(self, self.OnClick))
    self.hero = 0
    self.guardian = 0
    self.skillID = 0
    self.onHeadIconClick = onIconClick
end
function EmbattleCombSkillView:Dispose()
    self.go_table = nil
    self.hero = nil
    self.guardian = nil
    self.skillID = nil
    self.gameObj = nil
end
function EmbattleCombSkillView:OnClick(go)
    if go == self.go_table.aorbtn_skill then
        --技能
        if self.skillID <= 0 then
            return
        end
        local posx, posy, posz = self.go_table.aorbtn_skill:GetPosition()
        local pos = {x = posx, y = posy, z = posz}
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CombSkillTipsView.Name,
            self.hero,
            self.guardian,
            nil,
            pos
        )
    end
end

---展示合击技能
---@param heroid number 寄灵人sid
---@param guardianid number 守护灵sid
---@param combIndex number 组合序列号
function EmbattleCombSkillView:Show(hero, guardian, combIndex)
    self.curCombIndex = combIndex
    self.hero = hero
    self.guardian = guardian
    self:ShowSkill(hero.sid, guardian.sid)
end
function EmbattleCombSkillView:ShowSkill(heroid, guardianid)
    if heroid == 0 or guardianid == 0 then
        self.skillID = 0
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skill, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, false)
        return
    end
    local skillid1, skillid2 = EmbattleController:GetInstance():GetCombSkill(heroid, guardianid)
    if skillid1 == 0 then
        self.skillID = 0
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skill, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, true)
        return
    end
    self.skillID = skillid2
    local cfg = _G.ConfigManager.card_skills_cfg[self.skillID]
    if cfg then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skill, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, false)
        _G.UIUtils.SetAorImageByPath(self.go_table.aorimage_skill, cfg.icon)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_skill, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lock, true)
    end
end

return EmbattleCombSkillView
