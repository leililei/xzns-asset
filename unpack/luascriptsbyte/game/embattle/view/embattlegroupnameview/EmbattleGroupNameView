---@class EmbattleGroupNameView : UIBaseView	中文描述
---@field public go_table EmbattleGroupNameView_GoTable GoTable
local EmbattleGroupNameView = _G.BaseClass("EmbattleGroupNameView", _G.UIBaseView)

function EmbattleGroupNameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EmbattleGroupNameView:OnCreate(callback, name, group, index)
    self.callback = callback
    self.group = group
    self.index = index
    self:initChangeName(name)
end

function EmbattleGroupNameView:initChangeName(name)
    self.go_table.input_Name.text = name
    local cfg = _G.ConfigManager.discrete_cfg[126801][1]
    local limitNum = _G.GameUtil.GetIsUseChinese() and cfg[1] or cfg[2]
    _G.GameUtil.InputFieldCharacterLimit(
            self.go_table.input_Name,
            limitNum,
            nil,
            true,
            nil,
            nil,
            true
    )
end

---按钮点击事件在这里派发
function EmbattleGroupNameView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_enter" then
        self:EnterName()
    end
end
---确定
function EmbattleGroupNameView:EnterName()
    local name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(name) then
        _G.PopWindowManager:GetInstance():ShowAllTips(1313)
        return
    end
    if name:getStringCharCount() > _G.ConfigManager.discrete_cfg[126801][1][1] then
        return
    end
    require("EmbattleController"):GetInstance():UpdatePreFormationName(self.group, self.index, name, _G.handler(self, self.EnterNameCallBack))
end

function EmbattleGroupNameView:EnterNameCallBack()
    local name = self.go_table.input_Name.text
    if _G.string.IsNullOrEmpty(name) then
        return
    end
    if self.callback then
        self.callback(self.go_table.input_Name.text)
    end
    self:Close()
end

return EmbattleGroupNameView
