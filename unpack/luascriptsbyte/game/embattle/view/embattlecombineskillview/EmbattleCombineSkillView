    self.go_table = nil
    self.index = nil
    self.sid = nil
    self.skillType = nil
    self.gameObject = nil
end

function EmbattleCombineSkillItem:OnClickBtn(go)
    if self.clickTipsID and self.clickTipsID > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(self.clickTipsID)
