        _G.GameUtil.SetActiveByCondition(self.go_table.obj_CombineDes, false)
        return
    end
    self:ShowCombineIcon(data)
    self:ShowSkillDes(data)
    self:ShowBtns(data)
end

---显示合击技图标
function EmbattleCombineSkillView:ShowCombineIcon(data)
    local sid = data[1]
    local lv = data[2]
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_CombineDes, true)
    local cfg = _G.ConfigManager.combine_cfg[sid]
    local type
    if not cfg then
        cfg = _G.ConfigManager.card_skills_cfg[sid]
        type = require "CombineModel":GetInstance():GetTypeWithSkillId(sid)
    else
        type = cfg.classify
        sid = cfg.skills[lv]
        cfg = _G.ConfigManager.card_skills_cfg[cfg.skills[lv > 0 and lv or 1]]
    end
    self.go_table.aorrawimage_icon:LoadImage(cfg.icon)
    self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.name1)
    if type and self.go_table.aortext_type2 then
        self.go_table.aortext_type2.text = _G.LangUtil.GetLangPackValue(ConfigManager.discrete_cfg[105003][1][type])
    end
    cfg = ConfigManager.battle_skill_cfg[cfg.skills[1]]
    self.go_table.aortext_type.text = ConfigManager.language_package_cfg[cfg.Brief]
end

---更新合击技装备显示
function EmbattleCombineSkillView:ShowBtns(data)
    ---@type combine_cfg
    local cfg = _G.ConfigManager.combine_cfg[data[1]]
    if not cfg then
        return
    end
    local isEquip = self.equipSkills[cfg.classify].id == data[1]
    if self.equipSkills[cfg.classify].id > 0 and self.equipSkills[cfg.classify].tag == 1 then
        isEquip = true
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_equip, not isEquip and data[2] ~= 0)
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_change,
        not isEquip and (self.equipSkills[cfg.classify].id ~= 0 or (self.usedSkill and self.usedSkill[data[1]])) and
        data[2] ~= 0
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_equiped, isEquip and data[2] ~= 0)
end

---显示技能效果
function EmbattleCombineSkillView:ShowSkillDes(data)
    local combineCfg = _G.ConfigManager.combine_cfg[data[1]]
    self.go_table.obj_Content:RemoveAllChildren();
    local tb = {}
    local count = 1
    for i = 1, #combineCfg.skills do
        tb[combineCfg.skills[i]] = combineCfg.skills[i]
        if combineCfg.skills[i] ~= combineCfg.skills[1] and count == 1 then
            count = i
        end
    end
    tb = _G.table.toArray(tb)
    _G.table.sort(
        tb,
        function(a, b)
            return a < b
        end
    )
    local lv = _G.math.floor(data[2] / count) + 1
    for i, v in ipairs(tb) do
        ---@type card_skills_cfg
        local cfg = _G.ConfigManager.card_skills_cfg[v]
        if i > 1 then
            ---@type AorText
            local aorText = _G.InstantiateObject(self.go_table.aortext_Desc2, self.go_table.obj_Content):GetComponentE(
                _G.typeof(_G.CS.AorText))
            aorText:SetActiveE(1)
            if i > lv then
                aorText.text =
                    _G.string.AddColor(
                        _G.string.format("%s", _G.LangUtil.GetLangPackValue(9002050018, cfg.level)) ..
                        "：" .. self:RemoveColor(_G.LangUtil.GetLangPackValue(cfg.describe1)),
                        "6c615a"
                    )
            else
                aorText.text =
                    _G.string.AddColor(_G.LangUtil.GetLangPackValue(9002050018, cfg.level), "bb500a") ..
                    "：" .. self:RemoveColor(_G.LangUtil.GetLangPackValue(cfg.describe1))
            end
        else
            self.go_table.aortext_Desc.text = self:RemoveColor(_G.LangUtil.GetLangPackValue(cfg.describe1))
        end
    end
end

function EmbattleCombineSkillView:RemoveColor(str)
    local str1 = _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#14874a>")
    return str1
end

