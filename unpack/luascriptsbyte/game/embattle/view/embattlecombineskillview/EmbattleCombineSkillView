---按钮点击事件在这里派发
function EmbattleCombineSkillView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_bg then
        if self.closeBtnCall then
            self.closeBtnCall()
        else
            self:TryDoCloseCall()
            self:Close()
        end
    elseif go == self.go_table.aorbtn_equip then
        self:EquipSkill(self.curChooseElementType, self.skillData[self.chooseIndexList[self.chooseIndex]][1])
        self:TryDoCloseCall()
    elseif go == self.go_table.aorbtn_change then
        self:EquipSkill(self.curChooseElementType, self.skillData[self.chooseIndexList[self.chooseIndex]][1])
        self:TryDoCloseCall()
    end
end

---执行关闭回调(但不关闭，同步刷新父页面显示用)
function EmbattleCombineSkillView:TryDoCloseCall()
    if self.closeCall then
        if self.callbackNumber then
            local equipSkillsId = {}
            for i = 1, #self.equipSkills do
                equipSkillsId[i] = self.equipSkills[i].id
            end
            self.closeCall(equipSkillsId, self.swapSkills)
        else
            self.closeCall(self.equipSkills, self.swapSkills)
        end
    end
end

