---展示技能
---@param index number 序列号
---@param sid number 技能ID
---@param lv number 等级
---@param _type combSkillType 类型\
---@param isChoose boolean 是否被选中
function EmbattleCombineSkillItem:Show(index, sid, lv, _type)
    self.index = index
    self.sid = sid
    self.skillType = _type
    if sid <= 0 then
        self.gameObject:SetActiveE(0)
    else
        self.gameObject:SetActiveE(1)
        local ConfigManager = _G.ConfigManager
        local cfg = ConfigManager.combine_cfg[sid]
        local type
        if not cfg then
            cfg = ConfigManager.card_skills_cfg[sid]
            type = require "CombineModel":GetInstance():GetTypeWithSkillId(sid)
        else
            type = cfg.classify
            sid = cfg.skills[lv]
            cfg = ConfigManager.card_skills_cfg[cfg.skills[lv > 0 and lv or 1]]
        end
        self.go_table.aorrawimage_icon:LoadImage(
            cfg.icon,
            function(rawimage)
                rawimage:SetNativeSize()
            end
        )
        if _type ~= combSkillType.equip then
            if _type == combSkillType.used then
                self.go_table.obj_used:SetActiveE(1)
            elseif _type == combSkillType.own then
                self.go_table.obj_used:SetActiveE(0)
            end
            self.go_table.aortext_name.text = _G.GetLangPackValue(cfg.name1)
            self.go_table.obj_mask:SetActiveE(lv == 0 and 1 or 0)
        end
        if type and self.go_table.aortext_type2 then
            self.go_table.aortext_type2.text = _G.LangUtil.GetLangPackValue(ConfigManager.discrete_cfg[105003][1][type])
        end
        cfg = ConfigManager.battle_skill_cfg[cfg.skills[1]]
        self.go_table.aortext_type.text = ConfigManager.language_package_cfg[cfg.Brief]
    end
end

function EmbattleCombineSkillItem:SetGray(gray, tipsid)
    self.go_table.aorimage_bg:SetGray(gray)
    self.go_table.aorrawimage_icon:SetGray(gray)
    self.go_table.aorimage_typebg:SetGray(gray)
    self.go_table.aorimage_typebg2:SetGray(gray)
    self.clickTipsID = tipsid
end

