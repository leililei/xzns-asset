    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local AppSetting = _G.AppSetting
    local swidth = AppSetting.SCREEN_WIDTH
    local sheight = AppSetting.SCREEN_HEIGHT
    local dwidth = AppSetting.CONFIG_SCREEN_WIDTH
    local dheight = AppSetting.CONFIG_SCREEN_HEIGHT
    if (_G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight > 0.5) then
        UiRatio = dheight / sheight
    else
        UiRatio = dwidth * (sheight / swidth) / sheight
    end
