---初始化合击技能列表数据
function EmbattleCombineSkillView:InitSkillList()
    self.typeBtns = {}
    self.typeText = {}
    self.typeItems = {}
    if #self.skillData > 0 then
        self.go_table.obj_noneSKillTips:SetActiveE(0)
        self.go_table.obj_CombineDes:SetActiveE(1)
        self.go_table.scrollloopvectical_skill:SetActiveE(1)
        self.skillItems = {}
        self.go_table.scrollloopvectical_skill:InitItemData(0, _G.handler(self, self.OnSkillItemCall))
    else
        self.go_table.obj_noneSKillTips:SetActiveE(1)
        self.go_table.obj_CombineDes:SetActiveE(0)
        self.go_table.scrollloopvectical_skill:SetActiveE(0)
    end
    self.chooseIndexList = {}
    local count = #_G.ConfigManager.discrete_cfg[105003][1]
    self.go_table.scrollloophorizontal_skillType:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).vertical =
        count > 4
    self.go_table.scrollloophorizontal_skillType:InitItemData(count, _G.handler(self, self.RefreshSkillType))
    self:ChangeType(self.curChooseElementType)
end

---更新技能类型显示
function EmbattleCombineSkillView:RefreshSkillType(index, obj)
    self.typeBtns[index + 1] = obj
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSkillType, index + 1))
    local typeId = _G.ConfigManager.discrete_cfg[105003][1][index + 1]
    tb.aortext_label.text = _G.LangUtil.GetLangPackValue(typeId)
    tb.aortext_choose.text = _G.LangUtil.GetLangPackValue(typeId)
    self.typeText[index + 1] = tb.aortext_label
    self.typeItems[index + 1] = tb
    _G.GameUtil.SetActiveByCondition(tb.obj_select, index + 1 == self.curChooseElementType)
    _G.GameUtil.SetActiveByCondition(tb.obj_lock, not self.posUnlockTag[index + 1])
end

function EmbattleCombineSkillView:OnClickSkillType(go, isOn, type)
    if not self.posUnlockTag[type] then
        local _, _type, param = EmbattleModel:GetInstance():GetSkillPosUnLockParam(type)
        if _type == 4 and param > 0 then
            --冒险关卡
            local afkCfg = _G.ConfigManager.afk_cfg[param]
            _G.PopWindowManager:GetInstance():ShowAllTips(
                140116,
                nil,
                nil,
                nil,
                nil,
                nil,
                afkCfg.chapter,
                afkCfg.section
            )
        elseif _type == 50 then
            --服务器时间开启
            local remainTime = param * 86400 - _G.PlayerModel:GetInstance():GetServerOpenDuration()
            if remainTime > 0 then
                ---@type number
                local tip
                if remainTime >= 86400 then
                    tip = 1000103 --X天后解锁
                    remainTime = math.max(1, math.floor(remainTime / 86400))
                else
                    tip = 1000104 --X小时后解锁
                    remainTime = math.max(1, math.ceil(remainTime / 3600))
                end
                _G.PopWindowManager:GetInstance():ShowAllTips(tip, nil, nil, nil, nil, nil, remainTime)
            end
        end
    else
        self:ChangeType(type)
    end
end

---循环列表回调
---@param index number 数据序列号(从0开始)
---@param obj Unityengine.GameObject 数据序列号(从0开始
---@return 变量类型 中文描述
function EmbattleCombineSkillView:OnSkillItemCall(index, obj)
    local insID = obj:GetInstanceID()
    local item = self.skillItems[insID]
    if not item then
        item = EmbattleCombineSkillItem.New(obj, self.clickHandler)
        self.skillItems[insID] = item
    end
    index = index + 1
    local data
    data = self.skillData[self.chooseIndexList[index]]
    if self.usedSkill and self.usedSkill[data[1]] then
        if self.usedSkill[data[1]].stype == _G.CombineViewShowType.gray then
            item:Show(index, data[1], data[2], combSkillType.lock)
            item:SetGray(true, self.usedSkill[data[1]].tipsid)
        else
            item:Show(index, data[1], data[2], combSkillType.used)
            item:SetGray(false)
        end
    else
        item:Show(index, data[1], data[2], combSkillType.own)
        item:SetGray(false)
    end
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_select, index == self.chooseIndex)
end

function EmbattleCombineSkillView:ChangeType(_t)
    if self.curChooseElementType then
        _G.GameUtil.SetActiveByCondition(self.typeItems[self.curChooseElementType].obj_select, false)
    end
    _G.GameUtil.SetActiveByCondition(self.typeItems[_t].obj_select, true)
    self.needShowArrow = false
    self.curChooseElementType = _t
    self.chooseIndex = 1
    if #self.skillData == 0 then
        return
    end
    self:UpdateCardList()
    self:ShowCombineDes()
end

---拥有技能点击
---@param 变量名 变量类型 中文描述
function EmbattleCombineSkillView:OnOwnSkillClick(index)
    if self.equipSkills[self.curChooseElementType].id > 0 and self.equipSkills[self.curChooseElementType].tag ~= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(580104)
        return
    end
    self.chooseIndex = index
    self.go_table.scrollloopvectical_skill:UpdateAllItem()
    self:ShowCombineDes()
end

function EmbattleCombineSkillView:UpdateCardList()
    local index = 1
    self.chooseIndex = 999
    if self.curChooseElementType == 0 then
        for i = 1, #self.skillData do
            self.chooseIndexList[index] = i
            index = index + 1
        end
    else
        local cfgs = _G.ConfigManager.combine_cfg
        local sid = 0
        for i = 1, #self.skillData do
            if cfgs[self.skillData[i][1]].classify == self.curChooseElementType then
                self.chooseIndexList[index] = i

                if self.usedSkill and not self.usedSkill[self.skillData[i][1]] and index < self.chooseIndex then
                    self.chooseIndex = index
                end
                index = index + 1
            end
        end
        for i = index, #self.chooseIndexList do
            self.chooseIndexList[i] = 0
        end
    end
    if self.chooseIndex == 999 then
        self.chooseIndex = 1
    end
    index = index - 1
    if index == 0 then
        self.go_table.obj_noneSKillTips:SetActiveE(1)
        self.go_table.obj_CombineDes:SetActiveE(0)
    else
        self.go_table.obj_noneSKillTips:SetActiveE(0)
        self.go_table.obj_CombineDes:SetActiveE(1)
    end
    if not self.inited then
        self.inited = true
        _G.DelayDo(
            0.3,
            function()
                if self:IsNil() then
                    return
                end
                self.go_table.scrollloopvectical_skill:UpdateCount(index)
                self.checkRightPosX =
                    self.go_table.scrollloopvectical_skill:GetRectTransformSizeDelta() -
                    self.contentTrans:GetRectTransformSizeDelta() +
                    120
            end
        )
    else
        self.go_table.scrollloopvectical_skill:UpdateCount(index)
        self.checkRightPosX =
            self.go_table.scrollloopvectical_skill:GetRectTransformSizeDelta() -
            self.contentTrans:GetRectTransformSizeDelta() +
            120
    end
end

function EmbattleCombineSkillView:EquipSkill(index, sid)
    if self.equipSkills[index].id == sid then --卸下
        self:EquipSkill2(index, sid)
    else                                      --装备
        if self.equipSkillCall then
            self.tempSkill = _G.DeepCopy(self.equipSkills[index])
            self.equipSkills[index].id = sid
            self.equipSkills[index].lv = self.skillLVDic[sid]
            self.equipSkills[index].cskillID = _G.ConfigManager.combine_cfg[sid].skills[self.skillLVDic[sid]]
            self.equipSkillCall(self.equipSkills, index, _G.handler(self, self.RefreshSkill))
        else
            self:EquipSkill2(index, sid)
        end
    end
end

---装备后刷新技能
function EmbattleCombineSkillView:RefreshSkill(isSucceed, index)
    if isSucceed then
        local sid = self.equipSkills[index].id
        if self.usedSkill and self.usedSkill[sid] then
            if self.equipSkills[index].id > 0 then
                self.usedSkill[sid] = nil
                self.usedSkill[self.tempSkill.id] = { stype = _G.CombineViewShowType.shadow }
                self.swapSkills[sid] = _G.DeepCopy(self.tempSkill)
            else
                self.swapSkills[sid] = { id = 0, tag = 0, lv = 0, cskillID = 0 }
                self.usedSkill[sid] = nil
            end
        end
        if self.equipSkills[index].id > 0 then
            self.equipSkillDic[self.equipSkills[index].id] = nil
        end
        self.equipSkillDic[sid] = true
        if self.combineCall then
            self.combineCall(index)
        end
        self:ShowBtns(self.skillData[self.chooseIndexList[self.chooseIndex]])
        _G.PopWindowManager:GetInstance():ShowAllTips(580105)
        self.go_table.scrollloopvectical_skill:UpdateAllItem()
    else
        self.equipSkills[index] = self.tempSkill
    end
end

---装备技能
function EmbattleCombineSkillView:EquipSkill2(index, sid)
    if self.equipSkills[index].id == sid then --卸下
        self.equipSkills[index].id = 0
        self.equipSkills[index].lv = 0
        self.equipSkills[index].cskillID = 0
        self.equipSkillDic[sid] = nil
    else --装备
        if self.equipSkills[index].id > 0 then
            self.equipSkillDic[self.equipSkills[index].id] = nil
        end
        if self.usedSkill and self.usedSkill[sid] then
            if self.equipSkills[index].id > 0 then
                self.usedSkill[sid] = nil
                self.usedSkill[self.equipSkills[index].id] = { stype = _G.CombineViewShowType.shadow }
                self.swapSkills[sid] = _G.DeepCopy(self.equipSkills[index])
            else
                self.swapSkills[sid] = { id = 0, tag = 0, lv = 0, cskillID = 0 }
                self.usedSkill[sid] = nil
            end
        end
        self.equipSkills[index].id = sid
        self.equipSkills[index].lv = self.skillLVDic[sid]
        self.equipSkills[index].cskillID = _G.ConfigManager.combine_cfg[sid].skills[self.skillLVDic[sid]]
        self.equipSkillDic[sid] = true
    end
    if self.combineCall then
        self.combineCall(index)
    end
    self:ShowBtns(self.skillData[self.chooseIndexList[self.chooseIndex]])
    _G.PopWindowManager:GetInstance():ShowAllTips(580105)
    self.go_table.scrollloopvectical_skill:UpdateAllItem()
end

---更新合击技显示
