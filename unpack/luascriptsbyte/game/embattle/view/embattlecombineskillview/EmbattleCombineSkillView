---初始化处理相关技能数据
function EmbattleCombineSkillView:InitSkillData(skills, call, usedSkill, list, unlock, type)
    self.closeCall = call
    -- if _G.type()
    self.usedSkill = usedSkill
    self.swapSkills = {}
    self.curChooseElementType = type or 1
    self:InitSkillListData(list, skills)
    self:InitEquipSkillData(skills, unlock)
end

---技能排序 已使用>技能等级>技能id
function EmbattleCombineSkillView:SortSkill(list, skills, usedSkill)
    local isUseTb = {}
    local type = nil
    local equipSkill = function(id)
        if isUseTb[id] ~= nil then
            return isUseTb[id]
        end
        if skills then
            type = _G.type(skills[1])
            for _, v in pairs(skills) do
                if type == "number" then
                    if v == id then
                        isUseTb[id] = true
                        return true
                    end
                else
                    if (v.id and v.id == id) or (v[1] and v[1] == id) then
                        isUseTb[id] = true
                        return true
                    end
                end
            end
        end
        if usedSkill then
            if usedSkill[id] then
                isUseTb[id] = true
                return true
            end
        end

        isUseTb[id] = false
        return false
    end
    _G.SortList(
        list,
        function(a)
            local id = equipSkill(a[1]) and 999 or 0
            return id, a[2], -a[1]
        end
    )
end

---初始化装备的技能数据和状态
---@param skills table 装备的技能id组
---@param unlock table 技能位解锁状态 {boolean,boolean,boolean}
function EmbattleCombineSkillView:InitEquipSkillData(skills, unlock)
    if type(skills[1]) == "number" then
        self.callbackNumber = true
        self.equipSkills = { false, false, false }
        local combCfgs = _G.ConfigManager.combine_cfg
        for i = 1, #skills do
            local skill = {
                id = skills[i],
                lv = 0,
                cskillID = 0,
                tag = 0
            }
            if skill.id > 0 then
                skill.lv = self.skillLVDic[skill.id]
                skill.cskillID = combCfgs[skill.id].skills[skill.lv]
            end
            self.equipSkills[i] = skill
        end
    else
        self.equipSkills = skills
    end
    self.equipSkillDic = {}
    for i = 1, #self.equipSkills do
        if self.equipSkills[i].id > 0 then
            self.equipSkillDic[self.equipSkills[i].id] = 0
        end
    end
    self.posUnlockTag = unlock or { false, false, false }
    if not unlock then
        local EmbattleModelIns = EmbattleModel:GetInstance()
        for i = 1, #self.posUnlockTag do
            self.posUnlockTag[i] = EmbattleModelIns:CheckSkillPosUnLock(i)
        end
    end
end

---初始化合击技能列表数据
---@param data table 已拥有的合击技列表{{id,lv},{id,lv}}
function EmbattleCombineSkillView:InitSkillListData(data, skills)
    local index = 1
    if data then
        self.skillData = data
        self.skillLVDic = {}
        index = #data
        for i = 1, index do
            self.skillLVDic[data[i][1]] = data[i][2]
        end
    else
        data = CombineModel:GetInstance():GetUnLockCombine() or {}
        self.skillLVDic = data
        self.skillData = {}
        for sid, lv in pairs(data) do
            self.skillData[index] = { sid, lv }
            index = index + 1
        end
        index = index - 1
    end
    if index > 0 then
        self:SortSkill(data, skills, self.usedSkill)
    end
end

