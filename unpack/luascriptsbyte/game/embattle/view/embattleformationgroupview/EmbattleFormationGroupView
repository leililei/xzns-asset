local EmbattleFormationGroupView = _G.BaseClass("EmbattleFormationGroupView", _G.UIBaseView)

function EmbattleFormationGroupView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---@param clearCall function 销毁布阵类回调
function EmbattleFormationGroupView:OnCreate(item, embattleItem, embattleIndex, fgType, call, clearCall)
    self.fgType = fgType
    self.curGroupItem = item
    self.curEmbattleItem = embattleItem
    self.curEmbattleIndex = embattleIndex
    self.closeCall = call
    self.clearCall = clearCall
    self.formations = {}
    self.itemChooseHandler = _G.handler(self, self.OnGroupChoose)
    self.groupItems = {}
    self.skillUnLockTag = { false, false, false }
    for i = 1, #self.skillUnLockTag do
        if EmbattleModel:GetInstance():CheckSkillPosUnLock(i) then
            self.skillUnLockTag[i] = 0
        else
            self.skillUnLockTag[i] = EmbattleModel:GetInstance():GetSkillPosUnLockParam(i)
        end
    end
    self:InitToggles()
    local count = self.curGroupItem:GetEmbattleTypeCount()
    EmbattleController:GetInstance():GetPreFormation(
        function()
            self:UpdateFormation()
            self.toggleItem[self.curGroup].isOn = false
            self.toggleItem[self.curGroup].isOn = true
            self.go_table.scrollloopvectical_group:InitItemData(count, _G.handler(self, self.OnGroupItemCall))
            self.listInit = true
        end
    )
    self:AddListener(_G.eCard.CardDelCard, self.OnDelCard)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.EmbattleFormation, 1)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BattleFormation.id)
end

function EmbattleFormationGroupView:InitToggles()
    self.toggleItem = {
        [_G.FormationGroupType.Five] = self.go_table.toggle_5,
        [_G.FormationGroupType.Three] = self.go_table.toggle_3
    }
    self.toggles = {
        [_G.FormationGroupType.Five] = _G.GetAutoGoTable(
            self.go_table.toggle_5,
            _G.handlerbind(self, self.OnClickToggle, _G.FormationGroupType.Five)
        ),
        [_G.FormationGroupType.Three] = _G.GetAutoGoTable(
            self.go_table.toggle_3,
            _G.handlerbind(self, self.OnClickToggle, _G.FormationGroupType.Three)
        )
    }
    if self.fgType == _G.FormationGroupType.All then
        self.curGroup = _G.FormationGroupType.Five
    else
        self.curGroup = self.fgType
    end
end

function EmbattleFormationGroupView:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    if isOn and self.fgType ~= _G.FormationGroupType.All and self.fgType ~= key then
        self.toggleItem[self.curGroup]:SetIsOnWithoutNotify(true)
        self.toggles[self.curGroup].aorimage_isOn:SetActiveE(1)
        self.toggles[self.curGroup].aorimage_isOff:SetActiveE(0)
        if self.curGroup == _G.FormationGroupType.Five then
            _G.PopWindowManager:GetInstance():ShowAllTips(1322)
        elseif self.curGroup == _G.FormationGroupType.Three then
            _G.PopWindowManager:GetInstance():ShowAllTips(1323)
        end
        return
    end
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        self.curGroup = key
        self:OnGroupChange()
    end
end

function EmbattleFormationGroupView:OnGroupChange()
    if self.curGroup == self.curGroupItem:GetFormationGroupType() then
        return
    end
    self.curGroupItem:ChangeGroupType(self.curGroup)
    self:UpdateFormation()
    if not self.listInit then
        return
    end
    self.go_table.scrollloopvectical_group:ScrollToTop()
    self.go_table.scrollloopvectical_group:UpdateAllItem()
end

function EmbattleFormationGroupView:UpdateFormation()
    if not self.formations[self.curGroup] then
        local formations = EmbattleController:GetInstance():GetAllGroupFormation(self.curGroup)
        self.formations[self.curGroup] = _G.table.toArray(formations)
        self:SortFormation()
    end
end

function EmbattleFormationGroupView:SortFormation()
    _G.SortList(
        self.formations[self.curGroup],
        function(a)
            local hasData = a.uid > 0 and 1 or 0
            for _, v in pairs(a.sits) do
                if v > 0 then
                    hasData = 2
                    break
                end
            end
            return hasData, -a.index
        end
    )
end

function EmbattleFormationGroupView:RefreshCurList()
    self:SortFormation()
    self.go_table.scrollloopvectical_group:UpdateAllItem()
end

function EmbattleFormationGroupView:OnDestroy()
    self:RemoveAllListener()
    self.curGroupItem = nil
    self.closeCall = nil
    self.itemChooseHandler = nil
    self.groupItems = nil
    if self.clearCall then
        self.clearCall()
    end
    self.clearCall = nil
end

