function EmbattleFormationGroupView:OnDelCard(uid)
    if not self.delCards then
        self.delCards = {}
    end
    self.delCards[uid] = true
    if self.waitRefresh then
        return
    end
    self.waitRefresh = true
    _G.DelayDo(
        0.5,
        function()
            self.waitRefresh = false
            local change = false
            for _, v in pairs(self.formations[self.curGroup]) do
                for i, _uid in pairs(v.sits) do
                    if self.delCards[_uid] then
                        self.curGroupItem:SetEmbattleDataSingle(i, _uid, v.index)
                        change = true
                    end
                end
            end
            if change then
                _G.PopWindowManager:GetInstance():ShowAllTips(1319)
                self:RefreshCurList()
            end
            self.delCards = {}
        end
    )
end

function EmbattleFormationGroupView:CheckInEmbattle(uid)
    if self.curEmbattleItem then
        return self.curEmbattleItem:CheckUidInEmbattle(uid)
    else
        return false
    end
end

function EmbattleFormationGroupView:ShowDrag(item)
    if self.dragItem then 
        local _, posY = _G.CS.UIUtils.ScreenPointToLocalPointInRectangle(self.go_table.scrollloopvectical_group)
        local width, height = self.go_table.scrollloopvectical_group:GetRectTransformSize()
        if posY > height / 2 then 
            local t = self.go_table.obj_content:GetComponentE(typeof(CS.UnityEngine.RectTransform))
            local x1, y1 = t:GetAnchorPosition()
            t:SetAnchorPosition(x1, y1 - 5, 0)
        elseif posY < - height / 2 then 
            local t = self.go_table.obj_content:GetComponentE(typeof(CS.UnityEngine.RectTransform))
            local x1, y1 = t:GetAnchorPosition()
            t:SetAnchorPosition(x1, y1 + 5, 0)
        end
    end
    if self.isLongPress or item:CheckEmpty() then 
        return 
    end
    self.isLongPress = true
    if not self.dragItem then 
        self.dragItem = _G.InstantiateObject(item.go_table.gameObject, item.go_table.gameObject)
        self.dragData = _G.DeepCopy(item)
        self.dragObj = item.go_table.aorimage_drag
        self.dragObj:SetActiveE(1)
        self.dragItem:SetLocalScaleXYZ(0.8)
        self.dragItem:SetParentE(self.go_table.obj_drag, 1)
        self.dragPosX, self.dragPosY =
        _G.CS.UIUtils.ScreenPointToLocalPointInRectangle(self.go_table.obj_drag:GetParent())
        self.dragItem:SetLocalPosition(self.dragPosX, self.dragPosY, 0)
    end
end

