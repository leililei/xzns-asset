function EmbattleFormationGroupItem:EditEmbattle()
    self.onChooseCall(self.index, true)
end

function EmbattleFormationGroupItem:CheckEmpty()
    for _, v in pairs(self.info.sits) do
        if v > 0 then
            return false
        end
    end
    for _, v in pairs(self.info.pet) do
        if v > 0 then
            return false
        end
    end
    if _G.AppSetting.IsXzns then
        for _, v in pairs(self.info.beast) do
            if v > 0 then
                return false
            end
        end
    end
    for _, v in pairs(self.info.skill_index) do
        if v > 0 then
            return false
        end
    end
    return true
end

