function EmbattleFormationGroupView:OnGroupItemCall(index, obj)
    local insID = obj:GetInstanceID()
    local item = self.groupItems[insID]
    if not item then
        item = EmbattleFormationGroupItem.New(
            obj,
            self.itemChooseHandler,
            self.skillUnLockTag,
            self.fgType,
            _G.handler(self, self.RefreshCurList),
            _G.handler(self, self.CheckInEmbattle),
            _G.handler(self, self.ShowDrag),
            _G.handler(self, self.OnDragBegin),
            _G.handler(self, self.OnDrag),
            _G.handler(self, self.OnDragEnd),
            _G.handler(self, self.OnUp)
        )
        self.groupItems[insID] = item
    end
    index = index + 1
    local info = self.formations[self.curGroup][index]
    local dragFlag
    if self.dragData and self.dragData.index == info.index then 
        dragFlag = true
    end
    item:Show(self.curGroupItem, info, self.curGroup, dragFlag)
end

---选择编队
---@param index number 编队序列
---@param edit boolean 是否编辑
---@return 变量类型 中文描述
function EmbattleFormationGroupView:OnGroupChoose(index, edit)
    if edit then
        self.closeCall(self.curGroup, index, edit)
        self:Hide()
        return
    end
    if self.curEmbattleItem then
        local data = self.curGroupItem:GetEmbattleData(index)
        local skills = self.curGroupItem:GetCombSkillData(index)
        local petSkills = self.curGroupItem:GetPetSkillData(index)
        local beastSkills
        if _G.AppSetting.IsXzns then
            local passBeastTab = self.curEmbattleItem.passBeastTab
            beastSkills = self.curGroupItem:GetBeastSkillData(index)
            local isContainsPassBeast = false
            if not _G.table.isEmptyOrNil(passBeastTab) then
                local curBeastSkill = self.curEmbattleItem:GetBeastSkillData(self.curEmbattleIndex)
                for i = 1, #beastSkills do---检测要替换的圣兽有没有其他已通关队伍使用过，如果有使用过不替换对应圣兽
                    if passBeastTab[beastSkills[i]] then
                        beastSkills[i] = curBeastSkill[i]
                        isContainsPassBeast = true
                    end
                end
            end
            if isContainsPassBeast then
                _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(90024900021))
            end
        end
        if self.curEmbattleItem:CheckRepeatInOtherGroup(data, skills, petSkills, self.curEmbattleIndex, beastSkills) then
            _G.PopWindowManager:GetInstance():ShowAllTipsExtend(
                1321,
                nil,
                function()
                    self.closeCall(self.curGroup, index, edit, true)
                    _G.PopWindowManager:GetInstance():ShowAllTips(1317)
                    self:Close()
                    self.closeCall = nil
                end,
                function()
                    self.closeCall(self.curGroup, index, edit, false)
                    _G.PopWindowManager:GetInstance():ShowAllTips(1317)
                    self:Close()
                    self.closeCall = nil
                end,
                nil,
                nil,
                { notCall = true }
            )
            return
        end
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(1317)
    self.closeCall(self.curGroup, index, edit, false)
    self:Close()
    self.closeCall = nil
end

