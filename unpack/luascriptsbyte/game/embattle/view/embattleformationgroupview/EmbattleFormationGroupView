function EmbattleFormationGroupView:OnDragEnd(go, go1, ed)
    self.isLongPress = false 
    if not self.dragItem then 
        return 
    end
    if not self.isDrag then
        return
    end
    if self.dragObj then 
        self.dragObj:SetActiveE(0)
    end
    self.isDrag = false 
    local overlap
    for k, v in pairs(self.groupItems) do
        if go.index ~= v.index and v.info.uid and v.info.uid ~= 0 then
            overlap = CheckMousePointInRect(v.go_table.gameObject)
            if overlap then
                EmbattleController:GetInstance():ExChangeGroupFormation(self.dragData.group, self.dragData.index, v.index, function()
                    self.formations[self.curGroup] = nil
                    self:UpdateFormation()
                    self.curGroupItem:InitEmbattleData()
                    self.dragData = nil
                    self.go_table.scrollloopvectical_group:UpdateAllItem()
                end)
                break
            end
        end
    end
    _G.DestroyObject(self.dragItem)
    self.dragItem = nil
    self.dragData = nil
end

function EmbattleFormationGroupView:OnUp(go, go1, ed)
    self.isLongPress = false 
    if not self.dragItem then 
        return 
    end
    if self.isDrag then
        return
    end
    if self.dragObj then 
        self.dragObj:SetActiveE(0)
    end
    _G.DestroyObject(self.dragItem)
    self.dragItem = nil
    self.dragData = nil
end

return EmbattleFormationGroupView
