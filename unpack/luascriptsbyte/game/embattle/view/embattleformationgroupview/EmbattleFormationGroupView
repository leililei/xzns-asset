function EmbattleFormationGroupItem:__init(obj, onChoose, unlock, fgType, onClear, embattleCheck, longPressCall, beginDragCall, DragCall, EndDragCall, UpCall)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.onChooseCall = onChoose
    self.onClearCall = onClear
    self.longPressCall = longPressCall
    self.embattleCheckCall = embattleCheck
    self.OnDragBegin = beginDragCall
    self.OnDrag = DragCall
    self.OnDragEnd = EndDragCall
    self.UpCall = UpCall
    self.unLock = unlock
    self.cardDic = {
        self.go_table.trans_card1,
        self.go_table.trans_card2,
        self.go_table.trans_card3,
        self.go_table.trans_card4,
        self.go_table.trans_card5
    }
    self.cardItems = { false, false, false, false, false }
    self.fgType = fgType
    self.go_table.aorbtn_drag.LongPress = true
    self.go_table.aorbtn_drag.onLongPress = _G.handlerbind(self, self.longPressCall, self)
    self.go_table.aorbtn_drag.LongPressTime = 400
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onUp", _G.handler(self, self.UpCall))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_drag, "onDragEnd", _G.handler(self, self.OnDragEnd))
end
function EmbattleFormationGroupItem:Dispose()
    self.go_table = nil
    self.onChooseCall = nil
    self.index = nil
    self.cardDic = nil
end
function EmbattleFormationGroupItem:OnClickBtn(go)
    if go == self.go_table.aorbtn_use then
        --使用编队
        if not self.grayTag then
            self:UseEmbattle()
        end
    elseif go == self.go_table.aorbtn_edit then
        self:EditEmbattle()
    elseif go == self.go_table.aorbtn_clear then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1320,
            nil,
            function()
                EmbattleController:GetInstance():OnGroupClear(self.group, self.index, self.onClearCall)
            end,
            nil,
            nil,
            nil,
            self.info.name
        )
    elseif go == self.go_table.aorbtn_name then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.EmbattleGroupNameView.Name,
            _G.handler(self, self.OnChangeNameCall),
            self.go_table.aortext_NO.text,
            self.group,
            self.index
        )
    elseif go == self.go_table.aorbtn_drag then 

    else
        self:EditEmbattle()
    end
end

function EmbattleFormationGroupItem:OnSkillBtnClick(index)
    if self.unLock[index] > 0 then
        local afkCfg = _G.ConfigManager.afk_cfg[self.unLock[index]]
        _G.PopWindowManager:GetInstance():ShowAllTips(140116, nil, nil, nil, nil, nil, afkCfg.chapter, afkCfg.section)
        return
    end
    self:EditEmbattle()
end

function EmbattleFormationGroupItem:OnChangeNameCall(name)
    self.go_table.aortext_NO.text = name
    EmbattleController:GetInstance():SetGroupName(self.index, name)
end

---展示布阵
---@param index number 序列号
---@param item EmbattleItemGroup 布阵对象
function EmbattleFormationGroupItem:Show(item, info, group, dragFlag)
    self.index = info.index
    self.group = group
    self.info = info
    self.curGroupItem = item
    self.grayTag = self.curGroupItem:CheckContains(self.index)
    self.petSkillUnlock = self.curGroupItem:GetPetSkillState()
    if _G.AppSetting.IsXzns then
        self.beastSkillUnlock = self.curGroupItem:GetBeastSkillState()
    end
    self.go_table.aorbtn_use:SetGray(self.grayTag)
    self.petSkill = item:GetPetSkillData(self.index)
    if _G.AppSetting.IsXzns then
        self.beastSkill = item:GetBeastSkillData(self.index)
    end
    -- self.onSkillCloseHandler = _G.handler(self, self.OnCombCloseCall)
    self.go_table.aorimage_drag:SetActiveE(dragFlag and 1 or 0)
    self.onCardCallHandler = _G.handler(self, self.OnCardCall)
    self.go_table.aortext_NO.text = info.name
    local isEmpty = self:CheckEmpty()
    self.go_table.aorbtn_edit:SetActiveE((isEmpty or self.fgType == _G.FormationGroupType.All) and 1 or 0)
    self.go_table.aorbtn_use:SetActiveE((isEmpty or self.fgType == _G.FormationGroupType.All) and 0 or 1)
    self.go_table.aorbtn_clear:SetActiveE(isEmpty and 0 or 1)
    --self.go_table.aorbtn_drag:SetActiveE(isEmpty and 0 or 1)
    local CanvasGroup = self.go_table.aorbtn_drag.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    CanvasGroup.alpha = isEmpty and 0 or 1
    self:SetCombineItem(self.petSkill)
    if _G.AppSetting.IsXzns then
        self:SetBeastItem(self.beastSkill)
    end
    self:ShowCard()
end

---设置宠物技
function EmbattleFormationGroupItem:SetCombineItem(pet)
    local petItem, petCfg, skillId, cfgt, cfg, petData, star
    for i = 1, 3 do
        petItem = _G.GetAutoGoTable(self.go_table["obj_petSkills" .. i])
        if self.petSkillUnlock[i] then
            petItem.obj_lock:SetActiveE(0)
            if pet[i] and pet[i] > 0 then
                petData = require("PetModel"):GetInstance():GetPet(pet[i])
                -- petItem.aortext_name.text = _G.GetLangPackValue(petCfg.Name)
                -- petItem.aorimage_bg.SpriteName = PetOrderFrame[petCfg.Order]
                petItem.aorrawimage_icon:SetActiveE(1)
                petItem.obj_type:SetActiveE(1)
                petCfg = _G.ConfigManager.pet_cfg[pet[i]]
                skillId = petCfg.skill_id[1]
                cfgt = _G.ConfigManager.card_skills_cfg[skillId]
                cfg = cfgt and _G.ConfigManager.battle_skill_cfg[cfgt.skills[1]]
                petItem.aorrawimage_icon:LoadImage(cfg and cfg.Icon or "")
                petItem.obj_empty:SetActiveE(0)
                petItem.aortext_type.text = _G.ConfigManager.language_package_cfg[cfg.Brief]
            else
                petItem.aorrawimage_icon:SetActiveE(0)
                petItem.obj_type:SetActiveE(0)
                petItem.obj_empty:SetActiveE(1)
            end
        else
            petItem.obj_lock:SetActiveE(1)
            petItem.obj_type:SetActiveE(0)
            petItem.obj_empty:SetActiveE(0)
        end

        star = petData and petData.star or 0
        for j = 1, 5 do
            petItem["obj_star" .. j]:SetActiveE(star >= j and 1 or 0)
        end
    end
end

---设置圣兽技
function EmbattleFormationGroupItem:SetBeastItem(beast)
    self.go_table.obj_pet:SetActiveE(0)
    self.go_table.obj_beast:SetActiveE(1)
    local beastItem, beastData
    for i = 1, 3 do
        beastItem = _G.GetAutoGoTable(self.go_table["obj_beastSkills" .. i])
        if self.beastSkillUnlock[i] then
            beastItem.obj_lock:SetActiveE(0)
            if beast[i] and beast[i] > 0 then
                beastData = require("BeastModel"):GetInstance():GetBeast(beast[i])
                beastItem.aorimage_bg.SpriteName = _G.EquipItemIconName[beastData:GetOrder()]
                beastItem.aorrawimage_icon:LoadImage(beastData:GetIconPath())
                beastItem.aorimage_type.SpriteName = beastData:GetProfessionalSpriteName()
                beastItem.aorrawimage_icon:SetActiveE(1)
                beastItem.aorimage_type:SetActiveE(1)
                beastItem.obj_empty:SetActiveE(0)
            else
                beastItem.aorimage_bg.SpriteName = "ui_ty_toukuang_kong"
                beastItem.aorrawimage_icon:SetActiveE(0)
                beastItem.aorimage_type:SetActiveE(0)
                beastItem.obj_empty:SetActiveE(1)
            end
            beastItem.obj_lock:SetActiveE(0)
        else
            beastItem.aorimage_bg.SpriteName = "ui_ty_toukuang_kong"
            beastItem.obj_lock:SetActiveE(1)
            beastItem.aorimage_type:SetActiveE(0)
            beastItem.obj_empty:SetActiveE(1)
        end
    end
end

---展示卡牌
function EmbattleFormationGroupItem:ShowCard()
    self.cardData = self.curGroupItem:GetEmbattleData(self.index)
    self.cardIndex = 1
    self:HandleCardOneByOne()
end

---
---@protected
function EmbattleFormationGroupItem:CheckData(uid)
    local index = 0
    local count = self.curGroupItem:GetEmbattleTypeCount()
    for i = 1, count do
        if i < self.index then
            local cardData = self.curGroupItem:GetEmbattleData(i)
            for k, v in ipairs(cardData) do
                if v.uid == uid then
                    index = i
                    return index
                end
            end
        else
            break
        end
    end
    return index
end

function EmbattleFormationGroupItem:HandleCardOneByOne()
    if self.cardIndex > #self.cardData then
        self.cardData = nil
        self.cardIndex = nil
        return
    end
    local data = self.cardData[self.cardIndex]
    if data.uid > 0 then
        if self.index > 1 then
            local checkIndex = self:CheckData(data.uid)
            self.go_table["obj_tips" .. self.cardIndex]:SetActiveE(checkIndex > 0 and 1 or 0)
            if checkIndex > 0 then
                self.go_table["aortext_tips" .. self.cardIndex].text = _G.GetLangPackValue(90022501404, _G.GameUtil.NumberToChinese(checkIndex))
            end
        end
        local card = self.cardItems[self.cardIndex]
        if card then
            card.gameObject:SetActiveE(1)
            local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)

            if caradata == nil then
                card.gameObject:SetActiveE(0)
                self.cardIndex = self.cardIndex + 1
                self:HandleCardOneByOne()
                return
            end

            local skin

            if caradata and caradata.skin ~= 0 then
                skin = true
            else
                skin = false
            end
            card:Show(
                data.sid,
                nil,
                data.star,
                data.level,
                nil,
                caradata.soulLink_lv,
                skin,
                caradata.soulLink_IsActivate,
                caradata.open_inborn
            )
            card:ShowInEmbattle(self.embattleCheckCall(data.uid))
            self.cardIndex = self.cardIndex + 1
            self:HandleCardOneByOne()
        else
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.levelItem,
                self.cardDic[self.cardIndex],
                self.onCardCallHandler
            )
        end
    else
        self.go_table["obj_tips" .. self.cardIndex]:SetActiveE(0)
        if self.cardItems[self.cardIndex] then
            self.cardItems[self.cardIndex].gameObject:SetActiveE(0)
        end
        self.cardIndex = self.cardIndex + 1
        self:HandleCardOneByOne()
    end
end

function EmbattleFormationGroupItem:OnCardCall(card)
    self.cardItems[self.cardIndex] = card
    card.transform:SetLocalPositionToZero()
    local data = self.cardData[self.cardIndex]
    local caradata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, data.uid)
    local skin

    if caradata and caradata.skin ~= 0 then
        skin = true
    else
        skin = false
    end
    self.cardItems[self.cardIndex]:Show(
        data.sid,
        nil,
        data.star,
        data.level,
        nil,
        caradata.soulLink_lv,
        skin,
        caradata.soulLink_IsActivate,
        caradata.open_inborn
    )
    self.cardItems[self.cardIndex]:ShowInEmbattle(self.embattleCheckCall(data.uid))
    self.cardIndex = self.cardIndex + 1
    self:HandleCardOneByOne()
end

