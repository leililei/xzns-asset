--region 工具类方法
local utils = {
    ---数组中是否包含成员
    ---@generic T
    ---@param array T[]
    ---@param memeber T
    ---@return boolean
    includes = function(array, memeber)
        for _, v in pairs(array) do
            if v == memeber then
                return true
            end
        end
        return false
    end,
    ---寻找数组成员下标
    ---@generic T
    ---@param array T[]
    ---@param memeber T
    ---@return number
    findIndex = function(array, memeber)
        for index, v in pairs(array) do
            if v == memeber then
                return index
            end
        end
        return -1
    end,
    ---寻找数组成员下标
    ---@generic T
    ---@param array T[]
    ---@param memeber T
    ---@return number
    remove = function(array, memeber)
        local pos = -1
        for index, v in pairs(array) do
            if v == memeber then
                pos = index
                break
            end
        end
        if pos > 0 then
            table.remove(array, pos)
        end
    end,
    ---通过灵兽Data获取技能配置实例
    ---@param petData PetData
    ---@return card_skills_cfg
    findCardSkillByPetData = function(data)
        local skillIndex, maxSkillIndex = data.star + 1, #data.cfg.skill_id
        local skillId =
            data.cfg.skill_id[skillIndex < 1 and 1 or skillIndex <= maxSkillIndex and skillIndex or maxSkillIndex]
        return _G.ConfigManager.card_skills_cfg[skillId]
    end,
    ---移除富文本标签
    removeColor = function(str)
        return _G.string.gsub(str, "(<color=#(%w*)>)", "<color=#14874a>")
    end
}
--endregion


---@class EmbattleBeastSkillView : UIBaseView	中文描述
---@field public go_table EmbattleBeastSkillView_GoTable GoTable
---@field index number 当前小队索引
---@field selectIndex number 当前选中的圣兽索引
---@field selectBeastSid number 圣兽列表中选择的圣兽sid（用于列表中的选中效果展示）
local EmbattleBeastSkillView = _G.BaseClass("EmbattleBeastSkillView", _G.UIBaseView)

local GroupMaxIndex = 3

function EmbattleBeastSkillView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EmbattleBeastSkillView:OnCreate(curBeasts, disableBeasts, selectCallback, unlock, index)
    self.allBeast = require("BeastModel"):GetInstance():GetAllActiveBeasts()
    self.disableBeasts = disableBeasts
    self.curBeasts = curBeasts
    self.selectCallback = selectCallback
    self.unlock = unlock or { false, false, false }
    self.index = 1
    self.selectIndex = index or 1
    self.selectBeastSid = self.curBeasts[self.selectIndex]
    self:SortData()
    self:InitView()
end

function EmbattleBeastSkillView:InitView()
    local go
    self.beastItemList = {}
    for i = 1, 3 do
        go = _G.GetAutoGoTable(self.go_table["obj_beast" .. i], _G.handlerbind(self, self.SelectBeast, i))
        self.beastItemList[i] = go
    end

    self.beastSkillList = {}
    for i = 1, 4 do
        go = _G.GetAutoGoTable(self.go_table["obj_skill" .. i], _G.handlerbind(self, self.OnSkillClick, i))
        self.beastSkillList[i] = go
    end
    self.go_table.scrollloopvectical_beastList:InitItemData(#self.allBeast,_G.handler(self,self.RefreshItem))
    self:UpdateBeast()
    self:UpdateSkill()
end

function EmbattleBeastSkillView:UpdateBeast()
    local beastList = self.curBeasts
    for i = 1, 3 do
        local go = self.beastItemList[i]
        if not self.unlock[i] then
            -- 没有解锁
            go.aorimage_lock:SetActiveE(1)
            go.aorimage_add:SetActiveE(0)
            go.obj_root:SetActiveE(0)
            go.obj_select:SetActiveE(0)
        else
            go.aorimage_lock:SetActiveE(0)
            if not beastList or not beastList[i] or beastList[i] == 0 then
                -- 空
                go.aorimage_add:SetActiveE(1)
                go.obj_root:SetActiveE(0)
            else
                go.aorimage_add:SetActiveE(0)
                go.obj_root:SetActiveE(1)
                go.obj_root:RemoveAllChildren()
                _G.PoolsManager:GetInstance():Spawn(
                    _G.ConfigManager.card_cfg[beastList[i]].spine[1],
                    _G.ePoolType.Temporary,
                    go.obj_root,
                    function(trans)
                        if self:IsNil() then
                            _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                            return
                        end
                    end
                )
            end
            go.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.BeastEmbattle.id, i)
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BeastEmbattle.id, i)
            go.obj_select:SetActiveE(self.selectIndex == i and 1 or 0)
        end
    end
end

function EmbattleBeastSkillView:UpdateSkill()
    local beastList = self.curBeasts
    local go
    for i = 1, 3 do
        go = self.beastSkillList[i + 1]
        if not self.unlock[i] then
            -- 没有解锁
            go.obj_lock:SetActiveE(1)
            go.obj_mask:SetActiveE(0)
            go.aorrawimage_icon:SetActiveE(0)
            go.obj_type:SetActiveE(0)
            if i == 1 then
                go = self.beastSkillList[1]
                go.obj_lock:SetActiveE(1)
                go.obj_mask:SetActiveE(0)
                go.aorrawimage_icon:SetActiveE(0)
                go.obj_type:SetActiveE(0)
            end
        else
            -- 设置被动
            go.obj_lock:SetActiveE(0)
            if not beastList[i] or beastList[i] == 0 then
                -- 槽位没有圣兽
                go.obj_mask:SetActiveE(1)
                go.aorrawimage_icon:SetActiveE(0)
                go.obj_type:SetActiveE(0)
            else
                local data = require("BeastModel"):GetInstance():GetBeast(beastList[i])
                local skillId = data:GetSkill_2()[data.star + 1]
                -- 存在没有被动技能的圣兽，需要在上阵主战的，隐藏被动技能
                if skillId == 0 then
                    go.gameObject:SetActiveE(0)
                else
                    go.gameObject:SetActiveE(1)
                    go.obj_mask:SetActiveE(0)
                    go.aorrawimage_icon:SetActiveE(1)
                    go.obj_type:SetActiveE(1)
                    go.aorrawimage_icon:LoadImage(_G.ConfigManager.card_skills_cfg[skillId].icon,function(trans)
                        if self:IsNil() then
                            return
                        end
                        trans:SetNativeSize()
                    end)
                end
            end
            if i == 1 then
                -- 设置主动
                go = self.beastSkillList[1]
                go.obj_lock:SetActiveE(0)
                if not beastList[i] or beastList[i] == 0 then
                    -- 槽位没有圣兽
                    go.obj_mask:SetActiveE(1)
                    go.aorrawimage_icon:SetActiveE(0)
                    go.obj_type:SetActiveE(0)
                else
                    go.obj_mask:SetActiveE(0)
                    go.aorrawimage_icon:SetActiveE(1)
                    go.obj_type:SetActiveE(1)
                    local data = require("BeastModel"):GetInstance():GetBeast(beastList[i])
                    local skillId = data:GetSkill_1()[data.star + 1]
                    go.aorrawimage_icon:LoadImage(_G.ConfigManager.card_skills_cfg[skillId].icon,function(trans)
                        if self:IsNil() then
                            return
                        end
                        trans:SetNativeSize()
                    end)
                end
            end
        end
    end
end

function EmbattleBeastSkillView:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local beastList = self.curBeasts
    local go = _G.GetAutoGoTable(obj)
    local data = self.allBeast[index]
    go.aorimage_type:SetActiveE(0)
    for i = 1, 3 do
        if beastList[i] == data:GetID() then
            go.aorimage_type:SetActiveE(1)
            if i == 1 then
                go.aorimage_type.SpriteName = "ui_sssz_zhu_tag"
            else
                go.aorimage_type.SpriteName = "ui_sssz_xie_tag"
            end
            break
        end
    end
    go.aorrawimage_select:SetActiveE(self.selectBeastSid == data:GetID() and 1 or 0)
    local item = require("BeastCardItem").New(go.obj_Item)
    item:Show(data:GetID(),function()
        self:OnBeastClick(data:GetID())
    end)
    item.go_table.aorimage_StarBg.color = _G.ColorTools.FormatColorByString("00000000")
    item.go_table.aortext_Name:SetActiveE(0)
    item.go_table.aorimage_LevelBg:SetActiveE(0)
    item.go_table.aorimage_StarBg:SetLocalPosition(-97,-100,0)
    item.go_table.aorimage_StarBg:SetLocalScaleXYZ(1.3)
    item:ShowBlackStar()
end

---圣兽槽位点击
---@param i number 当前点击的槽位索引
function EmbattleBeastSkillView:SelectBeast(_, _, i)
    if not self.unlock[i] then
        local param = _G.ConfigManager.discrete_cfg[200202][i]
        local _,_,sid,content  = _G.GlobalConditionManager.CheckConditionByArray({param})
        _G.PopWindowManager:GetInstance():ShowAllTips(sid, content)
        return
    end
    if self.selectIndex == i then
        return
    end
    self.selectIndex = i
    self.selectBeastSid = self.curBeasts[self.selectIndex]
    self:SortData()
    self:UpdateBeast()
    self.go_table.scrollloopvectical_beastList:UpdateCount(#self.allBeast)
    self.go_table.scrollloopvectical_beastList:UpdateAllItem()
end

--- 点击技能图标
---@param i number 图标的索引
function EmbattleBeastSkillView:OnSkillClick(_, _, i)
    i = i - 1
    local beastList = self.curBeasts
    local skillId
    if i == 0 then
        i = 1
        if not self.unlock[i] then
            return
        end
        if not beastList[i] or beastList[i] == 0 then
            return
        end
        local data = require("BeastModel"):GetInstance():GetBeast(beastList[i])
        skillId = data:GetSkill_1()[data:GetStar() + 1]
    else
        if not self.unlock[i] then
            return
        end
        if not beastList[i] or beastList[i] == 0 then
            return
        end
        local data = require("BeastModel"):GetInstance():GetBeast(beastList[i])
        skillId = data:GetSkill_2()[data:GetStar() + 1]
    end
    require("CommonTipManager"):GetInstance():OpenBeastSkillTip(beastList[i], skillId)
end

---圣兽上阵/下阵
function EmbattleBeastSkillView:OnBeastClick(id)
    local upEmbattle = true
    local dowmIndex = 0
    for i = 1, 3 do
        if self.curBeasts[i] == id then
            dowmIndex = i
            upEmbattle = false
            break
        end
    end
    local data = require("BeastModel"):GetInstance():GetBeast(id)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BeastEmbattleTipView.Name,data,self.curBeasts[self.selectIndex] ~= id,function()
        if not upEmbattle then
            self.curBeasts[dowmIndex] = 0
            if self.selectCallback then
                self.selectCallback(dowmIndex, 0)
            end
        end
        if dowmIndex ~= self.selectIndex then
            self.curBeasts[self.selectIndex] = id
        end
        if self.selectCallback and dowmIndex ~= self.selectIndex  then
            self.selectCallback(self.selectIndex, id)
        end
        self.selectIndex = self:GetEmptyIndex()
        self.selectBeastSid = self.curBeasts[self.selectIndex]
        self:SortData()
        self:UpdateBeast()
        self:UpdateSkill()
        self.go_table.scrollloopvectical_beastList:UpdateCount(#self.allBeast)
        self.go_table.scrollloopvectical_beastList:UpdateAllItem()
    end)
end

---设置队伍组状态, 以及切换组回调
---@param index number
---@param groupNumber number
---@param groupDisable number[]
---@param chooseCallback fun(index:number,solt:number):void
---@param checkCallback fun(index:number):boolean   @是否显示对应组的红点提示
---@return void
function EmbattleBeastSkillView:SetChooseGroup(index, groupNumber, groupDisable, chooseCallback, checkCallback)
    self.groupIndex = index
    self.groupNumber = groupNumber
    self.groupDisable = groupDisable
    self.groupChooseCallback = chooseCallback
    self.groupCheckCallback = checkCallback

    --初始化节点信息
    self.go_table.obj_group:SetActiveE(1)
    for i = 1, GroupMaxIndex do
        ---@type AorButton
        local group = self.go_table["aorbtn_" .. i]
        group:SetActiveE(i <= groupNumber and 1 or 0)
        if i <= groupNumber then
            ---@type EmbattlePetSkillView._aorbtn_1_GoTable
            local groupItem = _G.GetAutoGoTable(group)
            groupItem.obj_shadow:SetActiveE(groupDisable and utils.includes(groupDisable, i) and 1 or 0)
        end
    end
    self:UpdateGroupStates()
end

---检测宠物组是否可上阵, 并选中当前组
---@return void
function EmbattleBeastSkillView:UpdateGroupStates()
    if not self.groupIndex or not self.groupNumber then
        return
    end

    for i = 1, self.groupNumber do
        ---@type EmbattlePetSkillView._aorbtn_1_GoTable
        local groupItem = _G.GetAutoGoTable(self.go_table["aorbtn_" .. i])
        groupItem.obj_select:SetActiveE(i == self.groupIndex and 1 or 0)
    end
end

function EmbattleBeastSkillView:GetEmptyIndex()
    for k, v in pairs(self.curBeasts) do
        if (not v or v == 0 or v == 1) and self.unlock[k] then
            return k
        end
    end
    return self.selectIndex
end

-- 一键上阵
function EmbattleBeastSkillView:AutoUpEmbattle()
    -- 创建返回结果表
    local replacements = {}
    self.selectIndex = 1 
    self:SortData()
    for index, v in pairs(self.curBeasts) do
        if v == 0 and self.unlock[index] then
            for _, data in pairs(self.allBeast) do
                local id = data:GetID()
                if not _G.table.ContainsValue(self.curBeasts,id) and not _G.table.ContainsValue(replacements,id) then
                    -- 排除被动技能为空的圣兽上阵2，3号
                    if index == 1 or (index > 1 and data:GetSkill_2()[data:GetStar() + 1] ~= 0 ) then
                        replacements[index] = id
                        break
                    end
                end
            end
        end
    end
    for k, v in pairs(replacements) do
        self.curBeasts[k] = v
        if self.selectCallback then
            self.selectCallback(k,v)
        end
    end
    self:UpdateBeast()
    self:UpdateSkill()
    self.go_table.scrollloopvectical_beastList:UpdateAllItem()
end

-- 排序，筛选数据
function EmbattleBeastSkillView:SortData()
    local all = require("BeastModel"):GetInstance():GetAllActiveBeasts()
    self.allBeast =  _G.table.chooseToArray(all,function(k,v)
        if _G.table.ContainsValue(self.disableBeasts,v.sid) then
            return false
        end
        local skill_id = v:GetSkill_2()[v:GetStar() + 1]
        if self.selectIndex > 1 and skill_id == 0 then
            return false
        end
        return true
    end)
    _G.SortList(
        self.allBeast,function(a)
            local id = a:GetID()
            if self.curBeasts[1] == id then
                return 10
            end
            if self.curBeasts[2] == id or self.curBeasts[3] == id then
                return 9
            end
            return a:GetOrder(),a:GetStar(),a:GetLevel(),a:GetID()
        end
    )
end

---按钮点击事件在这里派发
function EmbattleBeastSkillView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_auto then
        self:AutoUpEmbattle()
    else
        --切换组事件
        for i = 1, GroupMaxIndex do
            if go == self.go_table["aorbtn_" .. i] and self.groupChooseCallback and i ~= self.groupIndex then
                if self.groupDisable and utils.includes(self.groupDisable, i) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(3310)
                    return
                end
                self.groupChooseCallback(i, self.curIndex)
            end
        end
    end
end

return EmbattleBeastSkillView
