local base = require("CycleIntegrateBpFdController")

---@class SociatyIntegrateBpFdController 中文描述
---@field datas BaseItemData[] 分解的数据
local SociatyIntegrateBpFdController = _G.BaseClass("SociatyIntegrateBpFdController", base)

function SociatyIntegrateBpFdController:__init()
    self.taskExp = _G.ConfigManager.discrete_cfg[126302][1][1]
end

---是否显示购买经验按钮
function SociatyIntegrateBpFdController:IsShowBtnBuyExp()
    return self.typeClass:GetChossePath() ~= 0 and self.typeClass:IsAddBtnShow()
end

---超值返利数值
function SociatyIntegrateBpFdController:GetRebateNum()
    return _G.GetLangPackValue(90033100034) .. "%"
end

function SociatyIntegrateBpFdController:GetRebateDes()
    return _G.GetLangPackValue(90033100035)
end

---显示当前等级
function SociatyIntegrateBpFdController:ShowCurLevel()
    return true
end

function SociatyIntegrateBpFdController:GetBattlePassRedPointId()
    return self.typeClass:GetRedpointIDByIndex(2)
end

function SociatyIntegrateBpFdController:GetTaskRedPointId()
    return self.typeClass:GetRedpointIDByIndex(3)
end

function SociatyIntegrateBpFdController:RefreshRedPoint()
    self.typeClass:RefreshRedPoint()
end

---是否显示获得经验按钮
function SociatyIntegrateBpFdController:IsShowBtnGetExp()
    return false
end

function SociatyIntegrateBpFdController:JumpGetExp()
end

---获取倒计时样式（1.左侧黑底，2.右侧描边）默认1
function SociatyIntegrateBpFdController:GetRemainingType()
    return 2
end

---经验购买倍率
function SociatyIntegrateBpFdController:GetExpBuyRate()
    return _G.ConfigManager.discrete_cfg[126303][1][1]
end

---购买经验界面标题
function SociatyIntegrateBpFdController:GetBuyExpTitle()
    return _G.GetLangPackValue(90033100036)
end

---购买经验界面等级名称
function SociatyIntegrateBpFdController:GetBuyExpLvName()
    return _G.GetLangPackValue(90033100036)
end

--region ------------- 任务面板 -------------

---是否显示任务
function SociatyIntegrateBpFdController:ShowTask()
    return true
end

---获取所有任务数据
function SociatyIntegrateBpFdController:GetTaskData()
    return self.typeClass:GetTaskData()
end

---任务界面背景图
function SociatyIntegrateBpFdController:GetTaskBackground()
    return "ImagesH5/hIntegrateBpFd/ui_zljjtc_banner_damijing_rengwu"
end

---任务界面背景图
function SociatyIntegrateBpFdController:GetTaskDes()
    return _G.GetLangPackValue(90033100031), _G.GetLangPackValue(90033100032), _G.GetLangPackValue(90033100033)
end

function SociatyIntegrateBpFdController:CheckTaskFinish(sid)
    return self.typeClass:CheckTaskIsFinish(sid)
end

function SociatyIntegrateBpFdController:FinishAllTask(sids, call)
     local taskIds = sids
    self.typeClass:FinishTask(taskIds, 2, call)
end

function SociatyIntegrateBpFdController:FinishTask(sid, call)
    self:FinishTaskOneKey(call)
end

function SociatyIntegrateBpFdController:FinishTaskOneKey(call)
    local taskIds = self.typeClass:GetAllCanFinishTask()
    self.typeClass:FinishTask(taskIds, 2, call)
end

function SociatyIntegrateBpFdController:GetTaskExp(sid)
    return self.taskExp
end

function SociatyIntegrateBpFdController:GetTaskSortId(sid)
    if not self.taskSort then
        self.taskSort = {}
        for i, v in pairs(_G.ConfigManager.discrete_cfg[126301][1]) do
            self.taskSort[v] = -i
        end
    end
    return self.taskSort[sid] or 0
end

--endregion ----------- 任务面板 end -----------

return SociatyIntegrateBpFdController
