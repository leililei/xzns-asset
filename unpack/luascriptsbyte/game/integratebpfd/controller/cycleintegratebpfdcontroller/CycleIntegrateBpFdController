function CycleIntegrateBpFdController:CheckAwardIsGet(id, isFree)
    return self.typeClass:CheckAwardIsGet(id, isFree)
end

function CycleIntegrateBpFdController:GetFirstAwardIndex(lv, awardList)
    local cfg
    local index = 1
    for i = 1, #awardList do
        cfg = awardList[i]
        if lv >= cfg.level then
            if not self.typeClass:CheckAwardIsGet(cfg.id, true) then
                return i
            elseif self:CheckIsBuy() and not self.typeClass:CheckAwardIsGet(cfg.id, false) then
                return i
            else
                index = i
            end
        end
    end
    return index
end

---领取奖励
function CycleIntegrateBpFdController:GetAward(id, isFree, call)
    local awardLis = { { sid = id, type = isFree and 1 or 2 } }
    if self.typeClass:CheckCanSwitchPath() then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            5001,
            nil,
            function()
                self.typeClass:GetAward(awardLis, call)
            end
        )
    else
        self.typeClass:GetAward(awardLis, call)
    end
end

