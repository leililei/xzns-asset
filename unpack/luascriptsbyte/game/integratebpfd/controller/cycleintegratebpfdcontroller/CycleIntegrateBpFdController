function CycleIntegrateBpFdController:GetMaxLevel()
    local pathCfg = _G.ConfigManager.store_battle_theme_cfg[self.typeClass:GetChossePath()]
    local content = pathCfg.content[1]
    local maxId = content[#content]
    return _G.ConfigManager.store_season_battlecon_cfg[maxId].level
end

