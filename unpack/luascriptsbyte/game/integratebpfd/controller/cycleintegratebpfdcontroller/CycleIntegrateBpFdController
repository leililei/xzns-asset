---界面打开后的操作
function CycleIntegrateBpFdController:OnViewOpened()
    local key = "CycleBattlePassPath" .. self.typeClass.bId .. _G.PlayerModel:GetInstance():GetPlayerUid()
    local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    _G.PlayerPrefsManager.SetInt(key, time)
end

function CycleIntegrateBpFdController:PrePrecess(call)
    local path = self.typeClass:GetChossePath()
    local canSwitch = self.typeClass:CheckCanSwitchPath()
    if path == 0 and not canSwitch then
        ---只有一条线路
        path = self.typeClass:GetCfg().content[1]
        self.typeClass:ChoosePath(path, call)
    else
        call()
    end
end

function CycleIntegrateBpFdController:Buy(view)
    if self:CheckIsBuy() then
        _G.PopWindowManager:GetInstance():ShowAllTips(870101)
    else
        local cfg = self.typeClass:GetCfg()
        local pathCfg = self:GetPathCfg()
        local lv, curExp, curMaxExp = self.typeClass:GetLvAndCurLvExp()
        if self.nowLevel and self.nowLevel ~= lv then
            if self.buyTipLua then
                self.buyTipLua:UpdateNowLevel(lv)
            end
        end
        self.nowLevel = lv
        if not self.buyTipLua then
            self.buyTipLua = true
            local params = {}
            params.okFun = function()
                self.typeClass:Buy()
            end
            params.contentIds = pathCfg.content[1]
            params.goods = cfg.goods
            params.price_id = cfg.price_id
            params.name = cfg.name
            params.nowLevel = lv
            params.activityID = self.type
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Task/$_obj_activeBattlePassBuyTips",
                _G.ePoolType.Temporary,
                view.go_table.obj_view,
                function(tran)
                    if view:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    local sortOrder = view.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 41
                    self.buyTipLua = view:AddComponent(tran, require("ActiveBattlePassBuyTips").New(tran, params))
                end
            )
        elseif self.buyTipLua ~= true then
            self.buyTipLua:Show()
        end
    end
end

---购买经验
function CycleIntegrateBpFdController:BuyExp(exp, call)    
    self.typeClass:BuyExp(exp, call)
end

---页面关闭时清理
function CycleIntegrateBpFdController:OnUIClosed()
    self.nowLevel = nil
    if self.buyTipLua then
        self.buyTipLua:Dispose()
        self.buyTipLua = nil
    end
end

function CycleIntegrateBpFdController:GetPathCfg()
    return _G.ConfigManager.store_battle_theme_cfg[self.typeClass:GetChossePath()]
end

return CycleIntegrateBpFdController
