---获取奖励配置
function CycleIntegrateBpFdController:GetAwardList()
    local pathCfg = self:GetPathCfg()
    if pathCfg == nil then
        return {}
    end
    local array = pathCfg.content[1]
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local cfg
    local awardLis = {}
    for _, v in pairs(array) do
        cfg = store_season_battlecon_cfg[v]
        _G.table.insert(awardLis, cfg)
    end
    return awardLis
end

