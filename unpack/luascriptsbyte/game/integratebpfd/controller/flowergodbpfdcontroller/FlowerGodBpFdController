--获取付费奖励集合
function FlowerGodBpFdController:GetSumReward()
    local rewardsSumDic = {}
    local cfgid, cfgInfo, sid, num
    for i = 1, #self.bpCfg.content do
        ---奖励配置id
        cfgid = self.bpCfg.content[i]
        ---奖励配置
        cfgInfo = self.storeContentCfg[cfgid]
        if cfgInfo then
            for j = 1, #cfgInfo.rewards_pay do
                sid = cfgInfo.rewards_pay[j][1]
                num = cfgInfo.rewards_pay[j][2]

                if rewardsSumDic[sid] == nil then
                    rewardsSumDic[sid] = num
                else
                    rewardsSumDic[sid] = rewardsSumDic[sid] + num
                end
            end
        end
    end
    return rewardsSumDic
end

