function FlowerGodBpFdController:Buy(view)
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function(args)
        local okCall = function(args)
            local cfg = _G.ConfigManager.store_season_battle_cfg[self.id]
            if cfg ~= nil then
                local priceId = args == 1 and cfg.price_id or cfg.price_high_id
                require("MallManager"):GetInstance():BuyActiveGift(priceId, nil, cfg.id)
            end
        end
        local bpInfo = self.CycleBattlePassModel.bpInfo[self.PassID]
        if bpInfo.e_time - _G.TimeUtil.GetServerUnixTime() <= 259200 then

            --不足三天提示
            _G.PopWindowManager:GetInstance():ShowAllTips(9013002,nil,function()
                okCall(args)
            end)
        else
            okCall(args)
        end
    end
    local choosePath = self.bpCfg.content[1]
    Params_FundBuyTips.contentIds = _G.ConfigManager.store_battle_theme_cfg[choosePath].content[1]
    Params_FundBuyTips.goods = self.bpCfg.goods
    Params_FundBuyTips.goods_high = self.bpCfg.goods_high
    Params_FundBuyTips.price_id = self.bpCfg.price_id
    Params_FundBuyTips.price_high_id = self.bpCfg.price_high_id
    Params_FundBuyTips.isBuy = self:CheckIsBuy()
    Params_FundBuyTips.isBuyHigh = self:CheckIsBuyHigh()
    Params_FundBuyTips.name = _G.GetLangPackValue(90025200008)
    Params_FundBuyTips.id = self.id
    Params_FundBuyTips.countDown = self:GetRemainingTime()
    Params_FundBuyTips.cfg = _G.ConfigManager.store_season_battlecon_cfg
    if not self.Lua_buyTips then
        self.Lua_buyTips = true
        _G.PoolsManager:GetInstance():Spawn(
                "UIH5/IntegrateBpFd/FlowerGod/$_obj_FlowerGodBuyTips",
                _G.ePoolType.UIItem,
                view.go_table.obj_view,
                function(tran)
                    if view:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    local sort = view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    view.go_table.obj_view:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sort + 160
                    self.Lua_buyTips = require("FlowerGodBuyTips").New(tran, self, Params_FundBuyTips)
                    self.Lua_buyTips:Show()
                end
        )
    elseif self.Lua_buyTips ~= true then
        self.Lua_buyTips:Parse(Params_FundBuyTips)
        self.Lua_buyTips:Show()
    end
end

