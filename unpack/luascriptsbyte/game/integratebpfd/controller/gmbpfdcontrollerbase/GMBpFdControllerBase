local base = require("IntegrateBpFdControllerBase")
---@class GMBpFdControllerBase : IntegrateBpFdControllerBase
---@field data BattlePassBaseData gm战令（基金）
local GMBpFdControllerBase = _G.BaseClass("GMBpFdControllerBase", base)

---类的构造函数
function GMBpFdControllerBase:__init(data)
    self.data = data
end

function GMBpFdControllerBase:CheckIsBuy()
    self.data:GetIsUp()
end

function GMBpFdControllerBase:GetPrice()
    local cfg = self.data:Getcfg_list()
    return cfg.price
end

function GMBpFdControllerBase:GetLvAndCurLvExp()
    local lv, curExp, maxExp = self.data:GetLvAndCurLvExp()
    return lv, curExp, maxExp
end

---获取奖励配置
function GMBpFdControllerBase:GetAwardList()
    local awardList = self.data:GetAwardList()
    local cfgs = {}
    local item
    local cfg = _G.ConfigManager.limited_battlecon_cfg
    local coinId = self:GetLimitCoinId()
    for _, v in pairs(awardList) do
        if cfg[v] then
            item = {}
            item.id = cfg[v].id
            item.level = cfg[v].level
            item.rewards_normal = cfg[v].rewards_free_item
            item.rewards_pay = cfg[v].rewards_pay
            if coinId ~= 0 then
                _G.table.insert(item.rewards_normal,{coinId, cfg[v].rewards_free_cur})
                _G.table.insert(item.rewards_pay,{coinId, cfg[v].rewards_pay_cur})
            end
            item.conditions = cfg[v].conditions
            _G.table.insert(cfgs, item)
        end
    end
    return cfgs
end

function GMBpFdControllerBase:GetSeniorAwardList()
    local award = {}
    for _, v in pairs(self.data:Getcfg_list().award) do
        _G.table.insert(award,{v.sid,v.num})
    end
    return award
end

---获取所有可领取奖励
function GMBpFdControllerBase:GetAllUnlockAwards()
    return self.data:FindAllUnclaimedRewards()
end

function GMBpFdControllerBase:CheckAwardIsGet(id, isFree)
    return self.data:IsAward(id,isFree)
end

---获取第一个可领奖励的下标
function GMBpFdControllerBase:GetFirstAwardIndex()
    return self.data:GetFirstAwardIndex()
end

---领取奖励
function GMBpFdControllerBase:GetAward(id, isFree, call)
    self.data:GetAwardAll(
        {
            {
                type = isFree and 1 or 0,
                a_id = id
            }
        },
        call
    )
end

---一键领奖
function GMBpFdControllerBase:GetAwardOneKey(awards, call)
    self.data:GetAwardAll(nil,call)
end

---是否达到领取条件
function GMBpFdControllerBase:CheckItemCondition(cfg)
    return self.data:CheckRewardCanGet(cfg.conditions)
end

function GMBpFdControllerBase:Buy(view)
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = self:GetBuyParams()
    if not Params_FundBuyTips then
        if _G.AppSetting.DEBUG then
             _G.LogError("没有重写GetBuyParams方法，请在子类中实现")
        end
        return
    end
    if not self.Lua_buyTips then
        self.Lua_buyTips = true
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/GrowthFundView/$_obj_FundBuyTips",
            _G.ePoolType.UIItem,
            view.go_table.obj_view,
            function(tran)
                if view:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                local sort = view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                view.go_table.obj_view:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sort + 160
                self.Lua_buyTips = require("FundBuyTips").New(tran, self, Params_FundBuyTips)
                self.Lua_buyTips:Show()
            end
        )
    elseif self.Lua_buyTips ~= true then
        self.Lua_buyTips:Show()
    end
end

--region 子类重写

function GMBpFdControllerBase:GetName()
    return ""
end

function GMBpFdControllerBase:GetIcon()
    return "ImagesH5/hIntegrateBpFd/ui_zljj_tc_banner_juedou"
end

---获取item标题
function GMBpFdControllerBase:GetLvTitle()
    return ""
end

function GMBpFdControllerBase:GetItemLvContent(index, cfg)
    return index
end

---获取限时代币id
function GMBpFdControllerBase:GetLimitCoinId()
    return 0
end

---获取购买页面参数
function GMBpFdControllerBase:GetBuyParams()
    return nil
end

--endregion

return GMBpFdControllerBase