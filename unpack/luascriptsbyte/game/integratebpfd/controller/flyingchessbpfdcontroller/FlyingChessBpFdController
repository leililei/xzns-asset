function FlyingChessBpFdController:Buy(view)
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function()
        local cfg = _G.ConfigManager.store_season_battle_cfg[self.id]
        if cfg ~= nil then
            require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
        end
    end
    Params_FundBuyTips.contentIds = self.bpCfg.content
    Params_FundBuyTips.goods = self.bpCfg.goods
    Params_FundBuyTips.price_id = self.bpCfg.price_id
    Params_FundBuyTips.name = _G.GetLangPackValue(90025200008)
    Params_FundBuyTips.id = self.id
    Params_FundBuyTips.cfg = _G.ConfigManager.store_season_battlecon_cfg
    if not self.Lua_buyTips then
        self.Lua_buyTips = true
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/GrowthFundView/$_obj_FundBuyTips",
            _G.ePoolType.UIItem,
            view.go_table.obj_view,
            function(tran)
                if view:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                local sort = view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                view.go_table.obj_view:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sort + 160
                self.Lua_buyTips = require("FundBuyTips").New(tran, self, Params_FundBuyTips)
                self.Lua_buyTips:Show()
            end
        )
    elseif self.Lua_buyTips ~= true then
        self.Lua_buyTips:Show()
    end
end

---页面关闭时清理
function FlyingChessBpFdController:OnUIClosed()
    if self.Lua_buyTips then
        self.Lua_buyTips:Dispose()
        self.Lua_buyTips = nil
    end
end

function FlyingChessBpFdController:OnMallCashListener(msg)
    local cfg = _G.ConfigManager.store_season_battle_cfg[msg.sid]
    if cfg then
        require("TeamUniteBattlePassModel"):GetInstance():SetIsUp(msg.sid)
        require "SDKDotManager":GetInstance():OnEvent(_G.SDKDotType.SDKDot_Fund, self.bpCfg.price_id)
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TeamUniteBattlePassView.Name)
        if ctrl then
            ctrl:UpdateView()
        end
    end
end

--获取付费奖励集合
function FlyingChessBpFdController:GetSumReward()
    local rewardsSumDic = {}
    local cfgid, cfgInfo, sid, num
    for i = 1, #self.bpCfg.content do
        ---奖励配置id
        cfgid = self.bpCfg.content[i]
        ---奖励配置
        cfgInfo = self.storeContentCfg[cfgid]
        if cfgInfo then
            for j = 1, #cfgInfo.rewards_pay do
                sid = cfgInfo.rewards_pay[j][1]
                num = cfgInfo.rewards_pay[j][2]

                if rewardsSumDic[sid] == nil then
                    rewardsSumDic[sid] = num
                else
                    rewardsSumDic[sid] = rewardsSumDic[sid] + num
                end
            end
        end
    end
    return rewardsSumDic
end

return FlyingChessBpFdController
