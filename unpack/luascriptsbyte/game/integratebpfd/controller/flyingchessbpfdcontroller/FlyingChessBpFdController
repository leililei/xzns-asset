function FlyingChessBpFdController:GetLvAndCurLvExp()
    local lv = 0
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local lvLis = self.bpCfg.content
    local conCfg, curLvMaxExp
    for i, v in pairs(lvLis) do
        conCfg = store_season_battlecon_cfg[v]
        curLvMaxExp = conCfg.conditions[2]
        if TeamUniteModel:GetTotalCoin() >= conCfg.conditions[2] then
            lv = i
        else
            break
        end
    end
    return lv, 0, curLvMaxExp
end

