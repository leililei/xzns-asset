local base = require("IntegrateBpFdControllerBase")

---@class GrowthIntegrateBpFdController 中文描述
---@field datas BaseItemData[] 分解的数据
local GrowthIntegrateBpFdController = _G.BaseClass("GrowthIntegrateBpFdController", base)


function GrowthIntegrateBpFdController:__init()
    if not require("ActivitySynManager"):GetInstance():CheckActivityOpened(self.type) then
        return
    end
    self.activityClass = require("ActivitySynManager"):GetInstance():GetActivityClass(self.type)
    self.typeClass = self.activityClass.typeClass
end

---初始化数据（页面打开时调用）
function GrowthIntegrateBpFdController:InitData()
    self.activityClass = require("ActivitySynManager"):GetInstance():GetActivityClass(self.type)
    self.typeClass = self.activityClass.typeClass
    self.id = require "GrowthFundModel":GetInstance().sid
    self.bpCfg = _G.ConfigManager.store_battle_pass_cfg[self.id]
    self.storeContentCfg = _G.ConfigManager.store_battle_content_cfg
end

---获取进度描述和字号（与剩余时间不共存）
function GrowthIntegrateBpFdController:GetProgressDes()
    local nowChpater = require("AfkModel"):GetInstance():GetCurAfkChapter() or 1
    local str = _G.GetLangPackValue(90022500370, nowChpater - 1)
    return _G.GetLangPackValue(90000000118) .. ":" .. _G.string.AddColor(str, "fac95f"), 26
end

function GrowthIntegrateBpFdController:GetStage()
    local stage = require "GrowthFundModel":GetInstance():GetCurStage()
    if stage > 1 then
        return _G.GetLangPackValue(90025501110, _G.GameUtil.NumberToChinese(stage))
    end
    return nil
end

function GrowthIntegrateBpFdController:GetRedPointId()
    return self.typeClass:GetRedpointIDByIndex(1) or 0
end

---超值返利数值
function GrowthIntegrateBpFdController:GetRebateNum()
    return _G.GetLangPackValue(90031100033) .. "%"
end

function GrowthIntegrateBpFdController:GetRebateDes()
    local T = self:GetSumReward()
    for k, v in pairs(T) do
        return _G.GetLangPackValue(90031100032, v, _G.StorageManager:GetInstance():GetItemName(k))
    end
    return ""
end

function GrowthIntegrateBpFdController:CheckIsBuy()
    return require("GrowthFundModel"):GetInstance():GetIsUp()
end

function GrowthIntegrateBpFdController:GetPrice()
    local sid = require "GrowthFundModel":GetInstance().sid
    local cfg = _G.ConfigManager.store_battle_pass_cfg[sid]
    return cfg.price_id
end

function GrowthIntegrateBpFdController:GetLvAndCurLvExp()
    local lv = 0
    local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg
    local lvLis = self.bpCfg.content
    local conCfg, curLvMaxExp
    for i, v in pairs(lvLis) do
        conCfg = store_battle_content_cfg[v]
        curLvMaxExp = conCfg.conditions[2]
        if _G.GlobalConditionManager.CheckCondition(conCfg.conditions[1], conCfg.conditions[2]) then
            lv = i
        else
            break
        end
    end
    return lv, 0, curLvMaxExp
end

---获取奖励配置
function GrowthIntegrateBpFdController:GetAwardList()
    local awardLis = {}
    local array = self.bpCfg.content
    local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg
    ---@type store_battle_content_cfg
    local cfg
    for _, v in pairs(array) do
        cfg = store_battle_content_cfg[v]
        _G.table.insert(awardLis, cfg)
    end
    self.awardLis = awardLis
    return awardLis
end

