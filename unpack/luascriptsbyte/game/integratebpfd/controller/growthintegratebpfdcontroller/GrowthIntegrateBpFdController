end

---领取奖励
function GrowthIntegrateBpFdController:GetAward(id, isFree, call)
    require("FundModel"):GetInstance():GetAward(
        self.id,
        isFree and 0 or 1,
        { id },
        function()
            if call then
                call()
            end
        end
    )
end

---一键领奖
function GrowthIntegrateBpFdController:GetAwardOneKey(awards, call)
    if #awards <= 0 then
        return
    end
    require("FundModel"):GetInstance():GetAward(
        self.id,
        2,
        awards,
        function()
            if call then
                call()
            end
        end
    )
end

