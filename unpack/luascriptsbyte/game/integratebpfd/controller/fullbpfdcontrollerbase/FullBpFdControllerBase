local base = require("IntegrateBpFdControllerBase")
---@class FullBpFdControllerBase:IntegrateBpFdControllerBase	中文描述
local FullBpFdControllerBase = _G.BaseClass("FullBpFdControllerBase",base)

---类的构造函数
function FullBpFdControllerBase:__init()
    self.model = require("CycleBattlePassModel"):GetInstance()
    self.cycleEnum = 0
end


function FullBpFdControllerBase:GetViewName()
    return _G.ConfigManager.ui_cfg.IntegrateBpFdFullView.Name
end

---获取活动剩余时间和字号（与进度描述不共存）
function FullBpFdControllerBase:GetRemainingTime()
    return self.model:GetEndTime(self.cycleEnum) - _G.TimeUtil.GetServerUnixTime()
end

function FullBpFdControllerBase:PrePrecess(call)
    if not self.model:GetChossePath(self.cycleEnum) or self.model:GetChossePath(self.cycleEnum) == 0 then
        local path = self.model:GetAllPath(self.cycleEnum)
        self.model:ChoosePath(self.cycleEnum,path[1],call)
    else
        if call then
            call()
        end
    end
end

function FullBpFdControllerBase:CheckIsBuy()
    return self.model:GetIsBuy(self.cycleEnum)
end

function FullBpFdControllerBase:GetPrice()
    local cfg = self.model:GetCfg(self.cycleEnum)
    if not cfg then
        return 0
    end
    return cfg.price_id
end

function FullBpFdControllerBase:GetLvAndCurLvExp()
    local lv, curExp, maxExp = self.model:GetLvAndCurLvExp(self.cycleEnum)
    return lv, curExp, maxExp
end

---获取奖励配置
function FullBpFdControllerBase:GetAwardList()
    local outTable = {}
    local path = self.model:GetAllPath(self.cycleEnum)
    local cfg = _G.ConfigManager.store_battle_theme_cfg[path[1]].content[1]
    for k, v in pairs(cfg) do
        if _G.ConfigManager.store_season_battlecon_cfg[v] then
            _G.table.insert(outTable,_G.ConfigManager.store_season_battlecon_cfg[v])
        end
    end
    return outTable
end

function FullBpFdControllerBase:CheckAwardIsGet(id, isFree)
    return self.model:CheckAwardIsGet(self.cycleEnum,id,isFree)
end


function FullBpFdControllerBase:GetAllUnlockAwards()
    local lv = self.model:GetLvAndCurLvExp(self.cycleEnum)
    return self.model:GetAllUnlockAwards(self.cycleEnum,lv)
end

---是否达到领取条件
function FullBpFdControllerBase:CheckItemCondition(cfg)
    local lv = self.model:GetLvAndCurLvExp(self.cycleEnum)
    if cfg and cfg.level <= lv then
        return true
    end
    return false
end

---一键领奖
function FullBpFdControllerBase:GetAwardOneKey(award,call)
    self.model:GetAward(self.cycleEnum, award, call)
end

function FullBpFdControllerBase:Buy(view)
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = self:GetBuyParams()
    if not Params_FundBuyTips then
        if _G.AppSetting.DEBUG then
             _G.LogError("没有重写GetBuyParams方法，请在子类中实现")
        end
        return
    end
    if not self.Lua_buyTips then
        self.Lua_buyTips = true
        _G.PoolsManager:GetInstance():Spawn(
                "UIH5/Task/$_obj_activeBattlePassBuyTips",
                _G.ePoolType.Temporary,
                view.go_table.obj_view,
                function(tran)
                    if view:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    local sortOrder = view.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                    tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sortOrder + 41
                    self.Lua_buyTips = view:AddComponent(tran, require("ActiveBattlePassBuyTips").New(tran, Params_FundBuyTips))
                end
        )
    elseif self.Lua_buyTips ~= true then
        self.Lua_buyTips:Show()
    end
end

--region 任务

function FullBpFdControllerBase:GetTaskData()
    return self.model:GetTaskData(self.cycleEnum)
end

function FullBpFdControllerBase:CheckTaskFinish(sid)
    return self.model:CheckTaskIsFinish(self.cycleEnum,sid)
end

function FullBpFdControllerBase:FinishTask(id,call)
    self.model:FinishTask(self.cycleEnum,id,2,call)
end

--endregion

--region 子类重写

---item等级文本
function FullBpFdControllerBase:GetItemLvContent(index, cfg)
    return index
end

function FullBpFdControllerBase:GetFirstAwardIndex()
    return 0
end

function FullBpFdControllerBase:GetBGPath()
    return ""
end

function FullBpFdControllerBase:GetBannerPath()
    return ""
end

function FullBpFdControllerBase:GetTaskIcon()
    return ""
end

function FullBpFdControllerBase:GetLvTitle()
    return ""
end

function FullBpFdControllerBase:OnClickTask()
    if _G.AppSetting.DEBUG then
        _G.LogError("任务按钮点击")
    end
end
--endregion

---页面关闭时清理
function FullBpFdControllerBase:OnUIClosed()
    self.nowLevel = nil
    if self.Lua_buyTips then
        self.Lua_buyTips:Dispose()
        self.Lua_buyTips = nil
    end
end

return FullBpFdControllerBase