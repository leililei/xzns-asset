function SpoilsBpFdController:OnClickTask(sid)
    if not self.taskSort then
        self.taskSort = {}
        for i, v in pairs(_G.ConfigManager.discrete_cfg[126611][1]) do
            self.taskSort[v] = -i
        end
    end
    return self.taskSort[sid] or 0
end

