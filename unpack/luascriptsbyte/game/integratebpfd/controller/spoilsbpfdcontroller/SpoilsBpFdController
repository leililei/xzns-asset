end

---获取购买战令获得奖励
function SpoilsBpFdController:GetSeniorAwardList()
    local rewardsSumDic = {}
    local cfg = self.model:GetCfg(self.cycleEnum)
    for _, v in pairs(cfg.goods) do
        self:AddAward(rewardsSumDic, v[1], v[2])
    end
    local seniorAwardList = {}
    for k, v in pairs(rewardsSumDic) do
        _G.table.insert(seniorAwardList, { k, v })
    end
    return seniorAwardList
end

---内部方法，向table中累加奖励
function SpoilsBpFdController:AddAward(tb, sid, num)
    if tb[sid] == nil then
        tb[sid] = num
    else
        tb[sid] = tb[sid] + num
    end
end

