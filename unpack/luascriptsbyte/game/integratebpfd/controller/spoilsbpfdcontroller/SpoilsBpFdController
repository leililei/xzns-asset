---获取购买页面参数
function SpoilsBpFdController:GetBuyParams()
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function()
        local cfg = self.model:GetCfg(self.cycleEnum)
        if cfg ~= nil then
            require("MallManager"):GetInstance():BuyActiveGift(cfg.price, nil, cfg.id)
        end
    end
    local cfg = self.model:GetCfg(self.cycleEnum)
    local path = self.model:GetChossePath(self.cycleEnum)
    local content = _G.ConfigManager.store_battle_theme_cfg[path].content[1]
    Params_FundBuyTips.contentIds = content
    Params_FundBuyTips.goods = cfg.goods
    Params_FundBuyTips.price = cfg.price
    Params_FundBuyTips.name = _G.GetLangPackValue(90025200008)
    Params_FundBuyTips.id = self.id
    Params_FundBuyTips.cfg = _G.ConfigManager.store_season_battlecon_cfg
    return Params_FundBuyTips
end

---获取购买页面参数
function SpoilsBpFdController:Buy(view)
    ---@type Params_FundBuyTips
    local Params_FundBuyTips = {}
    Params_FundBuyTips.okFun = function()
        local cfg = self.model:GetCfg(self.cycleEnum)
        if cfg ~= nil then
            require("MallManager"):GetInstance():BuyActiveGift(cfg.price_id, nil, cfg.id)
        end
    end
    local cfg = self.model:GetCfg(self.cycleEnum)
    local path = self.model:GetChossePath(self.cycleEnum)
    local content = _G.ConfigManager.store_battle_theme_cfg[path].content[1]
    Params_FundBuyTips.contentIds = content
    Params_FundBuyTips.goods = cfg.goods
    Params_FundBuyTips.price_id = cfg.price_id
    Params_FundBuyTips.name = _G.GetLangPackValue(90025200008)
    Params_FundBuyTips.id = self.id
    Params_FundBuyTips.cfg = _G.ConfigManager.store_season_battlecon_cfg
    if not self.Lua_buyTips then
        self.Lua_buyTips = true
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/GrowthFundView/$_obj_FundBuyTips",
            _G.ePoolType.UIItem,
            view.go_table.obj_view,
            function(tran)
                if view:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                local sort = view.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
                view.go_table.obj_view:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = sort + 160
                self.Lua_buyTips = require("FundBuyTips").New(tran, self, Params_FundBuyTips)
                self.Lua_buyTips:Show()
            end
        )
    elseif self.Lua_buyTips ~= true then
        self.Lua_buyTips:Show()
    end
end

function SpoilsBpFdController:GetFirstAwardIndex(lv, awardCfgArray)
    local ItemState = {
        Lock = 1,    --未解锁
        Unlock = 2,  --可领取
        Received = 3 --已领取
    }
    for i = 1, #awardCfgArray do
        local freeState, payState
        local lvEnough = self:CheckItemCondition(awardCfgArray[i])
        freeState = lvEnough and ItemState.Unlock or ItemState.Lock
        payState = (lvEnough and self:CheckIsBuy()) and ItemState.Unlock or ItemState.Lock
        local freeState = self:CheckAwardIsGet(awardCfgArray[i].id, true) and ItemState.Received or freeState
        local payState = self:CheckAwardIsGet(awardCfgArray[i].id, false) and ItemState.Received or payState

        if freeState == ItemState.Unlock or payState == ItemState.Unlock then
            return i
        end
    end
    return 0
end

