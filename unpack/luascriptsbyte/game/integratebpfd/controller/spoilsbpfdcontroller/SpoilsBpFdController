local base = require("FullBpFdControllerBase")
---@class SpoilsBpFdController:FullBpFdControllerBase	中文描述
local SpoilsBpFdController = _G.BaseClass("SpoilsBpFdController", base)

---类的构造函数
function SpoilsBpFdController:__init()
    base.__init(self)
    self.cycleEnum = 6
    self.model:GetTaskInfo(self.cycleEnum)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SpoilsBpFdController:OnMallCashListener(msg)
    local cfg = self.model:GetCfg(self.cycleEnum)
    if msg.sid == cfg.id then
        self.model:OnMallCashEnd(self.cycleEnum)
    end
end

function SpoilsBpFdController:GetViewName()
    return _G.ConfigManager.ui_cfg.IntegrateBpFdView.Name
end

