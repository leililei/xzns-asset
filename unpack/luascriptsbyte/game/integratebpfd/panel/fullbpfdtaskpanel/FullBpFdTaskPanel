---@class FullBpFdTaskPanel : Component	中文描述
local FullBpFdTaskPanel = _G.BaseClass("FullBpFdTaskPanel", _G.Component)

---创建对象时,入口构造函数
function FullBpFdTaskPanel:OnCreate(obj,ctrl,mParentView)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.ctrl = ctrl
    self.mParentView = mParentView
    self:InitView()
end

function FullBpFdTaskPanel:InitView()
    self.taskData = self.ctrl:GetTaskData()
    self.isInited = false
    self:UpdateView()
    self.isInited = true
end

function FullBpFdTaskPanel:UpdateView()
    self:RefreshTask()
end

---任务刷新
function FullBpFdTaskPanel:RefreshTask()
    self.taskDatas = self.ctrl:GetTaskData()
    self:SortTask()
    if not self.isInited then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
    else
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.taskDatas)
    end
end

function FullBpFdTaskPanel:RefreshTaskItem(index, obj)
    ---@type DrawUpBattlePassTaskView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local data = self.taskDatas[index + 1]
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        go_table.aortext_info.text = _G.GetLangPackValue(data.Cfg.desc) .. _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        local isGet = self.ctrl:CheckTaskFinish(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        go_table.aortext_info.text = _G.GetLangPackValue(data.Cfg.desc) .. _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i],
            go_table.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                if data.Cfg.reward[i][2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.ctrl:CheckTaskFinish(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---点击任务
function FullBpFdTaskPanel:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[index]
    if name == "@_aorbtn_get" then
        local ids = {}
        for _, data in pairs(self.taskDatas) do
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited and
                not self.ctrl:CheckTaskFinish(data.Cfg.id) then
                table.insert(ids, data.i_task.sid)
            end
        end
        self.ctrl:FinishTask(ids, function(msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:UpdateView()
            self.mParentView:UpdateView()
        end)
    elseif name == "@_aorbtn_way" then
        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

function FullBpFdTaskPanel:SortTask()
    _G.SortList(
        self.taskDatas,
        function(data)
            local index = 1
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                index = 2
                if self.ctrl:CheckTaskFinish(data.i_task.sid) then
                    index = -1
                end
            end
            return index, -data.i_task.sid
        end
    )
end

function FullBpFdTaskPanel:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeView then
        self.mParentView:HideTaskView()
        self.mParentView:UpdateView()
    end
end

---销毁对象时,析构函数
function FullBpFdTaskPanel:OnDestroy()
end

return FullBpFdTaskPanel