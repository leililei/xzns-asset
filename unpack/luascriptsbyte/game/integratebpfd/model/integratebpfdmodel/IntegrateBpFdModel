---@class IntegrateBpFdModel :Singleton
local IntegrateBpFdModel = _G.BaseClass("IntegrateBpFdModel", _G.Singleton)

---@return IntegrateBpFdModel IntegrateBpFdModel
function IntegrateBpFdModel:GetInstance()
    return self.super.GetInstance(self)
end

local BpFdType = {
    LoginFd = 1011101, -- 登临基金
    GrowthFd = 1011001, -- 成长基金
    SecretRealmFd = 1013302, -- 大秘境基金
    ArenaBp = 1012101, -- 决斗战令
    AbyssBp = 1012001, -- 燃烧战令
    SociatyBp = 1013501, -- 公会基金
    BuildBp = 1013601, -- 建筑战令
    SpoilsBp = 1013901, -- 战利品战令
    RemainsBp = 1014001, -- 奇物基金
    MaidBp = 1014101 ---女仆基金
}

local BpFdCls = {
    [BpFdType.LoginFd] = "LoginIntegrateBpFdController",
    [BpFdType.GrowthFd] = "GrowthIntegrateBpFdController",
    [BpFdType.SecretRealmFd] = "SecretRealmBpFdController",
    [BpFdType.ArenaBp] = "CycleIntegrateBpFdController",
    [BpFdType.AbyssBp] = "CycleIntegrateBpFdController",
    [BpFdType.SociatyBp] = "SociatyIntegrateBpFdController",
    [BpFdType.BuildBp] = "BuildIntegrateBpFdController",
    [BpFdType.SpoilsBp] = "SpoilsBpFdController",
    [BpFdType.MaidBp] = "MaidBpFdController",
    [BpFdType.RemainsBp] = "RemainsBpFdController"
}

function IntegrateBpFdModel:__init()
    self.bpFdLis = _G.ConfigManager.discrete_cfg[114111][1]
    self.controllers = {}
end

function IntegrateBpFdModel:GetBpFdList()
    return self.bpFdLis
end

function IntegrateBpFdModel:GetController(type)
    if not self.controllers[type] then
        if BpFdCls[type] then
            self.controllers[type] = require(BpFdCls[type]).New(type)
        end
    end
    return self.controllers[type]
end

function IntegrateBpFdModel:CheckOneOpen()
    if _G.AppSetting.IsArraigned then
        return false
    end

    return true
end

function IntegrateBpFdModel:Dispose()
    if not self.controllers then
        return
    end
    for k, v in pairs(self.controllers) do
        v:Dispose()
        self.controllers[k] = nil
    end
    self.controllers = nil
end

return IntegrateBpFdModel
