function IntegrateBpFdView:SeniorItemCall(itemLua)
    if self:IsNil() then
        _G.DestroyObject(itemLua.gameObject)
        return
    end
    itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    _G.DelayDo(
        0.35,
        function()
            if self:IsNil() then
               return 
            end
            itemLua:ShowEffectOrder(true)
        end
    )
end

function IntegrateBpFdView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
        self:Close()
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.IntegrateBpFdEnterView.Name)
        if view then
            view:Close()
        end
        return
    end
    if self:IsNil() then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51")
    self.countDownTb.text = _G.GetLangPackValue(90025500007, time)
    self:UpdateAddBtnShow()
end

function IntegrateBpFdView:OnAniEnd()
    --ZHJH-7257 动画缩放导致遮罩对特效的遮挡效果更新异常，延迟加载道具特效
    _G.DelayDo(
        0.5,
        function()
            self.loadEff = true
            self:UpdateBattlePass()
        end
    )
end

---充值成功监听
function IntegrateBpFdView:OnMallCashListener(msg)
    self:UpdateView()
end

---选线后刷新
function IntegrateBpFdView:OnPrePrecessEnd()
    self:ShowByPath()
    self:UpdateBattlePass()
end

function IntegrateBpFdView:OnGetAwardEnd()
    self.ctrl:InitData()
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self:UpdateBattlePass()
end

function IntegrateBpFdView:OnBPUnlock(id)
    if id == self.ctrl.type then
        self:InitView()
    end
end

function IntegrateBpFdView:OnClickItem(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if not self.ctrl:CheckItemCondition(cfg) then
            return
        end
        if self.isBuy then
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        elseif self.ctrl:CheckAwardIsGet(cfg.id, true) then --弹出购买
            self.ctrl:Buy(self)
        else
            -- self.ctrl:GetAward(cfg.id, true)
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        end
    elseif name == "@_aorbtn_buySenior" then
        self.ctrl:Buy(self)
    end
end

---按钮点击事件在这里派发
function IntegrateBpFdView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_add then
        local maxLv = self.ctrl:GetMaxLevel()
        if self.lv == maxLv then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
            return
        end
        if self.lua_AddExp == nil then
            self.lua_AddExp = true
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/DrawUp/SeasonLvView_AddExp",
                _G.ePoolType.UIItem,
                self.go_table.obj_view,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.lua_AddExp =
                        self:AddComponent(trans, require("IntegrateBpFdView_AddExp").New(trans, self.ctrl, self))
                    self.lua_AddExp:Show(self.lv, maxLv, self.curExp)
                end
            )
        elseif self.lua_AddExp ~= true then
            self.lua_AddExp:Show(self.lv, maxLv, self.curExp)
        end
    elseif go == self.go_table.aorbtn_getExp then
        self.ctrl:JumpGetExp()
    elseif go == self.go_table.aorbtn_buy then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_oneKey then
        self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
    elseif go == self.go_table.aorbtn_switch then
        if not self.canSwitch then
            return
        end
        self.go_table.obj_choosePath:SetActiveE(1)
        self.go_table.obj_battlePass:SetActiveE(0)
        self.go_table.aorbtn_add:SetActiveE(0)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, self.ctrl:GetHelpId())
    end
end

function IntegrateBpFdView:ClickBuy()
    self.ctrl:Buy(self)
end

function IntegrateBpFdView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.ctrl:OnUIClosed()
end

return IntegrateBpFdView
