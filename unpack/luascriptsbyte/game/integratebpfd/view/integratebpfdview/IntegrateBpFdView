local BaseAwardNewItem = require("BaseAwardNewItem")

---@class IntegrateBpFdView : UIBaseView    中文描述
---@field public go_table IntegrateBpFdView_GoTable GoTable
---@field ctrl IntegrateBpFdControllerBase
local IntegrateBpFdView = _G.BaseClass("IntegrateBpFdView", _G.UIBaseView)

local ItemState = {
    Lock = 1, --未解锁
    Unlock = 2, --可领取
    Received = 3 --已领取
}

local effectShowSids = _G.ConfigManager.discrete_cfg[114113][1]

function IntegrateBpFdView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity IntegrateBpFdControllerBase
function IntegrateBpFdView:OnCreate(ctrl)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.BattlePassView, self.go_table)
    self.ctrl = ctrl
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener)
    self:AddListener(_G.BattlePassExpEvents.BPUnlock, self.OnBPUnlock)
    --更新视图
    self.ctrl:InitData()
    self:InitView()
    self.ctrl:OnViewOpened()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    self:OnAniEnd()
    UIUtils.SetUIModel(self.go_table.obj_extra,nil,self.go_table.obj_extra2)
end

---初始化窗口，涉及特效，需要activity设置完根节点OrderInLayer后再执行，否则特效层级概率计算错误
function IntegrateBpFdView:InitView()
    self.showItemExp = self.ctrl:IsShowItemExp()
    local countDown, size = self.ctrl:GetRemainingTime()
    if countDown then
        local rType = self.ctrl:GetRemainingType()
        self.go_table.obj_countDown1:SetActiveE(rType == 1 and 1 or 0)
        self.go_table.obj_countDown2:SetActiveE(rType == 2 and 1 or 0)
        _G.UIUtils.ChangeUIByName(_G.IsNeedChangeUI.BattlePassView .. "Time", "aortext_countDown", self.go_table["aortext_countDown" .. rType])
        if rType == 2 then
            self.countDownTb = self.go_table.aortext_countDown2
            self.go_table.aorbtn_add:SetAnchorPosition(-44, -197, 0)
        else
            self.countDownTb = self.go_table.aortext_countDown1
            self.go_table.aorbtn_add:SetAnchorPosition(77, -189, 0)
        end
        self.countDownTb.fontSize = size
        self.countDown = countDown
        self:UpdateTime(0)
        if self.timer == nil then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
        end
    else
        _G.UIUtils.ChangeUIByName(_G.IsNeedChangeUI.BattlePassView .. "Time", "aortext_countDown", self.go_table.aortext_countDown1)
        local des
        des, size = self.ctrl:GetProgressDes()
        self.countDownTb = self.go_table.aortext_countDown1
        self.countDownTb.text = des
        self.countDownTb.fontSize = size
    end
    self.go_table.aortext_title.text = self.ctrl:GetName()
    self.go_table.aortext_rebate.text = self.ctrl:GetRebateNum()
    self.go_table.aortext_des.text = self.ctrl:GetRebateDes()
    self.go_table.aorbtn_getExp:SetActiveE(self.ctrl:IsShowBtnGetExp() and 1 or 0)
    self.go_table.aortext_lisTitle1.text = self.ctrl:GetLvTitle()
    self.go_table.aorrawimage_topBg:LoadImage(self.ctrl:GetIcon())
    self.go_table.aorbtn_help:SetActiveE(self.ctrl:GetHelpId() and 1 or 0)
    self.go_table.obj_level:SetActiveE(self.ctrl:ShowCurLevel() and 1 or 0)
    self:InitToggle()
    self:UpdateView()
end

function IntegrateBpFdView:InitToggle()
    if not self.ctrl:ShowTask() then
        self.go_table.toggle_battlePass:SetActiveE(0)
        self.go_table.toggle_task:SetActiveE(0)
        return
    end
    self.toggles = {
        battlePass = _G.GetAutoGoTable(
            self.go_table.toggle_battlePass,
            _G.handlerbind(self, self.OnClickToggle, "battlePass", _G.handler(self, self.OnBattlePass))
        ),
        task = _G.GetAutoGoTable(
            self.go_table.toggle_task,
            _G.handlerbind(self, self.OnClickToggle, "task", _G.handler(self, self.OnTask))
        )
    }
    self.toggles["battlePass"].obj_redpointBp:UpdateRedPointItemIDAndParam(self.ctrl:GetBattlePassRedPointId())
    self.toggles["task"].obj_redpointTask:UpdateRedPointItemIDAndParam(self.ctrl:GetTaskRedPointId())
end

function IntegrateBpFdView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

---刷新界面
function IntegrateBpFdView:UpdateView()
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self.ctrl:PrePrecess(_G.handler(self, self.OnPrePrecessEnd))
    require("RedPointManager"):GetInstance():RefreshNode(self.ctrl:GetBattlePassRedPointId())
    require("RedPointManager"):GetInstance():RefreshNode(self.ctrl:GetTaskRedPointId())
end

function IntegrateBpFdView:OnBattlePass(isOn)
    self.go_table.obj_bpPanel:SetActiveE(isOn and 1 or 0)
end

function IntegrateBpFdView:OnTask(isOn)
    self.go_table.obj_taskPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.taskInit then
        self.taskInit = true
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/IntegrateBpFd/$_obj_IntegrateBpFdTask",
            _G.ePoolType.UIItem,
            self.go_table.obj_taskPanel,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.taskLua = self:AddComponent(trans, require("IntegrateBpFdTaskPanel").New(trans, self.ctrl, self))
            end
        )
    end
end

