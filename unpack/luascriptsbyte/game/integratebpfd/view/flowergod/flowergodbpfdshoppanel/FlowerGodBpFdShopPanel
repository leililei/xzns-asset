function FlowerGodBpFdShopPanel:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        return
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "5bdf99")
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(22290000131, time)
end

function FlowerGodBpFdShopPanel:Dispose()
    self:RemoveListener(_G.eShopStatus.Update, self.ShopUpdateEvent)
    self.go_table = nil
    self.ListView = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return FlowerGodBpFdShopPanel