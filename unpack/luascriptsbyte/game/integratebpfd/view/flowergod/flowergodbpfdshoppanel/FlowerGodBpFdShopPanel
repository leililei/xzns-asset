---商店刷新
function FlowerGodBpFdShopPanel:ShopUpdateEvent()
    local shopId = self.ctrl:GetShopId()
    local Shop = ShopModel:GetShop()
    local shopData = Shop[shopId]
    self.GoodsList = {}
    for i = 1, #shopData.SPitem do
        table.insert(self.GoodsList,shopData.SPitem[i])
    end
    table.sort(self.GoodsList, function(a,b)
        local aLockBol = _G.GlobalConditionManager.CheckConditionArrays(a.conditions)
        local bLockBol = _G.GlobalConditionManager.CheckConditionArrays(b.conditions)
        local aSoldOut = a.BuyTime >= a.limit
        local bSoldOut = b.BuyTime >= b.limit
        local aWeight = (aSoldOut and 2 or 0) + (not aLockBol and 1 or 0)
        local bWeight = (bSoldOut and 2 or 0) + (not bLockBol and 1 or 0)
        if aWeight ~= bWeight then
            return aWeight < bWeight
        end
        return a.cfg.id < b.cfg.id
    end)
    if not self.ListView then
        self.go_table.scrollloopvectical_ItemList:InitItemData(
                #self.GoodsList,
                _G.handler(self, self.RefreshGoodsList)
        )
        self.ListView = true
    else
        self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.GoodsList)
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    local countDown, size = self.ctrl:GetShopLeftTime()
    if countDown then
        self.countDown = countDown
        self:UpdateTime(0)
        if self.timer == nil then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
        end
    end
    RedPointManager:RefreshNode(_G.ConfigManager.redpoint_cfg.FlowerGodCycleBattle.id,_G.FlowerGodToggleIndex.FlowerGodShop)
end


function FlowerGodBpFdShopPanel:RefreshGoodsList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    ---@type ShopView._obj_ListItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnGoodsClick, x))
    local data = self.GoodsList[x]
