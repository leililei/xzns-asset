local FlowerGodBpFdTaskPanel = _G.BaseClass("FlowerGodBpFdTaskPanel", _G.Component)

function FlowerGodBpFdTaskPanel:Awake()
end

function FlowerGodBpFdTaskPanel:OnCreate(obj, ctrl, mParentView)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.ctrl = ctrl
    self.mParentView = mParentView
    self:InitView()
end

function FlowerGodBpFdTaskPanel:InitView()
    self.go_table.aorrawimage_topBg:LoadImage(self.ctrl:GetTaskBackground())
    local des1, des2, des3 = self.ctrl:GetTaskDes()
    self.go_table.aortext_des1.text = des1 or ""
    self.go_table.aortext_des2.text = des2 or ""
    --self.go_table.aortext_des3.text = des3 or ""
    local countDown, size = self.ctrl:GetRemainingTime()
    if countDown then
        self.countDown = countDown
        self:UpdateTime(0)
        if self.timer == nil then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
        end
    end

    self.go_table.obj_level:SetActiveE(self.ctrl:ShowCurLevel() and 1 or 0)
    self:UpdateList()
end

function FlowerGodBpFdTaskPanel:UpdateLevel()
    if not self.ctrl:ShowCurLevel() then
        return
    end
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self.go_table.aortext_lv.text = self.lv
    self.go_table.slider_exp.value = self.curMaxExp == 0 and 1 or self.curExp / self.curMaxExp
    self.go_table.aortext_exp.text = self.curMaxExp == 0 and _G.GetLangPackValue(9002050021) or self.curExp .. "/" .. self.curMaxExp
end

function FlowerGodBpFdTaskPanel:UpdateList()
    local taskList = _G.table.toArray(self.ctrl:GetTaskData())
    self.taskList = {}
    local taskDis = {}
    --- 按条件分组
    for i = 1, #taskList do
        local index = 0
        if #taskList[i].Cfg.condition[1] < 3 then
            index = taskList[i].Cfg.condition[1][1] * 1000
        else
            index = taskList[i].Cfg.condition[1][1] * 1000 + taskList[i].Cfg.condition[1][1]
        end
        if taskDis[index] == nil then
            taskDis[index] = {}
        end
        table.insert(taskDis[index], taskList[i])
    end

    --- 给每组任务ID从小到大排序
    for k, v in pairs(taskDis) do
        table.sort(
                v,
                function(a, b)
                    return a.i_task.sid < b.i_task.sid
                end
        )
        local isHave = false
        for i = 1, #v do
            local state = self.ctrl:CheckTaskFinish(v[i].i_task.sid)
            if not isHave then
                if i == 1 and v[i].i_task.state == _G.TaskEnum.ETaskState.Claimed then
                    table.insert(self.taskList, v[i])
                    isHave = true
                elseif v[i].i_task.state == _G.TaskEnum.ETaskState.Submited and not state then
                    table.insert(self.taskList, v[i])
                    isHave = true
                elseif i > 1 and i ~= #v and v[i - 1].i_task.state == _G.TaskEnum.ETaskState.Submited and self.ctrl:CheckTaskFinish(v[i - 1].i_task.sid) then
                    if v[i].i_task.state == _G.TaskEnum.ETaskState.Claimed then
                        table.insert(self.taskList, v[i])
                        isHave = true
                    end
                elseif i == #v then
                    table.insert(self.taskList, v[i])
                    isHave = true
                end
            end
        end
    end
    _G.SortList(
            self.taskList,
            function(task)
                local sort
                if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
                    if self.ctrl:CheckTaskFinish(task.i_task.sid) then
                        sort = 1
                    else
                        sort = 3
                    end
                else
                    sort = 2
                end
                if self.ctrl:GetTaskSortId(task.i_task.sid) == 0 then
                    return sort, -task.i_task.sid
                else
                    return sort, self.ctrl:GetTaskSortId(task.i_task.sid), -task.i_task.sid
                end
            end
    )
    if not self.init then
        self.go_table.scrollloopvectical_items:InitItemData(#self.taskList, _G.handler(self, self.RefreshTask))
        self.init = true
    else
        self.go_table.scrollloopvectical_items:UpdateAllItem()
    end
    self:UpdateLevel()
end

function FlowerGodBpFdTaskPanel:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        return
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "5bdf99")
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(22290000131, time)
end

function FlowerGodBpFdTaskPanel:RefreshTask(index, obj)
    index = index + 1
    local task = self.taskList[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, task))
    tb.aortext_name.text = _G.GetLangPackValue(task.Cfg.desc)
    local curNum = task.i_task.target[1]
    tb.slider_progress.value = curNum / task.Cfg.count
    tb.aortext_Slider.text = curNum .. "/" .. task.Cfg.count
    local isGet
    if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
        isGet = self.ctrl:CheckTaskFinish(task.i_task.sid)
        tb.aorbtn_unGet:SetActiveE(0)
        tb.aorbtn_get:SetActiveE(isGet and 0 or 1)
        tb.obj_complete:SetActiveE(isGet and 1 or 0)
    else
        tb.aorbtn_unGet:SetActiveE(1)
        tb.aorbtn_get:SetActiveE(0)
        tb.obj_complete:SetActiveE(0)
    end
    tb.obj_items:ClearChildren()
    tb.aortext_labelNum.text = self.ctrl:GetTaskExp(task.i_task.sid)
    --for _, v in pairs(task.Cfg.reward) do
    --    self:CreateItem(v, tb.obj_items, isGet)
    --end
end

function FlowerGodBpFdTaskPanel:CreateItem(data, parent, isGet)
    local obj = _G.InstantiateObject(self.go_table.obj_award, parent)
    local tb = _G.GetAutoGoTable(obj)
    obj:SetActiveE(1)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            tb.obj_Root,
            function(item)
                if _G.IsNil(obj) then
                    _G.DestroyImmediate(item.gameObject)
                    return
                end
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
                tb.obj_gou:SetActiveE(isGet and 1 or 0)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
            end
    )
end

function FlowerGodBpFdTaskPanel:OnClickTask(go, isOn, task)
    local name = go:GetName()
    if name == "@_aorbtn_unGet" then
        _G.JumpManager:GetInstance():Jump(task.Cfg.link)
    elseif name == "@_aorbtn_get" then
        local taskIds = {}
        for _, v in pairs(self.taskList) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited and not self.ctrl:CheckTaskFinish(v.i_task.sid) then
                _G.table.insert(taskIds, v.i_task.sid)
            end
        end
        self.ctrl:FinishAllTask(
                taskIds,
                function(msg)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    self:UpdateList()
                    if self.mParentView then
                        self.mParentView:UpdateView()
                    end
                end
        )
    end
end

function FlowerGodBpFdTaskPanel:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1044)
    end
end

function FlowerGodBpFdTaskPanel:Dispose()
    self.go_table = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return FlowerGodBpFdTaskPanel
