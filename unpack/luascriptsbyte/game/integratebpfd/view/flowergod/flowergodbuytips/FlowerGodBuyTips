function FlowerGodBuyTips:Init()
    -- _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.FlowerGodBuyTips, self.go_table)
    local content1 = _G.GameUtil.SetPriceByChannel(self.price_id)
    local content2 = _G.GameUtil.SetPriceByChannel(self.price_high_id)
    self.go_table.aortext_rmb1.text = content1 --GetLangPackValue(90025500017, content1)
    self.go_table.aortext_rmb2.text = content2 --GetLangPackValue(90025500017, content2)

    --self.go_table.aortext_name.text = self.name
    if self.contentIds == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("", "<color=red>" .. "参数有误 奖励为空" .. "</color>")
        end
        return
    end

    ---低级付费总计获得
    ---{ sid=num, }
    local rewardsSumDic = {}
    ---高级付费总计活动
    local rewardsHighSumDic = {}

    local sid
    local num
    for j = 1, #self.goods do
        sid = self.goods[j][1]
        num = self.goods[j][2]
        if rewardsSumDic[sid] == nil then
            rewardsSumDic[sid] = num
        else
            rewardsSumDic[sid] = rewardsSumDic[sid] + num
        end
    end

    for j = 1, #self.goods_high do
        sid = self.goods_high[j][1]
        num = self.goods_high[j][2]
        if rewardsHighSumDic[sid] == nil then
            rewardsHighSumDic[sid] = num
        else
            rewardsHighSumDic[sid] = rewardsHighSumDic[sid] + num
        end
    end

    local  cfgid, isPass
    ---@type store_battle_content_cfg
    local cfgInfo
    for i = 1, #self.contentIds do
        ---奖励配置id
        cfgid = self.contentIds[i]
        ---奖励配置
        cfgInfo = self.storeContentCfg[cfgid]
        if cfgInfo then
            ---true可领取
            if self.customCond then
                isPass = require("FundModel"):GetInstance():CheckCondition(cfgInfo.conditions)
            else
                if cfgInfo.conditions[3] then
                    isPass = _G.GlobalConditionManager.CheckCondition(cfgInfo.conditions[1], cfgInfo.conditions[2],
                            cfgInfo.conditions[3])
                else
                    isPass = _G.GlobalConditionManager.CheckCondition(cfgInfo.conditions[1], cfgInfo.conditions[2])
                end
            end
            for j = 1, #cfgInfo.rewards_pay do
                sid = cfgInfo.rewards_pay[j][1]
                num = cfgInfo.rewards_pay[j][2]

                if rewardsSumDic[sid] == nil then
                    rewardsSumDic[sid] = num
                else
                    rewardsSumDic[sid] = rewardsSumDic[sid] + num
                end
            end

            for j = 1, #cfgInfo.rewards_high_pay do
                sid = cfgInfo.rewards_high_pay[j][1]
                num = cfgInfo.rewards_high_pay[j][2]

                if rewardsHighSumDic[sid] == nil then
                    rewardsHighSumDic[sid] = num
                else
                    rewardsHighSumDic[sid] = rewardsHighSumDic[sid] + num
                end

            end
        end
    end

    self:CreateItemList(rewardsSumDic,self.go_table.obj_item2)
    self:CreateItemList(rewardsHighSumDic,self.go_table.obj_item1)

    if not self.isBuy then
        self.go_table.obj_titleBgLock:SetActiveE(1)
        self.go_table.aorbtn_btn2:SetGray(true)
    else
        self.go_table.obj_titleBgLock:SetActiveE(0)
        self.go_table.aorbtn_btn2:SetGray(false)
    end

    self.go_table.aortext_title2 = GetLangPackValue(22290000125)
    ----二档买了再显示三挡
    --if self.isBuy then
    --    self.go_table.trans_Two:SetActiveE(1)
    --    self.go_table.aorrawimage_Bg:SetActiveE(1)
    --    self.go_table.aorrawimage_Bg1:SetActiveE(0)
    --    self.go_table.trans_One:SetLocalPosition(0,-191)
    --    self.go_table.trans_Two:SetLocalPosition(-10,116)
    --else
    --    self.go_table.aorrawimage_Bg:SetActiveE(0)
    --    self.go_table.aorrawimage_Bg1:SetActiveE(1)
    --    self.go_table.trans_Two:SetActiveE(0)
    --    self.go_table.trans_One:SetLocalPosition(-10,0)
    --end

    if self.isBuy then
        self.go_table.aorbtn_btn1:SetActiveE(0)
        self.go_table.trans_already1:SetActiveE(1)
    else
        self.go_table.aorbtn_btn1:SetActiveE(1)
        self.go_table.trans_already1:SetActiveE(0)
    end

    if self.isBuyHigh then
        self.go_table.aorbtn_btn2:SetActiveE(0)
        self.go_table.trans_already2:SetActiveE(1)
    else
        self.go_table.aorbtn_btn2:SetActiveE(1)
        self.go_table.trans_already2:SetActiveE(0)
    end

    if not self.spine then
        self.go_table.trans_Spine:RemoveAllChildren()
        local cfg = _G.ConfigManager.card_cfg[116040000]
        self.go_table.trans_Spine:SetLocalScaleXYZ(0.5)
        self.go_table.trans_Spine:SetLocalPosition(0, 335, 0)
        _G.PoolsManager:GetInstance():Spawn(cfg.ModelPathHi, _G.ePoolType.UIItem, self.go_table.trans_Spine,
                function(trans)
                    if not self.go_table then
                        _G.DestroyObject(trans)
                        return
                    end
                    GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                    self.spine = trans
                    trans:SetLocalScaleXYZ(0.8)
                    trans:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
                end)
    end

    --self:UpdateTime(0)
    --self:StopTimer()
    --self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    --self.timer:Start()
end

---创建展示 ItemList
---@param rewardsSumDic table<number,number> 数据源
---@param itemParent table 父节点
function FlowerGodBuyTips:CreateItemList(rewardsSumDic,itemParent)
    if _G.table.count(rewardsSumDic) >= 5 then
        itemParent:SetPivotPosition(0, 0.5)
    end
    itemParent:RemoveAllChildren()
    for awardSid, awardNum in pairs(rewardsSumDic) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew({
            [1] = awardSid,
            [2] = awardNum
        }, itemParent, _G.handler(self, self.itemCall))
    end
end

function FlowerGodBuyTips:Show()
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
end

function FlowerGodBuyTips:Hide()
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

function FlowerGodBuyTips:itemCall(itemLua)
    ---@type ItemViewBase
    local lua = itemLua
    itemLua.transform:SetLocalScaleXYZ(0.82,0.82,0.82)
    lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    lua:ShowEffectOrder(true)
end

function FlowerGodBuyTips:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_btn1 then
        if self.okFun then
            self.okFun(1)
        end
        self:Hide()
    elseif go == self.go_table.aorbtn_btn2 then
        if not self.isBuy then
            _G.PopWindowManager:GetInstance():ShowAllTips(9013003,nil)
            return
        end
        if self.okFun then
            self.okFun(2)
        end
        self:Hide()
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        if self.closeFun then
            self.closeFun()
        end
        self:Hide()
    end
end

function FlowerGodBuyTips:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_time.text = GetLangPackValue(90028900002, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "69fa3c"))
end


function FlowerGodBuyTips:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---类的析构函数
function FlowerGodBuyTips:Dispose()
    self.spine = nil
    self:StopTimer()
end

return FlowerGodBuyTips
