local IntegrateBpFdModel = require("IntegrateBpFdModel")

---@class IntegrateBpFdEnterView : UIBaseView    中文描述
---@field public go_table IntegrateBpFdEnterView_GoTable GoTable
---@field activity ActivitySynCfgActivity
---@field awardCfgArray store_season_battlecon_cfg[]
---@field cfg store_season_battle_cfg
---@field battletype_awardshowcfg  store_battle_label_cfg
local IntegrateBpFdEnterView = _G.BaseClass("IntegrateBpFdEnterView", _G.UIBaseView)

function IntegrateBpFdEnterView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
    self:AddListener(_G.BattlePassExpEvents.BPUnlock, self.UpdateView)
end

---界面的入口函数
---@param activity ActivitySynCfgActivity
function IntegrateBpFdEnterView:OnCreate()
    self.battletype_awardshowcfg=_G.ConfigManager.store_battle_label_cfg
    self.militaryId = 118002
    self.IsOpen = true
    self:UpdateBpList()
    self:InitView()
end

---初始化窗口，涉及特效，需要activity设置完根节点OrderInLayer后再执行，否则特效层级概率计算错误
function IntegrateBpFdEnterView:InitView()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(_G.GetAutoGoTable(self.go_table.obj_item))
    end
    self.countDownLis = {}
    self.countDownItemLis = {}
    self:FreshRect()
    self.go_table.scrollloopvectical_BpFd:InitItemData(#self.bpFdLis, _G.handler(self, self.RefreshItem))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

function IntegrateBpFdEnterView:UpdateBpList()
    local bpFdLis = IntegrateBpFdModel:GetInstance():GetBpFdList()
    local T = {}
    self.bpFdLis = {}
    for _, v in pairs(bpFdLis) do
        if require("ActivitySynManager"):GetInstance():CheckActivityOpened(v) then
            _G.table.insert(T, v)
        end
    end
    _G.table.insert(T, self.militaryId)
    local orderID = _G.ConfigManager.discrete_cfg[114112][1]
    for k, v in ipairs(orderID) do
        if table.ContainsValue(T, v) then
            _G.table.insert(self.bpFdLis, v)
        end
    end
end

function IntegrateBpFdEnterView:UpdateView()
    local oldNum = #self.bpFdLis
    self:UpdateBpList()
    local nowNum = #self.bpFdLis
    self:FreshRect()
    if nowNum ~= oldNum then
        self.go_table.scrollloopvectical_BpFd:UpdateCount(nowNum)
    else
        self.go_table.scrollloopvectical_BpFd:UpdateAllItem()
    end
end

function IntegrateBpFdEnterView:FreshRect()
    if #self.bpFdLis <= 3 then
        self.go_table.obj_bg:SetRectTransformSize(634, 631)
        self.go_table.obj_bg:SetLocalPosition(0, -38, 0)
    elseif #self.bpFdLis == 4 then
        self.go_table.obj_bg:SetRectTransformSize(634, 829)
        self.go_table.obj_bg:SetLocalPosition(0, -106, 0)
    else
        self.go_table.obj_bg:SetRectTransformSize(634, 890)
        self.go_table.obj_bg:SetLocalPosition(0, -90, 0)
    end
    _G.GameUtil.ReBuildRTF(self.go_table.scrollloopvectical_BpFd)
end

function IntegrateBpFdEnterView:RefreshItem(index, obj)
    index = index + 1
    local _type = self.bpFdLis[index]
    --军衔的战令特殊处理下
    if _type == self.militaryId then
        self:RefreshMilitaryItem(obj)
        return
    end
    ---@type IntegrateBpFdEnterView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, _type))
    local ide = obj:GetInstanceIDE()
    ---@type IntegrateBpFdControllerBase
    local ctrl = IntegrateBpFdModel:GetInstance():GetController(_type)
    if ctrl == nil then
        return
    end
    tb.aorrawimage_bg:LoadImage(ctrl:GetIcon())
    tb.aortext_name.text = ctrl:GetName()
    local stage = ctrl:GetStage()
    tb.aorimage_stage:SetActiveE(stage and 1 or 0)
    if stage then
        tb.aortext_stage.text = stage
    end
    local remainingTime = ctrl:GetRemainingTime()
    tb.aortext_time:SetActiveE(remainingTime and 1 or 0)
    self.countDownLis[ide] = remainingTime
    self.countDownItemLis[ide] = tb.aortext_time
    if remainingTime then
        self:UpdateSingleTime(ide, 0)
    end

    local redId, param = ctrl:GetRedPointId()
    if param then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(redId, param)
    else
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(redId)
    end
    self:ShowTypeAndAward(tb,_type,remainingTime)
end

function IntegrateBpFdEnterView:RefreshMilitaryItem(obj)
    ---@type IntegrateBpFdEnterView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, self.militaryId))
    local ide = obj:GetInstanceIDE()
    ---@type IntegrateBpFdControllerBase
    tb.aorrawimage_bg:LoadImage("ImagesH5/hIntegrateBpFd/ui_zljj_tc_banner_junxian")
    tb.aortext_name.text = _G.GetLangPackValue(90023900018)
    tb.aorimage_stage:SetActiveE(0)
    tb.aortext_time:SetActiveE(0)
    tb.aorimage_bgName:SetRectTransformSize(390, 75)
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(30105302)
    self:ShowTypeAndAward(tb,self.militaryId,false)
end
function IntegrateBpFdEnterView:ShowTypeAndAward(tb,type,isShowTime)
    local cfg=self.battletype_awardshowcfg[type]
    tb.aorimage_type:SetActiveE((cfg and cfg.label>0) and 1 or 0)
    local y = 75
    if isShowTime then
        if cfg and not table.isEmptyOrNil(cfg.show) then
            y= 95
        else
            y = 106
        end
    end
    tb.aorimage_bgName:SetRectTransformSize(390, y)
    if cfg and cfg.label>0 then
        tb.aortext_type.text=_G.GetLangPackValue(cfg.label)
        _G.GameUtil.ReBuildRTF(tb.aortext_type)
        _G.GameUtil.ReBuildRTF(tb.aorimage_type)
    end
    tb.obj_award:SetActiveE((cfg and not table.isEmptyOrNil(cfg.show)) and 1 or 0)
    if cfg and not table.isEmptyOrNil(cfg.show) then
        local x,y,z=tb.obj_award:GetLocalPosition()
        y= -44
        tb.obj_award:SetLocalPosition(x,y,z)
        tb.obj_awardCount:ClearChildren()
        for i = 1, #cfg.show do
            local itemobj=_G.InstantiateObject(tb.obj_awarditem,tb.obj_awardCount)
            local itemtb=_G.GetAutoGoTable(itemobj)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    cfg.show[i],
                    itemtb.obj_itemroot,
                    function(tran)
                        if _G.IsNil(tb) then
                            return
                        end
                        tran.gameObject:SetLocalScaleXYZ(0.8)
                        tran:ShowNumText(false)
                    end
            )
        end
    end
end
function IntegrateBpFdEnterView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    for ide, v in pairs(self.countDownLis) do
        self:UpdateSingleTime(ide, elapsed)
    end
end

function IntegrateBpFdEnterView:UpdateSingleTime(ide, elapsed)
    self.countDownLis[ide] = self.countDownLis[ide] - elapsed
    local time = _G.Mathf.RoundToInt(self.countDownLis[ide])
    self.countDownItemLis[ide].text =
        _G.GetLangPackValue(90025500007, _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51"))
end

function IntegrateBpFdEnterView:OnClickItem(go, isOn, _type)
    if _type == self.militaryId then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassToggleView.Name)
        return
    end
    local ctrl = IntegrateBpFdModel:GetInstance():GetController(_type)
    if ctrl == nil then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(ctrl:GetViewName(), ctrl)
end

---按钮点击事件在这里派发
function IntegrateBpFdEnterView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end

function IntegrateBpFdEnterView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.IntegrateBpFdView.Name then
        if self.UpdateViewCor then
            _G.coroutine.stopwaiting(self.UpdateViewCor)
            self.UpdateViewCor = nil
        end
        self.UpdateViewCor =
            _G.DelayFrameDo(
            function()
                if self.IsOpen then
                    self:UpdateView()
                end
            end
        )
    end
end

function IntegrateBpFdEnterView:OnStartClose()
    self.IsOpen = false
    if self.UpdateViewCor then
        _G.coroutine.stopwaiting(self.UpdateViewCor)
        self.UpdateViewCor = nil
    end
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function IntegrateBpFdEnterView:OnDestroy()
end

return IntegrateBpFdEnterView
