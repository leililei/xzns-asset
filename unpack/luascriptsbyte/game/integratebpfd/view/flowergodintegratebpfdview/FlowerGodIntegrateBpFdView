end

---刷新列表项，展示三个奖励
function FlowerGodIntegrateBpFdView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    ---@type store_season_battlecon_cfg
    local cfg = self.awardCfgArray[index]
    local id = cfg.id
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, cfg))

    local freeState, payState,highPayState
    local lvEnough = self.ctrl:CheckItemCondition(cfg)
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isBuy) and ItemState.Unlock or ItemState.Lock
    highPayState = (lvEnough and self.isBuyHigh) and ItemState.Unlock or ItemState.Lock

    tb.freeState = self.ctrl:CheckAwardIsGet(id, true) and ItemState.Received or freeState
    tb.payState = self.ctrl:CheckAwardIsGet(id, false) and ItemState.Received or payState
    tb.highPayState = self.ctrl:CheckHighAwardIsGet(id) and ItemState.Received or highPayState

    -- 第一个奖励：免费奖励 rewards_normal
    local rewards = cfg.rewards_normal
    if not tb.item1 then
        tb.item1 = BaseAwardNewItem.New(tb.obj_item1, nil, 88, tb.obj_item1)
    end
    tb.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemLoadedCall, tb, false,false,1, rewards[1]))

    -- 第二个奖励：付费奖励 rewards_pay[1]
    rewards = cfg.rewards_pay[1]
    tb.obj_item21:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item2 then
            tb.item2 = BaseAwardNewItem.New(tb.obj_item21, nil, 88, tb.obj_item21)
        end
        tb.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true,false,21, rewards[1]))
        tb.obj_gou21:SetActiveE(1)
    else
        tb.obj_gou21:SetActiveE(0)
    end

    rewards = cfg.rewards_pay[2]
    tb.obj_item22:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item3 then
            tb.item3 = BaseAwardNewItem.New(tb.obj_item22, nil, 88, tb.obj_item22)
        end
        tb.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true,false,22, rewards[1]))
        tb.obj_gou22:SetActiveE(1)
    else
        tb.obj_gou22:SetActiveE(0)
    end

    --第三个奖励
    rewards = cfg.rewards_high_pay[1]
    tb.obj_item23:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item4 then
            tb.item4 = BaseAwardNewItem.New(tb.obj_item23, nil, 88, tb.obj_item23)
        end
        tb.item4:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true,true,23, rewards[1]))
        tb.obj_gou31:SetActiveE(1)
    else
        tb.obj_gou31:SetActiveE(0)
    end
    rewards = cfg.rewards_high_pay[2]
    tb.obj_item24:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item5 then
            tb.item5 = BaseAwardNewItem.New(tb.obj_item24, nil, 88, tb.obj_item24)
        end
        tb.item5:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true,true,24, rewards[1]))
        tb.obj_gou32:SetActiveE(1)
    else
        tb.obj_gou32:SetActiveE(0)
    end

    -- 已领打勾
    tb.obj_gou1:SetActiveE(tb.freeState == ItemState.Received and 1 or 0)
    tb.obj_gou2:SetActiveE(tb.payState == ItemState.Received and 1 or 0)
    tb.obj_gou3:SetActiveE(tb.highPayState == ItemState.Received and 1 or 0)
    -- 可领
    tb.aorbtn_get:SetActiveE((tb.freeState == ItemState.Unlock or tb.payState == ItemState.Unlock or tb.highPayState == ItemState.Unlock )
            and 1 or 0)
    tb.aortext_lv.text = self.ctrl:GetItemLvContent(index, cfg)
    --等级经验
    if self.showItemExp then
        local exp = self.ctrl:GetLvExpByLv(cfg)
        tb.aortext_exp.text = exp
        --tb.obj_itemExp:SetActiveE(1)
    else
        --tb.obj_itemExp:SetActiveE(0)
    end

    if tb.aorimage_DayBar then
        --进度条
        tb.aorimage_DayBar:SetActiveE(index == 1 and 0 or 1)
        --tb.aorimage_DayBar:SetRectTransformSize(22, self.showItemExp and 78 or 85)
        if index - 1 < self.lv then
            tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
        elseif index - 1 == self.lv then
            local scale = self.curExp / self.curMaxExp
            tb.aorimage_dayBar:SetLocalScale(1, scale, 1)
        else
            tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
        end
    end

    return obj
end


function FlowerGodIntegrateBpFdView:RefreshSeniorItem(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.seniorAwards[index]
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(data, tb.obj_item, _G.handler(self, self.SeniorItemCall))
end

function FlowerGodIntegrateBpFdView:FindFirstAwardIndex()
    local maxIndex = self.isBuy and #self.awardCfgArray - 4 or #self.awardCfgArray - 3
    local index = self.ctrl:GetFirstAwardIndex(self.lv, self.awardCfgArray)
    return index > maxIndex and maxIndex - 1 or index - 1
end

---@param isBuy boolean true是豪华奖励
---@param itemLua BaseAwardNewItem 奖励脚本
function FlowerGodIntegrateBpFdView:itemLoadedCall(itemLua, tb, isBuy,isBuyHigh, suf, sid)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end
    local state
    if isBuyHigh then
        state = tb.highPayState
    else
        state = isBuy and tb.payState or tb.freeState
    end

    local isShowEffect = state == ItemState.Unlock and self.loadEff

    if itemLua.type ~= _G.StorageType.Card then
        local needShow = _G.table.ContainsValue(effectShowSids, sid)
        itemLua:ShowEffect(needShow)
        if isShowEffect then
            lua:ShowEffect(needShow)
        else
            lua:ShowOrHideEffect(false)
        end
    else
        itemLua:ShowEffect(isShowEffect)
    end
    tb["obj_Eff" .. suf]:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
        tb["obj_Eff" .. suf],
        function(tran)
            if _G.IsNil(self.go_table.gameObject) then
                tran:DestroyObject()
                return
            end
            tran:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end

function FlowerGodIntegrateBpFdView:SeniorItemCall(itemLua)
    if self:IsNil() then
        _G.DestroyObject(itemLua.gameObject)
        return
    end
    itemLua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    _G.DelayDo(
        0.35,
        function()
            if self:IsNil() then
               return
            end
            itemLua:ShowEffectOrder(true)
        end
    )
end

function FlowerGodIntegrateBpFdView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
        self:Close()
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.FlowerGodIntegrateBpFdView.Name)
        if view then
            view:Close()
        end
        return
    end
    if self:IsNil() then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "5bdf99")
    self.countDownTb.text = _G.GetLangPackValue(22290000131, time)
    self:UpdateAddBtnShow()
end

function FlowerGodIntegrateBpFdView:OnAniEnd()
    _G.DelayDo(
        0.5,
        function()
            self.loadEff = true
            self:UpdateBattlePass()
        end
    )
end

---充值成功监听
function FlowerGodIntegrateBpFdView:OnMallCashListener(msg)
    self:UpdateView()
end

---选线后刷新
function FlowerGodIntegrateBpFdView:OnPrePrecessEnd()
    self:ShowByPath()
    self:UpdateBattlePass()
end

function FlowerGodIntegrateBpFdView:OnGetAwardEnd()
    self.ctrl:InitData()
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self:UpdateBattlePass()
end

function FlowerGodIntegrateBpFdView:OnBPUnlock(id)
    if id == self.ctrl.type then
        self:InitView()
    end
end

function FlowerGodIntegrateBpFdView:OnClickItem(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if not self.ctrl:CheckItemCondition(cfg) then
            return
        end
        if self.isBuy then
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        elseif self.ctrl:CheckAwardIsGet(cfg.id, true) then
            self.ctrl:Buy(self)
        else
            self.ctrl:GetAwardOneKey(self.awardLis, _G.handler(self, self.OnGetAwardEnd))
        end
    end
end

---按钮点击事件在这里派发
function FlowerGodIntegrateBpFdView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_Help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1044)
    elseif go == self.go_table.aorbtn_getExp then
        self.ctrl:JumpGetExp()
    elseif go == self.go_table.aorbtn_buy then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_buyNew then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_switch then
        if not self.canSwitch then
            return
        end
        self.go_table.obj_choosePath:SetActiveE(1)
        self.go_table.obj_battlePass:SetActiveE(0)
    end
end

function FlowerGodIntegrateBpFdView:ClickBuy()
    self.ctrl:Buy(self)
end

function FlowerGodIntegrateBpFdView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.ctrl:OnUIClosed()
end

return FlowerGodIntegrateBpFdView