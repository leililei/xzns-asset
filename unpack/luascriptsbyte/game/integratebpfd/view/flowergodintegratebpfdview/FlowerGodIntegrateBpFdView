---界面的入口函数
function FlowerGodIntegrateBpFdView:OnCreate()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    --_G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.BattlePassView, self.go_table)
    --self.ctrl = ctrl
    self.ctrl = require("FlowerGodBpFdController").New()
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener)
    self:AddListener(_G.BattlePassExpEvents.BPUnlock, self.OnBPUnlock)
    --更新视图
    self.ctrl:InitData()
    local tempCfg = self.ctrl.bpCfg
    self.itemH = 128 --通行证item高度+space（118+10）
    local passport_content = _G.ConfigManager.store_battle_theme_cfg[1401].content
    self.maxIdx = #passport_content[1]
    self.mark = {}
    ---@type store_passport_content_cfg
    local cfg
    for i = 1, self.maxIdx do
        cfg = _G.ConfigManager.store_season_battlecon_cfg[passport_content[1][i]]
        if cfg then
            if i == 5 or i == 10 or i == 15 or i == 20 then
            --if cfg.reward == 1 then
                _G.table.insert(self.mark, i)
            end
        elseif _G.AppSetting.DEBUG then
            _G.LogError("store_passport_content_cfg未配置id: " .. self.cfg.passport_content[i])
        end
    end
    self.markNum = #self.mark - 1
    self:InitView()
    self.ctrl:OnViewOpened()
    --_G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
    self:OnAniEnd()
    self:LoadEffect()
    UIUtils.SetUIModel(self.go_table.obj_extra,nil,self.go_table.obj_extra2)
end

---初始化窗口，涉及特效，需要activity设置完根节点OrderInLayer后再执行，否则特效层级概率计算错误
function FlowerGodIntegrateBpFdView:InitView()
    self.showItemExp = self.ctrl:IsShowItemExp()
    local countDown, size = self.ctrl:GetRemainingTime()
    if countDown then
        local rType = self.ctrl:GetRemainingType()
        self.go_table.obj_countDown1:SetActiveE(rType == 1 and 1 or 0)
        self.go_table.obj_countDown2:SetActiveE(rType == 2 and 1 or 0)
        _G.UIUtils.ChangeUIByName(_G.IsNeedChangeUI.BattlePassView .. "Time", "aortext_countDown", self.go_table["aortext_countDown" .. rType])
        if rType == 2 then
            self.countDownTb = self.go_table.aortext_countDown3
        else
            self.countDownTb = self.go_table.aortext_countDown1
        end
        self.countDownTb.fontSize = size
        self.countDown = countDown
        self:UpdateTime(0)
        if self.timer == nil then
            self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
            self.timer:Start()
        end
    else
        _G.UIUtils.ChangeUIByName(_G.IsNeedChangeUI.BattlePassView .. "Time", "aortext_countDown", self.go_table.aortext_countDown1)
        local des
        des, size = self.ctrl:GetProgressDes()
        self.countDownTb = self.go_table.aortext_countDown1
        self.countDownTb.text = des
        self.countDownTb.fontSize = size
    end
    self.go_table.aortext_title.text = self.ctrl:GetName()
    self.go_table.aortext_rebate.text = self.ctrl:GetRebateNum()
    --self.go_table.aortext_des.text = self.ctrl:GetRebateDes()
    --self.go_table.aorbtn_getExp:SetActiveE(self.ctrl:IsShowBtnGetExp() and 1 or 0)
    self.go_table.aortext_lisTitle1.text = self.ctrl:GetLvTitle()
    --self.go_table.aorrawimage_topBg:LoadImage(self.ctrl:GetIcon())--todo 后面展示
    self.go_table.obj_level:SetActiveE(self.ctrl:ShowCurLevel() and 1 or 0)
    self:InitToggle()
    self:UpdateView()
end

function FlowerGodIntegrateBpFdView:InitToggle()
    if not self.ctrl:ShowTask() then
        self.go_table.toggle_battlePass:SetActiveE(0)
        self.go_table.toggle_task:SetActiveE(0)
        return
    end
    self.toggles = {
        battlePass = _G.GetAutoGoTable(
            self.go_table.toggle_battlePass,
            _G.handlerbind(self, self.OnClickToggle, "battlePass", _G.handler(self, self.OnBattlePass))
        ),
        task = _G.GetAutoGoTable(
            self.go_table.toggle_task,
            _G.handlerbind(self, self.OnClickToggle, "task", _G.handler(self, self.OnTask))
        ),
        shop = _G.GetAutoGoTable(
                self.go_table.toggle_shop,
                _G.handlerbind(self, self.OnClickToggle, "shop", _G.handler(self, self.OnShop))
        )
    }
    self.toggles["battlePass"].obj_redpointBp:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.FlowerGodCycleBattle.id,_G.FlowerGodToggleIndex.FlowerGodBattlePass)
    self.toggles["task"].obj_redpointTask:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.FlowerGodCycleBattle.id,_G.FlowerGodToggleIndex.FlowerGodTask)
    self.toggles["shop"].obj_redpointTask:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.FlowerGodCycleBattle.id,_G.FlowerGodToggleIndex.FlowerGodShop)
end

function FlowerGodIntegrateBpFdView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function FlowerGodIntegrateBpFdView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_txz_jianglilingpai, self.go_table.obj_eff, check)
    local obj_nextItem = _G.GetAutoGoTable(self.go_table.obj_nextItem)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_jianglikuang, obj_nextItem.obj_nextItemEffect, check)
end

