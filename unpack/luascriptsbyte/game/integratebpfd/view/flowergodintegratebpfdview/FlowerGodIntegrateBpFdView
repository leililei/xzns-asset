end

function FlowerGodIntegrateBpFdView:OnTask(isOn)
    self.go_table.obj_taskPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.taskInit then
        self.taskInit = true
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5/IntegrateBpFd/FlowerGod/$_obj_FlowerGodBpFdTask",
            _G.ePoolType.UIItem,
            self.go_table.obj_taskPanel,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.taskLua = self:AddComponent(trans, require("FlowerGodBpFdTaskPanel").New(trans, self.ctrl, self))
            end
        )
    end
end

function FlowerGodIntegrateBpFdView:OnShop(isOn)
    self.go_table.obj_shopPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.shopInit then
        self.shopInit = true
        _G.PoolsManager:GetInstance():Spawn(
                "UIH5/IntegrateBpFd/FlowerGod/$_obj_FlowerGodBpFdShop",
                _G.ePoolType.UIItem,
                self.go_table.obj_shopPanel,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.shopLua = self:AddComponent(trans, require("FlowerGodBpFdShopPanel").New(trans, self.ctrl, self))
                end
        )
    end
end

