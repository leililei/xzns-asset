local BaseAwardNewItem = require("BaseAwardNewItem")

---@class IntegrateBpFdFullView : UIBaseView	中文描述
---@field public go_table IntegrateBpFdFullView_GoTable GoTable
local IntegrateBpFdFullView = _G.BaseClass("IntegrateBpFdFullView", _G.UIBaseView)

local ItemState = {
    Lock = 1, --未解锁
    Unlock = 2, --可领取
    Received = 3 --已领取
}

function IntegrateBpFdFullView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param activity IntegrateBpFdFullControllerBase
function IntegrateBpFdFullView:OnCreate(ctrl)
    self.ctrl = ctrl
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener)
    --更新视图
    self.ctrl:InitData()
    self:InitView()
    self.ctrl:OnViewOpened()
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy, true)
end

function IntegrateBpFdFullView:InitView()
    self:InitBg()
    self:InitTask()

    self.countDown = self.ctrl:GetRemainingTime()
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end
    self:UpdateTime(0)
    self:UpdateView()
end

function IntegrateBpFdFullView:InitBg()
    self.go_table.aorrawimage_bg:LoadImage(self.ctrl:GetBGPath())
    self.go_table.aorrawimage_Banner:LoadImage(self.ctrl:GetBannerPath())
    self.go_table.aortext_lisTitle1.text = self.ctrl:GetLvTitle()
end

function IntegrateBpFdFullView:InitTask()
    if self.ctrl:ShowTask() then
        self.go_table.obj_task:SetActiveE(1)
        self.go_table.obj_taskRedpoint:UpdateRedPointItemIDAndParam(self.ctrl:GetTaskRedPointId())
        self.go_table.aorimage_taskIcon.SpriteName = self.ctrl:GetTaskIcon()
    else
        self.go_table.obj_task:SetActiveE(0)
    end
end

function IntegrateBpFdFullView:UpdateView()
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self.ctrl:PrePrecess(_G.handler(self, self.OnPrePrecessEnd))
    require("RedPointManager"):GetInstance():RefreshNode(self.ctrl:GetBattlePassRedPointId())
    require("RedPointManager"):GetInstance():RefreshNode(self.ctrl:GetTaskRedPointId())
end

---刷新加速按钮
function IntegrateBpFdFullView:UpdateAddBtnShow()
    self.go_table.aorbtn_add:SetActiveE(self.ctrl:IsShowBtnBuyExp() and 1 or 0)
end

---刷新战令
function IntegrateBpFdFullView:UpdateBattlePass()
    self.isBuy = self.ctrl:CheckIsBuy()
    -- self.go_table.obj_senior:SetActiveE(self.isBuy and 0 or 1)
    self.go_table.aortext_rmb.text = self.isBuy and "xxx" or self.ctrl:GetPrice()

    self.awardCfgArray = self.ctrl:GetAwardList()

    self.awardLis = self.ctrl:GetAllUnlockAwards(self.lv)
    local jumpIndex = self:FindFirstAwardIndex()
    if not self.bpInit then
        self.go_table.scrollloopvectical_items:InitItemData(
            #self.awardCfgArray,
            _G.handler(self, self.RefreshList),
            jumpIndex
        )
        self.bpInit = true
    else
        self.go_table.scrollloopvectical_items:UpdateCount(#self.awardCfgArray, jumpIndex)
    end
    self.go_table.aorbtn_oneKey:SetActiveE(self.isBuy and 1 or 0)
    self.go_table.aorbtn_oneKey:SetGray(not (#self.awardLis > 1))
    self.go_table.aorbtn_oneKey:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(not (#self.awardLis > 1) and "A9A9A9" or "FFFFFF")
end

function IntegrateBpFdFullView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local cfg = self.awardCfgArray[index]
    local id = cfg.id
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, cfg))

    local freeState, payState
    local lvEnough = self.ctrl:CheckItemCondition(cfg)
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isBuy) and ItemState.Unlock or ItemState.Lock
    tb.freeState = self.ctrl:CheckAwardIsGet(id, true) and ItemState.Received or freeState
    tb.payState = self.ctrl:CheckAwardIsGet(id, false) and ItemState.Received or payState

    local rewards = cfg.rewards_normal
    if not tb.item1 then
        tb.item1 = BaseAwardNewItem.New(tb.obj_item1, nil, 88, tb.obj_item1)
    end
    tb.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemLoadedCall, tb, false, 1, rewards[1]))

    rewards = cfg.rewards_pay[1]
    tb.obj_item21:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item2 then
            tb.item2 = BaseAwardNewItem.New(tb.obj_item21, nil, 88, tb.obj_item21)
        end
        tb.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 21, rewards[1]))
    end
    rewards = cfg.rewards_pay[2]
    tb.obj_item22:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item3 then
            tb.item3 = BaseAwardNewItem.New(tb.obj_item22, nil, 88, tb.obj_item22)
        end
        tb.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 22, rewards[1]))
    end

    ---是否显示第二个
    tb.obj_gou22:SetActiveE(rewards and 1 or 0)
    --tb.obj_suo22:SetActiveE(rewards and 1 or 0)

    ---已领打勾
    tb.obj_gou1:SetActiveE(tb.freeState == ItemState.Received and 1 or 0)
    tb.obj_gou2:SetActiveE(tb.payState == ItemState.Received and 1 or 0)
    ---可领
    tb.aorbtn_get:SetActiveE((tb.freeState == ItemState.Unlock or tb.payState == ItemState.Unlock) and 1 or 0)
    tb.aorbtn_notAchieved:SetActiveE(lvEnough and 0 or 1)
    tb.aorbtn_notAchieved:SetGray(not lvEnough)
    tb.aorbtn_buySenior:SetActiveE((tb.freeState == ItemState.Received and tb.payState == ItemState.Lock) and 1 or 0)
    tb.aorimage_hasGetAll:SetActiveE(
        (tb.freeState == ItemState.Received and tb.payState == ItemState.Received) and 1 or 0
    )

    tb.aortext_lv.text = self.ctrl:GetItemLvContent(index, cfg)

    --进度条
    tb.aorimage_DayBar:SetActiveE(index == 1 and 0 or 1)
    -- tb.aorimage_DayBar:SetRectTransformSize(22, 85)
    if index - 1 < self.lv then
        tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
    elseif index - 1 == self.lv then
        local scale = self.curExp / self.curMaxExp
        tb.aorimage_dayBar:SetLocalScale(1, scale, 1)
    else
        tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
    end
    return obj
end

---@param isBuy boolean true是豪华奖励
---@param itemLua BaseAwardNewItem 奖励脚本
function IntegrateBpFdFullView:itemLoadedCall(itemLua, tb, isBuy, suf, sid)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end

    local state = isBuy and tb.payState or tb.freeState
    local isShowEffect = state == ItemState.Unlock and self.loadEff

    if itemLua.type ~= _G.StorageType.Card then
        local needShow = _G.table.ContainsValue(_G.ConfigManager.discrete_cfg[114113][1], sid)
        itemLua:ShowEffect(needShow)
        if isShowEffect then
            lua:ShowEffect(needShow)
        else
            lua:ShowOrHideEffect(false)
        end
    else
        itemLua:ShowEffect(isShowEffect)
    end
    tb["obj_Eff" .. suf]:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
        tb["obj_Eff" .. suf],
        function(tran)
            if _G.IsNil(self.go_table.gameObject) then
                tran:DestroyObject()
                return
            end
            tran:SetActiveE(isShowEffect and 1 or 0)
        end
    )
end

function IntegrateBpFdFullView:FindFirstAwardIndex()
    local maxIndex = self.isBuy and #self.awardCfgArray - 4 or #self.awardCfgArray - 3
    local index = self.ctrl:GetFirstAwardIndex(self.lv, self.awardCfgArray)
    return index > maxIndex and maxIndex - 1 or index - 1
end

function IntegrateBpFdFullView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
        self:Close()
        return
    end
    if self:IsNil() then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51")
    self.go_table.aortext_hdcqsj.text = _G.GetLangPackValue(90025500007, time)
    self:UpdateAddBtnShow()
end

---充值成功监听
function IntegrateBpFdFullView:OnMallCashListener(msg)
    self:UpdateView()
end

function IntegrateBpFdFullView:OnClickItem(go, isOn, cfg)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        if not self.ctrl:CheckItemCondition(cfg) then
            return
        end
        if self.isBuy then
            self.ctrl:GetAwardOneKey(self.awardLis,_G.handler(self, self.OnGetAwardEnd))
        elseif self.ctrl:CheckAwardIsGet(cfg.id, true) then --弹出购买
            self.ctrl:Buy(self)
        else
            -- self.ctrl:GetAward(cfg.id, true)
            self.ctrl:GetAwardOneKey(self.awardLis,_G.handler(self, self.OnGetAwardEnd))
        end
    elseif name == "@_aorbtn_buySenior" then
        self.ctrl:Buy(self)
    end
end

function IntegrateBpFdFullView:OnPrePrecessEnd()
    self:UpdateAddBtnShow()
    self:UpdateBattlePass()
end

function IntegrateBpFdFullView:OnGetAwardEnd()
    self.ctrl:InitData()
    self.lv, self.curExp, self.curMaxExp = self.ctrl:GetLvAndCurLvExp()
    self:UpdateBattlePass()
    require("RedPointManager"):GetInstance():RefreshNode(self.ctrl:GetBattlePassRedPointId())

end

function IntegrateBpFdFullView:ShowTaskView()
    if self.taskView then
        self.taskView:SetActiveE(1)
    end
end

function IntegrateBpFdFullView:HideTaskView()
    self.taskView:SetActiveE(0)
end

---按钮点击事件在这里派发
function IntegrateBpFdFullView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_add then
        local maxLv = self.ctrl:GetMaxLevel()
        if self.lv == maxLv then
            _G.PopWindowManager:GetInstance():ShowAllTips(420102)
            return
        end
        if self.lua_AddExp == nil then
            self.lua_AddExp = true
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/DrawUp/SeasonLvView_AddExp",
                _G.ePoolType.UIItem,
                self.go_table.obj_buyTip,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.lua_AddExp =
                        self:AddComponent(trans, require("IntegrateBpFdView_AddExp").New(trans, self.ctrl, self))
                    self.lua_AddExp:Show(self.lv, maxLv, self.curExp)
                end
            )
        elseif self.lua_AddExp ~= true then
            self.lua_AddExp:Show(self.lv, maxLv, self.curExp)
        end
    elseif go == self.go_table.aorbtn_buy then
        self:ClickBuy()
    elseif go == self.go_table.aorbtn_oneKey then
        self.ctrl:GetAwardOneKey(self.awardLis,_G.handler(self, self.OnGetAwardEnd))
    elseif go == self.go_table.aorbtn_task then
        if nil == self.taskView then
            self.taskView = true
            _G.PoolsManager:GetInstance():Spawn(
                "UIH5/IntegrateBpFd/$_obj_FullBpFdTask",
                _G.ePoolType.UIItem,
                self.go_table.obj_taskPanel,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    self.taskView = trans
                    self.taskLua = self:AddComponent(trans, require("FullBpFdTaskPanel").New(trans, self.ctrl, self))
                end
            )
        else
            self:ShowTaskView()
        end
    end
end

function IntegrateBpFdFullView:ClickBuy()
    self.ctrl:Buy(self)
end

---界面的销毁函数
function IntegrateBpFdFullView:OnDestroy()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.ctrl:OnUIClosed()
end

return IntegrateBpFdFullView