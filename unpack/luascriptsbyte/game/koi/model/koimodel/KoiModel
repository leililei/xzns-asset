---@class KoiModel : Singleton	中文描述
local base = require "ThemeActivityBaseModel"
local KoiModel = _G.BaseClass("KoiModel", base)
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
---@return KoiManager KoiManager
function KoiModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function KoiModel:InitData(msg)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self.koiData = msg
    self.awardList = {}
    if _G.table.isEmptyOrNil(self.koiData.get_lucky_list) then
        self.koiData.get_lucky_list = {}
    end
    if not _G.table.isEmptyOrNil(self.koiData.cfg_list) then
        --self.awardList = self.koiData.cfg_list
        for _, v in pairs(self.koiData.cfg_list) do
            v.isGet = false
        end
        for _, v in pairs(self.koiData.cfg_list) do
            self.awardList[v.id] = v
        end
        for _, v in pairs(self.koiData.get_lucky_list) do
            self.awardList[v].isGet = true
        end
    end
end

---销毁对象时,析构函数
function KoiModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---进入活动
function KoiModel:EnterActivity()
    if self.koiData.display == 1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.KoiView.Name)
    elseif self.koiData.display == 2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BlessingView.Name)
    end
end

---初始化红点树{{id,lua,child}} id 红点id ,lua 红点脚本需继承RedPointBaseThemeActivity,child 子功能红点id
function KoiModel:InitRedTree()
    self.redTree = {{1, "RedPointKoi", {}}}
end

function KoiModel:CheckRedPoint()
    if not require "ThemeActivityManager":GetInstance():CheckThemeActivityIsOpen() then
        return false
    end
    return self.koiData.luck_draw_times > 0
end

function KoiModel:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
end

function KoiModel:OnMallCashListener(data)
    if #self.koiData.get_lucky_list + self.koiData.luck_draw_times < #self.koiData.cfg_list then
        if self.koiData.total_cash < self.koiData.condition_cash then
            if version == 1 then
                self.koiData.total_cash = data.cash_rmb + self.koiData.total_cash
            elseif version == 2 then
                self.koiData.total_cash = data.base_rmb + self.koiData.total_cash
            end
            if self.koiData.total_cash >= self.koiData.condition_cash then
                self.koiData.luck_draw_times = self.koiData.luck_draw_times + 1
                self:RefreshRedPoint()
            end
        end
    end
end

function KoiModel:GetAward(data,callBack)
    require("KoiNet"):GetInstance():GetKoiAward(data,callBack)
end
return KoiModel
