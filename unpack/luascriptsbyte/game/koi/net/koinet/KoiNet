local base = require("BaseGameNet")

---@class KoiNet : BaseGameNet	通信协议
local KoiNet = _G.BaseClass("KoiNet", base)
---@return KoiNet KoiNet
function KoiNet:GetInstance()
    return base.GetInstance(self)
end

function KoiNet:GetKoiAward(data, callBack)
    local item = _G.ConfigManager.net_map.game_activity_module_theme_lucky
    local port = base.Access(self, item, data, _G.handler(self, self.GetKoiAwardCall))
    self.Call[port] = callBack
end

---@param port number 流水号
---@param data activity_theme.s2c_activity_theme_lucky 返回PB数据
---@param error string 错误信息
function KoiNet:GetKoiAwardCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function KoiNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function KoiNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return KoiNet
