---@class BlessingDrawView : UIBaseView	中文描述
---@field public go_table BlessingDrawView_GoTable GoTable
local BlessingDrawView = _G.BaseClass("BlessingDrawView", _G.UIBaseView)

local Images = {
    [1] = "Images/nBlessing/ui_hyqf_qian_03",
    [2] = "Images/nBlessing/ui_hyqf_qian_01",
    [3] = "Images/nBlessing/ui_hyqf_qian_02"
}

function BlessingDrawView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
    self.Anim = self.go_table.transform:GetComponentE(typeof(CS.UnityEngine.Animator))
end


---界面的入口函数
function BlessingDrawView:OnCreate(data,callback)
    self.awardList = require("KoiModel"):GetInstance().awardList
    if callback then
        self.call = callback
    end
    self.awardData = data
    self.id = self.awardList[data.id].class
    self.go_table.aorrawimage_draw:LoadImage(
        Images[self.id],
        function(tran)
            if tran then
                tran:SetNativeSize()
            end
        end
    )
end

---界面的销毁函数
function BlessingDrawView:OnDestroy()
    self.Anim = nil
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
end

---按钮点击事件在这里派发
function BlessingDrawView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        if self.go_table.aorrawimage_draw:GetActiveSelf() == 1 then
            if self.call then
                self.call(self.awardData)
            end
            self:Close()
        end
    end
end

function BlessingDrawView:FinishAnim()
    if self.id == 1 then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_BlessingDrawView_open_gao,self.go_table.aorrawimage_draw)
    else
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_BlessingDrawView_open_gao,self.go_table.aorrawimage_draw)
    end
end

return BlessingDrawView