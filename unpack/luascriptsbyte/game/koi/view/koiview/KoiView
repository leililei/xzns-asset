---@class KoiView : UIBaseView	中文描述
---@field public go_table KoiView_GoTable GoTable
local KoiView = _G.BaseClass("KoiView", _G.UIBaseView)
local UIUtils = _G.UIUtils
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
function KoiView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function KoiView:OnCreate()
    self.Koies = {}
    self.itemList = {}
    self.sid = require("ThemeActivityManager"):GetInstance():GetActivityID()
    self.KoiesData = require("KoiModel"):GetInstance().koiData
    self.awardList = require("KoiModel"):GetInstance().awardList
    self.awardLength = _G.table.count(self.awardList)
    self.times = self.KoiesData.luck_draw_times
    self:CheckGet()
    self:InitKoies()
    self:LoadEffect()
    self.go_table.obj_BoxDetail:SetActiveE(0)
    self:InitText()
    self:RefreshTip()
    if self.canGet then
        self.go_table.aorbtn_wish:SetGray(false)
        self.go_table.aortext_wish.color = _G.ColorTools.FormatColorByString("823A0F")
    else
        self.go_table.aorbtn_wish:SetGray(true)
        self.go_table.aortext_wish.color = _G.ColorTools.FormatColorByString("444444")
    end
end

function KoiView:InitKoies()
    local i = 1
    for _, v in pairs(self.awardList) do
        local tb = _G.GetAutoGoTable(self.go_table["obj_koi" .. i])
        tb.obj_isOn:SetActiveE(1)
        local tb1 = _G.GetAutoGoTable(tb.obj_item)
        local array = {v.award[1].sid, v.award[1].num}
        --local array = {58, 100}
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            array,
            tb1.obj_Root,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.64)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:SetGou(v.isGet)
                tran:ShowItemCard(not v.isGet)
                self.itemList[v.id] = tran
            end
        )
        if v.isGet then
            tb.obj_isOff:SetActiveE(1)

            tb.obj_isOn:SetActiveE(0)
        end
        self.Koies[v.id] = tb
        self.Koies[v.id].anim = tb["obj_koi" .. i]:GetChildE(0):GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
        i = i + 1
    end
    --隐藏多余的节点
    for j = i, 8 do
        self.go_table["obj_koi" .. j]:SetActiveE(0)
    end
end

function KoiView:InitText()
    self.go_table.aortext_currentHave.text = _G.GetLangPackValue(90028500014, self.times)
    local condition = 0
    local total = 0
    if version == 1 then
        condition = _G.GameUtil.RatioControl(self.KoiesData.condition_cash, 100, 0)
        total = _G.GameUtil.RatioControl(self.KoiesData.total_cash, 100, 0)
        self.go_table.obj_tips:SetActiveE(0)
    elseif version == 2 then
        condition = self.KoiesData.condition_cash
        total = self.KoiesData.total_cash
        self.go_table.obj_tips:SetActiveE(1)
    end
    local nums = self.KoiesData.condition_cash > self.KoiesData.total_cash and total or condition
    local content = _G.GameUtil.GetPriceContentByNum(condition, true)
    self.go_table.aortext_Recharge.text = _G.GetLangPackValue(90036300010, nums, content)
end

function KoiView:RefreshTip()
    local condition = 0
    local total = 0
    if version == 1 then
        condition = self.KoiesData.condition_cash / 100
        total = self.KoiesData.total_cash / 100
    elseif version == 2 then
        condition = self.KoiesData.condition_cash
        total = self.KoiesData.total_cash
    end
    if condition > total and #self.KoiesData.get_lucky_list < self.awardLength then
        local nums = condition - total
        self.tipId = 770102
        self.content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[770102].content, nums)
    else
        self.tipId = 770103
        self.content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[770103].content)
    end
end

---界面的销毁函数
function KoiView:OnDestroy()
end

---按钮点击事件在这里派发
function KoiView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        -- elseif go == self.go_table.aorbtn_box then
        --     self:BoxDetail()
        self:Close()
    elseif go == self.go_table.aorbtn_anyClose then
        self.go_table.obj_BoxDetail:SetActiveE(0)
    elseif go == self.go_table.aorbtn_close then
        self.go_table.obj_BoxDetail:SetActiveE(0)
        for _, v in pairs(self.objs) do
            _G.DestroyObject(v)
        end
    elseif go == self.go_table.aorbtn_wish then
        if self.canGet then
            self:WishButton()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(self.tipId, self.content, nil)
        end
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 78)
    end
end

function KoiView:LoadEffect()
    UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_KoiView_shuye, self.go_table.obj_Effect)
    UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_KoiView_titile, self.go_table.obj_Effect)
    UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_KoiView_yanhua, self.go_table.obj_Effect)
end

