function KoiView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid, item.data.uid)
end

function KoiView:WishButton()
    local msg = {activity_id = self.sid}
    require("KoiNet"):GetInstance():GetKoiAward(
        msg,
        function(data)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            local datas = {}
            datas.award = {}
            datas.award.item = {}
            local StorageManager = _G.StorageManager:GetInstance()
            if self.awardList[data.id] then
                for k, v in pairs(self.awardList[data.id].award) do
                    datas.award.item[k] = StorageManager:SimulationAward(v.sid, v.num)
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, datas)
                self:ReFreshView(data)
            end
        end
    )
end

function KoiView:ReFreshView(data)
    self.awardList[data.id].isGet = true
    self.KoiesData.luck_draw_times = self.KoiesData.luck_draw_times - 1
    self.times = self.KoiesData.luck_draw_times
    _G.table.insert(self.KoiesData.get_lucky_list, data)
    self.go_table.aortext_currentHave.text = _G.GetLangPackValue(90028500014, self.KoiesData.luck_draw_times)
    self.Koies[data.id].obj_isOff:SetActiveE(1)
    self.Koies[data.id].obj_isOn:SetActiveE(0)
    self.Koies[data.id].anim.enabled = true
    --local tb = _G.GetAutoGoTable(self.Koies[data.id].obj_item)
    self.itemList[data.id]:SetGou(true)
    self.itemList[data.id]:ShowItemCard(false)
    self:CheckGet()
    if not self.canGet then
        self.go_table.aorbtn_wish:SetGray(true)
        self.go_table.aortext_wish.color = _G.ColorTools.FormatColorByString("444444")
    end
    self:RefreshTip()
    require("KoiModel"):GetInstance():RefreshRedPoint()
end

function KoiView:CheckGet()
    if #self.KoiesData.get_lucky_list == self.awardLength then
        self.canGet = false
    elseif self.times <= 0 then
        self.canGet = false
    else
        self.canGet = true
    end
end

return KoiView
