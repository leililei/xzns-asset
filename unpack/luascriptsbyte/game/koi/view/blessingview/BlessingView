---@class BlessingView : UIBaseView	中文描述
---@field public go_table BlessingView_GoTable GoTable
local BlessingView = _G.BaseClass("BlessingView", _G.UIBaseView)
local KoiModel = require("KoiModel"):GetInstance()
local StorageManager = _G.StorageManager:GetInstance()
local version = _G.ConfigManager.discrete_cfg[100108][1][1]
local GetLangPackValue = _G.GetLangPackValue
local drawTittle = {
    [1] = 90035010101,
    [2] = 90035010102,
    [3] = 90035010103
}

function BlessingView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BlessingView:OnCreate()
    self.Koies = {}
    self.itemList = {}
    if not self.coinSid then
        self.coinSid = require "ThemeActivityManager":GetInstance():GetCoinSid()
    end
    self.sid = require("ThemeActivityManager"):GetInstance():GetActivityID()
    self.KoiesData = KoiModel.koiData
    self.awardList = KoiModel.awardList
    self.awardLength = _G.table.count(self.awardList)
    self.times = self.KoiesData.luck_draw_times
    self:CheckGet()
    self:InitAwardList()
    self:LoadEffect()
    self:InitText()
    self:RefreshTip()
    if self.canGet then
        self.go_table.aorbtn_wish:SetGray(false)
        self.go_table.aortext_wish.color = _G.ColorTools.FormatColorByString("823A0F")
    else
        self.go_table.aorbtn_wish:SetGray(true)
        self.go_table.aortext_wish.color = _G.ColorTools.FormatColorByString("444444")
    end
end

function BlessingView:InitAwardList()
    local item, tb, length
    for i = 1, 3 do
        item = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Grid)
        tb = _G.GetAutoGoTable(item)
        tb.aortext_tittle.text = GetLangPackValue(drawTittle[i])
        length = 1
        for _, v in pairs(self.awardList) do
            if v.class == i then
                local array = {v.award[1].sid, v.award[1].num}
                StorageManager:GetItemBaseViewNew(
                    array,
                    tb.obj_grid,
                    function(tran)
                        tran.gameObject:SetLocalScaleXYZ(0.87)
                        tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        tran:SetGou(v.isGet)
                        self.itemList[v.id] = tran
                        if i == 1 then
                            tran:ShowEffectOrder(true)
                        else
                            local grade, type = _G.StorageManager:GetInstance():GetItemGrade(array[1])
                            if grade > 4 then
                                tran:ShowEffect(true)
                            end
                        end
                    end
                )
            end
        end
        tb.obj_grid:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup)).enabled = false
        tb.obj_grid:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup)).enabled = true
    end
    self.go_table.obj_Grid:GetComponentE(typeof(CS.UnityEngine.UI.VerticalLayoutGroup)).enabled = false
    self.go_table.obj_Grid:GetComponentE(typeof(CS.UnityEngine.UI.VerticalLayoutGroup)).enabled = true
end

function BlessingView:InitText()
    self.go_table.aortext_currentHave.text = GetLangPackValue(90035010104, self.times)
    local condition = 0
    local total = 0
    if version == 1 then
        condition = _G.GameUtil.RatioControl(self.KoiesData.condition_cash, 100, 0)
        total = _G.GameUtil.RatioControl(self.KoiesData.total_cash, 100, 0)
        condition = tonumber(condition)
        total = tonumber(total)
        local nums = condition > total and total or condition
        self.go_table.obj_tips:SetActiveE(0)
        local content = _G.GameUtil.GetPriceContentByNum(condition, true)
        self.go_table.aortext_Recharge.text = GetLangPackValue(90036300016, nums, content)
    elseif version == 2 then
        condition = self.KoiesData.condition_cash
        total = self.KoiesData.total_cash
        local nums = condition > total and total or condition
        self.go_table.obj_tips:SetActiveE(1)
        self.go_table.aortext_Recharge.text = GetLangPackValue(90035010107, nums, condition)
    end
    self.go_table.aortext_wish.text = GetLangPackValue(90035010105)
end

function BlessingView:RefreshTip()
    local condition = 0
    local total = 0
    if version == 1 then
        condition = self.KoiesData.condition_cash / 100
        total = self.KoiesData.total_cash / 100
    elseif version == 2 then
        condition = self.KoiesData.condition_cash
        total = self.KoiesData.total_cash
    end
    if condition > total and #self.KoiesData.get_lucky_list < self.awardLength then
        local nums = condition - total
        self.tipId = 770102
        self.content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[770102].content, nums)
    else
        self.tipId = 770104
        self.content = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[770104].content)
    end
end

---界面的销毁函数
function BlessingView:OnDestroy()
end

---按钮点击事件在这里派发
function BlessingView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_wish then
        if self.canGet then
            self:WishButton()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(self.tipId, self.content, nil)
        end
    end
end

function BlessingView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_BlessingView_hudie, self.go_table.obj_flyEffect)
end

function BlessingView:OnClickItem(item)
    require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid, item.data.uid)
end

function BlessingView:WishButton()
    local msg = {activity_id = self.sid}
    require("KoiModel"):GetInstance():GetAward(
        msg,
        function(datas)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BlessingDrawView.Name,
                datas,
                function(data)
                    local awardData = self.awardList[data.id].award[1]
                    if awardData.sid == self.coinSid then
                        data.award = {item = {{type = {awardData.sid, awardData.num}}}}
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                    self:ReFreshView(data)
                end
            )
        end
    )
end

function BlessingView:ReFreshView(data)
    self.awardList[data.id].isGet = true
    self.KoiesData.luck_draw_times = self.KoiesData.luck_draw_times - 1
    self.times = self.KoiesData.luck_draw_times
    _G.table.insert(self.KoiesData.get_lucky_list, data)
    self.go_table.aortext_currentHave.text = GetLangPackValue(90035010104, self.KoiesData.luck_draw_times)
    self.itemList[data.id]:SetGou(true)
    self:CheckGet()
    if not self.canGet then
        self.go_table.aorbtn_wish:SetGray(true)
        self.go_table.aortext_wish.color = _G.ColorTools.FormatColorByString("444444")
    end
    self:RefreshTip()
    KoiModel:RefreshRedPoint()
end

function BlessingView:CheckGet()
    if #self.KoiesData.get_lucky_list == self.awardLength then
        self.canGet = false
    elseif self.times <= 0 then
        self.canGet = false
    else
        self.canGet = true
    end
end

return BlessingView
