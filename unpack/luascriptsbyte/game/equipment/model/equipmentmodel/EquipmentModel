---@param EquipmentItem  EquipmentItem
---@param CardData  CardData
function EquipmentModel:GetPartsList(parts, professional, EquipmentItem)
    ---key = 装备位*100 + 装备类型

    ---{key={uid=equip}}
    if self.PartsList == nil then
        return
    end
    if EquipmentItem ~= nil then
        parts = EquipmentItem:GetParts()
        professional = EquipmentItem:GetProfessional()
    end

    local partsDic
    local key = parts * 100 + professional
    if self.PartsList[key] == nil then
        return
    end
    return self.PartsList[key]
end

