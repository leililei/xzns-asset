---穿上装备
function EquipmentModel:DressEquip(cardUid, target, call)
    local msg = {}
    -- if target[1].cfg.limit_level > _G.PlayerModel:GetInstance():GetLevel() then
    --     _G.PopWindowManager:GetInstance():ShowAllTips(tipsID.LevelLimit)
    --     return
    -- end
    if target[1].cardUid > 0 then
        if target[1].cardUid == cardUid then
            if _G.AppSetting.DEBUG then
                _G.Log("不允许穿戴自己当前装备", "<color=red>" .. ">>>" .. "</color>")
            end
            return
        end

        if _G.StorageManager:GetInstance():CheckUnfixEquipmentIsFull(1) then
            _G.PopWindowManager:GetInstance():ShowAllTips(380104)
            return
        end
        msg.indexs = {}
        msg.uid = target[1].cardUid
        table.insert(msg.indexs, target[1].cfg.parts)
        require("EquipmentNet"):GetInstance():EquipmentTake(
            msg,
            _G.handlerbind(
                self,
                self.UnfixEquipSuc,
                target[1].cardUid,
                {target[1].cfg.parts},
                function()
                    msg = {}
                    msg.msg = {}
                    msg.uid = cardUid
                    table.insert(msg.msg, {index = self.cfg[target[1].sid].parts, uid = target[1].uid})
                    require("EquipmentNet"):GetInstance():EquipmentPut(
                        msg,
                        _G._G.handlerbind(self, self.DressEquipSuc, cardUid, target, call)
                    )
                end
            )
        )
    else
        msg = {}
        msg.msg = {}
        msg.uid = cardUid
        table.insert(msg.msg, {index = self.cfg[target[1].sid].parts, uid = target[1].uid})
        require("EquipmentNet"):GetInstance():EquipmentPut(
            msg,
            _G._G.handlerbind(self, self.DressEquipSuc, cardUid, target, call)
        )
    end
end

---穿上装备返回
function EquipmentModel:DressEquipSuc(data, cardUid, target, call)
    if data.ack ~= 1 then
        return
    end
    local cardData = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)[cardUid]
    local power = _G.StorageManager:GetInstance():GetPlayerPower()
    local cardPower = cardData.power
    ---@type  EquipmentItem
    local EquBar
    local equItem
    ---@param v EquipmentItem
    for _, v in pairs(target) do
        EquBar = cardData.EquipBar[self.cfg[v.sid].parts]
        if EquBar ~= nil then
            ---如果原本有装备 要脱入仓库 服务器自己处理
            if EquBar.uid ~= nil then
                equItem = EquBar
                equItem:PutEquip(0)
                _G.StorageManager:GetInstance():AddItemByEquipment(equItem)
            end

            EquBar = require("EquipmentItem").Copy(v)
            EquBar:PutEquip(cardUid, cardData.cfg.Elements_new, nil, true)
            cardData.EquipBar[self.cfg[v.sid].parts] = EquBar
            _G.StorageManager:GetInstance():ConsumeItem(v.sid, v.uid, 1)
        end
    end
    cardData:CalcNowSumProp(_G.AttrType.Equip)
    _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
    ---显示提示
    if cardPower < cardData.power then
        require "CommonTipManager".OpenPowerUpView(power, cardData.power - cardPower)
    end

    _G.AudioManager.PlayAudioByAudioCfgID(2025)
    if call ~= nil then
        call(target)
    end

    --region -------------------------------------同时 穿戴指定品质装备X件 类型59---------
    ---  {品质=数量} 广播任务 ---
    local NowGrardCountDic = {}

    for _, v in pairs(cardData.EquipBar) do
        if not table.isEmptyOrNil(v) then
            local grard = v.Grade
            if NowGrardCountDic[grard] == nil then
                NowGrardCountDic[grard] = 0
            end
            NowGrardCountDic[grard] = NowGrardCountDic[grard] + 1
        end
    end

    local sum = 0
    for Grade, num in pairs(NowGrardCountDic) do
        self:UpdataGradeCountDic(cardUid, Grade, num)
        sum = sum + num
    end
    ---记录任意品质
    self:UpdataGradeCountDic(cardUid, 0, sum)
    --endregion-----------------------------------同时 穿戴指定品质装备X件 类型59---------
    --刷新 死魂塔的 快速挑战红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DeadsoulFast.id)
    --刷新 死魂塔 五行塔开启刷新 红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DeadsoulMain.id)
end
---脱下装备
function EquipmentModel:UnfixEquip(cardUid, indexs, call)
    local msg = {}
    msg.uid = cardUid
    msg.indexs = indexs

    if _G.StorageManager:GetInstance():CheckUnfixEquipmentIsFull(#indexs) then
        ---获取卡牌 获取装备检测脱下装备是否可堆叠

        ---@type  CardData
        local CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
        local num = 0
        local equid, eqdata
        for i = 1, #indexs do
            equid = CardData.EquipBar[indexs[i]].uid
            eqdata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Equipment, equid)
            if eqdata == nil then
                num = num + 1
            end
        end
        if _G.StorageManager:GetInstance():CheckUnfixEquipmentIsFull(num) then
            _G.PopWindowManager:GetInstance():ShowAllTips(380104)
            return
        end
    end
    require("EquipmentNet"):GetInstance():EquipmentTake(
        msg,
        _G.handlerbind(self, self.UnfixEquipSuc, cardUid, indexs, call)
    )
end
---脱下装备返回
function EquipmentModel:UnfixEquipSuc(data, cardUid, indexs, call)
    if data.ack ~= 1 then
        return
    end
    local cardData = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)[cardUid]

    local equItem
    for _, v in pairs(indexs) do
        equItem = cardData.EquipBar[v]
        equItem:PutEquip(0)
        cardData.EquipBar[v] = {}
        _G.StorageManager:GetInstance():AddItemByEquipment(equItem)
    end
    cardData:CalcNowSumProp(_G.AttrType.Equip)
    _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
    _G.AudioManager.PlayAudioByAudioCfgID(2026)

    --region -------------------------------------同时 穿戴指定品质装备X件 类型59---------
    ---  {品质=数量} 当前剩余装备的品质的数量
    local NowGrardCountDic = {}
    for _, v in pairs(cardData.EquipBar) do
        if not table.isEmptyOrNil(v) then
            local grard = v.Grade
            if NowGrardCountDic[grard] == nil then
                NowGrardCountDic[grard] = 0
            end
            NowGrardCountDic[grard] = NowGrardCountDic[grard] + 1
        end
    end
    local sum = 0
    for _, Grade in pairs(_G.EquipmentPart) do
        local num = NowGrardCountDic[Grade] or 0
        sum = sum + num
        self:UpdataGradeCountDic(cardUid, Grade, num)
    end

    ---记录任意品质
    self:UpdataGradeCountDic(cardUid, 0, sum)
    --刷新 死魂塔的 快速挑战红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DeadsoulFast.id)
    --刷新 死魂塔 五行塔开启刷新 红点
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DeadsoulMain.id)
    --endregion-----------------------------------同时 穿戴指定品质装备X件 类型59---------
    if call ~= nil then
        call()
    end
end

