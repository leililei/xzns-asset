function EquipmentModel:CheckCardsArtSid(Cards, call)
    if table.isEmptyOrNil(Cards) then
        return
    end
    local Cardlist = {}
    for _, id in pairs(Cards) do
        ---@type CardData
        local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, id)
        if carddata ~= nil then
            for _, value in pairs(carddata.EquipBar) do
                if not table.isEmptyOrNil(value) then
                    table.insert(Cardlist, id)
                    break
                end
            end
        end
    end
    return Cardlist
end

