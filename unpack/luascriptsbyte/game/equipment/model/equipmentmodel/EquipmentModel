    equip.c_uid = Equip.cardUid
    equip.index = Equip:GetParts()
    msg.equip = equip

    require("EquipmentNet"):GetInstance():EquipmentChoose(
        msg,
        _G.handlerbind(self, self.EquipmentChooseSuc, Equip, type, addition, call)
    )
end
