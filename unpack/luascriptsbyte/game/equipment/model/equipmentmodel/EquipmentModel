function EquipmentModel:EquipResolve(uids, call)
    if table.isEmptyOrNil(uids) then
        return
    end
    local msg = {}
    msg.uids = uids
    require("EquipmentNet"):GetInstance():EquipmentResolve(msg, _G.handlerbind(self, self.EquipResolveSuc, uids, call))
end

---分解装备
function EquipmentModel:EquipResolveSuc(data, uids, call)
    if data.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    for _, v in pairs(uids) do
        _G.StorageManager:GetInstance():ConsumeItem(201101101, v, 1)
    end
    if call ~= nil then
        call(data)
    end
end

---查看强化材料是否够
---@param Equip EquipmentItem
function EquipmentModel:CheckUPMaterial(Equip)
    --- 升级相差经验
    local points_up = 0
    local curCfg = Equip:GetEquipCurStrengCfg()
    local oldExp = curCfg and curCfg.points_up or 0
    local nextCfg = Equip:GetEquipNextStrengCfg()
    if nextCfg then
        points_up = nextCfg.points_up - oldExp - Equip.strengExp
    end
    if points_up == 0 then
        return 0
    end

    ---升级材料
    local materialList = _G.ConfigManager.discrete_cfg[104902]
    local materialExp, materialCoin = 0, 0
    for _, v in pairs(materialList) do
        local count = _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Material, v[1])
        local needCount = _G.Mathf.Ceil((points_up - materialExp) / v[2])
        if count >= needCount then
            materialExp = materialExp + needCount * v[2]
            materialCoin = materialCoin + needCount * v[3]
            break
        else
            materialExp = materialExp + count * v[2]
            materialCoin = materialCoin + count * v[3]
        end
    end

    local StorageManager = _G.StorageManager:GetInstance()
    if materialExp >= points_up and StorageManager:CheckItem(_G.ResPropID.Coin, materialCoin) then
        --资源足够
        return 1
    end

    if materialExp < points_up then
        ---材料经验不足判断装备经验是否足够
        local tParam = _G.ConfigManager.discrete_cfg[104901][1][1]
        -- -装备强化当作材料的比例（除以10000）
        local expBl = tParam * 0.0001
        local templist = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
        local equipList = {}
        local cfgs = _G.ConfigManager.equipment_cfg
        ---@param Equ EquipmentItem
        for _, Equ in pairs(templist) do
            ---7以上的金色
            if Equ.Grade <= 7 and cfgs[Equ.sid] and cfgs[Equ.sid].decomposition > 0 then
                _G.table.insert(equipList, Equ)
            end
        end
        ---按照强化界面的规则排序，否则可能会出现消耗上的误差
        _G.SortList(
            equipList,
            function(a)
                --强化材料展示排序为：强化材料（低品质的在前），装备（低品质的在前，同品质未强化，没有五行属性的优先）
                return -a.Grade, -a.streng, -a.element, -a.streng, a.uid
            end
        )
        for _, v in pairs(equipList) do
            local needCount = _G.Mathf.Ceil((points_up - materialExp - v.strengExp) / cfgs[v.sid].decomposition)
            if v.count >= needCount then
                materialExp = materialExp + v.strengExp * expBl + cfgs[v.sid].decomposition * needCount
                materialCoin = materialCoin + cfgs[v.sid].coin * needCount
            else
                materialExp = materialExp + v.strengExp * expBl + cfgs[v.sid].decomposition * v.count
                materialCoin = materialCoin + cfgs[v.sid].coin * v.count
            end
            if materialExp >= points_up then
                break
            end
        end

        if materialExp >= points_up and StorageManager:CheckItem(_G.ResPropID.Coin, materialCoin) then
            return 1
        end
    end

    return 0
end

