-----计算词缀的品级
function EquipmentModel:CalcAdditionGrade(sid, num)
    local cfg = _G.ConfigManager.equipment_add_att_cfg[sid].value
    local grade = 0
    for _, v in pairs(cfg) do
        if num >= v then
            grade = grade + 1
        end
    end
    return grade
end

