        if k ~= _G.EquipmentPart.Trousers then
            if not _G.table.isEmptyOrNil(v) then
                local equip1 = v[1]
                power = equip1:GetTempElementPower(cardelement)
                if table.isEmptyOrNil(tmpList[k])  then
                    Cpower = 0
                else
