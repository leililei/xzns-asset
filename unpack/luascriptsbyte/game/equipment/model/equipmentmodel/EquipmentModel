---创建对象时,入口构造函数
function EquipmentModel:__init()
    self.equipments = {}
    self.cfg = _G.ConfigManager.equipment_cfg
    ----单卡 最大装备数量 广播判断  同时 穿戴指定品质装备X件 类型59
    self.MaxEquipmentsNum = 4
    ----当前单张卡的装备的品质及数量 方便任务广播 59穿戴指定品质装备X件  self.GradeCountDic={[1]={该品质数量,卡牌uid} }
    self.GradeCountDic = {}

    ---目前的替换规则
    ---卡牌装备[部位]={皮甲={carduid=equitem,}，  }
    self.PartsList = {}

    self.GradeTopCountDic = {}

    ---装备强化消耗的道具
    local cfg = _G.ConfigManager.discrete_cfg[104902]
    self.strengthMaterial = {}
    for _, v in pairs(cfg) do
        self.strengthMaterial[v[1]] = true
    end
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.RefreshRedPoint, self)
end

---刷新装备强化红点
function EquipmentModel:RefreshRedPoint(data)
    for _, v in pairs(data) do
        if v.type and v.type[1] then
            local storageType = _G.StorageManager:GetInstance():CheckSidType(v.type[1])
            if storageType == _G.StorageType.Equipment or v.type[1] == _G.ResPropID.Coin or self.strengthMaterial[v.type[1]] then
                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                    _G.ConfigManager.redpoint_cfg.RedpointEquipmentPart.id
                )
                return
            end
        end
    end
end

---@param equitem EquipmentItem
function EquipmentModel:AddPartsList(equitem, cardUid)
    ---key = 装备位*100 + 装备类型

    ---{key={uid=equip}}
    if self.PartsList == nil then
        self.PartsList = {}
    end

    local parts = equitem:GetParts()
    local professional = equitem:GetProfessional()

    local partsDic
    local key = parts * 100 + professional
    if self.PartsList[key] == nil then
        self.PartsList[key] = {}
    end
    partsDic = self.PartsList[key]
    if (cardUid ~= nil) then
        partsDic[cardUid] = equitem
    end
end
function EquipmentModel:SubPartsList(equitem, cardUid)
    ---key = 装备位*100 + 装备类型

    ---{key={uid=equip}}
    if self.PartsList == nil then
        return
    end

    local parts = equitem:GetParts()
    local professional = equitem:GetProfessional()

    local partsDic
    local key = parts * 100 + professional
    if self.PartsList[key] == nil then
        return
    end
    partsDic = self.PartsList[key]
