function EquipmentModel:InitGradeCountDic()
    self.GradeCountDic = {}
    self.GradeTopCountDic = {}
    local EquipList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    local carduid, tDic
    ---@type EquipmentItem
    for _, v in pairs(EquipList) do
        carduid = v:GetEquipCardUid()
        if carduid ~= nil and carduid ~= 0 then
            if self.GradeCountDic[carduid] == nil then
                self.GradeCountDic[carduid] = {}
            end
            tDic = self.GradeCountDic[carduid]
            if tDic[v.Grade] == nil then
                tDic[v.Grade] = 0
            end
            tDic[v.Grade] = tDic[v.Grade] + 1
            if self.GradeTopCountDic[v.Grade] == nil then
                self.GradeTopCountDic[v.Grade] = {
                    num = tDic[v.Grade],
                    uid = carduid
                }
            else
                local lc = self.GradeTopCountDic[v.Grade].num
                local rc = tDic[v.Grade]
                if lc < rc then
                    self.GradeTopCountDic[v.Grade].num = rc
                    self.GradeTopCountDic[v.Grade].uid = carduid
                end
            end
        end
    end
end

---- 重新获取 每个品质单卡最大装备数量
function EquipmentModel:ReGradeTopCountDic(grade)
    self.GradeTopCountDic[grade] = {
        num = 0,
        uid = 0
    }
    local num = 0
    for uid, arr in pairs(self.GradeCountDic) do
        num = arr[grade]
        if num ~= nil then
            if num > self.GradeTopCountDic[grade].num then
                self.GradeTopCountDic[grade] = {
                    num = num,
                    uid = uid
                }
            end
        end

        if self.MaxEquipmentsNum == self.GradeTopCountDic[grade].num then
            break
        end
    end

    self:BroadcastGradeCount(grade)
end

function EquipmentModel:GetGradeTopCount(grade)
    local data = self.GradeTopCountDic[grade]
    if data ~= nil then
        return data.num
    end
    return 0
end
---- 更新 单卡  该品质装备的数量
function EquipmentModel:UpdataGradeCountDic(uid, grade, count)
    local carduid, tDic
    carduid = uid
    if carduid ~= nil and carduid ~= 0 then
        if self.GradeCountDic[carduid] == nil then
            self.GradeCountDic[carduid] = {}
        end
        tDic = self.GradeCountDic[carduid]
        if tDic[grade] == nil then
            tDic[grade] = 0
        end
        tDic[grade] = count

        if self.GradeTopCountDic[grade] == nil then
            self.GradeTopCountDic[grade] = {
                num = 0,
                uid = 0
            }
        end
        local lc = self.GradeTopCountDic[grade].num
        local rc = tDic[grade]
        if lc < rc then
            self.GradeTopCountDic[grade].num = rc
            self.GradeTopCountDic[grade].uid = carduid
            self:BroadcastGradeCount(grade)
        else
            if self.GradeTopCountDic[grade].uid == carduid then
                self:ReGradeTopCountDic(grade)
            end
        end
    end
end

--- 广播 穿戴指定品质装备X件 类型59
function EquipmentModel:BroadcastGradeCount(Grade)
    if self.GradeTopCountDic ~= nil then
        if Grade ~= nil then
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {_G.ActiveTaskEnum.ConditionEnum.Equipment.assignGradeCount, Grade},
                self.GradeTopCountDic[Grade].num,
                false,
                true
            )
        else
            for Grade, arr in pairs(self.GradeTopCountDic) do
                _G.Events:GetInstance():Broadcast(
                    _G.ePlayAactionEvent.PlayAaction,
                    {_G.ActiveTaskEnum.ConditionEnum.Equipment.assignGradeCount, Grade},
                    arr.num,
                    false,
                    true
                )
            end
        end
    end
end

