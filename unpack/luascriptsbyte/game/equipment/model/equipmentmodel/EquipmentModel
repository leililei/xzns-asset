function EquipmentModel:UnfixEquipAllReturnfun(cardUids, call)
    local function func()
        for key, id in pairs(cardUids) do
            local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, id)
            if carddata ~= nil then
                for _, v in pairs(carddata.EquipBar) do
                    if not table.isEmptyOrNil(v) then
                        self:DressEquip(id, {v})
                    end
                end
            end
        end
    end

    local msg = {}
    msg.uids = cardUids
    require("EquipmentNet"):GetInstance():UnfixAllEquip(
        msg,
        function(data)
            if data.ack ~= 1 then
                func = nil
            else
                local templist1 = _G.StorageManager:GetInstance():GetEquipListByParam(1, 2)
                for _, cardUid in pairs(cardUids) do
                    local cardData = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card)[cardUid]
                    if cardData ~= nil then
                        for key, mEquipBar in pairs(cardData.EquipBar) do
                            if not table.isEmptyOrNil(mEquipBar) then
                                mEquipBar:PutEquip(0)
                                _G.StorageManager:GetInstance():AddItemByEquipment(mEquipBar)
                                --mEquipBar = {}
                                cardData.EquipBar[key] = {}
                            end
                        end
                        cardData:CalcNowSumProp(_G.AttrType.Equip)
                    end
                end
                _G.Events:GetInstance():Broadcast(_G.GlobalEvents.PlayerPowerChange)
