---查看洗练材料是否够
function EquipmentModel:CheckResetMaterial(Equip, type, index)
    local sid
    if type == _G.AdditionType.Fixed then
        sid = Equip.cfg.addition_fixed
    elseif type == _G.AdditionType.Random then
        sid = Equip.cfg.addition
    end
    if sid == nil then
        return false
    end

    local cfg = _G.ConfigManager.equipment_add_cfg[sid]
    local bl = true
    local material = 0
    for _, v in pairs(cfg.materials) do
        bl = _G.StorageManager:GetInstance():CheckItem(v[1], v[2])
        if bl == false then
            material = v[1]
            break
        end
    end
    return bl, cfg.materials, material
end

---返回随机属性评分
function EquipmentModel:GetAdditionsScore(additions)
    local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg
    local score = 0
    local sid, num, equipment_add_att_cfgItem, atts, attlen
    for i, value in pairs(additions) do
        ---- 当前属性格式   or   洗炼出的属性格式
        sid = value.k or value.sid
        num = value.v or value.value
        ---属性评分 = 配置值 直接 *  基数
        score = score + num * equipment_add_att_cfg[sid].score_base
    end
    return score
end
