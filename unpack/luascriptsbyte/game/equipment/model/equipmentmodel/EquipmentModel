---装备推荐,获取有提升的角色列表
---@param grade number 品质
---@param element number 五行
---@param profession number 职业
---@param part number 部位
---@param cards CardData[] 共鸣神石卡牌
function EquipmentModel:GetCommendCards(grade, element, profession, part, cards)
    if cards == nil then
        cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
    end
    local commendLis = {}
    local isEmptyOrNil = _G.table.isEmptyOrNil
    local insert = _G.table.insert
    ---@type EquipmentItem
    local equip
    for i, v in pairs(cards) do
        if profession == v.cfg.EquipmentType then
            equip = v.EquipBar[part]
            if isEmptyOrNil(equip) then
                insert(commendLis, v)
            elseif grade == equip.Grade then
                if element == v:GetElement() and equip.element ~= v:GetElement() then
                    insert(commendLis, v)
                end
            elseif grade > equip.Grade then
                if element == v:GetElement() or equip.element ~= v:GetElement() then
                    insert(commendLis, v)
                end
            end
        end
    end
    return commendLis
end

