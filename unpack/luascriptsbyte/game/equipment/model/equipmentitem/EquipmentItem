---获取随机属性评分 装备计算战斗力 用
---@return number[]
function EquipmentItem:GetAdditionScore()
    local scoreArr = {}

    local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg
    ---@type equipment_add_att_cfg
    local equipment_add_att_cfgItem

    local num, sid, score
    for _, value in pairs(self.addition) do
        sid = value.k
        equipment_add_att_cfgItem = equipment_add_att_cfg[sid]
        num = value.v
        score = num * equipment_add_att_cfgItem.score_base
        table.insert(scoreArr, score)
    end
    return scoreArr
end

function EquipmentItem:SetAddition(addition)
    self.addition = addition or {}

    if self.addition[1] then
        if self.addition[1].index == nil then
            for i = 1, #self.addition do
                self.addition[i].index = i
            end
        end

        ----与服务器 index相同 方便锁定判定
        _G.SortList(
            self.addition,
            function(a)
                return -a.index
            end
        )
    end

    ---随机属性值 {{sid,num},,,}   不用sid=num防止同sid属性
    self.additionValue = {}
    self.addition_fixed = {}
    if addition ~= nil then
        local sid, num
        for index, value in pairs(self.addition) do
            sid = value.k
            num = value.v

            table.insert(self.additionValue, { sid, num * 0.0001 })
        end
    end

    --- 随机属性 加成到卡牌上
    if self.addProp == nil then
        self.addProp = _G.AttributeClassManager:GetInstance():GetAttribtueClass(0, _G.PowerType.equipment)
    else
        self.addProp:OnInit(0, _G.PowerType.equipment)
    end
    if #self.additionValue > 0 then
        local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg
        local equipment_add_att_cfgItem, tAttCountType
        for _, info in pairs(self.additionValue) do
            local sid = info[1]
            local num = info[2]
            equipment_add_att_cfgItem = equipment_add_att_cfg[sid]
            if equipment_add_att_cfgItem ~= nil then
                if equipment_add_att_cfgItem.value_type == 2 then
                    tAttCountType = _G.AttCountType.basePercent
                elseif equipment_add_att_cfgItem.value_type == 1 then
                    tAttCountType = _G.AttCountType.other
                end
                self.addProp:SetValueByName(equipment_add_att_cfgItem.type_attribute, num, false, tAttCountType)
            end
        end
    end
    self:ChangeRedPoint()
end

--- 复刻装备数据
------@param equip EquipmentItem
function EquipmentItem.GetMsg(equip)
    --- 有培养属性的不会可堆叠 不用Copy
    ---@type EquipmentItem_ServerMsg
    local data = {}
    data.element = equip.element
    data.exp = equip.strengExp
    data.num = 1
    data.sid = equip.sid
    data.uid = equip.uid
    data.streng = equip.streng
    data.addition = equip.addition
    data.bound = equip.bound
    return data
end

---根据装备数据 复刻装备 堆叠装备穿戴脱下
------@param equip EquipmentItem
function EquipmentItem.Copy(equip)
    --- 有培养属性的不会可堆叠 不用Copy
    local data = EquipmentItem.GetMsg(equip)
    local equ = require("EquipmentItem").New()
    equ:Parse(data)
    return equ
end

