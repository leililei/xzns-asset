-----计算战力
---@param ac AttributeClass 装备item
---@return number 战力
function EquipmentItem:CalculateEquipmentPower()
    local ac = self:GetAllAttr(true)

    local scoreArr = self:GetAdditionScore()

    return ac:CalculateEquipmentPower(scoreArr)
end

