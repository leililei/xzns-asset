----数据修改后 调用
function EquipmentItem:Updata(notRefreshRedPoint)
    self:GetPower(true)
    if not notRefreshRedPoint then
        self:ChangeRedPoint()
    end
    self.tempPowers = {}
end

function EquipmentItem:ChangeRedPoint()
    if self.Init ~= true or self.cardUid == 0 or self.isTemp then
        return
    end
    local part_uid = self.cardUid * 10 + self.cfg.parts
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RoleEquipment.id, part_uid)
end

---获取同五行战力
---@param element number 卡牌五行
function EquipmentItem:GetTempElementPower(element)
    local power = self:GetPower()
    if require("CardInfoManager"):GetInstance():CheckMultiMatchCOP(element , self.element) and not self.IscardElement then
        if not self.tempPowers.element then
            local tb = {}
            tb.IscardElement = self.IscardElement
            tb.power = self:GetPower()
            self.IscardElement = true
            self:SetUPProp()
            self.tempPowers.element = self:GetPower(true)
            self.IscardElement = tb.IscardElement
            self:SetUPProp()
            self.power = tb.power
            self.IscardElement = tb.IscardElement
        end
        power = self.tempPowers.element
    end
    return power
end

---获取分解后的经验
function EquipmentItem:GetDecompositionExp()
    ---@type equipment_stren_cfg
    local cfg = self:GetEquipCurStrengCfg()
    return self.cfg.decomposition, cfg and cfg.points_up + self.strengExp or 0
end

function EquipmentItem:GetGrade()
    return self.cfg.grade
end

return EquipmentItem
