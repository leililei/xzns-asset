--- 设定sid 装备配置
function EquipmentItem:UpGradeSid(sid)
    if sid == nil or sid == 0 then
        return
    end
    self.sid = sid
    ---@type equipment_cfg
    self.cfg = _G.ConfigManager.equipment_cfg[sid]
    self.Icon = self.cfg.icon
    self.Grade = self.cfg.grade

    self.prop = _G.AttributeClassManager:GetInstance():GetAttribtueClass(0, _G.PowerType.equipment)
    self.UPProp = _G.AttributeClassManager:GetInstance():GetAttribtueClass(0, _G.PowerType.equipment)
    self.BoundProp = _G.AttributeClassManager:GetInstance():GetAttribtueClass(0, _G.PowerType.equipment)
    ---todo 角色专属属性加成
    self:SetBoundProp()
    self:SetProp()
    self:SetUPProp()
    self:Updata()
end

