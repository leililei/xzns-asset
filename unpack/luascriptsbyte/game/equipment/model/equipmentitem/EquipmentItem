-----装备强化
------@param exp number 当前总累计经验
function EquipmentItem:Strength(exp)
    if exp == 0 then
        self:SetUPProp()
        self:Updata()
        return
    end

    local cfg = self:GetEquipNextStrengCfg()
    if cfg ~= nil then
        if exp > cfg.points_up then
            self.streng = self.streng + 1
            self:Strength(exp, cfg.points_up)
        elseif exp == cfg.points_up then
            self.streng = self.streng + 1
            self.strengExp = exp - cfg.points_up
            self:Strength(0)
        else
            cfg = self:GetEquipCurStrengCfg()
            if cfg ~= nil then
                exp = exp - cfg.points_up
            end
            self.strengExp = exp
            exp = 0
            self:Strength(exp)
        end
    else
        ---经验超出
        self.strengExp = 0
        self:Strength(0)
    end

    return 0
end

