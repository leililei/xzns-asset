-----穿戴装备
---@param uid number 卡牌uid
---@param element table 多种族
---@param isTemp boolean 是否为临时装备
function EquipmentItem:PutEquip(uid, element, isTemp, notRefreshRedPoint)
    if uid == 0 then
        self:UnEquip()
        return
    end
    if not isTemp then
        require("EquipmentModel"):GetInstance():AddPartsList(self, uid)
    end
    self.isTemp = isTemp
    self.cardUid = uid
    self.IscardElement = require("CardInfoManager"):GetInstance():CheckMultiMatchCOP(element, self.element)

    ---同五行 刷新数据
    self:SetUPProp()
    ---卡牌绑定专属加成
    self:SetBoundProp()
    self:Updata(notRefreshRedPoint)
end

---十阶以上绑定卡牌
function EquipmentItem:BoundCardId(sid)
    if self.bound == 0 then
        self.bound = sid
    end
    self.element = 0
    self.streng = 0
    self.IscardElement = false
end

-----卸下装备
function EquipmentItem:UnEquip()
    if self.cardUid ~= 0 then
        require("EquipmentModel"):GetInstance():SubPartsList(self, self.cardUid)
    end

    self.cardUid = 0

    self.IscardElement = false
end

