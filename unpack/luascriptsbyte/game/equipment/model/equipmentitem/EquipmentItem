---检测当前装备角色是否和绑定卡牌同sid false则不提供专属加成
function EquipmentItem:CheckEquipmentBoundSidIsCurCardSid()
    local sid = self:GetCardSid()
    if sid == 0 then
        return false
    end
    if self.bound == 0 then
        return false
    end
    return sid == self.bound
end

---设置专属角色的属性加成
function EquipmentItem:SetBoundProp()
    if self.cfg == nil then
        return
    end
    if self:CheckEquipmentBoundSidIsCurCardSid() then
        --("神阶专属加成")
        local attributeBind = self:GetCurAttributeBind()
        if not _G.table.isEmptyOrNil(attributeBind) then
            for i = 1, #attributeBind do
                self.BoundProp:AddValueByName(
                    attributeBind[i][1],
                    _G.AttributeClassManager:GetInstance():GetValueWithName(
                        attributeBind[i][1],
                        attributeBind[i][3],
                        _G.tonumber(attributeBind[i][2])
                    ),
                    nil,
                    _G.tonumber(attributeBind[i][2])
                )
            end
        end
    end
end

function EquipmentItem:SetProp()
    if self.cfg == nil then
        return
    end
    local num
    for i, v in pairs(self.showAttrType) do
        num = self.cfg[v.key]
        if num ~= nil and num > 0 then
            if v.proptype == 1 then
                self.prop:SetValueByName(v.key, num)
            else
                self.prop:SetValueByName(v.key, num * 0.0001)
            end
        end
    end
end

function EquipmentItem:SetUPProp()
    local att_growth = 0
    local cfg = self:GetEquipCurStrengCfg()
    if cfg ~= nil then
        att_growth = cfg.att_growth
    end
    ---没有强化等级也要算强化  可能有同五行
    self.UPProp = self:GetUPProp(att_growth)
end

---获取  临时计算出的 指定强化等级的属性
function EquipmentItem:GetTempUPProp(streng)
    local cfg = self:GetEquipNextStrengCfg(streng)
    if cfg ~= nil then
        local tUpProp = self:GetUPProp(cfg.att_growth)
        return _G.AttributeClassManager:GetInstance():AddAttributeByNew(self.prop, tUpProp)
    end
    return nil
end

---获取  指定强化等级 增加的属性
function EquipmentItem:GetUPProp(att_growth)
    ---先设定空属性
    local tUpProp = _G.AttributeClassManager:GetInstance():GetAttribtueClass(0, _G.PowerType.equipment)
    local growth = att_growth * 0.0001
    local teleGrowth = 0
    ---true算上同五行加成 (必须一起算 好四舍五入 否则分开算强化0.2 五形0.3会被舍去)
    -- 镇魂街ZHJ-34446 Beta_1.0.0公测BuglistZHJ-36566
    -- 【装备】装备4阶突破界面属性展示错误      装备4阶的五行加成已经算进基础属性数值
    if self.IscardElement and self.Grade ~= 11 then
        --- 同五行加成
        teleGrowth = eleGrowth
    end
    local sumGrowth = teleGrowth + growth
    if sumGrowth > 0 then
        ---拷贝基础属性 乘系数
        tUpProp = self.prop:Clone()
        tUpProp:AddBaseMultiply((sumGrowth))
        local num
        for _, v in pairs(self.showAttrType) do
            num = tUpProp:GetValueByName(v.key)

            if num ~= nil and num > 0 then
                if _G.AttrType[v.key].percentage == 0 then
                    ---数值类型四舍五入
                    num = Mathf.RoundToInt(num)
                end
                tUpProp:SetValueByName(v.key, num)
            end
        end
    end
    return tUpProp
end

