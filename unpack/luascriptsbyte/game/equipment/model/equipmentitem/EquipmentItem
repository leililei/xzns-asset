---获取词缀的评级
function EquipmentItem:GetRandomAttrGrade(sid, v)
    local Affix_Cfg = _G.ConfigManager.equipment_add_att_cfg
    local cfg = Affix_Cfg[sid]
    if cfg.value_type == _G.AdditionValueType.Fixed then
        for n = 1, #cfg.value do
            if cfg.value[n] == v then
                return n
            end
        end
    elseif cfg.value_type == _G.AdditionValueType.Section then
        for n = 1, #cfg.value - 1 do
            if cfg.value[n] <= v and cfg.value[n + 1] > v then
                return n
            end
        end
    end
end

-----通过类型和下标获取随机属性
function EquipmentItem:GetAddition(type, index)
    local data
    if type == _G.AdditionType.Fixed then
        data = _G.DeepCopy(self.addition_fixed[index])
    else
        data = _G.DeepCopy(self.addition[index])
    end
    return data
end

