---是否强化到最大等级
function EquipmentItem:IsMAxStreng()
    local maxlv = self.cfg.strengthen_level
    return self.streng >= maxlv
end

---获取下一个装备强化等级的配置表  或指定强化等级
function EquipmentItem:GetEquipNextStrengCfg(streng)
    if streng == nil then
        streng = self.streng + 1
    end
    local maxlv = self.cfg.strengthen_level
    ---如果 当前强化等级 已达到上限
    if maxlv == 0 or streng > maxlv then
        return nil
    end

    return _G.ConfigManager.equipment_stren_cfg[self:GetStrengSid(streng)]
end

---获取当前装备强化等级的配置表
function EquipmentItem:GetEquipCurStrengCfg()
    return self.streng > 0 and _G.ConfigManager.equipment_stren_cfg[self:GetStrengSid()] or nil
end

