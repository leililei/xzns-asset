-----初始化装备数据
---@param data EquipmentItem_ServerMsg
function EquipmentItem:ParseInitMsg(data)
    self.sid = data.sid
    self.uid = data.uid
    self.streng = data.streng and data.streng or 0
    ---待替换洗练属性
    self.reset = data.reset or nil
    ---堆叠数量
    self.count = (data.num or data.count) or 0
    ---强化经验 不累计
    self.strengExp = data.exp or 0
    self.element = data.element or 0
    if _G.AppSetting.IsXzns then --星座没有种族加成，策划要求防止配置出错强制显示没有种族
        self.element = 0
    end
    --随机属性  [{k=id,v=num}]
    self.addition = {}
    ---设定随机属性
    self:SetAddition(data.addition)
    self.cardUid = 0
    ---true同五行
    self.IscardElement = false
    ---根据sid 设定cfg及相关数据
    self:UpGradeSid(self.sid)
    ---突破四阶后绑定的卡牌sid
    self.bound = data.bound or 0
    self.Init = true
end

function EquipmentItem:ParseExtend(extend)
    self.element = extend[1] or self.element
    if _G.AppSetting.IsXzns then --星座没有种族加成，策划要求防止配置出错强制显示没有种族
        self.element = 0
    end
end

---重连自动选择 分数最高的随机属性
---@param data EquipmentItem_ServerMsg
function EquipmentItem:SelectReset(data)
    if data.reset == nil then
        return
    end
    local EquipmentModel = require("EquipmentModel"):GetInstance()

    ---属性拼接 锁的+本次随的
    local additionArr = {}
    for i, value in pairs(self.addition) do
        table.insert(additionArr, value)
    end

    local NewAdditionArr = {}
    for i = 1, #data.reset do
        local attArr = {}
        table.insertto(attArr, additionArr)
        for _, value in pairs(data.reset[i].addition) do
            local att = {}
            local index = value.index
            att.k = value.sid
            att.v = value.value
            if attArr[index] ~= nil then
                attArr[index] = att
            else
                table.insert(attArr, att)
            end
        end
        table.insert(NewAdditionArr, attArr)
    end

    local nowScore = EquipmentModel:GetAdditionsScore(self.addition)
    local index = 0
    local NewAddition, score
    for tIndex, addition in pairs(NewAdditionArr) do
        score = EquipmentModel:GetAdditionsScore(addition)
        if nowScore < score then
            nowScore = score
            index = tIndex
            NewAddition = addition
        end
    end
    require("EquipmentModel"):GetInstance():EquipmentChoose(self, index, NewAddition)
end

---获取装备卡牌sid
function EquipmentItem:GetCardSid()
    if self.cardUid ~= 0 then
        local cd = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.cardUid)
        if cd then
            return cd.sid
        else
            return 0
        end
    else
        return 0
    end
end

