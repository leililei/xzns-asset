function EquipmentView_purify:OnClick_suo(go_table)
    if self.clickSuo then
        return
    end
    local sid = go_table.Params_sid
    local isSuo = go_table.Params_isSuo
    self:SetSuo(go_table, not isSuo)
    self:SetRes()
end

function EquipmentView_purify:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_one then
        if _G.StorageManager:GetInstance():CheckItemNew(self.MaterialSid, self.MaterialNum) == false then
            return
        end
        self:EquipmentReset(1)
    elseif go == self.go_table.aorbtn_all then
        self:EquipmentReset(2)
    elseif go == self.go_table.aorbtn_tishi then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 25)
    end
end

---@param type number _1单次  2批量
function EquipmentView_purify:EquipmentReset(type)
    local lock_index = {}

    ---false全锁了  全锁不能洗炼
    local isUnlock = false

    ---属性拼接 锁的+本次随的
    local additionArr = {}
    local sid

    local slefAddition = _G.DeepCopy(self.CurItemData.addition)
    for i, value in pairs(slefAddition) do
        sid = value.k
        if self.Params_suo[i] == true then
            ---lock显示锁
            value.lock = true
            table.insert(additionArr, value)
            table.insert(lock_index, value.index)
        else
            value.lock = false
        end
    end
    ---锁定显示在前
    _G.SortList(
        slefAddition,
        function(v)
            return v.lock == true and 1 or 0
        end
    )

    ---如果 当前装备最大属性条数全锁了 不能洗炼
    if #lock_index >= self.CurItemData.cfg.num_addition then
        ---全锁 不能洗炼
        _G.PopWindowManager:GetInstance():ShowAllTips(120117)
        return
    end

    local resNum = self.MaterialNum * (type == 2 and 5 or 1)
    if _G.StorageManager:GetInstance():CheckItemNew(self.MaterialSid, resNum) == false then
        return
    end

    require("EquipmentModel"):GetInstance():EquipmentReset(
        self.CurItemData,
        lock_index,
        type,
        function(msg)
            _G.StorageManager:GetInstance():ConsumeItem(self.MaterialSid, 0, resNum)

            local NewAdditionArr = {}
            for i = 1, #msg.reset do
                local attArr = {}
                table.insertto(attArr, additionArr)
                for _, value in pairs(msg.reset[i].addition) do
                    local att = {}
                    att.index = value.index
                    att.k = value.sid
                    att.v = value.value
                    table.insert(attArr, att)
                end
                table.insert(NewAdditionArr, attArr)
            end

            self.lua_purifySelect:Show(true, type, slefAddition, NewAdditionArr, self.MaterialArr, self.Params_suo)
        end
    )
end

