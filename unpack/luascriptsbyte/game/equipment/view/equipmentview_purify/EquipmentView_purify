---类的构造函数
function EquipmentView_purify:__init(obj, mParentView)
    self.UiDic = {
        pf = _G.LangUtil.GetLangPackValue(90020400059) .. ": <color=#f68940>%d</color>",
        suo = {
            --锁上
            t = "ui_zb_icon_suo_02",
            f = "ui_zb_icon_suo_01"
        },
        shuaxin = _G.ConfigManager.ui_effect_cfg.ef_EquipmentView_shuaxin
    }

    self.gameObject = obj
    ---@type EquipmentView
    self.mParentView = mParentView
    ---当前选中装备
    self.CurItemData = self.mParentView.CurItemData
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    ---洗炼选择
    self.lua_purifySelect = require("EquipmentView_purifySelect").New(self.go_table.obj_purifySelect, self)
    self.lua_purifySelect:Hide()
end

function EquipmentView_purify:Show(isShow, isShowEff)
    self.isShow = isShow
    self.CurItemData = self.mParentView.CurItemData
    self.gameObject:SetActiveE(1)
    if isShow == false then
        for _, v in pairs(self.propItemDic) do
            local go_table = _G.GetAutoGoTable(v)
            go_table.obj_eff:SetActiveE(0)
        end
        self:Hide()
        return
    end
    --消耗材料  0锁-Arr[1] 1锁-Arr[2]    [[sid,num]]
    self.MaterialArr = {}
    self.MaterialSid = 0
    self.MaterialNum = 0
    ---属性库
    ---@type equipment_add_cfg
    local equipment_add_cfgItem = _G.ConfigManager.equipment_add_cfg[self.CurItemData.cfg.addition]
    if equipment_add_cfgItem ~= nil then
        self.MaterialArr = equipment_add_cfgItem.materials
    end

    if self.go_table.ResConsume1 == nil then
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        data.textColorType=4
        local sid = self.MaterialArr[1][1]
        local num = self.MaterialArr[1][2]
        self.MaterialSid = sid
        self.MaterialNum = num
        self.go_table.ResConsume1 =
            self:AddComponent(
            self.go_table.obj_consume1,
            require("ConsumeCompont").New(self.go_table.obj_consume1, {{sid, false, num}}, nil, nil, true, data)
        )
    end
    if self.go_table.ResConsume2 == nil then
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        data.textColorType=4
        self.go_table.ResConsume2 =
            self:AddComponent(
            self.go_table.obj_consume2,
            require("ConsumeCompont").New(
                self.go_table.obj_consume2,
                {{self.MaterialSid, false, self.MaterialNum * 5}},
                nil,
                nil,
                true,
                data
            )
        )
    end
    self:ShowInfo()
    self:ShowProp(isShowEff)
end
function EquipmentView_purify:Hide()
    self.gameObject:SetActiveE(0)
    if self.ShuaXinEff then
        _G.DestroyObject(self.ShuaXinEff)
        self.ShuaXinEff = nil
    end
end

function EquipmentView_purify:ShowInfo()

    self.go_table.aortext_Name.text = self.CurItemData:GetName()
    self.go_table.obj_ItemRoot:ClearChildren()
    _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_ItemRoot,
            function(item)
                self.CurItem = item
                self.CurItem:ShowData(self.CurItemData)
            end
    )
    local showAttr = {
        _G.AttrType.atk.key,
        _G.AttrType.bre.key,
        _G.AttrType.def.key,
        _G.AttrType.max_hp.key,
        _G.AttrType.hit_rate.key,
        _G.AttrType.avd_rate.key,
        _G.AttrType.cri_rate.key,
        _G.AttrType.cri_r_rate.key
    }
    self.AttrList = {}
    for _, v in pairs(showAttr) do
        local num = self.CurItemData:GetAllAttr():GetValueByName(v)
        if num ~= 0 then
            table.insert(self.AttrList, {key = v, value = num})
        end
    end
    table.sort(
            self.AttrList,
            function(a, b)
                return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
            end
    )
    self.go_table.scrollloopvectical_AttrList:InitItemData(#self.AttrList, _G.handler(self, self.RefreshAttr))
end

function EquipmentView_purify:SetRes()
    local num = 0
    if self.Params_suo ~= nil then
        for key, value in pairs(self.Params_suo) do
            if value == true then
                num = num + 1
            end
        end
    end

    if num < #self.MaterialArr then
        --- +1 (锁0条 就用第一组消耗配置 , 锁1条 就用第二组消耗配置)
        local key = num + 1
        local res = {}
        local sid = self.MaterialArr[key][1]
        local num = self.MaterialArr[key][2]

        self.MaterialSid = sid
        self.MaterialNum = num
        self.go_table.ResConsume1:RestRs({{sid, false, num}})
        self.go_table.ResConsume2:RestRs({{sid, false, num * 5}})
    end
end

function EquipmentView_purify:ShowProp(isShowEff)
    local additions = self.CurItemData.addition

    if self.propItemDic == nil then
        self.propItemDic = {}
    end

    ---词缀锁定 [index]=true
    self.Params_suo = {}

    local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg

    ---@type equipment_add_att_cfg
    local equipment_add_att_cfgItem
    local len = #additions

    ---总评分
    local score = 0

    local obj, atts, attlen, baseValue, area, tAttrType, sid, num

    for i, value in pairs(additions) do
        sid = value.k
        equipment_add_att_cfgItem = equipment_add_att_cfg[sid]
        atts = equipment_add_att_cfgItem.value
        attlen = #atts

        ---生成属性条
        if self.propItemDic[i] == nil then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.obj_prop)
            table.insert(self.propItemDic, obj)
        else
            obj = self.propItemDic[i]
        end
        ---区间
        area =
            string.format(
            "[%s%%-%s%%]",
            _G.GameUtil.FormatNum(atts[1] * 0.01),
            _G.GameUtil.FormatNum(atts[attlen] * 0.01)
        )
        ---值
        num = self.CurItemData.additionValue[i][2]
        num = num * 100
        --保留一位小数
        num = string.format("%.1f", tostring(num))
        num = tonumber(num)
        num = num .. "%"

        ---属性评分 = 配置值 直接 *  基数
        score = score + value.v * equipment_add_att_cfgItem.score_base
        local color = require("EquipmentModel"):GetInstance():GetAddAttColor(sid, value.v, 2)
        self:SetProp(obj, sid, _G.LangUtil.GetLangPackValue(equipment_add_att_cfgItem.name), area, num, color, i, isShowEff)
        obj:SetActiveE(1)
    end
    self.go_table.aortext_PingFen.text = string.format(self.UiDic.pf, score)
    --self.go_table.obj_score:SetParentE(self.go_table.obj_prop)

    len = len + 1
    for i = len, #self.propItemDic do
        self.propItemDic[i]:SetActiveE(0)
    end

    self:SetRes()
end

function EquipmentView_purify:SetProp(obj, sid, name, area, num, color, index, isShowEff)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.Params_sid = sid
    go_table.Params_index = index
    go_table.aorimage_di:SetActiveE(index % 2 == 0 and 0 or 1)
    go_table.aortext_strenName.text = string.format("<color=#%s>%s</color>", color, tostring(name))
    go_table.aortext_strenNum.text = string.format("<color=#%s>%s</color>", color, tostring(num))

    go_table.aortext_newNum.text = string.format("<color=#%s>%s</color>", color, tostring(area))
    if go_table.OnClick == nil then
        go_table.aorbtn_suo.onClick:AddListener(_G.handlerbind(self, self.OnClick_suo, go_table))
        go_table.OnClick = true
    end
    if _G.PlayerPrefsManager.GetInt(self.CurItemData.uid .. "equip" .. index, 0) == 0 then 
        self:SetSuo(go_table, false)
    else 
        self:SetSuo(go_table, true)
    end
    if isShowEff then
        go_table.obj_eff:SetActiveE(0)
        go_table.obj_eff:SetActiveE(1)
    end
end

function EquipmentView_purify:SetSuo(go_table, isSuo)
    go_table.Params_isSuo = isSuo
    self.Params_suo[go_table.Params_index] = isSuo
    if isSuo then
        self:XiLianEffectRefresh(go_table)
        go_table.aorimage_suo.SpriteName = self.UiDic.suo.t
    else
        go_table.aorimage_suo.SpriteName = self.UiDic.suo.f
    end
    _G.PlayerPrefsManager.SetInt(self.CurItemData.uid .. "equip" .. go_table.Params_index, isSuo and 1 or 0)
end

function EquipmentView_purify:RefreshAttr(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local attr = self.AttrList[index]
    local num = attr.value
    if _G.AttrType[attr.key].proptype == 2 then
        num = num * 100
        num = num .. "%"
    end
    tb.aortext_AttrName.text = _G.AttrType[attr.key].des
    tb.aortext_AttrNum.text = num
end

