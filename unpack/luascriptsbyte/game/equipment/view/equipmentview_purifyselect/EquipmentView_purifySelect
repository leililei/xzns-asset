---@param type number 1洗练 2放弃 3替换
function EquipmentView_purifySelect:CheckTipsId(type)
    local scoreLowTips = 120307
    local scoreHigherTips = 120303
    local continueXilian = 120306
    local fqxilian = 120310
    local notHighestTips = 120308
    local curIsOnScore = self.scoreIndexDic[self.isOnIndex]
    local maxScore = 0
    if _G.table.isEmptyOrNil(self.scoreIndexDic) then
        return
    end
    for i = 1, #self.scoreIndexDic do
        if self.scoreIndexDic[i] > maxScore then
            maxScore = self.scoreIndexDic[i]
        end
    end
    if type == 3 then
        if self.nowScore > curIsOnScore then
            return scoreLowTips
        elseif self.nowScore < curIsOnScore then
            if maxScore > curIsOnScore then
                return notHighestTips
            end
        end
    elseif type == 2 then
        if self.nowScore < curIsOnScore then
            return scoreHigherTips
        else
            if maxScore > self.nowScore then
                return fqxilian
            end
        end
    else
        if maxScore > self.nowScore then
            return continueXilian
        end
    end
end
