function EquipmentView_purifySelect:OnClick_Th(index, addition)
    local tipsId = self:CheckTipsId(3)
    if tipsId then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            tipsId,
            nil,
            function()
                self:CheckChoose(
                    index,
                    addition,
                    function()
                        self:Hide()
                        self.mParentView:Show(true)
                    end
                )
            end
        )
    else
        self:CheckChoose(
            index,
            addition,
            function()
                self:Hide()
                self.mParentView:Show(true)
            end
        )
    end
end
--- 继续批量洗炼
function EquipmentView_purifySelect:OnClick_Xl()
    local resNum = self.MaterialNum * (self.type == 2 and 5 or 1)
    if _G.StorageManager:GetInstance():CheckItem(self.MaterialSid, resNum) == false then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.MaterialSid)
        return
    end
    self:CheckXl(
        0,
        nil,
        function()
            self.mParentView:EquipmentReset(self.type)
        end
    )
end

