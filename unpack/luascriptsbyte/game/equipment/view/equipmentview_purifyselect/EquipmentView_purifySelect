function EquipmentView_purifySelect:SetInfo(goTableDic, Index, obj, addition)
    if goTableDic[Index] == nil then
        goTableDic[Index] = _G.GetAutoGoTable(obj)
    end
    local go_table = goTableDic[Index]
    local go_table_prop = _G.GetAutoGoTable(go_table.obj_propList)
    self:ShowProp(go_table_prop, addition, Index)
end

function EquipmentView_purifySelect:ShowProp(go_table, addition, Index)
    go_table.gameObject:SetActiveE(0)
    go_table.gameObject:SetActiveE(1)
    local additions = addition
    local animCtl
    if go_table.propItemDic == nil then
        go_table.propItemDic = {}
    end

    local equipment_add_att_cfg = _G.ConfigManager.equipment_add_att_cfg

    ---@type equipment_add_att_cfg
    local equipment_add_att_cfgItem
    local len = #additions

    ---总评分
    local score = 0
    local obj, atts, attlen, baseValue, area, tAttrType, sid, num, lock
    for i, value in pairs(additions) do
        sid = value.k
        num = value.v
        lock = value.lock
        equipment_add_att_cfgItem = equipment_add_att_cfg[sid]
        atts = equipment_add_att_cfgItem.value
        attlen = #atts

        ---生成属性条
        if go_table.propItemDic[i] == nil then
            local objitem
            if self.isDuo == true then
                objitem = self.go_table.obj_propDuoItem
            else
                objitem = self.go_table.obj_propDanItem
            end
            if Index > 0 then
                animCtl = objitem:GetComponentE(typeof(CS.UnityEngine.Animator))
                animCtl.enabled = true
            end
            obj = _G.InstantiateObject(objitem, go_table.obj_prop)
            table.insert(go_table.propItemDic, obj)
        else
            obj = go_table.propItemDic[i]
        end
        if Index > 0 then
            animCtl = obj:GetComponentE(typeof(CS.UnityEngine.Animator))
            animCtl.enabled = false
            animCtl.enabled = true
        end
        ---区间
        area = string.format(
            "[%s%%-%s%%]",
            _G.GameUtil.FormatNum(atts[1] * 0.01),
            _G.GameUtil.FormatNum(atts[attlen] * 0.01)
        )

        ---值,保留一位小数s
        baseValue = num
        baseValue = baseValue * 0.01
        baseValue = string.format("%.1f", tostring(baseValue))
        baseValue = tonumber(baseValue)
        baseValue = baseValue .. "%"

        ---属性评分 = 配置值 直接 *  基数
        score = score + num * equipment_add_att_cfgItem.score_base
        local color = require("EquipmentModel"):GetInstance():GetAddAttColor(sid, num, 2)
        self:SetProp(obj, sid, GetLangPackValue(equipment_add_att_cfgItem.name), area, baseValue, color, lock, i)

        obj:SetActiveE(1)
    end

    self.scoreIndexDic[Index] = score
    -- if self.scoreMax < score then
    --     self.scoreMax = score
    --     self.scoreMaxIndexDic = {}
    --     self.scoreMaxIndexDic[Index] = true
    -- elseif self.scoreMax == score then
    --     self.scoreMaxIndexDic[Index] = true
    -- end

    --region --------------------------------------评分高于 当前显示upIcon--------
    local upeff
    if go_table.aortext_PingFen:GetChildCountE() > 0 then
        upeff = go_table.aortext_PingFen:GetChildE(0)
    end
    if upeff then
        upeff:SetActiveE(0)
    end
    if Index == 0 then
        self.nowScore = score
    else
        if self.nowScore and self.nowScore < score then
            if upeff then
                upeff:SetActiveE(1)
            else
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_UpArrow,
                    go_table.aortext_PingFen,
                    function(tran)
                        tran:SetRectTransformAnchor(1, 0.5, 1, 0.5)
                        tran:SetPivotPosition(0, 0.5)
                        tran:SetRectTransformSize(20, 100)
                    end
                )
            end
        end
    end
    --endregion------------------------------------评分高于 当前显示upIcon--------

    go_table.aortext_PingFen.text = string.format(self.UiDic.pf, tostring(score))
    go_table.obj_score:SetParentE(go_table.obj_propList)

    len = len + 1
    for i = len, #go_table.propItemDic do
        go_table.propItemDic[i]:SetActiveE(0)
    end
end

function EquipmentView_purifySelect:SetProp(obj, sid, name, area, num, color, lock, Index)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aorimage_di:SetActiveE(Index % 2 == 0 and 0 or 1)
    go_table.aortext_Name.text = string.format("<color=#%s>%s</color>", color, tostring(name))
    go_table.aortext_strenNum.text = string.format("<color=#%s>%s</color>", color, tostring(num))
    go_table.aortext_newNum.text = string.format("<color=#%s>%s</color>", color, tostring(area))
    go_table.aorimage_suo:SetActiveE(lock == true and 1 or 0)
end

