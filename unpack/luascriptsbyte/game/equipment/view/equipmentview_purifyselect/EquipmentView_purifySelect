---@protected
function EquipmentView_purifySelect:CheckSpecialAtt()
    local num = self.isDuo == true and 5 or 1
    for i = 1, num do
        local data = self.additionS[i]
        for i, value in pairs(data) do
            local sid = value.k
            local num = value.v
            local equipment_add_att_cfgItem = _G.ConfigManager.equipment_add_att_cfg[sid]
            local index = 2
            local arr = equipment_add_att_cfgItem.value
            for i, value in pairs(arr) do
                if num > value then
                    index = i
                end
            end
            if index == 5 then
                return true
            end
        end
    end
    return false
end

function EquipmentView_purifySelect:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_left then
        if self:CheckSpecialAtt() == true then
            _G.PopWindowManager:ShowAllTips(
                120124,
                nil,
                function()
                    if self.isDuo then
                        self:OnClick_Xl()
                    else
                        self:OnClick_Fq()
                    end
                end
            )
        else
            if self.isDuo then
                self:OnClick_Xl()
            else
                self:OnClick_Fq()
            end
        end
    elseif go == self.go_table.aorbtn_Right then
        ---如果选最开始的 放弃
        if self.isOnIndex == 0 then
            if self:CheckSpecialAtt() == true then
                _G.PopWindowManager:ShowAllTips(
                    120124,
                    nil,
                    function()
                        self:OnClick_Fq()
                    end
                )
            else
                self:OnClick_Fq()
            end
            return
        end
        self:OnClick_Th(self.isOnIndex, self.additionS[self.isOnIndex])
    elseif go == self.go_table.aorbtn_dan0 then
        --self:OnClick_Select(0)
    elseif go == self.go_table.aorbtn_dan1 then
        --self:OnClick_Select(1)
    elseif go == self.go_table.aorbtn_duo0 then
        self:OnClick_Select(0)
    elseif go == self.go_table.aorbtn_duo1 then
        self:OnClick_Select(1)
    elseif go == self.go_table.aorbtn_duo2 then
        self:OnClick_Select(2)
    elseif go == self.go_table.aorbtn_duo3 then
        self:OnClick_Select(3)
    elseif go == self.go_table.aorbtn_duo4 then
        self:OnClick_Select(4)
    elseif go == self.go_table.aorbtn_duo5 then
        self:OnClick_Select(5)
    end
