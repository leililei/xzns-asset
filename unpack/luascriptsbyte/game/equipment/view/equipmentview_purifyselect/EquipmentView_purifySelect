--五次洗练 材料设置
function EquipmentView_purifySelect:Consume()
    if self.type == 1 then
        return
    end
    local num = 0
    if self.Params_suo ~= nil then
        for key, value in pairs(self.Params_suo) do
            if value == true then
                num = num + 1
            end
        end
    end
    if num < #self.MaterialArr then
        --- +1 (锁0条 就用第一组消耗配置 , 锁1条 就用第二组消耗配置)
        local key = num + 1
        local sid = self.MaterialArr[key][1]
        local num = self.MaterialArr[key][2]

        self.MaterialSid = sid
        self.MaterialNum = num
    end
    if self.go_table.ResConsume2 == nil then
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        data.textColorType = 2
        self.go_table.ResConsume2 = self:AddComponent(
            self.go_table.obj_consume2,
            require("ConsumeCompont").New(
                self.go_table.obj_consume2,
                { { self.MaterialSid, false, self.MaterialNum * 5 } },
                nil,
                nil,
                true,
                data
            )
        )
    else
        self.go_table.ResConsume2:RestRs({ { self.MaterialSid, false, self.MaterialNum * 5 } })
    end
end
