        self.CurItemData,
        type,
        self.SelectElement,
        function()
            if isSelect then
                self.go_table.obj_tips:SetActiveE(0)
                if self.mParentView ~= nil then
                    ---选后为空
                    self.SelectElement = nil

                    self.CurItemData_right.element = self.CurItemData.element
                    self.lua_right:ShowData(self.CurItemData_right)

