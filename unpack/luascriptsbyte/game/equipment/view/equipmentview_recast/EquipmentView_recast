---类的构造函数
function EquipmentView_recast:__init(obj, mParentView)
    local tParam = _G.ConfigManager.discrete_cfg[104904][1]
    ---装备重铸材料
    self.MaterialSid = tParam[1]
    self.MaterialNum = tParam[2]

    self.gameObject = obj

    ---@type EquipmentView
    self.mParentView = mParentView
    ---当前选中装备
    self.CurItemData = self.mParentView.CurItemData

    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    self.selectEleArr = {
        self.go_table.aorimage_xuanzhongRL,
        self.go_table.aorimage_xuanzhongSZ,
        self.go_table.aorimage_xuanzhongJL,
        self.go_table.aorimage_xuanzhongWL,
        self.go_table.aorimage_xuanzhongCQ
    }
    ---策划要没随中的变暗
    self.selectMaskEleArr = {
        self.go_table.aorimage_RLmask,
        self.go_table.aorimage_SZmask,
        self.go_table.aorimage_JLmask,
        self.go_table.aorimage_WLmask,
        self.go_table.aorimage_CQmask
    }
    self.selectEleArrLen = #self.selectEleArr
    ---当前亮起属性
    self.index = 0
    ---服务器随的属性
    self.index_sure = 0
end

function EquipmentView_recast:Show(isShow)
    self.isShow = isShow
    self.CurItemData = self.mParentView.CurItemData
    if isShow == false then
        self:Hide()
        return
    end
    self.gameObject:SetActiveE(1)
    self:ShowInfo()
end

function EquipmentView_recast:ShowInfo()
    ---true有待选择五行
    local isSelect = self.SelectElement ~= nil
    self.go_table.obj_select:SetActiveE(isSelect and 1 or 0)
    self.go_table.aorbtn_Done:SetActiveE(isSelect == false and 1 or 0)

    if isSelect then
        self:SetShowElementMask(self.SelectElement)
        self:SetShowElement(self.SelectElement)
    else
        self:SetShowElementMask(self.CurItemData.element)
        self:SetShowElement(self.CurItemData.element or 1)
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        data.textColorType=4
        if self.go_table.ResConsume == nil then
            self.go_table.ResConsume =
                self:AddComponent(
                self.go_table.obj_consume,
                require("ConsumeCompont").New(
                    self.go_table.obj_consume,
                    {{self.MaterialSid, false, self.MaterialNum}},
                    nil,
                    nil,
                    true,
                    data
                )
            )
        end
    end
    ---@type EquipmentItem
    self.CurItemData_right = require("EquipmentItem").Copy(self.CurItemData)

    ---没生成对象
    if self.lua_right == nil then
        ---开始生成对象 并标记
        self.lua_right = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_KeXuanZho,
            function(itemLua)
                self.lua_right = itemLua
                self.lua_right:ShowData(self.CurItemData_right)
            end
        )
    elseif self.lua_right ~= true then
        self.lua_right:ShowData(self.CurItemData_right)
    end
end

function EquipmentView_recast:Hide()
    self.gameObject:SetActiveE(0)
end

function EquipmentView_recast:SetShowElement(element)
    local showEle = element
    if element == 6 then
        showEle = 5
    end
    for i = 1, self.selectEleArrLen do
        self.selectEleArr[i].Alpha = showEle == i and 1 or 0
    end
    self:SetShowElementMask(element)
    self.index = showEle
end

function EquipmentView_recast:SetShowElementMask(element)
    local showEle = element
    if element == 6 then
        showEle = 5
    end
    for i = 1, #self.selectMaskEleArr do
        self.selectMaskEleArr[i]:SetActiveE(i ~= showEle and 1 or 0)
    end
end

function EquipmentView_recast:Move(index_sure, call)
    if self.TimeMove ~= nil then
        self.TimeMove:Stop()
    end

    ---根据服务器随的五行 1-6  与显示最终结果的误差
    if index_sure == 6 then --没有5,所以6（传奇是第5个）
        index_sure = index_sure - 1
    end
    local diff = -self.index + index_sure
    ---一开始全闪次数
    local StarCount = 4
    ---最大切换次数
    local MaxCount = self.selectEleArrLen * 3 + diff
    ---开始减速次数
    local subCount = self.selectEleArrLen * 2 + diff
    local intervalTime = 0.1
    local interval = 0
    local Count = 0

    self.TimeMove =
        _G.TimerManager:GetInstance():GetFixedTimer(
        intervalTime,
        function()
            if Count == MaxCount then
                self.TimeMove:Stop()
                call()
                return
            end

            if Count > subCount and interval < intervalTime * (Count - subCount) then
                interval = interval + intervalTime
                return
            end
            interval = 0
            Count = Count + 1

            self.index = self.index + 1
            if self.index > self.selectEleArrLen then
                self.index = 1
            end
            self:SetShowElement(self.index)
            self.selectEleArr[self.index].Alpha = 1
        end,
        self,
        false,
        false
    )
    self.TimeMove:Start()
end
function EquipmentView_recast:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Done then
        self.go_table.obj_tips:SetActiveE(0)
        if self.CurItemData.element == 0 then
            _G.PopWindowManager:ShowAllTips(120114)
            return
        end
        if _G.StorageManager:GetInstance():CheckItemNew(self.MaterialSid, self.MaterialNum) == false then
            return
        end
        self.mParentView.go_table.aorbtn_switch:SetActiveE(1)
        ---@param data equipment.s2c_reset_element
        require("EquipmentModel"):GetInstance():EquipmentRecast(
            self.CurItemData,
            function(data)
                _G.StorageManager:GetInstance():ConsumeItem(self.MaterialSid, 0, self.MaterialNum)
                ---待选择五行
                self.SelectElement = data.element
                if _G.AppSetting.DEBUG then
                    if data.element == 5 then
                        _G.LogError("随机到了废弃的元素类型5")
                    end
                end
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
                self:Move(
                    data.element,
                    function()
                        self:SetShowElement(self.SelectElement)
                        self.CurItemData_right.element = self.SelectElement
                        self.lua_right:ShowData(self.CurItemData_right)
                        self.go_table.obj_select:SetActiveE(1)
                        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ShadowTopView.Name)
                        self.mParentView:ShowInfo()
                        if self.gameObject:GetActiveSelf() == 1 then
                            self.mParentView.go_table.aorbtn_switch:SetActiveE(1)
                        end
                    end
                )
                self.go_table.aorbtn_Done:SetActiveE(0)
            end
        )
    elseif go == self.go_table.aorbtn_no then
        self:CheckSelect(false)
    elseif go == self.go_table.aorbtn_ok then
        self.recast = true
        self:EquipmentSelectRecast(true)
    elseif go == self.go_table.aorbtn_tishi then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 25)
    end
end

----选择  检测并提示 是否确认放弃
function EquipmentView_recast:CheckSelect(isSelect)
    if self.recast then
        return
    end
    if isSelect == false then
        _G.PopWindowManager:ShowAllTips(
            120304,
            nil,
            function()
                self:EquipmentSelectRecast(isSelect)
            end
        )
    else
        self:EquipmentSelectRecast(isSelect)
    end
end

----true 有待选择五行
function EquipmentView_recast:GetSelectElement()
    return self.SelectElement ~= nil
end

----界面关闭检测 是否确认替换
function EquipmentView_recast:CheckClose(call)
    if self.recast then
        return
    end
    if self.SelectElement ~= nil then
        _G.PopWindowManager:ShowAllTips(
            120305,
            nil,
            function()
                self:EquipmentSelectRecast(true, call)
            end,
            function()
                self:EquipmentSelectRecast(false, call)
            end
        )
    else
        call()
    end
end

function EquipmentView_recast:EquipmentSelectRecast(isSelect, call)
