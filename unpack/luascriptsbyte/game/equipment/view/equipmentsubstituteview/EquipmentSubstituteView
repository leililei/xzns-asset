---@class EquipmentSubstituteView : UIBaseView	中文描述
---@field public go_table EquipmentSubstituteView_GoTable GoTable
local EquipmentSubstituteView = _G.BaseClass("EquipmentSubstituteView", _G.UIBaseView)
--_G.EquipmentSubstituteView = EquipmentSubstituteView

-- local CS = _G.CS
-- local typeof = _G.typeof

function EquipmentSubstituteView:Awake()
    self.UiDic = {
        txt = {
            zl = _G.LangUtil.GetLangPackValue(90020200032),
            wcdzb = _G.LangUtil.GetLangPackValue(90020400060)
        }
    }

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---@field TrueFun Function 替换后触发
---@field CardData CardData 当前卡牌
---@field CurItemData EquipmentItem 当前装备
---@field EquipmentType number 布甲皮甲
---@field parts number 替换的部位
---@class params_EquipmentSubstituteView Data

---界面的入口函数
---@param  Data params_EquipmentSubstituteView
function EquipmentSubstituteView:OnCreate(Data)
    self.Params_parts = 1
    self.EquipmentType = 1
    self.CurItemData = nil
    self.CardData = nil
    self.TrueFun = nil
    ---true替换了装备
    self.isSubstitute = false
    if Data ~= nil then
        self.Params_parts = Data.parts
        self.EquipmentType = Data.EquipmentType
        self.CardData = Data.CardData
        self.TrueFun = Data.TrueFun
        if Data.CurItemData ~= nil and Data.CurItemData.uid ~= nil then
            self.CurItemData = Data.CurItemData
        end
    end
    ---没生成对象
    if self.CurItem_lua == nil then
        ---开始生成对象 并标记
        self.CurItem_lua = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_KeXuanZho,
            function(itemLua)
                self.CurItem_lua = itemLua
                self:SetItem()
            end
        )
    elseif self.CurItem_lua ~= true then
        ---已生成对象
        self:SetItem()
    end
    self:SetData()
end

function EquipmentSubstituteView:SetData()
    self:ShowLoopItem()
end

function EquipmentSubstituteView:ShowLoopItem()
    if self.isInit == nil then
        self.go_table.scrollloopvectical_Equipment:InitItemData(0, _G.handler(self, self.RefreshList))
        self.isInit = true
    end

    local templist = _G.StorageManager:GetInstance():GetEquipListByParam(self.Params_parts, self.EquipmentType)
    ---卡牌身上装备
    local tCEList = {}
    local tL = require("EquipmentModel"):GetInstance():GetPartsList(self.Params_parts, self.EquipmentType)
    if tL ~= nil then
        tCEList = _G.table.toArray(tL)
    end

    local list = {}
    ---@param tEqu EquipmentItem
    for key, tEqu in pairs(templist) do
        if tEqu:GetParts() == self.Params_parts and tEqu.cardUid ~= self.CardData.uid then
            self:SetTempElement(tEqu)
            table.insert(list, tEqu)
        end
    end

    ---@param tEqu EquipmentItem
    for key, tEqu in pairs(tCEList) do
        if tEqu:GetParts() == self.Params_parts and tEqu.cardUid ~= self.CardData.uid then
            table.insert(list, tEqu)
        end
    end

    ---@param a EquipmentItem
    _G.SortList(
        list,
        function(a)
            --装备列表的装备按照战斗力降序进行排序
            return a:GetPower(), -a.uid
        end
    )

    self.ItemDataList = list
    if #self.ItemDataList > 0 then
        self.go_table.obj_NoFriend:SetActiveE(0)
    else
        self.go_table.obj_NoFriend:SetActiveE(1)
    end
    self.go_table.scrollloopvectical_Equipment:UpdateCount(#self.ItemDataList)
end

function EquipmentSubstituteView:RefreshList(index, objGame)
    if index < 0 then
        return
    end

    local itemGoTable = _G.GetAutoGoTable(objGame)

    itemGoTable.CardIndex = index + 1
    itemGoTable.ItemData = nil
    itemGoTable.ItemData = self.ItemDataList[itemGoTable.CardIndex]

    ---没生成对象
    if itemGoTable.LuaEqu == nil then
        ---开始生成对象 并标记
        itemGoTable.LuaEqu = true

        _G.EquipViewBase.Create(
            itemGoTable.ItemData,
            itemGoTable.obj_node,
            function(itemLua)
                itemGoTable.LuaEqu = itemLua
                self:SetLoopItem(itemGoTable)
            end
        )
    elseif itemGoTable.LuaEqu ~= true then
        ---已生成对象
        self:SetLoopItem(itemGoTable)
    end

    return objGame
end

function EquipmentSubstituteView:SetLoopItem(itemGoTable)
    if itemGoTable == nil then
        return
    end

    ---@type ItemEquipmentBase
    local lua = itemGoTable.LuaEqu
    ---@type ItemEquipmentBase
    local ItemData = itemGoTable.ItemData
    lua:ShowData(ItemData)
    lua:ShowCount()
    itemGoTable.gameObject:SetName(ItemData.uid)

    local power = ItemData:GetPower()

    itemGoTable.aortext_power.text = self.UiDic.txt.zl .. power

    --region --------------------------------------up图标--------

    if self.CurItemData == nil then
        itemGoTable.aorimage_up:SetActiveE(0)
    else
        ---如果当前有装备
        if self.nowPower == nil then
            self.nowPower = self.CurItemData:GetPower()
        end
        ---如果大于当前装备战斗力 则显示up图标
        itemGoTable.aorimage_up:SetActiveE(self.nowPower < power and 1 or 0)
    end

    --endregion------------------------------------up图标--------

    itemGoTable.aortext_Name.text = ItemData:GetName()
    ---已被穿戴
    local isCard = ItemData.cardUid ~= 0
    if isCard then
        itemGoTable.aorimage_card.Alpha = 0
        local carddata = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, ItemData.cardUid)
        if carddata ~= nil then
            itemGoTable.aorimage_card.Alpha = 1
            itemGoTable.aorimage_card.SpriteName = carddata.cfg.Icon
        end

        itemGoTable.aortext_Done.text = _G.LangUtil.GetLangPackValue(90020400047)
    else
        itemGoTable.aortext_Done.text = _G.LangUtil.GetLangPackValue(90023400020)
    end

    itemGoTable.aorimage_cardbox:SetActiveE(isCard and 1 or 0)
    itemGoTable.aortext_tips:SetActiveE(isCard and 1 or 0)
    if itemGoTable.isAddBtn == nil then
        itemGoTable.aorbtn_Done.onClick:AddListener(_G.handlerbind(self, self.OnClick_Equipment, itemGoTable))
        itemGoTable.isAddBtn = true
    end
end

function EquipmentSubstituteView:SetItem()
    if self.CurItem_lua == nil or self.CurItem_lua == true then
        return
    end

    local isEqu = self.CurItemData ~= nil
    self.CurItem_lua.gameObject:SetActiveE(isEqu and 1 or 0)
    self.go_table.obj_info1:SetActiveE(isEqu and 1 or 0)

    self.go_table.aortext_no:SetActiveE(isEqu == false and 1 or 0)

    if isEqu == false then
    else
        self.go_table.aortext_Name.text = self.CurItemData:GetName()
        self.go_table.aortext_power.text = self.UiDic.txt.zl .. _G.string.AddColor(self.CurItemData:GetPower(), "dc4800")
        self.CurItem_lua:ShowData(self.CurItemData)
    end
end

function EquipmentSubstituteView:CloseView()
    self:DelTempElement()
    if self.isSubstitute then
        if self.TrueFun ~= nil then
            self.TrueFun()
        end
    end
    self:Close()
end

---按钮点击事件在这里派发
function EquipmentSubstituteView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        ---ZHJ-19204 【装备】装备替换界面无法通过点击空白区域关闭
        self:CloseView()
    elseif go == self.go_table.aorbtn_CloseViewAny then
        self:CloseView()
    end
end

function EquipmentSubstituteView:OnClick_Equipment(itemGoTable)
    local ItemData = itemGoTable.ItemData
    self:SubstituteEquipment(ItemData)
end

--region --------------------------------------临时设置 以便在替换界面 显示同五行战斗力--------

---@param tEqu EquipmentItem
function EquipmentSubstituteView:SetTempElement(tEqu)
    if tEqu.cardUid ~= 0 or not require "CardInfoManager":GetInstance():CheckMultiMatch(tEqu.element, self.CardData.cfg.Elements_new) then
        return
    end

    ---临时同五行装备数组 方便还原
    if self.TempElementArr == nil then
        self.TempElementArr = {}
    end

    tEqu.IscardElement = true
    tEqu:SetUPProp()
    tEqu:GetPower(true)
    table.insert(self.TempElementArr, tEqu)
end

---@param tEqu EquipmentItem
function EquipmentSubstituteView:DelTempElement()
    if self.TempElementArr == nil then
        return
    end
    local tEqu
    local len = #self.TempElementArr
    for i = 1, len do
        tEqu = self.TempElementArr[i]
        tEqu.IscardElement = false
        tEqu:SetUPProp()
        tEqu:GetPower(true)
    end
    self.TempElementArr = {}
end
--endregion------------------------------------临时设置 以便在替换界面 显示同五行战斗力--------

function EquipmentSubstituteView:SubstituteEquipment(ItemData)
    require("EquipmentModel"):GetInstance():DressEquip(
        self.CardData.uid,
        {ItemData},
        function()
            self.isSubstitute = true
            self:CloseView()
            _G.AudioManager.PlayAudioByAudioCfgID(2055)
        end
    )
end

return EquipmentSubstituteView
