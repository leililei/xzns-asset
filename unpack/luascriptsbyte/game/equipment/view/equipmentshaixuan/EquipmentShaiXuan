---@class EquipmentShaiXuan : DecorationShaiXuan
---@field public go_table EquipmentShaiXuan_GoTable GoTable
local EquipmentShaiXuan = _G.BaseClass("EquipmentShaiXuan", _G.UIBaseView)
--_G.EquipmentShaiXuan = EquipmentShaiXuan
function EquipmentShaiXuan:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function EquipmentShaiXuan:OnCreate(call, selectButton)
    self.callDeco = call
    self.isShow = false
    if _G.table.isEmptyOrNil(selectButton) then
        self.selectButton = {
            [1] = {grade = 7, isShow = false},
            [2] = {grade = 6, isShow = false},
            [3] = {grade = 5, isShow = false},
            [4] = {grade = 4, isShow = false},
            [5] = {grade = 3, isShow = false},
            [6] = {grade = 2, isShow = false},
            [7] = {grade = 1, isShow = false}
        }
    else
        self.selectButton = selectButton
    end

    self.select_obj = {
        [1] = self.go_table.aorimage_2_0,
        [2] = self.go_table.aorimage_2_1,
        [3] = self.go_table.aorimage_2_2,
        [4] = self.go_table.aorimage_2_3,
        [5] = self.go_table.aorimage_2_4,
        [6] = self.go_table.aorimage_2_5,
        [7] = self.go_table.aorimage_2_6,
    }
    self:UpdateButton()
end

---按钮点击事件在这里派发
function EquipmentShaiXuan:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_close" then
        for i = 1, #self.selectButton do
            if self.selectButton[i].isShow then
                self.isShow = true
                break
            end
        end
        if self.callDeco then
            self.callDeco(self.isShow, self.selectButton, false)
        end
        self:Close()
    elseif name == "@_aorbtn_queding" then
        for i = 1, #self.selectButton do
            if self.selectButton[i].isShow then
                self.isShow = true
                break
            end
        end
        if self.callDeco then
            self.callDeco(self.isShow, self.selectButton, true)
        end
        self:Close()
    elseif name == "@_aorbtn_cheng" then
        self:RefreshButton(3)
    elseif name == "@_aorbtn_zi" then
        self:RefreshButton(4)
    elseif name == "@_aorbtn_lanse" then
        self:RefreshButton(5)
    elseif name == "@_aorbtn_hongse" then
        self:RefreshButton(2)
    elseif name == "@_aorbtn_lv" then
        self:RefreshButton(6)
    elseif name == "@_aorbtn_bai" then
        self:RefreshButton(7)
    elseif name == "@_aorbtn_jinse" then
        self:RefreshButton(1)
    end
end
function EquipmentShaiXuan:UpdateButton()
    if _G.table.isEmptyOrNil(self.selectButton) then
        return
    end
    for i = 1, #self.selectButton do
        _G.GameUtil.SetActiveByCondition(self.select_obj[i], self.selectButton[i].isShow)
    end
end

function EquipmentShaiXuan:RefreshButton(index)
    if self.selectButton[index].isShow then
        self.selectButton[index].isShow = false
        _G.GameUtil.SetActiveByCondition(self.select_obj[index], false)
        return
    end

    local selectGrade = self.selectButton[index].grade
    for i, v in pairs(self.selectButton) do
        if v.grade <= selectGrade and not self.selectButton[i].isShow then
            self.selectButton[i].isShow = true
            _G.GameUtil.SetActiveByCondition(self.select_obj[i], true)
        end
    end
end
return EquipmentShaiXuan
