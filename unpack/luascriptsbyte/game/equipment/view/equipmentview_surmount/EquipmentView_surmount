---@class EquipmentView_surmount:Component	装备  突破
local EquipmentView_surmount = _G.BaseClass("EquipmentView_surmount", _G.Component)
--_G.EquipmentView_surmount = EquipmentView_surmount

--local CS = _G.CS
--local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
---类的构造函数
function EquipmentView_surmount:__init(obj, mParentView)
    self.uidDIc = {
        ---已突破满 显示已满
        ymj = _G.LangUtil.GetLangPackValue(90020400058)
    }

    self.gameObject = obj
    self.mParentView = mParentView
    ---当前选中装备
    ---@type EquipmentItem
    self.CurItemData = self.mParentView.CurItemData
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))

    self.lua_left = nil
    self.lua_right = nil
end

function EquipmentView_surmount:Show(isShow)
    self.isShow = isShow
    self.CurItemData = self.mParentView.CurItemData
    if isShow == false then
        self:Hide()
        return
    end
    self.gameObject:SetActiveE(1)
    self:ShowInfo()
    self:ShowProp()
    local res = self:CheckShowBtn()
    ----有专属卡牌绑定时，修改背景图
    self:ShowBg(res)
    self:ShoBtn(res)
end
function EquipmentView_surmount:Hide()
    self.gameObject:SetActiveE(0)
end
function EquipmentView_surmount:ShowBg(res)
    if self.CurItemData.Grade >= 10 then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, not res)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg2, res)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg, res)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_bg2, false)
    end
end

function EquipmentView_surmount:ShowInfo()
    ---每次显示 都要刷新 防止装备 sid已变动
    ---突破后装备sid
    self.UpGradeSid = self.CurItemData:GetUpGradeSid()
    ---是否已突破满 显示已满
    self.isMax = self.UpGradeSid == nil or self.UpGradeSid == self.CurItemData.sid
    if not _G.AppSetting.IsXzns then
        if self.CurItemData.Grade == 10 and self.CurItemData.element == 0 then
            self.isMax = true
        end
    end
    ---突破后装备
    ---@type EquipmentItem
    self.CurItemData_right = nil

    --装备突破材料 [sid]=num
    self.MaterialDic = {}
    if self.UpGradeSid ~= nil then
        self.CurItemData_right = require("EquipmentItem").Copy(self.CurItemData)
        ---计算同五行
        self.CurItemData_right.IscardElement = self.CurItemData.IscardElement
        if not self.isMax then
            self.CurItemData_right:UpGradeSid(self.UpGradeSid)
            ---如果要显示绑定角色 单独添加角色sid
            if self.CurItemData.Grade == 10 then
                local sid = self.CurItemData:GetCardSid()
                if sid ~= 0 then
                    self.CurItemData_right:BoundCardId(sid)
                end
            end
        end
        local tParam = self.CurItemData.cfg.upgrade_material
        local tMat
        for i = 1, #tParam do
            tMat = tParam[i]
            self.MaterialDic[tMat[1]] = tMat[2]
        end
    end

    if self.CurItemData_right == nil then
        self.CurItemData_right = self.CurItemData
    end

    local res = {}
    for sid, num in pairs(self.MaterialDic) do
        table.insert(res, {sid, false, num})
    end

    if self.go_table.ResConsume == nil then
        ---@type Params_ConsumeCompont
        local data = {}
        data.showNow = true
        data.textColorType=4
        self.go_table.ResConsume =
            self:AddComponent(
            self.go_table.obj_consume,
            require("ConsumeCompont").New(self.go_table.obj_consume, res, nil, nil, true, data)
        )
    else
        self.go_table.ResConsume:RestRs(res)
    end

    if self.lua_left == nil then
        ---开始生成对象 并标记
        self.lua_left = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_left,
            function(itemLua)
                self.lua_left = itemLua
                self.lua_left:ShowData(self.CurItemData)
            end
        )
    else
        self.lua_left:ShowData(self.CurItemData)
    end

    ---没生成对象
    if self.lua_right == nil then
        ---开始生成对象 并标记
        self.lua_right = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_right,
            function(itemLua)
                self.lua_right = itemLua
                self.lua_right:ShowData(self.CurItemData_right)
            end
        )
    else
        self.lua_right:ShowData(self.CurItemData_right)
    end
    self.go_table.aortext_Name.text = self.CurItemData:GetName()
end
---是否显示突破按钮
function EquipmentView_surmount:CheckShowBtn()
    if self.CurItemData.Grade < 10 then
        return self.isMax == false
    else
        ---当突破已经到达十一阶
        if not _G.AppSetting.IsXzns and self.CurItemData.element == 0 then
            return false
        end
        -- 星座突破4，不再要求同种族
        if self.isMax then
            return false
        end
    end
    return true
end
function EquipmentView_surmount:ShoBtn(isShow)
    self.go_table.obj_res:SetActiveE(isShow and 1 or 0)
end

function EquipmentView_surmount:ShowProp()
    ---要显示的属性
    local showAttr = {
        _G.AttrType.atk.key,
        _G.AttrType.bre.key,
        _G.AttrType.def.key,
        _G.AttrType.max_hp.key,
        _G.AttrType.hit_rate.key,
        _G.AttrType.avd_rate.key,
        _G.AttrType.cri_rate.key,
        _G.AttrType.cri_r_rate.key
    }
    local attr = {}
    local getProp = self.CurItemData:GetAllAttr()
    local TempUPProp

    ---满 不显示属性
    if self.isMax == false then
        TempUPProp = self.CurItemData_right:GetAllAttr()
    end

    ---配置基础值
    for _, key in pairs(showAttr) do
        local num = getProp:GetValueByName(key)
        if num ~= 0 then
            table.insert(attr, {key = key, value = num})
        end
    end
    ---排序显示
    table.sort(
        attr,
        function(a, b)
            return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
        end
    )

    if self.propItemDic == nil then
        self.propItemDic = {}
    end

    local obj, info, baseValue, Value, newValue, tAttrType, isbfb
    local len = #attr

    for i = 1, len do
        ---生成属性条
        if self.propItemDic[i] == nil then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.obj_prop)
            table.insert(self.propItemDic, obj)
        else
            obj = self.propItemDic[i]
        end

        info = attr[i]
        ---基础值
        baseValue = info.value
        tAttrType = _G.AttrType[info.key]

        ---是否百分比
        isbfb = tAttrType.percentage == 1

        if isbfb then
            baseValue = baseValue * 100
            baseValue = _G.GameUtil.FormatNum(baseValue)
            baseValue = baseValue .. "%"
        else
            baseValue = _G.math.floor(baseValue)
        end
        if TempUPProp ~= nil then
            newValue = TempUPProp:GetValueByName(info.key)
            if isbfb then
                newValue = newValue * 100
                newValue = _G.GameUtil.FormatNum(newValue)
                newValue = newValue .. "%"
            else
                newValue = _G.math.floor(newValue)
            end
        end

        self:SetProp(obj, _G.AttrType[info.key].des, baseValue, i, newValue)

        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #self.propItemDic do
        self.propItemDic[i]:SetActiveE(0)
    end
    local attributeBind
    if self.CurItemData.element ~= 0 and self.CurItemData.Grade == 10 then
        attributeBind = self.CurItemData:GetAttributeBind()
    elseif self.CurItemData.element == 0 and self.isMax and self.CurItemData.Grade ~= 10 then
        attributeBind = self.CurItemData:GetCurAttributeBind()
    end
    ---如果有专属绑定属性 则显示
    if attributeBind then
        self.go_table.obj_cardAttr:SetActiveE(1)
        local curCardData =
            _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.CurItemData:GetEquipCardUid())
        local attrStr
        local attr
        local type
        self.go_table.aortext_cardAttrTxt.text = GetLangPackValue(90020400101, GetLangPackValue(curCardData.cfg.Name))
        if curCardData then
            local item = require("ItemCardAllView").New(self.go_table.obj_cardRoot)
            item:ShowCardData(curCardData)
            item:HideOrShowLevel(false)
            item:HideOrShowElements(false)
        end
        if attributeBind then
            for i = 1, #attributeBind do
                local name = self.go_table["aortext_propCard" .. i]
                name:SetActiveE(1)
                attrStr = _G.AttrType[attributeBind[i][1]]
                type = tonumber(attributeBind[i][2])
                if attrStr then
                    name.text = attrStr.des
                    if attrStr.proptype == 1 then
                        if type == 1 then
                            attr = attributeBind[i][3]
                        elseif type == 2 then
                            attr =
                                _G.string.AddColor(
                                math.floor(tonumber(attributeBind[i][3]) * 100 / 10000) .. "%",
                                "3B2121"
                            ) ..
                                "(+" ..
                                    math.floor(
                                        (curCardData.BaseProp:GetValueByID(attrStr.ID)) *
                                            (tonumber(attributeBind[i][3]) / 10000)
                                    ) ..
                                        ")"
                        end
                    else
                        if attrStr.percentage == 1 then
                            attr =
                                _G.string.AddColor(
                                math.floor(tonumber(attributeBind[i][3]) * 100 / 10000) .. "%",
                                "3B2121"
                            )
                        else
                            attr = attributeBind[i][3]
                        end
                    end
                    self.go_table["aortext_cardAttrTxt" .. i].text = attr
                end
            end
        end
    else
        self.go_table.obj_cardAttr:SetActiveE(0)
        self.go_table.obj_PropList:SetRectTransformSize(548, 360)
    end
end

function EquipmentView_surmount:SetProp(obj, name, num, index, newNum)
    local go_table = _G.GetAutoGoTable(obj)
    go_table.aorimage_di:SetActiveE(index % 2 == 0 and 0 or 1)
    go_table.aortext_strenName.text = name
    go_table.aortext_strenNum.text = num
    go_table.aortext_newNum.text = newNum and newNum or self.uidDIc.ymj
end
function EquipmentView_surmount:CheckCondition()
    local uid = self.CurItemData:GetEquipCardUid()
    local cd = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
    local sid = cd.sid or 0
    local tipsId
    local part = self.CurItemData:GetParts()
    ---未强化满级
    if not self.CurItemData.IscardElement and not  _G.AppSetting.IsXzns then
        ---卡牌与装备不同五行
        tipsId = 120122
    elseif not self.CurItemData:IsMAxStreng() then
        ---同部位装备已经绑定角色
        tipsId = 120119
    elseif cd.cfg.Order < 3 then
        tipsId = 120120
    elseif _G.StorageManager:GetInstance():GetCardIsBound(sid, part) then
        tipsId = 120121
    end
    if tipsId then
        _G.PopWindowManager:GetInstance():ShowAllTips(tipsId)
        return false
    else
        return true, cd.sid
    end
end
function EquipmentView_surmount:OnClickBtn(go, isOn)
    local condition, cardSid, tipsid
    if go == self.go_table.aorbtn_Done then
        if self.CurItemData.Grade == 10 then
            condition, cardSid = self:CheckCondition()
            if not condition then
                return
            else
                ---可以突破则显示提示
                tipsid = 120309
            end
        end
        for sid, num in pairs(self.MaterialDic) do
            if _G.StorageManager:GetInstance():CheckItemNew(sid, num) == false then
                return
            end
        end
        if tipsid then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                tipsid,
                nil,
                _G.handlerbind(self, self.EquipmentSurmount, cardSid)
            )
        else
            self:EquipmentSurmount(cardSid)
        end
    elseif go == self.go_table.aorbtn_tishi then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 25)
    end
end
function EquipmentView_surmount:EquipmentSurmount(cardSid)
    local left = require "EquipmentItem".Copy(self.CurItemData)
    local right = require "EquipmentItem".Copy(self.CurItemData_right)
    left.IscardElement = self.CurItemData.IscardElement
    right.IscardElement = self.CurItemData_right.IscardElement
    left:SetUPProp()
    right:SetUPProp()
    local bind = self.CurItemData:GetAttributeBind()
    require("EquipmentModel"):GetInstance():EquipmentSurmount(
        self.CurItemData,
        function()
            local StorageManagerIns = _G.StorageManager:GetInstance()
            for sid, num in pairs(self.MaterialDic) do
                StorageManagerIns:ConsumeItem(sid, 0, num)
            end
            StorageManagerIns:SetCardEquipBound(cardSid, self.CurItemData.sid, self.CurItemData:GetParts())
            self:Show(true)
            ---装备界面隐藏重铸功能
            --if self.CurItemData.Grade == 11 then
            --    self.mParentView:HideRecastToggle()
            --end
            self.mParentView:ShowInfo()
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.EquipmentSurmountView.Name,
                left,
                right,
                self.CurItemData:GetEquipCardUid(),
                bind
            )
        end,
        cardSid
    )
end
---类的析构函数
function EquipmentView_surmount:Dispose()
end

return EquipmentView_surmount
