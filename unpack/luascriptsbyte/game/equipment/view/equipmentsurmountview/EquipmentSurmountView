---显示属性
function EquipmentSurmountView:ShowProp(left, right, cardUid, bind)
    ---要显示的属性
    local showAttr = {
        _G.AttrType.atk.key,
        _G.AttrType.bre.key,
        _G.AttrType.def.key,
        _G.AttrType.max_hp.key,
        _G.AttrType.hit_rate.key,
        _G.AttrType.avd_rate.key,
        _G.AttrType.cri_rate.key,
        _G.AttrType.cri_r_rate.key
    }
    local attr = {}
    local getProp = left:GetAllAttr()
    local TempUPProp

    TempUPProp = right:GetAllAttr()

    ---配置基础值
    for _, key in pairs(showAttr) do
        local num = getProp:GetValueByName(key)
        if num ~= 0 then
            table.insert(attr, {key = key, value = num})
        end
    end
    ---排序显示
    table.sort(
        attr,
        function(a, b)
            return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
        end
    )

    if self.propItemDic == nil then
        self.propItemDic = {}
    end

    local obj, info, baseValue, Value, newValue, tAttrType, isbfb
    local len = #attr
    local isHaveBind = left.element ~= 0 and left.Grade == 10 and left:GetAttributeBind()
    if isHaveBind then
        self.go_table.obj_normal:SetActiveE(0)
        self.go_table.obj_high:SetActiveE(1)
    else
        self.go_table.obj_normal:SetActiveE(1)
        self.go_table.obj_high:SetActiveE(0)
    end
    for i = 1, len do
        if isHaveBind then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.trans_prop2)
        else
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.trans_prop)
        end

        info = attr[i]
        ---基础值
        baseValue = info.value
        tAttrType = _G.AttrType[info.key]

        ---是否百分比
        isbfb = tAttrType.percentage == 1

        if isbfb then
            baseValue = baseValue * 100
            baseValue = _G.GameUtil.FormatNum(baseValue)
            baseValue = baseValue .. "%"
        else
            baseValue = _G.math.floor(baseValue)
        end
        if TempUPProp ~= nil then
            newValue = TempUPProp:GetValueByName(info.key)
            if isbfb then
                newValue = newValue * 100
                newValue = _G.GameUtil.FormatNum(newValue)
                newValue = newValue .. "%"
            else
                newValue = _G.math.floor(newValue)
            end
        end

        self:SetProp(
            obj,
            _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[info.key].ID].name),
            baseValue,
            i,
            newValue
        )

        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #self.propItemDic do
        self.propItemDic[i]:SetActiveE(0)
    end
    ---如果有专属绑定属性 则显示
    if isHaveBind then
        self.go_table.trans_card:SetActiveE(1)
        local curCardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardUid)
        local attrStr
        local attr
        local type
        local attributeBind = bind
        self.go_table.aortext_name.text = _G.GetLangPackValue(90020400101, _G.GetLangPackValue(curCardData.cfg.Name))
        if curCardData then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.ItemCardStorageView,
                self.go_table.trans_card,
                function(item)
                    if self:IsNil() then
                        _G.DestroyImmediate(item.gameObject)
                        return
                    end
                    item:ShowCardData(curCardData)
                    item:HideOrShowLevel(false)
                    item:HideOrShowElements(false)
                end
            )
        end
        if attributeBind then
            for i = 1, #attributeBind do
                attrStr = _G.AttrType[attributeBind[i][1]]
                type = tonumber(attributeBind[i][2])
                if attrStr then
                    local obj2 = _G.InstantiateObject(self.go_table.obj_cardPropItem, self.go_table.trans_cardProp)
                    obj2:SetActiveE(1)
                    local go_table = _G.GetAutoGoTable(obj2)
                    if attrStr.proptype == 1 then
                        if type == 1 then
                            attr = attributeBind[i][3]
                        elseif type == 2 then
                            attr = math.floor(tonumber(attributeBind[i][3]) * 100 / 10000) .. "%"
                        end
                    else
                        if attrStr.percentage == 1 then
                            attr = math.floor(tonumber(attributeBind[i][3]) * 100 / 10000) .. "%"
                        else
                            attr = attributeBind[i][3]
                        end
                    end
                    go_table.aortext_strenName.text =
                        _G.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[attrStr.ID].name)
                    go_table.aortext_strenNum.text = attr
                end
            end
        end
    else
        self.go_table.trans_card:SetActiveE(0)
    end
end

function EquipmentSurmountView:SetProp(obj, name, num, index, newNum)
    local go_table = _G.GetAutoGoTable(obj)

    go_table.aortext_strenName.text = name
    go_table.aortext_strenNum.text = num
    go_table.aortext_newNum.text = newNum and newNum or self.uidDIc.ymj
end

---按钮点击事件在这里派发
function EquipmentSurmountView:OnClickBtn()
    if not self.canClose then
        return
    end
    self:Close()
end

return EquipmentSurmountView
