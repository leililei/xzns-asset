function EquipmentSurmountView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param left  EquipmentItem 升级前装备数据
---@param right EquipmentItem 升级后装备数据
---@param cardUid number 绑定卡牌uid
---@param bind number 绑定属性
function EquipmentSurmountView:OnCreate(left, right, cardUid, bind)
    self.go_table.aorrawimage_icon:LoadImage(left:GetIconPath())
    self:InitEquipment(left, self.go_table.trans_left)
    self:InitEquipment(right, self.go_table.trans_right)
    self:ShowProp(left, right, cardUid, bind)
    _G.DelayDo(
        1,
        function()
            self.canClose = true
        end
    )
end
