---@class EquipmentView : UIBaseView	中文描述
---@field public go_table EquipmentView_GoTable GoTable
---@field CloseFun function 关闭执行
---@field EquipmentItem EquipmentItem
local EquipmentView = _G.BaseClass("EquipmentView", _G.UIBaseView)

function EquipmentView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end


---@class params_EquipmentView Data
---界面的入口函数
---@param  Data params_EquipmentView
function EquipmentView:OnCreate(Data, equipBar)
    self.CloseFun = nil
    ---@type EquipmentItem
    self.CurItemData = nil
    if Data ~= nil then
        self.CloseFun = Data.CloseFun
        self.CurItemData = Data.EquipmentItem
        if _G.AppSetting.IsXzns then--星座没有种族加成，策划要求防止配置出错强制显示没有种族
            self.CurItemData.element = 0
        end
    end
    if self.CurItemData == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("无装备数据 ", "<color=red>" .. ">>>" .. "</color>")
        end
        self:CloseView()
        return
    end
    self:InitEquipmentList(equipBar)

    ---没生成对象
    if self.CurItem_lua == nil then
        ---开始生成对象 并标记
        self.CurItem_lua = true
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemEquipmentBase,
            self.go_table.obj_KeXuanZho,
            function(itemLua)
                self.CurItem_lua = itemLua
                self:SetItem()
            end
        )
    elseif self.CurItem_lua ~= true then
        ---已生成对象
        self:SetItem()
    end

    ---强化
    self.lua_strengthen = require("EquipmentView_strengthen").New(self.go_table.obj_strengthen, self)
    self.lua_strengthen:Hide()
    --重铸
    self.lua_recast = require("EquipmentView_recast").New(self.go_table.obj_recast, self)
    self.lua_recast:Hide()
    --洗炼
    self.lua_purify = require("EquipmentView_purify").New(self.go_table.obj_purify, self)
    self.lua_purify:Hide()
    --突破
    self.lua_surmount = require("EquipmentView_surmount").New(self.go_table.obj_surmount, self)
    self.lua_surmount:Hide()

    if self.CurItemData.Grade >= 7 then
        ---高品质强 强化->突破->洗练
        if not self.CurItemData:IsMAxStreng() then
            self.lua_strengthen:Show()
        else
            local UpGradeSid = self.CurItemData:GetUpGradeSid()
            local isMax = not UpGradeSid or UpGradeSid == self.CurItemData.sid
            if self.CurItemData.Grade == 10 and self.CurItemData.element == 0 then
                isMax = true
            end
            if isMax then
                self.go_table.toggle_purify.isOn = true
            else
                self.go_table.toggle_surmount.isOn = true
            end
        end
    else
        ---低品质一直显示强化
        self.lua_strengthen:Show()
    end
    self.go_table.toggle_purify:SetActiveE(self.CurItemData.Grade >= 7 and 1 or 0)
    self.go_table.toggle_surmount:SetActiveE(self.CurItemData.Grade >= 7 and 1 or 0)
    local showRecast = self.CurItemData.Grade < 11 and self.CurItemData.element ~= 0
    self.go_table.toggle_recast:SetActiveE(showRecast and 1 or 0)
end
function EquipmentView:SetItem()
    if self.CurItem_lua == nil or self.CurItem_lua == true then
        return
    end
    self.CurItem_lua:ShowData(self.CurItemData)
end

---@param data table strenExp增加的强化经验
function EquipmentView:ShowInfo(data)
    --- 当前强化经验
    --   data.strenExp
    --- 强化上的等级 sid
    --   data.strenSid
    local strenExp = self.CurItemData.strengExp

    --- 强化上的等级  不为空则是有效强化sid
    local strenSid = nil
    --- 强化等级
    local strenLv = 0
    if data ~= nil then
        --- 总计当前经验 (装备自身经验 + 增加强化经验)
        strenExp = data.strenExp

        if data.strenSid > self.CurItemData:GetStrengSid() then
            strenSid = data.strenSid
        end
    end
    -- self.go_table.slider_exp:SetActiveE(data ~= nil and 1 or 0)
    -- self.go_table.aortext_strenName:SetActiveE(data ~= nil and 1 or 0)
    self.go_table.obj_stenTips:SetActiveE(data ~= nil and 1 or 0)
    self.go_table.obj_prop:SetActiveE(data ~= nil and 1 or 0)
    self.go_table.slider_exp:SetActiveE(data ~= nil and 1 or 0)
    -- self.go_table.obj_prop:SetAnchorPosition(0, data ~= nil and -73 or -50)

    ---1 基础信息 默认显示
    self:SetX(self.go_table.obj_xnow, self.CurItemData.streng)

    if strenSid then
        local cfg = _G.ConfigManager.equipment_stren_cfg[strenSid]
        if cfg then
            self:SetX(self.go_table.obj_xNew, cfg.level)
            strenLv = cfg.level
        end
    end
    self.isUp = strenSid ~= nil
    self:ShowProp(strenLv)
    self.go_table.obj_xNew:SetActiveE(strenSid and 1 or 0)

    ---id（装备类型*10000+装备品质*100+强化等级）

    local slider = 1

    local maxExp = 0

    --- 之前经验
    local nowCfgExp = 0
    local cfg = self.CurItemData:GetEquipCurStrengCfg()
    if cfg ~= nil then
        nowCfgExp = cfg.points_up
    end
    --ZHJ-20118【客户端】装备强化显示优化
    local nextCfg
    if strenSid then
        nextCfg = _G.ConfigManager.equipment_stren_cfg[strenSid]
    else
        nextCfg = self.CurItemData:GetEquipNextStrengCfg()
    end
    if nextCfg ~= nil then
        --- 当前等级所需累计经验 -  之前经验
        maxExp = nextCfg.points_up - nowCfgExp
        -- 使用lua的正则匹配整数部分(eq:lua的正则表达式与一般的正则表达式有些区别)
        local strenExpStr = strenExp > 0 and string.match(_G.tostring(strenExp), "^(%-?%d+)%.?%d*$") or 0
        self.go_table.aortext_exp.text = string.format("%s/%d", strenExpStr, maxExp)
        slider = strenExp / maxExp
    else
        self.go_table.aortext_exp.text = "MAX"
    end
    self.go_table.slider_exp.value = slider

    self.go_table.aortext_Name.text = self.CurItemData:GetName()
    self:SetItem()
end

function EquipmentView:ShowProp(strenLv)
    ---要显示的属性
    local showAttr = {
        _G.AttrType.atk.key,
        _G.AttrType.bre.key,
        _G.AttrType.def.key,
        _G.AttrType.max_hp.key,
        _G.AttrType.hit_rate.key,
        _G.AttrType.avd_rate.key,
        _G.AttrType.cri_rate.key,
        _G.AttrType.cri_r_rate.key
    }
    local attr = {}
    local getProp = self.CurItemData:GetAllAttr()
    local TempUPProp = nil
    if strenLv > 0 then
        TempUPProp = self.CurItemData:GetTempUPProp(strenLv)
    end
    ---配置基础值
    for _, key in pairs(showAttr) do
        local num = getProp:GetValueByName(key)
        if num ~= 0 then
            table.insert(attr, {key = key, value = num})
        end
    end
    ---排序显示
    table.sort(
        attr,
        function(a, b)
            return _G.AttrType[a.key].sortid < _G.AttrType[b.key].sortid
        end
    )

    if self.propItemDic == nil then
        self.propItemDic = {}
    end

    local obj, info, baseValue, Value, newValue, tAttrType
    local len = #attr
    for i = 1, len do
        ---生成属性条
        if self.propItemDic[i] == nil then
            obj = _G.InstantiateObject(self.go_table.obj_propItem, self.go_table.obj_prop)
            table.insert(self.propItemDic, obj)
        else
            obj = self.propItemDic[i]
        end

        info = attr[i]
        ---基础值
        baseValue = info.value

        tAttrType = _G.AttrType[info.key]
        if tAttrType.percentage == 1 then
            baseValue = baseValue * 100

            baseValue = _G.GameUtil.FormatNum(baseValue)
            baseValue = baseValue .. "%"
        else
            baseValue = _G.math.floor(baseValue)
        end

        if strenLv > 0 and TempUPProp then
            newValue = TempUPProp:GetValueByName(info.key)
            if tAttrType.percentage == 1 then
                newValue = newValue * 100
                newValue = _G.GameUtil.FormatNum(newValue)
                newValue = newValue .. "%"
            else
                newValue = _G.math.floor(newValue)
            end
        end

        self:SetProp(obj, _G.AttrType[info.key].des, baseValue, i, newValue)

        obj:SetActiveE(1)
    end
    len = len + 1
    for i = len, #self.propItemDic do
        self.propItemDic[i]:SetActiveE(0)
    end
end

function EquipmentView:RefreshList(index, objGame)
    if index < 0 then
        return
    end

    local itemGoTable = _G.GetAutoGoTable(objGame)

    itemGoTable.CardIndex = index + 1

    itemGoTable.ItemData = nil
    local ItemData = self.ItemDataList[itemGoTable.CardIndex]
    local isEqu = self:IsEquipment(ItemData)

    ---没生成对象
    if itemGoTable.LuaEqu == nil then
        ---开始生成对象 并标记
        itemGoTable.LuaEqu = true

        _G.EquipViewBase.Create(
            ItemData,
            itemGoTable.obj_node,
            function(itemLua)
                itemGoTable.LuaEqu = itemLua
                self:SetLoopItem(itemGoTable)
            end,
            _G.handlerbind(self, self.OnClick_Item_Equipment, itemGoTable)
        )
    elseif itemGoTable.LuaEqu ~= true then
        ---已生成对象
        self:SetLoopItem(itemGoTable)
    end

    return objGame
end

function EquipmentView:SetLoopItem(itemGoTable)
    if itemGoTable == nil then
        return
    end
    ---@type EquipmentItem
    local ItemData = self.ItemDataList[itemGoTable.CardIndex]
    itemGoTable.ItemData = ItemData

    local lua = itemGoTable.LuaEqu

    itemGoTable.gameObject:SetName(self:GetItemUid(ItemData))
end

function EquipmentView:SetProp(obj, name, num, index, newNum)
    local go_table = _G.GetAutoGoTable(obj)

    -- go_table.aorimage_di:SetActiveE(index % 2 == 0 and 1 or 0)

    go_table.aortext_strenName.text = name
    go_table.aortext_strenNum.text = num

    local isNew = newNum ~= nil
    go_table.obj_new:SetActiveE(isNew and 1 or 0)
    if isNew then
        go_table.aortext_newNum.text = newNum
    end
end

function EquipmentView:SetX(obj, num)
    local go_table = _G.GetAutoGoTable(obj)
    ---@type AorImage
    local AorImage
    for i = 1, 5 do
        AorImage = go_table[string.format("aorimage_x (%d)", i)]
        AorImage:SetActiveE(i <= num and 1 or 0)
    end
end

---初始化装备列表
function EquipmentView:InitEquipmentList(equipBar)
    self.equipments = {}
    if equipBar == nil then
        _G.table.insert(self.equipments, self.CurItemData)
    else
        for i, v in pairs(equipBar) do
            if not _G.table.isEmptyOrNil(v) then
                _G.table.insert(self.equipments, v)
                if v == self.CurItemData then
                    self.curIndex = #self.equipments
                end
            end
        end
    end
    self.go_table.obj_switch:SetActiveE(#self.equipments > 1 and 1 or 0)
end

function EquipmentView:SwitchEquipment(delta)
    self.curIndex = (self.curIndex + delta) % #self.equipments
    if self.curIndex == 0 then
        self.curIndex = #self.equipments
    end
    self.CurItemData = self.equipments[self.curIndex]
    self:SetItem()
    self:ShowInfo()

    --显示经验条
    if self.lua_strengthen.gameObject:GetActiveSelf() == 1 then
        if self.CurItemData.Grade >= 7 then
            ---高品质强 强化->突破->洗练
            -- if not self.CurItemData:IsMAxStreng() then
            --     self.lua_strengthen:Show()
            -- end
            self.lua_strengthen:Show()
        else
            ---低品质一直显示强化
            self.lua_strengthen:Show()
        end
    end
    self.go_table.toggle_purify:SetActiveE(self.CurItemData.Grade >= 7 and 1 or 0)
    self.go_table.toggle_surmount:SetActiveE(self.CurItemData.Grade >= 7 and 1 or 0)
    local showRecast = self.CurItemData.Grade < 11 and self.CurItemData.element ~= 0
    self.go_table.toggle_recast:SetActiveE(showRecast and 1 or 0)
    local lua = {
        self.lua_strengthen,
        self.lua_recast,
        self.lua_purify,
        self.lua_surmount
    }
    if self.CurItemData.Grade >= 7 and self.go_table.toggle_recast.isOn == false then
        for _, v in pairs(lua) do
            if v.isShow then
                v:Show(true)
            end
        end
    else
        self.go_table.toggle_strengthen.isOn = true
        self.go_table.toggle_recast.isOn = false
        self.go_table.toggle_purify.isOn = false
        self.go_table.toggle_surmount.isOn = false
    end
end

function EquipmentView:CloseView()
    ----遮挡界面切换 先检测是否有待选择五行
    self.lua_recast:CheckClose(
        function()
            if self.CloseFun ~= nil then
                self.CloseFun()
                self.CloseFun = nil
            end
            self:Close()
        end
    )
end

---按钮点击事件在这里派发
function EquipmentView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_strengthen then
        self.lua_strengthen:Show(isOn)

        if isOn == false then
            self:ShowInfo()
        end
    elseif go == self.go_table.toggle_recast then
        self.lua_recast:Show(isOn)
    elseif go == self.go_table.toggle_purify then
        self.lua_purify:Show(isOn)
    elseif go == self.go_table.toggle_surmount then
        self.lua_surmount:Show(isOn)
    elseif go == self.go_table.aorbtn_preE then
        self.lua_recast:CheckClose(
            function()
                self:SwitchEquipment(-1)
            end
        )
    elseif go == self.go_table.aorbtn_nextE then
        self.lua_recast:CheckClose(
            function()
                self:SwitchEquipment(1)
            end
        )
    elseif go == self.go_table.aorbtn_anyClose then
        if self.lua_purify.isShow and self.lua_purify.lua_purifySelect and self.lua_purify.lua_purifySelect.isShow then
            ---ESC退出默认放弃洗练结果
            self.lua_purify.lua_purifySelect:EquipmentChoose(0)
        end
        self:CloseView()
    end

    -- body
end

return EquipmentView
