---@class EquipmentNet : BaseGameNet	通信协议
local EquipmentNet = _G.BaseClass("EquipmentNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return EquipmentNet EquipmentNet
function EquipmentNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---强化请求
---@param pbData table PB数据
---@param callback function 完成回调
function EquipmentNet:EquipmentUP(pbData, callback)
    local item = _G.ConfigManager.net_map.game_equipment_port_up_streng
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

