local DungeonChallengeNet = require("DungeonChallengeNet")

---@class DungeonChallengeModel:GameDataModelBase 装备合成闯关
local DungeonChallengeModel = _G.BaseClass("DungeonChallengeModel", _G.GameDataModelBase)

---@return DungeonChallengeModel DungeonChallengeModel
function DungeonChallengeModel:GetInstance()
    return self.super.GetInstance(self)
end

---类的构造函数
function DungeonChallengeModel:__init()
    self.curFunctionOpenID = _G.FunctionID.DungeonChallenge

    self.tasks = {}
    ---任务完成 刷新界面
    self.taskCompletedFun = _G.handler(self, self.TaskCompleted)
end

function DungeonChallengeModel:GetDataFormServer()
    self:GetInfo()
end

---获取信息
function DungeonChallengeModel:GetInfo(callback)
    DungeonChallengeNet:GetInstance():GetInfo(_G.handlerbind(self, self.GetInfoCall, callback))
end

---获取信息回调
function DungeonChallengeModel:GetInfoCall(msg, callback)
    --LogError(msg)
    self.max_chapter = msg.max_chapter

    require("DungeonChallengeBattleModel"):GetInstance():ParseData(msg)
    require("DungeonChallengeIllustrationModel"):GetInstance():ParseData(msg)

    self.finishTask = {}
    if msg.finish_task then
        for i, v in ipairs(msg.finish_task) do
            self.finishTask[v] = true
        end
    end

    self.canAwardTask = {}
    if msg.award_task then
        for i, v in ipairs(msg.award_task) do
            self.canAwardTask[v] = true
        end
    end
    --任务
    self:ParseTaskDatas(msg)
    self:InitFunction(msg.collectors)
    self:ParseData()

    if callback then
        callback()
    end
end

---判断上一层数据是否够
function DungeonChallengeModel:CheckFinishNum(gindex, num)
    if gindex == 0 then
        return true
    else
        local index = 0
        local cfgs = _G.ConfigManager.dungeon_challenge_task_group_cfg[gindex]
        for i, v in ipairs(cfgs.task) do
            for i1, v1 in ipairs(v) do
                local isGet = self:CheckIsGet(v1)
                if isGet then
                    index = index + 1
                end
            end
        end
        return index >= num
    end
    return false
end

---任务红点
function DungeonChallengeModel:CheckTaskRed()
    local task = self:GetTaskList()
    for i, v in ipairs(task) do
        if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
            local isGet = self:CheckIsGet(v.Cfg.id)
            if isGet == nil then
                return true
            end
        end
    end
    return false
end

---
---@protected
function DungeonChallengeModel:CheckTaskRedByType(index)
    local task = self:GetTaskList()
    for i, v in ipairs(task) do
        if v.i_task.state == _G.TaskEnum.ETaskState.Submited then
            local cfgs = _G.ConfigManager.dungeon_challenge_task_group_cfg[index].task
            for _, task in pairs(cfgs) do
                if _G.table.ContainsValue(task, v.Cfg.id) then
                    local isGet = self:CheckIsGet(v.Cfg.id)
                    if isGet == nil then
                        return true
                    end
                end
            end
        end
    end
    return false
end

---成就信息
---@param data achieve.s2c_achieve_info 成就信息
function DungeonChallengeModel:ParseTaskDatas(data)
    self.dataB = {}

    for _, value in pairs(data.collectors) do
        local s1 = value.key[1]
        local s2 = value.key[2]
        local s3 = value.key[3]
        if not self.dataB[s1] then
            self.dataB[s1] = {}
        end
        if not self.dataB[s1][s2] then
            self.dataB[s1][s2] = {}
        end
        self.dataB[s1][s2][s3] = value.value
    end
end

function DungeonChallengeModel:InitFunction(collectors)
    if not _G.table.isEmptyOrNil(self.tasks) then
        for i = 1, _G.table.count(self.tasks) do
            self.tasks[i]:Dispose()
        end
        self.tasks = {}
    end

    local cfgs = _G.ConfigManager.dungeon_challenge_task_group_cfg
    local temp = {}
    for i = 1, #cfgs do
        local task = cfgs[i].task
        local display = cfgs[i].display
        --LogError(display)
        if self:CheckFinishNum(display[1], display[2]) then
            for j = 1, #task do
                for k1, v1 in ipairs(task[j]) do
                    if k1 == #task[j] then
                        if self.finishTask[v1] == nil and _G.table.ContainsValue(temp, v1) == false then
                            _G.table.insert(temp, v1)
                        end
                    else
                        if self.finishTask[v1] == nil then
                            if _G.table.ContainsValue(temp, v1) == false then
                                _G.table.insert(temp, v1)
                            end
                            break
                        end
                    end
                end
            end
        end
    end

    --LogError(temp)

    for i = 1, #temp do
        self:SetServerInfo(temp[i])
    end

    if collectors ~= nil then
        self.DoServerTaskUpCor = _G.DelayFrameDo(function()
            for _, value in pairs(collectors) do
                _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAactionDC, value.key, value.value, nil, true)
            end
        end)
    end
end

---获取kv结构的任务数据
function DungeonChallengeModel:GetTaskListKV()
    local kvtasks = {}
    for i, v in ipairs(self.tasks) do
        kvtasks[v.sid] = v
    end
    return kvtasks
end

---获取任务列表
function DungeonChallengeModel:GetTaskList()
    local taskIds = {}
    for i, v in ipairs(self.tasks) do
        taskIds[v.sid] = i
    end
    local tasks = {}
    local cfgs = _G.ConfigManager.dungeon_challenge_task_group_cfg
    for i = 1, #cfgs do
        for k, v in ipairs(cfgs[i].task) do
            for _, sid in pairs(v) do
                if taskIds[sid] ~= nil then
                    table.insert(tasks, self.tasks[taskIds[sid]])
                    break
                end
            end
        end
    end
    return tasks
end

---整理服务器数据
---@param data achieve.s2c_achieve_info 成就信息
---@param id number 成就id
function DungeonChallengeModel:SetServerInfo(id)
    local task = {
        sid = id,
        state = self:GetTaskState(id),
        target = {
            [1] = 0
        }
    }
    local CjTaskData = require('DungeonChallengeTaskData').New(task, self.taskCompletedFun,
        _G.MarkTaskType.DungeonChallenge)
    table.insert(self.tasks, CjTaskData)
end

function DungeonChallengeModel:TaskCompleted(taskid)
    self:UpdataView()
end

function DungeonChallengeModel:UpdataView()
    local view = self:GetView()
    if view == nil then
        return
    end
    view:UpdateView()
end

---@return ActiveTaskView
function DungeonChallengeModel:GetView()
    if _G.IsNil(self.View) or _G.IsNil(self.View.gameObject) then
        self.View = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DungeonChallengeTaskView.Name)
    end

    return self.View
end

---获取任务状态
function DungeonChallengeModel:GetTaskState(sid)
    if self.finishTask[sid] ~= nil then
        return _G.TaskEnum.ETaskState.Submited
    end
    if self.canAwardTask[sid] ~= nil then
        return _G.TaskEnum.ETaskState.Submited
    end
    return _G.TaskEnum.ETaskState.Claimed
end

---更新已有成就的任务数据列表
function DungeonChallengeModel:UpdateServerTask(taskinfos)
    if taskinfos == nil then
        return
    end
    for key, value in pairs(taskinfos.collector) do
        self:CheckByServerValue(value.key, value.value)
        _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAactionDC, value.key, value.value, nil, true)
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.dungeon_task.id)
end

function DungeonChallengeModel:CheckByServerValue(key, num)
    if self.dataB ~= nil and self.dataB[key[1]] and self.dataB[key[1]][key[2]] and self.dataB[key[1]][key[2]][key[3]] then
        if self.dataB[key[1]][key[2]][key[3]] < num then
            self.dataB[key[1]][key[2]][key[3]] = num
        end
    end
end

function DungeonChallengeModel:FinishGetAward(ids, gindex, onFinishCallback)
    if self.getawardstate then
        return
    end
    self.getawardstate = true
    local canGets = {}

    for k, v in pairs(ids) do
        _G.table.insert(canGets, v)
    end
    if _G.table.count(canGets) > 0 then
        local pbData = { sid = {}, type = 0 }
        for i, v in ipairs(canGets) do
            if self.canAwardTask[v] == nil then
                _G.table.insert(pbData.sid, v)
            end
        end
        if #pbData.sid > 0 then
            DungeonChallengeNet:GetInstance():FinishTask(pbData, function(msg)
                if msg.ack ~= 1 then
                    return
                end
                for i, v in ipairs(pbData.sid) do
                    self.canAwardTask[v] = true
                end
                self:GetTaskAward(
                    canGets,
                    gindex,
                    function(data)
                        self.getawardstate = false
                        if onFinishCallback then
                            onFinishCallback()
                        end
                    end
                )
            end)
        else
            self:GetTaskAward(
                canGets,
                gindex,
                function(data)
                    self.getawardstate = false
                    if onFinishCallback then
                        onFinishCallback()
                    end
                end
            )
        end
    else
        self.getawardstate = false
        if onFinishCallback then
            onFinishCallback()
        end
    end
end

function DungeonChallengeModel:GetTaskAward(taskIds, gindex, call)
    if taskIds ~= nil then
        DungeonChallengeNet:GetInstance():FinishTask(
            {
                sid = taskIds,
                type = 1
            },
            function(data)
                if data.ack ~= 1 then
                    return
                end
                for i, v in ipairs(taskIds) do
                    self.finishTask[v] = true
                    self:UpdateMangerTasksNew(v, gindex)
                end

                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg
                    .dungeon_task.id)
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                if call then
                    call()
                end
            end
        )
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("章节关卡id为空，成就领奖暂停")
        end
    end
end

function DungeonChallengeModel:UpdateMangerTasksNew(sid, gindex)
    local gcfg = _G.ConfigManager.dungeon_challenge_task_group_cfg[gindex]

    local re_sid = 0
    local cfg = {}
    for i = 1, #gcfg.task do
        if _G.table.ContainsValue(gcfg.task[i], sid) then
            cfg = gcfg.task[i]
            break
        end
    end

    if sid == cfg[#cfg] then
        local mcfg = _G.ConfigManager.mission_extra_cfg[sid]
        local task = {
            sid = sid,
            state = _G.TaskEnum.ETaskState.Completed,
            target = { mcfg.count }
        }
        self:UpdataTask(task)

        for i = 1, #self.tasks do
            if self.tasks[i].i_task.sid == sid then
                _G.table.remove(self.tasks, i)
                break
            end
        end
    else
        for i = 1, #self.tasks do
            if self.tasks[i].i_task.sid == sid then
                _G.table.remove(self.tasks, i)
                break
            end
        end

        for k2, v2 in ipairs(cfg) do
            if v2 == sid then
                re_sid = k2 == #cfg and sid or cfg[k2 + 1]
                break
            end
        end

        if re_sid > 0 then
            local states
            local cfg = _G.ConfigManager.mission_extra_cfg[re_sid]
            if self.canAwardTask[re_sid] ~= nil then
                states = _G.TaskEnum.ETaskState.Submited
            else
                states = _G.TaskEnum.ETaskState.Claimed
            end
            local task = {
                sid = re_sid,
                state = states,
                target = { self:TiaoMuPanDuan(cfg.condition) }
            }
            local CjTaskData = require('DungeonChallengeTaskData').New(task, self.taskCompletedFun,
                _G.MarkTaskType.DungeonChallenge)
            table.insert(self.tasks, CjTaskData)
        end
    end
    if _G.table.count(self.tasks) == 0 then
        self:InitFunction()
    end
end

function DungeonChallengeModel:TiaoMuPanDuan(condition)
    local _ = #condition[1]
    for k1, v1 in pairs(self.dataB) do
        if condition[1][1] == k1 then
            for k2, v2 in pairs(v1) do
                if condition[1][2] == k2 then
                    for _, v3 in pairs(v2) do
                        return v3
                    end
                end
            end
        end
    end
    return 0
end

---@param  task task.i_task
function DungeonChallengeModel:UpdataTask(task)
    for i = 1, #self.tasks do
        if self.tasks[i].i_task.sid == task.sid then
            self.tasks[i]:UpdataData(task)
        end
    end
end

---获得装备
---@param sids 所有装备sid
---@param hc 合成
function DungeonChallengeModel:GetSomeEquip(sids, hc, rolesid)
    for i = 1, #sids do
        ---@type dungeon_challenge_equip_cfg
        local equip = _G.ConfigManager.dungeon_challenge_equip_cfg[sids[i]]
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.BattleAcitveOneEquip,
                equip.part,
                equip.quality
            },
            1
        )
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.BattleAcitveOneEquip,
                0,
                equip.quality
            },
            1
        )
    end
    if hc then
        local cardSid = require("DungeonChallengeBattleModel"):GetInstance().cardSid
        for i = 1, #sids do
            ----@type dungeon_challenge_equip_cfg
            --local equip = _G.ConfigManager.dungeon_challenge_equip_cfg[sids[i]]
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.OneRoleUnlockOneEquip,
                    cardSid,
                    sids[i]
                },
                1
            )
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.dungeon_task.id)
end

---结算刷新任务
function DungeonChallengeModel:SettlementToTask()
    for key, value in pairs(self.tasks) do
        if value.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.PassChapterNum or value.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.DungeonChallenge.LightSomeEquip then
            value:CheckTaskTarget()
            value:CheckTaskState()
        end
    end
end

---检测奖励是否领取
function DungeonChallengeModel:CheckIsGet(sid)
    return self.finishTask[sid]
end

---获取战斗是否跳过
function DungeonChallengeModel:GetAutoChoose()
    return _G.PlayerPrefsManager.GetInt("DungeonChallengeAutoChoose", 0)
end

---设置战斗是否自动战斗
function DungeonChallengeModel:SetAutoChoose(isSkip)
    local value = isSkip and 1 or 0
    _G.PlayerPrefsManager.SetInt("DungeonChallengeAutoChoose", value)
end

---类的析构函数
function DungeonChallengeModel:Dispose()
    if self.DoServerTaskUpCor then
        _G.coroutine.stopwaiting(self.DoServerTaskUpCor)
        self.DoServerTaskUpCor = nil
    end
end

return DungeonChallengeModel
