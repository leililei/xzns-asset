local DungeonChallengeBattleModel = require("DungeonChallengeBattleModel")
local DungeonChallengeNet = require("DungeonChallengeNet")
---@class DungeonChallengeIllustrationModel : Singleton    中文描述
local DungeonChallengeIllustrationModel = _G.BaseClass("DungeonChallengeIllustrationModel", _G.Singleton)

---@return DungeonChallengeIllustrationModel DungeonChallengeIllustrationModel
function DungeonChallengeIllustrationModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function DungeonChallengeIllustrationModel:__init()
end

---解析基本信息
---@param msg
function DungeonChallengeIllustrationModel:ParseData(msg)
    self.IllustrationData = {}
    for i, v in pairs(_G.ConfigManager.dungeon_challenge_equip_cfg) do
        self.IllustrationData[v.id] = {}
        self.IllustrationData[v.id].cfg = v
    end
    if msg.illustration_list then
        for i, v in ipairs(msg.illustration_list) do
            self.IllustrationData[v.sid].is_award = v.is_award
        end
    end
end

---
---@protected
function DungeonChallengeIllustrationModel:AddEquip(ids)
    if not ids or #ids == 0 then
        return
    end
    for i, v in ipairs(ids) do
        if self.IllustrationData[v] and self.IllustrationData[v].is_award == nil then
            self.IllustrationData[v].is_award = 0
        end
    end
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.dungeon_image.id)
end

---
---@protected
function DungeonChallengeIllustrationModel:GetDataByType(type)
    local list = {}
    if not _G.table.isEmptyOrNil(self.IllustrationData) then
        for i, v in pairs(self.IllustrationData) do
            if v.cfg.part == type then
                _G.table.insert(list, v)
            end
        end
    end
    _G.table.sort(list, function(a, b)
        return a.cfg.quality > b.cfg.quality
    end)
    return list
end

---
---@protected
function DungeonChallengeIllustrationModel:GetAllAwardData()
    local list = {}
    if self.IllustrationData then
        for i, v in pairs(self.IllustrationData) do
            if v.is_award and v.is_award == 0 then
                _G.table.insert(list, v.cfg.id)
            end
        end
    end
    return list
end

---
---@protected
function DungeonChallengeIllustrationModel:GetAllAward(callback)
    local list = self:GetAllAwardData()
    if #list == 0 then
        return
    end
    self:GetAward(list, callback)
end

---
---@protected
function DungeonChallengeIllustrationModel:GetAward(sids, callback)
    DungeonChallengeNet:GetInstance():IllustrationAward(sids, function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        for i, v in ipairs(sids) do
            self.IllustrationData[v].is_award = 1
        end
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.dungeon_image.id)
        if callback then
            callback()
        end
    end)
end

---销毁对象时,析构函数
function DungeonChallengeIllustrationModel:Dispose()
end

function DungeonChallengeIllustrationModel:CheckNumByType(type)
    local list = {}
    for i, v in pairs(self.IllustrationData) do
        if v.is_award == 1 and v.cfg.part == type then
            _G.table.insert(list, v)
        end
    end
    return list
end

return DungeonChallengeIllustrationModel
