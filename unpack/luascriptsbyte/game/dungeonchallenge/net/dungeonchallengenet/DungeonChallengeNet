local base = require("BaseGameNet")

---@class DungeonChallengeNet : BaseGameNet    通信协议
local DungeonChallengeNet = _G.BaseClass("DungeonChallengeNet", base)
---@return DungeonChallengeNet DungeonChallengeNet
function DungeonChallengeNet:GetInstance()
    return base.GetInstance(self)
end

---添加所有后端主动推的网络消息监听接口
function DungeonChallengeNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.dungeon_challenge_collector.Cmd, self.SendChengJiuCollectorCall)
end

---后端主动推送的消息数据开始
---发送成就收集消息
---@param data achieve.s2c_achieve_collector
function DungeonChallengeNet:SendChengJiuCollectorCall(data)
    ---处理后端主动推送的任务数据更新
    require("DungeonChallengeModel"):GetInstance():UpdateServerTask(data)
end

---获取闯关数据信息
---@param callback function 回调
function DungeonChallengeNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_info, self:GetEmptyPB(), callback)
end

---完成任务
---@param callback function 回调
function DungeonChallengeNet:FinishTask(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_finish, pbData, callback)
end

--region ==============================准备阶段(战前)==============================

---重置当前章节
---@param callback fun(msg:public.s2c_common_ack) 回调
function DungeonChallengeNet:ResetChapter(callback)
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_give_up, self:GetEmptyPB(), callback)
end

---选择章节
---@param sid number 章节id
---@param callback fun(msg:public.s2c_common_ack) 回调
function DungeonChallengeNet:ChooseChapter(sid, callback)
    local pbData = {
        chapter_sid = sid,
    }
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_choose_chapter, pbData, callback)
end

---选择卡牌
---@param sid number 卡牌sid
---@param callback fun(msg:dungeon_challenge.s2c_choose_card) 回调
function DungeonChallengeNet:ChooseCard(sid, callback)
    local pbData = {
        card_sid = sid,
    }
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_choose_card, pbData, callback)
end

--endregion

--region ==============================战斗中==============================

---移除装备
---@param data dungeon_challenge.i_equip[]
---@param callback fun(msg:public.s2c_common_ack) 回调
function DungeonChallengeNet:RemoveEquip(data, callback)
    ---@type dungeon_challenge.c2s_remove_equip
    local pbData = {
        new_equip = data
    }
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_remove_equip, pbData, callback)
end

--合并装备
---@param first dungeon_challenge.i_equip 装备1
---@param second dungeon_challenge.i_equip 装备2
---@param equipIndex number 装备索引
---@param callback fun(msg:public.s2c_common_ack) 回调
function DungeonChallengeNet:ConflateEquip(first, second, equipIndex, callback)
    ---@type dungeon_challenge.c2s_conflate_equip
    local pbData = {
        conflate_equip = first,
        consume = second,
        choose_index = equipIndex,
    }
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_conflate_equip, pbData, callback)
end

---发起战斗请求
---@param callback fun(msg:dungeon_challenge.s2c_fight) 回调
function DungeonChallengeNet:Fight(callback)
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_fight, self:GetEmptyPB(), callback)
end

--endregion

--region ==============================图鉴==============================

---领取装备图鉴奖励
---@param callback fun(msg:dungeon_challenge.s2c_fight) 回调
function DungeonChallengeNet:IllustrationAward(sids, callback)
    local pbData = {
        sid = sids
    }
    self:Access(_G.ConfigManager.net_map.game_dungeon_challenge_illustration_award, pbData, callback)
end

--endregion


---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function DungeonChallengeNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---显示错误消息ack的tips
function DungeonChallengeNet:ShowErrorAckTips(ack)
    if ack == 59 or ack == 135 then
        return
    end
    if ack == 2 then
        ack = 1080305
    end
    _G.PopWindowManager:GetInstance():ShowAllTips(ack)
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DungeonChallengeNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return DungeonChallengeNet
