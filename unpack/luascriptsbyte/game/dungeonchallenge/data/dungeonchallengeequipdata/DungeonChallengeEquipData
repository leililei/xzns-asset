---装备氛围特性: id = width * 10 + height
local EquipAreaEffects = {
    [11] = "ef_dungeon_mood1",     --1格
    [12] = "ef_dungeon_mood2shu",  --竖向2格
    [21] = "ef_dungeon_mood2heng", --横向2格
    [13] = "ef_dungeon_mood3shu",  --竖向3格
    [31] = "ef_dungeon_mood3heng", --横向3格
    [22] = "ef_dungeon_mood4",     --横向2格, 竖向2格
}

---@class DungeonChallengeEquipData
---@field cfg dungeon_challenge_equip_cfg
---@field width number                      @装备占用高度
---@field height number                     @装备占用宽度
local DungeonChallengeEquipData = _G.BaseClass("DungeonChallengeEquipData")

---@param cfg dungeon_challenge_equip_cfg
function DungeonChallengeEquipData:__init(cfg)
    self.cfg = cfg
    self.width = math.max(cfg.area[1] or 1, 1)
    self.height = math.max(cfg.area[2] or 1, 1)
end

---获取装备id
---@return number @装备id
function DungeonChallengeEquipData:GetId()
    return self.cfg.id
end

---是否可以作为材料进行升级
---@param other DungeonChallengeEquipData
function DungeonChallengeEquipData:IsConsume(other)
    if not other or not self.cfg.merge_equip or not other.cfg.merge_equip then
        return false
    end
    return self.cfg.id == other.cfg.id
end

---获取装备占用大小
---@return number,number @width, height
function DungeonChallengeEquipData:GetSize()
    return self.width, self.height
end

---获取装备图标
---@return string @图标路径
function DungeonChallengeEquipData:GetIcon()
    return self.cfg.Icon
end

---获取装备模型
---@return string @模型路径
function DungeonChallengeEquipData:GetModel()
    return self.cfg.Icon
end

---获取装备模型参数
---@return number,number,number,number @模型参数, 分别为模型位置X, 模型位置Y, 模型旋转角度
function DungeonChallengeEquipData:GetModelParams()
    local scaleX, scaleY, angle = table.unpack(self.cfg.zoom_rotate)
    return scaleX or 1, scaleY or 1, angle or 0
end

---获取装备icon参数
---@return number,number,number,number,number @模型参数, 分别为模型位置X, 模型位置Y, 模型旋转角度, 点击范围宽度
function DungeonChallengeEquipData:GetIconParams()
    local scaleX, scaleY, angle, size = table.unpack(self.cfg.icon_rotate)
    return scaleX or 1,
        scaleY or 1,
        angle or 0,
        math.max(size or 0, 50)
end

---获取装备氛围特效
---@return ui_effect_cfg @氛围特效配置
function DungeonChallengeEquipData:GetAreaEffect()
    local key = EquipAreaEffects[self.width * 10 + self.height]
    if not key then
        return nil
    end
    return _G.ConfigManager.ui_effect_cfg[key]
end

return DungeonChallengeEquipData
