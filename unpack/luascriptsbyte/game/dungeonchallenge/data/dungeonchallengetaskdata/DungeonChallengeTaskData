---@class DungeonChallengeTaskData : ActiveTaskBase    中文描述
---@field Cfg mission_extra_cfg
local DungeonChallengeTaskData = _G.BaseClass("DungeonChallengeTaskData", _G.ActiveTaskBase)

function DungeonChallengeTaskData:Init(task)
    if task.state == _G.TaskEnum.ETaskState.Claimed then
        _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAactionDC, self.OnAactionEnentCj, self)
    end
end

---类的析构函数
function DungeonChallengeTaskData:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAactionDC, self.OnAactionEnentCj, self)
end

function DungeonChallengeTaskData:OnAactionEnentCj(a, b, c, d, e, f, g)
    self:OnAactionEnent(a, b, c, d, e, f, g)
end

--- 检测任务状态
function DungeonChallengeTaskData:CheckTaskState()
    if self.i_task == nil then
        return
    end
    --- 防止 抽卡0/5 任务  十连   服务器记录10/5
    if self.i_task.target[1] > self.Cfg.count then
        self.i_task.target[1] = self.Cfg.count
    end

    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.i_task.target[1] >= self.Cfg.count then
        else
            --- 次数没达到 不算完成
            return
        end

        self.i_task.state = _G.TaskEnum.ETaskState.Submited
        _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)

        if self.MarkTaskType == _G.MarkTaskType.none then
            if _G.AppSetting.DEBUG then
                _G.LogError("MarkTaskType  未定义")
            end
        else
            local tData = {}
            tData.dayid = self.dayid
            tData.manualId = self.manualId
            require("TaskManager").MarkTask(self.MarkTaskType, self.i_task.sid, tData, self.i_task)
        end

        local pbData = {}
        pbData.type = 0
        pbData.sid = { self.i_task.sid }
        require("DungeonChallengeNet"):GetInstance():FinishTask(pbData)
        require("DungeonChallengeModel"):GetInstance().canAwardTask[pbData.sid[1]] = true
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.dungeon_task.id)

        if self.call ~= nil then
            _G.TaskModule:GetInstance():SetCompletedTask(self.i_task.sid)
            self.call(self.i_task.sid)
            self.call = nil
        end
    elseif self.i_task.state == _G.TaskEnum.ETaskState.Submited then
        ---如果已标记为完成 就设置进度为完成
        if self.i_task.target[1] == 0 then
            ---只有没进度 才这样 防止 频繁刷新 数据不对
            local value = self.taskcontentparams[#self.taskcontentparams] or 0
            local num = value
            if self.Cfg and self.Cfg.count then
                if num >= self.Cfg.count then
                    num = self.Cfg.count
                end
            end
            self.i_task.target[1] = num
        end
    end
end

function DungeonChallengeTaskData:IsCheckTaskTargets(num)
    return num
end

function DungeonChallengeTaskData:InitCfg()
    self.Cfg = _G.ConfigManager.mission_extra_cfg[self.i_task.sid]
    self.sid = self.i_task.sid
end

return DungeonChallengeTaskData
