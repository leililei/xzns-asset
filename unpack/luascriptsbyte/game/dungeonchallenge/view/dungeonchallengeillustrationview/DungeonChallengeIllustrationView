local DungeonChallengeIllustrationModel = require("DungeonChallengeIllustrationModel")
---@class DungeonChallengeIllustrationView : UIBaseView    中文描述
---@field public go_table DungeonChallengeIllustrationView_GoTable GoTable
local DungeonChallengeIllustrationView = _G.BaseClass("DungeonChallengeIllustrationView", _G.UIBaseView)

local qualityIcon = {
    [4] = "ui_cgfb_zbtj_di_zi",
    [5] = "ui_cgfb_zbtj_di_cheng",
    [6] = "ui_cgfb_zbtj_di_hong",
    [7] = "ui_cgfb_zbtj_di_jin",
}

---构造函数
---@protected
function DungeonChallengeIllustrationView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DungeonChallengeIllustrationView:OnCreate()
    self.type = 1
    self:InitView()
end

---
---@protected
function DungeonChallengeIllustrationView:RefreshAllAwardBtn()
    local list = DungeonChallengeIllustrationModel:GetInstance():GetAllAwardData()
    self.go_table.aorbtn_get:SetActiveE(#list > 0 and 1 or 0)
end

---
---@protected
function DungeonChallengeIllustrationView:InitView()
    self.data = DungeonChallengeIllustrationModel:GetInstance():GetDataByType(self.type)
    if self.init == nil then
        self.go_table.scrollloopvectical_card:InitItemData(#self.data, _G.handler(self, self.RefreshItem))
        self.init = true
    else
        self.go_table.scrollloopvectical_card:UpdateAllItem()
    end
    self:RefreshAllAwardBtn()
end

function DungeonChallengeIllustrationView:RefreshItem(index, obj)
    index = index + 1
    local data = self.data[index]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))
    if _G.AppSetting.IsXzns then
        tb.aortext_name.text = _G.GetLangPackValue(data.cfg.name)
    end
    tb.obj_award:SetActiveE((data.is_award and data.is_award == 0) and 1 or 0)             --判断是否解锁
    tb.obj_lock:SetActiveE(data.is_award == nil and 1 or 0)              --宝箱按钮显示
    tb.aorimage_ColorBG.SpriteName = qualityIcon[data.cfg.quality]
    tb.aorrawimage_Icon:LoadImage(data.cfg.Icon)
    tb.obj_uieffect:SetActiveE(data.cfg.quality == 7 and 1 or 0)
end

function DungeonChallengeIllustrationView:OnClickItem(go, isOn, data)
    local name = go:GetName()
    if name == "@_aorbtn_baoxiang" then
        DungeonChallengeIllustrationModel:GetInstance():GetAward(
            { data.cfg.id },
            function()
                self:InitView()
                require("DungeonChallengeModel"):GetInstance():SettlementToTask()
            end
        )
    elseif name == "@_aorbtn_click" then
        --弹出装备详情
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungeonChallengeEquipTipView.Name, { data.cfg })
    elseif name == "@_aorbtn_lock" then
        --弹出装备详情
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungeonChallengeEquipTipView.Name, { data.cfg })
    end
end

---界面的销毁函数
function DungeonChallengeIllustrationView:OnDestroy()
end

---按钮点击事件在这里派发
function DungeonChallengeIllustrationView:OnClickBtn(go)
    if go == self.go_table.aorbtn_get then
        --一键领取按钮点击
        DungeonChallengeIllustrationModel:GetInstance():GetAllAward(function()
            self:InitView()
            require("DungeonChallengeModel"):GetInstance():SettlementToTask()
        end)
        --_G.Events:GetInstance():Broadcast(_G.eDungeonChallenge.equipGet, { 265040101 })
        --DungeonChallengeIllustrationModel:GetInstance():AddEquip({ 265040101 })
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_tip then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 204)
    else
        --筛选类型
        for i = 1, 6 do
            local typeNode = self.go_table["aorbtn_type" .. i]
            if go == typeNode then
                if self.type ~= i then
                    self.type = i
                    self:InitView()
                end
                self.go_table.obj_typeOn:SetParentE(typeNode)
                self.go_table.obj_typeOn:SetLocalPositionToZero()
                self.go_table.obj_typeOn:SetAsFirstSiblingE()
                break
            end
        end
    end
end

return DungeonChallengeIllustrationView