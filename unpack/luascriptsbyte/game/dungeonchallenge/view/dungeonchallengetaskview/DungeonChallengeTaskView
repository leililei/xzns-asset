local DungeonChallengeModel = require("DungeonChallengeModel")
local DungeonChallengeBattleModel = require("DungeonChallengeModel")
---@class DungeonChallengeTaskView : UIBaseView    中文描述
---@field public go_table DungeonChallengeTaskView_GoTable GoTable
local DungeonChallengeTaskView = _G.BaseClass("DungeonChallengeTaskView", _G.UIBaseView)

---构造函数
---@protected
function DungeonChallengeTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ItemView = {}

    self.FoldStates = {}
    self.FoldList = {}
end

---界面的入口函数
function DungeonChallengeTaskView:OnCreate()
    --- 上次跳转的任务位置
    self.LastIndex = -1
    self:UpdateView()
end

---更新界面
function DungeonChallengeTaskView:UpdateView()
    self.AllTasks = DungeonChallengeModel:GetInstance():GetTaskListKV()
    self.AllInfo = {}
    local cfg = _G.ConfigManager.dungeon_challenge_task_group_cfg
    for i = 1, #cfg do
        local data = {}
        data.isTitle = true
        data.desc = cfg[i].group_desc
        data.index = i

        local temptitle = {}
        table.insert(temptitle, data)

        local tempinfo = {}

        --table.insert(self.AllInfo, data)

        local contentNum = 0

        local tasks = cfg[i].task
        for j = 1, #tasks do
            for k = 1, #tasks[j] do
                local id = tasks[j][k]

                if self.AllTasks[id] then
                    local datat = {}
                    datat.isTitle = false
                    datat.dece = ""
                    datat.index = i
                    datat.info = self.AllTasks[id]
                    contentNum = contentNum + 1

                    table.insert(tempinfo, datat)

                    --table.insert(self.AllInfo, datat)
                end
            end
        end

        if false ~= table.indexof(self.FoldList, i) then
            table.insert(self.AllInfo, temptitle[1])
        else
            if contentNum > 0 then
                table.insert(self.AllInfo, temptitle[1])
                for i = 1, #tempinfo do
                    table.insert(self.AllInfo, tempinfo[i])
                end
            end
        end
    end
    self:RefreshTask()
end

---任务刷新
function DungeonChallengeTaskView:RefreshTask()
    if self.mlistView == nil then
        self.go_table.looplist2_item:InitListView(#self.AllInfo, _G.handler(self, self.RefreshItem))
        self.mlistView = self.go_table.looplist2_item
    else
        self.mlistView:SetListItemCount(#self.AllInfo, true, false, self.LastIndex)
        self.mlistView:RefreshAllShownItem()
    end
end

---@param listView2 SuperScrollView.LoopListView2
---@param index number
function DungeonChallengeTaskView:RefreshItem(listView2, index)
    index = index + 1
    local data = self.AllInfo[index]
    local obj
    if data.isTitle then
        obj = listView2:NewListViewItem("$_obj_itemtitle")
        self:ShowTitle(obj, data)
    else
        obj = listView2:NewListViewItem("$_obj_item")
        self:ShowTask(obj, data, index)
    end
    return obj
end

function DungeonChallengeTaskView:ShowTitle(obj, data)
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTitle, data.index))
    go_table.aortext_title.text = _G.GetLangPackValue(data.desc)
    go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.dungeon_task.id, data.index)

    local y = -1
    if self.FoldStates[data.index] then
        y = 1
    end
    go_table.aorimage_change:SetLocalScale(1, y, 1)
end

function DungeonChallengeTaskView:ShowTask(obj, _data, index)
    local data = _data.info
    local gindex = _data.index
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, data, gindex))

    if index % 2 == 0 then
        go_table.aorimage_bg.SpriteName = "ui_cbfb_rwrz_fream"
    else
        go_table.aorimage_bg.SpriteName = "ui_alx_zc_zbtc_di_4"
    end

    go_table.obj_effect:ClearChildren()

    if not _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_dungeon_task,
            go_table.obj_effect,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
    go_table.obj_effect:SetActiveE(0)

    if data.i_task.state == _G.TaskEnum.ETaskState.Submited or data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        local jdz = data.Cfg.count > 0 and _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count) or ""
        go_table.aortext_title.text = _G.GetLangPackValue(data.Cfg.desc) .. jdz

        local isGet = DungeonChallengeModel:GetInstance():CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        --go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_isget:SetActiveE(isGet and 1 or 0)

        if not isGet then
            go_table.aortext_title.color = require("CardInfoManager").GetColorFromRGB(_G.AppSetting.IsXzns and "458742" or "73cf64")
        else
            go_table.aortext_title.color = require("CardInfoManager").GetColorFromRGB(_G.AppSetting.IsXzns and "384562" or "FFE16A")
        end

        go_table.aortext_action.text = ""
    else
        local jdz = data.Cfg.count > 0 and _G.string.format("(%s/%s)", data.i_task.target[1], data.Cfg.count) or ""
        go_table.aortext_title.text = _G.GetLangPackValue(data.Cfg.desc) .. jdz

        go_table.aortext_title.color = require("CardInfoManager").GetColorFromRGB(_G.AppSetting.IsXzns and "384562" or "FFE16A")
        go_table.aorbtn_get:SetActiveE(0)
        --go_table.aorbtn_way:SetActiveE(1)
        if data.Cfg.link and data.Cfg.link ~= 0 then
            -- go_table.aorbtn_way:SetGray(false)
            -- go_table.aorbtn_way.interactable = true
        else
            -- go_table.aorbtn_way:SetGray(true)
            -- go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_isget:SetActiveE(0)

        local chapterIndex = DungeonChallengeBattleModel:GetInstance().chapterIndex or 0
        if chapterIndex == gindex then
            go_table.obj_effect:SetActiveE(1)
            --go_table.aortext_action.text = "进行中..."
            go_table.aortext_action.text = GetLangPackValue(90036102026)
            go_table.aortext_action.color = require("CardInfoManager").GetColorFromRGB(_G.AppSetting.IsXzns and "384562" or "FFE16A")
        elseif chapterIndex < gindex then
            go_table.aortext_action.text = GetLangPackValue(90036102024)
            go_table.aortext_action.color = require("CardInfoManager").GetColorFromRGB(_G.AppSetting.IsXzns and "384562" or "9D602F")
        else
            go_table.aortext_action.text = ""
        end
    end
    _G.UIUtils.RemoveChildren(go_table.obj_items)
    for i = 1, #data.Cfg.reward do
        if data.Cfg.reward[i][2] > 0 then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.Cfg.reward[i],
                go_table.obj_items,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.6)
                    if data.Cfg.reward[i][2] > 1 then
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    else
                        tran:ShowNumText(false)
                    end
                    --tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                    if tran.ShowEffectOrder and tran.cfg then
                        tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                    end
                end
            )
        end
    end
end

function DungeonChallengeTaskView:OnClickTitle(go, isOn, index)
    if not self.FoldStates[index] then
        self.FoldStates[index] = true
        table.insert(self.FoldList, index)
    else
        self.FoldStates[index] = false
        table.removebyvalue(self.FoldList, index)
    end

    self.AllInfo = {}

    self:UpdateView()
end

---点击任务
function DungeonChallengeTaskView:OnClickTask(go, isOn, data, gindex)
    local name = go:GetName()

    if name == "@_aorbtn_get" then
        local ids = {}
        local isGet = DungeonChallengeModel:GetInstance():CheckIsGet(data.Cfg.id)
        if data.i_task.state == _G.TaskEnum.ETaskState.Submited and not isGet then
            table.insert(ids, data.Cfg.id)
        end
        DungeonChallengeModel:GetInstance():FinishGetAward(ids, gindex, function(list)
            self.LastIndex = gindex
            self:UpdateView()
        end)
    elseif name == "@_aorbtn_way" then
        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

---界面的销毁函数
function DungeonChallengeTaskView:OnDestroy()
end

---按钮点击事件在这里派发
function DungeonChallengeTaskView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return DungeonChallengeTaskView
