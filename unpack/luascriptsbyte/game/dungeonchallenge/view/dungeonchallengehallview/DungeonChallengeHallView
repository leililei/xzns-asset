local base = require "EventViewBase"
---@class DungeonChallengeHallView : UIBaseView	建筑升级
---@field public go_table DungeonChallengeHallView_GoTable GoTable
local DungeonChallengeHallView = _G.BaseClass("DungeonChallengeHallView", base)

function DungeonChallengeHallView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdate)
end

---界面的入口函数
function DungeonChallengeHallView:OnCreate(sid)
    local cfg = _G.ConfigManager.warp_gate_cfg
    self.cfgs = {}
    for i = 1, #cfg do
        local isHide = false
        if cfg[i].id == 2 then--找茬
            isHide = require("NitpickModel"):GetInstance():CheckIsGuide()
        end
        if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg[i].function_open) and not isHide then
            table.insert(self.cfgs, cfg[i])
        end
    end

    --local res = _G.ConfigManager.ui_cfg.DungeonChallengeHallView.resources
    --self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))

    self:Show()
end

function DungeonChallengeHallView:OnSixClockUpdate()
    self:Show()
end

function DungeonChallengeHallView:Show(sid)
    if self.Init == nil then
        self.go_table.scrollloopvectical_item:InitItemData(#self.cfgs,
            _G.handler(self, self.RefreshList))
        self.Init = true
    else
        self.go_table.scrollloopvectical_item:UpdateAllItem()
    end
end

function DungeonChallengeHallView:RefreshList(index, objGame)
    if index < 0 then
        return
    end
    local data = self.cfgs[index + 1]
    local tb = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
        tonumber(data.function_open)
    )

    local str, tipsid = _G.FunctionManager:GetInstance():GetTipsStr(tonumber(data.function_open))
    tb.aortext_OpenDesc.text = str

    -- if nil == tb.bgeff then
    --     tb.bgeff = 1
    --     _G.UIUtils.LoadEffectByCfg(
    --         _G.ConfigManager.ui_effect_cfg.ef_DungeonChallengeHallView_bg,
    --         tb.obj_bgeff,
    --         function(trans)
    --             if self:IsNil() then
    --                 _G.DestroyObject(trans)
    --                 return
    --             end
    --         end
    --     )
    -- end

    tb.obj_redpoint:UpdateRedPointItemIDAndParam(data.redPointID)
    tb.aorrawimage_icon:LoadImage(data.Image, function()
        tb.aorrawimage_icon:SetNativeSize()
    end)
    if not isOpen then
        tb.aorrawimage_DescBg:SetActiveE(1)
        tb.aorrawimage_OpenBg:SetActiveE(1)
        --tb.aorrawimage_nameBg:SetGray(true)
        tb.obj_bgeff:SetActiveE(0)
    else
        tb.aorrawimage_DescBg:SetActiveE(1)
        tb.aorrawimage_OpenBg:SetActiveE(0)
        --tb.aorrawimage_nameBg:SetGray(false)
        tb.obj_bgeff:SetActiveE(1)
    end

    tb.aortext_Name.text = _G.GetLangPackValue(data.Name)
    tb.aortext_Desc.text = _G.GetLangPackValue(data.Describe)
end

---item点击事件
function DungeonChallengeHallView:OnClick_item(itemGoTable, isOn, data)
    local isOpen = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(
        data.function_open
    )

    if not isOpen then
        return
    end

    if data.Item_name ~= "" then
        if data.Item_name == _G.ConfigManager.ui_cfg.DungeonChallengeBattleView.Name and 
            _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        --if data.Item_name == "DungeonChallengeBattleView" then
            self:Close()
        --end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg[data.Item_name].Name)
    end
end

---按钮点击事件在这里派发
function DungeonChallengeHallView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        local id = _G.AppSetting.IsXzns and 215 or 172
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, id)
    end
end

---界面的销毁函数
function DungeonChallengeHallView:OnDestroy()
    self:RemoveAllListener()
end

return DungeonChallengeHallView
