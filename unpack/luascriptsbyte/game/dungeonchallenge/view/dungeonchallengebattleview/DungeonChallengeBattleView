---初始化对象池
---@return void
function DungeonChallengeBattleView:InitPools()
    self.equipModelPool = ObjectFactory.New(
        function()
            --create
            local instance = _G.InstantiateObject(
                self.go_table.trans_equipModelItem,
                self.go_table.trans_equipModelParent
            )
            instance:SetLocalScaleXYZ(1)
            return _G.GetAutoGoTable(instance)
        end,
        ---@param item DungeonChallengeBattleView._trans_equipModelItem_GoTable
        function(item)
            --active
            item.gameObject:SetActiveE(1)
        end,
        ---@param item DungeonChallengeBattleView._trans_equipModelItem_GoTable
        function(item)
            --release
            item.gameObject:SetActiveE(0)
        end
    )
    self.equipUsablePool = ObjectFactory.New(
        function()
            --create
            local instance = _G.InstantiateObject(
                self.go_table.trans_equipUsableItem,
                self.go_table.trans_equipUsableParent
            )
            instance:SetLocalScaleXYZ(1)
            instance:SetActiveE(1)
            return self:AddComponent(instance, DungeonChallengeBattleView_EquipUsableItem.New(
                instance,
                self.go_table.trans_equipParent --root根节点, 相对此节点计算坐标
            ))
        end,
        ---@param item DungeonChallengeBattleView_EquipUsableItem
        function(item)
            --active
            item.gameObject:SetActiveE(1)
        end,
        ---@param item DungeonChallengeBattleView_EquipUsableItem
        function(item)
            --release
            item.gameObject:SetActiveE(0)
        end
    )
end

---初始化装备拖拽事件
---@return void
function DungeonChallengeBattleView:InitDragHandlers()
    --初始化拖拽模型
    self.equipDragItem = _G.GetAutoGoTable(self.go_table.trans_dragModel)
    self.equipDragItem.gameObject:SetActiveE(0)

    ---当前持有的装备格子
    ---@type DungeonChallengeBattleView_EquipItem, UnityEngine.EventSystems.PointerEventData,{x:number,y:number}
    local holdEquipItem, holdData, holdPositionOffset = nil, nil, { x = 0, y = 0 }
    ---当前持有的装备背包序号
    local holdEquipUsableIndex
    --拖拽过程中, 实时计算占用的装备格
    ---@type DungeonChallengeBattleView_EquipItem[]
    local selectedEquipItems

    local isDrag, pointerDownTime = false, 0
    --记录按下屏幕时的战斗阶段: 处理战斗中按下屏幕丶战斗结束切换为准备阶段
    local pointerStage = Stage.None

    ---获取坐标对应的装备格子
    ---@param localX number
    ---@param localY number
    ---@return DungeonChallengeBattleView_EquipItem
    local function findEquipItem(localX, localY)
        for _, equipItem in ipairs(self.equipItems) do
            if equipItem:ContainsPoint(localX, localY) then
                return equipItem
            end
        end
        return nil
    end
    ---检查选中的装备格子是否符合要求
    ---@param selectedIndex number @选中的装备格子索引
    ---@param data DungeonChallengeEquipData @装备数据
    ---@return DungeonChallengeBattleView_EquipItem[],number,{data:DungeonChallengeEquipData,index:number}[] @占用的装备格子, falg状态, 占用的装备格子数据
    local function checkSelectedEquipItems(selectedIndex, data)
        local items, isOk, isAllEmpty = self:GetEquipAreaItems(selectedIndex, data, true)
        local flag = isOk and
            DungeonChallengeBattleModel.EquipSoltFlags.Ok or
            DungeonChallengeBattleModel.EquipSoltFlags.Error
        local datas = {}
        if isOk and not isAllEmpty then
            --检查格子中是否有多件装备
            local exists = {}
            for _, item in ipairs(items) do
                if item:GetData() and not exists[item:GetData()] then
                    exists[item:GetData()] = true
                    table.insert(datas, {
                        data = item:GetData(),
                        index = self:GetRootEquipIndex(item:GetIndex())
                    })
                    if item:GetData():IsConsume(data) then
                        -- 装备id相同, 可以升级
                        flag = DungeonChallengeBattleModel.EquipSoltFlags.HighLight
                    end
                end
            end
            if flag == DungeonChallengeBattleModel.EquipSoltFlags.HighLight and #datas >= 2 then
                flag = DungeonChallengeBattleModel.EquipSoltFlags.Ok
            end
        end
        return items, flag, datas
    end
    ---检查坐标对应的可用装备Item
    ---@param localX number @装备格子本地X
    ---@param localY number @装备格子本地Y
    ---@return DungeonChallengeBattleView_EquipUsableItem,number
    local function findEquipUsableItem(localX, localY)
        if not self.equipUsableItems then
            return nil, 0
        end
        for i = #self.equipUsableItems, 1, -1 do
            if self.equipUsableItems[i]:ContainsPoint(localX, localY) then
                return self.equipUsableItems[i], i
            end
        end
        return nil, 0
    end
    ---清空状态
    local function clear()
        holdEquipItem = nil
        holdData = nil
        holdEquipUsableIndex = nil
        pointerStage = Stage.None
    end

    --创建滑动事件监听器
    local eventTriggers = self.go_table.trans_dragRoot:GetComponentE(
        _G.typeof(_G.CS.UnityEngine.EventSystems.EventTrigger))
    eventTriggers.triggers:Add(utils.createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerDown,
        function(data)
            if self.isPlayingAnimation then
                return
            end
            --ZHJH-18542【真机】【时空之门】闯关过程中，将装备全部下下来，有低概率丢失重叠的装备，并且报错无法继续游戏
            --真机APP和微信小游戏小概率复现, 猜测可能是bug连续调用了两次PointerDown而没有调用PointerUp
            if holdData then
                return
            end
            local position = data.position
            local localX, localY = utils.screenPointToRectLocalPosition( --转换为装备格子所在的本地坐标系
                self.go_table.trans_equipParent,
                position.x,
                position.y,
                false
            )
            pointerStage = self.stage
            --战斗中查看装备详情
            if self.stage == Stage.Battle then
                local selected = findEquipItem(localX, localY)
                if selected and selected:GetData() then
                    holdData = selected:GetData()
                else
                    if not selected and utils.screenPointInRect(
                            self.go_table.trans_equipUsableParent,
                            position.x,
                            position.y)
                    then
                        local usableItem, usableIndex = findEquipUsableItem(localX, localY)
                        if usableItem then
                            holdData = usableItem:GetData()
                        end
                    end
                end

                --记录拖放状态
                isDrag = false
                pointerDownTime = _G.Time.unscaledTime
                return
            end

            --计算当前选中的格子
            local selected = findEquipItem(localX, localY)
            if selected and selected:GetData() then
                holdEquipItem = self:GetRootEquipItem(selected:GetIndex()) --获取真实装备格子(在卸载之前)
                holdData = selected:GetData()
                self:UninstallEquip(selected:GetIndex())                   --卸载装备格子, 之后将模型创建出来
            end

            --是否点击装备背包
            holdEquipUsableIndex = nil
            if not selected and utils.screenPointInRect(
                    self.go_table.trans_equipUsableParent,
                    position.x,
                    position.y)
            then
                local usableItem, usableIndex = findEquipUsableItem(localX, localY)
                if usableItem then
                    holdData = usableItem:GetData()
                    holdEquipUsableIndex = usableIndex
                    self:RemoveEquipUsableItemAt(usableIndex)
                end
            end

            if holdData and self.stage == Stage.BattleEquip then
                --计算当前装备中心点与root格子偏移值
                local items = self:GetEquipAreaItems(1, holdData, false)
                if items and #items > 0 then
                    local centerX, centerY = self:GetEquipAreaCenterPosition(items)
                    local rootPosX, rootPosY = items[1]:GetPosition()
                    holdPositionOffset.x = rootPosX - centerX
                    holdPositionOffset.y = rootPosY - centerY
                else
                    holdPositionOffset.x = 0
                    holdPositionOffset.y = 0
                end

                --显示拖拽模型
                self.equipDragItem.gameObject:SetActiveE(1)
                self.equipDragItem.gameObject:SetLocalPosition(localX, localY, 0)
                self:UpdateEquipModel(self.equipDragItem, holdData, false)
            end

            --记录拖放状态
            isDrag = false
            pointerDownTime = _G.Time.unscaledTime
        end)
    )
    eventTriggers.triggers:Add(utils.createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.Drag,
        function(data)
            if self.isPlayingAnimation then
                return
            end
            if not holdData or self.stage ~= Stage.BattleEquip or self.stage ~= pointerStage then
                return
            end
            local position = data.position
            local localX, localY = utils.screenPointToRectLocalPosition(
                self.go_table.trans_equipParent,
                position.x,
                position.y,
                false
            )
            --更新拖拽模型
            self.equipDragItem.gameObject:SetLocalPosition(localX, localY, 0)
            --还原上一次格子的选中状态
            if selectedEquipItems then
                for _, equipItem in ipairs(selectedEquipItems) do
                    equipItem:SetFlag(DungeonChallengeBattleModel.EquipSoltFlags.Normal)
                    equipItem:Update()
                end
                selectedEquipItems = nil
            end

            --计算当前选中的格子
            local selected = findEquipItem(localX + holdPositionOffset.x, localY + holdPositionOffset.y)
            if selected then
                local items, flag = checkSelectedEquipItems(selected:GetIndex(), holdData)
                --选中的格子高亮显示
                if items then
                    for _, equipItem in ipairs(items) do
                        equipItem:SetFlag(flag)
                        equipItem:Update()
                    end
                end
                selectedEquipItems = items
            end

            --记录拖放状态
            isDrag = true
        end)
    )
    eventTriggers.triggers:Add(utils.createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerUp,
        function(data)
            if self.isPlayingAnimation then
                clear()
                return
            end
            if not holdData or self.stage == Stage.Prepare or self.stage ~= pointerStage then
                clear()
                return
            end
            --战斗中查看装备详情
            if self.stage == Stage.Battle then
                if not isDrag and _G.Time.unscaledTime - pointerDownTime < 0.2 then
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.DungeonChallengeEquipTipView.Name,
                        { holdData.cfg }
                    )
                end
                --清空状态
                clear()
                return
            end

            local position = data.position
            local localX, localY = utils.screenPointToRectLocalPosition(
                self.go_table.trans_equipParent,
                position.x,
                position.y,
                false
            )
            --移除拖拽模型
            self.equipDragItem.gameObject:SetActiveE(0)
            --还原上一次格子的选中状态
            if selectedEquipItems then
                for _, equipItem in ipairs(selectedEquipItems) do
                    equipItem:SetFlag(DungeonChallengeBattleModel.EquipSoltFlags.Normal)
                    equipItem:Update()
                end
                selectedEquipItems = nil
            end

            --计算当前选中的格子
            local selected = findEquipItem(localX + holdPositionOffset.x, localY + holdPositionOffset.y)
            local selectedDatas
            if selected then
                --检查是否符合装备要求
                local _, flag, datas = checkSelectedEquipItems(selected:GetIndex(), holdData)
                selectedDatas = datas
                if flag ~= DungeonChallengeBattleModel.EquipSoltFlags.Ok and
                    flag ~= DungeonChallengeBattleModel.EquipSoltFlags.HighLight then
                    selected = nil
                    selectedDatas = nil
                end
            end
            if selected then
                --已选中格子: 替换装备, 旧装备替换位置或放回背包
                if selectedDatas and #selectedDatas == 1 and selectedDatas[1].data:IsConsume(holdData) then
                    --装备升级操作
                    --还原装备
                    if holdEquipItem then
                        self:InstallEquip(holdEquipItem:GetIndex(), holdData)
                    else
                        self:AddEquipUsableItem(holdData, holdEquipUsableIndex)
                    end
                    --升级操作
                    self.model:SetChangeEquip(true) --标记强制同步一次
                    self:UpgradeEquip(selectedDatas[1].data, holdData)
                    --self:UninstallEquip(selectedDataIndex)
                    holdData = nil
                    selectedDatas = nil
                elseif selectedDatas and #selectedDatas > 0 then
                    --卸载旧装备, 安装新装备
                    for _, d in ipairs(selectedDatas) do
                        self:UninstallEquip(d.index)
                    end
                    self:InstallEquip(selected:GetIndex(), holdData)
                    --记录装备状态
                    self.model:SetChangeEquip(true)
                else
                    self:InstallEquip(selected:GetIndex(), holdData)
                    --记录装备状态
                    self.model:SetChangeEquip(true)
                end

                --将旧装备放回到格子或背包中
                if selectedDatas and #selectedDatas > 0 then
                    --寻找空位放回
                    for i = #selectedDatas, 1, -1 do
                        for index, _ in ipairs(self.equipItems) do
                            local _, isOk, isAllEmpty = self:GetEquipAreaItems(index, selectedDatas[i].data, true)
                            if isOk and isAllEmpty then
                                self:InstallEquip(index, selectedDatas[i].data)
                                table.remove(selectedDatas, i)
                                break
                            end
                        end
                    end
                    --装备失败, 尝试放入背包
                    if #selectedDatas > 0 then
                        --放入背包
                        for _, d in ipairs(selectedDatas) do
                            self:AddEquipUsableItem(d.data, holdEquipUsableIndex)
                        end
                        self:SortEquipUsableItems()
                    end
                end

                --装备成功, 且是从背包拖上去的, 排序背包
                if (not selectedDatas or #selectedDatas == 0) and not holdEquipItem then
                    self:SortEquipUsableItems()
                end
            else
                --未选中格子: 检查是否放回背包, 或还原位置
                local inEquipUsableRect = utils.screenPointInRect(
                    self.go_table.trans_equipUsableParent,
                    position.x,
                    position.y
                )
                if inEquipUsableRect or not holdEquipItem then
                    ---@type DungeonChallengeEquipData
                    local swapEquipData
                    --重新拖放回背包, 寻找合适的位置
                    if inEquipUsableRect and self.equipUsableItems then
                        local tempIndex = 1
                        for index, item in ipairs(self.equipUsableItems) do
                            local x = item:GetPosition()
                            if item:ContainsPoint(localX, localY) then
                                swapEquipData = item:GetData()
                                if holdEquipUsableIndex and holdEquipUsableIndex > 0 and holdEquipUsableIndex <= index then
                                    tempIndex = index + 1 --将左边的装备移动到右边: 开始拖动时holdEquipUsableIndex已经从列表中移除, 因此需额外+1
                                else
                                    tempIndex = index
                                end
                                break
                            elseif x < localX then
                                tempIndex = index + 1
                            else
                                break
                            end
                        end
                        holdEquipUsableIndex = tempIndex
                    end

                    --放入背包
                    self:AddEquipUsableItem(holdData, holdEquipUsableIndex)
                    self:SortEquipUsableItems()
                    --记录装备状态
                    self.model:SetChangeEquip(true)

                    --升级操作: 在临时背包内进行
                    if swapEquipData and swapEquipData ~= holdData and swapEquipData:IsConsume(holdData) then
                        --升级操作
                        self.model:SetChangeEquip(true) --标记强制同步一次
                        self:UpgradeEquip(swapEquipData, holdData)
                        holdData = nil
                    end
                else
                    --还原位置
                    self:InstallEquip(holdEquipItem:GetIndex(), holdData)
                end
            end

            --如果是点击装备
            if holdData and not isDrag and _G.Time.unscaledTime - pointerDownTime < 0.2 then
                --弹出装备详情
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.DungeonChallengeEquipTipView.Name,
                    { holdData.cfg }
                )
            end

            --显示战力change tip
            self:UpdatePower(true)

            --清空状态
            clear()
        end)
    )
end

---初始化装备格子
---@return void
function DungeonChallengeBattleView:InitEquipItems()
    self.go_table.trans_equipItem:SetActiveE(0)

    self.equipItems = {}
    for index = 1, ROW * COLUMN do
        local instance = _G.InstantiateObject(
            self.go_table.trans_equipItem,
            self.go_table.trans_equipParent
        )
        instance:SetActiveE(1)
        if _G.AppSetting.DEBUG then
            instance:SetName(index)
        end
        local item = self:AddComponent(instance, DungeonChallengeBattleView_EquipItem.New(
            instance,
            index,
            self.go_table.trans_equipParent --root根节点, 相对此节点计算坐标
        ))
        table.insert(self.equipItems, item)
    end
end

