--工具类
local utils = {
    ---将屏幕坐标转换为RectTransform本地坐标
    ---@param rectTransform UnityEngine.RectTransform 目标RectTransform
    ---@param x number 屏幕坐标X
    ---@param y number 屏幕坐标Y
    ---@param ignorePivot? boolean 是否忽略pivot影响, 默认false
    ---@return number,number @x,y
    screenPointToRectLocalPosition = function(rectTransform, x, y, ignorePivot)
        local _, localPosition = _G.CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(
            rectTransform,
            _G.Vector2.New(x, y),
            _G.UIManager:GetInstance().UICamera
        )
        local x, y = localPosition.x, localPosition.y
        --修正pivot影响
        if ignorePivot then
            local pointX, pointY = rectTransform:GetPivotPosition()
            local width, height = rectTransform:GetRectTransformWidthHeight()
            y = y + (pointY - 0.5) * height
            x = x + (pointX - 0.5) * width
        end
        return x, y
    end,
    ---屏幕坐标是否在RectTransform内
    ---@param rectTransform UnityEngine.RectTransform 目标RectTransform
    ---@param x number 屏幕坐标X
    ---@param y number 屏幕坐标Y
    ---@return boolean
    screenPointInRect = function(rectTransform, x, y)
        local _, localPosition = _G.CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(
            rectTransform,
            _G.Vector2.New(x, y),
            _G.UIManager:GetInstance().UICamera
        )
        local x, y = localPosition.x, localPosition.y
        --修正pivot影响
        local pointX, pointY = rectTransform:GetPivotPosition()
        local width, height = rectTransform:GetRectTransformWidthHeight()
        y = y + (pointY - 0.5) * height
        x = x + (pointX - 0.5) * width

        return x >= -width * 0.5 and
            x <= width * 0.5 and
            y >= -height * 0.5 and
            y <= height * 0.5
    end,
    ---创建事件触发条目
    ---@param eventType UnityEngine.EventSystems.EventTriggerType @事件类型
    ---@param callback fun(data:UnityEngine.EventSystems.PointerEventData):void @回调函数
    createTriggerEntry = function(eventType, callback)
        local entry = _G.CS.UnityEngine.EventSystems.EventTrigger.Entry()
        entry.eventID = eventType
        entry.callback:AddListener(callback)
        return entry
    end,
    ---寻找模型挂点
    ---@param trans UnityEngine.Transform
    ---@param forceUpdate? boolean   是否立即更新骨骼位置
    ---@return UnityEngine.Transform
    findModelPoint = function(trans, forceUpdate)
        local rp = trans:GetComponentInChildrenE(_G.typeof(_G.CS.SkeletonBoneReferences))
        if not rp then
            return nil
        end
        local node = rp:Get("Point_Hp")
        if not _G.IsNil(node) then
            rp:ForceUpdate(0) --立即同步一次骨骼位置
            return node
        end
        local node = rp:Get("Point_Head")
        if not _G.IsNil(node) then
            rp:ForceUpdate(0) --立即同步一次骨骼位置
            return node
        end
        return nil
    end,
    ---播放模型的stand2动画(如果有)
    ---@param trans UnityEngine.Transform
    playModelStand2 = function(trans)
        local animator = trans:GetComponentInChildrenE(_G.typeof(_G.CS.UnityEngine.Animator))
        if _G.IsNil(animator) then
            return
        end
        animator:Play("stand_2", true)
    end,
    ---获取相机俯视角度
    ---@return number
    getCameraAngleX = function()
        ---@type UnityEngine.Camera
        local mainCamera
        if _G.CS.FrameWork.Graphic.GraphicsManager.Instance then
            mainCamera = _G.CS.FrameWork.Graphic.GraphicsManager.Instance.MainCamera
        end
        return _G.CS.CameraUtils.GetCameraAngleX(mainCamera)
    end,
    ---获取相机控制组件
    ---@param go UnityEngine.Obejct
    ---@return CS.CameraMovement
    getCameraMovement = function(go)
        local component = go:GetComponentE(_G.typeof(_G.CS.CameraMovement))
        if _G.IsNil(component) then
            component = go:AddComponentE(_G.typeof(_G.CS.CameraMovement))
        end
        return component
    end,
}

