---显示战力变化提示
---@param showTip boolean   是否弹出tip窗口
---@private
function DungeonChallengeBattleView:UpdatePower(showTip)
    if self.stage == Stage.Prepare then
        return
    end
    --战力属性
    ---@type AttributeClass
    local attributes = _G.AttributeClass.New()
    attributes:OnInit(nil, nil)

    --卡牌战力
    local roleCfg = _G.ConfigManager.dungeon_challenge_card_cfg[self.model:GetCardSid()]
    if roleCfg then
        for _, attr in pairs(_G.ConfigManager.type_attribute_cfg) do
            attributes:AddValueByID(
                attr.id,
                roleCfg[attr.attribute_type] or 0,
                false,
                attr.value_type == 1 and _G.AttCountType.base or _G.AttCountType.basePercent
            )
        end
    end
    local prop = { atk = 0, bre = 0, def = 0, max_hp = 0 }
    --装备战力
    if self.equipItems then
        for index, item in ipairs(self.equipItems) do
            if item:GetData() and item:GetSolt() == index then
                local equipData = item:GetData()

                prop.atk = prop.atk + equipData.cfg.atk
                prop.bre = prop.bre + equipData.cfg.bre
                prop.def = prop.def + equipData.cfg.def
                prop.max_hp = prop.max_hp + equipData.cfg.max_hp

                for _, attr in pairs(_G.ConfigManager.type_attribute_cfg) do
                    attributes:AddValueByID(
                        attr.id,
                        equipData.cfg[attr.attribute_type] or 0,
                        false,
                        attr.value_type == 1 and _G.AttCountType.base or _G.AttCountType.basePercent
                    )
                end
            end
        end
    end

    _G.UIManager:GetInstance():CloseWindow(
        _G.ConfigManager.ui_cfg.PowerUpView.Name
    )
    local power = attributes:CalculatePower()
    -- if showTip and self.power and self.power ~= power then
    --     _G.UIManager:GetInstance():OpenWindow(
    --         _G.ConfigManager.ui_cfg.PowerUpView.Name,
    --         self.power,
    --         power - self.power
    --     )
    -- end

    if not showTip then
        self.lastProp = prop
    else
        _G.UIUtils.ShowPropUp(nil, self.lastProp, nil, { prop = prop })
        self.lastProp = prop
    end

    self.power = power
end

