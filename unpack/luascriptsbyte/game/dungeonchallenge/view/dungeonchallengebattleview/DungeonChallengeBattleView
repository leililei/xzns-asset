---@param callback? fun(d:DungeonChallengeBattle_RoleData):void    @加载完成回调
---@return void
function DungeonChallengeBattleView:UpdatePrepareRoleModels(callback)
    if self.prepareRoles then
        for _, roleData in ipairs(self.prepareRoles) do
            self:LoadRoleModel(roleData, nil, callback)
            self:LoadShadowModel(roleData)
