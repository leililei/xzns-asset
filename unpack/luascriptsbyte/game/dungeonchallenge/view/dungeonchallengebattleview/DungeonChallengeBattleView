---准备阶段: 刷新关卡列表
---@param index number
---@param go UnityEngine.GameObject
function DungeonChallengeBattleView:OnRefreshChapterTemplate(index, go)
    if not self.chapterItems then
        self.chapterItems = {}
    end

    ---@type DungeonChallengeBattleView._obj_chapterTemplateItem_GoTable
    local item = self.chapterItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        _G.AddViewBtnClick(go, _G.handlerbind(self, self.OnClickChapterBtn, item))
        self.chapterItems[go:GetInstanceIDE()] = item
    end
    index = index + 1

    local data = self.chapterDatas[index]
    local name = _G.GetLangPackValue(data.name)

    item.index = index
    item.aortext_label.text = name
    item.aortext_label2.text = name
    item.aortext_label:SetActiveE(index == self.chapterIndex and 0 or 1)
    item.aortext_label2:SetActiveE(index == self.chapterIndex and 1 or 0)
    item.aorimage_lock:SetActiveE((index > self.model:GetMaxChapterIndex() + 1) and 1 or 0)
end

