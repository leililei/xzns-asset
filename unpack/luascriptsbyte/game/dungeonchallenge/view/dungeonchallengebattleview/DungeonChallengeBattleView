--region ==============================网络请求==============================

--进入关卡挑战
function DungeonChallengeBattleView:Challenge()
    if self:IsNil() then
        return
    end
    local chapterCfg = self.chapterDatas[self.chapterIndex]
    local cardSid = chapterCfg.heroes[self.prepareRoleIndex]
    --选择关卡
    self.model:ChooseChapter(self.chapterIndex, function(msg)
        if not msg or msg.ack ~= 1 or self:IsNil() then
            return
        end
        --选择卡牌
        self.model:ChooseCard(cardSid, function(msg)
            if not msg or msg.ack ~= 1 or self:IsNil() then
                return
            end
            self:LoadBattleEquip()
        end)
    end)
end

--进入战斗
function DungeonChallengeBattleView:Fight()
    self.model:Fight(function(msg)
        if not msg or msg.ack ~= 1 or self:IsNil() then
            return
        end
        self:LoadBattle()

        --进入战斗
        _G.BattleManager:GetInstance():DestroyBattle()
        _G.BattleManager:GetInstance():EnterFight(
            _G.BattleControllerType.DungeonChallenge,
            self.model:GetMonsterGroupId(),
            msg.fight_arg
        )
    end)
end

--endregion

---准备阶段: 选关卡列表点击事件
---@param item DungeonChallengeBattleView._obj_chapterTemplateItem_GoTable|{index:number}
function DungeonChallengeBattleView:OnClickChapterBtn(go, isOn, item)
    if not item.index then
        return
    end
    if item.index > self.model:GetMaxChapterIndex() + 1 then
        --需先通关前置关卡
        _G.PopWindowManager:GetInstance():ShowAllTips(0)
        return
    end

    self.chapterIndex = item.index
    self:LoadPrepare(self.chapterDatas[self.chapterIndex])
    self:SetChapterTemplateActive(false)
end

---准备阶段: 点击人物
---@param item DungeonChallengeBattleView._obj_prepareRoleInfo_GoTable|{data:DungeonChallengeBattle_RoleData}
function DungeonChallengeBattleView:OnClickPrepareRole(go, isOn, item)
    if not item.data then
        return
    end
    if go == item.aorbtn_skill then
        --点击查看技能
        ---@type dungeon_challenge_card_cfg
        local cfg = _G.ConfigManager.dungeon_challenge_card_cfg[item.data.sid]
        if not _G.table.isEmptyOrNil(cfg.skill) and #cfg.skill > 0 then
            require("CommonTipManager"):GetInstance():OpenSkillTip(cfg.skill[1])
        end
    elseif go == item.aorbtn_details then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungeonChallengeRoleTipView.Name,
            item.data.sid
        )
    elseif go == item.aorbtn_click then
        --点击选人
        local beforeRoleIndex = self.prepareRoleIndex
        if self.prepareRoleInfos then
            for i, node in ipairs(self.prepareRoleInfos) do
                node.obj_flag:SetActiveE(item == node and 1 or 0)
                node.obj_effect:SetActiveE(item == node and 1 or 0) --选中特性
                if item == node then
                    self.prepareRoleIndex = i
                end
            end
        end

        if beforeRoleIndex == self.prepareRoleIndex then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DungeonChallengeRoleTipView.Name,
                item.data.sid
            )
        end
    end
end

---按钮点击事件在这里派发
function DungeonChallengeBattleView:OnClickBtn(go, isOn)
    if self.isPlayingAnimation then
        --播放动画期间, 不允许用户操作
        return
    end
    if go == self.go_table.aorbtn_CloseView then
        if self.stage ~= Stage.Prepare then
            _G.BattleManager:GetInstance():SetBattlePause(true)
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1140004,
                nil,
                function()
                    _G.BattleManager:GetInstance():SetBattlePause(false)
                    _G.WorldManager:GetInstance():DestoryRoleParent()
                    _G.BattleManager:GetInstance():DestroyBattle()

                    local function clear()
                        --清空人物模型丶背包装备
                        self:ClearRoleModels(true)
                        self:ClearEquipUsableItems()
                        self:ClearEquipItems()

                        --初始化关卡
                        self.chapterIndex = math.min(self.model:GetMaxChapterIndex() + 1, #self.chapterDatas)
                        self:LoadPrepare(self.chapterDatas[self.chapterIndex])
                    end

                    if self.model:IsChallenging() then
                        self.model:ResetChapter(clear)
                    else
                        clear()
                    end
                end,
                function()
                    _G.BattleManager:GetInstance():SetBattlePause(false)
                end
            )
        else
            self:Close()
            --打开上级页面
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DungeonChallengeHallView.Name
            )
        end
    elseif go == self.go_table.aorbtn_reset then
        if self.model:IsChallenging() then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1140004,
                nil,
                function()
                    self.model:ResetChapter(function(msg)
                        --清空人物模型丶背包装备
                        self:ClearRoleModels(true)
                        self:ClearEquipUsableItems()
                        self:ClearEquipItems()

                        --初始化关卡
                        self.chapterIndex = math.min(self.model:GetMaxChapterIndex() + 1, #self.chapterDatas)
                        self:LoadPrepare(self.chapterDatas[self.chapterIndex])
                    end)
                end,
                function()

                end
            )
        end
    elseif go == self.go_table.aorbtn_battle then
        self.isClickBattleBtn = true
        if self.stage == Stage.Prepare then
            --进入关卡
            if self.model:IsChallenging() then
                self.model:ResetChapter(function(msg)
                    if not msg or msg.ack ~= 1 then
                        return
                    end
                    --清空人物模型丶背包装备
                    self:ClearRoleModels(true)
                    self:ClearEquipUsableItems()
                    self:ClearEquipItems()

                    --初始化关卡数据状态
                    self.chapterIndex = math.min(self.model:GetMaxChapterIndex() + 1, #self.chapterDatas)
                    self.prepareRoleIndex = 1

                    self:Challenge()
                end)
            else
                self:Challenge()
            end
        elseif self.stage == Stage.BattleEquip then
            --开始战斗
            if self.model:IsChangedEquip() then
                --如果需要同步装备状态, 先执行同步
                self:SynchronizeEquips(_G._G.handlerbind(self, self.Fight))
            else
                self:Fight()
            end
        end
    elseif go == self.go_table.aorbtn_details then
        local cardSid, cardEquips
        if self.stage == Stage.Prepare then
            cardSid = self.chapterDatas[self.chapterIndex].heroes[self.prepareRoleIndex]
        else
            cardSid = self.model:GetCardSid()
            if self.equipItems then
                cardEquips = {}
                for index, item in ipairs(self.equipItems) do
                    if item:GetData() and item:GetSolt() == index then
                        table.insert(cardEquips, item:GetData())
                    end
                end
            end
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungeonChallengeRoleTipView.Name,
            cardSid,
            cardEquips
        )
    elseif go == self.go_table.aorbtn_chapter then
        self:SetChapterTemplateActive(true)
    elseif go == self.go_table.aorbtn_chapterTemplateBlocker then
        self:SetChapterTemplateActive(false)
    elseif go == self.go_table.aorbtn_task then
        ---任务
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungeonChallengeTaskView.Name
        )
    elseif go == self.go_table.aorbtn_illustration then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungeonChallengeIllustrationView.Name)
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GamePlayDescribeView.Name,
            215
        )
    end
end

