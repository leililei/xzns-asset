---获取装备所需格子
---@param index number 装备格子索引(实际安装的位置)
---@param data DungeonChallengeEquipData
---@param checkEmpty? boolean 检查格子是否为空
---@return DungeonChallengeBattleView_EquipItem[], boolean,boolean @装备格子, 是否可以成功安装, 是否所有格子都为空
function DungeonChallengeBattleView:GetEquipAreaItems(index, data, checkEmpty)
    local width, height = data:GetSize()

    local baseX = index % ROW
    local baseY = math.ceil(index / ROW)
    if baseX == 0 then
        baseX = ROW
    end

    local results, ok, isAllEmpty = {}, true, false
    for r = 1, width do
        for c = 1, height do
            local x, y = baseX + r - 1, baseY + c - 1
            --检查格子范围是否安全
            if x >= 1 and x <= ROW and y >= 1 and y <= COLUMN then
                local index = (y - 1) * ROW + x
                table.insert(results, self.equipItems[index])
            else
                ok = false
                -- if _G.AppSetting.DEBUG then
                --     _G.LogError(string.format(
                --         "装备格子索引超出范围: id= %s , index = %s(%s,%s), x = %s, y = %s",
                --         data.id,
                --         index,
                --         baseX,
                --         baseY,
                --         x,
                --         y
                --     ))
                -- end
            end
        end
    end

    if checkEmpty and #results > 0 then
        isAllEmpty = true
        for i = 1, #results do
            if results[i]:GetData() then
                isAllEmpty = false
                break
            end
        end
    end
    return results, ok, isAllEmpty
end

---获取装备格子区域中心位置
---@param items DungeonChallengeBattleView_EquipItem[] @装备格子
---@return number,number @中心位置X, 中心位置Y
function DungeonChallengeBattleView:GetEquipAreaCenterPosition(items)
    if not items or #items == 0 then
        return 0, 0
    end

    local xMin, xMax, yMin, yMax = 9999, -9999, 9999, -9999
    for _, item in ipairs(items) do
        local x, y = item:GetPosition()
        xMin = math.min(xMin, x)
        xMax = math.max(xMax, x)
        yMin = math.min(yMin, y)
        yMax = math.max(yMax, y)
    end
    return (xMin + xMax) * 0.5, (yMin + yMax) * 0.5
end

---获取装备实际安装的格子
---@param index number 装备格子索引(装备的任意插槽)
---@return DungeonChallengeBattleView_EquipItem @装备格子
function DungeonChallengeBattleView:GetRootEquipItem(index)
    local item = self.equipItems[index]
    if not item or not item:GetData() then
        return item
    end

    if item:GetSolt() ~= index then
        local newItem = self.equipItems[item:GetSolt()] --取实际装备的节点
        if newItem and newItem:GetData() == item:GetData() then
            item = newItem
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(string.format(
                    "装备格子数据异常: id= %s , index = %s",
                    item:GetData() and item:GetData().id or nil,
                    item:GetSolt()
                ))
                self:PrintEquipSlots()
            end
        end
    end
    return item
end

---获取装备实际安装的格子索引
---@param index number 装备格子索引(装备的任意插槽)
---@return number
function DungeonChallengeBattleView:GetRootEquipIndex(index)
    local item = self:GetRootEquipItem(index)
    if item then
        return item:GetIndex()
    end
    return index
end

---获取装备格子数据
---@param index number 装备格子索引(装备的任意插槽)
---@return DungeonChallengeEquipData,number   @装备数据,装备的插槽索引(实际安装的位置)
function DungeonChallengeBattleView:GetEquipData(index)
    local rootEquipItem = self:GetRootEquipItem(index)
    local item = self.equipItems[index]
    if not rootEquipItem or not rootEquipItem:GetData() then
        return nil
    end
    return rootEquipItem:GetData(), rootEquipItem:GetSolt()
end

---(安装)设置装备格子数据
---@param index number 装备格子索引(实际安装的位置)
---@param data DungeonChallengeEquipData
function DungeonChallengeBattleView:InstallEquip(index, data)
    local items = self:GetEquipAreaItems(index, data, false)
    if not items or #items == 0 then
        return
    end

    for _, item in ipairs(items) do
        if _G.AppSetting.DEBUG then
            if item:GetData() then
                _G.LogError(string.format(
                    "装备格子数据已占用: id= %s , index = %s, errorIndex = %s",
                    data.id,
                    index,
                    item:GetIndex()
                ))
                self:PrintEquipSlots()
            end
        end
        item:SetData(data)
        item:SetSolt(index) --插槽状态, 改为实际安装位置
        item:Update()
    end

    --装备模型信息
    ---@type DungeonChallengeBattleView._trans_equipModelItem_GoTable
    local modelItem = self.equipModelPool:Get()
    local cx, cy = self:GetEquipAreaCenterPosition(items)
    modelItem.gameObject:SetLocalPosition(cx, cy, 0)
    self:UpdateEquipModel(modelItem, data, data.cfg.quality >= 7)

    --关联模型(默认放在第一个节点)
    items[1]:BindModel(modelItem)
end

---(卸载)设置装备格子数据
---@param index number 装备格子索引(装备的任意插槽)
function DungeonChallengeBattleView:UninstallEquip(index)
    local item = self.equipItems[index]
    if not item or not item:GetData() then
        return
    end
    local data = item:GetData()
    index = item:GetSolt() --真实安装位置

    local items = self:GetEquipAreaItems(index, data, false)
    if _G.AppSetting.DEBUG then
        local isAnyError = false
        for _, item in ipairs(items) do
            if item:GetData() ~= data then
                isAnyError = true
                _G.LogError(string.format(
                    "装备格子数据异常: id= %s , index = %s",
                    item:GetData() and item:GetData().id or nil,
                    index
                ))
            end
        end
        if isAnyError then
            self:PrintEquipSlots()
        end
    end
    for _, item in ipairs(items) do
        item:SetData(nil)
        item:SetSolt(DungeonChallengeBattleModel.EquipSolts.None) --插槽状态, 改为可使用
        item:Update()

        --回收模型数据
        if item:GetModel() then
            self.equipModelPool:Release(item:GetModel())
            item:BindModel(nil)
        end
    end
end

---更新并显示装备模型
---@param modelItem DungeonChallengeBattleView._trans_equipModelItem_GoTable| DungeonChallengeBattleView._trans_dragModel_GoTable @装备模型Item
---@param data DungeonChallengeEquipData @装备数据
---@param showAreaEffect boolean @是否显示装备氛围特效
function DungeonChallengeBattleView:UpdateEquipModel(modelItem, data, showAreaEffect)
    modelItem.aorrawimage_icon.color = _G.Color.New(1, 1, 1, 0)
    modelItem.aorrawimage_icon:LoadImage(data:GetModel(), function(img)
        if not img then
            return
        end
        img:SetNativeSize()
        local x, y, angle = data:GetModelParams()
        modelItem.aorrawimage_icon:SetLocalScale(x, y, 1)
        modelItem.aorrawimage_icon:SetLocalEulerAngles(0, 0, angle)
        --modelItem.aorrawimage_icon.color = _G.Color.New(1, 1, 1, 1)
    end)

    --更新装备氛围特效
    local effectCfg = showAreaEffect and data:GetAreaEffect() or nil
    if modelItem.__effectCfg ~= effectCfg then
        modelItem.__effectCfg = effectCfg
        --清理模型缓存
        if modelItem.__effectModel then
            _G.DestroyObject(modelItem.__effectModel)
            modelItem.__effectModel = nil
        end
        --加载新的模型
        if effectCfg then
            _G.UIUtils.LoadEffectByCfg(
                effectCfg,
                modelItem.trans_effect,
                function(trans)
                    if self:IsNil() or modelItem.__effectCfg ~= effectCfg or modelItem.__effectModel then
                        _G.DestroyObject(trans)
                        return
                    end
                    modelItem.__effectModel = trans
                end
            )
        end
    else
        if modelItem.__effectModel then
            modelItem.__effectModel:SetActiveE(0)
            modelItem.__effectModel:SetActiveE(1)
        end
    end
end

---清空装备格子(数据/模型)
---@return void
function DungeonChallengeBattleView:ClearEquipItems()
    for _, item in ipairs(self.equipItems) do
        item:BindModel(nil)
        item:SetData(nil)
        item:SetSolt(DungeonChallengeBattleModel.EquipSolts.None) --插槽状态, 改为可使用
        item:Update()
    end

    self.equipModelPool:ReleaseAll() --回收所有模型
end

---打印装备格子状态(仅DEBUG下调用)
---@private
---@return void
function DungeonChallengeBattleView:PrintEquipSlots()
    local strings = { "\n" }
    for c = 1, COLUMN do
        for r = 1, ROW do
            if r > 1 then
                table.insert(strings, ", ")
            end
            local index = (c - 1) * ROW + r
            local state = self.equipItems[index]:GetSolt() or DungeonChallengeBattleModel.EquipSolts.None
            table.insert(strings, state) --table.concat将自动转为字符串
        end
        table.insert(strings, "\n")
    end
    _G.LogError(table.concat(strings, "\t"))
end

---添加装备数据到背包
---@param data DungeonChallengeEquipData
function DungeonChallengeBattleView:AddEquipUsableItem(data, index, isBattleEnd)
    if not self.equipUsableItems then
        self.equipUsableItems = {}
    end

    ---@type DungeonChallengeBattleView_EquipUsableItem

    local item = self.equipUsablePool:Get()
    item:SetData(data)
    item:Update(data)
    if isBattleEnd then
        item.gameObject:SetParentE(self.go_table.obj_FlyList)
        table.insert(self.linshiList, item.gameObject)
    end

    if index and index > 0 and index <= #self.equipUsableItems then
        table.insert(self.equipUsableItems, index, item)
    else
        table.insert(self.equipUsableItems, item)
    end
end

---从装备背包移除数据(根据索引)
---@param index number @装备格子索引
function DungeonChallengeBattleView:RemoveEquipUsableItemAt(index)
    if not self.equipUsableItems or #self.equipUsableItems == 0 then
        return
    end
    if index < 1 or index > #self.equipUsableItems then
        return
    end
    self.equipUsablePool:Release(self.equipUsableItems[index])
    table.remove(self.equipUsableItems, index)
end

---排序装备背包物品位置
---@return void
function DungeonChallengeBattleView:SortEquipUsableItems()
    if not self.equipUsableItems or #self.equipUsableItems == 0 then
        return
    end
    --父容器宽度
    local pWidth, pHeight = self.go_table.trans_equipUsableParent:GetRectTransformWidthHeight()

    ---@type {items:DungeonChallengeBattleView_EquipUsableItem[], offset:number, spacing:number}[]
    local groups = {}
    ---添加一组装备到排序组
    ---@param groups {items:DungeonChallengeBattleView_EquipUsableItem[], offset:number, spacing:number}[]
    ---@param list DungeonChallengeBattleView_EquipUsableItem[]
    ---@param pWidth number @父容器宽度
    local function addToGroup(groups, list, pWidth)
        if not list or #list == 0 then
            return
        end
        local offset, spacing = 0, 0
        local w = 0
        for _, item in ipairs(list) do
            w = w + item:GetSize()
        end
        if w < pWidth then
            spacing = (pWidth - w) / #list
            if spacing <= BAG_MAX_SPACING then
                offset = spacing * 0.5
            else
                spacing = BAG_MAX_SPACING
                offset = (pWidth - w - spacing * (#list - 1)) * 0.5
            end
        end
        table.insert(groups, { items = list, offset = offset, spacing = spacing })
    end
    --对装备进行分组
    local offset, list = 0, {}
    for _, item in ipairs(self.equipUsableItems) do
        local width = item:GetSize()
        if offset + width > pWidth then
            addToGroup(groups, list, pWidth)
            offset, list = 0, {}
        end
        offset = offset + width + BAG_DEFAULT_SPACING
        table.insert(list, item)
    end
    if #list > 0 then
        addToGroup(groups, list, pWidth)
    end

    --开始放入元素(间隔10个单位)
    for index, group in ipairs(groups) do
        local offset = index == 1 and group.offset or 0 --第一组, 才居中排列
        for _, item in ipairs(group.items) do
            local width = item:GetSize()
            item.transform:SetLocalPosition(
                offset + width * 0.5 - pWidth * 0.5, --元素以父容器左中点对齐
                pHeight * 0.5,
                0
            )
            item:ResetPosition()
            item.gameObject:SetAsLastSiblingE()
            offset = offset + width + group.spacing
        end
    end

    -- local layoutGroup = self[self.go_table.trans_equipUsableParent]
    -- if not layoutGroup then
    --     layoutGroup = self.go_table.trans_equipUsableParent:GetComponentE(
    --         _G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
    --     self[self.go_table.trans_equipUsableParent] = layoutGroup
    -- end
    -- layoutGroup.enabled = true
    -- _G.GameUtil.ReBuildRTF(self.go_table.trans_equipUsableParent)
    -- layoutGroup.enabled = false
end

