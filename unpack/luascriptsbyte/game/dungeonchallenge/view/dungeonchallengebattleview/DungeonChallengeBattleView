---更新所有角色模型(进攻/防守)
---@return void
function DungeonChallengeBattleView:UpdateRoleModels()
    if self.attackRoles then
        for _, roleData in ipairs(self.attackRoles) do
            self:LoadRoleModel(roleData)
            self:LoadShadowModel(roleData)
        end
    end
    if self.defenceRoles then
        for _, roleData in ipairs(self.defenceRoles) do
            self:LoadRoleModel(roleData)
            self:LoadShadowModel(roleData)
        end
    end
end

---移除所有角色模型(进攻/防守)
---@param isRemoveShadow? boolean        是否移除shadow站位阴影, 默认true
---@return void
function DungeonChallengeBattleView:ClearRoleModels(isRemoveShadow)
    if isRemoveShadow == nil then
        isRemoveShadow = true
    end
    if self.attackRoles then
        for _, roleData in ipairs(self.attackRoles) do
            self:RemoveRoleModel(roleData)
            if isRemoveShadow then
                self:RemoveShadowModel(roleData)
            end
        end
    end
    if self.defenceRoles then
        for _, roleData in ipairs(self.defenceRoles) do
            self:RemoveRoleModel(roleData)
            if isRemoveShadow then
                self:RemoveShadowModel(roleData)
            end
        end
    end
end

