---立即同步装备状态至服务器
---@param callback fun() 回调
function DungeonChallengeBattleView:SynchronizeEquips(callback)
    if not self.model:IsChangedEquip() then
        if callback then
            callback()
        end
        return
    end
    ---@type dungeon_challenge.c2s_remove_equip[]
    local equips = {}
    if self.equipItems then
        --穿戴中装备
        for index, item in ipairs(self.equipItems) do
            if item:GetData() and item:GetSolt() == index then
                table.insert(equips, {
                    type = 1,
                    index = index, --装备本位(填充位不管)
                    sid = item:GetData():GetId(),
                })
            end
        end
    end
    if self.equipUsableItems then
        --临时背包装备
        for index, item in ipairs(self.equipUsableItems) do
            table.insert(equips, {
                type = 2,
                index = index,
                sid = item:GetData():GetId(),
            })
        end
    end

    if #equips == 0 then
        self.model:SetChangeEquip(false)
        if callback then
            callback()
        end
        return
    end
    self.model:SynchronizeEquips(equips, function(msg)
        if not msg or msg.ack ~= 1 then
            return
        end
        self.model:SetChangeEquip(false)
        if callback then
            callback()
        end
    end)
end

---装备升级操作
---@param equip1 DungeonChallengeEquipData @装备1
---@param equip2 DungeonChallengeEquipData @装备2
function DungeonChallengeBattleView:UpgradeEquip(equip1, equip2)
    if not equip1:IsConsume(equip2) then
        return
    end
    --如果需要同步装备状态, 先执行同步
    if self.model:IsChangedEquip() then
        self:SynchronizeEquips(_G._G.handlerbind(self, self.UpgradeEquip, equip1, equip2))
        return
    end

    local equip1Data, equip2Data = self:FindEquipDataToProtocol(equip1),
        self:FindEquipDataToProtocol(equip2)

    --如果有多件装备可用, 则弹窗询问
    if #equip1.cfg.merge_equip > 1 then
        local cfgs = {}
        for _, sid in ipairs(equip1.cfg.merge_equip) do
            local cfg = _G.ConfigManager.dungeon_challenge_equip_cfg[sid]
            if cfg then
                table.insert(cfgs, cfg)
            else
                if _G.AppSetting.DEBUG then
                    _G.LogError(string.format("找不到配置表dungeon_challenge_equip_cfg.id=%s", sid))
                end
            end
        end

        --只留下2件装备
        while #cfgs > 2 do
            local index = math.random(1, #cfgs)
            table.remove(cfgs, index)
        end

        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DungeonChallengeEquipTipView.Name,
            cfgs,
            function(cfg)
                if self:IsNil() then
                    return
                end
                local newEquipSid = cfg.id
                self.model:ConflateEquip(equip1Data, equip2Data, newEquipSid, function(msg)
                    if not msg or msg.ack ~= 1 or self:IsNil() then
                        return
                    end
                    self:ParseProtocolData(true, newEquipSid, equip1Data, equip2Data)
                end)
            end
        )
    else
        local newEquipSid = equip1.cfg.merge_equip[1]
        self.model:ConflateEquip(equip1Data, equip2Data, newEquipSid, function(msg)
            if not msg or msg.ack ~= 1 or self:IsNil() then
                return
            end
            self:ParseProtocolData(true, newEquipSid, equip1Data, equip2Data)
        end)
    end
end

---查找DungeonChallengeEquipData转dungeon_challenge.i_equip
---@private
---@param d DungeonChallengeEquipData
---@return dungeon_challenge.i_equip
function DungeonChallengeBattleView:FindEquipDataToProtocol(d)
    if self.equipItems then
        for _, item in ipairs(self.equipItems) do
            if item:GetData() == d then
                return {
                    type = 1,
                    index = self:GetRootEquipIndex(item:GetIndex()),
                    sid = item:GetData():GetId(),
                }
            end
        end
    end
    if self.equipUsableItems then
        for index, item in ipairs(self.equipUsableItems) do
            if item:GetData() == d then
                return {
                    type = 2,
                    index = index,
                    sid = item:GetData():GetId(),
                }
            end
        end
    end
    return nil
end

---解析并移除dungeon_challenge.i_equip数据, 并添加新装备实例
---@private
---@param playEffect boolean    是否播放合成特效
---@param newEquipSid number
---@param ... dungeon_challenge.i_equip
function DungeonChallengeBattleView:ParseProtocolData(playEffect, newEquipSid, ...)
    local isChangeUsable = false
    local lastUsablePosition = nil --缓存记录usableItem位置, 之后播放特效需要使用

    --卸载旧装备
    ---@type dungeon_challenge.i_equip[]
    local datas = { ... }
    table.sort(datas, function(a, b)
        return a.index > b.index --index排序从大到小
    end)
    for _, d in ipairs(datas) do
        if d.type == 1 then
            self:UninstallEquip(d.index)
        else
            local item = self.equipUsableItems and self.equipUsableItems[d.index]
            if item then
                lastUsablePosition = { item:GetPosition() }
            end
            self:RemoveEquipUsableItemAt(d.index)
            isChangeUsable = true
        end
    end

    --添加新装备
    local newEquipInfo = ... --取第一个装备的位置信息
    ---@type DungeonChallengeEquipData
    local newEquipData = DungeonChallengeEquipData.New(_G.ConfigManager.dungeon_challenge_equip_cfg[newEquipSid])
    local function completed()
        if newEquipInfo.type == 1 then
            self:InstallEquip(newEquipInfo.index, newEquipData)
        else
            --临时背包栏中合成装备时, 有装备1/2/3, 装备1和2进行合成, 合成后的装备序号应该还是1号位
            --但如果是拖放1->2进行合成, 这里的newEquipInfo.index = 2, 且装备1/2已经从equipUsableItems中移除, 导致新装备错误的安装到2号位上
            local index = newEquipInfo.index
            for _, d in ipairs(datas) do
                if d.type ~= 1 and d.index < index then
                    index = index - 1
                    break
                end
            end
            self:AddEquipUsableItem(newEquipData, newEquipInfo.index)
            isChangeUsable = true
        end

        if isChangeUsable then
            self:SortEquipUsableItems()
        end
        self:UpdatePower(true)
    end

    --装备合成特效
    local conflateEffectCfg = playEffect and EquipConflateEffects[newEquipData.cfg.quality] and
        _G.ConfigManager.ui_effect_cfg[EquipConflateEffects[newEquipData.cfg.quality]]
    if conflateEffectCfg then
        --创建模型状态
        ---@type DungeonChallengeBattleView._trans_equipModelItem_GoTable
        local modelItem = self.equipModelPool:Get()
        self:UpdateEquipModel(modelItem, newEquipData, false)
        --模型位置信息
        if newEquipInfo.type == 1 then
            local items = self:GetEquipAreaItems(newEquipInfo.index, newEquipData)
            local cx, cy = self:GetEquipAreaCenterPosition(items)
            modelItem.gameObject:SetLocalPosition(cx, cy, 0)
        else
            if lastUsablePosition then
                modelItem.gameObject:SetLocalPosition(lastUsablePosition[1], lastUsablePosition[2], 0)
            end
        end
        --模型特效(将自动销毁)
        _G.UIUtils.LoadEffectByCfg(conflateEffectCfg, modelItem.trans_effect)

        modelItem.transform:DOKill()
        modelItem.transform:SetLocalScaleXYZ(1)

        --放大缩小动画
        local tweener = modelItem.transform:DOBlendableScaleBy(_G.Vector3(1.1, 1.1, 1.1), 0.3)
        tweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
        tweener:SetLoops(2, _G.CS.DG.Tweening.LoopType.Yoyo)
        tweener:SetTarget(modelItem.transform)
        self.isPlayingAnimation = true
        tweener:OnComplete(function()
            if self:IsNil() then
                return
            end
            completed();
            self.isPlayingAnimation = false
            self.equipModelPool:Release(modelItem)
        end)
    else
        completed();
        if _G.AppSetting.DEBUG and playEffect then
            _G.LogError("找不到装备合成特效: " .. tostring(newEquipData.cfg.quality))
        end
    end
end

