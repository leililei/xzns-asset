    end
end

---准备阶段: 移除所有角色模型(战前选人)
---@param isRemoveShadow? boolean        是否移除shadow站位阴影, 默认true
---@return void
function DungeonChallengeBattleView:ClearPrepareRoleModels(isRemoveShadow)
    if self.prepareRoles then
        for _, roleData in ipairs(self.prepareRoles) do
            self:RemoveRoleModel(roleData)
            if isRemoveShadow then
                self:RemoveShadowModel(roleData)
            end
        end
    end
end

---初始化加载场景
---@param mgCfg monster_group_cfg @怪物组配置
---@param callback? function    @加载完成回调
function DungeonChallengeBattleView:LoadScene(mgCfg, callback)
    --目标场景与加载中场景相同, 不再重复加载
    if mgCfg and mgCfg.ScenePath == self.scenePath then
        return
    end

    self:RemoveScene(false)
    if not mgCfg then
        return
    end
    --创建场景根节点
    if not self.sceneRoot then
        self.sceneRoot = _G.CS.UnityEngine.GameObject("DungeonChallengeSceneRoot")
        self.sceneRoot:SetPosition(0, 0, 0)
        --隐藏界面其他UI
        --_G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
    end

    local path = mgCfg.ScenePath
    local cameraPath = _G.string.IsNullOrEmpty(mgCfg.EmbattleCamera) and mgCfg.BattleCamera or mgCfg.EmbattleCamera
    self.scenePath = path
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        function(trans)
            if self:IsNil() or self.scenePath ~= path or self.sceneTrans then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:ChangeCameraAdaption()
            trans:SetLocalPositionToZero()

            self.sceneTrans = trans
            ---如果对话结束完需要加载布阵前剧情则
            _G.WorldManager:SetCurrentWorldVisible(false, true)

            if not string.IsNullOrEmpty(cameraPath) then
                local component = trans:GetComponentE(_G.typeof(_G.CS.WorldSetting))
                if component then
                    local cameraNum = string.match(cameraPath, "%d+")
                    component:ChangeCameraParams(cameraPath, cameraNum)
                end
            end
            _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()

            --相机降低固定值
            self.sceneTransCamera = trans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
            )
            if self.sceneTransCamera then
                local x, y, z = self.sceneTransCamera:GetLocalPosition()
                self.sceneTransCamera:SetLocalPosition(
                    x + SceneCameraOffset.x,
                    y + SceneCameraOffset.y,
                    z + SceneCameraOffset.z
                )
            end

            if callback then
                callback()
            end
        end
    )
end

---移除/回收场景
---@param destroyRoot? boolean @是否销毁根节点
---@return void
function DungeonChallengeBattleView:RemoveScene(destroyRoot)
    if self.sceneTrans then
        --还原镜头信息
        if self.sceneTransCamera then
            local x, y, z = self.sceneTransCamera:GetLocalPosition()
            self.sceneTransCamera:SetLocalPosition(
                x - SceneCameraOffset.x,
                y - SceneCameraOffset.y,
                z - SceneCameraOffset.z
            )
        end

        _G.PoolsManager:GetInstance():Despawn(self.sceneTrans, _G.ePoolType.Static, destroyRoot)
        --_G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
        self.sceneTrans = nil
    end
    if destroyRoot and self.sceneRoot then
        _G.DestroyObject(self.sceneRoot)
        self.sceneRoot = nil
    end

    self.scenePath = nil
end

---加载角色模型
---@param data DungeonChallengeBattle_RoleData
---@param modelPath? string                 @模型路径: 如不传则从card_cfg取默认参数
---@param callback? fun(d:DungeonChallengeBattle_RoleData):void    @加载完成回调
function DungeonChallengeBattleView:LoadRoleModel(data, modelPath, callback)
    if not data.enabled then
        return
    end
    if not self.sceneRoot then
        if _G.AppSetting.DEBUG then
            _G.LogError("场景根节点未实例化")
        end
        return
    end
    --如果没传路径, 则取card_cfg中的配置
    if _G.string.IsNullOrEmpty(modelPath) and data.sid and data.sid > 0 then
        local cfg = _G.ConfigManager.dungeon_challenge_card_cfg[data.sid]
        if cfg and cfg.skin ~= 0 then
            modelPath = require("CardInfoManager").GetBattleModelPath(cfg.skin, true)
        else
            modelPath = require("CardInfoManager").GetBattleModelPath(data.sid, false) --传true将会读取账号皮肤配置
        end
    end

    --目标模型与加载中模型相同, 不再重复加载
    if modelPath == data.modelPath and not _G.string.IsNullOrEmpty(modelPath) then
        return
    end

    --移除旧的缓存模型
    self:RemoveRoleModel(data)
    if _G.string.IsNullOrEmpty(modelPath) then
        return
    end

    data.modelPath = modelPath
    local nx, ny = _G.UIManager:GetInstance().UICamera:WorldToScreenPointE(data.pos[1], data.pos[2], data.pos[3])
    local sx = nx * (_G.CS.Launcher.Inst.ScreenSize.x / _G.AppSetting.SCREEN_WIDTH) // 2
    local sy = ny * (_G.CS.Launcher.Inst.ScreenSize.y / _G.AppSetting.SCREEN_HEIGHT) // 2
    self.go_table.obj_FlyList:SetLocalPosition(sx, sy, 0)

    require("CardInfoManager").GetRole(
        modelPath,
        _G.ePoolType.Static,
        self.sceneRoot,
        _G.RoleEffTypeEnum.Fight,
        function(trans)
            if self:IsNil() or data.modelPath ~= modelPath or data.model then
                _G.DestroyObject(trans)
                return
            end
            utils.playModelStand2(trans)
            trans:SetPosition(data.pos[1], data.pos[2], data.pos[3])
            data.model = trans
            if data.direction == 1 then
                trans:SetLocalEulerAngles(0, 0, utils.getCameraAngleX())    --朝右
            else
                trans:SetLocalEulerAngles(0, 180, -utils.getCameraAngleX()) --朝左
            end
            if callback then
                callback(data)
            end
        end
    )
end

---移除角色模型
---@param data DungeonChallengeBattle_RoleData
function DungeonChallengeBattleView:RemoveRoleModel(data)
    if data.model then
        _G.DestroyObject(data.model)
        data.model = nil
    end
    data.modelPath = nil
end

---加载角色阴影信息
---@param data DungeonChallengeBattle_RoleData
function DungeonChallengeBattleView:LoadShadowModel(data)
    if not data.enabled then
        return
    end

    if not self.sceneRoot then
        if _G.AppSetting.DEBUG then
            _G.LogError("场景根节点未实例化")
        end
        return
    end
    local star = 1
    if data.star and data.star > 0 then
        star = require("CardInfoManager"):GetInstance():GetOrderStarCount(star) + 1
    end
    --目标模型与加载中模型相同, 不再重复加载
    if star == data.shadowStar then
        return
    end

    self:RemoveShadowModel(data)
    data.shadowStar = star
    _G.PoolsManager:GetInstance():Spawn(
        StarColorPaths[star] or StarColorPaths[#StarColorPaths],
        _G.ePoolType.Temporary,
        self.sceneRoot,
        function(trans)
            if self:IsNil() or data.shadowStar ~= star or data.shadow then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:SetPosition(
                data.pos[1],
                data.pos[2] + 0.1,
                data.pos[3]
            )
            data.shadow = trans
        end
    )
end

---移除角色阴影模型
---@param data DungeonChallengeBattle_RoleData
function DungeonChallengeBattleView:RemoveShadowModel(data)
    if data.shadow then
        _G.PoolsManager:GetInstance():Despawn(data.shadow, _G.ePoolType.Static)
        data.shadow = nil
    end
    data.shadowStar = nil
end

