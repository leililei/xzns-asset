---设置显示关卡模板
---@param active boolean
function DungeonChallengeBattleView:SetChapterTemplateActive(active)
    self.go_table.obj_chapterTemplate:SetActiveE(active and 1 or 0)
    self.go_table.aorbtn_chapterTemplateBlocker:SetActiveE(active and 1 or 0)
    self.go_table.aorimage_charpterArrow:SetLocalEulerAngles(active and 0 or -180, 0, 0)

    if active then
        --最小偏移-40, 最大偏移为-120
        local jumpOffset = math.min(self.chapterIndex, 3) * -40
        --只显示已解锁的关卡
        --local count = #self.chapterDatas
        local count = math.min(self.model:GetMaxChapterIndex() + 1, #self.chapterDatas)

        local isInit = self[self.go_table.scrollloopvectical_chapterTemplateList]
        if not isInit then
            self[self.go_table.scrollloopvectical_chapterTemplateList] = true
            self.go_table.scrollloopvectical_chapterTemplateList:InitItemData(
                count,
                _G.handler(self, self.OnRefreshChapterTemplate),
                self.chapterIndex, --当前选中关卡
                jumpOffset
            )
        else
            self.go_table.scrollloopvectical_chapterTemplateList:UpdateCount(
                count,
                self.chapterIndex, --当前选中关卡
                jumpOffset
            )
        end
    end
end

---更新显示人物信息
---@param index number
---@param item DungeonChallengeBattleView._obj_prepareRoleInfo_GoTable|{data:DungeonChallengeBattle_RoleData}
function DungeonChallengeBattleView:UpdatePreparePlayerInfo(index, item)
    if not item then
        return
    end
    if not item.data or not item.data.model or not item.data.sid or item.data.sid <= 0 then
        item.gameObject:SetActiveE(0)
        return
    end
    item.gameObject:SetActiveE(1)

    ---@type dungeon_challenge_card_cfg
    local cfg = _G.ConfigManager.dungeon_challenge_card_cfg[item.data.sid]

    --基础位置
    local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(item.data.model, self.go_table.trans_prepare)
    local _, height = item.transform:GetRectTransformWidthHeight()
    item.transform:SetLocalPosition(x, y + height * 0.5, 0)

    --显示名字
    item.aortext_name.text = _G.GetLangPackValue(cfg.name)
    local hpPoint = utils.findModelPoint(item.data.model, true)
    if hpPoint then
        --local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(hpPoint, self.go_table.trans_prepare)
        local x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(hpPoint, item.transform)
        item.aortext_name:SetLocalPosition(x, y, 0)
        if _G.AppSetting.IsXzns then
            item.obj_nameBg:SetLocalPosition(x, y, 0)
        end
        item.obj_flag:SetLocalPosition(x, y + 70, 0)
    end
    item.obj_flag:SetActiveE(index == self.prepareRoleIndex and 1 or 0)
    item.obj_effect:SetActiveE(index == self.prepareRoleIndex and 1 or 0)

    --选中特效
    if not item.__initEffect then
        item.__initEffect = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_dungeon_xuanze,
            item.obj_effect
        )
    end

    --技能信息
    if not _G.table.isEmptyOrNil(cfg.skill) and #cfg.skill > 0 then
        local skillCfg = _G.ConfigManager.card_skills_cfg[cfg.skill[1]]
        if skillCfg then
            item.aorrawimage_icon:LoadImage(skillCfg.icon)
        end
    end
end

