---初始化角色数据
---@param cfg monster_group_cfg @怪物组配置
---@param selfCardSid number    @当前玩家的卡牌sid
---@param selfCardIndex? number  @当前玩家的卡牌索引(默认4)
function DungeonChallengeBattleView:InitRoleDatas(cfg, selfCardSid, selfCardIndex)
    if not cfg then
        return
    end
    self.attackRoles = {}
    self.defenceRoles = {}

    selfCardIndex = selfCardIndex or 4

    local defaultDefenserSids = cfg.DefaultDefenserSids[1] or {}
    --初始化坐标位置
    local posCfg = _G.ConfigManager.pos_cfg[cfg.pos]
    if posCfg then
        local centerX, centerY, centerZ = cfg.FightAreaPos[1] or 0,
            cfg.FightAreaPos[2] or 0,
            cfg.FightAreaPos[3] or 0
        for i = 1, 5 do
            if posCfg.AttackerPos[i] then
                local pos = posCfg.AttackerPos[i]
                table.insert(self.attackRoles, {
                    enabled = false,
                    pos = {
                        (pos[1] or 0) + centerX,
                        (pos[2] or 0) + centerY,
                        (pos[3] or 0) + centerZ,
                    },
                    direction = pos[5] or 0,
                    sid = 0,
                })
                if i == selfCardIndex then
                    local cur = self.attackRoles[#self.attackRoles]
                    cur.enabled = true
                    cur.sid = selfCardSid or 0
                end
            end
            if posCfg.DefenserPos[i] then
                local pos = posCfg.DefenserPos[i]
                local sid = defaultDefenserSids[i] or 0
                --monster_cfg.id转card_cfg.id
                local monsterCfg = sid > 0 and _G.ConfigManager.monster_cfg[sid]
                if monsterCfg then
                    sid = monsterCfg.CardID
                end
                table.insert(self.defenceRoles, {
                    enabled = sid > 0,
                    pos = {
                        (pos[1] or 0) + centerX,
                        (pos[2] or 0) + centerY,
                        (pos[3] or 0) + centerZ,
                    },
                    direction = pos[5] or 0,
                    sid = sid,
                })
            end
        end
    end
end

---准备阶段: 初始化战前选人数据
---@param cfg dungeon_challenge_cfg
---@return void
function DungeonChallengeBattleView:InitPrepareRoleDatas(cfg)
    if not cfg then
        return
    end
    self.prepareRoles = {}

    --初始化坐标位置
    local count = #cfg.heroes
    local positions = count == 2 and ScenePreparePositions.Two or ScenePreparePositions.Three

    for i = 1, count do
        if not positions[i] then
            break
        end
        table.insert(self.prepareRoles, {
            enabled = true,
            pos = positions[i],
            direction = 1,
            sid = cfg.heroes[i],
        })
    end
end

