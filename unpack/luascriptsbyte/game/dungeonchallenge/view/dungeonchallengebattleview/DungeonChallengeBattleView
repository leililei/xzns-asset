local DungeonChallengeBattleView = _G.BaseClass("DungeonChallengeBattleView", _G.UIBaseView)

function DungeonChallengeBattleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    --初始化
    --self.go_table.obj_chapterTemplate:SetActiveE(0)
    --self.go_table.aorbtn_chapterTemplateBlocker:SetActiveE(0)
    self.go_table.aorbtn_reset:SetActiveE(0)
    self:SetChapterTemplateActive(false)

    self:InitPools()
    self:InitDragHandlers()
end

function DungeonChallengeBattleView:OnDestroy()
    self:ClearRoleModels(true)        --回收角色(进攻/防守)
    self:ClearPrepareRoleModels(true) --回收角色(战前选人)
    self:RemoveScene(true)            --回收场景
end

---界面的入口函数
function DungeonChallengeBattleView:OnCreate()
    self.model = DungeonChallengeBattleModel:GetInstance()
    self.model:SetRedPointHidden()

    if _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "NewFunctionWearBoss") == 0 then
        _G.PlayerPrefsManager.SetInt(
            _G.PlayerModel:GetInstance():GetPlayerUid() .. "NewFunctionWearBoss", 1)
    end
    _G.Events:GetInstance():Broadcast(_G.DungeonChallengeBattleViewShow.Open)

    self:InitEquipItems()
    self:InitPreparePlayerInfos()
    --初始化关卡数据
    self.chapterDatas = self.model:GetChapterCfgs()
    self.stage = Stage.None
    self.isClickBattleBtn = false
    self.lastProp = { atk = 0, bre = 0, def = 0, max_hp = 0 }

    self:UpdateView()
    if self.stage ~= Stage.Prepare then
        _G.BattleManager:GetInstance():SetBattlePause(false)
        _G.WorldManager:GetInstance():DestoryRoleParent()
        _G.BattleManager:GetInstance():DestroyBattle()

        self.model:ResetChapter(function(msg)
            --清空人物模型丶背包装备
            self:ClearRoleModels(true)
            self:ClearEquipUsableItems()
            self:ClearEquipItems()

            --初始化关卡
            self.chapterIndex = math.min(self.model:GetMaxChapterIndex() + 1, #self.chapterDatas)
            self:LoadPrepare(self.chapterDatas[self.chapterIndex])
        end)
    end
end

---更新页面状态
function DungeonChallengeBattleView:UpdateView(isBattleEnd)
    --清空装备状态
    self:ClearEquipItems()
    self:ClearEquipUsableItems()

    if self.model:IsChallenging() and self.model:GetCardSid() > 0 then
        --立即同步布局状态(稍后马上将会使用)
        _G.GameUtil.ReBuildRTF(self.go_table.trans_equipParent)
        --初始化为挑战中状态
        self.chapterIndex = self.model:GetChallengingIndex()
        self:LoadBattleEquip(isBattleEnd)
    else
        --初始化选关页面
        self.chapterIndex = math.min(self.model:GetMaxChapterIndex() + 1, #self.chapterDatas)
        self:LoadPrepare(self.chapterDatas[self.chapterIndex])
    end

    --至少通关一关, 才显示选关按钮
    self.go_table.obj_chapters:SetActiveE(self.model:GetMaxChapterIndex() > 0 and 1 or 0)
end

---加载关卡
---@param cfg dungeon_challenge_cfg
---@return void
function DungeonChallengeBattleView:LoadPrepare(cfg)
    self.go_table.trans_prepare:SetActiveE(1)
    self.go_table.trans_challenge:SetActiveE(0)
    self.go_table.aorbtn_battle:SetActiveE(1)
    self.go_table.aorbtn_details:SetActiveE(0)
    self.stage = Stage.Prepare

    self:ClearPrepareRoleModels(true) --回收所有角色模型
    self:ClearPreparePlayerInfos()

    --初始化
    self:InitPrepareRoleDatas(cfg)
    self.prepareRoleIndex = 1
    self.go_table.obj_title:SetActiveE(0)

    --初始化场景丶角色模型
    local mgCfgId = 502010110
    local firstLevelCfg = _G.ConfigManager.dungeon_challenge_Level_cfg[cfg.level[1]]
    if firstLevelCfg and not _G.table.isEmptyOrNil(firstLevelCfg.monster_group) then
        mgCfgId = firstLevelCfg.monster_group[1][1]
    end
    local mgCfg = _G.ConfigManager.monster_group_cfg[mgCfgId]
    if not mgCfg and _G.AppSetting.DEBUG then
        _G.LogError("monster_group_cfg.id = " .. tostring(mgCfgId))
    end
    self:LoadScene(mgCfg) --新场景加载时, 会自动回收旧场景
    self:UpdatePrepareRoleModels(function(d)
        if not d.model or not self.prepareRoles or not self.prepareRoleInfos then
            return
        end
        for index, roleData in ipairs(self.prepareRoles) do
            if d == roleData then
                local info = self.prepareRoleInfos[index]
                if info then
                    info.data = d
                    utils.findModelPoint(d.model, true) --立即同步一次骨骼
                    _G.DelayDo(0.5, function()
                        if self:IsNil() then
                            return
                        end
                        self:UpdatePreparePlayerInfo(index, info) --某些情况下模型加载出来需等待几帧, 其骨骼才能正确同步
                    end)
                end
                break
            end
        end
    end)

    --关卡信息
    self.go_table.aortext_chapterName.text = _G.GetLangPackValue(cfg.name)

    --战力缓存
    self.power = nil
    self.lastProp = nil
    self.isPlayingAnimation = false
end

---选定关卡和卡牌, 开始战前处理装备
function DungeonChallengeBattleView:LoadBattleEquip(isBattleEnd)
    self.go_table.trans_prepare:SetActiveE(0)
    self.go_table.trans_challenge:SetActiveE(1)
    self.go_table.aorbtn_battle:SetActiveE(1)
    self.go_table.aorbtn_details:SetActiveE(1)
    self.stage = Stage.BattleEquip

    self:ClearPrepareRoleModels(true) --回收所有角色模型
    self:ClearPreparePlayerInfos()

    --地图数据
    local mgCfgId = self.model:GetMonsterGroupId()
    if not mgCfgId or mgCfgId <= 0 then
        return
    end
    local mgCfg = _G.ConfigManager.monster_group_cfg[mgCfgId]
    if not mgCfg and _G.AppSetting.DEBUG then
        _G.LogError("monster_group_cfg.id = " .. tostring(mgCfgId))
    end

    --初始化
    self:InitRoleDatas(mgCfg, self.model:GetCardSid(), 1)
    self:LoadScene(mgCfg) --新场景加载时, 会自动回收旧场景
    self:UpdateRoleModels()

    --名称
    local cfg = self.chapterDatas[self.model:GetChallengingIndex()]
    self.go_table.obj_title:SetActiveE(1)
    self.go_table.aortext_name.text = _G.GetLangPackValue(
        90036102016,
        self.model:GetChallengingMonsterIndex(),
        #cfg.level
    )

    --当前装备
    local equips = self.model:GetEquips()
    if equips then
        for index, equipData in pairs(equips) do
            self:InstallEquip(index, equipData)
        end
    end
    --装备背包
    local usableEquips = self.model:GetUsableEquips()
    --- 临时缓存要飞的item
    self.linshiList = {}
    if usableEquips then
        for _, equipData in ipairs(usableEquips) do
            self:AddEquipUsableItem(equipData, nil, isBattleEnd)
        end
        self:SortEquipUsableItems()
        if isBattleEnd then
            local targetX, targetY = self.go_table.trans_equipUsableParent:GetPosition()
            if targetX == nil or targetY == nil then
                targetX = 0
                targetY = -8
            end
            self.isPlayingAnimation = true
            self.go_table.obj_FlyList:DoMove(targetX, targetY, 0, function()
                for i = 1, #self.linshiList do
                    self.linshiList[i]:SetParentE(self.go_table.trans_equipUsableParent)
                end
                self:SortEquipUsableItems()
                self.isPlayingAnimation = false
            end, 0.5)
        end
    else
        self.isPlayingAnimation = false
    end

    --更新战力缓存
    self:UpdatePower(false)

    if self.model:GetChallengingMonsterIndex() == 1 and self.isClickBattleBtn then
        self:Fight()
    end
end

---战斗中
function DungeonChallengeBattleView:LoadBattle()
    self.go_table.trans_prepare:SetActiveE(0)
    self.go_table.trans_challenge:SetActiveE(0)
    self.go_table.aorbtn_battle:SetActiveE(0)
    self.go_table.aorbtn_details:SetActiveE(1)
    self.stage = Stage.Battle

    --清空临时背包
    self:ClearEquipUsableItems()
    --将玩家模型丶场景模型加入缓存节点
    local root = _G.WorldManager:GetInstance():GetRoleParent()
    _G.WorldManager:GetInstance():DestoryRoleParent()
    if self.sceneTrans then
        self.sceneTrans:SetParentE(root, 1) --不要恢复相机设定, 直接使用
        self.sceneTrans = nil
    end
    if self.attackRoles then
        for _, roleData in ipairs(self.attackRoles) do
            if roleData.model then
                roleData.model:SetParentE(root, 1)
                roleData.model = nil
            end
        end
    end
    if self.defenceRoles then
        for _, roleData in ipairs(self.defenceRoles) do
            if roleData.model then
                roleData.model:SetParentE(root, 1)
                roleData.model = nil
            end
        end
    end

    --清空节点状态
    self:RemoveScene(false)
    self:ClearRoleModels(true)
end

