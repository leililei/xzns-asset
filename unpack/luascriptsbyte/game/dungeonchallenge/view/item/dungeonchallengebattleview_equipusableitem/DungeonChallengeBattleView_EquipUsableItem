---@class DungeonChallengeBattleView_EquipUsableItem : Component	装备合成闯关_装备背包物品
---@field go_table DungeonChallengeBattleView._trans_equipUsableItem_GoTable
---@field root UnityEngine.Transform            @计算坐标时, 相对于此节点
-----------------------------------------------------------------------
---@field data DungeonChallengeEquipData
-----------------------------------------------------------------------
---@field size {w:number,h:number}              @格子自身大小
local DungeonChallengeBattleView_EquipUsableItem = _G.BaseClass(
    "DungeonChallengeBattleView_EquipUsableItem",
    _G.Component
)

---入口函数
function DungeonChallengeBattleView_EquipUsableItem:OnCreate(trans, root)
    self.go_table = _G.GetAutoGoTable(trans)
    self.transform = self.go_table.transform --self.transform 是GameObject???
    self.root = root
    self:Update()
end

function DungeonChallengeBattleView_EquipUsableItem:Update()
    if not self.data then
        return
    end
    local scaleX, scaleY, angle, size = self.data:GetIconParams()
    self.go_table.aorrawimage_icon:LoadImage(self.data:GetIcon())
    self.go_table.aorrawimage_icon:SetLocalScale(scaleX, scaleY, 0)
    self.go_table.aorrawimage_icon:SetLocalEulerAngles(0, 0, angle)

    --更新点击范围
    if not self.size then
        local width, height = self.gameObject:GetRectTransformWidthHeight()
        self.size = { w = width, h = height }
    end
    self.size.w = size
    self.gameObject:SetRectTransformSize(self.size.w, self.size.h)
end

--region ==============================装备状态/数据==============================

---设置当前装备数据
---@param data DungeonChallengeEquipData
function DungeonChallengeBattleView_EquipUsableItem:SetData(data)
    self.data = data
end

---获取当前装备数据
---@return DungeonChallengeEquipData
function DungeonChallengeBattleView_EquipUsableItem:GetData()
    return self.data
end

---重置位置缓存
---@return void
function DungeonChallengeBattleView_EquipUsableItem:ResetPosition()
    self.position = nil
end

---获取当前位置
---@return number,number @格子自身所在位置X, 格子自身所在位置Y
function DungeonChallengeBattleView_EquipUsableItem:GetPosition()
    if not self.position then
        if self.root then
            local x, y, z = self.transform:GetPosition()
            local localPosition = self.root:InverseTransformPoint(x, y, z)
            self.position = { x = localPosition.x, y = localPosition.y }
        else
            local x, y = self.transform:GetLocalPosition()
            self.position = { x = x, y = y }
        end
    end
    return self.position.x, self.position.y
end

---获取大小
---@return number,number @格子自身宽度, 格子自身高度
function DungeonChallengeBattleView_EquipUsableItem:GetSize()
    if not self.size then
        local width, height = self.gameObject:GetRectTransformWidthHeight()
        self.size = { w = width, h = height }
    end
    return self.size.w, self.size.h
end

---判断是否包含点(坐标必须是root所在的参考系)
---@param x number @点X
---@param y number @点Y
---@return boolean @是否包含
function DungeonChallengeBattleView_EquipUsableItem:ContainsPoint(x, y)
    if not self.size then
        local width, height = self.gameObject:GetRectTransformWidthHeight()
        self.size = { w = width, h = height }
    end
    local selfX, selfY = self:GetPosition()
    return x >= selfX - self.size.w / 2 and
        x <= selfX + self.size.w / 2 and
        y >= selfY - self.size.h / 2 and
        y <= selfY + self.size.h / 2
end

--endregion

return DungeonChallengeBattleView_EquipUsableItem
