local ObjectFactory = require("ObjectFactory")

--占位网格大小
local ROW, COLUMN = 3, 3

--背景图片
local QualityImages = {
    [4] = { "ui_cgfb_zdjm_tips_kuang_zi", "ui_cgfb_zdjm_tips_zi" },       --紫色
    [5] = { "ui_cgfb_zdjm_tips_kuang_cheng", "ui_cgfb_zdjm_tips_cheng" }, --橙色
    [6] = { "ui_cgfb_zdjm_tips_kuang_hong", "ui_cgfb_zdjm_tips_hong" },   --红色
    [7] = { "ui_cgfb_zdjm_tips_kuang_jin", "ui_cgfb_zdjm_tips_jin" },     --金色
}

--技能背景图片
local SkillQualityImages = {
    [4] = "ui_cgfb_zdjm_tips_fream_zi",    --紫色
    [5] = "ui_cgfb_zdjm_tips_fream_cheng", --橙色
    [6] = "ui_cgfb_zdjm_tips_fream_hong",  --红色
    [7] = "ui_cgfb_zdjm_tips_fream_jin",   --金色
}

--只显示基础属性
local BaseAttributeKeys = {
    ["max_hp"] = true,
    ["atk"] = true,
    ["def"] = true,
    ["bre"] = true,
}

---@class DungeonChallengeEquipTipView_EquipItem : Component	装备合成闯关_装备tip item
---@field go_table DungeonChallengeEquipTipView._obj_item_GoTable
---@field data dungeon_challenge_equip_cfg
---@field callback function
-----------------------------------------------------------------------
---@field attrPool ObjectFactory<_obj_item._obj_attributeItem_GoTable>
---@field descPool ObjectFactory<_obj_item._obj_desc_GoTable>
local DungeonChallengeEquipTipView_EquipItem = _G.BaseClass("DungeonChallengeEquipTipView_EquipItem", _G.Component)

---入口函数
function DungeonChallengeEquipTipView_EquipItem:OnCreate(trans, index, root)
    self.go_table = _G.GetAutoGoTable(trans)
    _G.AddViewBtnClick(trans, _G.handler(self, self.OnClickBtn))
    self:InitPools()
end

---设置当前展示数据
---@param data dungeon_challenge_equip_cfg
function DungeonChallengeEquipTipView_EquipItem:SetData(data)
    self.data = data
    self.attrPool:ReleaseAll()
    self.descPool:ReleaseAll()
    self:SetSelectedActive(false)

    --装备品质
    local cfg = QualityImages[data.quality] or QualityImages[4]
    self.go_table.aorimage_bg.SpriteName = cfg[1]
    self.go_table.aorimage_banner.SpriteName = cfg[2]
    if data.quality >= 7 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_dungeon_tips,
            self.go_table.trans_effect
        )
    end

    --装备名称丶图标
    self.go_table.aortext_name.text = _G.GetLangPackValue(data.name)
    self.go_table.aorrawimage_icon:LoadImage(data.Icon)

    --装备空间占用
    local row, col =
        math.max(data.area[1] or 1, 1),
        math.max(data.area[2] or 1, 1)
    for r = 1, ROW do
        for c = 1, COLUMN do
            local index = (c - 1) * ROW + r
            local node = self.go_table["aorimage_area" .. index]
            if node then
                node.enabled = r <= row and c <= col
            end
        end
    end

    self:ShowAttributes()
    self:ShowSkill()

    --装备特性
    -- if not _G.table.isEmptyOrNil(self.data.feature) then
    --     for _, v in ipairs(self.data.feature) do
    --         local id, level = v[1], v[2]
    --         self:ShowFeature(id, level)
    --     end
    -- end
    if self.data.featuretext and self.data.featuretext > 0 then
        ---@type _obj_item._obj_desc_GoTable
        local item = self.descPool:Get()
        item.aortext_title.text = _G.GetLangPackValue(90036102011)
        item.aortext_content.text = _G.GetLangPackValue(self.data.featuretext,self.data.featurenum.."%")
    end
end

---获取当前数据
---@return data dungeon_challenge_equip_cfg
function DungeonChallengeEquipTipView_EquipItem:GetData()
    return self.data
end

---设置当前选中状态
---@param active boolean
function DungeonChallengeEquipTipView_EquipItem:SetSelectedActive(active)
    self.go_table.obj_select:SetActiveE(active and 1 or 0)
end

---设置装备点击回调
---@param callback function
function DungeonChallengeEquipTipView_EquipItem:SetCallback(callback)
    self.callback = callback
end

---显示当前装备的属性
---@private
function DungeonChallengeEquipTipView_EquipItem:InitPools()
    self.go_table.obj_attributeItem:SetActiveE(0)
    self.go_table.obj_desc:SetActiveE(0)

    self.attrPool = ObjectFactory.New(
        function()
            --create
            local instance = _G.InstantiateObject(
                self.go_table.obj_attributeItem,
                self.go_table.obj_attributes
            )
            instance:SetLocalScaleXYZ(1)
            --instance:SetActiveE(1)
            return _G.GetAutoGoTable(instance)
        end,
        ---@param item _obj_item._obj_attributeItem_GoTable
        function(item)
            --active
            item.gameObject:SetActiveE(1)
            item.gameObject:SetAsLastSiblingE()
        end,
        ---@param item _obj_item._obj_attributeItem_GoTable
        function(item)
            --release
            item.gameObject:SetActiveE(0)
        end
    )
    self.descPool = ObjectFactory.New(
        function()
            --create
            local instance = _G.InstantiateObject(
                self.go_table.obj_desc,
                self.transform
            )
            instance:SetLocalScaleXYZ(1)
            --instance:SetActiveE(1)
            return _G.GetAutoGoTable(instance)
        end,
        ---@param item _obj_item._obj_desc_GoTable
        function(item)
            --active
            item.gameObject:SetActiveE(1)
            item.gameObject:SetAsLastSiblingE()
        end,
        ---@param item _obj_item._obj_desc_GoTable
        function(item)
            --release
            item.gameObject:SetActiveE(0)
        end
    )
end

---显示当前装备的属性
---@private
function DungeonChallengeEquipTipView_EquipItem:ShowAttributes()
    self.attrPool:ReleaseAll()

    ---@type type_attribute_cfg[]
    local cfgs = _G.table.toArray(_G.ConfigManager.type_attribute_cfg)
    table.sort(cfgs, function(a, b)
        return a.display_priority < b.display_priority
    end)
    for _, cfg in ipairs(cfgs) do
        local v = self.data[cfg.attribute_type]
        if v and v ~= 0 and BaseAttributeKeys[cfg.attribute_type] then
            ---@type _obj_item._obj_attributeItem_GoTable
            local item = self.attrPool:Get()
            item.aortext_name.text = _G.GetLangPackValue(cfg.name)
            if cfg.value_type == 1 then
                item.aortext_value.text = tostring(v)
            else
                item.aortext_value.text = string.format("%d%%", math.max(1, math.floor(v / 100)))
            end
        end
    end
end

---显示当前装备的技能
---@private
function DungeonChallengeEquipTipView_EquipItem:ShowSkill()
    local skillId = not _G.table.isEmptyOrNil(self.data.skill) and self.data.skill[1] or 0
    self.go_table.obj_skill:SetActiveE(skillId and skillId > 0 and 1 or 0)
    if not skillId or skillId <= 0 then
        return
    end
    local skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
    if not skillCfg then
        return
    end

    self.go_table.aorrawimage_skillIcon:LoadImage(skillCfg.icon)
    self.go_table.aortext_skillName.text = _G.GetLangPackValue(skillCfg.name1)
    self.go_table.aortext_skillDesc.text = _G.GetLangPackValue(skillCfg.describe1)
    self.go_table.aortext_skillTip.text = _G.GetLangPackValue(self.data.describe) --装备描述

    self.go_table.aorimage_skillBg.SpriteName = SkillQualityImages[self.data.quality] or SkillQualityImages[4]
end

---显示当前装备的特性
---@private
function DungeonChallengeEquipTipView_EquipItem:ShowFeature(id, level)
    local featureCfg = _G.ConfigManager.dungeon_challenge_equip_feature_cfg[id]
    if not featureCfg or not featureCfg.skill then
        return
    end
    local skillId = featureCfg.skill[level]
    if not skillId or skillId <= 0 then
        return
    end
    local skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
    if not skillCfg then
        return
    end
    ---@type _obj_item._obj_desc_GoTable
    local item = self.descPool:Get()
    item.aortext_title.text = _G.GetLangPackValue(90036102011)
    item.aortext_content.text = _G.GetLangPackValue(skillCfg.describe1)
end

function DungeonChallengeEquipTipView_EquipItem:OnClickBtn(go, isOn)
    if self.callback then
        self.callback()
    end
end

return DungeonChallengeEquipTipView_EquipItem
