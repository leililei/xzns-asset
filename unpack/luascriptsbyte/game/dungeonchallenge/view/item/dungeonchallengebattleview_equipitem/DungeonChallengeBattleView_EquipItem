local DungeonChallengeBattleModel = require("DungeonChallengeBattleModel")

local BackgroundImages = {
    Uninstall = "ui_cgfb_zdjm_gezi_1", --未装备
    Install = "ui_cgfb_zdjm_gezi_1",   --已装备, 未有任何选中状态
    Ok = "ui_cgfb_zdjm_gezi_2",        --选中, 绿色状态
    Error = "ui_cgfb_zdjm_gezi_2",     --选中, 红色状态
    HighLight = "ui_cgfb_zdjm_gezi_2", --选中, 金色状态
}

if _G.AppSetting.IsXzns then
BackgroundImages = {
    Uninstall = "ui_cgfb_zdjm_gezi_0", --未装备
    Install = "ui_cgfb_zdjm_gezi_1",   --已装备, 未有任何选中状态
    Ok = "ui_cgfb_zdjm_gezi_2",        --选中, 绿色状态
    Error = "ui_cgfb_zdjm_gezi_3",     --选中, 红色状态
    HighLight = "ui_cgfb_zdjm_gezi_2", --选中, 金色状态
}
end

local ColorAlpha1, ColorAlpha0_3, ColorError, ColorHighLight =
    _G.Color.New(1, 1, 1, 1),
    _G.Color.New(1, 1, 1, 0.3),
    _G.Color.New(239 / 255, 78 / 255, 78 / 255, 1),
    _G.Color.New(239 / 255, 236 / 255, 98 / 255, 1)

if _G.AppSetting.IsXzns then
    ColorAlpha1, ColorAlpha0_3, ColorError, ColorHighLight =
    _G.Color.New(1, 1, 1, 1),
    _G.Color.New(1, 1, 1, 0.3),
    _G.Color.New(1, 1, 1, 1),
    _G.Color.New(1, 1, 1, 1)
end

---@class DungeonChallengeBattleView_EquipItem : Component	装备合成闯关_装备槽位
---@field go_table DungeonChallengeBattleView._trans_equipItem_GoTable
---@field index number                          @插槽序号
---@field root UnityEngine.Transform            @计算坐标时, 相对于此节点
-----------------------------------------------------------------------
---@field data DungeonChallengeEquipData
---@field solt number                           @插槽状态, 对应DungeonChallengeBattleModel.EquipSolts
---@field flag number                           @选择状态, 对应DungeonChallengeBattleModel.EquipSoltFlags
-----------------------------------------------------------------------
---@field model any                             @模型关联
---@field position {x:number,y:number}          @格子自身所在位置
---@field size {w:number,h:number}              @格子自身大小
local DungeonChallengeBattleView_EquipItem = _G.BaseClass("DungeonChallengeBattleView_EquipItem", _G.Component)

---入口函数
function DungeonChallengeBattleView_EquipItem:OnCreate(trans, index, root)
    self.go_table = _G.GetAutoGoTable(trans)
    self.transform = self.go_table.transform --self.transform 是GameObject???
    self.index = index
    self.root = root
    self:Update()
end

---获取当前装备格子索引
---@return number
function DungeonChallengeBattleView_EquipItem:GetIndex()
    return self.index
end

function DungeonChallengeBattleView_EquipItem:Update()
    self:UpdateBackground()
end

--region ==============================装备状态/数据==============================

---设置当前装备数据
---@param data DungeonChallengeEquipData
function DungeonChallengeBattleView_EquipItem:SetData(data)
    self.data = data
end

---获取当前装备数据
---@return DungeonChallengeEquipData
function DungeonChallengeBattleView_EquipItem:GetData()
    return self.data
end

---设置当前插槽状态
---@param solt number @插槽状态, 对应DungeonChallengeBattleModel.EquipSolts
function DungeonChallengeBattleView_EquipItem:SetSolt(solt)
    self.solt = solt
end

---获取当前插槽状态
---@return number @插槽状态, 对应DungeonChallengeBattleModel.EquipSolts, 如果>=1表示当前装备实际安装的序号
function DungeonChallengeBattleView_EquipItem:GetSolt()
    return self.solt or DungeonChallengeBattleModel.EquipSolts.None
end

---设置当前选择状态
---@param flag number @选择状态, 对应DungeonChallengeBattleModel.EquipSoltFlags
function DungeonChallengeBattleView_EquipItem:SetFlag(flag)
    self.flag = flag
end

---获取当前选择状态
---@return number @选择状态, 对应DungeonChallengeBattleModel.EquipSoltFlags
function DungeonChallengeBattleView_EquipItem:GetFlag()
    return self.flag or DungeonChallengeBattleModel.EquipSoltFlags.Normal
end

---设置当前装备模型
---@param model any @模型关联
function DungeonChallengeBattleView_EquipItem:BindModel(model)
    self.model = model
end

---获取当前装备模型
---@return any @模型关联
function DungeonChallengeBattleView_EquipItem:GetModel()
    return self.model
end

---获取当前装备格子位置
---@return number,number @格子自身所在位置X, 格子自身所在位置Y
function DungeonChallengeBattleView_EquipItem:GetPosition()
    if not self.position then
        if self.root then
            local x, y, z = self.transform:GetPosition()
            local localPosition = self.root:InverseTransformPoint(x, y, z)
            self.position = { x = localPosition.x, y = localPosition.y }
        else
            local x, y = self.transform:GetLocalPosition()
            self.position = { x = x, y = y }
        end
    end
    return self.position.x, self.position.y
end

---判断是否包含点(坐标必须是root所在的参考系)
---@param x number @点X
---@param y number @点Y
---@return boolean @是否包含
function DungeonChallengeBattleView_EquipItem:ContainsPoint(x, y)
    if not self.size then
        local width, height = self.gameObject:GetRectTransformWidthHeight()
        self.size = { w = width, h = height }
    end
    local selfX, selfY = self:GetPosition()
    return x >= selfX - self.size.w / 2 and
        x <= selfX + self.size.w / 2 and
        y >= selfY - self.size.h / 2 and
        y <= selfY + self.size.h / 2
end

--endregion

---更新背景颜色状态
---@private
function DungeonChallengeBattleView_EquipItem:UpdateBackground()
    self.go_table.aorimage_bg.color = ColorAlpha1

    if self.flag == DungeonChallengeBattleModel.EquipSoltFlags.Ok then
        self.go_table.aorimage_bg.SpriteName = BackgroundImages.Ok
    elseif self.flag == DungeonChallengeBattleModel.EquipSoltFlags.Error then
        self.go_table.aorimage_bg.SpriteName = BackgroundImages.Error
        --TODO:
        self.go_table.aorimage_bg.SpriteName = BackgroundImages.Install
        self.go_table.aorimage_bg.color = ColorError
    elseif self.flag == DungeonChallengeBattleModel.EquipSoltFlags.HighLight then
        self.go_table.aorimage_bg.SpriteName = BackgroundImages.HighLight
        --TODO:
        -- self.go_table.aorimage_bg.SpriteName = BackgroundImages.Install
        -- self.go_table.aorimage_bg.color = ColorHighLight
    elseif self.data then
        self.go_table.aorimage_bg.SpriteName = BackgroundImages.Install
    else
        self.go_table.aorimage_bg.SpriteName = BackgroundImages.Uninstall
        self.go_table.aorimage_bg.color = ColorAlpha0_3
    end
end

return DungeonChallengeBattleView_EquipItem
