local BaseAttributeKeys = {
    ["max_hp"] = true,
    ["atk"] = true,
    ["def"] = true,
    ["bre"] = true,
}
local AttributeIcons = {
    ["max_hp"] = "ui_js_sm_icon",
    ["atk"] = "ui_js_gj_icon",
    ["def"] = "ui_js_fy_icon",
    ["bre"] = "ui_js_pj_icon",
    ["hit_rate"] = "ui_js_mzl_icon",
    ["avd_rate"] = "ui_js_sbl_icon",
    ["cri_rate"] = "ui_js_bjl_icon",
    ["cri_r_rate"] = "ui_js_kbl_icon",
    ["cri_dmg"] = "ui_js_bjsh_icon",
    ["cri_dmg_r"] = "ui_js_bsjm_icon",
    ["dmg_inc"] = "ui_js_shzj_icon",
    ["psy_d_r"] = "ui_js_wsjm_icon",
    ["mag_d_r"] = "ui_js_fsjm_icon",
    ["all_speed"] = "ui_js_js_icon",
    ["pvp_dmg"] = "ui_js_pvpzs_icon",
    ["pvp_dmg_r"] = "ui_js_pvpjs_icon",
    ["recover_rate"] = "ui_js_zy_icon",
    ["recover_suffer"] = "ui_js_sy_icon",
    ["control_dec"] = "ui_js_rx_icon",
}

---@class DungeonChallengeRoleTipView : UIBaseView	装备合成闯关_人物tip页面
---@field go_table DungeonChallengeRoleTipView_GoTable
local DungeonChallengeRoleTipView = _G.BaseClass("DungeonChallengeRoleTipView", _G.UIBaseView)

function DungeonChallengeRoleTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_table.obj_attributeItem:SetActiveE(0)
    self.go_table.obj_featureItem:SetActiveE(0)
end

---界面的入口函数
---@param cardSid number 卡片id
---@param equips DungeonChallengeEquipData[] 装备列表
function DungeonChallengeRoleTipView:OnCreate(cardSid, equips)
    local roleCfg = _G.ConfigManager.dungeon_challenge_card_cfg[cardSid]
    --属性字段
    ---@type type_attribute_cfg[]
    local attributeKeys = _G.table.toArray(_G.ConfigManager.type_attribute_cfg)
    table.sort(attributeKeys, function(a, b)
        return a.display_priority < b.display_priority
    end)
    --战力属性
    ---@type AttributeClass
    local attributes = _G.AttributeClass.New()
    attributes:OnInit(nil, nil)
    for _, attr in ipairs(attributeKeys) do
        local attType = attr.value_type == 1 and _G.AttCountType.base or _G.AttCountType.basePercent
        attributes:AddValueByID(
            attr.id,
            roleCfg[attr.attribute_type] or 0,
            false,
            attType
        )
        if equips then
            for _, equip in ipairs(equips) do
                attributes:AddValueByID(
                    attr.id,
                    equip.cfg[attr.attribute_type] or 0,
                    false,
                    attType
                )
            end
        end
    end

    self:LoadRoleInfo(roleCfg)
    self:LoadAttributes(attributeKeys, attributes)
    self:LoadEquipFeatures(equips)
    self:LoadPower(attributes)
end

---加载角色基础信息/技能信息
---@param roleCfg dungeon_challenge_card_cfg 角色配置
function DungeonChallengeRoleTipView:LoadRoleInfo(roleCfg)
    --头像
    local cardCfg = _G.ConfigManager.card_cfg[roleCfg.id]
    if cardCfg then
        self.go_table.aorimage_headIcon.SpriteName = cardCfg.Icon
    end
    self.go_table.aortext_name.text = _G.GetLangPackValue(roleCfg.name)

    --技能
    local skillId = not _G.table.isEmptyOrNil(roleCfg.skill) and roleCfg.skill[1] or 0
    local skillCfg = skillId > 0 and _G.ConfigManager.card_skills_cfg[skillId] or nil
    if skillCfg then
        self.go_table.aorrawimage_skillIcon:LoadImage(skillCfg.icon)
        self.go_table.aortext_skillName.text = _G.GetLangPackValue(skillCfg.name1)
        self.go_table.aortext_skillDesc.text = _G.GetLangPackValue(skillCfg.describe1)
    end
end

---加载基础属性
---@param attributeKeys type_attribute_cfg[]
---@param attributes AttributeClass 属性类
function DungeonChallengeRoleTipView:LoadAttributes(attributeKeys, attributes)
    for _, attr in ipairs(attributeKeys) do
        if AttributeIcons[attr.attribute_type] then
            local value = attributes:GetValueByID(attr.id)
            if value and value > 0 then
                ---@type DungeonChallengeRoleTipView._obj_attributeItem_GoTable
                local item = _G.GetAutoGoTable(_G.InstantiateObject(
                    self.go_table.obj_attributeItem,
                    self.go_table.obj_attributeContent
                ))
                item.gameObject:SetActiveE(1)
                item.aorimage_icon.SpriteName = AttributeIcons[attr.attribute_type]
                item.aortext_name.text = _G.GetLangPackValue(attr.name)
                if attr.value_type == 2 then
                    item.aortext_value.text = string.format("%d%%", math.max(1, math.floor(value / 100)))
                else
                    item.aortext_value.text = value
                end
            end
        end
    end
end

---装备特性
---@param equips DungeonChallengeEquipData[] 装备列表
function DungeonChallengeRoleTipView:LoadEquipFeatures(equips)
    ---@type table<number,number>
    local features = {}
    if equips then
        for _, equip in ipairs(equips) do
            if not features[equip.cfg.featuretext] then
                features[equip.cfg.featuretext] = equip.cfg.featurenum
            else
                features[equip.cfg.featuretext] = features[equip.cfg.featuretext] + equip.cfg.featurenum
            end
        end
    end
    
    self.go_table.obj_featureTitle:SetActiveE(table.count(features) and 1 or 0)
    self.go_table.obj_featureContent:SetActiveE(table.count(features) and 1 or 0)


    for k, v in pairs(features) do
        local item = _G.GetAutoGoTable(_G.InstantiateObject(
            self.go_table.obj_featureItem,
            self.go_table.obj_featureContent
        ))
        item.gameObject:SetActiveE(1)
        item.aortext_featureItext.text = _G.GetLangPackValue(k, v .. "%")
    end
end

---计算战力值
---@param attributes AttributeClass 属性类
function DungeonChallengeRoleTipView:LoadPower(attributes)
    local power = attributes:CalculatePower()
    self.go_table.aortext_power.text = _G.GameUtil.NumberToImage(power)
end

---按钮点击事件在这里派发
function DungeonChallengeRoleTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return DungeonChallengeRoleTipView
