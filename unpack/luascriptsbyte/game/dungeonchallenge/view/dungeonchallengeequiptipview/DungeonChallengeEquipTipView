local DungeonChallengeEquipTipView_EquipItem = require("DungeonChallengeEquipTipView_EquipItem")

---@class DungeonChallengeEquipTipView : UIBaseView	装备合成闯关_装备tip页面
---@field go_table DungeonChallengeEquipTipView_GoTable
---@field items DungeonChallengeEquipTipView_EquipItem[]
---@field selectCallback fun(d:dungeon_challenge_equip_cfg):void      @选择回调
---@field selectData dungeon_challenge_equip_cfg                      @当前选择的装备
local DungeonChallengeEquipTipView = _G.BaseClass("DungeonChallengeEquipTipView", _G.UIBaseView)

function DungeonChallengeEquipTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param equipDatas dungeon_challenge_equip_cfg[]
---@param callback fun(d:dungeon_challenge_equip_cfg):void      @选择回调
function DungeonChallengeEquipTipView:OnCreate(equipDatas, callback)
    self.go_table.obj_item:SetActiveE(0)

    self.selectCallback = callback
    self.items = {}
    for i = 1, #equipDatas do
        local instance = _G.InstantiateObject(
            self.go_table.obj_item,
            self.go_table.obj_layout
        )
        instance:SetActiveE(1)
        ---@type DungeonChallengeEquipTipView_EquipItem
        local item = self:AddComponent(instance, DungeonChallengeEquipTipView_EquipItem.New(instance))
        item:SetData(equipDatas[i])
        item:SetCallback(_G.handlerbind(self, self.OnClickItem, item))
        table.insert(self.items, item)
    end

    --tip
    local isSelected = not not self.selectCallback
    self.go_table.obj_title:SetActiveE(isSelected and 1 or 0)
    self.go_table.obj_tip:SetActiveE(isSelected and 1 or 0)
    self.go_table.aorbtn_select:SetActiveE(0)
end

---点击装备
---@param item DungeonChallengeEquipTipView_EquipItem
function DungeonChallengeEquipTipView:OnClickItem(item)
    if not self.selectCallback then
        return
    end
    for _, node in ipairs(self.items) do
        node:SetSelectedActive(node == item)
        if node == item then
            self.selectData = node:GetData()
            self.go_table.aorbtn_select:SetActiveE(1)
        end
    end
end

---按钮点击事件在这里派发
function DungeonChallengeEquipTipView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if not self.selectCallback then
            self:Close()
        end
    elseif go == self.go_table.aorbtn_select then
        if self.selectCallback and self.selectData then
            self.selectCallback(self.selectData)
            self:Close()
        end
    end
end

return DungeonChallengeEquipTipView
