local FestivalModel = require "FestivalModel"
local base = require "ActivitySynTypeBase"
---@class PuzzleSynModel : Component	中文描述
local PuzzleSynModel = _G.BaseClass("PuzzleSynModel", base)
local realModelTable = {
    IceFestivalPuzzleView = "IceFestivalPuzzleModel",
}

---创建对象时,入口构造函数
function PuzzleSynModel:OnCreate()
    local precast = _G.string.split(self.curActivityClass.cfg.info.front.precast, "#")
    self.realModel = realModelTable[precast[1]]
end

function PuzzleSynModel:OnHandleGMData(info)
    self:ParseData(info)
end

function PuzzleSynModel:ParseData(info)
    local precast = _G.string.split(self.curActivityClass.cfg.info.front.precast, "#")
    self.realModel = require(realModelTable[precast[1]]).New(self.curActivityClass)
    self.curActivityClass.typeClass = self.realModel
    if self.realModel then 
        self.realModel:ParseData(info)
        return 
    end
    self.activity = self.curActivityClass
    base.ParseData(self)
    require "FestivalModel":GetInstance():GetInfoCall(info, self.curActivityClass)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointFestivalGift.id)
end

---进入活动主体
function PuzzleSynModel:OnEnterActivity()
    if self.realModel then 
        self.realModel:OnEnterActivity()
        return 
    end
    _G.UIManager:GetInstance():OpenWindow(FestivalModel:GetInstance():GetViewByIndex(1), self.activity)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function PuzzleSynModel:OnGetMainViewName()
    if self.realModel then 
        return self.realModel:OnGetMainViewName()
    end
    return FestivalModel:GetInstance():GetViewByIndex(1)
end

---绑定子活动
function PuzzleSynModel:GetOtherActivityRedPointIds()
    if self.realModel then 
        return self.realModel:GetOtherActivityRedPointIds()
    end
    return {10007, 10010}
end

---初始化红点
function PuzzleSynModel:InitRedPointTree()
    if self.realModel then 
        self.realModel:InitRedPointTree()
        return
    end
    self.checkRedPointFunc = {self.CheckPuzzleReward}
    self.redpointTree = {false, false}
end

---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function PuzzleSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function PuzzleSynModel:UpdateRedpoint()
    if self.realModel then 
        self.realModel:UpdateRedpoint()
        return
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointPuzzle.id)
end

function PuzzleSynModel:CheckPuzzleReward()
    if self.realModel then 
        return self.realModel:CheckPuzzleReward()
    end
    local puzzleRed = FestivalModel:GetInstance():GetRedPointNum()
    local giftRed = FestivalModel:GetInstance():CheckGiftRed()
    return (puzzleRed + giftRed) > 0 and 1 or 0
end


---销毁对象时,析构函数
function PuzzleSynModel:OnDestroy()
end

return PuzzleSynModel
