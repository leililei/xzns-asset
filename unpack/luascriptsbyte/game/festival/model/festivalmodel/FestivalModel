local ActivitySynManager = require "ActivitySynManager"
---@class FestivalModel : Singleton	中文描述
local FestivalModel = _G.BaseClass("FestivalModel", _G.GameDataModelBase)
_G.FestivalModel = FestivalModel

---@return FestivalModel FestivalModel
function FestivalModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function FestivalModel:__init()
    self.viewList = {}
end

function FestivalModel:GetInfoCall(info, curActivityClass)
   self.viewList = _G.string.split(curActivityClass.cfg.info.front.precast, "#")
    self.curActivityClass = curActivityClass
    local data = info.puzzle
    self.indexes = {}
    if data.indexes then
        for _, v in ipairs(data.indexes) do
            self.indexes[v] = true
        end
    end
    self.puzzle_awards = {}
    if data.puzzle_awards then
        for _, v in ipairs(data.puzzle_awards) do
            self.puzzle_awards[v] = true
        end
    end
    self.puzzles = {}
    for _, v in ipairs(data.cfg_puzzles) do
        self.puzzles[v.index] = v
    end
    self.awards = {}
    for _, v in ipairs(data.cfg_awards) do
        self.awards[v.index] = v
    end
    self.coin1_id = data.coin1_id
    self.coin2_id = data.coin2_id
    self.coins = {}
    self.coins[data.coin1_id] = data.coin_1 or 0
    self.coins[data.coin2_id] = data.coin_2 or 0
end

function FestivalModel:GetViewByIndex(index)
    return self.viewList[index]
end

---点亮拼图
---@param callback function 回调
function FestivalModel:UnlockIndex(index, callback)
    require "PuzzleNet":GetInstance():UnlockIndex(
        {activity_id = self.curActivityClass:GetActivityID(), index = index},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            self.indexes[index] = true
            local data = self.puzzles[index]
            local id = self["coin"..data.type.."_id"]
            --self.coins[id] = self.coins[id] - data.num
            local coins = {}
            if coins[id] == nil then
                coins[id] = 0
            end
            coins[id] = coins[id] - data.num
            self:SetCoin(coins)
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.curActivityClass.typeClass:UpdateRedpoint()
            if callback then
                callback()
            end
        end
    )
end

function FestivalModel:UpdateRedpoint()
    self.curActivityClass.typeClass:UpdateRedpoint()
end

---领取奖励
---@param callback function 回调
function FestivalModel:GetAward(index, callback)
    self.curActivityClass.typeClass:GetActivityAward({index}, function(msg)
        if callback then
            callback(msg)
            self.curActivityClass.typeClass:UpdateRedpoint()
        end
    end
    )
end

---获取拼图信息
function FestivalModel:GetPuzzleData()
    return self.puzzles
 end
 
 ---获取奖励信息
 function FestivalModel:GetAwardsData()
     return self.awards
 end

---自身活动代币增加（如锻造豪礼）
function FestivalModel:SetCoin(coins)
    if coins then
        for k, v in pairs(coins) do
            if self.coins[k] then
                self.coins[k] = self.coins[k] + v
                local tmp = {}
                _G.table.insert(tmp, k)
                _G.table.insert(tmp, v)
                _G.table.insert(tmp, self.coins[k])
                _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
            end
        end
        self.curActivityClass.typeClass:UpdateRedpoint()
    end
end

---获取国庆拼图道具1
function FestivalModel:GetCoinNum1()
    return self.coins[self.coin1_id]
end

---获取国庆拼图道具2
function FestivalModel:GetCoinNum2()
    return self.coins[self.coin2_id]
end

function FestivalModel:GetRedPointNum()
    if not require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10039) or not self.curActivityClass then
        return 0
    end
    for i = 1, 9 do
        if self.puzzle_awards[i] == nil then
            local isCanGet = true
            for _, v in ipairs(self.awards[i].conditions) do
                if self.indexes[v] == nil then
                    isCanGet = false
                    break
                end
            end
            if isCanGet then
                return 1
            end
        end
    end
    for i = 1, 16 do
        local iscanClick = false
        if self.indexes[i] == nil then
            local data = self.puzzles[i]
            local sid = self["coin"..data.type.."_id"]
            iscanClick = self.coins[sid] > 0
        end
        if iscanClick then
            return 1
        end
    end
    return 0
end

function FestivalModel:CheckGiftRed()
    if not require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10039) or not self.curActivityClass then
        return 0
    end
    local activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, self.curActivityClass:GetJumpType(self.curActivityClass:GetActivityID()))
    if not activity then
        return 0
    end
    local model_data = activity.typeClass:GetModelCfgByCondition(activity.activityID)
    local isSoldout = true
    for i = 1, #model_data do
        local data=model_data[i]
        local limit = data.count
        local buy_num = activity.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
        if limit ~= buy_num then
            isSoldout = false
            break
        end
    end
    if isSoldout == true then
        return 0
    end

    local num = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "FestivalGiftView", 0)
    if num == 0 then
        return 1
    else
        local time = num
        local time2 = self:GetTime()
        return time < time2 and 1 or 0
    end
end

function FestivalModel:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

---销毁对象时,析构函数
function FestivalModel:Dispose()
end

return FestivalModel
