---@class FestivalSignInModel : Singleton	中文描述
local FestivalSignInModel = _G.BaseClass("FestivalSignInModel", _G.GameDataModelBase)
_G.FestivalSignInModel = FestivalSignInModel

---获取签到对应数据
---@param index activity_sign.i_activity_sign
function FestivalSignInModel:GetInfoCall(index, curActivityClass)
    self.curActivityClass = curActivityClass
    --已领取的奖励id
    self.g_sids = index.sign.g_sids or {}
    --奖励item信息
    self.item = index.sign.item or {}
    for _, v in pairs(self.item) do
        if v.other_a then
            for k2, v2 in pairs(v.other_a) do
                if v.award == nil then
                    v.award = {}
                end
                _G.table.insert(v.award, {type = {v2.c_id, v2.num}})
            end
        end
    end
    --标题
    self.title = index.sign.title or {}
    self.login_days = curActivityClass.cfg.time.start_time
    self.titleHD = self.login_days - _G.table.count(self.g_sids)
end

function FestivalSignInModel:GetLoginDays()
    return _G.TimeUtil.GetIntervalDay(self.login_days,_G.TimeUtil.GetServerUnixTime())+1
end

---检测红点是否结束
function FestivalSignInModel:CheckIsOvers()
    if self.g_sids == nil then
        self.g_sids = {}
    end
    local login_days = self:GetLoginDays()
    if login_days > _G.table.count(self.g_sids) and _G.table.count(self.g_sids) < _G.table.count(self.item) then
        return true
    end
    return false
end

---创建对象时,入口构造函数
function FestivalSignInModel:__init()
end

---销毁对象时,析构函数
function FestivalSignInModel:Dispose()
end

return FestivalSignInModel
