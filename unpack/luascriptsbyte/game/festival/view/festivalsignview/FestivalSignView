local FestivalSignInModel = require "FestivalSignInModel"
local ActivitySynManager = require "ActivitySynManager"

---@class FestivalSignView : UIBaseView	中文描述
---@field public go_table FestivalSignView_GoTable GoTable
local FestivalSignView = _G.BaseClass("FestivalSignView", _G.UIBaseView)

function FestivalSignView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ItemList = {}
    --- 页签父对象
    self.itemList = {
        self.go_table.obj_parent1,
        self.go_table.obj_parent2,
        self.go_table.obj_parent3,
        self.go_table.obj_parent4,
        self.go_table.obj_parent5,
        self.go_table.obj_parent6,
        self.go_table.obj_parent7,
    }
end

---界面的入口函数
function FestivalSignView:OnCreate(activity)
    self.activity = activity
    self.typeCls = activity.typeClass
    self.resource = self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo,
                    _G.ConfigManager.ui_cfg.FestivalSignView.resources)
    )
    self.currenttab=1
    self:AddComponent(self.go_table.obj_playerInfo,
            require("PlayerComponent").New(self.go_table.obj_playerInfo))
    self:InitView()
    self:XianShiTiem()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.InitView)
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_feisha_BG,
            self.go_table.obj_effect,
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
            end
    )
    for k,v in pairs(self.ItemList) do
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_weiyan,
                v.obj_effect,
                function(obj)
                    if _G.IsNil(self.go_table) then
                        _G.UIUtils.RemoveEffect(obj)
                        return
                    end
                end
        )
    end
end

function FestivalSignView:InitView()
    self.RewardDatas = FestivalSignInModel:GetInstance().item
    _G.table.sort(self.RewardDatas, function(a, b)
        return a.sid < b.sid
    end)
    self.g_sids = FestivalSignInModel:GetInstance().g_sids
    self.login_days = FestivalSignInModel:GetInstance():GetLoginDays()
    self.title = FestivalSignInModel:GetInstance().title
    self:InitCurrentTable()
    self:RefreshBtn()
    for i = 1, 7 do
        local item=_G.InstantiateObject(self.go_table.obj_item,self.itemList[i])
        item:SetActiveE(1)
        item:SetLocalPosition(0,0,0)
        self:OnInitItem(i, item)
    end
end

function FestivalSignView:InitCurrentTable()
    local index=1
     local isGet=false
    for i = 1, #self.RewardDatas do
        isGet = _G.table.ContainsValue(self.g_sids, i)
        if self.login_days >= i and not isGet then
            index=i
            break
        end
    end
    if index==1 then
        index=self.login_days
    end
    local currentTable=index//7
    if index%7>0 then
        currentTable=currentTable+1
    end
    self.currenttab=currentTable
end

---@param i number
function FestivalSignView:OnInitItem(i, item)
    local eIndex = i+(self.currenttab-1)*7
    local ctrl = _G.GetAutoGoTable(item)
    _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, eIndex))
    self.ItemList[i] = ctrl
    ctrl.index = eIndex
    local data = self.RewardDatas[eIndex]
    if data then
        ctrl.aortext_title.text = _G.LangUtil.GetLangPackValue(90023800006,data.sid)
        local isGet = _G.table.ContainsValue(self.g_sids, eIndex)
        ctrl.obj_got:SetActiveE(isGet and 1 or 0)
        ctrl.obj_get:SetActiveE((self.login_days >= eIndex and not isGet) and 1 or 0)
        ctrl.aorbtn_getAward:SetActiveE((self.login_days >= eIndex and not isGet) and 1 or 0)
        local awarddata={}
        if data.award[1].type[1]~=0 then
            table.insert(awarddata,data.award[1].type[1])
            table.insert(awarddata,data.award[1].type[2])
        else
            table.insert(awarddata,data.award[1].type[4])
            table.insert(awarddata,data.award[1].type[5])
        end
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                awarddata,
                ctrl.obj_awards,
                function(v)
                    v.gameObject:SetLocalScaleXYZ(1)
                    _G.GameUtil.SetActiveByCondition(v.gameObject, true)
                    v:ShowEffect(self.login_days >= eIndex and not isGet)
                    v.gameObject:SetLocalPosition(0, 0, 0)
                    v:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end)
    end
end
function FestivalSignView:RefreshItem(index)
    if self.RewardDatas[index] then
        local _index=index%7==0 and 7 or index%7
        local ctrl= self.ItemList[_index]
        _G.AddViewBtnClick(ctrl.gameObject, _G.handlerbind(self, self.OnItemClickBtn, index))
        local data = self.RewardDatas[index]
        if data then
            ctrl.aortext_title.text = _G.LangUtil.GetLangPackValue(90023800006,data.sid)
            local isGet = _G.table.ContainsValue(self.g_sids, index)
            ctrl.obj_got:SetActiveE(isGet and 1 or 0)
            ctrl.obj_get:SetActiveE((self.login_days >= index and not isGet) and 1 or 0)
            ctrl.aorbtn_getAward:SetActiveE((self.login_days >= index and not isGet) and 1 or 0)
            local awarddata={}
            if data.award[1].type[1]~=0 then
                table.insert(awarddata,data.award[1].type[1])
                table.insert(awarddata,data.award[1].type[2])
            else
                table.insert(awarddata,data.award[1].type[4])
                table.insert(awarddata,data.award[1].type[5])
            end
            ctrl.obj_awards:ClearChildren()
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    awarddata,
                    ctrl.obj_awards,
                    function(v)
                        v.gameObject:SetLocalScaleXYZ(1)
                        _G.GameUtil.SetActiveByCondition(v.gameObject, true)
                        v:ShowEffect(self.login_days >= index and not isGet)
                        v.gameObject:SetLocalPosition(0, 0, 0)
                        v:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end)
        end
    end
end

---点击选中
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function FestivalSignView:OnItemClickBtn(_, _, X)
    self.typeCls:GetAward(
        X,
        function(msg)
            if msg.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                _G.table.insert(FestivalSignInModel:GetInstance().g_sids, X)
                self:RefreshItem(X)
                self.typeCls:RefreshRedPoint()
            end
        end
    )
end

---显示时间更新
function FestivalSignView:XianShiTiem()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.GiftPackGroupTime(self.time))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

function FestivalSignView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.GiftPackGroupTime(self.time))
    end
end

---界面的销毁函数
function FestivalSignView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end
function FestivalSignView:RefreshBtn()
    self.go_table.aorbtn_left:SetActiveE(self.currenttab>1 and 1 or 0)
    self.go_table.aorbtn_Right:SetActiveE((self.currenttab<(#self.RewardDatas/7) and 1 or 0))
end
function FestivalSignView:RefereshAllItem()
    for i =(self.currenttab-1)*7+1, self.currenttab*7 do
        self:RefreshItem(i)
    end
end

---按钮点击事件在这里派发
function FestivalSignView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go==self.go_table.aorbtn_left then
        self.currenttab=self.currenttab-1
        self:RefreshBtn()
        self:RefereshAllItem()
    elseif go==self.go_table.aorbtn_Right then
        self.currenttab=self.currenttab+1
        self:RefreshBtn()
        self:RefereshAllItem()
    end
end

---析构函数
function FestivalSignView:Dispose()
    self:RemoveAllListener()
end

return FestivalSignView