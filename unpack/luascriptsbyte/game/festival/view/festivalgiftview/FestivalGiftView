local ActivitySynManager = require "ActivitySynManager"
local FestivalModel = require "FestivalModel"
---@class FestivalGiftView : UIBaseView	中文描述
---@field public go_table FestivalGiftView_GoTable GoTable
local FestivalGiftView = _G.BaseClass("FestivalGiftView", _G.UIBaseView)
local StorageManager, UIUtils
function FestivalGiftView:Awake()
    UIUtils = _G.UIUtils
    StorageManager = _G.StorageManager:GetInstance()
    self.mScorll = nil
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]
end

---界面的入口函数
function FestivalGiftView:OnCreate(data, type_enum)
    self.GetJumpType = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, data:GetJumpType())
    self.ActivityID = self.GetJumpType.activityID
    self:AddComponent(
        self.go_table.obj_GoldInfo,
        require "ResourceCompont".New(self.go_table.obj_GoldInfo, _G.ConfigManager.ui_cfg.FestivalGiftView.resources)
    )
    self.go_table_view = self.go_table
    self:UpdateView(data, type_enum)
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "FestivalGiftView", FestivalModel:GetInstance():GetTime())
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointFestivalGift.id)
    FestivalModel:GetInstance():UpdateRedpoint()
    self:XianShiTiem()
end

---显示时间更新
function FestivalGiftView:XianShiTiem()
    local t
    t, self.time = self.GetJumpType:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    --local QD = _G.TimeUtil.GetInterValDayByGame(KaiFu + ZuiDa, _G.TimeUtil:GetServerUnixTime())
end

function FestivalGiftView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    end
end

---刷新
function FestivalGiftView:UpdateView(data, type_enum)
    data.typeClass:UpdateDynamicData(self.ActivityID)
    self.model_data = data.typeClass:GetModelCfgByCondition(self.ActivityID)
    self.typeClass = data.typeClass
    self.data = data
    if type_enum then
        self.type_enum = type_enum
    else
        self.type_enum = 1
    end

    self:SetItemView()
end

function FestivalGiftView:SetItemView()
    for i = 1, #self.model_data do
        self.go_table_view["obj_item"..i]:SetActiveE(1)
        self:UpdateCommonItem(self.go_table_view["obj_item"..i], self.model_data[i])
    end
end

---@param obj SuperScrollView.LoopListViewItem2
---@param data activity_cash_gift.i_cash_gift
function FestivalGiftView:UpdateCommonItem(obj, data)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemOnClickBtn, data))
    local limit = data.count_limit
    if self.type_enum == 2 then
        limit = data.count
    end
    local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
    
    if limit - buy_num > self.limitTimesCond then
       tb.aortext_num:SetActiveE(0)
    else
        tb.aortext_num:SetActiveE(1)
        tb.aortext_num.text = _G.LangUtil.TryGetLangValue(90021600042, limit - buy_num)
    end
    tb.aorbtn_star:SetActiveE(limit == buy_num and 0 or 1)
    tb.aorimage_soldout:SetActiveE(limit == buy_num and 1 or 0)
    tb.aorimage_soldout:SetGray(true)
    tb.aortext_giftname.text = data.name
    tb.aortext_discount.text = math.floor(data.discount * 0.01) .. "%"
    if data.price == 0 then
        tb.aortext_price.text = ""
        tb.aortext_price.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        tb.aortext_price.text = ""
        local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(data.price)
        if info then
            tb.aortext_price.text = info.formattedPrice
        else
            local curPrice = _G.GameUtil.RatioControl(data.price)
            if _G.AppSetting.IsOverseas then
                tb.aortext_price.text = _G.LangUtil.GetLangPackValue(90000010807) .. curPrice
            else
                tb.aortext_price.text = _G.LangUtil.GetLangPackValue(90000010819, curPrice)
            end
        end
    else
        tb.aortext_price.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({data.consume_type,data.price})
        if item then
            tb.aorrawimage_icon:LoadImage(item.Icon)
        end
    end
    tb.aorrawimage_icon:SetActiveE(data.consume_type == 0 and 0 or 1)
    local awrad = data.goods
    tb.obj_AwardNode:RemoveAllChildren()
    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awrad[j],
            tb.obj_AwardNode,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                if j > 1 then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                else
                    local effect = _G.ConfigManager.ui_effect_cfg.ef_FestivalGiftView_cai
                    _G.UIUtils.LoadEffectByCfg(
                        effect,
                        item.go_table.obj_uieffect,
                        function(trans)
                            trans:SetLocalScaleXYZ(0.73)
                        end
                    )
                end
            end
        )
    end
end

function FestivalGiftView:itemOnClickBtn(go, isOn, giftinfo)
    if not self.data:CheckActivityInteractable() then
        return
    end
    self.cashData = giftinfo
    self.typeClass:Chongzhi(
        giftinfo,
        function()
            if self:IsNil() then
                return
            end
            --这里保留一个回调处理领奖
            self:SetItemView()
            -- if not self.typeClass:CheckOtherConditionExtra() then
            --     self.data:ChangeState(1) -- 改变状态 关闭
            -- end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointFestivalGift.id)
            FestivalModel:GetInstance():UpdateRedpoint()
        end
    )
end


function FestivalGiftView:OnMallCashListener(data)
    if not self.typeClass:CheckOtherConditionExtra() then
        self.data:ChangeState(1) -- 改变状态 关闭
    end
    -- self.cashData = nil
end

---界面的销毁函数
function FestivalGiftView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---按钮点击事件在这里派发
function FestivalGiftView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_info1 then
        local cardId = FestivalModel:GetInstance():GetViewByIndex(5)
        local cardSkinId = FestivalModel:GetInstance():GetViewByIndex(7)
        if cardId then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                tonumber(cardId),
                nil,
                false,nil,nil,nil,nil,nil,nil,nil,tonumber(cardSkinId)
            )
        end
    elseif go == self.go_table.aorbtn_info2 then
        local cardId = FestivalModel:GetInstance():GetViewByIndex(6)
        local cardSkinId = FestivalModel:GetInstance():GetViewByIndex(8)
        if cardId then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                tonumber(cardId),
                nil,
                false,nil,nil,nil,nil,nil,nil,nil,tonumber(cardSkinId)
            )
        end
    end
end

return FestivalGiftView