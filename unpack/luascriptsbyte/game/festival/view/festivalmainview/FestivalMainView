local FestivalMainView = _G.BaseClass("FestivalMainView", _G.UIBaseView)

function FestivalMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
