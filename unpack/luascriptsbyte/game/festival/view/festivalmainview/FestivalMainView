---开始时间~结束时间  (日月)
function FestivalMainView:InitActivityTime()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.GiftPackGroupTime(self.time))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

function FestivalMainView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.GiftPackGroupTime(self.time))
    end
end

---初始化活动Item
function FestivalMainView:InitActivityItem()
    if not self.activityItemList then
        self.activityItemList = {}
    end
    self:RefreshActivityItem(10010, self.go_table.obj_activityItem1)
    self:RefreshActivityItem(10065, self.go_table.obj_activityItem2)
    self:RefreshActivityItem(10064, self.go_table.obj_activityItem3)
    self:RefreshActivityItem(10041, self.go_table.obj_activityItem4)
    self:RefreshActivityItem(10048, self.go_table.obj_activityItem5)
    self:RefreshActivityItem(10044, self.go_table.obj_activityItem6)
end

function FestivalMainView:RefreshActivityItem(jumpType, obj)
    local tb = self.activityItemList[jumpType]
    if not self.activityItemList[jumpType] then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickActivity, jumpType))
        self.activityItemList[jumpType] = tb
    end
    tb.interValDay = 0
    tb.tipContent = nil
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(jumpType,
            self.activity:GetJumpType(self.activityId))
    if activity then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
        tb.obj_lock:SetActiveE(0)
    else
        activity = ActivitySynManager:GetInstance():GetNotOpenAcitivity(jumpType,
                self.activity:GetJumpType(self.activityId))
        if activity then
            tb.obj_lock:SetActiveE(1)
            tb.obj_eff:SetActiveE(0)
            local isPass, content = self:CheckConditionPatams(activity.info)
            if not isPass then
                tb.tipContent = content
                tb.aortext_lockTip.text = content
            else
                tb.interValDay = _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(),
                        activity.time.start_time)
                tb.aortext_lockTip.text = _G.GetLangPackValue(
                        90028300082,
                        tb.interValDay
                )
            end
        else
            tb.obj_lock:SetActiveE(0)
            tb.obj_eff:SetActiveE(1)
        end
    end
end

---检测GM活动限制条件
---@param params table 限制条件{{type=t,value=param, list = list},{type=t,value=param}}
---@return boolean 是否满足显示条件
function FestivalMainView:CheckConditionPatams(params)
    params = params.front
    if not params then
        return true
    end
    params = params.con
    if not params then
        return true
    end
    for i = 1, #params do
        local isPass, _, content = _G.GlobalConditionManager.CheckConditionArrays(
                { { params[i].type, params[i].value, params[i].list } }
        )
        if not isPass then
            return false, content
        end
    end
    return true
end

function FestivalMainView:OnClickActivity(_, _, type)
    if self.activityItemList[type] then
        if self.activityItemList[type].tipContent then
            _G.PopWindowManager:GetInstance():ShowAllTips(1515, self.activityItemList[type].tipContent)
            return
        end
        if self.activityItemList[type].interValDay > 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    1515,
                    nil,
                    nil,
                    nil,
                    nil,
                    nil,
                    self.activityItemList[type].interValDay
            )
            return
        end
    end
    _G.GlobalInterface.JumpActivityByGM(type, self.activity:GetJumpType(self.activityId))
end

function FestivalMainView:OnCloseActivity(activityId)
    if self.activityId == activityId then
        self:Close()
    end
end
function FestivalMainView:AddEffect()
    local tb=self.activityItemList[10010]
    self:InitEffect(tb.obj_eff,_G.ConfigManager.ui_effect_cfg.ef_JRQD_yanhua)
    tb=self.activityItemList[10064]
    self:InitEffect(tb.obj_eff,_G.ConfigManager.ui_effect_cfg.ef_RYJJ_baige)
    tb=self.activityItemList[10048]
    self:InitEffect(tb.obj_eff,_G.ConfigManager.ui_effect_cfg.ef_GQDH_BG)
end
function FestivalMainView:InitEffect(parent,cfg)
    _G.UIUtils.LoadEffectByCfg(
            cfg,
            parent,
            function(obj)
                if _G.IsNil(self.go_table) then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
            end
    )
end

---界面的销毁函数
function FestivalMainView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function FestivalMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 155)
    end
end

return FestivalMainView