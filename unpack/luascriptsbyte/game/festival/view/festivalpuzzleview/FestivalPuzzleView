local ActivitySynManager = require "ActivitySynManager"
local FestivalModel = require "FestivalModel"
---@class FestivalPuzzleView : UIBaseView	中文描述
---@field public go_table FestivalPuzzleView_GoTable GoTable
local FestivalPuzzleView = _G.BaseClass("FestivalPuzzleView", _G.UIBaseView)

function FestivalPuzzleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask, self.RefreshTask)
end

---界面的入口函数
function FestivalPuzzleView:OnCreate(activity)
    self.curIndex = 1
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.isInited = false
    self:AddComponent(
        self.go_table.obj_GoldInfo,
        require "ResourceCompont".New(self.go_table.obj_GoldInfo, _G.ConfigManager.ui_cfg.FestivalPuzzleView.resources)
    )
    self:SetResView()
    self:RefreshTask()
    self:SetPuzzleView()
    self:SetPuzzleRewardView()
    self:XianShiTiem()
end

---资源
function FestivalPuzzleView:SetResView()
    self.res = self.activityCls.res_prop
    self.resNum = {}
    for i = 1, 2 do
        local sid = FestivalModel:GetInstance()["coin"..i.."_id"]
        local num = FestivalModel:GetInstance().coins[sid]--_G.StorageManager:GetInstance():GetItemCountBySid(sid)
        self.resNum[sid] = num
        self.go_table["aortext_res"..i].text = "x"..num
    end
    if self.resIcon == nil then
        for i = 1, 2 do
            local sid = FestivalModel:GetInstance()["coin"..i.."_id"]
            local path = _G.ConfigManager.currency_type_client_cfg[sid].icon
            self.go_table["aorrawimage_res"..i]:LoadImage(path)
        end
        self.resIcon = true
    end
end

---拼图界面
function FestivalPuzzleView:SetPuzzleView()
    self.puzzleDatas = FestivalModel:GetInstance():GetPuzzleData()
    self.awardsData = FestivalModel:GetInstance():GetAwardsData()
    self.indexes = FestivalModel:GetInstance().indexes
    self.puzzle_awards = FestivalModel:GetInstance().puzzle_awards
    --拼图
    if self.puzzleItems == nil then
        self.puzzleItems = {}
        for i = 1, 16 do
            local obj = _G.InstantiateObject(self.go_table.obj_itemPuzzle, self.go_table.obj_itemRoot)
            local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPuzzle, i))
            local data = self.puzzleDatas[i]
            local sid = FestivalModel:GetInstance()["coin"..data.type.."_id"]
            local path = _G.ConfigManager.currency_type_client_cfg[sid].icon
            go_table.aorrawimage_icon:LoadImage(path)
            go_table.id = sid
            obj:SetActiveE(1)
            self.puzzleItems[i] = go_table
        end
    end
    for i = 1, 16 do
        local go_table = self.puzzleItems[i]
        local isGet = self.indexes[i]
        local iscanClick = false
        if self.indexes[i] == nil then
            iscanClick = self.resNum[go_table.id] > 0
        end
        go_table.obj_des:SetActiveE(iscanClick and 1 or 0)
        if iscanClick then
            local effect = _G.ConfigManager.ui_effect_cfg.ef_FestivalPuzzleView_kuang_loop
            _G.UIUtils.LoadEffectByCfg(
                effect,
                go_table.obj_des,
                function(trans)
                    trans:SetLocalScaleXYZ(1)
                    trans:SetLocalPosition(0,29.3,0)
                end
            )
        end
        go_table.aorrawimage_have:SetActiveE((isGet or iscanClick) and 1 or 0)
        local color
        if isGet or iscanClick then
            color = _G.Color.New(1, 1, 1, 1)
        else
            color = _G.Color.New(89 / 255, 89 / 255, 89 / 255, 1)
        end
        go_table.aorrawimage_icon.color = color
    end
end

---点亮拼图
function FestivalPuzzleView:OnClickPuzzle(go, isOn, index)
    if self.indexes[index] == nil then
        local iscanClick = self.resNum[self.puzzleItems[index].id] > 0
        if iscanClick then
            FestivalModel:GetInstance():UnlockIndex(
                index,
                function()
                    self:SetResView()
                    self:SetPuzzleView()
                    self:SetPuzzleRewardView()
                    local effect = _G.ConfigManager.ui_effect_cfg.ef_FestivalPuzzleView_jihuo
                    _G.UIUtils.LoadEffectByCfg(
                        effect,
                        self.puzzleItems[index].obj_effect,
                        function(trans)
                            trans:SetLocalScaleXYZ(1)
                        end
                    )
                end
            )
        end
    end
end

function FestivalPuzzleView:SetPuzzleRewardView()
    --拼图奖励
    if self.puzzleRewardItems == nil then
        self.puzzleRewardItems = {}
        for i = 1, 9 do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                self.awardsData[i].award[1].type,
                self.go_table["obj_item"..i],
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(1)
                    if self.awardsData[i].award[1].type[2] > 1 then
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    else
                        tran:ShowNumText(false)
                    end
                    self.puzzleRewardItems[i] = tran
                    tran:SetGou(self.puzzle_awards[i])
                    if self.puzzle_awards[i] == nil then
                        local isCanGet = true

                        for _, v in ipairs(self.awardsData[i].conditions) do
                            if self.indexes[v] == nil then
                                isCanGet = false
                                break
                            end
                        end
                        tran:ShowEffectOrder(isCanGet and true or false)
                        self.go_table["obj_redpoint"..i]:SetActiveE(isCanGet and 1 or 0)
                    else
                        tran:ShowEffectOrder(false)
                        self.go_table["obj_redpoint"..i]:SetActiveE(0)
                    end
                end,
                function(go, isOn)
                    local isCanGet = true
                    if self.puzzle_awards[i] == nil then
                        for _, v in ipairs(self.awardsData[i].conditions) do
                            if self.indexes[v] == nil then
                                isCanGet = false
                                break
                            end
                        end
                        if isCanGet then
                            FestivalModel:GetInstance():GetAward(
                                i,
                                function(msg)
                                    if msg.ack == 1 then
                                        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                                        FestivalModel:GetInstance().puzzle_awards[i] = true
                                        self:SetPuzzleRewardView()
                                    end
                                end
                            )
                        else
                            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, self.awardsData[i].award[1].type[1])
                        end
                    end
                end
            )
        end
    else
        for i = 1, 9 do
            self.puzzleRewardItems[i]:SetGou(self.puzzle_awards[i])
            if self.puzzle_awards[i] == nil then
                local isCanGet = true
               
                for _, v in ipairs(self.awardsData[i].conditions) do
                    if self.indexes[v] == nil then
                        isCanGet = false
                        break
                    end
                end
                self.puzzleRewardItems[i]:ShowEffectOrder(isCanGet and true or false)
                self.go_table["obj_redpoint"..i]:SetActiveE(isCanGet and 1 or 0)
            else
                self.puzzleRewardItems[i]:ShowEffectOrder(false)
                self.go_table["obj_redpoint"..i]:SetActiveE(0)
            end
        end
    end
end

---任务刷新
function FestivalPuzzleView:RefreshTask()
    -- if self.taskDataList == nil then
        self.taskDataList = {}
        self.taskDataList[1] = self.activityCls:GetTaskDatasByType(1)
        self.taskDataList[2] = self.activityCls:GetTaskDatasByType(2)
    -- end
    if self.taskToggleRed == nil then
        self.taskToggleRed = {}
        self.taskToggleRed[1] = _G.GetAutoGoTable(self.go_table.toggle_task1).obj_redpointTask1
        self.taskToggleRed[2] = _G.GetAutoGoTable(self.go_table.toggle_task2).obj_redpointTask2
    end
    self.taskDatas = self.taskDataList[self.curIndex]
    self:SortTask()
    if not self.isInited then
        self.go_table.scrollloopvectical_task:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
        self.isInited = true
    else
        self.go_table.scrollloopvectical_task:UpdateCount(#self.taskDatas)
    end
    for i = 1, 2 do
        local isCanGet = false
        for _, v in ipairs(self.taskDataList[i]) do
            if v.i_task.state == _G.TaskEnum.ETaskState.Submited and not self.activityCls:CheckIsGet(v.Cfg.id) then
                isCanGet = true
                break
            end
        end
        self.taskToggleRed[i]:SetActiveE(isCanGet and 1 or 0)
    end
end

function FestivalPuzzleView:RefreshTaskItem(index, obj)
    ---@type DrawUpBattlePassTaskView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local data = self.taskDatas[index + 1]
    go_table.aortext_hzExp.text = data.Cfg.other_award[1].num
    go_table.aortext_info.text = data.Cfg.desc
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        self:SetTaskItemjd(go_table.aorimage_jd, data.Cfg.count, data.Cfg.count)
        go_table.aortext_jd.text = _G.string.format("%s/%s", data.Cfg.count, data.Cfg.count)
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
    else
        self:SetTaskItemjd(go_table.aorimage_jd, data.i_task.target[1], data.Cfg.count)
        go_table.aortext_jd.text = _G.string.format("%s/%s", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        --if data.Cfg.link and data.Cfg.link ~= 0 then
        if data.Cfg.link and data.Cfg.link ~= 0 then
            go_table.aorbtn_way:SetGray(false)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
            go_table.aorbtn_way.interactable = true
        else
            go_table.aorbtn_way:SetGray(true)
            go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90020400086)
            go_table.aorbtn_way.interactable = false
        end
        go_table.aorimage_over:SetActiveE(0)
    end

    for i = 1, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i].type,
            go_table.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(1)
                if data.Cfg.reward[i].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

---设置任务进度
function FestivalPuzzleView:SetTaskItemjd(aorimage, value, loopValue_Max)
    local w = value / loopValue_Max
    if w > 1 then
        w = 1
    end
    aorimage:SetRectTransformSize(value > 0 and w * (186) or 0, 14)
end

---点击任务
function FestivalPuzzleView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local data = self.taskDatas[index]
    if name == "@_aorbtn_get" then
        self.activityCls:GetAward(
            { data.i_task.sid },
            function()
                self:SetResView()
                self:RefreshTask()
                self:SetPuzzleView()
            end
        )
    elseif name == "@_aorbtn_way" then
        ---策划需求（跳转到对应的界面（专门针对跳当前页面设置（黄东要求，紫薯提议！）
        -- if 162001 == data.Cfg.link then
        --     self:Close()
        --     return
        -- end

        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

function FestivalPuzzleView:SortTask()
    ---@param data DrawUpBattlePassTaskData
    _G.SortList(
        self.taskDatas,
        function(data)
            local index = 1
            if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                index = 2
                if self.activityCls:CheckIsGet(data.i_task.sid) then
                    index = -1
                end
            end
            return index, -data.i_task.sid
        end
    )
end

---显示时间更新
function FestivalPuzzleView:XianShiTiem()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
    self.go_table.aortext_time.text = _G.TimeUtil.GiftPackGroupTime(self.time)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    --local QD = _G.TimeUtil.GetInterValDayByGame(KaiFu + ZuiDa, _G.TimeUtil:GetServerUnixTime())
end

function FestivalPuzzleView:UpdateTime(elapsed)
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.TimeUtil.GiftPackGroupTime(Mathf.RoundToInt(self.time))
    end
end

---界面的销毁函数
function FestivalPuzzleView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function FestivalPuzzleView:OnClickBtn(go, isOn)
    if go == self.go_table.toggle_task1 then
        if isOn == true then
            self.curIndex = 1
            self:RefreshTask()
        end
    elseif go == self.go_table.toggle_task2 then
        if isOn == true then
            self.curIndex = 2
            self:RefreshTask()
        end
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return FestivalPuzzleView