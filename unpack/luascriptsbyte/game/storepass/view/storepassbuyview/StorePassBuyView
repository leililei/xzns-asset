local StorePassModel = require("StorePassModel")

---@class StorePassBuyView : UIBaseView	中文描述
---@field go_table StorePassBuyView_GoTable
local StorePassBuyView = _G.BaseClass("StorePassBuyView", _G.UIBaseView)

function StorePassBuyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function StorePassBuyView:OnCreate()
    local cfg = StorePassModel:GetInstance():GetCycleCfg()
    self.cfg = cfg
    local buyClass = StorePassModel:GetInstance():GetBuyClass()
    local seniorCfg = _G.ConfigManager.store_passport_gift_cfg[cfg.passport_gift[1]]
    local finalPriceor = require "MallManager":GetInstance():GetFinalPrice(seniorCfg.price_id)
    self.go_table.aorimage_discount:SetActiveE(buyClass == 0 and 1 or 0)
    self.go_table.obj_oldPrice:SetActiveE(buyClass == 0 and 1 or 0)
    self.go_table.aorbtn_buy1:SetActiveE(buyClass < 2 and 1 or 0)
    self.go_table.aorbtn_buy2:SetActiveE(buyClass < 1 and 1 or 0)
    self.go_table.aorimage_hasBuy1:SetActiveE(buyClass == 2 and 1 or 0)
    self.go_table.aorimage_hasBuy2:SetActiveE(buyClass > 0 and 1 or 0)
    if _G.AppSetting.IsDouYinIos or _G.AppSetting.IsAlipayIos then
        self.go_table.aorimage_discount:SetActiveE(0)
        ---@type UnityEngine.UI.HorizontalLayoutGroup
        local layout = self.go_table.obj_layout:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
        layout.spacing = -64
    end
    local supremeCfg
    _G.GameUtil.AddDouYinIcon(self.go_table.obj_oldPrice, false, nil, nil, nil, nil, true)
    _G.GameUtil.AddDouYinIcon(self.go_table.obj_price, false)
    _G.GameUtil.AddDouYinIcon(self.go_table.aorbtn_buy2, false)
    if buyClass == 0 then
        supremeCfg = _G.ConfigManager.store_passport_gift_cfg[cfg.passport_gift[2]]
        local finalPriceme = require "MallManager":GetInstance():GetFinalPrice(supremeCfg.price_id)
        self:SetPrice(self.go_table.aortext_price1, finalPriceme, supremeCfg.price_id)

        self:SetPrice(self.go_table.aortext_price2, finalPriceor, seniorCfg.price_id)
        local splitCfg = _G.ConfigManager.store_passport_gift_cfg[cfg.passport_gift[3]]
        local _, price1 = _G.GameUtil.SetPriceByChannel(splitCfg.price_id)
        local _, price2 = _G.GameUtil.SetPriceByChannel(seniorCfg.price_id)
        self.go_table.aortext_oldPrice.text = _G.GameUtil.GetPriceContentByNum(price1 + price2, true)
    elseif buyClass == 1 then
        supremeCfg = _G.ConfigManager.store_passport_gift_cfg[cfg.passport_gift[3]]
        local finalPriceme = require "MallManager":GetInstance():GetFinalPrice(supremeCfg.price_id)
        self:SetPrice(self.go_table.aortext_price1, finalPriceme, supremeCfg.price_id)
        self:SetPrice(self.go_table.aortext_price2, finalPriceor, seniorCfg.price_id)
    else
        supremeCfg = _G.ConfigManager.store_passport_gift_cfg[cfg.passport_gift[2]]
    end
    self.seniorCfg = seniorCfg
    self.supremeCfg = supremeCfg

    self.countDown = StorePassModel:GetInstance():GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateTime(0)

    self:InitAwardLis()
    self.go_table.scrollloophorizontal_award2:InitItemData(
        #self.seniorAwards,
        _G.handler(self, self.RefreshSeniorAward)
    )
    self.go_table.scrollloophorizontal_award1:InitItemData(
        #self.supremeAwards,
        _G.handler(self, self.RefreshSupremeAward)
    )
    self:LoadEffect()
end

function StorePassBuyView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_txz_boxfaguang, self.go_table.obj_boxEff, check)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_txz_zhizunjiangli,
        self.go_table.aorimage_title1,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetLocalPosition(-116, 0, 0)
            trans:SetLocalScaleXYZ(0.64)
        end
    )
end

function StorePassBuyView:SetPrice(obj, price, price_id)
    _G.GameUtil.SetPriceByChannel(price_id, obj)
end

function StorePassBuyView:InitAwardLis()
    local seniorAwardDic = {}
    local surpremeAwardDic = {}
    local cfg
    for _, v in pairs(self.cfg.passport_content) do
        cfg = _G.ConfigManager.store_passport_content_cfg[v]
        for _, award in pairs(cfg.rewards_pay1) do
            if not seniorAwardDic[award[1]] then
                seniorAwardDic[award[1]] = award[2]
            else
                seniorAwardDic[award[1]] = seniorAwardDic[award[1]] + award[2]
            end
        end
        for _, award in pairs(cfg.rewards_pay2) do
            if not surpremeAwardDic[award[1]] then
                surpremeAwardDic[award[1]] = award[2]
            else
                surpremeAwardDic[award[1]] = surpremeAwardDic[award[1]] + award[2]
            end
        end
    end
    local seniorAwardLis = {}
    local surpremeAwardLis = {}

    for _, v in pairs(self.seniorCfg.goods1) do
        _G.table.insert(seniorAwardLis, v)
    end
    for sid, num in pairs(seniorAwardDic) do
        _G.table.insert(seniorAwardLis, { sid, num })
    end

    for _, v in pairs(self.supremeCfg.goods1) do
        _G.table.insert(surpremeAwardLis, v)
    end
    for sid, num in pairs(surpremeAwardDic) do
        _G.table.insert(surpremeAwardLis, { sid, num })
    end
    self.seniorAwards = seniorAwardLis
    self.supremeAwards = surpremeAwardLis
end

function StorePassBuyView:RefreshSeniorAward(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.seniorAwards[index]
    tb.obj_root:ClearChildren()
    self:CreateItem(data, tb.obj_root)
end

function StorePassBuyView:RefreshSupremeAward(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    local data = self.supremeAwards[index]
    tb.obj_root:ClearChildren()
    self:CreateItem(data, tb.obj_root)
end

function StorePassBuyView:CreateItem(data, parent)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        parent,
        function(trans)
            trans:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            _G.DelayDo(
                0.35,
                function()
                    if self:IsNil() then
                        return
                    end
                    trans:ShowEffectOrder(true)
                end
            )
        end
    )
end

function StorePassBuyView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51")
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(90025500007, time)
end

function StorePassBuyView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_buy1 then
        local buyClass = StorePassModel:GetInstance():GetBuyClass()
        if buyClass == 2 then
            return
        end
        require "MallManager":GetInstance():BuyActiveGift(self.supremeCfg.price_id, nil, self.supremeCfg.id)
        self:Close()
    elseif go == self.go_table.aorbtn_buy2 then
        local buyClass = StorePassModel:GetInstance():GetBuyClass()
        if buyClass >= 1 then
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTipsExtend(
            1090001,
            nil,
            function()
            end,
            function()
        require "MallManager":GetInstance():BuyActiveGift(self.seniorCfg.price_id, nil, self.seniorCfg.id)
                self:Close()
            end,
            nil,
            nil,
            {notCall = true}
        )
    end
end

function StorePassBuyView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---销毁对象时,析构函数
function StorePassBuyView:OnDestroy()
end

return StorePassBuyView
