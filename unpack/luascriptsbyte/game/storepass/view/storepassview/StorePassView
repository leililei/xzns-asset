local StorePassModel = require("StorePassModel")
local BaseAwardNewItem = require("BaseAwardNewItem")

---@class StorePassView : UIBaseView	中文描述
---@field go_table StorePassView_GoTable
local StorePassView = _G.BaseClass("StorePassView", _G.UIBaseView)

function StorePassView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local AwardState = {
    Lock = 1, --未解锁
    Unlock = 2, --可领取
    Received = 3 --已领取
}

local ParentName = {
    "obj_award1",
    "obj_award2",
    "obj_award3"
}

local GetName = {
    "aorbtn_get1",
    "aorbtn_get2",
    "aorbtn_get3"
}

local AwardName = {
    "rewards_normal",
    "rewards_pay1",
    "rewards_pay2"
}

local TextColor = {
    _G.ColorTools.FormatColorByString("FFE89F"), --每日任务
    _G.ColorTools.FormatColorByString("351B0A"), --普通任务
    _G.ColorTools.FormatColorByString("FFF5C0"), --等级
    _G.ColorTools.FormatColorByString("FFFFFF"), --等级置灰
    _G.ColorTools.FormatColorByString("4B0D0D"), --等级描边
    _G.ColorTools.FormatColorByString("4A4A4A") --等级描边置灰
}

---创建对象时,入口构造函数
function StorePassView:OnCreate()
    self.itemH = 141 --通行证item高度+space（140+1）
    self:InitData()
    self:InitToggle()
    self.delayEffect = true
    self.delayFun = {}
    self:InitView()
    self.go_table.toggle_pass.isOn = false
    self.go_table.toggle_pass.isOn = true
    self:AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClock, self)
    self:LoadEffect()
    _G.DelayDo(
        0.35,
        function()
            if self:IsNil() then
                return
            end
            for _, f in pairs(self.delayFun) do
                f()
            end
            self.delayFun = nil
            self.delayEffect = false
        end
    )
end

function StorePassView:LoadEffect()
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_txz_jianglilingpai, self.go_table.obj_eff, check)
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_jianglikuang, self.go_table.obj_nextItem, check)
end

function StorePassView:InitData()
    self.cfg = StorePassModel:GetInstance():GetCycleCfg()
    self.curWeek = StorePassModel:GetInstance():GetWeek()
    self.curSelectWeek = self.curWeek
    self.passCfgs = StorePassModel:GetInstance().passCfgs
    self.maxIdx = #self.cfg.passport_content
    self.mark = {}
    ---@type store_passport_content_cfg
    local cfg
    for i = 1, self.maxIdx do
        cfg = _G.ConfigManager.store_passport_content_cfg[self.cfg.passport_content[i]]
        if cfg then
            if cfg.reward == 1 then
                _G.table.insert(self.mark, i)
            end
        elseif _G.AppSetting.DEBUG then
            _G.LogError("store_passport_content_cfg未配置id: " .. self.cfg.passport_content[i])
        end
    end
    self.markNum = #self.mark - 1
end

function StorePassView:InitView()
    self.countDown = StorePassModel:GetInstance():GetEndTime() - _G.TimeUtil.GetServerUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateTime(0)
    self:UpdateLevel()
    self:UpdatePay()
end

function StorePassView:UpdateLevel()
    self.lv = StorePassModel:GetInstance():GetLevel()
    self.go_table.aortext_lv.text = self.lv
    local exp = StorePassModel:GetInstance():GetExp()
    self.exp = exp
    self.nextLvCfg = self.passCfgs[self.lv + 1]
    local isMaxLv
    if self.nextLvCfg == nil then --最大等级
        isMaxLv = true
        self.nextLvCfg = self.passCfgs[self.lv]
    end
    self.curLvExp = self.lv == 0 and exp or exp - self.passCfgs[self.lv].conditions[3]
    if isMaxLv then
        self.go_table.slider_exp.value = 1
        self.go_table.aortext_Slider.text = self.nextLvCfg.conditions[2] .. "/" .. self.nextLvCfg.conditions[2]
        self.go_table.aortext_num.text = self.curLvExp * _G.ConfigManager.discrete_cfg[126405][1][1]
    else
        self.go_table.slider_exp.value = self.curLvExp / self.nextLvCfg.conditions[2]
        self.go_table.aortext_Slider.text = self.curLvExp .. "/" .. self.nextLvCfg.conditions[2]
        self.go_table.aortext_num.text = 0
    end
end

function StorePassView:UpdatePay()
    self.buyClass = StorePassModel:GetInstance():GetBuyClass()
    self.go_table.aorimage_seniorLock:SetActiveE(self.buyClass == 0 and 1 or 0)
    self.go_table.aorimage_supremeLock:SetActiveE(self.buyClass < 2 and 1 or 0)
end

function StorePassView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    if AppSetting.IsXzns then
        local time = _G.Mathf.RoundToInt(self.countDown)
        time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "8ad793")
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90000010360, time)
    else
        local time = _G.Mathf.RoundToInt(self.countDown)
        time = _G.string.AddColor(_G.TimeUtil.TransDayHourMineMiao(time), "96ce51")
        self.go_table.aortext_countDown.text = _G.GetLangPackValue(90025500007, time)
    end
end

function StorePassView:InitToggle()
    self.toggles = {
        pass = _G.GetAutoGoTable(
            self.go_table.toggle_pass,
            _G.handlerbind(self, self.OnClickToggle, "pass", _G.handler(self, self.OnPass))
        ),
        task = _G.GetAutoGoTable(
            self.go_table.toggle_task,
            _G.handlerbind(self, self.OnClickToggle, "task", _G.handler(self, self.OnTask))
        )
    }
end

function StorePassView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function StorePassView:OnPass(isOn)
    self.go_table.obj_passPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.passInit then
        self:UpdatePass()
        self.passInit = true
    end
end

function StorePassView:OnTask(isOn)
    self.go_table.obj_taskPanel:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    if not self.taskInit then
        self:UpdateWeekBtn()
        self:UpdateTaskRedPoint()
        self:UpdateTask()
        self.taskInit = true
    end
end

function StorePassView:UpdateWeekBtn()
    local isGray
    for i = 1, 4 do
        isGray = i > self.curWeek
        self.go_table["aortext_w" .. i].text = i
        self.go_table["aorbtn_w" .. i]:SetGray(isGray)
        self.go_table["aortext_w" .. i].color = TextColor[isGray and 4 or 3]
        self.go_table["aortext_w" .. i]:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor =
            TextColor[isGray and 6 or 5]
    end
end

function StorePassView:UpdatePass()
    local jumpIndex = self:FindFirstAwardIndex()
    if not self.passListInit then
        self.go_table.scrollloopvectical_pass:InitItemData(
            #self.passCfgs,
            _G.handler(self, self.RefreshPassItem),
            jumpIndex
        )
        local _, h = self.go_table.scrollloopvectical_pass:GetRectTransformSize()
        self.deltaEnd = h + 2 + self.itemH ---layout的Top为2
        self.delta = h + 2
        self.markY = {}
        for i = 1, #self.mark do
            self.markY[i] = self.mark[i] * self.itemH - self.delta
        end
        self.markYE = self.mark[#self.mark] * self.itemH - self.deltaEnd
        self.go_table.scrollloopvectical_pass:DetectingSlippage(_G.handler(self, self.OnValueChanged))
        self:OnValueChanged()
        self.passListInit = true
    else
        self.go_table.scrollloopvectical_pass:UpdateAllItem()
        self.go_table.scrollloopvectical_pass:ScrollToIndex(jumpIndex)
    end
end

function StorePassView:RefreshPassItem(index, obj)
    index = index + 1
    ---@type store_passport_content_cfg
    local cfg = self.passCfgs[index]
    ---@type StorePassView._obj_item_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPassItem, cfg))
    tb.aortext_lv.text = cfg.level

    local state, bCls
    for i = 1, 3 do
        state = AwardState.Lock
        -- tb[ParentName[i]]:ClearChildren()
        bCls = i - 1
        if self.lv >= cfg.level and self.buyClass >= bCls then
            if StorePassModel:GetInstance():CheckAwardIsGet(cfg.id, bCls) then
                state = AwardState.Received
            else
                state = AwardState.Unlock
            end
        end
        tb[GetName[i]]:SetActiveE(state == AwardState.Unlock and 1 or 0)
        self:CreateItem(cfg[AwardName[i]][1], tb[ParentName[i]], state, tb, i)
    end

    if tb.aorimage_lvBg then
        local isGray = self.lv < cfg.level
        if AppSetting.IsXzns then
            tb.aorimage_lvBg.SpriteName = isGray and "ui_sjyzl_icon_02" or "ui_sjyzl_icon_01"
            tb.aortext_lv.color = isGray and _G.ColorTools.FormatColorByString("d9d3d3") or TextColor[4]
        else
            tb.aorimage_lvBg:SetGray(isGray)
            tb.aortext_lv.color = TextColor[isGray and 4 or 3]
            tb.aortext_lv:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = TextColor[isGray and 6 or 5]
        end
    end

    if tb.aorimage_processBg then
        tb.aorimage_processBg:SetActiveE(index == self.maxIdx and 0 or 1)
        tb.aorimage_full:SetActiveE(cfg.level < self.lv and 1 or 0)
    end
    self.go_table.obj_bottomBox:SetAsLastSiblingE()
end

function StorePassView:CreateItem(data, parent, state, tb, idx)
    if not tb.items then
        tb.items = {}
    end
    if not tb.items[idx] then
        tb.items[idx] = BaseAwardNewItem.New(parent, nil, 88, parent)
    end
    tb.items[idx]:ShowWithID(data, nil, _G.handlerbind(self, self.itemLoadedCall, tb, idx, state))
end

---@param isBuy boolean true是豪华奖励
---@param itemLua BaseAwardNewItem 奖励脚本
function StorePassView:itemLoadedCall(itemLua, tb, idx, state)
    ---@type ItemViewBase
    local lua = itemLua.item
    if itemLua.type ~= _G.StorageType.Card then
        lua:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
    end

    itemLua.item:SetGouScroll(state == AwardState.Received)

    local canGet = state == AwardState.Unlock

    if self.delayEffect then
        _G.table.insert(self.delayFun, _G.handlerbind(self, self.itemLoadedEffect, itemLua, tb, idx, canGet))
    else
        self:itemLoadedEffect(itemLua, tb, idx, canGet)
    end

    tb["obj_canGetEff" .. idx]:SetActiveE(canGet and 1 or 0)
end

function StorePassView:itemLoadedEffect(itemLua, tb, idx, canGet)
    itemLua.item:ShowEffectOrder(canGet)
    if canGet then
        if not tb["eff" .. idx] then
            tb["eff" .. idx] = true
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                tb["obj_canGetEff" .. idx],
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    tb["eff" .. idx] = trans
                end
            )
        end
    end
end

function StorePassView:FindFirstAwardIndex()
    local cfg
    for i = 1, #self.passCfgs do
        cfg = self.passCfgs[i]
        for j = 0, self.buyClass do
            if not StorePassModel:GetInstance():CheckAwardIsGet(cfg.id, j) then
                return i - 1
            end
        end
    end
    return #self.passCfgs
end

function StorePassView:FindAllUnlockAwards()
    local awardDic = {}
    local cfg
    for i = 1, #self.passCfgs do
        cfg = self.passCfgs[i]
        if self.lv >= cfg.level then
            for j = 0, self.buyClass do
                if not StorePassModel:GetInstance():CheckAwardIsGet(cfg.id, j) then
                    if not awardDic[j] then
                        awardDic[j] = {}
                    end
                    _G.table.insert(awardDic[j], cfg.id)
                end
            end
        end
    end
    local awardLis = {}
    for cls, lis in pairs(awardDic) do
        _G.table.insert(awardLis, {buy_class = cls, sid_list = lis})
    end
    return awardLis
end

function StorePassView:FindAllFinishTask()
    local taskLis = {}
    for _, task in pairs(self.taskList) do
        if
            task.i_task.state == _G.TaskEnum.ETaskState.Submited and
                not StorePassModel:GetInstance():CheckTaskIsFinish(task.sid)
         then
            _G.table.insert(taskLis, task.sid)
        end
    end
    return taskLis
end

function StorePassView:UpdateTask(force)
    if not self.taskListAll or force then
        local taskList = StorePassModel:GetInstance():GetTaskData()
        self.taskListAll = {}
        for i = 1, 4 do
            self.taskListAll[i] = {}
            for _, sid in pairs(self.cfg.mission_extra2[i]) do
                _G.table.insert(self.taskListAll[i], taskList[sid])
            end
            if i <= self.curWeek then
                for _, sid in pairs(self.cfg.mission_extra1) do
                    if taskList[sid] then
                        _G.table.insert(self.taskListAll[i], taskList[sid])
                    end
                end
            end
        end
    end
    self.taskList = self.taskListAll[self.curSelectWeek]
    if self.curSelectWeek > self.curWeek then
        self.go_table.scrollloopvectical_task:SetActiveE(0)
        self.go_table.aortext_lock:SetActiveE(1)
        self.go_table.aortext_lock.text =
            _G.GetLangPackValue(90033700011, _G.GameUtil.NumberToChinese(self.curSelectWeek))
    else
        self.go_table.scrollloopvectical_task:SetActiveE(1)
        self.go_table.aortext_lock:SetActiveE(0)
        _G.SortList(
            self.taskList,
            function(task)
                local sort
                if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
                    if StorePassModel:GetInstance():CheckTaskIsFinish(task.sid) then
                        sort = 1
                    else
                        sort = 3
                    end
                else
                    sort = 2
                end
                return StorePassModel:GetInstance():CheckIsDaily(task.sid) and 1 or 0, sort, -task.sid
            end
        )
        if not self.taskListInit then
            self.go_table.scrollloopvectical_task:InitItemData(#self.taskList, _G.handler(self, self.RefreshTaskItem))
            self.taskListInit = true
        else
            self.go_table.scrollloopvectical_task:UpdateCount(#self.taskList)
        end
    end
    if not self.taskSelectEff then
        self.taskSelectEff = true
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_iconxuanzhong,
            self.go_table["aortext_w" .. self.curSelectWeek],
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                self.taskSelectEff = trans
                self.taskSelectEff:SetParentE(self.go_table["aortext_w" .. self.curSelectWeek])
            end
        )
    elseif self.taskSelectEff ~= true then
        self.taskSelectEff:SetParentE(self.go_table["aortext_w" .. self.curSelectWeek])
    end
end

function StorePassView:RefreshTaskItem(index, obj)
    index = index + 1
    local task = self.taskList[index]
    ---@type StorePassView._obj_taskItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTaskItem, task))
    local isDaily = StorePassModel:GetInstance():CheckIsDaily(task.sid)
    tb.aorimage_bg.SpriteName = isDaily and "ui_txz_meirirenwu_dikuang" or "ui_txz_meizhourenwu_dikuang"
    tb.aorimage_flag.SpriteName = isDaily and "ui_txz_meirirenwu_xiaobiao" or "ui-txz_meizhourenwu_xiaobiao"
    tb.aortext_name.text = _G.GetLangPackValue(task.Cfg.desc)
    tb.aortext_exp.text = isDaily and StorePassModel:GetInstance().dailyExp or StorePassModel:GetInstance().weeklyExp
    local curNum = task.i_task.target[1]
    tb.slider_progress.value = curNum / task.Cfg.count
    tb.aortext_Slider.text = curNum .. "/" .. task.Cfg.count
    local isGet
    if AppSetting.IsXzns then
        local SelectIcon = "ImagesH5/hStorePass/ui_yzl_dikuang_meiri"
        local NotSelectIcon = "ImagesH5/hStorePass/ui_yzl_dikuang_meizhou"
        tb.aorrawimage_rawbg:LoadImage(isDaily and SelectIcon or NotSelectIcon)
        tb.aortext_name.color = isDaily and _G.ColorTools.FormatColorByString("84491d") or _G.ColorTools.FormatColorByString("f1f9fc")
    else
        tb.aortext_name.color = isDaily and TextColor[1] or TextColor[2]
    end
    if task.i_task.state == _G.TaskEnum.ETaskState.Submited then
        isGet = StorePassModel:GetInstance():CheckTaskIsFinish(task.sid)
        tb.aorbtn_unGet:SetActiveE(0)
        tb.aorbtn_get:SetActiveE(isGet and 0 or 1)
        tb.obj_complete:SetActiveE(isGet and 1 or 0)
    else
        tb.aorbtn_unGet:SetActiveE(1)
        tb.aorbtn_get:SetActiveE(0)
        tb.obj_complete:SetActiveE(0)
    end
end

function StorePassView:UpdateTaskRedPoint()
    self.go_table.obj_redpointW1:SetActiveE(StorePassModel:GetInstance():CheckSingleWeekTaskFinish(1) and 1 or 0)
    self.go_table.obj_redpointW2:SetActiveE(StorePassModel:GetInstance():CheckSingleWeekTaskFinish(2) and 1 or 0)
    self.go_table.obj_redpointW3:SetActiveE(StorePassModel:GetInstance():CheckSingleWeekTaskFinish(3) and 1 or 0)
    self.go_table.obj_redpointW4:SetActiveE(StorePassModel:GetInstance():CheckSingleWeekTaskFinish(4) and 1 or 0)
end

function StorePassView:OnValueChanged()
    local x, y, z = self.go_table.obj_Content:GetAnchorPosition()
    local lv = self.mark[1] or 0
    for i = 1, self.markNum do
        if i == self.markNum then
            if y > self.markYE then
                self.go_table.obj_nextItem:SetActiveE(0)
            else
                self.go_table.obj_nextItem:SetActiveE(1)
            end
        end
        if y > self.markY[i] then
            lv = self.mark[i + 1]
        end
    end
    if lv > 0 then
        if lv - 1 ~= self.lastMarkIndex then
            self.lastMarkIndex = lv - 1
            self:RefreshPassItem(self.lastMarkIndex, self.go_table.obj_nextItem)
        end
    else
        self.go_table.obj_nextItem:SetActiveE(0)
    end
end

function StorePassView:OnClickPassItem(go, isOn, cfg)
    local awardList = self:FindAllUnlockAwards()
    if _G.table.isEmptyOrNil(awardList) then
        return
    end
    StorePassModel:GetInstance():GetAward(
        awardList,
        function(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            self:UpdatePass()
        end
    )
end

function StorePassView:OnClickTaskItem(go, isOn, task)
    local name = go:GetName()
    if name == "@_aorbtn_unGet" then
        _G.JumpManager:GetInstance():Jump(task.Cfg.link)
    elseif name == "@_aorbtn_get" then
        local taskLis = self:FindAllFinishTask()
        if _G.table.isEmptyOrNil(taskLis) then
            return
        end
        StorePassModel:GetInstance():FinishTask(
            taskLis,
            2,
            function(msg, award)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, award)
                self:UpdateTask()
                self:UpdateLevel()
                self:UpdatePass()
                self:UpdateTaskRedPoint()
            end
        )
    end
end

function StorePassView:OnSixClock()
    self:InitData()
    self:UpdateLevel()
    self:UpdatePay()
    self:UpdatePass()
    self:UpdateTask(true)
    self:UpdateWeekBtn()
    self:UpdateTaskRedPoint()
end

function StorePassView:OnMallCashListener(data)
    if _G.table.ContainsValue(self.cfg.passport_gift, data.sid) then
        self:UpdatePay()
        self:UpdatePass()
    end
end

function StorePassView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_w1 then
        self.curSelectWeek = 1
        self:UpdateTask()
    elseif go == self.go_table.aorbtn_w2 then
        self.curSelectWeek = 2
        self:UpdateTask()
    elseif go == self.go_table.aorbtn_w3 then
        self.curSelectWeek = 3
        self:UpdateTask()
    elseif go == self.go_table.aorbtn_w4 then
        self.curSelectWeek = 4
        self:UpdateTask()
    elseif go == self.go_table.aorbtn_buy then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StorePassBuyView.Name)
    end
end

function StorePassView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---销毁对象时,析构函数
function StorePassView:OnDestroy()
    self:RemoveAllListener()
end

return StorePassView
