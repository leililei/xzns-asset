local base = require("BaseGameNet")

---@class StorePassNet : BaseGameNet	通信协议
local StorePassNet = _G.BaseClass("StorePassNet", base)
---@return StorePassNet StorePassNet
function StorePassNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function StorePassNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_store_pass_port_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务
function StorePassNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_pass_port_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务
function StorePassNet:Finish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_store_pass_port_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function StorePassNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return StorePassNet
