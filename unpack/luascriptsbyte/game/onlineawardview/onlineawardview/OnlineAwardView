local OnlineAwardModel = require "OnlineAwardModel"
---@class OnlineAwardView : UIBaseView 在线奖励
---@field public go_table OnlineAwardView_GoTable GoTable
local OnlineAwardView = _G.BaseClass("OnlineAwardView", _G.UIBaseView)
local awardstateEnum = {
    none = 0,           -- 正常
    receive = 1,        -- 可以领取
    already_receive = 2 -- 已领取
}
local award_count = 8

function OnlineAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.awardnode = {
        [1] = { obj = self.go_table.obj_olineAwardItem_1, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_1 },
        [2] = { obj = self.go_table.obj_olineAwardItem_2, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_2 },
        [3] = { obj = self.go_table.obj_olineAwardItem_3, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_3 },
        [4] = { obj = self.go_table.obj_olineAwardItem_4, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_4 },
        [5] = { obj = self.go_table.obj_olineAwardItem_5, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_5 },
        [6] = { obj = self.go_table.obj_olineAwardItem_6, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_6 },
        [7] = { obj = self.go_table.obj_olineAwardItem_7, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_7 },
        [8] = { obj = self.go_table.obj_olineAwardItem_8, item = {}, tb = {}, ui_effect = self.go_table.obj_uieffect_8 }
    }
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.OnlineAwardView, self.go_table)
    ---加载 静态特效 预制体中，直接隐藏（会不显示特效）
    for i = 1, 8 do
        self.awardnode[i].ui_effect:SetActiveE(0)
    end
end

function OnlineAwardView:OnCreate()
    self.current_id = OnlineAwardModel:GetInstance().current_id + 1

    self.animator = self.go_table.obj_panel:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    _G.Events:GetInstance():AddListener(_G.eOnline.RefreshOnlineTime, self.ResCloolingUI, self)

    self.go_table.aorbtn_All:SetActiveE(0)
    ---延迟一个动画时间，保证动画展示正常
    _G.DelayDo(
        0.1,
        function()
            if self:IsNil() then
                return
            end
            self:InitAwardInfo()
            self:UpdateAllButton()
        end
    )
end

---销毁对象时,析构函数
function OnlineAwardView:OnDestroy()
    self.awardnode = nil
end

function OnlineAwardView:CoProgressCloseAni()
    --self.animator:SetBool("close", false)
    _G.coroutine.waitforseconds(1)
    for i = 1, #self.awardnode do
        _G.GameUtil.SetActiveByCondition(self.awardnode[i].ui_effect, false)
    end
    local flag = require("OnlineAwardModel").CheckShowMainFunction()
    if flag == false then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.OnLine)
    end
    if self.stopCoProgress then
        _G.coroutine.stopwaiting(self.stopCoProgress)
        self.stopCoProgress = nil
        self.ent = false
    end
    self:Close()
end

---按钮点击事件在这里派发
function OnlineAwardView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_space" then
        for i = 1, #self.awardnode do
            _G.GameUtil.SetActiveByCondition(self.awardnode[i].ui_effect, false)
        end
        --self.animator:SetBool("close", false)
        local flag = require("OnlineAwardModel").CheckShowMainFunction()
        if flag == false then
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.OnlineAward)
        end
        self:Close()
    elseif name == "@_aorbtn_All" then
        self:AllButtonClick()
    end
end

--region 初始化,设置
function OnlineAwardView:InitAwardInfo()
    local all = OnlineAwardModel:GetInstance().All_OnLineAward
    for i = 1, #self.awardnode do
        local obj = self.awardnode[i].obj
        local tb = _G.GetAutoGoTable(obj)
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.OnlineAwardView .. "Node", tb)
        self.awardnode[i].tb = tb
        local itemdata = all[i]
        self:SetOneAwardInfo(tb, itemdata, i)
    end
end

---@param onlineData table OnLineAwardData
function OnlineAwardView:SetOneAwardInfo(tb, onlineData, index)
    local itemtb = tb
    local itemdata = onlineData
    local flag = false
    local str = ""
    itemtb.obj_text:SetActiveE(0)
    if itemdata:GetAwardState() == awardstateEnum.already_receive then
    elseif itemdata:GetAwardState() == awardstateEnum.receive then
        flag = true
        itemtb.obj_text:SetActiveE(1)
    else
        local all = OnlineAwardModel:GetInstance().All_OnLineAward
        if (index - 1) < 1 then
            str = _G.TimeUtil.TimeToString(itemdata.time_online, 1)
            itemtb.obj_text:SetActiveE(1)
        else
            local all = OnlineAwardModel:GetInstance().All_OnLineAward
            if all[index - 1]:GetAwardState() == awardstateEnum.already_receive then
                str = _G.TimeUtil.TimeToString(itemdata.time_online, 1)
            end
        end
        if str ~= "" then
            itemtb.obj_text:SetActiveE(1)
        end
    end
    itemtb.aorbtn_kelingqu.onClick:RemoveAllListeners()
    itemtb.aorbtn_kelingqu.onClick:AddListener(
        _G.handlerbind(self, self.awardBtn, itemtb.aorbtn_kelingqu, itemdata, index)
    )

    _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, flag)
    itemtb.aortext_time.text = str
    _G.StorageManager:GetInstance():GetItemBaseView(
        itemdata:GetAwardSid(),
        itemdata:GetCount(),
        tb.obj_ItemNode,
        function(item)
            if self:IsNil() then
                if item and item.gameObject then
                    _G.DestroyObject(item.gameObject)
                end
                return
            end
            self.awardnode[index].item = item
            item:SetGou(itemdata:GetAwardState() == awardstateEnum.already_receive)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if item.SetGradeNew then
                item:SetGradeNew(false)
            end
            --item:ShowEffectOrder(true)
            --加载特效
            self:ShowEffectOrder(index, itemdata)

            if index == 8 then
                _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_mask2, false)
            end
        end,
        function(go)
            if itemdata:GetAwardState() == awardstateEnum.receive then
                self:awardBtn(nil, itemdata, index)
            else
                if itemdata:GetAwardtype() == _G.StorageID.Equipment then
                    local element = 0
                    element = itemdata.rewards[3]
                    require("CommonTipManager"):GetInstance():OpenTip(
                        go.gameObject,
                        itemdata:GetAwardSid(),
                        nil,
                        nil,
                        element
                    )
                else
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, itemdata:GetAwardSid())
                end
            end
        end,
        { itemdata.rewards[3] }
    )
end

---(预制体新增节点,根据物品品质生成特效) 滑动列表会出现不同品质的装备的特效
function OnlineAwardView:ShowEffectOrder(index, itemData)
    self:RemoveOredrEffect(index)
    if itemData:GetAwardState() == awardstateEnum.receive then
        local effect = _G.ConfigManager.ui_effect_cfg.ef_c_zaixianlibaoliuguang_effect
        _G.UIUtils.LoadEffectByCfg(
            effect,
            self.awardnode[index].ui_effect,
            _G.GameUtil.SetActiveByCondition(
                self.awardnode[index].ui_effect,
                itemData:GetAwardState() == awardstateEnum.receive
            )
        )
    end
end

---清除品质特效
function OnlineAwardView:RemoveOredrEffect(index)
    if self.awardnode[index].ui_effect:GetChildCountE() > 0 then
        for i = 1, self.awardnode[index].ui_effect:GetChildCountE() do
            _G.PoolsManager:GetInstance():Despawn(self.awardnode[index].ui_effect:GetChildE(0), _G.ePoolType.UIEffect)
        end
    end
end

function OnlineAwardView:awardBtn(go, itemdata, index)
    local msg = {}
    local id = itemdata.id
    _G.table.insert(msg, id)
    if _G.table.isEmptyOrNil(msg) then
        return
    end
    OnlineAwardModel:GetInstance():SendAward(
        msg,
        function()
            if self:IsNil() then
                return
            end
            self.current_id = self.current_id + 1
            self:RefreshAwardNode(index)
            self:UpdateAllButton()
        end
    )
end

--endregion

--region 刷新
---倒计时
function OnlineAwardView:ResCloolingUI()
    local itemdata = OnlineAwardModel:GetInstance():GetOneAwardInfo(self.current_id)
    local tb = self.awardnode[self.current_id].tb
    if self.awardnode[self.current_id] then
    else
        return
    end
    local ui_effect = self.awardnode[self.current_id].ui_effect
    local flag = false
    local str = ""
    if itemdata:GetAwardState() == awardstateEnum.none then
        str = _G.TimeUtil.TimeToString(itemdata.time_online, 1)
    else
        flag = true
        _G.GameUtil.SetActiveByCondition(ui_effect, flag)
    end
    if tb then
        if tb.aortext_time then
            tb.aortext_time.text = str
            _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, flag)
            --加载特效
            if itemdata:GetAwardState() == awardstateEnum.receive then
                self:ShowEffectOrder(self.current_id, itemdata)
            end
            self:UpdateAllButton()
        end
    end
end

---刷新 一键领取
function OnlineAwardView:UpdateAllButton()
    local flag = false
    flag = OnlineAwardModel:GetInstance():CheckAward()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_All, flag)
end

function OnlineAwardView:RefreshAwardNode(index)
    local objnode = self.awardnode[index]
    local item = objnode.item
    local tb = objnode.tb
    tb.aortext_time = ""
    if tb.aorbtn_kelingqu then
        _G.GameUtil.SetActiveByCondition(tb.aorbtn_kelingqu, false)
        _G.GameUtil.SetActiveByCondition(objnode.ui_effect, false)
    end
    item:SetGou(true)
    --item:ShowOrHideEffect(false)
    tb.obj_text:SetActiveE(0)
    if self.current_id > award_count then
        return
    end
    objnode = self.awardnode[self.current_id]
    tb = objnode.tb
    local all = OnlineAwardModel:GetInstance().All_OnLineAward
    tb.aortext_time.text = _G.TimeUtil.TimeToString(all[self.current_id].time_online, 1)

    if _G.TimeUtil.TimeToString(all[self.current_id].time_online, 1) ~= "" then
        tb.obj_text:SetActiveE(1)
    end
end

--endregion

--region button 点击
--- 一键领取
function OnlineAwardView:AllButtonClick()
    local all = OnlineAwardModel:GetInstance().All_OnLineAward
    local msg = {}
    for i = 1, #all do
        if all[i]:GetAwardState() == awardstateEnum.receive then
            _G.table.insert(msg, all[i].id)
        end
    end

    if _G.table.isEmptyOrNil(msg) then
        return
    end
    OnlineAwardModel:GetInstance():SendAward(
        msg,
        function()
            if self:IsNil() then
                return
            end
            self.current_id = self.current_id + 1
            self:UpdateAllButton()
            for i = 1, #msg do
                self:RefreshAwardNode(msg[i])
            end
        end
    )
end

function OnlineAwardView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eOnline.RefreshOnlineTime, self.ResCloolingUI, self)
end

--endregion
return OnlineAwardView
