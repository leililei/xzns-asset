---设置奖励信息的时间，奖励信息的状态
function OnlineAwardModel:InitOnlineTime()
    local cfg = _G.ConfigManager.online_cfg
    local tatle = #cfg
    local sid = self.msg.info.a_id and self.msg.info.a_id + 1 or 1
    if sid > tatle then
        for i = 1, tatle do
            local onlineitem = self.All_OnLineAward[i]
            onlineitem:SetAwardState(awardstateEnum.already_receive)
        end
        return
    end
    local tag = 0
    for i = 1, sid do
        local onlineitem = self.All_OnLineAward[i]
        if i < sid then
            tag = awardstateEnum.already_receive
        else
            if self:CheckAwardTime(onlineitem.time_online) then
                tag = awardstateEnum.receive
            else
                tag = awardstateEnum.none
                self:SetAwardTime(onlineitem)
            end
        end
        onlineitem:SetAwardState(tag)
    end
end

---设置时间
function OnlineAwardModel:SetAwardTime(onlineawarddata)
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    self.lingqutime = nowtime
    local time_online = onlineawarddata.old_time
    time_online = time_online - (nowtime - self.login_time)
    onlineawarddata:SetTimeOnline(time_online)
    if time_online <= 0 then
        onlineawarddata:SetAwardState(awardstateEnum.receive)
    end
end
---检测建立 是否 都已经领取
function OnlineAwardModel:CheckAwardAlreadyreceive()
    for i = 1, #self.All_OnLineAward do
        if self.All_OnLineAward[i]:GetAwardState() ~= awardstateEnum.already_receive then
            return true
        end
    end
    return false
end
---检测是不是 可以领取奖励
function OnlineAwardModel:CheckAward()
    for i = 1, #self.All_OnLineAward do
        if self.All_OnLineAward[i]:GetAwardState() == awardstateEnum.receive then
            return true
        end
    end
    return false
end
--region 对外接口 （main_function,检测函数）
-----是否显示.false是关闭,true是显示
function OnlineAwardModel.CheckShowMainFunction()
    if _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(68) then
    else
        return false
    end
    local flag = require("OnlineAwardModel"):GetInstance():CheckAwardAlreadyreceive()
    if flag then
    else
        local all = require("OnlineAwardModel"):GetInstance().All_OnLineAward
        if _G.table.isEmptyOrNil(all) then
            return true
        end
    end
    return flag
end
---检测时间 是否到了 可以领取了
function OnlineAwardModel:CheckAwardTime(awardtime)
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local number = nowtime - self.login_time
    if number < awardtime then
        return false
    end
    return true
end

---红点检测
function OnlineAwardModel:CheckPointRed()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(68) then
        return false
    end
    if self:CheckAward() then
        return true
    end
    return false
end
function OnlineAwardModel:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.super:Dispose()
end
return OnlineAwardModel
