local BaseItemData = require "BaseItemData"
---@class OnLineAwardData	中文描述
local OnLineAwardData = _G.BaseClass("OnLineAwardData", BaseItemData)
local awardstateEnum = {
    none = 0, -- 正常
    receive = 1, -- 可以领取
    already_receive = 2 -- 已领取
}
---类的构造函数
function OnLineAwardData:__init()
    self:InitAttribute()
end

---类的析构函数
function OnLineAwardData:Dispose()
end

---初始化属性
---@field awardstate number 奖励状态
---@field awardtype number 奖励的类型，材料，资源，卡牌，，，等
---@field time_online number 登录的时间戳
---@field rewards table 奖励物品
---@field id number 配置表的 id
function OnLineAwardData:InitAttribute()
    self.awardstate = awardstateEnum.none
    self.awardtype = 0
    self.rewards = {}
    self.time_online = 0
    self.id = 0
end
---@param msg table 数据值 cfg = id,time_online,rewards
function OnLineAwardData:ParseInitMsg(msg)
    self.id = msg.cfgid
    self.rewards = msg.rewards
    self.time_online = msg.time_online
    self.old_time = msg.time_online
    local sid = msg.rewards[1]
    self:SetAwardSid(sid)
    local _, StorageID = _G.StorageManager:GetInstance():CheckSidType(sid)
    local cfg = {}
    if StorageID == _G.StorageID.Card then
        cfg = _G.ConfigManager.card_cfg[sid]
    elseif StorageID == _G.StorageID.Equipment then
        cfg = _G.ConfigManager.equipment_cfg[sid]
    elseif StorageID == _G.StorageID.Decoration then
        cfg = _G.ConfigManager.decoration_cfg[sid]
    elseif StorageID == _G.StorageID.ResProp then
        cfg = _G.ConfigManager.currency_type_cfg[sid]
    else
        cfg = _G.ConfigManager.item_cfg[sid]
    end
    self:SetAwardSidCfg(cfg)
    self:SetAwardState(awardstateEnum.none)
    self:SetAwardCount(self.rewards[2])
    self:SetAwardtype(StorageID)
end

--region 设置参数
---设置下时间
function OnLineAwardData:SetTimeOnline(time)
    self.time_online = time
end
function OnLineAwardData:SetAwardSid(sid)
    self.sid = sid
end
function OnLineAwardData:GetAwardSid()
    return self.sid
end
---设置 （根据sid，设置物品的配置表）
function OnLineAwardData:SetAwardSidCfg(cfg)
    self.cfg = cfg
end
---设置奖励的类型（卡牌，，材料，，，，等）
function OnLineAwardData:SetAwardtype(type)
    self.awardtype = type
end
function OnLineAwardData:GetAwardtype()
    return self.awardtype
end
---设置奖励的 状态
function OnLineAwardData:SetAwardState(stateEnum)
    self.awardstate = stateEnum
end
function OnLineAwardData:GetAwardState()
    return self.awardstate
end
---设置奖励的 数量
function OnLineAwardData:SetAwardCount(count)
    self.count = count
end
--endregin
return OnLineAwardData
