local base = require("BaseGameNet")

---@class OnlineAwardNet : BaseGameNet	通信协议
local OnlineAwardNet = _G.BaseClass("OnlineAwardNet", base)
---@return OnlineAwardNet OnlineAwardNet
function OnlineAwardNet:GetInstance()
    return base.GetInstance(self)
end

---请求 在线奖励信息
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_online_award_info 返回的信息数组
function OnlineAwardNet:GetOnlineAwardInfos(callback)
    local item = _G.ConfigManager.net_map.game_online_award_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallbackMsg))
    self.Call[port] = callback
end

---请求 领取奖励信息
---@param pbData table PB数据
---@param callback function 完成回调
---@field s2c_online_award_info 返回的信息数组
function OnlineAwardNet:SendAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_online_award_get
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallbackMsg))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function OnlineAwardNet:CallbackMsg(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return OnlineAwardNet
