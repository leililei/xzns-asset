local RoleInfoView = _G.BaseClass("RoleInfoView", _G.UIBaseView)
--_G.RoleInfoView = RoleInfoView

local CS = _G.CS
local typeof = _G.typeof

local testHero = {
    {
        name = _G.ConfigManager.language_package_cfg[11420000001],
        Star = 4,
        Icon = "Images/Roles/ui_RolesIcon_img_bsx_001",
        UID = 1
    },
    {
        name = _G.ConfigManager.language_package_cfg[11315000001],
        Star = 2,
        Icon = "Images/Roles/ui_RolesIcon_img_bsx_002",
        UID = 2
    },
    {
        name = _G.ConfigManager.language_package_cfg[11101000001],
        Star = 3,
        Icon = "Images/Roles/ui_RolesIcon_img_bsx_003",
        UID = 3
    },
    {
        name = _G.ConfigManager.language_package_cfg[12421000001],
        Star = 5,
        Icon = "Images/Roles/ui_RolesIcon_img_bsx_004",
        UID = 4
    }
}

function RoleInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function RoleInfoView:OnCreate()
    self:Init()
end

function RoleInfoView:Init()
    self:GetHeroData()
    if self.heroes ~= nil then
        self.CurHero = 1
    end
    self.star = {}
    self.star[1] = self.go_table.aorimage_Star1
    self.star[2] = self.go_table.aorimage_Star2
    self.star[3] = self.go_table.aorimage_Star3
    self.star[4] = self.go_table.aorimage_Star4
    self.star[5] = self.go_table.aorimage_Star5
    self.star[6] = self.go_table.aorimage_Star6
    self.star[7] = self.go_table.aorimage_Star7

    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Tips, false)

    self:SetUI()
end

function RoleInfoView:SetUI()
    if self.heroes == nil then
        return
    end
    self.go_table.aorrawimage_RoleImage:LoadImage(
        self.heroes[self.CurHero].Icon,
        function()
        end
    )
    self.go_table.aortext_RoleName.text = self.heroes[self.CurHero].name

    for _, v in pairs(self.star) do
        _G.GameUtil.SetActiveByCondition(v, true)
    end
    for i = #self.star, self.heroes[self.CurHero].Star, -1 do
        _G.GameUtil.SetActiveByCondition(self.star[i], false)
    end
end

function RoleInfoView:GetHeroData()
    if testHero == nil then
        return
    end
    local i = 1
    self.heroes = {}
    for _, v in pairs(testHero) do
        self.heroes[i] = v
        i = i + 1
    end
end

function RoleInfoView:ChangeHero(dir)
    local temp = self.CurHero + dir

    temp = temp > #self.heroes and 1 or temp
    temp = temp < 1 and #self.heroes or temp

    self.CurHero = temp
    self:SetUI()
end

---按钮点击事件在这里派发
function RoleInfoView:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.UIConfig.RoleInfoView.Name)
    elseif name == "@_aorbtn_LeftArw" then
        self:ChangeHero(-1)
    elseif name == "@_aorbtn_RightArw" then
        self:ChangeHero(1)
    end
end

return RoleInfoView
