--@class RuneLimitFundView : UIBaseView   秘密专属
---@field public go_table RuneLimitFundView_GoTable GoTable
local RuneLimitFundView = _G.BaseClass("RuneLimitFundView", _G.UIBaseView)

function RuneLimitFundView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local StorageManager = _G.StorageManager:GetInstance()
function RuneLimitFundView:OnCreate()
    ---@type  RuneLimitFundModel
    self.Model = require("RuneLimitFundModel"):GetInstance()
    self.endTime = self.Model:GetEndTime()
    self:UpdateTimer()
    if not self.timer and self.endTime > _G.TimeUtil.GetServerUnixTime() then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer:Start()
    end
    self:init()
end

local store_battle_content_cfg = _G.ConfigManager.store_battle_content_cfg

function RuneLimitFundView:init()
    ---@type store_battle_pass_cfg
    self.cfg = self.Model:GetGiftCfg()
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshListItem))
    self.go_table.scrollloopvectical_list:UpdateCount(#self.cfg.content)
    self:UpdatBtn()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.RuneLimitFundView, self.go_table)
end

function RuneLimitFundView:RefreshListItem(index, obj)
    local _index = index + 1
    local cfg = store_battle_content_cfg[self.cfg.content[_index]]
    local tb = _G.GetAutoGoTable(obj)
    tb.aortext_day.text = _G.tostring(_index)
    local free = _G.GetAutoGoTable(tb.obj_freeItem, _G.handlerbind(self, self.OnClickItem, true, cfg.id))
    local pay = _G.GetAutoGoTable(tb.obj_payItem, _G.handlerbind(self, self.OnClickItem, false, cfg.id))
    for i = 1, #cfg.rewards_normal do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.rewards_normal[i],
            free.obj_itemRoot,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:SetGou(self.Model:CheckIsGetItem(true, cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder((tran.cfg.ef_item == 1 and self.Model:CheckIsCanGetItem(true, cfg.id)) and true or
                        false)
                end

                local isGet = self.Model:CheckIsCanGetItem(true, cfg.id)
                free.obj_Effect:ClearChildren()
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqu_2,
                    free.obj_Effect
                )
                free.obj_Effect:SetActiveE(isGet)
            end
        )
    end
    for i = 1, #cfg.rewards_pay do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            cfg.rewards_pay[i],
            pay.obj_itemRoot,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.8)
                if tran.ShowNumText then
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                tran:SetGou(self.Model:CheckIsGetItem(false, cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder((tran.cfg.ef_item == 1 and self.Model:CheckIsCanGetItem(false, cfg.id)) and true or
                        false)
                end

                local isGet = self.Model:CheckIsCanGetItem(false, cfg.id)
                pay.obj_Effect:ClearChildren()
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqu_2,
                    pay.obj_Effect
                )
                pay.obj_Effect:SetActiveE(isGet)
            end
        )
    end
end

function RuneLimitFundView:OnClickItem(go, ison, isfree, id)
    local isget = self.Model:CheckIsGetItem(isfree, id)
    local isCanGet = self.Model:CheckIsCanGetItem(isfree, id)
    if not isget and isCanGet == 1 then
        self.Model:GetAward(function()
            ---@type SecretRealmView
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
            if view then
                view:SetRuneLimitFundBtnShowAndHind()
            end
            self:UpdatBtn()
            self.go_table.scrollloopvectical_list:UpdateAllItem()
        end)
    else
        local cfg = store_battle_content_cfg[id]
        local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(isfree and cfg.rewards_normal[1] or
            cfg.rewards_pay[1])
        local grade, type = StorageManager:GetItemGrade(data.sid)
        if type == _G.StorageType.Card then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PreviewCardShowView.Name,
                { CardData = data },
                nil,
                true)
        elseif type == _G.StorageType.Prop and data.cfg.Type1 == 11 then
            ---@type skin_cfg
            local cfg = self:GetSkincfgByUnLockItemId(data.cfg.ID)
            local cardData = require("CardData").GetPreviewData(cfg.card)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.PreviewCardShowView.Name,
                { CardData = cardData, showSwitchBtn = false },
                nil,
                true, --isPreviewCardShow,
                nil,
                cfg.id
            )
        else
            require "CommonTipManager":GetInstance():OpenTip(
                go.transform,
                data.sid,
                data.uid,
                data
            )
        end
    end
end

function RuneLimitFundView:UpdatBtn()
    if self.Model:CheckGiftIsBuy() == 1 then
        if self.Model:CheckGiftHasGet() == 1 then
            self.go_table.aortext_buytext.text = _G.GetLangPackValue(9002010005)
        else
            if self.Model.CheckToDayIsLastday() then
                self.go_table.aortext_buytext.text = _G.GetLangPackValue(90000010221)
            else
                self.go_table.aortext_buytext.text = _G.GetLangPackValue(90001008406)
            end
        end
    else
        self.go_table.aortext_buytext.text = _G.GetLangPackValue(90000010819,
            _G.GameUtil.RatioControl(self.cfg.price_id))
    end
end

function RuneLimitFundView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        self.go_table.aortext_time.text = _G.GetLangPackValue(90011621101)
        local zhoushu = (self.Model:GetToday() - 3) // 7
        _G.PlayerPrefsManager.SetInt("RuneLimitFund" .. zhoushu, 1)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRuneLimitFund.id)
        return
    end
    local timestr = string.format("<color=#f5d37d>%s</color>", _G.TimeUtil.TranslateSecondForStr(time))
    self.go_table.aortext_time.text = _G.GetLangPackValue(90022900045, timestr)
end

function RuneLimitFundView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        if self.Model:CheckGiftIsBuy() == 0 then
            self.Model:BuyGift(function()
                self:UpdatBtn()
                self.go_table.scrollloopvectical_list:UpdateAllItem()
            end)
        else
            if self.Model:CheckGiftHasGet() == 1 then
                self.Model:GetAward(function()
                    ---@type SecretRealmView
                    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
                    if view then
                        view:SetRuneLimitFundBtnShowAndHind()
                    end
                    self:UpdatBtn()
                    self.go_table.scrollloopvectical_list:UpdateAllItem()
                end)
            else
                if self.Model.CheckToDayIsLastday() then
                    _G.PopWindowManager:GetInstance():ShowAllTips(5200103)
                else
                    _G.PopWindowManager:GetInstance():ShowAllTips(5200102)
                end
            end
        end
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 220)
    end
end

function RuneLimitFundView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return RuneLimitFundView
