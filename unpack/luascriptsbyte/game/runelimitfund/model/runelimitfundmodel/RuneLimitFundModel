---@class RuneLimitFundModel : GameDataModelBase    中文描述
local RuneLimitFundModel = _G.BaseClass("RuneLimitFundModel", _G.GameDataModelBase)

---@return RuneLimitFundModel
function RuneLimitFundModel:GetInstance()
    return self.super.GetInstance(self)
end

local store_battle_pass_cfg=_G.ConfigManager.store_battle_pass_cfg
---创建对象时,入口构造函数
function RuneLimitFundModel:__init()
    self.start_time=0
    self.is_buy=0
    self.free_award={}
    self.pay_award={}
    local cfg=_G.ConfigManager.discrete_cfg[201202]
    self.cfg=store_battle_pass_cfg[cfg[1][1]]
    self.curFunctionOpenID =  _G.FunctionID.Rune
end

function RuneLimitFundModel:GetGiftCfg()
    return self.cfg
end

function RuneLimitFundModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end


function RuneLimitFundModel:GetDataFormServer()
    require("RuneLimitFundNet"):GetInstance():SendInfoGet(_G.handler(self,self.ParseData))
end

function RuneLimitFundModel:OnSixClockUpdate(endcall)
    if endcall  then
        endcall()
    end
    if self:CheckIsOpen() then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRuneLimitFund.id)
    end
end
---数据解析完成
---@param msg beginner_pack.i_beginner_pack_info
function RuneLimitFundModel:ParseData(msg)
    if msg.ack==1 then
        self.start_time=msg.start_time or 0
        self.is_buy=msg.is_buy or 0
        self.free_award=msg.free_award or {}
        self.pay_award=msg.pay_award or {}
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRuneLimitFund.id)
    self.super.ParseData(self)
end
--购买礼包
function RuneLimitFundModel:BuyGift(callback)
    require("MallManager"):GetInstance():BuyActiveGift(self.cfg.price_id, nil, self.cfg.id)
    self.BuyGiftBack=function()
        callback()
    end
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end
---购买回调
function RuneLimitFundModel:OnMallCashListener(data)
    if self.cfg.id==data.sid then
        self.is_buy=1
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRuneLimitFund.id)
        if self.BuyGiftBack then
            self:BuyGiftBack()
            self.BuyGiftBack=nil
        end
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end
function RuneLimitFundModel:GetAward(callback)
    local free_sid_list,pay_sid_list = self:GetCanGetAward()
    local pb={free_sid_list=free_sid_list or {},pay_sid_list=pay_sid_list or {}}
    require("RuneLimitFundNet"):GetInstance():SendRewardGet(pb,_G.handlerbind(self,self.GetAwardBack,pb,callback))
end
function RuneLimitFundModel:GetAwardBack(msg,pb,callback)
    if msg.ack==1 then
        for i = 1, #pb.free_sid_list do
            table.insert(self.free_award,pb.free_sid_list[i])
        end
        for i = 1, #pb.pay_sid_list do
            table.insert(self.pay_award,pb.pay_sid_list[i])
        end
        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRuneLimitFund.id)
        if callback then
            callback()
        end
    end
end
---判断是否存在未领取奖励
function RuneLimitFundModel:CheckGiftHasGet()
    local ToDay=self:GetToday()
    for i = 1, #self.cfg.content do
        if ToDay>=i  then
            if not table.ContainsValue(self.free_award,self.cfg.content[i]) or
                    (self.is_buy==1 and  not table.ContainsValue(self.pay_award,self.cfg.content[i])) then
                return 1
            end
        end
    end
    return 0
end
function RuneLimitFundModel:GetCanGetAward()
    local pay_ids={}
    local free_ids={}
    local ToDay=self:GetToday()
    for i = 1, #self.cfg.content do
        if ToDay>=i then
            if not table.ContainsValue(self.free_award,self.cfg.content[i]) then
                table.insert(free_ids,self.cfg.content[i])
            end
            if self.is_buy==1 and not table.ContainsValue(self.pay_award,self.cfg.content[i]) then
                table.insert(pay_ids,self.cfg.content[i])
            end
        end
    end
    return free_ids,pay_ids
end
---判断奖励item是否已经领取
function RuneLimitFundModel:CheckIsGetItem(isfree,id)
    if isfree then
        return table.ContainsValue(self.free_award,id)
    else
        return  table.ContainsValue(self.pay_award,id)
    end
end
---判断奖励item是否能够领取
function RuneLimitFundModel:CheckIsCanGetItem(isfree,id)
    local ToDay=self:GetToday()
    for i = 1, #self.cfg.content do
        if ToDay>=i and self.cfg.content[i]== id then
            if isfree then
                return (not table.ContainsValue(self.free_award,id)) and 1 or 0
            else
                return ( self.is_buy==1 and not table.ContainsValue(self.pay_award,id)) and 1 or 0
            end
        end
    end
    return 0
end
---判断礼包是否已经购买
function RuneLimitFundModel:CheckGiftIsBuy()
    return self.is_buy
end
local continueDay=_G.ConfigManager.discrete_cfg[201201][1][1]
---获取结束时间
function RuneLimitFundModel:GetEndTime()
    return _G.TimeUtil.GetDayBySix(self.start_time+ 86400*continueDay)
end
function RuneLimitFundModel:GetToday()
    local NowTime=_G.TimeUtil.GetServerUnixTime()
    local ToDay=_G.TimeUtil.GetIntervalDayBySix1(self.start_time,NowTime)+1
    return ToDay
end
---判断今天是否是活动最后一天
function RuneLimitFundModel:CheckToDayIsLastday()
    local ToDay=require("RuneLimitFundModel"):GetInstance():GetToday()
    if ToDay>=continueDay then
        return true
    end
    return false
end
function RuneLimitFundModel:CheckIsShowRedPoint()
    if self:CheckIsOpen() then
        local ToDay=require("RuneLimitFundModel"):GetInstance():GetToday()
        local ishacanget=self:CheckGiftHasGet()
        if ToDay>continueDay and  ishacanget==1 then
            local zhoushu=(ToDay-3)//7
            if _G.PlayerPrefsManager.GetInt("RuneLimitFund"..zhoushu,0)==0 then
                return 1
            else
                return 0
            end
        else
            return ishacanget
        end
    else
        return 0
    end
end
---判断功能是否开启
function RuneLimitFundModel:CheckIsOpen()
    if not  _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.Rune) then
        return false
    end
   --[[ local ToDay=require("RuneLimitFundModel"):GetInstance():GetToday()
    if ToDay>continueDay then
        return false
    end]]
    return true
end
function RuneLimitFundModel:IsShow()
    if self:CheckGiftIsBuy() == 0  then
        return true
    end
    local ToDay=require("RuneLimitFundModel"):GetInstance():GetToday()
    if ToDay>=continueDay then
        return self:CheckGiftHasGet()==1 and true or false
    end
    return true
end



return RuneLimitFundModel