---@class RuneLimitFundNet : BaseGameNet	通信协议
local RuneLimitFundNet = _G.BaseClass("RuneLimitFundNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return RuneLimitFundNet RuneLimitFundNet
function RuneLimitFundNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求 信息
---@param pbData table PB数据
---@param callback function 完成回调
function RuneLimitFundNet:SendInfoGet(callback)
    local item = _G.ConfigManager.net_map.game_secret_realm_battle_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end


---秘密专属领奖
---@param pbData secret_realm.c2s_battle_award 奖励 id
---@param callback funtion 完成回调（public.s2c_common_ack）
function RuneLimitFundNet:SendRewardGet(pbData, callback)
    local item = _G.ConfigManager.net_map.game_secret_realm_battle_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.ActionGoalsCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RuneLimitFundNet:ActionGoalsCall(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type RuneLimitFundNet
_G.RuneLimitFundNet = RuneLimitFundNet
return RuneLimitFundNet
