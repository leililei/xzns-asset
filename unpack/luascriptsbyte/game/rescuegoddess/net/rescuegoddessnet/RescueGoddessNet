local base = require("BaseGameNet")

---@class RescueGoddessNet : BaseGameNet	通信协议
local RescueGoddessNet = _G.BaseClass("RescueGoddessNet", base)
---@return RescueGoddessNet RescueGoddessNet
function RescueGoddessNet:GetInstance()
    return base.GetInstance(self)
end

function RescueGoddessNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

function RescueGoddessNet:GetAward(pb,callback)
    local item = _G.ConfigManager.net_map.game_role_rescue_goddess
    local port = base.Access(self, item, pb, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function RescueGoddessNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return RescueGoddessNet
