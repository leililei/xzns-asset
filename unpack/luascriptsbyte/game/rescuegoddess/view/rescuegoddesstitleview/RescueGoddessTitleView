function RescueGoddessTitleView:InitView()
    
end

function RescueGoddessTitleView:UpdateData(data)
    self.data = data
    self:UpdateView()
end

function RescueGoddessTitleView:UpdateView()
end

---按钮点击事件在这里派发
function RescueGoddessTitleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Go then
        local index = require("RescueGoddessModel"):GetInstance():GetCurIndex()
        if index > 0 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RescueGoddessView.Name, _G.handler(self, self.UpdateView))
        end
    end
end

---界面的销毁函数
function RescueGoddessTitleView:OnDestroy()
end

return RescueGoddessTitleView