---界面的入口函数
function RescueGoddessTitleView:OnCreate(callback)
    self.callback = callback
    self:InitData()
    self:InitView()
end

function RescueGoddessTitleView:InitData()
    self.data = testCfg[1]--测试数据
    self.sid = self.data.sid
