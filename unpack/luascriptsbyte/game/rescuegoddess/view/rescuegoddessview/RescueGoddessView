---@class RescueGoddessView : UIBaseView    中文描述
---@field public go_table RescueGoddessView_GoTable GoTable
local RescueGoddessView = _G.BaseClass("RescueGoddessView", _G.UIBaseView)

function RescueGoddessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ani = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.ani.enabled = false
end

---界面的入口函数
function RescueGoddessView:OnCreate(isStart)
    self:InitData()
    self:InitView(isStart)
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.discrete_cfg[200512][1][1])
end

function RescueGoddessView:InitData()
    self.model = require("RescueGoddessModel"):GetInstance()
    self.model:RefreshLoginRedpoint()
    self.sid = self.model:GetSid()
    self.cfg = self.model:GetCfg()
    self.needNum = self.model:GettotalCount()
    self.clickCount = 0
    self.bubbleTime = 0
    self.bubbleLoopTime = _G.ConfigManager.discrete_cfg[200515] and _G.ConfigManager.discrete_cfg[200515][1][1] or 3
    self.bubbleList = _G.ConfigManager.discrete_cfg[200511] and _G.ConfigManager.discrete_cfg[200511] or {}
    self.soundList = _G.ConfigManager.discrete_cfg[200513] and _G.ConfigManager.discrete_cfg[200513][1] or {}
    self.curBubble = 1
    self.curSound = 1
    self.state = 1
    self.showBubble = 1
    local topLayer = _G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.TopLayer.Name)
    self.clickEff = topLayer:FindE("ef_dianji")
    if self.clickEff then
        self.clickRect = self.clickEff:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    end
    self.isFirst = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "First" .. self.model:GetCurIndex(), 0) == 0
end

function RescueGoddessView:InitView(isStart)
    if self.clickEff then
        self.clickEff:FindE("effect"):SetActiveE(0)
    end
    self:LoadEffect()
    self:UpdateView(true)
    if (isStart or self.model:IsCanRescue(self.model:GetCurIndex())) and
            _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. self.model:GetCurIndex(), 0) == 0
    then
        self:ChangeState(2)
    end
    self:UpdateTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    if self.isFirst then
        self.ani.enabled = true
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "First" .. self.model:GetCurIndex(), 1)
        _G.DelayDo(5.3, function()
            --首次进入动画播放完毕后再加载UI元素
            self.isFirst = false
            self:UpdateView(true)
            self.ani.enabled = false
        end)
    end
end

function RescueGoddessView:UpdateData()
    self.sid = self.model:GetSid()
    self.cfg = self.model:GetCfg()
    if self.model:GetCurIndex() == 0 then
        self:CloseFun()
        return
    end
    self:UpdateView()
end

function RescueGoddessView:UpdateView(updateSpine)
    if updateSpine and not self.isFirst then
        self.go_table.obj_ViewItem:SetActiveE(1)
        self.go_table.trans_Spine:RemoveAllChildren()
        self.go_table.trans_Spine:SetLocalPosition(32, -8)
        _G.PoolsManager:GetInstance():Spawn(
                self.cfg.ModelPathHi,
                _G.ePoolType.UIItem,
                self.go_table.trans_Spine,
                function(trans)
                    if not self.go_table then
                        _G.DestroyObject(trans)
                        return
                    end
                    GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                    local pos = self.cfg.pos_portrait
                    trans:SetLocalPosition(pos[1], pos[2], pos[3])
                    _G.PoolsManager:GetInstance():Spawn(
                            "UIH5_xzns/Common/@_obj_SpineClick",
                            _G.ePoolType.UIItem,
                            self.go_table.obj_Root,
                            function(tran)
                                if not self.go_table then
                                    _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
                                    return
                                end
                                local index = trans:GetSiblingIndexE()
                                tran:SetSiblingIndexE(index + 1)
                                self.go_table.obj_SpineClick = tran
                                tran:SetRectTransformSize(720, 1280)
                                local SpineClick = require("SpineClick").New(tran, trans, 0, 0, self.sid)
                                SpineClick:SetParam(_G.handler(self, self.OnClickSpine), true)
                            end
                    )
                end
        )
    end
    local value = self.clickCount / self.needNum
    self.go_table.slider_Progress.value = value
    self.go_table.aortext_ProgressTips.text = _G.GetLangPackValue(
            self.model.rescueText,
            _G.GetLangPackValue(self.cfg.Name),
            "<color=#93efa7>" .. self.clickCount .. "</color>",
            self.needNum
    )
    local condition = self.model.conditionList[self.model:GetCurIndex()]
    local chapter = (condition[2] // 1000) - 100
    local level = (condition[2] % 100)
    self.go_table.aortext_TaskText.text = _G.GetLangPackValue(
            self.model.taskText,
            chapter .. "-" .. level,
            _G.GetLangPackValue(self.cfg.Name)
    )
    self.go_table.aorimage_Head.SpriteName = self.cfg.Icon
    local y = 460 * value
    if self.go_table.heartEff then
        self.go_table.heartEff:SetLocalPosition(self.heartPos[1], self.heartPos[2] + y, self.heartPos[3])
    end
    if value >= 1 then
        self:Success()
    end
    local rescueState = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. self.model:GetCurIndex(), 0)
    self.go_table.aorbtn_Go:SetActiveE(rescueState == 1 and 0 or 1)
    self.go_table.aorbtn_Get:SetActiveE(rescueState == 1 and 1 or 0)
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.RescueGoddessAward.id)
end

---更新倒计时
function RescueGoddessView:UpdateTime()
    if self.state == 1 then
        self.go_table.aortext_Time.text = self.model:GetRemainTime()
    end
    self.bubbleTime = self.bubbleTime + 1
    if self.bubbleTime >= self.bubbleLoopTime then
        self.bubbleTime = 0
        if self.showBubble == 0 then
            self.curBubble = self.curBubble + 1
            if self.curBubble > #self.bubbleList[1] then
                self.curBubble = 1
            end
        end
        self.showBubble = self.showBubble == 1 and 0 or 1
    end
    self.go_table.aorimage_Bubble:SetActiveE(self.showBubble)
    self.go_table.aortext_Time:SetActiveE(1)
    local curBubble = self.bubbleList[1][self.curBubble]
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. self.model:GetCurIndex(), 0) == 1 then
        curBubble = self.bubbleList[2][1]
        self.go_table.aortext_Time:SetActiveE(0)
        self.go_table.aorimage_TimeBg:SetActiveE(0)
    end
    self.go_table.aortext_BubbleText.text = _G.GetLangPackValue(curBubble)
    _G.GameUtil.ReBuildRTF(self.go_table.aorimage_Bubble)
    if not self.go_table then
        self:StopTimer()
        return
    end
end

---加载特效
function RescueGoddessView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_RescueGoddessView_dingduanxin,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                self.go_table.topHeartEff = trans
            end
    )
    local heartCfg = _G.ConfigManager.ui_effect_cfg.ef_RescueGoddessView_xin_loop
    _G.UIUtils.LoadEffectByCfg(
            heartCfg,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                self.go_table.heartEff = trans
                self.heartPos = heartCfg.Pos
            end
    )
end

---切换界面状态
function RescueGoddessView:ChangeState(state)
    if self.state == state then
        return
    end
    self.state = state
    self.go_table.obj_Rescue:SetActiveE(self.state == 2 and 1 or 0)
    self.go_table.obj_Title:SetActiveE(self.state == 1 and 1 or 0)
    if self.state == 2 then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
                self.go_table.obj_Finger,
                function(trans)
                    trans:SetLocalPosition(50, -50, 0)
                end
        )
    end
end

function RescueGoddessView:Success()
    if self.isPlaying then
        return
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 15021)
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 15022)--进度条充能音效
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "Time", 0)
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. self.model:GetCurIndex(), 1)
    self.go_table.aorimage_Bubble:SetActiveE(0)
    self.isPlaying = true
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_RescueGoddessView_boom,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end,
            function()
                if not self.go_table then
                    return
                end
                self.isPlaying = false
                self.go_table.aorimage_Bubble:SetActiveE(1)
                self.clickCount = 0
                require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RescueGoddessAward.id)
                self:UpdateData()
                self:ChangeState(1)
            end
    )
end

---点击spine事件
function RescueGoddessView:OnClickSpine(go, isOn)
    if self.isPlaying then
        return
    end
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 15023)--点击音效
    if self.state == 2 then
        --只有开始的时候才计算次数
        self.clickCount = self.clickCount + 1
        self:UpdateView()
        self.go_table.obj_Finger:RemoveAllChildren()
    end
    local x = 0
    local y = 0
    if self.clickRect then
        x, y = self.clickRect:GetLocalPosition()
    end
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_RescueGoddessView_dianji,
            self.go_table.obj_BgEff,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans:SetLocalPosition(x, y)
            end
    )
    _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_RescueGoddessView_xindianji,
            self.go_table.obj_EffNode,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
    )
    local curSound = self.soundList[self.curSound]
    local isPlaying = _G.AudioManager.CheckIsPlay(_G.ConfigManager.audio_cfg[curSound].audio_res)
    if not isPlaying then
        self.curSound = self.curSound + 1
        if self.curSound > #self.soundList then
            self.curSound = 1
        end
        curSound = self.soundList[self.curSound]
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, curSound)
    end
    if self.clickCount >= self.needNum then
        return
    end
end

---按钮点击事件在这里派发
function RescueGoddessView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close then
        self.CloseFun()
    elseif go == self.go_table.aorbtn_Go then
        if self.model:IsCanRescue(self.model:GetCurIndex()) then
            self:ChangeState(2)
        else
            _G.JumpManager:GetInstance():Jump(103001)
        end
    elseif go == self.go_table.aorbtn_Get then
        self.model:GetAward()
        self:CloseFun()
    end
end

function RescueGoddessView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---界面的销毁函数
function RescueGoddessView:OnDestroy()
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.ui_cfg.MainView.audio)--关闭时重新播放主界面bgm
    self:StopTimer()
    if self.clickEff then
        self.clickEff:FindE("effect"):SetActiveE(1)
    end
end

---外界关闭界面回调函数
function RescueGoddessView.CloseFun()
    require("RescueGoddessModel"):GetInstance():ShowCallback()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.RescueGoddessView.Name)
end

return RescueGoddessView