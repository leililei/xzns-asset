local RescueGoddessNet = require("RescueGoddessNet")
local base = _G.GameDataModelBase
---@class RescueGoddessModel : GameDataModelBase
local RescueGoddessModel = _G.BaseClass("RescueGoddessModel", base)

---@return RescueGoddessModel RescueGoddessModel
function RescueGoddessModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function RescueGoddessModel:__init()
    self.redpointId = _G.ConfigManager.redpoint_cfg.RescueGoddess.id
    self.curFunctionOpenID = 1005
    self.curIndex = 0
    self.startTime = 0
    self.loginRedpoint = true
    self.getList = {}
    --离散配置
    self.name = _G.ConfigManager.discrete_cfg[200501] and _G.ConfigManager.discrete_cfg[200501][1][1] or 0--功能名
    self.bubble = _G.ConfigManager.discrete_cfg[200502] and _G.ConfigManager.discrete_cfg[200502][1][1] or 0--气泡文本
    self.conditionList = _G.ConfigManager.discrete_cfg[200503] and _G.ConfigManager.discrete_cfg[200503] or {}--解锁条件
    self.awardList = _G.ConfigManager.discrete_cfg[200504] and _G.ConfigManager.discrete_cfg[200504] or {}--奖励内容
    self.totalTime = _G.ConfigManager.discrete_cfg[200505] and _G.ConfigManager.discrete_cfg[200505][1][1] or 0--持续时间
    self.timeText = _G.ConfigManager.discrete_cfg[200506] and _G.ConfigManager.discrete_cfg[200506][1][1] or 0--倒计时文本
    self.taskText = _G.ConfigManager.discrete_cfg[200507] and _G.ConfigManager.discrete_cfg[200507][1][1] or 0--任务描述
    self.goText = _G.ConfigManager.discrete_cfg[200508] and _G.ConfigManager.discrete_cfg[200508][1][1] or 0--按钮文本
    self.rescueText = _G.ConfigManager.discrete_cfg[200509] and _G.ConfigManager.discrete_cfg[200509][1][1]--解救文本
    self.totalCount = _G.ConfigManager.discrete_cfg[200510] and _G.ConfigManager.discrete_cfg[200510] or 0--点击总次数
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnWindowChange, self)
end

---从服务器拉取数据
function RescueGoddessModel:GetDataFormServer()
    --RescueGoddessNet:GetInstance():GetInfo(_G.handler(self, self.ParseData))
    self:ParseData()
end

function RescueGoddessModel:ParseData(msg)
    --Todo 根据后端数据解析
    require("UserNet"):GetInstance():GetUserInfo(function(info)--领奖情况
        if info.rescue_goddess_award then
            for k, v in pairs(info.rescue_goddess_award) do
                self.getList[k] = v
            end
        end
        self:GetCurIndex()
        if self.curIndex == 0 then
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.RescueGoddess)
        end
    end)
    self.super.ParseData(self)
end

function RescueGoddessModel:SetPlayingView(name)
    self.isPlaying = name
end

function RescueGoddessModel:GettotalCount()
    local index = self:GetCurIndex()
    if index > 0 then
        return self.totalCount[1][index]
    end
    return 0
end

---获取当前关卡卡牌sid
function RescueGoddessModel:GetSid()
    local index = self:GetCurIndex()
    if index > 0 then
        local itemCfg = _G.ConfigManager.item_cfg[self.awardList[index][1]]
        if itemCfg then
            return tonumber(itemCfg.UseParameter[1][2])
        else
            return self.awardList[index][1]
        end
    end
    return 0
end

---获取当前关卡卡牌配置
function RescueGoddessModel:GetCfg()
    local index = self:GetCurIndex()
    if index > 0 then
        return _G.ConfigManager.card_cfg[self:GetSid()]
    end
    return {}
end

---获取当前可解救的女神id
function RescueGoddessModel:GetCurIndex()
    self.curIndex = 0
    for i = 1, #self.awardList do
        if self:IsGet(i) == false then
            self.curIndex = i--第一个没有领取奖励的关卡
            return self.curIndex
        end
    end
    return self.curIndex
end

---获取当前显示用剩余时间
function RescueGoddessModel:GetRemainTime()
    self.startTime = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "Time", 0)
    if self.startTime == 0 then
        self.startTime = _G.TimeUtil.GetServerUnixTime()
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "Time", self.startTime)
    end
    local continueTime = self.totalTime--持续时间
    local remainTime = self.startTime + continueTime - _G.TimeUtil.GetServerUnixTime()
    if remainTime < 0 then--倒计时结束，从当前时间开始重新计时
        self.startTime = _G.TimeUtil.GetServerUnixTime()
        remainTime = continueTime
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "Time", self.startTime)
    end
    remainTime = _G.GetLangPackValue(self.timeText, _G.TimeUtil.TimeToStringHMS(remainTime), _G.GetLangPackValue(self:GetCfg().Name))
    return remainTime
end

---领取奖励
function RescueGoddessModel:GetAward()
    local index = self:GetCurIndex()
    if index > 0 then
        local pb={index={index}}
        RescueGoddessNet:GetInstance():GetAward(pb,function(msg)
            if msg.ack ~= 1 then
                return
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            self.getList[self.curIndex] = 1--临时标记
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. self.curIndex, 0)--领取后视为没有完成当前关卡
            if self:IsAllGet() then
                _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.RescueGoddess)
            end
        end)
    end
end

---是否可领取奖励
function RescueGoddessModel:IsCanGet(index)
    if index then
        if self:IsGet(index) then--已领取
            return false
        end
        return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. index, 0) == 1
    else--所有关卡是否有可领取奖励
        for i = 1, #self.awardList do
            if not self:IsGet(i) then
                return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. i, 0) == 1
            end
        end
    end
    
    return false
end

---是否已领取奖励
function RescueGoddessModel:IsGet(index)
    return self.getList[index] and true or false
end

---是否已全部领取
function RescueGoddessModel:IsAllGet()
    self.isNotGetIndex = 0
    local afkId=require"AfkModel":GetInstance():GetCurSection()
    for i = 1, #self.awardList do
        if afkId>self.conditionList[i][2]and not self:IsGet(i) then
            self.isNotGetIndex = i
            return false
        end
    end
    return true
end

---是否可解救
function RescueGoddessModel:IsCanRescue(index)
    local curIndex = index or self.curIndex
    return _G.GlobalConditionManager.CheckConditionArrays({ self.conditionList[curIndex] })
end

---查询是否需要在结算界面前弹出
function RescueGoddessModel:CheckPop(callback)
    local index = self:GetCurIndex()
    self.callback = callback
    if index > 0 and self:IsCanRescue(index) then
        self.startTime = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "Time", 0)
        if self.startTime == 0 then
            self.startTime = _G.TimeUtil.GetServerUnixTime()
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.RescueGoddessAward .. "Time", self.startTime)
        end
        _G.FunctionManager:GetInstance():OpenFunById(_G.MainFunctionItems.RescueGoddess)
        self:ShowPop(false)
    else--没有可解救的女神，直接弹结算
        self:ShowPop(true)
    end
end

function RescueGoddessModel:ShowPop(isSettlement)
    if isSettlement or not self:IsCanRescue() then
        if self.isPlaying then
            self.exitCall = self.callback
        elseif self.callback then
            self.callback()
        end
    else
        if self.isPlaying then
            self.exitCall = function()
                _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.RescueGoddessView.Name,
                        true
                )
            end
        else
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.RescueGoddessView.Name,
                    true
            )
        end
    end
end

---显示回调
function RescueGoddessModel:ShowCallback()
    if self.callback then
        self.callback()
        self.callback = nil
    end
end

function RescueGoddessModel:CheckOpen()
    return not RescueGoddessModel:GetInstance():IsAllGet()
end
---查询红点
function RescueGoddessModel:CheckRedpoint(param)
    if param == 1 then
        return self.loginRedpoint == true and 1 or 0
    elseif param == 2 then
        return self:IsCanGet() and 1 or 0
    end
end

---刷新登录红点
function RescueGoddessModel:RefreshLoginRedpoint()
    if self.loginRedpoint == false then
        return
    end
    self.loginRedpoint = false
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RescueGoddessLogin.id)
end

---退出小游戏界面检测
function RescueGoddessModel:OnWindowChange(name)
    if self.isPlaying and name == self.isPlaying then
        self.isPlaying = nil
        if self.exitCall then
            self.exitCall()
            self.exitCall = nil
        end
    end
end

---销毁对象时,析构函数
function RescueGoddessModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnWindowChange, self)
end

return RescueGoddessModel
