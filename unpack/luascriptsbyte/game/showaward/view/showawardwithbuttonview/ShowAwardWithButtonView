function ShowAwardWithButtonView:SetCloseTimer()
    local time = _G.ConfigManager.discrete_cfg[120010][1][1]
    self.closeTimer = _G.TimerManager:GetInstance():GetTimer(time, function()
        --如果此面板已被销毁或被隐藏, 不用继续执行
        if self:IsNil() or self.go_table.gameObject:GetctiveInHierarchy() ~= 1 then
            return
        end
        self:CloseCall(SettlementModel.FunctionEnum.Back)
    end, self, true, false)
    self.closeTimer:Start()
end

