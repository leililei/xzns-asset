    self.ExtraAward = extraAward or nil
    self.re_uid = result.re_uid or {}
    self.reportType = result.reportType or 0
    self.isReport = result.isReport
    self.afkPage = result.page or 1
    self.privilegeData = result.privilegeData or nil
